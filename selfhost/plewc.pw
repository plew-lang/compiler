// stage1 parser sketch #2: a parser that consumes the LEXER'S TOKEN STREAM
// (not raw bytes), written in Plew and compiled by stage0.
//
// calc.pw validated the parser phase over raw bytes. The new thing here is
// consuming an `Array[Tok]` produced by the lexer: the parser advances a token
// cursor, dispatches on `Tok.kind`, and reads an integer literal's value back
// out of the source bytes via the token's (start, len) span. This is exactly
// the shape the self-hosted compiler's parser needs.
//
// The lexer below is copied from lexer.pw (stage0 has no import mechanism yet,
// so each selfhost program is a single self-contained file). Only the subset
// the expression grammar needs is exercised.
//
// Reads an expression from stdin and prints its value. Precedence:
//   expr := term (('+' | '-') term)*
//   term := atom (('*' | '/' | '%') atom)*
//   atom := Int | '(' expr ')'

enum Kind {
    Eof
    Newline
    Int
    Str
    Ident
    KwFn
    KwStruct
    KwEnum
    KwMatch
    KwIf
    KwElse
    KwWhile
    KwFor
    KwBreak
    KwContinue
    KwReturn
    KwGive
    KwVal
    KwMut
    KwIn
    KwAs
    KwInout
    KwTrue
    KwFalse
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Eq
    EqEq
    Ne
    Lt
    Le
    Gt
    Ge
    Plus
    Minus
    Star
    Slash
    Percent
    AmpAmp
    PipePipe
    Bang
    Arrow
    FatArrow
    SlashGt
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    DotDotLt
    DotDotEq
    Unknown
}

struct Tok {
    val kind: Kind
    val start: U64
    val len: U64
}

struct Lexer {
    val bytes: Array[U8]
    mut val pos: U64
    mut val toks: Array[Tok]
    mut val depth: I64
}

fn at(lx: inout Lexer, off: U64) -> U8 {
    val i: U64 = lx.pos + off
    if i < lx.bytes.count {
        return lx.bytes[i]
    }
    return 0
}

fn isDigit(b: U8) -> Bool {
    if b >= 48 {
        if b <= 57 {
            return true
        }
    }
    return false
}

fn isAlpha(b: U8) -> Bool {
    if b == 95 {
        return true
    }
    if b >= 97 {
        if b <= 122 {
            return true
        }
    }
    if b >= 65 {
        if b <= 90 {
            return true
        }
    }
    return false
}

fn isAlnum(b: U8) -> Bool {
    if isAlpha(b) {
        return true
    }
    return isDigit(b)
}

fn rangeEquals(bytes: Array[U8], start: U64, len: U64, kw: String) -> Bool {
    val kb: Array[U8] = kw.bytes
    if len != kb.count {
        return false
    }
    mut val j: U64 = 0
    while j < len {
        if bytes[start + j] != kb[j] {
            return false
        }
        j += 1
    }
    return true
}

fn identKind(bytes: Array[U8], start: U64, len: U64) -> Kind {
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "fn") {
        return <Kind.KwFn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "struct") {
        return <Kind.KwStruct />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "enum") {
        return <Kind.KwEnum />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "match") {
        return <Kind.KwMatch />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "if") {
        return <Kind.KwIf />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "else") {
        return <Kind.KwElse />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "while") {
        return <Kind.KwWhile />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "for") {
        return <Kind.KwFor />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "break") {
        return <Kind.KwBreak />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "continue") {
        return <Kind.KwContinue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "return") {
        return <Kind.KwReturn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "give") {
        return <Kind.KwGive />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "val") {
        return <Kind.KwVal />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "mut") {
        return <Kind.KwMut />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "in") {
        return <Kind.KwIn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "as") {
        return <Kind.KwAs />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "inout") {
        return <Kind.KwInout />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "true") {
        return <Kind.KwTrue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "false") {
        return <Kind.KwFalse />
    }
    return <Kind.Ident />
}

fn emit(lx: inout Lexer, k: Kind, start: U64, len: U64) {
    lx.toks.append(<Tok kind=k start=start len=len />)
    lx.pos = start + len
}

fn lastWasNewline(lx: inout Lexer) -> Bool {
    val n: U64 = lx.toks.count
    if n == 0 {
        return false
    }
    val t: Tok = lx.toks[n - 1]
    match t.kind {
        Kind.Newline => { return true }
        _ => { return false }
    }
}

fn lastCanEnd(lx: inout Lexer) -> Bool {
    val n: U64 = lx.toks.count
    if n == 0 {
        return false
    }
    val t: Tok = lx.toks[n - 1]
    match t.kind {
        Kind.Ident => { return true }
        Kind.Int => { return true }
        Kind.Str => { return true }
        Kind.RParen => { return true }
        Kind.RBracket => { return true }
        Kind.RBrace => { return true }
        Kind.SlashGt => { return true }
        Kind.KwTrue => { return true }
        Kind.KwFalse => { return true }
        Kind.KwReturn => { return true }
        Kind.KwBreak => { return true }
        Kind.KwContinue => { return true }
        _ => { return false }
    }
}

fn lex(lx: inout Lexer) {
    while lx.pos < lx.bytes.count {
        val b: U8 = at(lx: inout lx, off: 0)
        if b == 32 {
            lx.pos += 1
            continue
        }
        if b == 9 {
            lx.pos += 1
            continue
        }
        if b == 13 {
            lx.pos += 1
            continue
        }
        if b == 10 {
            if lx.depth > 0 {
                lx.pos += 1
            } else {
                if lastCanEnd(lx: inout lx) {
                    if lastWasNewline(lx: inout lx) {
                        lx.pos += 1
                    } else {
                        emit(lx: inout lx, k: <Kind.Newline />, start: lx.pos, len: 1)
                    }
                } else {
                    lx.pos += 1
                }
            }
            continue
        }
        if b == 47 {
            if at(lx: inout lx, off: 1) == 47 {
                while lx.pos < lx.bytes.count {
                    if at(lx: inout lx, off: 0) == 10 {
                        break
                    }
                    lx.pos += 1
                }
                continue
            }
        }
        if isDigit(b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count {
                if isDigit(lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            emit(lx: inout lx, k: <Kind.Int />, start: start, len: j - start)
            continue
        }
        if isAlpha(b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count {
                if isAlnum(lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            val len: U64 = j - start
            val k: Kind = identKind(bytes: lx.bytes, start: start, len: len)
            emit(lx: inout lx, k: k, start: start, len: len)
            continue
        }
        if b == 34 {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos + 1
            while j < lx.bytes.count {
                if lx.bytes[j] == 34 {
                    j += 1
                    break
                }
                j += 1
            }
            emit(lx: inout lx, k: <Kind.Str />, start: start, len: j - start)
            continue
        }
        val b2: U8 = at(lx: inout lx, off: 1)
        if b == 46 {
            if b2 == 46 {
                val b3: U8 = at(lx: inout lx, off: 2)
                if b3 == 60 {
                    emit(lx: inout lx, k: <Kind.DotDotLt />, start: lx.pos, len: 3)
                    continue
                }
                if b3 == 61 {
                    emit(lx: inout lx, k: <Kind.DotDotEq />, start: lx.pos, len: 3)
                    continue
                }
            }
            emit(lx: inout lx, k: <Kind.Dot />, start: lx.pos, len: 1)
            continue
        }
        if b == 61 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.EqEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == 62 {
                emit(lx: inout lx, k: <Kind.FatArrow />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Eq />, start: lx.pos, len: 1)
            continue
        }
        if b == 33 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.Ne />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Bang />, start: lx.pos, len: 1)
            continue
        }
        if b == 60 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.Le />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Lt />, start: lx.pos, len: 1)
            continue
        }
        if b == 62 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.Ge />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Gt />, start: lx.pos, len: 1)
            continue
        }
        if b == 43 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.PlusEq />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Plus />, start: lx.pos, len: 1)
            continue
        }
        if b == 45 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.MinusEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == 62 {
                emit(lx: inout lx, k: <Kind.Arrow />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Minus />, start: lx.pos, len: 1)
            continue
        }
        if b == 42 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.StarEq />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Star />, start: lx.pos, len: 1)
            continue
        }
        if b == 47 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.SlashEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == 62 {
                emit(lx: inout lx, k: <Kind.SlashGt />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Slash />, start: lx.pos, len: 1)
            continue
        }
        if b == 37 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.PercentEq />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Percent />, start: lx.pos, len: 1)
            continue
        }
        if b == 38 {
            if b2 == 38 {
                emit(lx: inout lx, k: <Kind.AmpAmp />, start: lx.pos, len: 2)
                continue
            }
        }
        if b == 124 {
            if b2 == 124 {
                emit(lx: inout lx, k: <Kind.PipePipe />, start: lx.pos, len: 2)
                continue
            }
        }
        if b == 40 {
            emit(lx: inout lx, k: <Kind.LParen />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == 41 {
            emit(lx: inout lx, k: <Kind.RParen />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == 91 {
            emit(lx: inout lx, k: <Kind.LBracket />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == 93 {
            emit(lx: inout lx, k: <Kind.RBracket />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == 123 {
            emit(lx: inout lx, k: <Kind.LBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == 125 {
            emit(lx: inout lx, k: <Kind.RBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == 44 {
            emit(lx: inout lx, k: <Kind.Comma />, start: lx.pos, len: 1)
            continue
        }
        if b == 58 {
            emit(lx: inout lx, k: <Kind.Colon />, start: lx.pos, len: 1)
            continue
        }
        emit(lx: inout lx, k: <Kind.Unknown />, start: lx.pos, len: 1)
    }
    lx.toks.append(<Tok kind=<Kind.Eof /> start=lx.pos len=0 />)
}

fn kindCode(k: Kind) -> I64 {
    match k {
        Kind.Eof => { return 0 }
        Kind.Newline => { return 1 }
        Kind.Int => { return 2 }
        Kind.Str => { return 3 }
        Kind.Ident => { return 4 }
        Kind.KwFn => { return 10 }
        Kind.KwStruct => { return 11 }
        Kind.KwEnum => { return 12 }
        Kind.KwMatch => { return 13 }
        Kind.KwIf => { return 14 }
        Kind.KwElse => { return 15 }
        Kind.KwWhile => { return 16 }
        Kind.KwFor => { return 17 }
        Kind.KwBreak => { return 18 }
        Kind.KwContinue => { return 19 }
        Kind.KwReturn => { return 20 }
        Kind.KwGive => { return 21 }
        Kind.KwVal => { return 22 }
        Kind.KwMut => { return 23 }
        Kind.KwIn => { return 24 }
        Kind.KwAs => { return 25 }
        Kind.KwInout => { return 26 }
        Kind.KwTrue => { return 27 }
        Kind.KwFalse => { return 28 }
        Kind.LParen => { return 40 }
        Kind.RParen => { return 41 }
        Kind.LBracket => { return 42 }
        Kind.RBracket => { return 43 }
        Kind.LBrace => { return 44 }
        Kind.RBrace => { return 45 }
        Kind.Comma => { return 46 }
        Kind.Colon => { return 47 }
        Kind.Dot => { return 48 }
        Kind.Eq => { return 49 }
        Kind.EqEq => { return 50 }
        Kind.Ne => { return 51 }
        Kind.Lt => { return 52 }
        Kind.Le => { return 53 }
        Kind.Gt => { return 54 }
        Kind.Ge => { return 55 }
        Kind.Plus => { return 56 }
        Kind.Minus => { return 57 }
        Kind.Star => { return 58 }
        Kind.Slash => { return 59 }
        Kind.Percent => { return 60 }
        Kind.AmpAmp => { return 61 }
        Kind.PipePipe => { return 62 }
        Kind.Bang => { return 63 }
        Kind.Arrow => { return 64 }
        Kind.FatArrow => { return 65 }
        Kind.SlashGt => { return 66 }
        Kind.PlusEq => { return 67 }
        Kind.MinusEq => { return 68 }
        Kind.StarEq => { return 69 }
        Kind.SlashEq => { return 70 }
        Kind.PercentEq => { return 71 }
        Kind.DotDotLt => { return 72 }
        Kind.DotDotEq => { return 73 }
        Kind.Unknown => { return 99 }
    }
}

// ---- AST (arena, indexed by U64) ----
//
// Expressions and statements live in flat arenas (Array[Expr]/Array[Stmt]);
// children are referenced by U64 index. Operators are stored as kindCode (I64)
// to avoid nesting an enum inside an enum payload. Identifier nodes keep the
// source (start, len) span so codegen can echo the name via writeByte.

// A parsed type: for `Array[E]`, (start,len) names the element E and isArray is
// true; otherwise (start,len) names the type itself (scalar / String / named).
struct PType {
    val start: U64
    val len: U64
    val isArray: Bool
}

// A variable binding in scope during codegen (param, let, or match bind), used
// to recover an expression's type for monomorphization and `.bytes` dispatch.
struct Local {
    val nameStart: U64
    val nameLen: U64
    val tyStart: U64
    val tyLen: U64
    val isArray: Bool
}

// The recovered type of an expression. kind: 0 scalar (long long), 1 String,
// 2 named struct/enum, 3 array. For named: (nameStart,len) is the type name;
// for array: the element type name (always backed by a real declaration span).
struct TypeInfo {
    val kind: I64
    val nameStart: U64
    val nameLen: U64
}

// One `field=expr` pair inside a JSX construction `<Type field=expr ... />`.
struct MakeField {
    val nameStart: U64
    val nameLen: U64
    val value: U64
}

// One `val name` field binding inside a match pattern `E.V { val a, val b }`.
struct Bind {
    val nameStart: U64
    val nameLen: U64
}

enum Expr {
    Int { value: I64 }
    Ident { start: U64, len: U64 }
    Unary { op: I64, operand: U64 }
    Binary { op: I64, lhs: U64, rhs: U64 }
    Call { nameStart: U64, nameLen: U64, args: Array[U64] }
    Field { base: U64, nameStart: U64, nameLen: U64 }
    Make { typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, fields: Array[MakeField] }
    Str { start: U64, len: U64 }
    Array { elems: Array[U64] }
    Index { base: U64, index: U64 }
    Method { recv: U64, nameStart: U64, nameLen: U64, args: Array[U64] }
}

// One arm of a match: either `_ => block` (wildcard) or `Enum.Variant
// [{ val f ... }] => block`. The pattern names the enum and variant, so codegen
// resolves the tag index and field types without any type inference.
struct MatchArm {
    val isWildcard: Bool
    val enumStart: U64
    val enumLen: U64
    val variantStart: U64
    val variantLen: U64
    val binds: Array[Bind]
    val body: U64
}

enum Stmt {
    Let { mutable: Bool, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, tyIsArray: Bool, init: U64 }
    Assign { op: I64, target: U64, value: U64 }
    Print { expr: U64 }
    ExprStmt { expr: U64 }
    Return { value: U64, hasValue: Bool }
    If { cond: U64, thenBlk: U64, elseBlk: U64, hasElse: Bool }
    While { cond: U64, body: U64 }
    Match { scrut: U64, arms: Array[MatchArm] }
    Break
    Continue
}

struct Block {
    val stmts: Array[U64]
}

struct Param {
    val nameStart: U64
    val nameLen: U64
    val tyStart: U64
    val tyLen: U64
    val tyIsArray: Bool
}

struct FieldDef {
    val nameStart: U64
    val nameLen: U64
    val tyStart: U64
    val tyLen: U64
    val tyIsArray: Bool
}

struct StructDef {
    val nameStart: U64
    val nameLen: U64
    val fields: Array[FieldDef]
}

struct Variant {
    val nameStart: U64
    val nameLen: U64
    val fields: Array[FieldDef]
}

struct EnumDef {
    val nameStart: U64
    val nameLen: U64
    val variants: Array[Variant]
}

struct Func {
    val nameStart: U64
    val nameLen: U64
    val params: Array[Param]
    val hasRet: Bool
    val retStart: U64
    val retLen: U64
    val retIsArray: Bool
    val body: U64
}

struct Comp {
    val bytes: Array[U8]
    val toks: Array[Tok]
    mut val pos: U64
    mut val exprs: Array[Expr]
    mut val stmts: Array[Stmt]
    mut val blocks: Array[Block]
    mut val funcs: Array[Func]
    mut val structs: Array[StructDef]
    mut val enums: Array[EnumDef]
    // distinct Array element type names seen in declarations (for monomorphizing
    // PlewArray_<E> + runtime); each entry reuses Bind as a (start,len) pair.
    mut val arrayElems: Array[Bind]
    // variables in scope during codegen (params / lets / match binds), for type
    // recovery (monomorphization + `.bytes` dispatch).
    mut val locals: Array[Local]
    // fresh-temp counter for match scrutinee bindings (`_m0`, `_m1`, ...)
    mut val tmp: U64
    // set per-function during codegen so `return` lowers correctly
    mut val curIsMain: Bool
    mut val curRetVoid: Bool
}

// ---- cursor helpers ----

fn curKind(c: inout Comp) -> Kind {
    return c.toks[c.pos].kind
}

fn cur(c: inout Comp) -> Tok {
    return c.toks[c.pos]
}

fn peekKind(c: inout Comp, off: U64) -> Kind {
    val i: U64 = c.pos + off
    if i < c.toks.count {
        return c.toks[i].kind
    }
    return <Kind.Eof />
}

fn advance(c: inout Comp) {
    c.pos = c.pos + 1
}

fn skipNewlines(c: inout Comp) {
    while true {
        match curKind(c: inout c) {
            Kind.Newline => { advance(c: inout c) }
            _ => { break }
        }
    }
}

fn identIs(c: inout Comp, kw: String) -> Bool {
    val t: Tok = c.toks[c.pos]
    return rangeEquals(bytes: c.bytes, start: t.start, len: t.len, kw: kw)
}

fn pushExpr(c: inout Comp, e: Expr) -> U64 {
    val id: U64 = c.exprs.count
    c.exprs.append(e)
    return id
}

fn pushStmt(c: inout Comp, s: Stmt) -> U64 {
    val id: U64 = c.stmts.count
    c.stmts.append(s)
    return id
}

// Read an Int token's value out of the source bytes via its (start, len) span.
fn tokenValue(c: inout Comp, t: Tok) -> I64 {
    mut val v: I64 = 0
    mut val j: U64 = 0
    while j < t.len {
        val b: U8 = c.bytes[t.start + j]
        v = v * 10 + (b as I64 - 48)
        j += 1
    }
    return v
}

// ---- expression parser (precedence climbing) ----

fn binPrec(k: Kind) -> I64 {
    match k {
        Kind.PipePipe => { return 1 }
        Kind.AmpAmp => { return 2 }
        Kind.EqEq => { return 3 }
        Kind.Ne => { return 3 }
        Kind.Lt => { return 3 }
        Kind.Le => { return 3 }
        Kind.Gt => { return 3 }
        Kind.Ge => { return 3 }
        Kind.Plus => { return 4 }
        Kind.Minus => { return 4 }
        Kind.Star => { return 5 }
        Kind.Slash => { return 5 }
        Kind.Percent => { return 5 }
        _ => { return 0 }
    }
}

fn parsePrimary(c: inout Comp) -> U64 {
    val k: Kind = curKind(c: inout c)
    match k {
        Kind.Int => {
            val t: Tok = cur(c: inout c)
            advance(c: inout c)
            val v: I64 = tokenValue(c: inout c, t: t)
            return pushExpr(c: inout c, e: <Expr.Int value=v />)
        }
        Kind.Ident => {
            val t: Tok = cur(c: inout c)
            match peekKind(c: inout c, off: 1) {
                Kind.LParen => {
                    advance(c: inout c)
                    advance(c: inout c)
                    val args: Array[U64] = parseCallArgs(c: inout c)
                    return pushExpr(c: inout c, e: <Expr.Call nameStart=t.start nameLen=t.len args=args />)
                }
                _ => {
                    advance(c: inout c)
                    return pushExpr(c: inout c, e: <Expr.Ident start=t.start len=t.len />)
                }
            }
        }
        Kind.KwTrue => {
            advance(c: inout c)
            return pushExpr(c: inout c, e: <Expr.Int value=1 />)
        }
        Kind.KwFalse => {
            advance(c: inout c)
            return pushExpr(c: inout c, e: <Expr.Int value=0 />)
        }
        Kind.LParen => {
            advance(c: inout c)
            val inner: U64 = parseExpr(c: inout c)
            match curKind(c: inout c) {
                Kind.RParen => { advance(c: inout c) }
                _ => {}
            }
            return inner
        }
        Kind.Lt => {
            return parseMake(c: inout c)
        }
        Kind.Str => {
            val t: Tok = cur(c: inout c)
            advance(c: inout c)
            return pushExpr(c: inout c, e: <Expr.Str start=t.start len=t.len />)
        }
        Kind.LBracket => {
            advance(c: inout c)
            mut val elems: Array[U64] = []
            while true {
                skipNewlines(c: inout c)
                match curKind(c: inout c) {
                    Kind.RBracket => {
                        advance(c: inout c)
                        break
                    }
                    Kind.Eof => { break }
                    _ => {
                        val e: U64 = parseExpr(c: inout c)
                        elems.append(e)
                        match curKind(c: inout c) {
                            Kind.Comma => { advance(c: inout c) }
                            _ => {}
                        }
                    }
                }
            }
            return pushExpr(c: inout c, e: <Expr.Array elems=elems />)
        }
        _ => {
            advance(c: inout c)
            return pushExpr(c: inout c, e: <Expr.Int value=0 />)
        }
    }
}

fn parseUnary(c: inout Comp) -> U64 {
    val k: Kind = curKind(c: inout c)
    match k {
        Kind.Minus => {
            advance(c: inout c)
            val o: U64 = parseUnary(c: inout c)
            return pushExpr(c: inout c, e: <Expr.Unary op=57 operand=o />)
        }
        Kind.Bang => {
            advance(c: inout c)
            val o: U64 = parseUnary(c: inout c)
            return pushExpr(c: inout c, e: <Expr.Unary op=63 operand=o />)
        }
        _ => { return parsePostfix(c: inout c) }
    }
}

// Postfix chain: `.field` accesses (index `[]` comes later).
fn parsePostfix(c: inout Comp) -> U64 {
    mut val e: U64 = parsePrimary(c: inout c)
    while true {
        match curKind(c: inout c) {
            Kind.Dot => {
                advance(c: inout c)
                val nameTok: Tok = cur(c: inout c)
                advance(c: inout c)
                match curKind(c: inout c) {
                    Kind.LParen => {
                        advance(c: inout c)
                        val args: Array[U64] = parseCallArgs(c: inout c)
                        e = pushExpr(c: inout c, e: <Expr.Method recv=e nameStart=nameTok.start nameLen=nameTok.len args=args />)
                    }
                    _ => {
                        e = pushExpr(c: inout c, e: <Expr.Field base=e nameStart=nameTok.start nameLen=nameTok.len />)
                    }
                }
            }
            Kind.LBracket => {
                advance(c: inout c)
                val idx: U64 = parseExpr(c: inout c)
                match curKind(c: inout c) {
                    Kind.RBracket => { advance(c: inout c) }
                    _ => {}
                }
                e = pushExpr(c: inout c, e: <Expr.Index base=e index=idx />)
            }
            _ => { break }
        }
    }
    return e
}

// JSX construction `<Type field=expr ... />`. Current token is `<`. v3 handles
// struct construction; a dotted `.Variant` path (enum) is consumed but not yet
// modeled.
fn parseMake(c: inout Comp) -> U64 {
    advance(c: inout c)
    val typeTok: Tok = cur(c: inout c)
    advance(c: inout c)
    mut val variantStart: U64 = 0
    mut val variantLen: U64 = 0
    mut val isEnum: Bool = false
    match curKind(c: inout c) {
        Kind.Dot => {
            advance(c: inout c)
            val vTok: Tok = cur(c: inout c)
            advance(c: inout c)
            variantStart = vTok.start
            variantLen = vTok.len
            isEnum = true
        }
        _ => {}
    }
    mut val fields: Array[MakeField] = []
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.SlashGt => {
                advance(c: inout c)
                break
            }
            Kind.Gt => {
                advance(c: inout c)
                break
            }
            Kind.Eof => { break }
            Kind.Ident => {
                val fTok: Tok = cur(c: inout c)
                advance(c: inout c)
                match curKind(c: inout c) {
                    Kind.Eq => { advance(c: inout c) }
                    _ => {}
                }
                val v: U64 = parseExpr(c: inout c)
                fields.append(<MakeField nameStart=fTok.start nameLen=fTok.len value=v />)
            }
            _ => { advance(c: inout c) }
        }
    }
    return pushExpr(c: inout c, e: <Expr.Make typeStart=typeTok.start typeLen=typeTok.len variantStart=variantStart variantLen=variantLen isEnum=isEnum fields=fields />)
}

fn parseBin(c: inout Comp, minPrec: I64) -> U64 {
    mut val left: U64 = parseUnary(c: inout c)
    while true {
        val k: Kind = curKind(c: inout c)
        val prec: I64 = binPrec(k: k)
        if prec == 0 {
            break
        }
        if prec < minPrec {
            break
        }
        val op: I64 = kindCode(k: k)
        advance(c: inout c)
        val right: U64 = parseBin(c: inout c, minPrec: prec + 1)
        left = pushExpr(c: inout c, e: <Expr.Binary op=op lhs=left rhs=right />)
    }
    return left
}

fn parseExpr(c: inout Comp) -> U64 {
    return parseBin(c: inout c, minPrec: 1)
}

// Parse a call's argument list (current token is just past `(`). Labels are
// accepted (`label: expr`) and dropped — stage0-style positional C emission.
fn parseCallArgs(c: inout Comp) -> Array[U64] {
    mut val args: Array[U64] = []
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.RParen => {
                advance(c: inout c)
                break
            }
            Kind.Eof => { break }
            _ => {
                // optional argument label `name:`
                match curKind(c: inout c) {
                    Kind.Ident => {
                        match peekKind(c: inout c, off: 1) {
                            Kind.Colon => {
                                advance(c: inout c)
                                advance(c: inout c)
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                val e: U64 = parseExpr(c: inout c)
                args.append(e)
                match curKind(c: inout c) {
                    Kind.Comma => { advance(c: inout c) }
                    _ => {}
                }
            }
        }
    }
    return args
}

// ---- statement parser ----

fn isAssignOp(k: Kind) -> Bool {
    match k {
        Kind.Eq => { return true }
        Kind.PlusEq => { return true }
        Kind.MinusEq => { return true }
        Kind.StarEq => { return true }
        Kind.SlashEq => { return true }
        Kind.PercentEq => { return true }
        _ => { return false }
    }
}

// Parse a type annotation into a PType. For `Array[E]` the span names the
// element E and isArray is true; otherwise the span names the type itself
// (scalar, String, or a named struct/enum). Nested element types beyond the
// first token are consumed but not modeled (plewc.pw uses none).
fn parseTypeTok(c: inout Comp) -> PType {
    val head: Tok = cur(c: inout c)
    advance(c: inout c)
    match curKind(c: inout c) {
        Kind.LBracket => {
            advance(c: inout c)
            val elem: Tok = cur(c: inout c)
            advance(c: inout c)
            mut val depth: I64 = 1
            while depth > 0 {
                match curKind(c: inout c) {
                    Kind.LBracket => { depth += 1 }
                    Kind.RBracket => { depth -= 1 }
                    Kind.Eof => { break }
                    _ => {}
                }
                advance(c: inout c)
            }
            return <PType start=elem.start len=elem.len isArray=true />
        }
        _ => {}
    }
    return <PType start=head.start len=head.len isArray=false />
}

// Register an Array element type name for later monomorphization (deduped).
fn recordArrayElem(c: inout Comp, ty: PType) {
    if ty.isArray {
        mut val i: U64 = 0
        while i < c.arrayElems.count {
            val e: Bind = c.arrayElems[i]
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: ty.start, bLen: ty.len) {
                return
            }
            i += 1
        }
        c.arrayElems.append(<Bind nameStart=ty.start nameLen=ty.len />)
    }
}

// `[mut] val name [: Type] = expr`. `mutable` says whether `mut` preceded it;
// the current token is `val`.
fn parseLet(c: inout Comp, mutable: Bool) -> U64 {
    advance(c: inout c)
    val nameTok: Tok = cur(c: inout c)
    advance(c: inout c)
    mut val tyStart: U64 = 0
    mut val tyLen: U64 = 0
    mut val tyIsArray: Bool = false
    match curKind(c: inout c) {
        Kind.Colon => {
            advance(c: inout c)
            val ty: PType = parseTypeTok(c: inout c)
            tyStart = ty.start
            tyLen = ty.len
            tyIsArray = ty.isArray
            recordArrayElem(c: inout c, ty: ty)
        }
        _ => {}
    }
    // `=`
    match curKind(c: inout c) {
        Kind.Eq => { advance(c: inout c) }
        _ => {}
    }
    val init: U64 = parseExpr(c: inout c)
    return pushStmt(c: inout c, s: <Stmt.Let mutable=mutable nameStart=nameTok.start nameLen=nameTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray init=init />)
}

fn parsePrint(c: inout Comp) -> U64 {
    advance(c: inout c)
    advance(c: inout c)
    val e: U64 = parseExpr(c: inout c)
    match curKind(c: inout c) {
        Kind.RParen => { advance(c: inout c) }
        _ => {}
    }
    return pushStmt(c: inout c, s: <Stmt.Print expr=e />)
}

fn parseReturn(c: inout Comp) -> U64 {
    advance(c: inout c)
    match curKind(c: inout c) {
        Kind.Newline => { return pushStmt(c: inout c, s: <Stmt.Return value=0 hasValue=false />) }
        Kind.RBrace => { return pushStmt(c: inout c, s: <Stmt.Return value=0 hasValue=false />) }
        Kind.Eof => { return pushStmt(c: inout c, s: <Stmt.Return value=0 hasValue=false />) }
        _ => {
            val e: U64 = parseExpr(c: inout c)
            return pushStmt(c: inout c, s: <Stmt.Return value=e hasValue=true />)
        }
    }
}

fn parseIf(c: inout Comp) -> U64 {
    advance(c: inout c)
    val cond: U64 = parseExpr(c: inout c)
    val thenBlk: U64 = parseBlock(c: inout c)
    skipNewlines(c: inout c)
    match curKind(c: inout c) {
        Kind.KwElse => {
            advance(c: inout c)
            // `else if` chains as a nested if inside a synthesized block.
            match curKind(c: inout c) {
                Kind.KwIf => {
                    val nested: U64 = parseIf(c: inout c)
                    mut val one: Array[U64] = []
                    one.append(nested)
                    val blkId: U64 = c.blocks.count
                    c.blocks.append(<Block stmts=one />)
                    return pushStmt(c: inout c, s: <Stmt.If cond=cond thenBlk=thenBlk elseBlk=blkId hasElse=true />)
                }
                _ => {
                    val elseBlk: U64 = parseBlock(c: inout c)
                    return pushStmt(c: inout c, s: <Stmt.If cond=cond thenBlk=thenBlk elseBlk=elseBlk hasElse=true />)
                }
            }
        }
        _ => {
            return pushStmt(c: inout c, s: <Stmt.If cond=cond thenBlk=thenBlk elseBlk=0 hasElse=false />)
        }
    }
}

fn parseWhile(c: inout Comp) -> U64 {
    advance(c: inout c)
    val cond: U64 = parseExpr(c: inout c)
    val body: U64 = parseBlock(c: inout c)
    return pushStmt(c: inout c, s: <Stmt.While cond=cond body=body />)
}

fn parseExprOrAssign(c: inout Comp) -> U64 {
    val lhs: U64 = parseExpr(c: inout c)
    val k: Kind = curKind(c: inout c)
    if isAssignOp(k: k) {
        val op: I64 = kindCode(k: k)
        advance(c: inout c)
        val rhs: U64 = parseExpr(c: inout c)
        return pushStmt(c: inout c, s: <Stmt.Assign op=op target=lhs value=rhs />)
    }
    return pushStmt(c: inout c, s: <Stmt.ExprStmt expr=lhs />)
}

// `match scrut { (pattern => { body })* }`. Patterns: `_` (wildcard) or
// `Enum.Variant [{ val f, ... }]`. Arms are block bodies (the subset plewc.pw
// uses); bare-expression arms are not handled yet.
fn parseMatch(c: inout Comp) -> U64 {
    advance(c: inout c)
    val scrut: U64 = parseExpr(c: inout c)
    skipNewlines(c: inout c)
    match curKind(c: inout c) {
        Kind.LBrace => { advance(c: inout c) }
        _ => {}
    }
    mut val arms: Array[MatchArm] = []
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.RBrace => {
                advance(c: inout c)
                break
            }
            Kind.Eof => { break }
            _ => {
                val firstTok: Tok = cur(c: inout c)
                mut val isWildcard: Bool = false
                mut val enumStart: U64 = 0
                mut val enumLen: U64 = 0
                mut val variantStart: U64 = 0
                mut val variantLen: U64 = 0
                mut val binds: Array[Bind] = []
                if rangeEquals(bytes: c.bytes, start: firstTok.start, len: firstTok.len, kw: "_") {
                    isWildcard = true
                    advance(c: inout c)
                } else {
                    enumStart = firstTok.start
                    enumLen = firstTok.len
                    advance(c: inout c)
                    // `.Variant`
                    match curKind(c: inout c) {
                        Kind.Dot => { advance(c: inout c) }
                        _ => {}
                    }
                    val vTok: Tok = cur(c: inout c)
                    variantStart = vTok.start
                    variantLen = vTok.len
                    advance(c: inout c)
                    // optional `{ val f, ... }`
                    match curKind(c: inout c) {
                        Kind.LBrace => {
                            advance(c: inout c)
                            while true {
                                skipNewlines(c: inout c)
                                match curKind(c: inout c) {
                                    Kind.RBrace => {
                                        advance(c: inout c)
                                        break
                                    }
                                    Kind.Eof => { break }
                                    Kind.KwVal => {
                                        advance(c: inout c)
                                        val bTok: Tok = cur(c: inout c)
                                        advance(c: inout c)
                                        binds.append(<Bind nameStart=bTok.start nameLen=bTok.len />)
                                        match curKind(c: inout c) {
                                            Kind.Comma => { advance(c: inout c) }
                                            _ => {}
                                        }
                                    }
                                    _ => { advance(c: inout c) }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                // `=>`
                match curKind(c: inout c) {
                    Kind.FatArrow => { advance(c: inout c) }
                    _ => {}
                }
                skipNewlines(c: inout c)
                val body: U64 = parseBlock(c: inout c)
                arms.append(<MatchArm isWildcard=isWildcard enumStart=enumStart enumLen=enumLen variantStart=variantStart variantLen=variantLen binds=binds body=body />)
            }
        }
    }
    return pushStmt(c: inout c, s: <Stmt.Match scrut=scrut arms=arms />)
}

fn parseStmt(c: inout Comp) -> U64 {
    val k: Kind = curKind(c: inout c)
    match k {
        Kind.KwVal => { return parseLet(c: inout c, mutable: false) }
        Kind.KwMut => {
            advance(c: inout c)
            return parseLet(c: inout c, mutable: true)
        }
        Kind.KwIf => { return parseIf(c: inout c) }
        Kind.KwWhile => { return parseWhile(c: inout c) }
        Kind.KwMatch => { return parseMatch(c: inout c) }
        Kind.KwBreak => {
            advance(c: inout c)
            return pushStmt(c: inout c, s: <Stmt.Break />)
        }
        Kind.KwContinue => {
            advance(c: inout c)
            return pushStmt(c: inout c, s: <Stmt.Continue />)
        }
        Kind.KwReturn => { return parseReturn(c: inout c) }
        Kind.Ident => {
            if identIs(c: inout c, kw: "print") {
                match peekKind(c: inout c, off: 1) {
                    Kind.LParen => { return parsePrint(c: inout c) }
                    _ => { return parseExprOrAssign(c: inout c) }
                }
            }
            return parseExprOrAssign(c: inout c)
        }
        _ => { return parseExprOrAssign(c: inout c) }
    }
}

// Parse `{ stmt* }`. Current token must be `{`.
fn parseBlock(c: inout Comp) -> U64 {
    match curKind(c: inout c) {
        Kind.LBrace => { advance(c: inout c) }
        _ => {}
    }
    mut val stmts: Array[U64] = []
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.RBrace => {
                advance(c: inout c)
                break
            }
            Kind.Eof => { break }
            _ => {
                val s: U64 = parseStmt(c: inout c)
                stmts.append(s)
            }
        }
    }
    val id: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    return id
}

// ---- declaration parser ----

// `fn name ( params ) [-> ret] { body }`. v2 params are by-value `name: Type`
// (type skipped, all int64_t); labels equal names.
fn parseFunc(c: inout Comp) {
    advance(c: inout c)
    val nameTok: Tok = cur(c: inout c)
    advance(c: inout c)
    mut val params: Array[Param] = []
    match curKind(c: inout c) {
        Kind.LParen => {
            advance(c: inout c)
            while true {
                skipNewlines(c: inout c)
                val k: Kind = curKind(c: inout c)
                match k {
                    Kind.RParen => {
                        advance(c: inout c)
                        break
                    }
                    Kind.Eof => { break }
                    _ => {
                        val pTok: Tok = cur(c: inout c)
                        advance(c: inout c)
                        mut val pTyStart: U64 = 0
                        mut val pTyLen: U64 = 0
                        mut val pTyIsArray: Bool = false
                        match curKind(c: inout c) {
                            Kind.Colon => {
                                advance(c: inout c)
                                val pty: PType = parseTypeTok(c: inout c)
                                pTyStart = pty.start
                                pTyLen = pty.len
                                pTyIsArray = pty.isArray
                                recordArrayElem(c: inout c, ty: pty)
                            }
                            _ => {}
                        }
                        params.append(<Param nameStart=pTok.start nameLen=pTok.len tyStart=pTyStart tyLen=pTyLen tyIsArray=pTyIsArray />)
                        match curKind(c: inout c) {
                            Kind.Comma => { advance(c: inout c) }
                            _ => {}
                        }
                    }
                }
            }
        }
        _ => {}
    }
    mut val hasRet: Bool = false
    mut val retStart: U64 = 0
    mut val retLen: U64 = 0
    mut val retIsArray: Bool = false
    match curKind(c: inout c) {
        Kind.Arrow => {
            advance(c: inout c)
            hasRet = true
            val rty: PType = parseTypeTok(c: inout c)
            retStart = rty.start
            retLen = rty.len
            retIsArray = rty.isArray
            recordArrayElem(c: inout c, ty: rty)
        }
        _ => {}
    }
    skipNewlines(c: inout c)
    val body: U64 = parseBlock(c: inout c)
    c.funcs.append(<Func nameStart=nameTok.start nameLen=nameTok.len params=params hasRet=hasRet retStart=retStart retLen=retLen retIsArray=retIsArray body=body />)
}

// `struct Name { (val|mut val) field: Type ... }`. Field modifiers (val/mut/
// pub) are consumed and ignored; codegen maps each field's type to a C type.
fn parseStruct(c: inout Comp) {
    advance(c: inout c)
    val nameTok: Tok = cur(c: inout c)
    advance(c: inout c)
    match curKind(c: inout c) {
        Kind.LBrace => { advance(c: inout c) }
        _ => {}
    }
    mut val fields: Array[FieldDef] = []
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.RBrace => {
                advance(c: inout c)
                break
            }
            Kind.Eof => { break }
            Kind.KwVal => { advance(c: inout c) }
            Kind.KwMut => { advance(c: inout c) }
            Kind.Ident => {
                val fTok: Tok = cur(c: inout c)
                advance(c: inout c)
                mut val tyStart: U64 = 0
                mut val tyLen: U64 = 0
                mut val tyIsArray: Bool = false
                match curKind(c: inout c) {
                    Kind.Colon => {
                        advance(c: inout c)
                        val ty: PType = parseTypeTok(c: inout c)
                        tyStart = ty.start
                        tyLen = ty.len
                        tyIsArray = ty.isArray
                        recordArrayElem(c: inout c, ty: ty)
                    }
                    _ => {}
                }
                fields.append(<FieldDef nameStart=fTok.start nameLen=fTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray />)
            }
            _ => { advance(c: inout c) }
        }
    }
    c.structs.append(<StructDef nameStart=nameTok.start nameLen=nameTok.len fields=fields />)
}

// `enum Name { Variant [{ field: Type, ... }] ... }`. Variant fields take no
// modifiers (bare `name: Type`), per the language's variant-field rule.
fn parseEnum(c: inout Comp) {
    advance(c: inout c)
    val nameTok: Tok = cur(c: inout c)
    advance(c: inout c)
    match curKind(c: inout c) {
        Kind.LBrace => { advance(c: inout c) }
        _ => {}
    }
    mut val variants: Array[Variant] = []
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.RBrace => {
                advance(c: inout c)
                break
            }
            Kind.Eof => { break }
            Kind.Ident => {
                val vTok: Tok = cur(c: inout c)
                advance(c: inout c)
                mut val fields: Array[FieldDef] = []
                match curKind(c: inout c) {
                    Kind.LBrace => {
                        advance(c: inout c)
                        while true {
                            skipNewlines(c: inout c)
                            match curKind(c: inout c) {
                                Kind.RBrace => {
                                    advance(c: inout c)
                                    break
                                }
                                Kind.Eof => { break }
                                Kind.Ident => {
                                    val fTok: Tok = cur(c: inout c)
                                    advance(c: inout c)
                                    mut val tyStart: U64 = 0
                                    mut val tyLen: U64 = 0
                                    mut val tyIsArray: Bool = false
                                    match curKind(c: inout c) {
                                        Kind.Colon => {
                                            advance(c: inout c)
                                            val ty: PType = parseTypeTok(c: inout c)
                                            tyStart = ty.start
                                            tyLen = ty.len
                                            tyIsArray = ty.isArray
                                            recordArrayElem(c: inout c, ty: ty)
                                        }
                                        _ => {}
                                    }
                                    fields.append(<FieldDef nameStart=fTok.start nameLen=fTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray />)
                                    match curKind(c: inout c) {
                                        Kind.Comma => { advance(c: inout c) }
                                        _ => {}
                                    }
                                }
                                _ => { advance(c: inout c) }
                            }
                        }
                    }
                    _ => {}
                }
                variants.append(<Variant nameStart=vTok.start nameLen=vTok.len fields=fields />)
            }
            _ => { advance(c: inout c) }
        }
    }
    c.enums.append(<EnumDef nameStart=nameTok.start nameLen=nameTok.len variants=variants />)
}

fn parseProgram(c: inout Comp) {
    while true {
        skipNewlines(c: inout c)
        val k: Kind = curKind(c: inout c)
        match k {
            Kind.KwFn => { parseFunc(c: inout c) }
            Kind.KwStruct => { parseStruct(c: inout c) }
            Kind.KwEnum => { parseEnum(c: inout c) }
            Kind.Eof => { break }
            _ => { advance(c: inout c) }
        }
    }
}

// ---- C code generation ----

fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

fn writeInt(n: I64) {
    if n < 0 {
        write(s: "-")
        writeInt(n: 0 - n)
        return
    }
    if n >= 10 {
        writeInt(n: n / 10)
    }
    write(s: digitStr(d: n % 10))
}

fn writeSpan(c: inout Comp, start: U64, len: U64) {
    mut val j: U64 = 0
    while j < len {
        writeByte(c.bytes[start + j])
        j += 1
    }
}

fn isPrimType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "Bool") { return true }
    return false
}

// Emit the C *element* type for a type-name span (no Array wrapper): scalars
// -> long long, except U8 -> unsigned char (so byte arrays alias a char buffer
// for String.bytes); String -> PlewString; named struct/enum -> echoed.
fn genCElem(c: inout Comp, start: U64, len: U64) {
    if len == 0 {
        write(s: "long long")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") {
        write(s: "unsigned char")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        write(s: "PlewString")
        return
    }
    if isPrimType(c: inout c, start: start, len: len) {
        write(s: "long long")
        return
    }
    writeSpan(c: inout c, start: start, len: len)
}

// Emit a C type for a (span, isArray) type. `Array[E]` -> `PlewArray_<E>`
// (the element name is C-identifier-safe, so it doubles as the mangle).
fn genCTypeRef(c: inout Comp, start: U64, len: U64, isArray: Bool) {
    if isArray {
        write(s: "PlewArray_")
        writeSpan(c: inout c, start: start, len: len)
        return
    }
    genCElem(c: inout c, start: start, len: len)
}

// Back-compat shim for non-array type positions (scalars / String / named).
fn genCType(c: inout Comp, start: U64, len: U64) {
    genCElem(c: inout c, start: start, len: len)
}

// Compare two source spans byte for byte.
fn spansEqual(c: inout Comp, aStart: U64, aLen: U64, bStart: U64, bLen: U64) -> Bool {
    if aLen != bLen {
        return false
    }
    mut val j: U64 = 0
    while j < aLen {
        if c.bytes[aStart + j] != c.bytes[bStart + j] {
            return false
        }
        j += 1
    }
    return true
}

// Tag index of `Enum.Variant` (the variant's position in its enum declaration).
fn variantIndex(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> I64 {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    return vi as I64
                }
                vi += 1
            }
        }
        ei += 1
    }
    return 0
}

// ---- lightweight type recovery (for monomorphization + .bytes dispatch) ----

fn scalarInfo() -> TypeInfo {
    return <TypeInfo kind=0 nameStart=0 nameLen=0 />
}

fn typeInfoOfName(c: inout Comp, start: U64, len: U64, isArray: Bool) -> TypeInfo {
    if isArray {
        return <TypeInfo kind=3 nameStart=start nameLen=len />
    }
    if len == 0 {
        return scalarInfo()
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        return <TypeInfo kind=1 nameStart=start nameLen=len />
    }
    if isPrimType(c: inout c, start: start, len: len) {
        return scalarInfo()
    }
    return <TypeInfo kind=2 nameStart=start nameLen=len />
}

fn addLocal(c: inout Comp, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool) {
    c.locals.append(<Local nameStart=nameStart nameLen=nameLen tyStart=tyStart tyLen=tyLen isArray=isArray />)
}

// Type of field `fieldName` declared in struct `structName` (else scalar).
fn fieldType(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if spansEqual(c: inout c, aStart: s.nameStart, aLen: s.nameLen, bStart: structStart, bLen: structLen) {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: fieldStart, bLen: fieldLen) {
                    return typeInfoOfName(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                }
                fi += 1
            }
        }
        si += 1
    }
    return scalarInfo()
}

// Recover an expression's type. Only the cases plewc.pw exercises on the base
// of a field/index/method are precise; everything else falls back to scalar.
fn exprType(c: inout Comp, id: U64) -> TypeInfo {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value } => { return scalarInfo() }
        Expr.Str { val start, val len } => { return <TypeInfo kind=1 nameStart=0 nameLen=0 /> }
        Expr.Ident { val start, val len } => {
            mut val i: U64 = c.locals.count
            while i > 0 {
                i -= 1
                val lo: Local = c.locals[i]
                if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
                    return typeInfoOfName(c: inout c, start: lo.tyStart, len: lo.tyLen, isArray: lo.isArray)
                }
            }
            return scalarInfo()
        }
        Expr.Unary { val op, val operand } => { return scalarInfo() }
        Expr.Binary { val op, val lhs, val rhs } => { return scalarInfo() }
        Expr.Call { val nameStart, val nameLen, val args } => {
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            mut val fi: U64 = 0
            while fi < c.funcs.count {
                val f: Func = c.funcs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: nameStart, bLen: nameLen) {
                    if f.hasRet {
                        return typeInfoOfName(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
                    }
                    return scalarInfo()
                }
                fi += 1
            }
            return scalarInfo()
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 2 {
                return fieldType(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
            }
            return scalarInfo()
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen />
        }
        Expr.Array { val elems } => { return scalarInfo() }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 3 {
                return typeInfoOfName(c: inout c, start: bt.nameStart, len: bt.nameLen, isArray: false)
            }
            return scalarInfo()
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => { return scalarInfo() }
    }
    return scalarInfo()
}

// Register a match-bound field as an in-scope local with its declared type.
fn addBindLocal(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, bindStart: U64, bindLen: U64) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: bindStart, bLen: bindLen) {
                            addLocal(c: inout c, nameStart: bindStart, nameLen: bindLen, tyStart: f.tyStart, tyLen: f.tyLen, isArray: f.tyIsArray)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
}

// Emit the C type of a match-bound field (looked up in the enum declaration).
fn genBindType(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, bindStart: U64, bindLen: U64) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: bindStart, bLen: bindLen) {
                            genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
    write(s: "long long")
}

fn binOpStr(op: I64) -> String {
    if op == 56 { return " + " }
    if op == 57 { return " - " }
    if op == 58 { return " * " }
    if op == 59 { return " / " }
    if op == 60 { return " % " }
    if op == 50 { return " == " }
    if op == 51 { return " != " }
    if op == 52 { return " < " }
    if op == 53 { return " <= " }
    if op == 54 { return " > " }
    if op == 55 { return " >= " }
    if op == 61 { return " && " }
    if op == 62 { return " || " }
    return " ? "
}

fn unaryOpStr(op: I64) -> String {
    if op == 57 { return "-" }
    return "!"
}

// Decoded byte length of a string literal (span includes both quotes). Escapes
// like \n / \" / \\ count as one byte; plewc.pw uses only C-compatible escapes,
// so the content is emitted verbatim and just the length is computed here.
fn strDecodedLen(c: inout Comp, start: U64, len: U64) -> I64 {
    mut val n: I64 = 0
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if c.bytes[j] == 92 {
            j += 2
        } else {
            j += 1
        }
        n += 1
    }
    return n
}

fn assignOpStr(op: I64) -> String {
    if op == 49 { return " = " }
    if op == 67 { return " += " }
    if op == 68 { return " -= " }
    if op == 69 { return " *= " }
    if op == 70 { return " /= " }
    return " %= "
}

fn genExpr(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value } => { writeInt(n: value) }
        Expr.Ident { val start, val len } => { writeSpan(c: inout c, start: start, len: len) }
        Expr.Unary { val op, val operand } => {
            write(s: unaryOpStr(op: op))
            write(s: "(")
            genExpr(c: inout c, id: operand)
            write(s: ")")
        }
        Expr.Binary { val op, val lhs, val rhs } => {
            write(s: "(")
            genExpr(c: inout c, id: lhs)
            write(s: binOpStr(op: op))
            genExpr(c: inout c, id: rhs)
            write(s: ")")
        }
        Expr.Call { val nameStart, val nameLen, val args } => {
            // I/O builtins -> C runtime.
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") {
                write(s: "plew_write(")
                genExpr(c: inout c, id: args[0])
                write(s: ")")
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "writeByte") {
                write(s: "putchar((int)(")
                genExpr(c: inout c, id: args[0])
                write(s: "))")
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                write(s: "plew_read_stdin()")
                return
            }
            writeSpan(c: inout c, start: nameStart, len: nameLen)
            write(s: "(")
            mut val i: U64 = 0
            while i < args.count {
                if i > 0 {
                    write(s: ", ")
                }
                genExpr(c: inout c, id: args[i])
                i += 1
            }
            write(s: ")")
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 1 {
                // String.bytes: view the string buffer as an Array[U8] (shared).
                write(s: "({ PlewString __s = ")
                genExpr(c: inout c, id: base)
                write(s: "; (PlewArray_U8){(unsigned char*)__s.data, __s.len, __s.len}; })")
                return
            }
            if bt.kind == 3 {
                // arr.count -> length
                write(s: "(long long)((")
                genExpr(c: inout c, id: base)
                write(s: ").len)")
                return
            }
            genExpr(c: inout c, id: base)
            write(s: ".")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
        }
        Expr.Str { val start, val len } => {
            write(s: "(PlewString){\"")
            writeSpan(c: inout c, start: start + 1, len: len - 2)
            write(s: "\", ")
            writeInt(n: strDecodedLen(c: inout c, start: start, len: len))
            write(s: "}")
        }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            write(s: "PlewArray_")
            writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
            write(s: "_get(")
            genExpr(c: inout c, id: base)
            write(s: ", (long long)(")
            genExpr(c: inout c, id: index)
            write(s: "))")
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => {
            // only `append` is supported
            val bt: TypeInfo = exprType(c: inout c, id: recv)
            write(s: "PlewArray_")
            writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
            write(s: "_push(&(")
            genExpr(c: inout c, id: recv)
            write(s: "), ")
            genExpr(c: inout c, id: args[0])
            write(s: ")")
        }
        Expr.Array { val elems } => {
            // Array literals appear only in typed positions (let init / JSX
            // field), handled by genArrayLiteral with the declared element type.
            // A bare literal here has no element context; emit nothing useful.
            write(s: "0")
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            if isEnum {
                write(s: "(")
                writeSpan(c: inout c, start: typeStart, len: typeLen)
                write(s: "){.tag = ")
                writeInt(n: variantIndex(c: inout c, enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen))
                if fields.count > 0 {
                    write(s: ", .data.")
                    writeSpan(c: inout c, start: variantStart, len: variantLen)
                    write(s: " = {")
                    mut val i: U64 = 0
                    while i < fields.count {
                        if i > 0 {
                            write(s: ", ")
                        }
                        val mf: MakeField = fields[i]
                        write(s: ".")
                        writeSpan(c: inout c, start: mf.nameStart, len: mf.nameLen)
                        write(s: " = ")
                        genExpr(c: inout c, id: mf.value)
                        i += 1
                    }
                    write(s: "}")
                }
                write(s: "}")
            } else {
                write(s: "(")
                genCType(c: inout c, start: typeStart, len: typeLen)
                write(s: "){")
                mut val i: U64 = 0
                while i < fields.count {
                    if i > 0 {
                        write(s: ", ")
                    }
                    val mf: MakeField = fields[i]
                    write(s: ".")
                    writeSpan(c: inout c, start: mf.nameStart, len: mf.nameLen)
                    write(s: " = ")
                    val ft: TypeInfo = fieldType(c: inout c, structStart: typeStart, structLen: typeLen, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
                    if ft.kind == 3 {
                        genArrayLiteral(c: inout c, exprId: mf.value, elemStart: ft.nameStart, elemLen: ft.nameLen)
                    } else {
                        genExpr(c: inout c, id: mf.value)
                    }
                    i += 1
                }
                write(s: "}")
            }
        }
    }
}

// Emit an array literal given the element type from context (declared type of
// the let / field it initializes). Empty -> _new(); non-empty -> a statement
// expression that news then pushes. Falls back to genExpr for non-literals.
fn genArrayLiteral(c: inout Comp, exprId: U64, elemStart: U64, elemLen: U64) {
    val e: Expr = c.exprs[exprId]
    match e {
        Expr.Array { val elems } => {
            if elems.count == 0 {
                write(s: "PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: "_new()")
            } else {
                write(s: "({ PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: " __a = PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: "_new(); ")
                mut val i: U64 = 0
                while i < elems.count {
                    write(s: "PlewArray_")
                    writeSpan(c: inout c, start: elemStart, len: elemLen)
                    write(s: "_push(&__a, ")
                    genExpr(c: inout c, id: elems[i])
                    write(s: "); ")
                    i += 1
                }
                write(s: "__a; })")
            }
        }
        _ => { genExpr(c: inout c, id: exprId) }
    }
}

fn genStmt(c: inout Comp, id: U64) {
    val s: Stmt = c.stmts[id]
    match s {
        Stmt.Let { val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val init } => {
            write(s: "    ")
            genCTypeRef(c: inout c, start: tyStart, len: tyLen, isArray: tyIsArray)
            write(s: " ")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
            write(s: " = ")
            if tyIsArray {
                genArrayLiteral(c: inout c, exprId: init, elemStart: tyStart, elemLen: tyLen)
            } else {
                genExpr(c: inout c, id: init)
            }
            write(s: ";\n")
            addLocal(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray)
        }
        Stmt.Assign { val op, val target, val value } => {
            write(s: "    ")
            genExpr(c: inout c, id: target)
            write(s: assignOpStr(op: op))
            genExpr(c: inout c, id: value)
            write(s: ";\n")
        }
        Stmt.Print { val expr } => {
            write(s: "    printf(\"%lld\\n\", (long long)(")
            genExpr(c: inout c, id: expr)
            write(s: "));\n")
        }
        Stmt.ExprStmt { val expr } => {
            write(s: "    ")
            genExpr(c: inout c, id: expr)
            write(s: ";\n")
        }
        Stmt.Return { val value, val hasValue } => {
            if c.curIsMain {
                write(s: "    return 0;\n")
            } else {
                if c.curRetVoid {
                    write(s: "    return;\n")
                } else {
                    write(s: "    return ")
                    if hasValue {
                        genExpr(c: inout c, id: value)
                    } else {
                        write(s: "0")
                    }
                    write(s: ";\n")
                }
            }
        }
        Stmt.If { val cond, val thenBlk, val elseBlk, val hasElse } => {
            write(s: "    if (")
            genExpr(c: inout c, id: cond)
            write(s: ") {\n")
            genBlock(c: inout c, id: thenBlk)
            write(s: "    }\n")
            if hasElse {
                write(s: "    else {\n")
                genBlock(c: inout c, id: elseBlk)
                write(s: "    }\n")
            }
        }
        Stmt.While { val cond, val body } => {
            write(s: "    while (")
            genExpr(c: inout c, id: cond)
            write(s: ") {\n")
            genBlock(c: inout c, id: body)
            write(s: "    }\n")
        }
        Stmt.Break => {
            write(s: "    break;\n")
        }
        Stmt.Continue => {
            write(s: "    continue;\n")
        }
        Stmt.Match { val scrut, val arms } => {
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            // enum type for the scrutinee temp = the enum named by the first
            // non-wildcard arm's pattern.
            mut val enumStart: U64 = 0
            mut val enumLen: U64 = 0
            mut val q: U64 = 0
            while q < arms.count {
                val aq: MatchArm = arms[q]
                if aq.isWildcard {
                } else {
                    if enumLen == 0 {
                        enumStart = aq.enumStart
                        enumLen = aq.enumLen
                    }
                }
                q += 1
            }
            write(s: "    {\n")
            write(s: "    ")
            writeSpan(c: inout c, start: enumStart, len: enumLen)
            write(s: " _m")
            writeInt(n: t as I64)
            write(s: " = ")
            genExpr(c: inout c, id: scrut)
            write(s: ";\n")
            mut val i: U64 = 0
            mut val firstCond: Bool = true
            while i < arms.count {
                val a: MatchArm = arms[i]
                if a.isWildcard {
                    write(s: "    else {\n")
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                } else {
                    if firstCond {
                        write(s: "    if (_m")
                        firstCond = false
                    } else {
                        write(s: "    else if (_m")
                    }
                    writeInt(n: t as I64)
                    write(s: ".tag == ")
                    writeInt(n: variantIndex(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen))
                    write(s: ") {\n")
                    val binds: Array[Bind] = a.binds
                    mut val bi: U64 = 0
                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        write(s: "        ")
                        genBindType(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
                        write(s: " ")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: " = _m")
                        writeInt(n: t as I64)
                        write(s: ".data.")
                        writeSpan(c: inout c, start: a.variantStart, len: a.variantLen)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: ";\n")
                        addBindLocal(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
                        bi += 1
                    }
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                }
                i += 1
            }
            write(s: "    }\n")
        }
    }
}

fn genBlock(c: inout Comp, id: U64) {
    val b: Block = c.blocks[id]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        genStmt(c: inout c, id: stmts[i])
        i += 1
    }
}

fn nameIsMain(c: inout Comp, f: Func) -> Bool {
    return rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: "main")
}

// Emit a struct body `struct Name { <ctype> field; ... };`. Forward typedefs
// are emitted separately so structs can reference each other by name; by-value
// struct fields still require their definition to appear earlier (v3 relies on
// source order being dependency order).
fn genStructDef(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    write(s: "struct ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " {\n")
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        val f: FieldDef = fields[i]
        write(s: "    ")
        genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
        write(s: " ")
        writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
        write(s: ";\n")
        i += 1
    }
    write(s: "};\n")
}

// Emit a C function signature (no trailing `;` or `{`). `main` is special:
// `int main(void)`. The return type and each parameter type come from the
// declared Plew types via genCType (scalars -> long long, named types echoed).
fn genSignature(c: inout Comp, f: Func) {
    if nameIsMain(c: inout c, f: f) {
        write(s: "int main(void)")
        return
    }
    if f.hasRet {
        genCTypeRef(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
        write(s: " ")
    } else {
        write(s: "void ")
    }
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
    write(s: "(")
    val params: Array[Param] = f.params
    if params.count == 0 {
        write(s: "void")
    } else {
        mut val i: U64 = 0
        while i < params.count {
            if i > 0 {
                write(s: ", ")
            }
            val p: Param = params[i]
            genCTypeRef(c: inout c, start: p.tyStart, len: p.tyLen, isArray: p.tyIsArray)
            write(s: " ")
            writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
            i += 1
        }
    }
    write(s: ")")
}

fn genFunc(c: inout Comp, fi: U64) {
    val f: Func = c.funcs[fi]
    val isMain: Bool = nameIsMain(c: inout c, f: f)
    c.curIsMain = isMain
    if f.hasRet {
        c.curRetVoid = false
    } else {
        c.curRetVoid = true
    }
    // fresh local scope for this function: parameters are the initial bindings
    c.locals = []
    val params: Array[Param] = f.params
    mut val pi: U64 = 0
    while pi < params.count {
        val p: Param = params[pi]
        addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
        pi += 1
    }
    genSignature(c: inout c, f: f)
    write(s: " {\n")
    genBlock(c: inout c, id: f.body)
    if isMain {
        write(s: "    return 0;\n")
    }
    write(s: "}\n")
}

// Emit an enum as a tagged union: `struct E { long long tag; union { struct
// {...} V; ... } data; };`. Nullary variants get a dummy member so the inner
// struct is never empty.
fn genEnumDef(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    write(s: "struct ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " {\n")
    write(s: "    long long tag;\n")
    write(s: "    union {\n")
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val v: Variant = vars[vi]
        write(s: "        struct {")
        val fs: Array[FieldDef] = v.fields
        if fs.count == 0 {
            write(s: " char _u; ")
        } else {
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                write(s: " ")
                genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                write(s: " ")
                writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
                write(s: ";")
                fi += 1
            }
            write(s: " ")
        }
        write(s: "} ")
        writeSpan(c: inout c, start: v.nameStart, len: v.nameLen)
        write(s: ";\n")
        vi += 1
    }
    write(s: "    } data;\n")
    write(s: "};\n")
}

// Write the array C name `PlewArray_<elem>`.
fn wPA(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "PlewArray_")
    writeSpan(c: inout c, start: elemStart, len: elemLen)
}

// `typedef struct { ET* data; long long len; long long cap; } PlewArray_E;`
fn genArrayTypedef(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "typedef struct { ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* data; long long len; long long cap; } ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: ";\n")
}

// Monomorphized array runtime for one element type (new / get / set / push).
// Old buffers leak on growth (stage0/stage1 never free — throwaway model).
fn genArrayRuntimeFns(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "static ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_new(void) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a; a.data = 0; a.len = 0; a.cap = 0; return a; }\n")

    write(s: "static ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_get(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a, long long i) { if (i < 0 || i >= a.len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")

    write(s: "static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_set(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, long long i, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (i < 0 || i >= a->len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } a->data[i] = v; }\n")

    write(s: "static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_push(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (a->len >= a->cap) { long long nc = a->cap < 4 ? 4 : a->cap * 2; ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* nd = (")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "*)malloc(sizeof(")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: ") * nc); for (long long i = 0; i < a->len; i++) nd[i] = a->data[i]; a->data = nd; a->cap = nc; } a->data[a->len] = v; a->len++; }\n")
}

fn isU8Elem(c: inout Comp, elemStart: U64, elemLen: U64) -> Bool {
    return rangeEquals(bytes: c.bytes, start: elemStart, len: elemLen, kw: "U8")
}

// PlewArray_U8 is always available (String.bytes yields it) and is emitted with
// literal text so it needs no source span for "U8".
fn genU8ArrayTypedef() {
    write(s: "typedef struct { unsigned char* data; long long len; long long cap; } PlewArray_U8;\n")
}

fn genU8ArrayRuntime() {
    write(s: "static PlewArray_U8 PlewArray_U8_new(void) { PlewArray_U8 a; a.data = 0; a.len = 0; a.cap = 0; return a; }\n")
    write(s: "static unsigned char PlewArray_U8_get(PlewArray_U8 a, long long i) { if (i < 0 || i >= a.len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")
    write(s: "static void PlewArray_U8_set(PlewArray_U8* a, long long i, unsigned char v) { if (i < 0 || i >= a->len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } a->data[i] = v; }\n")
    write(s: "static void PlewArray_U8_push(PlewArray_U8* a, unsigned char v) { if (a->len >= a->cap) { long long nc = a->cap < 4 ? 4 : a->cap * 2; unsigned char* nd = (unsigned char*)malloc(sizeof(unsigned char) * nc); for (long long i = 0; i < a->len; i++) nd[i] = a->data[i]; a->data = nd; a->cap = nc; } a->data[a->len] = v; a->len++; }\n")
}

// ---- driver ----
//
// Reads a Plew program from stdin (top-level `fn` declarations), parses it into
// an arena AST, and writes a C translation to stdout: the runtime preamble,
// nominal type decls, monomorphized array types, then prototypes and bodies.

fn main() {
    val src: String = readStdin()
    mut val lx: Lexer = <Lexer bytes=src.bytes pos=0 toks=[] depth=0 />
    lex(lx: inout lx)
    mut val c: Comp = <Comp bytes=src.bytes toks=lx.toks pos=0 exprs=[] stmts=[] blocks=[] funcs=[] structs=[] enums=[] arrayElems=[] locals=[] tmp=0 curIsMain=false curRetVoid=false />
    parseProgram(c: inout c)
    // runtime preamble: includes, immutable String, and the I/O builtins'
    // C runtime (the contract stage0 also injects — emitted here so stage1's
    // output is self-contained).
    write(s: "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n")
    write(s: "typedef struct { const char* data; long long len; } PlewString;\n")
    write(s: "static int PlewString_eq(PlewString a, PlewString b) { if (a.len != b.len) return 0; for (long long i = 0; i < a.len; i++) if (a.data[i] != b.data[i]) return 0; return 1; }\n")
    write(s: "static PlewString plew_read_stdin(void) { size_t cap = 4096, len = 0; char* buf = (char*)malloc(cap); int ch; while ((ch = getchar()) != EOF) { if (len + 1 >= cap) { cap *= 2; buf = (char*)realloc(buf, cap); } buf[len++] = (char)ch; } PlewString s; s.data = buf; s.len = (long long)len; return s; }\n")
    write(s: "static void plew_write(PlewString s) { fwrite(s.data, 1, (size_t)s.len, stdout); }\n")
    // forward typedefs for every nominal type (structs + enums).
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        write(s: "typedef struct ")
        writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
        write(s: " ")
        writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
        write(s: ";\n")
        si += 1
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        write(s: "typedef struct ")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: " ")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: ";\n")
        ei += 1
    }
    // array typedefs (element by pointer -> forward decls suffice). U8 is always
    // present (String.bytes); other element types come from declarations.
    genU8ArrayTypedef()
    mut val ai: U64 = 0
    while ai < c.arrayElems.count {
        val ae: Bind = c.arrayElems[ai]
        if isU8Elem(c: inout c, elemStart: ae.nameStart, elemLen: ae.nameLen) {
        } else {
            genArrayTypedef(c: inout c, elemStart: ae.nameStart, elemLen: ae.nameLen)
        }
        ai += 1
    }
    // nominal bodies (may contain arrays by value; typedefs above are complete).
    mut val sj: U64 = 0
    while sj < c.structs.count {
        genStructDef(c: inout c, si: sj)
        sj += 1
    }
    mut val ej: U64 = 0
    while ej < c.enums.count {
        genEnumDef(c: inout c, ei: ej)
        ej += 1
    }
    // array runtime (element by value -> needs full nominal defs above).
    genU8ArrayRuntime()
    mut val ar: U64 = 0
    while ar < c.arrayElems.count {
        val ae2: Bind = c.arrayElems[ar]
        if isU8Elem(c: inout c, elemStart: ae2.nameStart, elemLen: ae2.nameLen) {
        } else {
            genArrayRuntimeFns(c: inout c, elemStart: ae2.nameStart, elemLen: ae2.nameLen)
        }
        ar += 1
    }
    // prototypes (skip main)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if nameIsMain(c: inout c, f: f) {
        } else {
            genSignature(c: inout c, f: f)
            write(s: ";\n")
        }
        i += 1
    }
    // bodies
    mut val j: U64 = 0
    while j < c.funcs.count {
        genFunc(c: inout c, fi: j)
        j += 1
    }
}
