// Failed array checks own scalar source identities and presentation data.
// Public raw services cannot create these private operation records.
impl Comp {
    inout fn diagnosticArrayContextOrigin(origin: SourceRecordingScope, exprId: U64, args: ArgRange, factoryReceiver: U64 = 0U64) -> SourceRecordingScope {
        match origin.arrayContext {
            SourceArrayContextOrigin.Diagnostic(frontier: _) | SourceArrayContextOrigin.Unavailable => { return origin }
            SourceArrayContextOrigin.Regular => {}
        }
        val request = match origin.request {
            SourceRecordOrigin.Raw => { return origin }
            SourceRecordOrigin.CheckingRequest(session: val session, root: val root) => (session: session, root: root)
        }
        if request.session != self.sourceFactSession() { return origin.forArrayContext(context: <SourceArrayContextOrigin.Unavailable />) }
        val shape = match self.sourceCallOperation(exprId: exprId, args: args, factoryReceiver: factoryReceiver) {
            Optional.Some(v: val shape) => shape
            Optional.None => { return origin.forArrayContext(context: <SourceArrayContextOrigin.Unavailable />) }
        }
        match shape {
            SourceCallOperation.Factory(receiver: _, receiverTerm: val receiver, writtenReceiverTerm: _, start: _, length: _, serial: _) => { if receiver == 0U64 || receiver >= self.arena.typeCount() { return origin.forArrayContext(context: <SourceArrayContextOrigin.Unavailable />) } }
            _ => {}
        }
        val owner = match self.currentSourceOwner() { Optional.Some(v: val owner) => owner Optional.None => { return origin.forArrayContext(context: <SourceArrayContextOrigin.Unavailable />) } }
        if !self.sourceFacts.isActive(owner: owner) || !semanticCompletionOwnersEqual(recorded: self.lexicalSourceFactOwner(owner: owner), prepared: request.root) || args.start > self.arena.argPool.count() || args.len > self.arena.argPool.count() - args.start { return origin.forArrayContext(context: <SourceArrayContextOrigin.Unavailable />) }
        mut val written: Array[Arg] = []
        for index in 0U64..<args.len { written.append(self.argAt(args: args, index: index)) }
        val frontier = self.failedArrayContextFrontiers.count()
        self.failedArrayContextFrontiers.append(<SourceArrayFailureFrontier session=request.session root=request.root expression=exprId shape=shape arguments=args written=written />)
        return origin.forArrayContext(context: <SourceArrayContextOrigin.Diagnostic frontier=frontier />)
    }

    inout fn arrayContextRefusalDiagnostic(exprId: U64, ctxRef: U64, origin: SourceRecordingScope, expectedOrigin: SourceExpectedContext) -> CompileDiagnostic {
        val location = self.diagnosticLocationAt(offset: self.exprOffset(id: exprId))
        val owner = self.currentDiagnosticOwner()
        mut val event = 18446744073709551615U64
        mut val start = 0U64
        mut val end = 0U64
        val contextMatches = match expectedOrigin { SourceExpectedContext.Contract(term: val term) => term == ctxRef SourceExpectedContext.None => false }
        val requestMatches = match origin.request {
            SourceRecordOrigin.Raw => false
            SourceRecordOrigin.CheckingRequest(session: val session, root: _) => session == self.sourceFactSession()
        }
        val contextAdmitted = match origin.arrayContext {
            SourceArrayContextOrigin.Regular => true
            SourceArrayContextOrigin.Diagnostic(frontier: val frontier) => frontier < self.failedArrayContextFrontiers.count()
            SourceArrayContextOrigin.Unavailable => false
        }
        val frontier = match origin.arrayContext {
            SourceArrayContextOrigin.Diagnostic(frontier: val frontier) => frontier
            _ => 18446744073709551615U64
        }
        val written = self.authoredArrayLiterals.get(key: exprId)
        if contextMatches && requestMatches && contextAdmitted && written.isSome() {
            val literal = written.unwrap()
            val elements = match self.arena.exprs[exprId] { Expr.Array(elems: val elems) => elems _ => <ExprRange start=0U64 len=18446744073709551615U64 /> }
            val active = match self.currentSourceOwner() {
                Optional.Some(v: val current) => {
                    val root = match origin.request { SourceRecordOrigin.CheckingRequest(session: _, root: val root) => root SourceRecordOrigin.Raw => current }
                    give self.sourceFacts.isActive(owner: current) && semanticCompletionOwnersEqual(recorded: self.lexicalSourceFactOwner(owner: current), prepared: root)
                }
                Optional.None => false
            }
            if active && elements.len == 0U64 && elements.start == literal.elements.start && elements.len == literal.elements.len && literal.start <= literal.end {
                event = self.failedArrayContexts.count()
                start = literal.start
                end = literal.end
                val refusal = <ArrayContextRefusal session=self.sourceFactSession() owner=owner expression=exprId requestedTerm=ctxRef effectiveTerm=ctxRef writtenStart=start writtenEnd=end frontier=frontier event=event location=location />
                self.failedArrayContexts.append(<SourceArrayContextFailure refusal=refusal origin=origin.request arrayContext=origin.arrayContext elements=elements />)
            }
        }
        return <CompileDiagnostic.arrayContext refusal=<ArrayContextRefusal session=self.sourceFactSession() owner=owner expression=exprId requestedTerm=ctxRef effectiveTerm=ctxRef writtenStart=start writtenEnd=end frontier=frontier event=event location=location /> />
    }
}

impl Comp {
    fn arrayFailureLocationsEqual(first: DiagnosticLocation, second: DiagnosticLocation) -> Bool {
        return match first {
            DiagnosticLocation.Unpositioned => match second { DiagnosticLocation.Unpositioned => true _ => false }
            DiagnosticLocation.Line(line: val line) => match second { DiagnosticLocation.Line(line: val other) => line == other _ => false }
            DiagnosticLocation.File(path: val path, line: val line) => match second { DiagnosticLocation.File(path: val otherPath, line: val otherLine) => path == otherPath && line == otherLine _ => false }
        }
    }

    fn diagnosticOwnersEqual(first: DiagnosticOwner, second: DiagnosticOwner) -> Bool {
        return match first {
            DiagnosticOwner.Function(index: val index) => match second { DiagnosticOwner.Function(index: val other) => index == other _ => false }
            DiagnosticOwner.Global(target: val target) => match second { DiagnosticOwner.Global(target: val other) => target == other _ => false }
            DiagnosticOwner.Closure(expression: val expression) => match second { DiagnosticOwner.Closure(expression: val other) => expression == other _ => false }
            DiagnosticOwner.Unknown => false
        }
    }


    fn arrayFailureFrontierMatches(frontier: U64, session: U64, root: SemanticCompletionOwner) -> Bool {
        if frontier >= self.failedArrayContextFrontiers.count() { return false }
        val proof = self.failedArrayContextFrontiers[frontier]
        if proof.session != session || !semanticCompletionOwnersEqual(recorded: proof.root, prepared: root) { return false }
        val factoryReceiver = match proof.shape { SourceCallOperation.Factory(receiver: _, receiverTerm: val term, writtenReceiverTerm: _, start: _, length: _, serial: _) => { if term == 0U64 || term >= self.arena.typeCount() { return false } give term } _ => 0U64 }
        val current = match self.sourceCallOperation(exprId: proof.expression, args: proof.arguments, factoryReceiver: factoryReceiver) { Optional.Some(v: val shape) => shape Optional.None => { return false } }
        if !proof.shape.same(other: current) { return false }
        val args = proof.arguments
        if args.start > self.arena.argPool.count() || args.len > self.arena.argPool.count() - args.start || args.len != proof.written.count() { return false }
        for index in 0U64..<args.len {
            val recorded = proof.written[index]
            val current = self.argAt(args: args, index: index)
            if recorded.expr != current.expr || recorded.isInout != current.isInout || recorded.hasLabel != current.hasLabel || recorded.labelStart != current.labelStart || recorded.labelLen != current.labelLen { return false }
        }
        return true
    }
}

pub impl Comp {
    // Necessary private-event validation, never Source interpretation permission.
    fn sourceArrayContextHasOwner(refusal: ArrayContextRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.event() >= self.failedArrayContexts.count() || refusal.expression() >= self.arena.exprs.count() || refusal.effectiveTerm() == 0U64 || refusal.effectiveTerm() >= self.arena.typeCount() { return false }
        val proof = self.failedArrayContexts[refusal.event()]
        val saved = proof.refusal
        if saved.session() != refusal.session() || saved.event() != refusal.event() || saved.frontier() != refusal.frontier() || saved.expression() != refusal.expression() || saved.requestedTerm() != refusal.requestedTerm() || saved.effectiveTerm() != refusal.effectiveTerm() || saved.writtenStart() != refusal.writtenStart() || saved.writtenEnd() != refusal.writtenEnd() || !self.diagnosticOwnersEqual(first: saved.owner(), second: refusal.owner()) || !self.arrayFailureLocationsEqual(first: saved.location(), second: refusal.location()) { return false }
        val literal = match self.authoredArrayLiterals.get(key: refusal.expression()) { Optional.Some(v: val literal) => literal Optional.None => { return false } }
        if literal.start != refusal.writtenStart() || literal.end != refusal.writtenEnd() || literal.elements.start != proof.elements.start || literal.elements.len != proof.elements.len { return false }
        match self.arena.exprs[refusal.expression()] {
            Expr.Array(elems: val elements) => { if elements.start != proof.elements.start || elements.len != 0U64 || elements.len != proof.elements.len { return false } }
            _ => { return false }
        }
        val request = match proof.origin {
            SourceRecordOrigin.Raw => { return false }
            SourceRecordOrigin.CheckingRequest(session: val session, root: val root) => (session: session, root: root)
        }
        if request.session != refusal.session() || self.sourceFacts.outcome(owner: request.root).isNone() { return false }
        return match proof.arrayContext {
            SourceArrayContextOrigin.Regular => refusal.frontier() == 18446744073709551615U64
            SourceArrayContextOrigin.Unavailable => false
            SourceArrayContextOrigin.Diagnostic(frontier: val frontier) => frontier == refusal.frontier() && self.arrayFailureFrontierMatches(frontier: frontier, session: request.session, root: request.root)
        }
    }
}
