// Closure signature introduction owns group admission. Local storage only
// receives its success; source origin is checked synchronously on refusal.
impl Comp {
    fn closureParameterNames(parameters: Array[Param]) -> Result[Array[Span], CompileDiagnostic] {
        mut val names: Array[Span] = []
        for parameter in parameters {
            if parameter.nameStart > self.arena.bytes.count() || parameter.nameLen > self.arena.bytes.count()-parameter.nameStart {
                return <Result.Err error=<CompileDiagnostic failureDomain=<FailureDomain.Internal /> location=<DiagnosticLocation.Unpositioned /> message="parameter group contains an invalid name span" /> />
            }
            names.append(<Span start=parameter.nameStart end=parameter.nameStart+parameter.nameLen />)
        }
        return <Result.Ok value=names />
    }

    fn authoredClosureSignatureMatches(expression: U64, written: AuthoredClosureSignature) -> Bool {
        if expression >= self.arena.exprs.count() || expression >= self.arena.exprOriginSerial.count() || expression >= self.arena.exprSpanStart.count() || expression >= self.arena.exprSpanEnd.count() { return false }
        if self.arena.exprOriginSerial[expression] != written.serial || self.arena.exprSpanStart[expression] != written.start || self.arena.exprSpanEnd[expression] != written.end { return false }
        val original = match written.expression {
            Expr.Closure(params: val parameters, hasRet: val hasReturn, retStart: val returnStart, retLen: val returnLength, retIsArray: val returnArray, retTy: val returnType, body: val body, isDiverging: val diverging) => (parameters: parameters, hasReturn: hasReturn, returnStart: returnStart, returnLength: returnLength, returnArray: returnArray, returnType: returnType, body: body, diverging: diverging)
            _ => { return false }
        }
        val current = match self.arena.exprs[expression] {
            Expr.Closure(params: val parameters, hasRet: val hasReturn, retStart: val returnStart, retLen: val returnLength, retIsArray: val returnArray, retTy: val returnType, body: val body, isDiverging: val diverging) => (parameters: parameters, hasReturn: hasReturn, returnStart: returnStart, returnLength: returnLength, returnArray: returnArray, returnType: returnType, body: body, diverging: diverging)
            _ => { return false }
        }
        if current.hasReturn != original.hasReturn || current.returnStart != original.returnStart || current.returnLength != original.returnLength || current.returnArray != original.returnArray || current.returnType != original.returnType || current.body != original.body || current.diverging != original.diverging || current.parameters.count() != original.parameters.count() { return false }
        for index in 0U64..<current.parameters.count() {
            val first = original.parameters[index]
            val second = current.parameters[index]
            if first.nameStart != second.nameStart || first.nameLen != second.nameLen || first.nameId != second.nameId || first.noLabel != second.noLabel || first.tyStart != second.tyStart || first.tyLen != second.tyLen || first.tyNameId != second.tyNameId || first.tyIsArray != second.tyIsArray || first.ty != second.ty || first.isInout != second.isInout || first.isMove != second.isMove || first.isBorrow != second.isBorrow || first.hasDefault != second.hasDefault || first.defaultExpr != second.defaultExpr || first.authoredTypeUse != second.authoredTypeUse { return false }
        }
        return true
    }

    // Bind the Lower occurrence to its original lexical root, not merely to
    // whichever parent currently points at that expression in a Raw Arena.
    inout fn closureSignatureHasLexicalOwner(written: AuthoredClosureSignature, owner: SemanticCompletionOwner) -> Bool {
        val scope = match self.sourceTypeUses.scopeAt(token: written.scope) { Optional.Some(v: val scope) => scope Optional.None => { return false } }
        match scope.state { SourceTypeScopeState.Lowered => {} _ => { return false } }
        match owner {
            SemanticCompletionOwner.Global(target: val target) => { return self.sourceTypeUses.globalScope(target: target) == written.scope }
            SemanticCompletionOwner.Function(index: val function) => {
                if function >= self.arena.functionCount() { return false }
                mut val declaration = function
                mut val expectedScope = written.scope
                match self.decls.defaultGeneratorOrigins.get(key: function) {
                    Optional.Some(v: val origin) => {
                        val expression = match self.defaultOriginExpression(origin: origin, offset: written.start) { Result.Ok(value: val expression) => expression Result.Err(error: _) => { return false } }
                        if expression >= self.arena.exprOriginSerial.count() || self.sourceTypeUses.defaultExpressionScope(origin: self.arena.exprOriginSerial[expression]) != written.scope { return false }
                        match origin {
                            DefaultGeneratorOrigin.Parameter(function: val parent, parameter: _) => { declaration = parent expectedScope = scope.parent }
                            DefaultGeneratorOrigin.Field(structure: val structure, field: _) => { return structure < self.arena.structCount() && scope.parent == self.arena.structAt(index: structure).sourceTypeScope }
                        }
                    }
                    Optional.None => {}
                }
                if declaration >= self.arena.functionCount() { return false }
                val token = match self.sourceTypeUses.signatureFor(function: declaration) { Optional.Some(v: val signature) => signature.scope Optional.None => self.sourceTypeUses.deinitScopeToken(function: declaration) }
                if token != expectedScope { return false }
                val original = match self.sourceTypeUses.scopeAt(token: token) { Optional.Some(v: val original) => original Optional.None => { return false } }
                return original.anchor == self.arena.functionAt(index: declaration).defOffset && original.function.unwrapOr(fallback: 18446744073709551615U64) == declaration
            }
            SemanticCompletionOwner.Closure(expression: _) => { return false }
        }
    }

    inout fn closureParameterFailureProof(expression: U64, origin: SourceRecordOrigin) -> Optional[(session: U64, owner: SemanticCompletionOwner, root: SemanticCompletionOwner, authored: AuthoredClosureSignature, path: SourceNodePath)] {
        val request = match origin {
            SourceRecordOrigin.Raw => { return <Optional.None /> }
            SourceRecordOrigin.CheckingRequest(session: val session, root: val root) => (session: session, root: root)
        }
        if request.session != self.sourceFactSession() { return <Optional.None /> }
        val owner = match self.currentSourceOwner() { Optional.Some(v: val owner) => owner Optional.None => { return <Optional.None /> } }
        if !self.sourceFacts.isActive(owner: owner) || !semanticCompletionOwnersEqual(recorded: self.lexicalSourceFactOwner(owner: owner), prepared: request.root) { return <Optional.None /> }
        val written = match self.authoredClosureSignatures.get(key: expression) { Optional.Some(v: val written) => written Optional.None => { return <Optional.None /> } }
        if !self.authoredClosureSignatureMatches(expression: expression, written: written) || !self.closureSignatureHasLexicalOwner(written: written, owner: request.root) { return <Optional.None /> }
        val path = match self.sourceControlNodePath(owner: owner, target: <SourceControlNode.Expression id=expression />) { Optional.Some(v: val path) => path Optional.None => { return <Optional.None /> } }
        return <Optional.Some v=(session: request.session, owner: owner, root: request.root, authored: written, path: path) />
    }

    inout fn admitRecordedClosureParameters(expression: U64, origin: SourceRecordOrigin) -> Result[(), CompileDiagnostic] {
        if expression >= self.arena.exprs.count() { return <Result.Err error=<CompileDiagnostic failureDomain=<FailureDomain.Internal /> location=<DiagnosticLocation.Unpositioned /> message="closure parameter admission has no expression" /> /> }
        val parameters = match self.arena.exprs[expression] {
            Expr.Closure(params: val parameters, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _, isDiverging: _) => parameters
            _ => { return <Result.Err error=<CompileDiagnostic failureDomain=<FailureDomain.Internal /> location=<DiagnosticLocation.Unpositioned /> message="closure parameter admission requires a closure" /> /> }
        }
        val names = try self.closureParameterNames(parameters: parameters)
        val conflict = match declarationLabelConflict(bytes: self.arena.bytes, labels: names) { Optional.Some(v: val conflict) => conflict Optional.None => { return <Result.Ok value=() /> } }
        val raw = match self.parameterNameConflictDiagnostic(names: names, conflict: conflict, origin: <FrontendDeclarationOrigin.Raw />) { Result.Err(error: val diagnostic) => diagnostic Result.Ok(value: _) => { return <Result.Ok value=() /> } }
        // Only the actual duplicate refusal has a source-owner interpretation.
        match conflict { DeclarationLabelConflict.Duplicate(first: _, second: _) => {} DeclarationLabelConflict.Malformed(index: _) => { return <Result.Err error=raw /> } }
        val proof = match self.closureParameterFailureProof(expression: expression, origin: origin) { Optional.Some(v: val proof) => proof Optional.None => { return <Result.Err error=raw /> } }
        val refusal = <ClosureSignatureRefusal session=proof.session owner=self.closureSignatureDiagnosticOwner(owner: proof.owner) expression=expression event=self.failedClosureSignatures.count() location=raw.location() message=raw.message() notes=raw.notes() />
        self.failedClosureSignatures.append(<SourceClosureSignatureFailure refusal=refusal owner=proof.owner root=proof.root authored=proof.authored path=proof.path />)
        return <Result.Err error=<CompileDiagnostic.closureSignature refusal=refusal /> />
    }

    fn closureSignatureDiagnosticOwner(owner: SemanticCompletionOwner) -> DiagnosticOwner {
        return match owner {
            SemanticCompletionOwner.Function(index: val function) => <DiagnosticOwner.Function index=function />
            SemanticCompletionOwner.Global(target: val target) => <DiagnosticOwner.Global target=target />
            SemanticCompletionOwner.Closure(expression: val expression) => <DiagnosticOwner.Closure expression=expression />
        }
    }

    fn sourceClosureSignatureFailureHasOwner(refusal: ClosureSignatureRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.event() >= self.failedClosureSignatures.count() { return false }
        val proof = self.failedClosureSignatures[refusal.event()]
        val original = proof.refusal
        if original.session() != refusal.session() || original.event() != refusal.event() || original.expression() != refusal.expression() || !self.diagnosticOwnersEqual(first: original.owner(), second: refusal.owner()) || !original.location().same(other: refusal.location()) || original.message() != refusal.message() || original.notes().count() != refusal.notes().count() { return false }
        for index in 0U64..<original.notes().count() {
            if !original.notes()[index].location.same(other: refusal.notes()[index].location) || original.notes()[index].message != refusal.notes()[index].message { return false }
        }
        if !semanticCompletionOwnersEqual(recorded: proof.owner, prepared: proof.path.owner) || !self.diagnosticOwnersEqual(first: self.closureSignatureDiagnosticOwner(owner: proof.owner), second: refusal.owner()) { return false }
        if !self.authoredClosureSignatureMatches(expression: refusal.expression(), written: proof.authored) { return false }
        return self.sourceControlNodePathMatches(path: proof.path)
    }

}
