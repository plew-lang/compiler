// Part of the LLVM backend (root: _.pw): enum (tagged-union) representation, payload words, and construction.

// ---- enums (tagged unions) ----

// The genEnum* slot for a registered enum named (start,len) — its 0-type-arg instance —
// or st.genEnumRefs.count() if not registered.

pub impl LlvmCtx {
    // B1 (generic-unification): a non-generic enum is the 0-type-arg instance of itself,
    // registered in the genEnum* tables (see registerEnums). enumRegSlot now returns that
    // genEnum* slot — every enum resolves through the one `%ge` mechanism. The slot indexes
    // genEnumRefs/genEnumDefs/genEnumTys (sentinel genEnumRefs.count()); the 0-arg filter
    // disambiguates a non-generic enum from any generic instance that shares the head name.
    inout fn enumRegSlot(c: inout Comp, start: U64, len: U64) -> U64 {
        val eid: U64 = c.enumIdxByName(start: start, len: len)
        if eid < c.arena.enums.count() {
            return self.enumRegSlotByEid(c: inout c, eid: eid)
        }
        return self.genEnumRefs.count()
    }

    // How many i64 words a primitive field occupies in the enum payload area (String
    // is {ptr,i64} = 2; scalar/Bool = 1; a registered struct = sum of its fields).
    inout fn fieldWords(c: inout Comp, tyStart: U64, tyLen: U64) -> U64 {
        // substitute a type parameter via the active env (so a payload field of type T
        // is sized as its concrete argument).
        if c.cur.typeParams.count() > 0U64 {
            val qid: U64 = intern(c: inout c, start: tyStart, len: tyLen)
            mut val ti: U64 = 0
            while ti < c.cur.typeParams.count() {
                if c.cur.typeParams[ti].nameId == qid {
                    val at: TypeRef = c.arena.types[c.cur.typeArgs[ti]]
                    // an existential argument (`T -> any P`) is the fat pointer (2 words);
                    // recursing on `at`'s bare trait name would size it as 1 word.
                    if refIsAny(c: inout c, ref: c.cur.typeArgs[ti]) {
                        return 2U64
                    }
                    // an array argument (`T -> Array[I32]`) is the {ptr,i64} value (2 words).
                    if rangeEquals(bytes: c.arena.bytes, start: at.nameStart, len: at.nameLen, kw: "Array") {
                        return 2U64
                    }
                    return self.fieldWords(c: inout c, tyStart: at.nameStart, tyLen: at.nameLen)
                }
                ti += 1
            }
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "String") {
            return 2U64
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Array") {
            return 2U64
        }
        // a function type (head `fn`) is the closure value { fn ptr, env ptr } = 2 words.
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "fn") {
            return 2U64
        }
        val sreg: U64 = self.structRegSlot(c: inout c, start: tyStart, len: tyLen)
        if sreg < self.genStructRefs.count() {
            val sd: StructDef = c.arena.structs[self.genStructDefs[sreg]]
            mut val w: U64 = 0
            mut val i: U64 = 0
            while i < sd.fields.count() {
                w = w + self.fieldWordsF(c: inout c, f: sd.fields[i])
                i += 1
            }
            return w
        }
        // an inline (non-boxed) enum field is the full tagged union `{ i64 tag,
        // [maxWords] payload }` = 1 + its own payload words — NOT 1 (the old default,
        // which undersized any enum/struct-with-enum payload field and overflowed the
        // enclosing enum's payload area, corrupting adjacent fields). Non-boxed value
        // cycles are a front-end error, so the recursion terminates (boxed = 1).
        val ereg: U64 = c.enumIdxByName(start: tyStart, len: tyLen)
        if ereg < c.arena.enums.count() {
            return 1U64 + self.enumPayloadWords(c: inout c, eid: ereg)
        }
        return 1U64
    }

    // The max payload-word count over an enum's variants (the size of its `[N x i64]`
    // payload area). Shared by registerEnums and fieldWords (an inline enum field).
    inout fn enumPayloadWords(c: inout Comp, eid: U64) -> U64 {
        val e: EnumDef = c.arena.enums[eid]
        mut val maxW: U64 = 0
        mut val vi: U64 = 0
        while vi < e.variants.count() {
            val fs: Array[FieldDef] = e.variants[vi].fields
            mut val w: U64 = 0
            mut val fj: U64 = 0
            while fj < fs.count() {
                w = w + self.fieldWordsF(c: inout c, f: fs[fj])
                fj += 1
            }
            if w > maxW {
                maxW = w
            }
            vi += 1
        }
        return maxW
    }

    // The payload-word count of an enum field, honoring boxing: a boxed (recursive)
    // field is a single heap pointer (1 word); otherwise its type's natural size.
    inout fn fieldWordsF(c: inout Comp, f: FieldDef) -> U64 {
        if c.fieldIsBoxed(f: f) {
            return 1U64
        }
        // an array field (declared `Array[E]`, tyStart naming the element) is the
        // {ptr,i64} value (2 words) — fieldWords reads the element span and would miss it.
        if f.tyIsArray {
            return 2U64
        }
        // a generic-instance payload field (`A(o: Optional[I64])`): size the instance
        // under its own substitution env (the head-name path drops the args and would
        // size `Optional[String]`'s String arg as 1 word instead of 2).
        if f.ty != 0U64 {
            mut val g: U64 = f.ty
            if c.cur.typeParams.count() > 0U64 {
                g = c.groundTypeRef(ref: f.ty)
            }
            // a type param bound to an existential (`Some(T)` with `T = any P`): the fat
            // pointer is 2 words (data + vtable). The head-name path below sizes a bare `T`
            // as 1 word, undersizing the enclosing enum's `[N x i64]` payload area.
            if refIsAny(c: inout c, ref: g) {
                return 2U64
            }
            // a reference-cell / `Buffer[T]` payload (possibly reached via a type param `Some(v: T)`,
            // T -> Ref[Cell]) is a single opaque pointer (1 word). Checked before isGenericInst:
            // Ref/Buffer carry type args (so isGenericInst is true) but are extern intrinsics,
            // not registered generic structs, so genInstWords would size them as 0 — collapsing
            // the enum's payload area to [0 x i64] and dropping the pointer on copy.
            if c.isStrongRefInst(ref: g) {
                return 1U64
            }
            // a `WeakRef[T]` payload is likewise a single opaque pointer (1 word) — same extern-
            // intrinsic-carrying-type-args trap as Ref, so checked here before isGenericInst.
            if c.isWeakRefLikeInst(ref: g) {
                return 1U64
            }
            if c.isRawBufInst(ref: g) {
                return 1U64
            }
            // a function-typed payload (`fn(...) -> R`, possibly via `T -> fn`) is the
            // closure value { fn ptr, env ptr } = 2 words. The head-name fallback below
            // would size it as 1, undersizing the payload area — a closure stored into
            // an `Optional[fn ...]` then overflows into the adjacent words.
            if c.isFnType(ref: g) {
                return 2U64
            }
            if c.isGenericInst(ref: g) {
                // Array[E] is the {ptr,i64} value type, not an inline instance.
                if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[g].nameStart, len: c.arena.types[g].nameLen, kw: "Array") {
                    return 2U64
                }
                return self.genInstWords(c: inout c, ref: g)
            }
        }
        return self.fieldWords(c: inout c, tyStart: f.tyStart, tyLen: f.tyLen)
    }

    // The inline word size of a concrete generic instance `ref` (a generic-struct or
    // generic-enum instantiation), under its own type-parameter substitution env. A
    // generic struct is the sum of its fields; a generic enum is `1 (tag) + maxWords`
    // over its variants — mirroring registerGenEnums' sizing so an inline gen-instance
    // member is sized identically to its standalone named type.
    inout fn genInstWords(c: inout Comp, ref: U64) -> U64 {
        val t: TypeRef = c.arena.types[ref]
        val gsi: U64 = c.genericStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if gsi < c.arena.structs.count() {
            val sd: StructDef = c.arena.structs[gsi]
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            c.cur.typeParams = sd.typeParams
            c.cur.typeArgs = t.args
            mut val w: U64 = 0
            mut val i: U64 = 0
            while i < sd.fields.count() {
                w = w + self.fieldWordsF(c: inout c, f: sd.fields[i])
                i += 1
            }
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
            return w
        }
        val gei: U64 = c.genericEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if gei < c.arena.enums.count() {
            val e: EnumDef = c.arena.enums[gei]
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            c.cur.typeParams = e.typeParams
            c.cur.typeArgs = t.args
            mut val maxW: U64 = 0
            mut val vi: U64 = 0
            while vi < e.variants.count() {
                val fs: Array[FieldDef] = e.variants[vi].fields
                mut val w: U64 = 0
                mut val fj: U64 = 0
                while fj < fs.count() {
                    w = w + self.fieldWordsF(c: inout c, f: fs[fj])
                    fj += 1
                }
                if w > maxW {
                    maxW = w
                }
                vi += 1
            }
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
            return 1U64 + maxW
        }
        return 1U64
    }

    // Whether an enum is registerable as a named tagged-union here — the pure
    // type-graph predicate (struct/enum payloads are allowed if representable).
    inout fn enumAllPrimitive(c: inout Comp, eid: U64) -> Bool {
        return enumRepresentable(c: inout c, eid: eid)
    }

    // Register every non-generic, all-primitive-variant enum as a named LLVM type
    // `{ i64 tag, [maxWords x i64] payload }`. Called after registerStructs.
    inout fn registerEnums(c: inout Comp) {
        mut val ei: U64 = 0
        while ei < c.arena.enums.count() {
            val e: EnumDef = c.arena.enums[ei]
            if e.typeParams.count() <= 0 {
                if self.enumAllPrimitive(c: inout c, eid: ei) {
                    val maxWords: U64 = self.enumPayloadWords(c: inout c, eid: ei)
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "en".bytes())
                    appendU64Dec(into: inout nm, n: ei)
                    nm.append(0)
                    val ty: LLVMTypeRef = LLVMStructCreateNamed(self.ctx, arrayCPtr(nm))
                    mut val elems: Array[LLVMTypeRef] = []
                    elems.append(self.i64ty)
                    elems.append(LLVMArrayType2(self.i64ty, maxWords))
                    LLVMStructSetBody(ty, arrayCPtr(elems), 2U64, 0I32)
                    // B1 (generic-unification): a non-generic enum is the 0-type-arg instance of
                    // itself — registered in the SAME genEnum* tables as generic instances. Every
                    // enum then resolves through the one genEnumSlot path (the `%ge` mechanism);
                    // the separate name-registered `enumIdxs`/`enumTys` tables are gone. The
                    // instance ref is the enum's bare name with no args.
                    mut val zargs: Array[U64] = []
                    val instRef: U64 = c.pushType(t: <TypeRef nameStart=e.nameStart nameLen=e.nameLen args=zargs />)
                    self.genEnumRefs.append(instRef)
                    self.genEnumTys.append(ty)
                    self.genEnumDefs.append(ei)
                }
            }
            ei += 1
        }
    }

    // The LLVM struct type of a variant's payload (its fields in declared order).
    inout fn variantPayloadTy(c: inout Comp, eid: U64, vi: U64) -> LLVMTypeRef {
        val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
        mut val elems: Array[LLVMTypeRef] = []
        mut val i: U64 = 0
        while i < fs.count() {
            // a boxed (recursive) field is a heap pointer; otherwise fieldLlvmTy resolves
            // the array ({ptr,i64}), existential (fat ptr), generic-instance (its named
            // tagged-union / struct type), or scalar type — matching the value built in
            // buildEnumValue, so insertvalue types agree.
            if c.fieldIsBoxed(f: fs[i]) {
                elems.append(self.ptrty)
            } else {
                elems.append(self.fieldLlvmTy(c: inout c, fd: fs[i]))
            }
            i += 1
        }
        return LLVMStructTypeInContext(self.ctx, arrayCPtr(elems), elems.count(), 0I32)
    }

    // ---- enum value ARC (tag-dispatch over the active variant's payload) ----
    //
    // Release any heap held by enum value `v` whose type ref is `ref` (a generic instance
    // like `Optional[Array[I64]]` via genEnumSlot, or a plain registered enum by name).
    // Returns true if `ref` was an enum (so the caller knows it was handled).
    inout fn emitEnumReleaseRef(c: inout Comp, v: LLVMValueRef, ref: U64) -> Bool {
        if ref == 0U64 {
            return false
        }
        val ge: U64 = self.genEnumSlot(c: inout c, ref: ref)
        if ge < self.genEnumRefs.count() {
            // set the instance env so a payload field of type-param type (`Some(v: T)`,
            // T -> Ref[Cell]) grounds in the enumNeedsDeinit gate (fieldGroundedRefTy).
            // The release itself is a CALL to the instance's witness (per-instance,
            // emitted under this same env) — never an inline walk, so a recursive
            // (boxed) payload releases by the witness calling itself at runtime.
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val didSet: Bool = self.setEnumEnv(c: inout c, ref: ref)
            if self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[ge]) {
                val slot: U64 = self.enumReleaseWitness(c: inout c, reg: ge)
                mut val av: Array[LLVMValueRef] = []
                av.append(v)
                LLVMBuildCall2(self.b, self.enumRelWitTy[slot], self.enumRelWitVal[slot], arrayCPtr(av), 1U64, anon())
            }
            if didSet {
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
            }
            return true
        }
        val t: TypeRef = c.arena.types[ref]
        val reg: U64 = self.enumRegSlot(c: inout c, start: t.nameStart, len: t.nameLen)
        if reg < self.genEnumRefs.count() {
            if self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[reg]) {
                val slot: U64 = self.enumReleaseWitness(c: inout c, reg: reg)
                mut val av: Array[LLVMValueRef] = []
                av.append(v)
                LLVMBuildCall2(self.b, self.enumRelWitTy[slot], self.enumRelWitVal[slot], arrayCPtr(av), 1U64, anon())
            }
            return true
        }
        return false
    }

    // Deep-copy enum value `v` of type `ref` if it is an enum that owns heap; else return v
    // unchanged. Used at every site that places an enum value into a longer-lived owner.
    inout fn deepCopyEnumRef(c: inout Comp, v: LLVMValueRef, ref: U64) -> LLVMValueRef {
        if ref == 0U64 {
            return v
        }
        val ge: U64 = self.genEnumSlot(c: inout c, ref: ref)
        if ge < self.genEnumRefs.count() {
            // instance env so a type-param `Ref` payload grounds (see emitEnumReleaseRef).
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val didSet: Bool = self.setEnumEnv(c: inout c, ref: ref)
            mut val res: LLVMValueRef = v
            if self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[ge]) {
                res = self.deepCopyEnumValue(c: inout c, v: v, eid: self.genEnumDefs[ge], ety: self.genEnumTys[ge])
            }
            if didSet {
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
            }
            return res
        }
        val t: TypeRef = c.arena.types[ref]
        val reg: U64 = self.enumRegSlot(c: inout c, start: t.nameStart, len: t.nameLen)
        if reg < self.genEnumRefs.count() {
            if self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[reg]) {
                val slot: U64 = self.enumCopyWitness(c: inout c, eid: self.genEnumDefs[reg], ety: self.genEnumTys[reg])
                mut val av: Array[LLVMValueRef] = []
                av.append(v)
                return LLVMBuildCall2(self.b, self.enumCopyWitTy[slot], self.enumCopyWitVal[slot], arrayCPtr(av), 1U64, anon())
            }
        }
        return v
    }

    // Whether variant `vi` of enum `eid` has a heap-owning field. A boxed (recursive)
    // field is an rc'd heap cell — the box itself always releases, so it answers true
    // without consulting the pointee (which also keeps this predicate loop-free for
    // recursive enums; no arcStack guard needed). Each other field grounds under the
    // CURRENT env (caller — emitEnumReleaseRef etc. — has set the enum instance env)
    // and gates on the classifier's recursive needs-heap answer (arcNeedsRelease): the
    // old name-check chain missed enum payloads and generic-instance struct payloads
    // entirely (their heap was silently skipped).
    inout fn variantHasHeap(c: inout Comp, eid: U64, vi: U64) -> Bool {
        val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
        mut val fj: U64 = 0
        while fj < fs.count() {
            val fd: FieldDef = fs[fj]
            if c.fieldIsBoxed(f: fd) {
                return true
            }
            if fd.tyIsArray {
                return true
            }
            if c.arcNeedsRelease(ref: c.arcFieldTy(f: fd)) {
                return true
            }
            fj += 1
        }
        return false
    }

    // Whether an enum value of `eid` releases any heap on destruction (any variant has heap).
    inout fn enumNeedsDeinit(c: inout Comp, eid: U64) -> Bool {
        mut val vi: U64 = 0
        while vi < c.arena.enums[eid].variants.count() {
            if self.variantHasHeap(c: inout c, eid: eid, vi: vi) {
                return true
            }
            vi += 1
        }
        return false
    }

    // Release the heap held by enum value `v` (LLVM type `ety`) of enum `eid`: store it,
    // load the tag, and for each variant that owns heap, branch on `tag == vi`, reinterpret
    // the payload area as that variant's struct, and release each field's heap — a boxed
    // payload drops one cell owner (pointee destroyed at rc 0), everything else routes
    // through the classifier.
    inout fn emitEnumRelease(c: inout Comp, v: LLVMValueRef, eid: U64, ety: LLVMTypeRef) {
        // break codegen recursion for a self-referential enum reached through a non-boxed
        // array element (`ExprAst.ArrayLit(elems: Array[ExprAst])`): keyed by enum id in the
        // shared arcStack, offset past any struct sidx so the two id spaces never collide.
        if self.arcOnStack(sidx: self.enumArcKey(eid: eid)) {
            return
        }
        self.arcPush(sidx: self.enumArcKey(eid: eid))
        val slot: LLVMValueRef = self.entryAlloca(ty: ety)
        LLVMBuildStore(self.b, v, slot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()), anon())
        val payloadPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon())
        mut val vi: U64 = 0
        while vi < c.arena.enums[eid].variants.count() {
            if self.variantHasHeap(c: inout c, eid: eid, vi: vi) {
                val isV: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon())
                val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumrel.v"))
                val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumrel.c"))
                LLVMBuildCondBr(self.b, isV, thenBB, contBB)
                LLVMPositionBuilderAtEnd(self.b, thenBB)
                val pty: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi)
                val pv: LLVMValueRef = LLVMBuildLoad2(self.b, pty, payloadPtr, anon())
                val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
                mut val fj: U64 = 0
                while fj < fs.count() {
                    val fd: FieldDef = fs[fj]
                    if c.fieldIsBoxed(f: fd) {
                        // a boxed (recursive) payload: drop one owner of its cell; at rc 0
                        // the pointee is destroyed (witness-routed runtime recursion).
                        self.emitBoxedFieldRelease(c: inout c, cell: LLVMBuildExtractValue(self.b, pv, fj, anon()), f: fd)
                    } else {
                        if fd.tyIsArray {
                            val fv: LLVMValueRef = LLVMBuildExtractValue(self.b, pv, fj, anon())
                            val er: U64 = arrayFieldElemRef(c: inout c, f: fd)
                            mut val ety2: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                            if er != 0U64 {
                                ety2 = self.llvmTypeOfRef(c: inout c, ref: er)
                            }
                            self.emitReleaseArrayValue(c: inout c, data: self.arrValData(c: inout c, arr: fv), count: self.arrValCount(c: inout c, arr: fv), elemTy: ety2, elemRef: er)
                        } else {
                            // classifier + valueArc (the single class->action table):
                            // GROUNDED struct/enum payloads included — the old
                            // structIndexByName chain skipped generic-inst / bare-T /
                            // enum payloads (their heap leaked or was never released).
                            val g: U64 = c.arcFieldTy(f: fd)
                            match c.arcClassOfRef(ref: g) {
                                ArcClass.Scalar => {}
                                ArcClass.StructVal(sidx: _) => {
                                    if c.arcNeedsRelease(ref: g) {
                                        self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, pv, fj, anon()), typeRef: g, retain: false)
                                    }
                                }
                                _ => {
                                    self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, pv, fj, anon()), typeRef: g, retain: false)
                                }
                            }
                        }
                    }
                    fj += 1
                }
                LLVMBuildBr(self.b, contBB)
                LLVMPositionBuilderAtEnd(self.b, contBB)
            }
            vi += 1
        }
        self.arcPop()
    }

    // Shallow-retain the heap held by enum value `v` (type `ety`) of `eid`: tag-dispatch and,
    // for the active variant, bump each non-boxed array field's buffer rc and recurse into
    // struct fields. Mirrors emitEnumRelease — used when an Array[Enum] CoW duplicates an
    // element so each owner co-owns the element's field buffers (balanced at outer drop).
    inout fn emitEnumRetain(c: inout Comp, v: LLVMValueRef, eid: U64, ety: LLVMTypeRef) {
        // mirror emitEnumRelease's self-referential codegen-recursion guard.
        if self.arcOnStack(sidx: self.enumArcKey(eid: eid)) {
            return
        }
        self.arcPush(sidx: self.enumArcKey(eid: eid))
        val slot: LLVMValueRef = self.entryAlloca(ty: ety)
        LLVMBuildStore(self.b, v, slot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()), anon())
        val payloadPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon())
        mut val vi: U64 = 0
        while vi < c.arena.enums[eid].variants.count() {
            if self.variantHasHeap(c: inout c, eid: eid, vi: vi) {
                val isV: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon())
                val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumret.v"))
                val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumret.c"))
                LLVMBuildCondBr(self.b, isV, thenBB, contBB)
                LLVMPositionBuilderAtEnd(self.b, thenBB)
                val pty: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi)
                val pv: LLVMValueRef = LLVMBuildLoad2(self.b, pty, payloadPtr, anon())
                val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
                mut val fj: U64 = 0
                while fj < fs.count() {
                    val fd: FieldDef = fs[fj]
                    if c.fieldIsBoxed(f: fd) {
                        // a boxed (recursive) payload: bump the cell rc (shallow CoW-share),
                        // balanced by emitBoxedFieldRelease in the release twin.
                        self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, pv, fj, anon()))
                    } else {
                        if fd.tyIsArray {
                            self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: LLVMBuildExtractValue(self.b, pv, fj, anon())))
                        } else {
                            // classifier + valueArc — mirrors emitEnumRelease's kernel
                            // (grounded struct/enum payloads included) so retain and
                            // release stay symmetric by construction.
                            val g: U64 = c.arcFieldTy(f: fd)
                            match c.arcClassOfRef(ref: g) {
                                ArcClass.Scalar => {}
                                ArcClass.StructVal(sidx: _) => {
                                    if c.arcNeedsRelease(ref: g) {
                                        self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, pv, fj, anon()), typeRef: g, retain: true)
                                    }
                                }
                                _ => {
                                    self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, pv, fj, anon()), typeRef: g, retain: true)
                                }
                            }
                        }
                    }
                    fj += 1
                }
                LLVMBuildBr(self.b, contBB)
                LLVMPositionBuilderAtEnd(self.b, contBB)
            }
            vi += 1
        }
        self.arcPop()
    }

    // The arcStack recursion-guard key for enum `eid`: offset past any struct sidx so enum
    // and struct id spaces never collide in the shared stack (structs push their bare sidx).
    inout fn enumArcKey(eid: U64) -> U64 {
        return 4611686018427387904U64 + eid
    }

    // ---- per-enum value-ARC witnesses (registered/concrete enums only) ----
    // Each mirrors the struct witnesses: a single per-enum function out-of-lines the
    // tag-dispatch walker so every value-ARC site emits a call. Concrete enum fields are
    // env-independent (declared array-ness + concrete element/struct refs), so the body is
    // byte-for-byte the inline walker, just moved into a function. Declared on demand at a
    // site, bodies drained after the main pass by a growing cursor.

    // The release-witness table is keyed by the genEnum* INSTANCE slot (not the enum id):
    // a generic instance (`Optional[Node[I64]]`) gets its own witness whose body is
    // emitted under ITS substitution env, so every enum release — concrete or generic
    // instance — is a function CALL. That makes runtime recursion expressible: a boxed
    // (recursive) payload's cell release destroys its pointee by calling the same
    // witness, which an inline walker (guarded by arcOnStack) could never encode.
    inout fn enumRelWitSlot(reg: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.enumRelWitReg.count() {
            if self.enumRelWitReg[i] == reg {
                return i
            }
            i += 1
        }
        return self.enumRelWitReg.count()
    }
    inout fn enumReleaseWitness(c: inout Comp, reg: U64) -> U64 {
        val found: U64 = self.enumRelWitSlot(reg: reg)
        if found < self.enumRelWitReg.count() {
            return found
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.genEnumTys[reg])
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwenumrel".bytes())
        appendU64Dec(into: inout nm, n: reg)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.enumRelWitReg.append(reg)
        self.enumRelWitVal.append(fv)
        self.enumRelWitTy.append(fty)
        return self.enumRelWitReg.count() - 1U64
    }
    inout fn emitEnumReleaseWitnessBodies(c: inout Comp) {
        while self.enumRelWitDone < self.enumRelWitReg.count() {
            val s: U64 = self.enumRelWitDone
            val reg: U64 = self.enumRelWitReg[s]
            val fv: LLVMValueRef = self.enumRelWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            // ground payload fields under the instance's own env (a no-op for a
            // 0-type-arg concrete enum).
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val didSet: Bool = self.setEnumEnv(c: inout c, ref: self.genEnumRefs[reg])
            self.emitEnumRelease(c: inout c, v: LLVMGetParam(fv, 0U64), eid: self.genEnumDefs[reg], ety: self.genEnumTys[reg])
            if didSet {
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
            }
            LLVMBuildRetVoid(self.b)
            self.enumRelWitDone += 1
        }
    }

    inout fn enumRetWitSlot(eid: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.enumRetWitEid.count() {
            if self.enumRetWitEid[i] == eid {
                return i
            }
            i += 1
        }
        return self.enumRetWitEid.count()
    }
    inout fn enumRetainWitness(c: inout Comp, eid: U64, ety: LLVMTypeRef) -> U64 {
        val found: U64 = self.enumRetWitSlot(eid: eid)
        if found < self.enumRetWitEid.count() {
            return found
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(ety)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwenumret".bytes())
        appendU64Dec(into: inout nm, n: eid)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.enumRetWitEid.append(eid)
        self.enumRetWitVal.append(fv)
        self.enumRetWitTy.append(fty)
        return self.enumRetWitEid.count() - 1U64
    }
    inout fn emitEnumRetainWitnessBodies(c: inout Comp) {
        while self.enumRetWitDone < self.enumRetWitEid.count() {
            val s: U64 = self.enumRetWitDone
            val fv: LLVMValueRef = self.enumRetWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            self.emitEnumRetain(c: inout c, v: LLVMGetParam(fv, 0U64), eid: self.enumRetWitEid[s], ety: self.genEnumTys[self.enumRegSlotByEid(c: inout c, eid: self.enumRetWitEid[s])])
            LLVMBuildRetVoid(self.b)
            self.enumRetWitDone += 1
        }
    }

    inout fn enumCopyWitSlot(eid: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.enumCopyWitEid.count() {
            if self.enumCopyWitEid[i] == eid {
                return i
            }
            i += 1
        }
        return self.enumCopyWitEid.count()
    }
    inout fn enumCopyWitness(c: inout Comp, eid: U64, ety: LLVMTypeRef) -> U64 {
        val found: U64 = self.enumCopyWitSlot(eid: eid)
        if found < self.enumCopyWitEid.count() {
            return found
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(ety)
        val fty: LLVMTypeRef = LLVMFunctionType(ety, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwenumcopy".bytes())
        appendU64Dec(into: inout nm, n: eid)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.enumCopyWitEid.append(eid)
        self.enumCopyWitVal.append(fv)
        self.enumCopyWitTy.append(fty)
        return self.enumCopyWitEid.count() - 1U64
    }
    inout fn emitEnumCopyWitnessBodies(c: inout Comp) {
        while self.enumCopyWitDone < self.enumCopyWitEid.count() {
            val s: U64 = self.enumCopyWitDone
            val fv: LLVMValueRef = self.enumCopyWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            LLVMBuildRet(self.b, self.deepCopyEnumValue(c: inout c, v: LLVMGetParam(fv, 0U64), eid: self.enumCopyWitEid[s], ety: self.genEnumTys[self.enumRegSlotByEid(c: inout c, eid: self.enumCopyWitEid[s])]))
            self.enumCopyWitDone += 1
        }
    }

    // The genEnum* slot for a non-generic enum by its enum id — its 0-type-arg instance
    // (genEnumDefs[slot]==eid AND the ref carries no args, distinguishing it from a generic
    // instance of a same-named def). genEnumRefs.count() if not registered.
    inout fn enumRegSlotByEid(c: inout Comp, eid: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genEnumRefs.count() {
            if self.genEnumDefs[i] == eid {
                if c.arena.types[self.genEnumRefs[i]].args.count() == 0U64 {
                    return i
                }
            }
            i += 1
        }
        return self.genEnumRefs.count()
    }

    // Retain the heap of enum value `v` of type `ref` if it owns any (genericinstance or
    // registered named enum needing deinit); else a nop. The retain counterpart of
    // emitEnumReleaseRef.
    inout fn emitEnumRetainRef(c: inout Comp, v: LLVMValueRef, ref: U64) -> Bool {
        if ref == 0U64 {
            return false
        }
        val ge: U64 = self.genEnumSlot(c: inout c, ref: ref)
        if ge < self.genEnumRefs.count() {
            // instance env so a type-param `Ref` payload grounds (see emitEnumReleaseRef).
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val didSet: Bool = self.setEnumEnv(c: inout c, ref: ref)
            if self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[ge]) {
                self.emitEnumRetain(c: inout c, v: v, eid: self.genEnumDefs[ge], ety: self.genEnumTys[ge])
            }
            if didSet {
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
            }
            return true
        }
        val t: TypeRef = c.arena.types[ref]
        val reg: U64 = self.enumRegSlot(c: inout c, start: t.nameStart, len: t.nameLen)
        if reg < self.genEnumRefs.count() {
            if self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[reg]) {
                val slot: U64 = self.enumRetainWitness(c: inout c, eid: self.genEnumDefs[reg], ety: self.genEnumTys[reg])
                mut val av: Array[LLVMValueRef] = []
                av.append(v)
                LLVMBuildCall2(self.b, self.enumRetWitTy[slot], self.enumRetWitVal[slot], arrayCPtr(av), 1U64, anon())
            }
            return true
        }
        return false
    }

    // Deep-copy enum value `v` (type `ety`) of `eid` so its heap is independent of the
    // source: store it, tag-dispatch, deep-copy the active variant's non-boxed array/struct
    // fields in place, and reload. Mirrors emitEnumRelease — needed wherever an enum value
    // is placed into a longer-lived owner (so the source's drop does not free it).
    inout fn deepCopyEnumValue(c: inout Comp, v: LLVMValueRef, eid: U64, ety: LLVMTypeRef) -> LLVMValueRef {
        val slot: LLVMValueRef = self.entryAlloca(ty: ety)
        LLVMBuildStore(self.b, v, slot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()), anon())
        val payloadPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon())
        mut val vi: U64 = 0
        while vi < c.arena.enums[eid].variants.count() {
            if self.variantHasHeap(c: inout c, eid: eid, vi: vi) {
                val isV: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon())
                val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumcp.v"))
                val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumcp.c"))
                LLVMBuildCondBr(self.b, isV, thenBB, contBB)
                LLVMPositionBuilderAtEnd(self.b, thenBB)
                val pty: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi)
                mut val pv: LLVMValueRef = LLVMBuildLoad2(self.b, pty, payloadPtr, anon())
                val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
                mut val fj: U64 = 0
                while fj < fs.count() {
                    val fd: FieldDef = fs[fj]
                    if c.fieldIsBoxed(f: fd) {
                        // a boxed (recursive) payload: the copy CoW-SHARES the cell and
                        // retains it (a whole-field repoint allocates a fresh cell, so a
                        // sharer never observes mutation).
                        self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, pv, fj, anon()))
                    } else {
                        if fd.tyIsArray {
                            val er: U64 = arrayFieldElemRef(c: inout c, f: fd)
                            mut val ety2: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                            if er != 0U64 {
                                ety2 = self.llvmTypeOfRef(c: inout c, ref: er)
                            }
                            val nf: LLVMValueRef = self.copyArrayValue(c: inout c, arrVal: LLVMBuildExtractValue(self.b, pv, fj, anon()), elemTy: ety2, elemRef: er)
                            pv = LLVMBuildInsertValue(self.b, pv, nf, fj, anon())
                        } else if fieldGroundedRefTy(c: inout c, f: fd) != 0U64 {
                            // a `Ref` payload is shared on copy: keep the cell, retain its rc.
                            self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, pv, fj, anon()))
                        } else if fieldGroundedWeakTy(c: inout c, f: fd) != 0U64 {
                            // a `WeakRef` payload is shared on copy: keep the cell, bump its weak rc.
                            self.refWeakDowngrade(c: inout c, cell: LLVMBuildExtractValue(self.b, pv, fj, anon()))
                        } else if refIsAny(c: inout c, ref: c.arcFieldTy(f: fd)) {
                            // an `any P` payload: the copy CoW-SHARES the box and retains it
                            // (the inout-dispatch write gate privatizes a shared box).
                            self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, LLVMBuildExtractValue(self.b, pv, fj, anon()), 0U64, anon()))
                        } else if c.isFnType(ref: c.arcFieldTy(f: fd)) {
                            // a closure payload: share the env cell and retain it.
                            self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, LLVMBuildExtractValue(self.b, pv, fj, anon()), 1U64, anon()))
                        } else {
                            val fsi: U64 = c.structIndexByName(start: fd.tyStart, len: fd.tyLen)
                            if fsi < c.arena.structs.count() {
                                if !(c.arena.structs[fsi].isExtern) {
                                    if self.structNeedsDeinit(c: inout c, sidx: fsi) {
                                        pv = LLVMBuildInsertValue(self.b, pv, self.deepCopyStructValue(c: inout c, v: LLVMBuildExtractValue(self.b, pv, fj, anon()), sidx: fsi), fj, anon())
                                    }
                                }
                            }
                        }
                    }
                    fj += 1
                }
                LLVMBuildStore(self.b, pv, payloadPtr)
                LLVMBuildBr(self.b, contBB)
                LLVMPositionBuilderAtEnd(self.b, contBB)
            }
            vi += 1
        }
        return LLVMBuildLoad2(self.b, ety, slot, anon())
    }

    // Construct an enum value `<E.V f=e ... />`: alloca {tag,payload}, store the tag
    // and (if any) the variant payload struct, then load the whole value.
    inout fn genLlvmMakeEnum(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, ty: U64, fields: Array[MakeField]) -> LLVMValueRef {
        // a JSX construction without explicit type args (`<Optional.Some v=42 />`) has
        // an ungrounded head `ty`; fall back to the expected type from context (a let
        // annotation / boxed-field pointee) when it names this same generic enum. Consume
        // it so it can't leak into the payload sub-expressions.
        mut val ty: U64 = ty
        // inside a generic fn/method body, an explicit-arg construction (`<Optional[T].Some
        // …/>` in a body where T=Box) names the syntactic `Optional[T]`; ground its args
        // through the active env so it resolves to the registered concrete instance
        // (mirrors genLlvmMake for structs). Without this, genEnumSlot looks up the
        // ungrounded `Optional[T]` template and fails.
        if c.isGenericInst(ref: ty) {
            if c.cur.typeParams.count() > 0U64 {
                ty = c.groundTypeRef(ref: ty)
            }
        }
        if !(c.isGenericInst(ref: ty)) {
            if self.expectedTy != 0U64 {
                if c.isGenericInst(ref: self.expectedTy) {
                    val et: TypeRef = c.arena.types[self.expectedTy]
                    if spansEqual(c: inout c, aStart: et.nameStart, aLen: et.nameLen, bStart: typeStart, bLen: typeLen) {
                        ty = self.expectedTy
                    }
                }
            }
        }
        self.expectedTy = 0U64
        // a generic enum instance (Optional[I64]): build under its substitution env.
        if c.isGenericInst(ref: ty) {
            val gslot: U64 = self.genEnumSlot(c: inout c, ref: ty)
            if gslot < self.genEnumRefs.count() {
                val savedP: Array[Bind] = c.cur.typeParams
                val savedA: Array[U64] = c.cur.typeArgs
                // MERGE the enum's env onto the outer one (don't replace) so a payload
                // sub-expression referencing the enclosing method's type params still
                // grounds (e.g. `self.f` in MapIter.next's `<Optional.Some v=self.f(x:v)/>`).
                // The enum's OWN params go LAST (highest index): resolveTy is last-match, so a
                // name collision (`Optional[Optional[I32]]` — both levels' param named `T`)
                // must resolve to THIS instance's `T` (inner = I32), not the enclosing `T`
                // (outer = Optional[I32]) — lexical shadowing, innermost wins.
                c.cur.typeParams = concatParams(add: savedP, base: c.arena.enums[self.genEnumDefs[gslot]].typeParams)
                c.cur.typeArgs = concatArgs(add: savedA, base: c.arena.types[ty].args)
                val v: LLVMValueRef = self.buildEnumValue(c: inout c, eid: self.genEnumDefs[gslot], ety: self.genEnumTys[gslot], typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, fields: fields)
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
                return v
            }
        }
        val reg: U64 = self.enumRegSlot(c: inout c, start: typeStart, len: typeLen)
        if reg >= self.genEnumRefs.count() {
            c.errorAt(offset: typeStart, msg: "LLVM backend: construction of this enum not yet supported (generic / array-field enums are TODO)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        return self.buildEnumValue(c: inout c, eid: self.genEnumDefs[reg], ety: self.genEnumTys[reg], typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, fields: fields)
    }

    // Build an enum value of LLVM type `ety` for def `eid`: store the tag + the
    // variant payload struct (under the active substitution env).
    inout fn buildEnumValue(c: inout Comp, eid: U64, ety: LLVMTypeRef, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, fields: Array[MakeField]) -> LLVMValueRef {
        val vi: U64 = c.variantIndex(enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen)
        val slot: LLVMValueRef = self.entryAlloca(ty: ety)
        // zero the whole cell first (tag + payload) so unused payload words are
        // deterministic — a payload-less variant then has an all-zero payload, making
        // tag+word structural `==` well-defined.
        LLVMBuildStore(self.b, LLVMConstNull(ety), slot)
        LLVMBuildStore(self.b, LLVMConstInt(self.i64ty, vi, 0I32), LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()))
        val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
        if fs.count() > 0U64 {
            val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi)
            // start ZERO (not undef) so an omitted field with no default is zero-init,
            // mirroring the C backend's designated initializer (any field the
            // construction doesn't name is C-zero — e.g. `<Expr.Int … />` without the
            // later-added `isNeg` field).
            mut val agg: LLVMValueRef = LLVMConstNull(payloadTy)
            mut val fj: U64 = 0
            while fj < fs.count() {
                mut val valExpr: U64 = 0
                mut val found: Bool = false
                mut val mi: U64 = 0
                while mi < fields.count() {
                    if spansEqual(c: inout c, aStart: fields[mi].nameStart, aLen: fields[mi].nameLen, bStart: fs[fj].nameStart, bLen: fs[fj].nameLen) {
                        valExpr = fields[mi].value
                        found = true
                        mi = fields.count()
                    } else {
                        mi += 1
                    }
                }
                // an omitted field: use its declared default if any, else leave it zero
                // (the C designated initializer does the same). NO positional fallback —
                // enum payloads are constructed by name (spec/05).
                if !(found) {
                    if fs[fj].hasDefault {
                        valExpr = fs[fj].defaultVal
                        found = true
                    }
                }
                if !(found) {
                    fj += 1
                    continue
                }
                // a boxed (recursive) field: build the payload value, heap-allocate a
                // FRESH cell (rc=1 — this construction is its first owner), store the
                // value, and put the cell pointer in the payload. Copies share+retain
                // the cell; the last owner's drop destroys the pointee and frees it.
                if c.fieldIsBoxed(f: fs[fj]) {
                    // ground the boxed field type under the env so a recursive GENERIC enum
                    // payload (`Node(l: Tree[T], r: Tree[T])` in `Tree[I64]`) grounds to the
                    // registered concrete instance instead of the ungrounded template.
                    mut val bg: U64 = fs[fj].ty
                    if c.cur.typeParams.count() > 0U64 {
                        bg = c.groundTypeRef(ref: fs[fj].ty)
                    }
                    self.expectedTy = bg
                    // the boxed value moves into a heap cell that outlives this scope; if it
                    // came from a place (`<ExprAst.Assign target=lhs/>`), deep-copy its heap so
                    // the source local's drop does not free the boxed payload (struct/enum/array).
                    val boxedVal: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: valExpr), valueExpr: valExpr)
                    val boxedTy: LLVMTypeRef = LLVMTypeOf(boxedVal)
                    val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(boxedTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
                    LLVMBuildStore(self.b, boxedVal, cell)
                    agg = LLVMBuildInsertValue(self.b, agg, cell, fj, anon())
                } else {
                    // a payload field of array type — declared `Array[E]` or a type param
                    // grounding to one (`v: T` with T -> Array[I32]): an array-literal
                    // value must be built with the field's concrete element type, not
                    // i64-defaulted.
                    val gfElem: U64 = arrayFieldElemRef(c: inout c, f: fs[fj])
                    if gfElem != 0U64 {
                        match c.arena.exprs[valExpr] {
                            Expr.Array(val elems) => {
                                agg = LLVMBuildInsertValue(self.b, agg, self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: self.llvmTypeOfRef(c: inout c, ref: gfElem), elemRef: gfElem), fj, anon())
                            }
                            _ => {
                                // value semantics: an array payload from a place SHARES the
                                // buffer + retains (scalar element, Stage 2a) or eager-copies
                                // (non-scalar), so dropping the source local does not free a
                                // buffer the constructed enum now owns.
                                val pelemTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: gfElem)
                                val pav: LLVMValueRef = self.shareArrayIfPlace(c: inout c, arrVal: self.genLlvmExpr(c: inout c, id: valExpr), elemTy: pelemTy, valueExpr: valExpr)
                                agg = LLVMBuildInsertValue(self.b, agg, pav, fj, anon())
                            }
                        }
                    } else {
                        // a (non-boxed) generic-instance payload field by value
                        // (`Leaf(v: Optional[I64])`): ground its declared type and pass it
                        // as the expected type so an un-suffixed nested JSX construction
                        // (`v=<Optional.Some v=42 />`) infers the instance's type args.
                        mut val gpf: U64 = fs[fj].ty
                        if gpf != 0U64 {
                            if c.cur.typeParams.count() > 0U64 {
                                gpf = c.groundTypeRef(ref: fs[fj].ty)
                            }
                        }
                        // a record-typed payload (`v: (index:U64,value:I64)`, or a type param
                        // grounding to one): set the expected type so a context-less record
                        // literal value resolves its struct (records have a `(`-prefixed name).
                        mut val gpfIsRecord: Bool = false
                        if gpf != 0U64 {
                            if c.arena.types[gpf].nameLen > 0U64 {
                                if c.arena.bytes[c.arena.types[gpf].nameStart] == 40U8 {
                                    gpfIsRecord = true
                                }
                            }
                        }
                        // an `any P` / closure payload: same canonical path — the box / env
                        // cell is rc'd, so embedding a PLACE (`Optional.Some(v)` in
                        // ArrayIter.next) must rc++ it; the source local's scope-exit
                        // release then balances (aliasing instead under-counted the box —
                        // a UAF once both the loop's element release and the array's
                        // element cascade dropped their shares).
                        mut val gpfIsAnyOrFn: Bool = false
                        if gpf != 0U64 {
                            if gpf < c.arena.types.count() {
                                gpfIsAnyOrFn = c.arena.types[gpf].isAny || c.isFnType(ref: gpf)
                            }
                        }
                        if c.isStrongRefInst(ref: gpf) || c.isWeakRefLikeInst(ref: gpf) || gpfIsAnyOrFn {
                            // an existential `any P` payload initialized from a concrete
                            // conforming value (`Wrap(v: any Shape)` <- `<Sq …/>`): box it into
                            // the fat pointer first — the payload slot is anyTy (2 words), so
                            // inserting the raw concrete value would mismatch the slot (invalid
                            // IR). A value that is already `any` (or a Ref/WeakRef/closure) is
                            // not boxed and is co-owned via consumeIntoOwned below.
                            mut val anyBoxed: Bool = false
                            val boxedAny: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: gpf, valueExpr: valExpr, outBoxed: inout anyBoxed)
                            if anyBoxed {
                                agg = LLVMBuildInsertValue(self.b, agg, boxedAny, fj, anon())
                            } else {
                                // a `Ref[T]`/`WeakRef[T]` / already-`any` / closure payload: route
                                // through consumeIntoOwned so the constructed enum CO-OWNS it
                                // (rc++ a place; a fresh owner passes through). The one canonical
                                // "make owned" path shared with binds/args/returns/struct fields.
                                val rv: LLVMValueRef = self.consumeIntoOwned(c: inout c, v: self.genLlvmExpr(c: inout c, id: valExpr), expr: valExpr, typeRef: gpf)
                                agg = LLVMBuildInsertValue(self.b, agg, rv, fj, anon())
                            }
                        } else if gpf != 0U64 && (c.isGenericInst(ref: gpf) || gpfIsRecord) {
                            self.expectedTy = gpf
                            val giv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valExpr)
                            // a generic-instance payload with heap (`A(o: Optional[Array])`,
                            // `Some(v: Node[I64])`) from a place: CoW-SHARE its heap (rc++)
                            // through the classifier's retain action — enum AND struct
                            // instances alike (the old emitEnumRetainRef was a silent no-op
                            // for a struct instance, so its boxed cell / buffers were never
                            // co-owned — double-free at the two owners' drops). The gateway
                            // CoWs before any later mutation. Mirrors consumeIntoOwned.
                            if exprAliasesPlace(c: inout c, id: valExpr) {
                                if c.arcNeedsRelease(ref: gpf) {
                                    self.valueArc(c: inout c, v: giv, typeRef: gpf, retain: true)
                                }
                            }
                            agg = LLVMBuildInsertValue(self.b, agg, giv, fj, anon())
                        } else {
                            // a struct-with-heap payload from a place: deep-copy so the enum's
                            // payload is independent of the source (mirrors genFieldValue).
                            mut val handled: Bool = false
                            val psi: U64 = self.localStructIdxFor(c: inout c, start: fs[fj].tyStart, len: fs[fj].tyLen)
                            if psi < c.arena.structs.count() {
                                if self.structNeedsDeinit(c: inout c, sidx: psi) {
                                    if exprAliasesPlace(c: inout c, id: valExpr) {
                                        // CoW-SHARE the struct place into the payload (rc++ its
                                        // heap fields); the gateway CoWs before any mutation.
                                        val psv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valExpr)
                                        self.emitStructRetain(c: inout c, v: psv, sidx: psi)
                                        agg = LLVMBuildInsertValue(self.b, agg, psv, fj, anon())
                                        handled = true
                                    }
                                }
                            }
                            if !(handled) {
                                mut val fv: LLVMValueRef = self.coerceIntTo(c: inout c, v: self.genLlvmExpr(c: inout c, id: valExpr), tyStart: fs[fj].tyStart, tyLen: fs[fj].tyLen)
                                // a plain (non-generic) enum payload from a place (`<StmtAst.ExprStmt
                                // expr=lhs/>`, expr: ExprAst inline): deep-copy its active variant's
                                // heap so the source local's drop does not free a buffer the
                                // constructed enum now co-owns (mirrors the struct branch above; the
                                // generic-enum case is handled at line ~590). localStructIdxFor misses
                                // it (it is an enum, not a struct), so it would otherwise bit-copy.
                                // emitEnumRetainRef is a no-op off an enum type, so scalar places keep
                                // their width coercion (coerceIntTo above) unchanged.
                                if exprAliasesPlace(c: inout c, id: valExpr) {
                                    mut val gef: U64 = fs[fj].ty
                                    if c.cur.typeParams.count() > 0U64 {
                                        gef = c.groundTypeRef(ref: fs[fj].ty)
                                    }
                                    self.emitEnumRetainRef(c: inout c, v: fv, ref: gef)
                                }
                                agg = LLVMBuildInsertValue(self.b, agg, fv, fj, anon())
                            }
                        }
                    }
                }
                fj += 1
            }
            LLVMBuildStore(self.b, agg, LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon()))
        }
        return LLVMBuildLoad2(self.b, ety, slot, anon())
    }

}

pub impl LlvmCtx {

    // Build an enum value of LLVM type `ety` for def `eid`, variant `vi`, from
    // already-computed LLVM payload values (vs. buildEnumValue which evaluates expr
    // ids). Used by the `?.` / `try` desugar where the payload is an extracted SSA
    // value. The payload value types must match the variant's payload struct.
    inout fn buildEnumFromValues(c: inout Comp, eid: U64, ety: LLVMTypeRef, vi: U64, payloadVals: Array[LLVMValueRef]) -> LLVMValueRef {
        val slot: LLVMValueRef = self.entryAlloca(ty: ety)
        LLVMBuildStore(self.b, LLVMConstNull(ety), slot)
        LLVMBuildStore(self.b, LLVMConstInt(self.i64ty, vi, 0I32), LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()))
        if payloadVals.count() > 0U64 {
            val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi)
            mut val agg: LLVMValueRef = LLVMGetUndef(payloadTy)
            mut val j: U64 = 0
            while j < payloadVals.count() {
                agg = LLVMBuildInsertValue(self.b, agg, payloadVals[j], j, anon())
                j += 1
            }
            LLVMBuildStore(self.b, agg, LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon()))
        }
        return LLVMBuildLoad2(self.b, ety, slot, anon())
    }
}
