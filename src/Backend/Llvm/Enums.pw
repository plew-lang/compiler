// Part of the LLVM backend (root: _.pw): enum (tagged-union) representation, payload words, and construction.

// ---- enums (tagged unions) ----

pub impl LlvmCtx {
    // The payload reserves whole i64 words. Summing per-field rounded sizes
    // is conservative for subword scalars and keeps alignment at most one word.
    // Boxed recursion ends at its pointer; inline cycles are rejected upstream.
    inout fn enumPayloadWords(c: inout Comp, typeRef: U64) -> Result[U64, CompileDiagnostic] {
        val contract = c.arena.finalDestructions[(try c.checkedFinalDestruction(typeRef: typeRef)) - 1U64]
        if contract.variantFieldStarts.count() == 0U64 || contract.fieldTypes.count() != contract.fieldBoxed.count() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: finalized enum layout has inconsistent fields") />
        }
        mut val maximum = 0U64
        mut val variant = 0U64
        while variant + 1U64 < contract.variantFieldStarts.count() {
            mut val field = contract.variantFieldStarts[variant]
            val end = contract.variantFieldStarts[variant + 1U64]
            if field > end || end > contract.fieldTypes.count() {
                return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: finalized enum layout has an invalid variant range") />
            }
            mut val words = 0U64
            while field < end {
                if contract.fieldBoxed[field] { words += 1U64 }
                else { words += (try self.typeWords(c: inout c, typeRef: contract.fieldTypes[field])) }
                field += 1U64
            }
            if words > maximum { maximum = words }
            variant += 1U64
        }
        return <Result.Ok value=maximum />
    }

    inout fn typeWords(c: inout Comp, typeRef: U64) -> Result[U64, CompileDiagnostic] {
        if typeRef == 0U64 { return <Result.Ok value=0U64 /> }
        val contract = c.arena.finalDestructions[(try c.checkedFinalDestruction(typeRef: typeRef)) - 1U64]
        if contract.underlying != 0U64 { return <Result.Ok value=(try self.typeWords(c: inout c, typeRef: contract.underlying)) /> }
        if contract.structLayout != 0U64 {
            mut val words = 0U64
            mut val field = 0U64
            while field < contract.fieldTypes.count() {
                if contract.fieldBoxed[field] { words += 1U64 }
                else { words += (try self.typeWords(c: inout c, typeRef: contract.fieldTypes[field])) }
                field += 1U64
            }
            return <Result.Ok value=words />
        }
        match contract.ownershipClass {
            ArcClass.EnumVal(eidx: _) => { return <Result.Ok value=1U64 + (try self.enumPayloadWords(c: inout c, typeRef: typeRef)) /> }
            ArcClass.AnyBox => { return <Result.Ok value=2U64 /> }
            ArcClass.ClosureVal => { return <Result.Ok value=2U64 /> }
            _ => { return <Result.Ok value=1U64 /> }
        }
    }

    // Payload layout consumes the same concrete field contract as ownership.
    inout fn variantPayloadTy(c: inout Comp, instanceRef: U64, vi: U64) -> Result[LLVMTypeRef, CompileDiagnostic] {
        val contract = c.arena.finalDestructions[(try c.checkedFinalDestruction(typeRef: instanceRef)) - 1U64]
        if contract.underlying != 0U64 { return <Result.Ok value=(try self.variantPayloadTy(c: inout c, instanceRef: contract.underlying, vi: vi)) /> }
        if vi + 1U64 >= contract.variantFieldStarts.count() || contract.fieldBoxed.count() != contract.fieldTypes.count() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum payload has an incomplete field contract") />
        }
        val start = contract.variantFieldStarts[vi]
        val end = contract.variantFieldStarts[vi + 1U64]
        if start > end || end > contract.fieldTypes.count() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum payload has an invalid field range") />
        }
        mut val elements: Array[LLVMTypeRef] = []
        mut val field = start
        while field < end {
            if contract.fieldBoxed[field] { elements.append(self.ptrty) }
            else { elements.append((try self.llvmTypeOfRef(c: inout c, ref: contract.fieldTypes[field]))) }
            field += 1U64
        }
        return <Result.Ok value=LLVMStructTypeInContext(self.ctx, arrayCPtr(elements), elements.count(), 0I32) />
    }

    // ---- enum value ARC (tag-dispatch over the active variant's payload) ----
    //
    // Release any heap held by enum value `v` whose type ref is `ref` (a generic instance
    // such as `Optional[Array[I64]]`, using its finalized instance layout).
    // Returns true if `ref` was an enum (so the caller knows it was handled).
    inout fn emitEnumReleaseRef(c: inout Comp, v: LLVMValueRef, ref: U64) -> Result[Bool, CompileDiagnostic] {
        if ref == 0U64 {
            return <Result.Ok value=false />
        }
        val reg = (try self.requireEnumLayoutSlot(c: inout c, typeRef: ref))
        if (try self.enumNeedsDeinit(c: inout c, typeRef: self.genEnumRefs[reg])) {
            val slot = self.enumReleaseWitness(c: inout c, reg: reg)
            val arguments: Array[LLVMValueRef] = [v]
            (try self.callValueFunction(signature: self.enumRelWitTy[slot], function: self.enumRelWitVal[slot], arguments: arguments))
        }
        return <Result.Ok value=true />
    }

    inout fn enumNeedsDeinit(c: inout Comp, typeRef: U64) -> Result[Bool, CompileDiagnostic] {
        val identity = c.finalDestructionIndex(typeRef: typeRef)
        if identity == 0U64 {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum ownership query has no finalized destruction contract") />
        }
        val contract = c.arena.finalDestructions[identity - 1U64]
        if !contract.ready || contract.fieldTypes.count() != contract.fieldBoxed.count() || contract.fieldNeedsRelease.count() != contract.fieldTypes.count() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum ownership query has an incomplete destruction contract") />
        }
        mut val field = 0U64
        while field < contract.fieldTypes.count() {
            if contract.fieldNeedsRelease[field] { return <Result.Ok value=true /> }
            field += 1U64
        }
        return <Result.Ok value=false />
    }

    // Consume the frozen instance contract. LLVM only lays out the payload
    // and expands the selected ownership operation; no declaration field is
    // grounded against the current callable environment here.
    inout fn emitEnumOwnership(c: inout Comp, v: LLVMValueRef, eid: U64, ety: LLVMTypeRef, typeRef: U64, retain: Bool) -> Result[(), CompileDiagnostic] {
        val identity = c.finalDestructionIndex(typeRef: typeRef)
        if identity == 0U64 {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum ownership has no finalized destruction contract") />
        }
        val contract = c.arena.finalDestructions[identity - 1U64]
        if !contract.ready || contract.variantFieldStarts.count() == 0U64 || contract.fieldBoxed.count() != contract.fieldTypes.count() || contract.fieldNeedsRelease.count() != contract.fieldTypes.count() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum ownership has an incomplete destruction contract") />
        }
        val slot = self.entryAlloca(ty: ety)
        llvmStore(self.b, v, slot)
        val tag = llvmLoad(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()), anon())
        val payload = LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon())
        mut val variant = 0U64
        while variant + 1U64 < contract.variantFieldStarts.count() {
            val start = contract.variantFieldStarts[variant]
            val end = contract.variantFieldStarts[variant + 1U64]
            if start > end || end > contract.fieldTypes.count() {
                return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: enum ownership has an invalid variant range") />
            }
            mut val hasOwnership = false
            mut val field = start
            while field < end {
                if contract.fieldNeedsRelease[field] { hasOwnership = true }
                field += 1U64
            }
            if hasOwnership {
                val selected = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, variant, 0I32), anon())
                val active = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumarc.active"))
                val done = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumarc.done"))
                LLVMBuildCondBr(self.b, selected, active, done)
                LLVMPositionBuilderAtEnd(self.b, active)
                mut val types: Array[LLVMTypeRef] = []
                field = start
                while field < end {
                    if contract.fieldBoxed[field] { types.append(self.ptrty) }
                    else { types.append((try self.llvmTypeOfRef(c: inout c, ref: contract.fieldTypes[field]))) }
                    field += 1U64
                }
                val payloadType = LLVMStructTypeInContext(self.ctx, arrayCPtr(types), types.count(), 0I32)
                val value = llvmLoad(self.b, payloadType, payload, anon())
                field = start
                while field < end {
                    val type = contract.fieldTypes[field]
                    if contract.fieldBoxed[field] {
                        val cell = LLVMBuildExtractValue(self.b, value, field - start, anon())
                        if retain { try self.rawbufRetain(c: inout c, cell: cell) }
                        else { try self.emitCellRelease(c: inout c, cell: cell, ref: type) }
                    } else if contract.fieldNeedsRelease[field] {
                        try self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, value, field - start, anon()), typeRef: type, retain: retain)
                    }
                    field += 1U64
                }
                LLVMBuildBr(self.b, done)
                LLVMPositionBuilderAtEnd(self.b, done)
            }
            variant += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn emitEnumRelease(c: inout Comp, v: LLVMValueRef, eid: U64, ety: LLVMTypeRef, typeRef: U64) -> Result[(), CompileDiagnostic] {
        try self.emitEnumOwnership(c: inout c, v: v, eid: eid, ety: ety, typeRef: typeRef, retain: false)
        return <Result.Ok value=() />
    }

    inout fn emitEnumRetain(c: inout Comp, v: LLVMValueRef, eid: U64, ety: LLVMTypeRef, typeRef: U64) -> Result[(), CompileDiagnostic] {
        try self.emitEnumOwnership(c: inout c, v: v, eid: eid, ety: ety, typeRef: typeRef, retain: true)
        return <Result.Ok value=() />
    }

    // ---- per-enum value-ARC witnesses (registered/concrete enums only) ----
    // Each mirrors the struct witnesses: a single per-enum function out-of-lines the
    // tag-dispatch walker so every value-ARC site emits a call. Concrete enum fields are
    // env-independent (declared array-ness + concrete element/struct refs), so the body is
    // byte-for-byte the inline walker, just moved into a function. Declared on demand at a
    // site, bodies drained after the main pass by a growing cursor.

    // The release-witness table is keyed by the genEnum* INSTANCE slot (not the enum id):
    // a generic instance (`Optional[Node[I64]]`) gets its own witness whose body is
    // emitted from its frozen payload contract, so every enum release — concrete or generic
    // instance — is a function CALL. That makes runtime recursion expressible: a boxed
    // (recursive) payload's cell release destroys its pointee by calling the same
    // witness, which an inline-only walker could never encode.
    inout fn enumRelWitSlot(reg: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.enumRelWitReg.count() {
            if self.enumRelWitReg[i] == reg {
                return i
            }
            i += 1
        }
        return self.enumRelWitReg.count()
    }
    inout fn enumReleaseWitness(c: inout Comp, reg: U64) -> U64 {
        val found: U64 = self.enumRelWitSlot(reg: reg)
        if found < self.enumRelWitReg.count() {
            return found
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.genEnumTys[reg])
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwenumrel".bytes())
        appendU64Dec(into: inout nm, n: reg)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        self.enumRelWitReg.append(reg)
        self.enumRelWitVal.append(fv)
        self.enumRelWitTy.append(fty)
        return self.enumRelWitReg.count() - 1U64
    }
    inout fn emitEnumReleaseWitnessBodies(c: inout Comp) -> Result[(), CompileDiagnostic] {
        while self.enumRelWitDone < self.enumRelWitReg.count() {
            val s: U64 = self.enumRelWitDone
            val reg: U64 = self.enumRelWitReg[s]
            val fv: LLVMValueRef = self.enumRelWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            try self.emitEnumRelease(c: inout c, v: (try self.valueParameter(function: fv, index: 0U64)), eid: self.genEnumDefs[reg], ety: self.genEnumTys[reg], typeRef: self.genEnumRefs[reg])
            LLVMBuildRetVoid(self.b)
            self.enumRelWitDone += 1
        }
        return <Result.Ok value=() />
    }

    inout fn enumRetWitSlot(reg: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.enumRetWitReg.count() {
            if self.enumRetWitReg[i] == reg {
                return i
            }
            i += 1
        }
        return self.enumRetWitReg.count()
    }
    inout fn enumRetainWitness(c: inout Comp, reg: U64) -> U64 {
        val found: U64 = self.enumRetWitSlot(reg: reg)
        if found < self.enumRetWitReg.count() {
            return found
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.genEnumTys[reg])
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwenumret".bytes())
        appendU64Dec(into: inout nm, n: reg)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        self.enumRetWitReg.append(reg)
        self.enumRetWitVal.append(fv)
        self.enumRetWitTy.append(fty)
        return self.enumRetWitReg.count() - 1U64
    }
    inout fn emitEnumRetainWitnessBodies(c: inout Comp) -> Result[(), CompileDiagnostic] {
        while self.enumRetWitDone < self.enumRetWitReg.count() {
            val s: U64 = self.enumRetWitDone
            val reg = self.enumRetWitReg[s]
            val fv: LLVMValueRef = self.enumRetWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            try self.emitEnumRetain(c: inout c, v: (try self.valueParameter(function: fv, index: 0U64)), eid: self.genEnumDefs[reg], ety: self.genEnumTys[reg], typeRef: self.genEnumRefs[reg])
            LLVMBuildRetVoid(self.b)
            self.enumRetWitDone += 1
        }
        return <Result.Ok value=() />
    }

    // Retain the heap of enum value `v` of type `ref` if it owns any (genericinstance or
    // concrete enum needing deinit); else a nop. The retain counterpart of
    // emitEnumReleaseRef.
    inout fn emitEnumRetainRef(c: inout Comp, v: LLVMValueRef, ref: U64) -> Result[Bool, CompileDiagnostic] {
        if ref == 0U64 {
            return <Result.Ok value=false />
        }
        val reg = (try self.requireEnumLayoutSlot(c: inout c, typeRef: ref))
        if (try self.enumNeedsDeinit(c: inout c, typeRef: self.genEnumRefs[reg])) {
            val slot = self.enumRetainWitness(c: inout c, reg: reg)
            val arguments: Array[LLVMValueRef] = [v]
            (try self.callValueFunction(signature: self.enumRetWitTy[slot], function: self.enumRetWitVal[slot], arguments: arguments))
        }
        return <Result.Ok value=true />
    }

}

pub impl LlvmCtx {

    // Build an enum value of LLVM type `ety` for def `eid`, variant `vi`, from
    // already-computed LLVM payload values (vs. buildEnumValue which evaluates expr
    // ids). Used by the `?.` / `try` desugar where the payload is an extracted SSA
    // value. The payload value types must match the variant's payload struct.
    inout fn buildEnumFromValues(c: inout Comp, instanceRef: U64, ety: LLVMTypeRef, vi: U64, payloadVals: Array[LLVMValueRef]) -> Result[LLVMValueRef, CompileDiagnostic] {
        val slot: LLVMValueRef = self.entryAlloca(ty: ety)
        llvmStore(self.b, LLVMConstNull(ety), slot)
        llvmStore(self.b, LLVMConstInt(self.i64ty, vi, 0I32), LLVMBuildStructGEP2(self.b, ety, slot, 0U64, anon()))
        if payloadVals.count() > 0U64 {
            val payloadTy: LLVMTypeRef = (try self.variantPayloadTy(c: inout c, instanceRef: instanceRef, vi: vi))
            mut val agg: LLVMValueRef = LLVMGetUndef(payloadTy)
            mut val j: U64 = 0
            while j < payloadVals.count() {
                agg = LLVMBuildInsertValue(self.b, agg, payloadVals[j], j, anon())
                j += 1
            }
            llvmStore(self.b, agg, LLVMBuildStructGEP2(self.b, ety, slot, 1U64, anon()))
        }
        return <Result.Ok value=llvmLoad(self.b, ety, slot, anon()) />
    }
}
