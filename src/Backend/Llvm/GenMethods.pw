// Part of the LLVM backend (root: _.pw): generic method monomorphization per receiver instantiation.

// ---- generic methods (monomorphized per receiver instantiation) ----
//
// A method on a generic struct/enum receiver (`box.get()`, `maybe.unwrapOr(...)`)
// has no method-own type params (those go through the FnInst path); it is emitted
// once per receiver instance, like the C backend's emitMonoMethods. Keyed by
// (method func idx, receiver instance ref). Restricted to entry-module,
// non-provided methods (std combinators / provided Iterator methods are deferred).

// The st.genMeth* slot for (mfi, instRef), or st.genMethK.count() if not registered.

pub impl LlvmCtx {
    inout fn pushGenMethOwn(args: Array[U64]) -> LlvmTypeArgRange {
        val start: U64 = self.genMethOwnArgs.count()
        mut val i: U64 = 0U64
        while i < args.count() {
            self.genMethOwnArgs.append(args[i])
            i += 1U64
        }
        return <LlvmTypeArgRange start=start len=args.count() />
    }

    fn genMethOwnArgAt(range: LlvmTypeArgRange, index: U64) -> U64 {
        return self.genMethOwnArgs[range.start + index]
    }

    inout fn copyGenMethOwn(slot: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        if slot >= self.genMethOwn.count() { return out }
        val range: LlvmTypeArgRange = self.genMethOwn[slot]
        mut val i: U64 = 0U64
        while i < range.len {
            out.append(self.genMethOwnArgAt(range: range, index: i))
            i += 1U64
        }
        return out
    }

    // Trace helpers deliberately print a bounded semantic key rather than LLVM pointer
    // values. A malformed growing type term must remain inspectable without the trace
    // printer itself recursing until the host stack overflows.
    inout fn traceCodegenU64(n: U64) {
        if n >= 10U64 {
            self.traceCodegenU64(n: n / 10U64)
        }
        eprint(text: digitStrU(d: n % 10U64))
    }

    inout fn traceCodegenName(c: inout Comp, start: U64, len: U64) {
        mut val bytes: Array[U8] = []
        mut val i: U64 = 0U64
        while i < len {
            bytes.append(c.arena.bytes[start + i])
            i += 1U64
        }
        eprint(text: stringFromBytesUnchecked(bytes))
    }

    inout fn traceCodegenType(c: inout Comp, ref: U64, depth: U64) {
        if ref == 0U64 || ref >= c.arena.typeCount() {
            eprint(text: "?")
            return
        }
        if depth >= 8U64 {
            eprint(text: "...")
            return
        }
        val t: TypeRef = c.arena.typeAt(index: ref)
        self.traceCodegenName(c: inout c, start: t.nameStart, len: t.nameLen)
        if t.args.count() > 0U64 {
            eprint(text: "[")
            mut val i: U64 = 0U64
            while i < t.args.count() {
                if i > 0U64 { eprint(text: ",") }
                self.traceCodegenType(c: inout c, ref: t.args[i], depth: depth + 1U64)
                i += 1U64
            }
            eprint(text: "]")
        }
        if t.assocNameId != 0U64 {
            eprint(text: ".")
            self.traceCodegenName(c: inout c, start: t.assocNameStart, len: t.assocNameLen)
        }
    }

    // Keep the generic-method trace scalar. Its semantic key includes the
    // finalized body and method-owned argument count, without copying an
    // argument range merely to print it.
    inout fn traceGenMethod(c: inout Comp, event: String, mfi: U64, instRef: U64, bodyId: U64 = 0U64, ownCount: U64 = 0U64) {
        if !(c.traceCodegen) { return }
        if mfi >= c.arena.functionCount() { return }
        val f: Func = c.arena.functionAt(index: mfi)
        eprint(text: "[trace-codegen] ")
        eprint(text: event)
        eprint(text: " index=")
        self.traceCodegenU64(n: mfi)
        eprint(text: " method=")
        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
        eprint(text: " offset=")
        self.traceCodegenU64(n: f.defOffset)
        eprint(text: " receiver=")
        self.traceCodegenType(c: inout c, ref: instRef, depth: 0U64)
        eprint(text: " receiverRef=")
        self.traceCodegenU64(n: instRef)
        eprint(text: " body=")
        self.traceCodegenU64(n: bodyId)
        eprint(text: " ownArgs=")
        self.traceCodegenU64(n: ownCount)
        eprint(text: "\n")
    }

    inout fn genMethSlotFor(c: inout Comp, mfi: U64, instRef: U64, ownArgs: Array[U64], bodyId: U64 = 0U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genMethK.count() {
            if self.genMethK[i] == mfi {
                if c.typeRefEq(a: self.genMethInst[i], b: instRef) {
                    // a method-own-param terminal (`fold[B]`) is keyed by its own args too,
                    // so the same receiver instance folding into different accumulators maps
                    // to distinct slots.
                    if self.genMethBody[i] == bodyId && typeArgsEq(c: inout c, a: self.copyGenMethOwn(slot: i), b: ownArgs) {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.genMethK.count()
    }

    // The final BodyInstance carries two adjacent substitution lanes.  Its
    // first `f.typeParams.count()` entries are the call's complete method
    // substitution (receiver binders followed by method-owned binders); the
    // remaining entries are the receiver's structural arguments, appended by
    // `bodyInstanceEnvironment` to bind `Self`/associated names in the body.
    // LLVM already gets the latter through `receiverRef`, so it needs only the
    // method-owned slice of the former.  Treating the trailing receiver lane
    // as own arguments would turn `Array[U8].append` into a fabricated
    // `append[U8]` specialization.
    inout fn finalBodyMethodOwnArgs(c: inout Comp, f: Func, environment: InstanceEnvironment) -> Array[U64] {
        mut val out: Array[U64] = []
        val recvCount: U64 = c.recvParamCount(nameStart: f.recvStart, nameLen: f.recvLen)
        mut val i: U64 = recvCount
        while i < f.typeParams.count() && i < environment.args.count() {
            out.append(environment.args[i])
            i += 1U64
        }
        return out
    }

    // Declare exactly the method bodies in the frontend-closed executable
    // body graph. `genInsts` is a layout-demand set: using it here used to
    // declare every method on every layout, including bodies that had never
    // received final CallResolution records.  That conflation both retained
    // unused macro parser code and let LLVM lower a body under a fabricated
    // identity.  Layout registration remains driven by `genInsts`; executable
    // method declaration is driven exclusively by BodyInstance.
    inout fn declareGenMethods(c: inout Comp) {
        mut val bodyIndex: U64 = 0U64
        while bodyIndex < c.arena.bodyInstanceCount() {
            tracePhaseProgress(c: inout c, label: "backend:generic-method-declaring", count: bodyIndex, stride: 64U64)
            val bodyId: U64 = bodyIndex + 1U64
            val body: BodyInstance = c.arena.bodyInstanceAt(index: bodyIndex)
            if body.fnIdx < c.arena.functionCount() {
                val f: Func = c.arena.functionAt(index: body.fnIdx)
                // A `provided` body has a trait-proof environment and belongs
                // to the dedicated provided/witness emission path.  It is not
                // an ordinary receiver method merely because its copied AST
                // has `self`; putting it in this table drops that proof and
                // can create a second, receiver-only declaration for one
                // callable identity.
                if f.hasRecv && !(f.isExtern) && !(f.isProvided) && !(c.methodRecvIsTrait(f: f)) {
                    val receiverRef: U64 = body.environment.receiverRef
                    if receiverRef != 0U64 && receiverRef < c.arena.typeCount() {
                        val ownArgs: Array[U64] = self.finalBodyMethodOwnArgs(c: inout c, f: f, environment: body.environment)
                        if self.genMethSlotFor(c: inout c, mfi: body.fnIdx, instRef: receiverRef, ownArgs: ownArgs, bodyId: bodyId) == self.genMethK.count() {
                            self.declareOneGenMethod(c: inout c, mfi: body.fnIdx, instRef: receiverRef, ownArgs: ownArgs, bodyId: bodyId)
                        }
                    }
                }
            }
            bodyIndex += 1U64
        }
    }

    inout fn declareOneGenMethod(c: inout Comp, mfi: U64, instRef: U64, ownArgs: Array[U64], bodyId: U64 = 0U64) {
        self.traceGenMethod(c: inout c, event: "declare", mfi: mfi, instRef: instRef, bodyId: bodyId, ownCount: ownArgs.count())
        val mf: Func = c.arena.functionAt(index: mfi)
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        c.cur.typeParams = c.copyFuncBinds(binds: mf.typeParams)
        // env = receiver instance args ++ method-own args (the latter empty for ordinary
        // methods); pairs 1:1 with mf.typeParams = [receiver params..., own params...].
        c.cur.typeArgs = concatArgs(add: c.copyTypeTermArgs(ref: instRef), base: ownArgs)
        self.curRecvInstRef = instRef
        // Declaration and body emission must consume the same selected proof.
        // Re-querying `Item` from just the receiver here loses the direct
        // witness / trait-path substitution that Mono used for the final
        // descriptor, allowing `Array[Item]` and `Array[I64]` to become
        // distinct LLVM nominal instances for one callable.
        mut val environment: InstanceEnvironment = c.bodyInstanceEnvironment(fnIdx: mfi, args: c.cur.typeArgs, recvInstRef: instRef)
        if bodyId != 0U64 && bodyId <= c.arena.bodyInstanceCount() { environment = c.arena.bodyInstanceAt(index: bodyId - 1U64).environment }
        val signatureBodyId: U64 = c.findBodyInstance(fnIdx: mfi, environment: environment)
        // bind Self/Item to the receiver instance for a provided method, so a param/return
        // type naming `Item` resolves to the receiver's real item: a terminal returning
        // `Optional[Item]` (`first`/`reduce`) grounds its signature, and an own-param
        // terminal (`fold[B]`) sees the right item independent of the B/B collision.
        val sDs: U64 = c.cur.selfRef
        val sDi: U64 = c.cur.itemRef
        // a non-generic method (B3-2: typeParams empty) needs `Self` bound to its receiver so
        // its signature (`-> Self`, a `Self` param) grounds — matching the body env above.
        if mf.isProvided {
            c.setSelfItemEnvForBody(f: mf, environment: environment)
        } else if mf.typeParams.count() == 0U64 {
            c.setSelfItemEnv(recvStart: c.arena.typeAt(index: instRef).nameStart, recvLen: c.arena.typeAt(index: instRef).nameLen, recvInstRef: instRef)
        }
        mut val ptys: Array[LLVMTypeRef] = []
        if mf.selfInout {
            ptys.append(self.ptrty)
        } else {
            ptys.append(self.llvmTypeOfRef(c: inout c, ref: instRef))
        }
        mut val pi: U64 = 0
        while pi < mf.params.count() {
            ptys.append(self.bodyParameterLlvmTy(c: inout c, bodyId: signatureBodyId, index: pi, p: c.funcParamAt(params: mf.params, index: pi)))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.bodyReturnLlvmTy(c: inout c, bodyId: signatureBodyId, f: mf), arrayCPtr(ptys), ptys.count(), 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "gm".bytes())
        appendU64Dec(into: inout nm, n: mfi)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: instRef)
        // `bodyId` is Mono's complete specialization identity.  The same
        // receiver and method can be selected under distinct method-owned
        // arguments or proof environments, which must not alias in LLVM.
        appendBytes(into: inout nm, from: "_b".bytes())
        appendU64Dec(into: inout nm, n: bodyId)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.genMethK.append(mfi)
        self.genMethInst.append(instRef)
        self.genMethVal.append(fv)
        self.genMethTy.append(fty)
        self.genMethBody.append(bodyId)
        self.genMethOwn.append(self.pushGenMethOwn(args: ownArgs))
        self.traceGenMethod(c: inout c, event: "registered", mfi: mfi, instRef: instRef, bodyId: bodyId, ownCount: ownArgs.count())
        c.cur.selfRef = sDs
        c.cur.itemRef = sDi
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
    }

    // Emit one generic-method instance body (slot index into genMeth*) under its
    // receiver's substitution env.
    inout fn emitOneGenMethod(c: inout Comp, slot: U64) {
        val mfi: U64 = self.genMethK[slot]
        val instRef: U64 = self.genMethInst[slot]
        self.traceGenMethod(c: inout c, event: "emit", mfi: mfi, instRef: instRef, bodyId: self.genMethBody[slot], ownCount: self.genMethOwn[slot].len)
        val mf: Func = c.arena.functionAt(index: mfi)
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        c.cur.typeParams = c.copyFuncBinds(binds: mf.typeParams)
        c.cur.typeArgs = concatArgs(add: c.copyTypeTermArgs(ref: instRef), base: self.copyGenMethOwn(slot: slot))
        self.curRecvInstRef = instRef
        mut val environment: InstanceEnvironment = c.bodyInstanceEnvironment(fnIdx: mfi, args: c.cur.typeArgs, recvInstRef: instRef)
        val bodyId: U64 = self.genMethBody[slot]
        if bodyId != 0U64 && bodyId <= c.arena.bodyInstanceCount() { environment = c.arena.bodyInstanceAt(index: bodyId - 1U64).environment }
        // a provided method with method-own type params (`fold[B]` on a generic receiver):
        // its body refers to the element by the associated `Item`, while the env carries
        // two same-named params (the receiver's `B` = item, the method-own `B` = accumulator)
        // that last-match resolution collapses to the accumulator. Bind `Self`/`Item` to the
        // receiver instance so the element type resolves to the real item, independent of the
        // name collision (only when own args are present, leaving ordinary methods untouched).
        val s4: U64 = c.cur.selfRef
        val si4: U64 = c.cur.itemRef
        // a non-generic method (B3-2: typeParams empty ⟺ a 0-type-arg receiver) needs `Self`
        // bound to its receiver too — a `-> Self` / `Self`-param inherent method resolves `Self`
        // to the receiver type, which the old pf path set via genLlvmFuncBody's didSelf.
        if mf.isProvided {
            c.setSelfItemEnvForBody(f: mf, environment: environment)
        } else if mf.typeParams.count() == 0U64 {
            c.setSelfItemEnv(recvStart: c.arena.typeAt(index: instRef).nameStart, recvLen: c.arena.typeAt(index: instRef).nameLen, recvInstRef: instRef)
        }
        self.genLlvmFuncBody(c: inout c, fi: mfi, fv: self.genMethVal[slot], environment: environment)
        c.cur.selfRef = s4
        c.cur.itemRef = si4
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
    }

    // Emit each eagerly-declared generic-method instance body under its receiver's env.
    inout fn emitGenMethods(c: inout Comp) {
        mut val slot: U64 = 0
        while slot < self.genMethK.count() {
            tracePhaseProgress(c: inout c, label: "backend:generic-method-emitting", count: slot, stride: 16U64)
            self.emitOneGenMethod(c: inout c, slot: slot)
            slot += 1
        }
    }

    // Declare a generic-method instance on demand — a std / non-entry-module generic
    // method (Optional.unwrapOr, MapIter.next) reached by a call — and queue its body
    // for the post-pass drain. Returns the genMeth* slot, or genMethK.count() if it
    // can't be declared (the method has its own type params beyond the receiver
    // instance's — provided map[B]/filter is handled separately). Idempotent.
    inout fn ensureGenMethodDeclared(c: inout Comp, mfi: U64, instRef: U64, ownArgs: Array[U64], bodyId: U64 = 0U64) -> U64 {
        self.traceGenMethod(c: inout c, event: "request", mfi: mfi, instRef: instRef, bodyId: bodyId, ownCount: ownArgs.count())
        val existing: U64 = self.genMethSlotFor(c: inout c, mfi: mfi, instRef: instRef, ownArgs: ownArgs, bodyId: bodyId)
        if existing < self.genMethK.count() {
            self.traceGenMethod(c: inout c, event: "reuse", mfi: mfi, instRef: instRef, bodyId: bodyId, ownCount: ownArgs.count())
            return existing
        }
        // the method's type params must pair 1:1 with the instance's args plus the
        // method-own args inferred at the call (`fold[B]`: receiver [I,F,B] + own [B]).
        // A still-mismatched count means own params we couldn't infer — leave undeclared.
        val mf: Func = c.arena.functionAt(index: mfi)
        // A concrete impl on a generic receiver (`impl Box[I64]`) has no
        // binders of its own, yet its self ABI is still the concrete Box[I64]
        // instance. It belongs in the same receiver-instance table; only a
        // non-empty binder list must account for the receiver and own args.
        if mf.typeParams.count() != 0U64 && mf.typeParams.count() != c.arena.typeAt(index: instRef).args.count() + ownArgs.count() {
            return self.genMethK.count()
        }
        self.declareOneGenMethod(c: inout c, mfi: mfi, instRef: instRef, ownArgs: ownArgs, bodyId: bodyId)
        val slot: U64 = self.genMethK.count() - 1U64
        self.genMethEmit.append(slot)
        self.traceGenMethod(c: inout c, event: "enqueue", mfi: mfi, instRef: instRef, bodyId: bodyId, ownCount: ownArgs.count())
        return slot
    }

    // A source receiver call has already been finalized by Mono. Its
    // BodyInstance is the complete semantic key: selected implementation,
    // receiver, proof environment, and method-owned argument suffix. Never
    // recreate that key from an AST call site in the LLVM backend.
    inout fn ensureFinalGenMethodBody(c: inout Comp, bodyId: U64) -> U64 {
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() {
            return self.genMethK.count()
        }
        val body: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        val instRef: U64 = body.environment.receiverRef
        if body.fnIdx >= c.arena.functionCount() || instRef == 0U64 || instRef >= c.arena.typeCount() {
            return self.genMethK.count()
        }
        val f: Func = c.arena.functionAt(index: body.fnIdx)
        val ownArgs: Array[U64] = self.finalBodyMethodOwnArgs(c: inout c, f: f, environment: body.environment)
        return self.ensureGenMethodDeclared(c: inout c, mfi: body.fnIdx, instRef: instRef, ownArgs: ownArgs, bodyId: bodyId)
    }
}

pub impl LlvmCtx {

    // Bind one function/closure parameter (the LLVM arg at `argIdx`) as a local: an
    // array param is the {ptr,i64} value; a generic-instance / Ref / enum param tracks
    // its instance/enum ref; an `inout` param binds the caller pointer directly, else
    // the value is stored into a fresh alloca.
    // Storage consumes a concrete signature type. Source spans and ambient
    // generic bindings cannot replace this ABI decision.
    inout fn bindOneParam(c: inout Comp, p: Param, fv: LLVMValueRef, argIdx: U64, typeRef: U64) {
        val term = c.arena.typeAt(index: typeRef)
        val pty = self.llvmTypeOfRef(c: inout c, ref: typeRef)
        val kind = kindFromTySpan(c: inout c, tyStart: term.nameStart, tyLen: term.nameLen)
        val structIndex = self.structIdxOfRef(c: inout c, ref: typeRef)
        val isArray = rangeEquals(bytes: c.arena.bytes, start: term.nameStart, len: term.nameLen, kw: "Array") && term.args.count() == 1U64
        mut val elementType: LLVMTypeRef = self.i64ty
        mut val elementKind: U64 = kind
        if isArray {
            elementType = self.llvmTypeOfRef(c: inout c, ref: term.args[0])
            val element = c.arena.typeAt(index: term.args[0])
            elementKind = kindFromTySpan(c: inout c, tyStart: element.nameStart, tyLen: element.nameLen)
        }
        mut val slot: LLVMValueRef = LLVMGetParam(fv, argIdx)
        if !p.isInout {
            slot = self.entryAlloca(ty: pty)
            LLVMBuildStore(self.b, LLVMGetParam(fv, argIdx), slot)
        }
        self.pushLocalR(nameStart: p.nameStart, nameLen: p.nameLen, ptr: slot, ty: pty, kind: kind, structIdx: structIndex, isArr: isArray, elemTy: elementType, elemKind: elementKind, typeRef: typeRef)
        if isArray { self.setLocalElemTypeRef(ref: term.args[0]) }
    }
}
