// Part of the LLVM backend (root: _.pw): generic method monomorphization per receiver instantiation.

// ---- generic methods (monomorphized per receiver instantiation) ----
//
// A method on a generic struct/enum receiver (`box.get()`, `maybe.unwrapOr(...)`)
// has no method-own type params (those go through the FnInst path); it is emitted
// once per receiver instance, like the C backend's emitMonoMethods. Keyed by
// (method func idx, receiver instance ref). Restricted to entry-module,
// non-provided methods (std combinators / provided Iterator methods are deferred).

// The st.genMeth* slot for (mfi, instRef), or st.genMethK.count() if not registered.

pub impl LlvmCtx {
    inout fn genMethSlotFor(c: inout Comp, mfi: U64, instRef: U64, ownArgs: Array[U64]) -> U64 {
        mut val i: U64 = 0
        while i < self.genMethK.count() {
            if self.genMethK[i] == mfi {
                if c.typeRefEq(a: self.genMethInst[i], b: instRef) {
                    // a method-own-param terminal (`fold[B]`) is keyed by its own args too,
                    // so the same receiver instance folding into different accumulators maps
                    // to distinct slots.
                    if typeArgsEq(c: inout c, a: self.genMethOwn[i], b: ownArgs) {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.genMethK.count()
    }

    // Declare an LLVM function for each (generic instance, matching method): self + the
    // method's params, return type — all under the receiver's substitution env.
    inout fn declareGenMethods(c: inout Comp) {
        mut val gi: U64 = 0
        while gi < c.monoWork.genInsts.count() {
            val instRef: U64 = c.monoWork.genInsts[gi]
            val gt: TypeRef = c.arena.types[instRef]
            // Array instances keep their methods on the array-special path; skip here.
            if !(rangeEquals(bytes: c.arena.bytes, start: gt.nameStart, len: gt.nameLen, kw: "Array")) {
                mut val mfi: U64 = 0
                while mfi < c.arena.funcs.count() {
                    val mf: Func = c.arena.funcs[mfi]
                    if c.methodMatchesInst(f: mf, instRef: instRef) {
                        if !(mf.isProvided) {
                            if c.methodInEntryModule(f: mf) {
                                if self.genMethSlotFor(c: inout c, mfi: mfi, instRef: instRef, ownArgs: []) == self.genMethK.count() {
                                    self.declareOneGenMethod(c: inout c, mfi: mfi, instRef: instRef, ownArgs: [])
                                }
                            }
                        }
                    }
                    mfi += 1
                }
            }
            gi += 1
        }
    }

    inout fn declareOneGenMethod(c: inout Comp, mfi: U64, instRef: U64, ownArgs: Array[U64]) {
        val mf: Func = c.arena.funcs[mfi]
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        c.cur.typeParams = mf.typeParams
        // env = receiver instance args ++ method-own args (the latter empty for ordinary
        // methods); pairs 1:1 with mf.typeParams = [receiver params..., own params...].
        c.cur.typeArgs = concatArgs(add: c.arena.types[instRef].args, base: ownArgs)
        self.curRecvInstRef = instRef
        // bind Self/Item to the receiver instance for a provided method, so a param/return
        // type naming `Item` resolves to the receiver's real item: a terminal returning
        // `Optional[Item]` (`first`/`reduce`) grounds its signature, and an own-param
        // terminal (`fold[B]`) sees the right item independent of the B/B collision.
        val sDs: U64 = c.cur.selfRef
        val sDi: U64 = c.cur.itemRef
        // a non-generic method (B3-2: typeParams empty) needs `Self` bound to its receiver so
        // its signature (`-> Self`, a `Self` param) grounds — matching the body env above.
        if mf.isProvided || mf.typeParams.count() == 0U64 {
            c.setSelfItemEnv(recvStart: c.arena.types[instRef].nameStart, recvLen: c.arena.types[instRef].nameLen, recvInstRef: instRef)
        }
        mut val ptys: Array[LLVMTypeRef] = []
        if mf.selfInout {
            ptys.append(self.ptrty)
        } else {
            ptys.append(self.llvmTypeOfRef(c: inout c, ref: instRef))
        }
        mut val pi: U64 = 0
        while pi < mf.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: mf.params[pi]))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: mf), arrayCPtr(ptys), ptys.count(), 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "gm".bytes())
        appendU64Dec(into: inout nm, n: mfi)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: instRef)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.genMethK.append(mfi)
        self.genMethInst.append(instRef)
        self.genMethVal.append(fv)
        self.genMethTy.append(fty)
        self.genMethOwn.append(ownArgs)
        c.cur.selfRef = sDs
        c.cur.itemRef = sDi
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
    }

    // Emit one generic-method instance body (slot index into genMeth*) under its
    // receiver's substitution env.
    inout fn emitOneGenMethod(c: inout Comp, slot: U64) {
        val mfi: U64 = self.genMethK[slot]
        val instRef: U64 = self.genMethInst[slot]
        val mf: Func = c.arena.funcs[mfi]
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        c.cur.typeParams = mf.typeParams
        c.cur.typeArgs = concatArgs(add: c.arena.types[instRef].args, base: self.genMethOwn[slot])
        self.curRecvInstRef = instRef
        // a provided method with method-own type params (`fold[B]` on a generic receiver):
        // its body refers to the element by the associated `Item`, while the env carries
        // two same-named params (the receiver's `B` = item, the method-own `B` = accumulator)
        // that last-match resolution collapses to the accumulator. Bind `Self`/`Item` to the
        // receiver instance so the element type resolves to the real item, independent of the
        // name collision (only when own args are present, leaving ordinary methods untouched).
        val s4: U64 = c.cur.selfRef
        val si4: U64 = c.cur.itemRef
        // a non-generic method (B3-2: typeParams empty ⟺ a 0-type-arg receiver) needs `Self`
        // bound to its receiver too — a `-> Self` / `Self`-param inherent method resolves `Self`
        // to the receiver type, which the old pf path set via genLlvmFuncBody's didSelf.
        if mf.isProvided || mf.typeParams.count() == 0U64 {
            c.setSelfItemEnv(recvStart: c.arena.types[instRef].nameStart, recvLen: c.arena.types[instRef].nameLen, recvInstRef: instRef)
        }
        self.genLlvmFuncBody(c: inout c, fi: mfi, fv: self.genMethVal[slot])
        c.cur.selfRef = s4
        c.cur.itemRef = si4
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
    }

    // Emit each eagerly-declared generic-method instance body under its receiver's env.
    inout fn emitGenMethods(c: inout Comp) {
        mut val slot: U64 = 0
        while slot < self.genMethK.count() {
            self.emitOneGenMethod(c: inout c, slot: slot)
            slot += 1
        }
    }

    // Declare a generic-method instance on demand — a std / non-entry-module generic
    // method (Optional.unwrapOr, MapIter.next) reached by a call — and queue its body
    // for the post-pass drain. Returns the genMeth* slot, or genMethK.count() if it
    // can't be declared (the method has its own type params beyond the receiver
    // instance's — provided map[B]/filter is handled separately). Idempotent.
    inout fn ensureGenMethodDeclared(c: inout Comp, mfi: U64, instRef: U64, ownArgs: Array[U64]) -> U64 {
        val existing: U64 = self.genMethSlotFor(c: inout c, mfi: mfi, instRef: instRef, ownArgs: ownArgs)
        if existing < self.genMethK.count() {
            return existing
        }
        // the method's type params must pair 1:1 with the instance's args plus the
        // method-own args inferred at the call (`fold[B]`: receiver [I,F,B] + own [B]).
        // A still-mismatched count means own params we couldn't infer — leave undeclared.
        val mf: Func = c.arena.funcs[mfi]
        if mf.typeParams.count() != c.arena.types[instRef].args.count() + ownArgs.count() {
            return self.genMethK.count()
        }
        self.declareOneGenMethod(c: inout c, mfi: mfi, instRef: instRef, ownArgs: ownArgs)
        val slot: U64 = self.genMethK.count() - 1U64
        self.genMethEmit.append(slot)
        return slot
    }
}

pub impl LlvmCtx {

    // Bind one function/closure parameter (the LLVM arg at `argIdx`) as a local: an
    // array param is the {ptr,i64} value; a generic-instance / Ref / enum param tracks
    // its instance/enum ref; an `inout` param binds the caller pointer directly, else
    // the value is stored into a fresh alloca.
    inout fn bindOneParam(c: inout Comp, p: Param, fv: LLVMValueRef, argIdx: U64) {
        // a `Self`-typed param (`fn eqTo(other: Self)` inside `impl P as MyEq`): ground
        // the head-name span through the active env (curSelfRef resolves `Self` -> the
        // receiver type) so the struct/enum-index + scalar-type lookups see `P`, not the
        // literal `Self` (which is not a registered type — field access would then fail).
        // The `p.ty`-based predicates below stay on the raw ref (groundTypeRef does not
        // preserve isAny/viewExtId, and Self carries neither, so this is span-only).
        mut val pgStart: U64 = p.tyStart
        mut val pgLen: U64 = p.tyLen
        // The effective param type — `Self` resolved to the receiver. A `Self` param stands
        // for the receiver type, so the representation branches below must bind it EXACTLY as
        // that type: not just the name span (pgStart/pgLen) but the array flag and the full
        // ref too. Without this a `Self` on `impl[T] Array[T] as Eq` (Self = Array[T]) fell
        // through the scalar path and its `.data` field access failed. A `Self` grounding to
        // a plain struct/enum already flows through pgStart/pgLen; only the array case needs
        // the flag flip (its repr is the buffer floor, not a scalar). effRef/effIsArray equal
        // the raw p.ty/p.tyIsArray for a non-`Self` param, so existing bindings are unchanged.
        mut val effRef: U64 = p.ty
        mut val effIsArray: Bool = p.tyIsArray
        if p.ty != 0U64 {
            if rangeEquals(bytes: c.arena.bytes, start: p.tyStart, len: p.tyLen, kw: "Self") {
                effRef = c.groundTypeRef(ref: p.ty)
                pgStart = c.arena.types[effRef].nameStart
                pgLen = c.arena.types[effRef].nameLen
                if rangeEquals(bytes: c.arena.bytes, start: pgStart, len: pgLen, kw: "Array") {
                    effIsArray = true
                }
            }
        }
        mut val pty: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: pgStart, tyLen: pgLen)
        mut val pElem: LLVMTypeRef = self.i64ty
        mut val pSidx: U64 = self.localStructIdxFor(c: inout c, start: pgStart, len: pgLen)
        mut val pRef: U64 = 0
        // a `Type#Ext`-viewed param (a plain struct otherwise): track its viewed
        // TypeRef so a bare `x.m()` in the body resolves the extension (spec/09).
        if p.ty != 0U64 {
            if c.arena.types[p.ty].viewExtId != 0U64 {
                pRef = p.ty
            }
        }
        // a generic type-parameter param whose substituted argument carries a view
        // (`T -> S#P`, from a `#`-viewed call argument `f(a: s#P)` / `g(x#Ext)`): track
        // the grounded viewed ref so a bare `x.m()` in the body resolves via the view
        // (spec/09 view-aware monomorphization). resolveTy returns the env's arg ref
        // verbatim, so its viewExtId survives grounding.
        if pRef == 0U64 {
            if p.ty != 0U64 {
                if c.cur.typeParams.count() > 0U64 {
                    val pgv: U64 = c.groundTypeRef(ref: p.ty)
                    if pgv != p.ty {
                        if pgv < c.arena.types.count() {
                            if c.arena.types[pgv].viewExtId != 0U64 {
                                pRef = pgv
                            }
                        }
                    }
                }
            }
        }
        // an existential `any P` param (spec/08): its LLVM type is the fat pointer and
        // its TypeRef is tracked so a bare `x.m()` in the body dispatches dynamically.
        if p.ty != 0U64 {
            if refIsAny(c: inout c, ref: p.ty) {
                pty = self.anyTy
                pRef = p.ty
            }
        }
        if effIsArray {
            pElem = pty
            // an `Array[any P]` param: its element is the existential fat pointer.
            if effRef != 0U64 {
                if c.arena.types[effRef].args.count() > 0U64 {
                    if refIsAny(c: inout c, ref: c.arena.types[effRef].args[0]) {
                        pElem = self.anyTy
                    }
                }
            }
            pty = self.arrayTy
            // E3 step (a): track the array param as a generic-struct value `Array[E]` (the
            // ref grounded under the active instantiation env) + Array's arena struct index,
            // so a use resolves through the uniform generic path (drops exprIsArray dispatch).
            if effRef != 0U64 {
                mut val gpr: U64 = effRef
                if c.cur.typeParams.count() > 0U64 {
                    gpr = c.groundTypeRef(ref: effRef)
                }
                pRef = gpr
                // de-pin: the param's LLVM type is the per-instance `%gs` of `Array[E]`.
                pty = self.llvmTypeOfRef(c: inout c, ref: gpr)
            }
            pSidx = c.structDefByNameAny(start: c.kwSpan(kw: "Array", kwLen: 5U64).nameStart, len: 5U64)
        } else {
            if c.isGenericInst(ref: effRef) {
                pty = self.llvmTypeOfRef(c: inout c, ref: effRef)
                pRef = effRef
                val pgs: U64 = self.genStructSlot(c: inout c, ref: effRef)
                if pgs < self.genStructRefs.count() {
                    pSidx = self.genStructDefs[pgs]
                }
            }
            if c.isRefInst(ref: effRef) {
                pty = self.ptrty
                pRef = effRef
            }
            // a function-value param (`f: fn(n: I32) -> I32`): track the fn TypeRef so a
            // call `f(n: x)` resolves the closure signature for the indirect call.
            if c.isFnType(ref: effRef) {
                pRef = effRef
            }
            if pRef == 0U64 {
                // grounded span so a `Self` param on an enum receiver tracks the enum.
                if self.enumRegSlot(c: inout c, start: pgStart, len: pgLen) < self.genEnumRefs.count() {
                    pRef = c.simpleTypeRef(nameStart: pgStart, nameLen: pgLen)
                }
            }
        }
        // a primitive param (an int, or a generic `v: K` with K -> U64 / Bool): track its
        // (grounded) type name so a method on the primitive (`v.hash[H](…)`) dispatches.
        // An enum-grounded generic param (`x: T` with T -> Color) is tracked the same way,
        // so a trait method on it (`x.describe()` in `fn f[T](x:T) where T: Describe`)
        // resolves through the enum-receiver dispatch — the pre-ground enum check above
        // only sees the Self-grounded span, missing a `T`-named param.
        if pRef == 0U64 {
            if !(effIsArray) {
                mut val gs2: U64 = p.tyStart
                mut val gl2: U64 = p.tyLen
                if p.ty != 0U64 {
                    if c.cur.typeParams.count() > 0U64 {
                        val pg2: U64 = c.groundTypeRef(ref: p.ty)
                        gs2 = c.arena.types[pg2].nameStart
                        gl2 = c.arena.types[pg2].nameLen
                    }
                }
                // a grounded scalar type param (`v: T` with T -> I32 / F64 / Bool): pin BOTH
                // its tracked type name (so an operator/method on it dispatches through the
                // instance's witness) AND its alloca LLVM type to the GROUNDED scalar — the
                // ungrounded-`T` default (i64) would put a float's bits in an i64 slot. This
                // matches paramLlvmTy's grounded signature type.
                if isPrimIntName(c: inout c, start: gs2, len: gl2) {
                    pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                    pty = self.llvmScalarTy(c: inout c, tyStart: gs2, tyLen: gl2)
                }
                if c.isFloatType(start: gs2, len: gl2) {
                    pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                    pty = self.llvmScalarTy(c: inout c, tyStart: gs2, tyLen: gl2)
                }
                if rangeEquals(bytes: c.arena.bytes, start: gs2, len: gl2, kw: "Bool") {
                    pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                    pty = self.llvmScalarTy(c: inout c, tyStart: gs2, tyLen: gl2)
                }
                // a grounded newtype over a primitive (`v: T` with T -> `Meter = I64` /
                // `Ratio = F64`): track the NEWTYPE ref (preserving its identity, so its own
                // methods still resolve) but pin the alloca to the UNDERLYING scalar's LLVM
                // type — an inherited lang-item method (`value.format()` in `print[Meter]`)
                // unwraps to the underlying at the dispatch site (spec/10). The direct-prim
                // branches above already handle a non-newtype scalar, so this only fires for a
                // newtype (newtypeUnderName is a no-op otherwise, guarded by pRef == 0).
                if pRef == 0U64 {
                    val ntu2: Bind = c.newtypeUnderName(start: gs2, len: gl2)
                    if isPrimIntName(c: inout c, start: ntu2.nameStart, len: ntu2.nameLen) {
                        pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                        pty = self.llvmScalarTy(c: inout c, tyStart: ntu2.nameStart, tyLen: ntu2.nameLen)
                    }
                    if c.isFloatType(start: ntu2.nameStart, len: ntu2.nameLen) {
                        pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                        pty = self.llvmScalarTy(c: inout c, tyStart: ntu2.nameStart, tyLen: ntu2.nameLen)
                    }
                    if rangeEquals(bytes: c.arena.bytes, start: ntu2.nameStart, len: ntu2.nameLen, kw: "Bool") {
                        pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                        pty = self.llvmScalarTy(c: inout c, tyStart: ntu2.nameStart, tyLen: ntu2.nameLen)
                    }
                }
                if pRef == 0U64 {
                    if self.enumRegSlot(c: inout c, start: gs2, len: gl2) < self.genEnumRefs.count() {
                        pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                    }
                }
                // TOTAL-REF: a bare (non-generic) registered-struct param (`fn f(p: Point)`).
                // Formerly left 0 (recovered via localStructIdxFor at each use), leaving
                // exprTypeRef(p) unpopulated and forcing exprStructIdx onto the classifier. Track
                // the struct's TypeRef so the struct-idx derives from the ref uniformly. gs2/gl2
                // covers a generic-`T` param grounded to a struct; pgStart/pgLen covers a `Self`
                // param (`assoc fn eq(lhs~: Self)` on a struct conformance) grounded to the recv.
                if pRef == 0U64 {
                    if self.localStructIdxFor(c: inout c, start: gs2, len: gl2) < c.arena.structs.count() {
                        pRef = c.simpleTypeRef(nameStart: gs2, nameLen: gl2)
                    }
                }
                if pRef == 0U64 {
                    if self.localStructIdxFor(c: inout c, start: pgStart, len: pgLen) < c.arena.structs.count() {
                        pRef = c.simpleTypeRef(nameStart: pgStart, nameLen: pgLen)
                    }
                }
            }
        }
        // ground a generic param type for its kind (a `key: K` with K -> String must be
        // kind 1 so a String method dispatches; K -> U64 unsigned, etc.). Start from the
        // Self-grounded span so a `Self` param gets the receiver type's kind.
        mut val pKindStart: U64 = pgStart
        mut val pKindLen: U64 = pgLen
        if p.ty != 0U64 {
            if c.cur.typeParams.count() > 0U64 {
                val pg: U64 = c.groundTypeRef(ref: p.ty)
                pKindStart = c.arena.types[pg].nameStart
                pKindLen = c.arena.types[pg].nameLen
            }
        }
        val pKind: U64 = kindFromTySpan(c: inout c, tyStart: pKindStart, tyLen: pKindLen)
        if p.isInout {
            self.pushLocalR(nameStart: p.nameStart, nameLen: p.nameLen, ptr: LLVMGetParam(fv, argIdx), ty: pty, kind: pKind, structIdx: pSidx, isArr: effIsArray, elemTy: pElem, elemKind: pKind, typeRef: pRef)
        } else {
            val slot2: LLVMValueRef = self.entryAlloca(ty: pty)
            LLVMBuildStore(self.b, LLVMGetParam(fv, argIdx), slot2)
            self.pushLocalR(nameStart: p.nameStart, nameLen: p.nameLen, ptr: slot2, ty: pty, kind: pKind, structIdx: pSidx, isArr: effIsArray, elemTy: pElem, elemKind: pKind, typeRef: pRef)
        }
        // an array param: track the element's TypeRef so `param[i]` recovers the
        // element (mirrors the Let handler).
        if effIsArray {
            // element TypeRef (a Ref / nested-array / generic element): Array[E]'s first arg,
            // GROUNDED under the active instantiation env so a generic element `Array[E]` in
            // `impl[E]` records the concrete element (`I64` for `Box[I64].from`), not the bare
            // param `E` — else a `.count()`/index over the param can't synthesize its Array
            // receiver (the element ref must be a concrete type). Mirrors pKind's grounding.
            if effRef != 0U64 {
                mut val gpty: U64 = effRef
                if c.cur.typeParams.count() > 0U64 {
                    gpty = c.groundTypeRef(ref: effRef)
                }
                val at: TypeRef = c.arena.types[gpty]
                if at.args.count() > 0U64 {
                    self.setLocalElemTypeRef(ref: at.args[0])
                }
            }
        }
    }
}
