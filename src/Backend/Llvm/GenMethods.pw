// Physical declarations and emission for frontend-selected method bodies.
// BodyInstance is the sole specialization key, including receiver, method
// arguments and proof provenance. LLVM does not reconstruct its environment.

pub impl LlvmCtx {
    // Trace helpers deliberately print a bounded semantic key rather than LLVM pointer
    // values. A malformed growing type term must remain inspectable without the trace
    // printer itself recursing until the host stack overflows.
    inout fn traceCodegenU64(n: U64) {
        if n >= 10U64 {
            self.traceCodegenU64(n: n / 10U64)
        }
        eprint(text: digitStrU(d: n % 10U64))
    }

    inout fn traceCodegenName(c: inout Comp, start: U64, len: U64) {
        mut val bytes: Array[U8] = []
        mut val i: U64 = 0U64
        while i < len {
            bytes.append(c.arena.bytes[start + i])
            i += 1U64
        }
        eprint(text: stringFromBytesUnchecked(bytes))
    }

    inout fn traceCodegenType(c: inout Comp, ref: U64, depth: U64) {
        if ref == 0U64 || ref >= c.arena.typeCount() {
            eprint(text: "?")
            return
        }
        if depth >= 8U64 {
            eprint(text: "...")
            return
        }
        val t: TypeRef = c.arena.typeAt(index: ref)
        self.traceCodegenName(c: inout c, start: t.nameStart, len: t.nameLen)
        if t.args.count() > 0U64 {
            eprint(text: "[")
            mut val i: U64 = 0U64
            while i < t.args.count() {
                if i > 0U64 { eprint(text: ",") }
                self.traceCodegenType(c: inout c, ref: t.args[i], depth: depth + 1U64)
                i += 1U64
            }
            eprint(text: "]")
        }
        if t.assocNameId != 0U64 {
            eprint(text: ".")
            self.traceCodegenName(c: inout c, start: t.assocNameStart, len: t.assocNameLen)
        }
    }

    // Keep the generic-method trace scalar. Its semantic key includes the
    // finalized body identity; no specialization key is reconstructed.
    inout fn traceGenMethod(c: inout Comp, event: String, mfi: U64, instRef: U64, bodyId: U64 = 0U64) {
        if !(c.traceCodegen) { return }
        if mfi >= c.arena.functionCount() { return }
        val f: Func = c.arena.functionAt(index: mfi)
        eprint(text: "[trace-codegen] ")
        eprint(text: event)
        eprint(text: " index=")
        self.traceCodegenU64(n: mfi)
        eprint(text: " method=")
        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
        eprint(text: " offset=")
        self.traceCodegenU64(n: f.defOffset)
        eprint(text: " receiver=")
        self.traceCodegenType(c: inout c, ref: instRef, depth: 0U64)
        eprint(text: " receiverRef=")
        self.traceCodegenU64(n: instRef)
        eprint(text: " body=")
        self.traceCodegenU64(n: bodyId)
        eprint(text: "\n")
    }

    fn genMethSlotFor(bodyId: U64) -> U64 {
        mut val slot: U64 = 0U64
        while slot < self.genMethBody.count() {
            if self.genMethBody[slot] == bodyId { return slot }
            slot += 1U64
        }
        return self.genMethBody.count()
    }

    // Eager declaration follows the frontend-closed executable body graph.
    inout fn declareGenMethods(c: inout Comp) {
        mut val index: U64 = 0U64
        while index < c.monoWork.bodyInstances.count() {
            tracePhaseProgress(c: inout c, label: "backend:generic-method-declaring", count: index, stride: 64U64)
            val bodyId = c.monoWork.bodyInstances[index]
            val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
            if c.arena.bodyIsCallable(bodyId: bodyId) && body.fnIdx < c.arena.functionCount() {
                val f = c.arena.functionAt(index: body.fnIdx)
                if f.hasRecv && !f.isExtern && !f.isProvided && !c.methodRecvIsTrait(f: f) {
                    if self.genMethSlotFor(bodyId: bodyId) == self.genMethBody.count() {
                        self.declareOneGenMethod(c: inout c, bodyId: bodyId)
                    }
                }
            }
            index += 1U64
        }
    }

    inout fn declareOneGenMethod(c: inout Comp, bodyId: U64) {
        val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        val mfi = body.fnIdx
        val instRef = body.environment.receiverRef
        val mf = c.arena.functionAt(index: mfi)
        self.traceGenMethod(c: inout c, event: "declare", mfi: mfi, instRef: instRef, bodyId: bodyId)
        mut val ptys: Array[LLVMTypeRef] = []
        val signature = c.arena.bodySignature(bodyId: bodyId)
        if !signature.ready || signature.receiverType == 0U64 {
            c.errorAt(offset: mf.nameStart, msg: "internal error: method receiver ABI was not finalized")
            return
        }
        match signature.receiverPassing {
            CallReceiverPassing.Inout => { ptys.append(self.ptrty) }
            CallReceiverPassing.Borrow => { ptys.append(self.llvmTypeOfRef(c: inout c, ref: signature.receiverType)) }
            CallReceiverPassing.Move => { ptys.append(self.llvmTypeOfRef(c: inout c, ref: signature.receiverType)) }
            CallReceiverPassing.None => {
                c.errorAt(offset: mf.nameStart, msg: "internal error: method ABI has no receiver passing")
                return
            }
        }
        val parameterCount = c.arena.bodySignature(bodyId: bodyId).parameterTypes.count()
        mut val pi: U64 = 0
        while pi < parameterCount {
            ptys.append(self.bodyParameterLlvmTy(c: inout c, bodyId: bodyId, index: pi))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.bodyReturnLlvmTy(c: inout c, bodyId: bodyId), arrayCPtr(ptys), ptys.count(), 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "gm".bytes())
        appendU64Dec(into: inout nm, n: mfi)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: instRef)
        // `bodyId` is Mono's complete specialization identity.  The same
        // receiver and method can be selected under distinct method-owned
        // arguments or proof environments, which must not alias in LLVM.
        appendBytes(into: inout nm, from: "_b".bytes())
        appendU64Dec(into: inout nm, n: bodyId)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        self.genMethVal.append(fv)
        self.genMethTy.append(fty)
        self.genMethBody.append(bodyId)
        self.traceGenMethod(c: inout c, event: "registered", mfi: mfi, instRef: instRef, bodyId: bodyId)
    }

    inout fn emitOneGenMethod(c: inout Comp, slot: U64) {
        val bodyId = self.genMethBody[slot]
        val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        self.traceGenMethod(c: inout c, event: "emit", mfi: body.fnIdx, instRef: body.environment.receiverRef, bodyId: bodyId)
        val savedP = c.cur.typeParams
        val savedA = c.cur.typeArgs
        val savedR = self.curRecvInstRef
        val savedSelf = c.cur.selfRef
        val savedItem = c.cur.itemRef
        c.cur.typeParams = body.environment.params
        c.cur.typeArgs = body.environment.args
        self.curRecvInstRef = body.environment.receiverRef
        c.cur.selfRef = body.environment.receiverRef
        c.cur.itemRef = 0U64
        self.genLlvmFuncBody(c: inout c, bodyId: bodyId, fv: self.genMethVal[slot])
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
        c.cur.selfRef = savedSelf
        c.cur.itemRef = savedItem
    }

    inout fn emitGenMethods(c: inout Comp) {
        mut val slot: U64 = 0U64
        while slot < self.genMethBody.count() {
            tracePhaseProgress(c: inout c, label: "backend:generic-method-emitting", count: slot, stride: 16U64)
            self.emitOneGenMethod(c: inout c, slot: slot)
            slot += 1U64
        }
    }

    inout fn ensureFinalGenMethodBody(c: inout Comp, bodyId: U64) -> U64 {
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() || !c.arena.bodyIsCallable(bodyId: bodyId) {
            return self.genMethBody.count()
        }
        val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        val instRef = body.environment.receiverRef
        if body.fnIdx >= c.arena.functionCount() || instRef == 0U64 || instRef >= c.arena.typeCount() || !c.arena.bodySignature(bodyId: bodyId).ready {
            return self.genMethBody.count()
        }
        val existing = self.genMethSlotFor(bodyId: bodyId)
        if existing < self.genMethBody.count() { return existing }
        self.declareOneGenMethod(c: inout c, bodyId: bodyId)
        val slot = self.genMethBody.count() - 1U64
        self.genMethEmit.append(slot)
        return slot
    }
}
