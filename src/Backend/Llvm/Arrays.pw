// Part of the LLVM backend (root: _.pw): array type queries, storage, and copy semantics.

// ---- arrays ----
//
// Recover an expression's LLVM type WITHOUT emitting (for element-type inference
// and array detection). Covers the common forms; falls back to i64.

pub impl LlvmCtx {
    inout fn exprLlvmType(c: inout Comp, id: U64) -> LLVMTypeRef {
        match c.arena.exprs[id] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, tyLen: _, isNeg: _) => {
                if isBool { return self.i1ty }
                val t: TypeInfo = c.typeOf(id: id)
                if t.kind == 0 {
                    return self.llvmScalarTy(c: inout c, tyStart: t.nameStart, tyLen: t.nameLen)
                }
                return self.i64ty
            }
            Expr.Str(start: _, len: _) => { return self.stringLlvmTy(c: inout c) }
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    // an array local's locTy already IS its per-instance `%gs` (the init value's
                    // type), so no array special-case is needed (de-pin).
                    return self.locTy[li]
                }
                return self.i64ty
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val sidx: U64 = self.exprStructIdx(c: inout c, id: base)
                if sidx < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[sidx].fields.count() {
                        return self.fieldLlvmTy(c: inout c, fd: c.arena.structs[sidx].fields[fidx])
                    }
                }
                return self.i64ty
            }
            Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, fields: _) => {
                return self.llvmScalarTy(c: inout c, tyStart: typeStart, tyLen: typeLen)
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // an `any P` receiver: the result LLVM type is the requirement's return,
                // grounded under the existential's bindings.
                val atIdx: U64 = self.anyRecvTraitIdx(c: inout c, recv: recv)
                if atIdx < c.decls.traits.count() {
                    val rr: U64 = anyMethodRetRef(c: inout c, anyRef: self.exprTypeRef(c: inout c, id: recv), traitIdx: atIdx, nameStart: nameStart, nameLen: nameLen, args: args)
                    if rr != 0U64 {
                        return self.llvmTypeOfRef(c: inout c, ref: rr)
                    }
                }
                val rsidx: U64 = self.exprStructIdx(c: inout c, id: recv)
                if rsidx < c.arena.structs.count() {
                    val mfi: U64 = c.findMethod(recvStart: c.arena.structs[rsidx].nameStart, recvLen: c.arena.structs[rsidx].nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if mfi < c.arena.funcs.count() {
                        return self.llvmFnRetTy(c: inout c, f: c.arena.funcs[mfi])
                    }
                }
                return self.i64ty
            }
            Expr.ExtMethod(val recv, val srcStart, val srcLen, val nameStart, val nameLen, val args) => {
                val rsidx: U64 = self.exprStructIdx(c: inout c, id: recv)
                if rsidx < c.arena.structs.count() {
                    val mfi: U64 = c.findExtMethod(recvStart: c.arena.structs[rsidx].nameStart, recvLen: c.arena.structs[rsidx].nameLen, srcStart: srcStart, srcLen: srcLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if mfi < c.arena.funcs.count() {
                        return self.llvmFnRetTy(c: inout c, f: c.arena.funcs[mfi])
                    }
                }
                return self.i64ty
            }
            Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
                return self.exprLlvmType(c: inout c, id: recv)
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                val cfi: U64 = c.resolvedCallee(id: id)
                if cfi < c.arena.funcs.count() {
                    return self.llvmFnRetTy(c: inout c, f: c.arena.funcs[cfi])
                }
                return self.i64ty
            }
            Expr.Binary(val op, val lhs, rhs: _) => {
                if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                    return self.i1ty
                }
                return self.exprLlvmType(c: inout c, id: lhs)
            }
            Expr.Unary(val op, val operand) => {
                if op == opNot() { return self.i1ty }
                return self.exprLlvmType(c: inout c, id: operand)
            }
            Expr.Array(val elems) => { return self.arrayInstTy(c: inout c, elemRef: self.arrayLitElemRef(c: inout c, elems: elems)) }
            _ => { return self.i64ty }
        }
    }

    // Whether an expression is array-typed (for routing `.count()`/`.append`/index).
    inout fn exprIsArray(c: inout Comp, id: U64) -> Bool {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    return self.locIsArr[li]
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val sidx: U64 = self.exprStructIdx(c: inout c, id: base)
                if sidx < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[sidx].fields.count() {
                        val fd: FieldDef = c.arena.structs[sidx].fields[fidx]
                        if fd.tyIsArray {
                            return true
                        }
                        // a generic field grounding to an array (`Box[Array[I32]].v`).
                        return self.fieldArrayElemRefUnderBase(c: inout c, base: base, fd: fd) != 0U64
                    }
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                val psidx: U64 = self.refPointeeStructIdx(c: inout c, base: base)
                if psidx < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[psidx].fields.count() {
                        return c.arena.structs[psidx].fields[fidx].tyIsArray
                    }
                }
            }
            Expr.Array(elems: _) => { return true }
            Expr.Index(base: _, index: _) => {
                // a nested-array element (`m[i]` where m: Array[Array[I32]]): its element
                // type ref is itself an Array. Via the shared resolver so the Index form
                // agrees across the projections (see resolveIndex).
                return self.resolveIndex(c: inout c, id: id).isArray
            }
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                // an array-returning call (`val a = mk()`): tracked as an array — via the
                // shared resolver so exprStructIdx/exprTypeRef/exprIsArray agree on the Call
                // form (see resolveCall).
                return self.resolveCall(c: inout c, id: id).isArray
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                // an array-returning method call (`s.bytes()` -> Array[U8], `h.items()`):
                // its grounded result TypeRef heads `Array`, so a chained `.count()` / index /
                // `for` over the call result routes through the array path just like a local.
                // Via the shared resolver so the Method form agrees across the projections.
                return self.resolveMethod(c: inout c, id: id).isArray
            }
            Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, isEnum: _, ty: _, fields: _) => {
                // `<Array data=buf />` — the array struct built directly from a Buffer (the
                // only way to wrap an existing buffer as an array, e.g. `String.bytes()`).
                // The Make builds the `{ptr}` aggregate (= arrayTy), so it IS an array value.
                return rangeEquals(bytes: c.arena.bytes, start: typeStart, len: typeLen, kw: "Array")
            }
            _ => {}
        }
        return false
    }

    // The element TypeRef of an array LITERAL `[e0, …]` — its first element's type, so the
    // literal can carry a full `Array[E]` instance ref (exprTypeRef) and route index/`for`/
    // method use through the same Index/Iterator/generic witnesses as a bound array (no
    // literal-specific type-name fallback). A generic/any/struct element resolves via
    // exprTypeRef or the element's recorded instance ref; a scalar element (a suffixed int
    // literal, a Bool/String) is synthesized from its type-name span. 0 for an empty literal
    // (always annotated + bound, never used directly).
    inout fn arrayLitElemRef(c: inout Comp, elems: Array[U64]) -> U64 {
        if elems.count() == 0U64 {
            return 0U64
        }
        val e0: U64 = elems[0]
        val r: U64 = self.exprTypeRef(c: inout c, id: e0)
        if r != 0U64 {
            return r
        }
        val ti: TypeInfo = c.typeOf(id: e0)
        if ti.ref != 0U64 {
            return ti.ref
        }
        if ti.nameLen != 0U64 {
            mut val noArgs: Array[U64] = []
            return c.pushType(t: <TypeRef nameStart=ti.nameStart nameLen=ti.nameLen args=noArgs />)
        }
        return 0U64
    }

    // The element type of an array-typed receiver (Ident local / struct field).
    inout fn arrElemTyOf(c: inout Comp, id: U64) -> LLVMTypeRef {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    if self.locIsArr[li] { return self.locElemTy[li] }
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val sidx: U64 = self.exprStructIdx(c: inout c, id: base)
                if sidx < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[sidx].fields.count() {
                        val fd: FieldDef = c.arena.structs[sidx].fields[fidx]
                        // an array field's element type, resolved under the base's instance
                        // env (`Holder[I64].items : Array[Box[T]]` -> Box[I64]; a generic
                        // field `Box[Array[I32]].v` -> I32).
                        val er: U64 = self.fieldArrayElemRefUnderBase(c: inout c, base: base, fd: fd)
                        if er != 0U64 {
                            return self.llvmTypeOfRef(c: inout c, ref: er)
                        }
                        return self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                    }
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                val psidx: U64 = self.refPointeeStructIdx(c: inout c, base: base)
                if psidx < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[psidx].fields.count() {
                        return self.llvmScalarTy(c: inout c, tyStart: c.arena.structs[psidx].fields[fidx].tyStart, tyLen: c.arena.structs[psidx].fields[fidx].tyLen)
                    }
                }
            }
            Expr.Index(base: _, index: _) => {
                // a nested-array element's element type (`m[i]` -> the inner element of
                // m[i], e.g. i32 for m: Array[Array[I32]]): unwrap the element ref.
                val r: U64 = self.exprTypeRef(c: inout c, id: id)
                if r != 0U64 {
                    val t: TypeRef = c.arena.types[r]
                    if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                        if t.args.count() > 0U64 {
                            return self.llvmTypeOfRef(c: inout c, ref: t.args[0])
                        }
                    }
                }
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                // an array-returning call's element type (`val a = mk()` -> element of
                // mk's Array return).
                val cfi: U64 = c.resolvedCallee(id: id)
                if cfi < c.arena.funcs.count() {
                    if c.arena.funcs[cfi].retIsArray {
                        return self.llvmScalarTy(c: inout c, tyStart: c.arena.funcs[cfi].retStart, tyLen: c.arena.funcs[cfi].retLen)
                    }
                }
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                // an array-returning method call's element type (`s.bytes()[i]` -> U8): the
                // grounded result ref heads `Array[E]`, so its first arg is the element ref.
                // (Mirrors the Index arm; without it the element defaults to i64 and the
                // load stride/width is wrong — e.g. reading U8 bytes 8 at a time.)
                val r: U64 = self.exprTypeRef(c: inout c, id: id)
                if r != 0U64 {
                    val t: TypeRef = c.arena.types[r]
                    if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                        if t.args.count() > 0U64 {
                            return self.llvmTypeOfRef(c: inout c, ref: t.args[0])
                        }
                    }
                }
            }
            _ => {}
        }
        return self.i64ty
    }

    // The element kind (0 int/signed, 1 String, 2 Bool, 3 unsigned) of an array-valued
    // expression — for tracking an un-annotated array binding's element kind.
    inout fn arrElemKindOf(c: inout Comp, id: U64) -> U64 {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    if self.locIsArr[li] { return self.locElemKind[li] }
                }
            }
            _ => {}
        }
        return 0U64
    }

    // A pointer to the `{ptr}` aggregate of an array place (an array local or an array struct
    // field of a struct local). Returns LLVMConstNull(ptr) if not an addressable array place.
    inout fn arrPlacePtr(c: inout Comp, id: U64) -> LLVMValueRef {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                // only an array LOCAL has its `{ptr}` in an alloca we can mutate in place;
                // a non-array local is not array storage (null -> caller errors).
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    if self.locIsArr[li] { return self.locPtr[li] }
                }
                return LLVMConstNull(self.ptrty)
            }
            _ => {}
        }
        // a field/element place (possibly nested, e.g. `c.arena.items`): its place
        // pointer IS the array `{ptr}` slot. placePtrStrict recurses through nesting.
        return self.placePtrStrict(c: inout c, id: id)
    }

    // The inner buffer data-pointer SLOT (a `ptr*`) of an array place, so `.append` can grow
    // it in place. Array A: the array value is a `{ptr}` aggregate, so the buffer slot is
    // field 0 of the place's `{ptr}` storage — GEPing it keeps the slot seam (cowArraySlot /
    // arrSlot*) identical to the bare-ptr Buffer floor (whose slot is the local ptr* directly).
    inout fn arrStoragePtr(c: inout Comp, id: U64) -> LLVMValueRef {
        val place: LLVMValueRef = self.arrPlacePtr(c: inout c, id: id)
        if LLVMIsNull(place) != 0I32 {
            return place
        }
        return LLVMBuildStructGEP2(self.b, self.arrayTy, place, 0U64, anon())
    }

    // Build a struct/enum field value, honoring an array field's element type (so an
    // array-literal field uses the field's element type, not i64-defaulted).
    inout fn genFieldValue(c: inout Comp, valExpr: U64, fld: FieldDef) -> LLVMValueRef {
        if fld.tyIsArray {
            match c.arena.exprs[valExpr] {
                Expr.Array(val elems) => {
                    // the literal builds the SAME per-instance `%gs` the field slot expects.
                    // Prefer the literal's own (concrete) element type; for an empty `[]` fall
                    // back to the field's declared element (`fld.ty` = `Array[E]`, args[0] = E),
                    // grounded through the active env so `Array[T]` resolves to `Array[I64]`.
                    mut val feRef: U64 = self.arrayLitElemRef(c: inout c, elems: elems)
                    if feRef == 0U64 {
                        if fld.ty != 0U64 {
                            mut val gft: U64 = fld.ty
                            if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
                                gft = c.groundTypeRef(ref: fld.ty)
                            }
                            if c.arena.types[gft].args.count() == 1U64 {
                                feRef = c.arena.types[gft].args[0]
                            }
                        }
                    }
                    return self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen), elemRef: feRef)
                }
                _ => {}
            }
            // value semantics: an array field initialized from a place (`<Holder items=a/>`)
            // CoW-SHARES the buffer (rc++) — the gateway (1-0) privatizes before any later
            // mutation of the field or the source, so they stay independent. Mirrors
            // consumeIntoOwned's array class.
            return self.shareArrayIfPlace(c: inout c, arrVal: self.genLlvmExpr(c: inout c, id: valExpr), elemTy: self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen), valueExpr: valExpr)
        }
        // a Buffer field initialized from a place CoW-SHARES the buffer (rc++) — same as an
        // array field (rep-identical); a fresh buffer (call result) passes through. Placed
        // before the generic-instance branch below so a `Buffer[T]` place is not misrouted
        // through the enum/struct-instance retain path.
        if fieldIsBufferType(c: inout c, f: fld) {
            return self.shareArrayIfPlace(c: inout c, arrVal: self.genLlvmExpr(c: inout c, id: valExpr), elemTy: self.i64ty, valueExpr: valExpr)
        }
        // an existential `any P` field (spec/08): box a concrete conforming initializer,
        // or value-semantics-copy an existing `any` place.
        mut val fldBoxed: Bool = false
        val fldAny: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: fld.ty, valueExpr: valExpr, outBoxed: inout fldBoxed)
        if fldBoxed {
            return fldAny
        }
        if refIsAny(c: inout c, ref: fld.ty) {
            return self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: valExpr), valueExpr: valExpr)
        }
        // a boxed (recursive) struct field: build the value, heap-allocate a cell, store
        // it, and put the cell pointer in the struct (leaky, like Ref — no free yet).
        if c.fieldIsBoxed(f: fld) {
            // the boxed value is in the field's (pointee) type context, so a nested
            // un-suffixed JSX construction (`next=<Optional.Some … />`) infers its args.
            // GROUND the field type under the active instance env first, so a recursive
            // GENERIC field (`next: Optional[N[T]]` in `N[I64]`) grounds to the registered
            // concrete instance (`Optional[N[I64]]`) instead of the ungrounded template.
            mut val bg: U64 = fld.ty
            if c.cur.typeParams.count() > 0U64 {
                bg = c.groundTypeRef(ref: fld.ty)
            }
            self.expectedTy = bg
            // boxed field moves into a heap cell outliving this scope; deep-copy a place source
            // so its drop does not free the boxed payload (mirrors the enum boxed-payload path).
            val boxedVal: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: valExpr), valueExpr: valExpr)
            val boxedTy: LLVMTypeRef = LLVMTypeOf(boxedVal)
            val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(boxedTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
            LLVMBuildStore(self.b, boxedVal, cell)
            return cell
        }
        // a (non-boxed) generic-instance field by value (`a: Optional[I64]`,
        // `inner: Box[I32]`): ground the field's declared type and pass it as the expected
        // type so an un-suffixed nested JSX construction (`a=<Optional.Some v=7 />`) infers
        // the instance's type args (genLlvmMakeEnum / genLlvmMake consume self.expectedTy).
        if fld.ty != 0U64 {
            mut val g: U64 = fld.ty
            if c.cur.typeParams.count() > 0U64 {
                g = c.groundTypeRef(ref: fld.ty)
            }
            if c.isGenericInst(ref: g) {
                self.expectedTy = g
                val giv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valExpr)
                // a generic enum instance with heap (`Optional[Array[I64]]`) from a place:
                // CoW-SHARE its payload (rc++) so the field co-owns it; the gateway CoWs
                // before any later mutation. Mirrors consumeIntoOwned's enum class.
                if structExprIsPlace(c: inout c, id: valExpr) {
                    self.emitEnumRetainRef(c: inout c, v: giv, ref: g)
                    return giv
                }
                return giv
            }
        }
        // a struct-typed field that owns heap (e.g. `FieldAst.ty: TypeAst` whose `args` is an
        // array), initialized from a struct PLACE: deep-copy so the constructed struct's field
        // is independent of the source (else the bit-copy below shares the source's array
        // fields and the source's drop frees them under the new struct).
        val fsi2: U64 = self.localStructIdxFor(c: inout c, start: fld.tyStart, len: fld.tyLen)
        if fsi2 < c.arena.structs.count() {
            if self.structNeedsDeinit(c: inout c, sidx: fsi2) {
                if structExprIsPlace(c: inout c, id: valExpr) {
                    // CoW-SHARE the struct place into the field (rc++ its heap fields under the
                    // active construction env, matching what deepCopyStructValue would copy);
                    // the gateway CoWs before any later mutation. Mirrors consumeIntoOwned.
                    val sv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valExpr)
                    self.emitStructRetain(c: inout c, v: sv, sidx: fsi2)
                    return sv
                }
            }
        }
        // a NON-generic enum field that owns heap (`Field.value: Value` whose `SVal` holds an
        // Array[U8]), from a place: deep-copy its payload so the constructed struct's field is
        // independent (else the source enum's drop frees the shared payload → UAF). Generic
        // enum instances are handled by the isGenericInst path above.
        if self.enumRegSlot(c: inout c, start: fld.tyStart, len: fld.tyLen) < self.genEnumRefs.count() {
            if structExprIsPlace(c: inout c, id: valExpr) {
                // CoW-SHARE the enum place into the field (rc++ its active variant's heap);
                // the gateway CoWs before any later mutation. Mirrors consumeIntoOwned.
                val ev: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valExpr)
                self.emitEnumRetainRef(c: inout c, v: ev, ref: self.exprTypeRef(c: inout c, id: valExpr))
                return ev
            }
        }
        return self.coerceIntTo(c: inout c, v: self.genLlvmExpr(c: inout c, id: valExpr), tyStart: fld.tyStart, tyLen: fld.tyLen)
    }

    // Declare/cache `plew_rawbuf_alloc(i64 elemSize, i64 cap) -> ptr`.
    inout fn rawbufAlloc(c: inout Comp, elemSize: LLVMValueRef, cap: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_alloc", nameId: 20U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(elemSize)
        av.append(cap)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
    }

    // Declare/cache `plew_rawbuf_count(ptr) -> i64` — the buffer's live-element count,
    // read from the heap header (the Buffer floor maintains it; spec/02, buffer-floor.md).
    inout fn rawbufCount(c: inout Comp, data: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_count", nameId: 9160U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Declare/cache `plew_rawbuf_cap(ptr) -> i64` — the buffer's allocated capacity,
    // read from the heap header.
    inout fn rawbufCap(c: inout Comp, data: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_cap", nameId: 9162U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Declare/cache `plew_rawbuf_set_count(ptr, i64)` — store the buffer's live-element
    // count into the heap header.
    inout fn rawbufSetCount(c: inout Comp, data: LLVMValueRef, n: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_set_count", nameId: 9161U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        av.append(n)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
    }

    // Declare/cache `plew_rawbuf_move(ptr, elemSize, dst, src, n)` — relocate `n` element
    // slots within the buffer (insertAt/removeAt shift). A pure byte move (no element ARC).
    inout fn rawbufMove(c: inout Comp, data: LLVMValueRef, elemSize: LLVMValueRef, dst: LLVMValueRef, src: LLVMValueRef, n: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 5U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_move", nameId: 9162U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        av.append(elemSize)
        av.append(dst)
        av.append(src)
        av.append(n)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 5U64, anon())
    }

    // Declare/cache `plew_arr_grow(data, elemSize, count) -> ptr` — ensure room for one
    // more element (grows by doubling when count>=cap), returning the (possibly new) data.
    inout fn growBuf(c: inout Comp, data: LLVMValueRef, elemTy: LLVMTypeRef, count: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 3U64, 0I32)
        val grow: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_arr_grow", nameId: 22U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        av.append(LLVMSizeOf(elemTy))
        av.append(count)
        return LLVMBuildCall2(self.b, fty, grow, arrayCPtr(av), 3U64, anon())
    }

    // Declare/cache `plew_arr_reserve(data, elemSize, mincap) -> ptr` — grow capacity to
    // >= mincap (preserving elements + count), returning the (possibly new) data pointer.
    inout fn rawbufReserve(c: inout Comp, data: LLVMValueRef, elemSize: LLVMValueRef, mincap: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 3U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_arr_reserve", nameId: 9163U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        av.append(elemSize)
        av.append(mincap)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 3U64, anon())
    }

    // ---- Array/String value representation SEAM (C1 migration boundary) ----
    //
    // An array/string VALUE is a single data pointer (== the Buffer floor): `data` points at
    // the elements, and the live count + capacity live in the heap header [cap@-3][count@-2]
    // [rc@-1] just before it (plew_rawbuf_*). EVERY access to the data/count of an array/string
    // value or its in-place storage slot goes through these helpers, so the representation is
    // localized here. (Before C1 the value was a `{ptr,i64}` aggregate with inline count; the
    // seam was introduced so the flip is a handful of helper bodies, not ~80 inline sites.)

    // The data pointer of an array/string VALUE. The value is a `{ptr}` aggregate (Array A),
    // so unwrap field 0. Kept kind-agnostic: a bare pointer (the Buffer floor, which shares
    // this seam through valueArc) passes through unchanged — only a `{ptr}` struct (kind 10)
    // is unwrapped.
    inout fn arrValData(c: inout Comp, arr: LLVMValueRef) -> LLVMValueRef {
        if LLVMGetTypeKind(LLVMTypeOf(arr)) == 10U32 {
            return LLVMBuildExtractValue(self.b, arr, 0U64, anon())
        }
        return arr
    }
    // The live element count of an array/string VALUE (read from the heap header; 0 for null).
    inout fn arrValCount(c: inout Comp, arr: LLVMValueRef) -> LLVMValueRef {
        return self.rawbufCount(c: inout c, data: self.arrValData(c: inout c, arr: arr))
    }
    // Wrap a bare data pointer into the `{ptr}` array/string VALUE aggregate WITHOUT touching
    // the heap header (the count is already correct — e.g. a baked string literal whose count
    // is in its constant header).
    inout fn arrValWrap(c: inout Comp, data: LLVMValueRef, aggTy: LLVMTypeRef) -> LLVMValueRef {
        return LLVMBuildInsertValue(self.b, LLVMGetUndef(aggTy), data, 0U64, anon())
    }
    // Build an array/string VALUE from a data pointer and a count: stamp `count` into the
    // heap header, then wrap into the `{ptr}` aggregate. Callers pass a buffer that already
    // owns the elements (a fresh rawbuf_alloc, an arr_copy, or a baked literal); set_count is
    // a no-op on null and idempotent when the header already holds `count`.
    inout fn arrValMake(c: inout Comp, data: LLVMValueRef, count: LLVMValueRef, aggTy: LLVMTypeRef) -> LLVMValueRef {
        self.rawbufSetCount(c: inout c, data: data, n: count)
        return self.arrValWrap(c: inout c, data: data, aggTy: aggTy)
    }
    // Load the data pointer from an array STORAGE SLOT (an array local / field alloca): the
    // slot holds the single data pointer.
    inout fn arrSlotData(c: inout Comp, slot: LLVMValueRef) -> LLVMValueRef {
        return LLVMBuildLoad2(self.b, self.ptrty, slot, anon())
    }
    // Load the live count from an array STORAGE SLOT (the slot's data pointer's header count).
    inout fn arrSlotCount(c: inout Comp, slot: LLVMValueRef) -> LLVMValueRef {
        return self.rawbufCount(c: inout c, data: self.arrSlotData(c: inout c, slot: slot))
    }
    // Store a data pointer into an array STORAGE SLOT.
    inout fn arrSlotSetData(c: inout Comp, slot: LLVMValueRef, data: LLVMValueRef) {
        LLVMBuildStore(self.b, data, slot)
    }
    // Store a count into an array STORAGE SLOT (into the slot's data pointer's header). The
    // data pointer must already be stored (every caller does arrSlotSetData first, on grow/CoW).
    inout fn arrSlotSetCount(c: inout Comp, slot: LLVMValueRef, count: LLVMValueRef) {
        self.rawbufSetCount(c: inout c, data: self.arrSlotData(c: inout c, slot: slot), n: count)
    }

    // Eager value-semantics copy of an array value `{data,count}`: allocate a fresh
    // buffer of `count` elements (size from elemTy) and memcpy, returning the new
    // `{newdata,count}`. The memcpy is SHALLOW — so for an ARC-bearing element type
    // (a nested array) the copy duplicates each element's leading heap reference, which
    // must be RETAINED (else the copy and the source both release it at drop = double
    // free). `elemRef` (the element TypeRef) drives that retain; pass 0 only when the
    // element provably owns no heap (a primitive).
    inout fn copyArrayValue(c: inout Comp, arrVal: LLVMValueRef, elemTy: LLVMTypeRef, elemRef: U64 = 0) -> LLVMValueRef {
        val data: LLVMValueRef = self.arrValData(c: inout c, arr: arrVal)
        val count: LLVMValueRef = self.arrValCount(c: inout c, arr: arrVal)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 3U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_arr_copy", nameId: 24U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        av.append(LLVMSizeOf(elemTy))
        av.append(count)
        val nd: LLVMValueRef = LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 3U64, anon())
        if self.arrElemNeedsValueArc(c: inout c, elemRef: elemRef) {
            self.emitRetainArrayElems(c: inout c, data: nd, count: count, elemTy: elemTy, elemRef: elemRef)
        }
        // Preserve the source value's aggregate type (`{ptr}` String `%st` / Array `arrayTy`)
        // so the copy round-trips to the same LLVM type; a bare-ptr source (a Buffer value)
        // has no aggregate, so fall back to the shared arrayTy `{ptr}`.
        mut val aggTy: LLVMTypeRef = self.arrayTy
        if LLVMGetTypeKind(LLVMTypeOf(arrVal)) == 10U32 {
            aggTy = LLVMTypeOf(arrVal)
        }
        return self.arrValMake(c: inout c, data: nd, count: count, aggTy: aggTy)
    }
}

pub impl LlvmCtx {

    // Deep value-semantics copy of a struct value `v` of struct `sidx`: the aggregate
    // is already bit-copied (LLVM by-value), but each ARRAY field's buffer is shared,
    // so copy it (and recurse into nested-struct fields) — `val y = x` then
    // `x.items[0]=…` must leave y.items unchanged. Fields under a generic env resolve
    // via the active substitution. Non-array/non-struct fields pass through unchanged.
    inout fn deepCopyStructValue(c: inout Comp, v: LLVMValueRef, sidx: U64) -> LLVMValueRef {
        // a concrete registered struct: call its copy witness (fields are concrete, so the
        // witness body is env-independent). A generic struct walks inline under the caller's env.
        if self.structSlotForSidx(c: inout c, sidx: sidx) < self.genStructRefs.count() {
            val slot: U64 = self.structCopyWitness(c: inout c, sidx: sidx)
            mut val av: Array[LLVMValueRef] = []
            av.append(v)
            return LLVMBuildCall2(self.b, self.copyWitTy[slot], self.copyWitVal[slot], arrayCPtr(av), 1U64, anon())
        }
        return self.deepCopyStructWalk(c: inout c, v: v, sidx: sidx)
    }

    // The deep-copy walker — emitted ONCE inside each type's witness body (and the inline
    // fallback for an unregistered generic struct). Returns the independent copy. Sub-struct
    // fields recurse through `deepCopyStructValue`, routing each to its own witness call.
    inout fn deepCopyStructWalk(c: inout Comp, v: LLVMValueRef, sidx: U64) -> LLVMValueRef {
        val sd: StructDef = c.arena.structs[sidx]
        mut val agg: LLVMValueRef = v
        mut val fi: U64 = 0
        while fi < sd.fields.count() {
            val fd: FieldDef = sd.fields[fi]
            // an array or Buffer field (declared `Array[E]`/`Buffer[E]` or a type param
            // grounding to one): deep-copy the backing buffer. The buffer COPY is shared
            // (plew_arr_copy), but the FIELD types differ after the de-collapse (increment 1):
            // an `Array` field is the `{ptr}` aggregate (arrayTy), a `Buffer` field is the bare
            // data pointer. copyArrayValue returns the `{ptr}` aggregate, so an Array field takes
            // it directly while a Buffer field takes its unwrapped data pointer (arrValData) —
            // else inserting `{ptr}` into a bare-`ptr` field mismatches (e.g. String's `buffer`).
            val er: U64 = arrayOrBufferFieldElemRef(c: inout c, f: fd)
            if er != 0U64 {
                val elem: LLVMValueRef = LLVMBuildExtractValue(self.b, agg, fi, anon())
                val et: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: er)
                val copied: LLVMValueRef = self.copyArrayValue(c: inout c, arrVal: elem, elemTy: et, elemRef: er)
                if fd.tyIsArray {
                    agg = LLVMBuildInsertValue(self.b, agg, copied, fi, anon())
                } else {
                    agg = LLVMBuildInsertValue(self.b, agg, self.arrValData(c: inout c, arr: copied), fi, anon())
                }
            } else if fieldIsRefType(c: inout c, f: fd) {
                // a `Ref` field is shared-mutable by definition: a value copy SHARES the same
                // cell (the pointee is NOT deep-copied — `val b = a` aliases a's referent) and
                // retains its strong rc. Keeps the field pointer, bumps the count. Balanced by
                // emitRefRelease at the copy's drop.
                self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, agg, fi, anon()))
            } else if fieldIsWeakRefType(c: inout c, f: fd) {
                // a `WeakRef` field copy SHARES the same cell and bumps the WEAK count (not
                // strong) — balanced by weakRelease at the copy's drop.
                self.refWeakDowngrade(c: inout c, cell: LLVMBuildExtractValue(self.b, agg, fi, anon()))
            } else {
                if c.fieldIsBoxed(f: fd) {
                    // a boxed (recursive) field is a shared heap pointer — leave it (deep
                    // copy of the cyclic graph is a later ARC refinement).
                } else {
                    val nsi: U64 = self.localStructIdxFor(c: inout c, start: fd.tyStart, len: fd.tyLen)
                    if nsi < c.arena.structs.count() {
                        val elem: LLVMValueRef = LLVMBuildExtractValue(self.b, agg, fi, anon())
                        agg = LLVMBuildInsertValue(self.b, agg, self.deepCopyStructValue(c: inout c, v: elem, sidx: nsi), fi, anon())
                    } else {
                        // an enum field (generic instance like `Optional[Array]` or a plain
                        // enum like `Value`): deep-copy its active variant's payload so the
                        // copy is independent (closes the struct<->enum recursion). A non-enum
                        // field passes through deepCopyEnumRef unchanged.
                        mut val gref: U64 = fd.ty
                        if c.cur.typeParams.count() > 0U64 {
                            gref = c.groundTypeRef(ref: fd.ty)
                        }
                        val elem: LLVMValueRef = LLVMBuildExtractValue(self.b, agg, fi, anon())
                        agg = LLVMBuildInsertValue(self.b, agg, self.deepCopyEnumRef(c: inout c, v: elem, ref: gref), fi, anon())
                    }
                }
            }
            fi += 1
        }
        return agg
    }

    // The copyWit* slot for struct `sidx`, or copyWitSidx.count() if none declared yet.
    inout fn copyWitSlot(sidx: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.copyWitSidx.count() {
            if self.copyWitSidx[i] == sidx {
                return i
            }
            i += 1
        }
        return self.copyWitSidx.count()
    }

    // Ensure the per-type copy witness `structTy @pwcopy<sidx>(structTy)` is declared, and
    // return its copyWit* slot. Body emitted later (emitCopyWitnessBodies). Caller must have
    // checked `sidx` is a registered struct.
    inout fn structCopyWitness(c: inout Comp, sidx: U64) -> U64 {
        val found: U64 = self.copyWitSlot(sidx: sidx)
        if found < self.copyWitSidx.count() {
            return found
        }
        val reg: U64 = self.structSlotForSidx(c: inout c, sidx: sidx)
        val sty: LLVMTypeRef = self.genStructTys[reg]
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(sty)
        val fty: LLVMTypeRef = LLVMFunctionType(sty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwcopy".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.copyWitSidx.append(sidx)
        self.copyWitVal.append(fv)
        self.copyWitTy.append(fty)
        return self.copyWitSidx.count() - 1U64
    }

    // Emit the body of every declared copy witness: the deep-copy walker over its single
    // struct-value parameter, returning the independent copy. Drained by a growing cursor
    // (a walk may declare sub-struct witnesses). Called once after the main emit pass.
    inout fn emitCopyWitnessBodies(c: inout Comp) {
        while self.copyWitDone < self.copyWitSidx.count() {
            val s: U64 = self.copyWitDone
            val sidx: U64 = self.copyWitSidx[s]
            val fv: LLVMValueRef = self.copyWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            LLVMBuildRet(self.b, self.deepCopyStructWalk(c: inout c, v: LLVMGetParam(fv, 0U64), sidx: sidx))
            self.copyWitDone += 1
        }
    }
}

pub impl LlvmCtx {

    // Move value `v` of type `typeRef` (the already-emitted value of `expr`) into a NEW
    // owner when `expr` is an existing array/struct/enum PLACE: under eager-copy, deep-copy
    // so the owners are independent (return, assignment RHS, give, element/append, a field
    // initializer). A literal / call / append result already owns its buffer and passes
    // through. THE single place-gate + dispatch for the bind/store/give cluster, named so
    // the 1-3a flip swaps this eager copy for a shallow CoW-share retain in one spot (the
    // 1-0 gateway privatizes before any later in-place write through the shared buffer).
    // `typeRef` lets a caller with a grounded construction type control the struct/enum env
    // + dispatch (do NOT re-derive it from `expr` — a field's grounded type can differ).
    // Pass 0 to derive it lazily from `expr` IN the struct/enum branch only: deriving it
    // eagerly perturbs the type cache (registering generic instances) on the array / non-
    // place paths, shifting instance numbering. Over-copying is observably harmless;
    // under-copying miscompiles.
    inout fn consumeIntoOwned(c: inout Comp, v: LLVMValueRef, expr: U64, typeRef: U64) -> LLVMValueRef {
        // 1-3a (String class): CoW-SHARE a String PLACE — a String's value IS an
        // rc-managed Array[U8] buffer (immutable, so sharing never needs a write-time
        // CoW), so copying a String place RETAINS the buffer (rc++) instead of aliasing
        // it unmanaged. Balanced by the owner's release at drop (Array[String] element
        // release / struct-field deinit / removeLast). A fresh String (literal / call
        // result) already owns its buffer and passes through; literals carry a sentinel
        // rc making the retain a no-op. Mirrors the array / struct / enum classes below.
        if structExprIsPlace(c: inout c, id: expr) {
            mut val sr: U64 = typeRef
            if sr == 0U64 {
                sr = self.exprTypeRef(c: inout c, id: expr)
            }
            if sr != 0U64 {
                val st: TypeRef = c.arena.types[sr]
                if rangeEquals(bytes: c.arena.bytes, start: st.nameStart, len: st.nameLen, kw: "String") {
                    self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: v))
                    return v
                }
            }
        }
        // 1-3a (Ref class): copying a `Ref` PLACE into a new owner (`val r2 = r`, a field
        // init `<Box r=r />`, an `append(r)`, a by-value arg, `return r`) shares the cell and
        // RETAINS its strong rc (rc++). Balanced by the owner's emitRefRelease at drop /
        // element-release / field-deinit / set-overwrite. A fresh `<Ref value=… />` is a
        // non-place (owns its rc=1) and passes through. Mirrors the String class above.
        // Prefer the caller's grounded element ref (`er` from append/set) — the value
        // EXPR is often a generic intrinsic param (`bufferAppend`'s `value: T`) whose
        // locTypeRef does not ground T to `Ref[Cell]`, so re-deriving from the expr
        // misses the Ref class and the store would not retain (use-after-free when the
        // appended place's binding later drops). Fall back to the expr type when no
        // typeRef was passed (direct binds / args / returns).
        mut val rr: U64 = typeRef
        if !(c.isRefInst(ref: rr)) {
            rr = self.exprRefTypeRef(c: inout c, id: expr)
        }
        if c.isRefInst(ref: rr) {
            if arrayExprIsPlace(c: inout c, id: expr) {
                self.rawbufRetain(c: inout c, cell: v)
            }
            return v
        }
        // 1-3a (WeakRef class): copying a `WeakRef` PLACE into a new owner shares the cell and
        // bumps the WEAK count (not strong) — balanced by the owner's weakRelease at drop. A
        // fresh `r.weak()` result is a non-place (already owns one weak) and passes through.
        mut val wr: U64 = typeRef
        if !(c.isWeakRefInst(ref: wr)) {
            wr = self.exprTypeRef(c: inout c, id: expr)
        }
        if c.isWeakRefInst(ref: wr) {
            if arrayExprIsPlace(c: inout c, id: expr) {
                self.refWeakDowngrade(c: inout c, cell: v)
            }
            return v
        }
        if self.exprIsArray(c: inout c, id: expr) {
            // 1-3a (array class): CoW-SHARE an array place into the new owner — retain the
            // buffer (rc++) instead of eager deep-copy; the first in-place mutation CoWs via
            // the slot (the 1-0 gateway privatizes shared buffers above any write). Same op
            // as let-bind sharing (shareArrayIfPlace). Element retain/release stays shallow:
            // a nested-array element is referenced once by the single shared buffer (no extra
            // retain), and the buffer's drop cascades into elements at rc 0 — balanced.
            return self.shareArrayIfPlace(c: inout c, arrVal: v, elemTy: self.arrElemTyOf(c: inout c, id: expr), valueExpr: expr)
        }
        // 1-3a (buffer class): CoW-SHARE a Buffer place — Buffer is structurally an array
        // (single rawbuf pointer, header count, rc), so retain the buffer (rc++) exactly
        // like the array class; the buffer's drop cascades into elements at rc 0. A fresh
        // buffer (call result) is a non-place and passes through. Needed so appending /
        // storing a Buffer local (`outer.append(inner)`) co-owns it instead of aliasing a
        // buffer the inner local's scope-drop will free.
        if self.exprIsBuffer(c: inout c, id: expr) {
            return self.shareArrayIfPlace(c: inout c, arrVal: v, elemTy: self.bufElemTyOf(c: inout c, id: expr), valueExpr: expr)
        }
        if structExprIsPlace(c: inout c, id: expr) {
            val sidx: U64 = self.exprStructIdx(c: inout c, id: expr)
            if sidx < c.arena.structs.count() {
                // 1-3a (struct class): CoW-SHARE the struct place — retain its heap fields
                // (rc++) instead of deep-copying them; the first in-place mutation of a field
                // CoWs via the slot (gateway). emitStructRetain rc-bumps exactly the buffers
                // deepCopyStructValue made independent, so value semantics hold. Set the
                // generic instance env so a param-typed field grounding to an array
                // (`Box[Array[I32]].v`) is retained (its arrayFieldElemRef resolves).
                mut val sref: U64 = typeRef
                if sref == 0U64 {
                    sref = self.exprTypeRef(c: inout c, id: expr)
                }
                val savedP: Array[Bind] = c.cur.typeParams
                val savedA: Array[U64] = c.cur.typeArgs
                val didSet: Bool = self.setStructEnv(c: inout c, ref: sref)
                self.emitStructRetain(c: inout c, v: v, sidx: sidx)
                if didSet {
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                }
                return v
            }
            // 1-3a (enum class): CoW-SHARE an enum place (`val o2 = o` / `return opt` /
            // `arr[i] = res`) — retain its active variant's heap (rc++) instead of deep-
            // copying; the first in-place mutation of the payload CoWs via the gateway (1-0).
            // emitEnumRetainRef rc-bumps exactly the variant heap deepCopyEnumRef would have
            // copied (both tag-dispatch the same fields) and is balanced by emitEnumReleaseRef
            // at drop, so value semantics hold and nothing double-frees. Mirrors the array /
            // struct classes above.
            mut val eref: U64 = typeRef
            if eref == 0U64 {
                eref = self.exprTypeRef(c: inout c, id: expr)
            }
            self.emitEnumRetainRef(c: inout c, v: v, ref: eref)
            return v
        }
        return v
    }

    // `consumeIntoOwned` for a value whose owning type is the source expression's own type
    // (the bind/store/give/element/append/any callers): typeRef is derived lazily from
    // `valueExpr` inside consumeIntoOwned (pass the 0 sentinel).
    inout fn copyValueIfPlace(c: inout Comp, rv: LLVMValueRef, valueExpr: U64) -> LLVMValueRef {
        return self.consumeIntoOwned(c: inout c, v: rv, expr: valueExpr, typeRef: 0U64)
    }

    // Increment a rawbuf cell's refcount (`Ref` share — `val r2 = r`).
    inout fn rawbufRetain(c: inout Comp, cell: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_retain", nameId: 25U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Decrement a rawbuf cell's refcount and return the new count (i64).
    inout fn rawbufRelease(c: inout Comp, cell: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_release", nameId: 26U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Drop one owner of a rawbuf cell: decrement its refcount, free at 0 (`plew_rawbuf_drop`).
    inout fn rawbufDrop(c: inout Comp, cell: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_drop", nameId: 23U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // ---- `Ref` / `WeakRef` two-counter control block (spec/03) ----
    // The cell is a rawbuf (cap=1) reused as a control block: strong = header rc (p[-1]),
    // weak = the unused Buffer `count` slot (p[-2]). A `Ref` value owns one strong; a
    // `WeakRef` value owns one weak. The pointee deinit runs when strong hits 0; the cell
    // is freed when BOTH counters reach 0 (so a weak observer can still read strong==0).

    // strong reached 0 (pointee deinit already emitted): free iff no weak observers remain.
    inout fn refDisposeStrong(c: inout Comp, cell: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_ref_dispose_strong", nameId: 9170U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // `r.weak()`: bump the weak count, yield the same cell as a `WeakRef` handle.
    inout fn refWeakDowngrade(c: inout Comp, cell: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_ref_weak", nameId: 9171U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // `w.upgrade()`: alive (strong>0) → take a strong owner and return the cell; else null.
    inout fn refUpgrade(c: inout Comp, cell: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_ref_upgrade", nameId: 9172U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // `w.upgrade` alive-test: the cell's current strong count (0 once the pointee was
    // destroyed). `weakAlive` compares `> 0`.
    inout fn refStrongCount(c: inout Comp, cell: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_ref_strong", nameId: 9174U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // drop one weak observer (`WeakRef` scope exit): weak--; free at weak==0 && strong==0.
    inout fn weakRelease(c: inout Comp, cell: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_weak_release", nameId: 9173U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Release one strong owner of a `Ref[T]` cell value: decrement strong; at 0 run the
    // pointee's deinit (if its type needs one) then dispose the cell (freed iff no weak
    // observers remain). The single release entry for every Ref position — local drop,
    // struct field, array/buffer element, enum payload, set-overwrite. Balances the
    // rawbufRetain emitted by consumeIntoOwned at each Ref place-copy.
    inout fn emitRefRelease(c: inout Comp, cell: LLVMValueRef, refTy: U64) {
        // Peek the strong count BEFORE decrementing. If this is the last strong owner
        // (count == 1), run the pointee deinit while strong is STILL held: the deinit may
        // release a field that closes a weak back-reference cycle (e.g. a child's
        // `WeakRef[Parent]`). Were strong already 0, that inner weakRelease would observe
        // strong==0 && weak→0 and free THIS very cell mid-deinit, so the dispose below
        // would double-free it (UAF). Holding strong across the deinit keeps the cell alive
        // until we decrement and dispose exactly once.
        val cur: LLVMValueRef = self.refStrongCount(c: inout c, cell: cell)
        val isLast: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), cur, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
        val deinitBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "refrel.last"))
        val decBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "refrel.dec"))
        LLVMBuildCondBr(self.b, isLast, deinitBB, decBB)
        LLVMPositionBuilderAtEnd(self.b, deinitBB)
        val rpsi: U64 = self.refDeinitPointeeSidx(c: inout c, refTy: refTy)
        if rpsi < c.arena.structs.count() {
            val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: refTy)
            self.emitDeinitValue(c: inout c, v: LLVMBuildLoad2(self.b, pty, cell, anon()), sidx: rpsi)
        }
        LLVMBuildBr(self.b, decBB)
        LLVMPositionBuilderAtEnd(self.b, decBB)
        // Now decrement strong. If it reaches 0 (i.e. we just ran the deinit), dispose the
        // cell — freed iff no weak observers remain.
        val newStrong: LLVMValueRef = self.rawbufRelease(c: inout c, cell: cell)
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), newStrong, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val dispBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "refrel.disp"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "refrel.cont"))
        LLVMBuildCondBr(self.b, isZero, dispBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, dispBB)
        self.refDisposeStrong(c: inout c, cell: cell)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
    }

    // Array CoW (Stage 2) makes the array's OWN ({data,count}) buffer the rc-managed unit
    // for EVERY element type: rc-shared on bind/arg/payload-bind/enum-construct, CoW'd on
    // mutation (append/set/`[i]=`/inout), and released (freed at rc 0) at scope exit.
    // Element heap (String buffers, inner arrays, struct/enum payload buffers, and `Ref`
    // cells) CASCADES (1-3b): arrElemNeedsValueArc returns true for each, so when a CoW
    // duplicates the buffer the elements are retained, and when the buffer is freed they are
    // released — element heap is reclaimed, not leaked. A `Ref` element rides the same path
    // with its own strong-rc retain / emitRefRelease (pointee deinit + free at strong 0).

    // Take a new owner of an array VALUE bound/passed from an existing place (`val b = a`,
    // a by-value arg): RETAIN the shared buffer (true CoW — no copy; the copy is deferred
    // to the first mutation). A non-place (literal / call result) already owns its buffer
    // and passes through.
    inout fn shareArrayIfPlace(c: inout Comp, arrVal: LLVMValueRef, elemTy: LLVMTypeRef, valueExpr: U64) -> LLVMValueRef {
        if !(arrayExprIsPlace(c: inout c, id: valueExpr)) {
            return arrVal
        }
        self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: arrVal))
        return arrVal
    }

    // CoW a scalar array place's buffer in its storage slot before an in-place mutation:
    // load {data,count}, call plew_arr_cow (copies + drops one owner iff rc>1), store the
    // possibly-new data back, and return that data pointer. The slot is the array local's
    // {ptr,count} alloca (or an inout param's slot — so a mutation through `inout` CoWs the
    // caller's binding, leaving other sharers untouched).
    inout fn cowArraySlot(c: inout Comp, slotPtr: LLVMValueRef, elemTy: LLVMTypeRef, elemRef: U64) -> LLVMValueRef {
        val data: LLVMValueRef = self.arrSlotData(c: inout c, slot: slotPtr)
        val count: LLVMValueRef = self.arrSlotCount(c: inout c, slot: slotPtr)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 3U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_arr_cow", nameId: 31U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(data)
        av.append(LLVMSizeOf(elemTy))
        av.append(count)
        val nd: LLVMValueRef = LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 3U64, anon())
        self.arrSlotSetData(c: inout c, slot: slotPtr, data: nd)
        // when the CoW actually duplicated the buffer (nd != old data), the shallow memcpy
        // duplicated every element's leading heap reference too — retain each so the new
        // owner co-owns it (balanced by this owner's eventual element release at drop).
        if self.arrElemNeedsValueArc(c: inout c, elemRef: elemRef) {
            val copied: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), nd, data, anon())
            val retBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "cow.retain"))
            val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "cow.cont"))
            LLVMBuildCondBr(self.b, copied, retBB, contBB)
            LLVMPositionBuilderAtEnd(self.b, retBB)
            self.emitRetainArrayElems(c: inout c, data: nd, count: count, elemTy: elemTy, elemRef: elemRef)
            LLVMBuildBr(self.b, contBB)
            LLVMPositionBuilderAtEnd(self.b, contBB)
        }
        return nd
    }

    // ---- recursive value ARC over array element heap (1-3b: element cascade) ----
    //
    // Only the array's own ({data,count}) buffer is rc-managed by the array machinery; an
    // element that itself owns heap — a nested array, a String, a struct/enum that needs a
    // deinit — is retained when an outer CoW duplicates it and released when the outer is
    // freed, so the element heap is reclaimed instead of leaked. retain is SHALLOW (bump the
    // element's leading rc / co-own its fields); release CASCADES (frees at rc 0, recursing
    // into deeper elements). `Ref` elements are intentionally NOT covered (their own rc
    // semantics own the pointee) — arrElemNeedsValueArc returns false for them, so they are
    // never retained/released here and can never be double-freed.
    inout fn arrElemNeedsValueArc(c: inout Comp, elemRef: U64) -> Bool {
        if elemRef == 0U64 {
            return false
        }
        // a `Ref[T]` element owns one strong rc on its shared cell — retained when an outer
        // CoW duplicates the buffer, released (pointee deinit + free at strong 0) when the
        // buffer is freed or the element is overwritten. valueArc's Ref case does both.
        if c.isRefInst(ref: elemRef) {
            return true
        }
        // a `WeakRef[T]` element owns one WEAK rc on its shared cell — bumped when an outer
        // CoW duplicates the buffer, released when the buffer is freed or the element is
        // overwritten (cell freed iff both strong and weak reach 0). valueArc's WeakRef case
        // does both (refWeakDowngrade / weakRelease).
        if c.isWeakRefInst(ref: elemRef) {
            return true
        }
        val t: TypeRef = c.arena.types[elemRef]
        // `Buffer[T]` owns an rc-managed heap buffer, so a Buffer element is value-ARC'd.
        // (`Array[T]` is no longer named: as an ordinary `struct { data: Buffer }` it is caught
        // by the registered-struct case below via structNeedsDeinit — its Buffer field counts.)
        if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Buffer") {
            return true
        }
        // a String element owns an rc-managed Array[U8] buffer — retained on outer CoW,
        // released on outer drop (its value IS the buffer; see valueArc's String case).
        if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "String") {
            return true
        }
        // a struct element that releases heap on destruction (array/struct field or `deinit`):
        // its elements are retained on outer CoW and released on outer drop. Uses the any-arity
        // lookup so a GENERIC struct element (`Array[I64]` — an ordinary `struct { data: Buffer }`)
        // is resolved by name and its Buffer field counts via structNeedsDeinit (collections.md §3-付録3).
        val sidx: U64 = c.structDefByNameAny(start: t.nameStart, len: t.nameLen)
        if sidx < c.arena.structs.count() {
            if !(c.arena.structs[sidx].isExtern) {
                return self.structNeedsDeinit(c: inout c, sidx: sidx)
            }
        }
        // an enum element that owns heap (a variant with a non-boxed array/struct field):
        // its elements are retained on outer CoW and released on outer drop (like structs).
        val gei: U64 = self.genEnumSlot(c: inout c, ref: elemRef)
        if gei < self.genEnumRefs.count() {
            // set the instance env so a type-param `Ref` payload (`Array[Optional[Ref[T]]]`)
            // grounds in variantHasHeap (fieldGroundedRefTy) and the element is ARC'd.
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val didSet: Bool = self.setEnumEnv(c: inout c, ref: elemRef)
            val needs: Bool = self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[gei])
            if didSet {
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
            }
            return needs
        }
        val reg: U64 = self.enumRegSlot(c: inout c, start: t.nameStart, len: t.nameLen)
        if reg < self.genEnumRefs.count() {
            return self.enumNeedsDeinit(c: inout c, eid: self.genEnumDefs[reg])
        }
        return false
    }

    // Free a rawbuf cell unconditionally (rc already at 0); null / sentinel-rc left alone.
    inout fn rawbufFree(c: inout Comp, cell: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_rawbuf_free", nameId: 32U64, fnTy: fty)
        mut val cav: Array[LLVMValueRef] = []
        cav.append(cell)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(cav), 1U64, anon())
    }

    // Value-ARC one element VALUE `v` of type `typeRef`: `retain` bumps its leading heap rc
    // shallowly (nested array: retain the inner buffer; struct: co-own heap fields; enum:
    // retain the active variant's non-boxed heap), else cascading-release it (nested array:
    // release the buffer, recursing into ITS elements at rc 0; struct: deinit; enum: release
    // the active variant). The type dispatch is shared; only the leaf op differs by `retain`.
    // Scalars / unsupported types: nop. The single value-ARC entry (retain and release).
    inout fn valueArc(c: inout Comp, v: LLVMValueRef, typeRef: U64, retain: Bool) {
        if typeRef == 0U64 {
            return
        }
        val t: TypeRef = c.arena.types[typeRef]
        // `Buffer[T]`: the opaque rawbuf floor (single data pointer, header count, rc).
        // retain = bump the buffer rc (shallow CoW-share); release = the rc-aware cascade
        // (release each element at rc 0, then free). The element ref is the type argument.
        // (`Array[T]` is NOT named here any more — it is an ordinary `struct { data: Buffer }`
        // and value-ARCs by field recursion through the struct path below, which descends into
        // its single Buffer field and lands back here. collections.md §3-付録3.)
        if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Buffer") {
            if retain {
                self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: v))
            } else {
                mut val innerRef: U64 = 0
                if t.args.count() > 0U64 {
                    innerRef = t.args[0]
                }
                val innerTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: innerRef)
                self.emitReleaseArrayValue(c: inout c, data: self.arrValData(c: inout c, arr: v), count: self.arrValCount(c: inout c, arr: v), elemTy: innerTy, elemRef: innerRef)
            }
            return
        }
        // a String element: its value IS the Array[U8] buffer — value-ARC it directly (U8
        // scalars, so just the rc-managed outer buffer; literal Strings carry a sentinel rc,
        // making retain/drop a no-op for them). Matches emitDeinitValue's String handling.
        if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "String") {
            if retain {
                self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: v))
            } else {
                self.rawbufDrop(c: inout c, cell: self.arrValData(c: inout c, arr: v))
            }
            return
        }
        // a `Ref[T]` value: the cell pointer itself, with a strong rc. retain = bump strong
        // (shallow — the pointee aliases); release = decrement strong, and at 0 run the
        // pointee deinit then free the cell (gated on weak observers). Matches String's
        // single-rawbuf treatment, plus the pointee deinit. (Ref is an extern struct, so it
        // must be handled HERE before the registered-struct lookup, which skips externs.)
        if c.isRefInst(ref: typeRef) {
            if retain {
                self.rawbufRetain(c: inout c, cell: v)
            } else {
                self.emitRefRelease(c: inout c, cell: v, refTy: typeRef)
            }
            return
        }
        // a `WeakRef[T]` value: the cell pointer with a WEAK rc. retain = bump weak (shallow
        // share — does NOT keep the pointee alive); release = decrement weak, and free the
        // cell only when BOTH strong and weak are 0. Like Ref, an extern struct, so handled
        // HERE before the registered-struct lookup (which skips externs).
        if c.isWeakRefInst(ref: typeRef) {
            if retain {
                self.refWeakDowngrade(c: inout c, cell: v)
            } else {
                self.weakRelease(c: inout c, cell: v)
            }
            return
        }
        // any-arity lookup: a generic struct value (`Array[I64]`) resolves by name, with its
        // instance env supplied below (setStructEnv) for grounding the field recursion.
        val sidx: U64 = c.structDefByNameAny(start: t.nameStart, len: t.nameLen)
        if sidx < c.arena.structs.count() {
            if !(c.arena.structs[sidx].isExtern) {
                // ground this value's own instance env (`Array[String]` -> T=String) so a
                // generic field (`data: Buffer[T]`) resolves to its concrete element while the
                // inline walker descends. setStructEnv is a no-op for an unregistered / already-
                // ungrounded ref, so a caller-set env is preserved.
                val savedP: Array[Bind] = c.cur.typeParams
                val savedA: Array[U64] = c.cur.typeArgs
                val didSet: Bool = self.setStructEnv(c: inout c, ref: typeRef)
                if retain {
                    self.emitStructRetain(c: inout c, v: v, sidx: sidx)
                } else {
                    self.emitDeinitValue(c: inout c, v: v, sidx: sidx)
                }
                if didSet {
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                }
                return
            }
        }
        // an enum element: value-ARC its active variant's non-boxed heap.
        if retain {
            self.emitEnumRetainRef(c: inout c, v: v, ref: typeRef)
        } else {
            self.emitEnumReleaseRef(c: inout c, v: v, ref: typeRef)
        }
    }

    // Shallow-retain a struct value's heap-owning fields (an array field's buffer; a nested
    // struct/enum field recursively) so a second owner co-owns them — used for an Array[Struct]
    // CoW element retain, a by-value struct arg, and the CoW-SHARE of a struct place (1-3a).
    // Mirrors `deepCopyStructValue`'s field dispatch EXACTLY (grounded array via
    // `arrayFieldElemRef`, boxed skip, `localStructIdxFor` struct recursion, grounded enum via
    // `emitEnumRetainRef`) so it rc-bumps precisely the buffers deep-copy would have made
    // independent — i.e. every buffer a later in-place mutation must CoW (rc>1) for value
    // semantics. The active generic env must be set by the caller (consumeIntoOwned does so via
    // setStructEnv) for the grounding to resolve. Balanced by `emitDeinitValue` at drop (which
    // gates on declared types, so an over-retained generic field is leaked-but-safe, never UAF).
    inout fn emitStructRetain(c: inout Comp, v: LLVMValueRef, sidx: U64) {
        // a concrete registered struct: call its retain witness instead of inlining the
        // walker (fields are concrete, so the witness body is env-independent). A generic
        // struct stays unregistered and is walked inline under the caller's env.
        if self.structSlotForSidx(c: inout c, sidx: sidx) < self.genStructRefs.count() {
            val slot: U64 = self.structRetainWitness(c: inout c, sidx: sidx)
            mut val av: Array[LLVMValueRef] = []
            av.append(v)
            LLVMBuildCall2(self.b, self.retWitTy[slot], self.retWitVal[slot], arrayCPtr(av), 1U64, anon())
            return
        }
        self.emitRetainWitnessWalk(c: inout c, v: v, sidx: sidx)
    }

    // The retain-the-fields walker — emitted ONCE inside each type's witness body (and the
    // inline fallback for an unregistered generic struct). Sub-struct fields recurse through
    // `emitStructRetain`, routing each to its own witness call.
    inout fn emitRetainWitnessWalk(c: inout Comp, v: LLVMValueRef, sidx: U64) {
        if self.arcOnStack(sidx: sidx) {
            return
        }
        self.arcPush(sidx: sidx)
        val sd: StructDef = c.arena.structs[sidx]
        mut val i: U64 = 0
        while i < sd.fields.count() {
            val fd: FieldDef = sd.fields[i]
            val er: U64 = arrayOrBufferFieldElemRef(c: inout c, f: fd)
            if er != 0U64 {
                // an array or Buffer field: retain its buffer (shallow CoW-share).
                self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: LLVMBuildExtractValue(self.b, v, i, anon())))
            } else if fieldIsRefType(c: inout c, f: fd) {
                // a `Ref` field: retain its cell's strong rc (shallow CoW-share), balancing
                // the emitRefRelease in the drop walker. (A boxed recursive-value field below
                // is a DIFFERENT shared pointer — the compiler's auto-box, not a user Ref —
                // and is intentionally left alone; value semantics hold via deep-copy there.)
                self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, v, i, anon()))
            } else if fieldIsWeakRefType(c: inout c, f: fd) {
                // a `WeakRef` field: bump the WEAK count (shallow share), balancing weakRelease
                // in the drop walker.
                self.refWeakDowngrade(c: inout c, cell: LLVMBuildExtractValue(self.b, v, i, anon()))
            } else {
                if c.fieldIsBoxed(f: fd) {
                    // a boxed (recursive) field is a shared heap pointer — leave it (like Ref).
                } else {
                    val nsi: U64 = self.localStructIdxFor(c: inout c, start: fd.tyStart, len: fd.tyLen)
                    if nsi < c.arena.structs.count() {
                        // skip a no-heap struct field (nothing to retain) — coverage-neutral but
                        // cuts the inline expansion (matches emitDeinitValue's drop-side gate).
                        if self.structNeedsDeinit(c: inout c, sidx: nsi) {
                            self.emitStructRetain(c: inout c, v: LLVMBuildExtractValue(self.b, v, i, anon()), sidx: nsi)
                        }
                    } else {
                        // an enum field (generic instance like `Optional[Array]` or a plain enum):
                        // retain its active variant's payload heap. A non-enum field is a no-op.
                        mut val gref: U64 = fd.ty
                        if c.cur.typeParams.count() > 0U64 {
                            gref = c.groundTypeRef(ref: fd.ty)
                        }
                        self.emitEnumRetainRef(c: inout c, v: LLVMBuildExtractValue(self.b, v, i, anon()), ref: gref)
                    }
                }
            }
            i += 1
        }
        self.arcPop()
    }

    // The retWit* slot for struct `sidx`, or retWitSidx.count() if none declared yet.
    inout fn retWitSlot(sidx: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.retWitSidx.count() {
            if self.retWitSidx[i] == sidx {
                return i
            }
            i += 1
        }
        return self.retWitSidx.count()
    }

    // Ensure the per-type retain witness `void @pwretain<sidx>(structVal)` is declared, and
    // return its retWit* slot. Body emitted later (emitRetainWitnessBodies). Caller must have
    // checked `sidx` is a registered struct.
    inout fn structRetainWitness(c: inout Comp, sidx: U64) -> U64 {
        val found: U64 = self.retWitSlot(sidx: sidx)
        if found < self.retWitSidx.count() {
            return found
        }
        val reg: U64 = self.structSlotForSidx(c: inout c, sidx: sidx)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.genStructTys[reg])
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwretain".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.retWitSidx.append(sidx)
        self.retWitVal.append(fv)
        self.retWitTy.append(fty)
        return self.retWitSidx.count() - 1U64
    }

    // Emit the body of every declared retain witness: the field-retain walker over its single
    // struct-value parameter. Drained by a growing cursor (a walk may declare sub-struct
    // witnesses). Called once after the main emit pass, alongside the drop witnesses.
    inout fn emitRetainWitnessBodies(c: inout Comp) {
        while self.retWitDone < self.retWitSidx.count() {
            val s: U64 = self.retWitDone
            val sidx: U64 = self.retWitSidx[s]
            val fv: LLVMValueRef = self.retWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            self.emitRetainWitnessWalk(c: inout c, v: LLVMGetParam(fv, 0U64), sidx: sidx)
            LLVMBuildRetVoid(self.b)
            self.retWitDone += 1
        }
    }

    // Release one owner of array buffer `data` (count `count`, element type elemTy/elemRef):
    // decrement its rc, and at 0 release every element's heap (loop) then free the buffer.
    inout fn emitReleaseArrayValue(c: inout Comp, data: LLVMValueRef, count: LLVMValueRef, elemTy: LLVMTypeRef, elemRef: U64) {
        // No per-element heap to release (scalar elements): the whole decrement-and-free-
        // at-0 is exactly plew_rawbuf_drop, so emit one call instead of inlining release +
        // icmp + 2 blocks + condbr + free at every site (~8800 sites — most array releases).
        // Semantically identical; cuts ~60k IR lines. (String / Ref / struct / enum elements
        // DO need the per-element cascade below — arrElemNeedsValueArc returns true for them.)
        if !(self.arrElemNeedsValueArc(c: inout c, elemRef: elemRef)) {
            self.rawbufDrop(c: inout c, cell: data)
            return
        }
        val rc: LLVMValueRef = self.rawbufRelease(c: inout c, cell: data)
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrrel.free"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrrel.cont"))
        LLVMBuildCondBr(self.b, isZero, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        // reached only with element value-ARC (the scalar case returned above): cascade
        // into each element's heap before freeing the buffer.
        self.emitArrayElemLoop(c: inout c, data: data, count: count, elemTy: elemTy, elemRef: elemRef, retain: false)
        self.rawbufFree(c: inout c, cell: data)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
    }

    // Retain (shallow) every element of array buffer `data` — used after a CoW copy.
    inout fn emitRetainArrayElems(c: inout Comp, data: LLVMValueRef, count: LLVMValueRef, elemTy: LLVMTypeRef, elemRef: U64) {
        self.emitArrayElemLoop(c: inout c, data: data, count: count, elemTy: elemTy, elemRef: elemRef, retain: true)
    }

    // Emit `for i in 0..count() { v = data[i]; retain ? retainValue(v) : releaseValue(v) }`.
    inout fn emitArrayElemLoop(c: inout Comp, data: LLVMValueRef, count: LLVMValueRef, elemTy: LLVMTypeRef, elemRef: U64, retain: Bool) {
        val iSlot: LLVMValueRef = self.entryAlloca(ty: self.i64ty)
        LLVMBuildStore(self.b, LLVMConstInt(self.i64ty, 0U64, 0I32), iSlot)
        val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrelem.cond"))
        val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrelem.body"))
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrelem.end"))
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, condBB)
        val iv: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, iSlot, anon())
        LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntUlt(), iv, count, anon()), bodyBB, endBB)
        LLVMPositionBuilderAtEnd(self.b, bodyBB)
        val elem: LLVMValueRef = LLVMBuildLoad2(self.b, elemTy, self.arrElemPtr(elemTy: elemTy, data: data, idx: iv), anon())
        self.valueArc(c: inout c, v: elem, typeRef: elemRef, retain: retain)
        LLVMBuildStore(self.b, LLVMBuildAdd(self.b, iv, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), iSlot)
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, endBB)
    }

    // Release each element in the half-open range [start, end) of buffer `data` (used by
    // clear/truncate to drop a removed suffix). A no-op when the element type carries no
    // value-ARC. The caller must have committed the smaller count first (commit-then-release).
    inout fn emitArrayElemRangeRelease(c: inout Comp, data: LLVMValueRef, start: LLVMValueRef, end: LLVMValueRef, elemTy: LLVMTypeRef, elemRef: U64) {
        if !(self.arrElemNeedsValueArc(c: inout c, elemRef: elemRef)) {
            return
        }
        val iSlot: LLVMValueRef = self.entryAlloca(ty: self.i64ty)
        LLVMBuildStore(self.b, start, iSlot)
        val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrrng.cond"))
        val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrrng.body"))
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arrrng.end"))
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, condBB)
        val iv: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, iSlot, anon())
        LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntUlt(), iv, end, anon()), bodyBB, endBB)
        LLVMPositionBuilderAtEnd(self.b, bodyBB)
        val elem: LLVMValueRef = LLVMBuildLoad2(self.b, elemTy, self.arrElemPtr(elemTy: elemTy, data: data, idx: iv), anon())
        self.valueArc(c: inout c, v: elem, typeRef: elemRef, retain: false)
        LLVMBuildStore(self.b, LLVMBuildAdd(self.b, iv, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), iSlot)
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, endBB)
    }

    // The pointee struct index of a `Ref[T]` instance ref if T is a registered struct
    // that needs a deinit, else c.arena.structs.count().
    inout fn refDeinitPointeeSidx(c: inout Comp, refTy: U64) -> U64 {
        if c.isRefInst(ref: refTy) {
            if c.arena.types[refTy].args.count() > 0U64 {
                val pt: TypeRef = c.arena.types[c.arena.types[refTy].args[0]]
                val psi: U64 = c.structIndexByName(start: pt.nameStart, len: pt.nameLen)
                if psi < c.arena.structs.count() {
                    if self.structNeedsDeinit(c: inout c, sidx: psi) {
                        return psi
                    }
                }
            }
        }
        return c.arena.structs.count()
    }

    // Bounds-check `i` against `count` via the runtime (panics on out-of-range).
    inout fn emitBoundsCheck(c: inout Comp, idx: LLVMValueRef, count: LLVMValueRef) {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.i64ty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_bounds", nameId: 21U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(idx)
        av.append(count)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
    }

    // GEP &data[i] for element type elemTy.
    inout fn arrElemPtr(elemTy: LLVMTypeRef, data: LLVMValueRef, idx: LLVMValueRef) -> LLVMValueRef {
        mut val idxs: Array[LLVMValueRef] = []
        idxs.append(idx)
        return LLVMBuildGEP2(self.b, elemTy, data, arrayCPtr(idxs), 1U64, anon())
    }

    // Coerce an element value to the array's element type (int width only).
    inout fn coerceElem(v: LLVMValueRef, elemTy: LLVMTypeRef) -> LLVMValueRef {
        if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
            if LLVMGetTypeKind(elemTy) == 8U32 {
                return self.coerceInt(v: v, target: elemTy, unsigned: false)
            }
        }
        return v
    }
}
