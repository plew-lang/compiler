// Physical address of an enum payload. All enum layouts are registered from
// FinalDestruction as { tag: I64, payload: [word] }, regardless of genericity.
pub impl LlvmCtx {
    inout fn enumMatchPayloadStorage(scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) -> LLVMValueRef {
        return LLVMBuildStructGEP2(self.b, scrutTy, scrutSlot, 1U64, anon())
    }
}
