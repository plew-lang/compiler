// Part of the LLVM backend (root: _.pw): match-statement emission and payload / struct pattern binding.

// Lower `match scrut { Pat => block, ... }` on a registered enum: store the
// scrutinee, switch on its tag through a chain of compare/branch blocks, and in
// each arm bind the variant's payload fields (extracted from the payload area)
// before emitting its body. Exhaustiveness is guaranteed by the front-end; a
// wildcard `_` arm is the catch-all.

pub impl LlvmCtx {
    inout fn genLlvmMatch(c: inout Comp, scrut: U64, arms: Array[MatchArm]) {
        val sv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: scrut)
        val sty: LLVMTypeRef = LLVMTypeOf(sv)
        // a struct destructuring match `match s { S { val x } => … }` is irrefutable
        // (one arm, no tag): store the scrutinee, bind its fields, emit the body.
        if arms.count > 0U64 {
            if arms[0].isStruct {
                val ssidx: U64 = self.exprStructIdx(c: inout c, id: scrut)
                val savedSP: Array[Bind] = c.cur.typeParams
                val savedSA: Array[U64] = c.cur.typeArgs
                val didSetS: Bool = self.setStructEnv(c: inout c, ref: self.exprTypeRef(c: inout c, id: scrut))
                val sslot0: LLVMValueRef = self.entryAlloca(ty: sty)
                LLVMBuildStore(self.b, sv, sslot0)
                val mark0: U64 = self.nLocals
                self.bindStructPattern(c: inout c, sidx: ssidx, binds: arms[0].binds, scrutTy: sty, scrutSlot: sslot0)
                self.genLlvmBlock(c: inout c, id: arms[0].body)
                self.nLocals = mark0
                if didSetS {
                    c.cur.typeParams = savedSP
                    c.cur.typeArgs = savedSA
                }
                return
            }
        }
        // The scrutinee's enum instance ref. The enum env (for payload-type resolution)
        // is set ONLY around bindMatchPayload — NOT for the arm bodies, which must keep
        // the outer (e.g. monomorphized-method) env so a body's `self.f` / `self.inner`
        // still grounds. Saved here so each arm can set/restore around its bind.
        val scrutRef: U64 = self.exprTypeRef(c: inout c, id: scrut)
        val savedMP: Array[Bind] = c.cur.typeParams
        val savedMA: Array[U64] = c.cur.typeArgs
        // the enum: from the first non-wildcard, non-struct arm.
        mut val eid: U64 = c.arena.enums.count
        mut val ai0: U64 = 0
        while ai0 < arms.count {
            if !(arms[ai0].isWildcard) {
                if !(arms[ai0].isStruct) {
                    if eid == c.arena.enums.count {
                        eid = c.enumIdxByName(start: arms[ai0].enumStart, len: arms[ai0].enumLen)
                    }
                }
            }
            ai0 += 1
        }
        if eid >= c.arena.enums.count {
            compileErrorAt(line: 0, msg: "LLVM backend: match is only supported on a registered enum (so far)")
            return
        }
        // store the scrutinee so payload fields can be read back as a variant struct.
        val sslot: LLVMValueRef = self.entryAlloca(ty: sty)
        LLVMBuildStore(self.b, sv, sslot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, sty, sslot, 0U64, anon()), anon())
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "match.end"))
        // the tag-test chain lives in `checkBB`; each arm body lives in its own block.
        // Re-position at checkBB before every compare so emitting an arm body (which
        // moves the builder) doesn't append the next compare after a ret.
        mut val checkBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        mut val lastWasWildcard: Bool = false
        mut val anyFallthrough: Bool = false
        mut val ai: U64 = 0
        while ai < arms.count {
            val arm: MatchArm = arms[ai]
            val armBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arm"))
            LLVMPositionBuilderAtEnd(self.b, checkBB)
            if arm.isWildcard {
                LLVMBuildBr(self.b, armBB)
                lastWasWildcard = true
            } else {
                val vi: U64 = c.variantIndex(enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
                val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "match.next"))
                val eq: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon())
                LLVMBuildCondBr(self.b, eq, armBB, nextBB)
                checkBB = nextBB
                lastWasWildcard = false
            }
            // emit the arm body in armBB, with payload binds in a fresh scope.
            val savedBB: U64 = self.nLocals
            LLVMPositionBuilderAtEnd(self.b, armBB)
            self.terminated = false
            if !(arm.isWildcard) {
                // bind the payload under the enum env, then restore the outer env so the
                // arm body grounds against the enclosing method/function, not the enum.
                val didB: Bool = self.setEnumEnv(c: inout c, ref: scrutRef)
                self.bindMatchPayload(c: inout c, eid: eid, arm: arm, scrutTy: sty, scrutSlot: sslot)
                if didB {
                    c.cur.typeParams = savedMP
                    c.cur.typeArgs = savedMA
                }
            }
            self.genLlvmBlock(c: inout c, id: arm.body)
            self.nLocals = savedBB
            if !(self.terminated) {
                LLVMBuildBr(self.b, contBB)
                anyFallthrough = true
            }
            ai += 1
        }
        // close the dangling final check block (exhaustive, so unreachable) unless a
        // wildcard already terminated it.
        if !(lastWasWildcard) {
            LLVMPositionBuilderAtEnd(self.b, checkBB)
            LLVMBuildUnreachable(self.b)
        }
        // the continuation is reachable only if some arm fell through.
        LLVMPositionBuilderAtEnd(self.b, contBB)
        if anyFallthrough {
            self.terminated = false
        } else {
            LLVMBuildUnreachable(self.b)
            self.terminated = true
        }
    }

    // Bind a match arm's payload fields as locals: read the variant payload struct
    // back from the scrutinee's payload area and extractvalue each bound field.
    inout fn bindMatchPayload(c: inout Comp, eid: U64, arm: MatchArm, scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
        if arm.binds.count == 0U64 {
            return
        }
        val vi: U64 = c.variantIndex(enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi)
        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, LLVMBuildStructGEP2(self.b, scrutTy, scrutSlot, 1U64, anon()), anon())
        val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
        mut val bi: U64 = 0
        while bi < arm.binds.count {
            val b: Bind = arm.binds[bi]
            // resolve which variant field this bind reads (by field name = b.fieldStart).
            mut val fidx: U64 = fs.count
            mut val fj: U64 = 0
            while fj < fs.count {
                if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                    fidx = fj
                    fj = fs.count
                } else {
                    fj += 1
                }
            }
            if fidx < fs.count {
                val fd: FieldDef = fs[fidx]
                // an array-typed payload field (declared `Array[E]` or a type param that
                // grounds to one): the bound local is the {ptr,i64} array value, tracked
                // as an array so `v[i]` / `v.count` work in the arm body.
                val elemRef: U64 = arrayFieldElemRef(c: inout c, f: fd)
                mut val pty: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                mut val isArrF: Bool = false
                mut val elemTyF: LLVMTypeRef = self.i64ty
                mut val elemKindF: U64 = 0U64
                if elemRef != 0U64 {
                    pty = self.arrayTy
                    isArrF = true
                    elemTyF = self.llvmTypeOfRef(c: inout c, ref: elemRef)
                    val et: TypeRef = c.arena.types[elemRef]
                    elemKindF = kindFromTySpan(c: inout c, tyStart: et.nameStart, tyLen: et.nameLen)
                }
                // a generic-instance payload field (`Leaf(v: Optional[I64])`,
                // `Some(v: Box[I32])`): the stored value is the instance's named tagged-
                // union / struct type, not the head-name scalar. Resolve it (grounded under
                // the active env) so the alloca + extractvalue + a nested match agree.
                mut val genFieldRef: U64 = 0
                if elemRef == 0U64 {
                    if fd.ty != 0U64 {
                        mut val gfp: U64 = fd.ty
                        if c.cur.typeParams.count > 0U64 {
                            gfp = c.groundTypeRef(ref: fd.ty)
                        }
                        if c.isGenericInst(ref: gfp) {
                            if !(rangeEquals(bytes: c.arena.bytes, start: c.arena.types[gfp].nameStart, len: c.arena.types[gfp].nameLen, kw: "Array")) {
                                genFieldRef = gfp
                                pty = self.llvmTypeOfRef(c: inout c, ref: gfp)
                            }
                        }
                    }
                }
                // a boxed (recursive) payload field holds a heap pointer; load the boxed
                // value back. A non-boxed field is the value directly.
                mut val fv: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, fidx, anon())
                if c.fieldIsBoxed(f: fd) {
                    fv = LLVMBuildLoad2(self.b, pty, fv, anon())
                }
                // inside an async fn the bind's storage is a frame field (survives an
                // `await` inside the arm); otherwise a plain alloca.
                mut val slot: LLVMValueRef = LLVMConstNull(self.ptrty)
                if self.curAsync {
                    slot = self.asyncFrameSlot(c: inout c, idx: self.asyncFieldNext)
                    self.asyncFieldNext = self.asyncFieldNext + 1
                } else {
                    slot = self.entryAlloca(ty: pty)
                }
                LLVMBuildStore(self.b, fv, slot)
                // a scalar-array payload bind SHARES the enum's payload buffer (Stage 2a):
                // retain it so the bind co-owns the buffer (its scope-exit release then
                // balances, leaving the variant's copy intact). Without this, the bind's
                // release would free a buffer the enum still owns — a double-free.
                if isArrF {
                    if self.arrElemIsScalar(elemTy: elemTyF) {
                        self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, fv, 0U64, anon()))
                    }
                }
                // an enum-typed bind carries a bare enum TypeRef so a nested match on it
                // (the recursive case) recovers the enum (typeOf can't see this local).
                mut val tref: U64 = 0
                if self.enumRegSlot(c: inout c, start: fd.tyStart, len: fd.tyLen) < self.enumIdxs.count {
                    tref = c.simpleTypeRef(nameStart: fd.tyStart, nameLen: fd.tyLen)
                }
                // a generic-instance payload bind carries the full instance TypeRef so a
                // nested match / field access on it recovers the substitution env.
                if genFieldRef != 0U64 {
                    tref = genFieldRef
                }
                // a type-parameter payload field (`Optional.Some(v: T)`): ground T under
                // the active enum-instance env (set by the caller around bindMatchPayload)
                // so a String/Bool payload is recognized as kind 1/2, not defaulted to int
                // (which would miscompile the bound {ptr,i64} value at the arm's use site).
                mut val bindKind: U64 = kindFromTySpan(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                if fd.ty != 0U64 {
                    if c.cur.typeParams.count > 0U64 {
                        val gft: U64 = c.groundTypeRef(ref: fd.ty)
                        if gft != 0U64 {
                            bindKind = kindFromTySpan(c: inout c, tyStart: c.arena.types[gft].nameStart, tyLen: c.arena.types[gft].nameLen)
                        }
                    }
                }
                // a generic-instance payload bind (`Some(v: N[I64])` of a recursive generic):
                // its struct index is the generic struct DEF (via genStructSlot), not a
                // lookup by the un-grounded param name `fd.tyStart` (`T`), so field access
                // `v.field` in the arm body resolves.
                mut val bindStructIdx: U64 = self.localStructIdxFor(c: inout c, start: fd.tyStart, len: fd.tyLen)
                if genFieldRef != 0U64 {
                    if c.isGenericInst(ref: genFieldRef) {
                        val gbs: U64 = self.genStructSlot(c: inout c, ref: genFieldRef)
                        if gbs < self.genStructRefs.count {
                            bindStructIdx = self.genStructDefs[gbs]
                        }
                    }
                }
                self.pushLocalR(nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: pty, kind: bindKind, structIdx: bindStructIdx, isArr: isArrF, elemTy: elemTyF, elemKind: elemKindF, typeRef: tref)
                // an array-of-struct payload bind (`Expr.Call(.., val args)` with
                // args: Array[Arg]): track the element struct + ref so `args[i].field`
                // and nested-array/Ref elements resolve in the arm body.
                if isArrF {
                    if elemRef != 0U64 {
                        val et2: TypeRef = c.arena.types[elemRef]
                        val esi: U64 = self.localStructIdxFor(c: inout c, start: et2.nameStart, len: et2.nameLen)
                        if esi < c.arena.structs.count {
                            self.setLocalElemStruct(esi: esi)
                        }
                        self.setLocalElemTypeRef(ref: elemRef)
                    }
                }
            }
            bi += 1
        }
    }

    // Bind the fields of a struct destructuring pattern `S { val x, field: val y,
    // field2: _ }` (irrefutable — a struct has one shape). Each named bind reads its
    // field from the stored scrutinee, honoring array / nested-struct / type-param
    // field types (under any generic env the caller set). Discards (`_`, empty name)
    // are skipped.
    inout fn bindStructPattern(c: inout Comp, sidx: U64, binds: Array[Bind], scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
        val fs: Array[FieldDef] = c.arena.structs[sidx].fields
        mut val bi: U64 = 0
        while bi < binds.count {
            val b: Bind = binds[bi]
            if b.nameLen == 0U64 {
                bi += 1
            } else {
                // resolve which field this bind reads (by field name = b.fieldStart).
                mut val fidx: U64 = fs.count
                mut val fj: U64 = 0
                while fj < fs.count {
                    if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                        fidx = fj
                        fj = fs.count
                    } else {
                        fj += 1
                    }
                }
                if fidx < fs.count {
                    val fld: FieldDef = fs[fidx]
                    val fty: LLVMTypeRef = self.llvmTypeFor(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen, isArray: fld.tyIsArray)
                    val fv: LLVMValueRef = LLVMBuildLoad2(self.b, fty, LLVMBuildStructGEP2(self.b, scrutTy, scrutSlot, fidx, anon()), anon())
                    val slot: LLVMValueRef = self.entryAlloca(ty: fty)
                    LLVMBuildStore(self.b, fv, slot)
                    mut val elemTy: LLVMTypeRef = self.i64ty
                    mut val elemKind: U64 = 0
                    if fld.tyIsArray {
                        elemTy = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                        elemKind = kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                        // a scalar-array struct-pattern bind SHARES the scrutinee's field
                        // buffer (Stage 2a): retain so its scope-exit release balances and
                        // does not free a buffer the struct still owns (a double-free).
                        if self.arrElemIsScalar(elemTy: elemTy) {
                            self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, fv, 0U64, anon()))
                        }
                    }
                    self.pushLocal(nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: fty, kind: kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen), structIdx: self.localStructIdxFor(c: inout c, start: fld.tyStart, len: fld.tyLen), isArr: fld.tyIsArray, elemTy: elemTy, elemKind: elemKind)
                }
                bi += 1
            }
        }
    }
}
