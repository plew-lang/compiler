// Part of the LLVM backend (root: _.pw): match-statement emission and payload / struct pattern binding.

// Lower `match scrut { Pat => block, ... }` on a registered enum: store the
// scrutinee, switch on its tag through a chain of compare/branch blocks, and in
// each arm bind the variant's payload fields (extracted from the payload area)
// before emitting its body. Exhaustiveness is guaranteed by the front-end; a
// wildcard `_` arm is the catch-all.

pub impl LlvmCtx {
    // The generic-enum ABI is fixed as `{ tag: I64, payload: [word] }`.
    // Its payload is subsequently interpreted under the selected variant's
    // semantic field layout.  Address the word storage through that ABI rather
    // than re-applying a concrete struct-field projection to an opaque LLVM
    // pointer: the latter couples the place calculation to whichever
    // semantically-equal TypeRef happened to register the named layout.
    inout fn enumMatchPayloadStorage(c: inout Comp, scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef, instanceRef: U64) -> LLVMValueRef {
        if c.isGenericEnumInst(ref: instanceRef) {
            mut val wordIndex: Array[LLVMValueRef] = []
            wordIndex.append(LLVMConstInt(self.i64ty, 1U64, 0I32))
            return LLVMBuildGEP2(self.b, self.i64ty, scrutSlot, arrayCPtr(wordIndex), 1U64, anon())
        }
        return LLVMBuildStructGEP2(self.b, scrutTy, scrutSlot, 1U64, anon())
    }

    inout fn genLlvmMatch(c: inout Comp, scrut: U64, arms: MatchArmRange) {
        val consuming: Bool = c.matchScrutIsMove(scrut: scrut)
        val sv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: scrut)
        val sty: LLVMTypeRef = LLVMTypeOf(sv)
        // a struct destructuring match `match s { S { val x } => … }` is irrefutable
        // (one arm, no tag): store the scrutinee, bind its fields, emit the body.
        if arms.len > 0U64 {
            val firstArm: MatchArm = c.matchArmAt(arms: arms, index: 0U64)
            if firstArm.isStruct {
                val ssidx: U64 = self.exprStructIdx(c: inout c, id: scrut)
                val structScrutRef: U64 = self.exprTypeRef(c: inout c, id: scrut)
                val savedSP: Array[Bind] = c.cur.typeParams
                val savedSA: Array[U64] = c.cur.typeArgs
                val didSetS: Bool = self.setStructEnv(c: inout c, ref: structScrutRef)
                val sslot0: LLVMValueRef = self.entryAlloca(ty: sty)
                LLVMBuildStore(self.b, sv, sslot0)
                // an owned struct-scrutinee temp (a call/construction result, not a place):
                // register it so its heap (array / Ref / String / sub-struct fields) is
                // released once — via dropScope on a return/break arm, or explicitly on
                // fall-through below. A place scrutinee is owned by its local/field elsewhere.
                val sStructSentinel: U64 = 18446744073709551615U64
                mut val sStructTempLi: U64 = sStructSentinel
                if !(exprAliasesPlace(c: inout c, id: scrut)) {
                    self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: sslot0, ty: sty, kind: 0U64, structIdx: ssidx, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: structScrutRef)
                    sStructTempLi = self.nLocals - 1U64
                }
                val mark0: U64 = self.nLocals
                self.bindStructPattern(c: inout c, sidx: ssidx, binds: firstArm.binds, scrutTy: sty, scrutSlot: sslot0)
                self.genLlvmBlock(c: inout c, id: firstArm.body)
                // release the retained field binds on fall-through (they co-own the
                // scrutinee's heap; a return inside the body dropped them via its
                // unwind) before popping them off the stack.
                if !(self.terminated) {
                    self.dropScope(c: inout c, fromMark: mark0, excludeLi: sStructSentinel)
                }
                self.nLocals = mark0
                if didSetS {
                    c.cur.typeParams = savedSP
                    c.cur.typeArgs = savedSA
                }
                if sStructTempLi != sStructSentinel {
                    if !(self.terminated) {
                        self.emitDeinitCall(c: inout c, li: sStructTempLi)
                    }
                    self.nLocals = sStructTempLi
                }
                return
            }
        }
        // The scrutinee's enum instance ref. The enum env (for payload-type resolution)
        // is set ONLY around bindMatchPayload — NOT for the arm bodies, which must keep
        // the outer (e.g. monomorphized-method) env so a body's `self.f` / `self.inner`
        // still grounds. Saved here so each arm can set/restore around its bind.
        val scrutRef: U64 = self.exprTypeRef(c: inout c, id: scrut)
        // Semantic TypeRefs may be reconstructed at distinct source sites while
        // denoting the same instance.  The stored LLVM value, however, has one
        // concrete registered layout.  Payload reads must use that layout's
        // instance ref so its field substitution and its `{tag, words}` shape
        // are derived from the same key; a merely equivalent ref can carry a
        // different legacy binder spelling.
        mut val scrutLayoutRef: U64 = scrutRef
        val scrutReg: U64 = self.genEnumSlot(c: inout c, ref: scrutRef)
        if scrutReg < self.genEnumRefs.count() {
            scrutLayoutRef = self.genEnumRefs[scrutReg]
        }
        val savedMP: Array[Bind] = c.cur.typeParams
        val savedMA: Array[U64] = c.cur.typeArgs
        // the enum: from the first non-wildcard, non-struct arm.
        mut val eid: U64 = c.arena.enums.count()
        mut val ai0: U64 = 0
        while ai0 < arms.len {
            val arm: MatchArm = c.matchArmAt(arms: arms, index: ai0)
            if !(arm.isWildcard) {
                if !(arm.isStruct) {
                    if eid == c.arena.enums.count() {
                        eid = c.enumIdxByName(start: arm.enumStart, len: arm.enumLen)
                    }
                }
            }
            ai0 += 1
        }
        if eid >= c.arena.enums.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: match is only supported on a registered enum (so far)")
            return
        }
        // store the scrutinee so payload fields can be read back as a variant struct.
        val sslot: LLVMValueRef = self.entryAlloca(ty: sty)
        LLVMBuildStore(self.b, sv, sslot)
        // If the scrutinee is an owned temporary (a call/construction result, not a place),
        // the match is its only owner. Register it as an anonymous owned enum local so it is
        // released on EVERY exit path: a `return`/`break` inside an arm drops it via
        // dropScope, and fall-through drops it explicitly at contBB below. Its payload binds
        // borrow it (bindMatchPayload marks them not-owned), so this is the single release of
        // the matched temp's payload heap (e.g. the strong owner a directly-matched
        // `w.upgrade()` holds — otherwise that strong leaks). A place scrutinee is skipped:
        // its real owner (the local/field) releases it at its own scope.
        val scrutSentinel: U64 = 18446744073709551615U64
        mut val scrutTempLi: U64 = scrutSentinel
        if !(exprAliasesPlace(c: inout c, id: scrut)) {
            self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: sslot, ty: sty, kind: 0U64, structIdx: scrutSentinel, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: scrutRef)
            scrutTempLi = self.nLocals - 1U64
            if consuming {
                self.locMoved[scrutTempLi] = true
            }
        }
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, sty, sslot, 0U64, anon()), anon())
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "match.end"))
        // the tag-test chain lives in `checkBB`; each arm body lives in its own block.
        // Re-position at checkBB before every compare so emitting an arm body (which
        // moves the builder) doesn't append the next compare after a ret.
        mut val checkBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        mut val lastWasWildcard: Bool = false
        mut val anyFallthrough: Bool = false
        mut val ai: U64 = 0
        while ai < arms.len {
            val arm: MatchArm = c.matchArmAt(arms: arms, index: ai)
            val armBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "arm"))
            LLVMPositionBuilderAtEnd(self.b, checkBB)
            if arm.isWildcard {
                LLVMBuildBr(self.b, armBB)
                lastWasWildcard = true
            } else {
                val vi: U64 = c.variantIndex(enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
                val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "match.next"))
                val eq: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon())
                LLVMBuildCondBr(self.b, eq, armBB, nextBB)
                checkBB = nextBB
                lastWasWildcard = false
            }
            // emit the arm body in armBB, with payload binds in a fresh scope.
            val savedBB: U64 = self.nLocals
            LLVMPositionBuilderAtEnd(self.b, armBB)
            self.terminated = false
            if arm.isWildcard {
                if consuming {
                    self.emitEnumRelease(c: inout c, v: LLVMBuildLoad2(self.b, sty, sslot, anon()), eid: eid, ety: sty)
                }
            } else {
                // bind the payload under the enum env, then restore the outer env so the
                // arm body grounds against the enclosing method/function, not the enum.
                val didB: Bool = self.setEnumEnv(c: inout c, ref: scrutRef)
                self.bindMatchPayload(c: inout c, eid: eid, arm: arm, scrutTy: sty, scrutSlot: sslot, instanceRef: scrutLayoutRef, consuming: consuming)
                if didB {
                    c.cur.typeParams = savedMP
                    c.cur.typeArgs = savedMA
                }
            }
            self.genLlvmBlock(c: inout c, id: arm.body)
            if consuming {
                if !(self.terminated) {
                    self.dropScope(c: inout c, fromMark: savedBB, excludeLi: scrutSentinel)
                }
            }
            // Non-consuming payload binds borrow the scrutinee's heap and skip
            // scope-exit release. Consuming payload binds are owned and were dropped
            // above on fall-through; moved-out binds are skipped by locMoved.
            self.nLocals = savedBB
            if !(self.terminated) {
                LLVMBuildBr(self.b, contBB)
                anyFallthrough = true
            }
            ai += 1
        }
        // close the dangling final check block (exhaustive, so unreachable) unless a
        // wildcard already terminated it.
        if !(lastWasWildcard) {
            LLVMPositionBuilderAtEnd(self.b, checkBB)
            LLVMBuildUnreachable(self.b)
        }
        // the continuation is reachable only if some arm fell through.
        LLVMPositionBuilderAtEnd(self.b, contBB)
        if anyFallthrough {
            self.terminated = false
            // release the owned scrutinee temp on the fall-through path (return/break arms
            // already dropped it via dropScope). Drop BEFORE popping it off the env.
            if scrutTempLi != scrutSentinel {
                self.emitDeinitCall(c: inout c, li: scrutTempLi)
            }
        } else {
            LLVMBuildUnreachable(self.b)
            self.terminated = true
        }
        if scrutTempLi != scrutSentinel {
            self.nLocals = scrutTempLi
        }
    }

    // Bind a match arm's payload fields as locals: read the variant payload struct
    // back from the scrutinee's payload area and extractvalue each bound field.
    inout fn releasePayloadFieldValue(c: inout Comp, fd: FieldDef, fv: LLVMValueRef) {
        if c.fieldIsBoxed(f: fd) {
            self.emitBoxedFieldRelease(c: inout c, cell: fv, f: fd)
            return
        }
        if fd.tyIsArray {
            val er: U64 = arrayFieldElemRef(c: inout c, f: fd)
            mut val ety: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
            if er != 0U64 {
                ety = self.llvmTypeOfRef(c: inout c, ref: er)
            }
            self.emitReleaseArrayValue(c: inout c, data: self.arrValData(c: inout c, arr: fv), count: self.arrValCount(c: inout c, arr: fv), elemTy: ety, elemRef: er)
            return
        }
        val g: U64 = c.arcFieldTy(f: fd)
        if c.arcNeedsRelease(ref: g) {
            self.valueArc(c: inout c, v: fv, typeRef: g, retain: false)
        }
    }

    inout fn bindMatchPayload(c: inout Comp, eid: U64, arm: MatchArm, scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef, instanceRef: U64, consuming: Bool) {
        if arm.binds.len == 0U64 {
            if consuming {
                self.emitEnumRelease(c: inout c, v: LLVMBuildLoad2(self.b, scrutTy, scrutSlot, anon()), eid: eid, ety: scrutTy)
            }
            return
        }
        val vi: U64 = c.variantIndex(enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
        // The payload layout is determined by the matched enum instance, not
        // by the mutable body environment.  Passing the selected TypeRef makes
        // `Optional[any P]` ground its `T` field to the two-word existential
        // representation even while the arm body later restores its outer
        // environment.  This is the same instance-local rule used by enum
        // construction and release.
        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eid, vi: vi, instanceRef: instanceRef)
        val payloadStorage: LLVMValueRef = self.enumMatchPayloadStorage(c: inout c, scrutTy: scrutTy, scrutSlot: scrutSlot, instanceRef: instanceRef)
        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, payloadStorage, anon())
        val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
        mut val bi: U64 = 0
        while bi < arm.binds.len {
            val b: Bind = c.bindAt(binds: arm.binds, index: bi)
            // resolve which variant field this bind reads (by field name = b.fieldStart).
            mut val fidx: U64 = fs.count()
            mut val fj: U64 = 0
            while fj < fs.count() {
                if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                    fidx = fj
                    fj = fs.count()
                } else {
                    fj += 1
                }
            }
            if fidx < fs.count() {
                val fd: FieldDef = fs[fidx]
                // The field's representation is determined by the selected
                // enum instance.  Do not classify its declaration spelling
                // (`T`) through the ambient LLVM environment: a trait named
                // `T` and Optional's declaration binder `T` are distinct
                // semantic terms.  `fieldTerm` is the one ground term used by
                // every payload-bind decision below.
                mut val fieldTerm: U64 = fd.ty
                if fieldTerm != 0U64 {
                    fieldTerm = c.groundTypeRef(ref: fieldTerm)
                }
                // an array-typed payload field (declared `Array[E]` or a type param that
                // grounds to one): the bound local is the {ptr,i64} array value, tracked
                // as an array so `v[i]` / `v.count()` work in the arm body.
                val elemRef: U64 = arrayFieldElemRef(c: inout c, f: fd)
                mut val pty: LLVMTypeRef = self.i64ty
                if fieldTerm != 0U64 {
                    pty = self.llvmTypeOfRef(c: inout c, ref: fieldTerm)
                } else {
                    // Legacy FieldDefs without a TypeRef can only use the
                    // spelling fallback; lowered semantic fields always take
                    // the exact-term branch above.
                    pty = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                }
                mut val isArrF: Bool = false
                mut val elemTyF: LLVMTypeRef = self.i64ty
                mut val elemKindF: U64 = 0U64
                if elemRef != 0U64 {
                    pty = self.arrayInstTy(c: inout c, elemRef: elemRef)
                    isArrF = true
                    elemTyF = self.llvmTypeOfRef(c: inout c, ref: elemRef)
                    val et: TypeRef = c.arena.types[elemRef]
                    elemKindF = kindFromTySpan(c: inout c, tyStart: et.nameStart, tyLen: et.nameLen)
                }
                // a generic-instance payload field (`Leaf(v: Optional[I64])`,
                // `Some(v: Box[I32])`): the stored value is the instance's named tagged-
                // union / struct type, not the head-name scalar. Resolve it (grounded under
                // the active env) so the alloca + extractvalue + a nested match agree.
                mut val genFieldRef: U64 = 0
                if elemRef == 0U64 {
                    if fieldTerm != 0U64 {
                        val gfp: U64 = fieldTerm
                        // an existential `any P` payload (`Wrap(v: any Shape)`, or a type
                        // param bound to one): the stored value is the fat pointer (anyTy,
                        // 2 words). Carry the `any` TypeRef as the bind's ref so a method
                        // call on it dynamically dispatches (spec/08) — else the bind is
                        // typed i64 (llvmScalarTy on the trait name), the fat pointer is
                        // truncated on store, and dispatch reads a null receiver.
                        if refIsAny(c: inout c, ref: gfp) {
                            genFieldRef = gfp
                            pty = self.anyTy
                        }
                        if c.isGenericInst(ref: gfp) {
                            if !(rangeEquals(bytes: c.arena.bytes, start: c.arena.types[gfp].nameStart, len: c.arena.types[gfp].nameLen, kw: "Array")) {
                                genFieldRef = gfp
                                pty = self.llvmTypeOfRef(c: inout c, ref: gfp)
                            }
                        }
                        // a reference-cell payload (e.g. `Optional[Ref[T]]` from
                        // `WeakRef.upgrade`): track the opaque instance so the bind's `s->field`
                        // deref / `s.weak()` dispatch resolve (Ref/WeakRef aren't generic insts).
                        if c.isStrongRefInst(ref: gfp) || c.isWeakRefLikeInst(ref: gfp) {
                            genFieldRef = gfp
                            pty = self.llvmTypeOfRef(c: inout c, ref: gfp)
                        }
                    }
                }
                // a boxed (recursive) payload field holds a heap pointer; load the boxed
                // value back. A non-boxed field is the value directly.
                val rawFv: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, fidx, anon())
                mut val fv: LLVMValueRef = rawFv
                if c.fieldIsBoxed(f: fd) {
                    fv = LLVMBuildLoad2(self.b, pty, fv, anon())
                }
                if b.nameLen == 0U64 {
                    if consuming {
                        self.releasePayloadFieldValue(c: inout c, fd: fd, fv: rawFv)
                    }
                    bi += 1
                    continue
                }
                // inside an async fn the bind's storage is a frame field (survives an
                // `await` inside the arm); otherwise a plain alloca.
                mut val slot: LLVMValueRef = LLVMConstNull(self.ptrty)
                if self.curAsync {
                    slot = self.asyncFrameSlot(c: inout c, idx: self.asyncFieldNext)
                    self.asyncFieldNext = self.asyncFieldNext + 1
                } else {
                    slot = self.entryAlloca(ty: pty)
                }
                LLVMBuildStore(self.b, fv, slot)
                // A payload bind BORROWS the scrutinee's heap: it is immutable (the parser
                // never produces a `mut` pattern bind — spec/11 binds are read-only here), so
                // it can neither mutate in place (no CoW privatization) nor be moved out. Any
                // escape (let/return/give/store/by-value arg) retains/copies at the
                // destination, so the bind itself needs no retain — and is marked not-owned
                // below so no scope-exit release runs. This keeps the refcount neutral while
                // removing a retain + a release per bind (the dominant ARC cost in plewc).
                // an enum-typed bind carries a bare enum TypeRef so a nested match on it
                // (the recursive case) recovers the enum (typeOf can't see this local). Skip
                // for an array field (`elems: Array[E]`): there fd.tyStart/tyLen names the
                // ELEMENT (`E`), so this would wrongly type the array bind as the element enum
                // — the bind is an array, tracked via locElemTypeRef (set below), and its
                // locTypeRef must stay 0 so a `.count()`/index over it routes the array path.
                mut val tref: U64 = 0
                if !(isArrF) {
                    // declaration test (concreteEnumIdxByName), not the registered
                    // instances — registration is demand-driven, so a match emitted
                    // before any OTHER construction of the payload enum would leave the
                    // bind ref-less (the nested match then fails to recover the enum).
                    // Mirrors bindOneParam.
                    if c.concreteEnumIdxByName(start: fd.tyStart, len: fd.tyLen) < c.arena.enums.count() {
                        tref = c.simpleTypeRef(nameStart: fd.tyStart, nameLen: fd.tyLen)
                    }
                }
                // a generic-instance payload bind carries the full instance TypeRef so a
                // nested match / field access on it recovers the substitution env.
                if genFieldRef != 0U64 {
                    tref = genFieldRef
                }
                // a scalar / newtype-over-scalar payload bind (`Some(v: I32)`, or `Some(v: T)`
                // with T grounded to a concrete int / float / Bool): track its grounded type
                // name so exprTypeRef recovers it — a `print(x)` on the bind then infers T from
                // the backend's own tracking (its intended source), instead of falling back to
                // the front-end typeOf, which recurses on a nested-generic scrutinee. Mirrors
                // bindOneParam's grounded-scalar param tracking. (String needs no entry: it is
                // a registered struct, so exprStructIdx already recovers a String bind.)
                if tref == 0U64 {
                    if !(isArrF) {
                        mut val gns: U64 = fd.tyStart
                        mut val gnl: U64 = fd.tyLen
                        if fieldTerm != 0U64 {
                            gns = c.arena.types[fieldTerm].nameStart
                            gnl = c.arena.types[fieldTerm].nameLen
                        }
                        val gnu: Bind = c.newtypeUnderName(start: gns, len: gnl)
                        if isPrimIntName(c: inout c, start: gnu.nameStart, len: gnu.nameLen) {
                            tref = c.simpleTypeRef(nameStart: gns, nameLen: gnl)
                        }
                        if c.isFloatType(start: gnu.nameStart, len: gnu.nameLen) {
                            tref = c.simpleTypeRef(nameStart: gns, nameLen: gnl)
                        }
                        if rangeEquals(bytes: c.arena.bytes, start: gnu.nameStart, len: gnu.nameLen, kw: "Bool") {
                            tref = c.simpleTypeRef(nameStart: gns, nameLen: gnl)
                        }
                        // TOTAL-REF: a bare (non-generic) registered-struct payload bind
                        // (`TopItemAst.Import(val imp)` with imp: ImportAst, or a String bind).
                        // Formerly left 0 (recovered via bindStructIdx classifier — the dominant
                        // Ident gap, as match-arm binds pervade the compiler). Track the struct's
                        // TypeRef so exprTypeRef recovers it and the struct-idx derives from it.
                        if tref == 0U64 {
                            if self.localStructIdxFor(c: inout c, start: gns, len: gnl) < c.arena.structs.count() {
                                tref = c.simpleTypeRef(nameStart: gns, nameLen: gnl)
                            }
                        }
                    }
                }
                // a type-parameter payload field (`Optional.Some(v: T)`): ground T under
                // the active enum-instance env (set by the caller around bindMatchPayload)
                // so a String/Bool payload is recognized as kind 1/2, not defaulted to int
                // (which would miscompile the bound {ptr,i64} value at the arm's use site).
                mut val bindKind: U64 = kindFromTySpan(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                if fieldTerm != 0U64 {
                    bindKind = kindFromTySpan(c: inout c, tyStart: c.arena.types[fieldTerm].nameStart, tyLen: c.arena.types[fieldTerm].nameLen)
                }
                // a generic-instance payload bind (`Some(v: N[I64])` of a recursive generic):
                // its struct index is the generic struct DEF (via genStructSlot), not a
                // lookup by the un-grounded param name `fd.tyStart` (`T`), so field access
                // `v.field` in the arm body resolves.
                mut val bindStructIdx: U64 = c.arena.structs.count()
                if fieldTerm != 0U64 {
                    bindStructIdx = self.structIdxOfRef(c: inout c, ref: fieldTerm)
                }
                if genFieldRef != 0U64 {
                    if c.isGenericInst(ref: genFieldRef) {
                        val gbs: U64 = self.genStructSlot(c: inout c, ref: genFieldRef)
                        if gbs < self.genStructRefs.count() {
                            bindStructIdx = self.genStructDefs[gbs]
                        }
                    }
                }
                // E3 step (a): an array payload bind (`Tagged(val tags)` with tags: Array[E])
                // is a generic-struct value `Array[E]` over Array's arena def, so a use in the
                // arm resolves through the uniform generic path (drops exprIsArray dispatch).
                if isArrF {
                    if elemRef != 0U64 {
                        val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
                        mut val aargs: Array[U64] = []
                        aargs.append(elemRef)
                        tref = c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                        bindStructIdx = c.structDefByNameAny(start: ab.nameStart, len: 5U64)
                    }
                }
                // A non-array heap payload bind (String / struct / enum) also borrows — see
                // the array note above; no retain, marked not-owned, escapes copy at the dest.
                self.pushLocalR(nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: pty, kind: bindKind, structIdx: bindStructIdx, isArr: isArrF, elemTy: elemTyF, elemKind: elemKindF, typeRef: tref)
                // A normal match bind borrows the scrutinee's still-owned payload. A
                // consuming match has moved the enum owner into this arm, so the bind
                // becomes the new owner and will be dropped by the arm scope.
                self.setLocalOwned(owned: consuming)
                // an array payload bind (`Expr.Call(.., val args)` with args: Array[Arg]):
                // track the element ref so nested-array/Ref elements resolve in the arm body.
                if isArrF {
                    if elemRef != 0U64 {
                        self.setLocalElemTypeRef(ref: elemRef)
                    }
                }
            }
            bi += 1
        }
    }

    // Bind the fields of a struct destructuring pattern `S { val x, field: val y,
    // field2: _ }` (irrefutable — a struct has one shape). Each named bind reads its
    // field from the stored scrutinee, honoring array / nested-struct / type-param
    // field types (under any generic env the caller set). Discards (`_`, empty name)
    // are skipped.
    inout fn bindStructPattern(c: inout Comp, sidx: U64, binds: BindRange, scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
        val fs: Array[FieldDef] = c.arena.structs[sidx].fields
        mut val bi: U64 = 0
        while bi < binds.len {
            val b: Bind = c.bindAt(binds: binds, index: bi)
            if b.nameLen == 0U64 {
                bi += 1
            } else {
                // resolve which field this bind reads (by field name = b.fieldStart).
                mut val fidx: U64 = fs.count()
                mut val fj: U64 = 0
                while fj < fs.count() {
                    if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                        fidx = fj
                        fj = fs.count()
                    } else {
                        fj += 1
                    }
                }
                if fidx < fs.count() {
                    val fld: FieldDef = fs[fidx]
                    val fty: LLVMTypeRef = self.llvmTypeFor(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen, isArray: fld.tyIsArray)
                    val fv: LLVMValueRef = LLVMBuildLoad2(self.b, fty, LLVMBuildStructGEP2(self.b, scrutTy, scrutSlot, fidx, anon()), anon())
                    val slot: LLVMValueRef = self.entryAlloca(ty: fty)
                    LLVMBuildStore(self.b, fv, slot)
                    mut val elemTy: LLVMTypeRef = self.i64ty
                    mut val elemKind: U64 = 0
                    if fld.tyIsArray {
                        elemTy = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                        elemKind = kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                        // an array struct-pattern bind SHARES the scrutinee's field buffer:
                        // retain so its scope-exit release balances and does not free a
                        // buffer the struct still owns (a double-free).
                        self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: fv))
                    }
                    // E3 step (a): an array field bind (`Outer { val items }` with
                    // items: Array[E]) is a generic-struct value `Array[E]` over Array's arena
                    // def, so its struct index is Array (not the element's), letting a use in
                    // the arm resolve through the uniform generic path (drops exprIsArray).
                    mut val bindSidx: U64 = self.localStructIdxFor(c: inout c, start: fld.tyStart, len: fld.tyLen)
                    if fld.tyIsArray {
                        bindSidx = c.structDefByNameAny(start: c.kwSpan(kw: "Array", kwLen: 5U64).nameStart, len: 5U64)
                    }
                    self.pushLocal(nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: fty, kind: kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen), structIdx: bindSidx, isArr: fld.tyIsArray, elemTy: elemTy, elemKind: elemKind)
                    // track the element TypeRef and the `Array[E]` ref so a later
                    // `items.count()`/`items[i]` resolves (ground under the scrutinee's env).
                    if fld.tyIsArray {
                        val fer: U64 = arrayFieldElemRef(c: inout c, f: fld)
                        if fer != 0U64 {
                            self.setLocalElemTypeRef(ref: fer)
                            val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
                            mut val aargs: Array[U64] = []
                            aargs.append(fer)
                            self.setLocalTypeRef(ref: c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />))
                        }
                    }
                    // TOTAL-REF: a non-array struct-pattern field bind (`Outer { val inner }` with
                    // inner: Inner, or a generic-instance field) carries its (grounded) TypeRef so
                    // exprTypeRef recovers it — mirrors the array branch above (setLocalTypeRef).
                    if !(fld.tyIsArray) {
                        mut val bindTref: U64 = 0
                        if fld.ty != 0U64 {
                            mut val g: U64 = fld.ty
                            if c.cur.typeParams.count() > 0U64 {
                                g = c.groundTypeRef(ref: fld.ty)
                            }
                            bindTref = g
                        }
                        if bindTref == 0U64 {
                            bindTref = self.structFallbackRef(c: inout c, tr: 0U64, si: bindSidx)
                        }
                        if bindTref != 0U64 {
                            self.setLocalTypeRef(ref: bindTref)
                            // a heap-carrying field bind (String / Ref / nested struct /
                            // enum / any) is a fresh VALUE COPY sharing the field's heap:
                            // retain it so the bind's scope-exit release (classifier-routed
                            // via the typeRef just set) balances — mirrors the array
                            // branch's rawbufRetain above. Without this the bind's drop and
                            // the scrutinee owner's drop double-release the shared heap.
                            if c.arcNeedsRelease(ref: bindTref) {
                                self.valueArc(c: inout c, v: fv, typeRef: bindTref, retain: true)
                            }
                        }
                    }
                }
                bi += 1
            }
        }
    }
}
