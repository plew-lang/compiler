// Part of the LLVM backend (root: _.pw): generic-method call emission and argument binding.

// Emit a call to a monomorphized generic method (slot in st.genMeth*). The self
// value is built in the caller's context; the call arguments are built under the
// receiver's substitution env (so a `fallback: T` arg coerces to the instance's
// concrete type).
// Dispatch a call to a method with its OWN type params (`absorb[S]…`). Mono has
// already selected and grounded the complete callable; LLVM consumes that
// BodyInstance without re-inferring a receiver/method-argument split.

pub impl LlvmCtx {

    // Shared by source and canonical callers. Both inputs are evaluated,
    // retained cells; this helper never recovers source expressions.
    inout fn emitInoutCellCheck(c: inout Comp, cell: LLVMValueRef, otherCell: LLVMValueRef, hasReadBorrow: Bool = false) -> Result[(), CompileDiagnostic] {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
        mut val name = "plew_inout_overlap"
        if hasReadBorrow { name = "plew_read_inout_overlap" }
        val callee: LLVMValueRef = (try self.getOrDeclare(c: inout c, name: name, fnTy: fty))
        mut val cav: Array[LLVMValueRef] = []
        cav.append(cell)
        cav.append(otherCell)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(cav), 2U64, anon())
        return <Result.Ok value=() />
    }
}

pub impl LlvmCtx {

    // Index into st.fn* for a cached user function (by c.arena.funcs index), or st.fnIdx.count().
    inout fn userFnSlot(idx: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.fnIdx.count() {
            if self.fnIdx[i] == idx {
                return i
            }
            i += 1
        }
        return self.fnIdx.count()
    }

    // Resolve a free-function LLVM slot from the body id selected by frontend finalization.
    // Declarations are all created before body emission, so this is a pure frozen-table lookup:
    // LLVM cannot fabricate a body from a source function plus guessed substitutions.
    inout fn ensureFinalGenFnBody(c: inout Comp, bodyId: U64) -> Result[U64, CompileDiagnostic] {
        if c.traceCodegen {
            eprint(text: "[trace-codegen] frozen free body request id=")
            self.traceCodegenU64(n: bodyId)
            eprint(text: "\n")
        }
        val existing: U64 = genFnSlotForBody(bodyId: bodyId, st: inout self)
        if existing < self.genFnK.count() {
            if c.traceCodegen {
                eprint(text: "[trace-codegen] frozen free body slot=")
                self.traceCodegenU64(n: existing)
                eprint(text: "\n")
            }
            return <Result.Ok value=existing />
        }
        return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: frontend finalization did not declare the selected free-function body") />
    }
}
