// Part of the LLVM backend (root: _.pw): generic-method call emission and argument binding.

// Emit a call to a monomorphized generic method (slot in st.genMeth*). The self
// value is built in the caller's context; the call arguments are built under the
// receiver's substitution env (so a `fallback: T` arg coerces to the instance's
// concrete type).
// Dispatch a call to a method with its OWN type params (`absorb[S]…`): infer the
// method type args from the call, monomorphize keyed by a pseudo instance ref
// (receiver name + the inferred args), and call. Returns a null sentinel if the
// args can't be inferred / the instance can't be declared.

pub impl LlvmCtx {
    inout fn genMethodOwnTypeParamCall(c: inout Comp, recv: U64, mfi: U64, recvStart: U64, recvLen: U64, args: Array[Arg]) -> LLVMValueRef {
        val mf: Func = c.arena.funcs[mfi]
        val margs: Array[U64] = self.llvmInferFnArgs(c: inout c, f: mf, args: args)
        mut val mi: U64 = 0
        while mi < margs.count() {
            if margs[mi] == 0U64 {
                return LLVMConstNull(self.ptrty)
            }
            mi += 1
        }
        // a pseudo instance ref: the receiver type name + the method type args, so the
        // body emits with curTypeParams = mf.typeParams -> curTypeArgs = margs while the
        // self type still resolves from the receiver name.
        val pinst: U64 = c.pushType(t: <TypeRef nameStart=recvStart nameLen=recvLen args=margs />)
        val gslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: mfi, instRef: pinst, ownArgs: [])
        if gslot < self.genMethK.count() {
            return self.genGenMethodCall(c: inout c, recv: recv, mfi: mfi, slot: gslot, instRef: pinst, args: args)
        }
        return LLVMConstNull(self.ptrty)
    }
}

pub impl LlvmCtx {

    inout fn genGenMethodCall(c: inout Comp, recv: U64, mfi: U64, slot: U64, instRef: U64, args: Array[Arg]) -> LLVMValueRef {
        val mf: Func = c.arena.funcs[mfi]
        val pinMark: U64 = self.pinCells.count()
        mut val av: Array[LLVMValueRef] = []
        if mf.selfInout {
            av.append(self.placePtrOfWritePinned(c: inout c, id: recv))
        } else {
            av.append(self.genLlvmExpr(c: inout c, id: recv))
        }
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        // MERGE the callee's substitution env ON TOP of the caller's (concat: callee
        // params/args first, caller's as the base). The arguments must coerce to the
        // callee's concrete param types (a `fallback: T` arg → the receiver's instance
        // type), so the callee env must be present — but an argument EXPRESSION still
        // belongs to the caller's scope, so a construction from the caller's own type
        // params (`xs.append(<Entry[K,V] …/>)` with K,V the enclosing method's) must also
        // ground. Keeping both (callee shadows on name clash) satisfies both, mirroring
        // genLlvmMakeEnum's merge. Pure callee env (the prior code) dropped the caller's,
        // leaving such a construction an ungrounded template.
        c.cur.typeParams = concatParams(add: mf.typeParams, base: savedP)
        c.cur.typeArgs = concatArgs(add: concatArgs(add: c.arena.types[instRef].args, base: self.genMethOwn[slot]), base: savedA)
        // bind Self/Item for an own-param provided call so an argument typed by `Item`
        // coerces against the receiver's real item type (see emitOneGenMethod).
        val sGs: U64 = c.cur.selfRef
        val sGi: U64 = c.cur.itemRef
        if mf.isProvided {
            c.setSelfItemEnv(recvStart: c.arena.types[instRef].nameStart, recvLen: c.arena.types[instRef].nameLen, recvInstRef: instRef)
        }
        mut val ai: U64 = 0
        while ai < args.count() {
            av.append(self.genArgValue(c: inout c, argExpr: args[ai].expr, p: mf.params[ai]))
            ai += 1
        }
        mut val di: U64 = args.count()
        while di < mf.params.count() {
            av.append(self.genArgValue(c: inout c, argExpr: mf.params[di].defaultExpr, p: mf.params[di]))
            di += 1
        }
        c.cur.selfRef = sGs
        c.cur.itemRef = sGi
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.emitInoutOverlapChecks(c: inout c, f: mf, av: av, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: pinMark)
        val rv: LLVMValueRef = LLVMBuildCall2(self.b, self.genMethTy[slot], self.genMethVal[slot], arrayCPtr(av), av.count(), anon())
        self.releaseInoutPins(c: inout c, mark: pinMark)
        return rv
    }

    // The address of an addressable place (a struct local), for `inout` self. Falls
    // back to a fresh alloca holding the value for a non-place receiver.
    // The LLVM struct type of a struct-valued expression `structExpr` (def `sidx`):
    // its generic instance type if it carries one, else the registered non-generic
    // type. LLVMConstNull(ptr) if neither (so the caller can fall back / error).
    inout fn structLlvmTyOfExpr(c: inout Comp, structExpr: U64, sidx: U64) -> LLVMTypeRef {
        val ref: U64 = self.exprTypeRef(c: inout c, id: structExpr)
        if ref != 0U64 {
            if c.isGenericInst(ref: ref) {
                val gs: U64 = self.genStructSlot(c: inout c, ref: ref)
                if gs < self.genStructRefs.count() {
                    return self.genStructTys[gs]
                }
            }
        }
        val reg: U64 = self.structRegSlot(c: inout c, start: c.arena.structs[sidx].nameStart, len: c.arena.structs[sidx].nameLen)
        if reg < self.genStructRefs.count() {
            return self.genStructTys[reg]
        }
        return LLVMConstNull(self.ptrty)
    }

    // Pointer to an addressable PLACE expression (lvalue), or a null constant if `id`
    // is not a place. Recurses through nested field/element access so a deep place
    // like `c.arena.items` (a field of a field) yields a real pointer into the
    // original storage — what `inout`, array `.append`, `.set`, and index-assign all
    // need to write through (a non-recursive one-level scheme would copy instead).
    inout fn placePtrStrict(c: inout Comp, id: U64) -> LLVMValueRef {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    return self.locPtr[li]
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                // fast path: the base is an addressable local. Use ITS tracked LLVM type
                // (so a generic-struct local's field GEPs with the right instance type).
                match c.arena.exprs[base] {
                    Expr.Ident(start: val bs, len: val bl) => {
                        val bli: U64 = self.findLocal(c: inout c, start: bs, len: bl)
                        val bsi: U64 = self.exprStructIdx(c: inout c, id: base)
                        if bli < self.nLocals && bsi < c.arena.structs.count() {
                            val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: nameStart, len: nameLen)
                            if fidx < c.arena.structs[bsi].fields.count() {
                                return LLVMBuildStructGEP2(self.b, self.locTy[bli], self.locPtr[bli], fidx, anon())
                            }
                        }
                    }
                    _ => {}
                }
                // recursive path: the base is itself a place (nested field / element).
                // Pointer to the base, then GEP the field using the base struct's own
                // named LLVM type (the non-generic case — generic nested places fall
                // through to a null result, as before).
                val basePtr: LLVMValueRef = self.placePtrStrict(c: inout c, id: base)
                if LLVMIsNull(basePtr) == 0I32 {
                    val bsi: U64 = self.exprStructIdx(c: inout c, id: base)
                    if bsi < c.arena.structs.count() {
                        val sd: StructDef = c.arena.structs[bsi]
                        val reg: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
                        if reg < self.genStructRefs.count() {
                            val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: nameStart, len: nameLen)
                            if fidx < c.arena.structs[bsi].fields.count() {
                                return LLVMBuildStructGEP2(self.b, self.genStructTys[reg], basePtr, fidx, anon())
                            }
                        }
                    }
                }
            }
            Expr.Index(val base, val index) => {
                // an array element place `xs[i]`: the element pointer into the owned
                // buffer (the buffer is owned — value-semantics CoW already split any
                // alias — so writing through it is observably correct).
                if self.exprIsArray(c: inout c, id: base) {
                    val elemTy: LLVMTypeRef = self.arrElemTyOf(c: inout c, id: base)
                    mut val arr: LLVMValueRef = LLVMConstNull(self.ptrty)
                    mut val loaded: Bool = false
                    // a deref-crossing base (`r->xs[i]`): route through the base's own
                    // place pointer and load the array value from it — the one cell
                    // evaluation (which also arms the cell pin below).
                    if c.placeHasDeref(id: base) {
                        val basePtr: LLVMValueRef = self.placePtrStrict(c: inout c, id: base)
                        if LLVMIsNull(basePtr) == 0I32 {
                            arr = LLVMBuildLoad2(self.b, self.arrayTy, basePtr, anon())
                            loaded = true
                        }
                    }
                    if !loaded {
                        arr = self.genLlvmExpr(c: inout c, id: base)
                    }
                    val data: LLVMValueRef = self.arrValData(c: inout c, arr: arr)
                    val count: LLVMValueRef = self.arrValCount(c: inout c, arr: arr)
                    val idx: LLVMValueRef = self.genLlvmExpr(c: inout c, id: index)
                    self.emitBoundsCheck(c: inout c, idx: idx, count: count)
                    return self.arrElemPtr(elemTy: elemTy, data: data, idx: idx)
                }
            }
            Expr.Deref(val base) => {
                // `*ref` as a WRITE place (an `inout`/mutating pointee method's self): the
                // pointee struct lives AT the cell pointer, so the cell pointer IS the place.
                // The cell is intentionally SHARED (no CoW privatize — that is the point of a
                // `Ref`), so mutation is visible through every alias of the Ref.
                val refTy: U64 = self.exprRefTypeRef(c: inout c, id: base)
                if refTy != 0U64 {
                    val cellPtr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: base)
                    self.pinDerefCell(c: inout c, cell: cellPtr, refTy: refTy)
                    return cellPtr
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // `r->field` as a place: GEP into the Ref's cell (the same recipe as the
                // `r->field = v` assignment path in Stmt.pw). The cell is intentionally
                // SHARED (no CoW), so an `inout r->field` argument mutates through every
                // alias of the Ref — without this arm the place fell back to a temp copy
                // and the callee's write was silently lost.
                val psidx: U64 = self.refPointeeStructIdx(c: inout c, base: base)
                if psidx < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[psidx].fields.count() {
                        val refTy: U64 = self.exprRefTypeRef(c: inout c, id: base)
                        val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: refTy)
                        val cellPtr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: base)
                        self.pinDerefCell(c: inout c, cell: cellPtr, refTy: refTy)
                        return LLVMBuildStructGEP2(self.b, pty, cellPtr, fidx, anon())
                    }
                }
            }
            _ => {}
        }
        return LLVMConstNull(self.ptrty)
    }

    inout fn placePtrOf(c: inout Comp, id: U64) -> LLVMValueRef {
        val p: LLVMValueRef = self.placePtrStrict(c: inout c, id: id)
        if LLVMIsNull(p) == 0I32 {
            return p
        }
        // not a place (a fresh value): materialize into a temp slot so a callee taking
        // `inout`/`borrow` still gets a pointer (it mutates the copy, harmlessly).
        val v: LLVMValueRef = self.genLlvmExpr(c: inout c, id: id)
        val slot: LLVMValueRef = self.entryAlloca(ty: LLVMTypeOf(v))
        LLVMBuildStore(self.b, v, slot)
        return slot
    }

    // CoW gateway (1-0): before WRITING through a place (assignment target, `inout` arg,
    // `inout` self receiver), privatize every shared array buffer ON THE PATH ABOVE the
    // written slot — outermost first — so an in-place write cannot leak into another sharer
    // of an enclosing array. Recurses base-first (the outer array is privatized before the
    // inner), each level via the array's storage slot (`cowArraySlot` round-trips the slot,
    // CoWing iff rc>1). The IMMEDIATE array (the one whose element/field is written) is
    // privatized by the write-site itself (its own `cowArraySlot`, or the callee's). Under
    // eager-copy (no sharing) every rc<=1, so `plew_arr_cow` no-ops — runtime-neutral until
    // the place split flips to CoW-share (1-3a). NOT placed inside `placePtrStrict`: that
    // also serves READ borrows, where privatizing would defeat CoW-share.
    inout fn privatizeForWrite(c: inout Comp, id: U64) {
        match c.arena.exprs[id] {
            Expr.Index(base: val b, index: val ix) => {
                self.privatizeForWrite(c: inout c, id: b)
                if self.exprIsArray(c: inout c, id: b) {
                    val slot: LLVMValueRef = self.arrStoragePtr(c: inout c, id: b)
                    if LLVMIsNull(slot) == 0I32 {
                        self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: self.arrElemTyOf(c: inout c, id: b), elemRef: self.arrayExprElemRef(c: inout c, arrayExpr: b))
                    }
                }
            }
            Expr.Field(base: val b, nameStart: val ns, nameLen: val nl) => {
                self.privatizeForWrite(c: inout c, id: b)
            }
            _ => {}
        }
    }

    // `placePtrOf` for a WRITE place: run the CoW gateway first (see `privatizeForWrite`),
    // then take the place pointer. Use at every mutation site that takes a place address.
    inout fn placePtrOfWrite(c: inout Comp, id: U64) -> LLVMValueRef {
        self.privatizeForWrite(c: inout c, id: id)
        return self.placePtrOf(c: inout c, id: id)
    }

    // Cell pin, the push side (spec/03): called by placePtrStrict's deref arms with the
    // cell they just evaluated. Armed (pinArm) only while an `inout` argument/receiver
    // pointer is being computed: retain the cell and push it on the pin stack — the
    // call site releases back to its mark after the call, so a rebind inside the callee
    // cannot free the lent pointee mid-call (its deinit runs at the release instead).
    inout fn pinDerefCell(c: inout Comp, cell: LLVMValueRef, refTy: U64) {
        if !self.pinArm {
            return
        }
        self.rawbufRetain(c: inout c, cell: cell)
        self.pinCells.append(cell)
        self.pinRefTys.append(refTy)
        self.pinExprs.append(0U64)
    }

    // `placePtrOfWrite` for an `inout` CALL argument/receiver: arms the cell pin, then
    // stamps the entries pushed during this place's evaluation with the arg expr id (so
    // the overlap check finds the arg's cell without re-evaluating anything). An inner
    // call inside the place's index expression pushes AND releases its own pins during
    // the evaluation, so the stamped frame holds exactly this place's cells.
    inout fn placePtrOfWritePinned(c: inout Comp, id: U64) -> LLVMValueRef {
        val mark: U64 = self.pinCells.count()
        val savedArm: Bool = self.pinArm
        self.pinArm = true
        val p: LLVMValueRef = self.placePtrOfWrite(c: inout c, id: id)
        self.pinArm = savedArm
        mut val i: U64 = mark
        while i < self.pinExprs.count() {
            self.pinExprs[i] = id
            i += 1U64
        }
        return p
    }

    // Release one call's cell pins (back to `mark`), in reverse push order: each drops
    // its strong owner via emitRefRelease — if the callee dropped every other owner (a
    // rebind of the lent Ref), the pointee deinit runs HERE, after the call (spec/03).
    inout fn releaseInoutPins(c: inout Comp, mark: U64) {
        mut val i: U64 = self.pinCells.count()
        while i > mark {
            i -= 1U64
            self.emitRefRelease(c: inout c, cell: self.pinCells[i], refTy: self.pinRefTys[i])
        }
        self.pinCells.truncate(count: mark)
        self.pinRefTys.truncate(count: mark)
        self.pinExprs.truncate(count: mark)
    }

    // The pinned cell recorded for an `inout` arg place in the current call's pin frame
    // (null when the place did not cross a deref / took the non-place fallback).
    inout fn pinnedCellOf(expr: U64, mark: U64) -> LLVMValueRef {
        mut val i: U64 = mark
        while i < self.pinExprs.count() {
            if self.pinExprs[i] == expr {
                return self.pinCells[i]
            }
            i += 1U64
        }
        return LLVMConstNull(self.ptrty)
    }

    // Overlapping-`inout` runtime tier (spec/03, Swift-equivalent granularity): with two
    // or more `inout` positions in ONE call, every pair the frontend could not resolve
    // statically is checked just before the call at CELL granularity — such a pair is
    // two deref-crossing places that do not provably diverge at distinct pointee fields,
    // so overlap reduces to cell identity: compare the cells captured (and pinned) while
    // the argument pointers themselves were computed. Nothing is re-evaluated. `av`
    // holds the receiver (when `hasRecv`) followed by the provided args starting at
    // `avArgStart`; omitted-default positions carry callee-side temps and never overlap
    // a caller place, so only provided args are paired.
    inout fn emitInoutOverlapChecks(c: inout Comp, f: Func, av: Array[LLVMValueRef], args: Array[Arg], hasRecv: Bool, recvExpr: U64, avArgStart: U64, pinMark: U64) {
        mut val ioExpr: Array[U64] = []
        mut val ioPtr: Array[LLVMValueRef] = []
        if hasRecv {
            if f.selfInout {
                ioExpr.append(recvExpr)
                ioPtr.append(av[avArgStart - 1U64])
            }
        }
        mut val ai: U64 = 0
        while ai < args.count() {
            if ai < f.params.count() {
                if f.params[ai].isInout {
                    ioExpr.append(args[ai].expr)
                    ioPtr.append(av[avArgStart + ai])
                }
            }
            ai += 1
        }
        if ioExpr.count() < 2U64 {
            return
        }
        mut val i: U64 = 0
        while i < ioExpr.count() {
            mut val j: U64 = i + 1U64
            while j < ioExpr.count() {
                // 0 = provably distinct (skip). 1 (certain overlap) normally already died
                // in Verify; emitting its always-true check keeps a loud failure for any
                // body that pass does not walk. 2 = the runtime-check tier proper.
                if c.classifyInoutPair(a: ioExpr[i], b: ioExpr[j]) != 0U64 {
                    self.emitInoutOverlapPair(c: inout c, aExpr: ioExpr[i], aPtr: ioPtr[i], bExpr: ioExpr[j], bPtr: ioPtr[j], pinMark: pinMark)
                }
                j += 1U64
            }
            i += 1U64
        }
    }

    // One runtime-checked pair: compare the two places' CELLS (spec/03 container/cell
    // granularity — the frontend only emits a check when the post-deref paths do not
    // provably diverge, so same cell ⟺ overlap). The cells were captured by the pin
    // while each argument pointer was computed; a place without a pinned cell (an
    // opaque non-place fallback) falls back to its raw argument pointer, keeping the
    // old leaf-identity behaviour for that conservative corner.
    inout fn emitInoutOverlapPair(c: inout Comp, aExpr: U64, aPtr: LLVMValueRef, bExpr: U64, bPtr: LLVMValueRef, pinMark: U64) {
        mut val pa: LLVMValueRef = self.pinnedCellOf(expr: aExpr, mark: pinMark)
        mut val pb: LLVMValueRef = self.pinnedCellOf(expr: bExpr, mark: pinMark)
        if LLVMIsNull(pa) != 0I32 {
            pa = aPtr
        }
        if LLVMIsNull(pb) != 0I32 {
            pb = bPtr
        }
        if LLVMIsNull(pa) != 0I32 {
            return
        }
        if LLVMIsNull(pb) != 0I32 {
            return
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_inout_overlap", nameId: 28U64, fnTy: fty)
        mut val cav: Array[LLVMValueRef] = []
        cav.append(pa)
        cav.append(pb)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(cav), 2U64, anon())
    }
}

pub impl LlvmCtx {

    inout fn genArgValue(c: inout Comp, argExpr: U64, p: Param) -> LLVMValueRef {
        return self.genArgValueV(c: inout c, argExpr: argExpr, p: p, checkView: true)
    }

    // As genArgValue, but `checkView` selects whether the extension-view invariance is
    // enforced. Operator-trait witness operands pass `false`: an operator dispatches on
    // the UNDERLYING type (the `#Ext` view only adds methods, spec/09), so `self * 2`
    // inside an `impl I64` extension flows `self` (a viewed value) into the plain-typed
    // `I64.mul` witness param without a view mismatch. Every other call passes `true`.
    inout fn genArgValueV(c: inout Comp, argExpr: U64, p: Param, checkView: Bool) -> LLVMValueRef {
        // extension-view invariance (spec/09): `A` and `A#Ext` are distinct types with
        // no implicit cast either way, so an argument's view must match the parameter's
        // declared view exactly — the view is applied/dropped explicitly at the call
        // (`value#Ext` / `value#!Ext`). Plain code (no views) has both sides 0. A generic
        // type-parameter param absorbs the view (it binds to `S#P` via inference), so the
        // check applies only to a concrete param type.
        mut val pView: U64 = 0
        mut val pConcrete: Bool = true
        if p.ty != 0U64 {
            pView = c.arena.types[p.ty].viewExtId
            pConcrete = tyNameConcrete(c: inout c, start: c.arena.types[p.ty].nameStart, len: c.arena.types[p.ty].nameLen)
        }
        if checkView {
            if pConcrete {
                if pView != self.exprViewExtId(c: inout c, id: argExpr) {
                    c.errorAt(offset: c.exprOffset(id: argExpr), msg: "extension view mismatch: a plain type and its `#Ext` view are distinct — apply or drop the view explicitly at the call (`value#Ext` / `value#!Ext`)")
                }
            }
        }
        if p.isInout {
            // pass the caller's place address (the callee mutates in place); a deref-
            // crossing place pins its cell for the call (the site releases after it).
            return self.placePtrOfWritePinned(c: inout c, id: argExpr)
        }
        // a `move` parameter consumes the argument — the callee owns it and runs
        // deinit, so mark the source local moved (excluded from the caller's drop).
        if p.isMove {
            match c.arena.exprs[argExpr] {
                Expr.Ident(start: val s, len: val l) => {
                    self.markLocalMoved(c: inout c, start: s, len: l)
                }
                _ => {}
            }
        }
        // an `any P` parameter (spec/08): box a concrete conforming argument into the
        // existential fat pointer, or value-semantics-copy an existing `any` place.
        mut val argBoxed: Bool = false
        val argAny: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: p.ty, valueExpr: argExpr, outBoxed: inout argBoxed)
        if argBoxed {
            return argAny
        }
        if refIsAny(c: inout c, ref: p.ty) {
            return self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: argExpr), valueExpr: argExpr)
        }
        if p.tyIsArray {
            match c.arena.exprs[argExpr] {
                Expr.Array(val elems) => {
                    mut val argElemRef: U64 = 0
                    if p.ty != 0U64 {
                        if c.arena.types[p.ty].args.count() > 0U64 {
                            argElemRef = c.arena.types[p.ty].args[0]
                        }
                    }
                    return self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: self.llvmScalarTy(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen), elemRef: argElemRef)
                }
                _ => {}
            }
            val arrArg: LLVMValueRef = self.genLlvmExpr(c: inout c, id: argExpr)
            // a by-value array argument from a place SHARES the caller's buffer: retain it
            // so the callee co-owns (the refcount now exceeds 1, so a callee mutation CoWs
            // instead of clobbering the caller's binding, and `plew_arr_grow` will not free
            // the caller's buffer out from under it). A `move` arg transfers ownership
            // instead (markLocalMoved above), so it is not also retained.
            if !(p.isMove) {
                if arrayExprIsPlace(c: inout c, id: argExpr) {
                    self.rawbufRetain(c: inout c, cell: self.arrValData(c: inout c, arr: arrArg))
                }
            }
            return arrArg
        }
        // a generic-instance parameter (`o: Optional[I64]`, `b: Box[I32]`): flow the
        // expected concrete instance to the argument so a JSX construction without
        // explicit type args (`<Optional.Some v=5 />`) grounds its head from context
        // (genLlvmMake/genLlvmMakeEnum consume self.expectedTy). Reset after so an
        // unconsumed value (a non-construction arg) cannot leak into a later one.
        if p.ty != 0U64 {
            if c.isGenericInst(ref: p.ty) {
                self.expectedTy = p.ty
            }
        }
        val argV: LLVMValueRef = self.genLlvmExpr(c: inout c, id: argExpr)
        self.expectedTy = 0U64
        val out: LLVMValueRef = self.coerceIntTo(c: inout c, v: argV, tyStart: p.tyStart, tyLen: p.tyLen)
        // value semantics (CoW): a by-value struct / String / enum argument from a PLACE
        // SHARES the caller's heap, and the callee owns its param and runs its deinit at
        // scope exit — so SHALLOW-retain the arg's heap (bump its rc) so the callee's release
        // balances and the caller's value survives. A shallow retain (like an array arg, above)
        // is O(type-depth); a deep copy here would be O(subtree) and quadratic for recursive
        // AST args. A `move` arg transfers ownership (markLocalMoved above) and a literal /
        // call result already owns its value (not a place), so neither is retained.
        if !(p.isMove) {
            // a `Ref` by-value arg (place OR temporary): the callee's param is a BORROW (not
            // released at callee scope — curBodyMark-gated); storing / returning it inside the
            // callee retains via consumeIntoOwned. A PLACE arg (`r`) is owned by the caller's
            // own binding, which drops at its scope — nothing to do here. A TEMPORARY (`<Ref
            // .../>` literal / call result) has no home binding, so register it as an owned
            // anonymous local: the enclosing block's scope-exit drop releases it (strong--,
            // pointee deinit + free at 0), balancing the construction's initial rc and any
            // store-retain the callee took. This makes Ref EXACT (no leak, no UAF) where
            // struct / String / enum place args still shallow-retain (a tolerated leak).
            val refTy: U64 = self.argRefTypeRef(c: inout c, argExpr: argExpr)
            if refTy != 0U64 {
                if !(arrayExprIsPlace(c: inout c, id: argExpr)) {
                    val slot: LLVMValueRef = self.entryAlloca(ty: self.ptrty)
                    LLVMBuildStore(self.b, out, slot)
                    self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: slot, ty: self.ptrty, kind: 0U64, structIdx: c.arena.structs.count(), isArr: false, elemTy: self.ptrty, elemKind: 0U64, typeRef: refTy)
                }
            } else if structExprIsPlace(c: inout c, id: argExpr) {
                val atr: U64 = self.exprTypeRef(c: inout c, id: argExpr)
                // struct / String / enum place args shallow-retain (their param's deferred
                // release is a tolerated leak, never a UAF). A Ref/WeakRef place is diverted
                // above (refTy != 0); the guard is defensive in case argRefTypeRef missed it.
                if !(c.isRefInst(ref: atr)) && !(c.isWeakRefInst(ref: atr)) {
                    self.valueArc(c: inout c, v: out, typeRef: atr, retain: true)
                }
            }
        }
        return out
    }

    // The grounded `Ref[T]` TypeRef of a by-value argument expression, or 0 if it is not a
    // Ref. A `<Ref[T] .../>` construction carries its type on the Make node (which
    // exprRefTypeRef can't see); a place / call result resolves via exprRefTypeRef. Grounds
    // a generic literal type (`<Ref[U] .../>` inside a generic caller) under the caller env.
    inout fn argRefTypeRef(c: inout Comp, argExpr: U64) -> U64 {
        match c.arena.exprs[argExpr] {
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: val mty, fields: _) => {
                mut val g: U64 = mty
                if g != 0U64 {
                    if c.cur.typeParams.count() > 0U64 {
                        g = c.groundTypeRef(ref: mty)
                    }
                }
                if c.isRefInst(ref: g) || c.isWeakRefInst(ref: g) {
                    return g
                }
                return 0U64
            }
            _ => {}
        }
        val rt: U64 = self.exprRefTypeRef(c: inout c, id: argExpr)
        if rt != 0U64 {
            return rt
        }
        // a `WeakRef[T]` temporary (e.g. `f(r.weak())`): its scope-exit drop must release the
        // weak count, so register it as an owned local too (emitDeinitCall routes WeakRef to
        // weakRelease). exprRefTypeRef only recognises Ref, so resolve WeakRef separately.
        val et: U64 = self.exprTypeRef(c: inout c, id: argExpr)
        if c.isWeakRefInst(ref: et) {
            return et
        }
        return 0U64
    }

    // Index into st.fn* for a cached user function (by c.arena.funcs index), or st.fnIdx.count().
    inout fn userFnSlot(idx: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.fnIdx.count() {
            if self.fnIdx[i] == idx {
                return i
            }
            i += 1
        }
        return self.fnIdx.count()
    }

    // The genFn* slot for the free-function instance (fnIdx, args), declaring it lazily on
    // first reach (mirrors ensureFreeFnDeclared, but for the unified `gf` mechanism: a
    // non-generic free fn is its own 0-type-arg instance, args=[]). The signature is built
    // under the instance env (typeParams -> args; empty for non-generic, a no-op). The body is
    // queued (genFnEmit) for the pass-2 drain. Returns st.genFnK.count() if not declarable
    // (extern / main / a method — those stay on their own paths). Idempotent via genFnSlotFor.
    inout fn ensureFnInst(c: inout Comp, fnIdx: U64, args: Array[U64], recvInstRef: U64) -> U64 {
        val existing: U64 = genFnSlotFor(c: inout c, fnIdx: fnIdx, args: args, st: inout self)
        if existing < self.genFnK.count() {
            return existing
        }
        val f: Func = c.arena.funcs[fnIdx]
        if f.isExtern { return self.genFnK.count() }
        if c.nameIsMain(f: f) { return self.genFnK.count() }
        if f.hasRecv { return self.genFnK.count() }
        if f.isAsync { return self.genFnK.count() }
        // a generic instance must arrive COMPLETE and GROUND: a hole (an uninferred 0,
        // or a still-parametric ref) would register a bogus instance whose body emits
        // under a broken env — resolveTy substitutes nothing for the hole and the
        // params/fields default to i64, a silent miscompile. The frontend's inference
        // gates catch this at the call site; this is the registration-side invariant.
        // (The line points at the generic function's declaration: the emission path
        // has no call offset here.)
        if f.typeParams.count() > 0U64 {
            if args.count() != f.typeParams.count() || !(c.fnArgsAllGround(args: args)) {
                c.errorAt(offset: f.nameStart, msg: "cannot infer the type arguments of a call to this generic function — annotate the arguments or the receiving binding so every type parameter is pinned (spec/06)")
            }
            // polymorphic-recursion ceiling on the demand side too: the emission drain
            // (emitOneGenFn -> ensureFnInst) is its own fixpoint and would otherwise
            // queue ever-deeper instances forever (mirrors registerCallInst's gate).
            mut val di: U64 = 0
            while di < args.count() {
                c.checkInstDepth(ref: args[di])
                di += 1
            }
        }
        val k: U64 = c.monoWork.fnInsts.count()
        // recvInstRef: the operand instance for an `assoc fn` witness (`impl[T] Array[T]
        // as Eq` -> Array[I64]), so emitOneGenFn can bind `Self`/`Item` to the receiver
        // (its `Self` params/field access ground). 0 for a free-function witness.
        // ⚠ genFnSlotFor keys the instance cache on (fnIdx, args) ONLY, not recvInstRef —
        // sound today because each `impl T as Eq` has a distinct `eq` fnIdx, so (fnIdx, args)
        // determines the receiver. A trait-provided DEFAULT `assoc fn` shared across receiver
        // types (same fnIdx, args=[], differing recvInstRef) would alias to the first-seen
        // `Self` — add recvInstRef to the key if that lands.
        c.monoWork.fnInsts.append(<FnInst fnIdx=fnIdx args=args recvInstRef=recvInstRef />)
        // a DEMAND-registered instance postdates the collection-time checkFnBounds
        // sweep — run the same per-instance `where` check here so it cannot escape
        // the soundness gate (audit-5 M).
        c.checkOneFnInstBounds(fin: c.monoWork.fnInsts[k])
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedSelf: U64 = c.cur.selfRef
        val savedItem: U64 = c.cur.itemRef
        c.cur.typeParams = f.typeParams
        c.cur.typeArgs = args
        // bind `Self`/`Item` for an assoc-fn witness so its SIGNATURE grounds — a `Self`
        // param / `-> Self` return must get the receiver's real LLVM type here, else the
        // declared signature (i64 default for an ungrounded `Self`) mismatches the struct
        // the caller passes. Mirrors the env emitOneGenFn sets for the body (they must agree).
        if f.isAssoc {
            if recvInstRef != 0U64 {
                c.setSelfItemEnv(recvStart: c.arena.types[recvInstRef].nameStart, recvLen: c.arena.types[recvInstRef].nameLen, recvInstRef: recvInstRef)
            } else {
                c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
            }
        }
        mut val ptys: Array[LLVMTypeRef] = []
        mut val pi: U64 = 0
        while pi < f.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: f.params[pi]))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: f), arrayCPtr(ptys), ptys.count(), 0I32)
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        c.cur.selfRef = savedSelf
        c.cur.itemRef = savedItem
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "gf".bytes())
        appendU64Dec(into: inout nm, n: k)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.genFnK.append(k)
        self.genFnVal.append(fv)
        self.genFnTy.append(fty)
        self.genFnEmit.append(self.genFnK.count() - 1U64)
        return self.genFnK.count() - 1U64
    }
}
