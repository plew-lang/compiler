        }
        mut val i: U64 = 0U64
        while i < args.count() {
            mut val value: LLVMValueRef = LLVMConstNull(self.ptrty)
            match selectedArgumentPassings[i] {
            CallArgumentPassing.Inout => {
                match args[i] {
                    MidOperand.Borrow(place: val place, capability: val capability) => {
                        match capability { MidBorrowCapability.Inout => { value = self.midPlacePtr(c: inout c, body: body, place: place) } _ => { return false } }
                    }
                    _ => { return false }
                }
            }
            CallArgumentPassing.Borrow => {
                value = self.midEmitOperand(c: inout c, body: body, operand: args[i])
                if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 {
                    val parameter: TypeRef = c.arena.types[selectedParameterTypes[i]]
                    value = self.coerceInt(v: value, target: self.llvmTypeOfRef(c: inout c, ref: selectedParameterTypes[i]), unsigned: isUnsignedName(c: inout c, start: parameter.nameStart, len: parameter.nameLen))
                }
            }
            CallArgumentPassing.Move => {
                value = self.midEmitOperand(c: inout c, body: body, operand: args[i])
                if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 {
                    val parameter: TypeRef = c.arena.types[selectedParameterTypes[i]]
                    value = self.coerceInt(v: value, target: self.llvmTypeOfRef(c: inout c, ref: selectedParameterTypes[i]), unsigned: isUnsignedName(c: inout c, start: parameter.nameStart, len: parameter.nameLen))
                }
            }
            }
            values.append(value)
            i += 1U64
        }
        mut val result: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        if calleeDef.isExtern {
            result = LLVMBuildCall2(self.b, self.declTy[externalSlot], self.declFn[externalSlot], arrayCPtr(values), values.count(), anon())
        } else if useMethodInstance {
            result = LLVMBuildCall2(self.b, self.genMethTy[methodSlot], self.genMethVal[methodSlot], arrayCPtr(values), values.count(), anon())
        } else {
            result = LLVMBuildCall2(self.b, self.genFnTy[freeSlot], self.genFnVal[freeSlot], arrayCPtr(values), values.count(), anon())
        }
        if c.arena.funcs[selected.callee].hasRet {
            val projected: LLVMValueRef = self.midProjectCallResult(selected: selected, value: result)
            LLVMBuildStore(self.b, projected, self.midLocalPtr(body: body, local: destination.local))
        }
        return true
    }

    // Mid local indices are stable IR identities.  They are intentionally not
    // looked up by source spelling or declaration offset at this boundary.
    inout fn midLocalPtr(body: MidBody, local: U64) -> LLVMValueRef {
        if local < body.locals.count() && local < self.nLocals {
            return self.locPtr[local]
        }
        return LLVMConstNull(self.ptrty)
    }

    // Canonical Mid has the same function-local index space as the draft
    // builder, but its declarations and projections live in typed arena rows.
    // These readers intentionally take the body node/range rather than
    // reconstructing a MidPlace or MidBody with owning Array payloads.
    inout fn midCanonicalLocalPtr(body: MidBodyNode, local: U64) -> LLVMValueRef {
        if local < body.locals.len && local < self.nLocals { return self.locPtr[local] }
        return LLVMConstNull(self.ptrty)
    }

    inout fn midCanonicalLocalTy(c: inout Comp, body: MidBodyNode, local: U64) -> LLVMTypeRef {
        if local >= body.locals.len { return self.i64ty }
        val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
        if declaration.isDropFlag { return self.i1ty }
        if declaration.typeTerm == 0U64 || declaration.typeTerm >= c.arena.types.count() { return self.i64ty }
        return self.llvmTypeOfRef(c: inout c, ref: declaration.typeTerm)
    }

    inout fn midCanonicalPlaceTy(c: inout Comp, body: MidBodyNode, place: MidPlaceNode) -> LLVMTypeRef {
        if place.projections.len == 0U64 { return self.midCanonicalLocalTy(c: inout c, body: body, local: place.local) }
        if place.typeTerm != 0U64 && place.typeTerm < c.arena.types.count() { return self.llvmTypeOfRef(c: inout c, ref: place.typeTerm) }
        return self.midCanonicalLocalTy(c: inout c, body: body, local: place.local)
    }

    inout fn midCanonicalPlacePtr(c: inout Comp, body: MidBodyNode, place: MidPlaceNode) -> LLVMValueRef {
        if place.local >= body.locals.len { return LLVMConstNull(self.ptrty) }
        mut val pointer: LLVMValueRef = self.midCanonicalLocalPtr(body: body, local: place.local)
        mut val currentTy: LLVMTypeRef = self.midCanonicalLocalTy(c: inout c, body: body, local: place.local)
        mut val projectionI: U64 = 0U64
        while projectionI < place.projections.len {
            val projection: MidProjectionNode = c.mid.projections[place.projections.start + projectionI]
            if projection.tag == 1U64 {
                pointer = LLVMBuildStructGEP2(self.b, currentTy, pointer, projection.index, anon())
                currentTy = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
            } else if projection.tag == 2U64 {
                if projection.indexLocal >= body.locals.len { return LLVMConstNull(self.ptrty) }
                val array: LLVMValueRef = LLVMBuildLoad2(self.b, currentTy, pointer, anon())
                val data: LLVMValueRef = self.arrValData(c: inout c, arr: array)
                val index: LLVMValueRef = LLVMBuildLoad2(self.b, self.midCanonicalLocalTy(c: inout c, body: body, local: projection.indexLocal), self.midCanonicalLocalPtr(body: body, local: projection.indexLocal), anon())
                self.emitBoundsCheck(c: inout c, idx: index, count: self.rawbufCount(c: inout c, data: data))
                currentTy = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
                pointer = self.arrElemPtr(elemTy: currentTy, data: data, idx: index)
            } else { return LLVMConstNull(self.ptrty) }
            projectionI = projectionI + 1U64
        }
        return pointer
    }

    inout fn midCanonicalReadPlace(c: inout Comp, body: MidBodyNode, place: MidPlaceNode) -> LLVMValueRef {
        return LLVMBuildLoad2(self.b, self.midCanonicalPlaceTy(c: inout c, body: body, place: place), self.midCanonicalPlacePtr(c: inout c, body: body, place: place), anon())
    }

    inout fn midCanonicalEmitOperand(c: inout Comp, body: MidBodyNode, operandId: U64) -> LLVMValueRef {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return LLVMConstNull(self.ptrty) }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag >= 1U64 && operand.tag <= 4U64 {
            if operand.place == 0U64 || operand.place > c.mid.places.count() { return LLVMConstNull(self.ptrty) }
            val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
            val value: LLVMValueRef = self.midCanonicalReadPlace(c: inout c, body: body, place: place)
            if operand.tag == 1U64 && place.typeTerm != 0U64 && place.typeTerm < c.arena.types.count() && c.arcNeedsRelease(ref: place.typeTerm) {
                self.valueArc(c: inout c, v: value, typeRef: place.typeTerm, retain: true)
            }
            return value
        }
        if operand.tag == 5U64 {
            mut val ty: LLVMTypeRef = self.i64ty
            if operand.integerBool { ty = self.i1ty }
            else if operand.typeTerm != 0U64 && operand.typeTerm < c.arena.types.count() { ty = self.llvmTypeOfRef(c: inout c, ref: operand.typeTerm) }
            val literal: LLVMValueRef = LLVMConstInt(ty, operand.integerValue, 0I32)
            if operand.integerNegative { return LLVMBuildNeg(self.b, literal, anon()) }
            return literal
        }
        if operand.tag == 6U64 {
            return self.genLlvmStr(c: inout c, start: operand.stringStart, len: operand.stringLen)
        }
        if operand.tag == 7U64 {
            return LLVMConstRealOfStringAndSize(self.llvmTypeOfRef(c: inout c, ref: operand.typeTerm), floatTextCPtr(c: inout c, start: operand.stringStart, len: operand.stringLen), floatTextLen(c: inout c, start: operand.stringStart, len: operand.stringLen))
        }
        return LLVMConstNull(self.ptrty)
    }

    inout fn midCanonicalOperandTypeTerm(c: Comp, body: MidBodyNode, operandId: U64) -> U64 {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag >= 1U64 && operand.tag <= 4U64 && operand.place != 0U64 && operand.place <= c.mid.places.count() { return c.mid.places[operand.place - 1U64].typeTerm }
        if operand.tag >= 5U64 && operand.tag <= 7U64 { return operand.typeTerm }
        return 0U64
    }

    inout fn midCanonicalPlaceLlvmSupported(c: inout Comp, body: MidBodyNode, placeId: U64) -> Bool {
        if placeId == 0U64 || placeId > c.mid.places.count() { return false }
        val place: MidPlaceNode = c.mid.places[placeId - 1U64]
        if place.local >= body.locals.len { return false }
        mut val projectionI: U64 = 0U64
        while projectionI < place.projections.len {
            val projection: MidProjectionNode = c.mid.projections[place.projections.start + projectionI]
            if projection.tag == 1U64 {
                if projection.typeTerm == 0U64 || projection.typeTerm >= c.arena.types.count() { return false }
            } else if projection.tag == 2U64 {
                if projection.indexLocal >= body.locals.len || projection.typeTerm == 0U64 || projection.typeTerm >= c.arena.types.count() { return false }
            } else { return false }
            projectionI = projectionI + 1U64
        }
        return true
    }

    inout fn midCanonicalOperandLlvmSupported(c: inout Comp, body: MidBodyNode, operandId: U64) -> Bool {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return false }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag >= 1U64 && operand.tag <= 4U64 { return self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) }
        if operand.tag == 5U64 { return operand.typeTerm == 0U64 || operand.typeTerm < c.arena.types.count() }
        if operand.tag == 6U64 { return operand.stringStart <= c.arena.bytes.count() && operand.stringLen <= c.arena.bytes.count() - operand.stringStart }
        if operand.tag == 7U64 {
            if operand.typeTerm == 0U64 || operand.typeTerm >= c.arena.types.count() || operand.stringStart > c.arena.bytes.count() || operand.stringLen == 0U64 || operand.stringLen > c.arena.bytes.count() - operand.stringStart { return false }
            val kind: U32 = LLVMGetTypeKind(self.llvmTypeOfRef(c: inout c, ref: operand.typeTerm))
            return kind == 2U32 || kind == 3U32
        }
        return false
    }

    inout fn midCanonicalInitialRvalueSupported(c: inout Comp, body: MidBodyNode, rvalueId: U64) -> Bool {
        if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return false }
        val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
        if value.tag == 1U64 { return self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) }
        if value.tag == 2U64 { return value.targetTerm != 0U64 && value.targetTerm < c.arena.types.count() && self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) && c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: value.operand), b: value.targetTerm) }
        if value.tag >= 3U64 && value.tag <= 5U64 {
            if value.resultTerm == 0U64 || value.resultTerm >= c.arena.types.count() || value.fieldCount != value.elements.len { return false }
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
                if element.targetTerm == 0U64 || element.targetTerm >= c.arena.types.count() || !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: element.operand) || c.conversionProofIsMissing(id: element.conversion) { return false }
                elementI = elementI + 1U64
            }
            return true
        }
        if value.tag == 6U64 { return self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) && !c.conversionProofIsMissing(id: value.conversion) }
        if value.tag == 7U64 { return false }
        if value.tag >= 8U64 && value.tag <= 10U64 { return value.targetTerm != 0U64 && value.targetTerm < c.arena.types.count() && self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) }
        if value.tag >= 11U64 && value.tag <= 15U64 { return value.place != 0U64 && value.place <= c.mid.places.count() && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: value.place) && value.resultTerm != 0U64 && value.resultTerm < c.arena.types.count() }
        return false
    }

    inout fn midLocalTy(c: inout Comp, body: MidBody, local: U64) -> LLVMTypeRef {
        if local >= body.locals.count() { return self.i64ty }
        val declaration: MidLocalDecl = body.locals[local]
        if declaration.isDropFlag { return self.i1ty }
        if declaration.typeTerm == 0U64 || declaration.typeTerm >= c.arena.types.count() { return self.i64ty }
        return self.llvmTypeOfRef(c: inout c, ref: declaration.typeTerm)
    }

    inout fn midPlaceTy(c: inout Comp, body: MidBody, place: MidPlace) -> LLVMTypeRef {
        // A root place is its Mid local.  `place.typeTerm` is retained on the
        // parametric form for local checking, but after instantiation the
        // local declaration is the one concrete ABI type source; using the
        // stale copied term here would split an aggregate's storage layout.
        if place.projections.count() == 0U64 {
            return self.midLocalTy(c: inout c, body: body, local: place.local)
        }
        if place.typeTerm != 0U64 && place.typeTerm < c.arena.types.count() {
            return self.llvmTypeOfRef(c: inout c, ref: place.typeTerm)
        }
        return self.midLocalTy(c: inout c, body: body, local: place.local)
    }

    inout fn midPlacePtr(c: inout Comp, body: MidBody, place: MidPlace) -> LLVMValueRef {
        if !(self.midPlaceLlvmSupported(c: inout c, body: body, place: place)) { return LLVMConstNull(self.ptrty) }
        mut val pointer: LLVMValueRef = self.midLocalPtr(body: body, local: place.local)
        mut val currentTy: LLVMTypeRef = self.midLocalTy(c: inout c, body: body, local: place.local)
        mut val i: U64 = 0U64
        while i < place.projections.count() {
            match place.projections[i] {
                MidProjection.Field(index: val index, typeTerm: val typeTerm) => {
                    pointer = LLVMBuildStructGEP2(self.b, currentTy, pointer, index, anon())
                    currentTy = self.llvmTypeOfRef(c: inout c, ref: typeTerm)
                }
                MidProjection.Index(indexLocal: val indexLocal, typeTerm: val typeTerm) => {
                    // The index local was materialized by Mid before this
                    // place was formed. Loading it here cannot duplicate a
                    // source effect. Array's physical `{ptr}` value is read
                    // only from the preceding place; bounds and element ABI
                    // use the frozen projection terms.
                    val array: LLVMValueRef = LLVMBuildLoad2(self.b, currentTy, pointer, anon())
                    val data: LLVMValueRef = self.arrValData(c: inout c, arr: array)
                    val index: LLVMValueRef = LLVMBuildLoad2(self.b, self.midLocalTy(c: inout c, body: body, local: indexLocal), self.midLocalPtr(body: body, local: indexLocal), anon())
                    self.emitBoundsCheck(c: inout c, idx: index, count: self.rawbufCount(c: inout c, data: data))
                    currentTy = self.llvmTypeOfRef(c: inout c, ref: typeTerm)
                    pointer = self.arrElemPtr(elemTy: currentTy, data: data, idx: index)
                }
            }
            i += 1U64
        }
        return pointer
    }

    // Read the representation without acquiring or consuming ownership.
    // The enclosing Mid operation determines how that representation is used.
    inout fn midReadPlace(c: inout Comp, body: MidBody, place: MidPlace) -> LLVMValueRef {
        return LLVMBuildLoad2(self.b, self.midPlaceTy(c: inout c, body: body, place: place), self.midPlacePtr(c: inout c, body: body, place: place), anon())
    }

    inout fn midEmitOperand(c: inout Comp, body: MidBody, operand: MidOperand) -> LLVMValueRef {
        match operand {
            MidOperand.Copy(place: val place) => {
                val value: LLVMValueRef = self.midReadPlace(c: inout c, body: body, place: place)
                // Copy is an owned value operation under Plew value semantics.
                // The source place retains its owner; this new value receives
                // its own ARC share before any subsequent Mid drop consumes it.
                if place.typeTerm != 0U64 && place.typeTerm < c.arena.types.count() && c.arcNeedsRelease(ref: place.typeTerm) {
                    self.valueArc(c: inout c, v: value, typeRef: place.typeTerm, retain: true)
                }
                return value
            }
            MidOperand.Move(place: val place) => {
                return self.midReadPlace(c: inout c, body: body, place: place)
            }
            MidOperand.Borrow(place: val place, capability: _) => {
                // The first lowering slice has no by-reference consumer yet.
                // Keep the value load here only for copyable scalar control
                // operands; call/inout lowering will consume the place itself.
                return self.midReadPlace(c: inout c, body: body, place: place)
            }
            MidOperand.Constant(value: val value) => {
                match value {
                MidConstant.Integer(value: val integer, isNegative: val isNegative, isBool: val isBool, typeTerm: val term) => {
                        mut val ty: LLVMTypeRef = self.i64ty
                        if isBool { ty = self.i1ty }
                        else if term != 0U64 && term < c.arena.types.count() { ty = self.llvmTypeOfRef(c: inout c, ref: term) }
                        val literal: LLVMValueRef = LLVMConstInt(ty, integer, 0I32)
                    if isNegative { return LLVMBuildNeg(self.b, literal, anon()) }
                    return literal
                }
                MidConstant.StringLiteral(start: val start, len: val len, typeTerm: _) => {
                    return self.genLlvmStr(c: inout c, start: start, len: len)
                }
                MidConstant.FloatLiteral(start: val start, len: val len, typeTerm: val term) => {
                    return LLVMConstRealOfStringAndSize(self.llvmTypeOfRef(c: inout c, ref: term), floatTextCPtr(c: inout c, start: start, len: len), floatTextLen(c: inout c, start: start, len: len))
                }
                }
            }
            // An access marker is rejected by preflight. Returning null here
            // merely keeps this total lowering helper fail-closed if an
            // internal caller violates that boundary.
            MidOperand.Access(candidate: _) => { return LLVMConstNull(self.ptrty) }
        }
    }

    // A Buffer element slot is an owning destination.  Normal calls normalize
    // a by-value parameter to `Borrow`: that describes the call ABI (+0), not
    // permission for an escaping store to alias the caller's owner.  Therefore
    // a Borrow needs one ARC share here. Copy already acquired a share in
    // operand emission, and Move transfers its existing share into the slot.
    inout fn midOperandNeedsOwnedDestination(operand: MidOperand) -> Bool {
        match operand {
            MidOperand.Copy(place: _) => { return false }
            MidOperand.Move(place: _) => { return false }
            _ => { return true }
        }
    }

    inout fn midOperandTypeTerm(operand: MidOperand) -> U64 {
        match operand {
            MidOperand.Copy(place: val place) => { return place.typeTerm }
            MidOperand.Move(place: val place) => { return place.typeTerm }
            MidOperand.Borrow(place: val place, capability: _) => { return place.typeTerm }
            MidOperand.Constant(value: val value) => {
                match value {
                    MidConstant.Integer(value: _, isNegative: _, isBool: _, typeTerm: val term) => { return term }
                    MidConstant.StringLiteral(start: _, len: _, typeTerm: val term) => { return term }
                    MidConstant.FloatLiteral(start: _, len: _, typeTerm: val term) => { return term }
                }
            }
            MidOperand.Access(candidate: _) => { return 0U64 }
        }
    }

    inout fn midEmitDrop(c: inout Comp, body: MidBody, place: MidPlace) {
        mut val physicalFieldPath: Bool = true
        mut val projection: U64 = 0U64
        while projection < place.projections.count() {
            match place.projections[projection] {
                MidProjection.Field(index: _, typeTerm: _) => {}
                _ => { physicalFieldPath = false }
            }
            projection += 1U64
        }
        if place.local >= body.locals.count() || !physicalFieldPath { return }
        val typeRef: U64 = place.typeTerm
        val value: LLVMValueRef = LLVMBuildLoad2(self.b, self.midPlaceTy(c: inout c, body: body, place: place), self.midPlacePtr(c: inout c, body: body, place: place), anon())
        self.valueArc(c: inout c, v: value, typeRef: typeRef, retain: false)
    }

    // ConditionalDrop is the only ownership-generated branch in Path 1.  It
    // is produced by drop-elaboration, never by source-specific lowering.
    inout fn midEmitConditionalDrop(c: inout Comp, body: MidBody, place: MidPlace, flag: U64) {
        if flag >= body.locals.count() { return }
        val flagValue: LLVMValueRef = LLVMBuildLoad2(self.b, self.i1ty, self.midLocalPtr(body: body, local: flag), anon())
        val thenBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.drop"))
        val continueBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.drop.cont"))
        LLVMBuildCondBr(self.b, flagValue, thenBlock, continueBlock)
        LLVMPositionBuilderAtEnd(self.b, thenBlock)
        self.midEmitDrop(c: inout c, body: body, place: place)
        LLVMBuildBr(self.b, continueBlock)
        LLVMPositionBuilderAtEnd(self.b, continueBlock)
    }

    // Lower a fully frozen aggregate. The only declaration-shaped operation
    // remaining is `llvmTypeOfRef`/array representation for its selected
    // TypeTerm; no field name, variant spelling, source Expr, or overload is
    // consulted here.
    inout fn midEmitAggregate(c: inout Comp, body: MidBody, destination: MidPlace, kind: MidAggregateKind, resultTerm: U64, fieldCount: U64, elements: Array[MidAggregateElement]) -> LLVMValueRef {
        match kind {
            MidAggregateKind.Struct => {
                val ty: LLVMTypeRef = self.midLocalTy(c: inout c, body: body, local: destination.local)
                mut val value: LLVMValueRef = LLVMGetUndef(ty)
                mut val i: U64 = 0U64
                while i < elements.count() {
                    val element: MidAggregateElement = elements[i]
                    mut val child: LLVMValueRef = self.midEmitAggregateElement(c: inout c, body: body, element: element)
                    if element.isBoxed { child = self.midEmitAggregateBox(c: inout c, value: child) }
                    val fieldTy: LLVMTypeRef = LLVMStructGetTypeAtIndex(ty, truncU32(n: element.fieldIndex))
                    if LLVMGetTypeKind(LLVMTypeOf(child)) == 8U32 { child = self.coerceInt(v: child, target: fieldTy, unsigned: false) }
                    value = LLVMBuildInsertValue(self.b, value, child, element.fieldIndex, anon())
                    i += 1U64
                }
                return value
            }
            MidAggregateKind.Array => {
                if resultTerm >= c.arena.types.count() { return LLVMConstNull(self.ptrty) }
                val result: TypeRef = c.arena.types[resultTerm]
                if result.args.count() != 1U64 { return LLVMConstNull(self.ptrty) }
                val elemRef: U64 = result.args[0U64]
                val elemTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elemRef)
                mut val values: Array[LLVMValueRef] = []
                mut val i: U64 = 0U64
                while i < elements.count() {
                    val element: MidAggregateElement = elements[i]
                    val child: LLVMValueRef = self.midEmitAggregateElement(c: inout c, body: body, element: element)
                    values.append(child)
                    i += 1U64
                }
                return self.genLlvmArrayValues(c: inout c, values: values, elemTy: elemTy, elemRef: elemRef)
            }
            MidAggregateKind.Enum(enumIdx: val enumIdx, variantIndex: val variantIndex) => {
                if resultTerm >= c.arena.types.count() || enumIdx >= c.arena.enums.count() || variantIndex >= c.arena.enums[enumIdx].variants.count() { return LLVMConstNull(self.ptrty) }
                val resultType: TypeRef = c.arena.types[resultTerm]
                val savedParams: Array[Bind] = c.cur.typeParams
                val savedArgs: Array[U64] = c.cur.typeArgs
                c.cur.typeParams = c.arena.enums[enumIdx].typeParams
                c.cur.typeArgs = resultType.args
                mut val values: Array[LLVMValueRef] = []
                mut val i: U64 = 0U64
                while i < elements.count() {
                    val element: MidAggregateElement = elements[i]
                    mut val value: LLVMValueRef = self.midEmitAggregateElement(c: inout c, body: body, element: element)
                    if element.isBoxed { value = self.midEmitAggregateBox(c: inout c, value: value) }
                    values.append(value)
                    i += 1U64
                }
                val result: LLVMValueRef = self.buildEnumFromValues(c: inout c, eid: enumIdx, ety: self.midLocalTy(c: inout c, body: body, local: destination.local), vi: variantIndex, payloadVals: values)
                c.cur.typeParams = savedParams
                c.cur.typeArgs = savedArgs
                return result
            }
        }
    }

    // Constructing an aggregate is a value boundary just like a call.  The
    // semantic carrier has already selected the slot conversion; backend code
    // only realizes it and never compares declaration spellings or searches
    // for a witness. Each aggregate field takes the emitted owned Copy/Move
    // value without another retain. Borrow is the normal
    // by-value ABI (+0), not permission for the aggregate to alias its source
    // without retaining.  A non-identity proof returns a freshly owned
    // converted value itself.
    inout fn midEmitAggregateElement(c: inout Comp, body: MidBody, element: MidAggregateElement) -> LLVMValueRef {
        match c.thawValueConversionProof(id: element.conversion) {
            ValueConversionProof.Identity => {
                val value: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: element.operand)
                if self.midOperandNeedsOwnedDestination(operand: element.operand) {
                    self.valueArc(c: inout c, v: value, typeRef: element.targetTerm, retain: true)
                }
                return value
            }
            _ => { return self.midEmitValueConversion(c: inout c, body: body, operand: element.operand, conversion: c.thawValueConversionProof(id: element.conversion)) }
        }
    }

    // `MidAggregateElement.isBoxed` is a frontend-frozen physical layout fact.
    // The emitted child already carries exactly one owned share for the
    // aggregate slot; moving it into this fresh rc=1 cell transfers that share
    // without retain/release. The aggregate's normal drop path owns and later
    // releases the cell, which in turn destroys this stored logical value.
    // No FieldDef or source expression is consulted here.
    inout fn midEmitAggregateBox(c: inout Comp, value: LLVMValueRef) -> LLVMValueRef {
        val valueTy: LLVMTypeRef = LLVMTypeOf(value)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(valueTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        LLVMBuildStore(self.b, value, cell)
        return cell
    }

    // Materialize the exact frontend-selected existential conversion.  The
    // only lookup here is TypeRef -> physical struct layout, which is backend
    // layout realization; trait selection, source expression typing, and
    // candidate search were already frozen in `conversion`.
    inout fn midEmitValueConversion(c: inout Comp, body: MidBody, operand: MidOperand, conversion: ValueConversionProof) -> LLVMValueRef {
        match conversion {
            ValueConversionProof.ExistentialBox(sourceRef: val sourceRef, targetRef: val targetRef, traitIdx: val traitIdx, proof: val proof) => {
                if sourceRef == 0U64 || sourceRef >= c.arena.types.count() || targetRef == 0U64 || targetRef >= c.arena.types.count() || traitIdx >= c.decls.traits.count() || c.proofIsMissing(proof: proof) { return LLVMConstNull(self.anyTy) }
                if !(c.typeRefEq(a: self.midOperandTypeTerm(operand: operand), b: sourceRef)) { return LLVMConstNull(self.anyTy) }
                val source: TypeRef = c.arena.types[sourceRef]
                val structIdx: U64 = c.structIndexByName(start: source.nameStart, len: source.nameLen)
                if structIdx >= c.arena.structs.count() { return LLVMConstNull(self.anyTy) }
                val value: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: operand)
                // The box takes the operand's ownership. Only a borrowed
                // value still needs a share; Copy acquired it during emission.
                if self.midOperandNeedsOwnedDestination(operand: operand) {
                    self.valueArc(c: inout c, v: value, typeRef: sourceRef, retain: true)
                }
                return self.boxIntoAny(c: inout c, v: value, sidx: structIdx, anyRef: targetRef, traitIdx: traitIdx)
            }
            ValueConversionProof.ArrayRepack(sourceRef: val sourceRef, targetRef: val targetRef, element: val element) => {
                // A structural repack reads its source as a borrow and creates
                // an independently-owned destination buffer.  A Move source
                // needs a separate consume/drop rule before it can join this
                // initial slice; never silently treat that transfer as Copy.
                match operand {
                    MidOperand.Copy(place: val place) => {
                        return self.midEmitArrayRepack(c: inout c, body: body, source: self.midReadPlace(c: inout c, body: body, place: place), sourceRef: sourceRef, targetRef: targetRef, element: element)
                    }
                    _ => { return LLVMConstNull(self.ptrty) }
                }
            }
            ValueConversionProof.EnumRepack(sourceRef: val sourceRef, targetRef: val targetRef, enumIdx: val enumIdx, payloads: val payloads) => {
                match operand {
                    MidOperand.Copy(place: val place) => {
                        return self.midEmitEnumRepack(c: inout c, source: self.midReadPlace(c: inout c, body: body, place: place), sourceRef: sourceRef, targetRef: targetRef, enumIdx: enumIdx, payloads: payloads)
                    }
                    _ => { return LLVMConstNull(self.ptrty) }
                }
            }
            _ => { return LLVMConstNull(self.anyTy) }
        }
    }

    // Convert one borrowed array element according to a frontend proof.  The
    // identity case retains because the freshly allocated destination buffer
    // becomes a second value-semantic owner; every non-identity case creates
    // its own owned representation recursively.
    inout fn midEmitBorrowedConversion(c: inout Comp, value: LLVMValueRef, sourceRef: U64, targetRef: U64, conversion: ValueConversionProof) -> LLVMValueRef {
        match conversion {
            ValueConversionProof.Identity => {
                self.valueArc(c: inout c, v: value, typeRef: sourceRef, retain: true)
                return value
            }
            ValueConversionProof.ExistentialBox(sourceRef: val proofSource, targetRef: val proofTarget, traitIdx: val traitIdx, proof: val proof) => {
                if !(c.typeRefEq(a: sourceRef, b: proofSource)) || !(c.typeRefEq(a: targetRef, b: proofTarget)) || c.proofIsMissing(proof: proof) { return LLVMConstNull(self.anyTy) }
                val source: TypeRef = c.arena.types[sourceRef]
                val structIdx: U64 = c.structIndexByName(start: source.nameStart, len: source.nameLen)
                if structIdx >= c.arena.structs.count() { return LLVMConstNull(self.anyTy) }
                self.valueArc(c: inout c, v: value, typeRef: sourceRef, retain: true)
                return self.boxIntoAny(c: inout c, v: value, sidx: structIdx, anyRef: targetRef, traitIdx: traitIdx)
            }
            ValueConversionProof.ArrayRepack(sourceRef: val proofSource, targetRef: val proofTarget, element: val child) => {
                if !(c.typeRefEq(a: sourceRef, b: proofSource)) || !(c.typeRefEq(a: targetRef, b: proofTarget)) { return LLVMConstNull(self.ptrty) }
                return self.midEmitArrayRepack(c: inout c, body: <MidBody />, source: value, sourceRef: sourceRef, targetRef: targetRef, element: child)
            }
            ValueConversionProof.EnumRepack(sourceRef: val proofSource, targetRef: val proofTarget, enumIdx: val enumIdx, payloads: val payloads) => {
                if !(c.typeRefEq(a: sourceRef, b: proofSource)) || !(c.typeRefEq(a: targetRef, b: proofTarget)) { return LLVMConstNull(self.ptrty) }
                return self.midEmitEnumRepack(c: inout c, source: value, sourceRef: sourceRef, targetRef: targetRef, enumIdx: enumIdx, payloads: payloads)
            }
            _ => { return LLVMConstNull(self.ptrty) }
        }
    }

    // Repack Array[S] into Array[T] without consulting an expression or asking
    // the backend whether S conforms to anything.  `element` is the exact
    // recursive frontend choice for S -> T.
    inout fn midEmitArrayRepack(c: inout Comp, body: MidBody, source: LLVMValueRef, sourceRef: U64, targetRef: U64, element: ValueConversionProof) -> LLVMValueRef {
        if sourceRef >= c.arena.types.count() || targetRef >= c.arena.types.count() { return LLVMConstNull(self.ptrty) }
        val sourceType: TypeRef = c.arena.types[sourceRef]
        val targetType: TypeRef = c.arena.types[targetRef]
        if sourceType.args.count() != 1U64 || targetType.args.count() != 1U64 { return LLVMConstNull(self.ptrty) }
        val sourceElementRef: U64 = sourceType.args[0U64]
        val targetElementRef: U64 = targetType.args[0U64]
        val sourceElementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: sourceElementRef)
        val targetElementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: targetElementRef)
        val sourceData: LLVMValueRef = self.arrValData(c: inout c, arr: source)
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: sourceData)
        val targetData: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(targetElementTy), cap: count)
        val indexSlot: LLVMValueRef = self.entryAlloca(ty: self.i64ty)
        LLVMBuildStore(self.b, LLVMConstInt(self.i64ty, 0U64, 0I32), indexSlot)
        val condition: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.repack.array.cond"))
        val loop: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.repack.array.body"))
        val done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.repack.array.done"))
        LLVMBuildBr(self.b, condition)
        LLVMPositionBuilderAtEnd(self.b, condition)
        val index: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, indexSlot, anon())
        LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntUlt(), index, count, anon()), loop, done)
        LLVMPositionBuilderAtEnd(self.b, loop)
        val sourceElement: LLVMValueRef = LLVMBuildLoad2(self.b, sourceElementTy, self.arrElemPtr(elemTy: sourceElementTy, data: sourceData, idx: index), anon())
        val converted: LLVMValueRef = self.midEmitBorrowedConversion(c: inout c, value: sourceElement, sourceRef: sourceElementRef, targetRef: targetElementRef, conversion: element)
        LLVMBuildStore(self.b, self.coerceElem(v: converted, elemTy: targetElementTy), self.arrElemPtr(elemTy: targetElementTy, data: targetData, idx: index))
        LLVMBuildStore(self.b, LLVMBuildAdd(self.b, index, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), indexSlot)
        LLVMBuildBr(self.b, condition)
        LLVMPositionBuilderAtEnd(self.b, done)
        return self.arrValMake(c: inout c, data: targetData, count: count, aggTy: self.arrayInstTy(c: inout c, elemRef: targetElementRef))
    }

    // Repack a generic enum using the exact proof for each physical payload.
    // The declaration is consulted only for physical variant/payload layout;
    // no source expression, trait lookup, or compatibility search is reopened.
    inout fn midEmitEnumRepack(c: inout Comp, source: LLVMValueRef, sourceRef: U64, targetRef: U64, enumIdx: U64, payloads: Array[EnumPayloadConversion]) -> LLVMValueRef {
        if sourceRef >= c.arena.types.count() || targetRef >= c.arena.types.count() || enumIdx >= c.arena.enums.count() { return LLVMConstNull(self.ptrty) }
        val sourceSlot: U64 = self.genEnumSlot(c: inout c, ref: sourceRef)
        val targetSlot: U64 = self.genEnumSlot(c: inout c, ref: targetRef)
        if sourceSlot >= self.genEnumRefs.count() || targetSlot >= self.genEnumRefs.count() || self.genEnumDefs[sourceSlot] != enumIdx || self.genEnumDefs[targetSlot] != enumIdx { return LLVMConstNull(self.ptrty) }
        val sourceType: TypeRef = c.arena.types[sourceRef]
        val targetType: TypeRef = c.arena.types[targetRef]
        if sourceType.args.count() != targetType.args.count() { return LLVMConstNull(self.ptrty) }
        val sourceLlvmType: LLVMTypeRef = self.genEnumTys[sourceSlot]
        val targetLlvmType: LLVMTypeRef = self.genEnumTys[targetSlot]
        val sourceSlotPtr: LLVMValueRef = self.entryAlloca(ty: sourceLlvmType)
        LLVMBuildStore(self.b, source, sourceSlotPtr)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, sourceLlvmType, sourceSlotPtr, 0U64, anon()), anon())
        val sourcePayloadPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, sourceLlvmType, sourceSlotPtr, 1U64, anon())
        val resultSlot: LLVMValueRef = self.entryAlloca(ty: targetLlvmType)
        val end: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.repack.enum.end"))
        val savedParams: Array[Bind] = c.cur.typeParams
        val savedArgs: Array[U64] = c.cur.typeArgs
        mut val payloadIndex: U64 = 0U64
        mut val variant: U64 = 0U64
        while variant < c.arena.enums[enumIdx].variants.count() {
            val matched: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.repack.enum.variant"))
            val next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.repack.enum.next"))
            LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, variant, 0I32), anon()), matched, next)
            LLVMPositionBuilderAtEnd(self.b, matched)
            val fields: Array[FieldDef] = c.arena.enums[enumIdx].variants[variant].fields
            mut val values: Array[LLVMValueRef] = []
            if fields.count() > 0U64 {
                c.cur.typeParams = c.arena.enums[enumIdx].typeParams
                c.cur.typeArgs = sourceType.args
                val sourcePayloadType: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: enumIdx, vi: variant)
                val payload: LLVMValueRef = LLVMBuildLoad2(self.b, sourcePayloadType, sourcePayloadPtr, anon())
                c.cur.typeParams = savedParams
                c.cur.typeArgs = savedArgs
                mut val field: U64 = 0U64
                while field < fields.count() {
                    val value: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, field, anon())
                    if payloadIndex >= payloads.count() { return LLVMConstNull(targetLlvmType) }
                    val payloadConversion: EnumPayloadConversion = payloads[payloadIndex]
                    match payloadConversion.conversion { ValueConversionProof.Missing => { return LLVMConstNull(targetLlvmType) } _ => {} }
                    values.append(self.midEmitBorrowedConversion(c: inout c, value: value, sourceRef: payloadConversion.sourceRef, targetRef: payloadConversion.targetRef, conversion: payloadConversion.conversion))
                    payloadIndex += 1U64
                    field += 1U64
                }
            }
            c.cur.typeParams = c.arena.enums[enumIdx].typeParams
            c.cur.typeArgs = targetType.args
            val rebuilt: LLVMValueRef = self.buildEnumFromValues(c: inout c, eid: enumIdx, ety: targetLlvmType, vi: variant, payloadVals: values)
            c.cur.typeParams = savedParams
            c.cur.typeArgs = savedArgs
            LLVMBuildStore(self.b, rebuilt, resultSlot)
            LLVMBuildBr(self.b, end)
            LLVMPositionBuilderAtEnd(self.b, next)
            variant += 1U64
        }
        if payloadIndex != payloads.count() { return LLVMConstNull(targetLlvmType) }
        LLVMBuildStore(self.b, LLVMConstNull(targetLlvmType), resultSlot)
        LLVMBuildBr(self.b, end)
        LLVMPositionBuilderAtEnd(self.b, end)
        return LLVMBuildLoad2(self.b, targetLlvmType, resultSlot, anon())
    }

    inout fn midEmitStatement(c: inout Comp, body: MidBody, statement: MidStatement) {
        match statement {
            MidStatement.Assign(destination: val destination, value: val rvalue) => {
                match rvalue {
                    MidRvalue.Use(operand: val operand) => {
                        mut val value: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: operand)
                        val ty: LLVMTypeRef = self.midLocalTy(c: inout c, body: body, local: destination.local)
                        if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 { value = self.coerceInt(v: value, target: ty, unsigned: false) }
                        // Operand emission already acquired Copy's one owned
                        // share (or transferred Move's). Store takes that share.
                        LLVMBuildStore(self.b, value, self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.ReturnBoundary(exprId: _, targetTerm: _, operand: val operand) => {
                        mut val value: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: operand)
                        val ty: LLVMTypeRef = self.midLocalTy(c: inout c, body: body, local: destination.local)
                        if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 { value = self.coerceInt(v: value, target: ty, unsigned: false) }
                        LLVMBuildStore(self.b, value, self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.Aggregate(exprId: _, kind: val kind, resultTerm: val resultTerm, fieldCount: val fieldCount, elements: val elements) => {
                        val value: LLVMValueRef = self.midEmitAggregate(c: inout c, body: body, destination: destination, kind: kind, resultTerm: resultTerm, fieldCount: fieldCount, elements: elements)
                        LLVMBuildStore(self.b, value, self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.Convert(operand: val operand, conversion: val conversion) => {
                        val value: LLVMValueRef = self.midEmitValueConversion(c: inout c, body: body, operand: operand, conversion: c.thawValueConversionProof(id: conversion))
                        LLVMBuildStore(self.b, value, self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: _, operand: _) => {
                        // Preflight rejects this form. Keep an unreachable-safe
                        // store shape for bootstrap enum exhaustiveness.
                        LLVMBuildStore(self.b, LLVMConstNull(self.midLocalTy(c: inout c, body: body, local: destination.local)), self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.Cast(operand: val operand, kind: val kind, targetTerm: val targetTerm) => {
                        val targetTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: targetTerm)
                        val source: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: operand)
                        mut val value: LLVMValueRef = source
                        match kind {
                            MidCastKind.IntegerWiden(sourceSigned: val sourceSigned) => {
                                value = self.coerceInt(v: source, target: targetTy, unsigned: !sourceSigned)
                            }
                            MidCastKind.IntegerToFloat(sourceSigned: val sourceSigned) => {
                                if sourceSigned { value = LLVMBuildSIToFP(self.b, source, targetTy, anon()) }
                                else { value = LLVMBuildUIToFP(self.b, source, targetTy, anon()) }
                            }
                            MidCastKind.IdentityRetag => {}
                        }
                        LLVMBuildStore(self.b, value, self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.EnumTag(place: val place, enumIndex: _, sourceStmt: _, resultTerm: _) => {
                        val enumTy: LLVMTypeRef = self.midPlaceTy(c: inout c, body: body, place: place)
                        val tagPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, enumTy, self.midPlacePtr(c: inout c, body: body, place: place), 0U64, anon())
                        LLVMBuildStore(self.b, LLVMBuildLoad2(self.b, self.i64ty, tagPtr, anon()), self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.EnumPayloadCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: _, sourceStmt: _, resultTerm: _) => {
                        val enumTy: LLVMTypeRef = self.midPlaceTy(c: inout c, body: body, place: place)
                        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: enumIndex, vi: variantIndex, instanceRef: place.typeTerm)
                        val payloadPtr: LLVMValueRef = self.enumMatchPayloadStorage(c: inout c, scrutTy: enumTy, scrutSlot: self.midPlacePtr(c: inout c, body: body, place: place), instanceRef: place.typeTerm)
                        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, payloadPtr, anon())
                        val field: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, fieldIndex, anon())
                        LLVMBuildStore(self.b, field, self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.EnumPayloadBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: _, sourceStmt: _, resultTerm: _) => {
                        val enumTy: LLVMTypeRef = self.midPlaceTy(c: inout c, body: body, place: place)
                        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: enumIndex, vi: variantIndex, instanceRef: place.typeTerm)
                        val payloadPtr: LLVMValueRef = self.enumMatchPayloadStorage(c: inout c, scrutTy: enumTy, scrutSlot: self.midPlacePtr(c: inout c, body: body, place: place), instanceRef: place.typeTerm)
                        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, payloadPtr, anon())
                        LLVMBuildStore(self.b, LLVMBuildExtractValue(self.b, payload, fieldIndex, anon()), self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.EnumPayloadBoxedCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: _, sourceStmt: _, resultTerm: val resultTerm) => {
                        val enumTy: LLVMTypeRef = self.midPlaceTy(c: inout c, body: body, place: place)
                        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: enumIndex, vi: variantIndex, instanceRef: place.typeTerm)
                        val payloadPtr: LLVMValueRef = self.enumMatchPayloadStorage(c: inout c, scrutTy: enumTy, scrutSlot: self.midPlacePtr(c: inout c, body: body, place: place), instanceRef: place.typeTerm)
                        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, payloadPtr, anon())
                        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, fieldIndex, anon())
                        LLVMBuildStore(self.b, LLVMBuildLoad2(self.b, self.llvmTypeOfRef(c: inout c, ref: resultTerm), cell, anon()), self.midLocalPtr(body: body, local: destination.local))
                    }
                    MidRvalue.EnumPayloadBoxedBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: _, sourceStmt: _, resultTerm: val resultTerm) => {
                        val enumTy: LLVMTypeRef = self.midPlaceTy(c: inout c, body: body, place: place)
                        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: enumIndex, vi: variantIndex, instanceRef: place.typeTerm)
                        val payloadPtr: LLVMValueRef = self.enumMatchPayloadStorage(c: inout c, scrutTy: enumTy, scrutSlot: self.midPlacePtr(c: inout c, body: body, place: place), instanceRef: place.typeTerm)
                        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, payloadPtr, anon())
                        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, fieldIndex, anon())
                        LLVMBuildStore(self.b, LLVMBuildLoad2(self.b, self.llvmTypeOfRef(c: inout c, ref: resultTerm), cell, anon()), self.midLocalPtr(body: body, local: destination.local))
                    }
                }
            }
            MidStatement.Overwrite(destination: val destination, source: val source) => {
                val ty: LLVMTypeRef = self.midPlaceTy(c: inout c, body: body, place: destination)
                val value: LLVMValueRef = LLVMBuildLoad2(self.b, ty, self.midLocalPtr(body: body, local: source.local), anon())
                LLVMBuildStore(self.b, value, self.midPlacePtr(c: inout c, body: body, place: destination))
            }
            MidStatement.Drop(place: val place) => { self.midEmitDrop(c: inout c, body: body, place: place) }
            MidStatement.ConditionalDrop(place: val place, flag: val flag) => { self.midEmitConditionalDrop(c: inout c, body: body, place: place, flag: flag) }
            MidStatement.SetDropFlag(local: val local, isSet: val isSet) => {
                mut val bit: U64 = 0U64
                if isSet { bit = 1U64 }
                LLVMBuildStore(self.b, LLVMConstInt(self.i1ty, bit, 0I32), self.midLocalPtr(body: body, local: local))
            }
            // A verified body must have erased every ScopeExit. Leave a loud
            // unreachable marker if this invariant is violated in a release
            // build where diagnostics continue after c.errorAt.
            MidStatement.ScopeExit(scope: _) => { LLVMBuildUnreachable(self.b) }
            MidStatement.Nop => {}
        }
    }

    // A canonical call has already been instantiated: the target row names a
    // final CallResolution and its argument range carries the selected ABI
    // modes.  Read those rows directly; never rebuild MidCallReceiver or an
    // Array[MidOperand] just to call the draft emitter.
    inout fn midCanonicalReceiverSupported(c: inout Comp, body: MidBodyNode, receiverId: U64, passing: CallReceiverPassing) -> Bool {
        if receiverId == 0U64 || receiverId > c.mid.callReceivers.count() { return false }
        val receiver: MidCallReceiverNode = c.mid.callReceivers[receiverId - 1U64]
        match passing {
            CallReceiverPassing.None => { return receiver.tag == 1U64 }
            CallReceiverPassing.Borrow => {
                if receiver.tag != 2U64 || receiver.operand == 0U64 || receiver.operand > c.mid.operands.count() { return false }
                val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                return operand.tag == 3U64 && operand.capability == 1U64 && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place)
            }
            CallReceiverPassing.Inout => {
                if receiver.tag != 2U64 || receiver.operand == 0U64 || receiver.operand > c.mid.operands.count() { return false }
                val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                return operand.tag == 3U64 && operand.capability == 2U64 && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place)
            }
            CallReceiverPassing.Move => {
                if receiver.tag != 2U64 || receiver.operand == 0U64 || receiver.operand > c.mid.operands.count() { return false }
                val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                return operand.tag == 2U64 && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place)
            }
        }
    }

    inout fn midCanonicalDirectCallPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target { CallTarget.Direct => {} _ => { return <MidCallPreflight.Target /> } }
        if selected.callee >= c.arena.funcs.count() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.funcs[selected.callee]
        if callee.isAsync { return <MidCallPreflight.Async /> }
        if callee.hasRecv {
            if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: selected.receiverPassing) { return <MidCallPreflight.Receiver /> }
        } else if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.Receiver /> }
        if callee.isExtern && !self.resolvedCCallSupported(c: inout c, selected: selected) { return <MidCallPreflight.Extern /> }
        if callee.typeParams.count() != selected.calleeTypeArgs.len { return <MidCallPreflight.GenericArguments /> }
        if callee.typeParams.count() > 0U64 && !(c.fnArgsAllGround(args: c.copyFinalCalleeTypeArgs(args: selected.calleeTypeArgs))) { return <MidCallPreflight.GenericArguments /> }
        if term.args.len != callee.params.count() || selected.parameterTypeRefs.len != term.args.len || selected.argumentPassings.len != term.args.len { return <MidCallPreflight.ArgumentShape /> }
        if callee.hasRet {
            if term.destination == 0U64 || term.destination > c.mid.places.count() || c.mid.places[term.destination - 1U64].projections.len != 0U64 || selected.resultTypeRef == 0U64 { return <MidCallPreflight.Result /> }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            val operandId: U64 = c.mid.callArguments[term.args.start + argumentI]
            if operandId == 0U64 || operandId > c.mid.operands.count() || c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: argumentI) >= c.arena.types.count() { return <MidCallPreflight.ArgumentShape /> }
            val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
            match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: argumentI) {
                CallArgumentPassing.Inout => { if operand.tag != 3U64 || operand.capability != 2U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> } }
                CallArgumentPassing.Move => { if operand.tag != 2U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> } }
                CallArgumentPassing.Borrow => {
                    if operand.tag == 3U64 {
                        if operand.capability != 1U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> }
                    } else if operand.tag != 5U64 && operand.tag != 6U64 && operand.tag != 7U64 { return <MidCallPreflight.Argument /> }
                }
            }
            argumentI = argumentI + 1U64
        }
        return <MidCallPreflight.None />
    }

    fn midCanonicalCallArgumentAt(c: Comp, term: MidTerminatorNode, index: U64) -> U64 {
        if index >= term.args.len || term.args.start + index >= c.mid.callArguments.count() { return 0U64 }
        return c.mid.callArguments[term.args.start + index]
    }

    inout fn midCanonicalRuntimeReadOperandSupported(c: inout Comp, body: MidBodyNode, operandId: U64) -> Bool {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return false }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag == 3U64 { return operand.capability == 1U64 && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) }
        return operand.tag == 5U64 || operand.tag == 6U64 || operand.tag == 7U64
    }

    inout fn midCanonicalRuntimeProcessIoPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target { CallTarget.RuntimeIntrinsic(intrinsic: _) => {} _ => { return <MidCallPreflight.Target /> } }
        if selected.callee >= c.arena.funcs.count() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.funcs[selected.callee]
        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.RuntimeAbi /> }
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.Process(intrinsic: val process) => {
                        match process {
                            ProcessIntrinsic.ArgCount => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.ArgAt => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.Exit => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.ExecOut => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.ExecCode => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                        }
                    }
                    RuntimeIntrinsic.Io(intrinsic: val io) => {
                        match io {
                            IoIntrinsic.Write => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.WriteByte => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.ReadStdin => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.ReadFile => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.ReadFileBytes => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.Eprint => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.FileExists => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                        }
                    }
                    _ => { return <MidCallPreflight.Target /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            if !self.midCanonicalRuntimeReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: argumentI)) { return <MidCallPreflight.Argument /> }
            argumentI = argumentI + 1U64
        }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitRuntimeProcessIoCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalRuntimeProcessIoPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        val callee: Func = c.arena.funcs[selected.callee]
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.Io(intrinsic: val io) => {
                        match io {
                            IoIntrinsic.Write => { self.emitStrSinkValue(c: inout c, rtName: "plew_write_raw", rtId: 2U64, value: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))) }
                            IoIntrinsic.Eprint => { self.emitStrSinkValue(c: inout c, rtName: "plew_eprint_raw", rtId: 3U64, value: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))) }
                            IoIntrinsic.WriteByte => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.i8ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.coerceInt(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)), target: self.i8ty, unsigned: true))
                                LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_writeByte", nameId: 52U64, fnTy: signature), arrayCPtr(values), 1U64, anon())
                            }
                            IoIntrinsic.ReadStdin => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                val signature: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(parameters), 0U64, 0I32)
                                val result: LLVMValueRef = LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_readStdin", nameId: 27U64, fnTy: signature), arrayCPtr(parameters), 0U64, anon())
                                LLVMBuildStore(self.b, result, self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            IoIntrinsic.ReadFile => { LLVMBuildStore(self.b, self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_readFile", rtId: 55U64, retTy: self.stringLlvmTy(c: inout c), path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                            IoIntrinsic.ReadFileBytes => { LLVMBuildStore(self.b, self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_readFileBytes", rtId: 53U64, retTy: self.stringLlvmTy(c: inout c), path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                            IoIntrinsic.FileExists => {
                                val raw: LLVMValueRef = self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_fileExists", rtId: 54U64, retTy: self.i64ty, path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)))
                                LLVMBuildStore(self.b, LLVMBuildICmp(self.b, llvmIntNe(), raw, LLVMConstInt(self.i64ty, 0U64, 0I32), anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                        }
                        return true
                    }
                    RuntimeIntrinsic.Process(intrinsic: val process) => {
                        match process {
                            ProcessIntrinsic.ArgCount => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                val signature: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(parameters), 0U64, 0I32)
                                LLVMBuildStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_argCount", nameId: 50U64, fnTy: signature), arrayCPtr(parameters), 0U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            ProcessIntrinsic.ArgAt => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.i64ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.extendToI64(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)), unsigned: false))
                                LLVMBuildStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_argAt", nameId: 51U64, fnTy: signature), arrayCPtr(values), 1U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            ProcessIntrinsic.ExecOut => { LLVMBuildStore(self.b, self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_execOut", rtId: 70U64, retTy: self.stringLlvmTy(c: inout c), path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                            ProcessIntrinsic.ExecCode => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                val signature: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(parameters), 0U64, 0I32)
                                LLVMBuildStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_execCode", nameId: 71U64, fnTy: signature), arrayCPtr(parameters), 0U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            ProcessIntrinsic.Exit => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.i64ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.extendToI64(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)), unsigned: false))
                                LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_exit", nameId: 1U64, fnTy: signature), arrayCPtr(values), 1U64, anon())
                            }
                        }
                        return true
                    }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn midCanonicalCallPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        val direct: MidCallPreflight = self.midCanonicalDirectCallPreflight(c: inout c, body: body, terminatorId: terminatorId)
        match direct { MidCallPreflight.Target => { return self.midCanonicalRuntimeProcessIoPreflight(c: inout c, body: body, terminatorId: terminatorId) } _ => { return direct } }
    }

    inout fn midCanonicalEmitCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalDirectCallPreflight(c: inout c, body: body, terminatorId: terminatorId) {
            MidCallPreflight.None => { return self.midCanonicalEmitDirectCall(c: inout c, body: body, terminatorId: terminatorId) }
            MidCallPreflight.Target => { return self.midCanonicalEmitRuntimeProcessIoCall(c: inout c, body: body, terminatorId: terminatorId) }
            _ => { return false }
        }
    }

    inout fn midCanonicalEmitDirectCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalDirectCallPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        val callee: Func = c.arena.funcs[selected.callee]
        mut val externalSlot: U64 = self.declId.count()
        if callee.isExtern { externalSlot = self.declareResolvedCFunction(c: inout c, selected: selected) }
        mut val methodSlot: U64 = self.genMethK.count()
        mut val freeSlot: U64 = self.genFnK.count()
        mut val useMethod: Bool = false
        if !callee.isExtern {
            val typeArgs: Array[U64] = c.copyFinalCalleeTypeArgs(args: selected.calleeTypeArgs)
            if callee.hasRecv {
                if selected.recvTypeRef == 0U64 { return false }
                val receiverType: TypeRef = c.arena.types[selected.recvTypeRef]
                val receiverArgCount: U64 = c.recvParamCount(nameStart: receiverType.nameStart, nameLen: receiverType.nameLen)
                mut val ownArgs: Array[U64] = []
                mut val typeArgI: U64 = receiverArgCount
                while typeArgI < typeArgs.count() {
                    ownArgs.append(typeArgs[typeArgI])
                    typeArgI = typeArgI + 1U64
                }
                methodSlot = self.ensureGenMethodDeclared(c: inout c, mfi: selected.callee, instRef: selected.recvTypeRef, ownArgs: ownArgs, bodyId: selected.calleeBodyId)
                if methodSlot >= self.genMethK.count() { return false }
                useMethod = true
            } else {
                freeSlot = self.ensureFnInst(c: inout c, fnIdx: selected.callee, args: typeArgs, recvInstRef: selected.recvTypeRef)
                if freeSlot >= self.genFnK.count() { return false }
            }
        }
        mut val values: Array[LLVMValueRef] = []
        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if receiver.tag == 2U64 {
            val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
            match selected.receiverPassing {
                CallReceiverPassing.Inout => { values.append(self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[operand.place - 1U64])) }
                CallReceiverPassing.Borrow => { values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: receiver.operand)) }
                CallReceiverPassing.Move => { values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: receiver.operand)) }
                _ => { return false }
            }
        } else {
            match selected.receiverPassing {
                CallReceiverPassing.None => {}
                _ => { return false }
            }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            val operandId: U64 = c.mid.callArguments[term.args.start + argumentI]
            val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
            val parameterRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: argumentI)
            mut val value: LLVMValueRef = LLVMConstNull(self.ptrty)
            match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: argumentI) {
                CallArgumentPassing.Inout => { value = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[operand.place - 1U64]) }
                _ => {
                    value = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: operandId)
                    if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 {
                        val parameter: TypeRef = c.arena.types[parameterRef]
                        value = self.coerceInt(v: value, target: self.llvmTypeOfRef(c: inout c, ref: parameterRef), unsigned: isUnsignedName(c: inout c, start: parameter.nameStart, len: parameter.nameLen))
                    }
                }
            }
            values.append(value)
            argumentI = argumentI + 1U64
        }
        mut val result: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        if callee.isExtern { result = LLVMBuildCall2(self.b, self.declTy[externalSlot], self.declFn[externalSlot], arrayCPtr(values), values.count(), anon()) }
        else if useMethod { result = LLVMBuildCall2(self.b, self.genMethTy[methodSlot], self.genMethVal[methodSlot], arrayCPtr(values), values.count(), anon()) }
        else { result = LLVMBuildCall2(self.b, self.genFnTy[freeSlot], self.genFnVal[freeSlot], arrayCPtr(values), values.count(), anon()) }
        if callee.hasRet {
            val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
            LLVMBuildStore(self.b, self.midProjectCallResult(selected: selected, value: result), self.midCanonicalLocalPtr(body: body, local: destination.local))
        }
        return true
    }

    inout fn midCanonicalEmitDrop(c: inout Comp, body: MidBodyNode, placeId: U64) -> Bool {
        if placeId == 0U64 || placeId > c.mid.places.count() { return false }
        val place: MidPlaceNode = c.mid.places[placeId - 1U64]
        if place.local >= body.locals.len { return false }
        mut val projectionI: U64 = 0U64
        while projectionI < place.projections.len {
            if c.mid.projections[place.projections.start + projectionI].tag != 1U64 { return false }
            projectionI = projectionI + 1U64
        }
        val value: LLVMValueRef = self.midCanonicalReadPlace(c: inout c, body: body, place: place)
        self.valueArc(c: inout c, v: value, typeRef: place.typeTerm, retain: false)
        return true
    }

    inout fn midCanonicalEmitConditionalDrop(c: inout Comp, body: MidBodyNode, placeId: U64, flag: U64) -> Bool {
        if flag >= body.locals.len { return false }
        val flagValue: LLVMValueRef = LLVMBuildLoad2(self.b, self.i1ty, self.midCanonicalLocalPtr(body: body, local: flag), anon())
        val thenBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.drop"))
        val continueBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.drop.cont"))
        LLVMBuildCondBr(self.b, flagValue, thenBlock, continueBlock)
        LLVMPositionBuilderAtEnd(self.b, thenBlock)
        if !self.midCanonicalEmitDrop(c: inout c, body: body, placeId: placeId) { return false }
        LLVMBuildBr(self.b, continueBlock)
        LLVMPositionBuilderAtEnd(self.b, continueBlock)
        return true
    }

    inout fn midCanonicalEmitAggregateElement(c: inout Comp, body: MidBodyNode, element: MidAggregateElementNode) -> LLVMValueRef {
        // Non-identity conversions have their own canonical conversion slice;
        // never repackage this operand into MidOperand merely to reuse draft
        // lowering.  The direct aggregate path admits the identity boundary
        // first and remains fail-closed for the rest.
        if !c.conversionProofIsIdentity(id: element.conversion) { return LLVMConstNull(self.ptrty) }
        val value: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: element.operand)
        if element.operand != 0U64 && element.operand <= c.mid.operands.count() {
            val operand: MidOperandNode = c.mid.operands[element.operand - 1U64]
            if operand.tag != 1U64 && operand.tag != 2U64 && element.targetTerm != 0U64 && element.targetTerm < c.arena.types.count() && c.arcNeedsRelease(ref: element.targetTerm) {
                self.valueArc(c: inout c, v: value, typeRef: element.targetTerm, retain: true)
            }
        }
        return value
    }

    inout fn midCanonicalEmitAggregate(c: inout Comp, body: MidBodyNode, destination: MidPlaceNode, value: MidRvalueNode) -> LLVMValueRef {
        if value.tag == 3U64 {
            val ty: LLVMTypeRef = self.midCanonicalPlaceTy(c: inout c, body: body, place: destination)
            mut val aggregate: LLVMValueRef = LLVMGetUndef(ty)
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
                mut val child: LLVMValueRef = self.midCanonicalEmitAggregateElement(c: inout c, body: body, element: element)
                if element.isBoxed { child = self.midEmitAggregateBox(c: inout c, value: child) }
                val fieldTy: LLVMTypeRef = LLVMStructGetTypeAtIndex(ty, truncU32(n: element.fieldIndex))
                if LLVMGetTypeKind(LLVMTypeOf(child)) == 8U32 { child = self.coerceInt(v: child, target: fieldTy, unsigned: false) }
                aggregate = LLVMBuildInsertValue(self.b, aggregate, child, element.fieldIndex, anon())
                elementI = elementI + 1U64
            }
            return aggregate
        }
        if value.tag == 5U64 {
            if value.resultTerm == 0U64 || value.resultTerm >= c.arena.types.count() { return LLVMConstNull(self.ptrty) }
            val result: TypeRef = c.arena.types[value.resultTerm]
            if result.args.count() != 1U64 { return LLVMConstNull(self.ptrty) }
            val elementRef: U64 = result.args[0U64]
            val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
            mut val elements: Array[LLVMValueRef] = []
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                elements.append(self.midCanonicalEmitAggregateElement(c: inout c, body: body, element: c.mid.aggregateElements[value.elements.start + elementI]))
                elementI = elementI + 1U64
            }
            return self.genLlvmArrayValues(c: inout c, values: elements, elemTy: elementTy, elemRef: elementRef)
        }
        if value.tag == 4U64 {
            if value.resultTerm == 0U64 || value.resultTerm >= c.arena.types.count() || value.enumIndex >= c.arena.enums.count() || value.variantIndex >= c.arena.enums[value.enumIndex].variants.count() { return LLVMConstNull(self.ptrty) }
            val result: TypeRef = c.arena.types[value.resultTerm]
            val savedParams: Array[Bind] = c.cur.typeParams
            val savedArgs: Array[U64] = c.cur.typeArgs
            c.cur.typeParams = c.arena.enums[value.enumIndex].typeParams
            c.cur.typeArgs = result.args
            mut val elements: Array[LLVMValueRef] = []
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
                mut val child: LLVMValueRef = self.midCanonicalEmitAggregateElement(c: inout c, body: body, element: element)
                if element.isBoxed { child = self.midEmitAggregateBox(c: inout c, value: child) }
                elements.append(child)
                elementI = elementI + 1U64
            }
            val built: LLVMValueRef = self.buildEnumFromValues(c: inout c, eid: value.enumIndex, ety: self.midCanonicalPlaceTy(c: inout c, body: body, place: destination), vi: value.variantIndex, payloadVals: elements)
            c.cur.typeParams = savedParams
            c.cur.typeArgs = savedArgs
            return built
        }
        return LLVMConstNull(self.ptrty)
    }

    // The first direct statement slice deliberately covers the scalar rows
    // whose semantics are independent of aggregate/call lowering.  Other
    // canonical tags remain fail-closed until their direct emitters exist.
    inout fn midCanonicalEmitStatement(c: inout Comp, body: MidBodyNode, statementId: U64) -> Bool {
        if statementId == 0U64 || statementId > c.mid.statements.count() { return false }
        val statement: MidStatementNode = c.mid.statements[statementId - 1U64]
        if statement.tag == 1U64 {
            if statement.destination == 0U64 || statement.destination > c.mid.places.count() || statement.value == 0U64 || statement.value > c.mid.rvalues.count() { return false }
            val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
            val rvalue: MidRvalueNode = c.mid.rvalues[statement.value - 1U64]
            if rvalue.tag != 1U64 && rvalue.tag != 2U64 && rvalue.tag != 3U64 && rvalue.tag != 4U64 && rvalue.tag != 5U64 && rvalue.tag != 8U64 && rvalue.tag != 9U64 && rvalue.tag != 10U64 { return false }
            mut val value: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: rvalue.operand)
            if rvalue.tag == 3U64 || rvalue.tag == 4U64 || rvalue.tag == 5U64 { value = self.midCanonicalEmitAggregate(c: inout c, body: body, destination: destination, value: rvalue) }
            if rvalue.tag == 8U64 { value = self.coerceInt(v: value, target: self.llvmTypeOfRef(c: inout c, ref: rvalue.targetTerm), unsigned: rvalue.kindTag != 1U64) }
            if rvalue.tag == 9U64 {
                if rvalue.kindTag == 1U64 { value = LLVMBuildSIToFP(self.b, value, self.llvmTypeOfRef(c: inout c, ref: rvalue.targetTerm), anon()) }
                else { value = LLVMBuildUIToFP(self.b, value, self.llvmTypeOfRef(c: inout c, ref: rvalue.targetTerm), anon()) }
            }
            val targetTy: LLVMTypeRef = self.midCanonicalPlaceTy(c: inout c, body: body, place: destination)
            if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 { value = self.coerceInt(v: value, target: targetTy, unsigned: false) }
            LLVMBuildStore(self.b, value, self.midCanonicalPlacePtr(c: inout c, body: body, place: destination))
            return true
        }
        if statement.tag == 2U64 {
            if statement.destination == 0U64 || statement.destination > c.mid.places.count() || statement.source == 0U64 || statement.source > c.mid.places.count() { return false }
            val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
            val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
            LLVMBuildStore(self.b, self.midCanonicalReadPlace(c: inout c, body: body, place: source), self.midCanonicalPlacePtr(c: inout c, body: body, place: destination))
            return true
        }
        if statement.tag == 3U64 { return self.midCanonicalEmitDrop(c: inout c, body: body, placeId: statement.destination) }
        if statement.tag == 4U64 { return self.midCanonicalEmitConditionalDrop(c: inout c, body: body, placeId: statement.destination, flag: statement.flag) }
        if statement.tag == 5U64 {
            if statement.flag >= body.locals.len { return false }
            mut val bit: U64 = 0U64
            if statement.isSet { bit = 1U64 }
            LLVMBuildStore(self.b, LLVMConstInt(self.i1ty, bit, 0I32), self.midCanonicalLocalPtr(body: body, local: statement.flag))
            return true
        }
        if statement.tag == 7U64 { return true }
        return false
    }

    // Emit the non-call portion of the canonical CFG.  `blocks` is transient
    // LLVM construction state, not an IR carrier: all semantic edges are read
    // exclusively from the canonical terminator row and its case range.
    inout fn midCanonicalEmitNonCallTerminator(c: inout Comp, body: MidBodyNode, terminatorId: U64, blocks: Array[LLVMBasicBlockRef]) -> Bool {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return false }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag == 2U64 {
            if term.target >= blocks.count() { return false }
            LLVMBuildBr(self.b, blocks[term.target])
            return true
        }
        if term.tag == 3U64 {
            if term.otherwise >= blocks.count() { return false }
            val discriminant: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.discriminant)
            if term.cases.len == 1U64 && c.mid.switchCases[term.cases.start].value == 1I64 && LLVMGetIntTypeWidth(LLVMTypeOf(discriminant)) == 1U32 {
                val target: U64 = c.mid.switchCases[term.cases.start].target
                if target >= blocks.count() { return false }
                LLVMBuildCondBr(self.b, discriminant, blocks[target], blocks[term.otherwise])
                return true
            }
            val switch: LLVMValueRef = LLVMBuildSwitch(self.b, discriminant, blocks[term.otherwise], truncU32(n: term.cases.len))
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                val item: MidSwitchCase = c.mid.switchCases[term.cases.start + caseI]
                if item.target >= blocks.count() { return false }
                LLVMAddCase(switch, LLVMConstInt(self.i64ty, bitCastU64(n: item.value), 1I32), blocks[item.target])
                caseI = caseI + 1U64
            }
            return true
        }
        if term.tag == 5U64 {
            if self.curIsMain { LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32)) }
            else if self.curRetVoid { LLVMBuildRetVoid(self.b) }
            else { LLVMBuildUnreachable(self.b) }
            return true
        }
        if term.tag == 6U64 {
            if self.curIsMain || self.curRetVoid { return false }
            LLVMBuildRet(self.b, self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value))
            return true
        }
        if term.tag == 7U64 {
            self.emitStrSinkValue(c: inout c, rtName: "plew_panic_raw", rtId: 4U64, value: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value))
            LLVMBuildUnreachable(self.b)
            return true
        }
        if term.tag == 8U64 || term.tag == 9U64 {
            LLVMBuildUnreachable(self.b)
            return true
        }
        if term.tag == 10U64 {
            if term.resume >= blocks.count() { return false }
            LLVMBuildBr(self.b, blocks[term.resume])
            return true
        }
        return false
    }

    // Allocate each Mid local once in the function entry. Source parameters
    // are bound from the ABI by their checked contiguous Mid-local prefix;
    // globals and receivers deliberately remain distinct Mid forms rather
    // than ambient backend locals or name-based recovery.
    inout fn midPrepareLocals(c: inout Comp, body: MidBody, abiParameterStart: U64 = 0U64) -> Bool {
        self.nLocals = 0U64
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        mut val local: U64 = 0U64
        while local < body.locals.count() {
            val declaration: MidLocalDecl = body.locals[local]
            val ty: LLVMTypeRef = self.midLocalTy(c: inout c, body: body, local: local)
            mut val slot: LLVMValueRef = self.entryAlloca(ty: ty)
            if declaration.isParameter {
                val abiIndex: U64 = abiParameterStart + local
                if declaration.isInout {
                    // The ABI already gives the storage address. Retaining a
                    // second stack slot would turn `inout` mutation into a
                    // callee-local copy and break CoW writeback semantics.
                    slot = LLVMGetParam(self.curFn, abiIndex)
                } else {
                    LLVMBuildStore(self.b, LLVMGetParam(self.curFn, abiIndex), slot)
                }
            }
            self.pushLocalR(nameStart: declaration.sourceNameStart, nameLen: 0U64, ptr: slot, ty: ty, kind: 0U64, structIdx: c.arena.structs.count(), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: declaration.typeTerm)
            self.setLocalOwned(owned: declaration.ownsAtEntry)
            local += 1U64
        }
        return true
    }

    inout fn midPrepareCanonicalLocals(c: inout Comp, body: MidBodyNode, abiParameterStart: U64 = 0U64) -> Bool {
        self.nLocals = 0U64
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        mut val local: U64 = 0U64
        while local < body.locals.len {
            val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
            val ty: LLVMTypeRef = self.midCanonicalLocalTy(c: inout c, body: body, local: local)
            mut val slot: LLVMValueRef = self.entryAlloca(ty: ty)
            if declaration.isParameter {
                val abiIndex: U64 = abiParameterStart + local
                if declaration.isInout { slot = LLVMGetParam(self.curFn, abiIndex) }
                else { LLVMBuildStore(self.b, LLVMGetParam(self.curFn, abiIndex), slot) }
            }
            self.pushLocalR(nameStart: declaration.sourceNameStart, nameLen: 0U64, ptr: slot, ty: ty, kind: 0U64, structIdx: c.arena.structs.count(), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: declaration.typeTerm)
            self.setLocalOwned(owned: declaration.ownsAtEntry)
            local = local + 1U64
        }
        return true
    }

    // Lower a verified, elaborated Mid CFG. The input is intentionally a Mid
    // body rather than `(Func, AST block)`: all semantic decisions were frozen
    // before this boundary.
    inout fn genLlvmMidBody(c: inout Comp, body: MidBody, abiParameterStart: U64 = 0U64) -> Bool {
        val verification: MidVerification = verifyMidBody(body: body)
        match verification.error {
            MidVerifyError.None => {}
            _ => { return false }
        }
        if body.entry >= body.blocks.count() { return false }
        if !self.midPrepareLocals(c: inout c, body: body, abiParameterStart: abiParameterStart) { return false }
        mut val blocks: Array[LLVMBasicBlockRef] = []
        mut val block: U64 = 0U64
        while block < body.blocks.count() {
            if block == body.entry { blocks.append(LLVMGetInsertBlock(self.b)) }
            else { blocks.append(LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid"))) }
            block += 1U64
        }
        block = 0U64
        while block < body.blocks.count() {
            LLVMPositionBuilderAtEnd(self.b, blocks[block])
            mut val statement: U64 = 0U64
            while statement < body.blocks[block].statements.count() {
                self.midEmitStatement(c: inout c, body: body, statement: body.blocks[block].statements[statement])
                statement += 1U64
            }
            match body.blocks[block].terminator {
                MidTerminator.Goto(target: val target) => { LLVMBuildBr(self.b, blocks[target]) }
                MidTerminator.Switch(discriminant: val discriminant, values: val values, targets: val targets, otherwise: val otherwise) => {
                    val discriminantValue: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: discriminant)
                    // Bool conditions keep their native i1 branch. Enum tags
                    // are I64 and use the general integer switch below.
                    if values.count() == 1U64 && values[0U64] == 1I64 && LLVMGetIntTypeWidth(LLVMTypeOf(discriminantValue)) == 1U32 {
                        LLVMBuildCondBr(self.b, discriminantValue, blocks[targets[0U64]], blocks[otherwise])
                    } else {
                        val switch: LLVMValueRef = LLVMBuildSwitch(self.b, discriminantValue, blocks[otherwise], truncU32(n: values.count()))
                        mut val caseIndex: U64 = 0U64
                        while caseIndex < values.count() {
                            LLVMAddCase(switch, LLVMConstInt(self.i64ty, bitCastU64(n: values[caseIndex]), 1I32), blocks[targets[caseIndex]])
                            caseIndex += 1U64
                        }
                    }
                }
                MidTerminator.Call(callee: val callee, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
                    match callee {
                        MidCallTarget.Resolved(resolution: val resolution) => {
                            if !(self.midEmitInitialDirectCall(c: inout c, body: body, resolution: resolution, receiver: receiver, args: args, destination: destination)) { return false }
                            LLVMBuildBr(self.b, blocks[target])
                        }
                        _ => { return false }
                    }
                }
                MidTerminator.Return => {
                    if self.curIsMain { LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32)) }
                    else if self.curRetVoid { LLVMBuildRetVoid(self.b) }
                    else { LLVMBuildUnreachable(self.b) }
                }
                MidTerminator.ReturnValue(value: val value) => {
                    if self.curIsMain || self.curRetVoid { return false }
                    LLVMBuildRet(self.b, self.midEmitOperand(c: inout c, body: body, operand: value))
                }
                MidTerminator.Panic(message: val message) => {
                    val value: LLVMValueRef = self.midEmitOperand(c: inout c, body: body, operand: message)
                    self.emitStrSinkValue(c: inout c, rtName: "plew_panic_raw", rtId: 4U64, value: value)
                    LLVMBuildUnreachable(self.b)
                }
                MidTerminator.Unreachable => { LLVMBuildUnreachable(self.b) }
                MidTerminator.Abort => { LLVMBuildUnreachable(self.b) }
                // Value returns and suspend need their final ABI/value forms.
                // Do not route them through the legacy AST path.
                _ => { return false }
            }
            block += 1U64
        }
        return true
    }

    // Canonical Mid is the production-shaped LLVM input: its verification,
    // local layout, statement rows and terminator rows all stay in the arena.
    // This initial preflight admits the closed direct-call subset only; runtime
    // intrinsic targets remain fail-closed until their own direct reader is
    // implemented rather than borrowing the draft call path.
    inout fn midCanonicalLlvmPreflight(c: inout Comp, canonical: MidCanonicalBody, abiParameterCount: U64 = 0U64) -> MidLlvmPreflight {
        if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidLlvmPreflight.Terminator /> }
        val verification: MidVerification = verifyCanonicalMidBody(c: c, canonical: canonical)
        match verification.error { MidVerifyError.None => {} _ => { return <MidLlvmPreflight.Terminator /> } }
        val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
        if body.entry >= body.blocks.len { return <MidLlvmPreflight.Terminator /> }
        mut val parameter: U64 = 0U64
        mut val local: U64 = 0U64
        while local < body.locals.len {
            val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
            if declaration.isParameter {
                if local != parameter || parameter >= abiParameterCount { return <MidLlvmPreflight.AbiLocals /> }
                parameter = parameter + 1U64
            } else if parameter < abiParameterCount { return <MidLlvmPreflight.AbiLocals /> }
            local = local + 1U64
        }
        if parameter != abiParameterCount { return <MidLlvmPreflight.AbiLocals /> }
        mut val blockI: U64 = 0U64
        while blockI < body.blocks.len {
            val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
            mut val statementI: U64 = 0U64
            while statementI < block.statements.len {
                val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                if statement.tag == 1U64 {
                    if statement.destination == 0U64 || statement.destination > c.mid.places.count() || !self.midCanonicalInitialRvalueSupported(c: inout c, body: body, rvalueId: statement.value) { return <MidLlvmPreflight.UnsupportedRvalue /> }
                } else if statement.tag == 2U64 {
                    if statement.destination == 0U64 || statement.destination > c.mid.places.count() || statement.source == 0U64 || statement.source > c.mid.places.count() { return <MidLlvmPreflight.AssignmentProjection /> }
                } else if statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 5U64 || statement.tag == 7U64 {
                } else { return <MidLlvmPreflight.ScopeExit /> }
                statementI = statementI + 1U64
            }
            if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return <MidLlvmPreflight.Terminator /> }
            val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            if term.tag == 4U64 {
                val call: MidCallPreflight = self.midCanonicalCallPreflight(c: inout c, body: body, terminatorId: block.terminator)
                match call { MidCallPreflight.None => {} _ => { return <MidLlvmPreflight.Call reason=call /> } }
            } else if term.tag == 2U64 || term.tag == 5U64 || term.tag == 8U64 || term.tag == 9U64 {
            } else if term.tag == 3U64 {
                if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: term.discriminant) { return <MidLlvmPreflight.Switch /> }
            } else if term.tag == 6U64 || term.tag == 7U64 {
                if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: term.value) { return <MidLlvmPreflight.Terminator /> }
            } else { return <MidLlvmPreflight.Terminator /> }
            blockI = blockI + 1U64
        }
        return <MidLlvmPreflight.Ready />
    }

    inout fn genLlvmCanonicalMidBody(c: inout Comp, canonical: MidCanonicalBody, abiParameterStart: U64 = 0U64) -> Bool {
        match self.midCanonicalLlvmPreflight(c: inout c, canonical: canonical, abiParameterCount: abiParameterStart) { MidLlvmPreflight.Ready => {} _ => { return false } }
        val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
        if !self.midPrepareCanonicalLocals(c: inout c, body: body, abiParameterStart: abiParameterStart) { return false }
        mut val blocks: Array[LLVMBasicBlockRef] = []
        mut val blockI: U64 = 0U64
        while blockI < body.blocks.len {
            if blockI == body.entry { blocks.append(LLVMGetInsertBlock(self.b)) }
            else { blocks.append(LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid"))) }
            blockI = blockI + 1U64
        }
        blockI = 0U64
        while blockI < body.blocks.len {
            val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
            LLVMPositionBuilderAtEnd(self.b, blocks[blockI])
            mut val statementI: U64 = 0U64
            while statementI < block.statements.len {
                if !self.midCanonicalEmitStatement(c: inout c, body: body, statementId: block.statements.start + statementI + 1U64) { return false }
                statementI = statementI + 1U64
            }
            val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            if term.tag == 4U64 {
                if !self.midCanonicalEmitCall(c: inout c, body: body, terminatorId: block.terminator) || term.target >= blocks.count() { return false }
                LLVMBuildBr(self.b, blocks[term.target])
            } else if !self.midCanonicalEmitNonCallTerminator(c: inout c, body: body, terminatorId: block.terminator, blocks: blocks) { return false }
            blockI = blockI + 1U64
        }
        return true
    }
}
