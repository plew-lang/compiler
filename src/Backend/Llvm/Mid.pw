import ../../Diag with { eprintU64 }
// Part of the LLVM backend (root: _.pw): lowering of already-elaborated Mid
// CFG. This path owns no syntax/type/call resolution. It consumes only typed
// places, semantic constants, and explicit ownership operations.

import @Std/Core with { truncU32, bitCastU64 }
import ../../Ir with { ConversionProofNode, FrozenEnumPayloadConversion, CaptureEntry }

pub impl LlvmCtx {

    // Semantic newtype evidence is necessary but cannot excuse a layout bug.
    // Named LLVM aggregates may differ in identity; storage shape must agree.
    fn midBoundaryLayoutMatches(source: LLVMTypeRef, target: LLVMTypeRef) -> Bool {
        if plew_pointer_equal(source, target) != 0I32 { return true }
        val kind = LLVMGetTypeKind(source)
        if kind != LLVMGetTypeKind(target) { return false }
        if kind == 10U32 {
            if LLVMIsOpaqueStruct(source) != 0I32 || LLVMIsOpaqueStruct(target) != 0I32 || LLVMIsPackedStruct(source) != LLVMIsPackedStruct(target) { return false }
            val count = LLVMCountStructElementTypes(source)
            if count != LLVMCountStructElementTypes(target) { return false }
            mut val index = 0U32
            while index < count {
                if !self.midBoundaryLayoutMatches(source: LLVMStructGetTypeAtIndex(source, index), target: LLVMStructGetTypeAtIndex(target, index)) { return false }
                index += 1U32
            }
            return true
        }
        if kind == 11U32 {
            return LLVMGetArrayLength2(source) == LLVMGetArrayLength2(target) && self.midBoundaryLayoutMatches(source: LLVMGetElementType(source), target: LLVMGetElementType(target))
        }
        // Primitive, pointer and function types are uniqued in this context.
        return false
    }

    // Integer spelling describes a magnitude, not the resolved value type.
    // A contextual F32/F64 literal is already a float in Mid; constructing an
    // LLVM integer with a floating type would produce an invalid i0 value.
    inout fn midIntegerConstant(c: inout Comp, value: U64, negative: Bool, isBool: Bool, typeTerm: U64) -> LLVMValueRef {
        mut val ty: LLVMTypeRef = self.i64ty
        if isBool { ty = self.i1ty }
        else if typeTerm != 0U64 && typeTerm < c.arena.typeCount() { ty = self.llvmTypeOfRef(c: inout c, ref: typeTerm) }
        val kind: U32 = LLVMGetTypeKind(ty)
        if kind == 2U32 || kind == 3U32 {
            val magnitude: LLVMValueRef = LLVMConstInt(self.i64ty, value, 0I32)
            val literal: LLVMValueRef = LLVMBuildUIToFP(self.b, magnitude, ty, anon())
            if negative { return LLVMBuildFNeg(self.b, literal, anon()) }
            return literal
        }
        val literal: LLVMValueRef = LLVMConstInt(ty, value, 0I32)
        if negative { return LLVMBuildNeg(self.b, literal, anon()) }
        return literal
    }

    // Coverage is a set of frozen body-instance keys, not an emission log.
    // Flatten at this boundary: Mid errors are short-lived internal data,
    // whereas coverage records survive the lowering attempt and are copied by
    // the worklist.  Keeping the former in the latter is both needless and
    // couples diagnostics to ARC layout of every evolving error enum.
    fn midUnsupportedBuildCoverageDetail(reason: MidUnsupportedBuild) -> U64 {
        match reason {
            MidUnsupportedBuild.MakeWithoutAggregate => { return 1U64 }
            MidUnsupportedBuild.FieldPlace => { return 2U64 }
            MidUnsupportedBuild.UniqueAggregate => { return 3U64 }
            MidUnsupportedBuild.IncompleteAggregate => { return 4U64 }
            MidUnsupportedBuild.ShortCircuit => { return 5U64 }
            MidUnsupportedBuild.FieldProjection => { return 6U64 }
            MidUnsupportedBuild.FieldBase => { return 7U64 }
            MidUnsupportedBuild.UnloweredView => { return 8U64 }
            MidUnsupportedBuild.UnloweredValueControl => { return 9U64 }
            MidUnsupportedBuild.UnloweredReference => { return 10U64 }
            MidUnsupportedBuild.UnloweredClosure => { return 11U64 }
            MidUnsupportedBuild.UnloweredAwait => { return 12U64 }
            MidUnsupportedBuild.IndexPlace => { return 13U64 }
            MidUnsupportedBuild.UnexpectedOperand => { return 14U64 }
        }
    }

    fn midUnsupportedAssignCoverageDetail(reason: MidUnsupportedAssign) -> U64 {
        match reason {
            MidUnsupportedAssign.IdentifierNotLocal => { return 0U64 }
            MidUnsupportedAssign.FieldBaseNotPlace => { return 1U64 }
            MidUnsupportedAssign.IndexBaseNotPlace => { return 2U64 }
            MidUnsupportedAssign.OtherNotPlace => { return 3U64 }
            MidUnsupportedAssign.IndexProjection => { return 4U64 }
            MidUnsupportedAssign.ImmutableGlobal => { return 5U64 }
        }
    }

    fn midVerifyCoverageDetail(reason: MidVerifyError) -> U64 {
        match reason {
            MidVerifyError.None => { return 0U64 }
            MidVerifyError.InvalidTarget => { return 1U64 }
            MidVerifyError.PartialMove => { return 2U64 }
            MidVerifyError.MoveUnavailable => { return 3U64 }
            MidVerifyError.DropUnavailable => { return 4U64 }
            MidVerifyError.MissingOwnershipContract => { return 12U64 }
            MidVerifyError.InvalidDropFlag => { return 5U64 }
            MidVerifyError.UninitializedDropFlag => { return 9U64 }
            MidVerifyError.UnelaboratedBindingEnd => { return 6U64 }
            MidVerifyError.UnelaboratedScopeExit => { return 6U64 }
            MidVerifyError.UnelaboratedAccess => { return 7U64 }
            MidVerifyError.UninstantiatedReturnBoundary => { return 8U64 }
            MidVerifyError.UninstantiatedStorageBoundary => { return 11U64 }
            MidVerifyError.UninstantiatedCastBoundary => { return 10U64 }
        }
    }

    fn midPreflightCoverageDetail(reason: MidLlvmPreflight) -> U64 {
        match reason {
            MidLlvmPreflight.Ready => { return 0U64 }
            MidLlvmPreflight.AbiLocals => { return 1U64 }
            MidLlvmPreflight.AssignmentProjection => { return 2U64 }
            MidLlvmPreflight.UnsupportedRvalue => { return 3U64 }
            MidLlvmPreflight.ConversionOperand => { return 4U64 }
            MidLlvmPreflight.DropProjection => { return 5U64 }
            MidLlvmPreflight.ScopeExit => { return 6U64 }
            MidLlvmPreflight.Switch => { return 7U64 }
            MidLlvmPreflight.Call(reason: val call) => { return 100U64 + self.midCallPreflightCoverageDetail(reason: call) }
            MidLlvmPreflight.ReturnValue => { return 8U64 }
            MidLlvmPreflight.Terminator => { return 9U64 }
        }
    }

    fn midCallPreflightCoverageDetail(reason: MidCallPreflight) -> U64 {
        match reason {
            MidCallPreflight.None => { return 0U64 }
            MidCallPreflight.Resolution => { return 1U64 }
            MidCallPreflight.Target => { return 2U64 }
            MidCallPreflight.Callee => { return 3U64 }
            MidCallPreflight.Async => { return 4U64 }
            MidCallPreflight.Receiver => { return 5U64 }
            MidCallPreflight.RuntimeAbi => { return 6U64 }
            MidCallPreflight.Buffer => { return 7U64 }
            MidCallPreflight.Extern => { return 8U64 }
            MidCallPreflight.GenericArguments => { return 9U64 }
            MidCallPreflight.ArgumentShape => { return 10U64 }
            MidCallPreflight.Result => { return 11U64 }
            MidCallPreflight.Argument => { return 12U64 }
        }
    }

    fn midEligibilityCoverageDetail(reason: MidEligibilityReason) -> U64 {
        match reason {
            MidEligibilityReason.Async => { return 0U64 }
            MidEligibilityReason.Extern => { return 1U64 }
            MidEligibilityReason.InoutReceiver => { return 2U64 }
            MidEligibilityReason.MoveReceiver => { return 3U64 }
            MidEligibilityReason.Globals => { return 4U64 }
        }
    }

    inout fn recordMidCoverage(c: inout Comp, bodyId: U64, fnIdx: U64, stage: U64, detail: U64) {
        if !(c.emitMidCoverage) && !(c.requireMid) { return }
        // `detail` is a closed subcode below 256.  Packing it with its stage
        // keeps the table scalar while preserving exact de-duplication.
        val key: U64 = stage * 256U64 + detail
        mut val existing: U64 = 0U64
        while existing < self.midCoverageBodyIds.count() {
            if self.midCoverageBodyIds[existing] == bodyId && self.midCoverageKeys[existing] == key { return }
            existing += 1U64
        }
        self.midCoverageBodyIds.append(bodyId)
        self.midCoverageFnIdxs.append(fnIdx)
        self.midCoverageKeys.append(key)
    }

    // `MidBuildError` is consumed at its match site.  Coverage retains only its
    // closed scalar detail, so this boundary must not re-project the enclosing
    // MidBodyBuild value or pass an error enum through a second ABI boundary.
    inout fn recordMidBuild(c: inout Comp, bodyId: U64, fnIdx: U64, detail: U64) {
        if c.traceCodegen {
            eprint(text: "[trace-codegen] Mid build-fallback detail=")
            self.traceCodegenU64(n: detail)
            eprint(text: " fn=")
            self.traceCodegenU64(n: fnIdx)
            eprint(text: "\n")
        }
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 0U64, detail: detail)
    }

    // Every production-shaped body, including the synthetic global initializer,
    // reports the same closed Build error vocabulary.  Keeping this conversion
    // next to the coverage encoding prevents a new caller from silently
    // treating a fallback as require-Mid success.
    inout fn recordMidBuildError(c: inout Comp, bodyId: U64, fnIdx: U64, error: MidBuildError) {
        match error {
            MidBuildError.None => {}
            MidBuildError.InvalidStatement => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 1U64) }
            MidBuildError.InvalidBlock => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 2U64) }
            MidBuildError.InvalidFunction => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 3U64) }
            MidBuildError.MissingSemanticType => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 4U64) }
            MidBuildError.UnboundLocalIdentifier => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 5U64) }
            MidBuildError.Unsupported(reason: val unsupported) => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 100U64 + self.midUnsupportedBuildCoverageDetail(reason: unsupported)) }
            MidBuildError.UnsupportedAssign(reason: val reason) => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 20U64 + self.midUnsupportedAssignCoverageDetail(reason: reason)) }
            MidBuildError.UnsupportedWhile => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 7U64) }
            MidBuildError.UnsupportedFor => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 8U64) }
            MidBuildError.UnsupportedMatch => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 9U64) }
            MidBuildError.UnsupportedPanic => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 10U64) }
            MidBuildError.UnsupportedGive => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 11U64) }
            MidBuildError.UnsupportedBreak => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 12U64) }
            MidBuildError.UnsupportedContinue => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 13U64) }
            MidBuildError.MissingTerminator => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 14U64) }
            MidBuildError.MissingCallTemplate => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 15U64) }
            MidBuildError.UnsupportedCallTemplate => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fnIdx, detail: 16U64) }
        }
    }

    inout fn recordMidMissingBodyInstance(c: inout Comp, bodyId: U64, fnIdx: U64) {
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 1U64, detail: 0U64)
    }

    inout fn recordMidInstantiate(c: inout Comp, bodyId: U64, fnIdx: U64, reason: MidInstantiateError) {
        // Coverage is normally emitted only after code generation completes.
        // A frontend diagnostic can abort that run first, so make the same
        // stable reason observable at the failure boundary under tracing.
        if c.traceCodegen {
            eprint(text: "[trace-codegen] Mid instantiate-fallback detail=")
            self.traceCodegenU64(n: self.midInstantiateCoverageDetail(reason: reason))
            eprint(text: " fn=")
            self.traceCodegenU64(n: fnIdx)
            eprint(text: "\n")
        }
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 2U64, detail: self.midInstantiateCoverageDetail(reason: reason))
    }

    inout fn recordMidAccess(c: inout Comp, bodyId: U64, fnIdx: U64) {
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 3U64, detail: 0U64)
    }

    inout fn recordMidVerify(c: inout Comp, bodyId: U64, fnIdx: U64, reason: MidVerifyError) {
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 4U64, detail: self.midVerifyCoverageDetail(reason: reason))
    }

    inout fn recordMidEligibility(c: inout Comp, bodyId: U64, fnIdx: U64, reason: MidEligibilityReason) {
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 6U64, detail: self.midEligibilityCoverageDetail(reason: reason))
    }

    inout fn recordMidPreflight(c: inout Comp, bodyId: U64, fnIdx: U64, reason: MidLlvmPreflight) {
        // `--trace-codegen` must reveal why a verified body did not enter the
        // canonical backend.  Coverage keeps the same stable scalar detail;
        // this line merely makes that closed fact observable while diagnosing
        // a new Mid boundary, without reopening source lowering.
        if c.traceCodegen {
            eprint(text: "[trace-codegen] Mid preflight-fallback detail=")
            self.traceCodegenU64(n: self.midPreflightCoverageDetail(reason: reason))
            eprint(text: " fn=")
            self.traceCodegenU64(n: fnIdx)
            eprint(text: "\n")
        }
        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fnIdx, stage: 5U64, detail: self.midPreflightCoverageDetail(reason: reason))
    }

    inout fn emitMidCoverageRecord(c: inout Comp, bodyId: U64, fnIdx: U64, key: U64) {
        eprint(text: "mid-coverage body=")
        self.traceCodegenU64(n: bodyId)
        eprint(text: " fn=")
        self.traceCodegenU64(n: fnIdx)
        eprint(text: " name=")
        if fnIdx < c.arena.functionCount() {
            val function: Func = c.arena.functionAt(index: fnIdx)
            self.traceCodegenName(c: inout c, start: function.nameStart, len: function.nameLen)
        } else {
            eprint(text: "unknown")
        }
        eprint(text: " category=")
        val stage: U64 = key / 256U64
        val detail: U64 = key % 256U64
        match stage {
            0U64 => { self.emitMidCoverageBuild(detail: detail) }
            1U64 => { eprint(text: "missing-body-instance") }
            2U64 => { self.emitMidCoverageInstantiate(detail: detail) }
            3U64 => { eprint(text: "access") }
            4U64 => { self.emitMidCoverageVerify(detail: detail) }
            5U64 => { self.emitMidCoveragePreflight(detail: detail) }
            6U64 => { self.emitMidCoverageEligibility(detail: detail) }
            _ => { eprint(text: "unknown") }
        }
        eprint(text: "\n")
    }

    fn midInstantiateCoverageDetail(reason: MidInstantiateError) -> U64 {
        match reason {
            MidInstantiateError.None => { return 0U64 }
            MidInstantiateError.InvalidBodyInstance => { return 1U64 }
            MidInstantiateError.MissingCallResolution => { return 2U64 }
            MidInstantiateError.CallResolutionIndex => { return 3U64 }
            MidInstantiateError.CallResolutionArity => { return 4U64 }
            MidInstantiateError.CallResolutionPassing => { return 5U64 }
            MidInstantiateError.CallConversionSource => { return 6U64 }
            MidInstantiateError.CallConversionTarget => { return 7U64 }
            MidInstantiateError.MissingReturnResolution => { return 8U64 }
            MidInstantiateError.InvalidReturnResolution => { return 9U64 }
            MidInstantiateError.InvalidCastResolution => { return 13U64 }
            MidInstantiateError.MissingFinalResolution => { return 10U64 }
            MidInstantiateError.InvalidFinalResolution => { return 11U64 }
            MidInstantiateError.InvalidLocalResultType => { return 12U64 }
            MidInstantiateError.MissingTryResolution => { return 14U64 }
            MidInstantiateError.InvalidTryResolution => { return 15U64 }
            MidInstantiateError.MissingSemanticClosure => { return 16U64 }
            MidInstantiateError.InvalidSemanticClosure => { return 17U64 }
        }
    }

    fn emitMidCoverageInstantiate(detail: U64) {
        eprint(text: "instantiate:")
        match detail {
            0U64 => { eprint(text: "none") }
            1U64 => { eprint(text: "invalid-body-instance") }
            2U64 => { eprint(text: "missing-call-resolution") }
            3U64 => { eprint(text: "call-resolution-index") }
            4U64 => { eprint(text: "call-resolution-arity") }
            5U64 => { eprint(text: "call-resolution-passing") }
            6U64 => { eprint(text: "call-conversion-source") }
            7U64 => { eprint(text: "call-conversion-target") }
            8U64 => { eprint(text: "missing-return-resolution") }
            9U64 => { eprint(text: "invalid-return-resolution") }
            10U64 => { eprint(text: "missing-final-resolution") }
            11U64 => { eprint(text: "invalid-final-resolution") }
            12U64 => { eprint(text: "invalid-local-result-type") }
            14U64 => { eprint(text: "missing-try-resolution") }
            15U64 => { eprint(text: "invalid-try-resolution") }
            16U64 => { eprint(text: "missing-semantic-closure") }
            17U64 => { eprint(text: "invalid-semantic-closure") }
            _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoverageBuild(detail: U64) {
        eprint(text: "build:")
        if detail >= 100U64 {
            eprint(text: "unsupported:")
            self.emitMidCoverageUnsupportedBuild(detail: detail - 100U64)
            return
        }
        if detail >= 20U64 && detail < 26U64 {
            eprint(text: "assign:")
            self.emitMidCoverageAssign(detail: detail - 20U64)
            return
        }
        match detail {
            0U64 => { eprint(text: "none") } 1U64 => { eprint(text: "invalid-statement") }
            2U64 => { eprint(text: "invalid-block") } 3U64 => { eprint(text: "invalid-function") }
            4U64 => { eprint(text: "missing-semantic-type") } 5U64 => { eprint(text: "unbound-local") }
            6U64 => { eprint(text: "assign") } 7U64 => { eprint(text: "while") }
            8U64 => { eprint(text: "for") } 9U64 => { eprint(text: "match") }
            10U64 => { eprint(text: "panic") } 11U64 => { eprint(text: "give") }
            12U64 => { eprint(text: "break") } 13U64 => { eprint(text: "continue") }
            14U64 => { eprint(text: "missing-terminator") } 15U64 => { eprint(text: "missing-call-template") }
            16U64 => { eprint(text: "unsupported-call-template") } _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoverageAssign(detail: U64) {
        match detail {
            0U64 => { eprint(text: "identifier-not-local") }
            1U64 => { eprint(text: "field-base-not-place") }
            2U64 => { eprint(text: "index-base-not-place") }
            3U64 => { eprint(text: "other-not-place") }
            4U64 => { eprint(text: "index-projection") }
            5U64 => { eprint(text: "immutable-global") }
            _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoverageUnsupportedBuild(detail: U64) {
        match detail {
            0U64 => { eprint(text: "expression-statement") } 1U64 => { eprint(text: "make-without-aggregate") }
            2U64 => { eprint(text: "field-place") } 3U64 => { eprint(text: "unique-aggregate") }
            4U64 => { eprint(text: "incomplete-aggregate") } 5U64 => { eprint(text: "short-circuit") }
            6U64 => { eprint(text: "field-projection") } 7U64 => { eprint(text: "field-base") }
            8U64 => { eprint(text: "unlowered-view") } 9U64 => { eprint(text: "unlowered-value-control") }
            10U64 => { eprint(text: "unlowered-reference") } 11U64 => { eprint(text: "unlowered-closure") }
            12U64 => { eprint(text: "unlowered-await") } 13U64 => { eprint(text: "index-place") }
            14U64 => { eprint(text: "unexpected-operand") }
            _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoverageVerify(detail: U64) {
        eprint(text: "verify:")
        match detail {
            0U64 => { eprint(text: "none") } 1U64 => { eprint(text: "invalid-target") }
            2U64 => { eprint(text: "partial-move") } 3U64 => { eprint(text: "move-unavailable") }
            4U64 => { eprint(text: "drop-unavailable") } 5U64 => { eprint(text: "invalid-drop-flag") }
            6U64 => { eprint(text: "scope-exit") } 7U64 => { eprint(text: "access") }
            8U64 => { eprint(text: "return-boundary") } _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoveragePreflight(detail: U64) {
        eprint(text: "preflight:")
        if detail >= 100U64 {
            eprint(text: "call:")
            self.emitMidCoverageCallPreflight(detail: detail - 100U64)
            return
        }
        match detail {
            0U64 => { eprint(text: "ready") } 1U64 => { eprint(text: "abi-locals") }
            2U64 => { eprint(text: "assignment-projection") } 3U64 => { eprint(text: "rvalue") }
            4U64 => { eprint(text: "conversion-operand") } 5U64 => { eprint(text: "drop-projection") }
            6U64 => { eprint(text: "scope-exit") } 7U64 => { eprint(text: "switch") }
            8U64 => { eprint(text: "return-value") } 9U64 => { eprint(text: "terminator") }
            _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoverageCallPreflight(detail: U64) {
        match detail {
            0U64 => { eprint(text: "none") } 1U64 => { eprint(text: "resolution") }
            2U64 => { eprint(text: "target") } 3U64 => { eprint(text: "callee") }
            4U64 => { eprint(text: "async") } 5U64 => { eprint(text: "receiver") }
            6U64 => { eprint(text: "runtime-abi") } 7U64 => { eprint(text: "buffer") }
            8U64 => { eprint(text: "extern") } 9U64 => { eprint(text: "generic-arguments") }
            10U64 => { eprint(text: "argument-shape") } 11U64 => { eprint(text: "result") }
            12U64 => { eprint(text: "argument") } _ => { eprint(text: "unknown") }
        }
    }

    fn emitMidCoverageEligibility(detail: U64) {
        eprint(text: "eligibility:")
        match detail {
            0U64 => { eprint(text: "async") } 1U64 => { eprint(text: "extern") }
            2U64 => { eprint(text: "inout-receiver") } 3U64 => { eprint(text: "move-receiver") }
            4U64 => { eprint(text: "globals") } _ => { eprint(text: "unknown") }
        }
    }

    // RuntimeIntrinsic.Buffer has already fixed the ABI declaration. Its
    // finalized first parameter, rather than a source expression or type-name
    // lookup, is the one authority for the Buffer element representation.
    inout fn midBufferElementRef(c: inout Comp, bufferRef: U64) -> U64 {
        if bufferRef == 0U64 || bufferRef >= c.arena.typeCount() { return 0U64 }
        val buffer: TypeRef = c.arena.typeAt(index: bufferRef)
        if buffer.args.count() != 1U64 { return 0U64 }
        return buffer.args[0U64]
    }

    // Materialize a source-level projection selected by the frontend.  The
    // callable return is deliberately not stored until this closed transform
    // has run: storing a raw Ordering into a Bool place is an ABI violation.
    inout fn midProjectCallResult(selected: CallResolution, value: LLVMValueRef) -> LLVMValueRef {
        match selected.resultProjection {
            CallResultProjection.Identity => { return value }
            CallResultProjection.BoolNot => { return LLVMBuildNot(self.b, value, anon()) }
            CallResultProjection.OrderingTest(op: val op) => {
                val tag: LLVMValueRef = LLVMBuildExtractValue(self.b, value, 0U64, anon())
                val tagTy: LLVMTypeRef = LLVMTypeOf(tag)
                val less: LLVMValueRef = LLVMConstInt(tagTy, 0U64, 0I32)
                val greater: LLVMValueRef = LLVMConstInt(tagTy, 2U64, 0I32)
                if op == opLt() { return LLVMBuildICmp(self.b, llvmIntEq(), tag, less, anon()) }
                if op == opLe() { return LLVMBuildICmp(self.b, llvmIntNe(), tag, greater, anon()) }
                if op == opGt() { return LLVMBuildICmp(self.b, llvmIntEq(), tag, greater, anon()) }
                if op == opGe() { return LLVMBuildICmp(self.b, llvmIntNe(), tag, less, anon()) }
                return LLVMConstInt(self.i1ty, 0U64, 0I32)
            }
        }
    }

    // Canonical Mid has the same function-local index space as the draft
    // builder, but its declarations and projections live in typed arena rows.
    // These readers intentionally take the body node/range rather than
    // reconstructing a MidPlace or MidBody with owning Array payloads.
    inout fn midCanonicalLocalPtr(body: MidBodyNode, local: U64) -> LLVMValueRef {
        if local < body.locals.len && local < self.nLocals { return self.locPtr[local] }
        return LLVMConstNull(self.ptrty)
    }

    inout fn midCanonicalLocalTy(c: inout Comp, body: MidBodyNode, local: U64) -> LLVMTypeRef {
        if local >= body.locals.len { return self.i64ty }
        val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
        if declaration.isDropFlag { return self.i1ty }
        if declaration.typeTerm == 0U64 || declaration.typeTerm >= c.arena.typeCount() { return self.i64ty }
        return self.llvmTypeOfRef(c: inout c, ref: declaration.typeTerm)
    }

    // Global storage is addressed through its frozen frontend declaration
    // target. The row lookup is deliberately local to LLVM materialization:
    // dependency ordering may move global rows, but neither Mid nor LLVM ever
    // derives this identity from a source name or legacy seeded local.
    inout fn midCanonicalGlobalIndex(c: inout Comp, place: MidPlaceNode) -> U64 {
        if place.rootTag != 2U64 { return c.arena.globals.count() }
        return c.globalIndexForDeclarationTarget(target: place.globalTarget)
    }

    inout fn midCanonicalGlobalTy(c: inout Comp, place: MidPlaceNode) -> LLVMTypeRef {
        val index: U64 = self.midCanonicalGlobalIndex(c: inout c, place: place)
        if index >= self.gvalLty.count() { return self.i64ty }
        return self.gvalLty[index]
    }

    inout fn midCanonicalGlobalPtr(c: inout Comp, place: MidPlaceNode) -> LLVMValueRef {
        val index: U64 = self.midCanonicalGlobalIndex(c: inout c, place: place)
        if index >= self.gvalRef.count() { return LLVMConstNull(self.ptrty) }
        return self.gvalRef[index]
    }

    inout fn midCanonicalPlaceTy(c: inout Comp, body: MidBodyNode, place: MidPlaceNode) -> LLVMTypeRef {
        if place.projections.len == 0U64 {
            if place.rootTag == 2U64 { return self.midCanonicalGlobalTy(c: inout c, place: place) }
            return self.midCanonicalLocalTy(c: inout c, body: body, local: place.local)
        }
        if place.typeTerm != 0U64 && place.typeTerm < c.arena.typeCount() { return self.llvmTypeOfRef(c: inout c, ref: place.typeTerm) }
        return self.midCanonicalLocalTy(c: inout c, body: body, local: place.local)
    }

    inout fn midCanonicalPlacePtr(c: inout Comp, body: MidBodyNode, place: MidPlaceNode, forWrite: Bool = false) -> LLVMValueRef {
        mut val pointer: LLVMValueRef = LLVMConstNull(self.ptrty)
        mut val currentTy: LLVMTypeRef = self.i64ty
        if place.rootTag == 1U64 {
            if place.local >= body.locals.len { return LLVMConstNull(self.ptrty) }
            pointer = self.midCanonicalLocalPtr(body: body, local: place.local)
            currentTy = self.midCanonicalLocalTy(c: inout c, body: body, local: place.local)
            // A capture-cell local's backend local is a ptr holder. Places are
            // nevertheless places of its logical T, so all ordinary reads,
            // drops, and overwrites dereference the explicit cell first.
            // LLVM does not infer this from names or closure syntax: it reads
            // the frozen MidLocalDecl storage class only.
            if c.mid.locals[body.locals.start + place.local].isCaptureCell {
                pointer = llvmLoad(self.b, self.ptrty, pointer, anon())
            }
        } else if place.rootTag == 2U64 {
            pointer = self.midCanonicalGlobalPtr(c: inout c, place: place)
            currentTy = self.midCanonicalGlobalTy(c: inout c, place: place)
        } else { return LLVMConstNull(self.ptrty) }
        mut val projectionI: U64 = 0U64
        while projectionI < place.projections.len {
            val projection: MidProjectionNode = c.mid.projections[place.projections.start + projectionI]
            if projection.tag == 1U64 {
                pointer = LLVMBuildStructGEP2(self.b, currentTy, pointer, projection.index, anon())
                currentTy = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
                if projection.isBoxed {
                    if forWrite { self.privatizeValueCell(c: inout c, slot: pointer, typeRef: projection.typeTerm) }
                    pointer = llvmLoad(self.b, self.ptrty, pointer, anon())
                }
            } else if projection.tag == 2U64 {
                if projection.indexLocal >= body.locals.len { return LLVMConstNull(self.ptrty) }
                val array: LLVMValueRef = llvmLoad(self.b, currentTy, pointer, anon())
                val data: LLVMValueRef = self.arrValData(c: inout c, arr: array)
                val index: LLVMValueRef = llvmLoad(self.b, self.midCanonicalLocalTy(c: inout c, body: body, local: projection.indexLocal), self.midCanonicalLocalPtr(body: body, local: projection.indexLocal), anon())
                self.emitBoundsCheck(c: inout c, idx: index, count: self.rawbufCount(c: inout c, data: data))
                currentTy = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
                pointer = self.arrElemPtr(elemTy: currentTy, data: data, idx: index)
            } else if projection.tag == 4U64 {
                currentTy = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
            } else if projection.tag == 3U64 {
                pointer = self.refCellFromValue(v: llvmLoad(self.b, currentTy, pointer, anon()))
                currentTy = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
            } else { return LLVMConstNull(self.ptrty) }
            projectionI = projectionI + 1U64
        }
        return pointer
    }

    inout fn midCanonicalReadPlace(c: inout Comp, body: MidBodyNode, place: MidPlaceNode) -> LLVMValueRef {
        return llvmLoad(self.b, self.midCanonicalPlaceTy(c: inout c, body: body, place: place), self.midCanonicalPlacePtr(c: inout c, body: body, place: place), anon())
    }

    inout fn midCanonicalEmitOperand(c: inout Comp, body: MidBodyNode, operandId: U64) -> LLVMValueRef {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return LLVMConstNull(self.ptrty) }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag >= 1U64 && operand.tag <= 4U64 {
            if operand.place == 0U64 || operand.place > c.mid.places.count() { return LLVMConstNull(self.ptrty) }
            val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
            val value: LLVMValueRef = self.midCanonicalReadPlace(c: inout c, body: body, place: place)
            if operand.tag == 1U64 && place.typeTerm != 0U64 && place.typeTerm < c.arena.typeCount() && c.finalNeedsRelease(typeRef: place.typeTerm) {
                self.valueArc(c: inout c, v: value, typeRef: place.typeTerm, retain: true)
            }
            return value
        }
        if operand.tag == 5U64 {
            return self.midIntegerConstant(c: inout c, value: operand.integerValue, negative: operand.integerNegative, isBool: operand.integerBool, typeTerm: operand.typeTerm)
        }
        if operand.tag == 6U64 {
            return self.genLlvmStr(c: inout c, start: operand.stringStart, len: operand.stringLen)
        }
        if operand.tag == 7U64 {
            return LLVMConstRealOfStringAndSize(self.llvmTypeOfRef(c: inout c, ref: operand.typeTerm), floatTextCPtr(c: inout c, start: operand.stringStart, len: operand.stringLen), floatTextLen(c: inout c, start: operand.stringStart, len: operand.stringLen))
        }
        return LLVMConstNull(self.ptrty)
    }

    inout fn midCanonicalOperandTypeTerm(c: Comp, body: MidBodyNode, operandId: U64) -> U64 {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag >= 1U64 && operand.tag <= 4U64 && operand.place != 0U64 && operand.place <= c.mid.places.count() { return c.mid.places[operand.place - 1U64].typeTerm }
        if operand.tag >= 5U64 && operand.tag <= 7U64 { return operand.typeTerm }
        return 0U64
    }

    // Conversion selection is a frontend fact.  Canonical Mid receives only
    // its frozen ID, so this reader validates the selected row without
    // rebuilding ValueConversionProof or searching for a conformance again.
    // The first direct slice is an existential box; structural repacks join
    // this same reader once their owned loops are represented canonically.
    inout fn midCanonicalConversionProofSupported(c: inout Comp, proofId: U64) -> Bool {
        if proofId == 0U64 || proofId > c.arena.conversionProofs.count() { return false }
        val node: ConversionProofNode = c.arena.conversionProofs[proofId - 1U64]
        if node.tag == 0U64 { return true }
        if node.tag == 2U64 {
            if node.sourceRef == 0U64 || node.sourceRef >= c.arena.typeCount() || node.targetRef == 0U64 || node.targetRef >= c.arena.typeCount() || node.traitIdx >= c.decls.traitCount() { return false }
            if self.structIdxOfRef(c: inout c, ref: node.sourceRef) >= c.arena.structCount() { return false }
            // StaticProofNode.tag=0 is the frozen Missing sentinel.  The
            // backend does not interpret the witness path, but must not erase
            // a value through an absent proof.
            return node.staticProof != 0U64 && node.staticProof <= c.arena.staticProofs.count() && c.arena.staticProofs[node.staticProof - 1U64].tag != 0U64
        }
        if node.tag == 3U64 || node.tag == 4U64 { return self.midCanonicalBorrowedConversionSupported(c: inout c, sourceRef: node.sourceRef, targetRef: node.targetRef, proofId: proofId) }
        return false
    }

    // A structural conversion reads an already-borrowed source element.  The
    // expected source/target terms are carried by its parent proof row, so a
    // malformed child cannot silently become a compatible conversion.
    inout fn midCanonicalBorrowedConversionSupported(c: inout Comp, sourceRef: U64, targetRef: U64, proofId: U64) -> Bool {
        if sourceRef == 0U64 || sourceRef >= c.arena.typeCount() || targetRef == 0U64 || targetRef >= c.arena.typeCount() || proofId == 0U64 || proofId > c.arena.conversionProofs.count() { return false }
        val node: ConversionProofNode = c.arena.conversionProofs[proofId - 1U64]
        if node.tag == 0U64 { return c.typeRefEq(a: sourceRef, b: targetRef) }
        if node.tag == 2U64 { return c.typeRefEq(a: sourceRef, b: node.sourceRef) && c.typeRefEq(a: targetRef, b: node.targetRef) && self.midCanonicalConversionProofSupported(c: inout c, proofId: proofId) }
        if node.tag == 3U64 {
            if !c.typeRefEq(a: sourceRef, b: node.sourceRef) || !c.typeRefEq(a: targetRef, b: node.targetRef) { return false }
            val source: TypeRef = c.arena.typeAt(index: sourceRef)
            val target: TypeRef = c.arena.typeAt(index: targetRef)
            if source.args.count() != 1U64 || target.args.count() != 1U64 || node.element == 0U64 { return false }
            return self.midCanonicalBorrowedConversionSupported(c: inout c, sourceRef: source.args[0U64], targetRef: target.args[0U64], proofId: node.element)
        }
        if node.tag == 4U64 {
            if !c.typeRefEq(a: sourceRef, b: node.sourceRef) || !c.typeRefEq(a: targetRef, b: node.targetRef) || node.enumIdx >= c.arena.enumCount() { return false }
            val source: TypeRef = c.arena.typeAt(index: sourceRef)
            val target: TypeRef = c.arena.typeAt(index: targetRef)
            if source.args.count() != target.args.count() || node.payloads > c.arena.conversionPayloadPool.count() || node.payloadCount > c.arena.conversionPayloadPool.count() - node.payloads { return false }
            mut val expected: U64 = 0U64
            mut val variant: U64 = 0U64
            while variant < c.arena.enumAt(index: node.enumIdx).variants.count() {
                expected += c.arena.enumVariantAt(enumIndex: node.enumIdx, variantIndex: variant).fields.count()
                variant += 1U64
            }
            if expected != node.payloadCount { return false }
            mut val i: U64 = 0U64
            while i < node.payloadCount {
                val payload: FrozenEnumPayloadConversion = c.arena.conversionPayloadPool[node.payloads + i]
                if !self.midCanonicalBorrowedConversionSupported(c: inout c, sourceRef: payload.sourceRef, targetRef: payload.targetRef, proofId: payload.conversion) { return false }
                i += 1U64
            }
            return true
        }
        return false
    }

    // Materialize an already-selected frozen existential conversion.  Copy
    // has obtained its destination share in midCanonicalEmitOperand; Move
    // transfers its existing share.  boxIntoAny takes that share, so this
    // boundary neither re-retains nor consults the legacy proof vocabulary.
    inout fn midCanonicalEmitValueConversion(c: inout Comp, body: MidBodyNode, operandId: U64, proofId: U64) -> LLVMValueRef {
        if !self.midCanonicalConversionProofSupported(c: inout c, proofId: proofId) || operandId == 0U64 || operandId > c.mid.operands.count() { return LLVMConstNull(self.anyTy) }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        val node: ConversionProofNode = c.arena.conversionProofs[proofId - 1U64]
        if node.tag == 0U64 { return self.midCanonicalEmitOperand(c: inout c, body: body, operandId: operandId) }
        if node.tag == 2U64 {
            if operand.tag != 1U64 && operand.tag != 2U64 { return LLVMConstNull(self.anyTy) }
            if !c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: operandId), b: node.sourceRef) { return LLVMConstNull(self.anyTy) }
            val structIdx: U64 = self.structIdxOfRef(c: inout c, ref: node.sourceRef)
            if structIdx >= c.arena.structCount() { return LLVMConstNull(self.anyTy) }
            return self.boxIntoAny(c: inout c, sourceRef: node.sourceRef, v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: operandId), sidx: structIdx, anyRef: node.targetRef, traitIdx: node.traitIdx)
        }
        if node.tag == 3U64 {
            if operand.tag != 1U64 || operand.place == 0U64 || operand.place > c.mid.places.count() || !c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: operandId), b: node.sourceRef) { return LLVMConstNull(self.ptrty) }
            return self.midCanonicalEmitArrayRepack(c: inout c, source: self.midCanonicalReadPlace(c: inout c, body: body, place: c.mid.places[operand.place - 1U64]), sourceRef: node.sourceRef, targetRef: node.targetRef, elementProof: node.element)
        }
        if node.tag == 4U64 {
            if operand.tag != 1U64 || operand.place == 0U64 || operand.place > c.mid.places.count() || !c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: operandId), b: node.sourceRef) { return LLVMConstNull(self.ptrty) }
            return self.midCanonicalEmitEnumRepack(c: inout c, source: self.midCanonicalReadPlace(c: inout c, body: body, place: c.mid.places[operand.place - 1U64]), sourceRef: node.sourceRef, targetRef: node.targetRef, enumIdx: node.enumIdx, payloadStart: node.payloads, payloadCount: node.payloadCount)
        }
        return LLVMConstNull(self.ptrty)
    }

    // Convert one element borrowed from an immutable source container.  The
    // new destination owns the result: identity gains one share; a box or
    // nested repack creates its own owned representation.
    inout fn midCanonicalEmitBorrowedConversion(c: inout Comp, value: LLVMValueRef, sourceRef: U64, targetRef: U64, proofId: U64) -> LLVMValueRef {
        if !self.midCanonicalBorrowedConversionSupported(c: inout c, sourceRef: sourceRef, targetRef: targetRef, proofId: proofId) { return LLVMConstNull(self.ptrty) }
        val node: ConversionProofNode = c.arena.conversionProofs[proofId - 1U64]
        if node.tag == 0U64 {
            self.valueArc(c: inout c, v: value, typeRef: sourceRef, retain: true)
            return value
        }
        if node.tag == 2U64 {
            val structIdx: U64 = self.structIdxOfRef(c: inout c, ref: sourceRef)
            if structIdx >= c.arena.structCount() { return LLVMConstNull(self.anyTy) }
            self.valueArc(c: inout c, v: value, typeRef: sourceRef, retain: true)
            return self.boxIntoAny(c: inout c, sourceRef: sourceRef, v: value, sidx: structIdx, anyRef: targetRef, traitIdx: node.traitIdx)
        }
        if node.tag == 3U64 { return self.midCanonicalEmitArrayRepack(c: inout c, source: value, sourceRef: sourceRef, targetRef: targetRef, elementProof: node.element) }
        if node.tag == 4U64 { return self.midCanonicalEmitEnumRepack(c: inout c, source: value, sourceRef: sourceRef, targetRef: targetRef, enumIdx: node.enumIdx, payloadStart: node.payloads, payloadCount: node.payloadCount) }
        return LLVMConstNull(self.ptrty)
    }

    // Repack Array[S] into Array[T] from the frozen element proof.  It never
    // asks the type checker whether S converts to T: all recursive choices
    // were published by the frontend before Mid was built.
    inout fn midCanonicalEmitArrayRepack(c: inout Comp, source: LLVMValueRef, sourceRef: U64, targetRef: U64, elementProof: U64) -> LLVMValueRef {
        if sourceRef == 0U64 || sourceRef >= c.arena.typeCount() || targetRef == 0U64 || targetRef >= c.arena.typeCount() { return LLVMConstNull(self.ptrty) }
        val sourceType: TypeRef = c.arena.typeAt(index: sourceRef)
        val targetType: TypeRef = c.arena.typeAt(index: targetRef)
        if sourceType.args.count() != 1U64 || targetType.args.count() != 1U64 { return LLVMConstNull(self.ptrty) }
        val sourceElementRef: U64 = sourceType.args[0U64]
        val targetElementRef: U64 = targetType.args[0U64]
        if !self.midCanonicalBorrowedConversionSupported(c: inout c, sourceRef: sourceElementRef, targetRef: targetElementRef, proofId: elementProof) { return LLVMConstNull(self.ptrty) }
        val sourceElementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: sourceElementRef)
        val targetElementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: targetElementRef)
        val sourceData: LLVMValueRef = self.arrValData(c: inout c, arr: source)
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: sourceData)
        val targetData: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(targetElementTy), cap: count)
        val indexSlot: LLVMValueRef = self.entryAlloca(ty: self.i64ty)
        llvmStore(self.b, LLVMConstInt(self.i64ty, 0U64, 0I32), indexSlot)
        val condition: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.canonical.repack.array.cond"))
        val loop: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.canonical.repack.array.body"))
        val done: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.canonical.repack.array.done"))
        LLVMBuildBr(self.b, condition)
        LLVMPositionBuilderAtEnd(self.b, condition)
        val index: LLVMValueRef = llvmLoad(self.b, self.i64ty, indexSlot, anon())
        LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntUlt(), index, count, anon()), loop, done)
        LLVMPositionBuilderAtEnd(self.b, loop)
        val sourceElement: LLVMValueRef = llvmLoad(self.b, sourceElementTy, self.arrElemPtr(elemTy: sourceElementTy, data: sourceData, idx: index), anon())
        val converted: LLVMValueRef = self.midCanonicalEmitBorrowedConversion(c: inout c, value: sourceElement, sourceRef: sourceElementRef, targetRef: targetElementRef, proofId: elementProof)
        llvmStore(self.b, self.coerceElem(v: converted, elemTy: targetElementTy), self.arrElemPtr(elemTy: targetElementTy, data: targetData, idx: index))
        llvmStore(self.b, LLVMBuildAdd(self.b, index, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), indexSlot)
        LLVMBuildBr(self.b, condition)
        LLVMPositionBuilderAtEnd(self.b, done)
        return self.arrValMake(c: inout c, data: targetData, count: count, aggTy: self.arrayInstTy(c: inout c, elemRef: targetElementRef))
    }

    // Rebuild an enum from its physical payload proof range.  The range is in
    // declaration variant/field order, so this emitter uses enum metadata
    // only for layout and never infers a conversion from generic arguments.
    inout fn midCanonicalEmitEnumRepack(c: inout Comp, source: LLVMValueRef, sourceRef: U64, targetRef: U64, enumIdx: U64, payloadStart: U64, payloadCount: U64) -> LLVMValueRef {
        if sourceRef == 0U64 || sourceRef >= c.arena.typeCount() || targetRef == 0U64 || targetRef >= c.arena.typeCount() || enumIdx >= c.arena.enumCount() || payloadStart > c.arena.conversionPayloadPool.count() || payloadCount > c.arena.conversionPayloadPool.count() - payloadStart { return LLVMConstNull(self.ptrty) }
        val sourceSlot: U64 = self.genEnumSlot(c: inout c, ref: sourceRef)
        val targetSlot: U64 = self.genEnumSlot(c: inout c, ref: targetRef)
        if sourceSlot >= self.genEnumRefs.count() || targetSlot >= self.genEnumRefs.count() || self.genEnumDefs[sourceSlot] != enumIdx || self.genEnumDefs[targetSlot] != enumIdx { return LLVMConstNull(self.ptrty) }
        val sourceType: TypeRef = c.arena.typeAt(index: sourceRef)
        val targetType: TypeRef = c.arena.typeAt(index: targetRef)
        if sourceType.args.count() != targetType.args.count() { return LLVMConstNull(self.ptrty) }
        val sourceLlvmType: LLVMTypeRef = self.genEnumTys[sourceSlot]
        val targetLlvmType: LLVMTypeRef = self.genEnumTys[targetSlot]
        val sourceSlotPtr: LLVMValueRef = self.entryAlloca(ty: sourceLlvmType)
        llvmStore(self.b, source, sourceSlotPtr)
        val tag: LLVMValueRef = llvmLoad(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, sourceLlvmType, sourceSlotPtr, 0U64, anon()), anon())
        val sourcePayloadPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, sourceLlvmType, sourceSlotPtr, 1U64, anon())
        val resultSlot: LLVMValueRef = self.entryAlloca(ty: targetLlvmType)
        val end: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.canonical.repack.enum.end"))
        mut val payloadIndex: U64 = 0U64
        mut val variant: U64 = 0U64
        while variant < c.arena.enumAt(index: enumIdx).variants.count() {
            val matched: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.canonical.repack.enum.variant"))
            val next: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.canonical.repack.enum.next"))
            LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, variant, 0I32), anon()), matched, next)
            LLVMPositionBuilderAtEnd(self.b, matched)
            val fields: Array[FieldDef] = c.arena.enumVariantAt(enumIndex: enumIdx, variantIndex: variant).fields
            mut val values: Array[LLVMValueRef] = []
            if fields.count() > 0U64 {
                val sourcePayloadType: LLVMTypeRef = self.variantPayloadTy(c: inout c, instanceRef: sourceRef, vi: variant)
                val payload: LLVMValueRef = llvmLoad(self.b, sourcePayloadType, sourcePayloadPtr, anon())
                mut val field: U64 = 0U64
                while field < fields.count() {
                    if payloadIndex >= payloadCount { return LLVMConstNull(targetLlvmType) }
                    val plan: FrozenEnumPayloadConversion = c.arena.conversionPayloadPool[payloadStart + payloadIndex]
                    values.append(self.midCanonicalEmitBorrowedConversion(c: inout c, value: LLVMBuildExtractValue(self.b, payload, field, anon()), sourceRef: plan.sourceRef, targetRef: plan.targetRef, proofId: plan.conversion))
                    payloadIndex += 1U64
                    field += 1U64
                }
            }
            llvmStore(self.b, self.buildEnumFromValues(c: inout c, instanceRef: targetRef, ety: targetLlvmType, vi: variant, payloadVals: values), resultSlot)
            LLVMBuildBr(self.b, end)
            LLVMPositionBuilderAtEnd(self.b, next)
            variant += 1U64
        }
        if payloadIndex != payloadCount { return LLVMConstNull(targetLlvmType) }
        llvmStore(self.b, LLVMConstNull(targetLlvmType), resultSlot)
        LLVMBuildBr(self.b, end)
        LLVMPositionBuilderAtEnd(self.b, end)
        return llvmLoad(self.b, targetLlvmType, resultSlot, anon())
    }

    inout fn midCanonicalPlaceLlvmSupported(c: inout Comp, body: MidBodyNode, placeId: U64, allowDeref: Bool = true) -> Bool {
        if placeId == 0U64 || placeId > c.mid.places.count() { return false }
        val place: MidPlaceNode = c.mid.places[placeId - 1U64]
        mut val currentTerm: U64 = 0U64
        if place.rootTag == 1U64 {
            if place.local >= body.locals.len { return false }
            currentTerm = c.mid.locals[body.locals.start + place.local].typeTerm
        } else if place.rootTag == 2U64 {
            val global: U64 = self.midCanonicalGlobalIndex(c: inout c, place: place)
            if global >= c.arena.globals.count() || global >= self.gvalRef.count() || global >= self.gvalTref.count() || c.arena.globals[global].mutable != place.globalMutable || place.typeTerm == 0U64 { return false }
            currentTerm = self.gvalTref[global]
        } else { return false }
        mut val projectionI: U64 = 0U64
        while projectionI < place.projections.len {
            val projection: MidProjectionNode = c.mid.projections[place.projections.start + projectionI]
            if projection.tag == 1U64 {
                if projection.typeTerm == 0U64 || projection.typeTerm >= c.arena.typeCount() { return false }
                currentTerm = projection.typeTerm
            } else if projection.tag == 2U64 {
                if projection.indexLocal >= body.locals.len || projection.typeTerm == 0U64 || projection.typeTerm >= c.arena.typeCount() || currentTerm == 0U64 { return false }
                currentTerm = projection.typeTerm
            } else if projection.tag == 4U64 {
                if body.bodyInstance == 0U64 || c.arena.bodyInstanceAt(index: body.bodyInstance - 1U64).adapterTargetBodyId == 0U64 || !c.typeRefEq(a: currentTerm, b: projection.sourceTerm) || !c.newtypeBoundaryTypesCompatible(source: currentTerm, target: projection.typeTerm) { return false }
                val sourceLayout = self.llvmTypeOfRef(c: inout c, ref: currentTerm)
                val targetLayout = self.llvmTypeOfRef(c: inout c, ref: projection.typeTerm)
                if !self.midBoundaryLayoutMatches(source: sourceLayout, target: targetLayout) { return false }
                currentTerm = projection.typeTerm
            } else if projection.tag == 3U64 {
                if !allowDeref || currentTerm == 0U64 || !c.isStrongRefInst(ref: currentTerm) || projection.typeTerm == 0U64 || projection.typeTerm >= c.arena.typeCount() { return false }
                if !c.typeRefEq(a: c.arena.typeAt(index: currentTerm).args[0U64], b: projection.typeTerm) { return false }
                currentTerm = projection.typeTerm
            } else { return false }
            projectionI = projectionI + 1U64
        }
        // A projected place has the leaf type, not the storage root type.
        if place.rootTag == 2U64 { return currentTerm != 0U64 && c.typeRefEq(a: currentTerm, b: place.typeTerm) }
        return true
    }

    inout fn midCanonicalOperandLlvmSupported(c: inout Comp, body: MidBodyNode, operandId: U64) -> Bool {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return false }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag >= 1U64 && operand.tag <= 4U64 { return self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) }
        if operand.tag == 5U64 { return operand.typeTerm == 0U64 || operand.typeTerm < c.arena.typeCount() }
        if operand.tag == 6U64 { return operand.stringStart <= c.arena.bytes.count() && operand.stringLen <= c.arena.bytes.count() - operand.stringStart }
        if operand.tag == 7U64 {
            if operand.typeTerm == 0U64 || operand.typeTerm >= c.arena.typeCount() || operand.stringStart > c.arena.bytes.count() || operand.stringLen == 0U64 || operand.stringLen > c.arena.bytes.count() - operand.stringStart { return false }
            val kind: U32 = LLVMGetTypeKind(self.llvmTypeOfRef(c: inout c, ref: operand.typeTerm))
            return kind == 2U32 || kind == 3U32
        }
        return false
    }

    inout fn midCanonicalClosureCaptures(c: inout Comp, value: MidRvalueNode) -> Array[CaptureEntry] {
        mut val captures: Array[CaptureEntry] = []
        mut val index: U64 = 0U64
        while index < value.elements.len {
            val capture = c.mid.closureCaptures[value.elements.start + index]
            val type: TypeRef = c.arena.typeAt(index: capture.typeTerm)
            captures.append(<CaptureEntry closureId=value.exprId nameStart=capture.bindingTarget nameLen=0U64 tyStart=type.nameStart tyLen=type.nameLen isArray=false ty=capture.typeTerm boxed=capture.mode == 2U64 />)
            index += 1U64
        }
        return captures
    }

    inout fn midCanonicalMakeClosureSupported(c: inout Comp, body: MidBodyNode, value: MidRvalueNode) -> Bool {
        if value.closureBodyKey == 0U64 || value.closureBodyId == 0U64 || value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || self.closureSlot(bodyId: value.closureBodyId) >= self.closures.count() { return false }
        if value.elements.start > c.mid.closureCaptures.count() || value.elements.len > c.mid.closureCaptures.count() - value.elements.start { return false }
        mut val index: U64 = 0U64
        while index < value.elements.len {
            val capture = c.mid.closureCaptures[value.elements.start + index]
            if capture.typeTerm == 0U64 || capture.typeTerm >= c.arena.typeCount() || !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: capture.operand) { return false }
            if capture.mode == 2U64 {
                val operand: MidOperandNode = c.mid.operands[capture.operand - 1U64]
                if operand.place == 0U64 || operand.place > c.mid.places.count() { return false }
                val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
                if place.rootTag != 1U64 || place.projections.len != 0U64 || place.local >= body.locals.len || !c.mid.locals[body.locals.start + place.local].isCaptureCell { return false }
            } else if capture.mode == 1U64 {
                val operand: MidOperandNode = c.mid.operands[capture.operand - 1U64]
                if operand.tag != 1U64 && operand.tag != 2U64 { return false }
            } else { return false }
            index += 1U64
        }
        return true
    }

    inout fn midCanonicalEmitMakeClosure(c: inout Comp, body: MidBodyNode, value: MidRvalueNode) -> LLVMValueRef {
        val slot: U64 = self.closureSlot(bodyId: value.closureBodyId)
        mut val environment: LLVMValueRef = LLVMConstNull(self.ptrty)
        if value.elements.len > 0U64 {
            val captures: Array[CaptureEntry] = self.midCanonicalClosureCaptures(c: inout c, value: value)
            val environmentType: LLVMTypeRef = self.closureEnvTy(c: inout c, caps: captures)
            environment = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(environmentType), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
            val drop: LLVMValueRef = self.declareClosureEnvironmentDrop(c: inout c, closureSlot: slot)
            llvmStore(self.b, drop, LLVMBuildStructGEP2(self.b, environmentType, environment, 0U64, anon()))
            mut val index: U64 = 0U64
            while index < value.elements.len {
                val capture = c.mid.closureCaptures[value.elements.start + index]
                mut val captured: LLVMValueRef = LLVMConstNull(self.ptrty)
                if capture.mode == 2U64 {
                    val operand: MidOperandNode = c.mid.operands[capture.operand - 1U64]
                    val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
                    captured = llvmLoad(self.b, self.ptrty, self.midCanonicalLocalPtr(body: body, local: place.local), anon())
                    self.rawbufRetain(c: inout c, cell: captured)
                } else {
                    captured = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: capture.operand)
                }
                llvmStore(self.b, captured, LLVMBuildStructGEP2(self.b, environmentType, environment, index + 1U64, anon()))
                index += 1U64
            }
        }
        mut val closure: LLVMValueRef = LLVMGetUndef(self.closureTy)
        closure = LLVMBuildInsertValue(self.b, closure, self.closures[slot].function, 0U64, anon())
        return LLVMBuildInsertValue(self.b, closure, environment, 1U64, anon())
    }

    inout fn midCanonicalInitialRvalueSupported(c: inout Comp, body: MidBodyNode, rvalueId: U64) -> Bool {
        if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return false }
        val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
        if value.tag == 19U64 { return self.midCanonicalMakeClosureSupported(c: inout c, body: body, value: value) }
        if value.tag == 1U64 { return self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) }
        if value.tag == 2U64 { return value.targetTerm != 0U64 && value.targetTerm < c.arena.typeCount() && self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) && c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: value.operand), b: value.targetTerm) }
        if value.tag >= 3U64 && value.tag <= 5U64 {
            if value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || value.fieldCount != value.elements.len { return false }
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
                if element.targetTerm == 0U64 || element.targetTerm >= c.arena.typeCount() || !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: element.operand) { return false }
                if !c.conversionProofIsIdentity(id: element.conversion) {
                    if !self.midCanonicalConversionProofSupported(c: inout c, proofId: element.conversion) || element.operand == 0U64 || element.operand > c.mid.operands.count() { return false }
                    val operand: MidOperandNode = c.mid.operands[element.operand - 1U64]
                    val proof: ConversionProofNode = c.arena.conversionProofs[element.conversion - 1U64]
                    if proof.tag == 2U64 && operand.tag != 1U64 && operand.tag != 2U64 { return false }
                    if (proof.tag == 3U64 || proof.tag == 4U64) && operand.tag != 1U64 { return false }
                }
                elementI = elementI + 1U64
            }
            return true
        }
        if value.tag == 6U64 {
            if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) || !self.midCanonicalConversionProofSupported(c: inout c, proofId: value.conversion) || value.operand == 0U64 || value.operand > c.mid.operands.count() { return false }
            val operand: MidOperandNode = c.mid.operands[value.operand - 1U64]
            val proof: ConversionProofNode = c.arena.conversionProofs[value.conversion - 1U64]
            if proof.tag == 0U64 { return true }
            if proof.tag == 3U64 || proof.tag == 4U64 { return operand.tag == 1U64 }
            return operand.tag == 1U64 || operand.tag == 2U64
        }
        if value.tag == 7U64 || value.tag == 23U64 { return false }
        if value.tag >= 8U64 && value.tag <= 10U64 { return value.targetTerm != 0U64 && value.targetTerm < c.arena.typeCount() && self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) }
        if value.tag >= 11U64 && value.tag <= 15U64 {
            if value.place == 0U64 || value.place > c.mid.places.count() || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: value.place) || value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || value.enumIndex >= c.arena.enumCount() { return false }
            val place: MidPlaceNode = c.mid.places[value.place - 1U64]
            if place.typeTerm == 0U64 || place.typeTerm >= c.arena.typeCount() { return false }
            val enumSlot: U64 = self.genEnumSlot(c: inout c, ref: place.typeTerm)
            if enumSlot >= self.genEnumRefs.count() || self.genEnumDefs[enumSlot] != value.enumIndex { return false }
            if value.tag == 11U64 { return true }
            val declaration = c.arena.enumAt(index: value.enumIndex)
            if value.variantIndex >= declaration.variants.count() { return false }
            val variant = declaration.variants[value.variantIndex]
            if value.fieldIndex >= variant.fields.count() { return false }
            if value.tag == 12U64 && c.fieldIsBoxed(f: variant.fields[value.fieldIndex]) { return false }
            return true
        }
        if value.tag == 16U64 || value.tag == 17U64 {
            if value.place == 0U64 || value.place > c.mid.places.count() || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: value.place) || value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || value.enumIndex >= c.arena.enumCount() { return false }
            val place: MidPlaceNode = c.mid.places[value.place - 1U64]
            if place.typeTerm == 0U64 || place.typeTerm >= c.arena.typeCount() { return false }
            val enumSlot: U64 = self.genEnumSlot(c: inout c, ref: place.typeTerm)
            if enumSlot >= self.genEnumRefs.count() || self.genEnumDefs[enumSlot] != value.enumIndex { return false }
            if value.tag == 16U64 { return true }
            // The field declaration may mention the enum's generic parameter;
            // its concrete equality was checked during canonical grounding.
            val declaration = c.arena.enumAt(index: value.enumIndex)
            if value.variantIndex >= declaration.variants.count() { return false }
            val variant = declaration.variants[value.variantIndex]
            return variant.fields.count() == 1U64
        }
        if value.tag == 18U64 {
            if value.operand == 0U64 || value.operand > c.mid.operands.count() || value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || value.targetTerm == 0U64 || value.targetTerm >= c.arena.typeCount() || value.enumIndex >= c.arena.enumCount() || value.variantIndex >= c.arena.enumAt(index: value.enumIndex).variants.count() { return false }
            val operand: MidOperandNode = c.mid.operands[value.operand - 1U64]
            if operand.tag != 2U64 || !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: value.operand) { return false }
            val declaration = c.arena.enumAt(index: value.enumIndex)
            val variant = declaration.variants[value.variantIndex]
            if variant.fields.count() != 1U64 { return false }
            val enumSlot: U64 = self.genEnumSlot(c: inout c, ref: value.resultTerm)
            return enumSlot < self.genEnumRefs.count() && self.genEnumDefs[enumSlot] == value.enumIndex && c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: value.operand), b: value.targetTerm)
        }
        return false
    }

    // `MidAggregateElement.isBoxed` is a frontend-frozen physical layout fact.
    // The emitted child already carries exactly one owned share for the
    // aggregate slot; moving it into this fresh rc=1 cell transfers that share
    // without retain/release. The aggregate's normal drop path owns and later
    // releases the cell, which in turn destroys this stored logical value.
    // No FieldDef or source expression is consulted here.
    inout fn midEmitAggregateBox(c: inout Comp, value: LLVMValueRef) -> LLVMValueRef {
        val valueTy: LLVMTypeRef = LLVMTypeOf(value)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(valueTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        llvmStore(self.b, value, cell)
        return cell
    }

    // A canonical call has already been instantiated: the target row names a
    // final CallResolution and its argument range carries the selected ABI
    // modes.  Read those rows directly; never rebuild MidCallReceiver or an
    // Array[MidOperand] just to call the draft emitter.
    fn midCanonicalInoutStorage(c: Comp, operand: MidOperandNode) -> U64 {
        if operand.accessPlace != 0U64 { return operand.accessPlace }
        return operand.place
    }

    // Dereference lending requires an owned, evaluated MutableRef home.
    // This is the builder/access contract that pins the cell through the
    // call and writeback; accepting a live mutable reference binding here
    // would let another argument rebind it after the snapshot was taken.
    inout fn midCanonicalInoutPlaceSupported(c: inout Comp, body: MidBodyNode, placeId: U64) -> Bool {
        if !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: placeId) { return false }
        val place: MidPlaceNode = c.mid.places[placeId - 1U64]
        mut val shared: Bool = false
        mut val index: U64 = 0U64
        while index < place.projections.len {
            val projection: MidProjectionNode = c.mid.projections[place.projections.start + index]
            if projection.tag == 3U64 {
                if index != 0U64 || place.rootTag != 1U64 || place.local >= body.locals.len { return false }
                val local: MidLocalDecl = c.mid.locals[body.locals.start + place.local]
                if local.sourceNameStart != 0U64 || local.isParameter || local.isBorrowed || local.isInout || local.isCaptureCell || !c.isMutableRefInst(ref: local.typeTerm) { return false }
                shared = true
            } else if shared && projection.tag != 1U64 { return false }
            index += 1U64
        }
        return true
    }

    inout fn midCanonicalInoutOperandSupported(c: inout Comp, body: MidBodyNode, operand: MidOperandNode) -> Bool {
        if operand.tag != 4U64 || operand.capability != 2U64 || !self.midCanonicalInoutPlaceSupported(c: inout c, body: body, placeId: operand.place) { return false }
        if operand.accessPlace != 0U64 && !self.midCanonicalInoutPlaceSupported(c: inout c, body: body, placeId: operand.accessPlace) { return false }
        return true
    }

    fn midCanonicalInoutIsShared(c: Comp, place: MidPlaceNode) -> Bool {
        return place.projections.len != 0U64 && c.mid.projections[place.projections.start].tag == 3U64
    }

    inout fn midCanonicalEmitInoutPair(c: inout Comp, body: MidBodyNode, operand: MidOperandNode, other: MidOperandNode) {
        val storage: MidPlaceNode = c.mid.places[self.midCanonicalInoutStorage(c: c, operand: operand) - 1U64]
        val otherStorage: MidPlaceNode = c.mid.places[self.midCanonicalInoutStorage(c: c, operand: other) - 1U64]
        // Value roots and the mixed value/pointee case were resolved by the
        // frontend. Only two shared cells can require a dynamic comparison.
        if !self.midCanonicalInoutIsShared(c: c, place: storage) || !self.midCanonicalInoutIsShared(c: c, place: otherStorage) { return }
        if storage.projections.len > 1U64 && otherStorage.projections.len > 1U64 {
            val field: MidProjectionNode = c.mid.projections[storage.projections.start + 1U64]
            val otherField: MidProjectionNode = c.mid.projections[otherStorage.projections.start + 1U64]
            if field.tag == 1U64 && otherField.tag == 1U64 && field.index != otherField.index { return }
        }
        val cellPlace: MidPlaceNode = <MidPlaceNode local=storage.local projections=<MidRange start=storage.projections.start len=1U64 /> typeTerm=c.mid.projections[storage.projections.start].typeTerm />
        val otherCellPlace: MidPlaceNode = <MidPlaceNode local=otherStorage.local projections=<MidRange start=otherStorage.projections.start len=1U64 /> typeTerm=c.mid.projections[otherStorage.projections.start].typeTerm />
        self.emitInoutCellCheck(c: inout c, cell: self.midCanonicalPlacePtr(c: inout c, body: body, place: cellPlace), otherCell: self.midCanonicalPlacePtr(c: inout c, body: body, place: otherCellPlace))
    }

    inout fn midCanonicalEmitInoutChecks(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode) {
        mut val receiverOperand: U64 = 0U64
        if term.callReceiver != 0U64 {
            val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
            if receiver.tag == 2U64 && c.mid.operands[receiver.operand - 1U64].tag == 4U64 { receiverOperand = receiver.operand }
        }
        mut val index: U64 = 0U64
        while index < term.args.len {
            val operand: MidOperandNode = c.mid.operands[c.mid.callArguments[term.args.start + index] - 1U64]
            if operand.tag == 4U64 {
                if receiverOperand != 0U64 { self.midCanonicalEmitInoutPair(c: inout c, body: body, operand: c.mid.operands[receiverOperand - 1U64], other: operand) }
                mut val prior: U64 = 0U64
                while prior < index {
                    val other: MidOperandNode = c.mid.operands[c.mid.callArguments[term.args.start + prior] - 1U64]
                    if other.tag == 4U64 { self.midCanonicalEmitInoutPair(c: inout c, body: body, operand: other, other: operand) }
                    prior += 1U64
                }
            }
            index += 1U64
        }
    }

    inout fn midCanonicalReceiverSupported(c: inout Comp, body: MidBodyNode, receiverId: U64, passing: CallReceiverPassing) -> Bool {
        if receiverId == 0U64 || receiverId > c.mid.callReceivers.count() { return false }
        val receiver: MidCallReceiverNode = c.mid.callReceivers[receiverId - 1U64]
        match passing {
            CallReceiverPassing.None => { return receiver.tag == 1U64 }
            CallReceiverPassing.Borrow => {
                if receiver.tag != 2U64 { return false }
                return self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: receiver.operand)
            }
            CallReceiverPassing.Inout => {
                if receiver.tag != 2U64 || receiver.operand == 0U64 || receiver.operand > c.mid.operands.count() { return false }
                val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                // Canonical operand tags distinguish the two borrow modes:
                // tag 3 is Read and tag 4 is Inout (Mid/Ir.midFreezeOperand).
                // Keep the backend preflight in that same closed vocabulary;
                // accepting a made-up "tag 3, capability 2" combination would
                // make a correctly elaborated access fall back to source LLVM.
                return self.midCanonicalInoutOperandSupported(c: inout c, body: body, operand: operand)
            }
            CallReceiverPassing.Move => {
                if receiver.tag != 2U64 || receiver.operand == 0U64 || receiver.operand > c.mid.operands.count() { return false }
                val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                return operand.tag == 2U64 && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place)
            }
        }
    }

    inout fn midCanonicalDirectCallPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target { CallTarget.Direct => {} _ => { return <MidCallPreflight.Target /> } }
        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.functionAt(index: selected.callee)
        if callee.isAsync && (callee.hasRecv || callee.typeParams.count() != 0U64 || self.asyncEntrySlot(fi: selected.callee) >= self.asyncEntryIdx.count()) { return <MidCallPreflight.Async /> }
        if callee.hasRecv {
            if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: selected.receiverPassing) {
                if c.traceCodegen {
                    eprint(text: "[trace-codegen] Mid receiver-reject expected=")
                    match selected.receiverPassing {
                        CallReceiverPassing.None => { eprint(text: "none") }
                        CallReceiverPassing.Borrow => { eprint(text: "borrow") }
                        CallReceiverPassing.Inout => { eprint(text: "inout") }
                        CallReceiverPassing.Move => { eprint(text: "move") }
                    }
                    eprint(text: " receiver-id=")
                    self.traceCodegenU64(n: term.callReceiver)
                    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
                        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
                        eprint(text: " receiver-tag=")
                        self.traceCodegenU64(n: receiver.tag)
                        eprint(text: " operand=")
                        self.traceCodegenU64(n: receiver.operand)
                        if receiver.operand != 0U64 && receiver.operand <= c.mid.operands.count() {
                            val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                            eprint(text: " operand-tag=")
                            self.traceCodegenU64(n: operand.tag)
                            eprint(text: " capability=")
                            self.traceCodegenU64(n: operand.capability)
                            eprint(text: " place=")
                            self.traceCodegenU64(n: operand.place)
                        }
                    }
                    eprint(text: "\n")
                }
                return <MidCallPreflight.Receiver />
            }
        } else if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.Receiver /> }
        if callee.isExtern && !self.resolvedCCallSupported(c: inout c, selected: selected) { return <MidCallPreflight.Extern /> }
        if callee.typeParams.count() != selected.calleeTypeArgs.len { return <MidCallPreflight.GenericArguments /> }
        if callee.typeParams.count() > 0U64 && !(c.fnArgsAllGround(args: c.copyFinalCalleeTypeArgs(args: selected.calleeTypeArgs))) { return <MidCallPreflight.GenericArguments /> }
        if term.args.len != callee.params.count() || selected.parameterTypeRefs.len != term.args.len || selected.argumentPassings.len != term.args.len { return <MidCallPreflight.ArgumentShape /> }
        if callee.hasRet {
            if term.destination == 0U64 || term.destination > c.mid.places.count() || c.mid.places[term.destination - 1U64].projections.len != 0U64 || selected.resultTypeRef == 0U64 { return <MidCallPreflight.Result /> }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            val operandId: U64 = c.mid.callArguments[term.args.start + argumentI]
            if operandId == 0U64 || operandId > c.mid.operands.count() || c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: argumentI) >= c.arena.typeCount() { return <MidCallPreflight.ArgumentShape /> }
            val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
            match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: argumentI) {
                CallArgumentPassing.Inout => { if !self.midCanonicalInoutOperandSupported(c: inout c, body: body, operand: operand) { return <MidCallPreflight.Argument /> } }
                CallArgumentPassing.Move => { if operand.tag != 2U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> } }
                CallArgumentPassing.Borrow => {
                    if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: operandId) { return <MidCallPreflight.Argument /> }
                }
            }
            argumentI = argumentI + 1U64
        }
        return <MidCallPreflight.None />
    }

    fn midCanonicalCallArgumentAt(c: Comp, term: MidTerminatorNode, index: U64) -> U64 {
        if index >= term.args.len || term.args.start + index >= c.mid.callArguments.count() { return 0U64 }
        return c.mid.callArguments[term.args.start + index]
    }

    inout fn midCanonicalReadOperandSupported(c: inout Comp, body: MidBodyNode, operandId: U64) -> Bool {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return false }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag == 3U64 { return operand.capability == 1U64 && self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) }
        return operand.tag == 5U64 || operand.tag == 6U64 || operand.tag == 7U64
    }

    inout fn midCanonicalRuntimeSystemPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target { CallTarget.RuntimeIntrinsic(intrinsic: _) => {} _ => { return <MidCallPreflight.Target /> } }
        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.functionAt(index: selected.callee)
        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.RuntimeAbi /> }
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.TimerSleep => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                    RuntimeIntrinsic.HashSeed => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                    RuntimeIntrinsic.EntropyU64 => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                    RuntimeIntrinsic.Process(intrinsic: val process) => {
                        match process {
                            ProcessIntrinsic.ArgCount => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.ArgAt => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.Exit => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.ExecOut => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            ProcessIntrinsic.ExecCode => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                        }
                    }
                    RuntimeIntrinsic.Io(intrinsic: val io) => {
                        match io {
                            IoIntrinsic.Write => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.WriteByte => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.ReadStdin => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.ReadFile => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.ReadFileBytes => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.Eprint => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            IoIntrinsic.FileExists => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                        }
                    }
                    _ => { return <MidCallPreflight.Target /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: argumentI)) { return <MidCallPreflight.Argument /> }
            argumentI = argumentI + 1U64
        }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitRuntimeSystemCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalRuntimeSystemPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        val callee: Func = c.arena.functionAt(index: selected.callee)
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.TimerSleep => {
                        val duration = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))
                        llvmStore(self.b, self.genTimerSleep(c: inout c, duration: duration), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                        return true
                    }
                    RuntimeIntrinsic.HashSeed => { llvmStore(self.b, self.emitRuntimeCallWithoutArguments(c: inout c, name: "plew_dict_seed", resultType: self.i64ty), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) return true }
                    RuntimeIntrinsic.EntropyU64 => { llvmStore(self.b, self.emitRuntimeCallWithoutArguments(c: inout c, name: "plew_random_u64", resultType: self.i64ty), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) return true }
                    RuntimeIntrinsic.Io(intrinsic: val io) => {
                        match io {
                            IoIntrinsic.Write => { self.emitStrSinkValue(c: inout c, rtName: "plew_write_raw", value: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))) }
                            IoIntrinsic.Eprint => { self.emitStrSinkValue(c: inout c, rtName: "plew_eprint_raw", value: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))) }
                            IoIntrinsic.WriteByte => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.i8ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.coerceInt(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)), target: self.i8ty, unsigned: true))
                                LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_writeByte", fnTy: signature), arrayCPtr(values), 1U64, anon())
                            }
                            IoIntrinsic.ReadStdin => {
                                val result: LLVMValueRef = self.emitRuntimeCallWithoutArguments(c: inout c, name: "plew_readStdin", resultType: self.stringLlvmTy(c: inout c))
                                llvmStore(self.b, result, self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            IoIntrinsic.ReadFile => { llvmStore(self.b, self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_readFile", retTy: self.stringLlvmTy(c: inout c), path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                            IoIntrinsic.ReadFileBytes => { llvmStore(self.b, self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_readFileBytes", retTy: self.stringLlvmTy(c: inout c), path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                            IoIntrinsic.FileExists => {
                                val raw: LLVMValueRef = self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_fileExists", retTy: self.i64ty, path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)))
                                llvmStore(self.b, LLVMBuildICmp(self.b, llvmIntNe(), raw, LLVMConstInt(self.i64ty, 0U64, 0I32), anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                        }
                        return true
                    }
                    RuntimeIntrinsic.Process(intrinsic: val process) => {
                        match process {
                            ProcessIntrinsic.ArgCount => {
                                llvmStore(self.b, self.emitRuntimeCallWithoutArguments(c: inout c, name: "plew_argCount", resultType: self.i64ty), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            ProcessIntrinsic.ArgAt => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.i64ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.extendToI64(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)), unsigned: false))
                                llvmStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_argAt", fnTy: signature), arrayCPtr(values), 1U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            ProcessIntrinsic.ExecOut => { llvmStore(self.b, self.emitPathStrIntrinsicValue(c: inout c, rtName: "plew_execOut", retTy: self.stringLlvmTy(c: inout c), path: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                            ProcessIntrinsic.ExecCode => {
                                llvmStore(self.b, self.emitRuntimeCallWithoutArguments(c: inout c, name: "plew_execCode", resultType: self.i64ty), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            ProcessIntrinsic.Exit => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.i64ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.extendToI64(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)), unsigned: false))
                                LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_exit", fnTy: signature), arrayCPtr(values), 1U64, anon())
                            }
                        }
                        return true
                    }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn midCanonicalRuntimeCoreStringFfiPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target { CallTarget.RuntimeIntrinsic(intrinsic: _) => {} _ => { return <MidCallPreflight.Target /> } }
        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.functionAt(index: selected.callee)
        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.RuntimeAbi /> }
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.CoreString(intrinsic: _) => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                    RuntimeIntrinsic.Ffi(intrinsic: val ffi) => {
                        match ffi {
                            FfiIntrinsic.CString => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            FfiIntrinsic.CFree => { if callee.hasRet || term.args.len != 1U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            FfiIntrinsic.StringFromCString => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                            FfiIntrinsic.ArrayCPtr => { if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.RuntimeAbi /> } }
                        }
                    }
                    _ => { return <MidCallPreflight.Target /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitRuntimeCoreStringFfiCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalRuntimeCoreStringFfiPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        val argument: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.CoreString(intrinsic: val coreString) => {
                        match coreString {
                            CoreStringIntrinsic.FromBytesUnchecked => {
                                val array: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument)
                                val arrayTerm: U64 = self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: argument)
                                if arrayTerm != 0U64 && arrayTerm < c.arena.typeCount() && c.finalNeedsRelease(typeRef: arrayTerm) { self.valueArc(c: inout c, v: array, typeRef: arrayTerm, retain: true) }
                                val result: LLVMValueRef = self.arrValMake(c: inout c, data: self.arrValData(c: inout c, arr: array), count: self.arrValCount(c: inout c, arr: array), aggTy: self.stringLlvmTy(c: inout c))
                                llvmStore(self.b, result, self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            CoreStringIntrinsic.FloatToString => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.f64ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument))
                                llvmStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_f64_to_str", fnTy: signature), arrayCPtr(values), 1U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                        }
                        return true
                    }
                    RuntimeIntrinsic.Ffi(intrinsic: val ffi) => {
                        match ffi {
                            FfiIntrinsic.CString => {
                                val text: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument)
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.ptrty)
                                parameters.append(self.i64ty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(parameters), 2U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.arrValData(c: inout c, arr: text))
                                values.append(self.arrValCount(c: inout c, arr: text))
                                llvmStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_cString", fnTy: signature), arrayCPtr(values), 2U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            FfiIntrinsic.CFree => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.ptrty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument))
                                LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_cFree", fnTy: signature), arrayCPtr(values), 1U64, anon())
                            }
                            FfiIntrinsic.StringFromCString => {
                                mut val parameters: Array[LLVMTypeRef] = []
                                parameters.append(self.ptrty)
                                val signature: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(parameters), 1U64, 0I32)
                                mut val values: Array[LLVMValueRef] = []
                                values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument))
                                llvmStore(self.b, LLVMBuildCall2(self.b, signature, self.getOrDeclare(c: inout c, name: "plew_stringFromCString", fnTy: signature), arrayCPtr(values), 1U64, anon()), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                            }
                            FfiIntrinsic.ArrayCPtr => { llvmStore(self.b, self.arrValData(c: inout c, arr: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument)), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local)) }
                        }
                        return true
                    }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn midCanonicalRuntimeNumericPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.Numeric(intrinsic: val numeric) => {
                        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
                        val callee: Func = c.arena.functionAt(index: selected.callee)
                        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !callee.hasRet || term.args.len != self.numericIntrinsicArity(intrinsic: numeric) || term.destination == 0U64 || !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.RuntimeAbi /> }
                        mut val argumentI: U64 = 0U64
                        while argumentI < term.args.len {
                            if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: argumentI)) { return <MidCallPreflight.Argument /> }
                            argumentI = argumentI + 1U64
                        }
                        return <MidCallPreflight.None />
                    }
                    _ => { return <MidCallPreflight.Target /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
    }

    inout fn midCanonicalEmitRuntimeNumericCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalRuntimeNumericPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.Numeric(intrinsic: val numeric) => {
                        mut val values: Array[LLVMValueRef] = []
                        mut val argumentI: U64 = 0U64
                        while argumentI < term.args.len {
                            values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: argumentI)))
                            argumentI = argumentI + 1U64
                        }
                        val callee: Func = c.arena.functionAt(index: selected.callee)
                        val raw: LLVMValueRef = self.genNumericIntrinsicValues(c: inout c, intrinsic: numeric, values: values, errorOffset: callee.nameStart)
                        llvmStore(self.b, self.midProjectCallResult(selected: selected, value: raw), self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
                        return true
                    }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn midCanonicalBufferInoutOperandSupported(c: inout Comp, body: MidBodyNode, bufferRef: U64, operandId: U64) -> Bool {
        if bufferRef == 0U64 || bufferRef >= c.arena.typeCount() || operandId == 0U64 || operandId > c.mid.operands.count() { return false }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        if operand.tag != 4U64 || operand.capability != 2U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place, allowDeref: false) { return false }
        return c.typeRefEq(a: c.mid.places[operand.place - 1U64].typeTerm, b: bufferRef)
    }

    inout fn midCanonicalOperandNeedsOwnedDestination(c: Comp, operandId: U64) -> Bool {
        if operandId == 0U64 || operandId > c.mid.operands.count() { return false }
        val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
        return operand.tag != 1U64 && operand.tag != 2U64
    }

    // Buffer's runtime ABI is deliberately split from ordinary direct calls:
    // the selected intrinsic is the authority for the raw-buffer operation,
    // while the canonical operand rows retain the source ownership mode.  Do
    // not recover either fact from a source name or a thawed MidBody.
    inout fn midCanonicalRuntimeBufferPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic { RuntimeIntrinsic.Buffer(intrinsic: _) => {} _ => { return <MidCallPreflight.Target /> } }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.functionAt(index: selected.callee)
        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.RuntimeAbi /> }
        if term.destination != 0U64 && (term.destination > c.mid.places.count() || c.mid.places[term.destination - 1U64].projections.len != 0U64) { return <MidCallPreflight.Buffer /> }
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.Buffer(intrinsic: val buffer) => {
                        match buffer {
                            BufferIntrinsic.New => { if !callee.hasRet || term.args.len != 0U64 || term.destination == 0U64 { return <MidCallPreflight.Buffer /> } }
                            BufferIntrinsic.Count => {
                                if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.Buffer /> }
                                if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Capacity => {
                                if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 { return <MidCallPreflight.Buffer /> }
                                if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Get => {
                                if !callee.hasRet || term.args.len != 2U64 || term.destination == 0U64 || selected.resultTypeRef == 0U64 || selected.resultTypeRef >= c.arena.typeCount() { return <MidCallPreflight.Buffer /> }
                                mut val i: U64 = 0U64
                                while i < 2U64 {
                                    if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: i)) { return <MidCallPreflight.Argument /> }
                                    i = i + 1U64
                                }
                            }
                            BufferIntrinsic.BytewiseComparable => {
                                if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 || selected.parameterTypeRefs.len != 1U64 { return <MidCallPreflight.Buffer /> }
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64))
                                if elementRef == 0U64 || !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Eq => {
                                if !callee.hasRet || term.args.len != 2U64 || term.destination == 0U64 || selected.parameterTypeRefs.len != 2U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !c.typeRefEq(a: c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 1U64), b: bufferRef) { return <MidCallPreflight.Buffer /> }
                                mut val i: U64 = 0U64
                                while i < 2U64 {
                                    if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: i)) { return <MidCallPreflight.Argument /> }
                                    i = i + 1U64
                                }
                            }
                            BufferIntrinsic.Append => {
                                if callee.hasRet || term.args.len != 2U64 || selected.parameterTypeRefs.len != 2U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) || !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Reserve => {
                                if callee.hasRet || term.args.len != 2U64 || selected.parameterTypeRefs.len != 2U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) || !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Set => {
                                if callee.hasRet || term.args.len != 3U64 || selected.parameterTypeRefs.len != 3U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                                mut val i: U64 = 1U64
                                while i < 3U64 {
                                    if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: i)) { return <MidCallPreflight.Argument /> }
                                    i = i + 1U64
                                }
                            }
                            BufferIntrinsic.InsertAt => {
                                if callee.hasRet || term.args.len != 3U64 || selected.parameterTypeRefs.len != 3U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                                mut val i: U64 = 1U64
                                while i < 3U64 {
                                    if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: i)) { return <MidCallPreflight.Argument /> }
                                    i = i + 1U64
                                }
                            }
                            BufferIntrinsic.RemoveLast => {
                                if !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 || selected.parameterTypeRefs.len != 1U64 || selected.resultTypeRef == 0U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                if elementRef == 0U64 || !c.typeRefEq(a: selected.resultTypeRef, b: elementRef) || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.RemoveAt => {
                                if !callee.hasRet || term.args.len != 2U64 || term.destination == 0U64 || selected.parameterTypeRefs.len != 2U64 || selected.resultTypeRef == 0U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                if elementRef == 0U64 || !c.typeRefEq(a: selected.resultTypeRef, b: elementRef) || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) || !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.SwapRemove => {
                                if !callee.hasRet || term.args.len != 2U64 || term.destination == 0U64 || selected.parameterTypeRefs.len != 2U64 || selected.resultTypeRef == 0U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                if elementRef == 0U64 || !c.typeRefEq(a: selected.resultTypeRef, b: elementRef) || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) || !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Clear => {
                                if callee.hasRet || term.args.len != 1U64 || selected.parameterTypeRefs.len != 1U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) { return <MidCallPreflight.Argument /> }
                            }
                            BufferIntrinsic.Truncate => {
                                if callee.hasRet || term.args.len != 2U64 || selected.parameterTypeRefs.len != 2U64 { return <MidCallPreflight.Buffer /> }
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                if self.midBufferElementRef(c: inout c, bufferRef: bufferRef) == 0U64 || !self.midCanonicalBufferInoutOperandSupported(c: inout c, body: body, bufferRef: bufferRef, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)) || !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64)) { return <MidCallPreflight.Argument /> }
                            }
                            _ => { return <MidCallPreflight.Buffer /> }
                        }
                        return <MidCallPreflight.None />
                    }
                    _ => { return <MidCallPreflight.Target /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
    }

    inout fn midCanonicalEmitRuntimeBufferCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalRuntimeBufferPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        mut val destination: LLVMValueRef = LLVMConstNull(self.ptrty)
        if term.destination != 0U64 { destination = self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local) }
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.Buffer(intrinsic: val buffer) => {
                        match buffer {
                            BufferIntrinsic.New => { llvmStore(self.b, self.genLlvmBufferNew(c: inout c), destination) }
                            BufferIntrinsic.Count => { llvmStore(self.b, self.rawbufCount(c: inout c, data: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), destination) }
                            BufferIntrinsic.Capacity => { llvmStore(self.b, self.rawbufCap(c: inout c, data: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))), destination) }
                            BufferIntrinsic.Get => {
                                val elementRef: U64 = selected.resultTypeRef
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val data: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))
                                val index: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                self.emitBoundsCheck(c: inout c, idx: index, count: self.rawbufCount(c: inout c, data: data))
                                val result: LLVMValueRef = llvmLoad(self.b, elementTy, self.arrElemPtr(elemTy: elementTy, data: data, idx: index), anon())
                                if c.finalNeedsRelease(typeRef: elementRef) { self.valueArc(c: inout c, v: result, typeRef: elementRef, retain: true) }
                                llvmStore(self.b, result, destination)
                            }
                            BufferIntrinsic.BytewiseComparable => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                llvmStore(self.b, self.genLlvmBufferBytewiseComparable(elemTy: self.llvmTypeOfRef(c: inout c, ref: elementRef)), destination)
                            }
                            BufferIntrinsic.Eq => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val left: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))
                                val right: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                llvmStore(self.b, self.genLlvmBufferEqValues(c: inout c, elemTy: self.llvmTypeOfRef(c: inout c, ref: elementRef), lhs: left, rhs: right), destination)
                            }
                            BufferIntrinsic.Append => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperandId: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)
                                val bufferOperand: MidOperandNode = c.mid.operands[bufferOperandId - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                val grown: LLVMValueRef = self.growBuf(c: inout c, data: data, elemTy: elementTy, count: count)
                                llvmStore(self.b, grown, slot)
                                val valueOperandId: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64)
                                mut val value: LLVMValueRef = self.coerceElem(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: valueOperandId), elemTy: elementTy)
                                if self.midCanonicalOperandNeedsOwnedDestination(c: c, operandId: valueOperandId) && c.finalNeedsRelease(typeRef: elementRef) { self.valueArc(c: inout c, v: value, typeRef: elementRef, retain: true) }
                                llvmStore(self.b, value, self.arrElemPtr(elemTy: elementTy, data: grown, idx: count))
                                self.rawbufSetCount(c: inout c, data: grown, n: LLVMBuildAdd(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()))
                            }
                            BufferIntrinsic.Reserve => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperandId: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)
                                val bufferOperand: MidOperandNode = c.mid.operands[bufferOperandId - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                val additional: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                val minimum: LLVMValueRef = LLVMBuildAdd(self.b, count, additional, anon())
                                llvmStore(self.b, self.rawbufReserve(c: inout c, data: data, elemSize: LLVMSizeOf(elementTy), mincap: minimum), slot)
                            }
                            BufferIntrinsic.Set => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val index: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                self.emitBoundsCheck(c: inout c, idx: index, count: self.rawbufCount(c: inout c, data: data))
                                val valueOperandId: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 2U64)
                                mut val value: LLVMValueRef = self.coerceElem(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: valueOperandId), elemTy: elementTy)
                                if self.midCanonicalOperandNeedsOwnedDestination(c: c, operandId: valueOperandId) && c.finalNeedsRelease(typeRef: elementRef) { self.valueArc(c: inout c, v: value, typeRef: elementRef, retain: true) }
                                val elementSlot: LLVMValueRef = self.arrElemPtr(elemTy: elementTy, data: data, idx: index)
                                if c.finalNeedsRelease(typeRef: elementRef) {
                                    val old: LLVMValueRef = llvmLoad(self.b, elementTy, elementSlot, anon())
                                    llvmStore(self.b, value, elementSlot)
                                    self.valueArc(c: inout c, v: old, typeRef: elementRef, retain: false)
                                } else { llvmStore(self.b, value, elementSlot) }
                            }
                            BufferIntrinsic.InsertAt => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val beforeGrow: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: beforeGrow)
                                val index: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                self.emitBoundsCheck(c: inout c, idx: index, count: LLVMBuildAdd(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()))
                                val data: LLVMValueRef = self.growBuf(c: inout c, data: beforeGrow, elemTy: elementTy, count: count)
                                llvmStore(self.b, data, slot)
                                self.rawbufMove(c: inout c, data: data, elemSize: LLVMSizeOf(elementTy), dst: LLVMBuildAdd(self.b, index, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), src: index, n: LLVMBuildSub(self.b, count, index, anon()))
                                val valueOperandId: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 2U64)
                                mut val value: LLVMValueRef = self.coerceElem(v: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: valueOperandId), elemTy: elementTy)
                                if self.midCanonicalOperandNeedsOwnedDestination(c: c, operandId: valueOperandId) && c.finalNeedsRelease(typeRef: elementRef) { self.valueArc(c: inout c, v: value, typeRef: elementRef, retain: true) }
                                llvmStore(self.b, value, self.arrElemPtr(elemTy: elementTy, data: data, idx: index))
                                self.rawbufSetCount(c: inout c, data: data, n: LLVMBuildAdd(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()))
                            }
                            BufferIntrinsic.RemoveLast => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                self.emitBoundsCheck(c: inout c, idx: LLVMConstInt(self.i64ty, 0U64, 0I32), count: count)
                                val nextCount: LLVMValueRef = LLVMBuildSub(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
                                val result: LLVMValueRef = llvmLoad(self.b, elementTy, self.arrElemPtr(elemTy: elementTy, data: data, idx: nextCount), anon())
                                self.rawbufSetCount(c: inout c, data: data, n: nextCount)
                                llvmStore(self.b, result, destination)
                            }
                            BufferIntrinsic.RemoveAt => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                val index: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                self.emitBoundsCheck(c: inout c, idx: index, count: count)
                                val result: LLVMValueRef = llvmLoad(self.b, elementTy, self.arrElemPtr(elemTy: elementTy, data: data, idx: index), anon())
                                val nextCount: LLVMValueRef = LLVMBuildSub(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
                                self.rawbufMove(c: inout c, data: data, elemSize: LLVMSizeOf(elementTy), dst: index, src: LLVMBuildAdd(self.b, index, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), n: LLVMBuildSub(self.b, nextCount, index, anon()))
                                self.rawbufSetCount(c: inout c, data: data, n: nextCount)
                                llvmStore(self.b, result, destination)
                            }
                            BufferIntrinsic.SwapRemove => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                val index: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                self.emitBoundsCheck(c: inout c, idx: index, count: count)
                                val result: LLVMValueRef = llvmLoad(self.b, elementTy, self.arrElemPtr(elemTy: elementTy, data: data, idx: index), anon())
                                val last: LLVMValueRef = LLVMBuildSub(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
                                self.rawbufMove(c: inout c, data: data, elemSize: LLVMSizeOf(elementTy), dst: index, src: last, n: LLVMConstInt(self.i64ty, 1U64, 0I32))
                                self.rawbufSetCount(c: inout c, data: data, n: last)
                                llvmStore(self.b, result, destination)
                            }
                            BufferIntrinsic.Clear => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                self.rawbufSetCount(c: inout c, data: data, n: LLVMConstInt(self.i64ty, 0U64, 0I32))
                                self.emitArrayElemRangeRelease(c: inout c, data: data, start: LLVMConstInt(self.i64ty, 0U64, 0I32), end: count, elemTy: elementTy, elemRef: elementRef)
                            }
                            BufferIntrinsic.Truncate => {
                                val bufferRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
                                val elementRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: bufferRef)
                                val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
                                val bufferOperand: MidOperandNode = c.mid.operands[self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64) - 1U64]
                                val slot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[bufferOperand.place - 1U64], forWrite: true)
                                val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elementTy, elemRef: elementRef)
                                val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
                                val requested: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 1U64))
                                val shrink: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntUlt(), requested, count, anon())
                                val shrinkBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.buf.truncate"))
                                val continueBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.buf.truncate.cont"))
                                LLVMBuildCondBr(self.b, shrink, shrinkBlock, continueBlock)
                                LLVMPositionBuilderAtEnd(self.b, shrinkBlock)
                                self.rawbufSetCount(c: inout c, data: data, n: requested)
                                self.emitArrayElemRangeRelease(c: inout c, data: data, start: requested, end: count, elemTy: elementTy, elemRef: elementRef)
                                LLVMBuildBr(self.b, continueBlock)
                                LLVMPositionBuilderAtEnd(self.b, continueBlock)
                            }
                            _ => { return false }
                        }
                        return true
                    }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    fn midCanonicalBindingLocal(c: Comp, body: MidBodyNode, binding: U64) -> U64 {
        mut val index: U64 = 0U64
        while index < body.locals.len {
            if c.mid.locals[body.locals.start + index].sourceNameStart == binding { return index }
            index += 1U64
        }
        return body.locals.len
    }

    inout fn midCanonicalClosureCallPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        mut val functionType: U64 = 0U64
        match selected.target {
            CallTarget.ClosureLocal(bindingDeclStart: val binding, fnTypeRef: val ref) => {
                functionType = ref
                val local: U64 = self.midCanonicalBindingLocal(c: c, body: body, binding: binding)
                if local >= body.locals.len || !c.typeRefEq(a: c.mid.locals[body.locals.start + local].typeTerm, b: ref) { return <MidCallPreflight.Receiver /> }
                if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.Receiver /> }
            }
            CallTarget.ClosureField(fieldIndex: val field, fnTypeRef: val ref) => {
                functionType = ref
                if selected.recvTypeRef == 0U64 || selected.recvTypeRef >= c.arena.typeCount() || !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.Borrow />) { return <MidCallPreflight.Receiver /> }
                val receiverType: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: selected.recvTypeRef)
                if LLVMGetTypeKind(receiverType) != 10U32 || field >= (LLVMCountStructElementTypes(receiverType) as U64) { return <MidCallPreflight.Receiver /> }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        if functionType == 0U64 || functionType >= c.arena.typeCount() || !c.isFnType(ref: functionType) { return <MidCallPreflight.Callee /> }
        val signature: TypeRef = c.arena.typeAt(index: functionType)
        if signature.args.count() != term.args.len + 1U64 || selected.parameterTypeRefs.len != term.args.len || selected.argumentPassings.len != term.args.len { return <MidCallPreflight.ArgumentShape /> }
        mut val index: U64 = 0U64
        while index < term.args.len {
            if !c.typeRefEq(a: c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: index), b: signature.args[index + 1U64]) { return <MidCallPreflight.ArgumentShape /> }
            match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: index) { CallArgumentPassing.Borrow => {} _ => { return <MidCallPreflight.Argument /> } }
            if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: c.mid.callArguments[term.args.start + index]) { return <MidCallPreflight.Argument /> }
            index += 1U64
        }
        if !c.functionTypeReturnsUnit(ref: functionType) {
            if term.destination == 0U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: term.destination) || !c.typeRefEq(a: selected.resultTypeRef, b: signature.args[0U64]) { return <MidCallPreflight.Result /> }
        }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitClosureCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalClosureCallPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        mut val functionType: U64 = 0U64
        mut val closure: LLVMValueRef = LLVMConstNull(self.ptrty)
        match selected.target {
            CallTarget.ClosureLocal(bindingDeclStart: val binding, fnTypeRef: val ref) => {
                functionType = ref
                val local: U64 = self.midCanonicalBindingLocal(c: c, body: body, binding: binding)
                closure = self.midCanonicalReadPlace(c: inout c, body: body, place: <MidPlaceNode rootTag=1U64 local=local typeTerm=ref />)
            }
            CallTarget.ClosureField(fieldIndex: val field, fnTypeRef: val ref) => {
                functionType = ref
                val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
                closure = LLVMBuildExtractValue(self.b, self.midCanonicalEmitOperand(c: inout c, body: body, operandId: receiver.operand), field, anon())
            }
            _ => { return false }
        }
        val function: LLVMValueRef = LLVMBuildExtractValue(self.b, closure, 0U64, anon())
        mut val values: Array[LLVMValueRef] = [LLVMBuildExtractValue(self.b, closure, 1U64, anon())]
        mut val types: Array[LLVMTypeRef] = [self.ptrty]
        mut val index: U64 = 0U64
        while index < term.args.len {
            val parameterRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: index)
            val parameter: TypeRef = c.arena.typeAt(index: parameterRef)
            val parameterType: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: parameterRef)
            mut val value: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: c.mid.callArguments[term.args.start + index])
            if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 { value = self.coerceInt(v: value, target: parameterType, unsigned: isUnsignedName(c: inout c, start: parameter.nameStart, len: parameter.nameLen)) }
            values.append(value)
            types.append(parameterType)
            index += 1U64
        }
        val unit: Bool = c.functionTypeReturnsUnit(ref: functionType)
        mut val resultType: LLVMTypeRef = self.voidty
        if !unit { resultType = self.llvmTypeOfRef(c: inout c, ref: selected.resultTypeRef) }
        val signature: LLVMTypeRef = LLVMFunctionType(resultType, arrayCPtr(types), types.count(), 0I32)
        val result: LLVMValueRef = self.callValueFunction(signature: signature, function: function, arguments: values)
        if !unit { llvmStore(self.b, result, self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[term.destination - 1U64])) }
        return true
    }

    inout fn midCanonicalExistentialCallPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Resolution /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target {
            CallTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot) => {
                if traitIndex >= c.decls.traitCount() || slot == 0U64 || slot > c.decls.traitAt(index: traitIndex).reqs.count() { return <MidCallPreflight.Callee /> }
                val requirement: Func = c.traitReqAt(reqs: c.decls.traitAt(index: traitIndex).reqs, index: slot - 1U64)
                if requirement.isAsync { return <MidCallPreflight.Async /> }
                if requirement.isAssoc || c.reqUsesSelfInInput(req: requirement) || !c.reqRetSelfErasable(req: requirement) { return <MidCallPreflight.Callee /> }
                if selected.recvTypeRef == 0U64 || selected.recvTypeRef >= c.arena.typeCount() || !c.arena.typeAt(index: selected.recvTypeRef).isAny { return <MidCallPreflight.Receiver /> }
                // Thunks borrow their box or mutate its privatized storage.
                // Consuming receivers require a distinct box-ownership ABI.
                match selected.receiverPassing {
                    CallReceiverPassing.Borrow => { if requirement.selfInout || requirement.selfMove { return <MidCallPreflight.Receiver /> } }
                    CallReceiverPassing.Inout => { if !requirement.selfInout { return <MidCallPreflight.Receiver /> } }
                    _ => { return <MidCallPreflight.Receiver /> }
                }
                if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: selected.receiverPassing) { return <MidCallPreflight.Receiver /> }
                val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
                if !c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: receiver.operand), b: selected.recvTypeRef) { return <MidCallPreflight.Receiver /> }
                if term.args.len != requirement.params.count() || selected.parameterTypeRefs.len != term.args.len || selected.argumentPassings.len != term.args.len { return <MidCallPreflight.ArgumentShape /> }
                if requirement.hasRet {
                    if selected.resultTypeRef == 0U64 || selected.resultTypeRef >= c.arena.typeCount() || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: term.destination) { return <MidCallPreflight.Result /> }
                    val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
                    if destination.projections.len != 0U64 || !c.typeRefEq(a: destination.typeTerm, b: selected.resultTypeRef) { return <MidCallPreflight.Result /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        mut val index: U64 = 0U64
        while index < term.args.len {
            val operandId: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: index)
            val parameter: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: index)
            if operandId == 0U64 || operandId > c.mid.operands.count() || parameter == 0U64 || parameter >= c.arena.typeCount() { return <MidCallPreflight.ArgumentShape /> }
            val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
            match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: index) {
                CallArgumentPassing.Inout => { if !self.midCanonicalInoutOperandSupported(c: inout c, body: body, operand: operand) { return <MidCallPreflight.Argument /> } }
                CallArgumentPassing.Move => { if operand.tag != 2U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> } }
                CallArgumentPassing.Borrow => {
                    if operand.tag == 3U64 {
                        if operand.capability != 1U64 || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> }
                    } else if operand.tag != 5U64 && operand.tag != 6U64 && operand.tag != 7U64 { return <MidCallPreflight.Argument /> }
                }
            }
            index += 1U64
        }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitExistentialCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalExistentialCallPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val selected: CallResolution = c.arena.finalCallees[c.mid.callTargets[term.callTarget - 1U64].resolution]
        match selected.target {
            CallTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot) => {
                val requirement: Func = c.traitReqAt(reqs: c.decls.traitAt(index: traitIndex).reqs, index: slot - 1U64)
                val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
                mut val fat: LLVMValueRef = LLVMGetUndef(self.anyTy)
                match selected.receiverPassing {
                    CallReceiverPassing.Inout => {
                        val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
                        val place: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[operand.place - 1U64], forWrite: true)
                        fat = self.privatizeAnyBox(c: inout c, fat: llvmLoad(self.b, self.anyTy, place, anon()), place: place)
                    }
                    CallReceiverPassing.Borrow => { fat = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: receiver.operand) }
                    _ => { return false }
                }
                val table: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
                val indices: Array[LLVMValueRef] = [LLVMConstInt(self.i64ty, slot + 1U64, 0I32)]
                val entry: LLVMValueRef = LLVMBuildGEP2(self.b, self.ptrty, table, arrayCPtr(indices), 1U64, anon())
                val function: LLVMValueRef = llvmLoad(self.b, self.ptrty, entry, anon())
                mut val values: Array[LLVMValueRef] = [LLVMBuildExtractValue(self.b, fat, 0U64, anon())]
                mut val types: Array[LLVMTypeRef] = [self.ptrty]
                mut val index: U64 = 0U64
                while index < term.args.len {
                    val operandId: U64 = c.mid.callArguments[term.args.start + index]
                    val parameter: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: index)
                    mut val parameterType: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: parameter)
                    mut val value: LLVMValueRef = LLVMConstNull(self.ptrty)
                    match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: index) {
                        CallArgumentPassing.Inout => {
                            parameterType = self.ptrty
                            val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
                            value = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[operand.place - 1U64], forWrite: true)
                        }
                        _ => {
                            value = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: operandId)
                            if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 {
                                val parameterTerm: TypeRef = c.arena.typeAt(index: parameter)
                                value = self.coerceInt(v: value, target: parameterType, unsigned: isUnsignedName(c: inout c, start: parameterTerm.nameStart, len: parameterTerm.nameLen))
                            }
                        }
                    }
                    values.append(value)
                    types.append(parameterType)
                    index += 1U64
                }
                self.midCanonicalEmitInoutChecks(c: inout c, body: body, term: term)
                mut val resultType: LLVMTypeRef = self.voidty
                if requirement.hasRet { resultType = self.llvmTypeOfRef(c: inout c, ref: selected.resultTypeRef) }
                val signature: LLVMTypeRef = LLVMFunctionType(resultType, arrayCPtr(types), types.count(), 0I32)
                val result: LLVMValueRef = self.callValueFunction(signature: signature, function: function, arguments: values)
                if requirement.hasRet { llvmStore(self.b, result, self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[term.destination - 1U64], forWrite: true)) }
                return true
            }
            _ => { return false }
        }
    }

    // Cell control borrows an existing owner and returns a fresh owner (or
    // Bool). The input and output cell kinds are distinct ABI contracts.
    inout fn midCanonicalCellControlPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Target /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        mut val strongInput: Bool = false
        mut val weakResult: Bool = false
        mut val aliveResult: Bool = false
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.StrongCellWeak => { strongInput = true weakResult = true }
                    RuntimeIntrinsic.StrongCellCopy => { strongInput = true }
                    RuntimeIntrinsic.WeakCellAlive => { aliveResult = true }
                    RuntimeIntrinsic.WeakCellLock => {}
                    _ => { return <MidCallPreflight.Target /> }
                }
            }
            _ => { return <MidCallPreflight.Target /> }
        }
        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.functionAt(index: selected.callee)
        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !callee.hasRet || callee.isAsync { return <MidCallPreflight.RuntimeAbi /> }
        if term.args.len != 1U64 || selected.parameterTypeRefs.len != 1U64 || selected.argumentPassings.len != 1U64 { return <MidCallPreflight.ArgumentShape /> }
        if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.Receiver /> }
        match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: 0U64) { CallArgumentPassing.Borrow => {} _ => { return <MidCallPreflight.Argument /> } }
        val argument: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)
        if !self.midCanonicalReadOperandSupported(c: inout c, body: body, operandId: argument) { return <MidCallPreflight.Argument /> }
        val source: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: 0U64)
        if strongInput {
            if !c.isStrongRefCellInst(ref: source) { return <MidCallPreflight.RuntimeAbi /> }
        } else {
            if !c.isWeakRefCellInst(ref: source) { return <MidCallPreflight.RuntimeAbi /> }
        }
        if !c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: argument), b: source) { return <MidCallPreflight.Argument /> }
        if selected.resultTypeRef == 0U64 || selected.resultTypeRef >= c.arena.typeCount() { return <MidCallPreflight.Result /> }
        if aliveResult {
            val resultType: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: selected.resultTypeRef)
            if LLVMGetTypeKind(resultType) != 8U32 || LLVMGetIntTypeWidth(resultType) != 1U32 { return <MidCallPreflight.Result /> }
        } else {
            if weakResult {
                if !c.isWeakRefCellInst(ref: selected.resultTypeRef) { return <MidCallPreflight.Result /> }
            } else {
                if !c.isStrongRefCellInst(ref: selected.resultTypeRef) { return <MidCallPreflight.Result /> }
            }
            if !c.typeRefEq(a: c.arena.typeAt(index: source).args[0U64], b: c.arena.typeAt(index: selected.resultTypeRef).args[0U64]) { return <MidCallPreflight.Result /> }
        }
        if term.destination == 0U64 || term.destination > c.mid.places.count() { return <MidCallPreflight.Result /> }
        val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
        if destination.rootTag != 1U64 || destination.projections.len != 0U64 || !c.typeRefEq(a: destination.typeTerm, b: selected.resultTypeRef) { return <MidCallPreflight.Result /> }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitCellControl(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalCellControlPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        val cell: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64))
        mut val result: LLVMValueRef = LLVMConstNull(self.ptrty)
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match intrinsic {
                    RuntimeIntrinsic.StrongCellWeak => { result = self.refWeakDowngrade(c: inout c, cell: cell) }
                    RuntimeIntrinsic.StrongCellCopy => { result = self.refUpgrade(c: inout c, cell: cell) }
                    RuntimeIntrinsic.WeakCellAlive => { result = LLVMBuildICmp(self.b, llvmIntNe(), self.refStrongCount(c: inout c, cell: cell), LLVMConstInt(self.i64ty, 0U64, 0I32), anon()) }
                    RuntimeIntrinsic.WeakCellLock => { result = self.refUpgrade(c: inout c, cell: cell) }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
        llvmStore(self.b, result, self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
        return true
    }

    inout fn midCanonicalStrongCellPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return <MidCallPreflight.Resolution /> }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCallPreflight.Resolution /> }
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCallPreflight.Target /> }
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        match selected.target {
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => { match intrinsic { RuntimeIntrinsic.StrongCellNew => {} _ => { return <MidCallPreflight.Target /> } } }
            _ => { return <MidCallPreflight.Target /> }
        }
        if selected.callee >= c.arena.functionCount() { return <MidCallPreflight.Callee /> }
        val callee: Func = c.arena.functionAt(index: selected.callee)
        if !callee.isExtern || callee.isCExtern || callee.hasRecv || !callee.hasRet || term.args.len != 1U64 || term.destination == 0U64 || term.destination > c.mid.places.count() { return <MidCallPreflight.RuntimeAbi /> }
        if !self.midCanonicalReceiverSupported(c: inout c, body: body, receiverId: term.callReceiver, passing: <CallReceiverPassing.None />) { return <MidCallPreflight.Receiver /> }
        if !c.isStrongRefCellInst(ref: selected.resultTypeRef) { return <MidCallPreflight.RuntimeAbi /> }
        val result: TypeRef = c.arena.typeAt(index: selected.resultTypeRef)
        if result.args.count() != 1U64 { return <MidCallPreflight.RuntimeAbi /> }
        val argument: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)
        if argument == 0U64 || argument > c.mid.operands.count() { return <MidCallPreflight.Argument /> }
        val operand: MidOperandNode = c.mid.operands[argument - 1U64]
        // The selected move ABI transfers ownership into the cell.
        if selected.argumentPassings.len != 1U64 || selected.parameterTypeRefs.len != 1U64 { return <MidCallPreflight.ArgumentShape /> }
        match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: 0U64) { CallArgumentPassing.Move => {} _ => { return <MidCallPreflight.Argument /> } }
        if operand.tag != 2U64 { return <MidCallPreflight.Argument /> }
        if !c.typeRefEq(a: self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: argument), b: result.args[0U64]) || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: operand.place) { return <MidCallPreflight.Argument /> }
        val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
        if destination.rootTag != 1U64 || destination.projections.len != 0U64 || !c.typeRefEq(a: destination.typeTerm, b: selected.resultTypeRef) { return <MidCallPreflight.Result /> }
        return <MidCallPreflight.None />
    }

    inout fn midCanonicalEmitStrongCell(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalStrongCellPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val argument: U64 = self.midCanonicalCallArgumentAt(c: c, term: term, index: 0U64)
        val value: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: argument)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(LLVMTypeOf(value)), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        llvmStore(self.b, value, cell)
        llvmStore(self.b, cell, self.midCanonicalLocalPtr(body: body, local: c.mid.places[term.destination - 1U64].local))
        return true
    }

    inout fn midCanonicalCallPreflight(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> MidCallPreflight {
        val cellControl: MidCallPreflight = self.midCanonicalCellControlPreflight(c: inout c, body: body, terminatorId: terminatorId)
        match cellControl { MidCallPreflight.Target => {} _ => { return cellControl } }
        val strongCell: MidCallPreflight = self.midCanonicalStrongCellPreflight(c: inout c, body: body, terminatorId: terminatorId)
        match strongCell { MidCallPreflight.Target => {} _ => { return strongCell } }
        val closure: MidCallPreflight = self.midCanonicalClosureCallPreflight(c: inout c, body: body, terminatorId: terminatorId)
        match closure { MidCallPreflight.Target => {} _ => { return closure } }
        val existential: MidCallPreflight = self.midCanonicalExistentialCallPreflight(c: inout c, body: body, terminatorId: terminatorId)
        match existential { MidCallPreflight.Target => {} _ => { return existential } }
        val direct: MidCallPreflight = self.midCanonicalDirectCallPreflight(c: inout c, body: body, terminatorId: terminatorId)
        match direct {
            MidCallPreflight.Target => {
                val processIo: MidCallPreflight = self.midCanonicalRuntimeSystemPreflight(c: inout c, body: body, terminatorId: terminatorId)
                match processIo {
                    MidCallPreflight.Target => {
                        val coreStringFfi: MidCallPreflight = self.midCanonicalRuntimeCoreStringFfiPreflight(c: inout c, body: body, terminatorId: terminatorId)
                        match coreStringFfi {
                            MidCallPreflight.Target => {
                                val numeric: MidCallPreflight = self.midCanonicalRuntimeNumericPreflight(c: inout c, body: body, terminatorId: terminatorId)
                                match numeric { MidCallPreflight.Target => { return self.midCanonicalRuntimeBufferPreflight(c: inout c, body: body, terminatorId: terminatorId) } _ => { return numeric } }
                            }
                            _ => { return coreStringFfi }
                        }
                    }
                    _ => { return processIo }
                }
            }
            _ => { return direct }
        }
    }

    inout fn midCanonicalEmitCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalCellControlPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => { return self.midCanonicalEmitCellControl(c: inout c, body: body, terminatorId: terminatorId) } MidCallPreflight.Target => {} _ => { return false } }
        match self.midCanonicalStrongCellPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => { return self.midCanonicalEmitStrongCell(c: inout c, body: body, terminatorId: terminatorId) } MidCallPreflight.Target => {} _ => { return false } }
        match self.midCanonicalClosureCallPreflight(c: inout c, body: body, terminatorId: terminatorId) {
            MidCallPreflight.None => { return self.midCanonicalEmitClosureCall(c: inout c, body: body, terminatorId: terminatorId) }
            MidCallPreflight.Target => {}
            _ => { return false }
        }
        match self.midCanonicalExistentialCallPreflight(c: inout c, body: body, terminatorId: terminatorId) {
            MidCallPreflight.None => { return self.midCanonicalEmitExistentialCall(c: inout c, body: body, terminatorId: terminatorId) }
            MidCallPreflight.Target => {}
            _ => { return false }
        }
        match self.midCanonicalDirectCallPreflight(c: inout c, body: body, terminatorId: terminatorId) {
            MidCallPreflight.None => { return self.midCanonicalEmitDirectCall(c: inout c, body: body, terminatorId: terminatorId) }
            MidCallPreflight.Target => {
                match self.midCanonicalRuntimeSystemPreflight(c: inout c, body: body, terminatorId: terminatorId) {
                    MidCallPreflight.None => { return self.midCanonicalEmitRuntimeSystemCall(c: inout c, body: body, terminatorId: terminatorId) }
                    MidCallPreflight.Target => {
                        match self.midCanonicalRuntimeCoreStringFfiPreflight(c: inout c, body: body, terminatorId: terminatorId) {
                            MidCallPreflight.None => { return self.midCanonicalEmitRuntimeCoreStringFfiCall(c: inout c, body: body, terminatorId: terminatorId) }
                            MidCallPreflight.Target => {
                                match self.midCanonicalRuntimeNumericPreflight(c: inout c, body: body, terminatorId: terminatorId) {
                                    MidCallPreflight.None => { return self.midCanonicalEmitRuntimeNumericCall(c: inout c, body: body, terminatorId: terminatorId) }
                                    MidCallPreflight.Target => { return self.midCanonicalEmitRuntimeBufferCall(c: inout c, body: body, terminatorId: terminatorId) }
                                    _ => { return false }
                                }
                            }
                            _ => { return false }
                        }
                    }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn midCanonicalEmitDirectCall(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> Bool {
        match self.midCanonicalDirectCallPreflight(c: inout c, body: body, terminatorId: terminatorId) { MidCallPreflight.None => {} _ => { return false } }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        val selected: CallResolution = c.arena.finalCallees[target.resolution]
        val callee: Func = c.arena.functionAt(index: selected.callee)
        mut val externalSlot: U64 = self.declId.count()
        if callee.isExtern { externalSlot = self.declareResolvedCFunction(c: inout c, selected: selected) }
        mut val methodSlot: U64 = self.genMethBody.count()
        mut val freeSlot: U64 = self.genFnK.count()
        mut val useMethod: Bool = false
        if !callee.isExtern && !callee.isAsync {
            if callee.hasRecv {
                methodSlot = self.ensureFinalGenMethodBody(c: inout c, bodyId: selected.calleeBodyId)
                if methodSlot >= self.genMethBody.count() { return false }
                useMethod = true
            } else {
                freeSlot = self.ensureFinalGenFnBody(c: inout c, bodyId: selected.calleeBodyId)
                if freeSlot >= self.genFnK.count() { return false }
            }
        }
        mut val values: Array[LLVMValueRef] = []
        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if receiver.tag == 2U64 {
            val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
            match selected.receiverPassing {
                CallReceiverPassing.Inout => { values.append(self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[operand.place - 1U64], forWrite: true)) }
                CallReceiverPassing.Borrow => { values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: receiver.operand)) }
                CallReceiverPassing.Move => { values.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: receiver.operand)) }
                _ => { return false }
            }
        } else {
            match selected.receiverPassing {
                CallReceiverPassing.None => {}
                _ => { return false }
            }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            val operandId: U64 = c.mid.callArguments[term.args.start + argumentI]
            val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
            val parameterRef: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: argumentI)
            mut val value: LLVMValueRef = LLVMConstNull(self.ptrty)
            match c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: argumentI) {
                CallArgumentPassing.Inout => { value = self.midCanonicalPlacePtr(c: inout c, body: body, place: c.mid.places[operand.place - 1U64], forWrite: true) }
                _ => {
                    value = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: operandId)
                    if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 {
                        val parameter: TypeRef = c.arena.typeAt(index: parameterRef)
                        value = self.coerceInt(v: value, target: self.llvmTypeOfRef(c: inout c, ref: parameterRef), unsigned: isUnsignedName(c: inout c, start: parameter.nameStart, len: parameter.nameLen))
                    }
                }
            }
            values.append(value)
            argumentI = argumentI + 1U64
        }
        self.midCanonicalEmitInoutChecks(c: inout c, body: body, term: term)
        mut val result: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        if callee.isAsync {
            val slot: U64 = self.asyncEntrySlot(fi: selected.callee)
            result = self.callValueFunction(signature: self.asyncEntryTy[slot], function: self.asyncEntryVal[slot], arguments: values)
        } else if callee.isExtern { result = LLVMBuildCall2(self.b, self.declTy[externalSlot], self.declFn[externalSlot], arrayCPtr(values), values.count(), anon()) }
        else if useMethod { result = self.callValueFunction(signature: self.genMethTy[methodSlot], function: self.genMethVal[methodSlot], arguments: values) }
        else { result = self.callValueFunction(signature: self.genFnTy[freeSlot], function: self.genFnVal[freeSlot], arguments: values) }
        if callee.hasRet || callee.isAsync {
            val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
            llvmStore(self.b, self.midProjectCallResult(selected: selected, value: result), self.midCanonicalPlacePtr(c: inout c, body: body, place: destination, forWrite: true))
        }
        return true
    }

    inout fn midCanonicalEmitDrop(c: inout Comp, body: MidBodyNode, placeId: U64) -> Bool {
        if placeId == 0U64 || placeId > c.mid.places.count() { return false }
        val place: MidPlaceNode = c.mid.places[placeId - 1U64]
        if place.rootTag == 1U64 {
            if place.local >= body.locals.len || c.mid.locals[body.locals.start + place.local].isBorrowed { return false }
        } else if place.rootTag == 2U64 {
            if !place.globalMutable || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: placeId) { return false }
        } else { return false }
        mut val projectionI: U64 = 0U64
        while projectionI < place.projections.len {
            val tag: U64 = c.mid.projections[place.projections.start + projectionI].tag
            if tag != 1U64 && tag != 3U64 { return false }
            projectionI = projectionI + 1U64
        }
        val value: LLVMValueRef = llvmLoad(self.b, self.midCanonicalPlaceTy(c: inout c, body: body, place: place), self.midCanonicalPlacePtr(c: inout c, body: body, place: place, forWrite: true), anon())
        self.valueArc(c: inout c, v: value, typeRef: place.typeTerm, retain: false)
        return true
    }

    inout fn midCanonicalEmitConditionalDrop(c: inout Comp, body: MidBodyNode, placeId: U64, flag: U64) -> Bool {
        if flag >= body.locals.len { return false }
        val flagValue: LLVMValueRef = llvmLoad(self.b, self.i1ty, self.midCanonicalLocalPtr(body: body, local: flag), anon())
        val thenBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.drop"))
        val continueBlock: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.drop.cont"))
        LLVMBuildCondBr(self.b, flagValue, thenBlock, continueBlock)
        LLVMPositionBuilderAtEnd(self.b, thenBlock)
        if !self.midCanonicalEmitDrop(c: inout c, body: body, placeId: placeId) { return false }
        LLVMBuildBr(self.b, continueBlock)
        LLVMPositionBuilderAtEnd(self.b, continueBlock)
        return true
    }

    inout fn midCanonicalEmitAggregateElement(c: inout Comp, body: MidBodyNode, element: MidAggregateElementNode) -> LLVMValueRef {
        // Non-identity conversions have their own canonical conversion slice;
        // never repackage this operand into MidOperand merely to reuse draft
        // lowering.  The direct aggregate path admits the identity boundary
        // first and remains fail-closed for the rest.
        if !c.conversionProofIsIdentity(id: element.conversion) {
            return self.midCanonicalEmitValueConversion(c: inout c, body: body, operandId: element.operand, proofId: element.conversion)
        }
        val value: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: element.operand)
        if element.operand != 0U64 && element.operand <= c.mid.operands.count() {
            val operand: MidOperandNode = c.mid.operands[element.operand - 1U64]
            if operand.tag != 1U64 && operand.tag != 2U64 && element.targetTerm != 0U64 && element.targetTerm < c.arena.typeCount() && c.finalNeedsRelease(typeRef: element.targetTerm) {
                self.valueArc(c: inout c, v: value, typeRef: element.targetTerm, retain: true)
            }
        }
        return value
    }

    inout fn midCanonicalEmitAggregate(c: inout Comp, body: MidBodyNode, destination: MidPlaceNode, value: MidRvalueNode) -> LLVMValueRef {
        if value.tag == 3U64 {
            val ty: LLVMTypeRef = self.midCanonicalPlaceTy(c: inout c, body: body, place: destination)
            mut val aggregate: LLVMValueRef = LLVMGetUndef(ty)
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
                mut val child: LLVMValueRef = self.midCanonicalEmitAggregateElement(c: inout c, body: body, element: element)
                if element.isBoxed { child = self.midEmitAggregateBox(c: inout c, value: child) }
                val fieldTy: LLVMTypeRef = LLVMStructGetTypeAtIndex(ty, truncU32(n: element.fieldIndex))
                if LLVMGetTypeKind(LLVMTypeOf(child)) == 8U32 { child = self.coerceInt(v: child, target: fieldTy, unsigned: false) }
                aggregate = LLVMBuildInsertValue(self.b, aggregate, child, element.fieldIndex, anon())
                elementI = elementI + 1U64
            }
            return aggregate
        }
        if value.tag == 5U64 {
            if value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() { return LLVMConstNull(self.ptrty) }
            val result: TypeRef = c.arena.typeAt(index: value.resultTerm)
            if result.args.count() != 1U64 { return LLVMConstNull(self.ptrty) }
            val elementRef: U64 = result.args[0U64]
            val elementTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elementRef)
            mut val elements: Array[LLVMValueRef] = []
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                elements.append(self.midCanonicalEmitAggregateElement(c: inout c, body: body, element: c.mid.aggregateElements[value.elements.start + elementI]))
                elementI = elementI + 1U64
            }
            return self.genLlvmArrayValues(c: inout c, values: elements, elemTy: elementTy, elemRef: elementRef)
        }
        if value.tag == 4U64 {
            if value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || value.enumIndex >= c.arena.enumCount() || value.variantIndex >= c.arena.enumAt(index: value.enumIndex).variants.count() { return LLVMConstNull(self.ptrty) }
            mut val elements: Array[LLVMValueRef] = []
            mut val elementI: U64 = 0U64
            while elementI < value.elements.len {
                val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
                mut val child: LLVMValueRef = self.midCanonicalEmitAggregateElement(c: inout c, body: body, element: element)
                if element.isBoxed { child = self.midEmitAggregateBox(c: inout c, value: child) }
                elements.append(child)
                elementI = elementI + 1U64
            }
            val built: LLVMValueRef = self.buildEnumFromValues(c: inout c, instanceRef: value.resultTerm, ety: self.midCanonicalPlaceTy(c: inout c, body: body, place: destination), vi: value.variantIndex, payloadVals: elements)
            return built
        }
        return LLVMConstNull(self.ptrty)
    }

    inout fn midCanonicalEmitEnumLayoutRvalue(c: inout Comp, body: MidBodyNode, value: MidRvalueNode) -> LLVMValueRef {
        if value.place == 0U64 || value.place > c.mid.places.count() { return LLVMConstNull(self.ptrty) }
        val place: MidPlaceNode = c.mid.places[value.place - 1U64]
        val enumTy: LLVMTypeRef = self.midCanonicalPlaceTy(c: inout c, body: body, place: place)
        val enumSlot: LLVMValueRef = self.midCanonicalPlacePtr(c: inout c, body: body, place: place)
        if value.tag == 11U64 || value.tag == 16U64 {
            val tagPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, enumTy, enumSlot, 0U64, anon())
            return llvmLoad(self.b, self.i64ty, tagPtr, anon())
        }
        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, instanceRef: place.typeTerm, vi: value.variantIndex)
        val payloadPtr: LLVMValueRef = self.enumMatchPayloadStorage(c: inout c, scrutTy: enumTy, scrutSlot: enumSlot, instanceRef: place.typeTerm)
        val payload: LLVMValueRef = llvmLoad(self.b, payloadTy, payloadPtr, anon())
        val field: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, value.fieldIndex, anon())
        if value.tag == 14U64 || value.tag == 15U64 { return llvmLoad(self.b, self.llvmTypeOfRef(c: inout c, ref: value.resultTerm), field, anon()) }
        return field
    }

    // `try`'s Err edge owns its payload at this point (the operand is Move),
    // so repacking it is a pure aggregate construction.  The Result enum and
    // its concrete Err slot have already been frozen by FinalTryResolution;
    // LLVM receives no source-level type or trait lookup responsibility.
    inout fn midCanonicalEmitTryErrResult(c: inout Comp, body: MidBodyNode, destination: MidPlaceNode, value: MidRvalueNode) -> LLVMValueRef {
        if value.operand == 0U64 || value.resultTerm == 0U64 || value.resultTerm >= c.arena.typeCount() || value.enumIndex >= c.arena.enumCount() || value.variantIndex >= c.arena.enumAt(index: value.enumIndex).variants.count() { return LLVMConstNull(self.ptrty) }
        mut val payloads: Array[LLVMValueRef] = []
        payloads.append(self.midCanonicalEmitOperand(c: inout c, body: body, operandId: value.operand))
        val built: LLVMValueRef = self.buildEnumFromValues(c: inout c, instanceRef: value.resultTerm, ety: self.midCanonicalPlaceTy(c: inout c, body: body, place: destination), vi: value.variantIndex, payloadVals: payloads)
        return built
    }

    // The first direct statement slice deliberately covers the scalar rows
    // whose semantics are independent of aggregate/call lowering.  Other
    // canonical tags remain fail-closed until their direct emitters exist.
    // A cell owner becomes a logical value owner. Shared cells keep their
    // payload and provide an independent ARC owner; the last cell owner moves
    // its payload out and frees only the empty physical allocation.
    inout fn midTakeEnumCell(c: inout Comp, cell: LLVMValueRef, typeRef: U64) -> LLVMValueRef {
        val value = llvmLoad(self.b, self.llvmTypeOfRef(c: inout c, ref: typeRef), cell, anon())
        val count = self.rawbufRelease(c: inout c, cell: cell)
        val last = LLVMBuildICmp(self.b, llvmIntEq(), count, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val release = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumtake.free"))
        val shared = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumtake.shared"))
        val continuation = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "enumtake.cont"))
        LLVMBuildCondBr(self.b, last, release, shared)
        LLVMPositionBuilderAtEnd(self.b, release)
        self.rawbufFree(c: inout c, cell: cell)
        LLVMBuildBr(self.b, continuation)
        LLVMPositionBuilderAtEnd(self.b, shared)
        if c.finalNeedsRelease(typeRef: typeRef) { self.valueArc(c: inout c, v: value, typeRef: typeRef, retain: true) }
        LLVMBuildBr(self.b, continuation)
        LLVMPositionBuilderAtEnd(self.b, continuation)
        return value
    }

    inout fn midCanonicalEmitEnumDestructure(c: inout Comp, body: MidBodyNode, statement: MidStatementNode) -> Bool {
        val source = c.mid.places[statement.source - 1U64]
        val enumTy = self.midCanonicalPlaceTy(c: inout c, body: body, place: source)
        val slot = self.midCanonicalPlacePtr(c: inout c, body: body, place: source)
        val payloadTy = self.variantPayloadTy(c: inout c, instanceRef: source.typeTerm, vi: statement.variantIndex)
        val payloadSlot = self.enumMatchPayloadStorage(c: inout c, scrutTy: enumTy, scrutSlot: slot, instanceRef: source.typeTerm)
        val payload = llvmLoad(self.b, payloadTy, payloadSlot, anon())
        mut val index: U64 = 0U64
        while index < statement.enumDestinations.len {
            val entry = c.mid.enumDestinations[statement.enumDestinations.start + index]
            val destination = c.mid.places[entry.place - 1U64]
            mut val value = LLVMBuildExtractValue(self.b, payload, index, anon())
            if entry.isBoxed { value = self.midTakeEnumCell(c: inout c, cell: value, typeRef: destination.typeTerm) }
            llvmStore(self.b, value, self.midCanonicalPlacePtr(c: inout c, body: body, place: destination))
            index += 1U64
        }
        return true
    }

    inout fn midCanonicalEmitStatement(c: inout Comp, body: MidBodyNode, statementId: U64) -> Bool {
        if statementId == 0U64 || statementId > c.mid.statements.count() { return false }
        val statement: MidStatementNode = c.mid.statements[statementId - 1U64]
        if statement.tag == 13U64 { return self.midCanonicalEmitEnumDestructure(c: inout c, body: body, statement: statement) }
        if statement.tag == 1U64 || statement.tag == 9U64 {
            if statement.destination == 0U64 || statement.destination > c.mid.places.count() || statement.value == 0U64 || statement.value > c.mid.rvalues.count() { return false }
            val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
            val rvalue: MidRvalueNode = c.mid.rvalues[statement.value - 1U64]
            if rvalue.tag != 1U64 && rvalue.tag != 2U64 && rvalue.tag != 3U64 && rvalue.tag != 4U64 && rvalue.tag != 5U64 && rvalue.tag != 6U64 && rvalue.tag != 8U64 && rvalue.tag != 9U64 && rvalue.tag != 10U64 && rvalue.tag != 11U64 && rvalue.tag != 12U64 && rvalue.tag != 13U64 && rvalue.tag != 14U64 && rvalue.tag != 15U64 && rvalue.tag != 16U64 && rvalue.tag != 17U64 && rvalue.tag != 18U64 && rvalue.tag != 19U64 { return false }
            mut val value: LLVMValueRef = LLVMConstNull(self.ptrty)
            if rvalue.tag == 19U64 { value = self.midCanonicalEmitMakeClosure(c: inout c, body: body, value: rvalue) }
            else if rvalue.tag == 6U64 { value = self.midCanonicalEmitValueConversion(c: inout c, body: body, operandId: rvalue.operand, proofId: rvalue.conversion) }
            else if rvalue.tag != 11U64 && rvalue.tag != 12U64 && rvalue.tag != 13U64 && rvalue.tag != 14U64 && rvalue.tag != 15U64 && rvalue.tag != 16U64 && rvalue.tag != 17U64 && rvalue.tag != 18U64 { value = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: rvalue.operand) }
            if rvalue.tag == 3U64 || rvalue.tag == 4U64 || rvalue.tag == 5U64 { value = self.midCanonicalEmitAggregate(c: inout c, body: body, destination: destination, value: rvalue) }
            if rvalue.tag >= 11U64 && rvalue.tag <= 17U64 { value = self.midCanonicalEmitEnumLayoutRvalue(c: inout c, body: body, value: rvalue) }
            if (rvalue.tag == 12U64 || rvalue.tag == 14U64 || rvalue.tag == 17U64) && c.finalNeedsRelease(typeRef: rvalue.resultTerm) { self.valueArc(c: inout c, v: value, typeRef: rvalue.resultTerm, retain: true) }
            if rvalue.tag == 18U64 { value = self.midCanonicalEmitTryErrResult(c: inout c, body: body, destination: destination, value: rvalue) }
            if rvalue.tag == 8U64 { value = self.coerceInt(v: value, target: self.llvmTypeOfRef(c: inout c, ref: rvalue.targetTerm), unsigned: rvalue.kindTag != 1U64) }
            if rvalue.tag == 9U64 {
                if rvalue.kindTag == 1U64 { value = LLVMBuildSIToFP(self.b, value, self.llvmTypeOfRef(c: inout c, ref: rvalue.targetTerm), anon()) }
                else { value = LLVMBuildUIToFP(self.b, value, self.llvmTypeOfRef(c: inout c, ref: rvalue.targetTerm), anon()) }
            }
            val targetTy: LLVMTypeRef = self.midCanonicalPlaceTy(c: inout c, body: body, place: destination)
            if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 { value = self.coerceInt(v: value, target: targetTy, unsigned: false) }
            if statement.tag == 9U64 {
                if destination.rootTag != 1U64 || destination.projections.len != 0U64 || destination.local >= body.locals.len || !c.mid.locals[body.locals.start + destination.local].isCaptureCell { return false }
                val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(targetTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
                llvmStore(self.b, cell, self.midCanonicalLocalPtr(body: body, local: destination.local))
                llvmStore(self.b, value, cell)
            } else {
                llvmStore(self.b, value, self.midCanonicalPlacePtr(c: inout c, body: body, place: destination, forWrite: true))
            }
            return true
        }
        if statement.tag == 2U64 || statement.tag == 8U64 {
            if statement.destination == 0U64 || statement.destination > c.mid.places.count() || statement.source == 0U64 || statement.source > c.mid.places.count() { return false }
            val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
            val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
            llvmStore(self.b, self.midCanonicalReadPlace(c: inout c, body: body, place: source), self.midCanonicalPlacePtr(c: inout c, body: body, place: destination, forWrite: true))
            return true
        }
        if statement.tag == 3U64 { return self.midCanonicalEmitDrop(c: inout c, body: body, placeId: statement.destination) }
        if statement.tag == 10U64 {
            if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return false }
            val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
            if place.rootTag != 1U64 || place.projections.len != 0U64 || place.local >= body.locals.len || !c.mid.locals[body.locals.start + place.local].isCaptureCell { return false }
            self.emitCellRelease(c: inout c, cell: llvmLoad(self.b, self.ptrty, self.midCanonicalLocalPtr(body: body, local: place.local), anon()), ref: place.typeTerm)
            return true
        }
        if statement.tag == 4U64 { return self.midCanonicalEmitConditionalDrop(c: inout c, body: body, placeId: statement.destination, flag: statement.flag) }
        if statement.tag == 5U64 {
            if statement.flag >= body.locals.len { return false }
            mut val bit: U64 = 0U64
            if statement.isSet { bit = 1U64 }
            llvmStore(self.b, LLVMConstInt(self.i1ty, bit, 0I32), self.midCanonicalLocalPtr(body: body, local: statement.flag))
            return true
        }
        if statement.tag == 7U64 { return true }
        return false
    }

    // Emit the non-call portion of the canonical CFG.  `blocks` is transient
    // LLVM construction state, not an IR carrier: all semantic edges are read
    // exclusively from the canonical terminator row and its case range.
    inout fn midCanonicalEmitNonCallTerminator(c: inout Comp, body: MidBodyNode, terminatorId: U64, blocks: Array[LLVMBasicBlockRef], asyncBody: Bool = false) -> Bool {
        if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return false }
        val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
        if term.tag == 2U64 {
            if term.target >= blocks.count() { return false }
            LLVMBuildBr(self.b, blocks[term.target])
            return true
        }
        if term.tag == 3U64 {
            if term.otherwise >= blocks.count() { return false }
            val discriminant: LLVMValueRef = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.discriminant)
            if term.cases.len == 1U64 && c.mid.switchCases[term.cases.start].value == 1I64 && LLVMGetIntTypeWidth(LLVMTypeOf(discriminant)) == 1U32 {
                val target: U64 = c.mid.switchCases[term.cases.start].target
                if target >= blocks.count() { return false }
                LLVMBuildCondBr(self.b, discriminant, blocks[target], blocks[term.otherwise])
                return true
            }
            val switch: LLVMValueRef = LLVMBuildSwitch(self.b, discriminant, blocks[term.otherwise], truncU32(n: term.cases.len))
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                val item: MidSwitchCase = c.mid.switchCases[term.cases.start + caseI]
                if item.target >= blocks.count() { return false }
                LLVMAddCase(switch, LLVMConstInt(self.i64ty, bitCastU64(n: item.value), 1I32), blocks[item.target])
                caseI = caseI + 1U64
            }
            return true
        }
        if term.tag == 5U64 && asyncBody {
            self.midAsyncComplete(c: inout c, value: LLVMConstInt(self.i64ty, 0U64, 0I32))
            return true
        }
        if term.tag == 5U64 {
            if self.curIsMain { LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32)) }
            else if self.curRetVoid { LLVMBuildRetVoid(self.b) }
            else { LLVMBuildUnreachable(self.b) }
            return true
        }
        if term.tag == 6U64 && asyncBody {
            val result = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value)
            self.midAsyncComplete(c: inout c, value: self.extendToI64(v: result, unsigned: false))
            return true
        }
        if term.tag == 6U64 {
            if self.curIsMain || self.curRetVoid { return false }
            LLVMBuildRet(self.b, self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value))
            return true
        }
        if term.tag == 7U64 {
            self.emitStrSinkValue(c: inout c, rtName: "plew_panic_raw", value: self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value))
            LLVMBuildUnreachable(self.b)
            return true
        }
        if term.tag == 8U64 || term.tag == 9U64 {
            LLVMBuildUnreachable(self.b)
            return true
        }
        if term.tag == 10U64 {
            if !asyncBody || term.resume >= blocks.count() { return false }
            return self.midAsyncSuspend(c: inout c, body: body, term: term, target: blocks[term.resume])
        }
        return false
    }

    inout fn midPrepareCanonicalLocals(c: inout Comp, body: MidBodyNode, abiParameterStart: U64 = 0U64, abiParameterValues: Array[LLVMValueRef] = [], storage: Array[LLVMValueRef] = [], initializeParameters: Bool = true) -> Bool {
        if storage.count() != 0U64 && storage.count() != body.locals.len { return false }
        self.nLocals = 0U64
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        mut val local: U64 = 0U64
        while local < body.locals.len {
            val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
            val ty: LLVMTypeRef = self.midCanonicalLocalTy(c: inout c, body: body, local: local)
            mut val slot: LLVMValueRef = LLVMConstNull(self.ptrty)
            if storage.count() != 0U64 { slot = storage[local] }
            else if declaration.isCaptureCell { slot = self.entryAlloca(ty: self.ptrty) }
            else { slot = self.entryAlloca(ty: ty) }
            if declaration.isParameter && initializeParameters {
                val abiIndex: U64 = abiParameterStart + local
                val value = if abiParameterValues.count() != 0U64 { give abiParameterValues[local] } else { give self.valueParameter(function: self.curFn, index: abiIndex) }
                if declaration.isInout { slot = value }
                else { llvmStore(self.b, value, slot) }
            }
            self.pushLocalR(nameStart: declaration.sourceNameStart, nameLen: 0U64, ptr: slot, ty: ty, kind: 0U64, structIdx: c.arena.structCount(), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: declaration.typeTerm)
            self.setLocalOwned(owned: declaration.ownsAtEntry)
            local = local + 1U64
        }
        return true
    }

    // Canonical Mid is the production-shaped LLVM input: its verification,
    // local layout, statement rows and terminator rows all stay in the arena.
    // This initial preflight admits the closed direct-call subset only; runtime
    // intrinsic targets remain fail-closed until their own direct reader is
    // implemented rather than borrowing the draft call path.
}

// Admission callers first verify the frozen Mid body. Only successful LLVM
// capability checks allow publication of the backend-local Ready value.
impl LlvmCtx {
    inout fn midVerifiedLlvmPreflight(c: inout Comp, canonical: MidCanonicalBody, abiParameterCount: U64 = 0U64, asyncBody: Bool = false) -> MidLlvmPreflight {
        if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidLlvmPreflight.Terminator /> }
        val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
        if body.entry >= body.blocks.len { return <MidLlvmPreflight.Terminator /> }
        mut val parameter: U64 = 0U64
        mut val local: U64 = 0U64
        while local < body.locals.len {
            val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
            if declaration.isParameter {
                if local != parameter || parameter >= abiParameterCount { return <MidLlvmPreflight.AbiLocals /> }
                parameter = parameter + 1U64
            } else if parameter < abiParameterCount { return <MidLlvmPreflight.AbiLocals /> }
            local = local + 1U64
        }
        if parameter != abiParameterCount { return <MidLlvmPreflight.AbiLocals /> }
        mut val blockI: U64 = 0U64
        while blockI < body.blocks.len {
            val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
            mut val statementI: U64 = 0U64
            while statementI < block.statements.len {
                val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                if statement.tag == 1U64 || statement.tag == 9U64 {
                    if statement.destination == 0U64 || statement.destination > c.mid.places.count() || !self.midCanonicalInitialRvalueSupported(c: inout c, body: body, rvalueId: statement.value) {
                        if c.traceCodegen && statement.value != 0U64 && statement.value <= c.mid.rvalues.count() {
                            val rejected = c.mid.rvalues[statement.value - 1U64]
                            eprint(text: "[trace-codegen] Mid rvalue-reject fn=")
                            eprintU64(n: body.sourceFunction)
                            eprint(text: " tag=")
                            eprintU64(n: rejected.tag)
                            eprint(text: " result=")
                            eprintU64(n: rejected.resultTerm)
                            mut val element: U64 = 0U64
                            while rejected.tag >= 3U64 && rejected.tag <= 5U64 && element < rejected.elements.len {
                                val entry = c.mid.aggregateElements[rejected.elements.start + element]
                                eprint(text: " element-target=")
                                eprintU64(n: entry.targetTerm)
                                eprint(text: ":")
                                c.traceMonoTypeHead(ref: entry.targetTerm)
                                eprint(text: " operand-type=")
                                val operandType: U64 = self.midCanonicalOperandTypeTerm(c: c, body: body, operandId: entry.operand)
                                eprintU64(n: operandType)
                                eprint(text: ":")
                                c.traceMonoTypeHead(ref: operandType)
                                element += 1U64
                            }
                            eprint(text: "\n")
                        }
                        return <MidLlvmPreflight.UnsupportedRvalue />
                    }
                    if statement.tag == 9U64 {
                        val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                        if destination.rootTag != 1U64 || destination.projections.len != 0U64 || destination.local >= body.locals.len || !c.mid.locals[body.locals.start + destination.local].isCaptureCell { return <MidLlvmPreflight.AssignmentProjection /> }
                    }
                } else if statement.tag == 13U64 {
                    if statement.source == 0U64 || statement.source > c.mid.places.count() || !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: statement.source) || statement.enumIndex >= c.arena.enumCount() || statement.variantIndex >= c.arena.enumAt(index: statement.enumIndex).variants.count() { return <MidLlvmPreflight.UnsupportedRvalue /> }
                    val variant = c.arena.enumVariantAt(enumIndex: statement.enumIndex, variantIndex: statement.variantIndex)
                    if variant.fields.count() != statement.enumDestinations.len { return <MidLlvmPreflight.UnsupportedRvalue /> }
                    mut val index: U64 = 0U64
                    while index < statement.enumDestinations.len {
                        val destination = c.mid.enumDestinations[statement.enumDestinations.start + index]
                        if !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: destination.place) || destination.isBoxed != c.fieldIsBoxed(f: variant.fields[index]) { return <MidLlvmPreflight.UnsupportedRvalue /> }
                        index += 1U64
                    }
                } else if statement.tag == 2U64 || statement.tag == 8U64 {
                    if statement.destination == 0U64 || statement.destination > c.mid.places.count() || statement.source == 0U64 || statement.source > c.mid.places.count() { return <MidLlvmPreflight.AssignmentProjection /> }
                    if !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: statement.destination) { return <MidLlvmPreflight.AssignmentProjection /> }
                } else if statement.tag == 10U64 {
                    if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidLlvmPreflight.DropProjection /> }
                    val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                    if place.rootTag != 1U64 || place.projections.len != 0U64 || place.local >= body.locals.len || !c.mid.locals[body.locals.start + place.local].isCaptureCell { return <MidLlvmPreflight.DropProjection /> }
                } else if statement.tag == 3U64 || statement.tag == 4U64 {
                    if !self.midCanonicalPlaceLlvmSupported(c: inout c, body: body, placeId: statement.destination) { return <MidLlvmPreflight.DropProjection /> }
                } else if statement.tag == 5U64 || statement.tag == 7U64 {
                } else { return <MidLlvmPreflight.ScopeExit /> }
                statementI = statementI + 1U64
            }
            if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return <MidLlvmPreflight.Terminator /> }
            val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            if term.tag == 4U64 {
                val call: MidCallPreflight = self.midCanonicalCallPreflight(c: inout c, body: body, terminatorId: block.terminator)
                match call {
                    MidCallPreflight.None => {}
                    _ => {
                        if c.traceCodegen {
                            eprint(text: "[trace-codegen] Mid call-preflight-fallback block=")
                            self.traceCodegenU64(n: blockI)
                            eprint(text: " detail=")
                            self.traceCodegenU64(n: self.midCallPreflightCoverageDetail(reason: call))
                            if term.callTarget != 0U64 && term.callTarget <= c.mid.callTargets.count() {
                                val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
                                if target.tag == 2U64 && target.resolution < c.arena.finalCallees.count() {
                                    val selected: CallResolution = c.arena.finalCallees[target.resolution]
                                    eprint(text: " callee=")
                                    if selected.callee < c.arena.functionCount() { self.traceCodegenName(c: inout c, start: c.arena.functionAt(index: selected.callee).nameStart, len: c.arena.functionAt(index: selected.callee).nameLen) }
                                    else { eprint(text: "<invalid>") }
                                }
                            }
                            eprint(text: "\n")
                        }
                        return <MidLlvmPreflight.Call reason=call />
                    }
                }
            } else if term.tag == 2U64 || term.tag == 5U64 || term.tag == 8U64 || term.tag == 9U64 {
            } else if term.tag == 10U64 && asyncBody {
                if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: term.value) { return <MidLlvmPreflight.Terminator /> }
            } else if term.tag == 3U64 {
                if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: term.discriminant) { return <MidLlvmPreflight.Switch /> }
            } else if term.tag == 6U64 || term.tag == 7U64 {
                if !self.midCanonicalOperandLlvmSupported(c: inout c, body: body, operandId: term.value) { return <MidLlvmPreflight.Terminator /> }
            } else { return <MidLlvmPreflight.Terminator /> }
            blockI = blockI + 1U64
        }
        return <MidLlvmPreflight.Ready />
    }

    inout fn genLlvmPreparedMidBody(c: inout Comp, prepared: MidLlvmPrepared, abiParameterStart: U64 = 0U64, closureBodyId: U64 = 0U64, abiParameterValues: Array[LLVMValueRef] = [], localsPrepared: Bool = false, asyncBody: Bool = false) -> Bool {
        val canonical: MidCanonicalBody = match prepared {
            MidLlvmPrepared.None => { return false }
            MidLlvmPrepared.Ready(canonical: val canonical, abiParameterCount: val count) => {
                if abiParameterValues.count() != 0U64 && abiParameterValues.count() != count { return false }
                give canonical
            }
        }
        val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
        if !localsPrepared && !self.midPrepareCanonicalLocals(c: inout c, body: body, abiParameterStart: abiParameterStart, abiParameterValues: abiParameterValues) { return false }
        if closureBodyId != 0U64 && !self.bindMidClosureCaptures(c: inout c, body: body, bodyId: closureBodyId) { return false }
        mut val blocks: Array[LLVMBasicBlockRef] = []
        mut val blockI: U64 = 0U64
        while blockI < body.blocks.len {
            if blockI == body.entry { blocks.append(LLVMGetInsertBlock(self.b)) }
            else { blocks.append(LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid"))) }
            blockI = blockI + 1U64
        }
        blockI = 0U64
        while blockI < body.blocks.len {
            val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
            LLVMPositionBuilderAtEnd(self.b, blocks[blockI])
            mut val statementI: U64 = 0U64
            while statementI < block.statements.len {
                if !self.midCanonicalEmitStatement(c: inout c, body: body, statementId: block.statements.start + statementI + 1U64) { return false }
                statementI = statementI + 1U64
            }
            val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            if term.tag == 4U64 {
                if !self.midCanonicalEmitCall(c: inout c, body: body, terminatorId: block.terminator) || term.target >= blocks.count() { return false }
                LLVMBuildBr(self.b, blocks[term.target])
            } else if !self.midCanonicalEmitNonCallTerminator(c: inout c, body: body, terminatorId: block.terminator, blocks: blocks, asyncBody: asyncBody) { return false }
            blockI = blockI + 1U64
        }
        if c.emitMidCoverage {
            // Emission evidence belongs to the prepared-body consumer, not to
            // eligibility or fallback selection. LLVM-generated symbols are
            // C strings; retain their exact spelling for definition matching.
            val length: Array[U64] = [0U64]
            val symbol = stringFromCString(LLVMGetValueName2(self.curFn, arrayCPtr(length)))
            eprint(text: "mid-body symbol=")
            eprint(text: symbol)
            eprint(text: " canonical=")
            self.traceCodegenU64(n: canonical.body)
            eprint(text: "\n")
        }
        return true
    }
}

pub impl LlvmCtx {
    inout fn prepareSyntheticMidBody(c: inout Comp, bodyId: U64, fnIdx: U64, parameterCount: U64) -> MidLlvmPrepared {
        val built = buildMidBodyForInstance(c: inout c, fnIdx: fnIdx, bodyId: bodyId)
        match built.error {
            MidBuildError.None => {}
            _ => {
                self.recordMidBuildError(c: inout c, bodyId: bodyId, fnIdx: fnIdx, error: built.error)
                return <MidLlvmPrepared.None />
            }
        }
        val instantiated = instantiateCanonicalMidBody(c: inout c, body: built.canonical, bodyId: bodyId)
        match instantiated.error {
            MidInstantiateError.None => {}
            _ => {
                self.recordMidInstantiate(c: inout c, bodyId: bodyId, fnIdx: fnIdx, reason: instantiated.error)
                return <MidLlvmPrepared.None />
            }
        }
        val accesses = elaborateCanonicalMidAccesses(c: inout c, canonical: instantiated.body)
        match accesses.error {
            MidAccessError.None => {}
            _ => {
                self.recordMidAccess(c: inout c, bodyId: bodyId, fnIdx: fnIdx)
                return <MidLlvmPrepared.None />
            }
        }
        val dropped = elaborateCanonicalMidDrops(c: inout c, canonical: optimizeCanonicalMidReturns(arena: inout c.mid, canonical: accesses.body))
        val verification = verifyExecutableCanonicalMidBody(c: inout c, canonical: dropped)
        match verification.error {
            MidVerifyError.None => {}
            _ => {
                self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fnIdx, reason: verification.error)
                return <MidLlvmPrepared.None />
            }
        }
        val preflight = self.midVerifiedLlvmPreflight(c: inout c, canonical: dropped, abiParameterCount: parameterCount)
        match preflight {
            MidLlvmPreflight.Ready => {}
            _ => {
                self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fnIdx, reason: preflight)
                return <MidLlvmPrepared.None />
            }
        }
        return <MidLlvmPrepared.Ready canonical=dropped abiParameterCount=parameterCount />
    }

}
