                            if selected.parameterTypeRefs.count() != 1U64 || selected.resultTypeRef == 0U64 { return false }
                            val elemRef: U64 = self.midBufferElementRef(c: inout c, bufferRef: selectedParameterTypes[0U64])
                            if elemRef == 0U64 || !(c.typeRefEq(a: selected.resultTypeRef, b: elemRef)) { return false }
                            val elemTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: elemRef)
