// Part of the LLVM backend (root: _.pw): scalar / struct type mapping and struct registration.

// ---- type mapping ----
//
// Map a Plew scalar type name span to an LLVM integer type. v1 recognizes the
// fixed-width integer lang-items and Bool; everything else falls back to i64
// (the default scalar). Width/signedness refinement and
// non-scalar types (String/struct/array) come in later increments.

pub impl LlvmCtx {
    inout fn llvmScalarTy(c: inout Comp, tyStart: U64, tyLen: U64) -> LLVMTypeRef {
        // a `newtype` (spec/10) has its underlying type's representation: resolve the name
        // to the underlying before any further handling.
        val ntu: Bind = c.newtypeUnderName(start: tyStart, len: tyLen)
        if ntu.nameStart != tyStart || ntu.nameLen != tyLen {
            return self.llvmScalarTy(c: inout c, tyStart: ntu.nameStart, tyLen: ntu.nameLen)
        }
        // generic substitution: a type-parameter name (T) in scope resolves to its
        // concrete argument (the monomorphization env curTypeParams -> curTypeArgs,
        // set while emitting a generic instance). No-op outside a generic context.
        if c.cur.typeParams.count() > 0U64 {
            val qid: U64 = intern(c: inout c, start: tyStart, len: tyLen)
            // LAST-match (high -> low), consistent with resolveTy: when the env carries a
            // name collision (`Optional[Optional[I32]]` merges two `T` bindings, the inner
            // last), the innermost binding must win — lexical shadowing. First-match would
            // pick the enclosing `T` (outer = Optional[I32]) over this instance's (inner = I32).
            mut val ti: U64 = c.cur.typeParams.count()
            while ti > 0U64 {
                ti -= 1
                if c.cur.typeParams[ti].nameId == qid {
                    // a type param bound to a generic instance (`I -> MapIter[Counter,…]`)
                    // must resolve to that registered instance type — recursing on the
                    // bare name would drop the args and miss it.
                    val argRef: U64 = c.cur.typeArgs[ti]
                    if c.isGenericInst(ref: argRef) {
                        return self.llvmTypeOfRef(c: inout c, ref: argRef)
                    }
                    val at: TypeRef = c.arena.types[argRef]
                    // an array argument (`T -> Array[I32]`) is the {ptr,i64} value type.
                    if rangeEquals(bytes: c.arena.bytes, start: at.nameStart, len: at.nameLen, kw: "Array") {
                        return self.arrayTy
                    }
                    return self.llvmScalarTy(c: inout c, tyStart: at.nameStart, tyLen: at.nameLen)
                }
            }
        }
        // `String` is no longer name-dispatched here: it is a registered struct whose type is
        // pinned to `strty`, so it resolves via the registered-struct lookup below (returns the
        // same strty). The representation alias `strty` (= arrayTy) stays; only the type-name
        // branch is gone (collections.md §3-付録2).
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Bool") {
            return self.i1ty
        }
        // float types F32 / F64 lower to the IEEE double (F32 as double for now).
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "F64") {
            return self.f64ty
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "F32") {
            return self.f64ty
        }
        // a `Ref[T]` is a pointer to a heap cell holding the pointee (opaque ptr).
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Ref") {
            return self.ptrty
        }
        // a `WeakRef[T]` is the same cell pointer as its Ref (opaque ptr) — owns a weak count
        // rather than a strong one, but the value representation is identical.
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "WeakRef") {
            return self.ptrty
        }
        // a `Buffer[T]` is the raw data pointer (the storage floor; opaque ptr).
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Buffer") {
            return self.ptrty
        }
        // FFI raw pointers (`CPtr[T]`) are opaque pointers (spec/15).
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "CPtr") {
            return self.ptrty
        }
        // a function-value type `fn(...) -> ...` is the {fn, env} closure fat pointer.
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "fn") {
            return self.closureTy
        }
        // Width-accurate integers: I8/U8 -> i8, I16/U16 -> i16, I32/U32 -> i32, else
        // i64 (signedness is tracked separately as a kind, not in the LLVM type).
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "I8") { return self.i8ty }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "U8") { return self.i8ty }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "I16") { return self.i16ty }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "U16") { return self.i16ty }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "I32") { return self.i32ty }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "U32") { return self.i32ty }
        // a registered (all-primitive-field) user struct -> its named LLVM struct type
        // (its 0-type-arg genStruct instance).
        val reg: U64 = self.structRegSlot(c: inout c, start: tyStart, len: tyLen)
        if reg < self.genStructRefs.count() {
            return self.genStructTys[reg]
        }
        // a registered enum -> its named tagged-union type (its 0-type-arg genEnum instance).
        val ereg: U64 = self.enumRegSlot(c: inout c, start: tyStart, len: tyLen)
        if ereg < self.genEnumRefs.count() {
            return self.genEnumTys[ereg]
        }
        // an extern(c) opaque foreign-C handle type (`type LLVMTypeRef`) — the C
        // backend's `typedef void* <Name>` — is an opaque pointer. The LLVM root
        // (`_llvm.pw`) passes these (LLVMValueRef/LLVMTypeRef/…) pervasively, so the
        // backend must lower them to `ptr` to self-compile.
        val cxi: U64 = c.structIndexByName(start: tyStart, len: tyLen)
        if cxi < c.arena.structs.count() {
            if c.arena.structs[cxi].isCExtern {
                return self.ptrty
            }
        }
        return self.i64ty
    }

    // The genStruct* slot for a registered struct named (start,len) — its 0-type-arg
    // instance — or st.genStructRefs.count() if not registered (B2: the one `%gs` mechanism).
    inout fn structRegSlot(c: inout Comp, start: U64, len: U64) -> U64 {
        val sidx: U64 = c.structIndexByName(start: start, len: len)
        if sidx < c.arena.structs.count() {
            return self.structSlotForSidx(c: inout c, sidx: sidx)
        }
        return self.genStructRefs.count()
    }

    // The registered LLVM struct type of `String` — an ordinary one-`Buffer` aggregate
    // `{ptr}` resolved STRUCTURALLY via its registered named `%st` type (de-pin: no
    // name->strty representation pin). Falls back to strty only before registration runs.
    inout fn stringLlvmTy(c: inout Comp) -> LLVMTypeRef {
        val sb: Bind = c.kwSpan(kw: "String", kwLen: 6U64)
        val reg: U64 = self.structRegSlot(c: inout c, start: sb.nameStart, len: sb.nameLen)
        if reg < self.genStructRefs.count() {
            return self.genStructTys[reg]
        }
        return self.strty
    }
}

pub impl LlvmCtx {

    // Register every registerable struct as a named LLVM struct type. Two passes so a
    // nested-struct field resolves to the (already-created) named type of the field's
    // struct: pass 1 creates all the named types, pass 2 sets their bodies. Called once
    // before function emission. (Ref / unique / generic / enum-field structs stay
    // unregistered, so their construction/access is rejected, not miscompiled.)
    // Create the named LLVM struct type for every registerable struct (no bodies yet),
    // so cross-references (struct-of-struct, struct-with-enum-field) resolve in the
    // body pass regardless of declaration order.
    inout fn registerStructNames(c: inout Comp) {
        mut val i: U64 = 0
        while i < c.arena.structs.count() {
            if structRegisterable(c: inout c, sidx: i) {
                self.structIdxs.append(i)
                // De-pin: `String` is an ordinary registered struct — it gets its own fresh
                // named `%stN` type like every other struct (its body, set in the body pass, is
                // `{ptr}` from its single `buffer: Buffer[U8]` field). No name->strty pin.
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "st".bytes())
                appendU64Dec(into: inout nm, n: i)
                nm.append(0)
                val sty: LLVMTypeRef = LLVMStructCreateNamed(self.ctx, arrayCPtr(nm))
                self.structTys.append(sty)
                // B2 (generic-unification): a non-generic struct is the 0-type-arg instance of
                // itself — register it in the SAME genStruct* tables as generic instances (its
                // bare-name, no-args TypeRef pointing at the SAME `%st` LLVM type). Consumers
                // can then resolve every struct through the one genStructSlot path (the `%gs`
                // mechanism), retiring the parallel `structIdxs`/`structTys`. The body is set
                // once via registerStructBodies (shared type); registerGenStructBodies skips
                // these 0-arg entries to avoid a double LLVMStructSetBody.
                mut val zargs: Array[U64] = []
                val instRef: U64 = c.pushType(t: <TypeRef nameStart=c.arena.structs[i].nameStart nameLen=c.arena.structs[i].nameLen args=zargs />)
                self.genStructRefs.append(instRef)
                self.genStructTys.append(sty)
                self.genStructDefs.append(i)
            }
            i += 1
        }
    }

    // Set the body of every registered struct. Run AFTER registerStructNames AND
    // registerEnums, so an enum-typed or nested-struct field resolves to an existing
    // named type (llvmTypeFor -> llvmScalarTy finds the registered enum/struct).
    inout fn registerStructBodies(c: inout Comp) {
        mut val s: U64 = 0
        while s < self.structIdxs.count() {
            val sd: StructDef = c.arena.structs[self.structIdxs[s]]
            mut val elems: Array[LLVMTypeRef] = []
            mut val fi: U64 = 0
            while fi < sd.fields.count() {
                // a boxed (recursive) field is stored as a heap pointer.
                if c.fieldIsBoxed(f: sd.fields[fi]) {
                    elems.append(self.ptrty)
                } else {
                    elems.append(self.fieldLlvmTy(c: inout c, fd: sd.fields[fi]))
                }
                fi += 1
            }
            LLVMStructSetBody(self.structTys[s], arrayCPtr(elems), sd.fields.count(), 0I32)
            s += 1
        }
    }
}
