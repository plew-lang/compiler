// Part of the LLVM backend (root: _.pw): arithmetic / comparison / checked-arithmetic ops and value construction.

// ---- arithmetic / comparison ----

// Build an integer binary op as a single (raw, unchecked) LLVM instruction,
// choosing unsigned vs signed forms (div/rem/cmp/shr) by the operand signedness.
// Comparisons yield i1; arithmetic yields the operand width. This is the WRAPPING
// floor — the wrapping* methods call it directly; the normal operator/compound
// paths go through buildBinOpChecked (overflow / div-by-zero panic).

pub impl LlvmCtx {
    inout fn buildBinOpS(c: inout Comp, op: I64, l: LLVMValueRef, r: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
        if op == opAdd() { return LLVMBuildAdd(self.b, l, r, anon()) }
        if op == opSub() { return LLVMBuildSub(self.b, l, r, anon()) }
        if op == opMul() { return LLVMBuildMul(self.b, l, r, anon()) }
        if op == opDiv() { if unsigned { return LLVMBuildUDiv(self.b, l, r, anon()) } return LLVMBuildSDiv(self.b, l, r, anon()) }
        if op == opRem() { if unsigned { return LLVMBuildURem(self.b, l, r, anon()) } return LLVMBuildSRem(self.b, l, r, anon()) }
        if op == opBitAnd() { return LLVMBuildAnd(self.b, l, r, anon()) }
        if op == opBitOr() { return LLVMBuildOr(self.b, l, r, anon()) }
        if op == opBitXor() { return LLVMBuildXor(self.b, l, r, anon()) }
        if op == opShl() { return LLVMBuildShl(self.b, l, r, anon()) }
        if op == opShr() { if unsigned { return LLVMBuildLShr(self.b, l, r, anon()) } return LLVMBuildAShr(self.b, l, r, anon()) }
        if op == opEq() { return LLVMBuildICmp(self.b, llvmIntEq(), l, r, anon()) }
        if op == opNe() { return LLVMBuildICmp(self.b, llvmIntNe(), l, r, anon()) }
        if op == opLt() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUlt(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSlt(), l, r, anon()) }
        if op == opLe() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUle(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSle(), l, r, anon()) }
        if op == opGt() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUgt(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSgt(), l, r, anon()) }
        if op == opGe() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUge(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSge(), l, r, anon()) }
        // unsupported op (bitwise/shift land in a later increment): reject loudly.
        compileErrorAt(line: 0, msg: "LLVM backend: operator not yet supported")
        return l
    }
}

pub impl LlvmCtx {

    // The i8/i16/i32/i64 LLVM type for a width bucket.
    inout fn llvmIntTyOfIdx(wi: U64) -> LLVMTypeRef {
        if wi == 0U64 { return self.i8ty }
        if wi == 1U64 { return self.i16ty }
        if wi == 2U64 { return self.i32ty }
        return self.i64ty
    }
}

pub impl LlvmCtx {

    // add/sub/mul/div/rem -> a call to the checked runtime helper; any other op (and
    // the wrapping* methods, which call buildBinOpS directly) -> the raw builder.
    inout fn buildBinOpChecked(c: inout Comp, op: I64, l: LLVMValueRef, r: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
        if op == opAdd() || op == opSub() || op == opMul() || op == opDiv() || op == opRem() {
            val wi: U64 = llvmWidthIdx(w: LLVMGetIntTypeWidth(LLVMTypeOf(l)))
            val ity: LLVMTypeRef = self.llvmIntTyOfIdx(wi: wi)
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(ity)
            ptys.append(ity)
            val fty: LLVMTypeRef = LLVMFunctionType(ity, arrayCPtr(ptys), 2U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: checkedFnName(op: op, unsigned: unsigned, wi: wi), nameId: checkedNameId(op: op, unsigned: unsigned, wi: wi), fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(l)
            av.append(r)
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
        }
        return self.buildBinOpS(c: inout c, op: op, l: l, r: r, unsigned: unsigned)
    }

    // Checked signed negation (`-x`): a call to `plew_<iN>Neg`, which panics on
    // INT_MIN. Neg is signed-only (spec/12), so the helper prefix is always signed.
    inout fn buildNegChecked(c: inout Comp, v: LLVMValueRef) -> LLVMValueRef {
        val wi: U64 = llvmWidthIdx(w: LLVMGetIntTypeWidth(LLVMTypeOf(v)))
        val ity: LLVMTypeRef = self.llvmIntTyOfIdx(wi: wi)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(ity)
        val fty: LLVMTypeRef = LLVMFunctionType(ity, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = "plew_".bytes()
        appendBytes(into: inout nm, from: checkedPrefixBytes(unsigned: false, wi: wi))
        appendBytes(into: inout nm, from: "Neg".bytes())
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: stringFromBytesUnchecked(nm), nameId: 9100U64 + wi, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(v)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // 8 (a no-match sentinel, > any real code) if `start..len` is not one of the numeric
    // type prefixes i8..u64; else its packed code `wi + (unsigned ? 4 : 0)` (wi = width
    // bucket 0..3). All-U64 so callers derive `wi = code % 4`, `unsigned = code >= 4`
    // without a signed cast.
    inout fn numPrefixCode(c: inout Comp, start: U64, len: U64) -> U64 {
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "i8") { return 0U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "i16") { return 1U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "i32") { return 2U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "i64") { return 3U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "u8") { return 4U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "u16") { return 5U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "u32") { return 6U64 }
        if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "u64") { return 7U64 }
        return 8U64
    }

    // If the tail of the call name `nameStart..nameLen` equals `opKw` AND the leading
    // bytes form a numeric type prefix (i8..u64), return that prefix's packed code
    // (< 8); else 8 (no match). Used to recognize a numeric-intrinsic name `<prefix><Op>`.
    inout fn numIntrinsicPrefixFor(c: inout Comp, nameStart: U64, nameLen: U64, opKw: String) -> U64 {
        val sl: U64 = opKw.bytes().count()
        if nameLen <= sl { return 8U64 }
        if !(rangeEquals(bytes: c.arena.bytes, start: nameStart + nameLen - sl, len: sl, kw: opKw)) {
            return 8U64
        }
        return self.numPrefixCode(c: inout c, start: nameStart, len: nameLen - sl)
    }

    // The numeric intrinsic floor (spec/12, O6). A call to an `extern "plew-intrinsic"`
    // numeric op (`i8Add`, `u32Lt`, `i64Neg`, …) lowers HERE to the primitive LLVM
    // operation — this is the ONE place the compiler knows what a primitive numeric op
    // does. Every source operator (`+`, `<`, `~`, …) reaches it only THROUGH its trait
    // witness body (`impl I8 as Add { assoc fn add(l,r) { return i8Add(a:l, b:r) } }` in
    // std/Core/Num.pw), so the witness body is the single source of truth and editing it
    // changes the operator. Returns null if the name is not a numeric intrinsic.
    inout fn genNumIntrinsic(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        // float floor (`f64Add`, `f32Neg`, `f64Lt`, …) and bool floor (`boolNot`,
        // `boolEq`) are recognized first — their names don't share the iN/uN prefix
        // shape, so the int matcher below would reject them anyway; handling them up
        // front keeps each floor's lowering in one place.
        val fv: LLVMValueRef = self.genFloatIntrinsic(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
        if LLVMIsNull(fv) == 0I32 { return fv }
        val bv: LLVMValueRef = self.genBoolIntrinsic(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
        if LLVMIsNull(bv) == 0I32 { return bv }
        // wrapping floor (`i64WrapAdd`, `u8WrapNeg`, …): raw two's-complement ops with NO
        // overflow check — the intrinsic bodies of the `wrapping*` FixedWidthInteger
        // witnesses (spec/02). Matched first, and off the checked `Add`/`Neg` matchers because their
        // remaining prefix (`i64Wrap`) is not a recognized width prefix (numPrefixCode -> 8).
        val wnegP: U64 = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "WrapNeg")
        if wnegP < 8U64 {
            val ty: LLVMTypeRef = self.llvmIntTyOfIdx(wi: wnegP % 4U64)
            return LLVMBuildNeg(self.b, self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: ty, unsigned: wnegP >= 4U64), anon())
        }
        mut val wop: I64 = -1I64
        mut val wpc: U64 = 8U64
        wpc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "WrapAdd")
        if wpc < 8U64 { wop = opAdd() }
        if wop == -1I64 { wpc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "WrapSub")  if wpc < 8U64 { wop = opSub() } }
        if wop == -1I64 { wpc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "WrapMul")  if wpc < 8U64 { wop = opMul() } }
        if wop != -1I64 {
            val wu: Bool = wpc >= 4U64
            val wty: LLVMTypeRef = self.llvmIntTyOfIdx(wi: wpc % 4U64)
            val wl: LLVMValueRef = self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: wty, unsigned: wu)
            val wr: LLVMValueRef = self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[1].expr), target: wty, unsigned: wu)
            return self.buildBinOpS(c: inout c, op: wop, l: wl, r: wr, unsigned: wu)
        }
        // unary ops first (single `value` arg).
        val negP: U64 = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Neg")
        if negP < 8U64 {
            val ty: LLVMTypeRef = self.llvmIntTyOfIdx(wi: negP % 4U64)
            return self.buildNegChecked(c: inout c, v: self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: ty, unsigned: negP >= 4U64))
        }
        val notP: U64 = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "BitNot")
        if notP < 8U64 {
            val ty: LLVMTypeRef = self.llvmIntTyOfIdx(wi: notP % 4U64)
            return LLVMBuildNot(self.b, self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: ty, unsigned: notP >= 4U64), anon())
        }
        // binary ops: name tail -> Op, then the single checked entry (which routes
        // arithmetic to the panic helpers and bitwise/shift/comparison to the raw op).
        mut val op: I64 = -1I64
        mut val pc: U64 = 8U64
        pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Add")
        if pc < 8U64 { op = opAdd() }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Sub")  if pc < 8U64 { op = opSub() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Mul")  if pc < 8U64 { op = opMul() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Div")  if pc < 8U64 { op = opDiv() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Rem")  if pc < 8U64 { op = opRem() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "BitAnd")  if pc < 8U64 { op = opBitAnd() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "BitOr")  if pc < 8U64 { op = opBitOr() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "BitXor")  if pc < 8U64 { op = opBitXor() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Shl")  if pc < 8U64 { op = opShl() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Shr")  if pc < 8U64 { op = opShr() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Eq")  if pc < 8U64 { op = opEq() } }
        if op == -1I64 { pc = self.numIntrinsicPrefixFor(c: inout c, nameStart: nameStart, nameLen: nameLen, opKw: "Lt")  if pc < 8U64 { op = opLt() } }
        if op == -1I64 {
            return LLVMConstNull(self.ptrty)
        }
        val unsigned: Bool = pc >= 4U64
        val ty: LLVMTypeRef = self.llvmIntTyOfIdx(wi: pc % 4U64)
        val l: LLVMValueRef = self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: ty, unsigned: unsigned)
        val r: LLVMValueRef = self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[1].expr), target: ty, unsigned: unsigned)
        return self.buildBinOpChecked(c: inout c, op: op, l: l, r: r, unsigned: unsigned)
    }

    // The float half of the intrinsic floor (spec/02,12): a call to `f32<Op>` / `f64<Op>`
    // lowers HERE to the IEEE op. Arithmetic (Add/Sub/Mul/Div) -> f-op; Neg -> fneg;
    // Eq/Lt -> a NaN-compare panic guard then an ordered fcmp -> i1 (Ord.compare rides
    // Lt; float `%` and bitwise ops don't exist, so no Rem/Bit* here). Both F32/F64 lower
    // to `double` for now. Returns null if the name isn't a float intrinsic.
    inout fn genFloatIntrinsic(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        if nameLen <= 3U64 { return LLVMConstNull(self.ptrty) }
        if !(rangeEquals(bytes: c.arena.bytes, start: nameStart, len: 3U64, kw: "f32")) {
            if !(rangeEquals(bytes: c.arena.bytes, start: nameStart, len: 3U64, kw: "f64")) {
                return LLVMConstNull(self.ptrty)
            }
        }
        val ss: U64 = nameStart + 3U64
        val sl: U64 = nameLen - 3U64
        // unary Neg (one `value` arg). Match the suffix BEFORE touching args — an
        // unrelated `f64<X>` name (e.g. the `f64ToU64` conversion intrinsic) shares the
        // prefix but isn't an operator floor op, and takes a different arg shape.
        if rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Neg") {
            return LLVMBuildFNeg(self.b, self.coerceToF64(c: inout c, id: args[0].expr), anon())
        }
        // recognized binary float ops only: identify the op from the suffix first, then
        // (once matched) lower the two operands.
        mut val isAdd: Bool = rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Add")
        mut val isSub: Bool = rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Sub")
        mut val isMul: Bool = rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Mul")
        mut val isDiv: Bool = rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Div")
        mut val isEq: Bool = rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Eq")
        mut val isLt: Bool = rangeEquals(bytes: c.arena.bytes, start: ss, len: sl, kw: "Lt")
        if !isAdd { if !isSub { if !isMul { if !isDiv { if !isEq { if !isLt {
            return LLVMConstNull(self.ptrty)
        } } } } } }
        val l: LLVMValueRef = self.coerceToF64(c: inout c, id: args[0].expr)
        val r: LLVMValueRef = self.coerceToF64(c: inout c, id: args[1].expr)
        if isAdd { return LLVMBuildFAdd(self.b, l, r, anon()) }
        if isSub { return LLVMBuildFSub(self.b, l, r, anon()) }
        if isMul { return LLVMBuildFMul(self.b, l, r, anon()) }
        if isDiv { return LLVMBuildFDiv(self.b, l, r, anon()) }
        // Eq/Lt: NaN compares must panic (spec/02) before the ordered fcmp
        // (LLVMRealOEQ=1, OLT=4).
        self.emitF64NanCheck(c: inout c, l: l, r: r)
        if isEq { return LLVMBuildFCmp(self.b, 1U32, l, r, anon()) }
        return LLVMBuildFCmp(self.b, 4U32, l, r, anon())
    }

    // The bool half of the intrinsic floor: `boolNot` -> `xor x, true`, `boolEq` ->
    // `icmp eq`. Concrete `!b` / `b == b` open-code the same ops directly (Expr.pw); these
    // exist so a generic `T.not` / `T.eq` grounded to Bool routes through the real witness.
    // Returns null if the name isn't a bool intrinsic.
    inout fn genBoolIntrinsic(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "boolNot") {
            return LLVMBuildNot(self.b, self.genLlvmExpr(c: inout c, id: args[0].expr), anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "boolEq") {
            val l: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[0].expr)
            val r: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[1].expr)
            return LLVMBuildICmp(self.b, llvmIntEq(), l, r, anon())
        }
        return LLVMConstNull(self.ptrty)
    }

    // Construct a registered struct value from a JSX `<Type field=expr ... />`: build
    // each declared field (matched by name, or its default) in order via insertvalue.
    inout fn genLlvmMake(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, ty: U64, fields: Array[MakeField]) -> LLVMValueRef {
        // inside a generic method/function body, a construction `<Box[T] … />` names
        // the syntactic `Box[T]`; ground its type args through the active env so it
        // resolves to the registered concrete instance (`Box[I32]`).
        mut val gty: U64 = ty
        if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
            gty = c.groundTypeRef(ref: ty)
        }
        // a context-less record literal `(a:1, b:2)` lowers to a Make with NO type name
        // (Lower.pw): resolve its record struct from the construction context — the
        // enclosing field/payload builder sets `self.expectedTy` to the field's declared
        // record type (a `(`-prefixed canonical name). Without this, a record used as an
        // enum payload (`<Optional.Some v=(index:1, value:2)/>`) can't be built.
        if typeLen == 0U64 {
            if self.expectedTy != 0U64 {
                // ground the expected record type through the active env so a record built
                // in a generic body (`return (v: x)` where the declared return is `(v: T)`)
                // resolves to its concrete instance `(v: I32)` — not the i64-defaulting
                // template. Mirrors the `gty` grounding above for named generic structs.
                mut val exTy: U64 = self.expectedTy
                if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
                    exTy = c.groundTypeRef(ref: exTy)
                }
                if exTy < c.arena.types.count() {
                    val et: TypeRef = c.arena.types[exTy]
                    if et.nameLen > 0U64 {
                        if c.arena.bytes[et.nameStart] == 40U8 {
                            val rreg: U64 = self.structRegSlot(c: inout c, start: et.nameStart, len: et.nameLen)
                            if rreg < self.genStructRefs.count() {
                                self.expectedTy = 0U64
                                return self.buildStructValue(c: inout c, sd: c.arena.structs[self.genStructDefs[rreg]], sty: self.genStructTys[rreg], fields: fields, errOffset: et.nameStart)
                            }
                        }
                    }
                }
            }
        }
        if isEnum {
            return self.genLlvmMakeEnum(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, ty: gty, fields: fields)
        }
        // an un-suffixed generic-struct construction (`inner=<Box value=e />`) has an
        // ungrounded head `gty`; fall back to the expected type from context (the field's
        // declared instance type set by genFieldValue) when it names this same generic
        // struct. Consume it so it can't leak into the field sub-expressions.
        if !(c.isGenericInst(ref: gty)) {
            if self.expectedTy != 0U64 {
                if c.isGenericInst(ref: self.expectedTy) {
                    val et: TypeRef = c.arena.types[self.expectedTy]
                    if spansEqual(c: inout c, aStart: et.nameStart, aLen: et.nameLen, bStart: typeStart, bLen: typeLen) {
                        gty = self.expectedTy
                    }
                }
            }
        }
        self.expectedTy = 0U64
        // `<Ref[T] value=e />`: allocate a heap cell holding the pointee, store e, and
        // yield the cell pointer (the Ref value). Refcount/release is hidden cost,
        // deferred (no deinit in these cases yet) — the pointer aliases on copy so
        // shared mutation through `->` is visible.
        if rangeEquals(bytes: c.arena.bytes, start: typeStart, len: typeLen, kw: "Ref") {
            return self.genLlvmMakeRef(c: inout c, ty: gty, fields: fields)
        }
        // a generic struct instance (Box[I32]): build under its substitution env.
        if c.isGenericInst(ref: gty) {
            val gslot: U64 = self.genStructSlot(c: inout c, ref: gty)
            if gslot < self.genStructRefs.count() {
                val sd: StructDef = c.arena.structs[self.genStructDefs[gslot]]
                val savedP: Array[Bind] = c.cur.typeParams
                val savedA: Array[U64] = c.cur.typeArgs
                // MERGE (see genLlvmMakeEnum) so a field sub-expression referencing the
                // enclosing method's type params still grounds. This instance's OWN params go
                // LAST (highest index) so last-match resolveTy gives lexical shadowing when a
                // name collides (`Box[Box[I32]]` — both levels' param named `T`: the inner
                // must resolve to I32, not the outer Box[I32]).
                c.cur.typeParams = concatParams(add: savedP, base: sd.typeParams)
                c.cur.typeArgs = concatArgs(add: savedA, base: c.arena.types[gty].args)
                val v: LLVMValueRef = self.buildStructValue(c: inout c, sd: sd, sty: self.genStructTys[gslot], fields: fields, errOffset: typeStart)
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
                return v
            }
        }
        // a newtype over a struct inherits its factory (spec/10): `<Brand code=… />`
        // builds the underlying Rgb struct (identical representation). Resolve the
        // construction name to the underlying before the registered-struct lookup.
        mut val rtStart: U64 = typeStart
        mut val rtLen: U64 = typeLen
        // a grounded record/struct (`(v:T)` -> `(v:I32)` in a generic body): build the
        // concrete instance, not the i64-defaulting template. `gty` carries the grounding;
        // use its name for the registered-struct lookup (mirrors llvmFnRetTy).
        if gty != ty {
            if gty < c.arena.types.count() {
                val gtyT: TypeRef = c.arena.types[gty]
                rtStart = gtyT.nameStart
                rtLen = gtyT.nameLen
            }
        }
        val ntn: Bind = c.newtypeUnderName(start: rtStart, len: rtLen)
        if ntn.nameStart != rtStart || ntn.nameLen != rtLen {
            rtStart = ntn.nameStart
            rtLen = ntn.nameLen
        }
        val reg: U64 = self.structRegSlot(c: inout c, start: rtStart, len: rtLen)
        if reg >= self.genStructRefs.count() {
            // an un-grounded generic construction that neither top-down context, bottom-up
            // field inference, nor the expectedTy fallback could ground: the head names a
            // generic template with no concrete type arguments. Report it honestly at the
            // construction (front-end inference already handled every inferable case).
            if c.genericStructIndex(nameStart: rtStart, nameLen: rtLen) < c.arena.structs.count() {
                c.errorAt(offset: typeStart, msg: "cannot infer the type argument(s) of this generic construction; annotate it (e.g. `Type[Arg]`, or a typed binding / return type)")
            } else {
                c.errorAt(offset: typeStart, msg: "LLVM backend: construction of this type is not supported")
            }
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        return self.buildStructValue(c: inout c, sd: c.arena.structs[self.genStructDefs[reg]], sty: self.genStructTys[reg], fields: fields, errOffset: typeStart)
    }

    // The LLVM type of a `Ref[T]`'s pointee T (from the instance's first type arg).
    inout fn refPointeeTy(c: inout Comp, refTy: U64) -> LLVMTypeRef {
        if c.isRefInst(ref: refTy) {
            return self.llvmTypeOfRef(c: inout c, ref: c.arena.types[refTy].args[0])
        }
        return self.i64ty
    }

    // The Ref instance TypeRef of an expression that evaluates to a `Ref[T]` (a local
    // carries it on locTypeRef), or 0 if it is not a Ref-typed expression.
    inout fn exprRefTypeRef(c: inout Comp, id: U64) -> U64 {
        val r: U64 = self.exprTypeRef(c: inout c, id: id)
        if c.isRefInst(ref: r) {
            return r
        }
        return 0U64
    }

    // The struct index of a `Ref[T]` base's pointee T (for `->field` resolution), or
    // c.arena.structs.count() if the base isn't a Ref to a registered struct.
    inout fn refPointeeStructIdx(c: inout Comp, base: U64) -> U64 {
        val r: U64 = self.exprRefTypeRef(c: inout c, id: base)
        if r != 0U64 {
            val t: TypeRef = c.arena.types[r]
            if t.args.count() > 0U64 {
                val pt: TypeRef = c.arena.types[t.args[0]]
                return self.localStructIdxFor(c: inout c, start: pt.nameStart, len: pt.nameLen)
            }
        }
        return c.arena.structs.count()
    }

    // Load a `Ref[T]` base's pointee struct VALUE (`*cell`) — the basis for `->field`.
    inout fn loadRefPointee(c: inout Comp, base: U64) -> LLVMValueRef {
        val r: U64 = self.exprRefTypeRef(c: inout c, id: base)
        val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: r)
        val cellPtr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: base)
        return LLVMBuildLoad2(self.b, pty, cellPtr, anon())
    }

    // Build a `Ref[T]` value: malloc a cell of sizeof(T), store the `value` field's
    // pointee into it, and return the cell pointer.
    inout fn genLlvmMakeRef(c: inout Comp, ty: U64, fields: Array[MakeField]) -> LLVMValueRef {
        val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: ty)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(pty), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        // the pointee value (the `value` field).
        mut val valExpr: U64 = 0
        mut val mi: U64 = 0
        while mi < fields.count() {
            if rangeEquals(bytes: c.arena.bytes, start: fields[mi].nameStart, len: fields[mi].nameLen, kw: "value") {
                valExpr = fields[mi].value
                mi = fields.count()
            } else {
                mi += 1
            }
        }
        mut val v: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valExpr)
        if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
            v = self.coerceInt(v: v, target: pty, unsigned: false)
        }
        LLVMBuildStore(self.b, v, cell)
        return cell
    }

    // Build a struct value of LLVM type `sty` from def `sd`: each declared field
    // (matched by name, or its default), under the active substitution env.
    inout fn buildStructValue(c: inout Comp, sd: StructDef, sty: LLVMTypeRef, fields: Array[MakeField], errOffset: U64) -> LLVMValueRef {
        mut val agg: LLVMValueRef = LLVMGetUndef(sty)
        mut val fi: U64 = 0
        while fi < sd.fields.count() {
            val fld: FieldDef = sd.fields[fi]
            mut val provided: Bool = false
            mut val valExpr: U64 = 0
            mut val mi: U64 = 0
            while mi < fields.count() {
                if spansEqual(c: inout c, aStart: fields[mi].nameStart, aLen: fields[mi].nameLen, bStart: fld.nameStart, bLen: fld.nameLen) {
                    provided = true
                    valExpr = fields[mi].value
                    mi = fields.count()
                } else {
                    mi += 1
                }
            }
            if !(provided) {
                if fld.hasDefault {
                    valExpr = fld.defaultVal
                } else {
                    c.errorAt(offset: errOffset, msg: "LLVM backend: missing struct field in construction")
                    return agg
                }
            }
            agg = LLVMBuildInsertValue(self.b, agg, self.genFieldValue(c: inout c, valExpr: valExpr, fld: fld), fi, anon())
            fi += 1
        }
        return agg
    }
}
