// Part of the LLVM backend (root: _.pw): arithmetic / comparison / checked-arithmetic ops and value construction.

// ---- arithmetic / comparison ----

// Build an integer binary op as a single (raw, unchecked) LLVM instruction,
// choosing unsigned vs signed forms (div/rem/cmp/shr) by the operand signedness.
// Comparisons yield i1; arithmetic yields the operand width. This is the WRAPPING
// floor — the wrapping* methods call it directly; the normal operator/compound
// paths go through buildBinOpChecked (overflow / div-by-zero panic).

pub impl LlvmCtx {
    inout fn buildBinOpS(c: inout Comp, op: I64, l: LLVMValueRef, r: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
        if op == opAdd() { return LLVMBuildAdd(self.b, l, r, anon()) }
        if op == opSub() { return LLVMBuildSub(self.b, l, r, anon()) }
        if op == opMul() { return LLVMBuildMul(self.b, l, r, anon()) }
        if op == opDiv() { if unsigned { return LLVMBuildUDiv(self.b, l, r, anon()) } return LLVMBuildSDiv(self.b, l, r, anon()) }
        if op == opRem() { if unsigned { return LLVMBuildURem(self.b, l, r, anon()) } return LLVMBuildSRem(self.b, l, r, anon()) }
        if op == opBitAnd() { return LLVMBuildAnd(self.b, l, r, anon()) }
        if op == opBitOr() { return LLVMBuildOr(self.b, l, r, anon()) }
        if op == opBitXor() { return LLVMBuildXor(self.b, l, r, anon()) }
        if op == opShl() { return LLVMBuildShl(self.b, l, r, anon()) }
        if op == opShr() { if unsigned { return LLVMBuildLShr(self.b, l, r, anon()) } return LLVMBuildAShr(self.b, l, r, anon()) }
        if op == opEq() { return LLVMBuildICmp(self.b, llvmIntEq(), l, r, anon()) }
        if op == opNe() { return LLVMBuildICmp(self.b, llvmIntNe(), l, r, anon()) }
        if op == opLt() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUlt(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSlt(), l, r, anon()) }
        if op == opLe() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUle(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSle(), l, r, anon()) }
        if op == opGt() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUgt(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSgt(), l, r, anon()) }
        if op == opGe() { if unsigned { return LLVMBuildICmp(self.b, llvmIntUge(), l, r, anon()) } return LLVMBuildICmp(self.b, llvmIntSge(), l, r, anon()) }
        // unsupported op (bitwise/shift land in a later increment): reject loudly.
        compileErrorAt(line: 0, msg: "LLVM backend: operator not yet supported")
        return l
    }
}

pub impl LlvmCtx {

    // The i8/i16/i32/i64 LLVM type for a width bucket.
    inout fn llvmIntTyOfIdx(wi: U64) -> LLVMTypeRef {
        if wi == 0U64 { return self.i8ty }
        if wi == 1U64 { return self.i16ty }
        if wi == 2U64 { return self.i32ty }
        return self.i64ty
    }
}

pub impl LlvmCtx {

    // add/sub/mul/div/rem -> a call to the checked runtime helper; any other op (and
    // the wrapping* methods, which call buildBinOpS directly) -> the raw builder.
    inout fn buildBinOpChecked(c: inout Comp, op: I64, l: LLVMValueRef, r: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
        if op == opAdd() || op == opSub() || op == opMul() || op == opDiv() || op == opRem() {
            val wi: U64 = llvmWidthIdx(w: LLVMGetIntTypeWidth(LLVMTypeOf(l)))
            val ity: LLVMTypeRef = self.llvmIntTyOfIdx(wi: wi)
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(ity)
            ptys.append(ity)
            val fty: LLVMTypeRef = LLVMFunctionType(ity, arrayCPtr(ptys), 2U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: checkedFnName(op: op, unsigned: unsigned, wi: wi), nameId: checkedNameId(op: op, unsigned: unsigned, wi: wi), fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(l)
            av.append(r)
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
        }
        return self.buildBinOpS(c: inout c, op: op, l: l, r: r, unsigned: unsigned)
    }

    // Checked signed negation (`-x`): a call to `plew_<iN>Neg`, which panics on
    // INT_MIN. Neg is signed-only (spec/12), so the helper prefix is always signed.
    inout fn buildNegChecked(c: inout Comp, v: LLVMValueRef) -> LLVMValueRef {
        val wi: U64 = llvmWidthIdx(w: LLVMGetIntTypeWidth(LLVMTypeOf(v)))
        val ity: LLVMTypeRef = self.llvmIntTyOfIdx(wi: wi)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(ity)
        val fty: LLVMTypeRef = LLVMFunctionType(ity, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = "plew_".bytes()
        appendBytes(into: inout nm, from: checkedPrefixBytes(unsigned: false, wi: wi))
        appendBytes(into: inout nm, from: "Neg".bytes())
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: stringFromBytesUnchecked(nm), nameId: 9100U64 + wi, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(v)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Consume the frontend's closed numeric ABI descriptor.  This is the
    // backend endpoint: it deliberately receives neither a source function
    // name nor a type spelling.
    inout fn genNumericIntrinsic(c: inout Comp, intrinsic: NumericIntrinsic, args: ArgRange, errorOffset: U64) -> LLVMValueRef {
        mut val values: Array[LLVMValueRef] = []
        mut val i: U64 = 0U64
        while i < args.len {
            values.append(self.genLlvmExpr(c: inout c, id: c.argAt(args: args, index: i).expr))
            i += 1U64
        }
        return self.genNumericIntrinsicValues(c: inout c, intrinsic: intrinsic, values: values, errorOffset: errorOffset)
    }

    // The shared ABI endpoint for legacy and Mid lowering.  Both paths have
    // already selected argument evaluation order and the closed descriptor;
    // this routine sees only LLVM values and cannot reopen source syntax.
    inout fn genNumericIntrinsicValues(c: inout Comp, intrinsic: NumericIntrinsic, values: Array[LLVMValueRef], errorOffset: U64) -> LLVMValueRef {
        match intrinsic {
            NumericIntrinsic.Integer(width: val width, unsigned: val unsigned, operation: val operation, overflow: val overflow) => {
                val ty: LLVMTypeRef = self.llvmIntTyOfNumericWidth(width: width)
                match operation {
                    IntegerOperation.Neg => {
                        if values.count() != 1U64 {
                            c.errorAt(offset: errorOffset, msg: "internal error: integer neg runtime intrinsic has an invalid ABI arity")
                            return LLVMConstInt(self.i64ty, 0U64, 0I32)
                        }
                        val v: LLVMValueRef = self.coerceInt(v: values[0U64], target: ty, unsigned: unsigned)
                        match overflow {
                            NumericOverflow.Checked => { return self.buildNegChecked(c: inout c, v: v) }
                            NumericOverflow.Wrapping => { return LLVMBuildNeg(self.b, v, anon()) }
                        }
                    }
                    IntegerOperation.BitNot => {
                        if values.count() != 1U64 {
                            c.errorAt(offset: errorOffset, msg: "internal error: integer bit-not runtime intrinsic has an invalid ABI arity")
                            return LLVMConstInt(self.i64ty, 0U64, 0I32)
                        }
                        return LLVMBuildNot(self.b, self.coerceInt(v: values[0U64], target: ty, unsigned: unsigned), anon())
                    }
                    _ => {}
                }
                if values.count() != 2U64 {
                    c.errorAt(offset: errorOffset, msg: "internal error: integer binary runtime intrinsic has an invalid ABI arity")
                    return LLVMConstInt(self.i64ty, 0U64, 0I32)
                }
                val l: LLVMValueRef = self.coerceInt(v: values[0U64], target: ty, unsigned: unsigned)
                val r: LLVMValueRef = self.coerceInt(v: values[1U64], target: ty, unsigned: unsigned)
                val op: I64 = self.integerOperationCode(operation: operation)
                match overflow {
                    NumericOverflow.Checked => { return self.buildBinOpChecked(c: inout c, op: op, l: l, r: r, unsigned: unsigned) }
                    NumericOverflow.Wrapping => { return self.buildBinOpS(c: inout c, op: op, l: l, r: r, unsigned: unsigned) }
                }
            }
            NumericIntrinsic.Float(width: val width, operation: val operation) => {
                self.ensureFloatWidth(width: width)
                match operation {
                    FloatOperation.Neg => {
                        if values.count() != 1U64 {
                            c.errorAt(offset: errorOffset, msg: "internal error: float neg runtime intrinsic has an invalid ABI arity")
                            return LLVMConstNull(self.ptrty)
                        }
                        return LLVMBuildFNeg(self.b, self.coerceLlvmValueToF64(value: values[0U64]), anon())
                    }
                    _ => {}
                }
                if values.count() != 2U64 {
                    c.errorAt(offset: errorOffset, msg: "internal error: float binary runtime intrinsic has an invalid ABI arity")
                    return LLVMConstNull(self.ptrty)
                }
                val l: LLVMValueRef = self.coerceLlvmValueToF64(value: values[0U64])
                val r: LLVMValueRef = self.coerceLlvmValueToF64(value: values[1U64])
                match operation {
                    FloatOperation.Add => { return LLVMBuildFAdd(self.b, l, r, anon()) }
                    FloatOperation.Sub => { return LLVMBuildFSub(self.b, l, r, anon()) }
                    FloatOperation.Mul => { return LLVMBuildFMul(self.b, l, r, anon()) }
                    FloatOperation.Div => { return LLVMBuildFDiv(self.b, l, r, anon()) }
                    FloatOperation.Eq => {
                        self.emitF64NanCheck(c: inout c, l: l, r: r)
                        return LLVMBuildFCmp(self.b, 1U32, l, r, anon())
                    }
                    FloatOperation.Lt => {
                        self.emitF64NanCheck(c: inout c, l: l, r: r)
                        return LLVMBuildFCmp(self.b, 4U32, l, r, anon())
                    }
                    FloatOperation.Neg => {
                        c.errorAt(offset: errorOffset, msg: "internal error: float neg dispatch fell through")
                        return LLVMConstNull(self.ptrty)
                    }
                }
            }
            NumericIntrinsic.Bool(operation: val operation) => {
                match operation {
                    BoolOperation.Not => {
                        if values.count() != 1U64 {
                            c.errorAt(offset: errorOffset, msg: "internal error: bool not runtime intrinsic has an invalid ABI arity")
                            return LLVMConstInt(self.i1ty, 0U64, 0I32)
                        }
                        return LLVMBuildNot(self.b, values[0U64], anon())
                    }
                    BoolOperation.Eq => {
                        if values.count() != 2U64 {
                            c.errorAt(offset: errorOffset, msg: "internal error: bool eq runtime intrinsic has an invalid ABI arity")
                            return LLVMConstInt(self.i1ty, 0U64, 0I32)
                        }
                        val l: LLVMValueRef = values[0U64]
                        val r: LLVMValueRef = values[1U64]
                        return LLVMBuildICmp(self.b, llvmIntEq(), l, r, anon())
                    }
                }
            }
            NumericIntrinsic.Conversion(intrinsic: val conversion) => {
                if values.count() != 1U64 {
                    c.errorAt(offset: errorOffset, msg: "internal error: numeric conversion runtime intrinsic has an invalid ABI arity")
                    return LLVMConstInt(self.i64ty, 0U64, 0I32)
                }
                val value: LLVMValueRef = values[0U64]
                match conversion {
                    NumericConversionIntrinsic.BitCastI64 => { return self.extendToI64(v: value, unsigned: true) }
                    NumericConversionIntrinsic.BitCastU64 => { return self.extendToI64(v: value, unsigned: false) }
                    NumericConversionIntrinsic.TruncU8 => { return self.coerceInt(v: value, target: self.i8ty, unsigned: true) }
                    NumericConversionIntrinsic.TruncU16 => { return self.coerceInt(v: value, target: self.i16ty, unsigned: true) }
                    NumericConversionIntrinsic.TruncU32 => { return self.coerceInt(v: value, target: self.i32ty, unsigned: true) }
                    NumericConversionIntrinsic.TruncI8 => { return self.coerceInt(v: value, target: self.i8ty, unsigned: false) }
                    NumericConversionIntrinsic.TruncI16 => { return self.coerceInt(v: value, target: self.i16ty, unsigned: false) }
                    NumericConversionIntrinsic.TruncI32 => { return self.coerceInt(v: value, target: self.i32ty, unsigned: false) }
                    NumericConversionIntrinsic.IsNanF64 => {
                        val float: LLVMValueRef = self.coerceLlvmValueToF64(value: value)
                        return LLVMBuildFCmp(self.b, 8U32, float, float, anon())
                    }
                    NumericConversionIntrinsic.F64ToI64 => { return LLVMBuildFPToSI(self.b, self.coerceLlvmValueToF64(value: value), self.i64ty, anon()) }
                    NumericConversionIntrinsic.F64ToU64 => { return LLVMBuildFPToUI(self.b, self.coerceLlvmValueToF64(value: value), self.i64ty, anon()) }
                }
            }
        }
    }

    fn numericIntrinsicArity(intrinsic: NumericIntrinsic) -> U64 {
        match intrinsic {
            NumericIntrinsic.Integer(width: _, unsigned: _, operation: val operation, overflow: _) => {
                match operation {
                    IntegerOperation.Neg => { return 1U64 }
                    IntegerOperation.BitNot => { return 1U64 }
                    _ => { return 2U64 }
                }
            }
            NumericIntrinsic.Float(width: _, operation: val operation) => {
                match operation {
                    FloatOperation.Neg => { return 1U64 }
                    _ => { return 2U64 }
                }
            }
            NumericIntrinsic.Bool(operation: val operation) => {
                match operation {
                    BoolOperation.Not => { return 1U64 }
                    BoolOperation.Eq => { return 2U64 }
                }
            }
            NumericIntrinsic.Conversion(intrinsic: _) => { return 1U64 }
        }
    }

    inout fn llvmIntTyOfNumericWidth(width: NumericWidth) -> LLVMTypeRef {
        match width {
            NumericWidth.W8 => { return self.i8ty }
            NumericWidth.W16 => { return self.i16ty }
            NumericWidth.W32 => { return self.i32ty }
            NumericWidth.W64 => { return self.i64ty }
        }
    }

    fn ensureFloatWidth(width: FloatWidth) {
        match width {
            FloatWidth.W32 => {}
            FloatWidth.W64 => {}
        }
    }

    // Mid has already materialized its operands, so float lowering cannot use
    // the AST-oriented `coerceToF64`.  Preserve the same ABI conversion here
    // at the LLVM-value boundary.
    inout fn coerceLlvmValueToF64(value: LLVMValueRef) -> LLVMValueRef {
        if LLVMGetTypeKind(LLVMTypeOf(value)) == 8U32 {
            return LLVMBuildSIToFP(self.b, value, self.f64ty, anon())
        }
        return value
    }

    fn integerOperationCode(operation: IntegerOperation) -> I64 {
        match operation {
            IntegerOperation.Add => { return opAdd() }
            IntegerOperation.Sub => { return opSub() }
            IntegerOperation.Mul => { return opMul() }
            IntegerOperation.Div => { return opDiv() }
            IntegerOperation.Rem => { return opRem() }
            IntegerOperation.BitAnd => { return opBitAnd() }
            IntegerOperation.BitOr => { return opBitOr() }
            IntegerOperation.BitXor => { return opBitXor() }
            IntegerOperation.Shl => { return opShl() }
            IntegerOperation.Shr => { return opShr() }
            IntegerOperation.Eq => { return opEq() }
            IntegerOperation.Ne => { return opNe() }
            IntegerOperation.Lt => { return opLt() }
            IntegerOperation.Le => { return opLe() }
            IntegerOperation.Gt => { return opGt() }
            IntegerOperation.Ge => { return opGe() }
            IntegerOperation.Neg => {
                compileErrorAt(line: 0, msg: "internal error: unary neg has no integer binary operation code")
                return opAdd()
            }
            IntegerOperation.BitNot => {
                compileErrorAt(line: 0, msg: "internal error: unary bit-not has no integer binary operation code")
                return opAdd()
            }
        }
    }

    // Construct a registered struct value from a JSX `<Type field=expr ... />`: build
    // each declared field (matched by name, or its default) in order via insertvalue.
    inout fn genLlvmMake(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, ty: U64, fields: MakeFieldRange) -> LLVMValueRef {
        // inside a generic method/function body, a construction `<Box[T] … />` names
        // the syntactic `Box[T]`; ground its type args through the active env so it
        // resolves to the registered concrete instance (`Box[I32]`).
        mut val gty: U64 = ty
        if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
            gty = c.groundTypeRef(ref: ty)
        }
        if self.curRecvInstRef != 0U64 {
            val rgty: U64 = c.groundUnderInst(instRef: self.curRecvInstRef, tyRef: gty)
            if rgty != gty {
                gty = rgty
            }
        }
        // a context-less record literal `(a:1, b:2)` lowers to a Make with NO type name
        // (Lower.pw): resolve its record struct from the construction context — the
        // enclosing field/payload builder sets `self.expectedTy` to the field's declared
        // record type (a `(`-prefixed canonical name). Without this, a record used as an
        // enum payload (`<Optional.Some v=(index:1, value:2)/>`) can't be built.
        if typeLen == 0U64 {
            if self.expectedTy != 0U64 {
                // ground the expected record type through the active env so a record built
                // in a generic body (`return (v: x)` where the declared return is `(v: T)`)
                // resolves to its concrete instance `(v: I32)` — not the i64-defaulting
                // template. Mirrors the `gty` grounding above for named generic structs.
                mut val exTy: U64 = self.expectedTy
                if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
                    exTy = c.groundTypeRef(ref: exTy)
                }
                if exTy < c.arena.types.count() {
                    val et: TypeRef = c.arena.types[exTy]
                    if et.nameLen > 0U64 {
                        if c.arena.bytes[et.nameStart] == 40U8 {
                            val rreg: U64 = self.structRegSlot(c: inout c, start: et.nameStart, len: et.nameLen)
                            if rreg < self.genStructRefs.count() {
                                self.expectedTy = 0U64
                                return self.buildStructValue(c: inout c, sd: c.arena.structs[self.genStructDefs[rreg]], sty: self.genStructTys[rreg], fields: fields, errOffset: et.nameStart)
                            }
                        }
                    }
                }
            }
        }
        if isEnum {
            return self.genLlvmMakeEnum(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, ty: gty, fields: fields)
        }
        // Context may carry the canonical grounded instance for this construction. Use it
        // for both un-suffixed generic structs (`<Box value=e/>`) and explicit constructions
        // whose args still mention an enclosing generic parameter (`<Ref[T] .../>` inside
        // `WeakRef[Cell].upgrade`): otherwise LLVM sees two named `{ptr}` structs for the
        // same logical instance and rejects aggregate insertion.
        if self.expectedTy != 0U64 {
            if c.isGenericInst(ref: self.expectedTy) {
                val et: TypeRef = c.arena.types[self.expectedTy]
                if spansEqual(c: inout c, aStart: et.nameStart, aLen: et.nameLen, bStart: typeStart, bLen: typeLen) {
                    gty = self.expectedTy
                }
            }
        }
        self.expectedTy = 0U64
        // a generic struct instance (Box[I32]): build under its substitution env.
        if c.isGenericInst(ref: gty) {
            val gslot: U64 = self.genStructSlot(c: inout c, ref: gty)
            if gslot < self.genStructRefs.count() {
                val sd: StructDef = c.arena.structs[self.genStructDefs[gslot]]
                val savedP: Array[Bind] = c.cur.typeParams
                val savedA: Array[U64] = c.cur.typeArgs
                // MERGE (see genLlvmMakeEnum) so a field sub-expression referencing the
                // enclosing method's type params still grounds. This instance's OWN params go
                // LAST (highest index) so last-match resolveTy gives lexical shadowing when a
                // name collides (`Box[Box[I32]]` — both levels' param named `T`: the inner
                // must resolve to I32, not the outer Box[I32]).
                c.cur.typeParams = concatParams(add: savedP, base: sd.typeParams)
                c.cur.typeArgs = concatArgs(add: savedA, base: c.arena.types[gty].args)
                val v: LLVMValueRef = self.buildStructValue(c: inout c, sd: sd, sty: self.genStructTys[gslot], fields: fields, errOffset: typeStart)
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
                return v
            }
        }
        // a newtype over a struct inherits its factory (spec/10): `<Brand code=… />`
        // builds the underlying Rgb struct (identical representation). Resolve the
        // construction name to the underlying before the registered-struct lookup.
        mut val rtStart: U64 = typeStart
        mut val rtLen: U64 = typeLen
        // a grounded record/struct (`(v:T)` -> `(v:I32)` in a generic body): build the
        // concrete instance, not the i64-defaulting template. `gty` carries the grounding;
        // use its name for the registered-struct lookup (mirrors llvmFnRetTy).
        if gty != ty {
            if gty < c.arena.types.count() {
                val gtyT: TypeRef = c.arena.types[gty]
                rtStart = gtyT.nameStart
                rtLen = gtyT.nameLen
            }
        }
        val ntn: Bind = c.newtypeUnderName(start: rtStart, len: rtLen)
        if ntn.nameStart != rtStart || ntn.nameLen != rtLen {
            rtStart = ntn.nameStart
            rtLen = ntn.nameLen
        }
        val reg: U64 = self.structRegSlot(c: inout c, start: rtStart, len: rtLen)
        if reg >= self.genStructRefs.count() {
            // an un-grounded generic construction that neither top-down context, bottom-up
            // field inference, nor the expectedTy fallback could ground: the head names a
            // generic template with no concrete type arguments. Report it honestly at the
            // construction (front-end inference already handled every inferable case).
            if c.genericStructIndex(nameStart: rtStart, nameLen: rtLen) < c.arena.structs.count() {
                c.errorAt(offset: typeStart, msg: "cannot infer the type argument(s) of this generic construction; annotate it (e.g. `Type[Arg]`, or a typed binding / return type)")
            } else {
                c.errorAt(offset: typeStart, msg: "LLVM backend: construction of this type is not supported")
            }
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        return self.buildStructValue(c: inout c, sd: c.arena.structs[self.genStructDefs[reg]], sty: self.genStructTys[reg], fields: fields, errOffset: typeStart)
    }

    // The LLVM type of a strong reference-cell pointee T (from the instance's first type arg).
    inout fn refPointeeTy(c: inout Comp, refTy: U64) -> LLVMTypeRef {
        if c.isStrongRefInst(ref: refTy) {
            return self.llvmTypeOfRef(c: inout c, ref: c.arena.types[refTy].args[0])
        }
        return self.i64ty
    }

    // The strong reference-cell instance TypeRef of an expression that evaluates to
    // `Ref[T]` / `MutableRef[T]`, or 0 if it is not a strong ref-typed expression.
    inout fn exprRefTypeRef(c: inout Comp, id: U64) -> U64 {
        val r: U64 = self.exprTypeRef(c: inout c, id: id)
        if c.isStrongRefInst(ref: r) {
            return r
        }
        return 0U64
    }

    // Public Ref-family values are ordinary `{ cell }` wrappers. Runtime ARC and `->`
    // operations work on the intrinsic cell pointer, so unwrap the single field at the
    // backend boundary. During bootstrap an older std may still present Ref as a direct
    // opaque pointer; the type-kind guard keeps that representation valid too.
    inout fn refCellFromValue(v: LLVMValueRef) -> LLVMValueRef {
        if LLVMGetTypeKind(LLVMTypeOf(v)) == 10U32 {
            return LLVMBuildExtractValue(self.b, v, 0U64, anon())
        }
        return v
    }

    // The struct index of a strong-ref base's pointee T (for `->field` resolution), or
    // c.arena.structs.count() if the base isn't a strong ref to a registered struct.
    inout fn refPointeeStructIdx(c: inout Comp, base: U64) -> U64 {
        val r: U64 = self.exprRefTypeRef(c: inout c, id: base)
        if r != 0U64 {
            val t: TypeRef = c.arena.types[r]
            if t.args.count() > 0U64 {
                val pt: TypeRef = c.arena.types[t.args[0]]
                return self.localStructIdxFor(c: inout c, start: pt.nameStart, len: pt.nameLen)
            }
        }
        return c.arena.structs.count()
    }

    // Load a strong ref base's pointee struct VALUE (`*cell`) — the basis for `->field`.
    // The base rides genBorrowedArg: a non-place base (an element read `xs[i]`, a
    // Ref-returning call) arrives as an OWNED (+1) temporary and gets an anonymous
    // owned home (statement-end release) — reading through it must not strand that count.
    inout fn loadRefPointee(c: inout Comp, base: U64) -> LLVMValueRef {
        val r: U64 = self.exprRefTypeRef(c: inout c, id: base)
        val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: r)
        val cellPtr: LLVMValueRef = self.refCellFromValue(v: self.genBorrowedArg(c: inout c, argExpr: base))
        return LLVMBuildLoad2(self.b, pty, cellPtr, anon())
    }

    // Build a strong reference-cell value for the `refNew` / `mutableRefNew` intrinsic:
    // malloc a cell of sizeof(T), store the value into it, and return the cell pointer.
    inout fn genLlvmRefNew(c: inout Comp, valueExpr: U64) -> LLVMValueRef {
        val pr: U64 = self.exprTypeRef(c: inout c, id: valueExpr)
        mut val pty: LLVMTypeRef = self.exprLlvmType(c: inout c, id: valueExpr)
        if pr != 0U64 {
            pty = self.llvmTypeOfRef(c: inout c, ref: pr)
        }
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(pty), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        mut val v: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valueExpr)
        if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
            v = self.coerceInt(v: v, target: pty, unsigned: false)
        }
        // the cell OWNS its pointee (spec/03 value semantics): `refNew(value: place)`
        // must not alias the place's heap — the place's own drop would free it under
        // the cell, and the strong-0 pointee destroy would then double-free (#7). A
        // place pointee is CoW-shared/retained into the cell; a fresh value moves in.
        v = self.consumeIntoOwned(c: inout c, v: v, expr: valueExpr, typeRef: pr)
        LLVMBuildStore(self.b, v, cell)
        return cell
    }

    // Build a struct value of LLVM type `sty` from def `sd`: each declared field
    // (matched by name, or its default), under the active substitution env.
    inout fn buildStructValue(c: inout Comp, sd: StructDef, sty: LLVMTypeRef, fields: MakeFieldRange, errOffset: U64) -> LLVMValueRef {
        mut val agg: LLVMValueRef = LLVMGetUndef(sty)
        mut val fi: U64 = 0
        while fi < sd.fields.count() {
            val fld: FieldDef = sd.fields[fi]
            mut val provided: Bool = false
            mut val valExpr: U64 = 0
            mut val mi: U64 = 0
            while mi < fields.len {
                val field: MakeField = c.makeFieldAt(fields: fields, index: mi)
                if spansEqual(c: inout c, aStart: field.nameStart, aLen: field.nameLen, bStart: fld.nameStart, bLen: fld.nameLen) {
                    provided = true
                    valExpr = field.value
                    mi = fields.len
                } else {
                    mi += 1
                }
            }
            if !(provided) {
                if fld.hasDefault {
                    valExpr = fld.defaultVal
                } else {
                    c.errorAt(offset: errOffset, msg: "LLVM backend: missing struct field in construction")
                    return agg
                }
            }
            agg = LLVMBuildInsertValue(self.b, agg, self.genFieldValue(c: inout c, valExpr: valExpr, fld: fld), fi, anon())
            fi += 1
        }
        return agg
    }
}
