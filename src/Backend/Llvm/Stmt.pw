// Part of the LLVM backend (root: _.pw): statement emission (the genLlvmStmt dispatcher — one large function).

// ---- statement / block emission ----

pub impl LlvmCtx {

    // THE raw store-to-place choke point (audit-5 F8): every assignment that compiles
    // to a memory store — a local reassign, a struct-field / nested-place / Ref-pointee
    // -field write — routes here after resolving its place pointer, so the ownership
    // protocol lives in ONE place: seed the expected type (generic-instance RHS
    // construction inference), evaluate the RHS, width-coerce an int RHS to the place,
    // make the value owned (consumeIntoOwned — a place RHS is CoW-shared/retained),
    // destroy the place's PREVIOUS occupant through the classifier (spec/03: it loses
    // its owner), and store. The per-branch enumerations this replaces each dropped
    // classes: an enum local's and an array/String field's old value leaked on
    // reassign, and a nested-place generic-instance store neither released the old
    // value nor retained a place RHS (leak + UAF). The RHS is evaluated BEFORE the old
    // value is destroyed (a desugared compound RHS reads the target place); the new
    // value is made owned before the old is destroyed, so a same-place RHS can never
    // observe a transient dead value. `unsigned` is the caller's width-coercion
    // signedness (locKind- or type-name-derived); `destroyOld` is false only for a
    // moved-out local (no live previous value).
    inout fn storeToPlace(c: inout Comp, placePtr: LLVMValueRef, placeTy: LLVMTypeRef, typeRef: U64, valueExpr: U64, destroyOld: Bool, unsigned: Bool) {
        if c.isGenericInst(ref: typeRef) {
            self.expectedTy = typeRef
        }
        mut val rv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valueExpr)
        self.expectedTy = 0U64
        if LLVMGetTypeKind(LLVMTypeOf(rv)) == 8U32 {
            rv = self.coerceInt(v: rv, target: placeTy, unsigned: unsigned)
        }
        rv = self.consumeIntoOwned(c: inout c, v: rv, expr: valueExpr, typeRef: typeRef)
        if destroyOld {
            if c.arcNeedsRelease(ref: typeRef) {
                self.valueArc(c: inout c, v: LLVMBuildLoad2(self.b, placeTy, placePtr, anon()), typeRef: typeRef, retain: false)
            }
        }
        LLVMBuildStore(self.b, rv, placePtr)
    }

    // The grounded type ref of field `fld` for a store through base instance `baseRef`:
    // ground under the base's OWN instance env (setStructEnv — no-op for a non-generic
    // base), so a bare-T field of a generic-instance base classifies concretely. 0 when
    // unknown (an array field declared without a structured ref — its declared span
    // names the ELEMENT, not the array, so it must not be classified as one).
    inout fn fieldStoreTypeRef(c: inout Comp, fld: FieldDef, baseRef: U64) -> U64 {
        if fld.tyIsArray {
            if fld.ty == 0U64 {
                return 0U64
            }
        }
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val didSet: Bool = self.setStructEnv(c: inout c, ref: baseRef)
        val g: U64 = c.arcFieldTy(f: fld)
        if didSet {
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
        }
        return g
    }

    inout fn genLlvmStmt(c: inout Comp, id: U64) {
        if self.terminated {
            return
        }
        val s: Stmt = c.arena.stmts[id]
        match s {
            Stmt.Let(mutable: _, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                // extension-view invariance (spec/09): an explicit annotation `val v:
                // P#Ext = init` requires the initializer's view to match — no implicit
                // application/drop of a view.
                if ty != 0U64 {
                    if tyLen > 0U64 {
                        if c.arena.types[ty].viewExtId != self.exprViewExtId(c: inout c, id: init) {
                            c.errorAt(offset: c.exprOffset(id: init), msg: "extension view mismatch: the binding's `#Ext` view must match its initializer — apply or drop the view explicitly (`value#Ext` / `value#!Ext`)")
                        }
                    }
                }
                // inside an async fn, a binding whose initializer is `await e` suspends,
                // then stores the type-erased awaited value into the binding's frame
                // field. (A normal binding falls through to the shared handler, which
                // routes its storage to a frame field via asyncFrameSlotFor.)
                if self.curAsync {
                    if exprIsAwaitLL(c: inout c, id: init) {
                        match c.arena.exprs[init] {
                            Expr.Await(val operand) => {
                                self.genLlvmAsyncAwaitLet(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, ty: ty, operand: operand)
                            }
                            _ => {}
                        }
                        return
                    }
                }
                // an array binding: element type from the annotation, else the literal's
                // first element. Tracked so arr[i] / .append know the element layout.
                mut val isArr: Bool = tyIsArray
                mut val elemTy: LLVMTypeRef = self.i64ty
                mut val elemKind: U64 = 0
                if tyIsArray {
                    elemTy = self.llvmScalarTy(c: inout c, tyStart: tyStart, tyLen: tyLen)
                    // a compound element (`Array[Ref[Box]]`, `Array[Box[I32]]`) has a
                    // mangled tyStart llvmScalarTy can't resolve — use the element ref.
                    if ty != 0U64 {
                        if c.arena.types[ty].args.count() > 0U64 {
                            elemTy = self.llvmTypeOfRef(c: inout c, ref: c.arena.types[ty].args[0])
                        }
                    }
                    elemKind = kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen)
                } else {
                    match c.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            isArr = true
                            if elems.count() > 0U64 {
                                elemTy = self.exprLlvmType(c: inout c, id: elems[0])
                                elemKind = self.valueKind(c: inout c, id: elems[0])
                            }
                        }
                        _ => {
                            // an un-annotated array-valued initializer (`val bs = s.bytes()`):
                            // track it as an array so `bs.count()` / `bs[i]` resolve.
                            if self.exprIsArray(c: inout c, id: init) {
                                isArr = true
                                elemTy = self.arrElemTyOf(c: inout c, id: init)
                                elemKind = self.arrElemKindOf(c: inout c, id: init)
                            }
                        }
                    }
                }
                // an array literal initializer is built with the binding's element type
                // (so `Array[U16] = [300, 1000]` uses i16 elements, not i64-defaulted).
                mut val v: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
                mut val builtArr: Bool = false
                if isArr {
                    match c.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            // the annotation's element, GROUNDED under the active instance env
                            // (`result: Array[Item]` in a generic method with Item=I64 → I64) so
                            // an empty `[]` builds the same per-instance `%gs` as the grounded
                            // return/param type (else accumulator `Array[Item]` ≠ return `Array[I64]`).
                            mut val litElemRef: U64 = 0
                            if ty != 0U64 {
                                mut val gt: U64 = ty
                                if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
                                    gt = c.groundTypeRef(ref: ty)
                                }
                                if c.arena.types[gt].args.count() > 0U64 {
                                    litElemRef = c.arena.types[gt].args[0]
                                }
                            }
                            v = self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: elemTy, elemRef: litElemRef)
                            builtArr = true
                        }
                        _ => {}
                    }
                }
                // a scalar `any P` binding (spec/08): box the concrete initializer into
                // the existential fat pointer.
                if !(isArr) {
                    if ty != 0U64 {
                        if refIsAny(c: inout c, ref: ty) {
                            mut val lb: Bool = false
                            v = self.coerceToAnyIfNeeded(c: inout c, targetRef: ty, valueExpr: init, outBoxed: inout lb)
                            if !(lb) {
                                // initializer is already an `any P` value (`val s2 = s`):
                                // value semantics — copy the box if it is a place.
                                v = self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: init), valueExpr: init)
                            }
                            builtArr = true
                        }
                    }
                }
                // ground the annotation's type params under the active instance env (a
                // generic fn / method body): a generic-typed local (`mut val b: Bag[T]`
                // inside `Bag[T].of`, with T = I64) must resolve to the concrete instance
                // Bag[I64] — its construction (expectedTy) and later method dispatch need
                // the registered instance, not the template. A no-op outside a generic
                // body or for an already-concrete annotation.
                mut val gty: U64 = ty
                if ty != 0U64 {
                    if c.cur.typeParams.count() > 0U64 {
                        gty = c.groundTypeRef(ref: ty)
                    }
                }
                // the CLASSIFICATION ref for the tref arms below: the env-grounded
                // annotation when there is one, else the initializer's own TypeRef. The
                // class arms (Ref/WeakRef/Buffer/fn/Promise/any/enum) must classify an
                // UN-annotated local too — classifying only the annotation left
                // `val cell = tmp.cell` (a Ref-typed field read) ref-less, so its
                // scope-exit release never fired and the pointee leaked (deinit skipped);
                // same for an un-annotated enum-returning call's heap payload.
                mut val clsRef: U64 = gty
                if clsRef == 0U64 {
                    if tyLen == 0U64 {
                        if !(isArr) {
                            clsRef = self.exprTypeRef(c: inout c, id: init)
                        }
                    }
                }
                // covariant container erasure (`val aa: Array[any P] = arr`,
                // `val oa: Optional[any P] = o`): a value whose element/payload widens
                // concrete->`any P` is a genuine per-position REPACK (the layouts differ), not
                // an identity — box each widened position rather than share the value (spec/08).
                if !(builtArr) {
                    if gty != 0U64 {
                        mut val ceb: Bool = false
                        val cev: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: gty, valueExpr: init, outBoxed: inout ceb)
                        if ceb {
                            v = cev
                            builtArr = true
                        }
                    }
                }
                if !(builtArr) {
                    // a let annotation provides the expected type so an un-suffixed JSX
                    // generic construction (`val o: Optional[I64] = <Optional.Some … />`)
                    // infers its type args. Consumed by the construction (cleared there).
                    if !(isArr) {
                        self.expectedTy = gty
                    }
                    v = self.genLlvmExpr(c: inout c, id: init)
                    self.expectedTy = 0U64
                    // value semantics: binding an array from an existing place (`val b = a`).
                    // For a scalar-element array this SHARES the buffer + bumps its refcount
                    // (true CoW — the copy is deferred to the first mutation); a non-scalar
                    // element still eager-copies (Stage 2b).
                    if isArr {
                        v = self.shareArrayIfPlace(c: inout c, arrVal: v, elemTy: elemTy, valueExpr: init)
                    } else {
                        // a struct value bound from a place deep-copies its array fields
                        // (`val y = x` then `x.items[0]=…` leaves y.items unchanged; a
                        // generic field grounding to an array is handled under the env).
                        v = self.copyValueIfPlace(c: inout c, rv: v, valueExpr: init)
                    }
                }
                mut val kind: U64 = self.valueKind(c: inout c, id: init)
                if tyLen > 0U64 {
                    if !(isArr) {
                        v = self.coerceIntTo(c: inout c, v: v, tyStart: tyStart, tyLen: tyLen)
                        kind = kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen)
                    }
                }
                val lty: LLVMTypeRef = LLVMTypeOf(v)
                mut val sidx: U64 = self.exprStructIdx(c: inout c, id: init)
                if tyLen > 0U64 {
                    sidx = self.localStructIdxFor(c: inout c, start: tyStart, len: tyLen)
                    // a bare type-param annotation (`val v: T` in a generic body): the
                    // span "T" resolves to nothing — retry with the env-GROUNDED type's
                    // name so the local is a real struct to field access AND to ARC.
                    if sidx >= c.arena.structs.count() {
                        if gty != 0U64 {
                            sidx = self.localStructIdxFor(c: inout c, start: c.arena.types[gty].nameStart, len: c.arena.types[gty].nameLen)
                        }
                    }
                }
                // a generic struct instance (Box[I32]): point at the generic def (so
                // field access works) and track the instance ref for substitution. `gty`
                // is the env-grounded annotation, so a generic-param local in a generic
                // body (`b: Bag[T]` with T = I64) tracks the concrete Bag[I64].
                mut val tref: U64 = 0
                if c.isGenericInst(ref: gty) {
                    val gslot: U64 = self.genStructSlot(c: inout c, ref: gty)
                    if gslot < self.genStructRefs.count() {
                        sidx = self.genStructDefs[gslot]
                        tref = gty
                    } else {
                        if self.genEnumSlot(c: inout c, ref: gty) < self.genEnumRefs.count() {
                            tref = gty
                        }
                    }
                }
                // a `Ref[T]` local: track the instance so `->` resolves the pointee
                // struct (Ref isn't a registered generic struct/enum, so isGenericInst
                // is false for it). These class checks use `clsRef` — the env-GROUNDED
                // annotation, else the initializer's TypeRef: a bare-`T` annotation in a
                // generic body (`val v: T` with T = Ref[Cell]) and an un-annotated
                // Ref-valued binding (`val cell = tmp.cell`, `val r2 = r`) must both
                // classify as their concrete class — a ref-less local's scope-exit
                // release never fires (a leaked count per binding).
                if c.isRefInst(ref: clsRef) {
                    tref = clsRef
                }
                // a `WeakRef[T]` local: track the instance so `w.upgrade()` dispatches its
                // opaque-intrinsic method and the weak-count drop fires at scope exit.
                if c.isWeakRefInst(ref: clsRef) {
                    tref = clsRef
                }
                // a `Buffer[T]` local: track its type so the floor intrinsics recover
                // the element type T (the buffer is just a data pointer).
                if clsRef != 0U64 {
                    if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[clsRef].nameStart, len: c.arena.types[clsRef].nameLen, kw: "Buffer") {
                        tref = clsRef
                    }
                }
                // a function-value local (`val g: fn(n: I32) -> I32 = …` or un-annotated
                // `val g = makeAdder(...)`): track the fn TypeRef so a call `g(n: 4)`
                // resolves the closure signature AND the scope-exit drop releases the env.
                if c.isFnType(ref: clsRef) {
                    tref = clsRef
                }
                // an ANNOTATED binding whose grounded type owns heap but matched no
                // specific arm above (`val v: T` with T = a concrete struct/enum in a
                // generic body — ArrayIter.next's handover local): track the grounded
                // ref so the scope-exit drop classifies and releases it. Classifier-
                // gated, so scalar-grounded annotations stay ref-less as before.
                if tref == 0U64 {
                    if tyLen > 0U64 {
                        if gty != 0U64 {
                            if c.arcNeedsRelease(ref: gty) {
                                tref = gty
                            }
                        }
                    }
                }
                // an un-annotated binding to a call returning a generic instance
                // (`val r = makeBox()` -> Box[I64]): recover the instance ref + def so
                // `r.v` substitutes T. (typeOf can't see this local; resolve from AST.)
                if tref == 0U64 {
                    if tyLen == 0U64 {
                        if !(isArr) {
                            val rref: U64 = self.exprTypeRef(c: inout c, id: init)
                            if c.isGenericInst(ref: rref) {
                                val gslot2: U64 = self.genStructSlot(c: inout c, ref: rref)
                                if gslot2 < self.genStructRefs.count() {
                                    sidx = self.genStructDefs[gslot2]
                                    tref = rref
                                } else {
                                    if self.genEnumSlot(c: inout c, ref: rref) < self.genEnumRefs.count() {
                                        tref = rref
                                    }
                                }
                            }
                        }
                    }
                }
                // a non-generic enum local: track a bare TypeRef so `==`/match recover
                // the enum (typeOf can't see locals — c.cur.locals is unpopulated here)
                // AND the scope-exit drop releases a heap payload. The un-annotated
                // variant (`val m = makeMsg()`) classifies via the initializer's ref.
                if tref == 0U64 {
                    // declaration-keyed (enumIdxByName), not registration-keyed
                    // (enumRegSlot): registration is demand-driven, so a binding
                    // emitted before any construction of the enum missed here and
                    // its scope-exit release never ran (the drop path itself
                    // demand-registers via genEnumSlot).
                    if tyLen > 0U64 {
                        if c.enumIdxByName(start: tyStart, len: tyLen) < c.arena.enums.count() {
                            tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                        }
                    } else {
                        if clsRef != 0U64 {
                            if c.enumIdxByName(start: c.arena.types[clsRef].nameStart, len: c.arena.types[clsRef].nameLen) < c.arena.enums.count() {
                                tref = clsRef
                            }
                        }
                    }
                }
                // a primitive-int local (`val x: I64 = …`): track its type name so a
                // method on the primitive (`x#Ext.m()` / `x.hash[H](…)`) dispatches.
                if tref == 0U64 {
                    if tyLen > 0U64 {
                        if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
                            tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                        }
                    }
                }
                // a `newtype` local (`val u: UserId = …`, spec/10): track the newtype's own
                // TypeRef (not the underlying) so `exprTypeRef(u)` reports UserId — needed
                // for an unwrap re-tag `u as String` to recognise the operand is a newtype.
                if tref == 0U64 {
                    if tyLen > 0U64 {
                        if c.newtypeUnderRef(start: tyStart, len: tyLen) != 0U64 {
                            tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                        }
                    }
                }
                // an existential `any P` binding (annotated or inferred from an `any`
                // initializer): track its TypeRef so a bare `v.m()` dispatches dynamically
                // (exprTypeRef sees isAny) and the local's scope-exit drop releases its
                // owner count of the box (AnyBox class).
                if tref == 0U64 {
                    if clsRef != 0U64 {
                        if refIsAny(c: inout c, ref: clsRef) {
                            tref = clsRef
                        }
                    }
                }
                // a `Promise[T]` binding (annotated or inferred from an async call):
                // track its TypeRef so the local's scope-exit drop releases its owner
                // count of the promise cell (PromiseCell class).
                if tref == 0U64 {
                    if clsRef != 0U64 {
                        match c.arcClassOfRef(ref: clsRef) {
                            ArcClass.PromiseCell(inst: _) => { tref = clsRef }
                            _ => {}
                        }
                    }
                }
                // a `Type#Ext`-viewed binding: track the viewed TypeRef (carrying
                // viewExtId) so a bare `v.m()` resolves the extension (spec/09). The view
                // comes from an explicit annotation (`val v: P#Ext = …`) or, for an
                // un-annotated binding, the initializer's own view (`val v = p#Ext`).
                if tref == 0U64 {
                    if ty != 0U64 {
                        if c.arena.types[ty].viewExtId != 0U64 {
                            tref = ty
                        }
                    }
                }
                if tref == 0U64 {
                    val ir: U64 = self.exprTypeRef(c: inout c, id: init)
                    if ir != 0U64 {
                        if c.arena.types[ir].viewExtId != 0U64 {
                            tref = ir
                        }
                    }
                }
                // TOTAL-REF: a bare (non-generic) registered-struct local — `val p: Point = …`
                // (annotated) or `val p = mkPoint()` (un-annotated, RHS a struct). Formerly left
                // 0 (recovered via locStructIdx), which left exprTypeRef(p) unpopulated and forced
                // exprStructIdx onto the classifier fallback. Track the struct's TypeRef so the
                // struct-idx derives from the ref uniformly and valueArc dispatches on the local.
                if tref == 0U64 {
                    if !(isArr) {
                        if tyLen > 0U64 {
                            if self.localStructIdxFor(c: inout c, start: tyStart, len: tyLen) < c.arena.structs.count() {
                                tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                            }
                        } else {
                            if self.structIdxOfRef(c: inout c, ref: clsRef) < c.arena.structs.count() {
                                tref = clsRef
                            }
                        }
                    }
                }
                // a `mut val` captured by a closure (Swift-style reference capture) is
                // stored in a heap cell that outlives this scope; locPtr IS that cell, so
                // reads/writes and the closure share it. Otherwise a plain stack alloca.
                mut val slot: LLVMValueRef = LLVMConstNull(self.ptrty)
                mut val isCellHome: Bool = false
                if self.curAsync {
                    // inside an async fn, a (non-await) binding's storage is a frame
                    // field so its value survives later `await` suspensions.
                    slot = self.asyncFrameSlot(c: inout c, idx: self.asyncFieldNext)
                    self.asyncFieldNext = self.asyncFieldNext + 1
                } else {
                    if localIsBoxedCapture(c: inout c, start: nameStart, len: nameLen) {
                        slot = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(lty), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
                        isCellHome = true
                    } else {
                        slot = self.entryAlloca(ty: lty)
                    }
                }
                // E3 step (a): bind an array local as a generic-struct value — its
                // TypeRef is `Array[E]` and its struct index is Array's arena def — so
                // `exprTypeRef`/`exprStructIdx` resolve it through the uniform generic path
                // (Array's `{ptr}` value already IS `struct Array{data:Buffer[T]}`). This
                // lets the method-receiver synthesis and other use sites drop the
                // `exprIsArray` type-name dispatch (collections.md E3).
                if isArr {
                    if tref == 0U64 {
                        if tyIsArray {
                            tref = ty
                        } else {
                            val aer: U64 = self.arrayExprElemRef(c: inout c, arrayExpr: init)
                            if aer != 0U64 {
                                val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
                                mut val aargs: Array[U64] = []
                                aargs.append(aer)
                                tref = c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs />)
                            }
                        }
                    }
                    val asi: U64 = c.structDefByNameAny(start: c.kwSpan(kw: "Array", kwLen: 5U64).nameStart, len: 5U64)
                    if asi < c.arena.structs.count() {
                        sidx = asi
                    }
                }
                LLVMBuildStore(self.b, v, slot)
                self.pushLocalR(nameStart: nameStart, nameLen: nameLen, ptr: slot, ty: lty, kind: kind, structIdx: sidx, isArr: isArr, elemTy: elemTy, elemKind: elemKind, typeRef: tref)
                if isCellHome {
                    self.setLocalCellHome()
                }
                // (`val r2 = r` Ref share-retain now rides the general copyValueIfPlace path
                // above — consumeIntoOwned's Ref class rawbufRetains a Ref place — so no
                // bespoke retain here. Balanced by emitRefRelease at this local's drop.)
                // an array local: track the element's TypeRef so `ys[i]` recovers a
                // Ref / nested-array element. `ty` is the Array[E] ref, so the element
                // is its first arg.
                if isArr {
                    if tyIsArray {
                        if ty != 0U64 {
                            val at: TypeRef = c.arena.types[ty]
                            if at.args.count() > 0U64 {
                                self.setLocalElemTypeRef(ref: at.args[0])
                            }
                        }
                    } else {
                        // an un-annotated array initializer (`val bs = s.bytes()`): recover the
                        // element ref from the initializer so a later `bs.count()`/`bs[i]` can
                        // synthesize its `Array[elem]` receiver (the annotated path above gets
                        // it from the type ref; here only the initializer carries it).
                        val ier: U64 = self.arrayExprElemRef(c: inout c, arrayExpr: init)
                        if ier != 0U64 {
                            self.setLocalElemTypeRef(ref: ier)
                        }
                    }
                }
            }
            Stmt.Assign(val target, val value) => {
                // extension-view invariance (spec/09): an assignment must not implicitly
                // change a value's view — the target's and value's views must match.
                if self.exprViewExtId(c: inout c, id: target) != self.exprViewExtId(c: inout c, id: value) {
                    c.errorAt(offset: c.exprOffset(id: value), msg: "extension view mismatch: assignment must not implicitly apply or drop a `#Ext` view — adjust it explicitly (`value#Ext` / `value#!Ext`)")
                }
                // compound assign is desugared upstream in the Lower pass to `place = place OP
                // value` (spec/12, place-once), so every `Stmt.Assign` reaching the backend is a
                // plain `=` and the OP rides its operator witness like any binary — no primitive
                // open-code and no compound handling here.
                match c.arena.exprs[target] {
                    Expr.Ident(val start, val len) => {
                        val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                        if li < self.nLocals {
                            // an existential `any P` local: box a concrete conforming RHS
                            // into the fat pointer before the store (spec/08).
                            if refIsAny(c: inout c, ref: self.locTypeRef[li]) {
                                mut val ab: Bool = false
                                mut val arv: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: self.locTypeRef[li], valueExpr: value, outBoxed: inout ab)
                                if !(ab) {
                                    // any -> any: CoW-share the RHS place's box (rc++).
                                    arv = self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: value), valueExpr: value)
                                }
                                // release the DISPLACED existential's box — after the RHS is
                                // evaluated + retained, so a self-assign (`d = d`) stays
                                // balanced. A moved-out local has nothing to destroy.
                                if !(self.locMoved[li]) {
                                    self.emitAnyRelease(c: inout c, fat: LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon()))
                                }
                                LLVMBuildStore(self.b, arv, self.locPtr[li])
                                self.locMoved[li] = false
                                return
                            }
                            // route through the single store choke point. The old-value
                            // destroy is NOT gated on locOwned: that flag is about
                            // SCOPE-EXIT ownership, and the one assignable non-owned local
                            // — an `inout` param (its locPtr IS the caller's storage) —
                            // replaces the caller's value in place, so the old value must
                            // still die here. A local without a stored type ref falls back
                            // to its struct index's argless def ref so a struct old value
                            // still classifies.
                            mut val tr: U64 = self.locTypeRef[li]
                            if tr == 0U64 {
                                val osi: U64 = self.locStructIdx[li]
                                if osi < c.arena.structs.count() {
                                    tr = c.findOrAddTypeRef(nameStart: c.arena.structs[osi].nameStart, nameLen: c.arena.structs[osi].nameLen)
                                }
                            }
                            self.storeToPlace(c: inout c, placePtr: self.locPtr[li], placeTy: self.locTy[li], typeRef: tr, valueExpr: value, destroyOld: !(self.locMoved[li]), unsigned: self.locKind[li] == 3U64)
                            // the local re-owns the new value (clear any moved flag).
                            self.locMoved[li] = false
                        } else {
                            c.errorAt(offset: start, msg: "LLVM backend: assignment target must be a local (so far)")
                        }
                    }
                    Expr.Index(base: val ibase, index: val iindex) => {
                        // whole-element write `g[i] = v` (collections.md E3): route through the
                        // `IndexSet` witness uniformly — a Dictionary `d[k]=v` lowers to
                        // `d.insert(key:, value:)`; any type with an `indexSet` method (incl.
                        // Array, whose `indexSet` forwards to the Buffer floor) lowers to
                        // `g.indexSet(key: i, value: v)`. A compound `g[i] OP= v` arrives already
                        // desugared by Lower to `g[i] = g[i] OP v` with `i` bound to a temp (so it
                        // is evaluated once) — `value` here is that binary. The receiver is
                        // `inout`, so its place gateway runs the CoW privatization. (Place-based
                        // element mutation `arr[i].field = v` / `inout arr[i]` is handled elsewhere
                        // and keeps the place model, which addresses the backing directly.)
                        val ibsi: U64 = self.exprStructIdx(c: inout c, id: ibase)
                        if ibsi < c.arena.structs.count() {
                            if rangeEquals(bytes: c.arena.bytes, start: c.arena.structs[ibsi].nameStart, len: c.arena.structs[ibsi].nameLen, kw: "Dictionary") {
                                val m: U64 = c.synthDictMethod(recv: ibase, name: "insert", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: value)
                                self.genLlvmExpr(c: inout c, id: m)
                                return
                            }
                            if c.typeHasMethodNamed(typeStart: c.arena.structs[ibsi].nameStart, typeLen: c.arena.structs[ibsi].nameLen, name: "indexSet") {
                                val m: U64 = c.synthDictMethod(recv: ibase, name: "indexSet", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: value)
                                self.genLlvmExpr(c: inout c, id: m)
                                return
                            }
                        }
                        // every subscript-assign now resolves through the `IndexSet` witness
                        // above (Array included, since E3 binds arrays as generic-struct locals
                        // and `exprStructIdx` recovers the Array struct for any array place) —
                        // there is no built-in array element-store path and no `exprIsArray`
                        // type-name dispatch here. A base with no `indexSet` witness is an error.
                        c.errorAt(offset: c.exprOffset(id: ibase), msg: "LLVM backend: subscript assignment requires an `indexSet` method")
                        return
                    }
                    Expr.Field(base: val fbase, nameStart: val fnameStart, nameLen: val fnameLen) => {
                        // place mutation `base.field = v`: GEP into the base local's
                        // alloca + store (base must be an addressable struct local).
                        match c.arena.exprs[fbase] {
                            Expr.Ident(start: val bs, len: val bl) => {
                                val li: U64 = self.findLocal(c: inout c, start: bs, len: bl)
                                val sidx: U64 = self.exprStructIdx(c: inout c, id: fbase)
                                if li < self.nLocals && sidx < c.arena.structs.count() {
                                    val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: fnameStart, len: fnameLen)
                                    if fidx < c.arena.structs[sidx].fields.count() {
                                        val fld: FieldDef = c.arena.structs[sidx].fields[fidx]
                                        val gep: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.locTy[li], self.locPtr[li], fidx, anon())
                                        // a boxed (recursive) field (`a.next = <Optional.None/>`):
                                        // build the value (its type is the expected type, so a
                                        // bare construction infers its args), heap-allocate a
                                        // FRESH cell, and repoint the field — value semantics
                                        // (a copy that still points at the old cell is unchanged).
                                        // (boxed / generic-instance fields are non-numeric, so a
                                        // desugared compound `s.f = s.f OP v` only lands on the
                                        // scalar-field tail below, never here.)
                                        if c.fieldIsBoxed(f: fld) {
                                            self.expectedTy = fld.ty
                                            // a place RHS deep-copies (the fresh cell must own
                                            // its heap independently of the source binding).
                                            val bv: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: value), valueExpr: value)
                                            self.expectedTy = 0U64
                                            val oldCell: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, gep, anon())
                                            val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(LLVMTypeOf(bv)), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
                                            LLVMBuildStore(self.b, bv, cell)
                                            LLVMBuildStore(self.b, cell, gep)
                                            // drop the displaced owner AFTER the repoint (the
                                            // RHS was deep-copied above, so destroying the old
                                            // pointee cannot free anything the new cell shares).
                                            // Ground the pointee under the BASE instance env
                                            // (walker callers run inside witness bodies where
                                            // the env is already set; this site runs in the
                                            // enclosing fn's env).
                                            val savedP: Array[Bind] = c.cur.typeParams
                                            val savedA: Array[U64] = c.cur.typeArgs
                                            val didSet: Bool = self.setStructEnv(c: inout c, ref: self.locTypeRef[li])
                                            self.emitBoxedFieldRelease(c: inout c, cell: oldCell, f: fld)
                                            if didSet {
                                                c.cur.typeParams = savedP
                                                c.cur.typeArgs = savedA
                                            }
                                            return
                                        }
                                        // route through the single store choke point (owned
                                        // field write: the old occupant is destroyed, a place
                                        // RHS is CoW-shared/retained — `s.xs = a` then `a[0]=…`
                                        // must leave `s.xs` unchanged).
                                        val g: U64 = self.fieldStoreTypeRef(c: inout c, fld: fld, baseRef: self.locTypeRef[li])
                                        mut val pty: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                        if g != 0U64 {
                                            pty = self.llvmTypeOfRef(c: inout c, ref: g)
                                        }
                                        self.storeToPlace(c: inout c, placePtr: gep, placeTy: pty, typeRef: g, valueExpr: value, destroyOld: true, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen))
                                        return
                                    }
                                }
                                c.errorAt(offset: fnameStart, msg: "LLVM backend: field assignment only on a registered struct local (so far)")
                            }
                            _ => {
                                // a general place base (`arr[i].field = v`, get-modify-set):
                                // the base struct pointer via placePtrOf, then GEP the field.
                                val bsi: U64 = self.exprStructIdx(c: inout c, id: fbase)
                                mut val handled: Bool = false
                                if bsi < c.arena.structs.count() {
                                    val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fnameStart, len: fnameLen)
                                    if fidx < c.arena.structs[bsi].fields.count() {
                                        val baseTy: LLVMTypeRef = self.structLlvmTyOfExpr(c: inout c, structExpr: fbase, sidx: bsi)
                                        if LLVMIsNull(baseTy) == 0I32 {
                                            val fld: FieldDef = c.arena.structs[bsi].fields[fidx]
                                            val basePtr: LLVMValueRef = self.placePtrOfWrite(c: inout c, id: fbase)
                                            val gep: LLVMValueRef = LLVMBuildStructGEP2(self.b, baseTy, basePtr, fidx, anon())
                                            // route through the single store choke point. (The
                                            // enumeration this replaces stored a generic-instance
                                            // value RAW — no old-value release, no place-RHS
                                            // retain: `arr[i].r = otherRef` leaked the old cell
                                            // and double-freed the shared one.)
                                            val g2: U64 = self.fieldStoreTypeRef(c: inout c, fld: fld, baseRef: self.exprTypeRef(c: inout c, id: fbase))
                                            mut val pty2: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                            if g2 != 0U64 {
                                                pty2 = self.llvmTypeOfRef(c: inout c, ref: g2)
                                            }
                                            self.storeToPlace(c: inout c, placePtr: gep, placeTy: pty2, typeRef: g2, valueExpr: value, destroyOld: true, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen))
                                            handled = true
                                        }
                                    }
                                }
                                if !(handled) {
                                    c.errorAt(offset: c.exprOffset(id: target), msg: "LLVM backend: nested place assignment not yet supported")
                                }
                            }
                        }
                    }
                    Expr.Arrow(base: val abase, nameStart: val ans, nameLen: val anl) => {
                        // `r->field = v`: GEP into the Ref's cell (the pointee struct) and
                        // store. The cell is shared, so the write is visible through any
                        // alias of the Ref.
                        val psidx: U64 = self.refPointeeStructIdx(c: inout c, base: abase)
                        if psidx < c.arena.structs.count() {
                            val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: ans, len: anl)
                            if fidx < c.arena.structs[psidx].fields.count() {
                                val fld: FieldDef = c.arena.structs[psidx].fields[fidx]
                                val refTy: U64 = self.exprRefTypeRef(c: inout c, id: abase)
                                val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: refTy)
                                // genBorrowedArg: a non-place base (`ys[0]->v = …`) arrives
                                // as an owned (+1) temporary from the index witness — home
                                // it so the count releases at statement end (mirrors the
                                // placePtrStrict Deref/Arrow arms).
                                val cellPtr: LLVMValueRef = self.genBorrowedArg(c: inout c, argExpr: abase)
                                val gep: LLVMValueRef = LLVMBuildStructGEP2(self.b, pty, cellPtr, fidx, anon())
                                // route through the single store choke point: the shared
                                // pointee field's old occupant is destroyed (one owner
                                // drops) and a place RHS is retained (the field becomes a
                                // co-owner) — the write is visible through every alias of
                                // the Ref, but the assigned VALUE keeps value semantics.
                                mut val pref: U64 = 0
                                if c.isRefInst(ref: refTy) {
                                    pref = c.arena.types[refTy].args[0]
                                }
                                val g3: U64 = self.fieldStoreTypeRef(c: inout c, fld: fld, baseRef: pref)
                                mut val pty3: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                if g3 != 0U64 {
                                    pty3 = self.llvmTypeOfRef(c: inout c, ref: g3)
                                }
                                self.storeToPlace(c: inout c, placePtr: gep, placeTy: pty3, typeRef: g3, valueExpr: value, destroyOld: true, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen))
                                return
                            }
                        }
                        c.errorAt(offset: ans, msg: "LLVM backend: `->` assignment only on a Ref to a registered struct (so far)")
                    }
                    _ => {
                        c.errorAt(offset: c.exprOffset(id: target), msg: "LLVM backend: only simple `name = …` assignment is supported so far")
                    }
                }
            }
            Stmt.ExprStmt(val expr) => {
                // a bare `await e` inside an async fn is a suspension point with no value.
                if self.curAsync {
                    if exprIsAwaitLL(c: inout c, id: expr) {
                        match c.arena.exprs[expr] {
                            Expr.Await(val operand) => {
                                self.emitLlvmAsyncSuspend(c: inout c, operandId: operand)
                                self.asyncDropAwaitedTemp(c: inout c, operandId: operand)
                            }
                            _ => {}
                        }
                        return
                    }
                }
                val ignore: LLVMValueRef = self.genLlvmExpr(c: inout c, id: expr)
                // a DISCARDED owned result (a call / concat / construction in statement
                // position) has no owner — destroy it now, classifier-routed. A place
                // expression is a borrow (nothing owned was produced); a void result
                // carries no type ref and skips.
                if !(exprAliasesPlace(c: inout c, id: expr)) {
                    val dtr: U64 = self.exprTypeRef(c: inout c, id: expr)
                    if dtr != 0U64 {
                        if c.arcNeedsRelease(ref: dtr) {
                            self.valueArc(c: inout c, v: ignore, typeRef: dtr, retain: false)
                        }
                    }
                }
            }
            Stmt.Panic(val msg, offset: _) => {
                val ignore: LLVMValueRef = self.emitStrSink(c: inout c, rtName: "plew_panic_raw", rtId: 4U64, argExpr: msg)
                LLVMBuildUnreachable(self.b)
                self.terminated = true
            }
            Stmt.Return(val value, val hasValue, offset: _) => {
                // inside an async fn, `return` resolves `__self` (a `return await e`
                // first suspends), frees the frame, and returns from the resume fn.
                if self.curAsync {
                    self.genLlvmAsyncReturn(c: inout c, value: value, hasValue: hasValue)
                    return
                }
                val sentinel: U64 = 18446744073709551615U64
                if self.curIsMain {
                    // Plew `main` returns () -> C `int main` returns 0; drop live locals.
                    self.dropScope(c: inout c, fromMark: 0U64, excludeLi: sentinel)
                    LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32))
                } else {
                    if hasValue {
                        // extension-view invariance (spec/09): a returned value's view
                        // must match the declared return type's view.
                        if self.curRetRef != 0U64 {
                            if c.arena.types[self.curRetRef].viewExtId != self.exprViewExtId(c: inout c, id: value) {
                                c.errorAt(offset: c.exprOffset(id: value), msg: "extension view mismatch: the returned value's `#Ext` view must match the declared return type — apply or drop the view explicitly")
                            }
                        }
                        // an existential `any P` return (spec/08): box a concrete
                        // conforming value into the fat pointer.
                        if refIsAny(c: inout c, ref: self.curRetRef) {
                            mut val rb: Bool = false
                            mut val rav: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: self.curRetRef, valueExpr: value, outBoxed: inout rb)
                            if !(rb) {
                                // already an `any P` value: value-semantics copy of a place.
                                rav = self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: value), valueExpr: value)
                            }
                            mut val exLi: U64 = sentinel
                            match c.arena.exprs[value] {
                                Expr.Ident(start: val vs, len: val vl) => { exLi = self.findLocal(c: inout c, start: vs, len: vl) }
                                _ => {}
                            }
                            self.dropScope(c: inout c, fromMark: 0U64, excludeLi: exLi)
                            LLVMBuildRet(self.b, rav)
                            self.terminated = true
                            return
                        }
                        // the declared return type is the expected type, so a returned
                        // un-suffixed generic construction (`return <Optional.Some …/>`)
                        // infers its type args. Consumed by the construction.
                        self.expectedTy = self.curRetRef
                        mut val rv: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
                        mut val retLit: Bool = false
                        // an array-literal return (`return [10,20,30]` for `-> Array[I32]`)
                        // builds with the declared element type, not i64-defaulted.
                        if self.curRetTyLen > 0U64 {
                            match c.arena.exprs[value] {
                                Expr.Array(val elems) => {
                                    // an `Array[any P]` return literal: box each element.
                                    mut val retElemRef: U64 = 0
                                    mut val retElemTy: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: self.curRetTyStart, tyLen: self.curRetTyLen)
                                    if self.curRetRef != 0U64 {
                                        if c.arena.types[self.curRetRef].args.count() > 0U64 {
                                            retElemRef = c.arena.types[self.curRetRef].args[0]
                                            if refIsAny(c: inout c, ref: retElemRef) {
                                                retElemTy = self.anyTy
                                            }
                                        }
                                    }
                                    rv = self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: retElemTy, elemRef: retElemRef)
                                    retLit = true
                                }
                                _ => {}
                            }
                        }
                        if !(retLit) {
                            rv = self.genLlvmExpr(c: inout c, id: value)
                        }
                        self.expectedTy = 0U64
                        if self.curRetTyLen > 0U64 {
                            if !(retLit) {
                                rv = self.coerceIntTo(c: inout c, v: rv, tyStart: self.curRetTyStart, tyLen: self.curRetTyLen)
                            }
                        }
                        // scope-exit deinits for all live locals — but a returned local is
                        // moved out to the caller, so exclude it.
                        mut val excludeLi: U64 = sentinel
                        mut val moveOut: Bool = false
                        match c.arena.exprs[value] {
                            Expr.Ident(start: val s, len: val l) => {
                                val li: U64 = self.findLocal(c: inout c, start: s, len: l)
                                if li < self.nLocals {
                                    excludeLi = li
                                    // a returned OWNED local MOVES its value to the caller
                                    // for EVERY class (array/Ref/struct/enum/String alike):
                                    // its own count rides out unchanged — no retain — and
                                    // the local is excluded from the drop below, so the
                                    // move balances. That includes a `move` param (owned
                                    // here). A BORROWED binding (by-value param / capture /
                                    // global — flagged un-owned at bind) instead RETAINS
                                    // via consumeIntoOwned so the caller gets a fresh owner
                                    // — under the guaranteed (+0) arg convention the
                                    // caller-side binding keeps its own count, so returning
                                    // it without the retain would double-release.
                                    if self.locOwned[li] && !(self.locMoved[li]) {
                                        moveOut = true
                                    }
                                }
                            }
                            _ => {}
                        }
                        // value semantics: returning a non-moved PLACE (a field, a borrowed
                        // param) gives the caller an independent value (`return b.xs` then
                        // caller's `r[0]=…`). A moved local passes through unchanged.
                        if !(moveOut) {
                            rv = self.copyValueIfPlace(c: inout c, rv: rv, valueExpr: value)
                        }
                        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: excludeLi)
                        LLVMBuildRet(self.b, rv)
                    } else {
                        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: sentinel)
                        LLVMBuildRetVoid(self.b)
                    }
                }
                self.terminated = true
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                val condMark: U64 = self.nLocals
                val cv: LLVMValueRef = self.genLlvmCond(c: inout c, id: cond)
                // a condition is its own full expression (spec/03): its temporaries die
                // when the condition's evaluation ends — before the branch — never
                // spanning the then/else body.
                self.drainStmtTemps(c: inout c, fromMark: condMark)
                val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "then"))
                val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "endif"))
                mut val elseBB: LLVMBasicBlockRef = contBB
                if hasElse {
                    elseBB = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "else"))
                }
                LLVMBuildCondBr(self.b, cv, thenBB, elseBB)
                // then
                LLVMPositionBuilderAtEnd(self.b, thenBB)
                self.terminated = false
                self.genLlvmBlock(c: inout c, id: thenBlk)
                if !(self.terminated) {
                    LLVMBuildBr(self.b, contBB)
                }
                // else
                if hasElse {
                    LLVMPositionBuilderAtEnd(self.b, elseBB)
                    self.terminated = false
                    self.genLlvmBlock(c: inout c, id: elseBlk)
                    if !(self.terminated) {
                        LLVMBuildBr(self.b, contBB)
                    }
                }
                LLVMPositionBuilderAtEnd(self.b, contBB)
                self.terminated = false
            }
            Stmt.While(val cond, val body) => {
                val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "while.cond"))
                val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "while.body"))
                val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "while.end"))
                LLVMBuildBr(self.b, condBB)
                LLVMPositionBuilderAtEnd(self.b, condBB)
                val condMark: U64 = self.nLocals
                val cv: LLVMValueRef = self.genLlvmCond(c: inout c, id: cond)
                // the condition re-evaluates (and re-stores its temps) on every
                // iteration — its temporaries die here in the cond block (spec/03
                // statement-end destruction), not once after the loop, which would
                // leak every iteration's value but the last.
                self.drainStmtTemps(c: inout c, fromMark: condMark)
                LLVMBuildCondBr(self.b, cv, bodyBB, endBB)
                LLVMPositionBuilderAtEnd(self.b, bodyBB)
                self.terminated = false
                // `break` -> endBB, `continue` -> condBB (re-test) for this loop.
                self.pushLoop(breakBB: endBB, contBB: condBB, unwindMark: self.nLocals)
                self.genLlvmBlock(c: inout c, id: body)
                self.popLoop()
                if !(self.terminated) {
                    LLVMBuildBr(self.b, condBB)
                }
                LLVMPositionBuilderAtEnd(self.b, endBB)
                self.terminated = false
            }
            Stmt.Break(offset: _) => {
                if self.loopDepth > 0U64 {
                    // release this iteration's live body locals before leaving the loop
                    // (spec/03 deterministic destruction — a non-local exit drops the same
                    // set the body's fall-through would).
                    self.emitLoopExitDrops(c: inout c)
                    LLVMBuildBr(self.b, self.loopBreakBB[self.loopDepth - 1U64])
                    self.terminated = true
                } else {
                    compileErrorAt(line: 0, msg: "LLVM backend: `break` outside a loop")
                }
            }
            Stmt.Continue(offset: _) => {
                if self.loopDepth > 0U64 {
                    // release this iteration's live body locals before re-entering the loop
                    // header/step (else they leak each `continue`).
                    self.emitLoopExitDrops(c: inout c)
                    LLVMBuildBr(self.b, self.loopContBB[self.loopDepth - 1U64])
                    self.terminated = true
                } else {
                    compileErrorAt(line: 0, msg: "LLVM backend: `continue` outside a loop")
                }
            }
            Stmt.Match(val scrut, val arms) => {
                self.genLlvmMatch(c: inout c, scrut: scrut, arms: arms)
            }
            Stmt.Give(val value) => {
                // yield the enclosing value-position block's result (IfExpr reads it). The
                // result MOVES out of the block, so an array/struct PLACE is made independent
                // of this block's locals (else the block's drop frees its buffer under giveValue).
                self.giveValue = self.copyValueIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: value), valueExpr: value)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
                if isStruct {
                    self.genLlvmForArrayStruct(c: inout c, patStart: patStart, patLen: patLen, iter: iter, binds: binds, body: body)
                } else {
                    if isRange {
                        self.genLlvmForRange(c: inout c, varStart: varStart, varLen: varLen, varTyStart: varTyStart, varTyLen: varTyLen, inclusive: inclusive, lo: iter, hi: rangeHi, body: body)
                    } else {
                        // collections.md E3: a non-range `for x in e` rides the `Iterable`
                        // protocol uniformly — an array is no longer a special case (it carries
                        // `recvRef = Array[E]`, so genLlvmForIterable -> genLlvmForGenIterable
                        // calls Array's `iterator()` witness and drives `next()`).
                        val noBinds: Array[Bind] = []
                        self.genLlvmForIterable(c: inout c, varStart: varStart, varLen: varLen, patStart: 0U64, patLen: 0U64, binds: noBinds, iter: iter, body: body)
                    }
                }
            }
            _ => {
                compileErrorAt(line: 0, msg: "LLVM backend: statement form not yet supported")
            }
        }
    }
}
