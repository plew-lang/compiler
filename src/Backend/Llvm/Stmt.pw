// Part of the LLVM backend (root: _.pw): statement emission (the genLlvmStmt dispatcher — one large function).

// ---- statement / block emission ----

pub impl LlvmCtx {
    inout fn genLlvmStmt(c: inout Comp, id: U64) {
        if self.terminated {
            return
        }
        val s: Stmt = c.arena.stmts[id]
        match s {
            Stmt.Let(mutable: _, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                // extension-view invariance (spec/09): an explicit annotation `val v:
                // P#Ext = init` requires the initializer's view to match — no implicit
                // application/drop of a view.
                if ty != 0U64 {
                    if tyLen > 0U64 {
                        if c.arena.types[ty].viewExtId != self.exprViewExtId(c: inout c, id: init) {
                            compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: init)), msg: "extension view mismatch: the binding's `#Ext` view must match its initializer — apply or drop the view explicitly (`value#Ext` / `value#!Ext`)")
                        }
                    }
                }
                // inside an async fn, a binding whose initializer is `await e` suspends,
                // then stores the type-erased awaited value into the binding's frame
                // field. (A normal binding falls through to the shared handler, which
                // routes its storage to a frame field via asyncFrameSlotFor.)
                if self.curAsync {
                    if exprIsAwaitLL(c: inout c, id: init) {
                        match c.arena.exprs[init] {
                            Expr.Await(val operand) => {
                                self.genLlvmAsyncAwaitLet(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, ty: ty, operand: operand)
                            }
                            _ => {}
                        }
                        return
                    }
                }
                // an array binding: element type from the annotation, else the literal's
                // first element. Tracked so arr[i] / .append know the element layout.
                mut val isArr: Bool = tyIsArray
                mut val elemTy: LLVMTypeRef = self.i64ty
                mut val elemKind: U64 = 0
                if tyIsArray {
                    elemTy = self.llvmScalarTy(c: inout c, tyStart: tyStart, tyLen: tyLen)
                    // a compound element (`Array[Ref[Box]]`, `Array[Box[I32]]`) has a
                    // mangled tyStart llvmScalarTy can't resolve — use the element ref.
                    if ty != 0U64 {
                        if c.arena.types[ty].args.count > 0U64 {
                            elemTy = self.llvmTypeOfRef(c: inout c, ref: c.arena.types[ty].args[0])
                        }
                    }
                    elemKind = kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen)
                } else {
                    match c.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            isArr = true
                            if elems.count > 0U64 {
                                elemTy = self.exprLlvmType(c: inout c, id: elems[0])
                                elemKind = self.valueKind(c: inout c, id: elems[0])
                            }
                        }
                        _ => {
                            // an un-annotated array-valued initializer (`val bs = s.bytes`):
                            // track it as an array so `bs.count` / `bs[i]` resolve.
                            if self.exprIsArray(c: inout c, id: init) {
                                isArr = true
                                elemTy = self.arrElemTyOf(c: inout c, id: init)
                                elemKind = self.arrElemKindOf(c: inout c, id: init)
                            }
                        }
                    }
                }
                // an array literal initializer is built with the binding's element type
                // (so `Array[U16] = [300, 1000]` uses i16 elements, not i64-defaulted).
                mut val v: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
                mut val builtArr: Bool = false
                if isArr {
                    match c.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            mut val litElemRef: U64 = 0
                            if ty != 0U64 {
                                if c.arena.types[ty].args.count > 0U64 {
                                    litElemRef = c.arena.types[ty].args[0]
                                }
                            }
                            v = self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: elemTy, elemRef: litElemRef)
                            builtArr = true
                        }
                        _ => {}
                    }
                }
                // a scalar `any P` binding (spec/08): box the concrete initializer into
                // the existential fat pointer.
                if !(isArr) {
                    if ty != 0U64 {
                        if refIsAny(c: inout c, ref: ty) {
                            mut val lb: Bool = false
                            v = self.coerceToAnyIfNeeded(c: inout c, targetRef: ty, valueExpr: init, outBoxed: inout lb)
                            if !(lb) {
                                // initializer is already an `any P` value (`val s2 = s`):
                                // value semantics — copy the box if it is a place.
                                v = self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: init), valueExpr: init)
                            }
                            builtArr = true
                        }
                    }
                }
                if !(builtArr) {
                    // a let annotation provides the expected type so an un-suffixed JSX
                    // generic construction (`val o: Optional[I64] = <Optional.Some … />`)
                    // infers its type args. Consumed by the construction (cleared there).
                    if !(isArr) {
                        self.expectedTy = ty
                    }
                    v = self.genLlvmExpr(c: inout c, id: init)
                    self.expectedTy = 0U64
                    // value semantics: binding an array from an existing place (`val b = a`)
                    // copies the buffer so later mutation through one binding leaves the
                    // other unchanged (CoW, here eager).
                    if isArr {
                        if arrayExprIsPlace(c: inout c, id: init) {
                            v = self.copyArrayValue(c: inout c, arrVal: v, elemTy: elemTy)
                        }
                    } else {
                        // a struct value bound from a place deep-copies its array fields
                        // (`val y = x` then `x.items[0]=…` leaves y.items unchanged; a
                        // generic field grounding to an array is handled under the env).
                        v = self.copyValueIfPlace(c: inout c, rv: v, valueExpr: init)
                    }
                }
                mut val kind: U64 = self.valueKind(c: inout c, id: init)
                if tyLen > 0U64 {
                    if !(isArr) {
                        v = self.coerceIntTo(c: inout c, v: v, tyStart: tyStart, tyLen: tyLen)
                        kind = kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen)
                    }
                }
                val lty: LLVMTypeRef = LLVMTypeOf(v)
                mut val sidx: U64 = self.exprStructIdx(c: inout c, id: init)
                if tyLen > 0U64 {
                    sidx = self.localStructIdxFor(c: inout c, start: tyStart, len: tyLen)
                }
                // a generic struct instance (Box[I32]): point at the generic def (so
                // field access works) and track the instance ref for substitution.
                mut val tref: U64 = 0
                if c.isGenericInst(ref: ty) {
                    val gslot: U64 = self.genStructSlot(c: inout c, ref: ty)
                    if gslot < self.genStructRefs.count {
                        sidx = self.genStructDefs[gslot]
                        tref = ty
                    } else {
                        if self.genEnumSlot(c: inout c, ref: ty) < self.genEnumRefs.count {
                            tref = ty
                        }
                    }
                }
                // a `Ref[T]` local: track the instance so `->` resolves the pointee
                // struct (Ref isn't a registered generic struct/enum, so isGenericInst
                // is false for it).
                if c.isRefInst(ref: ty) {
                    tref = ty
                }
                // a `RawBuffer[T]` local: track its type so the raw* intrinsics recover
                // the element type T (the buffer is just a data pointer).
                if ty != 0U64 {
                    if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[ty].nameStart, len: c.arena.types[ty].nameLen, kw: "RawBuffer") {
                        tref = ty
                    }
                }
                // a function-value local (`val g: fn(n: I32) -> I32 = …`): track the fn
                // TypeRef so a call `g(n: 4)` resolves the closure signature.
                if c.isFnType(ref: ty) {
                    tref = ty
                }
                // an un-annotated binding to a call returning a generic instance
                // (`val r = makeBox()` -> Box[I64]): recover the instance ref + def so
                // `r.v` substitutes T. (typeOf can't see this local; resolve from AST.)
                if tref == 0U64 {
                    if tyLen == 0U64 {
                        if !(isArr) {
                            val rref: U64 = self.exprResultRef(c: inout c, id: init)
                            if c.isGenericInst(ref: rref) {
                                val gslot2: U64 = self.genStructSlot(c: inout c, ref: rref)
                                if gslot2 < self.genStructRefs.count {
                                    sidx = self.genStructDefs[gslot2]
                                    tref = rref
                                } else {
                                    if self.genEnumSlot(c: inout c, ref: rref) < self.genEnumRefs.count {
                                        tref = rref
                                    }
                                }
                            }
                        }
                    }
                }
                // a non-generic enum local: track a bare TypeRef so `==`/match recover
                // the enum (typeOf can't see locals — c.cur.locals is unpopulated here).
                if tref == 0U64 {
                    if tyLen > 0U64 {
                        if self.enumRegSlot(c: inout c, start: tyStart, len: tyLen) < self.enumIdxs.count {
                            tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                        }
                    }
                }
                // a primitive-int local (`val x: I64 = …`): track its type name so a
                // method on the primitive (`x#Ext.m()` / `x.hash[H](…)`) dispatches.
                if tref == 0U64 {
                    if tyLen > 0U64 {
                        if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
                            tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                        }
                    }
                }
                // a `newtype` local (`val u: UserId = …`, spec/10): track the newtype's own
                // TypeRef (not the underlying) so `exprTypeRef(u)` reports UserId — needed
                // for an unwrap re-tag `u as String` to recognise the operand is a newtype.
                if tref == 0U64 {
                    if tyLen > 0U64 {
                        if c.newtypeUnderRef(start: tyStart, len: tyLen) != 0U64 {
                            tref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                        }
                    }
                }
                // an existential `any P` binding: track its TypeRef so a bare `v.m()`
                // dispatches dynamically (exprTypeRef sees isAny).
                if tref == 0U64 {
                    if ty != 0U64 {
                        if refIsAny(c: inout c, ref: ty) {
                            tref = ty
                        }
                    }
                }
                // a `Type#Ext`-viewed binding: track the viewed TypeRef (carrying
                // viewExtId) so a bare `v.m()` resolves the extension (spec/09). The view
                // comes from an explicit annotation (`val v: P#Ext = …`) or, for an
                // un-annotated binding, the initializer's own view (`val v = p#Ext`).
                if tref == 0U64 {
                    if ty != 0U64 {
                        if c.arena.types[ty].viewExtId != 0U64 {
                            tref = ty
                        }
                    }
                }
                if tref == 0U64 {
                    val ir: U64 = self.exprTypeRef(c: inout c, id: init)
                    if ir != 0U64 {
                        if c.arena.types[ir].viewExtId != 0U64 {
                            tref = ir
                        }
                    }
                }
                // a `mut val` captured by a closure (Swift-style reference capture) is
                // stored in a heap cell that outlives this scope; locPtr IS that cell, so
                // reads/writes and the closure share it. Otherwise a plain stack alloca.
                mut val slot: LLVMValueRef = LLVMConstNull(self.ptrty)
                if self.curAsync {
                    // inside an async fn, a (non-await) binding's storage is a frame
                    // field so its value survives later `await` suspensions.
                    slot = self.asyncFrameSlot(c: inout c, idx: self.asyncFieldNext)
                    self.asyncFieldNext = self.asyncFieldNext + 1
                } else {
                    if localIsBoxedCapture(c: inout c, start: nameStart, len: nameLen) {
                        slot = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(lty), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
                    } else {
                        slot = self.entryAlloca(ty: lty)
                    }
                }
                LLVMBuildStore(self.b, v, slot)
                self.pushLocalR(nameStart: nameStart, nameLen: nameLen, ptr: slot, ty: lty, kind: kind, structIdx: sidx, isArr: isArr, elemTy: elemTy, elemKind: elemKind, typeRef: tref)
                // sharing a Ref to a deinit-bearing pointee (`val r2 = r`): retain the
                // shared cell so the pointee deinits only when the LAST owner drops.
                if self.refDeinitPointeeSidx(c: inout c, refTy: tref) < c.arena.structs.count {
                    if arrayExprIsPlace(c: inout c, id: init) {
                        self.rawbufRetain(c: inout c, cell: v)
                    }
                }
                // an array-of-struct local (`store: Array[Box]`): track the element struct
                // so `store[i].field` resolves the element (tyStart names the element type).
                if isArr {
                    if tyLen > 0U64 {
                        val esi: U64 = self.localStructIdxFor(c: inout c, start: tyStart, len: tyLen)
                        if esi < c.arena.structs.count {
                            self.setLocalElemStruct(esi: esi)
                        }
                    }
                    // track the element's TypeRef so `ys[i]` recovers a Ref / nested-array
                    // element. `ty` is the Array[E] ref, so the element is its first arg.
                    if tyIsArray {
                        if ty != 0U64 {
                            val at: TypeRef = c.arena.types[ty]
                            if at.args.count > 0U64 {
                                self.setLocalElemTypeRef(ref: at.args[0])
                            }
                        }
                    }
                }
            }
            Stmt.Assign(val op, val target, val value) => {
                // extension-view invariance (spec/09): an assignment must not implicitly
                // change a value's view — the target's and value's views must match.
                if self.exprViewExtId(c: inout c, id: target) != self.exprViewExtId(c: inout c, id: value) {
                    compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: value)), msg: "extension view mismatch: assignment must not implicitly apply or drop a `#Ext` view — adjust it explicitly (`value#Ext` / `value#!Ext`)")
                }
                match c.arena.exprs[target] {
                    Expr.Ident(val start, val len) => {
                        val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                        if li < self.nLocals {
                            // an existential `any P` local: box a concrete conforming RHS
                            // into the fat pointer before the store (spec/08).
                            if refIsAny(c: inout c, ref: self.locTypeRef[li]) {
                                mut val ab: Bool = false
                                mut val arv: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: self.locTypeRef[li], valueExpr: value, outBoxed: inout ab)
                                if !(ab) {
                                    // any -> any: value-semantics copy of a place.
                                    arv = self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: value), valueExpr: value)
                                }
                                LLVMBuildStore(self.b, arv, self.locPtr[li])
                                return
                            }
                            // a generic-instance local (`r: Result[I64, String]`): pass its
                            // tracked TypeRef as the expected type so an un-suffixed RHS
                            // construction (`r = <Result.Err error="x" />`) infers the
                            // instance's type args (genLlvmMakeEnum / genLlvmMake consume it).
                            if c.isGenericInst(ref: self.locTypeRef[li]) {
                                self.expectedTy = self.locTypeRef[li]
                            }
                            mut val rv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: value)
                            self.expectedTy = 0U64
                            // coerce the value to the local's width (a context-less
                            // literal may default wider/narrower).
                            if LLVMGetTypeKind(LLVMTypeOf(rv)) == 8U32 {
                                rv = self.coerceInt(v: rv, target: self.locTy[li], unsigned: self.locKind[li] == 3U64)
                            }
                            // value semantics: a plain assignment from an array/struct place
                            // (`b = a`) copies so the two bindings stay independent.
                            if op == opAssign() {
                                rv = self.copyValueIfPlace(c: inout c, rv: rv, valueExpr: value)
                            }
                            if op == opAssign() {
                                // reassigning a unique local deinits its PREVIOUS value
                                // first (spec/03) — load and destroy the old, unless the
                                // local was moved out (no live value) or not owned.
                                if self.locOwned[li] {
                                    if !(self.locMoved[li]) {
                                        val osi: U64 = self.locStructIdx[li]
                                        if osi < c.arena.structs.count {
                                            if self.structNeedsDeinit(c: inout c, sidx: osi) {
                                                self.emitDeinitValue(c: inout c, v: LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon()), sidx: osi)
                                            }
                                        }
                                    }
                                }
                                // the local re-owns the new value (clear any moved flag).
                                self.locMoved[li] = false
                                LLVMBuildStore(self.b, rv, self.locPtr[li])
                            } else {
                                val cur: LLVMValueRef = LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon())
                                mut val nv: LLVMValueRef = LLVMConstNull(self.ptrty)
                                if self.valueKind(c: inout c, id: target) == 4U64 {
                                    // a float local: the compound op is an IEEE float op.
                                    nv = self.buildF64BinOp(op: compoundBinOp(op: op), l: cur, r: rv)
                                } else {
                                    nv = self.buildBinOpChecked(c: inout c, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: self.valueKind(c: inout c, id: target) == 3U64)
                                }
                                LLVMBuildStore(self.b, nv, self.locPtr[li])
                            }
                        } else {
                            compileErrorAt(line: c.lineOf(offset: start), msg: "LLVM backend: assignment target must be a local (so far)")
                        }
                    }
                    Expr.Index(base: val ibase, index: val iindex) => {
                        // place mutation `arr[i] = v` / `arr[i] OP= v`: bounds-checked
                        // element pointer + store (the buffer is shared; no CoW yet).
                        // A user IndexSet-impl subscript desugars `g[i] = v` to
                        // `g.indexSet(key: i, value: v)` via the IndexSet witness (the
                        // compound form `g[i] OP= v` desugars `v` to `g[i] OP v` first).
                        if !(self.exprIsArray(c: inout c, id: ibase)) {
                            val ibsi: U64 = self.exprStructIdx(c: inout c, id: ibase)
                            if ibsi < c.arena.structs.count {
                                // a Dictionary `d[k] = v` lowers to `d.insert(key:, value:)`.
                                if rangeEquals(bytes: c.arena.bytes, start: c.arena.structs[ibsi].nameStart, len: c.arena.structs[ibsi].nameLen, kw: "Dictionary") {
                                    // `d[k] = v` -> d.insert(key: k, value: v). A compound
                                    // `d[k] OP= v` first builds the new value `d[k] OP v` (the
                                    // missing-key read panics, like a bare `d[k]`), then inserts.
                                    mut val insVal: U64 = value
                                    if op != opAssign() {
                                        val getExpr: U64 = c.pushExpr(e: <Expr.Index base=ibase index=iindex />)
                                        insVal = c.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=getExpr rhs=value />)
                                    }
                                    val m: U64 = c.synthDictMethod(recv: ibase, name: "insert", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: insVal)
                                    self.genLlvmExpr(c: inout c, id: m)
                                    return
                                }
                                if c.typeHasMethodNamed(typeStart: c.arena.structs[ibsi].nameStart, typeLen: c.arena.structs[ibsi].nameLen, name: "indexSet") {
                                    mut val rhsExpr: U64 = value
                                    if op != opAssign() {
                                        val getExpr: U64 = c.pushExpr(e: <Expr.Index base=ibase index=iindex />)
                                        rhsExpr = c.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=getExpr rhs=value />)
                                    }
                                    val m: U64 = c.synthDictMethod(recv: ibase, name: "indexSet", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: rhsExpr)
                                    self.genLlvmExpr(c: inout c, id: m)
                                    return
                                }
                            }
                            compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: ibase)), msg: "LLVM backend: user IndexSet subscript needs an `indexSet` method")
                            return
                        }
                        val elemTy: LLVMTypeRef = self.arrElemTyOf(c: inout c, id: ibase)
                        val arr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: ibase)
                        val data: LLVMValueRef = LLVMBuildExtractValue(self.b, arr, 0U64, anon())
                        val count: LLVMValueRef = LLVMBuildExtractValue(self.b, arr, 1U64, anon())
                        val idx: LLVMValueRef = self.genLlvmExpr(c: inout c, id: iindex)
                        self.emitBoundsCheck(c: inout c, idx: idx, count: count)
                        val ep: LLVMValueRef = self.arrElemPtr(elemTy: elemTy, data: data, idx: idx)
                        val rv: LLVMValueRef = self.coerceElem(v: self.genLlvmExpr(c: inout c, id: value), elemTy: elemTy)
                        if op == opAssign() {
                            LLVMBuildStore(self.b, rv, ep)
                        } else {
                            val cur: LLVMValueRef = LLVMBuildLoad2(self.b, elemTy, ep, anon())
                            LLVMBuildStore(self.b, self.buildBinOpChecked(c: inout c, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: self.valueKind(c: inout c, id: target) == 3U64), ep)
                        }
                    }
                    Expr.Field(base: val fbase, nameStart: val fnameStart, nameLen: val fnameLen) => {
                        // place mutation `base.field = v`: GEP into the base local's
                        // alloca + store (base must be an addressable struct local).
                        match c.arena.exprs[fbase] {
                            Expr.Ident(start: val bs, len: val bl) => {
                                val li: U64 = self.findLocal(c: inout c, start: bs, len: bl)
                                val sidx: U64 = self.exprStructIdx(c: inout c, id: fbase)
                                if li < self.nLocals && sidx < c.arena.structs.count {
                                    val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: fnameStart, len: fnameLen)
                                    if fidx < c.arena.structs[sidx].fields.count {
                                        val fld: FieldDef = c.arena.structs[sidx].fields[fidx]
                                        val gep: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.locTy[li], self.locPtr[li], fidx, anon())
                                        // a boxed (recursive) field (`a.next = <Optional.None/>`):
                                        // build the value (its type is the expected type, so a
                                        // bare construction infers its args), heap-allocate a
                                        // FRESH cell, and repoint the field — value semantics
                                        // (a copy that still points at the old cell is unchanged).
                                        if op == opAssign() {
                                            if c.fieldIsBoxed(f: fld) {
                                                self.expectedTy = fld.ty
                                                val bv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: value)
                                                self.expectedTy = 0U64
                                                val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(LLVMTypeOf(bv)), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
                                                LLVMBuildStore(self.b, bv, cell)
                                                LLVMBuildStore(self.b, cell, gep)
                                                return
                                            }
                                            val gfr: U64 = fieldGenInstRef(c: inout c, fld: fld)
                                            if gfr != 0U64 {
                                                self.expectedTy = gfr
                                                val gv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: value)
                                                self.expectedTy = 0U64
                                                LLVMBuildStore(self.b, gv, gep)
                                                return
                                            }
                                        }
                                        mut val rv: LLVMValueRef = self.coerceIntTo(c: inout c, v: self.genLlvmExpr(c: inout c, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                        if op == opAssign() {
                                            // value semantics (spec/03): assigning an array/struct
                                            // PLACE into a field copies, so the field and the RHS
                                            // binding stay independent (`s.xs = a` then `a[0]=…`
                                            // must leave `s.xs` unchanged) — the Ident-target path
                                            // already does this; a field target must too.
                                            rv = self.copyValueIfPlace(c: inout c, rv: rv, valueExpr: value)
                                            LLVMBuildStore(self.b, rv, gep)
                                        } else {
                                            val ftype: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                            val cur: LLVMValueRef = LLVMBuildLoad2(self.b, ftype, gep, anon())
                                            LLVMBuildStore(self.b, self.buildBinOpChecked(c: inout c, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen)), gep)
                                        }
                                        return
                                    }
                                }
                                compileErrorAt(line: c.lineOf(offset: fnameStart), msg: "LLVM backend: field assignment only on a registered struct local (so far)")
                            }
                            _ => {
                                // a general place base (`arr[i].field = v`, get-modify-set):
                                // the base struct pointer via placePtrOf, then GEP the field.
                                val bsi: U64 = self.exprStructIdx(c: inout c, id: fbase)
                                mut val handled: Bool = false
                                if bsi < c.arena.structs.count {
                                    val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fnameStart, len: fnameLen)
                                    if fidx < c.arena.structs[bsi].fields.count {
                                        val baseTy: LLVMTypeRef = self.structLlvmTyOfExpr(c: inout c, structExpr: fbase, sidx: bsi)
                                        if LLVMIsNull(baseTy) == 0I32 {
                                            val fld: FieldDef = c.arena.structs[bsi].fields[fidx]
                                            val basePtr: LLVMValueRef = self.placePtrOf(c: inout c, id: fbase)
                                            val gep: LLVMValueRef = LLVMBuildStructGEP2(self.b, baseTy, basePtr, fidx, anon())
                                            val gfr2: U64 = fieldGenInstRef(c: inout c, fld: fld)
                                            if op == opAssign() && gfr2 != 0U64 {
                                                self.expectedTy = gfr2
                                                val gv2: LLVMValueRef = self.genLlvmExpr(c: inout c, id: value)
                                                self.expectedTy = 0U64
                                                LLVMBuildStore(self.b, gv2, gep)
                                                return
                                            }
                                            mut val rv: LLVMValueRef = self.coerceIntTo(c: inout c, v: self.genLlvmExpr(c: inout c, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                            if op == opAssign() {
                                                // value semantics: copy an array/struct PLACE RHS
                                                // (`arr[i].xs = a`) so the field stays independent.
                                                rv = self.copyValueIfPlace(c: inout c, rv: rv, valueExpr: value)
                                                LLVMBuildStore(self.b, rv, gep)
                                            } else {
                                                val ftype: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                                val cur: LLVMValueRef = LLVMBuildLoad2(self.b, ftype, gep, anon())
                                                LLVMBuildStore(self.b, self.buildBinOpChecked(c: inout c, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen)), gep)
                                            }
                                            handled = true
                                        }
                                    }
                                }
                                if !(handled) {
                                    compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: target)), msg: "LLVM backend: nested place assignment not yet supported")
                                }
                            }
                        }
                    }
                    Expr.Arrow(base: val abase, nameStart: val ans, nameLen: val anl) => {
                        // `r->field = v`: GEP into the Ref's cell (the pointee struct) and
                        // store. The cell is shared, so the write is visible through any
                        // alias of the Ref.
                        val psidx: U64 = self.refPointeeStructIdx(c: inout c, base: abase)
                        if psidx < c.arena.structs.count {
                            val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: ans, len: anl)
                            if fidx < c.arena.structs[psidx].fields.count {
                                val fld: FieldDef = c.arena.structs[psidx].fields[fidx]
                                val pty: LLVMTypeRef = self.refPointeeTy(c: inout c, refTy: self.exprRefTypeRef(c: inout c, id: abase))
                                val cellPtr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: abase)
                                val gep: LLVMValueRef = LLVMBuildStructGEP2(self.b, pty, cellPtr, fidx, anon())
                                val gfr3: U64 = fieldGenInstRef(c: inout c, fld: fld)
                                if op == opAssign() && gfr3 != 0U64 {
                                    self.expectedTy = gfr3
                                    val gv3: LLVMValueRef = self.genLlvmExpr(c: inout c, id: value)
                                    self.expectedTy = 0U64
                                    LLVMBuildStore(self.b, gv3, gep)
                                    return
                                }
                                mut val rv: LLVMValueRef = self.coerceIntTo(c: inout c, v: self.genLlvmExpr(c: inout c, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                if op == opAssign() {
                                    // value semantics: copy an array/struct PLACE RHS so the
                                    // pointee field is independent of the source binding (the
                                    // Ref aliasing is about the cell, not the assigned value).
                                    rv = self.copyValueIfPlace(c: inout c, rv: rv, valueExpr: value)
                                    LLVMBuildStore(self.b, rv, gep)
                                } else {
                                    val ftype: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                    val cur: LLVMValueRef = LLVMBuildLoad2(self.b, ftype, gep, anon())
                                    LLVMBuildStore(self.b, self.buildBinOpChecked(c: inout c, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen)), gep)
                                }
                                return
                            }
                        }
                        compileErrorAt(line: c.lineOf(offset: ans), msg: "LLVM backend: `->` assignment only on a Ref to a registered struct (so far)")
                    }
                    _ => {
                        compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: target)), msg: "LLVM backend: only simple `name = …` assignment is supported so far")
                    }
                }
            }
            Stmt.ExprStmt(val expr) => {
                // a bare `await e` inside an async fn is a suspension point with no value.
                if self.curAsync {
                    if exprIsAwaitLL(c: inout c, id: expr) {
                        match c.arena.exprs[expr] {
                            Expr.Await(val operand) => {
                                self.emitLlvmAsyncSuspend(c: inout c, operandId: operand)
                            }
                            _ => {}
                        }
                        return
                    }
                }
                val ignore: LLVMValueRef = self.genLlvmExpr(c: inout c, id: expr)
            }
            Stmt.Panic(val msg, offset: _) => {
                val ignore: LLVMValueRef = self.emitStrSink(c: inout c, rtName: "plew_panic_raw", rtId: 4U64, argExpr: msg)
                LLVMBuildUnreachable(self.b)
                self.terminated = true
            }
            Stmt.Return(val value, val hasValue, offset: _) => {
                // inside an async fn, `return` resolves `__self` (a `return await e`
                // first suspends), frees the frame, and returns from the resume fn.
                if self.curAsync {
                    self.genLlvmAsyncReturn(c: inout c, value: value, hasValue: hasValue)
                    return
                }
                val sentinel: U64 = 18446744073709551615U64
                if self.curIsMain {
                    // Plew `main` returns () -> C `int main` returns 0; drop live locals.
                    self.dropScope(c: inout c, fromMark: 0U64, excludeLi: sentinel)
                    LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32))
                } else {
                    if hasValue {
                        // extension-view invariance (spec/09): a returned value's view
                        // must match the declared return type's view.
                        if self.curRetRef != 0U64 {
                            if c.arena.types[self.curRetRef].viewExtId != self.exprViewExtId(c: inout c, id: value) {
                                compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: value)), msg: "extension view mismatch: the returned value's `#Ext` view must match the declared return type — apply or drop the view explicitly")
                            }
                        }
                        // an existential `any P` return (spec/08): box a concrete
                        // conforming value into the fat pointer.
                        if refIsAny(c: inout c, ref: self.curRetRef) {
                            mut val rb: Bool = false
                            mut val rav: LLVMValueRef = self.coerceToAnyIfNeeded(c: inout c, targetRef: self.curRetRef, valueExpr: value, outBoxed: inout rb)
                            if !(rb) {
                                // already an `any P` value: value-semantics copy of a place.
                                rav = self.copyAnyIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: value), valueExpr: value)
                            }
                            mut val exLi: U64 = sentinel
                            match c.arena.exprs[value] {
                                Expr.Ident(start: val vs, len: val vl) => { exLi = self.findLocal(c: inout c, start: vs, len: vl) }
                                _ => {}
                            }
                            self.dropScope(c: inout c, fromMark: 0U64, excludeLi: exLi)
                            LLVMBuildRet(self.b, rav)
                            self.terminated = true
                            return
                        }
                        // the declared return type is the expected type, so a returned
                        // un-suffixed generic construction (`return <Optional.Some …/>`)
                        // infers its type args. Consumed by the construction.
                        self.expectedTy = self.curRetRef
                        mut val rv: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
                        mut val retLit: Bool = false
                        // an array-literal return (`return [10,20,30]` for `-> Array[I32]`)
                        // builds with the declared element type, not i64-defaulted.
                        if self.curRetTyLen > 0U64 {
                            match c.arena.exprs[value] {
                                Expr.Array(val elems) => {
                                    // an `Array[any P]` return literal: box each element.
                                    mut val retElemRef: U64 = 0
                                    mut val retElemTy: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: self.curRetTyStart, tyLen: self.curRetTyLen)
                                    if self.curRetRef != 0U64 {
                                        if c.arena.types[self.curRetRef].args.count > 0U64 {
                                            retElemRef = c.arena.types[self.curRetRef].args[0]
                                            if refIsAny(c: inout c, ref: retElemRef) {
                                                retElemTy = self.anyTy
                                            }
                                        }
                                    }
                                    rv = self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: retElemTy, elemRef: retElemRef)
                                    retLit = true
                                }
                                _ => {}
                            }
                        }
                        if !(retLit) {
                            rv = self.genLlvmExpr(c: inout c, id: value)
                        }
                        self.expectedTy = 0U64
                        if self.curRetTyLen > 0U64 {
                            if !(retLit) {
                                rv = self.coerceIntTo(c: inout c, v: rv, tyStart: self.curRetTyStart, tyLen: self.curRetTyLen)
                            }
                        }
                        // value semantics: returning an array/struct place gives the caller
                        // an independent value (`return b.xs` then caller's `r[0]=…`).
                        rv = self.copyValueIfPlace(c: inout c, rv: rv, valueExpr: value)
                        // scope-exit deinits for all live locals — but a returned local is
                        // moved out to the caller, so exclude it.
                        mut val excludeLi: U64 = sentinel
                        match c.arena.exprs[value] {
                            Expr.Ident(start: val s, len: val l) => {
                                val li: U64 = self.findLocal(c: inout c, start: s, len: l)
                                if li < self.nLocals {
                                    excludeLi = li
                                }
                            }
                            _ => {}
                        }
                        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: excludeLi)
                        LLVMBuildRet(self.b, rv)
                    } else {
                        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: sentinel)
                        LLVMBuildRetVoid(self.b)
                    }
                }
                self.terminated = true
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                val cv: LLVMValueRef = self.genLlvmCond(c: inout c, id: cond)
                val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "then"))
                val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "endif"))
                mut val elseBB: LLVMBasicBlockRef = contBB
                if hasElse {
                    elseBB = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "else"))
                }
                LLVMBuildCondBr(self.b, cv, thenBB, elseBB)
                // then
                LLVMPositionBuilderAtEnd(self.b, thenBB)
                self.terminated = false
                self.genLlvmBlock(c: inout c, id: thenBlk)
                if !(self.terminated) {
                    LLVMBuildBr(self.b, contBB)
                }
                // else
                if hasElse {
                    LLVMPositionBuilderAtEnd(self.b, elseBB)
                    self.terminated = false
                    self.genLlvmBlock(c: inout c, id: elseBlk)
                    if !(self.terminated) {
                        LLVMBuildBr(self.b, contBB)
                    }
                }
                LLVMPositionBuilderAtEnd(self.b, contBB)
                self.terminated = false
            }
            Stmt.While(val cond, val body) => {
                val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "while.cond"))
                val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "while.body"))
                val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "while.end"))
                LLVMBuildBr(self.b, condBB)
                LLVMPositionBuilderAtEnd(self.b, condBB)
                val cv: LLVMValueRef = self.genLlvmCond(c: inout c, id: cond)
                LLVMBuildCondBr(self.b, cv, bodyBB, endBB)
                LLVMPositionBuilderAtEnd(self.b, bodyBB)
                self.terminated = false
                // `break` -> endBB, `continue` -> condBB (re-test) for this loop.
                self.pushLoop(breakBB: endBB, contBB: condBB)
                self.genLlvmBlock(c: inout c, id: body)
                self.popLoop()
                if !(self.terminated) {
                    LLVMBuildBr(self.b, condBB)
                }
                LLVMPositionBuilderAtEnd(self.b, endBB)
                self.terminated = false
            }
            Stmt.Break(offset: _) => {
                if self.loopDepth > 0U64 {
                    LLVMBuildBr(self.b, self.loopBreakBB[self.loopDepth - 1U64])
                    self.terminated = true
                } else {
                    compileErrorAt(line: 0, msg: "LLVM backend: `break` outside a loop")
                }
            }
            Stmt.Continue(offset: _) => {
                if self.loopDepth > 0U64 {
                    LLVMBuildBr(self.b, self.loopContBB[self.loopDepth - 1U64])
                    self.terminated = true
                } else {
                    compileErrorAt(line: 0, msg: "LLVM backend: `continue` outside a loop")
                }
            }
            Stmt.Match(val scrut, val arms) => {
                self.genLlvmMatch(c: inout c, scrut: scrut, arms: arms)
            }
            Stmt.Give(val value) => {
                // yield the enclosing value-position block's result (IfExpr reads it).
                self.giveValue = self.genLlvmExpr(c: inout c, id: value)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
                if isStruct {
                    self.genLlvmForArrayStruct(c: inout c, patStart: patStart, patLen: patLen, iter: iter, binds: binds, body: body)
                } else {
                    if isRange {
                        self.genLlvmForRange(c: inout c, varStart: varStart, varLen: varLen, varTyStart: varTyStart, varTyLen: varTyLen, inclusive: inclusive, lo: iter, hi: rangeHi, body: body)
                    } else {
                        self.genLlvmForArray(c: inout c, varStart: varStart, varLen: varLen, iter: iter, body: body)
                    }
                }
            }
            _ => {
                compileErrorAt(line: 0, msg: "LLVM backend: statement form not yet supported")
            }
        }
    }
}
