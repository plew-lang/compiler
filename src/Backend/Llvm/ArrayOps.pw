// Part of the LLVM backend (root: _.pw): array literal / index / append / set emission and short-circuit ops.

// Build an array literal `[e0, e1, ...]` of element type `elemTy` (provided by the
// caller from the annotation, or inferred from the first element) as a
// `{ ptr data, i64 count }` value.

pub impl LlvmCtx {
    inout fn genLlvmArrayLit(c: inout Comp, elems: Array[U64], elemTy: LLVMTypeRef, elemRef: U64 = 0) -> LLVMValueRef {
        mut val agg: LLVMValueRef = LLVMGetUndef(self.arrayTy)
        val n: U64 = elems.count
        if n == 0U64 {
            agg = LLVMBuildInsertValue(self.b, agg, LLVMConstNull(self.ptrty), 0U64, anon())
            agg = LLVMBuildInsertValue(self.b, agg, LLVMConstInt(self.i64ty, 0U64, 0I32), 1U64, anon())
            return agg
        }
        // an `Array[any P]` literal (spec/08): each concrete element is boxed into the
        // existential fat pointer so heterogeneous concrete types share one element slot.
        val elemIsAny: Bool = refIsAny(c: inout c, ref: elemRef)
        val data: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(elemTy), cap: LLVMConstInt(self.i64ty, n, 0I32))
        mut val i: U64 = 0
        while i < n {
            mut val ev: LLVMValueRef = LLVMConstNull(self.ptrty)
            if elemIsAny {
                mut val eb: Bool = false
                ev = self.coerceToAnyIfNeeded(c: inout c, targetRef: elemRef, valueExpr: elems[i], outBoxed: inout eb)
                if !(eb) {
                    ev = self.genLlvmExpr(c: inout c, id: elems[i])
                }
            } else {
                // value semantics: copy an array/struct PLACE element (`[a, b]` for
                // Array[Array[T]]) so the literal is independent of the source bindings.
                ev = self.copyValueIfPlace(c: inout c, rv: self.coerceElem(v: self.genLlvmExpr(c: inout c, id: elems[i]), elemTy: elemTy), valueExpr: elems[i])
            }
            LLVMBuildStore(self.b, ev, self.arrElemPtr(elemTy: elemTy, data: data, idx: LLVMConstInt(self.i64ty, i, 0I32)))
            i += 1
        }
        agg = LLVMBuildInsertValue(self.b, agg, data, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, LLVMConstInt(self.i64ty, n, 0I32), 1U64, anon())
        return agg
    }

    // `arr[i]` read: bounds-checked element load.
    inout fn genLlvmIndex(c: inout Comp, base: U64, index: U64) -> LLVMValueRef {
        // only a built-in Array is indexed directly; a user `Index`-impl subscript
        // (struct `g[i]`) desugars to `g.index(key: i)` via the Index witness (spec/12).
        if !(self.exprIsArray(c: inout c, id: base)) {
            val bsi: U64 = self.exprStructIdx(c: inout c, id: base)
            if bsi < c.arena.structs.count {
                // a Dictionary subscript `d[k]` lowers to the panicking accessor
                // `d.at(key: k)` (spec/02); a user Index type uses `index`.
                if rangeEquals(bytes: c.arena.bytes, start: c.arena.structs[bsi].nameStart, len: c.arena.structs[bsi].nameLen, kw: "Dictionary") {
                    val m: U64 = c.synthDictMethod(recv: base, name: "at", arg0Label: "key", arg0: index, hasArg1: false, arg1Label: "", arg1: 0)
                    return self.genLlvmExpr(c: inout c, id: m)
                }
                if c.typeHasMethodNamed(typeStart: c.arena.structs[bsi].nameStart, typeLen: c.arena.structs[bsi].nameLen, name: "index") {
                    val m: U64 = c.synthDictMethod(recv: base, name: "index", arg0Label: "key", arg0: index, hasArg1: false, arg1Label: "", arg1: 0)
                    return self.genLlvmExpr(c: inout c, id: m)
                }
            }
            compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: base)), msg: "LLVM backend: user Index subscript needs an `index` method")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val elemTy: LLVMTypeRef = self.arrElemTyOf(c: inout c, id: base)
        val arr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: base)
        // the base must be an array {ptr,i64} aggregate; a non-aggregate here means a
        // nested array (Array[Array[T]]) or unsupported element typing — reject loudly
        // rather than extractvalue on a scalar (which crashes the LLVM builder).
        if LLVMGetTypeKind(LLVMTypeOf(arr)) != 10U32 {
            compileErrorAt(line: c.lineOf(offset: c.exprOffset(id: base)), msg: "LLVM backend: nested arrays / this index form not yet supported")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val data: LLVMValueRef = LLVMBuildExtractValue(self.b, arr, 0U64, anon())
        val count: LLVMValueRef = LLVMBuildExtractValue(self.b, arr, 1U64, anon())
        val idx: LLVMValueRef = self.genLlvmExpr(c: inout c, id: index)
        self.emitBoundsCheck(c: inout c, idx: idx, count: count)
        return LLVMBuildLoad2(self.b, elemTy, self.arrElemPtr(elemTy: elemTy, data: data, idx: idx), anon())
    }

    // `arr.append(v)` on an array local: grow the buffer if full, store v at `count`,
    // increment count (mutating the local's {data,count}). No CoW yet (shares buffer).
    // The element TypeRef of an array-valued expression (an array local's
    // locElemTypeRef, or a struct field's grounded element ref), or 0.
    inout fn arrayExprElemRef(c: inout Comp, arrayExpr: U64) -> U64 {
        match c.arena.exprs[arrayExpr] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    return self.locElemTypeRef[li]
                }
            }
            Expr.Field(base: val fb, nameStart: val fns, nameLen: val fnl) => {
                val bsi: U64 = self.exprStructIdx(c: inout c, id: fb)
                if bsi < c.arena.structs.count {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns, len: fnl)
                    if fidx < c.arena.structs[bsi].fields.count {
                        return self.fieldArrayElemRefUnderBase(c: inout c, base: fb, fd: c.arena.structs[bsi].fields[fidx])
                    }
                }
            }
            _ => {}
        }
        // fallback (a nested element `m[i]`, a call result): unwrap the expression's own
        // `Array[E]` type ref to E. Needed so an ARC-bearing element (a nested array) is
        // retained/released even when bound from a non-Ident/Field place.
        val r: U64 = self.exprTypeRef(c: inout c, id: arrayExpr)
        if r != 0U64 {
            val t: TypeRef = c.arena.types[r]
            if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                if t.args.count > 0U64 {
                    return t.args[0]
                }
            }
        }
        return 0U64
    }

    inout fn genLlvmAppend(c: inout Comp, recv: U64, valueExpr: U64) -> LLVMValueRef {
        // CoW gateway (1-0): own any shared array buffer ABOVE the receiver (e.g.
        // `arr[i].append(v)` -> own `arr` first) before the immediate-level CoW below.
        self.privatizeForWrite(c: inout c, id: recv)
        val arrPtr: LLVMValueRef = self.arrStoragePtr(c: inout c, id: recv)
        if LLVMIsNull(arrPtr) != 0I32 {
            compileErrorAt(line: 0, msg: "LLVM backend: append only on an array local / struct field (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val elemTy: LLVMTypeRef = self.arrElemTyOf(c: inout c, id: recv)
        // CoW: if this array shares its buffer (rc>1), privatize it in the slot before
        // mutating, so the append does not clobber another binding's view.
        self.cowArraySlot(c: inout c, slotPtr: arrPtr, elemTy: elemTy, elemRef: self.arrayExprElemRef(c: inout c, arrayExpr: recv))
        val dataPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.arrayTy, arrPtr, 0U64, anon())
        val countPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.arrayTy, arrPtr, 1U64, anon())
        val data: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, dataPtr, anon())
        val count: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, countPtr, anon())
        // newdata = plew_arr_grow(data, elemSize, count)
        mut val gtys: Array[LLVMTypeRef] = []
        gtys.append(value: self.ptrty)
        gtys.append(value: self.i64ty)
        gtys.append(value: self.i64ty)
        val gfty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(gtys), 3U64, 0I32)
        val grow: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_arr_grow", nameId: 22U64, fnTy: gfty)
        mut val gav: Array[LLVMValueRef] = []
        gav.append(value: data)
        gav.append(value: LLVMSizeOf(elemTy))
        gav.append(value: count)
        val newdata: LLVMValueRef = LLVMBuildCall2(self.b, gfty, grow, arrayCPtr(gav), 3U64, anon())
        LLVMBuildStore(self.b, newdata, dataPtr)
        // build the appended value. An array-LITERAL appended to a nested array
        // (`m.append([1,2,3])` for m: Array[Array[I32]]) must use the inner element
        // type, not i64-defaulted — recover it from the receiver's element ref.
        mut val ev: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        mut val builtLit: Bool = false
        match c.arena.exprs[valueExpr] {
            Expr.Array(val elems) => {
                val recvElemRef: U64 = self.arrayExprElemRef(c: inout c, arrayExpr: recv)
                if recvElemRef != 0U64 {
                    val ret: TypeRef = c.arena.types[recvElemRef]
                    if rangeEquals(bytes: c.arena.bytes, start: ret.nameStart, len: ret.nameLen, kw: "Array") {
                        if ret.args.count > 0U64 {
                            ev = self.genLlvmArrayLit(c: inout c, elems: elems, elemTy: self.llvmTypeOfRef(c: inout c, ref: ret.args[0]))
                            builtLit = true
                        }
                    }
                }
            }
            _ => {}
        }
        if !(builtLit) {
            // value semantics (spec/03): appending an array/struct PLACE element copies,
            // so the array's element stays independent of the source binding
            // (`xs.append(a)` then `a[0]=…` must leave `xs[0]` unchanged). A literal /
            // call result already owns its buffer; copyValueIfPlace passes it through.
            ev = self.copyValueIfPlace(c: inout c, rv: self.coerceElem(v: self.genLlvmExpr(c: inout c, id: valueExpr), elemTy: elemTy), valueExpr: valueExpr)
        }
        LLVMBuildStore(self.b, ev, self.arrElemPtr(elemTy: elemTy, data: newdata, idx: count))
        LLVMBuildStore(self.b, LLVMBuildAdd(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), countPtr)
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }

    // `arr.set(i:, value:)`: bounds-checked element store (same place mutation as
    // `arr[i] = v`). For a scalar array that shares its buffer (rc>1) this CoWs it in the
    // slot first (Stage 2a). Returns a unit value.
    inout fn genLlvmArraySet(c: inout Comp, recv: U64, indexExpr: U64, valueExpr: U64) -> LLVMValueRef {
        // CoW gateway (1-0): own any shared array buffer ABOVE the receiver (e.g.
        // `arr[i].set(j, v)` -> own `arr` first) before the immediate-level CoW below.
        self.privatizeForWrite(c: inout c, id: recv)
        val elemTy: LLVMTypeRef = self.arrElemTyOf(c: inout c, id: recv)
        val elemRef: U64 = self.arrayExprElemRef(c: inout c, arrayExpr: recv)
        mut val data: LLVMValueRef = LLVMConstNull(self.ptrty)
        mut val count: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        mut val placed: Bool = false
        val slot: LLVMValueRef = self.arrStoragePtr(c: inout c, id: recv)
        if LLVMIsNull(slot) == 0I32 {
            placed = true
            data = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elemTy, elemRef: elemRef)
            count = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, self.arrayTy, slot, 1U64, anon()), anon())
        } else {
            val arr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: recv)
            data = LLVMBuildExtractValue(self.b, arr, 0U64, anon())
            count = LLVMBuildExtractValue(self.b, arr, 1U64, anon())
        }
        val idx: LLVMValueRef = self.genLlvmExpr(c: inout c, id: indexExpr)
        self.emitBoundsCheck(c: inout c, idx: idx, count: count)
        val ep: LLVMValueRef = self.arrElemPtr(elemTy: elemTy, data: data, idx: idx)
        // value semantics: copy an array/struct PLACE element so `arr.set(i, a)` leaves
        // the stored element independent of `a` (a literal / call result passes through).
        val rv: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.coerceElem(v: self.genLlvmExpr(c: inout c, id: valueExpr), elemTy: elemTy), valueExpr: valueExpr)
        // commit-then-release (§2c): for an ARC-bearing element on a privatized place
        // buffer, read the retiring value, store the new one (commit the slot to a valid
        // value), THEN release the old heap. Overwriting `[0,count)` is always overwriting
        // a live value (dense invariant), so the old element's heap (String / nested array
        // / deinit-bearing struct/enum) is freed rather than leaked, and a re-entrant
        // deinit only observes a fully-initialized slot. The non-place rvalue branch keeps
        // the old leak-safe store (its temp buffer may be shared, so releasing could
        // double-free); that path discards its result anyway.
        if placed && self.arrElemNeedsValueArc(c: inout c, elemRef: elemRef) {
            val old: LLVMValueRef = LLVMBuildLoad2(self.b, elemTy, ep, anon())
            LLVMBuildStore(self.b, rv, ep)
            self.valueArc(c: inout c, v: old, typeRef: elemRef, retain: false)
        } else {
            LLVMBuildStore(self.b, rv, ep)
        }
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }

    // `arr.removeLast()`: shrink the array by one (panics when empty). Symmetric with
    // append — CoWs a shared buffer first (it is a mutation), then releases the popped
    // element's owned heap (String / nested array / deinit-bearing struct/enum) so the
    // element cascade stays balanced, and decrements `count`. The storage buffer itself
    // is left at its grown capacity (only the live `count` shrinks). Returns unit. Used
    // by the dense-array compaction in Dictionary/Set `remove`.
    inout fn genLlvmArrayRemoveLast(c: inout Comp, recv: U64) -> LLVMValueRef {
        // CoW gateway (1-0): own any shared array buffer ABOVE the receiver first.
        self.privatizeForWrite(c: inout c, id: recv)
        val slot: LLVMValueRef = self.arrStoragePtr(c: inout c, id: recv)
        if LLVMIsNull(slot) != 0I32 {
            compileErrorAt(line: 0, msg: "LLVM backend: removeLast only on an array local / struct field (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val elemTy: LLVMTypeRef = self.arrElemTyOf(c: inout c, id: recv)
        val elemRef: U64 = self.arrayExprElemRef(c: inout c, arrayExpr: recv)
        val data: LLVMValueRef = self.cowArraySlot(c: inout c, slotPtr: slot, elemTy: elemTy, elemRef: elemRef)
        val countPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.arrayTy, slot, 1U64, anon())
        val count: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, countPtr, anon())
        // empty-guard: index 0 must be in range (i.e. count > 0), else panic.
        self.emitBoundsCheck(c: inout c, idx: LLVMConstInt(self.i64ty, 0U64, 0I32), count: count)
        val newCount: LLVMValueRef = LLVMBuildSub(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
        // commit-then-release (§2c): shrink `count` FIRST so the popped slot leaves the
        // live prefix [0,count), THEN release its owned heap (String / nested array /
        // deinit-bearing struct/enum) to keep the value-ARC cascade balanced. Releasing a
        // last `Ref` runs `deinit` synchronously and can re-enter; committing the shrink
        // first means such a re-entry only ever observes the dense prefix, never the
        // half-torn-down element. The buffer keeps its grown capacity.
        if self.arrElemNeedsValueArc(c: inout c, elemRef: elemRef) {
            val ep: LLVMValueRef = self.arrElemPtr(elemTy: elemTy, data: data, idx: newCount)
            val ev: LLVMValueRef = LLVMBuildLoad2(self.b, elemTy, ep, anon())
            LLVMBuildStore(self.b, newCount, countPtr)
            self.valueArc(c: inout c, v: ev, typeRef: elemRef, retain: false)
        } else {
            LLVMBuildStore(self.b, newCount, countPtr)
        }
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }

    // ---- Buffer floor ops (buffer-floor.md). Unlike Array's `{ptr,i64}` value, a
    // `Buffer[T]` is a SINGLE data pointer; its `cap`/`count`/`rc` live in the heap
    // header before the pointer (`plew_rawbuf_*`). The element type T is recovered from
    // the receiver local's tracked `Buffer[T]` TypeRef. These mirror genLlvmAppend / etc
    // but read/write count via the header rather than an inline struct field. ----

    // Whether an expression is a `Buffer[T]`-typed local (for routing new/count/append/get).
    inout fn exprIsBuffer(c: inout Comp, id: U64) -> Bool {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    val tr: U64 = self.locTypeRef[li]
                    if tr != 0U64 {
                        return rangeEquals(bytes: c.arena.bytes, start: c.arena.types[tr].nameStart, len: c.arena.types[tr].nameLen, kw: "Buffer")
                    }
                }
            }
            _ => {}
        }
        return false
    }

    // The element TypeRef of a `Buffer[T]` receiver local (T), or 0.
    inout fn bufElemRef(c: inout Comp, id: U64) -> U64 {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    val tr: U64 = self.locTypeRef[li]
                    if tr != 0U64 {
                        if c.arena.types[tr].args.count > 0U64 {
                            return c.arena.types[tr].args[0]
                        }
                    }
                }
            }
            _ => {}
        }
        return 0U64
    }

    // The LLVM element type of a `Buffer[T]` receiver (i64 fallback).
    inout fn bufElemTyOf(c: inout Comp, id: U64) -> LLVMTypeRef {
        val er: U64 = self.bufElemRef(c: inout c, id: id)
        if er != 0U64 {
            return self.llvmTypeOfRef(c: inout c, ref: er)
        }
        return self.i64ty
    }

    // The alloca holding a `Buffer[T]` local's data pointer (so append can store the
    // grown pointer back). Null if not an addressable buffer local.
    inout fn bufStoragePtr(c: inout Comp, id: U64) -> LLVMValueRef {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    return self.locPtr[li]
                }
            }
            _ => {}
        }
        return LLVMConstNull(self.ptrty)
    }

    // `Buffer.new()`: a fresh empty buffer (header-only, cap=0 — the first append grows
    // it). The element size is irrelevant at cap=0, so a unit elemSize suffices.
    inout fn genLlvmBufferNew(c: inout Comp) -> LLVMValueRef {
        return self.rawbufAlloc(c: inout c, elemSize: LLVMConstInt(self.i64ty, 1U64, 0I32), cap: LLVMConstInt(self.i64ty, 0U64, 0I32))
    }

    // `buf.count()`: the live-element count, read from the heap header.
    inout fn genLlvmBufferCount(c: inout Comp, recv: U64) -> LLVMValueRef {
        return self.rawbufCount(c: inout c, data: self.genLlvmExpr(c: inout c, id: recv))
    }

    // `buf.append(value)`: grow the buffer if full, store the (place-copied) value at the
    // header count index, and bump the header count.
    inout fn genLlvmBufferAppend(c: inout Comp, recv: U64, valueExpr: U64) -> LLVMValueRef {
        val slot: LLVMValueRef = self.bufStoragePtr(c: inout c, id: recv)
        if LLVMIsNull(slot) != 0I32 {
            compileErrorAt(line: 0, msg: "LLVM backend: Buffer.append only on a buffer local (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val elemTy: LLVMTypeRef = self.bufElemTyOf(c: inout c, id: recv)
        val data: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, slot, anon())
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
        // newdata = plew_arr_grow(data, elemSize, count) — grows (and frees the old, rc<=1)
        // only when count>=cap; the header count is carried across in the runtime.
        mut val gtys: Array[LLVMTypeRef] = []
        gtys.append(value: self.ptrty)
        gtys.append(value: self.i64ty)
        gtys.append(value: self.i64ty)
        val gfty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(gtys), 3U64, 0I32)
        val grow: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_arr_grow", nameId: 22U64, fnTy: gfty)
        mut val gav: Array[LLVMValueRef] = []
        gav.append(value: data)
        gav.append(value: LLVMSizeOf(elemTy))
        gav.append(value: count)
        val newdata: LLVMValueRef = LLVMBuildCall2(self.b, gfty, grow, arrayCPtr(gav), 3U64, anon())
        LLVMBuildStore(self.b, newdata, slot)
        // value semantics: a struct/array/String PLACE element copies (a literal / call
        // result already owns its buffer and passes through).
        val ev: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.coerceElem(v: self.genLlvmExpr(c: inout c, id: valueExpr), elemTy: elemTy), valueExpr: valueExpr)
        LLVMBuildStore(self.b, ev, self.arrElemPtr(elemTy: elemTy, data: newdata, idx: count))
        self.rawbufSetCount(c: inout c, data: newdata, n: LLVMBuildAdd(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()))
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }

    // `buf.get(index)`: bounds-checked element read (panics when out of range).
    inout fn genLlvmBufferGet(c: inout Comp, recv: U64, indexExpr: U64) -> LLVMValueRef {
        val elemTy: LLVMTypeRef = self.bufElemTyOf(c: inout c, id: recv)
        val data: LLVMValueRef = self.genLlvmExpr(c: inout c, id: recv)
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
        val idx: LLVMValueRef = self.genLlvmExpr(c: inout c, id: indexExpr)
        self.emitBoundsCheck(c: inout c, idx: idx, count: count)
        return LLVMBuildLoad2(self.b, elemTy, self.arrElemPtr(elemTy: elemTy, data: data, idx: idx), anon())
    }

    // `buf.capacity()`: the allocated capacity, read from the header.
    inout fn genLlvmBufferCapacity(c: inout Comp, recv: U64) -> LLVMValueRef {
        return self.rawbufCap(c: inout c, data: self.genLlvmExpr(c: inout c, id: recv))
    }

    // `buf.isEmpty()`: header count == 0 (yields an i1).
    inout fn genLlvmBufferIsEmpty(c: inout Comp, recv: U64) -> LLVMValueRef {
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: self.genLlvmExpr(c: inout c, id: recv))
        return LLVMBuildICmp(self.b, llvmIntEq(), count, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
    }

    // `buf.set(index, value)`: bounds-checked element store (MVP: scalar elements — no
    // element-heap release/retain yet; that arrives with the C1/C2 element cascade).
    inout fn genLlvmBufferSet(c: inout Comp, recv: U64, indexExpr: U64, valueExpr: U64) -> LLVMValueRef {
        val elemTy: LLVMTypeRef = self.bufElemTyOf(c: inout c, id: recv)
        val data: LLVMValueRef = self.genLlvmExpr(c: inout c, id: recv)
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
        val idx: LLVMValueRef = self.genLlvmExpr(c: inout c, id: indexExpr)
        self.emitBoundsCheck(c: inout c, idx: idx, count: count)
        val rv: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.coerceElem(v: self.genLlvmExpr(c: inout c, id: valueExpr), elemTy: elemTy), valueExpr: valueExpr)
        LLVMBuildStore(self.b, rv, self.arrElemPtr(elemTy: elemTy, data: data, idx: idx))
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }

    // `buf.removeLast()`: shrink the live count by one (panics when empty). The storage
    // keeps its capacity. MVP: scalar elements — no popped-element release yet.
    inout fn genLlvmBufferRemoveLast(c: inout Comp, recv: U64) -> LLVMValueRef {
        val slot: LLVMValueRef = self.bufStoragePtr(c: inout c, id: recv)
        if LLVMIsNull(slot) != 0I32 {
            compileErrorAt(line: 0, msg: "LLVM backend: Buffer.removeLast only on a buffer local (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val data: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, slot, anon())
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: data)
        // empty-guard: index 0 must be in range (count > 0), else panic.
        self.emitBoundsCheck(c: inout c, idx: LLVMConstInt(self.i64ty, 0U64, 0I32), count: count)
        self.rawbufSetCount(c: inout c, data: data, n: LLVMBuildSub(self.b, count, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()))
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }

    // Emit a condition expression as an i1. A comparison binary already yields i1; any
    // other integer becomes `x != 0`.
    // `a && b` / `a || b` with short-circuit semantics (spec/12), yielding an i1.
    // For `&&`: if a is false, the result is false without evaluating b; for `||`: if
    // a is true, the result is true without evaluating b. A PHI merges the short-
    // circuit constant (from the lhs block) with b's value (from the rhs block).
    inout fn genLlvmShortCircuit(c: inout Comp, isAnd: Bool, lhs: U64, rhs: U64) -> LLVMValueRef {
        val lv: LLVMValueRef = self.genLlvmCond(c: inout c, id: lhs)
        val lhsEndBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val rhsBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "sc.rhs"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "sc.cont"))
        // && : true -> eval rhs, false -> short-circuit (false). || : true -> short-
        // circuit (true), false -> eval rhs.
        if isAnd {
            LLVMBuildCondBr(self.b, lv, rhsBB, contBB)
        } else {
            LLVMBuildCondBr(self.b, lv, contBB, rhsBB)
        }
        LLVMPositionBuilderAtEnd(self.b, rhsBB)
        val rv: LLVMValueRef = self.genLlvmCond(c: inout c, id: rhs)
        val rhsEndBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
        val phi: LLVMValueRef = LLVMBuildPhi(self.b, self.i1ty, anon())
        // the short-circuit constant on the lhs edge: && -> false, || -> true.
        mut val scConst: LLVMValueRef = LLVMConstInt(self.i1ty, 0U64, 0I32)
        if !(isAnd) {
            scConst = LLVMConstInt(self.i1ty, 1U64, 0I32)
        }
        mut val vals: Array[LLVMValueRef] = []
        vals.append(value: scConst)
        vals.append(value: rv)
        mut val blocks: Array[LLVMBasicBlockRef] = []
        blocks.append(value: lhsEndBB)
        blocks.append(value: rhsEndBB)
        LLVMAddIncoming(phi, arrayCPtr(vals), arrayCPtr(blocks), 2U64)
        return phi
    }

    inout fn genLlvmCond(c: inout Comp, id: U64) -> LLVMValueRef {
        match c.arena.exprs[id] {
            Expr.Binary(val op, lhs: _, rhs: _) => {
                if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                    return self.genLlvmExpr(c: inout c, id: id)
                }
            }
            _ => {}
        }
        val v: LLVMValueRef = self.genLlvmExpr(c: inout c, id: id)
        return LLVMBuildICmp(self.b, llvmIntNe(), v, LLVMConstInt(self.i1ty, 0U64, 0I32), anon())
    }
}
