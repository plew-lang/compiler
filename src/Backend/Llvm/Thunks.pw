// Part of the LLVM backend (root: _.pw): function-value thunk creation and emission.

// ---- function-value thunks ----
//
// Index into st.thunk* for a function index, or st.thunkIdx.count().

pub impl LlvmCtx {
    inout fn thunkSlot(fi: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.thunkIdx.count() {
            if self.thunkIdx[i] == fi {
                return i
            }
            i += 1
        }
        return self.thunkIdx.count()
    }

    // Declare a thunk `__fnthunk<fi>(ptr env, params...)` for plain user function `fi`
    // (so a bare reference to it can be the {fn, env} value). Idempotent; only declares
    // for a function the backend actually emits (a plain user fn).
    inout fn declareThunk(c: inout Comp, fi: U64) {
        if self.thunkSlot(fi: fi) < self.thunkIdx.count() {
            return
        }
        val f: Func = c.arena.funcs[fi]
        // a free function the backend emits as a `gf` instance (its body forwarded to by the
        // thunk via ensureFnInst): mirror that path's acceptance (extern / main / method /
        // async are not function-value-able here).
        if f.hasRecv {
            return
        }
        if f.isExtern { return }
        if c.nameIsMain(f: f) { return }
        if f.isAsync { return }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        mut val pi: U64 = 0
        while pi < f.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: f.params[pi]))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: f), arrayCPtr(ptys), ptys.count(), 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "__fnthunk".bytes())
        appendU64Dec(into: inout nm, n: fi)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.thunkIdx.append(fi)
        self.thunkVal.append(fv)
        self.thunkTy.append(fty)
    }

    // Declare a thunk for every bare identifier that names a plain free function (a
    // function-as-value use; over-approx is harmless — an unused thunk just sits).
    inout fn collectThunks(c: inout Comp) {
        mut val i: U64 = 0
        while i < c.arena.exprs.count() {
            match c.arena.exprs[i] {
                Expr.Ident(val start, val len) => {
                    val fvi: U64 = c.firstFuncByName(nameStart: start, nameLen: len)
                    if fvi < c.arena.funcs.count() {
                        val f: Func = c.arena.funcs[fvi]
                        if !(f.hasRecv || f.isAssoc || f.typeParams.count() > 0U64) {
                            self.declareThunk(c: inout c, fi: fvi)
                        }
                    }
                }
                _ => {}
            }
            i += 1
        }
    }

    // Emit each thunk body: forward the closure args (skipping env at 0) to the plain
    // function pf<fi>, returning its result.
    inout fn emitThunks(c: inout Comp) {
        mut val s: U64 = 0
        while s < self.thunkIdx.count() {
            val fi: U64 = self.thunkIdx[s]
            val fv: LLVMValueRef = self.thunkVal[s]
            val f: Func = c.arena.funcs[fi]
            val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
            LLVMPositionBuilderAtEnd(self.b, entry)
            mut val av: Array[LLVMValueRef] = []
            mut val pi: U64 = 0
            while pi < f.params.count() {
                av.append(LLVMGetParam(fv, pi + 1U64))
                pi += 1
            }
            // a free function is its 0-type-arg `gf` instance; a method-as-value still
            // resolves through its `pf` symbol (methods are not yet unified — B3-2).
            mut val callTy: LLVMTypeRef = self.voidty
            mut val callVal: LLVMValueRef = LLVMConstNull(self.ptrty)
            if f.hasRecv {
                val callSlot: U64 = self.userFnSlot(idx: fi)
                callTy = self.fnTy[callSlot]
                callVal = self.fnVal[callSlot]
            } else {
                val callSlot: U64 = self.ensureFnInst(c: inout c, fnIdx: fi, args: [], recvInstRef: 0U64)
                callTy = self.genFnTy[callSlot]
                callVal = self.genFnVal[callSlot]
            }
            val r: LLVMValueRef = LLVMBuildCall2(self.b, callTy, callVal, arrayCPtr(av), av.count(), anon())
            if f.hasRet {
                LLVMBuildRet(self.b, r)
            } else {
                LLVMBuildRetVoid(self.b)
            }
            s += 1
        }
    }
}
