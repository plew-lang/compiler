// Part of the LLVM backend (root: _.pw): the LLVM backend entry (emitLlvm), global init, and main.

// ---- the LLVM backend entry ----
//
// Build the module from the analyzed arena and print its IR. v1 emits the user's
// `main` only (other functions / types arrive in later increments).

pub impl LlvmCtx {

    // Global storage is declared from the frontend's selected TypeTerm, before
    // its initializer body runs.  This is the same separation as a local
    // alloca from the value later stored into it: backend storage metadata is
    // not an observation made by legacy expression emission.
    inout fn declareGlobalStorage(c: inout Comp) -> Bool {
        mut val gi: U64 = 0U64
        while gi < c.arena.globals.count() {
            val global = c.arena.globals[gi]
            if global.letStmt >= c.arena.stmts.count() { return false }
            mut val term: U64 = 0U64
            match c.arena.stmts[global.letStmt] {
                Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init) => { term = c.semanticExprTerm(exprId: init) }
                _ => { return false }
            }
            if term == 0U64 || term >= c.arena.typeCount() { return false }
            val typeRef = c.arena.typeAt(index: term)
            val lty: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: term)
            val gv: LLVMValueRef = LLVMAddGlobal(self.mod, lty, cstr(s: globalSymbol(idx: gi)))
            LLVMSetInitializer(gv, LLVMConstNull(lty))
            mut val isArray: Bool = rangeEquals(bytes: c.arena.bytes, start: typeRef.nameStart, len: typeRef.nameLen, kw: "Array") && typeRef.args.count() == 1U64
            mut val elementTerm: U64 = 0U64
            if isArray { elementTerm = typeRef.args[0U64] }
            mut val elementTy: LLVMTypeRef = self.i64ty
            mut val elementKind: U64 = 0U64
            if elementTerm != 0U64 && elementTerm < c.arena.typeCount() {
                elementTy = self.llvmTypeOfRef(c: inout c, ref: elementTerm)
                elementKind = kindFromTySpan(c: inout c, tyStart: c.arena.typeAt(index: elementTerm).nameStart, tyLen: c.arena.typeAt(index: elementTerm).nameLen)
            }
            mut val structIndex: U64 = self.localStructIdxFor(c: inout c, start: typeRef.nameStart, len: typeRef.nameLen)
            if c.isGenericInst(ref: term) {
                val genericSlot: U64 = self.genStructSlot(c: inout c, ref: term)
                if genericSlot < self.genStructDefs.count() { structIndex = self.genStructDefs[genericSlot] }
            }
            self.gvalRef.append(gv)
            self.gvalLty.append(lty)
            if isArray { self.gvalKind.append(elementKind) }
            else { self.gvalKind.append(kindFromTySpan(c: inout c, tyStart: typeRef.nameStart, tyLen: typeRef.nameLen)) }
            self.gvalSidx.append(structIndex)
            self.gvalIsArr.append(isArray)
            self.gvalElemTy.append(elementTy)
            self.gvalElemKind.append(elementKind)
            self.gvalTref.append(term)
            self.gvalElemTypeRef.append(elementTerm)
            gi += 1U64
        }
        return self.gvalRef.count() == c.arena.globals.count()
    }

    // Emit `void @plew_init_globals()` (spec/15): one body that runs each module-level
    // variable's initializer in lowering (= declaration) order and moves each
    // fully-evaluated temporary into predeclared storage through the synthetic
    // canonical Mid body. Global storage is process-lifetime, so this is an
    // initialization transfer, not an overwrite or a scope-exit drop.
    inout fn genLlvmInitGlobals(c: inout Comp) {
        if c.arena.globals.count() == 0U64 {
            return
        }
        mut val noParams: Array[LLVMTypeRef] = []
        val fnTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noParams), 0U64, 0I32)
        val fv: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_init_globals", fnTy: fnTy)
        self.curFn = fv
        self.curIsMain = false
        self.curRetVoid = true
        self.curAsync = false
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        c.cur.bodyFnIdx = 18446744073709551615U64
        c.cur.bodyEnvironment = <InstanceEnvironment />
        c.cur.bodyId = 0U64
        self.beginFnBody(fv: fv)
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        val storageReady: Bool = self.declareGlobalStorage(c: inout c)
        val globalOwner: U64 = 18446744073709551615U64
        val bodyId: U64 = c.findBodyInstance(fnIdx: globalOwner, environment: <InstanceEnvironment />)
        mut val midReady: Bool = false
        if !storageReady {
            self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: globalOwner, reason: <MidLlvmPreflight.Terminator />)
        } else if bodyId == 0U64 {
            self.recordMidMissingBodyInstance(c: inout c, bodyId: bodyId, fnIdx: globalOwner)
        } else {
            val parametric: MidBodyBuild = buildParametricMidGlobalInit(c: inout c)
            match parametric.error {
                MidBuildError.None => {
                    val instantiated: MidCanonicalInstantiation = instantiateCanonicalMidBody(c: inout c, body: parametric.canonical, bodyId: bodyId)
                    match instantiated.error {
                        MidInstantiateError.None => {
                            val accesses: MidCanonicalAccessElaboration = elaborateCanonicalMidAccesses(c: inout c, canonical: instantiated.body)
                            match accesses.error {
                                MidAccessError.None => {
                                    val dropped: MidCanonicalBody = elaborateCanonicalMidDrops(c: inout c, canonical: optimizeCanonicalMidReturns(arena: inout c.mid, canonical: accesses.body))
                                    val verification: MidVerification = verifyCanonicalMidBody(c: c, canonical: dropped)
                                    match verification.error {
                                        MidVerifyError.None => {
                                            // Preflight before emission so an unsupported
                                            // Mid shape cannot leave a half-emitted global
                                            // initializer before the legacy compatibility path.
                                            val preflight: MidLlvmPreflight = self.midCanonicalLlvmPreflight(c: inout c, canonical: dropped)
                                            match preflight {
                                                MidLlvmPreflight.Ready => { midReady = self.genLlvmCanonicalMidBody(c: inout c, canonical: dropped) }
                                                _ => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: globalOwner, reason: preflight) }
                                            }
                                        }
                                        _ => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: globalOwner, reason: verification.error) }
                                    }
                                }
                                _ => { self.recordMidAccess(c: inout c, bodyId: bodyId, fnIdx: globalOwner) }
                            }
                        }
                        _ => { self.recordMidInstantiate(c: inout c, bodyId: bodyId, fnIdx: globalOwner, reason: instantiated.error) }
                    }
                }
                _ => { self.recordMidBuildError(c: inout c, bodyId: bodyId, fnIdx: globalOwner, error: parametric.error) }
            }
        }
        if !midReady {
            if c.requireMid {
                c.errorAt(offset: c.arena.globals[0U64].nameStart, msg: "internal error: global initializer body is not representable in Mid")
            } else {
                mut val gi: U64 = 0U64
                while gi < c.arena.globals.count() {
                    self.genLlvmStmt(c: inout c, id: c.arena.globals[gi].letStmt)
                    val li: U64 = self.nLocals - 1U64
                    val cur: LLVMValueRef = LLVMBuildLoad2(self.b, self.gvalLty[gi], self.locPtr[li], anon())
                    LLVMBuildStore(self.b, cur, self.gvalRef[gi])
                    gi += 1U64
                }
            }
        }
        LLVMBuildRetVoid(self.b)
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyEnvironment = savedBodyEnvironment
        c.cur.bodyId = 0U64
    }
}

pub impl LlvmCtx {

    // Re-register every module-level variable as a local pointing at its LLVM global, so
    // reads (`x`), writes (`x = …` for a `mut val` global), and all type-recovery
    // (`x.field`, `x[i]`, method dispatch) resolve through the normal local machinery
    // (findLocal). Called at the start of each function/closure/async body AFTER the local
    // reset and BEFORE params/captures — so a same-named param or local shadows the global
    // (findLocal returns the most-recently pushed match).
    inout fn seedGlobals(c: inout Comp) {
        mut val gi: U64 = 0
        while gi < self.gvalRef.count() {
            self.pushLocalR(nameStart: c.arena.globals[gi].nameStart, nameLen: c.arena.globals[gi].nameLen, ptr: self.gvalRef[gi], ty: self.gvalLty[gi], kind: self.gvalKind[gi], structIdx: self.gvalSidx[gi], isArr: self.gvalIsArr[gi], elemTy: self.gvalElemTy[gi], elemKind: self.gvalElemKind[gi], typeRef: self.gvalTref[gi])
            // a seeded global is a BORROW of the module-lifetime owner — the ownership
            // flag says so honestly (the scope-exit drop reads locOwned, not a position
            // gate), so no body ever releases it.
            self.setLocalOwned(owned: false)
            self.setLocalElemTypeRef(ref: self.gvalElemTypeRef[gi])
            gi += 1
        }
    }

    // Emit the user `main` as C `i32 @main()` returning 0 (Plew main returns ()).
    inout fn genLlvmMain(c: inout Comp, fi: U64) {
        // `i32 main(i32 argc, ptr argv)` so the program can read its command-line args
        // (@Std/Process argCount/argAt) — the args are stashed into the runtime via
        // plew_set_args before the body runs.
        mut val mainParams: Array[LLVMTypeRef] = []
        mainParams.append(self.i32ty)
        mainParams.append(self.ptrty)
        val mainTy: LLVMTypeRef = LLVMFunctionType(self.i32ty, arrayCPtr(mainParams), 2U64, 0I32)
        val mainFn: LLVMValueRef = LLVMAddFunction(self.mod, cstr(s: "main"), mainTy)
        self.curFn = mainFn
        self.curIsMain = true
        self.curRetVoid = false
        // Build and freeze a Mid body before LLVM emission begins. Global
        // reads/writes carry explicit Global(declarationTarget) place roots;
        // they are never recovered through legacy seeded locals.
        mut val midReady: Bool = false
        mut val canonicalMid: MidCanonicalBody = <MidCanonicalBody body=0U64 />
        val rootEnvironment: InstanceEnvironment = <InstanceEnvironment />
        val bodyId: U64 = c.findBodyInstance(fnIdx: fi, environment: rootEnvironment)
        // Global LLVM storage is emitted before every function body. Refuse
        // Mid rather than fabricate a local root if that initialization ever
        // failed to produce the complete declaration-target map.
        if self.gvalRef.count() == c.arena.globals.count() {
            val parametric: MidBodyBuild = buildParametricMidBody(c: inout c, fnIdx: fi)
            match parametric.error {
                MidBuildError.None => {
                    if bodyId != 0U64 {
                        val instantiated: MidCanonicalInstantiation = instantiateCanonicalMidBody(c: inout c, body: parametric.canonical, bodyId: bodyId)
                        match instantiated.error {
                            MidInstantiateError.None => {
                                val accesses: MidCanonicalAccessElaboration = elaborateCanonicalMidAccesses(c: inout c, canonical: instantiated.body)
                                mut val accessReady: Bool = true
                                match accesses.error {
                                    MidAccessError.None => {}
                                    _ => {
                                        accessReady = false
                                        self.recordMidAccess(c: inout c, bodyId: bodyId, fnIdx: fi)
                                        if c.traceCodegen {
                                            eprint(text: "[trace-codegen] Mid main: access elaboration error=")
                                            match accesses.error {
                                                MidAccessError.MissingOuterSemanticAccess => { eprint(text: "missing-outer-semantic-access") }
                                                MidAccessError.AccessRoleMismatch => { eprint(text: "role-mismatch") }
                                                MidAccessError.UnresolvedAccessCall => { eprint(text: "unresolved-access-call") }
                                                MidAccessError.ParentAccessArgumentMissing => { eprint(text: "parent-argument-missing") }
                                                MidAccessError.ParentAccessArgumentMismatch => { eprint(text: "parent-argument-mismatch") }
                                                MidAccessError.InvalidAccessChain => { eprint(text: "invalid-chain") }
                                                MidAccessError.UnsupportedAccessBase => { eprint(text: "unsupported-base") }
                                                MidAccessError.UnsupportedAccessKey => { eprint(text: "unsupported-key") }
                                                MidAccessError.UnsupportedAccessProjection => { eprint(text: "unsupported-projection") }
                                                MidAccessError.UnsupportedSetterReceiver => { eprint(text: "unsupported-setter-receiver") }
                                                _ => { eprint(text: "unknown") }
                                            }
                                            eprint(text: "\n")
                                        }
                                    }
                                }
                                if accessReady {
                                    val elaborated: MidCanonicalBody = elaborateCanonicalMidDrops(c: inout c, canonical: optimizeCanonicalMidReturns(arena: inout c.mid, canonical: accesses.body))
                                    val verification: MidVerification = verifyCanonicalMidBody(c: c, canonical: elaborated)
                                    match verification.error {
                                        MidVerifyError.None => {
                                            match self.midCanonicalLlvmPreflight(c: inout c, canonical: elaborated) {
                                                MidLlvmPreflight.Ready => {
                                                    canonicalMid = elaborated
                                                    midReady = true
                                                }
                                                MidLlvmPreflight.AbiLocals => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.AbiLocals />) }
                                                MidLlvmPreflight.AssignmentProjection => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.AssignmentProjection />) }
                                                MidLlvmPreflight.UnsupportedRvalue => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.UnsupportedRvalue />) }
                                                MidLlvmPreflight.ConversionOperand => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ConversionOperand />) }
                                                MidLlvmPreflight.DropProjection => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.DropProjection />) }
                                                MidLlvmPreflight.ScopeExit => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ScopeExit />) }
                                                MidLlvmPreflight.Switch => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Switch />) }
                                                MidLlvmPreflight.Call(reason: val reason) => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Call reason=reason />) }
                                                MidLlvmPreflight.ReturnValue => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ReturnValue />) }
                                                MidLlvmPreflight.Terminator => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Terminator />) }
                                            }
                                        }
                                        _ => {
                                            match verification.error {
                                                MidVerifyError.InvalidTarget => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.PartialMove => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.MoveUnavailable => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.DropUnavailable => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.InvalidDropFlag => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.UninitializedDropFlag => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.UnelaboratedBindingEnd => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.UnelaboratedScopeExit => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.UnelaboratedAccess => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.UninstantiatedReturnBoundary => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                MidVerifyError.UninstantiatedCastBoundary => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                                _ => {}
                                            }
                                        if c.traceCodegen {
                                            eprint(text: "[trace-codegen] Mid main: verifier error=")
                                            match verification.error {
                                                MidVerifyError.InvalidTarget => { eprint(text: "invalid-target") }
                                                MidVerifyError.PartialMove => { eprint(text: "partial-move") }
                                                MidVerifyError.MoveUnavailable => { eprint(text: "move-unavailable") }
                                                MidVerifyError.DropUnavailable => { eprint(text: "drop-unavailable") }
                                                MidVerifyError.InvalidDropFlag => { eprint(text: "invalid-drop-flag") }
                                                MidVerifyError.UninitializedDropFlag => { eprint(text: "uninitialized-drop-flag") }
                                                MidVerifyError.UnelaboratedBindingEnd => { eprint(text: "binding-end") }
                                                MidVerifyError.UnelaboratedScopeExit => { eprint(text: "scope-exit") }
                                                MidVerifyError.UninstantiatedCastBoundary => { eprint(text: "cast-boundary") }
                                                _ => { eprint(text: "unknown") }
                                            }
                                            eprint(text: " block=")
                                            self.traceCodegenU64(n: verification.block)
                                            eprint(text: " local=")
                                            self.traceCodegenU64(n: verification.local)
                                            eprint(text: "\n")
                                        }
                                    }
                                }
                            }
                            }
                            _ => {
                                self.recordMidInstantiate(c: inout c, bodyId: bodyId, fnIdx: fi, reason: instantiated.error)
                                if c.traceCodegen { eprint(text: "[trace-codegen] Mid main: instantiation failed\n") }
                            }
                        }
                    } else {
                        self.recordMidMissingBodyInstance(c: inout c, bodyId: bodyId, fnIdx: fi)
                        if c.traceCodegen { eprint(text: "[trace-codegen] Mid main: missing body instance\n") }
                    }
                }
                MidBuildError.InvalidStatement => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 1U64) }
                MidBuildError.InvalidBlock => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 2U64) }
                MidBuildError.InvalidFunction => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 3U64) }
                MidBuildError.MissingSemanticType => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 4U64) }
                MidBuildError.UnboundLocalIdentifier => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 5U64) }
                MidBuildError.Unsupported(reason: val unsupported) => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 100U64 + self.midUnsupportedBuildCoverageDetail(reason: unsupported)) }
                MidBuildError.UnsupportedAssign(reason: val reason) => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 20U64 + self.midUnsupportedAssignCoverageDetail(reason: reason)) }
                MidBuildError.UnsupportedWhile => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 7U64) }
                MidBuildError.UnsupportedFor => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 8U64) }
                MidBuildError.UnsupportedMatch => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 9U64) }
                MidBuildError.UnsupportedPanic => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 10U64) }
                MidBuildError.UnsupportedGive => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 11U64) }
                MidBuildError.UnsupportedBreak => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 12U64) }
                MidBuildError.UnsupportedContinue => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 13U64) }
                MidBuildError.MissingTerminator => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 14U64) }
                MidBuildError.MissingCallTemplate => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 15U64) }
                MidBuildError.UnsupportedCallTemplate => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 16U64) }
                _ => {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] Mid main: build error=")
                        match parametric.error {
                            MidBuildError.InvalidStatement => { eprint(text: "invalid-statement") }
                            MidBuildError.InvalidBlock => { eprint(text: "invalid-block") }
                            MidBuildError.InvalidFunction => { eprint(text: "invalid-function") }
                            MidBuildError.MissingSemanticType => { eprint(text: "missing-semantic-type") }
                            MidBuildError.UnboundLocalIdentifier => { eprint(text: "unbound-local") }
                            MidBuildError.Unsupported(reason: _) => { eprint(text: "unsupported") }
                            MidBuildError.MissingTerminator => { eprint(text: "missing-terminator") }
                            MidBuildError.MissingCallTemplate => { eprint(text: "missing-call-template") }
                            MidBuildError.UnsupportedCallTemplate => { eprint(text: "unsupported-call-template") }
                            _ => { eprint(text: "unknown") }
                        }
                        eprint(text: "\n")
                    }
                }
            }
        } else {
            self.recordMidEligibility(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidEligibilityReason.Globals />)
        }
        if c.functionRequiresOwnershipCfg(fnIdx: fi) && !midReady {
            val mainDef: Func = c.arena.functionAt(index: fi)
            c.errorAt(offset: mainDef.nameStart, msg: "internal error: conditional unique move requires Mid CFG lowering, but this body is not yet representable in Mid")
        }
        self.beginFnBody(fv: mainFn)
        // plew_set_args(argc, argv).
        mut val saTys: Array[LLVMTypeRef] = []
        saTys.append(self.i32ty)
        saTys.append(self.ptrty)
        val saTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(saTys), 2U64, 0I32)
        val saFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_set_args", fnTy: saTy)
        mut val saArgs: Array[LLVMValueRef] = []
        saArgs.append(LLVMGetParam(mainFn, 0U64))
        saArgs.append(LLVMGetParam(mainFn, 1U64))
        LLVMBuildCall2(self.b, saTy, saFn, arrayCPtr(saArgs), 2U64, anon())
        // initialize module-level variables (spec/15) before the body runs.
        self.callInitGlobals(c: inout c)
        if midReady {
            // canonical preflight completed before beginFnBody, so this
            // call cannot fail into an AST fallback after partially emitting a
            // function.  A failure here is therefore a backend invariant bug.
            if !(self.genLlvmCanonicalMidBody(c: inout c, canonical: canonicalMid)) {
                c.errorAt(offset: 0U64, msg: "internal error: preflighted Mid body failed LLVM lowering")
            }
            return
        }
        // fresh local scope.
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        self.seedGlobals(c: inout c)
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        val savedBodyId: U64 = c.cur.bodyId
        c.cur.bodyFnIdx = fi
        c.cur.bodyEnvironment = <InstanceEnvironment />
        // `finalizeCallables` closed every source call under the concrete main
        // BodyInstance.  Legacy LLVM lowering is still allowed while a main
        // body is outside Mid coverage, but it must consume that same frozen
        // identity rather than intern an unrelated argless body on demand.
        // Otherwise lookup misses the finalized descriptors and whole-module
        // pre-scanning merely happens to hide the broken provenance.
        c.cur.bodyId = bodyId
        // body locals (declared from here) are released at scope exit; seeded globals are not.
        self.curBodyMark = self.nLocals
        if c.traceCodegen {
            eprint(text: "[trace-codegen] legacy main body-start id=")
            self.traceCodegenU64(n: bodyId)
            eprint(text: "\n")
        }
        self.genLlvmBlock(c: inout c, id: c.arena.functionAt(index: fi).body)
        if c.traceCodegen { eprint(text: "[trace-codegen] legacy main body-done\n") }
        if !(self.terminated) {
            LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32))
        }
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyEnvironment = savedBodyEnvironment
        c.cur.bodyId = savedBodyId
    }

    // Emit a call to `plew_init_globals` (a no-op when there are no module-level vars).
    inout fn callInitGlobals(c: inout Comp) {
        if c.arena.globals.count() == 0U64 {
            return
        }
        mut val noParams: Array[LLVMTypeRef] = []
        val igTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noParams), 0U64, 0I32)
        val igFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_init_globals", fnTy: igTy)
        mut val noArgs: Array[LLVMValueRef] = []
        LLVMBuildCall2(self.b, igTy, igFn, arrayCPtr(noArgs), 0U64, anon())
    }
}
