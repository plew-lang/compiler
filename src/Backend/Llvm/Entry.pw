// Part of the LLVM backend (root: _.pw): the LLVM backend entry (emitLlvm), global init, and main.

// ---- the LLVM backend entry ----
//
// Build the module from the analyzed arena and print its IR. v1 emits the user's
// `main` only (other functions / types arrive in later increments).

pub impl LlvmCtx {

    // Global storage is declared from the frontend's selected TypeTerm, before
    // its initializer body runs.  This is the same separation as a local
    // alloca from the value later stored into it: backend storage metadata is
    // not an observation made by legacy expression emission.
    inout fn declareGlobalStorage(c: inout Comp, bodyId: U64, storage: LlvmGlobalStorage) -> Result[Bool, CompileDiagnostic] {
        if bodyId == 0U64 { return <Result.Ok value=false /> }
        if c.arena.globals.count() != 0U64 {
            val identitiesType = LLVMArrayType2(self.i8ty, c.arena.globals.count())
            val identityName = <CString.copied text="plew.global.identities" />
            val identities = LLVMAddGlobal(self.mod, identitiesType, identityName.ptr)
            match storage {
                LlvmGlobalStorage.Definition => { LLVMSetInitializer(identities, LLVMConstNull(identitiesType)) }
                LlvmGlobalStorage.Reference => {}
            }
            self.globalIdentityStorage = <Optional.Some v=identities />
        }
        mut val gi: U64 = 0U64
        while gi < c.arena.globals.count() {
            val global = c.arena.globals[gi]
            val descriptor = c.finalStorageIndex(bodyId: bodyId, stmtId: global.letStmt)
            if descriptor >= c.arena.finalStorages.count() { return <Result.Ok value=false /> }
            val term = c.arena.finalStorages[descriptor].targetTypeRef
            if term == 0U64 || term >= c.arena.typeCount() { return <Result.Ok value=false /> }
            val lty: LLVMTypeRef = (try self.llvmTypeOfRef(c: inout c, ref: term))
            val gvCString = <CString.copied text=globalSymbol(idx: gi) />
            val gv: LLVMValueRef = LLVMAddGlobal(self.mod, lty, gvCString.ptr)
            match storage {
                LlvmGlobalStorage.Definition => { LLVMSetInitializer(gv, LLVMConstNull(lty)) }
                LlvmGlobalStorage.Reference => {}
            }
            self.gvalRef.append(gv)
            self.gvalLty.append(lty)
            self.gvalTref.append(term)
            gi += 1U64
        }
        return <Result.Ok value=self.gvalRef.count() == c.arena.globals.count() />
    }

    // Emit `void @plew_init_globals()` (spec/15): one body that runs each module-level
    // variable's initializer in lowering (= declaration) order and moves each
    // fully-evaluated temporary into predeclared storage through the synthetic
    // canonical Mid body. Global storage is process-lifetime, so this is an
    // initialization transfer, not an overwrite or a scope-exit drop.
    inout fn genLlvmInitGlobals(c: inout Comp) -> Result[(), CompileDiagnostic] {
        if c.arena.globals.count() == 0U64 {
            return <Result.Ok value=() />
        }
        val globalOwner: U64 = 18446744073709551615U64
        val bodyId: U64 = c.findBodyInstance(fnIdx: globalOwner, environment: <InstanceEnvironment />)
        if !self.admitBody(bodyId: bodyId) { return <Result.Ok value=() /> }
        mut val noParams: Array[LLVMTypeRef] = []
        val fnTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noParams), 0U64, 0I32)
        val fv: LLVMValueRef = (try self.getOrDeclare(c: inout c, name: "plew_init_globals", fnTy: fnTy))
        self.attachBodyIdentity(function: fv, bodyId: bodyId)
        self.curFn = fv
        self.curIsMain = false
        self.curRetVoid = true
        self.beginFnBody(fv: fv)
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        val storageReady: Bool = self.gvalRef.count() == c.arena.globals.count()
        mut val midReady: Bool = false
        if !storageReady {
            self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: globalOwner, reason: <MidLlvmPreflight.Terminator />)
        } else if bodyId == 0U64 {
            self.recordMidMissingBodyInstance(c: inout c, bodyId: bodyId, fnIdx: globalOwner)
        } else {
            val prepared = (try self.prepareCanonicalForLlvm(c: inout c, bodyId: bodyId, fnIdx: globalOwner, parameterCount: 0U64))
            match prepared {
                MidLlvmPrepared.Ready(canonical: _, abiParameterCount: _) => { midReady = (try self.genLlvmPreparedMidBody(c: inout c, prepared: prepared)) }
                _ => {}
            }
        }
        if !midReady {
            return <Result.Err error=c.diagnosticAt(offset: c.arena.globals[0U64].nameStart, msg: "internal error: global initializer requires verified Mid lowering") />
        }
        return <Result.Ok value=() />
    }
}

pub impl LlvmCtx {

    fn mainFunctionType() -> LLVMTypeRef {
        val parameters = [self.i32ty, self.ptrty]
        return LLVMFunctionType(self.i32ty, arrayCPtr(parameters), 2U64, 0I32)
    }

    inout fn initializeProgramArguments(c: inout Comp, function: LLVMValueRef) -> Result[(), CompileDiagnostic] {
        val parameters = [self.i32ty, self.ptrty]
        val signature = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 2U64, 0I32)
        val setter = (try self.getOrDeclare(c: inout c, name: "plew_set_args", fnTy: signature))
        val arguments = [LLVMGetParam(function, 0U64), LLVMGetParam(function, 1U64)]
        LLVMBuildCall2(self.b, signature, setter, arrayCPtr(arguments), 2U64, anon())
        return <Result.Ok value=() />
    }

    inout fn declareProgramEntries(c: inout Comp) -> Result[(), CompileDiagnostic] {
        for bodyId in c.monoWork.bodies() {
            val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
            if body.fnIdx < c.arena.functionCount() && c.nameIsMain(f: c.arena.functionAt(index: body.fnIdx)) {
                val signature = self.mainFunctionType()
                val entry = (try self.getOrDeclare(c: inout c, name: "main", fnTy: signature))
                self.attachBodyIdentity(function: entry, bodyId: bodyId)
            }
        }
        if c.arena.globals.count() != 0U64 {
            val parameters: Array[LLVMTypeRef] = []
            val signature = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 0U64, 0I32)
            val entry = (try self.getOrDeclare(c: inout c, name: "plew_init_globals", fnTy: signature))
            self.attachBodyIdentity(function: entry, bodyId: c.findBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />))
        }
        return <Result.Ok value=() />
    }

    // Emit the user `main` as C `i32 @main()` returning 0 (Plew main returns ()).
    inout fn genLlvmMain(c: inout Comp, fi: U64) -> Result[(), CompileDiagnostic] {
        val rootEnvironment: InstanceEnvironment = <InstanceEnvironment />
        val bodyId: U64 = c.findBodyInstance(fnIdx: fi, environment: rootEnvironment)
        if !self.admitBody(bodyId: bodyId) { return <Result.Ok value=() /> }
        // `i32 main(i32 argc, ptr argv)` so the program can read its command-line args
        // (@Std/Process argCount/argAt) — the args are stashed into the runtime via
        // plew_set_args before the body runs.
        val mainTy: LLVMTypeRef = self.mainFunctionType()
        val mainFnCString = <CString.copied text="main" />
        val mainFn: LLVMValueRef = LLVMAddFunction(self.mod, mainFnCString.ptr, mainTy)
        self.attachBodyIdentity(function: mainFn, bodyId: bodyId)
        self.curFn = mainFn
        self.curIsMain = true
        self.curRetVoid = false
        // Build and freeze a Mid body before LLVM emission begins. Global
        // reads/writes carry explicit Global(declarationTarget) place roots;
        // they are never recovered through legacy seeded locals.
        mut val midReady: Bool = false
        mut val preparedMid: MidLlvmPrepared = <MidLlvmPrepared.None />
        // Global LLVM storage is emitted before every function body. Refuse
        // Mid rather than fabricate a local root if that initialization ever
        // failed to produce the complete declaration-target map.
        if self.gvalRef.count() == c.arena.globals.count() {
            preparedMid = (try self.prepareCanonicalForLlvm(c: inout c, bodyId: bodyId, fnIdx: fi, parameterCount: 0U64))
            match preparedMid {
                MidLlvmPrepared.Ready(canonical: _, abiParameterCount: _) => { midReady = true }
                _ => {}
            }
        } else {
            self.recordMidEligibility(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidEligibilityReason.Globals />)
        }
        if !midReady {
            val mainDef: Func = c.arena.functionAt(index: fi)
            return <Result.Err error=c.diagnosticAt(offset: mainDef.nameStart, msg: "internal error: main requires verified Mid lowering") />
        }
        self.beginFnBody(fv: mainFn)
        try self.initializeProgramArguments(c: inout c, function: mainFn)
        // initialize module-level variables (spec/15) before the body runs.
        try self.callInitGlobals(c: inout c)
        if midReady {
            // canonical preflight completed before beginFnBody, so this
            // call cannot fail into an AST fallback after partially emitting a
            // function.  A failure here is therefore a backend invariant bug.
            if !((try self.genLlvmPreparedMidBody(c: inout c, prepared: preparedMid))) {
                return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: preflighted Mid body failed LLVM lowering") />
            }
            return <Result.Ok value=() />
        }
        return <Result.Ok value=() />
    }

    // Emit a call to `plew_init_globals` (a no-op when there are no module-level vars).
    inout fn callInitGlobals(c: inout Comp) -> Result[(), CompileDiagnostic] {
        if c.arena.globals.count() == 0U64 {
            return <Result.Ok value=() />
        }
        mut val noParams: Array[LLVMTypeRef] = []
        val igTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noParams), 0U64, 0I32)
        val igFn: LLVMValueRef = (try self.getOrDeclare(c: inout c, name: "plew_init_globals", fnTy: igTy))
        val bodyId = c.findBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
        self.attachBodyIdentity(function: igFn, bodyId: bodyId)
        mut val noArgs: Array[LLVMValueRef] = []
        LLVMBuildCall2(self.b, igTy, igFn, arrayCPtr(noArgs), 0U64, anon())
        return <Result.Ok value=() />
    }
}
