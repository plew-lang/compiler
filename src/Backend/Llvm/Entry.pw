// Part of the LLVM backend (root: _.pw): the LLVM backend entry (emitLlvm), global init, and main.

// ---- the LLVM backend entry ----
//
// Build the module from the analyzed arena and print its IR. v1 emits the user's
// `main` only (other functions / types arrive in later increments).

pub impl LlvmCtx {

    // Emit `void @plew_init_globals()` (spec/15): one body that runs each module-level
    // variable's initializer in lowering (= declaration) order and stores the result into
    // its LLVM global. Each initializer is the same `Stmt.Let` a local binding produces,
    // so we emit it through the normal statement path (which pushes a fully-typed local +
    // alloca), then copy that local's recovered value into a fresh LLVM global and record
    // its metadata in `gval*` so `seedGlobals` can re-bind it at every body entry. A later
    // global's initializer can reference an earlier one (resolved as the alloca-local just
    // pushed). Globals are program-lifetime, so they are never deinit'd (no scope-exit
    // drop here — the same leak level as a top-level array/String value).
    inout fn genLlvmInitGlobals(c: inout Comp) {
        if c.arena.globals.count() == 0U64 {
            return
        }
        mut val noParams: Array[LLVMTypeRef] = []
        val fnTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noParams), 0U64, 0I32)
        val fv: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_init_globals", nameId: 9120U64, fnTy: fnTy)
        self.curFn = fv
        self.curIsMain = false
        self.curRetVoid = true
        self.curAsync = false
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        c.cur.bodyFnIdx = 18446744073709551615U64
        c.cur.bodyEnvironment = <InstanceEnvironment />
        c.cur.bodyId = 0U64
        self.beginFnBody(fv: fv)
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        mut val gi: U64 = 0
        while gi < c.arena.globals.count() {
            self.genLlvmStmt(c: inout c, id: c.arena.globals[gi].letStmt)
            val li: U64 = self.nLocals - 1U64
            val lty: LLVMTypeRef = self.locTy[li]
            val gv: LLVMValueRef = LLVMAddGlobal(self.mod, lty, cstr(s: globalSymbol(idx: gi)))
            LLVMSetInitializer(gv, LLVMConstNull(lty))
            val cur: LLVMValueRef = LLVMBuildLoad2(self.b, lty, self.locPtr[li], anon())
            LLVMBuildStore(self.b, cur, gv)
            self.gvalRef.append(gv)
            self.gvalLty.append(lty)
            self.gvalKind.append(self.locKind[li])
            self.gvalSidx.append(self.locStructIdx[li])
            self.gvalIsArr.append(self.locIsArr[li])
            self.gvalElemTy.append(self.locElemTy[li])
            self.gvalElemKind.append(self.locElemKind[li])
            self.gvalTref.append(self.locTypeRef[li])
            self.gvalElemTypeRef.append(self.locElemTypeRef[li])
            gi += 1
        }
        LLVMBuildRetVoid(self.b)
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyEnvironment = savedBodyEnvironment
        c.cur.bodyId = 0U64
    }
}

pub impl LlvmCtx {

    // Re-register every module-level variable as a local pointing at its LLVM global, so
    // reads (`x`), writes (`x = …` for a `mut val` global), and all type-recovery
    // (`x.field`, `x[i]`, method dispatch) resolve through the normal local machinery
    // (findLocal). Called at the start of each function/closure/async body AFTER the local
    // reset and BEFORE params/captures — so a same-named param or local shadows the global
    // (findLocal returns the most-recently pushed match).
    inout fn seedGlobals(c: inout Comp) {
        mut val gi: U64 = 0
        while gi < self.gvalRef.count() {
            self.pushLocalR(nameStart: c.arena.globals[gi].nameStart, nameLen: c.arena.globals[gi].nameLen, ptr: self.gvalRef[gi], ty: self.gvalLty[gi], kind: self.gvalKind[gi], structIdx: self.gvalSidx[gi], isArr: self.gvalIsArr[gi], elemTy: self.gvalElemTy[gi], elemKind: self.gvalElemKind[gi], typeRef: self.gvalTref[gi])
            // a seeded global is a BORROW of the module-lifetime owner — the ownership
            // flag says so honestly (the scope-exit drop reads locOwned, not a position
            // gate), so no body ever releases it.
            self.setLocalOwned(owned: false)
            self.setLocalElemTypeRef(ref: self.gvalElemTypeRef[gi])
            gi += 1
        }
    }

    // Emit the user `main` as C `i32 @main()` returning 0 (Plew main returns ()).
    inout fn genLlvmMain(c: inout Comp, fi: U64) {
        // `i32 main(i32 argc, ptr argv)` so the program can read its command-line args
        // (@Std/Process argCount/argAt) — the args are stashed into the runtime via
        // plew_set_args before the body runs.
        mut val mainParams: Array[LLVMTypeRef] = []
        mainParams.append(self.i32ty)
        mainParams.append(self.ptrty)
        val mainTy: LLVMTypeRef = LLVMFunctionType(self.i32ty, arrayCPtr(mainParams), 2U64, 0I32)
        val mainFn: LLVMValueRef = LLVMAddFunction(self.mod, cstr(s: "main"), mainTy)
        self.curFn = mainFn
        self.curIsMain = true
        self.curRetVoid = false
        // Build and freeze a Mid body before LLVM emission begins.  This first
        // production slice admits only a closed main with no module globals:
        // globals, ABI parameters, calls and aggregate values gain explicit
        // Mid forms rather than being recovered through legacy backend state.
        mut val midReady: Bool = false
        mut val midBody: MidBody = <MidBody />
        val rootEnvironment: InstanceEnvironment = <InstanceEnvironment />
        val bodyId: U64 = c.findBodyInstance(fnIdx: fi, environment: rootEnvironment)
        if c.arena.globals.count() == 0U64 {
            val parametric: MidBodyBuild = buildParametricMidBody(c: inout c, fnIdx: fi)
            match parametric.error {
                MidBuildError.None => {
                    if bodyId != 0U64 {
                        val instantiated: MidInstantiation = instantiateMidBody(c: inout c, body: parametric.body, bodyId: bodyId)
                        match instantiated.error {
                            MidInstantiateError.None => {
                                val accesses: MidAccessElaboration = elaborateMidAccesses(c: inout c, body: instantiated.body)
                                mut val accessReady: Bool = true
                                match accesses.error {
                                    MidAccessError.None => {}
                                    _ => {
                                        accessReady = false
                                        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Access />)
                                        if c.traceCodegen {
                                            eprint(text: "[trace-codegen] Mid main: access elaboration error=")
                                            match accesses.error {
                                                MidAccessError.MissingOuterSemanticAccess => { eprint(text: "missing-outer-semantic-access") }
                                                MidAccessError.AccessRoleMismatch => { eprint(text: "role-mismatch") }
                                                MidAccessError.UnresolvedAccessCall => { eprint(text: "unresolved-access-call") }
                                                MidAccessError.ParentAccessArgumentMissing => { eprint(text: "parent-argument-missing") }
                                                MidAccessError.ParentAccessArgumentMismatch => { eprint(text: "parent-argument-mismatch") }
                                                MidAccessError.InvalidAccessChain => { eprint(text: "invalid-chain") }
                                                MidAccessError.UnsupportedAccessBase => { eprint(text: "unsupported-base") }
                                                MidAccessError.UnsupportedAccessKey => { eprint(text: "unsupported-key") }
                                                MidAccessError.UnsupportedAccessProjection => { eprint(text: "unsupported-projection") }
                                                MidAccessError.UnsupportedSetterReceiver => { eprint(text: "unsupported-setter-receiver") }
                                                _ => { eprint(text: "unknown") }
                                            }
                                            eprint(text: "\n")
                                        }
                                    }
                                }
                                if accessReady {
                                    val elaborated: MidBody = elaborateMidDrops(body: accesses.body)
                                    val verification: MidVerification = verifyMidBody(body: elaborated)
                                    match verification.error {
                                        MidVerifyError.None => {
                                            match self.midInitialLlvmPreflight(c: inout c, body: elaborated) {
                                                MidLlvmPreflight.Ready => {
                                                    midBody = elaborated
                                                    midReady = true
                                                }
                                                MidLlvmPreflight.AbiLocals => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.AbiLocals />) }
                                                MidLlvmPreflight.AssignmentProjection => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.AssignmentProjection />) }
                                                MidLlvmPreflight.UnsupportedRvalue => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.UnsupportedRvalue />) }
                                                MidLlvmPreflight.ConversionOperand => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ConversionOperand />) }
                                                MidLlvmPreflight.DropProjection => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.DropProjection />) }
                                                MidLlvmPreflight.ScopeExit => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ScopeExit />) }
                                                MidLlvmPreflight.Switch => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Switch />) }
                                                MidLlvmPreflight.Call(reason: val reason) => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Call reason=reason />) }
                                                MidLlvmPreflight.ReturnValue => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ReturnValue />) }
                                                MidLlvmPreflight.Terminator => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Terminator />) }
                                            }
                                        }
                                        _ => {
                                            match verification.error {
                                                MidVerifyError.InvalidTarget => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.InvalidTarget /> />) }
                                                MidVerifyError.PartialMove => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.PartialMove /> />) }
                                                MidVerifyError.MoveUnavailable => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.MoveUnavailable /> />) }
                                                MidVerifyError.DropUnavailable => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.DropUnavailable /> />) }
                                                MidVerifyError.InvalidDropFlag => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.InvalidDropFlag /> />) }
                                                MidVerifyError.UnelaboratedScopeExit => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.UnelaboratedScopeExit /> />) }
                                                MidVerifyError.UnelaboratedAccess => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.UnelaboratedAccess /> />) }
                                                MidVerifyError.UninstantiatedReturnBoundary => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Verify reason=<MidVerifyError.UninstantiatedReturnBoundary /> />) }
                                                _ => {}
                                            }
                                        if c.traceCodegen {
                                            eprint(text: "[trace-codegen] Mid main: verifier error=")
                                            match verification.error {
                                                MidVerifyError.InvalidTarget => { eprint(text: "invalid-target") }
                                                MidVerifyError.PartialMove => { eprint(text: "partial-move") }
                                                MidVerifyError.MoveUnavailable => { eprint(text: "move-unavailable") }
                                                MidVerifyError.DropUnavailable => { eprint(text: "drop-unavailable") }
                                                MidVerifyError.InvalidDropFlag => { eprint(text: "invalid-drop-flag") }
                                                MidVerifyError.UnelaboratedScopeExit => { eprint(text: "scope-exit") }
                                                _ => { eprint(text: "unknown") }
                                            }
                                            eprint(text: " block=")
                                            self.traceCodegenU64(n: verification.block)
                                            eprint(text: " local=")
                                            self.traceCodegenU64(n: verification.local)
                                            eprint(text: "\n")
                                        }
                                    }
                                }
                            }
                            }
                            _ => {
                                self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Instantiate />)
                                if c.traceCodegen { eprint(text: "[trace-codegen] Mid main: instantiation failed\n") }
                            }
                        }
                    } else {
                        self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.MissingBodyInstance />)
                        if c.traceCodegen { eprint(text: "[trace-codegen] Mid main: missing body instance\n") }
                    }
                }
                MidBuildError.InvalidStatement => {
                    self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.InvalidStatement /> />)
                    if c.traceCodegen { eprint(text: "[trace-codegen] Mid main: build invalid-statement\n") }
                }
                MidBuildError.InvalidBlock => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.InvalidBlock /> />) }
                MidBuildError.InvalidFunction => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.InvalidFunction /> />) }
                MidBuildError.MissingSemanticType => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.MissingSemanticType /> />) }
                MidBuildError.UnboundLocalIdentifier => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnboundLocalIdentifier /> />) }
                MidBuildError.Unsupported(reason: _) => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=parametric.error />) }
                MidBuildError.UnsupportedAssign => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedAssign /> />) }
                MidBuildError.UnsupportedWhile => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedWhile /> />) }
                MidBuildError.UnsupportedFor => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedFor /> />) }
                MidBuildError.UnsupportedMatch => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedMatch /> />) }
                MidBuildError.UnsupportedPanic => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedPanic /> />) }
                MidBuildError.UnsupportedGive => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedGive /> />) }
                MidBuildError.UnsupportedBreak => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedBreak /> />) }
                MidBuildError.UnsupportedContinue => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedContinue /> />) }
                MidBuildError.MissingTerminator => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.MissingTerminator /> />) }
                MidBuildError.MissingCallTemplate => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.MissingCallTemplate /> />) }
                MidBuildError.UnsupportedCallTemplate => { self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Build reason=<MidBuildError.UnsupportedCallTemplate /> />) }
                _ => {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] Mid main: build error=")
                        match parametric.error {
                            MidBuildError.InvalidStatement => { eprint(text: "invalid-statement") }
                            MidBuildError.InvalidBlock => { eprint(text: "invalid-block") }
                            MidBuildError.InvalidFunction => { eprint(text: "invalid-function") }
                            MidBuildError.MissingSemanticType => { eprint(text: "missing-semantic-type") }
                            MidBuildError.UnboundLocalIdentifier => { eprint(text: "unbound-local") }
                            MidBuildError.Unsupported(reason: _) => { eprint(text: "unsupported") }
                            MidBuildError.MissingTerminator => { eprint(text: "missing-terminator") }
                            MidBuildError.MissingCallTemplate => { eprint(text: "missing-call-template") }
                            MidBuildError.UnsupportedCallTemplate => { eprint(text: "unsupported-call-template") }
                            _ => { eprint(text: "unknown") }
                        }
                        eprint(text: "\n")
                    }
                }
            }
        } else {
            self.recordMidCoverage(c: inout c, bodyId: bodyId, fnIdx: fi, category: <MidCoverageCategory.Eligibility reason=<MidEligibilityReason.Globals /> />)
        }
        if c.functionRequiresOwnershipCfg(fnIdx: fi) && !midReady {
            val mainDef: Func = c.arena.funcs[fi]
            c.errorAt(offset: mainDef.nameStart, msg: "internal error: conditional unique move requires Mid CFG lowering, but this body is not yet representable in Mid")
        }
        self.beginFnBody(fv: mainFn)
        // plew_set_args(argc, argv).
        mut val saTys: Array[LLVMTypeRef] = []
        saTys.append(self.i32ty)
        saTys.append(self.ptrty)
        val saTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(saTys), 2U64, 0I32)
        val saFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_set_args", nameId: 56U64, fnTy: saTy)
        mut val saArgs: Array[LLVMValueRef] = []
        saArgs.append(LLVMGetParam(mainFn, 0U64))
        saArgs.append(LLVMGetParam(mainFn, 1U64))
        LLVMBuildCall2(self.b, saTy, saFn, arrayCPtr(saArgs), 2U64, anon())
        // initialize module-level variables (spec/15) before the body runs.
        self.callInitGlobals(c: inout c)
        if midReady {
            // `midInitialLlvmSupported` completed before beginFnBody, so this
            // call cannot fail into an AST fallback after partially emitting a
            // function.  A failure here is therefore a backend invariant bug.
            if !(self.genLlvmMidBody(c: inout c, body: midBody)) {
                c.errorAt(offset: 0U64, msg: "internal error: preflighted Mid body failed LLVM lowering")
            }
            return
        }
        // fresh local scope.
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        self.seedGlobals(c: inout c)
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        c.cur.bodyFnIdx = fi
        c.cur.bodyEnvironment = <InstanceEnvironment />
        c.cur.bodyId = 0U64
        // body locals (declared from here) are released at scope exit; seeded globals are not.
        self.curBodyMark = self.nLocals
        self.genLlvmBlock(c: inout c, id: c.arena.funcs[fi].body)
        if !(self.terminated) {
            LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32))
        }
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyEnvironment = savedBodyEnvironment
        c.cur.bodyId = 0U64
    }

    // Emit a call to `plew_init_globals` (a no-op when there are no module-level vars).
    inout fn callInitGlobals(c: inout Comp) {
        if c.arena.globals.count() == 0U64 {
            return
        }
        mut val noParams: Array[LLVMTypeRef] = []
        val igTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noParams), 0U64, 0I32)
        val igFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_init_globals", nameId: 9120U64, fnTy: igTy)
        mut val noArgs: Array[LLVMValueRef] = []
        LLVMBuildCall2(self.b, igTy, igFn, arrayCPtr(noArgs), 0U64, anon())
    }
}
