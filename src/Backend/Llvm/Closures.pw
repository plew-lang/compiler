// Part of the LLVM backend (root: _.pw): closure capture, env, declaration, and emission (lambda lifting).

// ---- closures (lambda-lifted function values) ----
//
// The captures of closure `cloId`, in declaration order (the env struct layout).

pub impl LlvmCtx {

    // The captured variable's own VALUE type (ignoring boxing) — the type stored in
    // the shared cell for a boxed capture, or in the env slot for a by-value one.
    inout fn captureValueTy(c: inout Comp, cap: CaptureEntry) -> Result[LLVMTypeRef, CompileDiagnostic] {
        return self.llvmTypeOfRef(c: inout c, ref: cap.ty)
    }

    // The LLVM type of a capture slot in the env struct: a `mut val` (boxed) capture is
    // a pointer to the shared cell; otherwise the captured value's own type.
    inout fn captureSlotTy(c: inout Comp, cap: CaptureEntry) -> Result[LLVMTypeRef, CompileDiagnostic] {
        if cap.boxed {
            return <Result.Ok value=self.ptrty />
        }
        return self.captureValueTy(c: inout c, cap: cap)
    }
}

pub impl LlvmCtx {

    // The env struct type for closure `cloId`: slot 0 = the per-closure drop thunk
    // pointer (release calls it at env rc 0 to destroy the captures), slots 1.. =
    // the captures in order. Caller guards on caps.count() > 0 before using it.
    inout fn closureEnvTy(c: inout Comp, caps: Array[CaptureEntry]) -> Result[LLVMTypeRef, CompileDiagnostic] {
        mut val elems: Array[LLVMTypeRef] = []
        elems.append(self.ptrty)
        mut val i: U64 = 0
        while i < caps.count() {
            elems.append((try self.captureSlotTy(c: inout c, cap: caps[i])))
            i += 1
        }
        return <Result.Ok value=LLVMStructTypeInContext(self.ctx, arrayCPtr(elems), elems.count(), 0I32) />
    }

    // Register only. Emission must not overwrite the enclosing body's locals.
    inout fn declareClosureEnvironmentDrop(c: inout Comp, closureSlot: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        val closure = self.closures[closureSlot]
        val bodyId = c.arena.closureSignature(bodyId: closure.bodyId).environmentDropBodyId
        if bodyId == 0U64 {
            return <Result.Err error=c.diagnosticAt(offset: c.exprOffset(id: (try c.preparedSemanticClosureAt(index: closure.semanticIndex)).exprId), msg: "internal error: closure environment has no finalized drop body") />
        }
        mut val index = 0U64
        while index < self.closureEnvironmentDrops.count() {
            if self.closureEnvironmentDrops[index].bodyId == bodyId { return <Result.Ok value=self.closureEnvironmentDrops[index].function /> }
            index += 1U64
        }
        val parameters: Array[LLVMTypeRef] = [self.ptrty]
        val type = LLVMFunctionType(self.voidty, arrayCPtr(parameters), 1U64, 0I32)
        mut val name: Array[U8] = []
        appendBytes(into: inout name, from: "pwclodrop".bytes())
        appendU64Dec(into: inout name, n: bodyId)
        name.append(0U8)
        val function = (try self.declareLegacyBodyFunction(name: arrayCPtr(name), signature: type, bodyId: bodyId, family: <LlvmLegacyConvention.EnvironmentDrop />))
        self.closureEnvironmentDrops.append(<LlvmClosureEnvironmentDrop closureSlot=closureSlot bodyId=bodyId function=function />)
        return <Result.Ok value=function />
    }

    inout fn emitClosureEnvironmentDrops(c: inout Comp) -> Result[(), CompileDiagnostic] {
        while self.closureEnvironmentDropsEmitted < self.closureEnvironmentDrops.count() {
            val queued = self.closureEnvironmentDrops[self.closureEnvironmentDropsEmitted]
            if !self.admitBody(bodyId: queued.bodyId) { self.closureEnvironmentDropsEmitted += 1U64 continue }
            val closure = self.closures[queued.closureSlot]
            val body = c.arena.bodyInstanceAt(index: queued.bodyId - 1U64)
            val offset = c.exprOffset(id: (try c.preparedSemanticClosureAt(index: closure.semanticIndex)).exprId)
            self.curFn = queued.function
            self.curIsMain = false
            self.curRetVoid = true
            self.curRetTy = self.voidty
            val prepared = (try self.prepareSyntheticMidBody(c: inout c, bodyId: queued.bodyId, fnIdx: body.fnIdx, parameterCount: closure.captures.count()))
            match prepared {
                MidLlvmPrepared.None => { return <Result.Err error=c.diagnosticAt(offset: offset, msg: "LLVM backend: closure environment drop could not be prepared as Mid IR") /> }
                MidLlvmPrepared.Ready(canonical: _, localAdmission: _) => {
                    self.beginFnBody(fv: queued.function)
                    if !(try self.genLlvmPreparedMidBody(c: inout c, prepared: prepared)) {
                        return <Result.Err error=c.diagnosticAt(offset: offset, msg: "LLVM backend: prepared closure environment Mid body failed to emit") />
                    }
                }
            }
            self.closureEnvironmentDropsEmitted += 1U64
            tracePhaseProgress(c: inout c, label: "backend:closure-environment-drop", count: self.closureEnvironmentDropsEmitted, stride: 16U64)
        }
        return <Result.Ok value=() />
    }

    // Release one owner of a closure value's env: decrement the env cell's rc, and at
    // 0 call its drop thunk (env slot 0 — destroys the captures) then free the env.
    // Null-safe twice over: a non-capturing closure's env is null (release no-op), and
    // a null thunk slot (a boxed capture that is not a cell home — the async-frame
    // corner) skips the capture destruction but still frees the env.
    inout fn emitClosureRelease(c: inout Comp, fat: LLVMValueRef) -> Result[(), CompileDiagnostic] {
        val env: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val rc: LLVMValueRef = (try self.rawbufRelease(c: inout c, cell: env))
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val nonNull: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), env, LLVMConstNull(self.ptrty), anon())
        val doDestroy: LLVMValueRef = LLVMBuildAnd(self.b, isZero, nonNull, anon())
        val freeBBCString = <CString.copied text="clorel.free" />
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, freeBBCString.ptr)
        val callBBCString = <CString.copied text="clorel.drop" />
        val callBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, callBBCString.ptr)
        val tailBBCString = <CString.copied text="clorel.freetail" />
        val tailBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, tailBBCString.ptr)
        val contBBCString = <CString.copied text="clorel.cont" />
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, contBBCString.ptr)
        LLVMBuildCondBr(self.b, doDestroy, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        val dropFn: LLVMValueRef = llvmLoad(self.b, self.ptrty, env, anon())
        val haveDrop: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), dropFn, LLVMConstNull(self.ptrty), anon())
        LLVMBuildCondBr(self.b, haveDrop, callBB, tailBB)
        LLVMPositionBuilderAtEnd(self.b, callBB)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val dty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(env)
        (try self.callLegacyValueFunction(signature: dty, function: dropFn, arguments: av, legacyIndirect: <Optional.Some v=<LlvmLegacyConvention.EnvironmentDrop /> />))
        LLVMBuildBr(self.b, tailBB)
        LLVMPositionBuilderAtEnd(self.b, tailBB)
        try self.rawbufFree(c: inout c, cell: env)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
        return <Result.Ok value=() />
    }

    // Missing keys are never materialized after frontend finalization.
    inout fn closureSlot(bodyId: U64) -> U64 {
        mut val index: U64 = 0U64
        while index < self.closures.count() {
            if self.closures[index].bodyId == bodyId { return index }
            index += 1U64
        }
        return self.closures.count()
    }

    inout fn declareClosure(c: inout Comp, bodyId: U64) -> Result[(), CompileDiagnostic] {
        if self.closureSlot(bodyId: bodyId) < self.closures.count() { return <Result.Ok value=() /> }
        val closure = try c.requirePreparedClosureInstance(bodyId: bodyId)
        val frozen = c.arena.closureSignature(bodyId: bodyId)
        val semanticIndex = frozen.declarationIndex - 1U64
        val functionType: U64 = frozen.functionTypeTerm
        if functionType == 0U64 || functionType >= c.arena.typeCount() || frozen.captures.count() != closure.captures.count() {
            return <Result.Err error=c.diagnosticAt(offset: c.exprOffset(id: closure.exprId), msg: "internal error: reachable closure has no finalized signature") />
        }
        mut val captures: Array[CaptureEntry] = []
        mut val captureI: U64 = 0U64
        while captureI < frozen.captures.count() {
            val capture = frozen.captures[captureI]
            val term: U64 = capture.typeTerm
            if term == 0U64 || term >= c.arena.typeCount() {
                return <Result.Err error=c.diagnosticAt(offset: c.exprOffset(id: closure.exprId), msg: "internal error: closure capture is not grounded") />
            }
            val type: TypeRef = c.arena.typeAt(index: term)
            val boxed: Bool = match capture.mode {
                SemanticClosureCaptureMode.ValueCopy => { give false }
                SemanticClosureCaptureMode.CellBorrow => { give true }
            }
            captures.append(<CaptureEntry closureId=closure.exprId nameStart=capture.bindingTarget nameLen=0U64 tyStart=type.nameStart tyLen=type.nameLen isArray=false ty=term boxed=boxed />)
            captureI += 1U64
        }
        mut val name: Array[U8] = []
        appendBytes(into: inout name, from: "__closure".bytes())
        appendU64Dec(into: inout name, n: bodyId)
        name.append(0U8)
        // Function TypeRef currently lacks ordinary ownership modes. Keep the
        // existing uncalled lazy declarations for unsupported modes explicit;
        // do not pollute a completed Borrow-call template with literal modes.
        val bodySignature = c.arena.bodySignature(bodyId: bodyId)
        mut val completed = true
        for passing in bodySignature.parameterPassings { match passing { CallArgumentPassing.Borrow => {} _ => { completed = false } } }
        val function = if completed {
            val template = (try self.closureValueAbi(c: inout c, functionType: functionType))
            val abiId = (try self.closureBodyValueAbi(c: inout c, bodyId: bodyId, template: template))
            give (try self.declarePlannedBodyFunction(name: arrayCPtr(name), abiId: abiId, bodyId: bodyId))
        } else {
            give (try self.declareLegacyBodyFunction(name: arrayCPtr(name), signature: (try self.closureLlvmFnTy(c: inout c, fnRef: functionType)), bodyId: bodyId, family: <LlvmLegacyConvention.Closure />))
        }
        self.closures.append(<LlvmClosure bodyId=bodyId semanticIndex=semanticIndex functionTypeTerm=functionType function=function captures=captures />)
        return <Result.Ok value=() />
    }

    // Consume actual frozen closure instances. A lazy session can register many
    // instances of their owner without preparing any of those bodies yet; the
    // owner's reachability does not imply a closure ABI exists in every instance.
    inout fn collectClosures(c: inout Comp) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < c.monoWork.bodyCount() {
            val bodyId = c.monoWork.bodyAt(index: index)
            if c.arena.bodySignature(bodyId: bodyId).closureSignatureId != 0U64 {
                try self.declareClosure(c: inout c, bodyId: bodyId)
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn prepareClosureMidBody(c: inout Comp, closure: LlvmClosure) -> Result[MidLlvmPrepared, CompileDiagnostic] {
        val fact: SemanticClosure = (try c.preparedSemanticClosureAt(index: closure.semanticIndex))
        return self.prepareCanonicalForLlvm(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey, parameterCount: fact.parameters.count())
    }

    // Admission is the only place that matches frozen capture/parameter facts
    // to Mid locals. Emission consumes these physical conversions verbatim.
    inout fn prepareClosureLocalBindings(c: inout Comp, body: MidBodyNode, parameterCount: U64, abiId: U64, environmentDrop: Bool) -> Result[LlvmEntryLocalBindings, CompileDiagnostic] {
        if abiId == 0U64 || abiId > self.valueAbis.count() || body.bodyInstance == 0U64 || body.bodyInstance > c.arena.bodyInstanceCount() { return <Result.Err error=valueAbiFailure(message: "closure local admission identity out of range") /> }
        try self.validateClosureLocalEntry(abiId: abiId, plannedAbi: abiId, bodyId: body.bodyInstance, environmentDrop: environmentDrop)
        val closureBodyId = if environmentDrop {
            give match c.arena.bodyOrigin(bodyId: body.bodyInstance) {
                BodyOrigin.ClosureEnvironmentDrop(closureBodyId: val owner) => { give owner }
                _ => { return <Result.Err error=valueAbiFailure(message: "environment drop has no closure origin") /> }
            }
        } else { give body.bodyInstance }
        val slot = self.closureSlot(bodyId: closureBodyId)
        if slot >= self.closures.count() { return <Result.Err error=valueAbiFailure(message: "closure local admission lacks registered captures") /> }
        val closure = self.closures[slot]
        val frozen = c.arena.closureSignature(bodyId: closureBodyId)
        val signature = c.arena.bodySignature(bodyId: body.bodyInstance)
        val abi = self.valueAbis[abiId - 1U64]
        if !signature.ready || signature.receiverType != 0U64 || closure.functionTypeTerm != frozen.functionTypeTerm || signature.parameterTypes.count() != parameterCount || signature.parameterPassings.count() != parameterCount || closure.captures.count() != frozen.captures.count() { return <Result.Err error=valueAbiFailure(message: "closure local admission signature shape mismatch") /> }
        if environmentDrop {
            if frozen.environmentDropBodyId != body.bodyInstance || parameterCount != frozen.captures.count() || abi.parameterCount != 1U64 || body.locals.len != parameterCount { return <Result.Err error=valueAbiFailure(message: "environment drop local mapping mismatch") /> }
        } else {
            if LLVMIsAFunction(closure.function) != LLVMIsAFunction(self.curFn) || abi.parameterCount != parameterCount + 1U64 || parameterCount > body.locals.len || frozen.captures.count() > body.locals.len - parameterCount { return <Result.Err error=valueAbiFailure(message: "closure local mapping mismatch") /> }
        }
        if abi.parameterStart >= self.valueAbiParameters.count() || plew_pointer_equal(self.valueAbiParameters[abi.parameterStart].type, self.ptrty) == 0I32 { return <Result.Err error=valueAbiFailure(message: "closure environment lane is not a pointer") /> }
        mut val bindings: Array[LlvmLocalBinding] = []
        mut val types: Array[LLVMTypeRef] = []
        mut val index = 0U64
        while index < body.locals.len {
            if index >= parameterCount && c.mid.locals[body.locals.start + index].isParameter { return <Result.Err error=valueAbiFailure(message: "closure has an unmapped parameter local") /> }
            bindings.append(<LlvmLocalBinding.None />)
            types.append((try self.lowerMidLocalType(c: inout c, body: body, local: index)))
            index += 1U64
        }
        index = 0U64
        while index < parameterCount {
            val local = c.mid.locals[body.locals.start + index]
            val passing = signature.parameterPassings[index]
            val aliasesAddress = match passing { CallArgumentPassing.Inout => { give true } _ => { give false } }
            val consumes = match passing { CallArgumentPassing.Move => { give true } _ => { give false } }
            if !local.isParameter || !c.typeRefEq(a: local.typeTerm, b: signature.parameterTypes[index]) || local.isInout != aliasesAddress || local.ownsAtEntry != consumes { return <Result.Err error=valueAbiFailure(message: "closure parameter correspondence mismatch") /> }
            if !environmentDrop {
                if local.isCaptureCell || local.isBorrowed { return <Result.Err error=valueAbiFailure(message: "ordinary closure parameter has capture flags") /> }
                val parameterIndex = abi.parameterStart + index + 1U64
                val type = if aliasesAddress { give self.ptrty } else { give types[index] }
                if parameterIndex >= self.valueAbiParameters.count() || plew_pointer_equal(self.valueAbiParameters[parameterIndex].type, type) == 0I32 { return <Result.Err error=valueAbiFailure(message: "closure parameter representation mismatch") /> }
                if abi.convention.key() == 12U64 {
                    val lane = self.valueAbiParameters[parameterIndex]
                    if aliasesAddress || consumes || !c.typeRefEq(a: lane.semanticType, b: signature.parameterTypes[index]) || !lane.role.same(role: <LlvmParameterRole.Ordinary index=index />) || lane.mode.key() != 1U64 { return <Result.Err error=valueAbiFailure(message: "completed closure parameter contract mismatch") /> }
                }
                bindings.set(i: index, value: <LlvmLocalBinding.Parameter parameterIndex=parameterIndex alias=aliasesAddress />)
            }
            index += 1U64
        }
        mut val fields: Array[LLVMTypeRef] = [self.ptrty]
        index = 0U64
        while index < frozen.captures.count() {
            val capture = frozen.captures[index]
            val lowered = closure.captures[index]
            val boxed = match capture.mode { SemanticClosureCaptureMode.CellBorrow => { give true } SemanticClosureCaptureMode.ValueCopy => { give false } }
            val localIndex = if environmentDrop { give index } else { give parameterCount + index }
            val local = c.mid.locals[body.locals.start + localIndex]
            if lowered.nameStart != capture.bindingTarget || lowered.boxed != boxed || !c.typeRefEq(a: lowered.ty, b: capture.typeTerm) || !c.typeRefEq(a: local.typeTerm, b: capture.typeTerm) || local.isCaptureCell != boxed { return <Result.Err error=valueAbiFailure(message: "capture field/local representation mismatch") /> }
            if environmentDrop {
                if !local.isParameter || !local.ownsAtEntry || local.isInout || local.isBorrowed { return <Result.Err error=valueAbiFailure(message: "environment drop capture ownership mismatch") /> }
            } else {
                if local.sourceNameStart != capture.bindingTarget || local.isParameter || local.ownsAtEntry || local.isInout != boxed || local.isBorrowed == boxed { return <Result.Err error=valueAbiFailure(message: "closure capture binding correspondence mismatch") /> }
            }
            val type = if boxed { give self.ptrty } else { give types[localIndex] }
            fields.append(type)
            bindings.set(i: localIndex, value: <LlvmLocalBinding.Environment field=index + 1U64 type=type />)
            index += 1U64
        }
        return <Result.Ok value=<LlvmEntryLocalBindings environmentType=<Optional.Some v=LLVMStructTypeInContext(self.ctx, arrayCPtr(fields), fields.count(), 0I32) /> bindings=bindings types=types /> />
    }

    inout fn validateClosureLocalEntry(abiId: U64, plannedAbi: U64, bodyId: U64, environmentDrop: Bool) -> Result[(), CompileDiagnostic] {
        if abiId == 0U64 || abiId > self.valueAbis.count() || abiId != plannedAbi || self.valueAbis[abiId - 1U64].ownerBody != bodyId { return <Result.Err error=valueAbiFailure(message: "closure local entry descriptor mismatch") /> }
        val valid = match self.valueAbis[abiId - 1U64].convention {
            LlvmValueConvention.Closure => { give !environmentDrop }
            LlvmValueConvention.Legacy(family: val family) => { give match family { LlvmLegacyConvention.Closure => { give !environmentDrop } LlvmLegacyConvention.EnvironmentDrop => { give environmentDrop } _ => { give false } } }
            _ => { give false }
        }
        if !valid { return <Result.Err error=valueAbiFailure(message: "closure local entry convention mismatch") /> }
        return <Result.Ok value=() />
    }

    inout fn emitClosures(c: inout Comp) -> Result[(), CompileDiagnostic] {
        mut val slot: U64 = 0U64
        while slot < self.closures.count() {
            val closure: LlvmClosure = self.closures[slot]
            if !self.admitBody(bodyId: closure.bodyId) { slot += 1U64 continue }
            val fact: SemanticClosure = (try c.preparedSemanticClosureAt(index: closure.semanticIndex))
            val signature: TypeRef = c.arena.typeAt(index: closure.functionTypeTerm)
            self.curFn = closure.function
            self.curIsMain = false
            self.curRetVoid = !fact.hasReturn
            self.curRetTy = self.voidty
            if fact.hasReturn { self.curRetTy = (try self.llvmTypeOfRef(c: inout c, ref: signature.args[0U64])) }
            val prepared: MidLlvmPrepared = (try self.prepareClosureMidBody(c: inout c, closure: closure))
            match prepared {
                MidLlvmPrepared.None => {
                    if c.emitMidCoverage || c.traceCodegen {
                        mut val diagnostic: U64 = 0U64
                        while diagnostic < self.midCoverageBodyIds.count() {
                            if self.midCoverageBodyIds[diagnostic] == closure.bodyId {
                                self.emitMidCoverageRecord(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey, key: self.midCoverageKeys[diagnostic])
                            }
                            diagnostic += 1U64
                        }
                    }
                    return <Result.Err error=c.diagnosticAt(offset: c.exprOffset(id: fact.exprId), msg: "LLVM backend: closure body could not be prepared as Mid IR") />
                }
                MidLlvmPrepared.Ready(canonical: _, localAdmission: _) => {
                    self.beginFnBody(fv: closure.function)
                    if !(try self.genLlvmPreparedMidBody(c: inout c, prepared: prepared)) {
                        return <Result.Err error=c.diagnosticAt(offset: c.exprOffset(id: fact.exprId), msg: "LLVM backend: prepared closure Mid body failed to emit") />
                    }
                }
            }
            slot += 1U64
        }
        return <Result.Ok value=() />
    }
}
