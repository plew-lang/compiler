// Part of the LLVM backend (root: _.pw): closure capture, env, declaration, and emission (lambda lifting).

// ---- closures (lambda-lifted function values) ----
//
// The captures of closure `cloId`, in declaration order (the env struct layout).

pub impl LlvmCtx {

    // The captured variable's own VALUE type (ignoring boxing) — the type stored in
    // the shared cell for a boxed capture, or in the env slot for a by-value one.
    inout fn captureValueTy(c: inout Comp, cap: CaptureEntry) -> LLVMTypeRef {
        // A recorded TypeRef is the layout authority for every capture, including
        // non-generic structs. Only old ref-less capture rows use the span fallback.
        if cap.ty != 0U64 {
            return self.llvmTypeOfRef(c: inout c, ref: cap.ty)
        }
        if cap.isArray {
            return self.arrayTy
        }
        return self.llvmScalarTy(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen)
    }

    // The LLVM type of a capture slot in the env struct: a `mut val` (boxed) capture is
    // a pointer to the shared cell; otherwise the captured value's own type.
    inout fn captureSlotTy(c: inout Comp, cap: CaptureEntry) -> LLVMTypeRef {
        if cap.boxed {
            return self.ptrty
        }
        return self.captureValueTy(c: inout c, cap: cap)
    }
}

pub impl LlvmCtx {

    // The env struct type for closure `cloId`: slot 0 = the per-closure drop thunk
    // pointer (release calls it at env rc 0 to destroy the captures), slots 1.. =
    // the captures in order. Caller guards on caps.count() > 0 before using it.
    inout fn closureEnvTy(c: inout Comp, caps: Array[CaptureEntry]) -> LLVMTypeRef {
        mut val elems: Array[LLVMTypeRef] = []
        elems.append(self.ptrty)
        mut val i: U64 = 0
        while i < caps.count() {
            elems.append(self.captureSlotTy(c: inout c, cap: caps[i]))
            i += 1
        }
        return LLVMStructTypeInContext(self.ctx, arrayCPtr(elems), elems.count(), 0I32)
    }

    // The TypeRef used to ARC a capture's VALUE (release in the drop thunk / the
    // boxed cell's pointee): the capture's own structured ref when it carries one, a
    // synthesized `Array[elem]` for an array capture (tyStart/tyLen span the ELEMENT
    // type — captureValueTy's convention), else the bare name span's ref. 0 = scalar.
    inout fn captureArcRef(c: inout Comp, cap: CaptureEntry) -> U64 {
        if cap.ty != 0U64 {
            return cap.ty
        }
        if cap.isArray {
            val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
            mut val aargs: Array[U64] = []
            aargs.append(c.findOrAddTypeRef(nameStart: cap.tyStart, nameLen: cap.tyLen))
            return c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        }
        if cap.tyLen == 0U64 {
            return 0U64
        }
        return c.findOrAddTypeRef(nameStart: cap.tyStart, nameLen: cap.tyLen)
    }

    // Build the drop thunk for closure `cloId` (env slot 0): `drop(ptr env)` destroys
    // every capture the env owns — a boxed (mut) capture drops one owner of its shared
    // cell (pointee destroyed at cell rc 0); a by-value capture releases its owned
    // heap (classifier-routed valueArc). emitClosureRelease calls it when the env's
    // own rc reaches 0, then frees the env. Rebuilt per creation site (LLVM uniques
    // duplicate names) so a generic caller's grounded capture types are honored.
    inout fn buildClosureDropThunk(c: inout Comp, cloId: U64, caps: Array[CaptureEntry]) -> LLVMValueRef {
        val envTy: LLVMTypeRef = self.closureEnvTy(c: inout c, caps: caps)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwclodrop".bytes())
        appendU64Dec(into: inout nm, n: cloId)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val savedFn: LLVMValueRef = self.curFn
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        self.curFn = fv
        val envPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
        mut val ci: U64 = 0
        while ci < caps.count() {
            val cap: CaptureEntry = caps[ci]
            val slotPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, envTy, envPtr, ci + 1U64, anon())
            val cref: U64 = self.captureArcRef(c: inout c, cap: cap)
            if cap.boxed {
                self.emitCellRelease(c: inout c, cell: llvmLoad(self.b, self.ptrty, slotPtr, anon()), ref: cref)
            } else {
                if cref != 0U64 {
                    if c.arcNeedsRelease(ref: cref) {
                        val cv: LLVMValueRef = llvmLoad(self.b, self.captureValueTy(c: inout c, cap: cap), slotPtr, anon())
                        self.valueArc(c: inout c, v: cv, typeRef: cref, retain: false)
                    }
                }
            }
            ci += 1
        }
        LLVMBuildRetVoid(self.b)
        self.curFn = savedFn
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Release one owner of a closure value's env: decrement the env cell's rc, and at
    // 0 call its drop thunk (env slot 0 — destroys the captures) then free the env.
    // Null-safe twice over: a non-capturing closure's env is null (release no-op), and
    // a null thunk slot (a boxed capture that is not a cell home — the async-frame
    // corner) skips the capture destruction but still frees the env.
    inout fn emitClosureRelease(c: inout Comp, fat: LLVMValueRef) {
        val env: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val rc: LLVMValueRef = self.rawbufRelease(c: inout c, cell: env)
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val nonNull: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), env, LLVMConstNull(self.ptrty), anon())
        val doDestroy: LLVMValueRef = LLVMBuildAnd(self.b, isZero, nonNull, anon())
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.free"))
        val callBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.drop"))
        val tailBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.freetail"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.cont"))
        LLVMBuildCondBr(self.b, doDestroy, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        val dropFn: LLVMValueRef = llvmLoad(self.b, self.ptrty, env, anon())
        val haveDrop: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), dropFn, LLVMConstNull(self.ptrty), anon())
        LLVMBuildCondBr(self.b, haveDrop, callBB, tailBB)
        LLVMPositionBuilderAtEnd(self.b, callBB)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val dty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(env)
        LLVMBuildCall2(self.b, dty, dropFn, arrayCPtr(av), 1U64, anon())
        LLVMBuildBr(self.b, tailBB)
        LLVMPositionBuilderAtEnd(self.b, tailBB)
        self.rawbufFree(c: inout c, cell: env)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
    }

    // Missing keys are never materialized after frontend finalization.
    inout fn closureSlot(bodyId: U64) -> U64 {
        mut val index: U64 = 0U64
        while index < self.closures.count() {
            if self.closures[index].bodyId == bodyId { return index }
            index += 1U64
        }
        return self.closures.count()
    }

    inout fn declareClosure(c: inout Comp, semanticIndex: U64, environment: InstanceEnvironment) {
        val closure: SemanticClosure = c.decls.semanticClosures[semanticIndex]
        val bodyId: U64 = c.findBodyInstance(fnIdx: closure.bodyKey, environment: environment)
        if bodyId == 0U64 {
            c.errorAt(offset: c.exprOffset(id: closure.exprId), msg: "internal error: reachable closure has no finalized BodyInstance")
            return
        }
        if self.closureSlot(bodyId: bodyId) < self.closures.count() { return }
        val functionType: U64 = c.groundTermForBody(ref: closure.functionTypeTerm, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
        if functionType == 0U64 || functionType >= c.arena.typeCount() {
            c.errorAt(offset: c.exprOffset(id: closure.exprId), msg: "internal error: closure signature is not grounded")
            return
        }
        val signature: TypeRef = c.arena.typeAt(index: functionType)
        mut val grounded: Bool = signature.args.count() == closure.parameters.count() + 1U64
        mut val termI: U64 = 0U64
        while termI < signature.args.count() {
            // Zero is the existing Unit result representation, not a missing
            // argument type. Value parameters must always be nonzero and ground.
            if termI != 0U64 || closure.hasReturn {
                if signature.args[termI] == 0U64 || !c.tyRefIsGround(ref: signature.args[termI]) { grounded = false }
            }
            termI += 1U64
        }
        if !grounded {
            c.errorAt(offset: c.exprOffset(id: closure.exprId), msg: "internal error: invalid concrete closure signature")
            return
        }
        mut val captures: Array[CaptureEntry] = []
        mut val captureI: U64 = 0U64
        while captureI < closure.captures.count() {
            val capture = closure.captures[captureI]
            val term: U64 = c.groundTermForBody(ref: capture.typeTerm, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
            if term == 0U64 || term >= c.arena.typeCount() {
                c.errorAt(offset: c.exprOffset(id: closure.exprId), msg: "internal error: closure capture is not grounded")
                return
            }
            val type: TypeRef = c.arena.typeAt(index: term)
            val boxed: Bool = match capture.mode {
                SemanticClosureCaptureMode.ValueCopy => { give false }
                SemanticClosureCaptureMode.CellBorrow => { give true }
            }
            captures.append(<CaptureEntry closureId=closure.exprId nameStart=capture.bindingTarget nameLen=0U64 tyStart=type.nameStart tyLen=type.nameLen isArray=false ty=term boxed=boxed />)
            captureI += 1U64
        }
        val functionTypeLlvm: LLVMTypeRef = self.closureLlvmFnTy(c: inout c, fnRef: functionType)
        mut val name: Array[U8] = []
        appendBytes(into: inout name, from: "__closure".bytes())
        appendU64Dec(into: inout name, n: bodyId)
        name.append(0U8)
        val function: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(name), functionTypeLlvm)
        self.closures.append(<LlvmClosure bodyId=bodyId semanticIndex=semanticIndex functionTypeTerm=functionType function=function captures=captures />)
    }

    // Only frontend-reachable lexical instances make their frozen closures
    // executable. Unused declarations and abstract instances are not roots.
    // Nested closures remain rejected by the frontend's current v1 boundary.
    inout fn collectClosures(c: inout Comp) {
        mut val closureI: U64 = 0U64
        while closureI < c.decls.semanticClosures.count() {
            val closure: SemanticClosure = c.decls.semanticClosures[closureI]
            if closure.ownerFnIdx == 18446744073709551615U64 {
                self.declareClosure(c: inout c, semanticIndex: closureI, environment: <InstanceEnvironment />)
            } else {
                mut val bodyI: U64 = 0U64
                while bodyI < c.monoWork.bodyInstances.count() {
                    val body: BodyInstance = c.arena.bodyInstanceAt(index: c.monoWork.bodyInstances[bodyI] - 1U64)
                    if c.semanticBodyOwner(fnIdx: body.fnIdx) == closure.ownerFnIdx {
                        self.declareClosure(c: inout c, semanticIndex: closureI, environment: body.environment)
                    }
                    bodyI += 1U64
                }
            }
            closureI += 1U64
        }
    }

    inout fn prepareClosureMidBody(c: inout Comp, closure: LlvmClosure) -> MidLlvmPrepared {
        val fact: SemanticClosure = c.decls.semanticClosures[closure.semanticIndex]
        val built: MidBodyBuild = ensureParametricMidClosureBody(c: inout c, closure: fact)
        match built.error {
            MidBuildError.None => {}
            _ => {
                self.recordMidBuildError(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey, error: built.error)
                return <MidLlvmPrepared.None />
            }
        }
        val instantiated: MidCanonicalInstantiation = instantiateCanonicalMidBody(c: inout c, body: built.canonical, bodyId: closure.bodyId)
        match instantiated.error {
            MidInstantiateError.None => {}
            _ => {
                self.recordMidInstantiate(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey, reason: instantiated.error)
                return <MidLlvmPrepared.None />
            }
        }
        val accesses: MidCanonicalAccessElaboration = elaborateCanonicalMidAccesses(c: inout c, canonical: instantiated.body)
        match accesses.error {
            MidAccessError.None => {}
            _ => {
                self.recordMidAccess(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey)
                return <MidLlvmPrepared.None />
            }
        }
        val dropped: MidCanonicalBody = elaborateCanonicalMidDrops(c: inout c, canonical: optimizeCanonicalMidReturns(arena: inout c.mid, canonical: accesses.body))
        val verification: MidVerification = verifyCanonicalMidBody(c: c, canonical: dropped)
        match verification.error {
            MidVerifyError.None => {}
            _ => {
                self.recordMidVerify(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey, reason: verification.error)
                return <MidLlvmPrepared.None />
            }
        }
        val preflight: MidLlvmPreflight = self.midVerifiedLlvmPreflight(c: inout c, canonical: dropped, abiParameterCount: fact.parameters.count())
        match preflight {
            MidLlvmPreflight.Ready => {}
            _ => {
                self.recordMidPreflight(c: inout c, bodyId: closure.bodyId, fnIdx: fact.bodyKey, reason: preflight)
                return <MidLlvmPrepared.None />
            }
        }
        return <MidLlvmPrepared.Ready canonical=dropped abiParameterCount=fact.parameters.count() />
    }

    // Captures are borrowed from the environment for this activation. Mutable
    // captures bind the shared cell, not a new value copy or a new ARC owner.
    inout fn bindMidClosureCaptures(c: inout Comp, body: MidBodyNode, bodyId: U64) -> Bool {
        val slot: U64 = self.closureSlot(bodyId: bodyId)
        if slot >= self.closures.count() { return false }
        val closure: LlvmClosure = self.closures[slot]
        val parameterCount: U64 = c.decls.semanticClosures[closure.semanticIndex].parameters.count()
        if parameterCount > body.locals.len || closure.captures.count() > body.locals.len - parameterCount { return false }
        if closure.captures.count() == 0U64 { return true }
        val environmentType: LLVMTypeRef = self.closureEnvTy(c: inout c, caps: closure.captures)
        val environment: LLVMValueRef = LLVMGetParam(self.curFn, 0U64)
        mut val captureI: U64 = 0U64
        while captureI < closure.captures.count() {
            val capture: CaptureEntry = closure.captures[captureI]
            val local: U64 = parameterCount + captureI
            val declaration: MidLocalDecl = c.mid.locals[body.locals.start + local]
            if declaration.sourceNameStart != capture.nameStart || declaration.isParameter || !declaration.isBorrowed || declaration.isCaptureCell != capture.boxed || !c.typeRefEq(a: declaration.typeTerm, b: capture.ty) { return false }
            val type: LLVMTypeRef = self.captureSlotTy(c: inout c, cap: capture)
            val value: LLVMValueRef = llvmLoad(self.b, type, LLVMBuildStructGEP2(self.b, environmentType, environment, captureI + 1U64, anon()), anon())
            llvmStore(self.b, value, self.locPtr[local])
            captureI += 1U64
        }
        return true
    }

    inout fn emitClosures(c: inout Comp) {
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        val savedBodyId: U64 = c.cur.bodyId
        mut val slot: U64 = 0U64
        while slot < self.closures.count() {
            val closure: LlvmClosure = self.closures[slot]
            val fact: SemanticClosure = c.decls.semanticClosures[closure.semanticIndex]
            val instance: BodyInstance = c.arena.bodyInstanceAt(index: closure.bodyId - 1U64)
            c.cur.bodyFnIdx = instance.fnIdx
            c.cur.bodyEnvironment = instance.environment
            c.cur.bodyId = closure.bodyId
            val signature: TypeRef = c.arena.typeAt(index: closure.functionTypeTerm)
            self.curFn = closure.function
            self.curIsMain = false
            self.curRetVoid = !fact.hasReturn
            self.curRetRef = signature.args[0U64]
            val result: TypeRef = c.arena.typeAt(index: self.curRetRef)
            self.curRetTyStart = result.nameStart
            self.curRetTyLen = result.nameLen
            self.curRetTy = self.voidty
            if fact.hasReturn { self.curRetTy = self.llvmTypeOfRef(c: inout c, ref: self.curRetRef) }
            val prepared: MidLlvmPrepared = self.prepareClosureMidBody(c: inout c, closure: closure)
            match prepared {
                MidLlvmPrepared.None => {
                    c.errorAt(offset: c.exprOffset(id: fact.exprId), msg: "LLVM backend: closure body could not be prepared as Mid IR")
                }
                MidLlvmPrepared.Ready(canonical: _, abiParameterCount: _) => {
                    self.beginFnBody(fv: closure.function)
                    if !self.genLlvmPreparedMidBody(c: inout c, prepared: prepared, abiParameterStart: 1U64, closureBodyId: closure.bodyId) {
                        c.errorAt(offset: c.exprOffset(id: fact.exprId), msg: "LLVM backend: prepared closure Mid body failed to emit")
                    }
                }
            }
            slot += 1U64
        }
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyEnvironment = savedEnvironment
        c.cur.bodyId = savedBodyId
    }
}
