// Part of the LLVM backend (root: _.pw): closure capture, env, declaration, and emission (lambda lifting).

// ---- closures (lambda-lifted function values) ----
//
// The captures of closure `cloId`, in declaration order (the env struct layout).

pub impl LlvmCtx {

    // The captured variable's own VALUE type (ignoring boxing) — the type stored in
    // the shared cell for a boxed capture, or in the env slot for a by-value one.
    inout fn captureValueTy(c: inout Comp, cap: CaptureEntry) -> LLVMTypeRef {
        // a generic-instance capture (incl. `Array[E]`) resolves to its per-instance type via
        // the full ref (de-pin); a hand-built array capture with no ref falls back to `{ptr}`.
        if c.isGenericInst(ref: cap.ty) {
            return self.llvmTypeOfRef(c: inout c, ref: cap.ty)
        }
        if cap.isArray {
            return self.arrayTy
        }
        return self.llvmScalarTy(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen)
    }

    // The LLVM type of a capture slot in the env struct: a `mut val` (boxed) capture is
    // a pointer to the shared cell; otherwise the captured value's own type.
    inout fn captureSlotTy(c: inout Comp, cap: CaptureEntry) -> LLVMTypeRef {
        if cap.boxed {
            return self.ptrty
        }
        return self.captureValueTy(c: inout c, cap: cap)
    }
}

pub impl LlvmCtx {

    // The env struct type for closure `cloId`: slot 0 = the per-closure drop thunk
    // pointer (release calls it at env rc 0 to destroy the captures), slots 1.. =
    // the captures in order. Caller guards on caps.count() > 0 before using it.
    inout fn closureEnvTy(c: inout Comp, caps: Array[CaptureEntry]) -> LLVMTypeRef {
        mut val elems: Array[LLVMTypeRef] = []
        elems.append(self.ptrty)
        mut val i: U64 = 0
        while i < caps.count() {
            elems.append(self.captureSlotTy(c: inout c, cap: caps[i]))
            i += 1
        }
        return LLVMStructTypeInContext(self.ctx, arrayCPtr(elems), elems.count(), 0I32)
    }

    // The TypeRef used to ARC a capture's VALUE (release in the drop thunk / the
    // boxed cell's pointee): the capture's own structured ref when it carries one, a
    // synthesized `Array[elem]` for an array capture (tyStart/tyLen span the ELEMENT
    // type — captureValueTy's convention), else the bare name span's ref. 0 = scalar.
    inout fn captureArcRef(c: inout Comp, cap: CaptureEntry) -> U64 {
        if cap.ty != 0U64 {
            return cap.ty
        }
        if cap.isArray {
            val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
            mut val aargs: Array[U64] = []
            aargs.append(c.findOrAddTypeRef(nameStart: cap.tyStart, nameLen: cap.tyLen))
            return c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        }
        if cap.tyLen == 0U64 {
            return 0U64
        }
        return c.findOrAddTypeRef(nameStart: cap.tyStart, nameLen: cap.tyLen)
    }

    // Build the drop thunk for closure `cloId` (env slot 0): `drop(ptr env)` destroys
    // every capture the env owns — a boxed (mut) capture drops one owner of its shared
    // cell (pointee destroyed at cell rc 0); a by-value capture releases its owned
    // heap (classifier-routed valueArc). emitClosureRelease calls it when the env's
    // own rc reaches 0, then frees the env. Rebuilt per creation site (LLVM uniques
    // duplicate names) so a generic caller's grounded capture types are honored.
    inout fn buildClosureDropThunk(c: inout Comp, cloId: U64, caps: Array[CaptureEntry]) -> LLVMValueRef {
        val envTy: LLVMTypeRef = self.closureEnvTy(c: inout c, caps: caps)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwclodrop".bytes())
        appendU64Dec(into: inout nm, n: cloId)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val savedFn: LLVMValueRef = self.curFn
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        self.curFn = fv
        val envPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
        mut val ci: U64 = 0
        while ci < caps.count() {
            val cap: CaptureEntry = caps[ci]
            val slotPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, envTy, envPtr, ci + 1U64, anon())
            val cref: U64 = self.captureArcRef(c: inout c, cap: cap)
            if cap.boxed {
                self.emitCellRelease(c: inout c, cell: LLVMBuildLoad2(self.b, self.ptrty, slotPtr, anon()), ref: cref)
            } else {
                if cref != 0U64 {
                    if c.arcNeedsRelease(ref: cref) {
                        val cv: LLVMValueRef = LLVMBuildLoad2(self.b, self.captureValueTy(c: inout c, cap: cap), slotPtr, anon())
                        self.valueArc(c: inout c, v: cv, typeRef: cref, retain: false)
                    }
                }
            }
            ci += 1
        }
        LLVMBuildRetVoid(self.b)
        self.curFn = savedFn
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Release one owner of a closure value's env: decrement the env cell's rc, and at
    // 0 call its drop thunk (env slot 0 — destroys the captures) then free the env.
    // Null-safe twice over: a non-capturing closure's env is null (release no-op), and
    // a null thunk slot (a boxed capture that is not a cell home — the async-frame
    // corner) skips the capture destruction but still frees the env.
    inout fn emitClosureRelease(c: inout Comp, fat: LLVMValueRef) {
        val env: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val rc: LLVMValueRef = self.rawbufRelease(c: inout c, cell: env)
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val nonNull: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), env, LLVMConstNull(self.ptrty), anon())
        val doDestroy: LLVMValueRef = LLVMBuildAnd(self.b, isZero, nonNull, anon())
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.free"))
        val callBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.drop"))
        val tailBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.freetail"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "clorel.cont"))
        LLVMBuildCondBr(self.b, doDestroy, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        val dropFn: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, env, anon())
        val haveDrop: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), dropFn, LLVMConstNull(self.ptrty), anon())
        LLVMBuildCondBr(self.b, haveDrop, callBB, tailBB)
        LLVMPositionBuilderAtEnd(self.b, callBB)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val dty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(env)
        LLVMBuildCall2(self.b, dty, dropFn, arrayCPtr(av), 1U64, anon())
        LLVMBuildBr(self.b, tailBB)
        LLVMPositionBuilderAtEnd(self.b, tailBB)
        self.rawbufFree(c: inout c, cell: env)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
    }

    // Index into st.clo* for a Closure-expr arena id, or st.cloIdx.count().
    inout fn closureSlot(id: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.cloIdx.count() {
            if self.cloIdx[i] == id {
                return i
            }
            i += 1
        }
        return self.cloIdx.count()
    }
}

pub impl LlvmCtx {

    // Declare a closure as `__closure<id>(ptr env, params...)` (env first per the
    // uniform closure ABI) and cache it. Idempotent (skips an already-declared id);
    // a closure with an unsupported (boxed) capture is left undeclared.
    inout fn declareClosure(c: inout Comp, id: U64) {
        if self.closureSlot(id: id) < self.cloIdx.count() {
            return
        }
        if !(closureSupported(c: inout c, cloId: id)) {
            return
        }
        match c.arena.exprs[id] {
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, body: _) => {
                mut val ptys: Array[LLVMTypeRef] = []
                ptys.append(self.ptrty)
                mut val pi: U64 = 0
                while pi < params.count() {
                    ptys.append(self.paramLlvmTy(c: inout c, p: params[pi]))
                    pi += 1
                }
                mut val rty: LLVMTypeRef = self.voidty
                if hasRet {
                    if c.isGenericInst(ref: retTy) {
                        rty = self.llvmTypeOfRef(c: inout c, ref: retTy)
                    } else {
                        rty = self.llvmTypeFor(c: inout c, tyStart: retStart, tyLen: retLen, isArray: retIsArray)
                    }
                }
                val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count(), 0I32)
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "__closure".bytes())
                appendU64Dec(into: inout nm, n: id)
                nm.append(0)
                val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
                self.cloIdx.append(id)
                self.cloVal.append(fv)
                self.cloTy.append(fty)
            }
            _ => {}
        }
    }

    // Walk an expression / statement / block, declaring every Closure it contains
    // (and nested closures via the declared closure's own body scan, run later).
    inout fn scanExprClosures(c: inout Comp, id: U64) {
        match c.arena.exprs[id] {
            Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => {
                self.declareClosure(c: inout c, id: id)
            }
            Expr.Unary(op: _, val operand) => { self.scanExprClosures(c: inout c, id: operand) }
            Expr.Binary(op: _, val lhs, val rhs) => { self.scanExprClosures(c: inout c, id: lhs) self.scanExprClosures(c: inout c, id: rhs) }
            Expr.Call(nameStart: _, nameLen: _, val args) => {
                mut val i: U64 = 0
                while i < args.len { self.scanExprClosures(c: inout c, id: c.argAt(args: args, index: i).expr) i += 1 }
            }
            Expr.Method(val recv, nameStart: _, nameLen: _, val args) => {
                self.scanExprClosures(c: inout c, id: recv)
                mut val i: U64 = 0
                while i < args.len { self.scanExprClosures(c: inout c, id: c.argAt(args: args, index: i).expr) i += 1 }
            }
            Expr.ExtMethod(val recv, source: _, nameStart: _, nameLen: _, val args) => {
                self.scanExprClosures(c: inout c, id: recv)
                mut val i: U64 = 0
                while i < args.len { self.scanExprClosures(c: inout c, id: c.argAt(args: args, index: i).expr) i += 1 }
            }
            Expr.ExtView(val recv, source: _, strip: _) => {
                self.scanExprClosures(c: inout c, id: recv)
            }
            Expr.Field(val base, nameStart: _, nameLen: _) => { self.scanExprClosures(c: inout c, id: base) }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                mut val i: U64 = 0
                while i < fields.count() { self.scanExprClosures(c: inout c, id: fields[i].value) i += 1 }
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.count() { self.scanExprClosures(c: inout c, id: elems[i]) i += 1 }
            }
            Expr.Index(val base, val index) => { self.scanExprClosures(c: inout c, id: base) self.scanExprClosures(c: inout c, id: index) }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { self.scanExprClosures(c: inout c, id: operand) }
            Expr.MatchExpr(val scrut, val arms) => {
                self.scanExprClosures(c: inout c, id: scrut)
                mut val i: U64 = 0
                while i < arms.count() {
                    self.scanBlockClosures(c: inout c, id: arms[i].body)
                    i += 1
                }
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.scanExprClosures(c: inout c, id: cond)
                self.scanBlockClosures(c: inout c, id: thenBlk)
                self.scanBlockClosures(c: inout c, id: elseBlk)
            }
            Expr.OptChain(val base, val cont) => {
                self.scanExprClosures(c: inout c, id: base)
                self.scanExprClosures(c: inout c, id: cont)
            }
            Expr.ChainHole => {}
            Expr.Try(val expr) => { self.scanExprClosures(c: inout c, id: expr) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { self.scanExprClosures(c: inout c, id: base) }
            Expr.Deref(val base) => { self.scanExprClosures(c: inout c, id: base) }
            Expr.Move(val operand, isBorrow: _) => { self.scanExprClosures(c: inout c, id: operand) }
            Expr.Await(val operand) => { self.scanExprClosures(c: inout c, id: operand) }
            _ => {}
        }
    }

    inout fn scanStmtClosures(c: inout Comp, id: U64) {
        match c.arena.stmts[id] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { self.scanExprClosures(c: inout c, id: init) }
            Stmt.Assign(val target, val value) => { self.scanExprClosures(c: inout c, id: target) self.scanExprClosures(c: inout c, id: value) }
            Stmt.ExprStmt(val expr) => { self.scanExprClosures(c: inout c, id: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => { if hasValue { self.scanExprClosures(c: inout c, id: value) } }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.scanExprClosures(c: inout c, id: cond)
                self.scanBlockClosures(c: inout c, id: thenBlk)
                if hasElse { self.scanBlockClosures(c: inout c, id: elseBlk) }
            }
            Stmt.While(val cond, val body) => { self.scanExprClosures(c: inout c, id: cond) self.scanBlockClosures(c: inout c, id: body) }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, val rangeHi, val body, isStruct: _, patStart: _, patLen: _, binds: _) => {
                self.scanExprClosures(c: inout c, id: iter)
                self.scanExprClosures(c: inout c, id: rangeHi)
                self.scanBlockClosures(c: inout c, id: body)
            }
            Stmt.Match(val scrut, val arms) => {
                self.scanExprClosures(c: inout c, id: scrut)
                mut val i: U64 = 0
                while i < arms.count() {
                    self.scanBlockClosures(c: inout c, id: arms[i].body)
                    i += 1
                }
            }
            Stmt.Panic(val msg, offset: _) => { self.scanExprClosures(c: inout c, id: msg) }
            Stmt.Give(val value) => { self.scanExprClosures(c: inout c, id: value) }
            _ => {}
        }
    }

    inout fn scanBlockClosures(c: inout Comp, id: U64) {
        if id == 0U64 {
            return
        }
        mut val i: U64 = 0
        while i < c.blockStmtCount(blkId: id) {
            self.scanStmtClosures(c: inout c, id: c.blockStmtAt(blkId: id, index: i))
            i += 1
        }
    }

    // Declare every closure reachable from emitted code (main + plain user fns + free
    // functions, which now emit as `gf` instances), then fixpoint over declared closures'
    // own bodies (nested closures). Run before bodies.
    inout fn collectClosures(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.funcs.count() {
            // a free function (no receiver) is emitted as its `gf` instance, so a closure in
            // its body must be declared here too (isPlainUserFn no longer covers free fns).
            val f: Func = c.arena.funcs[fi]
            mut val isFreeFn: Bool = false
            if !(f.hasRecv) {
                if !(f.isExtern) {
                    if !(f.isAsync) {
                        if !(c.nameIsMain(f: f)) {
                            isFreeFn = true
                        }
                    }
                }
            }
            if c.nameIsMain(f: f) || isFreeFn {
                self.scanBlockClosures(c: inout c, id: c.arena.funcs[fi].body)
            }
            fi += 1
        }
        mut val seen: U64 = 0
        while seen < self.cloIdx.count() {
            val cid: U64 = self.cloIdx[seen]
            match c.arena.exprs[cid] {
                Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, val body) => {
                    self.scanBlockClosures(c: inout c, id: body)
                }
                _ => {}
            }
            seen += 1
        }
    }

    // Emit each declared closure's body: env pointer is arg 0 (ignored for a
    // non-capturing closure), the closure params follow at 1.., then the body.
    inout fn emitClosures(c: inout Comp) {
        mut val s: U64 = 0
        while s < self.cloIdx.count() {
            val cid: U64 = self.cloIdx[s]
            val fv: LLVMValueRef = self.cloVal[s]
            match c.arena.exprs[cid] {
                Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                    self.curFn = fv
                    self.curIsMain = false
                    self.curRetVoid = !hasRet
                    if hasRet {
                        if c.isGenericInst(ref: retTy) {
                            self.curRetTy = self.llvmTypeOfRef(c: inout c, ref: retTy)
                        } else {
                            self.curRetTy = self.llvmTypeFor(c: inout c, tyStart: retStart, tyLen: retLen, isArray: retIsArray)
                        }
                    } else {
                        self.curRetTy = self.voidty
                    }
                    self.curRetTyStart = retStart
                    self.curRetTyLen = retLen
                    self.curRetRef = retTy
                    self.beginFnBody(fv: fv)
                    self.nLocals = 0
                    self.locStart = []
                    self.locLen = []
                    self.locPtr = []
                    self.locTy = []
                    self.locKind = []
                    self.locStructIdx = []
                    self.locIsArr = []
                    self.locElemTy = []
                    self.locElemKind = []
                    self.locTypeRef = []
                    self.locElemTypeRef = []
                    self.locOwned = []
                    self.locMoved = []
                    self.locCellHome = []
                    val savedBodyFn: U64 = c.cur.bodyFnIdx
                    val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
                    c.cur.bodyFnIdx = c.closureBodyKey(closureId: cid)
                    c.cur.bodyEnvironment = <InstanceEnvironment />
                    c.cur.bodyId = 0U64
                    // module-level variables (spec/15) are visible inside closures too.
                    self.seedGlobals(c: inout c)
                    // bind captures from the env pointer (param 0): each capture loads
                    // from its env slot into a fresh local, so the body's identifier
                    // accesses resolve normally. (Immutable captures are by-value; a
                    // boxed `mut val` capture binds the cell pointer as a Ref-like local.)
                    val caps: Array[CaptureEntry] = closureCaptures(c: inout c, cloId: cid)
                    if caps.count() > 0U64 {
                        val envTy: LLVMTypeRef = self.closureEnvTy(c: inout c, caps: caps)
                        val envPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
                        mut val ci: U64 = 0
                        while ci < caps.count() {
                            val cap: CaptureEntry = caps[ci]
                            val slotTy: LLVMTypeRef = self.captureSlotTy(c: inout c, cap: cap)
                            val cv: LLVMValueRef = LLVMBuildLoad2(self.b, slotTy, LLVMBuildStructGEP2(self.b, envTy, envPtr, ci + 1U64, anon()), anon())
                            // a boxed (mut) capture: `cv` is the shared cell POINTER — bind
                            // the local directly to it (ty = the value type), so reads/writes
                            // in the body go through the same cell as the enclosing scope.
                            if cap.boxed {
                                val valTy: LLVMTypeRef = self.captureValueTy(c: inout c, cap: cap)
                                self.pushLocalR(nameStart: cap.nameStart, nameLen: cap.nameLen, ptr: cv, ty: valTy, kind: kindFromTySpan(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen), structIdx: c.arena.structs.count(), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: 0U64)
                                // the bound capture IS the shared cell (a borrow — the env owns
                                // its count): mark it so a NESTED closure's env creation retains
                                // the cell it re-captures, and flag it un-owned so no scope-exit
                                // drop ever releases the env's count.
                                self.setLocalCellHome()
                                self.setLocalOwned(owned: false)
                                ci += 1
                            } else {
                            val a: LLVMValueRef = self.entryAlloca(ty: slotTy)
                            LLVMBuildStore(self.b, cv, a)
                            mut val cRef: U64 = 0
                            if cap.boxed {
                                cRef = cap.ty
                            } else {
                                if c.isGenericInst(ref: cap.ty) {
                                    cRef = cap.ty
                                } else {
                                    // declaration test (concreteEnumIdxByName), not the
                                    // registered instances — registration is demand-driven, so
                                    // a closure emitted before any construction of the enum
                                    // would leave the capture ref-less (its release then skips
                                    // the payload's deinit). Mirrors bindOneParam.
                                    if c.concreteEnumIdxByName(start: cap.tyStart, len: cap.tyLen) < c.arena.enums.count() {
                                        cRef = c.simpleTypeRef(nameStart: cap.tyStart, nameLen: cap.tyLen)
                                    }
                                    // TOTAL-REF: a bare (non-generic) struct capture (`val p: Pt`
                                    // used in a closure body) carries its TypeRef so exprTypeRef
                                    // recovers it; formerly left 0 (recovered via struct-idx).
                                    if cRef == 0U64 {
                                        if self.localStructIdxFor(c: inout c, start: cap.tyStart, len: cap.tyLen) < c.arena.structs.count() {
                                            cRef = c.simpleTypeRef(nameStart: cap.tyStart, nameLen: cap.tyLen)
                                        }
                                    }
                                }
                            }
                            mut val cElem: LLVMTypeRef = self.i64ty
                            if cap.isArray {
                                cElem = self.llvmScalarTy(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen)
                            }
                            val capSidx: U64 = self.localStructIdxFor(c: inout c, start: cap.tyStart, len: cap.tyLen)
                            // A struct-classed capture (String / user struct — capSidx
                            // registered, typeRef carried) rides the by-value arg
                            // convention: the UNGATED scope-exit drop releases it on every
                            // return (emitDeinitCallValue's typeRef arm — the same drop
                            // that balances a call site's shallow-retained struct arg).
                            // The env holds only ONE count, so each activation must take
                            // its own +1 here, or every call nets -1 on the captured heap
                            // (second call = UAF). Array/reference-cell/Buffer captures are
                            // true borrows of the env's value — no retain, and the binding
                            // is flagged un-owned so the scope-exit drop skips it (the
                            // ownership flag is the single truth; there is no position gate).
                            mut val capOwned: Bool = false
                            if !(cap.isArray) {
                                if cRef != 0U64 && capSidx < c.arena.structs.count() {
                                    if !(c.isStrongRefInst(ref: cRef)) && !(c.isWeakRefLikeInst(ref: cRef)) {
                                        if !(rangeEquals(bytes: c.arena.bytes, start: cap.tyStart, len: cap.tyLen, kw: "Buffer")) {
                                            if c.arcNeedsRelease(ref: cRef) {
                                                self.valueArc(c: inout c, v: cv, typeRef: cRef, retain: true)
                                                capOwned = true
                                            }
                                        }
                                    }
                                }
                            }
                            self.pushLocalR(nameStart: cap.nameStart, nameLen: cap.nameLen, ptr: a, ty: slotTy, kind: kindFromTySpan(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen), structIdx: capSidx, isArr: cap.isArray, elemTy: cElem, elemKind: kindFromTySpan(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen), typeRef: cRef)
                            self.setLocalOwned(owned: capOwned)
                            ci += 1
                            }
                        }
                    }
                    mut val pi: U64 = 0
                    while pi < params.count() {
                        self.bindOneParam(c: inout c, p: params[pi], fv: fv, argIdx: pi + 1U64)
                        // a `move` param is owned (deinit'd here); by-value is a +0
                        // borrow — mirrors the regular-fn binding. Without this a
                        // String/struct-classed closure param rode the ungated
                        // typeRef release on every return (-1 per call on the
                        // caller's heap).
                        self.setLocalOwned(owned: params[pi].isMove)
                        pi += 1
                    }
                    // body locals are released at scope exit; params are borrows;
                    // struct-classed captures hold this activation's +1 (bound above).
                    self.curBodyMark = self.nLocals
                    self.genLlvmBlock(c: inout c, id: body)
                    if !(self.terminated) {
                        // fall-through epilogue (mirrors the regular-fn one): release
                        // the owned entries below the body mark — the per-activation
                        // capture retains, and any `move` param — before returning.
                        // Without this a void closure (no trailing `return`) leaked
                        // one capture count per call.
                        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: 18446744073709551615U64)
                        if self.curRetVoid {
                            LLVMBuildRetVoid(self.b)
                        } else {
                            LLVMBuildUnreachable(self.b)
                        }
                    }
                    c.cur.bodyFnIdx = savedBodyFn
                    c.cur.bodyEnvironment = savedBodyEnvironment
                    c.cur.bodyId = 0U64
                }
                _ => {}
            }
            s += 1
        }
    }
}
