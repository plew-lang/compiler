// Part of the LLVM backend (root: _.pw): extension- and direct-method dispatch.

// `recv#Ext.name(args)` (spec/09): a method call through an extension view. The
// extension method is tagged with its extension's id (Func.extId) and excluded
// from bare resolution, so we look it up with findExtMethod (receiver type +
// extension + selector) and emit a direct call (self = recv), like an inherent
// method. First cut: the receiver must be a registered struct value.

pub impl LlvmCtx {
    // Resolve `recv#src.name(args)` to its extension-method Func index, recovering the
    // receiver's lang-item type name into `recvNameStart`/`recvNameLen`. Resolution mirrors
    // the front-end: the call's own `#src` plus the receiver's view chain, then bare fallback
    // (a view is additive — it never hides the base surface). Returns funcs.count() when the
    // receiver isn't a struct/enum/primitive or no method resolves — the caller decides what
    // that means (emission reports it; type recovery silently yields 0). `report` gates the
    // stacked-view ambiguity error so type recovery, which runs before the emission of the
    // same call, doesn't double-report it.
    inout fn resolveExtMethodMfi(c: inout Comp, callId: U64, recv: U64, srcStart: U64, srcLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg], recvNameStart: inout U64, recvNameLen: inout U64, report: Bool) -> U64 {
        // the receiver's type name (the extension subject): a registered struct, a
        // registered enum, or a primitive lang-item (spec/09 — `x#Ext.m()` on any of them).
        mut val rsidx: U64 = self.exprStructIdx(c: inout c, id: recv)
        if rsidx < c.arena.structs.count() {
            recvNameStart = c.arena.structs[rsidx].nameStart
            recvNameLen = c.arena.structs[rsidx].nameLen
        } else {
            val erecvRef: U64 = self.exprTypeRef(c: inout c, id: recv)
            if erecvRef != 0U64 && self.enumRegSlot(c: inout c, start: c.arena.types[erecvRef].nameStart, len: c.arena.types[erecvRef].nameLen) < self.genEnumRefs.count() {
                recvNameStart = c.arena.types[erecvRef].nameStart
                recvNameLen = c.arena.types[erecvRef].nameLen
            } else {
                val pb: Bind = self.primLangItemRecvName(c: inout c, recv: recv)
                if pb.nameLen != 0U64 {
                    recvNameStart = pb.nameStart
                    recvNameLen = pb.nameLen
                } else {
                    return c.arena.funcs.count()
                }
            }
        }
        if callId < c.typeCache.callee.count() {
            return c.typeCache.callee[callId]
        }
        return c.arena.funcs.count()
    }

    // Resolve a plain `recv.name(args)` to its Func index, honouring the receiver's view
    // chain: an extension/conformance method reached only through a view on the receiver's
    // binding (`val sa = s#A; sa.a()`) resolves via findExtMethodById over collectViewChain,
    // and a view is additive so a bare findMethod is the fallback (spec/09). Returns
    // funcs.count() if unresolved. `report` gates the stacked-view ambiguity error so type
    // recovery, which runs before the emission of the same call, doesn't double-report it.
    inout fn resolveMethodMfi(c: inout Comp, callId: U64, recv: U64, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg], report: Bool) -> U64 {
        if callId < c.typeCache.callee.count() {
            return c.typeCache.callee[callId]
        }
        return c.arena.funcs.count()
    }

    inout fn genLlvmExtMethod(c: inout Comp, callId: U64, recv: U64, srcStart: U64, srcLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        mut val recvNameStart: U64 = 0
        mut val recvNameLen: U64 = 0
        val mfi: U64 = self.resolveExtMethodMfi(c: inout c, callId: callId, recv: recv, srcStart: srcStart, srcLen: srcLen, nameStart: nameStart, nameLen: nameLen, args: args, recvNameStart: inout recvNameStart, recvNameLen: inout recvNameLen, report: true)
        if recvNameLen == 0U64 {
            c.errorAt(offset: nameStart, msg: "LLVM backend: extension method call only on a struct / enum / primitive value (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        mut val rsidx: U64 = self.exprStructIdx(c: inout c, id: recv)
        if mfi >= c.arena.funcs.count() {
            c.errorAt(offset: nameStart, msg: "no such extension method on this type (is the extension name right, and a `pub impl`?)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        // A source-selected callable supplies an exact receiver declaration even
        // if a representation-free view node did not retain its generic TypeRef.
        // Use that declaration only as the backend's struct-owner fallback; source
        // selection itself remains the frontend's cached decision.
        if rsidx >= c.arena.structs.count() {
            val selected: Func = c.arena.funcs[mfi]
            if selected.recvTy != 0U64 && selected.recvTy < c.arena.types.count() {
                rsidx = c.structDefByNameAny(start: c.arena.types[selected.recvTy].nameStart, len: c.arena.types[selected.recvTy].nameLen)
            }
            if rsidx >= c.arena.structs.count() {
                rsidx = c.genericStructIndex(nameStart: recvNameStart, nameLen: recvNameLen)
            }
            if rsidx >= c.arena.structs.count() && selected.recvId != 0U64 && selected.recvId <= c.interner.count {
                rsidx = c.genericStructIndex(nameStart: c.interner.starts[selected.recvId - 1U64], nameLen: c.interner.lens[selected.recvId - 1U64])
            }
        }
        // an extension method on a registered struct / enum is the receiver's 0-type-arg `gm`
        // instance (B3-2). Its view (`#Ext`) is layered onto self in genLlvmFuncBody via the
        // func's extId, so the unified generic-method path resolves `self.b()` correctly.
        if rsidx < c.arena.structs.count() {
            val selected: Func = c.arena.funcs[mfi]
            mut val rStart: U64 = recvNameStart
            mut val rLen: U64 = recvNameLen
            if selected.recvTy != 0U64 && selected.recvTy < c.arena.types.count() {
                rStart = c.arena.types[selected.recvTy].nameStart
                rLen = c.arena.types[selected.recvTy].nameLen
            } else if selected.recvId != 0U64 && selected.recvId <= c.interner.count {
                rStart = c.interner.starts[selected.recvId - 1U64]
                rLen = c.interner.lens[selected.recvId - 1U64]
            }
            val rslot: U64 = self.structRegSlot(c: inout c, start: rStart, len: rLen)
            if rslot < self.genStructRefs.count() {
                // The final callable is already source-selected, but its receiver
                // still needs the concrete instance used by that call. The registry
                // slot is only the argless template; using it here loses `Box[I64]`
                // and makes a valid generic extension un-emittable.
                mut val instRef0: U64 = self.genStructRefs[rslot]
                if selected.recvTy != 0U64 && selected.recvTy < c.arena.types.count() {
                    if c.arena.types[selected.recvTy].args.count() > 0U64 {
                        instRef0 = c.runtimeTypeRef(ref: selected.recvTy)
                    }
                }
                // The view node itself is representation-free. Its underlying
                // receiver has the concrete generic instance recorded in typed IR.
                mut val recvTypeExpr: U64 = recv
                match c.arena.exprs[recv] {
                    Expr.ExtView(recv: val base, srcStart: _, srcLen: _, strip: _) => { recvTypeExpr = base }
                    _ => {}
                }
                val recvRef: U64 = self.exprTypeRef(c: inout c, id: recvTypeExpr)
                if recvRef != 0U64 && recvRef < c.arena.types.count() {
                    val recvTy: TypeRef = c.arena.types[recvRef]
                    if recvTy.args.count() > 0U64 {
                        // `T#Source` is a dispatch facet, not a distinct runtime
                        // struct instantiation. Erase only that top-level view while
                        // preserving the concrete generic arguments.
                        instRef0 = c.runtimeTypeRef(ref: recvRef)
                    }
                }
                val gmslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: mfi, instRef: instRef0, ownArgs: [])
                if gmslot < self.genMethK.count() {
                    return self.genGenMethodCall(c: inout c, recv: recv, mfi: mfi, slot: gmslot, instRef: instRef0, args: args)
                }
            }
        } else {
            val ereg: U64 = self.enumRegSlot(c: inout c, start: recvNameStart, len: recvNameLen)
            if ereg < self.genEnumRefs.count() {
                val einst: U64 = self.genEnumRefs[ereg]
                val egmslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: mfi, instRef: einst, ownArgs: [])
                if egmslot < self.genMethK.count() {
                    return self.genGenMethodCall(c: inout c, recv: recv, mfi: mfi, slot: egmslot, instRef: einst, args: args)
                }
            }
        }
        // A concrete generic receiver extension has no receiver binder
        // (`impl Box[I64]`), so it is not enumerated by the generic-method scan.
        // The selected callable's receiver TypeRef is its exact runtime instance;
        // declare that instance on demand without asking the expression to resolve
        // the source again.
        val selectedFallback: Func = c.arena.funcs[mfi]
        if selectedFallback.recvTy != 0U64 && selectedFallback.recvTy < c.arena.types.count() {
            if c.arena.types[selectedFallback.recvTy].args.count() > 0U64 {
                val runtimeRecv: U64 = c.runtimeTypeRef(ref: selectedFallback.recvTy)
                val directSlot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: mfi, instRef: runtimeRecv, ownArgs: [])
                if directSlot < self.genMethK.count() {
                    return self.genGenMethodCall(c: inout c, recv: recv, mfi: mfi, slot: directSlot, instRef: runtimeRecv, args: args)
                }
            }
        }
        mut val slot: U64 = self.userFnSlot(idx: mfi)
        if slot >= self.fnIdx.count() {
            slot = self.ensureProvidedDeclared(c: inout c, fi: mfi)
        }
        if slot >= self.fnIdx.count() {
            c.errorAt(offset: nameStart, msg: "LLVM backend: this extension method is not emittable yet (generic / provided)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val mf: Func = c.arena.funcs[mfi]
        val pinMark: U64 = self.pinCells.count()
        mut val av: Array[LLVMValueRef] = []
        if mf.selfInout {
            av.append(self.placePtrOfWritePinned(c: inout c, id: recv))
        } else {
            // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
            av.append(self.genBorrowedArg(c: inout c, argExpr: recv))
        }
        self.appendCallArgValues(c: inout c, av: inout av, f: mf, args: args)
        self.emitInoutOverlapChecks(c: inout c, f: mf, av: av, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: pinMark)
        val rv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[slot], self.fnVal[slot], arrayCPtr(av), av.count(), anon())
        self.releaseInoutPins(c: inout c, mark: pinMark)
        return rv
    }

    inout fn genLlvmMethod(c: inout Comp, callId: U64, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        // an existential `any P` receiver (spec/08): dynamic dispatch through the value's
        // vtable. The receiver's TypeRef carries isAny.
        val anyRecvRef: U64 = self.exprTypeRef(c: inout c, id: recv)
        if refIsAny(c: inout c, ref: anyRecvRef) {
            return self.genLlvmAnyDispatch(c: inout c, recv: recv, anyRef: anyRecvRef, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        // associated-function call `Type.name(args)` (the receiver is a type name, not
        // a value): dispatch to the assoc fn (no self argument).
        val arn: Bind = c.assocRecvName(recv: recv)
        if arn.nameLen != 0U64 {
            // the Buffer floor's construction assoc fn `Buffer.new()` is lowered inline
            // (its body is never emitted — like Array's intercepted methods).
            if rangeEquals(bytes: c.arena.bytes, start: arn.nameStart, len: arn.nameLen, kw: "Buffer") {
                if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "new") {
                    return self.genLlvmBufferNew(c: inout c)
                }
            }
            // a primitive numeric operator assoc call — a monomorphized generic `T.add(…)`
            // grounded to `I32.add(…)` / `F64.add(…)`, or an explicit `I32.add(…)` — resolves
            // to its std witness (`impl I32 as Add` in Core/Num.pw) via findAssoc below, like
            // any other assoc fn. The witness body bottoms out in the intrinsic floor
            // (genNumIntrinsic), so the std `impl` is the single source of truth for what the
            // op does (spec/12) — no primitive open-code shortcut here (mirrors the concrete
            // operator paths in Expr.pw, which route through the same witnesses).
            val afi: U64 = c.findAssoc(recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if afi < c.arena.funcs.count() {
                // a generic assoc fn (`Box[T].make(v: T)`): it has no self, so it rides the
                // generic free-function machinery (declareGenFns/emitGenFns). Infer the type
                // args from the call, find the monomorphized instance, and call it under the
                // type-param env (mono's registerAssocInst registered the FnInst).
                if c.isGenericFreeFn(fi: afi) {
                    mut val ginf: Array[U64] = self.llvmInferFnArgs(c: inout c, f: c.arena.funcs[afi], args: args)
                    // a factory whose type params aren't fully determined by its arguments
                    // (`Head.empty()` has none) grounds the unfound params from the expected
                    // type: a factory returns `Self = Head[typeParams]`, so when the context
                    // wants a same-head generic instance, its type args ARE the params.
                    self.groundAssocFromExpected(c: inout c, recvStart: arn.nameStart, recvLen: arn.nameLen, fi: afi, inferred: inout ginf)
                    val agslot: U64 = self.ensureFnInst(c: inout c, fnIdx: afi, args: ginf, recvInstRef: 0U64)
                    if agslot < self.genFnK.count() {
                        val gaf: Func = c.arena.funcs[afi]
                        val gsavedP: Array[Bind] = c.cur.typeParams
                        val gsavedA: Array[U64] = c.cur.typeArgs
                        c.cur.typeParams = gaf.typeParams
                        c.cur.typeArgs = ginf
                        val gPinMark: U64 = self.pinCells.count()
                        mut val gav: Array[LLVMValueRef] = []
                        self.appendCallArgValues(c: inout c, av: inout gav, f: gaf, args: args)
                        c.cur.typeParams = gsavedP
                        c.cur.typeArgs = gsavedA
                        self.emitInoutOverlapChecks(c: inout c, f: gaf, av: gav, args: args, hasRecv: false, recvExpr: 0U64, avArgStart: 0U64, pinMark: gPinMark)
                        val grv: LLVMValueRef = LLVMBuildCall2(self.b, self.genFnTy[agslot], self.genFnVal[agslot], arrayCPtr(gav), gav.count(), anon())
                        self.releaseInoutPins(c: inout c, mark: gPinMark)
                        return grv
                    }
                }
                val af: Func = c.arena.funcs[afi]
                val aPinMark: U64 = self.pinCells.count()
                mut val aav: Array[LLVMValueRef] = []
                self.appendCallArgValues(c: inout c, av: inout aav, f: af, args: args)
                // an assoc fn (`Greeter.banner()`, `tryFrom`, a free conformance fn) has no
                // self, so it is its own 0-type-arg `gf` instance (B4-1).
                val agslot: U64 = self.ensureFnInst(c: inout c, fnIdx: afi, args: [], recvInstRef: 0U64)
                if agslot < self.genFnK.count() {
                    self.emitInoutOverlapChecks(c: inout c, f: af, av: aav, args: args, hasRecv: false, recvExpr: 0U64, avArgStart: 0U64, pinMark: aPinMark)
                    val arv: LLVMValueRef = LLVMBuildCall2(self.b, self.genFnTy[agslot], self.genFnVal[agslot], arrayCPtr(aav), aav.count(), anon())
                    self.releaseInoutPins(c: inout c, mark: aPinMark)
                    return arv
                }
                c.errorAt(offset: nameStart, msg: "LLVM backend: this assoc fn is not emittable yet (generic / std / trait)")
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
        }
        // iterator combinator (`xs.map(f)` / `xs.filter(p)`): build the lazy adapter
        // struct inline (it just wraps the receiver + closure), bypassing the provided
        // method's body (which has method-own type params + an associated type).
        val adapterRef: U64 = self.adapterCallResultInst(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen)
        if adapterRef != 0U64 {
            return self.genLlvmAdapterWrap(c: inout c, recv: recv, args: args, adapterRef: adapterRef)
        }
        // a method on a primitive lang-item receiver (`s.isEmpty()` on String,
        // `(42I64).format(...)` on I64): these are extern lang-items (not registered
        // structs), so dispatch to their std method and lazily emit the body.
        val primRecv: Bind = self.primLangItemRecvName(c: inout c, recv: recv)
        if primRecv.nameLen != 0U64 {
            val smfi: U64 = c.findMethod(recvStart: primRecv.nameStart, recvLen: primRecv.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if smfi < c.arena.funcs.count() {
                // a method with its own type params on a primitive (`(self.a:U64).absorb[S](…)`).
                if c.arena.funcs[smfi].typeParams.count() > 0U64 {
                    val mtv: LLVMValueRef = self.genMethodOwnTypeParamCall(c: inout c, recv: recv, mfi: smfi, recvStart: primRecv.nameStart, recvLen: primRecv.nameLen, args: args)
                    if LLVMIsNull(mtv) == 0I32 {
                        return mtv
                    }
                }
                val sslot: U64 = self.ensureProvidedDeclared(c: inout c, fi: smfi)
                if sslot < self.fnIdx.count() {
                    val smf: Func = c.arena.funcs[smfi]
                    val sPinMark: U64 = self.pinCells.count()
                    mut val sav: Array[LLVMValueRef] = []
                    if smf.selfInout {
                        sav.append(self.placePtrOfWritePinned(c: inout c, id: recv))
                    } else {
                        // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
                        sav.append(self.genBorrowedArg(c: inout c, argExpr: recv))
                    }
                    self.appendCallArgValues(c: inout c, av: inout sav, f: smf, args: args)
                    self.emitInoutOverlapChecks(c: inout c, f: smf, av: sav, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: sPinMark)
                    val srv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[sslot], self.fnVal[sslot], arrayCPtr(sav), sav.count(), anon())
                    self.releaseInoutPins(c: inout c, mark: sPinMark)
                    return srv
                }
            }
        }
        // generic-receiver method dispatch (`box.get()`, `maybe.unwrapOr(...)`): the
        // receiver local carries its instantiation ref; route to the monomorphized
        // method instance emitted by declareGenMethods.
        val recvRef: U64 = self.exprTypeRef(c: inout c, id: recv)
        // every array expr (local, struct field, call/method result, literal) now carries a
        // full `Array[E]` instance ref via exprTypeRef, so its pure-Plew methods
        // (append/get/set/removeLast/count over self.data) ride the uniform generic-method
        // path below like any generic-instance receiver (collections.md E3: no Array
        // type-name synthesis of the receiver ref here any more).
        if recvRef != 0U64 {
            // Reference cells are opaque intrinsics (not registered generic structs),
            // but their std `impl[T]` methods (weak / upgrade) are ordinary generic methods —
            // route them through the same monomorphized-method path (the bodies bottom out in
            // the reference-cell intrinsics, lowered by name in genLlvmCall).
            if c.isGenericInst(ref: recvRef) || c.isStrongRefInst(ref: recvRef) || c.isWeakRefLikeInst(ref: recvRef) {
                val grt: TypeRef = c.arena.types[recvRef]
                val gmfi: U64 = c.findMethod(recvStart: grt.nameStart, recvLen: grt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if gmfi < c.arena.funcs.count() {
                    // a provided terminal with method-own type params (`fold[B]` on a lazy
                    // adapter receiver): infer the own args from the call so the slot is
                    // keyed by them and the body's env grounds the own param.
                    val gOwn: Array[U64] = methodOwnArgs(c: inout c, mfi: gmfi, instRef: recvRef, args: args)
                    val gslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: gmfi, instRef: recvRef, ownArgs: gOwn)
                    if gslot < self.genMethK.count() {
                        return self.genGenMethodCall(c: inout c, recv: recv, mfi: gmfi, slot: gslot, instRef: recvRef, args: args)
                    }
                    c.errorAt(offset: nameStart, msg: "LLVM backend: this generic method is not emittable yet (provided / std / method-own type params)")
                    return LLVMConstInt(self.i64ty, 0U64, 0I32)
                }
            }
        }
        // (Neither Buffer nor Array floor methods are intercepted here by receiver-type +
        // name any more: `Buffer[T]` and `Array[T]` are both generic-instance receivers, so
        // their methods ride the uniform generic-method path above (238) like Box/Optional.
        // Array's methods are pure Plew over `self.data` (std/Lang.pw); the inner `buffer*`
        // intrinsics lower by function identity in genLlvmCall. collections.md §3-付録3.
        // The `wrapping*` ops are no longer intercepted here either: they are FixedWidthInteger
        // witnesses `<Prim>.wrappingAdd(a, b)` in std/Core/Num.pw whose bodies bottom out in the
        // `<pfx>Wrap*` intrinsic floor — resolved and emitted like any assoc fn, with identity,
        // so a same-named user extension is no longer hijacked.)
        val rsidx: U64 = self.exprStructIdx(c: inout c, id: recv)
        if rsidx >= c.arena.structs.count() {
            // an enum-receiver method (`c.code()` on an enum value): dispatch like a
            // struct method (self by value, or a pointer for `inout fn`).
            val erecvRef: U64 = self.exprTypeRef(c: inout c, id: recv)
            if erecvRef != 0U64 {
                val et: TypeRef = c.arena.types[erecvRef]
                val ereg0: U64 = self.enumRegSlot(c: inout c, start: et.nameStart, len: et.nameLen)
                if ereg0 < self.genEnumRefs.count() {
                    val emfi: U64 = c.findMethod(recvStart: et.nameStart, recvLen: et.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if emfi < c.arena.funcs.count() {
                        // a non-generic method declared on this enum is its 0-type-arg `gm`
                        // instance (B3-2), like a struct method.
                        if c.arena.funcs[emfi].recvId == intern(c: inout c, start: et.nameStart, len: et.nameLen) {
                            val einst: U64 = self.genEnumRefs[ereg0]
                            val egmslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: emfi, instRef: einst, ownArgs: [])
                            if egmslot < self.genMethK.count() {
                                return self.genGenMethodCall(c: inout c, recv: recv, mfi: emfi, slot: egmslot, instRef: einst, args: args)
                            }
                        }
                        mut val eslot: U64 = self.userFnSlot(idx: emfi)
                        if eslot >= self.fnIdx.count() {
                            eslot = self.ensureProvidedDeclared(c: inout c, fi: emfi)
                        }
                        if eslot < self.fnIdx.count() {
                            val emf: Func = c.arena.funcs[emfi]
                            val ePinMark: U64 = self.pinCells.count()
                            mut val eav: Array[LLVMValueRef] = []
                            if emf.selfInout {
                                eav.append(self.placePtrOfWritePinned(c: inout c, id: recv))
                            } else {
                                // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
                                eav.append(self.genBorrowedArg(c: inout c, argExpr: recv))
                            }
                            self.appendCallArgValues(c: inout c, av: inout eav, f: emf, args: args)
                            self.emitInoutOverlapChecks(c: inout c, f: emf, av: eav, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: ePinMark)
                            val erv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[eslot], self.fnVal[eslot], arrayCPtr(eav), eav.count(), anon())
                            self.releaseInoutPins(c: inout c, mark: ePinMark)
                            return erv
                        }
                        c.errorAt(offset: nameStart, msg: "LLVM backend: this enum method is not emittable yet (generic / provided)")
                        return LLVMConstInt(self.i64ty, 0U64, 0I32)
                    }
                }
            }
            c.errorAt(offset: nameStart, msg: "LLVM backend: method call only on a registered struct value (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val sd: StructDef = c.arena.structs[rsidx]
        // a viewed receiver (a value re-view `v#Ext`, a stacked `v#A#B`, or a
        // param/binding typed `Type#Ext`) resolves the extension's method first
        // (spec/09); the extension shadows a same-name bare method under the view. With
        // stacked views, the name must resolve in exactly one (same-name in two stacked
        // views is ambiguous).
        mut val mfi: U64 = self.resolveMethodMfi(c: inout c, callId: callId, recv: recv, recvStart: sd.nameStart, recvLen: sd.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, report: true)
        if mfi >= c.arena.funcs.count() {
            // `self.f(n: x)` where `f` is a closure-typed field (the iterator-adapter
            // pattern — a struct holds a mapping/predicate closure): load the field value
            // and call it indirectly. The field type grounds through any generic env.
            val ffi: U64 = structFieldIndex(c: inout c, sidx: rsidx, start: nameStart, len: nameLen)
            if ffi < sd.fields.count() {
                val grounded: U64 = c.groundTypeRef(ref: sd.fields[ffi].ty)
                if c.isFnType(ref: grounded) {
                    val recvVal: LLVMValueRef = self.genLlvmExpr(c: inout c, id: recv)
                    val cloVal: LLVMValueRef = LLVMBuildExtractValue(self.b, recvVal, ffi, anon())
                    return self.emitClosureCallValue(c: inout c, cloVal: cloVal, fnRef: grounded, args: args)
                }
            }
            // a bare call to a method that exists only as an extension method (spec/09):
            // extension methods don't join bare resolution — point the user at the view.
            if c.extMethodNameExists(recvStart: sd.nameStart, recvLen: sd.nameLen, nameStart: nameStart, nameLen: nameLen) {
                c.errorAt(offset: nameStart, msg: "this method is only provided by an extension — call it through the view (`value#Ext.method()`)")
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
            // a multi-path inter-trait conformance (spec/09): the type reaches the target
            // trait through more than one subject trait, so it does not conform bare —
            // the method is reachable only by selecting a path with `value#P`.
            if c.viewOnlyMethodExists(recvStart: sd.nameStart, recvLen: sd.nameLen, nameStart: nameStart, nameLen: nameLen) {
                c.errorAt(offset: nameStart, msg: "ambiguous inter-trait conformance: this type reaches the trait providing this method through more than one subject trait — select a conformance path with `value#P.method()` (spec/09)")
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
            c.errorAt(offset: nameStart, msg: "LLVM backend: method not found / not yet supported")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        // a method with its OWN type params (`absorb[S](sink: inout S) where S: Sink`):
        // infer them from the args and monomorphize on (method, method-type-args),
        // keyed by a pseudo instance ref (receiver name + the inferred method args).
        if c.arena.funcs[mfi].typeParams.count() > 0U64 {
            val mtv: LLVMValueRef = self.genMethodOwnTypeParamCall(c: inout c, recv: recv, mfi: mfi, recvStart: sd.nameStart, recvLen: sd.nameLen, args: args)
            if LLVMIsNull(mtv) == 0I32 {
                return mtv
            }
        }
        val mf: Func = c.arena.funcs[mfi]
        // a `move fn` consumes self (its deinit runs in the callee): mark the receiver
        // local moved so the caller does not also deinit it.
        if mf.selfMove {
            match c.arena.exprs[recv] {
                Expr.Ident(start: val s, len: val l) => {
                    self.markLocalMoved(c: inout c, start: s, len: l)
                }
                _ => {}
            }
        }
        // a non-generic method declared on this struct (recvId names the struct — inherent OR
        // a frontend-specialized conformance witness like `s#C.a()`, whose self view is layered
        // on in genLlvmFuncBody via f.selfViewId) is its receiver's 0-type-arg `gm` instance
        // (B3-2): route through the unified generic-method path (its empty env is a no-op).
        if mf.recvId == intern(c: inout c, start: sd.nameStart, len: sd.nameLen) {
            val rslot: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
            if rslot < self.genStructRefs.count() {
                val instRef0: U64 = self.genStructRefs[rslot]
                val gmslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: mfi, instRef: instRef0, ownArgs: [])
                if gmslot < self.genMethK.count() {
                    return self.genGenMethodCall(c: inout c, recv: recv, mfi: mfi, slot: gmslot, instRef: instRef0, args: args)
                }
            }
        }
        mut val slot: U64 = self.userFnSlot(idx: mfi)
        // a provided trait method OR a non-entry-module std method (SipHasher.writeU64,
        // reached via a generic Hasher) is declared+emitted lazily on first call.
        if slot >= self.fnIdx.count() {
            slot = self.ensureProvidedDeclared(c: inout c, fi: mfi)
        }
        if slot >= self.fnIdx.count() {
            c.errorAt(offset: nameStart, msg: "LLVM backend: this method is not emittable yet (generic / provided / trait receiver)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val pinMark: U64 = self.pinCells.count()
        mut val av: Array[LLVMValueRef] = []
        // self: an `inout fn` needs the receiver's address (a place); else its value.
        if mf.selfInout {
            av.append(self.placePtrOfWritePinned(c: inout c, id: recv))
        } else {
            // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
            av.append(self.genBorrowedArg(c: inout c, argExpr: recv))
        }
        self.appendCallArgValues(c: inout c, av: inout av, f: mf, args: args)
        self.emitInoutOverlapChecks(c: inout c, f: mf, av: av, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: pinMark)
        val rv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[slot], self.fnVal[slot], arrayCPtr(av), av.count(), anon())
        self.releaseInoutPins(c: inout c, mark: pinMark)
        return rv
    }
}
