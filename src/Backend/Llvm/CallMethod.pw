// Part of the LLVM backend (root: _.pw): extension- and direct-method dispatch.

// A method call, including `recv#Ext.name(args)`, consumes the final callable
// selected by Mono. Source-view spelling is never re-resolved in LLVM.

pub impl LlvmCtx {
    inout fn genLlvmMethod(c: inout Comp, callId: U64, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        // an existential `any P` receiver (spec/08): dynamic dispatch through the value's
        // vtable. The receiver's TypeRef carries isAny.
        val finalMfi: U64 = c.bodyCallee(exprId: callId)
        val selectedRecvRef: U64 = c.bodyCalleeReceiverRef(exprId: callId)
        if selectedRecvRef != 0U64 {
            if refIsAny(c: inout c, ref: selectedRecvRef) {
                if c.bodyCalleeTargetKind(exprId: callId) != 1U64 {
                    c.errorAt(offset: nameStart, msg: "internal error: final existential callable was not recorded")
                    return LLVMConstInt(self.i64ty, 0U64, 0I32)
                }
                return self.genLlvmAnyDispatch(c: inout c, recv: recv, anyRef: selectedRecvRef, traitIdx: c.bodyCalleeTargetTraitIdx(exprId: callId), slot: c.bodyCalleeTargetSlot(exprId: callId), args: args, callOffset: nameStart)
            }
        }
        // Mono resolved this call under the exact body instance.  Every static
        // dispatch branch below consumes this one decision; none re-runs lookup.
        // Associated calls include explicit `Type.name(args)` and factories
        // rewritten from `<Type.name …/>`.  The syntax is no longer consulted:
        // Mono has already selected the callable, and that callable says whether
        // it is associated.  Reclassifying `recv` here used backend-local scope
        // state and made a factory such as `<String.checked …/>` diverge from
        // its frontend decision.
        mut val arn: Bind = <Bind nameStart=0U64 nameLen=0U64 fieldStart=0U64 fieldLen=0U64 />
        if finalMfi < c.arena.funcs.count() {
            val finalFunc: Func = c.arena.funcs[finalMfi]
            if finalFunc.isAssoc {
                arn = <Bind nameStart=finalFunc.recvStart nameLen=finalFunc.recvLen fieldStart=finalFunc.recvStart fieldLen=finalFunc.recvLen />
            }
        }
        if arn.nameLen != 0U64 {
            // the Buffer floor's construction assoc fn `Buffer.new()` is lowered inline
            // (its body is never emitted — like Array's intercepted methods).
            if rangeEquals(bytes: c.arena.bytes, start: arn.nameStart, len: arn.nameLen, kw: "Buffer") {
                if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "new") {
                    return self.genLlvmBufferNew(c: inout c)
                }
            }
            // a primitive numeric operator assoc call — a monomorphized generic `T.add(…)`
            // grounded to `I32.add(…)` / `F64.add(…)`, or an explicit `I32.add(…)` — resolves
            // to its std witness (`impl I32 as Add` in Core/Num.pw) through Mono's final callee, like
            // any other assoc fn. The witness body bottoms out in the intrinsic floor
            // (genNumIntrinsic), so the std `impl` is the single source of truth for what the
            // op does (spec/12) — no primitive open-code shortcut here (mirrors the concrete
            // operator paths in Expr.pw, which route through the same witnesses).
            val afi: U64 = finalMfi
            if afi < c.arena.funcs.count() {
                // A generic associated function (`Box[T].make(v: T)`) rides the
                // generic free-function machinery.  Its substitutions were fixed
                // together with finalMfi by Mono; expected-type grounding belongs
                // there too, never in LLVM.
                if c.isGenericFreeFn(fi: afi) {
                    val ginf: Array[U64] = c.bodyCalleeTypeArgs(exprId: callId)
                    if ginf.count() != c.arena.funcs[afi].typeParams.count() || !(c.fnArgsAllGround(args: ginf)) {
                        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "empty") {
                            c.errorAt(offset: nameStart, msg: "internal error: final associated callable is missing grounded type arguments (empty)")
                        } else if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "fromValue") {
                            c.errorAt(offset: nameStart, msg: "internal error: final associated callable is missing grounded type arguments (fromValue)")
                        } else {
                            c.errorAt(offset: nameStart, msg: "internal error: final associated callable is missing grounded type arguments (other)")
                        }
                        return LLVMConstInt(self.i64ty, 0U64, 0I32)
                    }
                    val agslot: U64 = self.ensureFnInst(c: inout c, fnIdx: afi, args: ginf, recvInstRef: selectedRecvRef)
                    if agslot < self.genFnK.count() {
                        val gaf: Func = c.arena.funcs[afi]
                        val gsavedP: Array[Bind] = c.cur.typeParams
                        val gsavedA: Array[U64] = c.cur.typeArgs
                        c.cur.typeParams = gaf.typeParams
                        c.cur.typeArgs = ginf
                        val gPinMark: U64 = self.pinCells.count()
                        mut val gav: Array[LLVMValueRef] = []
                        self.appendCallArgValues(c: inout c, av: inout gav, f: gaf, args: args)
                        c.cur.typeParams = gsavedP
                        c.cur.typeArgs = gsavedA
                        self.emitInoutOverlapChecks(c: inout c, f: gaf, av: gav, args: args, hasRecv: false, recvExpr: 0U64, avArgStart: 0U64, pinMark: gPinMark)
                        val grv: LLVMValueRef = LLVMBuildCall2(self.b, self.genFnTy[agslot], self.genFnVal[agslot], arrayCPtr(gav), gav.count(), anon())
                        self.releaseInoutPins(c: inout c, mark: gPinMark)
                        return grv
                    }
                }
                val af: Func = c.arena.funcs[afi]
                val aPinMark: U64 = self.pinCells.count()
                mut val aav: Array[LLVMValueRef] = []
                self.appendCallArgValues(c: inout c, av: inout aav, f: af, args: args)
                // an assoc fn (`Greeter.banner()`, `tryFrom`, a free conformance fn) has no
                // self, so it is its own 0-type-arg `gf` instance (B4-1).
                val agslot: U64 = self.ensureFnInst(c: inout c, fnIdx: afi, args: [], recvInstRef: selectedRecvRef)
                if agslot < self.genFnK.count() {
                    self.emitInoutOverlapChecks(c: inout c, f: af, av: aav, args: args, hasRecv: false, recvExpr: 0U64, avArgStart: 0U64, pinMark: aPinMark)
                    val arv: LLVMValueRef = LLVMBuildCall2(self.b, self.genFnTy[agslot], self.genFnVal[agslot], arrayCPtr(aav), aav.count(), anon())
                    self.releaseInoutPins(c: inout c, mark: aPinMark)
                    return arv
                }
                c.errorAt(offset: nameStart, msg: "LLVM backend: this assoc fn is not emittable yet (generic / std / trait)")
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
        }
        // iterator combinator (`xs.map(f)` / `xs.filter(p)`): build the lazy adapter
        // struct inline (it just wraps the receiver + closure), bypassing the provided
        // method's body (which has method-own type params + an associated type).
        val adapterRef: U64 = self.adapterResultForFinalMethod(c: inout c, finalMfi: finalMfi, resultRef: c.bodyCalleeResultRef(exprId: callId))
        if adapterRef != 0U64 {
            return self.genLlvmAdapterWrap(c: inout c, recv: recv, args: args, adapterRef: adapterRef)
        }
        // a method on a primitive lang-item receiver (`s.isEmpty()` on String,
        // `(42I64).format(...)` on I64): these are extern lang-items (not registered
        // structs), so dispatch to their std method and lazily emit the body.
        mut val primRecv: Bind = <Bind nameStart=0U64 nameLen=0U64 fieldStart=0U64 fieldLen=0U64 />
        if selectedRecvRef != 0U64 && selectedRecvRef < c.arena.types.count() {
            val selectedTy: TypeRef = c.arena.types[selectedRecvRef]
            val underlying: Bind = c.newtypeUnderName(start: selectedTy.nameStart, len: selectedTy.nameLen)
            // `String` is a language-item value type just like scalar
            // primitives: it has no ordinary struct registration but its
            // provided methods use the same final-callable path.
            if c.isPrimType(start: underlying.nameStart, len: underlying.nameLen) || rangeEquals(bytes: c.arena.bytes, start: underlying.nameStart, len: underlying.nameLen, kw: "String") {
                primRecv = <Bind nameStart=underlying.nameStart nameLen=underlying.nameLen fieldStart=0U64 fieldLen=0U64 />
            }
        }
        if primRecv.nameLen != 0U64 {
            val smfi: U64 = finalMfi
            if smfi < c.arena.funcs.count() {
                // A provided primitive witness has a receiver-specific ABI and
                // Self environment.  Key it by the final receiver instance,
                // like every other selected member, instead of the legacy
                // Func-only `pf` cache (which mixed print[I64] and
                // print[String] through their shared trait-origin body).
                if selectedRecvRef != 0U64 {
                    val primSlot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: smfi, instRef: selectedRecvRef, ownArgs: [])
                    if primSlot < self.genMethK.count() {
                        return self.genGenMethodCall(c: inout c, recv: recv, mfi: smfi, slot: primSlot, instRef: selectedRecvRef, args: args)
                    }
                }
                // a method with its own type params on a primitive (`(self.a:U64).absorb[S](…)`).
                if c.arena.funcs[smfi].typeParams.count() > 0U64 {
                    val mtv: LLVMValueRef = self.genMethodOwnTypeParamCall(c: inout c, callId: callId, recv: recv, mfi: smfi, recvStart: primRecv.nameStart, recvLen: primRecv.nameLen, args: args)
                    if LLVMIsNull(mtv) == 0I32 {
                        return mtv
                    }
                }
                val sslot: U64 = self.ensureProvidedDeclared(c: inout c, fi: smfi)
                if sslot < self.fnIdx.count() {
                    val smf: Func = c.arena.funcs[smfi]
                    val sPinMark: U64 = self.pinCells.count()
                    mut val sav: Array[LLVMValueRef] = []
                    if smf.selfInout {
                        sav.append(self.placePtrOfWritePinned(c: inout c, id: recv))
                    } else {
                        // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
                        sav.append(self.genBorrowedArg(c: inout c, argExpr: recv))
                    }
                    self.appendCallArgValues(c: inout c, av: inout sav, f: smf, args: args)
                    self.emitInoutOverlapChecks(c: inout c, f: smf, av: sav, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: sPinMark)
                    val srv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[sslot], self.fnVal[sslot], arrayCPtr(sav), sav.count(), anon())
                    self.releaseInoutPins(c: inout c, mark: sPinMark)
                    return srv
                }
            }
            c.errorAt(offset: nameStart, msg: "internal error: primitive call has no final callable")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        // generic-receiver method dispatch (`box.get()`, `maybe.unwrapOr(...)`): the
        // receiver local carries its instantiation ref; route to the monomorphized
        // method instance emitted by declareGenMethods.
        val recvRef: U64 = selectedRecvRef
        // every array expr (local, struct field, call/method result, literal) now carries a
        // full `Array[E]` instance ref via exprTypeRef, so its pure-Plew methods
        // (append/get/set/removeLast/count over self.data) ride the uniform generic-method
        // path below like any generic-instance receiver (collections.md E3: no Array
        // type-name synthesis of the receiver ref here any more).
        if recvRef != 0U64 {
            val grt: TypeRef = c.arena.types[recvRef]
            // Reference cells are opaque intrinsics (not registered generic structs),
            // but their std `impl[T]` methods (weak / upgrade) are ordinary generic methods —
            // route them through the same monomorphized-method path (the bodies bottom out in
            // the reference-cell intrinsics, lowered by name in genLlvmCall).
            // Whether a call needs the receiver-instance emitter is a property
            // of the selected receiver declaration, not of an incidental
            // TypeRef shape.  A static/source view can preserve the concrete
            // arguments while no longer satisfying `isGenericInst`; routing it
            // through the legacy provided-function cache then erases those
            // arguments and opens the wrong final body.
            if c.recvParamCount(nameStart: grt.nameStart, nameLen: grt.nameLen) > 0U64 || c.isStrongRefInst(ref: recvRef) || c.isWeakRefLikeInst(ref: recvRef) {
                // The verifier has already recorded the source-aware decision for this
                // exact AST call.  Consume that table directly: a bare re-query drops a
                // static `#Ext` / `#Trait` view before generic emission.
                val gmfi: U64 = c.bodyCallee(exprId: callId)
                if gmfi < c.arena.funcs.count() {
                    // a provided terminal with method-own type params (`fold[B]` on a lazy
                    // adapter receiver): infer the own args from the call so the slot is
                    // keyed by them and the body's env grounds the own param.
                    val allArgs: Array[U64] = c.bodyCalleeTypeArgs(exprId: callId)
                    val recvCount: U64 = c.recvParamCount(nameStart: grt.nameStart, nameLen: grt.nameLen)
                    mut val gOwn: Array[U64] = []
                    mut val ownI: U64 = recvCount
                    while ownI < allArgs.count() {
                        gOwn.append(allArgs[ownI])
                        ownI += 1U64
                    }
                    val gslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: gmfi, instRef: recvRef, ownArgs: gOwn)
                    if gslot < self.genMethK.count() {
                        return self.genGenMethodCall(c: inout c, recv: recv, mfi: gmfi, slot: gslot, instRef: recvRef, args: args)
                    }
                    c.errorAt(offset: nameStart, msg: "LLVM backend: this generic method is not emittable yet (provided / std / method-own type params)")
                    return LLVMConstInt(self.i64ty, 0U64, 0I32)
                }
            }
        }
        // (Neither Buffer nor Array floor methods are intercepted here by receiver-type +
        // name any more: `Buffer[T]` and `Array[T]` are both generic-instance receivers, so
        // their methods ride the uniform generic-method path above (238) like Box/Optional.
        // Array's methods are pure Plew over `self.data` (std/Lang.pw); the inner `buffer*`
        // intrinsics lower by function identity in genLlvmCall. collections.md §3-付録3.
        // The `wrapping*` ops are no longer intercepted here either: they are FixedWidthInteger
        // witnesses `<Prim>.wrappingAdd(a, b)` in std/Core/Num.pw whose bodies bottom out in the
        // `<pfx>Wrap*` intrinsic floor — resolved and emitted like any assoc fn, with identity,
        // so a same-named user extension is no longer hijacked.)
        mut val rsidx: U64 = c.arena.structs.count()
        if selectedRecvRef != 0U64 && selectedRecvRef < c.arena.types.count() {
            val selectedTy: TypeRef = c.arena.types[selectedRecvRef]
            rsidx = c.structDefByNameAny(start: selectedTy.nameStart, len: selectedTy.nameLen)
        }
        if rsidx >= c.arena.structs.count() {
            // an enum-receiver method (`c.code()` on an enum value): dispatch like a
            // struct method (self by value, or a pointer for `inout fn`).
            val erecvRef: U64 = selectedRecvRef
            if erecvRef != 0U64 {
                val et: TypeRef = c.arena.types[erecvRef]
                val ereg0: U64 = self.enumRegSlot(c: inout c, start: et.nameStart, len: et.nameLen)
                if ereg0 < self.genEnumRefs.count() {
                    val emfi: U64 = finalMfi
                    if emfi < c.arena.funcs.count() {
                        // a non-generic method declared on this enum is its 0-type-arg `gm`
                        // instance (B3-2), like a struct method.
                        if c.arena.funcs[emfi].recvId == intern(c: inout c, start: et.nameStart, len: et.nameLen) {
                            val einst: U64 = self.genEnumRefs[ereg0]
                            val egmslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: emfi, instRef: einst, ownArgs: [])
                            if egmslot < self.genMethK.count() {
                                return self.genGenMethodCall(c: inout c, recv: recv, mfi: emfi, slot: egmslot, instRef: einst, args: args)
                            }
                        }
                        mut val eslot: U64 = self.userFnSlot(idx: emfi)
                        if eslot >= self.fnIdx.count() {
                            eslot = self.ensureProvidedDeclared(c: inout c, fi: emfi)
                        }
                        if eslot < self.fnIdx.count() {
                            val emf: Func = c.arena.funcs[emfi]
                            val ePinMark: U64 = self.pinCells.count()
                            mut val eav: Array[LLVMValueRef] = []
                            if emf.selfInout {
                                eav.append(self.placePtrOfWritePinned(c: inout c, id: recv))
                            } else {
                                // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
                                eav.append(self.genBorrowedArg(c: inout c, argExpr: recv))
                            }
                            self.appendCallArgValues(c: inout c, av: inout eav, f: emf, args: args)
                            self.emitInoutOverlapChecks(c: inout c, f: emf, av: eav, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: ePinMark)
                            val erv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[eslot], self.fnVal[eslot], arrayCPtr(eav), eav.count(), anon())
                            self.releaseInoutPins(c: inout c, mark: ePinMark)
                            return erv
                        }
                        c.errorAt(offset: nameStart, msg: "LLVM backend: this enum method is not emittable yet (generic / provided)")
                        return LLVMConstInt(self.i64ty, 0U64, 0I32)
                    }
                }
            }
            c.errorAt(offset: nameStart, msg: "LLVM backend: method call only on a registered struct value (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val sd: StructDef = c.arena.structs[rsidx]
        // a viewed receiver (a value re-view `v#Ext`, a stacked `v#A#B`, or a
        // param/binding typed `Type#Ext`) resolves the extension's method first
        // (spec/09); the extension shadows a same-name bare method under the view. With
        // stacked views, the name must resolve in exactly one (same-name in two stacked
        // views is ambiguous).
        val mfi: U64 = finalMfi
        if mfi >= c.arena.funcs.count() {
            if c.bodyCalleeTargetKind(exprId: callId) == 3U64 {
                val ffi: U64 = c.bodyCalleeTargetSlot(exprId: callId)
                val fnRef: U64 = c.bodyCalleeTargetTypeRef(exprId: callId)
                if ffi >= sd.fields.count() || fnRef == 0U64 || !(c.isFnType(ref: fnRef)) {
                    c.errorAt(offset: nameStart, msg: "internal error: final closure-field callable was not recorded")
                    return LLVMConstInt(self.i64ty, 0U64, 0I32)
                }
                val recvVal: LLVMValueRef = self.genLlvmExpr(c: inout c, id: recv)
                val cloVal: LLVMValueRef = LLVMBuildExtractValue(self.b, recvVal, ffi, anon())
                return self.emitClosureCallValue(c: inout c, cloVal: cloVal, fnRef: fnRef, args: args)
            }
            c.errorAt(offset: nameStart, msg: "internal error: final callable is missing for a verified method call")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        // a method with its OWN type params (`absorb[S](sink: inout S) where S: Sink`):
        // infer them from the args and monomorphize on (method, method-type-args),
        // keyed by a pseudo instance ref (receiver name + the inferred method args).
        if c.arena.funcs[mfi].typeParams.count() > 0U64 {
            val mtv: LLVMValueRef = self.genMethodOwnTypeParamCall(c: inout c, callId: callId, recv: recv, mfi: mfi, recvStart: sd.nameStart, recvLen: sd.nameLen, args: args)
            if LLVMIsNull(mtv) == 0I32 {
                return mtv
            }
        }
        val mf: Func = c.arena.funcs[mfi]
        // a `move fn` consumes self (its deinit runs in the callee): mark the receiver
        // local moved so the caller does not also deinit it.
        if mf.selfMove {
            match c.arena.exprs[recv] {
                Expr.Ident(start: val s, len: val l) => {
                    self.markLocalMoved(c: inout c, start: s, len: l)
                }
                _ => {}
            }
        }
        // a non-generic method declared on this struct (recvId names the struct — inherent OR
        // a frontend-specialized conformance witness like `s#C.a()`) is its receiver's
        // 0-type-arg `gm` instance
        // (B3-2): route through the unified generic-method path (its empty env is a no-op).
        if mf.recvId == intern(c: inout c, start: sd.nameStart, len: sd.nameLen) {
            val rslot: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
            if rslot < self.genStructRefs.count() {
                val instRef0: U64 = self.genStructRefs[rslot]
                val gmslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: mfi, instRef: instRef0, ownArgs: [])
                if gmslot < self.genMethK.count() {
                    return self.genGenMethodCall(c: inout c, recv: recv, mfi: mfi, slot: gmslot, instRef: instRef0, args: args)
                }
            }
        }
        mut val slot: U64 = self.userFnSlot(idx: mfi)
        // a provided trait method OR a non-entry-module std method (SipHasher.writeU64,
        // reached via a generic Hasher) is declared+emitted lazily on first call.
        if slot >= self.fnIdx.count() {
            slot = self.ensureProvidedDeclared(c: inout c, fi: mfi)
        }
        if slot >= self.fnIdx.count() {
            c.errorAt(offset: nameStart, msg: "LLVM backend: this method is not emittable yet (generic / provided / trait receiver)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val pinMark: U64 = self.pinCells.count()
        mut val av: Array[LLVMValueRef] = []
        // self: an `inout fn` needs the receiver's address (a place); else its value.
        if mf.selfInout {
            av.append(self.placePtrOfWritePinned(c: inout c, id: recv))
        } else {
            // guaranteed self (+0): place = borrow; a temp receiver gets an owned home.
            av.append(self.genBorrowedArg(c: inout c, argExpr: recv))
        }
        self.appendCallArgValues(c: inout c, av: inout av, f: mf, args: args)
        self.emitInoutOverlapChecks(c: inout c, f: mf, av: av, args: args, hasRecv: true, recvExpr: recv, avArgStart: 1U64, pinMark: pinMark)
        val rv: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[slot], self.fnVal[slot], arrayCPtr(av), av.count(), anon())
        self.releaseInoutPins(c: inout c, mark: pinMark)
        return rv
    }
}
