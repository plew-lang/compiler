// Part of the LLVM backend (root: _.pw): async lowering — the stackless state-machine emission (spec/14).

// ---- async lowering (spec/14): stackless state machine ----
//
// Mirrors Codegen/Async.pw (the C backend) in LLVM IR. Each `async fn` becomes a
// frame struct (state + the returned `self` promise + the awaited `sub` promise +
// every param and hoisted local, so values survive `await` suspensions), a resume
// fn (the body, with a dispatch `switch` at entry that re-enters at the right
// await point), and an entry fn (allocates the frame, copies params, creates
// `self`, runs resume once, returns `self`). The promise value is a type-erased
// i64 (scalars / () for now; struct/String results are additive). The runtime
// (promises, FIFO ready queue, virtual-clock timers, event loop, sleep) is the
// SAME C as the C backend, emitted by `--runtime` (external linkage so the IR
// links against it). The state machine is the only part lowered to IR.


pub impl LlvmCtx {

    // The LLVM type of an async frame field (a param or a hoisted local): a `Promise`
    // is a pointer (PlewPromise*), an array its {ptr,i64} value, a generic instance /
    // enum / scalar its normal type. Type-erased await values are i64, but a binding
    // keeps its declared type (the coerce happens at the store).
    inout fn asyncFieldTy(c: inout Comp, tyStart: U64, tyLen: U64, ty: U64, isArray: Bool) -> LLVMTypeRef {
        if isArray {
            // de-pin: resolve the per-instance `%gs` via the full `Array[E]` ref when present.
            if c.isGenericInst(ref: ty) {
                return self.llvmTypeOfRef(c: inout c, ref: ty)
            }
            return self.arrayTy
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Promise") {
            return self.ptrty
        }
        if c.isGenericInst(ref: ty) {
            return self.llvmTypeOfRef(c: inout c, ref: ty)
        }
        if c.isStrongRefInst(ref: ty) || c.isWeakRefLikeInst(ref: ty) {
            return self.ptrty
        }
        return self.llvmScalarTy(c: inout c, tyStart: tyStart, tyLen: tyLen)
    }

    // One async param's frame-field type (Promise -> ptr; otherwise the param's
    // normal LLVM type, array-aware).
    inout fn asyncParamTy(c: inout Comp, p: Param) -> LLVMTypeRef {
        return self.asyncFieldTy(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen, ty: p.ty, isArray: p.tyIsArray)
    }

    // Append the LLVM types of an async body's hoisted locals (each `let` binding and
    // each enum-match payload bind) to `tys`, in the SAME DFS order the resume codegen
    // hands out frame fields — so field index N in the pre-pass is the N-th
    // `asyncFrameSlot` the body pass consumes. Recurses into if/while/match.
    inout fn collectAsyncFieldTys(c: inout Comp, blockId: U64, tys: inout Array[LLVMTypeRef]) {
        val b: Block = c.arena.blocks[blockId]
        val stmts: Array[U64] = b.stmts
        mut val i: U64 = 0
        while i < stmts.count() {
            match c.arena.stmts[stmts[i]] {
                Stmt.Let(mutable: _, nameStart: _, nameLen: _, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                    // an `await`-initialized binding holds the type-erased value coerced
                    // to its declared type; a normal binding holds its declared/inferred
                    // type. Both keep the annotation's LLVM type as the field.
                    tys.append(self.asyncFieldTy(c: inout c, tyStart: tyStart, tyLen: tyLen, ty: ty, isArray: tyIsArray))
                }
                Stmt.If(cond: _, val thenBlk, val elseBlk, val hasElse) => {
                    self.collectAsyncFieldTys(c: inout c, blockId: thenBlk, tys: inout tys)
                    if hasElse {
                        self.collectAsyncFieldTys(c: inout c, blockId: elseBlk, tys: inout tys)
                    }
                }
                Stmt.While(cond: _, val body) => {
                    self.collectAsyncFieldTys(c: inout c, blockId: body, tys: inout tys)
                }
                Stmt.Match(scrut: _, val arms) => {
                    mut val ai: U64 = 0
                    while ai < arms.count() {
                        val a: MatchArm = arms[ai]
                        if !(a.isWildcard) {
                            if !(a.isStruct) {
                                self.collectAsyncMatchBindTys(c: inout c, arm: a, tys: inout tys)
                            }
                        }
                        self.collectAsyncFieldTys(c: inout c, blockId: a.body, tys: inout tys)
                        ai += 1
                    }
                }
                _ => {}
            }
            i += 1
        }
    }

    // Append one enum-match arm's payload-bind frame-field types (mirrors
    // bindMatchPayload's per-field type recovery: array -> {ptr,i64}, boxed -> ptr,
    // else the field's scalar type), in bind order.
    inout fn collectAsyncMatchBindTys(c: inout Comp, arm: MatchArm, tys: inout Array[LLVMTypeRef]) {
        val eid: U64 = c.enumIdxByName(start: arm.enumStart, len: arm.enumLen)
        if eid >= c.arena.enums.count() {
            return
        }
        val vi: U64 = c.variantIndex(enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
        val fs: Array[FieldDef] = c.arena.enums[eid].variants[vi].fields
        val binds: Array[Bind] = arm.binds
        mut val bi: U64 = 0
        while bi < binds.count() {
            val b: Bind = binds[bi]
            mut val fidx: U64 = fs.count()
            mut val fj: U64 = 0
            while fj < fs.count() {
                if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                    fidx = fj
                    fj = fs.count()
                } else {
                    fj += 1
                }
            }
            mut val pty: LLVMTypeRef = self.i64ty
            if fidx < fs.count() {
                val fd: FieldDef = fs[fidx]
                if arrayFieldElemRef(c: inout c, f: fd) != 0U64 {
                    pty = self.fieldLlvmTy(c: inout c, fd: fd)
                } else {
                    if c.fieldIsBoxed(f: fd) {
                        pty = self.ptrty
                    } else {
                        pty = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                    }
                }
            }
            tys.append(pty)
            bi += 1
        }
    }

    // Build (once) an async fn's named frame struct type `{ i32 state, ptr self,
    // ptr sub, <param fields...>, <hoisted-local fields...> }`.
    inout fn buildAsyncFrameTy(c: inout Comp, fi: U64) -> LLVMTypeRef {
        val f: Func = c.arena.funcs[fi]
        mut val tys: Array[LLVMTypeRef] = []
        tys.append(self.i32ty)
        tys.append(self.ptrty)
        tys.append(self.ptrty)
        mut val pi: U64 = 0
        while pi < f.params.count() {
            tys.append(self.asyncParamTy(c: inout c, p: f.params[pi]))
            pi += 1
        }
        self.collectAsyncFieldTys(c: inout c, blockId: f.body, tys: inout tys)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "__af".bytes())
        appendU64Dec(into: inout nm, n: fi)
        nm.append(0)
        val frameTy: LLVMTypeRef = LLVMStructCreateNamed(self.ctx, arrayCPtr(nm))
        LLVMStructSetBody(frameTy, arrayCPtr(tys), tys.count(), 0I32)
        return frameTy
    }

    // Declare every async fn: build its frame struct type + resume fn, and (for a
    // non-main async fn) its entry symbol in the fnIdx table (signature: params ->
    // PlewPromise*, so a call site `doubler(x: 21)` resolves to a promise-returning
    // call). `main` keeps the C `i32 main()` shape (handled at emit).
    inout fn declareAsyncFns(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.funcs.count() {
            if isAsyncFn(c: inout c, fi: fi) {
                if c.arena.funcs[fi].typeParams.count() > 0U64 {
                    c.errorAt(offset: c.arena.funcs[fi].nameStart, msg: "LLVM backend: generic `async fn` is not yet supported")
                }
                if c.arena.funcs[fi].hasRecv {
                    c.errorAt(offset: c.arena.funcs[fi].nameStart, msg: "LLVM backend: `async fn` methods are not yet supported (only free `async fn`)")
                }
                val frameTy: LLVMTypeRef = self.buildAsyncFrameTy(c: inout c, fi: fi)
                // resume fn: void __af<fi>_resume(void*).
                mut val rptys: Array[LLVMTypeRef] = []
                rptys.append(self.ptrty)
                val resumeTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(rptys), 1U64, 0I32)
                mut val rnm: Array[U8] = []
                appendBytes(into: inout rnm, from: "__af".bytes())
                appendU64Dec(into: inout rnm, n: fi)
                appendBytes(into: inout rnm, from: "_resume".bytes())
                rnm.append(0)
                val resumeFn: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(rnm), resumeTy)
                self.asyncFnIdx.append(fi)
                self.asyncFrameTy.append(frameTy)
                self.asyncResumeFn.append(resumeFn)
                // entry symbol (non-main): params -> ptr (Promise).
                if !(c.nameIsMain(f: c.arena.funcs[fi])) {
                    mut val ptys: Array[LLVMTypeRef] = []
                    mut val pi: U64 = 0
                    while pi < c.arena.funcs[fi].params.count() {
                        ptys.append(self.asyncParamTy(c: inout c, p: c.arena.funcs[fi].params[pi]))
                        pi += 1
                    }
                    val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), ptys.count(), 0I32)
                    mut val enm: Array[U8] = []
                    appendBytes(into: inout enm, from: "pf".bytes())
                    appendU64Dec(into: inout enm, n: fi)
                    enm.append(0)
                    val entryFn: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(enm), fty)
                    self.asyncEntryIdx.append(fi)
                    self.asyncEntryVal.append(entryFn)
                    self.asyncEntryTy.append(fty)
                }
            }
            fi += 1
        }
    }

    // The async-fn registry slot for `fi` (frame type / resume fn), or count if absent.
    inout fn asyncSlotOf(fi: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.asyncFnIdx.count() {
            if self.asyncFnIdx[i] == fi {
                return i
            }
            i += 1
        }
        return self.asyncFnIdx.count()
    }

    // The async-entry-symbol slot for `fi` (its promise-returning entry fn), or
    // asyncEntryIdx.count() if absent (`main` and non-async fns have none).
    inout fn asyncEntrySlot(fi: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.asyncEntryIdx.count() {
            if self.asyncEntryIdx[i] == fi {
                return i
            }
            i += 1
        }
        return self.asyncEntryIdx.count()
    }

    // A pointer to async frame field `idx`: the cached GEP built in the resume entry
    // block (so it dominates every switch-reachable resume block).
    inout fn asyncFrameSlot(c: inout Comp, idx: U64) -> LLVMValueRef {
        return self.asyncSlotPtrs[idx]
    }

    // Emit one `await operand` suspension point (mirrors emitAsyncSuspend): stash the
    // awaited promise in the frame, bump+store the state, and if it is not already
    // resolved register the resume continuation and return; otherwise fall straight
    // through. The resume block is added as a dispatch case so a later resume re-enters
    // here. After this the awaited value is `__f->__sub->value` (asyncSubValue).
    inout fn emitLlvmAsyncSuspend(c: inout Comp, operandId: U64) {
        self.curAsyncState = self.curAsyncState + 1
        val state: U64 = self.curAsyncState
        val subPromise: LLVMValueRef = self.genLlvmExpr(c: inout c, id: operandId)
        LLVMBuildStore(self.b, subPromise, self.asyncFrameSlot(c: inout c, idx: 2U64))
        // drop every live anonymous argument/receiver TEMP before suspending: their
        // borrowers (calls in the just-evaluated await operand's statement) have
        // returned, and a temp's alloca home does not survive a resume (fresh stack
        // frame — any post-resume drop would be a stale frame read). Marked moved so
        // no later drain or exit re-drops them.
        self.dropLiveAnonTemps(c: inout c)
        LLVMBuildStore(self.b, LLVMConstInt(self.i32ty, state, 0I32), self.asyncFrameSlot(c: inout c, idx: 0U64))
        val donePtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.promiseTy, subPromise, 0U64, anon())
        val done: LLVMValueRef = LLVMBuildLoad2(self.b, self.i32ty, donePtr, anon())
        val doneNz: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), done, LLVMConstInt(self.i32ty, 0U64, 0I32), anon())
        val resumeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "async.resume"))
        val suspendBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "async.suspend"))
        LLVMBuildCondBr(self.b, doneNz, resumeBB, suspendBB)
        // suspend: register (resume fn, frame) as the promise's continuation, return.
        LLVMPositionBuilderAtEnd(self.b, suspendBB)
        LLVMBuildStore(self.b, self.curResumeFn, LLVMBuildStructGEP2(self.b, self.promiseTy, subPromise, 2U64, anon()))
        LLVMBuildStore(self.b, self.curFrameBase, LLVMBuildStructGEP2(self.b, self.promiseTy, subPromise, 3U64, anon()))
        LLVMBuildRetVoid(self.b)
        // resume target (also the dispatch case for this state).
        LLVMAddCase(self.curAsyncSwitch, LLVMConstInt(self.i32ty, state, 0I32), resumeBB)
        LLVMPositionBuilderAtEnd(self.b, resumeBB)
        self.terminated = false
    }

    // The just-awaited value: reload `__f->__sub` from the frame (the SSA from before
    // the suspend doesn't dominate the resume block, reached via the dispatch switch),
    // then load its `value` (type-erased i64).
    inout fn asyncSubValue(c: inout Comp) -> LLVMValueRef {
        val sub: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, self.asyncFrameSlot(c: inout c, idx: 2U64), anon())
        val valPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, self.promiseTy, sub, 1U64, anon())
        return LLVMBuildLoad2(self.b, self.i64ty, valPtr, anon())
    }

    // Drop (and mark moved) every live anonymous owned temp (registerArgTemp homes:
    // nameLen 0, owned, not yet moved, above the body mark) — called at each
    // suspension point. The entries stay on the locals stack (no splice); the moved
    // flag keeps any later drain / exit from double-releasing.
    inout fn dropLiveAnonTemps(c: inout Comp) {
        mut val li: U64 = self.curBodyMark
        while li < self.nLocals {
            if self.locLen[li] == 0U64 && self.locOwned[li] && !(self.locMoved[li]) {
                if self.locTypeRef[li] != 0U64 {
                    self.emitDeinitCall(c: inout c, li: li)
                    self.locMoved[li] = true
                }
            }
            li += 1
        }
    }

    // Drop the just-awaited promise when the operand was a TEMPORARY (`await f()`,
    // `await sleep(ms:…)`): the temp's ownership ends once its value is read — mirror
    // of the sync temp protocol, whose alloca home an await cannot use (the frame
    // outlives blocks). A PLACE operand (`await p`) keeps its binding's ownership and
    // may be awaited again. Called AFTER the resume's value read.
    inout fn asyncDropAwaitedTemp(c: inout Comp, operandId: U64) {
        if !(exprAliasesPlace(c: inout c, id: operandId)) {
            val sub: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, self.asyncFrameSlot(c: inout c, idx: 2U64), anon())
            self.rawbufDrop(c: inout c, cell: sub)
        }
    }
}

pub impl LlvmCtx {

    // Lower a `let` whose initializer is `await e` inside an async fn: suspend, then
    // store the (type-erased) awaited value, coerced to the binding's declared type,
    // into its frame field.
    inout fn genLlvmAsyncAwaitLet(c: inout Comp, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, ty: U64, operand: U64) {
        self.emitLlvmAsyncSuspend(c: inout c, operandId: operand)
        mut val v: LLVMValueRef = self.asyncSubValue(c: inout c)
        self.asyncDropAwaitedTemp(c: inout c, operandId: operand)
        val lty: LLVMTypeRef = self.asyncFieldTy(c: inout c, tyStart: tyStart, tyLen: tyLen, ty: ty, isArray: false)
        if tyLen > 0U64 {
            v = self.coerceIntTo(c: inout c, v: v, tyStart: tyStart, tyLen: tyLen)
        }
        val slot: LLVMValueRef = self.asyncFrameSlot(c: inout c, idx: self.asyncFieldNext)
        self.asyncFieldNext = self.asyncFieldNext + 1
        LLVMBuildStore(self.b, v, slot)
        mut val tref: U64 = 0
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Promise") {
            tref = 0U64
        }
        self.pushLocalR(nameStart: nameStart, nameLen: nameLen, ptr: slot, ty: lty, kind: kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen), structIdx: self.localStructIdxFor(c: inout c, start: tyStart, len: tyLen), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: tref)
    }

    // Lower a `return` inside an async fn (mirrors genAsyncReturn): resolve `__self`
    // with the (type-erased) value — a `return await e` first suspends — then free the
    // frame and return from the resume fn.
    inout fn genLlvmAsyncReturn(c: inout Comp, value: U64, hasValue: Bool) {
        mut val rv: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        if hasValue {
            if exprIsAwaitLL(c: inout c, id: value) {
                match c.arena.exprs[value] {
                    Expr.Await(val operand) => {
                        self.emitLlvmAsyncSuspend(c: inout c, operandId: operand)
                        rv = self.asyncSubValue(c: inout c)
                        self.asyncDropAwaitedTemp(c: inout c, operandId: operand)
                    }
                    _ => {}
                }
            } else {
                rv = self.extendToI64(v: self.genLlvmExpr(c: inout c, id: value), unsigned: false)
            }
        }
        self.asyncResolveAndReturn(c: inout c, value: rv)
    }

    // Resolve `__self` with an i64 value, free the frame, and `ret void` from the
    // resume fn. The shared tail of return and fall-through.
    inout fn asyncResolveAndReturn(c: inout Comp, value: LLVMValueRef) {
        // frame teardown: drop every owned frame local in scope (params included — the
        // frame owns them; `value` is already computed and type-erased i64, so dropping
        // first is safe), resolve, release the frame's own promise count, free the frame.
        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: self.nLocals)
        val promiseSelf: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, self.asyncFrameSlot(c: inout c, idx: 1U64), anon())
        mut val rargs: Array[LLVMValueRef] = []
        rargs.append(promiseSelf)
        rargs.append(value)
        mut val rty: Array[LLVMTypeRef] = []
        rty.append(self.ptrty)
        rty.append(self.i64ty)
        val resolveTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(rty), 2U64, 0I32)
        val resolve: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_promise_resolve", nameId: 41U64, fnTy: resolveTy)
        val ignore: LLVMValueRef = LLVMBuildCall2(self.b, resolveTy, resolve, arrayCPtr(rargs), 2U64, anon())
        self.rawbufDrop(c: inout c, cell: promiseSelf)
        self.asyncFreeFrame(c: inout c, frame: self.curFrameBase)
        LLVMBuildRetVoid(self.b)
        self.terminated = true
    }

    inout fn asyncFreeFrame(c: inout Comp, frame: LLVMValueRef) {
        mut val fargs: Array[LLVMValueRef] = []
        fargs.append(frame)
        mut val fty: Array[LLVMTypeRef] = []
        fty.append(self.ptrty)
        val freeTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(fty), 1U64, 0I32)
        val freeFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_frame_free", nameId: 45U64, fnTy: freeTy)
        val ignore: LLVMValueRef = LLVMBuildCall2(self.b, freeTy, freeFn, arrayCPtr(fargs), 1U64, anon())
    }

    inout fn asyncPromiseNew(c: inout Comp) -> LLVMValueRef {
        mut val noargs: Array[LLVMValueRef] = []
        mut val noty: Array[LLVMTypeRef] = []
        val newTy: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(noty), 0U64, 0I32)
        val newFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_promise_new", nameId: 40U64, fnTy: newTy)
        return LLVMBuildCall2(self.b, newTy, newFn, arrayCPtr(noargs), 0U64, anon())
    }

    inout fn asyncFrameAlloc(c: inout Comp, frameTy: LLVMTypeRef) -> LLVMValueRef {
        mut val aargs: Array[LLVMValueRef] = []
        aargs.append(LLVMSizeOf(frameTy))
        mut val aty: Array[LLVMTypeRef] = []
        aty.append(self.i64ty)
        val allocTy: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(aty), 1U64, 0I32)
        val allocFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_frame_alloc", nameId: 44U64, fnTy: allocTy)
        return LLVMBuildCall2(self.b, allocTy, allocFn, arrayCPtr(aargs), 1U64, anon())
    }

    inout fn asyncLoopRun(c: inout Comp) {
        mut val noargs: Array[LLVMValueRef] = []
        mut val noty: Array[LLVMTypeRef] = []
        val loopTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noty), 0U64, 0I32)
        val loopFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_loop_run", nameId: 43U64, fnTy: loopTy)
        val ignore: LLVMValueRef = LLVMBuildCall2(self.b, loopTy, loopFn, arrayCPtr(noargs), 0U64, anon())
    }

    // Bind an async fn's params as resume-fn locals pointing at their frame fields
    // (fields 3 .. 3+nparams-1), so the body reads/writes them through the frame and
    // they survive suspensions. Mirrors bindOneParam's type/kind/enum-ref recovery.
    inout fn bindAsyncParam(c: inout Comp, p: Param, fieldIdx: U64) {
        val slot: LLVMValueRef = self.asyncFrameSlot(c: inout c, idx: fieldIdx)
        mut val pty: LLVMTypeRef = self.asyncParamTy(c: inout c, p: p)
        mut val pElem: LLVMTypeRef = self.i64ty
        mut val pSidx: U64 = self.localStructIdxFor(c: inout c, start: p.tyStart, len: p.tyLen)
        mut val pRef: U64 = 0
        if p.tyIsArray {
            pElem = self.llvmScalarTy(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen)
        } else {
            if c.isGenericInst(ref: p.ty) {
                pRef = p.ty
                val pgs: U64 = self.genStructSlot(c: inout c, ref: p.ty)
                if pgs < self.genStructRefs.count() {
                    pSidx = self.genStructDefs[pgs]
                }
            }
            if pRef == 0U64 {
                // test the DECLARATION (concreteEnumIdxByName), not the registered
                // instances: registration is demand-driven, so an async fn emitted
                // before any construction of the enum would leave the param ref-less
                // (its frame-owned drop then skips the payload's deinit). Mirrors
                // bindOneParam.
                if c.concreteEnumIdxByName(start: p.tyStart, len: p.tyLen) < c.arena.enums.count() {
                    pRef = c.simpleTypeRef(nameStart: p.tyStart, nameLen: p.tyLen)
                }
            }
        }
        self.pushLocalR(nameStart: p.nameStart, nameLen: p.nameLen, ptr: slot, ty: pty, kind: kindFromTySpan(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen), structIdx: pSidx, isArr: p.tyIsArray, elemTy: pElem, elemKind: 0U64, typeRef: pRef)
    }

    // Emit one async fn's entry + resume bodies.
    inout fn genLlvmAsyncFunc(c: inout Comp, fi: U64) {
        val slot: U64 = self.asyncSlotOf(fi: fi)
        if slot >= self.asyncFnIdx.count() {
            return
        }
        val f: Func = c.arena.funcs[fi]
        val frameTy: LLVMTypeRef = self.asyncFrameTy[slot]
        val resumeFn: LLVMValueRef = self.asyncResumeFn[slot]
        val isMain: Bool = c.nameIsMain(f: f)
        // ---- entry function ----
        mut val entryFn: LLVMValueRef = resumeFn
        if isMain {
            mut val noParams: Array[LLVMTypeRef] = []
            val mainTy: LLVMTypeRef = LLVMFunctionType(self.i32ty, arrayCPtr(noParams), 0U64, 0I32)
            entryFn = LLVMAddFunction(self.mod, cstr(s: "main"), mainTy)
        } else {
            entryFn = self.asyncEntryVal[self.asyncEntrySlot(fi: fi)]
        }
        self.curFn = entryFn
        // the standard fn skeleton (entry: br body0) — NOT a bare single block: the
        // param-copy loop below retains heap-carrying params, and a payload enum's
        // retain walker allocates its scratch slot via entryAlloca, which inserts
        // before the entry block's terminator (a bare block has none — null deref).
        self.beginFnBody(fv: entryFn)
        // an `async fn main`: initialize module-level variables (spec/15) before the
        // first resume runs (so an init referencing a global, or main reading one, sees it).
        if isMain {
            self.callInitGlobals(c: inout c)
        }
        val frame: LLVMValueRef = self.asyncFrameAlloc(c: inout c, frameTy: frameTy)
        // __f->__state = 0
        LLVMBuildStore(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32), LLVMBuildStructGEP2(self.b, frameTy, frame, 0U64, anon()))
        // copy params into frame fields 3.. — an ESCAPE: the frame OWNS its copy
        // (spec/14: no borrow crosses the async boundary — the returned Promise can
        // outlive the caller's binding), so retain each heap-carrying param here,
        // balancing the guaranteed (+0) arg pass. The symmetric release runs at frame
        // teardown (asyncResolveAndReturn's dropScope walks every owned frame local,
        // params included).
        mut val pi: U64 = 0
        while pi < f.params.count() {
            val pv: LLVMValueRef = LLVMGetParam(entryFn, pi)
            LLVMBuildStore(self.b, pv, LLVMBuildStructGEP2(self.b, frameTy, frame, 3U64 + pi, anon()))
            if c.arcNeedsRelease(ref: f.params[pi].ty) {
                self.valueArc(c: inout c, v: pv, typeRef: f.params[pi].ty, retain: true)
            }
            pi += 1
        }
        // __self = plew_promise_new(); __f->__self = __self (capture before resume — a
        // synchronously-completing resume frees the frame, so __f->__self would dangle).
        val promiseSelf: LLVMValueRef = self.asyncPromiseNew(c: inout c)
        LLVMBuildStore(self.b, promiseSelf, LLVMBuildStructGEP2(self.b, frameTy, frame, 1U64, anon()))
        if !(isMain) {
            // the to-be-returned Promise VALUE is a second owner, retained BEFORE the
            // resume call: a synchronously-completing resume releases the frame's count
            // in asyncResolveAndReturn, and without the caller's count already held the
            // cell would be freed before this thunk returns it (UAF). Balanced by the
            // caller binding's scope-exit drop or the awaited-temp drop.
            self.rawbufRetain(c: inout c, cell: promiseSelf)
        }
        mut val cargs: Array[LLVMValueRef] = []
        cargs.append(frame)
        mut val cty: Array[LLVMTypeRef] = []
        cty.append(self.ptrty)
        val resumeFnTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(cty), 1U64, 0I32)
        val ignore: LLVMValueRef = LLVMBuildCall2(self.b, resumeFnTy, resumeFn, arrayCPtr(cargs), 1U64, anon())
        if isMain {
            self.asyncLoopRun(c: inout c)
            LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32))
        } else {
            LLVMBuildRet(self.b, promiseSelf)
        }
        // ---- resume function ----
        self.curFn = resumeFn
        self.curIsMain = false
        self.curRetVoid = true
        self.curAsync = true
        self.curFrameTy = frameTy
        self.curFrameBase = LLVMGetParam(resumeFn, 0U64)
        self.curResumeFn = resumeFn
        self.curAsyncState = 0
        val rEntry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, resumeFn, cstr(s: "entry"))
        val startBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, resumeFn, cstr(s: "async.start"))
        LLVMPositionBuilderAtEnd(self.b, rEntry)
        // precompute a GEP for every frame field in the entry block (dominates all
        // resume blocks), so a field read in a switch-reachable block has a dominating
        // pointer. Built before the switch so they dominate the default path too.
        self.asyncSlotPtrs = []
        val nfields: U64 = LLVMCountStructElementTypes(frameTy) as U64
        mut val fidx: U64 = 0
        while fidx < nfields {
            self.asyncSlotPtrs.append(LLVMBuildStructGEP2(self.b, frameTy, self.curFrameBase, fidx, anon()))
            fidx += 1
        }
        val state: LLVMValueRef = LLVMBuildLoad2(self.b, self.i32ty, self.asyncSlotPtrs[0], anon())
        self.curAsyncSwitch = LLVMBuildSwitch(self.b, state, startBB, 8U32)
        LLVMPositionBuilderAtEnd(self.b, startBB)
        self.terminated = false
        // fresh locals: params bound to frame fields 3..; lets/binds get fields after.
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        // The resume function emits the source body, so it consumes the same
        // final-callable descriptor namespace as that source async function.
        // It is not a second semantic body merely because lowering split it
        // into an entry thunk and a resume function.  Leaving the ambient
        // post-finalization key here made every ordinary call in an async body
        // look unrecorded and invited backend-local re-resolution.
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        val savedBodySelf: U64 = c.cur.bodySelfRef
        val savedBodyItem: U64 = c.cur.bodyItemRef
        val noBodyArgs: Array[U64] = []
        c.cur.bodyFnIdx = fi
        c.cur.bodyEnvironment = <InstanceEnvironment />
        c.cur.bodyId = 0U64
        c.cur.bodySelfRef = 0U64
        c.cur.bodyItemRef = 0U64
        // module-level variables (spec/15): seed them as locals (pointing at the true
        // LLVM globals, not frame slots) before async params bind to frame fields.
        self.seedGlobals(c: inout c)
        // the body mark sits between the seeded globals (ambient, never dropped) and the
        // params: unlike a sync fn's borrowed params, async params are FRAME-OWNED (the
        // entry thunk retained them into the frame — a borrow cannot cross the async
        // boundary, spec/14), so scope-exit drops must include them. Block-exit and
        // resolve-time dropScope release every owned frame local through the frame slots.
        self.curBodyMark = self.nLocals
        mut val qi: U64 = 0
        while qi < f.params.count() {
            self.bindAsyncParam(c: inout c, p: f.params[qi], fieldIdx: 3U64 + qi)
            qi += 1
        }
        self.asyncFieldNext = 3U64 + f.params.count()
        self.genLlvmBlock(c: inout c, id: f.body)
        // fall-through end: a value-less async resolves with 0.
        if !(self.terminated) {
            self.asyncResolveAndReturn(c: inout c, value: LLVMConstInt(self.i64ty, 0U64, 0I32))
        }
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyEnvironment = savedBodyEnvironment
        c.cur.bodyId = 0U64
        c.cur.bodySelfRef = savedBodySelf
        c.cur.bodyItemRef = savedBodyItem
        self.curAsync = false
    }

    // Emit entry + resume bodies for every async fn (after declareAsyncFns).
    inout fn emitAsyncFns(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.funcs.count() {
            if isAsyncFn(c: inout c, fi: fi) {
                self.genLlvmAsyncFunc(c: inout c, fi: fi)
            }
            fi += 1
        }
    }
}
