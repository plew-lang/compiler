// Part of the LLVM backend (root: _.pw): async lowering — the stackless state-machine emission (spec/14).

// ---- async lowering (spec/14): stackless state machine ----
//
// Each async function has an entry, a Mid-generated resume body, and a frame.
// The frame holds dispatch state, its result Promise, entry parameters, and the
// locals selected by canonical Mid liveness. Source cleanup is emitted by Mid.
// Promise payloads retain the current scalar i64 runtime representation.
// The runtime provides the ready queue, timers, event loop, and Promise storage.

pub impl LlvmCtx {

    // Async source parameters carry resolved TypeTerms; the shared physical
    // mapper consumes their finalized contracts without span reconstruction.
    inout fn asyncParamTy(c: inout Comp, p: Param) -> LLVMTypeRef {
        return self.llvmTypeOfRef(c: inout c, ref: p.ty)
    }

    // Declare every async fn: build its frame struct type + resume fn, and (for a
    // non-main async fn) its entry symbol in the fnIdx table (signature: params ->
    // PlewPromise*, so a call site `doubler(x: 21)` resolves to a promise-returning
    // call). `main` keeps the C `i32 main()` shape (handled at emit).
    inout fn declareAsyncFns(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.functionCount() {
            if isAsyncFn(c: inout c, fi: fi) {
                if c.arena.functionAt(index: fi).typeParams.count() > 0U64 {
                    c.errorAt(offset: c.arena.functionAt(index: fi).nameStart, msg: "LLVM backend: generic `async fn` is not yet supported")
                }
                if c.arena.functionAt(index: fi).hasRecv {
                    c.errorAt(offset: c.arena.functionAt(index: fi).nameStart, msg: "LLVM backend: `async fn` methods are not yet supported (only free `async fn`)")
                }
                val frameTy: LLVMTypeRef = self.buildMidAsyncFrameTy(c: inout c, fi: fi)
                // resume fn: void __af<fi>_resume(void*).
                mut val rptys: Array[LLVMTypeRef] = []
                rptys.append(self.ptrty)
                val resumeTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(rptys), 1U64, 0I32)
                mut val rnm: Array[U8] = []
                appendBytes(into: inout rnm, from: "__af".bytes())
                appendU64Dec(into: inout rnm, n: fi)
                appendBytes(into: inout rnm, from: "_resume".bytes())
                rnm.append(0)
                val resumeFn: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(rnm), signature: resumeTy)
                self.asyncFnIdx.append(fi)
                self.asyncFrameTy.append(frameTy)
                self.asyncResumeFn.append(resumeFn)
                // entry symbol (non-main): params -> ptr (Promise).
                if !(c.nameIsMain(f: c.arena.functionAt(index: fi))) {
                    val entry: Func = c.arena.functionAt(index: fi)
                    mut val ptys: Array[LLVMTypeRef] = []
                    mut val pi: U64 = 0
                    while pi < entry.params.count() {
                        ptys.append(self.asyncParamTy(c: inout c, p: c.funcParamAt(params: entry.params, index: pi)))
                        pi += 1
                    }
                    val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), ptys.count(), 0I32)
                    mut val enm: Array[U8] = []
                    appendBytes(into: inout enm, from: "pf".bytes())
                    appendU64Dec(into: inout enm, n: fi)
                    enm.append(0)
                    val entryFn: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(enm), signature: fty)
                    self.asyncEntryIdx.append(fi)
                    self.asyncEntryVal.append(entryFn)
                    self.asyncEntryTy.append(fty)
                }
            }
            fi += 1
        }
    }

    // The async-fn registry slot for `fi` (frame type / resume fn), or count if absent.
    inout fn asyncSlotOf(fi: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.asyncFnIdx.count() {
            if self.asyncFnIdx[i] == fi {
                return i
            }
            i += 1
        }
        return self.asyncFnIdx.count()
    }

    // The async-entry-symbol slot for `fi` (its promise-returning entry fn), or
    // asyncEntryIdx.count() if absent (`main` and non-async fns have none).
    inout fn asyncEntrySlot(fi: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.asyncEntryIdx.count() {
            if self.asyncEntryIdx[i] == fi {
                return i
            }
            i += 1
        }
        return self.asyncEntryIdx.count()
    }

    inout fn asyncFreeFrame(c: inout Comp, frame: LLVMValueRef) {
        mut val fargs: Array[LLVMValueRef] = []
        fargs.append(frame)
        mut val fty: Array[LLVMTypeRef] = []
        fty.append(self.ptrty)
        val freeTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(fty), 1U64, 0I32)
        val freeFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_frame_free", fnTy: freeTy)
        val ignore: LLVMValueRef = LLVMBuildCall2(self.b, freeTy, freeFn, arrayCPtr(fargs), 1U64, anon())
    }

    inout fn asyncPromiseNew(c: inout Comp) -> LLVMValueRef {
        mut val noargs: Array[LLVMValueRef] = []
        mut val noty: Array[LLVMTypeRef] = []
        val newTy: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(noty), 0U64, 0I32)
        val newFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_promise_new", fnTy: newTy)
        return LLVMBuildCall2(self.b, newTy, newFn, arrayCPtr(noargs), 0U64, anon())
    }

    inout fn asyncFrameAlloc(c: inout Comp, frameTy: LLVMTypeRef) -> LLVMValueRef {
        mut val aargs: Array[LLVMValueRef] = []
        aargs.append(LLVMSizeOf(frameTy))
        mut val aty: Array[LLVMTypeRef] = []
        aty.append(self.i64ty)
        val allocTy: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(aty), 1U64, 0I32)
        val allocFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_frame_alloc", fnTy: allocTy)
        return LLVMBuildCall2(self.b, allocTy, allocFn, arrayCPtr(aargs), 1U64, anon())
    }

    inout fn asyncLoopRun(c: inout Comp) {
        mut val noargs: Array[LLVMValueRef] = []
        mut val noty: Array[LLVMTypeRef] = []
        val loopTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(noty), 0U64, 0I32)
        val loopFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_loop_run", fnTy: loopTy)
        val ignore: LLVMValueRef = LLVMBuildCall2(self.b, loopTy, loopFn, arrayCPtr(noargs), 0U64, anon())
    }

    // Emit one async fn's entry + resume bodies.
    inout fn genLlvmAsyncFunc(c: inout Comp, fi: U64) {
        val slot: U64 = self.asyncSlotOf(fi: fi)
        if slot >= self.asyncFnIdx.count() {
            return
        }
        val f: Func = c.arena.functionAt(index: fi)
        val frameTy: LLVMTypeRef = self.asyncFrameTy[slot]
        val resumeFn: LLVMValueRef = self.asyncResumeFn[slot]
        val isMain: Bool = c.nameIsMain(f: f)
        // ---- entry function ----
        mut val entryFn: LLVMValueRef = resumeFn
        if isMain {
            mut val noParams: Array[LLVMTypeRef] = []
            val mainTy: LLVMTypeRef = LLVMFunctionType(self.i32ty, arrayCPtr(noParams), 0U64, 0I32)
            entryFn = LLVMAddFunction(self.mod, cstr(s: "main"), mainTy)
        } else {
            entryFn = self.asyncEntryVal[self.asyncEntrySlot(fi: fi)]
        }
        self.curFn = entryFn
        // the standard fn skeleton (entry: br body0) — NOT a bare single block: the
        // param-copy loop below retains heap-carrying params, and a payload enum's
        // retain walker allocates its scratch slot via entryAlloca, which inserts
        // before the entry block's terminator (a bare block has none — null deref).
        self.beginFnBody(fv: entryFn)
        // an `async fn main`: initialize module-level variables (spec/15) before the
        // first resume runs (so an init referencing a global, or main reading one, sees it).
        if isMain {
            self.callInitGlobals(c: inout c)
        }
        val frame: LLVMValueRef = self.asyncFrameAlloc(c: inout c, frameTy: frameTy)
        // __f->__state = 0
        llvmStore(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32), LLVMBuildStructGEP2(self.b, frameTy, frame, 0U64, anon()))
        // Frame storage owns the entry arguments. Copy borrowed ABI values here;
        // moved arguments transfer their existing ownership. The prepared Mid
        // body supplies the matching parameter Drops on every normal exit.
        mut val pi: U64 = 0
        while pi < f.params.count() {
            val pv: LLVMValueRef = self.valueParameter(function: entryFn, index: pi)
            llvmStore(self.b, pv, LLVMBuildStructGEP2(self.b, frameTy, frame, self.asyncLocalSlots[slot][pi], anon()))
            val param: Param = c.funcParamAt(params: f.params, index: pi)
            if !param.isMove { self.valueArc(c: inout c, v: pv, typeRef: param.ty, retain: true) }
            pi += 1
        }
        // __self = plew_promise_new(); __f->__self = __self (capture before resume — a
        // synchronously-completing resume frees the frame, so __f->__self would dangle).
        val promiseSelf: LLVMValueRef = self.asyncPromiseNew(c: inout c)
        llvmStore(self.b, promiseSelf, LLVMBuildStructGEP2(self.b, frameTy, frame, 1U64, anon()))
        if !(isMain) {
            // the to-be-returned Promise VALUE is a second owner, retained BEFORE the
            // resume call: a synchronously-completing resume releases the frame's count
            // in midAsyncComplete, and without the caller's count already held the
            // cell would be freed before this thunk returns it (UAF). Balanced by the
            // caller binding's scope-exit drop or the awaited-temp drop.
            self.rawbufRetain(c: inout c, cell: promiseSelf)
        }
        mut val cargs: Array[LLVMValueRef] = []
        cargs.append(frame)
        mut val cty: Array[LLVMTypeRef] = []
        cty.append(self.ptrty)
        val resumeFnTy: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(cty), 1U64, 0I32)
        val ignore: LLVMValueRef = self.callValueFunction(signature: resumeFnTy, function: resumeFn, arguments: cargs)
        if isMain {
            self.asyncLoopRun(c: inout c)
            LLVMBuildRet(self.b, LLVMConstInt(self.i32ty, 0U64, 0I32))
        } else {
            LLVMBuildRet(self.b, promiseSelf)
        }
        self.genLlvmMidAsyncResume(c: inout c, slot: slot)
    }

    // Emit entry + resume bodies for every async fn (after declareAsyncFns).
    inout fn emitAsyncFns(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.functionCount() {
            if isAsyncFn(c: inout c, fi: fi) {
                self.genLlvmAsyncFunc(c: inout c, fi: fi)
            }
            fi += 1
        }
    }
}
