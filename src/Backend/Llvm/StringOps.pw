// Part of the LLVM backend (root: _.pw): cached runtime-fn declarations and string literal / equality emission.

// ---- runtime-function declarations (cached) ----
//
// Look up a previously declared runtime/intrinsic function by name id, or declare
// it (a body-less prototype resolved at link time against the emitted runtime.c).

pub impl LlvmCtx {
    inout fn getOrDeclare(c: inout Comp, name: String, nameId: U64, fnTy: LLVMTypeRef) -> LLVMValueRef {
        mut val i: U64 = 0
        while i < self.declId.count() {
            if self.declId[i] == nameId {
                return self.declFn[i]
            }
            i += 1
        }
        val f: LLVMValueRef = LLVMAddFunction(self.mod, cstr(s: name), fnTy)
        self.declId.append(nameId)
        self.declFn.append(f)
        self.declTy.append(fnTy)
        return f
    }
}

pub impl LlvmCtx {

    // Build a String value (strty `{i8*, i64}`) from a literal. The bytes live in a
    // rawbuf-SHAPED global `[i64 cap][i64 rc][bytes…]` (the same layout plew_rawbuf_alloc
    // produces) with rc = a huge sentinel, and the String's pointer is at the bytes
    // (offset 16). This unifies String buffers onto rawbuf so `.bytes()` views and the
    // scope-exit drop (plew_rawbuf_drop: dec rc, free at 0) work uniformly — the sentinel
    // rc means a literal is never freed (program-lifetime), and the header is invisible to
    // String ops (which read only {ptr,len}). The global is mutable so rc is writable.
    inout fn genLlvmStr(c: inout Comp, start: U64, len: U64) -> LLVMValueRef {
        mut val bytes: Array[U8] = strDecodeBytes(c: inout c, start: start, len: len)
        val n: U64 = bytes.count() - 1
        val i8ty: LLVMTypeRef = LLVMInt8TypeInContext(self.ctx)
        mut val cvals: Array[LLVMValueRef] = []
        // rawbuf header (3 i64 words, matching plew_rawbuf_alloc): cap = buffer byte count,
        // count = the live string length (n), rc = never-free sentinel. The String VALUE is
        // the data pointer (offset 24); arrValCount reads `count` straight from this header.
        appendU64Le(into: inout cvals, n: bytes.count(), i8ty: i8ty)
        appendU64Le(into: inout cvals, n: n, i8ty: i8ty)
        appendU64Le(into: inout cvals, n: 4611686018427387904U64, i8ty: i8ty)
        mut val j: U64 = 0
        while j < bytes.count() {
            cvals.append(LLVMConstInt(i8ty, bytes[j] as U64, 0I32))
            j += 1
        }
        val m: U64 = 24U64 + bytes.count()
        val arrTy: LLVMTypeRef = LLVMArrayType2(i8ty, m)
        val g: LLVMValueRef = LLVMAddGlobal(self.mod, arrTy, cstr(s: "str"))
        LLVMSetInitializer(g, LLVMConstArray2(i8ty, arrayCPtr(cvals), m))
        LLVMSetGlobalConstant(g, 0I32)
        LLVMSetAlignment(g, 8U32)
        mut val idxs: Array[LLVMValueRef] = []
        idxs.append(LLVMConstInt(self.i64ty, 0U64, 0I32))
        idxs.append(LLVMConstInt(self.i64ty, 24U64, 0I32))
        // the data pointer at offset 24 is the String buffer (count is baked in the header
        // above); wrap it into the `{ptr}` String/Array VALUE aggregate (Array A).
        val data: LLVMValueRef = LLVMBuildGEP2(self.b, arrTy, g, arrayCPtr(idxs), 2U64, anon())
        return self.arrValWrap(c: inout c, data: data, aggTy: self.stringLlvmTy(c: inout c))
    }

    // Decompose a String value to (i8* data, i64 len) and call a 2-arg runtime sink
    // (`plew_write_raw` / `plew_eprint_raw` / `plew_panic_raw`). Passing scalars, not
    // the struct by value, sidesteps the C struct-by-value ABI until it is modeled.
    inout fn emitStrSink(c: inout Comp, rtName: String, rtId: U64, argExpr: U64) -> LLVMValueRef {
        val sv: LLVMValueRef = self.genBorrowedArg(c: inout c, argExpr: argExpr)
        val ptr: LLVMValueRef = self.arrValData(c: inout c, arr: sv)
        val len: LLVMValueRef = self.arrValCount(c: inout c, arr: sv)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: rtName, nameId: rtId, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(ptr)
        av.append(len)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
    }

    // A path-taking runtime intrinsic (`readFile`/`readFileBytes`/`fileExists`): the
    // path is a {ptr,i64} value (String or Array[U8], same layout) passed as two args;
    // returns `retTy` (strty for the file readers, i64 for fileExists).
    inout fn emitPathStrIntrinsic(c: inout Comp, rtName: String, rtId: U64, retTy: LLVMTypeRef, pathExpr: U64) -> LLVMValueRef {
        val pv: LLVMValueRef = self.genBorrowedArg(c: inout c, argExpr: pathExpr)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(retTy, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: rtName, nameId: rtId, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(self.arrValData(c: inout c, arr: pv))
        av.append(self.arrValCount(c: inout c, arr: pv))
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
    }

    // Call a 1-arg i64 runtime sink (`plew_print_i64` / `plew_print_u64` /
    // `plew_print_bool`) with an already-i64 value.
    inout fn emitI64Sink(c: inout Comp, rtName: String, rtId: U64, v: LLVMValueRef) -> LLVMValueRef {
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: rtName, nameId: rtId, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(v)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }

    // Print a value through its `Format` witness: call `<Type>.format("")` (the format
    // spec is unused by the current impls) to get a String, then write its bytes via the
    // string sink. The receiver is passed by value (like any non-`inout` method self) and
    // the empty format spec is a null-data String (release is a no-op). The witness is
    // declared/queued lazily if the upfront pass did not emit it (a lang-item method).
    inout fn emitFormatPrint(c: inout Comp, argExpr: U64, tyStart: U64, tyLen: U64) -> LLVMValueRef {
        val ffi: U64 = c.findMethodByName(typeStart: tyStart, typeLen: tyLen, name: "format")
        if ffi >= c.arena.funcs.count() {
            c.errorAt(offset: c.exprOffset(id: argExpr), msg: "LLVM backend: print of a type that does not conform to Format")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        // a Format witness on a registered struct / enum is the receiver's 0-type-arg `gm`
        // instance (B3-2); a primitive lang-item witness has no type instance and stays on
        // the lazily-declared provided-fn path (pf fallback below).
        mut val gmSlot: U64 = self.genMethK.count()
        mut val gmInst: U64 = 0
        val sReg: U64 = self.structRegSlot(c: inout c, start: tyStart, len: tyLen)
        if sReg < self.genStructRefs.count() {
            gmInst = self.genStructRefs[sReg]
            gmSlot = self.ensureGenMethodDeclared(c: inout c, mfi: ffi, instRef: gmInst, ownArgs: [])
        } else {
            val eReg: U64 = self.enumRegSlot(c: inout c, start: tyStart, len: tyLen)
            if eReg < self.genEnumRefs.count() {
                gmInst = self.genEnumRefs[eReg]
                gmSlot = self.ensureGenMethodDeclared(c: inout c, mfi: ffi, instRef: gmInst, ownArgs: [])
            }
        }
        val recvVal: LLVMValueRef = self.genBorrowedArg(c: inout c, argExpr: argExpr)
        val emptyFmt: LLVMValueRef = self.arrValWrap(c: inout c, data: LLVMConstNull(self.ptrty), aggTy: self.stringLlvmTy(c: inout c))
        mut val cav: Array[LLVMValueRef] = []
        cav.append(recvVal)
        cav.append(emptyFmt)
        if gmSlot < self.genMethK.count() {
            val gval: LLVMValueRef = LLVMBuildCall2(self.b, self.genMethTy[gmSlot], self.genMethVal[gmSlot], arrayCPtr(cav), 2U64, anon())
            return self.emitFormatPrintTail(c: inout c, sval: gval, svalTy: c.arena.funcs[ffi].retTy)
        }
        mut val slot: U64 = self.userFnSlot(idx: ffi)
        if slot >= self.fnIdx.count() {
            slot = self.ensureProvidedDeclared(c: inout c, fi: ffi)
        }
        if slot >= self.fnIdx.count() {
            c.errorAt(offset: c.exprOffset(id: argExpr), msg: "LLVM backend: Format witness not emittable yet")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val sval: LLVMValueRef = LLVMBuildCall2(self.b, self.fnTy[slot], self.fnVal[slot], arrayCPtr(cav), 2U64, anon())
        return self.emitFormatPrintTail(c: inout c, sval: sval, svalTy: c.arena.funcs[ffi].retTy)
    }

    // The shared tail of emitFormatPrint: take the String the Format witness returned and
    // write its bytes through the runtime string sink. The witness String is a fresh
    // TEMPORARY (+1 from format) — give it an anonymous owned home (svalTy = the witness's
    // declared String return ref) so the enclosing block's exit drops it (guaranteed(+0):
    // the sink borrows, nobody else releases).
    inout fn emitFormatPrintTail(c: inout Comp, sval: LLVMValueRef, svalTy: U64) -> LLVMValueRef {
        self.registerArgTemp(c: inout c, v: sval, typeRef: svalTy)
        val ptr: LLVMValueRef = self.arrValData(c: inout c, arr: sval)
        val len: LLVMValueRef = self.arrValCount(c: inout c, arr: sval)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        ptys.append(self.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_print_str", nameId: 5U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(ptr)
        av.append(len)
        return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
    }

    // `print(x)` (spec/02): scalar value-kinds lower to a runtime sink directly; String
    // and any struct route through their `Format` witness (emitFormatPrint). Observably a
    // textual form + newline.
    inout fn emitPrint(c: inout Comp, argExpr: U64) -> LLVMValueRef {
        val k: U64 = self.valueKind(c: inout c, id: argExpr)
        // `String`: print through its `impl String as Format` witness (collections.md
        // §3-付録4). No `isStringStruct` type-name branch — String is recognized as the
        // String value-kind and routed through `Format` like any conforming type; its
        // witness returns the bytes, which the sink writes.
        if k == 1U64 {
            val ss: Bind = c.kwSpan(kw: "String", kwLen: 6U64)
            return self.emitFormatPrint(c: inout c, argExpr: argExpr, tyStart: ss.nameStart, tyLen: ss.nameLen)
        }
        // a (non-String) struct value: route through its own `Format` witness, or reject
        // loudly if the type does not conform (no built-in struct printer).
        val psi: U64 = self.exprStructIdx(c: inout c, id: argExpr)
        if psi < c.arena.structs.count() {
            return self.emitFormatPrint(c: inout c, argExpr: argExpr, tyStart: c.arena.structs[psi].nameStart, tyLen: c.arena.structs[psi].nameLen)
        }
        // scalar value-kinds keep their built-in runtime sinks (observably identical to a
        // Format witness; the floor concern is only the String/Array type-name dispatch).
        if k == 2U64 {
            val bv: LLVMValueRef = LLVMBuildZExt(self.b, self.genLlvmExpr(c: inout c, id: argExpr), self.i64ty, anon())
            return self.emitI64Sink(c: inout c, rtName: "plew_print_bool", rtId: 6U64, v: bv)
        }
        if k == 4U64 {
            // a float: pass the double straight to plew_print_f64.
            val fv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: argExpr)
            mut val ftys: Array[LLVMTypeRef] = []
            ftys.append(self.f64ty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ftys), 1U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_print_f64", nameId: 9130U64, fnTy: fty)
            mut val fav: Array[LLVMValueRef] = []
            fav.append(fv)
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(fav), 1U64, anon())
        }
        val v: LLVMValueRef = self.extendToI64(v: self.genLlvmExpr(c: inout c, id: argExpr), unsigned: k == 3U64)
        if k == 3U64 {
            return self.emitI64Sink(c: inout c, rtName: "plew_print_u64", rtId: 7U64, v: v)
        }
        return self.emitI64Sink(c: inout c, rtName: "plew_print_i64", rtId: 8U64, v: v)
    }

    // The c.arena.enums index of an expression's enum type, or c.arena.enums.count(). A JSX enum
    // construction (`<Kind.LParen />`) carries the enum name directly; otherwise the
    // typed-AST cache supplies a named type (kind 2). (Opaque extern LLVMTypeRefs
    // can't be `==`-compared in Plew, so detection is via the AST, not the value type.)
    inout fn exprEnumIdx(c: inout Comp, id: U64) -> U64 {
        match c.arena.exprs[id] {
            Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, fields: _) => {
                if isEnum {
                    return c.enumIdxByName(start: typeStart, len: typeLen)
                }
            }
            _ => {}
        }
        // an enum local carries a bare enum TypeRef on locTypeRef (typeOf can't see it).
        val tr: U64 = self.exprTypeRef(c: inout c, id: id)
        if tr != 0U64 {
            val tt: TypeRef = c.arena.types[tr]
            val ei: U64 = c.enumIdxByName(start: tt.nameStart, len: tt.nameLen)
            if ei < c.arena.enums.count() {
                return ei
            }
        }
        val t: TypeInfo = c.typeOf(id: id)
        if t.kind == 2 {
            return c.enumIdxByName(start: t.nameStart, len: t.nameLen)
        }
        return c.arena.enums.count()
    }
}
