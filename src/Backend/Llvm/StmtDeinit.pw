// Part of the LLVM backend (root: _.pw): deinit emission, scope drop, and block execution.

// The `deinit` method index of struct `sidx`, or c.arena.funcs.count() if it has none.

pub impl LlvmCtx {

    // value-ARC emit-recursion guard (breaks self-referential types like `struct S {
    // items: Array[S] }` at codegen): push on entry to a struct's release/retain emission,
    // pop on exit; a struct already on the stack is skipped (its deeper level leaks).
    inout fn arcPush(sidx: U64) {
        if self.arcDepth < self.arcStack.count() {
            self.arcStack[self.arcDepth] = sidx
        } else {
            self.arcStack.append(sidx)
        }
        self.arcDepth = self.arcDepth + 1U64
    }
    inout fn arcPop() {
        if self.arcDepth > 0U64 {
            self.arcDepth = self.arcDepth - 1U64
        }
    }
    inout fn arcOnStack(sidx: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.arcDepth {
            if self.arcStack[i] == sidx {
                return true
            }
            i += 1
        }
        return false
    }

    // Whether destroying a value of struct `sidx` runs any deinit — its own, or a
    // field's, recursively (spec/03). Legacy sidx-only entry to the classifier gate
    // (arcNeedsRelease, audit-5 F7): builds the struct's argless def ref, so a generic
    // def's param-typed fields stay unclassified (Scalar) — matching the old exclusion.
    // Instance-precise callers pass their grounded instance ref to arcNeedsRelease.
    inout fn structNeedsDeinit(c: inout Comp, sidx: U64) -> Bool {
        val sd: StructDef = c.arena.structs[sidx]
        return c.arcNeedsRelease(ref: c.findOrAddTypeRef(nameStart: sd.nameStart, nameLen: sd.nameLen))
    }

    // The dropWit* slot for struct `sidx`, or dropWitSidx.count() if none declared yet.
    inout fn dropWitSlot(sidx: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.dropWitSidx.count() {
            if self.dropWitSidx[i] == sidx {
                return i
            }
            i += 1
        }
        return self.dropWitSidx.count()
    }

    // The genStruct* slot for struct `sidx` — its 0-type-arg instance — or
    // genStructRefs.count() if `sidx` is not a registered (non-generic) struct. The 0-arg
    // filter keeps a generic def's sidx (which generic instances also point at) from matching.
    inout fn structSlotForSidx(c: inout Comp, sidx: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genStructRefs.count() {
            if self.genStructDefs[i] == sidx {
                if c.arena.types[self.genStructRefs[i]].args.count() == 0U64 {
                    return i
                }
            }
            i += 1
        }
        return self.genStructRefs.count()
    }

    // Ensure the per-type drop witness `void @pwdrop<sidx>(structVal)` is declared, and
    // return its dropWit* slot. The body is emitted later (emitDropWitnessBodies). Caller
    // must have checked `sidx` is a registered struct.
    inout fn structDropWitness(c: inout Comp, sidx: U64) -> U64 {
        val found: U64 = self.dropWitSlot(sidx: sidx)
        if found < self.dropWitSidx.count() {
            return found
        }
        val reg: U64 = self.structSlotForSidx(c: inout c, sidx: sidx)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.genStructTys[reg])
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwdrop".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.dropWitSidx.append(sidx)
        self.dropWitVal.append(fv)
        self.dropWitTy.append(fty)
        return self.dropWitSidx.count() - 1U64
    }

    // Destroy a struct VALUE `v` of struct `sidx` (spec/03): run its own `deinit` body
    // first, then each field's deinit in declaration order, recursively. Routed through a
    // single per-type witness call (structDropWitness) so the recursive walker is emitted
    // ONCE per type instead of inlined at every drop site (collapsing the IR).
    inout fn emitDeinitValue(c: inout Comp, v: LLVMValueRef, sidx: U64) {
        // registered struct: call its drop witness instead of inlining the walker.
        if self.structSlotForSidx(c: inout c, sidx: sidx) < self.genStructRefs.count() {
            val slot: U64 = self.structDropWitness(c: inout c, sidx: sidx)
            mut val av: Array[LLVMValueRef] = []
            av.append(v)
            LLVMBuildCall2(self.b, self.dropWitTy[slot], self.dropWitVal[slot], arrayCPtr(av), 1U64, anon())
            return
        }
        // unregistered (rare; normally rejected at construction) — walk inline.
        self.emitDropWitnessWalk(c: inout c, v: v, sidx: sidx)
    }

    // The recursive struct-destruction walker — emitted ONCE inside each type's witness
    // body (and used as the inline fallback for an unregistered struct). Sub-struct fields
    // recurse through `emitDeinitValue`, which routes them to their own witness calls.
    inout fn emitDropWitnessWalk(c: inout Comp, v: LLVMValueRef, sidx: U64) {
        // break a self-referential type's codegen recursion (Array[Self] element release).
        if self.arcOnStack(sidx: sidx) {
            return
        }
        self.arcPush(sidx: sidx)
        val sd: StructDef = c.arena.structs[sidx]
        val fi: U64 = structDeinitFi(c: inout c, sidx: sidx)
        if fi < c.arena.funcs.count() {
            // the deinit method is its struct's 0-type-arg `gm` instance (B3-2): declare it on
            // demand and call the symbol directly with the value (no recv expr here).
            val dslot: U64 = self.structSlotForSidx(c: inout c, sidx: sidx)
            if dslot < self.genStructRefs.count() {
                val dinst: U64 = self.genStructRefs[dslot]
                val gslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: fi, instRef: dinst, ownArgs: [])
                if gslot < self.genMethK.count() {
                    mut val av: Array[LLVMValueRef] = []
                    av.append(v)
                    LLVMBuildCall2(self.b, self.genMethTy[gslot], self.genMethVal[gslot], arrayCPtr(av), 1U64, anon())
                }
            }
        }
        mut val i: U64 = 0
        while i < sd.fields.count() {
            val fd: FieldDef = sd.fields[i]
            if c.fieldIsBoxed(f: fd) {
                // a boxed (recursive) field is a shared box pointer — leaked-but-safe
                // until boxed-pointee release lands. Walking it as if it were an inline
                // struct value (the pre-classifier behavior when the name resolved) would
                // mis-interpret the pointer as an aggregate.
            } else if fd.tyIsArray || fieldIsBufferType(c: inout c, f: fd) {
                // release the field's rc-managed array/Buffer buffer (its elements cascade
                // when they own heap; scalar elements just free the buffer at rc 0). Sound
                // because every site that places a struct value deep-copies / CoW-shares its
                // heap (genFieldValue / genLlvmMakeEnum / copyValueIfPlace), so a struct's
                // array/Buffer fields are independently owned. Array and Buffer fields are
                // rep-identical (single rawbuf pointer) so they share emitReleaseArrayValue.
                val fv: LLVMValueRef = LLVMBuildExtractValue(self.b, v, i, anon())
                val er: U64 = arrayOrBufferFieldElemRef(c: inout c, f: fd)
                mut val ety: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
                if er != 0U64 {
                    ety = self.llvmTypeOfRef(c: inout c, ref: er)
                }
                self.emitReleaseArrayValue(c: inout c, data: self.arrValData(c: inout c, arr: fv), count: self.arrValCount(c: inout c, arr: fv), elemTy: ety, elemRef: er)
            } else {
                // every other class routes through the classifier + valueArc (the single
                // class->action table): Ref/WeakRef cells, String, sub-struct (GROUNDED —
                // the old structIndexByName here missed bare-T / generic-inst fields, so
                // their heap was retained by the retain twin but never dropped), and enums.
                val g: U64 = c.arcFieldTy(f: fd)
                match c.arcClassOfRef(ref: g) {
                    ArcClass.Scalar => {}
                    ArcClass.StructVal(sidx: _) => {
                        // instance-aware gate: `g` carries the grounded type args, so a
                        // generic-instance field (Box[Ref[Cell]]) gates on ITS payload.
                        if c.arcNeedsRelease(ref: g) {
                            self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, v, i, anon()), typeRef: g, retain: false)
                        }
                    }
                    _ => {
                        self.valueArc(c: inout c, v: LLVMBuildExtractValue(self.b, v, i, anon()), typeRef: g, retain: false)
                    }
                }
            }
            i += 1
        }
        self.arcPop()
    }

    // Emit the body of every declared drop witness `void @pwdrop<sidx>(structVal)`: the
    // recursive destruction walker over its single struct-value parameter. Drained by a
    // growing cursor — a walk may declare further sub-struct witnesses (appended to the
    // tables), which this same loop then picks up. Called once after the main emit pass.
    inout fn emitDropWitnessBodies(c: inout Comp) {
        while self.dropWitDone < self.dropWitSidx.count() {
            val s: U64 = self.dropWitDone
            val sidx: U64 = self.dropWitSidx[s]
            val fv: LLVMValueRef = self.dropWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            self.emitDropWitnessWalk(c: inout c, v: LLVMGetParam(fv, 0U64), sidx: sidx)
            LLVMBuildRetVoid(self.b)
            self.dropWitDone += 1
        }
    }

    // Whether any witness table has an undrained body pending (count past its cursor).
    inout fn witnessPending() -> Bool {
        if self.dropWitDone < self.dropWitSidx.count() { return true }
        if self.retWitDone < self.retWitSidx.count() { return true }
        if self.copyWitDone < self.copyWitSidx.count() { return true }
        if self.enumRelWitDone < self.enumRelWitEid.count() { return true }
        if self.enumRetWitDone < self.enumRetWitEid.count() { return true }
        if self.enumCopyWitDone < self.enumCopyWitEid.count() { return true }
        return false
    }

    // Drain all 6 witness body tables to a fixpoint. The graphs cross struct<->enum within a
    // family (a struct-drop body can declare an enum-release witness and vice versa), so one
    // pass over each table is not enough: loop until no table grows. Each drain resumes from
    // its persistent cursor, so a re-entry never re-emits an already-emitted body. Families
    // (drop/release, retain, copy) don't cross each other, but a single fixpoint covers all.
    inout fn emitWitnessBodies(c: inout Comp) {
        mut val draining: Bool = true
        while draining {
            self.emitDropWitnessBodies(c: inout c)
            self.emitRetainWitnessBodies(c: inout c)
            self.emitCopyWitnessBodies(c: inout c)
            self.emitEnumReleaseWitnessBodies(c: inout c)
            self.emitEnumRetainWitnessBodies(c: inout c)
            self.emitEnumCopyWitnessBodies(c: inout c)
            draining = self.witnessPending()
        }
    }

    // Run scope-exit destruction of local `li` (spec/03) if it is an owned, not-moved
    // unique struct local whose type needs a deinit (own or a field's). The struct
    // value is loaded and destroyed recursively.
    inout fn emitDeinitCall(c: inout Comp, li: U64) {
        // skip a borrow/inout param (not owned here) or a value already moved out.
        if !(self.locOwned[li]) {
            return
        }
        if self.locMoved[li] {
            return
        }
        // an owned array BODY local (CoW): release its OWN buffer, free at 0. Gated on
        // `li >= curBodyMark` so params / seeded globals / closure captures (bound before
        // the mark) are NOT released here — they are borrows of an owner elsewhere
        // (Swift-guaranteed +0 arg convention: the caller's binding or temp home owns). All
        // element types: only the rc-tracked outer buffer is freed (element heap is
        // shallow-shared and leaks; never double-freed since it is never freed here).
        if self.locIsArr[li] {
            if li >= self.curBodyMark {
                val arr: LLVMValueRef = LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon())
                val data: LLVMValueRef = self.arrValData(c: inout c, arr: arr)
                // an element type that owns heap (a nested array): release its buffer rc and,
                // at 0, release each element's heap (recursively) before freeing — instead of
                // just dropping the outer (which would leak the elements).
                if c.arcNeedsRelease(ref: self.locElemTypeRef[li]) {
                    self.emitReleaseArrayValue(c: inout c, data: data, count: self.arrValCount(c: inout c, arr: arr), elemTy: self.locElemTy[li], elemRef: self.locElemTypeRef[li])
                } else {
                    self.rawbufDrop(c: inout c, cell: data)
                }
            }
            return
        }
        // an owned `Buffer[T]` BODY local: drop its single data pointer (dec rc, free at
        // 0). Gated on `li >= curBodyMark` (params / globals / captures are borrows). An
        // element type that owns heap (String / nested Buffer / array-field struct) gets
        // the same rc-aware element cascade as arrays (release [0,count) then free) via
        // emitReleaseArrayValue — the Buffer value is the data pointer, identical to an
        // array value, and the element ref comes from the `Buffer[T]` type argument.
        if self.locTypeRef[li] != 0U64 {
            if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[self.locTypeRef[li]].nameStart, len: c.arena.types[self.locTypeRef[li]].nameLen, kw: "Buffer") {
                if li >= self.curBodyMark {
                    val bdata: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, self.locPtr[li], anon())
                    mut val ber: U64 = 0
                    if c.arena.types[self.locTypeRef[li]].args.count() > 0U64 {
                        ber = c.arena.types[self.locTypeRef[li]].args[0]
                    }
                    if c.arcNeedsRelease(ref: ber) {
                        self.emitReleaseArrayValue(c: inout c, data: bdata, count: self.rawbufCount(c: inout c, data: bdata), elemTy: self.llvmTypeOfRef(c: inout c, ref: ber), elemRef: ber)
                    } else {
                        self.rawbufDrop(c: inout c, cell: bdata)
                    }
                }
                return
            }
        }
        // a `Ref[T]` local: release one strong owner — decrement the cell's strong rc, and at
        // 0 run the pointee deinit (if its type needs one) then free the cell (spec/03: the
        // pointee deinit runs when the LAST owner drops). Covers EVERY Ref local (whether or
        // not the pointee needs a deinit — the cell heap must be freed regardless), balancing
        // the rawbufRetain consumeIntoOwned emits at each Ref place-copy (escape).
        if c.isRefInst(ref: self.locTypeRef[li]) {
            // gated on `li >= curBodyMark` like arrays/structs/enums: a param / capture /
            // seeded global is a BORROW (the owner lives in the caller / enclosing scope),
            // and a by-value Ref arg is passed without a retain (genArgValue), so releasing
            // it here would under-count the strong rc and free a cell the caller still owns.
            if li >= self.curBodyMark {
                self.emitRefRelease(c: inout c, cell: LLVMBuildLoad2(self.b, self.ptrty, self.locPtr[li], anon()), refTy: self.locTypeRef[li])
            }
            return
        }
        // a `WeakRef[T]` local: drop one weak observer — decrement the weak count and free the
        // cell only when BOTH counters are 0 (the pointee deinit already ran at strong 0). Same
        // curBodyMark borrow gate as Ref. Balances the weak retain at each WeakRef place-copy.
        if c.isWeakRefInst(ref: self.locTypeRef[li]) {
            if li >= self.curBodyMark {
                self.weakRelease(c: inout c, cell: LLVMBuildLoad2(self.b, self.ptrty, self.locPtr[li], anon()))
            }
            return
        }
        val sidx: U64 = self.locStructIdx[li]
        if sidx >= c.arena.structs.count() {
            // an owned BODY local with no struct index: an enum local, or an anonymous
            // argument TEMPORARY (registerArgTemp — any class). Route through the
            // classifier when the grounded ref is stored; the legacy enum path covers a
            // ref-less enum local. Gated on li >= curBodyMark (params / globals /
            // captures are borrows).
            if li >= self.curBodyMark {
                val ev: LLVMValueRef = LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon())
                if self.locTypeRef[li] != 0U64 {
                    if c.arcNeedsRelease(ref: self.locTypeRef[li]) {
                        self.valueArc(c: inout c, v: ev, typeRef: self.locTypeRef[li], retain: false)
                    }
                } else {
                    self.emitEnumReleaseRef(c: inout c, v: ev, ref: self.locTypeRef[li])
                }
            }
            return
        }
        // instance-precise gate + route when the local carries its grounded type ref:
        // a generic-instance local's locStructIdx is the generic DEF, so the sidx-keyed
        // gate below excluded it and its payload heap (Box[Ref[Cell]]) was never
        // dropped. valueArc's StructVal arm sets the instance env itself (setStructEnv),
        // so the walk grounds `v: T` to its concrete class.
        val ltr: U64 = self.locTypeRef[li]
        if ltr != 0U64 {
            if !(c.arcNeedsRelease(ref: ltr)) {
                return
            }
            val sv: LLVMValueRef = LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon())
            self.valueArc(c: inout c, v: sv, typeRef: ltr, retain: false)
            return
        }
        if !(self.structNeedsDeinit(c: inout c, sidx: sidx)) {
            return
        }
        val selfVal: LLVMValueRef = LLVMBuildLoad2(self.b, self.locTy[li], self.locPtr[li], anon())
        self.emitDeinitValue(c: inout c, v: selfVal, sidx: sidx)
    }

    // Drop (deinit) the live locals in [fromMark, nLocals) in REVERSE declaration order
    // — spec/03's deterministic scope-exit destruction. `excludeLi` (or a large
    // sentinel) is skipped, so a unique value being moved out (e.g. returned) is not
    // also dropped here. Only deinit-bearing locals emit a call.
    inout fn dropScope(c: inout Comp, fromMark: U64, excludeLi: U64) {
        mut val i: U64 = self.nLocals
        while i > fromMark {
            i -= 1U64
            if i != excludeLi {
                self.emitDeinitCall(c: inout c, li: i)
            }
        }
    }

    // Scope unwind for a `break`/`continue`: release the live body locals of the current
    // (innermost) loop iteration — [loop-body mark, nLocals) — before the branch. The mark
    // is read from the loop frame (recorded at pushLoop = body entry), so this drops EXACTLY
    // the set the body's fall-through would (loop variable / iterator state sit below the
    // mark and are NOT touched here — they are managed by the loop itself, consistent with
    // normal iteration end). Centralizing on the frame mark is why no exit can pick a wrong
    // mark or forget the drop. Does not change nLocals (the caller branches out; terminated
    // makes the enclosing block/loop reset the stack without a second drop).
    inout fn emitLoopExitDrops(c: inout Comp) {
        if self.loopDepth > 0U64 {
            self.dropScope(c: inout c, fromMark: self.loopUnwindMark[self.loopDepth - 1U64], excludeLi: 18446744073709551615U64)
        }
    }

    inout fn genLlvmBlock(c: inout Comp, id: U64) {
        // lexical scope: bindings declared in this block leave scope at its end.
        val mark: U64 = self.nLocals
        val blk: Block = c.arena.blocks[id]
        mut val i: U64 = 0
        while i < blk.stmts.count() {
            if self.terminated {
                self.nLocals = mark
                return
            }
            self.genLlvmStmt(c: inout c, id: blk.stmts[i])
            i += 1
        }
        // fall-through exit: run scope-exit deinits for this block's locals (a return
        // inside already dropped all live locals and set terminated).
        if !(self.terminated) {
            self.dropScope(c: inout c, fromMark: mark, excludeLi: 18446744073709551615U64)
        }
        self.nLocals = mark
    }
}
