// Part of the LLVM backend (root: _.pw): deinit emission, scope drop, and block execution.

// The `deinit` method index of struct `sidx`, or c.arena.functionCount() if it has none.

pub impl LlvmCtx {

    // value-ARC emit-recursion guard (breaks self-referential types like `struct S {
    // items: Array[S] }` at codegen): push on entry to a struct's release/retain emission,
    // pop on exit; a struct already on the stack is skipped — only the INLINE walk stops
    // there (runtime recursion goes through the type's witness CALL, see dropWitSlot).
    inout fn arcPush(sidx: U64) {
        if self.arcDepth < self.arcStack.count() {
            self.arcStack[self.arcDepth] = sidx
        } else {
            self.arcStack.append(sidx)
        }
        self.arcDepth = self.arcDepth + 1U64
    }
    inout fn arcPop() {
        if self.arcDepth > 0U64 {
            self.arcDepth = self.arcDepth - 1U64
        }
    }
    inout fn arcOnStack(sidx: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.arcDepth {
            if self.arcStack[i] == sidx {
                return true
            }
            i += 1
        }
        return false
    }

    // The dropWit* slot for genStruct* instance slot `reg`, or dropWitReg.count() if
    // none declared yet. The drop-witness table is keyed by the INSTANCE slot (not the
    // struct def sidx): a generic instance gets its own witness whose body is emitted
    // under ITS substitution env, so every struct drop — concrete or generic instance —
    // is a function CALL. That makes runtime recursion expressible: a boxed (recursive)
    // field's cell release destroys its pointee by calling the same witness, which an
    // inline walker (guarded by arcOnStack) could never encode.
    inout fn dropWitSlot(reg: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.dropWitReg.count() {
            if self.dropWitReg[i] == reg {
                return i
            }
            i += 1
        }
        return self.dropWitReg.count()
    }

    // Ensure the per-instance drop witness `void @pwdrop<reg>(structVal)` is declared,
    // and return its dropWit* slot. The body is emitted later (emitDropWitnessBodies).
    // `reg` is a genStruct* slot (caller resolved it).
    inout fn structDropWitness(c: inout Comp, reg: U64) -> U64 {
        val found: U64 = self.dropWitSlot(reg: reg)
        if found < self.dropWitReg.count() {
            return found
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.genStructTys[reg])
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pwdrop".bytes())
        appendU64Dec(into: inout nm, n: reg)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        self.dropWitReg.append(reg)
        self.dropWitVal.append(fv)
        self.dropWitTy.append(fty)
        return self.dropWitReg.count() - 1U64
    }

    // Destroy a struct VALUE `v` of struct `sidx` (spec/03): run its own `deinit` body
    // first, then each field's deinit in declaration order, recursively. Routed through a
    // single per-type witness call (structDropWitness) so the recursive walker is emitted
    // ONCE per type instead of inlined at every drop site (collapsing the IR).
    inout fn emitDeinitValue(c: inout Comp, v: LLVMValueRef, sidx: U64, ref: U64) {
        // registered struct / grounded generic instance: call its drop witness instead
        // of inlining the walker. A grounded instance ref routes to ITS per-instance
        // witness; ref 0 (callers with only a sidx) falls back to the 0-type-arg slot.
        mut val reg: U64 = self.genStructRefs.count()
        if ref != 0U64 {
            if c.isGenericInst(ref: ref) {
                reg = self.genStructSlot(c: inout c, ref: ref)
            }
        }
        if reg >= self.genStructRefs.count() {
            reg = self.structSlotForSidx(structIndex: sidx)
        }
        if reg < self.genStructRefs.count() {
            val slot: U64 = self.structDropWitness(c: inout c, reg: reg)
            mut val av: Array[LLVMValueRef] = []
            av.append(v)
            self.callValueFunction(signature: self.dropWitTy[slot], function: self.dropWitVal[slot], arguments: av)
            return
        }
        // unregistered (rare; normally rejected at construction) — walk inline.
        self.emitDropWitnessWalk(c: inout c, v: v, sidx: sidx, typeRef: ref)
    }

    // The recursive struct-destruction walker — emitted ONCE inside each type's witness
    // body (and used as the inline fallback for an unregistered struct). Sub-struct fields
    // recurse through `emitDeinitValue`, which routes them to their own witness calls.
    // A single-field wrapper with no user destructor contributes no action
    // of its own. Consume its frozen contract directly instead of emitting
    // a runtime forwarding call. Boxed recursion remains behind its cell.
    inout fn emitFinalDropValue(c: inout Comp, v: LLVMValueRef, typeRef: U64) {
        val contractId = c.finalDestructionIndex(typeRef: typeRef)
        if contractId != 0U64 {
            val contract = c.arena.finalDestructions[contractId - 1U64]
            if contract.ready && contract.underlying != 0U64 {
                self.emitFinalDropValue(c: inout c, v: v, typeRef: contract.underlying)
                return
            }
            if contract.ready && contract.deinitCall.bodyId == 0U64 && contract.fieldTypes.count() == 1U64 {
                match contract.ownershipClass {
                    ArcClass.StructVal(sidx: val index) => {
                        val declaration = c.arena.structAt(index: index)
                        if declaration.fields.count() == 1U64 && contract.fieldBoxed.count() == 1U64 && !contract.fieldBoxed[0U64] {
                            self.emitFinalDropValue(c: inout c, v: LLVMBuildExtractValue(self.b, v, 0U64, anon()), typeRef: contract.fieldTypes[0U64])
                            return
                        }
                    }
                    _ => {}
                }
            }
        }
        self.valueArc(c: inout c, v: v, typeRef: typeRef, retain: false)
    }

    inout fn emitDropWitnessWalk(c: inout Comp, v: LLVMValueRef, sidx: U64, typeRef: U64) {
        if self.arcOnStack(sidx: sidx) { return }
        val declaration = c.arena.structAt(index: sidx)
        mut val contractId = c.finalDestructionIndex(typeRef: typeRef)
        while contractId != 0U64 && c.arena.finalDestructions[contractId - 1U64].underlying != 0U64 {
            contractId = c.finalDestructionIndex(typeRef: c.arena.finalDestructions[contractId - 1U64].underlying)
        }
        if contractId == 0U64 {
            c.errorAt(offset: declaration.defOffset, msg: "internal error: struct drop has no finalized destruction contract")
            return
        }
        val contract = c.arena.finalDestructions[contractId - 1U64]
        if !contract.ready || contract.fieldTypes.count() != declaration.fields.count() || contract.fieldBoxed.count() != contract.fieldTypes.count() || contract.fieldNeedsRelease.count() != contract.fieldTypes.count() {
            c.errorAt(offset: declaration.defOffset, msg: "internal error: struct drop has an incomplete destruction contract")
            return
        }
        self.arcPush(sidx: sidx)
        if contract.deinitCall.bodyId != 0U64 {
            if !contract.deinitCall.ready {
                c.errorAt(offset: declaration.defOffset, msg: "internal error: destructor call contract is not finalized")
                self.arcPop()
                return
            }
            val slot = self.ensureFinalGenMethodBody(c: inout c, bodyId: contract.deinitCall.bodyId)
            if slot >= self.genMethBody.count() {
                c.errorAt(offset: declaration.defOffset, msg: "internal error: finalized destructor has no executable body")
                self.arcPop()
                return
            }
            val arguments: Array[LLVMValueRef] = [v]
            self.callValueFunction(signature: self.genMethTy[slot], function: self.genMethVal[slot], arguments: arguments)
        }
        mut val field = 0U64
        while field < contract.fieldTypes.count() {
            val type = contract.fieldTypes[field]
            if contract.fieldBoxed[field] {
                self.emitCellRelease(c: inout c, cell: LLVMBuildExtractValue(self.b, v, field, anon()), ref: type)
            } else if contract.fieldNeedsRelease[field] {
                self.emitFinalDropValue(c: inout c, v: LLVMBuildExtractValue(self.b, v, field, anon()), typeRef: type)
            }
            field += 1U64
        }
        self.arcPop()
    }

    // Emit the body of every declared drop witness `void @pwdrop<reg>(structVal)`: the
    // recursive destruction walker over its single struct-value parameter, grounded
    // under the instance's own env (a no-op for a 0-type-arg concrete struct). Drained
    // by a growing cursor — a walk may declare further sub-struct witnesses (appended to
    // the tables), which this same loop then picks up. Called once after the main emit pass.
    inout fn emitDropWitnessBodies(c: inout Comp) {
        while self.dropWitDone < self.dropWitReg.count() {
            val s: U64 = self.dropWitDone
            val reg: U64 = self.dropWitReg[s]
            val fv: LLVMValueRef = self.dropWitVal[s]
            self.curFn = fv
            self.beginFnBody(fv: fv)
            self.emitDropWitnessWalk(c: inout c, v: self.valueParameter(function: fv, index: 0U64), sidx: self.genStructDefs[reg], typeRef: self.genStructRefs[reg])
            LLVMBuildRetVoid(self.b)
            self.dropWitDone += 1
        }
    }

    // Drain all 4 witness body tables to a fixpoint. The graphs cross struct<->enum within a
    // family (a struct-drop body can declare an enum-release witness and vice versa), so one
    // pass over each table is not enough: loop until no table grows. Each drain resumes from
    // its persistent cursor, so a re-entry never re-emits an already-emitted body. Families
    // (drop/release, retain) don't cross each other, but a single fixpoint covers all.
    inout fn emitWitnessBodies(c: inout Comp) {
        // The four cursor/table comparisons are the fixed-point condition itself. Keeping
        // the sole use at the loop header gives one source of truth for entry and re-entry:
        // a pass which declares no further witness bodies ends without an auxiliary flag.
        while self.dropWitDone < self.dropWitReg.count() || self.retWitDone < self.retWitReg.count() || self.enumRelWitDone < self.enumRelWitReg.count() || self.enumRetWitDone < self.enumRetWitEid.count() {
            // These are phase boundaries rather than a per-witness log: the tables may be
            // large, but each boundary identifies the one family whose current cursor made
            // no observable progress.  `--trace-phases` therefore distinguishes a genuinely
            // growing fixed point from a single expensive witness walk without changing the
            // emission order or imposing an arbitrary budget.
            tracePhaseCount(c: inout c, label: "backend:witness:drop-pending", count: self.dropWitReg.count() - self.dropWitDone)
            self.emitDropWitnessBodies(c: inout c)
            tracePhase(c: inout c, label: "backend:witness:drop-done")
            tracePhaseCount(c: inout c, label: "backend:witness:retain-pending", count: self.retWitReg.count() - self.retWitDone)
            self.emitRetainWitnessBodies(c: inout c)
            tracePhase(c: inout c, label: "backend:witness:retain-done")
            tracePhaseCount(c: inout c, label: "backend:witness:enum-release-pending", count: self.enumRelWitReg.count() - self.enumRelWitDone)
            self.emitEnumReleaseWitnessBodies(c: inout c)
            tracePhase(c: inout c, label: "backend:witness:enum-release-done")
            tracePhaseCount(c: inout c, label: "backend:witness:enum-retain-pending", count: self.enumRetWitEid.count() - self.enumRetWitDone)
            self.emitEnumRetainWitnessBodies(c: inout c)
            tracePhase(c: inout c, label: "backend:witness:enum-retain-done")
        }
    }

}
