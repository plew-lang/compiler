// Physical LLVM types and existential value operations.

pub impl LlvmCtx {

    // Layout selection consumes a closed type contract. Type spelling is
    // consulted only for the physical widths of primitive language items.
    inout fn llvmTypeOfRef(c: inout Comp, ref: U64) -> Result[LLVMTypeRef, CompileDiagnostic] {
        if ref == 0U64 { return <Result.Ok value=self.i64ty /> }
        val contract = c.arena.finalDestructions[(try c.checkedFinalDestruction(typeRef: ref)) - 1U64]
        if contract.underlying != 0U64 { return self.llvmTypeOfRef(c: inout c, ref: contract.underlying) }
        if contract.isOpaquePointer { return <Result.Ok value=self.ptrty /> }
        if contract.structLayout != 0U64 {
            val slot = (try self.requireStructLayoutSlot(c: inout c, typeRef: contract.typeRef))
            if slot < self.genStructTys.count() { return <Result.Ok value=self.genStructTys[slot] /> }
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: finalized struct type has no registered LLVM layout") />
        }
        match contract.ownershipClass {
            ArcClass.AnyBox => { return <Result.Ok value=self.anyTy /> }
            ArcClass.ClosureVal => { return <Result.Ok value=self.closureTy /> }
            ArcClass.EnumVal(eidx: _) => {
                val slot = (try self.requireEnumLayoutSlot(c: inout c, typeRef: contract.typeRef))
                if slot < self.genEnumTys.count() { return <Result.Ok value=self.genEnumTys[slot] /> }
                return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: finalized enum type has no registered LLVM layout") />
            }
            _ => {}
        }
        val type = c.arena.typeAt(index: contract.typeRef)
        return self.llvmPrimitiveTy(c: inout c, tyStart: type.nameStart, tyLen: type.nameLen)
    }

    // Sign/zero-extend an integer value to i64 for the runtime boundary (print / exit
    // take i64). No-op if already i64; unsigned -> zext, signed -> sext.
    inout fn extendToI64(v: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
        if LLVMGetIntTypeWidth(LLVMTypeOf(v)) >= 64U32 {
            return v
        }
        if unsigned {
            return LLVMBuildZExt(self.b, v, self.i64ty, anon())
        }
        return LLVMBuildSExt(self.b, v, self.i64ty, anon())
    }

    // Adjust an integer value to a target integer width (trunc / sext / zext), so a
    // value reaching a typed sink (annotated let, call arg, return) matches the
    // expected width — e.g. an i64-defaulted literal `5` stored into an `I32` local.
    inout fn coerceInt(v: LLVMValueRef, target: LLVMTypeRef, unsigned: Bool) -> LLVMValueRef {
        // only integers are width-coerced; arrays/structs/enums/String pass through.
        if LLVMGetTypeKind(LLVMTypeOf(v)) != 8U32 {
            return v
        }
        if LLVMGetTypeKind(target) != 8U32 {
            return v
        }
        val vw: U32 = LLVMGetIntTypeWidth(LLVMTypeOf(v))
        val tw: U32 = LLVMGetIntTypeWidth(target)
        if vw == tw {
            return v
        }
        if vw > tw {
            return LLVMBuildTrunc(self.b, v, target, anon())
        }
        if unsigned {
            return LLVMBuildZExt(self.b, v, target, anon())
        }
        return LLVMBuildSExt(self.b, v, target, anon())
    }

}

pub impl LlvmCtx {

    // Emit a runtime NaN-compare guard (spec/02): panics if either double operand is NaN
    // before an ordered comparison runs (so NaN compares are loud, not silently false).
    inout fn emitF64NanCheck(c: inout Comp, l: LLVMValueRef, r: LLVMValueRef) -> Result[(), CompileDiagnostic] {
        mut val tys: Array[LLVMTypeRef] = []
        tys.append(self.f64ty)
        tys.append(self.f64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(tys), 2U64, 0I32)
        val callee: LLVMValueRef = (try self.getOrDeclare(c: inout c, name: "plew_f64_nan_check", fnTy: fty))
        mut val av: Array[LLVMValueRef] = []
        av.append(l)
        av.append(r)
        LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
        return <Result.Ok value=() />
    }

}
