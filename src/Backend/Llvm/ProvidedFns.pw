// Part of the LLVM backend (root: _.pw): generic-fn instance emission + the `pf` lazy
// declaration of methods that have no `gm` instance (primitive / lang-item receivers).

// Lazily declare a non-generic method `fi` reached at a call site whose receiver has no
// `gm` 0-type-arg instance — i.e. a primitive lang-item (String / a fixed-width integer)
// or other non-user-type receiver, the cases the gm dispatch path falls through to (B3-2).
// Adds its `pf<fi>` symbol with the self-first method signature and queues its body for
// emission (provEmit). Returns the fnIdx slot, or st.fnIdx.count() if it can't be emitted.
// Idempotent (returns the existing slot).

pub impl LlvmCtx {
    inout fn ensureProvidedDeclared(c: inout Comp, fi: U64) -> U64 {
        val existing: U64 = self.userFnSlot(idx: fi)
        if existing < self.fnIdx.count() {
            return existing
        }
        val f: Func = c.arena.funcs[fi]
        if f.typeParams.count() > 0U64 {
            return self.fnIdx.count()
        }
        if !(f.hasRecv) {
            return self.fnIdx.count()
        }
        // a registered struct receiver, or a primitive lang-item (String / a fixed-width
        // integer / a float / Bool) — all have a well-defined self LLVM type. Bool and the
        // floats matter for `(3.5F64).format(…)` / `flag.format(…)`: their `Format` (and other)
        // witnesses dispatch like any prim lang-item now that `print` routes through the real
        // `print` body instead of a backend-special sink (audit-3 P0).
        if self.structRegSlot(c: inout c, start: f.recvStart, len: f.recvLen) >= self.genStructRefs.count() {
            if !(rangeEquals(bytes: c.arena.bytes, start: f.recvStart, len: f.recvLen, kw: "String")) {
                if !(isPrimIntName(c: inout c, start: f.recvStart, len: f.recvLen)) {
                    if !(c.isFloatType(start: f.recvStart, len: f.recvLen)) {
                        if !(rangeEquals(bytes: c.arena.bytes, start: f.recvStart, len: f.recvLen, kw: "Bool")) {
                            return self.fnIdx.count()
                        }
                    }
                }
            }
        }
        // bind `Self`/`Item` to the concrete receiver while computing the signature, so a
        // provided terminal whose return type names `Item` (`first()`/`reduce() ->
        // Optional[Item]`) declares the grounded type (`Optional[I64]`) — matching the body,
        // which genLlvmFuncBody grounds the same way. Without this the declared return is the
        // ungrounded `Optional[Item]` and the call site emits invalid GEP indices.
        val savedPS: U64 = c.cur.selfRef
        val savedPI: U64 = c.cur.itemRef
        c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.selfParamTy(c: inout c, f: f))
        mut val pi: U64 = 0
        while pi < f.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: f.params[pi]))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: f), arrayCPtr(ptys), ptys.count(), 0I32)
        c.cur.selfRef = savedPS
        c.cur.itemRef = savedPI
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pf".bytes())
        appendU64Dec(into: inout nm, n: fi)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.fnIdx.append(fi)
        self.fnVal.append(fv)
        self.fnTy.append(fty)
        self.provEmit.append(fi)
        return self.fnIdx.count() - 1U64
    }

}

pub impl LlvmCtx {

    // Pass 2: emit a plain user function's body.
    // Declare each concrete generic free-function instantiation (c.monoWork.fnInsts) as a
    // symbol `gf<k>` with its signature built under the instance's substitution env.
    inout fn declareGenFns(c: inout Comp) {
        mut val k: U64 = 0
        while k < c.monoWork.fnInsts.count() {
            val fin: FnInst = c.monoWork.fnInsts[k]
            // free-function instances only (recvInstRef == 0); methods are a later step.
            // restrict to the entry module: a std generic fn (print[T] etc.) has a body
            // full of not-yet-supported constructs and shouldn't be emitted (print is
            // special-cased at the call site, so its instance is never called).
            if fin.recvInstRef == 0U64 && c.moduleOf(offset: c.arena.funcs[fin.fnIdx].nameStart) == 0U64 {
                if c.isGenericFreeFn(fi: fin.fnIdx) {
                    val f: Func = c.arena.funcs[fin.fnIdx]
                    val savedP: Array[Bind] = c.cur.typeParams
                    val savedA: Array[U64] = c.cur.typeArgs
                    c.cur.typeParams = f.typeParams
                    c.cur.typeArgs = fin.args
                    mut val ptys: Array[LLVMTypeRef] = []
                    mut val pi: U64 = 0
                    while pi < f.params.count() {
                        ptys.append(self.paramLlvmTy(c: inout c, p: f.params[pi]))
                        pi += 1
                    }
                    val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: f), arrayCPtr(ptys), f.params.count(), 0I32)
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "gf".bytes())
                    appendU64Dec(into: inout nm, n: k)
                    nm.append(0)
                    val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                    self.genFnK.append(k)
                    self.genFnVal.append(fv)
                    self.genFnTy.append(fty)
                    self.genFnEmit.append(self.genFnK.count() - 1U64)
                }
            }
            k += 1
        }
    }

    // Emit one free-function instance body (slot into genFn*) under its substitution env
    // (empty for a non-generic 0-type-arg instance). Shared by the eager emitGenFns pass and
    // the pass-2 genFnEmit drain (a free fn lazily declared via ensureFnInst).
    inout fn emitOneGenFn(c: inout Comp, slot: U64) {
        val fin: FnInst = c.monoWork.fnInsts[self.genFnK[slot]]
        val f: Func = c.arena.funcs[fin.fnIdx]
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        val savedSelf: U64 = c.cur.selfRef
        val savedItem: U64 = c.cur.itemRef
        c.cur.typeParams = f.typeParams
        c.cur.typeArgs = fin.args
        // an `assoc fn` witness (`impl[T] Array[T] as Eq`, `impl Point as Eq`): bind
        // `Self`/`Item` to the receiver so a `Self` param / `-> Self` / a `.field` access in
        // the body grounds to the real type (mirrors emitOneGenMethod). genLlvmFuncBody's
        // `didSelf` only covers `hasRecv` value methods, so an assoc fn needs it set here.
        // A generic receiver uses the operand instance (recvInstRef, carrying the element);
        // a non-generic one (`Point.eq` reached inside `Buffer.eq[Point]`, where the caller
        // couldn't recover the element ref) falls back to the declared receiver head name.
        if f.isAssoc {
            self.curRecvInstRef = fin.recvInstRef
            if fin.recvInstRef != 0U64 {
                c.setSelfItemEnv(recvStart: c.arena.types[fin.recvInstRef].nameStart, recvLen: c.arena.types[fin.recvInstRef].nameLen, recvInstRef: fin.recvInstRef)
            } else {
                c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
            }
        }
        self.genLlvmFuncBody(c: inout c, fi: fin.fnIdx, fv: self.genFnVal[slot])
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
        c.cur.selfRef = savedSelf
        c.cur.itemRef = savedItem
    }


    // Infer a generic free function's type arguments from a call's arguments, mirroring
    // the front-end `inferFnArgs` but reading each argument's type from the parametric
    // store (exprTypeRef), grounded under the current instance env.
    inout fn llvmInferFnArgs(c: inout Comp, f: Func, args: Array[Arg]) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val ti: U64 = 0
        while ti < f.typeParams.count() {
            val tp: Bind = f.typeParams[ti]
            mut val found: U64 = 0
            mut val pi: U64 = 0
            while pi < f.params.count() {
                val p: Param = f.params[pi]
                if p.tyIsArray {
                    if p.tyNameId == tp.nameId {
                        if pi < args.count() {
                            if found == 0U64 {
                                found = self.arrayExprElemRef(c: inout c, arrayExpr: args[pi].expr)
                            }
                        }
                    }
                } else {
                    if pi < args.count() {
                        if found == 0U64 {
                            val argRef: U64 = self.exprTypeRef(c: inout c, id: args[pi].expr)
                            found = c.unifyTypeParam(paramRef: p.ty, argRef: argRef, tpStart: tp.nameStart, tpLen: tp.nameLen)
                        }
                    }
                }
                pi += 1
            }
            out.append(found)
            ti += 1
        }
        return out
    }

    // Fill a generic factory's type params left unfound by argument inference (a no-arg
    // factory like `Head.empty()`) from the expected type. A factory returns `Self =
    // Head[typeParams]`, so when the call's context wants a same-head generic instance
    // (`st.expectedTy = Head[U]`), its type args line up with the params positionally.
    // Only touches unfound (0) slots; an arg-inferred param wins.
    inout fn groundAssocFromExpected(c: inout Comp, recvStart: U64, recvLen: U64, fi: U64, inferred: inout Array[U64]) {
        if self.expectedTy == 0U64 {
            return
        }
        if !(c.isGenericInst(ref: self.expectedTy)) {
            return
        }
        val et: TypeRef = c.arena.types[self.expectedTy]
        if !(spansEqual(c: inout c, aStart: et.nameStart, aLen: et.nameLen, bStart: recvStart, bLen: recvLen)) {
            return
        }
        if et.args.count() != inferred.count() {
            return
        }
        mut val i: U64 = 0
        while i < inferred.count() {
            // unfound (0) OR a width-less recovery (a nameless ref, e.g. an integer field
            // whose width the structural pass couldn't name): the expected type's arg is
            // the authoritative ground for this param, so override.
            mut val needsGround: Bool = inferred[i] == 0U64
            if !(needsGround) {
                if c.arena.types[inferred[i]].nameLen == 0U64 {
                    needsGround = true
                }
            }
            if needsGround {
                inferred[i] = et.args[i]
            }
            i += 1
        }
    }
}
