// Part of the LLVM backend (root: _.pw): generic-fn instance emission + the `pf` lazy
// declaration of methods that have no `gm` instance (primitive / lang-item receivers).

// Lazily declare a non-generic method `fi` reached at a call site whose receiver has no
// `gm` 0-type-arg instance — i.e. a primitive lang-item (String / a fixed-width integer)
// or other non-user-type receiver, the cases the gm dispatch path falls through to (B3-2).
// Adds its `pf<fi>` symbol with the self-first method signature and queues its body for
// emission (provEmit). Returns the fnIdx slot, or st.fnIdx.count() if it can't be emitted.
// Idempotent (returns the existing slot).

pub impl LlvmCtx {
    inout fn ensureProvidedDeclared(c: inout Comp, fi: U64) -> U64 {
        val existing: U64 = self.userFnSlot(idx: fi)
        if existing < self.fnIdx.count() {
            return existing
        }
        val f: Func = c.arena.funcs[fi]
        if f.typeParams.count() > 0U64 {
            return self.fnIdx.count()
        }
        // Associated callables have the generic-function ABI and are keyed by
        // their final receiver subject.  They must never enter this legacy
        // per-Func cache, whose key cannot represent `Self` instantiation.
        if f.isAssoc {
            return self.fnIdx.count()
        }
        if !(f.hasRecv) {
            return self.fnIdx.count()
        }
        // a registered struct receiver, or a primitive lang-item (String / a fixed-width
        // integer / a float / Bool) — all have a well-defined self LLVM type. Bool and the
        // floats matter for `(3.5F64).format(…)` / `flag.format(…)`: their `Format` (and other)
        // witnesses dispatch like any prim lang-item now that `print` routes through the real
        // `print` body instead of a backend-special sink (audit-3 P0).
        if self.structRegSlot(c: inout c, start: f.recvStart, len: f.recvLen) >= self.genStructRefs.count() {
            if !(rangeEquals(bytes: c.arena.bytes, start: f.recvStart, len: f.recvLen, kw: "String")) {
                if !(isPrimIntName(c: inout c, start: f.recvStart, len: f.recvLen)) {
                    if !(c.isFloatType(start: f.recvStart, len: f.recvLen)) {
                        if !(rangeEquals(bytes: c.arena.bytes, start: f.recvStart, len: f.recvLen, kw: "Bool")) {
                            return self.fnIdx.count()
                        }
                    }
                }
            }
        }
        // bind `Self`/`Item` to the concrete receiver while computing the signature, so a
        // provided terminal whose return type names `Item` (`first()`/`reduce() ->
        // Optional[Item]`) declares the grounded type (`Optional[I64]`) — matching the body,
        // which genLlvmFuncBody grounds the same way. Without this the declared return is the
        // ungrounded `Optional[Item]` and the call site emits invalid GEP indices.
        val savedPS: U64 = c.cur.selfRef
        val savedPI: U64 = c.cur.itemRef
        c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.selfParamTy(c: inout c, f: f))
        mut val pi: U64 = 0
        while pi < f.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: c.funcParamAt(params: f.params, index: pi)))
            pi += 1
        }
        val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: f), arrayCPtr(ptys), ptys.count(), 0I32)
        c.cur.selfRef = savedPS
        c.cur.itemRef = savedPI
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pf".bytes())
        appendU64Dec(into: inout nm, n: fi)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        self.fnIdx.append(fi)
        self.fnVal.append(fv)
        self.fnTy.append(fty)
        self.provEmit.append(fi)
        return self.fnIdx.count() - 1U64
    }

}

pub impl LlvmCtx {

    // Declare each reachable free-function body from the frontend-frozen closure.  A body
    // rather than `(Func, args)` is the executable identity: an associated/provided callable
    // can have the same source function and ABI receiver under different selected proofs.
    // `MonoWork.fnInsts` is intentionally absent here; it is provisional discovery work and
    // must not grow normal compiler codegen after finalization.
    inout fn declareGenFns(c: inout Comp) {
        mut val bodyIndex: U64 = 0U64
        while bodyIndex < c.monoWork.bodyInstances.count() {
            val bodyId: U64 = c.monoWork.bodyInstances[bodyIndex]
            if bodyId != 0U64 && bodyId <= c.arena.bodyInstances.count() {
                val body: BodyInstance = c.arena.bodyInstances[bodyId - 1U64]
                if body.fnIdx < c.arena.funcs.count() {
                    val f: Func = c.arena.funcs[body.fnIdx]
                    // Receiver methods have their own ABI table. Async entry/resume and main
                    // likewise have dedicated emitters. Everything else is one ordinary
                    // free-function body, generic or not, keyed by this body id.
                    if !(f.hasRecv) && !(f.isExtern) && !(f.isAsync) && !(c.nameIsMain(f: f)) {
                        if genFnSlotForBody(bodyId: bodyId, st: inout self) == self.genFnK.count() {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] frozen free body declare id=")
                        self.traceCodegenU64(n: bodyId)
                        eprint(text: " fn=")
                        self.traceCodegenU64(n: body.fnIdx)
                        eprint(text: " name=")
                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                        eprint(text: "\n")
                    }
                    val savedP: Array[Bind] = c.cur.typeParams
                    val savedA: Array[U64] = c.cur.typeArgs
                    c.cur.typeParams = body.environment.params
                    c.cur.typeArgs = body.environment.args
                    val savedSelf: U64 = c.cur.selfRef
                    val savedItem: U64 = c.cur.itemRef
                    val savedRecv: U64 = self.curRecvInstRef
                    self.curRecvInstRef = body.environment.receiverRef
                    if f.isAssoc || f.isProvided {
                        c.setSelfItemEnvForBody(f: f, environment: body.environment)
                    }
                    mut val ptys: Array[LLVMTypeRef] = []
                    mut val pi: U64 = 0
                    while pi < f.params.count() {
                        ptys.append(self.paramLlvmTy(c: inout c, p: c.funcParamAt(params: f.params, index: pi)))
                        pi += 1
                    }
                    val fty: LLVMTypeRef = LLVMFunctionType(self.llvmFnRetTy(c: inout c, f: f), arrayCPtr(ptys), f.params.count(), 0I32)
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "gf".bytes())
                    appendU64Dec(into: inout nm, n: bodyId)
                    nm.append(0)
                    val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                    c.cur.selfRef = savedSelf
                    c.cur.itemRef = savedItem
                    self.curRecvInstRef = savedRecv
                    self.genFnK.append(bodyId)
                    self.genFnVal.append(fv)
                    self.genFnTy.append(fty)
                    self.genFnEmit.append(self.genFnK.count() - 1U64)
                        }
                    }
                }
            }
            bodyIndex += 1U64
        }
    }

    // Emit one frozen free-function body.  Its complete environment is installed directly;
    // rebuilding it from a partial generic argument vector would resurrect the old parallel
    // identity and can lose a provided body's proof.
    inout fn emitOneGenFn(c: inout Comp, slot: U64) {
        val bodyId: U64 = self.genFnK[slot]
        if bodyId == 0U64 || bodyId > c.arena.bodyInstances.count() { return }
        val body: BodyInstance = c.arena.bodyInstances[bodyId - 1U64]
        if body.fnIdx >= c.arena.funcs.count() { return }
        val f: Func = c.arena.funcs[body.fnIdx]
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        val savedSelf: U64 = c.cur.selfRef
        val savedItem: U64 = c.cur.itemRef
        c.cur.typeParams = body.environment.params
        c.cur.typeArgs = body.environment.args
        self.curRecvInstRef = body.environment.receiverRef
        if f.isAssoc || f.isProvided {
            c.setSelfItemEnvForBody(f: f, environment: body.environment)
        }
        if c.traceCodegen {
            eprint(text: "[trace-codegen] generic fn body-start index=")
            self.traceCodegenU64(n: body.fnIdx)
            eprint(text: " name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " slot=")
            self.traceCodegenU64(n: slot)
            eprint(text: "\n")
        }
        self.genLlvmFuncBody(c: inout c, fi: body.fnIdx, fv: self.genFnVal[slot], environment: body.environment)
        if c.traceCodegen {
            eprint(text: "[trace-codegen] generic fn body-done index=")
            self.traceCodegenU64(n: body.fnIdx)
            eprint(text: " slot=")
            self.traceCodegenU64(n: slot)
            eprint(text: "\n")
        }
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
        c.cur.selfRef = savedSelf
        c.cur.itemRef = savedItem
    }

}
