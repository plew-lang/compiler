// Physical declarations and emission for finalized free, associated and provided bodies.

pub impl LlvmCtx {

    // Declare each reachable free-function body from the frontend-frozen closure.  A body
    // rather than `(Func, args)` is the executable identity: an associated/provided callable
    // can have the same source function and ABI receiver under different selected proofs.
    // `MonoWork.fnInsts` is intentionally absent here; it is provisional discovery work and
    // must not grow normal compiler codegen after finalization.
    inout fn declareGenFns(c: inout Comp) {
        mut val bodyIndex: U64 = 0U64
        while bodyIndex < c.monoWork.bodyInstances.count() {
            val bodyId: U64 = c.monoWork.bodyInstances[bodyIndex]
            if bodyId != 0U64 && bodyId <= c.arena.bodyInstanceCount() && c.arena.bodyIsCallable(bodyId: bodyId) {
                val body: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
                if body.fnIdx < c.arena.functionCount() {
                    val f: Func = c.arena.functionAt(index: body.fnIdx)
                    // Receiver methods have their own ABI table. Async entry/resume and main
                    // likewise have dedicated emitters. Everything else is one ordinary
                    // free-function body, generic or not, keyed by this body id.
                    if !(f.hasRecv) && !(f.isExtern) && !(f.isAsync) && !(c.nameIsMain(f: f)) {
                        if genFnSlotForBody(bodyId: bodyId, st: inout self) == self.genFnK.count() {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] frozen free body declare id=")
                        self.traceCodegenU64(n: bodyId)
                        eprint(text: " fn=")
                        self.traceCodegenU64(n: body.fnIdx)
                        eprint(text: " name=")
                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                        eprint(text: "\n")
                    }
                    val savedP: Array[Bind] = c.cur.typeParams
                    val savedA: Array[U64] = c.cur.typeArgs
                    c.cur.typeParams = body.environment.params
                    c.cur.typeArgs = body.environment.args
                    val savedSelf: U64 = c.cur.selfRef
                    val savedItem: U64 = c.cur.itemRef
                    val savedRecv: U64 = self.curRecvInstRef
                    self.curRecvInstRef = body.environment.receiverRef
                    if f.isAssoc || f.isProvided {
                        c.setSelfItemEnvForBody(f: f, environment: body.environment)
                    }
                    mut val ptys: Array[LLVMTypeRef] = []
                    val parameterCount = c.arena.bodySignature(bodyId: bodyId).parameterTypes.count()
                    mut val pi: U64 = 0
                    while pi < parameterCount {
                        ptys.append(self.bodyParameterLlvmTy(c: inout c, bodyId: bodyId, index: pi))
                        pi += 1
                    }
                    val fty: LLVMTypeRef = LLVMFunctionType(self.bodyReturnLlvmTy(c: inout c, bodyId: bodyId), arrayCPtr(ptys), ptys.count(), 0I32)
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "gf".bytes())
                    appendU64Dec(into: inout nm, n: bodyId)
                    nm.append(0)
                    val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                    c.cur.selfRef = savedSelf
                    c.cur.itemRef = savedItem
                    self.curRecvInstRef = savedRecv
                    self.genFnK.append(bodyId)
                    self.genFnVal.append(fv)
                    self.genFnTy.append(fty)
                    self.genFnEmit.append(self.genFnK.count() - 1U64)
                        }
                    }
                }
            }
            bodyIndex += 1U64
        }
    }

    // Emit one frozen free-function body.  Its complete environment is installed directly;
    // rebuilding it from a partial generic argument vector would resurrect the old parallel
    // identity and can lose a provided body's proof.
    inout fn emitOneGenFn(c: inout Comp, slot: U64) {
        val bodyId: U64 = self.genFnK[slot]
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() { return }
        val body: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        if body.fnIdx >= c.arena.functionCount() { return }
        val f: Func = c.arena.functionAt(index: body.fnIdx)
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val savedR: U64 = self.curRecvInstRef
        val savedSelf: U64 = c.cur.selfRef
        val savedItem: U64 = c.cur.itemRef
        c.cur.typeParams = body.environment.params
        c.cur.typeArgs = body.environment.args
        self.curRecvInstRef = body.environment.receiverRef
        if f.isAssoc || f.isProvided {
            c.setSelfItemEnvForBody(f: f, environment: body.environment)
        }
        if c.traceCodegen {
            eprint(text: "[trace-codegen] generic fn body-start index=")
            self.traceCodegenU64(n: body.fnIdx)
            eprint(text: " name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " slot=")
            self.traceCodegenU64(n: slot)
            eprint(text: "\n")
        }
        self.genLlvmFuncBody(c: inout c, bodyId: bodyId, fv: self.genFnVal[slot])
        if c.traceCodegen {
            eprint(text: "[trace-codegen] generic fn body-done index=")
            self.traceCodegenU64(n: body.fnIdx)
            eprint(text: " slot=")
            self.traceCodegenU64(n: slot)
            eprint(text: "\n")
        }
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        self.curRecvInstRef = savedR
        c.cur.selfRef = savedSelf
        c.cur.itemRef = savedItem
    }

}
