// Physical declarations and emission for finalized free, associated and provided bodies.

pub impl LlvmCtx {

    // Declare each reachable free-function body from the frontend-frozen closure.  A body
    // rather than `(Func, args)` is the executable identity: an associated/provided callable
    // can have the same source function and ABI receiver under different selected proofs.
    // `MonoWork.fnInsts` is intentionally absent here; it is provisional discovery work and
    // must not grow normal compiler codegen after finalization.
    inout fn declareGenFns(c: inout Comp) -> Result[(), CompileDiagnostic] {
        mut val bodyIndex: U64 = 0U64
        while bodyIndex < c.monoWork.bodyInstances.count() {
            val bodyId: U64 = c.monoWork.bodyInstances[bodyIndex]
            if bodyId != 0U64 && bodyId <= c.arena.bodyInstanceCount() && c.arena.bodyIsCallable(bodyId: bodyId) {
                val body: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
                if body.fnIdx < c.arena.functionCount() {
                    val f: Func = c.arena.functionAt(index: body.fnIdx)
                    // Receiver methods have their own ABI table. Async entry/resume and main
                    // likewise have dedicated emitters. Everything else is one ordinary
                    // free-function body, generic or not, keyed by this body id.
                    if !(f.hasRecv) && !(f.isExtern) && !(f.isAsync) && !(c.nameIsMain(f: f)) {
                        if genFnSlotForBody(bodyId: bodyId, st: inout self) == self.genFnK.count() {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] frozen free body declare id=")
                        self.traceCodegenU64(n: bodyId)
                        eprint(text: " fn=")
                        self.traceCodegenU64(n: body.fnIdx)
                        eprint(text: " name=")
                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                        eprint(text: "\n")
                    }
                    mut val ptys: Array[LLVMTypeRef] = []
                    val parameterCount = c.arena.bodySignature(bodyId: bodyId).parameterTypes.count()
                    mut val pi: U64 = 0
                    while pi < parameterCount {
                        ptys.append((try self.bodyParameterLlvmTy(c: inout c, bodyId: bodyId, index: pi)))
                        pi += 1
                    }
                    val fty: LLVMTypeRef = LLVMFunctionType((try self.bodyReturnLlvmTy(c: inout c, bodyId: bodyId)), arrayCPtr(ptys), ptys.count(), 0I32)
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "gf".bytes())
                    appendU64Dec(into: inout nm, n: bodyId)
                    nm.append(0)
                    val fv: LLVMValueRef = self.declareBodyFunction(name: arrayCPtr(nm), signature: fty)
                    if f.isExposed && !c.genMode {
                        try self.emitExposedEntry(c: inout c, bodyId: bodyId, target: fv, signature: fty)
                    }
                    self.genFnK.append(bodyId)
                    self.genFnVal.append(fv)
                    self.genFnTy.append(fty)
                    self.genFnEmit.append(self.genFnK.count() - 1U64)
                        }
                    }
                }
            }
            bodyIndex += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn emitExposedEntry(c: inout Comp, bodyId: U64, target: LLVMValueRef, signature: LLVMTypeRef) -> Result[(), CompileDiagnostic] {
        match self.emission {
            LlvmBodyEmission.Whole => {}
            LlvmBodyEmission.Requested(bodyId: val requested) => {
                if bodyId != requested { return <Result.Ok value=() /> }
            }
        }
        val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        val declaration = c.arena.functionAt(index: body.fnIdx)
        val prepared = c.arena.bodySignature(bodyId: bodyId)
        mut val index = 0U64
        while index < prepared.parameterTypes.count() {
            if !(try self.resolvedCTypeSupported(c: inout c, ref: prepared.parameterTypes[index])) {
                return <Result.Err error=c.diagnosticAt(offset: declaration.nameStart, msg: "expose parameter ABI is not supported by the C backend") />
            }
            index += 1U64
        }
        if declaration.hasRet && !(try self.resolvedCTypeSupported(c: inout c, ref: prepared.resultType)) {
            return <Result.Err error=c.diagnosticAt(offset: declaration.nameStart, msg: "expose return ABI is not supported by the C backend") />
        }
        mut val name: Array[U8] = []
        index = 0U64
        while index < declaration.nameLen {
            name.append(c.arena.bytes[declaration.nameStart + index])
            index += 1U64
        }
        name.append(0U8)
        if LLVMGetNamedFunction(self.mod, arrayCPtr(name)) != 0U64 {
            return <Result.Err error=c.diagnosticAt(offset: declaration.nameStart, msg: "exposed name conflicts with an existing LLVM symbol") />
        }
        mut val parameters: Array[LLVMTypeRef] = []
        index = 0U64
        while index < prepared.parameterTypes.count() {
            parameters.append((try self.cParameterType(c: inout c, ref: prepared.parameterTypes[index], passing: prepared.parameterPassings[index])))
            index += 1U64
        }
        mut val returnType = self.voidty
        if declaration.hasRet { returnType = (try self.cScalarType(c: inout c, ref: prepared.resultType)) }
        val externalSignature = LLVMFunctionType(returnType, arrayCPtr(parameters), parameters.count(), 0I32)
        val entry = LLVMAddFunction(self.mod, arrayCPtr(name), externalSignature)
        self.declId.append(declaration.nameId)
        self.declFn.append(entry)
        self.declTy.append(externalSignature)
        self.curFn = entry
        self.beginFnBody(fv: entry)
        mut val writebacks: Array[LlvmCInout] = []
        mut val arguments: Array[LLVMValueRef] = []
        index = 0U64
        while index < prepared.parameterTypes.count() {
            val argument = LLVMGetParam(entry, index)
            try self.attachCIntegerExtension(c: inout c, function: entry, index: index + 1U64, ref: prepared.parameterTypes[index], physical: LLVMTypeOf(argument), callSite: false)
            match prepared.parameterPassings[index] {
                CallArgumentPassing.Inout => { arguments.append((try self.prepareCInout(c: inout c, ref: prepared.parameterTypes[index], pointer: argument, toC: false, writebacks: inout writebacks))) }
                _ => { arguments.append((try self.scalarFromC(c: inout c, ref: prepared.parameterTypes[index], value: argument))) }
            }
            index += 1U64
        }
        val result = (try self.callValueFunction(signature: signature, function: target, arguments: arguments))
        try self.completeCInouts(c: inout c, writebacks: writebacks)
        if declaration.hasRet {
            val externalResult = (try self.scalarToC(c: inout c, ref: prepared.resultType, value: result))
            try self.attachCIntegerExtension(c: inout c, function: entry, index: 0U64, ref: prepared.resultType, physical: LLVMTypeOf(externalResult), callSite: false)
            LLVMBuildRet(self.b, externalResult)
        }
        else { LLVMBuildRetVoid(self.b) }
        return <Result.Ok value=() />
    }

    // The frozen body ID carries the complete specialization and proof identity.
    // Emission never installs a parallel ambient substitution environment.
    inout fn emitOneGenFn(c: inout Comp, slot: U64) -> Result[(), CompileDiagnostic] {
        val bodyId: U64 = self.genFnK[slot]
        if !self.admitBody(bodyId: bodyId) { return <Result.Ok value=() /> }
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() { return <Result.Ok value=() /> }
        val body: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        if body.fnIdx >= c.arena.functionCount() { return <Result.Ok value=() /> }
        val f: Func = c.arena.functionAt(index: body.fnIdx)
        if c.traceCodegen {
            eprint(text: "[trace-codegen] generic fn body-start index=")
            self.traceCodegenU64(n: body.fnIdx)
            eprint(text: " name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " slot=")
            self.traceCodegenU64(n: slot)
            eprint(text: "\n")
        }
        try self.genLlvmFuncBody(c: inout c, bodyId: bodyId, fv: self.genFnVal[slot])
        if c.traceCodegen {
            eprint(text: "[trace-codegen] generic fn body-done index=")
            self.traceCodegenU64(n: body.fnIdx)
            eprint(text: " slot=")
            self.traceCodegenU64(n: slot)
            eprint(text: "\n")
        }
        return <Result.Ok value=() />
    }

}
