// Part of the LLVM backend (root: _.pw): for-loop emission (range / iterable / generic / array variants).

// `for i in lo ..< hi { body }` (or `..= hi`): a counter loop. The loop variable
// is bound to a fresh slot incremented each iteration; range elements are U64.

pub impl LlvmCtx {
    inout fn genLlvmForRange(c: inout Comp, varStart: U64, varLen: U64, varTyStart: U64, varTyLen: U64, inclusive: Bool, lo: U64, hi: U64, body: U64) {
        val mark: U64 = self.nLocals
        mut val vty: LLVMTypeRef = self.i64ty
        if varTyLen > 0U64 {
            vty = self.llvmScalarTy(c: inout c, tyStart: varTyStart, tyLen: varTyLen)
        }
        val loV: LLVMValueRef = self.coerceInt(v: self.genLlvmExpr(c: inout c, id: lo), target: vty, unsigned: true)
        val hiV: LLVMValueRef = self.coerceInt(v: self.genLlvmExpr(c: inout c, id: hi), target: vty, unsigned: true)
        val islot: LLVMValueRef = self.entryAlloca(ty: vty)
        LLVMBuildStore(self.b, loV, islot)
        self.pushLocal(nameStart: varStart, nameLen: varLen, ptr: islot, ty: vty, kind: 3U64, structIdx: c.arena.structs.count(), isArr: false, elemTy: self.i64ty, elemKind: 0U64)
        val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "for.cond"))
        val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "for.body"))
        // a dedicated step block (increment) so `continue` re-runs the step, not skips it.
        val stepBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "for.step"))
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "for.end"))
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, condBB)
        val iv: LLVMValueRef = LLVMBuildLoad2(self.b, vty, islot, anon())
        mut val pred: U32 = llvmIntUlt()
        if inclusive {
            pred = llvmIntUle()
        }
        LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, pred, iv, hiV, anon()), bodyBB, endBB)
        LLVMPositionBuilderAtEnd(self.b, bodyBB)
        self.terminated = false
        self.pushLoop(breakBB: endBB, contBB: stepBB, unwindMark: self.nLocals)
        self.genLlvmBlock(c: inout c, id: body)
        self.popLoop()
        if !(self.terminated) {
            LLVMBuildBr(self.b, stepBB)
        }
        // step: increment the counter and re-test.
        LLVMPositionBuilderAtEnd(self.b, stepBB)
        val iv2: LLVMValueRef = LLVMBuildLoad2(self.b, vty, islot, anon())
        LLVMBuildStore(self.b, LLVMBuildAdd(self.b, iv2, LLVMConstInt(vty, 1U64, 0I32), anon()), islot)
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, endBB)
        self.terminated = false
        // release any temporaries the lo/hi expressions homed (`for i in 0 ..< f().n`)
        // before popping them — the bare reset used to strand them (never drained:
        // popped below the enclosing statement's drain mark).
        self.drainStmtTemps(c: inout c, fromMark: mark)
        self.nLocals = mark
    }

    // `for x in arr { body }`: walk an array by index, binding x to each element.
    // `for x in iterable { body }` over a user Iterable (spec/11): desugar to the
    // iterator protocol — `it = iterable.iterator(); loop { match it.next() { Some(v)
    // => { x = v; body }, None => break } }`. The iterator is stored in a mutable slot
    // (next() is `inout`); each next() yields an Optional[Item] matched by tag.
    inout fn genLlvmForIterable(c: inout Comp, varStart: U64, varLen: U64, patStart: U64, patLen: U64, binds: Array[Bind], iter: U64, body: U64) {
        // an existential iterator (`for x in (it: any Iter[Item=I64])`): each iteration
        // dynamically dispatches `next()` on the any value (spec/08). The box is shared
        // via the fat pointer's data field, so the iterator state advances across calls.
        val recvRef: U64 = self.exprTypeRef(c: inout c, id: iter)
        if refIsAny(c: inout c, ref: recvRef) {
            self.genLlvmForAnyIter(c: inout c, varStart: varStart, varLen: varLen, patStart: patStart, patLen: patLen, binds: binds, iter: iter, anyRef: recvRef, body: body)
            return
        }
        // Generic-instance iterable/iterator (`Box[I64]` / `BoxIter[I64]`): the
        // iterator()/next() methods are monomorphized into the generic-method slots,
        // so route through that path rather than the plain user-fn slots.
        if recvRef != 0U64 {
            if c.isGenericInst(ref: recvRef) {
                self.genLlvmForGenIterable(c: inout c, varStart: varStart, varLen: varLen, patStart: patStart, patLen: patLen, binds: binds, iter: iter, body: body, recvRef: recvRef)
                return
            }
        }
        val isidx: U64 = self.exprStructIdx(c: inout c, id: iter)
        if isidx >= c.arena.structs.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: for-loop over a non-array (Iterable) not yet supported")
            return
        }
        val isd: StructDef = c.arena.structs[isidx]
        val noArgs: Array[Arg] = []
        val iterableVal: LLVMValueRef = self.genLlvmExpr(c: inout c, id: iter)
        // acquire the iterator: an Iterable provides `iterator()`; an Iterator IS its own
        // iterator (it has `next()` directly). Resolve the iterator value + its struct.
        mut val iterVal: LLVMValueRef = iterableVal
        mut val iterStructStart: U64 = isd.nameStart
        mut val iterStructLen: U64 = isd.nameLen
        val itB: Bind = c.kwSpan(kw: "iterator", kwLen: 8U64)
        val itfi: U64 = c.findMethod(recvStart: isd.nameStart, recvLen: isd.nameLen, nameStart: itB.nameStart, nameLen: itB.nameLen, args: noArgs)
        if itfi < c.arena.funcs.count() {
            // the iterator() method is the (non-generic) iterable's 0-type-arg `gm` instance.
            val itreg: U64 = self.structRegSlot(c: inout c, start: isd.nameStart, len: isd.nameLen)
            if itreg >= self.genStructRefs.count() {
                compileErrorAt(line: 0, msg: "LLVM backend: this Iterable's iterator method is not emittable yet")
                return
            }
            val itinst: U64 = self.genStructRefs[itreg]
            val itgSlot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: itfi, instRef: itinst, ownArgs: [])
            if itgSlot >= self.genMethK.count() {
                compileErrorAt(line: 0, msg: "LLVM backend: this Iterable's iterator method is not emittable yet")
                return
            }
            mut val itArgs: Array[LLVMValueRef] = []
            itArgs.append(iterableVal)
            iterVal = LLVMBuildCall2(self.b, self.genMethTy[itgSlot], self.genMethVal[itgSlot], arrayCPtr(itArgs), 1U64, anon())
            iterStructStart = c.arena.funcs[itfi].retStart
            iterStructLen = c.arena.funcs[itfi].retLen
        }
        // next() on the Iter struct -> Optional[Item]
        val nextB: Bind = c.kwSpan(kw: "next", kwLen: 4U64)
        val nfi: U64 = c.findMethod(recvStart: iterStructStart, recvLen: iterStructLen, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
        if nfi >= c.arena.funcs.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: Iterable for-loop needs a `next` method on the iterator")
            return
        }
        // next() is the (non-generic) iterator struct's 0-type-arg `gm` instance.
        val nreg: U64 = self.structRegSlot(c: inout c, start: iterStructStart, len: iterStructLen)
        if nreg >= self.genStructRefs.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: this iterator's next method is not emittable yet")
            return
        }
        val ninst: U64 = self.genStructRefs[nreg]
        val nSlotF: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: nfi, instRef: ninst, ownArgs: [])
        if nSlotF >= self.genMethK.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: this iterator's next method is not emittable yet")
            return
        }
        val nf: Func = c.arena.funcs[nfi]
        // ownsIter=false here: the non-generic Iterable path does not yet thread the iterator
        // instance ref needed to drop a heap-owning iterator at loop end (rare — all stdlib
        // collections are generic and take genLlvmForGenIterable). Loop var + body locals are
        // still released via emitIterNextLoop's per-iteration unwind.
        self.emitIterNextLoop(c: inout c, iterVal: iterVal, iterInstRef: 0U64, ownsIter: false, optRef: nf.retTy, nextTy: self.genMethTy[nSlotF], nextVal: self.genMethVal[nSlotF], varStart: varStart, varLen: varLen, patStart: patStart, patLen: patLen, binds: binds, body: body)
    }

    // `for x in genericIterable` where the receiver is a generic instance (`Box[I64]`).
    // iterator()/next() are monomorphized into the generic-method slots; the iterator
    // instance ref is recovered by grounding iterator()'s return type under the
    // receiver's env, and the Optional[Item] return by grounding next()'s under the
    // iterator instance's env.
    inout fn genLlvmForGenIterable(c: inout Comp, varStart: U64, varLen: U64, patStart: U64, patLen: U64, binds: Array[Bind], iter: U64, body: U64, recvRef: U64) {
        val gt: TypeRef = c.arena.types[recvRef]
        val noArgs: Array[Arg] = []
        mut val iterVal: LLVMValueRef = LLVMConstInt(self.i64ty, 0U64, 0I32)
        mut val iterInstRef: U64 = recvRef
        val itB: Bind = c.kwSpan(kw: "iterator", kwLen: 8U64)
        val itfi: U64 = c.findMethod(recvStart: gt.nameStart, recvLen: gt.nameLen, nameStart: itB.nameStart, nameLen: itB.nameLen, args: noArgs)
        if itfi < c.arena.funcs.count() {
            // an Iterable: call iterator() and switch the instance ref to the iterator's.
            val itSlot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: itfi, instRef: recvRef, ownArgs: [])
            if itSlot >= self.genMethK.count() {
                compileErrorAt(line: 0, msg: "LLVM backend: this generic Iterable's iterator method is not emittable yet")
                return
            }
            iterVal = self.genGenMethodCall(c: inout c, recv: iter, mfi: itfi, slot: itSlot, instRef: recvRef, args: noArgs)
            val itf: Func = c.arena.funcs[itfi]
            val sP: Array[Bind] = c.cur.typeParams
            val sA: Array[U64] = c.cur.typeArgs
            c.cur.typeParams = itf.typeParams
            c.cur.typeArgs = gt.args
            iterInstRef = c.groundTypeRef(ref: itf.retTy)
            c.cur.typeParams = sP
            c.cur.typeArgs = sA
        } else {
            // the value IS its own Iterator (it has next() directly).
            iterVal = self.genLlvmExpr(c: inout c, id: iter)
        }
        val it: TypeRef = c.arena.types[iterInstRef]
        val nextB: Bind = c.kwSpan(kw: "next", kwLen: 4U64)
        val nfi: U64 = c.findMethod(recvStart: it.nameStart, recvLen: it.nameLen, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
        if nfi >= c.arena.funcs.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: generic Iterable for-loop needs a `next` method on the iterator")
            return
        }
        val nSlot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: nfi, instRef: iterInstRef, ownArgs: [])
        if nSlot >= self.genMethK.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: this generic iterator's next method is not emittable yet")
            return
        }
        val nf: Func = c.arena.funcs[nfi]
        val sP2: Array[Bind] = c.cur.typeParams
        val sA2: Array[U64] = c.cur.typeArgs
        c.cur.typeParams = nf.typeParams
        c.cur.typeArgs = it.args
        val optRef: U64 = c.groundTypeRef(ref: nf.retTy)
        c.cur.typeParams = sP2
        c.cur.typeArgs = sA2
        // we OWN the iterator only when we created it via iterator() (a fresh temp that
        // shares the source's buffer). When the value IS its own iterator, it is the caller's
        // place — dropping it here would double-free — so leave it to its own scope.
        val ownsIter: Bool = itfi < c.arena.funcs.count()
        self.emitIterNextLoop(c: inout c, iterVal: iterVal, iterInstRef: iterInstRef, ownsIter: ownsIter, optRef: optRef, nextTy: self.genMethTy[nSlot], nextVal: self.genMethVal[nSlot], varStart: varStart, varLen: varLen, patStart: patStart, patLen: patLen, binds: binds, body: body)
    }

    // Bind an iterator-protocol loop variable from a Some payload value already stored in
    // `slot` (declared element ref `xRef`, name span `xStart`/`xLen`, ground). An
    // `Array[any P]` element keeps its existential TypeRef so a bare `s.m()` in the body
    // dispatches dynamically (spec/08); a generic-instance or registered-struct element
    // keeps its struct index so a field access / method call resolves; a plain scalar keeps
    // its grounded kind (a Bool element is i1 -> kind 2, zero-extended on print).
    inout fn bindIterElem(c: inout Comp, varStart: U64, varLen: U64, slot: LLVMValueRef, ty: LLVMTypeRef, xRef: U64, xStart: U64, xLen: U64) {
        if refIsAny(c: inout c, ref: xRef) {
            self.pushLocalR(nameStart: varStart, nameLen: varLen, ptr: slot, ty: ty, kind: 0U64, structIdx: c.arena.structs.count(), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: xRef)
            return
        }
        if xRef != 0U64 {
            if xRef < c.arena.types.count() {
                if c.isGenericInst(ref: xRef) {
                    val egs: U64 = self.genStructSlot(c: inout c, ref: xRef)
                    if egs < self.genStructRefs.count() {
                        self.pushLocalR(nameStart: varStart, nameLen: varLen, ptr: slot, ty: ty, kind: 0U64, structIdx: self.genStructDefs[egs], isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: xRef)
                        return
                    }
                }
            }
        }
        val sidx: U64 = self.localStructIdxFor(c: inout c, start: xStart, len: xLen)
        if sidx < c.arena.structs.count() {
            self.pushLocalR(nameStart: varStart, nameLen: varLen, ptr: slot, ty: ty, kind: 0U64, structIdx: sidx, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: xRef)
            return
        }
        // carry the element TYPE REF even for the scalar / opaque fallback so a heap-owning
        // loop variable the iterator handed us by value — a `Ref[T]`/`WeakRef[T]` element —
        // is recognized by emitDeinitCall and released at each iteration's end (next() yields
        // a retained copy). A scalar ref is inert there (no Ref/array/struct/enum class), so
        // this is a no-op for `for i in 0..n` and the like.
        self.pushLocalR(nameStart: varStart, nameLen: varLen, ptr: slot, ty: ty, kind: kindFromTySpan(c: inout c, tyStart: xStart, tyLen: xLen), structIdx: c.arena.structs.count(), isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: xRef)
    }

    // Drive the iterator-protocol loop: store `iterVal` in a mutable slot (next() is
    // `inout`), and on each `next()` call (callee `nextTy`/`nextVal`) match the ground
    // `optRef` Optional[Item] — bind x to the Some payload + run body, else break.
    inout fn emitIterNextLoop(c: inout Comp, iterVal: LLVMValueRef, iterInstRef: U64, ownsIter: Bool, optRef: U64, nextTy: LLVMTypeRef, nextVal: LLVMValueRef, varStart: U64, varLen: U64, patStart: U64, patLen: U64, binds: Array[Bind], body: U64) {
        val iterTy: LLVMTypeRef = LLVMTypeOf(iterVal)
        val iterSlot: LLVMValueRef = self.entryAlloca(ty: iterTy)
        LLVMBuildStore(self.b, iterVal, iterSlot)
        // resolve the Optional enum (def + Some variant) under its instance env.
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val didSet: Bool = self.setEnumEnv(c: inout c, ref: optRef)
        val ge: U64 = self.genEnumSlot(c: inout c, ref: optRef)
        if ge >= self.genEnumRefs.count() {
            if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
            compileErrorAt(line: 0, msg: "LLVM backend: iterator next must return a registered Optional instance")
            return
        }
        val optEid: U64 = self.genEnumDefs[ge]
        val optTy: LLVMTypeRef = self.genEnumTys[ge]
        val ed: EnumDef = c.arena.enums[optEid]
        val someB: Bind = c.kwSpan(kw: "Some", kwLen: 4U64)
        val someVi: U64 = c.variantIndex(enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: someB.nameStart, variantLen: someB.nameLen)
        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: optEid, vi: someVi)
        // the bound element's declared type (the Some payload's single field).
        val itemFs: Array[FieldDef] = ed.variants[someVi].fields
        val mark: U64 = self.nLocals
        val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "fit.cond"))
        val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "fit.body"))
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "fit.end"))
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, condBB)
        // it.next() — self is `inout` (the iterator slot pointer); yields Optional[Item].
        mut val nArgs: Array[LLVMValueRef] = []
        nArgs.append(iterSlot)
        val opt: LLVMValueRef = LLVMBuildCall2(self.b, nextTy, nextVal, arrayCPtr(nArgs), 1U64, anon())
        val optSlot: LLVMValueRef = self.entryAlloca(ty: optTy)
        LLVMBuildStore(self.b, opt, optSlot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, optTy, optSlot, 0U64, anon()), anon())
        val isSome: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, someVi, 0I32), anon())
        LLVMBuildCondBr(self.b, isSome, bodyBB, endBB)
        LLVMPositionBuilderAtEnd(self.b, bodyBB)
        self.terminated = false
        // bind x = the Some payload's field 0.
        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, LLVMBuildStructGEP2(self.b, optTy, optSlot, 1U64, anon()), anon())
        val xVal: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, 0U64, anon())
        val xTy: LLVMTypeRef = LLVMTypeOf(xVal)
        val xSlot: LLVMValueRef = self.entryAlloca(ty: xTy)
        LLVMBuildStore(self.b, xVal, xSlot)
        mut val xRef: U64 = itemFs[0].ty
        mut val xStart: U64 = itemFs[0].tyStart
        mut val xLen: U64 = itemFs[0].tyLen
        // ground the element type through the active enum env so its kind is concrete
        // (a `map`-to-Bool element is i1 -> kind 2, zero-extended on print, not -1) and an
        // `Array[any P]` element's existential ref is recovered for dynamic dispatch.
        if itemFs[0].ty != 0U64 {
            if c.cur.typeParams.count() > 0U64 {
                val gx: U64 = c.groundTypeRef(ref: itemFs[0].ty)
                xRef = gx
                xStart = c.arena.types[gx].nameStart
                xLen = c.arena.types[gx].nameLen
            }
        }
        // a struct-destructure pattern (`for S { val a } in …`) binds the element's
        // fields directly (mirroring the match struct pattern); otherwise bind the whole
        // element to the single loop variable.
        if binds.count() > 0U64 {
            val psidx: U64 = self.localStructIdxFor(c: inout c, start: patStart, len: patLen)
            if psidx >= c.arena.structs.count() {
                if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
                compileErrorAt(line: 0, msg: "LLVM backend: struct-destructure for-loop needs a registered struct pattern")
                return
            }
            // the iterator handed the ELEMENT over as an owned (+1) value; the
            // destructure binds only its FIELDS (each retaining its own heap), so the
            // element itself needs an anonymous owned home — dropScope releases it at
            // each iteration's end (the single-variable branch's loop var plays this
            // role in bindIterElem).
            self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: xSlot, ty: xTy, kind: 0U64, structIdx: psidx, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: xRef)
            self.bindStructPattern(c: inout c, sidx: psidx, binds: binds, scrutTy: xTy, scrutSlot: xSlot)
        } else {
            self.bindIterElem(c: inout c, varStart: varStart, varLen: varLen, slot: xSlot, ty: xTy, xRef: xRef, xStart: xStart, xLen: xLen)
        }
        if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
        // `continue` -> condBB (next() again), `break` -> endBB. unwindMark = `mark` (before
        // the loop var) so a heap-owning loop var is released on every iteration exit.
        self.pushLoop(breakBB: endBB, contBB: condBB, unwindMark: mark)
        self.genLlvmBlock(c: inout c, id: body)
        self.popLoop()
        // normal iteration end: release this iteration's per-iteration locals (the loop var
        // the iterator handed us, owned) before looping back — a return/break/continue inside
        // the body already released them, so only drop on the fall-through path.
        if !(self.terminated) {
            self.dropScope(c: inout c, fromMark: mark, excludeLi: 18446744073709551615U64)
            self.nLocals = mark
            LLVMBuildBr(self.b, condBB)
        } else {
            self.nLocals = mark
        }
        LLVMPositionBuilderAtEnd(self.b, endBB)
        self.terminated = false
        // every loop exit (normal end + break) lands here: release the iterator we own so its
        // shared source buffer reaches rc 0 and cascade-releases its elements.
        self.emitOwnedIteratorDrop(c: inout c, iterInstRef: iterInstRef, ownsIter: ownsIter, iterTy: iterTy, iterSlot: iterSlot)
        self.nLocals = mark
    }

    // Release an iterator created via iterator() at loop exit. It shares the source
    // collection's buffer (retained when `<ArrayIter arr=self …/>` copied the place), so
    // dropping it lets that buffer reach rc 0 and cascade-release its elements — otherwise
    // every for-loop over a heap-owning collection leaks. Called at endBB (the single exit
    // both normal completion and `break` reach). A non-owned iterator (the value WAS its own
    // iterator = a caller place) is left to its own scope, so we never double-free.
    inout fn emitOwnedIteratorDrop(c: inout Comp, iterInstRef: U64, ownsIter: Bool, iterTy: LLVMTypeRef, iterSlot: LLVMValueRef) {
        if !(ownsIter) { return }
        if iterInstRef == 0U64 { return }
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val didSet: Bool = self.setStructEnv(c: inout c, ref: iterInstRef)
        val igs: U64 = self.genStructSlot(c: inout c, ref: iterInstRef)
        if igs < self.genStructRefs.count() {
            val isidx: U64 = self.genStructDefs[igs]
            if self.structNeedsDeinit(c: inout c, sidx: isidx) {
                self.emitDeinitValue(c: inout c, v: LLVMBuildLoad2(self.b, iterTy, iterSlot, anon()), sidx: isidx, ref: iterInstRef)
            }
        }
        if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
    }

    // `for x in anyIter` where the receiver is an existential `any Iter[Item=…]`: loop
    // dynamically dispatching `next()` on the any value (the box's iterator state
    // advances in place), binding `x` to each `Some` payload until `None`.
    inout fn genLlvmForAnyIter(c: inout Comp, varStart: U64, varLen: U64, patStart: U64, patLen: U64, binds: Array[Bind], iter: U64, anyRef: U64, body: U64) {
        val traitIdx: U64 = c.findTraitIdxByName(start: c.arena.types[anyRef].nameStart, len: c.arena.types[anyRef].nameLen)
        if traitIdx >= c.decls.traits.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: for-loop over `any` needs a trait with a `next` method")
            return
        }
        val nextB: Bind = c.kwSpan(kw: "next", kwLen: 4U64)
        val noArgs: Array[Arg] = []
        // the grounded Optional[Item] the existential's next() returns.
        val optRef: U64 = anyMethodRetRef(c: inout c, anyRef: anyRef, traitIdx: traitIdx, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
        if optRef == 0U64 {
            compileErrorAt(line: 0, msg: "LLVM backend: this `any` iterator has no `next() -> Optional[Item]` requirement")
            return
        }
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val didSet: Bool = self.setEnumEnv(c: inout c, ref: optRef)
        val ge: U64 = self.genEnumSlot(c: inout c, ref: optRef)
        if ge >= self.genEnumRefs.count() {
            if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
            compileErrorAt(line: 0, msg: "LLVM backend: `any` iterator next must return a registered Optional instance")
            return
        }
        val optEid: U64 = self.genEnumDefs[ge]
        val optTy: LLVMTypeRef = self.genEnumTys[ge]
        val ed: EnumDef = c.arena.enums[optEid]
        val someB: Bind = c.kwSpan(kw: "Some", kwLen: 4U64)
        val someVi: U64 = c.variantIndex(enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: someB.nameStart, variantLen: someB.nameLen)
        val payloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: optEid, vi: someVi)
        val itemFs: Array[FieldDef] = ed.variants[someVi].fields
        val mark: U64 = self.nLocals
        val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "fai.cond"))
        val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "fai.body"))
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "fai.end"))
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, condBB)
        // it.next() via dynamic dispatch (the loaded fat pointer's stable data ptr -> the
        // shared box, mutated in place).
        val opt: LLVMValueRef = self.genLlvmAnyDispatch(c: inout c, recv: iter, anyRef: anyRef, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
        val optSlot: LLVMValueRef = self.entryAlloca(ty: optTy)
        LLVMBuildStore(self.b, opt, optSlot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, optTy, optSlot, 0U64, anon()), anon())
        val isSome: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, someVi, 0I32), anon())
        LLVMBuildCondBr(self.b, isSome, bodyBB, endBB)
        LLVMPositionBuilderAtEnd(self.b, bodyBB)
        self.terminated = false
        val payload: LLVMValueRef = LLVMBuildLoad2(self.b, payloadTy, LLVMBuildStructGEP2(self.b, optTy, optSlot, 1U64, anon()), anon())
        val xVal: LLVMValueRef = LLVMBuildExtractValue(self.b, payload, 0U64, anon())
        val xTy: LLVMTypeRef = LLVMTypeOf(xVal)
        val xSlot: LLVMValueRef = self.entryAlloca(ty: xTy)
        LLVMBuildStore(self.b, xVal, xSlot)
        mut val xRef: U64 = itemFs[0].ty
        mut val xStart: U64 = itemFs[0].tyStart
        mut val xLen: U64 = itemFs[0].tyLen
        if itemFs[0].ty != 0U64 {
            if c.cur.typeParams.count() > 0U64 {
                val gx: U64 = c.groundTypeRef(ref: itemFs[0].ty)
                xRef = gx
                xStart = c.arena.types[gx].nameStart
                xLen = c.arena.types[gx].nameLen
            }
        }
        if binds.count() > 0U64 {
            val psidx: U64 = self.localStructIdxFor(c: inout c, start: patStart, len: patLen)
            if psidx >= c.arena.structs.count() {
                if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
                compileErrorAt(line: 0, msg: "LLVM backend: struct-destructure for-loop needs a registered struct pattern")
                return
            }
            // the iterator handed the ELEMENT over as an owned (+1) value; the
            // destructure binds only its FIELDS (each retaining its own heap), so the
            // element itself needs an anonymous owned home — dropScope releases it at
            // each iteration's end (the single-variable branch's loop var plays this
            // role in bindIterElem).
            self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: xSlot, ty: xTy, kind: 0U64, structIdx: psidx, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: xRef)
            self.bindStructPattern(c: inout c, sidx: psidx, binds: binds, scrutTy: xTy, scrutSlot: xSlot)
        } else {
            self.bindIterElem(c: inout c, varStart: varStart, varLen: varLen, slot: xSlot, ty: xTy, xRef: xRef, xStart: xStart, xLen: xLen)
        }
        if didSet { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
        // unwindMark = `mark` (before the loop var) so a heap-owning loop var is released on
        // every iteration exit (break/continue/return) as well as normal iteration end.
        self.pushLoop(breakBB: endBB, contBB: condBB, unwindMark: mark)
        self.genLlvmBlock(c: inout c, id: body)
        self.popLoop()
        if !(self.terminated) {
            self.dropScope(c: inout c, fromMark: mark, excludeLi: 18446744073709551615U64)
            self.nLocals = mark
            LLVMBuildBr(self.b, condBB)
        } else {
            self.nLocals = mark
        }
        LLVMPositionBuilderAtEnd(self.b, endBB)
        self.terminated = false
        self.nLocals = mark
    }


    // `for S { val x } in iterable { body }`: a struct-destructure for-loop drives the
    // same iterator protocol as the single-variable form, but binds each element's
    // fields (per the struct pattern) directly — mirroring the match struct pattern —
    // rather than binding the whole element to one variable.
    inout fn genLlvmForArrayStruct(c: inout Comp, patStart: U64, patLen: U64, iter: U64, binds: Array[Bind], body: U64) {
        self.genLlvmForIterable(c: inout c, varStart: 0U64, varLen: 0U64, patStart: patStart, patLen: patLen, binds: binds, iter: iter, body: body)
    }
}
