// Physical async lowering consumes the same prepared canonical body as sync
// emission. No AST local collection or source expression evaluation occurs here.
import ../../Mid with { planCanonicalMidAsyncFrame }

pub impl LlvmCtx {
    inout fn prepareAsyncMidCanonical(c: inout Comp, bodyId: U64) -> MidCanonicalBody {
        val fi = c.arena.bodyInstanceAt(index: bodyId - 1U64).fnIdx
        val built = buildMidBodyForInstance(c: inout c, fnIdx: fi, bodyId: bodyId)
        match built.error {
            MidBuildError.None => {}
            _ => { self.recordMidBuildError(c: inout c, bodyId: bodyId, fnIdx: fi, error: built.error)
                c.errorAt(offset: c.fnAnchor(f: c.arena.functionAt(index: fi)), msg: "async Mid body construction failed")
                return <MidCanonicalBody body=0U64 /> }
        }
        match self.prepareMidExecutable(c: inout c, canonical: built.canonical, bodyId: bodyId, fnIdx: fi) {
            Optional.Some(v: val executable) => { return executable.canonical }
            Optional.None => {
                c.errorAt(offset: c.fnAnchor(f: c.arena.functionAt(index: fi)), msg: "async Mid preparation failed")
                return <MidCanonicalBody body=0U64 />
            }
        }
    }

    inout fn buildMidAsyncFrameTy(c: inout Comp, bodyId: U64) -> LLVMTypeRef {
        val fi = c.arena.bodyInstanceAt(index: bodyId - 1U64).fnIdx
        val canonical = self.prepareAsyncMidCanonical(c: inout c, bodyId: bodyId)
        val plan = planCanonicalMidAsyncFrame(c: c, canonical: canonical)
        if !plan.valid {
            if c.traceCodegen {
                eprint(text: "[trace-codegen] async-frame-invalid well-formed=")
                if c.mid.isWellFormed(body: canonical) { eprint(text: "1") } else { eprint(text: "0") }
                eprint(text: "\n")
                val failed = c.mid.bodies[canonical.body - 1U64]
                mut val index: U64 = 0U64
                while index < failed.blocks.len {
                    val block = c.mid.blocks[failed.blocks.start + index]
                    eprint(text: "[trace-codegen] async-frame-block ")
                    self.traceCodegenU64(n: index)
                    eprint(text: " term=")
                    self.traceCodegenU64(n: c.mid.terminators[block.terminator - 1U64].tag)
                    mut val statement: U64 = 0U64
                    while statement < block.statements.len {
                        val item = c.mid.statements[block.statements.start + statement]
                        eprint(text: " statement=")
                        self.traceCodegenU64(n: item.tag)
                        if item.value != 0U64 { eprint(text: ":")
                            self.traceCodegenU64(n: c.mid.rvalues[item.value - 1U64].tag) }
                        statement += 1U64
                    }
                    eprint(text: "\n")
                    index += 1U64
                }
            }
            c.errorAt(offset: c.fnAnchor(f: c.arena.functionAt(index: fi)), msg: "async Mid frame analysis failed")
            return self.i64ty }
        val body = c.mid.bodies[canonical.body - 1U64]
        mut val types: Array[LLVMTypeRef] = [self.i32ty, self.ptrty]
        mut val slots: Array[U64] = []
        mut val local: U64 = 0U64
        while local < body.locals.len {
            val declaration = c.mid.locals[body.locals.start + local]
            // Parameters are the entry-to-resume handoff, in addition to the
            // values retained across suspension. All other locals use liveness.
            if declaration.isParameter || plan.storedLocals[local] {
                slots.append(types.count())
                if declaration.isCaptureCell { types.append(self.ptrty) }
                else { types.append(self.midCanonicalLocalTy(c: inout c, body: body, local: local)) }
            } else { slots.append(0U64) }
            local += 1U64
        }
        mut val name: Array[U8] = []
        appendBytes(into: inout name, from: "__af".bytes())
        appendU64Dec(into: inout name, n: fi)
        name.append(0U8)
        val frame = LLVMStructCreateNamed(self.ctx, arrayCPtr(name))
        LLVMStructSetBody(frame, arrayCPtr(types), types.count(), 0I32)
        self.asyncMidBodies.append(canonical)
        self.asyncLocalSlots.append(slots)
        return frame
    }

    inout fn midAsyncComplete(c: inout Comp, value: LLVMValueRef) {
        // Mid has already emitted every source Drop before the return. This
        // tail owns only the activation's Promise count and its frame memory.
        val promise = llvmLoad(self.b, self.ptrty, LLVMBuildStructGEP2(self.b, self.curFrameTy, self.curFrameBase, 1U64, anon()), anon())
        val arguments: Array[LLVMValueRef] = [promise, value]
        val types: Array[LLVMTypeRef] = [self.ptrty, self.i64ty]
        val signature = LLVMFunctionType(self.voidty, arrayCPtr(types), types.count(), 0I32)
        val function = self.getOrDeclare(c: inout c, name: "plew_promise_resolve", fnTy: signature)
        val ignored = LLVMBuildCall2(self.b, signature, function, arrayCPtr(arguments), arguments.count(), anon())
        self.rawbufDrop(c: inout c, cell: promise)
        self.asyncFreeFrame(c: inout c, frame: self.curFrameBase)
        LLVMBuildRetVoid(self.b)
    }

    inout fn midAsyncSuspend(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, target: LLVMBasicBlockRef) -> Bool {
        val promise = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value)
        llvmStore(self.b, LLVMConstInt(self.i32ty, term.state, 0I32), LLVMBuildStructGEP2(self.b, self.curFrameTy, self.curFrameBase, 0U64, anon()))
        val done = llvmLoad(self.b, self.i32ty, LLVMBuildStructGEP2(self.b, self.promiseTy, promise, 0U64, anon()), anon())
        val complete = LLVMBuildICmp(self.b, llvmIntNe(), done, LLVMConstInt(self.i32ty, 0U64, 0I32), anon())
        val completion = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.await.complete"))
        val suspended = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.await.suspend"))
        LLVMBuildCondBr(self.b, complete, completion, suspended)
        LLVMPositionBuilderAtEnd(self.b, suspended)
        // Registration is runtime-owned: several activations may await the
        // same shared Promise without replacing each other's continuation.
        val arguments: Array[LLVMValueRef] = [promise, self.curResumeFn, self.curFrameBase]
        val types: Array[LLVMTypeRef] = [self.ptrty, self.ptrty, self.ptrty]
        val signature = LLVMFunctionType(self.voidty, arrayCPtr(types), types.count(), 0I32)
        val function = self.getOrDeclare(c: inout c, name: "plew_promise_await", fnTy: signature)
        val ignored = LLVMBuildCall2(self.b, signature, function, arrayCPtr(arguments), arguments.count(), anon())
        LLVMBuildRetVoid(self.b)
        LLVMAddCase(self.curAsyncSwitch, LLVMConstInt(self.i32ty, term.state, 0I32), completion)
        LLVMPositionBuilderAtEnd(self.b, completion)
        // The pre-suspend SSA value does not dominate a callback re-entry.
        val retained = self.midCanonicalEmitOperand(c: inout c, body: body, operandId: term.value)
        val result = llvmLoad(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, self.promiseTy, retained, 1U64, anon()), anon())
        val destination = c.mid.places[term.destination - 1U64]
        val type = self.midCanonicalLocalTy(c: inout c, body: body, local: destination.local)
        llvmStore(self.b, self.coerceInt(v: result, target: type, unsigned: false), self.midCanonicalPlacePtr(c: inout c, body: body, place: destination, forWrite: true))
        LLVMBuildBr(self.b, target)
        return true
    }

    inout fn genLlvmMidAsyncResume(c: inout Comp, slot: U64) {
        val canonical = self.asyncMidBodies[slot]
        val body = c.mid.bodies[canonical.body - 1U64]
        val parameters = c.arena.bodySignature(bodyId: body.bodyInstance).parameterTypes.count()
        match self.midVerifiedLlvmPreflight(c: inout c, canonical: canonical, abiParameterCount: parameters, asyncBody: true) {
            MidLlvmPreflight.Ready => {}
            _ => { c.errorAt(offset: c.fnAnchor(f: c.arena.functionAt(index: body.sourceFunction)), msg: "async Mid LLVM preflight failed")
                return }
        }
        self.curFn = self.asyncResumeFn[slot]
        self.curResumeFn = self.curFn
        self.curFrameTy = self.asyncFrameTy[slot]
        self.curFrameBase = self.valueParameter(function: self.curFn, index: 0U64)
        self.curIsMain = false
        self.curRetVoid = true
        self.beginFnBody(fv: self.curFn)
        mut val storage: Array[LLVMValueRef] = []
        val slots = self.asyncLocalSlots[slot]
        mut val local: U64 = 0U64
        while local < body.locals.len {
            if slots[local] != 0U64 { storage.append(LLVMBuildStructGEP2(self.b, self.curFrameTy, self.curFrameBase, slots[local], anon())) }
            else if c.mid.locals[body.locals.start + local].isCaptureCell { storage.append(self.entryAlloca(ty: self.ptrty)) }
            else { storage.append(self.entryAlloca(ty: self.midCanonicalLocalTy(c: inout c, body: body, local: local))) }
            local += 1U64
        }
        if !self.midPrepareCanonicalLocals(c: inout c, body: body, storage: storage, initializeParameters: false) { c.errorAt(offset: 0U64, msg: "async Mid local binding failed")
            return }
        val start = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "mid.async.start"))
        val state = llvmLoad(self.b, self.i32ty, LLVMBuildStructGEP2(self.b, self.curFrameTy, self.curFrameBase, 0U64, anon()), anon())
        self.curAsyncSwitch = LLVMBuildSwitch(self.b, state, start, 8U32)
        LLVMPositionBuilderAtEnd(self.b, start)
        if !self.genLlvmPreparedMidBody(c: inout c, prepared: <MidLlvmPrepared.Ready canonical=canonical abiParameterCount=parameters />, localsPrepared: true, asyncBody: true) { c.errorAt(offset: 0U64, msg: "async Mid LLVM emission failed") }
    }
}
