// Part of the LLVM backend (root: _.pw): parameter / return LLVM-type lowering.

pub impl LlvmCtx {
    inout fn bodyResultType(c: inout Comp, bodyId: U64) -> U64 {
        val signature = c.arena.bodySignature(bodyId: bodyId)
        if !signature.ready {
            c.errorAt(offset: 0U64, msg: "internal error: body ABI signature was not finalized")
        }
        return signature.resultType
    }

    inout fn bodyReturnLlvmTy(c: inout Comp, bodyId: U64) -> LLVMTypeRef {
        val result = self.bodyResultType(c: inout c, bodyId: bodyId)
        if result == 0U64 { return self.voidty }
        return self.llvmTypeOfRef(c: inout c, ref: result)
    }

    inout fn bodyParameterLlvmTy(c: inout Comp, bodyId: U64, index: U64) -> LLVMTypeRef {
        val signature = c.arena.bodySignature(bodyId: bodyId)
        if !signature.ready || signature.parameterTypes.count() != signature.parameterPassings.count() || index >= signature.parameterTypes.count() {
            c.errorAt(offset: 0U64, msg: "internal error: finalized body parameter type is missing")
            return self.voidty
        }
        match signature.parameterPassings[index] {
            CallArgumentPassing.Inout => { return self.ptrty }
            CallArgumentPassing.Borrow => {}
            CallArgumentPassing.Move => {}
        }
        return self.llvmTypeOfRef(c: inout c, ref: signature.parameterTypes[index])
    }

}
