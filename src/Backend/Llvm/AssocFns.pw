// Part of the LLVM backend (root: _.pw): parameter / return LLVM-type lowering.

pub impl LlvmCtx {

    // The LLVM type of a parameter: a pointer for an `inout` parameter (it receives
    // the caller's address and mutates in place), else the value type (array-aware).
    inout fn paramLlvmTy(c: inout Comp, p: Param) -> LLVMTypeRef {
        if p.isInout {
            return self.ptrty
        }
        // a `Self`-typed param resolves to the receiver type (Self env set during method
        // emission).
        if c.cur.selfRef != 0U64 {
            if rangeEquals(bytes: c.arena.bytes, start: p.tyStart, len: p.tyLen, kw: "Self") {
                return self.llvmTypeOfRef(c: inout c, ref: c.cur.selfRef)
            }
        }
        // an existential `any P` param: the fat pointer (spec/08).
        if refIsAny(c: inout c, ref: p.ty) {
            return self.anyTy
        }
        // ground a generic-instance param type (`Box[T]`) through the active env.
        mut val pt: U64 = p.ty
        if c.cur.typeParams.count() > 0U64 {
            pt = c.groundTypeRef(ref: pt)
        }
        // a type param bound to an existential (`T = any P`): the fat pointer. The
        // ungrounded `p.ty` (a bare `T`) is not `any`, so this grounded re-check catches it.
        if refIsAny(c: inout c, ref: pt) {
            return self.anyTy
        }
        if c.isGenericInst(ref: pt) {
            return self.llvmTypeOfRef(c: inout c, ref: pt)
        }
        // a bare scalar type param (`v: T` with T -> F64 / I32): use the GROUNDED name so the
        // signature's scalar type matches the instance (a T -> F64 param is `double`, not the
        // ungrounded-`T` i64 default) — otherwise a float travels through an i64 slot and its
        // bits are reinterpreted. bindOneParam grounds the matching alloca the same way.
        mut val ptStart: U64 = p.tyStart
        mut val ptLen: U64 = p.tyLen
        if pt != p.ty {
            if pt < c.arena.types.count() {
                ptStart = c.arena.types[pt].nameStart
                ptLen = c.arena.types[pt].nameLen
            }
        }
        return self.llvmTypeFor(c: inout c, tyStart: ptStart, tyLen: ptLen, isArray: p.tyIsArray)
    }

    // The LLVM type of a method's `self` parameter: a pointer for `inout fn` (mutates
    // the caller's value), else the receiver struct by value.
    inout fn selfParamTy(c: inout Comp, f: Func) -> LLVMTypeRef {
        if f.selfInout {
            return self.ptrty
        }
        return self.llvmScalarTy(c: inout c, tyStart: f.recvStart, tyLen: f.recvLen)
    }

    // The LLVM return type of a function (and whether it is void = Plew `()`).
    inout fn llvmFnRetTy(c: inout Comp, f: Func) -> LLVMTypeRef {
        if f.hasRet {
            // a BARE `-> Self` return resolves to the receiver type (the Self env is set while
            // emitting a method): `fn dup() -> Self` on N returns N. Gate on `!retIsArray`: a
            // `-> Array[Self]` shares the legacy `retStart` span "Self" (the element head view)
            // with retIsArray=true — the shortcut would wrongly drop the Array wrapper and
            // return the bare element type. Let those fall through to the structured-ref
            // grounding path below (`retTy` carries the full `Array[Self]`).
            if c.cur.selfRef != 0U64 {
                if !(f.retIsArray) {
                    if rangeEquals(bytes: c.arena.bytes, start: f.retStart, len: f.retLen, kw: "Self") {
                        return self.llvmTypeOfRef(c: inout c, ref: c.cur.selfRef)
                    }
                }
            }
            // an existential `any P` return: the fat pointer (spec/08).
            if refIsAny(c: inout c, ref: f.retTy) {
                return self.anyTy
            }
            // ground a generic-instance return (`Box[T]`) through the active env so it
            // resolves to the registered concrete instance (`Box[I32]`). Also ground when
            // only a Self/Item env is active (a non-generic method on a conforming type:
            // `first() -> Optional[Item]` on Counter grounds Item -> I64 via curItemRef,
            // even though Counter has no type params).
            mut val rt: U64 = f.retTy
            if c.cur.typeParams.count() > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
                rt = c.groundTypeRef(ref: rt)
            }
            // a type param bound to an existential (`get() -> T` with `T = any P`): the fat
            // pointer. The ungrounded `f.retTy` (a bare `T`) is not `any`, so re-check here.
            if refIsAny(c: inout c, ref: rt) {
                return self.anyTy
            }
            if c.isGenericInst(ref: rt) {
                return self.llvmTypeOfRef(c: inout c, ref: rt)
            }
            // lower from the GROUNDED return ref's name (not the declared `f.retStart`
            // span) ONLY when grounding actually transformed a real ret type — so a
            // grounded anonymous record (`(v:T)` -> `(v:I32)`) resolves to its concrete
            // instance's struct type, not the i64-defaulting template. When grounding is a
            // no-op (`rt == f.retTy`) or there is no structured ret ref (`f.retTy == 0`, a
            // derived witness carrying only `f.retStart`), fall back to the declared span.
            if f.retTy != 0U64 {
                if rt != f.retTy {
                    if rt < c.arena.types.count() {
                        val rtT: TypeRef = c.arena.types[rt]
                        return self.llvmTypeFor(c: inout c, tyStart: rtT.nameStart, tyLen: rtT.nameLen, isArray: f.retIsArray)
                    }
                }
            }
            return self.llvmTypeFor(c: inout c, tyStart: f.retStart, tyLen: f.retLen, isArray: f.retIsArray)
        }
        return self.voidty
    }

}
