// Part of the LLVM backend (root: _.pw): generic struct / enum instance registration and slot assignment.

// ---- generic struct instances ----

// Register each concrete generic-struct instantiation (from c.monoWork.genInsts) as a named
// LLVM type with its type parameters substituted (env curTypeParams->curTypeArgs).
// Split into a NAMES pass and a BODIES pass (called separately by the backend init)
// so EVERY named type — plain structs/enums AND all generic instances — exists
// before any body is set; a body may then reference a generic-instance member type
// (`struct Pair { a: Optional[I64] }`) regardless of registration order, since
// LLVMStructSetBody only records element-type *references* (sizes resolve later, at
// emission, by which point all bodies are set).

pub impl LlvmCtx {
    inout fn registerGenStructNames(c: inout Comp) {
        // create every instance's NAMED struct type (opaque, body unset) and record its
        // def. Bodies are set later (registerGenStructBodies) so a field of generic-
        // instance type (an adapter wrapping another: FilterIter's inner = MapIter[…], or
        // an explicit `Optional[I64]` member) resolves to the already-created named type.
        mut val k: U64 = 0
        while k < c.monoWork.genInsts.count() {
            val ref: U64 = c.monoWork.genInsts[k]
            if c.isGenericInst(ref: ref) {
                val t: TypeRef = c.arena.types[ref]
                val defIdx: U64 = c.genericStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
                // an extern generic struct (`Buffer[T]`) is an OPAQUE intrinsic represented
                // as a pointer — it has no struct layout, so register no `%gs` type for it
                // (llvmTypeOfRef returns ptrty for it). Mirrors Array's exclusion.
                if defIdx < c.arena.structs.count() && !(c.arena.structs[defIdx].isExtern) {
                    self.genStructRefs.append(ref)
                    // De-pin: `Array[E]` is an ordinary generic-struct instance — it gets its
                    // own fresh named `%gsN` (body `{ptr}` from its single `data: Buffer[E]`
                    // field, set in the body pass). No name->arrayTy representation pin; every
                    // array site resolves the per-instance type via llvmTypeOfRef/arrayInstTy.
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "gs".bytes())
                    appendU64Dec(into: inout nm, n: k)
                    nm.append(0)
                    self.genStructTys.append(LLVMStructCreateNamed(self.ctx, arrayCPtr(nm)))
                    self.genStructDefs.append(defIdx)
                }
            }
            k += 1
        }
    }

    // Set each struct instance's body (field types under its substitution env; a
    // generic-instance field resolves via fieldLlvmTy -> llvmTypeOfRef to the named type
    // created in registerGenStructNames/registerStructNames). Run after ALL names (plain +
    // generic). A non-generic struct's 0-type-arg instance is bodied here too — its empty env
    // is a no-op, so its fields resolve exactly as a standalone non-generic pass would.
    inout fn registerGenStructBodies(c: inout Comp) {
        mut val s: U64 = 0
        while s < self.genStructRefs.count() {
            val ref: U64 = self.genStructRefs[s]
            val sd: StructDef = c.arena.structs[self.genStructDefs[s]]
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            c.cur.typeParams = sd.typeParams
            c.cur.typeArgs = c.arena.types[ref].args
            mut val elems: Array[LLVMTypeRef] = []
            mut val fi: U64 = 0
            while fi < sd.fields.count() {
                // a boxed (recursive) field is a heap pointer — matching the value built in
                // genFieldValue. Required for a
                // recursive GENERIC value type (`N[I64]` with `next: Optional[N[I64]]`), else
                // the inline layout disagrees with the boxed (ptr) construction value.
                if c.fieldIsBoxed(f: sd.fields[fi]) {
                    elems.append(self.ptrty)
                } else {
                    elems.append(self.fieldLlvmTy(c: inout c, fd: sd.fields[fi]))
                }
                fi += 1
            }
            LLVMStructSetBody(self.genStructTys[s], arrayCPtr(elems), sd.fields.count(), 0I32)
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
            s += 1
        }
    }

    // The per-instance LLVM type of `Array[<elemRef>]` — the registered `%gs` of the array
    // instance whose single element arg is structurally equal to `elemRef` (a SOUND full-ref
    // match, not element-name). Falls back to the shared arrayTy `{ptr}` when that instance
    // was not registered (no Array literal/local/field of it reached mono) — harmless since
    // every Array `%gs` is the same `{ptr}` layout. De-pin: array CONSTRUCTION sites resolve
    // their value's aggregate type through here so it matches the per-instance type used by
    // fields/params/returns (llvmTypeOfRef -> genStructSlot).
    inout fn arrayInstTy(c: inout Comp, elemRef: U64) -> LLVMTypeRef {
        if elemRef != 0U64 {
            // Resolve through the SAME canonical genStructSlot match (full-ref typeRefEq) the
            // type sites use (llvmTypeOfRef -> genStructSlot), so a constructed array VALUE and
            // its field/param/return TYPE pick the identical `%gs` even when the same `Array[E]`
            // was registered more than once (element-only matching could pick a different dup).
            val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
            mut val aargs: Array[U64] = []
            aargs.append(elemRef)
            val aref: U64 = c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs />)
            val gs: U64 = self.genStructSlot(c: inout c, ref: aref)
            if gs < self.genStructRefs.count() {
                return self.genStructTys[gs]
            }
        }
        return self.arrayTy
    }

    // Index into st.genStruct* for the registered instance structurally equal to `ref`,
    // or st.genStructRefs.count().
    inout fn genStructSlot(c: inout Comp, ref: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genStructRefs.count() {
            if c.typeRefEq(a: self.genStructRefs[i], b: ref) {
                return i
            }
            i += 1
        }
        return self.genStructRefs.count()
    }

    // Register each concrete generic-enum instantiation as a named tagged-union type
    // `{ i64 tag, [maxWords(args) x i64] payload }` with type parameters substituted.
    inout fn registerGenEnums(c: inout Comp) {
        mut val k: U64 = 0
        while k < c.monoWork.genInsts.count() {
            val ref: U64 = c.monoWork.genInsts[k]
            if c.isGenericInst(ref: ref) {
                val t: TypeRef = c.arena.types[ref]
                val defIdx: U64 = c.genericEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen)
                if defIdx < c.arena.enums.count() {
                    val e: EnumDef = c.arena.enums[defIdx]
                    val savedP: Array[Bind] = c.cur.typeParams
                    val savedA: Array[U64] = c.cur.typeArgs
                    c.cur.typeParams = e.typeParams
                    c.cur.typeArgs = t.args
                    mut val maxWords: U64 = 0
                    mut val vi: U64 = 0
                    while vi < e.variants.count() {
                        val fs: Array[FieldDef] = e.variants[vi].fields
                        mut val w: U64 = 0
                        mut val fj: U64 = 0
                        while fj < fs.count() {
                            // fieldWordsF (not fieldWords) so a boxed / array / nested
                            // generic-instance payload field is sized correctly under the env.
                            w = w + self.fieldWordsF(c: inout c, f: fs[fj])
                            fj += 1
                        }
                        if w > maxWords {
                            maxWords = w
                        }
                        vi += 1
                    }
                    mut val nm: Array[U8] = []
                    appendBytes(into: inout nm, from: "ge".bytes())
                    appendU64Dec(into: inout nm, n: k)
                    nm.append(0)
                    val ty: LLVMTypeRef = LLVMStructCreateNamed(self.ctx, arrayCPtr(nm))
                    mut val elems: Array[LLVMTypeRef] = []
                    elems.append(self.i64ty)
                    elems.append(LLVMArrayType2(self.i64ty, maxWords))
                    LLVMStructSetBody(ty, arrayCPtr(elems), 2U64, 0I32)
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                    self.genEnumRefs.append(ref)
                    self.genEnumTys.append(ty)
                    self.genEnumDefs.append(defIdx)
                }
            }
            k += 1
        }
    }

    // The tracked TypeRef of an expression (an Ident local's locTypeRef, or a struct
    // field whose declared type is a generic instance), or 0.
    // Does `ref` carry type arguments worth propagating as a TypeRef — a user generic
    // instance / enum, an `any P` existential, a builtin `Array[E]`, or an extern
    // `Ref[T]`/`WeakRef[T]`? These are exactly the heads exprTypeRef yields non-zero for
    // (a plain registered struct or scalar is resolved via exprStructIdx instead).
    inout fn typeRefCarriesArgs(c: inout Comp, ref: U64) -> Bool {
        if ref == 0U64 {
            return false
        }
        if c.isGenericInst(ref: ref) {
            return true
        }
        if refIsAny(c: inout c, ref: ref) {
            return true
        }
        if c.isRefInst(ref: ref) {
            return true
        }
        if c.isWeakRefInst(ref: ref) {
            return true
        }
        val t: TypeRef = c.arena.types[ref]
        return rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array")
    }

    // `g` if it names a concrete lang-item value type (a fixed-width int, a float, Bool, or
    // String) — the "value type" a `print[T]` / assignment inference keys on — else 0. A
    // generic-instance ref is recovered by isGenericInst, a struct/enum by exprStructIdx; this
    // is the single source for the scalar/String tier so every exprTypeRef branch recovers a
    // scalar result uniformly (spec/02, audit-3: print via the real `Format` body).
    inout fn concreteLangItemRef(c: inout Comp, g: U64) -> U64 {
        if g == 0U64 {
            return 0U64
        }
        if g >= c.arena.types.count() {
            return 0U64
        }
        val gn: TypeRef = c.arena.types[g]
        if isPrimIntName(c: inout c, start: gn.nameStart, len: gn.nameLen) {
            return g
        }
        if c.isFloatType(start: gn.nameStart, len: gn.nameLen) {
            return g
        }
        if rangeEquals(bytes: c.arena.bytes, start: gn.nameStart, len: gn.nameLen, kw: "Bool") {
            return g
        }
        if rangeEquals(bytes: c.arena.bytes, start: gn.nameStart, len: gn.nameLen, kw: "String") {
            return g
        }
        return 0U64
    }

    // The concrete lang-item ref of field `(nameStart,nameLen)` on struct `baseSi` when the
    // field's declared type is a scalar / String (`ping.v : I64`), else 0 — resolveField tracks
    // only generic-instance fields, so this recovers the scalar tier for `print(x.f)` inference.
    // `baseRef` is the base's (possibly generic) instance ref: a generic field (`pg.w` where
    // w: T and pg: Pong[I64]) is grounded under it so the param `T` resolves to its concrete
    // scalar (I64), not left un-grounded — otherwise `print` falls back to the front-end typeOf,
    // which recurses on a recursive/mutually-recursive generic scrutinee.
    inout fn scalarFieldRef(c: inout Comp, baseSi: U64, baseRef: U64, nameStart: U64, nameLen: U64) -> U64 {
        if baseSi >= c.arena.structs.count() {
            return 0U64
        }
        val fidx: U64 = structFieldIndex(c: inout c, sidx: baseSi, start: nameStart, len: nameLen)
        if fidx >= c.arena.structs[baseSi].fields.count() {
            return 0U64
        }
        val fd: FieldDef = c.arena.structs[baseSi].fields[fidx]
        if fd.tyIsArray {
            return 0U64
        }
        mut val fr: U64 = c.simpleTypeRef(nameStart: fd.tyStart, nameLen: fd.tyLen)
        if fd.ty != 0U64 {
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val didSet: Bool = self.setInstanceEnv(c: inout c, ref: baseRef)
            val g: U64 = c.groundTypeRef(ref: fd.ty)
            if didSet {
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
            }
            if g != 0U64 {
                fr = g
            }
        }
        return self.concreteLangItemRef(c: inout c, g: fr)
    }

    inout fn exprTypeRef(c: inout Comp, id: U64) -> U64 {
        // a desugared non-Optional `?.` (a Chain rewrite) records its result `Head[U]`; use
        // it so a method call on the result (`(a?.x).chain()` in a nested `a?.x?.y`) resolves
        // its receiver type. Checked first since the node is a generic MatchExpr.
        val cr: U64 = c.chainResultRef(exprId: id)
        if cr != 0U64 {
            return cr
        }
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    return self.locTypeRef[li]
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                // a field of generic-instance / existential type (`node.next : Optional[Node]`):
                // yield the instance ref (grounded under the base env + any active env) so a
                // match on the field read recovers the enum's substitution env. Shared with
                // `->field` (Arrow) via resolveField — one source for field grounding.
                val fbsi: U64 = self.exprStructIdx(c: inout c, id: base)
                val fbref: U64 = self.exprTypeRef(c: inout c, id: base)
                val rf: ResolvedExpr = self.resolveField(c: inout c, baseSi: fbsi, baseRef: fbref, nameStart: nameStart, nameLen: nameLen)
                if rf.typeRef != 0U64 {
                    return rf.typeRef
                }
                val sfr: U64 = self.scalarFieldRef(c: inout c, baseSi: fbsi, baseRef: fbref, nameStart: nameStart, nameLen: nameLen)
                if sfr != 0U64 {
                    return sfr
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // a field through a `Ref` deref (`s->items` with items: Array[E]): the field's
                // (generic-instance or existential) type ref, grounded under the pointee's env,
                // so `s->items[i]` / `s->items.count()` dispatch the Array witness like a local
                // field. Same resolveField helper as Field — `->` and `.` stay in lockstep.
                val absi: U64 = self.refPointeeStructIdx(c: inout c, base: base)
                val abref: U64 = self.refPointeeTypeRef(c: inout c, base: base)
                val rf: ResolvedExpr = self.resolveField(c: inout c, baseSi: absi, baseRef: abref, nameStart: nameStart, nameLen: nameLen)
                if rf.typeRef != 0U64 {
                    return rf.typeRef
                }
                val sfr: U64 = self.scalarFieldRef(c: inout c, baseSi: absi, baseRef: abref, nameStart: nameStart, nameLen: nameLen)
                if sfr != 0U64 {
                    return sfr
                }
            }
            Expr.Deref(val base) => {
                // `*ref` (the pointee place behind `ref->method()`): the pointee TypeRef T of
                // `base: Ref[T]`, so method dispatch resolves on T (a registered struct, an
                // enum, or a generic instance like `Box[I32]`) with the cell as the receiver.
                val r: U64 = self.exprRefTypeRef(c: inout c, id: base)
                if r != 0U64 {
                    val t: TypeRef = c.arena.types[r]
                    if t.args.count() > 0U64 {
                        return t.args[0]
                    }
                }
            }
            Expr.Index(val base, index: _) => {
                // `arr[i]` : the array's element TypeRef (a Ref element `Array[Ref[Box]]`
                // -> `ys[i]->v`, a generic element, or a nested-array element).
                match c.arena.exprs[base] {
                    Expr.Ident(start: val bs, len: val bl) => {
                        val bli: U64 = self.findLocal(c: inout c, start: bs, len: bl)
                        if bli < self.nLocals {
                            return self.locElemTypeRef[bli]
                        }
                    }
                    Expr.Field(base: val fb, nameStart: val fns2, nameLen: val fnl2) => {
                        // an array struct field's element (`hc.items[0]` for
                        // items: Array[Ref[Cell]]): the field's grounded element ref.
                        val bsi: U64 = self.exprStructIdx(c: inout c, id: fb)
                        if bsi < c.arena.structs.count() {
                            val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns2, len: fnl2)
                            if fidx < c.arena.structs[bsi].fields.count() {
                                return self.fieldArrayElemRefUnderBase(c: inout c, base: fb, fd: c.arena.structs[bsi].fields[fidx])
                            }
                        }
                    }
                    _ => {
                        // a nested index (`t[0][0]`): unwrap one Array level from the base
                        // array's element type ref.
                        val br: U64 = self.exprTypeRef(c: inout c, id: base)
                        if br != 0U64 {
                            val bt: TypeRef = c.arena.types[br]
                            if rangeEquals(bytes: c.arena.bytes, start: bt.nameStart, len: bt.nameLen, kw: "Array") {
                                if bt.args.count() > 0U64 {
                                    return bt.args[0]
                                }
                            }
                        }
                    }
                }
            }
            Expr.Array(val elems) => {
                // an array literal `[e0, …]` : its `Array[E]` instance ref (E = first
                // element's type), so a direct index / method / `for` over the literal rides
                // the same Index/Iterator/generic witnesses as a bound array — no literal
                // type-name special case (collections.md E3).
                val er: U64 = self.arrayLitElemRef(c: inout c, elems: elems)
                if er != 0U64 {
                    val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
                    mut val aargs: Array[U64] = []
                    aargs.append(er)
                    return c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs />)
                }
            }
            Expr.OptChain(val base, val memberStart, val memberLen) => {
                // `base?.member : Optional[U]` — so a chained `a?.b?.c` types its inner.
                return self.optChainResultRefLL(c: inout c, base: base, memberStart: memberStart, memberLen: memberLen)
            }
            Expr.ExtView(val recv, val srcStart, val srcLen, val strip) => {
                // `recv#Ext` : recv's type refined with the extension view (viewExtId);
                // `recv#!Ext` (strip) removes the view (the result type is plain).
                mut val vid: U64 = intern(c: inout c, start: srcStart, len: srcLen)
                if strip {
                    vid = 0U64
                }
                val br: U64 = self.exprTypeRef(c: inout c, id: recv)
                if br != 0U64 {
                    val bt: TypeRef = c.arena.types[br]
                    return c.pushType(t: <TypeRef nameStart=bt.nameStart nameLen=bt.nameLen args=bt.args viewExtId=vid />)
                }
                val si: U64 = self.exprStructIdx(c: inout c, id: recv)
                if si < c.arena.structs.count() {
                    mut val noArgs: Array[U64] = []
                    return c.pushType(t: <TypeRef nameStart=c.arena.structs[si].nameStart nameLen=c.arena.structs[si].nameLen args=noArgs viewExtId=vid />)
                }
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                // a method result's TypeRef — an `any P` requirement return, a lazy adapter
                // instance (`xs.map(f)`), or a general grounded `methodResultRef` (`d.get(k) ->
                // Optional[V]`). Via the shared resolver so exprStructIdx/exprTypeRef/exprIsArray
                // agree on the Method form (see resolveMethod).
                val rc: ResolvedExpr = self.resolveMethod(c: inout c, id: id)
                if rc.typeRef != 0U64 {
                    return rc.typeRef
                }
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                // `pow(base: x, exp: n)` (spec/12) yields the base type's `Pow` Output — the
                // base type itself for the integer conformances, but a distinct `type Output`
                // for a user conformance (`Sq.pow -> I64`). Resolve the base's `pow` assoc and
                // read its return type (mirrors genPowCall) so a `print(pow(base: s, …))` / an
                // assignment recovers the true result type, not just the base. Fall back to the
                // base arg's type when the assoc cannot be resolved.
                if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "pow") {
                    if args.count() == 2U64 {
                        val br: U64 = self.llvmArgTypeRef(c: inout c, argExpr: args[0].expr)
                        if br != 0U64 {
                            val bt: TypeRef = c.arena.types[br]
                            val powN: Bind = c.kwSpan(kw: "pow", kwLen: 3U64)
                            val afi: U64 = c.findAssoc(recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: powN.nameStart, nameLen: powN.nameLen, args: args)
                            if afi < c.arena.funcs.count() {
                                if c.arena.funcs[afi].retTy != 0U64 {
                                    return c.arena.funcs[afi].retTy
                                }
                            }
                        }
                        return br
                    }
                }
                // a free call's grounded return TypeRef when it carries type args: an
                // `Array[E]` (`mk().count()`/`mk()[i]`), a `Ref[T]` (`mk()->m()`), a generic
                // instance, or an `any P`; a concrete scalar/String keeps its ref; a bare
                // non-generic struct yields 0 (resolved via exprStructIdx). One shared resolver
                // with exprStructIdx/exprIsArray so the Call form can't drift (see resolveCall).
                val rc: ResolvedExpr = self.resolveCall(c: inout c, id: id)
                if rc.typeRef != 0U64 {
                    return rc.typeRef
                }
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, val ty, fields: _) => {
                // a generic struct/enum construction (`<Box[I32] …/>`): its instance ref
                // (grounded under any active env), so a field access / chained method on the
                // freshly-built value recovers the substitution env. A non-generic build has no
                // instance ref to track (its struct is found by name), so → 0.
                if ty != 0U64 {
                    mut val g: U64 = ty
                    if c.cur.typeParams.count() > 0U64 {
                        g = c.groundTypeRef(ref: ty)
                    }
                    if c.isGenericInst(ref: g) {
                        return g
                    }
                }
            }
            // a value-position `if`/`match`: its TypeRef is a (non-diverging) branch's `give`
            // type (every branch has the same type) — delegate so a generic branch recovers its
            // instance ref and a scalar branch yields 0, like a plain expr.
            Expr.IfExpr(cond: _, val thenBlk, elseBlk: _) => {
                val gv: U64 = c.blockGiveExpr(blkId: thenBlk)
                if gv < c.arena.exprs.count() {
                    return self.exprTypeRef(c: inout c, id: gv)
                }
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count() {
                    if !(arms[ai].isDiverge) {
                        val gv: U64 = c.blockGiveExpr(blkId: arms[ai].body)
                        if gv < c.arena.exprs.count() {
                            return self.exprTypeRef(c: inout c, id: gv)
                        }
                    }
                    ai += 1
                }
            }
            // `move x` / `borrow x` evaluates to the operand's value, so its TypeRef is the
            // operand's.
            Expr.Move(val operand, isBorrow: _) => {
                return self.exprTypeRef(c: inout c, id: operand)
            }
            // --- exprs carrying no tracked (generic-instance / existential) TypeRef: the front-end
            // `exprType` carries their actual (primitive / closure / witness-return) type; this
            // backend resolver only tracks generic-instance refs, so the correct answer is 0.
            // No `_` catch-all: every Expr variant is classified so a new one forces a decision.
            Expr.Int(value: _, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => {}
            Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => {}
            Expr.Str(start: _, len: _) => {}
            Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => {}
            // a unary/binary operator result: the witness fn's return type drives chaining via
            // exprStructIdx; in every exercised case it is concrete (not a generic instance), so
            // no instance ref to track here → 0.
            Expr.Unary(op: _, operand: _) => {}
            Expr.Binary(op: _, lhs: _, rhs: _) => {}
            // `x as T` where T is a generic instance (`x as Box[I32]`): its instance ref, so a
            // chained method on the cast result recovers the env. A scalar/plain-struct cast has
            // no tracked instance ref → 0 (resolved via exprStructIdx).
            Expr.Cast(operand: _, val tyStart, val tyLen, val ty) => {
                if c.isGenericInst(ref: ty) {
                    return ty
                }
                // a scalar / String cast (`u as String`, `n as I64`): its result type is the
                // cast target, so `print(x as String)` recovers T. Build the ref from the target
                // span when `ty` is unset (a bare non-generic cast carries no TypeRef).
                mut val cref: U64 = ty
                if cref == 0U64 {
                    if tyLen > 0U64 {
                        cref = c.simpleTypeRef(nameStart: tyStart, nameLen: tyLen)
                    }
                }
                val cr: U64 = self.concreteLangItemRef(c: inout c, g: cref)
                if cr != 0U64 {
                    return cr
                }
            }
            // `try e` (e: Result[T,E]): the unwrapped value is a T — its instance ref when T is
            // a generic instance, so `(try mk()).method()` on a generic payload recovers the env.
            // Couples to @Std/Core's Result shape (Ok payload = the first type arg).
            Expr.Try(val expr) => {
                val er: U64 = self.exprTypeRef(c: inout c, id: expr)
                if er != 0U64 {
                    val rt: TypeRef = c.arena.types[er]
                    if rt.args.count() > 0U64 {
                        if c.isGenericInst(ref: rt.args[0]) {
                            return rt.args[0]
                        }
                    }
                }
            }
            // `await p` resolves to a non-tracked value in every exercised case (statement-head
            // only today) → 0. NOTE (latent gap, mirrors exprStructIdx): a generic-instance-
            // producing `(await p)` isn't recovered yet; kept explicit (not `_`) so a new Expr
            // variant still forces a decision.
            Expr.Await(operand: _) => {}
            // `recv#Ext.m(args)`: resolve the extension method (via the shared resolution used by
            // emission), ground its return under the receiver's instance env, and return the
            // grounded generic instance or scalar/String/Bool ref — so `print(x#Ext.m())` recovers
            // the result type for `print[T]` inference, mirroring the plain-method branch.
            Expr.ExtMethod(val recv, val srcStart, val srcLen, val nameStart, val nameLen, val args) => {
                mut val rns: U64 = 0
                mut val rnl: U64 = 0
                val mfi: U64 = self.resolveExtMethodMfi(c: inout c, recv: recv, srcStart: srcStart, srcLen: srcLen, nameStart: nameStart, nameLen: nameLen, args: args, recvNameStart: inout rns, recvNameLen: inout rnl, report: false)
                if mfi < c.arena.funcs.count() {
                    val mf: Func = c.arena.funcs[mfi]
                    if mf.hasRet {
                        if mf.retTy != 0U64 {
                            val savedP: Array[Bind] = c.cur.typeParams
                            val savedA: Array[U64] = c.cur.typeArgs
                            val didSet: Bool = self.setInstanceEnv(c: inout c, ref: self.exprTypeRef(c: inout c, id: recv))
                            val g: U64 = c.groundTypeRef(ref: mf.retTy)
                            if didSet {
                                c.cur.typeParams = savedP
                                c.cur.typeArgs = savedA
                            }
                            if c.isGenericInst(ref: g) {
                                return g
                            }
                            val gcr: U64 = self.concreteLangItemRef(c: inout c, g: g)
                            if gcr != 0U64 {
                                return gcr
                            }
                        }
                    }
                }
            }
        }
        return 0U64
    }

    // The grounded result TypeRef of a non-adapter method call `recv.m(args)`: find the
    // method on the receiver's (possibly generic) type and ground its declared return
    // type under the receiver instance's env, yielding the generic instance the result
    // is (e.g. `Optional[I64]` for `dict[String,I64].get(k)`). 0 when the receiver type
    // or method can't be resolved or the return isn't a generic instance — so a plain
    // (non-generic) return leaves the caller's behavior unchanged.
    inout fn methodResultRef(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, margs: Array[Arg]) -> U64 {
        // (a String-kind receiver — plain String, newtype over String, or a String-valued
        // subscript like `dict[k]` — resolves as the registered String struct via the
        // exprStructIdx fallback below, so `s.bytes()`'s `Array[U8]` return is recovered on
        // the normal path; String has no type params, so its declared return ref is concrete.)
        val recvRef: U64 = self.exprTypeRef(c: inout c, id: recv)
        mut val headStart: U64 = 0
        mut val headLen: U64 = 0
        if recvRef != 0U64 {
            headStart = c.arena.types[recvRef].nameStart
            headLen = c.arena.types[recvRef].nameLen
        } else {
            val si: U64 = self.exprStructIdx(c: inout c, id: recv)
            if si < c.arena.structs.count() {
                headStart = c.arena.structs[si].nameStart
                headLen = c.arena.structs[si].nameLen
            } else {
                return 0U64
            }
        }
        // a newtype head (`UserId = String`) inherits the underlying's members (spec/10), so
        // resolve to the underlying name before lookup — `u.bytes()` finds String's `bytes`.
        // (recvRef stays the newtype ref for grounding; a newtype has no type params, so this
        // is a no-op for the env.)
        val ntu: Bind = c.newtypeUnderName(start: headStart, len: headLen)
        headStart = ntu.nameStart
        headLen = ntu.nameLen
        // resolve view-aware (an extension/conformance method reached through a view on the
        // receiver's binding, `val sa = s#A; print(sa.a())`), mirroring genLlvmMethod so
        // `print[T]` infers T from an extension-method result too; report:false since emission
        // reports any ambiguity.
        val mfi: U64 = self.resolveMethodMfi(c: inout c, recv: recv, recvStart: headStart, recvLen: headLen, nameStart: nameStart, nameLen: nameLen, args: margs, report: false)
        if mfi < c.arena.funcs.count() {
            val mf: Func = c.arena.funcs[mfi]
            if mf.hasRet {
                // a provided trait method (an Iterator terminal `count()` / `any()` / `all()`)
                // carries only its return SPAN, not a built `retTy` — rebuild the ref from the
                // span so `print(it.count())` infers `T = U64` too. A method-own type-param
                // return (`fold[B] -> B`) rebuilds to the un-grounded param and resolves to 0
                // below (grounded from the args elsewhere); an array return is left to the
                // generic path (retIsArray → no scalar ref).
                mut val mrt: U64 = mf.retTy
                if mrt == 0U64 {
                    if !(mf.retIsArray) {
                        if mf.retLen > 0U64 {
                            mrt = c.simpleTypeRef(nameStart: mf.retStart, nameLen: mf.retLen)
                        }
                    }
                }
                if mrt != 0U64 {
                    val savedP: Array[Bind] = c.cur.typeParams
                    val savedA: Array[U64] = c.cur.typeArgs
                    // the receiver may be a struct, an enum (`Loaded[Box].chain()` — an enum
                    // Chain conformer), OR an opaque Ref/WeakRef (`w.upgrade() -> Optional[Ref[T]]`):
                    // set whichever instance env grounds its type params.
                    val didSet: Bool = self.setInstanceEnv(c: inout c, ref: recvRef)
                    mut val touched: Bool = didSet
                    // a method-own type-param return (`fold[B] -> B`): infer the own type args
                    // from the call and layer them on top of the receiver env, so the own
                    // param (`B`, the accumulator) grounds to its concrete type (the `init:`
                    // arg's) — mirroring genMethodOwnTypeParamCall's env. Without this, a
                    // `print(it.fold(init: 0U64, …))` leaves `B` un-grounded and can't infer T.
                    if mf.typeParams.count() > 0U64 {
                        val ownArgs: Array[U64] = self.llvmInferFnArgs(c: inout c, f: mf, args: margs)
                        c.cur.typeParams = concatParams(add: mf.typeParams, base: c.cur.typeParams)
                        c.cur.typeArgs = concatArgs(add: ownArgs, base: c.cur.typeArgs)
                        touched = true
                    }
                    val g: U64 = c.groundTypeRef(ref: mrt)
                    if touched {
                        c.cur.typeParams = savedP
                        c.cur.typeArgs = savedA
                    }
                    if c.isGenericInst(ref: g) {
                        return g
                    }
                    // a concrete scalar / String / Bool return (`.count() -> U64`,
                    // `.isEmpty() -> Bool`, `.p() -> I64`, `.fold() -> U64`): return its ref too,
                    // so a `print(recv.m())` recovers the result type for `print[T]` inference.
                    // (Existing callers act only on generic-instance / Ref refs, so a scalar ref
                    // is a no-op for them; the type-param `Self`/`Item` cases already grounded
                    // above via setInstanceEnv, so `g` here names a concrete type.)
                    val gcr: U64 = self.concreteLangItemRef(c: inout c, g: g)
                    if gcr != 0U64 {
                        return gcr
                    }
                }
            }
        }
        return 0U64
    }

    // The `Optional[U]` result-type ref of `base?.member`, resolved through the
    // LLVM-side type tracker (exprTypeRef) rather than the typed-AST cache (typeOf,
    // unpopulated in this backend). Returns 0 if base isn't a concrete Optional whose
    // element struct has the named field.
    inout fn optChainResultRefLL(c: inout Comp, base: U64, memberStart: U64, memberLen: U64) -> U64 {
        val baseRef: U64 = self.exprTypeRef(c: inout c, id: base)
        if baseRef == 0U64 { return 0U64 }
        if baseRef >= c.arena.types.count() {
            return 0U64
        }
        val bt: TypeRef = c.arena.types[baseRef]
        if !(rangeEquals(bytes: c.arena.bytes, start: bt.nameStart, len: bt.nameLen, kw: "Optional")) {
            return 0U64
        }
        if bt.args.count() < 1U64 { return 0U64 }
        val tName: TypeRef = c.arena.types[bt.args[0]]
        val tSidx: U64 = c.structIndexByName(start: tName.nameStart, len: tName.nameLen)
        if tSidx >= c.arena.structs.count() {
            return 0U64
        }
        val fidx: U64 = structFieldIndex(c: inout c, sidx: tSidx, start: memberStart, len: memberLen)
        if fidx >= c.arena.structs[tSidx].fields.count() {
            return 0U64
        }
        val fd: FieldDef = c.arena.structs[tSidx].fields[fidx]
        mut val uRef: U64 = fd.ty
        if uRef == 0U64 {
            val noArgs: Array[U64] = []
            uRef = c.pushType(t: <TypeRef nameStart=fd.tyStart nameLen=fd.tyLen args=noArgs />)
        }
        mut val rArgs: Array[U64] = []
        rArgs.append(uRef)
        return c.pushType(t: <TypeRef nameStart=bt.nameStart nameLen=bt.nameLen args=rArgs />)
    }
}

pub impl LlvmCtx {

    // If `ref` is a generic enum instance, set the substitution env to it and return
    // the saved-params (so the caller restores). Returns an empty saved env otherwise.
    // Pairs with restoreEnv. Encoded via the inout saved arrays.
    inout fn setEnumEnv(c: inout Comp, ref: U64) -> Bool {
        if ref == 0U64 {
            return false
        }
        val ge: U64 = self.genEnumSlot(c: inout c, ref: ref)
        if ge < self.genEnumRefs.count() {
            c.cur.typeParams = c.arena.enums[self.genEnumDefs[ge]].typeParams
            c.cur.typeArgs = c.arena.types[ref].args
            return true
        }
        return false
    }

    // If `ref` is a generic struct instance, set the substitution env to it (so a
    // destructured field of type `T` grounds to the instance's concrete arg). Returns
    // whether it set the env (caller restores). Mirrors setEnumEnv for structs.
    inout fn setStructEnv(c: inout Comp, ref: U64) -> Bool {
        if ref == 0U64 {
            return false
        }
        val gs: U64 = self.genStructSlot(c: inout c, ref: ref)
        if gs < self.genStructRefs.count() {
            c.cur.typeParams = c.arena.structs[self.genStructDefs[gs]].typeParams
            c.cur.typeArgs = c.arena.types[ref].args
            return true
        }
        return false
    }

    // If `ref` is a `Ref[T]` / `WeakRef[T]` instance, set the substitution env from the
    // (opaque extern) def's type param to the instance's concrete arg — so a method's
    // `Optional[Ref[T]]` return (`WeakRef.upgrade`) grounds T to the pointee. Ref/WeakRef
    // are opaque externs, so they have no genStruct/genEnum slot and setStructEnv/setEnumEnv
    // miss them; the def (with its typeParams) is still in arena.structs.
    inout fn setRefLikeEnv(c: inout Comp, ref: U64) -> Bool {
        if ref == 0U64 {
            return false
        }
        if c.isRefInst(ref: ref) || c.isWeakRefInst(ref: ref) {
            val t: TypeRef = c.arena.types[ref]
            val di: U64 = c.genericStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
            if di < c.arena.structs.count() {
                c.cur.typeParams = c.arena.structs[di].typeParams
                c.cur.typeArgs = t.args
                return true
            }
        }
        return false
    }

    // Set the substitution env from ANY generic instance `ref` — struct, enum, or the opaque
    // Ref/WeakRef externs — to its concrete args. The single env-setup so callers that ground a
    // method/field result under "the receiver's instance" don't each re-implement the kind
    // cascade and drift (the resolveField lesson). Returns whether it set the env (caller
    // restores).
    inout fn setInstanceEnv(c: inout Comp, ref: U64) -> Bool {
        if self.setStructEnv(c: inout c, ref: ref) {
            return true
        }
        if self.setEnumEnv(c: inout c, ref: ref) {
            return true
        }
        return self.setRefLikeEnv(c: inout c, ref: ref)
    }

    // Index into st.genEnum* for the registered instance structurally equal to `ref`.
    inout fn genEnumSlot(c: inout Comp, ref: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genEnumRefs.count() {
            if c.typeRefEq(a: self.genEnumRefs[i], b: ref) {
                return i
            }
            i += 1
        }
        return self.genEnumRefs.count()
    }
}
