// Part of the LLVM backend (root: _.pw): generic struct / enum instance registration and slot assignment.

// ---- generic struct instances ----

// Named layouts consume the closed frontend type contracts.

pub impl LlvmCtx {
    // All finalized struct instances enter through this method.
    // Publish the slot before any recursive body construction can query it.
    inout fn registerStructInstance(typeRef: U64, llvmType: LLVMTypeRef, structIndex: U64) {
        self.genStructRefs.append(typeRef)
        self.genStructTys.append(llvmType)
        self.genStructDefs.append(structIndex)
    }

    // Finalized contract identities index physical slots directly. Newtypes
    // follow their explicit representation edge, never a declaration lookup.
    inout fn physicalLayoutContract(c: inout Comp, typeRef: U64) -> U64 {
        val identity = c.requireFinalDestruction(typeRef: typeRef)
        val contract = c.arena.finalDestructions[identity - 1U64]
        if contract.underlying != 0U64 { return self.physicalLayoutContract(c: inout c, typeRef: contract.underlying) }
        return identity
    }

    inout fn requireStructLayoutSlot(c: inout Comp, typeRef: U64) -> U64 {
        val identity = self.physicalLayoutContract(c: inout c, typeRef: typeRef)
        if identity > self.finalStructSlots.count() || self.finalStructSlots[identity - 1U64] == 0U64 {
            c.errorAt(offset: 0U64, msg: "internal error: finalized struct has no LLVM layout slot")
            return self.genStructRefs.count()
        }
        return self.finalStructSlots[identity - 1U64] - 1U64
    }

    inout fn requireEnumLayoutSlot(c: inout Comp, typeRef: U64) -> U64 {
        val identity = self.physicalLayoutContract(c: inout c, typeRef: typeRef)
        if identity > self.finalEnumSlots.count() || self.finalEnumSlots[identity - 1U64] == 0U64 {
            c.errorAt(offset: 0U64, msg: "internal error: finalized enum has no LLVM layout slot")
            return self.genEnumRefs.count()
        }
        return self.finalEnumSlots[identity - 1U64] - 1U64
    }

    // Only finalized reachable types can enter LLVM. Publish all names before
    // filling any struct body so mutually recursive boxed layouts are valid.
    inout fn registerFinalLayoutNames(c: inout Comp) {
        mut val index = 0U64
        while index < c.arena.finalDestructions.count() {
            val contract = c.arena.finalDestructions[index]
            self.finalStructSlots.append(0U64)
            self.finalEnumSlots.append(0U64)
            if !contract.ready {
                c.errorAt(offset: 0U64, msg: "internal error: LLVM layout registration requires a finalized type contract")
                return
            }
            if contract.underlying == 0U64 {
                if contract.structLayout != 0U64 {
                    mut val name: Array[U8] = []
                    appendBytes(into: inout name, from: "st".bytes())
                    appendU64Dec(into: inout name, n: index)
                    name.append(0U8)
                    self.finalStructSlots[index] = self.genStructRefs.count() + 1U64
                    self.registerStructInstance(typeRef: contract.typeRef, llvmType: LLVMStructCreateNamed(self.ctx, arrayCPtr(name)), structIndex: contract.structLayout - 1U64)
                } else {
                    match contract.ownershipClass {
                        ArcClass.EnumVal(eidx: val declaration) => {
                            mut val name: Array[U8] = []
                            appendBytes(into: inout name, from: "en".bytes())
                            appendU64Dec(into: inout name, n: index)
                            name.append(0U8)
                            val type = LLVMStructCreateNamed(self.ctx, arrayCPtr(name))
                            mut val fields: Array[LLVMTypeRef] = []
                            fields.append(self.i64ty)
                            fields.append(LLVMArrayType2(self.i64ty, self.enumPayloadWords(c: inout c, typeRef: contract.typeRef)))
                            LLVMStructSetBody(type, arrayCPtr(fields), fields.count(), 0I32)
                            self.finalEnumSlots[index] = self.genEnumRefs.count() + 1U64
                            self.genEnumRefs.append(contract.typeRef)
                            self.genEnumTys.append(type)
                            self.genEnumDefs.append(declaration)
                        }
                        _ => {}
                    }
                }
            }
            index += 1U64
        }
    }

    inout fn registerFinalStructBodies(c: inout Comp) {
        mut val slot = 0U64
        while slot < self.genStructRefs.count() {
            val contract = c.arena.finalDestructions[c.requireFinalDestruction(typeRef: self.genStructRefs[slot]) - 1U64]
            if contract.fieldTypes.count() != contract.fieldBoxed.count() {
                c.errorAt(offset: 0U64, msg: "internal error: finalized struct layout has inconsistent fields")
                return
            }
            mut val fields: Array[LLVMTypeRef] = []
            mut val field = 0U64
            while field < contract.fieldTypes.count() {
                if contract.fieldBoxed[field] { fields.append(self.ptrty) }
                else { fields.append(self.llvmTypeOfRef(c: inout c, ref: contract.fieldTypes[field])) }
                field += 1U64
            }
            LLVMStructSetBody(self.genStructTys[slot], arrayCPtr(fields), fields.count(), 0I32)
            slot += 1U64
        }
    }

}
