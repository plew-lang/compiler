// Part of the LLVM backend (root: _.pw): generic struct / enum instance registration and slot assignment.

// ---- generic struct instances ----

// Named layouts consume the closed frontend type contracts.

pub impl LlvmCtx {
    // All finalized struct instances enter through this method.
    // Publish the slot before any recursive body construction can query it.
    inout fn registerStructInstance(c: inout Comp, typeRef: U64, llvmType: LLVMTypeRef, structIndex: U64) {
        val slot: U64 = self.genStructRefs.count()
        self.genStructRefs.append(typeRef)
        self.genStructTys.append(llvmType)
        self.genStructDefs.append(structIndex)
        if c.arena.typeAt(index: typeRef).args.count() == 0U64 {
            while self.zeroArgStructSlots.count() <= structIndex {
                self.zeroArgStructSlots.append(0U64)
            }
            if self.zeroArgStructSlots[structIndex] == 0U64 {
                self.zeroArgStructSlots[structIndex] = slot + 1U64
            }
        }
    }

    // The first registered zero-argument instance, or the CURRENT count on a miss.
    // Generic instances sharing the same definition never populate this index.
    fn structSlotForSidx(structIndex: U64) -> U64 {
        if structIndex < self.zeroArgStructSlots.count() {
            val entry: U64 = self.zeroArgStructSlots[structIndex]
            if entry != 0U64 { return entry - 1U64 }
        }
        return self.genStructRefs.count()
    }

    // Only finalized reachable types can enter LLVM. Publish all names before
    // filling any struct body so mutually recursive boxed layouts are valid.
    inout fn registerFinalLayoutNames(c: inout Comp) {
        mut val index = 0U64
        while index < c.arena.finalDestructions.count() {
            val contract = c.arena.finalDestructions[index]
            if !contract.ready {
                c.errorAt(offset: 0U64, msg: "internal error: LLVM layout registration requires a finalized type contract")
                return
            }
            if contract.underlying == 0U64 {
                if contract.structLayout != 0U64 {
                    mut val name: Array[U8] = []
                    appendBytes(into: inout name, from: "st".bytes())
                    appendU64Dec(into: inout name, n: index)
                    name.append(0U8)
                    self.registerStructInstance(c: inout c, typeRef: contract.typeRef, llvmType: LLVMStructCreateNamed(self.ctx, arrayCPtr(name)), structIndex: contract.structLayout - 1U64)
                } else {
                    match contract.ownershipClass {
                        ArcClass.EnumVal(eidx: val declaration) => {
                            mut val name: Array[U8] = []
                            appendBytes(into: inout name, from: "en".bytes())
                            appendU64Dec(into: inout name, n: index)
                            name.append(0U8)
                            val type = LLVMStructCreateNamed(self.ctx, arrayCPtr(name))
                            mut val fields: Array[LLVMTypeRef] = []
                            fields.append(self.i64ty)
                            fields.append(LLVMArrayType2(self.i64ty, self.enumPayloadWords(c: inout c, typeRef: contract.typeRef)))
                            LLVMStructSetBody(type, arrayCPtr(fields), fields.count(), 0I32)
                            self.genEnumRefs.append(contract.typeRef)
                            self.genEnumTys.append(type)
                            self.genEnumDefs.append(declaration)
                        }
                        _ => {}
                    }
                }
            }
            index += 1U64
        }
    }

    inout fn registerFinalStructBodies(c: inout Comp) {
        mut val slot = 0U64
        while slot < self.genStructRefs.count() {
            val contract = c.arena.finalDestructions[c.requireFinalDestruction(typeRef: self.genStructRefs[slot]) - 1U64]
            if contract.fieldTypes.count() != contract.fieldBoxed.count() {
                c.errorAt(offset: 0U64, msg: "internal error: finalized struct layout has inconsistent fields")
                return
            }
            mut val fields: Array[LLVMTypeRef] = []
            mut val field = 0U64
            while field < contract.fieldTypes.count() {
                if contract.fieldBoxed[field] { fields.append(self.ptrty) }
                else { fields.append(self.llvmTypeOfRef(c: inout c, ref: contract.fieldTypes[field])) }
                field += 1U64
            }
            LLVMStructSetBody(self.genStructTys[slot], arrayCPtr(fields), fields.count(), 0I32)
            slot += 1U64
        }
    }

    // The per-instance LLVM type of `Array[<elemRef>]` — the registered `%gs` of the array
    // instance whose single element arg is structurally equal to `elemRef` (a SOUND full-ref
    // match, not element-name). Falls back to the shared arrayTy `{ptr}` when that instance
    // was not registered (no Array literal/local/field of it reached mono) — harmless since
    // every Array `%gs` is the same `{ptr}` layout. De-pin: array CONSTRUCTION sites resolve
    // their value's aggregate type through here so it matches the per-instance type used by
    // fields/params/returns (llvmTypeOfRef -> genStructSlot).
    inout fn arrayInstTy(c: inout Comp, elemRef: U64) -> LLVMTypeRef {
        if elemRef != 0U64 {
            // Resolve through the SAME canonical genStructSlot match (full-ref typeRefEq) the
            // type sites use (llvmTypeOfRef -> genStructSlot), so a constructed array VALUE and
            // its field/param/return TYPE pick the identical `%gs` even when the same `Array[E]`
            // was registered more than once (element-only matching could pick a different dup).
            val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
            mut val aargs: Array[U64] = []
            aargs.append(elemRef)
            val aref: U64 = c.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=aargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
            val gs: U64 = self.genStructSlot(c: inout c, ref: aref)
            if gs < self.genStructRefs.count() {
                return self.genStructTys[gs]
            }
        }
        return self.arrayTy
    }

    // Lookup never discovers new semantic types during LLVM emission.
    inout fn genStructSlot(c: inout Comp, ref: U64) -> U64 {
        // A top-level view selects a method surface, never a physical layout.
        // Preserve views inside type arguments: those belong to the instance.
        val storageRef: U64 = c.typeRefWithoutOuterViews(ref: ref)
        val i: U64 = self.genStructSlotRaw(c: inout c, ref: storageRef)
        if i < self.genStructRefs.count() {
            return i
        }
        return self.genStructRefs.count()
    }

    inout fn genStructSlotRaw(c: inout Comp, ref: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genStructRefs.count() {
            if c.typeRefEq(a: self.genStructRefs[i], b: ref) {
                return i
            }
            i += 1
        }
        return self.genStructRefs.count()
    }
}

pub impl LlvmCtx {

    // Index into st.genEnum* for the registered instance structurally equal to `ref`.
    // A miss does not extend the frontend reachability closure.
    inout fn genEnumSlot(c: inout Comp, ref: U64) -> U64 {
        // A top-level view selects a method surface, never a physical layout.
        // Preserve views inside type arguments: those belong to the instance.
        val storageRef: U64 = c.typeRefWithoutOuterViews(ref: ref)
        val i: U64 = self.genEnumSlotRaw(c: inout c, ref: storageRef)
        if i < self.genEnumRefs.count() {
            return i
        }
        return self.genEnumRefs.count()
    }

    inout fn genEnumSlotRaw(c: inout Comp, ref: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.genEnumRefs.count() {
            if c.typeRefEq(a: self.genEnumRefs[i], b: ref) {
                return i
            }
            i += 1
        }
        return self.genEnumRefs.count()
    }
}
