// Part of the LLVM backend (root: _.pw): closure-call typing, pow, and the general call dispatcher.

// ---- call emission ----
//
// Consume Mono's final callee and lower it. Backend never resolves a source name.
// The LLVM function type of a `fn(...) -> R` TypeRef under the closure ABI: env
// pointer first, then the declared params, returning R (void for a `()` return).
// fn TypeRef args = [retTy, paramTy0, paramTy1, ...].

pub impl LlvmCtx {
    inout fn closureLlvmFnTy(c: inout Comp, fnRef: U64) -> LLVMTypeRef {
        val t: TypeRef = c.arena.types[fnRef]
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        mut val i: U64 = 1
        while i < t.args.count() {
            ptys.append(self.llvmTypeOfRef(c: inout c, ref: t.args[i]))
            i += 1
        }
        mut val rty: LLVMTypeRef = self.voidty
        if t.args.count() > 0U64 {
            val rt: TypeRef = c.arena.types[t.args[0]]
            // a `()` return (the unnamed unit record) is void; any named type is a value.
            if rt.nameLen != 0U64 {
                rty = self.llvmTypeOfRef(c: inout c, ref: t.args[0])
            }
        }
        return LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count(), 0I32)
    }

    // Emit an indirect call of a closure VALUE (the {fn, env} aggregate) of type fnRef:
    // extract the function pointer + environment, then call fn(env, coerced-args...).
    inout fn emitClosureCallValue(c: inout Comp, cloVal: LLVMValueRef, fnRef: U64, args: Array[Arg]) -> LLVMValueRef {
        val fnPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, cloVal, 0U64, anon())
        val env: LLVMValueRef = LLVMBuildExtractValue(self.b, cloVal, 1U64, anon())
        val fty: LLVMTypeRef = self.closureLlvmFnTy(c: inout c, fnRef: fnRef)
        val ft: TypeRef = c.arena.types[fnRef]
        mut val av: Array[LLVMValueRef] = []
        av.append(env)
        mut val i: U64 = 0
        while i < args.count() {
            mut val v: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[i].expr)
            // coerce an int arg to the declared param width (fn args = [ret, p0, p1, …]).
            if i + 1U64 < ft.args.count() {
                if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
                    val pt: TypeRef = c.arena.types[ft.args[i + 1U64]]
                    v = self.coerceInt(v: v, target: self.llvmTypeOfRef(c: inout c, ref: ft.args[i + 1U64]), unsigned: isUnsignedName(c: inout c, start: pt.nameStart, len: pt.nameLen))
                }
            }
            // same Swift-guaranteed (+0) convention as genArgValueV's by-value tail: a
            // PLACE arg is a borrow (the closure param takes no ownership — spec/14),
            // and a TEMPORARY (construction / call result / literal) has no home
            // binding, so it gets an anonymous owned local and the statement-end drain
            // releases it. A closure fn type has no move/inout params, so the by-value
            // story is the whole story here.
            if !(exprAliasesPlace(c: inout c, id: args[i].expr)) {
                mut val ttr: U64 = self.argValueTypeRef(c: inout c, argExpr: args[i].expr)
                if ttr == 0U64 {
                    // a context-typed literal records no type of its own — classify by
                    // the fn type's declared param (the value's contract type).
                    if i + 1U64 < ft.args.count() {
                        ttr = ft.args[i + 1U64]
                    }
                }
                self.registerArgTemp(c: inout c, v: v, typeRef: ttr)
            }
            av.append(v)
            i += 1
        }
        return LLVMBuildCall2(self.b, fty, fnPtr, arrayCPtr(av), av.count(), anon())
    }

    // Emit a resolved non-receiver call — an ordinary free function or an
    // associated callable.  Both use the `gf` ABI, but an associated callable
    // additionally has a concrete subject in its final descriptor.  Keeping
    // that receiver in the instance key is essential for trait witnesses such
    // as `pow(base:, exp:)`; LLVM must not infer or erase it from the bare-call
    // syntax.
    inout fn genLlvmResolvedCallableCall(c: inout Comp, callId: U64, cfi: U64, args: Array[Arg], recvInstRef: U64, callOffset: U64) -> LLVMValueRef {
        // Type inference is a frontend/Mono decision.  The exact substitutions
        // selected there travel with the final callable; LLVM must never repeat
        // unification against the shared AST.
        val inferred: Array[U64] = c.bodyCalleeTypeArgs(exprId: callId)
        val cf0: Func = c.arena.funcs[cfi]
        // Async callees are declared by the entry/resume pipeline, not the
        // ordinary `gf` table.  Select that already-finalized entry before
        // consulting `ensureFnInst`; otherwise the latter quite correctly
        // rejects the absent gf instance and the async fallback is unreachable.
        if cf0.isAsync {
            val pslot: U64 = self.asyncEntrySlot(fi: cfi)
            if pslot < self.asyncEntryIdx.count() {
                mut val pav: Array[LLVMValueRef] = []
                self.appendCallArgValues(c: inout c, av: inout pav, f: cf0, args: args)
                return LLVMBuildCall2(self.b, self.asyncEntryTy[pslot], self.asyncEntryVal[pslot], arrayCPtr(pav), pav.count(), anon())
            }
            c.errorAt(offset: callOffset, msg: "internal error: final async callable has no declared entry")
            return LLVMConstNull(self.ptrty)
        }
        if c.isGenericFreeFn(fi: cfi) && (inferred.count() != cf0.typeParams.count() || !(c.fnArgsAllGround(args: inferred))) {
            if c.traceCodegen {
                eprint(text: "[trace-codegen] incomplete final callable name=")
                self.traceCodegenName(c: inout c, start: cf0.nameStart, len: cf0.nameLen)
                eprint(text: " expected=")
                self.traceCodegenU64(n: cf0.typeParams.count())
                eprint(text: " actual=")
                self.traceCodegenU64(n: inferred.count())
                eprint(text: " receiver=")
                self.traceCodegenType(c: inout c, ref: recvInstRef, depth: 0U64)
                if args.count() > 0U64 {
                    eprint(text: " first-result=")
                    self.traceCodegenType(c: inout c, ref: c.bodyCalleeResultRef(exprId: args[0].expr), depth: 0U64)
                }
                eprint(text: "\n")
            }
            c.errorAt(offset: callOffset, msg: "internal error: final callable is missing grounded type arguments")
            return LLVMConstInt(self.i64ty, 1U64, 0I32)
        }
        val gslot: U64 = self.ensureFnInst(c: inout c, fnIdx: cfi, args: inferred, recvInstRef: recvInstRef)
        if gslot < self.genFnK.count() {
            val cf: Func = c.arena.funcs[cfi]
            val savedP: Array[Bind] = c.cur.typeParams
            val savedA: Array[U64] = c.cur.typeArgs
            val savedSelf: U64 = c.cur.selfRef
            val savedItem: U64 = c.cur.itemRef
            c.cur.typeParams = cf.typeParams
            c.cur.typeArgs = inferred
            if cf.isAssoc && recvInstRef != 0U64 && recvInstRef < c.arena.types.count() {
                c.setSelfItemEnv(recvStart: c.arena.types[recvInstRef].nameStart, recvLen: c.arena.types[recvInstRef].nameLen, recvInstRef: recvInstRef)
            }
            val pinMark: U64 = self.pinCells.count()
            mut val av2: Array[LLVMValueRef] = []
            self.appendCallArgValues(c: inout c, av: inout av2, f: cf, args: args)
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
            c.cur.selfRef = savedSelf
            c.cur.itemRef = savedItem
            self.emitInoutOverlapChecks(c: inout c, f: cf, av: av2, args: args, hasRecv: false, recvExpr: 0U64, avArgStart: 0U64, pinMark: pinMark)
            val rv: LLVMValueRef = LLVMBuildCall2(self.b, self.genFnTy[gslot], self.genFnVal[gslot], arrayCPtr(av2), av2.count(), anon())
            self.releaseInoutPins(c: inout c, mark: pinMark)
            return rv
        }
        // ensureFnInst declined: an `async fn` whose promise-returning entry is declared by
        // declareAsyncFns into the dedicated async-entry table. Resolve it.
            val pslot: U64 = self.asyncEntrySlot(fi: cfi)
            if pslot < self.asyncEntryIdx.count() {
                val cf: Func = c.arena.funcs[cfi]
                mut val pav: Array[LLVMValueRef] = []
                self.appendCallArgValues(c: inout c, av: inout pav, f: cf, args: args)
                return LLVMBuildCall2(self.b, self.asyncEntryTy[pslot], self.asyncEntryVal[pslot], arrayCPtr(pav), pav.count(), anon())
            }
        return LLVMConstNull(self.ptrty)
    }

    inout fn genLlvmCall(c: inout Comp, callId: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
        // An indirect closure target is recorded by Mono with its lexical binding
        // and grounded function type. Mono-local array indices are not an ABI:
        // lowering a `for` introduces iterator storage before its loop binding.
        // Find the already-selected binding in the emitter's current lexical
        // storage; this is not callable/name resolution.
        if c.bodyCalleeTargetKind(exprId: callId) == 2U64 {
            val targetStart: U64 = c.bodyCalleeTargetNameStart(exprId: callId)
            val targetLen: U64 = c.bodyCalleeTargetNameLen(exprId: callId)
            val cli: U64 = self.findLocal(c: inout c, start: targetStart, len: targetLen)
            val fnRef: U64 = c.bodyCalleeTargetTypeRef(exprId: callId)
            if cli >= self.nLocals || fnRef == 0U64 || !(c.isFnType(ref: fnRef)) {
                c.errorAt(offset: nameStart, msg: "internal error: final closure callable has no matching local storage")
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
            val cloVal: LLVMValueRef = LLVMBuildLoad2(self.b, self.closureTy, self.locPtr[cli], anon())
            return self.emitClosureCallValue(c: inout c, cloVal: cloVal, fnRef: fnRef, args: args)
        }
        // Resolve the callee up front and dispatch by IDENTITY, not by raw name (audit-3 P0,
        // spec/12): a real Plew function — user OR std, isExtern=false, including std's own
        // `print` and Format wrappers — is emitted through its real body. The intrinsic floor
        // intercepts below fire ONLY when the name resolves to a std `extern(plewIntrinsic)`
        // declaration (isExtern) or to nothing (a backend-synthesized floor op). This is what
        // stops a user `fn write`/`fn truncU8` from being silently replaced by the intrinsic.
        val cfi: U64 = c.bodyCallee(exprId: callId)
        if cfi < c.arena.funcs.count() {
            if !(c.arena.funcs[cfi].isExtern) {
                val selectedRecvRef: U64 = c.bodyCalleeReceiverRef(exprId: callId)
                val uv: LLVMValueRef = self.genLlvmResolvedCallableCall(c: inout c, callId: callId, cfi: cfi, args: args, recvInstRef: selectedRecvRef, callOffset: nameStart)
                if LLVMIsNull(uv) == 0I32 {
                    return uv
                }
                // a resolved Plew fn that could not be instantiated is an error, never an
                // intrinsic — report it here rather than fall into the name intercepts.
                c.errorAt(offset: nameStart, msg: "LLVM backend: this call is not yet supported (intrinsic or plain user function only)")
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
        }
        mut val resolvedPlewIntrinsic: Bool = false
        if cfi < c.arena.funcs.count() {
            val cfIntrinsic: Func = c.arena.funcs[cfi]
            resolvedPlewIntrinsic = cfIntrinsic.isExtern && !(cfIntrinsic.isCExtern)
        }
        if resolvedPlewIntrinsic {
        // numeric intrinsic floor (`i8Add`, `u32Lt`, `i64Neg`, …): the primitive op the
        // std operator-trait witness bodies bottom out in. Lowered by intrinsic-function
        // IDENTITY (like the Buffer floor below) — this is the ONE place a primitive op is
        // known; `+`/`<`/`~`/… reach it only through those witness bodies (spec/12, O6).
        val numIv: LLVMValueRef = self.genNumIntrinsic(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
        if LLVMIsNull(numIv) == 0I32 {
            return numIv
        }
        // Buffer floor intrinsics in free-function form, lowered by intrinsic-function
        // IDENTITY (not by receiver-type recognition): the `Buffer[T]` methods are now
        // ordinary monomorphized generic methods whose bodies call these intrinsics, so
        // each `buffer*(buffer: …, …)` lowers to the same header op as the old call-site
        // interception did. The element type is recovered from the buffer argument; args
        // arrive in the extern declaration's parameter order. (collections.md §3-付録3.)
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferNew") {
            return self.genLlvmBufferNew(c: inout c)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferCount") {
            return self.genLlvmBufferCount(c: inout c, recv: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferCapacity") {
            return self.genLlvmBufferCapacity(c: inout c, recv: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferReserve") {
            return self.genLlvmBufferReserve(c: inout c, recv: args[0].expr, addCapExpr: args[1].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferAppend") {
            return self.genLlvmBufferAppend(c: inout c, recv: args[0].expr, valueExpr: args[1].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferInsertAt") {
            return self.genLlvmBufferInsertAt(c: inout c, recv: args[0].expr, indexExpr: args[1].expr, valueExpr: args[2].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferGet") {
            return self.genLlvmBufferGet(c: inout c, recv: args[0].expr, indexExpr: args[1].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferSet") {
            return self.genLlvmBufferSet(c: inout c, recv: args[0].expr, indexExpr: args[1].expr, valueExpr: args[2].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferRemoveLast") {
            return self.genLlvmBufferRemoveLast(c: inout c, recv: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferRemoveAt") {
            return self.genLlvmBufferRemoveAt(c: inout c, recv: args[0].expr, indexExpr: args[1].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferSwapRemove") {
            return self.genLlvmBufferSwapRemove(c: inout c, recv: args[0].expr, indexExpr: args[1].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferClear") {
            return self.genLlvmBufferClear(c: inout c, recv: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferTruncate") {
            return self.genLlvmBufferTruncate(c: inout c, recv: args[0].expr, countExpr: args[1].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferEq") {
            return self.genLlvmBufferEq(c: inout c, lhs: args[0].expr, rhs: args[1].expr)
        }
        // COMPILE-TIME constant: is the element type byte-comparable (memcmp == value eq)?
        // True ONLY for an INTEGER element (LLVM kind 8) — its bit pattern is its value, so
        // memcmp matches `iN.eq` exactly. FLOATS are excluded (kinds 2/3): memcmp of the raw
        // bits diverges from the element's real `F64`/`F32` witness — `-0.0`/`+0.0` are equal
        // under IEEE `oeq` but differ bytewise, and a NaN element must PANIC (spec/02) yet
        // memcmp silently reports NaN==NaN equal. A struct/enum/pointer element likewise has
        // padding or heap-owned fields. All non-integer elements fall to the element-wise
        // witness loop (each element's own `eq`), so array `==` never diverges from scalar
        // `==`. The constant `i1` folds the source-level `if` to a single static path.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bufferBytewiseComparable") {
            val elemTy: LLVMTypeRef = self.bufElemTyOf(c: inout c, id: args[0].expr)
            val k: U32 = LLVMGetTypeKind(elemTy)
            mut val bytewise: U64 = 0
            if k == 8U32 { bytewise = 1U64 }
            return LLVMConstInt(self.i1ty, bytewise, 0I32)
        }
        // Reference-cell control-block intrinsics (spec/03), backing weak()/upgrade()/asRef().
        // The
        // cell value IS the argument's value (an opaque pointer); each op touches a counter.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "refNew") {
            // Ref.factory(value:) bottoms out here: allocate a fresh strong cell.
            return self.genLlvmRefNew(c: inout c, valueExpr: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "mutableRefNew") {
            // MutableRef.factory(value:) bottoms out here: same cell representation, different capability type.
            return self.genLlvmRefNew(c: inout c, valueExpr: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "refWeak") {
            // r.weak(): bump the weak count, yield the same cell as a WeakRef handle.
            return self.refWeakDowngrade(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr))
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "mutableRefAsRef") {
            // r.asRef(): bump strong, yield the same cell with read-only capability.
            return self.refUpgrade(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr))
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "mutableRefWeak") {
            // r.weak(): bump the weak count, yield the same cell as a WeakMutableRef handle.
            return self.refWeakDowngrade(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr))
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "weakAlive") {
            // strong > 0 — the pointee is still alive (i1).
            return LLVMBuildICmp(self.b, llvmIntNe(), self.refStrongCount(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr)), LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "weakLock") {
            // take a new strong owner of the (wrapper-guaranteed-alive) cell, yield it as a
            // Ref (refUpgrade re-checks strong>0 then bumps; returns the cell).
            return self.refUpgrade(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr))
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "weakMutableAlive") {
            // strong > 0 — the pointee is still alive (i1).
            return LLVMBuildICmp(self.b, llvmIntNe(), self.refStrongCount(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr)), LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "weakMutableLock") {
            // take a new strong mutable owner of the (wrapper-guaranteed-alive) cell.
            return self.refUpgrade(c: inout c, cell: self.genLlvmExpr(c: inout c, id: args[0].expr))
        }
        }
        if resolvedPlewIntrinsic {
        // `sleep(ms: I64) -> Promise[I64]` (@Std/Async intrinsic): a timer promise,
        // `plew_sleep(i64) -> PlewPromise*` (await suspends until it fires).
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "sleep") {
            mut val sty: Array[LLVMTypeRef] = []
            sty.append(self.i64ty)
            val sleepTy: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(sty), 1U64, 0I32)
            val sleepFn: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_sleep", nameId: 42U64, fnTy: sleepTy)
            mut val sargs: Array[LLVMValueRef] = []
            sargs.append(self.extendToI64(v: self.genLlvmExpr(c: inout c, id: args[0].expr), unsigned: false))
            return LLVMBuildCall2(self.b, sleepTy, sleepFn, arrayCPtr(sargs), 1U64, anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "write") {
            return self.emitStrSink(c: inout c, rtName: "plew_write_raw", rtId: 2U64, argExpr: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "eprint") {
            return self.emitStrSink(c: inout c, rtName: "plew_eprint_raw", rtId: 3U64, argExpr: args[0].expr)
        }
        // @Std/Io writeByte(b: U8): putchar.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "writeByte") {
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.i8ty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_writeByte", nameId: 52U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i8ty, unsigned: true))
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
        }
        // @Std/Process argCount() -> I64.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "argCount") {
            mut val ptys: Array[LLVMTypeRef] = []
            val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 0U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_argCount", nameId: 50U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 0U64, anon())
        }
        // @Std/Process argAt(i: I64) -> String (strty {ptr,i64}).
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "argAt") {
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.i64ty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(ptys), 1U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_argAt", nameId: 51U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(self.extendToI64(v: self.genLlvmExpr(c: inout c, id: args[0].expr), unsigned: false))
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
        }
        // @Std/Random entropyU64() -> U64: a fresh 64-bit value from the OS entropy
        // source (the seed for the in-language PRNG).
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "entropyU64") {
            mut val ptys: Array[LLVMTypeRef] = []
            val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 0U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_random_u64", nameId: 52U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 0U64, anon())
        }
        // (Prelude internal) bitCastU64(n: I64) -> U64: reinterpret a signed integer's
        // two's-complement bit pattern as U64 (for hashing signed keys — `as U64` is
        // lossless-only and rejects negatives). A no-op at the LLVM level: I64 and U64 are
        // both i64, so the argument value passes through unchanged.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bitCastU64") {
            return self.extendToI64(v: self.genLlvmExpr(c: inout c, id: args[0].expr), unsigned: false)
        }
        // (Core internal) bitCastI64(n: U64) -> I64: the inverse reinterpret of bitCastU64
        // (a non-negative U64's bit pattern as I64, after a range check). Also a no-op at
        // the LLVM level (U64 and I64 are both i64), so the argument passes through.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "bitCastI64") {
            return self.extendToI64(v: self.genLlvmExpr(c: inout c, id: args[0].expr), unsigned: true)
        }
        // (Prelude internal) truncU8(n: U64) -> U8: keep the low 8 bits (`as U8` is
        // lossless-only and rejects wider values). Used to assemble UTF-8 bytes during
        // string literal `\u{...}` decoding.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "truncU8") {
            return self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i8ty, unsigned: true)
        }
        // (Prelude internal) truncU16/U32(n: U64) -> UX: narrow a range-checked unsigned
        // integer (low bits; trunc is signedness-agnostic, but the result type is unsigned).
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "truncU16") {
            return self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i16ty, unsigned: true)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "truncU32") {
            return self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i32ty, unsigned: true)
        }
        // (Prelude internal) truncI8/I16/I32(n: I64) -> IX: narrow a RANGE-CHECKED signed
        // integer (`as` is lossless-only and rejects narrowing). The fallible `convert`
        // factories (spec/12 TryFrom) call these only after proving the value fits.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "truncI8") {
            return self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i8ty, unsigned: false)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "truncI16") {
            return self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i16ty, unsigned: false)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "truncI32") {
            return self.coerceInt(v: self.genLlvmExpr(c: inout c, id: args[0].expr), target: self.i32ty, unsigned: false)
        }
        // (Core internal) isNanF64(f: F64) -> Bool: `fcmp uno f, f` (unordered = true iff
        // NaN). A direct intrinsic because Plew's `==`/`!=` on floats PANIC on a NaN
        // operand (spec/02), so the fallible float->int `convert` (spec/12 TryFrom) must
        // test NaN with this BEFORE any ordered comparison.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "isNanF64") {
            return LLVMBuildFCmp(self.b, 8U32, self.genLlvmExpr(c: inout c, id: args[0].expr), self.genLlvmExpr(c: inout c, id: args[0].expr), anon())
        }
        // (Core internal) f64ToI64(f: F64) -> I64: truncate toward zero (`fptosi`). Called
        // only after the `convert` factory proves the value is finite and in [-2^63, 2^63)
        // (out of that range, fptosi is UB) — so this is the in-range raw conversion.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "f64ToI64") {
            return LLVMBuildFPToSI(self.b, self.genLlvmExpr(c: inout c, id: args[0].expr), self.i64ty, anon())
        }
        // (Core internal) f64ToU64(f: F64) -> U64: truncate toward zero (`fptoui`). Called
        // only after the `convert` factory proves the value is finite and in [0, 2^64) —
        // out of that range fptoui is UB — so this is the in-range raw conversion.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "f64ToU64") {
            return LLVMBuildFPToUI(self.b, self.genLlvmExpr(c: inout c, id: args[0].expr), self.i64ty, anon())
        }
        // (Prelude internal) __dictSeed() -> U64: the per-process dictionary hash seed —
        // a lazily-initialized random value (stable for the process), so SipHash is keyed
        // unpredictably across runs (DoS resistance) while staying consistent within a run.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "__dictSeed") {
            mut val ptys: Array[LLVMTypeRef] = []
            val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 0U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_dict_seed", nameId: 53U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 0U64, anon())
        }
        // @Std/Io readFile(path: String) -> String and readFileBytes(path: Array[U8])
        // -> String / fileExists(path: Array[U8]) -> Bool: the path argument is a
        // {ptr,i64} value (String or Array[U8], same layout), passed as two args.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "readFile") {
            return self.emitPathStrIntrinsic(c: inout c, rtName: "plew_readFile", rtId: 55U64, retTy: self.stringLlvmTy(c: inout c), pathExpr: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") {
            return self.emitPathStrIntrinsic(c: inout c, rtName: "plew_readFileBytes", rtId: 53U64, retTy: self.stringLlvmTy(c: inout c), pathExpr: args[0].expr)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "fileExists") {
            val r: LLVMValueRef = self.emitPathStrIntrinsic(c: inout c, rtName: "plew_fileExists", rtId: 54U64, retTy: self.i64ty, pathExpr: args[0].expr)
            // i64 1/0 -> Bool i1.
            return LLVMBuildICmp(self.b, llvmIntNe(), r, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        }
        // @Std/Process execOut(cmd: String) -> String: run `sh -c cmd`, capture stdout
        // (the cmd String is a {ptr,i64} value, same path-intrinsic shape).
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "execOut") {
            return self.emitPathStrIntrinsic(c: inout c, rtName: "plew_execOut", rtId: 70U64, retTy: self.stringLlvmTy(c: inout c), pathExpr: args[0].expr)
        }
        // execCode() -> I64: the exit status of the last execOut.
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "execCode") {
            mut val ptys: Array[LLVMTypeRef] = []
            val fty: LLVMTypeRef = LLVMFunctionType(self.i64ty, arrayCPtr(ptys), 0U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_execCode", nameId: 71U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 0U64, anon())
        }
        // FFI String <-> C-string (@Std/Ffi extern(plewIntrinsic)).
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "cString") {
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.ptrty)
            ptys.append(self.i64ty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 2U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_cString", nameId: 29U64, fnTy: fty)
            val s: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[0].expr)
            mut val av: Array[LLVMValueRef] = []
            av.append(self.arrValData(c: inout c, arr: s))
            av.append(self.arrValCount(c: inout c, arr: s))
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "cFree") {
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.ptrty)
            val fty: LLVMTypeRef = LLVMFunctionType(LLVMVoidTypeInContext(self.ctx), arrayCPtr(ptys), 1U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_cFree", nameId: 72U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(self.genLlvmExpr(c: inout c, id: args[0].expr))
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "stringFromCString") {
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.ptrty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(ptys), 1U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_stringFromCString", nameId: 30U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(self.genLlvmExpr(c: inout c, id: args[0].expr))
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "arrayCPtr") {
            // an array's storage base as CPtr[T]: the data pointer (field 0).
            return self.arrValData(c: inout c, arr: self.genLlvmExpr(c: inout c, id: args[0].expr))
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "stringFromBytesUnchecked") {
            // an (assumed-valid) UTF-8 Array[U8] -> String: same {ptr,i64} layout, so rebuild
            // the strty aggregate from the array's data + count. The validated public path is
            // `<String.checked source=bytes/>` (TryFrom[Array[U8]]); this is the unchecked floor.
            val arr: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[0].expr)
            // the returned String shares the source Array[U8]'s buffer (same {ptr,len}, no
            // copy) and outlives this call. Take ownership the SAME way any by-value array
            // bind does (shareArrayIfPlace): when the source is a PLACE still owned elsewhere
            // — a local reused later, a struct field (`self.bytes` in `Src.finish`), an
            // element — RETAIN the shared buffer so the owner's own release does not free the
            // bytes out from under the String (true CoW; the copy is deferred to first
            // mutation). A non-place (literal / call result) already owns its lone reference
            // and passes through — the String just inherits it. (Previously this only marked
            // a local Ident source moved, so a field/element source left the String dangling
            // once its owner dropped.)
            val owned: LLVMValueRef = self.shareArrayIfPlace(c: inout c, arrVal: arr, elemTy: self.i8ty, valueExpr: args[0].expr)
            return self.arrValMake(c: inout c, data: self.arrValData(c: inout c, arr: owned), count: self.arrValCount(c: inout c, arr: owned), aggTy: self.stringLlvmTy(c: inout c))
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "floatToString") {
            // a double -> String via the runtime (snprintf %g into a malloc'd buffer).
            val fv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[0].expr)
            mut val ftys: Array[LLVMTypeRef] = []
            ftys.append(self.f64ty)
            val ffty: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(ftys), 1U64, 0I32)
            val fcallee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_f64_to_str", nameId: 9140U64, fnTy: ffty)
            mut val fav: Array[LLVMValueRef] = []
            fav.append(fv)
            return LLVMBuildCall2(self.b, ffty, fcallee, arrayCPtr(fav), 1U64, anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
            // read all of stdin into a String (strty {i8*,i64}) via the runtime.
            mut val rtys: Array[LLVMTypeRef] = []
            val rfty: LLVMTypeRef = LLVMFunctionType(self.stringLlvmTy(c: inout c), arrayCPtr(rtys), 0U64, 0I32)
            val rcallee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_readStdin", nameId: 27U64, fnTy: rfty)
            mut val rav: Array[LLVMValueRef] = []
            return LLVMBuildCall2(self.b, rfty, rcallee, arrayCPtr(rav), 0U64, anon())
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "assert") {
            // assert(cond): branch to a panic block when the condition is false.
            val cond: LLVMValueRef = self.genLlvmCond(c: inout c, id: args[0].expr)
            val okBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "assert.ok"))
            val failBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "assert.fail"))
            LLVMBuildCondBr(self.b, cond, okBB, failBB)
            LLVMPositionBuilderAtEnd(self.b, failBB)
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.ptrty)
            ptys.append(self.i64ty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 2U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_panic_raw", nameId: 4U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            // assert(cond, message: msg): use the caller's message String when given
            // (its {ptr,len} aggregate), else the default "assertion failed".
            if args.count() > 1U64 {
                val msg: LLVMValueRef = self.genLlvmExpr(c: inout c, id: args[1].expr)
                av.append(self.arrValData(c: inout c, arr: msg))
                av.append(self.arrValCount(c: inout c, arr: msg))
            } else {
                av.append(LLVMBuildGlobalStringPtr(self.b, cstr(s: "assertion failed"), anon()))
                av.append(LLVMConstInt(self.i64ty, 16U64, 0I32))
            }
            LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 2U64, anon())
            LLVMBuildUnreachable(self.b)
            LLVMPositionBuilderAtEnd(self.b, okBB)
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "exit") {
            // void plew_exit(i64): truncate-free (the code is already i64), then call.
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(self.i64ty)
            val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
            val callee: LLVMValueRef = self.getOrDeclare(c: inout c, name: "plew_exit", nameId: 1U64, fnTy: fty)
            mut val av: Array[LLVMValueRef] = []
            av.append(self.extendToI64(v: self.genLlvmExpr(c: inout c, id: args[0].expr), unsigned: self.valueKind(c: inout c, id: args[0].expr) == 3U64))
            return LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), 1U64, anon())
        }
        }
        // A resolved non-extern Plew fn (user or std) was already emitted by identity at the
        // top of this function; only an extern(c) foreign function or a genuinely unresolved
        // name reaches here. `cfi` is the up-front resolution.
        // an extern(c) foreign function (`moduleCreate(…)`): call by its RAW C name
        // with an FFI-mapped signature (opaque handles / CPtr -> ptr, scalars as-is).
        if cfi < c.arena.funcs.count() {
            if c.arena.funcs[cfi].isExtern {
                val ef: Func = c.arena.funcs[cfi]
                mut val ptys: Array[LLVMTypeRef] = []
                mut val pe: U64 = 0
                while pe < ef.params.count() {
                    ptys.append(self.ffiTyOf(c: inout c, tyStart: ef.params[pe].tyStart, tyLen: ef.params[pe].tyLen))
                    pe += 1
                }
                mut val rty: LLVMTypeRef = self.voidty
                if ef.hasRet {
                    rty = self.ffiTyOf(c: inout c, tyStart: ef.retStart, tyLen: ef.retLen)
                }
                val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count(), 0I32)
                // the C symbol is the raw function name (no mangling); cache by the
                // function's interned nameId, OFFSET past the runtime cache's small ids
                // (1-30) so a foreign symbol whose nameId is e.g. 5 doesn't alias
                // plew_print_str.
                val ckey: U64 = ef.nameId + 1000000000U64
                mut val callee: LLVMValueRef = LLVMConstNull(self.ptrty)
                mut val dfound: Bool = false
                mut val di: U64 = 0
                while di < self.declId.count() {
                    if self.declId[di] == ckey {
                        callee = self.declFn[di]
                        dfound = true
                        di = self.declId.count()
                    } else {
                        di += 1
                    }
                }
                if !(dfound) {
                    mut val nm: Array[U8] = []
                    mut val k: U64 = 0
                    while k < nameLen {
                        nm.append(c.arena.bytes[nameStart + k])
                        k += 1
                    }
                    nm.append(0)
                    callee = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
                    self.declId.append(ckey)
                    self.declFn.append(callee)
                    self.declTy.append(fty)
                }
                mut val av: Array[LLVMValueRef] = []
                mut val ai: U64 = 0
                while ai < args.count() {
                    av.append(self.genLlvmExpr(c: inout c, id: args[ai].expr))
                    ai += 1
                }
                val rv: LLVMValueRef = LLVMBuildCall2(self.b, fty, callee, arrayCPtr(av), av.count(), anon())
                if ef.hasRet {
                    return rv
                }
                return LLVMConstInt(self.i64ty, 0U64, 0I32)
            }
        }
        c.errorAt(offset: nameStart, msg: "LLVM backend: this call is not yet supported (intrinsic or plain user function only)")
        return LLVMConstInt(self.i64ty, 0U64, 0I32)
    }
}
