// The private Plew ABI preserves aggregate value snapshots through byval.
// Logical signatures remain the inputs of call preparation and parameter binding;
// this layer alone maps them to physical LLVM parameters and attributes.
pub impl LlvmCtx {
    inout fn byvalAttributeKind() -> U32 {
        if self.valueAbiByvalKind == 0U32 {
            self.valueAbiByvalKind = LLVMGetEnumAttributeKindForName(cstr(s: "byval"), 5U64)
        }
        return self.valueAbiByvalKind
    }

    inout fn valueAbi(signature~: LLVMTypeRef) -> U64 {
        val count = LLVMCountParamTypes(signature)
        mut val parameters: Array[LLVMTypeRef] = []
        mut val index = 0U64
        while index < count {
            parameters.append(self.voidty)
            index += 1U64
        }
        if count != 0U64 { LLVMGetParamTypes(signature, arrayCPtr(parameters)) }
        mut val physical: Array[LLVMTypeRef] = []
        val start = self.valueAbiParameters.count()
        index = 0U64
        while index < count {
            val type = parameters[index]
            val passing = llvmValueAbiPassing(type)
            self.valueAbiParameters.append(<LlvmValueParameter type=type physicalIndex=physical.count() passing=passing />)
            match passing {
                LlvmValuePassing.Omitted => {}
                LlvmValuePassing.Direct => { physical.append(type) }
                LlvmValuePassing.Indirect => { physical.append(self.ptrty) }
            }
            index += 1U64
        }
        self.valueAbis.append(<LlvmValueAbi parameterStart=start parameterCount=count logicalSignature=signature functionType=LLVMFunctionType(LLVMGetReturnType(signature), arrayCPtr(physical), physical.count(), 0I32) />)
        return self.valueAbis.count()
    }

    inout fn declareValueFunction(name: CPtr[U8], signature: LLVMTypeRef) -> LLVMValueRef {
        val abiId = self.valueAbi(signature)
        val abi = self.valueAbis[abiId - 1U64]
        val function = LLVMAddFunction(self.mod, name, abi.functionType)
        LLVMSetLinkage(function, 8U32)
        // The iteration/attribute binding uses a nullable integer handle at
        // the FFI floor. Resolve the actual (possibly uniqued) LLVM symbol.
        val handle = LLVMGetNamedFunction(self.mod, LLVMGetValueName(function))
        self.valueAbiFunctions[handle] = abiId
        mut val index = 0U64
        while index < abi.parameterCount {
            val parameter = self.valueAbiParameters[abi.parameterStart + index]
            match parameter.passing {
                LlvmValuePassing.Indirect => {
                    LLVMAddAttributeAtIndex(handle, truncU32(n: parameter.physicalIndex + 1U64), LLVMCreateTypeAttribute(self.ctx, self.byvalAttributeKind(), parameter.type))
                }
                _ => {}
            }
            index += 1U64
        }
        return function
    }

    // Use the actual builder's function: physical thunks may be emitted while
    // another source body is active. Entry allocation prevents loop stack growth.
    inout fn valueAbiSlot(type~: LLVMTypeRef) -> LLVMValueRef {
        val entry = LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(LLVMGetInsertBlock(self.b)))
        val builder = LLVMCreateBuilderInContext(self.ctx)
        LLVMPositionBuilder(builder, entry, LLVMGetFirstInstruction(entry))
        val slot = LLVMBuildAlloca(builder, type, anon())
        LLVMDisposeBuilder(builder)
        return slot
    }

    inout fn callValueFunction(signature: LLVMTypeRef, function: LLVMValueRef, arguments: Array[LLVMValueRef]) -> LLVMValueRef {
        val handle = LLVMIsAFunction(function)
        mut val abiId = 0U64
        if handle != 0U64 {
            abiId = self.valueAbiFunctions.getOr(key: handle, fallback: 0U64)
            if abiId == 0U64 {
                compileErrorAt(line: 0I64, msg: "internal error: private call lacks a declared value ABI")
            }
        } else { abiId = self.valueAbi(signature) }
        val abi = self.valueAbis[abiId - 1U64]
        if plew_pointer_equal(abi.logicalSignature, signature) == 0I32 {
            compileErrorAt(line: 0I64, msg: "internal error: private call logical signature mismatch")
        }
        if abi.parameterCount != arguments.count() {
            compileErrorAt(line: 0I64, msg: "internal error: private value ABI argument count mismatch")
        }
        mut val values: Array[LLVMValueRef] = []
        mut val index = 0U64
        while index < arguments.count() {
            val value = arguments[index]
            val parameter = self.valueAbiParameters[abi.parameterStart + index]
            match parameter.passing {
                LlvmValuePassing.Omitted => {}
                LlvmValuePassing.Direct => { values.append(value) }
                LlvmValuePassing.Indirect => {
                    val slot = self.valueAbiSlot(parameter.type)
                    llvmStore(self.b, value, slot)
                    values.append(slot)
                }
            }
            index += 1U64
        }
        val call = LLVMBuildCall2(self.b, abi.functionType, function, arrayCPtr(values), values.count(), anon())
        index = 0U64
        while index < abi.parameterCount {
            val parameter = self.valueAbiParameters[abi.parameterStart + index]
            match parameter.passing {
                LlvmValuePassing.Indirect => {
                    LLVMAddCallSiteAttribute(call, truncU32(n: parameter.physicalIndex + 1U64), LLVMCreateTypeAttribute(self.ctx, self.byvalAttributeKind(), parameter.type))
                }
                _ => {}
            }
            index += 1U64
        }
        return call
    }

    inout fn valueParameter(function: LLVMValueRef, index: U64) -> LLVMValueRef {
        val handle = LLVMGetNamedFunction(self.mod, LLVMGetValueName(function))
        val abiId = self.valueAbiFunctions.getOr(key: handle, fallback: 0U64)
        if abiId == 0U64 {
            compileErrorAt(line: 0I64, msg: "internal error: private value ABI parameter lacks declaration")
        }
        val abi = self.valueAbis[abiId - 1U64]
        if index >= abi.parameterCount {
            compileErrorAt(line: 0I64, msg: "internal error: private value ABI parameter index out of range")
        }
        val parameter = self.valueAbiParameters[abi.parameterStart + index]
        match parameter.passing {
            LlvmValuePassing.Omitted => { return LLVMGetUndef(parameter.type) }
            LlvmValuePassing.Direct => { return LLVMGetParam(function, parameter.physicalIndex) }
            LlvmValuePassing.Indirect => { return llvmLoad(self.b, parameter.type, LLVMGetParam(function, parameter.physicalIndex), anon()) }
        }
    }
}
