// The private Plew ABI forwards guaranteed read homes and preserves required snapshots.
// Logical signatures remain the inputs of call preparation and parameter binding;
// this layer alone maps them to physical LLVM parameters and attributes.
pub impl LlvmCtx {
    inout fn byvalAttributeKind() -> U32 {
        if self.valueAbiByvalKind == 0U32 {
            val symbolCString = <CString.copied text="byval" />
            self.valueAbiByvalKind = LLVMGetEnumAttributeKindForName(symbolCString.ptr, 5U64)
        }
        return self.valueAbiByvalKind
    }

    inout fn prepareValueAbiScope() -> Result[LlvmSignatureScope, CompileDiagnostic] {
        match self.valueAbiScope {
            Optional.Some(v: val scope) => { return <Result.Ok value=scope /> }
            Optional.None => {}
        }
        val scope = (try LlvmSignatureScope.admitted(module: self.mod))
        self.valueAbiScope = <Optional.Some v=scope />
        return <Result.Ok value=scope />
    }

    inout fn saveValueAbi(signature: LlvmLogicalSignature, ownerBody: U64) -> Result[U64, CompileDiagnostic] {
        val scope = (try self.prepareValueAbiScope())
        val plan = (try scope.plan(signature: signature))
        val start = self.valueAbiParameters.count()
        for parameter in plan.parameters { self.valueAbiParameters.append(parameter) }
        self.valueAbis.append(<LlvmValueAbi parameterStart=start parameterCount=plan.parameters.count() logicalSignature=plan.logicalSignature functionType=plan.functionType moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=plan.revision convention=plan.convention resultTerm=plan.resultTerm resultProtocol=plan.resultProtocol ownerBody=ownerBody />)
        return <Result.Ok value=self.valueAbis.count() />
    }

    // Only unsupported ordinary closure modes retain this declaration boundary.
    // It preserves existing lazy construction without granting a raw call API.
    inout fn legacyValueAbi(signature: LLVMTypeRef, family: LlvmLegacyConvention, ownerBody: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        if family.key() != 1U64 { return <Result.Err error=valueAbiFailure(message: "only unsupported closure declarations retain a legacy descriptor") /> }
        val scope = (try self.prepareValueAbiScope())
        if !scope.ownsType(type: signature) || LLVMGetTypeKind(signature) != 9U32 {
            return <Result.Err error=valueAbiFailure(message: "legacy signature has a foreign context or is not a function") />
        }
        if LLVMIsFunctionVarArg(signature) != 0I32 { return <Result.Err error=valueAbiFailure(message: "private legacy convention cannot be variadic") /> }
        val count = LLVMCountParamTypes(signature)
        mut val types: Array[LLVMTypeRef] = []
        mut val index = 0U64
        while index < count { types.append(self.voidty) index += 1U64 }
        if count != 0U64 { LLVMGetParamTypes(signature, arrayCPtr(types)) }
        mut val parameters: Array[LlvmLogicalParameter] = []
        index = 0U64
        while index < count {
            parameters.append(<LlvmLogicalParameter type=types[index] semanticType=0U64 role=<LlvmParameterRole.Legacy index=index /> mode=<LlvmParameterMode.Legacy /> />)
            index += 1U64
        }
        return self.saveValueAbi(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Legacy family=family /> parameters=parameters result=LLVMGetReturnType(signature) resultTerm=0U64 />, ownerBody: ownerBody)
    }

    // The template is scoped to this LLVM context/module and finalized semantic
    // function type. Declarations share its immutable parameter slice; no call
    // reclassifies or appends physical lanes.
    inout fn closureValueAbi(c: inout Comp, functionType: U64) -> Result[U64, CompileDiagnostic] {
        val scope = (try self.prepareValueAbiScope())
        try scope.validateScope()
        val cached = self.closureValueAbis.getOr(key: functionType, fallback: 0U64)
        if cached != 0U64 { return <Result.Ok value=cached /> }
        if functionType == 0U64 || functionType >= c.arena.typeCount() { return <Result.Err error=valueAbiFailure(message: "closure callable type out of range") /> }
        val type = c.arena.typeAt(index: functionType)
        if !c.isFnType(ref: functionType) || type.args.count() == 0U64 { return <Result.Err error=valueAbiFailure(message: "closure requires a completed function type") /> }
        mut val parameters: Array[LlvmLogicalParameter] = [<LlvmLogicalParameter type=self.ptrty semanticType=0U64 role=<LlvmParameterRole.Environment /> mode=<LlvmParameterMode.Borrow /> />]
        mut val index = 1U64
        while index < type.args.count() {
            val term = type.args[index]
            parameters.append(<LlvmLogicalParameter type=(try self.llvmTypeOfRef(c: inout c, ref: term)) semanticType=term copyable=!c.arena.typeTermIsUnique(ref: term) role=<LlvmParameterRole.Ordinary index=index - 1U64 /> mode=<LlvmParameterMode.Borrow /> />)
            index += 1U64
        }
        val resultTerm = if c.functionTypeReturnsUnit(ref: functionType) { give 0U64 } else { give type.args[0U64] }
        val result = if resultTerm == 0U64 { give self.voidty } else { give (try self.llvmTypeOfRef(c: inout c, ref: resultTerm)) }
        val template = (try self.saveValueAbi(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Closure /> parameters=parameters result=result resultTerm=resultTerm />, ownerBody: 0U64))
        val plan = self.valueAbis[template - 1U64]
        self.valueAbis.set(i: template - 1U64, value: <LlvmValueAbi parameterStart=plan.parameterStart parameterCount=plan.parameterCount logicalSignature=plan.logicalSignature functionType=plan.functionType moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=plan.revision convention=plan.convention resultTerm=plan.resultTerm resultProtocol=plan.resultProtocol ownerBody=0U64 callableType=functionType />)
        self.closureValueAbis[functionType] = template
        return <Result.Ok value=template />
    }

    inout fn closureBodyValueAbi(c: inout Comp, bodyId: U64, template: U64) -> Result[U64, CompileDiagnostic] {
        if template == 0U64 || template > self.valueAbis.count() || bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() { return <Result.Err error=valueAbiFailure(message: "closure declaration identity out of range") /> }
        val plan = self.valueAbis[template - 1U64]
        val scope = (try self.prepareValueAbiScope())
        try scope.validateScope()
        if plan.moduleIdentity != scope.moduleIdentity || plan.contextIdentity != scope.contextIdentity || plan.revision != 1U64 || self.closureValueAbis.getOr(key: plan.callableType, fallback: 0U64) != template { return <Result.Err error=valueAbiFailure(message: "closure declaration template scope mismatch") /> }
        val signature = c.arena.bodySignature(bodyId: bodyId)
        val frozen = c.arena.closureSignature(bodyId: bodyId)
        if plan.convention.key() != 12U64 || plan.ownerBody != 0U64 || plan.callableType != frozen.functionTypeTerm || !signature.ready || signature.receiverType != 0U64 || signature.parameterTypes.count() + 1U64 != plan.parameterCount || signature.parameterPassings.count() != signature.parameterTypes.count() || (signature.resultType != plan.resultTerm && !(plan.resultTerm == 0U64 && c.callableResultIsUnit(ref: signature.resultType)) && !c.typeRefEq(a: signature.resultType, b: plan.resultTerm)) { return <Result.Err error=valueAbiFailure(message: "closure declaration/template correspondence mismatch") /> }
        mut val index = 0U64
        while index < signature.parameterTypes.count() {
            val parameter = self.valueAbiParameters[plan.parameterStart + index + 1U64]
            if !c.typeRefEq(a: signature.parameterTypes[index], b: parameter.semanticType) { return <Result.Err error=valueAbiFailure(message: "closure declaration parameter term mismatch") /> }
            match signature.parameterPassings[index] { CallArgumentPassing.Borrow => {} _ => { return <Result.Err error=valueAbiFailure(message: "completed closure requires supported Borrow call mode") /> } }
            index += 1U64
        }
        self.valueAbis.append(<LlvmValueAbi parameterStart=plan.parameterStart parameterCount=plan.parameterCount logicalSignature=plan.logicalSignature functionType=plan.functionType moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=plan.revision convention=plan.convention resultTerm=plan.resultTerm resultProtocol=plan.resultProtocol ownerBody=bodyId callableType=plan.callableType />)
        return <Result.Ok value=self.valueAbis.count() />
    }

    inout fn closureCallee(c: inout Comp, functionType: U64, closure: LLVMValueRef) -> Result[LlvmClosureCallee, CompileDiagnostic] {
        val template = (try self.closureValueAbi(c: inout c, functionType: functionType))
        val abi = self.valueAbis[template - 1U64]
        val scope = (try self.prepareValueAbiScope())
        return <Result.Ok value=<LlvmClosureCallee template=template inputs=<LlvmCallableInputScope moduleIdentity=scope.moduleIdentity contextIdentity=scope.contextIdentity revision=1U64 callableIdentity=functionType signature=abi.logicalSignature /> closure=closure /> />
    }

    inout fn callClosureValueFunction(callee: LlvmClosureCallee, arguments: Array[LlvmValueInput]) -> Result[LLVMValueRef, CompileDiagnostic] {
        if callee.template == 0U64 || callee.template > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "closure call template out of range") /> }
        val abi = self.valueAbis[callee.template - 1U64]
        if abi.convention.key() != 12U64 || abi.ownerBody != 0U64 || abi.callableType == 0U64 || self.closureValueAbis.getOr(key: abi.callableType, fallback: 0U64) != callee.template || abi.parameterCount != arguments.count() + 1U64 { return <Result.Err error=valueAbiFailure(message: "closure call template/convention/count mismatch") /> }
        val scope = (try self.prepareValueAbiScope())
        if abi.moduleIdentity != scope.moduleIdentity || abi.contextIdentity != scope.contextIdentity || abi.revision != 1U64 || abi.parameterStart > self.valueAbiParameters.count() || abi.parameterCount > self.valueAbiParameters.count() - abi.parameterStart { return <Result.Err error=valueAbiFailure(message: "closure template scope/range mismatch") /> }
        try scope.validateCallableInputs(scope: callee.inputs, callableIdentity: abi.callableType, signature: abi.logicalSignature)
        val caller = LLVMGetBasicBlockParent(LLVMGetInsertBlock(self.b))
        try scope.validateValue(value: callee.closure, type: self.closureTy, function: caller)
        val function = LLVMBuildExtractValue(self.b, callee.closure, 0U64, anon())
        val environment = LLVMBuildExtractValue(self.b, callee.closure, 1U64, anon())
        val environmentLane = self.valueAbiParameters[abi.parameterStart]
        try scope.validateInput(parameter: environmentLane, input: <LlvmValueInput lane=<LlvmLogicalParameter type=environmentLane.type semanticType=environmentLane.semanticType copyable=environmentLane.copyable role=<LlvmParameterRole.Environment /> mode=<LlvmParameterMode.Borrow /> /> index=0U64 carrier=<LlvmValueCarrier.Value value=environment /> />, index: 0U64, function: caller)
        mut val values: Array[LlvmValueCarrier] = [<LlvmValueCarrier.Value value=environment />]
        mut val index = 0U64
        while index < arguments.count() {
            val input = arguments[index]
            try scope.validateInput(parameter: self.valueAbiParameters[abi.parameterStart + index + 1U64], input: input, index: index + 1U64, function: caller)
            values.append(input.carrier)
            index += 1U64
        }
        return self.emitPlannedValueCall(abiId: callee.template, function: function, arguments: values)
    }

    inout fn closureBodyParameter(function: LLVMValueRef, bodyId: U64, index: U64) -> Result[LlvmValueInput, CompileDiagnostic] {
        val abiId = self.valueAbiFunctions.getOr(key: LLVMIsAFunction(function), fallback: 0U64)
        if abiId == 0U64 || abiId > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "closure parameter descriptor missing") /> }
        val abi = self.valueAbis[abiId - 1U64]
        if abi.convention.key() != 12U64 || abi.ownerBody != bodyId || bodyId == 0U64 || index >= abi.parameterCount { return <Result.Err error=valueAbiFailure(message: "closure parameter body/convention/index mismatch") /> }
        return self.preparedValueParameter(function: function, abiId: abiId, index: index)
    }

    // Completed indirect entry readers share the physical Value/Home decoder.
    // Family wrappers validate the declared semantic owner before reaching it.
    inout fn preparedValueParameter(function: LLVMValueRef, abiId: U64, index: U64) -> Result[LlvmValueInput, CompileDiagnostic] {
        if abiId == 0U64 || abiId > self.valueAbis.count() || self.valueAbiFunctions.getOr(key: LLVMIsAFunction(function), fallback: 0U64) != abiId { return <Result.Err error=valueAbiFailure(message: "prepared typed entry descriptor mismatch") /> }
        val abi = self.valueAbis[abiId - 1U64]
        match abi.convention { LlvmValueConvention.Legacy(family: _) => { return <Result.Err error=valueAbiFailure(message: "legacy entry cannot use completed typed binding") /> } _ => {} }
        val scope = (try self.prepareValueAbiScope())
        try scope.validateScope()
        try scope.validateFunction(function: function, signature: abi.functionType)
        if index >= abi.parameterCount || abi.moduleIdentity != scope.moduleIdentity || abi.contextIdentity != scope.contextIdentity || abi.revision != 1U64 || abi.parameterStart > self.valueAbiParameters.count() || abi.parameterCount > self.valueAbiParameters.count() - abi.parameterStart { return <Result.Err error=valueAbiFailure(message: "prepared typed parameter scope/range mismatch") /> }
        val parameter = self.valueAbiParameters[abi.parameterStart + index]
        val carrier = match parameter.passing {
            LlvmValuePassing.Omitted => { give <LlvmValueCarrier.Value value=LLVMGetUndef(parameter.type) /> }
            LlvmValuePassing.Direct => { give <LlvmValueCarrier.Value value=LLVMGetParam(function, parameter.physicalIndex) /> }
            LlvmValuePassing.Indirect => { give <LlvmValueCarrier.Home address=LLVMGetParam(function, parameter.physicalIndex) /> }
            LlvmValuePassing.GuaranteedIndirect => { give <LlvmValueCarrier.Home address=LLVMGetParam(function, parameter.physicalIndex) /> }
        }
        val input = <LlvmValueInput lane=<LlvmLogicalParameter type=parameter.type semanticType=parameter.semanticType copyable=parameter.copyable role=parameter.role mode=parameter.mode /> index=index carrier=carrier />
        try scope.validateInput(parameter: parameter, input: input, index: index, function: function)
        return <Result.Ok value=input />
    }

    // Only finalized callable facts decide the normal logical roles and modes.
    // The representation leaf sees no Comp, AST, witness search or source name.
    inout fn bodyValueAbi(c: inout Comp, bodyId: U64) -> Result[U64, CompileDiagnostic] {
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() || !c.arena.bodyIsCallable(bodyId: bodyId) { return <Result.Err error=valueAbiFailure(message: "normal convention lacks a callable body") /> }
        val body = c.arena.bodyInstanceAt(index: bodyId - 1U64)
        if body.fnIdx >= c.arena.functionCount() { return <Result.Err error=valueAbiFailure(message: "normal convention has an invalid function") /> }
        val declaration = c.arena.functionAt(index: body.fnIdx)
        val signature = c.arena.bodySignature(bodyId: bodyId)
        if !signature.ready || signature.closureSignatureId != 0U64 || signature.parameterTypes.count() != signature.parameterPassings.count() || declaration.isAsync || declaration.isExtern || c.nameIsMain(f: declaration) || declaration.hasRecv != (signature.receiverType != 0U64) { return <Result.Err error=valueAbiFailure(message: "normal body signature is incomplete or belongs to another entry convention") /> }
        mut val parameters: Array[LlvmLogicalParameter] = []
        if signature.receiverType != 0U64 {
            val mode = match signature.receiverPassing {
                CallReceiverPassing.Borrow => { give <LlvmParameterMode.Borrow /> }
                CallReceiverPassing.Move => { give <LlvmParameterMode.Move /> }
                CallReceiverPassing.Inout => { give <LlvmParameterMode.Inout /> }
                CallReceiverPassing.None => { return <Result.Err error=valueAbiFailure(message: "receiver has no passing mode") /> }
            }
            val type = if mode.key() == 2U64 { give self.ptrty } else { give (try self.llvmTypeOfRef(c: inout c, ref: signature.receiverType)) }
            parameters.append(<LlvmLogicalParameter type=type semanticType=signature.receiverType copyable=!c.arena.typeTermIsUnique(ref: signature.receiverType) role=<LlvmParameterRole.Receiver /> mode=mode />)
        } else {
            match signature.receiverPassing { CallReceiverPassing.None => {} _ => { return <Result.Err error=valueAbiFailure(message: "free signature carries a receiver mode") /> } }
        }
        mut val index = 0U64
        while index < signature.parameterTypes.count() {
            val mode = match signature.parameterPassings[index] {
                CallArgumentPassing.Borrow => { give <LlvmParameterMode.Borrow /> }
                CallArgumentPassing.Move => { give <LlvmParameterMode.Move /> }
                CallArgumentPassing.Inout => { give <LlvmParameterMode.Inout /> }
            }
            val type = if mode.key() == 2U64 { give self.ptrty } else { give (try self.llvmTypeOfRef(c: inout c, ref: signature.parameterTypes[index])) }
            parameters.append(<LlvmLogicalParameter type=type semanticType=signature.parameterTypes[index] copyable=!c.arena.typeTermIsUnique(ref: signature.parameterTypes[index]) role=<LlvmParameterRole.Ordinary index=index /> mode=mode />)
            index += 1U64
        }
        val result = if signature.resultType == 0U64 { give self.voidty } else { give (try self.llvmTypeOfRef(c: inout c, ref: signature.resultType)) }
        return self.saveValueAbi(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=parameters result=result resultTerm=signature.resultType />, ownerBody: bodyId)
    }

    inout fn declareProgramCallables(c: inout Comp) -> Result[(), CompileDiagnostic] {
        try self.registerFinalLayoutNames(c: inout c)
        try self.registerFinalStructBodies(c: inout c)
        tracePhase(c: inout c, label: "backend:types:done")
        try self.declareGenFns(c: inout c)
        try self.declareGenMethods(c: inout c)
        try self.declareAsyncFns(c: inout c)
        try self.collectClosures(c: inout c)
        try self.declareRequestedSynthetic(c: inout c)
        tracePhase(c: inout c, label: "backend:declarations:done")
        return <Result.Ok value=() />
    }

    // A synthetic body can be the demand root even when the expression that
    // normally registers its thunk belongs to a different LLVM module.
    inout fn declareRequestedSynthetic(c: inout Comp) -> Result[(), CompileDiagnostic] {
        val bodyId = match self.emission {
            LlvmBodyEmission.Whole => { return <Result.Ok value=() /> }
            LlvmBodyEmission.Declarations => { return <Result.Ok value=() /> }
            LlvmBodyEmission.Requested(bodyId: val requested) => { give requested }
        }
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "LLVM backend: invalid requested body identity") />
        }
        match c.arena.bodyOrigin(bodyId: bodyId) {
            BodyOrigin.Callable => {}
            BodyOrigin.ClosureEnvironmentDrop(closureBodyId: val closureBodyId) => {
                val slot = self.closureSlot(bodyId: closureBodyId)
                if slot >= self.closures.count() {
                    return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "LLVM backend: requested environment drop has no closure signature") />
                }
                val ignored = (try self.declareClosureEnvironmentDrop(c: inout c, closureSlot: slot))
            }
            BodyOrigin.ExistentialWitness(resolution: val resolution, member: val member) => {
                val sourceRef = c.arena.finalExistentials[resolution].sourceRef
                val structIndex = (try self.structIdxOfRef(c: inout c, ref: sourceRef))
                if structIndex >= c.arena.structCount() {
                    return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "LLVM backend: requested witness has no concrete struct layout") />
                }
                val ignored = (try self.buildAnyThunk(c: inout c, resolutionIndex: resolution, sidx: structIndex, idx: member))
            }
        }
        return <Result.Ok value=() />
    }

    fn wholeProgram() -> Bool {
        match self.emission {
            LlvmBodyEmission.Whole => { return true }
            LlvmBodyEmission.Declarations => { return false }
            LlvmBodyEmission.Requested(bodyId: _) => { return false }
        }
    }

    inout fn admitBody(bodyId: U64) -> Bool {
        match self.emission {
            LlvmBodyEmission.Whole => { return true }
            LlvmBodyEmission.Declarations => { return false }
            LlvmBodyEmission.Requested(bodyId: val requested) => {
                if bodyId == 0U64 || bodyId != requested { return false }
                self.requestedBodyEmitted = true
                return true
            }
        }
    }

    // Body symbols can be resolved across requested modules. Local ARC/layout
    // glue keeps ordinary internal linkage and uses the same physical ABI.
    inout fn declareLegacyBodyFunction(name: CPtr[U8], signature: LLVMTypeRef, bodyId: U64, family: LlvmLegacyConvention) -> Result[LLVMValueRef, CompileDiagnostic] {
        val abiId = (try self.legacyValueAbi(signature: signature, family: family, ownerBody: bodyId))
        return self.declarePlannedBodyFunction(name: name, abiId: abiId, bodyId: bodyId)
    }

    inout fn declarePlannedBodyFunction(name: CPtr[U8], abiId: U64, bodyId: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        if abiId == 0U64 || abiId > self.valueAbis.count() || self.valueAbis[abiId - 1U64].ownerBody != bodyId { return <Result.Err error=valueAbiFailure(message: "declaration body/descriptor mismatch") /> }
        val function = (try self.declarePlannedValueFunction(name: name, abiId: abiId))
        if !self.wholeProgram() { LLVMSetLinkage(function, 0U32) }
        self.attachBodyIdentity(function: function, bodyId: bodyId)
        return <Result.Ok value=function />
    }

    // Frozen semantic identity travels with the declaration, independently of
    // symbol spelling and physical entry count (for example async entry/resume).
    fn attachBodyIdentity(function: LLVMValueRef, bodyId: U64) {
        if self.wholeProgram() { return }
        val name = <CString.copied text="plew.body" />
        val kind = LLVMGetMDKindIDInContext(self.ctx, name.ptr, 9U32)
        val operands = [LLVMValueAsMetadata(LLVMConstInt(self.i64ty, bodyId, 0I32))]
        LLVMGlobalSetMetadata(function, kind, LLVMMDNodeInContext2(self.ctx, arrayCPtr(operands), 1U64))
    }

    // Only explicitly declared foreign/runtime symbols may resolve in the host.
    // A missing source body must never bind to compiler machine code by name.
    fn attachHostIdentity(function: LLVMValueRef) {
        if self.wholeProgram() { return }
        val name = <CString.copied text="plew.host" />
        val operands: Array[LLVMMetadataRef] = []
        LLVMGlobalSetMetadata(function, LLVMGetMDKindIDInContext(self.ctx, name.ptr, 9U32), LLVMMDNodeInContext2(self.ctx, arrayCPtr(operands), 0U64))
    }


    inout fn declarePlannedValueFunction(name: CPtr[U8], abiId: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        if abiId == 0U64 || abiId > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "declaration descriptor is missing") /> }
        val abi = self.valueAbis[abiId - 1U64]
        val scope = (try self.prepareValueAbiScope())
        if abi.moduleIdentity != scope.moduleIdentity || abi.contextIdentity != scope.contextIdentity || abi.revision != 1U64 { return <Result.Err error=valueAbiFailure(message: "declaration descriptor has foreign scope/revision") /> }
        try scope.validateScope()
        // Generated symbols must never collide with a source-level external
        // name. Dots cannot occur in a Plew function identifier. Keep this
        // namespace stable across separately requested LLVM modules as well.
        val internalName = <CString.copied text="plew.body." + stringFromCString(name) />
        val function = LLVMAddFunction(self.mod, internalName.ptr, abi.functionType)
        LLVMSetLinkage(function, 8U32)
        // The iteration/attribute binding uses a nullable integer handle at
        // the FFI floor. Resolve the actual (possibly uniqued) LLVM symbol.
        val handle = LLVMGetNamedFunction(self.mod, LLVMGetValueName(function))
        self.valueAbiFunctions[handle] = abiId
        mut val index = 0U64
        while index < abi.parameterCount {
            val parameter = self.valueAbiParameters[abi.parameterStart + index]
            self.attachValueParameterAttributes(value: function, parameter: parameter, call: false)
            index += 1U64
        }
        return <Result.Ok value=function />
    }

    // Use the actual builder's function: physical thunks may be emitted while
    // another source body is active. Entry allocation prevents loop stack growth.
    inout fn valueAbiSlot(type~: LLVMTypeRef) -> LLVMValueRef {
        val entry = LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(LLVMGetInsertBlock(self.b)))
        val builder = LLVMCreateBuilderInContext(self.ctx)
        LLVMPositionBuilder(builder, entry, LLVMGetFirstInstruction(entry))
        val slot = LLVMBuildAlloca(builder, type, anon())
        LLVMDisposeBuilder(builder)
        return slot
    }


    inout fn byrefAttributeKind() -> U32 {
        if self.valueAbiByrefKind == 0U32 {
            val name = <CString.copied text="byref" />
            self.valueAbiByrefKind = LLVMGetEnumAttributeKindForName(name.ptr, 5U64)
        }
        return self.valueAbiByrefKind
    }

    inout fn valueAlignAttributeKind() -> U32 {
        if self.valueAbiAlignKind == 0U32 {
            val name = <CString.copied text="align" />
            self.valueAbiAlignKind = LLVMGetEnumAttributeKindForName(name.ptr, 5U64)
        }
        return self.valueAbiAlignKind
    }

    fn attachValueAttribute(value: LLVMValueRef, index: U32, attribute: LLVMAttributeRef, call: Bool) {
        if call { LLVMAddCallSiteAttribute(value, index, attribute) }
        else { LLVMAddAttributeAtIndex(LLVMIsAFunction(value), index, attribute) }
    }

    inout fn attachValueParameterAttributes(value: LLVMValueRef, parameter: LlvmValueParameter, call: Bool) {
        val kind = match parameter.passing {
            LlvmValuePassing.Indirect => { give self.byvalAttributeKind() }
            LlvmValuePassing.GuaranteedIndirect => { give self.byrefAttributeKind() }
            _ => { return }
        }
        val index = truncU32(n: parameter.physicalIndex + 1U64)
        self.attachValueAttribute(value: value, index: index, attribute: LLVMCreateTypeAttribute(self.ctx, kind, parameter.type), call: call)
        if parameter.passing.key() == 3U64 {
            self.attachValueAttribute(value: value, index: index, attribute: LLVMCreateEnumAttribute(self.ctx, self.valueAlignAttributeKind(), parameter.valueAlignment), call: call)
        }
    }

    // Typed carriers survive to this sole transport owner. An incoming byref
    // home can forward; every unproved Value/Home still supplies a snapshot.
    inout fn emitPlannedValueCall(abiId: U64, function: LLVMValueRef, arguments: Array[LlvmValueCarrier]) -> Result[LLVMValueRef, CompileDiagnostic] {
        val abi = self.valueAbis[abiId - 1U64]
        mut val values: Array[LLVMValueRef] = []
        mut val index = 0U64
        while index < arguments.count() {
            val carrier = arguments[index]
            val parameter = self.valueAbiParameters[abi.parameterStart + index]
            match parameter.passing {
                LlvmValuePassing.Omitted => {}
                LlvmValuePassing.Direct => { values.append(self.valueCarrierValue(carrier: carrier, type: parameter.type)) }
                LlvmValuePassing.Indirect => {
                    val slot = self.valueAbiSlot(parameter.type)
                    llvmStore(self.b, self.valueCarrierValue(carrier: carrier, type: parameter.type), slot)
                    values.append(slot)
                }
                LlvmValuePassing.GuaranteedIndirect => {
                    val incoming = match carrier {
                        LlvmValueCarrier.StableHome(address: val address, planId: val planId, useId: val useId, operation: val operation) => { try self.validateStableHome(address: address, planId: planId, useId: useId, operation: operation, type: parameter.type, role: parameter.role) give true }
                        LlvmValueCarrier.Home(address: val address) => { give plew_llvm_guaranteed_parameter_matches(address, parameter.type, parameter.valueAlignment) != 0I32 }
                        _ => { give false }
                    }
                    if incoming {
                        match carrier { LlvmValueCarrier.Home(address: val address) => { values.append(address) } LlvmValueCarrier.StableHome(address: val address, planId: _, useId: _, operation: _) => { values.append(address) } _ => {} }
                    } else {
                        val slot = self.valueAbiSlot(parameter.type)
                        LLVMSetAlignment(slot, truncU32(n: parameter.valueAlignment))
                        llvmStore(self.b, self.valueCarrierValue(carrier: carrier, type: parameter.type), slot)
                        values.append(slot)
                    }
                }
            }
            index += 1U64
        }
        val call = LLVMBuildCall2(self.b, abi.functionType, function, arrayCPtr(values), values.count(), anon())
        index = 0U64
        while index < abi.parameterCount {
            self.attachValueParameterAttributes(value: call, parameter: self.valueAbiParameters[abi.parameterStart + index], call: true)
            index += 1U64
        }
        return <Result.Ok value=call />
    }

    inout fn bodyInputScope(bodyId: U64, signature: LLVMTypeRef) -> Result[LlvmInputScope, CompileDiagnostic] {
        val scope = (try self.prepareValueAbiScope())
        return <Result.Ok value=<LlvmInputScope moduleIdentity=scope.moduleIdentity contextIdentity=scope.contextIdentity revision=1U64 bodyIdentity=bodyId signature=signature /> />
    }

    inout fn callBodyValueFunction(function: LLVMValueRef, bodyId: U64, inputs: LlvmInputScope, arguments: Array[LlvmValueInput]) -> Result[LLVMValueRef, CompileDiagnostic] {
        return self.callTypedBodyValueFunction(function: function, bodyId: bodyId, inputs: inputs, arguments: arguments, conventionKey: 0U64)
    }

    inout fn callTypedBodyValueFunction(function: LLVMValueRef, bodyId: U64, inputs: LlvmInputScope, arguments: Array[LlvmValueInput], conventionKey: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        if conventionKey != 0U64 && conventionKey != 15U64 && conventionKey != 16U64 && conventionKey != 18U64 { return <Result.Err error=valueAbiFailure(message: "typed body consumer requires a normal or async convention") /> }
        val handle = LLVMIsAFunction(function)
        val abiId = self.valueAbiFunctions.getOr(key: handle, fallback: 0U64)
        if handle == 0U64 || abiId == 0U64 { return <Result.Err error=valueAbiFailure(message: "normal call lacks a declared body descriptor") /> }
        val abi = self.valueAbis[abiId - 1U64]
        if abi.convention.key() != conventionKey || bodyId == 0U64 || abi.ownerBody != bodyId || abi.parameterCount != arguments.count() { return <Result.Err error=valueAbiFailure(message: "normal call body/convention/count mismatch") /> }
        val scope = (try self.prepareValueAbiScope())
        try scope.validateInputs(scope: inputs, bodyIdentity: abi.ownerBody, signature: abi.logicalSignature)
        val caller = LLVMGetBasicBlockParent(LLVMGetInsertBlock(self.b))
        mut val values: Array[LlvmValueCarrier] = []
        mut val index = 0U64
        while index < arguments.count() {
            val input = arguments[index]
            val parameter = self.valueAbiParameters[abi.parameterStart + index]
            try scope.validateInput(parameter: parameter, input: input, index: index, function: caller)
            values.append(input.carrier)
            index += 1U64
        }
        return self.emitPlannedValueCall(abiId: abiId, function: function, arguments: values)
    }

    fn valueInputValue(input: LlvmValueInput) -> LLVMValueRef {
        return self.valueCarrierValue(carrier: input.carrier, type: input.lane.type)
    }

    fn valueCarrierValue(carrier: LlvmValueCarrier, type: LLVMTypeRef) -> LLVMValueRef {
        return match carrier {
            LlvmValueCarrier.Value(value: val value) => { give value }
            LlvmValueCarrier.Home(address: val address) => { give llvmLoad(self.b, type, address, anon()) }
            LlvmValueCarrier.StableHome(address: val address, planId: _, useId: _, operation: _) => { give llvmLoad(self.b, type, address, anon()) }
        }
    }

    // The verified normal Mid parameter prefix supplies local role and passing.
    // Its semantic correspondence permits distinct but structurally equal local
    // TypeRef IDs; only the stored canonical signature term crosses this edge.
    inout fn normalBodyParameter(function: LLVMValueRef, bodyId: U64, index: U64, type: LLVMTypeRef, mode: LlvmParameterMode) -> Result[LlvmValueInput, CompileDiagnostic] {
        val handle = LLVMIsAFunction(function)
        val abiId = self.valueAbiFunctions.getOr(key: handle, fallback: 0U64)
        if handle == 0U64 || abiId == 0U64 { return <Result.Err error=valueAbiFailure(message: "normal parameter lacks a descriptor") /> }
        val abi = self.valueAbis[abiId - 1U64]
        if abi.convention.key() != 0U64 || bodyId == 0U64 || abi.ownerBody != bodyId || index >= abi.parameterCount { return <Result.Err error=valueAbiFailure(message: "normal parameter body/convention/index mismatch") /> }
        val parameter = self.valueAbiParameters[abi.parameterStart + index]
        val carrier = match parameter.passing {
            LlvmValuePassing.Omitted => { give <LlvmValueCarrier.Value value=LLVMGetUndef(parameter.type) /> }
            LlvmValuePassing.Direct => { give <LlvmValueCarrier.Value value=LLVMGetParam(function, parameter.physicalIndex) /> }
            LlvmValuePassing.Indirect => { give <LlvmValueCarrier.Home address=LLVMGetParam(function, parameter.physicalIndex) /> }
            LlvmValuePassing.GuaranteedIndirect => { give <LlvmValueCarrier.Home address=LLVMGetParam(function, parameter.physicalIndex) /> }
        }
        val input = <LlvmValueInput lane=<LlvmLogicalParameter type=type semanticType=parameter.semanticType copyable=parameter.copyable role=parameter.role mode=mode /> index=index carrier=carrier />
        val scope = (try self.prepareValueAbiScope())
        try scope.validateInput(parameter: parameter, input: input, index: index, function: function)
        return <Result.Ok value=input />
    }

    // This row was admitted against the exact function and native signature.
    // No function-name lookup or physical classification is repeated here.
    inout fn preparedLegacyParameter(parameterIndex: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        if parameterIndex >= self.valueAbiParameters.count() { return <Result.Err error=valueAbiFailure(message: "prepared parameter index out of range") /> }
        val abiId = self.valueAbiFunctions.getOr(key: LLVMIsAFunction(self.curFn), fallback: 0U64)
        if abiId == 0U64 || abiId > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "raw parameter entry descriptor missing") /> }
        val abi = self.valueAbis[abiId - 1U64]
        match abi.convention { LlvmValueConvention.Legacy(family: val family) => { if family.key() != 1U64 { return <Result.Err error=valueAbiFailure(message: "legacy parameter requires the unsupported closure convention") /> } } LlvmValueConvention.ProgramMain => { return <Result.Err error=valueAbiFailure(message: "program main requires typed binding") /> } LlvmValueConvention.GlobalInitializer => { return <Result.Err error=valueAbiFailure(message: "global initializer requires typed binding") /> } LlvmValueConvention.AsyncEntry => { return <Result.Err error=valueAbiFailure(message: "completed async entry cannot use raw binding") /> } LlvmValueConvention.AsyncResume => { return <Result.Err error=valueAbiFailure(message: "completed async resume cannot use raw binding") /> } LlvmValueConvention.OwnershipGlue(operation: _) => { return <Result.Err error=valueAbiFailure(message: "completed glue cannot use raw binding") /> } LlvmValueConvention.Closure => { return <Result.Err error=valueAbiFailure(message: "completed closure cannot use raw prepared binding") /> } LlvmValueConvention.Witness(targetType: _, traitIndex: _, slot: _) => { return <Result.Err error=valueAbiFailure(message: "completed witness cannot use raw prepared binding") /> } LlvmValueConvention.Body => { return <Result.Err error=valueAbiFailure(message: "normal body cannot use raw prepared binding") /> } }
        if parameterIndex < abi.parameterStart || parameterIndex - abi.parameterStart >= abi.parameterCount { return <Result.Err error=valueAbiFailure(message: "raw parameter belongs to a different entry") /> }
        val parameter = self.valueAbiParameters[parameterIndex]
        return <Result.Ok value=match parameter.passing {
            LlvmValuePassing.Omitted => { give LLVMGetUndef(parameter.type) }
            LlvmValuePassing.Direct => { give LLVMGetParam(self.curFn, parameter.physicalIndex) }
            LlvmValuePassing.Indirect => { give llvmLoad(self.b, parameter.type, LLVMGetParam(self.curFn, parameter.physicalIndex), anon()) }
            LlvmValuePassing.GuaranteedIndirect => { return <Result.Err error=valueAbiFailure(message: "legacy parameter cannot bind a guaranteed home") /> }
        } />
    }

}
