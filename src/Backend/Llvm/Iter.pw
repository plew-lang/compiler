// Part of the LLVM backend (root: _.pw): iterator map / filter adapter construction.

// ---- iterator adapter (map/filter) construction ----
//
// `xs.map(f)` / `xs.filter(p)` are lazy combinators (@Std/Core Iterator provided
// methods): each just WRAPS the receiver iterator + the closure into an adapter
// struct (MapIter/FilterIter) whose `next()` does the work. The provided method
// has its own type param (B) and an associated-type `Item` in its signature —
// monomorphizing its body is hard — but the body is a one-line construction
// `<MapIter inner=self f=f />`, so we build the adapter inline at the call site
// instead. The adapter instance is already registered (front-end mono), found
// through the final callable's concrete result type.
//

pub impl LlvmCtx {
    // An iterator adapter is an inline implementation detail of exactly the
    // selected std provided method.  Mono stores its grounded result TypeRef in
    // the final-callable descriptor; do not search registered instances by the
    // receiver (two map calls on the same iterator may have different outputs).
    inout fn adapterResultForFinalMethod(c: inout Comp, finalMfi: U64, resultRef: U64) -> U64 {
        if finalMfi >= c.arena.funcs.count() || resultRef == 0U64 || resultRef >= c.arena.types.count() { return 0U64 }
        val f: Func = c.arena.funcs[finalMfi]
        if !(f.isProvided) { return 0U64 }
        val nameStart: U64 = f.nameStart
        val nameLen: U64 = f.nameLen
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "map") {
            val t: TypeRef = c.arena.types[resultRef]
            if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "MapIter") { return resultRef }
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "filter") {
            val t: TypeRef = c.arena.types[resultRef]
            if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "FilterIter") { return resultRef }
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "take") {
            val t: TypeRef = c.arena.types[resultRef]
            if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "TakeIter") { return resultRef }
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "skip") {
            val t: TypeRef = c.arena.types[resultRef]
            if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "SkipIter") { return resultRef }
        }
        if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "enumerate") {
            val t: TypeRef = c.arena.types[resultRef]
            if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "EnumerateIter") { return resultRef }
        }
        return 0U64
    }

    // Build the adapter struct value inline: field 0 (the inner) = the receiver, the
    // remaining fields = the method args in order (map's `f`, filter's `p`), under the
    // adapter instance's substitution env. Mirrors the provided method's one-line body
    // `<MapIter inner=self f=f />` with `self` = the receiver.
    inout fn genLlvmAdapterWrap(c: inout Comp, recv: U64, args: ArgRange, adapterRef: U64) -> LLVMValueRef {
        val gslot: U64 = self.genStructSlot(c: inout c, ref: adapterRef)
        if gslot >= self.genStructRefs.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: iterator adapter struct is not registered")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val sd: StructDef = c.arena.structs[self.genStructDefs[gslot]]
        mut val fields: Array[MakeField] = []
        // field 0 = inner = the receiver expression.
        fields.append(<MakeField nameStart=sd.fields[0].nameStart nameLen=sd.fields[0].nameLen value=recv />)
        mut val i: U64 = 1
        while i < sd.fields.count() {
            if i - 1U64 < args.len {
                fields.append(<MakeField nameStart=sd.fields[i].nameStart nameLen=sd.fields[i].nameLen value=c.argAt(args: args, index: i - 1U64).expr />)
            }
            i += 1
        }
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        c.cur.typeParams = sd.typeParams
        c.cur.typeArgs = c.arena.types[adapterRef].args
        val v: LLVMValueRef = self.buildStructValue(c: inout c, sd: sd, sty: self.genStructTys[gslot], fields: c.pushMakeFields(fields: fields), errOffset: c.exprOffset(id: recv))
        c.cur.typeParams = savedP
        c.cur.typeArgs = savedA
        return v
    }
}
