// Part of the LLVM backend (root: _.pw): FFI / lang-item dispatch, view-aware lookup, and argument emission.

// The LLVM type of an FFI parameter/return type span: a fixed-width integer /
// String / Bool maps to its scalar type; any other (an opaque `type` handle, a
// `CPtr[T]`) is an opaque pointer (spec/15).

pub impl LlvmCtx {
    inout fn ffiTyOf(c: inout Comp, tyStart: U64, tyLen: U64) -> LLVMTypeRef {
        if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
            return self.llvmScalarTy(c: inout c, tyStart: tyStart, tyLen: tyLen)
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "String") {
            return self.strty
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Bool") {
            return self.i1ty
        }
        return self.ptrty
    }

    // Emit a method call `recv.m(args)`: resolve the method on the receiver's struct,
    // pass self first (a pointer for `inout fn`, else the struct value), then the
    // coerced arguments, and call the cached LLVMValueRef.
    // The primitive lang-item type-name of a method receiver that isn't a registered
    // struct (String, or a suffixed integer literal like `42I64`), for dispatching
    // `(42I64).format(...)` / `s.isEmpty()`. nameLen 0 if not such a receiver.
    inout fn primLangItemRecvName(c: inout Comp, recv: U64) -> Bind {
        match c.arena.exprs[recv] {
            Expr.Int(value: _, offset: _, isBool: _, val tyStart, val tyLen, isNeg: _) => {
                if tyLen > 0U64 {
                    if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
                        return <Bind nameStart=tyStart nameLen=tyLen fieldStart=tyStart fieldLen=tyLen />
                    }
                }
            }
            Expr.Ident(val start, val len) => {
                // a primitive-int local/param (`v: U64`): its tracked type name (locTypeRef),
                // so `v.hash[H](…)` dispatches on the primitive.
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    val tr: U64 = self.locTypeRef[li]
                    if tr != 0U64 {
                        val t: TypeRef = c.arena.types[tr]
                        if isPrimIntName(c: inout c, start: t.nameStart, len: t.nameLen) {
                            return <Bind nameStart=t.nameStart nameLen=t.nameLen fieldStart=t.nameStart fieldLen=t.nameLen />
                        }
                    }
                }
            }
            Expr.Cast(operand: _, val tyStart, val tyLen, ty: _) => {
                // `(self as I64).format(...)`: the cast target's primitive type.
                if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
                    return <Bind nameStart=tyStart nameLen=tyLen fieldStart=tyStart fieldLen=tyLen />
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                // a primitive-typed struct field (`self.a` where a: U64): its field type
                // name, for dispatching a method on the primitive (`self.a.absorb[S](…)`).
                val bsi: U64 = self.exprStructIdx(c: inout c, id: base)
                if bsi < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[bsi].fields.count() {
                        val fd: FieldDef = c.arena.structs[bsi].fields[fidx]
                        if isPrimIntName(c: inout c, start: fd.tyStart, len: fd.tyLen) {
                            return <Bind nameStart=fd.tyStart nameLen=fd.tyLen fieldStart=fd.tyStart fieldLen=fd.tyLen />
                        }
                    }
                }
            }
            _ => {}
        }
        // a Bool receiver (`b.hash[H](…)`, `flag.eq(…)`): the backend models Bool method
        // dispatch like a primitive lang-item. Recover the type from the grounded env
        // (`exprTypeRef` applies the instance args, so a generic `K` param bound to Bool
        // resolves here). Bool's only resolvable structured form is its own name.
        val rt: U64 = self.exprTypeRef(c: inout c, id: recv)
        if rt != 0U64 {
            if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[rt].nameStart, len: c.arena.types[rt].nameLen, kw: "Bool") {
                return c.kwSpan(kw: "Bool", kwLen: 4U64)
            }
        }
        val z: Bind = <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
        return z
    }

    // The stack of extension-view ids active on an expression's value (spec/09),
    // outermost first: nested `v#A#B` re-view nodes contribute B then A; a `#!Ext`
    // strip ends the chain (views below it are dropped); the unwrapped base value's
    // own type view (a `Type#Ext` param/binding) is appended last. Empty = no view.
    inout fn collectViewChain(c: inout Comp, id: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val cur: U64 = id
        mut val go: Bool = true
        while go {
            match c.arena.exprs[cur] {
                Expr.ExtView(recv: val r, srcStart: val ss, srcLen: val sl, strip: val strp) => {
                    if strp {
                        go = false
                    } else {
                        out.append(intern(c: inout c, start: ss, len: sl))
                        cur = r
                    }
                }
                _ => { go = false }
            }
        }
        val r: U64 = self.exprTypeRef(c: inout c, id: cur)
        if r != 0U64 {
            if c.arena.types[r].viewExtId != 0U64 {
                out.append(c.arena.types[r].viewExtId)
            }
        }
        return out
    }

    // Whether function `fi`'s parameter views match the call's argument views — each
    // param's declared viewExtId equals the corresponding argument's actual view
    // (spec/09). Used to pick the right overload among `f(a:P)` / `f(a:P#Ext)`.
    inout fn funcViewsMatch(c: inout Comp, fi: U64, args: Array[Arg]) -> Bool {
        val f: Func = c.arena.funcs[fi]
        mut val i: U64 = 0
        while i < args.count() {
            if i < f.params.count() {
                mut val pv: U64 = 0
                if f.params[i].ty != 0U64 {
                    pv = c.arena.types[f.params[i].ty].viewExtId
                }
                if pv != self.exprViewExtId(c: inout c, id: args[i].expr) {
                    return false
                }
            }
            i += 1
        }
        return true
    }

    // Resolve a free-function call, refining a view-blind match by parameter views so
    // `f(a: P)` and `f(a: P#Ext)` coexist and select on the arguments' views (spec/09).
    // Falls back to the view-blind result if no view-matching overload exists (the
    // view-mismatch enforcement at genArgValue then reports it).
    inout fn findFuncViewAware(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        val base: U64 = c.findFunc(nameStart: nameStart, nameLen: nameLen, args: args)
        if base >= c.arena.funcs.count() {
            return base
        }
        if self.funcViewsMatch(c: inout c, fi: base, args: args) {
            return base
        }
        // the front-end type check (paramsTypesMatch) can't see a local argument's
        // struct type (it falls back to a label-only match — so base is first-by-label).
        // Among same-name, same-label, same-param-type-head candidates, pick the one
        // whose views match the arguments (the backend can recover views). This is what
        // makes `f(a: P)` / `f(a: P#Ext)` select on the call's views.
        val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < c.arena.funcs.count() {
            val f: Func = c.arena.funcs[i]
            if !(f.hasRecv) {
                if !(f.isAssoc) {
                    if f.nameId == qName {
                        if c.paramsLabelsOk(params: f.params, args: args) {
                            if sameParamTypeHeads(c: inout c, a: c.arena.funcs[base].params, b: f.params) {
                                if self.funcViewsMatch(c: inout c, fi: i, args: args) {
                                    return i
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        return base
    }
}

pub impl LlvmCtx {

    // The extension-view id active on an expression's value (spec/09): a direct
    // `v#Ext` re-view node carries it; otherwise it comes from the value's static
    // type (a param/binding typed `Type#Ext`). 0 = no view.
    inout fn exprViewExtId(c: inout Comp, id: U64) -> U64 {
        match c.arena.exprs[id] {
            Expr.ExtView(recv: _, val srcStart, val srcLen, val strip) => {
                // `#!Ext` strips the view → plain (bare) resolution; `#Ext` selects it.
                if strip {
                    return 0U64
                }
                return intern(c: inout c, start: srcStart, len: srcLen)
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                // a call to a `-> Type#Ext` function yields a viewed value.
                val fi: U64 = c.resolvedCallee(id: id)
                if fi < c.arena.funcs.count() {
                    if c.arena.funcs[fi].retTy != 0U64 {
                        return c.arena.types[c.arena.funcs[fi].retTy].viewExtId
                    }
                }
                return 0U64
            }
            _ => {}
        }
        val r: U64 = self.exprTypeRef(c: inout c, id: id)
        if r != 0U64 {
            return c.arena.types[r].viewExtId
        }
        return 0U64
    }
}
