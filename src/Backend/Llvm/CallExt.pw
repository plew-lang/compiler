// Part of the LLVM backend (root: _.pw): FFI / lang-item dispatch, view-aware lookup, and argument emission.

// The LLVM type of an FFI parameter/return type span: a fixed-width integer /
// String / Bool maps to its scalar type; any other (an opaque `type` handle, a
// `CPtr[T]`) is an opaque pointer (spec/15).

pub impl LlvmCtx {

    // C scalar/pointer ABI slice. Consume grounded types, never recover a
    // signature from the spelling at a call site. Narrow integers require
    // target ABI extension attributes; aggregates require C classification.
    // Neither may silently inherit the ordinary Plew calling convention.
    inout fn resolvedCTypeSupported(c: inout Comp, ref: U64) -> Bool {
        if ref == 0U64 || ref >= c.arena.types.count() { return false }
        val ty: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: ref)
        val kind: U32 = LLVMGetTypeKind(ty)
        if kind == 12U32 { return true }
        if kind == 8U32 { return LLVMGetIntTypeWidth(ty) >= 32U32 }
        val term: TypeRef = c.arena.types[ref]
        // F32 currently has a double Plew representation, not a C float ABI.
        return kind == 3U32 && rangeEquals(bytes: c.arena.bytes, start: term.nameStart, len: term.nameLen, kw: "F64")
    }

    inout fn resolvedCCallSupported(c: inout Comp, selected: CallResolution) -> Bool {
        if selected.callee >= c.arena.funcs.count() { return false }
        val declaration: Func = c.arena.funcs[selected.callee]
        if !declaration.isExtern || !declaration.isCExtern || declaration.hasRecv || declaration.isAsync { return false }
        if declaration.typeParams.count() != 0U64 || selected.parameterTypeRefs.count() != declaration.params.count() { return false }
        val parameters: Array[U64] = c.copyFinalCalleeParameterTypes(types: selected.parameterTypeRefs)
        mut val index: U64 = 0U64
        while index < parameters.count() {
            if !self.resolvedCTypeSupported(c: inout c, ref: parameters[index]) { return false }
            index += 1U64
        }
        return !declaration.hasRet || self.resolvedCTypeSupported(c: inout c, ref: selected.resultTypeRef)
    }

    // Both Mid and the remaining legacy caller use one declaration cache and
    // one finalized signature. The source span below spells only the selected
    // foreign symbol; it does not resolve a callable or a type.
    inout fn declareResolvedCFunction(c: inout Comp, selected: CallResolution) -> U64 {
        val declaration: Func = c.arena.funcs[selected.callee]
        val key: U64 = declaration.nameId + 1000000000U64
        mut val slot: U64 = 0U64
        while slot < self.declId.count() {
            if self.declId[slot] == key { return slot }
            slot += 1U64
        }
        val parameters: Array[U64] = c.copyFinalCalleeParameterTypes(types: selected.parameterTypeRefs)
        mut val types: Array[LLVMTypeRef] = []
        mut val index: U64 = 0U64
        while index < parameters.count() {
            types.append(self.llvmTypeOfRef(c: inout c, ref: parameters[index]))
            index += 1U64
        }
        mut val result: LLVMTypeRef = self.voidty
        if declaration.hasRet { result = self.llvmTypeOfRef(c: inout c, ref: selected.resultTypeRef) }
        val signature: LLVMTypeRef = LLVMFunctionType(result, arrayCPtr(types), types.count(), 0I32)
        mut val symbol: Array[U8] = []
        index = 0U64
        while index < declaration.nameLen {
            symbol.append(c.arena.bytes[declaration.nameStart + index])
            index += 1U64
        }
        symbol.append(0U8)
        val function: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(symbol), signature)
        self.declId.append(key)
        self.declFn.append(function)
        self.declTy.append(signature)
        return slot
    }

    // The runtime representation ignores a view, but all source-sensitive
    // checks consume this complete unordered set.  Keep the scalar accessor
    // below only for old one-source callers while migrating them.
    inout fn typeViewIds(c: inout Comp, ref: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        if ref == 0U64 || ref >= c.arena.types.count() { return out }
        val t: TypeRef = c.arena.types[ref]
        out = t.viewIds
        if out.count() == 0U64 && t.viewExtId != 0U64 { out.append(t.viewExtId) }
        return out
    }
    inout fn ffiTyOf(c: inout Comp, tyStart: U64, tyLen: U64) -> LLVMTypeRef {
        if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
            return self.llvmScalarTy(c: inout c, tyStart: tyStart, tyLen: tyLen)
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "String") {
            return self.stringLlvmTy(c: inout c)
        }
        if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Bool") {
            return self.i1ty
        }
        return self.ptrty
    }

    // Emit a method call `recv.m(args)`: resolve the method on the receiver's struct,
    // pass self first (a pointer for `inout fn`, else the struct value), then the
    // coerced arguments, and call the cached LLVMValueRef.
    // The primitive lang-item type-name of a method receiver that isn't a registered
    // struct (String, or a suffixed integer literal like `42I64`), for dispatching
    // `(42I64).format(...)` / `s.isEmpty()`. nameLen 0 if not such a receiver.
    inout fn primLangItemRecvName(c: inout Comp, recv: U64) -> Bind {
        match c.arena.exprs[recv] {
            Expr.Int(value: _, offset: _, val isBool, val tyStart, val tyLen, isNeg: _) => {
                // a Bool literal (`true`/`false`) carries no type span (tyLen 0); its lang-item
                // is Bool, so a method on it (`true.format(…)`) dispatches on Bool.
                if isBool {
                    return c.kwSpan(kw: "Bool", kwLen: 4U64)
                }
                if tyLen > 0U64 {
                    if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
                        return <Bind nameStart=tyStart nameLen=tyLen fieldStart=tyStart fieldLen=tyLen />
                    }
                }
            }
            Expr.Float(start: _, len: _, val tyStart, val tyLen) => {
                // a float literal (`3.5F64`): dispatch a method on it (`(3.5F64).format(…)`) on
                // the suffixed float type, defaulting to F64 for an unsuffixed literal.
                if tyLen > 0U64 {
                    if c.isFloatType(start: tyStart, len: tyLen) {
                        return <Bind nameStart=tyStart nameLen=tyLen fieldStart=tyStart fieldLen=tyLen />
                    }
                }
                return c.kwSpan(kw: "F64", kwLen: 3U64)
            }
            Expr.Ident(val start, val len) => {
                // a primitive-int local/param (`v: U64`): its tracked type name (locTypeRef),
                // so `v.hash[H](…)` dispatches on the primitive.
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    val tr: U64 = self.locTypeRef[li]
                    if tr != 0U64 {
                        val t: TypeRef = c.arena.types[tr]
                        if isPrimIntName(c: inout c, start: t.nameStart, len: t.nameLen) {
                            return <Bind nameStart=t.nameStart nameLen=t.nameLen fieldStart=t.nameStart fieldLen=t.nameLen />
                        }
                    }
                }
            }
            Expr.Cast(operand: _, val tyStart, val tyLen, ty: _) => {
                // `(self as I64).format(...)`: the cast target's primitive type.
                if isPrimIntName(c: inout c, start: tyStart, len: tyLen) {
                    return <Bind nameStart=tyStart nameLen=tyLen fieldStart=tyStart fieldLen=tyLen />
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                // a primitive-typed struct field (`self.a` where a: U64): its field type
                // name, for dispatching a method on the primitive (`self.a.absorb[S](…)`).
                val bsi: U64 = self.exprStructIdx(c: inout c, id: base)
                if bsi < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: nameStart, len: nameLen)
                    if fidx < c.arena.structs[bsi].fields.count() {
                        val fd: FieldDef = c.arena.structs[bsi].fields[fidx]
                        if isPrimIntName(c: inout c, start: fd.tyStart, len: fd.tyLen) {
                            return <Bind nameStart=fd.tyStart nameLen=fd.tyLen fieldStart=fd.tyStart fieldLen=fd.tyLen />
                        }
                    }
                }
            }
            _ => {}
        }
        // a scalar receiver recovered from the grounded env (`b.hash[H](…)` on Bool,
        // `value.format(…)` on a generic `T` bound to F64 / an int / Bool): the backend models
        // every primitive lang-item's method dispatch by its type name. `exprTypeRef` applies
        // the instance args, so a type param bound to a scalar resolves here — bindOneParam
        // already pins a grounded int/float/Bool param's tracked ref to that concrete name.
        val rt: U64 = self.exprTypeRef(c: inout c, id: recv)
        if rt != 0U64 {
            val rtn: TypeRef = c.arena.types[rt]
            // a grounded int / float / Bool type-param receiver (`value.format(…)` in `print[I64]`
            // / `print[F64]` / `print[Bool]`), including a newtype over a primitive (`Meter = I64`
            // in `print[Meter]`): a newtype inherits the underlying's lang-item methods (spec/10),
            // so unwrap to the underlying prim name and recover it so the witness dispatches.
            // (newtypeUnderName is a no-op on a non-newtype, so a plain grounded primitive rides
            // the same path.)
            val u: Bind = c.newtypeUnderName(start: rtn.nameStart, len: rtn.nameLen)
            if isPrimIntName(c: inout c, start: u.nameStart, len: u.nameLen) {
                return <Bind nameStart=u.nameStart nameLen=u.nameLen fieldStart=u.nameStart fieldLen=u.nameLen />
            }
            if c.isFloatType(start: u.nameStart, len: u.nameLen) {
                return <Bind nameStart=u.nameStart nameLen=u.nameLen fieldStart=u.nameStart fieldLen=u.nameLen />
            }
            if rangeEquals(bytes: c.arena.bytes, start: u.nameStart, len: u.nameLen, kw: "Bool") {
                return c.kwSpan(kw: "Bool", kwLen: 4U64)
            }
        }
        val z: Bind = <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
        return z
    }

    // The stack of extension-view ids active on an expression's value (spec/09),
    // outermost first: nested `v#A#B` re-view nodes contribute B then A; a `#!Ext`
    // strip ends the chain (views below it are dropped); the unwrapped base value's
    // own type view (a `Type#Ext` param/binding) is appended last. Empty = no view.
    inout fn collectViewChain(c: inout Comp, id: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        // A call result has no syntactic ExtView node to walk. Mono records its
        // fully-grounded result ref with the final target; do not re-derive it
        // from a declaration or AST form here.
        match c.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return self.typeViewIds(c: inout c, ref: c.bodyCalleeResultRef(exprId: id))
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return self.typeViewIds(c: inout c, ref: c.bodyCalleeResultRef(exprId: id))
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return self.typeViewIds(c: inout c, ref: c.bodyCalleeResultRef(exprId: id))
            }
            _ => {}
        }
        mut val cur: U64 = id
        mut val go: Bool = true
        while go {
            match c.arena.exprs[cur] {
                Expr.ExtView(recv: val r, source: val source, strip: val strp) => {
                    if strp {
                        go = false
                    } else {
                        out.append(source.surfaceId)
                        cur = r
                    }
                }
                _ => { go = false }
            }
        }
        val r: U64 = self.exprTypeRef(c: inout c, id: cur)
        if r != 0U64 {
            val rt: TypeRef = c.arena.types[r]
            mut val ri: U64 = 0U64
            while ri < rt.viewIds.count() {
                out.append(rt.viewIds[ri])
                ri += 1U64
            }
            if rt.viewIds.count() == 0U64 && rt.viewExtId != 0U64 {
                out.append(rt.viewExtId)
            }
        }
        return out
    }

}
