// Physical struct identity comes from the finalized layout contract.
pub impl LlvmCtx {
    inout fn structIdxOfRef(c: inout Comp, ref: U64) -> U64 {
        if ref == 0U64 { return c.arena.structCount() }
        val contract = c.arena.finalDestructions[c.requireFinalDestruction(typeRef: ref) - 1U64]
        if contract.underlying != 0U64 { return self.structIdxOfRef(c: inout c, ref: contract.underlying) }
        if contract.structLayout == 0U64 { return c.arena.structCount() }
        return contract.structLayout - 1U64
    }
}
