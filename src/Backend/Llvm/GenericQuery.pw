// Part of the LLVM backend (root: _.pw): generic-instance struct-field and type-ref queries.

// The c.arena.structs index for a local/param/return of type (start,len) if that type
// is a REGISTERED struct, else c.arena.structs.count() (not a struct value).

pub impl LlvmCtx {
    inout fn localStructIdxFor(c: inout Comp, start: U64, len: U64) -> U64 {
        // a `newtype` over a struct shares the struct's representation and inherits its
        // members/conformances (spec/10), so resolve it to the underlying struct's index
        // — then field access / method dispatch on the newtype go through the struct path
        // (e.g. `w.mark()` for `newtype Wrapped = Plain`). Mirrors kindFromTySpan's
        // newtype→underlying resolution for String/primitive underlyings.
        val ntu: Bind = c.newtypeUnderName(start: start, len: len)
        if ntu.nameStart != start || ntu.nameLen != len {
            return self.localStructIdxFor(c: inout c, start: ntu.nameStart, len: ntu.nameLen)
        }
        // substitute a type parameter via the env (a generic-fn body's `x: T` with
        // T = A resolves to A's struct, so `x.get()` dispatches to A.get()).
        if c.cur.typeParams.count() > 0U64 {
            val qid: U64 = intern(c: inout c, start: start, len: len)
            mut val ti: U64 = 0
            while ti < c.cur.typeParams.count() {
                if c.cur.typeParams[ti].nameId == qid {
                    val at: TypeRef = c.arena.types[c.cur.typeArgs[ti]]
                    return self.localStructIdxFor(c: inout c, start: at.nameStart, len: at.nameLen)
                }
                ti += 1
            }
        }
        if self.structRegSlot(c: inout c, start: start, len: len) < self.genStructRefs.count() {
            return c.structIndexByName(start: start, len: len)
        }
        return c.arena.structs.count()
    }
}

pub impl LlvmCtx {

    // SHARED field resolution: given a base value's resolved struct index and grounded
    // instance TypeRef, resolve `base.field` / `base->field` to BOTH projections at once
    // (structIdx for dispatch, typeRef for grounding). The single source of truth that
    // `.`-field (Field) and `->`-pointee-field (Arrow) go through in both exprStructIdx and
    // exprTypeRef — so the field-grounding logic lives once and the two ops stay in lockstep.
    // The field type is grounded under the base instance's env (so `bb.v` with bb:
    // Box[Box[I32]] yields Box[I32]) plus any active monomorphization env.
    inout fn resolveField(c: inout Comp, baseSi: U64, baseRef: U64, nameStart: U64, nameLen: U64) -> ResolvedExpr {
        if baseSi >= c.arena.structs.count() {
            return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
        }
        val fidx: U64 = structFieldIndex(c: inout c, sidx: baseSi, start: nameStart, len: nameLen)
        if fidx >= c.arena.structs[baseSi].fields.count() {
            return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
        }
        val fld: FieldDef = c.arena.structs[baseSi].fields[fidx]
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        val didSet: Bool = self.setStructEnv(c: inout c, ref: baseRef)
        mut val g: U64 = fld.ty
        if fld.ty != 0U64 {
            if c.cur.typeParams.count() > 0U64 {
                g = c.groundTypeRef(ref: fld.ty)
            }
        }
        if didSet {
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
        }
        // typeRef: a generic-instance or existential field type carries args worth grounding
        // (an Array field's `Array[E]` instance too — it is gen-instance pinned). A plain
        // registered-struct field yields 0 here (resolved via structIdx instead).
        mut val tr: U64 = 0U64
        if g != 0U64 {
            if c.isGenericInst(ref: g) {
                tr = g
            } else {
                if refIsAny(c: inout c, ref: g) {
                    tr = g
                }
            }
        }
        // structIdx: the field's registered/generic struct def. Array fields are skipped here
        // (resolved through the array witness via Index / the exprStructIdx array catch).
        mut val si: U64 = c.arena.structs.count()
        if !(fld.tyIsArray) {
            if g != 0U64 {
                if c.isGenericInst(ref: g) {
                    val gs: U64 = self.genStructSlot(c: inout c, ref: g)
                    if gs < self.genStructRefs.count() {
                        si = self.genStructDefs[gs]
                    }
                }
            }
            if si == c.arena.structs.count() {
                mut val tStart: U64 = fld.tyStart
                mut val tLen: U64 = fld.tyLen
                if g != 0U64 {
                    tStart = c.arena.types[g].nameStart
                    tLen = c.arena.types[g].nameLen
                }
                si = self.localStructIdxFor(c: inout c, start: tStart, len: tLen)
            }
        }
        return <ResolvedExpr structIdx=si typeRef=tr />
    }

    // The single classification of a free CALL's result — struct-idx AND type-ref AND
    // is-array computed once under one inferred-type-arg env, so the exprStructIdx /
    // exprTypeRef / exprIsArray projections can no longer drift (the G1 bug was those
    // three deriving the Call form independently: exprStructIdx read the return's
    // retStart/retLen as the value struct, but for an `Array[E]` return that names the
    // ELEMENT — routing `mk() == mk()` to the element's witness). An array return is left
    // struct-idx-less (its element name is not the value's struct); the caller's array
    // catch resolves it to the Array def. TOTAL-REF: a bare non-generic struct return now
    // ALSO carries its declared ref (callRetRef); struct-idx stays the authority for which
    // struct it is, and the ref drives valueArc's ARC dispatch on the result value.
    // (`pow`'s Pow-Output special case stays local to exprTypeRef, before this.)
    inout fn resolveCall(c: inout Comp, id: U64) -> ResolvedExpr {
        match c.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, val args) => {
                val cfi: U64 = c.resolvedCallee(id: id)
                if cfi >= c.arena.funcs.count() {
                    return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
                }
                val cf: Func = c.arena.funcs[cfi]
                if !(cf.hasRet) {
                    return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
                }
                mut val si: U64 = c.arena.structs.count()
                mut val tr: U64 = 0U64
                if c.isGenericFreeFn(fi: cfi) {
                    val savedP: Array[Bind] = c.cur.typeParams
                    val savedA: Array[U64] = c.cur.typeArgs
                    c.cur.typeParams = cf.typeParams
                    c.cur.typeArgs = self.llvmInferFnArgs(c: inout c, f: cf, args: args)
                    if !(cf.retIsArray) {
                        si = self.localStructIdxFor(c: inout c, start: cf.retStart, len: cf.retLen)
                    }
                    if cf.retTy != 0U64 {
                        tr = self.callRetRef(c: inout c, ref: c.groundTypeRef(ref: cf.retTy))
                    }
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                } else {
                    if !(cf.retIsArray) {
                        si = self.localStructIdxFor(c: inout c, start: cf.retStart, len: cf.retLen)
                    }
                    tr = self.callRetRef(c: inout c, ref: cf.retTy)
                }
                return <ResolvedExpr structIdx=si typeRef=tr isArray=cf.retIsArray />
            }
            _ => {
                return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
            }
        }
    }

    // The type ref a call result carries. TOTAL-REF: a call result carries its
    // (already-grounded) declared ref verbatim — a generic instance / `Array[E]` /
    // `Ref[T]`, a concrete scalar / String, AND a bare non-generic struct/enum/newtype
    // (formerly discarded to 0 and recovered by struct-idx). Carrying the bare-struct
    // ref lets valueArc dispatch on it, so a struct's owned ARC-managed fields
    // (String / Ref / Buffer / nested struct) are shallow-retained at by-value arg
    // sites and released at scope exit — closing the latent under-retain that the old
    // `→ 0` partition silently skipped. (`ref` is 0 only for a void return, which
    // resolveCall filters via `hasRet` before calling here.)
    inout fn callRetRef(c: inout Comp, ref: U64) -> U64 {
        return ref
    }

    // The single classification of a METHOD call's result — the struct-idx, type-ref, and
    // is-array facets computed once so exprStructIdx / exprTypeRef / exprIsArray read one
    // source for the Method form (mirrors resolveCall / resolveField). type-ref rides the
    // grounded-ref authority (any-receiver requirement / lazy adapter instance / general
    // methodResultRef); struct-idx rides methodStructIdx (get-sugar element / assoc / method /
    // enum-receiver); is-array is the result ref heading `Array`. A bare non-generic struct
    // return carries no ref (recovered via struct-idx) — the same partition resolveCall uses.
    inout fn resolveMethod(c: inout Comp, id: U64) -> ResolvedExpr {
        match c.arena.exprs[id] {
            Expr.Method(val recv, val nameStart, val nameLen, args: val margs) => {
                mut val tr: U64 = 0U64
                val atIdx: U64 = self.anyRecvTraitIdx(c: inout c, recv: recv)
                if atIdx < c.decls.traits.count() {
                    tr = anyMethodRetRef(c: inout c, anyRef: self.exprTypeRef(c: inout c, id: recv), traitIdx: atIdx, nameStart: nameStart, nameLen: nameLen, args: margs)
                }
                if tr == 0U64 {
                    tr = self.adapterCallResultInst(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen)
                }
                if tr == 0U64 {
                    tr = self.methodResultRef(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, margs: margs)
                }
                val si: U64 = self.methodStructIdx(c: inout c, mrecv: recv, mnameStart: nameStart, mnameLen: nameLen, margs: margs)
                mut val isArr: Bool = false
                if tr != 0U64 {
                    if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[tr].nameStart, len: c.arena.types[tr].nameLen, kw: "Array") {
                        isArr = true
                    }
                }
                return <ResolvedExpr structIdx=si typeRef=tr isArray=isArr />
            }
            _ => {
                return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
            }
        }
    }

    // The owning struct of a method/assoc-fn result (the struct-idx facet of resolveMethod):
    // `arr.get(i:)` element sugar, a `Type.assoc(...)` result, a value-method result, or an
    // enum-receiver method result grounded under its instance ref. structs.count() when the
    // result is not a (resolvable) struct value — the caller falls through to the array catch.
    inout fn methodStructIdx(c: inout Comp, mrecv: U64, mnameStart: U64, mnameLen: U64, margs: Array[Arg]) -> U64 {
        // `arr.get(i:)` is array-index sugar — its element struct (so
        // `self.entries.get(i:i).key` resolves Entry[K,V] inside a generic method).
        if rangeEquals(bytes: c.arena.bytes, start: mnameStart, len: mnameLen, kw: "get") {
            val ger: U64 = self.arrFieldElemStructIdx(c: inout c, arrayExpr: mrecv)
            if ger < c.arena.structs.count() {
                return ger
            }
        }
        // a method/assoc-fn result used as a struct (`Vec2.add(...).sum()`,
        // `p.scaled().x`): resolve the callee's return struct.
        val marn: Bind = c.assocRecvName(recv: mrecv)
        if marn.nameLen != 0U64 {
            val afi: U64 = c.findAssoc(recvStart: marn.nameStart, recvLen: marn.nameLen, nameStart: mnameStart, nameLen: mnameLen, args: margs)
            if afi < c.arena.funcs.count() {
                // an Array-returning assoc fn: retStart/retLen names the ELEMENT, so
                // skip it and fall through to the array catch (as with an array call).
                if c.arena.funcs[afi].hasRet && !(c.arena.funcs[afi].retIsArray) {
                    val r: U64 = self.localStructIdxFor(c: inout c, start: c.arena.funcs[afi].retStart, len: c.arena.funcs[afi].retLen)
                    if r < c.arena.structs.count() {
                        return r
                    }
                }
            }
        } else {
            val mrsi: U64 = self.exprStructIdx(c: inout c, id: mrecv)
            if mrsi < c.arena.structs.count() {
                val mfi: U64 = c.findMethod(recvStart: c.arena.structs[mrsi].nameStart, recvLen: c.arena.structs[mrsi].nameLen, nameStart: mnameStart, nameLen: mnameLen, args: margs)
                if mfi < c.arena.funcs.count() {
                    // an Array-returning method (`h.items() -> Array[I64]`) is an ARRAY
                    // value: retStart/retLen names the ELEMENT, so resolving it would
                    // wrongly return the element's struct. Skip and fall through to the
                    // array catch so `h.items()[i]` / `h.items() == …` ride the witness.
                    if c.arena.funcs[mfi].hasRet && !(c.arena.funcs[mfi].retIsArray) {
                        val r: U64 = self.localStructIdxFor(c: inout c, start: c.arena.funcs[mfi].retStart, len: c.arena.funcs[mfi].retLen)
                        if r < c.arena.structs.count() {
                            return r
                        }
                    }
                }
            } else {
                // an enum-receiver method result (`Optional[(…)].unwrapOr() -> the
                // record payload`): exprStructIdx doesn't see enums, so resolve via the
                // receiver's instance ref and ground the method's return under it.
                val mrRef: U64 = self.exprTypeRef(c: inout c, id: mrecv)
                if mrRef != 0U64 {
                    val rt: TypeRef = c.arena.types[mrRef]
                    val emfi: U64 = c.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: mnameStart, nameLen: mnameLen, args: margs)
                    if emfi < c.arena.funcs.count() {
                        if c.arena.funcs[emfi].hasRet {
                            if c.arena.funcs[emfi].retTy != 0U64 {
                                val savedP: Array[Bind] = c.cur.typeParams
                                val savedA: Array[U64] = c.cur.typeArgs
                                val didSet: Bool = self.setInstanceEnv(c: inout c, ref: mrRef)
                                val g: U64 = c.groundTypeRef(ref: c.arena.funcs[emfi].retTy)
                                if didSet {
                                    c.cur.typeParams = savedP
                                    c.cur.typeArgs = savedA
                                }
                                if g != 0U64 {
                                    val gt: TypeRef = c.arena.types[g]
                                    val r: U64 = self.localStructIdxFor(c: inout c, start: gt.nameStart, len: gt.nameLen)
                                    if r < c.arena.structs.count() {
                                        return r
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return c.arena.structs.count()
    }

    // The pointee TypeRef T of an expression of type `Ref[T]` (for grounding `base->field`
    // under the pointee's instance env), or 0 if base is not a Ref. Mirror of the Deref
    // arm's resolution.
    inout fn refPointeeTypeRef(c: inout Comp, base: U64) -> U64 {
        val r: U64 = self.exprRefTypeRef(c: inout c, id: base)
        if r != 0U64 {
            val t: TypeRef = c.arena.types[r]
            if t.args.count() > 0U64 {
                return t.args[0]
            }
        }
        return 0U64
    }

    // The single classification of an INDEX `base[i]` result — element type-ref, element
    // struct-idx, and is-array computed once so the three projections agree (mirrors
    // resolveCall / resolveMethod). type-ref is the array's element ref (a tracked local
    // element, a struct field's grounded element, or one Array level unwrapped for a nested
    // index); struct-idx is the element struct; is-array holds when the element is itself an
    // Array (`m[i]` for m: Array[Array[E]]). (dict/buffer value subscripts are typed by the
    // front-end exprType, not here — this arm is the array-element recovery.)
    inout fn resolveIndex(c: inout Comp, id: U64) -> ResolvedExpr {
        match c.arena.exprs[id] {
            Expr.Index(val base, index: _) => {
                mut val tr: U64 = 0U64
                match c.arena.exprs[base] {
                    Expr.Ident(start: val bs, len: val bl) => {
                        val bli: U64 = self.findLocal(c: inout c, start: bs, len: bl)
                        if bli < self.nLocals {
                            tr = self.locElemTypeRef[bli]
                        }
                    }
                    Expr.Field(base: val fb, nameStart: val fns2, nameLen: val fnl2) => {
                        val bsi: U64 = self.exprStructIdx(c: inout c, id: fb)
                        if bsi < c.arena.structs.count() {
                            val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns2, len: fnl2)
                            if fidx < c.arena.structs[bsi].fields.count() {
                                tr = self.fieldArrayElemRefUnderBase(c: inout c, base: fb, fd: c.arena.structs[bsi].fields[fidx])
                            }
                        }
                    }
                    _ => {
                        // a nested index (`t[0][0]`): unwrap one Array level from the base
                        // array's element type ref.
                        val br: U64 = self.exprTypeRef(c: inout c, id: base)
                        if br != 0U64 {
                            val bt: TypeRef = c.arena.types[br]
                            if rangeEquals(bytes: c.arena.bytes, start: bt.nameStart, len: bt.nameLen, kw: "Array") {
                                if bt.args.count() > 0U64 {
                                    tr = bt.args[0]
                                }
                            }
                        }
                    }
                }
                val si: U64 = self.arrFieldElemStructIdx(c: inout c, arrayExpr: base)
                mut val isArr: Bool = false
                if tr != 0U64 {
                    if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[tr].nameStart, len: c.arena.types[tr].nameLen, kw: "Array") {
                        isArr = true
                    }
                }
                return <ResolvedExpr structIdx=si typeRef=tr isArray=isArr />
            }
            _ => {
                return <ResolvedExpr structIdx=c.arena.structs.count() typeRef=0U64 />
            }
        }
    }

    // The owning struct index of an expression (Ident local / Make), or
    // c.arena.structs.count() if it is not a (resolvable) struct value.
    inout fn exprStructIdx(c: inout Comp, id: U64) -> U64 {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    if self.locStructIdx[li] < c.arena.structs.count() {
                        return self.locStructIdx[li]
                    }
                    // an array local whose struct idx wasn't pinned (e.g. a closure-captured
                    // `Array[E]` param) falls through to the array catch below, which resolves
                    // it to the `Array` def so its index/method rides the witness; a plain
                    // scalar local likewise falls through and the catch returns the sentinel.
                }
            }
            Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, val ty, fields: _) => {
                if !(isEnum) {
                    // a generic struct construction (`<Holder[I64] … />`): point at the
                    // generic def so field access on the binding works.
                    if c.isGenericInst(ref: ty) {
                        val gs: U64 = self.genStructSlot(c: inout c, ref: ty)
                        if gs < self.genStructRefs.count() {
                            return self.genStructDefs[gs]
                        }
                    }
                    return self.localStructIdxFor(c: inout c, start: typeStart, len: typeLen)
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                // a nested-struct field access (`ln.b`): the field's declared type is
                // itself a (registered) struct, so its struct index drives further
                // field access / method dispatch on the result. Shared with `->field` (Arrow)
                // via resolveField — one source for field grounding.
                val rf: ResolvedExpr = self.resolveField(c: inout c, baseSi: self.exprStructIdx(c: inout c, id: base), baseRef: self.exprTypeRef(c: inout c, id: base), nameStart: nameStart, nameLen: nameLen)
                if rf.structIdx < c.arena.structs.count() {
                    return rf.structIdx
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // a pointee field through a `Ref` deref (`r->inner`): resolves on the pointee
                // struct exactly like `.`-field does, so `r->inner.method()` dispatches the
                // result's struct. Same resolveField helper as Field — `->` and `.` field
                // resolution stay in lockstep (no drift).
                val rf: ResolvedExpr = self.resolveField(c: inout c, baseSi: self.refPointeeStructIdx(c: inout c, base: base), baseRef: self.refPointeeTypeRef(c: inout c, base: base), nameStart: nameStart, nameLen: nameLen)
                if rf.structIdx < c.arena.structs.count() {
                    return rf.structIdx
                }
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                // a method/assoc-fn result used as a struct (`p.scaled().x`, `arr.get(i).key`):
                // via the shared resolver so exprStructIdx/exprTypeRef/exprIsArray agree on the
                // Method form (see resolveMethod). A non-struct result is struct-idx-less and
                // falls through to the array catch below.
                val rc: ResolvedExpr = self.resolveMethod(c: inout c, id: id)
                if rc.structIdx < c.arena.structs.count() {
                    return rc.structIdx
                }
            }
            Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
                // a value re-view has recv's struct (the view is zero-cost).
                return self.exprStructIdx(c: inout c, id: recv)
            }
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                // a call result used as a struct (`firstOf(...).get()`): the callee's return
                // struct, via the shared resolver (grounds a generic return, and leaves an
                // Array return struct-idx-less so the array catch below resolves it — see
                // resolveCall). A bare scalar/String return is struct-idx-less too.
                val rc: ResolvedExpr = self.resolveCall(c: inout c, id: id)
                if rc.structIdx < c.arena.structs.count() {
                    return rc.structIdx
                }
            }
            Expr.Unary(val op, val operand) => {
                // a unary operator result used as a struct (`(-m).cents`): the witness's
                // return type drives further field access.
                val uwfi: U64 = self.unaryWitnessFn(c: inout c, op: op, operand: operand)
                if uwfi < c.arena.funcs.count() {
                    if c.arena.funcs[uwfi].hasRet {
                        return self.localStructIdxFor(c: inout c, start: c.arena.funcs[uwfi].retStart, len: c.arena.funcs[uwfi].retLen)
                    }
                }
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                // a binary operator result used as a struct (`(a + b).x`): the witness's
                // return type drives further field access.
                if isBinTraitOp(op: op) {
                    val wfi: U64 = self.binWitnessFn(c: inout c, op: op, lhs: lhs, rhs: rhs)
                    if wfi < c.arena.funcs.count() {
                        if c.arena.funcs[wfi].hasRet {
                            return self.localStructIdxFor(c: inout c, start: c.arena.funcs[wfi].retStart, len: c.arena.funcs[wfi].retLen)
                        }
                    }
                }
            }
            Expr.Index(base: _, index: _) => {
                // an array element used as a struct (`h.items[0].v`): the element struct via
                // the shared resolver so exprStructIdx/exprTypeRef/exprIsArray agree on the
                // Index form (see resolveIndex). A nested-array element is itself an Array (no
                // element struct) and falls through to the array catch below.
                val rc: ResolvedExpr = self.resolveIndex(c: inout c, id: id)
                if rc.structIdx < c.arena.structs.count() {
                    return rc.structIdx
                }
            }
            Expr.Deref(val base) => {
                // `*ref` (the pointee place behind `ref->method()`): the pointee struct index,
                // so a registered-struct method on the pointee dispatches like a local receiver.
                // (A generic-instance pointee resolves via exprTypeRef in the generic path.)
                return self.refPointeeStructIdx(c: inout c, base: base)
            }
            // --- scalars and non-struct values: the correct answer to "what struct is this?"
            // is "none" — they are not registered structs (their actual type is carried by the
            // front-end `exprType`). A `Str` / `Array` literal falls through to the String /
            // Array tail below. No `_` catch-all: every Expr variant is classified so a new one
            // forces a decision here (the drift that caused the `->` gaps).
            Expr.Int(value: _, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => {}
            Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => {}
            Expr.Str(start: _, len: _) => {}
            Expr.Array(elems: _) => {}
            Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => {}
            // a value-position `if`/`match`: its struct is the struct of a (non-diverging)
            // branch's `give` value (every branch has the same type) — delegate so a scalar
            // branch yields "none" and a struct branch resolves, like a plain receiver.
            Expr.IfExpr(cond: _, val thenBlk, elseBlk: _) => {
                val gv: U64 = c.blockGiveExpr(blkId: thenBlk)
                if gv < c.arena.exprs.count() {
                    return self.exprStructIdx(c: inout c, id: gv)
                }
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count() {
                    if !(arms[ai].isDiverge) {
                        val gv: U64 = c.blockGiveExpr(blkId: arms[ai].body)
                        if gv < c.arena.exprs.count() {
                            return self.exprStructIdx(c: inout c, id: gv)
                        }
                    }
                    ai += 1
                }
            }
            // `move x` / `borrow x` evaluates to the operand's value, so its struct is the
            // operand's.
            Expr.Move(val operand, isBorrow: _) => {
                return self.exprStructIdx(c: inout c, id: operand)
            }
            // `x as T` where T (or its newtype underlying) is a registered/generic struct:
            // dispatch on T's struct, so `(x as Plain).method()` resolves like a plain receiver.
            // A cast to a scalar/newtype-over-scalar yields the sentinel (localStructIdxFor) and
            // falls through.
            Expr.Cast(operand: _, val tyStart, val tyLen, val ty) => {
                if c.isGenericInst(ref: ty) {
                    val gs: U64 = self.genStructSlot(c: inout c, ref: ty)
                    if gs < self.genStructRefs.count() {
                        return self.genStructDefs[gs]
                    }
                }
                val r: U64 = self.localStructIdxFor(c: inout c, start: tyStart, len: tyLen)
                if r < c.arena.structs.count() {
                    return r
                }
            }
            // `try e` (e: Result[T,E]): the unwrapped `Ok` payload value is a T — resolve T's
            // struct so `(try mk()).method()` dispatches on it. Couples to @Std/Core's Result
            // shape (Ok payload = the first type arg), like the Try lowering itself.
            Expr.Try(val expr) => {
                val er: U64 = self.exprTypeRef(c: inout c, id: expr)
                if er != 0U64 {
                    val rt: TypeRef = c.arena.types[er]
                    if rt.args.count() > 0U64 {
                        val payload: U64 = rt.args[0]
                        if c.isGenericInst(ref: payload) {
                            val gs: U64 = self.genStructSlot(c: inout c, ref: payload)
                            if gs < self.genStructRefs.count() {
                                return self.genStructDefs[gs]
                            }
                        }
                        val pt: TypeRef = c.arena.types[payload]
                        val r: U64 = self.localStructIdxFor(c: inout c, start: pt.nameStart, len: pt.nameLen)
                        if r < c.arena.structs.count() {
                            return r
                        }
                    }
                }
            }
            // these resolve to a non-struct value in every exercised case → sentinel via the
            // tail: a `?.` chain (Optional — an enum, dispatched via exprTypeRef), an
            // extension-method scalar result, an `await` (statement-head only today, so its
            // value is never itself a receiver). NOTE (latent gap): the struct-producing
            // `(await p).m()` / `recv#Ext.m().field` sub-cases are not resolved here yet; kept
            // explicit (not `_`) so a new Expr variant still forces a decision.
            Expr.Await(operand: _) => {}
            Expr.ExtMethod(recv: _, srcStart: _, srcLen: _, nameStart: _, nameLen: _, args: _) => {}
            Expr.OptChain(base: _, memberStart: _, memberLen: _) => {}
        }
        // a fall-through array-typed expr (an array struct field `s.items`, an array-returning
        // call/method result `mk()` / `s.bytes()`, a nested-array element `m[i]`) is an `Array`
        // value — resolve to the Array generic def so a direct index / method on it dispatches
        // the Index / generic-method witness uniformly (collections.md E3: no `exprIsArray`
        // type-name fallback). Array is gen-instance pinned, so it is found arena-wide.
        if self.exprIsArray(c: inout c, id: id) {
            val ab: Bind = c.kwSpan(kw: "Array", kwLen: 5U64)
            return c.structDefByNameAny(start: ab.nameStart, len: ab.nameLen)
        }
        // a fall-through String value (a `"…"` literal, a concat result, a String-typed
        // local/field/call whose ref didn't resolve above) is a `String` struct value —
        // resolve to the registered String struct so its methods / `==` / `+` ride the
        // uniform `exprStructIdx -> findMethod` witness path, replacing the scattered
        // `valueKind==1` String dispatch fallbacks. String's value rep is pinned to strty
        // (a representation residue, collections.md §3-付録3), but its DISPATCH is structural
        // like any other registered struct.
        if self.valueKind(c: inout c, id: id) == 1U64 {
            val sb: Bind = c.kwSpan(kw: "String", kwLen: 6U64)
            return c.structDefByNameAny(start: sb.nameStart, len: sb.nameLen)
        }
        return c.arena.structs.count()
    }

    // The element struct def index of an array-typed struct field expression
    // (`h.items` / `self.entries`), grounded under the base value's generic instance
    // env, or c.arena.structs.count() if not such an array. Drives `arr[i].field` /
    // `arr.get(i:).field` dispatch.
    inout fn arrFieldElemStructIdx(c: inout Comp, arrayExpr: U64) -> U64 {
        match c.arena.exprs[arrayExpr] {
            Expr.Ident(val start, val len) => {
                // an array-of-struct local (`store : Array[Box]`): its tracked element
                // struct (sentinel-large = element is not a struct). Safe now that array
                // value-semantics CoW makes an aliased `b = a` independent.
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    if self.locElemStructIdx[li] < c.arena.structs.count() {
                        return self.locElemStructIdx[li]
                    }
                    // a generic struct element (`Array[Box[I32]]`): via the element ref.
                    if self.locElemTypeRef[li] != 0U64 {
                        if c.isGenericInst(ref: self.locElemTypeRef[li]) {
                            val gs: U64 = self.genStructSlot(c: inout c, ref: self.locElemTypeRef[li])
                            if gs < self.genStructRefs.count() {
                                return self.genStructDefs[gs]
                            }
                        }
                    }
                }
            }
            Expr.Field(base: val fbase, nameStart: val fns, nameLen: val fnl) => {
                val bsi: U64 = self.exprStructIdx(c: inout c, id: fbase)
                if bsi < c.arena.structs.count() {
                    val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns, len: fnl)
                    if fidx < c.arena.structs[bsi].fields.count() {
                        val fd: FieldDef = c.arena.structs[bsi].fields[fidx]
                        // the indexed field's element type is its first type argument —
                        // whether it is the `[E]` array sugar (`fd.tyIsArray`) OR a named
                        // collection floor `Buffer[E]` / `Array[E]` (a generic instance with
                        // args). Dictionary's `keys: Buffer[K]` is the latter, so gating on
                        // `tyIsArray` alone missed it and `self.keys[i] == key`'s Eq witness
                        // could not be found in a monomorphized `Dictionary[Pair]` body.
                        if fd.ty != 0U64 {
                            val ft: TypeRef = c.arena.types[fd.ty]
                            if ft.args.count() > 0U64 {
                                val baseRef: U64 = self.exprTypeRef(c: inout c, id: fbase)
                                val savedP: Array[Bind] = c.cur.typeParams
                                val savedA: Array[U64] = c.cur.typeArgs
                                val didSet: Bool = self.setStructEnv(c: inout c, ref: baseRef)
                                val g: U64 = c.groundTypeRef(ref: ft.args[0])
                                val gt: TypeRef = c.arena.types[g]
                                mut val r: U64 = c.arena.structs.count()
                                if c.isGenericInst(ref: g) {
                                    val gs: U64 = self.genStructSlot(c: inout c, ref: g)
                                    if gs < self.genStructRefs.count() {
                                        r = self.genStructDefs[gs]
                                    }
                                } else {
                                    r = self.localStructIdxFor(c: inout c, start: gt.nameStart, len: gt.nameLen)
                                }
                                if didSet {
                                    c.cur.typeParams = savedP
                                    c.cur.typeArgs = savedA
                                }
                                return r
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        return c.arena.structs.count()
    }

    // The result TypeRef of a call/method expression, grounding a generic return
    // under the inferred type arguments — so an un-annotated binding to a generic
    // constructor (`val r = makeBox()` with makeBox -> Box[I64]) recovers the
    // instance ref for field substitution. 0 when not a structured call result.
    inout fn exprResultRef(c: inout Comp, id: U64) -> U64 {
        match c.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                // a binding from another local (`mut val it = self` in a provided Iterator
                // terminal's body): propagate the source local's tracked instance TypeRef so
                // `it` is a MapIter/FilterIter/… and a later `it.next()` routes through the
                // generic-receiver dispatch (else it's untracked and the call is not emitted).
                val li: U64 = self.findLocal(c: inout c, start: start, len: len)
                if li < self.nLocals {
                    return self.locTypeRef[li]
                }
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                val cfi: U64 = c.resolvedCallee(id: id)
                if cfi < c.arena.funcs.count() {
                    val cf: Func = c.arena.funcs[cfi]
                    if cf.hasRet {
                        if c.isGenericFreeFn(fi: cfi) {
                            val savedP: Array[Bind] = c.cur.typeParams
                            val savedA: Array[U64] = c.cur.typeArgs
                            c.cur.typeParams = cf.typeParams
                            c.cur.typeArgs = self.llvmInferFnArgs(c: inout c, f: cf, args: args)
                            val r: U64 = c.groundTypeRef(ref: cf.retTy)
                            c.cur.typeParams = savedP
                            c.cur.typeArgs = savedA
                            return r
                        }
                        return cf.retTy
                    }
                }
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, val isEnum, val ty, fields: _) => {
                // a generic construction (`<Holder[I64] … />`) used un-annotated: its
                // instance ref (grounded under any active env) so the binding tracks it.
                mut val g: U64 = ty
                if c.cur.typeParams.count() > 0U64 {
                    g = c.groundTypeRef(ref: ty)
                }
                if c.isGenericInst(ref: g) {
                    return g
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, args: val margs) => {
                // a binding to a method call that yields a generic instance (`val it =
                // xs.map(f)` -> a MapIter adapter; `val o = d.get(k)` -> Optional[V]): the
                // lazy-adapter instance, else the grounded generic return — so `it`'s type
                // is tracked and a later `it.count()` / `it.next()` dispatches. Mirrors the
                // exprTypeRef Method arm (the let-binding tref recovery routes through here).
                val adp: U64 = self.adapterCallResultInst(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen)
                if adp != 0U64 {
                    return adp
                }
                return self.methodResultRef(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, margs: margs)
            }
            _ => {}
        }
        return 0U64
    }

    // The LLVM type for a declared type span, honoring array-ness: an array is the
    // {ptr,i64} value type; otherwise the scalar/String/struct/enum type.
    inout fn llvmTypeFor(c: inout Comp, tyStart: U64, tyLen: U64, isArray: Bool) -> LLVMTypeRef {
        if isArray {
            return self.arrayTy
        }
        return self.llvmScalarTy(c: inout c, tyStart: tyStart, tyLen: tyLen)
    }
}

pub impl LlvmCtx {

    // The LLVM type of a struct field, honoring an existential `any P` field (the fat
    // pointer) which the span-keyed llvmTypeFor can't see; else the span-based type.
    inout fn fieldLlvmTy(c: inout Comp, fd: FieldDef) -> LLVMTypeRef {
        if refIsAny(c: inout c, ref: fd.ty) {
            return self.anyTy
        }
        // a generic-instance field (`o: Optional[I64]`, `inner: Box[T]`, AND `xs: Array[E]`):
        // resolve via the full TypeRef — the head-name-only path (llvmTypeFor) drops the args
        // and would miss the registered instance. Checked BEFORE the tyIsArray fallback so an
        // array field resolves to its per-instance `%gs` (de-pin). Ground through the active
        // env first (a generic struct body's field type may name a type param bound to a
        // concrete instance).
        if fd.ty != 0U64 {
            mut val g: U64 = fd.ty
            if c.cur.typeParams.count() > 0U64 {
                g = c.groundTypeRef(ref: fd.ty)
            }
            // a type param bound to an existential (`T = any Drawable` in `Optional[any
            // Drawable]`): the payload is the fat pointer, not the i64 the head-name path
            // below would default to. The ungrounded `fd.ty` (a bare `T`) is not `any`, so
            // this grounded re-check is what catches it.
            if refIsAny(c: inout c, ref: g) {
                return self.anyTy
            }
            if c.isGenericInst(ref: g) {
                return self.llvmTypeOfRef(c: inout c, ref: g)
            }
            // a grounded RECORD field (`pair: (a:T,b:T)` -> `(a:I32,b:I32)`): records carry no
            // top-level args, so the grounded instance is not `isGenericInst` — but its name
            // changed under the env, and the template `fd.tyStart/tyLen` still spells `(a:T,b:T)`
            // (i64-defaulting). Lower from the grounded name so the field's `%st` matches the
            // grounded record struct built at the construction site (genLlvmMake). Restricted
            // to records (name begins `(`): a lang-item generic (`Ref`/`WeakRef`) also grounds
            // to a changed `g`, but its head name resolves correctly through the fall-through
            // below (`Ref[Cell]` -> ptr, NOT the inline pointee struct).
            if g != fd.ty {
                if g < c.arena.types.count() {
                    val gt: TypeRef = c.arena.types[g]
                    if gt.nameLen > 0U64 {
                        if c.arena.bytes[gt.nameStart] == 40U8 {
                            return self.llvmTypeFor(c: inout c, tyStart: gt.nameStart, tyLen: gt.nameLen, isArray: false)
                        }
                    }
                }
            }
        }
        // a hand-built array field with no full TypeRef (`ty == 0`): the shared `{ptr}`.
        if fd.tyIsArray {
            return self.arrayTy
        }
        return self.llvmTypeFor(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen, isArray: false)
    }
}
