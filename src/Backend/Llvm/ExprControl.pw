// Part of the LLVM backend (root: _.pw): expression-position control flow (if / match / opt-chain / try).

// Value-position `if cond { … give a } else { … give b }`: emit each branch
// block (its `give` sets st.giveValue), then a PHI merges the two results.

pub impl LlvmCtx {
    inout fn genLlvmIfExpr(c: inout Comp, cond: U64, thenBlk: U64, elseBlk: U64) -> LLVMValueRef {
        val condMark: U64 = self.nLocals
        val cv: LLVMValueRef = self.genLlvmCond(c: inout c, id: cond)
        // a condition is its own full expression (spec/03): its temporaries die before
        // the branch (mirrors the statement `if` / the per-iteration `while` drain).
        self.drainStmtTemps(c: inout c, fromMark: condMark)
        val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "vif.then"))
        val elseBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "vif.else"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "vif.end"))
        LLVMBuildCondBr(self.b, cv, thenBB, elseBB)
        // each branch is a block ending in `give` (value) or diverging (`panic`/`return`).
        // A diverging branch already terminated its block, so it contributes neither a
        // value nor an edge into the continuation.
        mut val phiVals: Array[LLVMValueRef] = []
        mut val phiBlocks: Array[LLVMBasicBlockRef] = []
        LLVMPositionBuilderAtEnd(self.b, thenBB)
        self.terminated = false
        val markT: U64 = self.nLocals
        self.genLlvmBlock(c: inout c, id: thenBlk)
        val thenDiv: Bool = self.terminated
        val thenVal: LLVMValueRef = self.giveValue
        val thenEnd: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        self.nLocals = markT
        if !(thenDiv) {
            phiVals.append(thenVal)
            phiBlocks.append(thenEnd)
            LLVMBuildBr(self.b, contBB)
        }
        LLVMPositionBuilderAtEnd(self.b, elseBB)
        self.terminated = false
        val markE: U64 = self.nLocals
        self.genLlvmBlock(c: inout c, id: elseBlk)
        val elseDiv: Bool = self.terminated
        mut val elseVal: LLVMValueRef = self.giveValue
        val elseEnd: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        self.nLocals = markE
        if !(elseDiv) {
            // unify the else branch's width to a value branch (context-less literals).
            if phiVals.count() > 0U64 {
                elseVal = self.coerceInt(v: elseVal, target: LLVMTypeOf(phiVals[0]), unsigned: false)
            }
            phiVals.append(elseVal)
            phiBlocks.append(elseEnd)
            LLVMBuildBr(self.b, contBB)
        }
        LLVMPositionBuilderAtEnd(self.b, contBB)
        self.terminated = false
        if phiVals.count() == 0U64 {
            // both branches diverge: the continuation is unreachable.
            LLVMBuildUnreachable(self.b)
            self.terminated = true
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val phi: LLVMValueRef = LLVMBuildPhi(self.b, LLVMTypeOf(phiVals[0]), anon())
        LLVMAddIncoming(phi, arrayCPtr(phiVals), arrayCPtr(phiBlocks), phiVals.count())
        return phi
    }

    // Value-position `match scrut { Pat => exprValue, ... }`: each arm body is an
    // expression; a PHI over the arm blocks merges their values.
    inout fn genLlvmMatchExpr(c: inout Comp, scrut: U64, arms: Array[MatchArm], exprId: U64) -> LLVMValueRef {
        // the match's expected result type (from the enclosing let/return/arg) propagates
        // to each arm's give-value so a context-only construction in an arm grounds — e.g.
        // the Chain desugar's `None => give <Head.empty/>`, whose no-arg factory's type
        // param can only come from the expected `Head[U]`. Captured before `scrut` emission
        // consumes self.expectedTy; re-applied at each arm body.
        mut val matchExpectedTy: U64 = self.expectedTy
        // a desugared `?.` (Chain rewrite) carries its OWN recorded result `Head[U]`; this
        // overrides any inherited expectation, which for a nested chain's inner stage (in the
        // outer's scrutinee position) would be the OUTER result and ground the arms' factories
        // to the wrong instance.
        val crET: U64 = c.chainResultRef(exprId: exprId)
        if crET != 0U64 {
            matchExpectedTy = crET
        }
        val sv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: scrut)
        val sty: LLVMTypeRef = LLVMTypeOf(sv)
        // a value-position struct destructuring match (irrefutable, one arm): bind the
        // scrutinee's fields (under any generic env), then evaluate the arm expression.
        if arms.count() > 0U64 {
            if arms[0].isStruct {
                val ssidx: U64 = self.exprStructIdx(c: inout c, id: scrut)
                val structScrutRef: U64 = self.exprTypeRef(c: inout c, id: scrut)
                val savedSP: Array[Bind] = c.cur.typeParams
                val savedSA: Array[U64] = c.cur.typeArgs
                val didSetS: Bool = self.setStructEnv(c: inout c, ref: structScrutRef)
                val sslot0: LLVMValueRef = self.entryAlloca(ty: sty)
                LLVMBuildStore(self.b, sv, sslot0)
                // an owned temporary scrutinee: register it so it is released on every
                // exit (mirrors the statement struct-match; a raw alloca leaked it).
                val sStructSentinel: U64 = 18446744073709551615U64
                mut val sStructTempLi: U64 = sStructSentinel
                if !(exprAliasesPlace(c: inout c, id: scrut)) {
                    self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: sslot0, ty: sty, kind: 0U64, structIdx: ssidx, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: structScrutRef)
                    sStructTempLi = self.nLocals - 1U64
                }
                val mark0: U64 = self.nLocals
                self.bindStructPattern(c: inout c, sidx: ssidx, binds: arms[0].binds, scrutTy: sty, scrutSlot: sslot0)
                self.terminated = false
                self.expectedTy = matchExpectedTy
                self.genLlvmBlock(c: inout c, id: arms[0].body)
                val rv: LLVMValueRef = self.giveValue
                // release the retained field binds (they co-own the scrutinee's heap;
                // the give value is already independent) before popping them.
                if !(self.terminated) {
                    self.dropScope(c: inout c, fromMark: mark0, excludeLi: sStructSentinel)
                }
                self.nLocals = mark0
                if didSetS {
                    c.cur.typeParams = savedSP
                    c.cur.typeArgs = savedSA
                }
                if sStructTempLi != sStructSentinel {
                    if !(self.terminated) {
                        self.emitDeinitCall(c: inout c, li: sStructTempLi)
                    }
                    self.nLocals = sStructTempLi
                }
                return rv
            }
        }
        // The scrutinee's enum instance ref. As in genLlvmMatch, the enum env is set
        // ONLY around bindMatchPayload, never for the arm bodies (which keep the outer
        // env so a body's `self.f` grounds against the enclosing method).
        val scrutRef: U64 = self.exprTypeRef(c: inout c, id: scrut)
        val savedVP: Array[Bind] = c.cur.typeParams
        val savedVA: Array[U64] = c.cur.typeArgs
        mut val eid: U64 = c.arena.enums.count()
        mut val ai0: U64 = 0
        while ai0 < arms.count() {
            if !(arms[ai0].isWildcard) {
                if !(arms[ai0].isStruct) {
                    if eid == c.arena.enums.count() {
                        eid = c.enumIdxByName(start: arms[ai0].enumStart, len: arms[ai0].enumLen)
                    }
                }
            }
            ai0 += 1
        }
        if eid >= c.arena.enums.count() {
            compileErrorAt(line: 0, msg: "LLVM backend: value-match is only supported on a registered enum (so far)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val sslot: LLVMValueRef = self.entryAlloca(ty: sty)
        LLVMBuildStore(self.b, sv, sslot)
        // An owned temporary scrutinee (a call/construction result — e.g. the `?.`
        // desugar's `base.chain()`): the match is its only owner, so register it as an
        // anonymous owned local, released on every exit — a diverging arm's return
        // drops it via dropScope, and fall-through drops it at vmatch.end below
        // (mirrors genLlvmMatch's statement protocol; leaving the raw alloca
        // unregistered leaked the whole payload heap and silently skipped its
        // deinits). A place scrutinee stays with its real owner.
        val scrutSentinel: U64 = 18446744073709551615U64
        mut val scrutTempLi: U64 = scrutSentinel
        if !(exprAliasesPlace(c: inout c, id: scrut)) {
            self.pushLocalR(nameStart: 0U64, nameLen: 0U64, ptr: sslot, ty: sty, kind: 0U64, structIdx: scrutSentinel, isArr: false, elemTy: self.i64ty, elemKind: 0U64, typeRef: scrutRef)
            scrutTempLi = self.nLocals - 1U64
        }
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, sty, sslot, 0U64, anon()), anon())
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "vmatch.end"))
        mut val checkBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        mut val lastWasWildcard: Bool = false
        mut val phiVals: Array[LLVMValueRef] = []
        mut val phiBlocks: Array[LLVMBasicBlockRef] = []
        mut val ai: U64 = 0
        while ai < arms.count() {
            val arm: MatchArm = arms[ai]
            val armBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "varm"))
            LLVMPositionBuilderAtEnd(self.b, checkBB)
            if arm.isWildcard {
                LLVMBuildBr(self.b, armBB)
                lastWasWildcard = true
            } else {
                val vi: U64 = c.variantIndex(enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
                val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "vmatch.next"))
                LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon()), armBB, nextBB)
                checkBB = nextBB
                lastWasWildcard = false
            }
            val saved: U64 = self.nLocals
            LLVMPositionBuilderAtEnd(self.b, armBB)
            self.terminated = false
            if !(arm.isWildcard) {
                val didB: Bool = self.setEnumEnv(c: inout c, ref: scrutRef)
                self.bindMatchPayload(c: inout c, eid: eid, arm: arm, scrutTy: sty, scrutSlot: sslot)
                if didB {
                    c.cur.typeParams = savedVP
                    c.cur.typeArgs = savedVA
                }
            }
            // each arm body is a block ending in `give` (value) or in `panic`/`return`
            // (diverging). genLlvmBlock sets self.giveValue / self.terminated.
            self.expectedTy = matchExpectedTy
            self.genLlvmBlock(c: inout c, id: arm.body)
            val armDiverged: Bool = self.terminated
            if armDiverged {
                // a diverging arm (`=> panic`/`=> return`) already terminated its block;
                // it contributes no value and no edge into the continuation.
            } else {
                mut val armVal: LLVMValueRef = self.giveValue
                // unify integer arm values to the first arm's width (a context-less literal
                // may default wider/narrower) so the PHI is single-typed.
                if phiVals.count() > 0U64 {
                    armVal = self.coerceInt(v: armVal, target: LLVMTypeOf(phiVals[0]), unsigned: false)
                }
                phiVals.append(armVal)
                // payload binds borrow the scrutinee's heap (bindMatchPayload marks them
                // not-owned), so no scope-exit release is needed before branching — the
                // arm VALUE is already an independent copy (`give` runs copyValueIfPlace).
                // They are popped below (nLocals = saved), same as the statement match.
                phiBlocks.append(LLVMGetInsertBlock(self.b))
                LLVMBuildBr(self.b, contBB)
            }
            self.nLocals = saved
            ai += 1
        }
        if !(lastWasWildcard) {
            LLVMPositionBuilderAtEnd(self.b, checkBB)
            LLVMBuildUnreachable(self.b)
        }
        LLVMPositionBuilderAtEnd(self.b, contBB)
        self.terminated = false
        // all arms diverged: the continuation is unreachable (the match never yields);
        // each arm's return unwind already dropped the owned scrutinee temp — just pop.
        if phiVals.count() == 0U64 {
            LLVMBuildUnreachable(self.b)
            self.terminated = true
            if scrutTempLi != scrutSentinel {
                self.nLocals = scrutTempLi
            }
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val phi: LLVMValueRef = LLVMBuildPhi(self.b, LLVMTypeOf(phiVals[0]), anon())
        LLVMAddIncoming(phi, arrayCPtr(phiVals), arrayCPtr(phiBlocks), phiVals.count())
        // release the owned scrutinee temp on the fall-through path (the arm values are
        // independent — `give` copies places and the fromValue projection retains), then
        // pop it so the enclosing statement's drain doesn't see it again.
        if scrutTempLi != scrutSentinel {
            self.emitDeinitCall(c: inout c, li: scrutTempLi)
            self.nLocals = scrutTempLi
        }
        return phi
    }

    // `try expr` (spec/13): evaluate the Result `expr`; on `Err(e)` early-return the
    // enclosing function's own Result with that error — converting E' -> E through E's
    // `from` factory when the error types differ; on `Ok(v)` yield `v` and continue. Couples
    // to @Std/Core Result (Ok / Err). Only valid in a fn returning a Result.
    inout fn genLlvmTry(c: inout Comp, expr: U64) -> LLVMValueRef {
        val exprRef: U64 = self.exprTypeRef(c: inout c, id: expr)
        val ege: U64 = self.genEnumSlot(c: inout c, ref: exprRef)
        val rge: U64 = self.genEnumSlot(c: inout c, ref: self.curRetRef)
        if ege >= self.genEnumRefs.count() {
            c.errorAt(offset: c.exprOffset(id: expr), msg: "LLVM backend: `try` needs a registered Result instance")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        if rge >= self.genEnumRefs.count() {
            c.errorAt(offset: c.exprOffset(id: expr), msg: "LLVM backend: `try` is only valid in a function returning a registered Result")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val eeid: U64 = self.genEnumDefs[ege]
        val eety: LLVMTypeRef = self.genEnumTys[ege]
        val reid: U64 = self.genEnumDefs[rge]
        val rety: LLVMTypeRef = self.genEnumTys[rge]
        val ed: EnumDef = c.arena.enums[eeid]
        val okB: Bind = c.kwSpan(kw: "Ok", kwLen: 2U64)
        val errB: Bind = c.kwSpan(kw: "Err", kwLen: 3U64)
        val okVi: U64 = c.variantIndex(enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: okB.nameStart, variantLen: okB.nameLen)
        val errVi: U64 = c.variantIndex(enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: errB.nameStart, variantLen: errB.nameLen)
        // A PLACE operand (`try r` on a binding) loads a +0 alias of the place's
        // heap: the extracted payload must be RETAINED before it escapes (the Err
        // payload rides the return past dropScope's release of the place itself;
        // the Ok payload is consumed as owned by the `try` expression's consumer).
        // A temporary operand transfers ownership instead — no retain, and its
        // unregistered slot is exactly that transfer.
        val operandIsPlace: Bool = exprAliasesPlace(c: inout c, id: expr)
        val ev: LLVMValueRef = self.genLlvmExpr(c: inout c, id: expr)
        val eslot: LLVMValueRef = self.entryAlloca(ty: eety)
        LLVMBuildStore(self.b, ev, eslot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, eety, eslot, 0U64, anon()), anon())
        val isErr: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, errVi, 0I32), anon())
        val errBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "try.err"))
        val okBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "try.ok"))
        LLVMBuildCondBr(self.b, isErr, errBB, okBB)
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        // Err: extract the error (source env), rebuild the function's Result Err, return.
        LLVMPositionBuilderAtEnd(self.b, errBB)
        val didE: Bool = self.setEnumEnv(c: inout c, ref: exprRef)
        val errPayloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eeid, vi: errVi)
        val errPayload: LLVMValueRef = LLVMBuildLoad2(self.b, errPayloadTy, LLVMBuildStructGEP2(self.b, eety, eslot, 1U64, anon()), anon())
        val errVal: LLVMValueRef = LLVMBuildExtractValue(self.b, errPayload, 0U64, anon())
        if didE { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
        // error conversion (spec/13): when the function's error type E differs from the
        // operand's E', convert E' -> E through E's `from` factory before rewrapping.
        mut val convErrVal: LLVMValueRef = errVal
        mut val didConvert: Bool = false
        val opErrRef: U64 = c.resultErrArgRef(ref: exprRef)
        val fnErrRef: U64 = c.resultErrArgRef(ref: self.curRetRef)
        if opErrRef != 0U64 {
            if fnErrRef != 0U64 {
                if c.arena.types[opErrRef].nameId != c.arena.types[fnErrRef].nameId {
                    val ffi: U64 = c.typeRefFromFactoryIdx(errRef: fnErrRef)
                    if ffi < c.arena.funcs.count() {
                        mut val cav: Array[LLVMValueRef] = []
                        cav.append(errVal)
                        // the error-conversion factory (free fn or assoc fn — no self) is its
                        // own 0-type-arg `gf` instance (B4-1).
                        val fgslot: U64 = self.ensureFnInst(c: inout c, fnIdx: ffi, args: [], recvInstRef: 0U64)
                        if fgslot < self.genFnK.count() {
                            convErrVal = LLVMBuildCall2(self.b, self.genFnTy[fgslot], self.genFnVal[fgslot], arrayCPtr(cav), cav.count(), anon())
                            didConvert = true
                        }
                    }
                }
            }
        }
        // ownership of the ORIGINAL error payload: conversion produced a fresh owned
        // value from a +0 borrow of errVal — a temp operand's own +1 must then be
        // released (it escapes nowhere) or it leaks. Without conversion the payload
        // itself is returned: a place operand's +0 alias must be retained (dropScope
        // below releases the place; the return must own its payload).
        if opErrRef != 0U64 {
            if c.arcNeedsRelease(ref: opErrRef) {
                if didConvert {
                    if !(operandIsPlace) {
                        self.valueArc(c: inout c, v: errVal, typeRef: opErrRef, retain: false)
                    }
                } else {
                    if operandIsPlace {
                        self.valueArc(c: inout c, v: errVal, typeRef: opErrRef, retain: true)
                    }
                }
            }
        }
        val didR: Bool = self.setEnumEnv(c: inout c, ref: self.curRetRef)
        mut val errArgs: Array[LLVMValueRef] = []
        errArgs.append(convErrVal)
        val retResult: LLVMValueRef = self.buildEnumFromValues(c: inout c, eid: reid, ety: rety, vi: errVi, payloadVals: errArgs)
        if didR { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
        // this is a RETURN: unwind every live owned local and unmoved statement temp
        // exactly as Stmt.Return does (the error payload was moved into retResult and
        // the operand's temp home is not registered — neither is touched). Without
        // this, every error propagation leaked the whole live frame.
        self.dropScope(c: inout c, fromMark: 0U64, excludeLi: 18446744073709551615U64)
        LLVMBuildRet(self.b, retResult)
        // Ok: extract and yield the value; control continues at okBB.
        LLVMPositionBuilderAtEnd(self.b, okBB)
        self.terminated = false
        val didO: Bool = self.setEnumEnv(c: inout c, ref: exprRef)
        val okPayloadTy: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: eeid, vi: okVi)
        val okPayload: LLVMValueRef = LLVMBuildLoad2(self.b, okPayloadTy, LLVMBuildStructGEP2(self.b, eety, eslot, 1U64, anon()), anon())
        val okVal: LLVMValueRef = LLVMBuildExtractValue(self.b, okPayload, 0U64, anon())
        if didO { c.cur.typeParams = savedP  c.cur.typeArgs = savedA }
        // a place operand's Ok payload is a +0 alias, but `try`'s consumer treats the
        // yielded value as OWNED (exprAliasesPlace(Try) = false) — retain it so the
        // place and the consumer each hold a count (a temp operand transfers instead).
        if operandIsPlace {
            mut val okRef: U64 = 0
            if exprRef < c.arena.types.count() {
                if c.arena.types[exprRef].args.count() > 0U64 {
                    okRef = c.arena.types[exprRef].args[0]
                }
            }
            if okRef != 0U64 {
                if c.arcNeedsRelease(ref: okRef) {
                    self.valueArc(c: inout c, v: okVal, typeRef: okRef, retain: true)
                }
            }
        }
        return okVal
    }
}
