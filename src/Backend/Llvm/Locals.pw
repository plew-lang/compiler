// Part of the LLVM backend (root: _.pw): the local-variable environment (push / pop / find).

// ---- local environment ----

pub impl LlvmCtx {

    inout fn pushLocalR(nameStart: U64, nameLen: U64, ptr: LLVMValueRef, ty: LLVMTypeRef, kind: U64, structIdx: U64, isArr: Bool, elemTy: LLVMTypeRef, elemKind: U64, typeRef: U64) {
        if self.nLocals < self.locStart.count() {
            self.locStart[self.nLocals] = nameStart
            self.locLen[self.nLocals] = nameLen
            self.locPtr[self.nLocals] = ptr
            self.locTy[self.nLocals] = ty
            self.locKind[self.nLocals] = kind
            self.locStructIdx[self.nLocals] = structIdx
            self.locIsArr[self.nLocals] = isArr
            self.locElemTy[self.nLocals] = elemTy
            self.locElemKind[self.nLocals] = elemKind
            self.locTypeRef[self.nLocals] = typeRef
            self.locElemTypeRef[self.nLocals] = 0U64
            self.locOwned[self.nLocals] = true
            self.locMoved[self.nLocals] = false
            self.locCellHome[self.nLocals] = false
        } else {
            self.locStart.append(nameStart)
            self.locLen.append(nameLen)
            self.locPtr.append(ptr)
            self.locTy.append(ty)
            self.locKind.append(kind)
            self.locStructIdx.append(structIdx)
            self.locIsArr.append(isArr)
            self.locElemTy.append(elemTy)
            self.locElemKind.append(elemKind)
            self.locTypeRef.append(typeRef)
            self.locElemTypeRef.append(0U64)
            self.locOwned.append(true)
            self.locMoved.append(false)
            self.locCellHome.append(false)
        }
        self.nLocals = self.nLocals + 1
    }

    // Set up a function/closure body's blocks: an `entry` block holding ALL the
    // function's allocas, ending in `br body0`, then `body0` where straight-line code
    // begins. `entryAlloca` inserts before entry's `br`, so an alloca emitted inside a
    // loop body lands in entry (allocated once) instead of accumulating stack per
    // iteration — which overflowed the 8 MB stack on large inputs. Positions the
    // builder at `body0`; the caller binds params + emits the body from there.
    inout fn beginFnBody(fv: LLVMValueRef) {
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        val body0: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "body0"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        LLVMBuildBr(self.b, body0)
        LLVMPositionBuilderAtEnd(self.b, body0)
        self.terminated = false
        // scope-exit release reads the locOwned flag (borrows — by-value params, seeded
        // globals, borrow-class captures — are flagged un-owned at bind). curBodyMark no
        // longer gates the drop kernel; it remains the boundary between the binding
        // prologue and body locals for the emitters that need it (async frame walk,
        // loop unwind marks). Default to a sentinel so an entry that forgets to set its
        // real body mark fails safe.
        self.curBodyMark = 18446744073709551615U64
    }

    // Allocate in the current function's entry block (before its terminator), then
    // restore the builder. The entry block always has a terminator here (beginFnBody's
    // `br`, or the async resume switch), so no null check is needed.
    inout fn entryAlloca(ty: LLVMTypeRef) -> LLVMValueRef {
        val cur: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val entry: LLVMBasicBlockRef = LLVMGetEntryBasicBlock(self.curFn)
        val term: LLVMValueRef = LLVMGetBasicBlockTerminator(entry)
        LLVMPositionBuilderBefore(self.b, term)
        val a: LLVMValueRef = LLVMBuildAlloca(self.b, ty, anon())
        LLVMPositionBuilderAtEnd(self.b, cur)
        return a
    }

    // Set the just-pushed local's ownership (false = a borrow/inout param the caller
    // owns, so it is not deinit'd here).
    inout fn setLocalOwned(owned: Bool) {
        if self.nLocals > 0U64 {
            self.locOwned[self.nLocals - 1U64] = owned
        }
    }

}
