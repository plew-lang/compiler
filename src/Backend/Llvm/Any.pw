// Part of the LLVM backend (root: _.pw): existential `any P` vtable, witness, boxing, and dynamic dispatch.

import ../../Ir with { CallReceiverPassing, CallArgumentPassing }

// ---- existential `any P` (spec/08): vtable, boxing, dynamic dispatch ----
//
// An `any P` value is the fat pointer st.anyTy = { ptr data, ptr vtable }. `data`
// points at an ARC box (rawbuf cell, rc-managed) holding the erased concrete value;
// `vtable` at a static per-(concrete-struct, trait) global of function pointers:
// slot 0 = the copy thunk (value semantics / box privatization), slot 1 = the drop
// thunk (destroys the boxed concrete's owned heap at rc 0 — emitAnyRelease), slots
// 2.. = a thunk per trait requirement in declaration order. Each requirement thunk
// has the ERASED signature `(ptr self_data, <req params>) -> <req ret>` and forwards
// to the concrete witness pf<wfi> after loading the boxed self.
//
// Ownership (AnyBox class): copying an `any` place CoW-SHARES the box (rc++); the
// sole write point — an `inout` requirement dispatch — privatizes a shared box first
// (privatizeAnyBox), mirroring the CoW discipline of arrays/boxed fields.

// Do two parameter lists have identical labels positionally (a conformance witness
// reproduces the requirement's labels)?

pub impl LlvmCtx {

    // Register the physical erased ABI. The semantic body is emitted later
    // from verified Mid, never while another body owns the local environment.
    inout fn buildAnyThunk(c: inout Comp, resolutionIndex: U64, sidx: U64, idx: U64) -> LLVMValueRef {
        val member = c.arena.finalExistentials[resolutionIndex].members[idx]
        if member.bodyId == 0U64 { return LLVMConstNull(self.ptrty) }
        // The erased ABI is a frontend fact. Only physical types are selected here.
        mut val ptys: Array[LLVMTypeRef] = [self.ptrty]
        mut val pi = 0U64
        while pi < member.parameterTypes.count() {
            match member.argumentPassings[pi] {
                CallArgumentPassing.Inout => { ptys.append(self.ptrty) }
                _ => { ptys.append(self.llvmTypeOfRef(c: inout c, ref: member.parameterTypes[pi])) }
            }
            pi += 1U64
        }
        mut val rty = self.voidty
        if member.resultType != 0U64 { rty = self.llvmTypeOfRef(c: inout c, ref: member.resultType) }
        val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count(), 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvt".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: idx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: resolutionIndex)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        self.existentialWitnesses.append(<LlvmExistentialWitness resolution=resolutionIndex member=idx function=fv />)
        return fv
    }

    inout fn emitExistentialWitnesses(c: inout Comp) {
        val savedFn = c.cur.bodyFnIdx
        val savedEnvironment = c.cur.bodyEnvironment
        val savedBody = c.cur.bodyId
        while self.existentialWitnessesEmitted < self.existentialWitnesses.count() {
            val witness = self.existentialWitnesses[self.existentialWitnessesEmitted]
            val member = c.arena.finalExistentials[witness.resolution].members[witness.member]
            val body = c.arena.bodyInstanceAt(index: member.adapterBodyId - 1U64)
            c.cur.bodyFnIdx = body.fnIdx
            c.cur.bodyEnvironment = body.environment
            c.cur.bodyId = member.adapterBodyId
            self.curFn = witness.function
            self.curIsMain = false
            self.curRetVoid = member.resultType == 0U64
            self.curRetTy = self.voidty
            if member.resultType != 0U64 { self.curRetTy = self.llvmTypeOfRef(c: inout c, ref: member.resultType) }
            val prepared = self.prepareSyntheticMidBody(c: inout c, bodyId: member.adapterBodyId, fnIdx: body.fnIdx, parameterCount: member.parameterTypes.count() + 1U64)
            match prepared {
                MidLlvmPrepared.None => { c.errorAt(offset: c.arena.functionAt(index: body.fnIdx).nameStart, msg: "LLVM backend: existential witness could not be prepared as Mid IR") }
                MidLlvmPrepared.Ready(canonical: _, abiParameterCount: _) => {
                    self.beginFnBody(fv: witness.function)
                    // The only erased ABI adaptation: a read receiver is a
                    // borrowed load from its box; inout keeps the same address.
                    mut val receiver = self.valueParameter(function: witness.function, index: 0U64)
                    match member.receiverPassing {
                        CallReceiverPassing.Inout => {}
                        _ => { receiver = llvmLoad(self.b, self.llvmTypeOfRef(c: inout c, ref: body.environment.receiverRef), receiver, anon()) }
                    }
                    mut val parameters: Array[LLVMValueRef] = [receiver]
                    mut val index = 0U64
                    while index < member.parameterTypes.count() {
                        parameters.append(self.valueParameter(function: witness.function, index: index + 1U64))
                        index += 1U64
                    }
                    if !self.genLlvmPreparedMidBody(c: inout c, prepared: prepared, abiParameterValues: parameters) {
                        c.errorAt(offset: c.arena.functionAt(index: body.fnIdx).nameStart, msg: "LLVM backend: prepared existential Mid body failed to emit")
                    }
                }
            }
            self.existentialWitnessesEmitted += 1U64
            tracePhaseProgress(c: inout c, label: "backend:existential-witness", count: self.existentialWitnessesEmitted, stride: 16U64)
        }
        c.cur.bodyFnIdx = savedFn
        c.cur.bodyEnvironment = savedEnvironment
        c.cur.bodyId = savedBody
    }

    // Privatize the existential box. The new box owns a logical copy of the
    // concrete value: nested buffers remain CoW-shared until their own writes.
    inout fn buildAnyCopyThunk(c: inout Comp, sourceRef: U64, sidx: U64) -> LLVMValueRef {
        val concreteTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: sourceRef)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtcopy".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        val srcVal: LLVMValueRef = llvmLoad(self.b, concreteTy, self.valueParameter(function: fv, index: 0U64), anon())
        self.emitStructRetain(c: inout c, v: srcVal, ref: sourceRef)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        llvmStore(self.b, srcVal, cell)
        LLVMBuildRet(self.b, cell)
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Build the drop thunk for concrete struct `sidx` (vtable slot 1): `drop(ptr box)`
    // destroys the boxed concrete value's owned heap (classifier-routed valueArc, which
    // lands on the per-type witnesses). The caller (emitAnyRelease) frees the box itself
    // afterwards. Rebuilt per vtable like the copy thunk (LLVM uniques duplicate names).
    inout fn buildAnyDropThunk(c: inout Comp, sourceRef: U64, sidx: U64) -> LLVMValueRef {
        val concreteTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: sourceRef)
        val instRef: U64 = sourceRef
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtdrop".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = self.declareValueFunction(name: arrayCPtr(nm), signature: fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val savedFn: LLVMValueRef = self.curFn
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        self.curFn = fv
        if c.finalNeedsRelease(typeRef: instRef) {
            val v: LLVMValueRef = llvmLoad(self.b, concreteTy, self.valueParameter(function: fv, index: 0U64), anon())
            self.valueArc(c: inout c, v: v, typeRef: instRef, retain: false)
        }
        LLVMBuildRetVoid(self.b)
        self.curFn = savedFn
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Release one owner of an existential's box: decrement its rc, and at 0 destroy
    // the boxed concrete through the vtable's drop thunk (slot 1) then free the box.
    // Null-safe (an unset enum payload slot holds a null box; plew_rawbuf_release returns 0
    // for null, and the destroy branch is additionally gated on non-null) — mirrors
    // emitBoxedFieldRelease's dec-then-cascade shape.
    inout fn emitAnyRelease(c: inout Comp, fat: LLVMValueRef) {
        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vt: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val rc: LLVMValueRef = self.rawbufRelease(c: inout c, cell: cell)
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val nonNull: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), cell, LLVMConstNull(self.ptrty), anon())
        val doDestroy: LLVMValueRef = LLVMBuildAnd(self.b, isZero, nonNull, anon())
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anyrel.free"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anyrel.cont"))
        LLVMBuildCondBr(self.b, doDestroy, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        mut val gepIdx: Array[LLVMValueRef] = []
        gepIdx.append(LLVMConstInt(self.i64ty, 1U64, 0I32))
        val slotPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.ptrty, vt, arrayCPtr(gepIdx), 1U64, anon())
        val dropFn: LLVMValueRef = llvmLoad(self.b, self.ptrty, slotPtr, anon())
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val dty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        self.callValueFunction(signature: dty, function: dropFn, arguments: av)
        self.rawbufFree(c: inout c, cell: cell)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
    }

    // The CoW write gate for an existential: an `inout` requirement mutates THROUGH
    // the box, so a shared box (rc > 1) is split first — copy-thunk the boxed value
    // into a fresh box, drop this owner's count on the old one, and repoint the
    // receiver PLACE at the fresh fat pointer. Sharers keep the old value; the
    // mutation lands on this owner's private box. Mirrors plew_arr_cow / the boxed
    // field's fresh-cell repoint. Returns the (possibly privatized) fat value.
    inout fn privatizeAnyBox(c: inout Comp, fat: LLVMValueRef, place: LLVMValueRef) -> LLVMValueRef {
        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        // rc lives in the rawbuf header at data[-1] (see plew_rawbuf_alloc).
        mut val rcIdx: Array[LLVMValueRef] = []
        rcIdx.append(LLVMConstInt(self.i64ty, 18446744073709551615U64, 0I32))
        val rcPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.i64ty, cell, arrayCPtr(rcIdx), 1U64, anon())
        val rc: LLVMValueRef = llvmLoad(self.b, self.i64ty, rcPtr, anon())
        val isShared: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntSgt(), rc, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
        val splitBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anycow.split"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anycow.cont"))
        LLVMBuildCondBr(self.b, isShared, splitBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, splitBB)
        val fresh: LLVMValueRef = self.copyAnyValue(c: inout c, fat: fat)
        val ignore: LLVMValueRef = self.rawbufRelease(c: inout c, cell: cell)
        llvmStore(self.b, fresh, place)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
        // reload from the place: the fresh fat on the split path, the original otherwise.
        return llvmLoad(self.b, self.anyTy, place, anon())
    }

    // Value-semantics copy of an `any P` fat-pointer value: invoke its vtable's copy
    // thunk (slot 0) to duplicate the boxed concrete, returning a fresh `{ newdata,
    // vtable }`. Used by privatizeAnyBox (the CoW split) — plain place->owner copies
    // CoW-share the box instead (copyAnyIfPlace).
    inout fn copyAnyValue(c: inout Comp, fat: LLVMValueRef) -> LLVMValueRef {
        val dataPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vtPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val copyFn: LLVMValueRef = llvmLoad(self.b, self.ptrty, vtPtr, anon())
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(dataPtr)
        val newData: LLVMValueRef = self.callValueFunction(signature: fty, function: copyFn, arguments: av)
        mut val agg: LLVMValueRef = LLVMGetUndef(self.anyTy)
        agg = LLVMBuildInsertValue(self.b, agg, newData, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, vtPtr, 1U64, anon())
        return agg
    }
}

pub impl LlvmCtx {

    // Build (or fetch cached) the vtable global for (concrete struct `sidx`, trait
    // `traitIdx`): an array of ptr slots — slot 0 = copy thunk (value semantics /
    // privatization), slot 1 = drop thunk (box destruction at rc 0), slots 2.. = a
    // thunk per requirement in declaration order. Returns the global pointer.
    inout fn ensureAnyVtable(c: inout Comp, sourceRef: U64, sidx: U64, anyRef: U64, traitIdx: U64) -> LLVMValueRef {
        val resolutionIndex: U64 = c.finalExistentialIndex(sourceRef: sourceRef, targetRef: anyRef)
        if resolutionIndex >= c.arena.finalExistentials.count() {
            if c.traceCodegen {
                eprint(text: "[trace-codegen] missing existential source=")
                c.traceMonoTypeHead(ref: sourceRef)
                eprint(text: " target=")
                c.traceMonoTypeHead(ref: anyRef)
                eprint(text: "\n")
                mut val diagnosticIndex: U64 = 0U64
                while diagnosticIndex < c.arena.finalExistentials.count() {
                    eprint(text: "[trace-codegen] recorded existential source=")
                    c.traceMonoTypeHead(ref: c.arena.finalExistentials[diagnosticIndex].sourceRef)
                    eprint(text: " target=")
                    c.traceMonoTypeHead(ref: c.arena.finalExistentials[diagnosticIndex].targetRef)
                    eprint(text: "\n")
                    diagnosticIndex += 1U64
                }
            }
            c.errorAt(offset: 0U64, msg: "internal error: existential conversion was not finalized")
        }
        mut val ci: U64 = 0U64
        while ci < self.anyVtResolution.count() {
            if self.anyVtResolution[ci] == resolutionIndex + 1U64 { return self.anyVtVal[ci] }
            ci += 1U64
        }
        val t: TraitDef = c.decls.traitAt(index: traitIdx)
        // pre-create the global (with its final array type) and CACHE it before building
        // thunks, so a `-> Self` re-erasure thunk that re-boxes into this same existential
        // resolves to this vtable instead of recursing into ensureAnyVtable forever.
        val slotCount: U64 = 2U64 + t.reqs.count()
        val arrTy: LLVMTypeRef = LLVMArrayType2(self.ptrty, slotCount)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtbl".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: traitIdx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: resolutionIndex)
        nm.append(0)
        val g: LLVMValueRef = LLVMAddGlobal(self.mod, arrTy, arrayCPtr(nm))
        LLVMSetGlobalConstant(g, 1I32)
        self.anyVtResolution.append(resolutionIndex + 1U64)
        self.anyVtVal.append(g)
        mut val slots: Array[LLVMValueRef] = []
        slots.append(self.buildAnyCopyThunk(c: inout c, sourceRef: sourceRef, sidx: sidx))
        slots.append(self.buildAnyDropThunk(c: inout c, sourceRef: sourceRef, sidx: sidx))
        mut val ri: U64 = 0
        while ri < t.reqs.count() {
            slots.append(self.buildAnyThunk(c: inout c, resolutionIndex: resolutionIndex, sidx: sidx, idx: ri))
            ri += 1
        }
        LLVMSetInitializer(g, LLVMConstArray2(self.ptrty, arrayCPtr(slots), slots.count()))
        return g
    }
}

pub impl LlvmCtx {

    // Box concrete value `v` of struct `sidx` into a fresh ARC cell and wrap it with the
    // (sidx, traitIdx) vtable, producing an `any P` fat-pointer value.
    inout fn boxIntoAny(c: inout Comp, sourceRef: U64, v: LLVMValueRef, sidx: U64, anyRef: U64, traitIdx: U64) -> LLVMValueRef {
        val concreteTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: sourceRef)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        llvmStore(self.b, v, cell)
        val vt: LLVMValueRef = self.ensureAnyVtable(c: inout c, sourceRef: sourceRef, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx)
        mut val agg: LLVMValueRef = LLVMGetUndef(self.anyTy)
        agg = LLVMBuildInsertValue(self.b, agg, cell, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, vt, 1U64, anon())
        return agg
    }

    // Emit function `fi`'s body into the LLVM function value `fv` (under the active
    // substitution env, if any — used for both plain functions and generic instances).
    inout fn genLlvmFuncBody(c: inout Comp, bodyId: U64, fv: LLVMValueRef) {
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() {
            c.errorAt(offset: 0U64, msg: "internal error: function emission requires a finalized body")
            return
        }
        val fi = c.arena.bodyInstanceAt(index: bodyId - 1U64).fnIdx
        val f: Func = c.arena.functionAt(index: fi)
        if c.traceCodegen {
            eprint(text: "[trace-codegen] function body-entry name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " fn=")
            self.traceCodegenU64(n: fi)
            eprint(text: "\n")
        }
        // save the Self/Item env so this body fully restores it on exit — the body binds `self`
        // and sets cur.selfRef from the receiver ref (see the self-local binding below), which
        // must not leak into the next body (a pf-drain / free-fn emission has no per-call
        // save/restore around genLlvmFuncBody).
        val savedSelfFB: U64 = c.cur.selfRef
        val savedItemFB: U64 = c.cur.itemRef
        self.curFn = fv
        self.curIsMain = false
        self.curRetVoid = self.bodyResultType(c: inout c, bodyId: bodyId) == 0U64
        // a plain method's `Self` resolves to the receiver type, so `-> Self` / a `Self`
        // param / `return self` ground (the generic-method path sets this via its
        // instantiation elsewhere; here it covers a non-generic method on a plain type).
        val didSelf: Bool = f.hasRecv && self.curRecvInstRef == 0U64 && c.cur.selfRef == 0U64
        if didSelf {
            c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
        }
        self.curRetTy = self.bodyReturnLlvmTy(c: inout c, bodyId: bodyId)
        if c.traceCodegen {
            eprint(text: "[trace-codegen] function body-metadata-ready name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " fn=")
            self.traceCodegenU64(n: fi)
            eprint(text: "\n")
        }
        // Coverage identifies the frontend's concrete body instance before any
        // Mid stage runs.  The stages below must not substitute a source-level
        // function identity or spelling when a frozen instance is unavailable.

        // Select a complete Mid body before beginning LLVM emission.  The
        // receiver and parameters form the checked Mid-local ABI prefix.
        // Receiver ownership is carried by ownsAtEntry/isInout and checked
        // by the same dataflow and LLVM admission as ordinary parameters.
        mut val midReady: Bool = false
        mut val preparedMid: MidLlvmPrepared = <MidLlvmPrepared.None />
        mut val midEligible: Bool = true
        if f.isAsync {
            self.recordMidEligibility(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidEligibilityReason.Async />)
            midEligible = false
        }
        if f.isExtern {
            self.recordMidEligibility(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidEligibilityReason.Extern />)
            midEligible = false
        }
        if midEligible {
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid build-start name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            val parametric: MidBodyBuild = buildMidBodyForInstance(c: inout c, fnIdx: fi, bodyId: bodyId)
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid build-done name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: " body=")
                self.traceCodegenU64(n: bodyId)
                eprint(text: "\n")
            }
            // Keep the returned build record alive while extracting its scalar
            // error field.  The trace boundary distinguishes a broken field
            // projection/return ABI from a broken enum switch in the bootstrap
            // fixed-point compiler.
            val parametricError: MidBuildError = parametric.error
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid error-field-ready name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            match parametricError {
                MidBuildError.None => {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] Mid build-success name=")
                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                        eprint(text: " fn=")
                        self.traceCodegenU64(n: fi)
                        eprint(text: "\n")
                    }
                    if bodyId != 0U64 {
                        if c.traceCodegen {
                            eprint(text: "[trace-codegen] Mid instantiate-start name=")
                            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                            eprint(text: " fn=")
                            self.traceCodegenU64(n: fi)
                            eprint(text: "\n")
                        }
                        val instantiated: MidCanonicalInstantiation = instantiateCanonicalMidBody(c: inout c, body: parametric.canonical, bodyId: bodyId)
                        if c.traceCodegen {
                            eprint(text: "[trace-codegen] Mid instantiate-done name=")
                            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                            eprint(text: " fn=")
                            self.traceCodegenU64(n: fi)
                            eprint(text: "\n")
                        }
                        match instantiated.error {
                            MidInstantiateError.None => {
                                if c.traceCodegen {
                                    eprint(text: "[trace-codegen] Mid access-start name=")
                                    self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                    eprint(text: " fn=")
                                    self.traceCodegenU64(n: fi)
                                    eprint(text: "\n")
                                }
                                val accesses: MidCanonicalAccessElaboration = elaborateCanonicalMidAccesses(c: inout c, canonical: instantiated.body)
                                if c.traceCodegen {
                                    eprint(text: "[trace-codegen] Mid access-done name=")
                                    self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                    eprint(text: " fn=")
                                    self.traceCodegenU64(n: fi)
                                    eprint(text: "\n")
                                }
                                mut val accessReady: Bool = true
                                match accesses.error {
                                    MidAccessError.None => {}
                                    _ => {
                                        accessReady = false
                                        self.recordMidAccess(c: inout c, bodyId: bodyId, fnIdx: fi)
                                        if c.traceCodegen { eprint(text: "[trace-codegen] Mid function: access elaboration unsupported\n") }
                                    }
                                }
                                if accessReady {
                                    if c.traceCodegen {
                                        eprint(text: "[trace-codegen] Mid drops-start name=")
                                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                        eprint(text: " fn=")
                                        self.traceCodegenU64(n: fi)
                                        eprint(text: "\n")
                                    }
                                    val elaborated: MidCanonicalBody = elaborateCanonicalMidDrops(c: inout c, canonical: optimizeCanonicalMidReturns(arena: inout c.mid, canonical: accesses.body))
                                    if c.traceCodegen {
                                        eprint(text: "[trace-codegen] Mid drops-done name=")
                                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                        eprint(text: " fn=")
                                        self.traceCodegenU64(n: fi)
                                        eprint(text: "\n")
                                    }
                                    if c.traceCodegen {
                                        eprint(text: "[trace-codegen] Mid verify-start name=")
                                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                        eprint(text: " fn=")
                                        self.traceCodegenU64(n: fi)
                                        eprint(text: "\n")
                                    }
                                    val verification: MidVerification = verifyExecutableCanonicalMidBody(c: inout c, canonical: elaborated)
                                    if c.traceCodegen {
                                        match verification.error {
                                            MidVerifyError.None => {}
                                            _ => {
                                                eprint(text: "[trace-codegen] Mid verification location fn=")
                                                self.traceCodegenU64(n: fi)
                                                eprint(text: " block=")
                                                self.traceCodegenU64(n: verification.block)
                                                eprint(text: " local=")
                                                self.traceCodegenU64(n: verification.local)
                                                eprint(text: "\n")
                                                val failedBody = c.mid.bodies[elaborated.body - 1U64]
                                                if verification.local < failedBody.locals.len {
                                                    val local = c.mid.locals[failedBody.locals.start + verification.local]
                                                    eprint(text: "[trace-codegen] Mid failed-local binding=")
                                                    self.traceCodegenU64(n: local.sourceNameStart)
                                                    eprint(text: " scope=")
                                                    self.traceCodegenU64(n: local.sourceScope)
                                                    eprint(text: " type=")
                                                    c.traceMonoTypeHead(ref: local.typeTerm)
                                                    eprint(text: "\n")
                                                }
                                                if verification.block < failedBody.blocks.len {
                                                    val failedBlock = c.mid.blocks[failedBody.blocks.start + verification.block]
                                                    mut val statementIndex: U64 = 0U64
                                                    while statementIndex < failedBlock.statements.len {
                                                        val statement = c.mid.statements[failedBlock.statements.start + statementIndex]
                                                        eprint(text: "[trace-codegen] Mid failed-block statement=")
                                                        self.traceCodegenU64(n: statementIndex)
                                                        eprint(text: " tag=")
                                                        self.traceCodegenU64(n: statement.tag)
                                                        if statement.destination != 0U64 {
                                                            eprint(text: " destination=")
                                                            self.traceCodegenU64(n: c.mid.places[statement.destination - 1U64].local)
                                                            eprint(text: " destination-type=")
                                                            self.traceCodegenU64(n: c.mid.places[statement.destination - 1U64].typeTerm)
                                                        }
                                                        if statement.source != 0U64 {
                                                            val source = c.mid.places[statement.source - 1U64]
                                                            eprint(text: " overwrite-source=")
                                                            self.traceCodegenU64(n: source.local)
                                                            eprint(text: " source-local-type=")
                                                            self.traceCodegenU64(n: c.mid.locals[failedBody.locals.start + source.local].typeTerm)
                                                        }
                                                        if statement.value != 0U64 {
                                                            val value = c.mid.rvalues[statement.value - 1U64]
                                                            eprint(text: " rvalue=")
                                                            self.traceCodegenU64(n: value.tag)
                                                            if value.operand != 0U64 {
                                                                val operand = c.mid.operands[value.operand - 1U64]
                                                                eprint(text: " operand=")
                                                                self.traceCodegenU64(n: operand.tag)
                                                                if operand.place != 0U64 {
                                                                    eprint(text: " source=")
                                                                    self.traceCodegenU64(n: c.mid.places[operand.place - 1U64].local)
                                                                }
                                                            }
                                                        }
                                                        eprint(text: "\n")
                                                        statementIndex += 1U64
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if c.traceCodegen {
                                        eprint(text: "[trace-codegen] Mid verify-done name=")
                                        self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                        eprint(text: " fn=")
                                        self.traceCodegenU64(n: fi)
                                        eprint(text: "\n")
                                    }
                                    match verification.error {
                                        MidVerifyError.None => {
                                        val signature = c.arena.bodySignature(bodyId: bodyId)
                                        mut val abiParameterCount: U64 = signature.parameterTypes.count()
                                        match signature.receiverPassing {
                                            CallReceiverPassing.None => {}
                                            _ => { abiParameterCount += 1U64 }
                                        }
                                        if c.traceCodegen {
                                            eprint(text: "[trace-codegen] Mid function preflight name=")
                                            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                            eprint(text: " fn=")
                                            self.traceCodegenU64(n: fi)
                                            eprint(text: "\n")
                                        }
                                        match self.midVerifiedLlvmPreflight(c: inout c, canonical: elaborated, abiParameterCount: abiParameterCount) {
                                            MidLlvmPreflight.Ready => {
                                                preparedMid = <MidLlvmPrepared.Ready canonical=elaborated abiParameterCount=abiParameterCount />
                                                midReady = true
                                                if c.traceCodegen {
                                                    eprint(text: "[trace-codegen] Mid function ready name=")
                                                    self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                                                    eprint(text: " fn=")
                                                    self.traceCodegenU64(n: fi)
                                                    eprint(text: "\n")
                                                }
                                            }
                                            MidLlvmPreflight.AbiLocals => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.AbiLocals />) }
                                            MidLlvmPreflight.AssignmentProjection => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.AssignmentProjection />) }
                                            MidLlvmPreflight.UnsupportedRvalue => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.UnsupportedRvalue />) }
                                            MidLlvmPreflight.ConversionOperand => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ConversionOperand />) }
                                            MidLlvmPreflight.DropProjection => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.DropProjection />) }
                                            MidLlvmPreflight.ScopeExit => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ScopeExit />) }
                                            MidLlvmPreflight.Switch => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Switch />) }
                                            MidLlvmPreflight.Call(reason: val reason) => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Call reason=reason />) }
                                            MidLlvmPreflight.ReturnValue => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.ReturnValue />) }
                                            MidLlvmPreflight.Terminator => { self.recordMidPreflight(c: inout c, bodyId: bodyId, fnIdx: fi, reason: <MidLlvmPreflight.Terminator />) }
                                        }
                                        }
                                        MidVerifyError.InvalidTarget => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.PartialMove => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.MoveUnavailable => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.DropUnavailable => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.InvalidDropFlag => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UninitializedDropFlag => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UnelaboratedBindingEnd => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UnelaboratedScopeExit => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UnelaboratedAccess => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UninstantiatedReturnBoundary => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UninstantiatedStorageBoundary => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.UninstantiatedCastBoundary => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                        MidVerifyError.MissingOwnershipContract => { self.recordMidVerify(c: inout c, bodyId: bodyId, fnIdx: fi, reason: verification.error) }
                                    }
                                }
                            }
                            _ => {
                                self.recordMidInstantiate(c: inout c, bodyId: bodyId, fnIdx: fi, reason: instantiated.error)
                                if c.traceCodegen { eprint(text: "[trace-codegen] Mid function: instantiation failed\n") }
                            }
                        }
                    } else {
                        self.recordMidMissingBodyInstance(c: inout c, bodyId: bodyId, fnIdx: fi)
                        if c.traceCodegen { eprint(text: "[trace-codegen] Mid function: missing body instance\n") }
                    }
                }
                MidBuildError.InvalidStatement => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 1U64) }
                MidBuildError.InvalidBlock => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 2U64) }
                MidBuildError.InvalidFunction => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 3U64) }
                MidBuildError.MissingSemanticType => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 4U64) }
                MidBuildError.UnboundLocalIdentifier => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 5U64) }
                MidBuildError.Unsupported(reason: val unsupported) => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 100U64 + self.midUnsupportedBuildCoverageDetail(reason: unsupported)) }
                MidBuildError.UnsupportedAssign(reason: val reason) => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 20U64 + self.midUnsupportedAssignCoverageDetail(reason: reason)) }
                MidBuildError.UnsupportedWhile => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 7U64) }
                MidBuildError.UnsupportedFor => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 8U64) }
                MidBuildError.UnsupportedMatch => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 9U64) }
                MidBuildError.UnsupportedPanic => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 10U64) }
                MidBuildError.UnsupportedGive => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 11U64) }
                MidBuildError.UnsupportedBreak => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 12U64) }
                MidBuildError.UnsupportedContinue => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 13U64) }
                MidBuildError.MissingTerminator => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 14U64) }
                MidBuildError.MissingCallTemplate => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 15U64) }
                MidBuildError.UnsupportedCallTemplate => { self.recordMidBuild(c: inout c, bodyId: bodyId, fnIdx: fi, detail: 16U64) }
            }
        } else { if c.traceCodegen { eprint(text: "[trace-codegen] Mid function: ABI unsupported\n") } }
        if !midReady {
            c.errorAt(offset: f.nameStart, msg: "internal error: function requires verified Mid lowering")
            return
        }
        self.beginFnBody(fv: fv)
        if midReady {
            // Preflight completed before `beginFnBody`; a failure is an
            // invariant violation, never permission to reopen the AST after
            // partially emitting this function.
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid function emit-start name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            if !(self.genLlvmPreparedMidBody(c: inout c, prepared: preparedMid)) {
                c.errorAt(offset: 0U64, msg: "internal error: preflighted Mid function failed LLVM lowering")
            }
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid function emit-done name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            if didSelf { c.clearSelfItemEnv() }
            c.cur.selfRef = savedSelfFB
            c.cur.itemRef = savedItemFB
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid function return name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            return
        }

    }
}
