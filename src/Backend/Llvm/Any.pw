// Part of the LLVM backend (root: _.pw): existential `any P` vtable, witness, boxing, and dynamic dispatch.


// ---- existential `any P` (spec/08): vtable, boxing, dynamic dispatch ----
//
// An `any P` value is the fat pointer st.anyTy = { ptr data, ptr vtable }. `data`
// points at an ARC box (rawbuf cell, rc-managed) holding the erased concrete value;
// `vtable` at a static per-(concrete-struct, trait) global of function pointers:
// slot 0 = the copy thunk (value semantics / box privatization), slot 1 = the drop
// thunk (destroys the boxed concrete's owned heap at rc 0 — emitAnyRelease), slots
// 2.. = a thunk per trait requirement in declaration order. Each requirement thunk
// has the ERASED signature `(ptr self_data, <req params>) -> <req ret>` and forwards
// to the concrete witness pf<wfi> after loading the boxed self.
//
// Ownership (AnyBox class): copying an `any` place CoW-SHARES the box (rc++); the
// sole write point — an `inout` requirement dispatch — privatizes a shared box first
// (privatizeAnyBox), mirroring the CoW discipline of arrays/boxed fields.

// Do two parameter lists have identical labels positionally (a conformance witness
// reproduces the requirement's labels)?

pub impl LlvmCtx {

    // Public endpoint lookup precedes any logical-vector construction. The
    // convention owns target/trait/slot, not the concrete adapter body.
    inout fn cachedWitnessValueAbi(targetType: U64, traitIndex: U64, slot: U64) -> Result[U64, CompileDiagnostic] {
        val scope = (try self.prepareValueAbiScope())
        try scope.validateScope()
        if slot == 0U64 { return <Result.Err error=valueAbiFailure(message: "witness slot is not one-based") /> }
        val slots = self.witnessValueAbis.getOr(key: targetType, fallback: [])
        if slot > slots.count() || slots[slot - 1U64] == 0U64 { return <Result.Ok value=0U64 /> }
        val abiId = slots[slot - 1U64]
        if abiId > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "cached witness descriptor out of range") /> }
        val abi = self.valueAbis[abiId - 1U64]
        if abi.ownerBody != 0U64 || !abi.convention.matchesWitness(targetType: targetType, traitIndex: traitIndex, slot: slot) || abi.moduleIdentity != scope.moduleIdentity || abi.contextIdentity != scope.contextIdentity || abi.revision != 1U64 { return <Result.Err error=valueAbiFailure(message: "cached witness endpoint/scope mismatch") /> }
        return <Result.Ok value=abiId />
    }

    inout fn saveWitnessValueAbi(c: inout Comp, targetType: U64, traitIndex: U64, slot: U64, signature: ExistentialRequirementSignature) -> Result[U64, CompileDiagnostic] {
        if targetType == 0U64 || targetType >= c.arena.typeCount() || !c.arena.typeAt(index: targetType).isAny || traitIndex >= c.decls.traitCount() || slot == 0U64 || slot > c.decls.traitAt(index: traitIndex).reqs.count() || signature.parameterTypes.count() != signature.argumentPassings.count() { return <Result.Err error=valueAbiFailure(message: "witness public signature is incomplete") /> }
        mut val parameters: Array[LlvmLogicalParameter] = [<LlvmLogicalParameter type=self.ptrty semanticType=targetType role=<LlvmParameterRole.ErasedReceiver /> mode=(try witnessReceiverMode(passing: signature.receiverPassing)) />]
        mut val index = 0U64
        while index < signature.parameterTypes.count() {
            val mode = argumentValueMode(passing: signature.argumentPassings[index])
            val type = if mode.key() == 2U64 { give self.ptrty } else { give (try self.llvmTypeOfRef(c: inout c, ref: signature.parameterTypes[index])) }
            parameters.append(<LlvmLogicalParameter type=type semanticType=signature.parameterTypes[index] role=<LlvmParameterRole.Ordinary index=index /> mode=mode />)
            index += 1U64
        }
        val result = if signature.resultType == 0U64 { give self.voidty } else { give (try self.llvmTypeOfRef(c: inout c, ref: signature.resultType)) }
        mut val slots = self.witnessValueAbis.getOr(key: targetType, fallback: [])
        while slots.count() < c.decls.traitAt(index: traitIndex).reqs.count() { slots.append(0U64) }
        if slots[slot - 1U64] != 0U64 { return <Result.Err error=valueAbiFailure(message: "witness template published twice") /> }
        val template = (try self.saveValueAbi(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Witness targetType=targetType traitIndex=traitIndex slot=slot /> parameters=parameters result=result resultTerm=signature.resultType />, ownerBody: 0U64))
        slots.set(i: slot - 1U64, value: template)
        self.witnessValueAbis[targetType] = slots
        return <Result.Ok value=template />
    }

    inout fn witnessTemplateForMember(c: inout Comp, resolutionIndex: U64, memberIndex: U64) -> Result[U64, CompileDiagnostic] {
        if resolutionIndex >= c.arena.finalExistentials.count() { return <Result.Err error=valueAbiFailure(message: "witness resolution out of range") /> }
        val resolution = c.arena.finalExistentials[resolutionIndex]
        if memberIndex >= resolution.members.count() { return <Result.Err error=valueAbiFailure(message: "witness member out of range") /> }
        val cached = (try self.cachedWitnessValueAbi(targetType: resolution.targetRef, traitIndex: resolution.traitIdx, slot: memberIndex + 1U64))
        if cached != 0U64 { return <Result.Ok value=cached /> }
        val member = resolution.members[memberIndex]
        val parameterTypes: Array[U64] = member.parameterTypes
        return self.saveWitnessValueAbi(c: inout c, targetType: resolution.targetRef, traitIndex: resolution.traitIdx, slot: memberIndex + 1U64, signature: <ExistentialRequirementSignature receiverPassing=member.receiverPassing parameterTypes=parameterTypes argumentPassings=member.argumentPassings resultType=member.resultType />)
    }

    inout fn witnessTemplateForCall(c: inout Comp, selected: CallResolution) -> Result[U64, CompileDiagnostic] {
        val endpoint = match selected.target { CallTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot) => { give (traitIndex: traitIndex, slot: slot) } _ => { return <Result.Err error=valueAbiFailure(message: "witness call has a different target family") /> } }
        val cached = (try self.cachedWitnessValueAbi(targetType: selected.recvTypeRef, traitIndex: endpoint.traitIndex, slot: endpoint.slot))
        if cached != 0U64 { return <Result.Ok value=cached /> }
        if selected.parameterTypeRefs.len != selected.argumentPassings.len { return <Result.Err error=valueAbiFailure(message: "witness call signature shape mismatch") /> }
        mut val parameters: Array[U64] = []
        mut val passings: Array[CallArgumentPassing] = []
        mut val index = 0U64
        while index < selected.parameterTypeRefs.len {
            parameters.append(c.arena.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: index))
            passings.append(c.arena.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: index))
            index += 1U64
        }
        // Calls retain the source expression's Unit term; member facts retain
        // the callable payload slot. Use the existing normalization before
        // caching so cold/warm endpoints agree on void without losing Unit.
        return self.saveWitnessValueAbi(c: inout c, targetType: selected.recvTypeRef, traitIndex: endpoint.traitIndex, slot: endpoint.slot, signature: <ExistentialRequirementSignature receiverPassing=selected.receiverPassing parameterTypes=parameters argumentPassings=passings resultType=c.callableResultSlot(ref: selected.resultTypeRef) />)
    }

    inout fn witnessBodyValueAbi(c: inout Comp, resolutionIndex: U64, memberIndex: U64, template: U64) -> Result[U64, CompileDiagnostic] {
        if resolutionIndex >= c.arena.finalExistentials.count() || template == 0U64 || template > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "witness declaration identity out of range") /> }
        val resolution = c.arena.finalExistentials[resolutionIndex]
        if memberIndex >= resolution.members.count() { return <Result.Err error=valueAbiFailure(message: "witness declaration member out of range") /> }
        if (try self.cachedWitnessValueAbi(targetType: resolution.targetRef, traitIndex: resolution.traitIdx, slot: memberIndex + 1U64)) != template { return <Result.Err error=valueAbiFailure(message: "witness declaration/template endpoint mismatch") /> }
        val member = resolution.members[memberIndex]
        if member.adapterBodyId == 0U64 || member.adapterBodyId > c.arena.bodyInstanceCount() || member.bodyId == 0U64 || member.bodyId > c.arena.bodyInstanceCount() { return <Result.Err error=valueAbiFailure(message: "witness declaration body out of range") /> }
        val validOrigin = match c.arena.bodyOrigin(bodyId: member.adapterBodyId) { BodyOrigin.ExistentialWitness(resolution: val owner, member: val position) => { give owner == resolutionIndex && position == memberIndex } _ => { give false } }
        if !validOrigin { return <Result.Err error=valueAbiFailure(message: "witness declaration body origin mismatch") /> }
        val signature = c.arena.bodySignature(bodyId: member.adapterBodyId)
        val plan = self.valueAbis[template - 1U64]
        if !signature.ready || !c.typeRefEq(a: signature.receiverType, b: resolution.sourceRef) || (try witnessReceiverMode(passing: signature.receiverPassing)).key() != (try witnessReceiverMode(passing: member.receiverPassing)).key() || plan.parameterCount != member.parameterTypes.count() + 1U64 || signature.parameterTypes.count() != member.parameterTypes.count() || signature.parameterPassings.count() != member.parameterTypes.count() || member.argumentPassings.count() != member.parameterTypes.count() || !c.typeRefEq(a: signature.resultType, b: plan.resultTerm) || !c.typeRefEq(a: member.resultType, b: plan.resultTerm) { return <Result.Err error=valueAbiFailure(message: "witness declaration/signature correspondence mismatch") /> }
        if plan.parameterStart > self.valueAbiParameters.count() || plan.parameterCount > self.valueAbiParameters.count() - plan.parameterStart { return <Result.Err error=valueAbiFailure(message: "witness declaration lane range mismatch") /> }
        if self.valueAbiParameters[plan.parameterStart].mode.key() != (try witnessReceiverMode(passing: member.receiverPassing)).key() { return <Result.Err error=valueAbiFailure(message: "witness declaration receiver mode mismatch") /> }
        mut val index = 0U64
        while index < member.parameterTypes.count() {
            val lane = self.valueAbiParameters[plan.parameterStart + index + 1U64]
            if !c.typeRefEq(a: lane.semanticType, b: member.parameterTypes[index]) || !c.typeRefEq(a: signature.parameterTypes[index], b: lane.semanticType) || lane.mode.key() != argumentValueMode(passing: member.argumentPassings[index]).key() || lane.mode.key() != argumentValueMode(passing: signature.parameterPassings[index]).key() { return <Result.Err error=valueAbiFailure(message: "witness declaration ordinary correspondence mismatch") /> }
            index += 1U64
        }
        self.valueAbis.append(<LlvmValueAbi parameterStart=plan.parameterStart parameterCount=plan.parameterCount logicalSignature=plan.logicalSignature functionType=plan.functionType moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=plan.revision convention=plan.convention resultTerm=plan.resultTerm resultProtocol=plan.resultProtocol ownerBody=member.adapterBodyId />)
        return <Result.Ok value=self.valueAbis.count() />
    }

    inout fn witnessCallee(c: inout Comp, selected: CallResolution, fat: LLVMValueRef) -> Result[LlvmWitnessCallee, CompileDiagnostic] {
        val template = (try self.witnessTemplateForCall(c: inout c, selected: selected))
        val abi = self.valueAbis[template - 1U64]
        if abi.parameterCount != selected.parameterTypeRefs.len + 1U64 || selected.argumentPassings.len != selected.parameterTypeRefs.len || !c.typeRefEq(a: abi.resultTerm, b: c.callableResultSlot(ref: selected.resultTypeRef)) || self.valueAbiParameters[abi.parameterStart].mode.key() != (try witnessReceiverMode(passing: selected.receiverPassing)).key() { return <Result.Err error=valueAbiFailure(message: "witness selected receiver/result/shape mismatch") /> }
        val scope = (try self.prepareValueAbiScope())
        return <Result.Ok value=<LlvmWitnessCallee template=template inputs=<LlvmCallableInputScope moduleIdentity=scope.moduleIdentity contextIdentity=scope.contextIdentity revision=1U64 callableIdentity=template signature=abi.logicalSignature /> fat=fat /> />
    }

    inout fn callWitnessValueFunction(callee: LlvmWitnessCallee, arguments: Array[LlvmValueInput]) -> Result[LLVMValueRef, CompileDiagnostic] {
        if callee.template == 0U64 || callee.template > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "witness call template out of range") /> }
        val abi = self.valueAbis[callee.template - 1U64]
        val endpoint = match abi.convention { LlvmValueConvention.Witness(targetType: val target, traitIndex: val traitIndex, slot: val slot) => { give (targetType: target, traitIndex: traitIndex, slot: slot) } _ => { return <Result.Err error=valueAbiFailure(message: "witness call convention mismatch") /> } }
        if (try self.cachedWitnessValueAbi(targetType: endpoint.targetType, traitIndex: endpoint.traitIndex, slot: endpoint.slot)) != callee.template || abi.parameterCount != arguments.count() + 1U64 { return <Result.Err error=valueAbiFailure(message: "witness call template/count mismatch") /> }
        if abi.parameterStart > self.valueAbiParameters.count() || abi.parameterCount > self.valueAbiParameters.count() - abi.parameterStart { return <Result.Err error=valueAbiFailure(message: "witness call lane range mismatch") /> }
        val scope = (try self.prepareValueAbiScope())
        try scope.validateCallableInputs(scope: callee.inputs, callableIdentity: callee.template, signature: abi.logicalSignature)
        val caller = LLVMGetBasicBlockParent(LLVMGetInsertBlock(self.b))
        try scope.validateValue(value: callee.fat, type: self.anyTy, function: caller)
        val data = LLVMBuildExtractValue(self.b, callee.fat, 0U64, anon())
        val table = LLVMBuildExtractValue(self.b, callee.fat, 1U64, anon())
        val indices: Array[LLVMValueRef] = [LLVMConstInt(self.i64ty, endpoint.slot + 1U64, 0I32)]
        val entry = LLVMBuildGEP2(self.b, self.ptrty, table, arrayCPtr(indices), 1U64, anon())
        val function = llvmLoad(self.b, self.ptrty, entry, anon())
        val receiver = self.valueAbiParameters[abi.parameterStart]
        try scope.validateInput(parameter: receiver, input: <LlvmValueInput lane=<LlvmLogicalParameter type=receiver.type semanticType=receiver.semanticType role=<LlvmParameterRole.ErasedReceiver /> mode=receiver.mode /> index=0U64 carrier=<LlvmValueCarrier.Value value=data /> />, index: 0U64, function: caller)
        mut val values: Array[LLVMValueRef] = [data]
        mut val index = 0U64
        while index < arguments.count() {
            val input = arguments[index]
            try scope.validateInput(parameter: self.valueAbiParameters[abi.parameterStart + index + 1U64], input: input, index: index + 1U64, function: caller)
            values.append(self.valueInputValue(input: input))
            index += 1U64
        }
        return self.emitPlannedValueCall(abiId: callee.template, function: function, arguments: values)
    }

    inout fn witnessBodyParameter(function: LLVMValueRef, bodyId: U64, index: U64) -> Result[LlvmValueInput, CompileDiagnostic] {
        val abiId = self.valueAbiFunctions.getOr(key: LLVMIsAFunction(function), fallback: 0U64)
        if abiId == 0U64 || abiId > self.valueAbis.count() { return <Result.Err error=valueAbiFailure(message: "witness parameter lacks descriptor") /> }
        val abi = self.valueAbis[abiId - 1U64]
        if abi.ownerBody != bodyId || bodyId == 0U64 || index >= abi.parameterCount { return <Result.Err error=valueAbiFailure(message: "witness parameter body/index mismatch") /> }
        match abi.convention { LlvmValueConvention.Witness(targetType: _, traitIndex: _, slot: _) => {} _ => { return <Result.Err error=valueAbiFailure(message: "witness parameter convention mismatch") /> } }
        return self.preparedValueParameter(function: function, abiId: abiId, index: index)
    }

    // Register the physical erased ABI. The semantic body is emitted later
    // from verified Mid, never while another body owns the local environment.
    inout fn buildAnyThunk(c: inout Comp, resolutionIndex: U64, sidx: U64, idx: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        val member = c.arena.finalExistentials[resolutionIndex].members[idx]
        if member.bodyId == 0U64 { return <Result.Ok value=LLVMConstNull(self.ptrty) /> }
        for witness in self.existentialWitnesses {
            if witness.resolution == resolutionIndex && witness.member == idx {
                return <Result.Ok value=witness.function />
            }
        }
        val template = (try self.witnessTemplateForMember(c: inout c, resolutionIndex: resolutionIndex, memberIndex: idx))
        val abiId = (try self.witnessBodyValueAbi(c: inout c, resolutionIndex: resolutionIndex, memberIndex: idx, template: template))
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvt".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: idx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: resolutionIndex)
        nm.append(0)
        val fv: LLVMValueRef = (try self.declarePlannedBodyFunction(name: arrayCPtr(nm), abiId: abiId, bodyId: member.adapterBodyId))
        self.existentialWitnesses.append(<LlvmExistentialWitness resolution=resolutionIndex member=idx function=fv />)
        return <Result.Ok value=fv />
    }

    // The erased entry and concrete receiver are distinct identities. Validate
    // each against its selected authority before retaining their conversion.
    inout fn prepareWitnessLocalBindings(c: inout Comp, body: MidBodyNode, parameterCount: U64, abiId: U64) -> Result[LlvmEntryLocalBindings, CompileDiagnostic] {
        if body.bodyInstance == 0U64 || body.bodyInstance > c.arena.bodyInstanceCount() { return <Result.Err error=valueAbiFailure(message: "witness local body identity out of range") /> }
        try self.validateWitnessLocalEntry(abiId: abiId, plannedAbi: abiId, bodyId: body.bodyInstance)
        val origin = match c.arena.bodyOrigin(bodyId: body.bodyInstance) {
            BodyOrigin.ExistentialWitness(resolution: val resolution, member: val member) => { give (resolution: resolution, member: member) }
            _ => { return <Result.Err error=valueAbiFailure(message: "witness local admission lacks a witness origin") /> }
        }
        if origin.resolution >= c.arena.finalExistentials.count() { return <Result.Err error=valueAbiFailure(message: "witness resolution out of range") /> }
        val resolution = c.arena.finalExistentials[origin.resolution]
        if origin.member >= resolution.members.count() { return <Result.Err error=valueAbiFailure(message: "witness member out of range") /> }
        val member = resolution.members[origin.member]
        if member.adapterBodyId != body.bodyInstance || member.bodyId == 0U64 || member.bodyId > c.arena.bodyInstanceCount() { return <Result.Err error=valueAbiFailure(message: "witness adapter/target identity mismatch") /> }
        val target = c.arena.bodyInstanceAt(index: member.bodyId - 1U64)
        val signature = c.arena.bodySignature(bodyId: body.bodyInstance)
        val receiverType = target.environment.receiverRef
        val receiverMode = (try witnessReceiverMode(passing: member.receiverPassing))
        if !signature.ready || !c.arena.bodySignature(bodyId: member.bodyId).ready || resolution.sourceRef == 0U64 || resolution.sourceRef >= c.arena.typeCount() || receiverType == 0U64 || receiverType >= c.arena.typeCount() || body.sourceFunction != target.fnIdx || !c.typeRefEq(a: signature.receiverType, b: resolution.sourceRef) || (try witnessReceiverMode(passing: signature.receiverPassing)).key() != receiverMode.key() { return <Result.Err error=valueAbiFailure(message: "witness receiver signature mismatch") /> }
        val abi = self.valueAbis[abiId - 1U64]
        if !abi.convention.matchesWitness(targetType: resolution.targetRef, traitIndex: resolution.traitIdx, slot: origin.member + 1U64) { return <Result.Err error=valueAbiFailure(message: "witness Ready public endpoint mismatch") /> }
        if parameterCount != member.parameterTypes.count() + 1U64 || member.argumentPassings.count() != member.parameterTypes.count() || signature.parameterTypes.count() != member.parameterTypes.count() || signature.parameterPassings.count() != member.parameterTypes.count() || abi.parameterCount != parameterCount || parameterCount > body.locals.len { return <Result.Err error=valueAbiFailure(message: "witness parameter shape mismatch") /> }
        if abi.parameterStart >= self.valueAbiParameters.count() || plew_pointer_equal(self.valueAbiParameters[abi.parameterStart].type, self.ptrty) == 0I32 { return <Result.Err error=valueAbiFailure(message: "erased receiver lane is not a pointer") /> }
        val receiverLane = self.valueAbiParameters[abi.parameterStart]
        if receiverLane.semanticType != resolution.targetRef || !receiverLane.role.same(role: <LlvmParameterRole.ErasedReceiver />) || receiverLane.mode.key() != receiverMode.key() || receiverLane.passing.key() != 1U64 || receiverLane.physicalIndex != 0U64 { return <Result.Err error=valueAbiFailure(message: "witness Ready erased receiver lane mismatch") /> }
        mut val bindings: Array[LlvmLocalBinding] = []
        mut val types: Array[LLVMTypeRef] = []
        mut val index = 0U64
        while index < body.locals.len {
            val local = c.mid.locals[body.locals.start + index]
            if local.isParameter != (index < parameterCount) { return <Result.Err error=valueAbiFailure(message: "witness has an unmapped parameter local") /> }
            types.append((try self.lowerMidLocalType(c: inout c, body: body, local: index)))
            bindings.append(<LlvmLocalBinding.None />)
            if index < parameterCount {
                val mode = if index == 0U64 { give receiverMode } else {
                    val passing = member.argumentPassings[index - 1U64]
                    give match passing { CallArgumentPassing.Borrow => { give <LlvmParameterMode.Borrow /> } CallArgumentPassing.Move => { give <LlvmParameterMode.Move /> } CallArgumentPassing.Inout => { give <LlvmParameterMode.Inout /> } }
                }
                val aliasesAddress = match mode { LlvmParameterMode.Inout => { give true } _ => { give false } }
                val consumes = match mode { LlvmParameterMode.Move => { give true } _ => { give false } }
                val expected = if index == 0U64 { give receiverType } else { give member.parameterTypes[index - 1U64] }
                if local.isCaptureCell || local.isBorrowed || local.isInout != aliasesAddress || local.ownsAtEntry != consumes || !c.typeRefEq(a: local.typeTerm, b: expected) { return <Result.Err error=valueAbiFailure(message: "witness local parameter correspondence mismatch") /> }
                if index == 0U64 {
                    bindings.set(i: index, value: <LlvmLocalBinding.ErasedReceiver parameterIndex=abi.parameterStart type=types[index] alias=aliasesAddress />)
                } else {
                    val declaredMode = match signature.parameterPassings[index - 1U64] { CallArgumentPassing.Borrow => { give <LlvmParameterMode.Borrow /> } CallArgumentPassing.Move => { give <LlvmParameterMode.Move /> } CallArgumentPassing.Inout => { give <LlvmParameterMode.Inout /> } }
                    if declaredMode.key() != mode.key() || !c.typeRefEq(a: signature.parameterTypes[index - 1U64], b: expected) { return <Result.Err error=valueAbiFailure(message: "witness ordinary signature mismatch") /> }
                    val parameterIndex = abi.parameterStart + index
                    val type = if aliasesAddress { give self.ptrty } else { give types[index] }
                    if parameterIndex >= self.valueAbiParameters.count() || plew_pointer_equal(self.valueAbiParameters[parameterIndex].type, type) == 0I32 { return <Result.Err error=valueAbiFailure(message: "witness ordinary representation mismatch") /> }
                    val lane = self.valueAbiParameters[parameterIndex]
                    if !c.typeRefEq(a: lane.semanticType, b: expected) || lane.mode.key() != mode.key() || !lane.role.same(role: <LlvmParameterRole.Ordinary index=index - 1U64 />) { return <Result.Err error=valueAbiFailure(message: "witness Ready ordinary lane mismatch") /> }
                    bindings.set(i: index, value: <LlvmLocalBinding.Parameter parameterIndex=parameterIndex alias=aliasesAddress />)
                }
            }
            index += 1U64
        }
        return <Result.Ok value=<LlvmEntryLocalBindings bindings=bindings types=types /> />
    }

    inout fn validateWitnessLocalEntry(abiId: U64, plannedAbi: U64, bodyId: U64) -> Result[(), CompileDiagnostic] {
        if abiId == 0U64 || abiId > self.valueAbis.count() || abiId != plannedAbi || self.valueAbis[abiId - 1U64].ownerBody != bodyId { return <Result.Err error=valueAbiFailure(message: "witness local entry descriptor mismatch") /> }
        val valid = match self.valueAbis[abiId - 1U64].convention { LlvmValueConvention.Witness(targetType: _, traitIndex: _, slot: _) => { give true } _ => { give false } }
        if !valid { return <Result.Err error=valueAbiFailure(message: "witness local entry convention mismatch") /> }
        return <Result.Ok value=() />
    }

    inout fn emitExistentialWitnesses(c: inout Comp) -> Result[(), CompileDiagnostic] {
        while self.existentialWitnessesEmitted < self.existentialWitnesses.count() {
            val witness = self.existentialWitnesses[self.existentialWitnessesEmitted]
            val member = c.arena.finalExistentials[witness.resolution].members[witness.member]
            if !self.admitBody(bodyId: member.adapterBodyId) { self.existentialWitnessesEmitted += 1U64 continue }
            val body = c.arena.bodyInstanceAt(index: member.adapterBodyId - 1U64)
            self.curFn = witness.function
            self.curIsMain = false
            self.curRetVoid = member.resultType == 0U64
            self.curRetTy = self.voidty
            if member.resultType != 0U64 { self.curRetTy = (try self.llvmTypeOfRef(c: inout c, ref: member.resultType)) }
            val prepared = (try self.prepareSyntheticMidBody(c: inout c, bodyId: member.adapterBodyId, fnIdx: body.fnIdx, parameterCount: member.parameterTypes.count() + 1U64))
            match prepared {
                MidLlvmPrepared.None => { return <Result.Err error=c.diagnosticAt(offset: c.arena.functionAt(index: body.fnIdx).nameStart, msg: "LLVM backend: existential witness could not be prepared as Mid IR") /> }
                MidLlvmPrepared.Ready(canonical: _, localAdmission: _) => {
                    self.beginFnBody(fv: witness.function)
                    if !(try self.genLlvmPreparedMidBody(c: inout c, prepared: prepared)) {
                        return <Result.Err error=c.diagnosticAt(offset: c.arena.functionAt(index: body.fnIdx).nameStart, msg: "LLVM backend: prepared existential Mid body failed to emit") />
                    }
                }
            }
            self.existentialWitnessesEmitted += 1U64
            tracePhaseProgress(c: inout c, label: "backend:existential-witness", count: self.existentialWitnessesEmitted, stride: 16U64)
        }
        return <Result.Ok value=() />
    }

    // Privatize the existential box. The new box owns a logical copy of the
    // concrete value: nested buffers remain CoW-shared until their own writes.
    inout fn buildAnyCopyThunk(c: inout Comp, sourceRef: U64, sidx: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        val concreteTy: LLVMTypeRef = (try self.llvmTypeOfRef(c: inout c, ref: sourceRef))
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtcopy".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = (try self.declareLegacyValueFunction(name: arrayCPtr(nm), signature: fty, family: <LlvmLegacyConvention.ExistentialCopy />))
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val entryCString = <CString.copied text="entry" />
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, entryCString.ptr)
        LLVMPositionBuilderAtEnd(self.b, entry)
        val srcVal: LLVMValueRef = llvmLoad(self.b, concreteTy, (try self.legacyValueParameter(function: fv, index: 0U64)), anon())
        try self.emitStructRetain(c: inout c, v: srcVal, ref: sourceRef)
        val cell: LLVMValueRef = (try self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32)))
        llvmStore(self.b, srcVal, cell)
        LLVMBuildRet(self.b, cell)
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return <Result.Ok value=fv />
    }

    // Build the drop thunk for concrete struct `sidx` (vtable slot 1): `drop(ptr box)`
    // destroys the boxed concrete value's owned heap (classifier-routed valueArc, which
    // lands on the per-type witnesses). The caller (emitAnyRelease) frees the box itself
    // afterwards. Rebuilt per vtable like the copy thunk (LLVM uniques duplicate names).
    inout fn buildAnyDropThunk(c: inout Comp, sourceRef: U64, sidx: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        val concreteTy: LLVMTypeRef = (try self.llvmTypeOfRef(c: inout c, ref: sourceRef))
        val instRef: U64 = sourceRef
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtdrop".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = (try self.declareLegacyValueFunction(name: arrayCPtr(nm), signature: fty, family: <LlvmLegacyConvention.ExistentialDrop />))
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val savedFn: LLVMValueRef = self.curFn
        val entryCString = <CString.copied text="entry" />
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, entryCString.ptr)
        LLVMPositionBuilderAtEnd(self.b, entry)
        self.curFn = fv
        if (try c.finalNeedsRelease(typeRef: instRef)) {
            val v: LLVMValueRef = llvmLoad(self.b, concreteTy, (try self.legacyValueParameter(function: fv, index: 0U64)), anon())
            try self.valueArc(c: inout c, v: v, typeRef: instRef, retain: false)
        }
        LLVMBuildRetVoid(self.b)
        self.curFn = savedFn
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return <Result.Ok value=fv />
    }

    // Release one owner of an existential's box: decrement its rc, and at 0 destroy
    // the boxed concrete through the vtable's drop thunk (slot 1) then free the box.
    // Null-safe (an unset enum payload slot holds a null box; plew_rawbuf_release returns 0
    // for null, and the destroy branch is additionally gated on non-null) — mirrors
    // emitBoxedFieldRelease's dec-then-cascade shape.
    inout fn emitAnyRelease(c: inout Comp, fat: LLVMValueRef) -> Result[(), CompileDiagnostic] {
        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vt: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val rc: LLVMValueRef = (try self.rawbufRelease(c: inout c, cell: cell))
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val nonNull: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), cell, LLVMConstNull(self.ptrty), anon())
        val doDestroy: LLVMValueRef = LLVMBuildAnd(self.b, isZero, nonNull, anon())
        val freeBBCString = <CString.copied text="anyrel.free" />
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, freeBBCString.ptr)
        val contBBCString = <CString.copied text="anyrel.cont" />
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, contBBCString.ptr)
        LLVMBuildCondBr(self.b, doDestroy, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        mut val gepIdx: Array[LLVMValueRef] = []
        gepIdx.append(LLVMConstInt(self.i64ty, 1U64, 0I32))
        val slotPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.ptrty, vt, arrayCPtr(gepIdx), 1U64, anon())
        val dropFn: LLVMValueRef = llvmLoad(self.b, self.ptrty, slotPtr, anon())
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val dty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        (try self.callLegacyValueFunction(signature: dty, function: dropFn, arguments: av, legacyIndirect: <Optional.Some v=<LlvmLegacyConvention.ExistentialDrop /> />))
        try self.rawbufFree(c: inout c, cell: cell)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
        return <Result.Ok value=() />
    }

    // The CoW write gate for an existential: an `inout` requirement mutates THROUGH
    // the box, so a shared box (rc > 1) is split first — copy-thunk the boxed value
    // into a fresh box, drop this owner's count on the old one, and repoint the
    // receiver PLACE at the fresh fat pointer. Sharers keep the old value; the
    // mutation lands on this owner's private box. Mirrors plew_arr_cow / the boxed
    // field's fresh-cell repoint. Returns the (possibly privatized) fat value.
    inout fn privatizeAnyBox(c: inout Comp, fat: LLVMValueRef, place: LLVMValueRef) -> Result[LLVMValueRef, CompileDiagnostic] {
        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        // rc lives in the rawbuf header at data[-1] (see plew_rawbuf_alloc).
        mut val rcIdx: Array[LLVMValueRef] = []
        rcIdx.append(LLVMConstInt(self.i64ty, 18446744073709551615U64, 0I32))
        val rcPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.i64ty, cell, arrayCPtr(rcIdx), 1U64, anon())
        val rc: LLVMValueRef = llvmLoad(self.b, self.i64ty, rcPtr, anon())
        val isShared: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntSgt(), rc, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
        val splitBBCString = <CString.copied text="anycow.split" />
        val splitBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, splitBBCString.ptr)
        val contBBCString = <CString.copied text="anycow.cont" />
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, contBBCString.ptr)
        LLVMBuildCondBr(self.b, isShared, splitBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, splitBB)
        val fresh: LLVMValueRef = (try self.copyAnyValue(c: inout c, fat: fat))
        val ignore: LLVMValueRef = (try self.rawbufRelease(c: inout c, cell: cell))
        llvmStore(self.b, fresh, place)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
        // reload from the place: the fresh fat on the split path, the original otherwise.
        return <Result.Ok value=llvmLoad(self.b, self.anyTy, place, anon()) />
    }

    // Value-semantics copy of an `any P` fat-pointer value: invoke its vtable's copy
    // thunk (slot 0) to duplicate the boxed concrete, returning a fresh `{ newdata,
    // vtable }`. Used by privatizeAnyBox (the CoW split) — plain place->owner copies
    // CoW-share the box instead (copyAnyIfPlace).
    inout fn copyAnyValue(c: inout Comp, fat: LLVMValueRef) -> Result[LLVMValueRef, CompileDiagnostic] {
        val dataPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vtPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val copyFn: LLVMValueRef = llvmLoad(self.b, self.ptrty, vtPtr, anon())
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(dataPtr)
        val newData: LLVMValueRef = (try self.callLegacyValueFunction(signature: fty, function: copyFn, arguments: av, legacyIndirect: <Optional.Some v=<LlvmLegacyConvention.ExistentialCopy /> />))
        mut val agg: LLVMValueRef = LLVMGetUndef(self.anyTy)
        agg = LLVMBuildInsertValue(self.b, agg, newData, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, vtPtr, 1U64, anon())
        return <Result.Ok value=agg />
    }
}

pub impl LlvmCtx {

    // Build (or fetch cached) the vtable global for (concrete struct `sidx`, trait
    // `traitIdx`): an array of ptr slots — slot 0 = copy thunk (value semantics /
    // privatization), slot 1 = drop thunk (box destruction at rc 0), slots 2.. = a
    // thunk per requirement in declaration order. Returns the global pointer.
    inout fn ensureAnyVtable(c: inout Comp, sourceRef: U64, sidx: U64, anyRef: U64, traitIdx: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        val resolutionIndex: U64 = c.finalExistentialIndex(sourceRef: sourceRef, targetRef: anyRef)
        if resolutionIndex >= c.arena.finalExistentials.count() {
            if c.traceCodegen {
                eprint(text: "[trace-codegen] missing existential source=")
                c.traceMonoTypeHead(ref: sourceRef)
                eprint(text: " target=")
                c.traceMonoTypeHead(ref: anyRef)
                eprint(text: "\n")
                mut val diagnosticIndex: U64 = 0U64
                while diagnosticIndex < c.arena.finalExistentials.count() {
                    eprint(text: "[trace-codegen] recorded existential source=")
                    c.traceMonoTypeHead(ref: c.arena.finalExistentials[diagnosticIndex].sourceRef)
                    eprint(text: " target=")
                    c.traceMonoTypeHead(ref: c.arena.finalExistentials[diagnosticIndex].targetRef)
                    eprint(text: "\n")
                    diagnosticIndex += 1U64
                }
            }
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: existential conversion was not finalized") />
        }
        mut val ci: U64 = 0U64
        while ci < self.anyVtResolution.count() {
            if self.anyVtResolution[ci] == resolutionIndex + 1U64 { return <Result.Ok value=self.anyVtVal[ci] /> }
            ci += 1U64
        }
        val t: TraitDef = c.decls.traitAt(index: traitIdx)
        // pre-create the global (with its final array type) and CACHE it before building
        // thunks, so a `-> Self` re-erasure thunk that re-boxes into this same existential
        // resolves to this vtable instead of recursing into ensureAnyVtable forever.
        val slotCount: U64 = 2U64 + t.reqs.count()
        val arrTy: LLVMTypeRef = LLVMArrayType2(self.ptrty, slotCount)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "plew.metadata.vtable.".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: traitIdx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: resolutionIndex)
        nm.append(0)
        val g: LLVMValueRef = LLVMAddGlobal(self.mod, arrTy, arrayCPtr(nm))
        LLVMSetGlobalConstant(g, 1I32)
        if !self.wholeProgram() {
            // The session's finalized existential descriptor owns this table.
            // Independently requested bodies refer to one immutable definition.
            val identity = [LLVMValueAsMetadata(LLVMConstInt(self.i64ty, resolutionIndex + 1U64, 0I32))]
            val kind = <CString.copied text="plew.shared" />
            LLVMGlobalSetMetadata(g, LLVMGetMDKindIDInContext(self.ctx, kind.ptr, 11U32), LLVMMDNodeInContext2(self.ctx, arrayCPtr(identity), 1U64))
        }
        self.anyVtResolution.append(resolutionIndex + 1U64)
        self.anyVtVal.append(g)
        mut val slots: Array[LLVMValueRef] = []
        slots.append((try self.buildAnyCopyThunk(c: inout c, sourceRef: sourceRef, sidx: sidx)))
        slots.append((try self.buildAnyDropThunk(c: inout c, sourceRef: sourceRef, sidx: sidx)))
        mut val ri: U64 = 0
        while ri < t.reqs.count() {
            slots.append((try self.buildAnyThunk(c: inout c, resolutionIndex: resolutionIndex, sidx: sidx, idx: ri)))
            ri += 1
        }
        LLVMSetInitializer(g, LLVMConstArray2(self.ptrty, arrayCPtr(slots), slots.count()))
        return <Result.Ok value=g />
    }
}

pub impl LlvmCtx {

    // Box concrete value `v` of struct `sidx` into a fresh ARC cell and wrap it with the
    // (sidx, traitIdx) vtable, producing an `any P` fat-pointer value.
    inout fn boxIntoAny(c: inout Comp, sourceRef: U64, v: LLVMValueRef, sidx: U64, anyRef: U64, traitIdx: U64) -> Result[LLVMValueRef, CompileDiagnostic] {
        val concreteTy: LLVMTypeRef = (try self.llvmTypeOfRef(c: inout c, ref: sourceRef))
        val cell: LLVMValueRef = (try self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32)))
        llvmStore(self.b, v, cell)
        val vt: LLVMValueRef = (try self.ensureAnyVtable(c: inout c, sourceRef: sourceRef, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx))
        mut val agg: LLVMValueRef = LLVMGetUndef(self.anyTy)
        agg = LLVMBuildInsertValue(self.b, agg, cell, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, vt, 1U64, anon())
        return <Result.Ok value=agg />
    }

    // Emit a finalized body identity with explicit type/ownership contracts.
    // Ordinary and generic bodies share this path without an ambient environment.
    inout fn genLlvmFuncBody(c: inout Comp, bodyId: U64, fv: LLVMValueRef) -> Result[(), CompileDiagnostic] {
        if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() {
            return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: function emission requires a finalized body") />
        }
        val fi = c.arena.bodyInstanceAt(index: bodyId - 1U64).fnIdx
        val f: Func = c.arena.functionAt(index: fi)
        if c.traceCodegen {
            eprint(text: "[trace-codegen] function body-entry name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " fn=")
            self.traceCodegenU64(n: fi)
            eprint(text: "\n")
        }
        self.curFn = fv
        self.curIsMain = false
        self.curRetVoid = (try self.bodyResultType(c: inout c, bodyId: bodyId)) == 0U64
        self.curRetTy = (try self.bodyReturnLlvmTy(c: inout c, bodyId: bodyId))
        if c.traceCodegen {
            eprint(text: "[trace-codegen] function body-metadata-ready name=")
            self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
            eprint(text: " fn=")
            self.traceCodegenU64(n: fi)
            eprint(text: "\n")
        }
        // Coverage identifies the frontend's concrete body instance before any
        // Mid stage runs.  The stages below must not substitute a source-level
        // function identity or spelling when a frozen instance is unavailable.

        val signature = c.arena.bodySignature(bodyId: bodyId)
        mut val abiParameterCount = signature.parameterTypes.count()
        match signature.receiverPassing {
            CallReceiverPassing.None => {}
            _ => { abiParameterCount += 1U64 }
        }
        val preparedMid = (try self.prepareCanonicalForLlvm(c: inout c, bodyId: bodyId, fnIdx: fi, parameterCount: abiParameterCount))
        val midReady = match preparedMid {
            MidLlvmPrepared.Ready(canonical: _, localAdmission: _) => { give true }
            _ => { give false }
        }
        if !midReady {
            return <Result.Err error=c.diagnosticAt(offset: f.nameStart, msg: "internal error: function requires verified Mid lowering") />
        }
        self.beginFnBody(fv: fv)
        if midReady {
            // Preflight completed before `beginFnBody`; a failure is an
            // invariant violation, never permission to reopen the AST after
            // partially emitting this function.
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid function emit-start name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            if !((try self.genLlvmPreparedMidBody(c: inout c, prepared: preparedMid))) {
                return <Result.Err error=c.diagnosticAt(offset: 0U64, msg: "internal error: preflighted Mid function failed LLVM lowering") />
            }
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid function emit-done name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid function return name=")
                self.traceCodegenName(c: inout c, start: f.nameStart, len: f.nameLen)
                eprint(text: " fn=")
                self.traceCodegenU64(n: fi)
                eprint(text: "\n")
            }
            return <Result.Ok value=() />
        }
        return <Result.Ok value=() />
    }
}
