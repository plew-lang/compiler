// Part of the LLVM backend (root: _.pw): existential `any P` vtable, witness, boxing, and dynamic dispatch.

// ---- existential `any P` (spec/08): vtable, boxing, dynamic dispatch ----
//
// An `any P` value is the fat pointer st.anyTy = { ptr data, ptr vtable }. `data`
// points at an ARC box (rawbuf cell, rc-managed) holding the erased concrete value;
// `vtable` at a static per-(concrete-struct, trait) global of function pointers:
// slot 0 = the copy thunk (value semantics / box privatization), slot 1 = the drop
// thunk (destroys the boxed concrete's owned heap at rc 0 — emitAnyRelease), slots
// 2.. = a thunk per trait requirement in declaration order. Each requirement thunk
// has the ERASED signature `(ptr self_data, <req params>) -> <req ret>` and forwards
// to the concrete witness pf<wfi> after loading the boxed self.
//
// Ownership (AnyBox class): copying an `any` place CoW-SHARES the box (rc++); the
// sole write point — an `inout` requirement dispatch — privatizes a shared box first
// (privatizeAnyBox), mirroring the CoW discipline of arrays/boxed fields.

// Do two parameter lists have identical labels positionally (a conformance witness
// reproduces the requirement's labels)?

pub impl LlvmCtx {

    // Build the thunk for requirement `idx` (`req`) on concrete struct `sidx`. Returns
    // its function pointer, or a null ptr when the requirement can't be dispatched
    // through `any` in this increment (assoc, inout/move self, or Self outside the
    // receiver). Saves/restores the builder position around the thunk body.
    inout fn buildAnyThunk(c: inout Comp, sidx: U64, anyRef: U64, traitIdx: U64, req: Func, idx: U64) -> LLVMValueRef {
        // a trait requirement Func carries no `self` param (hasRecv=false; self is
        // implicit) — a method requirement is `!isAssoc`. An assoc-fn requirement has no
        // receiver to carry the witness, so it is not dispatchable through `any`.
        if req.isAssoc {
            return LLVMConstNull(self.ptrty)
        }
        if reqUsesSelfInInput(c: inout c, req: req) {
            return LLVMConstNull(self.ptrty)
        }
        // `Self` in the result that we cannot covariantly erase (nested in a container we
        // don't yet repack) makes the member non-callable through `any P` — the slot stays
        // null so a call site loudly rejects rather than leaking an un-erased concrete.
        if !(reqRetSelfErasable(c: inout c, req: req)) {
            return LLVMConstNull(self.ptrty)
        }
        // a `-> Self` requirement re-boxes its single concrete result; a covariant CONTAINER
        // of `Self` (`-> Optional[Self]`, `-> Array[Self]`) is repacked (eraseCovariantToAny).
        val retsSelf: Bool = reqReturnsSelf(c: inout c, req: req)
        val retContainerSelf: Bool = req.hasRet && req.retTy != 0U64 && !(retsSelf) && typeRefMentionsSelf(c: inout c, ref: req.retTy)
        val wfi: U64 = findWitnessFor(c: inout c, sidx: sidx, req: req)
        if wfi >= c.arena.funcs.count() {
            return LLVMConstNull(self.ptrty)
        }
        val sd: StructDef = c.arena.structs[sidx]
        val regSlot: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
        if regSlot >= self.genStructRefs.count() {
            return LLVMConstNull(self.ptrty)
        }
        // the witness is a method on the concrete struct — its receiver's 0-type-arg `gm`
        // instance (B3-2; an extension's lexical view is layered via its extId).
        val wInstRef: U64 = self.genStructRefs[regSlot]
        val wslot: U64 = self.ensureGenMethodDeclared(c: inout c, mfi: wfi, instRef: wInstRef, ownArgs: [])
        if wslot >= self.genMethK.count() {
            return LLVMConstNull(self.ptrty)
        }
        val concreteTy: LLVMTypeRef = self.genStructTys[regSlot]
        // the erased thunk signature uses the requirement's types with the trait's type
        // parameters / associated types substituted by the existential's bindings
        // (`Rhs`/`Output`/`Item` -> the bound concrete), set as the active env so
        // paramLlvmTy / llvmFnRetTy ground them.
        mut val envParams: Array[Bind] = []
        mut val envArgs: Array[U64] = []
        val haveEnv: Bool = anyBindingEnv(c: inout c, anyRef: anyRef, traitIdx: traitIdx, outParams: inout envParams, outArgs: inout envArgs)
        val savedEP: Array[Bind] = c.cur.typeParams
        val savedEA: Array[U64] = c.cur.typeArgs
        if haveEnv {
            c.cur.typeParams = envParams
            c.cur.typeArgs = envArgs
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        mut val pi: U64 = 0
        while pi < req.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: req.params[pi]))
            pi += 1
        }
        mut val rty: LLVMTypeRef = self.llvmFnRetTy(c: inout c, f: req)
        // a covariant-`Self` container return: ground the requirement's result under `Self` =
        // the existential (dst, the thunk's return type) and under `Self` = the concrete
        // (src, the witness's result type) — the two ends of the repack. Grounded here while
        // the trait-binding env is still active so `Rhs`/`Item` in the result resolve too.
        mut val dstRetRef: U64 = 0
        mut val srcRetRef: U64 = 0
        if retContainerSelf {
            val savedSelf: U64 = c.cur.selfRef
            c.cur.selfRef = anyRef
            dstRetRef = c.groundTypeRef(ref: req.retTy)
            c.cur.selfRef = wInstRef
            srcRetRef = c.groundTypeRef(ref: req.retTy)
            c.cur.selfRef = savedSelf
        }
        if haveEnv {
            c.cur.typeParams = savedEP
            c.cur.typeArgs = savedEA
        }
        // a `-> Self` thunk returns the existential fat pointer (the re-erased result); a
        // covariant container returns the erased container type (`Optional[any P]`, …).
        if retsSelf {
            rty = self.anyTy
        }
        if retContainerSelf {
            rty = self.llvmTypeOfRef(c: inout c, ref: dstRetRef)
        }
        val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count(), 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvt".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: idx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: anyBindKey(c: inout c, args: envArgs))
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        // a covariant-container return repack (eraseCovariantToAny) appends basic blocks to
        // `self.curFn`; retarget it to the thunk so those blocks land here, not in the
        // function that triggered demand-registration of this thunk.
        val savedFn: LLVMValueRef = self.curFn
        self.curFn = fv
        // split entry -> body0 (as in beginFnBody) so `entryAlloca` — used by the covariant
        // repack for its scratch slots — has a terminated entry block to insert before.
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        val body0: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "body0"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        LLVMBuildBr(self.b, body0)
        LLVMPositionBuilderAtEnd(self.b, body0)
        // self: an `inout fn` witness takes self by pointer (mutates the boxed value in
        // place — the box is shared via the fat pointer's data field, so the mutation
        // persists); a by-value self is loaded from the box.
        mut val selfArg: LLVMValueRef = LLVMGetParam(fv, 0U64)
        if !(req.selfInout) {
            selfArg = LLVMBuildLoad2(self.b, concreteTy, LLVMGetParam(fv, 0U64), anon())
        }
        mut val av: Array[LLVMValueRef] = []
        av.append(selfArg)
        mut val ai: U64 = 0
        while ai < req.params.count() {
            av.append(LLVMGetParam(fv, ai + 1U64))
            ai += 1
        }
        val r: LLVMValueRef = LLVMBuildCall2(self.b, self.genMethTy[wslot], self.genMethVal[wslot], arrayCPtr(av), av.count(), anon())
        if req.hasRet {
            if retsSelf {
                // re-erase: box the witness's concrete result (the same concrete type as
                // the boxed self) back into `any P` with this existential's vtable.
                LLVMBuildRet(self.b, self.boxIntoAny(c: inout c, v: r, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx))
            } else {
                if retContainerSelf {
                    // repack the concrete container into the erased one (each `Self` boxed),
                    // then release the witness's owned result: eraseCovariantToAny retained the
                    // payload into the fresh boxes, so this drop balances it (the erased value
                    // now solely owns the heap — value semantics).
                    val erased: LLVMValueRef = self.eraseCovariantToAny(c: inout c, v: r, srcRef: srcRetRef, dstRef: dstRetRef)
                    self.valueArc(c: inout c, v: r, typeRef: srcRetRef, retain: false)
                    LLVMBuildRet(self.b, erased)
                } else {
                    LLVMBuildRet(self.b, r)
                }
            }
        } else {
            LLVMBuildRetVoid(self.b)
        }
        self.curFn = savedFn
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Build the copy thunk for concrete struct `sidx` (vtable slot 0): `copy(ptr src)
    // -> ptr` allocates a fresh box, deep-copies the boxed concrete value into it (value
    // semantics — array/String fields are copied so the two existentials are
    // independent), and returns the new box pointer. Used to give `any P` value
    // semantics on copy (a `mut val b = a` must not alias a's boxed value).
    inout fn buildAnyCopyThunk(c: inout Comp, sidx: U64) -> LLVMValueRef {
        val sd: StructDef = c.arena.structs[sidx]
        val regSlot: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
        if regSlot >= self.genStructRefs.count() {
            return LLVMConstNull(self.ptrty)
        }
        val concreteTy: LLVMTypeRef = self.genStructTys[regSlot]
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtcopy".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        val srcVal: LLVMValueRef = LLVMBuildLoad2(self.b, concreteTy, LLVMGetParam(fv, 0U64), anon())
        val copied: LLVMValueRef = self.deepCopyStructValue(c: inout c, v: srcVal, sidx: sidx)
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        LLVMBuildStore(self.b, copied, cell)
        LLVMBuildRet(self.b, cell)
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Build the drop thunk for concrete struct `sidx` (vtable slot 1): `drop(ptr box)`
    // destroys the boxed concrete value's owned heap (classifier-routed valueArc, which
    // lands on the per-type witnesses). The caller (emitAnyRelease) frees the box itself
    // afterwards. Rebuilt per vtable like the copy thunk (LLVM uniques duplicate names).
    inout fn buildAnyDropThunk(c: inout Comp, sidx: U64) -> LLVMValueRef {
        val sd: StructDef = c.arena.structs[sidx]
        val regSlot: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
        if regSlot >= self.genStructRefs.count() {
            return LLVMConstNull(self.ptrty)
        }
        val concreteTy: LLVMTypeRef = self.genStructTys[regSlot]
        val instRef: U64 = self.genStructRefs[regSlot]
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtdrop".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        nm.append(0)
        val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
        val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(self.b)
        val savedFn: LLVMValueRef = self.curFn
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(self.b, entry)
        self.curFn = fv
        if c.arcNeedsRelease(ref: instRef) {
            val v: LLVMValueRef = LLVMBuildLoad2(self.b, concreteTy, LLVMGetParam(fv, 0U64), anon())
            self.valueArc(c: inout c, v: v, typeRef: instRef, retain: false)
        }
        LLVMBuildRetVoid(self.b)
        self.curFn = savedFn
        LLVMPositionBuilderAtEnd(self.b, savedBB)
        return fv
    }

    // Release one owner of an existential's box: decrement its rc, and at 0 destroy
    // the boxed concrete through the vtable's drop thunk (slot 1) then free the box.
    // Null-safe (an unset enum payload slot holds a null box; plew_rawbuf_release returns 0
    // for null, and the destroy branch is additionally gated on non-null) — mirrors
    // emitBoxedFieldRelease's dec-then-cascade shape.
    inout fn emitAnyRelease(c: inout Comp, fat: LLVMValueRef) {
        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vt: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val rc: LLVMValueRef = self.rawbufRelease(c: inout c, cell: cell)
        val isZero: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntEq(), rc, LLVMConstInt(self.i64ty, 0U64, 0I32), anon())
        val nonNull: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntNe(), cell, LLVMConstNull(self.ptrty), anon())
        val doDestroy: LLVMValueRef = LLVMBuildAnd(self.b, isZero, nonNull, anon())
        val freeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anyrel.free"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anyrel.cont"))
        LLVMBuildCondBr(self.b, doDestroy, freeBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, freeBB)
        mut val gepIdx: Array[LLVMValueRef] = []
        gepIdx.append(LLVMConstInt(self.i64ty, 1U64, 0I32))
        val slotPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.ptrty, vt, arrayCPtr(gepIdx), 1U64, anon())
        val dropFn: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, slotPtr, anon())
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val dty: LLVMTypeRef = LLVMFunctionType(self.voidty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(cell)
        LLVMBuildCall2(self.b, dty, dropFn, arrayCPtr(av), 1U64, anon())
        self.rawbufFree(c: inout c, cell: cell)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
    }

    // The CoW write gate for an existential: an `inout` requirement mutates THROUGH
    // the box, so a shared box (rc > 1) is split first — copy-thunk the boxed value
    // into a fresh box, drop this owner's count on the old one, and repoint the
    // receiver PLACE at the fresh fat pointer. Sharers keep the old value; the
    // mutation lands on this owner's private box. Mirrors plew_arr_cow / the boxed
    // field's fresh-cell repoint. Returns the (possibly privatized) fat value.
    inout fn privatizeAnyBox(c: inout Comp, fat: LLVMValueRef, place: LLVMValueRef) -> LLVMValueRef {
        val cell: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        // rc lives in the rawbuf header at data[-1] (see plew_rawbuf_alloc).
        mut val rcIdx: Array[LLVMValueRef] = []
        rcIdx.append(LLVMConstInt(self.i64ty, 18446744073709551615U64, 0I32))
        val rcPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.i64ty, cell, arrayCPtr(rcIdx), 1U64, anon())
        val rc: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, rcPtr, anon())
        val isShared: LLVMValueRef = LLVMBuildICmp(self.b, llvmIntSgt(), rc, LLVMConstInt(self.i64ty, 1U64, 0I32), anon())
        val splitBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anycow.split"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "anycow.cont"))
        LLVMBuildCondBr(self.b, isShared, splitBB, contBB)
        LLVMPositionBuilderAtEnd(self.b, splitBB)
        val fresh: LLVMValueRef = self.copyAnyValue(c: inout c, fat: fat)
        val ignore: LLVMValueRef = self.rawbufRelease(c: inout c, cell: cell)
        LLVMBuildStore(self.b, fresh, place)
        LLVMBuildBr(self.b, contBB)
        LLVMPositionBuilderAtEnd(self.b, contBB)
        // reload from the place: the fresh fat on the split path, the original otherwise.
        return LLVMBuildLoad2(self.b, self.anyTy, place, anon())
    }

    // Value-semantics copy of an `any P` fat-pointer value: invoke its vtable's copy
    // thunk (slot 0) to duplicate the boxed concrete, returning a fresh `{ newdata,
    // vtable }`. Used by privatizeAnyBox (the CoW split) — plain place->owner copies
    // CoW-share the box instead (copyAnyIfPlace).
    inout fn copyAnyValue(c: inout Comp, fat: LLVMValueRef) -> LLVMValueRef {
        val dataPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vtPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        val copyFn: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, vtPtr, anon())
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        val fty: LLVMTypeRef = LLVMFunctionType(self.ptrty, arrayCPtr(ptys), 1U64, 0I32)
        mut val av: Array[LLVMValueRef] = []
        av.append(dataPtr)
        val newData: LLVMValueRef = LLVMBuildCall2(self.b, fty, copyFn, arrayCPtr(av), 1U64, anon())
        mut val agg: LLVMValueRef = LLVMGetUndef(self.anyTy)
        agg = LLVMBuildInsertValue(self.b, agg, newData, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, vtPtr, 1U64, anon())
        return agg
    }
}

pub impl LlvmCtx {

    // If `valueExpr` is an existing `any P` place being copied into a new owner,
    // CoW-SHARE its box (rc++) — the write point (an `inout` requirement dispatch)
    // privatizes a shared box, so a sharer never observes mutation. Balanced by
    // emitAnyRelease at the owner's drop. A fresh (non-place) `any` already owns
    // its box and passes through. Mirrors the String/Ref/array classes (1-3a).
    inout fn copyAnyIfPlace(c: inout Comp, rv: LLVMValueRef, valueExpr: U64) -> LLVMValueRef {
        if refIsAny(c: inout c, ref: self.exprTypeRef(c: inout c, id: valueExpr)) {
            if exprAliasesPlace(c: inout c, id: valueExpr) {
                self.rawbufRetain(c: inout c, cell: LLVMBuildExtractValue(self.b, rv, 0U64, anon()))
            }
        }
        return rv
    }

    // Build (or fetch cached) the vtable global for (concrete struct `sidx`, trait
    // `traitIdx`): an array of ptr slots — slot 0 = copy thunk (value semantics /
    // privatization), slot 1 = drop thunk (box destruction at rc 0), slots 2.. = a
    // thunk per requirement in declaration order. Returns the global pointer.
    inout fn ensureAnyVtable(c: inout Comp, sidx: U64, anyRef: U64, traitIdx: U64) -> LLVMValueRef {
        // distinct existential bindings (`any Add[I32,…]` vs `any Add[I64,…]`) need
        // distinct vtables; the key folds the bound concretes (0 for the no-binding case).
        mut val envP: Array[Bind] = []
        mut val envA: Array[U64] = []
        anyBindingEnv(c: inout c, anyRef: anyRef, traitIdx: traitIdx, outParams: inout envP, outArgs: inout envA)
        val bindKey: U64 = anyBindKey(c: inout c, args: envA)
        mut val ci: U64 = 0
        while ci < self.anyVtType.count() {
            if self.anyVtType[ci] == sidx && self.anyVtTrait[ci] == traitIdx && self.anyVtBindKey[ci] == bindKey {
                return self.anyVtVal[ci]
            }
            ci += 1
        }
        val t: TraitDef = c.decls.traits[traitIdx]
        // pre-create the global (with its final array type) and CACHE it before building
        // thunks, so a `-> Self` re-erasure thunk that re-boxes into this same existential
        // resolves to this vtable instead of recursing into ensureAnyVtable forever.
        val slotCount: U64 = 2U64 + t.reqs.count()
        val arrTy: LLVMTypeRef = LLVMArrayType2(self.ptrty, slotCount)
        mut val nm: Array[U8] = []
        appendBytes(into: inout nm, from: "pfvtbl".bytes())
        appendU64Dec(into: inout nm, n: sidx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: traitIdx)
        appendBytes(into: inout nm, from: "_".bytes())
        appendU64Dec(into: inout nm, n: bindKey)
        nm.append(0)
        val g: LLVMValueRef = LLVMAddGlobal(self.mod, arrTy, arrayCPtr(nm))
        LLVMSetGlobalConstant(g, 1I32)
        self.anyVtType.append(sidx)
        self.anyVtTrait.append(traitIdx)
        self.anyVtBindKey.append(bindKey)
        self.anyVtVal.append(g)
        mut val slots: Array[LLVMValueRef] = []
        slots.append(self.buildAnyCopyThunk(c: inout c, sidx: sidx))
        slots.append(self.buildAnyDropThunk(c: inout c, sidx: sidx))
        mut val ri: U64 = 0
        while ri < t.reqs.count() {
            slots.append(self.buildAnyThunk(c: inout c, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx, req: t.reqs[ri], idx: ri))
            ri += 1
        }
        LLVMSetInitializer(g, LLVMConstArray2(self.ptrty, arrayCPtr(slots), slots.count()))
        return g
    }
}

pub impl LlvmCtx {

    // Box concrete value `v` of struct `sidx` into a fresh ARC cell and wrap it with the
    // (sidx, traitIdx) vtable, producing an `any P` fat-pointer value.
    inout fn boxIntoAny(c: inout Comp, v: LLVMValueRef, sidx: U64, anyRef: U64, traitIdx: U64) -> LLVMValueRef {
        val sd: StructDef = c.arena.structs[sidx]
        val regSlot: U64 = self.structRegSlot(c: inout c, start: sd.nameStart, len: sd.nameLen)
        val concreteTy: LLVMTypeRef = self.genStructTys[regSlot]
        val cell: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(self.i64ty, 1U64, 0I32))
        LLVMBuildStore(self.b, v, cell)
        val vt: LLVMValueRef = self.ensureAnyVtable(c: inout c, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx)
        mut val agg: LLVMValueRef = LLVMGetUndef(self.anyTy)
        agg = LLVMBuildInsertValue(self.b, agg, cell, 0U64, anon())
        agg = LLVMBuildInsertValue(self.b, agg, vt, 1U64, anon())
        return agg
    }

    // If target TypeRef `targetRef` is an existential `any P` and `valueExpr` is a
    // concrete struct conforming to P, emit `valueExpr`, box it, and return the `any P`
    // fat pointer. Returns a null sentinel (LLVMConstNull check via outBoxed) when no
    // coercion applies. `outBoxed` is set true iff a coercion happened.
    inout fn coerceToAnyIfNeeded(c: inout Comp, targetRef: U64, valueExpr: U64, outBoxed: inout Bool) -> LLVMValueRef {
        outBoxed = false
        if !(refIsAny(c: inout c, ref: targetRef)) {
            // a container whose element widens concrete->`any P` (`Array[S] -> Array[any P]`):
            // the type checker accepts the covariant conversion, but the layouts differ, so
            // codegen must repack each element (spec/08, SE-0309) rather than share the buffer.
            val cSrcRef: U64 = self.exprTypeRef(c: inout c, id: valueExpr)
            if self.refCovariantAnyErasure(c: inout c, dstRef: targetRef, srcRef: cSrcRef) {
                val cv: LLVMValueRef = self.genLlvmExpr(c: inout c, id: valueExpr)
                outBoxed = true
                return self.eraseCovariantToAny(c: inout c, v: cv, srcRef: cSrcRef, dstRef: targetRef)
            }
            return LLVMConstNull(self.ptrty)
        }
        // already an `any` value (e.g. passing an `any P` local to an `any P` param):
        // no re-boxing.
        val srcRef: U64 = self.exprTypeRef(c: inout c, id: valueExpr)
        if refIsAny(c: inout c, ref: srcRef) {
            return LLVMConstNull(self.ptrty)
        }
        val sidx: U64 = self.exprStructIdx(c: inout c, id: valueExpr)
        if sidx >= c.arena.structs.count() {
            return LLVMConstNull(self.ptrty)
        }
        val tr: TypeRef = c.arena.types[targetRef]
        val traitIdx: U64 = c.findTraitIdxByName(start: tr.nameStart, len: tr.nameLen)
        if traitIdx >= c.decls.traits.count() {
            return LLVMConstNull(self.ptrty)
        }
        // value semantics: boxing a concrete PLACE (`val a: any P = h`) deep-copies its
        // array/struct fields into the box, matching a plain struct copy — so a later
        // mutation of the source leaves the existential's boxed value unchanged.
        val v: LLVMValueRef = self.copyValueIfPlace(c: inout c, rv: self.genLlvmExpr(c: inout c, id: valueExpr), valueExpr: valueExpr)
        outBoxed = true
        return self.boxIntoAny(c: inout c, v: v, sidx: sidx, anyRef: targetRef, traitIdx: traitIdx)
    }

    // Whether a value of `srcRef` flowing into `dstRef` needs COVARIANT container erasure —
    // the two types share a container head but a `Self`/element position widens from a
    // concrete type to `any P` (spec/08, SE-0309). `Array[S] -> Array[any P]` is the leading
    // case: the physical layouts differ (an 8-byte concrete element vs a 16-byte existential
    // fat pointer), so the conversion is a genuine per-element repack, not an identity cast.
    // (A TOP-LEVEL concrete->any is NOT reported here — coerceToAnyIfNeeded's own branch
    // boxes that; this covers only the nested case the type checker accepts but codegen must
    // repack.)
    inout fn refCovariantAnyErasure(c: inout Comp, dstRef: U64, srcRef: U64) -> Bool {
        if dstRef == 0U64 || srcRef == 0U64 {
            return false
        }
        if dstRef >= c.arena.types.count() || srcRef >= c.arena.types.count() {
            return false
        }
        val td: TypeRef = c.arena.types[dstRef]
        val ts: TypeRef = c.arena.types[srcRef]
        // the two must share a container head and arg count (`Array[·]`, `Optional[·]`, any
        // generic enum) — the head we can physically repack.
        if td.nameId != ts.nameId {
            return false
        }
        if td.args.count() == 0U64 || td.args.count() != ts.args.count() {
            return false
        }
        // only heads eraseCovariantToAny can rebuild: the opaque `Array` buffer, or a generic
        // enum (Optional/Result/user enums). A `Dictionary` / record / other head is NOT
        // repacked here, so it is left for the type checker to reject (no silent identity).
        val isArr: Bool = rangeEquals(bytes: c.arena.bytes, start: td.nameStart, len: td.nameLen, kw: "Array")
        val isEnum: Bool = c.genericEnumIndex(nameStart: td.nameStart, nameLen: td.nameLen) < c.arena.enums.count()
        if !(isArr) && !(isEnum) {
            return false
        }
        // at least one arg position widens concrete->`any` (erasable); every other arg must be
        // identical (a differing, non-erasable arg is a genuine mismatch, not a covariance).
        mut val anyErase: Bool = false
        mut val i: U64 = 0
        while i < td.args.count() {
            if self.refElemErasable(c: inout c, dstElem: td.args[i], srcElem: ts.args[i]) {
                anyErase = true
            } else {
                if !(c.typeRefEq(a: td.args[i], b: ts.args[i])) {
                    return false
                }
            }
            i += 1
        }
        return anyErase
    }

    // Whether element position `srcElem` erases to `dstElem` — a concrete->any widening, or a
    // deeper covariant container erasure.
    inout fn refElemErasable(c: inout Comp, dstElem: U64, srcElem: U64) -> Bool {
        if refIsAny(c: inout c, ref: dstElem) {
            if refIsAny(c: inout c, ref: srcElem) {
                return false
            }
            val td: TypeRef = c.arena.types[dstElem]
            val ts: TypeRef = c.arena.types[srcElem]
            val sidx: U64 = c.structIndexByName(start: ts.nameStart, len: ts.nameLen)
            if sidx >= c.arena.structs.count() {
                return false
            }
            return c.findTraitIdxByName(start: td.nameStart, len: td.nameLen) < c.decls.traits.count()
        }
        return self.refCovariantAnyErasure(c: inout c, dstRef: dstElem, srcRef: srcElem)
    }

    // Covariantly erase value `v` of `srcRef` to `dstRef`, boxing every concrete `Self`/element
    // position into the existential (spec/08, SE-0309). Recurses through covariant containers;
    // a bare concrete->any at the leaf boxes into the fat pointer.
    //
    // OWNERSHIP CONTRACT: `v` is BORROWED — its refcount is left unchanged. The returned value
    // is a FRESH, fully-owned repack (its own boxes/buffers). The caller keeps ownership of `v`
    // and, if `v` was an owned temp, must release it separately (buildAnyThunk does; the
    // value-conversion place path leaves the source place alive). Retains happen only at the
    // positions that actually take ownership of heap — the leaf box (below) and an enum's
    // verbatim-copied (non-erasable) fields — never as a blanket pre-retain, so a NESTED
    // container (`Optional[Array[Self]]`) does not double-count and leak its inner buffer.
    inout fn eraseCovariantToAny(c: inout Comp, v: LLVMValueRef, srcRef: U64, dstRef: U64) -> LLVMValueRef {
        val td: TypeRef = c.arena.types[dstRef]
        // leaf: a concrete struct value widening into `any P`. The box co-owns the concrete's
        // heap, so retain it (borrow contract: `v` stays alive for the caller); boxIntoAny then
        // adopts that +1 into the fresh cell.
        if td.isAny {
            val ts: TypeRef = c.arena.types[srcRef]
            val sidx: U64 = c.structIndexByName(start: ts.nameStart, len: ts.nameLen)
            val traitIdx: U64 = c.findTraitIdxByName(start: td.nameStart, len: td.nameLen)
            self.valueArc(c: inout c, v: v, typeRef: srcRef, retain: true)
            return self.boxIntoAny(c: inout c, v: v, sidx: sidx, anyRef: dstRef, traitIdx: traitIdx)
        }
        // `Array[src] -> Array[dst]`: rebuild a fresh buffer, erasing each element.
        if rangeEquals(bytes: c.arena.bytes, start: td.nameStart, len: td.nameLen, kw: "Array") {
            return self.eraseArrayToAny(c: inout c, srcArr: v, srcElemRef: c.arena.types[srcRef].args[0], dstElemRef: td.args[0])
        }
        // a generic enum (`Optional[src] -> Optional[dst]`, `Result[src,E] -> …`): tag-dispatch,
        // erasing each variant's payload fields that widen to the existential.
        if c.genericEnumIndex(nameStart: td.nameStart, nameLen: td.nameLen) < c.arena.enums.count() {
            return self.eraseEnumToAny(c: inout c, srcEnum: v, srcRef: srcRef, dstRef: dstRef)
        }
        return v
    }

    // Erase a generic enum value `srcEnum` of `srcRef` to `dstRef` (same enum head, an arg
    // widened to `any P`): tag-dispatch to the active variant, extract its payload fields, and
    // for each field either covariantly erase it (a concrete->any widening — a fresh independently
    // owned value that borrows the field) or retain-and-copy it verbatim (value semantics: the
    // rebuilt enum co-owns a non-erasable heap field), then rebuild the variant of the destination
    // enum from those values (spec/08, SE-0309). BORROWS `srcEnum` — its refcount is unchanged.
    inout fn eraseEnumToAny(c: inout Comp, srcEnum: LLVMValueRef, srcRef: U64, dstRef: U64) -> LLVMValueRef {
        val srcGe: U64 = self.genEnumSlot(c: inout c, ref: srcRef)
        val dstGe: U64 = self.genEnumSlot(c: inout c, ref: dstRef)
        if srcGe >= self.genEnumRefs.count() || dstGe >= self.genEnumRefs.count() {
            return srcEnum
        }
        val srcEid: U64 = self.genEnumDefs[srcGe]
        val srcEty: LLVMTypeRef = self.genEnumTys[srcGe]
        val dstEid: U64 = self.genEnumDefs[dstGe]
        val dstEty: LLVMTypeRef = self.genEnumTys[dstGe]
        val srcSlot: LLVMValueRef = self.entryAlloca(ty: srcEty)
        LLVMBuildStore(self.b, srcEnum, srcSlot)
        val tag: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, LLVMBuildStructGEP2(self.b, srcEty, srcSlot, 0U64, anon()), anon())
        val srcPayloadPtr: LLVMValueRef = LLVMBuildStructGEP2(self.b, srcEty, srcSlot, 1U64, anon())
        val resSlot: LLVMValueRef = self.entryAlloca(ty: dstEty)
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "eraseenum.end"))
        val savedP: Array[Bind] = c.cur.typeParams
        val savedA: Array[U64] = c.cur.typeArgs
        mut val vi: U64 = 0
        while vi < c.arena.enums[srcEid].variants.count() {
            val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "eraseenum.v"))
            val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "eraseenum.n"))
            LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntEq(), tag, LLVMConstInt(self.i64ty, vi, 0I32), anon()), thenBB, nextBB)
            LLVMPositionBuilderAtEnd(self.b, thenBB)
            mut val payloadVals: Array[LLVMValueRef] = []
            val fs: Array[FieldDef] = c.arena.enums[srcEid].variants[vi].fields
            if fs.count() > 0U64 {
                // load the source payload under the SOURCE env (so `v: T` sizes as the concrete).
                c.cur.typeParams = c.arena.enums[srcEid].typeParams
                c.cur.typeArgs = c.arena.types[srcRef].args
                val srcPty: LLVMTypeRef = self.variantPayloadTy(c: inout c, eid: srcEid, vi: vi)
                val pv: LLVMValueRef = LLVMBuildLoad2(self.b, srcPty, srcPayloadPtr, anon())
                c.cur.typeParams = savedP
                c.cur.typeArgs = savedA
                mut val fj: U64 = 0
                while fj < fs.count() {
                    val fieldVal: LLVMValueRef = LLVMBuildExtractValue(self.b, pv, fj, anon())
                    c.cur.typeParams = c.arena.enums[srcEid].typeParams
                    c.cur.typeArgs = c.arena.types[srcRef].args
                    val sFieldRef: U64 = c.groundTypeRef(ref: fs[fj].ty)
                    c.cur.typeParams = c.arena.enums[dstEid].typeParams
                    c.cur.typeArgs = c.arena.types[dstRef].args
                    val dFieldRef: U64 = c.groundTypeRef(ref: fs[fj].ty)
                    c.cur.typeParams = savedP
                    c.cur.typeArgs = savedA
                    mut val ev: LLVMValueRef = fieldVal
                    if self.refElemErasable(c: inout c, dstElem: dFieldRef, srcElem: sFieldRef) {
                        // an erasable field: the repack produces a fresh, independently-owned
                        // value (leaf box / nested container) that BORROWS `fieldVal` — no
                        // pre-retain here (a blanket retain would leak a nested container's
                        // inner buffer, since the recursion borrows rather than adopts it).
                        ev = self.eraseCovariantToAny(c: inout c, v: fieldVal, srcRef: sFieldRef, dstRef: dFieldRef)
                    } else {
                        // a verbatim-copied field: the rebuilt enum co-owns its heap, so retain
                        // it (the source enum's own drop still releases its copy — balanced).
                        self.valueArc(c: inout c, v: fieldVal, typeRef: sFieldRef, retain: true)
                    }
                    payloadVals.append(ev)
                    fj += 1
                }
            }
            // rebuild the variant of the DESTINATION enum (payload sizes as the existential).
            c.cur.typeParams = c.arena.enums[dstEid].typeParams
            c.cur.typeArgs = c.arena.types[dstRef].args
            val dv: LLVMValueRef = self.buildEnumFromValues(c: inout c, eid: dstEid, ety: dstEty, vi: vi, payloadVals: payloadVals)
            c.cur.typeParams = savedP
            c.cur.typeArgs = savedA
            LLVMBuildStore(self.b, dv, resSlot)
            LLVMBuildBr(self.b, endBB)
            LLVMPositionBuilderAtEnd(self.b, nextBB)
            vi += 1
        }
        // unreachable tag (every variant handled above): a deterministic zero keeps the value well-formed.
        LLVMBuildStore(self.b, LLVMConstNull(dstEty), resSlot)
        LLVMBuildBr(self.b, endBB)
        LLVMPositionBuilderAtEnd(self.b, endBB)
        return LLVMBuildLoad2(self.b, dstEty, resSlot, anon())
    }

    // Erase `Array[srcElem] -> Array[dstElem]` (srcElem a concrete conforming to the trait
    // dstElem erases to, or a deeper container): allocate a fresh buffer sized for the erased
    // element, then erase each source element into it (eraseCovariantToAny, which retains at the
    // leaf so the fresh element is independently owned). BORROWS `srcArr` — the source array is
    // left untouched (the caller still owns it). Returns the new array value.
    inout fn eraseArrayToAny(c: inout Comp, srcArr: LLVMValueRef, srcElemRef: U64, dstElemRef: U64) -> LLVMValueRef {
        val srcElemTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: srcElemRef)
        val dstElemTy: LLVMTypeRef = self.llvmTypeOfRef(c: inout c, ref: dstElemRef)
        val srcData: LLVMValueRef = self.arrValData(c: inout c, arr: srcArr)
        val count: LLVMValueRef = self.rawbufCount(c: inout c, data: srcData)
        val newData: LLVMValueRef = self.rawbufAlloc(c: inout c, elemSize: LLVMSizeOf(dstElemTy), cap: count)
        val iSlot: LLVMValueRef = self.entryAlloca(ty: self.i64ty)
        LLVMBuildStore(self.b, LLVMConstInt(self.i64ty, 0U64, 0I32), iSlot)
        val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "erasearr.cond"))
        val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "erasearr.body"))
        val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(self.ctx, self.curFn, cstr(s: "erasearr.end"))
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, condBB)
        val iv: LLVMValueRef = LLVMBuildLoad2(self.b, self.i64ty, iSlot, anon())
        LLVMBuildCondBr(self.b, LLVMBuildICmp(self.b, llvmIntUlt(), iv, count, anon()), bodyBB, endBB)
        LLVMPositionBuilderAtEnd(self.b, bodyBB)
        mut val srcElem: LLVMValueRef = LLVMBuildLoad2(self.b, srcElemTy, self.arrElemPtr(elemTy: srcElemTy, data: srcData, idx: iv), anon())
        // borrow contract: the repack produces a fresh, independently-owned element (leaf box /
        // nested container) that BORROWS `srcElem` — retain happens at the actual leaf (or an
        // enum's verbatim field), never here, so a nested container does not double-count and
        // leak. The source array is left untouched (the caller still owns it).
        val erased: LLVMValueRef = self.eraseCovariantToAny(c: inout c, v: srcElem, srcRef: srcElemRef, dstRef: dstElemRef)
        LLVMBuildStore(self.b, erased, self.arrElemPtr(elemTy: dstElemTy, data: newData, idx: iv))
        LLVMBuildStore(self.b, LLVMBuildAdd(self.b, iv, LLVMConstInt(self.i64ty, 1U64, 0I32), anon()), iSlot)
        LLVMBuildBr(self.b, condBB)
        LLVMPositionBuilderAtEnd(self.b, endBB)
        return self.arrValMake(c: inout c, data: newData, count: count, aggTy: self.arrayInstTy(c: inout c, elemRef: dstElemRef))
    }

    // Dynamic dispatch of an existential requirement selected by Mono.  `traitIdx`
    // and `slot` are final-callable data: LLVM deliberately receives no source
    // selector and therefore cannot change the meaning by looking one up again.
    inout fn genLlvmAnyDispatch(c: inout Comp, recv: U64, anyRef: U64, traitIdx: U64, slot: U64, args: Array[Arg], callOffset: U64) -> LLVMValueRef {
        if traitIdx >= c.decls.traits.count() {
            c.errorAt(offset: callOffset, msg: "internal error: final existential trait target was not recorded")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        if slot == 0U64 || slot > c.decls.traits[traitIdx].reqs.count() {
            c.errorAt(offset: callOffset, msg: "internal error: final existential requirement target was not recorded")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val req: Func = c.decls.traits[traitIdx].reqs[slot - 1U64]
        // spec/08: a member with `Self` in a non-receiver INPUT position is not callable
        // through `any` (the erased concretes need not match, so a `Self` argument cannot
        // be supplied). A `-> Self` return IS callable — it is re-erased to `any P`.
        if reqUsesSelfInInput(c: inout c, req: req) {
            c.errorAt(offset: callOffset, msg: "this member is not callable through `any P`: `Self` appears in a non-receiver input — two `any P` values need not share a concrete type (spec/08)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        // `Self` in the result nested under a head we cannot repack (`Dictionary`, tuple):
        // not callable through `any P` (spec/08). `Optional[Self]`/`Array[Self]` ARE erasable.
        if !(reqRetSelfErasable(c: inout c, req: req)) {
            c.errorAt(offset: callOffset, msg: "this member is not callable through `any P`: `Self` appears in the result nested in a container that cannot be covariantly erased (spec/08)")
            return LLVMConstInt(self.i64ty, 0U64, 0I32)
        }
        val retsSelf: Bool = reqReturnsSelf(c: inout c, req: req)
        val retContainerSelf: Bool = req.hasRet && req.retTy != 0U64 && !(retsSelf) && typeRefMentionsSelf(c: inout c, ref: req.retTy)
        mut val fat: LLVMValueRef = LLVMConstNull(self.ptrty)
        mut val gotFat: Bool = false
        if req.selfInout {
            // the CoW write gate: an `inout` requirement mutates through the box, so a
            // shared box is split and the receiver PLACE repointed first (privatizeAnyBox).
            // A non-place receiver has no storage to repoint — the front-end rejects an
            // `inout` call on a temporary, so the fall-through below never mutates a
            // shared box in practice.
            val fatPlace: LLVMValueRef = self.placePtrStrict(c: inout c, id: recv)
            if LLVMIsNull(fatPlace) == 0I32 {
                fat = self.privatizeAnyBox(c: inout c, fat: LLVMBuildLoad2(self.b, self.anyTy, fatPlace, anon()), place: fatPlace)
                gotFat = true
            }
        }
        if !gotFat {
            fat = self.genLlvmExpr(c: inout c, id: recv)
            // a temporary receiver (`makeAny().m()`) owns its box: give it an anonymous
            // owned home so the statement-end drain releases it (guaranteed(+0) discipline).
            if !(exprAliasesPlace(c: inout c, id: recv)) {
                self.registerArgTemp(c: inout c, v: fat, typeRef: anyRef)
            }
        }
        val dataPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 0U64, anon())
        val vtPtr: LLVMValueRef = LLVMBuildExtractValue(self.b, fat, 1U64, anon())
        // &vtable[slot+1] via flat ptr-element GEP (element type ptr), then load the fn
        // ptr — requirement thunks sit after the copy (0) and drop (1) slots, and `slot`
        // is 1-based over the trait requirements.
        mut val gepIdx: Array[LLVMValueRef] = []
        gepIdx.append(LLVMConstInt(self.i64ty, slot + 1U64, 0I32))
        val slotPtr: LLVMValueRef = LLVMBuildGEP2(self.b, self.ptrty, vtPtr, arrayCPtr(gepIdx), 1U64, anon())
        val fnPtr: LLVMValueRef = LLVMBuildLoad2(self.b, self.ptrty, slotPtr, anon())
        // reconstruct the erased thunk signature: (ptr self, <req params>) -> <req ret>,
        // grounding the requirement's `Rhs`/`Item`/`Output` under the existential's
        // bindings (matching the thunk built in buildAnyThunk).
        mut val envParams: Array[Bind] = []
        mut val envArgs: Array[U64] = []
        val haveEnv: Bool = anyBindingEnv(c: inout c, anyRef: anyRef, traitIdx: traitIdx, outParams: inout envParams, outArgs: inout envArgs)
        val savedEP: Array[Bind] = c.cur.typeParams
        val savedEA: Array[U64] = c.cur.typeArgs
        if haveEnv {
            c.cur.typeParams = envParams
            c.cur.typeArgs = envArgs
        }
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(self.ptrty)
        mut val pi: U64 = 0
        while pi < req.params.count() {
            ptys.append(self.paramLlvmTy(c: inout c, p: req.params[pi]))
            pi += 1
        }
        mut val rty: LLVMTypeRef = self.llvmFnRetTy(c: inout c, f: req)
        // a covariant-`Self` container return: the thunk returns the erased container type
        // (`Self` = the existential), so reconstruct the same signature here to call it.
        mut val dstRetRef: U64 = 0
        if retContainerSelf {
            val savedSelf: U64 = c.cur.selfRef
            c.cur.selfRef = anyRef
            dstRetRef = c.groundTypeRef(ref: req.retTy)
            c.cur.selfRef = savedSelf
        }
        if haveEnv {
            c.cur.typeParams = savedEP
            c.cur.typeArgs = savedEA
        }
        // a `-> Self` requirement's thunk returns the re-erased existential fat pointer.
        if retsSelf {
            rty = self.anyTy
        }
        if retContainerSelf {
            rty = self.llvmTypeOfRef(c: inout c, ref: dstRetRef)
        }
        val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count(), 0I32)
        val pinMark: U64 = self.pinCells.count()
        mut val av: Array[LLVMValueRef] = []
        av.append(dataPtr)
        self.appendCallArgValues(c: inout c, av: inout av, f: req, args: args)
        // overlapping-inout runtime tier: the `any` receiver is a boxed copy (not a caller
        // place), so only the argument pairs need the pre-call place-identity check.
        self.emitInoutOverlapChecks(c: inout c, f: req, av: av, args: args, hasRecv: false, recvExpr: 0U64, avArgStart: 1U64, pinMark: pinMark)
        val rv: LLVMValueRef = LLVMBuildCall2(self.b, fty, fnPtr, arrayCPtr(av), av.count(), anon())
        self.releaseInoutPins(c: inout c, mark: pinMark)
        return rv
    }

    // Emit function `fi`'s body into the LLVM function value `fv` (under the active
    // substitution env, if any — used for both plain functions and generic instances).
    inout fn genLlvmFuncBody(c: inout Comp, fi: U64, fv: LLVMValueRef, environment: InstanceEnvironment) {
        val f: Func = c.arena.funcs[fi]
        // save the Self/Item env so this body fully restores it on exit — the body binds `self`
        // and sets cur.selfRef from the receiver ref (see the self-local binding below), which
        // must not leak into the next body (a pf-drain / free-fn emission has no per-call
        // save/restore around genLlvmFuncBody).
        val savedSelfFB: U64 = c.cur.selfRef
        val savedItemFB: U64 = c.cur.itemRef
        self.curFn = fv
        self.curIsMain = false
        self.curRetVoid = !f.hasRet
        // a plain method's `Self` resolves to the receiver type, so `-> Self` / a `Self`
        // param / `return self` ground (the generic-method path sets this via its
        // instantiation elsewhere; here it covers a non-generic method on a plain type).
        val didSelf: Bool = f.hasRecv && self.curRecvInstRef == 0U64 && c.cur.selfRef == 0U64
        if didSelf {
            c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
        }
        self.curRetTy = self.llvmFnRetTy(c: inout c, f: f)
        self.curRetTyStart = f.retStart
        self.curRetTyLen = f.retLen
        // ground the return ref under any active generic env (a monomorphized method
        // body: `Optional[T]` -> `Optional[I64]`) so return-context enum construction
        // can infer the concrete instance.
        self.curRetRef = c.groundTypeRef(ref: f.retTy)
        self.beginFnBody(fv: fv)
        // fresh local scope; bind each param into an alloca (so it reads/writes
        // uniformly with locals).
        self.nLocals = 0
        self.locStart = []
        self.locLen = []
        self.locPtr = []
        self.locTy = []
        self.locKind = []
        self.locStructIdx = []
        self.locIsArr = []
        self.locElemTy = []
        self.locElemKind = []
        self.locTypeRef = []
        self.locElemTypeRef = []
        self.locOwned = []
        self.locMoved = []
        self.locCellHome = []
        // module-level variables (spec/15) are visible everywhere: seed them as locals
        // (before self/params, so a same-named local shadows the global).
        self.seedGlobals(c: inout c)
        // method receiver: bind `self` as a local pointing at the struct storage —
        // an `inout fn`'s self IS the pointer param; a by-value self is stored into a
        // fresh alloca (so mutations stay local). Field access then GEPs locPtr
        // uniformly. Params follow self at index 1.
        mut val base: U64 = 0
        if f.hasRecv {
            // a generic method's receiver is its instantiation (curRecvInstRef): its
            // LLVM type / struct-index / env come from the instance, not the bare head
            // name (which `llvmScalarTy` can't resolve to a registered generic type).
            mut val recvTy: LLVMTypeRef = self.llvmScalarTy(c: inout c, tyStart: f.recvStart, tyLen: f.recvLen)
            mut val recvSidx: U64 = self.localStructIdxFor(c: inout c, start: f.recvStart, len: f.recvLen)
            mut val recvRef: U64 = 0
            if self.curRecvInstRef != 0U64 {
                recvRef = self.curRecvInstRef
                recvTy = self.llvmTypeOfRef(c: inout c, ref: self.curRecvInstRef)
                val gs: U64 = self.genStructSlot(c: inout c, ref: self.curRecvInstRef)
                if gs < self.genStructRefs.count() {
                    recvSidx = self.genStructDefs[gs]
                } else {
                    // a method-own-type-param pseudo instance (`Pair[Bag]` where Pair is
                    // NOT generic): keep the receiver-name's struct so `self.a` resolves.
                    recvSidx = self.localStructIdxFor(c: inout c, start: f.recvStart, len: f.recvLen)
                }
            }
            // an `Array[T]` receiver (a user method `impl[T] Array[T]`): self is the
            // `{ptr}` array value, bound as an array so `self.get`/`self.count()` resolve.
            mut val selfIsArr: Bool = false
            mut val selfElemTy: LLVMTypeRef = self.i64ty
            if self.curRecvInstRef != 0U64 {
                if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[self.curRecvInstRef].nameStart, len: c.arena.types[self.curRecvInstRef].nameLen, kw: "Array") {
                    recvTy = self.llvmTypeOfRef(c: inout c, ref: self.curRecvInstRef)
                    selfIsArr = true
                    if c.arena.types[self.curRecvInstRef].args.count() > 0U64 {
                        selfElemTy = self.llvmTypeOfRef(c: inout c, ref: c.arena.types[self.curRecvInstRef].args[0])
                    }
                    // Array's `{ptr}` value IS `struct Array[T] { data: Buffer[T] }` (Buffer
                    // is a bare ptr — buffer-floor.md §6), so its sole field `data` is field 0.
                    // Pin recvSidx to Array's arena struct def (Array is NOT backend-registered
                    // as a normal struct, so localStructIdxFor/genStructSlot may miss it), so a
                    // method body's `self.data.count()` resolves the field → Buffer[T] and
                    // dispatches the floor method (collections.md E2b). Mirrors the layout match.
                    recvSidx = c.structDefByNameAny(start: f.recvStart, len: f.recvLen)
                }
            }
            // an enum receiver (`impl Color { fn code() … }`): track its TypeRef so a
            // bare `match self` / `self == …` in the body recovers the enum. Tested
            // against the DECLARATION (concreteEnumIdxByName), not the registered
            // instances — registration is demand-driven, so a method emitted before any
            // construction of the enum would leave `self` ref-less. Mirrors bindOneParam.
            if recvRef == 0U64 {
                if recvSidx >= c.arena.structs.count() {
                    if c.concreteEnumIdxByName(start: f.recvStart, len: f.recvLen) < c.arena.enums.count() {
                        recvRef = c.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
                    }
                }
            }
            // TOTAL-REF: a bare (non-generic) struct receiver (`impl Point { fn m() }`). Track
            // its TypeRef so `self` and `self.field` recover the struct-idx from the ref uniformly
            // (formerly left 0, recovered via recvSidx classifier — the dominant Ident gap). Set
            // before the extension-view layering below so `self#Ext` still wraps this ref's args.
            if recvRef == 0U64 {
                if recvSidx < c.arena.structs.count() {
                    recvRef = c.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
                }
            }
            mut val selfPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
            if !(f.selfInout) {
                selfPtr = self.entryAlloca(ty: recvTy)
                LLVMBuildStore(self.b, LLVMGetParam(fv, 0U64), selfPtr)
            }
            // an extension method's self is viewed as `Recv#Ext` (spec/09): a bare
            // `self.m()` in the body resolves through the same extension (so it is
            // recursion, not a call to a shadowed bare method); reach the shadowed
            // method with `self#!Ext.m()`.
            // layer the self view onto recvRef when it carries none yet — recvRef==0 (the old
            // pf path) OR a no-view instance ref (B3-2: the gm path sets recvRef from
            // curRecvInstRef, so the view must be applied on top of it, preserving its args).
            if f.extId != 0U64 {
                if recvRef == 0U64 || (c.arena.types[recvRef].viewExtId == 0U64 && c.arena.types[recvRef].viewIds.count() == 0U64) {
                    if recvRef != 0U64 {
                        val selectedView: Array[U64] = [f.extId]
                        recvRef = c.typeRefWithViews(ref: recvRef, viewExtId: f.extId, viewIds: selectedView)
                    }
                }
            }
            self.pushLocalR(nameStart: self.selfStart, nameLen: self.selfLen, ptr: selfPtr, ty: recvTy, kind: kindFromTySpan(c: inout c, tyStart: f.recvStart, tyLen: f.recvLen), structIdx: recvSidx, isArr: selfIsArr, elemTy: selfElemTy, elemKind: 0U64, typeRef: recvRef)
            // keep the front-end `self` type in lockstep with the bound self local's ref: the
            // backend reads this local's typeRef (recvRef), exprType's `self` branch reads
            // cur.selfRef — set from the SAME value so the two type-recovery engines agree for
            // `self` in every emission path (restored from savedSelfFB on body exit).
            if recvRef != 0U64 {
                c.cur.selfRef = recvRef
            }
            // a `move fn` self is owned (deinit'd in the callee); `fn`/`inout fn`/
            // `borrow fn` self is a borrow the caller owns.
            self.setLocalOwned(owned: f.selfMove)
            base = 1U64
        }
        mut val pi: U64 = 0
        while pi < f.params.count() {
            self.bindOneParam(c: inout c, p: f.params[pi], fv: fv, argIdx: pi + base)
            // a `move` param is owned (deinit'd here); inout/borrow/by-value are not.
            self.setLocalOwned(owned: f.params[pi].isMove)
            pi += 1
        }
        // snapshot the BODY instance env for the typed-IR read path (groundedTypeOf):
        // taken after the emitters (emitOneGenFn/emitOneGenMethod) set the instance's
        // typeParams/typeArgs and after the self-local bound cur.selfRef above, so a
        // read during this body grounds under THIS env even while call resolution
        // transiently swaps cur.typeParams/selfRef to a callee's.
        val savedBodyEnvironment: InstanceEnvironment = c.cur.bodyEnvironment
        val savedBodyS: U64 = c.cur.bodySelfRef
        val savedBodyI: U64 = c.cur.bodyItemRef
        val savedBodyFn: U64 = c.cur.bodyFnIdx
        val savedBodyId: U64 = c.cur.bodyId
        c.cur.bodySelfRef = c.cur.selfRef
        c.cur.bodyItemRef = c.cur.itemRef
        c.enterBodyInstance(fnIdx: fi, environment: environment)
        // Consume the same canonical body-instance receiver that Mono used to
        // populate BodyCallee.  This is a key projection only; LLVM never
        // resolves a call or infers a source from it.
        self.curBodyMark = self.nLocals
        self.genLlvmBlock(c: inout c, id: f.body)
        c.cur.bodyEnvironment = savedBodyEnvironment
        c.cur.bodySelfRef = savedBodyS
        c.cur.bodyItemRef = savedBodyI
        c.cur.bodyFnIdx = savedBodyFn
        c.cur.bodyId = savedBodyId
        if !(self.terminated) {
            // fall-through: the body block dropped its body locals; now drop owned
            // params (a `move` param / `move fn` self the callee deinits).
            self.dropScope(c: inout c, fromMark: 0U64, excludeLi: 18446744073709551615U64)
            // checkReturns guarantees a non-() function diverges on every path, so a
            // fall-through here is a () function: return void.
            if self.curRetVoid {
                LLVMBuildRetVoid(self.b)
            } else {
                LLVMBuildUnreachable(self.b)
            }
        }
        if didSelf {
            c.clearSelfItemEnv()
        }
        // restore the Self/Item env captured on entry (covers the self-local's cur.selfRef set
        // above, so it never leaks past this body).
        c.cur.selfRef = savedSelfFB
        c.cur.itemRef = savedItemFB
    }
}
