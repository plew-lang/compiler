// Low-level compiler driver shared by the development and distributed entries.
import @Std/Process with { argCount, argAt, exit }
import ./Frontend with { Comp, analyzeFrontend }
import ./FrontendDriver with { frontendRequest }
import ./CheckedProgram with { CheckedProgram, ProgramCheckResult, prepareCheckedProgram, ExecutableCompilationResult }
import ./Backend with { emitLlvmRuntime, lowerLlvm, lowerPreparedLlvm, nativeCpu, LlvmModule, LlvmLoweringResult }
import ./SourceAccess with { SourceAccess }
import ./Diag with { CompileDiagnostic, emitDiagnostic }

extern(c) {
    fn plew_llvm_initialize_worker(trace~: I32)
}

pub fn runCompiler(sources: SourceAccess = <SourceAccess />, firstArgument: I64 = 1I64) {
    if argCount() > firstArgument {
        if argAt(firstArgument) == "--check" {
            runCheck(sources: sources, firstArgument: firstArgument + 1I64)
            return
        }
        if argAt(firstArgument) == "--emit-object" {
            if argCount() <= firstArgument + 2I64 { exit(code: 1I64) }
            mut val sourceArgument = firstArgument + 2I64
            mut val cpu = nativeCpu()
            if argAt(sourceArgument) == "--target-cpu" {
                if argCount() <= sourceArgument + 2I64 { exit(code: 1I64) }
                cpu = argAt(sourceArgument + 1I64)
                sourceArgument += 2I64
            }
            val status = compileObject(sources: sources, firstArgument: sourceArgument,
                output: argAt(firstArgument + 1I64), cpu: cpu)
            if status != 0I32 { exit(code: 1I64) }
            return
        }
        if argAt(firstArgument) == "--runtime" {
            emitLlvmRuntime()
            return
        }
    }
    match compileSource(sources: sources, firstArgument: firstArgument, emitText: true) {
        CompilationResult.Success(compilation: val compilation) => {}
        CompilationResult.Failure(diagnostic: val diagnostic) => {
            emitDiagnostic(diagnostic: diagnostic)
            exit(code: 1I64)
        }
    }
}

// The frontend arena is scoped to lowering, not the lifetime of LLVM passes.
unique struct Compilation {
    pub mut val module: LlvmModule
    pub val trace: Bool
}
pub impl Compilation { factory }

unique enum CompilationResult {
    Success(compilation: Compilation)
    Failure(diagnostic: CompileDiagnostic)
}

fn compileSource(sources: SourceAccess, firstArgument: I64, emitText: Bool = false) -> CompilationResult {
    val request = frontendRequest(sources: sources, firstArgument: firstArgument)
    // Generation checks a synthesized harness, not the user's whole target.
    if request.options.genMode {
        mut val compiler = <Comp />
        match analyzeFrontend(c: inout compiler, input: request.input, sources: request.sources, options: request.options) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <CompilationResult.Failure diagnostic=diagnostic /> }
        }
        val lowered = lowerLlvm(c: inout compiler)
        return finishCompilation(c: inout compiler, lowered: move lowered, emitText: emitText)
    }
    match CheckedProgram.check(input: request.input, sources: request.sources, options: request.options) {
        ProgramCheckResult.Failure(diagnostic: val diagnostic) => { return <CompilationResult.Failure diagnostic=diagnostic /> }
        ProgramCheckResult.Success(program: val program) => {
            match prepareCheckedProgram(checked: move program) {
                ExecutableCompilationResult.Failure(diagnostic: val diagnostic) => { return <CompilationResult.Failure diagnostic=diagnostic /> }
                ExecutableCompilationResult.Success(compilation: val compilation) => {
                    mut val executable = move compilation
                    val lowered = lowerPreparedLlvm(c: inout executable.compiler, prepared: executable.prepared)
                    return finishCompilation(c: inout executable.compiler, lowered: move lowered, emitText: emitText)
                }
            }
        }
    }
}

fn finishCompilation(c: inout Comp, lowered: move LlvmLoweringResult, emitText: Bool) -> CompilationResult {
    match move lowered {
        LlvmLoweringResult.Success(module: val module) => {
            if emitText { module.writeText(c: inout c) }
            return <CompilationResult.Success compilation=<Compilation module=move module trace=c.tracePhases /> />
        }
        LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { return <CompilationResult.Failure diagnostic=diagnostic /> }
    }
}

// Object mode keeps lowering and native optimization in one process. A failed
// native output returns normally so the owned LLVM context is still reclaimed.
pub fn compileObject(sources: SourceAccess, firstArgument: I64, output: String, cpu: String) -> I32 {
    match compileSource(sources: sources, firstArgument: firstArgument) {
        CompilationResult.Success(compilation: val value) => {
            mut val compilation = move value
            val trace = compilation.trace
            plew_llvm_initialize_worker(if trace { give 1I32 } else { give 0I32 })
            return compilation.module.writeObject(output: output, cpu: cpu, trace: trace)
        }
        CompilationResult.Failure(diagnostic: val diagnostic) => {
            emitDiagnostic(diagnostic: diagnostic)
            return 1I32
        }
    }
}

// The CLI owns diagnostics and exit status; checking itself owns no process IO.
pub fn runCheck(sources: SourceAccess = <SourceAccess />, firstArgument: I64 = 1I64) {
    val request = frontendRequest(sources: sources, firstArgument: firstArgument)
    match CheckedProgram.check(input: request.input, sources: request.sources, options: request.options) {
        ProgramCheckResult.Success(program: val program) => {}
        ProgramCheckResult.Failure(diagnostic: val diagnostic) => {
            emitDiagnostic(diagnostic: diagnostic)
            exit(code: 1I64)
        }
    }
}
