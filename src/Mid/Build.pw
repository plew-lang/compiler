// Mid builder state. Source bindings are mapped once to Mid local identities;
// later passes consume the frontend resolver's declaration identity rather than
// recovering a place by spelling from the AST.

import ../Frontend with { Comp }
import ../Ir with { Bind, TypeRef, SemanticExprType, SemanticAggregateKind, SemanticAggregate, SemanticAggregateElement, SemanticClosureCaptureMode, SemanticClosure, MatchSource, SemanticMatch, SemanticMatchArm, SemanticMatchPayload, MatchArmRange, Expr, Stmt, Param, Func, AccessCandidate, CallSiteKey, CallTemplate, CallTemplateKind, CallTemplateReceiver, CallTemplateArgument, CallArgumentSource, identValueCode, identSelfTarget }
import ../Diag with { eprintU64 }
import @Std/Io with { eprint }
import ../Ops with { opAnd, opOr }
import ./Ir with { MidRange, MidCanonicalBody, MidClosureBody, MidProjection, MidPlace, MidBorrowCapability, MidConstant, MidOperand, MidCallArgument, MidAggregateKind, MidAggregateElement, MidClosureCapture, MidRvalue, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidLocalDecl, MidScope, MidBlock, MidBody }

export struct MidSourceBinding {
    // Exactly `IdentBinding.target` for a local/parameter value.  The frontend
    // resolver defines it as the declaration's source offset, so it preserves
    // lexical shadowing even when declarations have the same spelling.  It is
    // deliberately not a use span and not an interned name id.
    pub val declarationTarget: U64
    pub val local: U64
    pub val scope: U64
}
pub impl MidSourceBinding { factory }

export struct MidBindingLookup {
    pub val found: Bool = false
    pub val local: U64 = 0U64
}
pub impl MidBindingLookup { factory }

export struct MidPlaceLookup {
    pub val found: Bool = false
    pub val place: MidPlace = <MidPlace local=0U64 />
}
pub impl MidPlaceLookup { factory }

struct MidIndexLocalBuild {
    pub val local: U64 = 0U64
    pub val error: MidBuildError = <MidBuildError.None />
}
pub impl MidIndexLocalBuild { factory }

struct MidNormalizedCallArgumentBuild {
    pub val argument: MidCallArgument = <MidCallArgument tag=8U64 />
    pub val error: MidBuildError = <MidBuildError.None />
}
pub impl MidNormalizedCallArgumentBuild { factory }

// A Mid build failure is part of the migration contract, not a diagnostic
// string.  Keep the source form that cannot yet be represented so coverage
// can select one semantic lowering slice rather than treating unrelated
// statement and operand work as one bucket.
export enum MidUnsupportedBuild {
    MakeWithoutAggregate
    FieldPlace
    UniqueAggregate
    IncompleteAggregate
    ShortCircuit
    FieldProjection
    FieldBase
    UnloweredView
    UnloweredValueControl
    UnloweredReference
    UnloweredClosure
    UnloweredAwait
    IndexPlace
    UnexpectedOperand
}

// Assignment fallback is not one semantic limitation. A target that cannot be
// named as a Mid place needs a different lowering from one that deliberately
// contains Index storage: the latter has a selected getter/setter writeback
// contract and must go through Mid/Access rather than become a raw store.
export enum MidUnsupportedAssign {
    IdentifierNotLocal
    FieldBaseNotPlace
    IndexBaseNotPlace
    OtherNotPlace
    IndexProjection
    ImmutableGlobal
}

export enum MidBuildError {
    None
    InvalidStatement
    InvalidBlock
    InvalidFunction
    MissingSemanticType
    UnboundLocalIdentifier
    Unsupported(reason: MidUnsupportedBuild)
    UnsupportedAssign(reason: MidUnsupportedAssign)
    UnsupportedWhile
    UnsupportedFor
    UnsupportedMatch
    UnsupportedPanic
    UnsupportedGive
    UnsupportedBreak
    UnsupportedContinue
    MissingTerminator
    MissingCallTemplate
    UnsupportedCallTemplate
}

export struct MidBodyBuild {
    pub val body: MidBody
    // The canonical snapshot is the authoritative post-build representation.
    // `body` remains only until the downstream passes are migrated one by one.
    pub val canonical: MidCanonicalBody = <MidCanonicalBody body=0U64 />
    pub val error: MidBuildError = <MidBuildError.None />
}
pub impl MidBodyBuild { factory }

struct MidOperandBuild {
    pub val operand: MidOperand
    pub val error: MidBuildError = <MidBuildError.None />
}
pub impl MidOperandBuild { factory }

struct MidReceiverBuild {
    pub val receiver: MidCallReceiver = <MidCallReceiver.None />
    pub val error: MidBuildError = <MidBuildError.None />
}
pub impl MidReceiverBuild { factory }

struct MidCallValueLookup {
    pub val found: Bool = false
    pub val place: MidPlace = <MidPlace local=0U64 />
}
pub impl MidCallValueLookup { factory }

export struct MidBuildState {
    pub mut val locals: Array[MidLocalDecl] = []
    pub mut val scopes: Array[MidScope] = []
    pub mut val blocks: Array[MidBlock] = []
    pub mut val bindings: Array[MidSourceBinding] = []
    // Completed dependencies of the CURRENT evaluation, not a function-wide
    // cache. Immutable source identity selects meaning; it does not identify
    // a runtime evaluation (defaults may share source across constructions).
    pub mut val callValues: Array[MidCallValue] = []
    // Call/aggregate consumers own nested evaluation scopes. Their dependency
    // values cannot escape to a sibling consumer; only the completed result
    // is published into the parent's evaluation scope.
    pub mut val aggregateValues: Array[MidAggregateValue] = []
    // One flat owner for normalized call-argument place projections.  A call
    // argument records only a range into this pool, never an owned MidPlace.
    pub mut val callArgumentProjections: Array[MidProjection] = []
    // Nested loops select only their innermost target. These parallel private
    // stacks are deliberately separate from lexical scopes: a loop has two
    // CFG destinations, while a scope has one cleanup obligation.
    mut val loopBreakTargets: Array[U64] = []
    mut val loopContinueTargets: Array[U64] = []
    mut val loopEnclosingScopes: Array[U64] = []
    pub mut val currentBlock: U64 = 0U64
    pub mut val currentScope: U64 = 0U64
    pub mut val hasReturnPlace: Bool = false
    pub mut val returnPlace: U64 = 0U64
    // ABI result contract for this Mid body.  It belongs to the body builder,
    // not to `sourceFunction`: closure/global synthetic body identities are
    // valid semantic owners but are not Func-array indices.
    pub mut val returnTypeTerm: U64 = 0U64
    // Lexical function identity of this parametric source body. It is used
    // solely to read its already-recorded CallTemplate by CallSiteKey.
    pub val sourceFunction: U64 = 0U64
}

fn midNormalizedCallPlace(state: inout MidBuildState, place: MidPlace, tag: U64, capability: U64) -> MidCallArgument {
    val start: U64 = state.callArgumentProjections.count()
    mut val i: U64 = 0U64
    while i < place.projections.count() {
        state.callArgumentProjections.append(place.projections[i])
        i = i + 1U64
    }
    return <MidCallArgument tag=tag rootTag=place.rootTag local=place.local globalTarget=place.globalTarget globalMutable=place.globalMutable projections=<MidRange start=start len=place.projections.count() /> capability=capability typeTerm=place.typeTerm />
}

// Normalize every argument shape at the call boundary.  This is intentionally
// not an `inout field` special case: all place-bearing operand kinds share the
// same flat body-owned projection pool, while immediate/access operands stay
// scalar rows.
fn midNormalizeCallArgument(state: inout MidBuildState, operand: MidOperand) -> MidCallArgument {
    match operand {
        MidOperand.Copy(place: val place) => { return midNormalizedCallPlace(state: inout state, place: place, tag: 1U64, capability: 0U64) }
        MidOperand.Move(place: val place) => { return midNormalizedCallPlace(state: inout state, place: place, tag: 2U64, capability: 0U64) }
        MidOperand.Borrow(place: val place, capability: val capability) => {
            match capability {
                MidBorrowCapability.Read => { return midNormalizedCallPlace(state: inout state, place: place, tag: 3U64, capability: 1U64) }
                MidBorrowCapability.Inout => { return midNormalizedCallPlace(state: inout state, place: place, tag: 4U64, capability: 2U64) }
            }
        }
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: val value, isNegative: val negative, isBool: val boolean, typeTerm: val term) => { return <MidCallArgument tag=5U64 integerValue=value integerNegative=negative integerBool=boolean typeTerm=term /> }
                MidConstant.StringLiteral(start: val start, len: val len, typeTerm: val term) => { return <MidCallArgument tag=6U64 stringStart=start stringLen=len typeTerm=term /> }
                MidConstant.FloatLiteral(start: val start, len: val len, typeTerm: val term) => { return <MidCallArgument tag=7U64 stringStart=start stringLen=len typeTerm=term /> }
            }
        }
        MidOperand.Access(candidate: val candidate) => { return <MidCallArgument tag=8U64 accessCandidate=candidate /> }
    }
}
pub impl MidBuildState {
    factory initial(sourceFunction: U64) {
        return <MidBuildState scopes=[<MidScope />] blocks=[<MidBlock />] sourceFunction=sourceFunction />
    }
}

pub impl MidBuildState {
    inout fn pushLoopTarget(breakTarget: U64, continueTarget: U64, enclosingScope: U64) {
        self.loopBreakTargets.append(breakTarget)
        self.loopContinueTargets.append(continueTarget)
        self.loopEnclosingScopes.append(enclosingScope)
    }

    inout fn popLoopTarget() {
        if self.loopBreakTargets.count() != 0U64 {
            self.loopBreakTargets.removeLast()
            self.loopContinueTargets.removeLast()
            self.loopEnclosingScopes.removeLast()
        }
    }

    fn hasLoopTarget() -> Bool {
        return self.loopBreakTargets.count() != 0U64
    }

    fn currentLoopBreakTarget() -> U64 {
        if self.loopBreakTargets.count() == 0U64 { return 0U64 }
        return self.loopBreakTargets[self.loopBreakTargets.count() - 1U64]
    }

    fn currentLoopContinueTarget() -> U64 {
        if self.loopContinueTargets.count() == 0U64 { return 0U64 }
        return self.loopContinueTargets[self.loopContinueTargets.count() - 1U64]
    }

    fn currentLoopEnclosingScope() -> U64 {
        if self.loopEnclosingScopes.count() == 0U64 { return 0U64 }
        return self.loopEnclosingScopes[self.loopEnclosingScopes.count() - 1U64]
    }
}

export struct MidCallValue {
    pub val siteKey: CallSiteKey
    pub val place: MidPlace
}
pub impl MidCallValue { factory }

struct MidAggregateLookup {
    pub val found: Bool = false
    pub val aggregate: SemanticAggregate = <SemanticAggregate />
}
pub impl MidAggregateLookup { factory }

struct MidClosureLookup {
    pub val found: Bool = false
    pub val closure: SemanticClosure = <SemanticClosure />
}
pub impl MidClosureLookup { factory }

export struct MidAggregateValue {
    pub val exprId: U64
    pub val place: MidPlace
}
pub impl MidAggregateValue { factory }

export fn emptyMidBody(sourceFunction: U64) -> MidBody {
    return <MidBody sourceFunction=sourceFunction scopes=[<MidScope />] blocks=[<MidBlock />] entry=0U64 />
}

// Register a declaration-time local exactly once. `declarationTarget` comes
// from the same resolver record later read at each identifier use. The caller
// supplies the already-recorded TypeTerm; this builder never calls a type
// recovery query or lexical name lookup.
export fn addMidLocal(state: inout MidBuildState, declarationTarget: U64, typeTerm: U64, isUnique: Bool, isParameter: Bool, ownsAtEntry: Bool, isInout: Bool = false, isBorrowed: Bool = false, isCaptureCell: Bool = false) -> U64 {
    val local: U64 = state.locals.count()
    state.locals.append(<MidLocalDecl typeTerm=typeTerm sourceScope=state.currentScope isUnique=isUnique isParameter=isParameter isBorrowed=isBorrowed isInout=isInout isCaptureCell=isCaptureCell ownsAtEntry=ownsAtEntry isDropFlag=false isReturnPlace=false sourceNameStart=declarationTarget />)
    state.bindings.append(<MidSourceBinding declarationTarget=declarationTarget local=local scope=state.currentScope />)
    return local
}

// Temporaries normally hold copyable evaluation results. A temporary that is
// the owner of a unique aggregate must retain that fact too: it can only leave
// the evaluation as Move, and drop elaboration must account for the transfer.
fn addMidTemporary(state: inout MidBuildState, typeTerm: U64, isUnique: Bool = false) -> U64 {
    val local: U64 = state.locals.count()
    state.locals.append(<MidLocalDecl typeTerm=typeTerm sourceScope=state.currentScope isUnique=isUnique isParameter=false ownsAtEntry=false isDropFlag=false isReturnPlace=false sourceNameStart=0U64 />)
    return local
}

// Convert a resolver-selected local/parameter declaration into a Mid local.
// A missing binding is intentionally explicit: globals/self/callables have
// different Mid lowering forms and must never be misclassified as a lexical
// local through a spelling fallback.
export fn midLocalForBinding(state: MidBuildState, declarationTarget: U64) -> MidBindingLookup {
    mut val i: U64 = 0U64
    while i < state.bindings.count() {
        val binding: MidSourceBinding = state.bindings[i]
        if binding.declarationTarget == declarationTarget {
            return <MidBindingLookup found=true local=binding.local />
        }
        i += 1U64
    }
    return <MidBindingLookup />
}

// The builder's only source-identifier boundary. Record/Verify has already
// selected the lexical binding and stored it in TypeCache. The category and
// declaration target are both required: target numeric domains overlap (for
// example, a function index can equal a local declaration offset), so the
// binding table alone must not reinterpret a callable as a local. `self`,
// locals, and parameters are value bindings. A resolver-recorded global is a
// separate typed address root, never a synthetic local. No source spelling,
// scope scan, or AST pattern match is permitted here.
export fn midPlaceForRecordedIdent(c: inout Comp, state: MidBuildState, exprId: U64, typeTerm: U64) -> MidPlaceLookup {
    if exprId >= c.typeCache.identBind.count() || exprId >= c.typeCache.identTarget.count() {
        return <MidPlaceLookup />
    }
    if c.typeCache.identBind[exprId] != identValueCode() { return <MidPlaceLookup /> }
    val local: MidBindingLookup = midLocalForBinding(state: state, declarationTarget: c.typeCache.identTarget[exprId])
    if !local.found {
        match c.recordedGlobalAddress(exprId: exprId) {
            Optional.Some(v: val global) => {
                if global.typeTerm != typeTerm { return <MidPlaceLookup /> }
                return <MidPlaceLookup found=true place=<MidPlace rootTag=2U64 local=0U64 globalTarget=global.declarationTarget globalMutable=global.mutable typeTerm=global.typeTerm /> />
            }
            _ => { return <MidPlaceLookup /> }
        }
    }
    if local.local >= state.locals.count() { return <MidPlaceLookup /> }
    // The lexical binding's declared TypeTerm is the authoritative type of a
    // root place. An expression slot can legitimately be absent for a Lower
    // synthesized node; letting that transient slot overwrite the local type
    // would make a typed place lose its storage ABI on the Mid boundary.
    return <MidPlaceLookup found=true place=<MidPlace local=local.local typeTerm=state.locals[local.local].typeTerm /> />
}

// Build the place shape from source syntax only after the frontend recorded
// every semantic choice.  Ident uses a resolver-selected declaration target;
// Field uses the stored layout slot and stored result TypeTerm.  In particular,
// this function never consults a field name, a StructDef, or a type recovery
// query.
fn midPlaceForSourceExpr(c: inout Comp, state: inout MidBuildState, exprId: U64, typeTerm: U64) -> MidPlaceLookup {
    if exprId >= c.arena.exprs.count() { return <MidPlaceLookup /> }
    match c.arena.exprs[exprId] {
        Expr.Ident(start: _, len: _) => {
            return midPlaceForRecordedIdent(c: inout c, state: state, exprId: exprId, typeTerm: typeTerm)
        }
        Expr.Field(base: val base, nameStart: _, nameLen: _) => {
            if exprId >= c.arena.semanticExprTypes.count() { return <MidPlaceLookup /> }
            val semantic: SemanticExprType = c.arena.semanticExprTypes[exprId]
            if !(semantic.hasFieldProjection) { return <MidPlaceLookup /> }
            // This is a frozen semantic-table read. Do not call the mutable
            // convenience accessor here: Mid construction must not mutate or
            // synthesize semantic state.
            mut val baseTerm: U64 = 0U64
            if base < c.arena.semanticExprTypes.count() {
                baseTerm = c.arena.semanticExprTypes[base].term
            }
            val basePlace: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: base, typeTerm: baseTerm)
            if !basePlace.found { return <MidPlaceLookup /> }
            mut val projections: Array[MidProjection] = basePlace.place.projections
            projections.append(<MidProjection.Field index=semantic.fieldProjectionIndex typeTerm=typeTerm />)
            return <MidPlaceLookup found=true place=<MidPlace rootTag=basePlace.place.rootTag local=basePlace.place.local globalTarget=basePlace.place.globalTarget globalMutable=basePlace.place.globalMutable projections=projections typeTerm=typeTerm /> />
        }
        Expr.Index(base: val base, index: val index) => {
            val baseTerm: U64 = c.semanticExprTerm(exprId: base)
            val basePlace: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: base, typeTerm: baseTerm)
            if !basePlace.found { return <MidPlaceLookup /> }
            val indexTerm: U64 = c.semanticExprTerm(exprId: index)
            if indexTerm == 0U64 { return <MidPlaceLookup /> }
            val evaluated: MidIndexLocalBuild = midIndexLocalForSourceExpr(c: inout c, state: inout state, exprId: index, typeTerm: indexTerm)
            match evaluated.error { MidBuildError.None => {} _ => { return <MidPlaceLookup /> } }
            mut val projections: Array[MidProjection] = basePlace.place.projections
            projections.append(<MidProjection.Index indexLocal=evaluated.local typeTerm=typeTerm />)
            return <MidPlaceLookup found=true place=<MidPlace rootTag=basePlace.place.rootTag local=basePlace.place.local globalTarget=basePlace.place.globalTarget globalMutable=basePlace.place.globalMutable projections=projections typeTerm=typeTerm /> />
        }
        _ => { return <MidPlaceLookup /> }
    }
}

// Build an inout call argument without ever materializing the transitional
// MidOperand(MidPlace(Array[Projection])) shape.  The source place is already
// semantically frozen; this only writes its selected root/projections into
// the body-owned scalar pool used by NormalizedCall.
fn midNormalizedInoutPlaceForSourceExpr(c: inout Comp, state: inout MidBuildState, exprId: U64, typeTerm: U64) -> MidNormalizedCallArgumentBuild {
    if exprId >= c.arena.exprs.count() { return <MidNormalizedCallArgumentBuild error=<MidBuildError.InvalidStatement /> /> }
    match c.arena.exprs[exprId] {
        Expr.Ident(start: _, len: _) => {
            val root: MidPlaceLookup = midPlaceForRecordedIdent(c: inout c, state: state, exprId: exprId, typeTerm: typeTerm)
            if !root.found { return <MidNormalizedCallArgumentBuild error=<MidBuildError.UnboundLocalIdentifier /> /> }
            return <MidNormalizedCallArgumentBuild argument=<MidCallArgument tag=4U64 rootTag=root.place.rootTag local=root.place.local globalTarget=root.place.globalTarget globalMutable=root.place.globalMutable capability=2U64 typeTerm=typeTerm /> />
        }
        Expr.Field(base: val base, nameStart: _, nameLen: _) => {
            if exprId >= c.arena.semanticExprTypes.count() { return <MidNormalizedCallArgumentBuild error=<MidBuildError.MissingSemanticType /> /> }
            val semantic: SemanticExprType = c.arena.semanticExprTypes[exprId]
            if !semantic.hasFieldProjection { return <MidNormalizedCallArgumentBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
            mut val baseTerm: U64 = 0U64
            if base < c.arena.semanticExprTypes.count() { baseTerm = c.arena.semanticExprTypes[base].term }
            val parent: MidNormalizedCallArgumentBuild = midNormalizedInoutPlaceForSourceExpr(c: inout c, state: inout state, exprId: base, typeTerm: baseTerm)
            match parent.error { MidBuildError.None => {} _ => { return parent } }
            state.callArgumentProjections.append(<MidProjection.Field index=semantic.fieldProjectionIndex typeTerm=typeTerm />)
            return <MidNormalizedCallArgumentBuild argument=<MidCallArgument tag=4U64 rootTag=parent.argument.rootTag local=parent.argument.local globalTarget=parent.argument.globalTarget globalMutable=parent.argument.globalMutable projections=<MidRange start=parent.argument.projections.start len=parent.argument.projections.len + 1U64 /> capability=2U64 typeTerm=typeTerm /> />
        }
        Expr.Index(base: val base, index: val index) => {
            val baseTerm: U64 = c.semanticExprTerm(exprId: base)
            val parent: MidNormalizedCallArgumentBuild = midNormalizedInoutPlaceForSourceExpr(c: inout c, state: inout state, exprId: base, typeTerm: baseTerm)
            match parent.error { MidBuildError.None => {} _ => { return parent } }
            val indexTerm: U64 = c.semanticExprTerm(exprId: index)
            if indexTerm == 0U64 { return <MidNormalizedCallArgumentBuild error=<MidBuildError.MissingSemanticType /> /> }
            val evaluated: MidIndexLocalBuild = midIndexLocalForSourceExpr(c: inout c, state: inout state, exprId: index, typeTerm: indexTerm)
            match evaluated.error { MidBuildError.None => {} _ => { return <MidNormalizedCallArgumentBuild error=evaluated.error /> } }
            state.callArgumentProjections.append(<MidProjection.Index indexLocal=evaluated.local typeTerm=typeTerm />)
            return <MidNormalizedCallArgumentBuild argument=<MidCallArgument tag=4U64 rootTag=parent.argument.rootTag local=parent.argument.local globalTarget=parent.argument.globalTarget globalMutable=parent.argument.globalMutable projections=<MidRange start=parent.argument.projections.start len=parent.argument.projections.len + 1U64 /> capability=2U64 typeTerm=typeTerm /> />
        }
        _ => { return <MidNormalizedCallArgumentBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
    }
}

fn midTemplateInoutCallArgument(c: inout Comp, state: inout MidBuildState, argument: CallTemplateArgument) -> MidNormalizedCallArgumentBuild {
    match argument.source {
        CallArgumentSource.Term(exprId: val exprId, term: val term) => { return midNormalizedInoutPlaceForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: term) }
        CallArgumentSource.Local(exprId: val exprId, localIndex: _, term: val term) => { return midNormalizedInoutPlaceForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: term) }
        CallArgumentSource.Legacy(exprId: val exprId, info: _) => { return midNormalizedInoutPlaceForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: c.semanticExprTerm(exprId: exprId)) }
        CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: _) => {
            val candidate: U64 = midAccessCandidateForExpr(c: c, exprId: exprId)
            if candidate < c.decls.accessCandidates.count() { return <MidNormalizedCallArgumentBuild argument=<MidCallArgument tag=8U64 accessCandidate=candidate /> /> }
            return <MidNormalizedCallArgumentBuild error=<MidBuildError.UnsupportedCallTemplate /> />
        }
    }
}

fn midAppendStatement(state: inout MidBuildState, statement: MidStatement) {
    if state.currentBlock >= state.blocks.count() { return }
    val current: MidBlock = state.blocks[state.currentBlock]
    // A nested value expression may terminate the current source path (for
    // example, a value match whose every arm returns). Its enclosing source
    // expression has no continuation on that path, so it must not append an
    // operation after the terminator just because it has a syntactic result
    // type. The caller will observe the closed block and stop building the
    // enclosing statement.
    if !midTerminatorIsOpen(terminator: current.terminator) { return }
    mut val statements: Array[MidStatement] = current.statements
    statements.append(statement)
    state.blocks.set(i: state.currentBlock, value: <MidBlock statements=statements terminator=current.terminator />)
}

fn midSetTerminator(state: inout MidBuildState, terminator: MidTerminator) {
    if state.currentBlock >= state.blocks.count() { return }
    val current: MidBlock = state.blocks[state.currentBlock]
    // Terminators are write-once. In particular, a parent call/return must
    // never overwrite an Unreachable produced by a diverging child value.
    if !midTerminatorIsOpen(terminator: current.terminator) { return }
    state.blocks.set(i: state.currentBlock, value: <MidBlock statements=current.statements terminator=terminator />)
}

fn midTerminatorIsOpen(terminator: MidTerminator) -> Bool {
    match terminator { MidTerminator.Open => { return true } _ => { return false } }
}

fn midCurrentBlockIsOpen(state: MidBuildState) -> Bool {
    if state.currentBlock >= state.blocks.count() { return false }
    return midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator)
}

fn midOperandIsTrue(operand: MidOperand) -> Bool {
    match operand {
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: val value, isNegative: val negative, isBool: val isBool, typeTerm: _) => { return isBool && !negative && value == 1U64 }
                _ => { return false }
            }
        }
        _ => { return false }
    }
}

// Builder-time reachability for freshly constructed CFG edges. This is used
// only to close a structurally retained block that has no predecessor; it does
// not perform value-range analysis or replace the ownership verifier's CFG
// dataflow.
fn midBlockHasIncoming(state: MidBuildState, target: U64) -> Bool {
    mut val block: U64 = 0U64
    while block < state.blocks.count() {
        match state.blocks[block].terminator {
            MidTerminator.Goto(target: val edge) => { if edge == target { return true } }
            MidTerminator.Switch(discriminant: _, values: _, targets: val edges, otherwise: val otherwise) => {
                if otherwise == target { return true }
                mut val edgeIndex: U64 = 0U64
                while edgeIndex < edges.count() {
                    if edges[edgeIndex] == target { return true }
                    edgeIndex += 1U64
                }
            }
            MidTerminator.TryBranch(discriminant: _, exprId: _, okTarget: val okTarget, errTarget: val errTarget) => {
                if okTarget == target || errTarget == target { return true }
            }
            MidTerminator.Call(callee: _, receiver: _, args: _, destination: _, target: val edge) => { if edge == target { return true } }
            MidTerminator.Suspend(state: _, resume: val edge) => { if edge == target { return true } }
            _ => {}
        }
        block += 1U64
    }
    return false
}

fn midNewBlock(state: inout MidBuildState) -> U64 {
    val index: U64 = state.blocks.count()
    state.blocks.append(<MidBlock />)
    return index
}

fn midEnsureRootScope(state: inout MidBuildState) {
    if state.scopes.count() == 0U64 {
        state.scopes.append(<MidScope firstLocal=state.locals.count() />)
        state.currentScope = 0U64
    }
}

fn midOpenScope(state: inout MidBuildState) -> U64 {
    midEnsureRootScope(state: inout state)
    val scope: U64 = state.scopes.count()
    state.scopes.append(<MidScope parent=state.currentScope firstLocal=state.locals.count() />)
    state.currentScope = scope
    return scope
}

fn midCloseScope(state: inout MidBuildState, scope: U64) {
    if scope >= state.scopes.count() { return }
    val current: MidScope = state.scopes[scope]
    state.scopes.set(i: scope, value: <MidScope parent=current.parent firstLocal=current.firstLocal localCount=state.locals.count() - current.firstLocal />)
    state.currentScope = current.parent
}

// A flat CFG does not retain a structured block's implicit lifetime.  Record
// the boundary explicitly and leave ownership decisions to drop elaboration;
// source lowering must never choose Drop versus ConditionalDrop itself.
fn midEmitScopeExit(state: inout MidBuildState, scope: U64) {
    midAppendStatement(state: inout state, statement: <MidStatement.ScopeExit scope=scope />)
}

// An evaluation scope is a normal ownership scope, not a backend cleanup
// convention. Return/break already emitted their exits before terminating.
fn midFinishEvaluationScope(state: inout MidBuildState, scope: U64) {
    if midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
        midEmitScopeExit(state: inout state, scope: scope)
    }
    midCloseScope(state: inout state, scope: scope)
    state.callValues = []
    state.aggregateValues = []
}

// The Bool result crosses the full-expression boundary, but none of the
// resources used to compute it do. The Switch consumes this result home.
fn materializeMidCondition(c: inout Comp, state: inout MidBuildState, exprId: U64) -> MidOperandBuild {
    val term: U64 = c.semanticExprTerm(exprId: exprId)
    val parentCalls: Array[MidCallValue] = state.callValues
    val parentAggregates: Array[MidAggregateValue] = state.aggregateValues
    state.callValues = []
    state.aggregateValues = []
    val scope: U64 = midOpenScope(state: inout state)
    val value: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: term, allowAccessMarker: false)
    match value.error {
        MidBuildError.None => {
            // Constants have neither a lexical owner nor an evaluation result
            // place.  Keeping them as operands preserves CFG facts such as
            // `while true`'s absent false edge; materializing them would turn
            // that fact into an opaque local load.  This is the ordinary
            // constant form for every condition, not a syntax-specific loop
            // exception.
            match value.operand {
                MidOperand.Constant(value: _) => {
                    midFinishEvaluationScope(state: inout state, scope: scope)
                    state.callValues = parentCalls
                    state.aggregateValues = parentAggregates
                    return value
                }
                _ => {
                    val result: MidPlace = <MidPlace local=addMidTemporary(state: inout state, typeTerm: term) typeTerm=term />
                    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=result value=<MidRvalue.Use operand=value.operand /> />)
                    midFinishEvaluationScope(state: inout state, scope: scope)
                    state.callValues = parentCalls
                    state.aggregateValues = parentAggregates
                    return <MidOperandBuild operand=<MidOperand.Move place=result /> />
                }
            }
        }
        _ => {
            midFinishEvaluationScope(state: inout state, scope: scope)
            state.callValues = parentCalls
            state.aggregateValues = parentAggregates
            return value
        }
    }
}

// Return leaves every currently active lexical scope, innermost first. Scope
// zero owns receiver/parameters; nested source blocks own their own bindings.
fn midEmitAllScopeExits(state: inout MidBuildState) {
    mut val scope: U64 = state.currentScope
    while true {
        midEmitScopeExit(state: inout state, scope: scope)
        if scope == 0U64 { return }
        if scope >= state.scopes.count() { return }
        scope = state.scopes[scope].parent
    }
}

// Leave all active lexical scopes strictly inside a loop's enclosing scope.
// The enclosing function/block scope itself remains live after either break or
// continue.  The builder records only the boundary marker; drop elaboration
// decides whether it becomes Drop or ConditionalDrop.
fn midEmitLoopScopeExits(state: inout MidBuildState, enclosingScope: U64) -> MidBuildError {
    mut val scope: U64 = state.currentScope
    while scope != enclosingScope {
        if scope >= state.scopes.count() { return <MidBuildError.InvalidBlock /> }
        midEmitScopeExit(state: inout state, scope: scope)
        scope = state.scopes[scope].parent
    }
    return <MidBuildError.None />
}

// `break` and `continue` are ordinary CFG edges.  Their only special rule is
// lexical cleanup of the scopes crossed to the selected loop boundary.
fn buildMidLoopExit(state: inout MidBuildState, isContinue: Bool) -> MidBuildError {
    if !state.hasLoopTarget() {
        if isContinue { return <MidBuildError.UnsupportedContinue /> }
        return <MidBuildError.UnsupportedBreak />
    }
    val cleanup: MidBuildError = midEmitLoopScopeExits(state: inout state, enclosingScope: state.currentLoopEnclosingScope())
    match cleanup { MidBuildError.None => {} _ => { return cleanup } }
    if isContinue {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=state.currentLoopContinueTarget() />)
    } else {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=state.currentLoopBreakTarget() />)
    }
    return <MidBuildError.None />
}

fn midAccessCandidateForExpr(c: Comp, exprId: U64) -> U64 {
    mut val candidate: U64 = 0U64
    while candidate < c.decls.accessCandidates.count() {
        val access: AccessCandidate = c.decls.accessCandidates[candidate]
        // Calls see the lowered synthetic read, whereas an explicit inout
        // argument remains anchored at the authored place expression.  Both
        // spellings denote the same frozen access candidate.
        if access.readExpr == exprId || access.placeExpr == exprId { return candidate }
        candidate += 1U64
    }
    return c.decls.accessCandidates.count()
}

// Lower turns an authored `items[index]` read into an `Index.index` synthetic
// call, while AccessCandidate retains its authored place.  Array's storage
// ABI therefore belongs to that frozen place fact, not to the synthetic call
// expression.  This recognition reads only frozen frontend facts so callers
// can decide whether an expression needs a CFG Call terminator *before*
// materializing its index local. A user `Index` witness stays on the ordinary
// selected-call path; only the addressable Array storage shape is a Mid place.
fn midDirectArrayIndexExpr(c: Comp, exprId: U64) -> U64 {
    if exprId >= c.arena.exprs.count() { return c.arena.exprs.count() }
    // Finalization can retain an Array read as its original Index place; the
    // general access path instead supplies the same place through a Lower
    // candidate. Normalize the two representation forms before inspecting
    // the resolved storage type.
    mut val placeExpr: U64 = exprId
    match c.arena.exprs[exprId] {
        Expr.Index(base: _, index: _) => {}
        _ => {
            val candidate: U64 = midAccessCandidateForExpr(c: c, exprId: exprId)
            if candidate >= c.decls.accessCandidates.count() { return c.arena.exprs.count() }
            placeExpr = c.decls.accessCandidates[candidate].placeExpr
        }
    }
    if placeExpr >= c.arena.exprs.count() { return c.arena.exprs.count() }
    match c.arena.exprs[placeExpr] {
        Expr.Index(base: val base, index: _) => {
            if base >= c.arena.semanticExprTypes.count() { return c.arena.exprs.count() }
            val baseTerm: U64 = c.arena.semanticExprTypes[base].term
            if baseTerm == 0U64 || baseTerm >= c.arena.types.count() { return c.arena.exprs.count() }
            val array: TypeRef = c.arena.types[baseTerm]
            if c.traceCodegen {
                eprint(text: "[trace-codegen] Mid array-place candidate term=")
                eprintU64(n: baseTerm)
                eprint(text: " has-decl=")
                if array.hasDecl { eprint(text: "1") } else { eprint(text: "0") }
                eprint(text: " decl=")
                eprintU64(n: array.declOffset)
                eprint(text: " site=")
                eprintU64(n: array.siteOffset)
                eprint(text: " lang-array=")
                eprintU64(n: c.langArrayDeclOffset)
                eprint(text: " args=")
                eprintU64(n: array.args.count())
                eprint(text: "\n")
            }
            if c.langArrayDeclOffset != 0U64 && array.hasDecl && array.declOffset == c.langArrayDeclOffset && array.args.count() == 1U64 { return placeExpr }
            return c.arena.exprs.count()
        }
        _ => { return c.arena.exprs.count() }
    }
}

fn midDirectArrayIndexPlace(c: inout Comp, state: inout MidBuildState, exprId: U64) -> U64 {
    val placeExpr: U64 = midDirectArrayIndexExpr(c: c, exprId: exprId)
    if placeExpr >= c.arena.exprs.count() { return placeExpr }
    // Keep the stateful part separate: materializing an arbitrary index may
    // emit a prior Mid call/temporary, and must happen exactly once.
    match c.arena.exprs[placeExpr] {
        Expr.Index(base: _, index: _) => {
            return placeExpr
        }
        _ => { return c.arena.exprs.count() }
    }
}

// These forms have already been parsed and typed; Mid never retries their
// resolution.  The reason says which *Mid operation* is still absent, rather
// than collapsing every non-scalar expression into one un-actionable bucket.
fn midUnsupportedOperandForExpr(c: Comp, exprId: U64) -> MidUnsupportedBuild {
    if exprId >= c.arena.exprs.count() { return <MidUnsupportedBuild.UnexpectedOperand /> }
    match c.arena.exprs[exprId] {
        Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, fields: _) => { return <MidUnsupportedBuild.MakeWithoutAggregate /> }
        Expr.ExtView(recv: _, source: _, strip: _) => { return <MidUnsupportedBuild.UnloweredView /> }
        Expr.OptChain(base: _, cont: _) => { return <MidUnsupportedBuild.UnloweredView /> }
        Expr.ChainHole => { return <MidUnsupportedBuild.UnloweredView /> }
        Expr.MatchExpr(scrut: _, arms: _) => { return <MidUnsupportedBuild.UnloweredValueControl /> }
        Expr.IfExpr(cond: _, thenBlk: _, elseBlk: _) => { return <MidUnsupportedBuild.UnloweredValueControl /> }
        Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return <MidUnsupportedBuild.UnloweredReference /> }
        Expr.Deref(base: _) => { return <MidUnsupportedBuild.UnloweredReference /> }
        Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => { return <MidUnsupportedBuild.UnloweredClosure /> }
        Expr.Await(operand: _) => { return <MidUnsupportedBuild.UnloweredAwait /> }
        _ => { return <MidUnsupportedBuild.UnexpectedOperand /> }
    }
}

fn midOperandForSourceExpr(c: inout Comp, state: inout MidBuildState, exprId: U64, typeTerm: U64) -> MidOperandBuild {
    if exprId >= c.arena.exprs.count() {
        return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.InvalidStatement /> />
    }
    val candidate: U64 = midAccessCandidateForExpr(c: c, exprId: exprId)
    if candidate < c.decls.accessCandidates.count() {
        return <MidOperandBuild operand=<MidOperand.Access candidate=candidate /> />
    }
    match c.arena.exprs[exprId] {
        Expr.Ident(start: _, len: _) => {
            val lookup: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: typeTerm)
            if !lookup.found { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.UnboundLocalIdentifier /> /> }
            return <MidOperandBuild operand=<MidOperand.Copy place=lookup.place /> />
        }
        Expr.Field(base: _, nameStart: _, nameLen: _) => {
            val lookup: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: typeTerm)
            if !lookup.found { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.FieldPlace /> /> /> }
            return <MidOperandBuild operand=<MidOperand.Copy place=lookup.place /> />
        }
        Expr.Move(operand: val operand, isBorrow: val isBorrow) => {
            val lookup: MidPlaceLookup = midPlaceForRecordedIdent(c: inout c, state: state, exprId: operand, typeTerm: typeTerm)
            if !lookup.found { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.UnboundLocalIdentifier /> /> }
            if isBorrow { return <MidOperandBuild operand=<MidOperand.Borrow place=lookup.place capability=<MidBorrowCapability.Read /> /> /> }
            return <MidOperandBuild operand=<MidOperand.Move place=lookup.place /> />
        }
        Expr.Int(value: val value, offset: _, isBool: val isBool, tyStart: _, tyLen: _, isNeg: val isNegative) => {
            return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=value isNegative=isNegative isBool=isBool typeTerm=typeTerm /> /> />
        }
        Expr.Str(start: val start, len: val len) => {
            return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.StringLiteral start=start len=len typeTerm=typeTerm /> /> />
        }
        Expr.Float(start: val start, len: val len, tyStart: _, tyLen: _) => {
            return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.FloatLiteral start=start len=len typeTerm=typeTerm /> /> />
        }
        _ => { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.Unsupported reason=midUnsupportedOperandForExpr(c: c, exprId: exprId) /> /> }
    }
}

fn midCallValueForSite(c: Comp, state: MidBuildState, siteKey: CallSiteKey) -> MidCallValueLookup {
    mut val i: U64 = 0U64
    while i < state.callValues.count() {
        val value: MidCallValue = state.callValues[i]
        if c.sameCallSiteKey(a: value.siteKey, b: siteKey) { return <MidCallValueLookup found=true place=value.place /> }
        i += 1U64
    }
    return <MidCallValueLookup />
}

// Emit a completed frontend call dependency before its consumer. The source
// ExprId only retrieves the immutable template; CallSiteKey proves it is the
// exact dependency the consumer recorded.
fn materializeMidCallValue(c: inout Comp, state: inout MidBuildState, exprId: U64, siteKey: CallSiteKey) -> MidOperandBuild {
    val prior: MidCallValueLookup = midCallValueForSite(c: c, state: state, siteKey: siteKey)
    if prior.found { return <MidOperandBuild operand=<MidOperand.Copy place=prior.place /> /> }
    val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
    if !(c.sameCallSiteKey(a: template.siteKey, b: siteKey)) {
        return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=0U64 /> /> error=<MidBuildError.MissingCallTemplate /> />
    }
    val term: U64 = c.semanticExprTerm(exprId: exprId)
    if term == 0U64 { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=0U64 /> /> error=<MidBuildError.MissingSemanticType /> /> }
    val local: U64 = addMidTemporary(state: inout state, typeTerm: term)
    val place: MidPlace = <MidPlace local=local typeTerm=term />
    val built: MidBuildError = buildMidCallInto(c: inout c, state: inout state, exprId: exprId, destination: place)
    match built { MidBuildError.None => {} _ => { return <MidOperandBuild operand=<MidOperand.Copy place=place /> error=built /> } }
    state.callValues.append(<MidCallValue siteKey=siteKey place=place />)
    return <MidOperandBuild operand=<MidOperand.Copy place=place /> />
}

// Fetch only the frozen Record-time carrier for this lexical body. ExprId is
// not a semantic key here: it selects one already-verified construction fact.
fn midSemanticAggregateForSourceBody(c: inout Comp, sourceFunction: U64, exprId: U64) -> MidAggregateLookup {
    val index: U64 = c.semanticAggregateIndex(ownerFnIdx: sourceFunction, exprId: exprId)
    if index < c.decls.semanticAggregates.count() {
        return <MidAggregateLookup found=true aggregate=c.decls.semanticAggregates[index] />
    }
    return <MidAggregateLookup />
}

// Closure meaning is keyed by its lexical body and literal ExprId, exactly as
// a semantic aggregate is. The lookup exposes only Mono's frozen descriptor;
// no nested-body scan or source-name recovery is permitted below this point.
fn midSemanticClosureForSourceBody(c: inout Comp, sourceFunction: U64, exprId: U64) -> MidClosureLookup {
    val index: U64 = c.semanticClosureIndex(ownerFnIdx: sourceFunction, exprId: exprId)
    if index < c.decls.semanticClosures.count() { return <MidClosureLookup found=true closure=c.decls.semanticClosures[index] /> }
    return <MidClosureLookup />
}

// `bindingTarget` is the frontend's lexical identity of the storage, so it is
// also the stable identity of the shared mutable capture cell. Build does not
// inspect closure syntax or rescan a nested body here: Mono already published
// the complete capture mode in SemanticClosure.
fn midBindingNeedsCaptureCell(c: Comp, sourceFunction: U64, bindingTarget: U64) -> Bool {
    mut val closureI: U64 = 0U64
    while closureI < c.decls.semanticClosures.count() {
        val closure: SemanticClosure = c.decls.semanticClosures[closureI]
        if closure.ownerFnIdx == sourceFunction {
            mut val captureI: U64 = 0U64
            while captureI < closure.captures.count() {
                val capture = closure.captures[captureI]
                match capture.mode {
                    SemanticClosureCaptureMode.CellBorrow => {
                        if capture.bindingTarget == bindingTarget { return true }
                    }
                    _ => {}
                }
                captureI += 1U64
            }
        }
        closureI += 1U64
    }
    return false
}

fn midAggregateValueForExpr(state: MidBuildState, exprId: U64) -> MidCallValueLookup {
    mut val i: U64 = 0U64
    while i < state.aggregateValues.count() {
        val value: MidAggregateValue = state.aggregateValues[i]
        if value.exprId == exprId { return <MidCallValueLookup found=true place=value.place /> }
        i += 1U64
    }
    return <MidCallValueLookup />
}

// Path 1 can lower only a fully authored aggregate. Record currently stores
// source-supplied fields; an omitted field default belongs to the legacy path
// until frontend publishes the default expression as an equally explicit
// semantic value fact. Reject the incomplete descriptor here, before Mid IR
// exists, rather than leaving LLVM preflight to discover a partial aggregate
// after the builder has already selected the Mid path.
fn midSemanticAggregateElementsComplete(aggregate: SemanticAggregate) -> Bool {
    if aggregate.elements.count() != aggregate.fieldCount { return false }
    mut val i: U64 = 0U64
    while i < aggregate.elements.count() {
        if aggregate.elements[i].fieldIndex >= aggregate.fieldCount { return false }
        mut val prior: U64 = 0U64
        while prior < i {
            if aggregate.elements[prior].fieldIndex == aggregate.elements[i].fieldIndex { return false }
            prior += 1U64
        }
        i += 1U64
    }
    return true
}

// Materialize an aggregate before a consuming call or parent aggregate. Child
// expressions follow Record's frozen evaluation order; each child is either a
// selected call, another frozen aggregate, or a closed basic Mid operand.
fn materializeMidAggregateValue(c: inout Comp, state: inout MidBuildState, aggregate: SemanticAggregate) -> MidOperandBuild {
    val prior: MidCallValueLookup = midAggregateValueForExpr(state: state, exprId: aggregate.exprId)
    // A cached aggregate is one completed source evaluation, not permission to
    // duplicate it. Copyable constructions may feed more than one already
    // recorded consumer; a unique construction must transfer its sole owner.
    if prior.found {
        if midAggregateHasUniqueValue(c: inout c, aggregate: aggregate) {
            return <MidOperandBuild operand=<MidOperand.Move place=prior.place /> />
        }
        return <MidOperandBuild operand=<MidOperand.Copy place=prior.place /> />
    }
    val parentCalls: Array[MidCallValue] = state.callValues
    val parentAggregates: Array[MidAggregateValue] = state.aggregateValues
    state.callValues = []
    state.aggregateValues = []
    val built: MidOperandBuild = buildMidAggregateEvaluation(c: inout c, state: inout state, aggregate: aggregate)
    state.callValues = parentCalls
    state.aggregateValues = parentAggregates
    match built.error { MidBuildError.None => {} _ => { return built } }
    match built.operand {
        MidOperand.Copy(place: val place) => {
            state.aggregateValues.append(<MidAggregateValue exprId=aggregate.exprId place=place />)
        }
        MidOperand.Move(place: val place) => {
            state.aggregateValues.append(<MidAggregateValue exprId=aggregate.exprId place=place />)
        }
        _ => {}
    }
    return built
}

// Closure construction is a value producer just like aggregate construction,
// but the layout is the frontend-published capture range rather than field
// declarations. A source literal occurs at one evaluation point; its captures
// are materialized in the recorded source order and are never inferred from
// the AST or backend locals.
fn materializeMidClosureValue(c: inout Comp, state: inout MidBuildState, closure: SemanticClosure, expectedType: U64) -> MidOperandBuild {
    if closure.functionTypeTerm == 0U64 || expectedType == 0U64 || !(c.typeRefEq(a: closure.functionTypeTerm, b: expectedType)) {
        return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=expectedType /> /> error=<MidBuildError.MissingSemanticType /> />
    }
    // Register the closure's frozen parametric body at the same semantic
    // boundary that creates its MakeClosure rvalue.  Codegen will instantiate
    // this canonical body later; it never gets permission to reconstruct one
    // from Expr.Closure.
    val closureBody: MidBodyBuild = ensureParametricMidClosureBody(c: inout c, closure: closure)
    match closureBody.error {
        MidBuildError.None => {}
        _ => { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=expectedType /> /> error=closureBody.error /> }
    }
    val local: U64 = addMidTemporary(state: inout state, typeTerm: expectedType)
    val destination: MidPlace = <MidPlace local=local typeTerm=expectedType />
    mut val captures: Array[MidClosureCapture] = []
    mut val captureI: U64 = 0U64
    while captureI < closure.captures.count() {
        val capture = closure.captures[captureI]
        val binding: MidBindingLookup = midLocalForBinding(state: state, declarationTarget: capture.bindingTarget)
        if !binding.found || binding.local >= state.locals.count() || !(c.typeRefEq(a: state.locals[binding.local].typeTerm, b: capture.typeTerm)) {
            return <MidOperandBuild operand=<MidOperand.Copy place=destination /> error=<MidBuildError.UnboundLocalIdentifier /> />
        }
        match capture.mode {
            SemanticClosureCaptureMode.CellBorrow => {
                if !(state.locals[binding.local].isCaptureCell) {
                    return <MidOperandBuild operand=<MidOperand.Copy place=destination /> error=<MidBuildError.MissingSemanticType /> />
                }
            }
            _ => {}
        }
        captures.append(<MidClosureCapture bindingTarget=capture.bindingTarget typeTerm=capture.typeTerm mode=capture.mode operand=<MidOperand.Copy place=<MidPlace local=binding.local typeTerm=capture.typeTerm /> /> />)
        captureI += 1U64
    }
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.MakeClosure exprId=closure.exprId bodyKey=closure.bodyKey functionTypeTerm=closure.functionTypeTerm captures=captures /> />)
    return <MidOperandBuild operand=<MidOperand.Copy place=destination /> />
}

// Children belong to this construction's evaluation. In particular, an
// omitted default has the same source origin in two constructions but must
// produce a new runtime value in each of them.
fn buildMidAggregateEvaluation(c: inout Comp, state: inout MidBuildState, aggregate: SemanticAggregate) -> MidOperandBuild {
    if !(midSemanticAggregateElementsComplete(aggregate: aggregate)) {
        return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=aggregate.resultTerm /> /> error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.IncompleteAggregate /> /> />
    }
    // Aggregate elements are ordinary owned destinations. A Move transfers
    // its existing unique owner into the selected slot; Copy retains a new
    // share as usual. This is not a special aggregate opcode or an LLVM-side
    // exception. The only difference is the result temporary's ownership.
    val ownsUnique: Bool = midAggregateHasUniqueValue(c: inout c, aggregate: aggregate)
    // An aggregate slot is not merely raw storage.  For example,
    // [circle] as Array[any Drawable] needs the frontend-selected
    // Circle-to-existential boxing conversion.  Path 1 has no conversion
    // Aggregate elements carry their physical destination TypeTerm from
    // Record.  Instantiation freezes the corresponding ValueConversionProof;
    // do not pre-reject contextual existential elements here merely because
    // their source term differs from the selected slot term.
    val local: U64 = addMidTemporary(state: inout state, typeTerm: aggregate.resultTerm, isUnique: ownsUnique)
    val writeDestination: MidPlace = <MidPlace local=local typeTerm=aggregate.resultTerm />
    mut val elements: Array[MidAggregateElement] = []
    mut val i: U64 = 0U64
    while i < aggregate.elements.count() {
        val element: SemanticAggregateElement = aggregate.elements[i]
        val nested: MidAggregateLookup = midSemanticAggregateForSourceBody(c: inout c, sourceFunction: state.sourceFunction, exprId: element.exprId)
        mut val operand: MidOperandBuild = <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=element.term /> /> />
        if nested.found {
            operand = materializeMidAggregateValue(c: inout c, state: inout state, aggregate: nested.aggregate)
        } else if midExprIsCall(c: c, exprId: element.exprId) {
            val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: element.exprId)
            operand = materializeMidCallValue(c: inout c, state: inout state, exprId: element.exprId, siteKey: template.siteKey)
        } else {
            operand = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: element.exprId, typeTerm: element.term, allowAccessMarker: false)
        }
        match operand.error { MidBuildError.None => {} _ => { return operand } }
        if !midCurrentBlockIsOpen(state: state) { return operand }
        elements.append(<MidAggregateElement fieldIndex=element.fieldIndex operand=operand.operand targetTerm=element.targetTerm isBoxed=element.isBoxed />)
        i += 1U64
    }
    match aggregate.kind {
        SemanticAggregateKind.Struct => {
            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=writeDestination value=<MidRvalue.Aggregate exprId=aggregate.exprId kind=<MidAggregateKind.Struct /> resultTerm=aggregate.resultTerm fieldCount=aggregate.fieldCount elements=elements /> />)
        }
        SemanticAggregateKind.Enum(enumIdx: val enumIdx, variantIndex: val variantIndex) => {
            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=writeDestination value=<MidRvalue.Aggregate exprId=aggregate.exprId kind=<MidAggregateKind.Enum enumIdx=enumIdx variantIndex=variantIndex /> resultTerm=aggregate.resultTerm fieldCount=aggregate.fieldCount elements=elements /> />)
        }
        SemanticAggregateKind.Array => {
            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=writeDestination value=<MidRvalue.Aggregate exprId=aggregate.exprId kind=<MidAggregateKind.Array /> resultTerm=aggregate.resultTerm fieldCount=aggregate.fieldCount elements=elements /> />)
        }
    }
    if ownsUnique { return <MidOperandBuild operand=<MidOperand.Move place=writeDestination /> /> }
    return <MidOperandBuild operand=<MidOperand.Copy place=writeDestination /> />
}

// `&&` / `||` are Bool-only control flow, not trait calls. Materialize their
// result in an ordinary Mid local: lhs is evaluated first, a Switch enters
// rhs only when required, and both paths assign the joined Bool place. This
// is deliberately the same non-SSA CFG shape as a value-producing source
// `if`; no legacy LLVM short-circuit emitter or AST re-entry is involved.
fn materializeMidShortCircuit(c: inout Comp, state: inout MidBuildState, lhs: U64, rhs: U64, typeTerm: U64, isAnd: Bool) -> MidOperandBuild {
    val left: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: lhs, typeTerm: c.semanticExprTerm(exprId: lhs), allowAccessMarker: false)
    match left.error { MidBuildError.None => {} _ => { return left } }
    if !midCurrentBlockIsOpen(state: state) { return left }
    val resultLocal: U64 = addMidTemporary(state: inout state, typeTerm: typeTerm)
    val result: MidPlace = <MidPlace local=resultLocal typeTerm=typeTerm />
    val rhsTarget: U64 = midNewBlock(state: inout state)
    val shortTarget: U64 = midNewBlock(state: inout state)
    val joinTarget: U64 = midNewBlock(state: inout state)
    if isAnd {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Switch discriminant=left.operand values=[1I64] targets=[rhsTarget] otherwise=shortTarget />)
    } else {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Switch discriminant=left.operand values=[1I64] targets=[shortTarget] otherwise=rhsTarget />)
    }
    state.currentBlock = shortTarget
    mut val shortValue: U64 = 0U64
    if !isAnd { shortValue = 1U64 }
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=result value=<MidRvalue.Use operand=<MidOperand.Constant value=<MidConstant.Integer value=shortValue isNegative=false isBool=true typeTerm=typeTerm /> /> /> />)
    midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=joinTarget />)
    state.currentBlock = rhsTarget
    val parentCalls: Array[MidCallValue] = state.callValues
    val parentAggregates: Array[MidAggregateValue] = state.aggregateValues
    state.callValues = []
    state.aggregateValues = []
    val rhsScope: U64 = midOpenScope(state: inout state)
    val right: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: rhs, typeTerm: c.semanticExprTerm(exprId: rhs), allowAccessMarker: false)
    match right.error { MidBuildError.None => {} _ => { return right } }
    if midCurrentBlockIsOpen(state: state) {
        midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=result value=<MidRvalue.Use operand=right.operand /> />)
    }
    midFinishEvaluationScope(state: inout state, scope: rhsScope)
    state.callValues = parentCalls
    state.aggregateValues = parentAggregates
    if midCurrentBlockIsOpen(state: state) {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=joinTarget />)
    }
    state.currentBlock = joinTarget
    return <MidOperandBuild operand=<MidOperand.Copy place=result /> />
}

// `try` is Result control flow, not a disguised source match.  The builder
// records only the parametric shape: a stable input home, a role-labelled
// tag/payload read, and an explicit conversion call edge.  Instantiation is
// the sole point that reads FinalTryResolution to select the concrete Result
// slots and either resolve `from` or erase the identity conversion.
fn materializeMidTry(c: inout Comp, state: inout MidBuildState, exprId: U64, operandExpr: U64, resultTerm: U64) -> MidOperandBuild {
    val operandResultTerm: U64 = c.semanticExprTerm(exprId: operandExpr)
    if operandResultTerm == 0U64 || operandResultTerm >= c.arena.types.count() || resultTerm == 0U64 { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=resultTerm /> /> error=<MidBuildError.MissingSemanticType /> /> }
    val operandResult: TypeRef = c.arena.types[operandResultTerm]
    if operandResult.args.count() != 2U64 || state.sourceFunction >= c.arena.funcs.count() { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=resultTerm /> /> error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.UnloweredValueControl /> /> /> }
    val returnResultTerm: U64 = c.arena.funcs[state.sourceFunction].retTy
    if returnResultTerm == 0U64 || returnResultTerm >= c.arena.types.count() || c.arena.types[returnResultTerm].args.count() != 2U64 || !state.hasReturnPlace { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=resultTerm /> /> error=<MidBuildError.InvalidFunction /> /> }

    // The yielded Ok value crosses the nested evaluation scope; all Result
    // storage and Err temporaries remain inside it and are cleaned on either
    // edge.  Allocating the result before opening that scope makes this
    // ownership boundary explicit in Mid rather than implicit in LLVM.
    val resultLocal: U64 = addMidTemporary(state: inout state, typeTerm: resultTerm)
    val result: MidPlace = <MidPlace local=resultLocal typeTerm=resultTerm />
    val parentCalls: Array[MidCallValue] = state.callValues
    val parentAggregates: Array[MidAggregateValue] = state.aggregateValues
    state.callValues = []
    state.aggregateValues = []
    val evaluation: U64 = midOpenScope(state: inout state)
    val input: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: operandExpr, typeTerm: operandResultTerm, allowAccessMarker: false)
    match input.error {
        MidBuildError.None => {}
        _ => {
            midCloseScope(state: inout state, scope: evaluation)
            state.callValues = parentCalls
            state.aggregateValues = parentAggregates
            return input
        }
    }
    if !midCurrentBlockIsOpen(state: state) {
        midCloseScope(state: inout state, scope: evaluation)
        state.callValues = parentCalls
        state.aggregateValues = parentAggregates
        return <MidOperandBuild operand=<MidOperand.Copy place=result /> />
    }
    val inputLocal: U64 = addMidTemporary(state: inout state, typeTerm: operandResultTerm)
    val inputPlace: MidPlace = <MidPlace local=inputLocal typeTerm=operandResultTerm />
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=inputPlace value=<MidRvalue.Use operand=input.operand /> />)
    val i64Name: Bind = c.wellKnownSpan(kw: "I64", kwLen: 3U64)
    val tagTerm: U64 = c.simpleTypeRef(nameStart: i64Name.nameStart, nameLen: i64Name.nameLen)
    if tagTerm == 0U64 {
        midCloseScope(state: inout state, scope: evaluation)
        state.callValues = parentCalls
        state.aggregateValues = parentAggregates
        return <MidOperandBuild operand=<MidOperand.Copy place=result /> error=<MidBuildError.MissingSemanticType /> />
    }
    val tagLocal: U64 = addMidTemporary(state: inout state, typeTerm: tagTerm)
    val tag: MidPlace = <MidPlace local=tagLocal typeTerm=tagTerm />
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=tag value=<MidRvalue.TryTag place=inputPlace exprId=exprId resultTerm=tagTerm /> />)
    val okTarget: U64 = midNewBlock(state: inout state)
    val errTarget: U64 = midNewBlock(state: inout state)
    val joinTarget: U64 = midNewBlock(state: inout state)
    midSetTerminator(state: inout state, terminator: <MidTerminator.TryBranch discriminant=<MidOperand.Copy place=tag /> exprId=exprId okTarget=okTarget errTarget=errTarget />)

    state.currentBlock = okTarget
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=result value=<MidRvalue.TryPayloadCopy place=inputPlace exprId=exprId variantIndex=0U64 resultTerm=resultTerm /> />)
    midEmitScopeExit(state: inout state, scope: evaluation)
    midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=joinTarget />)

    state.currentBlock = errTarget
    val sourceErrorTerm: U64 = operandResult.args[1U64]
    val targetErrorTerm: U64 = c.arena.types[returnResultTerm].args[1U64]
    val sourceErrorLocal: U64 = addMidTemporary(state: inout state, typeTerm: sourceErrorTerm)
    val sourceError: MidPlace = <MidPlace local=sourceErrorLocal typeTerm=sourceErrorTerm />
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=sourceError value=<MidRvalue.TryPayloadCopy place=inputPlace exprId=exprId variantIndex=1U64 resultTerm=sourceErrorTerm /> />)
    val convertedErrorLocal: U64 = addMidTemporary(state: inout state, typeTerm: targetErrorTerm)
    val convertedError: MidPlace = <MidPlace local=convertedErrorLocal typeTerm=targetErrorTerm />
    val afterConversion: U64 = midNewBlock(state: inout state)
    midSetTerminator(state: inout state, terminator: <MidTerminator.Call callee=<MidCallTarget.TryConversion exprId=exprId /> receiver=<MidCallReceiver.None /> args=[<MidOperand.Copy place=sourceError />] destination=convertedError target=afterConversion />)
    state.currentBlock = afterConversion
    val returnPlace: MidPlace = <MidPlace local=state.returnPlace typeTerm=returnResultTerm />
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=returnPlace value=<MidRvalue.TryErrResult exprId=exprId resultTerm=returnResultTerm error=<MidOperand.Move place=convertedError /> /> />)
    midEmitAllScopeExits(state: inout state)
    midSetTerminator(state: inout state, terminator: <MidTerminator.ReturnValue value=<MidOperand.Move place=returnPlace /> />)

    midCloseScope(state: inout state, scope: evaluation)
    state.callValues = parentCalls
    state.aggregateValues = parentAggregates
    state.currentBlock = joinTarget
    return <MidOperandBuild operand=<MidOperand.Copy place=result /> />
}

// Reify any already-resolved expression as a Mid value. The boolean is not a
// source-level heuristic: callers pass it only from the frozen selected ABI
// mode of an inout receiver/argument. A read-only index is materialized as its
// selected getter call; an inout use remains an Access marker for the later
// get-modify-set elaborator.
fn midValueOperandForSourceExpr(c: inout Comp, state: inout MidBuildState, exprId: U64, typeTerm: U64, allowAccessMarker: Bool) -> MidOperandBuild {
    if exprId >= c.arena.exprs.count() {
        return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.InvalidStatement /> />
    }
    val candidate: U64 = midAccessCandidateForExpr(c: c, exprId: exprId)
    val directPlaceExpr: U64 = midDirectArrayIndexPlace(c: inout c, state: inout state, exprId: exprId)
    if !allowAccessMarker && directPlaceExpr < c.arena.exprs.count() {
        val lookup: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: directPlaceExpr, typeTerm: typeTerm)
        if !lookup.found {
            return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.IndexPlace /> /> />
        }
        return <MidOperandBuild operand=<MidOperand.Copy place=lookup.place /> />
    }
    if candidate < c.decls.accessCandidates.count() {
        if allowAccessMarker { return <MidOperandBuild operand=<MidOperand.Access candidate=candidate /> /> }
        val readExpr: U64 = c.decls.accessCandidates[candidate].readExpr
        val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: readExpr)
        return materializeMidCallValue(c: inout c, state: inout state, exprId: readExpr, siteKey: template.siteKey)
    }
    val aggregate: MidAggregateLookup = midSemanticAggregateForSourceBody(c: inout c, sourceFunction: state.sourceFunction, exprId: exprId)
    if aggregate.found {
        return materializeMidAggregateValue(c: inout c, state: inout state, aggregate: aggregate.aggregate)
    }
    val closure: MidClosureLookup = midSemanticClosureForSourceBody(c: inout c, sourceFunction: state.sourceFunction, exprId: exprId)
    if closure.found {
        return materializeMidClosureValue(c: inout c, state: inout state, closure: closure.closure, expectedType: typeTerm)
    }
    match c.arena.exprs[exprId] {
        Expr.Call(nameStart: _, nameLen: _, args: _) => {
            val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
            return materializeMidCallValue(c: inout c, state: inout state, exprId: exprId, siteKey: template.siteKey)
        }
        Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
            val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
            return materializeMidCallValue(c: inout c, state: inout state, exprId: exprId, siteKey: template.siteKey)
        }
        Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
            val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
            return materializeMidCallValue(c: inout c, state: inout state, exprId: exprId, siteKey: template.siteKey)
        }
        Expr.Unary(op: _, operand: _) => {
            val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
            return materializeMidCallValue(c: inout c, state: inout state, exprId: exprId, siteKey: template.siteKey)
        }
        Expr.Binary(op: val op, lhs: val lhs, rhs: val rhs) => {
            if op == opAnd() || op == opOr() {
                return materializeMidShortCircuit(c: inout c, state: inout state, lhs: lhs, rhs: rhs, typeTerm: typeTerm, isAnd: op == opAnd())
            }
            val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
            return materializeMidCallValue(c: inout c, state: inout state, exprId: exprId, siteKey: template.siteKey)
        }
        Expr.Cast(operand: val sourceExpr, tyStart: _, tyLen: _, ty: val targetTerm) => {
            // The cast's type facts were recorded before Mid construction.
            // Builder uses Expr.Cast only as syntax navigation to its operand;
            // it neither classifies nor chooses the representation operation.
            val sourceTerm: U64 = c.semanticExprTerm(exprId: sourceExpr)
            val selectedTarget: U64 = c.semanticExprTerm(exprId: exprId)
            if sourceTerm == 0U64 || selectedTarget == 0U64 || targetTerm == 0U64 || !(c.typeRefEq(a: selectedTarget, b: targetTerm)) {
                return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.MissingSemanticType /> />
            }
            val source: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: sourceExpr, typeTerm: sourceTerm, allowAccessMarker: false)
            match source.error { MidBuildError.None => {} _ => { return source } }
            val local: U64 = addMidTemporary(state: inout state, typeTerm: selectedTarget)
            val destination: MidPlace = <MidPlace local=local typeTerm=selectedTarget />
            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.CastBoundary exprId=exprId sourceTerm=sourceTerm targetTerm=selectedTarget operand=source.operand /> />)
            return <MidOperandBuild operand=<MidOperand.Copy place=destination /> />
        }
        Expr.IfExpr(cond: val cond, thenBlk: val thenBlk, elseBlk: val elseBlk) => {
            // Value `if` uses the same ordinary CFG as statement `if`. Each
            // normally completing arm writes this one place; all-diverging
            // arms leave the retained join Unreachable, so no enclosing
            // consumer may materialize an uninitialized result.
            val resultLocal: U64 = addMidTemporary(state: inout state, typeTerm: typeTerm)
            val resultPlace: MidPlace = <MidPlace local=resultLocal typeTerm=typeTerm />
            val lowered: MidBuildError = buildMidIfCfg(c: inout c, state: inout state, cond: cond, thenBlk: thenBlk, elseBlk: elseBlk, hasElse: true, hasGiveDestination: true, giveDestination: resultPlace)
            match lowered {
                MidBuildError.None => { return <MidOperandBuild operand=<MidOperand.Copy place=resultPlace /> /> }
                _ => { return <MidOperandBuild operand=<MidOperand.Copy place=resultPlace /> error=lowered /> }
            }
        }
        Expr.MatchExpr(scrut: val scrut, arms: val arms) => {
            val resultLocal: U64 = addMidTemporary(state: inout state, typeTerm: typeTerm)
            val resultPlace: MidPlace = <MidPlace local=resultLocal typeTerm=typeTerm />
            val lowered: MidBuildError = buildMidEnumMatch(c: inout c, state: inout state, matchSource: <MatchSource.Expression exprId=exprId />, scrut: scrut, sourceArms: arms, hasGiveDestination: true, giveDestination: resultPlace, traceId: exprId)
            match lowered {
                MidBuildError.None => { return <MidOperandBuild operand=<MidOperand.Copy place=resultPlace /> /> }
                _ => { return <MidOperandBuild operand=<MidOperand.Copy place=resultPlace /> error=lowered /> }
            }
        }
        Expr.Try(expr: val operandExpr) => {
            return materializeMidTry(c: inout c, state: inout state, exprId: exprId, operandExpr: operandExpr, resultTerm: typeTerm)
        }
        Expr.Index(base: _, index: _) => {
            val lookup: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: typeTerm)
            if !lookup.found {
                return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.IndexPlace /> /> />
            }
            return <MidOperandBuild operand=<MidOperand.Copy place=lookup.place /> />
        }
        Expr.Field(base: val base, nameStart: _, nameLen: _) => {
            if exprId >= c.arena.semanticExprTypes.count() { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.MissingSemanticType /> /> }
            val field: SemanticExprType = c.arena.semanticExprTypes[exprId]
            if !(field.hasFieldProjection) { return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.FieldProjection /> /> /> }
            val baseTerm: U64 = c.semanticExprTerm(exprId: base)
            // A field does not erase the selected inout access mode of its
            // base. `items[i].field` still writes back the complete
            // `items[i]` storage value; SemanticAccess carries the selected
            // field slot for elaboration. Propagating the marker here avoids
            // prematurely materializing a getter value with no setter path.
            val baseValue: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: base, typeTerm: baseTerm, allowAccessMarker: allowAccessMarker)
            match baseValue.error { MidBuildError.None => {} _ => { return baseValue } }
            match baseValue.operand {
                MidOperand.Copy(place: val place) => {
                    mut val projections: Array[MidProjection] = place.projections
                    projections.append(<MidProjection.Field index=field.fieldProjectionIndex typeTerm=typeTerm />)
                    return <MidOperandBuild operand=<MidOperand.Copy place=<MidPlace rootTag=place.rootTag local=place.local globalTarget=place.globalTarget globalMutable=place.globalMutable projections=projections typeTerm=typeTerm /> /> />
                }
                MidOperand.Access(candidate: val candidate) => {
                    if allowAccessMarker { return <MidOperandBuild operand=<MidOperand.Access candidate=candidate /> /> }
                    return <MidOperandBuild operand=baseValue.operand error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.FieldBase /> /> />
                }
                _ => { return <MidOperandBuild operand=baseValue.operand error=<MidBuildError.Unsupported reason=<MidUnsupportedBuild.FieldBase /> /> /> }
            }
        }
        // An Array expression reaching Mid without a SemanticAggregate means
        // its Record-time expected-result producer was not closed. Do not
        // silently treat it as a generic unsupported AST form: callers can
        // distinguish a missing semantic fact from a missing Mid operation.
        Expr.Array(elems: _) => {
            return <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=typeTerm /> /> error=<MidBuildError.MissingSemanticType /> />
        }
        _ => { return midOperandForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: typeTerm) }
    }
}

// A projection cannot contain an arbitrary operand: that would make Place and
// Operand mutually recursive and let an effectful index be re-evaluated by a
// later consumer. Materialize non-root operands into a fresh Mid local first.
// A root Copy is already a one-time evaluated value and may be referenced
// directly. This is the same stable-local discipline used by Rust MIR index
// projections.
fn midIndexLocalForSourceExpr(c: inout Comp, state: inout MidBuildState, exprId: U64, typeTerm: U64) -> MidIndexLocalBuild {
    val built: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: typeTerm, allowAccessMarker: false)
    match built.error { MidBuildError.None => {} _ => { return <MidIndexLocalBuild error=built.error /> } }
    match built.operand {
        MidOperand.Copy(place: val place) => {
            if place.projections.count() == 0U64 { return <MidIndexLocalBuild local=place.local /> }
        }
        _ => {}
    }
    val temporary: U64 = addMidTemporary(state: inout state, typeTerm: typeTerm)
    val destination: MidPlace = <MidPlace local=temporary typeTerm=typeTerm />
    midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.Use operand=built.operand /> />)
    return <MidIndexLocalBuild local=temporary />
}

fn midTemplateArgumentOperand(c: inout Comp, state: inout MidBuildState, argument: CallTemplateArgument) -> MidOperandBuild {
    mut val built: MidOperandBuild = <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=0U64 /> /> error=<MidBuildError.UnsupportedCallTemplate /> />
    match argument.source {
        CallArgumentSource.Term(exprId: val exprId, term: val term) => {
            built = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: term, allowAccessMarker: argument.isInout)
        }
        CallArgumentSource.Local(exprId: val exprId, localIndex: _, term: val term) => {
            built = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: term, allowAccessMarker: argument.isInout)
        }
        CallArgumentSource.Legacy(exprId: val exprId, info: _) => {
            built = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: exprId, typeTerm: c.semanticExprTerm(exprId: exprId), allowAccessMarker: argument.isInout)
        }
        CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: val siteKey) => {
            // A synthetic Index.index read is a completed semantic call, so
            // its parent argument uses PriorCallResult rather than reopening
            // the authored Index place.  It is an Access marker only when the
            // selected parent ABI consumes an `inout` argument.  A value read
            // (including the receiver/key of another Index.index call) must
            // materialize the already-frozen getter, otherwise Mid would ask
            // access elaboration to invent a writeback that frontend quite
            // correctly never published.
            val candidate: U64 = midAccessCandidateForExpr(c: c, exprId: exprId)
            if argument.isInout && candidate < c.decls.accessCandidates.count() {
                built = <MidOperandBuild operand=<MidOperand.Access candidate=candidate /> />
            } else {
                built = materializeMidCallValue(c: inout c, state: inout state, exprId: exprId, siteKey: siteKey)
            }
        }
    }
    match built.error { MidBuildError.None => {} _ => { return built } }
    if argument.isInout {
        // `inout` is an ABI/ownership fact selected by the frontend template,
        // not an LLVM-side interpretation of a copied value.  The verifier has
        // already required a writable place, so only a lexical Copy place may
        // be reified as this capability-bearing borrow.
        match built.operand {
            MidOperand.Copy(place: val place) => {
                return <MidOperandBuild operand=<MidOperand.Borrow place=place capability=<MidBorrowCapability.Inout /> /> />
            }
            MidOperand.Access(candidate: val candidate) => {
                // The instance-specific access elaborator supplies the
                // materialized temporary and its Inout borrow.
                return <MidOperandBuild operand=<MidOperand.Access candidate=candidate /> />
            }
            _ => {
                return <MidOperandBuild operand=built.operand error=<MidBuildError.UnsupportedCallTemplate /> />
            }
        }
    }
    return built
}

fn midTemplateArguments(c: Comp, template: CallTemplate) -> Array[CallTemplateArgument] {
    match template.kind {
        CallTemplateKind.Direct(callee: _, receiver: _, args: val args, calleeTypeArgs: _, proofId: _) => { return c.callTemplateArguments(range: args) }
        CallTemplateKind.StaticMethod(receiver: _, args: val args, resolution: _, resultTerm: _) => { return c.callTemplateArguments(range: args) }
        CallTemplateKind.Dynamic(receiver: _, args: val args, target: _) => { return c.callTemplateArguments(range: args) }
        CallTemplateKind.Operator(op: _, operands: val operands, resolution: _, resultTerm: _) => {
            mut val args: Array[CallTemplateArgument] = []
            mut val i: U64 = 0U64
            while i < operands.len {
                if operands.start + i >= c.decls.callTemplateOperandPool.count() { return [] }
                args.append(<CallTemplateArgument source=c.decls.callTemplateOperandPool[operands.start + i] isInout=false labelStart=0U64 labelLen=0U64 hasLabel=false />)
                i += 1U64
            }
            return args
        }
        _ => { return [] }
    }
}

fn midTemplateIsCallable(template: CallTemplate) -> Bool {
    match template.kind {
        CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => { return true }
        CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, resultTerm: _) => { return true }
        CallTemplateKind.Dynamic(receiver: _, args: _, target: _) => { return true }
        CallTemplateKind.Operator(op: _, operands: _, resolution: _, resultTerm: _) => { return true }
        _ => { return false }
    }
}

fn midExprIsCall(c: Comp, exprId: U64) -> Bool {
    if exprId >= c.arena.exprs.count() { return false }
    // A Lower-generated `Array.index` call is a physical Place read. It must
    // not bypass Mid's Index projection by becoming a semantic call
    // terminator. The test is declaration-identity based, never name based.
    if midDirectArrayIndexExpr(c: c, exprId: exprId) < c.arena.exprs.count() { return false }
    match c.arena.exprs[exprId] {
        Expr.Call(nameStart: _, nameLen: _, args: _) => { return true }
        Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { return true }
        Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => { return true }
        Expr.Unary(op: _, operand: _) => { return true }
        Expr.Binary(op: val op, lhs: _, rhs: _) => { return op != opAnd() && op != opOr() }
        _ => { return false }
    }
}

fn midExprIsShortCircuit(c: Comp, exprId: U64) -> Bool {
    if exprId >= c.arena.exprs.count() { return false }
    match c.arena.exprs[exprId] {
        Expr.Binary(op: val op, lhs: _, rhs: _) => { return op == opAnd() || op == opOr() }
        _ => { return false }
    }
}

fn midDirectCallee(c: Comp, template: CallTemplate) -> U64 {
    match template.kind {
        CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => { return callee }
        _ => { return c.arena.funcs.count() }
    }
}

// Direct and StaticMethod templates both own a frozen receiver provenance.
// Their final callee becomes available at different times, but the source
// value must be materialized from this one sum rather than reconstructed by
// reopening method lookup.
fn midTemplateReceiver(template: CallTemplate) -> CallTemplateReceiver {
    match template.kind {
        CallTemplateKind.Direct(callee: _, receiver: val receiver, args: _, calleeTypeArgs: _, proofId: _) => { return receiver }
        CallTemplateKind.StaticMethod(receiver: val receiver, args: _, resolution: _, resultTerm: _) => { return receiver }
        _ => { return <CallTemplateReceiver.None /> }
    }
}

fn midMethodReceiverExpr(c: Comp, exprId: U64) -> U64 {
    if exprId >= c.arena.exprs.count() { return c.arena.exprs.count() }
    match c.arena.exprs[exprId] {
        Expr.Method(recv: val recv, nameStart: _, nameLen: _, args: _) => { return recv }
        Expr.ExtMethod(recv: val recv, source: _, nameStart: _, nameLen: _, args: _) => { return recv }
        _ => { return c.arena.exprs.count() }
    }
}

// Build the value receiver from the recorded source evaluation child while
// taking its ABI mode solely from the already selected Direct template. The
// Expr match supplies only evaluation shape; it never performs method lookup
// or type recovery.
fn midCallReceiver(c: inout Comp, state: inout MidBuildState, exprId: U64, template: CallTemplate) -> MidReceiverBuild {
    val callee: U64 = midDirectCallee(c: c, template: template)
    val templateReceiver: CallTemplateReceiver = midTemplateReceiver(template: template)
    // Direct calls already name their declaration in the parametric template,
    // so an inout receiver can be expressed as an Access marker immediately.
    // A StaticMethod's declaration is selected only per BodyInstance: build
    // its frozen read receiver now and let instantiation apply the selected
    // borrow passing. Inout/move static receivers remain intentionally closed
    // until they have an equally explicit source-access representation.
    val directInout: Bool = callee < c.arena.funcs.count() && c.arena.funcs[callee].hasRecv && c.arena.funcs[callee].selfInout
    if callee >= c.arena.funcs.count() {
        match template.kind {
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, resultTerm: _) => {}
            _ => { return <MidReceiverBuild /> }
        }
    } else if !(c.arena.funcs[callee].hasRecv) {
        return <MidReceiverBuild />
    }
    match templateReceiver {
        CallTemplateReceiver.None => { return <MidReceiverBuild /> }
        CallTemplateReceiver.PriorCallResult(exprId: val priorExpr, siteKey: val priorSite) => {
            // A lowered index read is represented as a prior call result, but
            // that representation does not make an inout use into a value
            // use. Preserve the access marker exactly as for a direct
            // receiver so the later CFG rewrite can perform the required
            // getter-modify-set writeback. Materializing here would leave the
            // parent method mutating only a detached temporary.
            if directInout {
                val candidate: U64 = midAccessCandidateForExpr(c: c, exprId: priorExpr)
                if candidate < c.decls.accessCandidates.count() {
                    return <MidReceiverBuild receiver=<MidCallReceiver.Value operand=<MidOperand.Access candidate=candidate /> /> />
                }
            }
            val built: MidOperandBuild = materializeMidCallValue(c: inout c, state: inout state, exprId: priorExpr, siteKey: priorSite)
            match built.error { MidBuildError.None => {} _ => { return <MidReceiverBuild error=built.error /> } }
            return <MidReceiverBuild receiver=<MidCallReceiver.Value operand=built.operand /> />
        }
        CallTemplateReceiver.PriorCallResultWithViews(exprId: _, siteKey: _, views: _) => { return <MidReceiverBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
        CallTemplateReceiver.PriorProtocolResult(slot: _) => { return <MidReceiverBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
        CallTemplateReceiver.PriorProtocolResultWithViews(slot: _, views: _) => { return <MidReceiverBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
        _ => {}
    }
    val receiverExpr: U64 = midMethodReceiverExpr(c: c, exprId: exprId)
    if receiverExpr >= c.arena.exprs.count() {
        return <MidReceiverBuild error=<MidBuildError.UnsupportedCallTemplate /> />
    }
    val receiverTerm: U64 = match templateReceiver {
        CallTemplateReceiver.Term(term: val term) => { give term }
        CallTemplateReceiver.Opaque => { give c.semanticExprTerm(exprId: receiverExpr) }
        _ => { give 0U64 }
    }
    if receiverTerm == 0U64 { return <MidReceiverBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
    val built: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: receiverExpr, typeTerm: receiverTerm, allowAccessMarker: directInout)
    match built.error { MidBuildError.None => {} _ => { return <MidReceiverBuild error=built.error /> } }
    if directInout {
        match built.operand {
            MidOperand.Copy(place: val place) => {
                val borrowed: MidOperand = <MidOperand.Borrow place=place capability=<MidBorrowCapability.Inout /> />
                val receiver: MidCallReceiver = <MidCallReceiver.Value operand=borrowed />
                return <MidReceiverBuild receiver=receiver />
            }
            MidOperand.Access(candidate: val candidate) => {
                // Access elaboration replaces this marker with the mutable
                // temporary borrowed by the selected inout receiver.
                return <MidReceiverBuild receiver=<MidCallReceiver.Value operand=<MidOperand.Access candidate=candidate /> /> />
            }
            _ => { return <MidReceiverBuild error=<MidBuildError.UnsupportedCallTemplate /> /> }
        }
    }
    return <MidReceiverBuild receiver=<MidCallReceiver.Value operand=built.operand /> />
}

// A source call is a terminator in Mid. Its semantic target and argument
// provenance come entirely from the frozen CallTemplate; source Expr ids are
// used only to materialize those already-selected value operands.
fn buildMidCallInto(c: inout Comp, state: inout MidBuildState, exprId: U64, destination: MidPlace) -> MidBuildError {
    val parentCalls: Array[MidCallValue] = state.callValues
    val parentAggregates: Array[MidAggregateValue] = state.aggregateValues
    state.callValues = []
    state.aggregateValues = []
    val built: MidBuildError = buildMidCallEvaluation(c: inout c, state: inout state, exprId: exprId, destination: destination)
    state.callValues = parentCalls
    state.aggregateValues = parentAggregates
    return built
}

fn buildMidCallEvaluation(c: inout Comp, state: inout MidBuildState, exprId: U64, destination: MidPlace) -> MidBuildError {
    val template: CallTemplate = c.callTemplateForSourceBody(fnIdx: state.sourceFunction, exprId: exprId)
    if !midTemplateIsCallable(template: template) {
        match template.kind { CallTemplateKind.Pending => { return <MidBuildError.MissingCallTemplate /> } _ => { return <MidBuildError.UnsupportedCallTemplate /> } }
    }
    val sources: Array[CallTemplateArgument] = midTemplateArguments(c: c, template: template)
    val receiver: MidReceiverBuild = midCallReceiver(c: inout c, state: inout state, exprId: exprId, template: template)
    match receiver.error { MidBuildError.None => {} _ => { return receiver.error } }
    if !midCurrentBlockIsOpen(state: state) { return <MidBuildError.None /> }
    mut val hasInoutArgument: Bool = false
    mut val sourceI: U64 = 0U64
    while sourceI < sources.count() {
        if sources[sourceI].isInout { hasInoutArgument = true }
        sourceI += 1U64
    }
    if !hasInoutArgument {
        mut val ordinaryArgs: Array[MidOperand] = []
        mut val ordinaryI: U64 = 0U64
        while ordinaryI < sources.count() {
            val argument: MidOperandBuild = midTemplateArgumentOperand(c: inout c, state: inout state, argument: sources[ordinaryI])
            match argument.error { MidBuildError.None => {} _ => { return argument.error } }
            if !midCurrentBlockIsOpen(state: state) { return <MidBuildError.None /> }
            ordinaryArgs.append(argument.operand)
            ordinaryI += 1U64
        }
        val ordinaryNext: U64 = midNewBlock(state: inout state)
        midSetTerminator(state: inout state, terminator: <MidTerminator.Call callee=<MidCallTarget.Template site=template.siteKey /> receiver=receiver.receiver args=ordinaryArgs destination=destination target=ordinaryNext />)
        state.currentBlock = ordinaryNext
        return <MidBuildError.None />
    }
    mut val args: Array[MidCallArgument] = []
    mut val i: U64 = 0U64
    while i < sources.count() {
        if sources[i].isInout {
            val argument: MidNormalizedCallArgumentBuild = midTemplateInoutCallArgument(c: inout c, state: inout state, argument: sources[i])
            match argument.error { MidBuildError.None => {} _ => { return argument.error } }
            args.append(argument.argument)
        } else {
            val argument: MidOperandBuild = midTemplateArgumentOperand(c: inout c, state: inout state, argument: sources[i])
            match argument.error { MidBuildError.None => {} _ => { return argument.error } }
            args.append(midNormalizeCallArgument(state: inout state, operand: argument.operand))
        }
        if !midCurrentBlockIsOpen(state: state) { return <MidBuildError.None /> }
        i += 1U64
    }
    val next: U64 = midNewBlock(state: inout state)
    midSetTerminator(state: inout state, terminator: <MidTerminator.NormalizedCall callee=<MidCallTarget.Template site=template.siteKey /> receiver=receiver.receiver args=args destination=destination target=next />)
    state.currentBlock = next
    return <MidBuildError.None />
}

// First source builder slice: an already recorded `val`/`mut val` becomes one
// Mid local plus an explicit assignment.  It is intentionally narrow, but it
// is a real frontend consumer: types come from Stmt/Record, identifier operands
// come from TypeCache, and no legacy type recovery is reachable from this path.
export fn buildMidLet(c: inout Comp, state: inout MidBuildState, stmtId: U64) -> MidBuildError {
    if stmtId >= c.arena.stmts.count() { return <MidBuildError.InvalidStatement /> }
    match c.arena.stmts[stmtId] {
        Stmt.Let(mutable: val mutable, nameStart: val nameStart, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: val declaredTerm, init: val init) => {
            mut val term: U64 = declaredTerm
            if term == 0U64 { term = c.semanticExprTerm(exprId: init) }
            if term == 0U64 { return <MidBuildError.MissingSemanticType /> }
            mut val isUnique: Bool = false
            if term < c.arena.types.count() {
                val t: TypeRef = c.arena.types[term]
                isUnique = c.typeIsUnique(start: t.nameStart, len: t.nameLen)
            }
            val destinationLocal: U64 = addMidLocal(state: inout state, declarationTarget: nameStart, typeTerm: term, isUnique: isUnique, isParameter: false, ownsAtEntry: false, isCaptureCell: midBindingNeedsCaptureCell(c: c, sourceFunction: state.sourceFunction, bindingTarget: nameStart))
            val destination: MidPlace = <MidPlace local=destinationLocal typeTerm=term />
            // The named destination belongs to the enclosing lexical scope;
            // only its initializer dependencies belong to this full expression.
            val evaluation: U64 = midOpenScope(state: inout state)
            if midExprIsCall(c: c, exprId: init) {
                // A direct call terminator cannot initialize a capture cell:
                // it writes a logical T, while the cell allocation is an
                // explicit Mid operation. Materialize the result first so the
                // cell's first owner and value boundary stay visible.
                mut val callDestination: MidPlace = destination
                if state.locals[destinationLocal].isCaptureCell {
                    val temporary: U64 = addMidTemporary(state: inout state, typeTerm: term)
                    callDestination = <MidPlace local=temporary typeTerm=term />
                }
                val result: MidBuildError = buildMidCallInto(c: inout c, state: inout state, exprId: init, destination: callDestination)
                if state.locals[destinationLocal].isCaptureCell {
                    midAppendStatement(state: inout state, statement: <MidStatement.InitializeCaptureCell destination=destination value=<MidRvalue.Use operand=<MidOperand.Move place=callDestination /> /> />)
                }
                midFinishEvaluationScope(state: inout state, scope: evaluation)
                return result
            }
            val aggregate: MidAggregateLookup = midSemanticAggregateForSourceBody(c: inout c, sourceFunction: state.sourceFunction, exprId: init)
            mut val operandResult: MidOperandBuild = <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=term /> /> />
            if aggregate.found {
                operandResult = materializeMidAggregateValue(c: inout c, state: inout state, aggregate: aggregate.aggregate)
            } else {
                operandResult = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: init, typeTerm: term, allowAccessMarker: false)
            }
            match operandResult.error {
                MidBuildError.None => {}
                _ => {
                    midFinishEvaluationScope(state: inout state, scope: evaluation)
                    return operandResult.error
                }
            }
            if state.locals[destinationLocal].isCaptureCell {
                midAppendStatement(state: inout state, statement: <MidStatement.InitializeCaptureCell destination=destination value=<MidRvalue.Use operand=operandResult.operand /> />)
            } else {
                midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.Use operand=operandResult.operand /> />)
            }
            midFinishEvaluationScope(state: inout state, scope: evaluation)
            return <MidBuildError.None />
        }
        _ => { return <MidBuildError.InvalidStatement /> }
    }
}

// Assignment is not initialization.  Evaluate its RHS into a fresh owned
// temporary first, then make the old destination's destruction and the
// consuming replacement explicit.  In particular this preserves the source
// order of `value = value` and `value = make(value)`: neither backend lowering
// nor drop elaboration may decide to destroy `value` before RHS evaluation.
// A direct field path is physical storage and keeps its selected field slots
// in Mid. Index paths deliberately remain SemanticAccess work: treating one
// as a raw store here would bypass its getter/setter/writeback and CoW proof.
export fn buildMidAssign(c: inout Comp, state: inout MidBuildState, stmtId: U64) -> MidBuildError {
    if stmtId >= c.arena.stmts.count() { return <MidBuildError.InvalidStatement /> }
    match c.arena.stmts[stmtId] {
        Stmt.Assign(target: val target, value: val value) => {
            val term: U64 = c.semanticExprTerm(exprId: target)
            if term == 0U64 { return <MidBuildError.MissingSemanticType /> }
            val destinationLookup: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: target, typeTerm: term)
            mut val physicalFieldPath: Bool = true
            mut val projection: U64 = 0U64
            while projection < destinationLookup.place.projections.count() {
                match destinationLookup.place.projections[projection] {
                    MidProjection.Field(index: _, typeTerm: _) => {}
                    _ => { physicalFieldPath = false }
                }
                projection += 1U64
            }
            if !destinationLookup.found {
                match c.arena.exprs[target] {
                    Expr.Ident(start: _, len: _) => { return <MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.IdentifierNotLocal /> /> }
                    Expr.Field(base: _, nameStart: _, nameLen: _) => { return <MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.FieldBaseNotPlace /> /> }
                    Expr.Index(base: _, index: _) => { return <MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.IndexBaseNotPlace /> /> }
                    _ => { return <MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.OtherNotPlace /> /> }
                }
            }
            if !physicalFieldPath {
                return <MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.IndexProjection /> />
            }
            if destinationLookup.place.rootTag == 2U64 && !destinationLookup.place.globalMutable {
                return <MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.ImmutableGlobal /> />
            }
            val temporaryLocal: U64 = addMidTemporary(state: inout state, typeTerm: term)
            val temporary: MidPlace = <MidPlace local=temporaryLocal typeTerm=term />
            if midExprIsCall(c: c, exprId: value) {
                val call: MidBuildError = buildMidCallInto(c: inout c, state: inout state, exprId: value, destination: temporary)
                match call { MidBuildError.None => {} _ => { return call } }
            } else {
                val aggregate: MidAggregateLookup = midSemanticAggregateForSourceBody(c: inout c, sourceFunction: state.sourceFunction, exprId: value)
                mut val operand: MidOperandBuild = <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=term /> /> error=<MidBuildError.UnsupportedAssign reason=<MidUnsupportedAssign.OtherNotPlace /> /> />
                if aggregate.found {
                    operand = materializeMidAggregateValue(c: inout c, state: inout state, aggregate: aggregate.aggregate)
                } else {
                    operand = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: value, typeTerm: term, allowAccessMarker: false)
                }
                match operand.error { MidBuildError.None => {} _ => { return operand.error } }
                midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=temporary value=<MidRvalue.Use operand=operand.operand /> />)
            }
            midAppendStatement(state: inout state, statement: <MidStatement.Overwrite destination=destinationLookup.place source=temporary />)
            return <MidBuildError.None />
        }
        _ => { return <MidBuildError.InvalidStatement /> }
    }
}

// Return is a terminator rather than an ad-hoc cleanup action.  Its operand
// owns the transfer to the ABI return place; later drop elaboration sees only
// the normal CFG exit and is responsible for the remaining locals.
export fn buildMidReturn(c: inout Comp, state: inout MidBuildState, stmtId: U64) -> MidBuildError {
    if stmtId >= c.arena.stmts.count() { return <MidBuildError.InvalidStatement /> }
    match c.arena.stmts[stmtId] {
        Stmt.Return(value: val value, hasValue: val hasValue, offset: _) => {
            if !hasValue {
                midEmitAllScopeExits(state: inout state)
                midSetTerminator(state: inout state, terminator: <MidTerminator.Return />)
                return <MidBuildError.None />
            }
            val term: U64 = c.semanticExprTerm(exprId: value)
            // A call used as the return value is not an operand: it owns a
            // continuation block. Materialize its result directly in the ABI
            // return place, then perform the same lexical cleanup and transfer
            // as a simple returned local. This keeps call-as-value control flow
            // explicit and lets later instance-specific access elaboration
            // splice its writeback before the continuation.
            if midExprIsCall(c: c, exprId: value) {
                if !state.hasReturnPlace { return <MidBuildError.InvalidFunction /> }
                // The callee result is not yet this function's ABI result.
                // Materialize it in its own selected source-type place, then
                // cross the enclosing return boundary explicitly.  Writing a
                // concrete callee result directly into an `any P` return place
                // would erase the required FinalReturnResolution conversion.
                val resultLocal: U64 = addMidTemporary(state: inout state, typeTerm: term)
                val callDestination: MidPlace = <MidPlace local=resultLocal typeTerm=term />
                val callResult: MidBuildError = buildMidCallInto(c: inout c, state: inout state, exprId: value, destination: callDestination)
                match callResult { MidBuildError.None => {} _ => { return callResult } }
                val destination: MidPlace = <MidPlace local=state.returnPlace typeTerm=state.returnTypeTerm />
                mut val resultOperand: MidOperand = <MidOperand.Copy place=callDestination />
                if midTermIsUnique(c: inout c, term: term) {
                    resultOperand = <MidOperand.Move place=callDestination />
                }
                midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.ReturnBoundary exprId=value targetTerm=c.arena.funcs[state.sourceFunction].retTy operand=resultOperand /> />)
                midEmitAllScopeExits(state: inout state)
                midSetTerminator(state: inout state, terminator: <MidTerminator.ReturnValue value=<MidOperand.Move place=destination /> />)
                return <MidBuildError.None />
            }
            val operand: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: value, typeTerm: term, allowAccessMarker: false)
            match operand.error { MidBuildError.None => {} _ => { return operand.error } }
            // Copy retains into the ABI result place and Move transfers there;
            // only then may lexical cleanup destroy the source locals.
            if !state.hasReturnPlace { return <MidBuildError.InvalidFunction /> }
            val destination: MidPlace = <MidPlace local=state.returnPlace typeTerm=state.returnTypeTerm />
            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.ReturnBoundary exprId=value targetTerm=c.arena.funcs[state.sourceFunction].retTy operand=operand.operand /> />)
            midEmitAllScopeExits(state: inout state)
            midSetTerminator(state: inout state, terminator: <MidTerminator.ReturnValue value=<MidOperand.Move place=destination /> />)
            return <MidBuildError.None />
        }
        _ => { return <MidBuildError.InvalidStatement /> }
    }
}

// Build a lexical source block into the current Mid block. The current slice
// supports statements whose ownership/evaluation form is already explicit;
// unsupported source forms fail at the builder boundary rather than being sent
// through the legacy LLVM emitter.
fn buildMidBlockInto(c: inout Comp, state: inout MidBuildState, blockId: U64, hasGiveDestination: Bool, giveDestination: MidPlace) -> MidBuildError {
    if blockId >= c.arena.blocks.count() { return <MidBuildError.InvalidBlock /> }
    val scope: U64 = midOpenScope(state: inout state)
    val block = c.arena.blocks[blockId]
    mut val result: MidBuildError = <MidBuildError.None />
    mut val i: U64 = 0U64
    while i < block.stmtLen {
        // A completed value from an earlier statement is not an operand of
        // this evaluation. Lexical variables live in bindings/locals instead.
        state.callValues = []
        state.aggregateValues = []
        val stmtId: U64 = c.arena.blockStmtPool[block.stmtStart + i]
        match c.arena.stmts[stmtId] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: _) => {
                result = buildMidLet(c: inout c, state: inout state, stmtId: stmtId)
            }
            Stmt.If(cond: _, thenBlk: _, elseBlk: _, hasElse: _) => {
                result = buildMidIf(c: inout c, state: inout state, stmtId: stmtId)
            }
            Stmt.Return(value: _, hasValue: _, offset: _) => {
                val evaluation: U64 = midOpenScope(state: inout state)
                result = buildMidReturn(c: inout c, state: inout state, stmtId: stmtId)
                midFinishEvaluationScope(state: inout state, scope: evaluation)
            }
            Stmt.ExprStmt(expr: val expr) => {
                val evaluation: U64 = midOpenScope(state: inout state)
                // An expression statement has the same evaluation semantics
                // as a value position, followed by lexical disposal of its
                // result.  In particular `try f()` must retain its Err edge
                // and discard only the normal Ok value; special-casing calls
                // here used to make that source form lose its CFG meaning.
                val discarded: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: expr, typeTerm: c.semanticExprTerm(exprId: expr), allowAccessMarker: false)
                result = discarded.error
                midFinishEvaluationScope(state: inout state, scope: evaluation)
            }
            Stmt.Assign(target: _, value: _) => {
                val evaluation: U64 = midOpenScope(state: inout state)
                result = buildMidAssign(c: inout c, state: inout state, stmtId: stmtId)
                midFinishEvaluationScope(state: inout state, scope: evaluation)
            }
            Stmt.While(cond: _, body: _) => {
                result = buildMidWhile(c: inout c, state: inout state, stmtId: stmtId)
            }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, iter: _, rangeHi: _, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => { result = <MidBuildError.UnsupportedFor /> }
            Stmt.Match(scrut: _, arms: _) => { result = buildMidMatch(c: inout c, state: inout state, stmtId: stmtId) }
            Stmt.Panic(msg: val message, offset: _) => {
                val messageTerm: U64 = c.semanticExprTerm(exprId: message)
                val built: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: message, typeTerm: messageTerm, allowAccessMarker: false)
                match built.error {
                    MidBuildError.None => { midSetTerminator(state: inout state, terminator: <MidTerminator.Panic message=built.operand />) }
                    _ => { result = built.error }
                }
            }
            Stmt.Give(value: val value) => {
                if !hasGiveDestination {
                    result = <MidBuildError.UnsupportedGive />
                } else {
                    val term: U64 = c.semanticExprTerm(exprId: value)
                    val operand: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: value, typeTerm: term, allowAccessMarker: false)
                    match operand.error {
                        MidBuildError.None => { midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=giveDestination value=<MidRvalue.Use operand=operand.operand /> />) }
                        _ => { result = operand.error }
                    }
                }
            }
            Stmt.Break(offset: _) => { result = buildMidLoopExit(state: inout state, isContinue: false) }
            Stmt.Continue(offset: _) => { result = buildMidLoopExit(state: inout state, isContinue: true) }
        }
        if !midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
            i = block.stmtLen
        }
        match result { MidBuildError.None => {} _ => { i = block.stmtLen } }
        i += 1U64
    }
    if midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
        midEmitScopeExit(state: inout state, scope: scope)
    }
    midCloseScope(state: inout state, scope: scope)
    return result
}

export fn buildMidBlock(c: inout Comp, state: inout MidBuildState, blockId: U64) -> MidBuildError {
    return buildMidBlockInto(c: inout c, state: inout state, blockId: blockId, hasGiveDestination: false, giveDestination: <MidPlace local=0U64 typeTerm=0U64 />)
}

// Enum declaration slots are stored as U64 arena indices, while the fixed
// runtime enum ABI stores the tag as I64.  Do not use a narrowing source cast:
// this conversion is valid because a realizable declaration's variant count is
// bounded by the compiler's addressable array length, far below I64::MAX.
// Keeping it explicit at the ABI boundary prevents the generic Switch value
// vocabulary from accidentally treating declaration identities as signed data.
fn midEnumTagForVariantSlot(slot: U64) -> I64 {
    mut val result: I64 = 0I64
    mut val index: U64 = 0U64
    while index < slot {
        result += 1I64
        index += 1U64
    }
    return result
}

// A statement enum match has one semantic owner: Record resolves the source
// pattern spelling into SemanticMatch, then this builder turns that frozen
// descriptor into ordinary CFG.  In particular, neither variant names nor
// payload field names cross this boundary. The first slice accepts a copied
// scalar payload only. ARC-owned payloads need a distinct borrowed-place
// binding (with a lifetime tied to the scrutinee); treating one as a copy here
// would silently omit its retain/drop semantics. Move matches likewise need a
// consuming payload operation and drop-flag transfer.
fn traceMidUnsupportedMatch(c: Comp, state: MidBuildState, stmtId: U64, reason: String) {
    if !(c.traceCodegen) { return }
    eprint(text: "[trace-codegen] Mid match-preflight fn=")
    eprintU64(n: state.sourceFunction)
    eprint(text: " stmt=")
    eprintU64(n: stmtId)
    eprint(text: " reason=")
    eprint(text: reason)
    eprint(text: "\n")
}

fn buildMidEnumMatch(c: inout Comp, state: inout MidBuildState, matchSource: MatchSource, scrut: U64, sourceArms: MatchArmRange, hasGiveDestination: Bool, giveDestination: MidPlace, traceId: U64) -> MidBuildError {
            val semanticIndex: U64 = c.semanticMatchIndex(ownerFnIdx: state.sourceFunction, matchSource: matchSource)
            if semanticIndex >= c.decls.semanticMatches.count() {
                traceMidUnsupportedMatch(c: c, state: state, stmtId: traceId, reason: "missing-semantic-match")
                return <MidBuildError.UnsupportedMatch />
            }
            val semantic: SemanticMatch = c.decls.semanticMatches[semanticIndex]
            if semantic.arms.count() != sourceArms.len {
                traceMidUnsupportedMatch(c: c, state: state, stmtId: traceId, reason: "arm-count")
                return <MidBuildError.UnsupportedMatch />
            }
            if midTermIsUnique(c: inout c, term: semantic.scrutineeTerm) {
                traceMidUnsupportedMatch(c: c, state: state, stmtId: traceId, reason: "unique-scrutinee")
                return <MidBuildError.UnsupportedMatch />
            }
            mut val scrutinee: MidPlaceLookup = midPlaceForSourceExpr(c: inout c, state: inout state, exprId: scrut, typeTerm: semantic.scrutineeTerm)
            // A statement match consumes its scrutinee expression exactly once,
            // but tag reads and every arm payload projection need a stable
            // place for the lifetime of the complete arm CFG.  Normalize an
            // already-resolved rvalue into a lexical temporary rather than
            // teaching EnumTag/EnumPayloadCopy to re-evaluate an operand.
            // This is the same place discipline used for dynamic index keys:
            // a Mid Place never embeds an effectful source expression.
            mut val hasScrutineeScope: Bool = false
            mut val scrutineeScope: U64 = 0U64
            if !scrutinee.found {
                val value: MidOperandBuild = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: scrut, typeTerm: semantic.scrutineeTerm, allowAccessMarker: false)
                match value.error {
                    MidBuildError.None => {}
                    _ => {
                        traceMidUnsupportedMatch(c: c, state: state, stmtId: traceId, reason: "scrutinee-rvalue-unavailable")
                        return value.error
                    }
                }
                if !midCurrentBlockIsOpen(state: state) { return <MidBuildError.None /> }
                scrutineeScope = midOpenScope(state: inout state)
                hasScrutineeScope = true
                val temporary: U64 = addMidTemporary(state: inout state, typeTerm: semantic.scrutineeTerm)
                val temporaryPlace: MidPlace = <MidPlace local=temporary typeTerm=semantic.scrutineeTerm />
                midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=temporaryPlace value=<MidRvalue.Use operand=value.operand /> />)
                scrutinee = <MidPlaceLookup found=true place=temporaryPlace />
            }
            if !scrutinee.found {
                traceMidUnsupportedMatch(c: c, state: state, stmtId: traceId, reason: "scrutinee-not-place")
                return <MidBuildError.UnsupportedMatch />
            }
            val i64Name: Bind = c.wellKnownSpan(kw: "I64", kwLen: 3U64)
            val tagTerm: U64 = c.simpleTypeRef(nameStart: i64Name.nameStart, nameLen: i64Name.nameLen)
            if tagTerm == 0U64 { return <MidBuildError.MissingSemanticType /> }
            val tagLocal: U64 = addMidTemporary(state: inout state, typeTerm: tagTerm)
            val tagPlace: MidPlace = <MidPlace local=tagLocal typeTerm=tagTerm />
            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=tagPlace value=<MidRvalue.EnumTag place=scrutinee.place enumIndex=semantic.enumIndex matchSource=matchSource resultTerm=tagTerm /> />)
            val joinTarget: U64 = midNewBlock(state: inout state)
            val mismatchTarget: U64 = midNewBlock(state: inout state)
            mut val armTargets: Array[U64] = []
            mut val values: Array[I64] = []
            mut val targets: Array[U64] = []
            mut val otherwise: U64 = mismatchTarget
            mut val joinReachable: Bool = false
            mut val armIndex: U64 = 0U64
            while armIndex < semantic.arms.count() {
                val armTarget: U64 = midNewBlock(state: inout state)
                armTargets.append(armTarget)
                val arm: SemanticMatchArm = semantic.arms[armIndex]
                if arm.hasVariant {
                    values.append(midEnumTagForVariantSlot(slot: arm.variantIndex))
                    targets.append(armTarget)
                } else {
                    otherwise = armTarget
                }
                armIndex += 1U64
            }
            midSetTerminator(state: inout state, terminator: <MidTerminator.Switch discriminant=<MidOperand.Copy place=tagPlace /> values=values targets=targets otherwise=otherwise />)
            state.currentBlock = mismatchTarget
            midSetTerminator(state: inout state, terminator: <MidTerminator.Abort />)
            armIndex = 0U64
            while armIndex < semantic.arms.count() {
                state.currentBlock = armTargets[armIndex]
                val bindingMark: U64 = state.bindings.count()
                val armScope: U64 = midOpenScope(state: inout state)
                val semanticArm: SemanticMatchArm = semantic.arms[armIndex]
                mut val payloadIndex: U64 = 0U64
                while payloadIndex < semanticArm.payloads.count() {
                    val payload: SemanticMatchPayload = semanticArm.payloads[payloadIndex]
                    if midTermIsUnique(c: inout c, term: payload.fieldTerm) {
                        traceMidUnsupportedMatch(c: c, state: state, stmtId: traceId, reason: "unique-payload")
                        return <MidBuildError.UnsupportedMatch />
                    }
                    // Every non-consuming payload binding aliases the matched
                    // enum for the arm's lexical lifetime.  This is not an
                    // ARC classification: the parametric body may contain T,
                    // whose ARC representation is known only after grounding.
                    // A later MidOperand.Copy is the sole value boundary and
                    // obtains the grounded ARC share when one is needed.
                    // Scalars follow the same representation at zero ARC cost.
                    val isBorrowed: Bool = true
                    val local: U64 = addMidLocal(state: inout state, declarationTarget: payload.bindTarget, typeTerm: payload.fieldTerm, isUnique: false, isParameter: false, ownsAtEntry: false, isBorrowed: isBorrowed, isCaptureCell: midBindingNeedsCaptureCell(c: c, sourceFunction: state.sourceFunction, bindingTarget: payload.bindTarget))
                    val destination: MidPlace = <MidPlace local=local typeTerm=payload.fieldTerm />
                    if isBorrowed {
                        if payload.isBoxed {
                            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.EnumPayloadBoxedBorrow place=scrutinee.place enumIndex=semantic.enumIndex variantIndex=semanticArm.variantIndex fieldIndex=payload.fieldIndex bindTarget=payload.bindTarget matchSource=matchSource resultTerm=payload.fieldTerm /> />)
                        } else {
                            midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.EnumPayloadBorrow place=scrutinee.place enumIndex=semantic.enumIndex variantIndex=semanticArm.variantIndex fieldIndex=payload.fieldIndex bindTarget=payload.bindTarget matchSource=matchSource resultTerm=payload.fieldTerm /> />)
                        }
                    } else if payload.isBoxed {
                        midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.EnumPayloadBoxedCopy place=scrutinee.place enumIndex=semantic.enumIndex variantIndex=semanticArm.variantIndex fieldIndex=payload.fieldIndex bindTarget=payload.bindTarget matchSource=matchSource resultTerm=payload.fieldTerm /> />)
                    } else {
                        midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=destination value=<MidRvalue.EnumPayloadCopy place=scrutinee.place enumIndex=semantic.enumIndex variantIndex=semanticArm.variantIndex fieldIndex=payload.fieldIndex bindTarget=payload.bindTarget matchSource=matchSource resultTerm=payload.fieldTerm /> />)
                    }
                    payloadIndex += 1U64
                }
                val sourceArm = c.matchArmAt(arms: sourceArms, index: armIndex)
                val armResult: MidBuildError = buildMidBlockInto(c: inout c, state: inout state, blockId: sourceArm.body, hasGiveDestination: hasGiveDestination, giveDestination: giveDestination)
                match armResult { MidBuildError.None => {} _ => { return armResult } }
                if midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
                    midEmitScopeExit(state: inout state, scope: armScope)
                    if hasScrutineeScope { midEmitScopeExit(state: inout state, scope: scrutineeScope) }
                    midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=joinTarget />)
                    joinReachable = true
                }
                midCloseScope(state: inout state, scope: armScope)
                state.bindings.truncate(count: bindingMark)
                armIndex += 1U64
            }
            if hasScrutineeScope { midCloseScope(state: inout state, scope: scrutineeScope) }
            state.currentBlock = joinTarget
            if !joinReachable {
                // Every arm diverges (for example, each returns). This join is
                // retained as the builder's post-statement cursor but has no
                // incoming edge, so it is semantically LLVM `unreachable`, not
                // an unterminated source return path.
                midSetTerminator(state: inout state, terminator: <MidTerminator.Unreachable />)
            }
            return <MidBuildError.None />
}

export fn buildMidMatch(c: inout Comp, state: inout MidBuildState, stmtId: U64) -> MidBuildError {
    if stmtId >= c.arena.stmts.count() { return <MidBuildError.InvalidStatement /> }
    match c.arena.stmts[stmtId] {
        Stmt.Match(scrut: val scrut, arms: val arms) => { return buildMidEnumMatch(c: inout c, state: inout state, matchSource: <MatchSource.Statement stmtId=stmtId />, scrut: scrut, sourceArms: arms, hasGiveDestination: false, giveDestination: <MidPlace local=0U64 typeTerm=0U64 />, traceId: stmtId) }
        _ => { return <MidBuildError.InvalidStatement /> }
    }
}

// Statement and value-position `if` have the same CFG: the only distinction
// is whether normal arm completion assigns a single result Place. Keeping the
// shape here avoids giving value `if` a legacy PHI/AST path that statement
// `if` does not have.
fn buildMidIfCfg(c: inout Comp, state: inout MidBuildState, cond: U64, thenBlk: U64, elseBlk: U64, hasElse: Bool, hasGiveDestination: Bool, giveDestination: MidPlace) -> MidBuildError {
    if state.currentBlock >= state.blocks.count() { return <MidBuildError.InvalidBlock /> }
    val condition: MidOperandBuild = materializeMidCondition(c: inout c, state: inout state, exprId: cond)
    match condition.error { MidBuildError.None => {} _ => { return condition.error } }
    if !midCurrentBlockIsOpen(state: state) { return <MidBuildError.None /> }
    val thenTarget: U64 = midNewBlock(state: inout state)
    val elseTarget: U64 = midNewBlock(state: inout state)
    val joinTarget: U64 = midNewBlock(state: inout state)
    midSetTerminator(state: inout state, terminator: <MidTerminator.Switch discriminant=condition.operand values=[1I64] targets=[thenTarget] otherwise=elseTarget />)
    state.currentBlock = thenTarget
    val thenResult: MidBuildError = buildMidBlockInto(c: inout c, state: inout state, blockId: thenBlk, hasGiveDestination: hasGiveDestination, giveDestination: giveDestination)
    match thenResult { MidBuildError.None => {} _ => { return thenResult } }
    if midCurrentBlockIsOpen(state: state) {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=joinTarget />)
    }
    state.currentBlock = elseTarget
    if hasElse {
        val elseResult: MidBuildError = buildMidBlockInto(c: inout c, state: inout state, blockId: elseBlk, hasGiveDestination: hasGiveDestination, giveDestination: giveDestination)
        match elseResult { MidBuildError.None => {} _ => { return elseResult } }
    }
    if midCurrentBlockIsOpen(state: state) {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=joinTarget />)
    }
    state.currentBlock = joinTarget
    // A retained post-if cursor with no incoming edge is real LLVM
    // `unreachable`, not an implicit source fallthrough. This covers return,
    // panic, and every future diverging terminator without syntax special
    // cases.
    if !midBlockHasIncoming(state: state, target: joinTarget) {
        midSetTerminator(state: inout state, terminator: <MidTerminator.Unreachable />)
    }
    return <MidBuildError.None />
}

// A statement `if` becomes a normal Switch plus then/else/join blocks. There
// is no conditional-move special case: a Move emitted by `buildMidLet` in one
// branch reaches the join through the same CFG used by every other statement.
export fn buildMidIf(c: inout Comp, state: inout MidBuildState, stmtId: U64) -> MidBuildError {
    if stmtId >= c.arena.stmts.count() { return <MidBuildError.InvalidStatement /> }
    match c.arena.stmts[stmtId] {
        Stmt.If(cond: val cond, thenBlk: val thenBlk, elseBlk: val elseBlk, hasElse: val hasElse) => {
            return buildMidIfCfg(c: inout c, state: inout state, cond: cond, thenBlk: thenBlk, elseBlk: elseBlk, hasElse: hasElse, hasGiveDestination: false, giveDestination: <MidPlace local=0U64 typeTerm=0U64 />)
        }
        _ => { return <MidBuildError.InvalidStatement /> }
    }
}

// A source `while` is the ordinary three-part CFG shape: enter a header,
// evaluate the condition on every visit, branch to its body or exit, and send
// only the body's normal fall-through back to the header.  In particular,
// there is no structured-loop terminator or LLVM-side AST recovery.  The body
// remains a lexical source block, so its existing ScopeExit is emitted before
// the backedge and drop elaboration can treat every iteration uniformly.
//
// `break` and `continue` need an explicit stack of lexical loop targets so
// they can emit every intervening ScopeExit; they remain separate unsupported
// statement forms until that full source-exit rule is introduced.
export fn buildMidWhile(c: inout Comp, state: inout MidBuildState, stmtId: U64) -> MidBuildError {
    if stmtId >= c.arena.stmts.count() { return <MidBuildError.InvalidStatement /> }
    match c.arena.stmts[stmtId] {
        Stmt.While(cond: val cond, body: val body) => {
            if state.currentBlock >= state.blocks.count() { return <MidBuildError.InvalidBlock /> }
            val headerTarget: U64 = midNewBlock(state: inout state)
            midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=headerTarget />)
            state.currentBlock = headerTarget
            val condition: MidOperandBuild = materializeMidCondition(c: inout c, state: inout state, exprId: cond)
            match condition.error { MidBuildError.None => {} _ => { return condition.error } }
            if !midCurrentBlockIsOpen(state: state) { return <MidBuildError.None /> }
            val bodyTarget: U64 = midNewBlock(state: inout state)
            val exitTarget: U64 = midNewBlock(state: inout state)
            if midOperandIsTrue(operand: condition.operand) {
                // A literal true has no false control edge. Keep the exit block
                // for an authored `break`, but do not invent an unreachable
                // Switch successor that later looks like source fallthrough.
                midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=bodyTarget />)
            } else {
                midSetTerminator(state: inout state, terminator: <MidTerminator.Switch discriminant=condition.operand values=[1I64] targets=[bodyTarget] otherwise=exitTarget />)
            }
            state.currentBlock = bodyTarget
            state.pushLoopTarget(breakTarget: exitTarget, continueTarget: headerTarget, enclosingScope: state.currentScope)
            val bodyResult: MidBuildError = buildMidBlock(c: inout c, state: inout state, blockId: body)
            state.popLoopTarget()
            match bodyResult { MidBuildError.None => {} _ => { return bodyResult } }
            if midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
                midSetTerminator(state: inout state, terminator: <MidTerminator.Goto target=headerTarget />)
            }
            state.currentBlock = exitTarget
            if !midBlockHasIncoming(state: state, target: exitTarget) {
                midSetTerminator(state: inout state, terminator: <MidTerminator.Unreachable />)
            }
            return <MidBuildError.None />
        }
        _ => { return <MidBuildError.InvalidStatement /> }
    }
}

fn midTermIsUnique(c: inout Comp, term: U64) -> Bool {
    if term >= c.arena.types.count() { return false }
    val t: TypeRef = c.arena.types[term]
    return c.typeIsUnique(start: t.nameStart, len: t.nameLen)
}

// A unique aggregate owns either its own nominal representation or one of
// its child slots. This is a property of the already typed construction, not
// a backend layout query; Mid uses it only to choose the result operand's
// ownership mode and temporary declaration.
fn midAggregateHasUniqueValue(c: inout Comp, aggregate: SemanticAggregate) -> Bool {
    if midTermIsUnique(c: inout c, term: aggregate.resultTerm) { return true }
    mut val i: U64 = 0U64
    while i < aggregate.elements.count() {
        if midTermIsUnique(c: inout c, term: aggregate.elements[i].term) { return true }
        i += 1U64
    }
    return false
}

// Build the parametric body once from the frozen frontend AST/semantic table.
// Parameters and receiver are represented by the same declaration identities
// used at identifier sites; only instantiateMidBody may subsequently ground
// their TypeTerms. This function intentionally does not install Cursor state.
export fn buildParametricMidBody(c: inout Comp, fnIdx: U64) -> MidBodyBuild {
    if fnIdx >= c.arena.funcs.count() {
        return <MidBodyBuild body=emptyMidBody(sourceFunction: fnIdx) error=<MidBuildError.InvalidFunction /> />
    }
    val f: Func = c.arena.funcs[fnIdx]
    // A Mid ABI local must have a frontend-resolved TypeTerm.  Synthetic
    // deinit walkers currently rely on the legacy receiver spelling path and
    // use the zero sentinel here; treating it as I64 would miscompile the
    // receiver.  Keep them out of Mid until their semantic receiver term is
    // published by the frontend.
    if f.hasRecv && f.recvTy == 0U64 {
        return <MidBodyBuild body=emptyMidBody(sourceFunction: fnIdx) error=<MidBuildError.InvalidFunction /> />
    }
    mut val state: MidBuildState = <MidBuildState.initial sourceFunction=fnIdx />
    if f.hasRecv {
        // `self` is the first ABI parameter exactly like an ordinary source
        // parameter.  An `inout fn` receiver is therefore a capability-bearing
        // place supplied by the caller, not a copied value or a special LLVM
        // side channel.  `midPrepareLocals` binds this declaration directly to
        // ABI parameter zero when `isInout` is true.
        val receiverLocal: U64 = addMidLocal(state: inout state, declarationTarget: identSelfTarget(), typeTerm: f.recvTy, isUnique: midTermIsUnique(c: inout c, term: f.recvTy), isParameter: true, ownsAtEntry: f.selfMove, isInout: f.selfInout, isCaptureCell: midBindingNeedsCaptureCell(c: c, sourceFunction: fnIdx, bindingTarget: identSelfTarget()))
    }
    mut val paramI: U64 = 0U64
    while paramI < f.params.count() {
        val param: Param = c.funcParamAt(params: f.params, index: paramI)
        val parameterLocal: U64 = addMidLocal(state: inout state, declarationTarget: param.nameStart, typeTerm: param.ty, isUnique: midTermIsUnique(c: inout c, term: param.ty), isParameter: true, ownsAtEntry: param.isMove, isInout: param.isInout, isCaptureCell: midBindingNeedsCaptureCell(c: c, sourceFunction: fnIdx, bindingTarget: param.nameStart))
        paramI += 1U64
    }
    // Scope zero is the lifetime of receiver/parameters only. Its range must
    // be sealed before body scope creation so a return can elaborate their
    // move-owned drops without swallowing function-local declarations.
    val root: MidScope = state.scopes[0U64]
    state.scopes.set(i: 0U64, value: <MidScope parent=root.parent firstLocal=root.firstLocal localCount=state.locals.count() - root.firstLocal />)
    // Do not put ABI result storage in root scope. It must survive all source
    // cleanup until the ReturnValue terminator transfers ownership to caller.
    if f.hasRet {
        val resultLocal: U64 = state.locals.count()
        state.locals.append(<MidLocalDecl typeTerm=f.retTy sourceScope=0U64 isUnique=midTermIsUnique(c: inout c, term: f.retTy) isParameter=false ownsAtEntry=false isDropFlag=false isReturnPlace=true sourceNameStart=0U64 />)
        state.hasReturnPlace = true
        state.returnPlace = resultLocal
        state.returnTypeTerm = f.retTy
    }
    val result: MidBuildError = buildMidBlock(c: inout c, state: inout state, blockId: f.body)
    match result {
        MidBuildError.None => {}
        _ => { return <MidBodyBuild body=<MidBody sourceFunction=fnIdx locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=result /> }
    }
    if midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
        if f.hasRet { return <MidBodyBuild body=<MidBody sourceFunction=fnIdx locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=<MidBuildError.MissingTerminator /> /> }
        midEmitScopeExit(state: inout state, scope: 0U64)
        midSetTerminator(state: inout state, terminator: <MidTerminator.Return />)
    }
    val body: MidBody = <MidBody sourceFunction=fnIdx locals=state.locals scopes=state.scopes blocks=state.blocks callArgumentProjections=state.callArgumentProjections entry=0U64 />
    val canonical: MidCanonicalBody = c.mid.store(body: body)
    if !c.mid.isWellFormed(body: canonical) {
        // A builder-produced canonical snapshot must be internally closed
        // before any downstream pass sees either representation.
        return <MidBodyBuild body=body canonical=canonical error=<MidBuildError.InvalidBlock /> />
    }
    return <MidBodyBuild body=body canonical=canonical />
}

// A closure body has the same parametric-to-grounded Mid path as a Func body,
// but its ABI is `(environment, source parameters...)`. The environment is not
// a source local: its fields are bound by the closure LLVM entry from the
// frozen capture range. Consequently this builder creates only the source
// parameter prefix and capture locals, all from SemanticClosure; it never
// re-matches Expr.Closure to recover a signature or body.
export fn buildParametricMidClosureBody(c: inout Comp, closure: SemanticClosure) -> MidBodyBuild {
    if closure.bodyKey == 0U64 || closure.bodyBlock >= c.arena.blocks.count() || closure.functionTypeTerm == 0U64 {
        return <MidBodyBuild body=emptyMidBody(sourceFunction: closure.bodyKey) error=<MidBuildError.InvalidFunction /> />
    }
    if closure.hasReturn && closure.returnTypeTerm == 0U64 {
        return <MidBodyBuild body=emptyMidBody(sourceFunction: closure.bodyKey) error=<MidBuildError.MissingSemanticType /> />
    }
    mut val state: MidBuildState = <MidBuildState.initial sourceFunction=closure.bodyKey />
    // Source parameters are the contiguous Mid ABI prefix. The closure LLVM
    // emitter adds its environment pointer before this prefix; representing it
    // as an ordinary Mid parameter would shift every source ABI index.
    mut val parameterI: U64 = 0U64
    while parameterI < closure.parameters.count() {
        val parameter = closure.parameters[parameterI]
        val parameterLocal: U64 = addMidLocal(state: inout state, declarationTarget: parameter.bindingTarget, typeTerm: parameter.typeTerm, isUnique: midTermIsUnique(c: inout c, term: parameter.typeTerm), isParameter: true, ownsAtEntry: parameter.isMove, isInout: parameter.isInout)
        parameterI += 1U64
    }
    // Environment entries are available for the activation but owned by the
    // closure environment. Value captures are borrowed values; cell captures
    // are writable logical places backed by an environment-owned cell. The
    // latter start logically live so overwrite emits the value Drop, while the
    // borrowed marker prevents scope exit from releasing the environment cell.
    mut val captureI: U64 = 0U64
    while captureI < closure.captures.count() {
        val capture = closure.captures[captureI]
        match capture.mode {
            SemanticClosureCaptureMode.ValueCopy => {
                val captureLocal: U64 = addMidLocal(state: inout state, declarationTarget: capture.bindingTarget, typeTerm: capture.typeTerm, isUnique: false, isParameter: false, ownsAtEntry: false, isBorrowed: true)
            }
            SemanticClosureCaptureMode.CellBorrow => {
                val captureLocal: U64 = addMidLocal(state: inout state, declarationTarget: capture.bindingTarget, typeTerm: capture.typeTerm, isUnique: false, isParameter: false, ownsAtEntry: true, isBorrowed: true, isCaptureCell: true)
            }
        }
        captureI += 1U64
    }
    // Root scope is exactly the ABI parameters plus the environment bindings;
    // body locals belong to the child scope opened by buildMidBlock.
    val root: MidScope = state.scopes[0U64]
    state.scopes.set(i: 0U64, value: <MidScope parent=root.parent firstLocal=root.firstLocal localCount=state.locals.count() - root.firstLocal />)
    if closure.hasReturn {
        val resultLocal: U64 = state.locals.count()
        state.locals.append(<MidLocalDecl typeTerm=closure.returnTypeTerm sourceScope=0U64 isUnique=midTermIsUnique(c: inout c, term: closure.returnTypeTerm) isParameter=false ownsAtEntry=false isDropFlag=false isReturnPlace=true sourceNameStart=0U64 />)
        state.hasReturnPlace = true
        state.returnPlace = resultLocal
        state.returnTypeTerm = closure.returnTypeTerm
    }
    val result: MidBuildError = buildMidBlock(c: inout c, state: inout state, blockId: closure.bodyBlock)
    match result {
        MidBuildError.None => {}
        _ => { return <MidBodyBuild body=<MidBody sourceFunction=closure.bodyKey locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=result /> }
    }
    if midTerminatorIsOpen(terminator: state.blocks[state.currentBlock].terminator) {
        if closure.hasReturn { return <MidBodyBuild body=<MidBody sourceFunction=closure.bodyKey locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=<MidBuildError.MissingTerminator /> /> }
        midEmitScopeExit(state: inout state, scope: 0U64)
        midSetTerminator(state: inout state, terminator: <MidTerminator.Return />)
    }
    val body: MidBody = <MidBody sourceFunction=closure.bodyKey locals=state.locals scopes=state.scopes blocks=state.blocks callArgumentProjections=state.callArgumentProjections entry=0U64 />
    val canonical: MidCanonicalBody = c.mid.store(body: body)
    if !c.mid.isWellFormed(body: canonical) {
        return <MidBodyBuild body=body canonical=canonical error=<MidBuildError.InvalidBlock /> />
    }
    return <MidBodyBuild body=body canonical=canonical />
}

// The semantic closure index is frontend-owned.  This adjacent Mid registry
// records only the one-way lowering boundary: a synthetic body key has one
// canonical parametric Mid body, shared by every closure value using it.
// Returning an empty draft for a cached entry is intentional: consumers must
// use its canonical ID and cannot accidentally reopen a mutable body.
export fn ensureParametricMidClosureBody(c: inout Comp, closure: SemanticClosure) -> MidBodyBuild {
    mut val i: U64 = 0U64
    while i < c.mid.closureBodies.count() {
        val prior: MidClosureBody = c.mid.closureBodies[i]
        if prior.bodyKey == closure.bodyKey {
            val canonical: MidCanonicalBody = <MidCanonicalBody body=prior.parametricBody />
            if !c.mid.isWellFormed(body: canonical) {
                return <MidBodyBuild body=emptyMidBody(sourceFunction: closure.bodyKey) canonical=canonical error=<MidBuildError.InvalidBlock /> />
            }
            return <MidBodyBuild body=emptyMidBody(sourceFunction: closure.bodyKey) canonical=canonical />
        }
        i += 1U64
    }
    val built: MidBodyBuild = buildParametricMidClosureBody(c: inout c, closure: closure)
    match built.error {
        MidBuildError.None => {}
        _ => { return built }
    }
    c.mid.closureBodies.append(<MidClosureBody bodyKey=closure.bodyKey parametricBody=built.canonical.body />)
    return built
}

// Module globals have one synthetic lexical body.  Their frontend facts use
// the same sentinel owner as Mono, so calls and aggregates remain keyed by
// their recorded source identity rather than being re-resolved from names.
// Each RHS first receives a normal temporary home.  InitializeGlobal then
// consumes that home exactly once into the process-lifetime root; it must not
// be confused with either local Assign or destructive Overwrite.
export fn buildParametricMidGlobalInit(c: inout Comp) -> MidBodyBuild {
    val globalOwner: U64 = 18446744073709551615U64
    mut val state: MidBuildState = <MidBuildState.initial sourceFunction=globalOwner />
    mut val globalI: U64 = 0U64
    while globalI < c.arena.globals.count() {
        val global = c.arena.globals[globalI]
        if global.letStmt >= c.arena.stmts.count() { return <MidBodyBuild body=<MidBody sourceFunction=globalOwner locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=<MidBuildError.InvalidStatement /> /> }
        match c.arena.stmts[global.letStmt] {
            Stmt.Let(nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init, mutable: _) => {
                val term: U64 = c.semanticExprTerm(exprId: init)
                if term == 0U64 { return <MidBodyBuild body=<MidBody sourceFunction=globalOwner locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=<MidBuildError.MissingSemanticType /> /> }
                val evaluation: U64 = midOpenScope(state: inout state)
                val temporaryLocal: U64 = addMidTemporary(state: inout state, typeTerm: term)
                val temporary: MidPlace = <MidPlace local=temporaryLocal typeTerm=term />
                mut val result: MidBuildError = <MidBuildError.None />
                if midExprIsCall(c: c, exprId: init) {
                    result = buildMidCallInto(c: inout c, state: inout state, exprId: init, destination: temporary)
                } else {
                    val aggregate: MidAggregateLookup = midSemanticAggregateForSourceBody(c: inout c, sourceFunction: state.sourceFunction, exprId: init)
                    mut val operand: MidOperandBuild = <MidOperandBuild operand=<MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=false typeTerm=term /> /> />
                    if aggregate.found { operand = materializeMidAggregateValue(c: inout c, state: inout state, aggregate: aggregate.aggregate) }
                    else { operand = midValueOperandForSourceExpr(c: inout c, state: inout state, exprId: init, typeTerm: term, allowAccessMarker: false) }
                    match operand.error {
                        MidBuildError.None => { midAppendStatement(state: inout state, statement: <MidStatement.Assign destination=temporary value=<MidRvalue.Use operand=operand.operand /> />) }
                        _ => { result = operand.error }
                    }
                }
                match result {
                    MidBuildError.None => {
                        val destination: MidPlace = <MidPlace rootTag=2U64 local=0U64 globalTarget=global.nameStart globalMutable=global.mutable typeTerm=term />
                        midAppendStatement(state: inout state, statement: <MidStatement.InitializeGlobal destination=destination source=temporary />)
                        midFinishEvaluationScope(state: inout state, scope: evaluation)
                    }
                    _ => { return <MidBodyBuild body=<MidBody sourceFunction=globalOwner locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=result /> }
                }
            }
            _ => { return <MidBodyBuild body=<MidBody sourceFunction=globalOwner locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 /> error=<MidBuildError.InvalidStatement /> /> }
        }
        globalI += 1U64
    }
    midEmitScopeExit(state: inout state, scope: 0U64)
    midSetTerminator(state: inout state, terminator: <MidTerminator.Return />)
    val body: MidBody = <MidBody sourceFunction=globalOwner locals=state.locals scopes=state.scopes blocks=state.blocks callArgumentProjections=state.callArgumentProjections entry=0U64 />
    val canonical: MidCanonicalBody = c.mid.store(body: body)
    if !c.mid.isWellFormed(body: canonical) { return <MidBodyBuild body=body canonical=canonical error=<MidBuildError.InvalidBlock /> /> }
    return <MidBodyBuild body=body canonical=canonical />
}
