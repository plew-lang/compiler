// Static global-storage tier of access checking. These summaries describe
// only direct Plew call edges and mutable global places, not purity or the
// absence of effects through closures, shared cells, drops or foreign code.
use ../Frontend only { Comp }
use ../Diag only { CompileDiagnostic }
use ../Ir only { CallTarget, ArcClass }
use ./Ir only { MidCanonicalBody }
use ./GlobalAccessGraph only { GlobalAccessGraph }
use ./Verify only { canonicalMidReachable }

// Record verified bodies once during the normal typed preparation pipeline.
// With no mutable globals this tier has no possible obligations.
pub fn registerMidGlobalAccessBody(c: inout Comp, canonical: MidCanonicalBody) {
    if c.mid.globalAccessState == 0U64 {
        c.mid.globalAccessState = 1U64
        mut val index = 0U64
        while index < c.arena.globals.count() {
            if c.arena.globals[index].mutable { c.mid.globalAccessState = 2U64 }
            index += 1U64
        }
    }
    if c.mid.globalAccessState == 2U64 { c.mid.globalAccessBodies.append(canonical.body) }
}

// Concrete destruction lookup belongs to the executable collector, not the
// shared graph or an anonymous impl outside the graph's defining module.
fn addFinalDestructionEdge(c: inout Comp, graph: inout GlobalAccessGraph, caller: U64, type: U64) -> Result[(), CompileDiagnostic] {
    if type == 0U64 { return <Result.Ok value=() /> }
    val contract = try c.checkedFinalDestruction(typeRef: type)
    graph.edge(caller: caller, callee: c.mid.globalAccessBodies.count() + contract - 1U64)
    return <Result.Ok value=() />
}

pub struct MidGlobalAccessAnalysis {
    pub val conflictingBody: U64 = 0U64
    pub val requiredBodies: Array[U64] = []
}

// Compatibility entry for the closed AOT pipeline. Partial callers must use
// the analysis result and close requiredBodies before granting execution.
pub fn conflictingMidGlobalAccess(c: inout Comp) -> Result[U64, CompileDiagnostic] {
    return <Result.Ok value=(try analyzeMidGlobalAccess(c: inout c)).conflictingBody />
}

// Called before any LLVM text is published.
// Each body is scanned once. New summary entries form a worklist propagated
// along reverse call edges, including recursive strongly connected bodies.
// Report definite conflicts separately from reachable, unprepared body IDs.
pub fn analyzeMidGlobalAccess(c: inout Comp) -> Result[MidGlobalAccessAnalysis, CompileDiagnostic] {
    if c.mid.globalAccessBodies.count() == 0U64 { return <Result.Ok value=<MidGlobalAccessAnalysis /> /> }
    mut val graph = <GlobalAccessGraph.empty />
    mut val missingBodies: Array[U64] = []
    mut val bodyMap: Array[U64] = []
    mut val index = 0U64
    while index <= c.arena.bodyInstanceCount() { bodyMap.append(0U64)
        index += 1U64 }
    index = 0U64
    while index < c.mid.globalAccessBodies.count() {
        val body = c.mid.bodies[c.mid.globalAccessBodies[index] - 1U64]
        graph.node()
        if body.bodyInstance != 0U64 { bodyMap.set(i: body.bodyInstance, value: index + 1U64) }
        index += 1U64
    }
    // Destruction is a graph node too. Recursive aggregate/cell ownership
    // closes by the same worklist as authored calls; no recursive unfolding.
    index = 0U64
    while index < c.arena.finalDestructions.count() {
        graph.node()
        index += 1U64
    }
    index = 0U64
    while index < c.arena.finalDestructions.count() {
        val contract = c.arena.finalDestructions[index]
        val owner = c.mid.globalAccessBodies.count() + index
        if contract.needsRelease {
            if contract.deinitCall.bodyId != 0U64 {
                if bodyMap[contract.deinitCall.bodyId] == 0U64 {
                    bodyMap[contract.deinitCall.bodyId] = graph.node() + 1U64
                    missingBodies.append(contract.deinitCall.bodyId)
                }
                graph.edge(caller: owner, callee: bodyMap[contract.deinitCall.bodyId] - 1U64)
            }
            if contract.underlying != 0U64 { try addFinalDestructionEdge(c: inout c, graph: inout graph, caller: owner, type: contract.underlying) }
            else {
                match contract.ownershipClass {
                    ArcClass.BufferLike(elem: val element) => { try addFinalDestructionEdge(c: inout c, graph: inout graph, caller: owner, type: element) }
                    ArcClass.RefCell(inst: val instance) => { try addFinalDestructionEdge(c: inout c, graph: inout graph, caller: owner, type: c.arena.typeAt(index: instance).args[0U64]) }
                    ArcClass.StructVal(sidx: _) => {
                        mut val field = 0U64
                        while field < contract.fieldTypes.count() { try addFinalDestructionEdge(c: inout c, graph: inout graph, caller: owner, type: contract.fieldTypes[field])
                            field += 1U64 }
                    }
                    ArcClass.EnumVal(eidx: _) => {
                        mut val field = 0U64
                        while field < contract.fieldTypes.count() { try addFinalDestructionEdge(c: inout c, graph: inout graph, caller: owner, type: contract.fieldTypes[field])
                            field += 1U64 }
                    }
                    // Erased targets retain dynamic checks; no absent static
                    // edge is interpreted as a proof of no effect.
                    _ => {}
                }
            }
        }
        index += 1U64
    }
    index = 0U64
    while index < c.mid.globalAccessBodies.count() {
        val body = c.mid.bodies[c.mid.globalAccessBodies[index] - 1U64]
        val reachable = canonicalMidReachable(arena: c.mid, body: body)
        mut val blockIndex = 0U64
        while blockIndex < body.blocks.len {
            if reachable[blockIndex] {
                val block = c.mid.blocks[body.blocks.start + blockIndex]
                mut val statementIndex = 0U64
                while statementIndex < block.statements.len {
                    val statement = c.mid.statements[block.statements.start + statementIndex]
                    graph.statement(arena: c.mid, body: index, statement: statement)
                    if statement.tag == 2U64 || statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
                        try addFinalDestructionEdge(c: inout c, graph: inout graph, caller: index, type: c.mid.places[statement.destination - 1U64].typeTerm)
                    }
                    statementIndex += 1U64
                }
                val term = c.mid.terminators[block.terminator - 1U64]
                graph.terminatorOperands(arena: c.mid, body: index, term: term)
                if term.tag == 4U64 {
                    val target = c.mid.callTargets[term.callTarget - 1U64]
                    val selected = c.arena.finalCalleeAt(index: target.resolution)
                    match selected.target {
                        CallTarget.Direct => {
                            // Foreign boundaries are accepted, never labelled
                            // pure. This graph has no edge to their absent body.
                            if selected.calleeBodyId != 0U64 && selected.calleeBodyId < bodyMap.count() {
                                if !c.arena.functionAt(index: selected.callee).isAsync {
                                    if bodyMap[selected.calleeBodyId] == 0U64 {
                                        bodyMap[selected.calleeBodyId] = graph.node() + 1U64
                                        missingBodies.append(selected.calleeBodyId)
                                    }
                                    graph.edge(caller: index, callee: bodyMap[selected.calleeBodyId] - 1U64, term: block.terminator)
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            blockIndex += 1U64
        }
        index += 1U64
    }
    val conflict = graph.solve(arena: c.mid)
    mut val required: Array[U64] = []
    if missingBodies.count() != 0U64 {
        val reachable = graph.reachableDependencies(rootCount: c.mid.globalAccessBodies.count())
        for body in missingBodies {
            if reachable[bodyMap[body] - 1U64] { required.append(body) }
        }
    }
    val canonical = if conflict == 0U64 { give 0U64 } else { give c.mid.globalAccessBodies[conflict - 1U64] }
    return <Result.Ok value=<MidGlobalAccessAnalysis conflictingBody=canonical requiredBodies=required /> />
}
