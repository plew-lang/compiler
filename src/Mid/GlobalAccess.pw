// Static global-storage tier of access checking. These summaries describe
// only direct Plew call edges and mutable global places, not purity or the
// absence of effects through closures, shared cells, drops or foreign code.
import ../Frontend with { Comp }
import ../Diag with { CompileDiagnostic }
import ../Ir with { CallTarget, ArcClass }
import ./Ir with { MidCanonicalBody }
import ./GlobalAccessGraph with { GlobalAccessGraph }
import ./Verify with { canonicalMidReachable }

// Record verified bodies once during the normal typed preparation pipeline.
// With no mutable globals this tier has no possible obligations.
pub fn registerMidGlobalAccessBody(c: inout Comp, canonical: MidCanonicalBody) {
    if c.mid.globalAccessState == 0U64 {
        c.mid.globalAccessState = 1U64
        mut val index = 0U64
        while index < c.arena.globals.count() {
            if c.arena.globals[index].mutable { c.mid.globalAccessState = 2U64 }
            index += 1U64
        }
    }
    if c.mid.globalAccessState == 2U64 { c.mid.globalAccessBodies.append(canonical.body) }
}

impl GlobalAccessGraph {
    inout fn destruction(c: inout Comp, caller: U64, type: U64) -> Result[(), CompileDiagnostic] {
        if type == 0U64 { return <Result.Ok value=() /> }
        val contract = try c.checkedFinalDestruction(typeRef: type)
        self.edge(caller: caller, callee: c.mid.globalAccessBodies.count() + contract - 1U64)
        return <Result.Ok value=() />
    }
}

// Called after body discovery closes, before any LLVM text is published.
// Each body is scanned once. New summary entries form a worklist propagated
// along reverse call edges, including recursive strongly connected bodies.
// Return the one-based canonical body containing a conflicting call, or zero.
pub fn conflictingMidGlobalAccess(c: inout Comp) -> Result[U64, CompileDiagnostic] {
    if c.mid.globalAccessBodies.count() == 0U64 { return <Result.Ok value=0U64 /> }
    mut val graph = <GlobalAccessGraph.empty />
    mut val bodyMap: Array[U64] = []
    mut val index = 0U64
    while index <= c.arena.bodyInstanceCount() { bodyMap.append(0U64)
        index += 1U64 }
    index = 0U64
    while index < c.mid.globalAccessBodies.count() {
        val body = c.mid.bodies[c.mid.globalAccessBodies[index] - 1U64]
        graph.node()
        if body.bodyInstance != 0U64 { bodyMap.set(i: body.bodyInstance, value: index + 1U64) }
        index += 1U64
    }
    // Destruction is a graph node too. Recursive aggregate/cell ownership
    // closes by the same worklist as authored calls; no recursive unfolding.
    index = 0U64
    while index < c.arena.finalDestructions.count() {
        graph.node()
        index += 1U64
    }
    index = 0U64
    while index < c.arena.finalDestructions.count() {
        val contract = c.arena.finalDestructions[index]
        val owner = c.mid.globalAccessBodies.count() + index
        if contract.needsRelease {
            if contract.deinitCall.bodyId != 0U64 {
                val callee = bodyMap[contract.deinitCall.bodyId]
                if callee != 0U64 { graph.edge(caller: owner, callee: callee - 1U64) }
            }
            if contract.underlying != 0U64 { try graph.destruction(c: inout c, caller: owner, type: contract.underlying) }
            else {
                match contract.ownershipClass {
                    ArcClass.BufferLike(elem: val element) => { try graph.destruction(c: inout c, caller: owner, type: element) }
                    ArcClass.RefCell(inst: val instance) => { try graph.destruction(c: inout c, caller: owner, type: c.arena.typeAt(index: instance).args[0U64]) }
                    ArcClass.StructVal(sidx: _) => {
                        mut val field = 0U64
                        while field < contract.fieldTypes.count() { try graph.destruction(c: inout c, caller: owner, type: contract.fieldTypes[field])
                            field += 1U64 }
                    }
                    ArcClass.EnumVal(eidx: _) => {
                        mut val field = 0U64
                        while field < contract.fieldTypes.count() { try graph.destruction(c: inout c, caller: owner, type: contract.fieldTypes[field])
                            field += 1U64 }
                    }
                    // Erased targets retain dynamic checks; no absent static
                    // edge is interpreted as a proof of no effect.
                    _ => {}
                }
            }
        }
        index += 1U64
    }
    index = 0U64
    while index < c.mid.globalAccessBodies.count() {
        val body = c.mid.bodies[c.mid.globalAccessBodies[index] - 1U64]
        val reachable = canonicalMidReachable(c: c, body: body)
        mut val blockIndex = 0U64
        while blockIndex < body.blocks.len {
            if reachable[blockIndex] {
                val block = c.mid.blocks[body.blocks.start + blockIndex]
                mut val statementIndex = 0U64
                while statementIndex < block.statements.len {
                    val statement = c.mid.statements[block.statements.start + statementIndex]
                    mut val destinationIndex = 0U64
                    while destinationIndex < statement.destinationCount() {
                        graph.add(c: c, body: index, place: c.mid.statementDestinationAt(statement: statement, index: destinationIndex), writes: true)
                        destinationIndex += 1U64
                    }
                    graph.add(c: c, body: index, place: statement.source, writes: false)
                    if statement.value != 0U64 {
                        val value = c.mid.rvalues[statement.value - 1U64]
                        graph.add(c: c, body: index, place: value.place, writes: false)
                        mut val operandIndex = 0U64
                        while operandIndex < value.operandCount() {
                            graph.operand(c: c, body: index, operandId: c.mid.rvalueOperandAt(value: value, index: operandIndex))
                            operandIndex += 1U64
                        }
                    }
                    if statement.tag == 2U64 || statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
                        try graph.destruction(c: inout c, caller: index, type: c.mid.places[statement.destination - 1U64].typeTerm)
                    }
                    statementIndex += 1U64
                }
                val term = c.mid.terminators[block.terminator - 1U64]
                mut val operandIndex = 0U64
                while operandIndex < c.mid.terminatorOperandCount(term: term) {
                    graph.operand(c: c, body: index, operandId: c.mid.terminatorOperandAt(term: term, index: operandIndex))
                    operandIndex += 1U64
                }
                if term.tag == 4U64 {
                    val target = c.mid.callTargets[term.callTarget - 1U64]
                    val selected = c.arena.finalCallees[target.resolution]
                    match selected.target {
                        CallTarget.Direct => {
                            // Foreign boundaries are accepted, never labelled
                            // pure. This graph has no edge to their absent body.
                            if selected.calleeBodyId != 0U64 && selected.calleeBodyId < bodyMap.count() {
                                val callee = bodyMap[selected.calleeBodyId]
                                if callee != 0U64 && !c.arena.functionAt(index: selected.callee).isAsync {
                                    graph.edge(caller: index, callee: callee - 1U64, term: block.terminator)
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            blockIndex += 1U64
        }
        index += 1U64
    }
    val conflict = graph.solve(c: c)
    if conflict != 0U64 { return <Result.Ok value=c.mid.globalAccessBodies[conflict - 1U64] /> }
    return <Result.Ok value=0U64 />
}
