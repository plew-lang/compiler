// Ownership dataflow for Mid IR. This module deliberately imports only Mid/Ir:
// it cannot inspect AST, recover a type, or emit LLVM. Build creates operations;
// this pass computes their ownership consequences for drop elaboration and the
// always-on verifier.

import ../Frontend with { Comp }
import ./Ir with { MidRange, MidBodyNode, MidBlockNode, MidPlaceNode, MidOperandNode, MidRvalueNode, MidAggregateElementNode, MidStatementNode, MidTerminatorNode, MidSwitchCase, MidCallReceiverNode, MidCanonicalBody, MidPlace, MidProjection, MidOperand, MidAggregateElement, MidRvalue, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody, MidOwnership, MidAccessibility }

fn canonicalMidConsumeOperand(c: Comp, states: inout Array[MidOwnership], operandId: U64) {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return }
    val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
    if operand.tag != 2U64 || operand.place == 0U64 || operand.place > c.mid.places.count() { return }
    val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
    if place.projections.len == 0U64 && place.local < states.count() {
        states.set(i: place.local, value: <MidOwnership.Consumed />)
    }
}

fn canonicalMidConsumeRvalue(c: Comp, states: inout Array[MidOwnership], rvalueId: U64) {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return }
    val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    if value.operand != 0U64 { canonicalMidConsumeOperand(c: c, states: inout states, operandId: value.operand) }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            val element: MidAggregateElementNode = c.mid.aggregateElements[value.elements.start + elementI]
            canonicalMidConsumeOperand(c: c, states: inout states, operandId: element.operand)
            elementI = elementI + 1U64
        }
    }
}

fn canonicalMidTransferBlock(c: Comp, body: MidBodyNode, block: MidBlockNode, input: Array[MidOwnership]) -> Array[MidOwnership] {
    mut val out: Array[MidOwnership] = input
    mut val statementI: U64 = 0U64
    while statementI < block.statements.len {
        val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
        if statement.tag == 1U64 {
            canonicalMidConsumeRvalue(c: c, states: inout out, rvalueId: statement.value)
            if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local < out.count() && destination.local < body.locals.len && !c.mid.locals[body.locals.start + destination.local].isBorrowed { out.set(i: destination.local, value: <MidOwnership.Owned />) }
            }
        }
        if statement.tag == 2U64 {
            if statement.source != 0U64 && statement.source <= c.mid.places.count() {
                val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
                if source.projections.len == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidOwnership.Consumed />) }
            }
            if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidOwnership.Owned />) }
            }
        }
        if statement.tag == 3U64 || statement.tag == 4U64 {
            if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if place.projections.len == 0U64 && place.local < out.count() { out.set(i: place.local, value: <MidOwnership.Consumed />) }
            }
        }
        if statement.tag == 6U64 && statement.scope < body.scopes.len {
            val scope: MidScope = c.mid.scopes[body.scopes.start + statement.scope]
            mut val local: U64 = scope.firstLocal
            while local < scope.firstLocal + scope.localCount && local < out.count() {
                out.set(i: local, value: <MidOwnership.Consumed />)
                local = local + 1U64
            }
        }
        statementI = statementI + 1U64
    }
    if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return out }
    val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
    if term.discriminant != 0U64 { canonicalMidConsumeOperand(c: c, states: inout out, operandId: term.discriminant) }
    if term.value != 0U64 { canonicalMidConsumeOperand(c: c, states: inout out, operandId: term.value) }
    if term.tag == 4U64 {
        if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
            canonicalMidConsumeOperand(c: c, states: inout out, operandId: c.mid.callReceivers[term.callReceiver - 1U64].operand)
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            canonicalMidConsumeOperand(c: c, states: inout out, operandId: c.mid.callArguments[term.args.start + argumentI])
            argumentI = argumentI + 1U64
        }
        if term.destination != 0U64 && term.destination <= c.mid.places.count() {
            val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
            if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidOwnership.Owned />) }
        }
    }
    return out
}

fn canonicalMidSuccessors(c: Comp, term: MidTerminatorNode) -> Array[U64] {
    if term.tag == 2U64 { return [term.target] }
    if term.tag == 4U64 { return [term.target] }
    if term.tag == 10U64 { return [term.resume] }
    if term.tag == 3U64 {
        mut val out: Array[U64] = []
        mut val caseI: U64 = 0U64
        while caseI < term.cases.len {
            out.append(c.mid.switchCases[term.cases.start + caseI].target)
            caseI = caseI + 1U64
        }
        out.append(term.otherwise)
        return out
    }
    return []
}

// Canonical ownership analysis consumes only scalar rows/ranges. Its nested
// Arrays are transient fixed-point work state, never a body representation.
export fn analyzeCanonicalMidOwnership(c: Comp, canonical: MidCanonicalBody) -> Array[Array[MidOwnership]] {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return [] }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val incoming: Array[Array[MidOwnership]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidOwnership] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        if c.mid.locals[body.locals.start + localI].ownsAtEntry { initial.append(<MidOwnership.Owned />) } else { initial.append(<MidOwnership.Consumed />) }
        localI = localI + 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val empty: Array[MidOwnership] = []
        localI = 0U64
        while localI < body.locals.len {
            empty.append(<MidOwnership.Consumed />)
            localI = localI + 1U64
        }
        incoming.append(empty)
        reachable.append(false)
        blockI = blockI + 1U64
    }
    if body.entry >= body.blocks.len { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    mut val changed: Bool = true
    while changed {
        changed = false
        blockI = 0U64
        while blockI < body.blocks.len {
            if reachable[blockI] {
                val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
                val out: Array[MidOwnership] = canonicalMidTransferBlock(c: c, body: body, block: block, input: incoming[blockI])
                if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
                    val successors: Array[U64] = canonicalMidSuccessors(c: c, term: c.mid.terminators[block.terminator - 1U64])
                    mut val successorI: U64 = 0U64
                    while successorI < successors.count() {
                        val successor: U64 = successors[successorI]
                        if successor < body.blocks.len {
                            if !reachable[successor] {
                                incoming.set(i: successor, value: out)
                                reachable.set(i: successor, value: true)
                                changed = true
                            } else {
                                val before: Array[MidOwnership] = incoming[successor]
                                mut val merged: Array[MidOwnership] = []
                                localI = 0U64
                                while localI < before.count() {
                                    merged.append(midOwnershipJoin(left: before[localI], right: out[localI]))
                                    localI = localI + 1U64
                                }
                                if midOwnershipStateChanged(before: before, after: merged) {
                                    incoming.set(i: successor, value: merged)
                                    changed = true
                                }
                            }
                        }
                        successorI = successorI + 1U64
                    }
                }
            }
            blockI = blockI + 1U64
        }
    }
    return incoming
}

fn canonicalMidMakeOperandUnavailable(c: Comp, states: inout Array[MidAccessibility], operandId: U64) {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return }
    val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
    if operand.tag == 2U64 && operand.place != 0U64 && operand.place <= c.mid.places.count() {
        val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
        if place.projections.len == 0U64 && place.local < states.count() { states.set(i: place.local, value: <MidAccessibility.Unavailable />) }
    }
}

fn canonicalMidMakeRvalueUnavailable(c: Comp, states: inout Array[MidAccessibility], rvalueId: U64) {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return }
    val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    if value.operand != 0U64 { canonicalMidMakeOperandUnavailable(c: c, states: inout states, operandId: value.operand) }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            canonicalMidMakeOperandUnavailable(c: c, states: inout states, operandId: c.mid.aggregateElements[value.elements.start + elementI].operand)
            elementI = elementI + 1U64
        }
    }
}

fn canonicalMidAccessibilityTransfer(c: Comp, body: MidBodyNode, block: MidBlockNode, input: Array[MidAccessibility]) -> Array[MidAccessibility] {
    mut val out: Array[MidAccessibility] = input
    mut val statementI: U64 = 0U64
    while statementI < block.statements.len {
        val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
        if statement.tag == 1U64 {
            canonicalMidMakeRvalueUnavailable(c: c, states: inout out, rvalueId: statement.value)
            if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if place.projections.len == 0U64 && place.local < out.count() { out.set(i: place.local, value: <MidAccessibility.Available />) }
            }
        }
        if statement.tag == 2U64 {
            if statement.source != 0U64 && statement.source <= c.mid.places.count() {
                val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
                if source.projections.len == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidAccessibility.Unavailable />) }
            }
            if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidAccessibility.Available />) }
            }
        }
        if statement.tag == 3U64 || statement.tag == 4U64 {
            if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if place.projections.len == 0U64 && place.local < out.count() { out.set(i: place.local, value: <MidAccessibility.Unavailable />) }
            }
        }
        if statement.tag == 6U64 && statement.scope < body.scopes.len {
            val scope: MidScope = c.mid.scopes[body.scopes.start + statement.scope]
            mut val local: U64 = scope.firstLocal
            while local < scope.firstLocal + scope.localCount && local < out.count() {
                out.set(i: local, value: <MidAccessibility.Unavailable />)
                local = local + 1U64
            }
        }
        statementI = statementI + 1U64
    }
    if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return out }
    val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
    if term.discriminant != 0U64 { canonicalMidMakeOperandUnavailable(c: c, states: inout out, operandId: term.discriminant) }
    if term.value != 0U64 { canonicalMidMakeOperandUnavailable(c: c, states: inout out, operandId: term.value) }
    if term.tag == 4U64 {
        if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() { canonicalMidMakeOperandUnavailable(c: c, states: inout out, operandId: c.mid.callReceivers[term.callReceiver - 1U64].operand) }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            canonicalMidMakeOperandUnavailable(c: c, states: inout out, operandId: c.mid.callArguments[term.args.start + argumentI])
            argumentI = argumentI + 1U64
        }
        if term.destination != 0U64 && term.destination <= c.mid.places.count() {
            val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
            if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidAccessibility.Available />) }
        }
    }
    return out
}

export fn analyzeCanonicalMidAccessibility(c: Comp, canonical: MidCanonicalBody) -> Array[Array[MidAccessibility]] {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return [] }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val incoming: Array[Array[MidAccessibility]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidAccessibility] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        if c.mid.locals[body.locals.start + localI].ownsAtEntry { initial.append(<MidAccessibility.Available />) } else { initial.append(<MidAccessibility.Unavailable />) }
        localI = localI + 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val empty: Array[MidAccessibility] = []
        localI = 0U64
        while localI < body.locals.len {
            empty.append(<MidAccessibility.Unavailable />)
            localI = localI + 1U64
        }
        incoming.append(empty)
        reachable.append(false)
        blockI = blockI + 1U64
    }
    if body.entry >= body.blocks.len { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    mut val changed: Bool = true
    while changed {
        changed = false
        blockI = 0U64
        while blockI < body.blocks.len {
            if reachable[blockI] {
                val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
                val out: Array[MidAccessibility] = canonicalMidAccessibilityTransfer(c: c, body: body, block: block, input: incoming[blockI])
                if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
                    val successors: Array[U64] = canonicalMidSuccessors(c: c, term: c.mid.terminators[block.terminator - 1U64])
                    mut val successorI: U64 = 0U64
                    while successorI < successors.count() {
                        val successor: U64 = successors[successorI]
                        if successor < body.blocks.len {
                            if !reachable[successor] {
                                incoming.set(i: successor, value: out)
                                reachable.set(i: successor, value: true)
                                changed = true
                            } else {
                                val before: Array[MidAccessibility] = incoming[successor]
                                mut val merged: Array[MidAccessibility] = []
                                localI = 0U64
                                while localI < before.count() {
                                    merged.append(midAccessibilityJoin(left: before[localI], right: out[localI]))
                                    localI = localI + 1U64
                                }
                                if midAccessibilityStateChanged(before: before, after: merged) {
                                    incoming.set(i: successor, value: merged)
                                    changed = true
                                }
                            }
                        }
                        successorI = successorI + 1U64
                    }
                }
            }
            blockI = blockI + 1U64
        }
    }
    return incoming
}

fn canonicalMidIsAccessibilityCliff(c: Comp, canonical: MidCanonicalBody, ownership: Array[Array[MidOwnership]], accessibility: Array[Array[MidAccessibility]], blockI: U64, local: U64) -> Bool {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return false }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    if blockI >= body.blocks.len || blockI >= ownership.count() || blockI >= accessibility.count() || local >= ownership[blockI].count() || local >= accessibility[blockI].count() { return false }
    match ownership[blockI][local] { MidOwnership.MaybeOwned => {} _ => { return false } }
    match accessibility[blockI][local] { MidAccessibility.Unavailable => {} _ => { return false } }
    if blockI == body.entry { return true }
    mut val sawPredecessor: Bool = false
    mut val predecessor: U64 = 0U64
    while predecessor < body.blocks.len {
        val source: MidBlockNode = c.mid.blocks[body.blocks.start + predecessor]
        if source.terminator != 0U64 && source.terminator <= c.mid.terminators.count() {
            val successors: Array[U64] = canonicalMidSuccessors(c: c, term: c.mid.terminators[source.terminator - 1U64])
            mut val successorI: U64 = 0U64
            while successorI < successors.count() {
                if successors[successorI] == blockI {
                    sawPredecessor = true
                    val predecessorOwnership: Array[MidOwnership] = canonicalMidTransferBlock(c: c, body: body, block: source, input: ownership[predecessor])
                    val predecessorAccessibility: Array[MidAccessibility] = canonicalMidAccessibilityTransfer(c: c, body: body, block: source, input: accessibility[predecessor])
                    if local >= predecessorOwnership.count() || local >= predecessorAccessibility.count() { return false }
                    match predecessorOwnership[local] {
                        MidOwnership.MaybeOwned => {
                            match predecessorAccessibility[local] { MidAccessibility.Unavailable => {} _ => { return true } }
                        }
                        _ => { return true }
                    }
                }
                successorI = successorI + 1U64
            }
        }
        predecessor = predecessor + 1U64
    }
    return !sawPredecessor
}

// Planning is deliberately separate from row emission: a flag exists only
// when conditional ownership reaches a cliff or scope cleanup.  The arrays
// are pass-local analysis state, not part of the canonical body schema.
struct MidCanonicalDropPlan {
    pub val needsFlag: Array[Bool] = []
    pub val cliffAtEntry: Array[Array[Bool]] = []
}
pub impl MidCanonicalDropPlan { factory }

fn canonicalMidDropPlan(c: Comp, canonical: MidCanonicalBody, ownership: Array[Array[MidOwnership]], accessibility: Array[Array[MidAccessibility]]) -> MidCanonicalDropPlan {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidCanonicalDropPlan /> }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val needsFlag: Array[Bool] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        needsFlag.append(false)
        localI = localI + 1U64
    }
    mut val cliffs: Array[Array[Bool]] = []
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val blockCliffs: Array[Bool] = []
        localI = 0U64
        while localI < body.locals.len {
            val cliff: Bool = canonicalMidIsAccessibilityCliff(c: c, canonical: canonical, ownership: ownership, accessibility: accessibility, blockI: blockI, local: localI)
            blockCliffs.append(cliff)
            if blockI < ownership.count() && blockI < accessibility.count() && localI < ownership[blockI].count() && localI < accessibility[blockI].count() {
                match ownership[blockI][localI] {
                    MidOwnership.MaybeOwned => {
                        match accessibility[blockI][localI] { MidAccessibility.Unavailable => { needsFlag.set(i: localI, value: true) } _ => {} }
                    }
                    _ => {}
                }
            }
            localI = localI + 1U64
        }
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
            if statement.tag == 6U64 && statement.scope < body.scopes.len && blockI < ownership.count() {
                val scope: MidScope = c.mid.scopes[body.scopes.start + statement.scope]
                localI = scope.firstLocal
                while localI < scope.firstLocal + scope.localCount && localI < body.locals.len && localI < ownership[blockI].count() {
                    match ownership[blockI][localI] { MidOwnership.MaybeOwned => { needsFlag.set(i: localI, value: true) } _ => {} }
                    localI = localI + 1U64
                }
            }
            statementI = statementI + 1U64
        }
        cliffs.append(blockCliffs)
        blockI = blockI + 1U64
    }
    return <MidCanonicalDropPlan needsFlag=needsFlag cliffAtEntry=cliffs />
}

fn midScopeFirst(body: MidBody, scope: U64) -> U64 {
    if scope >= body.scopes.count() { return body.locals.count() }
    return body.scopes[scope].firstLocal
}

fn midScopeEnd(body: MidBody, scope: U64) -> U64 {
    if scope >= body.scopes.count() { return body.locals.count() }
    val definition: MidScope = body.scopes[scope]
    return definition.firstLocal + definition.localCount
}

// The join for an affine root local. Once paths disagree, later joins cannot
// recover a single state without a new dominating Assign, which transfer handles
// before propagating to successors.
fn midOwnershipJoin(left: MidOwnership, right: MidOwnership) -> MidOwnership {
    match left {
        MidOwnership.Owned => {
            match right {
                MidOwnership.Owned => { return <MidOwnership.Owned /> }
                _ => { return <MidOwnership.MaybeOwned /> }
            }
        }
        MidOwnership.Consumed => {
            match right {
                MidOwnership.Consumed => { return <MidOwnership.Consumed /> }
                _ => { return <MidOwnership.MaybeOwned /> }
            }
        }
        MidOwnership.MaybeOwned => { return <MidOwnership.MaybeOwned /> }
    }
}

fn midOwnershipStateChanged(before: Array[MidOwnership], after: Array[MidOwnership]) -> Bool {
    if before.count() != after.count() { return true }
    mut val i: U64 = 0U64
    while i < before.count() {
        match before[i] {
            MidOwnership.Owned => {
                match after[i] { MidOwnership.Owned => {} _ => { return true } }
            }
            MidOwnership.Consumed => {
                match after[i] { MidOwnership.Consumed => {} _ => { return true } }
            }
            MidOwnership.MaybeOwned => {
                match after[i] { MidOwnership.MaybeOwned => {} _ => { return true } }
            }
        }
        i += 1U64
    }
    return false
}

fn midConsumeOperand(states: inout Array[MidOwnership], operand: MidOperand) {
    match operand {
        MidOperand.Move(place: val place) => {
            // v1 has no partial unique move. Keeping the projection test here
            // makes a malformed Mid body fail its later verifier rather than
            // silently treating a field move as a root consume.
            if place.projections.count() == 0U64 {
                if place.local < states.count() {
                    states.set(i: place.local, value: <MidOwnership.Consumed />)
                }
            }
        }
        _ => {}
    }
}

fn midConsumeRvalue(states: inout Array[MidOwnership], value: MidRvalue) {
    match value {
        MidRvalue.Use(operand: val operand) => { midConsumeOperand(states: inout states, operand: operand) }
        MidRvalue.ReturnBoundary(exprId: _, targetTerm: _, operand: val operand) => { midConsumeOperand(states: inout states, operand: operand) }
        MidRvalue.Aggregate(exprId: _, kind: _, resultTerm: _, fieldCount: _, elements: val elements) => {
            mut val i: U64 = 0U64
            while i < elements.count() {
                midConsumeOperand(states: inout states, operand: elements[i].operand)
                i += 1U64
            }
        }
        MidRvalue.Convert(operand: val operand, conversion: _) => { midConsumeOperand(states: inout states, operand: operand) }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: _, operand: val operand) => { midConsumeOperand(states: inout states, operand: operand) }
        MidRvalue.Cast(operand: val operand, kind: _, targetTerm: _) => { midConsumeOperand(states: inout states, operand: operand) }
        MidRvalue.EnumTag(place: _, enumIndex: _, sourceStmt: _, resultTerm: _) => {}
        MidRvalue.EnumPayloadCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
        MidRvalue.EnumPayloadBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
        MidRvalue.EnumPayloadBoxedCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
        MidRvalue.EnumPayloadBoxedBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
    }
}

fn midConsumeReceiver(states: inout Array[MidOwnership], receiver: MidCallReceiver) {
    match receiver { MidCallReceiver.Value(operand: val operand) => { midConsumeOperand(states: inout states, operand: operand) } _ => {} }
}

// Transfer a single block. Drop/Assign are consumes/producers; all call/return
// arguments are evaluated before the terminator edge and therefore consume their
// Move operands in this block's outgoing state.
fn midTransferBlock(body: MidBody, block: MidBlock, input: Array[MidOwnership]) -> Array[MidOwnership] {
    mut val out: Array[MidOwnership] = input
    mut val si: U64 = 0U64
    while si < block.statements.count() {
        match block.statements[si] {
            MidStatement.Assign(destination: val destination, value: val value) => {
                midConsumeRvalue(states: inout out, value: value)
                if destination.projections.count() == 0U64 && destination.local < out.count() && !(body.locals[destination.local].isBorrowed) {
                    out.set(i: destination.local, value: <MidOwnership.Owned />)
                }
            }
            MidStatement.Overwrite(destination: val destination, source: val source) => {
                if source.projections.count() == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidOwnership.Consumed />) }
                if destination.projections.count() == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidOwnership.Owned />) }
            }
            MidStatement.Drop(place: val place) => {
                if place.projections.count() == 0U64 && place.local < out.count() {
                    out.set(i: place.local, value: <MidOwnership.Consumed />)
                }
            }
            MidStatement.ConditionalDrop(place: val place, flag: _) => {
                if place.projections.count() == 0U64 && place.local < out.count() {
                    // True drops the value; false proves an earlier Move. Either
                    // way no source owner remains after this operation.
                    out.set(i: place.local, value: <MidOwnership.Consumed />)
                }
            }
            MidStatement.ScopeExit(scope: val scope) => {
                mut val local: U64 = midScopeFirst(body: body, scope: scope)
                val end: U64 = midScopeEnd(body: body, scope: scope)
                while local < end && local < out.count() {
                    out.set(i: local, value: <MidOwnership.Consumed />)
                    local += 1U64
                }
            }
            _ => {}
        }
        si += 1U64
    }
    match block.terminator {
        MidTerminator.Switch(discriminant: val discriminant, values: _, targets: _, otherwise: _) => {
            midConsumeOperand(states: inout out, operand: discriminant)
        }
        MidTerminator.Call(callee: _, receiver: val receiver, args: val args, destination: val destination, target: _) => {
            midConsumeReceiver(states: inout out, receiver: receiver)
            mut val ai: U64 = 0U64
            while ai < args.count() {
                midConsumeOperand(states: inout out, operand: args[ai])
                ai += 1U64
            }
            // A normal-returning call writes one owned result into its destination.
            // Void calls use a compiler-generated unit place, which is harmlessly
            // marked Owned and never needs a Drop.
            if destination.projections.count() == 0U64 && destination.local < out.count() {
                out.set(i: destination.local, value: <MidOwnership.Owned />)
            }
        }
        MidTerminator.ReturnValue(value: val value) => {
            midConsumeOperand(states: inout out, operand: value)
        }
        MidTerminator.Panic(message: val message) => { midConsumeOperand(states: inout out, operand: message) }
        _ => {}
    }
    return out
}

export fn midSuccessors(term: MidTerminator) -> Array[U64] {
    match term {
        MidTerminator.Goto(target: val target) => { return [target] }
        MidTerminator.Switch(discriminant: _, values: _, targets: val targets, otherwise: val otherwise) => {
            mut val out: Array[U64] = targets
            out.append(otherwise)
            return out
        }
        MidTerminator.Call(callee: _, receiver: _, args: _, destination: _, target: val target) => { return [target] }
        MidTerminator.Suspend(state: _, resume: val resume) => { return [resume] }
        _ => { return [] }
    }
}

// Forward fixed point over flat CFG. Result[i] is the incoming state of block i;
// an unreachable block remains all-Consumed. The separate `reachable` array is
// kept internal because the verifier distinguishes an unreachable block from a
// reachable block whose every local is consumed.
export fn analyzeMidOwnership(body: MidBody) -> Array[Array[MidOwnership]] {
    mut val incoming: Array[Array[MidOwnership]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidOwnership] = []
    mut val li: U64 = 0U64
    while li < body.locals.count() {
        if body.locals[li].ownsAtEntry {
            initial.append(<MidOwnership.Owned />)
        } else {
            initial.append(<MidOwnership.Consumed />)
        }
        li += 1U64
    }
    mut val bi: U64 = 0U64
    while bi < body.blocks.count() {
        mut val empty: Array[MidOwnership] = []
        mut val ei: U64 = 0U64
        while ei < body.locals.count() {
            empty.append(<MidOwnership.Consumed />)
            ei += 1U64
        }
        incoming.append(empty)
        reachable.append(false)
        bi += 1U64
    }
    if body.entry >= body.blocks.count() { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    mut val changed: Bool = true
    while changed {
        changed = false
        bi = 0U64
        while bi < body.blocks.count() {
            if reachable[bi] {
                val out: Array[MidOwnership] = midTransferBlock(body: body, block: body.blocks[bi], input: incoming[bi])
                val successors: Array[U64] = midSuccessors(term: body.blocks[bi].terminator)
                mut val si: U64 = 0U64
                while si < successors.count() {
                    val successor: U64 = successors[si]
                    if successor < body.blocks.count() {
                        if !(reachable[successor]) {
                            incoming.set(i: successor, value: out)
                            reachable.set(i: successor, value: true)
                            changed = true
                        } else {
                            val before: Array[MidOwnership] = incoming[successor]
                            mut val merged: Array[MidOwnership] = []
                            mut val mi: U64 = 0U64
                            while mi < before.count() {
                                merged.append(midOwnershipJoin(left: before[mi], right: out[mi]))
                                mi += 1U64
                            }
                            if midOwnershipStateChanged(before: before, after: merged) {
                                incoming.set(i: successor, value: merged)
                                changed = true
                            }
                        }
                    }
                    si += 1U64
                }
            }
            bi += 1U64
        }
    }
    return incoming
}

fn midAccessibilityJoin(left: MidAccessibility, right: MidAccessibility) -> MidAccessibility {
    match left {
        MidAccessibility.Available => {
            match right {
                MidAccessibility.Available => { return <MidAccessibility.Available /> }
                _ => { return <MidAccessibility.Unavailable /> }
            }
        }
        MidAccessibility.Unavailable => { return <MidAccessibility.Unavailable /> }
    }
}

fn midAccessibilityStateChanged(before: Array[MidAccessibility], after: Array[MidAccessibility]) -> Bool {
    if before.count() != after.count() { return true }
    mut val i: U64 = 0U64
    while i < before.count() {
        match before[i] {
            MidAccessibility.Available => {
                match after[i] { MidAccessibility.Available => {} _ => { return true } }
            }
            MidAccessibility.Unavailable => {
                match after[i] { MidAccessibility.Unavailable => {} _ => { return true } }
            }
        }
        i += 1U64
    }
    return false
}

fn midMakeOperandUnavailable(states: inout Array[MidAccessibility], operand: MidOperand) {
    match operand {
        MidOperand.Move(place: val place) => {
            if place.projections.count() == 0U64 && place.local < states.count() {
                states.set(i: place.local, value: <MidAccessibility.Unavailable />)
            }
        }
        _ => {}
    }
}

fn midAccessibilityTransfer(body: MidBody, block: MidBlock, input: Array[MidAccessibility]) -> Array[MidAccessibility] {
    mut val out: Array[MidAccessibility] = input
    mut val si: U64 = 0U64
    while si < block.statements.count() {
        match block.statements[si] {
            MidStatement.Assign(destination: val destination, value: val value) => {
                match value {
                    MidRvalue.Use(operand: val operand) => { midMakeOperandUnavailable(states: inout out, operand: operand) }
                    MidRvalue.ReturnBoundary(exprId: _, targetTerm: _, operand: val operand) => { midMakeOperandUnavailable(states: inout out, operand: operand) }
                    MidRvalue.Aggregate(exprId: _, kind: _, resultTerm: _, fieldCount: _, elements: val elements) => {
                        mut val element: U64 = 0U64
                        while element < elements.count() {
                            midMakeOperandUnavailable(states: inout out, operand: elements[element].operand)
                            element += 1U64
                        }
                    }
        MidRvalue.Convert(operand: val operand, conversion: _) => { midMakeOperandUnavailable(states: inout out, operand: operand) }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: _, operand: val operand) => { midMakeOperandUnavailable(states: inout out, operand: operand) }
        MidRvalue.Cast(operand: val operand, kind: _, targetTerm: _) => { midMakeOperandUnavailable(states: inout out, operand: operand) }
                    MidRvalue.EnumTag(place: _, enumIndex: _, sourceStmt: _, resultTerm: _) => {}
                    MidRvalue.EnumPayloadCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
                    MidRvalue.EnumPayloadBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
                    MidRvalue.EnumPayloadBoxedCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
                    MidRvalue.EnumPayloadBoxedBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => {}
                }
                if destination.projections.count() == 0U64 && destination.local < out.count() {
                    out.set(i: destination.local, value: <MidAccessibility.Available />)
                }
            }
            MidStatement.Overwrite(destination: val destination, source: val source) => {
                if source.projections.count() == 0U64 && source.local < out.count() {
                    out.set(i: source.local, value: <MidAccessibility.Unavailable />)
                }
                if destination.projections.count() == 0U64 && destination.local < out.count() {
                    out.set(i: destination.local, value: <MidAccessibility.Available />)
                }
            }
            MidStatement.Drop(place: val place) => {
                if place.projections.count() == 0U64 && place.local < out.count() {
                    out.set(i: place.local, value: <MidAccessibility.Unavailable />)
                }
            }
            MidStatement.ConditionalDrop(place: val place, flag: _) => {
                if place.projections.count() == 0U64 && place.local < out.count() {
                    out.set(i: place.local, value: <MidAccessibility.Unavailable />)
                }
            }
            MidStatement.ScopeExit(scope: val scope) => {
                mut val local: U64 = midScopeFirst(body: body, scope: scope)
                val end: U64 = midScopeEnd(body: body, scope: scope)
                while local < end && local < out.count() {
                    out.set(i: local, value: <MidAccessibility.Unavailable />)
                    local += 1U64
                }
            }
            _ => {}
        }
        si += 1U64
    }
    match block.terminator {
        MidTerminator.Switch(discriminant: val discriminant, values: _, targets: _, otherwise: _) => {
            midMakeOperandUnavailable(states: inout out, operand: discriminant)
        }
        MidTerminator.Call(callee: _, receiver: val receiver, args: val args, destination: val destination, target: _) => {
            match receiver { MidCallReceiver.Value(operand: val operand) => { midMakeOperandUnavailable(states: inout out, operand: operand) } _ => {} }
            mut val ai: U64 = 0U64
            while ai < args.count() {
                midMakeOperandUnavailable(states: inout out, operand: args[ai])
                ai += 1U64
            }
            if destination.projections.count() == 0U64 && destination.local < out.count() {
                out.set(i: destination.local, value: <MidAccessibility.Available />)
            }
        }
        MidTerminator.ReturnValue(value: val value) => {
            midMakeOperandUnavailable(states: inout out, operand: value)
        }
        _ => {}
    }
    return out
}

// Forward must-analysis: a root is Available at a join only when every incoming
// path still names it as an owner. This is separate from ownership because an
// unexecuted conditional move leaves a real value which nevertheless has no
// legal source-level name after the join.
export fn analyzeMidAccessibility(body: MidBody) -> Array[Array[MidAccessibility]] {
    mut val incoming: Array[Array[MidAccessibility]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidAccessibility] = []
    mut val li: U64 = 0U64
    while li < body.locals.count() {
        if body.locals[li].ownsAtEntry {
            initial.append(<MidAccessibility.Available />)
        } else {
            initial.append(<MidAccessibility.Unavailable />)
        }
        li += 1U64
    }
    mut val bi: U64 = 0U64
    while bi < body.blocks.count() {
        mut val empty: Array[MidAccessibility] = []
        mut val ei: U64 = 0U64
        while ei < body.locals.count() {
            empty.append(<MidAccessibility.Unavailable />)
            ei += 1U64
        }
        incoming.append(empty)
        reachable.append(false)
        bi += 1U64
    }
    if body.entry >= body.blocks.count() { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    mut val changed: Bool = true
    while changed {
        changed = false
        bi = 0U64
        while bi < body.blocks.count() {
            if reachable[bi] {
                val out: Array[MidAccessibility] = midAccessibilityTransfer(body: body, block: body.blocks[bi], input: incoming[bi])
                val successors: Array[U64] = midSuccessors(term: body.blocks[bi].terminator)
                mut val si: U64 = 0U64
                while si < successors.count() {
                    val successor: U64 = successors[si]
                    if successor < body.blocks.count() {
                        if !(reachable[successor]) {
                            incoming.set(i: successor, value: out)
                            reachable.set(i: successor, value: true)
                            changed = true
                        } else {
                            val before: Array[MidAccessibility] = incoming[successor]
                            mut val merged: Array[MidAccessibility] = []
                            mut val mi: U64 = 0U64
                            while mi < before.count() {
                                merged.append(midAccessibilityJoin(left: before[mi], right: out[mi]))
                                mi += 1U64
                            }
                            if midAccessibilityStateChanged(before: before, after: merged) {
                                incoming.set(i: successor, value: merged)
                                changed = true
                            }
                        }
                    }
                    si += 1U64
                }
            }
            bi += 1U64
        }
    }
    return incoming
}

fn midOperandMovedRoot(operand: MidOperand) -> U64 {
    match operand {
        MidOperand.Move(place: val place) => {
            if place.projections.count() == 0U64 { return place.local }
        }
        _ => {}
    }
    return 18446744073709551615U64
}

fn midRvalueMovedRoot(value: MidRvalue) -> U64 {
    match value {
        MidRvalue.Use(operand: val operand) => { return midOperandMovedRoot(operand: operand) }
        MidRvalue.ReturnBoundary(exprId: _, targetTerm: _, operand: val operand) => { return midOperandMovedRoot(operand: operand) }
        MidRvalue.Aggregate(exprId: _, kind: _, resultTerm: _, fieldCount: _, elements: val elements) => {
            mut val i: U64 = 0U64
            while i < elements.count() {
                val moved: U64 = midOperandMovedRoot(operand: elements[i].operand)
                if moved != 18446744073709551615U64 { return moved }
                i += 1U64
            }
            return 18446744073709551615U64
        }
        MidRvalue.Convert(operand: val operand, conversion: _) => { return midOperandMovedRoot(operand: operand) }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: _, operand: val operand) => { return midOperandMovedRoot(operand: operand) }
        MidRvalue.Cast(operand: val operand, kind: _, targetTerm: _) => { return midOperandMovedRoot(operand: operand) }
        MidRvalue.EnumTag(place: _, enumIndex: _, sourceStmt: _, resultTerm: _) => { return 18446744073709551615U64 }
        MidRvalue.EnumPayloadCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return 18446744073709551615U64 }
        MidRvalue.EnumPayloadBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return 18446744073709551615U64 }
        MidRvalue.EnumPayloadBoxedCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return 18446744073709551615U64 }
        MidRvalue.EnumPayloadBoxedBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return 18446744073709551615U64 }
    }
}

// A conditional move makes a root MaybeOwned/Unavailable at the first join
// which loses a uniform source-level owner.  A later block can inherit that
// same pair only because an earlier cliff has already discharged the remaining
// ownership obligation.  Insert one ConditionalDrop at the boundary, rather
// than once per downstream block.  This is deliberately phrased in CFG terms:
// lexical block order is not a dominance relation and is wrong for loops.
fn midIsAccessibilityCliff(body: MidBody, ownership: Array[Array[MidOwnership]], accessibility: Array[Array[MidAccessibility]], block: U64, local: U64) -> Bool {
    if block >= body.blocks.count() || block >= ownership.count() || block >= accessibility.count() { return false }
    if local >= ownership[block].count() || local >= accessibility[block].count() { return false }
    match ownership[block][local] {
        MidOwnership.MaybeOwned => {}
        _ => { return false }
    }
    match accessibility[block][local] {
        MidAccessibility.Unavailable => {}
        _ => { return false }
    }
    if block == body.entry { return true }
    mut val sawPredecessor: Bool = false
    mut val predecessor: U64 = 0U64
    while predecessor < body.blocks.count() {
        val successors: Array[U64] = midSuccessors(term: body.blocks[predecessor].terminator)
        mut val successorI: U64 = 0U64
        while successorI < successors.count() {
            if successors[successorI] == block {
                sawPredecessor = true
                val predecessorOwnership: Array[MidOwnership] = midTransferBlock(body: body, block: body.blocks[predecessor], input: ownership[predecessor])
                val predecessorAccessibility: Array[MidAccessibility] = midAccessibilityTransfer(body: body, block: body.blocks[predecessor], input: accessibility[predecessor])
                if local >= predecessorOwnership.count() || local >= predecessorAccessibility.count() { return false }
                match predecessorOwnership[local] {
                    MidOwnership.MaybeOwned => {
                        match predecessorAccessibility[local] {
                            MidAccessibility.Unavailable => {}
                            _ => { return true }
                        }
                    }
                    _ => { return true }
                }
            }
            successorI += 1U64
        }
        predecessor += 1U64
    }
    return !sawPredecessor
}

// Elaborate a parametric Mid body after its control-flow lowering. The body has
// no raw retain/release: this pass alone creates flag maintenance and conditional
// drops. A later instantiate pass grounds the type terms but does not alter this
// ownership topology.
export fn elaborateMidDrops(body: MidBody) -> MidBody {
    val ownership: Array[Array[MidOwnership]] = analyzeMidOwnership(body: body)
    val accessibility: Array[Array[MidAccessibility]] = analyzeMidAccessibility(body: body)
    val originalCount: U64 = body.locals.count()
    mut val needsFlag: Array[Bool] = []
    mut val flagFor: Array[U64] = []
    mut val cliffAtEntry: Array[Array[Bool]] = []
    mut val li: U64 = 0U64
    while li < originalCount {
        needsFlag.append(false)
        flagFor.append(0U64)
        li += 1U64
    }
    mut val bi: U64 = 0U64
    while bi < body.blocks.count() {
        mut val blockCliffs: Array[Bool] = []
        li = 0U64
        while li < originalCount {
            val cliff: Bool = midIsAccessibilityCliff(body: body, ownership: ownership, accessibility: accessibility, block: bi, local: li)
            blockCliffs.append(cliff)
            match ownership[bi][li] {
                MidOwnership.MaybeOwned => {
                    match accessibility[bi][li] {
                        MidAccessibility.Unavailable => { needsFlag.set(i: li, value: true) }
                        _ => {}
                    }
                }
                _ => {}
            }
            li += 1U64
        }
        cliffAtEntry.append(blockCliffs)
        // A scope exit consumes every root in that scope. A root which is
        // MaybeOwned on entry needs the same flag as an accessibility cliff;
        // elaboration below decides whether this concrete path emits it.
        mut val statementI: U64 = 0U64
        while statementI < body.blocks[bi].statements.count() {
            match body.blocks[bi].statements[statementI] {
                MidStatement.ScopeExit(scope: val scope) => {
                    li = midScopeFirst(body: body, scope: scope)
                    val end: U64 = midScopeEnd(body: body, scope: scope)
                    while li < end && li < originalCount {
                        match ownership[bi][li] {
                            MidOwnership.MaybeOwned => { needsFlag.set(i: li, value: true) }
                            _ => {}
                        }
                        li += 1U64
                    }
                }
                _ => {}
            }
            statementI += 1U64
        }
        bi += 1U64
    }

    // Re-run ownership over the planned cliff drops before choosing lexical
    // cleanup.  The original analysis necessarily leaves every downstream
    // block MaybeOwned; using it after inserting a drop would manufacture a
    // second consume at a later ScopeExit.  This temporary body is still
    // backend-independent and only models the ownership effect of the exact
    // drops selected above; actual flags are allocated below. Candidate cliffs
    // are not yet executable ConditionalDrops: one candidate can discharge a
    // backedge obligation and make another candidate statically dead. Select
    // each final drop from this new incoming state, not the original analysis.
    mut val cliffBlocks: Array[MidBlock] = []
    bi = 0U64
    while bi < body.blocks.count() {
        mut val statements: Array[MidStatement] = []
        li = 0U64
        while li < originalCount {
            if cliffAtEntry[bi][li] {
                statements.append(<MidStatement.ConditionalDrop place=<MidPlace local=li typeTerm=body.locals[li].typeTerm /> flag=0U64 />)
            }
            li += 1U64
        }
        li = 0U64
        while li < body.blocks[bi].statements.count() {
            statements.append(body.blocks[bi].statements[li])
            li += 1U64
        }
        cliffBlocks.append(<MidBlock statements=statements terminator=body.blocks[bi].terminator />)
        bi += 1U64
    }
    val cliffBody: MidBody = <MidBody bodyInstance=body.bodyInstance sourceFunction=body.sourceFunction locals=body.locals scopes=body.scopes blocks=cliffBlocks entry=body.entry />
    val ownershipAfterCliffs: Array[Array[MidOwnership]] = analyzeMidOwnership(body: cliffBody)
    mut val locals: Array[MidLocalDecl] = body.locals
    li = 0U64
    while li < originalCount {
        if needsFlag[li] {
            flagFor.set(i: li, value: locals.count())
            locals.append(<MidLocalDecl typeTerm=0U64 sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false isDropFlag=true isReturnPlace=false sourceNameStart=0U64 />)
        }
        li += 1U64
    }
    mut val blocks: Array[MidBlock] = []
    bi = 0U64
    while bi < body.blocks.count() {
        val source: MidBlock = body.blocks[bi]
        mut val statements: Array[MidStatement] = []
        mut val currentOwnership: Array[MidOwnership] = ownershipAfterCliffs[bi]
        mut val currentAccessibility: Array[MidAccessibility] = accessibility[bi]
        // Flag initialization is emitted in a fresh invocation-entry block
        // below, so a backedge to the original entry never resets live flags.
        // An accessibility cliff is a block-entry property: all predecessors
        // have already evaluated their branch/call operands, so the inserted
        // conditional drop cannot race source evaluation on either edge.  A
        // consumed flag must be cleared after either arm: without it a loop
        // that re-enters this block could run the same runtime drop twice.
        li = 0U64
        while li < originalCount {
            if needsFlag[li] && cliffAtEntry[bi][li] {
                match currentOwnership[li] {
                    MidOwnership.Owned => {
                        statements.append(<MidStatement.Drop place=<MidPlace local=li typeTerm=body.locals[li].typeTerm /> />)
                    }
                    MidOwnership.MaybeOwned => {
                        statements.append(<MidStatement.ConditionalDrop place=<MidPlace local=li typeTerm=body.locals[li].typeTerm /> flag=flagFor[li] />)
                    }
                    MidOwnership.Consumed => {}
                }
                statements.append(<MidStatement.SetDropFlag local=flagFor[li] isSet=false />)
                currentOwnership.set(i: li, value: <MidOwnership.Consumed />)
                currentAccessibility.set(i: li, value: <MidAccessibility.Unavailable />)
            }
            li += 1U64
        }
        mut val si: U64 = 0U64
        while si < source.statements.count() {
            val statement: MidStatement = source.statements[si]
            match statement {
                MidStatement.Assign(destination: val destination, value: val value) => {
                    statements.append(statement)
                    val moved: U64 = midRvalueMovedRoot(value: value)
                    if moved < originalCount && needsFlag[moved] {
                        statements.append(<MidStatement.SetDropFlag local=flagFor[moved] isSet=false />)
                    }
                    if destination.projections.count() == 0U64 && destination.local < originalCount && needsFlag[destination.local] {
                        statements.append(<MidStatement.SetDropFlag local=flagFor[destination.local] isSet=true />)
                    }
                    midConsumeRvalue(states: inout currentOwnership, value: value)
                    if destination.projections.count() == 0U64 && destination.local < currentOwnership.count() {
                        currentOwnership.set(i: destination.local, value: <MidOwnership.Owned />)
                        currentAccessibility.set(i: destination.local, value: <MidAccessibility.Available />)
                    }
                }
                MidStatement.Overwrite(destination: val destination, source: val source) => {
                    if destination.projections.count() == 0U64 && destination.local < currentOwnership.count() {
                        match currentOwnership[destination.local] {
                            MidOwnership.Owned => {
                                statements.append(<MidStatement.Drop place=destination />)
                                if destination.local < originalCount && needsFlag[destination.local] {
                                    statements.append(<MidStatement.SetDropFlag local=flagFor[destination.local] isSet=false />)
                                }
                            }
                            _ => {}
                        }
                    } else {
                        mut val physicalFieldPath: Bool = true
                        mut val projection: U64 = 0U64
                        while projection < destination.projections.count() {
                            match destination.projections[projection] {
                                MidProjection.Field(index: _, typeTerm: _) => {}
                                _ => { physicalFieldPath = false }
                            }
                            projection += 1U64
                        }
                        if physicalFieldPath {
                            // A field overwrite replaces an owned subvalue while
                            // retaining ownership of its root. The source was
                            // materialized before this point, so this explicit
                            // projection Drop preserves RHS-before-destruction.
                            statements.append(<MidStatement.Drop place=destination />)
                        }
                    }
                    statements.append(statement)
                    if source.projections.count() == 0U64 && source.local < currentOwnership.count() {
                        currentOwnership.set(i: source.local, value: <MidOwnership.Consumed />)
                        currentAccessibility.set(i: source.local, value: <MidAccessibility.Unavailable />)
                        if source.local < originalCount && needsFlag[source.local] {
                            statements.append(<MidStatement.SetDropFlag local=flagFor[source.local] isSet=false />)
                        }
                    }
                    if destination.projections.count() == 0U64 && destination.local < currentOwnership.count() {
                        currentOwnership.set(i: destination.local, value: <MidOwnership.Owned />)
                        currentAccessibility.set(i: destination.local, value: <MidAccessibility.Available />)
                        if destination.local < originalCount && needsFlag[destination.local] {
                            statements.append(<MidStatement.SetDropFlag local=flagFor[destination.local] isSet=true />)
                        }
                    }
                }
                MidStatement.ScopeExit(scope: val scope) => {
                    mut val local: U64 = midScopeEnd(body: body, scope: scope)
                    val first: U64 = midScopeFirst(body: body, scope: scope)
                    while local > first {
                        local -= 1U64
                        if local < originalCount && local < currentOwnership.count() {
                            match currentOwnership[local] {
                                MidOwnership.Owned => { statements.append(<MidStatement.Drop place=<MidPlace local=local typeTerm=body.locals[local].typeTerm /> />) }
                                MidOwnership.MaybeOwned => {
                                    if needsFlag[local] { statements.append(<MidStatement.ConditionalDrop place=<MidPlace local=local typeTerm=body.locals[local].typeTerm /> flag=flagFor[local] />) }
                                }
                                _ => {}
                            }
                            currentOwnership.set(i: local, value: <MidOwnership.Consumed />)
                            currentAccessibility.set(i: local, value: <MidAccessibility.Unavailable />)
                        }
                    }
                }
                _ => { statements.append(statement) }
            }
            si += 1U64
        }
        // A terminator evaluates after its statements. Flag changes are internal
        // bookkeeping; placing them immediately before the terminator preserves
        // user-visible evaluation and abort behavior.
        match source.terminator {
            MidTerminator.Call(callee: _, receiver: val receiver, args: val args, destination: val destination, target: _) => {
                match receiver {
                    MidCallReceiver.Value(operand: val operand) => {
                        val moved: U64 = midOperandMovedRoot(operand: operand)
                        if moved < originalCount && needsFlag[moved] {
                            statements.append(<MidStatement.SetDropFlag local=flagFor[moved] isSet=false />)
                        }
                    }
                    _ => {}
                }
                mut val ai: U64 = 0U64
                while ai < args.count() {
                    val moved: U64 = midOperandMovedRoot(operand: args[ai])
                    if moved < originalCount && needsFlag[moved] {
                        statements.append(<MidStatement.SetDropFlag local=flagFor[moved] isSet=false />)
                    }
                    ai += 1U64
                }
                if destination.projections.count() == 0U64 && destination.local < originalCount && needsFlag[destination.local] {
                    statements.append(<MidStatement.SetDropFlag local=flagFor[destination.local] isSet=true />)
                }
            }
            MidTerminator.ReturnValue(value: val value) => {
                val moved: U64 = midOperandMovedRoot(operand: value)
                if moved < originalCount && needsFlag[moved] {
                    statements.append(<MidStatement.SetDropFlag local=flagFor[moved] isSet=false />)
                }
            }
            _ => {}
        }
        blocks.append(<MidBlock statements=statements terminator=source.terminator />)
        bi += 1U64
    }
    mut val entry: U64 = body.entry
    if locals.count() > originalCount {
        mut val initializers: Array[MidStatement] = []
        li = 0U64
        while li < originalCount {
            if needsFlag[li] {
                initializers.append(<MidStatement.SetDropFlag local=flagFor[li] isSet=body.locals[li].ownsAtEntry />)
            }
            li += 1U64
        }
        entry = blocks.count()
        blocks.append(<MidBlock statements=initializers terminator=<MidTerminator.Goto target=body.entry /> />)
    }
    return <MidBody bodyInstance=body.bodyInstance sourceFunction=body.sourceFunction locals=locals scopes=body.scopes blocks=blocks entry=entry />
}
