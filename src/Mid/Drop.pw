// Ownership dataflow for Mid IR. This pass consumes only the canonical arena;
// it does not inspect AST, recover a type, or emit LLVM. Build creates operations;
// this pass computes their ownership consequences for drop elaboration and the
// always-on verifier.

import ./Ir with { MidCanonicalArena, canonicalMidPlaceIsWhole, MidRange, MidBodyNode, MidBlockNode, MidPlaceNode, MidOperandNode, MidRvalueNode, MidAggregateElementNode, MidStatementNode, MidTerminatorNode, MidCallReceiverNode, MidCanonicalBody, MidOperand, MidStatement, MidTerminator, MidLocalDecl, MidScope, MidBody, MidOwnership, MidAccessibility }

// Ownership state is function-local. A Global place denotes a stable storage
// address whose owner is the module lifetime, so reads and borrows never
// change this dataflow vector and a Move is rejected by verification before
// this analysis is used for emission.
fn canonicalMidIsLocalRoot(place: MidPlaceNode) -> Bool {
    return place.rootTag == 1U64
}

fn canonicalMidConsumeOperand(arena: MidCanonicalArena, states: inout Array[MidOwnership], operandId: U64) {
    if operandId == 0U64 || operandId > arena.operands.count() { return }
    val operand: MidOperandNode = arena.operands[operandId - 1U64]
    if operand.tag != 2U64 || operand.place == 0U64 || operand.place > arena.places.count() { return }
    val place: MidPlaceNode = arena.places[operand.place - 1U64]
    if canonicalMidIsLocalRoot(place: place) && canonicalMidPlaceIsWhole(arena: arena, place: place) && place.local < states.count() {
        states.set(i: place.local, value: <MidOwnership.Consumed />)
    }
}

fn canonicalMidConsumeRvalue(arena: MidCanonicalArena, states: inout Array[MidOwnership], rvalueId: U64) {
    if rvalueId == 0U64 || rvalueId > arena.rvalues.count() { return }
    val value: MidRvalueNode = arena.rvalues[rvalueId - 1U64]
    if value.operand != 0U64 { canonicalMidConsumeOperand(arena: arena, states: inout states, operandId: value.operand) }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            val element: MidAggregateElementNode = arena.aggregateElements[value.elements.start + elementI]
            canonicalMidConsumeOperand(arena: arena, states: inout states, operandId: element.operand)
            elementI = elementI + 1U64
        }
    }
    if value.tag == 19U64 {
        mut val captureI: U64 = 0U64
        while captureI < value.elements.len {
            canonicalMidConsumeOperand(arena: arena, states: inout states, operandId: arena.closureCaptures[value.elements.start + captureI].operand)
            captureI += 1U64
        }
    }
}

fn canonicalMidConsumeEnum(arena: MidCanonicalArena, statement: MidStatementNode, states: inout Array[MidOwnership]) {
    if statement.source == 0U64 || statement.source > arena.places.count() { return }
    val source = arena.places[statement.source - 1U64]
    if canonicalMidIsLocalRoot(place: source) && source.projections.len == 0U64 && source.local < states.count() { states.set(i: source.local, value: <MidOwnership.Consumed />) }
    if statement.enumDestinations.start > arena.enumDestinations.count() || statement.enumDestinations.len > arena.enumDestinations.count() - statement.enumDestinations.start { return }
    mut val index: U64 = 0U64
    while index < statement.enumDestinations.len {
        val entry = arena.enumDestinations[statement.enumDestinations.start + index]
        if entry.place == 0U64 || entry.place > arena.places.count() { return }
        val place = arena.places[entry.place - 1U64]
        if canonicalMidIsLocalRoot(place: place) && place.projections.len == 0U64 && place.local < states.count() { states.set(i: place.local, value: <MidOwnership.Owned />) }
        index += 1U64
    }
}

fn canonicalMidConsumeEnumAccessibility(arena: MidCanonicalArena, statement: MidStatementNode, states: inout Array[MidAccessibility]) {
    if statement.source == 0U64 || statement.source > arena.places.count() { return }
    val source = arena.places[statement.source - 1U64]
    if canonicalMidIsLocalRoot(place: source) && source.projections.len == 0U64 && source.local < states.count() { states.set(i: source.local, value: <MidAccessibility.Unavailable />) }
    if statement.enumDestinations.start > arena.enumDestinations.count() || statement.enumDestinations.len > arena.enumDestinations.count() - statement.enumDestinations.start { return }
    mut val index: U64 = 0U64
    while index < statement.enumDestinations.len {
        val entry = arena.enumDestinations[statement.enumDestinations.start + index]
        if entry.place == 0U64 || entry.place > arena.places.count() { return }
        val place = arena.places[entry.place - 1U64]
        if canonicalMidIsLocalRoot(place: place) && place.projections.len == 0U64 && place.local < states.count() { states.set(i: place.local, value: <MidAccessibility.Available />) }
        index += 1U64
    }
}

fn canonicalMidTransferBlock(arena: MidCanonicalArena, body: MidBodyNode, block: MidBlockNode, input: Array[MidOwnership]) -> Array[MidOwnership] {
    mut val out: Array[MidOwnership] = input
    mut val statementI: U64 = 0U64
    while statementI < block.statements.len {
        val statement: MidStatementNode = arena.statements[block.statements.start + statementI]
        if statement.tag == 13U64 { canonicalMidConsumeEnum(arena: arena, statement: statement, states: inout out) }
        if statement.tag == 1U64 || statement.tag == 9U64 {
            canonicalMidConsumeRvalue(arena: arena, states: inout out, rvalueId: statement.value)
            mut val assignedBorrow: Bool = false
            if statement.value != 0U64 && statement.value <= arena.rvalues.count() {
                val value: MidRvalueNode = arena.rvalues[statement.value - 1U64]
                assignedBorrow = value.tag == 13U64 || value.tag == 15U64
            }
            if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < out.count() && destination.local < body.locals.len && !arena.locals[body.locals.start + destination.local].isBorrowed && !assignedBorrow { out.set(i: destination.local, value: <MidOwnership.Owned />) }
            }
        }
        if statement.tag == 2U64 {
            if statement.source != 0U64 && statement.source <= arena.places.count() {
                val source: MidPlaceNode = arena.places[statement.source - 1U64]
                if canonicalMidIsLocalRoot(place: source) && source.projections.len == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidOwnership.Consumed />) }
            }
            if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidOwnership.Owned />) }
            }
        }
        // InitializeGlobal consumes its temporary local into the program-lifetime
        // root. Unlike Overwrite, that root has no prior value to destroy and
        // therefore never becomes a locally-owned value in this body.
        if statement.tag == 8U64 {
            if statement.source != 0U64 && statement.source <= arena.places.count() {
                val source: MidPlaceNode = arena.places[statement.source - 1U64]
                if canonicalMidIsLocalRoot(place: source) && source.projections.len == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidOwnership.Consumed />) }
            }
        }
        if statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
            if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                val place: MidPlaceNode = arena.places[statement.destination - 1U64]
                if canonicalMidIsLocalRoot(place: place) && place.projections.len == 0U64 && place.local < out.count() { out.set(i: place.local, value: <MidOwnership.Consumed />) }
            }
        }
        if statement.tag == 12U64 && statement.bindingLocal < out.count() {
            out.set(i: statement.bindingLocal, value: <MidOwnership.Consumed />)
        }
        if statement.tag == 6U64 && statement.scope < body.scopes.len {
            val scope: MidScope = arena.scopes[body.scopes.start + statement.scope]
            mut val local: U64 = scope.firstLocal
            while local < scope.firstLocal + scope.localCount && local < out.count() {
                out.set(i: local, value: <MidOwnership.Consumed />)
                local = local + 1U64
            }
        }
        statementI = statementI + 1U64
    }
    if block.terminator == 0U64 || block.terminator > arena.terminators.count() { return out }
    val term: MidTerminatorNode = arena.terminators[block.terminator - 1U64]
    if term.discriminant != 0U64 { canonicalMidConsumeOperand(arena: arena, states: inout out, operandId: term.discriminant) }
    if term.value != 0U64 { canonicalMidConsumeOperand(arena: arena, states: inout out, operandId: term.value) }
    if term.tag == 4U64 || term.tag == 10U64 {
        if term.callReceiver != 0U64 && term.callReceiver <= arena.callReceivers.count() {
            val receiver: MidCallReceiverNode = arena.callReceivers[term.callReceiver - 1U64]
            if receiver.tag == 2U64 { canonicalMidConsumeOperand(arena: arena, states: inout out, operandId: receiver.operand) }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            canonicalMidConsumeOperand(arena: arena, states: inout out, operandId: arena.callArguments[term.args.start + argumentI])
            argumentI = argumentI + 1U64
        }
        if term.destination != 0U64 && term.destination <= arena.places.count() {
            val destination: MidPlaceNode = arena.places[term.destination - 1U64]
            if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidOwnership.Owned />) }
        }
    }
    return out
}


// Canonical ownership analysis consumes only scalar rows/ranges. Its nested
// Arrays are transient fixed-point work state, never a body representation.
export fn analyzeCanonicalMidOwnership(arena: MidCanonicalArena, canonical: MidCanonicalBody) -> Array[Array[MidOwnership]] {
    if canonical.body == 0U64 || canonical.body > arena.bodies.count() { return [] }
    val body: MidBodyNode = arena.bodies[canonical.body - 1U64]
    mut val incoming: Array[Array[MidOwnership]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidOwnership] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        if arena.locals[body.locals.start + localI].ownsAtEntry || arena.locals[body.locals.start + localI].isInout { initial.append(<MidOwnership.Owned />) } else { initial.append(<MidOwnership.Consumed />) }
        localI = localI + 1U64
    }
    // Every block starts with the same value. Array CoW keeps later
    // updates independent without rebuilding the initial row per block.
    mut val empty: Array[MidOwnership] = []
    localI = 0U64
    while localI < body.locals.len {
        empty.append(<MidOwnership.Consumed />)
        localI += 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        incoming.append(empty)
        reachable.append(false)
        blockI = blockI + 1U64
    }
    if body.entry >= body.blocks.len { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    // Only a changed input can change a block's transfer result. Keep at
    // most one pending visit per block while propagating to the fixed point.
    mut val pending: Array[Bool] = []
    blockI = 0U64
    while blockI < body.blocks.len {
        pending.append(false)
        blockI += 1U64
    }
    mut val worklist: Array[U64] = [body.entry]
    pending.set(i: body.entry, value: true)
    mut val next: U64 = 0U64
    while next < worklist.count() {
        blockI = worklist[next]
        next += 1U64
        pending.set(i: blockI, value: false)
        val block: MidBlockNode = arena.blocks[body.blocks.start + blockI]
        val out: Array[MidOwnership] = canonicalMidTransferBlock(arena: arena, body: body, block: block, input: incoming[blockI])
        if block.terminator != 0U64 && block.terminator <= arena.terminators.count() {
            val term = arena.terminators[block.terminator - 1U64]
            mut val successorI: U64 = 0U64
            while successorI < term.successorCount() {
                val successor: U64 = arena.successorAt(term: term, index: successorI)
                if successor < body.blocks.len {
                    if !reachable[successor] {
                        incoming.set(i: successor, value: out)
                        reachable.set(i: successor, value: true)
                        if !pending[successor] {
                            worklist.append(successor)
                            pending.set(i: successor, value: true)
                        }
                    } else {
                        mut val merged: Array[MidOwnership] = incoming[successor]
                        if midJoinOwnershipStates(states: inout merged, incoming: out) {
                            incoming.set(i: successor, value: merged)
                            if !pending[successor] {
                                worklist.append(successor)
                                pending.set(i: successor, value: true)
                            }
                        }
                    }
                }
                successorI = successorI + 1U64
            }
        }
    }
    return incoming
}

fn canonicalMidMakeOperandUnavailable(arena: MidCanonicalArena, states: inout Array[MidAccessibility], operandId: U64) {
    if operandId == 0U64 || operandId > arena.operands.count() { return }
    val operand: MidOperandNode = arena.operands[operandId - 1U64]
    if operand.tag == 2U64 && operand.place != 0U64 && operand.place <= arena.places.count() {
        val place: MidPlaceNode = arena.places[operand.place - 1U64]
        if place.projections.len == 0U64 && place.local < states.count() { states.set(i: place.local, value: <MidAccessibility.Unavailable />) }
    }
}

fn canonicalMidMakeRvalueUnavailable(arena: MidCanonicalArena, states: inout Array[MidAccessibility], rvalueId: U64) {
    if rvalueId == 0U64 || rvalueId > arena.rvalues.count() { return }
    val value: MidRvalueNode = arena.rvalues[rvalueId - 1U64]
    if value.operand != 0U64 { canonicalMidMakeOperandUnavailable(arena: arena, states: inout states, operandId: value.operand) }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            canonicalMidMakeOperandUnavailable(arena: arena, states: inout states, operandId: arena.aggregateElements[value.elements.start + elementI].operand)
            elementI = elementI + 1U64
        }
    }
    if value.tag == 19U64 {
        mut val captureI: U64 = 0U64
        while captureI < value.elements.len {
            canonicalMidMakeOperandUnavailable(arena: arena, states: inout states, operandId: arena.closureCaptures[value.elements.start + captureI].operand)
            captureI += 1U64
        }
    }
}

fn canonicalMidAccessibilityTransfer(arena: MidCanonicalArena, body: MidBodyNode, block: MidBlockNode, input: Array[MidAccessibility]) -> Array[MidAccessibility] {
    mut val out: Array[MidAccessibility] = input
    mut val statementI: U64 = 0U64
    while statementI < block.statements.len {
        val statement: MidStatementNode = arena.statements[block.statements.start + statementI]
        if statement.tag == 13U64 { canonicalMidConsumeEnumAccessibility(arena: arena, statement: statement, states: inout out) }
        if statement.tag == 1U64 || statement.tag == 9U64 {
            canonicalMidMakeRvalueUnavailable(arena: arena, states: inout out, rvalueId: statement.value)
            if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                val place: MidPlaceNode = arena.places[statement.destination - 1U64]
                if place.projections.len == 0U64 && place.local < out.count() { out.set(i: place.local, value: <MidAccessibility.Available />) }
            }
        }
        if statement.tag == 2U64 {
            if statement.source != 0U64 && statement.source <= arena.places.count() {
                val source: MidPlaceNode = arena.places[statement.source - 1U64]
                if source.projections.len == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidAccessibility.Unavailable />) }
            }
            if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidAccessibility.Available />) }
            }
        }
        if statement.tag == 8U64 {
            if statement.source != 0U64 && statement.source <= arena.places.count() {
                val source: MidPlaceNode = arena.places[statement.source - 1U64]
                if source.projections.len == 0U64 && source.local < out.count() { out.set(i: source.local, value: <MidAccessibility.Unavailable />) }
            }
        }
        if statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
            if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                val place: MidPlaceNode = arena.places[statement.destination - 1U64]
                if place.projections.len == 0U64 && place.local < out.count() { out.set(i: place.local, value: <MidAccessibility.Unavailable />) }
            }
        }
        if statement.tag == 12U64 && statement.bindingLocal < out.count() {
            out.set(i: statement.bindingLocal, value: <MidAccessibility.Unavailable />)
        }
        if statement.tag == 6U64 && statement.scope < body.scopes.len {
            val scope: MidScope = arena.scopes[body.scopes.start + statement.scope]
            mut val local: U64 = scope.firstLocal
            while local < scope.firstLocal + scope.localCount && local < out.count() {
                out.set(i: local, value: <MidAccessibility.Unavailable />)
                local = local + 1U64
            }
        }
        statementI = statementI + 1U64
    }
    if block.terminator == 0U64 || block.terminator > arena.terminators.count() { return out }
    val term: MidTerminatorNode = arena.terminators[block.terminator - 1U64]
    if term.discriminant != 0U64 { canonicalMidMakeOperandUnavailable(arena: arena, states: inout out, operandId: term.discriminant) }
    if term.value != 0U64 { canonicalMidMakeOperandUnavailable(arena: arena, states: inout out, operandId: term.value) }
    if term.tag == 4U64 || term.tag == 10U64 {
        if term.callReceiver != 0U64 && term.callReceiver <= arena.callReceivers.count() {
            val receiver: MidCallReceiverNode = arena.callReceivers[term.callReceiver - 1U64]
            if receiver.tag == 2U64 { canonicalMidMakeOperandUnavailable(arena: arena, states: inout out, operandId: receiver.operand) }
        }
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            canonicalMidMakeOperandUnavailable(arena: arena, states: inout out, operandId: arena.callArguments[term.args.start + argumentI])
            argumentI = argumentI + 1U64
        }
        if term.destination != 0U64 && term.destination <= arena.places.count() {
            val destination: MidPlaceNode = arena.places[term.destination - 1U64]
            if destination.projections.len == 0U64 && destination.local < out.count() { out.set(i: destination.local, value: <MidAccessibility.Available />) }
        }
    }
    return out
}

export fn analyzeCanonicalMidAccessibility(arena: MidCanonicalArena, canonical: MidCanonicalBody) -> Array[Array[MidAccessibility]] {
    if canonical.body == 0U64 || canonical.body > arena.bodies.count() { return [] }
    val body: MidBodyNode = arena.bodies[canonical.body - 1U64]
    mut val incoming: Array[Array[MidAccessibility]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidAccessibility] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        if arena.locals[body.locals.start + localI].ownsAtEntry || arena.locals[body.locals.start + localI].isInout { initial.append(<MidAccessibility.Available />) } else { initial.append(<MidAccessibility.Unavailable />) }
        localI = localI + 1U64
    }
    // Every block starts with the same value. Array CoW keeps later
    // updates independent without rebuilding the initial row per block.
    mut val empty: Array[MidAccessibility] = []
    localI = 0U64
    while localI < body.locals.len {
        empty.append(<MidAccessibility.Unavailable />)
        localI += 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        incoming.append(empty)
        reachable.append(false)
        blockI = blockI + 1U64
    }
    if body.entry >= body.blocks.len { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    // Only a changed input can change a block's transfer result. Keep at
    // most one pending visit per block while propagating to the fixed point.
    mut val pending: Array[Bool] = []
    blockI = 0U64
    while blockI < body.blocks.len {
        pending.append(false)
        blockI += 1U64
    }
    mut val worklist: Array[U64] = [body.entry]
    pending.set(i: body.entry, value: true)
    mut val next: U64 = 0U64
    while next < worklist.count() {
        blockI = worklist[next]
        next += 1U64
        pending.set(i: blockI, value: false)
        val block: MidBlockNode = arena.blocks[body.blocks.start + blockI]
        val out: Array[MidAccessibility] = canonicalMidAccessibilityTransfer(arena: arena, body: body, block: block, input: incoming[blockI])
        if block.terminator != 0U64 && block.terminator <= arena.terminators.count() {
            val term = arena.terminators[block.terminator - 1U64]
            mut val successorI: U64 = 0U64
            while successorI < term.successorCount() {
                val successor: U64 = arena.successorAt(term: term, index: successorI)
                if successor < body.blocks.len {
                    if !reachable[successor] {
                        incoming.set(i: successor, value: out)
                        reachable.set(i: successor, value: true)
                        if !pending[successor] {
                            worklist.append(successor)
                            pending.set(i: successor, value: true)
                        }
                    } else {
                        mut val merged: Array[MidAccessibility] = incoming[successor]
                        if midJoinAccessibilityStates(states: inout merged, incoming: out) {
                            incoming.set(i: successor, value: merged)
                            if !pending[successor] {
                                worklist.append(successor)
                                pending.set(i: successor, value: true)
                            }
                        }
                    }
                }
                successorI = successorI + 1U64
            }
        }
    }
    return incoming
}

// Immutable CFG facts shared by all local queries in this drop plan.
struct MidDropPredecessors {
    pub val blocks: Array[Array[U64]] = []
    pub val ownership: Array[Array[MidOwnership]] = []
    pub val accessibility: Array[Array[MidAccessibility]] = []
}
pub impl MidDropPredecessors { factory }

fn canonicalMidDropPredecessors(arena: MidCanonicalArena, body: MidBodyNode, ownership: Array[Array[MidOwnership]], accessibility: Array[Array[MidAccessibility]]) -> MidDropPredecessors {
    mut val predecessors: Array[Array[U64]] = []
    mut val exits: Array[Array[MidOwnership]] = []
    mut val accessExits: Array[Array[MidAccessibility]] = []
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        predecessors.append([])
        blockI += 1U64
    }
    blockI = 0U64
    while blockI < body.blocks.len {
        val block = arena.blocks[body.blocks.start + blockI]
        exits.append(canonicalMidTransferBlock(arena: arena, body: body, block: block, input: ownership[blockI]))
        accessExits.append(canonicalMidAccessibilityTransfer(arena: arena, body: body, block: block, input: accessibility[blockI]))
        if block.terminator != 0U64 && block.terminator <= arena.terminators.count() {
            val term = arena.terminators[block.terminator - 1U64]
            mut val successorI: U64 = 0U64
            while successorI < term.successorCount() {
                val target = arena.successorAt(term: term, index: successorI)
                if target < body.blocks.len {
                    mut val incoming = predecessors[target]
                    incoming.append(blockI)
                    predecessors.set(i: target, value: incoming)
                }
                successorI += 1U64
            }
        }
        blockI += 1U64
    }
    return <MidDropPredecessors blocks=predecessors ownership=exits accessibility=accessExits />
}

// Called only for a MaybeOwned/Unavailable local. The block planner owns
// that shared predicate; this query only distinguishes an incoming cliff.
fn canonicalMidCliffFromPredecessors(body: MidBodyNode, predecessors: MidDropPredecessors, blockI: U64, local: U64) -> Bool {
    if blockI == body.entry { return true }
    val incoming = predecessors.blocks[blockI]
    mut val predecessorI: U64 = 0U64
    while predecessorI < incoming.count() {
        val predecessor = incoming[predecessorI]
        val predecessorOwnership = predecessors.ownership[predecessor]
        val predecessorAccessibility = predecessors.accessibility[predecessor]
        if local >= predecessorOwnership.count() || local >= predecessorAccessibility.count() { return false }
        match predecessorOwnership[local] {
            MidOwnership.MaybeOwned => {
                match predecessorAccessibility[local] { MidAccessibility.Unavailable => {} _ => { return true } }
            }
            _ => { return true }
        }
        predecessorI += 1U64
    }
    return incoming.count() == 0U64
}

// Planning is deliberately separate from row emission: a flag exists only
// when conditional ownership reaches a cliff or scope cleanup.  The arrays
// are pass-local analysis state, not part of the canonical body schema.
struct MidCanonicalDropPlan {
    pub val needsFlag: Array[Bool] = []
    pub val cliffAtEntry: Array[Array[Bool]] = []
}
pub impl MidCanonicalDropPlan { factory }

fn canonicalMidDropPlan(arena: MidCanonicalArena, canonical: MidCanonicalBody, ownership: Array[Array[MidOwnership]], accessibility: Array[Array[MidAccessibility]]) -> MidCanonicalDropPlan {
    if canonical.body == 0U64 || canonical.body > arena.bodies.count() { return <MidCanonicalDropPlan /> }
    val body: MidBodyNode = arena.bodies[canonical.body - 1U64]
    val predecessors = canonicalMidDropPredecessors(arena: arena, body: body, ownership: ownership, accessibility: accessibility)
    mut val needsFlag: Array[Bool] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        needsFlag.append(false)
        localI = localI + 1U64
    }
    mut val cliffs: Array[Array[Bool]] = []
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val blockOwnership: Array[MidOwnership] = []
        if blockI < ownership.count() { blockOwnership = ownership[blockI] }
        mut val blockAccessibility: Array[MidAccessibility] = []
        if blockI < accessibility.count() { blockAccessibility = accessibility[blockI] }
        mut val blockCliffs: Array[Bool] = []
        localI = 0U64
        while localI < body.locals.len {
            mut val cliff: Bool = false
            if localI < blockOwnership.count() && localI < blockAccessibility.count() {
                match blockOwnership[localI] {
                    MidOwnership.MaybeOwned => {
                        match blockAccessibility[localI] {
                            MidAccessibility.Unavailable => {
                                needsFlag.set(i: localI, value: true)
                                cliff = canonicalMidCliffFromPredecessors(body: body, predecessors: predecessors, blockI: blockI, local: localI)
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            blockCliffs.append(cliff)
            localI += 1U64
        }
        val block: MidBlockNode = arena.blocks[body.blocks.start + blockI]
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = arena.statements[block.statements.start + statementI]
            if statement.tag == 12U64 && statement.bindingLocal < body.locals.len && statement.bindingLocal < blockOwnership.count() {
                match blockOwnership[statement.bindingLocal] { MidOwnership.MaybeOwned => { needsFlag.set(i: statement.bindingLocal, value: true) } _ => {} }
            }
            if statement.tag == 6U64 && statement.scope < body.scopes.len {
                val scope: MidScope = arena.scopes[body.scopes.start + statement.scope]
                localI = scope.firstLocal
                while localI < scope.firstLocal + scope.localCount && localI < body.locals.len && localI < blockOwnership.count() {
                    match blockOwnership[localI] { MidOwnership.MaybeOwned => { needsFlag.set(i: localI, value: true) } _ => {} }
                    localI = localI + 1U64
                }
            }
            statementI = statementI + 1U64
        }
        cliffs.append(blockCliffs)
        blockI = blockI + 1U64
    }
    return <MidCanonicalDropPlan needsFlag=needsFlag cliffAtEntry=cliffs />
}

// Flag locals are appended after the source local prefix.  Their mapping is
// derived from the immutable plan rather than carried as a mutable side table,
// so every later canonical reader can reproduce the same local identity.
fn canonicalMidFlagLocal(plan: MidCanonicalDropPlan, sourceLocalCount: U64, local: U64) -> U64 {
    if local >= plan.needsFlag.count() || !plan.needsFlag[local] { return 0U64 }
    mut val flag: U64 = sourceLocalCount
    mut val prior: U64 = 0U64
    while prior < local {
        if plan.needsFlag[prior] { flag = flag + 1U64 }
        prior = prior + 1U64
    }
    return flag
}

fn canonicalMidAppendDropLocals(arena: inout MidCanonicalArena, body: MidBodyNode, plan: MidCanonicalDropPlan) -> MidRange {
    val start: U64 = arena.locals.count()
    mut val local: U64 = 0U64
    while local < body.locals.len {
        arena.locals.append(arena.locals[body.locals.start + local])
        local = local + 1U64
    }
    local = 0U64
    while local < body.locals.len && local < plan.needsFlag.count() {
        if plan.needsFlag[local] {
            arena.locals.append(<MidLocalDecl typeTerm=0U64 sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false isDropFlag=true isReturnPlace=false sourceNameStart=0U64 />)
        }
        local = local + 1U64
    }
    return <MidRange start=start len=arena.locals.count() - start />
}

// Flags are initialized once at invocation entry, never at the source entry
// block itself: a loop backedge can revisit that block while a conditional
// move remains live. `target` is already the rewritten source entry index.
fn canonicalMidAppendDropFlagEntry(arena: inout MidCanonicalArena, body: MidBodyNode, plan: MidCanonicalDropPlan, target: U64, blockStart: U64) -> U64 {
    val statementStart: U64 = arena.statements.count()
    mut val local: U64 = 0U64
    while local < body.locals.len && local < plan.needsFlag.count() {
        if plan.needsFlag[local] {
            val flag: U64 = canonicalMidFlagLocal(plan: plan, sourceLocalCount: body.locals.len, local: local)
            arena.statements.append(<MidStatementNode tag=5U64 flag=flag isSet=arena.locals[body.locals.start + local].ownsAtEntry />)
        }
        local = local + 1U64
    }
    if arena.statements.count() == statementStart { return 0U64 }
    arena.terminators.append(<MidTerminatorNode tag=2U64 target=target />)
    arena.blocks.append(<MidBlockNode statements=<MidRange start=statementStart len=arena.statements.count() - statementStart /> terminator=arena.terminators.count() />)
    return arena.blocks.count() - blockStart - 1U64
}

fn canonicalMidMovedRoot(arena: MidCanonicalArena, operandId: U64) -> U64 {
    if operandId == 0U64 || operandId > arena.operands.count() { return 18446744073709551615U64 }
    val operand: MidOperandNode = arena.operands[operandId - 1U64]
    if operand.tag != 2U64 || operand.place == 0U64 || operand.place > arena.places.count() { return 18446744073709551615U64 }
    val place: MidPlaceNode = arena.places[operand.place - 1U64]
    if canonicalMidIsLocalRoot(place: place) && place.projections.len == 0U64 { return place.local }
    return 18446744073709551615U64
}

// An aggregate can transfer more than one unique child. Clear every matching
// conditional-drop flag at the transfer point; choosing only the first moved
// root leaves a later loop/cliff cleanup able to destroy a value whose owner
// already moved into the aggregate.
fn canonicalMidAppendMovedFlagClears(arena: inout MidCanonicalArena, rvalueId: U64, sourceLocalCount: U64, plan: MidCanonicalDropPlan) {
    if rvalueId == 0U64 || rvalueId > arena.rvalues.count() { return }
    val value: MidRvalueNode = arena.rvalues[rvalueId - 1U64]
    if value.operand != 0U64 {
        val moved: U64 = canonicalMidMovedRoot(arena: arena, operandId: value.operand)
        if moved < sourceLocalCount && plan.needsFlag[moved] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: sourceLocalCount, local: moved) isSet=false />) }
    }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            val moved: U64 = canonicalMidMovedRoot(arena: arena, operandId: arena.aggregateElements[value.elements.start + elementI].operand)
            if moved < sourceLocalCount && plan.needsFlag[moved] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: sourceLocalCount, local: moved) isSet=false />) }
            elementI = elementI + 1U64
        }
    }
    if value.tag == 19U64 {
        mut val captureI: U64 = 0U64
        while captureI < value.elements.len {
            val moved: U64 = canonicalMidMovedRoot(arena: arena, operandId: arena.closureCaptures[value.elements.start + captureI].operand)
            if moved < sourceLocalCount && plan.needsFlag[moved] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: sourceLocalCount, local: moved) isSet=false />) }
            captureI += 1U64
        }
    }
}

// A planned accessibility-cliff cleanup changes the ownership state seen by
// later lexical cleanup.  Compute that fixed point directly over canonical
// rows instead of materializing a draft MidBody solely for this analysis.
// ConditionalDrop consumes in either run-time arm, which is exactly the
// ownership effect needed for this conservative planning pass.
fn canonicalMidTransferBlockAfterCliffs(arena: MidCanonicalArena, body: MidBodyNode, block: MidBlockNode, input: Array[MidOwnership], plan: MidCanonicalDropPlan, blockI: U64) -> Array[MidOwnership] {
    mut val afterCliffs: Array[MidOwnership] = input
    mut val local: U64 = 0U64
    while local < afterCliffs.count() && blockI < plan.cliffAtEntry.count() && local < plan.cliffAtEntry[blockI].count() {
        if plan.cliffAtEntry[blockI][local] { afterCliffs.set(i: local, value: <MidOwnership.Consumed />) }
        local = local + 1U64
    }
    return canonicalMidTransferBlock(arena: arena, body: body, block: block, input: afterCliffs)
}

fn canonicalMidOwnershipAfterCliffs(arena: MidCanonicalArena, canonical: MidCanonicalBody, plan: MidCanonicalDropPlan) -> Array[Array[MidOwnership]] {
    if canonical.body == 0U64 || canonical.body > arena.bodies.count() { return [] }
    val body: MidBodyNode = arena.bodies[canonical.body - 1U64]
    mut val incoming: Array[Array[MidOwnership]] = []
    mut val reachable: Array[Bool] = []
    mut val initial: Array[MidOwnership] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        if arena.locals[body.locals.start + localI].ownsAtEntry || arena.locals[body.locals.start + localI].isInout { initial.append(<MidOwnership.Owned />) } else { initial.append(<MidOwnership.Consumed />) }
        localI = localI + 1U64
    }
    // Every block starts with the same value. Array CoW keeps later
    // updates independent without rebuilding the initial row per block.
    mut val empty: Array[MidOwnership] = []
    localI = 0U64
    while localI < body.locals.len {
        empty.append(<MidOwnership.Consumed />)
        localI += 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        incoming.append(empty)
        reachable.append(false)
        blockI = blockI + 1U64
    }
    if body.entry >= body.blocks.len { return incoming }
    incoming.set(i: body.entry, value: initial)
    reachable.set(i: body.entry, value: true)
    // Only a changed input can change a block's transfer result. Keep at
    // most one pending visit per block while propagating to the fixed point.
    mut val pending: Array[Bool] = []
    blockI = 0U64
    while blockI < body.blocks.len {
        pending.append(false)
        blockI += 1U64
    }
    mut val worklist: Array[U64] = [body.entry]
    pending.set(i: body.entry, value: true)
    mut val next: U64 = 0U64
    while next < worklist.count() {
        blockI = worklist[next]
        next += 1U64
        pending.set(i: blockI, value: false)
        val block: MidBlockNode = arena.blocks[body.blocks.start + blockI]
        val out: Array[MidOwnership] = canonicalMidTransferBlockAfterCliffs(arena: arena, body: body, block: block, input: incoming[blockI], plan: plan, blockI: blockI)
        if block.terminator != 0U64 && block.terminator <= arena.terminators.count() {
            val term = arena.terminators[block.terminator - 1U64]
            mut val successorI: U64 = 0U64
            while successorI < term.successorCount() {
                val successor: U64 = arena.successorAt(term: term, index: successorI)
                if successor < body.blocks.len {
                    if !reachable[successor] {
                        incoming.set(i: successor, value: out)
                        reachable.set(i: successor, value: true)
                        if !pending[successor] {
                            worklist.append(successor)
                            pending.set(i: successor, value: true)
                        }
                    } else {
                        mut val merged: Array[MidOwnership] = incoming[successor]
                        if midJoinOwnershipStates(states: inout merged, incoming: out) {
                            incoming.set(i: successor, value: merged)
                            if !pending[successor] {
                                worklist.append(successor)
                                pending.set(i: successor, value: true)
                            }
                        }
                    }
                }
                successorI = successorI + 1U64
            }
        }
    }
    return incoming
}

fn canonicalMidAppendRootPlace(arena: inout MidCanonicalArena, body: MidBodyNode, local: U64) -> U64 {
    if local >= body.locals.len { return 0U64 }
    arena.places.append(<MidPlaceNode local=local typeTerm=arena.locals[body.locals.start + local].typeTerm />)
    return arena.places.count()
}

fn canonicalMidPhysicalStoragePlace(arena: MidCanonicalArena, placeId: U64) -> Bool {
    if placeId == 0U64 || placeId > arena.places.count() { return false }
    val place: MidPlaceNode = arena.places[placeId - 1U64]
    if place.projections.len == 0U64 { return false }
    mut val projectionI: U64 = 0U64
    while projectionI < place.projections.len {
        val tag: U64 = arena.projections[place.projections.start + projectionI].tag
        if tag != 1U64 && tag != 3U64 { return false }
        projectionI = projectionI + 1U64
    }
    return true
}

// Drops rewrite CFG-local statement/terminator ownership.  The scalar rows
// below deliberately copy call-owned child ranges even when their operands
// are immutable shared IDs: a rewritten body owns a closed terminator slice
// without ever thawing it into the draft enum vocabulary.
fn canonicalMidCopyIdentityTerminator(arena: inout MidCanonicalArena, terminatorId: U64) -> U64 {
    if terminatorId == 0U64 || terminatorId > arena.terminators.count() { return 0U64 }
    val term: MidTerminatorNode = arena.terminators[terminatorId - 1U64]
    match term.tag {
        1U64 => { arena.terminators.append(<MidTerminatorNode tag=1U64 />) }
        2U64 => { arena.terminators.append(<MidTerminatorNode tag=2U64 target=term.target />) }
        3U64 => {
            val caseStart: U64 = arena.switchCases.count()
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                arena.switchCases.append(arena.switchCases[term.cases.start + caseI])
                caseI = caseI + 1U64
            }
            arena.terminators.append(<MidTerminatorNode tag=3U64 discriminant=term.discriminant cases=<MidRange start=caseStart len=term.cases.len /> otherwise=term.otherwise />)
        }
        4U64 => {
            val argumentStart: U64 = arena.callArguments.count()
            mut val argumentI: U64 = 0U64
            while argumentI < term.args.len {
                arena.callArguments.append(arena.callArguments[term.args.start + argumentI])
                argumentI = argumentI + 1U64
            }
            mut val target: U64 = 0U64
            if term.callTarget != 0U64 && term.callTarget <= arena.callTargets.count() {
                arena.callTargets.append(arena.callTargets[term.callTarget - 1U64])
                target = arena.callTargets.count()
            }
            mut val receiver: U64 = 0U64
            if term.callReceiver != 0U64 && term.callReceiver <= arena.callReceivers.count() {
                arena.callReceivers.append(arena.callReceivers[term.callReceiver - 1U64])
                receiver = arena.callReceivers.count()
            }
            arena.terminators.append(<MidTerminatorNode tag=4U64 target=term.target args=<MidRange start=argumentStart len=term.args.len /> destination=term.destination callTarget=target callReceiver=receiver />)
        }
        5U64 => { arena.terminators.append(<MidTerminatorNode tag=5U64 />) }
        6U64 => { arena.terminators.append(<MidTerminatorNode tag=6U64 value=term.value />) }
        7U64 => { arena.terminators.append(<MidTerminatorNode tag=7U64 value=term.value />) }
        8U64 => { arena.terminators.append(<MidTerminatorNode tag=8U64 />) }
        9U64 => { arena.terminators.append(<MidTerminatorNode tag=9U64 />) }
        10U64 => { arena.terminators.append(<MidTerminatorNode tag=10U64 state=term.state resume=term.resume exprId=term.exprId value=term.value destination=term.destination />) }
        _ => { return 0U64 }
    }
    return arena.terminators.count()
}

// Drop elaboration reads the
// frozen CFG, performs all ownership planning from scalar rows, and emits a
// new frozen body.  In particular, no branch returns through MidBody or the
// draft MidStatement/MidTerminator sums.
export fn elaborateCanonicalMidDrops(arena: inout MidCanonicalArena, canonical: MidCanonicalBody) -> MidCanonicalBody {
    if canonical.body == 0U64 || canonical.body > arena.bodies.count() { return <MidCanonicalBody body=0U64 /> }
    val source: MidBodyNode = arena.bodies[canonical.body - 1U64]
    val ownership: Array[Array[MidOwnership]] = analyzeCanonicalMidOwnership(arena: arena, canonical: canonical)
    val accessibility: Array[Array[MidAccessibility]] = analyzeCanonicalMidAccessibility(arena: arena, canonical: canonical)
    val plan: MidCanonicalDropPlan = canonicalMidDropPlan(arena: arena, canonical: canonical, ownership: ownership, accessibility: accessibility)
    val ownershipAfterCliffs: Array[Array[MidOwnership]] = canonicalMidOwnershipAfterCliffs(arena: arena, canonical: canonical, plan: plan)
    val locals: MidRange = canonicalMidAppendDropLocals(arena: inout arena, body: source, plan: plan)
    val scopeStart: U64 = arena.scopes.count()
    mut val scopeI: U64 = 0U64
    while scopeI < source.scopes.len {
        arena.scopes.append(arena.scopes[source.scopes.start + scopeI])
        scopeI = scopeI + 1U64
    }
    val scopes: MidRange = <MidRange start=scopeStart len=source.scopes.len />
    val blockStart: U64 = arena.blocks.count()
    mut val blockI: U64 = 0U64
    while blockI < source.blocks.len {
        val block: MidBlockNode = arena.blocks[source.blocks.start + blockI]
        val statementStart: U64 = arena.statements.count()
        mut val currentOwnership: Array[MidOwnership] = []
        if blockI < ownershipAfterCliffs.count() { currentOwnership = ownershipAfterCliffs[blockI] }
        mut val currentAccessibility: Array[MidAccessibility] = []
        if blockI < accessibility.count() { currentAccessibility = accessibility[blockI] }

        // Candidate cliffs were included in ownershipAfterCliffs.  Emit the
        // concrete operation selected by that state, then clear its flag so a
        // loop backedge cannot replay the same conditional destruction.
        mut val local: U64 = 0U64
        while local < source.locals.len && blockI < plan.cliffAtEntry.count() && local < plan.cliffAtEntry[blockI].count() {
            if plan.needsFlag[local] && plan.cliffAtEntry[blockI][local] {
                val place: U64 = canonicalMidAppendRootPlace(arena: inout arena, body: source, local: local)
                if local < currentOwnership.count() {
                    match currentOwnership[local] {
                        MidOwnership.Owned => { arena.statements.append(<MidStatementNode tag=3U64 destination=place />) }
                        MidOwnership.MaybeOwned => { arena.statements.append(<MidStatementNode tag=4U64 destination=place flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: local) />) }
                        _ => {}
                    }
                    currentOwnership.set(i: local, value: <MidOwnership.Consumed />)
                }
                if local < currentAccessibility.count() { currentAccessibility.set(i: local, value: <MidAccessibility.Unavailable />) }
                arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: local) isSet=false />)
            }
            local = local + 1U64
        }

        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = arena.statements[block.statements.start + statementI]
            if statement.tag == 13U64 {
                arena.statements.append(statement)
                val consumed = arena.places[statement.source - 1U64]
                if consumed.local < source.locals.len && plan.needsFlag[consumed.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: consumed.local) isSet=false />) }
                mut val index: U64 = 0U64
                while index < statement.enumDestinations.len {
                    val destination = arena.places[arena.enumDestinations[statement.enumDestinations.start + index].place - 1U64]
                    if destination.local < source.locals.len && plan.needsFlag[destination.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: destination.local) isSet=true />) }
                    index += 1U64
                }
                canonicalMidConsumeEnum(arena: arena, statement: statement, states: inout currentOwnership)
                canonicalMidConsumeEnumAccessibility(arena: arena, statement: statement, states: inout currentAccessibility)
            } else if statement.tag == 1U64 || statement.tag == 9U64 {
                arena.statements.append(statement)
                canonicalMidAppendMovedFlagClears(arena: inout arena, rvalueId: statement.value, sourceLocalCount: source.locals.len, plan: plan)
                mut val assignedBorrow: Bool = false
                if statement.value != 0U64 && statement.value <= arena.rvalues.count() {
                    val value: MidRvalueNode = arena.rvalues[statement.value - 1U64]
                    assignedBorrow = value.tag == 13U64 || value.tag == 15U64
                }
                if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                    val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                    if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < source.locals.len && !arena.locals[source.locals.start + destination.local].isBorrowed && !assignedBorrow && plan.needsFlag[destination.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: destination.local) isSet=true />) }
                }
                canonicalMidConsumeRvalue(arena: arena, states: inout currentOwnership, rvalueId: statement.value)
                if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                    val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                    if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < currentOwnership.count() && destination.local < source.locals.len && !arena.locals[source.locals.start + destination.local].isBorrowed && !assignedBorrow {
                        currentOwnership.set(i: destination.local, value: <MidOwnership.Owned />)
                        if destination.local < currentAccessibility.count() { currentAccessibility.set(i: destination.local, value: <MidAccessibility.Available />) }
                    }
                }
            } else if statement.tag == 2U64 {
                if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                    val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                    if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < currentOwnership.count() {
                        match currentOwnership[destination.local] {
                            MidOwnership.Owned => {
                                arena.statements.append(<MidStatementNode tag=3U64 destination=statement.destination />)
                                if destination.local < source.locals.len && plan.needsFlag[destination.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: destination.local) isSet=false />) }
                            }
                            _ => {}
                        }
                    } else if destination.rootTag == 2U64 || canonicalMidPhysicalStoragePlace(arena: arena, placeId: statement.destination) {
                        arena.statements.append(<MidStatementNode tag=3U64 destination=statement.destination />)
                    }
                }
                arena.statements.append(statement)
                if statement.source != 0U64 && statement.source <= arena.places.count() {
                    val sourcePlace: MidPlaceNode = arena.places[statement.source - 1U64]
                    if canonicalMidIsLocalRoot(place: sourcePlace) && sourcePlace.projections.len == 0U64 && sourcePlace.local < currentOwnership.count() {
                        currentOwnership.set(i: sourcePlace.local, value: <MidOwnership.Consumed />)
                        if sourcePlace.local < currentAccessibility.count() { currentAccessibility.set(i: sourcePlace.local, value: <MidAccessibility.Unavailable />) }
                        if sourcePlace.local < source.locals.len && plan.needsFlag[sourcePlace.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: sourcePlace.local) isSet=false />) }
                    }
                }
                if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                    val destination: MidPlaceNode = arena.places[statement.destination - 1U64]
                    if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < currentOwnership.count() {
                        currentOwnership.set(i: destination.local, value: <MidOwnership.Owned />)
                        if destination.local < currentAccessibility.count() { currentAccessibility.set(i: destination.local, value: <MidAccessibility.Available />) }
                        if destination.local < source.locals.len && plan.needsFlag[destination.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: destination.local) isSet=true />) }
                    }
                }
            } else if statement.tag == 8U64 {
                // A fresh global has no old ownership to release. Transfer only
                // the temporary source and leave the destination outside local
                // drop-flag accounting.
                arena.statements.append(statement)
                if statement.source != 0U64 && statement.source <= arena.places.count() {
                    val sourcePlace: MidPlaceNode = arena.places[statement.source - 1U64]
                    if canonicalMidIsLocalRoot(place: sourcePlace) && sourcePlace.projections.len == 0U64 && sourcePlace.local < currentOwnership.count() {
                        currentOwnership.set(i: sourcePlace.local, value: <MidOwnership.Consumed />)
                        if sourcePlace.local < currentAccessibility.count() { currentAccessibility.set(i: sourcePlace.local, value: <MidAccessibility.Unavailable />) }
                        if sourcePlace.local < source.locals.len && plan.needsFlag[sourcePlace.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: sourcePlace.local) isSet=false />) }
                    }
                }
            } else if statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
                arena.statements.append(statement)
                if statement.destination != 0U64 && statement.destination <= arena.places.count() {
                    val place: MidPlaceNode = arena.places[statement.destination - 1U64]
                    if canonicalMidIsLocalRoot(place: place) && place.projections.len == 0U64 && place.local < currentOwnership.count() {
                        currentOwnership.set(i: place.local, value: <MidOwnership.Consumed />)
                        if place.local < currentAccessibility.count() { currentAccessibility.set(i: place.local, value: <MidAccessibility.Unavailable />) }
                        if place.local < source.locals.len && plan.needsFlag[place.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: place.local) isSet=false />) }
                    }
                }
            } else if statement.tag == 12U64 {
                local = statement.bindingLocal
                if local < source.locals.len && local < currentOwnership.count() {
                    val place: U64 = canonicalMidAppendRootPlace(arena: inout arena, body: source, local: local)
                    match currentOwnership[local] {
                        // A capture cell's logical value is not its
                        // lexical owner. Scope cleanup releases the
                        // cell; an overwrite elsewhere still uses
                        // tag=3 to drop only the current logical T.
                        MidOwnership.Owned => {
                            val declaration: MidLocalDecl = arena.locals[source.locals.start + local]
                            if declaration.isBorrowed || declaration.isInout { }
                            else if declaration.isCaptureCell { arena.statements.append(<MidStatementNode tag=10U64 destination=place />) }
                            else { arena.statements.append(<MidStatementNode tag=3U64 destination=place />) }
                        }
                        MidOwnership.MaybeOwned => {
                            val declaration: MidLocalDecl = arena.locals[source.locals.start + local]
                            if !declaration.isBorrowed && !declaration.isInout && plan.needsFlag[local] { arena.statements.append(<MidStatementNode tag=4U64 destination=place flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: local) />) }
                        }
                        _ => {}
                    }
                    if plan.needsFlag[local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: local) isSet=false />) }
                    currentOwnership.set(i: local, value: <MidOwnership.Consumed />)
                    if local < currentAccessibility.count() { currentAccessibility.set(i: local, value: <MidAccessibility.Unavailable />) }
                }
            } else if statement.tag == 6U64 {
                if statement.scope < source.scopes.len {
                    val scope: MidScope = arena.scopes[source.scopes.start + statement.scope]
                    local = scope.firstLocal + scope.localCount
                    while local > scope.firstLocal {
                        local = local - 1U64
                        if local < source.locals.len && local < currentOwnership.count() {
                            val place: U64 = canonicalMidAppendRootPlace(arena: inout arena, body: source, local: local)
                            match currentOwnership[local] {
                                // A capture cell's logical value is not its
                                // lexical owner. Scope cleanup releases the
                                // cell; an overwrite elsewhere still uses
                                // tag=3 to drop only the current logical T.
                                MidOwnership.Owned => {
                                    val declaration: MidLocalDecl = arena.locals[source.locals.start + local]
                                    if declaration.isBorrowed || declaration.isInout { }
                                    else if declaration.isCaptureCell { arena.statements.append(<MidStatementNode tag=10U64 destination=place />) }
                                    else { arena.statements.append(<MidStatementNode tag=3U64 destination=place />) }
                                }
                                MidOwnership.MaybeOwned => {
                                    val declaration: MidLocalDecl = arena.locals[source.locals.start + local]
                                    if !declaration.isBorrowed && !declaration.isInout && plan.needsFlag[local] { arena.statements.append(<MidStatementNode tag=4U64 destination=place flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: local) />) }
                                }
                                _ => {}
                            }
                            currentOwnership.set(i: local, value: <MidOwnership.Consumed />)
                            if local < currentAccessibility.count() { currentAccessibility.set(i: local, value: <MidAccessibility.Unavailable />) }
                        }
                    }
                }
            } else {
                arena.statements.append(statement)
            }
            statementI = statementI + 1U64
        }

        if block.terminator != 0U64 && block.terminator <= arena.terminators.count() {
            val term: MidTerminatorNode = arena.terminators[block.terminator - 1U64]
            if term.tag == 4U64 || term.tag == 10U64 {
                if term.callReceiver != 0U64 && term.callReceiver <= arena.callReceivers.count() {
                    val receiver: MidCallReceiverNode = arena.callReceivers[term.callReceiver - 1U64]
                    val moved: U64 = canonicalMidMovedRoot(arena: arena, operandId: receiver.operand)
                    if moved < source.locals.len && plan.needsFlag[moved] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: moved) isSet=false />) }
                }
                mut val argumentI: U64 = 0U64
                while argumentI < term.args.len {
                    val moved: U64 = canonicalMidMovedRoot(arena: arena, operandId: arena.callArguments[term.args.start + argumentI])
                    if moved < source.locals.len && plan.needsFlag[moved] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: moved) isSet=false />) }
                    argumentI = argumentI + 1U64
                }
                if term.destination != 0U64 && term.destination <= arena.places.count() {
                    val destination: MidPlaceNode = arena.places[term.destination - 1U64]
                    if canonicalMidIsLocalRoot(place: destination) && destination.projections.len == 0U64 && destination.local < source.locals.len && plan.needsFlag[destination.local] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: destination.local) isSet=true />) }
                }
            }
            if term.tag == 6U64 {
                val moved: U64 = canonicalMidMovedRoot(arena: arena, operandId: term.value)
                if moved < source.locals.len && plan.needsFlag[moved] { arena.statements.append(<MidStatementNode tag=5U64 flag=canonicalMidFlagLocal(plan: plan, sourceLocalCount: source.locals.len, local: moved) isSet=false />) }
            }
        }
        val terminator: U64 = canonicalMidCopyIdentityTerminator(arena: inout arena, terminatorId: block.terminator)
        arena.blocks.append(<MidBlockNode statements=<MidRange start=statementStart len=arena.statements.count() - statementStart /> terminator=terminator />)
        blockI = blockI + 1U64
    }
    mut val entry: U64 = source.entry
    if arena.locals.count() > locals.start + source.locals.len {
        entry = canonicalMidAppendDropFlagEntry(arena: inout arena, body: source, plan: plan, target: source.entry, blockStart: blockStart)
    }
    val result: MidBodyNode = <MidBodyNode bodyInstance=source.bodyInstance sourceFunction=source.sourceFunction locals=locals scopes=scopes blocks=<MidRange start=blockStart len=arena.blocks.count() - blockStart /> entry=entry />
    val resultId: MidCanonicalBody = <MidCanonicalBody body=arena.bodies.count() + 1U64 />
    arena.bodies.append(result)
    if !arena.isWellFormed(body: resultId) { return <MidCanonicalBody body=0U64 /> }
    return resultId
}

// Shared lattice joins for canonical ownership and accessibility.
fn midJoinOwnershipStates(states: inout Array[MidOwnership], incoming: Array[MidOwnership]) -> Bool {
    mut val changed: Bool = false
    mut val index: U64 = 0U64
    while index < states.count() {
        val before: MidOwnership = states[index]
        val joined: MidOwnership = midOwnershipJoin(left: before, right: incoming[index])
        val differs: Bool = match before {
            MidOwnership.Owned => match joined { MidOwnership.Owned => false, _ => true },
            MidOwnership.Consumed => match joined { MidOwnership.Consumed => false, _ => true },
            MidOwnership.MaybeOwned => match joined { MidOwnership.MaybeOwned => false, _ => true }
        }
        if differs {
            states.set(i: index, value: joined)
            changed = true
        }
        index += 1U64
    }
    return changed
}

fn midJoinAccessibilityStates(states: inout Array[MidAccessibility], incoming: Array[MidAccessibility]) -> Bool {
    mut val changed: Bool = false
    mut val index: U64 = 0U64
    while index < states.count() {
        val before: MidAccessibility = states[index]
        val joined: MidAccessibility = midAccessibilityJoin(left: before, right: incoming[index])
        val differs: Bool = match before {
            MidAccessibility.Available => match joined { MidAccessibility.Available => false, _ => true },
            MidAccessibility.Unavailable => match joined { MidAccessibility.Unavailable => false, _ => true }
        }
        if differs {
            states.set(i: index, value: joined)
            changed = true
        }
        index += 1U64
    }
    return changed
}

fn midOwnershipJoin(left: MidOwnership, right: MidOwnership) -> MidOwnership {
    match left {
        MidOwnership.Owned => {
            match right {
                MidOwnership.Owned => { return <MidOwnership.Owned /> }
                _ => { return <MidOwnership.MaybeOwned /> }
            }
        }
        MidOwnership.Consumed => {
            match right {
                MidOwnership.Consumed => { return <MidOwnership.Consumed /> }
                _ => { return <MidOwnership.MaybeOwned /> }
            }
        }
        MidOwnership.MaybeOwned => { return <MidOwnership.MaybeOwned /> }
    }
}

fn midAccessibilityJoin(left: MidAccessibility, right: MidAccessibility) -> MidAccessibility {
    match left {
        MidAccessibility.Available => {
            match right {
                MidAccessibility.Available => { return <MidAccessibility.Available /> }
                _ => { return <MidAccessibility.Unavailable /> }
            }
        }
        MidAccessibility.Unavailable => { return <MidAccessibility.Unavailable /> }
    }
}
