// Mutable-global effect propagation shared by body-analysis stages.
// Callers supply graph nodes, known call edges, and canonical storage facts.
// This module does not discover bodies, resolve call templates, or finalize
// destruction contracts. Missing edges never constitute a purity proof.
use ./Ir only { MidCanonicalArena, MidOperandNode, MidStatementNode, MidTerminatorNode }
use ./Verify only { canonicalMidValuePlacesOverlap }

struct GlobalAccessEffect {
    pub val body: U64
    pub val place: U64
    pub val writes: Bool
    pub val next: U64
}
pub impl GlobalAccessEffect { factory }
struct GlobalAccessCall {
    pub val caller: U64
    pub val callee: U64
    pub val term: U64
    pub val receiverTag: U64
    pub val next: U64
}
pub impl GlobalAccessCall { factory }
pub struct GlobalAccessGraph {
    mut val heads: Array[U64] = []
    mut val incoming: Array[U64] = []
    mut val effects: Array[GlobalAccessEffect] = []
    mut val calls: Array[GlobalAccessCall] = []
}

pub impl GlobalAccessGraph {
    factory empty() { return <GlobalAccessGraph /> }
}

fn globalPlace(arena: MidCanonicalArena, placeId: U64) -> Bool {
    if placeId == 0U64 { return false }
    val place = arena.places[placeId - 1U64]
    if place.rootTag != 2U64 || !place.globalMutable { return false }
    mut val index = 0U64
    while index < place.projections.len {
        if arena.projections[place.projections.start + index].tag == 3U64 { return false }
        index += 1U64
    }
    return true
}

// Equal paths can have different arena IDs. Deduplicate by storage identity,
// retaining distinct fields and modes. Array indices reserve the container.
fn sameGlobalPath(arena: MidCanonicalArena, first: U64, second: U64) -> Bool {
    val left = arena.places[first - 1U64]
    val right = arena.places[second - 1U64]
    if left.globalTarget != right.globalTarget || left.projections.len != right.projections.len { return false }
    mut val index = 0U64
    while index < left.projections.len {
        val projection = arena.projections[left.projections.start + index]
        val other = arena.projections[right.projections.start + index]
        if projection.tag != other.tag || projection.index != other.index { return false }
        index += 1U64
    }
    return true
}

pub impl GlobalAccessGraph {
    inout fn node() -> U64 {
        val index = self.heads.count()
        self.heads.append(0U64)
        self.incoming.append(0U64)
        return index
    }
    inout fn edge(caller: U64, callee: U64, term: U64 = 0U64, receiverTag: U64 = 0U64) {
        self.calls.append(<GlobalAccessCall caller=caller callee=callee term=term receiverTag=receiverTag next=self.incoming[callee] />)
        self.incoming[callee] = self.calls.count()
    }
    // Follow outgoing dependencies, independently of reverse effect propagation.
    fn reachableDependencies(rootCount: U64) -> Array[Bool] {
        mut val reached: Array[Bool] = []
        mut val outgoing: Array[U64] = []
        mut val next: Array[U64] = []
        mut val pending: Array[U64] = []
        mut val index = 0U64
        while index < self.heads.count() {
            reached.append(index < rootCount)
            outgoing.append(0U64)
            if index < rootCount { pending.append(index) }
            index += 1U64
        }
        index = 0U64
        while index < self.calls.count() {
            val call = self.calls[index]
            next.append(outgoing[call.caller])
            outgoing[call.caller] = index + 1U64
            index += 1U64
        }
        index = 0U64
        while index < pending.count() {
            mut val edge = outgoing[pending[index]]
            while edge != 0U64 {
                val dependency = self.calls[edge - 1U64].callee
                if !reached[dependency] {
                    reached[dependency] = true
                    pending.append(dependency)
                }
                edge = next[edge - 1U64]
            }
            index += 1U64
        }
        return reached
    }

    inout fn add(arena: MidCanonicalArena, body: U64, place: U64, writes: Bool) {
        if !globalPlace(arena: arena, placeId: place) { return }
        mut val entry = self.heads[body]
        while entry != 0U64 {
            val effect = self.effects[entry - 1U64]
            if effect.writes == writes && sameGlobalPath(arena: arena, first: effect.place, second: place) { return }
            entry = effect.next
        }
        self.effects.append(<GlobalAccessEffect body=body place=place writes=writes next=self.heads[body] />)
        self.heads.set(i: body, value: self.effects.count())
    }

    inout fn operand(arena: MidCanonicalArena, body: U64, operandId: U64) {
        if operandId == 0U64 { return }
        val operand = arena.operands[operandId - 1U64]
        mut val place = operand.place
        if operand.accessPlace != 0U64 { place = operand.accessPlace }
        self.add(arena: arena, body: body, place: place, writes: operand.tag == 2U64 || operand.tag == 4U64)
    }

    inout fn statement(arena: MidCanonicalArena, body: U64, statement: MidStatementNode) {
        mut val destination = 0U64
        while destination < statement.destinationCount() {
            self.add(arena: arena, body: body, place: arena.statementDestinationAt(statement: statement, index: destination), writes: true)
            destination += 1U64
        }
        self.add(arena: arena, body: body, place: statement.source, writes: false)
        if statement.value != 0U64 {
            val value = arena.rvalues[statement.value - 1U64]
            self.add(arena: arena, body: body, place: value.place, writes: false)
            mut val operand = 0U64
            while operand < value.operandCount() {
                self.operand(arena: arena, body: body, operandId: arena.rvalueOperandAt(value: value, index: operand))
                operand += 1U64
            }
        }
    }

    inout fn terminatorOperands(arena: MidCanonicalArena, body: U64, term: MidTerminatorNode) {
        mut val operand = 0U64
        while operand < arena.terminatorOperandCount(term: term) {
            self.operand(arena: arena, body: body, operandId: arena.terminatorOperandAt(term: term, index: operand))
            operand += 1U64
        }
    }

    fn conflicts(arena: MidCanonicalArena, callee: U64, operand: MidOperandNode, receiver: Bool, receiverTag: U64 = 0U64) -> Bool {
        val mode = if receiverTag == 0U64 { give operand.tag } else { give receiverTag }
        if mode != 4U64 && !(mode == 3U64 && (receiver || operand.borrowsStorage)) { return false }
        mut val place = operand.place
        if operand.accessPlace != 0U64 { place = operand.accessPlace }
        if !globalPlace(arena: arena, placeId: place) { return false }
        mut val entry = self.heads[callee]
        while entry != 0U64 {
            val effect = self.effects[entry - 1U64]
            if (mode == 4U64 || effect.writes) && canonicalMidValuePlacesOverlap(arena: arena, leftId: place, rightId: effect.place) { return true }
            entry = effect.next
        }
        return false
    }

    // Returns the one-based caller node containing a conflict, or zero.
    // Nodes are opaque to this solver: declaration bodies, concrete bodies,
    // and destruction summaries are selected by their respective collectors.
    inout fn solve(arena: MidCanonicalArena) -> U64 {
        mut val index = 0U64
        while index < self.effects.count() {
            val effect = self.effects[index]
            mut val entry = self.incoming[effect.body]
            while entry != 0U64 {
                val call = self.calls[entry - 1U64]
                self.add(arena: arena, body: call.caller, place: effect.place, writes: effect.writes)
                entry = call.next
            }
            index += 1U64
        }
        index = 0U64
        while index < self.calls.count() {
            val call = self.calls[index]
            if call.term == 0U64 { index += 1U64
                continue }
            val term = arena.terminators[call.term - 1U64]
            if term.callReceiver != 0U64 {
                val receiver = arena.callReceivers[term.callReceiver - 1U64]
                if receiver.operand != 0U64 && self.conflicts(arena: arena, callee: call.callee, operand: arena.operands[receiver.operand - 1U64], receiver: true, receiverTag: call.receiverTag) { return call.caller + 1U64 }
            }
            mut val argument = 0U64
            while argument < term.args.len {
                if self.conflicts(arena: arena, callee: call.callee, operand: arena.operands[arena.callArguments[term.args.start + argument] - 1U64], receiver: false) { return call.caller + 1U64 }
                argument += 1U64
            }
            index += 1U64
        }
        return 0U64
    }
}
