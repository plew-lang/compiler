// Instance-specific get-modify-set elaboration.  Parametric Mid retains an
// Access marker because the selected inout ABI belongs to a BodyInstance;
// this pass consumes only frozen SemanticAccess and already-resolved calls.

import ../Frontend with { Comp }
import ../Ir with { Expr, SemanticAccess, SemanticAccessInput, CallResolution, CallReceiverPassing, CallArgumentPassing }
import ../Diag with { eprintU64 }
import @Std/Io with { eprint }
import ./Ir with { MidRange, MidBodyNode, MidBlockNode, MidPlaceNode, MidProjectionNode, MidOperandNode, MidCallTargetNode, MidCallReceiverNode, MidStatementNode, MidRvalueNode, MidTerminatorNode, MidSwitchCase, MidCanonicalBody, MidTerminator, MidLocalDecl, MidBody, canonicalMidBorrowPlace, canonicalMidMovePlace }

export enum MidAccessError {
    None
    MissingOuterSemanticAccess
    AccessRoleMismatch
    UnresolvedAccessCall
    ParentAccessArgumentMissing
    ParentAccessArgumentMismatch
    InvalidAccessChain
    UnsupportedAccessBase
    UnsupportedAccessKey
    UnsupportedAccessProjection
    UnsupportedSetterReceiver
}

export struct MidCanonicalAccessElaboration {
    pub val body: MidCanonicalBody = <MidCanonicalBody body=0U64 />
    pub val error: MidAccessError = <MidAccessError.None />
}
pub impl MidCanonicalAccessElaboration { factory }

struct MidCanonicalAccessSite {
    pub val candidate: U64 = 0U64
    pub val role: U64 = 0U64
    pub val parentResolution: U64 = 0U64
    pub val chainLen: U64 = 0U64
}
pub impl MidCanonicalAccessSite { factory }

// One source access expansion is an evaluation DAG, not merely a nested
// receiver chain.  A getter result may feed either a receiver or a key, but
// only `tag=2` mutable-access nodes participate in the reverse setter chain.
// `tag=1` is a frozen SemanticAccessInput.GetterValue; `tag=2` is one stage
// of the selected inout access chain; tag=3 retains a reference input.
struct MidCanonicalAccessOperation {
    pub val tag: U64 = 0U64
    pub val inputId: U64 = 0U64
    pub val marker: U64 = 0U64
    pub val stage: U64 = 0U64
    pub val accessId: U64 = 0U64
}
pub impl MidCanonicalAccessOperation { factory }

struct MidCanonicalAccessPlan {
    pub mut val operations: Array[MidCanonicalAccessOperation] = []
    // Getter inputs are unique within one source call evaluation.  Their
    // stable local homes make a getter key available again to its setter
    // without re-evaluation.
    pub mut val materializedInputs: Array[U64] = []
    pub val valid: Bool = true
}
pub impl MidCanonicalAccessPlan { factory }

fn canonicalAccessLocalPlace(c: inout Comp, body: MidBodyNode, declarationTarget: U64, typeTerm: U64) -> U64 {
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        val local: MidLocalDecl = c.mid.locals[body.locals.start + localI]
        if local.sourceNameStart == declarationTarget {
            c.mid.places.append(<MidPlaceNode local=localI typeTerm=typeTerm />)
            return c.mid.places.count()
        }
        localI = localI + 1U64
    }
    return 0U64
}

fn canonicalAccessGlobalPlace(c: inout Comp, declarationTarget: U64, typeTerm: U64, mutable: Bool) -> U64 {
    // `declarationTarget` is the frozen semantic identity; mapping it to the
    // emitted storage row is LLVM's responsibility. Access must not turn it
    // into a synthetic local or recover source spelling.
    c.mid.places.append(<MidPlaceNode rootTag=2U64 local=0U64 globalTarget=declarationTarget globalMutable=mutable typeTerm=typeTerm />)
    return c.mid.places.count()
}

// Materialize a selected semantic input without looking at Expr/TypeCache.
// Root is nonzero only for the getter-value projection passed to a parent.
fn canonicalAccessInputPlace(c: inout Comp, body: MidBodyNode, inputId: U64, root: U64, plan: MidCanonicalAccessPlan, recipeLocalBase: U64, mutableLocalCount: U64) -> U64 {
    if inputId == 0U64 || inputId > c.arena.semanticAccessInputs.count() { return 0U64 }
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[inputId - 1U64]
    match input.tag {
        1U64 => { return canonicalAccessLocalPlace(c: inout c, body: body, declarationTarget: input.declarationTarget, typeTerm: input.typeTerm) }
        5U64 => { return canonicalAccessGlobalPlace(c: inout c, declarationTarget: input.declarationTarget, typeTerm: input.typeTerm, mutable: input.globalMutable) }
        3U64 => {
            val base: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: input.base, root: root, plan: plan, recipeLocalBase: recipeLocalBase, mutableLocalCount: mutableLocalCount)
            if base == 0U64 || base > c.mid.places.count() { return 0U64 }
            val parent: MidPlaceNode = c.mid.places[base - 1U64]
            val projectionStart: U64 = c.mid.projections.count()
            mut val projectionI: U64 = 0U64
            while projectionI < parent.projections.len {
                c.mid.projections.append(c.mid.projections[parent.projections.start + projectionI])
                projectionI = projectionI + 1U64
            }
            c.mid.projections.append(<MidProjectionNode tag=1U64 isBoxed=input.fieldIsBoxed index=input.fieldIndex typeTerm=input.typeTerm />)
            c.mid.places.append(<MidPlaceNode rootTag=parent.rootTag local=parent.local globalTarget=parent.globalTarget globalMutable=parent.globalMutable projections=<MidRange start=projectionStart len=parent.projections.len + 1U64 /> typeTerm=input.typeTerm />)
            return c.mid.places.count()
        }
        7U64 => {
            val local: U64 = canonicalAccessRecipeLocal(plan: plan, inputId: inputId, localBase: recipeLocalBase, mutableLocalCount: mutableLocalCount)
            if local == 0U64 { return 0U64 }
            val projectionStart: U64 = c.mid.projections.count()
            c.mid.projections.append(<MidProjectionNode tag=3U64 typeTerm=input.typeTerm />)
            c.mid.places.append(<MidPlaceNode local=local projections=<MidRange start=projectionStart len=1U64 /> typeTerm=input.typeTerm />)
            return c.mid.places.count()
        }
        4U64 => { return root }
        6U64 => {
            val local: U64 = canonicalAccessRecipeLocal(plan: plan, inputId: inputId, localBase: recipeLocalBase, mutableLocalCount: mutableLocalCount)
            if local == 0U64 { return 0U64 }
            c.mid.places.append(<MidPlaceNode local=local typeTerm=input.typeTerm />)
            return c.mid.places.count()
        }
        _ => { return 0U64 }
    }
}

fn canonicalAccessInputOperand(c: inout Comp, body: MidBodyNode, inputId: U64, root: U64, plan: MidCanonicalAccessPlan, recipeLocalBase: U64, mutableLocalCount: U64) -> U64 {
    if inputId == 0U64 || inputId > c.arena.semanticAccessInputs.count() { return 0U64 }
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[inputId - 1U64]
    if input.tag == 2U64 {
        c.mid.operands.append(<MidOperandNode tag=5U64 integerValue=input.integerValue integerNegative=input.integerNegative integerBool=input.integerBool typeTerm=input.typeTerm />)
        return c.mid.operands.count()
    }
    val place: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: inputId, root: root, plan: plan, recipeLocalBase: recipeLocalBase, mutableLocalCount: mutableLocalCount)
    if place == 0U64 { return 0U64 }
    c.mid.operands.append(<MidOperandNode tag=1U64 place=place />)
    return c.mid.operands.count()
}

fn canonicalAccessFor(c: Comp, bodyId: U64, parentResolution: U64, candidate: U64) -> U64 {
    mut val accessI: U64 = 0U64
    while accessI < c.arena.semanticAccesses.count() {
        val access: SemanticAccess = c.arena.semanticAccesses[accessI]
        if access.bodyId == bodyId && access.parentResolution == parentResolution && access.candidateIndex == candidate && access.write {
            return accessI + 1U64
        }
        accessI = accessI + 1U64
    }
    return 0U64
}

fn canonicalAccessChainLen(c: Comp, bodyId: U64, parentResolution: U64, candidate: U64) -> U64 {
    mut val current: U64 = canonicalAccessFor(c: c, bodyId: bodyId, parentResolution: parentResolution, candidate: candidate)
    mut val count: U64 = 0U64
    while current != 0U64 && count < c.arena.semanticAccesses.count() {
        count = count + 1U64
        val access: SemanticAccess = c.arena.semanticAccesses[current - 1U64]
        if access.nestedCandidate == 0U64 { return count }
        current = canonicalAccessFor(c: c, bodyId: bodyId, parentResolution: access.writeResolution, candidate: access.nestedCandidate - 1U64)
    }
    return 0U64
}

fn canonicalAccessPlanHasValue(plan: MidCanonicalAccessPlan, inputId: U64) -> Bool {
    mut val i: U64 = 0U64
    while i < plan.materializedInputs.count() {
        if plan.materializedInputs[i] == inputId { return true }
        i += 1U64
    }
    return false
}

// Append a value-recipe getter after its dependencies.  The bounded recursion
// is a fail-closed malformed-fact guard; valid frozen recipes descend through
// source child expressions and are acyclic.
fn canonicalAccessPlanInput(c: Comp, inputId: U64, depth: U64, plan: inout MidCanonicalAccessPlan) -> MidCanonicalAccessPlan {
    if !plan.valid || inputId == 0U64 || inputId > c.arena.semanticAccessInputs.count() || depth > c.arena.semanticAccessInputs.count() {
        return <MidCanonicalAccessPlan operations=plan.operations materializedInputs=plan.materializedInputs valid=false />
    }
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[inputId - 1U64]
    match input.tag {
        3U64 => {
            return canonicalAccessPlanInput(c: c, inputId: input.base, depth: depth + 1U64, plan: inout plan)
        }
        7U64 => {
            if canonicalAccessPlanHasValue(plan: plan, inputId: inputId) { return plan }
            val afterBase: MidCanonicalAccessPlan = canonicalAccessPlanInput(c: c, inputId: input.base, depth: depth + 1U64, plan: inout plan)
            if !afterBase.valid { return afterBase }
            if input.base == 0U64 || input.base > c.arena.semanticAccessInputs.count() { return <MidCanonicalAccessPlan operations=plan.operations materializedInputs=plan.materializedInputs valid=false /> }
            plan.materializedInputs.append(inputId)
            plan.operations.append(<MidCanonicalAccessOperation tag=3U64 inputId=inputId />)
            return plan
        }
        6U64 => {
            if canonicalAccessPlanHasValue(plan: plan, inputId: inputId) { return plan }
            val afterBase: MidCanonicalAccessPlan = canonicalAccessPlanInput(c: c, inputId: input.base, depth: depth + 1U64, plan: inout plan)
            if !afterBase.valid { return afterBase }
            val afterKey: MidCanonicalAccessPlan = canonicalAccessPlanInput(c: c, inputId: input.key, depth: depth + 1U64, plan: inout plan)
            if !afterKey.valid { return afterKey }
            plan.materializedInputs.append(inputId)
            plan.operations.append(<MidCanonicalAccessOperation tag=1U64 inputId=inputId />)
            return plan
        }
        1U64 => { return plan }
        2U64 => { return plan }
        4U64 => { return plan }
        5U64 => { return plan }
        _ => { return <MidCanonicalAccessPlan operations=plan.operations materializedInputs=plan.materializedInputs valid=false /> }
    }
}

// Preserve source evaluation order: each mutable getter's receiver recipe is
// materialized before its key recipe, then the getter itself.  The existing
// nestedCandidate relation remains exclusively the writeback spine.
fn canonicalAccessPlanForTerm(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> MidCanonicalAccessPlan {
    mut val plan: MidCanonicalAccessPlan = <MidCanonicalAccessPlan />
    mut val marker: U64 = 0U64
    while marker < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
        if site.role == 0U64 || site.chainLen == 0U64 { return <MidCanonicalAccessPlan operations=plan.operations materializedInputs=plan.materializedInputs valid=false /> }
        mut val stage: U64 = site.chainLen
        while stage > 0U64 {
            stage -= 1U64
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
            if accessId == 0U64 || accessId > c.arena.semanticAccesses.count() { return <MidCanonicalAccessPlan operations=plan.operations materializedInputs=plan.materializedInputs valid=false /> }
            val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
            plan = canonicalAccessPlanInput(c: c, inputId: access.baseInput, depth: 0U64, plan: inout plan)
            if !plan.valid { return plan }
            plan = canonicalAccessPlanInput(c: c, inputId: access.keyInput, depth: 0U64, plan: inout plan)
            if !plan.valid { return plan }
            plan.operations.append(<MidCanonicalAccessOperation tag=2U64 marker=marker stage=stage accessId=accessId />)
        }
        marker += 1U64
    }
    return plan
}

fn canonicalAccessPlanOperationIndex(plan: MidCanonicalAccessPlan, marker: U64, stage: U64) -> U64 {
    mut val i: U64 = 0U64
    while i < plan.operations.count() {
        val operation: MidCanonicalAccessOperation = plan.operations[i]
        if operation.tag == 2U64 && operation.marker == marker && operation.stage == stage { return i + 1U64 }
        i += 1U64
    }
    return 0U64
}

fn canonicalAccessRecipeLocal(plan: MidCanonicalAccessPlan, inputId: U64, localBase: U64, mutableLocalCount: U64) -> U64 {
    mut val i: U64 = 0U64
    while i < plan.materializedInputs.count() {
        if plan.materializedInputs[i] == inputId { return localBase + mutableLocalCount + i }
        i += 1U64
    }
    return 0U64
}

// Finds the one selected inout access marker carried by a parent call. The
// marker itself is already in canonical Mid; SemanticAccess supplies its
// closed storage provenance and read/write resolutions.
fn canonicalAccessSiteAt(c: Comp, body: MidBodyNode, term: MidTerminatorNode, ordinal: U64) -> MidCanonicalAccessSite {
    if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCanonicalAccessSite /> }
    val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
    if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCanonicalAccessSite /> }
    mut val candidate: U64 = 0U64
    mut val role: U64 = 0U64
    mut val seen: U64 = 0U64
    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if receiver.tag == 2U64 && receiver.operand != 0U64 && receiver.operand <= c.mid.operands.count() {
            val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
            if operand.tag == 8U64 {
                if seen == ordinal {
                    candidate = operand.accessCandidate
                    role = 1U64
                }
                seen = seen + 1U64
            }
        }
    }
    if role == 0U64 {
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            val argument: U64 = c.mid.callArguments[term.args.start + argumentI]
            if argument != 0U64 && argument <= c.mid.operands.count() {
                val operand: MidOperandNode = c.mid.operands[argument - 1U64]
                if operand.tag == 8U64 {
                    if seen == ordinal {
                        candidate = operand.accessCandidate
                        role = 2U64
                    }
                    seen = seen + 1U64
                }
            }
            argumentI = argumentI + 1U64
        }
    }
    if role == 0U64 { return <MidCanonicalAccessSite /> }
    val chainLen: U64 = canonicalAccessChainLen(c: c, bodyId: body.bodyInstance, parentResolution: target.resolution, candidate: candidate)
    if chainLen == 0U64 { return <MidCanonicalAccessSite role=role parentResolution=target.resolution /> }
    return <MidCanonicalAccessSite candidate=candidate role=role parentResolution=target.resolution chainLen=chainLen />
}

fn canonicalAccessSite(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> MidCanonicalAccessSite {
    return canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: 0U64)
}

fn canonicalAccessMarkerCount(c: Comp, term: MidTerminatorNode) -> U64 {
    if term.tag != 4U64 { return 0U64 }
    mut val count: U64 = 0U64
    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if receiver.tag == 2U64 && receiver.operand != 0U64 && receiver.operand <= c.mid.operands.count() && c.mid.operands[receiver.operand - 1U64].tag == 8U64 { count = count + 1U64 }
    }
    mut val argumentI: U64 = 0U64
    while argumentI < term.args.len {
        val argument: U64 = c.mid.callArguments[term.args.start + argumentI]
        if argument != 0U64 && argument <= c.mid.operands.count() && c.mid.operands[argument - 1U64].tag == 8U64 { count = count + 1U64 }
        argumentI = argumentI + 1U64
    }
    return count
}

// The source block begins the dependency-ordered getter plan.  Each plan
// operation owns one getter block, followed by one parent call and a
// setter/cleanup pair for each mutable base-chain facet.
fn canonicalAccessBlockWidth(c: Comp, body: MidBodyNode, blockI: U64) -> U64 {
    if blockI >= body.blocks.len { return 0U64 }
    val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
    if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return 1U64 }
    val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
    val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
    if markerCount == 0U64 { return 1U64 }
    val plan: MidCanonicalAccessPlan = canonicalAccessPlanForTerm(c: c, body: body, term: term)
    if !plan.valid { return 1U64 }
    mut val totalChainLen: U64 = 0U64
    mut val markerI: U64 = 0U64
    while markerI < markerCount {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        if site.role == 0U64 || site.chainLen == 0U64 { return 1U64 }
        totalChainLen = totalChainLen + site.chainLen
        markerI = markerI + 1U64
    }
    return plan.operations.count() + 1U64 + totalChainLen * 2U64
}

fn canonicalAccessBlockStart(c: Comp, body: MidBodyNode, target: U64) -> U64 {
    mut val start: U64 = 0U64
    mut val blockI: U64 = 0U64
    while blockI < target && blockI < body.blocks.len {
        start = start + canonicalAccessBlockWidth(c: c, body: body, blockI: blockI)
        blockI = blockI + 1U64
    }
    return start
}

// A canonical access rewrite owns a new block slice.  Statement/rvalue and
// operand rows are immutable global facts, but blocks and terminators contain
// CFG-relative targets and must be copied into that slice.  Keeping the
// remapping here (rather than in LLVM) makes every downstream Mid consumer
// see the same closed CFG.
fn canonicalAccessRemapTarget(c: Comp, body: MidBodyNode, target: U64) -> U64 {
    return canonicalAccessBlockStart(c: c, body: body, target: target)
}

fn canonicalAccessCopyStatements(c: inout Comp, block: MidBlockNode) -> MidRange {
    val start: U64 = c.mid.statements.count()
    mut val statementI: U64 = 0U64
    while statementI < block.statements.len {
        c.mid.statements.append(c.mid.statements[block.statements.start + statementI])
        statementI = statementI + 1U64
    }
    return <MidRange start=start len=block.statements.len />
}

// This is deliberately a scalar-row copy, not a thaw into MidTerminator.
// Existing operands/places remain immutable IDs; only control-flow edges and
// their owner-specific argument/case ranges are recreated.
fn canonicalAccessCopyTerminator(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> U64 {
    if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return 0U64 }
    val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
    match term.tag {
        1U64 => { c.mid.terminators.append(<MidTerminatorNode tag=1U64 />) }
        2U64 => { c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=canonicalAccessRemapTarget(c: c, body: body, target: term.target) />) }
        3U64 => {
            val caseStart: U64 = c.mid.switchCases.count()
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                val item: MidSwitchCase = c.mid.switchCases[term.cases.start + caseI]
                c.mid.switchCases.append(<MidSwitchCase value=item.value target=canonicalAccessRemapTarget(c: c, body: body, target: item.target) />)
                caseI = caseI + 1U64
            }
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=term.discriminant cases=<MidRange start=caseStart len=term.cases.len /> otherwise=canonicalAccessRemapTarget(c: c, body: body, target: term.otherwise) />)
        }
        4U64 => {
            val argumentStart: U64 = c.mid.callArguments.count()
            mut val argumentI: U64 = 0U64
            while argumentI < term.args.len {
                c.mid.callArguments.append(c.mid.callArguments[term.args.start + argumentI])
                argumentI = argumentI + 1U64
            }
            mut val callTarget: U64 = 0U64
            if term.callTarget != 0U64 && term.callTarget <= c.mid.callTargets.count() {
                c.mid.callTargets.append(c.mid.callTargets[term.callTarget - 1U64])
                callTarget = c.mid.callTargets.count()
            }
            mut val callReceiver: U64 = 0U64
            if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
                c.mid.callReceivers.append(c.mid.callReceivers[term.callReceiver - 1U64])
                callReceiver = c.mid.callReceivers.count()
            }
            c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=canonicalAccessRemapTarget(c: c, body: body, target: term.target) args=<MidRange start=argumentStart len=term.args.len /> destination=term.destination callTarget=callTarget callReceiver=callReceiver />)
        }
        5U64 => { c.mid.terminators.append(<MidTerminatorNode tag=5U64 />) }
        6U64 => { c.mid.terminators.append(<MidTerminatorNode tag=6U64 value=term.value />) }
        7U64 => { c.mid.terminators.append(<MidTerminatorNode tag=7U64 value=term.value />) }
        8U64 => { c.mid.terminators.append(<MidTerminatorNode tag=8U64 />) }
        9U64 => { c.mid.terminators.append(<MidTerminatorNode tag=9U64 />) }
        10U64 => { c.mid.terminators.append(<MidTerminatorNode tag=10U64 state=term.state resume=canonicalAccessRemapTarget(c: c, body: body, target: term.resume) exprId=term.exprId value=term.value destination=term.destination />) }
        _ => { return 0U64 }
    }
    return c.mid.terminators.count()
}

fn canonicalAccessChainAt(c: Comp, body: MidBodyNode, site: MidCanonicalAccessSite, stage: U64) -> U64 {
    mut val current: U64 = canonicalAccessFor(c: c, bodyId: body.bodyInstance, parentResolution: site.parentResolution, candidate: site.candidate)
    mut val currentStage: U64 = 0U64
    while current != 0U64 && currentStage < stage {
        val access: SemanticAccess = c.arena.semanticAccesses[current - 1U64]
        if access.nestedCandidate == 0U64 { return 0U64 }
        current = canonicalAccessFor(c: c, bodyId: body.bodyInstance, parentResolution: access.writeResolution, candidate: access.nestedCandidate - 1U64)
        currentStage = currentStage + 1U64
    }
    return current
}

fn canonicalAccessMarkerLocalBase(c: Comp, body: MidBodyNode, term: MidTerminatorNode, localBase: U64, marker: U64) -> U64 {
    mut val local: U64 = localBase
    mut val markerI: U64 = 0U64
    while markerI < marker {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = 0U64
        while stage < site.chainLen {
            local += 2U64
            stage = stage + 1U64
        }
        markerI = markerI + 1U64
    }
    return local
}

fn canonicalAccessSetterLocal(c: Comp, body: MidBodyNode, term: MidTerminatorNode, localBase: U64, marker: U64, stage: U64) -> U64 {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val base: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker)
    return base + site.chainLen + stage
}

fn canonicalAccessAppendLocals(c: inout Comp, body: MidBodyNode) -> MidAccessError {
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        c.mid.locals.append(c.mid.locals[body.locals.start + localI])
        localI = localI + 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
            val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
            val plan: MidCanonicalAccessPlan = canonicalAccessPlanForTerm(c: c, body: body, term: term)
            if markerCount != 0U64 && !plan.valid {
                if c.traceCodegen {
                    eprint(text: "[trace-codegen] Mid access invalid plan block=")
                    eprintU64(n: blockI)
                    mut val marker: U64 = 0U64
                    while marker < markerCount {
                        val site = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
                        eprint(text: " marker=")
                        eprintU64(n: marker)
                        eprint(text: " candidate=")
                        eprintU64(n: site.candidate)
                        eprint(text: " parent=")
                        eprintU64(n: site.parentResolution)
                        eprint(text: " role=")
                        eprintU64(n: site.role)
                        eprint(text: " chain=")
                        eprintU64(n: site.chainLen)
                        marker += 1U64
                    }
                    eprint(text: "\n")
                }
                return <MidAccessError.InvalidAccessChain />
            }
            mut val markerI: U64 = 0U64
            while markerI < markerCount {
                val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
                if site.role == 0U64 || site.chainLen == 0U64 { return <MidAccessError.MissingOuterSemanticAccess /> }
                val outerId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: 0U64)
                if outerId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
                val outer: SemanticAccess = c.arena.semanticAccesses[outerId - 1U64]
                if outer.role != site.role { return <MidAccessError.AccessRoleMismatch /> }
                mut val stage: U64 = 0U64
                while stage < site.chainLen {
                    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
                    if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
                    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
                    if !access.write || access.readResolution >= c.arena.finalCallees.count() || access.writeResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
                    c.mid.locals.append(<MidLocalDecl typeTerm=access.valueTerm sourceScope=0U64 isUnique=false isParameter=false />)
                    stage = stage + 1U64
                }
                stage = 0U64
                while stage < site.chainLen {
                    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
                    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
                    // Even a Unit-returning call has its own result local.
                    // Never alias a still-live getter value as a call result.
                    val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
                    c.mid.locals.append(<MidLocalDecl typeTerm=setter.resultTypeRef sourceScope=0U64 isUnique=false isParameter=false />)
                    stage = stage + 1U64
                }
                markerI = markerI + 1U64
            }
            // Recipe getter results are ordinary owned temporaries.  They are
            // allocated after the mutable chain locals so the latter retain
            // their stable existing indices; each recipe appears once and is
            // reused by both its getter and its eventual setter.
            mut val recipeI: U64 = 0U64
            while recipeI < plan.materializedInputs.count() {
                val inputId: U64 = plan.materializedInputs[recipeI]
                if inputId == 0U64 || inputId > c.arena.semanticAccessInputs.count() { return <MidAccessError.InvalidAccessChain /> }
                val input: SemanticAccessInput = c.arena.semanticAccessInputs[inputId - 1U64]
                mut val localTerm: U64 = input.typeTerm
                if input.tag == 7U64 {
                    if input.base == 0U64 || input.base > c.arena.semanticAccessInputs.count() { return <MidAccessError.InvalidAccessChain /> }
                    localTerm = c.arena.semanticAccessInputs[input.base - 1U64].typeTerm
                    if !c.isStrongRefInst(ref: localTerm) || !c.typeRefEq(a: c.arena.typeAt(index: localTerm).args[0U64], b: input.typeTerm) { return <MidAccessError.InvalidAccessChain /> }
                } else if input.tag != 6U64 || input.readResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
                c.mid.locals.append(<MidLocalDecl typeTerm=localTerm sourceScope=0U64 isUnique=false isParameter=false />)
                recipeI += 1U64
            }
        }
        blockI = blockI + 1U64
    }
    return <MidAccessError.None />
}

fn canonicalAccessAppendPlace(c: inout Comp, local: U64, typeTerm: U64) -> U64 {
    c.mid.places.append(<MidPlaceNode local=local typeTerm=typeTerm />)
    return c.mid.places.count()
}

fn canonicalAccessAppendCopy(c: inout Comp, place: U64) -> U64 {
    if place == 0U64 || place > c.mid.places.count() { return 0U64 }
    c.mid.operands.append(<MidOperandNode tag=1U64 place=place />)
    return c.mid.operands.count()
}

fn canonicalAccessAppendInoutBorrow(c: inout Comp, place: U64) -> U64 {
    return canonicalMidBorrowPlace(arena: inout c.mid, place: place, capability: 2U64)
}

fn canonicalAccessAppendReadBorrow(c: inout Comp, place: U64) -> U64 {
    return canonicalMidBorrowPlace(arena: inout c.mid, place: place, capability: 1U64)
}

fn canonicalAccessAppendMove(c: inout Comp, place: U64) -> U64 {
    return canonicalMidMovePlace(arena: inout c.mid, place: place)
}

fn canonicalAccessBaseOperand(c: inout Comp, body: MidBodyNode, access: SemanticAccess, nestedValuePlace: U64, plan: MidCanonicalAccessPlan, recipeLocalBase: U64, mutableLocalCount: U64) -> U64 {
    if nestedValuePlace != 0U64 { return canonicalAccessAppendCopy(c: inout c, place: nestedValuePlace) }
    return canonicalAccessInputOperand(c: inout c, body: body, inputId: access.baseInput, root: 0U64, plan: plan, recipeLocalBase: recipeLocalBase, mutableLocalCount: mutableLocalCount)
}

fn canonicalAccessKeyOperand(c: inout Comp, body: MidBodyNode, access: SemanticAccess, plan: MidCanonicalAccessPlan, recipeLocalBase: U64, mutableLocalCount: U64) -> U64 {
    return canonicalAccessInputOperand(c: inout c, body: body, inputId: access.keyInput, root: 0U64, plan: plan, recipeLocalBase: recipeLocalBase, mutableLocalCount: mutableLocalCount)
}

fn canonicalAccessAppendResolvedTarget(c: inout Comp, resolution: U64) -> U64 {
    if resolution >= c.arena.finalCallees.count() { return 0U64 }
    c.mid.callTargets.append(<MidCallTargetNode tag=2U64 resolution=resolution />)
    return c.mid.callTargets.count()
}

fn canonicalAccessAppendValueReceiver(c: inout Comp, operand: U64) -> U64 {
    if operand == 0U64 || operand > c.mid.operands.count() { return 0U64 }
    c.mid.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=operand />)
    return c.mid.callReceivers.count()
}

// Access elaboration creates calls after normal instantiation has already
// selected their ABI.  It must therefore derive the receiver operand from
// that frozen CallResolution, just as instantiation does; a raw Copy is a
// place value, not automatically a Borrow receiver.  This keeps the emitted
// call closed over Mid facts and makes `fn index` (read borrow) distinct from
// `inout fn indexSet` (mutable borrow).
fn canonicalAccessAppendSelectedReceiver(c: inout Comp, operandId: U64, resolution: U64) -> U64 {
    if resolution >= c.arena.finalCallees.count() || operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
    val selected: CallResolution = c.arena.finalCallees[resolution]
    val source: MidOperandNode = c.mid.operands[operandId - 1U64]
    mut val operand: U64 = operandId
    match selected.receiverPassing {
        CallReceiverPassing.Borrow => {
            if source.tag == 1U64 { operand = canonicalAccessAppendReadBorrow(c: inout c, place: source.place) }
            else if source.tag != 3U64 || source.capability != 1U64 { return 0U64 }
        }
        CallReceiverPassing.Inout => {
            if source.tag == 1U64 { operand = canonicalAccessAppendInoutBorrow(c: inout c, place: source.place) }
            else if source.tag != 4U64 || source.capability != 2U64 { return 0U64 }
        }
        CallReceiverPassing.Move => {
            if source.tag == 1U64 { operand = canonicalAccessAppendMove(c: inout c, place: source.place) }
            else if source.tag != 2U64 { return 0U64 }
        }
        CallReceiverPassing.None => { return 0U64 }
    }
    return canonicalAccessAppendValueReceiver(c: inout c, operand: operand)
}

// As with receivers, generated accessor arguments cross the ABI described by
// the selected resolution.  In particular, `index(key: K)` normally borrows
// its key while `indexSet(key:value:)` may borrow, lend inout, or consume each
// parameter independently.  The access rewrite has no special calling
// convention of its own.
fn canonicalAccessAppendSelectedArgument(c: inout Comp, operandId: U64, resolution: U64, index: U64) -> U64 {
    if resolution >= c.arena.finalCallees.count() || operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
    val selected: CallResolution = c.arena.finalCallees[resolution]
    if index >= selected.argumentPassings.len { return 0U64 }
    val passing = c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: index)
    val source: MidOperandNode = c.mid.operands[operandId - 1U64]
    match passing {
        CallArgumentPassing.Borrow => {
            if source.tag == 1U64 { return canonicalAccessAppendReadBorrow(c: inout c, place: source.place) }
            if source.tag == 3U64 && source.capability == 1U64 { return operandId }
            if source.tag == 5U64 || source.tag == 6U64 || source.tag == 7U64 { return operandId }
            return 0U64
        }
        CallArgumentPassing.Inout => {
            if source.tag == 1U64 { return canonicalAccessAppendInoutBorrow(c: inout c, place: source.place) }
            if source.tag == 4U64 && source.capability == 2U64 { return operandId }
            return 0U64
        }
        CallArgumentPassing.Move => {
            if source.tag == 1U64 { return canonicalAccessAppendMove(c: inout c, place: source.place) }
            if source.tag == 2U64 { return operandId }
            return 0U64
        }
    }
}

fn canonicalAccessOperationTarget(blockStart: U64, plan: MidCanonicalAccessPlan, operationIndex: U64) -> U64 {
    if operationIndex + 1U64 < plan.operations.count() { return blockStart + operationIndex + 1U64 }
    return blockStart + plan.operations.count()
}

fn canonicalAccessTotalChainLen(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> U64 {
    mut val total: U64 = 0U64
    mut val markerI: U64 = 0U64
    while markerI < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        total = total + site.chainLen
        markerI = markerI + 1U64
    }
    return total
}

fn canonicalAccessGetterStart(c: Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, marker: U64) -> U64 {
    mut val start: U64 = blockStart
    mut val markerI: U64 = 0U64
    while markerI < marker {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        start = start + site.chainLen
        markerI = markerI + 1U64
    }
    return start
}

fn canonicalAccessSetterStart(c: Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, marker: U64, plan: MidCanonicalAccessPlan) -> U64 {
    mut val start: U64 = blockStart + plan.operations.count() + 1U64
    mut val markerI: U64 = marker + 1U64
    while markerI < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        start = start + site.chainLen * 2U64
        markerI = markerI + 1U64
    }
    return start
}

// The last writeback stage starts at the original container, before any
// subscript value became a temporary. Reserve that storage, not the ABI
// address passed to the parent call. Indices deliberately do not distinguish
// two accesses to the same container (spec/03).
fn canonicalAccessParentBorrow(c: inout Comp, body: MidBodyNode, site: MidCanonicalAccessSite, place: U64, localBase: U64, plan: MidCanonicalAccessPlan, mutableLocalCount: U64) -> U64 {
    if site.chainLen == 0U64 || place == 0U64 { return 0U64 }
    val rootAccess: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: site.chainLen - 1U64)
    if rootAccess == 0U64 || rootAccess > c.arena.semanticAccesses.count() { return 0U64 }
    val access: SemanticAccess = c.arena.semanticAccesses[rootAccess - 1U64]
    val storage: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: access.baseInput, root: 0U64, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    if storage == 0U64 { return 0U64 }
    c.mid.operands.append(<MidOperandNode tag=4U64 place=place accessPlace=storage capability=2U64 />)
    return c.mid.operands.count()
}

fn canonicalAccessAppendParentTerminator(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, localBase: U64, plan: MidCanonicalAccessPlan, mutableLocalCount: U64) -> MidAccessError {
    if term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val sourceTarget: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
    if sourceTarget.tag != 2U64 || sourceTarget.resolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val argumentStart: U64 = c.mid.callArguments.count()
    mut val markerI: U64 = 0U64
    mut val receiverId: U64 = 0U64
    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
        val sourceReceiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if sourceReceiver.tag == 2U64 && sourceReceiver.operand != 0U64 && sourceReceiver.operand <= c.mid.operands.count() && c.mid.operands[sourceReceiver.operand - 1U64].tag == 8U64 {
            val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: 0U64)
            if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
            val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
            val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: markerI)
            val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
            val projected: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: access.accessInput, root: valuePlace, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
            val borrowed: U64 = canonicalAccessParentBorrow(c: inout c, body: body, site: site, place: projected, localBase: localBase, plan: plan, mutableLocalCount: mutableLocalCount)
            receiverId = canonicalAccessAppendValueReceiver(c: inout c, operand: borrowed)
            if receiverId == 0U64 { return <MidAccessError.UnsupportedAccessProjection /> }
            markerI = markerI + 1U64
        } else {
            c.mid.callReceivers.append(sourceReceiver)
            receiverId = c.mid.callReceivers.count()
        }
    }
    mut val argumentI: U64 = 0U64
    while argumentI < term.args.len {
        val argument: U64 = c.mid.callArguments[term.args.start + argumentI]
        if argument != 0U64 && argument <= c.mid.operands.count() && c.mid.operands[argument - 1U64].tag == 8U64 {
            val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: 0U64)
            if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
            val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
            val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: markerI)
            val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
            val projected: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: access.accessInput, root: valuePlace, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
            val borrowed: U64 = canonicalAccessParentBorrow(c: inout c, body: body, site: site, place: projected, localBase: localBase, plan: plan, mutableLocalCount: mutableLocalCount)
            if borrowed == 0U64 { return <MidAccessError.UnsupportedAccessProjection /> }
            c.mid.callArguments.append(borrowed)
            markerI = markerI + 1U64
        } else {
            c.mid.callArguments.append(argument)
        }
        argumentI = argumentI + 1U64
    }
    if markerI != canonicalAccessMarkerCount(c: c, term: term) { return <MidAccessError.ParentAccessArgumentMismatch /> }
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: sourceTarget.resolution)
    if target == 0U64 || receiverId == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val firstSetter: U64 = canonicalAccessSetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: canonicalAccessMarkerCount(c: c, term: term) - 1U64, plan: plan)
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=firstSetter args=<MidRange start=argumentStart len=term.args.len /> destination=term.destination callTarget=target callReceiver=receiverId />)
    return <MidAccessError.None />
}

// Materialize a frozen getter-value recipe at the exact point prescribed by
// the plan.  Its dependencies have already run, so this function only reads
// closed input nodes and a selected CallResolution; it never navigates Expr or
// reopens Index/IndexSet lookup.
// A reference input is evaluated before its dependent getter/key. The owned
// home pins the same cell until all reverse writebacks have completed.
fn canonicalAccessAppendReference(c: inout Comp, body: MidBodyNode, blockStart: U64, localBase: U64, plan: MidCanonicalAccessPlan, operationIndex: U64, mutableLocalCount: U64, statements: MidRange) -> MidAccessError {
    val operation: MidCanonicalAccessOperation = plan.operations[operationIndex]
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[operation.inputId - 1U64]
    val referenceTerm: U64 = c.arena.semanticAccessInputs[input.base - 1U64].typeTerm
    val local: U64 = canonicalAccessRecipeLocal(plan: plan, inputId: operation.inputId, localBase: localBase, mutableLocalCount: mutableLocalCount)
    val operand: U64 = canonicalAccessInputOperand(c: inout c, body: body, inputId: input.base, root: 0U64, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    if local == 0U64 || operand == 0U64 { return <MidAccessError.UnsupportedAccessBase /> }
    val destination: U64 = canonicalAccessAppendPlace(c: inout c, local: local, typeTerm: referenceTerm)
    val statementStart: U64 = c.mid.statements.count()
    mut val index: U64 = 0U64
    while index < statements.len {
        c.mid.statements.append(c.mid.statements[statements.start + index])
        index += 1U64
    }
    c.mid.rvalues.append(<MidRvalueNode tag=1U64 operand=operand />)
    c.mid.statements.append(<MidStatementNode tag=1U64 destination=destination value=c.mid.rvalues.count() />)
    c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=canonicalAccessOperationTarget(blockStart: blockStart, plan: plan, operationIndex: operationIndex) />)
    c.mid.blocks.append(<MidBlockNode statements=<MidRange start=statementStart len=statements.len + 1U64 /> terminator=c.mid.terminators.count() />)
    return <MidAccessError.None />
}

fn canonicalAccessAppendRecipeGetter(c: inout Comp, body: MidBodyNode, blockStart: U64, localBase: U64, plan: MidCanonicalAccessPlan, operationIndex: U64, mutableLocalCount: U64, statements: MidRange) -> MidAccessError {
    if operationIndex >= plan.operations.count() { return <MidAccessError.InvalidAccessChain /> }
    val operation: MidCanonicalAccessOperation = plan.operations[operationIndex]
    if operation.tag != 1U64 || operation.inputId == 0U64 || operation.inputId > c.arena.semanticAccessInputs.count() { return <MidAccessError.InvalidAccessChain /> }
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[operation.inputId - 1U64]
    if input.tag != 6U64 || input.readResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val local: U64 = canonicalAccessRecipeLocal(plan: plan, inputId: operation.inputId, localBase: localBase, mutableLocalCount: mutableLocalCount)
    if local == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    val destination: U64 = canonicalAccessAppendPlace(c: inout c, local: local, typeTerm: input.typeTerm)
    val base: U64 = canonicalAccessInputOperand(c: inout c, body: body, inputId: input.base, root: 0U64, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    val rawKey: U64 = canonicalAccessInputOperand(c: inout c, body: body, inputId: input.key, root: 0U64, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: input.readResolution)
    val receiver: U64 = canonicalAccessAppendSelectedReceiver(c: inout c, operandId: base, resolution: input.readResolution)
    if destination == 0U64 || base == 0U64 { return <MidAccessError.UnsupportedAccessBase /> }
    if rawKey == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    val key: U64 = canonicalAccessAppendSelectedArgument(c: inout c, operandId: rawKey, resolution: input.readResolution, index: 0U64)
    if key == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    if target == 0U64 || receiver == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val argumentStart: U64 = c.mid.callArguments.count()
    c.mid.callArguments.append(key)
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=canonicalAccessOperationTarget(blockStart: blockStart, plan: plan, operationIndex: operationIndex) args=<MidRange start=argumentStart len=1U64 /> destination=destination callTarget=target callReceiver=receiver />)
    c.mid.blocks.append(<MidBlockNode statements=statements terminator=c.mid.terminators.count() />)
    return <MidAccessError.None />
}

fn canonicalAccessAppendGetter(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, localBase: U64, marker: U64, stage: U64, plan: MidCanonicalAccessPlan, operationIndex: U64, mutableLocalCount: U64, statements: MidRange) -> MidAccessError {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
    if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
    val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage
    val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
    mut val nestedPlace: U64 = 0U64
    if stage + 1U64 < site.chainLen {
        val nestedId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage + 1U64)
        if nestedId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
        val nested: SemanticAccess = c.arena.semanticAccesses[nestedId - 1U64]
        nestedPlace = canonicalAccessAppendPlace(c: inout c, local: canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage + 1U64, typeTerm: nested.valueTerm)
    }
    val base: U64 = canonicalAccessBaseOperand(c: inout c, body: body, access: access, nestedValuePlace: nestedPlace, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    val rawKey: U64 = canonicalAccessKeyOperand(c: inout c, body: body, access: access, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: access.readResolution)
    val receiver: U64 = canonicalAccessAppendSelectedReceiver(c: inout c, operandId: base, resolution: access.readResolution)
    if base == 0U64 { return <MidAccessError.UnsupportedAccessBase /> }
    if rawKey == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    val key: U64 = canonicalAccessAppendSelectedArgument(c: inout c, operandId: rawKey, resolution: access.readResolution, index: 0U64)
    if key == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    if target == 0U64 || receiver == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val argumentStart: U64 = c.mid.callArguments.count()
    c.mid.callArguments.append(key)
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=canonicalAccessOperationTarget(blockStart: blockStart, plan: plan, operationIndex: operationIndex) args=<MidRange start=argumentStart len=1U64 /> destination=valuePlace callTarget=target callReceiver=receiver />)
    c.mid.blocks.append(<MidBlockNode statements=statements terminator=c.mid.terminators.count() />)
    return <MidAccessError.None />
}

fn canonicalAccessAppendSetter(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, localBase: U64, marker: U64, stage: U64, plan: MidCanonicalAccessPlan, mutableLocalCount: U64) -> MidAccessError {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
    if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
    val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage
    val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
    mut val nestedPlace: U64 = 0U64
    if stage + 1U64 < site.chainLen {
        val nestedId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage + 1U64)
        if nestedId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
        val nested: SemanticAccess = c.arena.semanticAccesses[nestedId - 1U64]
        nestedPlace = canonicalAccessAppendPlace(c: inout c, local: canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage + 1U64, typeTerm: nested.valueTerm)
    }
    mut val base: U64 = canonicalAccessBaseOperand(c: inout c, body: body, access: access, nestedValuePlace: nestedPlace, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    val rawKey: U64 = canonicalAccessKeyOperand(c: inout c, body: body, access: access, plan: plan, recipeLocalBase: localBase, mutableLocalCount: mutableLocalCount)
    if base == 0U64 { return <MidAccessError.UnsupportedAccessBase /> }
    if rawKey == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    if access.writeResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
    if setter.callee >= c.arena.functionCount() { return <MidAccessError.UnresolvedAccessCall /> }
    val receiver: U64 = canonicalAccessAppendSelectedReceiver(c: inout c, operandId: base, resolution: access.writeResolution)
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: access.writeResolution)
    if receiver == 0U64 || target == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val destinationLocal: U64 = canonicalAccessSetterLocal(c: c, body: body, term: term, localBase: localBase, marker: marker, stage: stage)
    val destinationTerm: U64 = setter.resultTypeRef
    val destination: U64 = canonicalAccessAppendPlace(c: inout c, local: destinationLocal, typeTerm: destinationTerm)
    val argumentStart: U64 = c.mid.callArguments.count()
    val key: U64 = canonicalAccessAppendSelectedArgument(c: inout c, operandId: rawKey, resolution: access.writeResolution, index: 0U64)
    val rawValue: U64 = canonicalAccessAppendCopy(c: inout c, place: valuePlace)
    val value: U64 = canonicalAccessAppendSelectedArgument(c: inout c, operandId: rawValue, resolution: access.writeResolution, index: 1U64)
    if key == 0U64 || rawValue == 0U64 || value == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    c.mid.callArguments.append(key)
    c.mid.callArguments.append(value)
    val setterStart: U64 = canonicalAccessSetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: marker, plan: plan)
    val cleanupBlock: U64 = setterStart + stage * 2U64 + 1U64
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=cleanupBlock args=<MidRange start=argumentStart len=2U64 /> destination=destination callTarget=target callReceiver=receiver />)
    c.mid.blocks.append(<MidBlockNode terminator=c.mid.terminators.count() />)
    val cleanupStart: U64 = c.mid.statements.count()
    c.mid.statements.append(<MidStatementNode tag=3U64 destination=valuePlace />)
    c.mid.statements.append(<MidStatementNode tag=3U64 destination=destination />)
    if marker == 0U64 && stage + 1U64 == site.chainLen {
        mut val recipeI: U64 = plan.materializedInputs.count()
        while recipeI > 0U64 {
            recipeI -= 1U64
            val input: SemanticAccessInput = c.arena.semanticAccessInputs[plan.materializedInputs[recipeI] - 1U64]
            mut val localTerm = input.typeTerm
            if input.tag == 7U64 { localTerm = c.arena.semanticAccessInputs[input.base - 1U64].typeTerm }
            val local: U64 = localBase + mutableLocalCount + recipeI
            val place = canonicalAccessAppendPlace(c: inout c, local: local, typeTerm: localTerm)
            c.mid.statements.append(<MidStatementNode tag=3U64 destination=place />)
        }
    }
    mut val continuation: U64 = 0U64
    if stage + 1U64 < site.chainLen {
        continuation = setterStart + (stage + 1U64) * 2U64
    } else {
        if marker != 0U64 {
            continuation = canonicalAccessSetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: marker - 1U64, plan: plan)
        } else {
            continuation = canonicalAccessRemapTarget(c: c, body: body, target: term.target)
        }
    }
    c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=continuation />)
    val cleanupLen: U64 = c.mid.statements.count() - cleanupStart
    c.mid.blocks.append(<MidBlockNode statements=<MidRange start=cleanupStart len=cleanupLen /> terminator=c.mid.terminators.count() />)
    return <MidAccessError.None />
}

fn canonicalAccessMutableLocalCount(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> U64 {
    mut val count: U64 = 0U64
    mut val markerI: U64 = 0U64
    while markerI < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = 0U64
        while stage < site.chainLen {
            count += 2U64
            stage = stage + 1U64
        }
        markerI = markerI + 1U64
    }
    return count
}

fn canonicalAccessGeneratedLocalCount(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> U64 {
    val plan: MidCanonicalAccessPlan = canonicalAccessPlanForTerm(c: c, body: body, term: term)
    if !plan.valid { return 0U64 }
    return canonicalAccessMutableLocalCount(c: c, body: body, term: term) + plan.materializedInputs.count()
}

fn canonicalAccessBlockLocalBase(c: Comp, body: MidBodyNode, blockI: U64) -> U64 {
    mut val base: U64 = body.locals.len
    mut val prior: U64 = 0U64
    while prior < blockI && prior < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + prior]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
            base = base + canonicalAccessGeneratedLocalCount(c: c, body: body, term: c.mid.terminators[block.terminator - 1U64])
        }
        prior = prior + 1U64
    }
    return base
}

fn canonicalAccessExpandBlock(c: inout Comp, body: MidBodyNode, blockI: U64, block: MidBlockNode) -> MidAccessError {
    if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
    val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
    if markerCount == 0U64 { return <MidAccessError.None /> }
    val plan: MidCanonicalAccessPlan = canonicalAccessPlanForTerm(c: c, body: body, term: term)
    if !plan.valid || plan.operations.count() == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    // Terminator targets are indices within the rewritten body slice, never
    // indices in the append-only global arena.  The arena may already contain
    // many earlier bodies, so using `c.mid.blocks.count()` here makes every
    // generated getter/setter edge jump past this body's block array and
    // silently skip the reverse writeback chain.
    val blockStart: U64 = canonicalAccessBlockStart(c: c, body: body, target: blockI)
    val localBase: U64 = canonicalAccessBlockLocalBase(c: c, body: body, blockI: blockI)
    val mutableLocalCount: U64 = canonicalAccessMutableLocalCount(c: c, body: body, term: term)
    val statements: MidRange = canonicalAccessCopyStatements(c: inout c, block: block)
    mut val operationI: U64 = 0U64
    while operationI < plan.operations.count() {
        val operation: MidCanonicalAccessOperation = plan.operations[operationI]
        val operationStatements: MidRange = if operationI == 0U64 { give statements } else { give <MidRange start=0U64 len=0U64 /> }
        mut val error: MidAccessError = <MidAccessError.InvalidAccessChain />
        if operation.tag == 1U64 {
            error = canonicalAccessAppendRecipeGetter(c: inout c, body: body, blockStart: blockStart, localBase: localBase, plan: plan, operationIndex: operationI, mutableLocalCount: mutableLocalCount, statements: operationStatements)
        } else if operation.tag == 3U64 {
            error = canonicalAccessAppendReference(c: inout c, body: body, blockStart: blockStart, localBase: localBase, plan: plan, operationIndex: operationI, mutableLocalCount: mutableLocalCount, statements: operationStatements)
        } else if operation.tag == 2U64 {
            error = canonicalAccessAppendGetter(c: inout c, body: body, term: term, blockStart: blockStart, localBase: localBase, marker: operation.marker, stage: operation.stage, plan: plan, operationIndex: operationI, mutableLocalCount: mutableLocalCount, statements: operationStatements)
        }
        match error { MidAccessError.None => {} _ => { return error } }
        operationI += 1U64
    }
    val parentError: MidAccessError = canonicalAccessAppendParentTerminator(c: inout c, body: body, term: term, blockStart: blockStart, localBase: localBase, plan: plan, mutableLocalCount: mutableLocalCount)
    match parentError { MidAccessError.None => {} _ => { return parentError } }
    c.mid.blocks.append(<MidBlockNode terminator=c.mid.terminators.count() />)
    mut val markerI: U64 = markerCount
    while markerI > 0U64 {
        markerI = markerI - 1U64
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = 0U64
        while stage < site.chainLen {
            val error: MidAccessError = canonicalAccessAppendSetter(c: inout c, body: body, term: term, blockStart: blockStart, localBase: localBase, marker: markerI, stage: stage, plan: plan, mutableLocalCount: mutableLocalCount)
            match error { MidAccessError.None => {} _ => { return error } }
            stage = stage + 1U64
        }
    }
    return <MidAccessError.None />
}

// Canonical access elaboration is a single append-only CFG rewrite.  It reads
// final call identities and frozen input recipes only; neither AST recovery
// nor a `MidBody` thaw bridge is permitted after this boundary.
export fn elaborateCanonicalMidAccesses(c: inout Comp, canonical: MidCanonicalBody) -> MidCanonicalAccessElaboration {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidCanonicalAccessElaboration error=<MidAccessError.UnresolvedAccessCall /> /> }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val hasAccess: Bool = false
    mut val scanBlock: U64 = 0U64
    while scanBlock < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + scanBlock]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() && canonicalAccessMarkerCount(c: c, term: c.mid.terminators[block.terminator - 1U64]) != 0U64 { hasAccess = true }
        scanBlock = scanBlock + 1U64
    }
    if !hasAccess { return <MidCanonicalAccessElaboration body=canonical /> }
    val localStart: U64 = c.mid.locals.count()
    val localError: MidAccessError = canonicalAccessAppendLocals(c: inout c, body: body)
    match localError { MidAccessError.None => {} _ => { return <MidCanonicalAccessElaboration error=localError /> } }
    val scopeStart: U64 = c.mid.scopes.count()
    mut val scopeI: U64 = 0U64
    while scopeI < body.scopes.len {
        c.mid.scopes.append(c.mid.scopes[body.scopes.start + scopeI])
        scopeI = scopeI + 1U64
    }
    val blockStart: U64 = c.mid.blocks.count()
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        val markerCount: U64 = if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() { give canonicalAccessMarkerCount(c: c, term: c.mid.terminators[block.terminator - 1U64]) } else { give 0U64 }
        if markerCount == 0U64 {
            val statements: MidRange = canonicalAccessCopyStatements(c: inout c, block: block)
            val terminator: U64 = canonicalAccessCopyTerminator(c: inout c, body: body, terminatorId: block.terminator)
            if terminator == 0U64 { return <MidCanonicalAccessElaboration error=<MidAccessError.UnresolvedAccessCall /> /> }
            c.mid.blocks.append(<MidBlockNode statements=statements terminator=terminator />)
        } else {
            val error: MidAccessError = canonicalAccessExpandBlock(c: inout c, body: body, blockI: blockI, block: block)
            match error { MidAccessError.None => {} _ => { return <MidCanonicalAccessElaboration error=error /> } }
        }
        blockI = blockI + 1U64
    }
    val result: MidCanonicalBody = <MidCanonicalBody body=c.mid.bodies.count() + 1U64 />
    c.mid.bodies.append(<MidBodyNode bodyInstance=body.bodyInstance sourceFunction=body.sourceFunction locals=<MidRange start=localStart len=c.mid.locals.count() - localStart /> scopes=<MidRange start=scopeStart len=body.scopes.len /> blocks=<MidRange start=blockStart len=c.mid.blocks.count() - blockStart /> entry=canonicalAccessRemapTarget(c: c, body: body, target: body.entry) />)
    if !c.mid.isWellFormed(body: result) { return <MidCanonicalAccessElaboration error=<MidAccessError.InvalidAccessChain /> /> }
    return <MidCanonicalAccessElaboration body=result />
}
