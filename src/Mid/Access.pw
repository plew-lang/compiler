// Instance-specific get-modify-set elaboration.  Parametric Mid retains an
// Access marker because the selected inout ABI belongs to a BodyInstance;
// this pass consumes only frozen SemanticAccess and already-resolved calls.

import ../Frontend with { Comp }
import ../Ir with { Expr, SemanticExprType, SemanticAccess, SemanticAccessInput, CallResolution }
import ../Diag with { eprintU64 }
import @Std/Io with { eprint }
import ./Ir with { MidRange, MidBodyNode, MidBlockNode, MidPlaceNode, MidProjectionNode, MidOperandNode, MidCallTargetNode, MidCallReceiverNode, MidStatementNode, MidTerminatorNode, MidSwitchCase, MidCanonicalBody, MidProjection, MidPlace, MidConstant, MidOperand, MidBorrowCapability, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidBody }

export enum MidAccessError {
    None
    MissingOuterSemanticAccess
    AccessRoleMismatch
    UnresolvedAccessCall
    ParentAccessArgumentMissing
    ParentAccessArgumentMismatch
    InvalidAccessChain
    UnsupportedAccessBase
    UnsupportedAccessKey
    UnsupportedAccessProjection
    UnsupportedSetterReceiver
}

export struct MidAccessElaboration {
    pub val body: MidBody
    pub val error: MidAccessError = <MidAccessError.None />
}
pub impl MidAccessElaboration { factory }

export struct MidCanonicalAccessElaboration {
    pub val body: MidCanonicalBody = <MidCanonicalBody body=0U64 />
    pub val error: MidAccessError = <MidAccessError.None />
}
pub impl MidCanonicalAccessElaboration { factory }

struct MidCanonicalAccessSite {
    pub val candidate: U64 = 0U64
    pub val role: U64 = 0U64
    pub val parentResolution: U64 = 0U64
    pub val chainLen: U64 = 0U64
}
pub impl MidCanonicalAccessSite { factory }

fn canonicalAccessLocalPlace(c: inout Comp, body: MidBodyNode, declarationTarget: U64, typeTerm: U64) -> U64 {
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        val local: MidLocalDecl = c.mid.locals[body.locals.start + localI]
        if local.sourceNameStart == declarationTarget {
            c.mid.places.append(<MidPlaceNode local=localI typeTerm=typeTerm />)
            return c.mid.places.count()
        }
        localI = localI + 1U64
    }
    return 0U64
}

// Materialize a selected semantic input without looking at Expr/TypeCache.
// Root is nonzero only for the getter-value projection passed to a parent.
fn canonicalAccessInputPlace(c: inout Comp, body: MidBodyNode, inputId: U64, root: U64) -> U64 {
    if inputId == 0U64 || inputId > c.arena.semanticAccessInputs.count() { return 0U64 }
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[inputId - 1U64]
    match input.tag {
        1U64 => { return canonicalAccessLocalPlace(c: inout c, body: body, declarationTarget: input.declarationTarget, typeTerm: input.typeTerm) }
        3U64 => {
            val base: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: input.base, root: root)
            if base == 0U64 || base > c.mid.places.count() { return 0U64 }
            val parent: MidPlaceNode = c.mid.places[base - 1U64]
            val projectionStart: U64 = c.mid.projections.count()
            mut val projectionI: U64 = 0U64
            while projectionI < parent.projections.len {
                c.mid.projections.append(c.mid.projections[parent.projections.start + projectionI])
                projectionI = projectionI + 1U64
            }
            c.mid.projections.append(<MidProjectionNode tag=1U64 index=input.fieldIndex typeTerm=input.typeTerm />)
            c.mid.places.append(<MidPlaceNode local=parent.local projections=<MidRange start=projectionStart len=parent.projections.len + 1U64 /> typeTerm=input.typeTerm />)
            return c.mid.places.count()
        }
        4U64 => { return root }
        _ => { return 0U64 }
    }
}

fn canonicalAccessInputOperand(c: inout Comp, body: MidBodyNode, inputId: U64, root: U64) -> U64 {
    if inputId == 0U64 || inputId > c.arena.semanticAccessInputs.count() { return 0U64 }
    val input: SemanticAccessInput = c.arena.semanticAccessInputs[inputId - 1U64]
    if input.tag == 2U64 {
        c.mid.operands.append(<MidOperandNode tag=5U64 integerValue=input.integerValue integerNegative=input.integerNegative integerBool=input.integerBool typeTerm=input.typeTerm />)
        return c.mid.operands.count()
    }
    val place: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: inputId, root: root)
    if place == 0U64 { return 0U64 }
    c.mid.operands.append(<MidOperandNode tag=1U64 place=place />)
    return c.mid.operands.count()
}

fn canonicalAccessFor(c: Comp, bodyId: U64, parentResolution: U64, candidate: U64) -> U64 {
    mut val accessI: U64 = 0U64
    while accessI < c.arena.semanticAccesses.count() {
        val access: SemanticAccess = c.arena.semanticAccesses[accessI]
        if access.bodyId == bodyId && access.parentResolution == parentResolution && access.candidateIndex == candidate && access.write {
            return accessI + 1U64
        }
        accessI = accessI + 1U64
    }
    return 0U64
}

fn canonicalAccessChainLen(c: Comp, bodyId: U64, parentResolution: U64, candidate: U64) -> U64 {
    mut val current: U64 = canonicalAccessFor(c: c, bodyId: bodyId, parentResolution: parentResolution, candidate: candidate)
    mut val count: U64 = 0U64
    while current != 0U64 && count < c.arena.semanticAccesses.count() {
        count = count + 1U64
        val access: SemanticAccess = c.arena.semanticAccesses[current - 1U64]
        if access.nestedCandidate == 0U64 { return count }
        current = canonicalAccessFor(c: c, bodyId: bodyId, parentResolution: access.writeResolution, candidate: access.nestedCandidate - 1U64)
    }
    return 0U64
}

// Finds the one selected inout access marker carried by a parent call. The
// marker itself is already in canonical Mid; SemanticAccess supplies its
// closed storage provenance and read/write resolutions.
fn canonicalAccessSiteAt(c: Comp, body: MidBodyNode, term: MidTerminatorNode, ordinal: U64) -> MidCanonicalAccessSite {
    if term.tag != 4U64 || term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidCanonicalAccessSite /> }
    val target: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
    if target.tag != 2U64 || target.resolution >= c.arena.finalCallees.count() { return <MidCanonicalAccessSite /> }
    mut val candidate: U64 = 0U64
    mut val role: U64 = 0U64
    mut val seen: U64 = 0U64
    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if receiver.tag == 2U64 && receiver.operand != 0U64 && receiver.operand <= c.mid.operands.count() {
            val operand: MidOperandNode = c.mid.operands[receiver.operand - 1U64]
            if operand.tag == 8U64 {
                if seen == ordinal {
                    candidate = operand.accessCandidate
                    role = 1U64
                }
                seen = seen + 1U64
            }
        }
    }
    if role == 0U64 {
        mut val argumentI: U64 = 0U64
        while argumentI < term.args.len {
            val argument: U64 = c.mid.callArguments[term.args.start + argumentI]
            if argument != 0U64 && argument <= c.mid.operands.count() {
                val operand: MidOperandNode = c.mid.operands[argument - 1U64]
                if operand.tag == 8U64 {
                    if seen == ordinal {
                        candidate = operand.accessCandidate
                        role = 2U64
                    }
                    seen = seen + 1U64
                }
            }
            argumentI = argumentI + 1U64
        }
    }
    if role == 0U64 { return <MidCanonicalAccessSite /> }
    val chainLen: U64 = canonicalAccessChainLen(c: c, bodyId: body.bodyInstance, parentResolution: target.resolution, candidate: candidate)
    if chainLen == 0U64 { return <MidCanonicalAccessSite role=role parentResolution=target.resolution /> }
    return <MidCanonicalAccessSite candidate=candidate role=role parentResolution=target.resolution chainLen=chainLen />
}

fn canonicalAccessSite(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> MidCanonicalAccessSite {
    return canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: 0U64)
}

fn canonicalAccessMarkerCount(c: Comp, term: MidTerminatorNode) -> U64 {
    if term.tag != 4U64 { return 0U64 }
    mut val count: U64 = 0U64
    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
        val receiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if receiver.tag == 2U64 && receiver.operand != 0U64 && receiver.operand <= c.mid.operands.count() && c.mid.operands[receiver.operand - 1U64].tag == 8U64 { count = count + 1U64 }
    }
    mut val argumentI: U64 = 0U64
    while argumentI < term.args.len {
        val argument: U64 = c.mid.callArguments[term.args.start + argumentI]
        if argument != 0U64 && argument <= c.mid.operands.count() && c.mid.operands[argument - 1U64].tag == 8U64 { count = count + 1U64 }
        argumentI = argumentI + 1U64
    }
    return count
}

// The source block itself becomes the innermost getter. A chain of n access
// facets then needs n-1 further getters, one parent call, and setter/cleanup
// pairs: 3n+1 contiguous canonical blocks in total.
fn canonicalAccessBlockWidth(c: Comp, body: MidBodyNode, blockI: U64) -> U64 {
    if blockI >= body.blocks.len { return 0U64 }
    val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
    if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return 1U64 }
    val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
    val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
    if markerCount == 0U64 { return 1U64 }
    mut val totalChainLen: U64 = 0U64
    mut val markerI: U64 = 0U64
    while markerI < markerCount {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        if site.role == 0U64 || site.chainLen == 0U64 { return 1U64 }
        totalChainLen = totalChainLen + site.chainLen
        markerI = markerI + 1U64
    }
    return totalChainLen * 3U64 + 1U64
}

fn canonicalAccessBlockStart(c: Comp, body: MidBodyNode, target: U64) -> U64 {
    mut val start: U64 = 0U64
    mut val blockI: U64 = 0U64
    while blockI < target && blockI < body.blocks.len {
        start = start + canonicalAccessBlockWidth(c: c, body: body, blockI: blockI)
        blockI = blockI + 1U64
    }
    return start
}

// A canonical access rewrite owns a new block slice.  Statement/rvalue and
// operand rows are immutable global facts, but blocks and terminators contain
// CFG-relative targets and must be copied into that slice.  Keeping the
// remapping here (rather than in LLVM) makes every downstream Mid consumer
// see the same closed CFG.
fn canonicalAccessRemapTarget(c: Comp, body: MidBodyNode, target: U64) -> U64 {
    return canonicalAccessBlockStart(c: c, body: body, target: target)
}

fn canonicalAccessCopyStatements(c: inout Comp, block: MidBlockNode) -> MidRange {
    val start: U64 = c.mid.statements.count()
    mut val statementI: U64 = 0U64
    while statementI < block.statements.len {
        c.mid.statements.append(c.mid.statements[block.statements.start + statementI])
        statementI = statementI + 1U64
    }
    return <MidRange start=start len=block.statements.len />
}

// This is deliberately a scalar-row copy, not a thaw into MidTerminator.
// Existing operands/places remain immutable IDs; only control-flow edges and
// their owner-specific argument/case ranges are recreated.
fn canonicalAccessCopyTerminator(c: inout Comp, body: MidBodyNode, terminatorId: U64) -> U64 {
    if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return 0U64 }
    val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
    match term.tag {
        1U64 => { c.mid.terminators.append(<MidTerminatorNode tag=1U64 />) }
        2U64 => { c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=canonicalAccessRemapTarget(c: c, body: body, target: term.target) />) }
        3U64 => {
            val caseStart: U64 = c.mid.switchCases.count()
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                val item: MidSwitchCase = c.mid.switchCases[term.cases.start + caseI]
                c.mid.switchCases.append(<MidSwitchCase value=item.value target=canonicalAccessRemapTarget(c: c, body: body, target: item.target) />)
                caseI = caseI + 1U64
            }
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=term.discriminant cases=<MidRange start=caseStart len=term.cases.len /> otherwise=canonicalAccessRemapTarget(c: c, body: body, target: term.otherwise) />)
        }
        4U64 => {
            val argumentStart: U64 = c.mid.callArguments.count()
            mut val argumentI: U64 = 0U64
            while argumentI < term.args.len {
                c.mid.callArguments.append(c.mid.callArguments[term.args.start + argumentI])
                argumentI = argumentI + 1U64
            }
            mut val callTarget: U64 = 0U64
            if term.callTarget != 0U64 && term.callTarget <= c.mid.callTargets.count() {
                c.mid.callTargets.append(c.mid.callTargets[term.callTarget - 1U64])
                callTarget = c.mid.callTargets.count()
            }
            mut val callReceiver: U64 = 0U64
            if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
                c.mid.callReceivers.append(c.mid.callReceivers[term.callReceiver - 1U64])
                callReceiver = c.mid.callReceivers.count()
            }
            c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=canonicalAccessRemapTarget(c: c, body: body, target: term.target) args=<MidRange start=argumentStart len=term.args.len /> destination=term.destination callTarget=callTarget callReceiver=callReceiver />)
        }
        5U64 => { c.mid.terminators.append(<MidTerminatorNode tag=5U64 />) }
        6U64 => { c.mid.terminators.append(<MidTerminatorNode tag=6U64 value=term.value />) }
        7U64 => { c.mid.terminators.append(<MidTerminatorNode tag=7U64 value=term.value />) }
        8U64 => { c.mid.terminators.append(<MidTerminatorNode tag=8U64 />) }
        9U64 => { c.mid.terminators.append(<MidTerminatorNode tag=9U64 />) }
        10U64 => { c.mid.terminators.append(<MidTerminatorNode tag=10U64 state=term.state resume=canonicalAccessRemapTarget(c: c, body: body, target: term.resume) />) }
        _ => { return 0U64 }
    }
    return c.mid.terminators.count()
}

fn canonicalAccessChainAt(c: Comp, body: MidBodyNode, site: MidCanonicalAccessSite, stage: U64) -> U64 {
    mut val current: U64 = canonicalAccessFor(c: c, bodyId: body.bodyInstance, parentResolution: site.parentResolution, candidate: site.candidate)
    mut val currentStage: U64 = 0U64
    while current != 0U64 && currentStage < stage {
        val access: SemanticAccess = c.arena.semanticAccesses[current - 1U64]
        if access.nestedCandidate == 0U64 { return 0U64 }
        current = canonicalAccessFor(c: c, bodyId: body.bodyInstance, parentResolution: access.writeResolution, candidate: access.nestedCandidate - 1U64)
        currentStage = currentStage + 1U64
    }
    return current
}

fn canonicalAccessSetterHasResult(c: Comp, access: SemanticAccess) -> Bool {
    if access.writeResolution >= c.arena.finalCallees.count() { return false }
    val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
    return setter.callee < c.arena.funcs.count() && c.arena.funcs[setter.callee].hasRet
}

fn canonicalAccessMarkerLocalBase(c: Comp, body: MidBodyNode, term: MidTerminatorNode, localBase: U64, marker: U64) -> U64 {
    mut val local: U64 = localBase
    mut val markerI: U64 = 0U64
    while markerI < marker {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = 0U64
        while stage < site.chainLen {
            local = local + 1U64
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
            if accessId != 0U64 && canonicalAccessSetterHasResult(c: c, access: c.arena.semanticAccesses[accessId - 1U64]) { local = local + 1U64 }
            stage = stage + 1U64
        }
        markerI = markerI + 1U64
    }
    return local
}

fn canonicalAccessSetterLocal(c: Comp, body: MidBodyNode, term: MidTerminatorNode, localBase: U64, marker: U64, stage: U64) -> U64 {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val base: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker)
    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
    if accessId == 0U64 { return 0U64 }
    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
    if !canonicalAccessSetterHasResult(c: c, access: access) { return base + stage }
    mut val resultOffset: U64 = 0U64
    mut val prior: U64 = 0U64
    while prior < stage {
        val priorId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: prior)
        if priorId != 0U64 && canonicalAccessSetterHasResult(c: c, access: c.arena.semanticAccesses[priorId - 1U64]) { resultOffset = resultOffset + 1U64 }
        prior = prior + 1U64
    }
    return base + site.chainLen + resultOffset
}

fn canonicalAccessAppendLocals(c: inout Comp, body: MidBodyNode) -> MidAccessError {
    mut val localI: U64 = 0U64
    while localI < body.locals.len {
        c.mid.locals.append(c.mid.locals[body.locals.start + localI])
        localI = localI + 1U64
    }
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
            val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
            mut val markerI: U64 = 0U64
            while markerI < markerCount {
                val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
                if site.role == 0U64 || site.chainLen == 0U64 { return <MidAccessError.MissingOuterSemanticAccess /> }
                val outerId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: 0U64)
                if outerId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
                val outer: SemanticAccess = c.arena.semanticAccesses[outerId - 1U64]
                if outer.role != site.role { return <MidAccessError.AccessRoleMismatch /> }
                mut val stage: U64 = 0U64
                while stage < site.chainLen {
                    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
                    if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
                    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
                    if !access.write || access.readResolution >= c.arena.finalCallees.count() || access.writeResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
                    c.mid.locals.append(<MidLocalDecl typeTerm=access.valueTerm sourceScope=0U64 isUnique=false isParameter=false />)
                    stage = stage + 1U64
                }
                stage = 0U64
                while stage < site.chainLen {
                    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
                    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
                    if canonicalAccessSetterHasResult(c: c, access: access) {
                        val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
                        c.mid.locals.append(<MidLocalDecl typeTerm=setter.resultTypeRef sourceScope=0U64 isUnique=false isParameter=false />)
                    }
                    stage = stage + 1U64
                }
                markerI = markerI + 1U64
            }
        }
        blockI = blockI + 1U64
    }
    return <MidAccessError.None />
}

fn canonicalAccessAppendPlace(c: inout Comp, local: U64, typeTerm: U64) -> U64 {
    c.mid.places.append(<MidPlaceNode local=local typeTerm=typeTerm />)
    return c.mid.places.count()
}

fn canonicalAccessAppendCopy(c: inout Comp, place: U64) -> U64 {
    if place == 0U64 || place > c.mid.places.count() { return 0U64 }
    c.mid.operands.append(<MidOperandNode tag=1U64 place=place />)
    return c.mid.operands.count()
}

fn canonicalAccessAppendInoutBorrow(c: inout Comp, place: U64) -> U64 {
    if place == 0U64 || place > c.mid.places.count() { return 0U64 }
    c.mid.operands.append(<MidOperandNode tag=4U64 place=place capability=2U64 />)
    return c.mid.operands.count()
}

fn canonicalAccessBaseOperand(c: inout Comp, body: MidBodyNode, access: SemanticAccess, nestedValuePlace: U64) -> U64 {
    if nestedValuePlace != 0U64 { return canonicalAccessAppendCopy(c: inout c, place: nestedValuePlace) }
    return canonicalAccessInputOperand(c: inout c, body: body, inputId: access.baseInput, root: 0U64)
}

fn canonicalAccessKeyOperand(c: inout Comp, body: MidBodyNode, access: SemanticAccess) -> U64 {
    return canonicalAccessInputOperand(c: inout c, body: body, inputId: access.keyInput, root: 0U64)
}

fn canonicalAccessAppendResolvedTarget(c: inout Comp, resolution: U64) -> U64 {
    if resolution >= c.arena.finalCallees.count() { return 0U64 }
    c.mid.callTargets.append(<MidCallTargetNode tag=2U64 resolution=resolution />)
    return c.mid.callTargets.count()
}

fn canonicalAccessAppendValueReceiver(c: inout Comp, operand: U64) -> U64 {
    if operand == 0U64 || operand > c.mid.operands.count() { return 0U64 }
    c.mid.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=operand />)
    return c.mid.callReceivers.count()
}

fn canonicalAccessGetterTarget(c: Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, marker: U64, stage: U64) -> U64 {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val markerBase: U64 = canonicalAccessGetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: marker)
    if stage != 0U64 { return markerBase + site.chainLen - stage }
    val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
    if marker + 1U64 < markerCount {
        return canonicalAccessGetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: marker + 1U64)
    }
    return blockStart + canonicalAccessTotalChainLen(c: c, body: body, term: term)
}

fn canonicalAccessTotalChainLen(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> U64 {
    mut val total: U64 = 0U64
    mut val markerI: U64 = 0U64
    while markerI < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        total = total + site.chainLen
        markerI = markerI + 1U64
    }
    return total
}

fn canonicalAccessGetterStart(c: Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, marker: U64) -> U64 {
    mut val start: U64 = blockStart
    mut val markerI: U64 = 0U64
    while markerI < marker {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        start = start + site.chainLen
        markerI = markerI + 1U64
    }
    return start
}

fn canonicalAccessSetterStart(c: Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, marker: U64) -> U64 {
    val total: U64 = canonicalAccessTotalChainLen(c: c, body: body, term: term)
    mut val start: U64 = blockStart + total + 1U64
    mut val markerI: U64 = marker + 1U64
    while markerI < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        start = start + site.chainLen * 2U64
        markerI = markerI + 1U64
    }
    return start
}

fn canonicalAccessAppendParentTerminator(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, localBase: U64) -> MidAccessError {
    if term.callTarget == 0U64 || term.callTarget > c.mid.callTargets.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val sourceTarget: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
    if sourceTarget.tag != 2U64 || sourceTarget.resolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val argumentStart: U64 = c.mid.callArguments.count()
    mut val markerI: U64 = 0U64
    mut val receiverId: U64 = 0U64
    if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
        val sourceReceiver: MidCallReceiverNode = c.mid.callReceivers[term.callReceiver - 1U64]
        if sourceReceiver.tag == 2U64 && sourceReceiver.operand != 0U64 && sourceReceiver.operand <= c.mid.operands.count() && c.mid.operands[sourceReceiver.operand - 1U64].tag == 8U64 {
            val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: 0U64)
            if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
            val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
            val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: markerI)
            val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
            val projected: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: access.accessInput, root: valuePlace)
            val borrowed: U64 = canonicalAccessAppendInoutBorrow(c: inout c, place: projected)
            receiverId = canonicalAccessAppendValueReceiver(c: inout c, operand: borrowed)
            if receiverId == 0U64 { return <MidAccessError.UnsupportedAccessProjection /> }
            markerI = markerI + 1U64
        } else {
            c.mid.callReceivers.append(sourceReceiver)
            receiverId = c.mid.callReceivers.count()
        }
    }
    mut val argumentI: U64 = 0U64
    while argumentI < term.args.len {
        val argument: U64 = c.mid.callArguments[term.args.start + argumentI]
        if argument != 0U64 && argument <= c.mid.operands.count() && c.mid.operands[argument - 1U64].tag == 8U64 {
            val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: 0U64)
            if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
            val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
            val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: markerI)
            val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
            val projected: U64 = canonicalAccessInputPlace(c: inout c, body: body, inputId: access.accessInput, root: valuePlace)
            val borrowed: U64 = canonicalAccessAppendInoutBorrow(c: inout c, place: projected)
            if borrowed == 0U64 { return <MidAccessError.UnsupportedAccessProjection /> }
            c.mid.callArguments.append(borrowed)
            markerI = markerI + 1U64
        } else {
            c.mid.callArguments.append(argument)
        }
        argumentI = argumentI + 1U64
    }
    if markerI != canonicalAccessMarkerCount(c: c, term: term) { return <MidAccessError.ParentAccessArgumentMismatch /> }
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: sourceTarget.resolution)
    if target == 0U64 || receiverId == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val firstSetter: U64 = canonicalAccessSetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: canonicalAccessMarkerCount(c: c, term: term) - 1U64)
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=firstSetter args=<MidRange start=argumentStart len=term.args.len /> destination=term.destination callTarget=target callReceiver=receiverId />)
    return <MidAccessError.None />
}

fn canonicalAccessAppendGetter(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, localBase: U64, marker: U64, stage: U64, statements: MidRange) -> MidAccessError {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
    if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
    val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage
    val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
    mut val nestedPlace: U64 = 0U64
    if stage + 1U64 < site.chainLen {
        val nestedId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage + 1U64)
        if nestedId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
        val nested: SemanticAccess = c.arena.semanticAccesses[nestedId - 1U64]
        nestedPlace = canonicalAccessAppendPlace(c: inout c, local: canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage + 1U64, typeTerm: nested.valueTerm)
    }
    val base: U64 = canonicalAccessBaseOperand(c: inout c, body: body, access: access, nestedValuePlace: nestedPlace)
    val key: U64 = canonicalAccessKeyOperand(c: inout c, body: body, access: access)
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: access.readResolution)
    val receiver: U64 = canonicalAccessAppendValueReceiver(c: inout c, operand: base)
    if base == 0U64 { return <MidAccessError.UnsupportedAccessBase /> }
    if key == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    if target == 0U64 || receiver == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val argumentStart: U64 = c.mid.callArguments.count()
    c.mid.callArguments.append(key)
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=canonicalAccessGetterTarget(c: c, body: body, term: term, blockStart: blockStart, marker: marker, stage: stage) args=<MidRange start=argumentStart len=1U64 /> destination=valuePlace callTarget=target callReceiver=receiver />)
    c.mid.blocks.append(<MidBlockNode statements=statements terminator=c.mid.terminators.count() />)
    return <MidAccessError.None />
}

fn canonicalAccessAppendSetter(c: inout Comp, body: MidBodyNode, term: MidTerminatorNode, blockStart: U64, localBase: U64, marker: U64, stage: U64) -> MidAccessError {
    val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: marker)
    val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
    if accessId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    val access: SemanticAccess = c.arena.semanticAccesses[accessId - 1U64]
    val valueLocal: U64 = canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage
    val valuePlace: U64 = canonicalAccessAppendPlace(c: inout c, local: valueLocal, typeTerm: access.valueTerm)
    mut val nestedPlace: U64 = 0U64
    if stage + 1U64 < site.chainLen {
        val nestedId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage + 1U64)
        if nestedId == 0U64 { return <MidAccessError.InvalidAccessChain /> }
        val nested: SemanticAccess = c.arena.semanticAccesses[nestedId - 1U64]
        nestedPlace = canonicalAccessAppendPlace(c: inout c, local: canonicalAccessMarkerLocalBase(c: c, body: body, term: term, localBase: localBase, marker: marker) + stage + 1U64, typeTerm: nested.valueTerm)
    }
    mut val base: U64 = canonicalAccessBaseOperand(c: inout c, body: body, access: access, nestedValuePlace: nestedPlace)
    val key: U64 = canonicalAccessKeyOperand(c: inout c, body: body, access: access)
    if base == 0U64 { return <MidAccessError.UnsupportedAccessBase /> }
    if key == 0U64 { return <MidAccessError.UnsupportedAccessKey /> }
    if access.writeResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
    if setter.callee >= c.arena.funcs.count() { return <MidAccessError.UnresolvedAccessCall /> }
    if c.arena.funcs[setter.callee].selfInout {
        if base > c.mid.operands.count() || c.mid.operands[base - 1U64].tag != 1U64 { return <MidAccessError.UnsupportedSetterReceiver /> }
        base = canonicalAccessAppendInoutBorrow(c: inout c, place: c.mid.operands[base - 1U64].place)
    }
    val receiver: U64 = canonicalAccessAppendValueReceiver(c: inout c, operand: base)
    val target: U64 = canonicalAccessAppendResolvedTarget(c: inout c, resolution: access.writeResolution)
    if receiver == 0U64 || target == 0U64 { return <MidAccessError.UnresolvedAccessCall /> }
    val destinationLocal: U64 = canonicalAccessSetterLocal(c: c, body: body, term: term, localBase: localBase, marker: marker, stage: stage)
    val destinationTerm: U64 = if canonicalAccessSetterHasResult(c: c, access: access) { give setter.resultTypeRef } else { give access.valueTerm }
    val destination: U64 = canonicalAccessAppendPlace(c: inout c, local: destinationLocal, typeTerm: destinationTerm)
    val argumentStart: U64 = c.mid.callArguments.count()
    c.mid.callArguments.append(key)
    c.mid.callArguments.append(canonicalAccessAppendCopy(c: inout c, place: valuePlace))
    val setterStart: U64 = canonicalAccessSetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: marker)
    val cleanupBlock: U64 = setterStart + stage * 2U64 + 1U64
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=cleanupBlock args=<MidRange start=argumentStart len=2U64 /> destination=destination callTarget=target callReceiver=receiver />)
    c.mid.blocks.append(<MidBlockNode terminator=c.mid.terminators.count() />)
    val cleanupStart: U64 = c.mid.statements.count()
    c.mid.statements.append(<MidStatementNode tag=3U64 destination=valuePlace />)
    if canonicalAccessSetterHasResult(c: c, access: access) { c.mid.statements.append(<MidStatementNode tag=3U64 destination=destination />) }
    mut val continuation: U64 = 0U64
    if stage + 1U64 < site.chainLen {
        continuation = setterStart + (stage + 1U64) * 2U64
    } else {
        if marker != 0U64 {
            continuation = canonicalAccessSetterStart(c: c, body: body, term: term, blockStart: blockStart, marker: marker - 1U64)
        } else {
            continuation = canonicalAccessRemapTarget(c: c, body: body, target: term.target)
        }
    }
    c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=continuation />)
    val cleanupLen: U64 = if canonicalAccessSetterHasResult(c: c, access: access) { give 2U64 } else { give 1U64 }
    c.mid.blocks.append(<MidBlockNode statements=<MidRange start=cleanupStart len=cleanupLen /> terminator=c.mid.terminators.count() />)
    return <MidAccessError.None />
}

fn canonicalAccessGeneratedLocalCount(c: Comp, body: MidBodyNode, term: MidTerminatorNode) -> U64 {
    mut val count: U64 = 0U64
    mut val markerI: U64 = 0U64
    while markerI < canonicalAccessMarkerCount(c: c, term: term) {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = 0U64
        while stage < site.chainLen {
            count = count + 1U64
            val accessId: U64 = canonicalAccessChainAt(c: c, body: body, site: site, stage: stage)
            if accessId != 0U64 && canonicalAccessSetterHasResult(c: c, access: c.arena.semanticAccesses[accessId - 1U64]) { count = count + 1U64 }
            stage = stage + 1U64
        }
        markerI = markerI + 1U64
    }
    return count
}

fn canonicalAccessBlockLocalBase(c: Comp, body: MidBodyNode, blockI: U64) -> U64 {
    mut val base: U64 = body.locals.len
    mut val prior: U64 = 0U64
    while prior < blockI && prior < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + prior]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
            base = base + canonicalAccessGeneratedLocalCount(c: c, body: body, term: c.mid.terminators[block.terminator - 1U64])
        }
        prior = prior + 1U64
    }
    return base
}

fn canonicalAccessExpandBlock(c: inout Comp, body: MidBodyNode, blockI: U64, block: MidBlockNode) -> MidAccessError {
    if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return <MidAccessError.UnresolvedAccessCall /> }
    val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
    val markerCount: U64 = canonicalAccessMarkerCount(c: c, term: term)
    if markerCount == 0U64 { return <MidAccessError.None /> }
    val blockStart: U64 = c.mid.blocks.count()
    val localBase: U64 = canonicalAccessBlockLocalBase(c: c, body: body, blockI: blockI)
    val statements: MidRange = canonicalAccessCopyStatements(c: inout c, block: block)
    mut val markerI: U64 = 0U64
    while markerI < markerCount {
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = site.chainLen
        while stage > 0U64 {
            stage = stage - 1U64
            val getterStatements: MidRange = if markerI == 0U64 && stage + 1U64 == site.chainLen { give statements } else { give <MidRange start=0U64 len=0U64 /> }
            val error: MidAccessError = canonicalAccessAppendGetter(c: inout c, body: body, term: term, blockStart: blockStart, localBase: localBase, marker: markerI, stage: stage, statements: getterStatements)
            match error { MidAccessError.None => {} _ => { return error } }
        }
        markerI = markerI + 1U64
    }
    val parentError: MidAccessError = canonicalAccessAppendParentTerminator(c: inout c, body: body, term: term, blockStart: blockStart, localBase: localBase)
    match parentError { MidAccessError.None => {} _ => { return parentError } }
    c.mid.blocks.append(<MidBlockNode terminator=c.mid.terminators.count() />)
    markerI = markerCount
    while markerI > 0U64 {
        markerI = markerI - 1U64
        val site: MidCanonicalAccessSite = canonicalAccessSiteAt(c: c, body: body, term: term, ordinal: markerI)
        mut val stage: U64 = 0U64
        while stage < site.chainLen {
            val error: MidAccessError = canonicalAccessAppendSetter(c: inout c, body: body, term: term, blockStart: blockStart, localBase: localBase, marker: markerI, stage: stage)
            match error { MidAccessError.None => {} _ => { return error } }
            stage = stage + 1U64
        }
    }
    return <MidAccessError.None />
}

// Canonical access elaboration is a single append-only CFG rewrite.  It reads
// final call identities and frozen input recipes only; neither AST recovery
// nor a `MidBody` thaw bridge is permitted after this boundary.
export fn elaborateCanonicalMidAccesses(c: inout Comp, canonical: MidCanonicalBody) -> MidCanonicalAccessElaboration {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidCanonicalAccessElaboration error=<MidAccessError.UnresolvedAccessCall /> /> }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val hasAccess: Bool = false
    mut val scanBlock: U64 = 0U64
    while scanBlock < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + scanBlock]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() && canonicalAccessMarkerCount(c: c, term: c.mid.terminators[block.terminator - 1U64]) != 0U64 { hasAccess = true }
        scanBlock = scanBlock + 1U64
    }
    if !hasAccess { return <MidCanonicalAccessElaboration body=canonical /> }
    val localStart: U64 = c.mid.locals.count()
    val localError: MidAccessError = canonicalAccessAppendLocals(c: inout c, body: body)
    match localError { MidAccessError.None => {} _ => { return <MidCanonicalAccessElaboration error=localError /> } }
    val scopeStart: U64 = c.mid.scopes.count()
    mut val scopeI: U64 = 0U64
    while scopeI < body.scopes.len {
        c.mid.scopes.append(c.mid.scopes[body.scopes.start + scopeI])
        scopeI = scopeI + 1U64
    }
    val blockStart: U64 = c.mid.blocks.count()
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        val markerCount: U64 = if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() { give canonicalAccessMarkerCount(c: c, term: c.mid.terminators[block.terminator - 1U64]) } else { give 0U64 }
        if markerCount == 0U64 {
            val statements: MidRange = canonicalAccessCopyStatements(c: inout c, block: block)
            val terminator: U64 = canonicalAccessCopyTerminator(c: inout c, body: body, terminatorId: block.terminator)
            if terminator == 0U64 { return <MidCanonicalAccessElaboration error=<MidAccessError.UnresolvedAccessCall /> /> }
            c.mid.blocks.append(<MidBlockNode statements=statements terminator=terminator />)
        } else {
            val error: MidAccessError = canonicalAccessExpandBlock(c: inout c, body: body, blockI: blockI, block: block)
            match error { MidAccessError.None => {} _ => { return <MidCanonicalAccessElaboration error=error /> } }
        }
        blockI = blockI + 1U64
    }
    val result: MidCanonicalBody = <MidCanonicalBody body=c.mid.bodies.count() + 1U64 />
    c.mid.bodies.append(<MidBodyNode bodyInstance=body.bodyInstance sourceFunction=body.sourceFunction locals=<MidRange start=localStart len=c.mid.locals.count() - localStart /> scopes=<MidRange start=scopeStart len=body.scopes.len /> blocks=<MidRange start=blockStart len=c.mid.blocks.count() - blockStart /> entry=canonicalAccessRemapTarget(c: c, body: body, target: body.entry) />)
    if !c.mid.isWellFormed(body: result) { return <MidCanonicalAccessElaboration error=<MidAccessError.InvalidAccessChain /> /> }
    return <MidCanonicalAccessElaboration body=result />
}

fn midAccessFor(c: Comp, bodyId: U64, parentResolution: U64, candidate: U64) -> U64 {
    mut val i: U64 = 0U64
    while i < c.arena.semanticAccesses.count() {
        val access: SemanticAccess = c.arena.semanticAccesses[i]
        if access.bodyId == bodyId && access.parentResolution == parentResolution && access.candidateIndex == candidate && access.write {
            return i
        }
        i += 1U64
    }
    return c.arena.semanticAccesses.count()
}

fn midAccessLocalOperand(c: Comp, body: MidBody, exprId: U64) -> MidOperand {
    if exprId >= c.typeCache.identTarget.count() { return <MidOperand.Access candidate=body.locals.count() /> }
    val target: U64 = c.typeCache.identTarget[exprId]
    mut val i: U64 = 0U64
    while i < body.locals.count() {
        if body.locals[i].sourceNameStart == target { return <MidOperand.Copy place=<MidPlace local=i typeTerm=body.locals[i].typeTerm /> /> }
        i += 1U64
    }
    return <MidOperand.Access candidate=body.locals.count() />
}

// Reconstruct only a frozen local/field place after instantiation. Unlike the
// parametric builder this has no lexical binding table, so it joins an Ident
// to MidBody.locals by the resolver's declaration identity, then follows the
// frontend-selected field slots. No name or type lookup is performed here.
fn midAccessPlace(c: Comp, body: MidBody, exprId: U64, term: U64) -> MidPlace {
    if exprId >= c.arena.exprs.count() { return <MidPlace local=body.locals.count() typeTerm=term /> }
    match c.arena.exprs[exprId] {
        Expr.Ident(start: _, len: _) => {
            if exprId >= c.typeCache.identTarget.count() { return <MidPlace local=body.locals.count() typeTerm=term /> }
            val target: U64 = c.typeCache.identTarget[exprId]
            mut val i: U64 = 0U64
            while i < body.locals.count() {
                if body.locals[i].sourceNameStart == target { return <MidPlace local=i typeTerm=term /> }
                i += 1U64
            }
        }
        Expr.Field(base: val base, nameStart: _, nameLen: _) => {
            if exprId >= c.arena.semanticExprTypes.count() || base >= c.arena.semanticExprTypes.count() { return <MidPlace local=body.locals.count() typeTerm=term /> }
            val semantic: SemanticExprType = c.arena.semanticExprTypes[exprId]
            if !(semantic.hasFieldProjection) { return <MidPlace local=body.locals.count() typeTerm=term /> }
            val basePlace: MidPlace = midAccessPlace(c: c, body: body, exprId: base, term: c.arena.semanticExprTypes[base].term)
            if basePlace.local >= body.locals.count() { return basePlace }
            mut val projections: Array[MidProjection] = basePlace.projections
            projections.append(<MidProjection.Field index=semantic.fieldProjectionIndex typeTerm=term />)
            return <MidPlace local=basePlace.local projections=projections typeTerm=term />
        }
        _ => {}
    }
    return <MidPlace local=body.locals.count() typeTerm=term />
}

fn midAccessInput(c: Comp, body: MidBody, exprId: U64, term: U64) -> MidOperand {
    if exprId >= c.arena.exprs.count() { return <MidOperand.Access candidate=body.locals.count() /> }
    match c.arena.exprs[exprId] {
        Expr.Ident(start: _, len: _) => { return midAccessLocalOperand(c: c, body: body, exprId: exprId) }
        Expr.Field(base: _, nameStart: _, nameLen: _) => {
            val place: MidPlace = midAccessPlace(c: c, body: body, exprId: exprId, term: term)
            if place.local < body.locals.count() { return <MidOperand.Copy place=place /> }
            return <MidOperand.Access candidate=body.locals.count() />
        }
        Expr.Int(value: val value, offset: _, isBool: val isBool, tyStart: _, tyLen: _, isNeg: val isNegative) => {
            return <MidOperand.Constant value=<MidConstant.Integer value=value isNegative=isNegative isBool=isBool typeTerm=term /> />
        }
        _ => { return <MidOperand.Access candidate=body.locals.count() /> }
    }
}

fn midAccessCandidateForExpr(c: Comp, exprId: U64) -> U64 {
    mut val i: U64 = 0U64
    while i < c.decls.accessCandidates.count() {
        val candidate = c.decls.accessCandidates[i]
        if candidate.readExpr == exprId || candidate.placeExpr == exprId { return i }
        i += 1U64
    }
    return c.decls.accessCandidates.count()
}

// Reconstruct a projection *only* from the frontend-selected field slots
// between a candidate's getter result and the value its parent consumes. The
// root remains the complete getter value for the eventual IndexSet writeback;
// only the parent borrow is projected. This is deliberately narrower than a
// general place recovery: casts/views need no physical projection, and any
// future value transform must publish its own Mid projection rather than make
// access elaboration rediscover it from spelling.
fn midAccessProjectedValuePlace(c: Comp, rootExpr: U64, accessExpr: U64, accessTerm: U64, root: MidPlace) -> MidPlace {
    if accessExpr == rootExpr { return <MidPlace local=root.local projections=root.projections typeTerm=accessTerm /> }
    if accessExpr >= c.arena.exprs.count() || accessExpr >= c.arena.semanticExprTypes.count() {
        return <MidPlace local=root.local + 1U64 typeTerm=root.typeTerm />
    }
    match c.arena.exprs[accessExpr] {
        Expr.Field(base: val base, nameStart: _, nameLen: _) => {
            val basePlace: MidPlace = midAccessProjectedValuePlace(c: c, rootExpr: rootExpr, accessExpr: base, accessTerm: root.typeTerm, root: root)
            if basePlace.local != root.local { return basePlace }
            val semantic: SemanticExprType = c.arena.semanticExprTypes[accessExpr]
            if !(semantic.hasFieldProjection) { return <MidPlace local=root.local + 1U64 typeTerm=root.typeTerm /> }
            mut val projections: Array[MidProjection] = basePlace.projections
            projections.append(<MidProjection.Field index=semantic.fieldProjectionIndex typeTerm=semantic.term />)
            return <MidPlace local=root.local projections=projections typeTerm=semantic.term />
        }
        _ => {}
    }
    return <MidPlace local=root.local + 1U64 typeTerm=root.typeTerm />
}

// The returned order is outermost to innermost.  An inner access is used by
// the outer setter, so its frozen SemanticAccess is keyed by that setter's
// resolution—not by source spelling or a type query.
fn midAccessChain(c: Comp, body: MidBody, outer: U64) -> Array[U64] {
    mut val chain: Array[U64] = []
    mut val current: U64 = outer
    while current < c.arena.semanticAccesses.count() {
        mut val seen: Bool = false
        mut val i: U64 = 0U64
        while i < chain.count() {
            if chain[i] == current { seen = true }
            i += 1U64
        }
        if seen { return [] }
        chain.append(current)
        val access: SemanticAccess = c.arena.semanticAccesses[current]
        val nestedCandidate: U64 = midAccessCandidateForExpr(c: c, exprId: access.baseExpr)
        if nestedCandidate >= c.decls.accessCandidates.count() { return chain }
        val nested: U64 = midAccessFor(c: c, bodyId: body.bodyInstance, parentResolution: access.writeResolution, candidate: nestedCandidate)
        if nested >= c.arena.semanticAccesses.count() { return [] }
        current = nested
    }
    return []
}

// Materialize `outer.base ... inner.base` as a single continuation chain.
// Getter evaluation runs inner-to-outer; setters and drops run outer-to-inner.
// Thus a nested index is never reinterpreted as a raw addressable projection.
fn elaborateMidAccessChain(c: inout Comp, body: MidBody, source: MidBlock, blockI: U64, parentResolution: U64, candidate: U64, role: U64, receiver: MidCallReceiver, args: Array[MidOperand], destination: MidPlace, target: U64, locals: inout Array[MidLocalDecl], blocks: inout Array[MidBlock]) -> MidAccessError {
    val outer: U64 = midAccessFor(c: c, bodyId: body.bodyInstance, parentResolution: parentResolution, candidate: candidate)
    if outer >= c.arena.semanticAccesses.count() {
        if c.traceCodegen {
            eprint(text: "[trace-codegen] Mid access missing outer body=")
            eprintU64(n: body.bodyInstance)
            eprint(text: " parent=")
            eprintU64(n: parentResolution)
            eprint(text: " candidate=")
            eprintU64(n: candidate)
            eprint(text: " available=")
            eprintU64(n: c.arena.semanticAccesses.count())
            eprint(text: "\n")
            mut val traceI: U64 = 0U64
            while traceI < c.arena.semanticAccesses.count() {
                val available: SemanticAccess = c.arena.semanticAccesses[traceI]
                eprint(text: "[trace-codegen] Mid access available index=")
                eprintU64(n: traceI)
                eprint(text: " body=")
                eprintU64(n: available.bodyId)
                eprint(text: " parent=")
                eprintU64(n: available.parentResolution)
                eprint(text: " candidate=")
                eprintU64(n: available.candidateIndex)
                eprint(text: "\n")
                traceI += 1U64
            }
        }
        return <MidAccessError.MissingOuterSemanticAccess />
    }
    val chain: Array[U64] = midAccessChain(c: c, body: body, outer: outer)
    if chain.count() == 0U64 { return <MidAccessError.InvalidAccessChain /> }
    val outerAccess: SemanticAccess = c.arena.semanticAccesses[outer]
    if outerAccess.role != role { return <MidAccessError.AccessRoleMismatch /> }
    mut val values: Array[MidPlace] = []
    mut val setterPlaces: Array[MidPlace] = []
    mut val dropSetter: Array[Bool] = []
    mut val i: U64 = 0U64
    while i < chain.count() {
        val access: SemanticAccess = c.arena.semanticAccesses[chain[i]]
        if !access.write || access.readResolution >= c.arena.finalCallees.count() || access.writeResolution >= c.arena.finalCallees.count() { return <MidAccessError.UnresolvedAccessCall /> }
        val valueLocal: U64 = locals.count()
        val valuePlace: MidPlace = <MidPlace local=valueLocal typeTerm=access.valueTerm />
        locals.append(<MidLocalDecl typeTerm=access.valueTerm sourceScope=0U64 isUnique=false isParameter=false />)
        values.append(valuePlace)
        val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
        mut val setterPlace: MidPlace = valuePlace
        mut val needsDrop: Bool = false
        if setter.callee < c.arena.funcs.count() && c.arena.funcs[setter.callee].hasRet {
            val resultLocal: U64 = locals.count()
            setterPlace = <MidPlace local=resultLocal typeTerm=setter.resultTypeRef />
            locals.append(<MidLocalDecl typeTerm=setter.resultTypeRef sourceScope=0U64 isUnique=false isParameter=false />)
            needsDrop = true
        }
        setterPlaces.append(setterPlace)
        dropSetter.append(needsDrop)
        i += 1U64
    }
    val getterExtraCount: U64 = chain.count() - 1U64
    val getterStart: U64 = blocks.count()
    val parentBlock: U64 = getterStart + getterExtraCount
    val setterStart: U64 = parentBlock + 1U64
    val totalNew: U64 = getterExtraCount + 1U64 + chain.count() * 2U64
    while blocks.count() < getterStart + totalNew { blocks.append(<MidBlock />) }
    mut val stage: U64 = chain.count()
    while stage > 0U64 {
        stage -= 1U64
        val access: SemanticAccess = c.arena.semanticAccesses[chain[stage]]
        mut val base: MidOperand = <MidOperand.Access candidate=c.decls.accessCandidates.count() />
        if stage + 1U64 < chain.count() {
            base = <MidOperand.Copy place=values[stage + 1U64] />
        } else {
            base = midAccessInput(c: c, body: body, exprId: access.baseExpr, term: access.baseTerm)
        }
        val key: MidOperand = midAccessInput(c: c, body: body, exprId: access.keyExpr, term: access.keyTerm)
        match base { MidOperand.Access(candidate: _) => { return <MidAccessError.UnsupportedAccessBase /> } _ => {} }
        match key { MidOperand.Access(candidate: _) => { return <MidAccessError.UnsupportedAccessKey /> } _ => {} }
        val next: U64 = if stage == 0U64 { give parentBlock } else { give getterStart + chain.count() - 1U64 - stage }
        val read: MidTerminator = <MidTerminator.Call callee=<MidCallTarget.Resolved resolution=access.readResolution /> receiver=<MidCallReceiver.Value operand=base /> args=[key] destination=values[stage] target=next />
        if stage + 1U64 == chain.count() {
            blocks.set(i: blockI, value: <MidBlock statements=source.statements terminator=read />)
        } else {
            val getterBlock: U64 = getterStart + chain.count() - 2U64 - stage
            blocks.set(i: getterBlock, value: <MidBlock terminator=read />)
        }
    }
    mut val parentReceiver: MidCallReceiver = receiver
    mut val parentArgs: Array[MidOperand] = args
    val parentPlace: MidPlace = midAccessProjectedValuePlace(c: c, rootExpr: c.decls.accessCandidates[outerAccess.candidateIndex].readExpr, accessExpr: outerAccess.accessExpr, accessTerm: outerAccess.accessTerm, root: values[0U64])
    if parentPlace.local != values[0U64].local { return <MidAccessError.UnsupportedAccessProjection /> }
    val borrowedOuter: MidOperand = <MidOperand.Borrow place=parentPlace capability=<MidBorrowCapability.Inout /> />
    if role == 1U64 {
        parentReceiver = <MidCallReceiver.Value operand=borrowedOuter />
    } else {
        if outerAccess.parameterIndex >= parentArgs.count() { return <MidAccessError.ParentAccessArgumentMissing /> }
        match parentArgs[outerAccess.parameterIndex] {
            MidOperand.Access(candidate: val marked) => { if marked != candidate { return <MidAccessError.ParentAccessArgumentMismatch /> } }
            _ => { return <MidAccessError.ParentAccessArgumentMismatch /> }
        }
        parentArgs.set(i: outerAccess.parameterIndex, value: borrowedOuter)
    }
    blocks.set(i: parentBlock, value: <MidBlock terminator=<MidTerminator.Call callee=<MidCallTarget.Resolved resolution=parentResolution /> receiver=parentReceiver args=parentArgs destination=destination target=setterStart /> />)
    i = 0U64
    while i < chain.count() {
        val access: SemanticAccess = c.arena.semanticAccesses[chain[i]]
        mut val base: MidOperand = <MidOperand.Access candidate=c.decls.accessCandidates.count() />
        if i + 1U64 < chain.count() {
            base = <MidOperand.Copy place=values[i + 1U64] />
        } else {
            base = midAccessInput(c: c, body: body, exprId: access.baseExpr, term: access.baseTerm)
        }
        val key: MidOperand = midAccessInput(c: c, body: body, exprId: access.keyExpr, term: access.keyTerm)
        match base { MidOperand.Access(candidate: _) => { return <MidAccessError.UnsupportedAccessBase /> } _ => {} }
        match key { MidOperand.Access(candidate: _) => { return <MidAccessError.UnsupportedAccessKey /> } _ => {} }
        val setter: CallResolution = c.arena.finalCallees[access.writeResolution]
        mut val receiverOperand: MidOperand = base
        if setter.callee < c.arena.funcs.count() && c.arena.funcs[setter.callee].selfInout {
            match base {
                MidOperand.Copy(place: val place) => { receiverOperand = <MidOperand.Borrow place=place capability=<MidBorrowCapability.Inout /> /> }
                _ => { return <MidAccessError.UnsupportedSetterReceiver /> }
            }
        }
        val setterBlock: U64 = setterStart + i * 2U64
        val afterSetter: U64 = setterBlock + 1U64
        val setterTerm: MidTerminator = <MidTerminator.Call callee=<MidCallTarget.Resolved resolution=access.writeResolution /> receiver=<MidCallReceiver.Value operand=receiverOperand /> args=[key, <MidOperand.Copy place=values[i] />] destination=setterPlaces[i] target=afterSetter />
        blocks.set(i: setterBlock, value: <MidBlock terminator=setterTerm />)
        mut val cleanup: Array[MidStatement] = [<MidStatement.Drop place=values[i] />]
        if dropSetter[i] { cleanup.append(<MidStatement.Drop place=setterPlaces[i] />) }
        val continuation: MidTerminator = if i + 1U64 < chain.count() { give <MidTerminator.Goto target=setterStart + (i + 1U64) * 2U64 /> } else { give <MidTerminator.Goto target=target /> }
        blocks.set(i: afterSetter, value: <MidBlock statements=cleanup terminator=continuation />)
        i += 1U64
    }
    return <MidAccessError.None />
}

// Expand each selected access into read -> parent(inout temp) -> writeback ->
// cleanup.  The input and descriptor identities have all been frozen; this
// code never resolves a collection method or reads a source type.  A parent
// can contain several access markers; processing the growing block list makes
// those nested expansions explicit instead of silently choosing one.
export fn elaborateMidAccesses(c: inout Comp, body: MidBody) -> MidAccessElaboration {
    mut val locals: Array[MidLocalDecl] = body.locals
    mut val blocks: Array[MidBlock] = body.blocks
    mut val blockI: U64 = 0U64
    while blockI < blocks.count() {
        val source: MidBlock = blocks[blockI]
        match source.terminator {
            MidTerminator.Call(callee: val callee, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
                match callee {
                    MidCallTarget.Resolved(resolution: val parentResolution) => {
                        mut val candidate: U64 = c.decls.accessCandidates.count()
                        mut val role: U64 = 0U64
                        match receiver {
                            MidCallReceiver.Value(operand: val receiverOperand) => {
                                match receiverOperand {
                                    MidOperand.Access(candidate: val receiverCandidate) => {
                                        candidate = receiverCandidate
                                        role = 1U64
                                    }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                        if role == 0U64 {
                            mut val argI: U64 = 0U64
                            while argI < args.count() {
                                match args[argI] {
                                    MidOperand.Access(candidate: val argumentCandidate) => {
                                        candidate = argumentCandidate
                                        role = 2U64
                                        argI = args.count()
                                    }
                                    _ => { argI += 1U64 }
                                }
                            }
                        }
                        if role != 0U64 {
                            val error: MidAccessError = elaborateMidAccessChain(c: inout c, body: body, source: source, blockI: blockI, parentResolution: parentResolution, candidate: candidate, role: role, receiver: receiver, args: args, destination: destination, target: target, locals: inout locals, blocks: inout blocks)
                            match error {
                                MidAccessError.None => {}
                                _ => { return <MidAccessElaboration body=body error=error /> }
                            }
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        blockI += 1U64
    }
    return <MidAccessElaboration body=<MidBody bodyInstance=body.bodyInstance sourceFunction=body.sourceFunction locals=locals scopes=body.scopes blocks=blocks entry=body.entry /> />
}
