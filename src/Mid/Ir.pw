// @Mid/Ir — backend-independent plain CFG vocabulary for the ownership-aware
// Mid IR.  This is deliberately a separate arena from source AST `Ir`: AST
// nodes retain syntax/source identity, while Mid nodes record the already
// selected evaluation and ownership operations that LLVM must materialize.
//
// The representation is Rust-MIR-shaped rather than SSA: joins write into a
// `MidPlace`, and only terminators create CFG edges.  Ownership is expressed by
// Copy / Move / Drop operations on places; raw retain/release is not an IR
// escape hatch.

import ../Ir with { CallSiteKey }

// Canonical Mid storage is deliberately separate from the builder vocabulary
// below.  A Mid body is read by instantiation, drop elaboration, verification,
// and LLVM many times; none of those reads may copy an owning Array hidden in a
// struct or enum payload.  The current MidBody form remains the transitional
// draft carrier while users migrate to these IDs.  Once the migration is
// complete, only MidCanonicalArena survives past the builder/freeze boundary.
export struct MidRange {
    pub val start: U64
    pub val len: U64
}
pub impl MidRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct MidBodyNode {
    pub val bodyInstance: U64 = 0U64
    pub val sourceFunction: U64 = 0U64
    pub val locals: MidRange = <MidRange start=0U64 len=0U64 />
    pub val scopes: MidRange = <MidRange start=0U64 len=0U64 />
    pub val blocks: MidRange = <MidRange start=0U64 len=0U64 />
    pub val entry: U64 = 0U64
}
pub impl MidBodyNode { factory }

export struct MidPlaceNode {
    pub val local: U64
    pub val projections: MidRange = <MidRange start=0U64 len=0U64 />
    pub val typeTerm: U64 = 0U64
}
pub impl MidPlaceNode { factory }

// `tag` is 1=Field, 2=Index.  A canonical node never embeds the draft
// `MidProjection` enum: all payload fields remain scalar and the parent Place
// owns only a range in this dedicated pool.
export struct MidProjectionNode {
    pub val tag: U64
    pub val index: U64 = 0U64
    pub val indexLocal: U64 = 0U64
    pub val typeTerm: U64 = 0U64
}
pub impl MidProjectionNode { factory }

export struct MidAggregateElementNode {
    pub val fieldIndex: U64
    pub val operand: U64
    pub val targetTerm: U64 = 0U64
    pub val isBoxed: Bool
    // A proof ID, not a recursive ValueConversionProof payload.  The proof
    // arena is introduced together with final frontend proof DAG migration.
    pub val conversion: U64 = 0U64
}
pub impl MidAggregateElementNode { factory }

export struct MidSwitchCase {
    pub val value: I64
    pub val target: U64
}
pub impl MidSwitchCase { factory }

// Every child reference here is a stable ID into MidCanonicalArena.  These
// records intentionally use integer tags instead of reusing the transitional
// nested enums: their payloads must stay scalar even when the draft enums gain
// new source-lowering forms.
export struct MidOperandNode {
    pub val tag: U64
    pub val place: U64 = 0U64
    pub val capability: U64 = 0U64
    pub val integerValue: U64 = 0U64
    pub val integerNegative: Bool = false
    pub val integerBool: Bool = false
    pub val stringStart: U64 = 0U64
    pub val stringLen: U64 = 0U64
    pub val typeTerm: U64 = 0U64
    pub val accessCandidate: U64 = 0U64
}
pub impl MidOperandNode { factory }

export struct MidRvalueNode {
    pub val tag: U64
    pub val operand: U64 = 0U64
    pub val exprId: U64 = 0U64
    pub val kindTag: U64 = 0U64
    pub val enumIndex: U64 = 0U64
    pub val variantIndex: U64 = 0U64
    pub val resultTerm: U64 = 0U64
    pub val fieldCount: U64 = 0U64
    pub val elements: MidRange = <MidRange start=0U64 len=0U64 />
    pub val conversion: U64 = 0U64
    pub val sourceStmt: U64 = 0U64
    pub val fieldIndex: U64 = 0U64
    pub val bindTarget: U64 = 0U64
    pub val sourceTerm: U64 = 0U64
    pub val targetTerm: U64 = 0U64
}
pub impl MidRvalueNode { factory }

// `tag` is 1=Template, 2=Resolved. Template identity is copied field-wise so
// canonical Mid never retains a source-level struct payload behind a variant.
export struct MidCallTargetNode {
    pub val tag: U64
    pub val resolution: U64 = 0U64
    pub val ownerFnIdx: U64 = 0U64
    pub val originKind: U64 = 0U64
    pub val originStart: U64 = 0U64
    pub val originEnd: U64 = 0U64
    pub val originSerial: U64 = 0U64
    pub val slot: U64 = 0U64
}
pub impl MidCallTargetNode { factory }

// `tag` is 1=None, 2=Value. `operand` is a one-based canonical operand ID.
export struct MidCallReceiverNode {
    pub val tag: U64
    pub val operand: U64 = 0U64
}
pub impl MidCallReceiverNode { factory }

export struct MidStatementNode {
    pub val tag: U64
    pub val destination: U64 = 0U64
    pub val value: U64 = 0U64
    pub val source: U64 = 0U64
    pub val flag: U64 = 0U64
    pub val isSet: Bool = false
    pub val scope: U64 = 0U64
}
pub impl MidStatementNode { factory }

export struct MidTerminatorNode {
    pub val tag: U64
    pub val target: U64 = 0U64
    pub val discriminant: U64 = 0U64
    pub val cases: MidRange = <MidRange start=0U64 len=0U64 />
    pub val otherwise: U64 = 0U64
    pub val calleeTag: U64 = 0U64
    pub val callee: U64 = 0U64
    pub val receiver: U64 = 0U64
    pub val args: MidRange = <MidRange start=0U64 len=0U64 />
    pub val destination: U64 = 0U64
    pub val state: U64 = 0U64
    pub val resume: U64 = 0U64
    // ReturnValue and Panic use this one-based operand ID.  Keeping it named
    // avoids overloading Switch's discriminant with an unrelated role.
    pub val value: U64 = 0U64
    // Canonical call identities are owner-specific pools, not an enum payload
    // embedded in this terminator row.
    pub val callTarget: U64 = 0U64
    pub val callReceiver: U64 = 0U64
}
pub impl MidTerminatorNode { factory }

export struct MidBlockNode {
    pub val statements: MidRange = <MidRange start=0U64 len=0U64 />
    pub val terminator: U64 = 0U64
}
pub impl MidBlockNode { factory }

export struct MidCanonicalArena {
    pub mut val bodies: Array[MidBodyNode] = []
    pub mut val locals: Array[MidLocalDecl] = []
    pub mut val scopes: Array[MidScope] = []
    pub mut val blocks: Array[MidBlockNode] = []
    pub mut val statements: Array[MidStatementNode] = []
    pub mut val terminators: Array[MidTerminatorNode] = []
    pub mut val places: Array[MidPlaceNode] = []
    pub mut val projections: Array[MidProjectionNode] = []
    pub mut val operands: Array[MidOperandNode] = []
    pub mut val rvalues: Array[MidRvalueNode] = []
    pub mut val aggregateElements: Array[MidAggregateElementNode] = []
    pub mut val switchCases: Array[MidSwitchCase] = []
    pub mut val callArguments: Array[U64] = []
    pub mut val callTargets: Array[MidCallTargetNode] = []
    pub mut val callReceivers: Array[MidCallReceiverNode] = []
}
pub impl MidCanonicalArena { factory }

// A one-based immutable body ID in MidCanonicalArena.  Zero is never a
// frozen body, which keeps optional node references and the first body
// unambiguous without reserving dummy arena rows.
export struct MidCanonicalBody {
    pub val body: U64
}
pub impl MidCanonicalBody { factory }

// A projection is kept first-class even though Path 1 only moves root locals.
// Field/index paths are already needed for assignments and future borrow/access
// analysis; partial unique moves stay rejected by the frontend.
export enum MidProjection {
    // `typeTerm` is the frontend-selected type after this projection.  It is
    // needed for a nested GEP walk and prevents LLVM from reconstructing a
    // field declaration/type from a source spelling.
    Field(index: U64, typeTerm: U64)
    // The subscript expression is evaluated before this place is used and its
    // value lives in `indexLocal`.  Storing a stable local identity (rather
    // than an Operand or source ExprId) makes the projection acyclic and
    // preserves both evaluation order and single evaluation through CFG
    // lowering. `typeTerm` is the already-selected element type.
    Index(indexLocal: U64, typeTerm: U64)
}

export struct MidPlace {
    // Index into MidBody.locals.  It is never an AST Local or a backend stack
    // slot: lowering maps source bindings to this stable IR identity once.
    pub val local: U64
    pub val projections: Array[MidProjection] = []
    // Canonical frontend TypeTerm. It may contain lexical ParamIds while this
    // body is parametric; instantiation substitutes it once into a concrete
    // TypeRef. A zero value is allowed only for compiler-generated unit/control
    // places.
    pub val typeTerm: U64 = 0U64
}
pub impl MidPlace { factory }

export enum MidBorrowCapability {
    Read
    Inout
}

// The forward ownership lattice for one root local. `MaybeOwned` is produced
// only by a CFG join whose incoming paths disagree. It is deliberately not a
// source-level state: drop elaboration turns it into a generated flag and a
// conditional Drop on the relevant edge.
export enum MidOwnership {
    Owned
    Consumed
    MaybeOwned
}

// Source-level owner accessibility is intentionally independent from ownership.
// After `if c { move f }`, the false path may still own the value, but the join
// cannot name `f` as a uniform owner; it is therefore Unavailable and must be
// dropped at that accessibility cliff if it remains owned.
export enum MidAccessibility {
    Available
    Unavailable
}

// A constant is semantic value data, not an AST anchor. Keeping a source ExprId
// here would invite LLVM lowering to reopen expression resolution after the
// frontend freeze. New forms extend this closed sum with selected layout and
// children; they never fall back to source recovery.
export enum MidConstant {
    Integer(value: U64, isNegative: Bool, isBool: Bool, typeTerm: U64)
    // The lexer-validated literal token is immutable source value data.  It is
    // not an ExprId and carries no type/call/name decision; lowering may decode
    // its bytes but must not reopen semantic expression resolution.
    StringLiteral(start: U64, len: U64, typeTerm: U64)
    // Validated numeric text with its selected type, just like StringLiteral.
    // Append-only while older compiler generations bootstrap this enum.
    FloatLiteral(start: U64, len: U64, typeTerm: U64)
}

// Every produced Mid value has explicit ownership provenance.
export enum MidOperand {
    Copy(place: MidPlace)
    Move(place: MidPlace)
    Borrow(place: MidPlace, capability: MidBorrowCapability)
    Constant(value: MidConstant)
    // A Lower-published indexed read that has not yet been expanded into its
    // instance-specific get-modify-set CFG. It is valid only between the
    // parametric builder and access elaboration; verifier/backend reject it.
    Access(candidate: U64)
}

// The frontend has already selected the nominal/variant layout.  Elements are
// kept in source evaluation order while fieldIndex identifies their eventual
// physical slot, so neither Mid nor LLVM ever consult JSX labels or a variant
// name.  Array indices happen to equal this source order.
export enum MidAggregateKind {
    Struct
    Enum(enumIdx: U64, variantIndex: U64)
    Array
}

export struct MidAggregateElement {
    pub val fieldIndex: U64
    pub val operand: MidOperand
    // Physical destination-slot TypeTerm selected by Record.  It stays beside
    // the source operand so instantiation can freeze a ValueConversionProof
    // without inspecting a declaration or field spelling.
    pub val targetTerm: U64 = 0U64
    // `true` means a fresh owning cell holds the logical `targetTerm` value
    // before its pointer is inserted into this aggregate's physical slot.
    pub val isBoxed: Bool
    // Frozen frontend ConversionProofNode ID. Zero is invalid for an
    // instantiated aggregate element; builder leaves it zero until the
    // BodyInstance-specific final aggregate resolution supplies it.
    pub val conversion: U64 = 0U64
}
pub impl MidAggregateElement { factory }

export enum MidRvalue {
    Use(operand: MidOperand)
    // The ABI return boundary is distinct from an ordinary assignment. Its
    // source ExprId navigates to a frontend-frozen FinalReturnResolution during
    // instantiation; backend lowering must never see this parametric form.
    ReturnBoundary(exprId: U64, targetTerm: U64, operand: MidOperand)
    // Record's source aggregate identity selects the BodyInstance-specific
    // FinalAggregateResolution during instantiation. It is navigation into an
    // immutable frontend fact, never syntax re-analysis.
    Aggregate(exprId: U64, kind: MidAggregateKind, resultTerm: U64, fieldCount: U64, elements: Array[MidAggregateElement])
    // A frontend-selected non-identity value conversion.  The destination
    // place is its fresh owned home, so ordinary Mid drop elaboration rather
    // than a backend temporary list owns the temporary's lifetime.  The
    // closed proof selects leaf boxing versus structural re-packing; Mid never
    // reconstructs either decision from source syntax.
    // Frozen frontend ConversionProofNode ID. Mid transports selected evidence
    // but never embeds/reconstructs its recursive proof payload.
    Convert(operand: MidOperand, conversion: U64)
    // An authored primitive/newtype `as` is a source-level conversion boundary,
    // not an LLVM-side reinterpretation of Expr.Cast.  The parametric form
    // carries only Record-selected TypeTerms; instantiation grounds and closes
    // it into Cast before verification/backend lowering.
    CastBoundary(exprId: U64, sourceTerm: U64, targetTerm: U64, operand: MidOperand)
    Cast(operand: MidOperand, kind: MidCastKind, targetTerm: U64)
    // Read an enum tag from an already-evaluated place.  The enum declaration
    // slot comes from SemanticMatch; this is a read-only layout operation and
    // never owns/copies the complete enum value.
    EnumTag(place: MidPlace, enumIndex: U64, sourceStmt: U64, resultTerm: U64)
    // Copy exactly one selected enum payload field into an arm-local place.
    // This is intentionally not a general Field projection: enum payload
    // layout depends on the selected variant, and all three declaration slots
    // are frozen by SemanticMatch rather than rediscovered by LLVM.
    EnumPayloadCopy(place: MidPlace, enumIndex: U64, variantIndex: U64, fieldIndex: U64, bindTarget: U64, sourceStmt: U64, resultTerm: U64)
    // Bind an ARC payload as a read-only alias of the live scrutinee. The
    // destination local is marked borrowed, so this operation neither creates
    // ownership nor a drop obligation; an eventual Copy(place) is the sole
    // operation that obtains an independent value-semantic share.
    EnumPayloadBorrow(place: MidPlace, enumIndex: U64, variantIndex: U64, fieldIndex: U64, bindTarget: U64, sourceStmt: U64, resultTerm: U64)
    // The corresponding operations for a recursive field stored in an owning
    // cell. The logical resultTerm is loaded from that selected cell; no enum
    // layout query remains in LLVM.
    EnumPayloadBoxedCopy(place: MidPlace, enumIndex: U64, variantIndex: U64, fieldIndex: U64, bindTarget: U64, sourceStmt: U64, resultTerm: U64)
    EnumPayloadBoxedBorrow(place: MidPlace, enumIndex: U64, variantIndex: U64, fieldIndex: U64, bindTarget: U64, sourceStmt: U64, resultTerm: U64)
}

// Closed representation operation selected from the frozen, grounded source
// and target terms.  User-defined `From` casts are rewritten into ordinary
// calls before Mid; this enum therefore has no callable/witness escape hatch.
export enum MidCastKind {
    IntegerWiden(sourceSigned: Bool)
    IntegerToFloat(sourceSigned: Bool)
    IdentityRetag
}

// A parametric body names a frontend CallTemplate by its semantic site identity.
// After explicit BodyInstance substitution, the same call is replaced by the
// immutable final CallResolution index. This sum prevents a builder from
// smuggling a raw name/arity lookup across the phase boundary.
export enum MidCallTarget {
    Template(site: CallSiteKey)
    Resolved(resolution: U64)
}

// The receiver is ABI input with a distinct source/ownership role from a
// function's declared parameters. Keeping it out of `args` preserves the
// frontend-selected parameter mapping while still making `self` copy/inout
// capability explicit to Mid dataflow and LLVM lowering.
export enum MidCallReceiver {
    None
    Value(operand: MidOperand)
}

// Statements never create a CFG edge.  `SetDropFlag` is compiler-generated by
// drop elaboration only; source lowering never hand-writes branch-specific
// cleanup.  This keeps the conditional-move rule in one dataflow pass.
export enum MidStatement {
    // Initializes a previously unowned destination from an already-evaluated
    // rvalue. Source lowering uses this for `let`; overwrite uses a separate
    // temporary and must not be conflated with initialization.
    Assign(destination: MidPlace, value: MidRvalue)
    // Consumes an owned temporary after the old destination has been dropped.
    // The explicit source place preserves RHS-before-destroy ordering for
    // `x = x` and `x = f(x)` without relying on backend evaluation order.
    Overwrite(destination: MidPlace, source: MidPlace)
    Drop(place: MidPlace)
    // Elaborated conditional drop for a MaybeOwned root. `flag` is a generated
    // boolean local: initialization/Assign set it and Move clears it.
    ConditionalDrop(place: MidPlace, flag: U64)
    SetDropFlag(local: U64, isSet: Bool)
    // A lexical CFG boundary, analogous to Rust MIR StorageDead. Source
    // lowering emits it; drop elaboration consumes it into explicit Drop /
    // ConditionalDrop statements, so LLVM never receives this marker.
    ScopeExit(scope: U64)
    Nop
}

// Exactly the Path 1 terminator set. A call refers either to a parametric
// frontend CallTemplate site or, after instantiation, an immutable final
// CallResolution identity; neither is a name/arity lookup key. `Switch` keeps
// targets parallel to `values`; `otherwise` is always present. `ReturnValue`
// has already moved/copied the source into the ABI return place before scope
// drops are elaborated.
export enum MidTerminator {
    // Builder-only sentinel for a block whose control-flow edge is not chosen
    // yet. It must be eliminated before verification/emission.
    Open
    Goto(target: U64)
    // Source pattern cases are signed integer values. The LLVM emitter keeps
    // their two's-complement bit pattern when materializing the literal for
    // the discriminant's concrete integer representation.
    Switch(discriminant: MidOperand, values: Array[I64], targets: Array[U64], otherwise: U64)
    Call(callee: MidCallTarget, receiver: MidCallReceiver, args: Array[MidOperand], destination: MidPlace, target: U64)
    Return
    ReturnValue(value: MidOperand)
    // Source `panic message`: evaluate the already-typed String operand, call
    // the runtime noreturn sink, and end this CFG path.  It is deliberately a
    // terminator rather than a call with an invented continuation.
    Panic(message: MidOperand)
    Unreachable
    Abort
    Suspend(state: U64, resume: U64)
}

export struct MidBlock {
    pub val statements: Array[MidStatement] = []
    pub val terminator: MidTerminator = <MidTerminator.Open />
}
pub impl MidBlock { factory }

// `sourceScope` is a lexical-scope side-table identity, not a block nesting
// shortcut.  Drop elaboration uses it to preserve source-order destruction
// while operating exclusively on flat CFG edges.
export struct MidLocalDecl {
    // Parametric TypeTerm; instantiateMidBody replaces it with a ground TypeRef
    // without re-resolving source spelling.
    pub val typeTerm: U64
    pub val sourceScope: U64
    pub val isUnique: Bool
    pub val isParameter: Bool
    // A match payload borrow aliases a live scrutinee. It is a usable source
    // Place but never owns the representation stored in its local slot.
    pub val isBorrowed: Bool = false
    // An inout parameter's Place is supplied directly by the caller ABI; it
    // is not a value copied into a callee-owned local slot.
    pub val isInout: Bool = false
    // Whether this root has a live owned value at body entry. A by-value/borrow
    // parameter starts false; a move parameter starts true. An initialized local
    // becomes owned only at its explicit Assign statement.
    pub val ownsAtEntry: Bool = false
    // Compiler-generated boolean used only by drop elaboration. It is not a
    // source place and never participates in user ownership/accessibility.
    pub val isDropFlag: Bool = false
    // Compiler-generated ABI result storage. It is outside every source
    // lexical scope: a value is copied/moved here before cleanup, then
    // transferred by `ReturnValue` without any source-name recovery.
    pub val isReturnPlace: Bool = false
    pub val sourceNameStart: U64 = 0U64
}
pub impl MidLocalDecl { factory }

export struct MidScope {
    pub val parent: U64 = 0U64
    // Locals are declared in increasing `MidLocalDecl` order.  The range gives
    // drop elaboration the deterministic reverse-declaration order required by
    // spec/03 without retaining structured control flow in the IR itself.
    pub val firstLocal: U64 = 0U64
    pub val localCount: U64 = 0U64
}
pub impl MidScope { factory }

export struct MidBody {
    // Index into the immutable frontend BodyInstance table.  A body is
    // parametric while built and receives concrete TypeRefs only on
    // instantiation; this field is nonzero for an instantiated body.
    pub val bodyInstance: U64 = 0U64
    pub val sourceFunction: U64 = 0U64
    pub val locals: Array[MidLocalDecl] = []
    pub val scopes: Array[MidScope] = []
    pub val blocks: Array[MidBlock] = []
    pub val entry: U64 = 0U64
}
pub impl MidBody { factory }

export struct MidProgram {
    pub val bodies: Array[MidBody] = []
}
pub impl MidProgram { factory }

// --- Draft -> canonical freeze ------------------------------------------------
//
// These helpers are intentionally one-way. `MidBody` is still the mutable
// construction vocabulary, but after this boundary every child is a stable,
// one-based ID or an owner-specific range in `MidCanonicalArena`.  No helper
// reconstructs a draft enum/Array from the arena: consumers must eventually
// read this representation directly.

fn midFreezeProjection(arena: inout MidCanonicalArena, projection: MidProjection) {
    match projection {
        MidProjection.Field(index: val index, typeTerm: val typeTerm) => {
            arena.projections.append(<MidProjectionNode tag=1U64 index=index typeTerm=typeTerm />)
        }
        MidProjection.Index(indexLocal: val indexLocal, typeTerm: val typeTerm) => {
            arena.projections.append(<MidProjectionNode tag=2U64 indexLocal=indexLocal typeTerm=typeTerm />)
        }
    }
}

fn midFreezePlace(arena: inout MidCanonicalArena, place: MidPlace) -> U64 {
    val projectionStart: U64 = arena.projections.count()
    mut val projectionI: U64 = 0U64
    while projectionI < place.projections.count() {
        midFreezeProjection(arena: inout arena, projection: place.projections[projectionI])
        projectionI = projectionI + 1U64
    }
    arena.places.append(<MidPlaceNode local=place.local projections=<MidRange start=projectionStart len=place.projections.count() /> typeTerm=place.typeTerm />)
    return arena.places.count()
}

fn midFreezeOperand(arena: inout MidCanonicalArena, operand: MidOperand) -> U64 {
    match operand {
        MidOperand.Copy(place: val place) => {
            arena.operands.append(<MidOperandNode tag=1U64 place=midFreezePlace(arena: inout arena, place: place) />)
        }
        MidOperand.Move(place: val place) => {
            arena.operands.append(<MidOperandNode tag=2U64 place=midFreezePlace(arena: inout arena, place: place) />)
        }
        MidOperand.Borrow(place: val place, capability: val capability) => {
            match capability {
                MidBorrowCapability.Read => { arena.operands.append(<MidOperandNode tag=3U64 place=midFreezePlace(arena: inout arena, place: place) capability=1U64 />) }
                MidBorrowCapability.Inout => { arena.operands.append(<MidOperandNode tag=4U64 place=midFreezePlace(arena: inout arena, place: place) capability=2U64 />) }
            }
        }
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: val value, isNegative: val isNegative, isBool: val isBool, typeTerm: val typeTerm) => {
                    arena.operands.append(<MidOperandNode tag=5U64 integerValue=value integerNegative=isNegative integerBool=isBool typeTerm=typeTerm />)
                }
                MidConstant.StringLiteral(start: val start, len: val len, typeTerm: val typeTerm) => {
                    arena.operands.append(<MidOperandNode tag=6U64 stringStart=start stringLen=len typeTerm=typeTerm />)
                }
                MidConstant.FloatLiteral(start: val start, len: val len, typeTerm: val typeTerm) => {
                    arena.operands.append(<MidOperandNode tag=7U64 stringStart=start stringLen=len typeTerm=typeTerm />)
                }
            }
        }
        MidOperand.Access(candidate: val candidate) => {
            arena.operands.append(<MidOperandNode tag=8U64 accessCandidate=candidate />)
        }
    }
    return arena.operands.count()
}

fn midFreezeAggregateElement(arena: inout MidCanonicalArena, element: MidAggregateElement) {
    arena.aggregateElements.append(<MidAggregateElementNode fieldIndex=element.fieldIndex operand=midFreezeOperand(arena: inout arena, operand: element.operand) targetTerm=element.targetTerm isBoxed=element.isBoxed conversion=element.conversion />)
}

fn midFreezeRvalue(arena: inout MidCanonicalArena, value: MidRvalue) -> U64 {
    match value {
        MidRvalue.Use(operand: val operand) => {
            arena.rvalues.append(<MidRvalueNode tag=1U64 operand=midFreezeOperand(arena: inout arena, operand: operand) />)
        }
        MidRvalue.ReturnBoundary(exprId: val exprId, targetTerm: val targetTerm, operand: val operand) => {
            arena.rvalues.append(<MidRvalueNode tag=2U64 operand=midFreezeOperand(arena: inout arena, operand: operand) exprId=exprId targetTerm=targetTerm />)
        }
        MidRvalue.Aggregate(exprId: val exprId, kind: val kind, resultTerm: val resultTerm, fieldCount: val fieldCount, elements: val elements) => {
            val start: U64 = arena.aggregateElements.count()
            mut val i: U64 = 0U64
            while i < elements.count() {
                midFreezeAggregateElement(arena: inout arena, element: elements[i])
                i = i + 1U64
            }
            match kind {
                MidAggregateKind.Struct => { arena.rvalues.append(<MidRvalueNode tag=3U64 exprId=exprId resultTerm=resultTerm fieldCount=fieldCount elements=<MidRange start=start len=elements.count() /> />) }
                MidAggregateKind.Enum(enumIdx: val enumIdx, variantIndex: val variantIndex) => { arena.rvalues.append(<MidRvalueNode tag=4U64 exprId=exprId enumIndex=enumIdx variantIndex=variantIndex resultTerm=resultTerm fieldCount=fieldCount elements=<MidRange start=start len=elements.count() /> />) }
                MidAggregateKind.Array => { arena.rvalues.append(<MidRvalueNode tag=5U64 exprId=exprId resultTerm=resultTerm fieldCount=fieldCount elements=<MidRange start=start len=elements.count() /> />) }
            }
        }
        MidRvalue.Convert(operand: val operand, conversion: val conversion) => {
            arena.rvalues.append(<MidRvalueNode tag=6U64 operand=midFreezeOperand(arena: inout arena, operand: operand) conversion=conversion />)
        }
        MidRvalue.CastBoundary(exprId: val exprId, sourceTerm: val sourceTerm, targetTerm: val targetTerm, operand: val operand) => {
            arena.rvalues.append(<MidRvalueNode tag=7U64 operand=midFreezeOperand(arena: inout arena, operand: operand) exprId=exprId sourceTerm=sourceTerm targetTerm=targetTerm />)
        }
        MidRvalue.Cast(operand: val operand, kind: val kind, targetTerm: val targetTerm) => {
            match kind {
                MidCastKind.IntegerWiden(sourceSigned: val sourceSigned) => {
                    if sourceSigned { arena.rvalues.append(<MidRvalueNode tag=8U64 operand=midFreezeOperand(arena: inout arena, operand: operand) kindTag=1U64 targetTerm=targetTerm />) }
                    else { arena.rvalues.append(<MidRvalueNode tag=8U64 operand=midFreezeOperand(arena: inout arena, operand: operand) kindTag=2U64 targetTerm=targetTerm />) }
                }
                MidCastKind.IntegerToFloat(sourceSigned: val sourceSigned) => {
                    if sourceSigned { arena.rvalues.append(<MidRvalueNode tag=9U64 operand=midFreezeOperand(arena: inout arena, operand: operand) kindTag=1U64 targetTerm=targetTerm />) }
                    else { arena.rvalues.append(<MidRvalueNode tag=9U64 operand=midFreezeOperand(arena: inout arena, operand: operand) kindTag=2U64 targetTerm=targetTerm />) }
                }
                MidCastKind.IdentityRetag => { arena.rvalues.append(<MidRvalueNode tag=10U64 operand=midFreezeOperand(arena: inout arena, operand: operand) targetTerm=targetTerm />) }
            }
        }
        MidRvalue.EnumTag(place: val place, enumIndex: val enumIndex, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            arena.rvalues.append(<MidRvalueNode tag=11U64 operand=midFreezePlace(arena: inout arena, place: place) enumIndex=enumIndex sourceStmt=sourceStmt resultTerm=resultTerm />)
        }
        MidRvalue.EnumPayloadCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            arena.rvalues.append(<MidRvalueNode tag=12U64 operand=midFreezePlace(arena: inout arena, place: place) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=resultTerm />)
        }
        MidRvalue.EnumPayloadBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            arena.rvalues.append(<MidRvalueNode tag=13U64 operand=midFreezePlace(arena: inout arena, place: place) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=resultTerm />)
        }
        MidRvalue.EnumPayloadBoxedCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            arena.rvalues.append(<MidRvalueNode tag=14U64 operand=midFreezePlace(arena: inout arena, place: place) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=resultTerm />)
        }
        MidRvalue.EnumPayloadBoxedBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            arena.rvalues.append(<MidRvalueNode tag=15U64 operand=midFreezePlace(arena: inout arena, place: place) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=resultTerm />)
        }
    }
    return arena.rvalues.count()
}

fn midFreezeCallTarget(arena: inout MidCanonicalArena, target: MidCallTarget) -> U64 {
    match target {
        MidCallTarget.Template(site: val site) => { arena.callTargets.append(<MidCallTargetNode tag=1U64 ownerFnIdx=site.ownerFnIdx originKind=site.originKind originStart=site.originStart originEnd=site.originEnd originSerial=site.originSerial slot=site.slot />) }
        MidCallTarget.Resolved(resolution: val resolution) => { arena.callTargets.append(<MidCallTargetNode tag=2U64 resolution=resolution />) }
    }
    return arena.callTargets.count()
}

fn midFreezeCallReceiver(arena: inout MidCanonicalArena, receiver: MidCallReceiver) -> U64 {
    match receiver {
        MidCallReceiver.None => { arena.callReceivers.append(<MidCallReceiverNode tag=1U64 />) }
        MidCallReceiver.Value(operand: val operand) => { arena.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=midFreezeOperand(arena: inout arena, operand: operand) />) }
    }
    return arena.callReceivers.count()
}

fn midFreezeStatement(arena: inout MidCanonicalArena, statement: MidStatement) {
    match statement {
        MidStatement.Assign(destination: val destination, value: val value) => { arena.statements.append(<MidStatementNode tag=1U64 destination=midFreezePlace(arena: inout arena, place: destination) value=midFreezeRvalue(arena: inout arena, value: value) />) }
        MidStatement.Overwrite(destination: val destination, source: val source) => { arena.statements.append(<MidStatementNode tag=2U64 destination=midFreezePlace(arena: inout arena, place: destination) source=midFreezePlace(arena: inout arena, place: source) />) }
        MidStatement.Drop(place: val place) => { arena.statements.append(<MidStatementNode tag=3U64 destination=midFreezePlace(arena: inout arena, place: place) />) }
        MidStatement.ConditionalDrop(place: val place, flag: val flag) => { arena.statements.append(<MidStatementNode tag=4U64 destination=midFreezePlace(arena: inout arena, place: place) flag=flag />) }
        MidStatement.SetDropFlag(local: val local, isSet: val isSet) => { arena.statements.append(<MidStatementNode tag=5U64 flag=local isSet=isSet />) }
        MidStatement.ScopeExit(scope: val scope) => { arena.statements.append(<MidStatementNode tag=6U64 scope=scope />) }
        MidStatement.Nop => { arena.statements.append(<MidStatementNode tag=7U64 />) }
    }
}

fn midFreezeTerminator(arena: inout MidCanonicalArena, terminator: MidTerminator) -> U64 {
    match terminator {
        MidTerminator.Open => { arena.terminators.append(<MidTerminatorNode tag=1U64 />) }
        MidTerminator.Goto(target: val target) => { arena.terminators.append(<MidTerminatorNode tag=2U64 target=target />) }
        MidTerminator.Switch(discriminant: val discriminant, values: val values, targets: val targets, otherwise: val otherwise) => {
            val start: U64 = arena.switchCases.count()
            mut val i: U64 = 0U64
            while i < values.count() {
                arena.switchCases.append(<MidSwitchCase value=values[i] target=targets[i] />)
                i = i + 1U64
            }
            arena.terminators.append(<MidTerminatorNode tag=3U64 discriminant=midFreezeOperand(arena: inout arena, operand: discriminant) cases=<MidRange start=start len=values.count() /> otherwise=otherwise />)
        }
        MidTerminator.Call(callee: val callee, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
            val start: U64 = arena.callArguments.count()
            mut val i: U64 = 0U64
            while i < args.count() {
                arena.callArguments.append(midFreezeOperand(arena: inout arena, operand: args[i]))
                i = i + 1U64
            }
            arena.terminators.append(<MidTerminatorNode tag=4U64 target=target args=<MidRange start=start len=args.count() /> destination=midFreezePlace(arena: inout arena, place: destination) callTarget=midFreezeCallTarget(arena: inout arena, target: callee) callReceiver=midFreezeCallReceiver(arena: inout arena, receiver: receiver) />)
        }
        MidTerminator.Return => { arena.terminators.append(<MidTerminatorNode tag=5U64 />) }
        MidTerminator.ReturnValue(value: val value) => { arena.terminators.append(<MidTerminatorNode tag=6U64 value=midFreezeOperand(arena: inout arena, operand: value) />) }
        MidTerminator.Panic(message: val message) => { arena.terminators.append(<MidTerminatorNode tag=7U64 value=midFreezeOperand(arena: inout arena, operand: message) />) }
        MidTerminator.Unreachable => { arena.terminators.append(<MidTerminatorNode tag=8U64 />) }
        MidTerminator.Abort => { arena.terminators.append(<MidTerminatorNode tag=9U64 />) }
        MidTerminator.Suspend(state: val state, resume: val resume) => { arena.terminators.append(<MidTerminatorNode tag=10U64 state=state resume=resume />) }
    }
    return arena.terminators.count()
}

fn storeMidCanonicalBody(arena: inout MidCanonicalArena, body: MidBody) -> MidCanonicalBody {
    val localStart: U64 = arena.locals.count()
    mut val i: U64 = 0U64
    while i < body.locals.count() {
        arena.locals.append(body.locals[i])
        i = i + 1U64
    }
    val scopeStart: U64 = arena.scopes.count()
    i = 0U64
    while i < body.scopes.count() {
        arena.scopes.append(body.scopes[i])
        i = i + 1U64
    }
    val blockStart: U64 = arena.blocks.count()
    i = 0U64
    while i < body.blocks.count() {
        val block: MidBlock = body.blocks[i]
        val statementStart: U64 = arena.statements.count()
        mut val statementI: U64 = 0U64
        while statementI < block.statements.count() {
            midFreezeStatement(arena: inout arena, statement: block.statements[statementI])
            statementI = statementI + 1U64
        }
        val terminator: U64 = midFreezeTerminator(arena: inout arena, terminator: block.terminator)
        arena.blocks.append(<MidBlockNode statements=<MidRange start=statementStart len=block.statements.count() /> terminator=terminator />)
        i = i + 1U64
    }
    arena.bodies.append(<MidBodyNode bodyInstance=body.bodyInstance sourceFunction=body.sourceFunction locals=<MidRange start=localStart len=body.locals.count() /> scopes=<MidRange start=scopeStart len=body.scopes.count() /> blocks=<MidRange start=blockStart len=body.blocks.count() /> entry=body.entry />)
    return <MidCanonicalBody body=arena.bodies.count() />
}

pub impl MidCanonicalArena {
    // Freezing belongs to the owner of the typed pools. The inout receiver
    // makes the only mutation point explicit and keeps the public API from
    // suggesting that a frozen body can be detached from its arena.
    inout fn store(body: MidBody) -> MidCanonicalBody {
        return storeMidCanonicalBody(arena: inout self, body: body)
    }
}

// This verifier deliberately reads only canonical rows. It is the first
// post-freeze consumer and protects every later pass from malformed IDs/ranges
// without reconstructing a MidBody draft. Semantic ownership verification
// remains a separate pass over the same representation.
fn midRangeFits(range: MidRange, count: U64) -> Bool {
    return range.start <= count && range.len <= count - range.start
}

fn midCanonicalOperandIsWellFormed(arena: MidCanonicalArena, operand: U64) -> Bool {
    if operand == 0U64 || operand > arena.operands.count() { return false }
    val node: MidOperandNode = arena.operands[operand - 1U64]
    if node.tag >= 1U64 && node.tag <= 4U64 {
        return node.place != 0U64 && node.place <= arena.places.count()
    }
    match node.tag {
        5U64 => { return true }
        6U64 => { return true }
        7U64 => { return true }
        8U64 => { return true }
        _ => { return false }
    }
}

fn midCanonicalPlaceIsWellFormed(arena: MidCanonicalArena, place: U64) -> Bool {
    if place == 0U64 || place > arena.places.count() { return false }
    val node: MidPlaceNode = arena.places[place - 1U64]
    if !midRangeFits(range: node.projections, count: arena.projections.count()) { return false }
    mut val i: U64 = 0U64
    while i < node.projections.len {
        val projection: MidProjectionNode = arena.projections[node.projections.start + i]
        if projection.tag != 1U64 && projection.tag != 2U64 { return false }
        i = i + 1U64
    }
    return true
}

fn midCanonicalRvalueIsWellFormed(arena: MidCanonicalArena, rvalue: U64) -> Bool {
    if rvalue == 0U64 || rvalue > arena.rvalues.count() { return false }
    val node: MidRvalueNode = arena.rvalues[rvalue - 1U64]
    if node.tag >= 1U64 && node.tag <= 10U64 && node.operand != 0U64 {
        if !midCanonicalOperandIsWellFormed(arena: arena, operand: node.operand) { return false }
    }
    if node.tag >= 11U64 && node.tag <= 15U64 {
        if !midCanonicalPlaceIsWellFormed(arena: arena, place: node.operand) { return false }
    }
    if node.tag >= 3U64 && node.tag <= 5U64 {
        if !midRangeFits(range: node.elements, count: arena.aggregateElements.count()) { return false }
        mut val i: U64 = 0U64
        while i < node.elements.len {
            if !midCanonicalOperandIsWellFormed(arena: arena, operand: arena.aggregateElements[node.elements.start + i].operand) { return false }
            i = i + 1U64
        }
    }
    return node.tag >= 1U64 && node.tag <= 15U64
}

export fn canonicalMidBodyIsWellFormed(arena: MidCanonicalArena, body: MidCanonicalBody) -> Bool {
    if body.body == 0U64 || body.body > arena.bodies.count() { return false }
    val node: MidBodyNode = arena.bodies[body.body - 1U64]
    if !midRangeFits(range: node.locals, count: arena.locals.count()) || !midRangeFits(range: node.scopes, count: arena.scopes.count()) || !midRangeFits(range: node.blocks, count: arena.blocks.count()) || node.entry >= node.blocks.len { return false }
    mut val blockI: U64 = 0U64
    while blockI < node.blocks.len {
        val block: MidBlockNode = arena.blocks[node.blocks.start + blockI]
        if !midRangeFits(range: block.statements, count: arena.statements.count()) || block.terminator == 0U64 || block.terminator > arena.terminators.count() { return false }
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = arena.statements[block.statements.start + statementI]
            if statement.destination != 0U64 && !midCanonicalPlaceIsWellFormed(arena: arena, place: statement.destination) { return false }
            if statement.source != 0U64 && !midCanonicalPlaceIsWellFormed(arena: arena, place: statement.source) { return false }
            if statement.value != 0U64 && !midCanonicalRvalueIsWellFormed(arena: arena, rvalue: statement.value) { return false }
            if statement.tag < 1U64 || statement.tag > 7U64 { return false }
            statementI = statementI + 1U64
        }
        val terminator: MidTerminatorNode = arena.terminators[block.terminator - 1U64]
        if terminator.discriminant != 0U64 && !midCanonicalOperandIsWellFormed(arena: arena, operand: terminator.discriminant) { return false }
        if terminator.value != 0U64 && !midCanonicalOperandIsWellFormed(arena: arena, operand: terminator.value) { return false }
        if !midRangeFits(range: terminator.cases, count: arena.switchCases.count()) || !midRangeFits(range: terminator.args, count: arena.callArguments.count()) { return false }
        mut val argI: U64 = 0U64
        while argI < terminator.args.len {
            if !midCanonicalOperandIsWellFormed(arena: arena, operand: arena.callArguments[terminator.args.start + argI]) { return false }
            argI = argI + 1U64
        }
        if terminator.callTarget != 0U64 && terminator.callTarget > arena.callTargets.count() { return false }
        if terminator.callReceiver != 0U64 && terminator.callReceiver > arena.callReceivers.count() { return false }
        if terminator.destination != 0U64 && !midCanonicalPlaceIsWellFormed(arena: arena, place: terminator.destination) { return false }
        if terminator.tag < 1U64 || terminator.tag > 10U64 { return false }
        blockI = blockI + 1U64
    }
    return true
}
