// @Mid/Ir — backend-independent plain CFG vocabulary for the ownership-aware
// Mid IR.  This is deliberately a separate arena from source AST `Ir`: AST
// nodes retain syntax/source identity, while Mid nodes record the already
// selected evaluation and ownership operations that LLVM must materialize.
//
// The representation is Rust-MIR-shaped rather than SSA: joins write into a
// `MidPlace`, and only terminators create CFG edges.  Ownership is expressed by
// Copy / Move / Drop operations on places; raw retain/release is not an IR
// escape hatch.

import ../Ir with { CallSiteKey }

// A projection is kept first-class even though Path 1 only moves root locals.
// Field/index paths are already needed for assignments and future borrow/access
// analysis; partial unique moves stay rejected by the frontend.
export enum MidProjection {
    Field(index: U64)
    Index
}

export struct MidPlace {
    // Index into MidBody.locals.  It is never an AST Local or a backend stack
    // slot: lowering maps source bindings to this stable IR identity once.
    pub val local: U64
    pub val projections: Array[MidProjection] = []
    // Canonical frontend TypeTerm. It may contain lexical ParamIds while this
    // body is parametric; instantiation substitutes it once into a concrete
    // TypeRef. A zero value is allowed only for compiler-generated unit/control
    // places.
    pub val typeTerm: U64 = 0U64
}
pub impl MidPlace { factory }

export enum MidBorrowCapability {
    Read
    Inout
}

// The forward ownership lattice for one root local. `MaybeOwned` is produced
// only by a CFG join whose incoming paths disagree. It is deliberately not a
// source-level state: drop elaboration turns it into a generated flag and a
// conditional Drop on the relevant edge.
export enum MidOwnership {
    Owned
    Consumed
    MaybeOwned
}

// Source-level owner accessibility is intentionally independent from ownership.
// After `if c { move f }`, the false path may still own the value, but the join
// cannot name `f` as a uniform owner; it is therefore Unavailable and must be
// dropped at that accessibility cliff if it remains owned.
export enum MidAccessibility {
    Available
    Unavailable
}

// A constant is semantic value data, not an AST anchor. Keeping a source ExprId
// here would invite LLVM lowering to reopen expression resolution after the
// frontend freeze. New forms extend this closed sum with selected layout and
// children; they never fall back to source recovery.
export enum MidConstant {
    Integer(value: U64, isNegative: Bool, isBool: Bool, typeTerm: U64)
}

// Every produced Mid value has explicit ownership provenance.
export enum MidOperand {
    Copy(place: MidPlace)
    Move(place: MidPlace)
    Borrow(place: MidPlace, capability: MidBorrowCapability)
    Constant(value: MidConstant)
}

export enum MidRvalue {
    Use(operand: MidOperand)
}

// A parametric body names a frontend CallTemplate by its semantic site identity.
// After explicit BodyInstance substitution, the same call is replaced by the
// immutable final CallResolution index. This sum prevents a builder from
// smuggling a raw name/arity lookup across the phase boundary.
export enum MidCallTarget {
    Template(site: CallSiteKey)
    Resolved(resolution: U64)
}

// Statements never create a CFG edge.  `SetDropFlag` is compiler-generated by
// drop elaboration only; source lowering never hand-writes branch-specific
// cleanup.  This keeps the conditional-move rule in one dataflow pass.
export enum MidStatement {
    Assign(destination: MidPlace, value: MidRvalue)
    Drop(place: MidPlace)
    // Elaborated conditional drop for a MaybeOwned root. `flag` is a generated
    // boolean local: initialization/Assign set it and Move clears it.
    ConditionalDrop(place: MidPlace, flag: U64)
    SetDropFlag(local: U64, isSet: Bool)
    // A lexical CFG boundary, analogous to Rust MIR StorageDead. Source
    // lowering emits it; drop elaboration consumes it into explicit Drop /
    // ConditionalDrop statements, so LLVM never receives this marker.
    ScopeExit(scope: U64)
    Nop
}

// Exactly the Path 1 terminator set. A call refers either to a parametric
// frontend CallTemplate site or, after instantiation, an immutable final
// CallResolution identity; neither is a name/arity lookup key. `Switch` keeps
// targets parallel to `values`; `otherwise` is always present. `ReturnValue`
// has already moved/copied the source into the ABI return place before scope
// drops are elaborated.
export enum MidTerminator {
    Goto(target: U64)
    Switch(discriminant: MidOperand, values: Array[I64], targets: Array[U64], otherwise: U64)
    Call(callee: MidCallTarget, args: Array[MidOperand], destination: MidPlace, target: U64)
    Return
    ReturnValue(value: MidOperand)
    Unreachable
    Abort
    Suspend(state: U64, resume: U64)
}

export struct MidBlock {
    pub val statements: Array[MidStatement] = []
    pub val terminator: MidTerminator = <MidTerminator.Unreachable />
}
pub impl MidBlock { factory }

// `sourceScope` is a lexical-scope side-table identity, not a block nesting
// shortcut.  Drop elaboration uses it to preserve source-order destruction
// while operating exclusively on flat CFG edges.
export struct MidLocalDecl {
    // Parametric TypeTerm; instantiateMidBody replaces it with a ground TypeRef
    // without re-resolving source spelling.
    pub val typeTerm: U64
    pub val sourceScope: U64
    pub val isUnique: Bool
    pub val isParameter: Bool
    // Whether this root has a live owned value at body entry. A by-value/borrow
    // parameter starts false; a move parameter starts true. An initialized local
    // becomes owned only at its explicit Assign statement.
    pub val ownsAtEntry: Bool = false
    // Compiler-generated boolean used only by drop elaboration. It is not a
    // source place and never participates in user ownership/accessibility.
    pub val isDropFlag: Bool = false
    // Compiler-generated ABI result storage. It is outside every source
    // lexical scope: a value is copied/moved here before cleanup, then
    // transferred by `ReturnValue` without any source-name recovery.
    pub val isReturnPlace: Bool = false
    pub val sourceNameStart: U64 = 0U64
}
pub impl MidLocalDecl { factory }

export struct MidScope {
    pub val parent: U64 = 0U64
    // Locals are declared in increasing `MidLocalDecl` order.  The range gives
    // drop elaboration the deterministic reverse-declaration order required by
    // spec/03 without retaining structured control flow in the IR itself.
    pub val firstLocal: U64 = 0U64
    pub val localCount: U64 = 0U64
}
pub impl MidScope { factory }

export struct MidBody {
    // Index into the immutable frontend BodyInstance table.  A body is
    // parametric while built and receives concrete TypeRefs only on
    // instantiation; this field is nonzero for an instantiated body.
    pub val bodyInstance: U64 = 0U64
    pub val sourceFunction: U64 = 0U64
    pub val locals: Array[MidLocalDecl] = []
    pub val scopes: Array[MidScope] = []
    pub val blocks: Array[MidBlock] = []
    pub val entry: U64 = 0U64
}
pub impl MidBody { factory }

export struct MidProgram {
    pub val bodies: Array[MidBody] = []
}
pub impl MidProgram { factory }
