// Parametric Mid bodies cross the frontend/backend freeze boundary only through
// an explicit BodyInstance.  This module deliberately consumes existing
// frontend facts: it substitutes TypeTerms with groundTermForBody and resolves
// call sites against the immutable final CallResolution table.  It neither
// re-types an AST expression nor searches callable candidates.

import ../Frontend with { Comp }
import ../Ir with { CallSiteKey, BodyInstance, Func, Param, TypeRef, CallResolution, CallTarget, CallReceiverPassing, CallArgumentPassing, FinalAggregateResolution, FinalMatchResolution, FinalMatchArmResolution, FinalMatchPayloadResolution, FinalReturnResolution, FinalStorageResolution, FinalTryResolution, FinalForResolution, MatchSource, ValueConversionProof, SemanticClosure, SemanticClosureCaptureMode }
import ../Diag with { eprintU64 }
import @Std/Io with { eprint }
import @Std/Core with { bitCastI64 }
import ./Ir with { MidRange, MidBodyNode, MidBlockNode, MidPlaceNode, MidProjectionNode, MidOperandNode, MidRvalueNode, MidAggregateElementNode, MidClosureCaptureNode, MidStatementNode, MidTerminatorNode, MidSwitchCase, MidCallTargetNode, MidCallReceiverNode, MidCanonicalBody, MidProjection, MidPlace, MidBorrowCapability, MidConstant, MidOperand, MidAggregateKind, MidAggregateElement, MidClosureCapture, MidRvalue, MidCastKind, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody, canonicalMidBorrowOperand, canonicalMidBorrowPlace, canonicalMidMoveOperand }

export enum MidInstantiateError {
    None
    InvalidBodyInstance
    MissingCallResolution
    CallResolutionIndex
    CallResolutionArity
    CallResolutionPassing
    CallConversionSource
    CallConversionTarget
    MissingReturnResolution
    InvalidReturnResolution
    InvalidCastResolution
    // Aggregate, return, and match descriptors are all final frontend facts.
    // At this boundary the relevant invariant is their presence and internal
    // agreement, not the source construct that happened to navigate to one.
    MissingFinalResolution
    InvalidFinalResolution
    InvalidLocalResultType
    MissingTryResolution
    InvalidTryResolution
    MissingSemanticClosure
    InvalidSemanticClosure
}

export struct MidInstantiation {
    pub val body: MidBody
    pub val error: MidInstantiateError = <MidInstantiateError.None />
}
pub impl MidInstantiation { factory }

// Canonical instantiation is append-only: it reads the parametric snapshot
// from `c.mid` and emits a second scalar-row snapshot there. It intentionally
// has no MidBody field, preventing callers from thawing back into the draft
// representation while this path is completed opcode by opcode.
export struct MidCanonicalInstantiation {
    pub val body: MidCanonicalBody = <MidCanonicalBody body=0U64 />
    pub val error: MidInstantiateError = <MidInstantiateError.None />
}
pub impl MidCanonicalInstantiation { factory }

export struct MidCanonicalCallMaterialization {
    pub val sourceStatementCount: U64 = 0U64
    pub val sourceTerminator: U64 = 0U64
    pub val cleanupStatements: MidRange = <MidRange start=0U64 len=0U64 />
    pub val cleanupTerminator: U64 = 0U64
    pub val hasCleanup: Bool = false
    pub val error: MidInstantiateError = <MidInstantiateError.None />
}
pub impl MidCanonicalCallMaterialization { factory }

fn midInstantiateHasError(error: MidInstantiateError) -> Bool {
    match error {
        MidInstantiateError.None => { return false }
        _ => { return true }
    }
}

// Deferred type sources never share the TypeTerm numeric domain. A missing
// recipe is an instantiation failure, not a Unit type or an ABI inference hint.
fn instantiateMidType(c: inout Comp, typeTerm: U64, typeRecipe: U64, bodyId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if typeRecipe != 0U64 {
        if typeTerm != 0U64 { return 0U64 }
        return c.groundSemanticTypeRecipeForBody(recipeId: typeRecipe, bodyId: bodyId, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    }
    return c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
}

fn instantiateCanonicalPlace(c: inout Comp, bodyId: U64, placeId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if placeId == 0U64 || placeId > c.mid.places.count() { return 0U64 }
    val source: MidPlaceNode = c.mid.places[placeId - 1U64]
    val projectionStart: U64 = c.mid.projections.count()
    mut val i: U64 = 0U64
    while i < source.projections.len {
        val projection: MidProjectionNode = c.mid.projections[source.projections.start + i]
        c.mid.projections.append(<MidProjectionNode isBoxed=projection.isBoxed tag=projection.tag index=projection.index indexLocal=projection.indexLocal typeTerm=c.groundTermForBody(ref: projection.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        i = i + 1U64
    }
    c.mid.places.append(<MidPlaceNode rootTag=source.rootTag local=source.local globalTarget=source.globalTarget globalMutable=source.globalMutable projections=<MidRange start=projectionStart len=source.projections.len /> typeTerm=instantiateMidType(c: inout c, typeTerm: source.typeTerm, typeRecipe: source.typeRecipe, bodyId: bodyId, environment: environment, itemRef: itemRef) />)
    return c.mid.places.count()
}

fn instantiateCanonicalOperand(c: inout Comp, bodyId: U64, operandId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
    val source: MidOperandNode = c.mid.operands[operandId - 1U64]
    mut val place: U64 = 0U64
    if source.place != 0U64 { place = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.place, environment: environment, itemRef: itemRef) }
    mut val accessPlace: U64 = 0U64
    if source.accessPlace != 0U64 { accessPlace = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.accessPlace, environment: environment, itemRef: itemRef) }
    c.mid.operands.append(<MidOperandNode tag=source.tag place=place accessPlace=accessPlace capability=source.capability integerValue=source.integerValue integerNegative=source.integerNegative integerBool=source.integerBool stringStart=source.stringStart stringLen=source.stringLen typeTerm=c.groundTermForBody(ref: source.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) accessCandidate=source.accessCandidate />)
    return c.mid.operands.count()
}

// Ground the canonical rvalue forms whose semantics are already closed in
// their row. Return/aggregate/cast and enum-match boundaries are deliberately
// handled below their own frontend-proof readers rather than being treated as
// this case.
fn instantiateCanonicalClosedRvalue(c: inout Comp, bodyId: U64, rvalueId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    match source.tag {
        1U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=1U64 operand=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef) />)
        }
        6U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=6U64 operand=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef) conversion=source.conversion />)
        }
        8U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=8U64 operand=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef) kindTag=source.kindTag targetTerm=c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        }
        9U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=9U64 operand=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef) kindTag=source.kindTag targetTerm=c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        }
        10U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef) targetTerm=c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        }
        _ => { return 0U64 }
    }
    return c.mid.rvalues.count()
}

fn canonicalMidOperandTypeRef(c: Comp, operandId: U64) -> U64 {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
    val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
    if operand.tag >= 1U64 && operand.tag <= 4U64 {
        if operand.place == 0U64 || operand.place > c.mid.places.count() { return 0U64 }
        return c.mid.places[operand.place - 1U64].typeTerm
    }
    if operand.tag >= 5U64 && operand.tag <= 7U64 { return operand.typeTerm }
    return 0U64
}

fn instantiateCanonicalStorageBoundary(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    val source: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    val index: U64 = c.finalStorageIndex(bodyId: bodyId, stmtId: source.sourceStmt)
    if index >= c.arena.finalStorages.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    val resolution: FinalStorageResolution = c.arena.finalStorages[index]
    val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef)
    val target: U64 = c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if operand == 0U64 || !c.typeRefEq(a: target, b: resolution.targetTypeRef) || !c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: resolution.sourceTypeRef) || c.conversionProofIsMissing(id: resolution.conversion) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    if c.conversionProofIsIdentity(id: resolution.conversion) {
        if !c.typeRefEq(a: resolution.sourceTypeRef, b: resolution.targetTypeRef) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=resolution.targetTypeRef />)
    } else {
        if !c.typeRefEq(a: resolution.sourceTypeRef, b: midConversionSourceRef(c: c, conversion: resolution.conversion)) || !c.typeRefEq(a: target, b: midConversionTargetRef(c: c, conversion: resolution.conversion)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
        c.mid.rvalues.append(<MidRvalueNode tag=6U64 operand=operand conversion=resolution.conversion />)
    }
    return c.mid.rvalues.count()
}

fn instantiateCanonicalReturnBoundary(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    if source.tag != 2U64 { return 0U64 }
    val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef)
    val resolutionIndex: U64 = c.finalReturnIndex(bodyId: bodyId, exprId: source.exprId)
    if resolutionIndex >= c.arena.finalReturns.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingReturnResolution /> }
        return 0U64
    }
    val resolution: FinalReturnResolution = c.arena.finalReturns[resolutionIndex]
    val expectedTarget: U64 = c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if !(c.typeRefEq(a: resolution.targetTypeRef, b: expectedTarget)) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
        return 0U64
    }
    val conversion: U64 = c.freezeValueConversionProof(proof: resolution.conversion)
    if c.conversionProofIsIdentity(id: conversion) {
        if !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: resolution.targetTypeRef)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
            return 0U64
        }
        c.mid.rvalues.append(<MidRvalueNode tag=2U64 operand=operand exprId=source.exprId targetTerm=resolution.targetTypeRef />)
        return c.mid.rvalues.count()
    }
    if c.conversionProofIsMissing(id: conversion) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
        return 0U64
    }
    if !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: midConversionSourceRef(c: c, conversion: conversion))) || !(c.typeRefEq(a: resolution.targetTypeRef, b: midConversionTargetRef(c: c, conversion: conversion))) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
        return 0U64
    }
    c.mid.rvalues.append(<MidRvalueNode tag=6U64 operand=operand conversion=conversion />)
    return c.mid.rvalues.count()
}

fn instantiateCanonicalAggregate(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    if source.tag < 3U64 || source.tag > 5U64 { return 0U64 }
    val resolutionIndex: U64 = c.finalAggregateIndex(bodyId: bodyId, exprId: source.exprId)
    if resolutionIndex >= c.arena.finalAggregates.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
        return 0U64
    }
    val resolution: FinalAggregateResolution = c.arena.finalAggregates[resolutionIndex]
    if source.elements.len != resolution.elementTargetRefs.count() || source.elements.len != resolution.elementConversions.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    val start: U64 = c.mid.aggregateElements.count()
    mut val i: U64 = 0U64
    while i < source.elements.len {
        val element = c.mid.aggregateElements[source.elements.start + i]
        val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: element.operand, environment: environment, itemRef: itemRef)
        val targetTerm: U64 = resolution.elementTargetRefs[i]
        val conversion: U64 = c.freezeValueConversionProof(proof: resolution.elementConversions[i])
        if operand == 0U64 || targetTerm == 0U64 || conversion == 0U64 {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
        if c.conversionProofIsIdentity(id: conversion) && !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: targetTerm)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
        c.mid.aggregateElements.append(<MidAggregateElementNode fieldIndex=element.fieldIndex operand=operand targetTerm=targetTerm isBoxed=element.isBoxed conversion=conversion />)
        i = i + 1U64
    }
    c.mid.rvalues.append(<MidRvalueNode tag=source.tag exprId=source.exprId enumIndex=source.enumIndex variantIndex=source.variantIndex resultTerm=resolution.resultTypeRef fieldCount=source.fieldCount elements=<MidRange start=start len=source.elements.len /> />)
    return c.mid.rvalues.count()
}

fn instantiateCanonicalCastBoundary(c: inout Comp, bodyId: U64, rvalueId: U64, environment: BodyInstance, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val sourceNode = c.mid.rvalues[rvalueId - 1U64]
    if sourceNode.tag != 7U64 { return 0U64 }
    val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: sourceNode.operand, environment: environment, itemRef: itemRef)
    val sourceRef: U64 = c.groundTermForBody(ref: sourceNode.sourceTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    val targetRef: U64 = c.groundTermForBody(ref: sourceNode.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if operand == 0U64 || sourceRef == 0U64 || targetRef == 0U64 || sourceRef >= c.arena.typeCount() || targetRef >= c.arena.typeCount() || !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: sourceRef)) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
        return 0U64
    }
    val source: TypeRef = c.arena.typeAt(index: sourceRef)
    val target: TypeRef = c.arena.typeAt(index: targetRef)
    val sourceUnderlying: U64 = c.newtypeUnderRef(start: source.nameStart, len: source.nameLen)
    val targetUnderlying: U64 = c.newtypeUnderRef(start: target.nameStart, len: target.nameLen)
    if sourceUnderlying != 0U64 && c.typeRefEq(a: sourceUnderlying, b: targetRef) {
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=targetRef />)
        return c.mid.rvalues.count()
    }
    if targetUnderlying != 0U64 && c.typeRefEq(a: sourceRef, b: targetUnderlying) {
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=targetRef />)
        return c.mid.rvalues.count()
    }
    if c.isIntType(start: source.nameStart, len: source.nameLen) {
        val signed: Bool = c.intSigned(start: source.nameStart, len: source.nameLen)
        if c.isIntType(start: target.nameStart, len: target.nameLen) {
            if c.losslessInt(srcStart: source.nameStart, srcLen: source.nameLen, dstStart: target.nameStart, dstLen: target.nameLen) {
                if signed { c.mid.rvalues.append(<MidRvalueNode tag=8U64 operand=operand kindTag=1U64 targetTerm=targetRef />) }
                else { c.mid.rvalues.append(<MidRvalueNode tag=8U64 operand=operand kindTag=2U64 targetTerm=targetRef />) }
                return c.mid.rvalues.count()
            }
        }
        if c.isFloatType(start: target.nameStart, len: target.nameLen) {
            if signed { c.mid.rvalues.append(<MidRvalueNode tag=9U64 operand=operand kindTag=1U64 targetTerm=targetRef />) }
            else { c.mid.rvalues.append(<MidRvalueNode tag=9U64 operand=operand kindTag=2U64 targetTerm=targetRef />) }
            return c.mid.rvalues.count()
        }
    }
    if c.isFloatType(start: source.nameStart, len: source.nameLen) && c.isFloatType(start: target.nameStart, len: target.nameLen) {
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=targetRef />)
        return c.mid.rvalues.count()
    }
    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
    return 0U64
}

fn canonicalMatchSource(sourceTag: U64, sourceId: U64) -> MatchSource {
    if sourceTag == 0U64 { return <MatchSource.Statement stmtId=sourceId /> }
    return <MatchSource.Expression exprId=sourceId />
}

// Final match layouts are scalar arena rows.  Keeping arm/payload ownership
// outside the match row lets Mid validate a projection without copying a
// nested descriptor merely to inspect one selected field.
fn midFinalMatchShapeMatches(c: inout Comp, matchIndex: U64, enumIndex: U64, scrutineeTypeRef: U64) -> Bool {
    if matchIndex >= c.arena.finalMatches.count() { return false }
    val resolution: FinalMatchResolution = c.arena.finalMatches[matchIndex]
    return resolution.enumIndex == enumIndex && c.typeRefEq(a: resolution.scrutineeTypeRef, b: scrutineeTypeRef)
}

fn midFinalMatchPayloadMatches(c: inout Comp, matchIndex: U64, variantIndex: U64, bindTarget: U64, fieldIndex: U64, fieldTypeRef: U64) -> Bool {
    if matchIndex >= c.arena.finalMatches.count() { return false }
    val resolution: FinalMatchResolution = c.arena.finalMatches[matchIndex]
    mut val armOffset: U64 = 0U64
    while armOffset < resolution.armCount {
        val arm: FinalMatchArmResolution = c.arena.finalMatchArms[resolution.armStart + armOffset]
        if arm.hasVariant && arm.variantIndex == variantIndex {
            mut val payloadOffset: U64 = 0U64
            while payloadOffset < arm.payloadCount {
                val payload: FinalMatchPayloadResolution = c.arena.finalMatchPayloads[arm.payloadStart + payloadOffset]
                if payload.bindTarget == bindTarget && payload.fieldIndex == fieldIndex && c.typeRefEq(a: payload.fieldTypeRef, b: fieldTypeRef) { return true }
                payloadOffset += 1U64
            }
        }
        armOffset += 1U64
    }
    return false
}

fn instantiateCanonicalEnumMatchRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    if source.tag < 11U64 || source.tag > 15U64 || source.place == 0U64 || source.place > c.mid.places.count() { return 0U64 }
    if source.sourceTag > 1U64 {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    val sourcePlace = c.mid.places[source.place - 1U64]
    val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, matchSource: canonicalMatchSource(sourceTag: source.sourceTag, sourceId: source.sourceStmt))
    if matchIndex >= c.arena.finalMatches.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
        return 0U64
    }
    val scrutineeType: U64 = c.groundTermForBody(ref: sourcePlace.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if !(midFinalMatchShapeMatches(c: c, matchIndex: matchIndex, enumIndex: source.enumIndex, scrutineeTypeRef: scrutineeType)) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    val resultTerm: U64 = c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if source.tag != 11U64 {
        if !(midFinalMatchPayloadMatches(c: c, matchIndex: matchIndex, variantIndex: source.variantIndex, bindTarget: source.bindTarget, fieldIndex: source.fieldIndex, fieldTypeRef: resultTerm)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
    }
    val place: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.place, environment: environment, itemRef: itemRef)
    c.mid.rvalues.append(<MidRvalueNode tag=source.tag place=place enumIndex=source.enumIndex variantIndex=source.variantIndex fieldIndex=source.fieldIndex bindTarget=source.bindTarget sourceTag=source.sourceTag sourceStmt=source.sourceStmt resultTerm=resultTerm />)
    return c.mid.rvalues.count()
}

// `try` has a deliberately smaller frozen layout contract than a general
// match: Result's two selected payloads and the enclosing Result return are
// all named by one FinalTryResolution. This helper only validates/transports
// that fact; it never reopens Result/Ok/Err source spelling.
fn instantiateCanonicalForRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    val source = c.mid.rvalues[rvalueId - 1U64]
    val index: U64 = c.finalForIndex(bodyId: bodyId, stmtId: source.sourceStmt)
    if index >= c.arena.finalFors.count() { error = <MidInstantiateError.MissingFinalResolution />
            return 0U64 }
    val fact: FinalForResolution = c.arena.finalFors[index]
    val place: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.place, environment: environment, itemRef: itemRef)
    if place == 0U64 || !c.typeRefEq(a: c.mid.places[place - 1U64].typeTerm, b: fact.nextTypeRef) { error = <MidInstantiateError.InvalidFinalResolution />
            return 0U64 }
    if source.tag == 21U64 {
        c.mid.rvalues.append(<MidRvalueNode tag=11U64 place=place enumIndex=fact.optionalEnumIndex resultTerm=c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
    } else {
        c.mid.rvalues.append(<MidRvalueNode tag=12U64 place=place enumIndex=fact.optionalEnumIndex variantIndex=fact.someVariantIndex fieldIndex=0U64 resultTerm=fact.itemTypeRef />)
    }
    return c.mid.rvalues.count()
}

fn instantiateCanonicalTryRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    val factIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: source.exprId)
    if factIndex >= c.arena.finalTries.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> }
        return 0U64
    }
    val fact: FinalTryResolution = c.arena.finalTries[factIndex]
    if source.tag == 16U64 || source.tag == 17U64 {
        if source.place == 0U64 || source.place > c.mid.places.count() || !(c.typeRefEq(a: c.groundTermForBody(ref: c.mid.places[source.place - 1U64].typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef), b: fact.operandResultTypeRef)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidTryResolution /> }
            return 0U64
        }
    }
    if source.tag == 16U64 {
        c.mid.rvalues.append(<MidRvalueNode tag=16U64 place=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.place, environment: environment, itemRef: itemRef) exprId=source.exprId enumIndex=fact.resultEnumIndex resultTerm=c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        return c.mid.rvalues.count()
    }
    if source.tag == 17U64 {
        mut val payloadRef: U64 = fact.okPayloadTypeRef
        mut val variant: U64 = fact.okVariantIndex
        if source.variantIndex == 1U64 {
            payloadRef = fact.sourceErrorTypeRef
            variant = fact.errVariantIndex
        } else if source.variantIndex != 0U64 {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidTryResolution /> }
            return 0U64
        }
        if !(c.typeRefEq(a: c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef), b: payloadRef)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidTryResolution /> }
            return 0U64
        }
        c.mid.rvalues.append(<MidRvalueNode tag=17U64 place=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.place, environment: environment, itemRef: itemRef) exprId=source.exprId enumIndex=fact.resultEnumIndex variantIndex=variant resultTerm=payloadRef />)
        return c.mid.rvalues.count()
    }
    if source.tag == 18U64 {
        val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef)
        if operand == 0U64 || !(c.typeRefEq(a: c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef), b: fact.returnResultTypeRef)) || !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: fact.targetErrorTypeRef)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidTryResolution /> }
            return 0U64
        }
        c.mid.rvalues.append(<MidRvalueNode tag=18U64 operand=operand exprId=source.exprId enumIndex=fact.resultEnumIndex variantIndex=fact.errVariantIndex resultTerm=fact.returnResultTypeRef targetTerm=fact.targetErrorTypeRef />)
        return c.mid.rvalues.count()
    }
    return 0U64
}

// A closure is grounded from its already-published lexical fact, never from
// the closure Expr or the backend's local stack.  The parametric row stores
// the exact capture operands selected by Build; this pass only grounds their
// terms and proves that the row still agrees with the immutable fact.
fn instantiateCanonicalMakeClosure(c: inout Comp, bodyId: U64, rvalueId: U64, environment: BodyInstance, sourceFunction: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    if source.tag != 19U64 {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidSemanticClosure /> }
        return 0U64
    }
    val closureIndex: U64 = c.semanticClosureIndex(ownerFnIdx: sourceFunction, exprId: source.exprId)
    if closureIndex >= c.decls.semanticClosures.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingSemanticClosure /> }
        return 0U64
    }
    val closure: SemanticClosure = c.decls.semanticClosures[closureIndex]
    val functionType: U64 = c.groundTermForBody(ref: closure.functionTypeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if closure.bodyKey != source.closureBodyKey || source.elements.len != closure.captures.count() || functionType == 0U64 || !(c.typeRefEq(a: functionType, b: c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidSemanticClosure /> }
        return 0U64
    }
    val captureStart: U64 = c.mid.closureCaptures.count()
    mut val captureI: U64 = 0U64
    while captureI < source.elements.len {
        if source.elements.start + captureI >= c.mid.closureCaptures.count() {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidSemanticClosure /> }
            return 0U64
        }
        val raw: MidClosureCaptureNode = c.mid.closureCaptures[source.elements.start + captureI]
        val expected = closure.captures[captureI]
        val expectedType: U64 = c.groundTermForBody(ref: expected.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
        mut val expectedMode: U64 = 0U64
        match expected.mode {
            SemanticClosureCaptureMode.ValueCopy => { expectedMode = 1U64 }
            SemanticClosureCaptureMode.CellBorrow => { expectedMode = 2U64 }
        }
        val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: raw.operand, environment: environment, itemRef: itemRef)
        if raw.bindingTarget != expected.bindingTarget || raw.mode != expectedMode || expectedType == 0U64 || operand == 0U64 || !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: expectedType)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidSemanticClosure /> }
            return 0U64
        }
        c.mid.closureCaptures.append(<MidClosureCaptureNode bindingTarget=raw.bindingTarget typeTerm=expectedType mode=raw.mode operand=operand />)
        captureI += 1U64
    }
    c.mid.rvalues.append(<MidRvalueNode tag=19U64 exprId=source.exprId closureBodyKey=source.closureBodyKey resultTerm=functionType elements=<MidRange start=captureStart len=source.elements.len /> />)
    return c.mid.rvalues.count()
}

fn instantiateCanonicalRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, sourceFunction: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val tag: U64 = c.mid.rvalues[rvalueId - 1U64].tag
    match tag {
        1U64 => { return instantiateCanonicalClosedRvalue(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        20U64 => { return instantiateCanonicalStorageBoundary(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        2U64 => { return instantiateCanonicalReturnBoundary(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        3U64 => { return instantiateCanonicalAggregate(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        4U64 => { return instantiateCanonicalAggregate(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        5U64 => { return instantiateCanonicalAggregate(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        6U64 => { return instantiateCanonicalClosedRvalue(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        7U64 => { return instantiateCanonicalCastBoundary(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, itemRef: itemRef, error: inout error) }
        8U64 => { return instantiateCanonicalClosedRvalue(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        9U64 => { return instantiateCanonicalClosedRvalue(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        10U64 => { return instantiateCanonicalClosedRvalue(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        11U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        12U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        13U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        14U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        15U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        16U64 => { return instantiateCanonicalTryRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        17U64 => { return instantiateCanonicalTryRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        18U64 => { return instantiateCanonicalTryRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        21U64 => { return instantiateCanonicalForRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        22U64 => { return instantiateCanonicalForRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        19U64 => { return instantiateCanonicalMakeClosure(c: inout c, bodyId: bodyId, rvalueId: rvalueId, environment: environment, sourceFunction: sourceFunction, itemRef: itemRef, error: inout error) }
        _ => { return 0U64 }
    }
}

fn instantiateCanonicalStatement(c: inout Comp, statementId: U64, locals: MidRange, environment: BodyInstance, bodyId: U64, sourceFunction: U64, itemRef: U64, error: inout MidInstantiateError) -> Bool {
    if statementId == 0U64 || statementId > c.mid.statements.count() { return false }
    val source = c.mid.statements[statementId - 1U64]
    match source.tag {
        1U64 => {
            val destination: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef)
            val value: U64 = instantiateCanonicalRvalue(c: inout c, rvalueId: source.value, environment: environment, bodyId: bodyId, sourceFunction: sourceFunction, itemRef: itemRef, error: inout error)
            if destination == 0U64 || value == 0U64 { return false }
            c.mid.statements.append(<MidStatementNode tag=1U64 destination=destination value=value />)
        }
        9U64 => {
            val destination: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef)
            val value: U64 = instantiateCanonicalRvalue(c: inout c, rvalueId: source.value, environment: environment, bodyId: bodyId, sourceFunction: sourceFunction, itemRef: itemRef, error: inout error)
            if destination == 0U64 || value == 0U64 { return false }
            c.mid.statements.append(<MidStatementNode tag=9U64 destination=destination value=value />)
        }
        2U64 => { c.mid.statements.append(<MidStatementNode tag=2U64 destination=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef) source=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.source, environment: environment, itemRef: itemRef) />) }
        8U64 => { c.mid.statements.append(<MidStatementNode tag=8U64 destination=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef) source=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.source, environment: environment, itemRef: itemRef) />) }
        3U64 => { c.mid.statements.append(<MidStatementNode tag=3U64 destination=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef) />) }
        10U64 => { c.mid.statements.append(<MidStatementNode tag=10U64 destination=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef) />) }
        4U64 => { c.mid.statements.append(<MidStatementNode tag=4U64 destination=instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: source.destination, environment: environment, itemRef: itemRef) flag=source.flag />) }
        5U64 => { c.mid.statements.append(<MidStatementNode tag=5U64 flag=source.flag isSet=source.isSet />) }
        6U64 => { c.mid.statements.append(<MidStatementNode tag=6U64 scope=source.scope />) }
        11U64 => {
            val factIndex: U64 = c.finalStorageIndex(bodyId: bodyId, stmtId: source.sourceStmt)
            if factIndex >= c.arena.finalStorages.count() {
                error = <MidInstantiateError.InvalidFinalResolution />
                return false
            }
            val target: U64 = c.arena.finalStorages[factIndex].shadowedBindingTarget
            if target != 0U64 {
                mut val local: U64 = 0U64
                while local < locals.len && c.mid.locals[locals.start + local].sourceNameStart != target { local += 1U64 }
                if local == locals.len {
                    error = <MidInstantiateError.InvalidFinalResolution />
                    return false
                }
                c.mid.statements.append(<MidStatementNode tag=12U64 bindingLocal=local />)
            }
        }
        12U64 => { c.mid.statements.append(<MidStatementNode tag=12U64 bindingLocal=source.bindingLocal />) }
        7U64 => { c.mid.statements.append(<MidStatementNode tag=7U64 />) }
        _ => { return false }
    }
    return true
}

// Call is intentionally excluded until its selected passing/conversion proof
// is emitted with its continuation cleanup. Every other terminator has a
// closed scalar payload and can be grounded without a draft reconstruction.
fn instantiateCanonicalNonCallTerminator(c: inout Comp, bodyId: U64, terminatorId: U64, environment: BodyInstance, itemRef: U64) -> Bool {
    if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return false }
    val source = c.mid.terminators[terminatorId - 1U64]
    match source.tag {
        1U64 => { c.mid.terminators.append(<MidTerminatorNode tag=1U64 />) }
        2U64 => { c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=source.target />) }
        3U64 => {
            val caseStart: U64 = c.mid.switchCases.count()
            mut val i: U64 = 0U64
            while i < source.cases.len {
                c.mid.switchCases.append(c.mid.switchCases[source.cases.start + i])
                i = i + 1U64
            }
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.discriminant, environment: environment, itemRef: itemRef) cases=<MidRange start=caseStart len=source.cases.len /> otherwise=source.otherwise />)
        }
        5U64 => { c.mid.terminators.append(<MidTerminatorNode tag=5U64 />) }
        6U64 => { c.mid.terminators.append(<MidTerminatorNode tag=6U64 value=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.value, environment: environment, itemRef: itemRef) />) }
        7U64 => { c.mid.terminators.append(<MidTerminatorNode tag=7U64 value=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.value, environment: environment, itemRef: itemRef) />) }
        8U64 => { c.mid.terminators.append(<MidTerminatorNode tag=8U64 />) }
        9U64 => { c.mid.terminators.append(<MidTerminatorNode tag=9U64 />) }
        10U64 => { c.mid.terminators.append(<MidTerminatorNode tag=10U64 state=source.state resume=source.resume />) }
        _ => { return false }
    }
    return true
}

fn instantiateCanonicalCallTarget(c: inout Comp, targetId: U64, bodyId: U64, error: inout MidInstantiateError) -> U64 {
    if targetId == 0U64 || targetId > c.mid.callTargets.count() { return 0U64 }
    val source: MidCallTargetNode = c.mid.callTargets[targetId - 1U64]
    match source.tag {
        4U64 => {
            val resolution: U64 = canonicalForCallResolution(c: c, bodyId: bodyId, stmtId: source.exprId, slot: source.slot)
            if resolution == 0U64 { error = <MidInstantiateError.MissingFinalResolution />
            return 0U64 }
            c.mid.callTargets.append(<MidCallTargetNode tag=2U64 resolution=resolution - 1U64 />)
        }
        2U64 => { c.mid.callTargets.append(<MidCallTargetNode tag=2U64 resolution=source.resolution />) }
        1U64 => {
            val site: CallSiteKey = <CallSiteKey ownerFnIdx=source.ownerFnIdx originKind=source.originKind originStart=source.originStart originEnd=source.originEnd originSerial=source.originSerial slot=source.slot />
            val resolution: U64 = c.finalCalleeIndexForKey(bodyId: bodyId, siteKey: site)
            if resolution >= c.finalCalleeCount() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingCallResolution /> }
                return 0U64
            }
            c.mid.callTargets.append(<MidCallTargetNode tag=2U64 resolution=resolution />)
        }
        3U64 => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: source.exprId)
            if tryIndex >= c.arena.finalTries.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> }
                return 0U64
            }
            val fact: FinalTryResolution = c.arena.finalTries[tryIndex]
            if !fact.hasErrorConversion || fact.errorConversionResolution >= c.arena.finalCallees.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidTryResolution /> }
                return 0U64
            }
            c.mid.callTargets.append(<MidCallTargetNode tag=2U64 resolution=fact.errorConversionResolution />)
        }
        _ => { return 0U64 }
    }
    return c.mid.callTargets.count()
}

fn instantiateCanonicalCallReceiver(c: inout Comp, bodyId: U64, receiverId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if receiverId == 0U64 || receiverId > c.mid.callReceivers.count() { return 0U64 }
    val source: MidCallReceiverNode = c.mid.callReceivers[receiverId - 1U64]
    match source.tag {
        1U64 => { c.mid.callReceivers.append(<MidCallReceiverNode tag=1U64 />) }
        2U64 => { c.mid.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: source.operand, environment: environment, itemRef: itemRef) />) }
        _ => { return 0U64 }
    }
    return c.mid.callReceivers.count()
}

fn canonicalMidRvalueResultType(c: Comp, rvalueId: U64) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    match value.tag {
        1U64 => { return canonicalMidOperandTypeRef(c: c, operandId: value.operand) }
        2U64 => { return value.targetTerm }
        3U64 => { return value.resultTerm }
        4U64 => { return value.resultTerm }
        5U64 => { return value.resultTerm }
        6U64 => {
            if c.conversionProofIsIdentity(id: value.conversion) { return 0U64 }
            return midConversionTargetRef(c: c, conversion: value.conversion)
        }
        7U64 => { return value.targetTerm }
        8U64 => { return value.targetTerm }
        9U64 => { return value.targetTerm }
        10U64 => { return value.targetTerm }
        11U64 => { return value.resultTerm }
        12U64 => { return value.resultTerm }
        13U64 => { return value.resultTerm }
        14U64 => { return value.resultTerm }
        15U64 => { return value.resultTerm }
        16U64 => { return value.resultTerm }
        17U64 => { return value.resultTerm }
        18U64 => { return value.resultTerm }
        19U64 => { return value.resultTerm }
        _ => { return 0U64 }
    }
}

// Local declarations are rows too: append their final ground type only after
// the body rewrite has seen resolution boundaries. This preserves append-only
// canonical storage instead of mutating an already-published local row.
fn appendCanonicalInstantiatedLocals(c: inout Comp, bodyId: U64, error: inout MidInstantiateError, source: MidBodyNode, blockStart: U64, blockLen: U64, environment: BodyInstance, itemRef: U64) -> MidRange {
    val localStart: U64 = c.mid.locals.count()
    mut val localCount: U64 = source.locals.len
    mut val blockI: U64 = 0U64
    while blockI < blockLen {
        val block: MidBlockNode = c.mid.blocks[blockStart + blockI]
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
            if (statement.tag == 1U64 || statement.tag == 9U64) && statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local + 1U64 > localCount { localCount = destination.local + 1U64 }
            }
            statementI = statementI + 1U64
        }
        blockI = blockI + 1U64
    }
    mut val localI: U64 = 0U64
    while localI < localCount {
        mut val sourceLocal: MidLocalDecl = <MidLocalDecl typeTerm=0U64 sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false isDropFlag=false isReturnPlace=false sourceNameStart=0U64 />
        mut val typeTerm: U64 = 0U64
        if localI < source.locals.len {
            sourceLocal = c.mid.locals[source.locals.start + localI]
            typeTerm = instantiateMidType(c: inout c, typeTerm: sourceLocal.typeTerm, typeRecipe: sourceLocal.typeRecipe, bodyId: bodyId, environment: environment, itemRef: itemRef)
            if sourceLocal.typeRecipe != 0U64 && typeTerm == 0U64 {
                error = <MidInstantiateError.InvalidLocalResultType />
                return <MidRange start=localStart len=0U64 />
            }
        }
        if sourceLocal.typeRecipe == 0U64 && !sourceLocal.isParameter && sourceLocal.sourceNameStart == 0U64 {
            blockI = 0U64
            while blockI < blockLen {
                val block: MidBlockNode = c.mid.blocks[blockStart + blockI]
                mut val statementI: U64 = 0U64
                while statementI < block.statements.len {
                    val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                    if (statement.tag == 1U64 || statement.tag == 9U64) && statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                        val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                        if destination.local == localI && destination.projections.len == 0U64 {
                            val resultType: U64 = canonicalMidRvalueResultType(c: c, rvalueId: statement.value)
                            if resultType != 0U64 { typeTerm = resultType }
                        }
                    }
                    statementI = statementI + 1U64
                }
                blockI = blockI + 1U64
            }
        }
        c.mid.locals.append(<MidLocalDecl typeTerm=typeTerm sourceScope=sourceLocal.sourceScope isUnique=sourceLocal.isUnique isParameter=sourceLocal.isParameter isBorrowed=sourceLocal.isBorrowed isInout=sourceLocal.isInout isCaptureCell=sourceLocal.isCaptureCell ownsAtEntry=sourceLocal.ownsAtEntry isDropFlag=sourceLocal.isDropFlag isReturnPlace=sourceLocal.isReturnPlace sourceNameStart=sourceLocal.sourceNameStart />)
        localI = localI + 1U64
    }
    return <MidRange start=localStart len=localCount />
}

fn canonicalForCallResolution(c: Comp, bodyId: U64, stmtId: U64, slot: U64) -> U64 {
    val index: U64 = c.finalForIndex(bodyId: bodyId, stmtId: stmtId)
    if index >= c.arena.finalFors.count() { return 0U64 }
    val fact: FinalForResolution = c.arena.finalFors[index]
    if slot == 1U64 && fact.iteratorResolution < c.finalCalleeCount() { return fact.iteratorResolution + 1U64 }
    if slot == 2U64 && fact.nextResolution < c.finalCalleeCount() { return fact.nextResolution + 1U64 }
    return 0U64
}

fn canonicalCallResolution(c: Comp, terminator: MidTerminatorNode, bodyId: U64) -> U64 {
    if terminator.callTarget == 0U64 || terminator.callTarget > c.mid.callTargets.count() { return 0U64 }
    val target: MidCallTargetNode = c.mid.callTargets[terminator.callTarget - 1U64]
    match target.tag {
        4U64 => { return canonicalForCallResolution(c: c, bodyId: bodyId, stmtId: target.exprId, slot: target.slot) }
        2U64 => {
            if target.resolution >= c.arena.finalCallees.count() { return 0U64 }
            return target.resolution + 1U64
        }
        1U64 => {
            val site: CallSiteKey = <CallSiteKey ownerFnIdx=target.ownerFnIdx originKind=target.originKind originStart=target.originStart originEnd=target.originEnd originSerial=target.originSerial slot=target.slot />
            val resolution: U64 = c.finalCalleeIndexForKey(bodyId: bodyId, siteKey: site)
            if resolution >= c.finalCalleeCount() { return 0U64 }
            return resolution + 1U64
        }
        3U64 => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: target.exprId)
            if tryIndex >= c.arena.finalTries.count() { return 0U64 }
            val fact: FinalTryResolution = c.arena.finalTries[tryIndex]
            if !fact.hasErrorConversion || fact.errorConversionResolution >= c.arena.finalCallees.count() { return 0U64 }
            return fact.errorConversionResolution + 1U64
        }
        _ => { return 0U64 }
    }
}

// Plan the output block layout once per instantiated body. A converted
// call contributes one cleanup block; every CFG edge shares this prefix map.
fn canonicalBlockTargets(c: Comp, source: MidBodyNode, bodyId: U64) -> Array[U64] {
    mut val count: U64 = 0U64
    mut val targets: Array[U64] = []
    mut val blockI: U64 = 0U64
    while blockI < source.blocks.len {
        targets.append(blockI + count)
        val block: MidBlockNode = c.mid.blocks[source.blocks.start + blockI]
        if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
            val terminator: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
            if terminator.tag == 4U64 {
                val resolution: U64 = canonicalCallResolution(c: c, terminator: terminator, bodyId: bodyId)
                if resolution != 0U64 {
                    val selected: CallResolution = c.arena.finalCallees[resolution - 1U64]
                    mut val argumentI: U64 = 0U64
                    while argumentI < selected.argumentConversions.len {
                        if !c.conversionProofIsIdentity(id: c.finalCalleeConversionAt(conversions: selected.argumentConversions, index: argumentI)) {
                            count = count + 1U64
                            argumentI = selected.argumentConversions.len
                        } else {
                            argumentI = argumentI + 1U64
                        }
                    }
                }
            }
        }
        blockI = blockI + 1U64
    }
    targets.append(source.blocks.len + count)
    return targets
}

fn canonicalRemapTarget(targets: Array[U64], target: U64) -> U64 {
    if target < targets.count() { return targets[target] }
    // Preserve an invalid source edge as invalid for the structural verifier.
    val sourceCount = targets.count() - 1U64
    return target + (targets[sourceCount] - sourceCount)
}

fn canonicalBorrowOperand(c: inout Comp, operand: U64, locals: MidRange) -> U64 {
    if operand == 0U64 || operand > c.mid.operands.count() { return 0U64 }
    val value = c.mid.operands[operand - 1U64]
    if value.tag == 2U64 {
        // A computed unique value is published as Move for an owning use.
        // A selected guaranteed use instead borrows its existing temporary
        // home. Keep that home's full-expression scope and eventual Drop;
        // neither consume it nor add a call-edge cleanup. This is not a
        // rewrite of an authored move from a binding or a projected place.
        if value.place == 0U64 || value.place > c.mid.places.count() { return 0U64 }
        val place = c.mid.places[value.place - 1U64]
        if place.rootTag != 1U64 || place.projections.len != 0U64 || place.local >= locals.len { return 0U64 }
        val local = c.mid.locals[locals.start + place.local]
        if !local.isUnique || local.sourceNameStart != 0U64 || local.isParameter || local.isBorrowed || local.isInout || local.isCaptureCell || local.ownsAtEntry || local.isReturnPlace { return 0U64 }
        return canonicalMidBorrowPlace(arena: inout c.mid, place: value.place, capability: 1U64)
    }
    return canonicalMidBorrowOperand(arena: inout c.mid, operandId: operand, capability: 1U64)
}

fn canonicalReceiverWithPassing(c: inout Comp, receiver: U64, passing: CallReceiverPassing, locals: MidRange) -> U64 {
    if receiver == 0U64 || receiver > c.mid.callReceivers.count() { return 0U64 }
    val source: MidCallReceiverNode = c.mid.callReceivers[receiver - 1U64]
    match passing {
        CallReceiverPassing.None => {
            if source.tag != 1U64 { return 0U64 }
            return receiver
        }
        CallReceiverPassing.Borrow => {
            if source.tag != 2U64 { return 0U64 }
            val operand = canonicalBorrowOperand(c: inout c, operand: source.operand, locals: locals)
            if operand == 0U64 { return 0U64 }
            c.mid.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=operand />)
            return c.mid.callReceivers.count()
        }
        CallReceiverPassing.Inout => {
            if source.tag != 2U64 { return 0U64 }
            // An access marker is intentionally not a place yet.  Access
            // elaboration consumes its frozen provenance and produces the
            // concrete Inout borrow; normalizing it here would erase the
            // marker before that CFG rewrite has a chance to run.
            if source.operand != 0U64 && source.operand <= c.mid.operands.count() && c.mid.operands[source.operand - 1U64].tag == 8U64 { return receiver }
            val operand: U64 = canonicalMidBorrowOperand(arena: inout c.mid, operandId: source.operand, capability: 2U64)
            if operand == 0U64 { return 0U64 }
            c.mid.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=operand />)
            return c.mid.callReceivers.count()
        }
        CallReceiverPassing.Move => {
            if source.tag != 2U64 { return 0U64 }
            val operand: U64 = canonicalMidMoveOperand(arena: inout c.mid, operandId: source.operand)
            if operand == 0U64 { return 0U64 }
            c.mid.callReceivers.append(<MidCallReceiverNode tag=2U64 operand=operand />)
            return c.mid.callReceivers.count()
        }
    }
}

fn instantiateCanonicalNonCallTerminatorRemapped(c: inout Comp, terminatorId: U64, environment: BodyInstance, itemRef: U64, targets: Array[U64], bodyId: U64, error: inout MidInstantiateError) -> Bool {
    if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return false }
    val term: MidTerminatorNode = c.mid.terminators[terminatorId - 1U64]
    match term.tag {
        1U64 => { c.mid.terminators.append(<MidTerminatorNode tag=1U64 />) }
        2U64 => { c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=canonicalRemapTarget(targets: targets, target: term.target) />) }
        3U64 => {
            val caseStart: U64 = c.mid.switchCases.count()
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                val item: MidSwitchCase = c.mid.switchCases[term.cases.start + caseI]
                c.mid.switchCases.append(<MidSwitchCase value=item.value target=canonicalRemapTarget(targets: targets, target: item.target) />)
                caseI = caseI + 1U64
            }
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: term.discriminant, environment: environment, itemRef: itemRef) cases=<MidRange start=caseStart len=term.cases.len /> otherwise=canonicalRemapTarget(targets: targets, target: term.otherwise) />)
        }
        12U64 => {
            val forIndex: U64 = c.finalForIndex(bodyId: bodyId, stmtId: term.exprId)
            if forIndex >= c.arena.finalFors.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
                return false
            }
            val fact: FinalForResolution = c.arena.finalFors[forIndex]
            val discriminant: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: term.discriminant, environment: environment, itemRef: itemRef)
            if discriminant == 0U64 {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                return false
            }
            val caseStart: U64 = c.mid.switchCases.count()
            c.mid.switchCases.append(<MidSwitchCase value=bitCastI64(n: fact.someVariantIndex) target=canonicalRemapTarget(targets: targets, target: term.target) />)
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=discriminant cases=<MidRange start=caseStart len=1U64 /> otherwise=canonicalRemapTarget(targets: targets, target: term.otherwise) />)
        }
        11U64 => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: term.exprId)
            if tryIndex >= c.arena.finalTries.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> }
                return false
            }
            val fact: FinalTryResolution = c.arena.finalTries[tryIndex]
            val discriminant: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: term.discriminant, environment: environment, itemRef: itemRef)
            if discriminant == 0U64 {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidTryResolution /> }
                return false
            }
            val caseStart: U64 = c.mid.switchCases.count()
            c.mid.switchCases.append(<MidSwitchCase value=bitCastI64(n: fact.okVariantIndex) target=canonicalRemapTarget(targets: targets, target: term.target) />)
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=discriminant cases=<MidRange start=caseStart len=1U64 /> otherwise=canonicalRemapTarget(targets: targets, target: term.otherwise) />)
        }
        5U64 => { c.mid.terminators.append(<MidTerminatorNode tag=5U64 />) }
        6U64 => { c.mid.terminators.append(<MidTerminatorNode tag=6U64 value=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: term.value, environment: environment, itemRef: itemRef) />) }
        7U64 => { c.mid.terminators.append(<MidTerminatorNode tag=7U64 value=instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: term.value, environment: environment, itemRef: itemRef) />) }
        8U64 => { c.mid.terminators.append(<MidTerminatorNode tag=8U64 />) }
        9U64 => { c.mid.terminators.append(<MidTerminatorNode tag=9U64 />) }
        10U64 => { c.mid.terminators.append(<MidTerminatorNode tag=10U64 state=term.state resume=canonicalRemapTarget(targets: targets, target: term.resume) />) }
        _ => { return false }
    }
    return true
}

// Materialize one selected call independently of the caller's CFG rewrite.
// Both destinations are body-relative blocks supplied by the caller; this
// operation owns ABI validation, argument conversion and conversion cleanup.
// It appends statements/terminators, but leaves block and local registration
// to the surrounding rewrite, using nextLocal for conversion temporaries.
export fn materializeCanonicalMidCall(c: inout Comp, term: MidTerminatorNode, locals: MidRange, bodyId: U64, environment: BodyInstance, itemRef: U64, continuation: U64, cleanupTarget: U64, nextLocal: inout U64) -> MidCanonicalCallMaterialization {
    // Same-error `try` propagation has no callable at all. It is still
    // represented by the same parametric TryConversion site so the builder
    // does not inspect a BodyInstance; freeze it here into an ordinary copy
    // assignment and continuation rather than inventing a fake intrinsic.
    if term.callTarget != 0U64 && term.callTarget <= c.mid.callTargets.count() {
        val rawTarget: MidCallTargetNode = c.mid.callTargets[term.callTarget - 1U64]
        if rawTarget.tag == 4U64 && rawTarget.slot == 1U64 {
            val index: U64 = c.finalForIndex(bodyId: bodyId, stmtId: rawTarget.exprId)
            if index >= c.arena.finalFors.count() { return <MidCanonicalCallMaterialization error=<MidInstantiateError.MissingFinalResolution /> /> }
            val fact: FinalForResolution = c.arena.finalFors[index]
            if fact.identityIterator {
                if term.args.len != 0U64 || term.callReceiver == 0U64 || term.callReceiver > c.mid.callReceivers.count() { return <MidCanonicalCallMaterialization error=<MidInstantiateError.InvalidFinalResolution /> /> }
                val receiver = c.mid.callReceivers[term.callReceiver - 1U64]
                if receiver.tag != 2U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.InvalidFinalResolution /> /> }
                val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: receiver.operand, environment: environment, itemRef: itemRef)
                val destination: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: term.destination, environment: environment, itemRef: itemRef)
                if operand == 0U64 || destination == 0U64 || !c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: fact.iteratorTypeRef) || !c.typeRefEq(a: c.mid.places[destination - 1U64].typeTerm, b: fact.iteratorTypeRef) { return <MidCanonicalCallMaterialization error=<MidInstantiateError.InvalidFinalResolution /> /> }
                c.mid.rvalues.append(<MidRvalueNode tag=1U64 operand=operand />)
                c.mid.statements.append(<MidStatementNode tag=1U64 destination=destination value=c.mid.rvalues.count() />)
                c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=continuation />)
                return <MidCanonicalCallMaterialization sourceStatementCount=1U64 sourceTerminator=c.mid.terminators.count() />
            }
        }
        if rawTarget.tag == 3U64 {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: rawTarget.exprId)
            if tryIndex >= c.arena.finalTries.count() { return <MidCanonicalCallMaterialization error=<MidInstantiateError.MissingTryResolution /> /> }
            val fact: FinalTryResolution = c.arena.finalTries[tryIndex]
            if !fact.hasErrorConversion {
                if term.args.len != 1U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.InvalidTryResolution /> /> }
                val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: c.mid.callArguments[term.args.start], environment: environment, itemRef: itemRef)
                val destination: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: term.destination, environment: environment, itemRef: itemRef)
                if operand == 0U64 || destination == 0U64 || !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: fact.targetErrorTypeRef)) { return <MidCanonicalCallMaterialization error=<MidInstantiateError.InvalidTryResolution /> /> }
                c.mid.rvalues.append(<MidRvalueNode tag=1U64 operand=operand />)
                c.mid.statements.append(<MidStatementNode tag=1U64 destination=destination value=c.mid.rvalues.count() />)
                c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=continuation />)
                return <MidCanonicalCallMaterialization sourceStatementCount=1U64 sourceTerminator=c.mid.terminators.count() />
            }
        }
    }
    val resolutionId: U64 = canonicalCallResolution(c: c, terminator: term, bodyId: bodyId)
    if resolutionId == 0U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.MissingCallResolution /> /> }
    val resolution: U64 = resolutionId - 1U64
    val selected: CallResolution = c.arena.finalCallees[resolution]
    if selected.argumentConversions.len != term.args.len || selected.parameterTypeRefs.len != term.args.len || selected.argumentPassings.len != term.args.len {
        return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionArity /> />
    }
    val signature: MidSelectedSignature = midSelectedSignature(c: inout c, selected: selected)
    if !midSignatureMatches(signature: signature, count: term.args.len, passing: selected.receiverPassing) {
        if c.traceCodegen {
            eprint(text: "[trace-codegen] Mid instantiate-passing-reject stage=callee resolution=")
            eprintU64(n: resolution)
            eprint(text: " callee=")
            eprintU64(n: selected.callee)
            eprint(text: " args=")
            eprintU64(n: term.args.len)
            eprint(text: " params=")
            eprintU64(n: selected.parameterTypeRefs.len)
            eprint(text: "\n")
        }
        return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> />
    }
    mut val targetError: MidInstantiateError = <MidInstantiateError.None />
    val callTarget: U64 = instantiateCanonicalCallTarget(c: inout c, targetId: term.callTarget, bodyId: bodyId, error: inout targetError)
    if callTarget == 0U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.MissingCallResolution /> /> }
    val rawReceiver: U64 = instantiateCanonicalCallReceiver(c: inout c, bodyId: bodyId, receiverId: term.callReceiver, environment: environment, itemRef: itemRef)
    val receiver: U64 = canonicalReceiverWithPassing(c: inout c, receiver: rawReceiver, passing: selected.receiverPassing, locals: locals)
    if receiver == 0U64 {
        if c.traceCodegen {
            eprint(text: "[trace-codegen] Mid instantiate-passing-reject stage=receiver resolution=")
            eprintU64(n: resolution)
            eprint(text: " callee=")
            eprintU64(n: selected.callee)
            eprint(text: " source-receiver=")
            eprintU64(n: term.callReceiver)
            eprint(text: " instantiated-receiver=")
            eprintU64(n: rawReceiver)
            eprint(text: "\n")
        }
        return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> />
    }
    val argumentStart: U64 = c.mid.callArguments.count()
    val conversionStatementStart: U64 = c.mid.statements.count()
    mut val argumentI: U64 = 0U64
    mut val cleanupPlaces: Array[U64] = []
    while argumentI < term.args.len {
        val conversion: U64 = c.finalCalleeConversionAt(conversions: selected.argumentConversions, index: argumentI)
        val targetType: U64 = c.finalCalleeParameterTypeAt(types: selected.parameterTypeRefs, index: argumentI)
        val passing: CallArgumentPassing = c.finalCalleeArgumentPassingAt(passings: selected.argumentPassings, index: argumentI)
        if !midSignatureArgumentMatches(c: c, signature: signature, index: argumentI, passing: passing) {
            return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> />
        }
        mut val operand: U64 = instantiateCanonicalOperand(c: inout c, bodyId: bodyId, operandId: c.mid.callArguments[term.args.start + argumentI], environment: environment, itemRef: itemRef)
        if operand == 0U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallConversionSource /> /> }
        if !c.conversionProofIsIdentity(id: conversion) {
            match passing {
                CallArgumentPassing.Borrow => {}
                _ => { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> /> }
            }
            val sourceType: U64 = midConversionSourceRef(c: c, conversion: conversion)
            val conversionTarget: U64 = midConversionTargetRef(c: c, conversion: conversion)
            if sourceType == 0U64 || !c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: sourceType) {
                if c.traceCodegen {
                    eprint(text: "[trace-codegen] Mid canonical conversion-source body=")
                    eprintU64(n: bodyId)
                    eprint(text: " expr=")
                    eprintU64(n: selected.exprId)
                    eprint(text: " offset=")
                    eprintU64(n: c.exprOffset(id: selected.exprId))
                    eprint(text: " argument=")
                    eprintU64(n: argumentI)
                    eprint(text: " proof=")
                    eprintU64(n: conversion)
                    eprint(text: " operand=")
                    c.traceMonoTypeHead(ref: canonicalMidOperandTypeRef(c: c, operandId: operand))
                    eprint(text: " source=")
                    c.traceMonoTypeHead(ref: sourceType)
                    eprint(text: " target=")
                    c.traceMonoTypeHead(ref: targetType)
                    eprint(text: "\n")
                }
                return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallConversionSource /> />
            }
            if conversionTarget == 0U64 || !c.typeRefEq(a: targetType, b: conversionTarget) { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallConversionTarget /> /> }
            val temporary: U64 = nextLocal
            nextLocal = nextLocal + 1U64
            c.mid.places.append(<MidPlaceNode local=temporary typeTerm=conversionTarget />)
            val temporaryPlace: U64 = c.mid.places.count()
            c.mid.rvalues.append(<MidRvalueNode tag=6U64 operand=operand conversion=conversion />)
            c.mid.statements.append(<MidStatementNode tag=1U64 destination=temporaryPlace value=c.mid.rvalues.count() />)
            c.mid.operands.append(<MidOperandNode tag=1U64 place=temporaryPlace />)
            operand = c.mid.operands.count()
            cleanupPlaces.append(temporaryPlace)
        }
        match passing {
            CallArgumentPassing.Borrow => { operand = canonicalBorrowOperand(c: inout c, operand: operand, locals: locals) }
            CallArgumentPassing.Move => {
                val source: MidOperandNode = c.mid.operands[operand - 1U64]
                if source.tag != 2U64 {
                    // A source Copy is an independent value, even when the
                    // selected ABI consumes it. Materialize that ownership;
                    // changing Copy(place) to Move(place) would consume the
                    // caller's original binding instead.
                    if source.tag != 1U64 && source.tag != 5U64 && source.tag != 6U64 && source.tag != 7U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> /> }
                    if targetType == 0U64 || !c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: targetType) { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallConversionSource /> /> }
                    val valueType: TypeRef = c.arena.typeAt(index: targetType)
                    if c.typeIsUnique(start: valueType.nameStart, len: valueType.nameLen) { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> /> }
                    c.mid.places.append(<MidPlaceNode local=nextLocal typeTerm=targetType />)
                    nextLocal += 1U64
                    val temporaryPlace: U64 = c.mid.places.count()
                    c.mid.rvalues.append(<MidRvalueNode tag=1U64 operand=operand />)
                    c.mid.statements.append(<MidStatementNode tag=1U64 destination=temporaryPlace value=c.mid.rvalues.count() />)
                    c.mid.operands.append(<MidOperandNode tag=2U64 place=temporaryPlace />)
                    operand = c.mid.operands.count()
                }
            }
            CallArgumentPassing.Inout => {}
        }
        if operand == 0U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.CallResolutionPassing /> /> }
        c.mid.callArguments.append(operand)
        argumentI = argumentI + 1U64
    }
    val destination: U64 = instantiateCanonicalPlace(c: inout c, bodyId: bodyId, placeId: term.destination, environment: environment, itemRef: itemRef)
    if destination == 0U64 { return <MidCanonicalCallMaterialization error=<MidInstantiateError.InvalidFinalResolution /> /> }
    val sourceStatementCount: U64 = c.mid.statements.count() - conversionStatementStart
    if cleanupPlaces.count() > 0U64 {
        c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=cleanupTarget args=<MidRange start=argumentStart len=term.args.len /> destination=destination callTarget=callTarget callReceiver=receiver />)
        val sourceTerminator: U64 = c.mid.terminators.count()
        val cleanupStart: U64 = c.mid.statements.count()
        mut val cleanupI: U64 = 0U64
        while cleanupI < cleanupPlaces.count() {
            c.mid.statements.append(<MidStatementNode tag=3U64 destination=cleanupPlaces[cleanupI] />)
            cleanupI = cleanupI + 1U64
        }
        c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=continuation />)
        return <MidCanonicalCallMaterialization sourceStatementCount=sourceStatementCount sourceTerminator=sourceTerminator cleanupStatements=<MidRange start=cleanupStart len=cleanupPlaces.count() /> cleanupTerminator=c.mid.terminators.count() hasCleanup=true />
    }
    c.mid.terminators.append(<MidTerminatorNode tag=4U64 target=continuation args=<MidRange start=argumentStart len=term.args.len /> destination=destination callTarget=callTarget callReceiver=receiver />)
    return <MidCanonicalCallMaterialization sourceStatementCount=sourceStatementCount sourceTerminator=c.mid.terminators.count() />
}

// Canonical instantiation is a direct append-only rewrite. Converted borrow
// arguments receive their own cleanup continuation, while every pre-existing
// CFG edge is remapped around those inserted blocks.
export fn instantiateCanonicalMidBody(c: inout Comp, body: MidCanonicalBody, bodyId: U64) -> MidCanonicalInstantiation {
    if body.body == 0U64 || body.body > c.mid.bodies.count() || bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() {
        return <MidCanonicalInstantiation error=<MidInstantiateError.InvalidBodyInstance /> />
    }
    val source: MidBodyNode = c.mid.bodies[body.body - 1U64]
    val targets = canonicalBlockTargets(c: c, source: source, bodyId: bodyId)
    val environment: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
    mut val itemRef: U64 = 0U64
    if environment.fnIdx < c.arena.functionCount() {
        itemRef = c.bodyProvidedItemTerm(f: c.arena.functionAt(index: environment.fnIdx), environment: environment.environment)
    } else if environment.fnIdx != source.sourceFunction {
        return <MidCanonicalInstantiation error=<MidInstantiateError.InvalidBodyInstance /> />
    }
    val scopeStart: U64 = c.mid.scopes.count()
    mut val scopeI: U64 = 0U64
    while scopeI < source.scopes.len {
        c.mid.scopes.append(c.mid.scopes[source.scopes.start + scopeI])
        scopeI = scopeI + 1U64
    }
    val blockStart: U64 = c.mid.blocks.count()
    mut val error: MidInstantiateError = <MidInstantiateError.None />
    mut val blockI: U64 = 0U64
    mut val outputBlockLen: U64 = 0U64
    mut val nextLocal: U64 = source.locals.len
    while blockI < source.blocks.len {
        val block: MidBlockNode = c.mid.blocks[source.blocks.start + blockI]
        val statementStart: U64 = c.mid.statements.count()
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            if !instantiateCanonicalStatement(c: inout c, statementId: block.statements.start + statementI + 1U64, locals: source.locals, environment: environment, bodyId: bodyId, sourceFunction: source.sourceFunction, itemRef: itemRef, error: inout error) {
                return <MidCanonicalInstantiation error=error />
            }
            statementI = statementI + 1U64
        }
        val instantiatedStatementCount: U64 = c.mid.statements.count() - statementStart
        val terminator: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
        if terminator.tag == 4U64 {
            val call: MidCanonicalCallMaterialization = materializeCanonicalMidCall(c: inout c, term: terminator, locals: source.locals, bodyId: bodyId, environment: environment, itemRef: itemRef, continuation: canonicalRemapTarget(targets: targets, target: terminator.target), cleanupTarget: canonicalRemapTarget(targets: targets, target: blockI) + 1U64, nextLocal: inout nextLocal)
            if midInstantiateHasError(error: call.error) { return <MidCanonicalInstantiation error=call.error /> }
            c.mid.blocks.append(<MidBlockNode statements=<MidRange start=statementStart len=instantiatedStatementCount + call.sourceStatementCount /> terminator=call.sourceTerminator />)
            outputBlockLen = outputBlockLen + 1U64
            if call.hasCleanup {
                c.mid.blocks.append(<MidBlockNode statements=call.cleanupStatements terminator=call.cleanupTerminator />)
                outputBlockLen = outputBlockLen + 1U64
            }
        } else {
            if !instantiateCanonicalNonCallTerminatorRemapped(c: inout c, terminatorId: block.terminator, environment: environment, itemRef: itemRef, targets: targets, bodyId: bodyId, error: inout error) { return <MidCanonicalInstantiation error=error /> }
            c.mid.blocks.append(<MidBlockNode statements=<MidRange start=statementStart len=instantiatedStatementCount /> terminator=c.mid.terminators.count() />)
            outputBlockLen = outputBlockLen + 1U64
        }
        blockI = blockI + 1U64
    }
    val locals: MidRange = appendCanonicalInstantiatedLocals(c: inout c, bodyId: bodyId, error: inout error, source: source, blockStart: blockStart, blockLen: outputBlockLen, environment: environment, itemRef: itemRef)
    if midInstantiateHasError(error: error) { return <MidCanonicalInstantiation error=error /> }
    c.mid.bodies.append(<MidBodyNode bodyInstance=bodyId sourceFunction=source.sourceFunction locals=locals scopes=<MidRange start=scopeStart len=source.scopes.len /> blocks=<MidRange start=blockStart len=outputBlockLen /> entry=canonicalRemapTarget(targets: targets, target: source.entry) />)
    return <MidCanonicalInstantiation body=<MidCanonicalBody body=c.mid.bodies.count() /> error=error />
}

enum MidSelectedSignature {
    Invalid
    Declaration(function: Func, hasReceiver: Bool)
    Closure(functionType: TypeRef, hasReceiver: Bool)
}

fn midSelectedSignature(c: inout Comp, selected: CallResolution) -> MidSelectedSignature {
    mut val functionType: U64 = 0U64
    mut val hasReceiver: Bool = false
    match selected.target {
        CallTarget.ClosureLocal(bindingDeclStart: _, fnTypeRef: val ref) => { functionType = ref }
        CallTarget.ClosureField(fieldIndex: _, fnTypeRef: val ref) => {
            functionType = ref
            hasReceiver = true
        }
        CallTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot) => {
            if traitIndex >= c.decls.traitCount() || slot == 0U64 || slot > c.decls.traitAt(index: traitIndex).reqs.count() { return <MidSelectedSignature.Invalid /> }
            return <MidSelectedSignature.Declaration function=c.traitReqAt(reqs: c.decls.traitAt(index: traitIndex).reqs, index: slot - 1U64) hasReceiver=true />
        }
        _ => {
            if selected.callee >= c.arena.functionCount() { return <MidSelectedSignature.Invalid /> }
            return <MidSelectedSignature.Declaration function=c.arena.functionAt(index: selected.callee) hasReceiver=c.arena.functionAt(index: selected.callee).hasRecv />
        }
    }
    if functionType == 0U64 || functionType >= c.arena.typeCount() { return <MidSelectedSignature.Invalid /> }
    val signature: TypeRef = c.arena.typeAt(index: functionType)
    if !c.isFnType(ref: functionType) || signature.args.count() == 0U64 { return <MidSelectedSignature.Invalid /> }
    return <MidSelectedSignature.Closure functionType=signature hasReceiver=hasReceiver />
}

fn midSignatureMatches(signature: MidSelectedSignature, count: U64, passing: CallReceiverPassing) -> Bool {
    match signature {
        MidSelectedSignature.Invalid => { return false }
        MidSelectedSignature.Declaration(function: val function, hasReceiver: val hasReceiver) => {
            return function.params.count() == count && midReceiverPassingMatches(callee: function, passing: passing, hasReceiver: hasReceiver)
        }
        MidSelectedSignature.Closure(functionType: val functionType, hasReceiver: val hasReceiver) => {
            if functionType.args.count() != count + 1U64 { return false }
            if hasReceiver { match passing { CallReceiverPassing.Borrow => { return true } _ => { return false } } }
            match passing { CallReceiverPassing.None => { return true } _ => { return false } }
        }
    }
}

fn midSignatureArgumentMatches(c: Comp, signature: MidSelectedSignature, index: U64, passing: CallArgumentPassing) -> Bool {
    match signature {
        MidSelectedSignature.Invalid => { return false }
        MidSelectedSignature.Declaration(function: val function, hasReceiver: _) => {
            return index < function.params.count() && midArgumentPassingMatches(parameter: c.funcParamAt(params: function.params, index: index), passing: passing)
        }
        MidSelectedSignature.Closure(functionType: val functionType, hasReceiver: _) => {
            if index + 1U64 >= functionType.args.count() { return false }
            match passing { CallArgumentPassing.Borrow => { return true } _ => { return false } }
        }
    }
}

fn midReceiverPassingMatches(callee: Func, passing: CallReceiverPassing, hasReceiver: Bool) -> Bool {
    if !hasReceiver {
        match passing { CallReceiverPassing.None => { return true } _ => { return false } }
    }
    if callee.selfInout { match passing { CallReceiverPassing.Inout => { return true } _ => { return false } } }
    if callee.selfMove { match passing { CallReceiverPassing.Move => { return true } _ => { return false } } }
    match passing { CallReceiverPassing.Borrow => { return true } _ => { return false } }
}

fn midArgumentPassingMatches(parameter: Param, passing: CallArgumentPassing) -> Bool {
    if parameter.isInout { match passing { CallArgumentPassing.Inout => { return true } _ => { return false } } }
    if parameter.isMove { match passing { CallArgumentPassing.Move => { return true } _ => { return false } } }
    match passing { CallArgumentPassing.Borrow => { return true } _ => { return false } }
}

fn midApplyReceiverPassing(receiver: MidCallReceiver, passing: CallReceiverPassing) -> MidCallReceiver {
    match passing {
        CallReceiverPassing.None => { return <MidCallReceiver.None /> }
        CallReceiverPassing.Borrow => {
            match receiver {
                MidCallReceiver.Value(operand: val operand) => {
                    match operand {
                        MidOperand.Copy(place: val place) => { return <MidCallReceiver.Value operand=<MidOperand.Borrow place=place capability=<MidBorrowCapability.Read /> /> /> }
                        _ => { return receiver }
                    }
                }
                _ => { return receiver }
            }
        }
        _ => { return receiver }
    }
}

fn midApplyArgumentPassing(operand: MidOperand, passing: CallArgumentPassing) -> MidOperand {
    match passing {
        CallArgumentPassing.Borrow => {
            match operand {
                MidOperand.Copy(place: val place) => { return <MidOperand.Borrow place=place capability=<MidBorrowCapability.Read /> /> }
                _ => { return operand }
            }
        }
        _ => { return operand }
    }
}

fn instantiateMidProjection(c: inout Comp, projection: MidProjection, environment: BodyInstance, itemRef: U64) -> MidProjection {
    match projection {
        MidProjection.Deref(typeTerm: val typeTerm) => {
            return <MidProjection.Deref typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidProjection.Field(index: val index, typeTerm: val typeTerm, isBoxed: val isBoxed) => {
            return <MidProjection.Field isBoxed=isBoxed index=index typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidProjection.Index(indexLocal: val indexLocal, typeTerm: val typeTerm) => {
            return <MidProjection.Index indexLocal=indexLocal typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
    }
}

fn instantiateMidPlace(c: inout Comp, bodyId: U64, place: MidPlace, environment: BodyInstance, itemRef: U64) -> MidPlace {
    mut val projections: Array[MidProjection] = []
    mut val i: U64 = 0U64
    while i < place.projections.count() {
        projections.append(instantiateMidProjection(c: inout c, projection: place.projections[i], environment: environment, itemRef: itemRef))
        i += 1U64
    }
    return <MidPlace rootTag=place.rootTag local=place.local globalTarget=place.globalTarget globalMutable=place.globalMutable projections=projections typeTerm=instantiateMidType(c: inout c, typeTerm: place.typeTerm, typeRecipe: place.typeRecipe, bodyId: bodyId, environment: environment, itemRef: itemRef) />
}

fn instantiateMidOperand(c: inout Comp, bodyId: U64, operand: MidOperand, environment: BodyInstance, itemRef: U64) -> MidOperand {
    match operand {
        MidOperand.Copy(place: val place) => { return <MidOperand.Copy place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) /> }
        MidOperand.Move(place: val place) => { return <MidOperand.Move place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) /> }
        MidOperand.Borrow(place: val place, capability: val capability) => { return <MidOperand.Borrow place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) capability=capability /> }
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: val integer, isNegative: val isNegative, isBool: val isBool, typeTerm: val typeTerm) => {
                    return <MidOperand.Constant value=<MidConstant.Integer value=integer isNegative=isNegative isBool=isBool typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) /> />
                }
                MidConstant.StringLiteral(start: val start, len: val len, typeTerm: val typeTerm) => {
                    return <MidOperand.Constant value=<MidConstant.StringLiteral start=start len=len typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) /> />
                }
                MidConstant.FloatLiteral(start: val start, len: val len, typeTerm: val typeTerm) => {
                    return <MidOperand.Constant value=<MidConstant.FloatLiteral start=start len=len typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) /> />
                }
            }
        }
        MidOperand.Access(candidate: val candidate) => { return <MidOperand.Access candidate=candidate /> }
    }
}

fn instantiateMidRvalue(c: inout Comp, value: MidRvalue, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> MidRvalue {
    match value {
        MidRvalue.Use(operand: val operand) => { return <MidRvalue.Use operand=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: operand, environment: environment, itemRef: itemRef) /> }
        MidRvalue.StorageBoundary(stmtId: val stmtId, targetTerm: val targetTerm, operand: val rawOperand) => {
            val operand: MidOperand = instantiateMidOperand(c: inout c, bodyId: bodyId, operand: rawOperand, environment: environment, itemRef: itemRef)
            val index: U64 = c.finalStorageIndex(bodyId: bodyId, stmtId: stmtId)
            if index >= c.arena.finalStorages.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val resolution: FinalStorageResolution = c.arena.finalStorages[index]
            val target: U64 = c.groundTermForBody(ref: targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if !c.typeRefEq(a: target, b: resolution.targetTypeRef) || !c.typeRefEq(a: midOperandTypeRef(operand: operand), b: resolution.sourceTypeRef) || c.conversionProofIsMissing(id: resolution.conversion) {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            if c.conversionProofIsIdentity(id: resolution.conversion) {
                if !c.typeRefEq(a: resolution.sourceTypeRef, b: target) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=resolution.targetTypeRef />
            }
            if !c.typeRefEq(a: resolution.sourceTypeRef, b: midConversionSourceRef(c: c, conversion: resolution.conversion)) || !c.typeRefEq(a: target, b: midConversionTargetRef(c: c, conversion: resolution.conversion)) {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            return <MidRvalue.Convert operand=operand conversion=resolution.conversion />
        }
        MidRvalue.ReturnBoundary(exprId: val exprId, targetTerm: val targetTerm, operand: val rawOperand) => {
            val operand: MidOperand = instantiateMidOperand(c: inout c, bodyId: bodyId, operand: rawOperand, environment: environment, itemRef: itemRef)
            val resolutionIndex: U64 = c.finalReturnIndex(bodyId: bodyId, exprId: exprId)
            if resolutionIndex >= c.arena.finalReturns.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingReturnResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val resolution: FinalReturnResolution = c.arena.finalReturns[resolutionIndex]
            val expectedTarget: U64 = c.groundTermForBody(ref: targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if !(c.typeRefEq(a: resolution.targetTypeRef, b: expectedTarget)) {
                if c.traceCodegen {
                    eprint(text: "[trace-codegen] Mid return target mismatch expected=")
                    c.traceMonoTypeHead(ref: expectedTarget)
                    eprint(text: " final=")
                    c.traceMonoTypeHead(ref: resolution.targetTypeRef)
                    eprint(text: "\n")
                }
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val conversion: U64 = c.freezeValueConversionProof(proof: resolution.conversion)
            if c.conversionProofIsIdentity(id: conversion) {
                    if !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: resolution.targetTypeRef)) { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> } }
                    // Keep an identity return boundary explicit. Structural
                    // TypeRef equality is not LLVM nominal-layout equality;
                    // the ABI target must remain available when freezing the
                    // return local and emitting its store.
                    return <MidRvalue.ReturnBoundary exprId=exprId targetTerm=resolution.targetTypeRef operand=operand />
            } else if c.conversionProofIsMissing(id: conversion) {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
                return <MidRvalue.Use operand=operand />
            } else {
                if !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: midConversionSourceRef(c: c, conversion: conversion))) || !(c.typeRefEq(a: resolution.targetTypeRef, b: midConversionTargetRef(c: c, conversion: conversion))) {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] Mid return conversion mismatch operand=")
                        c.traceMonoTypeHead(ref: midOperandTypeRef(operand: operand))
                        eprint(text: " proof-source=")
                        c.traceMonoTypeHead(ref: midConversionSourceRef(c: c, conversion: conversion))
                        eprint(text: " target=")
                        c.traceMonoTypeHead(ref: resolution.targetTypeRef)
                        eprint(text: " proof-target=")
                        c.traceMonoTypeHead(ref: midConversionTargetRef(c: c, conversion: conversion))
                        eprint(text: "\n")
                    }
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
                    return <MidRvalue.Use operand=operand />
                }
                return <MidRvalue.Convert operand=operand conversion=conversion />
            }
        }
        MidRvalue.Aggregate(exprId: val exprId, kind: val kind, resultTerm: val resultTerm, fieldCount: val fieldCount, elements: val elements) => {
            mut val instantiated: Array[MidAggregateElement] = []
            val resolutionIndex: U64 = c.finalAggregateIndex(bodyId: bodyId, exprId: exprId)
            val hasResolution: Bool = resolutionIndex < c.arena.finalAggregates.count()
            mut val resultRef: U64 = c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if hasResolution {
                val resolution: FinalAggregateResolution = c.arena.finalAggregates[resolutionIndex]
                resultRef = resolution.resultTypeRef
            } else {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            }
            mut val i: U64 = 0U64
            while i < elements.count() {
                val element: MidAggregateElement = elements[i]
                val operand: MidOperand = instantiateMidOperand(c: inout c, bodyId: bodyId, operand: element.operand, environment: environment, itemRef: itemRef)
                mut val targetTerm: U64 = 0U64
                mut val conversion: U64 = 0U64
                if hasResolution {
                    val resolution: FinalAggregateResolution = c.arena.finalAggregates[resolutionIndex]
                    if i < resolution.elementTargetRefs.count() && i < resolution.elementConversions.count() {
                        targetTerm = resolution.elementTargetRefs[i]
                        conversion = c.freezeValueConversionProof(proof: resolution.elementConversions[i])
                        // An identity proof is a concrete frontend claim about
                        // this exact BodyInstance. Validate it while freezing
                        // the Mid body; LLVM must only consume the resulting
                        // checked slot contract, never rediscover it from
                        // operand/type metadata during preflight.
                        if c.conversionProofIsIdentity(id: conversion) && !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: targetTerm)) {
                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                        }
                    } else {
                        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                    }
                }
                instantiated.append(<MidAggregateElement fieldIndex=element.fieldIndex operand=operand targetTerm=targetTerm isBoxed=element.isBoxed conversion=conversion />)
                i += 1U64
            }
            return <MidRvalue.Aggregate exprId=exprId kind=kind resultTerm=resultRef fieldCount=fieldCount elements=instantiated />
        }
        MidRvalue.Convert(operand: val operand, conversion: val conversion) => {
            return <MidRvalue.Convert operand=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: operand, environment: environment, itemRef: itemRef) conversion=conversion />
        }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: val sourceTerm, targetTerm: val targetTerm, operand: val rawOperand) => {
            val operand: MidOperand = instantiateMidOperand(c: inout c, bodyId: bodyId, operand: rawOperand, environment: environment, itemRef: itemRef)
            val sourceRef: U64 = c.groundTermForBody(ref: sourceTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            val targetRef: U64 = c.groundTermForBody(ref: targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if sourceRef == 0U64 || targetRef == 0U64 || sourceRef >= c.arena.typeCount() || targetRef >= c.arena.typeCount() || !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: sourceRef)) {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val source: TypeRef = c.arena.typeAt(index: sourceRef)
            val target: TypeRef = c.arena.typeAt(index: targetRef)
            // Newtype wrap/unwrap is the spec's explicit zero-cost exception.
            // It is closed by the selected nominal types, rather than a backend
            // check of the authored cast spelling.
            val sourceUnderlying: U64 = c.newtypeUnderRef(start: source.nameStart, len: source.nameLen)
            val targetUnderlying: U64 = c.newtypeUnderRef(start: target.nameStart, len: target.nameLen)
            if sourceUnderlying != 0U64 && c.typeRefEq(a: sourceUnderlying, b: targetRef) {
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=targetRef />
            }
            if targetUnderlying != 0U64 && c.typeRefEq(a: sourceRef, b: targetUnderlying) {
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=targetRef />
            }
            if c.isIntType(start: source.nameStart, len: source.nameLen) {
                val sourceSigned: Bool = c.intSigned(start: source.nameStart, len: source.nameLen)
                if c.isIntType(start: target.nameStart, len: target.nameLen) {
                    if !(c.losslessInt(srcStart: source.nameStart, srcLen: source.nameLen, dstStart: target.nameStart, dstLen: target.nameLen)) {
                        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
                        return <MidRvalue.Use operand=operand />
                    }
                    return <MidRvalue.Cast operand=operand kind=<MidCastKind.IntegerWiden sourceSigned=sourceSigned /> targetTerm=targetRef />
                }
                if c.isFloatType(start: target.nameStart, len: target.nameLen) {
                    return <MidRvalue.Cast operand=operand kind=<MidCastKind.IntegerToFloat sourceSigned=sourceSigned /> targetTerm=targetRef />
                }
            }
            if c.isFloatType(start: source.nameStart, len: source.nameLen) && c.isFloatType(start: target.nameStart, len: target.nameLen) {
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=targetRef />
            }
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
            return <MidRvalue.Use operand=operand />
        }
        MidRvalue.Cast(operand: val operand, kind: val kind, targetTerm: val targetTerm) => {
            return <MidRvalue.Cast operand=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: operand, environment: environment, itemRef: itemRef) kind=kind targetTerm=targetTerm />
        }
        MidRvalue.EnumTag(place: val place, enumIndex: val enumIndex, matchSource: val matchSource, resultTerm: val resultTerm) => {
            val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, matchSource: matchSource)
            if matchIndex >= c.arena.finalMatches.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            } else {
                if !(midFinalMatchShapeMatches(c: c, matchIndex: matchIndex, enumIndex: enumIndex, scrutineeTypeRef: c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
            }
            return <MidRvalue.EnumTag place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) enumIndex=enumIndex matchSource=matchSource resultTerm=c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidRvalue.EnumPayloadCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, matchSource: val matchSource, resultTerm: val resultTerm) => {
            val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, matchSource: matchSource)
            val groundedResult: U64 = c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if matchIndex >= c.arena.finalMatches.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            } else {
                if !(midFinalMatchShapeMatches(c: c, matchIndex: matchIndex, enumIndex: enumIndex, scrutineeTypeRef: c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                } else if !(midFinalMatchPayloadMatches(c: c, matchIndex: matchIndex, variantIndex: variantIndex, bindTarget: bindTarget, fieldIndex: fieldIndex, fieldTypeRef: groundedResult)) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
            }
            return <MidRvalue.EnumPayloadCopy place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget matchSource=matchSource resultTerm=groundedResult />
        }
        MidRvalue.EnumPayloadBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, matchSource: val matchSource, resultTerm: val resultTerm) => {
            val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, matchSource: matchSource)
            val groundedResult: U64 = c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if matchIndex >= c.arena.finalMatches.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            } else {
                if !(midFinalMatchShapeMatches(c: c, matchIndex: matchIndex, enumIndex: enumIndex, scrutineeTypeRef: c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                } else if !(midFinalMatchPayloadMatches(c: c, matchIndex: matchIndex, variantIndex: variantIndex, bindTarget: bindTarget, fieldIndex: fieldIndex, fieldTypeRef: groundedResult)) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
            }
            return <MidRvalue.EnumPayloadBorrow place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget matchSource=matchSource resultTerm=groundedResult />
        }
        // Boxed payload reads have identical declaration identity and logical
        // type requirements. Delegate their grounding/validation to the
        // ordinary variants, then preserve only the physical cell-read opcode.
        MidRvalue.EnumPayloadBoxedCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, matchSource: val matchSource, resultTerm: val resultTerm) => {
            val checked: MidRvalue = instantiateMidRvalue(c: inout c, value: <MidRvalue.EnumPayloadCopy place=place enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget matchSource=matchSource resultTerm=resultTerm />, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            match checked {
                MidRvalue.EnumPayloadCopy(place: val groundedPlace, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, matchSource: _, resultTerm: val groundedResult) => {
                    return <MidRvalue.EnumPayloadBoxedCopy place=groundedPlace enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget matchSource=matchSource resultTerm=groundedResult />
                }
                _ => { return checked }
            }
        }
        MidRvalue.EnumPayloadBoxedBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, matchSource: val matchSource, resultTerm: val resultTerm) => {
            val checked: MidRvalue = instantiateMidRvalue(c: inout c, value: <MidRvalue.EnumPayloadBorrow place=place enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget matchSource=matchSource resultTerm=resultTerm />, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            match checked {
                MidRvalue.EnumPayloadBorrow(place: val groundedPlace, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, matchSource: _, resultTerm: val groundedResult) => {
                    return <MidRvalue.EnumPayloadBoxedBorrow place=groundedPlace enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget matchSource=matchSource resultTerm=groundedResult />
                }
                _ => { return checked }
            }
        }
        MidRvalue.ForTag(place: _, stmtId: _, resultTerm: _) => { error = <MidInstantiateError.InvalidFinalResolution />
            return value }
        MidRvalue.ForPayloadCopy(place: _, stmtId: _) => { error = <MidInstantiateError.InvalidFinalResolution />
            return value }
        MidRvalue.TryTag(place: val place, exprId: val exprId, resultTerm: val resultTerm) => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: exprId)
            if tryIndex >= c.arena.finalTries.count() { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> } }
            return <MidRvalue.TryTag place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) exprId=exprId resultTerm=c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidRvalue.TryPayloadCopy(place: val place, exprId: val exprId, variantIndex: val variantIndex, resultTerm: val resultTerm) => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: exprId)
            if tryIndex >= c.arena.finalTries.count() { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> } }
            return <MidRvalue.TryPayloadCopy place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) exprId=exprId variantIndex=variantIndex resultTerm=c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidRvalue.TryErrResult(exprId: val exprId, resultTerm: val resultTerm, error: val errorOperand) => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: exprId)
            if tryIndex >= c.arena.finalTries.count() { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> } }
            return <MidRvalue.TryErrResult exprId=exprId resultTerm=c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) error=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: errorOperand, environment: environment, itemRef: itemRef) />
        }
        MidRvalue.MakeClosure(exprId: val exprId, bodyKey: val bodyKey, functionTypeTerm: val functionTypeTerm, captures: val captures) => {
            mut val grounded: Array[MidClosureCapture] = []
            mut val i: U64 = 0U64
            while i < captures.count() {
                val capture = captures[i]
                grounded.append(<MidClosureCapture bindingTarget=capture.bindingTarget typeTerm=c.groundTermForBody(ref: capture.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) mode=capture.mode operand=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: capture.operand, environment: environment, itemRef: itemRef) />)
                i += 1U64
            }
            return <MidRvalue.MakeClosure exprId=exprId bodyKey=bodyKey functionTypeTerm=c.groundTermForBody(ref: functionTypeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) captures=grounded />
        }
    }
}

fn instantiateMidCallReceiver(c: inout Comp, bodyId: U64, receiver: MidCallReceiver, environment: BodyInstance, itemRef: U64) -> MidCallReceiver {
    match receiver {
        MidCallReceiver.None => { return <MidCallReceiver.None /> }
        MidCallReceiver.Value(operand: val operand) => { return <MidCallReceiver.Value operand=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: operand, environment: environment, itemRef: itemRef) /> }
    }
}

fn instantiateMidStatement(c: inout Comp, statement: MidStatement, locals: Array[MidLocalDecl], environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> MidStatement {
    match statement {
        MidStatement.Assign(destination: val destination, value: val value) => {
            return <MidStatement.Assign destination=instantiateMidPlace(c: inout c, bodyId: bodyId, place: destination, environment: environment, itemRef: itemRef) value=instantiateMidRvalue(c: inout c, value: value, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) />
        }
        MidStatement.InitializeCaptureCell(destination: val destination, value: val value) => {
            return <MidStatement.InitializeCaptureCell destination=instantiateMidPlace(c: inout c, bodyId: bodyId, place: destination, environment: environment, itemRef: itemRef) value=instantiateMidRvalue(c: inout c, value: value, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) />
        }
        MidStatement.Overwrite(destination: val destination, source: val source) => {
            return <MidStatement.Overwrite destination=instantiateMidPlace(c: inout c, bodyId: bodyId, place: destination, environment: environment, itemRef: itemRef) source=instantiateMidPlace(c: inout c, bodyId: bodyId, place: source, environment: environment, itemRef: itemRef) />
        }
        MidStatement.InitializeGlobal(destination: val destination, source: val source) => {
            return <MidStatement.InitializeGlobal destination=instantiateMidPlace(c: inout c, bodyId: bodyId, place: destination, environment: environment, itemRef: itemRef) source=instantiateMidPlace(c: inout c, bodyId: bodyId, place: source, environment: environment, itemRef: itemRef) />
        }
        MidStatement.Drop(place: val place) => { return <MidStatement.Drop place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) /> }
        MidStatement.ReleaseCaptureCell(place: val place) => { return <MidStatement.ReleaseCaptureCell place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) /> }
        MidStatement.ConditionalDrop(place: val place, flag: val flag) => { return <MidStatement.ConditionalDrop place=instantiateMidPlace(c: inout c, bodyId: bodyId, place: place, environment: environment, itemRef: itemRef) flag=flag /> }
        MidStatement.SetDropFlag(local: val local, isSet: val isSet) => { return <MidStatement.SetDropFlag local=local isSet=isSet /> }
        MidStatement.ScopeExit(scope: val scope) => { return <MidStatement.ScopeExit scope=scope /> }
        MidStatement.StorageCommit(stmtId: val stmtId) => {
            val factIndex: U64 = c.finalStorageIndex(bodyId: bodyId, stmtId: stmtId)
            if factIndex >= c.arena.finalStorages.count() {
                error = <MidInstantiateError.InvalidFinalResolution />
                return <MidStatement.Nop />
            }
            val target: U64 = c.arena.finalStorages[factIndex].shadowedBindingTarget
            if target == 0U64 { return <MidStatement.Nop /> }
            mut val local: U64 = 0U64
            while local < locals.count() {
                if locals[local].sourceNameStart == target { return <MidStatement.EndBinding local=local /> }
                local += 1U64
            }
            error = <MidInstantiateError.InvalidFinalResolution />
            return <MidStatement.Nop />
        }
        MidStatement.EndBinding(local: val local) => { return <MidStatement.EndBinding local=local /> }
        MidStatement.Nop => { return <MidStatement.Nop /> }
    }
}

// 0 means no descriptor exists.  The caller reports that as a phase-boundary
// failure instead of falling back to a name/arity lookup.
fn instantiateMidCallTarget(c: Comp, target: MidCallTarget, bodyId: U64) -> MidCallTarget {
    match target {
        MidCallTarget.Resolved(resolution: val resolution) => { return <MidCallTarget.Resolved resolution=resolution /> }
        MidCallTarget.Template(site: val site) => {
            val resolution: U64 = c.finalCalleeIndexForKey(bodyId: bodyId, siteKey: site)
            if resolution >= c.finalCalleeCount() { return <MidCallTarget.Template site=site /> }
            return <MidCallTarget.Resolved resolution=resolution />
        }
        MidCallTarget.ForProtocol(stmtId: val stmtId, slot: val slot) => { return <MidCallTarget.ForProtocol stmtId=stmtId slot=slot /> }
        MidCallTarget.TryConversion(exprId: val exprId) => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: exprId)
            if tryIndex >= c.arena.finalTries.count() { return <MidCallTarget.TryConversion exprId=exprId /> }
            val fact: FinalTryResolution = c.arena.finalTries[tryIndex]
            if !fact.hasErrorConversion || fact.errorConversionResolution >= c.arena.finalCallees.count() { return <MidCallTarget.TryConversion exprId=exprId /> }
            return <MidCallTarget.Resolved resolution=fact.errorConversionResolution />
        }
    }
}

fn instantiateMidTerminator(c: inout Comp, term: MidTerminator, environment: BodyInstance, bodyId: U64, itemRef: U64) -> MidTerminator {
    match term {
        MidTerminator.Open => { return <MidTerminator.Open /> }
        MidTerminator.Goto(target: val target) => { return <MidTerminator.Goto target=target /> }
        MidTerminator.Switch(discriminant: val discriminant, values: val values, targets: val targets, otherwise: val otherwise) => {
            return <MidTerminator.Switch discriminant=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: discriminant, environment: environment, itemRef: itemRef) values=values targets=targets otherwise=otherwise />
        }
        MidTerminator.ForBranch(discriminant: val discriminant, stmtId: val stmtId, someTarget: val someTarget, noneTarget: val noneTarget) => { return <MidTerminator.ForBranch discriminant=discriminant stmtId=stmtId someTarget=someTarget noneTarget=noneTarget /> }
        MidTerminator.TryBranch(discriminant: val discriminant, exprId: val exprId, okTarget: val okTarget, errTarget: val errTarget) => {
            val tryIndex: U64 = c.finalTryIndex(bodyId: bodyId, exprId: exprId)
            if tryIndex >= c.arena.finalTries.count() { return <MidTerminator.TryBranch discriminant=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: discriminant, environment: environment, itemRef: itemRef) exprId=exprId okTarget=okTarget errTarget=errTarget /> }
            val fact: FinalTryResolution = c.arena.finalTries[tryIndex]
            return <MidTerminator.Switch discriminant=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: discriminant, environment: environment, itemRef: itemRef) values=[bitCastI64(n: fact.okVariantIndex)] targets=[okTarget] otherwise=errTarget />
        }
        MidTerminator.Call(callee: val callee, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
            mut val instantiatedArgs: Array[MidOperand] = []
            mut val i: U64 = 0U64
            while i < args.count() {
                instantiatedArgs.append(instantiateMidOperand(c: inout c, bodyId: bodyId, operand: args[i], environment: environment, itemRef: itemRef))
                i += 1U64
            }
            return <MidTerminator.Call callee=instantiateMidCallTarget(c: c, target: callee, bodyId: bodyId) receiver=instantiateMidCallReceiver(c: inout c, bodyId: bodyId, receiver: receiver, environment: environment, itemRef: itemRef) args=instantiatedArgs destination=instantiateMidPlace(c: inout c, bodyId: bodyId, place: destination, environment: environment, itemRef: itemRef) target=target />
        }
        // NormalizedCall is consumed directly by the canonical freeze path.
        // Preserve its scalar argument rows here solely so the deprecated
        // draft instantiation API remains structurally total; its caller
        // rejects this form before any legacy backend can observe it.
        MidTerminator.NormalizedCall(callee: val callee, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
            return <MidTerminator.NormalizedCall callee=instantiateMidCallTarget(c: c, target: callee, bodyId: bodyId) receiver=instantiateMidCallReceiver(c: inout c, bodyId: bodyId, receiver: receiver, environment: environment, itemRef: itemRef) args=args destination=instantiateMidPlace(c: inout c, bodyId: bodyId, place: destination, environment: environment, itemRef: itemRef) target=target />
        }
        MidTerminator.Return => { return <MidTerminator.Return /> }
        MidTerminator.ReturnValue(value: val value) => { return <MidTerminator.ReturnValue value=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: value, environment: environment, itemRef: itemRef) /> }
        MidTerminator.Panic(message: val message) => { return <MidTerminator.Panic message=instantiateMidOperand(c: inout c, bodyId: bodyId, operand: message, environment: environment, itemRef: itemRef) /> }
        MidTerminator.Unreachable => { return <MidTerminator.Unreachable /> }
        MidTerminator.Abort => { return <MidTerminator.Abort /> }
        MidTerminator.Suspend(state: val state, resume: val resume) => { return <MidTerminator.Suspend state=state resume=resume /> }
    }
}

// The source builder records a parametric call operand, while the frozen
// CallResolution owns the ABI conversion chosen for it.  This helper reads no
// syntax: it merely exposes the already-ground operand term so instantiation
// can check that the proof and the Mid operand still describe the same value.
fn midOperandTypeRef(operand: MidOperand) -> U64 {
    match operand {
        MidOperand.Copy(place: val place) => { return place.typeTerm }
        MidOperand.Move(place: val place) => { return place.typeTerm }
        MidOperand.Borrow(place: val place, capability: _) => { return place.typeTerm }
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: _, isNegative: _, isBool: _, typeTerm: val typeTerm) => { return typeTerm }
                MidConstant.StringLiteral(start: _, len: _, typeTerm: val typeTerm) => { return typeTerm }
                MidConstant.FloatLiteral(start: _, len: _, typeTerm: val typeTerm) => { return typeTerm }
            }
        }
        MidOperand.Access(candidate: _) => { return 0U64 }
    }
}

fn midConversionSourceRef(c: Comp, conversion: U64) -> U64 {
    if conversion == 0U64 || conversion > c.arena.conversionProofs.count() { return 0U64 }
    return c.arena.conversionProofs[conversion - 1U64].sourceRef
}

fn midConversionTargetRef(c: Comp, conversion: U64) -> U64 {
    if conversion == 0U64 || conversion > c.arena.conversionProofs.count() { return 0U64 }
    return c.arena.conversionProofs[conversion - 1U64].targetRef
}

// An instantiated rvalue carries the concrete type of the value it produces.
// A root Mid local is the owned home for that value, so its declaration must
// be frozen from this fact before LLVM allocates the local.  This is an IR
// typing rule, not inference: Aggregate/Convert/ReturnBoundary already obtain
// their result type solely from frontend-finalized resolutions.
fn midRvalueResultType(c: Comp, value: MidRvalue) -> U64 {
    match value {
        MidRvalue.Use(operand: val operand) => { return midOperandTypeRef(operand: operand) }
        MidRvalue.StorageBoundary(stmtId: _, targetTerm: val targetTerm, operand: _) => { return targetTerm }
        MidRvalue.ReturnBoundary(exprId: _, targetTerm: val targetTerm, operand: _) => { return targetTerm }
        MidRvalue.Aggregate(exprId: _, kind: _, resultTerm: val resultTerm, fieldCount: _, elements: _) => { return resultTerm }
        MidRvalue.Convert(operand: _, conversion: val conversion) => {
            if c.conversionProofIsIdentity(id: conversion) { return 0U64 }
            return midConversionTargetRef(c: c, conversion: conversion)
        }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: val targetTerm, operand: _) => { return targetTerm }
        MidRvalue.Cast(operand: _, kind: _, targetTerm: val targetTerm) => { return targetTerm }
        MidRvalue.EnumTag(place: _, enumIndex: _, matchSource: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, matchSource: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, matchSource: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadBoxedCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, matchSource: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadBoxedBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, matchSource: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.ForTag(place: _, stmtId: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.ForPayloadCopy(place: _, stmtId: _) => { return 0U64 }
        MidRvalue.TryTag(place: _, exprId: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.TryPayloadCopy(place: _, exprId: _, variantIndex: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.TryErrResult(exprId: _, resultTerm: val resultTerm, error: _) => { return resultTerm }
        MidRvalue.MakeClosure(exprId: _, bodyKey: _, functionTypeTerm: val functionTypeTerm, captures: _) => { return functionTypeTerm }
    }
}

fn midWithTypeTerm(local: MidLocalDecl, typeTerm: U64) -> MidLocalDecl {
    return <MidLocalDecl typeTerm=typeTerm sourceScope=local.sourceScope isUnique=local.isUnique isParameter=local.isParameter isBorrowed=local.isBorrowed isInout=local.isInout isCaptureCell=local.isCaptureCell ownsAtEntry=local.ownsAtEntry isDropFlag=local.isDropFlag isReturnPlace=local.isReturnPlace sourceNameStart=local.sourceNameStart />
}

// Ground a parametric Mid body exactly once for one frontend BodyInstance.
// A remaining Template is an internal frontend/Mid phase error: the final
// callable freeze must have published every descriptor before this point.
export fn instantiateMidBody(c: inout Comp, body: MidBody, bodyId: U64) -> MidInstantiation {
    if bodyId == 0U64 || bodyId > c.arena.bodyInstanceCount() {
        return <MidInstantiation body=body error=<MidInstantiateError.InvalidBodyInstance /> />
    }
    val environment: BodyInstance = c.arena.bodyInstanceAt(index: bodyId - 1U64)
    if environment.fnIdx >= c.arena.functionCount() {
        return <MidInstantiation body=body error=<MidInstantiateError.InvalidBodyInstance /> />
    }
    val f: Func = c.arena.functionAt(index: environment.fnIdx)
    val itemRef: U64 = c.bodyProvidedItemTerm(f: f, environment: environment.environment)
    mut val locals: Array[MidLocalDecl] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.count() {
        val local: MidLocalDecl = body.locals[localI]
        val localType: U64 = instantiateMidType(c: inout c, typeTerm: local.typeTerm, typeRecipe: local.typeRecipe, bodyId: bodyId, environment: environment, itemRef: itemRef)
        if local.typeRecipe != 0U64 && localType == 0U64 {
            return <MidInstantiation body=body error=<MidInstantiateError.InvalidLocalResultType /> />
        }
        locals.append(<MidLocalDecl typeTerm=localType sourceScope=local.sourceScope isUnique=local.isUnique isParameter=local.isParameter isBorrowed=local.isBorrowed isInout=local.isInout isCaptureCell=local.isCaptureCell ownsAtEntry=local.ownsAtEntry isDropFlag=local.isDropFlag isReturnPlace=local.isReturnPlace sourceNameStart=local.sourceNameStart />)
        localI += 1U64
    }
    mut val blocks: Array[MidBlock] = []
    // A conversion temporary has statement-end lifetime.  Give every call its
    // own continuation rather than prepending drops to the source continuation:
    // source targets may have multiple predecessors, while this generated block
    // has exactly the call as its predecessor.
    mut val cleanupBlocks: Array[MidBlock] = []
    mut val blockI: U64 = 0U64
    mut val error: MidInstantiateError = <MidInstantiateError.None />
    while blockI < body.blocks.count() {
        val block: MidBlock = body.blocks[blockI]
        mut val statements: Array[MidStatement] = []
        mut val statementI: U64 = 0U64
        while statementI < block.statements.count() {
            mut val statement: MidStatement = instantiateMidStatement(c: inout c, statement: block.statements[statementI], locals: locals, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            // The parametric builder gives a temporary the source aggregate's
            // TypeTerm.  Final aggregate/return resolution can make that term
            // concrete (for example `(first:T, second:T)` -> String fields).
            // Freeze the root owned home from the instantiated rvalue before
            // any subsequent operand or LLVM allocation observes it.
            match statement {
                MidStatement.Assign(destination: val destination, value: val value) => {
                    if destination.projections.count() == 0U64 && destination.local < locals.count() {
                        val resultType: U64 = midRvalueResultType(c: c, value: value)
                        if resultType != 0U64 {
                            val declaration: MidLocalDecl = locals[destination.local]
                            if declaration.isParameter || declaration.sourceNameStart != 0U64 {
                                if !c.typeRefEq(a: declaration.typeTerm, b: resultType) { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidLocalResultType /> } }
                            } else {
                                locals.set(i: destination.local, value: midWithTypeTerm(local: declaration, typeTerm: resultType))
                                statement = <MidStatement.Assign destination=<MidPlace rootTag=destination.rootTag local=destination.local globalTarget=destination.globalTarget globalMutable=destination.globalMutable projections=destination.projections typeTerm=resultType /> value=value />
                            }
                        }
                    }
                }
                _ => {}
            }
            statements.append(statement)
            statementI += 1U64
        }
        mut val terminator: MidTerminator = instantiateMidTerminator(c: inout c, term: block.terminator, environment: environment, bodyId: bodyId, itemRef: itemRef)
    match terminator {
            MidTerminator.Call(callee: val callee, receiver: val receiver, args: val rawArgs, destination: val destination, target: val target) => {
                match callee {
                    MidCallTarget.Template(site: _) => { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingCallResolution /> } }
                    MidCallTarget.ForProtocol(stmtId: _, slot: _) => { error = <MidInstantiateError.InvalidFinalResolution /> }
                    MidCallTarget.TryConversion(exprId: _) => { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingTryResolution /> } }
                    MidCallTarget.Resolved(resolution: val resolution) => {
                        if resolution >= c.arena.finalCallees.count() {
                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionIndex /> }
                        } else {
                            val selected: CallResolution = c.arena.finalCallees[resolution]
                            val conversions: Array[U64] = c.copyFinalCalleeConversions(conversions: selected.argumentConversions)
                            val parameterTypes: Array[U64] = c.copyFinalCalleeParameterTypes(types: selected.parameterTypeRefs)
                            val argumentPassings: Array[CallArgumentPassing] = c.copyFinalCalleeArgumentPassings(passings: selected.argumentPassings)
                            if conversions.count() != rawArgs.count() || parameterTypes.count() != rawArgs.count() || argumentPassings.count() != rawArgs.count() {
                                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionArity /> }
                            } else {
                                val signature: MidSelectedSignature = midSelectedSignature(c: inout c, selected: selected)
                                if !midSignatureMatches(signature: signature, count: rawArgs.count(), passing: selected.receiverPassing) {
                                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionPassing /> }
                                } else {
                                mut val args: Array[MidOperand] = rawArgs
                                val guaranteedReceiver: MidCallReceiver = midApplyReceiverPassing(receiver: receiver, passing: selected.receiverPassing)
                                mut val cleanup: Array[MidStatement] = []
                                mut val argumentI: U64 = 0U64
                                while argumentI < args.count() {
                                    val conversion: U64 = conversions[argumentI]
                                    val passing: CallArgumentPassing = argumentPassings[argumentI]
                                    if !(midSignatureArgumentMatches(c: c, signature: signature, index: argumentI, passing: passing)) {
                                        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionPassing /> }
                                    }
                                    if !(c.conversionProofIsIdentity(id: conversion)) {
                                        match passing {
                                            CallArgumentPassing.Borrow => {}
                                            _ => { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionPassing /> } }
                                        }
                                        val sourceRef: U64 = midConversionSourceRef(c: c, conversion: conversion)
                                        val targetRef: U64 = midConversionTargetRef(c: c, conversion: conversion)
                                        if sourceRef == 0U64 || !(c.typeRefEq(a: midOperandTypeRef(operand: args[argumentI]), b: sourceRef)) {
                                            if c.traceCodegen {
                                                eprint(text: "[trace-codegen] Mid call conversion source mismatch body=")
                                                eprintU64(n: bodyId)
                                                eprint(text: " call=")
                                                eprintU64(n: resolution)
                                                eprint(text: " expr=")
                                                eprintU64(n: selected.exprId)
                                                eprint(text: " argument=")
                                                eprintU64(n: argumentI)
                                                eprint(text: " operand-term=")
                                                eprintU64(n: midOperandTypeRef(operand: args[argumentI]))
                                                eprint(text: " source-term=")
                                                eprintU64(n: sourceRef)
                                                eprint(text: " operand=")
                                                c.traceMonoTypeHead(ref: midOperandTypeRef(operand: args[argumentI]))
                                                eprint(text: " proof-source=")
                                                c.traceMonoTypeHead(ref: sourceRef)
                                                eprint(text: "\n")
                                            }
                                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallConversionSource /> }
                                        } else if targetRef == 0U64 || !(c.typeRefEq(a: parameterTypes[argumentI], b: targetRef)) {
                                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallConversionTarget /> }
                                        } else {
                                            val temporary: U64 = locals.count()
                                            locals.append(<MidLocalDecl typeTerm=targetRef sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false isDropFlag=false isReturnPlace=false sourceNameStart=0U64 />)
                                            val temporaryPlace: MidPlace = <MidPlace local=temporary typeTerm=targetRef />
                                            statements.append(<MidStatement.Assign destination=temporaryPlace value=<MidRvalue.Convert operand=args[argumentI] conversion=conversion /> />)
                                            args.set(i: argumentI, value: <MidOperand.Copy place=temporaryPlace />)
                                            cleanup.append(<MidStatement.Drop place=temporaryPlace />)
                                        }
                                    }
                                    args.set(i: argumentI, value: midApplyArgumentPassing(operand: args[argumentI], passing: passing))
                                    argumentI += 1U64
                                }
                                if cleanup.count() > 0U64 {
                                    val cleanupTarget: U64 = body.blocks.count() + cleanupBlocks.count()
                                    cleanupBlocks.append(<MidBlock statements=cleanup terminator=<MidTerminator.Goto target=target /> />)
                                    terminator = <MidTerminator.Call callee=callee receiver=guaranteedReceiver args=args destination=destination target=cleanupTarget />
                                } else {
                                    terminator = <MidTerminator.Call callee=callee receiver=guaranteedReceiver args=args destination=destination target=target />
                                }
                                }
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        blocks.append(<MidBlock statements=statements terminator=terminator />)
        blockI += 1U64
    }
    mut val cleanupI: U64 = 0U64
    while cleanupI < cleanupBlocks.count() {
        blocks.append(cleanupBlocks[cleanupI])
        cleanupI += 1U64
    }
    val instantiated: MidBody = <MidBody bodyInstance=bodyId sourceFunction=body.sourceFunction locals=locals scopes=body.scopes blocks=blocks entry=body.entry />
    if midInstantiateHasError(error: error) { return <MidInstantiation body=instantiated error=error /> }
    return <MidInstantiation body=instantiated />
}
