// Parametric Mid bodies cross the frontend/backend freeze boundary only through
// an explicit BodyInstance.  This module deliberately consumes existing
// frontend facts: it substitutes TypeTerms with groundTermForBody and resolves
// call sites against the immutable final CallResolution table.  It neither
// re-types an AST expression nor searches callable candidates.

import ../Frontend with { Comp }
import ../Ir with { CallSiteKey, BodyInstance, Func, Param, TypeRef, CallResolution, CallReceiverPassing, CallArgumentPassing, FinalAggregateResolution, FinalReturnResolution, ValueConversionProof }
import ../Diag with { eprintU64 }
import @Std/Io with { eprint }
import ./Ir with { MidRange, MidPlaceNode, MidProjectionNode, MidOperandNode, MidAggregateElementNode, MidStatementNode, MidTerminatorNode, MidSwitchCase, MidCanonicalBody, MidProjection, MidPlace, MidBorrowCapability, MidConstant, MidOperand, MidAggregateKind, MidAggregateElement, MidRvalue, MidCastKind, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody }

export enum MidInstantiateError {
    None
    InvalidBodyInstance
    MissingCallResolution
    CallResolutionIndex
    CallResolutionArity
    CallResolutionPassing
    CallConversionSource
    CallConversionTarget
    MissingReturnResolution
    InvalidReturnResolution
    InvalidCastResolution
    // Aggregate, return, and match descriptors are all final frontend facts.
    // At this boundary the relevant invariant is their presence and internal
    // agreement, not the source construct that happened to navigate to one.
    MissingFinalResolution
    InvalidFinalResolution
    InvalidLocalResultType
}

export struct MidInstantiation {
    pub val body: MidBody
    pub val error: MidInstantiateError = <MidInstantiateError.None />
}
pub impl MidInstantiation { factory }

// Canonical instantiation is append-only: it reads the parametric snapshot
// from `c.mid` and emits a second scalar-row snapshot there. It intentionally
// has no MidBody field, preventing callers from thawing back into the draft
// representation while this path is completed opcode by opcode.
export struct MidCanonicalInstantiation {
    pub val body: MidCanonicalBody = <MidCanonicalBody body=0U64 />
    pub val error: MidInstantiateError = <MidInstantiateError.None />
}
pub impl MidCanonicalInstantiation { factory }

fn midInstantiateHasError(error: MidInstantiateError) -> Bool {
    match error {
        MidInstantiateError.None => { return false }
        _ => { return true }
    }
}

fn instantiateCanonicalPlace(c: inout Comp, placeId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if placeId == 0U64 || placeId > c.mid.places.count() { return 0U64 }
    val source: MidPlaceNode = c.mid.places[placeId - 1U64]
    val projectionStart: U64 = c.mid.projections.count()
    mut val i: U64 = 0U64
    while i < source.projections.len {
        val projection: MidProjectionNode = c.mid.projections[source.projections.start + i]
        c.mid.projections.append(<MidProjectionNode tag=projection.tag index=projection.index indexLocal=projection.indexLocal typeTerm=c.groundTermForBody(ref: projection.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        i = i + 1U64
    }
    c.mid.places.append(<MidPlaceNode local=source.local projections=<MidRange start=projectionStart len=source.projections.len /> typeTerm=c.groundTermForBody(ref: source.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
    return c.mid.places.count()
}

fn instantiateCanonicalOperand(c: inout Comp, operandId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
    val source: MidOperandNode = c.mid.operands[operandId - 1U64]
    mut val place: U64 = 0U64
    if source.place != 0U64 { place = instantiateCanonicalPlace(c: inout c, placeId: source.place, environment: environment, itemRef: itemRef) }
    c.mid.operands.append(<MidOperandNode tag=source.tag place=place capability=source.capability integerValue=source.integerValue integerNegative=source.integerNegative integerBool=source.integerBool stringStart=source.stringStart stringLen=source.stringLen typeTerm=c.groundTermForBody(ref: source.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) accessCandidate=source.accessCandidate />)
    return c.mid.operands.count()
}

// Ground the canonical rvalue forms whose semantics are already closed in
// their row. Return/aggregate/cast and enum-match boundaries are deliberately
// handled below their own frontend-proof readers rather than being treated as
// this case.
fn instantiateCanonicalClosedRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, itemRef: U64) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    match source.tag {
        1U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=1U64 operand=instantiateCanonicalOperand(c: inout c, operandId: source.operand, environment: environment, itemRef: itemRef) />)
        }
        6U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=6U64 operand=instantiateCanonicalOperand(c: inout c, operandId: source.operand, environment: environment, itemRef: itemRef) conversion=source.conversion />)
        }
        8U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=8U64 operand=instantiateCanonicalOperand(c: inout c, operandId: source.operand, environment: environment, itemRef: itemRef) kindTag=source.kindTag targetTerm=c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        }
        9U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=9U64 operand=instantiateCanonicalOperand(c: inout c, operandId: source.operand, environment: environment, itemRef: itemRef) kindTag=source.kindTag targetTerm=c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        }
        10U64 => {
            c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=instantiateCanonicalOperand(c: inout c, operandId: source.operand, environment: environment, itemRef: itemRef) targetTerm=c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />)
        }
        _ => { return 0U64 }
    }
    return c.mid.rvalues.count()
}

fn canonicalMidOperandTypeRef(c: Comp, operandId: U64) -> U64 {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return 0U64 }
    val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
    if operand.tag >= 1U64 && operand.tag <= 4U64 {
        if operand.place == 0U64 || operand.place > c.mid.places.count() { return 0U64 }
        return c.mid.places[operand.place - 1U64].typeTerm
    }
    if operand.tag >= 5U64 && operand.tag <= 7U64 { return operand.typeTerm }
    return 0U64
}

fn instantiateCanonicalReturnBoundary(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    if source.tag != 2U64 { return 0U64 }
    val operand: U64 = instantiateCanonicalOperand(c: inout c, operandId: source.operand, environment: environment, itemRef: itemRef)
    val resolutionIndex: U64 = c.finalReturnIndex(bodyId: bodyId, exprId: source.exprId)
    if resolutionIndex >= c.arena.finalReturns.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingReturnResolution /> }
        return 0U64
    }
    val resolution: FinalReturnResolution = c.arena.finalReturns[resolutionIndex]
    val expectedTarget: U64 = c.groundTermForBody(ref: source.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if !(c.typeRefEq(a: resolution.targetTypeRef, b: expectedTarget)) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
        return 0U64
    }
    val conversion: U64 = c.freezeValueConversionProof(proof: resolution.conversion)
    if c.conversionProofIsIdentity(id: conversion) {
        if !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: resolution.targetTypeRef)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
            return 0U64
        }
        c.mid.rvalues.append(<MidRvalueNode tag=2U64 operand=operand exprId=source.exprId targetTerm=resolution.targetTypeRef />)
        return c.mid.rvalues.count()
    }
    if c.conversionProofIsMissing(id: conversion) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
        return 0U64
    }
    if !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: midConversionSourceRef(c: c, conversion: conversion))) || !(c.typeRefEq(a: resolution.targetTypeRef, b: midConversionTargetRef(c: c, conversion: conversion))) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
        return 0U64
    }
    c.mid.rvalues.append(<MidRvalueNode tag=6U64 operand=operand conversion=conversion />)
    return c.mid.rvalues.count()
}

fn instantiateCanonicalAggregate(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    if source.tag < 3U64 || source.tag > 5U64 { return 0U64 }
    val resolutionIndex: U64 = c.finalAggregateIndex(bodyId: bodyId, exprId: source.exprId)
    if resolutionIndex >= c.arena.finalAggregates.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
        return 0U64
    }
    val resolution: FinalAggregateResolution = c.arena.finalAggregates[resolutionIndex]
    if source.elements.len != resolution.elementTargetRefs.count() || source.elements.len != resolution.elementConversions.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    val start: U64 = c.mid.aggregateElements.count()
    mut val i: U64 = 0U64
    while i < source.elements.len {
        val element = c.mid.aggregateElements[source.elements.start + i]
        val operand: U64 = instantiateCanonicalOperand(c: inout c, operandId: element.operand, environment: environment, itemRef: itemRef)
        val targetTerm: U64 = resolution.elementTargetRefs[i]
        val conversion: U64 = c.freezeValueConversionProof(proof: resolution.elementConversions[i])
        if operand == 0U64 || targetTerm == 0U64 || conversion == 0U64 {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
        if c.conversionProofIsIdentity(id: conversion) && !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: targetTerm)) {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
        c.mid.aggregateElements.append(<MidAggregateElementNode fieldIndex=element.fieldIndex operand=operand targetTerm=targetTerm isBoxed=element.isBoxed conversion=conversion />)
        i = i + 1U64
    }
    c.mid.rvalues.append(<MidRvalueNode tag=source.tag exprId=source.exprId enumIndex=source.enumIndex variantIndex=source.variantIndex resultTerm=resolution.resultTypeRef fieldCount=source.fieldCount elements=<MidRange start=start len=source.elements.len /> />)
    return c.mid.rvalues.count()
}

fn instantiateCanonicalCastBoundary(c: inout Comp, rvalueId: U64, environment: BodyInstance, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val sourceNode = c.mid.rvalues[rvalueId - 1U64]
    if sourceNode.tag != 7U64 { return 0U64 }
    val operand: U64 = instantiateCanonicalOperand(c: inout c, operandId: sourceNode.operand, environment: environment, itemRef: itemRef)
    val sourceRef: U64 = c.groundTermForBody(ref: sourceNode.sourceTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    val targetRef: U64 = c.groundTermForBody(ref: sourceNode.targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if operand == 0U64 || sourceRef == 0U64 || targetRef == 0U64 || sourceRef >= c.arena.types.count() || targetRef >= c.arena.types.count() || !(c.typeRefEq(a: canonicalMidOperandTypeRef(c: c, operandId: operand), b: sourceRef)) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
        return 0U64
    }
    val source: TypeRef = c.arena.types[sourceRef]
    val target: TypeRef = c.arena.types[targetRef]
    val sourceUnderlying: U64 = c.newtypeUnderRef(start: source.nameStart, len: source.nameLen)
    val targetUnderlying: U64 = c.newtypeUnderRef(start: target.nameStart, len: target.nameLen)
    if sourceUnderlying != 0U64 && c.typeRefEq(a: sourceUnderlying, b: targetRef) {
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=targetRef />)
        return c.mid.rvalues.count()
    }
    if targetUnderlying != 0U64 && c.typeRefEq(a: sourceRef, b: targetUnderlying) {
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=targetRef />)
        return c.mid.rvalues.count()
    }
    if c.isIntType(start: source.nameStart, len: source.nameLen) {
        val signed: Bool = c.intSigned(start: source.nameStart, len: source.nameLen)
        if c.isIntType(start: target.nameStart, len: target.nameLen) {
            if c.losslessInt(srcStart: source.nameStart, srcLen: source.nameLen, dstStart: target.nameStart, dstLen: target.nameLen) {
                if signed { c.mid.rvalues.append(<MidRvalueNode tag=8U64 operand=operand kindTag=1U64 targetTerm=targetRef />) }
                else { c.mid.rvalues.append(<MidRvalueNode tag=8U64 operand=operand kindTag=2U64 targetTerm=targetRef />) }
                return c.mid.rvalues.count()
            }
        }
        if c.isFloatType(start: target.nameStart, len: target.nameLen) {
            if signed { c.mid.rvalues.append(<MidRvalueNode tag=9U64 operand=operand kindTag=1U64 targetTerm=targetRef />) }
            else { c.mid.rvalues.append(<MidRvalueNode tag=9U64 operand=operand kindTag=2U64 targetTerm=targetRef />) }
            return c.mid.rvalues.count()
        }
    }
    if c.isFloatType(start: source.nameStart, len: source.nameLen) && c.isFloatType(start: target.nameStart, len: target.nameLen) {
        c.mid.rvalues.append(<MidRvalueNode tag=10U64 operand=operand targetTerm=targetRef />)
        return c.mid.rvalues.count()
    }
    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
    return 0U64
}

fn instantiateCanonicalEnumMatchRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val source = c.mid.rvalues[rvalueId - 1U64]
    if source.tag < 11U64 || source.tag > 15U64 || source.place == 0U64 || source.place > c.mid.places.count() { return 0U64 }
    val sourcePlace = c.mid.places[source.place - 1U64]
    val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, stmtId: source.sourceStmt)
    if matchIndex >= c.arena.finalMatches.count() {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
        return 0U64
    }
    val resolution = c.arena.finalMatches[matchIndex]
    val scrutineeType: U64 = c.groundTermForBody(ref: sourcePlace.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if resolution.enumIndex != source.enumIndex || !(c.typeRefEq(a: resolution.scrutineeTypeRef, b: scrutineeType)) {
        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
        return 0U64
    }
    val resultTerm: U64 = c.groundTermForBody(ref: source.resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
    if source.tag != 11U64 {
        mut val found: Bool = false
        mut val armI: U64 = 0U64
        while armI < resolution.arms.count() {
            val arm = resolution.arms[armI]
            if arm.hasVariant && arm.variantIndex == source.variantIndex {
                mut val payloadI: U64 = 0U64
                while payloadI < arm.payloads.count() {
                    val payload = arm.payloads[payloadI]
                    if payload.bindTarget == source.bindTarget && payload.fieldIndex == source.fieldIndex && c.typeRefEq(a: payload.fieldTypeRef, b: resultTerm) { found = true }
                    payloadI = payloadI + 1U64
                }
            }
            armI = armI + 1U64
        }
        if !found {
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
            return 0U64
        }
    }
    val place: U64 = instantiateCanonicalPlace(c: inout c, placeId: source.place, environment: environment, itemRef: itemRef)
    c.mid.rvalues.append(<MidRvalueNode tag=source.tag place=place enumIndex=source.enumIndex variantIndex=source.variantIndex fieldIndex=source.fieldIndex bindTarget=source.bindTarget sourceStmt=source.sourceStmt resultTerm=resultTerm />)
    return c.mid.rvalues.count()
}

fn instantiateCanonicalRvalue(c: inout Comp, rvalueId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> U64 {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return 0U64 }
    val tag: U64 = c.mid.rvalues[rvalueId - 1U64].tag
    match tag {
        1U64 => { return instantiateCanonicalClosedRvalue(c: inout c, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        2U64 => { return instantiateCanonicalReturnBoundary(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        3U64 => { return instantiateCanonicalAggregate(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        4U64 => { return instantiateCanonicalAggregate(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        5U64 => { return instantiateCanonicalAggregate(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        6U64 => { return instantiateCanonicalClosedRvalue(c: inout c, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        7U64 => { return instantiateCanonicalCastBoundary(c: inout c, rvalueId: rvalueId, environment: environment, itemRef: itemRef, error: inout error) }
        8U64 => { return instantiateCanonicalClosedRvalue(c: inout c, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        9U64 => { return instantiateCanonicalClosedRvalue(c: inout c, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        10U64 => { return instantiateCanonicalClosedRvalue(c: inout c, rvalueId: rvalueId, environment: environment, itemRef: itemRef) }
        11U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        12U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        13U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        14U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        15U64 => { return instantiateCanonicalEnumMatchRvalue(c: inout c, rvalueId: rvalueId, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) }
        _ => { return 0U64 }
    }
}

fn instantiateCanonicalStatement(c: inout Comp, statementId: U64, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> Bool {
    if statementId == 0U64 || statementId > c.mid.statements.count() { return false }
    val source = c.mid.statements[statementId - 1U64]
    match source.tag {
        1U64 => {
            val destination: U64 = instantiateCanonicalPlace(c: inout c, placeId: source.destination, environment: environment, itemRef: itemRef)
            val value: U64 = instantiateCanonicalRvalue(c: inout c, rvalueId: source.value, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            if destination == 0U64 || value == 0U64 { return false }
            c.mid.statements.append(<MidStatementNode tag=1U64 destination=destination value=value />)
        }
        2U64 => { c.mid.statements.append(<MidStatementNode tag=2U64 destination=instantiateCanonicalPlace(c: inout c, placeId: source.destination, environment: environment, itemRef: itemRef) source=instantiateCanonicalPlace(c: inout c, placeId: source.source, environment: environment, itemRef: itemRef) />) }
        3U64 => { c.mid.statements.append(<MidStatementNode tag=3U64 destination=instantiateCanonicalPlace(c: inout c, placeId: source.destination, environment: environment, itemRef: itemRef) />) }
        4U64 => { c.mid.statements.append(<MidStatementNode tag=4U64 destination=instantiateCanonicalPlace(c: inout c, placeId: source.destination, environment: environment, itemRef: itemRef) flag=source.flag />) }
        5U64 => { c.mid.statements.append(<MidStatementNode tag=5U64 flag=source.flag isSet=source.isSet />) }
        6U64 => { c.mid.statements.append(<MidStatementNode tag=6U64 scope=source.scope />) }
        7U64 => { c.mid.statements.append(<MidStatementNode tag=7U64 />) }
        _ => { return false }
    }
    return true
}

// Call is intentionally excluded until its selected passing/conversion proof
// is emitted with its continuation cleanup. Every other terminator has a
// closed scalar payload and can be grounded without a draft reconstruction.
fn instantiateCanonicalNonCallTerminator(c: inout Comp, terminatorId: U64, environment: BodyInstance, itemRef: U64) -> Bool {
    if terminatorId == 0U64 || terminatorId > c.mid.terminators.count() { return false }
    val source = c.mid.terminators[terminatorId - 1U64]
    match source.tag {
        1U64 => { c.mid.terminators.append(<MidTerminatorNode tag=1U64 />) }
        2U64 => { c.mid.terminators.append(<MidTerminatorNode tag=2U64 target=source.target />) }
        3U64 => {
            val caseStart: U64 = c.mid.switchCases.count()
            mut val i: U64 = 0U64
            while i < source.cases.len {
                c.mid.switchCases.append(c.mid.switchCases[source.cases.start + i])
                i = i + 1U64
            }
            c.mid.terminators.append(<MidTerminatorNode tag=3U64 discriminant=instantiateCanonicalOperand(c: inout c, operandId: source.discriminant, environment: environment, itemRef: itemRef) cases=<MidRange start=caseStart len=source.cases.len /> otherwise=source.otherwise />)
        }
        5U64 => { c.mid.terminators.append(<MidTerminatorNode tag=5U64 />) }
        6U64 => { c.mid.terminators.append(<MidTerminatorNode tag=6U64 value=instantiateCanonicalOperand(c: inout c, operandId: source.value, environment: environment, itemRef: itemRef) />) }
        7U64 => { c.mid.terminators.append(<MidTerminatorNode tag=7U64 value=instantiateCanonicalOperand(c: inout c, operandId: source.value, environment: environment, itemRef: itemRef) />) }
        8U64 => { c.mid.terminators.append(<MidTerminatorNode tag=8U64 />) }
        9U64 => { c.mid.terminators.append(<MidTerminatorNode tag=9U64 />) }
        10U64 => { c.mid.terminators.append(<MidTerminatorNode tag=10U64 state=source.state resume=source.resume />) }
        _ => { return false }
    }
    return true
}

fn midReceiverPassingMatches(callee: Func, passing: CallReceiverPassing) -> Bool {
    if !(callee.hasRecv) {
        match passing { CallReceiverPassing.None => { return true } _ => { return false } }
    }
    if callee.selfInout { match passing { CallReceiverPassing.Inout => { return true } _ => { return false } } }
    if callee.selfMove { match passing { CallReceiverPassing.Move => { return true } _ => { return false } } }
    match passing { CallReceiverPassing.Borrow => { return true } _ => { return false } }
}

fn midArgumentPassingMatches(parameter: Param, passing: CallArgumentPassing) -> Bool {
    if parameter.isInout { match passing { CallArgumentPassing.Inout => { return true } _ => { return false } } }
    if parameter.isMove { match passing { CallArgumentPassing.Move => { return true } _ => { return false } } }
    match passing { CallArgumentPassing.Borrow => { return true } _ => { return false } }
}

fn midApplyReceiverPassing(receiver: MidCallReceiver, passing: CallReceiverPassing) -> MidCallReceiver {
    match passing {
        CallReceiverPassing.None => { return <MidCallReceiver.None /> }
        CallReceiverPassing.Borrow => {
            match receiver {
                MidCallReceiver.Value(operand: val operand) => {
                    match operand {
                        MidOperand.Copy(place: val place) => { return <MidCallReceiver.Value operand=<MidOperand.Borrow place=place capability=<MidBorrowCapability.Read /> /> /> }
                        _ => { return receiver }
                    }
                }
                _ => { return receiver }
            }
        }
        _ => { return receiver }
    }
}

fn midApplyArgumentPassing(operand: MidOperand, passing: CallArgumentPassing) -> MidOperand {
    match passing {
        CallArgumentPassing.Borrow => {
            match operand {
                MidOperand.Copy(place: val place) => { return <MidOperand.Borrow place=place capability=<MidBorrowCapability.Read /> /> }
                _ => { return operand }
            }
        }
        _ => { return operand }
    }
}

// `CallSiteKey` is the semantic identity of a template occurrence.  ExprId is
// intentionally absent: it is only a navigation anchor in CallResolution.
fn midFinalResolution(c: Comp, bodyId: U64, site: CallSiteKey) -> U64 {
    mut val i: U64 = 0U64
    while i < c.arena.finalCallees.count() {
        val candidate: CallResolution = c.arena.finalCallees[i]
        if candidate.bodyId == bodyId && c.sameCallSiteKey(a: candidate.siteKey, b: site) {
            return i + 1U64
        }
        i += 1U64
    }
    return 0U64
}

fn instantiateMidProjection(c: inout Comp, projection: MidProjection, environment: BodyInstance, itemRef: U64) -> MidProjection {
    match projection {
        MidProjection.Field(index: val index, typeTerm: val typeTerm) => {
            return <MidProjection.Field index=index typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidProjection.Index(indexLocal: val indexLocal, typeTerm: val typeTerm) => {
            return <MidProjection.Index indexLocal=indexLocal typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
    }
}

fn instantiateMidPlace(c: inout Comp, place: MidPlace, environment: BodyInstance, itemRef: U64) -> MidPlace {
    mut val projections: Array[MidProjection] = []
    mut val i: U64 = 0U64
    while i < place.projections.count() {
        projections.append(instantiateMidProjection(c: inout c, projection: place.projections[i], environment: environment, itemRef: itemRef))
        i += 1U64
    }
    return <MidPlace local=place.local projections=projections typeTerm=c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
}

fn instantiateMidOperand(c: inout Comp, operand: MidOperand, environment: BodyInstance, itemRef: U64) -> MidOperand {
    match operand {
        MidOperand.Copy(place: val place) => { return <MidOperand.Copy place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) /> }
        MidOperand.Move(place: val place) => { return <MidOperand.Move place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) /> }
        MidOperand.Borrow(place: val place, capability: val capability) => { return <MidOperand.Borrow place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) capability=capability /> }
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: val integer, isNegative: val isNegative, isBool: val isBool, typeTerm: val typeTerm) => {
                    return <MidOperand.Constant value=<MidConstant.Integer value=integer isNegative=isNegative isBool=isBool typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) /> />
                }
                MidConstant.StringLiteral(start: val start, len: val len, typeTerm: val typeTerm) => {
                    return <MidOperand.Constant value=<MidConstant.StringLiteral start=start len=len typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) /> />
                }
                MidConstant.FloatLiteral(start: val start, len: val len, typeTerm: val typeTerm) => {
                    return <MidOperand.Constant value=<MidConstant.FloatLiteral start=start len=len typeTerm=c.groundTermForBody(ref: typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) /> />
                }
            }
        }
        MidOperand.Access(candidate: val candidate) => { return <MidOperand.Access candidate=candidate /> }
    }
}

fn instantiateMidRvalue(c: inout Comp, value: MidRvalue, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> MidRvalue {
    match value {
        MidRvalue.Use(operand: val operand) => { return <MidRvalue.Use operand=instantiateMidOperand(c: inout c, operand: operand, environment: environment, itemRef: itemRef) /> }
        MidRvalue.ReturnBoundary(exprId: val exprId, targetTerm: val targetTerm, operand: val rawOperand) => {
            val operand: MidOperand = instantiateMidOperand(c: inout c, operand: rawOperand, environment: environment, itemRef: itemRef)
            val resolutionIndex: U64 = c.finalReturnIndex(bodyId: bodyId, exprId: exprId)
            if resolutionIndex >= c.arena.finalReturns.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingReturnResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val resolution: FinalReturnResolution = c.arena.finalReturns[resolutionIndex]
            val expectedTarget: U64 = c.groundTermForBody(ref: targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if !(c.typeRefEq(a: resolution.targetTypeRef, b: expectedTarget)) {
                if c.traceCodegen {
                    eprint(text: "[trace-codegen] Mid return target mismatch expected=")
                    c.traceMonoTypeHead(ref: expectedTarget)
                    eprint(text: " final=")
                    c.traceMonoTypeHead(ref: resolution.targetTypeRef)
                    eprint(text: "\n")
                }
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val conversion: U64 = c.freezeValueConversionProof(proof: resolution.conversion)
            if c.conversionProofIsIdentity(id: conversion) {
                    if !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: resolution.targetTypeRef)) { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> } }
                    // Keep an identity return boundary explicit. Structural
                    // TypeRef equality is not LLVM nominal-layout equality;
                    // the ABI target must remain available when freezing the
                    // return local and emitting its store.
                    return <MidRvalue.ReturnBoundary exprId=exprId targetTerm=resolution.targetTypeRef operand=operand />
            } else if c.conversionProofIsMissing(id: conversion) {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
                return <MidRvalue.Use operand=operand />
            } else {
                if !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: midConversionSourceRef(c: c, conversion: conversion))) || !(c.typeRefEq(a: resolution.targetTypeRef, b: midConversionTargetRef(c: c, conversion: conversion))) {
                    if c.traceCodegen {
                        eprint(text: "[trace-codegen] Mid return conversion mismatch operand=")
                        c.traceMonoTypeHead(ref: midOperandTypeRef(operand: operand))
                        eprint(text: " proof-source=")
                        c.traceMonoTypeHead(ref: midConversionSourceRef(c: c, conversion: conversion))
                        eprint(text: " target=")
                        c.traceMonoTypeHead(ref: resolution.targetTypeRef)
                        eprint(text: " proof-target=")
                        c.traceMonoTypeHead(ref: midConversionTargetRef(c: c, conversion: conversion))
                        eprint(text: "\n")
                    }
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidReturnResolution /> }
                    return <MidRvalue.Use operand=operand />
                }
                return <MidRvalue.Convert operand=operand conversion=conversion />
            }
        }
        MidRvalue.Aggregate(exprId: val exprId, kind: val kind, resultTerm: val resultTerm, fieldCount: val fieldCount, elements: val elements) => {
            mut val instantiated: Array[MidAggregateElement] = []
            val resolutionIndex: U64 = c.finalAggregateIndex(bodyId: bodyId, exprId: exprId)
            val hasResolution: Bool = resolutionIndex < c.arena.finalAggregates.count()
            mut val resultRef: U64 = c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if hasResolution {
                val resolution: FinalAggregateResolution = c.arena.finalAggregates[resolutionIndex]
                resultRef = resolution.resultTypeRef
            } else {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            }
            mut val i: U64 = 0U64
            while i < elements.count() {
                val element: MidAggregateElement = elements[i]
                val operand: MidOperand = instantiateMidOperand(c: inout c, operand: element.operand, environment: environment, itemRef: itemRef)
                mut val targetTerm: U64 = 0U64
                mut val conversion: U64 = 0U64
                if hasResolution {
                    val resolution: FinalAggregateResolution = c.arena.finalAggregates[resolutionIndex]
                    if i < resolution.elementTargetRefs.count() && i < resolution.elementConversions.count() {
                        targetTerm = resolution.elementTargetRefs[i]
                        conversion = c.freezeValueConversionProof(proof: resolution.elementConversions[i])
                        // An identity proof is a concrete frontend claim about
                        // this exact BodyInstance. Validate it while freezing
                        // the Mid body; LLVM must only consume the resulting
                        // checked slot contract, never rediscover it from
                        // operand/type metadata during preflight.
                        if c.conversionProofIsIdentity(id: conversion) && !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: targetTerm)) {
                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                        }
                    } else {
                        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                    }
                }
                instantiated.append(<MidAggregateElement fieldIndex=element.fieldIndex operand=operand targetTerm=targetTerm isBoxed=element.isBoxed conversion=conversion />)
                i += 1U64
            }
            return <MidRvalue.Aggregate exprId=exprId kind=kind resultTerm=resultRef fieldCount=fieldCount elements=instantiated />
        }
        MidRvalue.Convert(operand: val operand, conversion: val conversion) => {
            return <MidRvalue.Convert operand=instantiateMidOperand(c: inout c, operand: operand, environment: environment, itemRef: itemRef) conversion=conversion />
        }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: val sourceTerm, targetTerm: val targetTerm, operand: val rawOperand) => {
            val operand: MidOperand = instantiateMidOperand(c: inout c, operand: rawOperand, environment: environment, itemRef: itemRef)
            val sourceRef: U64 = c.groundTermForBody(ref: sourceTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            val targetRef: U64 = c.groundTermForBody(ref: targetTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if sourceRef == 0U64 || targetRef == 0U64 || sourceRef >= c.arena.types.count() || targetRef >= c.arena.types.count() || !(c.typeRefEq(a: midOperandTypeRef(operand: operand), b: sourceRef)) {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
                return <MidRvalue.Use operand=operand />
            }
            val source: TypeRef = c.arena.types[sourceRef]
            val target: TypeRef = c.arena.types[targetRef]
            // Newtype wrap/unwrap is the spec's explicit zero-cost exception.
            // It is closed by the selected nominal types, rather than a backend
            // check of the authored cast spelling.
            val sourceUnderlying: U64 = c.newtypeUnderRef(start: source.nameStart, len: source.nameLen)
            val targetUnderlying: U64 = c.newtypeUnderRef(start: target.nameStart, len: target.nameLen)
            if sourceUnderlying != 0U64 && c.typeRefEq(a: sourceUnderlying, b: targetRef) {
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=targetRef />
            }
            if targetUnderlying != 0U64 && c.typeRefEq(a: sourceRef, b: targetUnderlying) {
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=targetRef />
            }
            if c.isIntType(start: source.nameStart, len: source.nameLen) {
                val sourceSigned: Bool = c.intSigned(start: source.nameStart, len: source.nameLen)
                if c.isIntType(start: target.nameStart, len: target.nameLen) {
                    if !(c.losslessInt(srcStart: source.nameStart, srcLen: source.nameLen, dstStart: target.nameStart, dstLen: target.nameLen)) {
                        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
                        return <MidRvalue.Use operand=operand />
                    }
                    return <MidRvalue.Cast operand=operand kind=<MidCastKind.IntegerWiden sourceSigned=sourceSigned /> targetTerm=targetRef />
                }
                if c.isFloatType(start: target.nameStart, len: target.nameLen) {
                    return <MidRvalue.Cast operand=operand kind=<MidCastKind.IntegerToFloat sourceSigned=sourceSigned /> targetTerm=targetRef />
                }
            }
            if c.isFloatType(start: source.nameStart, len: source.nameLen) && c.isFloatType(start: target.nameStart, len: target.nameLen) {
                return <MidRvalue.Cast operand=operand kind=<MidCastKind.IdentityRetag /> targetTerm=targetRef />
            }
            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidCastResolution /> }
            return <MidRvalue.Use operand=operand />
        }
        MidRvalue.Cast(operand: val operand, kind: val kind, targetTerm: val targetTerm) => {
            return <MidRvalue.Cast operand=instantiateMidOperand(c: inout c, operand: operand, environment: environment, itemRef: itemRef) kind=kind targetTerm=targetTerm />
        }
        MidRvalue.EnumTag(place: val place, enumIndex: val enumIndex, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, stmtId: sourceStmt)
            if matchIndex >= c.arena.finalMatches.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            } else {
                val resolution = c.arena.finalMatches[matchIndex]
                if resolution.enumIndex != enumIndex || !(c.typeRefEq(a: resolution.scrutineeTypeRef, b: c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
            }
            return <MidRvalue.EnumTag place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) enumIndex=enumIndex sourceStmt=sourceStmt resultTerm=c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) />
        }
        MidRvalue.EnumPayloadCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, stmtId: sourceStmt)
            val groundedResult: U64 = c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if matchIndex >= c.arena.finalMatches.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            } else {
                val resolution = c.arena.finalMatches[matchIndex]
                if resolution.enumIndex != enumIndex || !(c.typeRefEq(a: resolution.scrutineeTypeRef, b: c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                } else {
                    mut val arm: U64 = 0U64
                    mut val found: Bool = false
                    while arm < resolution.arms.count() {
                        val current = resolution.arms[arm]
                        if current.hasVariant && current.variantIndex == variantIndex {
                            mut val payload: U64 = 0U64
                            while payload < current.payloads.count() {
                                val selected = current.payloads[payload]
                                if selected.bindTarget == bindTarget && selected.fieldIndex == fieldIndex && c.typeRefEq(a: selected.fieldTypeRef, b: groundedResult) { found = true }
                                payload += 1U64
                            }
                        }
                        arm += 1U64
                    }
                    if !found && !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
            }
            return <MidRvalue.EnumPayloadCopy place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=groundedResult />
        }
        MidRvalue.EnumPayloadBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            val matchIndex: U64 = c.finalMatchIndex(bodyId: bodyId, stmtId: sourceStmt)
            val groundedResult: U64 = c.groundTermForBody(ref: resultTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef)
            if matchIndex >= c.arena.finalMatches.count() {
                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingFinalResolution /> }
            } else {
                val resolution = c.arena.finalMatches[matchIndex]
                if resolution.enumIndex != enumIndex || !(c.typeRefEq(a: resolution.scrutineeTypeRef, b: c.groundTermForBody(ref: place.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef))) {
                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                } else {
                    mut val arm: U64 = 0U64
                    mut val found: Bool = false
                    while arm < resolution.arms.count() {
                        val current = resolution.arms[arm]
                        if current.hasVariant && current.variantIndex == variantIndex {
                            mut val payload: U64 = 0U64
                            while payload < current.payloads.count() {
                                val selected = current.payloads[payload]
                                if selected.bindTarget == bindTarget && selected.fieldIndex == fieldIndex && c.typeRefEq(a: selected.fieldTypeRef, b: groundedResult) { found = true }
                                payload += 1U64
                            }
                        }
                        arm += 1U64
                    }
                    if !found && !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidFinalResolution /> }
                }
            }
            return <MidRvalue.EnumPayloadBorrow place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=groundedResult />
        }
        // Boxed payload reads have identical declaration identity and logical
        // type requirements. Delegate their grounding/validation to the
        // ordinary variants, then preserve only the physical cell-read opcode.
        MidRvalue.EnumPayloadBoxedCopy(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            val checked: MidRvalue = instantiateMidRvalue(c: inout c, value: <MidRvalue.EnumPayloadCopy place=place enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=resultTerm />, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            match checked {
                MidRvalue.EnumPayloadCopy(place: val groundedPlace, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: val groundedResult) => {
                    return <MidRvalue.EnumPayloadBoxedCopy place=groundedPlace enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=groundedResult />
                }
                _ => { return checked }
            }
        }
        MidRvalue.EnumPayloadBoxedBorrow(place: val place, enumIndex: val enumIndex, variantIndex: val variantIndex, fieldIndex: val fieldIndex, bindTarget: val bindTarget, sourceStmt: val sourceStmt, resultTerm: val resultTerm) => {
            val checked: MidRvalue = instantiateMidRvalue(c: inout c, value: <MidRvalue.EnumPayloadBorrow place=place enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=resultTerm />, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            match checked {
                MidRvalue.EnumPayloadBorrow(place: val groundedPlace, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: val groundedResult) => {
                    return <MidRvalue.EnumPayloadBoxedBorrow place=groundedPlace enumIndex=enumIndex variantIndex=variantIndex fieldIndex=fieldIndex bindTarget=bindTarget sourceStmt=sourceStmt resultTerm=groundedResult />
                }
                _ => { return checked }
            }
        }
    }
}

fn instantiateMidCallReceiver(c: inout Comp, receiver: MidCallReceiver, environment: BodyInstance, itemRef: U64) -> MidCallReceiver {
    match receiver {
        MidCallReceiver.None => { return <MidCallReceiver.None /> }
        MidCallReceiver.Value(operand: val operand) => { return <MidCallReceiver.Value operand=instantiateMidOperand(c: inout c, operand: operand, environment: environment, itemRef: itemRef) /> }
    }
}

fn instantiateMidStatement(c: inout Comp, statement: MidStatement, environment: BodyInstance, bodyId: U64, itemRef: U64, error: inout MidInstantiateError) -> MidStatement {
    match statement {
        MidStatement.Assign(destination: val destination, value: val value) => {
            return <MidStatement.Assign destination=instantiateMidPlace(c: inout c, place: destination, environment: environment, itemRef: itemRef) value=instantiateMidRvalue(c: inout c, value: value, environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error) />
        }
        MidStatement.Overwrite(destination: val destination, source: val source) => {
            return <MidStatement.Overwrite destination=instantiateMidPlace(c: inout c, place: destination, environment: environment, itemRef: itemRef) source=instantiateMidPlace(c: inout c, place: source, environment: environment, itemRef: itemRef) />
        }
        MidStatement.Drop(place: val place) => { return <MidStatement.Drop place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) /> }
        MidStatement.ConditionalDrop(place: val place, flag: val flag) => { return <MidStatement.ConditionalDrop place=instantiateMidPlace(c: inout c, place: place, environment: environment, itemRef: itemRef) flag=flag /> }
        MidStatement.SetDropFlag(local: val local, isSet: val isSet) => { return <MidStatement.SetDropFlag local=local isSet=isSet /> }
        MidStatement.ScopeExit(scope: val scope) => { return <MidStatement.ScopeExit scope=scope /> }
        MidStatement.Nop => { return <MidStatement.Nop /> }
    }
}

// 0 means no descriptor exists.  The caller reports that as a phase-boundary
// failure instead of falling back to a name/arity lookup.
fn instantiateMidCallTarget(c: Comp, target: MidCallTarget, bodyId: U64) -> MidCallTarget {
    match target {
        MidCallTarget.Resolved(resolution: val resolution) => { return <MidCallTarget.Resolved resolution=resolution /> }
        MidCallTarget.Template(site: val site) => {
            val resolution: U64 = midFinalResolution(c: c, bodyId: bodyId, site: site)
            if resolution == 0U64 { return <MidCallTarget.Template site=site /> }
            return <MidCallTarget.Resolved resolution=resolution - 1U64 />
        }
    }
}

fn instantiateMidTerminator(c: inout Comp, term: MidTerminator, environment: BodyInstance, bodyId: U64, itemRef: U64) -> MidTerminator {
    match term {
        MidTerminator.Open => { return <MidTerminator.Open /> }
        MidTerminator.Goto(target: val target) => { return <MidTerminator.Goto target=target /> }
        MidTerminator.Switch(discriminant: val discriminant, values: val values, targets: val targets, otherwise: val otherwise) => {
            return <MidTerminator.Switch discriminant=instantiateMidOperand(c: inout c, operand: discriminant, environment: environment, itemRef: itemRef) values=values targets=targets otherwise=otherwise />
        }
        MidTerminator.Call(callee: val callee, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
            mut val instantiatedArgs: Array[MidOperand] = []
            mut val i: U64 = 0U64
            while i < args.count() {
                instantiatedArgs.append(instantiateMidOperand(c: inout c, operand: args[i], environment: environment, itemRef: itemRef))
                i += 1U64
            }
            return <MidTerminator.Call callee=instantiateMidCallTarget(c: c, target: callee, bodyId: bodyId) receiver=instantiateMidCallReceiver(c: inout c, receiver: receiver, environment: environment, itemRef: itemRef) args=instantiatedArgs destination=instantiateMidPlace(c: inout c, place: destination, environment: environment, itemRef: itemRef) target=target />
        }
        MidTerminator.Return => { return <MidTerminator.Return /> }
        MidTerminator.ReturnValue(value: val value) => { return <MidTerminator.ReturnValue value=instantiateMidOperand(c: inout c, operand: value, environment: environment, itemRef: itemRef) /> }
        MidTerminator.Panic(message: val message) => { return <MidTerminator.Panic message=instantiateMidOperand(c: inout c, operand: message, environment: environment, itemRef: itemRef) /> }
        MidTerminator.Unreachable => { return <MidTerminator.Unreachable /> }
        MidTerminator.Abort => { return <MidTerminator.Abort /> }
        MidTerminator.Suspend(state: val state, resume: val resume) => { return <MidTerminator.Suspend state=state resume=resume /> }
    }
}

// The source builder records a parametric call operand, while the frozen
// CallResolution owns the ABI conversion chosen for it.  This helper reads no
// syntax: it merely exposes the already-ground operand term so instantiation
// can check that the proof and the Mid operand still describe the same value.
fn midOperandTypeRef(operand: MidOperand) -> U64 {
    match operand {
        MidOperand.Copy(place: val place) => { return place.typeTerm }
        MidOperand.Move(place: val place) => { return place.typeTerm }
        MidOperand.Borrow(place: val place, capability: _) => { return place.typeTerm }
        MidOperand.Constant(value: val value) => {
            match value {
                MidConstant.Integer(value: _, isNegative: _, isBool: _, typeTerm: val typeTerm) => { return typeTerm }
                MidConstant.StringLiteral(start: _, len: _, typeTerm: val typeTerm) => { return typeTerm }
                MidConstant.FloatLiteral(start: _, len: _, typeTerm: val typeTerm) => { return typeTerm }
            }
        }
        MidOperand.Access(candidate: _) => { return 0U64 }
    }
}

fn midConversionSourceRef(c: Comp, conversion: U64) -> U64 {
    if conversion == 0U64 || conversion > c.arena.conversionProofs.count() { return 0U64 }
    return c.arena.conversionProofs[conversion - 1U64].sourceRef
}

fn midConversionTargetRef(c: Comp, conversion: U64) -> U64 {
    if conversion == 0U64 || conversion > c.arena.conversionProofs.count() { return 0U64 }
    return c.arena.conversionProofs[conversion - 1U64].targetRef
}

// An instantiated rvalue carries the concrete type of the value it produces.
// A root Mid local is the owned home for that value, so its declaration must
// be frozen from this fact before LLVM allocates the local.  This is an IR
// typing rule, not inference: Aggregate/Convert/ReturnBoundary already obtain
// their result type solely from frontend-finalized resolutions.
fn midRvalueResultType(c: Comp, value: MidRvalue) -> U64 {
    match value {
        MidRvalue.Use(operand: val operand) => { return midOperandTypeRef(operand: operand) }
        MidRvalue.ReturnBoundary(exprId: _, targetTerm: val targetTerm, operand: _) => { return targetTerm }
        MidRvalue.Aggregate(exprId: _, kind: _, resultTerm: val resultTerm, fieldCount: _, elements: _) => { return resultTerm }
        MidRvalue.Convert(operand: _, conversion: val conversion) => {
            if c.conversionProofIsIdentity(id: conversion) { return 0U64 }
            return midConversionTargetRef(c: c, conversion: conversion)
        }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: val targetTerm, operand: _) => { return targetTerm }
        MidRvalue.Cast(operand: _, kind: _, targetTerm: val targetTerm) => { return targetTerm }
        MidRvalue.EnumTag(place: _, enumIndex: _, sourceStmt: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadBoxedCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: val resultTerm) => { return resultTerm }
        MidRvalue.EnumPayloadBoxedBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: val resultTerm) => { return resultTerm }
    }
}

fn midWithTypeTerm(local: MidLocalDecl, typeTerm: U64) -> MidLocalDecl {
    return <MidLocalDecl typeTerm=typeTerm sourceScope=local.sourceScope isUnique=local.isUnique isParameter=local.isParameter isBorrowed=local.isBorrowed isInout=local.isInout ownsAtEntry=local.ownsAtEntry isDropFlag=local.isDropFlag isReturnPlace=local.isReturnPlace sourceNameStart=local.sourceNameStart />
}

// Ground a parametric Mid body exactly once for one frontend BodyInstance.
// A remaining Template is an internal frontend/Mid phase error: the final
// callable freeze must have published every descriptor before this point.
export fn instantiateMidBody(c: inout Comp, body: MidBody, bodyId: U64) -> MidInstantiation {
    if bodyId == 0U64 || bodyId > c.arena.bodyInstances.count() {
        return <MidInstantiation body=body error=<MidInstantiateError.InvalidBodyInstance /> />
    }
    val environment: BodyInstance = c.arena.bodyInstances[bodyId - 1U64]
    if environment.fnIdx >= c.arena.funcs.count() {
        return <MidInstantiation body=body error=<MidInstantiateError.InvalidBodyInstance /> />
    }
    val f: Func = c.arena.funcs[environment.fnIdx]
    val itemRef: U64 = c.bodyProvidedItemTerm(f: f, environment: environment.environment)
    mut val locals: Array[MidLocalDecl] = []
    mut val localI: U64 = 0U64
    while localI < body.locals.count() {
        val local: MidLocalDecl = body.locals[localI]
        locals.append(<MidLocalDecl typeTerm=c.groundTermForBody(ref: local.typeTerm, environment: environment.environment, selfRef: environment.environment.receiverRef, itemRef: itemRef) sourceScope=local.sourceScope isUnique=local.isUnique isParameter=local.isParameter isBorrowed=local.isBorrowed isInout=local.isInout ownsAtEntry=local.ownsAtEntry isDropFlag=local.isDropFlag isReturnPlace=local.isReturnPlace sourceNameStart=local.sourceNameStart />)
        localI += 1U64
    }
    mut val blocks: Array[MidBlock] = []
    // A conversion temporary has statement-end lifetime.  Give every call its
    // own continuation rather than prepending drops to the source continuation:
    // source targets may have multiple predecessors, while this generated block
    // has exactly the call as its predecessor.
    mut val cleanupBlocks: Array[MidBlock] = []
    mut val blockI: U64 = 0U64
    mut val error: MidInstantiateError = <MidInstantiateError.None />
    while blockI < body.blocks.count() {
        val block: MidBlock = body.blocks[blockI]
        mut val statements: Array[MidStatement] = []
        mut val statementI: U64 = 0U64
        while statementI < block.statements.count() {
            mut val statement: MidStatement = instantiateMidStatement(c: inout c, statement: block.statements[statementI], environment: environment, bodyId: bodyId, itemRef: itemRef, error: inout error)
            // The parametric builder gives a temporary the source aggregate's
            // TypeTerm.  Final aggregate/return resolution can make that term
            // concrete (for example `(first:T, second:T)` -> String fields).
            // Freeze the root owned home from the instantiated rvalue before
            // any subsequent operand or LLVM allocation observes it.
            match statement {
                MidStatement.Assign(destination: val destination, value: val value) => {
                    if destination.projections.count() == 0U64 && destination.local < locals.count() {
                        val resultType: U64 = midRvalueResultType(c: c, value: value)
                        if resultType != 0U64 {
                            val declaration: MidLocalDecl = locals[destination.local]
                            if declaration.isParameter {
                                if declaration.typeTerm != resultType { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.InvalidLocalResultType /> } }
                            } else {
                                locals.set(i: destination.local, value: midWithTypeTerm(local: declaration, typeTerm: resultType))
                                statement = <MidStatement.Assign destination=<MidPlace local=destination.local projections=destination.projections typeTerm=resultType /> value=value />
                            }
                        }
                    }
                }
                _ => {}
            }
            statements.append(statement)
            statementI += 1U64
        }
        mut val terminator: MidTerminator = instantiateMidTerminator(c: inout c, term: block.terminator, environment: environment, bodyId: bodyId, itemRef: itemRef)
    match terminator {
            MidTerminator.Call(callee: val callee, receiver: val receiver, args: val rawArgs, destination: val destination, target: val target) => {
                match callee {
                    MidCallTarget.Template(site: _) => { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.MissingCallResolution /> } }
                    MidCallTarget.Resolved(resolution: val resolution) => {
                        if resolution >= c.arena.finalCallees.count() {
                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionIndex /> }
                        } else {
                            val selected: CallResolution = c.arena.finalCallees[resolution]
                            val conversions: Array[U64] = c.copyFinalCalleeConversions(conversions: selected.argumentConversions)
                            val parameterTypes: Array[U64] = c.copyFinalCalleeParameterTypes(types: selected.parameterTypeRefs)
                            val argumentPassings: Array[CallArgumentPassing] = c.copyFinalCalleeArgumentPassings(passings: selected.argumentPassings)
                            if selected.callee >= c.arena.funcs.count() || conversions.count() != rawArgs.count() || parameterTypes.count() != rawArgs.count() || argumentPassings.count() != rawArgs.count() {
                                if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionArity /> }
                            } else {
                                val calleeDef: Func = c.arena.funcs[selected.callee]
                                if calleeDef.params.count() != rawArgs.count() {
                                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionArity /> }
                                } else if !(midReceiverPassingMatches(callee: calleeDef, passing: selected.receiverPassing)) {
                                    if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionPassing /> }
                                } else {
                                mut val args: Array[MidOperand] = rawArgs
                                val guaranteedReceiver: MidCallReceiver = midApplyReceiverPassing(receiver: receiver, passing: selected.receiverPassing)
                                mut val cleanup: Array[MidStatement] = []
                                mut val argumentI: U64 = 0U64
                                while argumentI < args.count() {
                                    val conversion: U64 = conversions[argumentI]
                                    val passing: CallArgumentPassing = argumentPassings[argumentI]
                                    if !(midArgumentPassingMatches(parameter: c.funcParamAt(params: calleeDef.params, index: argumentI), passing: passing)) {
                                        if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionPassing /> }
                                    }
                                    if !(c.conversionProofIsIdentity(id: conversion)) {
                                        match passing {
                                            CallArgumentPassing.Borrow => {}
                                            _ => { if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallResolutionPassing /> } }
                                        }
                                        val sourceRef: U64 = midConversionSourceRef(c: c, conversion: conversion)
                                        val targetRef: U64 = midConversionTargetRef(c: c, conversion: conversion)
                                        if sourceRef == 0U64 || !(c.typeRefEq(a: midOperandTypeRef(operand: args[argumentI]), b: sourceRef)) {
                                            if c.traceCodegen {
                                                eprint(text: "[trace-codegen] Mid call conversion source mismatch body=")
                                                eprintU64(n: bodyId)
                                                eprint(text: " call=")
                                                eprintU64(n: resolution)
                                                eprint(text: " expr=")
                                                eprintU64(n: selected.exprId)
                                                eprint(text: " argument=")
                                                eprintU64(n: argumentI)
                                                eprint(text: " operand-term=")
                                                eprintU64(n: midOperandTypeRef(operand: args[argumentI]))
                                                eprint(text: " source-term=")
                                                eprintU64(n: sourceRef)
                                                eprint(text: " operand=")
                                                c.traceMonoTypeHead(ref: midOperandTypeRef(operand: args[argumentI]))
                                                eprint(text: " proof-source=")
                                                c.traceMonoTypeHead(ref: sourceRef)
                                                eprint(text: "\n")
                                            }
                                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallConversionSource /> }
                                        } else if targetRef == 0U64 || !(c.typeRefEq(a: parameterTypes[argumentI], b: targetRef)) {
                                            if !midInstantiateHasError(error: error) { error = <MidInstantiateError.CallConversionTarget /> }
                                        } else {
                                            val temporary: U64 = locals.count()
                                            locals.append(<MidLocalDecl typeTerm=targetRef sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false isDropFlag=false isReturnPlace=false sourceNameStart=0U64 />)
                                            val temporaryPlace: MidPlace = <MidPlace local=temporary typeTerm=targetRef />
                                            statements.append(<MidStatement.Assign destination=temporaryPlace value=<MidRvalue.Convert operand=args[argumentI] conversion=conversion /> />)
                                            args.set(i: argumentI, value: <MidOperand.Copy place=temporaryPlace />)
                                            cleanup.append(<MidStatement.Drop place=temporaryPlace />)
                                        }
                                    }
                                    args.set(i: argumentI, value: midApplyArgumentPassing(operand: args[argumentI], passing: passing))
                                    argumentI += 1U64
                                }
                                if cleanup.count() > 0U64 {
                                    val cleanupTarget: U64 = body.blocks.count() + cleanupBlocks.count()
                                    cleanupBlocks.append(<MidBlock statements=cleanup terminator=<MidTerminator.Goto target=target /> />)
                                    terminator = <MidTerminator.Call callee=callee receiver=guaranteedReceiver args=args destination=destination target=cleanupTarget />
                                } else {
                                    terminator = <MidTerminator.Call callee=callee receiver=guaranteedReceiver args=args destination=destination target=target />
                                }
                                }
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        blocks.append(<MidBlock statements=statements terminator=terminator />)
        blockI += 1U64
    }
    mut val cleanupI: U64 = 0U64
    while cleanupI < cleanupBlocks.count() {
        blocks.append(cleanupBlocks[cleanupI])
        cleanupI += 1U64
    }
    val instantiated: MidBody = <MidBody bodyInstance=bodyId sourceFunction=body.sourceFunction locals=locals scopes=body.scopes blocks=blocks entry=body.entry />
    if midInstantiateHasError(error: error) { return <MidInstantiation body=instantiated error=error /> }
    return <MidInstantiation body=instantiated />
}
