// Structural and ownership verification for Mid IR. This consumes only Mid
// dataflow, never source AST or LLVM state. Every backend entry calls it before lowering executable canonical bodies.

import ../Frontend with { Comp }
import ../Ir with { MatchSource, SemanticMatchKind }
import ./Ir with { canonicalMidPlaceIsWhole, MidBodyNode, MidBlockNode, MidPlaceNode, MidProjectionNode, MidOperandNode, MidRvalueNode, MidClosureCaptureNode, MidStatementNode, MidTerminatorNode, MidCanonicalBody, MidBody, MidOwnership }
import ./Types with { canonicalMidStatementTypesMatch, canonicalMidTerminatorTypesMatch }
import ./Drop with { analyzeCanonicalMidOwnership }

export enum MidVerifyError {
    None
    InvalidTarget
    TypeMismatch
    PartialMove
    MoveUnavailable
    DropUnavailable
    MissingOwnershipContract
    OutstandingOwnership
    LiveInitialization
    InvalidDropFlag
    UninitializedDropFlag
    UnelaboratedScopeExit
    UnelaboratedBindingEnd
    UnelaboratedAccess
    UninstantiatedReturnBoundary
    UninstantiatedStorageBoundary
    UninstantiatedCastBoundary
}

export struct MidVerification {
    pub val error: MidVerifyError = <MidVerifyError.None />
    pub val block: U64 = 0U64
    pub val local: U64 = 0U64
}
pub impl MidVerification { factory }

// A global root is a typed address selected by the frontend.  It is not an
// implicit local: only Copy/Borrow may read it, and the sole write protocol is
// a mutable Global Drop immediately followed by Overwrite.  The ownership
// vector intentionally has no entry for it.
fn canonicalMidGlobalRootIsValid(c: Comp, place: MidPlaceNode) -> Bool {
    if place.rootTag != 2U64 { return false }
    if place.typeTerm == 0U64 { return false }
    mut val index: U64 = 0U64
    while index < c.arena.globals.count() {
        val global = c.arena.globals[index]
        if global.nameStart == place.globalTarget { return global.mutable == place.globalMutable }
        index += 1U64
    }
    return false
}

// Caller-owned parameters/captures are guaranteed by the enclosing call.
// Every other local read requires a live owner, including Copy and projections.
fn canonicalMidVerifyRead(c: Comp, body: MidBodyNode, states: Array[MidOwnership], placeId: U64, block: U64) -> MidVerification {
    if placeId == 0U64 || placeId > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val place = c.mid.places[placeId - 1U64]
    if place.rootTag == 2U64 {
        if !canonicalMidGlobalRootIsValid(c: c, place: place) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=block /> }
    } else {
        if place.rootTag != 1U64 || place.local >= body.locals.len || place.local >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
        val local = c.mid.locals[body.locals.start + place.local]
        if !local.isBorrowed && !(local.isParameter && !local.ownsAtEntry && !local.isInout) {
            match states[place.local] { MidOwnership.Owned => {} _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> } }
        }
    }
    mut val index = 0U64
    while index < place.projections.len {
        val projection = c.mid.projections[place.projections.start + index]
        if projection.tag == 2U64 {
            if projection.indexLocal >= body.locals.len || projection.indexLocal >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
            val local = c.mid.locals[body.locals.start + projection.indexLocal]
            if !local.isBorrowed && !(local.isParameter && !local.ownsAtEntry) {
                match states[projection.indexLocal] { MidOwnership.Owned => {} _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=projection.indexLocal /> } }
            }
        }
        index += 1U64
    }
    return <MidVerification />
}

fn canonicalMidVerifyConsumeOperand(c: inout Comp, body: MidBodyNode, states: inout Array[MidOwnership], operandId: U64, block: U64, executable: Bool) -> MidVerification {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
    if operand.tag == 8U64 { return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block /> }
    if executable && operand.tag == 1U64 {
        if operand.place == 0U64 || operand.place > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
        val source = c.mid.places[operand.place - 1U64]
        if !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: source.typeTerm) {
            return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=block local=source.local />
        }
    }
    if operand.place != 0U64 && operand.place <= c.mid.places.count() {
        val place = c.mid.places[operand.place - 1U64]
        mut val currentTerm = 0U64
        if place.rootTag == 1U64 && place.local < body.locals.len { currentTerm = c.mid.locals[body.locals.start + place.local].typeTerm }
        mut val index = 0U64
        while index < place.projections.len {
            val projection = c.mid.projections[place.projections.start + index]
            if projection.tag == 4U64 {
                if body.bodyInstance == 0U64 || body.bodyInstance > c.arena.bodyInstanceCount() || c.arena.bodyInstanceAt(index: body.bodyInstance - 1U64).adapterTargetBodyId == 0U64 || projection.sourceTerm != currentTerm || projection.typeTerm == 0U64 {
                    return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block local=place.local />
                }
            }
            currentTerm = projection.typeTerm
            index += 1U64
        }
    }

    if operand.accessPlace != 0U64 {
        if operand.tag != 4U64 || operand.capability != 2U64 || operand.accessPlace > c.mid.places.count() { return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block /> }
        val storage: MidPlaceNode = c.mid.places[operand.accessPlace - 1U64]
        if storage.projections.start > c.mid.projections.count() || storage.projections.len > c.mid.projections.count() - storage.projections.start { return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block /> }
        if storage.rootTag == 1U64 {
            if storage.local >= body.locals.len || storage.local >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=storage.local /> }
            val local = c.mid.locals[body.locals.start + storage.local]
            if !local.isBorrowed && !local.isInout {
                match states[storage.local] {
                    MidOwnership.Owned => {}
                    _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=storage.local /> }
                }
            }
        } else if !canonicalMidGlobalRootIsValid(c: c, place: storage) { return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block /> }
    }
    if operand.tag == 3U64 {
        if operand.capability != 1U64 || operand.place == 0U64 || operand.place > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
        val borrowed = c.mid.places[operand.place - 1U64]
        if borrowed.rootTag == 1U64 {
            if borrowed.local >= body.locals.len || borrowed.local >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=borrowed.local /> }
            val local = c.mid.locals[body.locals.start + borrowed.local]
            // A guaranteed parameter/capture is owned by its caller. An owned
            // unique local, including a borrowed computed value, must still
            // be alive here; borrowing does not revive a consumed owner.
            if local.isUnique && !local.isBorrowed && !local.isInout && !(local.isParameter && !local.ownsAtEntry) {
                match states[borrowed.local] {
                    MidOwnership.Owned => {}
                    _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=borrowed.local /> }
                }
            }
        }
    }
    if operand.tag >= 1U64 && operand.tag <= 4U64 {
        val read = canonicalMidVerifyRead(c: c, body: body, states: states, placeId: operand.place, block: block)
        match read.error { MidVerifyError.None => {} _ => { return read } }
    }
    if operand.tag != 2U64 { return <MidVerification /> }
    if operand.place == 0U64 || operand.place > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
    if place.rootTag != 1U64 { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
    if place.local < body.locals.len && c.mid.locals[body.locals.start + place.local].isInout { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
    if !canonicalMidPlaceIsWhole(arena: c.mid, place: place) { return <MidVerification error=<MidVerifyError.PartialMove /> block=block local=place.local /> }
    if place.local >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
    match states[place.local] {
        MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
        _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
    }
    return <MidVerification />
}

fn canonicalMidVerifyConsumeRvalue(c: inout Comp, body: MidBodyNode, states: inout Array[MidOwnership], rvalueId: U64, block: U64, isGrounded: Bool, executable: Bool) -> MidVerification {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    if value.place != 0U64 {
        val read = canonicalMidVerifyRead(c: c, body: body, states: states, placeId: value.place, block: block)
        match read.error { MidVerifyError.None => {} _ => { return read } }
    }
    if executable && value.tag == 6U64 && !canonicalMidConversionContractsAreReady(c: inout c, proofId: value.conversion) {
        return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=block />
    }
    // These operations obtain an owned payload without a Copy operand.
    if executable && (value.tag == 12U64 || value.tag == 14U64 || value.tag == 17U64) {
        if !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: value.resultTerm) {
            return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=block />
        }
    }
    if value.tag == 2U64 && (!isGrounded || value.targetTerm == 0U64) { return <MidVerification error=<MidVerifyError.UninstantiatedReturnBoundary /> block=block /> }
    if value.tag == 20U64 { return <MidVerification error=<MidVerifyError.UninstantiatedStorageBoundary /> block=block /> }
    if value.tag == 7U64 || value.tag == 23U64 { return <MidVerification error=<MidVerifyError.UninstantiatedCastBoundary /> block=block /> }
    if (value.tag == 8U64 || value.tag == 9U64 || value.tag == 10U64) && (!isGrounded || value.targetTerm == 0U64) { return <MidVerification error=<MidVerifyError.UninstantiatedCastBoundary /> block=block /> }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            val conversion = c.mid.aggregateElements[value.elements.start + elementI].conversion
            if executable && !c.conversionProofIsIdentity(id: conversion) && !canonicalMidConversionContractsAreReady(c: inout c, proofId: conversion) {
                return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=block />
            }
            val verified: MidVerification = canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: c.mid.aggregateElements[value.elements.start + elementI].operand, block: block, executable: executable)
            match verified.error { MidVerifyError.None => {} _ => { return verified } }
            elementI = elementI + 1U64
        }
        return <MidVerification />
    }
    if value.tag == 19U64 {
        if !isGrounded || value.resultTerm == 0U64 || value.elements.start > c.mid.closureCaptures.count() || value.elements.len > c.mid.closureCaptures.count() - value.elements.start { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
        mut val captureI: U64 = 0U64
        while captureI < value.elements.len {
            val capture: MidClosureCaptureNode = c.mid.closureCaptures[value.elements.start + captureI]
            if (capture.mode != 1U64 && capture.mode != 2U64) || capture.typeTerm == 0U64 { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
            val verified: MidVerification = canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: capture.operand, block: block, executable: executable)
            match verified.error { MidVerifyError.None => {} _ => { return verified } }
            captureI += 1U64
        }
        return <MidVerification />
    }
    if value.operand != 0U64 { return canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: value.operand, block: block, executable: executable) }
    return <MidVerification />
}

fn canonicalMidTargetIsValid(body: MidBodyNode, target: U64) -> Bool {
    return target < body.blocks.len
}


// Field and dereference paths denote physical storage. Dereferencing a
// MutableRef permits replacement of its pointee; Ref never grants this
// capability. Index paths still require the semantic writeback elaborator.
fn canonicalMidWritablePhysicalPath(c: Comp, body: MidBodyNode, place: MidPlaceNode) -> Bool {
    mut val currentTerm: U64 = 0U64
    if place.rootTag == 1U64 && place.local < body.locals.len { currentTerm = c.mid.locals[body.locals.start + place.local].typeTerm }
    mut val projectionI: U64 = 0U64
    while projectionI < place.projections.len {
        val projection: MidProjectionNode = c.mid.projections[place.projections.start + projectionI]
        if projection.tag == 3U64 {
            if !c.isMutableRefInst(ref: currentTerm) { return false }
        } else if projection.tag != 1U64 && projection.tag != 4U64 { return false }
        currentTerm = projection.typeTerm
        projectionI += 1U64
    }
    return true
}

fn canonicalMidPlaceHasDeref(c: Comp, place: MidPlaceNode) -> Bool {
    mut val index: U64 = 0U64
    while index < place.projections.len {
        if c.mid.projections[place.projections.start + index].tag == 3U64 { return true }
        index += 1U64
    }
    return false
}

// Freeze deliberately stores each occurrence of a draft Place as a fresh row,
// so an explicit Drop and its following Overwrite do not share a place ID.
// Compare the closed rows instead of relying on arena identity.  This stays in
// the canonical verifier: draft Mid is intentionally pre-drop-elaboration and
// therefore cannot yet require the compiler-generated Drop.
fn canonicalMidSamePlace(c: Comp, leftId: U64, rightId: U64) -> Bool {
    if leftId == 0U64 || rightId == 0U64 || leftId > c.mid.places.count() || rightId > c.mid.places.count() { return false }
    val left: MidPlaceNode = c.mid.places[leftId - 1U64]
    val right: MidPlaceNode = c.mid.places[rightId - 1U64]
    if left.rootTag != right.rootTag || left.local != right.local || left.globalTarget != right.globalTarget || left.globalMutable != right.globalMutable || left.typeTerm != right.typeTerm || left.projections.len != right.projections.len { return false }
    mut val projectionI: U64 = 0U64
    while projectionI < left.projections.len {
        val leftProjection: MidProjectionNode = c.mid.projections[left.projections.start + projectionI]
        val rightProjection: MidProjectionNode = c.mid.projections[right.projections.start + projectionI]
        if leftProjection.sourceTerm != rightProjection.sourceTerm || leftProjection.tag != rightProjection.tag || leftProjection.index != rightProjection.index || leftProjection.indexLocal != rightProjection.indexLocal || leftProjection.typeTerm != rightProjection.typeTerm || leftProjection.isBoxed != rightProjection.isBoxed { return false }
        projectionI = projectionI + 1U64
    }
    return true
}

fn verifyCanonicalMidFlagInitialization(c: Comp, canonical: MidCanonicalBody) -> MidVerification {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val flags: Array[U64] = []
    mut val local: U64 = 0U64
    while local < body.locals.len {
        if c.mid.locals[body.locals.start + local].isDropFlag { flags.append(local) }
        local = local + 1U64
    }
    if body.entry >= body.blocks.len { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    mut val incoming: Array[Array[Bool]] = []
    mut val reachable: Array[Bool] = []
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val empty: Array[Bool] = []
        mut val flagI: U64 = 0U64
        while flagI < flags.count() {
            empty.append(false)
            flagI = flagI + 1U64
        }
        incoming.append(empty)
        reachable.append(blockI == body.entry)
        blockI = blockI + 1U64
    }
    mut val changed: Bool = true
    while changed {
        changed = false
        blockI = 0U64
        while blockI < body.blocks.len {
            if reachable[blockI] {
                mut val outgoing: Array[Bool] = incoming[blockI]
                val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
                mut val statementI: U64 = 0U64
                while statementI < block.statements.len {
                    val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                    if statement.tag == 5U64 {
                        if statement.flag >= body.locals.len || !c.mid.locals[body.locals.start + statement.flag].isDropFlag { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockI local=statement.flag /> }
                        mut val flagI: U64 = 0U64
                        while flagI < flags.count() {
                            if flags[flagI] == statement.flag { outgoing.set(i: flagI, value: true) }
                            flagI = flagI + 1U64
                        }
                    }
                    statementI = statementI + 1U64
                }
                if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
                    val term = c.mid.terminators[block.terminator - 1U64]
                    mut val successorI: U64 = 0U64
                    while successorI < term.successorCount() {
                        val target: U64 = c.mid.successorAt(term: term, index: successorI)
                        if !canonicalMidTargetIsValid(body: body, target: target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
                        if !reachable[target] {
                            incoming.set(i: target, value: outgoing)
                            reachable.set(i: target, value: true)
                            changed = true
                        } else {
                            mut val merged: Array[Bool] = incoming[target]
                            mut val flagI: U64 = 0U64
                            while flagI < flags.count() {
                                if merged[flagI] && !outgoing[flagI] {
                                    merged.set(i: flagI, value: false)
                                    changed = true
                                }
                                flagI = flagI + 1U64
                            }
                            incoming.set(i: target, value: merged)
                        }
                        successorI = successorI + 1U64
                    }
                }
            }
            blockI = blockI + 1U64
        }
    }
    blockI = 0U64
    while blockI < body.blocks.len {
        if reachable[blockI] {
            mut val initialized: Array[Bool] = incoming[blockI]
            val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
            mut val statementI: U64 = 0U64
            while statementI < block.statements.len {
                val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                if statement.tag == 5U64 {
                    mut val flagI: U64 = 0U64
                    while flagI < flags.count() {
                        if flags[flagI] == statement.flag { initialized.set(i: flagI, value: true) }
                        flagI = flagI + 1U64
                    }
                }
                if statement.tag == 4U64 {
                    if statement.flag >= body.locals.len || !c.mid.locals[body.locals.start + statement.flag].isDropFlag { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockI local=statement.flag /> }
                    mut val flagI: U64 = 0U64
                    while flagI < flags.count() {
                        if flags[flagI] == statement.flag && !initialized[flagI] { return <MidVerification error=<MidVerifyError.UninitializedDropFlag /> block=blockI local=statement.flag /> }
                        flagI = flagI + 1U64
                    }
                }
                statementI = statementI + 1U64
            }
        }
        blockI = blockI + 1U64
    }
    return <MidVerification />
}

// Verify the elaborated frozen CFG directly.  This mirrors the draft verifier
// intentionally at the ownership boundary, but every read is a canonical row
// or range; the production path can therefore discard MidBody after freeze.
// TypeRef allocation IDs are not type identity: use the frontend semantic
// equality query for transferred values, retaining nominal/view distinctions.
fn verifyCanonicalEnumDestructure(c: inout Comp, body: MidBodyNode, statement: MidStatementNode, states: inout Array[MidOwnership], block: U64, executable: Bool) -> MidVerification {
    val invalid = <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block />
    if statement.source == 0U64 || statement.source > c.mid.places.count() || statement.sourceTag > 1U64 || statement.enumDestinations.start > c.mid.enumDestinations.count() || statement.enumDestinations.len > c.mid.enumDestinations.count() - statement.enumDestinations.start { return invalid }
    val source = c.mid.places[statement.source - 1U64]
    if source.rootTag != 1U64 || source.projections.len != 0U64 || source.local >= states.count() || source.local >= body.locals.len { return invalid }
    val owner = c.mid.locals[body.locals.start + source.local]
    if owner.isBorrowed || owner.isInout || owner.isCaptureCell || !c.typeRefEq(a: owner.typeTerm, b: source.typeTerm) { return invalid }
    match states[source.local] { MidOwnership.Owned => {} _ => { return invalid } }
    mut val key: MatchSource = <MatchSource.Statement stmtId=statement.sourceStmt />
    if statement.sourceTag == 1U64 { key = <MatchSource.Expression exprId=statement.sourceStmt /> }
    val factIndex = c.finalMatchIndex(bodyId: body.bodyInstance, matchSource: key)
    if factIndex >= c.arena.finalMatches.count() { return invalid }
    val fact = c.arena.finalMatches[factIndex]
    if !fact.isConsuming || !c.typeRefEq(a: fact.scrutineeTypeRef, b: source.typeTerm) { return invalid }
    match fact.kind { SemanticMatchKind.Enum(enumIndex: val selected) => { if selected != statement.enumIndex { return invalid } } _ => { return invalid } }
    mut val armIndex: U64 = 0U64
    while armIndex < fact.armCount {
        val arm = c.arena.finalMatchArms[fact.armStart + armIndex]
        if arm.hasVariant && arm.variantIndex == statement.variantIndex { break }
        armIndex += 1U64
    }
    if armIndex == fact.armCount { return invalid }
    val arm = c.arena.finalMatchArms[fact.armStart + armIndex]
    if arm.payloadCount != statement.enumDestinations.len { return invalid }
    mut val index: U64 = 0U64
    while index < statement.enumDestinations.len {
        val entry = c.mid.enumDestinations[statement.enumDestinations.start + index]
        if entry.place == 0U64 || entry.place > c.mid.places.count() { return invalid }
        val destination = c.mid.places[entry.place - 1U64]
        if destination.rootTag != 1U64 || destination.projections.len != 0U64 || destination.local >= states.count() || destination.local >= body.locals.len || destination.local == source.local { return invalid }
        val local = c.mid.locals[body.locals.start + destination.local]
        if local.isBorrowed || local.isInout || local.isCaptureCell || !c.typeRefEq(a: local.typeTerm, b: destination.typeTerm) { return invalid }
        match states[destination.local] { MidOwnership.Consumed => {} _ => { return invalid } }
        val field = c.arena.finalMatchPayloads[arm.payloadStart + index]
        if field.fieldIndex != index || field.isDiscard != entry.isDiscard || field.isBoxed != entry.isBoxed || field.bindTarget != entry.bindTarget || !c.typeRefEq(a: field.fieldTypeRef, b: destination.typeTerm) { return invalid }
        // A shared physical cell must copy its payload even though the
        // enclosing enum owner is consumed by this operation.
        if executable && entry.isBoxed && !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: destination.typeTerm) {
            return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=block local=destination.local />
        }
        mut val previous: U64 = 0U64
        while previous < index {
            val prior = c.mid.enumDestinations[statement.enumDestinations.start + previous]
            if c.mid.places[prior.place - 1U64].local == destination.local { return invalid }
            previous += 1U64
        }
        index += 1U64
    }
    states.set(i: source.local, value: <MidOwnership.Consumed />)
    index = 0U64
    while index < statement.enumDestinations.len {
        val entry = c.mid.enumDestinations[statement.enumDestinations.start + index]
        states.set(i: c.mid.places[entry.place - 1U64].local, value: <MidOwnership.Owned />)
        index += 1U64
    }
    return <MidVerification />
}

// Executable admission and earlier structural verification share one walk.
export fn verifyExecutableCanonicalMidBody(c: inout Comp, canonical: MidCanonicalBody) -> MidVerification {
    return verifyCanonicalMidBodyStage(c: inout c, canonical: canonical, executable: true)
}

export fn verifyCanonicalMidBody(c: inout Comp, canonical: MidCanonicalBody) -> MidVerification {
    return verifyCanonicalMidBodyStage(c: inout c, canonical: canonical, executable: false)
}

fn canonicalMidOwnershipContractIsReady(c: inout Comp, typeTerm: U64) -> Bool {
    if typeTerm == 0U64 { return true }
    val contract = c.finalDestructionIndex(typeRef: typeTerm)
    if contract == 0U64 || !c.arena.finalDestructions[contract - 1U64].ready { return false }
    val call = c.arena.finalDestructions[contract - 1U64].deinitCall
    return call.bodyId == 0U64 || call.ready
}

// Structural repacks borrow each source element and obtain a fresh owned
// destination, including identity leaves. These copies have no Mid operand.
// Freeze publishes children before parents, so every edge must point backward;
// malformed cycles are rejected without recursive searches of semantic types.
fn canonicalMidConversionContractsAreReady(c: inout Comp, proofId: U64) -> Bool {
    if proofId == 0U64 || proofId > c.arena.conversionProofs.count() { return false }
    val proof = c.arena.conversionProofs[proofId - 1U64]
    if proof.tag == 0U64 { return true }
    if proof.tag < 2U64 || proof.tag > 4U64 || proof.sourceRef == 0U64 || proof.targetRef == 0U64 { return false }
    if !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: proof.sourceRef) || !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: proof.targetRef) { return false }
    if proof.tag == 2U64 { return true }
    if proof.tag == 3U64 {
        val source = c.arena.typeAt(index: proof.sourceRef)
        val target = c.arena.typeAt(index: proof.targetRef)
        if source.args.count() != 1U64 || target.args.count() != 1U64 || proof.element >= proofId { return false }
        if !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: source.args[0U64]) || !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: target.args[0U64]) { return false }
        return canonicalMidConversionContractsAreReady(c: inout c, proofId: proof.element)
    }
    if proof.payloads > c.arena.conversionPayloadPool.count() || proof.payloadCount > c.arena.conversionPayloadPool.count() - proof.payloads { return false }
    mut val index = 0U64
    while index < proof.payloadCount {
        val payload = c.arena.conversionPayloadPool[proof.payloads + index]
        if payload.conversion >= proofId || !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: payload.sourceRef) || !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: payload.targetRef) { return false }
        if !canonicalMidConversionContractsAreReady(c: inout c, proofId: payload.conversion) { return false }
        index += 1U64
    }
    return true
}

// Enumerate reachable blocks once; dead code carries no runtime obligation.
fn canonicalMidReachable(c: Comp, body: MidBodyNode) -> Array[Bool] {
    mut val reached: Array[Bool] = []
    mut val index = 0U64
    while index < body.blocks.len { reached.append(false)
        index += 1U64 }
    mut val queue: Array[U64] = [body.entry]
    reached.set(i: body.entry, value: true)
    index = 0U64
    while index < queue.count() {
        val block = c.mid.blocks[body.blocks.start + queue[index]]
        val term = c.mid.terminators[block.terminator - 1U64]
        mut val edge: U64 = 0U64
        while edge < term.successorCount() {
            val target = c.mid.successorAt(term: term, index: edge)
            edge += 1U64
            if target < reached.count() && !reached[target] { reached.set(i: target, value: true)
                queue.append(target) }
        }
        index += 1U64
    }
    return reached
}

fn canonicalMidFlagPlace(c: Comp, placeId: U64, owner: U64) -> Bool {
    if placeId == 0U64 || placeId > c.mid.places.count() { return false }
    val place = c.mid.places[placeId - 1U64]
    return place.rootTag == 1U64 && place.local == owner && canonicalMidPlaceIsWhole(arena: c.mid, place: place)
}

fn canonicalMidFlagOperand(c: Comp, operandId: U64, owner: U64, state: U64) -> U64 {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return state }
    val operand = c.mid.operands[operandId - 1U64]
    if operand.tag == 2U64 && canonicalMidFlagPlace(c: c, placeId: operand.place, owner: owner) { return state % 2U64 }
    return state
}

fn canonicalMidFlagRvalue(c: Comp, valueId: U64, owner: U64, state: U64) -> U64 {
    if valueId == 0U64 || valueId > c.mid.rvalues.count() { return state }
    val value = c.mid.rvalues[valueId - 1U64]
    mut val result = canonicalMidFlagOperand(c: c, operandId: value.operand, owner: owner, state: state)
    mut val index = 0U64
    if value.tag >= 3U64 && value.tag <= 5U64 {
        while index < value.elements.len {
            result = canonicalMidFlagOperand(c: c, operandId: c.mid.aggregateElements[value.elements.start + index].operand, owner: owner, state: result)
            index += 1U64
        }
    } else if value.tag == 19U64 {
        while index < value.elements.len {
            result = canonicalMidFlagOperand(c: c, operandId: c.mid.closureCaptures[value.elements.start + index].operand, owner: owner, state: result)
            index += 1U64
        }
    }
    return result
}

// For each flag, explore the four joint states (consumed/owned, false/true).
// Joining these pairs, rather than separate may-owned and may-true facts,
// preserves their correlation through diamonds and loops. Each block/pair is
// visited at most once. Flag initialization is checked independently above.
fn verifyCanonicalMidFlagOwnership(c: Comp, body: MidBodyNode) -> MidVerification {
    mut val owners: Array[U64] = []
    mut val index = 0U64
    while index < body.locals.len { owners.append(body.locals.len)
        index += 1U64 }
    mut val blockIndex = 0U64
    while blockIndex < body.blocks.len {
        val block = c.mid.blocks[body.blocks.start + blockIndex]
        index = 0U64
        while index < block.statements.len {
            val statement = c.mid.statements[block.statements.start + index]
            if statement.tag == 4U64 {
                if statement.flag >= owners.count() || statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockIndex /> }
                val owner = c.mid.places[statement.destination - 1U64].local
                if owners[statement.flag] != body.locals.len && owners[statement.flag] != owner { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockIndex local=statement.flag /> }
                owners.set(i: statement.flag, value: owner)
            }
            index += 1U64
        }
        blockIndex += 1U64
    }
    mut val flag = 0U64
    while flag < owners.count() {
        val owner = owners[flag]
        if owner == body.locals.len { flag += 1U64
            continue }
        mut val initial = 0U64
        if c.mid.locals[body.locals.start + owner].ownsAtEntry { initial = 2U64 }
        mut val visited: Array[Bool] = []
        index = 0U64
        while index < body.blocks.len * 4U64 { visited.append(false)
            index += 1U64 }
        mut val queue: Array[U64] = [body.entry * 4U64 + initial, body.entry * 4U64 + initial + 1U64]
        visited.set(i: queue[0U64], value: true)
        visited.set(i: queue[1U64], value: true)
        mut val next = 0U64
        while next < queue.count() {
            blockIndex = queue[next] / 4U64
            mut val state = queue[next] % 4U64
            next += 1U64
            val block = c.mid.blocks[body.blocks.start + blockIndex]
            index = 0U64
            while index < block.statements.len {
                val statement = c.mid.statements[block.statements.start + index]
                if statement.tag == 5U64 && statement.flag == flag {
                    state = (state / 2U64) * 2U64
                    if statement.isSet { state += 1U64 }
                } else if statement.tag == 1U64 || statement.tag == 9U64 {
                    state = canonicalMidFlagRvalue(c: c, valueId: statement.value, owner: owner, state: state)
                    if canonicalMidFlagPlace(c: c, placeId: statement.destination, owner: owner) { state = state % 2U64 + 2U64 }
                } else if statement.tag == 2U64 || statement.tag == 8U64 {
                    if canonicalMidFlagPlace(c: c, placeId: statement.source, owner: owner) { state = state % 2U64 }
                    if statement.tag == 2U64 && canonicalMidFlagPlace(c: c, placeId: statement.destination, owner: owner) { state = state % 2U64 + 2U64 }
                } else if statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
                    if canonicalMidFlagPlace(c: c, placeId: statement.destination, owner: owner) {
                        if statement.tag == 4U64 && statement.flag == flag && state != 0U64 && state != 3U64 { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockIndex local=flag /> }
                        state = state % 2U64
                    }
                } else if statement.tag == 13U64 {
                    if canonicalMidFlagPlace(c: c, placeId: statement.source, owner: owner) { state = state % 2U64 }
                    mut val output = 0U64
                    while output < statement.enumDestinations.len {
                        if canonicalMidFlagPlace(c: c, placeId: c.mid.enumDestinations[statement.enumDestinations.start + output].place, owner: owner) { state = state % 2U64 + 2U64 }
                        output += 1U64
                    }
                }
                index += 1U64
            }
            val term = c.mid.terminators[block.terminator - 1U64]
            state = canonicalMidFlagOperand(c: c, operandId: term.discriminant, owner: owner, state: state)
            state = canonicalMidFlagOperand(c: c, operandId: term.value, owner: owner, state: state)
            if term.tag == 4U64 {
                if term.callReceiver != 0U64 { state = canonicalMidFlagOperand(c: c, operandId: c.mid.callReceivers[term.callReceiver - 1U64].operand, owner: owner, state: state) }
                index = 0U64
                while index < term.args.len {
                    state = canonicalMidFlagOperand(c: c, operandId: c.mid.callArguments[term.args.start + index], owner: owner, state: state)
                    index += 1U64
                }
            }
            if (term.tag == 4U64 || term.tag == 10U64) && canonicalMidFlagPlace(c: c, placeId: term.destination, owner: owner) { state = state % 2U64 + 2U64 }
            mut val edge: U64 = 0U64
            while edge < term.successorCount() {
                val target = c.mid.successorAt(term: term, index: edge)
                edge += 1U64
                val entry = target * 4U64 + state
                if target < body.blocks.len && !visited[entry] { visited.set(i: entry, value: true)
                    queue.append(entry) }
            }
        }
        flag += 1U64
    }
    return <MidVerification />
}

fn verifyCanonicalMidBodyStage(c: inout Comp, canonical: MidCanonicalBody, executable: Bool) -> MidVerification {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    if !c.mid.isWellFormed(body: canonical) { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    val flags: MidVerification = verifyCanonicalMidFlagInitialization(c: c, canonical: canonical)
    match flags.error { MidVerifyError.None => {} _ => { return flags } }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    val incoming: Array[Array[MidOwnership]] = analyzeCanonicalMidOwnership(arena: c.mid, canonical: canonical)
    val reachable = canonicalMidReachable(c: c, body: body)

    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        if !reachable[blockI] {
            if executable {
                val dead = c.mid.blocks[body.blocks.start + blockI]
                mut val statement = 0U64
                while statement < dead.statements.len {
                    if !canonicalMidStatementTypesMatch(c: inout c, body: body, statement: c.mid.statements[dead.statements.start + statement]) { return <MidVerification error=<MidVerifyError.TypeMismatch /> block=blockI /> }
                    statement += 1U64
                }
                if !canonicalMidTerminatorTypesMatch(c: inout c, body: body, term: c.mid.terminators[dead.terminator - 1U64]) { return <MidVerification error=<MidVerifyError.TypeMismatch /> block=blockI /> }
            }
            blockI += 1U64
            continue
        }
        mut val states: Array[MidOwnership] = []
        if blockI < incoming.count() { states = incoming[blockI] }
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
            if executable && !canonicalMidStatementTypesMatch(c: inout c, body: body, statement: statement) { return <MidVerification error=<MidVerifyError.TypeMismatch /> block=blockI /> }
            if statement.tag == 13U64 {
                val result = verifyCanonicalEnumDestructure(c: inout c, body: body, statement: statement, states: inout states, block: blockI, executable: executable)
                match result.error { MidVerifyError.None => {} _ => { return result } }
            }
            if statement.tag == 1U64 {
                val result: MidVerification = canonicalMidVerifyConsumeRvalue(c: inout c, body: body, states: inout states, rvalueId: statement.value, block: blockI, isGrounded: body.bodyInstance != 0U64, executable: executable)
                match result.error { MidVerifyError.None => {} _ => { return result } }
                if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                    val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                    if destination.rootTag != 1U64 { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                    if destination.projections.len == 0U64 && destination.local < states.count() {
                        match states[destination.local] { MidOwnership.Consumed => {} _ => { return <MidVerification error=<MidVerifyError.LiveInitialization /> block=blockI local=destination.local /> } }
                        if !c.mid.locals[body.locals.start + destination.local].isBorrowed { states.set(i: destination.local, value: <MidOwnership.Owned />) }
                    }
                }
            }
            if statement.tag == 9U64 {
                val result: MidVerification = canonicalMidVerifyConsumeRvalue(c: inout c, body: body, states: inout states, rvalueId: statement.value, block: blockI, isGrounded: body.bodyInstance != 0U64, executable: executable)
                match result.error { MidVerifyError.None => {} _ => { return result } }
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if destination.rootTag != 1U64 || destination.projections.len != 0U64 || destination.local >= states.count() || destination.local >= body.locals.len || !c.mid.locals[body.locals.start + destination.local].isCaptureCell {
                    return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local />
                }
                match states[destination.local] {
                    MidOwnership.Consumed => { states.set(i: destination.local, value: <MidOwnership.Owned />) }
                    _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                }
            }
            if statement.tag == 2U64 {
                if statement.destination == 0U64 || statement.source == 0U64 || statement.destination > c.mid.places.count() || statement.source > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
                if !canonicalMidWritablePhysicalPath(c: c, body: body, place: destination) || source.rootTag != 1U64 || source.projections.len != 0U64 || source.local >= states.count() || destination.typeTerm == 0U64 || !c.typeRefEq(a: destination.typeTerm, b: c.mid.locals[body.locals.start + source.local].typeTerm) { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                if destination.rootTag == 1U64 && (destination.local >= states.count() || destination.local == source.local) { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                if destination.rootTag == 2U64 && (!destination.globalMutable || !canonicalMidGlobalRootIsValid(c: c, place: destination)) { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                if destination.rootTag != 1U64 && destination.rootTag != 2U64 { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=destination.local /> }
                // Global storage has no local ownership state.  Its old value
                // is nevertheless observable through ARC/deinit, so the
                // completed body must prove the lowering's explicit release
                // immediately before transferring the replacement.
                if destination.rootTag == 2U64 || canonicalMidPlaceHasDeref(c: c, place: destination) {
                    if statementI == 0U64 { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                    val previous: MidStatementNode = c.mid.statements[block.statements.start + statementI - 1U64]
                    if previous.tag != 3U64 || !canonicalMidSamePlace(c: c, leftId: previous.destination, rightId: statement.destination) { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                }
                match states[source.local] {
                    MidOwnership.Owned => { states.set(i: source.local, value: <MidOwnership.Consumed />) }
                    _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                }
                if destination.rootTag == 2U64 { }
                else if destination.projections.len == 0U64 {
                    match states[destination.local] {
                        MidOwnership.Consumed => { states.set(i: destination.local, value: <MidOwnership.Owned />) }
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                    }
                } else {
                    match states[destination.local] {
                        MidOwnership.Owned => {}
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                    }
                }
            }
            if statement.tag == 8U64 {
                if statement.destination == 0U64 || statement.source == 0U64 || statement.destination > c.mid.places.count() || statement.source > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
                // InitializeGlobal is only meaningful in the compiler-created
                // module initializer body. User function bodies may overwrite
                // mutable globals but cannot create a second initial root.
                if body.sourceFunction != 18446744073709551615U64 { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
                if destination.rootTag != 2U64 || destination.projections.len != 0U64 || !canonicalMidGlobalRootIsValid(c: c, place: destination) || source.rootTag != 1U64 || source.projections.len != 0U64 || source.local >= states.count() || destination.typeTerm == 0U64 || !c.typeRefEq(a: destination.typeTerm, b: c.mid.locals[body.locals.start + source.local].typeTerm) { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                match states[source.local] {
                    MidOwnership.Owned => { states.set(i: source.local, value: <MidOwnership.Consumed />) }
                    _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                }
            }
            if executable && (statement.tag == 3U64 || statement.tag == 4U64) {
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val place = c.mid.places[statement.destination - 1U64]
                if !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: place.typeTerm) {
                    return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=blockI local=place.local />
                }
            }
            if statement.tag == 3U64 {
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if !canonicalMidWritablePhysicalPath(c: c, body: body, place: place) { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                // A pointee drop is only the release half of a replacement,
                // never disposal of a separately owned aggregate/root.
                val writableBorrow: Bool = place.rootTag == 1U64 && place.local < body.locals.len && c.mid.locals[body.locals.start + place.local].isInout
                if canonicalMidPlaceHasDeref(c: c, place: place) || writableBorrow {
                    if statementI + 1U64 >= block.statements.len { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                    val following = c.mid.statements[block.statements.start + statementI + 1U64]
                    if following.tag != 2U64 || !canonicalMidSamePlace(c: c, leftId: statement.destination, rightId: following.destination) { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                }
                if place.rootTag == 2U64 {
                    if !place.globalMutable || !canonicalMidGlobalRootIsValid(c: c, place: place) { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                } else if place.rootTag != 1U64 || place.local >= states.count() || place.local >= body.locals.len || c.mid.locals[body.locals.start + place.local].isBorrowed { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                if place.rootTag == 2U64 { }
                else if place.projections.len == 0U64 {
                    match states[place.local] {
                        MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                    }
                } else {
                    match states[place.local] {
                        MidOwnership.Owned => {}
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                    }
                }
            }
            if statement.tag == 10U64 {
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if place.rootTag != 1U64 || place.projections.len != 0U64 || place.local >= states.count() || place.local >= body.locals.len || (!c.mid.locals[body.locals.start + place.local].isCaptureCell || c.mid.locals[body.locals.start + place.local].isBorrowed || c.mid.locals[body.locals.start + place.local].isInout) {
                    return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local />
                }
                match states[place.local] {
                    MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                    _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                }
            }
            if statement.tag == 4U64 {
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if place.rootTag != 1U64 || place.projections.len != 0U64 || place.local >= states.count() || place.local >= body.locals.len || c.mid.locals[body.locals.start + place.local].isBorrowed || c.mid.locals[body.locals.start + place.local].isInout { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                if statement.flag >= body.locals.len || !c.mid.locals[body.locals.start + statement.flag].isDropFlag { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockI local=statement.flag /> }
                match states[place.local] {
                    MidOwnership.MaybeOwned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                    _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                }
            }
            if statement.requiresAccessElaboration() { return <MidVerification error=<MidVerifyError.UnelaboratedBindingEnd /> block=blockI /> }
            if statement.requiresDropElaboration() {
                if statement.tag == 6U64 { return <MidVerification error=<MidVerifyError.UnelaboratedScopeExit /> block=blockI /> }
                return <MidVerification error=<MidVerifyError.UnelaboratedBindingEnd /> block=blockI />
            }
            statementI = statementI + 1U64
        }
        if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
        if executable && !canonicalMidTerminatorTypesMatch(c: inout c, body: body, term: term) { return <MidVerification error=<MidVerifyError.TypeMismatch /> block=blockI /> }
        if term.tag == 2U64 && !canonicalMidTargetIsValid(body: body, target: term.target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        if term.tag == 3U64 {
            val result: MidVerification = canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: term.discriminant, block: blockI, executable: executable)
            match result.error { MidVerifyError.None => {} _ => { return result } }
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                if !canonicalMidTargetIsValid(body: body, target: c.mid.switchCases[term.cases.start + caseI].target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
                caseI = caseI + 1U64
            }
            if !canonicalMidTargetIsValid(body: body, target: term.otherwise) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        }
        if term.tag == 4U64 {
            if term.callReceiver == 0U64 || term.callReceiver > c.mid.callReceivers.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
            val callReceiver = c.mid.callReceivers[term.callReceiver - 1U64]
            if callReceiver.tag == 2U64 {
                val receiver: MidVerification = canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: callReceiver.operand, block: blockI, executable: executable)
                match receiver.error { MidVerifyError.None => {} _ => { return receiver } }
            } else if callReceiver.tag != 1U64 {
                return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI />
            }
            mut val argumentI: U64 = 0U64
            while argumentI < term.args.len {
                val result: MidVerification = canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: c.mid.callArguments[term.args.start + argumentI], block: blockI, executable: executable)
                match result.error { MidVerifyError.None => {} _ => { return result } }
                argumentI = argumentI + 1U64
            }
            if term.destination != 0U64 && term.destination <= c.mid.places.count() {
                val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local < states.count() {
                    match states[destination.local] { MidOwnership.Consumed => {} _ => { return <MidVerification error=<MidVerifyError.LiveInitialization /> block=blockI local=destination.local /> } }
                    states.set(i: destination.local, value: <MidOwnership.Owned />)
                }
            }
            if !canonicalMidTargetIsValid(body: body, target: term.target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        }
        if term.tag == 10U64 {
            if !canonicalMidTargetIsValid(body: body, target: term.resume) || term.value == 0U64 || term.value > c.mid.operands.count() || term.destination == 0U64 || term.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
            val promise = c.mid.operands[term.value - 1U64]
            if promise.tag != 3U64 || promise.capability != 1U64 || promise.place == 0U64 || promise.place > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
            val owner = c.mid.places[promise.place - 1U64]
            if owner.rootTag != 1U64 || owner.projections.len != 0U64 || owner.local >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
            match states[owner.local] { MidOwnership.Owned => {} _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=owner.local /> } }
            val destination = c.mid.places[term.destination - 1U64]
            if destination.rootTag != 1U64 || destination.projections.len != 0U64 || destination.local >= states.count() || destination.local == owner.local { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
            match states[destination.local] { MidOwnership.Consumed => {} _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=destination.local /> } }
            if executable && (!canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: owner.typeTerm) || !canonicalMidOwnershipContractIsReady(c: inout c, typeTerm: destination.typeTerm)) { return <MidVerification error=<MidVerifyError.MissingOwnershipContract /> block=blockI /> }
            states.set(i: destination.local, value: <MidOwnership.Owned />)
        }
        if term.tag == 6U64 || term.tag == 7U64 {
            val result: MidVerification = canonicalMidVerifyConsumeOperand(c: inout c, body: body, states: inout states, operandId: term.value, block: blockI, executable: executable)
            match result.error { MidVerifyError.None => {} _ => { return result } }
        }
        if term.tag == 5U64 || term.tag == 6U64 {
            mut val local = 0U64
            while local < body.locals.len {
                val declaration = c.mid.locals[body.locals.start + local]
                if !declaration.isBorrowed && !declaration.isInout && !declaration.isDropFlag && !(declaration.isParameter && !declaration.ownsAtEntry) {
                    match states[local] { MidOwnership.Consumed => {} _ => { return <MidVerification error=<MidVerifyError.OutstandingOwnership /> block=blockI local=local /> } }
                }
                local += 1U64
            }
        }
        blockI = blockI + 1U64
    }
    return verifyCanonicalMidFlagOwnership(c: c, body: body)
}
