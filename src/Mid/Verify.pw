// Structural and ownership verification for Mid IR. This consumes only Mid
// dataflow, never source AST or LLVM state. Backend entry will call it before
// lowering once Mid bodies become the production input.

import ../Frontend with { Comp }
import ./Ir with { MidBodyNode, MidBlockNode, MidPlaceNode, MidOperandNode, MidRvalueNode, MidStatementNode, MidTerminatorNode, MidCanonicalBody, MidPlace, MidProjection, MidOperand, MidRvalue, MidCallReceiver, MidStatement, MidTerminator, MidBody, MidOwnership }
import ./Drop with { analyzeMidOwnership, analyzeCanonicalMidOwnership, midSuccessors }

export enum MidVerifyError {
    None
    InvalidTarget
    PartialMove
    MoveUnavailable
    DropUnavailable
    InvalidDropFlag
    UninitializedDropFlag
    UnelaboratedScopeExit
    UnelaboratedAccess
    UninstantiatedReturnBoundary
    UninstantiatedCastBoundary
}

export struct MidVerification {
    pub val error: MidVerifyError = <MidVerifyError.None />
    pub val block: U64 = 0U64
    pub val local: U64 = 0U64
}
pub impl MidVerification { factory }

fn canonicalMidVerifyConsumeOperand(c: Comp, states: inout Array[MidOwnership], operandId: U64, block: U64) -> MidVerification {
    if operandId == 0U64 || operandId > c.mid.operands.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val operand: MidOperandNode = c.mid.operands[operandId - 1U64]
    if operand.tag == 8U64 { return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block /> }
    if operand.tag != 2U64 { return <MidVerification /> }
    if operand.place == 0U64 || operand.place > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val place: MidPlaceNode = c.mid.places[operand.place - 1U64]
    if place.projections.len != 0U64 { return <MidVerification error=<MidVerifyError.PartialMove /> block=block local=place.local /> }
    if place.local >= states.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
    match states[place.local] {
        MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
        _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
    }
    return <MidVerification />
}

fn canonicalMidVerifyConsumeRvalue(c: Comp, states: inout Array[MidOwnership], rvalueId: U64, block: U64, isGrounded: Bool) -> MidVerification {
    if rvalueId == 0U64 || rvalueId > c.mid.rvalues.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block /> }
    val value: MidRvalueNode = c.mid.rvalues[rvalueId - 1U64]
    if value.tag == 2U64 && (!isGrounded || value.targetTerm == 0U64) { return <MidVerification error=<MidVerifyError.UninstantiatedReturnBoundary /> block=block /> }
    if value.tag == 7U64 { return <MidVerification error=<MidVerifyError.UninstantiatedCastBoundary /> block=block /> }
    if (value.tag == 8U64 || value.tag == 9U64 || value.tag == 10U64) && (!isGrounded || value.targetTerm == 0U64) { return <MidVerification error=<MidVerifyError.UninstantiatedCastBoundary /> block=block /> }
    if value.tag >= 3U64 && value.tag <= 5U64 {
        mut val elementI: U64 = 0U64
        while elementI < value.elements.len {
            val verified: MidVerification = canonicalMidVerifyConsumeOperand(c: c, states: inout states, operandId: c.mid.aggregateElements[value.elements.start + elementI].operand, block: block)
            match verified.error { MidVerifyError.None => {} _ => { return verified } }
            elementI = elementI + 1U64
        }
        return <MidVerification />
    }
    if value.operand != 0U64 { return canonicalMidVerifyConsumeOperand(c: c, states: inout states, operandId: value.operand, block: block) }
    return <MidVerification />
}

fn canonicalMidTargetIsValid(body: MidBodyNode, target: U64) -> Bool {
    return target < body.blocks.len
}

fn canonicalMidVerifySuccessors(c: Comp, term: MidTerminatorNode) -> Array[U64] {
    if term.tag == 2U64 || term.tag == 4U64 { return [term.target] }
    if term.tag == 10U64 { return [term.resume] }
    if term.tag != 3U64 { return [] }
    mut val successors: Array[U64] = []
    mut val caseI: U64 = 0U64
    while caseI < term.cases.len {
        successors.append(c.mid.switchCases[term.cases.start + caseI].target)
        caseI = caseI + 1U64
    }
    successors.append(term.otherwise)
    return successors
}

fn canonicalMidPhysicalFieldPath(c: Comp, place: MidPlaceNode) -> Bool {
    mut val projectionI: U64 = 0U64
    while projectionI < place.projections.len {
        if c.mid.projections[place.projections.start + projectionI].tag != 1U64 { return false }
        projectionI = projectionI + 1U64
    }
    return true
}

fn verifyCanonicalMidFlagInitialization(c: Comp, canonical: MidCanonicalBody) -> MidVerification {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    mut val flags: Array[U64] = []
    mut val local: U64 = 0U64
    while local < body.locals.len {
        if c.mid.locals[body.locals.start + local].isDropFlag { flags.append(local) }
        local = local + 1U64
    }
    if body.entry >= body.blocks.len { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    mut val incoming: Array[Array[Bool]] = []
    mut val reachable: Array[Bool] = []
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val empty: Array[Bool] = []
        mut val flagI: U64 = 0U64
        while flagI < flags.count() {
            empty.append(false)
            flagI = flagI + 1U64
        }
        incoming.append(empty)
        reachable.append(blockI == body.entry)
        blockI = blockI + 1U64
    }
    mut val changed: Bool = true
    while changed {
        changed = false
        blockI = 0U64
        while blockI < body.blocks.len {
            if reachable[blockI] {
                mut val outgoing: Array[Bool] = incoming[blockI]
                val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
                mut val statementI: U64 = 0U64
                while statementI < block.statements.len {
                    val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                    if statement.tag == 5U64 {
                        if statement.flag >= body.locals.len || !c.mid.locals[body.locals.start + statement.flag].isDropFlag { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockI local=statement.flag /> }
                        mut val flagI: U64 = 0U64
                        while flagI < flags.count() {
                            if flags[flagI] == statement.flag { outgoing.set(i: flagI, value: true) }
                            flagI = flagI + 1U64
                        }
                    }
                    statementI = statementI + 1U64
                }
                if block.terminator != 0U64 && block.terminator <= c.mid.terminators.count() {
                    val successors: Array[U64] = canonicalMidVerifySuccessors(c: c, term: c.mid.terminators[block.terminator - 1U64])
                    mut val successorI: U64 = 0U64
                    while successorI < successors.count() {
                        val target: U64 = successors[successorI]
                        if !canonicalMidTargetIsValid(body: body, target: target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
                        if !reachable[target] {
                            incoming.set(i: target, value: outgoing)
                            reachable.set(i: target, value: true)
                            changed = true
                        } else {
                            mut val merged: Array[Bool] = incoming[target]
                            mut val flagI: U64 = 0U64
                            while flagI < flags.count() {
                                if merged[flagI] && !outgoing[flagI] {
                                    merged.set(i: flagI, value: false)
                                    changed = true
                                }
                                flagI = flagI + 1U64
                            }
                            incoming.set(i: target, value: merged)
                        }
                        successorI = successorI + 1U64
                    }
                }
            }
            blockI = blockI + 1U64
        }
    }
    blockI = 0U64
    while blockI < body.blocks.len {
        if reachable[blockI] {
            mut val initialized: Array[Bool] = incoming[blockI]
            val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
            mut val statementI: U64 = 0U64
            while statementI < block.statements.len {
                val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
                if statement.tag == 5U64 {
                    mut val flagI: U64 = 0U64
                    while flagI < flags.count() {
                        if flags[flagI] == statement.flag { initialized.set(i: flagI, value: true) }
                        flagI = flagI + 1U64
                    }
                }
                if statement.tag == 4U64 {
                    if statement.flag >= body.locals.len || !c.mid.locals[body.locals.start + statement.flag].isDropFlag { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockI local=statement.flag /> }
                    mut val flagI: U64 = 0U64
                    while flagI < flags.count() {
                        if flags[flagI] == statement.flag && !initialized[flagI] { return <MidVerification error=<MidVerifyError.UninitializedDropFlag /> block=blockI local=statement.flag /> }
                        flagI = flagI + 1U64
                    }
                }
                statementI = statementI + 1U64
            }
        }
        blockI = blockI + 1U64
    }
    return <MidVerification />
}

// Verify the elaborated frozen CFG directly.  This mirrors the draft verifier
// intentionally at the ownership boundary, but every read is a canonical row
// or range; the production path can therefore discard MidBody after freeze.
export fn verifyCanonicalMidBody(c: Comp, canonical: MidCanonicalBody) -> MidVerification {
    if canonical.body == 0U64 || canonical.body > c.mid.bodies.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    val flags: MidVerification = verifyCanonicalMidFlagInitialization(c: c, canonical: canonical)
    match flags.error { MidVerifyError.None => {} _ => { return flags } }
    val body: MidBodyNode = c.mid.bodies[canonical.body - 1U64]
    val incoming: Array[Array[MidOwnership]] = analyzeCanonicalMidOwnership(c: c, canonical: canonical)
    mut val blockI: U64 = 0U64
    while blockI < body.blocks.len {
        mut val states: Array[MidOwnership] = []
        if blockI < incoming.count() { states = incoming[blockI] }
        val block: MidBlockNode = c.mid.blocks[body.blocks.start + blockI]
        mut val statementI: U64 = 0U64
        while statementI < block.statements.len {
            val statement: MidStatementNode = c.mid.statements[block.statements.start + statementI]
            if statement.tag == 1U64 {
                val result: MidVerification = canonicalMidVerifyConsumeRvalue(c: c, states: inout states, rvalueId: statement.value, block: blockI, isGrounded: body.bodyInstance != 0U64)
                match result.error { MidVerifyError.None => {} _ => { return result } }
                if statement.destination != 0U64 && statement.destination <= c.mid.places.count() {
                    val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                    if destination.projections.len == 0U64 && destination.local < states.count() { states.set(i: destination.local, value: <MidOwnership.Owned />) }
                }
            }
            if statement.tag == 2U64 {
                if statement.destination == 0U64 || statement.source == 0U64 || statement.destination > c.mid.places.count() || statement.source > c.mid.places.count() { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI /> }
                val destination: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                val source: MidPlaceNode = c.mid.places[statement.source - 1U64]
                if !canonicalMidPhysicalFieldPath(c: c, place: destination) || source.projections.len != 0U64 || destination.local >= states.count() || source.local >= states.count() || destination.local == source.local || destination.typeTerm == 0U64 || destination.typeTerm != c.mid.locals[body.locals.start + source.local].typeTerm { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                match states[source.local] {
                    MidOwnership.Owned => { states.set(i: source.local, value: <MidOwnership.Consumed />) }
                    _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=blockI local=source.local /> }
                }
                if destination.projections.len == 0U64 {
                    match states[destination.local] {
                        MidOwnership.MaybeOwned => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                        _ => { states.set(i: destination.local, value: <MidOwnership.Owned />) }
                    }
                } else {
                    match states[destination.local] {
                        MidOwnership.Owned => {}
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=destination.local /> }
                    }
                }
            }
            if statement.tag == 3U64 {
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if !canonicalMidPhysicalFieldPath(c: c, place: place) || place.local >= states.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                if place.projections.len == 0U64 {
                    match states[place.local] {
                        MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                    }
                } else {
                    match states[place.local] {
                        MidOwnership.Owned => {}
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                    }
                }
            }
            if statement.tag == 4U64 {
                if statement.destination == 0U64 || statement.destination > c.mid.places.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI /> }
                val place: MidPlaceNode = c.mid.places[statement.destination - 1U64]
                if place.projections.len != 0U64 || place.local >= states.count() { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                if statement.flag >= body.locals.len || !c.mid.locals[body.locals.start + statement.flag].isDropFlag { return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=blockI local=statement.flag /> }
                match states[place.local] {
                    MidOwnership.MaybeOwned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                    _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=blockI local=place.local /> }
                }
            }
            if statement.tag == 6U64 { return <MidVerification error=<MidVerifyError.UnelaboratedScopeExit /> block=blockI /> }
            statementI = statementI + 1U64
        }
        if block.terminator == 0U64 || block.terminator > c.mid.terminators.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        val term: MidTerminatorNode = c.mid.terminators[block.terminator - 1U64]
        if term.tag == 2U64 && !canonicalMidTargetIsValid(body: body, target: term.target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        if term.tag == 3U64 {
            val result: MidVerification = canonicalMidVerifyConsumeOperand(c: c, states: inout states, operandId: term.discriminant, block: blockI)
            match result.error { MidVerifyError.None => {} _ => { return result } }
            mut val caseI: U64 = 0U64
            while caseI < term.cases.len {
                if !canonicalMidTargetIsValid(body: body, target: c.mid.switchCases[term.cases.start + caseI].target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
                caseI = caseI + 1U64
            }
            if !canonicalMidTargetIsValid(body: body, target: term.otherwise) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        }
        if term.tag == 4U64 {
            if term.callReceiver != 0U64 && term.callReceiver <= c.mid.callReceivers.count() {
                val receiver: MidVerification = canonicalMidVerifyConsumeOperand(c: c, states: inout states, operandId: c.mid.callReceivers[term.callReceiver - 1U64].operand, block: blockI)
                match receiver.error { MidVerifyError.None => {} _ => { return receiver } }
            }
            mut val argumentI: U64 = 0U64
            while argumentI < term.args.len {
                val result: MidVerification = canonicalMidVerifyConsumeOperand(c: c, states: inout states, operandId: c.mid.callArguments[term.args.start + argumentI], block: blockI)
                match result.error { MidVerifyError.None => {} _ => { return result } }
                argumentI = argumentI + 1U64
            }
            if term.destination != 0U64 && term.destination <= c.mid.places.count() {
                val destination: MidPlaceNode = c.mid.places[term.destination - 1U64]
                if destination.projections.len == 0U64 && destination.local < states.count() { states.set(i: destination.local, value: <MidOwnership.Owned />) }
            }
            if !canonicalMidTargetIsValid(body: body, target: term.target) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        }
        if term.tag == 10U64 && !canonicalMidTargetIsValid(body: body, target: term.resume) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=blockI /> }
        if term.tag == 6U64 || term.tag == 7U64 {
            val result: MidVerification = canonicalMidVerifyConsumeOperand(c: c, states: inout states, operandId: term.value, block: blockI)
            match result.error { MidVerifyError.None => {} _ => { return result } }
        }
        blockI = blockI + 1U64
    }
    return <MidVerification />
}

fn midVerifyConsumeOperand(states: inout Array[MidOwnership], operand: MidOperand, block: U64) -> MidVerification {
    match operand {
        MidOperand.Access(candidate: _) => {
            return <MidVerification error=<MidVerifyError.UnelaboratedAccess /> block=block />
        }
        MidOperand.Move(place: val place) => {
            if place.projections.count() != 0U64 {
                return <MidVerification error=<MidVerifyError.PartialMove /> block=block local=place.local />
            }
            if place.local >= states.count() {
                return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local />
            }
            match states[place.local] {
                MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=block local=place.local /> }
            }
        }
        _ => {}
    }
    return <MidVerification />
}

fn midVerifyConsumeRvalue(states: inout Array[MidOwnership], value: MidRvalue, block: U64, isGrounded: Bool) -> MidVerification {
    match value {
        MidRvalue.Use(operand: val operand) => { return midVerifyConsumeOperand(states: inout states, operand: operand, block: block) }
        // Parametric bodies are never verifier input in the production path;
        // their ABI target has not been selected yet.  After BodyInstance
        // grounding, however, ReturnBoundary deliberately remains explicit so
        // LLVM uses the final nominal ABI layout even for Identity conversion.
        MidRvalue.ReturnBoundary(exprId: _, targetTerm: val targetTerm, operand: val operand) => {
            if !isGrounded || targetTerm == 0U64 { return <MidVerification error=<MidVerifyError.UninstantiatedReturnBoundary /> block=block /> }
            return midVerifyConsumeOperand(states: inout states, operand: operand, block: block)
        }
        MidRvalue.Aggregate(exprId: _, kind: _, resultTerm: _, fieldCount: _, elements: val elements) => {
            mut val i: U64 = 0U64
            while i < elements.count() {
                val verified: MidVerification = midVerifyConsumeOperand(states: inout states, operand: elements[i].operand, block: block)
                match verified.error { MidVerifyError.None => {} _ => { return verified } }
                i += 1U64
            }
            return <MidVerification />
        }
        MidRvalue.Convert(operand: val operand, conversion: _) => { return midVerifyConsumeOperand(states: inout states, operand: operand, block: block) }
        MidRvalue.CastBoundary(exprId: _, sourceTerm: _, targetTerm: _, operand: _) => { return <MidVerification error=<MidVerifyError.UninstantiatedCastBoundary /> block=block /> }
        MidRvalue.Cast(operand: val operand, kind: _, targetTerm: val targetTerm) => {
            if !isGrounded || targetTerm == 0U64 { return <MidVerification error=<MidVerifyError.UninstantiatedCastBoundary /> block=block /> }
            return midVerifyConsumeOperand(states: inout states, operand: operand, block: block)
        }
        MidRvalue.EnumTag(place: _, enumIndex: _, sourceStmt: _, resultTerm: _) => { return <MidVerification /> }
        MidRvalue.EnumPayloadCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return <MidVerification /> }
        MidRvalue.EnumPayloadBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return <MidVerification /> }
        MidRvalue.EnumPayloadBoxedCopy(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return <MidVerification /> }
        MidRvalue.EnumPayloadBoxedBorrow(place: _, enumIndex: _, variantIndex: _, fieldIndex: _, bindTarget: _, sourceStmt: _, resultTerm: _) => { return <MidVerification /> }
    }
}

fn midTargetIsValid(body: MidBody, target: U64) -> Bool {
    return target < body.blocks.count()
}

// A flag's value (owned or not) is separate from whether it has been written.
// Meet across reachable predecessors: one uninitialized path is enough to
// reject a read. The invocation edge starts with no initialized flags, even
// when a loop backedge writes them. Unreachable predecessors add no evidence.
fn verifyMidFlagInitialization(body: MidBody) -> MidVerification {
    mut val flags: Array[U64] = []
    mut val local: U64 = 0U64
    while local < body.locals.count() {
        if body.locals[local].isDropFlag { flags.append(local) }
        local += 1U64
    }
    if body.entry >= body.blocks.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> /> }
    mut val incoming: Array[Array[Bool]] = []
    mut val reachable: Array[Bool] = []
    mut val block: U64 = 0U64
    while block < body.blocks.count() {
        mut val empty: Array[Bool] = []
        mut val fi: U64 = 0U64
        while fi < flags.count() {
            empty.append(false)
            fi += 1U64
        }
        incoming.append(empty)
        reachable.append(block == body.entry)
        block += 1U64
    }
    mut val changed: Bool = true
    while changed {
        changed = false
        block = 0U64
        while block < body.blocks.count() {
            if reachable[block] {
                mut val outgoing: Array[Bool] = incoming[block]
                mut val si: U64 = 0U64
                while si < body.blocks[block].statements.count() {
                    match body.blocks[block].statements[si] {
                        MidStatement.SetDropFlag(local: val written, isSet: _) => {
                            if written >= body.locals.count() || !body.locals[written].isDropFlag {
                                return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=block local=written />
                            }
                            mut val fi: U64 = 0U64
                            while fi < flags.count() {
                                if flags[fi] == written { outgoing.set(i: fi, value: true) }
                                fi += 1U64
                            }
                        }
                        _ => {}
                    }
                    si += 1U64
                }
                val successors: Array[U64] = midSuccessors(term: body.blocks[block].terminator)
                si = 0U64
                while si < successors.count() {
                    val target: U64 = successors[si]
                    if target >= body.blocks.count() { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=block /> }
                    if !reachable[target] {
                        incoming.set(i: target, value: outgoing)
                        reachable.set(i: target, value: true)
                        changed = true
                    } else {
                        mut val merged: Array[Bool] = incoming[target]
                        mut val fi: U64 = 0U64
                        while fi < flags.count() {
                            if merged[fi] && !outgoing[fi] {
                                merged.set(i: fi, value: false)
                                changed = true
                            }
                            fi += 1U64
                        }
                        incoming.set(i: target, value: merged)
                    }
                    si += 1U64
                }
            }
            block += 1U64
        }
    }
    block = 0U64
    while block < body.blocks.count() {
        if reachable[block] {
            mut val initialized: Array[Bool] = incoming[block]
            mut val si: U64 = 0U64
            while si < body.blocks[block].statements.count() {
                match body.blocks[block].statements[si] {
                    MidStatement.SetDropFlag(local: val written, isSet: _) => {
                        mut val fi: U64 = 0U64
                        while fi < flags.count() {
                            if flags[fi] == written { initialized.set(i: fi, value: true) }
                            fi += 1U64
                        }
                    }
                    MidStatement.ConditionalDrop(place: _, flag: val flag) => {
                        if flag >= body.locals.count() || !body.locals[flag].isDropFlag {
                            return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=block local=flag />
                        }
                        mut val fi: U64 = 0U64
                        while fi < flags.count() {
                            if flags[fi] == flag && !initialized[fi] {
                                return <MidVerification error=<MidVerifyError.UninitializedDropFlag /> block=block local=flag />
                            }
                            fi += 1U64
                        }
                    }
                    _ => {}
                }
                si += 1U64
            }
        }
        block += 1U64
    }
    return <MidVerification />
}

// Validate pre-drop-elaboration Mid. A `MaybeOwned` source is deliberately not
// movable: the accessibility-cliff insertion must first make both incoming paths
// uniformly consumed. This is what prevents a conditional move from becoming a
// use-after-move dependent on runtime branch history.
export fn verifyMidBody(body: MidBody) -> MidVerification {
    val flags: MidVerification = verifyMidFlagInitialization(body: body)
    match flags.error { MidVerifyError.None => {} _ => { return flags } }
    val incoming: Array[Array[MidOwnership]] = analyzeMidOwnership(body: body)
    mut val bi: U64 = 0U64
    while bi < body.blocks.count() {
        mut val states: Array[MidOwnership] = incoming[bi]
        mut val si: U64 = 0U64
        while si < body.blocks[bi].statements.count() {
            match body.blocks[bi].statements[si] {
                MidStatement.Assign(destination: val destination, value: val value) => {
                    val result: MidVerification = midVerifyConsumeRvalue(states: inout states, value: value, block: bi, isGrounded: body.bodyInstance != 0U64)
                    match result.error { MidVerifyError.None => {} _ => { return result } }
                    if destination.projections.count() == 0U64 && destination.local < states.count() {
                        states.set(i: destination.local, value: <MidOwnership.Owned />)
                    }
                }
                MidStatement.Overwrite(destination: val destination, source: val source) => {
                    mut val physicalFieldPath: Bool = true
                    mut val projection: U64 = 0U64
                    while projection < destination.projections.count() {
                        match destination.projections[projection] {
                            MidProjection.Field(index: _, typeTerm: _) => {}
                            _ => { physicalFieldPath = false }
                        }
                        projection += 1U64
                    }
                    if !physicalFieldPath || source.projections.count() != 0U64 || destination.local >= states.count() || source.local >= states.count() || destination.local == source.local || destination.typeTerm == 0U64 || destination.typeTerm != body.locals[source.local].typeTerm {
                        return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=bi local=source.local />
                    }
                    match states[source.local] {
                        MidOwnership.Owned => { states.set(i: source.local, value: <MidOwnership.Consumed />) }
                        _ => { return <MidVerification error=<MidVerifyError.MoveUnavailable /> block=bi local=source.local /> }
                    }
                    if destination.projections.count() == 0U64 {
                        match states[destination.local] {
                            MidOwnership.MaybeOwned => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=destination.local /> }
                            _ => { states.set(i: destination.local, value: <MidOwnership.Owned />) }
                        }
                    } else {
                        // A projected overwrite replaces storage already
                        // owned by its root; it is not partial initialization.
                        // Keep the root state unchanged, but reject a path
                        // where its field would be read/dropped after a move.
                        match states[destination.local] {
                            MidOwnership.Owned => {}
                            _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=destination.local /> }
                        }
                    }
                }
                MidStatement.Drop(place: val place) => {
                    mut val physicalFieldPath: Bool = true
                    mut val projection: U64 = 0U64
                    while projection < place.projections.count() {
                        match place.projections[projection] {
                            MidProjection.Field(index: _, typeTerm: _) => {}
                            _ => { physicalFieldPath = false }
                        }
                        projection += 1U64
                    }
                    if !physicalFieldPath || place.local >= states.count() {
                        return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=place.local />
                    }
                    if place.projections.count() == 0U64 {
                        match states[place.local] {
                            MidOwnership.Owned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                            _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=place.local /> }
                        }
                    } else {
                        // A field Drop consumes only the subvalue. The root
                        // remains the owning storage and must itself still be
                        // valid on every incoming path.
                        match states[place.local] {
                            MidOwnership.Owned => {}
                            _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=place.local /> }
                        }
                    }
                }
                MidStatement.ConditionalDrop(place: val place, flag: val flag) => {
                    if place.projections.count() != 0U64 || place.local >= states.count() {
                        return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=place.local />
                    }
                    if flag >= body.locals.count() || !(body.locals[flag].isDropFlag) {
                        return <MidVerification error=<MidVerifyError.InvalidDropFlag /> block=bi local=flag />
                    }
                    match states[place.local] {
                        MidOwnership.MaybeOwned => { states.set(i: place.local, value: <MidOwnership.Consumed />) }
                        _ => { return <MidVerification error=<MidVerifyError.DropUnavailable /> block=bi local=place.local /> }
                    }
                }
                MidStatement.ScopeExit(scope: _) => { return <MidVerification error=<MidVerifyError.UnelaboratedScopeExit /> block=bi /> }
                _ => {}
            }
            si += 1U64
        }
        match body.blocks[bi].terminator {
            MidTerminator.Goto(target: val target) => {
                if !(midTargetIsValid(body: body, target: target)) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=bi /> }
            }
            MidTerminator.Switch(discriminant: val discriminant, values: _, targets: val targets, otherwise: val otherwise) => {
                val result: MidVerification = midVerifyConsumeOperand(states: inout states, operand: discriminant, block: bi)
                match result.error { MidVerifyError.None => {} _ => { return result } }
                mut val ti: U64 = 0U64
                while ti < targets.count() {
                    if !(midTargetIsValid(body: body, target: targets[ti])) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=bi /> }
                    ti += 1U64
                }
                if !(midTargetIsValid(body: body, target: otherwise)) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=bi /> }
            }
            MidTerminator.Call(callee: _, receiver: val receiver, args: val args, destination: val destination, target: val target) => {
                match receiver {
                    MidCallReceiver.Value(operand: val operand) => {
                        val receiverResult: MidVerification = midVerifyConsumeOperand(states: inout states, operand: operand, block: bi)
                        match receiverResult.error { MidVerifyError.None => {} _ => { return receiverResult } }
                    }
                    _ => {}
                }
                mut val ai: U64 = 0U64
                while ai < args.count() {
                    val result: MidVerification = midVerifyConsumeOperand(states: inout states, operand: args[ai], block: bi)
                    match result.error { MidVerifyError.None => {} _ => { return result } }
                    ai += 1U64
                }
                if destination.projections.count() == 0U64 && destination.local < states.count() {
                    states.set(i: destination.local, value: <MidOwnership.Owned />)
                }
                if !(midTargetIsValid(body: body, target: target)) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=bi /> }
            }
            MidTerminator.Suspend(state: _, resume: val resume) => {
                if !(midTargetIsValid(body: body, target: resume)) { return <MidVerification error=<MidVerifyError.InvalidTarget /> block=bi /> }
            }
            MidTerminator.ReturnValue(value: val value) => {
                val result: MidVerification = midVerifyConsumeOperand(states: inout states, operand: value, block: bi)
                match result.error { MidVerifyError.None => {} _ => { return result } }
            }
            MidTerminator.Panic(message: val message) => {
                val result: MidVerification = midVerifyConsumeOperand(states: inout states, operand: message, block: bi)
                match result.error { MidVerifyError.None => {} _ => { return result } }
            }
            _ => {}
        }
        bi += 1U64
    }
    return <MidVerification />
}
