// Compact value domains for the existing root-local dataflow lattices.
// CoW snapshots remain independent; only their physical representation changes.
import @Std/Core with { Index }
import ./Ir with { MidOwnership, MidAccessibility }

fn ownershipBits(state: MidOwnership) -> U64 {
    match state {
        MidOwnership.Owned => { return 1U64 }
        MidOwnership.Consumed => { return 2U64 }
        MidOwnership.MaybeOwned => { return 3U64 }
    }
}

pub struct MidOwnershipStates {
    val localCount: U64
    mut val words: Array[U64]
}
pub impl MidOwnershipStates {
    factory empty { return <MidOwnershipStates localCount=0U64 words=[] /> }
    factory filled(count: U64, state: MidOwnership) {
        val pattern = ownershipBits(state: state) * 6148914691236517205U64
        mut val words: Array[U64] = []
        mut val index = 0U64
        while index < (count >> 5U64) { words.append(pattern)
            index += 1U64 }
        if (count & 31U64) != 0U64 {
            words.append(pattern & ((1U64 << (((count & 31U64) << 1U64))) - 1U64))
        }
        return <MidOwnershipStates localCount=count words=words />
    }
    fn count() -> U64 { return self.localCount }
    fn at(index: U64) -> MidOwnership {
        if index >= self.localCount { panic "ownership state index out of bounds" }
        val bits = (self.words[(index >> 5U64)] >> (((index & 31U64) << 1U64))) & 3U64
        match bits {
            1U64 => { return <MidOwnership.Owned /> }
            2U64 => { return <MidOwnership.Consumed /> }
            3U64 => { return <MidOwnership.MaybeOwned /> }
            _ => { panic "invalid ownership state" }
        }
    }
    inout fn set(index: U64, state: MidOwnership) {
        if index >= self.localCount { panic "ownership state index out of bounds" }
        val word = (index >> 5U64)
        val shift = ((index & 31U64) << 1U64)
        val before = self.words[word]
        val after = (before & (18446744073709551615U64 ^ (3U64 << shift))) | (ownershipBits(state: state) << shift)
        if after != before { self.words[word] = after }
    }
    // 01 | 10 = 11: disagreeing paths become MaybeOwned. Padding is zero.
    inout fn join(incoming: MidOwnershipStates) -> Bool {
        if self.localCount != incoming.localCount { panic "ownership state domain mismatch" }
        mut val changed = false
        mut val index = 0U64
        while index < self.words.count() {
            val before = self.words[index]
            val after = before | incoming.words[index]
            if after != before { self.words[index] = after
                changed = true }
            index += 1U64
        }
        return changed
    }
}
pub impl MidOwnershipStates as Index[U64] {
    type Output = MidOwnership
    fn index(key: U64) -> MidOwnership { return self.at(index: key) }
}

pub struct MidAccessibilityStates {
    val localCount: U64
    mut val words: Array[U64]
}
pub impl MidAccessibilityStates {
    factory empty { return <MidAccessibilityStates localCount=0U64 words=[] /> }
    factory filled(count: U64, state: MidAccessibility) {
        val pattern = match state {
            MidAccessibility.Available => { give 18446744073709551615U64 }
            MidAccessibility.Unavailable => { give 0U64 }
        }
        mut val words: Array[U64] = []
        mut val index = 0U64
        while index < (count >> 6U64) { words.append(pattern)
            index += 1U64 }
        if (count & 63U64) != 0U64 {
            words.append(pattern & ((1U64 << ((count & 63U64))) - 1U64))
        }
        return <MidAccessibilityStates localCount=count words=words />
    }
    fn count() -> U64 { return self.localCount }
    fn at(index: U64) -> MidAccessibility {
        if index >= self.localCount { panic "accessibility state index out of bounds" }
        if (self.words[(index >> 6U64)] & (1U64 << ((index & 63U64)))) != 0U64 { return <MidAccessibility.Available /> }
        return <MidAccessibility.Unavailable />
    }
    inout fn set(index: U64, state: MidAccessibility) {
        if index >= self.localCount { panic "accessibility state index out of bounds" }
        val word = (index >> 6U64)
        val mask = 1U64 << ((index & 63U64))
        val before = self.words[word]
        val after = match state {
            MidAccessibility.Available => { give before | mask }
            MidAccessibility.Unavailable => { give before & (18446744073709551615U64 ^ mask) }
        }
        if after != before { self.words[word] = after }
    }
    // A local is accessible only when every incoming path can name it.
    inout fn join(incoming: MidAccessibilityStates) -> Bool {
        if self.localCount != incoming.localCount { panic "accessibility state domain mismatch" }
        mut val changed = false
        mut val index = 0U64
        while index < self.words.count() {
            val before = self.words[index]
            val after = before & incoming.words[index]
            if after != before { self.words[index] = after
                changed = true }
            index += 1U64
        }
        return changed
    }
}
pub impl MidAccessibilityStates as Index[U64] {
    type Output = MidAccessibility
    fn index(key: U64) -> MidAccessibility { return self.at(index: key) }
}
