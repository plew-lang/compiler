// Declaration-time global effects. This is an analysis result, not a checked
// program token: unresolved calls, conversions, and ownership dependencies
// remain explicit obligations for instance analysis or dynamic enforcement.
import ../Frontend with { Comp }
import ../Diag with { CompileDiagnostic }
import ../Ir with { CallSiteKey, CallTemplateKind }
import ./Build with { MidFunctionTemplates, MidBuildError, MidBodyBuild, ensureParametricMidClosureBody }
import ./Ir with { MidTerminatorNode, MidCanonicalBody }
import ./Prepare with { MidParametricBody }
import ./OwnershipAnalysis with { MidOwnershipRequests }
import ./GlobalAccessGraph with { GlobalAccessGraph }
import ./Verify with { canonicalMidReachable, canonicalMidCallAccessError, MidVerifyError, MidVerification }

pub enum DeclarationAccessNode {
    Function(function: U64)
    Closure(bodyKey: U64)
    GlobalInitializer
    Destruction(typeTerm: U64)
}
// body indexes the result's nodes array. Canonical instruction IDs are
// one-based, including statement, so absence never aliases the first row.
pub enum DeclarationAccessObligation {
    Call(body: U64, terminator: U64, template: U64)
    ForProtocol(body: U64, terminator: U64, statement: U64, slot: U64)
    TryConversion(body: U64, terminator: U64, expression: U64)
    Destruction(body: U64, typeTerm: U64, typeRecipe: U64)
    Value(body: U64, value: U64)
}
pub enum DeclarationAccessError {
    Build(body: DeclarationAccessNode, error: MidBuildError)
    Ownership(body: DeclarationAccessNode, verification: MidVerification)
    LocalAccess(body: DeclarationAccessNode, error: MidVerifyError)
    CallSelection(body: DeclarationAccessNode, terminator: U64)
    Frontend(diagnostic: CompileDiagnostic)
}
pub struct DeclarationAccessAnalysis {
    // One-based node identity, zero when no definite conflict exists.
    // Zero does NOT establish absence of effects represented by obligations.
    pub val nodes: Array[DeclarationAccessNode] = []
    pub val conflictingNode: U64 = 0U64
    pub val obligations: Array[DeclarationAccessObligation] = []
}
pub impl DeclarationAccessAnalysis { factory }

struct DeclarationAccessState {
    mut val graph: GlobalAccessGraph = <GlobalAccessGraph.empty />
    mut val obligations: Array[DeclarationAccessObligation] = []
    mut val owners: Array[DeclarationAccessNode] = []
    mut val functionNodes: Dictionary[U64, U64] = [:]
    mut val closureNodes: Dictionary[U64, U64] = [:]
    mut val globalNode: U64 = 0U64
    mut val typeNodes: Dictionary[U64, U64] = [:]
}
impl DeclarationAccessState {
    // Graph IDs are independent of declaration IDs. Publishing a node before
    // examining its body closes recursive edges without recursive evaluation.
    inout fn demand(owner: DeclarationAccessNode) -> U64 {
        val existing = match owner {
            DeclarationAccessNode.Function(function: val function) => { give self.functionNodes.getOr(key: function, fallback: 0U64) }
            DeclarationAccessNode.Closure(bodyKey: val key) => { give self.closureNodes.getOr(key: key, fallback: 0U64) }
            DeclarationAccessNode.GlobalInitializer => { give self.globalNode }
            DeclarationAccessNode.Destruction(typeTerm: val term) => { give self.typeNodes.getOr(key: term, fallback: 0U64) }
        }
        if existing != 0U64 { return existing - 1U64 }
        val node = self.graph.node()
        self.owners.append(owner)
        match owner {
            DeclarationAccessNode.Function(function: val function) => { self.functionNodes[function] = node + 1U64 }
            DeclarationAccessNode.Closure(bodyKey: val key) => { self.closureNodes[key] = node + 1U64 }
            DeclarationAccessNode.GlobalInitializer => { self.globalNode = node + 1U64 }
            DeclarationAccessNode.Destruction(typeTerm: val term) => { self.typeNodes[term] = node + 1U64 }
        }
        return node
    }

    inout fn body(c: inout Comp, index: U64, built: MidBodyBuild, requests: inout MidOwnershipRequests) -> Result[(), DeclarationAccessError] {
        match built.error {
            MidBuildError.None => {}
            _ => { return <Result.Err error=<DeclarationAccessError.Build body=self.owners[index] error=built.error /> /> }
        }
        val ownership = match requests.request(c: inout c, body: <MidParametricBody.input canonical=built.canonical />) {
            Result.Ok(value: val verified) => { give verified }
            Result.Err(error: val verification) => { return <Result.Err error=<DeclarationAccessError.Ownership body=self.owners[index] verification=verification /> /> }
        }
        val destruction = match requests.destructionBody(c: inout c, body: ownership) {
            Result.Ok(value: val canonical) => { give canonical }
            Result.Err(error: val verification) => { return <Result.Err error=<DeclarationAccessError.Ownership body=self.owners[index] verification=verification /> /> }
        }
        return self.scanBody(c: c, index: index, canonical: destruction)
    }

    // Ownership preparation may extend Mid; effect collection only reads the
    // resulting snapshot and mutates this analysis's graph and obligations.
    inout fn scanBody(c: Comp, index: U64, canonical: MidCanonicalBody) -> Result[(), DeclarationAccessError] {
        val body = c.mid.bodies[canonical.body - 1U64]
        val reachable = canonicalMidReachable(arena: c.mid, body: body)
        mut val blockIndex = 0U64
        while blockIndex < body.blocks.len {
            if reachable[blockIndex] {
                val block = c.mid.blocks[body.blocks.start + blockIndex]
                mut val statementIndex = 0U64
                while statementIndex < block.statements.len {
                    val statementId = block.statements.start + statementIndex
                    val statement = c.mid.statements[statementId]
                    self.graph.statement(arena: c.mid, body: index, statement: statement)
                    if statement.tag == 2U64 || statement.tag == 3U64 || statement.tag == 4U64 || statement.tag == 10U64 {
                        val place = c.mid.places[statement.destination - 1U64]
                        self.destruction(c: c, caller: index, term: place.typeTerm, recipe: place.typeRecipe)
                    }
                    if statement.value != 0U64 {
                        val value = c.mid.rvalues[statement.value - 1U64]
                        if value.isParametricOnly() || value.tag == 6U64 || (value.tag >= 8U64 && value.tag <= 10U64) || value.hasAggregateElements() || value.hasClosureCaptures() {
                            self.obligations.append(<DeclarationAccessObligation.Value body=index value=statement.value />)
                        }
                    }
                    statementIndex += 1U64
                }
                val term = c.mid.terminators[block.terminator - 1U64]
                self.graph.terminatorOperands(arena: c.mid, body: index, term: term)
                if term.tag == 4U64 {
                    val target = c.mid.callTargets[term.callTarget - 1U64]
                    if target.tag == 3U64 {
                        if target.exprId >= c.arena.exprs.count() { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                        self.obligations.append(<DeclarationAccessObligation.TryConversion body=index terminator=block.terminator expression=target.exprId />)
                    } else if target.tag == 4U64 {
                        if target.exprId >= c.arena.stmts.count() || (target.slot != 1U64 && target.slot != 2U64) { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                        self.obligations.append(<DeclarationAccessObligation.ForProtocol body=index terminator=block.terminator statement=target.exprId slot=target.slot />)
                    } else {
                        // A missing or unfinished selection is a broken frontend
                        // contract, not an unknown but valid runtime effect.
                        if target.tag != 1U64 { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                        val key = <CallSiteKey ownerFnIdx=target.ownerFnIdx originKind=target.originKind originStart=target.originStart originEnd=target.originEnd originSerial=target.originSerial slot=target.slot />
                        val template = c.decls.callTemplateIndex(siteKey: key)
                        if template >= c.decls.callTemplates.count() { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                        match c.decls.callTemplates[template].kind {
                            CallTemplateKind.Pending => { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                            CallTemplateKind.ExpectedValue => { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                                if callee >= c.arena.functionCount() { return <Result.Err error=<DeclarationAccessError.CallSelection body=self.owners[index] terminator=block.terminator /> /> }
                                if !c.arena.functionAt(index: callee).isAsync && !c.arena.functionAt(index: callee).isExtern {
                                    val function = c.arena.functionAt(index: callee)
                                    mut val receiverTag = 0U64
                                    if function.hasRecv {
                                        receiverTag = if function.selfInout { give 4U64 } else if function.selfMove { give 2U64 } else { give 3U64 }
                                    }
                                    val dependency = self.demand(owner: <DeclarationAccessNode.Function function=callee />)
                                    self.graph.edge(caller: index, callee: dependency, term: block.terminator, receiverTag: receiverTag)
                                }
                            }
                            _ => {}
                        }
                        // Preserve the selected sum (including proof, argument
                        // conversions and dynamic target) by immutable table ID.
                        // StaticMethod is not an edge to a guessed default body.
                        self.obligations.append(<DeclarationAccessObligation.Call body=index terminator=block.terminator template=template />)
                    }
                }
            }
            blockIndex += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn destruction(c: Comp, caller: U64, term: U64, recipe: U64 = 0U64) {
        if recipe != 0U64 || (term != 0U64 && !c.arena.typeIsClosed(ref: term)) {
            self.obligations.append(<DeclarationAccessObligation.Destruction body=caller typeTerm=term typeRecipe=recipe />)
            return
        }
        if term == 0U64 { return }
        val node = self.demand(owner: <DeclarationAccessNode.Destruction typeTerm=term />)
        self.graph.edge(caller: caller, callee: node)
    }

    inout fn destructionDependencies(c: inout Comp, node: U64, type: U64) -> Result[(), CompileDiagnostic] {
        val dependencies = try c.closedDestructionDependencies(typeRef: type)
        if dependencies.destructorDeclaration != 0U64 {
            val callee = self.demand(owner: <DeclarationAccessNode.Function function=dependencies.destructorDeclaration - 1U64 />)
            self.graph.edge(caller: node, callee: callee)
        }
        if dependencies.hasDynamicPayload {
            self.obligations.append(<DeclarationAccessObligation.Destruction body=node typeTerm=type typeRecipe=0U64 />)
        }
        mut val child = 0U64
        while child < dependencies.children.count() {
            self.destruction(c: c, caller: node, term: dependencies.children[child])
            child += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn close(c: inout Comp, templates: inout MidFunctionTemplates, requests: inout MidOwnershipRequests) -> Result[(), DeclarationAccessError] {
        mut val closureIndices: Dictionary[U64, U64] = [:]
        mut val closureFrontier = 0U64
        mut val index = 0U64
        while index < self.owners.count() {
            val owner = self.owners[index]
            match owner {
                DeclarationAccessNode.Function(function: val function) => {
                    if function >= c.arena.functionCount() {
                        return <Result.Err error=<DeclarationAccessError.Frontend diagnostic=c.diagnosticAt(offset: 0U64, msg: "internal error: effect request has no function declaration") /> />
                    }
                    val declaration = c.arena.functionAt(index: function)
                    if declaration.body != 0U64 && !declaration.isExtern {
                        match c.prepareLexicalBody(fnIdx: function) {
                            Result.Ok(value: _) => {}
                            Result.Err(error: val diagnostic) => { return <Result.Err error=<DeclarationAccessError.Frontend diagnostic=diagnostic /> /> }
                        }
                        val built = templates.body(c: inout c, function: function)
                        try self.body(c: inout c, index: index, built: built, requests: inout requests)
                    }
                }
                DeclarationAccessNode.Closure(bodyKey: val key) => {
                    // Lexical requests may have registered new closures since
                    // the previous root. Index each metadata row only once.
                    while closureFrontier < c.decls.semanticClosures.count() {
                        closureIndices[c.decls.semanticClosures[closureFrontier].bodyKey] = closureFrontier + 1U64
                        closureFrontier += 1U64
                    }
                    val row = closureIndices.getOr(key: key, fallback: 0U64)
                    if row == 0U64 {
                        return <Result.Err error=<DeclarationAccessError.Frontend diagnostic=c.diagnosticAt(offset: 0U64, msg: "internal error: effect request has no lexical closure") /> />
                    }
                    val built = ensureParametricMidClosureBody(c: inout c, closure: c.decls.semanticClosures[row - 1U64])
                    try self.body(c: inout c, index: index, built: built, requests: inout requests)
                }
                DeclarationAccessNode.GlobalInitializer => {
                    val built = templates.globalInitializer(c: inout c)
                    try self.body(c: inout c, index: index, built: built, requests: inout requests)
                }
                DeclarationAccessNode.Destruction(typeTerm: val type) => {
                    match self.destructionDependencies(c: inout c, node: index, type: type) {
                        Result.Ok(value: _) => {}
                        Result.Err(error: val diagnostic) => { return <Result.Err error=<DeclarationAccessError.Frontend diagnostic=diagnostic /> /> }
                    }
                }
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }
}

pub fn analyzeDeclarationGlobalAccess(c: inout Comp, templates: inout MidFunctionTemplates) -> Result[DeclarationAccessAnalysis, DeclarationAccessError] {
    mut val requests = <MidOwnershipRequests />
    return analyzeDeclarationGlobalAccessWithRequests(c: inout c, templates: inout templates, requests: inout requests)
}

fn hasMutableGlobals(c: Comp) -> Bool {
    mut val index = 0U64
    while index < c.arena.globals.count() {
        if c.arena.globals[index].mutable { return true }
        index += 1U64
    }
    return false
}

pub fn analyzeDeclarationGlobalAccessWithRequests(c: inout Comp, templates: inout MidFunctionTemplates, requests: inout MidOwnershipRequests) -> Result[DeclarationAccessAnalysis, DeclarationAccessError] {
    if !hasMutableGlobals(c: c) { return <Result.Ok value=<DeclarationAccessAnalysis /> /> }
    mut val roots: Array[DeclarationAccessNode] = []
    mut val index = 0U64
    while index < c.arena.functionCount() {
        roots.append(<DeclarationAccessNode.Function function=index />)
        index += 1U64
    }
    // Closure creation is not execution: closures are separate roots, never
    // implicit effect edges from the containing function.
    index = 0U64
    while index < c.decls.semanticClosures.count() {
        roots.append(<DeclarationAccessNode.Closure bodyKey=c.decls.semanticClosures[index].bodyKey />)
        index += 1U64
    }
    if c.arena.globals.count() != 0U64 { roots.append(<DeclarationAccessNode.GlobalInitializer />) }
    return analyzeDeclarationGlobalAccessRoots(c: inout c, templates: inout templates, requests: inout requests, roots: roots)
}

// This closes only known static global-effect dependencies of the roots.
// It neither proves whole-target checking nor discharges dynamic obligations.
pub fn analyzeDeclarationGlobalAccessRoots(c: inout Comp, templates: inout MidFunctionTemplates, requests: inout MidOwnershipRequests, roots: Array[DeclarationAccessNode]) -> Result[DeclarationAccessAnalysis, DeclarationAccessError] {
    if !hasMutableGlobals(c: c) { return <Result.Ok value=<DeclarationAccessAnalysis /> /> }
    mut val state = <DeclarationAccessState />
    mut val index = 0U64
    while index < roots.count() { state.demand(owner: roots[index])
        index += 1U64 }
    try state.close(c: inout c, templates: inout templates, requests: inout requests)
    return <Result.Ok value=<DeclarationAccessAnalysis nodes=state.owners conflictingNode=state.graph.solve(arena: c.mid) obligations=state.obligations /> />
}

// Local place conflicts do not require a mutable global or executable instance.
// Function snapshots are shared with global analysis and executable preparation.
fn declarationCallHasStorageArguments(c: Comp, term: MidTerminatorNode) -> Bool {
    mut val index = 0U64
    while index < term.args.len {
        val argument = c.mid.operands[c.mid.callArguments[term.args.start + index] - 1U64]
        if argument.tag == 2U64 || argument.tag == 4U64 || (argument.tag == 3U64 && argument.borrowsStorage) { return true }
        index += 1U64
    }
    // No pair can conflict when every argument is an independent value.
    // Unelaborated access markers remain subject to the later Access pass.
    return false
}

pub fn checkDeclarationBodyAccess(c: inout Comp, owner: DeclarationAccessNode, built: MidBodyBuild) -> Result[(), DeclarationAccessError] {
    match built.error { MidBuildError.None => {} _ => { return <Result.Err error=<DeclarationAccessError.Build body=owner error=built.error /> /> } }
    val body = c.mid.bodies[built.canonical.body - 1U64]
    val reachable = canonicalMidReachable(arena: c.mid, body: body)
    mut val index = 0U64
    while index < body.blocks.len {
        if reachable[index] {
            val block = c.mid.blocks[body.blocks.start + index]
            val term = c.mid.terminators[block.terminator - 1U64]
            if term.tag == 4U64 && declarationCallHasStorageArguments(c: c, term: term) {
                val target = c.mid.callTargets[term.callTarget - 1U64]
                mut val receiverTag = 0U64
                if target.tag == 1U64 {
                    val key = <CallSiteKey ownerFnIdx=target.ownerFnIdx originKind=target.originKind originStart=target.originStart originEnd=target.originEnd originSerial=target.originSerial slot=target.slot />
                    val template = c.decls.callTemplateIndex(siteKey: key)
                    if template < c.decls.callTemplates.count() {
                        match c.decls.callTemplates[template].kind {
                            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                                if callee >= c.arena.functionCount() { return <Result.Err error=<DeclarationAccessError.CallSelection body=owner terminator=block.terminator /> /> }
                                val function = c.arena.functionAt(index: callee)
                                if function.hasRecv {
                                    receiverTag = if function.selfInout { give 4U64 } else if function.selfMove { give 2U64 } else { give 3U64 }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                val conflict = canonicalMidCallAccessError(arena: c.mid, term: term, receiverTag: receiverTag)
                match conflict { MidVerifyError.None => {} _ => { return <Result.Err error=<DeclarationAccessError.LocalAccess body=owner error=conflict /> /> } }
            }
        }
        index += 1U64
    }
    return <Result.Ok value=() />
}

pub fn checkDeclarationLocalAccess(c: inout Comp, templates: inout MidFunctionTemplates) -> Result[(), DeclarationAccessError] {
    val count = c.arena.functionCount()
    mut val needed: Dictionary[U64, Bool] = [:]
    mut val site = 0U64
    while site < c.decls.callTemplates.count() {
        val template = c.decls.callTemplates[site]
        if template.mayHaveStorageArguments { needed[template.siteKey.ownerFnIdx] = true }
        site += 1U64
    }
    mut val index = 0U64
    while index < count {
        val function = c.arena.functionAt(index: index)
        if function.body != 0U64 && !function.isExtern {
            val owner = match c.semanticBodyOwner(fnIdx: index) {
                Result.Ok(value: val owner) => { give owner }
                Result.Err(error: val diagnostic) => { return <Result.Err error=<DeclarationAccessError.Frontend diagnostic=diagnostic /> /> }
            }
            if !needed.getOr(key: owner, fallback: false) { index += 1U64
                continue }
            val built = templates.body(c: inout c, function: index)
            try checkDeclarationBodyAccess(c: inout c, owner: <DeclarationAccessNode.Function function=index />, built: built)
        }
        index += 1U64
    }
    index = 0U64
    while index < c.decls.semanticClosures.count() {
        val closure = c.decls.semanticClosures[index]
        val built = ensureParametricMidClosureBody(c: inout c, closure: closure)
        try checkDeclarationBodyAccess(c: inout c, owner: <DeclarationAccessNode.Closure bodyKey=closure.bodyKey />, built: built)
        index += 1U64
    }
    if c.arena.globals.count() != 0U64 {
        val built = templates.globalInitializer(c: inout c)
        try checkDeclarationBodyAccess(c: inout c, owner: <DeclarationAccessNode.GlobalInitializer />, built: built)
    }
    return <Result.Ok value=() />
}
