// Name discovery retains declaration identity/category, not applicability or
// conformance authority. Consumers filter their operation before querying proof.

impl Comp {
    fn traitMemberNames(traitIndex: U64, memberId: U64, useOffset: U64, includeRequirements: Bool = true) -> TraitMemberNameCursor {
        val first = if includeRequirements || traitIndex >= self.decls.traitCount() { give 0U64 } else { give self.decls.traitAt(index: traitIndex).reqs.count() }
        return <TraitMemberNameCursor requirementSlot=first traitIndex=traitIndex memberId=memberId useOffset=useOffset providedFunction=self.arena.firstFunctionNamed(nameId: memberId) />
    }

    inout fn nextTraitMemberName(cursor: inout TraitMemberNameCursor) -> Optional[TraitMemberNameCandidate] {
        if cursor.traitIndex >= self.decls.traitCount() { return <Optional.None /> }
        val declaration = self.decls.traitAt(index: cursor.traitIndex)
        while cursor.requirementSlot < declaration.reqs.count() {
            val slot = cursor.requirementSlot
            cursor.requirementSlot += 1U64
            val requirement = self.traitReqAt(reqs: declaration.reqs, index: slot)
            if requirement.nameId == cursor.memberId { return <Optional.Some v=<TraitMemberNameCandidate.Requirement traitIndex=cursor.traitIndex slot=slot associated=requirement.isAssoc /> /> }
        }
        while cursor.providedFunction < self.arena.functionCount() {
            val index = cursor.providedFunction
            cursor.providedFunction = self.arena.nextFunctionNamed(index: index)
            val function = self.arena.functionAt(index: index)
            if !function.isProvided && function.originTraitOwner == 0U64 && function.hasRecv && function.body != 0U64 && function.recvId == declaration.nameId && function.provTraitOwner == declaration.nameStart {
                return <Optional.Some v=<TraitMemberNameCandidate.Provided traitIndex=cursor.traitIndex function=index associated=function.isAssoc visible=self.methodIsVisible(mf: function, offset: cursor.useOffset) /> />
            }
        }
        return <Optional.None />
    }
    inout fn preferredTraitMemberProofs(discovered: Array[StaticConformanceProof], traitOwner: U64, sourceOwners: Array[U64]) -> Array[StaticConformanceProof] {
        if sourceOwners.count() == 0U64 { return discovered }
        mut val ordered: Array[StaticConformanceProof] = []
        for proof in discovered { if self.traitProofMatchesSources(proof: proof, traitOwner: traitOwner, sourceOwners: sourceOwners) { ordered.append(proof) } }
        for proof in discovered { if !self.traitProofMatchesSources(proof: proof, traitOwner: traitOwner, sourceOwners: sourceOwners) { ordered.append(proof) } }
        return ordered
    }

    fn interfaceMemberNames(bound: U64, name: U64) -> InterfaceMemberNameCursor {
        return <InterfaceMemberNameCursor bound=bound name=name />
    }

    fn nextInterfaceMemberName(cursor: inout InterfaceMemberNameCursor) -> Optional[U64] {
        if cursor.bound >= self.boundExistentialInterfaces.count() { return <Optional.None /> }
        val bound = self.boundExistentialInterfaces[cursor.bound]
        if bound.source >= self.sourceExistentialInterfaces.count() { return <Optional.None /> }
        val interface = self.sourceExistentialInterfaces[bound.source]
        while cursor.next < interface.members.count() {
            val index = cursor.next
            cursor.next += 1U64
            if bound.canonicalMembers[index] != index { continue }
            val member = interface.members[index]
            if self.authoredRequirementViews[member.signature].declaration.nameId == cursor.name { return <Optional.Some v=index /> }
        }
        return <Optional.None />
    }

}
