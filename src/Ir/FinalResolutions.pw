// Frozen resolution index readers preserve full keys and table-count misses.
// Producers retain semantic publication; lookup depends only on stored facts.
pub impl Arena {
    fn finalCalleeKeyEqual(entry: U64, bodyId: U64, siteKey: CallSiteKey) -> Bool {
        val e: CallResolution = self.finalCallees[entry]
        return e.bodyId == bodyId && e.siteKey.sameKey(other: siteKey)
    }

    fn finalCalleeHash(bodyId: U64, siteKey: CallSiteKey) -> U64 {
        // Keep every intermediate below 2^32.  U64 overflow is a checked
        // runtime failure in the compiler itself, so an ordinary polynomial
        // hash must normalize each full-width source offset before mixing.
        val modulus: U64 = 4294967291U64
        mut val h: U64 = bodyId % modulus
        h = ((h + siteKey.ownerFnIdx % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originKind % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originStart % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originEnd % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originSerial % modulus) * 65537U64) % modulus
        h = ((h + siteKey.slot % modulus) * 65537U64) % modulus
        return h
    }

    fn finalCalleeIndexForKey(bodyId: U64, siteKey: CallSiteKey) -> U64 {
        val capacity: U64 = self.finalCalleeIndexSlots.count()
        if capacity == 0U64 { return self.finalCallees.count() }
        mut val indexSlot: U64 = self.finalCalleeHash(bodyId: bodyId, siteKey: siteKey) % capacity
        while self.finalCalleeIndexSlots[indexSlot] != 0U64 {
            val entry: U64 = self.finalCalleeIndexSlots[indexSlot] - 1U64
            if self.finalCalleeKeyEqual(entry: entry, bodyId: bodyId, siteKey: siteKey) { return entry }
            indexSlot = (indexSlot + 1U64) % capacity
        }
        return self.finalCallees.count()
    }

    fn finalAggregateHash(bodyId: U64, exprId: U64) -> U64 {
        val modulus: U64 = 4294967291U64
        return (((bodyId % modulus + exprId % modulus) * 65537U64) + 17U64) % modulus
    }

    fn finalTryIndex(bodyId: U64, exprId: U64) -> U64 {
        val capacity: U64 = self.finalTryIndexSlots.count()
        if capacity == 0U64 { return self.finalTries.count() }
        mut val slot: U64 = self.finalAggregateHash(bodyId: bodyId, exprId: exprId) % capacity
        while self.finalTryIndexSlots[slot] != 0U64 {
            val entry: U64 = self.finalTryIndexSlots[slot] - 1U64
            val fact: FinalTryResolution = self.finalTries[entry]
            if fact.bodyId == bodyId && fact.exprId == exprId { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.finalTries.count()
    }

    fn finalForIndex(bodyId: U64, stmtId: U64) -> U64 {
        val capacity: U64 = self.finalForIndexSlots.count()
        if capacity == 0U64 { return self.finalFors.count() }
        mut val slot: U64 = self.finalAggregateHash(bodyId: bodyId, exprId: stmtId) % capacity
        while self.finalForIndexSlots[slot] != 0U64 {
            val entry: U64 = self.finalForIndexSlots[slot] - 1U64
            val fact: FinalForResolution = self.finalFors[entry]
            if fact.bodyId == bodyId && fact.stmtId == stmtId { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.finalFors.count()
    }
}

impl Arena {
    inout fn rebuildFinalCalleeIndex(capacity: U64) {
        self.finalCalleeIndexSlots = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.finalCalleeIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.finalCalleeCount() {
            val e: CallResolution = self.finalCallees[entry]
            mut val slot: U64 = self.finalCalleeHash(bodyId: e.bodyId, siteKey: e.siteKey) % capacity
            while self.finalCalleeIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.finalCalleeIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureFinalCalleeIndex(nextCount: U64) {
        if self.finalCalleeIndexSlots.count() == 0U64 {
            self.rebuildFinalCalleeIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.finalCalleeIndexSlots.count() * 7U64 {
            self.rebuildFinalCalleeIndex(capacity: self.finalCalleeIndexSlots.count() * 2U64)
        }
    }

    inout fn pushFinalCalleeTypeArgs(args: Array[U64]) -> CallResolutionTypeArgRange {
        val start: U64 = self.finalCalleeTypeArgPool.count()
        mut val i: U64 = 0U64
        while i < args.count() {
            self.finalCalleeTypeArgPool.append(args[i])
            i += 1U64
        }
        return <CallResolutionTypeArgRange start=start len=args.count() />
    }

    inout fn pushFinalCalleeParameterTypes(types: Array[U64]) -> CallResolutionParameterTypeRange {
        val start: U64 = self.finalCalleeParameterTypePool.count()
        mut val i: U64 = 0U64
        while i < types.count() {
            self.finalCalleeParameterTypePool.append(types[i])
            i += 1U64
        }
        return <CallResolutionParameterTypeRange start=start len=types.count() />
    }

    inout fn pushFinalCalleeConversions(conversions: Array[ValueConversionProof]) -> CallResolutionConversionRange {
        val start: U64 = self.finalCalleeConversionPool.count()
        mut val i: U64 = 0U64
        while i < conversions.count() {
            self.finalCalleeConversionPool.append(self.appendValueConversionProof(proof: conversions[i]))
            i += 1U64
        }
        return <CallResolutionConversionRange start=start len=conversions.count() />
    }

    inout fn pushFinalCalleeArgumentPassings(passings: Array[CallArgumentPassing]) -> CallResolutionArgumentPassingRange {
        val start: U64 = self.finalCalleeArgumentPassingPool.count()
        mut val i: U64 = 0U64
        while i < passings.count() {
            self.finalCalleeArgumentPassingPool.append(passings[i])
            i += 1U64
        }
        return <CallResolutionArgumentPassingRange start=start len=passings.count() />
    }

}

pub impl Arena {
    fn finalCalleeCount() -> U64 { return self.finalCallees.count() }
    fn finalCalleeAt(index: U64) -> CallResolution { return self.finalCallees[index] }
    fn finalCalleeTypeArgumentCount() -> U64 { return self.finalCalleeTypeArgPool.count() }
    fn finalCalleeParameterCount() -> U64 { return self.finalCalleeParameterTypePool.count() }
    fn finalCalleeTypeArgAt(args: CallResolutionTypeArgRange, index: U64) -> U64 {
        return self.finalCalleeTypeArgPool[args.start + index]
    }

    fn finalCalleeParameterTypeAt(types: CallResolutionParameterTypeRange, index: U64) -> U64 {
        return self.finalCalleeParameterTypePool[types.start + index]
    }

    fn finalCalleeConversionAt(conversions: CallResolutionConversionRange, index: U64) -> U64 {
        return self.finalCalleeConversionPool[conversions.start + index]
    }

    fn finalCalleeArgumentPassingAt(passings: CallResolutionArgumentPassingRange, index: U64) -> CallArgumentPassing {
        return self.finalCalleeArgumentPassingPool[passings.start + index]
    }

    fn finalCalleeArgumentAt(arguments: CallResolutionArgumentRange, index: U64) -> CallEvaluationArgument {
        return self.finalCalleeArgumentPool[arguments.start + index]
    }

    fn beginFinalCallArguments() -> FinalCallArguments {
        return <FinalCallArguments start=self.finalCalleeArgumentPool.count() len=0U64 />
    }

    inout fn appendFinalCallArgument(arguments: FinalCallArguments, argument: CallEvaluationArgument) -> FinalCallArguments {
        if arguments.start + arguments.len != self.finalCalleeArgumentPool.count() { panic "final call argument builder is not at its construction frontier" }
        self.finalCalleeArgumentPool.append(argument)
        return <FinalCallArguments start=arguments.start len=arguments.len + 1U64 />
    }

    // Ranges supplied in row are never trusted; this store owns every payload.
    inout fn publishFinalCallee(row: CallResolution, typeArguments: Array[U64] = [], parameterTypes: Array[U64] = [], conversions: Array[ValueConversionProof] = [], passings: Array[CallArgumentPassing] = [], arguments: Optional[FinalCallArguments] = <Optional.None />) -> Bool {
        self.ensureFinalCalleeIndex(nextCount: self.finalCalleeCount() + 1U64)
        val capacity = self.finalCalleeIndexSlots.count()
        mut val slot = self.finalCalleeHash(bodyId: row.bodyId, siteKey: row.siteKey) % capacity
        while self.finalCalleeIndexSlots[slot] != 0U64 {
            if self.finalCalleeKeyEqual(entry: self.finalCalleeIndexSlots[slot] - 1U64, bodyId: row.bodyId, siteKey: row.siteKey) { return false }
            slot = (slot + 1U64) % capacity
        }
        val types = self.pushFinalCalleeTypeArgs(args: typeArguments)
        val parameters = self.pushFinalCalleeParameterTypes(types: parameterTypes)
        val conversionRange = self.pushFinalCalleeConversions(conversions: conversions)
        val passingRange = self.pushFinalCalleeArgumentPassings(passings: passings)
        mut val argumentRange = <CallResolutionArgumentRange start=0U64 len=0U64 />
        match arguments {
            Optional.Some(v: val prepared) => {
                if prepared.start > self.finalCalleeArgumentPool.count() || prepared.len > self.finalCalleeArgumentPool.count() - prepared.start { panic "final call argument builder range is not owned by this store" }
                argumentRange = <CallResolutionArgumentRange start=prepared.start len=prepared.len />
            }
            Optional.None => {}
        }
        self.finalCallees.append(<CallResolution bodyId=row.bodyId calleeBodyId=row.calleeBodyId siteKey=row.siteKey exprId=row.exprId siteIsStmt=row.siteIsStmt slot=row.slot callee=row.callee receiverPassing=row.receiverPassing recvTypeRef=row.recvTypeRef resultTypeRef=row.resultTypeRef resultProjection=row.resultProjection target=row.target calleeTypeArgs=types parameterTypeRefs=parameters argumentConversions=conversionRange argumentPassings=passingRange arguments=argumentRange />)
        self.finalCalleeIndexSlots.set(i: slot, value: self.finalCalleeCount())
        return true
    }
}
