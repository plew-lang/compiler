// Membership skips unrelated modules without changing row identity or order.
pub impl ModuleExports {
    fn count() -> U64 { return self.rows.count() }
    fn at(index: U64) -> Bind { return self.rows[index] }
    inout fn append(entry~: Bind) {
        val row = self.rows.count() + 1U64
        val tail = self.moduleTails.getOr(key: entry.fieldStart, fallback: 0U64)
        self.rows.append(entry)
        self.nextRows.append(0U64)
        if tail == 0U64 { self.moduleHeads[entry.fieldStart] = row }
        else { self.nextRows[tail - 1U64] = row }
        self.moduleTails[entry.fieldStart] = row
    }
    fn firstIn(moduleId: U64) -> U64 {
        val row = self.moduleHeads.getOr(key: moduleId, fallback: 0U64)
        if row == 0U64 { return self.rows.count() }
        return row - 1U64
    }
    fn nextIn(index: U64) -> U64 {
        val row = self.nextRows[index]
        if row == 0U64 { return self.rows.count() }
        return row - 1U64
    }
}
