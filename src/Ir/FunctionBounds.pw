// Row IDs are declaration evidence. Registration-order links only narrow
// function queries; they never reorder or replace the canonical rows.
pub impl Decls {
    inout fn registerFunctionBound(bound~: FuncBound) {
        val entry = self.functionBoundRows.count() + 1U64
        val tail = self.functionBoundTails.getOr(key: bound.fnIdx, fallback: 0U64)
        self.functionBoundRows.append(bound)
        self.functionBoundNext.append(0U64)
        if tail == 0U64 { self.functionBoundHeads[bound.fnIdx] = entry }
        else { self.functionBoundNext[tail - 1U64] = entry }
        self.functionBoundTails[bound.fnIdx] = entry
    }
    fn functionBoundCount() -> U64 { return self.functionBoundRows.count() }
    fn functionBoundAt(index: U64) -> FuncBound { return self.functionBoundRows[index] }
    fn firstFunctionBound(fnIdx: U64) -> U64 {
        val entry = self.functionBoundHeads.getOr(key: fnIdx, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.functionBoundRows.count()
    }
    fn nextFunctionBound(index: U64) -> U64 {
        val entry = self.functionBoundNext[index]
        if entry != 0U64 { return entry - 1U64 }
        return self.functionBoundRows.count()
    }
}
