// Body IDs and candidate links are one-based; zero is always a miss.
// The registry owns navigation, while Comp owns semantic environment equality.
pub impl Arena {
    fn bodyInstanceCount() -> U64 { return self.bodyInstances.count() }
    fn bodyInstanceAt(index: U64) -> BodyInstance { return self.bodyInstances[index] }

    fn bodyOrigin(bodyId: U64) -> BodyOrigin { return self.bodyOrigins[bodyId - 1U64] }
    fn bodyIsCallable(bodyId: U64) -> Bool {
        match self.bodyOrigin(bodyId: bodyId) { BodyOrigin.Callable => { return true } _ => { return false } }
    }

    inout fn registerBodyInstance(instance~: BodyInstance, origin: BodyOrigin = <BodyOrigin.Callable />) -> U64 {
        val bodyId = self.bodyInstances.count() + 1U64
        val tail = self.bodyFunctionTails.getOr(key: instance.fnIdx, fallback: 0U64)
        self.bodyInstances.append(instance)
        self.bodyOrigins.append(origin)
        self.bodySignatures.append(<BodySignature />)
        self.bodyFunctionNext.append(0U64)
        if !self.bodyIsCallable(bodyId: bodyId) { return bodyId }
        if tail == 0U64 {
            self.bodyFunctionHeads[instance.fnIdx] = bodyId
        } else {
            self.bodyFunctionNext[tail - 1U64] = bodyId
        }
        self.bodyFunctionTails[instance.fnIdx] = bodyId
        return bodyId
    }

    inout fn setBodyAdapter(bodyId: U64, targetBodyId: U64, callResolutionId: U64 = 0U64) {
        val instance = self.bodyInstances[bodyId - 1U64]
        val resolution = if callResolutionId == 0U64 { give instance.adapterCallResolutionId } else { give callResolutionId }
        self.bodyInstances[bodyId - 1U64] = <BodyInstance fnIdx=instance.fnIdx environment=instance.environment adapterTargetBodyId=targetBodyId adapterCallResolutionId=resolution />
    }

    fn bodySignature(bodyId: U64) -> BodySignature {
        if bodyId == 0U64 || bodyId > self.bodySignatures.count() { return <BodySignature /> }
        return self.bodySignatures[bodyId - 1U64]
    }

    inout fn setBodySignature(bodyId: U64, parameters: Array[U64], passings: Array[CallArgumentPassing], result: U64, receiverType: U64 = 0U64, receiverPassing: CallReceiverPassing = <CallReceiverPassing.None />, bodyResult: U64 = 18446744073709551615U64) {
        self.bodySignatures[bodyId - 1U64] = <BodySignature ready=true receiverType=receiverType receiverPassing=receiverPassing parameterTypes=parameters parameterPassings=passings resultType=result bodyResultType=if bodyResult == 18446744073709551615U64 { give result } else { give bodyResult } />
    }

    fn closureSignature(bodyId: U64) -> ClosureSignature {
        val signature = self.bodySignature(bodyId: bodyId)
        if signature.closureSignatureId == 0U64 { return <ClosureSignature /> }
        return self.closureSignatures[signature.closureSignatureId - 1U64]
    }

    inout fn setClosureSignature(bodyId: U64, parameters: Array[U64], passings: Array[CallArgumentPassing], result: U64, closure: ClosureSignature) {
        mut val index = self.bodySignatures[bodyId - 1U64].closureSignatureId
        if index == 0U64 {
            self.closureSignatures.append(closure)
            index = self.closureSignatures.count()
        } else { self.closureSignatures[index - 1U64] = closure }
        self.bodySignatures[bodyId - 1U64] = <BodySignature ready=true parameterTypes=parameters parameterPassings=passings resultType=result bodyResultType=result closureSignatureId=index />
    }

    inout fn clearBodyTypeResults() { self.bodyTypeResults.clear() }

    inout fn setBodyTypeResult(bodyId: U64, sourceKind: U64, sourceId: U64, resultType: U64) {
        if bodyId == 0U64 || bodyId > self.bodyInstances.count() || sourceId == 0U64 { return }
        self.bodyTypeResults.set(bodyId: bodyId, sourceKind: sourceKind, sourceId: sourceId, resultType: resultType)
    }

    fn bodyTypeResult(bodyId: U64, sourceKind: U64, sourceId: U64) -> BodyTypeResult {
        if bodyId == 0U64 || bodyId > self.bodyInstances.count() || sourceId == 0U64 { return <BodyTypeResult /> }
        return self.bodyTypeResults.get(bodyId: bodyId, sourceKind: sourceKind, sourceId: sourceId)
    }

    inout fn setBodyTypeRecipeResult(bodyId: U64, recipeId: U64, resultType: U64) {
        self.setBodyTypeResult(bodyId: bodyId, sourceKind: 1U64, sourceId: recipeId, resultType: resultType)
    }

    inout fn setBodyTypeTermResult(bodyId: U64, typeTerm: U64, resultType: U64) {
        self.setBodyTypeResult(bodyId: bodyId, sourceKind: 2U64, sourceId: typeTerm, resultType: resultType)
    }

    fn bodyTypeTermResult(bodyId: U64, typeTerm: U64) -> BodyTypeResult {
        return self.bodyTypeResult(bodyId: bodyId, sourceKind: 2U64, sourceId: typeTerm)
    }

    fn firstBodyInstanceForFunction(functionIndex: U64) -> U64 {
        return self.bodyFunctionHeads.getOr(key: functionIndex, fallback: 0U64)
    }

    fn nextBodyInstanceForFunction(bodyId: U64) -> U64 {
        return self.bodyFunctionNext[bodyId - 1U64]
    }
}

// The result rows and buckets are one value. Probing needs this table only,
// rather than an Arena snapshot containing every unrelated frontend pool.
impl BodyTypeResultTable {
    inout fn clear() {
        self.rows = []
        self.slots = []
    }

    fn hash(bodyId: U64, sourceKind: U64, sourceId: U64) -> U64 {
        // Fx-style word mixing (rust-lang/rustc-hash): these are internal IDs,
        // not string keys. Rotate high entropy into bucket low bits.
        val multiplier = 17380933483125451205U64
        mut val hash = U64.wrappingMul(bodyId, multiplier)
        hash = U64.wrappingMul(U64.wrappingAdd(hash, sourceKind), multiplier)
        hash = U64.wrappingMul(U64.wrappingAdd(hash, sourceId), multiplier)
        return (hash << 26U64) | (hash >> 38U64)
    }

    fn slot(bodyId: U64, sourceKind: U64, sourceId: U64) -> U64 {
        val capacity = self.slots.count()
        mut val slot = self.hash(bodyId: bodyId, sourceKind: sourceKind, sourceId: sourceId) % capacity
        while self.slots[slot] != 0U64 {
            val row = self.rows[self.slots[slot] - 1U64]
            if row.bodyId == bodyId && row.sourceKind == sourceKind && row.sourceId == sourceId { return slot }
            slot = (slot + 1U64) % capacity
        }
        return slot
    }

    inout fn ensureCapacity() {
        val count = self.rows.count() + 1U64
        val previous = self.slots.count()
        if previous != 0U64 && count * 2U64 < previous { return }
        val capacity = if previous == 0U64 { give 64U64 } else { give previous * 2U64 }
        self.slots = []
        mut val slot = 0U64
        while slot < capacity { self.slots.append(0U64) slot += 1U64 }
        mut val index = 0U64
        while index < self.rows.count() {
            val row = self.rows[index]
            val target = self.slot(bodyId: row.bodyId, sourceKind: row.sourceKind, sourceId: row.sourceId)
            self.slots[target] = index + 1U64
            index += 1U64
        }
    }

    inout fn set(bodyId: U64, sourceKind: U64, sourceId: U64, resultType: U64) {
        self.ensureCapacity()
        val slot = self.slot(bodyId: bodyId, sourceKind: sourceKind, sourceId: sourceId)
        val entry = self.slots[slot]
        val row = <BodyTypeResult bodyId=bodyId sourceKind=sourceKind sourceId=sourceId resultType=resultType />
        if entry != 0U64 { self.rows[entry - 1U64] = row }
        else {
            self.rows.append(row)
            self.slots[slot] = self.rows.count()
        }
    }

    fn get(bodyId: U64, sourceKind: U64, sourceId: U64) -> BodyTypeResult {
        if self.slots.count() == 0U64 { return <BodyTypeResult /> }
        val slot = self.slot(bodyId: bodyId, sourceKind: sourceKind, sourceId: sourceId)
        val entry = self.slots[slot]
        if entry == 0U64 { return <BodyTypeResult /> }
        return self.rows[entry - 1U64]
    }

}
