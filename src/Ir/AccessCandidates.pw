// Lower publishes immutable access provenance. Both ExprId views navigate to
// the first registered candidate; they do not become semantic call identities.
pub impl Decls {
    inout fn registerAccessCandidate(candidate~: AccessCandidate, expressionCount: U64) {
        if candidate.readExpr >= expressionCount || candidate.placeExpr >= expressionCount || candidate.writeExpr >= expressionCount {
            panic "access candidate expression is outside the arena"
        }
        val index = self.accessCandidateRows.count()
        self.accessCandidateRows.append(candidate)
        self.indexAccessCandidate(exprId: candidate.readExpr, index: index)
        self.indexAccessCandidate(exprId: candidate.placeExpr, index: index)
        self.registerPlaceSource(exprId: candidate.readExpr, source: candidate.placeExpr, expressionCount: expressionCount)
    }

    fn accessCandidateCount() -> U64 { return self.accessCandidateRows.count() }
    fn accessCandidateAt(index: U64) -> AccessCandidate { return self.accessCandidateRows[index] }

    fn accessCandidateForExpr(exprId: U64) -> U64 {
        if exprId < self.accessCandidateByExpr.count() {
            val entry = self.accessCandidateByExpr[exprId]
            if entry != 0U64 { return entry - 1U64 }
        }
        return self.accessCandidateRows.count()
    }

    // Lower publishes storage provenance for getters and transparent views.
    // This is a single lookup, not a traversal or a second expression analysis.
    fn placeSource(exprId: U64) -> U64 {
        if exprId < self.placeSourceByExpr.count() {
            val entry = self.placeSourceByExpr[exprId]
            if entry != 0U64 { return entry - 1U64 }
        }
        return exprId
    }

    inout fn registerPlaceSource(exprId: U64, source: U64, expressionCount: U64) {
        if exprId >= expressionCount || source >= expressionCount { panic "storage provenance is outside the expression arena" }
        while self.placeSourceByExpr.count() <= exprId { self.placeSourceByExpr.append(0U64) }
        if self.placeSourceByExpr[exprId] == 0U64 { self.placeSourceByExpr[exprId] = source + 1U64 }
    }

}

impl Decls {
    inout fn indexAccessCandidate(exprId: U64, index: U64) {
        // ExprIds are dense arena indices. Zero is absence, including holes
        // and future expressions; candidate indices are stored one-based.
        while self.accessCandidateByExpr.count() <= exprId {
            self.accessCandidateByExpr.append(0U64)
        }
        if self.accessCandidateByExpr[exprId] == 0U64 {
            self.accessCandidateByExpr[exprId] = index + 1U64
        }

    }
}
