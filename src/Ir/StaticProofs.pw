// Append-only evidence storage. Existing IDs and their payloads are never replaced.
impl Arena {
    fn declarationBoundKind(source: DeclarationBoundRef) -> U64 {
        match source {
            DeclarationBoundRef.Function(index: _) => { return 0U64 }
            DeclarationBoundRef.Conformance(index: _) => { return 1U64 }
            DeclarationBoundRef.TraitSubject(index: _) => { return 2U64 }
            DeclarationBoundRef.AssociatedType(index: _) => { return 3U64 }
            DeclarationBoundRef.MethodReceiver(index: _) => { return 4U64 }
            DeclarationBoundRef.Requirement(index: _) => { return 5U64 }
        }
    }

    fn declarationBoundIndex(source: DeclarationBoundRef) -> U64 {
        match source {
            DeclarationBoundRef.Function(val index) => { return index }
            DeclarationBoundRef.Conformance(val index) => { return index }
            DeclarationBoundRef.TraitSubject(val index) => { return index }
            DeclarationBoundRef.AssociatedType(val index) => { return index }
            DeclarationBoundRef.MethodReceiver(val index) => { return index }
            DeclarationBoundRef.Requirement(val index) => { return index }
        }
    }

    // The scalar proof reader validates kind before reconstructing evidence.
    fn thawDeclarationBound(kind: U64, index: U64) -> DeclarationBoundRef {
        if kind == 0U64 { return <DeclarationBoundRef.Function index=index /> }
        if kind == 1U64 { return <DeclarationBoundRef.Conformance index=index /> }
        if kind == 2U64 { return <DeclarationBoundRef.TraitSubject index=index /> }
        if kind == 3U64 { return <DeclarationBoundRef.AssociatedType index=index /> }
        if kind == 4U64 { return <DeclarationBoundRef.MethodReceiver index=index /> }
        return <DeclarationBoundRef.Requirement index=index />
    }

    inout fn freezeWitnessMatch(witness: WitnessMatch) -> FrozenWitnessMatch {
        val start: U64 = self.staticProofWitnessBindPool.count()
        mut val i: U64 = 0U64
        while i < witness.binds.count() {
            self.staticProofWitnessBindPool.append(witness.binds[i])
            i += 1U64
        }
        return <FrozenWitnessMatch selfRef=witness.selfRef conformIdx=witness.conformIdx binds=start bindCount=witness.binds.count() conditions=witness.conditions />
    }

    fn frozenWitnessMatchAt(index: U64) -> FrozenWitnessMatch {
        return self.staticProofWitnessPool[index]
    }

    fn thawFrozenWitnessMatch(witness: FrozenWitnessMatch) -> WitnessMatch {
        mut val binds: Array[WitnessBind] = []
        mut val i: U64 = 0U64
        while i < witness.bindCount {
            binds.append(self.staticProofWitnessBindPool[witness.binds + i])
            i += 1U64
        }
        return <WitnessMatch selfRef=witness.selfRef conformIdx=witness.conformIdx binds=binds conditions=witness.conditions />
    }

}

pub impl Arena {
    inout fn appendStaticConformanceProof(proof: StaticConformanceProof) -> U64 {
        val id: U64 = self.staticProofs.count() + 1U64
        match proof {
            StaticConformanceProof.Missing => {
                self.staticProofs.append(<StaticProofNode tag=0U64 />)
            }
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                val frozen: FrozenWitnessMatch = self.freezeWitnessMatch(witness: witness)
                self.staticProofs.append(<StaticProofNode tag=1U64 conformIdx=frozen.conformIdx witnessBinds=frozen.binds witnessBindCount=frozen.bindCount witnessSelfRef=frozen.selfRef witnessConditions=frozen.conditions />)
            }
            StaticConformanceProof.AssumedBound(source: val boundRef) => {
                self.staticProofs.append(<StaticProofNode tag=2U64 boundKind=self.declarationBoundKind(source: boundRef) boundIdx=self.declarationBoundIndex(source: boundRef) />)
            }
            StaticConformanceProof.AssumedTraitPath(source: val boundRef, steps: val steps, edges: val edges) => {
                val start: U64 = self.staticProofWitnessPool.count()
                mut val i: U64 = 0U64
                while i < edges.count() {
                    self.staticProofWitnessPool.append(self.freezeWitnessMatch(witness: edges[i]))
                    i += 1U64
                }
                val supertraits = self.staticProofSupertraitPool.count()
                for val step in steps { self.staticProofSupertraitPool.append(step) }
                self.staticProofs.append(<StaticProofNode supertraits=supertraits supertraitCount=steps.count() tag=3U64 boundKind=self.declarationBoundKind(source: boundRef) boundIdx=self.declarationBoundIndex(source: boundRef) path=start pathCount=edges.count() />)
            }
            StaticConformanceProof.AssumedSupertraitPath(source: val boundRef, steps: val steps) => {
                val start: U64 = self.staticProofSupertraitPool.count()
                mut val i: U64 = 0U64
                while i < steps.count() {
                    self.staticProofSupertraitPool.append(steps[i])
                    i += 1U64
                }
                self.staticProofs.append(<StaticProofNode tag=4U64 boundKind=self.declarationBoundKind(source: boundRef) boundIdx=self.declarationBoundIndex(source: boundRef) path=start pathCount=steps.count() />)
            }
            StaticConformanceProof.TraitSelf(traitIdx: val traitIdx, receiverRef: val receiverRef, traitArgs: val traitArgs) => {
                val start: U64 = self.staticProofU64Pool.count()
                mut val i: U64 = 0U64
                while i < traitArgs.count() {
                    self.staticProofU64Pool.append(traitArgs[i])
                    i += 1U64
                }
                self.staticProofs.append(<StaticProofNode tag=5U64 traitIdx=traitIdx receiverRef=receiverRef path=start pathCount=traitArgs.count() />)
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: val terminalConformIdx) => {
                val start: U64 = self.staticProofWitnessPool.count()
                mut val i: U64 = 0U64
                while i < edges.count() {
                    self.staticProofWitnessPool.append(self.freezeWitnessMatch(witness: edges[i]))
                    i += 1U64
                }
                self.staticProofs.append(<StaticProofNode tag=6U64 path=start pathCount=edges.count() terminalConformIdx=terminalConformIdx />)
            }
        }
        return id
    }

    // Transitional compatibility reader. It is used only while Mid's draft
    // vocabulary still carries legacy proof values; canonical tables retain
    // IDs, and Mid's canonical freeze removes this reconstruction entirely.
    fn staticConformanceProof(id: U64) -> StaticConformanceProof {
        if id == 0U64 || id > self.staticProofs.count() { return <StaticConformanceProof.Missing /> }
        return self.decodeStaticConformanceProof(node: self.staticProofs[id - 1U64])
    }

    // Representation decoder; does not publish a row or grant evidence authority.
    fn decodeStaticConformanceProof(node: StaticProofNode) -> StaticConformanceProof {
        if node.tag == 0U64 { return <StaticConformanceProof.Missing /> }
        if node.tag == 1U64 {
            return <StaticConformanceProof.ConcreteWitness witness=self.thawFrozenWitnessMatch(witness: <FrozenWitnessMatch selfRef=node.witnessSelfRef conformIdx=node.conformIdx binds=node.witnessBinds bindCount=node.witnessBindCount conditions=node.witnessConditions />) />
        }
        if node.tag >= 2U64 && node.tag <= 4U64 && node.boundKind > 5U64 { return <StaticConformanceProof.Missing /> }
        if node.tag == 2U64 { return <StaticConformanceProof.AssumedBound source=self.thawDeclarationBound(kind: node.boundKind, index: node.boundIdx) /> }
        if node.tag == 3U64 {
            mut val edges: Array[WitnessMatch] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                edges.append(self.thawFrozenWitnessMatch(witness: self.staticProofWitnessPool[node.path + i]))
                i += 1U64
            }
            mut val steps: Array[SupertraitRef] = []
            i = 0U64
            while i < node.supertraitCount { steps.append(self.staticProofSupertraitPool[node.supertraits + i]) i += 1U64 }
            return <StaticConformanceProof.AssumedTraitPath source=self.thawDeclarationBound(kind: node.boundKind, index: node.boundIdx) steps=steps edges=edges />
        }
        if node.tag == 4U64 {
            mut val steps: Array[SupertraitRef] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                steps.append(self.staticProofSupertraitPool[node.path + i])
                i += 1U64
            }
            return <StaticConformanceProof.AssumedSupertraitPath source=self.thawDeclarationBound(kind: node.boundKind, index: node.boundIdx) steps=steps />
        }
        if node.tag == 5U64 {
            mut val traitArgs: Array[U64] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                traitArgs.append(self.staticProofU64Pool[node.path + i])
                i += 1U64
            }
            return <StaticConformanceProof.TraitSelf traitIdx=node.traitIdx receiverRef=node.receiverRef traitArgs=traitArgs />
        }
        if node.tag == 6U64 {
            mut val edges: Array[WitnessMatch] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                edges.append(self.thawFrozenWitnessMatch(witness: self.frozenWitnessMatchAt(index: node.path + i)))
                i += 1U64
            }
            return <StaticConformanceProof.TraitPath edges=edges terminalConformIdx=node.terminalConformIdx />
        }
        return <StaticConformanceProof.Missing />
    }

    fn hasStaticConformanceProof(id: U64) -> Bool {
        return id != 0U64 && id <= self.staticProofs.count() && self.staticProofs[id - 1U64].tag != 0U64
    }
}
