// Rows and their subject-domain index share one append-only owner. Candidate
// indices are original row IDs, preserving witness provenance and cycle scopes.
pub impl Decls {
    fn conformCount() -> U64 { return self.conformRows.count() }
    fn conformAt(index: U64) -> Conform { return self.conformRows[index] }
    fn traitSubjectConformCount() -> U64 { return self.traitSubjectConformIndices.count() }
    fn traitSubjectConformIndexAt(index: U64) -> U64 { return self.traitSubjectConformIndices[index] }

    inout fn registerConform(declaration~: Conform) {
        if declaration.subjectTraitOwner != 0U64 {
            self.traitSubjectConformIndices.append(self.conformRows.count())
        }
        self.conformRows.append(declaration)
    }
    // Complete declaration-owned callable forms before proofs are requested.
    // The row identity and subject index remain stable.
    inout fn completeConformWitnesses(index: U64, witnesses: ConformWitnessRange, functions: ConformFuncIdRange) {
        val source = self.conformRows[index]
        self.conformRows.set(i: index, value: <Conform
            sourceModule=source.sourceModule typeStart=source.typeStart typeLen=source.typeLen typeId=source.typeId
            subjectTraitOwner=source.subjectTraitOwner subjectTy=source.subjectTy subjectArgs=source.subjectArgs
            typeParams=source.typeParams bounds=source.bounds typeArity=source.typeArity
            traitStart=source.traitStart traitLen=source.traitLen traitId=source.traitId traitArgs=source.traitArgs
            derived=source.derived isPub=source.isPub extId=source.extId viewRootId=source.viewRootId
            defOffset=source.defOffset assocBindingIds=source.assocBindingIds witnessed=witnesses witnessFuncIds=functions />)
    }
}
