// These append-only declarations and their name summaries have one owner.
// Name membership is the legacy global query, not lexical binder resolution.
pub impl Arena {
    fn functionCount() -> U64 { return self.funcs.count() }
    fn functionAt(index: U64) -> Func { return self.funcs[index] }
    fn structCount() -> U64 { return self.structs.count() }
    fn structAt(index: U64) -> StructDef { return self.structs[index] }
    fn enumCount() -> U64 { return self.enums.count() }
    fn enumAt(index: U64) -> EnumDef { return self.enums[index] }

    fn enumVariantAt(enumIndex: U64, variantIndex: U64) -> Variant {
        val declaration = self.enums[enumIndex]
        return declaration.variants[variantIndex]
    }
    fn enumFieldAt(enumIndex: U64, variantIndex: U64, fieldIndex: U64) -> FieldDef {
        val variant = self.enumVariantAt(enumIndex: enumIndex, variantIndex: variantIndex)
        return variant.fields[fieldIndex]
    }
    fn structFieldAt(structIndex: U64, fieldIndex: U64) -> FieldDef {
        val declaration = self.structs[structIndex]
        return declaration.fields[fieldIndex]
    }

    inout fn registerStruct(declaration~: StructDef) {
        if self.structsByOffset.getOr(key: declaration.defOffset, fallback: 0U64) == 0U64 {
            self.structsByOffset[declaration.defOffset] = self.structs.count() + 1U64
        }
        val entry = self.structs.count() + 1U64
        val tail = self.structNameTails.getOr(key: declaration.nameId, fallback: 0U64)
        self.structNameNext.append(0U64)
        if tail == 0U64 {
            self.structNameHeads[declaration.nameId] = entry
        } else {
            self.structNameNext[tail - 1U64] = entry
        }
        self.structNameTails[declaration.nameId] = entry
        if declaration.typeParams.count() == 0U64 {
            if self.concreteStructNameHeads.getOr(key: declaration.nameId, fallback: 0U64) == 0U64 {
                self.concreteStructNameHeads[declaration.nameId] = entry
            }
        } else {
            if self.genericStructNameHeads.getOr(key: declaration.nameId, fallback: 0U64) == 0U64 {
                self.genericStructNameHeads[declaration.nameId] = entry
            }
        }
        if declaration.typeParams.count() == 0U64 { self.concreteTypeNameIds.insert(declaration.nameId) }
        for val parameter in declaration.typeParams { self.typeParameterNameIds.insert(parameter.nameId) }
        self.structs.append(declaration)
    }

    fn firstStructNamed(nameId: U64) -> U64 {
        val entry = self.structNameHeads.getOr(key: nameId, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.structs.count()
    }

    fn firstGenericStructNamed(nameId: U64) -> U64 {
        val entry = self.genericStructNameHeads.getOr(key: nameId, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.structs.count()
    }

    fn firstConcreteStructNamed(nameId: U64) -> U64 {
        val entry = self.concreteStructNameHeads.getOr(key: nameId, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.structs.count()
    }

    fn nextStructNamed(index: U64) -> U64 {
        val entry = self.structNameNext[index]
        if entry != 0U64 { return entry - 1U64 }
        return self.structs.count()
    }

    inout fn registerEnum(declaration~: EnumDef) {
        if self.enumsByOffset.getOr(key: declaration.defOffset, fallback: 0U64) == 0U64 {
            self.enumsByOffset[declaration.defOffset] = self.enums.count() + 1U64
        }
        if declaration.typeParams.count() == 0U64 { self.concreteTypeNameIds.insert(declaration.nameId) }
        for val parameter in declaration.typeParams { self.typeParameterNameIds.insert(parameter.nameId) }
        self.enums.append(declaration)
    }

    inout fn registerFunction(declaration~: Func) {
        mut val index: U64 = 0U64
        while index < declaration.typeParams.len {
            val parameter = self.funcBindAt(binds: declaration.typeParams, index: index)
            self.typeParameterNameIds.insert(parameter.nameId)
            index += 1U64
        }
        self.funcs.append(declaration)
    }

    fn hasTypeParameterName(nameId: U64) -> Bool {
        return !self.concreteTypeNameIds.contains(nameId) && self.typeParameterNameIds.contains(nameId)
    }

    inout fn registerFuncBinds(binds: Array[Bind]) -> FuncBindRange {
        val start: U64 = self.funcBindPool.count()
        for val bind in binds { self.funcBindPool.append(bind) }
        return <FuncBindRange start=start len=binds.count() />
    }

    fn funcBindAt(binds: FuncBindRange, index: U64) -> Bind {
        return self.funcBindPool[binds.start + index]
    }
}

// Offset indexes preserve the first declaration within each category.
pub impl Arena {
    fn structNameByOffset(offset: U64) -> Optional[DeclarationName] {
        val entry = self.structsByOffset.getOr(key: offset, fallback: 0U64)
        if entry == 0U64 { return <Optional.None /> }
        val declaration = self.structs[entry - 1U64]
        return <Optional.Some v=<DeclarationName start=declaration.nameStart len=declaration.nameLen /> />
    }
    fn enumNameByOffset(offset: U64) -> Optional[DeclarationName] {
        val entry = self.enumsByOffset.getOr(key: offset, fallback: 0U64)
        if entry == 0U64 { return <Optional.None /> }
        val declaration = self.enums[entry - 1U64]
        return <Optional.Some v=<DeclarationName start=declaration.nameStart len=declaration.nameLen /> />
    }
    fn newtypeCount() -> U64 { return self.newtypes.count() }
    fn newtypeAt(index: U64) -> NewtypeDef { return self.newtypes[index] }
    inout fn registerNewtype(declaration~: NewtypeDef) {
        if self.newtypesByOffset.getOr(key: declaration.defOffset, fallback: 0U64) == 0U64 {
            self.newtypesByOffset[declaration.defOffset] = self.newtypes.count() + 1U64
        }
        self.newtypes.append(declaration)
    }
    fn newtypeNameByOffset(offset: U64) -> Optional[DeclarationName] {
        val entry = self.newtypesByOffset.getOr(key: offset, fallback: 0U64)
        if entry == 0U64 { return <Optional.None /> }
        val declaration = self.newtypes[entry - 1U64]
        return <Optional.Some v=<DeclarationName start=declaration.nameStart len=declaration.nameLen /> />
    }
}

// Offset indexes preserve the first declaration within each category.
pub impl Decls {
    fn traitCount() -> U64 { return self.traits.count() }
    fn traitAt(index: U64) -> TraitDef { return self.traits[index] }
    inout fn registerTrait(declaration~: TraitDef) {
        if self.traitsByOffset.getOr(key: declaration.nameStart, fallback: 0U64) == 0U64 {
            self.traitsByOffset[declaration.nameStart] = self.traits.count() + 1U64
        }
        self.traits.append(declaration)
    }
    fn traitNameByOffset(offset: U64) -> Optional[DeclarationName] {
        val entry = self.traitsByOffset.getOr(key: offset, fallback: 0U64)
        if entry == 0U64 { return <Optional.None /> }
        val declaration = self.traits[entry - 1U64]
        return <Optional.Some v=<DeclarationName start=declaration.nameStart len=declaration.nameLen /> />
    }
}
