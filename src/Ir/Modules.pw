// Source registration owns both file provenance and derived module attributes.
// The loader supplies resolved package roles; physical directory names do not
// confer a Syntax compatibility role on arbitrary source files.
pub impl Modules {
    inout fn registerPublicDeclaration(offset: U64) { self.publicDeclarationOffsets.insert(offset) }
    fn isPublicDeclaration(offset: U64) -> Bool { return self.publicDeclarationOffsets.contains(offset) }

    inout fn registerQualifiedUse(origin~: ImportOrigin) {
        self.qualifiedUseOffsets[origin.localStart] = self.qualifiedUses.count() + 1U64
        self.qualifiedUses.append(origin)
    }
    fn qualifiedUseIndex(offset: U64) -> U64 {
        val entry = self.qualifiedUseOffsets.getOr(key: offset, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.qualifiedUses.count()
    }
    fn qualifiedUseCount() -> U64 { return self.qualifiedUses.count() }
    fn qualifiedUseAt(index: U64) -> ImportOrigin { return self.qualifiedUses[index] }

    inout fn registerImportOrigin(origin~: ImportOrigin, nameId: U64, reExport: Bool) {
        val empty: Dictionary[U64, U64] = [:]
        if reExport {
            mut val names = self.reExportOriginNames.getOr(key: origin.localModule, fallback: empty)
            if names.getOr(key: nameId, fallback: 0U64) == 0U64 {
                names[nameId] = self.reExportOrigins.count() + 1U64
                self.reExportOriginNames[origin.localModule] = names
            }
            mut val previous = names.getOr(key: nameId, fallback: 0U64)
            if previous != 0U64 && previous <= self.reExportOrigins.count() {
                while self.reExportOriginNext[previous - 1U64] != 0U64 { previous = self.reExportOriginNext[previous - 1U64] }
                self.reExportOriginNext[previous - 1U64] = self.reExportOrigins.count() + 1U64
            }
            self.reExportOriginNext.append(0U64)
            self.reExportOrigins.append(origin)
        } else {
            mut val names = self.importOriginNames.getOr(key: origin.localModule, fallback: empty)
            if names.getOr(key: nameId, fallback: 0U64) == 0U64 {
                names[nameId] = self.importOrigins.count() + 1U64
                self.importOriginNames[origin.localModule] = names
            }
            mut val previous = names.getOr(key: nameId, fallback: 0U64)
            if previous != 0U64 && previous <= self.importOrigins.count() {
                while self.importOriginNext[previous - 1U64] != 0U64 { previous = self.importOriginNext[previous - 1U64] }
                self.importOriginNext[previous - 1U64] = self.importOrigins.count() + 1U64
            }
            self.importOriginNext.append(0U64)
            self.importOrigins.append(origin)
        }
    }
    fn firstImportOriginNamed(moduleId: U64, nameId: U64) -> U64 {
        val empty: Dictionary[U64, U64] = [:]
        val names = self.importOriginNames.getOr(key: moduleId, fallback: empty)
        val entry = names.getOr(key: nameId, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.importOrigins.count()
    }
    fn firstReExportOriginNamed(moduleId: U64, nameId: U64) -> U64 {
        val empty: Dictionary[U64, U64] = [:]
        val names = self.reExportOriginNames.getOr(key: moduleId, fallback: empty)
        val entry = names.getOr(key: nameId, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.reExportOrigins.count()
    }
    fn nextImportOriginNamed(index: U64) -> U64 {
        val entry = self.importOriginNext[index]
        if entry != 0U64 { return entry - 1U64 }
        return self.importOrigins.count()
    }
    fn nextReExportOriginNamed(index: U64) -> U64 {
        val entry = self.reExportOriginNext[index]
        if entry != 0U64 { return entry - 1U64 }
        return self.reExportOrigins.count()
    }
    fn importOriginCount() -> U64 { return self.importOrigins.count() }
    fn importOriginAt(index: U64) -> ImportOrigin { return self.importOrigins[index] }
    fn reExportOriginCount() -> U64 { return self.reExportOrigins.count() }
    fn reExportOriginAt(index: U64) -> ImportOrigin { return self.reExportOrigins[index] }

    inout fn registerSourceFile(start: U64, length: U64, moduleId: U64, path: String, syntaxRoot: Bool = false) {
        self.files.append(start: start, length: length, moduleId: moduleId, path: path)
        if syntaxRoot {
            self.syntaxRootModules.insert(moduleId)
        }
    }

    fn sourceFileCount() -> U64 { return self.files.count() }
    fn sourceFileRange(index: U64) -> SourceFileRange { return self.files.range(index: index) }
    fn sourceFilePath(index: U64) -> String { return self.files.path(index: index) }
    fn sourceFileContaining(offset: U64) -> Optional[U64] { return self.files.containing(offset: offset) }
    fn isSyntaxRoot(moduleId: U64) -> Bool { return self.syntaxRootModules.contains(moduleId) }
}
