// Layout demands retain discovery order. Names only narrow candidates;
// structural type equality remains the caller's responsibility.
pub impl MonoWork {
    fn genericInstanceCount() -> U64 { return self.genInsts.count() }
    fn genericInstanceAt(index: U64) -> U64 { return self.genInsts[index] }
    fn firstGenericInstanceNamed(nameId: U64) -> U64 {
        val entry = self.genericInstanceHeads.getOr(key: nameId, fallback: 0U64)
        if entry != 0U64 { return entry - 1U64 }
        return self.genInsts.count()
    }
    fn nextGenericInstanceNamed(index: U64) -> U64 {
        val entry = self.genericInstanceNext[index]
        if entry != 0U64 { return entry - 1U64 }
        return self.genInsts.count()
    }
    inout fn registerGenericInstance(ref: U64, nameId: U64) {
        val entry = self.genInsts.count() + 1U64
        val tail = self.genericInstanceTails.getOr(key: nameId, fallback: 0U64)
        self.genericInstanceNext.append(0U64)
        if tail == 0U64 {
            self.genericInstanceHeads[nameId] = entry
        } else {
            self.genericInstanceNext[tail - 1U64] = entry
        }
        self.genericInstanceTails[nameId] = entry
        self.genInsts.append(ref)
    }
}
