// A whole-target static-check result owns the exact compiler snapshot it proves.
// No public factory or mutable arena accessor can attach it to another input.
use ./Frontend only { Comp, FrontendInput, FrontendOptions, openFrontendForRequests, completeFrontendDeclarations, traceFinalCallableStart, traceFinalCallableFinish, FinalBodyRequests, FinalDependencies, FinalizationPublication }
use ./Ir only { StaticConformanceProof, BodyOrigin, InstanceEnvironment, CallSiteKey, CheckedLocalStorageRequest, SourceBindingOrigin }
use ./Backend only { LlvmLoweringResult, LlvmTargetDescription, lowerRequestedLlvm, lowerGlobalStorageLlvm, lowerCallableDeclarationsLlvm }
use ./SourceAccess only { SourceAccess }
use ./Diag only { CompileDiagnostic, DiagnosticLocation, FailureDomain }
use ./DeclarationProgram only { prepareDeclarationProgramWithRequests, prepareDeclarationRoot, DeclarationBodyRequests, declarationProgramDiagnostic }
use ./Mid/Build only { MidFunctionTemplates, MidBuildError }
use ./Mid/Verify only { canonicalMidReachable }
use ./Mid/DeclarationAccess only { DeclarationAccessAnalysis, DeclarationAccessNode }
use ./PreparedProgram only { PreparedProgram, ProgramPreparationError, programPreparationDiagnostic }
use ./Mid/Program only { MidExecutableRequests, MidExecutableProgram, MidProgramError }
use ./Mid/Prepare only { MidExecutableBody }
use ./Mid/GlobalAccess only { analyzeMidGlobalAccess }
use ./Mid/Ambient only { MidAmbientProgram }

// Observation of prepared descriptors. Remaining declaration obligations are
// retained; this value cannot be passed to LLVM as execution permission.
pub struct BodyDeclarationAnalysis {
    pub val root: DeclarationAccessNode
    pub val analysis: DeclarationAccessAnalysis
}

pub struct BodyDescriptors {
    pub val bodyId: U64
    pub val declarations: Array[BodyDeclarationAnalysis]
}

// All per-body Mid passes succeeded. Interprocedural effect preparation and
// the runtime enforcement plan remain separate obligations before execution.
pub struct MidBodyPreparation {
    pub val descriptors: BodyDescriptors
    pub val executable: MidExecutableBody
}

// Static dependencies are closed and the dynamic enforcement plan is ready.
// Startup/global initialization and backend publication remain separate steps.
pub struct MidAccessPreparation {
    pub val program: MidExecutableProgram
    pub val body: MidBodyPreparation
    pub val ambient: MidAmbientProgram
}

// The admitted source and every cache belong to one session. No mutable Comp
// escapes; later requests cannot reload edited files or borrow another arena.
struct MidFinalizationInputs {
    val calls: Dictionary[U64, Bool]
    val storage: Dictionary[U64, CheckedLocalStorageRequest]
    val storageOrder: Array[U64]
}
impl MidFinalizationInputs { factory }

pub unique struct CompilerSession {
    mut val compiler: Comp
    mut val llvmTarget: Optional[LlvmTargetDescription] = <Optional.None />
    mut val finalizationStarted: Bool = false
    mut val finalBodies: FinalBodyRequests = <FinalBodyRequests />
    mut val finalDependencies: FinalDependencies = <FinalDependencies />
    mut val finalPublication: FinalizationPublication = <FinalizationPublication />
    mut val descriptorResults: Dictionary[U64, BodyDescriptors] = [:]
    mut val midRequests: MidExecutableRequests = <MidExecutableRequests />
    mut val executionFailure: Optional[CompileDiagnostic] = <Optional.None />
    mut val templates: MidFunctionTemplates = <MidFunctionTemplates />
    mut val midFinalizationInputs: Dictionary[U64, MidFinalizationInputs] = [:]
    mut val requests: DeclarationBodyRequests = <DeclarationBodyRequests />
    mut val functionResults: Dictionary[U64, Result[DeclarationAccessAnalysis, CompileDiagnostic]] = [:]
    mut val closureResults: Dictionary[U64, Result[DeclarationAccessAnalysis, CompileDiagnostic]] = [:]
    mut val destructionResults: Dictionary[U64, Result[DeclarationAccessAnalysis, CompileDiagnostic]] = [:]
    mut val initializerResult: Optional[Result[DeclarationAccessAnalysis, CompileDiagnostic]] = <Optional.None />
}
pub unique enum CompilerSessionResult {
    Success(session: CompilerSession)
    Failure(diagnostic: CompileDiagnostic)
}

pub impl CompilerSession {

    inout fn prepareFunction(function: U64, arguments: Array[U64] = [], receiver: U64 = 0U64, proof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> Result[BodyDescriptors, CompileDiagnostic] {
        val result = self.prepareFunctionRaw(function: function, arguments: arguments, receiver: receiver, proof: proof)
        return self.ownedResult(result: result)
    }
    inout fn prepareBody(bodyId: U64) -> Result[BodyDescriptors, CompileDiagnostic] {
        val result = self.prepareBodyRaw(bodyId: bodyId)
        return self.ownedResult(result: result)
    }
    inout fn prepareMidBody(bodyId: U64) -> Result[MidBodyPreparation, CompileDiagnostic] {
        val result = self.prepareMidBodyRaw(bodyId: bodyId)
        return self.ownedResult(result: result)
    }
    inout fn prepareInitializers() -> Result[Optional[MidAccessPreparation], CompileDiagnostic] {
        val result = self.prepareInitializersRaw()
        return self.ownedResult(result: result)
    }
    inout fn prepareBodyAccess(bodyId: U64) -> Result[MidAccessPreparation, CompileDiagnostic] {
        val result = self.prepareBodyAccessRaw(bodyId: bodyId)
        return self.ownedResult(result: result)
    }
    inout fn request(root: DeclarationAccessNode) -> Result[DeclarationAccessAnalysis, CompileDiagnostic] {
        val result = self.requestRaw(root: root)
        return self.ownedResult(result: result)
    }
    inout fn takeDiagnostics() -> Array[CompileDiagnostic] { return self.compiler.takeDiagnostics() }

    // The execution host installs its actual JIT description before publication.
    // Once chosen (including native-only module diagnostics), it cannot change.
    inout fn configureLlvmTarget(target: LlvmTargetDescription) -> Result[(), CompileDiagnostic] {
        match self.llvmTarget {
            Optional.Some(v: val selected) => {
                if !selected.matches(target: target) {
                    return <Result.Err error=<CompileDiagnostic failureDomain=<FailureDomain.Internal /> location=<DiagnosticLocation.Line line=0I64 /> message="LLVM backend: session target cannot change after selection" /> />
                }
            }
            Optional.None => { self.llvmTarget = <Optional.Some v=target /> }
        }
        return <Result.Ok value=() />
    }

    inout fn targetForLowering() -> Result[LlvmTargetDescription, CompileDiagnostic] {
        match self.llvmTarget {
            Optional.Some(v: val target) => { return <Result.Ok value=target /> }
            Optional.None => {}
        }
        val target = (try LlvmTargetDescription.native())
        self.llvmTarget = <Optional.Some v=target />
        return <Result.Ok value=target />
    }

    assoc fn open(input: FrontendInput, sources: SourceAccess,
                  options: FrontendOptions = <FrontendOptions />) -> CompilerSessionResult {
        val compiler = match openFrontendForRequests(input: input, sources: sources, options: options) {
            Result.Ok(value: val compiler) => compiler,
            Result.Err(error: val diagnostic) => { return <CompilerSessionResult.Failure diagnostic=diagnostic /> }
        }
        return <CompilerSessionResult.Success session=<CompilerSession compiler=compiler /> />
    }

    // Only this session can combine source checking with its concrete arena.


    // Registration is a signature/identity snapshot, not an execution grant.
    // IDs are meaningful only in this session. Global startup is separate from
    // this callable worklist and is checked by every preparation request.
    fn registeredBodies() -> Array[U64] { return self.compiler.monoWork.bodies() }





    // Startup is an explicit root, independent of requesting main's body.
    // None means there are no global initializers to execute.




    // Publish entry signatures without requesting main or exposed source bodies.
    // Global initializers are mandatory startup roots, with their own preparation.
    inout fn lowerDeclarations() -> LlvmLoweringResult {
        match self.registerProgramRoots() {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => {
                self.executionFailure = <Optional.Some v=diagnostic />
                return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) />
            }
        }
        val target = match self.targetForLowering() {
            Result.Ok(value: val target) => { give target }
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) /> }
        }
        match lowerCallableDeclarationsLlvm(c: inout self.compiler, target: <Optional.Some v=target />) {
            LlvmLoweringResult.Success(module: val module) => { return <LlvmLoweringResult.Success module=move module /> }
            LlvmLoweringResult.Failure(diagnostic: val diagnostic) => {
                self.executionFailure = <Optional.Some v=diagnostic />
                return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) />
            }
        }
    }

    // Compile from this session's checked request and matching snapshot. No
    // mutable compiler or whole-target check token escapes to the execution host.
    inout fn lowerBody(bodyId: U64) -> LlvmLoweringResult {
        val prepared = match self.prepareBodyAccessRaw(bodyId: bodyId) {
            Result.Ok(value: val prepared) => { give prepared }
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) /> }
        }
        val target = match self.targetForLowering() {
            Result.Ok(value: val target) => { give target }
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) /> }
        }
        match lowerRequestedLlvm(c: inout self.compiler, program: prepared.program, ambient: prepared.ambient, bodyId: bodyId, target: <Optional.Some v=target />) {
            LlvmLoweringResult.Success(module: val module) => { return <LlvmLoweringResult.Success module=move module /> }
            LlvmLoweringResult.Failure(diagnostic: val diagnostic) => {
                self.executionFailure = <Optional.Some v=diagnostic />
                return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) />
            }
        }
    }

    // Storage publication is separate from executing its initializer. The host
    // must install this unique definition module before calling any app entry.
    inout fn lowerGlobalStorage() -> LlvmLoweringResult {
        match self.prepareInitializersRaw() {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) /> }
        }
        val target = match self.targetForLowering() {
            Result.Ok(value: val target) => { give target }
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) /> }
        }
        match lowerGlobalStorageLlvm(c: inout self.compiler, target: <Optional.Some v=target />) {
            LlvmLoweringResult.Success(module: val module) => { return <LlvmLoweringResult.Success module=move module /> }
            LlvmLoweringResult.Failure(diagnostic: val diagnostic) => {
                self.executionFailure = <Optional.Some v=diagnostic />
                return <LlvmLoweringResult.Failure diagnostic=self.ownedFailure(diagnostic: diagnostic) />
            }
        }
    }

    // Declaration IDs are local to this admitted input. The returned analysis
    // is observational: obligations remain, and it cannot authorize execution.

}

impl CompilerSession {
    // Rendering is a projection of a result produced by this unexposed Comp.
    // Neither this helper nor a raw cache accepts a caller-supplied failure.
    fn ownedFailure(diagnostic: CompileDiagnostic) -> CompileDiagnostic {
        if self.compiler.sourceFailureHasOwner(diagnostic: diagnostic) {
            return <CompileDiagnostic failureDomain=<FailureDomain.Source /> location=diagnostic.location() message=diagnostic.message() notes=diagnostic.notes() />
        }
        return diagnostic
    }

    fn ownedResult[T](result: Result[T, CompileDiagnostic]) -> Result[T, CompileDiagnostic] {
        return match result {
            Result.Ok(value: _) => result
            Result.Err(error: val diagnostic) => <Result.Err error=self.ownedFailure(diagnostic: diagnostic) />
        }
    }

    inout fn prepareFunctionRaw(function: U64, arguments: Array[U64], receiver: U64, proof: StaticConformanceProof) -> Result[BodyDescriptors, CompileDiagnostic] {
        match self.executionFailure {
            Optional.Some(v: val diagnostic) => { return <Result.Err error=diagnostic /> }
            Optional.None => {}
        }
        val result = self.prepareFunctionInSession(function: function, arguments: arguments, receiver: receiver, proof: proof)
        match result {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { self.executionFailure = <Optional.Some v=diagnostic /> }
        }
        return result
    }

    inout fn prepareBodyRaw(bodyId: U64) -> Result[BodyDescriptors, CompileDiagnostic] {
        match self.executionFailure {
            Optional.Some(v: val diagnostic) => { return <Result.Err error=diagnostic /> }
            Optional.None => {}
        }
        val result = self.prepareBodyInSession(bodyId: bodyId)
        match result {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { self.executionFailure = <Optional.Some v=diagnostic /> }
        }
        return result
    }

    inout fn prepareMidBodyRaw(bodyId: U64) -> Result[MidBodyPreparation, CompileDiagnostic] {
        val descriptors = (try self.prepareBodyRaw(bodyId: bodyId))
        match self.midRequests.request(c: inout self.compiler, templates: inout self.templates, bodyId: bodyId) {
            Result.Ok(value: val executable) => {
                return <Result.Ok value=<MidBodyPreparation descriptors=descriptors executable=executable /> />
            }
            Result.Err(error: val error) => {
                val diagnostic = programPreparationDiagnostic(c: inout self.compiler, error: <ProgramPreparationError.Mid error=error />)
                self.executionFailure = <Optional.Some v=diagnostic />
                return <Result.Err error=diagnostic />
            }
        }
    }

    inout fn prepareInitializersRaw() -> Result[Optional[MidAccessPreparation], CompileDiagnostic] {
        match self.executionFailure {
            Optional.Some(v: val diagnostic) => { return <Result.Err error=diagnostic /> }
            Optional.None => {}
        }
        val result = self.prepareInitializersInSession()
        match result {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { self.executionFailure = <Optional.Some v=diagnostic /> }
        }
        return result
    }

    inout fn prepareBodyAccessRaw(bodyId: U64) -> Result[MidAccessPreparation, CompileDiagnostic] {
        val result = self.prepareBodyAccessInSession(bodyId: bodyId)
        match result {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { self.executionFailure = <Optional.Some v=diagnostic /> }
        }
        return result
    }

    inout fn requestRaw(root: DeclarationAccessNode) -> Result[DeclarationAccessAnalysis, CompileDiagnostic] {
        val cached = match root {
            DeclarationAccessNode.Function(function: val function) => { give self.functionResults.get(key: function) }
            DeclarationAccessNode.Closure(bodyKey: val key) => { give self.closureResults.get(key: key) }
            DeclarationAccessNode.Destruction(typeTerm: val term) => { give self.destructionResults.get(key: term) }
            DeclarationAccessNode.GlobalInitializer => { give self.initializerResult }
        }
        match cached {
            Optional.Some(v: val result) => { return result }
            Optional.None => {}
        }
        val result: Result[DeclarationAccessAnalysis, CompileDiagnostic] = match prepareDeclarationRoot(c: inout self.compiler, templates: inout self.templates, requests: inout self.requests, root: root) {
            Result.Ok(value: val analysis) => { give <Result.Ok value=analysis /> }
            Result.Err(error: val error) => { give <Result.Err error=declarationProgramDiagnostic(c: inout self.compiler, error: error) /> }
        }
        match root {
            DeclarationAccessNode.Function(function: val function) => { self.functionResults[function] = result }
            DeclarationAccessNode.Closure(bodyKey: val key) => { self.closureResults[key] = result }
            DeclarationAccessNode.Destruction(typeTerm: val term) => { self.destructionResults[term] = result }
            DeclarationAccessNode.GlobalInitializer => { self.initializerResult = <Optional.Some v=result /> }
        }
        return result
    }

    inout fn registerProgramRoots() -> Result[(), CompileDiagnostic] {
        (try self.prepareInitializersRaw())
        mut val foundMain = false
        mut val index = 0U64
        while index < self.compiler.arena.functionCount() {
            val function = self.compiler.arena.functionAt(index: index)
            val main = self.compiler.nameIsMain(f: function)
            if !function.isExtern && function.body != 0U64 && (main || function.isExposed) {
                val bodyId = (try self.compiler.enqueueFinalBody(fnIdx: index, args: [], recvInstRef: 0U64))
                if bodyId == 0U64 { return <Result.Err error=self.compiler.diagnosticAt(offset: function.nameStart, msg: "program entry has no concrete body identity") /> }
                if main {
                    self.compiler.monoWork.recordEntryBody(function: index, bodyId: bodyId)
                    foundMain = true
                }
            }
            index += 1U64
        }
        if !foundMain { return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "program has no main function") /> }
        try self.compiler.closeFinalDependencies(state: inout self.finalDependencies)
        try self.compiler.publishFinalCallables(state: inout self.finalPublication)
        return <Result.Ok value=() />
    }

    inout fn startFinalization() -> Result[(), CompileDiagnostic] {
        if self.finalizationStarted { return <Result.Ok value=() /> }
        try self.compiler.initializeFinalCallables()
        self.finalizationStarted = true
        return <Result.Ok value=() />
    }

    inout fn prepareInitializersInSession() -> Result[Optional[MidAccessPreparation], CompileDiagnostic] {
        (try self.requestRaw(root: <DeclarationAccessNode.GlobalInitializer />))
        try self.startFinalization()
        try self.compiler.prepareFinalInitializers(state: inout self.finalDependencies)
        if self.compiler.arena.globals.count() == 0U64 { return <Result.Ok value=<Optional.None /> /> }
        val bodyId = self.compiler.findBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
        val prepared = (try self.prepareBodyAccessRaw(bodyId: bodyId))
        return <Result.Ok value=<Optional.Some v=prepared /> />
    }

    inout fn prepareFunctionInSession(function: U64, arguments: Array[U64], receiver: U64, proof: StaticConformanceProof) -> Result[BodyDescriptors, CompileDiagnostic] {
        // Globals are mandatory startup roots. Keep their analysis in the
        // session cache even though this result describes one function.
        (try self.requestRaw(root: <DeclarationAccessNode.GlobalInitializer />))
        (try self.requestRaw(root: <DeclarationAccessNode.Function function=function />))
        try self.startFinalization()
        try self.compiler.prepareFinalInitializers(state: inout self.finalDependencies)
        val bodyId = (try self.compiler.enqueueFinalBody(fnIdx: function, args: arguments, recvInstRef: receiver, selectedProof: proof))
        if bodyId == 0U64 {
            return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "internal error: function request has no concrete callable body") />
        }
        return self.prepareBodyInSession(bodyId: bodyId)
    }

    inout fn completeExecutableDependencies() -> Result[(), CompileDiagnostic] {
        traceFinalCallableStart(c: inout self.compiler)
        val collecting = self.compiler.inCollection
        self.compiler.inCollection = true
        val result = self.completeExecutableDependenciesInContext()
        self.compiler.inCollection = collecting
        try result
        traceFinalCallableFinish(c: inout self.compiler)
        return <Result.Ok value=() />
    }

    inout fn completeExecutableDependenciesInContext() -> Result[(), CompileDiagnostic] {
        try self.compiler.prepareFinalCallableRoots(dependencies: inout self.finalDependencies)
        mut val index = 0U64
        while index < self.compiler.monoWork.bodyCount() || self.compiler.hasFinalDependencies(state: self.finalDependencies) {
            if index < self.compiler.monoWork.bodyCount() {
                val body = self.compiler.monoWork.bodyAt(index: index)
                try self.requestExecutableDependencies(bodyId: body)
                index += 1U64
            }
            try self.compiler.advanceFinalDependencies(state: inout self.finalDependencies)
        }
        return self.compiler.finishFinalCallables(publication: inout self.finalPublication)
    }

    inout fn requestExecutableDependencies(bodyId: U64) -> Result[(), CompileDiagnostic] {
        val instance = self.compiler.arena.bodyInstanceAt(index: bodyId - 1U64)
        if self.compiler.arena.bodyIsCallable(bodyId: bodyId) && instance.adapterTargetBodyId == 0U64 && instance.fnIdx < self.compiler.arena.functionCount() {
            val inputs = try self.finalizationInputsFor(function: instance.fnIdx, bodyId: bodyId)
            val storage: Optional[Dictionary[U64, CheckedLocalStorageRequest]] = if self.compiler.arena.functionAt(index: instance.fnIdx).isDefaultGenerator {
                give <Optional.None />
            } else { give <Optional.Some v=inputs.storage /> }
            return self.compiler.requestFinalBody(bodyId: bodyId, requests: inout self.finalBodies, reachedDirectCalls: <Optional.Some v=inputs.calls />, checkedLocalStorage: storage, checkedLocalStorageOrder: inputs.storageOrder)
        }
        return self.compiler.requestFinalBody(bodyId: bodyId, requests: inout self.finalBodies)
    }

    inout fn finalizationInputsFor(function: U64, bodyId: U64) -> Result[MidFinalizationInputs, CompileDiagnostic] {
        match self.midFinalizationInputs.get(key: function) {
            Optional.Some(v: val cached) => { return <Result.Ok value=cached /> }
            Optional.None => {}
        }
        try self.compiler.prepareLexicalBody(fnIdx: function)
        val built = self.templates.body(c: inout self.compiler, function: function)
        match built.error {
            MidBuildError.None => {}
            _ => { return <Result.Err error=programPreparationDiagnostic(c: inout self.compiler, error: <ProgramPreparationError.Mid error=<MidProgramError.Build bodyId=bodyId error=built.error /> />) /> }
        }
        val body = self.compiler.mid.bodies[built.canonical.body - 1U64]
        val reached = canonicalMidReachable(arena: self.compiler.mid, body: body)
        val collectStorage = !self.compiler.arena.functionAt(index: function).isDefaultGenerator
        mut val calls: Dictionary[U64, Bool] = [:]
        for index in 0U64..<body.blocks.len {
            val block = self.compiler.mid.blocks[body.blocks.start + index]
            if reached[index] {
                val term = self.compiler.mid.terminators[block.terminator - 1U64]
                if term.tag == 4U64 {
                    val target = self.compiler.mid.callTargets[term.callTarget - 1U64]
                    if target.tag == 1U64 && target.originKind == 1U64 {
                        val key = <CallSiteKey ownerFnIdx=target.ownerFnIdx originKind=target.originKind originStart=target.originStart originEnd=target.originEnd originSerial=target.originSerial slot=target.slot />
                        val template = self.compiler.callTemplateIndex(siteKey: key)
                        if template >= self.compiler.callTemplateCount() {
                            return <Result.Err error=self.compiler.diagnosticAt(offset: key.originStart, msg: "internal error: reached Mid call has no checked template", failureDomain: <FailureDomain.Internal />) />
                        }
                        calls[template] = true
                    }
                }
            }
        }
        mut val storage: Dictionary[U64, CheckedLocalStorageRequest] = [:]
        mut val storageOrder: Array[U64] = []
        if collectStorage && body.storageOrder.len != 0U64 {
            for index in 0U64..<body.storageOrder.len {
                val initialization = self.compiler.mid.storageStatements[body.storageOrder.start + index]
                val statement = self.compiler.mid.statements[initialization.statement]
                if (statement.tag != 1U64 && statement.tag != 9U64) || statement.value == 0U64 {
                    return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "checked Mid storage order points to a non-initialization", failureDomain: <FailureDomain.Internal />) />
                }
                val value = self.compiler.mid.rvalues[statement.value - 1U64]
                val destination = self.compiler.mid.places[statement.destination - 1U64]
                if value.tag != 20U64 || destination.rootTag != 1U64 || destination.projections.len != 0U64 {
                    return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "checked Mid storage order points outside a local initialization", failureDomain: <FailureDomain.Internal />) />
                }
                val local = self.compiler.mid.locals[body.locals.start + destination.local]
                if local.sourceBinding.isUnproved() || storage.contains(key: value.sourceStmt) {
                    return <Result.Err error=self.compiler.diagnosticAt(offset: local.sourceNameStart, msg: "checked Mid storage order has an invalid binding occurrence", failureDomain: <FailureDomain.Internal />) />
                }
                storage[value.sourceStmt] = <CheckedLocalStorageRequest expression=value.exprId declarationTarget=local.sourceNameStart binding=local.sourceBinding valueType=initialization.valueType conversionSite=<Optional.Some v=initialization.conversionSite /> />
                storageOrder.append(value.sourceStmt)
            }
        }
        if collectStorage {
            for index in 0U64..<body.terminatingInitializers.len {
                val initializer = self.compiler.mid.terminatingInitializers[body.terminatingInitializers.start + index]
                if storage.contains(key: initializer.statement) {
                    return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "checked Mid has a duplicate initializer dependency", failureDomain: <FailureDomain.Internal />) />
                }
                storage[initializer.statement] = <CheckedLocalStorageRequest expression=initializer.expression declarationTarget=self.compiler.stmtPrincipalOffset(sid: initializer.statement) binding=<SourceBindingOrigin /> valueType=initializer.valueType producesStorage=false />
            }
        }
        val inputs = <MidFinalizationInputs calls=calls storage=storage storageOrder=storageOrder />
        self.midFinalizationInputs[function] = inputs
        return <Result.Ok value=inputs />
    }

    inout fn prepareBodyInSession(bodyId: U64) -> Result[BodyDescriptors, CompileDiagnostic] {
        if !self.finalizationStarted || bodyId == 0U64 || bodyId > self.compiler.arena.bodyInstanceCount() || !self.compiler.arena.bodySignature(bodyId: bodyId).ready {
            return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "internal error: body request requires a registered signature in this session") />
        }
        match self.descriptorResults.get(key: bodyId) {
            Optional.Some(v: val prepared) => { return <Result.Ok value=prepared /> }
            Optional.None => {}
        }
        val roots = self.declarationRootsForBody(bodyId: bodyId)
        mut val declarations: Array[BodyDeclarationAnalysis] = []
        for root in roots {
            declarations.append(<BodyDeclarationAnalysis root=root analysis=(try self.requestRaw(root: root)) />)
        }
        val instance = self.compiler.arena.bodyInstanceAt(index: bodyId - 1U64)
        if instance.fnIdx != 18446744073709551615U64 {
            try self.requestExecutableDependencies(bodyId: bodyId)
        }
        try self.compiler.closeFinalDependencies(state: inout self.finalDependencies)
        try self.compiler.publishFinalCallables(state: inout self.finalPublication)
        val prepared = <BodyDescriptors bodyId=bodyId declarations=declarations />
        self.descriptorResults[bodyId] = prepared
        return <Result.Ok value=prepared />
    }

    inout fn prepareBodyAccessInSession(bodyId: U64) -> Result[MidAccessPreparation, CompileDiagnostic] {
        val body = (try self.prepareMidBodyRaw(bodyId: bodyId))
        mut val closed = false
        while !closed {
            val analysis = (try analyzeMidGlobalAccess(c: inout self.compiler))
            if analysis.conflictingBody != 0U64 {
                val sourceFunction = self.compiler.mid.bodies[analysis.conflictingBody - 1U64].sourceFunction
                mut val offset = 0U64
                if sourceFunction < self.compiler.arena.functionCount() { offset = self.compiler.arena.functionAt(index: sourceFunction).defOffset }
                return <Result.Err error=programPreparationDiagnostic(c: inout self.compiler, error: <ProgramPreparationError.GlobalAccess offset=offset />) />
            }
            closed = analysis.requiredBodies.count() == 0U64
            for dependency in analysis.requiredBodies { (try self.prepareMidBodyRaw(bodyId: dependency)) }
        }
        val snapshot = match self.midRequests.snapshot() {
            Result.Ok(value: val snapshot) => { give snapshot }
            Result.Err(error: val error) => { return <Result.Err error=programPreparationDiagnostic(c: inout self.compiler, error: <ProgramPreparationError.Mid error=error />) /> }
        }
        val ambient = (try MidAmbientProgram.prepare(c: inout self.compiler, program: snapshot))
        return <Result.Ok value=<MidAccessPreparation body=body program=snapshot ambient=ambient /> />
    }

    // Synthetic code inherits the effects of the operations it actually
    // performs. Dropping a closure environment never executes its closure body.
    inout fn declarationRootsForBody(bodyId: U64) -> Array[DeclarationAccessNode] {
        mut val roots: Array[DeclarationAccessNode] = [<DeclarationAccessNode.GlobalInitializer />]
        val instance = self.compiler.arena.bodyInstanceAt(index: bodyId - 1U64)
        match self.compiler.arena.bodyOrigin(bodyId: bodyId) {
            BodyOrigin.ExistentialWitness(resolution: val resolution, member: val member) => {
                val target = self.compiler.arena.finalExistentials[resolution].members[member].bodyId
                roots.append(<DeclarationAccessNode.Function function=self.compiler.arena.bodyInstanceAt(index: target - 1U64).fnIdx />)
            }
            BodyOrigin.ClosureEnvironmentDrop(closureBodyId: val closure) => {
                for capture in self.compiler.arena.closureSignature(bodyId: closure).captures {
                    roots.append(<DeclarationAccessNode.Destruction typeTerm=capture.typeTerm />)
                }
            }
            BodyOrigin.Callable => {
                if self.compiler.arena.bodySignature(bodyId: bodyId).closureSignatureId != 0U64 {
                    roots.append(<DeclarationAccessNode.Closure bodyKey=instance.fnIdx />)
                } else if instance.fnIdx != 18446744073709551615U64 {
                    roots.append(<DeclarationAccessNode.Function function=instance.fnIdx />)
                }
            }
        }
        return roots
    }

}

pub unique struct CheckedProgram {
    mut val session: CompilerSession
    val declarationAccess: DeclarationAccessAnalysis
}

pub unique enum ProgramCheckResult {
    Success(program: CheckedProgram)
    Failure(diagnostic: CompileDiagnostic)
}

// These fields belong together; lowering must consume this compilation's arena.
pub unique struct ExecutableCompilation {
    pub mut val compiler: Comp
    pub val prepared: PreparedProgram
}

pub unique enum ExecutableCompilationResult {
    Success(compilation: ExecutableCompilation)
    Failure(diagnostic: CompileDiagnostic)
}

pub impl CheckedProgram {
    inout fn takeDiagnostics() -> Array[CompileDiagnostic] { return self.session.takeDiagnostics() }

    assoc fn check(input: FrontendInput, sources: SourceAccess,
                   options: FrontendOptions = <FrontendOptions />) -> ProgramCheckResult {
        // gen deliberately checks a different target; it cannot issue this proof.
        if options.genMode {
            return <ProgramCheckResult.Failure diagnostic=<CompileDiagnostic
                location=<DiagnosticLocation.Unpositioned />
                message="whole-target check cannot use generator mode" /> />
        }
        match CompilerSession.open(input: input, sources: sources, options: options) {
            CompilerSessionResult.Failure(diagnostic: val diagnostic) => { return <ProgramCheckResult.Failure diagnostic=diagnostic /> }
            CompilerSessionResult.Success(session: val session) => { return checkCompilerSession(session: move session) }
        }
    }

}

// Consume this exact snapshot, including earlier partial requests. Checking
// all declarations cannot accidentally bless source loaded by another session.
pub fn checkCompilerSession(session: move CompilerSession) -> ProgramCheckResult {
    mut val state = move session
    match state.executionFailure {
        Optional.Some(v: val diagnostic) => { return <ProgramCheckResult.Failure diagnostic=state.ownedFailure(diagnostic: diagnostic) /> }
        Optional.None => {}
    }
    match completeFrontendDeclarations(c: inout state.compiler) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <ProgramCheckResult.Failure diagnostic=state.ownedFailure(diagnostic: diagnostic) /> }
    }
    val analysis = match prepareDeclarationProgramWithRequests(c: inout state.compiler, templates: inout state.templates, requests: inout state.requests) {
        Result.Ok(value: val analysis) => { give analysis }
        Result.Err(error: val error) => {
            val diagnostic = declarationProgramDiagnostic(c: inout state.compiler, error: error)
            return <ProgramCheckResult.Failure diagnostic=state.ownedFailure(diagnostic: diagnostic) />
        }
    }
    return <ProgramCheckResult.Success program=<CheckedProgram session=move state declarationAccess=analysis /> />
}

// Static success need not imply concrete implementation support. Consume the
// checked snapshot once, retaining the same templates and all deferred effects.
pub fn prepareCheckedProgram(checked: move CheckedProgram) -> ExecutableCompilationResult {
    mut val program = move checked
    match program.session.startFinalization() {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <ExecutableCompilationResult.Failure diagnostic=program.session.ownedFailure(diagnostic: diagnostic) /> }
    }
    match program.session.completeExecutableDependencies() {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <ExecutableCompilationResult.Failure diagnostic=program.session.ownedFailure(diagnostic: diagnostic) /> }
    }
    val prepared = match PreparedProgram.prepareWithRequests(c: inout program.session.compiler,
        templates: inout program.session.templates, declarationAccess: program.declarationAccess, requests: inout program.session.midRequests) {
        Result.Ok(value: val prepared) => { give prepared }
        Result.Err(error: val error) => {
            val diagnostic = programPreparationDiagnostic(c: inout program.session.compiler, error: error)
            return <ExecutableCompilationResult.Failure diagnostic=program.session.ownedFailure(diagnostic: diagnostic) />
        }
    }
    return <ExecutableCompilationResult.Success compilation=<ExecutableCompilation compiler=program.session.compiler prepared=prepared /> />
}
