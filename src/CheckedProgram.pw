// A whole-target static-check result owns the exact compiler snapshot it proves.
// No public factory or mutable arena accessor can attach it to another input.
import ./Frontend with { Comp, FrontendInput, FrontendOptions, analyzeFrontendForRequests, completeFrontendDeclarations, finalizeFrontendExecutableRequests, FinalBodyRequests, FinalDependencies, FinalizationPublication }
import ./Ir with { StaticConformanceProof }
import ./SourceAccess with { SourceAccess }
import ./Diag with { CompileDiagnostic, DiagnosticLocation }
import ./DeclarationProgram with { prepareDeclarationProgramWithRequests, prepareDeclarationRoot, DeclarationBodyRequests, declarationProgramDiagnostic }
import ./Mid/Build with { MidFunctionTemplates }
import ./Mid/DeclarationAccess with { DeclarationAccessAnalysis, DeclarationAccessNode }
import ./PreparedProgram with { PreparedProgram, programPreparationDiagnostic }

// The admitted source and every cache belong to one session. No mutable Comp
// escapes; later requests cannot reload edited files or borrow another arena.
// Observation of prepared descriptors. Remaining declaration obligations are
// retained; this value cannot be passed to LLVM as execution permission.
pub struct FunctionDescriptors {
    pub val bodyId: U64
    pub val declarationAccess: DeclarationAccessAnalysis
}

pub unique struct CompilerSession {
    mut val compiler: Comp
    mut val finalizationStarted: Bool = false
    mut val finalBodies: FinalBodyRequests = <FinalBodyRequests />
    mut val finalDependencies: FinalDependencies = <FinalDependencies />
    mut val finalPublication: FinalizationPublication = <FinalizationPublication />
    mut val executionFailure: Optional[CompileDiagnostic] = <Optional.None />
    mut val templates: MidFunctionTemplates = <MidFunctionTemplates />
    mut val requests: DeclarationBodyRequests = <DeclarationBodyRequests />
    mut val functionResults: Dictionary[U64, Result[DeclarationAccessAnalysis, CompileDiagnostic]] = [:]
    mut val closureResults: Dictionary[U64, Result[DeclarationAccessAnalysis, CompileDiagnostic]] = [:]
    mut val destructionResults: Dictionary[U64, Result[DeclarationAccessAnalysis, CompileDiagnostic]] = [:]
    mut val initializerResult: Optional[Result[DeclarationAccessAnalysis, CompileDiagnostic]] = <Optional.None />
}
pub unique enum CompilerSessionResult {
    Success(session: CompilerSession)
    Failure(diagnostic: CompileDiagnostic)
}

pub impl CompilerSession {
    assoc fn open(input: FrontendInput, sources: SourceAccess,
                  options: FrontendOptions = <FrontendOptions />) -> CompilerSessionResult {
        mut val compiler = <Comp />
        match analyzeFrontendForRequests(c: inout compiler, input: input, sources: sources, options: options) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <CompilerSessionResult.Failure diagnostic=diagnostic /> }
        }
        return <CompilerSessionResult.Success session=<CompilerSession compiler=compiler /> />
    }

    // Only this session can combine source checking with its concrete arena.
    inout fn prepareFunction(function: U64, arguments: Array[U64] = [], receiver: U64 = 0U64, proof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> Result[FunctionDescriptors, CompileDiagnostic] {
        match self.executionFailure {
            Optional.Some(v: val diagnostic) => { return <Result.Err error=diagnostic /> }
            Optional.None => {}
        }
        val result = self.prepareFunctionInSession(function: function, arguments: arguments, receiver: receiver, proof: proof)
        match result {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { self.executionFailure = <Optional.Some v=diagnostic /> }
        }
        return result
    }

    // Declaration IDs are local to this admitted input. The returned analysis
    // is observational: obligations remain, and it cannot authorize execution.
    inout fn request(root: DeclarationAccessNode) -> Result[DeclarationAccessAnalysis, CompileDiagnostic] {
        val cached = match root {
            DeclarationAccessNode.Function(function: val function) => { give self.functionResults.get(key: function) }
            DeclarationAccessNode.Closure(bodyKey: val key) => { give self.closureResults.get(key: key) }
            DeclarationAccessNode.Destruction(typeTerm: val term) => { give self.destructionResults.get(key: term) }
            DeclarationAccessNode.GlobalInitializer => { give self.initializerResult }
        }
        match cached {
            Optional.Some(v: val result) => { return result }
            Optional.None => {}
        }
        val result: Result[DeclarationAccessAnalysis, CompileDiagnostic] = match prepareDeclarationRoot(c: inout self.compiler, templates: inout self.templates, requests: inout self.requests, root: root) {
            Result.Ok(value: val analysis) => { give <Result.Ok value=analysis /> }
            Result.Err(error: val error) => { give <Result.Err error=declarationProgramDiagnostic(c: inout self.compiler, error: error) /> }
        }
        match root {
            DeclarationAccessNode.Function(function: val function) => { self.functionResults[function] = result }
            DeclarationAccessNode.Closure(bodyKey: val key) => { self.closureResults[key] = result }
            DeclarationAccessNode.Destruction(typeTerm: val term) => { self.destructionResults[term] = result }
            DeclarationAccessNode.GlobalInitializer => { self.initializerResult = <Optional.Some v=result /> }
        }
        return result
    }
}

impl CompilerSession {
    inout fn startFinalization() -> Result[(), CompileDiagnostic] {
        if self.finalizationStarted { return <Result.Ok value=() /> }
        try self.compiler.initializeFinalCallables()
        self.finalizationStarted = true
        return <Result.Ok value=() />
    }

    inout fn prepareFunctionInSession(function: U64, arguments: Array[U64], receiver: U64, proof: StaticConformanceProof) -> Result[FunctionDescriptors, CompileDiagnostic] {
        // Globals are mandatory startup roots. Keep their analysis in the
        // session cache even though this result describes one function.
        (try self.request(root: <DeclarationAccessNode.GlobalInitializer />))
        val analysis = (try self.request(root: <DeclarationAccessNode.Function function=function />))
        try self.startFinalization()
        try self.compiler.prepareFinalInitializers(state: inout self.finalDependencies)
        val bodyId = (try self.compiler.enqueueFinalBody(fnIdx: function, args: arguments, recvInstRef: receiver, selectedProof: proof))
        if bodyId == 0U64 {
            return <Result.Err error=self.compiler.diagnosticAt(offset: 0U64, msg: "internal error: function request has no concrete callable body") />
        }
        try self.compiler.requestFinalBody(bodyId: bodyId, requests: inout self.finalBodies)
        try self.compiler.closeFinalDependencies(state: inout self.finalDependencies)
        try self.compiler.publishFinalCallables(state: inout self.finalPublication)
        return <Result.Ok value=<FunctionDescriptors bodyId=bodyId declarationAccess=analysis /> />
    }

}

pub unique struct CheckedProgram {
    mut val session: CompilerSession
    val declarationAccess: DeclarationAccessAnalysis
}

pub unique enum ProgramCheckResult {
    Success(program: CheckedProgram)
    Failure(diagnostic: CompileDiagnostic)
}

// These fields belong together; lowering must consume this compilation's arena.
pub unique struct ExecutableCompilation {
    pub mut val compiler: Comp
    pub val prepared: PreparedProgram
}

pub unique enum ExecutableCompilationResult {
    Success(compilation: ExecutableCompilation)
    Failure(diagnostic: CompileDiagnostic)
}

pub impl CheckedProgram {
    assoc fn check(input: FrontendInput, sources: SourceAccess,
                   options: FrontendOptions = <FrontendOptions />) -> ProgramCheckResult {
        // gen deliberately checks a different target; it cannot issue this proof.
        if options.genMode {
            return <ProgramCheckResult.Failure diagnostic=<CompileDiagnostic
                location=<DiagnosticLocation.Unpositioned />
                message="whole-target check cannot use generator mode" /> />
        }
        match CompilerSession.open(input: input, sources: sources, options: options) {
            CompilerSessionResult.Failure(diagnostic: val diagnostic) => { return <ProgramCheckResult.Failure diagnostic=diagnostic /> }
            CompilerSessionResult.Success(session: val session) => { return checkCompilerSession(session: move session) }
        }
    }

}

// Consume this exact snapshot, including earlier partial requests. Checking
// all declarations cannot accidentally bless source loaded by another session.
pub fn checkCompilerSession(session: move CompilerSession) -> ProgramCheckResult {
    mut val state = move session
    match state.executionFailure {
        Optional.Some(v: val diagnostic) => { return <ProgramCheckResult.Failure diagnostic=diagnostic /> }
        Optional.None => {}
    }
    match completeFrontendDeclarations(c: inout state.compiler) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <ProgramCheckResult.Failure diagnostic=diagnostic /> }
    }
    val analysis = match prepareDeclarationProgramWithRequests(c: inout state.compiler, templates: inout state.templates, requests: inout state.requests) {
        Result.Ok(value: val analysis) => { give analysis }
        Result.Err(error: val error) => {
            return <ProgramCheckResult.Failure diagnostic=declarationProgramDiagnostic(c: inout state.compiler, error: error) />
        }
    }
    return <ProgramCheckResult.Success program=<CheckedProgram session=move state declarationAccess=analysis /> />
}

// Static success need not imply concrete implementation support. Consume the
// checked snapshot once, retaining the same templates and all deferred effects.
pub fn prepareCheckedProgram(checked: move CheckedProgram) -> ExecutableCompilationResult {
    mut val program = move checked
    match program.session.startFinalization() {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <ExecutableCompilationResult.Failure diagnostic=diagnostic /> }
    }
    match finalizeFrontendExecutableRequests(c: inout program.session.compiler, requests: inout program.session.finalBodies,
        dependencies: inout program.session.finalDependencies, publication: inout program.session.finalPublication) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <ExecutableCompilationResult.Failure diagnostic=diagnostic /> }
    }
    val prepared = match PreparedProgram.prepareWithDeclarations(c: inout program.session.compiler,
        templates: inout program.session.templates, declarationAccess: program.declarationAccess) {
        Result.Ok(value: val prepared) => { give prepared }
        Result.Err(error: val error) => {
            return <ExecutableCompilationResult.Failure diagnostic=programPreparationDiagnostic(c: inout program.session.compiler, error: error) />
        }
    }
    return <ExecutableCompilationResult.Success compilation=<ExecutableCompilation compiler=program.session.compiler prepared=prepared /> />
}
