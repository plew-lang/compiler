// @Mid — ownership-aware, non-SSA CFG between the frozen frontend and LLVM.
// `Mid/Ir` owns only the vocabulary.  Build / instantiate / drop-elaboration /
// verification will live in child modules so the dependency DAG remains
// `Ir <- Frontend <- Mid <- Backend`.

use ./Mid/Ir only { MidEnumDestination, MidEnumDestinationNode, MidRange, MidBodyNode, MidPlaceNode, MidProjectionNode, MidAggregateElementNode, MidSwitchCase, MidOperandNode, MidRvalueNode, MidCallTargetNode, MidCallReceiverNode, MidStatementNode, MidTerminatorNode, MidBlockNode, MidCanonicalArena, MidCanonicalBody, MidClosureBody, canonicalMidBodyIsWellFormed, MidProjection, MidPlace, MidBorrowCapability, MidOwnership, MidAccessibility, MidConstant, MidOperand, MidAggregateKind, MidAggregateElement, MidRvalue, MidCastKind, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody, MidProgram }
use ./Mid/DataflowState only { MidOwnershipStates, MidAccessibilityStates }
use ./Mid/Drop only { analyzeCanonicalMidOwnership, analyzeCanonicalMidAccessibility, elaborateCanonicalMidDrops }
use ./Mid/Verify only { MidVerifyError, MidVerification, verifyCanonicalMidBody, verifyExecutableCanonicalMidBody }
use ./Mid/Build only { MidSourceBinding, MidBindingLookup, MidPlaceLookup, MidUnsupportedBuild, MidUnsupportedAssign, MidBuildError, MidBodyBuild, MidCallValue, MidAggregateValue, MidBuildState, emptyMidBody, addMidLocal, midLocalForBinding, midPlaceForRecordedIdent, buildMidLet, buildMidReturn, buildMidBlock, buildMidIf, buildParametricMidBody, buildMidBodyForInstance, buildParametricMidClosureBody, ensureParametricMidClosureBody, buildParametricMidGlobalInit }
use ./Mid/Instantiate only { MidInstantiateError, MidCanonicalInstantiation, instantiateCanonicalMidBody }
use ./Mid/Access only { MidAccessError, MidCanonicalAccessElaboration, elaborateCanonicalMidAccesses }

pub use ./Mid/Ir only { MidEnumDestination, MidEnumDestinationNode, MidRange, MidBodyNode, MidPlaceNode, MidProjectionNode, MidAggregateElementNode, MidSwitchCase, MidOperandNode, MidRvalueNode, MidCallTargetNode, MidCallReceiverNode, MidStatementNode, MidTerminatorNode, MidBlockNode, MidCanonicalArena, MidCanonicalBody, MidClosureBody, canonicalMidBodyIsWellFormed, MidProjection, MidPlace, MidBorrowCapability, MidOwnership, MidAccessibility, MidConstant, MidOperand, MidAggregateKind, MidAggregateElement, MidRvalue, MidCastKind, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody, MidProgram }
pub use ./Mid/DataflowState only { MidOwnershipStates, MidAccessibilityStates }
pub use ./Mid/Drop only { analyzeCanonicalMidOwnership, analyzeCanonicalMidAccessibility, elaborateCanonicalMidDrops }
pub use ./Mid/Verify only { MidVerifyError, MidVerification, verifyCanonicalMidBody, verifyExecutableCanonicalMidBody }
pub use ./Mid/Build only { MidSourceBinding, MidBindingLookup, MidPlaceLookup, MidUnsupportedBuild, MidUnsupportedAssign, MidBuildError, MidBodyBuild, MidCallValue, MidAggregateValue, MidBuildState, emptyMidBody, addMidLocal, midLocalForBinding, midPlaceForRecordedIdent, buildMidLet, buildMidReturn, buildMidBlock, buildMidIf, buildParametricMidBody, buildMidBodyForInstance, buildParametricMidClosureBody, ensureParametricMidClosureBody, buildParametricMidGlobalInit }
pub use ./Mid/Instantiate only { MidInstantiateError, MidCanonicalInstantiation, instantiateCanonicalMidBody }
pub use ./Mid/Access only { MidAccessError, MidCanonicalAccessElaboration, elaborateCanonicalMidAccesses }

use ./Mid/Optimize only { MidCopyCosts, optimizeCanonicalMidCopies }
pub use ./Mid/Optimize only { MidCopyCosts, optimizeCanonicalMidCopies }

use ./Mid/Async only { MidAsyncFramePlan, planCanonicalMidAsyncFrame }
pub use ./Mid/Async only { MidAsyncFramePlan, planCanonicalMidAsyncFrame }

