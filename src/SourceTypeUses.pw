// Authored provenance, not type identity or conformance authority. A Lowered
// scope completed syntax lowering only; it has not admitted any source proof.
use ./Ir only { Bind }

pub enum SourceTypeScopeKind { FreeFunction Method Implementation RequirementSignature ExternSignature }
pub enum SourceTypeScopeState { Lowering Lowered Failed }

pub struct SourceTypeScope {
    pub val kind: SourceTypeScopeKind
    pub val anchor: U64
    pub val traitOwner: U64 = 0U64
    pub val parent: U64
    pub val state: SourceTypeScopeState
}
pub impl SourceTypeScope { factory }

pub struct AuthoredTypeUse {
    pub val term: U64
    pub val site: U64
    // One-based session-local token; zero is explicitly unowned, not a module
    // premise or permission to recover authority from the ambient cursor.
    pub val scope: U64
    pub val parameters: Array[Bind]
}
pub impl AuthoredTypeUse { factory }

pub struct SourceTypeUses {
    mut val scopes: Array[SourceTypeScope] = []
    mut val uses: Array[AuthoredTypeUse] = []
    mut val active: U64 = 0U64
}
pub impl SourceTypeUses {
    factory
    fn currentScope() -> U64 { return self.active }
    fn scopeCount() -> U64 { return self.scopes.count() }
    fn useCount() -> U64 { return self.uses.count() }
    fn scopeAt(token: U64) -> Optional[SourceTypeScope] {
        if token == 0U64 || token > self.scopes.count() { return <Optional.None /> }
        return <Optional.Some v=self.scopes[token - 1U64] />
    }
    fn useAt(index: U64) -> Optional[AuthoredTypeUse] {
        if index >= self.uses.count() { return <Optional.None /> }
        return <Optional.Some v=self.uses[index] />
    }
    inout fn begin(kind: SourceTypeScopeKind, anchor: U64, traitOwner: U64 = 0U64) -> U64 {
        self.scopes.append(<SourceTypeScope kind=kind anchor=anchor traitOwner=traitOwner parent=self.active state=<SourceTypeScopeState.Lowering /> />)
        self.active = self.scopes.count()
        return self.active
    }
    inout fn finish(token: U64, succeeded: Bool) -> Bool {
        if token == 0U64 || token != self.active || token > self.scopes.count() { return false }
        val scope = self.scopes[token - 1U64]
        match scope.state {
            SourceTypeScopeState.Lowering => {}
            SourceTypeScopeState.Lowered | SourceTypeScopeState.Failed => { return false }
        }
        self.scopes[token - 1U64] = <SourceTypeScope kind=scope.kind anchor=scope.anchor traitOwner=scope.traitOwner parent=scope.parent state=(if succeeded { give <SourceTypeScopeState.Lowered /> } else { give <SourceTypeScopeState.Failed /> }) />
        self.active = scope.parent
        return true
    }
    inout fn record(term: U64, site: U64, parameters: Array[Bind]) {
        // Every occurrence is distinct, even when term interning returns an
        // existing ID or two scopes use the same printed parameter names.
        self.uses.append(<AuthoredTypeUse term=term site=site scope=self.active parameters=parameters />)
    }
}
