// Authored provenance, not type identity or conformance authority. A Lowered
// scope completed syntax lowering only; it has not admitted any source proof.
use ./Ir only { Bind, Func }

pub enum SourceTypeScopeKind { FreeFunction Method Implementation RequirementSignature ExternSignature }
pub enum SourceTypeScopeState { Lowering Lowered Failed }
pub enum SourceTypeUseRole { Unowned Declaration DefaultArgument Body }

pub struct SourceRequirementOwner {
    pub val traitIndex: U64
    pub val slot: U64
    pub val result: U64 = 0U64
    pub val factoryError: U64 = 0U64
}
pub impl SourceRequirementOwner { factory }

pub enum SourceImplementationKind { Inherent Conformance(index: U64) }

pub struct SourceImplementationOwner {
    pub val kind: SourceImplementationKind
    pub val receiver: U64
    pub val receiverTrait: U64
    pub val receiverArguments: Array[U64]
    pub val receiverArgumentRecipes: Array[U64] = []
    pub val parameters: Array[Bind]
    pub val sourceModule: U64
    pub val extensionId: U64
}
pub impl SourceImplementationOwner { factory }

// One-based IDs, contiguous within the original declaration.
pub struct SourceBoundRange {
    pub val first: U64 = 0U64
    pub val count: U64 = 0U64
}
pub impl SourceBoundRange { factory }

pub struct SourceTypeScope {
    pub val kind: SourceTypeScopeKind
    pub val anchor: U64
    pub val traitOwner: U64 = 0U64
    pub val parent: U64
    pub val state: SourceTypeScopeState
    // Only registered free functions, methods and extern signatures have a
    // function identity. Raw trait requirements and impls never borrow one.
    pub val function: Optional[U64] = <Optional.None />
    pub val requirement: Optional[SourceRequirementOwner] = <Optional.None />
    pub val implementation: Optional[SourceImplementationOwner] = <Optional.None />
    pub val bounds: Optional[SourceBoundRange] = <Optional.None />
}
pub impl SourceTypeScope { factory }

// A derived node is structural provenance, never source admission authority.
// Authored nodes instead identify exactly one immutable source occurrence.
pub enum SourceTypeRecipeOrigin { Authored ProjectionReceiver BoundSelection ResultRepresentation LexicalParameter }
pub struct SourceTypeRecipe {
    pub val term: U64
    pub val children: Array[U64]
    pub val labels: Array[U64]
    pub val origin: SourceTypeRecipeOrigin
    pub val occurrence: U64 = 0U64
    // Representation changes retain provenance separately from semantic edges.
    pub val sourceRecipe: U64 = 0U64
}
pub impl SourceTypeRecipe { factory }

pub struct AuthoredTypeUse {
    pub val term: U64
    pub val site: U64
    // One-based session-local token; zero is explicitly unowned, not a module
    // premise or permission to recover authority from the ambient cursor.
    pub val scope: U64
    pub val parameters: Array[Bind]
    pub val role: SourceTypeUseRole
    pub val recipe: U64 = 0U64
}
pub impl AuthoredTypeUse { factory }

// Signature lowering completes before either a trait slot or an extern
// function is registered. Carry the originating token through that handoff.
pub struct LoweredSourceSignature {
    pub val function: Func
    pub val scope: U64
    pub val result: U64 = 0U64
    pub val factoryError: U64 = 0U64
}
pub impl LoweredSourceSignature { factory }

// Source signature slots retain the exact root annotation occurrence. A type
// term can occur in several slots/scopes without sharing admission authority.
pub struct AuthoredFunctionSignature {
    pub val function: U64
    pub val scope: U64
    pub val parameters: Array[U64]
    pub val result: U64
    pub val factoryError: U64 = 0U64
    pub val declarationUses: Array[U64]
}
pub impl AuthoredFunctionSignature { factory }

pub struct SourceTypeUses {
    mut val scopes: Array[SourceTypeScope] = []
    mut val uses: Array[AuthoredTypeUse] = []
    mut val recipes: Array[SourceTypeRecipe] = []
    // Lowering context only; immutable receipts retain the role at creation.
    // One row per scope, appended by begin together with that scope.
    mut val roles: Array[SourceTypeUseRole] = []
    mut val active: U64 = 0U64
    mut val declarationUses: Array[Array[U64]] = []
    mut val signatures: Array[AuthoredFunctionSignature] = []
    mut val functionSignatures: Dictionary[U64, U64] = [:]
    mut val requirementScopes: Array[U64] = []
    mut val requirementScopeByIndex: Dictionary[U64, U64] = [:]
    mut val methodScopes: Dictionary[U64, U64] = [:]
}
pub impl SourceTypeUses {
    factory
    fn currentScope() -> U64 { return self.active }
    fn inImplementation() -> Bool {
        if self.active == 0U64 { return false }
        match self.scopes[self.active - 1U64].kind {
            SourceTypeScopeKind.Implementation => { return true }
            _ => { return false }
        }
    }
    fn inMethod() -> Bool {
        if self.active == 0U64 { return false }
        match self.scopes[self.active - 1U64].kind { SourceTypeScopeKind.Method => { return true } _ => { return false } }
    }
    fn currentRole() -> SourceTypeUseRole {
        if self.active == 0U64 { return <SourceTypeUseRole.Unowned /> }
        return self.roles[self.active - 1U64]
    }
    inout fn setRole(token: U64, role: SourceTypeUseRole) -> Bool {
        if token == 0U64 || token != self.active || token > self.scopes.count() { return false }
        match self.scopes[token - 1U64].state { SourceTypeScopeState.Lowering => {} _ => { return false } }
        match role { SourceTypeUseRole.Unowned => { return false } _ => {} }
        self.roles[token - 1U64] = role
        return true
    }

    fn scopeCount() -> U64 { return self.scopes.count() }
    fn useCount() -> U64 { return self.uses.count() }
    fn scopeAt(token: U64) -> Optional[SourceTypeScope] {
        if token == 0U64 || token > self.scopes.count() { return <Optional.None /> }
        return <Optional.Some v=self.scopes[token - 1U64] />
    }
    fn methodScopeFor(function: U64) -> Optional[SourceTypeScope] {
        return self.scopeAt(token: self.methodScopes.getOr(key: function, fallback: 0U64))
    }

    fn completedMethodImplementation(method: SourceTypeScope) -> Optional[SourceImplementationOwner] {
        match method.state { SourceTypeScopeState.Lowered => {} _ => { return <Optional.None /> } }
        match self.scopeAt(token: method.parent) {
            Optional.Some(v: val parent) => {
                match parent.state { SourceTypeScopeState.Lowered => { return parent.implementation } _ => {} }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn useAt(index: U64) -> Optional[AuthoredTypeUse] {
        if index >= self.uses.count() { return <Optional.None /> }
        return <Optional.Some v=self.uses[index] />
    }
    inout fn begin(kind: SourceTypeScopeKind, anchor: U64, traitOwner: U64 = 0U64) -> U64 {
        self.scopes.append(<SourceTypeScope kind=kind anchor=anchor traitOwner=traitOwner parent=self.active state=<SourceTypeScopeState.Lowering /> />)
        self.roles.append(<SourceTypeUseRole.Declaration />)
        self.declarationUses.append([])
        self.active = self.scopes.count()
        return self.active
    }
    inout fn bindFunction(token: U64, function: U64) -> Bool {
        if token == 0U64 || token > self.scopes.count() { return false }
        val scope = self.scopes[token - 1U64]
        if scope.function.isSome() { return false }
        match scope.kind {
            SourceTypeScopeKind.FreeFunction => {
                if token != self.active { return false }
                match scope.state { SourceTypeScopeState.Lowering => {} _ => { return false } }
            }
            SourceTypeScopeKind.Method => {
                if token != self.active || scope.parent == 0U64 || self.methodScopes.contains(key: function) { return false }
                val parent = self.scopes[scope.parent - 1U64]
                match parent.kind { SourceTypeScopeKind.Implementation => {} _ => { return false } }
                match scope.state { SourceTypeScopeState.Lowering => {} _ => { return false } }
                self.methodScopes[function] = token
            }
            SourceTypeScopeKind.ExternSignature => {
                match scope.state { SourceTypeScopeState.Lowered => {} _ => { return false } }
            }
            SourceTypeScopeKind.Implementation | SourceTypeScopeKind.RequirementSignature => { return false }
        }
        self.scopes[token - 1U64] = <SourceTypeScope kind=scope.kind anchor=scope.anchor traitOwner=scope.traitOwner parent=scope.parent state=scope.state function=<Optional.Some v=function /> requirement=scope.requirement implementation=scope.implementation bounds=scope.bounds />
        return true
    }

    inout fn bindRequirement(token: U64, traitOwner: U64, index: U64, requirement: SourceRequirementOwner) -> Bool {
        if token == 0U64 || token > self.scopes.count() { return false }
        val scope = self.scopes[token - 1U64]
        match scope.kind { SourceTypeScopeKind.RequirementSignature => {} _ => { return false } }
        match scope.state { SourceTypeScopeState.Lowered => {} _ => { return false } }
        if scope.traitOwner != traitOwner || self.requirementScopeByIndex.contains(key: index) || scope.requirement.isSome() || (requirement.result != 0U64 && requirement.factoryError != 0U64) { return false }
        if !self.signatureUseBelongs(id: requirement.result, scope: token) || !self.signatureUseBelongs(id: requirement.factoryError, scope: token) { return false }
        self.scopes[token - 1U64] = <SourceTypeScope kind=scope.kind anchor=scope.anchor traitOwner=scope.traitOwner parent=scope.parent state=scope.state function=scope.function requirement=<Optional.Some v=requirement /> implementation=scope.implementation bounds=scope.bounds />
        self.requirementScopes.append(token)
        self.requirementScopeByIndex[index] = token
        return true
    }

    fn requirementScopeFor(index: U64) -> Optional[U64] { return self.requirementScopeByIndex.get(key: index) }

    fn requirementScopeCount() -> U64 { return self.requirementScopes.count() }
    fn requirementScopeAt(index: U64) -> U64 { return self.requirementScopes[index] }

    fn declarationUsesIn(scope: U64) -> Array[U64] { return self.declarationUses[scope - 1U64] }

    inout fn bindBounds(range: SourceBoundRange) -> Bool {
        if self.active == 0U64 { return false }
        val index = self.active - 1U64
        val scope = self.scopes[index]
        if scope.bounds.isSome() { return false }
        match scope.state { SourceTypeScopeState.Lowering => {} _ => { return false } }
        self.scopes[index] = <SourceTypeScope kind=scope.kind anchor=scope.anchor traitOwner=scope.traitOwner parent=scope.parent state=scope.state function=scope.function requirement=scope.requirement implementation=scope.implementation bounds=<Optional.Some v=range /> />
        return true
    }

    inout fn bindImplementation(token: U64, implementation: SourceImplementationOwner) -> Bool {
        if token == 0U64 || token != self.active || token > self.scopes.count() { return false }
        val scope = self.scopes[token - 1U64]
        match scope.kind { SourceTypeScopeKind.Implementation => {} _ => { return false } }
        match scope.state { SourceTypeScopeState.Lowering => {} _ => { return false } }
        if scope.implementation.isSome() { return false }
        self.scopes[token - 1U64] = <SourceTypeScope kind=scope.kind anchor=scope.anchor traitOwner=scope.traitOwner parent=scope.parent state=scope.state implementation=<Optional.Some v=implementation /> bounds=scope.bounds />
        return true
    }

    inout fn finish(token: U64, succeeded: Bool) -> Bool {
        if token == 0U64 || token != self.active || token > self.scopes.count() { return false }
        val scope = self.scopes[token - 1U64]
        match scope.state {
            SourceTypeScopeState.Lowering => {}
            SourceTypeScopeState.Lowered | SourceTypeScopeState.Failed => { return false }
        }
        self.scopes[token - 1U64] = <SourceTypeScope kind=scope.kind anchor=scope.anchor traitOwner=scope.traitOwner parent=scope.parent state=(if succeeded { give <SourceTypeScopeState.Lowered /> } else { give <SourceTypeScopeState.Failed /> }) function=scope.function requirement=scope.requirement implementation=scope.implementation bounds=scope.bounds />
        match scope.function {
            Optional.Some(v: val function) => {
                match self.functionSignatures.get(key: function) {
                    Optional.Some(v: val index) => {
                        val signature = self.signatures[index]
                        if signature.scope == token {
                            self.signatures[index] = <AuthoredFunctionSignature function=function scope=token parameters=signature.parameters result=signature.result factoryError=signature.factoryError declarationUses=self.declarationUses[token - 1U64] />
                        }
                    }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        self.active = scope.parent
        return true
    }
    fn signatureCount() -> U64 { return self.signatures.count() }
    fn signatureAt(index: U64) -> Optional[AuthoredFunctionSignature] {
        if index >= self.signatures.count() { return <Optional.None /> }
        return <Optional.Some v=self.signatures[index] />
    }
    fn signatureFor(function: U64) -> Optional[AuthoredFunctionSignature] {
        match self.functionSignatures.get(key: function) {
            Optional.Some(v: val index) => { return self.signatureAt(index: index) }
            Optional.None => { return <Optional.None /> }
        }
    }
    fn signatureUseBelongs(id: U64, scope: U64) -> Bool {
        if id == 0U64 { return true }
        if id > self.uses.count() { return false }
        val occurrence = self.uses[id - 1U64]
        if occurrence.scope != scope { return false }
        match occurrence.role { SourceTypeUseRole.Declaration => { return true } _ => { return false } }
    }
    inout fn bindSignature(token: U64, function: U64, parameters: Array[U64], result: U64, factoryError: U64 = 0U64) -> Bool {
        if token == 0U64 || token != self.active || token > self.scopes.count() || self.functionSignatures.contains(key: function) { return false }
        val scope = self.scopes[token - 1U64]
        match scope.kind { SourceTypeScopeKind.FreeFunction => { if factoryError != 0U64 { return false } } SourceTypeScopeKind.Method => {} _ => { return false } }
        if result != 0U64 && factoryError != 0U64 { return false }
        match scope.state { SourceTypeScopeState.Lowering => {} _ => { return false } }
        if scope.function.unwrapOr(fallback: 18446744073709551615U64) != function { return false }
        mut val index = 0U64
        while index < parameters.count() {
            val occurrence = parameters[index]
            if !self.signatureUseBelongs(id: occurrence, scope: token) { return false }
            if occurrence != 0U64 {
                if occurrence == result || occurrence == factoryError { return false }
                mut val previous = 0U64
                while previous < index { if parameters[previous] == occurrence { return false } previous += 1U64 }
            }
            index += 1U64
        }
        if !self.signatureUseBelongs(id: result, scope: token) || !self.signatureUseBelongs(id: factoryError, scope: token) { return false }
        self.functionSignatures[function] = self.signatures.count()
        self.signatures.append(<AuthoredFunctionSignature function=function scope=token parameters=parameters result=result factoryError=factoryError declarationUses=self.declarationUses[token - 1U64] />)
        return true
    }
    fn recipeCount() -> U64 { return self.recipes.count() }
    fn recipeAt(id: U64) -> Optional[SourceTypeRecipe] {
        if id == 0U64 || id > self.recipes.count() { return <Optional.None /> }
        return <Optional.Some v=self.recipes[id - 1U64] />
    }
    inout fn deriveRecipe(term: U64, children: Array[U64], labels: Array[U64], origin: SourceTypeRecipeOrigin, sourceRecipe: U64 = 0U64) -> U64 {
        self.recipes.append(<SourceTypeRecipe term=term children=children labels=labels origin=origin sourceRecipe=sourceRecipe />)
        return self.recipes.count()
    }
    inout fn record(term: U64, site: U64, parameters: Array[Bind], children: Array[U64] = [], labels: Array[U64] = []) -> U64 {
        // Every occurrence is distinct, even when term interning returns an
        // existing ID or two scopes use the same printed parameter names.
        val role = self.currentRole()
        val id = self.uses.count() + 1U64
        self.recipes.append(<SourceTypeRecipe term=term children=children labels=labels origin=<SourceTypeRecipeOrigin.Authored /> occurrence=id />)
        self.uses.append(<AuthoredTypeUse term=term site=site scope=self.active parameters=parameters role=role recipe=self.recipes.count() />)
        match role {
            SourceTypeUseRole.Declaration => { self.declarationUses[self.active - 1U64].append(id) }
            _ => {}
        }
        return id
    }
}
