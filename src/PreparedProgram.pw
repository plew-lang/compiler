import ./Mid/Build with { MidBuildError, MidFunctionTemplates }
// LLVM-independent preparation of the frontend's selected executable program.
// Includes declaration global effects; unresolved declaration obligations do
// not yet constitute a whole-target checked-program token.
import ./Frontend with { Comp }
import ./Diag with { CompileDiagnostic }
import ./Mid/Program with { MidExecutableProgram, MidProgramError }
import ./Mid/Ambient with { MidAmbientProgram }
import ./Mid/DeclarationAccess with { analyzeDeclarationGlobalAccess, DeclarationAccessAnalysis, DeclarationAccessNode, DeclarationAccessError }
import ./Mid/GlobalAccess with { conflictingMidGlobalAccess }
import ./Mid/Diagnostics with { reportMidBuildError, midPreparationDiagnostic }

pub enum ProgramPreparationError {
    Frontend(diagnostic: CompileDiagnostic)
    Declaration(error: DeclarationAccessError)
    Mid(error: MidProgramError)
    GlobalAccess(offset: U64)
}

pub struct PreparedProgram {
    pub val executable: MidExecutableProgram
    pub val ambient: MidAmbientProgram
    pub val declarationAccess: DeclarationAccessAnalysis
}

pub impl PreparedProgram {
    assoc fn prepare(c: inout Comp) -> Result[Self, ProgramPreparationError] {
        mut val templates = <MidFunctionTemplates />
        val declarationAccess = if c.genMode { give <DeclarationAccessAnalysis /> } else {
            give match analyzeDeclarationGlobalAccess(c: inout c, templates: inout templates) {
                Result.Ok(value: val analysis) => { give analysis }
                Result.Err(error: val error) => { return <Result.Err error=<ProgramPreparationError.Declaration error=error /> /> }
            }
        }
        if declarationAccess.conflictingNode != 0U64 {
            val owner = declarationAccess.nodes[declarationAccess.conflictingNode - 1U64]
            return <Result.Err error=<ProgramPreparationError.GlobalAccess offset=declarationAccessOffset(c: inout c, owner: owner) /> />
        }
        val preparation = MidExecutableProgram.prepareWithTemplates(c: inout c, templates: inout templates)
        val ambient: Result[MidAmbientProgram, CompileDiagnostic] = match preparation {
            Result.Ok(value: val program) => { give MidAmbientProgram.prepare(c: inout c, program: program) }
            Result.Err(error: _) => { give <Result.Ok value=<MidAmbientProgram.empty /> /> }
        }
        // Preserve the existing diagnostic precedence, including partial Mid
        // failures. This analysis reads the same arena prepared above.
        val conflictingBody = match conflictingMidGlobalAccess(c: inout c) {
            Result.Ok(value: val body) => { give body }
            Result.Err(error: val diagnostic) => { return <Result.Err error=<ProgramPreparationError.Frontend diagnostic=diagnostic /> /> }
        }
        if conflictingBody != 0U64 {
            val sourceFunction = c.mid.bodies[conflictingBody - 1U64].sourceFunction
            mut val offset = 0U64
            if sourceFunction < c.arena.functionCount() { offset = c.arena.functionAt(index: sourceFunction).defOffset }
            return <Result.Err error=<ProgramPreparationError.GlobalAccess offset=offset /> />
        }
        val ambientProgram = match ambient {
            Result.Ok(value: val program) => { give program }
            Result.Err(error: val diagnostic) => { return <Result.Err error=<ProgramPreparationError.Frontend diagnostic=diagnostic /> /> }
        }
        match preparation {
            Result.Ok(value: val program) => { return <Result.Ok value=<PreparedProgram executable=program ambient=ambientProgram declarationAccess=declarationAccess /> /> }
            Result.Err(error: val error) => { return <Result.Err error=<ProgramPreparationError.Mid error=error /> /> }
        }
    }
}

fn declarationAccessOffset(c: inout Comp, owner: DeclarationAccessNode) -> U64 {
    match owner {
        DeclarationAccessNode.Function(function: val function) => { if function < c.arena.functionCount() { return c.arena.functionAt(index: function).defOffset } }
        DeclarationAccessNode.Closure(bodyKey: val key) => {
            mut val index = 0U64
            while index < c.decls.semanticClosures.count() {
                val closure = c.decls.semanticClosures[index]
                if closure.bodyKey == key { return c.exprOffset(id: closure.exprId) }
                index += 1U64
            }
        }
        _ => {}
    }
    return 0U64
}

// Convert a preparation failure without terminating the caller. Trace options
// retain the existing detailed internal-error output.
pub fn programPreparationDiagnostic(c: inout Comp, error: ProgramPreparationError) -> CompileDiagnostic {
    match error {
        ProgramPreparationError.Frontend(diagnostic: val diagnostic) => { return diagnostic }
        ProgramPreparationError.GlobalAccess(offset: val offset) => {
            return c.diagnosticAt(offset: offset, msg: "borrowed global storage overlaps an access in the called body")
        }
        ProgramPreparationError.Declaration(error: val failure) => {
            match failure {
                DeclarationAccessError.Frontend(diagnostic: val diagnostic) => { return diagnostic }
                DeclarationAccessError.Build(body: val owner, error: val error) => {
                    match error {
                        MidBuildError.Frontend(diagnostic: val diagnostic) => { return diagnostic }
                        MidBuildError.StringLiteral(val offset, val message) => { return c.diagnosticAt(offset: offset, msg: message) }
                        _ => {}
                    }
                    match owner {
                        DeclarationAccessNode.Function(function: val function) => { reportMidBuildError(c: inout c, fnIdx: function, error: error) }
                        _ => {}
                    }
                    return c.diagnosticAt(offset: declarationAccessOffset(c: inout c, owner: owner), msg: "internal error: declaration Mid construction failed")
                }
                DeclarationAccessError.Ownership(body: val owner) => { return c.diagnosticAt(offset: declarationAccessOffset(c: inout c, owner: owner), msg: "internal error: declaration ownership analysis failed") }
                DeclarationAccessError.CallSelection(body: val owner, terminator: _) => { return c.diagnosticAt(offset: declarationAccessOffset(c: inout c, owner: owner), msg: "internal error: declaration call selection is missing") }
            }
        }
        ProgramPreparationError.Mid(error: val failure) => {
            match failure {
                MidProgramError.Build(bodyId: val bodyId, error: val error) => {
                    match error {
                        MidBuildError.Frontend(diagnostic: val diagnostic) => { return diagnostic }
                        MidBuildError.StringLiteral(val offset, val message) => { return c.diagnosticAt(offset: offset, msg: message) }
                        _ => {}
                    }
                    reportMidBuildError(c: inout c, fnIdx: c.arena.bodyInstanceAt(index: bodyId - 1U64).fnIdx, error: error)
                }
                MidProgramError.Preparation(bodyId: val bodyId, error: val error) => {
                    match midPreparationDiagnostic(c: inout c, fnIdx: c.arena.bodyInstanceAt(index: bodyId - 1U64).fnIdx, failure: error) {
                        Optional.Some(v: val diagnostic) => { return diagnostic }
                        Optional.None => {}
                    }
                }
                _ => {}
            }
            return c.diagnosticAt(offset: 0U64, msg: "internal error: program Mid preparation failed")
        }
    }
}
