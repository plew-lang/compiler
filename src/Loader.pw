// ---- multi-file module loading (parse-driven) ----
//
// A module may span several files: `part <path>` stitches a file into the same
// module (shared scope), `import <path>` pulls in a separate module. Loading is
// PARSE-DRIVEN: the driver (main) appends each file's source to the arena's byte
// buffer, parses it with the shared @Plew/Syntax parser, lowers
// its items, and follows the `import`/`part` nodes the parser returns to discover
// more files — no separate directive pre-scan. Every distinct file is appended once
// (single-arena, single-C-output; no separate compilation). `resolveImport` turns a
// path node into a file path (`@Std/X`, `/Seg`, `./Name`, `../Name`).

// Parse one already-appended file (its bytes sit at c.arena.bytes[fileStart..]) through the
// shared @Plew/Syntax parser. Lowering is deliberately a later phase: aliases and declaration
// identities are meaningful only after the complete module graph has been discovered. `base =`
// `fileStart` so every node span is an absolute offset into c.arena.bytes (module tagging via
// moduleOf works). The returned tree drives import/part discovery and is then lowered in the
// same file order once loading is complete.
pub impl Comp {
    // Append to Comp's one syntax store and retain only the root range for this
    // file.  Import scan and lowering consume those immutable IDs directly.
    inout fn parseFileSyntax(fileBytes: Array[U8], fileStart: U64) -> Result[SyntaxSlice, CompileDiagnostic] {
        mut val lx: Lexer = <Lexer bytes=fileBytes pos=0U64 toks=[] depth=0I64 />
        lex(lx: inout lx)
        mut val p: P = <P bytes=fileBytes toks=lx.toks pos=0U64 base=fileStart />
        val roots: SyntaxSlice = parseProgramSyntaxInto(p: inout p, file: inout self.syntax)
        if p.hasErr {
            return <Result.Err error=self.diagnosticAt(offset: p.errOff, msg: p.errMsg) />
        }
        return <Result.Ok value=roots />
    }

    // This deliberately needs no declaration/statement materialization: the
    // top-level tag, source span, and Export's nested TopItemId completely
    // determine this rule.
    inout fn checkPartSyntaxOnly(roots: SyntaxSlice) -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0U64
        while i < roots.count {
            try self.rejectNonImplSyntaxItem(item: syntaxFileTopLevel(file: self.syntax, index: roots.start + i))
            i += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn rejectNonImplSyntaxItem(item: TopItemId) -> Result[(), CompileDiagnostic] {
        match syntaxTopItemKind(file: self.syntax, item: item) {
            SyntaxTopItemKind.Impl => {}
            SyntaxTopItemKind.Import => {}
            SyntaxTopItemKind.Directive => {}
            SyntaxTopItemKind.Export => {
                try self.rejectNonImplSyntaxItem(item: <TopItemId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)
            }
            _ => {
                return <Result.Err error=self.partItemDiagnostic(offset: syntaxTopItemSpan(file: self.syntax, item: item).start) />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn partItemDiagnostic(offset: U64) -> CompileDiagnostic {
        return self.diagnosticAt(offset: offset, msg: "a `part` file may contain only `impl` blocks (spec/15) — move this free function / type / extern / top-level `val` to the module root or another module")
    }
}
