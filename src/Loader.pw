// ---- multi-file module loading (parse-driven) ----
//
// A module may span several files: `part <path>` stitches a file into the same
// module (shared scope), `use <path>` pulls in a separate module. Loading is
// PARSE-DRIVEN: the loader appends each file's source to the arena's byte
// buffer, parses it with the shared @Plew/Syntax parser, lowers
// its items, and follows the `use`/`part` nodes the parser returns to discover
// more files — no separate directive pre-scan. Every distinct file is appended once
// (single source arena; no per-file compilation). `resolveImport` turns a
// path node into a file path (`@Std/X`, `/Seg`, `./Name`, `../Name`).

// Parse one already-appended file (its bytes sit at c.arena.bytes[fileStart..]) through the
// shared @Plew/Syntax parser. Lowering is deliberately a later phase: aliases and declaration
// identities are meaningful only after the complete module graph has been discovered. `base =`
// `fileStart` so every node span is an absolute offset into c.arena.bytes (module tagging via
// moduleOf works). The returned tree drives use/part discovery and is then lowered in the
// same file order once loading is complete.
pub impl Comp {
    // Append to Comp's one syntax store and retain only the root range for this
    // file.  Import scan and lowering consume those immutable IDs directly.
    inout fn parseFileSyntax(fileBytes: Array[U8], fileStart: U64) -> Result[SyntaxSlice, CompileDiagnostic] {
        mut val lx: Lexer = <Lexer bytes=fileBytes pos=0U64 toks=[] depth=0I64 />
        lex(lx: inout lx)
        mut val p: P = <P bytes=fileBytes toks=lx.toks pos=0U64 base=fileStart />
        val roots: SyntaxSlice = parseProgramSyntaxInto(p: inout p, file: inout self.syntax)
        if p.hasErr {
            // This cursor was constructed here from source bytes. The pinned
            // parser's fail contract is a syntax error, not a raw IR validator.
            return <Result.Err error=self.diagnosticAt(offset: p.errOff, msg: p.errMsg, failureDomain: <FailureDomain.Source />) />
        }
        return <Result.Ok value=roots />
    }

    // Raw structural entry points do not own source-file membership. Keep
    // their reports unclassified even if the caller happens to be a loader.
    inout fn checkPartSyntaxOnly(roots: SyntaxSlice) -> Result[(), CompileDiagnostic] {
        return self.rawPartSyntaxResult(check: PartSyntaxCheck.inspect(file: self.syntax, roots: roots))
    }

    inout fn rejectNonImplSyntaxItem(item: TopItemId) -> Result[(), CompileDiagnostic] {
        return self.rawPartSyntaxResult(check: PartSyntaxCheck.inspectItem(file: self.syntax, item: item))
    }

    inout fn partItemDiagnostic(offset: U64) -> CompileDiagnostic {
        return self.diagnosticAt(offset: offset, msg: PartSyntaxCheck.otherPartItemMessage())
    }
}


impl PartSyntaxCheck {
    assoc fn otherPartItemMessage() -> String {
        return "a `part` file may contain only `impl` blocks (spec/15) — move this free function / type / extern / top-level `val` to the module root or another module"
    }
    assoc fn rootOnlyUseMessage() -> String {
        return "`use` / `pub use` is allowed only in a module root (spec/15) — move this directive to the root; its bindings are shared by all parts"
    }
    assoc fn inspect(file: SyntaxFile, roots: SyntaxSlice) -> PartSyntaxCheck {
        val count = syntaxFileTopLevelCount(file: file)
        if roots.start > count || roots.count > count-roots.start { return <PartSyntaxCheck.InvalidRange /> }
        for index in 0U64..<roots.count {
            val check = PartSyntaxCheck.inspectItem(file: file, item: syntaxFileTopLevel(file: file, index: roots.start+index))
            match check { PartSyntaxCheck.Allowed => {} _ => { return check } }
        }
        return <PartSyntaxCheck.Allowed />
    }
    assoc fn inspectItem(file: SyntaxFile, item: TopItemId) -> PartSyntaxCheck {
        return match syntaxTopItemKind(file: file, item: item) {
            SyntaxTopItemKind.Impl | SyntaxTopItemKind.Directive => <PartSyntaxCheck.Allowed />
            SyntaxTopItemKind.Import => {
                val directive = syntaxImport(file: file, id: <ImportId raw=syntaxTopItemPayload(file: file, item: item) />)
                if directive.isImport { return <PartSyntaxCheck.RootOnlyUse offset=directive.span.start /> }
                if directive.isPublic { return <PartSyntaxCheck.OtherPartItem offset=directive.span.start /> }
                give <PartSyntaxCheck.Allowed />
            }
            SyntaxTopItemKind.Published => PartSyntaxCheck.inspectItem(file: file, item: <TopItemId raw=syntaxTopItemPayload(file: file, item: item) />)
            _ => <PartSyntaxCheck.OtherPartItem offset=syntaxTopItemSpan(file: file, item: item).start />
        }
    }
}

impl Comp {
    inout fn rawPartSyntaxResult(check: PartSyntaxCheck) -> Result[(), CompileDiagnostic] {
        return match check {
            PartSyntaxCheck.Allowed => <Result.Ok value=() />
            PartSyntaxCheck.RootOnlyUse(offset: val offset) => <Result.Err error=self.diagnosticAt(offset: offset, msg: PartSyntaxCheck.rootOnlyUseMessage()) />
            PartSyntaxCheck.OtherPartItem(offset: val offset) => <Result.Err error=self.partItemDiagnostic(offset: offset) />
            PartSyntaxCheck.InvalidRange => <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid part syntax range", failureDomain: <FailureDomain.Internal />) />
        }
    }

    // This operation consumes source text, never an external AST or report.
    // The load graph supplies Root/Part; parsing establishes the syntax being
    // checked. No source-admission enum or mutable Comp flag grants authority.
    inout fn parseLoadedSource(source: String, target: LoadedSourceTarget) -> Result[SyntaxSlice, CompileDiagnostic] {
        val bytes = source.bytes()
        if self.arena.bytes.count() > 0U64 { self.arena.bytes.append(10U8) }
        val start = self.arena.bytes.count()
        self.appendSrc(from: bytes)
        self.modules.registerSourceFile(start: start, length: self.arena.bytes.count()-start, moduleId: target.moduleId, path: target.path, syntaxRoot: target.syntaxRoot)
        val roots = try self.parseFileSyntax(fileBytes: bytes, fileStart: start)
        match target.role {
            LoadedSourceRole.Root => {}
            LoadedSourceRole.Part => {
                val check = PartSyntaxCheck.inspect(file: self.syntax, roots: roots)
                match check {
                    PartSyntaxCheck.RootOnlyUse(offset: val offset) => {
                        return <Result.Err error=self.diagnosticAt(offset: offset, msg: PartSyntaxCheck.rootOnlyUseMessage(), failureDomain: <FailureDomain.Source />) />
                    }
                    PartSyntaxCheck.OtherPartItem(offset: val offset) => {
                        return <Result.Err error=self.diagnosticAt(offset: offset, msg: PartSyntaxCheck.otherPartItemMessage(), failureDomain: <FailureDomain.Source />) />
                    }
                    _ => { try self.rawPartSyntaxResult(check: check) }
                }
            }
        }
        return <Result.Ok value=roots />
    }
}
