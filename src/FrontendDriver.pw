// CLI adapter only. Embedders call analyzeFrontend with explicit inputs.
import @Std/Io with { readStdin }
import @Std/Process with { argCount, argAt, exit }
import ./Frontend with { Comp, FrontendInput, FrontendOptions, analyzeFrontend }
import ./Diag with { emitDiagnostic }
import ./SourceAccess with { SourceAccess }
import ./Path with { computeStdRoot }

pub fn runFrontend(c: inout Comp, sources: SourceAccess = <SourceAccess />, firstArgument: I64 = 1I64) {
    // gen mode (spec/16): `plewc --gen <file>` synthesizes a derive-runner harness
    // instead of compiling the user program. The entry path then sits at argv[2].
    mut val genMode: Bool = false
    mut val tcLog: Bool = false
    mut val asan: Bool = false
    mut val traceCodegen: Bool = false
    mut val tracePhases: Bool = false
    mut val emitMidCoverage: Bool = false
    mut val requireMid: Bool = false
    mut val entryArgIdx: I64 = firstArgument
    while entryArgIdx < argCount() {
        val option: String = argAt(entryArgIdx)
        mut val recognized: Bool = false
        if option == "--gen" {
            genMode = true
            recognized = true
        }
        // `plewc --tc-log <file>`: run the new TypeRef-based type checker in
        // log-only mode (print mismatches, reject nothing) for development/triage.
        if option == "--tc-log" {
            tcLog = true
            recognized = true
        }
        // `plewc --asan <file>`: emit a module that a downstream `opt -passes=asan`
        // can actually instrument (host target triple + `sanitize_address` on every
        // defined function). See Comp.asan and Backend emitLlvm.
        if option == "--asan" {
            asan = true
            recognized = true
        }
        if option == "--trace-codegen" {
            traceCodegen = true
            recognized = true
        }
        if option == "--trace-phases" {
            tracePhases = true
            recognized = true
        }
        if option == "--emit-mid-coverage" {
            emitMidCoverage = true
            recognized = true
        }
        if option == "--require-mid" {
            requireMid = true
            recognized = true
        }
        if !recognized { break }
        entryArgIdx += 1
    }
    val input = if argCount() > entryArgIdx {
        give <FrontendInput.File path=argAt(entryArgIdx) />
    } else {
        give <FrontendInput.Text text=readStdin() path="<stdin>" />
    }
    val configuredSources = <SourceAccess
        stdRoot=if sources.stdRoot.count() != 0U64 { give sources.stdRoot } else { give computeStdRoot(arg0: argAt(0).bytes()) }
        resources=sources.resources />
    val analysis = analyzeFrontend(c: inout c, input: input, sources: configuredSources,
        options: <FrontendOptions genMode=genMode tcLog=tcLog asan=asan traceCodegen=traceCodegen tracePhases=tracePhases emitMidCoverage=emitMidCoverage requireMid=requireMid />)
    match analysis {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => {
            emitDiagnostic(diagnostic: diagnostic)
            exit(code: 1)
        }
    }
}
