// Decode a lexically valid quoted string span independently of LLVM and Comp.
// The result includes a trailing NUL for native string storage.
import @Std/Core with { truncU8 }
//
// Decode one C-style escape (the byte after a backslash) to its actual byte.
fn escByte(nx: U8) -> U8 {
    if nx == 110 { return 10 }
    if nx == 116 { return 9 }
    if nx == 114 { return 13 }
    if nx == 48 { return 0 }
    return nx
}

// Decode a string literal's source span (start = the opening quote) to its actual
// bytes plus a trailing NUL, mirroring strDecodedLen's escape model (a backslash
// escapes the next byte). The trailing NUL makes it usable as a C string for
// LLVMBuildGlobalStringPtr; the PlewString length excludes it.
// Value of one ASCII hex digit (0-9 / a-f / A-F); 0 for anything else.
fn hexDigitVal(b: U8) -> U64 {
    if b >= 48U8 && b <= 57U8 { return (b - 48U8) as U64 }
    if b >= 97U8 && b <= 102U8 { return (b - 87U8) as U64 }
    if b >= 65U8 && b <= 70U8 { return (b - 55U8) as U64 }
    return 0U64
}

// UTF-8 encode a Unicode scalar `cp` (from a `\u{...}` escape) into `out`.
fn appendUtf8(out: inout Array[U8], cp: U64) {
    if cp < 128U64 {
        out.append(truncU8(n: cp))
        return
    }
    if cp < 2048U64 {
        out.append(truncU8(n: 192U64 | (cp >> 6U64)))
        out.append(truncU8(n: 128U64 | (cp & 63U64)))
        return
    }
    if cp < 65536U64 {
        out.append(truncU8(n: 224U64 | (cp >> 12U64)))
        out.append(truncU8(n: 128U64 | ((cp >> 6U64) & 63U64)))
        out.append(truncU8(n: 128U64 | (cp & 63U64)))
        return
    }
    out.append(truncU8(n: 240U64 | (cp >> 18U64)))
    out.append(truncU8(n: 128U64 | ((cp >> 12U64) & 63U64)))
    out.append(truncU8(n: 128U64 | ((cp >> 6U64) & 63U64)))
    out.append(truncU8(n: 128U64 | (cp & 63U64)))
}

pub fn decodeStringLiteral(source: Array[U8], start: U64, len: U64) -> Result[Array[U8], String] {
    mut val out: Array[U8] = []
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if source[j] == 92 {
            if source[j + 1] == 117U8 {
                // \u{XXXX}: parse hex code point between braces, UTF-8 encode it.
                mut val k: U64 = j + 2
                if k < end && source[k] == 123U8 { k += 1 }
                mut val cp: U64 = 0U64
                while k < end && source[k] != 125U8 {
                    cp = (cp << 4U64) | hexDigitVal(b: source[k])
                    k += 1
                }
                if k < end && source[k] == 125U8 { k += 1 }
                // a `\u{...}` escape must name a valid Unicode SCALAR (spec/02: String
                // is valid UTF-8): reject a value above U+10FFFF or in the surrogate
                // range U+D800..U+DFFF, which would encode to invalid UTF-8 bytes.
                if cp > 1114111U64 {
                    return <Result.Err error="`\\u{...}` escape is out of range — a Unicode scalar is at most U+10FFFF (spec/02)" />
                }
                if cp >= 55296U64 {
                    if cp <= 57343U64 {
                        return <Result.Err error="`\\u{...}` escape is a UTF-16 surrogate (U+D800..U+DFFF), not a valid Unicode scalar (spec/02)" />
                    }
                }
                appendUtf8(out: inout out, cp: cp)
                j = k
            } else {
                out.append(escByte(nx: source[j + 1]))
                j += 2
            }
        } else {
            out.append(source[j])
            j += 1
        }
    }
    out.append(0)
    return <Result.Ok value=out />
}

