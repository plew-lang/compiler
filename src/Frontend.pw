export struct Comp {
    // the shared IR arena: source bytes + every node table (see `Arena`). The
    // single owner of the program's data that all passes read; `c.arena.exprs`,
    // `c.arena.funcs`, `c.arena.bytes`, etc.
    pub mut val arena: Arena = <Arena />
    // The sole compiler-owned immutable syntax store.  The loader appends each
    // file while discovering the module graph, then all frontend passes retain
    // only TopItemId ranges into this table (never Array[TopItemAst]).
    pub mut val syntax: SyntaxFile = <SyntaxFile />
    // Source/synthetic call-origin allocator.  It never participates in AST
    // indexing and remains stable even if the arena representation changes.
    pub mut val nextExprOriginSerial: U64 = 1U64
    // declaration / conformance / name side-tables built during loading & analysis
    // (see `Decls`): traits, conformances, method aliases,
    // derive requests, where-bounds, deinits, assoc bindings, pub factories, and
    // the import-name / chain-result / keyword-span caches.
    pub mut val decls: Decls = <Decls />
    // parse-time scratch, reset at each impl/decl boundary (see `ParseScratch`).
    pub mut val parseScratch: ParseScratch = <ParseScratch />
    // the per-body codegen / lowering / verify cursor (see `Cursor`).
    pub mut val cur: Cursor = <Cursor />
    // Monotonic identity allocator for lexical generic binders. It is separate
    // from the name interner because same-spelled binders are not one term.
    pub mut val nextParamId: U64 = 1
    // lowering-time where constraints for associated-type short projection
    // normalization (`T.Item` -> `T#Trait.Item`). Kept on Comp rather than Cursor
    // because it uses Syntax-layer TypeAst and must not leak into Ir.pw.
    pub mut val lowerWhereTypes: Array[TypeAst] = []
    pub mut val lowerWhereTraits: Array[String] = []
    // SyntaxFile counterpart of the legacy projection-normalization context.
    // The ID lowerer never reconstructs value TypeAst/String just to resolve
    // `T.Item` against an enclosing `where T: Trait` bound.
    pub mut val lowerWhereSyntaxTypes: Array[TypeId] = []
    pub mut val lowerWhereSyntaxTraits: Array[Span] = []
    // gen mode (spec/16 `plew gen`): set when invoked as `plewc --gen <file>`.
    // The driver then suppresses the user's own `main` and the auto-part of
    // `<Foo>.gen.pw`, and emits a synthesized harness `main` (`genMainIdx`) that
    // prints each user macro's generated source (captured by the runner). Off in
    // a normal build (which instead auto-parts the already-generated `.gen.pw`).
    pub mut val genMode: Bool = false
    pub mut val genMainIdx: U64 = 0
    // type-checker log mode (`plewc --tc-log <file>`): the new TypeRef-based type
    // checker (Codegen/Infer.pw) prints every type mismatch it finds instead of
    // rejecting, so its coverage can be developed/triaged against self-compile
    // without breaking the build. Off in a normal build (no behavior change yet).
    pub mut val tcLog: Bool = false
    // Codegen trace mode (`plewc --trace-codegen <file>`): emit the generic-instance
    // state transitions that lead to an LLVM body. This is observational only: it
    // never changes collection, worklist ordering, or the generated module.
    pub mut val traceCodegen: Bool = false
    // Frontend phase trace (`plewc --trace-phases <file>`). This deliberately emits
    // only coarse boundaries, so an external timestamping wrapper can attribute a
    // self-host build without the voluminous generic-codegen trace.
    pub mut val tracePhases: Bool = false
    // Internal Mid migration observability. These flags never affect source
    // resolution or generated LLVM; Backend consumes the frozen body facts and
    // reports any legacy fallback on stderr after emission.
    pub mut val emitMidCoverage: Bool = false
    pub mut val requireMid: Bool = false
    // Declaration identity of the ambient `@Std/Lang` Array type.  Storage
    // consumers compare this offset against resolved TypeRef.declOffset;
    // they never infer the Array ABI from a source spelling or import alias.
    pub mut val langArrayDeclOffset: U64 = 0U64
    // Optional counters paired with --trace-phases. They isolate monomorphization
    // work amplification without changing its worklist or generated LLVM.
    pub mut val traceExprInstScans: U64 = 0
    pub mut val traceFinalBodyScans: U64 = 0
    // Instance discovery runs before Record has produced CallTemplates and
    // may inspect syntax only to find reachable generic bodies.  Once Record
    // finishes its verified second walk, all written calls must instead be
    // finalized from those templates; a miss is then an internal error.
    pub mut val callTemplatesClosed: Bool = false
    // ASan mode (`plewc --asan <file>`): the backend tags the module with the host target
    // triple and marks every DEFINED function `sanitize_address`, so a downstream
    // `opt -passes=asan` actually instruments loads/stores (a bare `.ll` has no
    // sanitize_address attribute — clang's asan pass then skips every function, which is
    // why the old gate only caught the interceptor layer). Off in a normal build.
    pub mut val asan: Bool = false
    // collection phase (mono): set ONLY while the collection passes run (collectGenInsts /
    // collectFnInsts). Grounding an anonymous record to a concrete instance is otherwise
    // PURE — it just names the grounded record. The one place that may REGISTER a new
    // grounded-record StructDef (so registerGenStructBodies later gives it an LLVM body) is the
    // collection pass, which deterministically reaches every record instance via scanType.
    // Gating registration to this phase keeps grounding side-effect-free everywhere else
    // (type checker, backend), instead of registering on demand as a side effect of
    // grounding (the old "detour"). See agents/generic-unification.md A-1.
    pub mut val inCollection: Bool = false
    // name interning (Phase C): a content-keyed table mapping each name span to a
    // stable 1-based id, so name equality is an integer compare (see `Interner`).
    pub mut val interner: Interner = <Interner />
    // typed-AST cache (Phase B): each expression node's recovered type, keyed by
    // expr id (see `TypeCache`). Built by buildExprTyTable before emission.
    pub mut val typeCache: TypeCache = <TypeCache />
    // monomorphization work lists + derived tables (see `MonoWork`): generic
    // instantiations, fn instances / types / thunks, closure captures, Array
    // element types, and recursive-field boxing. Collected after parsing, used
    // by codegen.
    pub mut val monoWork: MonoWork = <MonoWork />
    // module identity + cross-module visibility tables (spec/15): see `Modules`.
    pub mut val modules: Modules = <Modules />
}

// The effective declared type of a `val`/`mut val` binding: the written
// annotation, or — when omitted (`val x = expr`) — inferred from the initializer.
// (start,len,arr) is the head/array view; ty the structured TypeRef. Produced by
// `Comp.inferLetType` — the ONE un-annotated-let inference the scan, record, and
// verify passes share, so they all see the same local type.
export struct LetEff {
    pub val start: U64
    pub val len: U64
    pub val arr: Bool
    pub val ty: U64
}
pub impl LetEff { factory }

// A folded constant integer: non-negative magnitude `value` (U64) plus a `neg`
// sign, mirroring the literal model (Expr.Int is a magnitude; `-` is a Unary).
// (Used by Check/Literal's integer-bounds folding; a Frontend-internal helper.)
export struct ConstInt {
    pub val isConst: Bool
    pub val neg: Bool
    pub val value: U64
}
pub impl ConstInt { factory }

// An integer type's bit width + signedness, known only when a span names an integer
// type. (Used by Check/Literal's bounds checking; a Frontend-internal helper.)
export struct IntTy {
    pub val known: Bool
    pub val bits: U64
    pub val sgn: Bool
}
pub impl IntTy { factory }

// One scalar-match arm's `if` condition. A wildcard has none (it is the terminal
// `else`). (Used by Lower/Match's scalar-match lowering; a Frontend-internal helper.)
export struct ScalarCond {
    pub val hasCond: Bool
    pub val cond: U64
}
pub impl ScalarCond { factory }

// ---- arena helpers ----
//
// Methods on the arena (Comp). All take `inout self`: the struct is large, so a
// by-value receiver would copy every arena header on each call; it is always held by
// `inout` anyway. (Source appends + node pushes used by the loader and derive
// synthesis.)

pub impl Comp {
    // memberwise factory: `<Comp />` default-constructs the shared IR; the frontend
    // driver builds it in another module, so the factory must be public.
    factory
    // Append a file's source bytes onto the arena's combined byte buffer (the loader
    // builds it incrementally: each file's bytes are appended before its items are
    // lowered, so original-offset name spans resolve into it).
    inout fn appendSrc(from: Array[U8]) {
        mut val i: U64 = 0
        while i < from.count() {
            self.arena.bytes.append(from[i])
            i += 1
        }
    }
    // Append an expression node, returning its arena index. The span-start slot is
    // appended in lockstep (0 = unknown); Lower overwrites it with the parsed
    // ExprAst's span for AST-lowered nodes.
    inout fn pushExpr(e: Expr) -> U64 {
        val id: U64 = self.arena.exprs.count()
        self.arena.exprs.append(e)
        self.arena.exprSpanStart.append(0U64)
        self.arena.exprSpanEnd.append(0U64)
        self.arena.exprOriginSerial.append(self.nextExprOriginSerial)
        self.nextExprOriginSerial += 1U64
        return id
    }

    inout fn pushArgs(args: Array[Arg]) -> ArgRange {
        val start: U64 = self.arena.argPool.count()
        mut val i: U64 = 0
        while i < args.count() {
            self.arena.argPool.append(args[i])
            i += 1
        }
        return <ArgRange start=start len=args.count() />
    }

    inout fn argAt(args: ArgRange, index: U64) -> Arg {
        return self.arena.argPool[args.start + index]
    }

    inout fn pushExprs(exprs: Array[U64]) -> ExprRange {
        val start: U64 = self.arena.exprChildPool.count()
        mut val i: U64 = 0U64
        while i < exprs.count() {
            self.arena.exprChildPool.append(exprs[i])
            i += 1U64
        }
        return <ExprRange start=start len=exprs.count() />
    }

    inout fn exprAt(exprs: ExprRange, index: U64) -> U64 {
        return self.arena.exprChildPool[exprs.start + index]
    }

    inout fn pushMakeFields(fields: Array[MakeField]) -> MakeFieldRange {
        val start: U64 = self.arena.makeFieldPool.count()
        mut val i: U64 = 0U64
        while i < fields.count() {
            self.arena.makeFieldPool.append(fields[i])
            i += 1U64
        }
        return <MakeFieldRange start=start len=fields.count() />
    }

    inout fn makeFieldAt(fields: MakeFieldRange, index: U64) -> MakeField {
        return self.arena.makeFieldPool[fields.start + index]
    }

    inout fn pushBinds(binds: Array[Bind]) -> BindRange {
        val start: U64 = self.arena.bindPool.count()
        mut val i: U64 = 0U64
        while i < binds.count() {
            self.arena.bindPool.append(binds[i])
            i += 1U64
        }
        return <BindRange start=start len=binds.count() />
    }

    inout fn bindAt(binds: BindRange, index: U64) -> Bind {
        return self.arena.bindPool[binds.start + index]
    }

    inout fn pushMatchArms(arms: Array[MatchArm]) -> MatchArmRange {
        val start: U64 = self.arena.matchArmPool.count()
        mut val i: U64 = 0U64
        while i < arms.count() {
            self.arena.matchArmPool.append(arms[i])
            i += 1U64
        }
        return <MatchArmRange start=start len=arms.count() />
    }

    inout fn matchArmAt(arms: MatchArmRange, index: U64) -> MatchArm {
        return self.arena.matchArmPool[arms.start + index]
    }

    inout fn pushTraitBinds(binds: Array[Bind]) -> TraitBindRange {
        val start: U64 = self.decls.traitBindPool.count()
        mut val i: U64 = 0U64
        while i < binds.count() {
            self.decls.traitBindPool.append(binds[i])
            i += 1U64
        }
        return <TraitBindRange start=start len=binds.count() />
    }

    inout fn traitBindAt(binds: TraitBindRange, index: U64) -> Bind {
        return self.decls.traitBindPool[binds.start + index]
    }

    inout fn copyTraitBinds(binds: TraitBindRange) -> Array[Bind] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < binds.len {
            out.append(self.traitBindAt(binds: binds, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushTraitReqs(reqs: Array[Func]) -> TraitReqRange {
        val start: U64 = self.decls.traitReqPool.count()
        mut val i: U64 = 0U64
        while i < reqs.count() {
            self.decls.traitReqPool.append(reqs[i])
            i += 1U64
        }
        return <TraitReqRange start=start len=reqs.count() />
    }

    inout fn traitReqAt(reqs: TraitReqRange, index: U64) -> Func {
        return self.decls.traitReqPool[reqs.start + index]
    }

    inout fn copyTraitReqs(reqs: TraitReqRange) -> Array[Func] {
        mut val out: Array[Func] = []
        mut val i: U64 = 0U64
        while i < reqs.len {
            out.append(self.traitReqAt(reqs: reqs, index: i))
            i += 1U64
        }
        return out
    }

    // Func rows are scalar declarations. These are the only owner-aware
    // gateways for their signature payloads; compatibility copies are explicit
    // at APIs which still require a transient Array.
    inout fn pushFuncBinds(binds: Array[Bind]) -> FuncBindRange {
        val start: U64 = self.decls.funcBindPool.count()
        mut val i: U64 = 0U64
        while i < binds.count() {
            self.decls.funcBindPool.append(binds[i])
            i += 1U64
        }
        return <FuncBindRange start=start len=binds.count() />
    }

    inout fn funcBindAt(binds: FuncBindRange, index: U64) -> Bind {
        return self.decls.funcBindPool[binds.start + index]
    }

    inout fn copyFuncBinds(binds: FuncBindRange) -> Array[Bind] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < binds.len {
            out.append(self.funcBindAt(binds: binds, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushFuncTypes(types: Array[U64]) -> FuncTypeRange {
        val start: U64 = self.decls.funcTypePool.count()
        mut val i: U64 = 0U64
        while i < types.count() {
            self.decls.funcTypePool.append(types[i])
            i += 1U64
        }
        return <FuncTypeRange start=start len=types.count() />
    }

    inout fn funcTypeAt(types: FuncTypeRange, index: U64) -> U64 {
        return self.decls.funcTypePool[types.start + index]
    }

    inout fn copyFuncTypes(types: FuncTypeRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < types.len {
            out.append(self.funcTypeAt(types: types, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushFuncParams(params: Array[Param]) -> FuncParamRange {
        val start: U64 = self.decls.funcParamPool.count()
        mut val i: U64 = 0U64
        while i < params.count() {
            self.decls.funcParamPool.append(params[i])
            i += 1U64
        }
        return <FuncParamRange start=start len=params.count() />
    }

    inout fn funcParamAt(params: FuncParamRange, index: U64) -> Param {
        return self.decls.funcParamPool[params.start + index]
    }

    inout fn copyFuncParams(params: FuncParamRange) -> Array[Param] {
        mut val out: Array[Param] = []
        mut val i: U64 = 0U64
        while i < params.len {
            out.append(self.funcParamAt(params: params, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushConformTypes(types: Array[U64]) -> ConformTypeRange {
        val start: U64 = self.decls.conformTypePool.count()
        mut val i: U64 = 0U64
        while i < types.count() {
            self.decls.conformTypePool.append(types[i])
            i += 1U64
        }
        return <ConformTypeRange start=start len=types.count() />
    }

    inout fn conformTypeAt(types: ConformTypeRange, index: U64) -> U64 {
        return self.decls.conformTypePool[types.start + index]
    }

    // Compatibility boundary for helpers that have not yet accepted a range.
    // New conformance walks must use conformTypeAt directly; materializing here
    // is explicit and cannot be mistaken for reading a scalar Conform row.
    inout fn copyConformTypes(types: ConformTypeRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < types.len {
            out.append(self.conformTypeAt(types: types, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushConformBinds(binds: Array[Bind]) -> ConformBindRange {
        val start: U64 = self.decls.conformBindPool.count()
        mut val i: U64 = 0U64
        while i < binds.count() {
            self.decls.conformBindPool.append(binds[i])
            i += 1U64
        }
        return <ConformBindRange start=start len=binds.count() />
    }

    inout fn conformBindAt(binds: ConformBindRange, index: U64) -> Bind {
        return self.decls.conformBindPool[binds.start + index]
    }

    inout fn copyConformBinds(binds: ConformBindRange) -> Array[Bind] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < binds.len {
            out.append(self.conformBindAt(binds: binds, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushConformWitnesses(witnesses: Array[Func]) -> ConformWitnessRange {
        val start: U64 = self.decls.conformWitnessPool.count()
        mut val i: U64 = 0U64
        while i < witnesses.count() {
            self.decls.conformWitnessPool.append(witnesses[i])
            i += 1U64
        }
        return <ConformWitnessRange start=start len=witnesses.count() />
    }

    inout fn conformWitnessAt(witnesses: ConformWitnessRange, index: U64) -> Func {
        return self.decls.conformWitnessPool[witnesses.start + index]
    }

    inout fn copyConformWitnesses(witnesses: ConformWitnessRange) -> Array[Func] {
        mut val out: Array[Func] = []
        mut val i: U64 = 0U64
        while i < witnesses.len {
            out.append(self.conformWitnessAt(witnesses: witnesses, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushConformFuncIds(ids: Array[U64]) -> ConformFuncIdRange {
        val start: U64 = self.decls.conformFuncIdPool.count()
        mut val i: U64 = 0U64
        while i < ids.count() {
            self.decls.conformFuncIdPool.append(ids[i])
            i += 1U64
        }
        return <ConformFuncIdRange start=start len=ids.count() />
    }

    inout fn conformFuncIdAt(ids: ConformFuncIdRange, index: U64) -> U64 {
        return self.decls.conformFuncIdPool[ids.start + index]
    }

    inout fn copyConformFuncIds(ids: ConformFuncIdRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < ids.len {
            out.append(self.conformFuncIdAt(ids: ids, index: i))
            i += 1U64
        }
        return out
    }

    // Append a statement node, returning its arena index.
    inout fn pushStmt(s: Stmt) -> U64 {
        val id: U64 = self.arena.stmts.count()
        self.arena.stmts.append(s)
        return id
    }
    // Store a block's child statements in Arena's single immutable pool. A block is
    // a slice, not an owning Array, so copying the block during every frontend walk
    // cannot create ARC traffic for its children.
    inout fn pushBlock(stmts: Array[U64]) -> U64 {
        val start: U64 = self.arena.blockStmtPool.count()
        mut val i: U64 = 0U64
        while i < stmts.count() {
            self.arena.blockStmtPool.append(stmts[i])
            i += 1U64
        }
        val id: U64 = self.arena.blocks.count()
        self.arena.blocks.append(<Block stmtStart=start stmtLen=stmts.count() />)
        return id
    }

    inout fn blockStmtCount(blkId: U64) -> U64 {
        if blkId >= self.arena.blocks.count() { return 0U64 }
        return self.arena.blocks[blkId].stmtLen
    }

    inout fn blockStmtAt(blkId: U64, index: U64) -> U64 {
        if blkId >= self.arena.blocks.count() { return 0U64 }
        val block: Block = self.arena.blocks[blkId]
        if index >= block.stmtLen { return 0U64 }
        return self.arena.blockStmtPool[block.stmtStart + index]
    }

    // Append a structured type reference, returning its Comp.arena.types index. This is
    // the single interning choke point for type names (Phase D): the head name span
    // is interned here so every TypeRef carries its `nameId`, regardless of which
    // construction site (lowerType / Mono substitution / Self synthesis) built it.
    inout fn pushType(t: TypeRef) -> U64 {
        val id: U64 = self.arena.types.count()
        val nid: U64 = intern(c: inout self, start: t.nameStart, len: t.nameLen)
        self.arena.types.append(<TypeRef nameStart=t.nameStart nameLen=t.nameLen nameId=nid paramId=t.paramId args=t.args isRecord=t.isRecord recordFieldLabels=t.recordFieldLabels recordFieldTerms=t.recordFieldTerms viewExtId=t.viewExtId viewIds=t.viewIds viewSources=t.viewSources isAny=t.isAny argLabels=t.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=t.assocTraitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=t.isSendable hasDecl=t.hasDecl declOffset=t.declOffset hasAssocTraitDecl=t.hasAssocTraitDecl assocTraitDeclOffset=t.assocTraitDeclOffset siteOffset=t.siteOffset />)
        return id
    }

    // Rebuild one semantic type term with an explicitly selected view surface.
    // A view refines the receiver; it must never replace its nominal/projection
    // head, declaration identity, arguments, or existential qualifiers.  This
    // is the flat-TypeRef migration bridge for the eventual TypeTerm `view`
    // node, and keeps the full copy in one place so Mono and LLVM cannot each
    // accidentally turn `S#E` into the trait named by E's conformance subject.
    inout fn semanticViewSourceEq(a: ResolvedViewSource, b: ResolvedViewSource) -> Bool {
        if a.traitOwner != 0U64 || b.traitOwner != 0U64 {
            return a.traitOwner != 0U64 && a.traitOwner == b.traitOwner
        }
        return a.surfaceId == b.surfaceId
    }

    inout fn typeRefViewSources(ref: U64) -> Array[ResolvedViewSource] {
        mut val out: Array[ResolvedViewSource] = []
        if ref == 0U64 || ref >= self.arena.types.count() { return out }
        val t: TypeRef = self.arena.types[ref]
        out = t.viewSources
        if out.count() != 0U64 { return out }
        mut val ids: Array[U64] = t.viewIds
        if ids.count() == 0U64 && t.viewExtId != 0U64 { ids.append(t.viewExtId) }
        mut val i: U64 = 0U64
        while i < ids.count() {
            out.append(<ResolvedViewSource surfaceId=ids[i] />)
            i += 1U64
        }
        return out
    }

    inout fn sameSemanticViewSourceSet(a: Array[ResolvedViewSource], b: Array[ResolvedViewSource]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            mut val found: Bool = false
            mut val j: U64 = 0U64
            while j < b.count() {
                if self.semanticViewSourceEq(a: a[i], b: b[j]) { found = true }
                j += 1U64
            }
            if !found { return false }
            i += 1U64
        }
        return true
    }

    inout fn viewSourceIds(sources: Array[ResolvedViewSource]) -> Array[U64] {
        mut val ids: Array[U64] = []
        mut val i: U64 = 0U64
        while i < sources.count() {
            mut val present: Bool = false
            mut val j: U64 = 0U64
            while j < ids.count() {
                if ids[j] == sources[i].surfaceId { present = true }
                j += 1U64
            }
            if !present && sources[i].surfaceId != 0U64 { ids.append(sources[i].surfaceId) }
            i += 1U64
        }
        return ids
    }

    inout fn typeRefWithViewSources(ref: U64, sources: Array[ResolvedViewSource]) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val base: TypeRef = self.arena.types[ref]
        val ids: Array[U64] = self.viewSourceIds(sources: sources)
        mut val mirror: U64 = 0U64
        if ids.count() == 1U64 { mirror = ids[0] }
        // This is a derived type term for an expression/generic substitution,
        // not a second authored type annotation.  Structural source-set checks
        // run at the authored syntax node (or the outermost value-view), so an
        // intermediate `T#E#F` erased later by `#!F` must not be rechecked.
        return self.pushType(t: <TypeRef nameStart=base.nameStart nameLen=base.nameLen nameId=base.nameId paramId=base.paramId args=base.args isRecord=base.isRecord recordFieldLabels=base.recordFieldLabels recordFieldTerms=base.recordFieldTerms viewExtId=mirror viewIds=ids viewSources=sources isAny=base.isAny argLabels=base.argLabels assocTraitStart=base.assocTraitStart assocTraitLen=base.assocTraitLen assocTraitId=base.assocTraitId assocTraitArgs=base.assocTraitArgs assocTraitArgLabels=base.assocTraitArgLabels assocNameStart=base.assocNameStart assocNameLen=base.assocNameLen assocNameId=base.assocNameId isSendable=base.isSendable hasDecl=base.hasDecl declOffset=base.declOffset hasAssocTraitDecl=base.hasAssocTraitDecl assocTraitDeclOffset=base.assocTraitDeclOffset siteOffset=0U64 />)
    }

    // A view augments the outer receiver surface without invalidating a bound
    // already proved for that receiver: `T: B` remains usable for `T#E`.
    // This is deliberately not a recursive erasure: views inside type
    // arguments remain part of those arguments' semantic identity.
    inout fn typeRefWithoutOuterViews(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val base: TypeRef = self.arena.types[ref]
        if base.viewExtId == 0U64 && base.viewIds.count() == 0U64 && base.viewSources.count() == 0U64 { return ref }
        return self.pushType(t: <TypeRef nameStart=base.nameStart nameLen=base.nameLen nameId=base.nameId paramId=base.paramId args=base.args isRecord=base.isRecord recordFieldLabels=base.recordFieldLabels recordFieldTerms=base.recordFieldTerms isAny=base.isAny argLabels=base.argLabels assocTraitStart=base.assocTraitStart assocTraitLen=base.assocTraitLen assocTraitId=base.assocTraitId assocTraitArgs=base.assocTraitArgs assocTraitArgLabels=base.assocTraitArgLabels assocNameStart=base.assocNameStart assocNameLen=base.assocNameLen assocNameId=base.assocNameId isSendable=base.isSendable hasDecl=base.hasDecl declOffset=base.declOffset hasAssocTraitDecl=base.hasAssocTraitDecl assocTraitDeclOffset=base.assocTraitDeclOffset siteOffset=base.siteOffset />)
    }

    inout fn typeRefWithViews(ref: U64, viewExtId: U64, viewIds: Array[U64]) -> U64 {
        mut val sources: Array[ResolvedViewSource] = []
        mut val i: U64 = 0U64
        while i < viewIds.count() {
            sources.append(<ResolvedViewSource surfaceId=viewIds[i] />)
            i += 1U64
        }
        if sources.count() == 0U64 && viewExtId != 0U64 {
            sources.append(<ResolvedViewSource surfaceId=viewExtId />)
        }
        return self.typeRefWithViewSources(ref: ref, sources: sources)
    }

    // Apply source-set additions to an existing term.  `#` is additive and
    // extension order is semantically irrelevant, so generic substitution of
    // `T#E` must retain both the actual argument's views and E (rather than
    // returning the raw argument and silently losing E).
    inout fn typeRefWithAddedViews(ref: U64, additions: Array[U64]) -> U64 {
        mut val sources: Array[ResolvedViewSource] = []
        mut val i: U64 = 0U64
        while i < additions.count() {
            sources.append(<ResolvedViewSource surfaceId=additions[i] />)
            i += 1U64
        }
        return self.typeRefWithAddedViewSources(ref: ref, additions: sources)
    }

    // Semantic callers must append the full selector, not only its spelling:
    // two imported traits can spell alike while selecting different owners.
    inout fn typeRefWithAddedViewSources(ref: U64, additions: Array[ResolvedViewSource]) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        mut val views: Array[ResolvedViewSource] = self.typeRefViewSources(ref: ref)
        mut val i: U64 = 0U64
        while i < additions.count() {
            mut val present: Bool = false
            mut val j: U64 = 0U64
            while j < views.count() {
                if self.semanticViewSourceEq(a: views[j], b: additions[i]) { present = true }
                j += 1U64
            }
            if !present { views.append(additions[i]) }
            i += 1U64
        }
        return self.typeRefWithViewSources(ref: ref, sources: views)
    }

    // Directional semantic matching for a positional type-term list.  The
    // left-hand declaration pattern may bind only its own lexical binders;
    // the actual terms on the right remain rigid.  This is the common law for
    // `impl[Element] B[Element]`, extension receiver applicability, and
    // trait-subject proof edges -- alpha equality would incorrectly reject
    // the ordinary instance B[I64].
    inout fn typeRefListPatternMatches(pattern: Array[U64], patternParams: Array[Bind], actual: Array[U64]) -> Bool {
        if pattern.count() != actual.count() { return false }
        mut val binds: Array[UnifyBind] = []
        mut val i: U64 = 0U64
        while i < pattern.count() {
            if !(self.unifyPatterns(a: pattern[i], aSide: 0U64, b: actual[i], bSide: 1U64, aParams: patternParams, bParams: [], binds: inout binds)) {
                return false
            }
            i += 1U64
        }
        return true
    }

    inout fn recordImportOrigins(imp: ImportAst, targetMod: U64, reExport: Bool) {
        mut val i: U64 = 0
        while i < imp.names.count() {
            val real: Span = imp.nameSpans[i]
            mut val local: Span = real
            if i < imp.nameAliasSpans.count() {
                val alias: Span = imp.nameAliasSpans[i]
                if alias.end > alias.start { local = alias }
            }
            val entry: Bind = <Bind nameStart=local.start nameLen=local.end - local.start nameId=real.end - real.start fieldStart=real.start fieldLen=targetMod />
            if reExport { self.modules.reExportOrigins.append(entry) }
            else { self.modules.importOrigins.append(entry) }
            i += 1
        }
    }

    // SyntaxFile counterpart used by the ID-based loader.  Import names are
    // read as source spans directly from the immutable syntax store; this must
    // remain separate from the legacy value-AST method until lowering itself is
    // migrated, rather than materializing an ImportAst adapter.
    inout fn recordSyntaxImportOrigins(imp: SyntaxImport, targetMod: U64, reExport: Bool) {
        mut val i: U64 = 0U64
        while i < syntaxImportNameCount(file: self.syntax, imp: imp) {
            val real: Span = syntaxImportNameSpan(file: self.syntax, imp: imp, index: i)
            mut val local: Span = real
            val alias: Span = syntaxImportNameAliasSpan(file: self.syntax, imp: imp, index: i)
            if alias.end > alias.start { local = alias }
            val entry: Bind = <Bind nameStart=local.start nameLen=local.end - local.start nameId=real.end - real.start fieldStart=real.start fieldLen=targetMod />
            if reExport { self.modules.reExportOrigins.append(entry) }
            else { self.modules.importOrigins.append(entry) }
            i += 1U64
        }
    }
}

// ── name interner (Phase C) ──────────────────────────────────────────────────
// The interner lives with the IR core: `Comp.pushType` interns every type head,
// so the service must be reachable from inside this module (a back-edge to a pass
// would be a cycle). `intern`/`spansEqual` are used pervasively by every pass and
// are exported; `internHash`/`internGrow` are interner-internal.

// Compare two name spans for byte equality against the shared source buffer.
export fn spansEqual(c: inout Comp, aStart: U64, aLen: U64, bStart: U64, bLen: U64) -> Bool {
    // Every interner key is a slice of the shared source buffer.  Keep this
    // boundary total: a malformed stored span used to turn the byte loop below
    // into an effectively unbounded read, which presented as a compiler hang.
    // This is an internal invariant, not a source-program diagnostic.
    val byteCount: U64 = c.arena.bytes.count()
    if aStart > byteCount || aLen > byteCount - aStart || bStart > byteCount || bLen > byteCount - bStart {
        panic "compiler bug: interner stored a span outside the source buffer"
    }
    if aLen != bLen {
        return false
    }
    mut val j: U64 = 0
    while j < aLen {
        if c.arena.bytes[aStart + j] != c.arena.bytes[bStart + j] {
            return false
        }
        j += 1
    }
    return true
}

// FNV-1a hash of a name span (used to place spans into the bucket index).
fn internHash(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val h: U64 = 14695981039346656037U64
    mut val j: U64 = 0
    while j < len {
        h = h ^ (c.arena.bytes[start + j] as U64)
        h = U64.wrappingMul(h, 1099511628211U64)
        j += 1
    }
    return h
}

// Grow the bucket index (double, or 8 from empty), re-placing every interned span
// by re-hashing. The dense interner.entries array is untouched (ids stay
// stable). Capacity is a power of two so the slot index is a bitmask (& cap-1).
fn internGrow(c: inout Comp) {
    mut val newCap: U64 = 8
    if c.interner.buckets.count() > 0 {
        newCap = c.interner.buckets.count() * 2
    }
    mut val nb: Array[U64] = []
    mut val k: U64 = 0
    while k < newCap {
        nb.append(0)
        k += 1
    }
    mut val i: U64 = 0
    while i < c.interner.entries.count() {
        val entry: InternedSpan = c.interner.entries[i]
        val code: U64 = internHash(c: inout c, start: entry.start, len: entry.len)
        mut val slot: U64 = code & (newCap - 1)
        while nb[slot] != 0 {
            slot = (slot + 1) & (newCap - 1)
        }
        nb.set(i: slot, value: i + 1)
        i += 1
    }
    c.interner.buckets = nb
}

// Intern a name span to its stable 1-based id (equal content ⇒ equal id; 0 is
// never returned, so a `nameId` field's default 0 is a pure "unfilled" sentinel).
export fn intern(c: inout Comp, start: U64, len: U64) -> U64 {
    if c.interner.buckets.count() == 0 {
        internGrow(c: inout c)
    } else {
        if (c.interner.entries.count() + 1) * 4 > c.interner.buckets.count() * 3 {
            internGrow(c: inout c)
        }
    }
    val code: U64 = internHash(c: inout c, start: start, len: len)
    val cap: U64 = c.interner.buckets.count()
    mut val slot: U64 = code & (cap - 1)
    while true {
        val b: U64 = c.interner.buckets[slot]
        if b == 0 {
            c.interner.entries.append(<InternedSpan start=start len=len />)
            val id: U64 = c.interner.entries.count()
            c.interner.buckets.set(i: slot, value: id)
            return id
        }
        val entry: InternedSpan = c.interner.entries[b - 1]
        if spansEqual(c: inout c, aStart: entry.start, aLen: entry.len, bStart: start, bLen: len) {
            return b
        }
        slot = (slot + 1) & (cap - 1)
    }
}

// Intrinsic-name predicates for the array storage floor (spec/15 core-library
// boundary): the `extern(plewIntrinsic)` ops Core's Array/Buffer methods call.
// `pub` so the (still free-function) type-recovery callers can reach them during the
// methodization transition.

part ./Parser/Decl
part ./Codegen/Arc
part ./Codegen/Emit
part ./Codegen/Resolve
part ./Codegen/Ops
part ./Codegen/Check
part ./Codegen/Expr
part ./Codegen/Stmt
part ./Codegen/Decl
part ./Codegen/Mono
part ./Codegen/Gen
part ./Codegen/Verify
part ./Codegen/Infer
part ./Codegen/Lower
part ./Loader

// ---- relocated free helpers (were in parts; kept at module root so parts are impl-only) ----

fn u64ArrayHas(a: Array[U64], v: U64) -> Bool {
    mut val i: U64 = 0
    while i < a.count() {
        if a[i] == v {
            return true
        }
        i += 1
    }
    return false
}

fn notConst() -> ConstInt {
    return <ConstInt isConst=false neg=false value=0 />
}

// Build a ConstInt, normalizing -0 to +0.
fn mkConst(neg: Bool, mag: U64) -> ConstInt {
    if mag == 0 { return <ConstInt isConst=true neg=false value=0 /> }
    return <ConstInt isConst=true neg=neg value=mag />
}

// (na,a) + (nb,b) as a signed magnitude, or notConst if the result magnitude
// would exceed the fold domain (2^63-1; keeps every magnitude expressible).
fn addConst(na: Bool, a: U64, nb: Bool, b: U64) -> ConstInt {
    if na == nb {
        if a > 9223372036854775807U64 - b { return notConst() }
        return mkConst(neg: na, mag: a + b)
    }
    if a >= b { return mkConst(neg: na, mag: a - b) }
    return mkConst(neg: nb, mag: b - a)
}

// Encode a float context as a SemanticExprType literal-context code (9 = F64, 10 = F32) so the backend
// emits an otherwise-untyped integer literal as a double constant in float context.
fn floatCtxCode(bits: U64) -> U64 {
    if bits == 32 { return 10 }
    return 9
}

// Encode a known int context (bits, sgn) as a code 1..8 (I8/I16/I32/I64/U8/U16/U32/U64).
fn intCtxCode(bits: U64, sgn: Bool) -> U64 {
    if sgn {
        if bits == 8 { return 1 }
        if bits == 16 { return 2 }
        if bits == 32 { return 3 }
        return 4
    }
    if bits == 8 { return 5 }
    if bits == 16 { return 6 }
    if bits == 32 { return 7 }
    return 8
}

// Range-check each struct field's default-value literal against the field's
// declared type (spec/05: `val x: T = expr` is memberwise-factory default-arg
// sugar, so the default must fit T exactly as an explicit construction would —
// `val n: I8 = 300` is rejected here, not silently truncated at codegen). Enum
// variant fields take no default, so only struct fields are visited.
// Whether interned id `id` is in `set`.
fn idInSet(set: Array[U64], id: U64) -> Bool {
    mut val i: U64 = 0
    while i < set.count() {
        if set[i] == id {
            return true
        }
        i += 1
    }
    return false
}

// Sentinel for "no defining module found" (a value no real module id takes).
fn importCycleSentinel() -> U64 { return 4000000000U64 }

// Shared pipeline observation boundary. Backend imports this through the
// existing Frontend dependency rather than duplicating the CLI flag or
// inventing an unstructured debug print. Labels are stable phase identities;
// they are not source-level diagnostics and do not affect generated LLVM.
export fn tracePhase(c: inout Comp, label: String) {
    if c.tracePhases {
        eprint(text: "[trace-phase] ")
        eprint(text: label)
        eprint(text: "\n")
    }
}

fn traceU64(n: U64) {
    if n >= 10U64 {
        traceU64(n: n / 10U64)
    }
    eprint(text: digitStrU(d: n % 10U64))
}

export fn tracePhaseCount(c: inout Comp, label: String, count: U64) {
    if c.tracePhases {
        eprint(text: "[trace-phase] ")
        eprint(text: label)
        eprint(text: "=")
        traceU64(n: count)
        eprint(text: "\n")
    }
}

// Record the one parametric semantic type/provenance table before any Mono
// consumer. Keeping this as an explicit phase makes the hand-off into
// CallTemplate finalization a real `Comp` boundary, rather than an incidental
// region inside the frontend driver.
fn recordSemanticExpressionTypes(c: inout Comp) {
    mut val i: U64 = 0U64
    while i < c.arena.exprs.count() {
        c.arena.semanticExprTypes.append(<SemanticExprType />)
        i += 1U64
    }
    tracePhase(c: inout c, label: "semantic-expression-record:start")
    c.traceExprInstScans = 0U64
    c.recordParametricTypes()
    tracePhaseCount(c: inout c, label: "semantic-expression-record:scan-exprs", count: c.traceExprInstScans)
    tracePhase(c: inout c, label: "semantic-expression-record:done")
}

// Fill the caller-owned compiler state through parsing, lowering, verification,
// monomorphization, and final-callable closure.  The state is intentionally not
// returned by value: `CallResolution` is semantic analysis output consumed by LLVM,
// so it must retain one owner across the frontend/backend boundary.
export fn runFrontend(c: inout Comp) {
    // gen mode (spec/16): `plewc --gen <file>` synthesizes a derive-runner harness
    // instead of compiling the user program. The entry path then sits at argv[2].
    mut val genMode: Bool = false
    mut val tcLog: Bool = false
    mut val asan: Bool = false
    mut val traceCodegen: Bool = false
    mut val tracePhases: Bool = false
    mut val emitMidCoverage: Bool = false
    mut val requireMid: Bool = false
    mut val entryArgIdx: I64 = 1
    if argCount() > 1 {
        if argAt(1) == "--gen" {
            genMode = true
            entryArgIdx = 2
        }
        // `plewc --tc-log <file>`: run the new TypeRef-based type checker in
        // log-only mode (print mismatches, reject nothing) for development/triage.
        if argAt(1) == "--tc-log" {
            tcLog = true
            entryArgIdx = 2
        }
        // `plewc --asan <file>`: emit a module that a downstream `opt -passes=asan`
        // can actually instrument (host target triple + `sanitize_address` on every
        // defined function). See Comp.asan and Backend emitLlvm.
        if argAt(1) == "--asan" {
            asan = true
            entryArgIdx = 2
        }
        if argAt(1) == "--trace-codegen" {
            traceCodegen = true
            entryArgIdx = 2
        }
        if argAt(1) == "--trace-phases" {
            tracePhases = true
            entryArgIdx = 2
        }
        if argAt(1) == "--emit-mid-coverage" {
            emitMidCoverage = true
            entryArgIdx = 2
        }
        if argAt(1) == "--require-mid" {
            requireMid = true
            entryArgIdx = 2
        }
    }
    // The caller creates the compiler arena. The loader below fills `bytes`/`moduleRanges` and lowers
    // every item into it: PARSE-DRIVEN LOADING — each file's source is appended to
    // `c.arena.bytes`, parsed by the shared @Plew/Syntax parser, its items retained, and its
    // `import`/`part` nodes followed to more files. There is no separate directive
    // pre-scan: the parsed tree drives discovery. Lowering waits until every file and import
    // origin is known, so a source occurrence resolves one declaration identity everywhere.
    // reserve TypeRef index 0 as the "no type" sentinel so a `ty` field of 0
    // (synthetic locals, untyped positions) never aliases a real parsed type.
    c.arena.types.append(<TypeRef nameStart=0 nameLen=0 args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    // reserve Block index 0 as a dummy so a `body` field of 0 is an unambiguous
    // "no body" sentinel (extern fns, trait-requirement signatures). Without this,
    // the first function body lowered (the entry file, which loads before the
    // ambient Prelude) would land at block 0 and be indistinguishable from no body
    // — wrongly skipped by the body-walks that gate on `body != 0`.
    c.pushBlock(stmts: [])
    c.genMode = genMode
    c.tcLog = tcLog
    c.asan = asan
    c.traceCodegen = traceCodegen
    c.tracePhases = tracePhases
    c.emitMidCoverage = emitMidCoverage
    c.requireMid = requireMid
    tracePhase(c: inout c, label: "load:start")
    mut val pendingItems: Array[TopItemAst] = []
    mut val nextModuleId: U64 = 1
    if argCount() > entryArgIdx {
        // Module loader: a recursive, deduplicated worklist over local includes.
        // Each file's `part`/`import` paths resolve relative to that file's own
        // directory; every distinct file is appended once (single-arena / single-C).
        val rootPath: String = argAt(entryArgIdx)
        val entryBytes: Array[U8] = rootPath.bytes()
        // Loud-fail on a missing entry file: without this readFileBytes returns an
        // empty string and the compiler silently emits an empty program (exit 0),
        // which hides a typo'd path. (Acceptance soundness: never silently accept.)
        if !(fileExists(path: entryBytes)) {
            eprint(text: "plewc: error: cannot open source file: ")
            eprint(text: rootPath)
            eprint(text: "\n")
            exit(code: 1)
        }
        mut val pathBuf: Array[U8] = []
        mut val loaded: Array[Bind] = []
        // `loaded[i].fieldStart` carries each queued file's module id.
        // `/…` absolute imports and `@dep` imports resolve PER PACKAGE: each loaded
        // file walks up to its own Plew.toml (findPkgDir/findSrcRoot) and parses its
        // own `[dependencies]` (loadManifestDeps), computed inside the loop below. So
        // a dependency package resolves its own `/…` and `@dep` against its manifest,
        // not the entry's — the right foundation for transitive resolution.
        // std library root for `@Std/…`: the `std/` directory next to the plewc
        // binary (argv[0]'s directory), so `@Std/Core` -> `<plewcdir>/std/Core.pw`.
        val stdRoot: Array[U8] = computeStdRoot(arg0: argAt(0).bytes())
        // the global package cache root (for git `@dep` source lookup via the lock),
        // resolved once for the whole build.
        val cacheRootBytes: Array[U8] = cacheRoot()
        // the ENTRY package's lock governs the whole dependency graph (spec/17: the
        // lock binds only at the top-level build target). Every git `@dep` — even one
        // imported deep inside a dependency — resolves its commit from THIS lock; the
        // dependency's own manifest only supplies the git URL + phantom check.
        val entryLock: Lock = loadLock(pkgDir: findPkgDir(entry: entryBytes))
        val es: U64 = pathBuf.count()
        appendBytes(into: inout pathBuf, from: entryBytes)
        loaded.append(<Bind nameStart=es nameLen=entryBytes.count() fieldStart=0 fieldLen=entryBytes.count() />)
        // Force-load @Std/Lang FIRST: it is THE ambient module (spec/15) — it declares the
        // language's built-in types (the lang items), in scope everywhere without an import.
        // Loaded before Core/Hash/Prelude so the foundational types resolve for them. Its
        // module id is captured (`langModule`) so type visibility can treat a type defined
        // here as ambient. Guarded by fileExists (a freshly-seeded compiler may lack it).
        mut val langPath: Array[U8] = []
        appendBytes(into: inout langPath, from: stdRoot)
        appendBytes(into: inout langPath, from: "Lang.pw".bytes())
        if fileExists(path: langPath) {
            val lps: U64 = pathBuf.count()
            appendBytes(into: inout pathBuf, from: langPath)
            loaded.append(<Bind nameStart=lps nameLen=langPath.count() fieldStart=nextModuleId fieldLen=langPath.count() />)
            c.modules.langModule = nextModuleId
            nextModuleId = nextModuleId + 1
        }
        // Force-load @Std/Core so its lang-item types (Optional/Result/Ordering),
        // operator traits + witnesses, and Iterator/Index machinery are AMBIENT
        // (spec/15: usable without `import` — `2 + 3`, `Optional`, `for` need none).
        // Its `part Core/Num.pw` + imports are followed by the BFS; a target that also
        // `import @Std/Core`s dedups via pathSeen. A Core free function like `assert`
        // still needs an explicit import — checkUseVisibility gates it as an ordinary
        // cross-module call (only types/operators are ambient, not free functions).
        mut val corePath: Array[U8] = []
        appendBytes(into: inout corePath, from: stdRoot)
        appendBytes(into: inout corePath, from: "Core.pw".bytes())
        if fileExists(path: corePath) {
            val cps: U64 = pathBuf.count()
            appendBytes(into: inout pathBuf, from: corePath)
            loaded.append(<Bind nameStart=cps nameLen=corePath.count() fieldStart=nextModuleId fieldLen=corePath.count() />)
            c.modules.coreModule = nextModuleId
            nextModuleId = nextModuleId + 1
        }
        // Force-load @Std/Hash: the implicit prelude's `Dictionary` lang item is built on
        // hashing (the `[k:v]` literal's `K: Hash` machinery + `SipHasher`), so the hashing
        // floor must always be LOADED even when the target never imports it. Force-load is
        // loading only — `Hash`/`Hasher`/`SipHasher` are NOT ambient (spec/15: not lang
        // items), so naming them in a type position still needs `import @Std/Hash`. The
        // prelude itself imports it; a target that also imports it dedups via pathSeen.
        mut val hashPath: Array[U8] = []
        appendBytes(into: inout hashPath, from: stdRoot)
        appendBytes(into: inout hashPath, from: "Hash.pw".bytes())
        if fileExists(path: hashPath) {
            val hps: U64 = pathBuf.count()
            appendBytes(into: inout pathBuf, from: hashPath)
            loaded.append(<Bind nameStart=hps nameLen=hashPath.count() fieldStart=nextModuleId fieldLen=hashPath.count() />)
            nextModuleId = nextModuleId + 1
        }
        // Remember the bundled Io path. It is not force-loaded: the loader
        // records its module identity if and when an ordinary import reaches it.
        mut val ioPath: Array[U8] = []
        appendBytes(into: inout ioPath, from: stdRoot)
        appendBytes(into: inout ioPath, from: "Io.pw".bytes())
        mut val processPath: Array[U8] = []
        appendBytes(into: inout processPath, from: stdRoot)
        appendBytes(into: inout processPath, from: "Process.pw".bytes())
        if genMode {
            // The synthesized derive-runner calls `write` even when the target file
            // does not import @Std/Io itself.  Load the real bundled declaration in
            // this mode only; normal builds retain ordinary import-driven loading.
            // The BFS records its module id below, so this is still the same
            // declaration-identity path as a source import.
            if fileExists(path: ioPath) {
                val iops: U64 = pathBuf.count()
                appendBytes(into: inout pathBuf, from: ioPath)
                loaded.append(<Bind nameStart=iops nameLen=ioPath.count() fieldStart=nextModuleId fieldLen=ioPath.count() />)
                nextModuleId = nextModuleId + 1
            }
            // force-load @Plew/Syntax too: the harness calls `parseItem` and the derive
            // interfaces / built-in derivers (`impl Hash as Derive`) live there. Resolve
            // it through the gen target's OWN manifest (a path or git dependency), exactly
            // like a normal `@dep` import, so the macro's pinned Syntax version is the one
            // loaded. Its `part`s + `import @Std/Core` are followed by the BFS below; a
            // target file that also imports it dedups via pathSeen.
            val synName: Array[U8] = "@Plew/Syntax".bytes()
            val genPkgDir: Array[U8] = findPkgDir(entry: entryBytes)
            val genDeps: Array[Dep] = loadManifestDeps(pkgDir: genPkgDir)
            mut val synPath: Array[U8] = resolveDepImport(src: synName, pStart: 0, pLen: synName.count(), deps: genDeps, pkgDir: genPkgDir)
            if synPath.count() == 0 {
                synPath = resolveGitDepImport(src: synName, pStart: 0, pLen: synName.count(), deps: genDeps, cacheRoot: cacheRootBytes, lock: entryLock)
            }
            if synPath.count() != 0 {
                if fileExists(path: synPath) {
                    if !(pathSeen(buf: pathBuf, loaded: loaded, path: synPath)) {
                        val sys: U64 = pathBuf.count()
                        appendBytes(into: inout pathBuf, from: synPath)
                        loaded.append(<Bind nameStart=sys nameLen=synPath.count() fieldStart=nextModuleId fieldLen=synPath.count() />)
                        nextModuleId = nextModuleId + 1
                    }
                }
            }
        }
        // module ids whose ROOT file has been processed. A module's root is loaded
        // before any of its parts (parts are discovered while processing the root), so
        // the FIRST file seen for a module id is its root and every later file with the
        // same id is a `part` — used to enforce the spec/15 "part = impl only" rule.
        mut val rootSeen: Array[U64] = []
        mut val qi: U64 = 0
        while qi < loaded.count() {
            val ent: Bind = loaded[qi]
            qi += 1
            val moduleId: U64 = ent.fieldStart
            val path: Array[U8] = extractSpan(buf: pathBuf, start: ent.nameStart, len: ent.nameLen)
            if path.count() == ioPath.count() {
                mut val pathMatchesIo: Bool = true
                mut val pathIndex: U64 = 0U64
                while pathIndex < path.count() {
                    if path[pathIndex] != ioPath[pathIndex] {
                        pathMatchesIo = false
                    }
                    pathIndex += 1U64
                }
                if pathMatchesIo {
                    c.modules.ioModule = moduleId
                }
            }
            if path.count() == processPath.count() {
                mut val pathMatchesProcess: Bool = true
                mut val pathIndex: U64 = 0U64
                while pathIndex < path.count() {
                    if path[pathIndex] != processPath[pathIndex] {
                        pathMatchesProcess = false
                    }
                    pathIndex += 1U64
                }
                if pathMatchesProcess {
                    c.modules.processModule = moduleId
                }
            }
            mut val hasPkgRoot: Bool = false
            mut val pri: U64 = 0
            while pri < c.modules.packageRoots.count() {
                if c.modules.packageRoots[pri].nameStart == moduleId {
                    hasPkgRoot = true
                }
                pri += 1
            }
            if !(hasPkgRoot) {
                mut val pkgRootModule: U64 = moduleId
                val pkgRootPath: Array[U8] = packageRootPath(entry: path, stdRoot: stdRoot)
                if pkgRootPath.count() != 0 {
                    val foundRoot: U64 = moduleIdOfPath(buf: pathBuf, loaded: loaded, path: pkgRootPath)
                    if foundRoot != 4000000000U64 {
                        pkgRootModule = foundRoot
                    }
                }
                c.modules.packageRoots.append(<Bind nameStart=moduleId nameLen=0 fieldStart=pkgRootModule fieldLen=0 />)
            }
            val src: String = readFileBytes(path)
            val sb: Array[U8] = src.bytes()
            if c.arena.bytes.count() > 0 {
                c.arena.bytes.append(10)
            }
            val fileStart: U64 = c.arena.bytes.count()
            c.appendSrc(from: sb)
            c.modules.ranges.append(<Bind nameStart=fileStart nameLen=c.arena.bytes.count() - fileStart fieldStart=moduleId fieldLen=0 />)
            c.modules.rangePaths.append(stringFromBytesUnchecked(path))
            // Parse now to discover edges; lower all retained items only after the complete
            // graph (and therefore all import aliases and declarations) exists.
            val items: Array[TopItemAst] = c.parseFile(fileBytes: sb, fileStart: fileStart)
            mut val pendingIndex: U64 = 0U64
            while pendingIndex < items.count() {
                pendingItems.append(items[pendingIndex])
                pendingIndex += 1U64
            }
            // spec/15: a `part` file (a non-root file of an already-seen module) may
            // contain only `impl` blocks — reject any free fn / type / extern / val.
            if u64ArrayHas(a: rootSeen, v: moduleId) {
                c.checkPartImplOnly(items: items)
            } else {
                rootSeen.append(moduleId)
            }
            val baseLen: U64 = dirPrefixLen(path: path)
            // per-package resolution context for THIS file's imports: its own package
            // dir / src root (`/…` imports) and its own declared dependencies (`@dep`
            // imports). A dependency package thus resolves against its own manifest.
            val fPkgDir: Array[U8] = findPkgDir(entry: path)
            val fSrcRoot: Array[U8] = findSrcRoot(entry: path)
            val fDeps: Array[Dep] = loadManifestDeps(pkgDir: fPkgDir)
            // follow `import`/`part` nodes to child files (in source order); note a
            // `@[...]` directive so the generated sibling can be auto-parted.
            mut val sawDirective: Bool = false
            mut val ii: U64 = 0
            while ii < items.count() {
                match items[ii] {
                    TopItemAst.Import(val imp) => {
                        mut val childPath: Array[U8] = resolveImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, importer: path, baseLen: baseLen, srcRoot: fSrcRoot, srcRootLen: fSrcRoot.count(), stdRoot: stdRoot, stdRootLen: stdRoot.count())
                        // a non-`@Std` `@dep` import is unresolved by @Path (returns
                        // empty); resolve it against this package's [dependencies] —
                        // path deps directly, git deps via the lock's pinned commit in
                        // the global cache.
                        if childPath.count() == 0 {
                            childPath = resolveDepImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, deps: fDeps, pkgDir: fPkgDir)
                        }
                        if childPath.count() == 0 {
                            childPath = resolveGitDepImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, deps: fDeps, cacheRoot: cacheRootBytes, lock: entryLock)
                        }
                        // phantom-dependency rule (spec/17): an external `@<name>` import
                        // that no declared dependency backs is a loud error (provenance:
                        // you may only import what the manifest declares + `@Std`).
                        if childPath.count() == 0 {
                            if isExternalDepImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start) {
                                c.errorAt(offset: imp.pathSpan.start, msg: "this `@<package>` import names no declared dependency — add it to `[dependencies]` in Plew.toml (spec/17: no phantom dependencies; only declared deps and `@Std` are importable)")
                            }
                        }
                        if childPath.count() != 0 {
                            val seen: Bool = pathSeen(buf: pathBuf, loaded: loaded, path: childPath)
                            // a `part` link must reach a NOT-yet-loaded file: a file is
                            // parted by exactly one parent (spec/15). If its target is
                            // already in the module graph — parted by another file (a
                            // diamond, same module or across modules) or already loaded as
                            // an imported module root — that is an error. (`import` dedups
                            // instead: importing the same module from many places is fine.)
                            if !(imp.isImport) {
                                if seen {
                                    c.errorAt(offset: imp.pathSpan.start, msg: "this file is already in the module graph — a file can be `part`ed by at most one parent (spec/15: no duplicate/diamond `part`, and a `part` file is not independently importable)")
                                }
                            }
                            if !seen {
                                // a resolved path that names no file on disk = a typo'd
                                // import/part path — reject loudly (acceptance soundness:
                                // never silently load nothing).
                                if !(fileExists(path: childPath)) {
                                    c.errorAt(offset: imp.pathSpan.start, msg: "cannot open module file: the import/part path does not resolve to an existing file")
                                }
                                // a `part` (isImport=false) joins this module; an
                                // `import` (true) starts a fresh module.
                                mut val childModule: U64 = moduleId
                                if imp.isImport {
                                    childModule = nextModuleId
                                    nextModuleId = nextModuleId + 1
                                }
                                val cs: U64 = pathBuf.count()
                                appendBytes(into: inout pathBuf, from: childPath)
                                loaded.append(<Bind nameStart=cs nameLen=childPath.count() fieldStart=childModule fieldLen=childPath.count() />)
                            }
                            // record the import edge (this module -> the module the path
                            // resolved to), whether the target is newly loaded or deduped,
                            // so name resolution can prefer a directly-imported module when
                            // a name is shared by coexisting package versions.
                            if imp.isImport {
                                val tgt: U64 = moduleIdOfPath(buf: pathBuf, loaded: loaded, path: childPath)
                                if tgt != 4000000000U64 {
                                    c.modules.importEdges.append(<Bind nameStart=0 nameLen=0 fieldStart=moduleId fieldLen=tgt />)
                                    c.recordImportOrigins(imp: imp, targetMod: tgt, reExport: false)
                                }
                            }
                        }
                    }
                    TopItemAst.ReExport(val imp) => {
                        // a re-export (`export <path> with { … }`, spec/15) forwards another
                        // module's names; follow its path so that origin module is LOADED
                        // (its declarations + own exports must exist for the forward to
                        // resolve). It always starts a fresh module (like an import). Binds
                        // nothing locally — that's lowerReExport's job (export surface only).
                        mut val rePath: Array[U8] = resolveImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, importer: path, baseLen: baseLen, srcRoot: fSrcRoot, srcRootLen: fSrcRoot.count(), stdRoot: stdRoot, stdRootLen: stdRoot.count())
                        // a re-export may forward a dependency's lib face (`export @Dep
                        // with { … }`); resolve `@dep` the same way as an import.
                        if rePath.count() == 0 {
                            rePath = resolveDepImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, deps: fDeps, pkgDir: fPkgDir)
                        }
                        if rePath.count() == 0 {
                            rePath = resolveGitDepImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, deps: fDeps, cacheRoot: cacheRootBytes, lock: entryLock)
                        }
                        if rePath.count() == 0 {
                            if isExternalDepImport(src: c.arena.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start) {
                                c.errorAt(offset: imp.pathSpan.start, msg: "this `@<package>` re-export names no declared dependency — add it to `[dependencies]` in Plew.toml (spec/17: no phantom dependencies)")
                            }
                        }
                        if rePath.count() != 0 {
                            if !(pathSeen(buf: pathBuf, loaded: loaded, path: rePath)) {
                                if !(fileExists(path: rePath)) {
                                    c.errorAt(offset: imp.pathSpan.start, msg: "cannot open module file: the re-export path does not resolve to an existing file")
                                }
                                val rm: U64 = nextModuleId
                                nextModuleId = nextModuleId + 1
                                val rs: U64 = pathBuf.count()
                                appendBytes(into: inout pathBuf, from: rePath)
                                loaded.append(<Bind nameStart=rs nameLen=rePath.count() fieldStart=rm fieldLen=rePath.count() />)
                            }
                            // record the re-export edge (this module -> the source module it
                            // forwards from), whether newly loaded or deduped, so visibility can
                            // compose an import-of-the-barrel with the barrel's forward.
                            val reTgt: U64 = moduleIdOfPath(buf: pathBuf, loaded: loaded, path: rePath)
                            if reTgt != 4000000000U64 {
                                c.modules.reExportEdges.append(<Bind nameStart=0 nameLen=0 fieldStart=moduleId fieldLen=reTgt />)
                                c.recordImportOrigins(imp: imp, targetMod: reTgt, reExport: true)
                            }
                        }
                    }
                    TopItemAst.Directive(val dir) => { sawDirective = true }
                    TopItemAst.Extern(val e) => {
                        // a `@[...]` derive on an opaque extern lang-item (spec/15,16:
                        // e.g. `@[IntTryFrom] struct I8`) lives inside the extern block,
                        // not at top level — scan its per-struct directives too so the
                        // generated sibling is auto-parted.
                        mut val di: U64 = 0
                        while di < e.structDirectives.count() {
                            if e.structDirectives[di].reqs.count() > 0U64 {
                                sawDirective = true
                            }
                            di += 1
                        }
                    }
                    _ => {}
                }
                ii += 1
            }
            // auto-part (spec/16): a file annotated with `@[...]` pulls in its
            // generated sibling `<file>.gen.pw` as a part of the same module (when it
            // exists). In gen mode this is suppressed ONLY for the entry (module 0) —
            // that is the file whose `.gen.pw` this `--gen` run is producing, so parting
            // its (stale/absent) sibling would be wrong. A DEPENDENCY's committed
            // `.gen.pw` (e.g. @Plew/Syntax's `Kind` Eq witness) is a pre-built artifact
            // and MUST still be parted, else the dependency's own `==` loses its witness
            // during the harness compile (now that the backend synthesizes no fallback).
            if !(genMode) || moduleId != 0U64 {
                if sawDirective {
                    val genPath: Array[U8] = genSiblingPath(path: path)
                    if genPath.count() != 0 {
                        if fileExists(path: genPath) {
                            if !(pathSeen(buf: pathBuf, loaded: loaded, path: genPath)) {
                                val gs: U64 = pathBuf.count()
                                appendBytes(into: inout pathBuf, from: genPath)
                                loaded.append(<Bind nameStart=gs nameLen=genPath.count() fieldStart=moduleId fieldLen=genPath.count() />)
                            }
                        }
                    }
                }
            }
        }
    } else {
        val s: String = readStdin()
        val fileStart: U64 = c.arena.bytes.count()
        c.appendSrc(from: s.bytes())
        c.modules.ranges.append(<Bind nameStart=fileStart nameLen=c.arena.bytes.count() - fileStart fieldStart=0 fieldLen=0 />)
        c.modules.rangePaths.append("<stdin>")
        val items: Array[TopItemAst] = c.parseFile(fileBytes: s.bytes(), fileStart: fileStart)
        mut val pendingIndex: U64 = 0U64
        while pendingIndex < items.count() {
            pendingItems.append(items[pendingIndex])
            pendingIndex += 1U64
        }
    }
    tracePhase(c: inout c, label: "load:done")
    tracePhase(c: inout c, label: "predeclare:start")
    mut val predeclareIndex: U64 = 0U64
    while predeclareIndex < pendingItems.count() {
        c.predeclareTraitItem(item: pendingItems[predeclareIndex])
        predeclareIndex += 1U64
    }
    tracePhase(c: inout c, label: "predeclare:done")
    tracePhase(c: inout c, label: "lower:start")
    mut val lowerIndex: U64 = 0U64
    while lowerIndex < pendingItems.count() {
        // Source lowering is the largest frontend traversal.  Keep coarse
        // trace progress at its ownership boundary so a pathological item can
        // be located without adding ad-hoc prints inside individual lowerers.
        if c.tracePhases && lowerIndex % 100U64 == 0U64 {
            tracePhaseCount(c: inout c, label: "lower:top-item", count: lowerIndex)
        }
        c.lowerTopItem(item: pendingItems[lowerIndex])
        lowerIndex += 1U64
    }
    tracePhase(c: inout c, label: "lower:done")
    tracePhase(c: inout c, label: "declaration-checks:start")
    // (The former @Std/Prelude force-load is gone: the ambient lang items it once carried
    // — Array/Dictionary — now live in @Std/Lang, the single ambient module force-loaded
    // first above. There is no implicit prelude module anymore.)
    // built-in-name span cache (kwSpan): append the lang-item names at known
    // offsets so type recovery can name `String`/`U64`/`Array`/… without scanning
    // the source. Before any analysis (which calls kwSpan via exprType).
    c.buildKwCache()
    // assoc-val reads (spec/05): rewrite `Type.NAME` (a Field on a type that owns an
    // `assoc fn NAME`) into a zero-arg assoc-fn call, before any analysis sees it.
    c.rewriteAssocValReads()
    // named factory calls (spec/05): rewrite `<Type.name attrs/>` to an assoc-fn call
    // when `name` is a named factory (not an enum variant).
    c.rewriteFactoryConstruction()
    // import name aliases (spec/15): rewrite `alias(args)` to the real imported name
    // for each `with { real as alias }`, before visibility/resolution analysis.
    c.rewriteImportAliases()
    // module-level variable init order (spec/15): topologically sort globals so a
    // forward reference in an initializer reads the already-initialized value.
    c.orderGlobalsByDependency()
    // conformance provenance (spec/08,09): owner-module-only bare trait provided
    // methods and bare `impl B as A` must be validated before they can confer
    // methods/conformances onto other types.
    c.checkTraitProvidedMethodOwners()
    c.checkTraitSubjectConformOwners()
    // A trait-to-trait cycle is invalid as a declaration graph. Check it before
    // the concrete-conformance fixpoint, whose idempotent fact deduplication is
    // intentionally not a substitute for this diagnostic.
    c.checkTraitSubjectCycles(activeExtIds: [])
    c.checkTraitSubjectCycleBundles()
    // inter-trait conformance (spec/08,09): `impl B as A` makes every type
    // conforming to subject trait B also conform to A; copy the methods onto each
    // conforming concrete type (before provided methods, so A's own provided
    // methods also reach the newly-conforming types). The headless form
    // `impl[T] T as A where T: B` is rejected separately (Verify.checkBlanketHeadless).
    c.instantiateTraitSubjectConforms()
    // trait provided methods (spec/08): copy each `impl Trait { }` provided
    // method onto every conforming type, so they ride normal method resolution.
    c.instantiateProvidedMethods()
    // recursive value types (spec/03): mark fields that close a containment cycle
    // onto their owner; codegen stores them behind a heap pointer so the C type is
    // finite (hidden indirection; value semantics kept by deref-read/repoint-write).
    c.markBoxedFields()
    // ownership validity (spec/03): a struct owning a unique value must be
    // `unique`; parameter access modes must match copyability. Both exit on error.
    c.checkFieldContagion()
    // `deinit` only on a unique struct (spec/03,05). `unique enum` is legal, but an
    // enum's own explicit deinit body is v1-rejected; active payloads still drop.
    // (Distinct generic type-param names are checked per-bracket in lowerTypeParamNames,
    // before impl++method lists merge.)
    c.checkDeinitOnlyOnUnique()
    c.checkFieldDefaults()
    c.checkParamDefaults()
    c.checkAllParamModes()
    c.checkArrayElemsNotUnique()
    // match pattern soundness (spec/11): a variant/struct pattern must name real
    // fields (else codegen emits `_m.data.V.<missing>` -> broken C). Loud-reject.
    c.checkMatchBinds()
    // missing-return (spec/11): a non-`()` function must return/panic/diverge on
    // every path — Plew does not implicitly return the tail expression, so falling
    // off the end would silently yield uninitialized memory.
    c.checkReturns()
    // trait conformance is explicit and complete (spec/08): every requirement of
    // each `impl Type as Trait` must be witnessed (a body method or a `via` alias).
    c.checkConformances()
    // existential formation (spec/08): `any P` is supported only over a trait with
    // no type args / associated types in this increment (else loud-reject).
    c.checkAnyFormation()
    // Candidate-table registration has already enforced declaration collisions
    // while lowering. The remaining checks concern non-table semantic rules.
    c.checkDuplicateTraitReqs()
    c.checkImplOnBuiltin()
    c.checkImplOnNewtype()
    c.checkMoveFnReceivers()
    // module visibility (spec/15): a name brought in by `import … with { }` must be
    // part of its module's public surface (`export`). Importing from the wrong
    // module also fails here — that module doesn't get loaded, so the name isn't
    // among the exported (loaded) declarations.
    c.checkImports()
    c.detectImportCycles()
    c.checkUseVisibility()
    c.checkTypeVisibility()
    c.resolveTypeDeclIdentities()
    c.checkPublicApiClosure()
    tracePhase(c: inout c, label: "declaration-checks:done")
    // gen mode (spec/16): replace the program with the synthesized derive-runner
    // harness `main`. Added after the user-code checks (so its synthetic call to
    // `deriveFromSource`/`write` is exempt from import hygiene) and before
    // instantiation discovery (so its `print`/method instances are emitted).
    if c.genMode {
        c.synthGenMain()
    }
    // discover concrete generic instantiations to monomorphize. The collection passes are
    // the one phase allowed to REGISTER a grounded-record StructDef (grounding is pure
    // elsewhere); they reach every record instance via scanType. See inCollection.
    // bottom-up type-argument inference (spec/06): ground an un-annotated generic
    // construction `<Box v=1I32 />` from its field value types before instance discovery,
    // so collectGenInsts (which scans Make.ty) reaches the inferred instance. Runs after
    // top-down grounding (done during lowering) and before collection.
    tracePhase(c: inout c, label: "instantiation-collection:start")
    c.traceExprInstScans = 0U64
    tracePhase(c: inout c, label: "instantiation-collection:infer-construct:start")
    c.inferConstructTypeArgs()
    tracePhase(c: inout c, label: "instantiation-collection:infer-construct:done")
    c.inCollection = true
    tracePhase(c: inout c, label: "instantiation-collection:collect-generic:start")
    c.collectGenInsts()
    tracePhase(c: inout c, label: "instantiation-collection:collect-generic:done")
    c.inCollection = false
    tracePhaseCount(c: inout c, label: "instantiation-collection:scan-exprs", count: c.traceExprInstScans)
    tracePhase(c: inout c, label: "instantiation-collection:done")
    // Generic bodies are checked abstractly below. Concrete `where` bounds are
    // checked only when finalization enqueues their grounded BodyInstance; that
    // is the one semantic edge Mono and LLVM will actually consume.
    tracePhase(c: inout c, label: "generic-checks:start")
    recordSemanticExpressionTypes(c: inout c)
    // Allocate the persistent expression cache before abstract generic checking.
    // `checkGenericBodies` resolves each lexical identifier under its symbolic
    // parameter scope and `recordIdent` is the one authoritative producer of
    // identBind/identTarget. Building this table afterwards discarded those
    // bindings, leaving generic bodies without the same lexical provenance as
    // non-generic bodies. The table is allocation-only here; semantic types and
    // final call descriptors are still produced by their later explicit phases.
    tracePhase(c: inout c, label: "type-cache:start")
    c.buildExprTyTable()
    tracePhase(c: inout c, label: "type-cache:done")
    // eager generic type-check (#9): every generic template body is checked once
    // against its `where` bounds — a method/operator on a type parameter must be
    // provided by its bounds (no C++-style "errors only at instantiation").
    tracePhase(c: inout c, label: "generic-body-check:start")
    c.checkGenericBodies()
    tracePhase(c: inout c, label: "generic-body-check:done")
    // unique types cannot be generic type arguments (wrap in Ref[T]); checked
    // after instantiation discovery since it scans the concrete genInsts.
    c.checkGenericUniqueArgs()
    tracePhase(c: inout c, label: "generic-checks:done")
    // backend-independent acceptance pass (spec/15): run the per-expr/stmt checks
    // that were historically done inline during emission (rebuilding the local
    // symbol table as it walks), so acceptance soundness does not depend on how
    // emission works. Runs AFTER the typed-AST cache so the operator-witness /
    // visibility checks see recovered expression types.
    tracePhase(c: inout c, label: "verify:start")
    c.verifyProgram()
    tracePhase(c: inout c, label: "verify:done")
    // TypeTerm recording deliberately precedes generic checking, but a
    // CallTemplate is source-selection evidence and needs the verified
    // callable cache/visibility decisions.  Produce templates in this second
    // lexical walk only; the early walk never publishes a provisional callee.
    tracePhase(c: inout c, label: "call-template-record:start")
    c.traceExprInstScans = 0U64
    c.recordParametricTypes(recordCallTemplates: true)
    tracePhaseCount(c: inout c, label: "call-template-record:scan-exprs", count: c.traceExprInstScans)
    tracePhase(c: inout c, label: "call-template-record:done")
    c.callTemplatesClosed = true
    // Close the per-instance final-callable table only after verification and
    // typed-IR recording are available.  This semantic worklist is independent
    // of LLVM's lazy declaration queues: all backend call emission consumes the
    // resulting entries and never runs overload/source resolution itself.
    tracePhase(c: inout c, label: "finalize-callables:start")
    c.traceExprInstScans = 0U64
    c.traceFinalBodyScans = 0U64
    c.inCollection = true
    c.finalizeCallables()
    c.inCollection = false
    tracePhaseCount(c: inout c, label: "finalize-callables:scan-exprs", count: c.traceExprInstScans)
    tracePhaseCount(c: inout c, label: "finalize-callables:body-scans", count: c.traceFinalBodyScans)
    tracePhaseCount(c: inout c, label: "finalize-callables:body-identities", count: c.arena.bodyInstances.count())
    tracePhaseCount(c: inout c, label: "finalize-callables:descriptors", count: c.arena.finalCallees.count())
    c.traceFinalBodyInstanceSummary()
    tracePhase(c: inout c, label: "finalize-callables:done")
}
// Whether the literal (non-negative magnitude `value`, negated when `neg`) fits
// an integer type of the given width and signedness. Span-free core of
// litFitsType, so synthetic contexts (index = U64, print = I64) can range-check
// literals without a type-name span. The 64-bit signed-negative bound (2^63) is
// expressed via `value - 1 <= 2^63-1` so no 2^63 literal is needed.
fn litFitsBits(value: U64, neg: Bool, bits: U64, sgn: Bool) -> Bool {
    if neg {
        // a negative literal needs a signed target; magnitude <= 2^(bits-1).
        if !(sgn) {
            return false
        }
        if bits == 8 { return value <= 128 }
        if bits == 16 { return value <= 32768 }
        if bits == 32 { return value <= 2147483648 }
        if value == 0 { return true }
        return (value - 1) <= 9223372036854775807U64
    }
    if sgn {
        if bits == 8 { return value <= 127 }
        if bits == 16 { return value <= 32767 }
        if bits == 32 { return value <= 2147483647 }
        return value <= 9223372036854775807U64
    }
    if bits == 8 { return value <= 255 }
    if bits == 16 { return value <= 65535 }
    if bits == 32 { return value <= 4294967295 }
    return true
}

// ---- scalar (literal) match desugar (spec/11) ----
// A `match` that does NOT dispatch on enum variants or struct destructuring — its
// arms are only bare literals (`0`/`"x"`/`true`/`-1`) and wildcards — is not an enum
// match: it desugars here into a single-eval scrutinee binding plus an `==` if/else
// chain, reusing the operator-witness `==` and the existing if-codegen. The arena's
// Stmt.Match / Expr.MatchExpr never see a literal/scalar pattern, so the backend
// enum-tag match emitter stays untouched.
// True if any arm dispatches on an enum variant or a struct pattern (so the match
// must go through the enum emitter, not the scalar desugar).
fn matchHasEnumOrStruct(arms: Array[MatchArmAst]) -> Bool {
    mut val i: U64 = 0
    while i < arms.count() {
        val p: PatternAst = arms[i].pattern
        if !(p.isWildcard) {
            if !(p.isLiteral) {
                return true
            }
        }
        i += 1
    }
    return false
}

// True if the arms are exactly the two boolean literals `true` and `false` (a
// structurally exhaustive Bool match — no wildcard needed, spec/11). Used to allow
// `match b { true => … false => … }`.
fn litArmsAreBoolExhaustive(arms: Array[MatchArmAst]) -> Bool {
    mut val sawTrue: Bool = false
    mut val sawFalse: Bool = false
    mut val i: U64 = 0
    while i < arms.count() {
        val p: PatternAst = arms[i].pattern
        if p.isWildcard {
            return false
        }
        if p.isLiteral {
            match p.lit {
                ExprAst.IntLit(val value, val isBool, tySuffix: _, literalSpan: _, tySuffixSpan: _, span: _) => {
                    if isBool {
                        if value == 1U64 {
                            sawTrue = true
                        }
                        if value == 0U64 {
                            sawFalse = true
                        }
                    } else {
                        return false
                    }
                }
                _ => { return false }
            }
        } else {
            return false
        }
        i += 1
    }
    return sawTrue && sawFalse
}

fn armGiveExprAst(arm: MatchArmAst) -> ExprAst {
    if arm.body.stmts.count() > 0 {
        match arm.body.stmts[0] {
            StmtAst.Give(val value, val span) => { return value }
            _ => {}
        }
    }
    return emptyExpr()
}

fn matchHasCapture(arms: Array[MatchArmAst]) -> Bool {
    mut val i: U64 = 0
    while i < arms.count() {
        if arms[i].pattern.captureName.bytes().count() > 0 {
            return true
        }
        i += 1
    }
    return false
}

// True if a value-match arm block diverges (`=> panic …` / `=> return …`) rather
// than giving a value — its terminal statement is not a `give`.
fn armBlockDiverges(b: BlockAst) -> Bool {
    if b.stmts.count() == 0 {
        return false
    }
    match b.stmts[b.stmts.count() - 1] {
        StmtAst.Give(value: _, span: _) => { return false }
        _ => { return true }
    }
}

// Byte length of a span.
fn spanLen(s: Span) -> U64 {
    return s.end - s.start
}

// Whether string `a` sorts after string `b` (byte-lexicographic) — for ordering a
// record's fields by name into a canonical layout.
fn stringGt(a: String, b: String) -> Bool {
    mut val i: U64 = 0
    while i < a.bytes().count() {
        if i >= b.bytes().count() {
            return true
        }
        if a.bytes()[i] > b.bytes()[i] {
            return true
        }
        if a.bytes()[i] < b.bytes()[i] {
            return false
        }
        i += 1
    }
    return false
}

fn containsU64(xs: Array[U64], v: U64) -> Bool {
    mut val i: U64 = 0
    while i < xs.count() {
        if xs[i] == v {
            return true
        }
        i += 1
    }
    return false
}

// The FieldDef sentinel returned when a lookup fails (nameLen == 0).
fn noField() -> FieldDef {
    return <FieldDef nameStart=0 nameLen=0 tyStart=0 tyLen=0 tyIsArray=false ty=0 isMut=false hasDefault=false defaultVal=0 vis=0 />
}

// Sentinel `typeCache.kind` value marking an uncomputed type-cache slot (real kinds
// are 0=scalar/1=String/2=named/3=array).
fn typeUnfilled() -> I64 {
    return 99
}

// Sentinel `typeCache.callee` value marking an uncomputed callee slot. U64 max can
// never be a real `arena.funcs` index nor the `funcs.count()` not-found marker.
fn calleeUnfilled() -> U64 {
    return 18446744073709551615U64
}

// The kw name for a recorded int-context code (1..8 -> I8..U64).
fn intCtxKw(code: U64) -> String {
    if code == 1 { return "I8" }
    if code == 2 { return "I16" }
    if code == 3 { return "I32" }
    if code == 4 { return "I64" }
    if code == 5 { return "U8" }
    if code == 6 { return "U16" }
    if code == 7 { return "U32" }
    if code == 8 { return "U64" }
    if code == 9 { return "F64" }
    return "F32"
}

// ---- lightweight type recovery (for monomorphization + .bytes() dispatch) ----
fn scalarInfo() -> TypeInfo {
    return <TypeInfo kind=0 nameStart=0 nameLen=0 ref=0 />
}

// Add a match arm's payload binds to the current scope with their field types so
// the arm body resolves them (mirrors the C emitter's per-arm bindings, incl.
// grounding a generic instance's field types under the scrutinee's type args —
// `Box[I32] { val v }` binds v: I32, not the template T). Enum arms resolve via
// the variant; struct-destructure arms (`S { val x }`) via the struct.
// Whether any of `binds` matches the struct field (start,len) by FIELD name (a real
// bind or a `field: _` discard — both cover the field; content comparison unifies the
// re-interned struct-field name with the pattern's original field span).
// A reliable source offset for a match-arm diagnostic: a bind's original-source
// offset (set by lowerBinds) if present, else the (possibly re-interned) pattern
// type-name offset as a fallback.
fn armDiagOffset(c: inout Comp, a: MatchArm) -> U64 {
    if a.binds.len > 0U64 {
        val bind: Bind = c.bindAt(binds: a.binds, index: 0U64)
        if bind.offset > 0U64 {
            return bind.offset
        }
    }
    return a.enumStart
}
