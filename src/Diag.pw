// @Diag — compiler diagnostics + decimal formatting, a dependency-free leaf module
// (imports only @Std). Both ./Frontend and ./Backend use it, so it sits below
// both in the module DAG (@Std ← Diag ← { Frontend, Backend }). These are ordinary
// module functions, NOT ambient builtins, so the compiler source stays spec-valid:
// they report on stderr via @Std/Io `eprint` and stop via @Std/Process `exit`.

use @Std/Io only { eprint }
use @Std/Process only { exit }

// A decimal digit (0-9) as its glyph String.
pub fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// U64 digit (0-9) -> its glyph. A U64 twin of digitStr: with no implicit
// conversions and `as` restricted to lossless, an I64 digitStr cannot serve a
// U64 caller (U64->I64 is not lossless), so unsigned printing needs its own.
pub fn digitStrU(d: U64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// Print a signed integer to stderr (recursive decimal).
pub fn eprintInt(n: I64) {
    if n >= 10 {
        eprintInt(n: n / 10)
    }
    eprint(text: digitStr(d: n % 10))
}

// Print an unsigned integer to stderr. `digitStrU` intentionally formats one
// digit only; trace output must recurse here rather than accidentally showing
// just a value's final decimal digit.
pub fn eprintU64(n: U64) {
    if n >= 10U64 {
        eprintU64(n: n / 10U64)
    }
    eprint(text: digitStrU(d: n % 10U64))
}

// Diagnostics own their source identity and message, independent of an arena.
// Constructing or displaying one does not terminate the embedding process.
pub enum DiagnosticLocation {
    Unpositioned
    Line(line: I64)
    File(path: String, line: I64)
}

pub enum DiagnosticSeverity { Error Warning }

// The producer owns this classification. Message text and severity alone do
// not distinguish an invalid source program from a compiler or input failure.
pub enum FailureDomain { Unclassified Source Input Tool Limit Internal }

pub struct DiagnosticNote {
    pub val location: DiagnosticLocation
    pub val message: String
}
pub impl DiagnosticNote { factory }

// Scalar checking identities are context, not a source-admission capability.
pub enum DiagnosticOwner {
    Unknown
    Function(index: U64)
    Global(target: U64)
    Closure(expression: U64)
}

pub struct UseAfterMoveRefusal {
    val session: U64
    val owner: DiagnosticOwner
    val binding: U64
    val expression: U64
    val location: DiagnosticLocation
}
pub impl UseAfterMoveRefusal {
    factory
    fn session() -> U64 { return self.session }
    fn owner() -> DiagnosticOwner { return self.owner }
    fn binding() -> U64 { return self.binding }
    fn expression() -> U64 { return self.expression }
    fn location() -> DiagnosticLocation { return self.location }
}

pub enum MissingFieldKind { Value ValueCheck RefPointee }
pub impl MissingFieldKind {
    fn message() -> String {
        return match self {
            MissingFieldKind.Value => "no such field on this value's type"
            MissingFieldKind.ValueCheck => "no such field on this value's type (check the field name)"
            MissingFieldKind.RefPointee => "no such field on this Ref's pointee type (check the field name)"
        }
    }
}
pub struct MissingFieldRefusal {
    val session: U64
    val owner: DiagnosticOwner
    val expression: U64
    val receiver: U64
    val nameStart: U64
    val nameLen: U64
    val kind: MissingFieldKind
    val location: DiagnosticLocation
}
pub impl MissingFieldRefusal {
    factory
    fn session() -> U64 { return self.session }
    fn owner() -> DiagnosticOwner { return self.owner }
    fn expression() -> U64 { return self.expression }
    fn receiver() -> U64 { return self.receiver }
    fn nameStart() -> U64 { return self.nameStart }
    fn nameLen() -> U64 { return self.nameLen }
    fn kind() -> MissingFieldKind { return self.kind }
    fn location() -> DiagnosticLocation { return self.location }
}

pub struct UniqueCopyRefusal {
    val session: U64
    val owner: DiagnosticOwner
    val expression: U64
    val location: DiagnosticLocation
}
pub impl UniqueCopyRefusal {
    factory
    fn session() -> U64 { return self.session }
    fn owner() -> DiagnosticOwner { return self.owner }
    fn expression() -> U64 { return self.expression }
    fn location() -> DiagnosticLocation { return self.location }
}

pub enum FreeCallVisibilityKind { UnimportedFunction NonAmbientStd PrivateFunction }
pub impl FreeCallVisibilityKind {
    fn same(other: FreeCallVisibilityKind) -> Bool {
        return match self {
            FreeCallVisibilityKind.UnimportedFunction => match other { FreeCallVisibilityKind.UnimportedFunction => true _ => false }
            FreeCallVisibilityKind.NonAmbientStd => match other { FreeCallVisibilityKind.NonAmbientStd => true _ => false }
            FreeCallVisibilityKind.PrivateFunction => match other { FreeCallVisibilityKind.PrivateFunction => true _ => false }
        }
    }
    fn message() -> String {
        return match self {
            FreeCallVisibilityKind.UnimportedFunction => "use of a function from another module without importing it (add `use … only {{ … }}`)"
            FreeCallVisibilityKind.NonAmbientStd => "this @Std function is not ambient — import it (e.g. `use @Std/Io only {{ print }}`); only lang items are usable without import (spec/15)"
            FreeCallVisibilityKind.PrivateFunction => "this call matches only a function that is not visible here — it is private to another module (spec/15: a private free fn is not reachable through an unrelated module's same-named export)"
        }
    }
}
pub struct FreeCallVisibilityRefusal {
    val session: U64
    val owner: DiagnosticOwner
    val expression: U64
    val kind: FreeCallVisibilityKind
    val argumentsStart: U64
    val argumentsCount: U64
    val location: DiagnosticLocation
}
pub impl FreeCallVisibilityRefusal {
    factory
    fn session() -> U64 { return self.session }
    fn owner() -> DiagnosticOwner { return self.owner }
    fn expression() -> U64 { return self.expression }
    fn kind() -> FreeCallVisibilityKind { return self.kind }
    fn argumentsStart() -> U64 { return self.argumentsStart }
    fn argumentsCount() -> U64 { return self.argumentsCount }
    fn location() -> DiagnosticLocation { return self.location }
}

