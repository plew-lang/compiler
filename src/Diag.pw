pub enum FreeCallAmbiguityKind { VisibleDeclarations NumericLiteralOverloads }
pub impl FreeCallAmbiguityKind {
    fn message() -> String {
        return match self {
            FreeCallAmbiguityKind.VisibleDeclarations => "ambiguous call: multiple visible function declarations match the argument labels and types"
            FreeCallAmbiguityKind.NumericLiteralOverloads => numericOverloadAmbiguityMessage()
        }
    }
    fn same(other: FreeCallAmbiguityKind) -> Bool {
        return match self {
            FreeCallAmbiguityKind.VisibleDeclarations => match other { FreeCallAmbiguityKind.VisibleDeclarations => true _ => false }
            FreeCallAmbiguityKind.NumericLiteralOverloads => match other { FreeCallAmbiguityKind.NumericLiteralOverloads => true _ => false }
        }
    }
}

fn numericOverloadAmbiguityMessage() -> String {
    return "ambiguous call: an unsuffixed integer literal matches more than one overload; add a type suffix (e.g. `5I32`)"
}

pub struct FreeCallAmbiguityRefusal {
