pub enum MemberCallAmbiguityKind { StaticInstances ExistentialRequirements ActiveViews MethodOverloads }
pub impl MemberCallAmbiguityKind {
    fn message() -> String {
        return match self {
            MemberCallAmbiguityKind.StaticInstances => "ambiguous call: multiple trait member instances match the arguments"
            MemberCallAmbiguityKind.ExistentialRequirements => "ambiguous call: multiple trait requirements match the arguments"
            MemberCallAmbiguityKind.ActiveViews => "ambiguous source-qualified call: active views provide multiple matching methods"
            MemberCallAmbiguityKind.MethodOverloads => "ambiguous call: multiple method declarations match the argument labels and types"
        }
    }
    fn same(other: MemberCallAmbiguityKind) -> Bool {
        return match self {
            MemberCallAmbiguityKind.StaticInstances => match other { MemberCallAmbiguityKind.StaticInstances => true _ => false }
            MemberCallAmbiguityKind.ExistentialRequirements => match other { MemberCallAmbiguityKind.ExistentialRequirements => true _ => false }
            MemberCallAmbiguityKind.ActiveViews => match other { MemberCallAmbiguityKind.ActiveViews => true _ => false }
            MemberCallAmbiguityKind.MethodOverloads => match other { MemberCallAmbiguityKind.MethodOverloads => true _ => false }
        }
    }
}

pub struct MemberCallAmbiguityRefusal {
    val kind: MemberCallAmbiguityKind
    val session: U64
    val owner: DiagnosticOwner
    val receiverRef: U64
    val expression: U64
    val nameStart: U64
    val nameLen: U64
    val argumentsStart: U64
    val argumentsCount: U64
    val location: DiagnosticLocation
}
pub impl MemberCallAmbiguityRefusal {
    factory
    fn kind() -> MemberCallAmbiguityKind { return self.kind }
    fn session() -> U64 { return self.session }
    fn owner() -> DiagnosticOwner { return self.owner }
    fn receiverRef() -> U64 { return self.receiverRef }
    fn expression() -> U64 { return self.expression }
    fn nameStart() -> U64 { return self.nameStart }
    fn nameLen() -> U64 { return self.nameLen }
    fn argumentsStart() -> U64 { return self.argumentsStart }
    fn argumentsCount() -> U64 { return self.argumentsCount }
    fn location() -> DiagnosticLocation { return self.location }
}

pub enum AssignmentRefusalKind { Element Field Binding Ref PointeeField }
pub impl AssignmentRefusalKind {
    fn message() -> String {
        return match self {
            AssignmentRefusalKind.Element => "cannot assign to an element of an immutable binding; declare it with `mut val`"
            AssignmentRefusalKind.Field => "cannot assign to an immutable place; the binding and field must be declared `mut val`"
            AssignmentRefusalKind.Binding => "cannot assign to an immutable binding; declare it with `mut val`"
            AssignmentRefusalKind.Ref => "cannot assign through `Ref[T]`; use `MutableRef[T]` for shared mutation or call a mutable handle before narrowing with `asRef()` (spec/03)"
            AssignmentRefusalKind.PointeeField => "cannot assign to an immutable pointee field; declare the field `mut val` (a `MutableRef` shares mutation through a `val` handle but does not make a `val` field writable — spec/03)"
        }
    }
}
pub struct AssignmentRefusal {
    val session: U64
    val owner: DiagnosticOwner
    val statement: U64
    val target: U64
    val kind: AssignmentRefusalKind
    val location: DiagnosticLocation
}
pub impl AssignmentRefusal {
    factory
    fn session() -> U64 { return self.session }
    fn owner() -> DiagnosticOwner { return self.owner }
    fn statement() -> U64 { return self.statement }
    fn target() -> U64 { return self.target }
    fn kind() -> AssignmentRefusalKind { return self.kind }
    fn location() -> DiagnosticLocation { return self.location }
}

// One closed cause in opaque value storage. The transport handle has no
// variant-dependent ARC; classification and rendering inspect its cause.
enum DiagnosticData {
    Report(severity: DiagnosticSeverity, failureDomain: FailureDomain, location: DiagnosticLocation, message: String, notes: Array[DiagnosticNote])
    UseAfterMove(refusal: UseAfterMoveRefusal)
    MissingField(refusal: MissingFieldRefusal)
    Assignment(refusal: AssignmentRefusal)
    UniqueCopy(refusal: UniqueCopyRefusal)
    UniqueCapture(refusal: UniqueCaptureRefusal)
    FreeCallVisibility(refusal: FreeCallVisibilityRefusal)
    NonCallableBinding(refusal: NonCallableBindingRefusal)
    FreeCallAmbiguity(refusal: FreeCallAmbiguityRefusal)
    MemberCallAmbiguity(refusal: MemberCallAmbiguityRefusal)
}
pub struct CompileDiagnostic {
    val storage: Array[DiagnosticData]
}

pub impl CompileDiagnostic {
    factory(severity: DiagnosticSeverity = <DiagnosticSeverity.Error />, failureDomain: FailureDomain = <FailureDomain.Unclassified />, location: DiagnosticLocation, message: String, notes: Array[DiagnosticNote] = []) {
        return <CompileDiagnostic storage=[<DiagnosticData.Report severity=severity failureDomain=failureDomain location=location message=message notes=notes />] />
    }
    factory useAfterMove(refusal: UseAfterMoveRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.UseAfterMove refusal=refusal />] />
    }
    factory missingField(refusal: MissingFieldRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.MissingField refusal=refusal />] />
    }
    factory assignment(refusal: AssignmentRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.Assignment refusal=refusal />] />
    }
    factory uniqueCopy(refusal: UniqueCopyRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.UniqueCopy refusal=refusal />] />
    }
    fn uniqueCopy() -> Optional[UniqueCopyRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.UniqueCopy(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory freeCallVisibility(refusal: FreeCallVisibilityRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.FreeCallVisibility refusal=refusal />] />
    }
    fn freeCallVisibility() -> Optional[FreeCallVisibilityRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.FreeCallVisibility(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory nonCallableBinding(refusal: NonCallableBindingRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.NonCallableBinding refusal=refusal />] />
    }
    fn nonCallableBinding() -> Optional[NonCallableBindingRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.NonCallableBinding(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory uniqueCapture(refusal: UniqueCaptureRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.UniqueCapture refusal=refusal />] />
    }
    fn uniqueCapture() -> Optional[UniqueCaptureRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.UniqueCapture(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory freeCallAmbiguity(refusal: FreeCallAmbiguityRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.FreeCallAmbiguity refusal=refusal />] />
    }
    fn freeCallAmbiguity() -> Optional[FreeCallAmbiguityRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.FreeCallAmbiguity(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory memberCallAmbiguity(refusal: MemberCallAmbiguityRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.MemberCallAmbiguity refusal=refusal />] />
    }
    fn memberCallAmbiguity() -> Optional[MemberCallAmbiguityRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.MemberCallAmbiguity(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    fn assignment() -> Optional[AssignmentRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.Assignment(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    fn missingField() -> Optional[MissingFieldRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.MissingField(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    fn useAfterMove() -> Optional[UseAfterMoveRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.UseAfterMove(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    fn severity() -> DiagnosticSeverity {
        return match self.storage[0U64] {
            DiagnosticData.Report(severity: val severity, failureDomain: _, location: _, message: _, notes: _) => severity
            DiagnosticData.UseAfterMove(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.MissingField(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.Assignment(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.UniqueCopy(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.UniqueCapture(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.FreeCallVisibility(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.NonCallableBinding(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.FreeCallAmbiguity(refusal: _) => <DiagnosticSeverity.Error />
            DiagnosticData.MemberCallAmbiguity(refusal: _) => <DiagnosticSeverity.Error />
        }
    }
    fn failureDomain() -> FailureDomain {
        return match self.storage[0U64] {
            DiagnosticData.Report(severity: _, failureDomain: val domain, location: _, message: _, notes: _) => domain
            DiagnosticData.UseAfterMove(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.MissingField(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.Assignment(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.UniqueCopy(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.UniqueCapture(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.FreeCallVisibility(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.NonCallableBinding(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.FreeCallAmbiguity(refusal: _) => <FailureDomain.Unclassified />
            DiagnosticData.MemberCallAmbiguity(refusal: _) => <FailureDomain.Unclassified />
        }
    }
    fn location() -> DiagnosticLocation {
        return match self.storage[0U64] {
            DiagnosticData.Report(severity: _, failureDomain: _, location: val location, message: _, notes: _) => location
            DiagnosticData.UseAfterMove(refusal: val refusal) => refusal.location()
            DiagnosticData.MissingField(refusal: val refusal) => refusal.location()
            DiagnosticData.Assignment(refusal: val refusal) => refusal.location()
            DiagnosticData.UniqueCopy(refusal: val refusal) => refusal.location()
            DiagnosticData.UniqueCapture(refusal: val refusal) => refusal.location()
            DiagnosticData.FreeCallVisibility(refusal: val refusal) => refusal.location()
            DiagnosticData.NonCallableBinding(refusal: val refusal) => refusal.location()
            DiagnosticData.FreeCallAmbiguity(refusal: val refusal) => refusal.location()
            DiagnosticData.MemberCallAmbiguity(refusal: val refusal) => refusal.location()
        }
    }
    fn message() -> String {
        return match self.storage[0U64] {
            DiagnosticData.Report(severity: _, failureDomain: _, location: _, message: val message, notes: _) => message
            DiagnosticData.MissingField(refusal: val refusal) => refusal.kind().message()
            DiagnosticData.Assignment(refusal: val refusal) => refusal.kind().message()
            DiagnosticData.UniqueCopy(refusal: _) => "a unique value cannot be copied; use `move`, `borrow`, or `inout`"
            DiagnosticData.UniqueCapture(refusal: _) => "closure capture does not support unique, generic struct, or function-typed values"
            DiagnosticData.FreeCallVisibility(refusal: val refusal) => refusal.kind().message()
            DiagnosticData.NonCallableBinding(refusal: _) => "the selected value binding is not callable"
            DiagnosticData.FreeCallAmbiguity(refusal: _) => "ambiguous call: multiple visible function declarations match the argument labels and types"
            DiagnosticData.MemberCallAmbiguity(refusal: val refusal) => refusal.kind().message()
            DiagnosticData.UseAfterMove(refusal: _) => "use of a value after it was moved (`move` transfers ownership away — the variable is dead; bind a fresh value to use it again) (spec/03)"
        }
    }
    fn notes() -> Array[DiagnosticNote] {
        return match self.storage[0U64] {
            DiagnosticData.Report(severity: _, failureDomain: _, location: _, message: _, notes: val notes) => notes
            DiagnosticData.UseAfterMove(refusal: _) => []
            DiagnosticData.MissingField(refusal: _) => []
            DiagnosticData.Assignment(refusal: _) => []
            DiagnosticData.UniqueCopy(refusal: _) => []
            DiagnosticData.UniqueCapture(refusal: _) => []
            DiagnosticData.FreeCallVisibility(refusal: _) => []
            DiagnosticData.NonCallableBinding(refusal: _) => []
            DiagnosticData.FreeCallAmbiguity(refusal: _) => []
            DiagnosticData.MemberCallAmbiguity(refusal: _) => []
        }
    }
    fn isSourceRejection() -> Bool {
        match self.severity() {
            DiagnosticSeverity.Warning => { return false }
            DiagnosticSeverity.Error => {}
        }
        return match self.failureDomain() {
            FailureDomain.Source => true
            _ => false
        }
    }
}

// Presentation consumes locations already mapped by the diagnostic producer.
// Notes carry context only; the primary severity/domain still owns failure.
fn emitDiagnosticMessage(location: DiagnosticLocation, message: String) {
    match location {
        DiagnosticLocation.Unpositioned => {}
        DiagnosticLocation.Line(line: val line) => {
            eprint(text: "line ")
            eprintInt(n: line)
            eprint(text: ": ")
        }
        DiagnosticLocation.File(path: val path, line: val line) => {
            eprint(text: path)
            eprint(text: ":")
            eprintInt(n: line)
            eprint(text: ": ")
        }
    }
    eprint(text: message)
    eprint(text: "\n")
}

pub fn emitDiagnostic(diagnostic: CompileDiagnostic) {
    match diagnostic.severity() {
        DiagnosticSeverity.Error => { eprint(text: "plewc: error: ") }
        DiagnosticSeverity.Warning => { eprint(text: "plewc: warning: ") }
    }
    emitDiagnosticMessage(location: diagnostic.location(), message: diagnostic.message())
    for note in diagnostic.notes() {
        eprint(text: "plewc: note: ")
        emitDiagnosticMessage(location: note.location, message: note.message)
    }
}

pub fn emitDiagnostics(diagnostics: Array[CompileDiagnostic]) {
    for val diagnostic in diagnostics { emitDiagnostic(diagnostic: diagnostic) }
}

// Compatibility adapters for call sites that still require terminal failure.
// They must not become returning operations until callers propagate failure.
pub fn compileErrorAt(line: I64, msg: String) {
    emitDiagnostic(diagnostic: <CompileDiagnostic location=<DiagnosticLocation.Line line=line /> message=msg />)
    exit(code: 1)
}

pub fn compileErrorAtFile(path: String, line: I64, msg: String) {
    emitDiagnostic(diagnostic: <CompileDiagnostic location=<DiagnosticLocation.File path=path line=line /> message=msg />)
    exit(code: 1)
}

// A decimal digit (0-9) as its ASCII byte. (`48 + d` would need a U64->U8 cast,
// which the lossless-`as` discipline forbids, so spell it out.)
pub fn digitByte(d: U64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}
