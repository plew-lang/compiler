    fn nameLen() -> U64 { return self.nameLen }
    fn argumentsStart() -> U64 { return self.argumentsStart }
    fn argumentsCount() -> U64 { return self.argumentsCount }
    fn location() -> DiagnosticLocation { return self.location }
}

pub enum MemberCallAmbiguityKind { StaticInstances ExistentialRequirements ActiveViews MethodOverloads AssociatedReceiverPatterns NumericLiteralOverloads }
pub impl MemberCallAmbiguityKind {
    fn message() -> String {
        return match self {
            MemberCallAmbiguityKind.StaticInstances => "ambiguous call: multiple trait member instances match the arguments"
            MemberCallAmbiguityKind.ExistentialRequirements => "ambiguous call: multiple trait requirements match the arguments"
            MemberCallAmbiguityKind.ActiveViews => "ambiguous source-qualified call: active views provide multiple matching methods"
            MemberCallAmbiguityKind.MethodOverloads => "ambiguous call: multiple method declarations match the argument labels and types"
            MemberCallAmbiguityKind.AssociatedReceiverPatterns => "ambiguous associated call: this type qualifier matches more than one receiver pattern"
            MemberCallAmbiguityKind.NumericLiteralOverloads => numericOverloadAmbiguityMessage()
        }
    }
    fn same(other: MemberCallAmbiguityKind) -> Bool {
        return match self {
            MemberCallAmbiguityKind.StaticInstances => match other { MemberCallAmbiguityKind.StaticInstances => true _ => false }
            MemberCallAmbiguityKind.ExistentialRequirements => match other { MemberCallAmbiguityKind.ExistentialRequirements => true _ => false }
            MemberCallAmbiguityKind.ActiveViews => match other { MemberCallAmbiguityKind.ActiveViews => true _ => false }
            MemberCallAmbiguityKind.MethodOverloads => match other { MemberCallAmbiguityKind.MethodOverloads => true _ => false }
            MemberCallAmbiguityKind.AssociatedReceiverPatterns => match other { MemberCallAmbiguityKind.AssociatedReceiverPatterns => true _ => false }
            MemberCallAmbiguityKind.NumericLiteralOverloads => match other { MemberCallAmbiguityKind.NumericLiteralOverloads => true _ => false }
        }
    }
}

