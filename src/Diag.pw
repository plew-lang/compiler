// @Diag — compiler diagnostics + decimal formatting, a dependency-free leaf module
// (imports only @Std). Both ./Frontend and ./Backend use it, so it sits below
// both in the module DAG (@Std ← Diag ← { Frontend, Backend }). These are ordinary
// module functions, NOT ambient builtins, so the compiler source stays spec-valid:
// they report on stderr via @Std/Io `eprint` and stop via @Std/Process `exit`.

use @Std/Io only { eprint }
use @Std/Process only { exit }

// A decimal digit (0-9) as its glyph String.
pub fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// U64 digit (0-9) -> its glyph. A U64 twin of digitStr: with no implicit
// conversions and `as` restricted to lossless, an I64 digitStr cannot serve a
// U64 caller (U64->I64 is not lossless), so unsigned printing needs its own.
pub fn digitStrU(d: U64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// Print a signed integer to stderr (recursive decimal).
pub fn eprintInt(n: I64) {
    if n >= 10 {
        eprintInt(n: n / 10)
    }
    eprint(text: digitStr(d: n % 10))
}

// Print an unsigned integer to stderr. `digitStrU` intentionally formats one
// digit only; trace output must recurse here rather than accidentally showing
// just a value's final decimal digit.
pub fn eprintU64(n: U64) {
    if n >= 10U64 {
        eprintU64(n: n / 10U64)
    }
    eprint(text: digitStrU(d: n % 10U64))
}

// Diagnostics own their source identity and message, independent of an arena.
// Constructing or displaying one does not terminate the embedding process.
pub enum DiagnosticLocation {
    Unpositioned
    Line(line: I64)
    File(path: String, line: I64)
}

pub enum DiagnosticSeverity { Error Warning }

// The producer owns this classification. Message text and severity alone do
// not distinguish an invalid source program from a compiler or input failure.
pub enum FailureDomain { Unclassified Source Input Tool Limit Internal }

pub struct DiagnosticNote {
    pub val location: DiagnosticLocation
    pub val message: String
}
pub impl DiagnosticNote { factory }

// A report is immutable presentation data. The enclosing sum is the sole
// authority; accessors never maintain another copy of these fields.
struct DiagnosticReportData {
    val severity: DiagnosticSeverity
    val failureDomain: FailureDomain
    val location: DiagnosticLocation
    val message: String
    val notes: Array[DiagnosticNote]
}
impl DiagnosticReportData { factory }

// Private fixed-cardinality value storage. Copies retain value semantics;
// no reference identity or additional public capability is exposed.
pub struct DiagnosticReport {
    val storage: Array[DiagnosticReportData]
}
impl DiagnosticReport {
    factory(severity: DiagnosticSeverity, failureDomain: FailureDomain, location: DiagnosticLocation, message: String, notes: Array[DiagnosticNote]) {
        return <DiagnosticReport storage=[<DiagnosticReportData severity=severity failureDomain=failureDomain location=location message=message notes=notes />] />
    }
}

// Scalar identities explain the failed checking operation; they are not a
// source-admission capability. Raw callers may construct these values.
pub enum DiagnosticOwner {
    Unknown
    Function(index: U64)
    Global(target: U64)
    Closure(expression: U64)
}
struct UseAfterMoveData {
    val session: U64
    val owner: DiagnosticOwner
    val binding: U64
    val expression: U64
    val location: DiagnosticLocation
}
impl UseAfterMoveData { factory }
pub struct UseAfterMoveRefusal {
    val storage: Array[UseAfterMoveData]
}
pub impl UseAfterMoveRefusal {
    factory(session: U64, owner: DiagnosticOwner, binding: U64, expression: U64, location: DiagnosticLocation) {
        return <UseAfterMoveRefusal storage=[<UseAfterMoveData session=session owner=owner binding=binding expression=expression location=location />] />
    }
    fn session() -> U64 { return self.storage[0U64].session }
    fn owner() -> DiagnosticOwner { return self.storage[0U64].owner }
    fn binding() -> U64 { return self.storage[0U64].binding }
    fn expression() -> U64 { return self.storage[0U64].expression }
    fn location() -> DiagnosticLocation { return self.storage[0U64].location }
}

pub enum CompileDiagnostic {
    Report(report: DiagnosticReport)
    UseAfterMove(refusal: UseAfterMoveRefusal)
}

pub impl CompileDiagnostic {
    factory(severity: DiagnosticSeverity = <DiagnosticSeverity.Error />, failureDomain: FailureDomain = <FailureDomain.Unclassified />, location: DiagnosticLocation, message: String, notes: Array[DiagnosticNote] = []) {
        return <CompileDiagnostic.Report report=<DiagnosticReport severity=severity failureDomain=failureDomain location=location message=message notes=notes /> />
    }

    fn severity() -> DiagnosticSeverity {
        return match self {
            CompileDiagnostic.Report(report: val report) => report.storage[0U64].severity
            CompileDiagnostic.UseAfterMove(refusal: val refusal) => <DiagnosticSeverity.Error />
        }
    }

    fn failureDomain() -> FailureDomain {
        return match self {
            CompileDiagnostic.Report(report: val report) => report.storage[0U64].failureDomain
            CompileDiagnostic.UseAfterMove(refusal: val refusal) => <FailureDomain.Unclassified />
        }
    }

    fn location() -> DiagnosticLocation {
        return match self {
            CompileDiagnostic.Report(report: val report) => report.storage[0U64].location
            CompileDiagnostic.UseAfterMove(refusal: val refusal) => refusal.location()
        }
    }

    fn message() -> String {
        return match self {
            CompileDiagnostic.Report(report: val report) => report.storage[0U64].message
            CompileDiagnostic.UseAfterMove(refusal: val refusal) => "use of a value after it was moved (`move` transfers ownership away — the variable is dead; bind a fresh value to use it again) (spec/03)"
        }
    }

    fn notes() -> Array[DiagnosticNote] {
        return match self {
            CompileDiagnostic.Report(report: val report) => report.storage[0U64].notes
            CompileDiagnostic.UseAfterMove(refusal: val refusal) => []
        }
    }

    fn isSourceRejection() -> Bool {
        match self.severity() {
            DiagnosticSeverity.Warning => { return false }
            DiagnosticSeverity.Error => {}
        }
        return match self.failureDomain() {
            FailureDomain.Source => true
            _ => false
        }
    }
}

// Presentation consumes locations already mapped by the diagnostic producer.
// Notes carry context only; the primary severity/domain still owns failure.
fn emitDiagnosticMessage(location: DiagnosticLocation, message: String) {
    match location {
        DiagnosticLocation.Unpositioned => {}
        DiagnosticLocation.Line(line: val line) => {
            eprint(text: "line ")
            eprintInt(n: line)
            eprint(text: ": ")
        }
        DiagnosticLocation.File(path: val path, line: val line) => {
            eprint(text: path)
            eprint(text: ":")
            eprintInt(n: line)
            eprint(text: ": ")
        }
    }
    eprint(text: message)
    eprint(text: "\n")
}

pub fn emitDiagnostic(diagnostic: CompileDiagnostic) {
    match diagnostic.severity() {
        DiagnosticSeverity.Error => { eprint(text: "plewc: error: ") }
        DiagnosticSeverity.Warning => { eprint(text: "plewc: warning: ") }
    }
    emitDiagnosticMessage(location: diagnostic.location(), message: diagnostic.message())
    for note in diagnostic.notes() {
        eprint(text: "plewc: note: ")
        emitDiagnosticMessage(location: note.location, message: note.message)
    }
}

pub fn emitDiagnostics(diagnostics: Array[CompileDiagnostic]) {
    for val diagnostic in diagnostics { emitDiagnostic(diagnostic: diagnostic) }
}

// Compatibility adapters for call sites that still require terminal failure.
// They must not become returning operations until callers propagate failure.
pub fn compileErrorAt(line: I64, msg: String) {
    emitDiagnostic(diagnostic: <CompileDiagnostic location=<DiagnosticLocation.Line line=line /> message=msg />)
    exit(code: 1)
}

pub fn compileErrorAtFile(path: String, line: I64, msg: String) {
    emitDiagnostic(diagnostic: <CompileDiagnostic location=<DiagnosticLocation.File path=path line=line /> message=msg />)
    exit(code: 1)
}

// A decimal digit (0-9) as its ASCII byte. (`48 + d` would need a U64->U8 cast,
// which the lossless-`as` discipline forbids, so spell it out.)
pub fn digitByte(d: U64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}
