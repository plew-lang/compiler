// One closed cause in opaque value storage. The transport handle has no
// variant-dependent ARC; classification and rendering inspect its cause.
enum DiagnosticData {
    Report(severity: DiagnosticSeverity, failureDomain: FailureDomain, location: DiagnosticLocation, message: String, notes: Array[DiagnosticNote])
    UseAfterMove(refusal: UseAfterMoveRefusal)
    MissingField(refusal: MissingFieldRefusal)
    Assignment(refusal: AssignmentRefusal)
    UniqueCopy(refusal: UniqueCopyRefusal)
    UniqueCapture(refusal: UniqueCaptureRefusal)
    FreeCallVisibility(refusal: FreeCallVisibilityRefusal)
    NonCallableBinding(refusal: NonCallableBindingRefusal)
    FreeCallAmbiguity(refusal: FreeCallAmbiguityRefusal)
    MemberCallAmbiguity(refusal: MemberCallAmbiguityRefusal)
    IndexRequirement(refusal: IndexRequirementRefusal)
    TypeVisibility(refusal: TypeVisibilityRefusal)
    ClosureSignature(refusal: ClosureSignatureRefusal)
    LoopTarget(refusal: LoopTargetRefusal)
    SourceTyping(refusal: SourceTypingRefusal)
    OpaqueNumeric(refusal: OpaqueNumericRefusal)
    NamedDeclaration(refusal: NamedDeclarationRefusal)
    OperatorRequirement(refusal: OperatorRequirementRefusal)
    GenericCallConflict(refusal: GenericCallConflictRefusal)
    ArrayContext(refusal: ArrayContextRefusal)
}
pub struct CompileDiagnostic {
    val storage: Array[DiagnosticData]
}

pub impl CompileDiagnostic {
    factory namedDeclaration(refusal: NamedDeclarationRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.NamedDeclaration refusal=refusal />] />
    }
    fn namedDeclaration() -> Optional[NamedDeclarationRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.NamedDeclaration(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory operatorRequirement(refusal: OperatorRequirementRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.OperatorRequirement refusal=refusal />] />
    }
    fn operatorRequirement() -> Optional[OperatorRequirementRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.OperatorRequirement(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory typeVisibility(refusal: TypeVisibilityRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.TypeVisibility refusal=refusal />] />
    }
    fn typeVisibility() -> Optional[TypeVisibilityRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.TypeVisibility(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory closureSignature(refusal: ClosureSignatureRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.ClosureSignature refusal=refusal />] />
    }
    fn closureSignature() -> Optional[ClosureSignatureRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.ClosureSignature(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory loopTarget(refusal: LoopTargetRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.LoopTarget refusal=refusal />] />
    }
    fn loopTarget() -> Optional[LoopTargetRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.LoopTarget(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }
    factory indexRequirement(refusal: IndexRequirementRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.IndexRequirement refusal=refusal />] />
    }
    fn indexRequirement() -> Optional[IndexRequirementRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.IndexRequirement(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }

    factory sourceTyping(refusal: SourceTypingRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.SourceTyping refusal=refusal />] />
    }
    fn sourceTyping() -> Optional[SourceTypingRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.SourceTyping(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }

    factory opaqueNumeric(refusal: OpaqueNumericRefusal) {
        return <CompileDiagnostic storage=[<DiagnosticData.OpaqueNumeric refusal=refusal />] />
    }
    fn opaqueNumeric() -> Optional[OpaqueNumericRefusal] {
        return match self.storage[0U64] {
            DiagnosticData.OpaqueNumeric(refusal: val refusal) => <Optional.Some v=refusal />
            _ => <Optional.None />
        }
    }

    factory genericCallConflict(refusal: GenericCallConflictRefusal) {
