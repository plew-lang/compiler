pub fn opaqueNumericMessage() -> String { return "cannot assign a literal to a type parameter: it is an opaque type with no numeric bound (spec/06)" }

pub enum LoopTargetRefusalKind { BreakNoLoop ContinueNoLoop BreakCondition ContinueCondition }
pub impl LoopTargetRefusalKind {
    fn message() -> String {
        return match self {
            LoopTargetRefusalKind.BreakNoLoop => "`break` outside a loop (spec/11)"
            LoopTargetRefusalKind.ContinueNoLoop => "`continue` outside a loop (spec/11)"
            LoopTargetRefusalKind.BreakCondition => "`break` cannot target a surrounding loop from a while condition (spec/11)"
            LoopTargetRefusalKind.ContinueCondition => "`continue` cannot target a surrounding loop from a while condition (spec/11)"
        }
    }
    fn same(other: LoopTargetRefusalKind) -> Bool {
        return match self {
            LoopTargetRefusalKind.BreakNoLoop => match other { LoopTargetRefusalKind.BreakNoLoop => true _ => false }
            LoopTargetRefusalKind.ContinueNoLoop => match other { LoopTargetRefusalKind.ContinueNoLoop => true _ => false }
            LoopTargetRefusalKind.BreakCondition => match other { LoopTargetRefusalKind.BreakCondition => true _ => false }
            LoopTargetRefusalKind.ContinueCondition => match other { LoopTargetRefusalKind.ContinueCondition => true _ => false }
        }
    }
}
