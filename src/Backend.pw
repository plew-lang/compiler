import ./Mid/Ambient with { MidAmbientProgram, MidAmbientBodyPlan, MidAmbientStorage }
import ./Mid/Program with { MidExecutableProgram }
import ./PreparedProgram with { PreparedProgram, programPreparationDiagnostic }
// @Backend — the LLVM emitter of the self-hosted Plew compiler. It consumes the
// front-end's analyzed `Comp` (built by `./Frontend`'s `analyzeFrontend`) and emits
// an owned LLVM module via libLLVM-C. Text is an explicit diagnostic/seed
// output; object emission borrows the same module. `emitLlvmRuntime` emits C. It `import`s
// the IR data (`./Ir`) and the front-end query/analysis API (`./Frontend`) — a
// one-way dependency (Ir ← Frontend ← Backend), so the module graph is a DAG.

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint, fileExists }
import @Std/Process with { argCount, argAt, exit }
import @Std/Ffi with { cString, cFree, stringFromCString, arrayCPtr }
import @Std/Core with { stringFromBytesUnchecked, truncU8, truncU32 }
import @Plew/Syntax with { Kind, Tok, Lexer, lex, kindCode, rangeEquals, P, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst, emptyExpr }
import ./Ir with { PType, TypeRef, ArcClass, CaptureEntry, SemanticClosure, SemanticClosureCaptureMode, Local, TypeInfo, MakeFieldOrigin, MakeField, MakeFieldRange, Bind, BindRange, Arg, ArgRange, ExprRange, MatchArm, MatchArmRange, FuncParamRange, PatInfo, IdentBinding, Block, Param, FieldDef, StructDef, Variant, TraitDef, DeriveReq, AssocBinding, ChainSite, DestructureSite, Conform, MethodAlias, FuncBound, FnInst, BodyInstance, InstanceEnvironment, CallResolution, CallTarget, CallResultProjection, CallReceiverPassing, CallArgumentPassing, RuntimeIntrinsic, IoIntrinsic, ProcessIntrinsic, CoreStringIntrinsic, FfiIntrinsic, NumericIntrinsic, NumericConversionIntrinsic, NumericWidth, IntegerOperation, FloatWidth, FloatOperation, BoolOperation, NumericOverflow, BufferIntrinsic, ValueConversionProof, EnumPayloadConversion, EnumDef, Func, Global, NewtypeDef, Arena, Decls, Modules, MonoWork, TypeCache, Interner, ParseScratch, Cursor, Expr, Stmt, appendBytes, identUnfilledCode, identValueCode, identFnCode, identNoTarget }
import ./Frontend with { Comp, intern, spansEqual, tracePhase, tracePhaseCount, tracePhaseProgress }
// Import the Mid vocabulary at the backend boundary now.  Lowering is migrated
// body-by-body; keeping this edge one-way prevents Mid from becoming another
// frontend `part` or from reaching LLVM through ambient AST recovery.
import ./Mid with { MidParametricBody, MidExecutableBody, MidPreparationError, MidRange, MidBodyNode, MidPlaceNode, MidProjectionNode, MidOperandNode, MidRvalueNode, MidAggregateElementNode, MidStatementNode, MidTerminatorNode, MidBlockNode, MidSwitchCase, MidCallTargetNode, MidCallReceiverNode, MidCanonicalBody, MidPlace, MidConstant, MidOperand, MidAggregateKind, MidAggregateElement, MidRvalue, MidCastKind, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody, MidVerification, MidVerifyError, MidUnsupportedBuild, MidUnsupportedAssign, MidBuildError, MidBodyBuild, MidInstantiateError, MidAccessError, buildParametricMidBody, buildMidBodyForInstance, buildParametricMidGlobalInit, ensureParametricMidClosureBody }
export ./Frontend with { Comp }
export @Plew/Syntax with { Kind, Tok, Lexer, P, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, TypeParamListAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst }
export ./Ir with { PType, TypeRef, ArcClass, CaptureEntry, Local, TypeInfo, MakeField, Bind, BindRange, Arg, ArgRange, MatchArm, MatchArmRange, PatInfo, IdentBinding, Block, Param, FieldDef, StructDef, Variant, TraitDef, DeriveReq, AssocBinding, ChainSite, DestructureSite, Conform, MethodAlias, FuncBound, FnInst, InstanceEnvironment, EnumDef, Func, Global, NewtypeDef, Arena, Decls, Modules, MonoWork, TypeCache, Interner, ParseScratch, Cursor, Expr, Stmt }
import ./Diag with { CompileDiagnostic, DiagnosticLocation, digitStrU }
import ./Ops with { opEq, opNe, opLt, opLe, opGt, opGe, opAdd, opSub, opMul, opDiv, opRem, opAnd, opOr, opNot, opBitAnd, opBitOr, opBitXor, opShl, opShr, opBitNot, opAssign, isBinTraitOp, binTraitMethodName, unaryMethodName }

// The initial backend subset is deliberately fail-closed. Keep the reason as
// a closed value rather than an anonymous Bool so coverage can account for
// every legacy fallback without inspecting source syntax.
//
// A call needs a second closed layer: `Call` is a boundary between Mid and an
// ABI, not one implementation feature.  Conflating its independent admission
// facts made coverage incapable of selecting the next lowering slice.
export enum MidCallPreflight {
    None
    Resolution
    Target
    Callee
    Async
    Receiver
    RuntimeAbi
    Buffer
    Extern
    GenericArguments
    ArgumentShape
    Result
    Argument
}

export enum MidLlvmPreflight {
    Ready
    AbiLocals
    AssignmentProjection
    UnsupportedRvalue
    ConversionOperand
    DropProjection
    ScopeExit
    Switch
    Call(reason: MidCallPreflight)
    ReturnValue
    Terminator
}

// Backend-local admission result. Ready is constructed only after ownership
// verification and LLVM capability checks on this frozen body. Its ABI prefix
// travels with the body rather than being supplied again by emission callers.
enum MidLlvmPrepared {
    None
    Ready(canonical: MidCanonicalBody, abiParameterCount: U64)
}

// These are frontend/ABI admission facts, separate from a Mid or LLVM
// preflight failure.  A body can report more than one reason; coverage uses
// that fact set to prioritize the next representation slice without guessing
// from function spelling.
export enum MidEligibilityReason {
    Async
    Extern
    InoutReceiver
    MoveReceiver
    Globals
}

// The direct-AST LLVM path's evidence for an addressable source place.  A raw
// `LLVMValueRef` alone is not enough: once a field GEP is followed by another
// field GEP, LLVM needs the *actual instantiated pointee layout*, not a type
// reconstructed from the source expression.  `typeRef`/`structIdx` are the
// corresponding semantic identity used only to name the next declared field.
// Mid has its own structural `MidPlace`; this is deliberately the temporary
// backend carrier while bodies migrate to Mid.
struct LlvmPlace {
    pub val ptr: LLVMValueRef
    pub val pointeeTy: LLVMTypeRef
    pub val typeRef: U64
    pub val structIdx: U64
}

pub impl LlvmPlace { factory }

// Backend work queues must not store an owning Array inside each slot. Generic
// method instances carry a variable number of method-owned type arguments, but
// a slot is routinely copied while the emission fixpoint drains. Keep the slot
// scalar and store its payload once in LlvmCtx's typed U64 pool.
struct LlvmTypeArgRange {
    pub val start: U64
    pub val len: U64
}

pub impl LlvmTypeArgRange { factory }

// One frozen body instance that did not take the Mid LLVM path. `bodyId` is
// the frontend's canonical BodyInstance identity; no source spelling or AST
// recovery is retained in this report.
// ---- backend state (threaded inout through the emitters) ----
//
// Holds the LLVM context/module/builder, cached primitive types, the current
// function being emitted, and the local-variable environment (a stack of
// name-span -> alloca pointer + element type; searched from the end so a
// shadowing redeclaration wins). `terminated` tracks whether the current basic
// block already has a terminator, so we never append after a ret/br.
struct LlvmClosure {
    pub val bodyId: U64
    pub val semanticIndex: U64
    pub val functionTypeTerm: U64
    pub val function: LLVMValueRef
    pub val captures: Array[CaptureEntry]
}
pub impl LlvmClosure { factory }

struct LlvmClosureEnvironmentDrop {
    pub val closureSlot: U64
    pub val bodyId: U64
    pub val function: LLVMValueRef
}
pub impl LlvmClosureEnvironmentDrop { factory }

struct LlvmExistentialWitness {
    pub val resolution: U64
    pub val member: U64
    pub val function: LLVMValueRef
}
pub impl LlvmExistentialWitness { factory }

enum LlvmValuePassing {
    Omitted
    Direct
    Indirect
}
struct LlvmValueParameter {
    pub val type: LLVMTypeRef
    pub val physicalIndex: U64
    pub val passing: LlvmValuePassing
}
pub impl LlvmValueParameter { factory }

// Logical value types stay separate from the private physical call signature.
struct LlvmValueAbi {
    pub val parameterStart: U64
    pub val parameterCount: U64
    pub val logicalSignature: LLVMTypeRef
    pub val functionType: LLVMTypeRef
}
pub impl LlvmValueAbi { factory }

struct LlvmAmbientScope {
    pub val group: Optional[LLVMValueRef] = <Optional.None />
    pub val records: Array[LLVMValueRef] = []
}
pub impl LlvmAmbientScope { factory }


struct LlvmCtx {
    pub val ambientProgram: MidAmbientProgram = <MidAmbientProgram.empty />
    pub mut val ambientBody: MidAmbientBodyPlan = <MidAmbientBodyPlan />
    pub mut val ambientPermit: Optional[LLVMValueRef] = <Optional.None />
    pub mut val ambientScopes: Dictionary[U64, LlvmAmbientScope] = [:]
    pub val midProgram: MidExecutableProgram = <MidExecutableProgram.empty />
    pub mut val valueAbiByvalKind: U32 = 0U32
    pub mut val valueAbis: Array[LlvmValueAbi] = []
    pub mut val valueAbiFunctions: Dictionary[U64, U64] = [:]
    pub mut val valueAbiParameters: Array[LlvmValueParameter] = []

    // A diagnostic-only scalar table.  These three columns have identical
    // length and are appended solely by `recordMidCoverage`; avoiding a rich
    // record here ensures that reporting never owns or copies Mid internals.
    pub mut val midCoverageBodyIds: Array[U64]
    pub mut val midCoverageFnIdxs: Array[U64]
    pub mut val midCoverageKeys: Array[U64]
    pub val ctx: LLVMContextRef
    pub val mod: LLVMModuleRef
    pub mut val b: LLVMBuilderRef
    pub val i1ty: LLVMTypeRef
    pub val i8ty: LLVMTypeRef
    pub val i16ty: LLVMTypeRef
    pub val i32ty: LLVMTypeRef
    pub val i64ty: LLVMTypeRef
    // the IEEE-754 double type for float (F64/F32) literals and arithmetic. F32 is
    // represented as double for now (observably fine for the float floor; a true 32-bit
    // float is additive).
    pub val f64ty: LLVMTypeRef
    pub val voidty: LLVMTypeRef
    pub val ptrty: LLVMTypeRef
    // Closure / function-value type: { ptr fn, ptr env } — a lambda-lifted function
    // pointer plus its captured-environment pointer (NULL for non-capturing). Every
    // `fn(...) -> ...` value is this fat pointer; the callee ABI takes env first.
    pub val closureTy: LLVMTypeRef
    // Existential `any P` value type (spec/08): { ptr data, ptr vtable } — a fat
    // pointer. `data` points at an ARC-boxed copy of the erased concrete value;
    // `vtable` at the static per-(concrete-type, trait) thunk table (slot 0 = drop,
    // slot 1.. = the trait's requirement methods in declaration order).
    pub val anyTy: LLVMTypeRef
    // built vtables, cached by (concrete struct idx, traitId, binding key) -> the LLVM
    // global value. The binding key distinguishes existentials whose associated-type /
    // type-parameter bindings differ (`any Add[I32,…]` vs `any Add[I64,…]`).
    pub mut val anyVtResolution: Array[U64]
    pub mut val anyVtVal: Array[LLVMValueRef]
    pub mut val closureEnvironmentDrops: Array[LlvmClosureEnvironmentDrop] = []
    pub mut val closureEnvironmentDropsEmitted: U64 = 0U64
    pub mut val existentialWitnesses: Array[LlvmExistentialWitness] = []
    pub mut val existentialWitnessesEmitted: U64 = 0U64
    pub mut val curFn: LLVMValueRef
    pub mut val terminated: Bool
    // the function currently being emitted: is it `main` (returns i32 0), and its
    // LLVM return type + whether it returns void (Plew `()`), so `return` and the
    // fall-through epilogue terminate with the right instruction.
    pub mut val curIsMain: Bool
    pub mut val curRetVoid: Bool
    pub mut val curRetTy: LLVMTypeRef
    // the value yielded by the innermost value-position block (a `give` statement
    // sets it; IfExpr reads it after emitting each branch block).
    pub mut val giveValue: LLVMValueRef
    // struct instances (parallel: TypeRef index -> LLVM type, def index). EVERY struct
    // lives here: a true generic instance (`Pair[I32]`) keyed by its arg-bearing ref, and a
    // non-generic struct as its own 0-type-arg instance (bare-name, no-args ref) pointing at
    // the same named `%st` type. A generic-typed local points locStructIdx at the def and
    // locTypeRef at the instance, so field access reuses the struct machinery + substitution.
    mut val genStructRefs: Array[U64] = []
    mut val genStructTys: Array[LLVMTypeRef] = []
    mut val genStructDefs: Array[U64] = []
    // FinalDestruction identity -> physical slot + 1; zero means no such layout.
    mut val finalStructSlots: Array[U64] = []
    mut val finalEnumSlots: Array[U64] = []
    // enum instances (parallel: TypeRef ref -> LLVM type, def idx). Every enum lives here:
    // a generic instance (`Optional[I32]`) keyed by its arg-bearing ref, and a non-generic
    // enum keyed by its 0-type-arg (bare-name) ref. The one `%ge` mechanism (genEnumSlot).
    pub mut val genEnumRefs: Array[U64]
    pub mut val genEnumTys: Array[LLVMTypeRef]
    pub mut val genEnumDefs: Array[U64]
    // a byte span whose content is "self" (appended to c.arena.bytes), to bind the
    // method receiver as a local that the body's `self` identifiers resolve to.
    pub mut val selfStart: U64
    pub mut val selfLen: U64
    // while emitting a generic method body, the receiver's instantiation TypeRef
    // (so `self`'s LLVM type / struct-or-enum env resolve to the instance). 0 when
    // emitting a free function or a non-generic method.
    // the expected type of the expression about to be emitted (a let annotation, a
    // boxed field's pointee type, …) — used to infer a JSX generic-enum/struct
    // construction whose own `ty` is the ungrounded head (`<Optional.Some v=42 />`
    // with no `[I64]`). Consumed (cleared to 0) by the construction that uses it so
    // it doesn't leak into sub-expressions. 0 when no expectation is in effect.
    pub mut val expectedTy: U64
    // the current function/closure's return TypeRef (0 = void / none), so a `return
    // <Optional.Some …/>` infers its type args from the declared return type.
    // the local index of the current function's FIRST body local (= param count
    // incl. self), so scope-exit deinit drops skip params (borrows/inout self that
    // the caller still owns and will deinit).
    pub mut val curBodyMark: U64
    // The `pf<idx>` symbol table (parallel arrays keyed by c.arena.funcs index): the
    // lazily-declared functions that are NOT ordinary user fns/methods/assoc — those are
    // their own gf/gm 0-type-arg instances now (B3/B4). After the unification, `pf` holds
    // only provided / lang-item / non-entry-std METHODS whose receiver has no user-type
    // instance to key a `gm` on (ensureProvidedDeclared — primitives, trait receivers).
    // It is no longer the "non-generic vs generic" seam, just an on-demand declaration
    // cache for non-instantiated method bodies. (Async-fn ENTRY symbols, the other former
    // pf user, now live in their own asyncEntry* table.)
    pub mut val fnIdx: Array[U64]
    pub mut val fnVal: Array[LLVMValueRef]
    pub mut val fnTy: Array[LLVMTypeRef]
    // Free-function bodies (parallel: frozen BodyInstance id -> value, type).  The body id
    // includes every ParamId substitution, receiver and selected proof, so it is the one
    // executable identity shared with final CallResolution.  `FnInst` is only provisional
    // Mono discovery work; LLVM must never use it as a second body key.
    pub mut val genFnK: Array[U64]
    pub mut val genFnVal: Array[LLVMValueRef]
    pub mut val genFnTy: Array[LLVMTypeRef]
    // Slots are declared from the finalized body closure before emission. The queue remains
    // a uniform body-emission order, not a lazy source-level instance discovery mechanism.
    pub mut val genFnEmit: Array[U64]
    // Physical method slots keyed only by the finalized semantic BodyInstance.
    pub mut val genMethVal: Array[LLVMValueRef]
    pub mut val genMethTy: Array[LLVMTypeRef]
    pub mut val genMethBody: Array[U64]
    // local environment (parallel arrays). `nLocals` is the logical count: blocks
    // save it on entry and restore it on exit (lexical scope), so a shadowing
    // binding inside a block leaves scope at the block's end and a later reference
    // resolves to the outer binding. push overwrites the slot at `nLocals` (or
    // appends), so the arrays may be longer than `nLocals` — only [0, nLocals) is live.
    pub mut val nLocals: U64
    pub mut val locStart: Array[U64]
    pub mut val locLen: Array[U64]
    pub mut val locPtr: Array[LLVMValueRef]
    pub mut val locTy: Array[LLVMTypeRef]
    // a small Plew-type-kind tag per local (0 int/signed, 1 String, 2 Bool, 3
    // unsigned int), so String ==/!= and print pick the right lowering without
    // c.cur.locals (which the LLVM backend doesn't populate, so typeOf can't see locals).
    pub mut val locKind: Array[U64]
    // per-local owning struct index (c.arena.structCount() = not a struct), so field
    // access x.field can resolve the layout from a struct-typed local.
    pub mut val locStructIdx: Array[U64]
    // per-local array element type + is-array flag (for arr[i] / .append / .count()).
    pub mut val locIsArr: Array[Bool]
    pub mut val locElemTy: Array[LLVMTypeRef]
    pub mut val locElemKind: Array[U64]
    pub mut val locTypeRef: Array[U64]
    // per-array-local element TypeRef (0 = none), so `arr[i]` recovers the element's
    // instance — a Ref (`Array[Ref[Box]]` -> `ys[0]->v`) or a nested array.
    pub mut val locElemTypeRef: Array[U64]
    // per-local ownership for scope-exit deinit (spec/03): `locOwned` = this local's
    // value is owned here and must be deinit'd at scope exit (body locals + `move`
    // params + a `move fn` self; false for inout/borrow params / by-value-self
    // borrows the caller owns). `locMoved` = ownership was handed off (a `move`
    // arg / `move fn` receiver / `move x`), so it is NOT deinit'd here.
    pub mut val locOwned: Array[Bool]
    pub mut val locMoved: Array[Bool]
    // `locCellHome` = locPtr IS an rc'd rawbuf cell (a `mut val` heap-boxed for
    // closure capture): scope exit drops one CELL owner (emitCellRelease) instead of
    // releasing the pointee value directly, and a capturing closure's env retains it.
    pub mut val locCellHome: Array[Bool]
    // module-level variables (spec/15), parallel arrays indexed by `Comp.arena.globals`
    // position. `genLlvmInitGlobals` builds the LLVM global `gvalRef[i]` and records
    // the binding's recovered local metadata (so `seedGlobals` can re-register each
    // global as a local at every body entry, routing reads/writes/type-recovery
    // through the normal local machinery). The init values are stored once, in
    // declaration order, by `plew_init_globals`.
    pub mut val gvalRef: Array[LLVMValueRef] = []
    pub mut val gvalLty: Array[LLVMTypeRef] = []
    pub mut val gvalTref: Array[U64] = []
    // Cell pin (spec/03): a deref-crossing `inout` place retains its Ref cell for the
    // call's duration, so a mid-call rebind cannot free the lent pointee — the pointee
    // deinit runs after the call. A stack of pinned cells (parallel: cell value, the
    // Ref TypeRef for the release, the arg place expr id for the overlap check's cell
    // lookup): each call site marks the count before lowering its arguments and
    // releases back to the mark right after the call instruction (an inner call inside
    // an argument pops its own pins during the outer lowering, so frames nest cleanly).
    // `pinArm` arms the pin: placePtrStrict's deref arms push ONLY while an `inout`
    // argument/receiver pointer is being computed (placePtrOfWritePinned), not for
    // reads or assignment targets.
    pub mut val pinCells: Array[LLVMValueRef] = []
    pub mut val pinRefTys: Array[U64] = []
    pub mut val pinExprs: Array[U64] = []
    pub mut val pinArm: Bool = false
    // declared runtime/intrinsic functions, cached by name id (parallel arrays).
    pub mut val declId: Array[U64]
    pub mut val declFn: Array[LLVMValueRef]
    pub mut val declTy: Array[LLVMTypeRef]
    // Concrete closure bodies and their ABI share the frontend BodyInstance key.
    pub mut val closures: Array[LlvmClosure]
    // Legacy named-function-value thunks. Kept empty in v1: a named function declaration is
    // not a value, so first-class functions must be explicit closure literals.
    // per-struct drop (deinit) witnesses, keyed by struct index (parallel arrays):
    // ONE `void @pwdrop<sidx>(structVal)` function emits the recursive destruction
    // (own deinit + field walk) for that struct type, so every drop site emits a
    // single call instead of inlining the whole walker — collapsing the IR (the
    // dominant compile-time cost). Declared on demand at a drop site, drained into
    // bodies after the main pass (a body may declare more sub-struct witnesses).
    pub mut val dropWitReg: Array[U64]
    pub mut val dropWitVal: Array[LLVMValueRef]
    pub mut val dropWitTy: Array[LLVMTypeRef]
    // Per-instance retain witnesses, keyed by genStruct registration like
    // drop witnesses. Each pwretain<reg> uses that instance's ABI and generic
    // environment; nested instances of one struct declaration remain distinct.
    pub mut val retWitReg: Array[U64]
    pub mut val retWitVal: Array[LLVMValueRef]
    pub mut val retWitTy: Array[LLVMTypeRef]
    // Enum retain and release witnesses are keyed by concrete layout slot.
    pub mut val enumRelWitReg: Array[U64]
    pub mut val enumRelWitVal: Array[LLVMValueRef]
    pub mut val enumRelWitTy: Array[LLVMTypeRef]
    pub mut val enumRetWitReg: Array[U64]
    pub mut val enumRetWitVal: Array[LLVMValueRef]
    pub mut val enumRetWitTy: Array[LLVMTypeRef]
    // persistent body-emission cursors for the 4 witness tables. The witness graphs cross
    // struct<->enum WITHIN a family (a struct-drop body releases an Array[Enum] element ->
    // enum-release witness, whose body deinits a struct field -> struct-drop witness), so a
    // single drain pass is not enough — `emitWitnessBodies` loops all 4 drains to a fixpoint,
    // and each resumes from its cursor (never re-emitting an already-emitted body).
    pub mut val dropWitDone: U64
    pub mut val retWitDone: U64
    pub mut val enumRelWitDone: U64
    pub mut val enumRetWitDone: U64
    // Finalized method slots requested during emission join the body drain.
    pub mut val genMethEmit: Array[U64]
    // ---- async (spec/14): stackless state machine, mirrors Codegen/Async.pw ----
    // Promise completion cell: the first two fields are read by Mid lowering;
    // the runtime exclusively manages the waiter head/tail pointers.
    pub mut val promiseTy: LLVMTypeRef
    // Physical state of the Mid-generated async resume: frame layout, callback,
    // and dispatch switch. Suspension states and storage come from canonical Mid.
    pub mut val curFrameBase: LLVMValueRef
    pub mut val curFrameTy: LLVMTypeRef
    pub mut val curResumeFn: LLVMValueRef
    pub mut val curAsyncSwitch: LLVMValueRef
    // per async fn (parallel, keyed by c.arena.funcs index): its frame struct type and
    // resume fn value, so the entry/resume/await sites all agree on the layout.
    pub mut val asyncFnIdx: Array[U64]
    pub mut val asyncMidBodies: Array[MidCanonicalBody] = []
    pub mut val asyncLocalSlots: Array[Array[U64]] = []
    pub mut val asyncFrameTy: Array[LLVMTypeRef]
    pub mut val asyncResumeFn: Array[LLVMValueRef]
    // the promise-returning ENTRY symbol of each non-main async fn (`async fn doubler`
    // -> `pf<fi>`), its own small symbol table keyed by funcs index — kept SEPARATE from
    // the `pf` fnIdx/fnVal/fnTy tables (which now hold only provided/lang-item method
    // lazy declarations) so an async state-machine entry is no longer conflated with a
    // method symbol. `main` keeps the C `i32 main()` shape and has no entry here.
    pub mut val asyncEntryIdx: Array[U64]
    pub mut val asyncEntryVal: Array[LLVMValueRef]
    pub mut val asyncEntryTy: Array[LLVMTypeRef]
    // loop break/continue target blocks (a stack — innermost loop on top), so a
    // `break` branches to the enclosing loop's end and `continue` to its
    // header/step. Pushed by while/for codegen, popped at the loop's end. The
    // arrays are reused buffers; loopDepth is the live count (overwrite-in-place,
    // matching the local-scope idiom — Array has no pop).
    pub mut val loopBreakBB: Array[LLVMBasicBlockRef]
    pub mut val loopContBB: Array[LLVMBasicBlockRef]
    // the loop-body-entry local mark (nLocals at pushLoop), per loop frame. `break` /
    // `continue` are non-local scope exits: they must release the live body locals of the
    // current iteration before branching, exactly as the body's fall-through would. Driving
    // that off this frame-recorded mark (not a hand-picked one) is the single source of
    // truth for "what to drop on a loop exit" — see emitLoopExitDrops.
    pub mut val loopUnwindMark: Array[U64]
    pub mut val loopDepth: U64
}
pub impl LlvmCtx { factory }

// ---- libLLVM-C bindings (raw FFI floor; positional, no labels) ----
//
// Opaque handles are void* ABI-identical to the real LLVM `…Opaque *` typedefs,
// so no <llvm-c/*.h> include is needed — the compiler self-emits the prototypes.
extern(c) {
    type LLVMContextRef
    type LLVMModuleRef
    type LLVMTypeRef
    type LLVMValueRef
    type LLVMBasicBlockRef
    type LLVMBuilderRef
    fn plew_pointer_equal(first~: LLVMTypeRef, second~: LLVMTypeRef) -> I32

    // Context / module.
    fn LLVMGetHostCPUName() -> CPtr[U8]
    fn LLVMContextCreate() -> LLVMContextRef
    fn LLVMModuleCreateWithNameInContext(name~: CPtr[U8], ctx~: LLVMContextRef) -> LLVMModuleRef
    fn LLVMDisposeModule(module~: LLVMModuleRef)
    fn LLVMContextDispose(context~: LLVMContextRef)
    fn plew_llvm_emit_object(module~: LLVMModuleRef, output~: CPtr[U8], cpu~: CPtr[U8], trace~: I32) -> I32
    fn LLVMPrintModuleToString(m~: LLVMModuleRef) -> CPtr[U8]
    fn LLVMDisposeMessage(msg~: CPtr[U8])

    // Types.
    fn LLVMInt1TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt8TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt16TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt32TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt64TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMDoubleTypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMConstRealOfStringAndSize(ty~: LLVMTypeRef, text~: CPtr[U8], len~: U64) -> LLVMValueRef
    fn LLVMVoidTypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMPointerTypeInContext(ctx~: LLVMContextRef, addrSpace~: U32) -> LLVMTypeRef
    fn LLVMStructTypeInContext(ctx~: LLVMContextRef, elemTypes~: CPtr[LLVMTypeRef], count~: U64, packed~: I32) -> LLVMTypeRef
    fn LLVMStructCreateNamed(ctx~: LLVMContextRef, name~: CPtr[U8]) -> LLVMTypeRef
    fn LLVMStructSetBody(structTy~: LLVMTypeRef, elemTypes~: CPtr[LLVMTypeRef], count~: U64, packed~: I32)
    fn LLVMCountStructElementTypes(structTy~: LLVMTypeRef) -> U32
    fn LLVMIsOpaqueStruct(structTy~: LLVMTypeRef) -> I32
    fn LLVMIsPackedStruct(structTy~: LLVMTypeRef) -> I32
    fn LLVMGetElementType(ty~: LLVMTypeRef) -> LLVMTypeRef
    fn LLVMGetArrayLength2(ty~: LLVMTypeRef) -> U64
    fn LLVMArrayType2(elemTy~: LLVMTypeRef, count~: U64) -> LLVMTypeRef
    fn LLVMBuildStructGEP2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, idx~: U64, name~: CPtr[U8]) -> LLVMValueRef
    // count is the C API's `unsigned`; declared U64 here because Plew has no
    // narrowing `as` yet (an Array.count() is U64). Safe on LP64 (arm64/x86-64):
    // the callee reads the low 32 bits, and our counts are tiny. Revisit once
    // integer narrowing (wrapping / TryFrom) lands.
    fn LLVMFunctionType(ret~: LLVMTypeRef, params~: CPtr[LLVMTypeRef], count~: U64, isVarArg~: I32) -> LLVMTypeRef

    fn LLVMIsAFunction(value~: LLVMValueRef) -> U64
    fn LLVMCountParamTypes(functionType~: LLVMTypeRef) -> U64
    fn LLVMGetParamTypes(functionType~: LLVMTypeRef, parameters~: CPtr[LLVMTypeRef])
    fn LLVMGetReturnType(functionType~: LLVMTypeRef) -> LLVMTypeRef
    fn LLVMGetNamedFunction(module~: LLVMModuleRef, name~: CPtr[U8]) -> U64
    fn LLVMGetValueName(value~: LLVMValueRef) -> CPtr[U8]
    fn LLVMCreateTypeAttribute(context~: LLVMContextRef, kind~: U32, valueType~: LLVMTypeRef) -> LLVMAttributeRef
    fn LLVMAddCallSiteAttribute(call~: LLVMValueRef, index~: U32, attribute~: LLVMAttributeRef)
    fn LLVMGetBasicBlockParent(block~: LLVMBasicBlockRef) -> LLVMValueRef
    fn LLVMGetFirstInstruction(block~: LLVMBasicBlockRef) -> U64
    fn LLVMPositionBuilder(builder~: LLVMBuilderRef, block~: LLVMBasicBlockRef, instruction~: U64)

    // Functions / basic blocks / params.
    fn LLVMAddFunction(m~: LLVMModuleRef, name~: CPtr[U8], fnTy~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMGetParam(func~: LLVMValueRef, index~: U64) -> LLVMValueRef
    fn LLVMAppendBasicBlockInContext(ctx~: LLVMContextRef, func~: LLVMValueRef, name~: CPtr[U8]) -> LLVMBasicBlockRef

    // ASan gate (`--asan`): target triple + `sanitize_address` on every defined fn.
    type LLVMAttributeRef
    fn LLVMSetTarget(m~: LLVMModuleRef, triple~: CPtr[U8])
    fn LLVMGetDefaultTargetTriple() -> CPtr[U8]
    fn LLVMGetEnumAttributeKindForName(name~: CPtr[U8], len~: U64) -> U32
    fn LLVMCreateEnumAttribute(ctx~: LLVMContextRef, kindID~: U32, val~: U64) -> LLVMAttributeRef
    // The function-iteration handles are opaque pointers. libLLVM signals "no more"
    // by returning a NULL pointer, which LLVMIsNull (a null-CONSTANT test) can't
    // detect — so we thread the handle as U64 (pointer-as-integer, ABI-identical on
    // LP64, same convention as the `count~: U64` bindings above) and stop on `== 0`.
    fn LLVMGetValueName2(value~: LLVMValueRef, length~: CPtr[U64]) -> CPtr[U8]
    fn LLVMGetFirstFunction(m~: LLVMModuleRef) -> U64
    fn LLVMGetNextFunction(func~: U64) -> U64
    fn LLVMIsDeclaration(func~: U64) -> I32
    fn LLVMCountBasicBlocks(func~: LLVMValueRef) -> U32
    fn LLVMSetLinkage(global~: LLVMValueRef, linkage~: U32)
    fn LLVMAddAttributeAtIndex(func~: U64, idx~: U32, attr~: LLVMAttributeRef)

    // Constants / introspection.
    fn LLVMConstInt(ty~: LLVMTypeRef, n~: U64, signExtend~: I32) -> LLVMValueRef
    fn LLVMConstIntToPtr(value~: LLVMValueRef, type~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMConstNull(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMIsNull(v~: LLVMValueRef) -> I32
    fn LLVMSizeOf(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMBuildGEP2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, indices~: CPtr[LLVMValueRef], numIndices~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMTypeOf(v~: LLVMValueRef) -> LLVMTypeRef
    fn LLVMGetIntTypeWidth(ty~: LLVMTypeRef) -> U32
    fn LLVMGetTypeKind(ty~: LLVMTypeRef) -> U32
    fn LLVMStructGetTypeAtIndex(structTy~: LLVMTypeRef, i~: U32) -> LLVMTypeRef

    // Builder + instructions.
    fn LLVMCreateBuilderInContext(ctx~: LLVMContextRef) -> LLVMBuilderRef
    fn LLVMDisposeBuilder(builder~: LLVMBuilderRef)
    fn LLVMPositionBuilderAtEnd(b~: LLVMBuilderRef, bb~: LLVMBasicBlockRef)
    fn LLVMGetInsertBlock(b~: LLVMBuilderRef) -> LLVMBasicBlockRef
    fn LLVMBuildRet(b~: LLVMBuilderRef, v~: LLVMValueRef) -> LLVMValueRef
    fn LLVMBuildRetVoid(b~: LLVMBuilderRef) -> LLVMValueRef
    fn LLVMBuildCall2(b~: LLVMBuilderRef, fnTy~: LLVMTypeRef, func~: LLVMValueRef, args~: CPtr[LLVMValueRef], numArgs~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAdd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSub(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildMul(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFAdd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFSub(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFMul(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFNeg(b~: LLVMBuilderRef, v~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFCmp(b~: LLVMBuilderRef, pred~: U32, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSRem(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildUDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildURem(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildLShr(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildNeg(b~: LLVMBuilderRef, v~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildNot(b~: LLVMBuilderRef, v~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAnd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildOr(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildXor(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildShl(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAShr(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildICmp(b~: LLVMBuilderRef, pred~: U32, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSelect(b~: LLVMBuilderRef, cond~: LLVMValueRef, thenV~: LLVMValueRef, elseV~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildZExt(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSIToFP(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildUIToFP(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFPToSI(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFPToUI(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSExt(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildTrunc(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAlloca(b~: LLVMBuilderRef, ty~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMGetEntryBasicBlock(fn~: LLVMValueRef) -> LLVMBasicBlockRef
    fn LLVMGetBasicBlockTerminator(bb~: LLVMBasicBlockRef) -> LLVMValueRef
    fn LLVMPositionBuilderBefore(b~: LLVMBuilderRef, instr~: LLVMValueRef)
    fn LLVMBuildLoad2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildStore(b~: LLVMBuilderRef, v~: LLVMValueRef, ptr~: LLVMValueRef) -> LLVMValueRef
    fn LLVMBuildBr(b~: LLVMBuilderRef, dest~: LLVMBasicBlockRef) -> LLVMValueRef
    fn LLVMBuildCondBr(b~: LLVMBuilderRef, cond~: LLVMValueRef, thenBB~: LLVMBasicBlockRef, elseBB~: LLVMBasicBlockRef) -> LLVMValueRef
    fn LLVMBuildUnreachable(b~: LLVMBuilderRef) -> LLVMValueRef
    fn LLVMBuildSwitch(b~: LLVMBuilderRef, v~: LLVMValueRef, elseBB~: LLVMBasicBlockRef, numCases~: U32) -> LLVMValueRef
    fn LLVMAddCase(switch~: LLVMValueRef, onVal~: LLVMValueRef, dest~: LLVMBasicBlockRef)
    fn LLVMBuildPhi(b~: LLVMBuilderRef, ty~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMAddIncoming(phi~: LLVMValueRef, vals~: CPtr[LLVMValueRef], blocks~: CPtr[LLVMBasicBlockRef], count~: U64)

    // Aggregates / globals (String = {ptr, i64}).
    fn LLVMGetUndef(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMBuildInsertValue(b~: LLVMBuilderRef, agg~: LLVMValueRef, elt~: LLVMValueRef, index~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildExtractValue(b~: LLVMBuilderRef, agg~: LLVMValueRef, index~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildGlobalStringPtr(b~: LLVMBuilderRef, str~: CPtr[U8], name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMAddGlobal(m~: LLVMModuleRef, ty~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMSetInitializer(global~: LLVMValueRef, val~: LLVMValueRef)
    fn LLVMSetGlobalConstant(global~: LLVMValueRef, isConstant~: I32)
    fn LLVMConstArray2(elemTy~: LLVMTypeRef, vals~: CPtr[LLVMValueRef], count~: U64) -> LLVMValueRef
    fn LLVMSetAlignment(v~: LLVMValueRef, bytes~: U32)
}

part ./Backend/Llvm

// ---- checked arithmetic (overflow / divide-by-zero panic) ----
//
// add/sub/mul/div/rem route through the runtime `plew_<w><Op>` helpers (which
// panic on overflow / div-by-zero), matching the C backend's checked floor
// (spec/12: overflow and 0-division always panic; wrapping is opt-in). Bitwise,
// shift, and comparison ops have no overflow and stay raw (buildBinOpS). The
// wrapping* methods deliberately keep calling buildBinOpS (no check).
// Width bucket 0..3 for an 8/16/32/64-bit integer type.
fn llvmWidthIdx(w: U32) -> U64 {
    if w <= 8U32 { return 0U64 }
    if w <= 16U32 { return 1U64 }
    if w <= 32U32 { return 2U64 }
    return 3U64
}

// "Add"/"Sub"/"Mul"/"Div"/"Rem" bytes for an op (callers guard to these ops).
fn checkedOpName(op: I64) -> Array[U8] {
    if op == opAdd() { return "Add".bytes() }
    if op == opSub() { return "Sub".bytes() }
    if op == opMul() { return "Mul".bytes() }
    if op == opDiv() { return "Div".bytes() }
    return "Rem".bytes()
}

// "i8".."u64" prefix bytes (signedness + width) for a `plew_<prefix><Op>` symbol.
fn checkedPrefixBytes(unsigned: Bool, wi: U64) -> Array[U8] {
    mut val b: Array[U8] = []
    if unsigned { b.append(117) } else { b.append(105) }
    if wi == 0U64 {
        b.append(56)
        return b
    }
    if wi == 1U64 {
        b.append(49)
        b.append(54)
        return b
    }
    if wi == 2U64 {
        b.append(51)
        b.append(50)
        return b
    }
    b.append(54)
    b.append(52)
    return b
}

// The runtime symbol name for a checked binary op: `plew_<prefix><Op>`.
fn checkedFnName(op: I64, unsigned: Bool, wi: U64) -> String {
    mut val b: Array[U8] = "plew_".bytes()
    appendBytes(into: inout b, from: checkedPrefixBytes(unsigned: unsigned, wi: wi))
    appendBytes(into: inout b, from: checkedOpName(op: op))
    return stringFromBytesUnchecked(b)
}

fn isAsyncFn(c: inout Comp, fi: U64) -> Bool {
    return c.arena.functionAt(index: fi).isAsync
}

fn llvmIntEq() -> U32 { return 32U32 }

fn llvmIntNe() -> U32 { return 33U32 }

fn llvmIntSlt() -> U32 { return 40U32 }

fn llvmIntSle() -> U32 { return 41U32 }

fn llvmIntSgt() -> U32 { return 38U32 }

fn llvmIntSge() -> U32 { return 39U32 }

fn llvmIntUlt() -> U32 { return 36U32 }

fn llvmIntUle() -> U32 { return 37U32 }

fn llvmIntUgt() -> U32 { return 34U32 }

fn llvmIntUge() -> U32 { return 35U32 }

export fn nativeCpu() -> String {
    val name = LLVMGetHostCPUName()
    val cpu = stringFromCString(name)
    LLVMDisposeMessage(name)
    return cpu
}

// One owner keeps the context alive until its module has been consumed. Native
// output may mutate the module, but never takes ownership of either handle.
export unique struct LlvmModule {
    val context: LLVMContextRef
    val module: LLVMModuleRef
    deinit {
        LLVMDisposeModule(self.module)
        LLVMContextDispose(self.context)
    }
}
impl LlvmModule {
    factory owned(context: LLVMContextRef, module: LLVMModuleRef) {
        return <LlvmModule context=context module=module />
    }
}
pub impl LlvmModule {
    fn writeText(c: inout Comp) {
        tracePhase(c: inout c, label: "backend:print-module:start")
        val ir = LLVMPrintModuleToString(self.module)
        tracePhase(c: inout c, label: "backend:print-module:done")
        tracePhase(c: inout c, label: "backend:write:start")
        write(s: stringFromCString(ir))
        tracePhase(c: inout c, label: "backend:write:done")
        LLVMDisposeMessage(ir)
    }

    inout fn writeObject(output: String, cpu: String, trace: Bool) -> I32 {
        val outputPath = cString(output)
        val targetCpu = cString(cpu)
        val status = plew_llvm_emit_object(self.module, outputPath, targetCpu, if trace { give 1I32 } else { give 0I32 })
        cFree(targetCpu)
        cFree(outputPath)
        return status
    }
}

// Unique native resources cannot be generic arguments in Plew. This result
// owns the module directly, with the same exclusive lifetime as LlvmModule.
export unique enum LlvmLoweringResult {
    Success(module: LlvmModule)
    Failure(diagnostic: CompileDiagnostic)
}

export fn emitLlvm(c: inout Comp) -> Result[(), CompileDiagnostic] {
    match lowerLlvm(c: inout c) {
        LlvmLoweringResult.Success(module: val module) => {
            module.writeText(c: inout c)
            return <Result.Ok value=() />
        }
        LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
    }
}

export fn lowerLlvm(c: inout Comp) -> LlvmLoweringResult {
    tracePhase(c: inout c, label: "backend:emit:start")
    val prepared = match PreparedProgram.prepare(c: inout c) {
        Result.Ok(value: val program) => { give program }
        Result.Err(error: val error) => {
            return <LlvmLoweringResult.Failure diagnostic=programPreparationDiagnostic(c: inout c, error: error) />
        }
    }
    return lowerPreparedLlvm(c: inout c, prepared: prepared)
}

// The builder borrows a context and is released before the module owner.
unique struct LlvmBuilder {
    pub val handle: LLVMBuilderRef
    deinit { LLVMDisposeBuilder(self.handle) }
}
impl LlvmBuilder {
    factory owned(handle: LLVMBuilderRef) { return <LlvmBuilder handle=handle /> }
}

export fn lowerPreparedLlvm(c: inout Comp, prepared: PreparedProgram) -> LlvmLoweringResult {
    val ctx: LLVMContextRef = LLVMContextCreate()
    val m: LLVMModuleRef = LLVMModuleCreateWithNameInContext(cstr(s: "plew"), ctx)
    val module = <LlvmModule.owned context=ctx module=m />
    val builder = <LlvmBuilder.owned handle=LLVMCreateBuilderInContext(ctx) />
    // Layout-sensitive optimizers must use the same native ABI as the linker.
    val targetTriple = LLVMGetDefaultTargetTriple()
    LLVMSetTarget(m, targetTriple)
    LLVMDisposeMessage(targetTriple)
    val ptrty: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0U32)
    val i64ty: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
    mut val cloelems: Array[LLVMTypeRef] = []
    cloelems.append(ptrty)
    cloelems.append(ptrty)
    val closureTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(cloelems), 2U64, 0I32)
    // any P = { ptr data, ptr vtable } (fat pointer for existentials).
    mut val anyelems: Array[LLVMTypeRef] = []
    anyelems.append(ptrty)
    anyelems.append(ptrty)
    val anyTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(anyelems), 2U64, 0I32)
    // PlewPromise = { i32 done, i64 value, ptr waiterHead, ptr waiterTail } (ABI-identical to
    // the C runtime). Awaited values are type-erased through `value` (i64).
    mut val promelems: Array[LLVMTypeRef] = []
    promelems.append(LLVMInt32TypeInContext(ctx))
    promelems.append(i64ty)
    promelems.append(ptrty)
    promelems.append(ptrty)
    val promiseTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(promelems), 4U64, 0I32)
    mut val st: LlvmCtx = <LlvmCtx
        ctx=ctx mod=m b=builder.handle ambientProgram=prepared.ambient
        midProgram=prepared.executable
        i1ty=LLVMInt1TypeInContext(ctx) i8ty=LLVMInt8TypeInContext(ctx) i16ty=LLVMInt16TypeInContext(ctx)
        i32ty=LLVMInt32TypeInContext(ctx) i64ty=i64ty f64ty=LLVMDoubleTypeInContext(ctx)
        voidty=LLVMVoidTypeInContext(ctx) ptrty=ptrty closureTy=closureTy anyTy=anyTy anyVtResolution=[] anyVtVal=[]
        curFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32) terminated=false midCoverageBodyIds=[] midCoverageFnIdxs=[] midCoverageKeys=[]
        curIsMain=false curRetVoid=true curRetTy=LLVMVoidTypeInContext(ctx) giveValue=LLVMConstInt(LLVMInt64TypeInContext(ctx), 0U64, 0I32) genEnumRefs=[] genEnumTys=[] genEnumDefs=[] selfStart=0 selfLen=0 expectedTy=0 curBodyMark=0 nLocals=0
        fnIdx=[] fnVal=[] fnTy=[] genFnK=[] genFnVal=[] genFnTy=[] genFnEmit=[] genMethVal=[] genMethTy=[] genMethBody=[]
        locStart=[] locLen=[] locPtr=[] locTy=[] locKind=[] locStructIdx=[] locIsArr=[] locElemTy=[] locElemKind=[] locTypeRef=[] locElemTypeRef=[] locOwned=[] locMoved=[] locCellHome=[] declId=[] declFn=[] declTy=[] closures=[] dropWitReg=[] dropWitVal=[] dropWitTy=[] retWitReg=[] retWitVal=[] retWitTy=[] enumRelWitReg=[] enumRelWitVal=[] enumRelWitTy=[] enumRetWitReg=[] enumRetWitVal=[] enumRetWitTy=[] dropWitDone=0 retWitDone=0 enumRelWitDone=0 enumRetWitDone=0 genMethEmit=[]
        promiseTy=promiseTy
        curFrameBase=LLVMConstNull(ptrty) curFrameTy=i64ty
        curResumeFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncSwitch=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        asyncFnIdx=[] asyncFrameTy=[] asyncResumeFn=[] asyncEntryIdx=[] asyncEntryVal=[] asyncEntryTy=[] loopBreakBB=[] loopContBB=[] loopUnwindMark=[] loopDepth=0 />

    tracePhase(c: inout c, label: "mid:program:ready")

    // a "self" byte span (appended past the source) to bind method receivers.
    st.selfStart = c.arena.bytes.count()
    c.appendSrc(from: "self".bytes())
    st.selfLen = 4U64

    match st.registerFinalLayoutNames(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    match st.registerFinalStructBodies(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    tracePhase(c: inout c, label: "backend:types:done")

    // pass 1: declare generic free-fn instances + generic method instances (one per
    // receiver instantiation). Non-generic free/assoc fns and methods are no longer
    // eagerly declared — each reachable free-function body is declared from its frozen
    // BodyInstance, while receiver methods use their corresponding body identity.
    match st.declareGenFns(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    match st.declareGenMethods(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    // async fns: build each frame struct + resume fn, and a non-main entry symbol
    // in the fnIdx table (so a call `doubler(x: 21)` resolves to a promise-returning
    // call). Done before bodies emit so main's resume can call them.
    match st.declareAsyncFns(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    // declare lambda-lifted closures (after the named types + functions they may
    // reference exist), so a closure literal can build its {fn, env} value.
    match st.collectClosures(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    tracePhase(c: inout c, label: "backend:declarations:done")

    // module-level variables (spec/15): emit `plew_init_globals` (one body that runs
    // every global's initializer once) and record each global's metadata, BEFORE any
    // function body so `seedGlobals` can re-bind them at every body entry. Done after
    // pass-1 declarations so an initializer may call a user function.
    match st.genLlvmInitGlobals(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    tracePhase(c: inout c, label: "backend:globals:done")

    // pass 2: emit `main` and every plain user function's body.
    mut val fi: U64 = 0
    mut val foundMain: Bool = false
    while fi < c.arena.functionCount() {
        // gen mode (spec/16): the program is the synthesized harness main at
        // `genMainIdx`; the user's own `main` is dead (it calls macro-generated
        // functions that don't exist in this build), so it is neither the entry
        // main nor a plain fn. Treat only genMainIdx as main here.
        mut val isMainFn: Bool = c.nameIsMain(f: c.arena.functionAt(index: fi))
        if c.genMode {
            if isMainFn {
                if fi != c.genMainIdx {
                    isMainFn = false
                }
            }
        }
        if isMainFn {
            // an `async fn main` is lowered with the rest of the async fns (entry +
            // resume + drain the event loop); a plain main is the synchronous shape.
            if !(isAsyncFn(c: inout c, fi: fi)) {
                match st.genLlvmMain(c: inout c, fi: fi) {
                    Result.Ok(value: _) => {}
                    Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
                }
            }
            foundMain = true
        }
        // every other function is emitted lazily on first reach (gf/gm) via the pass-2
        // drain below — nothing to emit eagerly here. (A gen-mode dead user main, which
        // calls macro-generated functions absent from this build, is simply never reached.)
        fi += 1
    }
    tracePhase(c: inout c, label: "backend:entry:done")
    // async fn entry + resume bodies (main's entry drains the loop).
    match st.emitAsyncFns(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    tracePhase(c: inout c, label: "backend:async:done")
    // generic-method instance bodies. Free-function bodies drain through the same fixed
    // finalized queue below.
    match st.emitGenMethods(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    tracePhase(c: inout c, label: "backend:generic-methods:done")
    // `emitGenMethods` has consumed every slot available through main/async
    // emission. Closure bodies are emitted next and may enqueue additional
    // methods; remember this boundary before they run so the fixpoint drains
    // precisely those new slots rather than either skipping them or replaying
    // an already-emitted LLVM body.
    mut val genmDone: U64 = st.genMethEmit.count()
    // lambda-lifted closure bodies. Named-function-value thunks stay empty in v1 because
    // named declarations are not first-class values.
    match st.emitClosures(c: inout c) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
    }
    tracePhase(c: inout c, label: "backend:closures-thunks:done")
    // provided trait methods + lazily-declared std/generic methods reached during
    // the passes above. Both queues can grow as bodies emit (a provided body calls
    // a std generic method, a generic body reaches a provided one), so drain to a
    // fixpoint: loop until neither queue advances.
    // emitGenMethods above already emitted every slot that existed at that
    // point, including on-demand slots queued while main/async bodies were
    // emitted.  Start the incremental queue cursor after those entries: replaying
    // them appended a second unreachable body to the same LLVM function and let
    // a shared provided-method AST observe another instance's ambient state.
    mut val genfDone: U64 = 0
    mut val draining: Bool = true
    tracePhase(c: inout c, label: "backend:drain:start")
    mut val drainRound: U64 = 0U64
    while draining {
        tracePhaseProgress(c: inout c, label: "backend:drain:round", count: drainRound, stride: 1U64)
        tracePhaseProgress(c: inout c, label: "backend:drain:generic-method-queued", count: st.genMethEmit.count(), stride: 16U64)
        tracePhaseProgress(c: inout c, label: "backend:drain:generic-function-queued", count: st.genFnEmit.count(), stride: 16U64)
        while genmDone < st.genMethEmit.count() {
            tracePhaseProgress(c: inout c, label: "backend:drain:generic-method-emitting", count: genmDone, stride: 16U64)
            match st.emitOneGenMethod(c: inout c, slot: st.genMethEmit[genmDone]) {
                Result.Ok(value: _) => {}
                Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
            }
            genmDone += 1
        }
        // Free-function bodies were all declared from the frozen closure. Keep the queue
        // drain separate from method/witness drains for ABI order, not source discovery.
        while genfDone < st.genFnEmit.count() {
            tracePhaseProgress(c: inout c, label: "backend:drain:generic-function-emitting", count: genfDone, stride: 16U64)
            match st.emitOneGenFn(c: inout c, slot: st.genFnEmit[genfDone]) {
                Result.Ok(value: _) => {}
                Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
            }
            genfDone += 1
        }
        // per-type drop/retain/copy-witness bodies (declared on demand at drop sites). A
        // witness body's deinit call is now a `gm` instance (B3-2), which queues onto
        // genMethEmit — so emitWitnessBodies must run INSIDE this fixpoint loop, not after it,
        // or those deinit method bodies would be declared but never emitted (link error).
        match st.emitClosureEnvironmentDrops(c: inout c) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
        }
        match st.emitExistentialWitnesses(c: inout c) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
        }
        match st.emitWitnessBodies(c: inout c) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <LlvmLoweringResult.Failure diagnostic=diagnostic /> }
        }
        tracePhaseProgress(c: inout c, label: "backend:drain:generic-method-after-witness", count: st.genMethEmit.count(), stride: 16U64)
        tracePhaseProgress(c: inout c, label: "backend:drain:generic-function-after-witness", count: st.genFnEmit.count(), stride: 16U64)
        if genmDone >= st.genMethEmit.count() && genfDone >= st.genFnEmit.count() && st.existentialWitnessesEmitted >= st.existentialWitnesses.count() && st.closureEnvironmentDropsEmitted >= st.closureEnvironmentDrops.count() {
            draining = false
        }
        drainRound += 1U64
    }
    tracePhase(c: inout c, label: "backend:drain:done")
    if !(foundMain) {
        return <LlvmLoweringResult.Failure diagnostic=<CompileDiagnostic location=<DiagnosticLocation.Line line=0I64 /> message="LLVM backend: no `main` function found" /> />
    }

    // `--asan`: a normal `.ll` carries no `sanitize_address`
    // attribute, so a downstream `opt -passes=asan` instruments NOTHING (the asan
    // pass skips every function that lacks the attribute — the old gate then only
    // exercised the free/double-free interceptor layer and missed raw load/store
    // UAF). The module already has its native target; mark every DEFINED function so the pass
    // actually instruments memory accesses. Declarations (runtime externs) are left
    // untouched — they carry no body and are compiled/instrumented by clang.
    if c.asan {
        val kind: U32 = LLVMGetEnumAttributeKindForName(cstr(s: "sanitize_address"), 16U64)
        val attr: LLVMAttributeRef = LLVMCreateEnumAttribute(st.ctx, kind, 0U64)
        // LLVMAttributeFunctionIndex (~0u) targets the function itself, not a param.
        val fnIndex: U32 = 4294967295U32
        mut val fh: U64 = LLVMGetFirstFunction(st.mod)
        while fh != 0U64 {
            if LLVMIsDeclaration(fh) == 0I32 {
                LLVMAddAttributeAtIndex(fh, fnIndex, attr)
            }
            fh = LLVMGetNextFunction(fh)
        }
    }
    if c.emitMidCoverage || c.requireMid {
        mut val coverage: U64 = 0U64
        while coverage < st.midCoverageBodyIds.count() {
            st.emitMidCoverageRecord(c: inout c, bodyId: st.midCoverageBodyIds[coverage], fnIdx: st.midCoverageFnIdxs[coverage], key: st.midCoverageKeys[coverage])
            coverage += 1U64
        }
        if c.requireMid && st.midCoverageBodyIds.count() != 0U64 {
            return <LlvmLoweringResult.Failure diagnostic=<CompileDiagnostic location=<DiagnosticLocation.Line line=0I64 /> message="LLVM backend: required Mid coverage is incomplete" /> />
        }
    }
    return <LlvmLoweringResult.Success module=move module />
}

// A unique, stable LLVM symbol for the module-level variable at lowering index `idx`
// ("plew.g.<idx>"), so a same-named user local never collides with the global symbol.
fn globalSymbol(idx: U64) -> String {
    mut val s: Array[U8] = []
    appendBytes(into: inout s, from: "plew.g.".bytes())
    appendU64Dec(into: inout s, n: idx)
    return stringFromBytesUnchecked(s)
}

fn refIsAny(c: inout Comp, ref: U64) -> Bool {
    if ref < c.arena.typeCount() {
        return c.arena.typeAt(index: ref).isAny
    }
    return false
}

// Is this type name an unsigned integer (for choosing signed vs unsigned ops /
// formatting)? Defaults to signed.
fn isUnsignedName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U64") { return true }
    return false
}

fn concatArgs(add: Array[U64], base: Array[U64]) -> Array[U64] {
    mut val r: Array[U64] = []
    mut val i: U64 = 0
    while i < add.count() { r.append(add[i])  i += 1 }
    mut val j: U64 = 0
    while j < base.count() { r.append(base[j])  j += 1 }
    return r
}

// Element-wise structural equality of two type-argument lists.
fn typeArgsEq(c: inout Comp, a: Array[U64], b: Array[U64]) -> Bool {
    if a.count() != b.count() {
        return false
    }
    mut val i: U64 = 0
    while i < a.count() {
        if !(c.typeRefEq(a: a[i], b: b[i])) {
            return false
        }
        i += 1
    }
    return true
}

// Append the decimal digits of n to a byte buffer (for synthetic symbol names).
// Uses digitStrU's per-digit String (its bytes are U8) to avoid a U64->U8 narrow,
// which Plew's lossless `as` does not allow.
fn appendU64Dec(into: inout Array[U8], n: U64) {
    if n >= 10U64 {
        appendU64Dec(into: inout into, n: n / 10U64)
    }
    appendBytes(into: inout into, from: digitStrU(d: n % 10U64).bytes())
}

// Append the 8 little-endian bytes of `n` as i8 constants (for a rawbuf-shaped global's
// i64 cap/rc header, built as a flat i8 array constant).
fn appendU64Le(into: inout Array[LLVMValueRef], n: U64, i8ty: LLVMTypeRef) {
    mut val k: U64 = 0
    while k < 8U64 {
        into.append(LLVMConstInt(i8ty, (n >> (k * 8U64)) & 255U64, 0I32))
        k += 1
    }
}

// Find the registered free-function slot for one frozen executable body, or count.
// Unlike the old `(fnIdx, args, receiver)` lookup, this cannot collapse two provided
// bodies that share source syntax but carry different conformance evidence.
fn genFnSlotForBody(bodyId: U64, st: inout LlvmCtx) -> U64 {
    mut val slot: U64 = 0
    while slot < st.genFnK.count() {
        if st.genFnK[slot] == bodyId { return slot }
        slot += 1
    }
    return st.genFnK.count()
}

fn wOvf(p: String, ct: String, name: String, bi: String) {
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: name)
    write(s: "(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ ")
    write(s: ct)
    write(s: " r; if(")
    write(s: bi)
    write(s: "(a,b,&r)) plew_panic_raw(\"integer overflow\",16); return r; }\n")
}

// The checked integer helpers for one width-prefix `p` / C-type `ct` (signed min
// `mn`, `sgn` = signed). Add/Sub/Mul overflow-panic, Div/Rem div-by-zero-panic
// (+ signed INT_MIN/-1 overflow), and signed widths also get a checked Neg.
fn wLlvmChecked(p: String, ct: String, mn: String, sgn: Bool) {
    wOvf(p: p, ct: ct, name: "Add", bi: "__builtin_add_overflow")
    wOvf(p: p, ct: ct, name: "Sub", bi: "__builtin_sub_overflow")
    wOvf(p: p, ct: ct, name: "Mul", bi: "__builtin_mul_overflow")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "Div(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ if(b==0) plew_panic_raw(\"division by zero\",16); ")
    if sgn {
        write(s: "if(b==-1 && a==")
        write(s: mn)
        write(s: ") plew_panic_raw(\"integer overflow\",16); ")
    }
    write(s: "return a/b; }\n")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "Rem(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ if(b==0) plew_panic_raw(\"remainder by zero\",17); ")
    if sgn {
        write(s: "if(b==-1) return 0; ")
    }
    write(s: "return a%b; }\n")
    if sgn {
        write(s: ct)
        write(s: " plew_")
        write(s: p)
        write(s: "Neg(")
        write(s: ct)
        write(s: " a){ ")
        write(s: ct)
        write(s: " r; if(__builtin_sub_overflow((")
        write(s: ct)
        write(s: ")0,a,&r)) plew_panic_raw(\"integer overflow\",16); return r; }\n")
    }
}

// All width-prefixed checked integer helpers (i8..i64 signed, u8..u64 unsigned).
fn emitLlvmIntChecked() {
    wLlvmChecked(p: "i8", ct: "int8_t", mn: "INT8_MIN", sgn: true)
    wLlvmChecked(p: "i16", ct: "int16_t", mn: "INT16_MIN", sgn: true)
    wLlvmChecked(p: "i32", ct: "int32_t", mn: "INT32_MIN", sgn: true)
    wLlvmChecked(p: "i64", ct: "int64_t", mn: "INT64_MIN", sgn: true)
    wLlvmChecked(p: "u8", ct: "unsigned char", mn: "", sgn: false)
    wLlvmChecked(p: "u16", ct: "uint16_t", mn: "", sgn: false)
    wLlvmChecked(p: "u32", ct: "uint32_t", mn: "", sgn: false)
    wLlvmChecked(p: "u64", ct: "uint64_t", mn: "", sgn: false)
}

export fn emitLlvmRuntime() {
    write(s: "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <sys/wait.h>\n")
    write(s: "void plew_exit(long long code){ exit((int)code); }\n")
    write(s: "void plew_write_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); }\n")
    write(s: "void plew_eprint_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stderr); }\n")
    // panic = abort (spec/11 "panic と発散"): print the message, then trap — no
    // unwind, no exit-time flushing/handlers, no deinit. Every runtime panic
    // funnels through this one kernel so the termination style cannot drift.
    write(s: "__attribute__((noreturn)) void plew_panic_raw(const char* d, long long n){ fputs(\"panic: \",stderr); fwrite(d,1,(size_t)n,stderr); fputc('\\n',stderr); abort(); }\n")
    // print(x) formatters (textual form + newline), matching the Plew Format impls.
    write(s: "void plew_print_str(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); fputc('\\n',stdout); }\n")
    write(s: "void plew_print_i64(long long v){ printf(\"%lld\\n\", v); }\n")
    write(s: "void plew_print_f64(double v){ printf(\"%g\\n\", v); }\n")
    write(s: "void plew_print_u64(unsigned long long v){ printf(\"%llu\\n\", v); }\n")
    write(s: "void plew_print_bool(long long v){ fputs(v?\"1\":\"0\",stdout); fputc('\\n',stdout); }\n")
    write(s: "long long plew_str_eq(const char* a, long long na, const char* b, long long nb){ if(na!=nb) return 0; for(long long i=0;i<na;i++) if(a[i]!=b[i]) return 0; return 1; }\n")
    // C1: a String VALUE is the rawbuf data pointer (count in the heap header), so the
    // runtime's String-returning intrinsics return `char*` (the data pointer) after stamping
    // the live length into the header via plew_rawbuf_set_count. String buffers are rawbuf-
    // shaped: plew_str_buf(n) gives an n+1-byte rawbuf (rc=1, freeable, count to be set by the
    // caller); plew_str_empty is a shared never-free (sentinel rc) count=0 empty. (forward-decl
    // rawbuf_alloc / set_count, defined below.)
    write(s: "void* plew_rawbuf_alloc(long long elemSize, long long cap);\n")
    write(s: "void plew_rawbuf_set_count(void* p, long long n);\n")
    write(s: "static char* plew_str_buf(long long n){ return (char*)plew_rawbuf_alloc(1, n+1); }\n")
    write(s: "static char* plew_str_empty(void){ static char* e=0; if(!e){ e=(char*)plew_rawbuf_alloc(1,1); e[0]=0; ((long long*)e)[-1]=(long long)1<<62; } return e; }\n")
    write(s: "char* plew_f64_to_str(double v){ char buf[32]; int n=snprintf(buf,32,\"%g\",v); char* b=plew_str_buf(n); memcpy(b,buf,(size_t)n); b[n]=0; plew_rawbuf_set_count(b,(long long)n); return b; }\n")
    write(s: "void plew_f64_nan_check(double a, double b){ if(a!=a || b!=b) plew_panic_raw(\"NaN comparison\",14); }\n")
    write(s: "char* plew_readStdin(void){ size_t cap=4096,len=0; char* buf=(char*)malloc(cap); int ch; while((ch=getchar())!=EOF){ if(len+1>=cap){cap*=2;buf=(char*)realloc(buf,cap);} buf[len++]=(char)ch; } char* b=plew_str_buf((long long)len); if(len) memcpy(b,buf,len); b[len]=0; free(buf); plew_rawbuf_set_count(b,(long long)len); return b; }\n")
    // FFI String <-> C-string (spec/15): cString materializes a NUL-terminated copy
    // (caller-owned; cFree releases it — CString's deinit is the canonical caller);
    // stringFromCString copies a NUL-terminated C string.
    write(s: "unsigned char* plew_cString(char* d, long long n){ unsigned char* b=(unsigned char*)malloc((size_t)n+1); if(n) memcpy(b,d,(size_t)n); b[n]=0; return b; }\n")
    write(s: "void plew_cFree(unsigned char* p){ free(p); }\n")
    write(s: "char* plew_stringFromCString(unsigned char* p){ if(!p) return plew_str_empty(); size_t n=strlen((const char*)p); char* b=plew_str_buf((long long)n); memcpy(b,p,n); b[n]=0; plew_rawbuf_set_count(b,(long long)n); return b; }\n")
    // Array / Buffer storage floor (a [cap][count][rc][data...] block). The pointer is
    // the data; three header words sit before it: cap=[-3], count=[-2], rc=[-1]. `count`
    // is the floor's own live-element count — the Buffer intrinsics maintain it; the
    // legacy Array path tracks count in its {ptr,i64} value and leaves this slot 0.
    // alloc seeds count=0, rc=1; binding an array eager-copies (arr_copy), so an array
    // buffer is sole-owned (rc==1, never retained — only `Ref` cells are). grow therefore
    // FREES the buffer it replaces on realloc (guarded by rc<=1 — a shared buffer is left
    // alone, leak-safe), reclaiming the geometric-growth intermediates an append chain
    // would otherwise leak. per-element load/store is inlined in IR via typed GEP.
    write(s: "void* plew_rawbuf_alloc(long long elemSize, long long cap){ long long* h=(long long*)malloc(3*sizeof(long long)+(size_t)(elemSize*cap)); h[0]=cap; h[1]=0; h[2]=1; return (void*)(h+3); }\n")
    write(s: "long long plew_rawbuf_cap(void* p){ return p?((long long*)p)[-3]:0; }\n")
    // header `count` accessors (the Buffer floor's live-element count).
    write(s: "long long plew_rawbuf_count(void* p){ return p?((long long*)p)[-2]:0; }\n")
    write(s: "void plew_rawbuf_set_count(void* p, long long n){ if(p) ((long long*)p)[-2]=n; }\n")
    write(s: "void* plew_arr_grow(void* data, long long elemSize, long long count){ long long cap=plew_rawbuf_cap(data); if(count<cap) return data; long long nc=cap<8?8:cap*2; void* nd=plew_rawbuf_alloc(elemSize,nc); if(count){ memcpy(nd,data,(size_t)(elemSize*count)); ((long long*)nd)[-2]=((long long*)data)[-2]; } if(data){ if(((long long*)data)[-1]<=1) free((long long*)data-3); else ((long long*)data)[-1]--; } return nd; }\n")
    write(s: "void* plew_arr_copy(void* data, long long elemSize, long long count){ void* nd=plew_rawbuf_alloc(elemSize,count<1?1:count); if(count){ memcpy(nd,data,(size_t)(elemSize*count)); ((long long*)nd)[-2]=((long long*)data)[-2]; } return nd; }\n")
    write(s: "void plew_rawbuf_retain(void* p){ if(p) ((long long*)p)[-1]++; }\n")
    write(s: "long long plew_rawbuf_release(void* p){ if(!p) return 0; return --((long long*)p)[-1]; }\n")
    // drop one owner: decrement the refcount, free the cell at 0. The sentinel rc
    // (1<<62, string literals / shared empty string) never reaches 0.
    write(s: "void plew_rawbuf_drop(void* p){ if(!p) return; if(--((long long*)p)[-1]==0) free((long long*)p-3); }\n")
    // free a rawbuf cell unconditionally (the caller has already established rc reached 0
    // and released the element heap); a null / sentinel-rc cell is left alone.
    write(s: "void plew_rawbuf_free(void* p){ if(!p) return; if(((long long*)p)[-1]>((long long)1<<61)) return; free((long long*)p-3); }\n")
    // `Ref`/`WeakRef` two-counter control block (spec/03): the cell reuses the rawbuf
    // header — strong = [-1] (init 1), weak = [-2] (init 0, the unused Buffer `count` slot).
    // weak()  : bump the weak count, return the same cell as a `WeakRef` handle.
    write(s: "void* plew_ref_weak(void* p){ if(p) ((long long*)p)[-2]++; return p; }\n")
    // upgrade(): if the pointee is still alive (strong>0) take a new strong owner and return
    // the cell (a `Ref`); else return null (the pointee was destroyed) → `Optional.None`.
    write(s: "void* plew_ref_upgrade(void* p){ if(p && ((long long*)p)[-1]>0){ ((long long*)p)[-1]++; return p; } return 0; }\n")
    // alive(): the current strong count (0 once the pointee was destroyed) — `weakAlive` tests
    // `> 0` to decide upgrade's Some/None without taking an owner.
    write(s: "long long plew_ref_strong(void* p){ return p ? ((long long*)p)[-1] : 0; }\n")
    // strong release reached 0 (pointee deinit已 run by codegen): free the cell ONLY when no
    // weak observers remain; otherwise keep the allocation so a later upgrade reads strong==0.
    write(s: "void plew_ref_dispose_strong(void* p){ if(!p) return; if(((long long*)p)[-2]==0) free((long long*)p-3); }\n")
    // drop one weak observer: decrement the weak count; free the cell when it is the last
    // reference of either kind (weak==0 AND strong already 0 — the pointee is long gone).
    write(s: "void plew_weak_release(void* p){ if(!p) return; if(--((long long*)p)[-2]==0 && ((long long*)p)[-1]==0) free((long long*)p-3); }\n")
    // copy-on-write a (scalar-element) array buffer before an in-place mutation: if the
    // buffer is shared (rc>1), allocate a private rc=1 copy of `count` elements, drop one
    // owner from the shared original, and return the copy; otherwise return it unchanged.
    write(s: "void* plew_arr_cow(void* data, long long elemSize, long long count){ if(data && ((long long*)data)[-1]>1){ void* nd=plew_rawbuf_alloc(elemSize,count<1?1:count); if(count){ memcpy(nd,data,(size_t)(elemSize*count)); ((long long*)nd)[-2]=((long long*)data)[-2]; } ((long long*)data)[-1]--; return nd; } return data; }\n")
    // grow a buffer's capacity to at least `mincap` (reserve), preserving the live
    // elements + count; a no-op when cap already suffices. The caller has privatized
    // (rc<=1), so the old cell is freed when reallocated.
    write(s: "void* plew_arr_reserve(void* data, long long elemSize, long long mincap){ long long cap=plew_rawbuf_cap(data); if(cap>=mincap) return data; void* nd=plew_rawbuf_alloc(elemSize,mincap); long long cnt=plew_rawbuf_count(data); if(cnt){ memcpy(nd,data,(size_t)(elemSize*cnt)); ((long long*)nd)[-2]=cnt; } if(data){ if(((long long*)data)[-1]<=1) free((long long*)data-3); else ((long long*)data)[-1]--; } return nd; }\n")
    // relocate `n` element slots within a buffer (insertAt/removeAt shift). A pure byte
    // move: each element's inline bytes (incl any heap reference) move intact, so no
    // element retain/release is needed (buffer-floor.md §5 relocation = memmove).
    write(s: "void plew_rawbuf_move(void* data, long long elemSize, long long dst, long long src, long long n){ if(n>0) memmove((char*)data+(size_t)(elemSize*dst),(char*)data+(size_t)(elemSize*src),(size_t)(elemSize*n)); }\n")
    write(s: "void plew_bounds(long long i, long long n){ if(i<0||i>=n) plew_panic_raw(\"index out of bounds\",19); }\n")
    // overlapping `inout` (spec/03): two `inout` positions of one call resolved to the
    // SAME place at runtime (`arr[i]`/`arr[j]` with i==j, two Refs to one cell) — the
    // exclusivity the callee relies on does not hold, so panic loudly at the call.
    write(s: "void plew_inout_overlap(void* a, void* b){ if(a&&a==b) plew_panic_raw(\"overlapping inout: two inout positions of one call overlap in the same shared cell\",82); }\n")
    write(s: "void plew_read_inout_overlap(void* a, void* b){ if(a&&a==b) plew_panic_raw(\"overlapping borrow: read and inout access to the same shared cell\",65); }\n")
    write(s: "typedef struct PlewAccess { struct PlewAccess* previous; uint64_t kind; void* root; const uint64_t* path; uint64_t count; uint64_t writes; void* group; } PlewAccess;\nstatic _Thread_local PlewAccess* plew_access_head;\nvoid plew_access_check(uint64_t kind, void* root, const uint64_t* path, uint64_t count, uint64_t writes, void* permit) {\n    for (PlewAccess* access=plew_access_head; access; access=access->previous) {\n        if ((permit && access->group==permit) || access->kind!=kind || access->root!=root || !(writes || access->writes)) continue;\n        uint64_t length=count<access->count?count:access->count, index=0;\n        while(index<length && path[index]==access->path[index]) ++index;\n        if(index==length) { const char* message=\"overlapping access: borrowed storage accessed through an alias\"; plew_panic_raw(message,(long long)strlen(message)); }\n    }\n}\nvoid plew_access_begin(PlewAccess* access, uint64_t kind, void* root, const uint64_t* path, uint64_t count, uint64_t writes, void* group) {\n    plew_access_check(kind,root,path,count,writes,0);\n    *access=(PlewAccess){plew_access_head,kind,root,path,count,writes,group};\n    plew_access_head=access;\n}\nvoid plew_access_end(PlewAccess* access) {\n    if(plew_access_head!=access) { const char* message=\"invalid access scope\"; plew_panic_raw(message,(long long)strlen(message)); }\n    plew_access_head=access->previous;\n}\n")
    // checked integer arithmetic floor (overflow / divide-by-zero panic, spec/12):
    // the witness/compound paths call `plew_<w><Op>` instead of a raw IR op, so the
    // LLVM backend matches the C backend's loud overflow/div-zero behaviour.
    emitLlvmIntChecked()
    // ---- process args + file I/O (the path-taking intrinsics take (ptr,i64), so
    // no struct-by-value ABI is assumed; readers return a rawbuf data pointer). ----
    write(s: "static int plew_argc = 0; static char** plew_argv = 0;\n")
    write(s: "void plew_set_args(int argc, char** argv){ plew_argc = argc; plew_argv = argv; }\n")
    write(s: "long long plew_argCount(void){ return (long long)plew_argc; }\n")
    write(s: "char* plew_argAt(long long i){ if(i<0||i>=plew_argc) return plew_str_empty(); size_t n=strlen(plew_argv[i]); char* b=plew_str_buf((long long)n); memcpy(b,plew_argv[i],n); b[n]=0; plew_rawbuf_set_count(b,(long long)n); return b; }\n")
    write(s: "void plew_writeByte(unsigned char b){ putchar((int)b); }\n")
    write(s: "unsigned long long plew_random_u64(void){ unsigned long long x=0; FILE* f=fopen(\"/dev/urandom\",\"rb\"); if(f){ size_t r=fread(&x,sizeof(x),1,f); fclose(f); if(r==1) return x; } return ((unsigned long long)(uintptr_t)&x * 0x9E3779B97F4A7C15ULL) | 1ULL; }\n")
    write(s: "int plew_pointer_equal(const void* first, const void* second){ return first == second; }\n")
    write(s: "unsigned long long plew_dict_seed(void){ static unsigned long long s=0; static int init=0; if(!init){ s=plew_random_u64(); init=1; } return s; }\n")
    write(s: "static char* plew_readPath(const char* path){ FILE* f=fopen(path,\"rb\"); if(!f) return plew_str_empty(); fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char* buf=plew_str_buf((long long)sz); size_t n=fread(buf,1,(size_t)sz,f); fclose(f); buf[n]=0; plew_rawbuf_set_count(buf,(long long)n); return buf; }\n")
    write(s: "char* plew_readFile(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; char* r=plew_readPath(p); free(p); return r; }\n")
    write(s: "char* plew_readFileBytes(char* d, long long n){ return plew_readFile(d,n); }\n")
    write(s: "long long plew_fileExists(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; FILE* f=fopen(p,\"rb\"); free(p); if(f){ fclose(f); return 1; } return 0; }\n")
    // ---- process execution (spec/17 dep resolution: run `git` from a tool) ----
    // plew_execOut runs `sh -c <cmd>`, captures stdout, and stashes the child's
    // exit status in plew_last_exit (read via plew_execCode). One static holds the
    // status so both values cross the intrinsic boundary as plain scalars/String.
    write(s: "static long long plew_last_exit = 0;\n")
    write(s: "char* plew_execOut(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; FILE* f=popen(p,\"r\"); free(p); if(!f){ plew_last_exit=-1; return plew_str_empty(); } size_t cap=4096,len=0; char* buf=(char*)malloc(cap); size_t r; while((r=fread(buf+len,1,cap-len,f))>0){ len+=r; if(len==cap){ cap*=2; buf=(char*)realloc(buf,cap); } } int st=pclose(f); plew_last_exit=(long long)(WIFEXITED(st)?WEXITSTATUS(st):-1); char* ob=plew_str_buf((long long)len); if(len) memcpy(ob,buf,len); ob[len]=0; free(buf); plew_rawbuf_set_count(ob,(long long)len); return ob; }\n")
    write(s: "long long plew_execCode(void){ return plew_last_exit; }\n")
    // ---- async runtime (event loop / promises / timers) ----
    //
    // Runtime symbols have external linkage for the separate LLVM module.
    // Promise layout is { i32 done, i64 value, ptr waiterHead, ptr waiterTail }.
    // Pending activations retain their awaited handle; the promise owns only
    // waiter nodes, and transfers callbacks to the ready queue at completion.
    write(s: "typedef struct PlewPromise PlewPromise;\n")
    write(s: "typedef void (*PlewResumeFn)(void*);\n")
    write(s: "typedef struct PlewWaiter { PlewResumeFn fn; void* frame; struct PlewWaiter* next; } PlewWaiter;\nstruct PlewPromise { int done; long long value; PlewWaiter* head; PlewWaiter* tail; };\n")
    write(s: "typedef struct { PlewResumeFn fn; void* arg; } PlewTask;\n")
    write(s: "static PlewTask* plew_ready = 0; static long long plew_ready_len = 0, plew_ready_cap = 0, plew_ready_head = 0;\n")
    write(s: "static void plew_enqueue(PlewResumeFn fn, void* arg) { if (plew_ready_len == plew_ready_cap) { plew_ready_cap = plew_ready_cap ? plew_ready_cap * 2 : 16; plew_ready = (PlewTask*)realloc(plew_ready, (size_t)plew_ready_cap * sizeof(PlewTask)); } plew_ready[plew_ready_len].fn = fn; plew_ready[plew_ready_len].arg = arg; plew_ready_len++; }\n")
    write(s: "static int plew_dequeue(PlewTask* out) { if (plew_ready_head >= plew_ready_len) { plew_ready_head = 0; plew_ready_len = 0; return 0; } *out = plew_ready[plew_ready_head++]; return 1; }\n")
    write(s: "typedef struct { long long deadline; PlewPromise* p; } PlewTimer;\n")
    write(s: "static PlewTimer* plew_timers = 0; static long long plew_timers_len = 0, plew_timers_cap = 0; static long long plew_vnow = 0;\n")
    write(s: "void* plew_frame_alloc(long long sz) { return calloc(1, (size_t)sz); }\n")
    write(s: "void plew_frame_free(void* p) { free(p); }\n")
    // a promise is an rc'd rawbuf cell (header rc=1 = the creator's ownership): the async
    // fn's frame owns one count (released after the final resolve), the returned Promise
    // VALUE owns another (retained at the entry thunk's return; released by its binding's
    // scope-exit drop / awaited-temp drop), and a pending timer owns a third.
    write(s: "PlewPromise* plew_promise_new(void) { PlewPromise* p = (PlewPromise*)plew_rawbuf_alloc((long long)sizeof(PlewPromise), 1); p->done = 0; p->value = 0; p->head = 0; p->tail = 0; return p; }\n")
    write(s: "void plew_promise_await(PlewPromise* p, PlewResumeFn fn, void* frame) { if (p->done) { plew_enqueue(fn, frame); return; } PlewWaiter* w = (PlewWaiter*)malloc(sizeof(PlewWaiter)); w->fn = fn; w->frame = frame; w->next = 0; if (p->tail) p->tail->next = w; else p->head = w; p->tail = w; }\n")
    write(s: "void plew_promise_resolve(PlewPromise* p, long long v) { p->done = 1; p->value = v; PlewWaiter* w = p->head; p->head = 0; p->tail = 0; while (w) { PlewWaiter* next = w->next; plew_enqueue(w->fn, w->frame); free(w); w = next; } }\n")
    write(s: "static void plew_timer_add(long long delay, PlewPromise* p) { if (plew_timers_len == plew_timers_cap) { plew_timers_cap = plew_timers_cap ? plew_timers_cap * 2 : 8; plew_timers = (PlewTimer*)realloc(plew_timers, (size_t)plew_timers_cap * sizeof(PlewTimer)); } plew_timers[plew_timers_len].deadline = plew_vnow + delay; plew_timers[plew_timers_len].p = p; plew_timers_len++; }\n")
    // the timer co-owns the promise until it fires (retain here, drop in plew_loop_run
    // after the resolve) — the returned value keeps the creation count.
    write(s: "PlewPromise* plew_sleep(long long ms) { PlewPromise* p = plew_promise_new(); plew_rawbuf_retain(p); plew_timer_add(ms, p); return p; }\n")
    write(s: "void plew_loop_run(void) { PlewTask t; while (1) { while (plew_dequeue(&t)) { t.fn(t.arg); } if (plew_timers_len == 0) break; long long bi = -1, bd = 0; for (long long i = 0; i < plew_timers_len; i++) { if (bi < 0 || plew_timers[i].deadline < bd) { bi = i; bd = plew_timers[i].deadline; } } PlewPromise* p = plew_timers[bi].p; plew_vnow = plew_timers[bi].deadline; plew_timers[bi] = plew_timers[--plew_timers_len]; plew_promise_resolve(p, 0); plew_rawbuf_drop(p); } }\n")
}

fn floatTextCPtr(c: inout Comp, start: U64, len: U64) -> CPtr[U8] {
    mut val bs: Array[U8] = []
    mut val i: U64 = 0
    while i < len {
        val byte: U8 = c.arena.bytes[start + i]
        // `_` is lexical digit grouping, not part of LLVM's numeric grammar.
        // Both legacy and Mid use this normalization; numeric value formation
        // must not depend on which lowering path happened to be selected.
        if byte != 95U8 { bs.append(byte) }
        i += 1U64
    }
    return cstr(s: stringFromBytesUnchecked(bs))
}

fn floatTextLen(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val out: U64 = 0U64
    mut val i: U64 = 0U64
    while i < len {
        if c.arena.bytes[start + i] != 95U8 { out += 1U64 }
        i += 1U64
    }
    return out
}

fn cstr(s: String) -> CPtr[U8] {
    return cString(s)
}

// Empty instruction name (LLVM auto-numbers unnamed values).
fn anon() -> CPtr[U8] {
    return cString("")
}

// Physical memory operations have no work for a zero-sized aggregate. Keep
// evaluation, allocation and ownership at their callers; only omit the memory
// access itself. This also avoids forming a spurious access range for ASan.
fn llvmTypeHasStorage(valueType~: LLVMTypeRef) -> Bool {
    val kind: U32 = LLVMGetTypeKind(valueType)
    if kind == 10U32 {
        // An opaque declaration is not a completed zero-sized layout.
        if LLVMIsOpaqueStruct(valueType) != 0I32 { return true }
        val count: U32 = LLVMCountStructElementTypes(valueType)
        mut val index: U32 = 0U32
        while index < count {
            if llvmTypeHasStorage(LLVMStructGetTypeAtIndex(valueType, index)) { return true }
            index += 1U32
        }
        return false
    }
    if kind == 11U32 {
        return LLVMGetArrayLength2(valueType) != 0U64 && llvmTypeHasStorage(LLVMGetElementType(valueType))
    }
    return true
}

fn llvmLoad(builder~: LLVMBuilderRef, valueType~: LLVMTypeRef, address~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef {
    if !llvmTypeHasStorage(valueType) { return LLVMConstNull(valueType) }
    return LLVMBuildLoad2(builder, valueType, address, name)
}

fn llvmStore(builder~: LLVMBuilderRef, value~: LLVMValueRef, address~: LLVMValueRef) {
    if llvmTypeHasStorage(LLVMTypeOf(value)) { LLVMBuildStore(builder, value, address) }
}

fn llvmValueAbiPassing(type~: LLVMTypeRef) -> LlvmValuePassing {
    if !llvmTypeHasStorage(type) { return <LlvmValuePassing.Omitted /> }
    val kind = LLVMGetTypeKind(type)
    if kind == 10U32 || kind == 11U32 { return <LlvmValuePassing.Indirect /> }
    return <LlvmValuePassing.Direct />
}
