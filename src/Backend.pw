part ./Backend/Llvm

// ---- relocated free helpers (were in parts; kept at module root so parts are impl-only) ----

fn paramLabelsEqual(c: inout Comp, a: FuncParamRange, b: FuncParamRange) -> Bool {
    if a.count() != b.count() {
        return false
    }
    mut val i: U64 = 0
    while i < a.count() {
        if c.funcParamAt(params: a, index: i).nameId != c.funcParamAt(params: b, index: i).nameId {
            return false
        }
        i += 1
    }
    return true
}

// The witness method on concrete struct `sidx` for trait requirement `req` (matched
// by name + param labels). c.arena.funcs.count() if none.
fn findWitnessFor(c: inout Comp, sidx: U64, req: Func) -> U64 {
    val sd: StructDef = c.arena.structs[sidx]
    val recvId: U64 = intern(c: inout c, start: sd.nameStart, len: sd.nameLen)
    mut val i: U64 = 0
    while i < c.arena.funcs.count() {
        val f: Func = c.arena.funcs[i]
        if f.hasRecv && f.extId == 0U64 && !f.isAssoc {
            if f.nameId == req.nameId && f.recvId == recvId {
                if paramLabelsEqual(c: inout c, a: f.params, b: req.params) {
                    return i
                }
            }
        }
        i += 1
    }
    return c.arena.funcs.count()
}

// Does requirement `req` mention `Self` in a non-receiver INPUT position (a param)?
// Such a member is NOT callable through `any` (spec/08: two `any P` values need not
// share a concrete type, so a `Self` argument cannot be supplied).
// Whether TypeRef `ref` mentions `Self` ANYWHERE in its type tree — a bare `Self`, or
// nested inside a container / generic (`Optional[Self]`, `Array[Ref[Self]]`, a user
// `Box[Self]`). The `any P` member-availability rule (spec/08, Swift SE-0309) keys off
// this: `Self` in a contravariant position (any parameter) blocks the member entirely,
// and `Self` in the result is callable only where it can be covariantly erased.
fn typeRefMentionsSelf(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.arena.types.count() {
        return false
    }
    val t: TypeRef = c.arena.types[ref]
    if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
        return true
    }
    mut val i: U64 = 0
    while i < t.args.count() {
        if typeRefMentionsSelf(c: inout c, ref: t.args[i]) {
            return true
        }
        i += 1
    }
    // an anonymous record type (`(a: Self)`, name starting with '(') lowers to a synthesized
    // struct whose TypeRef carries NO args — its field types (where a captured `Self` hides)
    // live in the struct's FieldDefs. Descend into them so `Self` in a record position is seen
    // by the `any P` callability gates (reqUsesSelfInInput / retTySelfErasable). Records are
    // structurally acyclic (no anonymous self-reference), so this recursion terminates without a
    // visited set; user structs never carry a captured `Self` in a field (that would be an
    // infinitely-sized type), so restricting the descent to records also avoids their cycles.
    if c.arena.bytes[t.nameStart] == 40U8 {
        val sidx: U64 = c.structIndexByName(start: t.nameStart, len: t.nameLen)
        if sidx < c.arena.structs.count() {
            mut val fi: U64 = 0
            while fi < c.arena.structs[sidx].fields.count() {
                val fd: FieldDef = c.arena.structs[sidx].fields[fi]
                if rangeEquals(bytes: c.arena.bytes, start: fd.tyStart, len: fd.tyLen, kw: "Self") {
                    return true
                }
                if fd.ty != 0U64 {
                    if typeRefMentionsSelf(c: inout c, ref: fd.ty) {
                        return true
                    }
                }
                fi += 1
            }
        }
    }
    return false
}

// Does requirement `req` reference `Self` in any PARAMETER (a non-receiver input)?
// Such a member is not callable through `any P`: the parameter position is
// contravariant, so a type-erased value cannot be supplied where the concrete `Self`
// is required (two `any P` values need not share a concrete type). Walks the whole
// parameter type tree so a NESTED `Self` (`other: Optional[Self]`, `xs: Array[Self]`)
// is caught, not just a bare `Self` param — spec/08.
fn reqUsesSelfInInput(c: inout Comp, req: Func) -> Bool {
    mut val i: U64 = 0
    while i < req.params.count() {
        val param: Param = c.funcParamAt(params: req.params, index: i)
        if param.ty != 0U64 {
            if typeRefMentionsSelf(c: inout c, ref: param.ty) {
                return true
            }
        } else {
            if rangeEquals(bytes: c.arena.bytes, start: param.tyStart, len: param.tyLen, kw: "Self") {
                return true
            }
        }
        i += 1
    }
    return false
}

// Whether every `Self` in `ref` sits under a covariant container head the thunk can
// repack — a bare `Self`, or `Self` nested only through `Array[·]` / a generic enum
// (`Optional[Self]`, `Result[Self, E]`), recursively (spec/08, SE-0309). `Self` under any
// other head (`Dictionary`, a tuple/record, a user struct) is NOT erasable.
fn retTySelfErasable(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.arena.types.count() {
        return true
    }
    val t: TypeRef = c.arena.types[ref]
    // a bare `Self` here: the leaf boxes into the existential.
    if rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
        return true
    }
    if !(typeRefMentionsSelf(c: inout c, ref: ref)) {
        return true
    }
    // `Self` is nested: the head must be one eraseCovariantToAny rebuilds — `Array` or a
    // generic enum. Every arg that itself mentions `Self` must be erasable too.
    val isArr: Bool = rangeEquals(bytes: c.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array")
    val isEnum: Bool = c.genericEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen) < c.arena.enums.count()
    if !(isArr) && !(isEnum) {
        return false
    }
    mut val i: U64 = 0
    while i < t.args.count() {
        if typeRefMentionsSelf(c: inout c, ref: t.args[i]) {
            if !(retTySelfErasable(c: inout c, ref: t.args[i])) {
                return false
            }
        }
        i += 1
    }
    return true
}

// Whether `req`'s RETURN mentions `Self` only in positions the thunk can covariantly erase.
// A bare `-> Self` re-boxes its single concrete result; `Self` nested in a covariant
// container (`Optional[Self]`, `Array[Self]`) is repacked by eraseCovariantToAny. `Self`
// under a non-repackable head (`Dictionary`, tuple) makes the member non-callable through
// `any P` (sound: no un-erased concrete escapes as an existential — spec/08, SE-0309).
fn reqRetSelfErasable(c: inout Comp, req: Func) -> Bool {
    if !(req.hasRet) || req.retTy == 0U64 {
        return true
    }
    if !(typeRefMentionsSelf(c: inout c, ref: req.retTy)) {
        return true
    }
    return retTySelfErasable(c: inout c, ref: req.retTy)
}

// Does requirement `req` return bare `Self`? Such a member IS callable through `any`
// (spec/08): the output `Self` is re-erased to `any P` — the thunk re-boxes the
// witness's concrete result into the existential. (A `Self` nested in a generic
// return like `Optional[Self]` is not handled yet.)
fn reqReturnsSelf(c: inout Comp, req: Func) -> Bool {
    if req.hasRet {
        // a bare `-> Self` only: `-> Array[Self]` shares the legacy `retStart` span "Self"
        // (the element head view) with retIsArray=true — it is a covariant container, not a
        // bare Self, and is repacked by the retContainerSelf path (eraseCovariantToAny), not
        // re-boxed here.
        if req.retIsArray {
            return false
        }
        return rangeEquals(bytes: c.arena.bytes, start: req.retStart, len: req.retLen, kw: "Self")
    }
    return false
}


// ---- checked arithmetic (overflow / divide-by-zero panic) ----
//
// add/sub/mul/div/rem route through the runtime `plew_<w><Op>` helpers (which
// panic on overflow / div-by-zero), matching the C backend's checked floor
// (spec/12: overflow and 0-division always panic; wrapping is opt-in). Bitwise,
// shift, and comparison ops have no overflow and stay raw (buildBinOpS). The
// wrapping* methods deliberately keep calling buildBinOpS (no check).
// Width bucket 0..3 for an 8/16/32/64-bit integer type.
fn llvmWidthIdx(w: U32) -> U64 {
    if w <= 8U32 { return 0U64 }
    if w <= 16U32 { return 1U64 }
    if w <= 32U32 { return 2U64 }
    return 3U64
}

// "Add"/"Sub"/"Mul"/"Div"/"Rem" bytes for an op (callers guard to these ops).
fn checkedOpName(op: I64) -> Array[U8] {
    if op == opAdd() { return "Add".bytes() }
    if op == opSub() { return "Sub".bytes() }
    if op == opMul() { return "Mul".bytes() }
    if op == opDiv() { return "Div".bytes() }
    return "Rem".bytes()
}

// 0..4 op index for a checked binary op (Add/Sub/Mul/Div/Rem), for nameId.
fn checkedOpIdx(op: I64) -> U64 {
    if op == opAdd() { return 0U64 }
    if op == opSub() { return 1U64 }
    if op == opMul() { return 2U64 }
    if op == opDiv() { return 3U64 }
    return 4U64
}

// "i8".."u64" prefix bytes (signedness + width) for a `plew_<prefix><Op>` symbol.
fn checkedPrefixBytes(unsigned: Bool, wi: U64) -> Array[U8] {
    mut val b: Array[U8] = []
    if unsigned { b.append(117) } else { b.append(105) }
    if wi == 0U64 {
        b.append(56)
        return b
    }
    if wi == 1U64 {
        b.append(49)
        b.append(54)
        return b
    }
    if wi == 2U64 {
        b.append(51)
        b.append(50)
        return b
    }
    b.append(54)
    b.append(52)
    return b
}

// The runtime symbol name for a checked binary op: `plew_<prefix><Op>`.
fn checkedFnName(op: I64, unsigned: Bool, wi: U64) -> String {
    mut val b: Array[U8] = "plew_".bytes()
    appendBytes(into: inout b, from: checkedPrefixBytes(unsigned: unsigned, wi: wi))
    appendBytes(into: inout b, from: checkedOpName(op: op))
    return stringFromBytesUnchecked(b)
}

// A stable, collision-free getOrDeclare id for a checked helper (base 9000;
// op*8 + sign*? + width keeps the 48 binop slots distinct; Neg uses 9100+wi).
fn checkedNameId(op: I64, unsigned: Bool, wi: U64) -> U64 {
    mut val sgn: U64 = 0U64
    if unsigned { sgn = 4U64 }
    return 9000U64 + checkedOpIdx(op: op) * 8U64 + sgn + wi
}

// Whether an expression's value ALIASES existing storage (reads a live place) —
// vs producing a freshly-owned value. THE single aliasing gate for the ARC copy
// cluster (consumeIntoOwned and friends): copying an aliasing value must make the
// new owner independent (retain / CoW-share / deep-copy); a fresh value (literal,
// call/append result, construction) already owns itself and must NOT be re-owned.
//
// This is deliberately a DIFFERENT question from the frontend's `exprIsPlace`
// (lvalue-ness for inout/assignment targets): a cast `x as T` or a view `x#Ext`
// is not an assignable place, but its VALUE is the same storage as `x` — a
// representation no-op must be transparent to ownership. Conversely `move x`
// transfers ownership (the source's drop is suppressed), so the moved value is
// fresh by construction. Replaces the three drifted per-class siblings
// (any/array/structExprIsPlace: Ident/Field[/Index] only — the missing
// Arrow/Deref/Cast arms were live UAF/double-free classes, review/12 §1).
fn exprAliasesPlace(c: inout Comp, id: U64) -> Bool {
    match c.arena.exprs[id] {
        Expr.Ident(start: _, len: _) => { return true }
        // a field projection is a place ONLY when its base is: `s.name` aliases the
        // binding's storage, but `f().name` / `xs[i].name` projects out of an owned
        // TEMPORARY — the emission homes the temp and retains the projected value
        // (Expr.Field arm), so the consumer must treat it as owned, not borrowed.
        Expr.Field(val base, nameStart: _, nameLen: _) => { return exprAliasesPlace(c: inout c, id: base) }
        // an element READ `outer[i]` is NOT a place alias: it routes through the
        // `index`/`get`/`at` witness (spec/12, collections.md E3), whose return
        // already RETAINED an ARC element (buffer-floor.md §4) — the value arrives
        // as an owned (+1) temporary. Answering `true` here (the pre-witness raw-
        // load era) made every consumer treat it as a borrow: a bind/store retained
        // a SECOND count and a sink arg homed nothing — one leaked count per read.
        // (Index as a WRITE place goes through placePtrStrict, not this predicate.)
        Expr.Index(base: _, index: _) => { return false }
        // pointee reads through a Ref cell: the value lives in the cell — a second
        // owner must retain/copy it (binding `r->xs` without a copy was a UAF).
        Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
        Expr.Deref(base: _) => { return true }
        // representation no-ops: the value IS the operand's storage.
        Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return exprAliasesPlace(c: inout c, id: operand) }
        Expr.ExtView(val recv, source: _, strip: _) => { return exprAliasesPlace(c: inout c, id: recv) }
        // `borrow x` is BY DEFINITION an alias of x's storage (a non-consuming view —
        // classifying it as a temporary gave a borrowed unique arg a second owner =
        // double deinit); `move x` transfers a fresh-owned value (the source dies).
        Expr.Move(val operand, val isBorrow) => {
            if isBorrow {
                return exprAliasesPlace(c: inout c, id: operand)
            }
            return false
        }
        _ => { return false }
    }
}

fn isAsyncFn(c: inout Comp, fi: U64) -> Bool {
    return c.arena.funcs[fi].isAsync
}

fn exprIsAwaitLL(c: inout Comp, id: U64) -> Bool {
    match c.arena.exprs[id] {
        Expr.Await(operand: _) => { return true }
        _ => { return false }
    }
}

fn llvmIntEq() -> U32 { return 32U32 }

fn llvmIntNe() -> U32 { return 33U32 }

fn llvmIntSlt() -> U32 { return 40U32 }

fn llvmIntSle() -> U32 { return 41U32 }

fn llvmIntSgt() -> U32 { return 38U32 }

fn llvmIntSge() -> U32 { return 39U32 }

fn llvmIntUlt() -> U32 { return 36U32 }

fn llvmIntUle() -> U32 { return 37U32 }

fn llvmIntUgt() -> U32 { return 34U32 }

fn llvmIntUge() -> U32 { return 35U32 }

// Whether two parameter lists have the same type-name heads (ignoring views) —
// i.e. they are the same overload signature differing only by a `#Ext` view.
fn sameParamTypeHeads(c: inout Comp, a: Array[Param], b: Array[Param]) -> Bool {
    if a.count() != b.count() {
        return false
    }
    mut val i: U64 = 0
    while i < a.count() {
        if a[i].tyNameId != b[i].tyNameId {
            return false
        }
        if a[i].tyIsArray != b[i].tyIsArray {
            return false
        }
        i += 1
    }
    return true
}

// Emit a call argument for a parameter `p`: an array-literal arg is built with the
// parameter's element type (so `[10,20]` for an `Array[I32]` param uses i32, not
// i64-defaulted elements); a scalar arg is width-coerced to the parameter type.
// Whether (start,len) names a concrete value type (struct / enum / newtype /
// primitive) — as opposed to a bare generic type parameter. A generic parameter
// absorbs a `#`-view argument via inference (`T` binds to `S#P`), so the view-
// invariance check below must not fire on it.
fn tyNameConcrete(c: inout Comp, start: U64, len: U64) -> Bool {
    if c.isPrimType(start: start, len: len) {
        return true
    }
    if c.structIndexByName(start: start, len: len) < c.arena.structs.count() {
        return true
    }
    if c.isEnumName(start: start, len: len) {
        return true
    }
    val qid: U64 = intern(c: inout c, start: start, len: len)
    mut val nti: U64 = 0
    while nti < c.arena.newtypes.count() {
        if c.arena.newtypes[nti].nameId == qid {
            return true
        }
        nti += 1
    }
    return false
}

fn closureCaptures(c: inout Comp, cloId: U64) -> Array[CaptureEntry] {
    mut val out: Array[CaptureEntry] = []
    mut val i: U64 = 0
    while i < c.monoWork.captures.count() {
        if c.monoWork.captures[i].closureId == cloId {
            out.append(c.monoWork.captures[i])
        }
        i += 1
    }
    return out
}

// Whether the local named (start,len) is captured by some closure as a boxed
// (`mut val`, shared-cell) capture — so its storage must be a heap cell that
// outlives the declaring scope (Swift-style reference capture).
fn localIsBoxedCapture(c: inout Comp, start: U64, len: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.monoWork.captures.count() {
        if c.monoWork.captures[i].boxed {
            if spansEqual(c: inout c, aStart: c.monoWork.captures[i].nameStart, aLen: c.monoWork.captures[i].nameLen, bStart: start, bLen: len) {
                return true
            }
        }
        i += 1
    }
    return false
}

// Whether the LLVM backend can lower closure `cloId` yet: a `mut val` (boxed,
// shared-cell) capture isn't modeled, so such a closure is left undeclared and its
// literal rejects loudly (a clean unsupported, not a miscompile).
fn closureSupported(c: inout Comp, cloId: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.monoWork.captures.count() {
        if c.monoWork.captures[i].closureId == cloId {
            // a boxed (mut) capture is supported for a scalar/Bool cell; a boxed
            // array/struct/generic-instance cell isn't modeled yet.
            if c.monoWork.captures[i].boxed {
                if c.monoWork.captures[i].isArray {
                    return false
                }
                if c.isGenericInst(ref: c.monoWork.captures[i].ty) {
                    return false
                }
            }
        }
        i += 1
    }
    return true
}

export fn emitLlvm(c: inout Comp) {
    tracePhase(c: inout c, label: "backend:emit:start")
    val ctx: LLVMContextRef = LLVMContextCreate()
    val m: LLVMModuleRef = LLVMModuleCreateWithNameInContext(cstr(s: "plew"), ctx)
    val ptrty: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0U32)
    val i64ty: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
    // Array A (de-collapse): String / Array VALUE = a real one-field aggregate `{ptr}`
    // wrapping the rawbuf data pointer, so Array/String are ordinary structs riding the
    // generic-struct machinery (collections.md §3-付録3 case A; was C1's bare pointer). The
    // live count + capacity live in the heap header [cap@-3][count@-2][rc@-1] before the
    // data, read via plew_rawbuf_count/cap. The VALUE seam (arrValData/arrValMake/arrValWrap)
    // wraps/unwraps the `{ptr}`; the SLOT seam (arrStoragePtr GEPs field 0 → the inner buffer
    // ptr*, so cowArraySlot/arrSlot* stay uniform with the bare-ptr Buffer floor).
    mut val wrapElems: Array[LLVMTypeRef] = []
    wrapElems.append(ptrty)
    val arrayTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(wrapElems), 1U64, 0I32)
    val strty: LLVMTypeRef = arrayTy
    mut val cloelems: Array[LLVMTypeRef] = []
    cloelems.append(ptrty)
    cloelems.append(ptrty)
    val closureTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(cloelems), 2U64, 0I32)
    // any P = { ptr data, ptr vtable } (fat pointer for existentials).
    mut val anyelems: Array[LLVMTypeRef] = []
    anyelems.append(ptrty)
    anyelems.append(ptrty)
    val anyTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(anyelems), 2U64, 0I32)
    // PlewPromise = { i32 done, i64 value, ptr k, ptr kframe } (ABI-identical to
    // the C runtime). Awaited values are type-erased through `value` (i64).
    mut val promelems: Array[LLVMTypeRef] = []
    promelems.append(LLVMInt32TypeInContext(ctx))
    promelems.append(i64ty)
    promelems.append(ptrty)
    promelems.append(ptrty)
    val promiseTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(promelems), 4U64, 0I32)
    mut val st: LlvmCtx = <LlvmCtx
        ctx=ctx mod=m b=LLVMCreateBuilderInContext(ctx)
        i1ty=LLVMInt1TypeInContext(ctx) i8ty=LLVMInt8TypeInContext(ctx) i16ty=LLVMInt16TypeInContext(ctx)
        i32ty=LLVMInt32TypeInContext(ctx) i64ty=i64ty f64ty=LLVMDoubleTypeInContext(ctx)
        voidty=LLVMVoidTypeInContext(ctx) ptrty=ptrty strty=strty arrayTy=arrayTy closureTy=closureTy anyTy=anyTy anyVtType=[] anyVtTrait=[] anyVtBindKey=[] anyVtVal=[]
        curFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32) terminated=false midCoverageBodyIds=[] midCoverageFnIdxs=[] midCoverageKeys=[]
        curIsMain=false curRetVoid=true curRetTy=LLVMVoidTypeInContext(ctx) curRetTyStart=0 curRetTyLen=0 giveValue=LLVMConstInt(LLVMInt64TypeInContext(ctx), 0U64, 0I32) genStructRefs=[] genStructTys=[] genStructDefs=[] genEnumRefs=[] genEnumTys=[] genEnumDefs=[] selfStart=0 selfLen=0 curRecvInstRef=0 expectedTy=0 curRetRef=0 curBodyMark=0 nLocals=0
        fnIdx=[] fnVal=[] fnTy=[] genFnK=[] genFnVal=[] genFnTy=[] genFnEmit=[] genMethK=[] genMethInst=[] genMethVal=[] genMethTy=[] genMethBody=[] genMethOwn=[] genMethOwnArgs=[]
        locStart=[] locLen=[] locPtr=[] locTy=[] locKind=[] locStructIdx=[] locIsArr=[] locElemTy=[] locElemKind=[] locTypeRef=[] locElemTypeRef=[] locOwned=[] locMoved=[] locCellHome=[] declId=[] declFn=[] declTy=[] cloIdx=[] cloVal=[] cloTy=[] thunkIdx=[] thunkVal=[] thunkTy=[] dropWitReg=[] dropWitVal=[] dropWitTy=[] retWitSidx=[] retWitVal=[] retWitTy=[] copyWitSidx=[] copyWitVal=[] copyWitTy=[] enumRelWitReg=[] enumRelWitVal=[] enumRelWitTy=[] enumRetWitEid=[] enumRetWitVal=[] enumRetWitTy=[] enumCopyWitEid=[] enumCopyWitVal=[] enumCopyWitTy=[] dropWitDone=0 retWitDone=0 copyWitDone=0 enumRelWitDone=0 enumRetWitDone=0 enumCopyWitDone=0 provEmit=[] genMethEmit=[]
        promiseTy=promiseTy curAsync=false
        curFrameBase=LLVMConstNull(ptrty) curFrameTy=i64ty
        curResumeFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncSwitch=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncState=0 asyncFieldNext=0 asyncFnIdx=[] asyncFrameTy=[] asyncResumeFn=[] asyncEntryIdx=[] asyncEntryVal=[] asyncEntryTy=[] asyncSlotPtrs=[] loopBreakBB=[] loopContBB=[] loopUnwindMark=[] loopDepth=0 />

    // a "self" byte span (appended past the source) to bind method receivers.
    st.selfStart = c.arena.bytes.count()
    c.appendSrc(from: "self".bytes())
    st.selfLen = 4U64

    // register user struct + enum types, then generic struct/enum instances. ALL
    // NAMES first (plain structs, plain enums, generic-struct instances, generic-enum
    // instances), THEN all cross-referencing bodies — so a struct/enum body may hold a
    // member of generic-instance type (`struct Pair { a: Optional[I64] }`) regardless
    // of declaration order. (Plain enums and generic-enum instances are self-contained
    // `{ i64 tag, [maxWords] payload }`, sized by the front-end, so their bodies are
    // set with their names; only struct + generic-struct bodies cross-reference named
    // types, so those are deferred to the body passes.)
    st.registerStructNames(c: inout c)
    st.registerEnums(c: inout c)
    st.registerGenStructNames(c: inout c)
    st.registerGenEnums(c: inout c)
    st.registerGenStructBodies(c: inout c)
    tracePhase(c: inout c, label: "backend:types:done")

    // pass 1: declare generic free-fn instances + generic method instances (one per
    // receiver instantiation). Non-generic free/assoc fns and methods are no longer
    // eagerly declared — each is its own 0-type-arg instance, declared lazily on first
    // reach (gf via ensureFnInst, gm via ensureGenMethodDeclared).
    st.declareGenFns(c: inout c)
    st.declareGenMethods(c: inout c)
    // async fns: build each frame struct + resume fn, and a non-main entry symbol
    // in the fnIdx table (so a call `doubler(x: 21)` resolves to a promise-returning
    // call). Done before bodies emit so main's resume can call them.
    st.declareAsyncFns(c: inout c)
    // declare lambda-lifted closures (after the named types + functions they may
    // reference exist), so a closure literal can build its {fn, env} value.
    st.collectClosures(c: inout c)
    tracePhase(c: inout c, label: "backend:declarations:done")

    // module-level variables (spec/15): emit `plew_init_globals` (one body that runs
    // every global's initializer once) and record each global's metadata, BEFORE any
    // function body so `seedGlobals` can re-bind them at every body entry. Done after
    // pass-1 declarations so an initializer may call a user function.
    st.genLlvmInitGlobals(c: inout c)
    tracePhase(c: inout c, label: "backend:globals:done")

    // pass 2: emit `main` and every plain user function's body.
    mut val fi: U64 = 0
    mut val foundMain: Bool = false
    while fi < c.arena.funcs.count() {
        // gen mode (spec/16): the program is the synthesized harness main at
        // `genMainIdx`; the user's own `main` is dead (it calls macro-generated
        // functions that don't exist in this build), so it is neither the entry
        // main nor a plain fn. Treat only genMainIdx as main here.
        mut val isMainFn: Bool = c.nameIsMain(f: c.arena.funcs[fi])
        if c.genMode {
            if isMainFn {
                if fi != c.genMainIdx {
                    isMainFn = false
                }
            }
        }
        if isMainFn {
            // an `async fn main` is lowered with the rest of the async fns (entry +
            // resume + drain the event loop); a plain main is the synchronous shape.
            if !(isAsyncFn(c: inout c, fi: fi)) {
                st.genLlvmMain(c: inout c, fi: fi)
            }
            foundMain = true
        }
        // every other function is emitted lazily on first reach (gf/gm) via the pass-2
        // drain below — nothing to emit eagerly here. (A gen-mode dead user main, which
        // calls macro-generated functions absent from this build, is simply never reached.)
        fi += 1
    }
    tracePhase(c: inout c, label: "backend:entry:done")
    // async fn entry + resume bodies (main's entry drains the loop).
    st.emitAsyncFns(c: inout c)
    tracePhase(c: inout c, label: "backend:async:done")
    // generic-method instance bodies. (Free-function instance bodies — eager `gf` plus any
    // lazily declared via ensureFnInst — drain through genFnEmit in the fixpoint loop below.)
    st.emitGenMethods(c: inout c)
    tracePhase(c: inout c, label: "backend:generic-methods:done")
    // `emitGenMethods` has consumed every slot available through main/async
    // emission. Closure bodies are emitted next and may enqueue additional
    // methods; remember this boundary before they run so the fixpoint drains
    // precisely those new slots rather than either skipping them or replaying
    // an already-emitted LLVM body.
    mut val genmDone: U64 = st.genMethEmit.count()
    // lambda-lifted closure bodies. Named-function-value thunks stay empty in v1 because
    // named declarations are not first-class values.
    st.emitClosures(c: inout c)
    st.emitThunks(c: inout c)
    tracePhase(c: inout c, label: "backend:closures-thunks:done")
    // provided trait methods + lazily-declared std/generic methods reached during
    // the passes above. Both queues can grow as bodies emit (a provided body calls
    // a std generic method, a generic body reaches a provided one), so drain to a
    // fixpoint: loop until neither queue advances.
    mut val provDone: U64 = 0
    // emitGenMethods above already emitted every slot that existed at that
    // point, including on-demand slots queued while main/async bodies were
    // emitted.  Start the incremental queue cursor after those entries: replaying
    // them appended a second unreachable body to the same LLVM function and let
    // a shared provided-method AST observe another instance's ambient state.
    mut val genfDone: U64 = 0
    mut val draining: Bool = true
    tracePhase(c: inout c, label: "backend:drain:start")
    mut val drainRound: U64 = 0U64
    while draining {
        tracePhaseCount(c: inout c, label: "backend:drain:round", count: drainRound)
        tracePhaseCount(c: inout c, label: "backend:drain:provided-queued", count: st.provEmit.count())
        tracePhaseCount(c: inout c, label: "backend:drain:generic-method-queued", count: st.genMethEmit.count())
        tracePhaseCount(c: inout c, label: "backend:drain:generic-function-queued", count: st.genFnEmit.count())
        while provDone < st.provEmit.count() {
            tracePhaseCount(c: inout c, label: "backend:drain:provided-emitting", count: provDone)
            st.genLlvmFuncBody(c: inout c, fi: st.provEmit[provDone], fv: st.fnVal[st.userFnSlot(idx: st.provEmit[provDone])], environment: c.bodyInstanceEnvironment(fnIdx: st.provEmit[provDone], args: [], recvInstRef: 0U64))
            provDone += 1
        }
        while genmDone < st.genMethEmit.count() {
            tracePhaseCount(c: inout c, label: "backend:drain:generic-method-emitting", count: genmDone)
            st.emitOneGenMethod(c: inout c, slot: st.genMethEmit[genmDone])
            genmDone += 1
        }
        // free-function instance bodies (eager `gf` + lazily declared via ensureFnInst); the
        // queue can grow as a body reaches a not-yet-declared free fn, so drain to fixpoint.
        while genfDone < st.genFnEmit.count() {
            tracePhaseCount(c: inout c, label: "backend:drain:generic-function-emitting", count: genfDone)
            st.emitOneGenFn(c: inout c, slot: st.genFnEmit[genfDone])
            genfDone += 1
        }
        // per-type drop/retain/copy-witness bodies (declared on demand at drop sites). A
        // witness body's deinit call is now a `gm` instance (B3-2), which queues onto
        // genMethEmit — so emitWitnessBodies must run INSIDE this fixpoint loop, not after it,
        // or those deinit method bodies would be declared but never emitted (link error).
        st.emitWitnessBodies(c: inout c)
        tracePhaseCount(c: inout c, label: "backend:drain:provided-after-witness", count: st.provEmit.count())
        tracePhaseCount(c: inout c, label: "backend:drain:generic-method-after-witness", count: st.genMethEmit.count())
        tracePhaseCount(c: inout c, label: "backend:drain:generic-function-after-witness", count: st.genFnEmit.count())
        if provDone >= st.provEmit.count() {
            if genmDone >= st.genMethEmit.count() {
                if genfDone >= st.genFnEmit.count() {
                    draining = false
                }
            }
        }
        drainRound += 1U64
    }
    tracePhase(c: inout c, label: "backend:drain:done")
    if !(foundMain) {
        compileErrorAt(line: 0, msg: "LLVM backend: no `main` function found")
    }

    // `--asan`: a bare `.ll` carries no target triple and no `sanitize_address`
    // attribute, so a downstream `opt -passes=asan` instruments NOTHING (the asan
    // pass skips every function that lacks the attribute — the old gate then only
    // exercised the free/double-free interceptor layer and missed raw load/store
    // UAF). Stamp the host triple and mark every DEFINED function so the pass
    // actually instruments memory accesses. Declarations (runtime externs) are left
    // untouched — they carry no body and are compiled/instrumented by clang.
    if c.asan {
        LLVMSetTarget(st.mod, cstr(s: "arm64-apple-macosx15.0.0"))
        val kind: U32 = LLVMGetEnumAttributeKindForName(cstr(s: "sanitize_address"), 16U64)
        val attr: LLVMAttributeRef = LLVMCreateEnumAttribute(st.ctx, kind, 0U64)
        // LLVMAttributeFunctionIndex (~0u) targets the function itself, not a param.
        val fnIndex: U32 = 4294967295U32
        mut val fh: U64 = LLVMGetFirstFunction(st.mod)
        while fh != 0U64 {
            if LLVMIsDeclaration(fh) == 0I32 {
                LLVMAddAttributeAtIndex(fh, fnIndex, attr)
            }
            fh = LLVMGetNextFunction(fh)
        }
    }
    tracePhase(c: inout c, label: "backend:print-module:start")
    val ir: CPtr[U8] = LLVMPrintModuleToString(st.mod)
    tracePhase(c: inout c, label: "backend:print-module:done")
    tracePhase(c: inout c, label: "backend:write:start")
    write(s: stringFromCString(ir))
    tracePhase(c: inout c, label: "backend:write:done")
    LLVMDisposeMessage(ir)
    if c.emitMidCoverage || c.requireMid {
        mut val coverage: U64 = 0U64
        while coverage < st.midCoverageBodyIds.count() {
            st.emitMidCoverageRecord(c: inout c, bodyId: st.midCoverageBodyIds[coverage], fnIdx: st.midCoverageFnIdxs[coverage], key: st.midCoverageKeys[coverage])
            coverage += 1U64
        }
        if c.requireMid && st.midCoverageBodyIds.count() != 0U64 {
            exit(code: 1)
        }
    }
}

// A unique, stable LLVM symbol for the module-level variable at lowering index `idx`
// ("plew.g.<idx>"), so a same-named user local never collides with the global symbol.
fn globalSymbol(idx: U64) -> String {
    mut val s: Array[U8] = []
    appendBytes(into: inout s, from: "plew.g.".bytes())
    appendU64Dec(into: inout s, n: idx)
    return stringFromBytesUnchecked(s)
}

// If field `f` is of array type — declared `Array[E]`, or a type param that
// grounds (under the active env) to `Array[E]` — the element type ref E, else 0.
// Whether field `f` is a `Buffer[T]` (the rc-managed storage floor) held by value — a
// struct field of Buffer type (C2: Dictionary/Set hold their dense/index buffers this way).
// A Buffer field is NOT `tyIsArray` (its declared type is `Buffer[...]`, not `Array[...]`),
// so the array-field ARC paths must check this in parallel. The grounded type is consulted
// so a generic field param grounding to `Buffer` (under the active env) is recognized too.
fn fieldIsBufferType(c: inout Comp, f: FieldDef) -> Bool {
    if f.tyIsArray {
        return false
    }
    if f.ty == 0U64 {
        return false
    }
    // a name check on the DECLARED type (no grounding): a Buffer field is declared
    // `Buffer[...]` (name "Buffer") directly — Dict/Set hold `Buffer[K]` etc. explicitly,
    // never via a bare type param. Crucially this avoids calling groundTypeRef from the
    // hot, recursive structNeedsDeinit (which can re-enter type resolution and overflow).
    return rangeEquals(bytes: c.arena.bytes, start: c.arena.types[f.ty].nameStart, len: c.arena.types[f.ty].nameLen, kw: "Buffer")
}

// A strong reference-cell field: declared `Ref[...]` or `MutableRef[...]` directly. Its cell carries a strong
// rc that must be released at the owning struct's drop (the cell is an extern opaque
// pointer, so the struct field-recursion in structNeedsDeinit / the drop witness can't
// descend into it — reference cells are handled explicitly, like Buffer). Name check on the DECLARED
// type (no grounding) to stay safe inside the recursive structNeedsDeinit.
fn fieldIsRefType(c: inout Comp, f: FieldDef) -> Bool {
    if f.tyIsArray {
        return false
    }
    if f.ty == 0U64 {
        return false
    }
    if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[f.ty].nameStart, len: c.arena.types[f.ty].nameLen, kw: "Ref") {
        return true
    }
    return rangeEquals(bytes: c.arena.bytes, start: c.arena.types[f.ty].nameStart, len: c.arena.types[f.ty].nameLen, kw: "MutableRef")
}

// A weak reference-cell field: declared `WeakRef[...]` or `WeakMutableRef[...]` directly. It owns one WEAK
// count on its shared cell, released (weak--; free iff strong also 0) at the owning struct's
// drop. Like Ref, the cell is an extern opaque pointer the struct field-recursion can't
// descend into, so it is handled explicitly. A name check (no grounding) keeps it safe inside
// the recursive structNeedsDeinit, and weakRelease needs only the cell (no pointee type).
fn fieldIsWeakRefType(c: inout Comp, f: FieldDef) -> Bool {
    if f.tyIsArray {
        return false
    }
    if f.ty == 0U64 {
        return false
    }
    if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[f.ty].nameStart, len: c.arena.types[f.ty].nameLen, kw: "WeakRef") {
        return true
    }
    return rangeEquals(bytes: c.arena.bytes, start: c.arena.types[f.ty].nameStart, len: c.arena.types[f.ty].nameLen, kw: "WeakMutableRef")
}

// The (grounded) `Ref[T]` instance TypeRef of a Ref field — for emitRefRelease's pointee
// deinit dispatch. Grounds under the active env so a `Ref[T]` field in a generic struct
// resolves its concrete pointee. 0 if the field is not a Ref.
fn refFieldTypeRef(c: inout Comp, f: FieldDef) -> U64 {
    if !(fieldIsRefType(c: inout c, f: f)) {
        return 0U64
    }
    if c.cur.typeParams.count() > 0U64 {
        return c.groundTypeRef(ref: f.ty)
    }
    return f.ty
}

// The grounded `Ref[T]` instance TypeRef of a field IF it grounds to a Ref under the active
// env, else 0 — unlike fieldIsRefType / refFieldTypeRef (which name-check the DECLARED type
// first), this GROUNDS first, so a generic enum/struct payload declared as a bare type param
// (`Optional.Some(v: T)` with T -> Ref[Cell]) is recognised. Used by the enum ARC walks so a
// `Ref` payload reached only through a type-param grounding is retained/released exactly.
fn fieldGroundedRefTy(c: inout Comp, f: FieldDef) -> U64 {
    if f.tyIsArray {
        return 0U64
    }
    if f.ty == 0U64 {
        return 0U64
    }
    mut val g: U64 = f.ty
    if c.cur.typeParams.count() > 0U64 {
        g = c.groundTypeRef(ref: f.ty)
    }
    if c.isStrongRefInst(ref: g) {
        return g
    }
    return 0U64
}

// Like fieldGroundedRefTy but for `WeakRef[T]`: grounds the field type (so a type-param
// payload `v: T` in `Optional[WeakRef[Cell]]` resolves to its concrete WeakRef instance)
// and returns it if a WeakRef instance, else 0. Used by the enum-payload WeakRef ARC walks.
fn fieldGroundedWeakTy(c: inout Comp, f: FieldDef) -> U64 {
    if f.tyIsArray {
        return 0U64
    }
    if f.ty == 0U64 {
        return 0U64
    }
    mut val g: U64 = f.ty
    if c.cur.typeParams.count() > 0U64 {
        g = c.groundTypeRef(ref: f.ty)
    }
    if c.isWeakRefLikeInst(ref: g) {
        return g
    }
    return 0U64
}

// The element TypeRef of a `Buffer[T]` field (T), or 0 — for the element-cascade in the
// field ARC paths (Array and Buffer fields are rep-identical, so they share the cascade).
fn bufferFieldElemRef(c: inout Comp, f: FieldDef) -> U64 {
    if !(fieldIsBufferType(c: inout c, f: f)) {
        return 0U64
    }
    mut val g: U64 = f.ty
    if c.cur.typeParams.count() > 0U64 {
        g = c.groundTypeRef(ref: f.ty)
    }
    val t: TypeRef = c.arena.types[g]
    if t.args.count() > 0U64 {
        return t.args[0]
    }
    return 0U64
}

// The element ref for a field that owns an rc-managed buffer — an `Array[E]` field or a
// `Buffer[E]` field (both are a single rawbuf pointer). 0 if the field owns no such buffer.
// The companion gate is `f.tyIsArray || fieldIsBufferType(f)` (the buffer is released/
// retained even when E is a scalar, i.e. when this returns 0 for a scalar element).
fn arrayOrBufferFieldElemRef(c: inout Comp, f: FieldDef) -> U64 {
    val ae: U64 = arrayFieldElemRef(c: inout c, f: f)
    if ae != 0U64 {
        return ae
    }
    return bufferFieldElemRef(c: inout c, f: f)
}

fn arrayFieldElemRef(c: inout Comp, f: FieldDef) -> U64 {
    if f.tyIsArray {
        if f.ty != 0U64 {
            val t: TypeRef = c.arena.types[f.ty]
            if t.args.count() > 0U64 {
                return t.args[0]
            }
        }
        return 0U64
    }
    if f.ty != 0U64 {
        if c.cur.typeParams.count() > 0U64 {
            val g: U64 = c.groundTypeRef(ref: f.ty)
            val gt: TypeRef = c.arena.types[g]
            if rangeEquals(bytes: c.arena.bytes, start: gt.nameStart, len: gt.nameLen, kw: "Array") {
                if gt.args.count() > 0U64 {
                    return gt.args[0]
                }
            }
        }
    }
    return 0U64
}

// (diagnostic) A source span as a String — for the "unsupported" error messages
// (exprFormName) that name the offending identifier/field/call.
fn dbgSpan(c: inout Comp, start: U64, len: U64) -> String {
    mut val nm: Array[U8] = []
    mut val j: U64 = start
    while j < start + len {
        nm.append(c.arena.bytes[j])
        j += 1
    }
    return stringFromBytesUnchecked(nm)
}

// (diagnostic) The name of an expression's arena variant.
fn exprFormName(c: inout Comp, id: U64) -> String {
    match c.arena.exprs[id] {
        Expr.Ident(start: val s, len: val l) => { return dbgSpan(c: inout c, start: s, len: l) }
        Expr.Field(base: _, val nameStart, val nameLen) => { return dbgSpan(c: inout c, start: nameStart, len: nameLen) }
        Expr.Call(val nameStart, val nameLen, args: _) => { return dbgSpan(c: inout c, start: nameStart, len: nameLen) }
        _ => { return exprFormName2(c: inout c, id: id) }
    }
}

fn exprFormName2(c: inout Comp, id: U64) -> String {
    match c.arena.exprs[id] {
        Expr.Index(base: _, index: _) => { return "Index" }
        Expr.Array(elems: _) => { return "Array" }
        Expr.Cast(operand: _, tyStart: _, tyLen: _, ty: _) => { return "Cast" }
        Expr.MatchExpr(scrut: _, arms: _) => { return "MatchExpr" }
        Expr.IfExpr(cond: _, thenBlk: _, elseBlk: _) => { return "IfExpr" }
        Expr.OptChain(base: _, cont: _) => { return "OptChain" }
        Expr.ChainHole => { return "ChainHole" }
        Expr.Try(expr: _) => { return "Try" }
        Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return "Arrow" }
        Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => { return "Closure" }
        Expr.Move(operand: _, isBorrow: _) => { return "Move" }
        Expr.Await(operand: _) => { return "Await" }
        _ => { return "other" }
    }
}

fn refIsAny(c: inout Comp, ref: U64) -> Bool {
    if ref < c.arena.types.count() {
        return c.arena.types[ref].isAny
    }
    return false
}

// Build the substitution env for an `any P[bindings]` existential (spec/08,12): map
// each of trait `traitIdx`'s type parameters and associated types to its binding
// from the any TypeRef. Positional any-args (argLabels entry 0) fill the type
// parameters in order; named any-args bind a parameter or associated type by name.
// Fills the parallel (names, args) lists used as c.cur.typeParams/curTypeArgs so
// requirement signatures naming `Rhs`/`Item`/`Output` ground to concrete types.
// Returns false if any parameter / associated type is left unbound.
fn anyBindingEnv(c: inout Comp, anyRef: U64, traitIdx: U64, outParams: inout Array[Bind], outArgs: inout Array[U64]) -> Bool {
    val t: TraitDef = c.decls.traits[traitIdx]
    val ar: TypeRef = c.arena.types[anyRef]
    // positional binding refs (argLabels entry 0), in source order.
    mut val positional: Array[U64] = []
    mut val ai: U64 = 0
    while ai < ar.args.count() {
        mut val lbl: U64 = 0
        if ai < ar.argLabels.count() {
            lbl = ar.argLabels[ai]
        }
        if lbl == 0U64 {
            positional.append(ar.args[ai])
        }
        ai += 1
    }
    mut val posIdx: U64 = 0
    // type parameters: a named binding wins, else the next positional.
    mut val tpi: U64 = 0
    while tpi < t.typeParams.count() {
        val tp: Bind = c.traitBindAt(binds: t.typeParams, index: tpi)
        mut val ref: U64 = 0
        mut val found: Bool = false
        mut val bi: U64 = 0
        while bi < ar.args.count() {
            if bi < ar.argLabels.count() {
                if ar.argLabels[bi] == tp.nameId && tp.nameId != 0U64 {
                    ref = ar.args[bi]
                    found = true
                }
            }
            bi += 1
        }
        if !(found) {
            if posIdx < positional.count() {
                ref = positional[posIdx]
                posIdx += 1
                found = true
            }
        }
        if !(found) {
            return false
        }
        outParams.append(tp)
        outArgs.append(ref)
        tpi += 1
    }
    // associated types: named binding only.
    mut val asi: U64 = 0
    while asi < t.assocTypes.count() {
        val at: Bind = c.traitBindAt(binds: t.assocTypes, index: asi)
        mut val ref2: U64 = 0
        mut val found2: Bool = false
        mut val bj: U64 = 0
        while bj < ar.args.count() {
            if bj < ar.argLabels.count() {
                if ar.argLabels[bj] == at.nameId && at.nameId != 0U64 {
                    ref2 = ar.args[bj]
                    found2 = true
                }
            }
            bj += 1
        }
        if !(found2) {
            return false
        }
        outParams.append(at)
        outArgs.append(ref2)
        asi += 1
    }
    return true
}

// A cache key distinguishing existential vtables whose concrete bindings differ
// (`any Add[I32,…]` vs `any Add[I64,…]`): a fold over the bound type refs' head name
// ids. 0 when there are no bindings (the canonical case, keyed only by sidx+trait).
fn anyBindKey(c: inout Comp, args: Array[U64]) -> U64 {
    mut val k: U64 = 0
    mut val i: U64 = 0
    while i < args.count() {
        mut val nid: U64 = 0
        if args[i] < c.arena.types.count() {
            nid = c.arena.types[args[i]].nameId
        }
        k = k * 1000003U64 + nid + 1U64
        i += 1
    }
    return k
}

// Is this type name a fixed-width primitive integer (the operator-witness owners).
fn isPrimIntName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I64") { return true }
    return isUnsignedName(c: inout c, start: start, len: len)
}

// Is this type name an unsigned integer (for choosing signed vs unsigned ops /
// formatting)? Defaults to signed.
fn isUnsignedName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U64") { return true }
    return false
}

// The declared index of field (start,len) in struct sidx, or sd.fields.count().
fn structFieldIndex(c: inout Comp, sidx: U64, start: U64, len: U64) -> U64 {
    val sd: StructDef = c.arena.structs[sidx]
    mut val i: U64 = 0
    while i < sd.fields.count() {
        if spansEqual(c: inout c, aStart: sd.fields[i].nameStart, aLen: sd.fields[i].nameLen, bStart: start, bLen: len) {
            return i
        }
        i += 1
    }
    return sd.fields.count()
}

// If field `fld` is a (non-array) generic-instance type by value, its grounded
// instance TypeRef (under the active env), else 0. Used at assignment sites to set
// st.expectedTy so an un-suffixed RHS construction (`b.a = <Optional.Some v=9 />`)
// infers the instance's type args, mirroring genFieldValue at construction.
// Concatenate two type-param lists (`add` first, then `base`). Used to MERGE a
// nested generic construct's env onto the enclosing one — e.g. building
// `<Optional.Some v=self.f(x:v) />` inside a monomorphized `MapIter.next`: the
// field type `T` resolves via Optional's params while the payload sub-expression
// `self.f` resolves via MapIter's (the outer env). Disjoint names, so first-match
// in groundTypeRef picks the right one; same length so args pair 1:1.
fn concatParams(add: Array[Bind], base: Array[Bind]) -> Array[Bind] {
    mut val r: Array[Bind] = []
    mut val i: U64 = 0
    while i < add.count() { r.append(add[i])  i += 1 }
    mut val j: U64 = 0
    while j < base.count() { r.append(base[j])  j += 1 }
    return r
}

fn concatArgs(add: Array[U64], base: Array[U64]) -> Array[U64] {
    mut val r: Array[U64] = []
    mut val i: U64 = 0
    while i < add.count() { r.append(add[i])  i += 1 }
    mut val j: U64 = 0
    while j < base.count() { r.append(base[j])  j += 1 }
    return r
}

// Element-wise structural equality of two type-argument lists.
fn typeArgsEq(c: inout Comp, a: Array[U64], b: Array[U64]) -> Bool {
    if a.count() != b.count() {
        return false
    }
    mut val i: U64 = 0
    while i < a.count() {
        if !(c.typeRefEq(a: a[i], b: b[i])) {
            return false
        }
        i += 1
    }
    return true
}

// The Plew-type-kind tag (0 int/signed, 1 String, 2 Bool, 3 unsigned) of a type
// name span. Used to tag locals/params at declaration.
fn kindFromTySpan(c: inout Comp, tyStart: U64, tyLen: U64) -> U64 {
    // a `newtype` (spec/10) shares its underlying type's representation AND value-kind
    // (a `newtype UserId = String` formats/dispatches as a String): resolve to the
    // underlying first so a newtype local/cast carries the right kind (1=String, …).
    val ntu: Bind = c.newtypeUnderName(start: tyStart, len: tyLen)
    if ntu.nameStart != tyStart || ntu.nameLen != tyLen {
        return kindFromTySpan(c: inout c, tyStart: ntu.nameStart, tyLen: ntu.nameLen)
    }
    if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "String") { return 1U64 }
    if rangeEquals(bytes: c.arena.bytes, start: tyStart, len: tyLen, kw: "Bool") { return 2U64 }
    if c.isFloatType(start: tyStart, len: tyLen) { return 4U64 }
    if isUnsignedName(c: inout c, start: tyStart, len: tyLen) { return 3U64 }
    return 0U64
}

// Append the decimal digits of n to a byte buffer (for synthetic symbol names).
// Uses digitStrU's per-digit String (its bytes are U8) to avoid a U64->U8 narrow,
// which Plew's lossless `as` does not allow.
fn appendU64Dec(into: inout Array[U8], n: U64) {
    if n >= 10U64 {
        appendU64Dec(into: inout into, n: n / 10U64)
    }
    appendBytes(into: inout into, from: digitStrU(d: n % 10U64).bytes())
}

// Append the 8 little-endian bytes of `n` as i8 constants (for a rawbuf-shaped global's
// i64 cap/rc header, built as a flat i8 array constant).
fn appendU64Le(into: inout Array[LLVMValueRef], n: U64, i8ty: LLVMTypeRef) {
    mut val k: U64 = 0
    while k < 8U64 {
        into.append(LLVMConstInt(i8ty, (n >> (k * 8U64)) & 255U64, 0I32))
        k += 1
    }
}

// Find the registered generic-fn instance slot for (fnIdx, args), or count.
fn genFnSlotFor(c: inout Comp, fnIdx: U64, args: Array[U64], recvInstRef: U64, st: inout LlvmCtx) -> U64 {
    mut val slot: U64 = 0
    while slot < st.genFnK.count() {
        val fin: FnInst = c.monoWork.fnInsts[st.genFnK[slot]]
        if fin.fnIdx == fnIdx && c.sameBodyReceiver(a: fin.recvInstRef, b: recvInstRef) {
            if typeArgsEq(c: inout c, a: fin.args, b: args) {
                return slot
            }
        }
        slot += 1
    }
    return st.genFnK.count()
}

fn wOvf(p: String, ct: String, name: String, bi: String) {
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: name)
    write(s: "(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ ")
    write(s: ct)
    write(s: " r; if(")
    write(s: bi)
    write(s: "(a,b,&r)) plew_panic_raw(\"integer overflow\",16); return r; }\n")
}

// The checked integer helpers for one width-prefix `p` / C-type `ct` (signed min
// `mn`, `sgn` = signed). Add/Sub/Mul overflow-panic, Div/Rem div-by-zero-panic
// (+ signed INT_MIN/-1 overflow), and signed widths also get a checked Neg.
fn wLlvmChecked(p: String, ct: String, mn: String, sgn: Bool) {
    wOvf(p: p, ct: ct, name: "Add", bi: "__builtin_add_overflow")
    wOvf(p: p, ct: ct, name: "Sub", bi: "__builtin_sub_overflow")
    wOvf(p: p, ct: ct, name: "Mul", bi: "__builtin_mul_overflow")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "Div(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ if(b==0) plew_panic_raw(\"division by zero\",16); ")
    if sgn {
        write(s: "if(b==-1 && a==")
        write(s: mn)
        write(s: ") plew_panic_raw(\"integer overflow\",16); ")
    }
    write(s: "return a/b; }\n")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "Rem(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ if(b==0) plew_panic_raw(\"remainder by zero\",17); ")
    if sgn {
        write(s: "if(b==-1) return 0; ")
    }
    write(s: "return a%b; }\n")
    if sgn {
        write(s: ct)
        write(s: " plew_")
        write(s: p)
        write(s: "Neg(")
        write(s: ct)
        write(s: " a){ ")
        write(s: ct)
        write(s: " r; if(__builtin_sub_overflow((")
        write(s: ct)
        write(s: ")0,a,&r)) plew_panic_raw(\"integer overflow\",16); return r; }\n")
    }
}

// All width-prefixed checked integer helpers (i8..i64 signed, u8..u64 unsigned).
fn emitLlvmIntChecked() {
    wLlvmChecked(p: "i8", ct: "int8_t", mn: "INT8_MIN", sgn: true)
    wLlvmChecked(p: "i16", ct: "int16_t", mn: "INT16_MIN", sgn: true)
    wLlvmChecked(p: "i32", ct: "int32_t", mn: "INT32_MIN", sgn: true)
    wLlvmChecked(p: "i64", ct: "int64_t", mn: "INT64_MIN", sgn: true)
    wLlvmChecked(p: "u8", ct: "unsigned char", mn: "", sgn: false)
    wLlvmChecked(p: "u16", ct: "uint16_t", mn: "", sgn: false)
    wLlvmChecked(p: "u32", ct: "uint32_t", mn: "", sgn: false)
    wLlvmChecked(p: "u64", ct: "uint64_t", mn: "", sgn: false)
}

export fn emitLlvmRuntime() {
    write(s: "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <sys/wait.h>\n")
    write(s: "void plew_exit(long long code){ exit((int)code); }\n")
    write(s: "void plew_write_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); }\n")
    write(s: "void plew_eprint_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stderr); }\n")
    // panic = abort (spec/11 "panic と発散"): print the message, then trap — no
    // unwind, no exit-time flushing/handlers, no deinit. Every runtime panic
    // funnels through this one kernel so the termination style cannot drift.
    write(s: "__attribute__((noreturn)) void plew_panic_raw(const char* d, long long n){ fputs(\"panic: \",stderr); fwrite(d,1,(size_t)n,stderr); fputc('\\n',stderr); abort(); }\n")
    // print(x) formatters (textual form + newline), matching the Plew Format impls.
    write(s: "void plew_print_str(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); fputc('\\n',stdout); }\n")
    write(s: "void plew_print_i64(long long v){ printf(\"%lld\\n\", v); }\n")
    write(s: "void plew_print_f64(double v){ printf(\"%g\\n\", v); }\n")
    write(s: "void plew_print_u64(unsigned long long v){ printf(\"%llu\\n\", v); }\n")
    write(s: "void plew_print_bool(long long v){ fputs(v?\"1\":\"0\",stdout); fputc('\\n',stdout); }\n")
    write(s: "long long plew_str_eq(const char* a, long long na, const char* b, long long nb){ if(na!=nb) return 0; for(long long i=0;i<na;i++) if(a[i]!=b[i]) return 0; return 1; }\n")
    // C1: a String VALUE is the rawbuf data pointer (count in the heap header), so the
    // runtime's String-returning intrinsics return `char*` (the data pointer) after stamping
    // the live length into the header via plew_rawbuf_set_count. String buffers are rawbuf-
    // shaped: plew_str_buf(n) gives an n+1-byte rawbuf (rc=1, freeable, count to be set by the
    // caller); plew_str_empty is a shared never-free (sentinel rc) count=0 empty. (forward-decl
    // rawbuf_alloc / set_count, defined below.)
    write(s: "void* plew_rawbuf_alloc(long long elemSize, long long cap);\n")
    write(s: "void plew_rawbuf_set_count(void* p, long long n);\n")
    write(s: "static char* plew_str_buf(long long n){ return (char*)plew_rawbuf_alloc(1, n+1); }\n")
    write(s: "static char* plew_str_empty(void){ static char* e=0; if(!e){ e=(char*)plew_rawbuf_alloc(1,1); e[0]=0; ((long long*)e)[-1]=(long long)1<<62; } return e; }\n")
    write(s: "char* plew_f64_to_str(double v){ char buf[32]; int n=snprintf(buf,32,\"%g\",v); char* b=plew_str_buf(n); memcpy(b,buf,(size_t)n); b[n]=0; plew_rawbuf_set_count(b,(long long)n); return b; }\n")
    write(s: "void plew_f64_nan_check(double a, double b){ if(a!=a || b!=b) plew_panic_raw(\"NaN comparison\",14); }\n")
    write(s: "char* plew_readStdin(void){ size_t cap=4096,len=0; char* buf=(char*)malloc(cap); int ch; while((ch=getchar())!=EOF){ if(len+1>=cap){cap*=2;buf=(char*)realloc(buf,cap);} buf[len++]=(char)ch; } char* b=plew_str_buf((long long)len); if(len) memcpy(b,buf,len); b[len]=0; free(buf); plew_rawbuf_set_count(b,(long long)len); return b; }\n")
    // FFI String <-> C-string (spec/15): cString materializes a NUL-terminated copy
    // (caller-owned; cFree releases it — CString's deinit is the canonical caller);
    // stringFromCString copies a NUL-terminated C string.
    write(s: "unsigned char* plew_cString(char* d, long long n){ unsigned char* b=(unsigned char*)malloc((size_t)n+1); if(n) memcpy(b,d,(size_t)n); b[n]=0; return b; }\n")
    write(s: "void plew_cFree(unsigned char* p){ free(p); }\n")
    write(s: "char* plew_stringFromCString(unsigned char* p){ if(!p) return plew_str_empty(); size_t n=strlen((const char*)p); char* b=plew_str_buf((long long)n); memcpy(b,p,n); b[n]=0; plew_rawbuf_set_count(b,(long long)n); return b; }\n")
    // Array / Buffer storage floor (a [cap][count][rc][data...] block). The pointer is
    // the data; three header words sit before it: cap=[-3], count=[-2], rc=[-1]. `count`
    // is the floor's own live-element count — the Buffer intrinsics maintain it; the
    // legacy Array path tracks count in its {ptr,i64} value and leaves this slot 0.
    // alloc seeds count=0, rc=1; binding an array eager-copies (arr_copy), so an array
    // buffer is sole-owned (rc==1, never retained — only `Ref` cells are). grow therefore
    // FREES the buffer it replaces on realloc (guarded by rc<=1 — a shared buffer is left
    // alone, leak-safe), reclaiming the geometric-growth intermediates an append chain
    // would otherwise leak. per-element load/store is inlined in IR via typed GEP.
    write(s: "void* plew_rawbuf_alloc(long long elemSize, long long cap){ long long* h=(long long*)malloc(3*sizeof(long long)+(size_t)(elemSize*cap)); h[0]=cap; h[1]=0; h[2]=1; return (void*)(h+3); }\n")
    write(s: "long long plew_rawbuf_cap(void* p){ return p?((long long*)p)[-3]:0; }\n")
    // header `count` accessors (the Buffer floor's live-element count).
    write(s: "long long plew_rawbuf_count(void* p){ return p?((long long*)p)[-2]:0; }\n")
    write(s: "void plew_rawbuf_set_count(void* p, long long n){ if(p) ((long long*)p)[-2]=n; }\n")
    write(s: "void* plew_arr_grow(void* data, long long elemSize, long long count){ long long cap=plew_rawbuf_cap(data); if(count<cap) return data; long long nc=cap<8?8:cap*2; void* nd=plew_rawbuf_alloc(elemSize,nc); if(count){ memcpy(nd,data,(size_t)(elemSize*count)); ((long long*)nd)[-2]=((long long*)data)[-2]; } if(data){ if(((long long*)data)[-1]<=1) free((long long*)data-3); else ((long long*)data)[-1]--; } return nd; }\n")
    write(s: "void* plew_arr_copy(void* data, long long elemSize, long long count){ void* nd=plew_rawbuf_alloc(elemSize,count<1?1:count); if(count){ memcpy(nd,data,(size_t)(elemSize*count)); ((long long*)nd)[-2]=((long long*)data)[-2]; } return nd; }\n")
    write(s: "void plew_rawbuf_retain(void* p){ if(p) ((long long*)p)[-1]++; }\n")
    write(s: "long long plew_rawbuf_release(void* p){ if(!p) return 0; return --((long long*)p)[-1]; }\n")
    // drop one owner: decrement the refcount, free the cell at 0. The sentinel rc
    // (1<<62, string literals / shared empty string) never reaches 0.
    write(s: "void plew_rawbuf_drop(void* p){ if(!p) return; if(--((long long*)p)[-1]==0) free((long long*)p-3); }\n")
    // free a rawbuf cell unconditionally (the caller has already established rc reached 0
    // and released the element heap); a null / sentinel-rc cell is left alone.
    write(s: "void plew_rawbuf_free(void* p){ if(!p) return; if(((long long*)p)[-1]>((long long)1<<61)) return; free((long long*)p-3); }\n")
    // `Ref`/`WeakRef` two-counter control block (spec/03): the cell reuses the rawbuf
    // header — strong = [-1] (init 1), weak = [-2] (init 0, the unused Buffer `count` slot).
    // weak()  : bump the weak count, return the same cell as a `WeakRef` handle.
    write(s: "void* plew_ref_weak(void* p){ if(p) ((long long*)p)[-2]++; return p; }\n")
    // upgrade(): if the pointee is still alive (strong>0) take a new strong owner and return
    // the cell (a `Ref`); else return null (the pointee was destroyed) → `Optional.None`.
    write(s: "void* plew_ref_upgrade(void* p){ if(p && ((long long*)p)[-1]>0){ ((long long*)p)[-1]++; return p; } return 0; }\n")
    // alive(): the current strong count (0 once the pointee was destroyed) — `weakAlive` tests
    // `> 0` to decide upgrade's Some/None without taking an owner.
    write(s: "long long plew_ref_strong(void* p){ return p ? ((long long*)p)[-1] : 0; }\n")
    // strong release reached 0 (pointee deinit已 run by codegen): free the cell ONLY when no
    // weak observers remain; otherwise keep the allocation so a later upgrade reads strong==0.
    write(s: "void plew_ref_dispose_strong(void* p){ if(!p) return; if(((long long*)p)[-2]==0) free((long long*)p-3); }\n")
    // drop one weak observer: decrement the weak count; free the cell when it is the last
    // reference of either kind (weak==0 AND strong already 0 — the pointee is long gone).
    write(s: "void plew_weak_release(void* p){ if(!p) return; if(--((long long*)p)[-2]==0 && ((long long*)p)[-1]==0) free((long long*)p-3); }\n")
    // copy-on-write a (scalar-element) array buffer before an in-place mutation: if the
    // buffer is shared (rc>1), allocate a private rc=1 copy of `count` elements, drop one
    // owner from the shared original, and return the copy; otherwise return it unchanged.
    write(s: "void* plew_arr_cow(void* data, long long elemSize, long long count){ if(data && ((long long*)data)[-1]>1){ void* nd=plew_rawbuf_alloc(elemSize,count<1?1:count); if(count){ memcpy(nd,data,(size_t)(elemSize*count)); ((long long*)nd)[-2]=((long long*)data)[-2]; } ((long long*)data)[-1]--; return nd; } return data; }\n")
    // grow a buffer's capacity to at least `mincap` (reserve), preserving the live
    // elements + count; a no-op when cap already suffices. The caller has privatized
    // (rc<=1), so the old cell is freed when reallocated.
    write(s: "void* plew_arr_reserve(void* data, long long elemSize, long long mincap){ long long cap=plew_rawbuf_cap(data); if(cap>=mincap) return data; void* nd=plew_rawbuf_alloc(elemSize,mincap); long long cnt=plew_rawbuf_count(data); if(cnt){ memcpy(nd,data,(size_t)(elemSize*cnt)); ((long long*)nd)[-2]=cnt; } if(data){ if(((long long*)data)[-1]<=1) free((long long*)data-3); else ((long long*)data)[-1]--; } return nd; }\n")
    // relocate `n` element slots within a buffer (insertAt/removeAt shift). A pure byte
    // move: each element's inline bytes (incl any heap reference) move intact, so no
    // element retain/release is needed (buffer-floor.md §5 relocation = memmove).
    write(s: "void plew_rawbuf_move(void* data, long long elemSize, long long dst, long long src, long long n){ if(n>0) memmove((char*)data+(size_t)(elemSize*dst),(char*)data+(size_t)(elemSize*src),(size_t)(elemSize*n)); }\n")
    write(s: "void plew_bounds(long long i, long long n){ if(i<0||i>=n) plew_panic_raw(\"index out of bounds\",19); }\n")
    // overlapping `inout` (spec/03): two `inout` positions of one call resolved to the
    // SAME place at runtime (`arr[i]`/`arr[j]` with i==j, two Refs to one cell) — the
    // exclusivity the callee relies on does not hold, so panic loudly at the call.
    write(s: "void plew_inout_overlap(void* a, void* b){ if(a&&a==b) plew_panic_raw(\"overlapping inout: two inout positions of one call overlap in the same shared cell\",82); }\n")
    // checked integer arithmetic floor (overflow / divide-by-zero panic, spec/12):
    // the witness/compound paths call `plew_<w><Op>` instead of a raw IR op, so the
    // LLVM backend matches the C backend's loud overflow/div-zero behaviour.
    emitLlvmIntChecked()
    // ---- process args + file I/O (the path-taking intrinsics take (ptr,i64), so
    // no struct-by-value ABI is assumed; readers return a rawbuf data pointer). ----
    write(s: "static int plew_argc = 0; static char** plew_argv = 0;\n")
    write(s: "void plew_set_args(int argc, char** argv){ plew_argc = argc; plew_argv = argv; }\n")
    write(s: "long long plew_argCount(void){ return (long long)plew_argc; }\n")
    write(s: "char* plew_argAt(long long i){ if(i<0||i>=plew_argc) return plew_str_empty(); size_t n=strlen(plew_argv[i]); char* b=plew_str_buf((long long)n); memcpy(b,plew_argv[i],n); b[n]=0; plew_rawbuf_set_count(b,(long long)n); return b; }\n")
    write(s: "void plew_writeByte(unsigned char b){ putchar((int)b); }\n")
    write(s: "unsigned long long plew_random_u64(void){ unsigned long long x=0; FILE* f=fopen(\"/dev/urandom\",\"rb\"); if(f){ size_t r=fread(&x,sizeof(x),1,f); fclose(f); if(r==1) return x; } return ((unsigned long long)(uintptr_t)&x * 0x9E3779B97F4A7C15ULL) | 1ULL; }\n")
    write(s: "unsigned long long plew_dict_seed(void){ static unsigned long long s=0; static int init=0; if(!init){ s=plew_random_u64(); init=1; } return s; }\n")
    write(s: "static char* plew_readPath(const char* path){ FILE* f=fopen(path,\"rb\"); if(!f) return plew_str_empty(); fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char* buf=plew_str_buf((long long)sz); size_t n=fread(buf,1,(size_t)sz,f); fclose(f); buf[n]=0; plew_rawbuf_set_count(buf,(long long)n); return buf; }\n")
    write(s: "char* plew_readFile(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; char* r=plew_readPath(p); free(p); return r; }\n")
    write(s: "char* plew_readFileBytes(char* d, long long n){ return plew_readFile(d,n); }\n")
    write(s: "long long plew_fileExists(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; FILE* f=fopen(p,\"rb\"); free(p); if(f){ fclose(f); return 1; } return 0; }\n")
    // ---- process execution (spec/17 dep resolution: run `git` from a tool) ----
    // plew_execOut runs `sh -c <cmd>`, captures stdout, and stashes the child's
    // exit status in plew_last_exit (read via plew_execCode). One static holds the
    // status so both values cross the intrinsic boundary as plain scalars/String.
    write(s: "static long long plew_last_exit = 0;\n")
    write(s: "char* plew_execOut(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; FILE* f=popen(p,\"r\"); free(p); if(!f){ plew_last_exit=-1; return plew_str_empty(); } size_t cap=4096,len=0; char* buf=(char*)malloc(cap); size_t r; while((r=fread(buf+len,1,cap-len,f))>0){ len+=r; if(len==cap){ cap*=2; buf=(char*)realloc(buf,cap); } } int st=pclose(f); plew_last_exit=(long long)(WIFEXITED(st)?WEXITSTATUS(st):-1); char* ob=plew_str_buf((long long)len); if(len) memcpy(ob,buf,len); ob[len]=0; free(buf); plew_rawbuf_set_count(ob,(long long)len); return ob; }\n")
    write(s: "long long plew_execCode(void){ return plew_last_exit; }\n")
    // ---- async runtime (event loop / promises / timers) ----
    //
    // The SAME runtime as the C backend (Codegen/Async.pw), but the symbols the IR
    // calls (promise_new / promise_resolve / sleep / loop_run / frame_alloc /
    // frame_free) have EXTERNAL linkage — the IR is a separate translation unit, so
    // `static` (file-local, as in the single-TU C backend) would leave them
    // unresolved at link time. The queues/timers and their helpers stay file-local.
    // PlewPromise's layout matches the IR's { i32 done, i64 value, ptr k, ptr kframe }.
    write(s: "typedef struct PlewPromise PlewPromise;\n")
    write(s: "typedef void (*PlewResumeFn)(void*);\n")
    write(s: "struct PlewPromise { int done; long long value; PlewResumeFn k; void* kframe; };\n")
    write(s: "typedef struct { PlewResumeFn fn; void* arg; } PlewTask;\n")
    write(s: "static PlewTask* plew_ready = 0; static long long plew_ready_len = 0, plew_ready_cap = 0, plew_ready_head = 0;\n")
    write(s: "static void plew_enqueue(PlewResumeFn fn, void* arg) { if (plew_ready_len == plew_ready_cap) { plew_ready_cap = plew_ready_cap ? plew_ready_cap * 2 : 16; plew_ready = (PlewTask*)realloc(plew_ready, (size_t)plew_ready_cap * sizeof(PlewTask)); } plew_ready[plew_ready_len].fn = fn; plew_ready[plew_ready_len].arg = arg; plew_ready_len++; }\n")
    write(s: "static int plew_dequeue(PlewTask* out) { if (plew_ready_head >= plew_ready_len) { plew_ready_head = 0; plew_ready_len = 0; return 0; } *out = plew_ready[plew_ready_head++]; return 1; }\n")
    write(s: "typedef struct { long long deadline; PlewPromise* p; } PlewTimer;\n")
    write(s: "static PlewTimer* plew_timers = 0; static long long plew_timers_len = 0, plew_timers_cap = 0; static long long plew_vnow = 0;\n")
    write(s: "void* plew_frame_alloc(long long sz) { return calloc(1, (size_t)sz); }\n")
    write(s: "void plew_frame_free(void* p) { free(p); }\n")
    // a promise is an rc'd rawbuf cell (header rc=1 = the creator's ownership): the async
    // fn's frame owns one count (released after the final resolve), the returned Promise
    // VALUE owns another (retained at the entry thunk's return; released by its binding's
    // scope-exit drop / awaited-temp drop), and a pending timer owns a third.
    write(s: "PlewPromise* plew_promise_new(void) { PlewPromise* p = (PlewPromise*)plew_rawbuf_alloc((long long)sizeof(PlewPromise), 1); p->done = 0; p->value = 0; p->k = 0; p->kframe = 0; return p; }\n")
    write(s: "void plew_promise_resolve(PlewPromise* p, long long v) { p->done = 1; p->value = v; if (p->k) { PlewResumeFn k = p->k; void* f = p->kframe; p->k = 0; plew_enqueue(k, f); } }\n")
    write(s: "static void plew_timer_add(long long delay, PlewPromise* p) { if (plew_timers_len == plew_timers_cap) { plew_timers_cap = plew_timers_cap ? plew_timers_cap * 2 : 8; plew_timers = (PlewTimer*)realloc(plew_timers, (size_t)plew_timers_cap * sizeof(PlewTimer)); } plew_timers[plew_timers_len].deadline = plew_vnow + delay; plew_timers[plew_timers_len].p = p; plew_timers_len++; }\n")
    // the timer co-owns the promise until it fires (retain here, drop in plew_loop_run
    // after the resolve) — the returned value keeps the creation count.
    write(s: "PlewPromise* plew_sleep(long long ms) { PlewPromise* p = plew_promise_new(); plew_rawbuf_retain(p); plew_timer_add(ms, p); return p; }\n")
    write(s: "void plew_loop_run(void) { PlewTask t; while (1) { while (plew_dequeue(&t)) { t.fn(t.arg); } if (plew_timers_len == 0) break; long long bi = -1, bd = 0; for (long long i = 0; i < plew_timers_len; i++) { if (bi < 0 || plew_timers[i].deadline < bd) { bi = i; bd = plew_timers[i].deadline; } } PlewPromise* p = plew_timers[bi].p; plew_vnow = plew_timers[bi].deadline; plew_timers[bi] = plew_timers[--plew_timers_len]; plew_promise_resolve(p, 0); plew_rawbuf_drop(p); } }\n")
}

fn floatTextCPtr(c: inout Comp, start: U64, len: U64) -> CPtr[U8] {
    mut val bs: Array[U8] = []
    mut val i: U64 = 0
    while i < len {
        val byte: U8 = c.arena.bytes[start + i]
        // `_` is lexical digit grouping, not part of LLVM's numeric grammar.
        // Both legacy and Mid use this normalization; numeric value formation
        // must not depend on which lowering path happened to be selected.
        if byte != 95U8 { bs.append(byte) }
        i += 1U64
    }
    return cstr(s: stringFromBytesUnchecked(bs))
}

fn floatTextLen(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val out: U64 = 0U64
    mut val i: U64 = 0U64
    while i < len {
        if c.arena.bytes[start + i] != 95U8 { out += 1U64 }
        i += 1U64
    }
    return out
}

fn cstr(s: String) -> CPtr[U8] {
    return cString(s)
}

// Empty instruction name (LLVM auto-numbers unnamed values).
fn anon() -> CPtr[U8] {
    return cString("")
}

fn structDeinitFi(c: inout Comp, sidx: U64) -> U64 {
    return c.structOwnDeinitFi(sidx: sidx)
}

// ---- string literals ----
//
// Decode one C-style escape (the byte after a backslash) to its actual byte.
fn escByte(nx: U8) -> U8 {
    if nx == 110 { return 10 }
    if nx == 116 { return 9 }
    if nx == 114 { return 13 }
    if nx == 48 { return 0 }
    return nx
}

// Decode a string literal's source span (start = the opening quote) to its actual
// bytes plus a trailing NUL, mirroring strDecodedLen's escape model (a backslash
// escapes the next byte). The trailing NUL makes it usable as a C string for
// LLVMBuildGlobalStringPtr; the PlewString length excludes it.
// Value of one ASCII hex digit (0-9 / a-f / A-F); 0 for anything else.
fn hexDigitVal(b: U8) -> U64 {
    if b >= 48U8 && b <= 57U8 { return (b - 48U8) as U64 }
    if b >= 97U8 && b <= 102U8 { return (b - 87U8) as U64 }
    if b >= 65U8 && b <= 70U8 { return (b - 55U8) as U64 }
    return 0U64
}

// UTF-8 encode a Unicode scalar `cp` (from a `\u{...}` escape) into `out`.
fn appendUtf8(out: inout Array[U8], cp: U64) {
    if cp < 128U64 {
        out.append(truncU8(n: cp))
        return
    }
    if cp < 2048U64 {
        out.append(truncU8(n: 192U64 | (cp >> 6U64)))
        out.append(truncU8(n: 128U64 | (cp & 63U64)))
        return
    }
    if cp < 65536U64 {
        out.append(truncU8(n: 224U64 | (cp >> 12U64)))
        out.append(truncU8(n: 128U64 | ((cp >> 6U64) & 63U64)))
        out.append(truncU8(n: 128U64 | (cp & 63U64)))
        return
    }
    out.append(truncU8(n: 240U64 | (cp >> 18U64)))
    out.append(truncU8(n: 128U64 | ((cp >> 12U64) & 63U64)))
    out.append(truncU8(n: 128U64 | ((cp >> 6U64) & 63U64)))
    out.append(truncU8(n: 128U64 | (cp & 63U64)))
}

fn strDecodeBytes(c: inout Comp, start: U64, len: U64) -> Array[U8] {
    mut val out: Array[U8] = []
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if c.arena.bytes[j] == 92 {
            if c.arena.bytes[j + 1] == 117U8 {
                // \u{XXXX}: parse hex code point between braces, UTF-8 encode it.
                mut val k: U64 = j + 2
                if k < end && c.arena.bytes[k] == 123U8 { k += 1 }
                mut val cp: U64 = 0U64
                while k < end && c.arena.bytes[k] != 125U8 {
                    cp = (cp << 4U64) | hexDigitVal(b: c.arena.bytes[k])
                    k += 1
                }
                if k < end && c.arena.bytes[k] == 125U8 { k += 1 }
                // a `\u{...}` escape must name a valid Unicode SCALAR (spec/02: String
                // is valid UTF-8): reject a value above U+10FFFF or in the surrogate
                // range U+D800..U+DFFF, which would encode to invalid UTF-8 bytes.
                if cp > 1114111U64 {
                    c.errorAt(offset: start, msg: "`\\u{...}` escape is out of range — a Unicode scalar is at most U+10FFFF (spec/02)")
                }
                if cp >= 55296U64 {
                    if cp <= 57343U64 {
                        c.errorAt(offset: start, msg: "`\\u{...}` escape is a UTF-16 surrogate (U+D800..U+DFFF), not a valid Unicode scalar (spec/02)")
                    }
                }
                appendUtf8(out: inout out, cp: cp)
                j = k
            } else {
                out.append(escByte(nx: c.arena.bytes[j + 1]))
                j += 2
            }
        } else {
            out.append(c.arena.bytes[j])
            j += 1
        }
    }
    out.append(0)
    return out
}


// Whether a struct is registerable as a named LLVM value type in this increment:
// non-generic, non-extern, non-unique, and every field is either an array (the
// {ptr,i64} value type, element-agnostic), a primitive scalar/String/Bool, an
// extern lang-item struct field (I64/String/Bool), or a *nested registerable*
// struct (struct-of-struct). Enum fields and generic-instance fields are not yet
// modeled. Value types cannot be cyclic by value, so the recursion terminates.
fn structRegisterable(c: inout Comp, sidx: U64) -> Bool {
    val sd: StructDef = c.arena.structs[sidx]
    if sd.typeParams.count() > 0 { return false }
    if sd.isExtern { return false }
    // unique structs are now registerable (same field layout); their deinit runs at
    // scope-exit drop (emitted via the synthetic `deinit` method).
    mut val i: U64 = 0
    while i < sd.fields.count() {
        val f: FieldDef = sd.fields[i]
        // a boxed (recursive) field is a heap pointer regardless of its pointee
        // type — always representable, and it breaks the recursion cycle (we don't
        // recurse into the pointee, so a mutually-recursive struct still terminates).
        if c.fieldIsBoxed(f: f) {
            i += 1
        } else {
            if f.tyIsArray {
            } else if c.isGenericInst(ref: f.ty) {
                // a generic-instance field (`o: Optional[I64]`, `b: Box[I32]`): its
                // concrete instance is registered as a named tagged-union / struct type
                // (every reached instance in c.monoWork.genInsts is registered), so the field is
                // representable by value. The named type is created before any body is
                // set, so referencing it here is order-independent.
            } else {
                // an enum-typed field (`kind: Kind`): the enum's tagged-union value by
                // value — OK if the enum is itself representable (pure predicate, so
                // registration order doesn't matter; non-boxed value cycles are a
                // front-end error, so the mutual recursion terminates).
                val feid: U64 = c.enumIdxByName(start: f.tyStart, len: f.tyLen)
                if feid < c.arena.enums.count() {
                    if !(enumRepresentable(c: inout c, eid: feid)) {
                        return false
                    }
                } else {
                    val fsi: U64 = c.structIndexByName(start: f.tyStart, len: f.tyLen)
                    if fsi < c.arena.structs.count() {
                        // an extern struct field is a primitive lang-item (ok); a real
                        // nested struct must itself be registerable (recursively).
                        if !(c.arena.structs[fsi].isExtern) {
                            if !(structRegisterable(c: inout c, sidx: fsi)) {
                                return false
                            }
                        }
                    }
                    // else: a primitive scalar name (I8.. / unknown) -> a scalar.
                }
            }
            i += 1
        }
    }
    return true
}

// Whether an enum is representable as a named tagged-union `{ i64 tag, [maxWords x
// i64] payload }` — pure (type-graph only, registration-order-independent): every
// variant field is primitive/array/boxed, or a representable struct/enum (recursing
// through the pure predicates). Non-boxed value cycles are a front-end error, so the
// mutual recursion with structRegisterable terminates.
fn enumRepresentable(c: inout Comp, eid: U64) -> Bool {
    val e: EnumDef = c.arena.enums[eid]
    if e.typeParams.count() > 0 { return false }
    mut val vi: U64 = 0
    while vi < e.variants.count() {
        val fs: Array[FieldDef] = e.variants[vi].fields
        mut val fj: U64 = 0
        while fj < fs.count() {
            if c.fieldIsBoxed(f: fs[fj]) {
                fj += 1
            } else {
                if fs[fj].tyIsArray {
                    fj += 1
                } else if c.isGenericInst(ref: fs[fj].ty) {
                    // a generic-instance variant payload (`A(o: Optional[I64])`): its
                    // concrete instance is a registered named type (see structRegisterable).
                    fj += 1
                } else {
                    val peid: U64 = c.enumIdxByName(start: fs[fj].tyStart, len: fs[fj].tyLen)
                    if peid < c.arena.enums.count() {
                        if !(enumRepresentable(c: inout c, eid: peid)) {
                            return false
                        }
                    } else {
                        val si: U64 = c.structIndexByName(start: fs[fj].tyStart, len: fs[fj].tyLen)
                        if si < c.arena.structs.count() {
                            if !(c.arena.structs[si].isExtern) {
                                if !(structRegisterable(c: inout c, sidx: si)) {
                                    return false
                                }
                            }
                        }
                        // else: a primitive scalar (I8.. / String / Bool / unknown).
                    }
                    fj += 1
                }
            }
        }
        vi += 1
    }
    return true
}
