// @Backend — the LLVM emitter of the self-hosted Plew compiler. It consumes the
// front-end's analyzed `Comp` (built by `./Frontend`'s `runFrontend`) and emits
// textual LLVM IR via libLLVM-C; `emitLlvm` is the entry the root `main` calls
// after `runFrontend`, `emitLlvmRuntime` emits the companion C runtime. It `import`s
// the IR data (`./Ir`) and the front-end query/analysis API (`./Frontend`) — a
// one-way dependency (Ir ← Frontend ← Backend), so the module graph is a DAG.

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint, fileExists }
import @Std/Process with { argCount, argAt, exit }
import @Std/Ffi with { cString, stringFromCString, arrayCPtr }
import @Std/Core with { stringFromBytesUnchecked, truncU8, truncU32 }
import @Plew/Syntax with { Kind, Tok, Lexer, lex, kindCode, rangeEquals, P, parseBlockAst, parseExprAst, parseProgramAst, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst, emptyExpr }
import ./Ir with { PType, TypeRef, ArcClass, CaptureEntry, Local, TypeInfo, MakeFieldOrigin, MakeField, MakeFieldRange, Bind, BindRange, Arg, ArgRange, ExprRange, MatchArm, MatchArmRange, FuncParamRange, PatInfo, IdentBinding, Block, Param, FieldDef, StructDef, Variant, TraitDef, DeriveReq, AssocBinding, ChainSite, DestructureSite, Conform, MethodAlias, FuncBound, FnInst, InstanceEnvironment, CallResolution, CallTarget, CallResultProjection, CallReceiverPassing, CallArgumentPassing, RuntimeIntrinsic, IoIntrinsic, ProcessIntrinsic, CoreStringIntrinsic, FfiIntrinsic, NumericIntrinsic, NumericConversionIntrinsic, NumericWidth, IntegerOperation, FloatWidth, FloatOperation, BoolOperation, NumericOverflow, BufferIntrinsic, ValueConversionProof, EnumPayloadConversion, EnumDef, Func, Global, NewtypeDef, Arena, Decls, Modules, MonoWork, TypeCache, Interner, ParseScratch, Cursor, Expr, Stmt, appendBytes, identUnfilledCode, identValueCode, identFnCode, identNoTarget }
import ./Frontend with { Comp, intern, spansEqual, runFrontend, tracePhase, tracePhaseCount }
// Import the Mid vocabulary at the backend boundary now.  Lowering is migrated
// body-by-body; keeping this edge one-way prevents Mid from becoming another
// frontend `part` or from reaching LLVM through ambient AST recovery.
import ./Mid with { MidPlace, MidConstant, MidOperand, MidAggregateKind, MidAggregateElement, MidRvalue, MidCastKind, MidCallTarget, MidCallReceiver, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidBody, MidVerification, MidVerifyError, MidUnsupportedBuild, MidUnsupportedAssign, MidBuildError, MidBodyBuild, MidInstantiateError, MidInstantiation, MidAccessError, MidAccessElaboration, buildParametricMidBody, instantiateMidBody, elaborateMidAccesses, elaborateMidDrops, verifyMidBody }
export ./Frontend with { Comp }
export @Plew/Syntax with { Kind, Tok, Lexer, P, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, TypeParamListAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst }
export ./Ir with { PType, TypeRef, ArcClass, CaptureEntry, Local, TypeInfo, MakeField, Bind, BindRange, Arg, ArgRange, MatchArm, MatchArmRange, PatInfo, IdentBinding, Block, Param, FieldDef, StructDef, Variant, TraitDef, DeriveReq, AssocBinding, ChainSite, DestructureSite, Conform, MethodAlias, FuncBound, FnInst, InstanceEnvironment, EnumDef, Func, Global, NewtypeDef, Arena, Decls, Modules, MonoWork, TypeCache, Interner, ParseScratch, Cursor, Expr, Stmt }
import ./Diag with { compileErrorAt, digitStrU }
import ./Ops with { opEq, opNe, opLt, opLe, opGt, opGe, opAdd, opSub, opMul, opDiv, opRem, opAnd, opOr, opNot, opBitAnd, opBitOr, opBitXor, opShl, opShr, opBitNot, opAssign, isBinTraitOp, binTraitMethodName, unaryMethodName }

// The initial backend subset is deliberately fail-closed. Keep the reason as
// a closed value rather than an anonymous Bool so coverage can account for
// every legacy fallback without inspecting source syntax.
//
// A call needs a second closed layer: `Call` is a boundary between Mid and an
// ABI, not one implementation feature.  Conflating its independent admission
// facts made coverage incapable of selecting the next lowering slice.
export enum MidCallPreflight {
    None
    Resolution
    Target
    Callee
    Async
    Receiver
    RuntimeAbi
    Buffer
    Extern
    GenericArguments
    ArgumentShape
    Result
    Argument
}

export enum MidLlvmPreflight {
    Ready
    AbiLocals
    AssignmentProjection
    UnsupportedRvalue
    ConversionOperand
    DropProjection
    ScopeExit
    Switch
    Call(reason: MidCallPreflight)
    ReturnValue
    Terminator
}

// These are frontend/ABI admission facts, separate from a Mid or LLVM
// preflight failure.  A body can report more than one reason; coverage uses
// that fact set to prioritize the next representation slice without guessing
// from function spelling.
export enum MidEligibilityReason {
    Async
    Extern
    InoutReceiver
    MoveReceiver
    Globals
}

// The direct-AST LLVM path's evidence for an addressable source place.  A raw
// `LLVMValueRef` alone is not enough: once a field GEP is followed by another
// field GEP, LLVM needs the *actual instantiated pointee layout*, not a type
// reconstructed from the source expression.  `typeRef`/`structIdx` are the
// corresponding semantic identity used only to name the next declared field.
// Mid has its own structural `MidPlace`; this is deliberately the temporary
// backend carrier while bodies migrate to Mid.
struct LlvmPlace {
    pub val ptr: LLVMValueRef
    pub val pointeeTy: LLVMTypeRef
    pub val typeRef: U64
    pub val structIdx: U64
}

pub impl LlvmPlace { factory }

// Backend work queues must not store an owning Array inside each slot. Generic
// method instances carry a variable number of method-owned type arguments, but
// a slot is routinely copied while the emission fixpoint drains. Keep the slot
// scalar and store its payload once in LlvmCtx's typed U64 pool.
struct LlvmTypeArgRange {
    pub val start: U64
    pub val len: U64
}

pub impl LlvmTypeArgRange { factory }

// One frozen body instance that did not take the Mid LLVM path. `bodyId` is
// the frontend's canonical BodyInstance identity; no source spelling or AST
// recovery is retained in this report.
// ---- backend state (threaded inout through the emitters) ----
//
// Holds the LLVM context/module/builder, cached primitive types, the current
// function being emitted, and the local-variable environment (a stack of
// name-span -> alloca pointer + element type; searched from the end so a
// shadowing redeclaration wins). `terminated` tracks whether the current basic
// block already has a terminator, so we never append after a ret/br.
struct LlvmCtx {
    // A diagnostic-only scalar table.  These three columns have identical
    // length and are appended solely by `recordMidCoverage`; avoiding a rich
    // record here ensures that reporting never owns or copies Mid internals.
    pub mut val midCoverageBodyIds: Array[U64]
    pub mut val midCoverageFnIdxs: Array[U64]
    pub mut val midCoverageKeys: Array[U64]
    pub val ctx: LLVMContextRef
    pub val mod: LLVMModuleRef
    pub mut val b: LLVMBuilderRef
    pub val i1ty: LLVMTypeRef
    pub val i8ty: LLVMTypeRef
    pub val i16ty: LLVMTypeRef
    pub val i32ty: LLVMTypeRef
    pub val i64ty: LLVMTypeRef
    // the IEEE-754 double type for float (F64/F32) literals and arithmetic. F32 is
    // represented as double for now (observably fine for the float floor; a true 32-bit
    // float is additive).
    pub val f64ty: LLVMTypeRef
    pub val voidty: LLVMTypeRef
    pub val ptrty: LLVMTypeRef
    // String / Array value type (C1): a single rawbuf data pointer; count + cap live in the
    // heap header [cap@-3][count@-2][rc@-1] (== ptrty). Both alias ptrty; see Backend init.
    pub val strty: LLVMTypeRef
    // Array value type: { ptr data, i64 count } (element behind the pointer).
    pub val arrayTy: LLVMTypeRef
    // Closure / function-value type: { ptr fn, ptr env } — a lambda-lifted function
    // pointer plus its captured-environment pointer (NULL for non-capturing). Every
    // `fn(...) -> ...` value is this fat pointer; the callee ABI takes env first.
    pub val closureTy: LLVMTypeRef
    // Existential `any P` value type (spec/08): { ptr data, ptr vtable } — a fat
    // pointer. `data` points at an ARC-boxed copy of the erased concrete value;
    // `vtable` at the static per-(concrete-type, trait) thunk table (slot 0 = drop,
    // slot 1.. = the trait's requirement methods in declaration order).
    pub val anyTy: LLVMTypeRef
    // built vtables, cached by (concrete struct idx, traitId, binding key) -> the LLVM
    // global value. The binding key distinguishes existentials whose associated-type /
    // type-parameter bindings differ (`any Add[I32,…]` vs `any Add[I64,…]`).
    pub mut val anyVtType: Array[U64]
    pub mut val anyVtTrait: Array[U64]
    pub mut val anyVtBindKey: Array[U64]
    pub mut val anyVtVal: Array[LLVMValueRef]
    pub mut val curFn: LLVMValueRef
    pub mut val terminated: Bool
    // the function currently being emitted: is it `main` (returns i32 0), and its
    // LLVM return type + whether it returns void (Plew `()`), so `return` and the
    // fall-through epilogue terminate with the right instruction.
    pub mut val curIsMain: Bool
    pub mut val curRetVoid: Bool
    pub mut val curRetTy: LLVMTypeRef
    pub mut val curRetTyStart: U64
    pub mut val curRetTyLen: U64
    // the value yielded by the innermost value-position block (a `give` statement
    // sets it; IfExpr reads it after emitting each branch block).
    pub mut val giveValue: LLVMValueRef
    // struct instances (parallel: TypeRef index -> LLVM type, def index). EVERY struct
    // lives here: a true generic instance (`Pair[I32]`) keyed by its arg-bearing ref, and a
    // non-generic struct as its own 0-type-arg instance (bare-name, no-args ref) pointing at
    // the same named `%st` type. A generic-typed local points locStructIdx at the def and
    // locTypeRef at the instance, so field access reuses the struct machinery + substitution.
    pub mut val genStructRefs: Array[U64]
    pub mut val genStructTys: Array[LLVMTypeRef]
    pub mut val genStructDefs: Array[U64]
    // enum instances (parallel: TypeRef ref -> LLVM type, def idx). Every enum lives here:
    // a generic instance (`Optional[I32]`) keyed by its arg-bearing ref, and a non-generic
    // enum keyed by its 0-type-arg (bare-name) ref. The one `%ge` mechanism (genEnumSlot).
    pub mut val genEnumRefs: Array[U64]
    pub mut val genEnumTys: Array[LLVMTypeRef]
    pub mut val genEnumDefs: Array[U64]
    // a byte span whose content is "self" (appended to c.arena.bytes), to bind the
    // method receiver as a local that the body's `self` identifiers resolve to.
    pub mut val selfStart: U64
    pub mut val selfLen: U64
    // while emitting a generic method body, the receiver's instantiation TypeRef
    // (so `self`'s LLVM type / struct-or-enum env resolve to the instance). 0 when
    // emitting a free function or a non-generic method.
    pub mut val curRecvInstRef: U64
    // the expected type of the expression about to be emitted (a let annotation, a
    // boxed field's pointee type, …) — used to infer a JSX generic-enum/struct
    // construction whose own `ty` is the ungrounded head (`<Optional.Some v=42 />`
    // with no `[I64]`). Consumed (cleared to 0) by the construction that uses it so
    // it doesn't leak into sub-expressions. 0 when no expectation is in effect.
    pub mut val expectedTy: U64
    // the current function/closure's return TypeRef (0 = void / none), so a `return
    // <Optional.Some …/>` infers its type args from the declared return type.
    pub mut val curRetRef: U64
    // the local index of the current function's FIRST body local (= param count
    // incl. self), so scope-exit deinit drops skip params (borrows/inout self that
    // the caller still owns and will deinit).
    pub mut val curBodyMark: U64
    // The `pf<idx>` symbol table (parallel arrays keyed by c.arena.funcs index): the
    // lazily-declared functions that are NOT ordinary user fns/methods/assoc — those are
    // their own gf/gm 0-type-arg instances now (B3/B4). After the unification, `pf` holds
    // only provided / lang-item / non-entry-std METHODS whose receiver has no user-type
    // instance to key a `gm` on (ensureProvidedDeclared — primitives, trait receivers).
    // It is no longer the "non-generic vs generic" seam, just an on-demand declaration
    // cache for non-instantiated method bodies. (Async-fn ENTRY symbols, the other former
    // pf user, now live in their own asyncEntry* table.)
    pub mut val fnIdx: Array[U64]
    pub mut val fnVal: Array[LLVMValueRef]
    pub mut val fnTy: Array[LLVMTypeRef]
    // free-function instances (parallel: c.monoWork.fnInsts index -> value, type). A true
    // generic instance (`id[I32]`) is keyed by its inferred args; a non-generic free fn is
    // its own 0-type-arg instance (args=[]). Both resolve via genFnSlotFor(fnIdx, args).
    pub mut val genFnK: Array[U64]
    pub mut val genFnVal: Array[LLVMValueRef]
    pub mut val genFnTy: Array[LLVMTypeRef]
    // slots (into genFn*) declared lazily at a call site via ensureFnInst (a free fn first
    // reached during body emission), queued for body emission in the pass-2 drain loop.
    pub mut val genFnEmit: Array[U64]
    // generic-method instances, one per (method func, receiver instantiation):
    // a method on a generic struct/enum (`box.get()`, `maybe.unwrapOr(...)`) is
    // monomorphized per receiver instance, keyed by (genMethK, genMethInst).
    pub mut val genMethK: Array[U64]
    pub mut val genMethInst: Array[U64]
    pub mut val genMethVal: Array[LLVMValueRef]
    pub mut val genMethTy: Array[LLVMTypeRef]
    // Semantic callee BodyInstance for each method slot. Zero is used only by
    // backend-originated helpers with no selected call descriptor.
    pub mut val genMethBody: Array[U64]
    // method-own type arguments for each gen-method slot (parallel to genMethK):
    // a provided terminal with its own type params (`fold[B]` copied onto a generic
    // receiver) instantiates per (mfi, instRef, ownArgs), since the same receiver
    // instance folds into different accumulator types. Empty for ordinary methods
    // whose type params are fully grounded by the receiver instance.
    pub mut val genMethOwn: Array[LlvmTypeArgRange]
    pub mut val genMethOwnArgs: Array[U64]
    // local environment (parallel arrays). `nLocals` is the logical count: blocks
    // save it on entry and restore it on exit (lexical scope), so a shadowing
    // binding inside a block leaves scope at the block's end and a later reference
    // resolves to the outer binding. push overwrites the slot at `nLocals` (or
    // appends), so the arrays may be longer than `nLocals` — only [0, nLocals) is live.
    pub mut val nLocals: U64
    pub mut val locStart: Array[U64]
    pub mut val locLen: Array[U64]
    pub mut val locPtr: Array[LLVMValueRef]
    pub mut val locTy: Array[LLVMTypeRef]
    // a small Plew-type-kind tag per local (0 int/signed, 1 String, 2 Bool, 3
    // unsigned int), so String ==/!= and print pick the right lowering without
    // c.cur.locals (which the LLVM backend doesn't populate, so typeOf can't see locals).
    pub mut val locKind: Array[U64]
    // per-local owning struct index (c.arena.structs.count() = not a struct), so field
    // access x.field can resolve the layout from a struct-typed local.
    pub mut val locStructIdx: Array[U64]
    // per-local array element type + is-array flag (for arr[i] / .append / .count()).
    pub mut val locIsArr: Array[Bool]
    pub mut val locElemTy: Array[LLVMTypeRef]
    pub mut val locElemKind: Array[U64]
    pub mut val locTypeRef: Array[U64]
    // per-array-local element TypeRef (0 = none), so `arr[i]` recovers the element's
    // instance — a Ref (`Array[Ref[Box]]` -> `ys[0]->v`) or a nested array.
    pub mut val locElemTypeRef: Array[U64]
    // per-local ownership for scope-exit deinit (spec/03): `locOwned` = this local's
    // value is owned here and must be deinit'd at scope exit (body locals + `move`
    // params + a `move fn` self; false for inout/borrow params / by-value-self
    // borrows the caller owns). `locMoved` = ownership was handed off (a `move`
    // arg / `move fn` receiver / `move x`), so it is NOT deinit'd here.
    pub mut val locOwned: Array[Bool]
    pub mut val locMoved: Array[Bool]
    // `locCellHome` = locPtr IS an rc'd rawbuf cell (a `mut val` heap-boxed for
    // closure capture): scope exit drops one CELL owner (emitCellRelease) instead of
    // releasing the pointee value directly, and a capturing closure's env retains it.
    pub mut val locCellHome: Array[Bool]
    // module-level variables (spec/15), parallel arrays indexed by `Comp.arena.globals`
    // position. `genLlvmInitGlobals` builds the LLVM global `gvalRef[i]` and records
    // the binding's recovered local metadata (so `seedGlobals` can re-register each
    // global as a local at every body entry, routing reads/writes/type-recovery
    // through the normal local machinery). The init values are stored once, in
    // declaration order, by `plew_init_globals`.
    pub mut val gvalRef: Array[LLVMValueRef] = []
    pub mut val gvalLty: Array[LLVMTypeRef] = []
    pub mut val gvalKind: Array[U64] = []
    pub mut val gvalSidx: Array[U64] = []
    pub mut val gvalIsArr: Array[Bool] = []
    pub mut val gvalElemTy: Array[LLVMTypeRef] = []
    pub mut val gvalElemKind: Array[U64] = []
    pub mut val gvalTref: Array[U64] = []
    pub mut val gvalElemTypeRef: Array[U64] = []
    // struct indices currently on the value-ARC emit stack (emitDeinitValue / emitStructRetain),
    // so a self-referential type (`struct S { items: Array[S] }`) does not recurse forever at
    // codegen — a struct already being emitted is skipped. Only the INLINE walk must
    // terminate: runtime recursion routes through the type's retain/release witness CALL,
    // so deeper levels are still retained/released at run time.
    pub mut val arcStack: Array[U64] = []
    pub mut val arcDepth: U64 = 0
    // Cell pin (spec/03): a deref-crossing `inout` place retains its Ref cell for the
    // call's duration, so a mid-call rebind cannot free the lent pointee — the pointee
    // deinit runs after the call. A stack of pinned cells (parallel: cell value, the
    // Ref TypeRef for the release, the arg place expr id for the overlap check's cell
    // lookup): each call site marks the count before lowering its arguments and
    // releases back to the mark right after the call instruction (an inner call inside
    // an argument pops its own pins during the outer lowering, so frames nest cleanly).
    // `pinArm` arms the pin: placePtrStrict's deref arms push ONLY while an `inout`
    // argument/receiver pointer is being computed (placePtrOfWritePinned), not for
    // reads or assignment targets.
    pub mut val pinCells: Array[LLVMValueRef] = []
    pub mut val pinRefTys: Array[U64] = []
    pub mut val pinExprs: Array[U64] = []
    pub mut val pinArm: Bool = false
    // declared runtime/intrinsic functions, cached by name id (parallel arrays).
    pub mut val declId: Array[U64]
    pub mut val declFn: Array[LLVMValueRef]
    pub mut val declTy: Array[LLVMTypeRef]
    // lambda-lifted closures, cached by Closure-expr arena id (parallel arrays):
    // the emitted `__closure<id>` LLVM function value and its function type (env
    // pointer first param). A closure literal builds a {fn, env} value from these.
    pub mut val cloIdx: Array[U64]
    pub mut val cloVal: Array[LLVMValueRef]
    pub mut val cloTy: Array[LLVMTypeRef]
    // Legacy named-function-value thunks. Kept empty in v1: a named function declaration is
    // not a value, so first-class functions must be explicit closure literals.
    pub mut val thunkIdx: Array[U64]
    pub mut val thunkVal: Array[LLVMValueRef]
    pub mut val thunkTy: Array[LLVMTypeRef]
    // per-struct drop (deinit) witnesses, keyed by struct index (parallel arrays):
    // ONE `void @pwdrop<sidx>(structVal)` function emits the recursive destruction
    // (own deinit + field walk) for that struct type, so every drop site emits a
    // single call instead of inlining the whole walker — collapsing the IR (the
    // dominant compile-time cost). Declared on demand at a drop site, drained into
    // bodies after the main pass (a body may declare more sub-struct witnesses).
    pub mut val dropWitReg: Array[U64]
    pub mut val dropWitVal: Array[LLVMValueRef]
    pub mut val dropWitTy: Array[LLVMTypeRef]
    // per-struct retain witnesses, keyed by struct index (parallel arrays): ONE
    // `void @pwretain<sidx>(structVal)` shallow-retains that type's heap-owning fields
    // (array buffers, nested struct/enum), so every CoW-share / by-value-arg retain
    // site emits a single call instead of inlining the walker. Same lifecycle as the
    // drop witnesses. Only CONCRETE registered structs are routed (env-independent);
    // a generic struct stays unregistered and is walked inline under the caller's env.
    pub mut val retWitSidx: Array[U64]
    pub mut val retWitVal: Array[LLVMValueRef]
    pub mut val retWitTy: Array[LLVMTypeRef]
    // per-struct deep-copy witnesses, keyed by struct index (parallel arrays): ONE
    // `structTy @pwcopy<sidx>(structTy)` deep-copies that type's array fields (and
    // recurses nested struct/enum), RETURNING the independent copy — so every
    // construction-site copy emits a single call instead of inlining the walker.
    // Same lifecycle/soundness as retain; only CONCRETE registered structs routed.
    pub mut val copyWitSidx: Array[U64]
    pub mut val copyWitVal: Array[LLVMValueRef]
    pub mut val copyWitTy: Array[LLVMTypeRef]
    // per-enum value-ARC witnesses, keyed by enum id (parallel arrays). Each routes ONLY
    // the registered (concrete) enum branch of emitEnumReleaseRef / emitEnumRetainRef /
    // deepCopyEnumRef — concrete enum fields are env-independent, so the witness body is
    // the same tag-dispatch walker out-of-lined. A generic enum INSTANCE (genEnumSlot)
    // stays inline (its template fields need the caller's env). release/retain are
    // `void(ety)`, copy is `ety(ety)`. Same on-demand-declare + drain-after-pass lifecycle.
    pub mut val enumRelWitReg: Array[U64]
    pub mut val enumRelWitVal: Array[LLVMValueRef]
    pub mut val enumRelWitTy: Array[LLVMTypeRef]
    pub mut val enumRetWitEid: Array[U64]
    pub mut val enumRetWitVal: Array[LLVMValueRef]
    pub mut val enumRetWitTy: Array[LLVMTypeRef]
    pub mut val enumCopyWitEid: Array[U64]
    pub mut val enumCopyWitVal: Array[LLVMValueRef]
    pub mut val enumCopyWitTy: Array[LLVMTypeRef]
    // persistent body-emission cursors for the 6 witness tables. The witness graphs cross
    // struct<->enum WITHIN a family (a struct-drop body releases an Array[Enum] element ->
    // enum-release witness, whose body deinits a struct field -> struct-drop witness), so a
    // single drain pass is not enough — `emitWitnessBodies` loops all 6 drains to a fixpoint,
    // and each resumes from its cursor (never re-emitting an already-emitted body).
    pub mut val dropWitDone: U64
    pub mut val retWitDone: U64
    pub mut val copyWitDone: U64
    pub mut val enumRelWitDone: U64
    pub mut val enumRetWitDone: U64
    pub mut val enumCopyWitDone: U64
    // provided trait methods reached (called) during emission: declared lazily (so
    // an uncalled std-trait adapter method — map/filter, whose body constructs an
    // unsupported adapter — is never emitted), then their bodies drained after the
    // main pass (a body may reach further provided methods — fixpoint).
    pub mut val provEmit: Array[U64]
    // generic-method instances declared LAZILY on demand (a std/non-entry-module
    // generic method — Optional.unwrapOr, MapIter.next — reached by a call): the
    // genMeth* slot index is queued here and its body drained after the main pass,
    // looping until the queue stops growing (a body may reach further ones).
    pub mut val genMethEmit: Array[U64]
    // ---- async (spec/14): stackless state machine, mirrors Codegen/Async.pw ----
    // PlewPromise value type { i32 done, i64 value, ptr k, ptr kframe } — ABI-
    // identical to the C runtime's PlewPromise (the resume continuation `k` is a
    // void(*)(void*); `kframe` is its frame). Awaited promises are PlewPromise*.
    pub mut val promiseTy: LLVMTypeRef
    // emitting an async fn's resume body? When set, `let`/match-bind storage is a
    // frame field (survives `await` suspensions) not an alloca, `return` resolves
    // `__self`, and a head `await` suspends.
    pub mut val curAsync: Bool
    // the current resume fn's frame pointer (void* arg 0, used as the frame base),
    // its named struct type `{i32 state, ptr self, ptr sub, <params>, <locals>}`,
    // the resume fn value (stored as a suspended promise's continuation), the entry
    // dispatch `switch` (await points add a `case state -> resume block`), the await
    // state counter (1-based), and the next frame field index to hand a `let`/bind.
    pub mut val curFrameBase: LLVMValueRef
    pub mut val curFrameTy: LLVMTypeRef
    pub mut val curResumeFn: LLVMValueRef
    pub mut val curAsyncSwitch: LLVMValueRef
    pub mut val curAsyncState: U64
    pub mut val asyncFieldNext: U64
    // per async fn (parallel, keyed by c.arena.funcs index): its frame struct type and
    // resume fn value, so the entry/resume/await sites all agree on the layout.
    pub mut val asyncFnIdx: Array[U64]
    pub mut val asyncFrameTy: Array[LLVMTypeRef]
    pub mut val asyncResumeFn: Array[LLVMValueRef]
    // the promise-returning ENTRY symbol of each non-main async fn (`async fn doubler`
    // -> `pf<fi>`), its own small symbol table keyed by funcs index — kept SEPARATE from
    // the `pf` fnIdx/fnVal/fnTy tables (which now hold only provided/lang-item method
    // lazy declarations) so an async state-machine entry is no longer conflated with a
    // method symbol. `main` keeps the C `i32 main()` shape and has no entry here.
    pub mut val asyncEntryIdx: Array[U64]
    pub mut val asyncEntryVal: Array[LLVMValueRef]
    pub mut val asyncEntryTy: Array[LLVMTypeRef]
    // the current resume fn's per-field frame-slot GEPs, ALL built in the resume
    // entry block (which dominates every resume block reached via the dispatch
    // switch) — caching them there avoids "instruction does not dominate all uses"
    // when a field GEP built mid-body is read in a switch-reachable resume block.
    pub mut val asyncSlotPtrs: Array[LLVMValueRef]
    // loop break/continue target blocks (a stack — innermost loop on top), so a
    // `break` branches to the enclosing loop's end and `continue` to its
    // header/step. Pushed by while/for codegen, popped at the loop's end. The
    // arrays are reused buffers; loopDepth is the live count (overwrite-in-place,
    // matching the local-scope idiom — Array has no pop).
    pub mut val loopBreakBB: Array[LLVMBasicBlockRef]
    pub mut val loopContBB: Array[LLVMBasicBlockRef]
    // the loop-body-entry local mark (nLocals at pushLoop), per loop frame. `break` /
    // `continue` are non-local scope exits: they must release the live body locals of the
    // current iteration before branching, exactly as the body's fall-through would. Driving
    // that off this frame-recorded mark (not a hand-picked one) is the single source of
    // truth for "what to drop on a loop exit" — see emitLoopExitDrops.
    pub mut val loopUnwindMark: Array[U64]
    pub mut val loopDepth: U64
}
pub impl LlvmCtx { factory }

// ---- libLLVM-C bindings (raw FFI floor; positional, no labels) ----
//
// Opaque handles are void* ABI-identical to the real LLVM `…Opaque *` typedefs,
// so no <llvm-c/*.h> include is needed — the compiler self-emits the prototypes.
extern(c) {
    type LLVMContextRef
    type LLVMModuleRef
    type LLVMTypeRef
    type LLVMValueRef
    type LLVMBasicBlockRef
    type LLVMBuilderRef

    // Context / module.
    fn LLVMContextCreate() -> LLVMContextRef
    fn LLVMModuleCreateWithNameInContext(name~: CPtr[U8], ctx~: LLVMContextRef) -> LLVMModuleRef
    fn LLVMPrintModuleToString(m~: LLVMModuleRef) -> CPtr[U8]
    fn LLVMDisposeMessage(msg~: CPtr[U8])

    // Types.
    fn LLVMInt1TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt8TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt16TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt32TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt64TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMDoubleTypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMConstRealOfStringAndSize(ty~: LLVMTypeRef, text~: CPtr[U8], len~: U64) -> LLVMValueRef
    fn LLVMVoidTypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMPointerTypeInContext(ctx~: LLVMContextRef, addrSpace~: U32) -> LLVMTypeRef
    fn LLVMStructTypeInContext(ctx~: LLVMContextRef, elemTypes~: CPtr[LLVMTypeRef], count~: U64, packed~: I32) -> LLVMTypeRef
    fn LLVMStructCreateNamed(ctx~: LLVMContextRef, name~: CPtr[U8]) -> LLVMTypeRef
    fn LLVMStructSetBody(structTy~: LLVMTypeRef, elemTypes~: CPtr[LLVMTypeRef], count~: U64, packed~: I32)
    fn LLVMCountStructElementTypes(structTy~: LLVMTypeRef) -> U32
    fn LLVMArrayType2(elemTy~: LLVMTypeRef, count~: U64) -> LLVMTypeRef
    fn LLVMBuildStructGEP2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, idx~: U64, name~: CPtr[U8]) -> LLVMValueRef
    // count is the C API's `unsigned`; declared U64 here because Plew has no
    // narrowing `as` yet (an Array.count() is U64). Safe on LP64 (arm64/x86-64):
    // the callee reads the low 32 bits, and our counts are tiny. Revisit once
    // integer narrowing (wrapping / TryFrom) lands.
    fn LLVMFunctionType(ret~: LLVMTypeRef, params~: CPtr[LLVMTypeRef], count~: U64, isVarArg~: I32) -> LLVMTypeRef

    // Functions / basic blocks / params.
    fn LLVMAddFunction(m~: LLVMModuleRef, name~: CPtr[U8], fnTy~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMGetParam(func~: LLVMValueRef, index~: U64) -> LLVMValueRef
    fn LLVMAppendBasicBlockInContext(ctx~: LLVMContextRef, func~: LLVMValueRef, name~: CPtr[U8]) -> LLVMBasicBlockRef

    // ASan gate (`--asan`): target triple + `sanitize_address` on every defined fn.
    type LLVMAttributeRef
    fn LLVMSetTarget(m~: LLVMModuleRef, triple~: CPtr[U8])
    fn LLVMGetEnumAttributeKindForName(name~: CPtr[U8], len~: U64) -> U32
    fn LLVMCreateEnumAttribute(ctx~: LLVMContextRef, kindID~: U32, val~: U64) -> LLVMAttributeRef
    // The function-iteration handles are opaque pointers. libLLVM signals "no more"
    // by returning a NULL pointer, which LLVMIsNull (a null-CONSTANT test) can't
    // detect — so we thread the handle as U64 (pointer-as-integer, ABI-identical on
    // LP64, same convention as the `count~: U64` bindings above) and stop on `== 0`.
    fn LLVMGetFirstFunction(m~: LLVMModuleRef) -> U64
    fn LLVMGetNextFunction(func~: U64) -> U64
    fn LLVMIsDeclaration(func~: U64) -> I32
    fn LLVMAddAttributeAtIndex(func~: U64, idx~: U32, attr~: LLVMAttributeRef)

    // Constants / introspection.
    fn LLVMConstInt(ty~: LLVMTypeRef, n~: U64, signExtend~: I32) -> LLVMValueRef
    fn LLVMConstNull(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMIsNull(v~: LLVMValueRef) -> I32
    fn LLVMSizeOf(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMBuildGEP2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, indices~: CPtr[LLVMValueRef], numIndices~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMTypeOf(v~: LLVMValueRef) -> LLVMTypeRef
    fn LLVMGetIntTypeWidth(ty~: LLVMTypeRef) -> U32
    fn LLVMGetTypeKind(ty~: LLVMTypeRef) -> U32
    fn LLVMStructGetTypeAtIndex(structTy~: LLVMTypeRef, i~: U32) -> LLVMTypeRef

    // Builder + instructions.
    fn LLVMCreateBuilderInContext(ctx~: LLVMContextRef) -> LLVMBuilderRef
    fn LLVMPositionBuilderAtEnd(b~: LLVMBuilderRef, bb~: LLVMBasicBlockRef)
    fn LLVMGetInsertBlock(b~: LLVMBuilderRef) -> LLVMBasicBlockRef
    fn LLVMBuildRet(b~: LLVMBuilderRef, v~: LLVMValueRef) -> LLVMValueRef
    fn LLVMBuildRetVoid(b~: LLVMBuilderRef) -> LLVMValueRef
    fn LLVMBuildCall2(b~: LLVMBuilderRef, fnTy~: LLVMTypeRef, func~: LLVMValueRef, args~: CPtr[LLVMValueRef], numArgs~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAdd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSub(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildMul(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFAdd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFSub(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFMul(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFNeg(b~: LLVMBuilderRef, v~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildFCmp(b~: LLVMBuilderRef, pred~: U32, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSRem(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
