use ./CompilerFailureOutput only { emitCompilerFailure }
// Terminal adapter for the existing batch compiler driver.
use @Std/Process only { exit }
use ./Frontend only { Comp }
use ./PreparedProgram only { ProgramPreparationError, programPreparationDiagnostic }

pub fn reportProgramPreparationError(c: inout Comp, error: ProgramPreparationError) {
    val diagnostic = programPreparationDiagnostic(c: inout c, error: error)
    emitCompilerFailure(diagnostic: diagnostic)
    exit(code: 1)
}
