// Private owner-local backing. A published reader holds one Ref, never a
// snapshot of the directory or another owner's mutable arrays.
impl SourceBodyData {
    inout fn growExpressionIndex() {
        mut val capacity = self.expressionIndexSlots.count() * 2U64
        if capacity == 0U64 { capacity = 8U64 }
        mut val slots: Array[U64] = []
        mut val index = 0U64
        while index < capacity {
            slots.append(0U64)
            index += 1U64
        }
        index = 0U64
        while index < self.expressionIds.count() {
            mut val slot = self.expressionIds[index] & (capacity - 1U64)
            while slots[slot] != 0U64 { slot = (slot + 1U64) & (capacity - 1U64) }
            slots.set(i: slot, value: index + 1U64)
            index += 1U64
        }
        self.expressionIndexSlots = slots
    }
    inout fn putExpression(exprId: U64, fact: SemanticExprType) {
        if fact.term != 0U64 && self.arrayTypingObligations.count() != 0U64 { self.arrayTypingObligations.remove(key: exprId) }
        val index = findSourceExpressionIndex(identities: self.expressionIds, indexSlots: self.expressionIndexSlots, exprId: exprId)
        if index < self.expressionIds.count() {
            self.expressions.set(i: index, value: fact)
            return
        }
        if self.expressionIndexSlots.count() == 0U64 || (self.expressionIds.count() + 1U64) * 4U64 > self.expressionIndexSlots.count() * 3U64 { self.growExpressionIndex() }
        val capacity = self.expressionIndexSlots.count()
        mut val slot = exprId & (capacity - 1U64)
        while self.expressionIndexSlots[slot] != 0U64 { slot = (slot + 1U64) & (capacity - 1U64) }
        self.expressionIndexSlots.set(i: slot, value: self.expressionIds.count() + 1U64)
        self.expressionIds.append(exprId)
        self.expressions.append(fact)
    }
    // Only checked value facts cross publication. Capability/type-qualifier
    // probes and discarded untyped literals have no runtime fact requirement.
    inout fn discardTentativeExpressions() {
        mut val pending = false
        for fact in self.expressions {
            match fact.typeState {
                SemanticExpressionTypeState.Unrecorded | SemanticExpressionTypeState.Pending => { pending = true }
                _ => {}
            }
        }
        if !pending { return }
        val facts = self.expressions
        val identities = self.expressionIds
        self.expressions = []
        self.expressionIds = []
        self.expressionIndexSlots = []
        mut val index = 0U64
        while index < facts.count() {
            match facts[index].typeState {
                SemanticExpressionTypeState.Unrecorded | SemanticExpressionTypeState.Pending => {
                    self.identifierTargets.remove(key: identities[index])
                    self.globalAddresses.remove(key: identities[index])
                }
                _ => { self.putExpression(exprId: identities[index], fact: facts[index]) }
            }
            index += 1U64
        }
    }
    inout fn putBinding(stmtId: U64, fact: SourceBindingFact) {
        match self.bindingKeys.get(key: stmtId) {
            Optional.Some(v: val index) => {
                self.bindings.set(i: index, value: fact)
            }
            Optional.None => {
                self.bindingKeys[stmtId] = self.bindings.count()
                self.bindings.append(fact)
            }
        }
    }
    inout fn putStatement(stmtId: U64, fact: SemanticExpressionCompletion) {
        match self.statementKeys.get(key: stmtId) {
            Optional.Some(v: val index) => { self.statements.set(i: index, value: fact) }
            Optional.None => {
                self.statementKeys[stmtId] = self.statements.count()
                self.statements.append(fact)
            }
        }
    }
    inout fn putTransfer(fact: SourceTransferFact) -> Bool {
        match self.transferKeys.get(key: fact.statementId) {
            Optional.Some(v: val index) => {
                val prior = self.transfers[index]
                return semanticCompletionOwnersEqual(recorded: prior.owner, prepared: fact.owner) && prior.matches(transfer: fact.transfer) && prior.target.matches(target: fact.target)
            }
            Optional.None => {
                self.transferKeys[fact.statementId] = self.transfers.count()
                self.transfers.append(fact)
                return true
            }
        }
    }
    inout fn putAggregate(fact: SemanticAggregate) {
        match self.aggregateKeys.get(key: fact.exprId) {
            Optional.Some(v: val index) => { self.aggregates.set(i: index, value: fact) }
            Optional.None => {
                self.aggregateKeys[fact.exprId] = self.aggregates.count()
                self.aggregates.append(fact)
            }
        }
    }
    inout fn putTry(fact: SemanticTry) {
        match self.tryKeys.get(key: fact.exprId) {
            Optional.Some(v: val index) => { self.tries.set(i: index, value: fact) }
            Optional.None => {
                self.tryKeys[fact.exprId] = self.tries.count()
                self.tries.append(fact)
            }
        }
    }
    inout fn putMatch(fact: SemanticMatch) {
        match readSourceMatchIndex(statementKeys: self.statementMatchKeys, expressionKeys: self.expressionMatchKeys, conditionKeys: self.conditionMatchKeys, source: fact.matchSource) {
            Optional.Some(v: val index) => { self.matches.set(i: index, value: fact) }
            Optional.None => {
                val index = self.matches.count()
                match fact.matchSource {
                    MatchSource.Statement(stmtId: val id) => { self.statementMatchKeys[id] = index }
                    MatchSource.Expression(exprId: val id) => { self.expressionMatchKeys[id] = index }
                    MatchSource.Condition(clauseIndex: val id) => { self.conditionMatchKeys[id] = index }
                }
                self.matches.append(fact)
            }
        }
    }
}

impl SourceFactDirectory {
    fn state(owner: SemanticCompletionOwner) -> Optional[SourceBodyState] {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => {
                if index >= self.functions.count() { return <Optional.None /> }
                return self.functions[index]
            }
            SemanticCompletionOwner.Global(target: val target) => { return self.globals.get(key: target) }
            SemanticCompletionOwner.Closure(expression: val expression) => { return self.closures.get(key: expression) }
        }
    }
    inout fn setState(owner: SemanticCompletionOwner, state: SourceBodyState) {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => {
                while self.functions.count() <= index { self.functions.append(<Optional.None />) }
                self.functions.set(i: index, value: <Optional.Some v=state />)
            }
            SemanticCompletionOwner.Global(target: val target) => { self.globals[target] = state }
            SemanticCompletionOwner.Closure(expression: val expression) => { self.closures[expression] = state }
        }
    }
    fn outcome(owner: SemanticCompletionOwner) -> Optional[Result[(), CompileDiagnostic]] {
        if self.isActive(owner: owner) { return <Optional.None /> }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: _) | SourceBodyState.Registered => { return <Optional.Some v=<Result.Ok value=() /> /> }
                    SourceBodyState.Failed(diagnostic: val diagnostic) => { return <Optional.Some v=<Result.Err error=diagnostic /> /> }
                    SourceBodyState.Building | SourceBodyState.Active => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn prepared(owner: SemanticCompletionOwner) -> Optional[PreparedSemanticFacts] {
        if self.isActive(owner: owner) { return <Optional.None /> }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: val reader) => { return <Optional.Some v=self.readers[reader] /> }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn isActive(owner: SemanticCompletionOwner) -> Bool {
        match self.activeOwner {
            Optional.Some(v: val active) => { return semanticCompletionOwnersEqual(recorded: active, prepared: owner) }
            Optional.None => { return false }
        }
    }
    fn inactiveBuilder(owner: SemanticCompletionOwner) -> SourceBodyBuilder {
        val entry = match owner {
            SemanticCompletionOwner.Function(index: val index) => self.functionBuilders.get(key: index)
            SemanticCompletionOwner.Global(target: val target) => self.globalBuilders.get(key: target)
            SemanticCompletionOwner.Closure(expression: val expression) => self.closureBuilders.get(key: expression)
        }
        match entry {
            Optional.Some(v: val builder) => { return builder }
            Optional.None => { panic("internal error: source construction slot is missing") }
        }
    }
    inout fn saveInactiveBuilder(owner: SemanticCompletionOwner, builder: SourceBodyBuilder) {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => { self.functionBuilders[index] = builder }
            SemanticCompletionOwner.Global(target: val target) => { self.globalBuilders[target] = builder }
            SemanticCompletionOwner.Closure(expression: val expression) => { self.closureBuilders[expression] = builder }
        }
    }
    inout fn removeInactiveBuilder(owner: SemanticCompletionOwner) {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => { self.functionBuilders.remove(key: index) }
            SemanticCompletionOwner.Global(target: val target) => { self.globalBuilders.remove(key: target) }
            SemanticCompletionOwner.Closure(expression: val expression) => { self.closureBuilders.remove(key: expression) }
        }
    }
    inout fn activate(owner: SemanticCompletionOwner) {
        if self.isActive(owner: owner) { return }
        match self.activeOwner {
            Optional.Some(v: val previous) => {
                self.saveInactiveBuilder(owner: previous, builder: self.activeBuilder)
                self.setState(owner: previous, state: <SourceBodyState.Building />)
            }
            Optional.None => {}
        }
        val builder = match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                give match state {
                    SourceBodyState.Building => self.inactiveBuilder(owner: owner)
                    _ => { panic("internal error: completed source owner has no writer") }
                }
            }
            Optional.None => <SourceBodyBuilder data=<SourceBodyData owner=owner /> />
        }
        self.removeInactiveBuilder(owner: owner)
        self.setState(owner: owner, state: <SourceBodyState.Active />)
        self.activeBuilder = builder
        self.activeOwner = <Optional.Some v=owner />
    }
    inout fn clearActive(owner: SemanticCompletionOwner) {
        if self.isActive(owner: owner) {
            self.activeOwner = <Optional.None />
            self.activeBuilder = <SourceBodyBuilder data=<SourceBodyData owner=owner /> />
        }
    }
    // A request remains active across several source/check walks. The slot
    // called Active only locates construction storage, never a success result.
    inout fn begin(owner: SemanticCompletionOwner) -> Bool {
        self.activate(owner: owner)
        if self.activeBuilder.requested { return false }
        self.activeBuilder.requested = true
        return true
    }
    inout fn requiredExpressions(owner: SemanticCompletionOwner) -> Array[U64] {
        self.activate(owner: owner)
        return self.activeBuilder.data.requiredExpressions
    }
    inout fn children(owner: SemanticCompletionOwner) -> Array[U64] {
        self.activate(owner: owner)
        return self.activeBuilder.data.children
    }
    inout fn publish(owner: SemanticCompletionOwner) {
        self.activate(owner: owner)
        if !self.activeBuilder.requested { panic("internal error: source facts have no preparation request") }
        for block in self.activeBuilder.data.valueBlockIds {
            val fact = self.activeBuilder.data.valueBlocks.get(key: block).unwrap()
            if fact.completion.source.normal() && fact.resultTerm == 0U64 { self.activeBuilder.data.valueBlocks.remove(key: block) }
        }
        self.activeBuilder.data.discardTentativeExpressions()
        val data = self.activeBuilder.data
        self.clearActive(owner: owner)
        if self.measure {
            self.bodiesSealed += 1U64
            self.rowsSealed += data.operations.count() + data.expressions.count() + data.bindings.count() + data.statements.count() + data.transfers.count() + data.aggregates.count() + data.tries.count() + data.matches.count() + data.closurePlans.count() + data.valueBlocks.count()
        }
        val payload: Ref[SourceBodyData] = <Ref value=data />
        val reader = self.readers.count()
        self.readers.append(<PreparedSemanticFacts readerIndex=reader session=self.session owner=owner payload=payload />)
        match owner { SemanticCompletionOwner.Global(target: _) => { self.globalReaders.append(reader) } _ => {} }
        self.setState(owner: owner, state: <SourceBodyState.Succeeded reader=reader />)
        self.countRequest(owner: owner)
    }
    inout fn fail(owner: SemanticCompletionOwner, diagnostic: CompileDiagnostic) {
        if self.outcome(owner: owner).isSome() { return }
        self.clearActive(owner: owner)
        self.removeInactiveBuilder(owner: owner)
        self.setState(owner: owner, state: <SourceBodyState.Failed diagnostic=diagnostic />)
        self.countRequest(owner: owner)
    }
    inout fn registerBodyless(owner: SemanticCompletionOwner) {
        if self.outcome(owner: owner).isSome() { return }
        self.clearActive(owner: owner)
        self.removeInactiveBuilder(owner: owner)
        self.setState(owner: owner, state: <SourceBodyState.Registered />)
        self.countRequest(owner: owner)
    }
    inout fn countRequest(owner: SemanticCompletionOwner) {
        match owner {
            SemanticCompletionOwner.Function(index: _) => { self.functionRequests += 1U64 }
            SemanticCompletionOwner.Global(target: _) => { self.globalRequests += 1U64 }
            SemanticCompletionOwner.Closure(expression: _) => {}
        }
    }
    fn expressionHead(owner: SemanticCompletionOwner, exprId: U64) -> SourceExpressionHead {
        if self.isActive(owner: owner) { return readSourceExpressionHead(rows: self.activeBuilder.data.expressions, identities: self.activeBuilder.data.expressionIds, indexSlots: self.activeBuilder.data.expressionIndexSlots, exprId: exprId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Building => { val builder = self.inactiveBuilder(owner: owner)
                        return readSourceExpressionHead(rows: builder.data.expressions, identities: builder.data.expressionIds, indexSlots: builder.data.expressionIndexSlots, exprId: exprId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return readSourceExpressionHead(rows: self.readers[reader].payload->expressions, identities: self.readers[reader].payload->expressionIds, indexSlots: self.readers[reader].payload->expressionIndexSlots, exprId: exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <SourceExpressionHead />
    }
    fn expression(owner: SemanticCompletionOwner, exprId: U64) -> Optional[SemanticExprType] {
        if self.isActive(owner: owner) { return readSourceExpression(rows: self.activeBuilder.data.expressions, identities: self.activeBuilder.data.expressionIds, indexSlots: self.activeBuilder.data.expressionIndexSlots, exprId: exprId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return readSourceExpression(rows: self.activeBuilder.data.expressions, identities: self.activeBuilder.data.expressionIds, indexSlots: self.activeBuilder.data.expressionIndexSlots, exprId: exprId) }
                    SourceBodyState.Building => { val builder = self.inactiveBuilder(owner: owner)
                        return readSourceExpression(rows: builder.data.expressions, identities: builder.data.expressionIds, indexSlots: builder.data.expressionIndexSlots, exprId: exprId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].expression(exprId: exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn valueBlock(owner: SemanticCompletionOwner, blockId: U64) -> Optional[SourceValueBlockFact] {
        if self.isActive(owner: owner) { return self.activeBuilder.data.valueBlocks.get(key: blockId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.valueBlocks.get(key: blockId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].valueBlock(blockId: blockId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn inferredBindingEvidence(owner: SemanticCompletionOwner, declaration: U64) -> Optional[SourceBindingTypeEvidence] {
        if self.isActive(owner: owner) {
            return self.activeBuilder.data.inferredBindingTypeEvidence.get(key: declaration)
        }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.inferredBindingTypeEvidence.get(key: declaration) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].payload->inferredBindingTypeEvidence.get(key: declaration) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }

    fn guardBindingEnds(owner: SemanticCompletionOwner, blockId: U64) -> Array[U64] {
        if self.isActive(owner: owner) { return self.activeBuilder.data.guardBindingEnds.getOr(key: blockId, fallback: []) }
        return match self.state(owner: owner) {
            Optional.Some(v: val state) => match state {
                SourceBodyState.Building => self.inactiveBuilder(owner: owner).data.guardBindingEnds.getOr(key: blockId, fallback: [])
                SourceBodyState.Succeeded(reader: val reader) => self.readers[reader].guardBindingEnds(blockId: blockId)
                _ => []
            }
            Optional.None => []
        }
    }

    fn binding(owner: SemanticCompletionOwner, stmtId: U64) -> Optional[SourceBindingFact] {
        if self.isActive(owner: owner) { return readSourceRow(rows: self.activeBuilder.data.bindings, keys: self.activeBuilder.data.bindingKeys, key: stmtId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Building => {
                        val builder = self.inactiveBuilder(owner: owner)
                        return readSourceRow(rows: builder.data.bindings, keys: builder.data.bindingKeys, key: stmtId)
                    }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].binding(stmtId: stmtId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn statement(owner: SemanticCompletionOwner, stmtId: U64) -> Optional[SemanticExpressionCompletion] {
        if self.isActive(owner: owner) { return readSourceRow(rows: self.activeBuilder.data.statements, keys: self.activeBuilder.data.statementKeys, key: stmtId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return readSourceRow(rows: self.activeBuilder.data.statements, keys: self.activeBuilder.data.statementKeys, key: stmtId) }
                    SourceBodyState.Building => { val builder = self.inactiveBuilder(owner: owner)
                        return readSourceRow(rows: builder.data.statements, keys: builder.data.statementKeys, key: stmtId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return readSourceRow(rows: self.readers[reader].payload->statements, keys: self.readers[reader].payload->statementKeys, key: stmtId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
}

impl SourceFactDirectory {
    inout fn contextCommitted(owner: SemanticCompletionOwner, exprId: U64) -> Bool {
        if self.isActive(owner: owner) { return self.activeBuilder.contextualValues.contains(exprId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).contextualValues.contains(exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return false
    }
}

impl Comp {
    inout fn normalizedSourceTypeContext(expectedTerm: U64) -> Result[U64, CompileDiagnostic] {
        if self.arena.typeContainsAssociatedProjection(ref: expectedTerm) { return self.normalizedValueType(ref: expectedTerm) }
        return <Result.Ok value=expectedTerm />
    }

    // A later use checks compatibility with its requested type. It cannot
    // reinterpret a value after its first successful context or binding.
    inout fn effectiveSourceTypeContext(exprId: U64, requested: U64) -> Result[U64, CompileDiagnostic] {
        if requested == 0U64 { return <Result.Ok value=0U64 /> }
        val owner = match self.currentSourceOwner() {
            Optional.Some(v: val owner) => owner
            Optional.None => { return <Result.Ok value=requested /> }
        }
        if self.sourceOwnerConstructionClosed(owner: owner) { return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: completed source owner cannot contextualize an expression") /> }
        if !self.sourceFacts.contextCommitted(owner: owner, exprId: exprId) { return <Result.Ok value=requested /> }
        match self.sourceFacts.expression(owner: owner, exprId: exprId) {
            Optional.Some(v: val fact) => { if fact.term != 0U64 { return <Result.Ok value=fact.term /> } }
            Optional.None => {}
        }
        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: committed source context has no type") />
    }

    // Existing lexical declarations are append-only. Cache only a real
    // function's successful base scope, keyed by both request and current
    // lexical root; late root registration and synthetic owners bypass it.
    // Interface proof roots are per call and never enter this cache.
    inout fn contextualLexicalScope(owner: SemanticCompletionOwner, function: U64) -> Result[DeclarationTypeScope, CompileDiagnostic] {
        val root = self.callTemplateLexicalRoots.getOr(key: function, fallback: function)
        val cacheable = function < self.arena.functionCount() && root < self.arena.functionCount()
        self.sourceFacts.activate(owner: owner)
        if cacheable && self.sourceFacts.activeBuilder.contextualScopeFunction == function && self.sourceFacts.activeBuilder.contextualScopeRoot == root {
            match self.sourceFacts.activeBuilder.contextualScope {
                Optional.Some(v: val scope) => { return <Result.Ok value=scope /> }
                Optional.None => {}
            }
        }
        val scope = try self.declarationTypeScope(owner: function)
        if cacheable && scope.owner < self.arena.functionCount() {
            val lexical = try self.lexicalFunction(f: self.arena.functionAt(index: scope.owner))
            // An unresolved receiver can acquire a ParamId after type append.
            if lexical.recvTy == 0U64 || lexical.recvTy < self.arena.typeTermCount() {
                self.sourceFacts.activeBuilder.contextualScopeFunction = function
                self.sourceFacts.activeBuilder.contextualScopeRoot = root
                self.sourceFacts.activeBuilder.contextualScope = <Optional.Some v=scope />
            }
        }
        return <Result.Ok value=scope />
    }

    // Value alone is not commitment: an argument probe or a generic call can
    // still contain callee binders. Only complete, owner-scoped results advance.
    inout fn commitSourceTypeContext(exprId: U64) {
        val owner = match self.currentSourceOwner() { Optional.Some(v: val owner) => owner Optional.None => { return } }
        if self.sourceOwnerConstructionClosed(owner: owner) || self.sourceFacts.contextCommitted(owner: owner, exprId: exprId) { return }
        val fact = match self.sourceFacts.expression(owner: owner, exprId: exprId) { Optional.Some(v: val fact) => fact Optional.None => { return } }
        match fact.typeState {
            SemanticExpressionTypeState.Value | SemanticExpressionTypeState.Unit => {}
            _ => { return }
        }
        if !self.sourceTypeHasCompleteArguments(ref: fact.term) { return }
        val site = match self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) { Result.Ok(value: val site) => site Result.Err(error: _) => { return } }
        val index = self.callTemplateIndex(siteKey: site)
        // Both paths validate the lexical owner. Build its scope once; a
        // selected call also supplies its own interface proof scope.
        val scope = if index < self.callTemplateLocations.count() {
            if !semanticCompletionOwnersEqual(recorded: self.callTemplateLocations[index].owner, prepared: owner) { return }
            val template = self.callTemplateAt(index: index)
            match template.kind {
                CallTemplateKind.Pending => { return }
                CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: _, proofId: _) | CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, methodTypeArgs: _, resultTerm: _) => {
                    match self.recordedCallParameterState(exprId: exprId) {
                        Result.Ok(value: val state) => { match state { SourceCallParameterState.Selected(function: _, signature: _) => {} _ => { return } } }
                        Result.Err(error: _) => { return }
                    }
                }
                _ => {}
            }
            val base = match self.contextualLexicalScope(owner: owner, function: template.siteKey.ownerFnIdx) { Result.Ok(value: val scope) => scope Result.Err(error: _) => { return } }
            give <DeclarationTypeScope owner=base.owner parameters=base.parameters selfParameter=base.selfParameter interfaceRoot=selectedInterfaceRoot(template: template) />
        } else {
            give match self.contextualLexicalScope(owner: owner, function: self.cur.checkFn) { Result.Ok(value: val scope) => scope Result.Err(error: _) => { return } }
        }
        match self.scopedTypeDependencies(ref: fact.term, scope: scope, offset: self.exprOffset(id: exprId)) {
            Result.Ok(value: _) => {}
            // Still-incomplete construction is not a new source diagnostic.
            Result.Err(error: _) => { return }
        }
        self.sourceFacts.activate(owner: owner)
        self.sourceFacts.activeBuilder.contextualValues.insert(exprId)
    }

    // Late constraint closure reads the node's registered owner, not the
    // cursor left by another source walk. This is a construction query and
    // does not grant a prepared-body reader.
    inout fn constructionValueBlock(blockId: U64) -> SemanticValueBlockTyping {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.valueBlock(owner: owner, blockId: blockId) {
                    Optional.Some(v: val fact) => { return <SemanticValueBlockTyping.Checked completion=fact.completion resultTerm=fact.resultTerm /> }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <SemanticValueBlockTyping.Pending />
    }
    inout fn storeBuildingValueBlock(blockId: U64, expression: U64, completion: SourceCompletion, resultTerm: U64) -> Result[(), CompileDiagnostic] {
        val owner = match self.currentSourceOwner() {
            Optional.Some(v: val owner) => owner
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: expression), msg: "internal error: value block has no source owner") /> }
        }
        if self.sourceOwnerConstructionClosed(owner: owner) {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: expression), msg: "internal error: completed source owner cannot refine a value block") /> }
        self.sourceFacts.activate(owner: owner)
        if self.sourceFacts.activeBuilder.data.valueBlocks.get(key: blockId).isNone() { self.sourceFacts.activeBuilder.data.valueBlockIds.append(blockId) }
        self.sourceFacts.activeBuilder.data.valueBlocks[blockId] = <SourceValueBlockFact expression=expression completion=completion resultTerm=resultTerm />
        return <Result.Ok value=() />
    }
    fn recordedSourceExpressionTerm(exprId: U64) -> U64 {
        match self.sourceFacts.expressionOwners.get(key: exprId) {
            Optional.Some(v: val owner) => { return self.sourceFacts.expressionHead(owner: owner, exprId: exprId).term }
            Optional.None => { return 0U64 }
        }
    }
    fn constructionExpressionHead(exprId: U64) -> SourceExpressionHead {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => { return self.sourceFacts.expressionHead(owner: owner, exprId: exprId) }
            Optional.None => { return <SourceExpressionHead /> }
        }
    }
    // Published payload readers remain immutable, small Ref-backed handles.
    fn constructionExpression(exprId: U64) -> SemanticExprType {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.expression(owner: owner, exprId: exprId) {
                    Optional.Some(v: val fact) => { return fact }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <SemanticExprType />
    }
    fn semanticExprConstructionClosed(exprId: U64) -> Bool {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => { if self.sourceOwnerConstructionClosed(owner: owner) { return true } }
            Optional.None => {}
        }
        match self.sourceFacts.expressionOwners.get(key: exprId) {
            Optional.Some(v: val owner) => { return self.sourceOwnerConstructionClosed(owner: owner) }
            Optional.None => { return false }
        }
    }
    fn semanticStmtConstructionClosed(stmtId: U64) -> Bool {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => { if self.sourceOwnerConstructionClosed(owner: owner) { return true } }
            Optional.None => {}
        }
        match self.sourceFacts.statementOwners.get(key: stmtId) {
            Optional.Some(v: val owner) => { return self.sourceOwnerConstructionClosed(owner: owner) }
            Optional.None => { return false }
        }
    }
    inout fn storeBuildingSemanticExprType(i: U64, value: SemanticExprType) {
        val owner = match self.currentSourceOwner() {
            Optional.Some(v: val owner) => owner
            Optional.None => { panic("internal error: expression construction has no source owner") }
        }
        match self.sourceFacts.expressionOwners.get(key: i) {
            Optional.Some(v: val prior) => {
                if !semanticCompletionOwnersEqual(recorded: prior, prepared: owner) { panic("internal error: expression fact changed its source owner") }
            }
            Optional.None => {}
        }
        self.sourceFacts.activate(owner: owner)
        self.sourceFacts.activeBuilder.data.putExpression(exprId: i, fact: value)
        self.sourceFacts.expressionOwners[i] = owner
        // Binding metadata belongs only to identifier nodes. Type/completion
        // refinement of every other expression does not edit binding tables.
        match self.arena.exprs[i] {
            Expr.Ident(start: _, len: _) => {
                // Freeze the selected value-binding category and target with the type.
                // Final consumers must not read the mutable construction TypeCache.
                self.sourceFacts.activeBuilder.data.identifierTargets.remove(key: i)
                self.sourceFacts.activeBuilder.data.globalAddresses.remove(key: i)
                if i < self.typeCache.identBind.count() && i < self.typeCache.identTarget.count() && self.typeCache.identBind[i] == identValueCode() {
                    self.sourceFacts.activeBuilder.data.identifierTargets[i] = self.typeCache.identTarget[i]
                    match self.recordedGlobalAddress(exprId: i) {
                        Optional.Some(v: val address) => { self.sourceFacts.activeBuilder.data.globalAddresses[i] = address }
                        Optional.None => {}
                    }
                }
            }
            _ => {}
        }
    }
    inout fn storeBuildingSemanticBinding(stmtId: U64, declarationTarget: U64, isMutable: Bool, typeTerm: U64, endedBinding: U64, annotation: Optional[LocalAnnotationProof]) {
        match self.sourceRecordingOwner() {
            Optional.Some(v: val owner) => {
                self.sourceFacts.activate(owner: owner)
                self.sourceFacts.activeBuilder.data.putBinding(stmtId: stmtId, fact: <SourceBindingFact owner=owner declarationTarget=declarationTarget isMutable=isMutable typeTerm=typeTerm endedBinding=endedBinding annotation=annotation />)
            }
            Optional.None => {}
        }
    }
    inout fn recordValueOperandCall(exprId: U64) -> Result[(), CompileDiagnostic] {
        if self.cur.recordCallTemplates {
            match (try self.callArgumentSource(exprId: exprId)) {
                CallArgumentSource.PriorCallResult(exprId: _, siteKey: val site) => {
                    match self.sourceRecordingOwner() {
                        Optional.Some(v: val owner) => {
                            self.sourceFacts.activate(owner: owner)
                            self.sourceFacts.activeBuilder.data.valueOperandCalls[exprId] = site
                        }
                        Optional.None => {}
                    }
                }
                _ => {}
            }
        }
        return <Result.Ok value=() />
    }

    inout fn storeBuildingValueRegion(exprId: U64, region: SourceValueRegion) {
        match self.sourceRecordingOwner() {
            Optional.Some(v: val owner) => {
                self.sourceFacts.activate(owner: owner)
                self.sourceFacts.activeBuilder.data.valueRegions[exprId] = region
            }
            Optional.None => {}
        }
    }

    inout fn storeBuildingExecutableBlock(blockId: U64, length: U64) {
        match self.sourceRecordingOwner() {
            Optional.Some(v: val owner) => {
                self.sourceFacts.activate(owner: owner)
                self.sourceFacts.activeBuilder.data.executableBlockRanges[blockId] = <SourceStatementRange start=self.arena.blocks[blockId].stmtStart length=length />
            }
            Optional.None => {}
        }
    }

    inout fn storeBuildingSemanticStmtCompletion(stmtId: U64, fact: SemanticExpressionCompletion, origin: SourceRecordOrigin) -> Result[(), CompileDiagnostic] {
        self.sourceFacts.activate(owner: fact.owner)
        // This is the sole statement publication entry. A direct transfer
        // cannot publish its completion without its selected target.
        try self.recordSourceTransfer(stmtId: stmtId, owner: fact.owner, origin: origin)
        self.sourceFacts.activeBuilder.data.putStatement(stmtId: stmtId, fact: fact)
        self.sourceFacts.statementOwners[stmtId] = fact.owner
        return <Result.Ok value=() />
    }
}

impl Comp {
    inout fn sourceConsumerFacts(owner: SemanticCompletionOwner) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        match self.cur.sourceFactReader {
            Optional.Some(v: val index) => {
                if index < self.sourceFacts.readers.count() {
                    val facts = self.sourceFacts.readers[index]
                    if facts.session == self.sourceFacts.session && semanticCompletionOwnersEqual(recorded: facts.owner, prepared: owner) {
                        return <Result.Ok value=facts />
                    }
                }
            }
            Optional.None => {}
        }
        val facts = try self.preparedSemanticFacts(owner: owner)
        self.cur.sourceFactReader = <Optional.Some v=facts.readerIndex />
        return <Result.Ok value=facts />
    }
}

pub impl Comp {
    inout fn preparedSemanticFacts(owner: SemanticCompletionOwner) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        match self.sourceFacts.outcome(owner: owner) {
            Optional.Some(v: val outcome) => { try outcome }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: semantic facts require a prepared source owner") /> }
        }
        match self.sourceFacts.prepared(owner: owner) {
            Optional.Some(v: val facts) => { if self.sourceFacts.measure { self.sourceFacts.acquisitions += 1U64 } return <Result.Ok value=facts /> }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: registered callable has no source body") /> }
        }
    }
    inout fn preparedFunctionSemanticFacts(fnIdx: U64) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        return self.preparedSemanticFacts(owner: <SemanticCompletionOwner.Function index=(try self.semanticBodyOwner(fnIdx: fnIdx)) />)
    }
    inout fn preparedFunctionBodySignature(fnIdx: U64) -> Result[SourceBodySignature, CompileDiagnostic] {
        val facts = try self.preparedFunctionSemanticFacts(fnIdx: fnIdx)
        match facts.functionSignature() {
            Optional.Some(v: val signature) => { return <Result.Ok value=signature /> }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: prepared source body has no signature") /> }
        }
    }
    inout fn preparedGlobalSemanticFacts(target: U64) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        return self.preparedSemanticFacts(owner: <SemanticCompletionOwner.Global target=target />)
    }
    inout fn preparedClosureSemanticFacts(closure: SemanticClosure) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        return self.preparedSemanticFacts(owner: <SemanticCompletionOwner.Closure expression=closure.exprId />)
    }
    inout fn preparedSourceExpression(owner: SemanticCompletionOwner, exprId: U64) -> Result[SemanticExprType, CompileDiagnostic] {
        val facts = try self.preparedSemanticFacts(owner: owner)
        match facts.expression(exprId: exprId) {
            Optional.Some(v: val fact) => { return <Result.Ok value=fact /> }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: prepared owner has no matching source expression") /> }
        }
    }
    // Internal construction probes must supply their lexical cursor. Final
    // consumers acquire a successful owner's reader instead.
    fn sourceSemanticExprTypeAt(index: U64) -> SemanticExprType { return self.constructionExpression(exprId: index) }
}

impl SourceFactDirectory {
    fn parent(owner: SemanticCompletionOwner) -> Optional[SemanticCompletionOwner] {
        if self.isActive(owner: owner) { return self.activeBuilder.data.parent }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return self.activeBuilder.data.parent }
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.parent }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].payload->parent }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn recordMatchOwner(source: MatchSource, owner: SemanticCompletionOwner) {
        match source {
            MatchSource.Statement(stmtId: val id) => { self.statementMatchOwners[id] = owner }
            MatchSource.Expression(exprId: val id) => { self.expressionMatchOwners[id] = owner }
            MatchSource.Condition(clauseIndex: val id) => { self.conditionMatchOwners[id] = owner }
        }
    }
    fn matchOwner(source: MatchSource) -> Optional[SemanticCompletionOwner] {
        match source {
            MatchSource.Statement(stmtId: val id) => { return self.statementMatchOwners.get(key: id) }
            MatchSource.Expression(exprId: val id) => { return self.expressionMatchOwners.get(key: id) }
            MatchSource.Condition(clauseIndex: val id) => { return self.conditionMatchOwners.get(key: id) }
        }
    }
}
impl Comp {
    fn constructionAggregate(exprId: U64) -> Optional[SemanticAggregate] {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.state(owner: owner) {
                    Optional.Some(v: val state) => {
                        match state {
                            SourceBodyState.Active => { return readSourceRow(rows: self.sourceFacts.activeBuilder.data.aggregates, keys: self.sourceFacts.activeBuilder.data.aggregateKeys, key: exprId) }
                            SourceBodyState.Building => { val builder = self.sourceFacts.inactiveBuilder(owner: owner)
                        return readSourceRow(rows: builder.data.aggregates, keys: builder.data.aggregateKeys, key: exprId) }
                            SourceBodyState.Succeeded(reader: val reader) => { return readSourceRow(rows: self.sourceFacts.readers[reader].payload->aggregates, keys: self.sourceFacts.readers[reader].payload->aggregateKeys, key: exprId) }
                            _ => {}
                        }
                    }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn constructionMatch(source: MatchSource) -> Optional[SemanticMatch] {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.state(owner: owner) {
                    Optional.Some(v: val state) => {
                        match state {
                            SourceBodyState.Active => { return readSourcePattern(rows: self.sourceFacts.activeBuilder.data.matches, statementKeys: self.sourceFacts.activeBuilder.data.statementMatchKeys, expressionKeys: self.sourceFacts.activeBuilder.data.expressionMatchKeys, conditionKeys: self.sourceFacts.activeBuilder.data.conditionMatchKeys, source: source) }
                            SourceBodyState.Building => { val builder = self.sourceFacts.inactiveBuilder(owner: owner)
                        return readSourcePattern(rows: builder.data.matches, statementKeys: builder.data.statementMatchKeys, expressionKeys: builder.data.expressionMatchKeys, conditionKeys: builder.data.conditionMatchKeys, source: source) }
                            SourceBodyState.Succeeded(reader: val reader) => { return readSourcePattern(rows: self.sourceFacts.readers[reader].payload->matches, statementKeys: self.sourceFacts.readers[reader].payload->statementMatchKeys, expressionKeys: self.sourceFacts.readers[reader].payload->expressionMatchKeys, conditionKeys: self.sourceFacts.readers[reader].payload->conditionMatchKeys, source: source) }
                            _ => {}
                        }
                    }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn registerClosureFactOwner(expression: U64, parent: SemanticCompletionOwner) {
        self.sourceFacts.activate(owner: parent)
        mut val found = false
        for child in self.sourceFacts.activeBuilder.data.children { if child == expression { found = true } }
        if !found { self.sourceFacts.activeBuilder.data.children.append(expression) }
        self.sourceFacts.activate(owner: <SemanticCompletionOwner.Closure expression=expression />)
        self.sourceFacts.activeBuilder.data.parent = <Optional.Some v=parent />
    }
    inout fn checkNestedSourceFacts(owner: SemanticCompletionOwner, checkGenericOwnership: Bool = false) -> Result[(), CompileDiagnostic] {
        return self.checkNestedSourceFactsWithOrigin(owner: owner, checkGenericOwnership: checkGenericOwnership, origin: <SourceRecordOrigin.Raw />)
    }
    inout fn checkNestedSourceFactsWithOrigin(owner: SemanticCompletionOwner, checkGenericOwnership: Bool = false, origin: SourceRecordOrigin) -> Result[(), CompileDiagnostic] {
        val children = self.sourceFacts.children(owner: owner)
        for expression in children {
            val child = <SemanticCompletionOwner.Closure expression=expression />
            try self.checkSourceConversionEvidence(owner: child)
            try self.checkSourceDiagnosticFailures(owner: child)
            try self.checkSourceTypingObligationsWithOrigin(owner: child, checkGenericOwnership: checkGenericOwnership, origin: origin)
            try self.checkNestedSourceFactsWithOrigin(owner: child, checkGenericOwnership: checkGenericOwnership, origin: origin)
        }
        return <Result.Ok value=() />
    }
    inout fn finishSourceFacts(owner: SemanticCompletionOwner, result: Result[(), CompileDiagnostic], bodyless: Bool = false) {
        val children = self.sourceFacts.children(owner: owner)
        for expression in children { self.finishSourceFacts(owner: <SemanticCompletionOwner.Closure expression=expression />, result: result) }
        match result {
            Result.Ok(value: _) => {
                if bodyless { self.sourceFacts.registerBodyless(owner: owner) }
                else { self.sourceFacts.publish(owner: owner) }
            }
            Result.Err(error: val diagnostic) => { self.sourceFacts.fail(owner: owner, diagnostic: diagnostic) }
        }
    }
}

impl Comp {
    // Authored namespace belongs to the lexical source owner. Diagnostic
    // spellings and serial-only synthetic CallSiteKeys are not that authority.
    inout fn sourceBodyModule() -> Result[U64, CompileDiagnostic] {
        val owner = match self.currentSourceOwner() {
            Optional.Some(v: val owner) => self.lexicalSourceFactOwner(owner: owner)
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: source visibility has no body owner") /> }
        }
        mut val offset = 0U64
        match owner {
            SemanticCompletionOwner.Function(index: val index) => {
                val source = try self.semanticBodyOwner(fnIdx: index)
                if source >= self.arena.functionCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: source visibility has no lexical declaration") /> }
                offset = self.arena.functionAt(index: source).defOffset
            }
            SemanticCompletionOwner.Global(target: val target) => { offset = target }
            SemanticCompletionOwner.Closure(expression: _) => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: source closure has no lexical namespace") /> }
        }
        val module = self.moduleOf(offset: offset)
        if module == self.typeDeclModuleMissing() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: source body has no authored module") /> }
        return <Result.Ok value=module />
    }

    fn lexicalSourceFactOwner(owner: SemanticCompletionOwner) -> SemanticCompletionOwner {
        match self.sourceFacts.parent(owner: owner) {
            Optional.Some(v: val parent) => { return self.lexicalSourceFactOwner(owner: parent) }
            Optional.None => { return owner }
        }
    }
}

impl Comp {
    fn sameMatchSource(a: MatchSource, b: MatchSource) -> Bool {
        match a {
            MatchSource.Statement(stmtId: val id) => { match b { MatchSource.Statement(stmtId: val other) => { return id == other } _ => { return false } } }
            MatchSource.Expression(exprId: val id) => { match b { MatchSource.Expression(exprId: val other) => { return id == other } _ => { return false } } }
            MatchSource.Condition(clauseIndex: val id) => { match b { MatchSource.Condition(clauseIndex: val other) => { return id == other } _ => { return false } } }
        }
    }
}

impl SourceBodyData {
    inout fn putClosure(closure: SemanticClosure) {
        match self.closureKeys.get(key: closure.exprId) {
            Optional.Some(v: val index) => { self.closurePlans.set(i: index, value: closure) }
            Optional.None => {
                self.closureKeys[closure.exprId] = self.closurePlans.count()
                self.closurePlans.append(closure)
            }
        }
    }
}
impl Comp {
    inout fn constructionClosure(owner: SemanticCompletionOwner, exprId: U64) -> Optional[SemanticClosure] {
        match self.sourceFacts.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return readSourceRow(rows: self.sourceFacts.activeBuilder.data.closurePlans, keys: self.sourceFacts.activeBuilder.data.closureKeys, key: exprId) }
                    SourceBodyState.Building => { val builder = self.sourceFacts.inactiveBuilder(owner: owner)
                        return readSourceRow(rows: builder.data.closurePlans, keys: builder.data.closureKeys, key: exprId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return readSourceRow(rows: self.sourceFacts.readers[reader].payload->closurePlans, keys: self.sourceFacts.readers[reader].payload->closureKeys, key: exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
}

pub impl Comp {
    fn sourceFactSession() -> U64 { return self.sourceFacts.session }

    // Observation only: matching scalar provenance does not turn a raw Comp
    // into an owned source request. The owning session interprets its result.
    fn sourceExpressionHasOwner(session: U64, expression: U64, owner: DiagnosticOwner) -> Bool {
        // Expression IDs are zero-based; retained ownership, not nonzero-ness,
        // establishes provenance. Type IDs use a different sentinel contract.
        if session != self.sourceFacts.session || expression >= self.arena.exprs.count() { return false }
        val recorded = match self.sourceFacts.expressionOwners.get(key: expression) {
            Optional.Some(v: val recorded) => recorded
            Optional.None => { return false }
        }
        match owner {
            DiagnosticOwner.Function(index: val index) => { return semanticCompletionOwnersEqual(recorded: recorded, prepared: <SemanticCompletionOwner.Function index=index />) }
            DiagnosticOwner.Global(target: val target) => { return semanticCompletionOwnersEqual(recorded: recorded, prepared: <SemanticCompletionOwner.Global target=target />) }
            DiagnosticOwner.Closure(expression: val expression) => { return semanticCompletionOwnersEqual(recorded: recorded, prepared: <SemanticCompletionOwner.Closure expression=expression />) }
            DiagnosticOwner.Unknown => { return false }
        }
    }

    // Global lowering can stop before later initializers. Project only already
    // published owners; this query neither prepares nor evaluates a source body.
    fn publishedGlobalBindingStorageOrigins() -> Result[SourceBindingStorageIndex, CompileDiagnostic] {
        mut val origins = <SourceBindingStorageIndex.empty session=self.sourceFacts.session />
        for reader in self.sourceFacts.globalReaders {
            val facts = self.sourceFacts.readers[reader]
            match facts.owner {
                SemanticCompletionOwner.Global(target: val target) => { try facts.appendBindingStorageOrigins(into: inout origins, excludingDeclaration: target) }
                _ => { return <Result.Err error=<CompileDiagnostic location=<DiagnosticLocation.Line line=0I64 /> message="internal error: global source reader index has a foreign owner" /> /> }
            }
        }
        return <Result.Ok value=origins />
    }

    // Acquire the existing sealed reader once per distinct origin reader in a
    // body verification. Never infer synthetic origin from a lookup failure.
    inout fn preparedBindingStorageSource(origin: SourceBindingOrigin, sourceFunction: U64) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        if origin.session != self.sourceFacts.session || origin.readerIndex == 0U64 || origin.readerIndex > self.sourceFacts.readers.count() || origin.bindingIndex == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: binding storage origin has an invalid source domain") />
        }
        val facts = self.sourceFacts.readers[origin.readerIndex - 1U64]
        mut val globalTarget: Optional[U64] = <Optional.None />
        match facts.owner {
            SemanticCompletionOwner.Global(target: val target) => { globalTarget = <Optional.Some v=target /> }
            _ => {}
        }
        try self.requireSourceFactsForFunction(facts: facts, sourceFunction: sourceFunction, globalInitializerTarget: globalTarget)
        return <Result.Ok value=facts />
    }

    inout fn requireSourceFactsSession(facts: PreparedSemanticFacts) -> Result[(), CompileDiagnostic] {
        if !facts.belongsToSession(session: self.sourceFacts.session) {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: semantic facts belong to another compiler session") />
        }
        return <Result.Ok value=() />
    }
    inout fn requireSourceFactsForFunction(facts: PreparedSemanticFacts, sourceFunction: U64, globalInitializerTarget: Optional[U64] = <Optional.None />) -> Result[(), CompileDiagnostic] {
        try self.requireSourceFactsSession(facts: facts)
        val expected = try self.sourceFunctionOwner(fnIdx: sourceFunction, globalInitializerTarget: globalInitializerTarget)
        if !semanticCompletionOwnersEqual(recorded: facts.owner, prepared: expected) {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: source facts belong to another source function") />
        }
        return <Result.Ok value=() />
    }

}

pub impl Comp {
    inout fn enableSourceFactStatistics() { self.sourceFacts.measure = true }
    fn sourceFactStatistics() -> SourceFactStatistics {
        return <SourceFactStatistics enabled=self.sourceFacts.measure bodiesSealed=self.sourceFacts.bodiesSealed rowsSealed=self.sourceFacts.rowsSealed acquisitions=self.sourceFacts.acquisitions />
    }
}

// Construction readers share the owner directory with all other source facts.
// Successful owners are read only through their sealed payload.
impl SourceFactDirectory {
    fn operation(owner: SemanticCompletionOwner, index: U64) -> Optional[CallTemplate] {
        if self.isActive(owner: owner) { return readSourceOperationTemplate(rows: self.activeBuilder.data.operations, index: index) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].operationAt(index: index) }
                    SourceBodyState.Building => { return readSourceOperationTemplate(rows: self.inactiveBuilder(owner: owner).data.operations, index: index) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    // The scalar projection follows exactly the full operation's lifecycle
    // routing. Failed owners supply neither their former rows nor defaults.
    fn operationHead(owner: SemanticCompletionOwner, index: U64) -> Optional[SourceOperationHead] {
        if self.isActive(owner: owner) { return readSourceOperationHead(rows: self.activeBuilder.data.operations, index: index) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].operationHeadAt(index: index) }
                    SourceBodyState.Building => { return readSourceOperationHead(rows: self.inactiveBuilder(owner: owner).data.operations, index: index) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    fn operationConstraints(owner: SemanticCompletionOwner, index: U64) -> Optional[CallConstraintPlanState] {
        if self.isActive(owner: owner) { return readSourceOperationConstraints(rows: self.activeBuilder.data.operationConstraints, index: index) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: val reader) => { return readSourceOperationConstraints(rows: self.readers[reader].payload->operationConstraints, index: index) }
                    SourceBodyState.Building => { return readSourceOperationConstraints(rows: self.inactiveBuilder(owner: owner).data.operationConstraints, index: index) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
}

pub impl Comp {
    // Observation only. A failed field access has no successful parent fact;
    // its recorded receiver and exact operation identify the constructing owner.
    fn sourceMissingFieldHasOwner(refusal: MissingFieldRefusal) -> Bool {
        if !self.sourceExpressionHasOwner(session: refusal.session(), expression: refusal.receiver(), owner: refusal.owner()) { return false }
        if refusal.expression() >= self.arena.exprs.count() { return false }
        match self.arena.exprs[refusal.expression()] {
            Expr.Field(val base, val nameStart, val nameLen) => {
                match refusal.kind() { MissingFieldKind.RefPointee => { return false } _ => {} }
                return base == refusal.receiver() && nameStart == refusal.nameStart() && nameLen == refusal.nameLen()
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                match refusal.kind() { MissingFieldKind.RefPointee => {} _ => { return false } }
                return base == refusal.receiver() && nameStart == refusal.nameStart() && nameLen == refusal.nameLen()
            }
            _ => { return false }
        }
    }
}


pub impl Comp {
    fn sourceAssignmentHasOwner(refusal: AssignmentRefusal) -> Bool {
        if !self.sourceExpressionHasOwner(session: refusal.session(), expression: refusal.target(), owner: refusal.owner()) { return false }
        if refusal.statement() >= self.arena.stmts.count() { return false }
        match self.arena.stmts[refusal.statement()] {
            Stmt.Assign(val target, value: _) => { if target != refusal.target() { return false } }
            _ => { return false }
        }
        return match self.arena.exprs[refusal.target()] {
            Expr.Index(base: _, index: _) => match refusal.kind() { AssignmentRefusalKind.Element => true _ => false }
            Expr.Field(base: _, nameStart: _, nameLen: _) => match refusal.kind() { AssignmentRefusalKind.Field => true _ => false }
            Expr.Ident(start: _, len: _) => match refusal.kind() { AssignmentRefusalKind.Binding => true _ => false }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => match refusal.kind() { AssignmentRefusalKind.Ref => true AssignmentRefusalKind.PointeeField => true _ => false }
            _ => false
        }
    }
}


pub impl Comp {
    // Observes retained negative selection, never fabricates a successful call fact.
    fn sourceFreeCallAmbiguityHasOwner(refusal: FreeCallAmbiguityRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.expression() >= self.arena.exprs.count() { return false }
        val proof = match self.failedFreeCallAmbiguities.get(key: refusal.expression()) {
            Optional.Some(v: val proof) => proof
            Optional.None => { return false }
        }
        val ownerMatches = match refusal.owner() {
            DiagnosticOwner.Function(index: val index) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Function index=index />)
            DiagnosticOwner.Global(target: val target) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Global target=target />)
            DiagnosticOwner.Closure(expression: val expression) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Closure expression=expression />)
            DiagnosticOwner.Unknown => false
        }
        if !proof.kind.same(other: refusal.kind()) || !proof.location.same(other: refusal.location()) || !ownerMatches || proof.nameStart != refusal.nameStart() || proof.nameLen != refusal.nameLen() { return false }
        val args = match self.arena.exprs[refusal.expression()] {
            Expr.Call(nameStart: val start, nameLen: val length, args: val args) => {
                if start != refusal.nameStart() || length != refusal.nameLen() { return false }
                give args
            }
            _ => { return false }
        }
        if args.start != refusal.argumentsStart() || args.len != refusal.argumentsCount() || proof.arguments.count() != args.len { return false }
        if args.start > self.arena.argPool.count() || args.len > self.arena.argPool.count() - args.start { return false }
        if !self.isAuthoredFreeCall(exprId: refusal.expression(), start: refusal.nameStart(), length: refusal.nameLen(), args: args) { return false }
        for index in 0U64..<args.len {
            val a = proof.arguments[index]
            val b = self.argAt(args: args, index: index)
            if a.expr != b.expr || a.isInout != b.isInout || a.hasLabel != b.hasLabel || a.labelStart != b.labelStart || a.labelLen != b.labelLen { return false }
        }
        return true
    }
}

pub impl Comp {
    // Observes retained negative selection, never fabricates a successful call fact.
    fn sourceMemberCallAmbiguityHasOwner(refusal: MemberCallAmbiguityRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.expression() >= self.arena.exprs.count() { return false }
        val proof = match self.failedMemberCallAmbiguities.get(key: refusal.expression()) {
            Optional.Some(v: val proof) => proof
            Optional.None => { return false }
        }
        val ownerMatches = match refusal.owner() {
            DiagnosticOwner.Function(index: val index) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Function index=index />)
            DiagnosticOwner.Global(target: val target) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Global target=target />)
            DiagnosticOwner.Closure(expression: val expression) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Closure expression=expression />)
            DiagnosticOwner.Unknown => false
        }
        if !proof.kind.same(other: refusal.kind()) || !proof.location.same(other: refusal.location()) || proof.receiverRef != refusal.receiverRef() || !ownerMatches || proof.nameStart != refusal.nameStart() || proof.nameLen != refusal.nameLen() { return false }
        val args = match self.arena.exprs[refusal.expression()] {
            Expr.Method(recv: val receiver, nameStart: val start, nameLen: val length, args: val args) => {
                if receiver != proof.receiver || proof.source.isSome() || start != refusal.nameStart() || length != refusal.nameLen() { return false }
                give args
            }
            Expr.ExtMethod(recv: val receiver, source: val source, nameStart: val start, nameLen: val length, args: val args) => {
                if receiver != proof.receiver || start != refusal.nameStart() || length != refusal.nameLen() { return false }
                val saved = match proof.source { Optional.Some(v: val saved) => saved Optional.None => { return false } }
                if source.writtenStart != saved.writtenStart || source.writtenLen != saved.writtenLen || source.surfaceId != saved.surfaceId || source.traitInstance.owner != saved.traitInstance.owner || source.traitInstance.positionalArgs.count() != saved.traitInstance.positionalArgs.count() { return false }
                for index in 0U64..<source.traitInstance.positionalArgs.count() { if source.traitInstance.positionalArgs[index] != saved.traitInstance.positionalArgs[index] { return false } }
                give args
            }
            _ => { return false }
        }
        if args.start != refusal.argumentsStart() || args.len != refusal.argumentsCount() || proof.arguments.count() != args.len { return false }
        if args.start > self.arena.argPool.count() || args.len > self.arena.argPool.count() - args.start { return false }
        if !self.isAuthoredMethodLookup(exprId: refusal.expression(), nameStart: refusal.nameStart(), nameLen: refusal.nameLen(), args: args) { return false }
        for index in 0U64..<args.len {
            val a = proof.arguments[index]
            val b = self.argAt(args: args, index: index)
            if a.expr != b.expr || a.isInout != b.isInout || a.hasLabel != b.hasLabel || a.labelStart != b.labelStart || a.labelLen != b.labelLen { return false }
        }
        return true
    }
}


pub impl Comp {
    // Retained failed selections are observed without redoing type checking or
    // manufacturing a successful source-expression/capture fact.
    fn sourceUniqueCaptureHasOwner(refusal: UniqueCaptureRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.failureIndex() >= self.failedUniqueCaptures.count() { return false }
        val proof = self.failedUniqueCaptures[refusal.failureIndex()]
        if proof.closure != refusal.expression() || proof.bindingTarget != refusal.bindingTarget() || proof.closure >= self.arena.exprs.count() { return false }
        match self.arena.exprs[proof.closure] { Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _, isDiverging: _) => {} _ => { return false } }
        val index = match proof.origin {
            CaptureCheckOrigin.Raw => { return false }
            CaptureCheckOrigin.Declaration(index: val index) => index
            CaptureCheckOrigin.Instance(index: val index, captureIndex: _, closureBody: _, sourceType: _, finalType: _) => index
        }
        if index >= self.semanticClosures.count() || index >= self.semanticClosureOwners.count() { return false }
        val declaration = self.semanticClosures[index]
        if declaration.exprId != proof.closure || !semanticCompletionOwnersEqual(recorded: proof.owner, prepared: self.semanticClosureOwners[index]) { return false }
        match proof.origin {
            CaptureCheckOrigin.Instance(index: _, captureIndex: val captureIndex, closureBody: val closureBody, sourceType: val sourceType, finalType: val finalType) => {
                if closureBody == 0U64 || closureBody > self.arena.bodyInstanceCount() { return false }
                if self.arena.bodyInstanceAt(index: closureBody - 1U64).fnIdx != declaration.bodyKey { return false }
                val reader = match self.sourceFacts.state(owner: proof.owner) {
                    Optional.Some(v: val state) => match state { SourceBodyState.Succeeded(reader: val reader) => reader _ => { return false } }
                    Optional.None => { return false }
                }
                val facts = self.sourceFacts.readers[reader]
                val closure = match readSourceRow(rows: facts.payload->closurePlans, keys: facts.payload->closureKeys, key: proof.closure) {
                    Optional.Some(v: val closure) => closure
                    Optional.None => { return false }
                }
                if captureIndex >= closure.captures.count() { return false }
                val capture = closure.captures[captureIndex]
                if capture.bindingTarget != proof.bindingTarget || capture.bindingStatement != proof.bindingStatement || capture.typeTerm != sourceType { return false }
                val substitution = self.arena.bodyTypeTermResult(bodyId: closureBody, typeTerm: sourceType)
                if substitution.bodyId != closureBody || substitution.resultType != finalType { return false }

            }
            _ => {}
        }
        return true
    }
}


pub impl Comp {
    // Observe the exact failed binding selection, not today's locals or a hint.
    fn sourceNonCallableBindingHasOwner(refusal: NonCallableBindingRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.expression() >= self.arena.exprs.count() || refusal.typeTerm() == 0U64 || refusal.typeTerm() >= self.arena.typeCount() { return false }
        val proof = match self.failedFreeCallSelections.get(key: refusal.expression()) {
            Optional.Some(v: val failed) => match failed {
                FailedFreeCallSelection.NonCallableBinding(owner: val owner, bindingTarget: val bindingTarget, typeTerm: val typeTerm, arguments: val arguments) => (owner: owner, bindingTarget: bindingTarget, typeTerm: typeTerm, arguments: arguments)
                _ => { return false }
            }
            Optional.None => { return false }
        }
        val ownerMatches = match refusal.owner() {
            DiagnosticOwner.Function(index: val index) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Function index=index />)
            DiagnosticOwner.Global(target: val target) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Global target=target />)
            DiagnosticOwner.Closure(expression: val expression) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Closure expression=expression />)
            DiagnosticOwner.Unknown => false
        }
        if !ownerMatches || proof.bindingTarget != refusal.bindingTarget() || proof.typeTerm != refusal.typeTerm() { return false }
        val term = self.arena.typeTermAt(index: proof.typeTerm)
        if rangeEquals(bytes: self.arena.bytes, start: term.nameStart, len: term.nameLen, kw: "fn") { return false }
        val args = match self.arena.exprs[refusal.expression()] {
            Expr.Call(nameStart: val start, nameLen: val len, args: val args) => {
                if !self.isAuthoredFreeCall(exprId: refusal.expression(), start: start, length: len, args: args) { return false }
                give args
            }
            _ => { return false }
        }
        if args.start != refusal.argumentsStart() || args.len != refusal.argumentsCount() || proof.arguments.count() != args.len { return false }
        if args.start > self.arena.argPool.count() || args.len > self.arena.argPool.count() - args.start { return false }
        for index in 0U64..<args.len {
            val a = proof.arguments[index]
            val b = self.argAt(args: args, index: index)
            if a.expr != b.expr || a.isInout != b.isInout || a.hasLabel != b.hasLabel || a.labelStart != b.labelStart || a.labelLen != b.labelLen { return false }
        }
        return true
    }
}


pub impl Comp {
    fn sourceFreeCallVisibilityHasOwner(refusal: FreeCallVisibilityRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.expression() >= self.arena.exprs.count() { return false }
        val proof = match self.failedFreeCallSelections.get(key: refusal.expression()) {
            Optional.Some(v: val failed) => match failed {
                FailedFreeCallSelection.Visibility(owner: val owner, kind: val kind, arguments: val arguments, location: val location) => (owner: owner, kind: kind, arguments: arguments, location: location)
                _ => { return false }
            }
            Optional.None => { return false }
        }
        val ownerMatches = match refusal.owner() {
            DiagnosticOwner.Function(index: val index) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Function index=index />)
            DiagnosticOwner.Global(target: val target) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Global target=target />)
            DiagnosticOwner.Closure(expression: val expression) => semanticCompletionOwnersEqual(recorded: proof.owner, prepared: <SemanticCompletionOwner.Closure expression=expression />)
            DiagnosticOwner.Unknown => false
        }
        if !ownerMatches || !proof.kind.same(other: refusal.kind()) { return false }
        val locationMatches = match proof.location {
            DiagnosticLocation.Unpositioned => match refusal.location() { DiagnosticLocation.Unpositioned => true _ => false }
            DiagnosticLocation.Line(line: val line) => match refusal.location() { DiagnosticLocation.Line(line: val other) => line == other _ => false }
            DiagnosticLocation.File(path: val path, line: val line) => match refusal.location() { DiagnosticLocation.File(path: val otherPath, line: val otherLine) => path == otherPath && line == otherLine _ => false }
        }
        if !locationMatches { return false }
        val args = match self.arena.exprs[refusal.expression()] {
            Expr.Call(nameStart: val start, nameLen: val length, args: val args) => {
                if !self.isAuthoredFreeCall(exprId: refusal.expression(), start: start, length: length, args: args) { return false }
                give args
            }
            _ => { return false }
        }
        if args.start != refusal.argumentsStart() || args.len != refusal.argumentsCount() || proof.arguments.count() != args.len { return false }
        if args.start > self.arena.argPool.count() || args.len > self.arena.argPool.count() - args.start { return false }
        for index in 0U64..<args.len {
            val recorded = proof.arguments[index]
            val current = self.argAt(args: args, index: index)
            if recorded.expr != current.expr || recorded.isInout != current.isInout || recorded.hasLabel != current.hasLabel || recorded.labelStart != current.labelStart || recorded.labelLen != current.labelLen { return false }
        }
        return true
    }
}


pub impl Comp {
    // Observe retained dedicated refusal evidence, not the general Source domain.
    // Raw reports and unknown causes have no authority from text or cursor state.
    fn sourceFailureHasOwner(diagnostic: CompileDiagnostic) -> Bool {
        match diagnostic.typeSignature() {
            Optional.Some(v: val refusal) => { return self.sourceTypeSignatureFailureHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.closureSignature() {
            Optional.Some(v: val refusal) => { return self.sourceClosureSignatureFailureHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.typeVisibility() {
            Optional.Some(v: val refusal) => { return self.sourceTypeVisibilityHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.loopTarget() {
            Optional.Some(v: val refusal) => { return self.sourceLoopTargetFailureHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.namedDeclaration() {
            Optional.Some(v: val refusal) => { return self.sourceNamedDeclarationHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.operatorRequirement() {
            Optional.Some(v: val refusal) => { return self.sourceOperatorRequirementHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.indexRequirement() {
            Optional.Some(v: val refusal) => { return self.sourceIndexRequirementHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.sourceTyping() {
            Optional.Some(v: val refusal) => { return self.sourceTypingFailureHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.opaqueNumeric() {
            Optional.Some(v: val refusal) => { return self.sourceOpaqueNumericHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.genericCallConflict() {
            Optional.Some(v: val refusal) => { return self.sourceGenericCallConflictHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.arrayContext() {
            Optional.Some(v: val refusal) => { return self.sourceArrayContextHasOwner(refusal: refusal) }
            Optional.None => {}
        }
        match diagnostic.useAfterMove() {
            Optional.Some(v: val refusal) => {
                return self.sourceExpressionHasOwner(session: refusal.session(), expression: refusal.expression(), owner: refusal.owner())
            }
            Optional.None => {}
        }
        match diagnostic.missingField() {
            Optional.Some(v: val refusal) => {
                return self.sourceMissingFieldHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        match diagnostic.assignment() {
            Optional.Some(v: val refusal) => {
                return self.sourceAssignmentHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        match diagnostic.uniqueCopy() {
            Optional.Some(v: val refusal) => {
                return self.sourceExpressionHasOwner(session: refusal.session(), expression: refusal.expression(), owner: refusal.owner())
            }
            Optional.None => {}
        }    match diagnostic.freeCallAmbiguity() {
            Optional.Some(v: val refusal) => {
                return self.sourceFreeCallAmbiguityHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        match diagnostic.freeCallVisibility() {
            Optional.Some(v: val refusal) => {
                return self.sourceFreeCallVisibilityHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        match diagnostic.nonCallableBinding() {
            Optional.Some(v: val refusal) => {
                return self.sourceNonCallableBindingHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        match diagnostic.uniqueCapture() {
            Optional.Some(v: val refusal) => {
                return self.sourceUniqueCaptureHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        match diagnostic.memberCallAmbiguity() {
            Optional.Some(v: val refusal) => {
                return self.sourceMemberCallAmbiguityHasOwner(refusal: refusal)
            }
            Optional.None => {}
        }
        return false
    }
}
