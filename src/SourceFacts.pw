// Private owner-local backing. A published reader holds one Ref, never a
// snapshot of the directory or another owner's mutable arrays.
impl SourceBodyData {
    fn expressionHead(exprId: U64) -> SourceExpressionHead {
        match self.expressionKeys.get(key: exprId) {
            Optional.Some(v: val index) => {
                return <SourceExpressionHead term=self.expressions[index].term typeState=self.expressions[index].typeState invocation=self.expressions[index].invocation />
            }
            Optional.None => { return <SourceExpressionHead /> }
        }
    }
    fn expression(exprId: U64) -> Optional[SemanticExprType] {
        match self.expressionKeys.get(key: exprId) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.expressions[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putExpression(exprId: U64, fact: SemanticExprType) {
        match self.expressionKeys.get(key: exprId) {
            Optional.Some(v: val index) => { self.expressions.set(i: index, value: fact) }
            Optional.None => {
                self.expressionKeys[exprId] = self.expressions.count()
                self.expressionIds.append(exprId)
                self.expressions.append(fact)
            }
        }
    }
    // Only checked value facts cross publication. Capability/type-qualifier
    // probes and discarded untyped literals have no runtime fact requirement.
    inout fn discardTentativeExpressions() {
        mut val pending = false
        for fact in self.expressions {
            match fact.typeState {
                SemanticExpressionTypeState.Unrecorded | SemanticExpressionTypeState.Pending => { pending = true }
                _ => {}
            }
        }
        if !pending { return }
        val facts = self.expressions
        val identities = self.expressionIds
        self.expressions = []
        self.expressionIds = []
        self.expressionKeys = [:]
        mut val index = 0U64
        while index < facts.count() {
            match facts[index].typeState {
                SemanticExpressionTypeState.Unrecorded | SemanticExpressionTypeState.Pending => {
                    self.identifierTargets.remove(key: identities[index])
                    self.globalAddresses.remove(key: identities[index])
                }
                _ => { self.putExpression(exprId: identities[index], fact: facts[index]) }
            }
            index += 1U64
        }
    }
    fn binding(stmtId: U64) -> Optional[SourceBindingFact] {
        match self.bindingKeys.get(key: stmtId) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.bindings[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putBinding(stmtId: U64, fact: SourceBindingFact) {
        match self.bindingKeys.get(key: stmtId) {
            Optional.Some(v: val index) => { self.bindings.set(i: index, value: fact) }
            Optional.None => {
                self.bindingKeys[stmtId] = self.bindings.count()
                self.bindings.append(fact)
            }
        }
    }
    fn statement(stmtId: U64) -> Optional[SemanticExpressionCompletion] {
        match self.statementKeys.get(key: stmtId) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.statements[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putStatement(stmtId: U64, fact: SemanticExpressionCompletion) {
        match self.statementKeys.get(key: stmtId) {
            Optional.Some(v: val index) => { self.statements.set(i: index, value: fact) }
            Optional.None => {
                self.statementKeys[stmtId] = self.statements.count()
                self.statements.append(fact)
            }
        }
    }
    fn aggregate(exprId: U64) -> Optional[SemanticAggregate] {
        match self.aggregateKeys.get(key: exprId) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.aggregates[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putAggregate(fact: SemanticAggregate) {
        match self.aggregateKeys.get(key: fact.exprId) {
            Optional.Some(v: val index) => { self.aggregates.set(i: index, value: fact) }
            Optional.None => {
                self.aggregateKeys[fact.exprId] = self.aggregates.count()
                self.aggregates.append(fact)
            }
        }
    }
    fn tryDecomposition(exprId: U64) -> Optional[SemanticTry] {
        match self.tryKeys.get(key: exprId) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.tries[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putTry(fact: SemanticTry) {
        match self.tryKeys.get(key: fact.exprId) {
            Optional.Some(v: val index) => { self.tries.set(i: index, value: fact) }
            Optional.None => {
                self.tryKeys[fact.exprId] = self.tries.count()
                self.tries.append(fact)
            }
        }
    }
    fn matchIndex(source: MatchSource) -> Optional[U64] {
        match source {
            MatchSource.Statement(stmtId: val id) => { return self.statementMatchKeys.get(key: id) }
            MatchSource.Expression(exprId: val id) => { return self.expressionMatchKeys.get(key: id) }
            MatchSource.Condition(clauseIndex: val id) => { return self.conditionMatchKeys.get(key: id) }
        }
    }
    fn pattern(source: MatchSource) -> Optional[SemanticMatch] {
        match self.matchIndex(source: source) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.matches[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putMatch(fact: SemanticMatch) {
        match self.matchIndex(source: fact.matchSource) {
            Optional.Some(v: val index) => { self.matches.set(i: index, value: fact) }
            Optional.None => {
                val index = self.matches.count()
                match fact.matchSource {
                    MatchSource.Statement(stmtId: val id) => { self.statementMatchKeys[id] = index }
                    MatchSource.Expression(exprId: val id) => { self.expressionMatchKeys[id] = index }
                    MatchSource.Condition(clauseIndex: val id) => { self.conditionMatchKeys[id] = index }
                }
                self.matches.append(fact)
            }
        }
    }
}

impl SourceFactDirectory {
    inout fn state(owner: SemanticCompletionOwner) -> Optional[SourceBodyState] {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => {
                if index >= self.functions.count() { return <Optional.None /> }
                return self.functions[index]
            }
            SemanticCompletionOwner.Global(target: val target) => { return self.globals.get(key: target) }
            SemanticCompletionOwner.Closure(expression: val expression) => { return self.closures.get(key: expression) }
        }
    }
    inout fn setState(owner: SemanticCompletionOwner, state: SourceBodyState) {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => {
                while self.functions.count() <= index { self.functions.append(<Optional.None />) }
                self.functions.set(i: index, value: <Optional.Some v=state />)
            }
            SemanticCompletionOwner.Global(target: val target) => { self.globals[target] = state }
            SemanticCompletionOwner.Closure(expression: val expression) => { self.closures[expression] = state }
        }
    }
    inout fn outcome(owner: SemanticCompletionOwner) -> Optional[Result[(), CompileDiagnostic]] {
        if self.isActive(owner: owner) { return <Optional.None /> }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: _) | SourceBodyState.Registered => { return <Optional.Some v=<Result.Ok value=() /> /> }
                    SourceBodyState.Failed(diagnostic: val diagnostic) => { return <Optional.Some v=<Result.Err error=diagnostic /> /> }
                    SourceBodyState.Building | SourceBodyState.Active => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn prepared(owner: SemanticCompletionOwner) -> Optional[PreparedSemanticFacts] {
        if self.isActive(owner: owner) { return <Optional.None /> }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Succeeded(reader: val reader) => { return <Optional.Some v=self.readers[reader] /> }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn isActive(owner: SemanticCompletionOwner) -> Bool {
        match self.activeOwner {
            Optional.Some(v: val active) => { return semanticCompletionOwnersEqual(recorded: active, prepared: owner) }
            Optional.None => { return false }
        }
    }
    inout fn inactiveBuilder(owner: SemanticCompletionOwner) -> SourceBodyBuilder {
        val entry = match owner {
            SemanticCompletionOwner.Function(index: val index) => self.functionBuilders.get(key: index)
            SemanticCompletionOwner.Global(target: val target) => self.globalBuilders.get(key: target)
            SemanticCompletionOwner.Closure(expression: val expression) => self.closureBuilders.get(key: expression)
        }
        match entry {
            Optional.Some(v: val builder) => { return builder }
            Optional.None => { panic("internal error: source construction slot is missing") }
        }
    }
    inout fn saveInactiveBuilder(owner: SemanticCompletionOwner, builder: SourceBodyBuilder) {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => { self.functionBuilders[index] = builder }
            SemanticCompletionOwner.Global(target: val target) => { self.globalBuilders[target] = builder }
            SemanticCompletionOwner.Closure(expression: val expression) => { self.closureBuilders[expression] = builder }
        }
    }
    inout fn removeInactiveBuilder(owner: SemanticCompletionOwner) {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => { self.functionBuilders.remove(key: index) }
            SemanticCompletionOwner.Global(target: val target) => { self.globalBuilders.remove(key: target) }
            SemanticCompletionOwner.Closure(expression: val expression) => { self.closureBuilders.remove(key: expression) }
        }
    }
    inout fn activate(owner: SemanticCompletionOwner) {
        if self.isActive(owner: owner) { return }
        match self.activeOwner {
            Optional.Some(v: val previous) => {
                self.saveInactiveBuilder(owner: previous, builder: self.activeBuilder)
                self.setState(owner: previous, state: <SourceBodyState.Building />)
            }
            Optional.None => {}
        }
        val builder = match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                give match state {
                    SourceBodyState.Building => self.inactiveBuilder(owner: owner)
                    _ => { panic("internal error: completed source owner has no writer") }
                }
            }
            Optional.None => <SourceBodyBuilder data=<SourceBodyData owner=owner /> />
        }
        self.removeInactiveBuilder(owner: owner)
        self.setState(owner: owner, state: <SourceBodyState.Active />)
        self.activeBuilder = builder
        self.activeOwner = <Optional.Some v=owner />
    }
    inout fn clearActive(owner: SemanticCompletionOwner) {
        if self.isActive(owner: owner) {
            self.activeOwner = <Optional.None />
            self.activeBuilder = <SourceBodyBuilder data=<SourceBodyData owner=owner /> />
        }
    }
    // A request remains active across several source/check walks. The slot
    // called Active only locates construction storage, never a success result.
    inout fn begin(owner: SemanticCompletionOwner) -> Bool {
        self.activate(owner: owner)
        if self.activeBuilder.requested { return false }
        self.activeBuilder.requested = true
        return true
    }
    inout fn requiredExpressions(owner: SemanticCompletionOwner) -> Array[U64] {
        self.activate(owner: owner)
        return self.activeBuilder.data.requiredExpressions
    }
    inout fn children(owner: SemanticCompletionOwner) -> Array[U64] {
        self.activate(owner: owner)
        return self.activeBuilder.data.children
    }
    inout fn publish(owner: SemanticCompletionOwner) {
        self.activate(owner: owner)
        if !self.activeBuilder.requested { panic("internal error: source facts have no preparation request") }
        self.activeBuilder.data.discardTentativeExpressions()
        val data = self.activeBuilder.data
        self.clearActive(owner: owner)
        if self.measure {
            self.bodiesSealed += 1U64
            self.rowsSealed += data.expressions.count() + data.bindings.count() + data.statements.count() + data.aggregates.count() + data.tries.count() + data.matches.count() + data.closurePlans.count()
        }
        val payload: Ref[SourceBodyData] = <Ref value=data />
        val reader = self.readers.count()
        self.readers.append(<PreparedSemanticFacts readerIndex=reader session=self.session owner=owner payload=payload />)
        self.setState(owner: owner, state: <SourceBodyState.Succeeded reader=reader />)
        self.countRequest(owner: owner)
    }
    inout fn fail(owner: SemanticCompletionOwner, diagnostic: CompileDiagnostic) {
        if self.outcome(owner: owner).isSome() { return }
        self.clearActive(owner: owner)
        self.removeInactiveBuilder(owner: owner)
        self.setState(owner: owner, state: <SourceBodyState.Failed diagnostic=diagnostic />)
        self.countRequest(owner: owner)
    }
    inout fn registerBodyless(owner: SemanticCompletionOwner) {
        if self.outcome(owner: owner).isSome() { return }
        self.clearActive(owner: owner)
        self.removeInactiveBuilder(owner: owner)
        self.setState(owner: owner, state: <SourceBodyState.Registered />)
        self.countRequest(owner: owner)
    }
    inout fn countRequest(owner: SemanticCompletionOwner) {
        match owner {
            SemanticCompletionOwner.Function(index: _) => { self.functionRequests += 1U64 }
            SemanticCompletionOwner.Global(target: _) => { self.globalRequests += 1U64 }
            SemanticCompletionOwner.Closure(expression: _) => {}
        }
    }
    inout fn expressionHead(owner: SemanticCompletionOwner, exprId: U64) -> SourceExpressionHead {
        if self.isActive(owner: owner) { return self.activeBuilder.data.expressionHead(exprId: exprId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.expressionHead(exprId: exprId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].payload->expressionHead(exprId: exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <SourceExpressionHead />
    }
    inout fn expression(owner: SemanticCompletionOwner, exprId: U64) -> Optional[SemanticExprType] {
        if self.isActive(owner: owner) { return self.activeBuilder.data.expression(exprId: exprId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return self.activeBuilder.data.expression(exprId: exprId) }
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.expression(exprId: exprId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].expression(exprId: exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn statement(owner: SemanticCompletionOwner, stmtId: U64) -> Optional[SemanticExpressionCompletion] {
        if self.isActive(owner: owner) { return self.activeBuilder.data.statement(stmtId: stmtId) }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return self.activeBuilder.data.statement(stmtId: stmtId) }
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.statement(stmtId: stmtId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].payload->statement(stmtId: stmtId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
}

impl Comp {
    // Late constraint closure reads the node's registered owner, not the
    // cursor left by another source walk. This is a construction query and
    // does not grant a prepared-body reader.
    inout fn recordedSourceExpressionTerm(exprId: U64) -> U64 {
        match self.sourceFacts.expressionOwners.get(key: exprId) {
            Optional.Some(v: val owner) => { return self.sourceFacts.expressionHead(owner: owner, exprId: exprId).term }
            Optional.None => { return 0U64 }
        }
    }
    inout fn constructionExpressionHead(exprId: U64) -> SourceExpressionHead {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => { return self.sourceFacts.expressionHead(owner: owner, exprId: exprId) }
            Optional.None => { return <SourceExpressionHead /> }
        }
    }
    // Construction queries borrow the mutable session in place. Passing Comp
    // by value here would copy the entire session through the aggregate ABI.
    // Published payload readers remain immutable, small Ref-backed handles.
    inout fn constructionExpression(exprId: U64) -> SemanticExprType {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.expression(owner: owner, exprId: exprId) {
                    Optional.Some(v: val fact) => { return fact }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <SemanticExprType />
    }
    inout fn semanticExprConstructionClosed(exprId: U64) -> Bool {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => { if self.sourceOwnerConstructionClosed(owner: owner) { return true } }
            Optional.None => {}
        }
        match self.sourceFacts.expressionOwners.get(key: exprId) {
            Optional.Some(v: val owner) => { return self.sourceOwnerConstructionClosed(owner: owner) }
            Optional.None => { return false }
        }
    }
    inout fn semanticStmtConstructionClosed(stmtId: U64) -> Bool {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => { if self.sourceOwnerConstructionClosed(owner: owner) { return true } }
            Optional.None => {}
        }
        match self.sourceFacts.statementOwners.get(key: stmtId) {
            Optional.Some(v: val owner) => { return self.sourceOwnerConstructionClosed(owner: owner) }
            Optional.None => { return false }
        }
    }
    inout fn storeBuildingSemanticExprType(i: U64, value: SemanticExprType) {
        val owner = match self.currentSourceOwner() {
            Optional.Some(v: val owner) => owner
            Optional.None => { panic("internal error: expression construction has no source owner") }
        }
        match self.sourceFacts.expressionOwners.get(key: i) {
            Optional.Some(v: val prior) => {
                if !semanticCompletionOwnersEqual(recorded: prior, prepared: owner) { panic("internal error: expression fact changed its source owner") }
            }
            Optional.None => {}
        }
        self.sourceFacts.activate(owner: owner)
        self.sourceFacts.activeBuilder.data.putExpression(exprId: i, fact: value)
        self.sourceFacts.expressionOwners[i] = owner
        // Binding metadata belongs only to identifier nodes. Type/completion
        // refinement of every other expression does not edit binding tables.
        match self.arena.exprs[i] {
            Expr.Ident(start: _, len: _) => {
                // Freeze the selected value-binding category and target with the type.
                // Final consumers must not read the mutable construction TypeCache.
                self.sourceFacts.activeBuilder.data.identifierTargets.remove(key: i)
                self.sourceFacts.activeBuilder.data.globalAddresses.remove(key: i)
                if i < self.typeCache.identBind.count() && i < self.typeCache.identTarget.count() && self.typeCache.identBind[i] == identValueCode() {
                    self.sourceFacts.activeBuilder.data.identifierTargets[i] = self.typeCache.identTarget[i]
                    match self.recordedGlobalAddress(exprId: i) {
                        Optional.Some(v: val address) => { self.sourceFacts.activeBuilder.data.globalAddresses[i] = address }
                        Optional.None => {}
                    }
                }
            }
            _ => {}
        }
    }
    inout fn storeBuildingSemanticBinding(stmtId: U64, typeTerm: U64, endedBinding: U64) {
        match self.sourceRecordingOwner() {
            Optional.Some(v: val owner) => {
                self.sourceFacts.activate(owner: owner)
                self.sourceFacts.activeBuilder.data.putBinding(stmtId: stmtId, fact: <SourceBindingFact owner=owner typeTerm=typeTerm endedBinding=endedBinding />)
            }
            Optional.None => {}
        }
    }
    inout fn storeBuildingSemanticStmtCompletion(stmtId: U64, fact: SemanticExpressionCompletion) {
        self.sourceFacts.activate(owner: fact.owner)
        self.sourceFacts.activeBuilder.data.putStatement(stmtId: stmtId, fact: fact)
        self.sourceFacts.statementOwners[stmtId] = fact.owner
    }
}

impl Comp {
    inout fn sourceConsumerFacts(owner: SemanticCompletionOwner) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        match self.cur.sourceFactReader {
            Optional.Some(v: val index) => {
                if index < self.sourceFacts.readers.count() {
                    val facts = self.sourceFacts.readers[index]
                    if facts.session == self.sourceFacts.session && semanticCompletionOwnersEqual(recorded: facts.owner, prepared: owner) {
                        return <Result.Ok value=facts />
                    }
                }
            }
            Optional.None => {}
        }
        val facts = try self.preparedSemanticFacts(owner: owner)
        self.cur.sourceFactReader = <Optional.Some v=facts.readerIndex />
        return <Result.Ok value=facts />
    }
}

pub impl Comp {
    inout fn preparedSemanticFacts(owner: SemanticCompletionOwner) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        match self.sourceFacts.outcome(owner: owner) {
            Optional.Some(v: val outcome) => { try outcome }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: semantic facts require a prepared source owner") /> }
        }
        match self.sourceFacts.prepared(owner: owner) {
            Optional.Some(v: val facts) => { if self.sourceFacts.measure { self.sourceFacts.acquisitions += 1U64 } return <Result.Ok value=facts /> }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: registered callable has no source body") /> }
        }
    }
    inout fn preparedFunctionSemanticFacts(fnIdx: U64) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        return self.preparedSemanticFacts(owner: <SemanticCompletionOwner.Function index=(try self.semanticBodyOwner(fnIdx: fnIdx)) />)
    }
    inout fn preparedFunctionBodySignature(fnIdx: U64) -> Result[SourceBodySignature, CompileDiagnostic] {
        val facts = try self.preparedFunctionSemanticFacts(fnIdx: fnIdx)
        match facts.functionSignature() {
            Optional.Some(v: val signature) => { return <Result.Ok value=signature /> }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: prepared source body has no signature") /> }
        }
    }
    inout fn preparedGlobalSemanticFacts(target: U64) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        return self.preparedSemanticFacts(owner: <SemanticCompletionOwner.Global target=target />)
    }
    inout fn preparedClosureSemanticFacts(closure: SemanticClosure) -> Result[PreparedSemanticFacts, CompileDiagnostic] {
        return self.preparedSemanticFacts(owner: <SemanticCompletionOwner.Closure expression=closure.exprId />)
    }
    inout fn preparedSourceExpression(owner: SemanticCompletionOwner, exprId: U64) -> Result[SemanticExprType, CompileDiagnostic] {
        val facts = try self.preparedSemanticFacts(owner: owner)
        match facts.expression(exprId: exprId) {
            Optional.Some(v: val fact) => { return <Result.Ok value=fact /> }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: prepared owner has no matching source expression") /> }
        }
    }
    // Internal construction probes must supply their lexical cursor. Final
    // consumers acquire a successful owner's reader instead.
    inout fn sourceSemanticExprTypeAt(index: U64) -> SemanticExprType { return self.constructionExpression(exprId: index) }
}

impl SourceFactDirectory {
    inout fn parent(owner: SemanticCompletionOwner) -> Optional[SemanticCompletionOwner] {
        if self.isActive(owner: owner) { return self.activeBuilder.data.parent }
        match self.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return self.activeBuilder.data.parent }
                    SourceBodyState.Building => { return self.inactiveBuilder(owner: owner).data.parent }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.readers[reader].payload->parent }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn recordMatchOwner(source: MatchSource, owner: SemanticCompletionOwner) {
        match source {
            MatchSource.Statement(stmtId: val id) => { self.statementMatchOwners[id] = owner }
            MatchSource.Expression(exprId: val id) => { self.expressionMatchOwners[id] = owner }
            MatchSource.Condition(clauseIndex: val id) => { self.conditionMatchOwners[id] = owner }
        }
    }
    inout fn matchOwner(source: MatchSource) -> Optional[SemanticCompletionOwner] {
        match source {
            MatchSource.Statement(stmtId: val id) => { return self.statementMatchOwners.get(key: id) }
            MatchSource.Expression(exprId: val id) => { return self.expressionMatchOwners.get(key: id) }
            MatchSource.Condition(clauseIndex: val id) => { return self.conditionMatchOwners.get(key: id) }
        }
    }
}
impl Comp {
    inout fn constructionAggregate(exprId: U64) -> Optional[SemanticAggregate] {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.state(owner: owner) {
                    Optional.Some(v: val state) => {
                        match state {
                            SourceBodyState.Active => { return self.sourceFacts.activeBuilder.data.aggregate(exprId: exprId) }
                            SourceBodyState.Building => { return self.sourceFacts.inactiveBuilder(owner: owner).data.aggregate(exprId: exprId) }
                            SourceBodyState.Succeeded(reader: val reader) => { return self.sourceFacts.readers[reader].payload->aggregate(exprId: exprId) }
                            _ => {}
                        }
                    }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn constructionMatch(source: MatchSource) -> Optional[SemanticMatch] {
        match self.currentSourceOwner() {
            Optional.Some(v: val owner) => {
                match self.sourceFacts.state(owner: owner) {
                    Optional.Some(v: val state) => {
                        match state {
                            SourceBodyState.Active => { return self.sourceFacts.activeBuilder.data.pattern(source: source) }
                            SourceBodyState.Building => { return self.sourceFacts.inactiveBuilder(owner: owner).data.pattern(source: source) }
                            SourceBodyState.Succeeded(reader: val reader) => { return self.sourceFacts.readers[reader].payload->pattern(source: source) }
                            _ => {}
                        }
                    }
                    Optional.None => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
    inout fn registerClosureFactOwner(expression: U64, parent: SemanticCompletionOwner) {
        self.sourceFacts.activate(owner: parent)
        mut val found = false
        for child in self.sourceFacts.activeBuilder.data.children { if child == expression { found = true } }
        if !found { self.sourceFacts.activeBuilder.data.children.append(expression) }
        self.sourceFacts.activate(owner: <SemanticCompletionOwner.Closure expression=expression />)
        self.sourceFacts.activeBuilder.data.parent = <Optional.Some v=parent />
    }
    inout fn checkNestedSourceFacts(owner: SemanticCompletionOwner) -> Result[(), CompileDiagnostic] {
        val children = self.sourceFacts.children(owner: owner)
        for expression in children {
            val child = <SemanticCompletionOwner.Closure expression=expression />
            try self.checkSourceConversionEvidence(owner: child)
            try self.checkSourceDiagnosticFailures(owner: child)
            try self.checkSourceTypingObligations(owner: child)
            try self.checkNestedSourceFacts(owner: child)
        }
        return <Result.Ok value=() />
    }
    inout fn finishSourceFacts(owner: SemanticCompletionOwner, result: Result[(), CompileDiagnostic], bodyless: Bool = false) {
        val children = self.sourceFacts.children(owner: owner)
        for expression in children { self.finishSourceFacts(owner: <SemanticCompletionOwner.Closure expression=expression />, result: result) }
        match result {
            Result.Ok(value: _) => {
                if bodyless { self.sourceFacts.registerBodyless(owner: owner) }
                else { self.sourceFacts.publish(owner: owner) }
            }
            Result.Err(error: val diagnostic) => { self.sourceFacts.fail(owner: owner, diagnostic: diagnostic) }
        }
    }
}

impl Comp {
    inout fn lexicalSourceFactOwner(owner: SemanticCompletionOwner) -> SemanticCompletionOwner {
        match self.sourceFacts.parent(owner: owner) {
            Optional.Some(v: val parent) => { return self.lexicalSourceFactOwner(owner: parent) }
            Optional.None => { return owner }
        }
    }
}

impl Comp {
    fn sameMatchSource(a: MatchSource, b: MatchSource) -> Bool {
        match a {
            MatchSource.Statement(stmtId: val id) => { match b { MatchSource.Statement(stmtId: val other) => { return id == other } _ => { return false } } }
            MatchSource.Expression(exprId: val id) => { match b { MatchSource.Expression(exprId: val other) => { return id == other } _ => { return false } } }
            MatchSource.Condition(clauseIndex: val id) => { match b { MatchSource.Condition(clauseIndex: val other) => { return id == other } _ => { return false } } }
        }
    }
}

impl SourceBodyData {
    fn closure(exprId: U64) -> Optional[SemanticClosure] {
        match self.closureKeys.get(key: exprId) {
            Optional.Some(v: val index) => { return <Optional.Some v=self.closurePlans[index] /> }
            Optional.None => { return <Optional.None /> }
        }
    }
    inout fn putClosure(closure: SemanticClosure) {
        match self.closureKeys.get(key: closure.exprId) {
            Optional.Some(v: val index) => { self.closurePlans.set(i: index, value: closure) }
            Optional.None => {
                self.closureKeys[closure.exprId] = self.closurePlans.count()
                self.closurePlans.append(closure)
            }
        }
    }
    fn bindingNeedsCaptureCell(sourceFunction: U64, bindingTarget: U64) -> Bool {
        for closure in self.closurePlans {
            if closure.ownerFnIdx == sourceFunction {
                for capture in closure.captures {
                    match capture.mode {
                        SemanticClosureCaptureMode.CellBorrow => { if capture.bindingTarget == bindingTarget { return true } }
                        _ => {}
                    }
                }
            }
        }
        return false
    }
}
impl Comp {
    inout fn constructionClosure(owner: SemanticCompletionOwner, exprId: U64) -> Optional[SemanticClosure] {
        match self.sourceFacts.state(owner: owner) {
            Optional.Some(v: val state) => {
                match state {
                    SourceBodyState.Active => { return self.sourceFacts.activeBuilder.data.closure(exprId: exprId) }
                            SourceBodyState.Building => { return self.sourceFacts.inactiveBuilder(owner: owner).data.closure(exprId: exprId) }
                    SourceBodyState.Succeeded(reader: val reader) => { return self.sourceFacts.readers[reader].payload->closure(exprId: exprId) }
                    _ => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
}

pub impl Comp {
    fn sourceFactSession() -> U64 { return self.sourceFacts.session }
    inout fn requireSourceFactsSession(facts: PreparedSemanticFacts) -> Result[(), CompileDiagnostic] {
        if !facts.belongsToSession(session: self.sourceFacts.session) {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: semantic facts belong to another compiler session") />
        }
        return <Result.Ok value=() />
    }
}

pub impl Comp {
    inout fn enableSourceFactStatistics() { self.sourceFacts.measure = true }
    fn sourceFactStatistics() -> SourceFactStatistics {
        return <SourceFactStatistics enabled=self.sourceFacts.measure bodiesSealed=self.sourceFacts.bodiesSealed rowsSealed=self.sourceFacts.rowsSealed acquisitions=self.sourceFacts.acquisitions />
    }
}
