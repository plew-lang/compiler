// @Manifest — package-manifest (`Plew.toml`) reading and `@dep` import resolution.
//
// A DAG-bottom leaf (`Ir ← Manifest`, plus the shared `@Toml` reader): it operates
// only on byte buffers (the manifest's bytes, file paths) plus file existence, so
// the front-end loader can import it alongside @Path. Dependency RESOLUTION lives
// here: read the consuming package's `[dependencies]`, then turn a non-`@Std`
// `@<name>` import into the file that backs that dependency's lib face
// (`<dep>/src/_.pw`).
//
// Package model (spec/17): packages are FLAT — `@Acme/Http` names ONE package whose
// name is the literal string `Acme/Http` (the `/` is a name character, not submodule
// navigation), and its public surface is the exports of its `_.pw`. Only `@Std/...`
// is special (resolved against the bundled std dir by @Path) — every other `@name`
// is looked up whole in the dependency table.

import @Std/Io with { fileExists, readFileBytes }
import ./Toml with { TomlDoc, Section, Field, Value, KV, parseToml, topStr, inlineGet, bytesEq, spanEqArr, appendBytes }
import ./Lock with { Lock, lockCommitForConstraint, parseLock, emptyLock }
import ./Cache with { srcDir }

// One declared dependency from `[dependencies]`. `key` is the binding name the
// consumer writes after `@` (it may contain `/`). `kind`: 0 = path, 1 = git.
// `loc` is the path (relative to the package dir) for a path dep, or the git URL
// for a git dep. `version` is the digit-model constraint string ("" if absent).
export struct Dep {
    pub val key: Array[U8]
    pub val kind: U8
    pub val loc: Array[U8]
    pub val version: Array[U8]
}

// A parsed manifest: the package's own `name` and its declared dependencies.
export struct Manifest {
    pub val name: Array[U8]
    pub val deps: Array[Dep]
}

// Parse a `Plew.toml` byte buffer into a Manifest (name + dependency list) via the
// shared @Toml reader. Each `[dependencies]` field is `Key = { path | git, version }`.
export fn parseManifest(bytes: Array[U8]) -> Manifest {
    val doc: TomlDoc = parseToml(bytes: bytes)
    val name: Array[U8] = topStr(doc: doc, key: "name".bytes)
    mut val deps: Array[Dep] = []
    mut val si: U64 = 0
    while si < doc.sections.count {
        val sec: Section = doc.sections[si]
        if bytesEq(a: sec.header, b: "dependencies".bytes) {
            mut val fi: U64 = 0
            while fi < sec.fields.count {
                val f: Field = sec.fields[fi]
                match f.value {
                    Value.Inline(val kvs) => {
                        val path: Array[U8] = inlineGet(kvs: kvs, key: "path".bytes)
                        val git: Array[U8] = inlineGet(kvs: kvs, key: "git".bytes)
                        val version: Array[U8] = inlineGet(kvs: kvs, key: "version".bytes)
                        mut val kind: U8 = 0
                        mut val loc: Array[U8] = path
                        if path.count == 0 {
                            kind = 1
                            loc = git
                        }
                        deps.append(<Dep key=f.key kind=kind loc=loc version=version />)
                    }
                    _ => {}
                }
                fi += 1
            }
        }
        si += 1
    }
    return <Manifest name=name deps=deps />
}

// Read and parse `<pkgDir>Plew.toml` into its dependency list (empty when pkgDir
// is empty or carries no manifest). The loader calls this PER package so each
// file resolves its `@dep` imports against its own manifest.
export fn loadManifestDeps(pkgDir: Array[U8]) -> Array[Dep] {
    mut val deps: Array[Dep] = []
    if pkgDir.count == 0 {
        return deps
    }
    mut val maniPath: Array[U8] = []
    appendBytes(into: inout maniPath, from: pkgDir)
    appendBytes(into: inout maniPath, from: "Plew.toml".bytes)
    if !(fileExists(path: maniPath)) {
        return deps
    }
    val src: String = readFileBytes(path: maniPath)
    val mani: Manifest = parseManifest(bytes: src.bytes)
    return mani.deps
}

// Whether the import path bytes src[pStart .. pStart+pLen] are an external
// package import (`@<name>`) other than `@Std/…` — i.e. one that must be backed
// by a declared dependency. Used to enforce the phantom-dependency rule (spec/17).
export fn isExternalDepImport(src: Array[U8], pStart: U64, pLen: U64) -> Bool {
    if pLen < 2 {
        return false
    }
    if src[pStart] != 64 {
        return false
    }
    // `@Std/…` (or bare `@Std`) is the bundled std, not an external dependency.
    if pLen >= 4 {
        if src[pStart + 1] == 83 {
            if src[pStart + 2] == 116 {
                if src[pStart + 3] == 100 {
                    if pLen == 4 {
                        return false
                    }
                    if src[pStart + 4] == 47 {
                        return false
                    }
                }
            }
        }
    }
    return true
}

// Resolve a non-`@Std` `@<name>` import (path bytes src[pStart .. pStart+pLen],
// leading '@') against the declared dependencies. A PATH dep resolves to
// `<pkgDir><loc>/src/_.pw` (the dep's lib face). Other kinds (git, not fetched
// yet) and undeclared names return empty so the loader leaves them unresolved.
export fn resolveDepImport(src: Array[U8], pStart: U64, pLen: U64, deps: Array[Dep], pkgDir: Array[U8]) -> Array[U8] {
    mut val out: Array[U8] = []
    if pLen < 2 {
        return out
    }
    if src[pStart] != 64 {
        return out
    }
    val nameStart: U64 = pStart + 1
    val nameLen: U64 = pLen - 1
    mut val i: U64 = 0
    while i < deps.count {
        val d: Dep = deps[i]
        if spanEqArr(a: d.key, src: src, start: nameStart, len: nameLen) {
            if d.kind == 0 {
                appendBytes(into: inout out, from: pkgDir)
                appendBytes(into: inout out, from: d.loc)
                appendBytes(into: inout out, from: "/src/_.pw".bytes)
                return out
            }
            return out
        }
        i += 1
    }
    return out
}

// Resolve a non-`@Std` `@<name>` import to a GIT dependency's cached lib face: find
// the declared dep, look up its pinned commit in the lock, and point at
// `<cacheRoot>/src/<url>/<commit>/src/_.pw`. Empty when the name is not a git dep
// or is not yet locked (then the loader reports a phantom / unresolved import — the
// resolver must run first).
export fn resolveGitDepImport(src: Array[U8], pStart: U64, pLen: U64, deps: Array[Dep], cacheRoot: Array[U8], lock: Lock) -> Array[U8] {
    mut val out: Array[U8] = []
    if pLen < 2 {
        return out
    }
    if src[pStart] != 64 {
        return out
    }
    val nameStart: U64 = pStart + 1
    val nameLen: U64 = pLen - 1
    mut val i: U64 = 0
    while i < deps.count {
        val d: Dep = deps[i]
        if spanEqArr(a: d.key, src: src, start: nameStart, len: nameLen) {
            if d.kind == 1 {
                val commit: Array[U8] = lockCommitForConstraint(lock: lock, git: d.loc, constraint: d.version)
                if commit.count == 0 {
                    return out
                }
                appendBytes(into: inout out, from: srcDir(cacheRoot: cacheRoot, url: d.loc, commit: commit))
                appendBytes(into: inout out, from: "/src/_.pw".bytes)
                return out
            }
            return out
        }
        i += 1
    }
    return out
}

// Read and parse `<pkgDir>Plew.lock` (empty lock when absent). The loader reads it
// per package to back git `@dep` imports with their pinned commits.
export fn loadLock(pkgDir: Array[U8]) -> Lock {
    if pkgDir.count > 0 {
        mut val lockPath: Array[U8] = []
        appendBytes(into: inout lockPath, from: pkgDir)
        appendBytes(into: inout lockPath, from: "Plew.lock".bytes)
        if fileExists(path: lockPath) {
            val src: String = readFileBytes(path: lockPath)
            return parseLock(bytes: src.bytes)
        }
    }
    return emptyLock()
}
