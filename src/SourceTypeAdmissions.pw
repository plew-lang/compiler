// Successful trait-view admission belongs to an authored occurrence, not to a
// globally interned type. Provenance remains in SourceTypeUses; these rows carry
// the frozen evidence interpreted by signature consumers.
use ./Ir only { ResolvedViewSource, ProjectionNormalizationStep, FuncBindRange }
use ./SourceTypeUses only { AuthoredFunctionSignature }

pub struct AuthoredTypeViewProof {
    pub val occurrence: U64
    pub val receiver: U64
    pub val selector: ResolvedViewSource
    pub val proof: U64
    pub val admittedArguments: Array[U64] = []
    pub val lexicalEquations: Array[ProjectionNormalizationStep] = []
}
pub impl AuthoredTypeViewProof { factory }

pub struct AuthoredAssociatedBinding {
    pub val conformance: U64
    pub val occurrence: U64
    pub val recipe: U64
    pub val proofs: Array[AuthoredTypeViewProof]
}
pub impl AuthoredAssociatedBinding { factory }

pub struct AuthoredConformanceArgument {
    pub val occurrence: U64
    pub val recipe: U64
    pub val term: U64
    pub val replay: Bool
}
pub impl AuthoredConformanceArgument { factory }

pub struct AuthoredConformanceTarget {
    pub val scope: U64
    pub val arguments: Array[AuthoredConformanceArgument]
    pub val proofs: Array[AuthoredTypeViewProof]
}
pub impl AuthoredConformanceTarget { factory }

pub struct AuthoredProvidedClause {
    pub val assumption: U64
    pub val scope: U64
    pub val source: U64
}
pub impl AuthoredProvidedClause { factory }

pub struct AuthoredSignatureViews {
    pub val signature: AuthoredFunctionSignature
    pub val proofs: Array[AuthoredTypeViewProof]
    pub val receiverRecipes: Array[U64] = []
    pub val recipeChecks: Dictionary[U64, Bool] = [:]
    pub val recipeEquations: Dictionary[U64, Array[ProjectionNormalizationStep]] = [:]
    pub val receiverEquations: Array[ProjectionNormalizationStep] = []
    pub val parentScope: U64 = 0U64
    pub val parentParameters: FuncBindRange = <FuncBindRange start=0U64 len=0U64 />
    pub val parentSelfParameter: U64 = 0U64
    pub val inheritedRecipes: Dictionary[U64, Bool] = [:]
    pub val clauses: Array[AuthoredProvidedClause] = []
}
pub impl AuthoredSignatureViews { factory }

pub enum SourceSignatureSlot { Parameter(index: U64) Result FactoryError }
