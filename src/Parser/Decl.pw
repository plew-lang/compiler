// ---- compiler top-level frontend: parse-driven program lowering ----
//
// ALL parsing is the shared @Plew/Syntax parser's job now: `parseProgram` runs
// `parseProgramAst` over the compiler's token stream and `lowerTopItem`
// (Codegen/Lower.pw) lowers each value-tree item (decl / impl / trait / extern /
// import / export / directive) into the arena or Comp state. What remains here is the
// pure semantic-side work that has no value-tree/macro counterpart: module-tag
// helpers (markImport / recordExport, using original-offset spans — see moduleOf) and
// derive accumulation (drainDerives — recording each `@[...]` for the auto-part of the
// generated `.gen.pw` and the `plew gen` harness; `@[Eq]`/`@[Hash]` are real derive
// macros in @Plew/Syntax, not compiler-privileged synthesis).

// Attach the pending `@[...]` derive requests to the just-parsed type, then clear
// the scratch list for the next declaration.

pub impl Comp {
    inout fn drainDerives(typeStart: U64, typeLen: U64, isEnum: Bool, declStart: U64, declEnd: U64) {
        mut val i: U64 = 0
        while i < self.parseScratch.pendingDerives.count() {
            val d: DeriveReq = self.parseScratch.pendingDerives[i]
            self.decls.derives.append(<DeriveReq typeStart=typeStart typeLen=typeLen isEnum=isEnum nameStart=d.nameStart nameLen=d.nameLen declStart=declStart declEnd=declEnd args=d.args />)
            i += 1
        }
        self.parseScratch.pendingDerives = []
    }

    // Intern a string as arena bytes and return its interned `(start,len)` span — the
    // general name-minting helper used across lowering (synthetic idents, temp names).
    inout fn internBytes(s: String) -> Bind {
        val start: U64 = self.arena.bytes.count()
        val sb: Array[U8] = s.bytes()
        mut val i: U64 = 0
        while i < sb.count() {
            self.arena.bytes.append(sb[i])
            i += 1
        }
        val nid: U64 = intern(c: inout self, start: start, len: sb.count())
        return <Bind nameStart=start nameLen=sb.count() nameId=nid fieldStart=start fieldLen=sb.count() />
    }

    // Intern `<prefix><n>` (decimal) as a fresh name — for lowering-synthesized temps that
    // need a globally-unique name (e.g. compound-assign place bindings `__ce0`, `__ce1`).
    inout fn internTmpName(prefix: String, n: U64) -> Bind {
        val start: U64 = self.arena.bytes.count()
        val pb: Array[U8] = prefix.bytes()
        mut val i: U64 = 0
        while i < pb.count() {
            self.arena.bytes.append(pb[i])
            i += 1
        }
        // decimal digits of `n`, most-significant first (build LS-first, then reverse).
        mut val digits: Array[U8] = []
        mut val m: U64 = n
        if m == 0U64 {
            digits.append(digitByte(d: 0U64))
        }
        while m > 0U64 {
            digits.append(digitByte(d: m % 10U64))
            m = m / 10U64
        }
        mut val j: U64 = digits.count()
        while j > 0U64 {
            self.arena.bytes.append(digits[j - 1U64])
            j -= 1U64
        }
        val len: U64 = self.arena.bytes.count() - start
        val nid: U64 = intern(c: inout self, start: start, len: len)
        return <Bind nameStart=start nameLen=len nameId=nid fieldStart=start fieldLen=len />
    }

    // Index of the enum named (start,len), or c.arena.enums.count() if none.
    inout fn enumIndexByName(start: U64, len: U64) -> U64 {
        // an import alias (`with { Real as Alias }`) names the same enum as `Real` (spec/15).
        val ar: Bind = self.aliasReal(start: start, len: len)
        val qId: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        mut val i: U64 = 0
        while i < self.arena.enums.count() {
            if self.arena.enums[i].nameId == qId {
                return i
            }
            i += 1
        }
        return self.arena.enums.count()
    }


    // Record that the name `(nameStart,nameLen)` was brought into the current module
    // via `import <path> with { … }` (spec/15). The imported name token sits in the
    // importing file, so `moduleOf(nameStart)` is the importing module; it is stored as
    // the entry's `fieldStart`. A use of a cross-module name is visible only if it was
    // imported here (and exported by its own module). `(segStart,segLen)` is the path's
    // last segment (the source submodule) — kept for a future path-correctness check.
    inout fn markImport(segStart: U64, segLen: U64, nameStart: U64, nameLen: U64) {
        self.modules.imports.append(<Bind nameStart=nameStart nameLen=nameLen fieldStart=self.moduleOf(offset: nameStart) fieldLen=0 />)
    }

    inout fn recordExport(nameStart: U64, nameLen: U64) {
        self.modules.exports.append(<Bind nameStart=nameStart nameLen=nameLen fieldStart=self.moduleOf(offset: nameStart) fieldLen=0 />)
    }

    inout fn recordExportFrom(nameStart: U64, nameLen: U64, moduleOffset: U64) {
        self.modules.exports.append(<Bind nameStart=nameStart nameLen=nameLen fieldStart=self.moduleOf(offset: moduleOffset) fieldLen=0 />)
    }
}
