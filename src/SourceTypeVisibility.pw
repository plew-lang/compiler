// Namespace visibility consumes the common type-use evidence.
impl Comp {
    inout fn checkTypeUseVisibilityWithOrigin(ref: U64, occurrence: U64, origin: SourceTypeUseOrigin) -> Result[(), CompileDiagnostic] {
        val type = self.arena.typeAt(index: ref)
        if type.siteOffset != 0U64 && self.offsetIsLoaded(offset: type.siteOffset) {
            try self.checkTypeNameWithOrigin(siteOffset: type.siteOffset, start: type.nameStart, len: type.nameLen, occurrence: occurrence, origin: origin)
        }
        return <Result.Ok value=() />
    }

    inout fn checkTypeNameWithOrigin(siteOffset: U64, start: U64, len: U64, occurrence: U64, origin: SourceTypeUseOrigin) -> Result[(), CompileDiagnostic] {
        if len == 0U64 || self.isAmbientInLang(start: start, len: len) { return <Result.Ok value=() /> }
        val useMod = self.moduleOf(offset: siteOffset)
        if self.typeDeclVisibleFrom(useMod: useMod, start: start, len: len) { return <Result.Ok value=() /> }
        val real = self.realTypeNameInModule(useMod: useMod, start: start, len: len)
        if !self.typeDeclExistsGlobally(start: real.nameStart, len: real.nameLen) { return <Result.Ok value=() /> }
        val raw = self.diagnosticAt(offset: siteOffset, msg: "use of a type from another module without importing it (add `use … only {{ … }}`)")
        val evidence = match self.captureSourceTypeUseFailureEvidence(occurrence: occurrence, origin: origin) { Optional.Some(v: val evidence) => evidence Optional.None => { return <Result.Err error=raw /> } }
        if evidence.receipt.headStart != start || evidence.receipt.headLength != len || evidence.receipt.headSite != siteOffset { return <Result.Err error=raw /> }
        val refusal = <TypeVisibilityRefusal session=self.sourceFactSession() occurrence=occurrence event=self.failedTypeVisibility.count() location=raw.location() />
        self.failedTypeVisibility.append(<SourceTypeVisibilityFailure refusal=refusal evidence=evidence useModule=useMod realStart=real.nameStart realLength=real.nameLen />)
        return <Result.Err error=<CompileDiagnostic.typeVisibility refusal=refusal /> />
    }

    fn sourceTypeVisibilityHasOwner(refusal: TypeVisibilityRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.event() >= self.failedTypeVisibility.count() { return false }
        val proof = self.failedTypeVisibility[refusal.event()]
        if proof.refusal.session() != refusal.session() || proof.refusal.event() != refusal.event() || proof.refusal.occurrence() != refusal.occurrence() || !proof.refusal.location().same(other: refusal.location()) { return false }
        if !self.sourceTypeUseFailureEvidenceMatches(evidence: proof.evidence, occurrence: refusal.occurrence()) { return false }
        val file = match self.modules.sourceFileContaining(offset: proof.evidence.receipt.headSite) { Optional.Some(v: val file) => file Optional.None => { return false } }
        if self.modules.sourceFileRange(index: file).moduleId != proof.useModule { return false }
        // Owner/root relationship was sealed by the producer while a builder
        // existed. Failed closure builders must not be navigated again here.
        return true
    }
}
