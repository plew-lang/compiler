// Name-list comparison has no declaration, module, or diagnostic authority.
use @Plew/Syntax only { Span }

pub enum DeclarationLabelConflict {
    Malformed(index: U64)
    Duplicate(first: U64, second: U64)
}

pub fn declarationLabelConflict(bytes: Array[U8], labels: Array[Span]) -> Optional[DeclarationLabelConflict] {
    // Validate the whole input before comparison, including unequal-length
    // names which would otherwise bypass a bounds check.
    for index in 0U64..<labels.count() {
        val label = labels[index]
        if label.start > label.end || label.end > bytes.count() {
            return <Optional.Some v=<DeclarationLabelConflict.Malformed index=index /> />
        }
    }
    for first in 0U64..<labels.count() {
        val left = labels[first]
        for second in first+1U64..<labels.count() {
            val right = labels[second]
            if equalDeclarationLabelBytes(bytes: bytes, first: left, second: right) {
                return <Optional.Some v=<DeclarationLabelConflict.Duplicate first=first second=second /> />
            }
        }
    }
    return <Optional.None />
}

// Safe primitive for matching an authored position to its canonical spelling.
pub fn declarationLabelBytesEqual(bytes: Array[U8], first: Span, second: Span) -> Bool {
    if first.start > first.end || first.end > bytes.count() || second.start > second.end || second.end > bytes.count() { return false }
    return equalDeclarationLabelBytes(bytes: bytes, first: first, second: second)
}

// The group core validates all spans once before calling this primitive.
fn equalDeclarationLabelBytes(bytes: Array[U8], first: Span, second: Span) -> Bool {
    if first.end-first.start != second.end-second.start { return false }
    if first.start == second.start { return true }
    mut val offset = 0U64
    while offset < first.end-first.start {
        if bytes[first.start+offset] != bytes[second.start+offset] { return false }
        offset += 1U64
    }
    return true
}
