// A failed concrete selection is retained before result typing. Unknown queries
// and missing source receipts do not authorize a source rejection.
impl Comp {
    fn authoredBinaryMatches(expression: U64, authored: AuthoredBinaryExpression) -> Bool {
        if expression >= self.arena.exprs.count() || expression >= self.arena.exprOriginSerial.count() || expression >= self.arena.exprSpanStart.count() || expression >= self.arena.exprSpanEnd.count() { return false }
        if authored.serial == 0U64 || authored.serial != self.arena.exprOriginSerial[expression] || authored.start != self.arena.exprSpanStart[expression] || authored.end != self.arena.exprSpanEnd[expression] { return false }
        return match self.arena.exprs[expression] {
            Expr.Binary(op: val op, lhs: val lhs, rhs: val rhs) => op == authored.op && lhs == authored.lhs && rhs == authored.rhs
            _ => false
        }
    }

    // Only the actual missing branch of recordedOperatorSelection calls this.
    // The low-level candidate query receives no request or publication authority.
    inout fn missingOperatorRequirementDiagnostic(expression: U64, receiver: U64, argument: U64, traitOwner: U64, origin: SourceRecordOrigin) -> CompileDiagnostic {
        val location = self.diagnosticLocationAt(offset: self.exprOffset(id: expression))
        val raw = <CompileDiagnostic location=location message="arithmetic operator needs Add/Sub/Mul/Div/Rem; not implemented for this type" />
        val request = match origin {
            SourceRecordOrigin.Raw => { return raw }
            SourceRecordOrigin.CheckingRequest(session: val session, root: val root) => (session: session, root: root)
        }
        if request.session != self.sourceFactSession() || receiver == 0U64 || argument == 0U64 || receiver >= self.arena.typeCount() || argument >= self.arena.typeCount() || traitOwner == 0U64 { return raw }
        if !self.arena.typeIsClosed(ref: receiver) || !self.arena.typeIsClosed(ref: argument) { return raw }
        val authored = match self.authoredBinaryExpressions.get(key: expression) { Optional.Some(v: val authored) => authored Optional.None => { return raw } }
        if !isBinTraitOp(op: authored.op) || !self.authoredBinaryMatches(expression: expression, authored: authored) { return raw }
        val recorded = match self.sourceFacts.expressionOwners.get(key: expression) { Optional.Some(v: val recorded) => recorded Optional.None => { return raw } }
        if !semanticCompletionOwnersEqual(recorded: self.lexicalSourceFactOwner(owner: recorded), prepared: request.root) { return raw }
        if self.semanticExprTerm(exprId: authored.lhs) != receiver || self.semanticExprTerm(exprId: authored.rhs) != argument { return raw }
        val owner = self.currentDiagnosticOwner()
        if !self.sourceExpressionHasOwner(session: request.session, expression: expression, owner: owner) { return raw }
        val refusal = <OperatorRequirementRefusal session=request.session owner=owner expression=expression event=self.failedOperatorRequirements.count() location=location />
        self.failedOperatorRequirements.append(<SourceOperatorRequirementFailure refusal=refusal root=request.root authored=authored receiver=receiver argument=argument traitOwner=traitOwner />)
        return <CompileDiagnostic.operatorRequirement refusal=refusal />
    }

    fn sourceOperatorRequirementHasOwner(refusal: OperatorRequirementRefusal) -> Bool {
        if refusal.session() != self.sourceFactSession() || refusal.event() >= self.failedOperatorRequirements.count() { return false }
        val proof = self.failedOperatorRequirements[refusal.event()]
        val saved = proof.refusal
        if saved.session() != refusal.session() || !self.diagnosticOwnersEqual(first: saved.owner(), second: refusal.owner()) || saved.expression() != refusal.expression() || !saved.location().same(other: refusal.location()) { return false }
        if !self.sourceExpressionHasOwner(session: refusal.session(), expression: refusal.expression(), owner: refusal.owner()) || !self.authoredBinaryMatches(expression: refusal.expression(), authored: proof.authored) { return false }
        // The event owns the construction-time root and terms. Failed body
        // builders and the current recording cursor are not persistent evidence.
        if proof.receiver == 0U64 || proof.argument == 0U64 || proof.receiver >= self.arena.typeCount() || proof.argument >= self.arena.typeCount() { return false }
        val index = self.decls.traitOwnerIndex(offset: proof.traitOwner)
        if index >= self.decls.traitOwnerCount() { return false }
        val declaration = self.decls.traitOwnerAt(index: index)
        return declaration.nameStart == proof.traitOwner && declaration.arity == 1U64 && declaration.sourceModule == self.modules.coreModule
    }
}
