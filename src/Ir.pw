// @Ir — the pure IR data vocabulary of the Plew compiler: arena node types
// (Expr/Stmt/TypeRef/… indexed by U64) and the arena/table sub-structs that make
// up the compiler state, plus their public memberwise factories and the generic
// `appendBytes` byte primitive. A DAG-bottom leaf imported by `./Frontend` (which
// defines the aggregating `Comp` state + interner over these) and `./Backend`.
// `Comp` itself lives in `./Frontend` (its behavior is `impl Comp`, which must sit
// in the type's defining module — spec/15).

// ---- AST (arena, indexed by U64) ----
//
// Expressions and statements live in flat arenas (Array[Expr]/Array[Stmt]);
// children are referenced by U64 index. Operators are stored as kindCode (I64)
// to avoid nesting an enum inside an enum payload. Identifier nodes keep the
// source (start, len) span so codegen can echo the name via writeByte.

// A parsed type: for `Array[E]`, (start,len) names the element E and isArray is
// true; otherwise (start,len) names the type itself (scalar / String / named).
export struct PType {
    pub val start: U64
    pub val len: U64
    pub val isArray: Bool
    // index into Comp.arena.types of the full structured type (head name + type
    // arguments). The (start,len,isArray) triple above is the legacy "head"
    // view kept for the Array / scalar / named paths; `ref` carries the general
    // `Name[Arg, ...]` shape (nested, multi-arg) for generics. For `Array[E]`
    // the triple still names E with isArray=true, and ref is {Array, [E]}.
    pub val ref: U64
}

// A source selected by an authored `#Name`.  This is a semantic child of a
// value/type view, not a lookup side table: the written span exists only for
// diagnostics, while traitOwner is the declaration identity chosen in the
// lexical surface module.  A zero traitOwner is the deferred extension-bundle
// case; surfaceId is then the bundle's canonical name key.  Later phases must
// consume this node rather than recover an owner from its spelling again.
export struct ResolvedViewSource {
    pub val writtenStart: U64 = 0
    pub val writtenLen: U64 = 0
    pub val lexicalSurfaceModule: U64 = 0
    pub val surfaceId: U64 = 0
    pub val traitOwner: U64 = 0
}
pub impl ResolvedViewSource { factory }

// `TypeTerm` is the immutable semantic type row stored by Arena.  Type
// children are relations, not owned implementation details of a table row:
// reading a TypeTerm during grounding or LLVM lowering must never retain/drop
// an Array.  The legacy TypeRef mirror remains during migration only; all new
// high-frequency consumers must use these typed ranges and Comp readers.
export struct TypeArgumentRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeArgumentRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeRecordLabelRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeRecordLabelRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeRecordFieldRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeRecordFieldRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeViewIdRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeViewIdRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeViewSourceRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeViewSourceRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeArgumentLabelRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeArgumentLabelRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeAssocArgumentRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeAssocArgumentRange {
    factory
    fn count() -> U64 { return self.len }
}
export struct TypeAssocArgumentLabelRange {
    pub val start: U64
    pub val len: U64
}
pub impl TypeAssocArgumentLabelRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct TypeTerm {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64 = 0U64
    pub val paramId: U64 = 0U64
    pub val args: TypeArgumentRange = <TypeArgumentRange start=0U64 len=0U64 />
    pub val isRecord: Bool = false
    pub val recordFieldLabels: TypeRecordLabelRange = <TypeRecordLabelRange start=0U64 len=0U64 />
    pub val recordFieldTerms: TypeRecordFieldRange = <TypeRecordFieldRange start=0U64 len=0U64 />
    pub val viewExtId: U64 = 0U64
    pub val viewIds: TypeViewIdRange = <TypeViewIdRange start=0U64 len=0U64 />
    pub val viewSources: TypeViewSourceRange = <TypeViewSourceRange start=0U64 len=0U64 />
    pub val isAny: Bool = false
    pub val argLabels: TypeArgumentLabelRange = <TypeArgumentLabelRange start=0U64 len=0U64 />
    pub val assocTraitStart: U64 = 0U64
    pub val assocTraitLen: U64 = 0U64
    pub val assocTraitId: U64 = 0U64
    pub val assocTraitArgs: TypeAssocArgumentRange = <TypeAssocArgumentRange start=0U64 len=0U64 />
    pub val assocTraitArgLabels: TypeAssocArgumentLabelRange = <TypeAssocArgumentLabelRange start=0U64 len=0U64 />
    pub val assocNameStart: U64 = 0U64
    pub val assocNameLen: U64 = 0U64
    pub val assocNameId: U64 = 0U64
    // A projection owns no implicit receiver copy: `S#P.Item` points at the
    // separately interned semantic term for `S`. Zero for non-projections.
    pub val projectionReceiver: U64 = 0U64
    pub val isSendable: Bool = false
    pub val hasDecl: Bool = false
    pub val declOffset: U64 = 0U64
    pub val hasAssocTraitDecl: Bool = false
    pub val assocTraitDeclOffset: U64 = 0U64
    pub val siteOffset: U64 = 0U64
}
pub impl TypeTerm { factory }

// A structured type reference: a head type name span plus a list of type
// arguments (indices into Comp.arena.types). Non-generic types have an empty args
// list. `Array[E]` is {name="Array", args=[E]}; `Optional[I32]` is
// {name="Optional", args=[I32]}; a bare `I32` is {name="I32", args=[]}.
export struct TypeRef {
    pub val nameStart: U64
    pub val nameLen: U64
    // interned head-name id (Phase D): the content-keyed id of (nameStart,nameLen),
    // set centrally in `pushType` so every TypeRef in Comp.arena.types carries it. Type-name
    // equality becomes integer == on this id instead of a byte-by-byte `spansEqual`.
    // Shares the global intern table with Phase C decl names: a TypeRef naming "Foo"
    // gets the same id as the StructDef "Foo" (content-keyed), so type-vs-decl scans
    // unify too. 0 only for the index-0 dummy sentinel.
    pub val nameId: U64 = 0
    // Lexical generic binder identity.  0 means this is not a Param term.
    // A binder is identified by its lowering-time Bind allocation, never by
    // its spelling: unrelated `T`s must not be substituted through an
    // ambient Mono environment.  The final semantic TypeTerm represents this
    // as `Param { binder: ParamId }`; keeping it here is the migration carrier
    // while legacy consumers still read the flat arena shape.
    pub val paramId: U64 = 0
    pub val args: Array[U64]
    // A labelled anonymous record is a structural TypeTerm node, not a
    // nominal type whose field types are hidden in a synthetic layout name.
    // `name*` retains that layout name solely for ABI materialization; semantic
    // operations recurse through these parallel canonical field arrays.
    // Labels are interned ids, sorted by label just like the synthetic layout.
    pub val isRecord: Bool = false
    pub val recordFieldLabels: Array[U64] = []
    pub val recordFieldTerms: Array[U64] = []
    // `Person#Ext` (spec/09): the interned id of the extension view refining this
    // type, 0 for a plain type. A zero-cost view (same layout); it selects which
    // extension's methods resolve on a value of this type. Part of type identity
    // (an invariant refinement), so `Person` and `Person#Ext` are distinct types.
    pub val viewExtId: U64 = 0
    // Raw source spellings attached to a type-level view.  After declaration
    // resolution these normalize to an unordered extension set plus one optional
    // trait selector; retaining the list here makes the full source condition part
    // of type identity rather than collapsing it to the last `#Name`.
    pub val viewIds: Array[U64] = []
    // The semantic source set of this view.  Unlike `viewIds`, this preserves
    // a trait selector's resolved declaration owner across same-spelling
    // imports/re-exports.  `viewIds`/`viewExtId` remain a compatibility mirror
    // while old backend readers migrate; new semantic queries read this child.
    pub val viewSources: Array[ResolvedViewSource] = []
    // `any P` (spec/08): this TypeRef is the existential over trait `name`, not the
    // trait used as a plain (non-value) name. The runtime value is a fat pointer
    // `{ data, vtable }`; part of type identity. nameStart/nameLen/nameId name the
    // trait `P`.
    pub val isAny: Bool = false
    // binding labels parallel to `args` (interned name ids; 0 = positional): a named
    // associated-type / type-parameter binding `Name=Type` in `any P[Item=I32]`
    // (spec/08,12). Empty for ordinary generic args. Resolved against the trait's
    // type params + associated types when building the existential's dispatch thunks.
    pub val argLabels: Array[U64] = []
    // Associated-type projection (spec/08): `T#Trait[Args].Item` / `T.Item`. The
    // head name/args above name the projected-from type; assocTraitArgs select
    // the parameterized trait instance and never contain output bindings.
    pub val assocTraitStart: U64 = 0
    pub val assocTraitLen: U64 = 0
    pub val assocTraitId: U64 = 0
    pub val assocTraitArgs: Array[U64] = []
    pub val assocTraitArgLabels: Array[U64] = []
    pub val assocNameStart: U64 = 0
    pub val assocNameLen: U64 = 0
    pub val assocNameId: U64 = 0
    // Migration mirror of TypeTerm.projectionReceiver. New semantic readers
    // must consume the scalar TypeTerm relation, never reconstruct a receiver
    // by copying this row's argument arrays.
    pub val projectionReceiver: U64 = 0U64
    // `any sendable P` / `sendable fn(...) -> R`: a type-level sendability guarantee
    // written at the surface. It is recorded as part of the type spelling now; the
    // full capture/effect/spawn checks land with the ownership IR.
    pub val isSendable: Bool = false
    // Resolved declaration identity for this type head. The real declaration
    // offset is unique across loaded packages even when their spellings collide.
    pub val hasDecl: Bool = false
    pub val declOffset: U64 = 0
    // Resolved source trait identity for `T#Trait.Item`.
    pub val hasAssocTraitDecl: Bool = false
    pub val assocTraitDeclOffset: U64 = 0
    // the REAL source offset where this type was written (TypeAst.span.start), stamped by
    // `lowerType` for scoped type-visibility (Check/Visibility.pw). Unlike nameStart (which
    // is re-interned and so unusable for `moduleOf`), this is a genuine source coordinate:
    // `moduleOf(siteOffset)` is the module the annotation lives in. 0 = a synthetic TypeRef
    // (compiler-built: record struct, Optional/Result wrappers, …) or a type-parameter head
    // — both excluded from the visibility walk. A real annotation never sits at offset 0.
    pub val siteOffset: U64 = 0
}

// A variable binding in scope during codegen (param, let, or match bind), used
// to recover an expression's type for monomorphization and `.bytes()` dispatch.
// One enclosing local captured by a closure (value capture, immutable scalars
// only for now). Flat list keyed by `closureId` (the Closure node's arena
// index); querying a closure's captures filters by it. The capture becomes a
// field of `__closure_env<closureId>`, read in the body via `__env`.
export struct CaptureEntry {
    pub val closureId: U64
    pub val nameStart: U64
    pub val nameLen: U64
    pub val tyStart: U64
    pub val tyLen: U64
    pub val isArray: Bool
    pub val ty: U64
    // a `mut val` capture: the enclosing local is heap-boxed (an implicit ARC
    // cell) and the env holds a retained pointer to it, so mutations are shared
    // (Swift-style reference capture). Non-mut captures are by-value (boxed=false).
    pub val boxed: Bool
}

export struct Local {
    pub val nameStart: U64
    pub val nameLen: U64
    // interned name id (Phase C): set when the local is pushed (addLocalCn); 0 sentinel.
    pub val nameId: U64 = 0
    pub val tyStart: U64
    pub val tyLen: U64
    // interned type-head id (Phase D): content-keyed id of (tyStart,tyLen). Set in
    // addLocalCn; the move-rebuild copies it. May be the empty-span id for synthetic
    // locals whose tyStart/tyLen are 0 (consistent: such a local never type-matches a
    // real type). Type equality on a local becomes integer == instead of spansEqual.
    pub val tyNameId: U64 = 0
    pub val isArray: Bool
    // structured type (Comp.arena.types index); carries generic type arguments that
    // the (tyStart,tyLen,isArray) head view cannot.
    pub val ty: U64
    pub val isInout: Bool
    // assignable? `mut val` locals and `inout` params are; plain `val` locals,
    // function params, for-loop vars and match binds are immutable (spec: `val`
    // is immutable, `mut val` is the mutable storage form).
    pub val isMut: Bool
    // owns its value (a `let` binding) and so releases it at scope exit, vs a
    // borrow (param / for-loop var / match bind) that aliases someone else's
    // storage and must not free it. ARC: only owned heap locals are released.
    pub val owned: Bool
    // moved-out (spec/03): a `move` binding/arg transferred ownership away, so
    // this local is dead — using it again is an error and it is NOT released at
    // scope exit (the new owner releases). Set during codegen as moves are seen.
    pub val moved: Bool
    // shadowing disambiguator for the emitted C name (spec/03,11: shadowing is
    // unlimited). 0 = emit the bare source name; N>0 = emit `<name>_sN` so two
    // same-named `val`/`mut val` bindings in one block don't collide in C. Only
    // `let` bindings ever get N>0 (for-vars/match-binds/params open nested C
    // scopes, so C shadowing covers them and they stay 0).
    pub val cnum: U64
}

// The recovered type of an expression. kind: 0 scalar (long long), 1 String,
// 2 named struct/enum, 3 array. For named: (nameStart,len) is the type name;
// for array: the element type name (always backed by a real declaration span).
export struct TypeInfo {
    pub val kind: I64
    pub val nameStart: U64
    pub val nameLen: U64
    // Comp.arena.types index of the full structured type when this is a generic
    // instantiation (e.g. `Optional[I32]`), so match/dispatch can recover the
    // mangled C name and substitute type parameters. 0 (sentinel) otherwise.
    pub val ref: U64
    // the extension-view id (`Person#Ext`, spec/09), 0 for a plain type. Carried so
    // the front-end type recovery stops dropping the view that `TypeRef.viewExtId`
    // holds — the first step toward unifying recovery with the backend (which needs
    // the view for view-aware overload selection). Default 0 keeps existing
    // constructions (which omit it) view-less, as before.
    pub val viewExtId: U64 = 0
}

// The semantic type recorded for one expression node. `term` is the complete
// parametric TypeRef (and is grounded only by an explicit instance environment);
// `shape` retains the value-level classification that a TypeRef alone cannot
// express, most importantly an untyped numeric literal. `legacy*` is the
// one-way adapter payload for the still-migrating TypeInfo consumers. It is not
// an independent type source: every write enters through Comp's semantic-entry
// helpers, and the adapter is reconstructed from this entry.
//
// Shapes: 0 unknown scalar, 1 scalar, 2 String, 3 nominal, 4 Array,
// 5 function, 6 existential. Source locations stay on Expr/TypeRef and are
// deliberately absent from semantic identity.
export struct SemanticExprType {
    pub val term: U64 = 0
    pub val shape: U64 = 0
    pub val legacyKind: I64 = 0
    pub val legacyNameStart: U64 = 0
    pub val legacyNameLen: U64 = 0
    pub val legacyRef: U64 = 0
    pub val legacyViewExtId: U64 = 0
    // Integer/float context code. This is a semantic constraint recorded by
    // checking, not a source span and not part of TypeTerm identity.
    pub val literalContext: U64 = 0
    // A field expression carries the frontend-selected physical field slot.
    // `term` carries the selected, possibly-parametric field type; this slot
    // carries only layout identity.  Keeping both prevents Mid/backend from
    // reopening a field spelling after the frontend freeze.
    pub val hasFieldProjection: Bool = false
    pub val fieldProjectionIndex: U64 = 0U64
}
pub impl SemanticExprType { factory }

// A construction has semantic information that a result TypeTerm alone cannot
// carry: physical field/variant layout and the authored evaluation order of
// child values. Record freezes it before Mid lowering so neither Mid nor LLVM
// has to reopen JSX labels, enum spelling, or a collection API.
export enum SemanticAggregateKind {
    Struct
    // Declaration identity as well as variant slot is frozen here.  The
    // backend may consult this identity only for physical layout, never recover
    // an enum by the construction's spelling or result-type name.
    Enum(enumIdx: U64, variantIndex: U64)
    Array
}

export struct SemanticAggregateElement {
    // Struct/enum storage uses the frontend-selected physical field slot.
    // Array elements are naturally indexed in source order and use the same
    // value for this field. `elements` itself remains source-evaluation order.
    pub val fieldIndex: U64
    // Navigation anchors only. The semantic identity is owner + aggregate
    // record; later Mid lookup may read an already-frozen call/aggregate at
    // this child but never reselects it from spelling.
    pub val exprId: U64
    // The frontend-selected physical slot type after the aggregate result's
    // own generic arguments are applied.  This makes element conversion a
    // closed source->target fact rather than a Mid/backend field re-query.
    pub val targetTerm: U64 = 0U64
    pub val term: U64
}
pub impl SemanticAggregateElement { factory }

export struct SemanticAggregate {
    pub val ownerFnIdx: U64 = 0U64
    pub val exprId: U64 = 0U64
    pub val kind: SemanticAggregateKind = <SemanticAggregateKind.Struct />
    pub val resultTerm: U64 = 0U64
    // Number of physical storage slots. A Path-1 aggregate is emitted only
    // when Record supplied every slot; default-field elaboration stays on the
    // legacy path until it has an equally explicit semantic carrier.
    pub val fieldCount: U64 = 0U64
    pub val elements: Array[SemanticAggregateElement] = []
}
pub impl SemanticAggregate { factory }

// One selected payload projection in an enum-match arm.  `bindTarget` is the
// declaration identity that Record/Verify gives the arm local; the physical
// field slot and its parametric TypeTerm are frozen beside it so Mid never
// maps a field spelling back onto an enum declaration.
export struct SemanticMatchPayload {
    pub val bindTarget: U64 = 0U64
    pub val fieldIndex: U64 = 0U64
    pub val fieldTerm: U64 = 0U64
}
pub impl SemanticMatchPayload { factory }

// One arm in a parametric enum-match descriptor. A wildcard has
// `hasVariant=false`; its payload list is necessarily empty. Variant indices
// are declaration slots, not source names.
export struct SemanticMatchArm {
    pub val hasVariant: Bool = false
    pub val variantIndex: U64 = 0U64
    pub val payloads: Array[SemanticMatchPayload] = []
}
pub impl SemanticMatchArm { factory }

// The frozen frontend meaning of one statement enum match. The AST statement
// id remains only a body-navigation anchor: identity is `(ownerFnIdx, stmtId)`.
// `scrutineeTerm` is parametric in a generic body and is grounded exactly once
// into FinalMatchResolution for the concrete BodyInstance.
export struct SemanticMatch {
    pub val ownerFnIdx: U64 = 0U64
    pub val stmtId: U64 = 0U64
    pub val scrutineeTerm: U64 = 0U64
    pub val enumIndex: U64 = 0U64
    pub val arms: Array[SemanticMatchArm] = []
}
pub impl SemanticMatch { factory }

// Provenance survives default expansion; a diagnostic offset is not authority.
export enum MakeFieldOrigin {
    Written
    DeclarationDefault
    Synthesized
}

// One `field=expr` pair inside a JSX construction `<Type field=expr ... />`.
export struct MakeField {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val value: U64
    // original-source byte offset of the field name (for diagnostics): nameStart is
    // re-interned and so does not map back to a source line. 0 = unknown.
    pub val offset: U64 = 0
    pub val origin: MakeFieldOrigin = <MakeFieldOrigin.Written />
}

// One field binding inside a match pattern `E.V(val a, b: val c)`. `name` is
// the introduced local; `field` is the variant field it reads. For punning
// (`val a`) the two are equal; for rename (`b: val c`) field=b, name=c.
// (Also reused elsewhere as a plain (name) span pair — array element names,
// part directives — where the field span is just set equal to the name.)
export struct Bind {
    pub val nameStart: U64
    pub val nameLen: U64
    // interned name id (Phase D): set by internBytes for every re-interned name, so
    // type-parameter / supertrait / associated-type names (all built via internBytes)
    // match by integer ==. 0 for Binds built by a raw `<Bind .../>` literal that does
    // not set it (non-type uses: kwCache, deinits, moduleRanges, imports/exports) —
    // those are not compared by nameId.
    pub val nameId: U64 = 0
    // Lexical identity of a generic binder. Unlike nameId/nameStart this is
    // never content-interned: independently written `T`s are distinct.
    // 0 marks a non-generic Bind.
    pub val paramId: U64 = 0
    pub val fieldStart: U64
    pub val fieldLen: U64
    // original-source byte offset of the bound field name (for diagnostics):
    // fieldStart is re-interned and does not map to a source line. 0 = unknown.
    pub val offset: U64 = 0
    // A generic type parameter written `[sendable T]`. False for ordinary binders and
    // for non-type uses of Bind (match binds, field pairs, module ranges, ...).
    pub val isSendable: Bool = false
}

// A call argument: the expression plus whether it was passed `inout` (which
// lowers to `&(expr)` at the call site, matching a pointer parameter).
export struct Arg {
    pub val expr: U64
    pub val isInout: Bool
    // the argument label `name:`. Empty for a label-suppressed positional arg.
    // Provided arguments keep source order; resolution maps them to parameters in
    // declaration order while allowing defaulted parameters to be skipped.
    pub val labelStart: U64
    pub val labelLen: U64
    pub val hasLabel: Bool
}

// Immutable slice of call arguments in Arena.argPool. Call-like Expr nodes
// carry only this scalar descriptor, so inspecting a call never copies an ARC
// managed Array payload.
export struct ArgRange {
    pub val start: U64
    pub val len: U64
}
pub impl ArgRange { factory }

// Immutable slice of expression children in Arena.exprChildPool.  Array literal
// nodes keep only this scalar descriptor: reading Expr.Array therefore does not
// copy an ARC-managed Array payload on each frontend/backend traversal.
export struct ExprRange {
    pub val start: U64
    pub val len: U64
}
pub impl ExprRange { factory }

// Immutable slice of construction fields in Arena.makeFieldPool. Make nodes
// carry only this scalar descriptor, so inspecting a construction cannot copy
// an ARC-managed field Array during frontend or backend walks.
export struct MakeFieldRange {
    pub val start: U64
    pub val len: U64
}
pub impl MakeFieldRange { factory }

// Immutable pattern-bind slice. Match arms, destructuring `for` headers, and
// destructure sites all refer to the same Arena pool: these bindings are AST
// children with arena lifetime, never independently owned values.
export struct BindRange {
    pub val start: U64
    pub val len: U64
}
pub impl BindRange { factory }

// Immutable match-arm slice. A match node therefore carries scalar payload
// only; inspecting it cannot retain/drop an Array of arms (or each arm's
// pattern-bind buffer) during the many frontend/backend walks.
export struct MatchArmRange {
    pub val start: U64
    pub val len: U64
}
pub impl MatchArmRange { factory }

// Immutable payload ranges for a Conform row. Conformance lookup is among the
// hottest frontend paths; keeping the row scalar is required so inspecting an
// edge does not retain/drop every generic argument, binder, and witness list.
// The pools live in Decls (rather than Arena) because these are declaration
// facts, not source-tree children.
export struct ConformTypeRange {
    pub val start: U64
    pub val len: U64
}
pub impl ConformTypeRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct ConformBindRange {
    pub val start: U64
    pub val len: U64
}
pub impl ConformBindRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct ConformWitnessRange {
    pub val start: U64
    pub val len: U64
}
pub impl ConformWitnessRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct ConformFuncIdRange {
    pub val start: U64
    pub val len: U64
}
pub impl ConformFuncIdRange {
    factory
    fn count() -> U64 { return self.len }
}


export enum Expr {
    // An integer (or Bool) literal. `value` is the non-negative magnitude (U64,
    // so the full unsigned range up to 2^64-1 fits); a leading `-` is a separate
    // `offset` is the source byte for diagnostics. `isBool` marks `true`/`false`
    // (lowered to 1/0 but typed Bool, never an ambiguous integer). `tyStart`/`tyLen`
    // is an optional type suffix span (`5U64`, `1I32`); tyLen 0 = no suffix, so the
    // type comes from context. `isNeg` marks a folded negative literal (`-128I8` is
    // the literal -128, not Neg(128) — spec/02): `value` is the magnitude, codegen
    // emits the leading `-`, and the range check uses the negative sign.
    Int(value: U64, offset: U64, isBool: Bool, tyStart: U64, tyLen: U64, isNeg: Bool)
    Float(start: U64, len: U64, tyStart: U64, tyLen: U64)
    Ident(start: U64, len: U64)
    Unary(op: I64, operand: U64)
    Binary(op: I64, lhs: U64, rhs: U64)
    Call(nameStart: U64, nameLen: U64, args: ArgRange)
    Field(base: U64, nameStart: U64, nameLen: U64)
    Make(typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, ty: U64, fields: MakeFieldRange)
    Str(start: U64, len: U64)
    Array(elems: ExprRange)
    Index(base: U64, index: U64)
    Method(recv: U64, nameStart: U64, nameLen: U64, args: ArgRange)
    // `recv#Src.name(args)` (spec/09): a method call through an extension view.
    // `src` is the extension name selecting the method source; resolution finds a
    // method tagged with that extension on the receiver's type (it does not join
    // bare resolution). Distinct from Method so bare matches are unaffected.
    ExtMethod(recv: U64, source: ResolvedViewSource, nameStart: U64, nameLen: U64, args: ArgRange)
    // `recv#Ext` / `recv#!Ext` (spec/09): a zero-cost value re-view. Evaluates
    // `recv` unchanged. `strip=false` gives its type the `#Ext` view (viewExtId);
    // `strip=true` removes the view (`#!Ext` super form) so a following bare
    // `.method()` resolves the shadowed bare method. `src` names the extension.
    ExtView(recv: U64, source: ResolvedViewSource, strip: Bool)
    Cast(operand: U64, tyStart: U64, tyLen: U64, ty: U64)
    // value-position `match scrut { Pat => expr, ... }`: like Stmt.Match but each
    // arm yields an expression (MatchArm.body is an Expr index, not a Block).
    // Lowers to a C statement-expression.
    MatchExpr(scrut: U64, arms: MatchArmRange)
    // value-position `if cond { ... give a } else { ... give b }`: each branch is
    // a block ending in `give`. Lowers to a C statement-expression (like
    // MatchExpr). `else` is mandatory in value position (it must always yield).
    IfExpr(cond: U64, thenBlk: U64, elseBlk: U64)
    // `base?.<cont>` (optional chaining, spec/12): if `base` (a Chain type) yields a
    // value, the result wraps `cont` applied to that value, else empty — Swift-style
    // propagation over the WHOLE trailing chain. `cont` is a member-access expr tree
    // rooted at a `ChainHole` (the unwrapped base); the mono desugar substitutes the
    // bound value for the hole and rewrites this node to the `Chain`-trait match.
    OptChain(base: U64, cont: U64)
    // The unwrapped-base placeholder at the root of an OptChain's `cont`. Types as the
    // receiver's chain Value; the desugar replaces it with the match-bound value.
    ChainHole
    // `try expr` (Result early return): if `expr` is `Err`, return it from the
    // enclosing function (rebuilt as the function's own Result error variant);
    // otherwise the `Ok` value. Couples to @Std/Core's Result shape (Ok = tag 0
    // field `value`, Err = tag 1 field `error`). First cut: error types must
    // match (no `From` conversion yet).
    Try(expr: U64)
    // `ref->field` — access a field of a `Ref[T]`'s pointee. `Ref[T]` lowers to
    // a C `T*`, so this is C's `ref->field`. `->` is spec's pointee accessor;
    // the bare handle is `.` (rare). Shared mutation is visible at `->`.
    Arrow(base: U64, nameStart: U64, nameLen: U64)
    // `*ref` as a place — the POINTEE of a `Ref[T]` (the receiver of `ref->method()`).
    // Resolves to the pointee struct/enum: its type is T, its address is the cell pointer,
    // its value is the loaded pointee. Used only as a method receiver so the existing
    // dispatch (struct/enum/generic/inout) drives `->` method calls; `ref->field` stays
    // `Arrow`. Built by lowering `ExprAst.ArrowMethod`; `base` must be a `Ref[T]` expr.
    Deref(base: U64)
    // a closure literal `fn(params) -> ret { body }`. Lambda-lifted to a
    // top-level C function named `__closure<exprIndex>` taking a leading env
    // pointer. The expression value is a fat PlewClosure {fn, env, rc, drop}.
    // Captures of enclosing locals are recorded in Comp.captures keyed by this
    // node's arena index; the body reads each via `((__closure_env<id>*)__env)`.
    Closure(params: Array[Param], hasRet: Bool, retStart: U64, retLen: U64, retIsArray: Bool, retTy: U64, body: U64)
    // `move operand` / `borrow operand` (spec/03): an access-mode prefix on a
    // `unique` value in a binding/argument/return position. Lowers to the
    // operand's value (a unique struct is a bit-copy); `move` additionally marks
    // the operand's place moved-out so the source is dead and not double-released.
    Move(operand: U64, isBorrow: Bool)
    // `await operand` (spec/14): suspend the enclosing `async fn` until `operand`
    // (a `Promise[T]`) resolves, then yield the `T`. Only valid in statement-head
    // position for now (`val x = await e` / `await e` / `return await e`); the
    // async lowering expands it to a save-state / suspend / resume sequence.
    Await(operand: U64)
}

// One arm of a match: either `_ => block` (wildcard) or `Enum.Variant
// [{ val f ... }] => block`. The pattern names the enum and variant, so codegen
// resolves the tag index and field types without any type inference.
export struct MatchArm {
    pub val isWildcard: Bool
    pub val enumStart: U64
    pub val enumLen: U64
    pub val variantStart: U64
    pub val variantLen: U64
    pub val binds: BindRange
    // body is always a Block index (for both Stmt.Match and Expr.MatchExpr). A
    // value-match arm's block ends in `give <expr>` (the arm value); a diverging
    // arm's block ends in `panic`/`return` and is excluded from the result PHI.
    pub val body: U64
    // a struct destructuring pattern `S { val x }` (irrefutable, no tag): bind
    // fields directly from the scrutinee. enumStart names the struct type.
    pub val isStruct: Bool
    // (value-match only) the arm diverges (`=> panic …` / `=> return …`) and so
    // yields no value. Backend excludes it from the result PHI. Always false for
    // statement-match arms (their value is unused).
    pub val isDiverge: Bool = false
}

// The pattern part of a match arm (everything before `=>`), shared by statement
// and expression match parsing. Mirrors MatchArm minus the body.
export struct PatInfo {
    pub val isWildcard: Bool
    pub val enumStart: U64
    pub val enumLen: U64
    pub val variantStart: U64
    pub val variantLen: U64
    pub val binds: BindRange
    pub val isStruct: Bool
}

// The full resolution of a bare identifier, produced in ONE pass by resolveIdent:
// its binding classification (`code` = identValueCode/FnCode/TypeQualCode/UndefCode)
// and, for the backend to locate it without re-deriving by name, the `target`
// (identTarget's value): a resolved free-function index for a callable declaration, the
// DECLARATION's source offset (locals[li].nameStart) for a local/param value,
// identSelfTarget() for `self`; identNoTarget() for a global, a type qualifier, or an undef. This is the
// single source both the classification query (classifyIdent/bindIsValue) and the
// recorder (recordIdent) read, so the resolver never scans a name table twice.
export struct IdentBinding {
    pub val code: I64
    pub val target: U64
}

export enum Stmt {
    Let(mutable: Bool, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64)
    // A plain `place = value`. Compound `place OP= v` is desugared to `place = place OP v`
    // in the Lower pass (spec/12, place-once), so the IR has no compound form — the OP rides
    // its operator-trait witness like any binary. There is no `op` field.
    Assign(target: U64, value: U64)
    ExprStmt(expr: U64)
    // `offset` = the `return` keyword's source offset (for the bare-return-in-a
    // value-returning-function diagnostic). 0 for synthesized returns.
    Return(value: U64, hasValue: Bool, offset: U64)
    If(cond: U64, thenBlk: U64, elseBlk: U64, hasElse: Bool)
    While(cond: U64, body: U64)
    // `for val name in iter { body }`. isRange: iter is `lo ..(< | =) hi`
    // (inclusive picks <=); otherwise iter is an array, walked by index.
    // isStruct: the header is a struct-destructure pattern `for S { val x } in
    // arr` — patStart/patLen name the written struct type and binds list the
    // fields to bind from each element (varStart/varLen unused then). isStruct
    // false is the single-binding form (binds empty).
    For(varStart: U64, varLen: U64, varTyStart: U64, varTyLen: U64, isRange: Bool, inclusive: Bool, iter: U64, rangeHi: U64, body: U64, isStruct: Bool, patStart: U64, patLen: U64, binds: BindRange)
    Match(scrut: U64, arms: MatchArmRange)
    // `panic <msg>`: a diverging statement (spec: unrecoverable, never returns).
    // msg is a String expression; offset is the `panic` keyword for diagnostics.
    Panic(msg: U64, offset: U64)
    // `give <expr>`: yields the value of the enclosing block-expression (an
    // `if`/`match` used in value position). Codegen assigns it to the active
    // result temp.
    Give(value: U64)
    // `offset` = the keyword's source offset (for the outside-a-loop diagnostic).
    Break(offset: U64)
    Continue(offset: U64)
}

// A block owns no Array value. Its statement sequence lives in Arena.blockStmtPool
// and is addressed by this immutable slice. AST walks routinely copy/match blocks;
// embedding Array[U64] here made every such read retain/drop the child buffer even
// though arena children never have an independent lifetime.
export struct Block {
    pub val stmtStart: U64
    pub val stmtLen: U64
}

export struct Param {
    pub val nameStart: U64
    pub val nameLen: U64
    // interned label/name id (Phase C): set by internAllDecls; 0 sentinel.
    pub val nameId: U64 = 0
    pub val tyStart: U64
    pub val tyLen: U64
    // interned type-head id (Phase D): the content-keyed id of (tyStart,tyLen) — the
    // element name for an array type, the head name otherwise — so a param's declared
    // type matches by integer == instead of `spansEqual`. Set at construction.
    pub val tyNameId: U64 = 0
    pub val tyIsArray: Bool
    pub val ty: U64
    pub val isInout: Bool
    // access mode for a `unique`-typed parameter (spec/03): `move T` transfers
    // ownership to the callee (it runs deinit at its scope exit), `borrow T` is a
    // non-consuming read (callee never deinits). Copyable types use neither.
    pub val isMove: Bool
    pub val isBorrow: Bool
    // label-suppressed `name~: Type` (spec/04): the argument is passed without a
    // label (positional). Default false = labelled (the normal case).
    pub val noLabel: Bool
    // default argument `name: T = expr` (spec/04): when the call omits this
    // param, `defaultExpr` is emitted in its place. Omitted defaults need not be
    // trailing; calls evaluate parameters in declaration order. `hasDefault`
    // false = required.
    pub val hasDefault: Bool
    pub val defaultExpr: U64
}

export struct FieldDef {
    pub val nameStart: U64
    pub val nameLen: U64
    // interned name id (Phase C): set by internAllDecls; 0 until then.
    pub val nameId: U64 = 0
    pub val tyStart: U64
    pub val tyLen: U64
    // interned type-head id (Phase D): content-keyed id of (tyStart,tyLen). Set in
    // lowerFieldDef. A field's declared type matches by integer == instead of spansEqual.
    pub val tyNameId: U64 = 0
    pub val tyIsArray: Bool
    pub val ty: U64
    // declared `mut val` (assignable storage) vs `val` (immutable). Always false
    // for enum variant fields (they take no modifier). Used for the composite
    // mutability check on `base.field = x` (spec: both binding and field `mut`).
    pub val isMut: Bool
    // declared default value `val x: T = expr` (spec/05: memberwise-factory
    // default-arg sugar). hasDefault gates it; defaultVal is the Comp.arena.exprs id of
    // the default expression (re-evaluated at each construction site that omits
    // the field). Always false for enum variant fields (they take no default).
    pub val hasDefault: Bool
    pub val defaultVal: U64
    // member visibility (spec/05): 0 = private (anonymous impl only), 1 = pub(get)
    // (read public, write internal), 2 = pub (read+write public). Per-field (unlike
    // methods, which are per-impl-block) because pub(get)'s read/write asymmetry
    // can't fold into a block. Default 0 = private.
    pub val vis: U64 = 0
}

export struct StructDef {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64 = 0
    // generic type parameters `[T, U]` (each a name span; reuses Bind). Empty for
    // a non-generic struct. `[sendable T]` is recorded on Bind.isSendable.
    pub val typeParams: Array[Bind]
    pub val fields: Array[FieldDef]
    // declared `unique struct` (spec/03): copy-incapable, move-only, may carry a
    // `deinit`. A unique value is never CoW-shared; bindings move ownership and
    // the last owner runs `deinit` at scope exit. Default false = copyable.
    pub val isUnique: Bool
    // declared `nonsendable struct`: a thread-affinity marker independent of field
    // composition. The query/diagnostic semantics are staged after the surface is
    // represented.
    pub val isNonsendable: Bool = false
    // declared body-less in an `extern(plewIntrinsic)` block (spec/15 core-
    // library boundary): an opaque lang-item type whose representation is
    // compiler-intrinsic (`I32`→int32_t, `String`→PlewString). Codegen emits no C
    // struct for it; the declaration only establishes that this module (Core)
    // *owns* the type, so it may coherently `impl` traits for it. Default false.
    pub val isExtern: Bool
    // declared in an `extern(c)` block (spec/15 FFI): an opaque foreign-C handle
    // type (`type LLVMModuleRef`). Unlike a plewIntrinsic opaque type, codegen
    // emits a `typedef void* <Name>;` (the real layout lives in the C library; we
    // self-emit the declaration so no foreign header `#include` is needed).
    pub val isCExtern: Bool = false
    // original source offset of the declaration (the decl span's start), kept for
    // `moduleOf` so the construction-visibility gate (spec/05) can attribute the
    // type to its DEFINING module. The struct's nameStart is re-interned (synthetic,
    // module 0), so it cannot serve this purpose. 0 for synthetic/record structs.
    pub val defOffset: U64 = 0
}

export struct Variant {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64 = 0
    pub val fields: Array[FieldDef]
}

// A trait declaration `trait Name { fn req(...) -> T ... }` (spec/08). The body
// holds only *requirements* (no body). For T1 we record each method
// requirement's name (reuses Bind as a (start,len) pair); the parser still
// consumes the full signature but labels/types are recovered later. Field/
// associated-type/factory requirements are not parsed yet (additive).
export struct TraitDef {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64 = 0
    // Every trait owns an implicit lexical `Self` binder.  This is not the
    // spelling "Self" reinterpreted through whichever method happens to be
    // resolving: provided-method templates and their concrete copies share
    // this ParamId, and an InstanceEnvironment maps it to the selected
    // conformer.
    pub val selfParamId: U64 = 0
    // trait type parameters `trait Add[Rhs]` (spec/12): each a name span (reuses
    // Bind). Empty for a non-parameterized trait. A requirement signature may use a
    // type-parameter name (`add(lhs: Self, rhs: Rhs)`); the completeness check
    // substitutes it with the conformance's matching `traitArgs` entry.
    pub val typeParams: TraitBindRange = <TraitBindRange start=0U64 len=0U64 />
    // supertraits from `trait Sub: Super + ...` (spec/08): conforming to Sub
    // requires conforming to each Super (a constraint, not auto-impl). Each entry
    // reuses Bind as a (start,len) trait-name span.
    pub val supertraits: TraitBindRange = <TraitBindRange start=0U64 len=0U64 />
    // requirement signatures (spec/08): each a body-less Func carrying the
    // requirement's name, params (labels + types), return type, and isAssoc.
    // The abstract generic type-checker reads these to resolve `x.req(...)` on a
    // bounded type parameter; the completeness check matches them to witnesses.
    pub val reqs: TraitReqRange = <TraitReqRange start=0U64 len=0U64 />
    // associated type requirements (spec/08): `type Item` declares an output type
    // a conforming impl binds with `type Item = Concrete`. Each entry (Bind) is the
    // associated type's name span; a requirement signature may reference it by name
    // (`next() -> Optional[Item]`). The conformance's binding lives in
    // Comp.assocBindings. Default empty for traits without associated types.
    pub val assocTypes: TraitBindRange = <TraitBindRange start=0U64 len=0U64 />
}

// Trait declarations are read throughout resolution and checking. Keep their
// identity row scalar, just like Conform: each variable-length semantic child
// lives once in a typed declaration pool and is read through its owner API.
export struct TraitBindRange {
    pub val start: U64
    pub val len: U64
}
pub impl TraitBindRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct TraitReqRange {
    pub val start: U64
    pub val len: U64
}

// A callable declaration is inspected by every semantic and backend pass. Its
// variable-sized signature pieces must therefore not live inline in Func: a
// value read of a Func row is routine, while a copied ARC Array is neither a
// declaration fact nor safe to duplicate through the fixed-point compiler.
// These pools are intentionally distinct from trait/conformance payloads: the
// owner of a range documents the lexical declaration whose binders it names.
export struct FuncBindRange {
    pub val start: U64
    pub val len: U64
}
pub impl FuncBindRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct FuncTypeRange {
    pub val start: U64
    pub val len: U64
}
pub impl FuncTypeRange {
    factory
    fn count() -> U64 { return self.len }
}

export struct FuncParamRange {
    pub val start: U64
    pub val len: U64
}
// Owner-indexed default generator declarations. Entries are in parameter
// order; zero means the parameter has no default, otherwise functionId is
// one-based. This is declaration identity, not a call evaluation cache.
export struct DefaultGeneratorRange {
    pub val start: U64 = 0U64
    pub val len: U64 = 0U64
}
pub impl DefaultGeneratorRange { factory }
pub impl FuncParamRange {
    factory
    fn count() -> U64 { return self.len }
}
pub impl TraitReqRange {
    factory
    fn count() -> U64 { return self.len }
}

// Parsed declaration identity, deliberately separate from the completed
// TraitDef table used by semantic checks.
export struct TraitOwner {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64
    pub val arity: U64
}
pub impl TraitOwner { factory }

// A recorded conformance `impl Type as Trait { ... }` (spec/08: conformance is
// explicit, never implicit). `witnessed` lists the requirement names this impl
// satisfied (via a body method or a `via` alias), so the completeness check can
// verify every requirement of `Trait` is met (incomplete conformance = error).
// A `@[Eq]` / `@[Ord]` derive request recorded on a struct/enum declaration.
// Resolved after parsing by synthesizing the witness `impl Type as Eq/Ord`.
export struct DeriveReq {
    pub val typeStart: U64
    pub val typeLen: U64
    pub val isEnum: Bool
    pub val nameStart: U64
    pub val nameLen: U64
    // the annotated item's full source range `[declStart, declEnd)` in c.arena.bytes
    // (the type keyword through its closing `}`). gen mode (spec/16) embeds this
    // slice as the `source` string the macro's `parseItem` reads, and passes
    // declStart as the span base so the macro sees original coordinates.
    pub val declStart: U64 = 0
    pub val declEnd: U64 = 0
    // directive arguments `@[Name(label: expr, ...)]` (spec/16): the macro struct
    // is constructed `<Name label=expr .../>` so its `derive` reads them via
    // `self.label`. Empty for a bare `@[Name]`. Reused as the element type of
    // `pendingDerives` (the scratch list before the target type is known), where
    // only nameStart/nameLen/args are meaningful.
    pub val args: Array[MakeField] = []
}

// An associated-type binding `type Item = Concrete` from a conformance `impl Type
// as Trait { type Item = Concrete }` (spec/08). Records, for the conforming type,
// which concrete type the trait's associated type resolves to — so a requirement
// signature's `Item` substitutes to `Concrete` when checking/resolving on Type.
export struct AssocBinding {
    pub val recvStart: U64
    pub val recvLen: U64
    pub val recvId: U64 = 0
    // associated type name (e.g. `Item`).
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64 = 0
    // the trait whose associated type this binds (e.g. `Sub`), so a type with several
    // operator conformances can bind `Output` differently per trait. 0 if none.
    pub val traitId: U64 = 0
    // Canonical declaration owner of `traitId`.  Text is insufficient: two
    // imported traits may both spell `Convert` and both declare `Output`.
    pub val traitOwner: U64 = 0
    // Source impl identity. Receiver and trait text are not sufficient when a type
    // has multiple parameterized conformances to the same trait.
    pub val implOffset: U64 = 0
    // Full receiver pattern and trait instance key of the owning conformance.
    // Associated-type projection is a conformance lookup, not a head-name lookup.
    pub val subjectTy: U64 = 0
    pub val subjectArgs: ConformTypeRange = <ConformTypeRange start=0U64 len=0U64 />
    pub val typeParams: ConformBindRange = <ConformBindRange start=0U64 len=0U64 />
    pub val traitArgs: ConformTypeRange = <ConformTypeRange start=0U64 len=0U64 />
    // bound concrete type (head span + structured ref + array flag).
    pub val tyStart: U64
    pub val tyLen: U64
    pub val tyIsArray: Bool
    pub val ty: U64
}

export struct Conform {
    pub val typeStart: U64
    pub val typeLen: U64
    pub val typeId: U64 = 0
    // Full structured subject type. The legacy typeId/typeArity pair is kept for
    // older conformance walks, but declaration registration must distinguish
    // `Box[I64]` from `Box[String]` and alpha-equivalent generic subjects.
    pub val subjectTy: U64 = 0
    // Structured arguments of the subject head. Kept separately because a trait
    // subject is not a value TypeRef and must not enter the value-type visibility
    // table merely to form a declaration key.
    pub val subjectArgs: ConformTypeRange = <ConformTypeRange start=0U64 len=0U64 />
    // Binders introduced by `impl[T]`; used to compare subject keys modulo
    // spelling (`impl[T] Box[T]` == `impl[U] Box[U]`).
    pub val typeParams: ConformBindRange = <ConformBindRange start=0U64 len=0U64 />
    // arity of the impl subject. For `impl B as A`, this disambiguates same-name
    // traits such as a user `Sub` and Core's `Sub[Rhs]`; for concrete types it is
    // the receiver type-arg count. The conformance owner checks only use it when
    // the subject is a trait.
    pub val typeArity: U64 = 0
    pub val traitStart: U64
    pub val traitLen: U64
    pub val traitId: U64 = 0
    // trait type arguments `impl V as Add[V]` (spec/12): TypeRef indices (Comp.arena.types)
    // bound to the trait's type parameters, positionally. Empty for a bare
    // conformance. The completeness check substitutes the trait's i-th type
    // parameter with traitArgs[i] when matching a requirement against its witness.
    pub val traitArgs: ConformTypeRange = <ConformTypeRange start=0U64 len=0U64 />
    // synthesized by `@[Eq]`/`@[Ord]` derive: exempt from the unknown-trait and
    // completeness checks (the witness is compiler-generated and complete).
    pub val derived: Bool
    // block visibility of the source `impl Type as Trait` (spec/05,08): a public
    // conformance is part of an exported type's outside surface.
    pub val isPub: Bool = false
    // for a trait-subject inter-trait conformance `impl B as A` written inside a
    // named `extension Ext { … }` (spec/09): the extension's name id, so the
    // conferral stays view-gated (`value#Ext`) and is NOT auto-conferred onto the
    // bare surface. 0 = a bare conform (owner module) which does auto-confer.
    pub val extId: U64 = 0
    // the view-root under which a conferred (derived) inter-trait conformance holds
    // (spec/09 chain conflict): when a type reaches this trait through more than one
    // subject-trait path, each path is recorded as a SEPARATE conform tagged with its
    // root trait (the divergent subject). Such a conform does NOT make the type
    // conform bare (it is reached only via `value#root`); 0 = a bare conformance.
    pub val viewRootId: U64 = 0
    // source offset of the impl declaration. Conform.typeStart is an interned span,
    // so diagnostics and owner-module checks must use this source anchor.
    pub val defOffset: U64 = 0
    // Associated outputs are owned by this witness. A selected ConformId must
    // reach them directly; re-identifying them by receiver/trait spelling or
    // source-offset triples loses proof provenance.
    pub val assocBindingIds: ConformFuncIdRange = <ConformFuncIdRange start=0U64 len=0U64 />
    // signatures of the members this impl witnessed (body method or `via` line),
    // so the completeness check matches requirements by selector (name + param
    // types), distinguishing same-name overloaded requirements.
    pub val witnessed: ConformWitnessRange = <ConformWitnessRange start=0U64 len=0U64 />
    // Exact declarations that supplied the non-`via` witnesses, in member
    // order. `witnessed` intentionally remains a signature-only validation
    // carrier; final call/proof resolution must use these stable Func ids
    // rather than reconstructing a member from spelling and receiver surface.
    pub val witnessFuncIds: ConformFuncIdRange = <ConformFuncIdRange start=0U64 len=0U64 />
}

// A `via` alias `fn req(...) -> T via real` inside a trait impl (spec/08: the
// requirement name becomes a bare callable that dispatches to the real member).
// findMethod, on missing `alias` for `recv`, retries with `real` — so both
// `x.req()` and `x.real()` resolve to the one real method.
export struct MethodAlias {
    pub val recvStart: U64
    pub val recvLen: U64
    pub val recvId: U64 = 0
    pub val aliasStart: U64
    pub val aliasLen: U64
    pub val aliasId: U64 = 0
    pub val realStart: U64
    pub val realLen: U64
    pub val realId: U64 = 0
}

// The semantic input of every trait query. `owner` is the resolved trait
// declaration offset, never an interned spelling; `positionalArgs` are the
// instance inputs. Associated outputs deliberately do not belong here: they
// constrain the witness selected by this key.
export struct TraitInstanceKey {
    pub val owner: U64
    pub val positionalArgs: Array[U64]
}
pub impl TraitInstanceKey { factory }

// One associated-output predicate on a trait constraint. `span` is retained
// solely for diagnostics and must never participate in semantic equality,
// hashing, or a query cache key.
export struct TraitAssocPredicate {
    pub val member: U64
    pub val value: U64
    pub val span: U64 = 0U64
}
pub impl TraitAssocPredicate { factory }

// `where T: P[Item=X]` / `any P[Item=X]`: select one witness by `key`, then
// verify these output predicates against that selected witness.
export struct TraitConstraint {
    pub val key: TraitInstanceKey
    // `where T: Add` intentionally leaves Add's positional inputs open.  This
    // cannot be reconstructed from an empty `positionalArgs` array: that same
    // array is the complete key of an arity-zero trait.  Keep the authored
    // matching mode with the semantic constraint so a consumer never needs to
    // consult FuncBound's former parallel fields.
    pub val positionalArgsOpen: Bool = false
    pub val assocPredicates: Array[TraitAssocPredicate]
}
pub impl TraitConstraint { factory }

// A trait bound `where T: Trait[Args]` on a function (spec/08). `fnIdx` indexes
// c.arena.funcs; (paramStart,paramLen) names the bounded type parameter. `constraint`
// is the complete required trait constraint. `where T: A + B` and
// `where T: A, U: B` expand to one FuncBound per atom. Enforced at instantiation:
// the concrete type bound to the parameter must conform to that exact trait
// instance, else a loud error.
export struct FuncBound {
    pub val fnIdx: U64
    pub val paramStart: U64
    pub val paramLen: U64
    // Structured left-hand type of the bound. For legacy `where T: Trait` this is
    // the same bare type parameter as paramStart/paramLen; for associated-type
    // bounds it can be `T#Iterator.Item`.
    pub val paramTy: U64 = 0
    // Interned identity of the bounded type parameter. The trait identity and
    // all of its inputs/predicates live exclusively in `constraint` below.
    pub val paramNameId: U64 = 0
    // The canonical semantic constraint for this bound. Its owner is resolved
    // at the authored use, positional inputs select a trait instance, and its
    // predicates constrain outputs of that selected witness.
    pub val constraint: TraitConstraint = <TraitConstraint key=<TraitInstanceKey owner=0U64 positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] />
}

// A concrete instantiation of a generic free function (`fn f[T](x: T)` called
// with T = a concrete type). `fnIdx` indexes c.arena.funcs; `args` are the concrete
// type arguments (TypeRef indices) aligned to the function's typeParams.
// Discovered from call sites (only ground/concrete instantiations); each gets a
// specialized C function `f_<arg-mangle...>` emitted under the type-param env.
export struct FnInst {
    pub val fnIdx: U64
    pub val args: Array[U64]
    // for a generic *method* instance on a generic receiver (`filterIter.map(f)`):
    // the receiver's instantiation TypeRef, so emission can mangle `Recv_inst_…`
    // and set the Self/Item env. 0 for a free function or a non-generic receiver.
    pub val recvInstRef: U64 = 0
}

// The substitution produced by matching one concrete conformance. `paramId` is
// the lexical identity of the implementation-side binder; `binder` is retained
// only as a migration-time positional projection for legacy consumers. New
// semantic substitutions must use `paramId`, so independently written `T`s
// cannot be confused merely because they occupy the same slot.
export struct WitnessBind {
    pub val binder: U64
    pub val paramId: U64 = 0U64
    pub val term: U64
}
pub impl WitnessBind { factory }

// A direct selected witness. `conformIdx` is one-based (0 means no match), and
// its bindings map only that witness's impl-binder slots to semantic TypeRefs.
export struct WitnessMatch {
    pub val conformIdx: U64 = 0U64
    pub val binds: Array[WitnessBind] = []
}
pub impl WitnessMatch { factory }

// Static conformance evidence is deliberately richer than a direct impl
// match. A generic declaration may rely on an assumed `where` bound before
// any concrete witness exists; trait-to-trait entailment retains every edge
// instantiation as a predecessor DAG. Runtime existential evidence is not a
// member of this enum (it cannot prove a generic static bound).
export enum StaticConformanceProof {
    Missing
    ConcreteWitness(witness: WitnessMatch)
    AssumedBound(boundIdx: U64)
    // A declaration-time entailment from an authored bound. `edges` are
    // zero-based Conform indices for trait-subject edges, ordered from the
    // bound trait to the selected target trait. They are symbolic patterns;
    // BodyInstance grounds/validates the receiver later.
    AssumedTraitPath(boundIdx: U64, edges: Array[U64])
    // A generic bound also entails every declared supertrait. `traits` is
    // the ordered TraitDef-index path after the authored bound's trait; it
    // makes that derivation explicit instead of mislabeling `T: Sub` as an
    // authored `T: Super` bound.
    AssumedSupertraitPath(boundIdx: U64, traits: Array[U64])
    // Every trait-provided body is abstract over its receiver, but unlike an
    // ordinary generic function it has an implicit `Self: ThisTrait`
    // constraint.  Carry that declaration-time evidence explicitly so Record
    // can select `self.requirement()` without pretending a concrete conformer
    // has already been chosen.
    TraitSelf(traitIdx: U64, receiverRef: U64, traitArgs: Array[U64])
    // Ordered direct witness and trait-subject edges. `terminalConformIdx` is
    // one-based and names the edge that owns the selected trait instance's
    // associated outputs; every edge retains its own impl-binder substitution.
    TraitPath(edges: Array[WitnessMatch], terminalConformIdx: U64)
}

// A selected value conversion is semantic evidence, not an LLVM coercion
// request.  In particular `S -> any P` carries the exact static proof that
// selected P's witness, while container conversions retain their recursive
// children instead of asking a later phase to rediscover which elements erase.
// `Missing` is fail-closed: a type-compatible conversion may not become an
// identity merely because its semantic proof was not recorded.
//
// `EnumPayloadConversion` is declared below because it recursively contains a
// ValueConversionProof; type declarations are collected before their member
// types are checked, just as this enum can contain itself through Array.
export enum ValueConversionProof {
    Identity
    Missing
    ExistentialBox(sourceRef: U64, targetRef: U64, traitIdx: U64, proof: StaticConformanceProof)
    ArrayRepack(sourceRef: U64, targetRef: U64, element: ValueConversionProof)
    // One entry per physical payload field, in declaration variant order. This
    // is the complete conversion plan; LLVM must not reconstruct a field type
    // from enum generic arguments to discover a proof.
    EnumRepack(sourceRef: U64, targetRef: U64, enumIdx: U64, payloads: Array[EnumPayloadConversion])
}

export struct EnumPayloadConversion {
    pub val sourceRef: U64
    pub val targetRef: U64
    pub val conversion: ValueConversionProof
}
pub impl EnumPayloadConversion { factory }

// Frozen proof rows are the ownership-safe form of StaticConformanceProof and
// ValueConversionProof.  The source-facing sums above remain a transitional
// construction vocabulary; semantic tables and Mid IR carry only these IDs.
// `tag` values are private to the frontend proof publisher, not a language ABI.
export struct StaticProofNode {
    pub val tag: U64
    pub val conformIdx: U64 = 0U64
    pub val witnessBinds: U64 = 0U64
    pub val witnessBindCount: U64 = 0U64
    pub val boundIdx: U64 = 0U64
    pub val path: U64 = 0U64
    pub val pathCount: U64 = 0U64
    pub val traitIdx: U64 = 0U64
    pub val receiverRef: U64 = 0U64
    pub val terminalConformIdx: U64 = 0U64
}
pub impl StaticProofNode { factory }

export struct FrozenWitnessMatch {
    pub val conformIdx: U64
    pub val binds: U64 = 0U64
    pub val bindCount: U64 = 0U64
}
pub impl FrozenWitnessMatch { factory }

export struct ConversionProofNode {
    pub val tag: U64
    pub val sourceRef: U64 = 0U64
    pub val targetRef: U64 = 0U64
    pub val traitIdx: U64 = 0U64
    pub val staticProof: U64 = 0U64
    pub val element: U64 = 0U64
    pub val enumIdx: U64 = 0U64
    pub val payloads: U64 = 0U64
    pub val payloadCount: U64 = 0U64
}
pub impl ConversionProofNode { factory }

export struct FrozenEnumPayloadConversion {
    pub val sourceRef: U64
    pub val targetRef: U64
    pub val conversion: U64
}
pub impl FrozenEnumPayloadConversion { factory }

// One worklist state while resolving a concrete trait instance.  The current
// trait key is ground; `edges` is the predecessor proof needed both for a
// final callable and for associated-output grounding.  Keeping this state in
// IR avoids parallel owner/args/path arrays and is the migration carrier for
// the eventual canonical ConformanceProof DAG.
export struct TraitProofState {
    pub val traitOwner: U64
    pub val traitId: U64
    pub val traitArgs: Array[U64]
    pub val edges: Array[WitnessMatch]
}
pub impl TraitProofState { factory }

// The complete semantic substitution context of one concrete callable body.
// `params[i] -> args[i]` is an immutable ParamId-keyed substitution map.
// Binder identity is lexical (`Bind.paramId`), so the declaration binder of
// `struct Array[T]`, an impl/method binder also spelled `T`, and a witness
// binder can coexist without textual shadowing. `receiverRef` is the selected
// concrete receiver and is part of the same semantic key, never ambient cursor
// state. TypeRef indices are the current TypeTerm migration carrier.
export struct InstanceEnvironment {
    pub val params: Array[Bind] = []
    pub val args: Array[U64] = []
    pub val receiverRef: U64 = 0U64
    // Selected evidence for a provided body. Associated outputs must be
    // projected from this proof, never rediscovered by receiver spelling.
    pub val proof: StaticConformanceProof = <StaticConformanceProof.Missing />
}

// A runtime ABI operation selected from a finalized plewIntrinsic declaration.
// It is deliberately separate from a source spelling: after frontend selection
// neither Mid nor LLVM needs to inspect a function name to decide the ABI.
// A bit width is shared by integer and floating-point runtime operations.  It
// is intentionally not named IntegerWidth: a descriptor must not encode a
// float operation with an integer-only type just because both happen to have
// a width field.
export enum NumericWidth {
    W8
    W16
    W32
    W64
}

export enum IntegerOperation {
    Add
    Sub
    Mul
    Div
    Rem
    Neg
    BitNot
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
}

export enum FloatOperation {
    Add
    Sub
    Mul
    Div
    Neg
    Eq
    Lt
}

// Float widths are deliberately a distinct closed domain: the current LLVM
// floor supports F32/F64 only, and no descriptor may accidentally request an
// integer-only width for a floating operation.
export enum FloatWidth {
    W32
    W64
}

export enum BoolOperation {
    Not
    Eq
}

export enum NumericOverflow {
    Checked
    Wrapping
}

export enum NumericIntrinsic {
    Integer(width: NumericWidth, unsigned: Bool, operation: IntegerOperation, overflow: NumericOverflow)
    Float(width: FloatWidth, operation: FloatOperation)
    Bool(operation: BoolOperation)
}

// The finite safe Buffer floor.  The element type and inout/value argument
// convention are frozen by the selected CallResolution; this enum carries the
// operation identity only, so it cannot duplicate generic substitution state.
export enum BufferIntrinsic {
    New
    Count
    Capacity
    Reserve
    Append
    InsertAt
    Get
    Set
    RemoveLast
    RemoveAt
    SwapRemove
    Clear
    Truncate
    Eq
    BytewiseComparable
}

export enum RuntimeIntrinsic {
    Write
    Eprint
    ArgCount
    Numeric(intrinsic: NumericIntrinsic)
    Buffer(intrinsic: BufferIntrinsic)
}

// Declaration-time classification of a bundled runtime ABI operation. None is
// intentionally separate from RuntimeIntrinsic: it says a selected Func is an
// ordinary declaration, not a third runtime operation. Final call resolution
// consumes this closed declaration fact and never recovers an ABI target from
// a source spelling.
export enum RuntimeIntrinsicDeclaration {
    None
    Bound(intrinsic: RuntimeIntrinsic)
}

// The destination of a resolved call.  This is a sum type rather than a
// `kind` plus optional parallel fields: an existential requirement cannot
// accidentally carry a closure binding, and a closure field cannot omit its
// callable type.  `NoCallable` is the selected outcome for primitive syntax
// whose lowering has no function declaration (for example a floor operator),
// not a missing resolution.
export enum CallTarget {
    Direct
    RuntimeIntrinsic(intrinsic: RuntimeIntrinsic)
    NoCallable
    ExistentialRequirement(traitIdx: U64, slot: U64)
    ClosureLocal(bindingDeclStart: U64, fnTypeRef: U64)
    ClosureField(fieldIndex: U64, fnTypeRef: U64)
}

// A selected callable may return a carrier value while the source expression
// denotes a closed projection of it.  This is semantic information, not a
// backend operator special case: `<` selects Ord.compare but denotes a Bool
// formed by inspecting its Ordering tag; `!=` selects Eq.eq but denotes the
// logical complement of its Bool carrier.
export enum CallResultProjection {
    Identity
    OrderingTest(op: I64)
    // Append-only: this IR enum crosses bootstrap compiler generations, so
    // existing variant tags remain stable while an older compiler emits the
    // first binary that understands this closed Eq complement.
    BoolNot
}

// Passing is part of a final call ABI, not an ownership guess made by a
// downstream emitter. `Copy` remains a Mid operation that creates an owned
// value; an ordinary ABI parameter/receiver is a guaranteed (+0) Borrow.
export enum CallReceiverPassing {
    None
    Borrow
    Inout
    Move
}

export enum CallArgumentPassing {
    Borrow
    Inout
    Move
}

// `CallResolution` is read by the frontend fixpoint, Mid instantiation, and
// LLVM lowering.  Its key row must consequently be freely copyable: an inline
// Array would make an ordinary table read an ownership operation.  Keep each
// independently meaningful payload in its own Arena pool.  The separate
// range types prevent a parameter-type slice from being passed where selected
// substitution arguments are required merely because both currently contain
// TypeRef ids.
export struct CallResolutionTypeArgRange {
    pub val start: U64
    pub val len: U64
}
pub impl CallResolutionTypeArgRange { factory fn count() -> U64 { return self.len } }

export struct CallResolutionParameterTypeRange {
    pub val start: U64
    pub val len: U64
}
pub impl CallResolutionParameterTypeRange { factory fn count() -> U64 { return self.len } }

export struct CallResolutionConversionRange {
    pub val start: U64
    pub val len: U64
}
pub impl CallResolutionConversionRange { factory fn count() -> U64 { return self.len } }

export struct CallResolutionArgumentPassingRange {
    pub val start: U64
    pub val len: U64
}
pub impl CallResolutionArgumentPassingRange { factory fn count() -> U64 { return self.len } }

// The selected callable for one semantic call site while compiling one concrete
// function body instance.  A site can be a written expression or an implicit
// call introduced by a control construct (for example `for`'s iterator/next
// protocol); `siteIsStmt` and `slot` distinguish those without inventing a
// second resolution table.  An AST node may be shared by many generic
// instances, so the enclosing function, its substitution arguments, and its
// receiver instance are also part of the decision context.  Mono owns these
// records; backend only consumes them.
export struct CallResolution {
    // 1-based index into Arena.bodyInstances.  A final call belongs to one
    // canonical semantic body instance; duplicating its function/environment
    // here made every lookup re-compare the whole substitution map.
    pub val bodyId: U64
    // 1-based identity of the selected callee body. This differs from the
    // caller body above: provided copies can share an ABI key yet have distinct
    // placement/source proofs. LLVM must consume this identity rather than
    // reconstructing a body environment from ABI arguments.
    pub val calleeBodyId: U64 = 0U64
    // Semantic identity of the call occurrence. `exprId` below is retained
    // solely as the backend navigation anchor; it is not a semantic key.
    pub val siteKey: CallSiteKey = <CallSiteKey />
    pub val exprId: U64
    pub val siteIsStmt: Bool = false
    pub val slot: U64 = 0U64
    pub val callee: U64
    // Fully-grounded type arguments for this invocation, in the selected
    // Func's parameter order (receiver arguments first for a method).  Keeping
    // them with the target prevents LLVM from running a second generic
    // inference pass over the AST.
    pub val calleeTypeArgs: CallResolutionTypeArgRange = <CallResolutionTypeArgRange start=0U64 len=0U64 />
    // Fully-grounded ABI parameter types in the selected Func's declaration
    // order.  Argument lowering consumes these directly; it must not reopen
    // the callee's symbolic `Param.ty` under the caller's ambient environment.
    pub val parameterTypeRefs: CallResolutionParameterTypeRange = <CallResolutionParameterTypeRange start=0U64 len=0U64 />
    // One proof per ABI parameter, in declaration order.  It is selected
    // together with the ground ABI type; Mid/LLVM must never infer a box or
    // container repack from an argument expression after this boundary.
    pub val argumentConversions: CallResolutionConversionRange = <CallResolutionConversionRange start=0U64 len=0U64 />
    // The selected ownership ABI is frozen beside parameter types and value
    // conversions. Mid and legacy lowering consume this record; neither may
    // infer passing from source shape or re-read Func flags.
    pub val receiverPassing: CallReceiverPassing = <CallReceiverPassing.None />
    pub val argumentPassings: CallResolutionArgumentPassingRange = <CallResolutionArgumentPassingRange start=0U64 len=0U64 />
    // Concrete receiver identity at source selection.  0 for an ordinary
    // free call; association/operator calls retain their subject type here.
    // Backend consumes this rather than reconstructing it from the shared AST.
    pub val recvTypeRef: U64 = 0U64
    // The fully-grounded value type observed at the source call site.  This is
    // deliberately not necessarily the ABI return type of `callee`: an
    // operator witness may return its carrier (`Ordering`) while the source
    // expression observes a Bool after `resultProjection`.  Consumers use this
    // semantic result for subsequent type/proof facts; LLVM obtains the raw
    // ABI return from the selected callee and applies the projection.
    pub val resultTypeRef: U64 = 0U64
    // The value type observed at the source call site.  `Identity` means it is
    // the callee return directly; non-identity variants must be materialized
    // before the destination is initialized.
    pub val resultProjection: CallResultProjection = <CallResultProjection.Identity />
    // LLVM consumes this selected target directly and never re-selects it
    // from source spellings.
    pub val target: CallTarget = <CallTarget.Direct />
}

// The concrete value-conversion facts for one Record-selected aggregate in one
// canonical BodyInstance. `SemanticAggregate` remains the parametric source
// layout; this table is its finalization counterpart, just as CallResolution
// is the concrete counterpart of CallTemplate. Mid consumes this record and
// must never select a conformance proof for an aggregate element itself.
export struct FinalAggregateResolution {
    pub val bodyId: U64
    pub val exprId: U64
    pub val resultTypeRef: U64
    pub val elementTargetRefs: Array[U64]
    pub val elementConversions: Array[ValueConversionProof]
}
pub impl FinalAggregateResolution { factory }

// Concrete counterpart of SemanticMatch for one canonical BodyInstance.
// Payload types are already grounded here; Mid instantiation and LLVM consume
// only declaration slots and these final TypeRefs.
export struct FinalMatchPayloadResolution {
    pub val bindTarget: U64 = 0U64
    pub val fieldIndex: U64 = 0U64
    pub val fieldTypeRef: U64 = 0U64
}
pub impl FinalMatchPayloadResolution { factory }

export struct FinalMatchArmResolution {
    pub val hasVariant: Bool = false
    pub val variantIndex: U64 = 0U64
    pub val payloads: Array[FinalMatchPayloadResolution] = []
}
pub impl FinalMatchArmResolution { factory }

export struct FinalMatchResolution {
    pub val bodyId: U64 = 0U64
    pub val stmtId: U64 = 0U64
    pub val scrutineeTypeRef: U64 = 0U64
    pub val enumIndex: U64 = 0U64
    pub val arms: Array[FinalMatchArmResolution] = []
}
pub impl FinalMatchResolution { factory }

// One concrete value-conversion decision for a `return expression` in a
// canonical BodyInstance.  A return has one ABI target but may be reached by
// many source branches, so its key is the returned expression rather than a
// backend return-place local.
export struct FinalReturnResolution {
    pub val bodyId: U64
    pub val exprId: U64
    pub val targetTypeRef: U64
    pub val conversion: ValueConversionProof
}
pub impl FinalReturnResolution { factory }

// Frontend-owned input to final call construction.  It intentionally carries
// semantic facts selected at the source/implicit/control-flow boundary rather
// than asking the finalizer to reopen a shared AST node. `resultHintRef` is the
// expected-result provenance for argument-less associated factories; `resultRef`
// is an already-selected result for a call with no user callable. Dynamic target
// identity belongs here too: the final builder may copy it but never recover it.
export struct CallSiteSelection {
    pub val siteKey: CallSiteKey = <CallSiteKey />
    pub val exprId: U64
    pub val siteIsStmt: Bool = false
    pub val slot: U64 = 0U64
    pub val callee: U64
    pub val receiverRef: U64 = 0U64
    // The resolver owns the source-child boundary. Static finalization reads
    // this immutable arena slice instead of pattern-matching the shared AST
    // again to rediscover arguments.
    pub val args: ArgRange = <ArgRange start=0U64 len=0U64 />
    // The same argument shape with semantic type sources. `args` is retained
    // only as backend navigation anchors and default-argument mapping; generic
    // inference must consume this field rather than re-type the Expr ids.
    pub val argumentSources: Array[CallTemplateArgument] = []
    // Parametric call-template substitutions, grounded by the source
    // resolver under the caller BodyInstance before final construction.
    pub val calleeTypeArgs: Array[U64] = []
    // Static trait dispatch selects evidence together with its callable.  A
    // provided body may invoke another requirement through that same path, so
    // the selected concrete proof must cross the BodyInstance boundary rather
    // than being rediscovered from a normalized ABI receiver.
    pub val proof: StaticConformanceProof = <StaticConformanceProof.Missing />
    pub val resultHintRef: U64 = 0U64
    pub val resultRef: U64 = 0U64
    pub val resultProjection: CallResultProjection = <CallResultProjection.Identity />
    pub val target: CallTarget = <CallTarget.Direct />
}
pub impl CallSiteSelection { factory }

// A concrete body that code generation may emit.  This is the reachability
// worklist paired with CallResolution: resolving a call enqueues its callee body,
// and the frontend drains the list before LLVM begins.  `recvInstRef` is kept
// even for an argless receiver so a shared provided body can substitute Self
// to the actual conformer.
export struct BodyInstance {
    pub val fnIdx: U64
    pub val environment: InstanceEnvironment
}

export struct EnumDef {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64 = 0
    // generic type parameters `[T, U]` (see StructDef.typeParams).
    pub val typeParams: Array[Bind]
    pub val variants: Array[Variant]
    // `unique enum` (spec/03): copy-forbidden, move-only — same single-ownership
    // regime as a unique struct (a unique payload may live in it legally).
    pub val isUnique: Bool = false
    // declared `nonsendable enum` (see StructDef.isNonsendable).
    pub val isNonsendable: Bool = false
    // original source offset of the declaration (see StructDef.defOffset): kept for
    // `moduleOf` (the lang-item redefinition check), since nameStart is re-interned.
    pub val defOffset: U64 = 0
}

export struct Func {
    pub val nameStart: U64
    pub val nameLen: U64
    // interned ids (Phase C): name and (for methods/assoc) receiver type name.
    pub val nameId: U64 = 0
    pub val recvId: U64 = 0
    // Full receiver type for a method/associated function. recvId is only the
    // head-name fast path; this preserves the generic arguments and # view that
    // are part of the declaration namespace.
    pub val recvTy: U64 = 0
    // Binder scope used only to match `recvTy`. A provided copy's receiver
    // pattern belongs to its source conformance, while its callable body keeps
    // its own nominal/method binder environment in `typeParams`.
    pub val recvPatternParams: FuncBindRange = <FuncBindRange start=0U64 len=0U64 />
    // Positional arguments of a trait receiver. `recvTy` is deliberately 0 for
    // trait subjects (they are not value types), so this is the complete trait
    // instance key for `impl P[Arg] { ... }`. Associated-type bindings are
    // outputs constrained after selecting that key and do not belong here.
    pub val recvTraitArgs: FuncTypeRange = <FuncTypeRange start=0U64 len=0U64 />
    // generic type parameters `fn id[T](...)` (name spans; empty if not
    // generic). For a method, an `impl[T] Type[T]`-introduced parameter also
    // lands here. Consumed by G3 monomorphization.
    pub val typeParams: FuncBindRange = <FuncBindRange start=0U64 len=0U64 />
    pub val params: FuncParamRange = <FuncParamRange start=0U64 len=0U64 />
    pub val hasRet: Bool
    pub val retStart: U64
    pub val retLen: U64
    pub val retIsArray: Bool
    pub val retTy: U64
    pub val body: U64
    // method receiver: an `impl Type { ... }` member carries the receiver type
    // (recvStart,recvLen) and whether self is `inout` (`inout fn` vs `fn`). The
    // C function is mangled `Type_name` with an extra leading `self` parameter.
    pub val hasRecv: Bool
    pub val recvStart: U64
    pub val recvLen: U64
    pub val selfInout: Bool
    // `move fn` (spec/03): the method consumes self (a unique value), so self is
    // owned here — deinit runs at the method's scope exit — and the call site marks
    // the receiver moved. `fn`/`borrow fn` read self by value (not consumed);
    // `inout fn` borrows it mutably. (`borrow fn` is accepted as a synonym of `fn`.)
    pub val selfMove: Bool
    // `assoc fn` (spec/07,12): an associated (static) function — it lives in a
    // type's namespace but takes no `self`. hasRecv is false (no self parameter),
    // yet recvStart/recvLen still name the owning type, so the C name mangles
    // `Type_name` and a call `Type.name(args)` resolves. Operator requirements
    // (`Eq.eq`, `Ord.compare`, `Add.add`) are assoc fns.
    pub val isAssoc: Bool
    // `async fn` (spec/14): the function suspends at `await` points and returns a
    // `Promise[T]`. Lowered to a stackless state machine (frame + resume + entry)
    // rather than a plain C function. Default false = an ordinary synchronous fn.
    pub val isAsync: Bool
    // `extern(plewIntrinsic)` declaration (spec/15 core-library boundary): a
    // body-less signature bound to the runtime symbol `plew_<name>`. The compiler
    // emits no prototype/body; a call lowers to `plew_<name>(args)`. Default false.
    pub val isExtern: Bool
    // refinement of isExtern for an `extern(c)` block (spec/15 FFI): the callee is
    // a foreign C symbol. Unlike a plewIntrinsic extern, the compiler emits a C
    // prototype (still no body — the library provides it) and a call lowers to the
    // RAW name `<name>(args)` (no `plew_` prefix, no overload mangling). Default false.
    pub val isCExtern: Bool = false
    // Set exactly once while lowering a recognized bundled runtime declaration.
    // This is declaration identity metadata, not a backend lookup hint.
    pub val runtimeIntrinsic: RuntimeIntrinsicDeclaration = <RuntimeIntrinsicDeclaration.None />
    // member visibility (spec/05): true when this method/assoc-fn lives in a
    // `pub impl Type { … }` block (publicly callable wherever the type is visible).
    // Default false = the method is private — visible only inside the type's
    // anonymous impl. Visibility is per-impl-block (no per-method `pub fn`).
    pub val isPub: Bool = false
    // a provided trait method copied onto a conformer by instantiateProvidedMethods
    // (its body/signature may mention `Self`/`Item`; its generic instances come from
    // call sites). Default false = an ordinary inherent/conformance/free method.
    pub val isProvided: Bool = false
    // One-based identity of the declaration that originally supplied this
    // trait witness. Direct methods point to themselves; every conferred copy
    // preserves that identity so proof-driven dispatch never reconstructs a
    // member from names, spans, or receiver surfaces.
    pub val sourceWitnessFuncId: U64 = 0U64
    // the enclosing extension's interned name id (spec/09), 0 for a bare method.
    // An extension method is tagged with its extension so it is excluded from bare
    // resolution and reachable only through a `value#Ext.m()` view (findExtMethod).
    pub val extId: U64 = 0
    // for a provided-method copy (instantiateProvidedMethods): the interned id of
    // the trait it came from, so `a#P.foo()` can select the source trait when two
    // conformed traits provide the same-name method (spec/08,09). 0 otherwise.
    pub val srcTraitId: U64 = 0
    // Resolved declaration owner of srcTraitId.  Name + arity is not a trait
    // identity: imported modules may each declare `trait P` with the same arity.
    pub val srcTraitOwner: U64 = 0
    // The trait conformance a concrete witness was declared for.  Unlike
    // srcTraitId this does not choose a `#Trait` source surface: an inherent
    // witness remains bare-callable.  It preserves the generic trait-argument
    // substitution that produced this implementation for final-callable
    // monomorphization.
    pub val originTraitId: U64 = 0
    pub val originTraitOwner: U64 = 0
    pub val originTraitArity: U64 = 0
    // The conformance that placed this copy on its concrete receiver, one-based
    // so 0 remains absent.  It selects the body's receiver environment and
    // must not be replaced by a source witness edge.
    pub val originConformIdx: U64 = 0
    // When the source witness was authored by a trait-subject conformance,
    // that distinct conformance owns the source method's impl binders.  It is
    // used only to substitute those binders at the final call; 0 means the
    // provided template has no such source-edge substitution.
    pub val sourceConformIdx: U64 = 0
    // for a non-public provided-method copy (`impl Trait { ... }`, not
    // `pub impl Trait`): the trait owner's module id. Such helper copies are
    // callable only from that module. The sentinel means "no module-only gate"
    // (ordinary methods and public provided methods).
    pub val providedOwnerMod: U64 = 4000000000U64
    // for a provided-method TEMPLATE (a bare `impl Trait { }` member): the type-arg
    // arity of the trait subject (`impl Sub` = 0, `impl Mul[Rhs]` = 1). Trait names
    // share one flat namespace (spec/08: a user `trait Sub` may co-exist with Core's
    // operator `Sub[Rhs]`), so instantiateProvidedMethods matches a conformance to
    // the right same-name trait by arity — without this, a provided method on the
    // 0-ary `Sub` would be copied onto every integer (conforming to Core `Sub[Rhs]`).
    pub val provTraitArity: U64 = 0
    // Declaring trait owner for a provided-method template (`impl Trait {}`).
    pub val provTraitOwner: U64 = 0
    // a multi-path inter-trait conformance witness (`impl P as R` / `impl Q as R`
    // both reaching R, copied onto a type conforming to P and Q): the type does NOT
    // conform to R bare (spec/09), so this copy is excluded from bare resolution (like
    // an extension method) and reachable only through the conformance-path view
    // `value#P` (findExtMethodById, via srcTraitId). Default false = bare-callable.
    pub val viewOnly: Bool = false
    // original source offset of the declaration's NAME token (see StructDef.defOffset):
    // an impl method's nameStart is re-interned (maps to no source file), so a
    // declaration-anchored diagnostic reads fnAnchor (defOffset, nameStart fallback).
    // 0 for synthesized funcs (deinit walkers, witness sigs, the record `main`).
    pub val defOffset: U64 = 0
}

// A callable surface entry. Func is an implementation/body record; this table is
// the semantic call namespace consumed by every resolver query. sourceKind is
// 0=bare/inherent, 1=named extension, 2=trait-provided/path surface.
export struct ViewSource {
    pub val kind: U64 = 0
    pub val id: U64 = 0
    pub val owner: U64 = 0
    pub val arity: U64 = 0
}
pub impl ViewSource { factory }

export struct Callable {
    pub val funcIdx: U64
    pub val sourceKind: U64
    // Source spelling is retained only to resolve a written `#X`. It is not the
    // identity used once a candidate has been selected.
    pub val sourceId: U64
    // Resolved source identity. Extension bundles are globally named, so their
    // bundle id is their identity; trait sources use the defining trait's real
    // declaration offset. 0 denotes the bare surface.
    pub val sourceOwner: U64 = 0
    // Distinguishes same-spelled traits such as `Sub` and `Sub[Rhs]` before
    // declaration identity is recovered at a call site.
    pub val sourceArity: U64 = 0
    // Trait provenance is independent from the source that made a callable
    // visible.  In particular, `extension E { impl A { ... } }` has source E
    // and trait provenance A, so `value#E#A.method()` can select it without
    // making the order of `#E` / `#A` meaningful.
    pub val traitId: U64 = 0
    pub val traitOwner: U64 = 0
    pub val traitArity: U64 = 0
    // A name is not an extension identity across modules. Keep the defining
    // module so a source-qualified query can reject an ambiguous same-spelled
    // source rather than choosing whichever Func happened to be appended first.
    pub val sourceModule: U64
}
pub impl Callable { factory }

// A binding made while asking whether two declared generic signatures have a
// common finite instantiation. `side` / `refSide` are 0 or 1 and keep binders
// from the two declarations distinct even when they share a spelling such as T.
export struct UnifyBind {
    pub val side: U64
    pub val nameId: U64
    pub val ref: U64
    pub val refSide: U64
}
pub impl UnifyBind { factory }

// A declaration-time trait member selected from static evidence.  It is kept
// separate from the eventual CallResolution because generic template checking
// needs a symbolic requirement before a concrete dispatch target exists.
export enum StaticMemberResolution {
    Missing
    Requirement(proof: StaticConformanceProof, traitIdx: U64, reqIdx: U64)
    // A trait default body is a declaration-selected static member just like
    // a requirement, but it has no requirement slot. `callee` names the
    // lexical trait declaration; finalization selects its concrete copy under
    // the carried proof.
    Provided(proof: StaticConformanceProof, traitIdx: U64, callee: U64)
}

// A path-local substitution used by the trait-subject cycle validator.  Unlike
// `UnifyBind`, binders here can come from any number of conformance edges, so a
// declaration-local `scope` (the Conform table index) is part of their identity.
// This stays in IR rather than overloading `UnifyBind`'s two-side protocol: the
// validator composes substitutions along an arbitrary graph path.
export struct TraitCycleTerm {
    pub val ref: U64
    pub val scope: U64
}
pub impl TraitCycleTerm { factory }

export struct TraitCycleNode {
    pub val owner: U64
    pub val args: Array[U64]
    pub val scope: U64
}
pub impl TraitCycleNode { factory }

export struct TraitCycleBind {
    pub val scope: U64
    pub val nameId: U64
    pub val ref: U64
    pub val refScope: U64
}
pub impl TraitCycleBind { factory }

// One pending symbolic rewrite state in declaration-time trait-cycle
// validation.  `binds` is its path-local substitution; predecessor/path data
// is deliberately not retained here, because cycle detection is reachability
// back to the seeded instance and canonical-state saturation owns termination.
export struct TraitCycleSearch {
    pub val node: TraitCycleNode
    pub val binds: Array[TraitCycleBind]
}
pub impl TraitCycleSearch { factory }

// A module-level variable (spec/15): `val x = e` / `mut val x = e`. `letStmt` is
// the arena `Stmt.Let` the shared parser produced (name / optional type /
// initializer); the backend emits an LLVM global, runs every global's init once in
// `plew_init_globals` before `main`, and seeds each global as a local at every
// function-body entry so reads/writes resolve through the normal local machinery.
export struct Global {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val letStmt: U64
    pub val mutable: Bool
}

// A `newtype Name = Underlying` (spec/10): a distinct type sharing the underlying's
// representation. `nameId` is the interned newtype name; (underStart, underLen) /
// underRef name the underlying type (its head span and full TypeRef).
export struct NewtypeDef {
    pub val nameStart: U64
    pub val nameLen: U64
    pub val nameId: U64
    pub val underStart: U64
    pub val underLen: U64
    pub val underRef: U64
    // original source offset of the declaration (see StructDef.defOffset): kept for
    // `moduleOf` (scoped type-visibility), since nameStart is re-interned. 0 if unknown.
    pub val defOffset: U64 = 0
}

// Name interner (content-keyed, Phase C): maps each name span (start,len into
// `Comp.arena.bytes`) to a stable 1-based id, so name equality becomes an integer
// compare instead of a byte-by-byte `spansEqual`. Declaration names are
// pre-interned once into a `nameId` field on their table entry; a name-vs-decl
// scan interns the query once and compares ids in the loop. `starts`/`lens` hold
// the unique spans indexed by id-1; `buckets` is an open-addressing slot→id map
// (0 = empty); `count` is the number of interned names. Re-interned names unify
// by CONTENT (equal bytes ⇒ equal id), which is the whole point.
// The shared IR arena: the program's source bytes plus every node table, the one
// data store all passes read. `bytes` is the combined source buffer (`mut` so the
// derive synthesizer can append synthetic identifier names and reference them by
// span — appends land past existing token offsets). `exprs`/`stmts`/`blocks`/
// `funcs`/`structs`/`enums` are the AST node arenas (cross-referenced by U64
// index). `types` is the structured TypeRef arena (indexed by nodes' `ty`/`ref`
// fields). `globals` are module-level vars in lowering (= init) order. `newtypes`
// are `newtype Name = Underlying` declarations (spec/10).
export struct Arena {
    pub mut val bytes: Array[U8] = []
    pub mut val exprs: Array[Expr] = []
    // Flat immutable payload pool for Call / Method / ExtMethod arguments.
    // ArgRange is the only AST-side handle; consumers read through Comp.argAt.
    pub mut val argPool: Array[Arg] = []
    // Flat immutable expression-child pool for Array literals. ExprRange is the
    // only AST-side handle; consumers read through Comp.exprAt.
    pub mut val exprChildPool: Array[U64] = []
    // Flat immutable construction-field pool. MakeFieldRange is the only
    // AST-side handle; consumers read through Comp.makeFieldAt.
    pub mut val makeFieldPool: Array[MakeField] = []
    // Pattern payload pools. Their scalar ranges are held by MatchArm/For/
    // DestructureSite and match expressions/statements; no AST node owns an
    // Array of these arena-lifetime children.
    pub mut val bindPool: Array[Bind] = []
    pub mut val matchArmPool: Array[MatchArm] = []
    // Complete semantic type entry per expression node. Kept with the expression
    // arena rather than Comp so every public user of Comp depends only on Arena,
    // and so the entry has the same lifetime/identity as its Expr.
    pub mut val semanticExprTypes: Array[SemanticExprType] = []
    // Deferred semantic type-source recipes are a separate dependency graph;
    // TypeRef remains the canonical structural type arena. IDs are one-based.
    pub mut val semanticTypeRecipes: Array[SemanticTypeRecipe] = []
    // Immutable semantic evidence DAG. Rows contain only scalar identities
    // and typed ranges; final calls and Mid bodies must not embed recursive
    // proof values with owning Array payloads.
    pub mut val staticProofs: Array[StaticProofNode] = []
    pub mut val staticProofWitnessBindPool: Array[WitnessBind] = []
    pub mut val staticProofU64Pool: Array[U64] = []
    pub mut val staticProofWitnessPool: Array[FrozenWitnessMatch] = []
    pub mut val conversionProofs: Array[ConversionProofNode] = []
    pub mut val conversionPayloadPool: Array[FrozenEnumPayloadConversion] = []
    // Source byte offset of each expr (parallel to `exprs`; 0 = unknown). Lower
    // records the parsed ExprAst's span start (the AST carries a span on every
    // node); backend-synthesized exprs keep 0. THE diagnostic-position store:
    // exprOffset reads this before any per-form fallback.
    pub mut val exprSpanStart: Array[U64] = []
    // Exclusive end paired with exprSpanStart.  A source call origin is the
    // full span, rather than only its start: nested calls such as `a.b().c()`
    // share a start but are distinct semantic sites.
    pub mut val exprSpanEnd: Array[U64] = []
    // Monotonic origin token assigned when an expression node is created.
    // This is intentionally separate from the arena navigation index: source
    // span identifies the written occurrence, and the token distinguishes
    // multiple lowered operations legitimately derived from that one span.
    pub mut val exprOriginSerial: Array[U64] = []
    pub mut val stmts: Array[Stmt] = []
    pub mut val blocks: Array[Block] = []
    // One immutable child pool for Block statement slices. Only pushBlock appends;
    // readers use blockStmtAt/count and never materialize an Array adapter.
    pub mut val blockStmtPool: Array[U64] = []
    pub mut val funcs: Array[Func] = []
    pub mut val structs: Array[StructDef] = []
    pub mut val enums: Array[EnumDef] = []
    // Canonical scalar semantic type rows. `types` is the legacy mirror while
    // consumers migrate; both tables have the same index during that period.
    // New hot-path readers must use typeTerms and these owner-specific pools.
    pub mut val typeTerms: Array[TypeTerm] = []
    pub mut val typeArgumentPool: Array[U64] = []
    pub mut val typeRecordLabelPool: Array[U64] = []
    pub mut val typeRecordFieldPool: Array[U64] = []
    pub mut val typeViewIdPool: Array[U64] = []
    pub mut val typeViewSourcePool: Array[ResolvedViewSource] = []
    pub mut val typeArgumentLabelPool: Array[U64] = []
    pub mut val typeAssocArgumentPool: Array[U64] = []
    pub mut val typeAssocArgumentLabelPool: Array[U64] = []
    pub mut val types: Array[TypeRef] = []
    pub mut val globals: Array[Global] = []
    pub mut val newtypes: Array[NewtypeDef] = []
    // Final static call selections belong to the analyzed program, not to
    // MonoWork's transient discovery queues.  LLVM consumes this immutable
    // semantic result after frontend finalization.
    pub mut val finalCallees: Array[CallResolution] = []
    // Payload pools for the scalar CallResolution table.  They are semantic
    // output, not backend caches: a descriptor range is immutable after its
    // single publication and backend consumers may only read it through the
    // owner-aware APIs on Comp.
    pub mut val finalCalleeTypeArgPool: Array[U64] = []
    pub mut val finalCalleeParameterTypePool: Array[U64] = []
    // One-based ConversionProofNode IDs.  Keeping recursive proof values in a
    // final-call row/pool made an ordinary descriptor read an ARC operation.
    pub mut val finalCalleeConversionPool: Array[U64] = []
    pub mut val finalCalleeArgumentPassingPool: Array[CallArgumentPassing] = []
    // Concrete aggregate conversions, keyed by (BodyInstance, source ExprId).
    // This is semantic output alongside finalCallees, not a backend cache.
    pub mut val finalAggregates: Array[FinalAggregateResolution] = []
    // Concrete enum-match layouts, keyed by (BodyInstance, source Stmt).
    // This is semantic output, not a backend cache.
    pub mut val finalMatches: Array[FinalMatchResolution] = []
    pub mut val finalMatchIndexSlots: Array[U64] = []
    // Storage/writeback provenance is deliberately separate from callable
    // provenance. It is derived from final call descriptors after their
    // worklist reaches a fixpoint.
    pub mut val semanticAccesses: Array[SemanticAccess] = []
    // Canonical semantic body instances. Mono interns a complete body key here;
    // the backend consumes the same id rather than reconstructing an enclosing
    // substitution environment at every call site.
    pub mut val bodyInstances: Array[BodyInstance] = []
    // Derived open-addressed index for finalCallees. Slots hold a 1-based
    // finalCallees index and are rebuilt from CallResolution's semantic key only.
    pub mut val finalCalleeIndexSlots: Array[U64] = []
    // Derived open-addressed index for finalAggregates. Slots hold one-based
    // table positions and can always be rebuilt from the immutable key.
    pub mut val finalAggregateIndexSlots: Array[U64] = []
    // Concrete ABI return conversions, keyed by (BodyInstance, returned ExprId).
    // Like finalAggregates this is frontend semantic output, never a Mid cache.
    pub mut val finalReturns: Array[FinalReturnResolution] = []
    // Derived open-addressed index for finalReturns; slots are one-based table
    // positions and are rebuilt whenever the semantic table changes.
    pub mut val finalReturnIndexSlots: Array[U64] = []
    // Instance-invariant final callable per expression.  Kept as a scalar
    // parallel array so a plain free call does not depend on a body worklist.
    pub mut val finalExprCallee: Array[U64] = []
}
pub impl Arena { factory }

// The ARC ownership class of a grounded TypeRef — THE single classification that
// every ARC decision reads (needs-heap gates, retain/release/deep-copy walkers,
// make-owned construction, local drops, place stores). Produced only by
// Comp.arcClassOfRef (Codegen/Arc.pw); consumers match on it instead of
// re-enumerating the ownership classes per site (the drift that produced the
// review/06/07/12 leak/UAF families — audit-1 "owningKindOf" blueprint).
// Boxed (recursive-field box pointers) is a FIELD property, not a type property:
// field walkers check FieldDef.boxed BEFORE classifying the field type.
export enum ArcClass {
    // no ARC: primitives, extern/opaque handles, unresolved names (a MISS is
    // deliberately quiet here — gates that need loudness check resolution first)
    Scalar
    // a String value: one rc-managed rawbuf (literals carry a sentinel rc)
    StringLike
    // `Buffer[elem]`: the opaque rawbuf floor; release cascades into elements
    BufferLike(elem: U64)
    // `Ref[T]` cell: strong rc; release runs pointee deinit at 0
    RefCell(inst: U64)
    // `WeakRef[T]` cell: weak rc; never keeps the pointee alive
    WeakCell(inst: U64)
    // `Promise[T]` cell: an rc'd rawbuf holding the resolve state; retain/drop the
    // cell only (the resolved value is type-erased i64 today — a heap-typed resolved
    // value is not yet released at cell death, see provisional.md)
    PromiseCell(inst: U64)
    // an `any P` existential value: the fat pointer { data box, vtable }. retain =
    // bump the box rc (CoW-share); release = drop one owner, and at rc 0 destroy the
    // boxed concrete through the vtable's drop thunk (slot 1) then free the box. The
    // sole write point — an `inout` requirement dispatch — privatizes a shared box
    // first (copy thunk + repoint), so a sharer never observes mutation.
    AnyBox
    // a closure value: the fat pointer { fn, env }. env = an rc'd rawbuf cell whose
    // slot 0 is the per-closure drop thunk and slots 1.. the captures. retain = bump
    // the env rc (null env — a non-capturing closure — is a no-op); release = drop
    // one owner, at rc 0 call the drop thunk (destroys captures) then free the env.
    ClosureVal
    // a registered non-extern struct value (incl. Array[T] and any grounded
    // generic instance): field-recursive walkers / witnesses
    StructVal(sidx: U64)
    // a declared enum value (grounded instance): variant-payload walkers
    EnumVal(eidx: U64)
}

// One desugared `?.` stage (the Chain-trait match rewrite): keyed by the
// rewritten MatchExpr's expr id. `stageRef` = the stage's result `Head[U]` and
// `valueRef` = the receiver's chain Value V, both computed ONCE at rewrite time
// with NO substitution env active — i.e. parametric inside a generic body — so
// every reader (chainResultRef) and every fn instance's scan registration
// (registerChainSiteInsts) grounds them under its own active env. stageRef == 0
// never occurs on a real site (used as the lookup-miss sentinel).
export struct ChainSite {
    pub val exprId: U64
    pub val stageRef: U64
    pub val valueRef: U64
    // `?.` creates these calls after ordinary source resolution has finished.
    // Keep their declaration-time selections with the parametric stage instead
    // of asking each BodyInstance to re-resolve a synthetic `Head.empty()` /
    // `Head.fromValue(...)` spelling.  Mono grounds `stageRef` and turns this
    // template into ordinary CallResolution records per concrete body instance.
    pub val fromValueExprId: U64 = 0U64
    pub val fromValueCallee: U64 = 0U64
    pub val emptyExprId: U64 = 0U64
    pub val emptyCallee: U64 = 0U64
}
pub impl ChainSite { factory }

// A compiler-synthesized call may have no spelling from which its concrete
// receiver can be reconstructed.  Keep the parametric receiver chosen by the
// lowering rule alongside that call site; Mono grounds it under BodyInstance
// and publishes an ordinary CallResolution.  This is the same provenance rule
// as ChainSite, generalized to non-source implementation calls.
export struct SyntheticCallSite {
    pub val exprId: U64
    // Allocated at the synthesis point.  Generated nodes have no source span,
    // so an arena index is only a navigation anchor, never their origin.
    pub val originSerial: U64 = 0U64
    pub val receiverTerm: U64
}
pub impl SyntheticCallSite { factory }

// A value-level `Index.index` call has a second, non-value provenance: the
// place which would receive a later get-modify-set writeback. This carrier is
// separate from CallTemplate: the latter selects a callable, while this
// records storage/evaluation provenance for later access elaboration.
export struct AccessCandidate {
    pub val readExpr: U64
    // A detached synthetic `IndexSet.indexSet` call with the read result as
    // its type anchor. Record selects this facet while lexical receiver/key
    // provenance is still available; Mid later replaces that anchor with its
    // materialized mutable temporary and never executes this expression.
    pub val writeExpr: U64
    pub val placeExpr: U64
    pub val originSerial: U64 = 0U64
}
pub impl AccessCandidate { factory }

// A frozen use of an indexed storage candidate by a selected call. `parent`
// is a CallSiteKey, not a syntax/name lookup: final access elaboration reads
// the selected CallTemplate/CallResolution from it. `role` is 1=receiver,
// 2=explicit argument. `write` is decided only when Record has a selected ABI
// mode; it is never inferred from spelling in Lower.
export struct AccessUse {
    pub val candidateIndex: U64
    // The value expression consumed by the parent call. This can be a field
    // projection of the candidate's synthetic Index.index result (for
    // `items[i].field.append(...)`), so candidate identity alone is not the
    // complete inout access path.
    pub val accessExpr: U64
    pub val parent: CallSiteKey
    pub val role: U64
    pub val argIndex: U64 = 0U64
    // Source argument index is diagnostic provenance only. Mid call operands
    // are arranged by the selected parameter mapping, which is recorded here.
    pub val parameterIndex: U64 = 0U64
    pub val modeKnown: Bool = false
    pub val write: Bool = false
}
pub impl AccessUse { factory }

// A body-instance-specific access fact, frozen only after both the synthetic
// Index.index read and its parent call have final CallResolutions. Resolution
// indices are stable inside Arena's immutable final-callee table; the backend
// never re-selects either call from a collection name or source expression.
export struct SemanticAccess {
    pub val bodyId: U64
    pub val candidateIndex: U64
    // Frozen evaluation inputs of the indexed storage path. These remain AST
    // navigation anchors only: Mid uses them to materialize the already
    // selected receiver/key operands and never re-resolves their meaning.
    pub val baseExpr: U64
    pub val keyExpr: U64
    pub val baseTerm: U64
    pub val keyTerm: U64
    pub val valueTerm: U64
    // The selected value passed to the parent. `valueTerm` above remains the
    // storage value returned by Index.index and is what IndexSet writes back;
    // this pair is its explicit read-only projection for the parent ABI.
    pub val accessExpr: U64
    pub val accessTerm: U64
    pub val readResolution: U64
    // `finalCallees.count()` means read-only: no IndexSet facet was finalized.
    pub val writeResolution: U64 = 0U64
    pub val parentResolution: U64
    pub val role: U64
    pub val argIndex: U64 = 0U64
    pub val parameterIndex: U64 = 0U64
    pub val write: Bool = false
}
pub impl SemanticAccess { factory }

// The stable identity of a semantic call occurrence.  `ownerFnIdx` is the
// declaration body (globals use the one-past-last Func sentinel).  originKind
// is 1=written source, 2=compiler synthesis, 3=implicit protocol.  Source
// origins use the complete span; synthesized and implicit origins use a
// producer-allocated serial.  `exprId` deliberately does not appear here.
export struct CallSiteKey {
    pub val ownerFnIdx: U64 = 0U64
    pub val originKind: U64 = 0U64
    pub val originStart: U64 = 0U64
    pub val originEnd: U64 = 0U64
    pub val originSerial: U64 = 0U64
    pub val slot: U64 = 0U64
}
pub impl CallSiteKey { factory }

// A semantic type source may depend on an earlier call result even though a
// canonical TypeTerm must remain a pure structural algebra. `kind` is
// 1=Term, 2=CallResult, 3=Project, 4=OptionalPayload. `input` is the child of
// Project or OptionalPayload; CallResult's
// CallSiteKey is semantic identity; ExprId plus `siteIsStmt` are navigation
// only, because implicit protocol calls are statement-owned rather than
// expression-owned.
export struct SemanticTypeRecipe {
    pub val kind: U64 = 0U64
    pub val term: U64 = 0U64
    pub val input: U64 = 0U64
    pub val exprId: U64 = 0U64
    pub val siteIsStmt: Bool = false
    pub val callSite: CallSiteKey = <CallSiteKey />
    pub val traitOwner: U64 = 0U64
    pub val traitId: U64 = 0U64
    pub val traitArgs: Array[U64] = []
    pub val assocId: U64 = 0U64
}
pub impl SemanticTypeRecipe { factory }

// The semantic type source of one non-range `for` binding. Stmt ids are
// stable arena navigation keys; the recipe itself carries semantic call
// identity where one is needed. This is not a Local field because Record and
// every BodyInstance scan construct independent local scopes.
export struct ForTypeRecipe {
    pub val stmtId: U64 = 0U64
    pub val itemRecipe: U64 = 0U64
}
pub impl ForTypeRecipe { factory }

// A call template's receiver is either an explicit parametric term or the
// completed result of an earlier call.  A `CallSiteKey` is its semantic
// identity; `exprId` is only the navigation anchor used while looking up that
// already-published result in the current BodyInstance. Keeping this as a sum
// type prevents a template from accidentally carrying both sources.
export enum CallTemplateReceiver {
    None
    // The frontend selected an ordinary instance method, but the receiver is
    // compiler-internal and has no language TypeRef (for example `Comp` while
    // compiling the compiler itself). The AST remains the backend value
    // source; this variant says only that no semantic receiver substitution is
    // available or required. It is deliberately distinct from None, which is
    // an associated/static call with no value receiver at all.
    Opaque
    Term(term: U64)
    PriorCallResult(exprId: U64, siteKey: CallSiteKey)
    PriorProtocolResult(slot: U64)
    // `#Source` decorates the value yielded by an earlier call; it is not a
    // fresh lexical lookup.  Keep the dependency and the view transform in
    // one semantic source so body-instance grounding can apply provenance
    // after reading the already-published result.
    PriorCallResultWithViews(exprId: U64, siteKey: CallSiteKey, views: Array[ResolvedViewSource])
    PriorProtocolResultWithViews(slot: U64, views: Array[ResolvedViewSource])
}

// One call argument is semantic input, not a request to inspect a shared Expr
// later. A literal whose type is intentionally context-sensitive keeps its
// Record-time TypeInfo adapter; every other value carries either its closed
// TypeTerm or the completed result of an earlier call site. Operators, direct
// calls, protocol calls, and future Mid `ResolvedCall`s share this one source
// algebra so no site kind acquires a private AST recovery path.
export enum CallArgumentSource {
    Term(exprId: U64, term: U64)
    // A lexical local can acquire a more precise concrete type while its body
    // instance is finalized (notably a `for` item from an Iterator proof).
    // `localIndex` is recorded in the same body walk and is therefore an
    // identity, not a later name lookup; `term` is the declaration-time
    // fallback for synthetic/incomplete scopes.
    Local(exprId: U64, localIndex: U64, term: U64)
    PriorCallResult(exprId: U64, siteKey: CallSiteKey)
    Legacy(exprId: U64, info: TypeInfo)
}

// The call-site ABI shape is source provenance too: labels and `inout` belong
// to the selected parameter mapping, while ExprId remains only the backend
// navigation anchor for value evaluation.  Keeping them beside the semantic
// type source prevents Mono from reopening an Expr solely to recover them.
export struct CallTemplateArgument {
    pub val source: CallArgumentSource
    pub val isInout: Bool
    pub val labelStart: U64
    pub val labelLen: U64
    pub val hasLabel: Bool
}
pub impl CallTemplateArgument { factory }

// Dynamic dispatch has source-selected identity just as direct dispatch does,
// but its callable is a value or a witness slot rather than a Func declaration.
// Keep the symbolic template distinct from CallTarget: its function TypeTerm is
// still parametric here and becomes the ground CallTarget only per BodyInstance.
export enum DynamicCallTemplateTarget {
    ClosureLocal(bindingDeclStart: U64, fnTypeTerm: U64)
    ClosureField(fieldIndex: U64, fnTypeTerm: U64)
    ExistentialRequirement(traitIdx: U64, slot: U64)
}

// The template is a site-kind sum.  These alternatives deliberately cannot
// mix an ordinary call's declared callee with an operator's symbolic proof or
// a protocol receiver.  Finalization consumes exactly the selected variant.
export enum CallTemplateKind {
    Pending
    // Direct means the declaration is already selected.  It may still be a
    // provided trait copy, in which case `proof` is the declaration-time
    // evidence that selected its conformance path; it is grounded only when
    // the enclosing BodyInstance grounds `receiver`.
    Direct(callee: U64, receiver: CallTemplateReceiver, args: Array[CallTemplateArgument], calleeTypeArgs: Array[U64], proof: StaticConformanceProof)
    StaticMethod(receiver: CallTemplateReceiver, args: Array[CallTemplateArgument], resolution: StaticMemberResolution, resultTerm: U64)
    Dynamic(receiver: CallTemplateReceiver, args: Array[CallTemplateArgument], target: DynamicCallTemplateTarget)
    Protocol(receiver: CallTemplateReceiver)
    Operator(op: I64, operands: Array[CallArgumentSource], resolution: StaticMemberResolution, resultTerm: U64)
}

// Parametric call semantics are owned by a declaration body and CallSiteKey,
// never by ExprId. Expected-result context is part of this template, while
// the expression result TypeTerm remains in SemanticExprType for generic type
// operations that are not calls.
export struct CallTemplate {
    pub val siteKey: CallSiteKey = <CallSiteKey />
    pub val kind: CallTemplateKind = <CallTemplateKind.Pending />
    pub val expectedResultTerm: U64 = 0U64
}
pub impl CallTemplate { factory }

// One record-destructuring site (`(val a, b: _) = init` statement, the struct
// form `P { val a } = init`, or the `for (val a, val b) in xs` loop pattern),
// recorded at Lower time because the desugar (temp + per-field lets/assigns)
// erases the bind LIST the completeness check needs (spec/03: every field must
// be bound or discarded, no duplicates). Keyed by the lowered init/iter expr
// id; Verify checks the site while walking the owning statement (the locals
// env is live there, so a variable init types). Each bind reuses Bind:
// nameStart/nameLen = the bound local (len 0 = a `label: _` discard),
// fieldStart/fieldLen = the field's SOURCE span, offset = the bind's source
// offset (diagnostics). isElem: the init is the loop SOURCE (an array) —
// check its element type, not its own. typeStart/typeLen: the struct form's
// declared type name (interned; len 0 = the record `(...)` form) — Verify
// also checks it AGAINST the initializer's actual type.
export struct DestructureSite {
    pub val initId: U64
    pub val offset: U64
    pub val isElem: Bool
    pub val typeStart: U64 = 0
    pub val typeLen: U64 = 0
    pub val binds: BindRange
}
pub impl DestructureSite { factory }

// Declaration / conformance / name side-tables built during loading & analysis.
// `traits`/`conforms`/`methodAliases` drive trait conformance (spec/08): trait
// decls, recorded conformances, and `via` requirement→witness redirects.
// `derives`: `@[...]` derive requests on type decls. `funcBounds`: `where T:
// Trait` bounds keyed by function index. `deinits`: types with a `deinit` (Bind
// = receiver type span). `assocBindings`: `type Item = Concrete` lines from
// conformances. `pubFactories`: interned ids of types with a `pub factory`.
// `namespaces`: `import @Std/Io` namespace binds. `importAliases`: `import …
// with { real as alias }` rewrites. `chainSites`: each desugared `?.` stage,
// recorded PARAMETRICALLY (see ChainSite) so readers and per-instance
// registration ground it under their own env — storing a grounded result would
// freeze the first instance's grounding into every other instantiation of a
// generic body. `destructureSites`: each record/struct destructure's bind list
// (see DestructureSite). `forTypeRecipes`: each non-range `for` binding's
// deferred item source (see ForTypeRecipe). `kwCache`: cached built-in name
// spans (O(1) kwSpan).
export struct Decls {
    pub mut val traits: Array[TraitDef] = []
    pub mut val traitBindPool: Array[Bind] = []
    pub mut val traitReqPool: Array[Func] = []
    pub mut val traitOwners: Array[TraitOwner] = []
    pub mut val callables: Array[Callable] = []
    pub mut val conforms: Array[Conform] = []
    // Typed immutable payload pools for scalar Conform rows. See the range
    // descriptors above; consumers must read them through Comp's range readers
    // instead of copying a declaration aggregate out of conforms.
    pub mut val conformTypePool: Array[U64] = []
    pub mut val conformBindPool: Array[Bind] = []
    pub mut val conformWitnessPool: Array[Func] = []
    pub mut val conformFuncIdPool: Array[U64] = []
    pub mut val methodAliases: Array[MethodAlias] = []
    pub mut val derives: Array[DeriveReq] = []
    pub mut val funcBounds: Array[FuncBound] = []
    // Func rows are copied throughout selection and emission. Keep every
    // variable-sized signature child in a typed declaration pool so that row
    // inspection is scalar and fixed-point safe.
    pub mut val funcBindPool: Array[Bind] = []
    pub mut val funcTypePool: Array[U64] = []
    pub mut val funcParamPool: Array[Param] = []
    pub mut val defaultGeneratorRanges: Array[DefaultGeneratorRange] = []
    pub mut val defaultGeneratorFunctions: Array[U64] = []
    pub mut val deinits: Array[Bind] = []
    pub mut val assocBindings: Array[AssocBinding] = []
    pub mut val pubFactories: Array[U64] = []
    pub mut val namespaces: Array[Bind] = []
    pub mut val importAliases: Array[Bind] = []
    pub mut val chainSites: Array[ChainSite] = []
    pub mut val syntheticCallSites: Array[SyntheticCallSite] = []
    pub mut val accessCandidates: Array[AccessCandidate] = []
    pub mut val accessUses: Array[AccessUse] = []
    // Parametric aggregate facts selected by Record. Unlike AST MakeField,
    // these carry physical layout identity and no field/variant spelling.
    pub mut val semanticAggregates: Array[SemanticAggregate] = []
    // Derived open-addressed index for SemanticAggregate. Slots hold one-based
    // semanticAggregates indices and are rebuilt solely from (ownerFnIdx,
    // exprId); this is lookup structure, never a second semantic source.
    pub mut val semanticAggregateIndexSlots: Array[U64] = []
    // Parametric enum-match facts, keyed by (ownerFnIdx, source Stmt).
    pub mut val semanticMatches: Array[SemanticMatch] = []
    pub mut val semanticMatchIndexSlots: Array[U64] = []
    pub mut val callTemplates: Array[CallTemplate] = []
    // Derived open-addressed index for CallTemplate. Slots hold one-based
    // callTemplates indices and are rebuilt solely from CallSiteKey; this is
    // lookup structure, never a second semantic source.
    pub mut val callTemplateIndexSlots: Array[U64] = []
    pub mut val destructureSites: Array[DestructureSite] = []
    pub mut val forTypeRecipes: Array[ForTypeRecipe] = []
    // Semantic lowering requirement, not a source-language restriction.  A
    // body with a conditional unique move must not fall back to the legacy
    // path-insensitive AST emitter while Mid migration is incremental.
    pub mut val ownershipCfgFunctions: Array[U64] = []
    pub mut val kwCache: Array[Bind] = []
}
pub impl Decls { factory }

// Module identity + cross-module visibility tables (spec/15). `ranges`: each
// entry (reusing Bind) tags a source file's [start,len) span in `bytes` with its
// module id (fieldStart), so `moduleOf(offset)` reverse-maps a decl/use to its
// module (a module = a root file + its `part` tree; each `import` target is
// another). `exports`: name spans of `export`ed top-level decls (a name is public
// iff it appears here). `imports`: imported name spans with `fieldStart` = the
// importing module id (a cross-module use is visible only if imported there, and
// exported by its own module). Aliases / namespace imports are additive.
export struct Modules {
    pub mut val ranges: Array[Bind] = []
    // source file path of each range (parallel to `ranges`) — lets diagnostics
    // report `path:line` instead of a line number into the concatenated buffer.
    pub mut val rangePaths: Array[String] = []
    pub mut val exports: Array[Bind] = []
    pub mut val imports: Array[Bind] = []
    // import EDGES (fieldStart = importing module, fieldLen = the module the import
    // resolved to). Recorded by the loader for each `import` (with-list or namespace).
    // Used to disambiguate same-named exports across COEXISTING package versions: when
    // several loaded modules export the same name, a use prefers the candidate whose
    // module the use's own module directly imported (so two `import @Leaf` resolving to
    // different versions bind their own `leafval`). A single candidate is unaffected
    // (re-exports / normal cross-module use stay name-based).
    pub mut val importEdges: Array[Bind] = []
    // re-export EDGES (fieldStart = the re-exporting module, fieldLen = the source module it
    // forwards from). Recorded by the loader for each `export <path> with { … }` (spec/15).
    // Composed with an import edge for visibility: a name defined+exported in the source
    // module is visible to a consumer that imported the re-exporting module (the barrel) and
    // brought the name into scope — the barrel need not be the name's defining module.
    pub mut val reExportEdges: Array[Bind] = []
    // package root surface for each module (nameStart = module id, fieldStart = root
    // module id). For package-backed source this is `src/_.pw`; for standalone files and
    // bundled std modules it is the module itself. Public API closure uses this to distinguish
    // a module-local `export` from the package's external surface (spec/15).
    pub mut val packageRoots: Array[Bind] = []
    // Local import/re-export spelling -> original spelling + target module. This
    // is provenance for declaration-identity resolution, not a visibility table.
    pub mut val importOrigins: Array[Bind] = []
    pub mut val reExportOrigins: Array[Bind] = []
    // the module id of the ambient lang-item module @Std/Lang (std/Lang.pw), or the
    // "none" sentinel 4_000_000_000 when it was not loaded. Lang is THE ambient module
    // (spec/15): the types it declares — the language's built-in types — are in scope
    // everywhere without an `import`. Type visibility (Check/Visibility.pw) treats a type
    // defined in this module as ambient. Captured when the driver force-loads Lang.
    pub mut val langModule: U64 = 4000000000U64
    // The module defining language operator traits (`@Std/Core`).  Operator
    // sugar is specified in terms of these declarations, not whichever trait
    // named `Eq`/`Add` happened to be visible at a later checker site.
    pub mut val coreModule: U64 = 4000000000U64
    // The bundled Std Io module. It is loaded for runtime ABI declaration
    // identity only; its ordinary free functions remain non-ambient.
    pub mut val ioModule: U64 = 4000000000U64
    // The bundled Std Process module. Runtime ABI declaration identity is
    // distinct from its ordinary import visibility.
    pub mut val processModule: U64 = 4000000000U64
}
pub impl Modules { factory }

// Monomorphization work lists + derived tables, collected after parsing and
// consumed by codegen. `genInsts`: concrete generic instantiations to emit
// (TypeRef indices, deduped, post-order so a nested by-value instance precedes
// its container). `fnInsts`: concrete instantiations of generic free functions.
// `fnTypes`: distinct function-type TypeRefs (one C fn-pointer typedef each).
// `fnThunks`: legacy named-function-value thunk list, kept empty in v1 because named
// declarations are callable but not values. `captures`: closure value captures (flat,
// keyed by closure arena id).
// `arrayElems`: distinct Array element type names (for PlewArray_<E> + runtime;
// each reuses Bind as a (start,len) pair). `boxedFields`: fields whose declared
// type transitively reaches their owning struct/enum (a containment cycle), so
// stored behind a heap pointer (deref-on-read / repoint-on-write keeps value
// semantics); keyed by the field decl's nameStart.
export struct MonoWork {
    pub mut val genInsts: Array[U64] = []
    pub mut val fnInsts: Array[FnInst] = []
    pub mut val fnTypes: Array[U64] = []
    pub mut val fnThunks: Array[U64] = []
    pub mut val captures: Array[CaptureEntry] = []
    pub mut val arrayElems: Array[Bind] = []
    pub mut val boxedFields: Array[U64] = []
    // Concrete bodies reachable from program roots.  The frontend closes this
    // worklist before backend emission, so backend never has to resolve a call
    // merely to discover or prepare another body.
    // Worklist of 1-based Arena.bodyInstances ids. The body registry itself is
    // semantic analysis output; this queue is only the transient reachability
    // traversal used to populate it.
    pub mut val bodyInstances: Array[U64] = []
    // transient: the expected type ref of the binding currently being scanned (a `let`
    // annotation), so an assoc-fn constructor whose type param comes only from context
    // (`Set.new()` / `Set.from([])`) registers its instance. Mirrors the backend's
    // expectedTy; set/restored around the initializer scan, 0 otherwise.
    pub mut val scanExpectedTy: U64 = 0
}
pub impl MonoWork { factory }

// Typed-AST cache (Phase B): each expression node's recovered `TypeInfo`, stored
// as parallel scalar arrays keyed by expr id (struct-array IndexSet isn't in the
// self-host subset). `typeOf` fills these lazily and PERSISTENTLY (one slot per
// expr id, allocated by buildExprTyTable, never cleared) and reads them back, so
// codegen and the checker stop re-deriving via `exprType`. `kind == typeUnfilled`
// marks an uncomputed slot; the fill path holds the recvInstRef==0 invariant (see
// typeOf). Literal context is stored in SemanticExprType because it is part of
// the complete semantic expression type, not merely an implementation cache.
export struct TypeCache {
    pub mut val kind: Array[I64] = []
    pub mut val start: Array[U64] = []
    pub mut val len: Array[U64] = []
    pub mut val ref: Array[U64] = []
    // `#Source` is part of a type's static identity. It must survive the
    // typed-AST cache just like the structured TypeRef does.
    pub mut val viewId: Array[U64] = []
    // resolved free-function callee per call-expr id (the `findFunc` result), the
    // first step of pre-resolving the IR so the backend reads decisions instead of
    // re-running overload resolution at emit time. PERSISTENT (unlike kind/…, never
    // cleared per body): which decl a call resolves to is instantiation-invariant —
    // a type parameter is opaque (spec/06), so an overload can never be selected via
    // a type-parameter arg, hence the result is stable per call-expr id. Sentinel
    // `calleeUnfilled()` marks an uncomputed slot; a filled slot may legitimately
    // hold `funcs.count()` ("resolves to no declared function" — a call through a fn
    // value/local), which is itself stable, so it is cached too.
    pub mut val callee: Array[U64] = []
    // resolved binding category per Ident-expr id, recorded by the name-resolution pass
    // (the verify/check Ident walk, where c.cur.locals is valid). PERSISTENT (like callee:
    // which entity a name binds to is lexical, not instantiation-dependent). Codes —
    // identUnfilledCode 0 / identValueCode 1 (self·local·param·global) / identFnCode 2
    // (a bare free-function declaration; callable but not a value) / identTypeQualCode 3 (a type /
    // primitive / type-parameter, valid only as an assoc-fn receiver) / identUndefCode 4
    // (unresolved). The single record every pass reads instead of re-deriving the binding
    // by name; the backend reads local targets only (its own findLocal is the SSA-pointer
    // mechanism). Unfilled for std / synthesized nodes.
    pub mut val identBind: Array[I64] = []
    // resolved TARGET per Ident-expr id, paired with identBind: for identFnCode, the
    // resolved free-function index (firstFuncByName result) so diagnostics read the decided
    // callee instead of re-deriving it; identNoTarget otherwise (a local's SSA slot stays the
    // backend's own findLocal mechanism). PERSISTENT, like callee/identBind.
    pub mut val identTarget: Array[U64] = []
}
pub impl TypeCache { factory }

// Stable payload of a nonzero interner id.  The slice is always into
// `Arena.bytes`; `intern` validates that invariant at the boundary.
export struct InternedSpan {
    pub val start: U64
    pub val len: U64
}
pub impl InternedSpan { factory }

export struct Interner {
    // One entry owns both ends of an interned source slice.  Keeping these as
    // parallel arrays made it possible for an id's start, length, and count to
    // diverge at mutation boundaries.
    pub mut val entries: Array[InternedSpan] = []
    pub mut val buckets: Array[U64] = []
}
pub impl Interner { factory }

// Parse-time scratch, reset at each `impl`/decl boundary (not live across passes).
// `pendingDerives`: derive names parsed for the *next* type decl (folded into
// decls.derives). `witnessed`: requirement names witnessed by the trait impl
// being parsed (folded into the Conform at the impl's close). `whereTraits`: the
// trait spans from parseWhereClause (parallel to its returned param spans).
// `implBoundParams`/`implBoundTraits`: the impl-level `where T: Trait` bounds of
// the impl being parsed (each member fn folds these into decls.funcBounds).
export struct ParseScratch {
    pub mut val pendingDerives: Array[DeriveReq] = []
    pub mut val witnessed: Array[Func] = []
    pub mut val whereTraits: Array[Bind] = []
    pub mut val implBoundParams: Array[Bind] = []
    pub mut val implBoundTraits: Array[Bind] = []
}
pub impl ParseScratch { factory }

// The per-body cursor: transient state for the function/closure body currently
// being lowered / checked / emitted, saved & restored around each body (NOT live
// across bodies). `locals` are the variables in scope; `tmp`/`giveTmp` are
// fresh-name counters; `ret*` is the declared return type; `hasRecv`/`recv*`/
// `self*`/`item*` are the method receiver + resolved Self/Item; `typeParams`/
// `typeArgs` are the generic substitution env; `closureId`/`inClosure`/
// `captureMark` track closure-body emission; `verifyLoopDepth`/`verifyMovedIdx`/
// `branchBase` are the verify-pass loop/move bookkeeping; `inAsync`/`asyncState`/
// `asyncFn`/`asyncVarSeq` drive async state-machine lowering; `lowerRetTy` is the
// lowering-time return type (generic-constructor inference); `checkFn` is the
// function index the eager generic checker is on.
export struct Cursor {
    pub mut val locals: Array[Local] = []
    pub mut val tmp: U64 = 0
    pub mut val giveTmp: U64 = 0
    pub mut val loopMark: U64 = 0
    pub mut val isMain: Bool = false
    pub mut val retVoid: Bool = false
    pub mut val retStart: U64 = 0
    pub mut val retLen: U64 = 0
    pub mut val retIsArray: Bool = false
    pub mut val retTy: U64 = 0
    pub mut val hasRecv: Bool = false
    pub mut val recvStart: U64 = 0
    pub mut val recvLen: U64 = 0
    // 0 for the type's anonymous impl; nonzero for a named extension impl.
    pub mut val extId: U64 = 0
    pub mut val selfInout: Bool = false
    pub mut val selfMove: Bool = false
    pub mut val recvInstRef: U64 = 0
    pub mut val selfRef: U64 = 0
    pub mut val itemRef: U64 = 0
    pub mut val typeParams: Array[Bind] = []
    pub mut val typeArgs: Array[U64] = []
    // The immutable body-scoped substitution snapshot. It is distinct from
    // the transient callee environment in `typeParams/typeArgs`; all reads of
    // a shared generic AST use this one key.
    pub mut val bodyEnvironment: InstanceEnvironment = <InstanceEnvironment />
    // Derived conveniences of `bodyEnvironment.receiverRef`, kept only to
    // avoid repeatedly resolving Self/Item projections. They are not part of
    // a body/call key and must be rebuilt whenever the environment is entered.
    pub mut val bodySelfRef: U64 = 0
    pub mut val bodyItemRef: U64 = 0
    // The body currently being scanned/emitted. Together with
    // `bodyEnvironment` it identifies an Arena.finalCallees entry.
    pub mut val bodyFnIdx: U64 = 18446744073709551615U64
    // 1-based Arena.bodyInstances identity for the active semantic body.
    // It is set whenever a body context is entered and lets final-callee lookup
    // avoid re-comparing the complete InstanceEnvironment on every call.
    pub mut val bodyId: U64 = 0U64
    pub mut val closureId: U64 = 0
    pub mut val inClosure: Bool = false
    pub mut val captureMark: U64 = 0
    pub mut val verifyLoopDepth: U64 = 0
    pub mut val verifyMovedIdx: Array[U64] = []
    pub mut val branchBase: U64 = 0
    pub mut val inAsync: Bool = false
    pub mut val asyncState: U64 = 0
    pub mut val asyncFn: U64 = 0
    pub mut val asyncVarSeq: U64 = 0
    pub mut val lowerRetTy: U64 = 0
    pub mut val checkFn: U64 = 0
    // Record's first walk writes parametric TypeTerms before generic checking;
    // its second walk runs after verification and is the sole producer of
    // CallTemplates.  Keeping this phase bit in the transient cursor prevents
    // an early, incompletely-resolved call from becoming semantic provenance.
    pub mut val recordCallTemplates: Bool = false
    // While Record visits a detached access-write facet, its value type anchor
    // points back to the candidate's read call. This guard prevents that
    // structural dependency from recursively recording the same facet; it is
    // traversal state only and never semantic provenance.
    pub mut val recordingAccessWriteFacet: Bool = false
    // monotonic gensym counter for lowering-synthesized temp locals (compound-assign
    // place bindings etc.), so names are globally unique across statements.
    pub mut val lowerTmpSeq: U64 = 0
}
pub impl Cursor { factory }


// Public memberwise factories for the IR node vocabulary. Every analysis/codegen
// pass lives in a different module and constructs these nodes (`<TypeRef …/>`,
// `<Bind …/>`, `<StructDef …/>`, …), so the default-private memberwise factory
// must be exposed. (The arena/table sub-structs above declare theirs inline.)
pub impl PType { factory }
pub impl TypeRef { factory }
pub impl CaptureEntry { factory }
pub impl Local { factory }
pub impl TypeInfo { factory }
pub impl MakeField {
    factory
    fn isWritten() -> Bool {
        match self.origin {
            MakeFieldOrigin.Written => { return true }
            _ => { return false }
        }
    }
    fn requiresFactoryAccess() -> Bool {
        match self.origin {
            MakeFieldOrigin.Synthesized => { return false }
            _ => { return true }
        }
    }
}
pub impl Bind { factory }
pub impl Arg { factory }
pub impl MatchArm { factory }
pub impl PatInfo { factory }
pub impl IdentBinding { factory }
pub impl Block { factory }
pub impl Param { factory }
pub impl FieldDef { factory }
pub impl StructDef { factory }
pub impl Variant { factory }
pub impl TraitDef { factory }
pub impl DeriveReq { factory }
pub impl AssocBinding { factory }
pub impl Conform { factory }
pub impl MethodAlias { factory }
pub impl FuncBound { factory }
pub impl FnInst { factory }
pub impl InstanceEnvironment { factory }
pub impl CallResolution { factory }
pub impl BodyInstance { factory }
pub impl EnumDef { factory }
pub impl Func { factory }
pub impl Global { factory }
pub impl NewtypeDef { factory }

// Append every byte of `from` onto `into`. A generic byte-buffer primitive used
// across the whole compiler (path building, LLVM string emission, …), so it lives
// in the shared IR leaf rather than any one pass.
// Resolved-binding category codes for `typeCache.identBind` (see TypeCache). 0 marks an
// unrecorded slot; 1..4 are the categories the name-resolution pass assigns to an Ident.
// Defined here (the shared IR vocabulary) so both Frontend (the resolver that fills them)
// and Backend (which reads them) can name the codes.
export fn identUnfilledCode() -> I64 { return 0I64 }
// Sentinel `typeCache.identTarget` value marking "no resolved target recorded".
export fn identNoTarget() -> U64 { return 18446744073709551615U64 }
// `self` is a lexical receiver binding, not an unaddressable value. Give it a
// dedicated identity so downstream semantic consumers never need to recover it
// from spelling; this stays distinct from the no-target sentinel used by globals.
export fn identSelfTarget() -> U64 { return 18446744073709551614U64 }
export fn identValueCode() -> I64 { return 1I64 }
export fn identFnCode() -> I64 { return 2I64 }
export fn identTypeQualCode() -> I64 { return 3I64 }
export fn identUndefCode() -> I64 { return 4I64 }

export fn appendBytes(into: inout Array[U8], from: Array[U8]) {
    mut val i: U64 = 0
    while i < from.count() {
        into.append(from[i])
        i += 1
    }
}
