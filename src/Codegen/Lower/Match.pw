// Lower pattern syntax without erasing arm order or separating value tests
// from structural patterns. Record selects meaning; Mid selects the CFG.

// Lower match arms. Each arm's `body` is a Block index (both statement and
// expression position). A value-match arm's block ends in `give`; a diverging arm
// (`=> panic`/`=> return`) is flagged so the backend excludes it from the PHI.

pub impl Comp {
    // A value pattern is an ordinary Eq test. It creates no binding scope;
    // evaluate the subject first, followed by the authored comparison value.
    inout fn lowerValueCondition(subject: U64, pattern: U64, isWhileCondition: Bool) -> ConditionClause {
        val comparison = self.pushExpr(e: <Expr.Binary op=opEq() lhs=subject rhs=pattern />)
        return <ConditionClause isWhileCondition=isWhileCondition isBinding=false value=comparison pattern=<PatInfo isWildcard=true enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false /> />
    }

    inout fn lowerConditionClauses(conditions: Array[CondClause]) -> Result[ConditionClauseRange, CompileDiagnostic] {
        mut val lowered: Array[ConditionClause] = []
        for val condition in conditions {
            val value = try self.lowerExpr(e: condition.expr)
            if condition.isBinding && condition.pattern.isValuePattern {
                lowered.append(self.lowerValueCondition(subject: value, pattern: (try self.lowerExpr(e: condition.pattern.lit)), isWhileCondition: condition.isWhileCondition))
            } else {
                val pattern = try self.lowerPatternInfo(p: condition.pattern)
                lowered.append(<ConditionClause isWhileCondition=condition.isWhileCondition isBinding=condition.isBinding value=value pattern=pattern />)
            }
        }
        return <Result.Ok value=self.pushConditionClauses(conditions: lowered) />
    }

    inout fn lowerSyntaxConditionClauses(conditions: SyntaxSlice) -> Result[ConditionClauseRange, CompileDiagnostic] {
        mut val lowered: Array[ConditionClause] = []
        mut val index = 0U64
        while index < conditions.count {
            val condition = syntaxConditionClause(file: self.syntax, conditions: conditions, index: index)
            val value = try self.lowerSyntaxExpr(id: condition.expr)
            if condition.isBinding {
                val pattern = syntaxPattern(file: self.syntax, id: condition.pattern)
                if pattern.isValuePattern {
                    lowered.append(self.lowerValueCondition(subject: value, pattern: (try self.lowerSyntaxExpr(id: pattern.lit)), isWhileCondition: condition.isWhileCondition))
                } else {
                    lowered.append(<ConditionClause isWhileCondition=condition.isWhileCondition isBinding=true value=value pattern=(try self.lowerSyntaxPatternInfo(pattern: pattern)) />)
                }
            } else {
                lowered.append(<ConditionClause isWhileCondition=condition.isWhileCondition isBinding=false value=value pattern=<PatInfo isWildcard=true enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false /> />)
            }
            index += 1U64
        }
        return <Result.Ok value=self.pushConditionClauses(conditions: lowered) />
    }

    inout fn lowerMatchArms(arms: Array[MatchArmAst], isExpr: Bool) -> Result[MatchArmRange, CompileDiagnostic] {
        mut val out: Array[MatchArm] = []
        mut val i: U64 = 0
        while i < arms.count() {
            val arm: MatchArmAst = arms[i]
            val pi: PatInfo = (try self.lowerPatternInfo(p: arm.pattern))
            val body: U64 = (try self.lowerBlock(b: arm.body))
            mut val diverge: Bool = false
            if isExpr {
                diverge = armBlockDiverges(b: arm.body)
            }
            out.append(<MatchArm offset=arm.pattern.span.start captureStart=pi.captureStart captureLen=pi.captureLen captureMutable=pi.captureMutable orGroup=arm.orGroup isValuePattern=pi.isValuePattern valueExpr=pi.valueExpr isWildcard=pi.isWildcard enumStart=pi.enumStart enumLen=pi.enumLen variantStart=pi.variantStart variantLen=pi.variantLen binds=pi.binds body=body isStruct=pi.isStruct isDiverge=diverge />)
            i += 1
        }
        return <Result.Ok value=self.pushMatchArms(arms: out) />
    }

    inout fn lowerSyntaxPatternInfo(pattern: SyntaxPattern) -> Result[PatInfo, CompileDiagnostic] {
        if pattern.isValuePattern { return <Result.Ok value=<PatInfo isValuePattern=true valueExpr=(try self.lowerSyntaxExpr(id: pattern.lit)) isWildcard=false enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false /> /> }
        if pattern.isWildcard {
            return <Result.Ok value=<PatInfo captureStart=pattern.captureName.start captureLen=pattern.captureName.end - pattern.captureName.start captureMutable=pattern.captureMutable isWildcard=true enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false /> />
        }
        mut val binds: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < syntaxPatternBindCount(file: self.syntax, pattern: pattern) {
            val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxPatternBind(file: self.syntax, pattern: pattern, index: i))
            binds.append(<Bind nameStart=bind.name.start nameLen=bind.name.end - bind.name.start fieldStart=bind.field.start fieldLen=bind.field.end - bind.field.start offset=bind.span.start isMutable=bind.isMutable />)
            i += 1U64
        }
        if pattern.isRecord {
            return <Result.Ok value=<PatInfo isWildcard=false enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=self.pushBinds(binds: binds) isStruct=true /> />
        }
        mut val names: Array[Span] = []
        if pattern.typePath.count != 0U64 {
            val path = <SyntaxType namePath=pattern.typePath name=pattern.typeName args=<SyntaxSlice start=0 count=0 /> span=pattern.span extView=<Span start=0 end=0 /> viewNames=<SyntaxSlice start=0 count=0 /> projectionTrait=<Span start=0 end=0 /> projectionTraitArgs=<SyntaxSlice start=0 count=0 /> projectionTraitArgLabels=<SyntaxSlice start=0 count=0 /> projectionAssoc=<Span start=0 end=0 /> isAny=false argLabels=<SyntaxSlice start=0 count=0 /> isSendable=false isRecord=false />
            mut val segment = 0U64
            while segment < pattern.typePath.count {
                names.append(syntaxTypeNameSegment(file: self.syntax, ty: path, index: segment).name)
                segment += 1U64
            }
        } else {
            names.append(pattern.typeName)
            if !pattern.isStruct { names.append(pattern.variant) }
        }
        val head = (try self.patternTypePathHead(names: names, isStruct: pattern.isStruct))
        val typeName = names[head]
        mut val variant = <Span start=0U64 end=0U64 />
        if !pattern.isStruct { variant = names[head + 1U64] }
        return <Result.Ok value=<PatInfo isWildcard=false enumStart=typeName.start enumLen=typeName.end - typeName.start variantStart=variant.start variantLen=variant.end - variant.start binds=self.pushBinds(binds: binds) isStruct=pattern.isStruct /> />
    }

    inout fn syntaxArmBlockDiverges(arm: SyntaxMatchArm) -> Bool {
        val block: SyntaxBlock = syntaxBlock(file: self.syntax, id: arm.body)
        val count: U64 = syntaxBlockStmtCount(file: self.syntax, block: block)
        if count == 0U64 { return false }
        // This is a closed parser-tag dispatch, not a user-visible equality
        // operation.  Requiring an Eq witness for SyntaxStmtKind couples the
        // compiler's own control decision to a derive in @Plew/Syntax.
        match syntaxStmt(file: self.syntax, id: syntaxBlockStmt(file: self.syntax, block: block, index: count - 1U64)).kind {
            SyntaxStmtKind.Give => { return false }
            _ => { return true }
        }
    }

    // Statement match arms from SyntaxFile share the same semantic MatchArm
    // pool as the value-AST path. Scalar/capture desugaring chooses whether it
    // may call this after preserving its own single-evaluation transformation.
    inout fn lowerSyntaxMatchArms(arms: SyntaxSlice, isExpr: Bool) -> Result[MatchArmRange, CompileDiagnostic] {
        mut val out: Array[MatchArm] = []
        mut val i: U64 = 0U64
        while i < syntaxMatchArmCount(file: self.syntax, arms: arms) {
            val arm: SyntaxMatchArm = syntaxMatchArm(file: self.syntax, id: syntaxMatchArmAt(file: self.syntax, arms: arms, index: i))
            val pattern: SyntaxPattern = syntaxPattern(file: self.syntax, id: arm.pat)
            val info: PatInfo = (try self.lowerSyntaxPatternInfo(pattern: pattern))
            out.append(<MatchArm offset=pattern.span.start orGroup=arm.orGroup captureMutable=pattern.captureMutable captureStart=pattern.captureName.start captureLen=pattern.captureName.end - pattern.captureName.start isValuePattern=info.isValuePattern valueExpr=info.valueExpr isWildcard=info.isWildcard enumStart=info.enumStart enumLen=info.enumLen variantStart=info.variantStart variantLen=info.variantLen binds=info.binds body=(try self.lowerSyntaxBlock(id: arm.body)) isStruct=info.isStruct isDiverge=isExpr && self.syntaxArmBlockDiverges(arm: arm) />)
            i += 1U64
        }
        return <Result.Ok value=self.pushMatchArms(arms: out) />
    }

    inout fn lowerSyntaxMatchStmtInto(stmt: SyntaxStmt, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        stmts.append(self.pushStmt(s: <Stmt.Match scrut=(try self.lowerSyntaxExpr(id: stmt.child0)) arms=(try self.lowerSyntaxMatchArms(arms: stmt.arms, isExpr: false)) />))
        return <Result.Ok value=() />
    }

    inout fn lowerSyntaxMatchExprInto(expr: SyntaxExpr) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.pushExpr(e: <Expr.MatchExpr scrut=(try self.lowerSyntaxExpr(id: expr.child0)) arms=(try self.lowerSyntaxMatchArms(arms: expr.arms, isExpr: true)) />) />
    }

    // Compound assign `place OP= v` desugars to `place = place OP v` (spec/12), evaluating
    // the PLACE ONCE: side-effecting index keys in the place are bound to temp locals first,
    // then the place (read + write) references those temps — so `arr[f()] += v` calls `f()`
    // once, not twice. The OP then rides its operator-trait witness like any binary (the
    // single-source intrinsic-floor path); there is no primitive open-code and no separate
    // compound handling downstream (verify / codegen see only `=`). Ident / Field / Arrow
    // navigations are re-evaluable places (a local read, a GEP), so only Index keys need a
    // temp.
    inout fn lowerCompoundAssignInto(op: I64, target: ExprAst, value: ExprAst, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        val pid: U64 = (try self.rebuildPlaceTemping(e: target, stmts: inout stmts))
        val vid: U64 = (try self.lowerExpr(e: value))
        val read: U64 = (try self.loweredPlaceRead(id: pid))
        val binE: U64 = self.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=read rhs=vid />)
        try self.lowerPlaceAssignInto(target: pid, value: binE, stmts: inout stmts)
        return <Result.Ok value=() />
    }

    // Read a lowered place as a value.  Index is source sugar, so this is the
    // only route which turns it into the selected `Index.index` requirement;
    // field/arrow navigation merely preserve their value form around that read.
    inout fn loweredPlaceRead(id: U64) -> Result[U64, CompileDiagnostic] {
        match self.arena.exprs[id] {
            Expr.Field(val base, val nameStart, val nameLen) => {
                return <Result.Ok value=self.pushExpr(e: <Expr.Field base=(try self.loweredPlaceRead(id: base)) nameStart=nameStart nameLen=nameLen />) />
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                return <Result.Ok value=self.pushExpr(e: <Expr.Arrow base=(try self.loweredPlaceRead(id: base)) nameStart=nameStart nameLen=nameLen />) />
            }
            Expr.Index(val base, val index) => {
                return <Result.Ok value=(try self.lowerIndexRead(recv: (try self.loweredPlaceRead(id: base)), key: index)) />
            }
            _ => { return <Result.Ok value=id />}
        }
    }

    // Whether a place contains a subscript below its outermost navigation.  A
    // nested write cannot borrow that element's storage: `Index` is specified
    // by value-returning `index`/`indexSet` requirements.  It must therefore
    // use get-modify-set: read the immediate base into a mutable local, modify
    // that local, then write it back through the same (already temp-bound) path.
    inout fn loweredPlaceHasIndex(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Index(base: _, index: _) => { return true }
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.loweredPlaceHasIndex(id: base) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { return self.loweredPlaceHasIndex(id: base) }
            _ => { return false }
        }
    }

    // Assign to a lowered place after all source index keys have been bound.
    // This completes get-modify-set recursively, rather than leaving an
    // addressability special case to Mono/LLVM.  The base is evaluated once as
    // a value, held in a mutable local while its child is changed, and then
    // written back through the original IndexSet route.
    inout fn lowerPlaceAssignInto(target: U64, value: U64, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        match self.arena.exprs[target] {
            Expr.Index(val base, val index) => {
                if self.loweredPlaceHasIndex(id: base) {
                    try self.lowerNestedPlaceAssignInto(target: target, base: base, value: value, stmts: inout stmts)
                } else {
                    stmts.append((try self.lowerIndexSetAssign(recv: base, key: index, value: value)))
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                if self.loweredPlaceHasIndex(id: base) {
                    try self.lowerNestedPlaceAssignInto(target: target, base: base, value: value, stmts: inout stmts)
                } else {
                    stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=value />))
                }
            }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => {
                stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=value />))
            }
            _ => { stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=value />)) }
        }
        return <Result.Ok value=() />
    }

    inout fn lowerNestedPlaceAssignInto(target: U64, base: U64, value: U64, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        self.cur.lowerTmpSeq += 1U64
        val tmp: Bind = self.internTmpName(prefix: "__gm", n: self.cur.lowerTmpSeq)
        val read: U64 = (try self.loweredPlaceRead(id: base))
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=true nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=read />))
        val tmpId: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        mut val modified: U64 = target
        match self.arena.exprs[target] {
            Expr.Index(base: _, val index) => { modified = self.pushExpr(e: <Expr.Index base=tmpId index=index />) }
            Expr.Field(base: _, val nameStart, val nameLen) => { modified = self.pushExpr(e: <Expr.Field base=tmpId nameStart=nameStart nameLen=nameLen />) }
            _ => {}
        }
        try self.lowerPlaceAssignInto(target: modified, value: value, stmts: inout stmts)
        val tmpForWriteback: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        try self.lowerPlaceAssignInto(target: base, value: tmpForWriteback, stmts: inout stmts)
        return <Result.Ok value=() />
    }

    inout fn lowerPlainAssignInto(target: ExprAst, value: ExprAst, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        val pid: U64 = (try self.rebuildPlaceTemping(e: target, stmts: inout stmts))
        val vid: U64 = (try self.lowerExpr(e: value))
        try self.lowerPlaceAssignInto(target: pid, value: vid, stmts: inout stmts)
        return <Result.Ok value=() />
    }

    // SyntaxFile counterpart of the place rebuild.  It retains the same
    // place-once guarantee as the value-AST lowering: only side-effecting
    // index keys become temporaries, and the resulting lowered place is shared
    // by the read and write sides of a compound assignment.
    inout fn rebuildSyntaxPlaceTemping(id: ExprId, stmts: inout Array[U64]) -> Result[U64, CompileDiagnostic] {
        val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
        match e.kind {
            SyntaxExprKind.Field => {
                return <Result.Ok value=self.pushExpr(e: <Expr.Field base=(try self.rebuildSyntaxPlaceTemping(id: e.child0, stmts: inout stmts)) nameStart=e.name.start nameLen=e.name.end - e.name.start />) />
            }
            SyntaxExprKind.Arrow => {
                return <Result.Ok value=self.pushExpr(e: <Expr.Arrow base=(try self.rebuildSyntaxPlaceTemping(id: e.child0, stmts: inout stmts)) nameStart=e.name.start nameLen=e.name.end - e.name.start />) />
            }
            SyntaxExprKind.Index => {
                return <Result.Ok value=self.pushExpr(e: <Expr.Index base=(try self.rebuildSyntaxPlaceTemping(id: e.child0, stmts: inout stmts)) index=(try self.tempSyntaxIndexKey(id: e.child1, stmts: inout stmts)) />) />
            }
            _ => { return <Result.Ok value=(try self.lowerSyntaxExpr(id: id)) />}
        }
    }

    inout fn tempSyntaxIndexKey(id: ExprId, stmts: inout Array[U64]) -> Result[U64, CompileDiagnostic] {
        val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
        match e.kind {
            SyntaxExprKind.Ident => { return <Result.Ok value=(try self.lowerSyntaxExpr(id: id)) />}
            SyntaxExprKind.IntLit => { return <Result.Ok value=(try self.lowerSyntaxExpr(id: id)) />}
            _ => {
                val value: U64 = (try self.lowerSyntaxExpr(id: id))
                self.cur.lowerTmpSeq += 1U64
                val tmp: Bind = self.internTmpName(prefix: "__ce", n: self.cur.lowerTmpSeq)
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=value />))
                return <Result.Ok value=self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />) />
            }
        }
    }

    inout fn lowerSyntaxPlainAssignInto(stmt: SyntaxStmt, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        val target: U64 = (try self.rebuildSyntaxPlaceTemping(id: stmt.child0, stmts: inout stmts))
        val value: U64 = (try self.lowerSyntaxExpr(id: stmt.child1))
        try self.lowerPlaceAssignInto(target: target, value: value, stmts: inout stmts)
        return <Result.Ok value=() />
    }

    inout fn lowerSyntaxCompoundAssignInto(stmt: SyntaxStmt, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        val target: U64 = (try self.rebuildSyntaxPlaceTemping(id: stmt.child0, stmts: inout stmts))
        val value: U64 = (try self.lowerSyntaxExpr(id: stmt.child1))
        val read: U64 = (try self.loweredPlaceRead(id: target))
        val combined: U64 = self.pushExpr(e: <Expr.Binary op=compoundBinOp(op: stmt.op) lhs=read rhs=value />)
        try self.lowerPlaceAssignInto(target: target, value: combined, stmts: inout stmts)
        return <Result.Ok value=() />
    }

    inout fn astPlaceHasIndex(e: ExprAst) -> Bool {
        match e {
            ExprAst.Index(base: _, index: _, span: _) => { return true }
            ExprAst.Field(val base, name: _, nameSpan: _, span: _) => { return self.astPlaceHasIndex(e: base) }
            ExprAst.Arrow(val base, name: _, nameSpan: _, span: _) => { return self.astPlaceHasIndex(e: base) }
            _ => { return false }
        }
    }

    // Lower a place ExprAst to an IR expr id, binding each side-effecting index key to a
    // fresh temp local (pushed into `stmts`) so the place is evaluated once (spec/12). The
    // returned id is reused for both the read and the write of the desugared compound assign.
    inout fn rebuildPlaceTemping(e: ExprAst, stmts: inout Array[U64]) -> Result[U64, CompileDiagnostic] {
        match e {
            ExprAst.Field(val base, val name, val nameSpan, span: _) => {
                // SOURCE span for the name (see lowerExpr's Field arm).
                val b: U64 = (try self.rebuildPlaceTemping(e: base, stmts: inout stmts))
                return <Result.Ok value=self.pushExpr(e: <Expr.Field base=b nameStart=nameSpan.start nameLen=name.bytes().count() />) />
            }
            ExprAst.Arrow(val base, val name, val nameSpan, span: _) => {
                val b: U64 = (try self.rebuildPlaceTemping(e: base, stmts: inout stmts))
                return <Result.Ok value=self.pushExpr(e: <Expr.Arrow base=b nameStart=nameSpan.start nameLen=name.bytes().count() />) />
            }
            ExprAst.Index(val base, val index, span: _) => {
                val b: U64 = (try self.rebuildPlaceTemping(e: base, stmts: inout stmts))
                val idx: U64 = (try self.tempIndexKey(e: index, stmts: inout stmts))
                return <Result.Ok value=self.pushExpr(e: <Expr.Index base=b index=idx />) />
            }
            _ => {
                // an Ident (or any leaf) — a re-readable place root; lower as-is.
                return <Result.Ok value=(try self.lowerExpr(e: e)) />
            }
        }
    }

    // An index key that might have a side effect (anything but a bare Ident or int literal)
    // is bound to a fresh temp local and returned as an Ident to it, so the key is evaluated
    // exactly once. A literal is kept inline (it needs its index-position type context); an
    // Ident is a pure re-readable local.
    inout fn tempIndexKey(e: ExprAst, stmts: inout Array[U64]) -> Result[U64, CompileDiagnostic] {
        match e {
            ExprAst.Ident(name: _, span: _) => { return <Result.Ok value=(try self.lowerExpr(e: e)) />}
            ExprAst.IntLit(value: _, isBool: _, tySuffix: _, literalSpan: _, tySuffixSpan: _, span: _) => { return <Result.Ok value=(try self.lowerExpr(e: e)) />}
            _ => {
                val iv: U64 = (try self.lowerExpr(e: e))
                self.cur.lowerTmpSeq += 1U64
                val tmp: Bind = self.internTmpName(prefix: "__ce", n: self.cur.lowerTmpSeq)
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=iv />))
                return <Result.Ok value=self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />) />
            }
        }
    }

    // A whole-element index assignment has no remaining place operation after
    // lowering: its specified meaning is the `IndexSet.indexSet` method call.
    // Register a synthetic origin now, while the call is still part of the
    // frontend tree, so Record and Mono share one semantic key.
    inout fn lowerIndexSetAssign(recv: U64, key: U64, value: U64) -> Result[U64, CompileDiagnostic] {
        val call: U64 = self.synthMethodCall(recv: recv, name: "indexSet", arg0Label: "key", arg0: key, arg0HasLabel: true, hasArg1: true, arg1Label: "value", arg1: value, arg1HasLabel: false)
        val originSerial: U64 = self.arena.exprOriginSerial[call]
        try self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=call kind=<SyntheticCallKind.IndexWrite /> originSerial=originSerial receiverTerm=0U64 />)
        return <Result.Ok value=self.pushStmt(s: <Stmt.ExprStmt expr=call />) />
    }

    // SyntaxFile counterpart of the direct statement lowerer. The block path
    // owns compound-assignment, destructuring, and match desugaring; this
    // function deliberately handles only the statement forms that have a
    // one-to-one semantic IR representation.
    inout fn lowerSyntaxStmt(id: StmtId) -> Result[U64, CompileDiagnostic] {
        val s: SyntaxStmt = syntaxStmt(file: self.syntax, id: id)
        match s.kind {
            SyntaxStmtKind.Let => {
                mut val tyStart: U64 = 0U64
                mut val tyLen: U64 = 0U64
                mut val tyIsArray: Bool = false
                mut val tyRef: U64 = 0U64
                if s.flag1 {
                    val ty: PType = (try self.lowerSyntaxType(id: s.type0))
                    tyStart = ty.start
                    tyLen = ty.len
                    tyIsArray = ty.isArray
                    tyRef = ty.ref
                }
                return <Result.Ok value=self.pushStmt(s: <Stmt.Let mutable=s.flag0 nameStart=s.name.start nameLen=s.name.end - s.name.start tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef init=(try self.lowerSyntaxExpr(id: s.child0)) />) />
            }
            SyntaxStmtKind.ExprStmt => { return <Result.Ok value=self.pushStmt(s: <Stmt.ExprStmt expr=(try self.lowerSyntaxExpr(id: s.child0)) />) />}
            SyntaxStmtKind.Return => {
                mut val value: U64 = 0U64
                if s.flag0 { value = (try self.lowerSyntaxExpr(id: s.child0)) }
                return <Result.Ok value=self.pushStmt(s: <Stmt.Return value=value hasValue=s.flag0 offset=s.span.start />) />
            }
            SyntaxStmtKind.IfChain => {
                return <Result.Ok value=self.pushStmt(s: <Stmt.IfChain conditions=(try self.lowerSyntaxConditionClauses(conditions: s.conditions)) thenBlk=(try self.lowerSyntaxBlock(id: s.block0)) elseBlk=(try self.lowerSyntaxBlock(id: s.block1)) />) />
            }
            SyntaxStmtKind.If => {
                mut val elseBlock: U64 = 0U64
                if s.flag0 { elseBlock = (try self.lowerSyntaxBlock(id: s.block1)) }
                return <Result.Ok value=self.pushStmt(s: <Stmt.If cond=(try self.lowerSyntaxExpr(id: s.child0)) thenBlk=(try self.lowerSyntaxBlock(id: s.block0)) elseBlk=elseBlock hasElse=s.flag0 />) />
            }
            SyntaxStmtKind.While => {
                return <Result.Ok value=self.pushStmt(s: <Stmt.While cond=(try self.lowerSyntaxExpr(id: s.child0)) body=(try self.lowerSyntaxBlock(id: s.block0)) />) />
            }
            SyntaxStmtKind.For => { return <Result.Ok value=(try self.lowerSyntaxFor(stmt: s)) />}
            SyntaxStmtKind.Panic => { return <Result.Ok value=self.pushStmt(s: <Stmt.Panic msg=(try self.lowerSyntaxExpr(id: s.child0)) offset=s.span.start />) />}
            SyntaxStmtKind.Give => { return <Result.Ok value=self.pushStmt(s: <Stmt.Give value=(try self.lowerSyntaxExpr(id: s.child0)) />) />}
            SyntaxStmtKind.Break => { return <Result.Ok value=self.pushStmt(s: <Stmt.Break offset=s.span.start />) />}
            SyntaxStmtKind.Continue => { return <Result.Ok value=self.pushStmt(s: <Stmt.Continue offset=s.span.start />) />}
            _ => { panic "compiler bug: SyntaxFile statement desugaring is incomplete" }
        }
    }

    // The SyntaxFile block traversal owns no alternative semantic rules: it
    // only walks the immutable StmtId pool and delegates each one to the
    // shared lowerer counterpart above. Complex statement desugarings are
    // added here before this path becomes the normal loader.
    inout fn lowerSyntaxBlock(id: BlockId) -> Result[U64, CompileDiagnostic] {
        val parent = self.loweringTypeUses
        self.loweringTypeUses = []
        val result = self.lowerSyntaxBlockScoped(id: id)
        val uses = self.loweringTypeUses
        self.loweringTypeUses = parent
        match result {
            Result.Ok(value: val node) => {
                val guardOffset = syntaxBlock(file: self.syntax, id: id).guardElseOffset
                if guardOffset != 0U64 { self.blockExitRequirements[node] = guardOffset - 1U64 }
                if uses.count() != 0U64 { self.blockTypeUses[node] = uses }
            }
            Result.Err(error: _) => {}
        }
        return result
    }

    inout fn lowerSyntaxBlockScoped(id: BlockId) -> Result[U64, CompileDiagnostic] {
        val block: SyntaxBlock = syntaxBlock(file: self.syntax, id: id)
        mut val stmts: Array[U64] = []
        mut val i: U64 = 0U64
        while i < syntaxBlockStmtCount(file: self.syntax, block: block) {
            val stmtId: StmtId = syntaxBlockStmt(file: self.syntax, block: block, index: i)
            val stmt: SyntaxStmt = syntaxStmt(file: self.syntax, id: stmtId)
            match stmt.kind {
                SyntaxStmtKind.Assign => {
                    if stmt.op == opAssign() {
                        try self.lowerSyntaxPlainAssignInto(stmt: stmt, stmts: inout stmts)
                    } else {
                        try self.lowerSyntaxCompoundAssignInto(stmt: stmt, stmts: inout stmts)
                    }
                }
                SyntaxStmtKind.Destructure => { try self.lowerSyntaxDestructureInto(stmt: stmt, stmts: inout stmts) }
                SyntaxStmtKind.Match => { try self.lowerSyntaxMatchStmtInto(stmt: stmt, stmts: inout stmts) }
                _ => { stmts.append((try self.lowerSyntaxStmt(id: stmtId))) }
            }
            i += 1U64
        }
        return <Result.Ok value=self.pushBlock(stmts: stmts) />
    }

    inout fn lowerStmt(s: StmtAst) -> Result[U64, CompileDiagnostic] {
        mut val result: U64 = 0
        match s {
            StmtAst.Let(val mutable, val name, nameSpan: _, val hasTy, val ty, val init, val span) => {
                val nm: Bind = self.internBytes(s: name)
                mut val tyStart: U64 = 0
                mut val tyLen: U64 = 0
                mut val tyIsArray: Bool = false
                mut val tyRef: U64 = 0
                if hasTy {
                    val pt: PType = (try self.lowerType(t: ty))
                    tyStart = pt.start
                    tyLen = pt.len
                    tyIsArray = pt.isArray
                    tyRef = pt.ref
                }
                val iv: U64 = (try self.lowerExpr(e: init))
                result = self.pushStmt(s: <Stmt.Let mutable=mutable nameStart=nm.nameStart nameLen=nm.nameLen tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef init=iv />)
            }
            StmtAst.Assign(val op, val target, val value, val span) => {
                // The block path (lowerBlock) desugars a compound `place OP= v` with
                // place-once temps; this direct path (only reached for a plain top-level
                // assign today) also desugars any compound inline as `place = place OP v`
                // — no place-once temps here, but a temp-free target has none to bind — so
                // NO compound Stmt.Assign ever reaches verify / codegen (single desugar model).
                if op == opAssign() {
                    val v: U64 = (try self.lowerExpr(e: value))
                    match target {
                        ExprAst.Index(val base, val index, span: _) => {
                            result = (try self.lowerIndexSetAssign(recv: (try self.lowerExpr(e: base)), key: (try self.lowerExpr(e: index)), value: v))
                        }
                        _ => {
                            val t: U64 = (try self.lowerExpr(e: target))
                            result = self.pushStmt(s: <Stmt.Assign target=t value=v />)
                        }
                    }
                } else {
                    val t: U64 = (try self.lowerExpr(e: target))
                    val binE: U64 = self.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=t rhs=(try self.lowerExpr(e: value)) />)
                    result = self.pushStmt(s: <Stmt.Assign target=t value=binE />)
                }
            }
            StmtAst.ExprStmt(val expr, val span) => {
                val e: U64 = (try self.lowerExpr(e: expr))
                result = self.pushStmt(s: <Stmt.ExprStmt expr=e />)
            }
            StmtAst.Return(val value, val hasValue, val span) => {
                mut val v: U64 = 0
                if hasValue {
                    v = (try self.lowerExpr(e: value))
                }
                result = self.pushStmt(s: <Stmt.Return value=v hasValue=hasValue offset=span.start />)
            }
            StmtAst.IfChain(val conditions, val thenBlk, val elseBlk, span: _) => {
                result = self.pushStmt(s: <Stmt.IfChain conditions=(try self.lowerConditionClauses(conditions: conditions)) thenBlk=(try self.lowerBlock(b: thenBlk)) elseBlk=(try self.lowerBlock(b: elseBlk)) />)
            }
            StmtAst.If(val cond, val thenBlk, val elseBlk, val hasElse, val span) => {
                val cnd: U64 = (try self.lowerExpr(e: cond))
                val tb: U64 = (try self.lowerBlock(b: thenBlk))
                mut val eb: U64 = 0
                if hasElse {
                    eb = (try self.lowerBlock(b: elseBlk))
                }
                result = self.pushStmt(s: <Stmt.If cond=cnd thenBlk=tb elseBlk=eb hasElse=hasElse />)
            }
            StmtAst.While(val cond, val body, val span) => {
                val cnd: U64 = (try self.lowerExpr(e: cond))
                val bd: U64 = (try self.lowerBlock(b: body))
                result = self.pushStmt(s: <Stmt.While cond=cnd body=bd />)
            }
            StmtAst.For(val varName, varNameSpan: _, val varTy, val hasVarTy, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patType, patTypeSpan: _, val binds, val span) => {
                if isStruct || patType == "__rec__" {
                    val source: U64 = (try self.lowerExpr(e: iter))
                    val loopBody: U64 = (try self.lowerBlock(b: body))
                    mut val pattern: Bind = <Bind nameStart=0U64 nameLen=0U64 fieldStart=0U64 fieldLen=0U64 />
                    if patType != "__rec__" { pattern = self.internBytes(s: patType) }
                    return <Result.Ok value=self.lowerForDestructure(iter: source, body: loopBody, typeStart: pattern.nameStart, typeLen: pattern.nameLen, binds: self.destructureSiteBinds(binds: binds), offset: span.start) />
                }
                mut val vStart: U64 = 0
                mut val vLen: U64 = 0
                if varName.bytes().count() > 0 {
                    val vb: Bind = self.internBytes(s: varName)
                    vStart = vb.nameStart
                    vLen = vb.nameLen
                }
                mut val vtStart: U64 = 0
                mut val vtLen: U64 = 0
                mut val elementRef: U64 = 0U64
                if hasVarTy {
                    val vpt: PType = (try self.lowerType(t: varTy))
                    vtStart = vpt.start
                    vtLen = vpt.len
                    elementRef = vpt.ref
                }
                mut val lo: U64 = (try self.lowerExpr(e: iter))
                if isRange {
                    val hi: U64 = (try self.lowerExpr(e: rangeHi))
                    lo = self.lowerRangeConstruction(low: lo, high: hi, inclusive: inclusive, span: <Span start=exprAstSpan(e: iter).start end=exprAstSpan(e: rangeHi).end />, elementRef: elementRef)
                }
                val bd: U64 = (try self.lowerBlock(b: body))
                mut val pStart: U64 = 0
                mut val pLen: U64 = 0
                if patType.bytes().count() > 0 {
                    val pb: Bind = self.internBytes(s: patType)
                    pStart = pb.nameStart
                    pLen = pb.nameLen
                }
                val bnds: BindRange = self.lowerBinds(binds: binds)
                result = self.pushStmt(s: <Stmt.For varStart=vStart varLen=vLen varTyStart=vtStart varTyLen=vtLen isRange=false inclusive=false iter=lo rangeHi=0U64 body=bd isStruct=isStruct patStart=pStart patLen=pLen binds=bnds />)
            }
            StmtAst.Match(val scrut, val arms, val span) => {
                val sc: U64 = (try self.lowerExpr(e: scrut))
                val ma: MatchArmRange = (try self.lowerMatchArms(arms: arms, isExpr: false))
                result = self.pushStmt(s: <Stmt.Match scrut=sc arms=ma />)
            }
            StmtAst.Panic(val msg, val span) => {
                val m: U64 = (try self.lowerExpr(e: msg))
                result = self.pushStmt(s: <Stmt.Panic msg=m offset=span.start />)
            }
            StmtAst.Give(val value, val span) => {
                val v: U64 = (try self.lowerExpr(e: value))
                result = self.pushStmt(s: <Stmt.Give value=v />)
            }
            StmtAst.Break(val span) => { result = self.pushStmt(s: <Stmt.Break offset=span.start />) }
            StmtAst.Continue(val span) => { result = self.pushStmt(s: <Stmt.Continue offset=span.start />) }
            StmtAst.Destructure(val binds, val typeName, typeNameSpan: _, val init, val span) => {
                // normally expanded by lowerBlock into several statements; reached only if a
                // destructuring appears outside a statement list — lower the initializer as a
                // plain expression statement so the value is still evaluated.
                result = self.pushStmt(s: <Stmt.ExprStmt expr=(try self.lowerExpr(e: init)) />)
            }
        }
        return <Result.Ok value=result />
    }

    // Lower a destructuring statement — the record form `(val x, val y) = init` or the
    // struct form `P { val x } = init` (typeName non-empty) — into a temp binding plus
    // one statement per field, appended to `stmts`: `val __dt1 = init; val x = __dt1.x; …`.
    // A `val` element becomes a Let; a bare (isAssign) element becomes an assignment to
    // the EXISTING `mut val` binding (`x = __dt1.x` — the normal assignment checks give
    // the undeclared / immutable diagnostics, spec/03). The temp's struct is recovered
    // from the initializer (records track their struct like any value), so no annotation
    // is needed. The temp name is UNIQUE per destructure (the same lowerTmpSeq counter
    // the compound-assign `__ce` temps use) — temp hygiene: no reliance on same-name
    // shadowing, no collision with a user local.
    inout fn lowerDestructureInto(binds: Array[BindAst], typeName: String, init: ExprAst, offset: U64, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        self.cur.lowerTmpSeq += 1U64
        val tmp: Bind = self.internTmpName(prefix: "__dt", n: self.cur.lowerTmpSeq)
        val iv: U64 = (try self.lowerExpr(e: init))
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=iv />))
        // the struct form's declared type name — Verify checks it against the
        // initializer's actual type (len 0 = record form, no name to check).
        mut val tyB: Bind = <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
        if typeName.bytes().count() > 0U64 {
            tyB = self.internBytes(s: typeName)
        }
        // record the bind LIST for the completeness check (spec/03: every field bound
        // or discarded, no duplicates) — the desugar below erases it.
        self.decls.destructureSites.append(<DestructureSite initId=iv offset=offset isElem=false typeStart=tyB.nameStart typeLen=tyB.nameLen binds=self.destructureSiteBinds(binds: binds) />)
        mut val bi: U64 = 0
        while bi < binds.count() {
            // a `label: _` discard covers the field without creating a local — the
            // whole record lives in the temp, so the field needs no read at all.
            if binds[bi].name.bytes().count() == 0U64 {
                bi += 1
                continue
            }
            // the synthesized Field points at the SOURCE occurrence of the field name
            // (the explicit label, or the punned bind name — the bytes there ARE the
            // field name), so a typo'd field errors with a precise source span exactly
            // like a hand-written `x.typo`. Only the bound local's name is interned.
            val nameB: Bind = self.internBytes(s: binds[bi].name)
            val recv: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
            val fld: U64 = self.pushExpr(e: <Expr.Field base=recv nameStart=binds[bi].fieldStart nameLen=binds[bi].field.bytes().count() />)
            self.arena.exprSpanStart[recv] = binds[bi].span.start
            self.arena.exprSpanStart[fld] = binds[bi].span.start
            if binds[bi].isAssign {
                val tgt: U64 = self.pushExpr(e: <Expr.Ident start=nameB.nameStart len=nameB.nameLen />)
                self.arena.exprSpanStart[tgt] = binds[bi].span.start
                stmts.append(self.pushStmt(s: <Stmt.Assign target=tgt value=fld />))
            } else {
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=nameB.nameStart nameLen=nameB.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=fld />))
            }
            bi += 1
        }
        return <Result.Ok value=() />
    }

    // The Bind list of a destructure site: bound-local span (len 0 = discard), the
    // field's SOURCE span, and the bind's source offset for diagnostics.
    inout fn destructureSiteBinds(binds: Array[BindAst]) -> BindRange {
        mut val out: Array[Bind] = []
        mut val bi: U64 = 0
        while bi < binds.count() {
            mut val nameStart: U64 = 0
            mut val nameLen: U64 = 0
            if binds[bi].name.bytes().count() > 0U64 {
                val nb: Bind = self.internBytes(s: binds[bi].name)
                nameStart = nb.nameStart
                nameLen = nb.nameLen
            }
            out.append(<Bind nameStart=nameStart nameLen=nameLen fieldStart=binds[bi].fieldStart fieldLen=binds[bi].field.bytes().count() offset=binds[bi].span.start isMutable=binds[bi].isMutable />)
            bi += 1
        }
        return self.pushBinds(binds: out)
    }

    inout fn syntaxDestructureSiteBinds(stmt: SyntaxStmt) -> BindRange {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < syntaxStmtBindCount(file: self.syntax, stmt: stmt) {
            val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxStmtBind(file: self.syntax, stmt: stmt, index: i))
            out.append(<Bind nameStart=bind.name.start nameLen=bind.name.end - bind.name.start fieldStart=bind.field.start fieldLen=bind.field.end - bind.field.start offset=bind.span.start isMutable=bind.isMutable />)
            i += 1U64
        }
        return self.pushBinds(binds: out)
    }

    // SyntaxFile counterpart of destructure lowering. The source bind table
    // carries both the optional local spelling and the authored field spelling,
    // so diagnostic provenance survives without a BindAst/String adapter.
    inout fn lowerSyntaxDestructureInto(stmt: SyntaxStmt, stmts: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        self.cur.lowerTmpSeq += 1U64
        val tmp: Bind = self.internTmpName(prefix: "__dt", n: self.cur.lowerTmpSeq)
        val init: U64 = (try self.lowerSyntaxExpr(id: stmt.child0))
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=init />))
        self.decls.destructureSites.append(<DestructureSite initId=init offset=stmt.span.start isElem=false typeStart=stmt.typeName.start typeLen=stmt.typeName.end - stmt.typeName.start binds=self.syntaxDestructureSiteBinds(stmt: stmt) />)
        mut val i: U64 = 0U64
        while i < syntaxStmtBindCount(file: self.syntax, stmt: stmt) {
            val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxStmtBind(file: self.syntax, stmt: stmt, index: i))
            if bind.name.end > bind.name.start {
                val recv: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
                val field: U64 = self.pushExpr(e: <Expr.Field base=recv nameStart=bind.field.start nameLen=bind.field.end - bind.field.start />)
                self.arena.exprSpanStart[recv] = bind.span.start
                self.arena.exprSpanStart[field] = bind.span.start
                if bind.isAssign {
                    val target: U64 = self.pushExpr(e: <Expr.Ident start=bind.name.start len=bind.name.end - bind.name.start />)
                    self.arena.exprSpanStart[target] = bind.span.start
                    stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=field />))
                } else {
                    stmts.append(self.pushStmt(s: <Stmt.Let mutable=bind.isMutable nameStart=bind.name.start nameLen=bind.name.end - bind.name.start tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=field />))
                }
            }
            i += 1U64
        }
        return <Result.Ok value=() />
    }

    // Both syntax carriers erase record/struct loop patterns at the same
    // boundary. The element owns its value for one iteration; ordinary field
    // lets acquire their own copies and ordinary scope exits release them.
    inout fn lowerForDestructure(iter: U64, body: U64, typeStart: U64, typeLen: U64, binds: BindRange, offset: U64) -> U64 {
        self.cur.lowerTmpSeq += 1U64
        val element: Bind = self.internTmpName(prefix: "__fe", n: self.cur.lowerTmpSeq)
        self.decls.destructureSites.append(<DestructureSite initId=iter offset=offset isElem=true typeStart=typeStart typeLen=typeLen binds=binds />)
        mut val statements: Array[U64] = []
        mut val index: U64 = 0U64
        while index < binds.len {
            val binding: Bind = self.bindAt(binds: binds, index: index)
            if binding.nameLen != 0U64 {
                val receiver: U64 = self.pushExpr(e: <Expr.Ident start=element.nameStart len=element.nameLen />)
                val field: U64 = self.pushExpr(e: <Expr.Field base=receiver nameStart=binding.fieldStart nameLen=binding.fieldLen />)
                self.arena.exprSpanStart[receiver] = binding.offset
                self.arena.exprSpanStart[field] = binding.offset
                statements.append(self.pushStmt(s: <Stmt.Let mutable=binding.isMutable nameStart=binding.nameStart nameLen=binding.nameLen tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=field />))
            }
            index += 1U64
        }
        index = 0U64
        while index < self.blockStmtCount(blkId: body) {
            statements.append(self.blockStmtAt(blkId: body, index: index))
            index += 1U64
        }
        val expanded: U64 = self.pushBlock(stmts: statements)
        return self.pushStmt(s: <Stmt.For varStart=element.nameStart varLen=element.nameLen varTyStart=0U64 varTyLen=0U64 isRange=false inclusive=false iter=iter rangeHi=0U64 body=expanded isStruct=false patStart=0U64 patLen=0U64 binds=<BindRange start=0U64 len=0U64 /> />)
    }

    inout fn lowerSyntaxFor(stmt: SyntaxStmt) -> Result[U64, CompileDiagnostic] {
        if stmt.isRecordPattern || stmt.flag3 {
            val source: U64 = (try self.lowerSyntaxExpr(id: stmt.child0))
            val body: U64 = (try self.lowerSyntaxBlock(id: stmt.block0))
            mut val typeStart: U64 = 0U64
            mut val typeLen: U64 = 0U64
            if !stmt.isRecordPattern {
                typeStart = stmt.typeName.start
                typeLen = stmt.typeName.end - stmt.typeName.start
            }
            return <Result.Ok value=self.lowerForDestructure(iter: source, body: body, typeStart: typeStart, typeLen: typeLen, binds: self.syntaxDestructureSiteBinds(stmt: stmt), offset: stmt.span.start) />
        }
        mut val varTyStart: U64 = 0U64
        mut val varTyLen: U64 = 0U64
        mut val elementRef: U64 = 0U64
        if stmt.flag0 {
            val ty: PType = (try self.lowerSyntaxType(id: stmt.type0))
            varTyStart = ty.start
            varTyLen = ty.len
            elementRef = ty.ref
        }
        mut val iter: U64 = (try self.lowerSyntaxExpr(id: stmt.child0))
        if stmt.flag1 {
            val rangeHi: U64 = (try self.lowerSyntaxExpr(id: stmt.child1))
            val rangeSpan: Span = <Span start=syntaxExpr(file: self.syntax, id: stmt.child0).span.start end=syntaxExpr(file: self.syntax, id: stmt.child1).span.end />
            iter = self.lowerRangeConstruction(low: iter, high: rangeHi, inclusive: stmt.flag2, span: rangeSpan, elementRef: elementRef)
        }
        return <Result.Ok value=self.pushStmt(s: <Stmt.For varStart=stmt.name.start varLen=stmt.name.end - stmt.name.start varTyStart=varTyStart varTyLen=varTyLen isRange=false inclusive=false iter=iter rangeHi=0U64 body=(try self.lowerSyntaxBlock(id: stmt.block0)) isStruct=stmt.flag3 patStart=stmt.typeName.start patLen=stmt.typeName.end - stmt.typeName.start binds=self.syntaxDestructureSiteBinds(stmt: stmt) />) />
    }

    inout fn lowerBlock(b: BlockAst) -> Result[U64, CompileDiagnostic] {
        val parent = self.loweringTypeUses
        self.loweringTypeUses = []
        val result = self.lowerBlockScoped(b: b)
        val uses = self.loweringTypeUses
        self.loweringTypeUses = parent
        match result {
            Result.Ok(value: val node) => {
                if b.guardElseOffset != 0U64 { self.blockExitRequirements[node] = b.guardElseOffset - 1U64 }
                if uses.count() != 0U64 { self.blockTypeUses[node] = uses }
            }
            Result.Err(error: _) => {}
        }
        return result
    }

    inout fn lowerBlockScoped(b: BlockAst) -> Result[U64, CompileDiagnostic] {
        mut val stmts: Array[U64] = []
        mut val i: U64 = 0
        while i < b.stmts.count() {
            // a destructuring statement expands to several arena statements (temp + fields).
            match b.stmts[i] {
                StmtAst.Destructure(val binds, val typeName, typeNameSpan: _, val init, val span) => {
                    try self.lowerDestructureInto(binds: binds, typeName: typeName, init: init, offset: span.start, stmts: inout stmts)
                }
                // a compound assign `place OP= v` expands to the temp bindings for its
                // place's side-effecting index keys plus the desugared `place = place OP v`
                // (place evaluated once, spec/12). A plain `=` falls to lowerStmt below.
                StmtAst.Assign(val op, val target, val value, val span) => {
                    if op == opAssign() {
                        try self.lowerPlainAssignInto(target: target, value: value, stmts: inout stmts)
                    } else {
                        try self.lowerCompoundAssignInto(op: op, target: target, value: value, stmts: inout stmts)
                    }
                }
                _ => {
                    stmts.append((try self.lowerStmt(s: b.stmts[i])))
                }
            }
            i += 1
        }
        return <Result.Ok value=self.pushBlock(stmts: stmts) />
    }
}

// ---- declaration lowering (shared DeclAst value tree -> the compiler arena) ----
//
// Mirrors Parser/Decl.pw's parseStruct/parseEnum arena seeding so the frontend can
// parse nominal declarations through the ONE shared @Plew/Syntax parser (spec/16,
// worklog A). Names are re-interned (codegen reads bytes; the emitted C is
// byte-identical) — struct/enum names never feed `moduleOf` (types are ambient, not
// visibility-gated), so re-interning is sound here. (A *function* declaration name
// does feed moduleOf; that path keeps the original offset — handled when free
// functions move to this lowering.)
