// Part of the lowering pass (root: _.pw): match desugaring (scalar and
// enum) plus statement / block lowering.

// Lower match arms. Each arm's `body` is a Block index (both statement and
// expression position). A value-match arm's block ends in `give`; a diverging arm
// (`=> panic`/`=> return`) is flagged so the backend excludes it from the PHI.

pub impl Comp {
    inout fn lowerMatchArms(arms: Array[MatchArmAst], isExpr: Bool) -> MatchArmRange {
        mut val out: Array[MatchArm] = []
        mut val i: U64 = 0
        while i < arms.count() {
            val arm: MatchArmAst = arms[i]
            // capture arms are desugared by lowerEnumMatchCapture{Into,Expr} before reaching
            // here (the arm body binds the name), so any capture left is a desugar gap.
            if arm.pattern.captureName.bytes().count() > 0 {
                self.errorAt(offset: arm.pattern.span.start, msg: "internal: enum-match capture binding was not desugared")
            }
            val pi: PatInfo = self.lowerPatternInfo(p: arm.pattern)
            val body: U64 = self.lowerBlock(b: arm.body)
            mut val diverge: Bool = false
            if isExpr {
                diverge = armBlockDiverges(b: arm.body)
            }
            out.append(<MatchArm isWildcard=pi.isWildcard enumStart=pi.enumStart enumLen=pi.enumLen variantStart=pi.variantStart variantLen=pi.variantLen binds=pi.binds body=body isStruct=pi.isStruct isDiverge=diverge />)
            i += 1
        }
        return self.pushMatchArms(arms: out)
    }

    inout fn lowerSyntaxPatternInfo(pattern: SyntaxPattern) -> PatInfo {
        if pattern.isWildcard {
            return <PatInfo isWildcard=true enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false />
        }
        mut val binds: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < syntaxPatternBindCount(file: self.syntax, pattern: pattern) {
            val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxPatternBind(file: self.syntax, pattern: pattern, index: i))
            binds.append(<Bind nameStart=bind.name.start nameLen=bind.name.end - bind.name.start fieldStart=bind.field.start fieldLen=bind.field.end - bind.field.start offset=bind.span.start />)
            i += 1U64
        }
        return <PatInfo isWildcard=false enumStart=pattern.typeName.start enumLen=pattern.typeName.end - pattern.typeName.start variantStart=pattern.variant.start variantLen=pattern.variant.end - pattern.variant.start binds=self.pushBinds(binds: binds) isStruct=pattern.isStruct />
    }

    inout fn syntaxArmBlockDiverges(arm: SyntaxMatchArm) -> Bool {
        val block: SyntaxBlock = syntaxBlock(file: self.syntax, id: arm.body)
        val count: U64 = syntaxBlockStmtCount(file: self.syntax, block: block)
        if count == 0U64 { return false }
        return syntaxStmt(file: self.syntax, id: syntaxBlockStmt(file: self.syntax, block: block, index: count - 1U64)).kind != <SyntaxStmtKind.Give />
    }

    // Statement match arms from SyntaxFile share the same semantic MatchArm
    // pool as the value-AST path. Scalar/capture desugaring chooses whether it
    // may call this after preserving its own single-evaluation transformation.
    inout fn lowerSyntaxStmtMatchArms(stmt: SyntaxStmt, isExpr: Bool) -> MatchArmRange {
        mut val out: Array[MatchArm] = []
        mut val i: U64 = 0U64
        while i < syntaxStmtMatchArmCount(file: self.syntax, stmt: stmt) {
            val arm: SyntaxMatchArm = syntaxMatchArm(file: self.syntax, id: syntaxStmtMatchArm(file: self.syntax, stmt: stmt, index: i))
            val pattern: SyntaxPattern = syntaxPattern(file: self.syntax, id: arm.pat)
            if pattern.captureName.end > pattern.captureName.start {
                self.errorAt(offset: pattern.span.start, msg: "internal: enum-match capture binding was not desugared")
            }
            val info: PatInfo = self.lowerSyntaxPatternInfo(pattern: pattern)
            out.append(<MatchArm isWildcard=info.isWildcard enumStart=info.enumStart enumLen=info.enumLen variantStart=info.variantStart variantLen=info.variantLen binds=info.binds body=self.lowerSyntaxBlock(id: arm.body) isStruct=info.isStruct isDiverge=isExpr && self.syntaxArmBlockDiverges(arm: arm) />)
            i += 1U64
        }
        return self.pushMatchArms(arms: out)
    }
}

pub impl Comp {

    // Build a scalar-match arm's condition: `__mtmp == lit` for a literal arm; a wildcard
    // yields hasCond=false (it is the terminal `else`).
    inout fn lowerScalarArmCond(lhsStart: U64, lhsLen: U64, arm: MatchArmAst) -> ScalarCond {
        if arm.pattern.isLiteral {
            return <ScalarCond hasCond=true cond=self.lowerLitEq(lhsStart: lhsStart, lhsLen: lhsLen, lit: arm.pattern.lit) />
        }
        return <ScalarCond hasCond=false cond=0 />
    }
}

pub impl Comp {

    inout fn blockOfStmts(stmts: Array[U64]) -> U64 {
        return self.pushBlock(stmts: stmts)
    }

    inout fn blockOfGive(giveExpr: U64) -> U64 {
        mut val ss: Array[U64] = []
        ss.append(self.pushStmt(s: <Stmt.Give value=giveExpr />))
        return self.blockOfStmts(stmts: ss)
    }

    // `<lhsIdent> == <lit>` as an arena Binary, going through the `==` operator witness.
    inout fn lowerLitEq(lhsStart: U64, lhsLen: U64, lit: ExprAst) -> U64 {
        val lhs: U64 = self.pushExpr(e: <Expr.Ident start=lhsStart len=lhsLen />)
        val rhs: U64 = self.lowerExpr(e: lit)
        return self.pushExpr(e: <Expr.Binary op=opEq() lhs=lhs rhs=rhs />)
    }
}

pub impl Comp {

    // Bind each capture pattern's name to the scrutinee value (held in the local named
    // `srcStart`/`srcLen`), appended to `stmts`. All captures alias the same scrutinee
    // value, so binding them up front makes them visible to every arm's body.
    inout fn bindScalarCapturesInto(arms: Array[MatchArmAst], srcStart: U64, srcLen: U64, stmts: inout Array[U64]) {
        mut val i: U64 = 0
        while i < arms.count() {
            val cn: String = arms[i].pattern.captureName
            if cn.bytes().count() > 0 {
                val cap: Bind = self.internBytes(s: cn)
                val recv: U64 = self.pushExpr(e: <Expr.Ident start=srcStart len=srcLen />)
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=cap.nameStart nameLen=cap.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=recv />))
            }
            i += 1
        }
    }

    // Find the terminal `else` arm of a scalar match: the first wildcard, or (for an
    // exhaustive Bool match) the last arm. Returns arms.count() if none.
    inout fn scalarMatchElseIdx(arms: Array[MatchArmAst]) -> U64 {
        mut val i: U64 = 0
        while i < arms.count() {
            if arms[i].pattern.isWildcard {
                return i
            }
            i += 1
        }
        if litArmsAreBoolExhaustive(arms: arms) {
            return arms.count() - 1U64
        }
        return arms.count()
    }

    // Desugar a statement-position scalar (literal) match into `val __mtmp = scrut` + an
    // if/else chain, appended to `stmts`. A wildcard (or an exhaustive Bool
    // match) supplies the terminal `else`; without one a no-op else is used (a statement
    // match need not yield a value).
    inout fn lowerScalarMatchStmtInto(scrut: ExprAst, arms: Array[MatchArmAst], span: Span, stmts: inout Array[U64]) {
        val tmp: Bind = self.internBytes(s: "__mtmp")
        val sv: U64 = self.lowerExpr(e: scrut)
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=sv />))
        self.bindScalarCapturesInto(arms: arms, srcStart: tmp.nameStart, srcLen: tmp.nameLen, stmts: inout stmts)
        val elseIdx: U64 = self.scalarMatchElseIdx(arms: arms)
        mut val elseBlkId: U64 = 0
        if elseIdx < arms.count() {
            elseBlkId = self.lowerBlock(b: arms[elseIdx].body)
        } else {
            // no terminal else: a literal match can't be structurally exhaustive without a
            // wildcard `_` (spec/11 requires exhaustiveness).
            self.errorAt(offset: span.start, msg: "this `match` must end with a wildcard `_` arm (literal patterns are not exhaustive — spec/11)")
            mut val es: Array[U64] = []
            elseBlkId = self.blockOfStmts(stmts: es)
        }
        mut val headStmt: U64 = 0
        mut val haveHead: Bool = false
        mut val k: U64 = arms.count()
        while k > 0 {
            k -= 1
            if k != elseIdx {
                val sc: ScalarCond = self.lowerScalarArmCond(lhsStart: tmp.nameStart, lhsLen: tmp.nameLen, arm: arms[k])
                if sc.hasCond {
                    val thenBlkId: U64 = self.lowerBlock(b: arms[k].body)
                    val ifStmt: U64 = self.pushStmt(s: <Stmt.If cond=sc.cond thenBlk=thenBlkId elseBlk=elseBlkId hasElse=true />)
                    mut val wrap: Array[U64] = []
                    wrap.append(ifStmt)
                    elseBlkId = self.blockOfStmts(stmts: wrap)
                    headStmt = ifStmt
                    haveHead = true
                }
            }
        }
        if haveHead {
            stmts.append(headStmt)
        } else {
            // no conditional arms (only a wildcard, `match x { _ => body }`):
            // run the else body unconditionally via `if true { else } else {}`.
            mut val empty: Array[U64] = []
            val emptyBlk: U64 = self.blockOfStmts(stmts: empty)
            stmts.append(self.pushStmt(s: <Stmt.If cond=self.pushExpr(e: <Expr.Int value=1 offset=span.start isBool=true tyStart=0 tyLen=0 isNeg=false />) thenBlk=elseBlkId elseBlk=emptyBlk hasElse=true />))
        }
    }

    // Desugar an expression-position scalar (literal) match into a value. A simple `Ident`
    // scrutinee is inlined into each `==` (single-eval is free); any other scrutinee
    // is bound once in a `give`-block wrapper. Returns the arena Expr index.
    inout fn lowerScalarMatchExpr(scrut: ExprAst, arms: Array[MatchArmAst], span: Span) -> U64 {
        mut val scrutIsIdent: Bool = false
        mut val lhsStart: U64 = 0
        mut val lhsLen: U64 = 0
        match scrut {
            ExprAst.Ident(val name, span: _) => {
                val nb: Bind = self.internBytes(s: name)
                lhsStart = nb.nameStart
                lhsLen = nb.nameLen
                scrutIsIdent = true
            }
            _ => {}
        }
        // capture bindings need an enclosing block to bind their names, so force the
        // __mtmp wrapper (not the inline-Ident shortcut) when any arm captures.
        if matchHasCapture(arms: arms) {
            scrutIsIdent = false
        }
        mut val tmp: Bind = self.internBytes(s: "__mtmp")
        if !(scrutIsIdent) {
            lhsStart = tmp.nameStart
            lhsLen = tmp.nameLen
        }
        val elseIdx: U64 = self.scalarMatchElseIdx(arms: arms)
        val haveElse: Bool = elseIdx < arms.count()
        if !(haveElse) {
            self.errorAt(offset: span.start, msg: "a value `match` must end with a wildcard `_` arm (literal patterns are not exhaustive — spec/11)")
        }
        // a value-giving arm's give AST, re-lowered for the dead `else` of the non-Ident
        // wrapper (any value arm has the match's result type).
        mut val valueGive: ExprAst = emptyExpr()
        mut val mi: U64 = 0
        while mi < arms.count() {
            if !(armBlockDiverges(b: arms[mi].body)) {
                valueGive = armGiveExprAst(arm: arms[mi])
            }
            mi += 1
        }
        // build the if/else chain over real arm blocks (each gives or diverges). The else
        // chain begins as the else arm's block; each cond arm wraps the running chain.
        mut val curElseBlk: U64 = 0
        if haveElse {
            curElseBlk = self.lowerBlock(b: arms[elseIdx].body)
        } else {
            mut val es: Array[U64] = []
            es.append(self.pushStmt(s: <Stmt.Give value=self.pushExpr(e: <Expr.Int value=0 offset=span.start isBool=false tyStart=0 tyLen=0 isNeg=false />) />))
            curElseBlk = self.blockOfStmts(stmts: es)
        }
        mut val headExpr: U64 = 0
        mut val haveHead: Bool = false
        mut val k: U64 = arms.count()
        while k > 0 {
            k -= 1
            if k != elseIdx {
                val sc: ScalarCond = self.lowerScalarArmCond(lhsStart: lhsStart, lhsLen: lhsLen, arm: arms[k])
                if sc.hasCond {
                    val thenBlk: U64 = self.lowerBlock(b: arms[k].body)
                    val cond: U64 = sc.cond
                    val ifx: U64 = self.pushExpr(e: <Expr.IfExpr cond=cond thenBlk=thenBlk elseBlk=curElseBlk />)
                    headExpr = ifx
                    haveHead = true
                    curElseBlk = self.blockOfGive(giveExpr: ifx)
                }
            }
        }
        if !(haveHead) {
            headExpr = self.lowerExpr(e: valueGive)
        }
        if scrutIsIdent {
            return headExpr
        }
        // non-Ident scrutinee (or a capture binding): bind it once in a `give`-block
        // wrapper `if true { val __mtmp = scrut; …captures…; give head } else { panic }`.
        // The dead `else` diverges (panic), so genLlvmIfExpr excludes it from the result
        // PHI — no dummy value is needed (and it cannot reference a capture binding).
        val sv: U64 = self.lowerExpr(e: scrut)
        mut val thenStmts: Array[U64] = []
        thenStmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=sv />))
        self.bindScalarCapturesInto(arms: arms, srcStart: tmp.nameStart, srcLen: tmp.nameLen, stmts: inout thenStmts)
        thenStmts.append(self.pushStmt(s: <Stmt.Give value=headExpr />))
        val thenWrap: U64 = self.blockOfStmts(stmts: thenStmts)
        val msg: Bind = self.internBytes(s: "unreachable scalar-match wrapper else")
        val msgE: U64 = self.pushExpr(e: <Expr.Str start=msg.nameStart len=msg.nameLen />)
        mut val elseStmts: Array[U64] = []
        elseStmts.append(self.pushStmt(s: <Stmt.Panic msg=msgE offset=span.start />))
        val elseWrap: U64 = self.blockOfStmts(stmts: elseStmts)
        val trueCond: U64 = self.pushExpr(e: <Expr.Int value=1 offset=span.start isBool=true tyStart=0 tyLen=0 isNeg=false />)
        return self.pushExpr(e: <Expr.IfExpr cond=trueCond thenBlk=thenWrap elseBlk=elseWrap />)
    }

    // Desugar a statement-position enum-dispatch match that has a capture arm
    // (`match e { E.A => …  val rest => … }`, spec/11) into a single-eval scrutinee
    // binding `val __scap = e` plus the same match over `__scap`, where each capture
    // arm's lowered body is prefixed (at the arena level) with `val <name> = __scap`.
    // The arm is a wildcard, so the enum emitter handles it unchanged; the prepended
    // binding makes the captured scrutinee available under the chosen name.
    inout fn lowerEnumMatchCaptureInto(scrut: ExprAst, arms: Array[MatchArmAst], span: Span, stmts: inout Array[U64]) {
        val tmp: Bind = self.internBytes(s: "__scap")
        val sv: U64 = self.lowerExpr(e: scrut)
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=sv />))
        val ma: MatchArmRange = self.lowerCaptureArms(arms: arms, isExpr: false, scapStart: tmp.nameStart, scapLen: tmp.nameLen)
        val scrutId: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        stmts.append(self.pushStmt(s: <Stmt.Match scrut=scrutId arms=ma />))
    }

    // Lower enum-dispatch arms with capture support: each arm's lowered body block gets
    // `val <name> = __scap` prepended for a capture arm. `scapStart`/`scapLen` name the
    // already-bound scrutinee temp. Shared by the statement and expression capture paths.
    inout fn lowerCaptureArms(arms: Array[MatchArmAst], isExpr: Bool, scapStart: U64, scapLen: U64) -> MatchArmRange {
        mut val ma: Array[MatchArm] = []
        mut val i: U64 = 0
        while i < arms.count() {
            val arm: MatchArmAst = arms[i]
            val pi: PatInfo = self.lowerPatternInfo(p: arm.pattern)
            mut val bodyIdx: U64 = self.lowerBlock(b: arm.body)
            mut val diverge: Bool = false
            if isExpr {
                diverge = armBlockDiverges(b: arm.body)
            }
            if arm.pattern.captureName.bytes().count() > 0 {
                val capN: Bind = self.internBytes(s: arm.pattern.captureName)
                val scapId: U64 = self.pushExpr(e: <Expr.Ident start=scapStart len=scapLen />)
                val capLet: U64 = self.pushStmt(s: <Stmt.Let mutable=false nameStart=capN.nameStart nameLen=capN.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=scapId />)
                mut val ns: Array[U64] = []
                ns.append(capLet)
                mut val k: U64 = 0
                while k < self.blockStmtCount(blkId: bodyIdx) {
                    ns.append(self.blockStmtAt(blkId: bodyIdx, index: k))
                    k += 1
                }
                bodyIdx = self.blockOfStmts(stmts: ns)
            }
            ma.append(<MatchArm isWildcard=pi.isWildcard enumStart=pi.enumStart enumLen=pi.enumLen variantStart=pi.variantStart variantLen=pi.variantLen binds=pi.binds body=bodyIdx isStruct=pi.isStruct isDiverge=diverge />)
            i += 1
        }
        return self.pushMatchArms(arms: ma)
    }

    // Desugar a value-position enum-dispatch match with a capture arm into a give-block
    // wrapper: `if true { val __scap = scrut; give (match __scap { … }) } else { panic }`.
    // The dead `else` diverges (panic), so genLlvmIfExpr excludes it from the result PHI
    // — no dummy value is needed. Capture arms bind `val <name> = __scap` (spec/11).
    inout fn lowerEnumMatchCaptureExpr(scrut: ExprAst, arms: Array[MatchArmAst], span: Span) -> U64 {
        val tmp: Bind = self.internBytes(s: "__scap")
        val sv: U64 = self.lowerExpr(e: scrut)
        val ma: MatchArmRange = self.lowerCaptureArms(arms: arms, isExpr: true, scapStart: tmp.nameStart, scapLen: tmp.nameLen)
        val scrutId: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        val matchExpr: U64 = self.pushExpr(e: <Expr.MatchExpr scrut=scrutId arms=ma />)
        mut val thenStmts: Array[U64] = []
        thenStmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=sv />))
        thenStmts.append(self.pushStmt(s: <Stmt.Give value=matchExpr />))
        val thenWrap: U64 = self.blockOfStmts(stmts: thenStmts)
        val msg: Bind = self.internBytes(s: "unreachable capture-match wrapper else")
        val msgE: U64 = self.pushExpr(e: <Expr.Str start=msg.nameStart len=msg.nameLen />)
        mut val elseStmts: Array[U64] = []
        elseStmts.append(self.pushStmt(s: <Stmt.Panic msg=msgE offset=span.start />))
        val elseWrap: U64 = self.blockOfStmts(stmts: elseStmts)
        val trueCond: U64 = self.pushExpr(e: <Expr.Int value=1 offset=span.start isBool=true tyStart=0 tyLen=0 isNeg=false />)
        return self.pushExpr(e: <Expr.IfExpr cond=trueCond thenBlk=thenWrap elseBlk=elseWrap />)
    }

    // Compound assign `place OP= v` desugars to `place = place OP v` (spec/12), evaluating
    // the PLACE ONCE: side-effecting index keys in the place are bound to temp locals first,
    // then the place (read + write) references those temps — so `arr[f()] += v` calls `f()`
    // once, not twice. The OP then rides its operator-trait witness like any binary (the
    // single-source intrinsic-floor path); there is no primitive open-code and no separate
    // compound handling downstream (verify / codegen see only `=`). Ident / Field / Arrow
    // navigations are re-evaluable places (a local read, a GEP), so only Index keys need a
    // temp.
    inout fn lowerCompoundAssignInto(op: I64, target: ExprAst, value: ExprAst, stmts: inout Array[U64]) {
        val pid: U64 = self.rebuildPlaceTemping(e: target, stmts: inout stmts)
        val vid: U64 = self.lowerExpr(e: value)
        val read: U64 = self.loweredPlaceRead(id: pid)
        val binE: U64 = self.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=read rhs=vid />)
        self.lowerPlaceAssignInto(target: pid, value: binE, stmts: inout stmts)
    }

    // Read a lowered place as a value.  Index is source sugar, so this is the
    // only route which turns it into the selected `Index.index` requirement;
    // field/arrow navigation merely preserve their value form around that read.
    inout fn loweredPlaceRead(id: U64) -> U64 {
        match self.arena.exprs[id] {
            Expr.Field(val base, val nameStart, val nameLen) => {
                return self.pushExpr(e: <Expr.Field base=self.loweredPlaceRead(id: base) nameStart=nameStart nameLen=nameLen />)
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                return self.pushExpr(e: <Expr.Arrow base=self.loweredPlaceRead(id: base) nameStart=nameStart nameLen=nameLen />)
            }
            Expr.Index(val base, val index) => {
                return self.lowerIndexRead(recv: self.loweredPlaceRead(id: base), key: index)
            }
            _ => { return id }
        }
    }

    // Whether a place contains a subscript below its outermost navigation.  A
    // nested write cannot borrow that element's storage: `Index` is specified
    // by value-returning `index`/`indexSet` requirements.  It must therefore
    // use get-modify-set: read the immediate base into a mutable local, modify
    // that local, then write it back through the same (already temp-bound) path.
    inout fn loweredPlaceHasIndex(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Index(base: _, index: _) => { return true }
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.loweredPlaceHasIndex(id: base) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { return self.loweredPlaceHasIndex(id: base) }
            _ => { return false }
        }
    }

    // Assign to a lowered place after all source index keys have been bound.
    // This completes get-modify-set recursively, rather than leaving an
    // addressability special case to Mono/LLVM.  The base is evaluated once as
    // a value, held in a mutable local while its child is changed, and then
    // written back through the original IndexSet route.
    inout fn lowerPlaceAssignInto(target: U64, value: U64, stmts: inout Array[U64]) {
        match self.arena.exprs[target] {
            Expr.Index(val base, val index) => {
                if self.loweredPlaceHasIndex(id: base) {
                    self.lowerNestedPlaceAssignInto(target: target, base: base, value: value, stmts: inout stmts)
                } else {
                    stmts.append(self.lowerIndexSetAssign(recv: base, key: index, value: value))
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                if self.loweredPlaceHasIndex(id: base) {
                    self.lowerNestedPlaceAssignInto(target: target, base: base, value: value, stmts: inout stmts)
                } else {
                    stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=value />))
                }
            }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => {
                stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=value />))
            }
            _ => { stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=value />)) }
        }
    }

    inout fn lowerNestedPlaceAssignInto(target: U64, base: U64, value: U64, stmts: inout Array[U64]) {
        self.cur.lowerTmpSeq += 1U64
        val tmp: Bind = self.internTmpName(prefix: "__gm", n: self.cur.lowerTmpSeq)
        val read: U64 = self.loweredPlaceRead(id: base)
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=true nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=read />))
        val tmpId: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        mut val modified: U64 = target
        match self.arena.exprs[target] {
            Expr.Index(base: _, val index) => { modified = self.pushExpr(e: <Expr.Index base=tmpId index=index />) }
            Expr.Field(base: _, val nameStart, val nameLen) => { modified = self.pushExpr(e: <Expr.Field base=tmpId nameStart=nameStart nameLen=nameLen />) }
            _ => {}
        }
        self.lowerPlaceAssignInto(target: modified, value: value, stmts: inout stmts)
        val tmpForWriteback: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        self.lowerPlaceAssignInto(target: base, value: tmpForWriteback, stmts: inout stmts)
    }

    inout fn lowerPlainAssignInto(target: ExprAst, value: ExprAst, stmts: inout Array[U64]) {
        val pid: U64 = self.rebuildPlaceTemping(e: target, stmts: inout stmts)
        val vid: U64 = self.lowerExpr(e: value)
        self.lowerPlaceAssignInto(target: pid, value: vid, stmts: inout stmts)
    }

    // SyntaxFile counterpart of the place rebuild.  It retains the same
    // place-once guarantee as the value-AST lowering: only side-effecting
    // index keys become temporaries, and the resulting lowered place is shared
    // by the read and write sides of a compound assignment.
    inout fn rebuildSyntaxPlaceTemping(id: ExprId, stmts: inout Array[U64]) -> U64 {
        val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
        match e.kind {
            SyntaxExprKind.Field => {
                return self.pushExpr(e: <Expr.Field base=self.rebuildSyntaxPlaceTemping(id: e.child0, stmts: inout stmts) nameStart=e.name.start nameLen=e.name.end - e.name.start />)
            }
            SyntaxExprKind.Arrow => {
                return self.pushExpr(e: <Expr.Arrow base=self.rebuildSyntaxPlaceTemping(id: e.child0, stmts: inout stmts) nameStart=e.name.start nameLen=e.name.end - e.name.start />)
            }
            SyntaxExprKind.Index => {
                return self.pushExpr(e: <Expr.Index base=self.rebuildSyntaxPlaceTemping(id: e.child0, stmts: inout stmts) index=self.tempSyntaxIndexKey(id: e.child1, stmts: inout stmts) />)
            }
            _ => { return self.lowerSyntaxExpr(id: id) }
        }
    }

    inout fn tempSyntaxIndexKey(id: ExprId, stmts: inout Array[U64]) -> U64 {
        val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
        match e.kind {
            SyntaxExprKind.Ident => { return self.lowerSyntaxExpr(id: id) }
            SyntaxExprKind.IntLit => { return self.lowerSyntaxExpr(id: id) }
            _ => {
                val value: U64 = self.lowerSyntaxExpr(id: id)
                self.cur.lowerTmpSeq += 1U64
                val tmp: Bind = self.internTmpName(prefix: "__ce", n: self.cur.lowerTmpSeq)
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=value />))
                return self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
            }
        }
    }

    inout fn lowerSyntaxPlainAssignInto(stmt: SyntaxStmt, stmts: inout Array[U64]) {
        val target: U64 = self.rebuildSyntaxPlaceTemping(id: stmt.child0, stmts: inout stmts)
        val value: U64 = self.lowerSyntaxExpr(id: stmt.child1)
        self.lowerPlaceAssignInto(target: target, value: value, stmts: inout stmts)
    }

    inout fn lowerSyntaxCompoundAssignInto(stmt: SyntaxStmt, stmts: inout Array[U64]) {
        val target: U64 = self.rebuildSyntaxPlaceTemping(id: stmt.child0, stmts: inout stmts)
        val value: U64 = self.lowerSyntaxExpr(id: stmt.child1)
        val read: U64 = self.loweredPlaceRead(id: target)
        val combined: U64 = self.pushExpr(e: <Expr.Binary op=compoundBinOp(op: stmt.op) lhs=read rhs=value />)
        self.lowerPlaceAssignInto(target: target, value: combined, stmts: inout stmts)
    }

    inout fn astPlaceHasIndex(e: ExprAst) -> Bool {
        match e {
            ExprAst.Index(base: _, index: _, span: _) => { return true }
            ExprAst.Field(val base, name: _, nameSpan: _, span: _) => { return self.astPlaceHasIndex(e: base) }
            ExprAst.Arrow(val base, name: _, nameSpan: _, span: _) => { return self.astPlaceHasIndex(e: base) }
            _ => { return false }
        }
    }

    // Lower a place ExprAst to an IR expr id, binding each side-effecting index key to a
    // fresh temp local (pushed into `stmts`) so the place is evaluated once (spec/12). The
    // returned id is reused for both the read and the write of the desugared compound assign.
    inout fn rebuildPlaceTemping(e: ExprAst, stmts: inout Array[U64]) -> U64 {
        match e {
            ExprAst.Field(val base, val name, val nameSpan, span: _) => {
                // SOURCE span for the name (see lowerExpr's Field arm).
                val b: U64 = self.rebuildPlaceTemping(e: base, stmts: inout stmts)
                return self.pushExpr(e: <Expr.Field base=b nameStart=nameSpan.start nameLen=name.bytes().count() />)
            }
            ExprAst.Arrow(val base, val name, val nameSpan, span: _) => {
                val b: U64 = self.rebuildPlaceTemping(e: base, stmts: inout stmts)
                return self.pushExpr(e: <Expr.Arrow base=b nameStart=nameSpan.start nameLen=name.bytes().count() />)
            }
            ExprAst.Index(val base, val index, span: _) => {
                val b: U64 = self.rebuildPlaceTemping(e: base, stmts: inout stmts)
                val idx: U64 = self.tempIndexKey(e: index, stmts: inout stmts)
                return self.pushExpr(e: <Expr.Index base=b index=idx />)
            }
            _ => {
                // an Ident (or any leaf) — a re-readable place root; lower as-is.
                return self.lowerExpr(e: e)
            }
        }
    }

    // An index key that might have a side effect (anything but a bare Ident or int literal)
    // is bound to a fresh temp local and returned as an Ident to it, so the key is evaluated
    // exactly once. A literal is kept inline (it needs its index-position type context); an
    // Ident is a pure re-readable local.
    inout fn tempIndexKey(e: ExprAst, stmts: inout Array[U64]) -> U64 {
        match e {
            ExprAst.Ident(name: _, span: _) => { return self.lowerExpr(e: e) }
            ExprAst.IntLit(value: _, isBool: _, tySuffix: _, literalSpan: _, tySuffixSpan: _, span: _) => { return self.lowerExpr(e: e) }
            _ => {
                val iv: U64 = self.lowerExpr(e: e)
                self.cur.lowerTmpSeq += 1U64
                val tmp: Bind = self.internTmpName(prefix: "__ce", n: self.cur.lowerTmpSeq)
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=iv />))
                return self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
            }
        }
    }

    // A whole-element index assignment has no remaining place operation after
    // lowering: its specified meaning is the `IndexSet.indexSet` method call.
    // Register a synthetic origin now, while the call is still part of the
    // frontend tree, so Record and Mono share one semantic key.
    inout fn lowerIndexSetAssign(recv: U64, key: U64, value: U64) -> U64 {
        val call: U64 = self.synthMethodCall(recv: recv, name: "indexSet", arg0Label: "key", arg0: key, arg0HasLabel: true, hasArg1: true, arg1Label: "value", arg1: value, arg1HasLabel: false)
        val originSerial: U64 = self.arena.exprOriginSerial[call]
        self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=call originSerial=originSerial receiverTerm=0U64 />)
        return self.pushStmt(s: <Stmt.ExprStmt expr=call />)
    }

    // SyntaxFile counterpart of the direct statement lowerer. The block path
    // owns compound-assignment, destructuring, and match desugaring; this
    // function deliberately handles only the statement forms that have a
    // one-to-one semantic IR representation.
    inout fn lowerSyntaxStmt(id: StmtId) -> U64 {
        val s: SyntaxStmt = syntaxStmt(file: self.syntax, id: id)
        match s.kind {
            SyntaxStmtKind.Let => {
                mut val tyStart: U64 = 0U64
                mut val tyLen: U64 = 0U64
                mut val tyIsArray: Bool = false
                mut val tyRef: U64 = 0U64
                if s.flag1 {
                    val ty: PType = self.lowerSyntaxType(id: s.type0)
                    tyStart = ty.start
                    tyLen = ty.len
                    tyIsArray = ty.isArray
                    tyRef = ty.ref
                }
                return self.pushStmt(s: <Stmt.Let mutable=s.flag0 nameStart=s.name.start nameLen=s.name.end - s.name.start tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef init=self.lowerSyntaxExprWithCtx(id: s.child0, ctxRef: tyRef) />)
            }
            SyntaxStmtKind.ExprStmt => { return self.pushStmt(s: <Stmt.ExprStmt expr=self.lowerSyntaxExpr(id: s.child0) />) }
            SyntaxStmtKind.Return => {
                mut val value: U64 = 0U64
                if s.flag0 { value = self.lowerSyntaxExprWithCtx(id: s.child0, ctxRef: self.cur.lowerRetTy) }
                return self.pushStmt(s: <Stmt.Return value=value hasValue=s.flag0 offset=s.span.start />)
            }
            SyntaxStmtKind.If => {
                mut val elseBlock: U64 = 0U64
                if s.flag0 { elseBlock = self.lowerSyntaxBlock(id: s.block1) }
                return self.pushStmt(s: <Stmt.If cond=self.lowerSyntaxExpr(id: s.child0) thenBlk=self.lowerSyntaxBlock(id: s.block0) elseBlk=elseBlock hasElse=s.flag0 />)
            }
            SyntaxStmtKind.While => {
                return self.pushStmt(s: <Stmt.While cond=self.lowerSyntaxExpr(id: s.child0) body=self.lowerSyntaxBlock(id: s.block0) />)
            }
            SyntaxStmtKind.For => { return self.lowerSyntaxFor(stmt: s) }
            SyntaxStmtKind.Panic => { return self.pushStmt(s: <Stmt.Panic msg=self.lowerSyntaxExpr(id: s.child0) offset=s.span.start />) }
            SyntaxStmtKind.Give => { return self.pushStmt(s: <Stmt.Give value=self.lowerSyntaxExpr(id: s.child0) />) }
            SyntaxStmtKind.Break => { return self.pushStmt(s: <Stmt.Break offset=s.span.start />) }
            SyntaxStmtKind.Continue => { return self.pushStmt(s: <Stmt.Continue offset=s.span.start />) }
            _ => { panic "compiler bug: SyntaxFile statement desugaring is incomplete" }
        }
    }

    // The SyntaxFile block traversal owns no alternative semantic rules: it
    // only walks the immutable StmtId pool and delegates each one to the
    // shared lowerer counterpart above. Complex statement desugarings are
    // added here before this path becomes the normal loader.
    inout fn lowerSyntaxBlock(id: BlockId) -> U64 {
        val block: SyntaxBlock = syntaxBlock(file: self.syntax, id: id)
        mut val stmts: Array[U64] = []
        mut val i: U64 = 0U64
        while i < syntaxBlockStmtCount(file: self.syntax, block: block) {
            val stmtId: StmtId = syntaxBlockStmt(file: self.syntax, block: block, index: i)
            val stmt: SyntaxStmt = syntaxStmt(file: self.syntax, id: stmtId)
            match stmt.kind {
                SyntaxStmtKind.Assign => {
                    if stmt.op == opAssign() {
                        self.lowerSyntaxPlainAssignInto(stmt: stmt, stmts: inout stmts)
                    } else {
                        self.lowerSyntaxCompoundAssignInto(stmt: stmt, stmts: inout stmts)
                    }
                }
                SyntaxStmtKind.Destructure => { self.lowerSyntaxDestructureInto(stmt: stmt, stmts: inout stmts) }
                _ => { stmts.append(self.lowerSyntaxStmt(id: stmtId)) }
            }
            i += 1U64
        }
        return self.pushBlock(stmts: stmts)
    }

    inout fn lowerStmt(s: StmtAst) -> U64 {
        mut val result: U64 = 0
        match s {
            StmtAst.Let(val mutable, val name, nameSpan: _, val hasTy, val ty, val init, val span) => {
                val nm: Bind = self.internBytes(s: name)
                mut val tyStart: U64 = 0
                mut val tyLen: U64 = 0
                mut val tyIsArray: Bool = false
                mut val tyRef: U64 = 0
                if hasTy {
                    val pt: PType = self.lowerType(t: ty)
                    tyStart = pt.start
                    tyLen = pt.len
                    tyIsArray = pt.isArray
                    tyRef = pt.ref
                }
                val iv: U64 = self.lowerExprWithCtx(e: init, ctxRef: tyRef)
                result = self.pushStmt(s: <Stmt.Let mutable=mutable nameStart=nm.nameStart nameLen=nm.nameLen tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef init=iv />)
            }
            StmtAst.Assign(val op, val target, val value, val span) => {
                // The block path (lowerBlock) desugars a compound `place OP= v` with
                // place-once temps; this direct path (only reached for a plain top-level
                // assign today) also desugars any compound inline as `place = place OP v`
                // — no place-once temps here, but a temp-free target has none to bind — so
                // NO compound Stmt.Assign ever reaches verify / codegen (single desugar model).
                if op == opAssign() {
                    val v: U64 = self.lowerExpr(e: value)
                    match target {
                        ExprAst.Index(val base, val index, span: _) => {
                            result = self.lowerIndexSetAssign(recv: self.lowerExpr(e: base), key: self.lowerExpr(e: index), value: v)
                        }
                        _ => {
                            val t: U64 = self.lowerExpr(e: target)
                            result = self.pushStmt(s: <Stmt.Assign target=t value=v />)
                        }
                    }
                } else {
                    val t: U64 = self.lowerExpr(e: target)
                    val binE: U64 = self.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=t rhs=self.lowerExpr(e: value) />)
                    result = self.pushStmt(s: <Stmt.Assign target=t value=binE />)
                }
            }
            StmtAst.ExprStmt(val expr, val span) => {
                val e: U64 = self.lowerExpr(e: expr)
                result = self.pushStmt(s: <Stmt.ExprStmt expr=e />)
            }
            StmtAst.Return(val value, val hasValue, val span) => {
                mut val v: U64 = 0
                if hasValue {
                    v = self.lowerExprWithCtx(e: value, ctxRef: self.cur.lowerRetTy)
                }
                result = self.pushStmt(s: <Stmt.Return value=v hasValue=hasValue offset=span.start />)
            }
            StmtAst.If(val cond, val thenBlk, val elseBlk, val hasElse, val span) => {
                val cnd: U64 = self.lowerExpr(e: cond)
                val tb: U64 = self.lowerBlock(b: thenBlk)
                mut val eb: U64 = 0
                if hasElse {
                    eb = self.lowerBlock(b: elseBlk)
                }
                result = self.pushStmt(s: <Stmt.If cond=cnd thenBlk=tb elseBlk=eb hasElse=hasElse />)
            }
            StmtAst.While(val cond, val body, val span) => {
                val cnd: U64 = self.lowerExpr(e: cond)
                val bd: U64 = self.lowerBlock(b: body)
                result = self.pushStmt(s: <Stmt.While cond=cnd body=bd />)
            }
            StmtAst.For(val varName, varNameSpan: _, val varTy, val hasVarTy, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patType, patTypeSpan: _, val binds, val span) => {
                // a record loop pattern `for (val x, val y) in xs` (patType="__rec__"): bind a
                // fresh element local `__fe` and prepend `val x = __fe.field` per bind to the
                // body (the `__fe` local and bound names are interned; an AST synthetic
                // `Ident` reads the source by span). The element's struct is tracked by the
                // for-over-array path.
                if patType == "__rec__" {
                    val fe: Bind = self.internBytes(s: "__fe")
                    val lo2: U64 = self.lowerExpr(e: iter)
                    val inner: U64 = self.lowerBlock(b: body)
                    // completeness check input (spec/03) — isElem: the site's type is
                    // the loop SOURCE's element, not the source itself.
                    self.decls.destructureSites.append(<DestructureSite initId=lo2 offset=span.start isElem=true binds=self.destructureSiteBinds(binds: binds) />)
                    mut val bstmts: Array[U64] = []
                    mut val bi: U64 = 0
                    while bi < binds.count() {
                        // a `label: _` discard covers the field without creating a local.
                        if binds[bi].name.bytes().count() == 0U64 {
                            bi += 1
                            continue
                        }
                        // field name by SOURCE span (see lowerDestructureInto) — precise
                        // typo diagnostics; only the bound local's name is interned.
                        val nameB: Bind = self.internBytes(s: binds[bi].name)
                        val recv: U64 = self.pushExpr(e: <Expr.Ident start=fe.nameStart len=fe.nameLen />)
                        val fld: U64 = self.pushExpr(e: <Expr.Field base=recv nameStart=binds[bi].fieldStart nameLen=binds[bi].field.bytes().count() />)
                        self.arena.exprSpanStart[recv] = binds[bi].span.start
                        self.arena.exprSpanStart[fld] = binds[bi].span.start
                        bstmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=nameB.nameStart nameLen=nameB.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=fld />))
                        bi += 1
                    }
                    mut val ob: U64 = 0
                    while ob < self.blockStmtCount(blkId: inner) {
                        bstmts.append(self.blockStmtAt(blkId: inner, index: ob))
                        ob += 1
                    }
                    val bd2: U64 = self.pushBlock(stmts: bstmts)
                    result = self.pushStmt(s: <Stmt.For varStart=fe.nameStart varLen=fe.nameLen varTyStart=0 varTyLen=0 isRange=false inclusive=false iter=lo2 rangeHi=0 body=bd2 isStruct=false patStart=0 patLen=0 binds=<BindRange start=0U64 len=0U64 /> />)
                    return result
                }
                mut val vStart: U64 = 0
                mut val vLen: U64 = 0
                if varName.bytes().count() > 0 {
                    val vb: Bind = self.internBytes(s: varName)
                    vStart = vb.nameStart
                    vLen = vb.nameLen
                }
                mut val vtStart: U64 = 0
                mut val vtLen: U64 = 0
                if hasVarTy {
                    val vpt: PType = self.lowerType(t: varTy)
                    vtStart = vpt.start
                    vtLen = vpt.len
                }
                val lo: U64 = self.lowerExpr(e: iter)
                mut val hi: U64 = 0
                if isRange {
                    hi = self.lowerExpr(e: rangeHi)
                }
                val bd: U64 = self.lowerBlock(b: body)
                mut val pStart: U64 = 0
                mut val pLen: U64 = 0
                if patType.bytes().count() > 0 {
                    val pb: Bind = self.internBytes(s: patType)
                    pStart = pb.nameStart
                    pLen = pb.nameLen
                }
                val bnds: BindRange = self.lowerBinds(binds: binds)
                result = self.pushStmt(s: <Stmt.For varStart=vStart varLen=vLen varTyStart=vtStart varTyLen=vtLen isRange=isRange inclusive=inclusive iter=lo rangeHi=hi body=bd isStruct=isStruct patStart=pStart patLen=pLen binds=bnds />)
            }
            StmtAst.Match(val scrut, val arms, val span) => {
                val sc: U64 = self.lowerExpr(e: scrut)
                val ma: MatchArmRange = self.lowerMatchArms(arms: arms, isExpr: false)
                result = self.pushStmt(s: <Stmt.Match scrut=sc arms=ma />)
            }
            StmtAst.Panic(val msg, val span) => {
                val m: U64 = self.lowerExpr(e: msg)
                result = self.pushStmt(s: <Stmt.Panic msg=m offset=span.start />)
            }
            StmtAst.Give(val value, val span) => {
                val v: U64 = self.lowerExpr(e: value)
                result = self.pushStmt(s: <Stmt.Give value=v />)
            }
            StmtAst.Break(val span) => { result = self.pushStmt(s: <Stmt.Break offset=span.start />) }
            StmtAst.Continue(val span) => { result = self.pushStmt(s: <Stmt.Continue offset=span.start />) }
            StmtAst.Destructure(val binds, val typeName, typeNameSpan: _, val init, val span) => {
                // normally expanded by lowerBlock into several statements; reached only if a
                // destructuring appears outside a statement list — lower the initializer as a
                // plain expression statement so the value is still evaluated.
                result = self.pushStmt(s: <Stmt.ExprStmt expr=self.lowerExpr(e: init) />)
            }
        }
        return result
    }

    // Lower a destructuring statement — the record form `(val x, val y) = init` or the
    // struct form `P { val x } = init` (typeName non-empty) — into a temp binding plus
    // one statement per field, appended to `stmts`: `val __dt1 = init; val x = __dt1.x; …`.
    // A `val` element becomes a Let; a bare (isAssign) element becomes an assignment to
    // the EXISTING `mut val` binding (`x = __dt1.x` — the normal assignment checks give
    // the undeclared / immutable diagnostics, spec/03). The temp's struct is recovered
    // from the initializer (records track their struct like any value), so no annotation
    // is needed. The temp name is UNIQUE per destructure (the same lowerTmpSeq counter
    // the compound-assign `__ce` temps use) — temp hygiene: no reliance on same-name
    // shadowing, no collision with a user local.
    inout fn lowerDestructureInto(binds: Array[BindAst], typeName: String, init: ExprAst, offset: U64, stmts: inout Array[U64]) {
        self.cur.lowerTmpSeq += 1U64
        val tmp: Bind = self.internTmpName(prefix: "__dt", n: self.cur.lowerTmpSeq)
        val iv: U64 = self.lowerExpr(e: init)
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=iv />))
        // the struct form's declared type name — Verify checks it against the
        // initializer's actual type (len 0 = record form, no name to check).
        mut val tyB: Bind = <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
        if typeName.bytes().count() > 0U64 {
            tyB = self.internBytes(s: typeName)
        }
        // record the bind LIST for the completeness check (spec/03: every field bound
        // or discarded, no duplicates) — the desugar below erases it.
        self.decls.destructureSites.append(<DestructureSite initId=iv offset=offset isElem=false typeStart=tyB.nameStart typeLen=tyB.nameLen binds=self.destructureSiteBinds(binds: binds) />)
        mut val bi: U64 = 0
        while bi < binds.count() {
            // a `label: _` discard covers the field without creating a local — the
            // whole record lives in the temp, so the field needs no read at all.
            if binds[bi].name.bytes().count() == 0U64 {
                bi += 1
                continue
            }
            // the synthesized Field points at the SOURCE occurrence of the field name
            // (the explicit label, or the punned bind name — the bytes there ARE the
            // field name), so a typo'd field errors with a precise source span exactly
            // like a hand-written `x.typo`. Only the bound local's name is interned.
            val nameB: Bind = self.internBytes(s: binds[bi].name)
            val recv: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
            val fld: U64 = self.pushExpr(e: <Expr.Field base=recv nameStart=binds[bi].fieldStart nameLen=binds[bi].field.bytes().count() />)
            self.arena.exprSpanStart[recv] = binds[bi].span.start
            self.arena.exprSpanStart[fld] = binds[bi].span.start
            if binds[bi].isAssign {
                val tgt: U64 = self.pushExpr(e: <Expr.Ident start=nameB.nameStart len=nameB.nameLen />)
                self.arena.exprSpanStart[tgt] = binds[bi].span.start
                stmts.append(self.pushStmt(s: <Stmt.Assign target=tgt value=fld />))
            } else {
                stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=nameB.nameStart nameLen=nameB.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=fld />))
            }
            bi += 1
        }
    }

    // The Bind list of a destructure site: bound-local span (len 0 = discard), the
    // field's SOURCE span, and the bind's source offset for diagnostics.
    inout fn destructureSiteBinds(binds: Array[BindAst]) -> BindRange {
        mut val out: Array[Bind] = []
        mut val bi: U64 = 0
        while bi < binds.count() {
            mut val nameStart: U64 = 0
            mut val nameLen: U64 = 0
            if binds[bi].name.bytes().count() > 0U64 {
                val nb: Bind = self.internBytes(s: binds[bi].name)
                nameStart = nb.nameStart
                nameLen = nb.nameLen
            }
            out.append(<Bind nameStart=nameStart nameLen=nameLen fieldStart=binds[bi].fieldStart fieldLen=binds[bi].field.bytes().count() offset=binds[bi].span.start />)
            bi += 1
        }
        return self.pushBinds(binds: out)
    }

    inout fn syntaxDestructureSiteBinds(stmt: SyntaxStmt) -> BindRange {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < syntaxStmtBindCount(file: self.syntax, stmt: stmt) {
            val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxStmtBind(file: self.syntax, stmt: stmt, index: i))
            out.append(<Bind nameStart=bind.name.start nameLen=bind.name.end - bind.name.start fieldStart=bind.field.start fieldLen=bind.field.end - bind.field.start offset=bind.span.start />)
            i += 1U64
        }
        return self.pushBinds(binds: out)
    }

    // SyntaxFile counterpart of destructure lowering. The source bind table
    // carries both the optional local spelling and the authored field spelling,
    // so diagnostic provenance survives without a BindAst/String adapter.
    inout fn lowerSyntaxDestructureInto(stmt: SyntaxStmt, stmts: inout Array[U64]) {
        self.cur.lowerTmpSeq += 1U64
        val tmp: Bind = self.internTmpName(prefix: "__dt", n: self.cur.lowerTmpSeq)
        val init: U64 = self.lowerSyntaxExpr(id: stmt.child0)
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=init />))
        self.decls.destructureSites.append(<DestructureSite initId=init offset=stmt.span.start isElem=false typeStart=stmt.typeName.start typeLen=stmt.typeName.end - stmt.typeName.start binds=self.syntaxDestructureSiteBinds(stmt: stmt) />)
        mut val i: U64 = 0U64
        while i < syntaxStmtBindCount(file: self.syntax, stmt: stmt) {
            val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxStmtBind(file: self.syntax, stmt: stmt, index: i))
            if bind.name.end > bind.name.start {
                val recv: U64 = self.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
                val field: U64 = self.pushExpr(e: <Expr.Field base=recv nameStart=bind.field.start nameLen=bind.field.end - bind.field.start />)
                self.arena.exprSpanStart[recv] = bind.span.start
                self.arena.exprSpanStart[field] = bind.span.start
                if bind.isAssign {
                    val target: U64 = self.pushExpr(e: <Expr.Ident start=bind.name.start len=bind.name.end - bind.name.start />)
                    self.arena.exprSpanStart[target] = bind.span.start
                    stmts.append(self.pushStmt(s: <Stmt.Assign target=target value=field />))
                } else {
                    stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=bind.name.start nameLen=bind.name.end - bind.name.start tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=field />))
                }
            }
            i += 1U64
        }
    }

    inout fn lowerSyntaxFor(stmt: SyntaxStmt) -> U64 {
        if stmt.isRecordPattern {
            val element: Bind = self.internBytes(s: "__fe")
            val iter: U64 = self.lowerSyntaxExpr(id: stmt.child0)
            val body: U64 = self.lowerSyntaxBlock(id: stmt.block0)
            self.decls.destructureSites.append(<DestructureSite initId=iter offset=stmt.span.start isElem=true binds=self.syntaxDestructureSiteBinds(stmt: stmt) />)
            mut val stmts: Array[U64] = []
            mut val i: U64 = 0U64
            while i < syntaxStmtBindCount(file: self.syntax, stmt: stmt) {
                val bind: SyntaxBind = syntaxBind(file: self.syntax, id: syntaxStmtBind(file: self.syntax, stmt: stmt, index: i))
                if bind.name.end > bind.name.start {
                    val recv: U64 = self.pushExpr(e: <Expr.Ident start=element.nameStart len=element.nameLen />)
                    val field: U64 = self.pushExpr(e: <Expr.Field base=recv nameStart=bind.field.start nameLen=bind.field.end - bind.field.start />)
                    self.arena.exprSpanStart[recv] = bind.span.start
                    self.arena.exprSpanStart[field] = bind.span.start
                    stmts.append(self.pushStmt(s: <Stmt.Let mutable=false nameStart=bind.name.start nameLen=bind.name.end - bind.name.start tyStart=0U64 tyLen=0U64 tyIsArray=false ty=0U64 init=field />))
                }
                i += 1U64
            }
            i = 0U64
            while i < self.blockStmtCount(blkId: body) {
                stmts.append(self.blockStmtAt(blkId: body, index: i))
                i += 1U64
            }
            val expandedBody: U64 = self.pushBlock(stmts: stmts)
            return self.pushStmt(s: <Stmt.For varStart=element.nameStart varLen=element.nameLen varTyStart=0U64 varTyLen=0U64 isRange=false inclusive=false iter=iter rangeHi=0U64 body=expandedBody isStruct=false patStart=0U64 patLen=0U64 binds=<BindRange start=0U64 len=0U64 /> />)
        }
        mut val varTyStart: U64 = 0U64
        mut val varTyLen: U64 = 0U64
        if stmt.flag0 {
            val ty: PType = self.lowerSyntaxType(id: stmt.type0)
            varTyStart = ty.start
            varTyLen = ty.len
        }
        mut val rangeHi: U64 = 0U64
        if stmt.flag1 { rangeHi = self.lowerSyntaxExpr(id: stmt.child1) }
        return self.pushStmt(s: <Stmt.For varStart=stmt.name.start varLen=stmt.name.end - stmt.name.start varTyStart=varTyStart varTyLen=varTyLen isRange=stmt.flag1 inclusive=stmt.flag2 iter=self.lowerSyntaxExpr(id: stmt.child0) rangeHi=rangeHi body=self.lowerSyntaxBlock(id: stmt.block0) isStruct=stmt.flag3 patStart=stmt.typeName.start patLen=stmt.typeName.end - stmt.typeName.start binds=self.syntaxDestructureSiteBinds(stmt: stmt) />)
    }

    inout fn lowerBlock(b: BlockAst) -> U64 {
        mut val stmts: Array[U64] = []
        mut val i: U64 = 0
        while i < b.stmts.count() {
            // a destructuring statement expands to several arena statements (temp + fields).
            match b.stmts[i] {
                StmtAst.Destructure(val binds, val typeName, typeNameSpan: _, val init, val span) => {
                    self.lowerDestructureInto(binds: binds, typeName: typeName, init: init, offset: span.start, stmts: inout stmts)
                }
                // a compound assign `place OP= v` expands to the temp bindings for its
                // place's side-effecting index keys plus the desugared `place = place OP v`
                // (place evaluated once, spec/12). A plain `=` falls to lowerStmt below.
                StmtAst.Assign(val op, val target, val value, val span) => {
                    if op == opAssign() {
                        self.lowerPlainAssignInto(target: target, value: value, stmts: inout stmts)
                    } else {
                        self.lowerCompoundAssignInto(op: op, target: target, value: value, stmts: inout stmts)
                    }
                }
                StmtAst.Match(val scrut, val arms, val span) => {
                    if matchHasEnumOrStruct(arms: arms) {
                        if matchHasCapture(arms: arms) {
                            self.lowerEnumMatchCaptureInto(scrut: scrut, arms: arms, span: span, stmts: inout stmts)
                        } else {
                            stmts.append(self.lowerStmt(s: b.stmts[i]))
                        }
                    } else {
                        self.lowerScalarMatchStmtInto(scrut: scrut, arms: arms, span: span, stmts: inout stmts)
                    }
                }
                _ => {
                    stmts.append(self.lowerStmt(s: b.stmts[i]))
                }
            }
            i += 1
        }
        return self.pushBlock(stmts: stmts)
    }
}

// ---- declaration lowering (shared DeclAst value tree -> the compiler arena) ----
//
// Mirrors Parser/Decl.pw's parseStruct/parseEnum arena seeding so the frontend can
// parse nominal declarations through the ONE shared @Plew/Syntax parser (spec/16,
// worklog A). Names are re-interned (codegen reads bytes; the emitted C is
// byte-identical) — struct/enum names never feed `moduleOf` (types are ambient, not
// visibility-gated), so re-interning is sound here. (A *function* declaration name
// does feed moduleOf; that path keeps the original offset — handled when free
// functions move to this lowering.)
