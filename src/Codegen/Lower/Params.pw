// Part of the lowering pass (root: _.pw): parameter and pattern-binding
// lowering.

pub impl Comp {
    inout fn lowerParams(params: Array[ParamAst]) -> Result[Array[Param], CompileDiagnostic] {
        mut val out: Array[Param] = []
        mut val i: U64 = 0
        while i < params.count() {
            val p: ParamAst = params[i]
            val nm: Bind = self.internBytes(s: p.name)
            mut val hasType: Bool = false
            mut val ty: PType = <PType start=0U64 len=0U64 isArray=false ref=0U64 />
            // a record type has an empty `name` (its fields ride in args/argLabels), so gate
            // on isRecord too — else a record-typed param keeps no type and `p.field` fails.
            if p.ty.name.bytes().count() > 0 || p.ty.isRecord {
                ty = (try self.lowerType(t: p.ty))
                hasType = true
            }
            // a default argument `name: T = expr` (spec/04). Closures never carry one
            // (hasDefault is always false there), so this is a no-op for closure params.
            mut val hasDefault: Bool = false
            mut val defaultExpr: U64 = 0
            if p.hasDefault {
                defaultExpr = (try self.lowerExprWithCtx(e: p.defaultVal, ctxRef: ty.ref))
                hasDefault = true
            }
            out.append(self.appendLoweredParam(name: nm, hasType: hasType, ty: ty, isInout: p.isInout, isMove: p.isMove, isBorrow: p.isBorrow, noLabel: p.noLabel, hasDefault: hasDefault, defaultExpr: defaultExpr))
            i += 1
        }
        return <Result.Ok value=out />
    }

    // SyntaxFile counterpart of lowerParams.  A parameter's default remains an
    // expression ID until the semantic lowerer consumes it; no ParamAst or
    // String is reconstructed from the immutable syntax arena.
    inout fn lowerSyntaxExprParams(expr: SyntaxExpr) -> Result[Array[Param], CompileDiagnostic] {
        mut val out: Array[Param] = []
        mut val i: U64 = 0U64
        while i < syntaxExprParamCount(file: self.syntax, expr: expr) {
            val p: SyntaxParam = syntaxParam(file: self.syntax, id: syntaxExprParam(file: self.syntax, expr: expr, index: i))
            mut val hasType: Bool = false
            mut val ty: PType = <PType start=0U64 len=0U64 isArray=false ref=0U64 />
            val syntaxTy: SyntaxType = syntaxType(file: self.syntax, id: p.ty)
            if syntaxTy.name.end > syntaxTy.name.start || syntaxTy.isRecord {
                ty = (try self.lowerSyntaxType(id: p.ty))
                hasType = true
            }
            mut val hasDefault: Bool = false
            mut val defaultExpr: U64 = 0U64
            if p.hasDefault {
                defaultExpr = (try self.lowerSyntaxExprWithCtx(id: p.defaultVal, ctxRef: ty.ref))
                hasDefault = true
            }
            val name: Bind = <Bind nameStart=p.name.start nameLen=p.name.end - p.name.start fieldStart=p.name.start fieldLen=p.name.end - p.name.start />
            out.append(self.appendLoweredParam(name: name, hasType: hasType, ty: ty, isInout: p.isInout, isMove: p.isMove, isBorrow: p.isBorrow, noLabel: p.noLabel, hasDefault: hasDefault, defaultExpr: defaultExpr))
            i += 1U64
        }
        return <Result.Ok value=out />
    }

    // Both value-AST and SyntaxFile parameter decoders end here.  Keeping the
    // IR construction together prevents a new input representation from
    // drifting in mode, label, or default-argument semantics.
    inout fn appendLoweredParam(name: Bind, hasType: Bool, ty: PType, isInout: Bool, isMove: Bool, isBorrow: Bool, noLabel: Bool, hasDefault: Bool, defaultExpr: U64) -> Param {
        mut val tyStart: U64 = 0U64
        mut val tyLen: U64 = 0U64
        mut val tyIsArray: Bool = false
        mut val tyRef: U64 = 0U64
        if hasType {
            tyStart = ty.start
            tyLen = ty.len
            tyIsArray = ty.isArray
            tyRef = ty.ref
        }
        return <Param nameStart=name.nameStart nameLen=name.nameLen nameId=intern(c: inout self, start: name.nameStart, len: name.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isInout=isInout isMove=isMove isBorrow=isBorrow noLabel=noLabel hasDefault=hasDefault defaultExpr=defaultExpr />
    }

    inout fn lowerBinds(binds: Array[BindAst]) -> BindRange {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0
        while i < binds.count() {
            val b: BindAst = binds[i]
            val nm: Bind = self.internBytes(s: b.name)
            val fd: Bind = self.internBytes(s: b.field)
            out.append(<Bind nameStart=nm.nameStart nameLen=nm.nameLen nameId=nm.nameId fieldStart=fd.nameStart fieldLen=fd.nameLen offset=b.span.start isMutable=b.isMutable />)
            i += 1
        }
        return self.pushBinds(binds: out)
    }

    // Lower a pattern into the arena MatchArm fields (minus the body).
    inout fn patternTypePathHead(names: Array[Span], isStruct: Bool) -> Result[U64, CompileDiagnostic] {
        val head = (try self.typePathHead(names: names))
        mut val expected = head + 1U64
        if !isStruct { expected += 1U64 }
        if expected != names.count() {
            return <Result.Err error=self.diagnosticAt(offset: names[0U64].start, msg: "invalid qualified pattern path") />
        }
        return <Result.Ok value=head />
    }

    inout fn lowerPatternInfo(p: PatternAst) -> Result[PatInfo, CompileDiagnostic] {
        if p.isValuePattern { return <Result.Ok value=<PatInfo isValuePattern=true valueExpr=(try self.lowerExpr(e: p.lit)) isWildcard=false enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false /> /> }
        if p.isWildcard {
            val capture = self.lowerTypeName(name: p.captureName, span: p.captureNameSpan)
            return <Result.Ok value=<PatInfo captureStart=capture.nameStart captureLen=capture.nameLen captureMutable=p.captureMutable isWildcard=true enumStart=0 enumLen=0 variantStart=0 variantLen=0 binds=<BindRange start=0U64 len=0U64 /> isStruct=false /> />
        }
        if p.isRecord {
            return <Result.Ok value=<PatInfo isWildcard=false enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=self.lowerBinds(binds: p.binds) isStruct=true /> />
        }
        mut val names: Array[Span] = []
        if p.typePath.count() != 0U64 {
            mut val i = 0U64
            while i < p.typePath.count() {
                val segment = p.typePath[i]
                val name = self.lowerTypeName(name: segment.name, span: segment.nameSpan)
                names.append(<Span start=name.nameStart end=name.nameStart + name.nameLen />)
                i += 1U64
            }
        } else {
            val name = self.lowerTypeName(name: p.typeName, span: p.typeNameSpan)
            names.append(<Span start=name.nameStart end=name.nameStart + name.nameLen />)
            if !p.isStruct {
                val variant = self.lowerTypeName(name: p.variant, span: p.variantSpan)
                names.append(<Span start=variant.nameStart end=variant.nameStart + variant.nameLen />)
            }
        }
        val head = (try self.patternTypePathHead(names: names, isStruct: p.isStruct))
        val name = names[head]
        mut val variant = <Span start=0U64 end=0U64 />
        if !p.isStruct { variant = names[head + 1U64] }
        return <Result.Ok value=<PatInfo isWildcard=false enumStart=name.start enumLen=name.end - name.start variantStart=variant.start variantLen=variant.end - variant.start binds=self.lowerBinds(binds: p.binds) isStruct=p.isStruct /> />
    }
}
