// Part of the lowering pass (root: _.pw): impl-member, impl, and trait
// lowering.

// Lower a method / assoc-fn member of an impl block. Mirrors parseFuncCommon for
// the impl-member case: a witnessed requirement signature (for a trait impl, body-
// less, before the body), then either a `via` alias (no body/func) or the real
// method appended to c.arena.funcs with its `where`-bounds (method-own then impl-level).
// `recvN` is the (re-interned) receiver type name; `implParamBinds` the impl's `[T]`.
// Append the associated-type binders of the trait named by `nameId` (if such a trait is
// loaded) to `scope`. Associated types (`type Item`) are binders, not module-scoped types,
// so a method/req signature naming one (`-> Optional[Item]`) must skip it in the type-
// visibility walk (siteOffset 0). Used to seed an impl/extension's lowering-time skip scope.

pub impl Comp {
    // This is the sole source-spelling classification point for the bundled
    // runtime ABI. After lowering, callers see only Func.runtimeIntrinsic.
    // User declarations named write/eprint cannot enter this branch because
    // their declaration module is not the bundled Io module.
    inout fn runtimeIntrinsicDeclaration(sig: SigAst, isExtern: Bool, isCExtern: Bool) -> RuntimeIntrinsicDeclaration {
        if !(isExtern) || isCExtern {
            return <RuntimeIntrinsicDeclaration.None />
        }
        val nameStart: U64 = sig.nameSpan.start
        val nameLen: U64 = sig.nameSpan.end - sig.nameSpan.start
        val owner: U64 = self.moduleOf(offset: sig.nameSpan.start)
        if owner == self.modules.ioModule {
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "write") {
                return <RuntimeIntrinsicDeclaration.Bound intrinsic=<RuntimeIntrinsic.Write /> />
            }
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "eprint") {
                return <RuntimeIntrinsicDeclaration.Bound intrinsic=<RuntimeIntrinsic.Eprint /> />
            }
        }
        if owner == self.modules.processModule {
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "argCount") { return <RuntimeIntrinsicDeclaration.Bound intrinsic=<RuntimeIntrinsic.ArgCount /> /> }
        }
        if owner == self.modules.coreModule {
            mut val numeric: NumericIntrinsic = <NumericIntrinsic.Bool operation=<BoolOperation.Not /> />
            if self.classifyCoreNumericIntrinsic(nameStart: nameStart, nameLen: nameLen, intrinsic: inout numeric) {
                return <RuntimeIntrinsicDeclaration.Bound intrinsic=<RuntimeIntrinsic.Numeric intrinsic=numeric /> />
            }
            mut val buffer: BufferIntrinsic = <BufferIntrinsic.New />
            if self.classifyCoreBufferIntrinsic(nameStart: nameStart, nameLen: nameLen, intrinsic: inout buffer) {
                return <RuntimeIntrinsicDeclaration.Bound intrinsic=<RuntimeIntrinsic.Buffer intrinsic=buffer /> />
            }
        }
        return <RuntimeIntrinsicDeclaration.None />
    }

    // Core is the sole declaration owner of the primitive numeric ABI.  This
    // is intentionally a parser over the *declaration spelling* only: it runs
    // once during frontend lowering and never becomes a backend fallback.
    inout fn classifyCoreNumericIntrinsic(nameStart: U64, nameLen: U64, intrinsic: inout NumericIntrinsic) -> Bool {
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "boolNot") {
            intrinsic = <NumericIntrinsic.Bool operation=<BoolOperation.Not /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "boolEq") {
            intrinsic = <NumericIntrinsic.Bool operation=<BoolOperation.Eq /> />
            return true
        }
        if self.classifyCoreFloatIntrinsic(nameStart: nameStart, nameLen: nameLen, intrinsic: inout intrinsic) { return true }
        return self.classifyCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, intrinsic: inout intrinsic)
    }

    inout fn classifyCoreBufferIntrinsic(nameStart: U64, nameLen: U64, intrinsic: inout BufferIntrinsic) -> Bool {
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferNew") { intrinsic = <BufferIntrinsic.New /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferCount") { intrinsic = <BufferIntrinsic.Count /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferCapacity") { intrinsic = <BufferIntrinsic.Capacity /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferReserve") { intrinsic = <BufferIntrinsic.Reserve /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferAppend") { intrinsic = <BufferIntrinsic.Append /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferInsertAt") { intrinsic = <BufferIntrinsic.InsertAt /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferGet") { intrinsic = <BufferIntrinsic.Get /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferSet") { intrinsic = <BufferIntrinsic.Set /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferRemoveLast") { intrinsic = <BufferIntrinsic.RemoveLast /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferRemoveAt") { intrinsic = <BufferIntrinsic.RemoveAt /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferSwapRemove") { intrinsic = <BufferIntrinsic.SwapRemove /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferClear") { intrinsic = <BufferIntrinsic.Clear /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferTruncate") { intrinsic = <BufferIntrinsic.Truncate /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferEq") { intrinsic = <BufferIntrinsic.Eq /> return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "bufferBytewiseComparable") { intrinsic = <BufferIntrinsic.BytewiseComparable /> return true }
        return false
    }

    inout fn classifyCoreFloatIntrinsic(nameStart: U64, nameLen: U64, intrinsic: inout NumericIntrinsic) -> Bool {
        mut val width: FloatWidth = <FloatWidth.W32 />
        if nameLen > 3U64 && rangeEquals(bytes: self.arena.bytes, start: nameStart, len: 3U64, kw: "f32") {
            width = <FloatWidth.W32 />
        } else {
            if nameLen > 3U64 && rangeEquals(bytes: self.arena.bytes, start: nameStart, len: 3U64, kw: "f64") {
                width = <FloatWidth.W64 />
            } else {
                return false
            }
        }
        val suffixStart: U64 = nameStart + 3U64
        val suffixLen: U64 = nameLen - 3U64
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Add") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Add /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Sub") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Sub /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Mul") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Mul /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Div") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Div /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Neg") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Neg /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Eq") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Eq /> />
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: suffixStart, len: suffixLen, kw: "Lt") {
            intrinsic = <NumericIntrinsic.Float width=width operation=<FloatOperation.Lt /> />
            return true
        }
        return false
    }

    inout fn coreIntegerPrefixBeforeSuffix(nameStart: U64, nameLen: U64, suffix: String) -> U64 {
        val suffixLen: U64 = suffix.bytes().count()
        if nameLen <= suffixLen { return 8U64 }
        if !(rangeEquals(bytes: self.arena.bytes, start: nameStart + nameLen - suffixLen, len: suffixLen, kw: suffix)) { return 8U64 }
        val prefixLen: U64 = nameLen - suffixLen
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "i8") { return 0U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "i16") { return 1U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "i32") { return 2U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "i64") { return 3U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "u8") { return 4U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "u16") { return 5U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "u32") { return 6U64 }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: prefixLen, kw: "u64") { return 7U64 }
        return 8U64
    }

    inout fn setCoreIntegerIntrinsic(code: U64, operation: IntegerOperation, overflow: NumericOverflow, intrinsic: inout NumericIntrinsic) {
        val unsigned: Bool = code >= 4U64
        if code % 4U64 == 0U64 {
            intrinsic = <NumericIntrinsic.Integer width=<NumericWidth.W8 /> unsigned=unsigned operation=operation overflow=overflow />
            return
        }
        if code % 4U64 == 1U64 {
            intrinsic = <NumericIntrinsic.Integer width=<NumericWidth.W16 /> unsigned=unsigned operation=operation overflow=overflow />
            return
        }
        if code % 4U64 == 2U64 {
            intrinsic = <NumericIntrinsic.Integer width=<NumericWidth.W32 /> unsigned=unsigned operation=operation overflow=overflow />
            return
        }
        intrinsic = <NumericIntrinsic.Integer width=<NumericWidth.W64 /> unsigned=unsigned operation=operation overflow=overflow />
    }

    inout fn trySetCoreIntegerIntrinsic(nameStart: U64, nameLen: U64, suffix: String, operation: IntegerOperation, overflow: NumericOverflow, intrinsic: inout NumericIntrinsic) -> Bool {
        val code: U64 = self.coreIntegerPrefixBeforeSuffix(nameStart: nameStart, nameLen: nameLen, suffix: suffix)
        if code >= 8U64 { return false }
        self.setCoreIntegerIntrinsic(code: code, operation: operation, overflow: overflow, intrinsic: inout intrinsic)
        return true
    }

    inout fn classifyCoreIntegerIntrinsic(nameStart: U64, nameLen: U64, intrinsic: inout NumericIntrinsic) -> Bool {
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "WrapNeg", operation: <IntegerOperation.Neg />, overflow: <NumericOverflow.Wrapping />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "WrapAdd", operation: <IntegerOperation.Add />, overflow: <NumericOverflow.Wrapping />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "WrapSub", operation: <IntegerOperation.Sub />, overflow: <NumericOverflow.Wrapping />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "WrapMul", operation: <IntegerOperation.Mul />, overflow: <NumericOverflow.Wrapping />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Neg", operation: <IntegerOperation.Neg />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "BitNot", operation: <IntegerOperation.BitNot />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Add", operation: <IntegerOperation.Add />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Sub", operation: <IntegerOperation.Sub />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Mul", operation: <IntegerOperation.Mul />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Div", operation: <IntegerOperation.Div />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Rem", operation: <IntegerOperation.Rem />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "BitAnd", operation: <IntegerOperation.BitAnd />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "BitOr", operation: <IntegerOperation.BitOr />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "BitXor", operation: <IntegerOperation.BitXor />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Shl", operation: <IntegerOperation.Shl />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Shr", operation: <IntegerOperation.Shr />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Eq", operation: <IntegerOperation.Eq />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        if self.trySetCoreIntegerIntrinsic(nameStart: nameStart, nameLen: nameLen, suffix: "Lt", operation: <IntegerOperation.Lt />, overflow: <NumericOverflow.Checked />, intrinsic: inout intrinsic) { return true }
        return false
    }

    // Phase 1 of declaration lowering: reserve every trait declaration identity
    // before lowering any implementation.  A trait use in an entry module may
    // name a declaration imported from a module which is discovered later in
    // the loader worklist; owner resolution must never depend on that order.
    inout fn predeclareTrait(t: TraitAst) {
        self.predeclareTraitIdentity(nameStart: t.nameSpan.start, nameLen: t.nameSpan.end - t.nameSpan.start, arity: t.typeParams.count())
    }

    // The sole semantic mutation for trait predeclaration.  AST and SyntaxFile
    // inputs decode to source identity/arity and then converge here.
    inout fn predeclareTraitIdentity(nameStart: U64, nameLen: U64, arity: U64) {
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            if self.decls.traitOwners[i].nameStart == nameStart { return }
            i += 1U64
        }
        self.decls.traitOwners.append(<TraitOwner nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) arity=arity />)
    }

    inout fn predeclareTraitItem(item: TopItemAst) {
        match item {
            TopItemAst.Trait(val t) => { self.predeclareTrait(t: t) }
            TopItemAst.Export(val inner) => { self.predeclareTraitItem(item: inner) }
            _ => {}
        }
    }

    // SyntaxFile counterpart of predeclareTraitItem.  The predeclare pass needs
    // only trait identity and arity, so it must not reconstruct a TraitAst.
    inout fn predeclareSyntaxTraitItem(item: TopItemId) {
        match syntaxTopItemKind(file: self.syntax, item: item) {
            SyntaxTopItemKind.Trait => {
                val traitId: TraitId = <TraitId raw=syntaxTopItemPayload(file: self.syntax, item: item) />
                val trait: SyntaxTrait = syntaxTrait(file: self.syntax, id: traitId)
                val nameLen: U64 = trait.name.end - trait.name.start
                self.predeclareTraitIdentity(nameStart: trait.name.start, nameLen: nameLen, arity: syntaxTraitTypeParamCount(file: self.syntax, trait: trait))
            }
            SyntaxTopItemKind.Export => {
                self.predeclareSyntaxTraitItem(item: <TopItemId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)
            }
            _ => {}
        }
    }

    // An `as` trait is a type-level use.  Resolve its import alias from the
    // original occurrence, rather than re-interning alias text after its
    // module identity has been lost.
    inout fn resolvedImplTraitBind(im: ImplAst) -> Bind {
        if im.traitNameSpan.end > im.traitNameSpan.start {
            val owner: U64 = self.traitOwnerAtUse(start: im.traitNameSpan.start, len: im.traitNameSpan.end - im.traitNameSpan.start, arity: im.traitArgs.count())
            if owner != 0U64 {
                val ownerLen: U64 = self.traitNameLenByOwner(owner: owner)
                return <Bind nameStart=owner nameLen=ownerLen nameId=intern(c: inout self, start: owner, len: ownerLen) fieldStart=owner fieldLen=ownerLen />
            }
            val resolved: Bind = self.aliasReal(start: im.traitNameSpan.start, len: im.traitNameSpan.end - im.traitNameSpan.start)
            return <Bind nameStart=resolved.nameStart nameLen=resolved.nameLen nameId=intern(c: inout self, start: resolved.nameStart, len: resolved.nameLen) fieldStart=resolved.fieldStart fieldLen=resolved.fieldLen />
        }
        val raw: Bind = self.internBytes(s: im.traitName)
        val owner: U64 = self.traitOwnerInScopeById(mod: self.moduleOf(offset: im.span.start), nameId: raw.nameId, arity: im.traitArgs.count())
        if owner != 0U64 {
            val ownerLen: U64 = self.traitNameLenByOwner(owner: owner)
            return <Bind nameStart=owner nameLen=ownerLen nameId=intern(c: inout self, start: owner, len: ownerLen) fieldStart=owner fieldLen=ownerLen />
        }
        return raw
    }

    inout fn checkPubMemberwiseFactory(recvN: Bind, offset: U64) {
        mut val sidx: U64 = self.structIndexByName(start: recvN.nameStart, len: recvN.nameLen)
        if sidx >= self.arena.structs.count() {
            sidx = self.genericStructIndex(nameStart: recvN.nameStart, nameLen: recvN.nameLen)
        }
        if sidx >= self.arena.structs.count() {
            return
        }
        val sd: StructDef = self.arena.structs[sidx]
        if sd.isExtern {
            return
        }
        mut val fi: U64 = 0
        while fi < sd.fields.count() {
            val f: FieldDef = sd.fields[fi]
            if !(f.hasDefault) && f.vis != 2U64 {
                self.errorAt(offset: offset, msg: "a public memberwise factory requires every field without a default value to be `pub`; otherwise construction would expose private or `pub(get)` state")
            }
            fi += 1U64
        }
    }

    inout fn appendTraitAssocTypes(scope: inout Array[Bind], nameId: U64) {
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val td: TraitDef = self.decls.traits[ti]
            if td.nameId == nameId {
                mut val ai: U64 = 0
                while ai < td.assocTypes.count() {
                    scope.append(td.assocTypes[ai])
                    ai += 1
                }
            }
            ti += 1
        }
    }

    // Reconstruct the implicit lexical `Self` binder of one completed trait.
    // The source spelling is shared, but identity is declaration-owned.
    inout fn appendTraitSelfBinder(scope: inout Array[Bind], owner: U64) {
        mut val ti: U64 = 0U64
        while ti < self.decls.traits.count() {
            val td: TraitDef = self.decls.traits[ti]
            if td.nameStart == owner && td.selfParamId != 0U64 {
                val selfName: Bind = self.kwSpan(kw: "Self", kwLen: 4U64)
                scope.append(<Bind nameStart=selfName.nameStart nameLen=selfName.nameLen nameId=intern(c: inout self, start: selfName.nameStart, len: selfName.nameLen) paramId=td.selfParamId fieldStart=selfName.fieldStart fieldLen=selfName.fieldLen />)
                return
            }
            ti += 1U64
        }
    }

    inout fn lowerMethodMember(im: ImplAst, m: MemberAst, recvN: Bind, recvTy: U64, recvTraitArgs: Array[U64], recvTraitOwner: U64, implParamBinds: Array[Bind], hasRecv: Bool, isAssoc: Bool, witnessed: inout Array[Func]) {
        val nameN: Bind = self.internBytes(s: m.name)
        mut val boundTypes: Array[TypeAst] = []
        mut val boundTraits: Array[String] = []
        mut val bi0: U64 = 0
        while bi0 < im.whereTypes.count() {
            boundTypes.append(im.whereTypes[bi0])
            if bi0 < im.whereTraits.count() {
                boundTraits.append(im.whereTraits[bi0])
            }
            bi0 += 1
        }
        mut val bi1: U64 = 0
        while bi1 < m.whereTypes.count() {
            boundTypes.append(m.whereTypes[bi1])
            if bi1 < m.whereTraits.count() {
                boundTraits.append(m.whereTraits[bi1])
            }
            bi1 += 1
        }
        // typeParams = impl's `[T]` (in scope for every member) ++ the method's own.
        mut val typeParams: Array[Bind] = []
        mut val ipi: U64 = 0
        while ipi < implParamBinds.count() {
            typeParams.append(implParamBinds[ipi])
            ipi += 1
        }
        val ownParams: Array[Bind] = self.lowerTypeParamNames(names: m.typeParams, anchor: m.nameSpan.start, sendableFlags: m.typeParamSendable)
        mut val opi: U64 = 0
        while opi < ownParams.count() {
            typeParams.append(ownParams[opi])
            opi += 1
        }
        // lowering-time skip scope for lowerType = the impl's scope already on self.cur.typeParams
        // (impl `[T]` ++ the implemented/extended trait's associated types, set by lowerImpl) ++
        // this method's own `[U]`. The associated types matter for a provided method like
        // `Iterator.map` whose signature names `Item` — a binder, not a module type. (`typeParams`
        // above, stored on the Func for codegen, stays impl ++ method; assoc types aren't generic
        // substitution params, only skip-scope.)
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeAst] = self.lowerWhereTypes
        val savedWTr: Array[String] = self.lowerWhereTraits
        mut val skipScope: Array[Bind] = savedTP
        mut val ski: U64 = 0
        while ski < ownParams.count() {
            skipScope.append(ownParams[ski])
            ski += 1
        }
        self.cur.typeParams = skipScope
        self.lowerWhereTypes = boundTypes
        self.lowerWhereTraits = boundTraits
        val normParams: Array[ParamAst] = self.normalizeParams(params: m.params, whereTypes: boundTypes, whereTraits: boundTraits)
        val params: Array[Param] = self.lowerParams(params: normParams)
        mut val retStart: U64 = 0
        mut val retLen: U64 = 0
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0
        if m.hasRet {
            val pt: PType = self.lowerType(t: self.normalizeProjectionType(t: m.ret, whereTypes: boundTypes, whereTraits: boundTraits))
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
        }
        // a custom factory (spec/05) returns the impl's type (the implicit `Self`); the
        // body's `return <Type …/>` then grounds against it. A fallible factory wraps that
        // in `Optional[Self]` (`optional`) or `Result[Self, E]` (`result[E]`).
        mut val effHasRet: Bool = m.hasRet
        if m.isFactory {
            val ft: PType = self.lowerType(t: im.recvType)
            effHasRet = true
            if m.factoryKind == 1U64 {
                val optN: Bind = self.internBytes(s: "Optional")
                mut val oargs: Array[U64] = []
                oargs.append(ft.ref)
                retRef = self.pushType(t: <TypeRef nameStart=optN.nameStart nameLen=optN.nameLen args=oargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                retStart = optN.nameStart
                retLen = optN.nameLen
                retIsArray = false
            } else {
                if m.factoryKind == 2U64 {
                    val resN: Bind = self.internBytes(s: "Result")
                    val et: PType = self.lowerType(t: m.factoryErr)
                    mut val rargs: Array[U64] = []
                    rargs.append(ft.ref)
                    rargs.append(et.ref)
                    retRef = self.pushType(t: <TypeRef nameStart=resN.nameStart nameLen=resN.nameLen args=rargs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                    retStart = resN.nameStart
                    retLen = resN.nameLen
                    retIsArray = false
                } else {
                    retStart = ft.start
                    retLen = ft.len
                    retIsArray = ft.isArray
                    retRef = ft.ref
                }
            }
        }
        // a trait-impl member witnesses a requirement (body or via). The witnessed sig
        // is a pure requirement signature (body 0, no recv/self/assoc/async).
        if im.isTraitImpl {
            if m.isVia {
                val realN: Bind = self.internBytes(s: m.viaName)
                self.decls.methodAliases.append(<MethodAlias recvStart=recvN.nameStart recvLen=recvN.nameLen recvId=intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen) aliasStart=nameN.nameStart aliasLen=nameN.nameLen aliasId=intern(c: inout self, start: nameN.nameStart, len: nameN.nameLen) realStart=realN.nameStart realLen=realN.nameLen realId=intern(c: inout self, start: realN.nameStart, len: realN.nameLen) />)
                witnessed.append(<Func nameStart=nameN.nameStart nameLen=nameN.nameLen nameId=intern(c: inout self, start: nameN.nameStart, len: nameN.nameLen) typeParams=typeParams params=params hasRet=m.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
                self.cur.typeParams = savedTP
                self.lowerWhereTypes = savedWT
                self.lowerWhereTraits = savedWTr
                return
            }
            witnessed.append(<Func nameStart=nameN.nameStart nameLen=nameN.nameLen nameId=intern(c: inout self, start: nameN.nameStart, len: nameN.nameLen) typeParams=typeParams params=params hasRet=m.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        val body: U64 = self.lowerBlock(b: m.body)
        self.cur.lowerRetTy = savedRet
        val fnIdx: U64 = self.arena.funcs.count()
        // an extension method (spec/09) is tagged with its extension's name id so it is
        // excluded from bare resolution (reachable only via `value#Ext.m()`).
        mut val extId: U64 = 0
        if im.extName.bytes().count() > 0 {
            val extN: Bind = self.internBytes(s: im.extName)
            extId = intern(c: inout self, start: extN.nameStart, len: extN.nameLen)
        }
        mut val originTraitId: U64 = 0U64
        mut val originTraitOwner: U64 = 0U64
        mut val originTraitArity: U64 = 0U64
        if im.isTraitImpl {
            val originTrait: Bind = self.resolvedImplTraitBind(im: im)
            originTraitId = originTrait.nameId
            originTraitOwner = originTrait.nameStart
            originTraitArity = im.traitArgs.count()
        }
        self.registerDeclaredFunc(f: <Func nameStart=nameN.nameStart nameLen=nameN.nameLen nameId=intern(c: inout self, start: nameN.nameStart, len: nameN.nameLen) recvId=intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen) recvTy=recvTy recvTraitArgs=recvTraitArgs typeParams=typeParams params=params hasRet=effHasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=hasRecv recvStart=recvN.nameStart recvLen=recvN.nameLen selfInout=m.selfInout selfMove=m.selfMove isAssoc=isAssoc isAsync=m.isAsync isExtern=false isPub=im.isPub extId=extId provTraitArity=im.recvType.args.count() provTraitOwner=recvTraitOwner originTraitId=originTraitId originTraitOwner=originTraitOwner originTraitArity=originTraitArity sourceWitnessFuncId=fnIdx + 1U64 defOffset=m.nameSpan.start />)
        self.appendFuncBounds(fnIdx: fnIdx, params: m.whereParams, traits: m.whereTraits, types: m.whereTypes, traitTypes: m.whereTraitTypes)
        self.appendFuncBounds(fnIdx: fnIdx, params: im.whereParams, traits: im.whereTraits, types: im.whereTypes, traitTypes: im.whereTraitTypes)
        self.cur.typeParams = savedTP
        self.lowerWhereTypes = savedWT
        self.lowerWhereTraits = savedWTr
    }

    inout fn lowerImpl(im: ImplAst) {
        val rawRecvN: Bind = self.internBytes(s: im.recvType.name)
        val recvTraitOwner: U64 = self.traitOwnerAtUse(start: im.recvType.span.start, len: rawRecvN.nameLen, arity: im.recvType.args.count())
        mut val recvN: Bind = rawRecvN
        if recvTraitOwner != 0U64 {
            recvN = <Bind nameStart=recvTraitOwner nameLen=rawRecvN.nameLen nameId=intern(c: inout self, start: recvTraitOwner, len: rawRecvN.nameLen) fieldStart=recvTraitOwner fieldLen=rawRecvN.nameLen />
        }
        val implParamBinds: Array[Bind] = self.lowerTypeParamNames(names: im.implParams, anchor: im.span.start, sendableFlags: im.implParamSendable)
        // the impl's lowering-time skip scope: its `[T]`, plus the associated types of the trait
        // it implements/extends — both a bare `impl Iterator` (recv IS the trait, its provided
        // methods name `Item`) and `impl T as Tr` (the witnessed signatures name `Tr`'s assoc
        // types). In scope for assoc-type bindings, trait args, deinit bodies, and every method
        // (each method then adds its own `[U]` in lowerMethodMember, restoring to this).
        mut val implScope: Array[Bind] = []
        mut val ipb: U64 = 0
        while ipb < implParamBinds.count() {
            implScope.append(implParamBinds[ipb])
            ipb += 1
        }
        // A provided body (`impl Trait { ... }`) is lowered in the trait's
        // lexical environment.  Its explicit `Self` annotations must carry
        // that trait's binder identity, rather than remain an ambient keyword.
        if recvTraitOwner != 0U64 {
            self.appendTraitSelfBinder(scope: inout implScope, owner: recvTraitOwner)
        }
        self.appendTraitAssocTypes(scope: inout implScope, nameId: intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen))
        if im.isTraitImpl {
            val trN: Bind = self.resolvedImplTraitBind(im: im)
            self.appendTraitAssocTypes(scope: inout implScope, nameId: intern(c: inout self, start: trN.nameStart, len: trN.nameLen))
        }
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeAst] = self.lowerWhereTypes
        val savedWTr: Array[String] = self.lowerWhereTraits
        self.cur.typeParams = implScope
        self.lowerWhereTypes = im.whereTypes
        self.lowerWhereTraits = im.whereTraits
        // Trait subjects are not value TypeRefs; concrete impl receivers are.
        // Preserve the latter's complete pattern (including generic arguments)
        // for callable-surface matching instead of collapsing to recvId.
        mut val recvTy: U64 = 0U64
        if !(self.isTraitName(start: recvN.nameStart, len: recvN.nameLen)) {
            recvTy = self.lowerType(t: im.recvType).ref
        }
        mut val subjectArgs: Array[U64] = []
        mut val subjectArgIdx: U64 = 0
        while subjectArgIdx < im.recvType.args.count() {
            subjectArgs.append(self.lowerType(t: im.recvType.args[subjectArgIdx]).ref)
            subjectArgIdx += 1U64
        }
        mut val conformanceTraitArgs: Array[U64] = []
        mut val traitArgIdx: U64 = 0U64
        while traitArgIdx < im.traitArgs.count() {
            conformanceTraitArgs.append(self.lowerType(t: im.traitArgs[traitArgIdx]).ref)
            traitArgIdx += 1U64
        }
        mut val witnessed: Array[Func] = []
        mut val witnessFuncIds: Array[U64] = []
        mut val assocBindingIds: Array[U64] = []
        mut val mi: U64 = 0
        while mi < im.members.count() {
            val m: MemberAst = im.members[mi]
            match m.kind {
                MemberKind.Method => {
                    val beforeFuncCount: U64 = self.arena.funcs.count()
                    self.lowerMethodMember(im: im, m: m, recvN: recvN, recvTy: recvTy, recvTraitArgs: subjectArgs, recvTraitOwner: recvTraitOwner, implParamBinds: implParamBinds, hasRecv: true, isAssoc: false, witnessed: inout witnessed)
                    if im.isTraitImpl && self.arena.funcs.count() > beforeFuncCount { witnessFuncIds.append(beforeFuncCount) }
                }
                MemberKind.AssocFn => {
                    val beforeFuncCount: U64 = self.arena.funcs.count()
                    self.lowerMethodMember(im: im, m: m, recvN: recvN, recvTy: recvTy, recvTraitArgs: subjectArgs, recvTraitOwner: recvTraitOwner, implParamBinds: implParamBinds, hasRecv: false, isAssoc: true, witnessed: inout witnessed)
                    if im.isTraitImpl && self.arena.funcs.count() > beforeFuncCount { witnessFuncIds.append(beforeFuncCount) }
                }
                MemberKind.Deinit => {
                    val deinitN: Bind = self.internBytes(s: "deinit")
                    val body: U64 = self.lowerBlock(b: m.body)
                    val noParams: Array[Param] = []
                    val noTypeParams: Array[Bind] = []
                    self.registerDeclaredFunc(f: <Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout self, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen) recvTy=recvTy typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=recvN.nameStart recvLen=recvN.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=im.span.start />)
                    self.decls.deinits.append(<Bind nameStart=recvN.nameStart nameLen=recvN.nameLen fieldStart=recvN.nameStart fieldLen=recvN.nameLen />)
                }
                MemberKind.AssocType => {
                    val pt: PType = self.lowerType(t: m.assocTy)
                    val atN: Bind = self.internBytes(s: m.name)
                    mut val trId: U64 = 0
                    mut val trOwner: U64 = 0
                    if im.traitName.bytes().count() > 0 {
                        val trN: Bind = self.resolvedImplTraitBind(im: im)
                        trId = trN.nameId
                        trOwner = trN.nameStart
                    }
                    assocBindingIds.append(self.decls.assocBindings.count())
                    self.decls.assocBindings.append(<AssocBinding recvStart=recvN.nameStart recvLen=recvN.nameLen recvId=intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen) nameStart=atN.nameStart nameLen=atN.nameLen nameId=intern(c: inout self, start: atN.nameStart, len: atN.nameLen) traitId=trId traitOwner=trOwner implOffset=im.span.start subjectTy=recvTy subjectArgs=subjectArgs typeParams=implParamBinds traitArgs=conformanceTraitArgs tyStart=pt.start tyLen=pt.len tyIsArray=pt.isArray ty=pt.ref />)
                }
                MemberKind.Factory => {
                    // `factory` in a `pub impl T` publishes T's default memberwise factory
                    // (spec/05) — record T's name id so `<T …/>` is allowed outside
                    // T's anonymous impl.
                    if im.isPub {
                        self.checkPubMemberwiseFactory(recvN: recvN, offset: m.nameSpan.start)
                        self.decls.pubFactories.append(intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen))
                    }
                }
            }
            mi += 1
        }
        if im.isTraitImpl {
            val traitN: Bind = self.resolvedImplTraitBind(im: im)
            mut val cfExtId: U64 = 0
            if im.extName.bytes().count() > 0 {
                val cfExtN: Bind = self.internBytes(s: im.extName)
                cfExtId = intern(c: inout self, start: cfExtN.nameStart, len: cfExtN.nameLen)
            }
            self.registerDeclaredConformance(cf: <Conform typeStart=recvN.nameStart typeLen=recvN.nameLen typeId=intern(c: inout self, start: recvN.nameStart, len: recvN.nameLen) subjectTy=recvTy subjectArgs=self.pushConformTypes(types: subjectArgs) typeParams=self.pushConformBinds(binds: implParamBinds) typeArity=im.recvType.args.count() traitStart=traitN.nameStart traitLen=traitN.nameLen traitId=intern(c: inout self, start: traitN.nameStart, len: traitN.nameLen) traitArgs=self.pushConformTypes(types: conformanceTraitArgs) derived=false isPub=im.isPub witnessed=self.pushConformWitnesses(witnesses: witnessed) witnessFuncIds=self.pushConformFuncIds(ids: witnessFuncIds) extId=cfExtId defOffset=im.span.start assocBindingIds=self.pushConformFuncIds(ids: assocBindingIds) />)
        }
        // attach pending `@[...]` directives to this impl block (a macro on an impl);
        // declStart/declEnd = the impl block's source span for the gen harness slice.
        self.drainDerives(typeStart: recvN.nameStart, typeLen: recvN.nameLen, isEnum: false, declStart: im.span.start, declEnd: im.span.end)
        self.cur.typeParams = savedTP
        self.lowerWhereTypes = savedWT
        self.lowerWhereTraits = savedWTr
    }

    inout fn lowerSigToFunc(sig: SigAst, isExtern: Bool, isCExtern: Bool) -> Func {
        val nameStart: U64 = sig.nameSpan.start
        val nameLen: U64 = sig.nameSpan.end - sig.nameSpan.start
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: sig.typeParams, anchor: nameStart, sendableFlags: sig.typeParamSendable)
        // a requirement signature's `[U]` (and the trait's own params, kept in self.cur.typeParams
        // by lowerTrait) are in scope for its param/return types — skip those heads in lowerType.
        val savedTP: Array[Bind] = self.cur.typeParams
        mut val scopeTP: Array[Bind] = savedTP
        mut val stpi: U64 = 0
        while stpi < typeParams.count() {
            scopeTP.append(typeParams[stpi])
            stpi += 1
        }
        self.cur.typeParams = scopeTP
        val params: Array[Param] = self.lowerParams(params: sig.params)
        mut val retStart: U64 = 0
        mut val retLen: U64 = 0
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0
        if sig.hasRet {
            val pt: PType = self.lowerType(t: sig.ret)
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
        }
        self.cur.typeParams = savedTP
        val runtimeIntrinsic: RuntimeIntrinsicDeclaration = self.runtimeIntrinsicDeclaration(sig: sig, isExtern: isExtern, isCExtern: isCExtern)
        return <Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) typeParams=typeParams params=params hasRet=sig.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=sig.selfInout selfMove=false isAssoc=sig.isAssoc isAsync=false isExtern=isExtern isCExtern=isCExtern runtimeIntrinsic=runtimeIntrinsic defOffset=nameStart />
    }

    inout fn lowerTrait(t: TraitAst) {
        val nameStart: U64 = t.nameSpan.start
        val nameLen: U64 = t.nameSpan.end - t.nameSpan.start
        mut val supertraits: Array[Bind] = []
        mut val si: U64 = 0
        while si < t.supertraits.count() {
            supertraits.append(self.internBytes(s: t.supertraits[si]))
            si += 1
        }
        // collect the trait's binders BEFORE lowering reqs: its type params `[Rhs]` AND its
        // associated types `Item` are both in scope inside the requirement signatures (`-> Item`,
        // `(rhs: Rhs)`) and are binders, not module-scoped types — put them in the lowering-time
        // scope so lowerType skips those heads. (`Self` has no global decl, so it self-skips.)
        mut val assocTypes: Array[Bind] = []
        mut val ai: U64 = 0
        while ai < t.assocTypes.count() {
            assocTypes.append(self.internBytes(s: t.assocTypes[ai]))
            ai += 1
        }
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: t.typeParams, anchor: nameStart, sendableFlags: t.typeParamSendable)
        val selfName: Bind = self.kwSpan(kw: "Self", kwLen: 4U64)
        val selfParamId: U64 = self.nextParamId
        self.nextParamId += 1U64
        val selfBind: Bind = <Bind nameStart=selfName.nameStart nameLen=selfName.nameLen nameId=intern(c: inout self, start: selfName.nameStart, len: selfName.nameLen) paramId=selfParamId fieldStart=selfName.fieldStart fieldLen=selfName.fieldLen />
        val savedTP: Array[Bind] = self.cur.typeParams
        mut val scopeTP: Array[Bind] = []
        scopeTP.append(selfBind)
        mut val stpi: U64 = 0
        while stpi < typeParams.count() {
            scopeTP.append(typeParams[stpi])
            stpi += 1
        }
        mut val sai: U64 = 0
        while sai < assocTypes.count() {
            scopeTP.append(assocTypes[sai])
            sai += 1
        }
        self.cur.typeParams = scopeTP
        mut val reqs: Array[Func] = []
        mut val ri: U64 = 0
        while ri < t.reqs.count() {
            reqs.append(self.lowerSigToFunc(sig: t.reqs[ri], isExtern: false, isCExtern: false))
            ri += 1
        }
        self.cur.typeParams = savedTP
        self.decls.traits.append(<TraitDef nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) selfParamId=selfParamId typeParams=typeParams supertraits=supertraits reqs=reqs assocTypes=assocTypes />)
        // attach pending `@[...]` directives to this trait (a macro on a trait);
        // declStart/declEnd = the trait's source span for the gen harness slice.
        self.drainDerives(typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: t.span.start, declEnd: t.span.end)
    }
}
