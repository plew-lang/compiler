// Part of the lowering pass (root: _.pw): struct / enum / function
// declaration lowering.

// Lower generic parameter names `[T, U]` (Array[String]) to the arena's Bind spans.

pub impl Comp {
    inout fn traitHasAssocId(traitId: U64, assocId: U64) -> Bool {
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val tr: TraitDef = self.decls.traits[ti]
            if tr.nameId == traitId {
                mut val ai: U64 = 0
                while ai < tr.assocTypes.count() {
                    if tr.assocTypes[ai].nameId == assocId {
                        return true
                    }
                    ai += 1
                }
            }
            ti += 1
        }
        return false
    }

    inout fn boundLhsMatchesType(lhs: TypeAst, t: TypeAst) -> Bool {
        if lhs.projectionAssoc.bytes().count() > 0 {
            return false
        }
        if lhs.extView.bytes().count() > 0 {
            return false
        }
        if lhs.name != t.name {
            return false
        }
        if lhs.args.count() != t.args.count() {
            return false
        }
        mut val i: U64 = 0
        while i < lhs.args.count() {
            if !(self.boundLhsMatchesType(lhs: lhs.args[i], t: t.args[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn uniqueProjectionTrait(t: TypeAst, whereTypes: Array[TypeAst], whereTraits: Array[String]) -> String {
        val assocN: Bind = self.internBytes(s: t.projectionAssoc)
        mut val found: String = ""
        mut val foundId: U64 = 0
        mut val count: U64 = 0
        mut val i: U64 = 0
        while i < whereTypes.count() {
            if self.boundLhsMatchesType(lhs: whereTypes[i], t: t) {
                if i < whereTraits.count() {
                    val trN: Bind = self.internBytes(s: whereTraits[i])
                    if self.traitHasAssocId(traitId: trN.nameId, assocId: assocN.nameId) {
                        if foundId != trN.nameId {
                            found = whereTraits[i]
                            foundId = trN.nameId
                            count += 1U64
                        }
                    }
                }
            }
            i += 1
        }
        if count == 1U64 {
            return found
        }
        if count == 0U64 {
            self.errorAt(offset: t.span.start, msg: "associated-type short projection has no unique trait source — write `T#Trait.Item` or add an appropriate `where T: Trait` bound (spec/08)")
        } else {
            self.errorAt(offset: t.span.start, msg: "associated-type short projection is ambiguous — write the canonical `T#Trait.Item` form (spec/08)")
        }
        return ""
    }

    inout fn normalizeProjectionType(t: TypeAst, whereTypes: Array[TypeAst], whereTraits: Array[String]) -> TypeAst {
        mut val args: Array[TypeAst] = []
        mut val i: U64 = 0
        while i < t.args.count() {
            args.append(self.normalizeProjectionType(t: t.args[i], whereTypes: whereTypes, whereTraits: whereTraits))
            i += 1
        }
        mut val projectionTrait: String = t.projectionTrait
        if t.projectionAssoc.bytes().count() > 0 {
            if projectionTrait.bytes().count() == 0 {
                projectionTrait = self.uniqueProjectionTrait(t: t, whereTypes: whereTypes, whereTraits: whereTraits)
            }
        }
        return <TypeAst name=t.name args=args span=t.span extView=t.extView viewNames=t.viewNames projectionTrait=projectionTrait projectionAssoc=t.projectionAssoc isAny=t.isAny argLabels=t.argLabels isSendable=t.isSendable isRecord=t.isRecord />
    }

    inout fn normalizeProjectionTypeActive(t: TypeAst) -> TypeAst {
        return self.normalizeProjectionType(t: t, whereTypes: self.lowerWhereTypes, whereTraits: self.lowerWhereTraits)
    }

    inout fn normalizeParams(params: Array[ParamAst], whereTypes: Array[TypeAst], whereTraits: Array[String]) -> Array[ParamAst] {
        mut val out: Array[ParamAst] = []
        mut val i: U64 = 0
        while i < params.count() {
            val p: ParamAst = params[i]
            out.append(<ParamAst name=p.name ty=self.normalizeProjectionType(t: p.ty, whereTypes: whereTypes, whereTraits: whereTraits) isInout=p.isInout isMove=p.isMove isBorrow=p.isBorrow noLabel=p.noLabel hasDefault=p.hasDefault defaultVal=p.defaultVal span=p.span />)
            i += 1
        }
        return out
    }

    inout fn lowerTypeParamNames(names: Array[String], anchor: U64, sendableFlags: Array[Bool] = []) -> Array[Bind] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0
        while i < names.count() {
            val b: Bind = self.internBytes(s: names[i])
            // a generic's own bracket list must have distinct names (spec/06): `f[T, T]`
            // is ambiguous. Checked per RAW list (not the merged impl++method list, where
            // an impl param and a method param may legitimately share a name = shadowing).
            // `anchor` is the owning declaration's source offset (the Bind spans are
            // interned = map to no source file).
            val bId: U64 = intern(c: inout self, start: b.nameStart, len: b.nameLen)
            mut val k: U64 = 0
            while k < out.count() {
                if intern(c: inout self, start: out[k].nameStart, len: out[k].nameLen) == bId {
                    self.errorAt(offset: anchor, msg: "duplicate type-parameter name (each `[T]` in a generic must be distinct — spec/06)")
                }
                k += 1
            }
            mut val isSendable: Bool = false
            if i < sendableFlags.count() {
                isSendable = sendableFlags[i]
            }
            out.append(<Bind nameStart=b.nameStart nameLen=b.nameLen nameId=b.nameId fieldStart=b.fieldStart fieldLen=b.fieldLen offset=b.offset isSendable=isSendable />)
            i += 1
        }
        return out
    }

    inout fn lowerFieldDef(f: FieldAst) -> FieldDef {
        val nm: Bind = self.internBytes(s: f.name)
        mut val tyStart: U64 = 0
        mut val tyLen: U64 = 0
        mut val tyIsArray: Bool = false
        mut val tyRef: U64 = 0
        if f.ty.name.bytes().count() > 0 || f.ty.isRecord {
            val pt: PType = self.lowerType(t: f.ty)
            tyStart = pt.start
            tyLen = pt.len
            tyIsArray = pt.isArray
            tyRef = pt.ref
        }
        mut val hasDefault: Bool = false
        mut val defaultVal: U64 = 0
        if f.hasDefault {
            defaultVal = self.lowerExpr(e: f.defaultVal)
            hasDefault = true
        }
        return <FieldDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isMut=f.isMut hasDefault=hasDefault defaultVal=defaultVal vis=f.vis />
    }

    inout fn lowerStructDecl(d: DeclAst) {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start, sendableFlags: d.typeParamSendable)
        // field types may reference `[T]` — make them the lowering-time scope so lowerType
        // marks type-parameter heads as skip (siteOffset 0). Restored at function end.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val fields: Array[FieldDef] = []
        mut val i: U64 = 0
        while i < d.fields.count() {
            fields.append(self.lowerFieldDef(f: d.fields[i]))
            i += 1
        }
        // a `deinit { body }` lowers to a synthetic method `Type_deinit(Type self)`
        // (name span = the text "deinit") plus a self.decls.deinits record so scope-exit drops
        // fire it. Appended at the same point in self.arena.funcs as the native parser (during
        // this struct's processing), so the function stream order is preserved.
        if d.hasDeinit {
            val deinitN: Bind = self.internBytes(s: "deinit")
            val body: U64 = self.lowerBlock(b: d.deinitBody)
            val noParams: Array[Param] = []
            val noTypeParams: Array[Bind] = []
            self.registerDeclaredFunc(f: <Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout self, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=nm.nameStart recvLen=nm.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=d.span.start />)
            self.decls.deinits.append(<Bind nameStart=nm.nameStart nameLen=nm.nameLen fieldStart=nm.nameStart fieldLen=nm.nameLen />)
        }
        self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams fields=fields isUnique=d.isUnique isNonsendable=d.isNonsendable isExtern=false defOffset=d.span.start />)
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerEnumDecl(d: DeclAst) {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start, sendableFlags: d.typeParamSendable)
        // variant payload types may reference `[T]` — see lowerStructDecl.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val variants: Array[Variant] = []
        mut val i: U64 = 0
        while i < d.variants.count() {
            val v: VariantAst = d.variants[i]
            val vn: Bind = self.internBytes(s: v.name)
            mut val vfields: Array[FieldDef] = []
            mut val j: U64 = 0
            while j < v.fields.count() {
                vfields.append(self.lowerFieldDef(f: v.fields[j]))
                j += 1
            }
            variants.append(<Variant nameStart=vn.nameStart nameLen=vn.nameLen nameId=intern(c: inout self, start: vn.nameStart, len: vn.nameLen) fields=vfields />)
            i += 1
        }
        self.arena.enums.append(<EnumDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams variants=variants isUnique=d.isUnique isNonsendable=d.isNonsendable defOffset=d.span.start />)
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerFuncDecl(d: DeclAst) {
        val nameStart: U64 = d.nameSpan.start
        val nameLen: U64 = d.nameSpan.end - d.nameSpan.start
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: nameStart, sendableFlags: d.typeParamSendable)
        // param / return / body-local types may reference `[T]` — make them the lowering-time
        // scope so lowerType marks type-parameter heads as skip (siteOffset 0).
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeAst] = self.lowerWhereTypes
        val savedWTr: Array[String] = self.lowerWhereTraits
        self.cur.typeParams = typeParams
        self.lowerWhereTypes = d.whereTypes
        self.lowerWhereTraits = d.whereTraits
        val normParams: Array[ParamAst] = self.normalizeParams(params: d.params, whereTypes: d.whereTypes, whereTraits: d.whereTraits)
        val params: Array[Param] = self.lowerParams(params: normParams)
        mut val retStart: U64 = 0
        mut val retLen: U64 = 0
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0
        if d.hasRet {
            val pt: PType = self.lowerType(t: self.normalizeProjectionType(t: d.ret, whereTypes: d.whereTypes, whereTraits: d.whereTraits))
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        val body: U64 = self.lowerBlock(b: d.body)
        self.cur.lowerRetTy = savedRet
        self.cur.typeParams = savedTP
        self.lowerWhereTypes = savedWT
        self.lowerWhereTraits = savedWTr
        val fnIdx: U64 = self.registerDeclaredFunc(f: <Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) typeParams=typeParams params=params hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isExtern=false defOffset=nameStart />)
        self.appendFuncBounds(fnIdx: fnIdx, params: d.whereParams, traits: d.whereTraits, types: d.whereTypes, traitTypes: d.whereTraitTypes)
        // attach pending `@[...]` directives to this fn (a macro on a free function);
        // declStart/declEnd = the fn's source span for the gen harness slice.
        self.drainDerives(typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
    }

    inout fn appendFuncBounds(fnIdx: U64, params: Array[String], traits: Array[String], types: Array[TypeAst] = [], traitTypes: Array[TypeAst] = []) {
        mut val i: U64 = 0
        while i < params.count() {
            val pn: Bind = self.internBytes(s: params[i])
            val tn: Bind = self.internBytes(s: traits[i])
            mut val pty: U64 = 0
            if i < types.count() {
                pty = self.lowerType(t: self.normalizeProjectionType(t: types[i], whereTypes: types, whereTraits: traits)).ref
            } else {
                pty = self.simpleTypeRef(nameStart: pn.nameStart, nameLen: pn.nameLen)
            }
            mut val boundArgs: Array[U64] = []
            mut val boundAssocNames: Array[U64] = []
            mut val boundAssocValues: Array[U64] = []
            if i < traitTypes.count() {
                mut val ai: U64 = 0U64
                while ai < traitTypes[i].args.count() {
                    val boundRef: U64 = self.lowerType(t: self.normalizeProjectionType(t: traitTypes[i].args[ai], whereTypes: types, whereTraits: traits)).ref
                    mut val label: U64 = 0U64
                    if ai < traitTypes[i].argLabels.count() && traitTypes[i].argLabels[ai].bytes().count() > 0U64 {
                        val labelBind: Bind = self.internBytes(s: traitTypes[i].argLabels[ai])
                        label = labelBind.nameId
                    }
                    if label == 0U64 { boundArgs.append(boundRef) }
                    else {
                        boundAssocNames.append(label)
                        boundAssocValues.append(boundRef)
                    }
                    ai += 1U64
                }
            }
            self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramTy=pty paramNameId=pn.nameId traitNameId=tn.nameId traitStart=tn.nameStart traitLen=tn.nameLen traitArgs=boundArgs traitAssocNames=boundAssocNames traitAssocValues=boundAssocValues />)
            i += 1
        }
    }
}
