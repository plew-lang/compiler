// Part of the lowering pass (root: _.pw): struct / enum / function
// declaration lowering.

// Lower generic parameter names `[T, U]` (Array[String]) to the arena's Bind spans.

impl Comp {
    inout fn beginShortProjection(site: U64) -> Result[(), CompileDiagnostic] {
        // Bound query growth and aggregate stack use in unoptimized builds.
        // Both AST representations consume this same request-depth budget.
        if self.lowerProjectionDepth >= 32U64 { return <Result.Err error=self.diagnosticAt(offset: site, msg: "associated-type short projection analysis limit exceeded", failureDomain: <FailureDomain.Limit />) /> }
        self.lowerProjectionDepth += 1U64
        return <Result.Ok value=() />
    }

    // Legacy value ASTs may provide only the displayed trait name. Preserve
    // one row per subject, with its authored site, before combining scopes.
    inout fn valueProjectionTraitTypes(subjects: Array[TypeAst], names: Array[String], types: Array[TypeAst]) -> Result[Array[TypeAst], CompileDiagnostic] {
        mut val result: Array[TypeAst] = []
        mut val index = 0U64
        while index < subjects.count() {
            if index < types.count() { result.append(types[index]) }
            else if index < names.count() { result.append(<TypeAst name=names[index] args=[] span=subjects[index].span />) }
            else { return <Result.Err error=self.diagnosticAt(offset: subjects[index].span.start, msg: "invalid projection bound input", failureDomain: <FailureDomain.Input />) /> }
            index += 1U64
        }
        return <Result.Ok value=result />
    }

    inout fn decodeValueTraitConstraintArguments(traitType: TypeAst, owner: U64, site: U64) -> Result[TraitConstraint, CompileDiagnostic] {
        mut val boundArgs: Array[U64] = []
        mut val boundAssocNames: Array[U64] = []
        mut val boundAssocValues: Array[U64] = []
        mut val ai: U64 = 0U64
        while ai < traitType.args.count() {
            val boundRef: U64 = (try self.lowerType(t: (try self.normalizeProjectionType(t: traitType.args[ai])))).ref
            mut val label: U64 = 0U64
            if ai < traitType.argLabels.count() && traitType.argLabels[ai].bytes().count() > 0U64 {
                val labelBind: Bind = self.internBytes(s: traitType.argLabels[ai])
                label = labelBind.nameId
            }
            if label == 0U64 { boundArgs.append(boundRef) }
            else {
                boundAssocNames.append(label)
                boundAssocValues.append(boundRef)
            }
            ai += 1U64
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        mut val pi: U64 = 0U64
        while pi < boundAssocNames.count() && pi < boundAssocValues.count() {
            predicates.append(<TraitAssocPredicate member=boundAssocNames[pi] value=boundAssocValues[pi] span=site />)
            pi += 1U64
        }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=boundArgs /> positionalArgsOpen=boundArgs.count() == 0U64 assocPredicates=predicates /> />
    }

    inout fn decodeSyntaxTraitConstraintArguments(traitType: SyntaxType, owner: U64, site: U64) -> Result[TraitConstraint, CompileDiagnostic] {
        mut val args: Array[U64] = []
        mut val assocNames: Array[U64] = []
        mut val assocValues: Array[U64] = []
        mut val ai: U64 = 0U64
        while ai < syntaxTypeArgCount(file: self.syntax, ty: traitType) {
            val arg: U64 = (try self.lowerSyntaxType(id: syntaxTypeArg(file: self.syntax, ty: traitType, index: ai))).ref
            val label = if ai < traitType.argLabels.count { give syntaxTypeArgLabel(file: self.syntax, ty: traitType, index: ai) } else { give <Span start=0U64 end=0U64 /> }
            if label.end > label.start {
                assocNames.append(intern(c: inout self, start: label.start, len: label.end - label.start))
                assocValues.append(arg)
            } else { args.append(arg) }
            ai += 1U64
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        ai = 0U64
        while ai < assocNames.count() && ai < assocValues.count() {
            predicates.append(<TraitAssocPredicate member=assocNames[ai] value=assocValues[ai] span=site />)
            ai += 1U64
        }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=args /> positionalArgsOpen=args.count() == 0U64 assocPredicates=predicates /> />
    }

}

pub impl Comp {
    fn traitOwnerHasAssocId(owner: U64, assocId: U64) -> Bool {
        val index = self.decls.traitOwnerIndex(offset: owner)
        if index >= self.decls.traitOwnerCount() { return false }
        for val member in self.decls.traitOwnerAt(index: index).assocTypes {
            if member.nameId == assocId { return true }
        }
        return false
    }

    inout fn boundLhsMatchesType(lhs: TypeAst, t: TypeAst) -> Bool {
        if lhs.projectionAssoc.bytes().count() > 0 {
            return false
        }
        if lhs.extView.bytes().count() > 0 {
            return false
        }
        if lhs.name != t.name {
            return false
        }
        if lhs.args.count() != t.args.count() {
            return false
        }
        mut val i: U64 = 0
        while i < lhs.args.count() {
            if !(self.boundLhsMatchesType(lhs: lhs.args[i], t: t.args[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn chooseShortProjectionSource(sources: Array[ResolvedViewSource], member: U64, site: U64) -> Result[ResolvedViewSource, CompileDiagnostic] {
        mut val candidates: Array[ResolvedViewSource] = []
        for val source in sources {
            val ownerIndex = self.decls.traitOwnerIndex(offset: source.traitInstance.owner)
            if ownerIndex >= self.decls.traitOwnerCount() { continue }
            val owner = self.decls.traitOwnerAt(index: ownerIndex)
            if owner.arity != source.traitInstance.positionalArgs.count() || !self.traitOwnerHasAssocId(owner: owner.nameStart, assocId: member) { continue }
            mut val present = false
            for val candidate in candidates { if self.semanticViewSourceEq(a: candidate, b: source) { present = true } }
            if !present { candidates.append(source) }
        }
        if candidates.count() == 1U64 { return <Result.Ok value=candidates[0U64] /> }
        val message = if candidates.count() == 0U64 { give "associated-type short projection has no unique trait source — write `T#Trait.Item` or add an appropriate `where T: Trait` bound (spec/08)" } else { give "associated-type short projection is ambiguous — write the canonical `T#Trait.Item` form (spec/08)" }
        return <Result.Err error=self.diagnosticAt(offset: site, msg: message, failureDomain: <FailureDomain.Source />) />
    }

    inout fn uniqueProjectionSource(t: TypeAst) -> Result[ResolvedViewSource, CompileDiagnostic] {
        try self.beginShortProjection(site: t.span.start)
        val result = self.uniqueProjectionSourceCore(t: t)
        self.lowerProjectionDepth -= 1U64
        return result
    }

    inout fn uniqueProjectionSourceCore(t: TypeAst) -> Result[ResolvedViewSource, CompileDiagnostic] {
        mut val sources: Array[ResolvedViewSource] = []
        mut val index = 0U64
        while index < self.lowerWhereTypes.count() && index < self.lowerWhereTraitTypes.count() {
            if self.boundLhsMatchesType(lhs: self.lowerWhereTypes[index], t: t) {
                val bound = try self.normalizeProjectionType(t: self.lowerWhereTraitTypes[index])
                val source = if bound.nameSpan.end > bound.nameSpan.start { give (try self.bindViewSourceName(siteOffset: bound.span.start, name: bound.nameSpan)) } else { give (try self.lowerViewSource(siteOffset: bound.span.start, text: bound.name)) }
                if self.traitOwnerHasAssocId(owner: source.traitInstance.owner, assocId: self.internBytes(s: t.projectionAssoc).nameId) {
                    val constraint = try self.decodeValueTraitConstraintArguments(traitType: bound, owner: source.traitInstance.owner, site: bound.span.start)
                    sources.append(source.withArguments(arguments: constraint.key.positionalArgs))
                }
            }
            index += 1U64
        }
        return self.chooseShortProjectionSource(sources: sources, member: self.internBytes(s: t.projectionAssoc).nameId, site: t.span.start)
    }

    inout fn boundLhsMatchesSyntaxType(lhs: TypeId, t: SyntaxType) -> Bool {
        val l: SyntaxType = syntaxType(file: self.syntax, id: lhs)
        if l.projectionAssoc.end > l.projectionAssoc.start { return false }
        if l.extView.end > l.extView.start { return false }
        if !(spansEqual(c: inout self, aStart: l.name.start, aLen: l.name.end - l.name.start, bStart: t.name.start, bLen: t.name.end - t.name.start)) { return false }
        if syntaxTypeArgCount(file: self.syntax, ty: l) != syntaxTypeArgCount(file: self.syntax, ty: t) { return false }
        mut val i: U64 = 0U64
        while i < syntaxTypeArgCount(file: self.syntax, ty: l) {
            val right: SyntaxType = syntaxType(file: self.syntax, id: syntaxTypeArg(file: self.syntax, ty: t, index: i))
            if !(self.boundLhsMatchesSyntaxType(lhs: syntaxTypeArg(file: self.syntax, ty: l, index: i), t: right)) { return false }
            i += 1U64
        }
        return true
    }

    // Both syntax adapters decode complete lexical constraints and use one
    // instance-level uniqueness decision. Raw syntax is not rewritten.
    inout fn uniqueSyntaxProjectionSource(t: SyntaxType) -> Result[ResolvedViewSource, CompileDiagnostic] {
        try self.beginShortProjection(site: t.span.start)
        val result = self.uniqueSyntaxProjectionSourceCore(t: t)
        self.lowerProjectionDepth -= 1U64
        return result
    }

    inout fn uniqueSyntaxProjectionSourceCore(t: SyntaxType) -> Result[ResolvedViewSource, CompileDiagnostic] {
        mut val sources: Array[ResolvedViewSource] = []
        mut val index = 0U64
        while index < self.lowerWhereSyntaxTypes.count() && index < self.lowerWhereSyntaxTraitTypes.count() {
            if self.boundLhsMatchesSyntaxType(lhs: self.lowerWhereSyntaxTypes[index], t: t) {
                val bound = try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: self.lowerWhereSyntaxTraitTypes[index]))
                val source = try self.bindViewSourceName(siteOffset: bound.span.start, name: bound.name)
                val member = intern(c: inout self, start: t.projectionAssoc.start, len: t.projectionAssoc.end - t.projectionAssoc.start)
                if self.traitOwnerHasAssocId(owner: source.traitInstance.owner, assocId: member) {
                    val constraint = try self.decodeSyntaxTraitConstraintArguments(traitType: bound, owner: source.traitInstance.owner, site: bound.span.start)
                    sources.append(source.withArguments(arguments: constraint.key.positionalArgs))
                }
            }
            index += 1U64
        }
        val member = intern(c: inout self, start: t.projectionAssoc.start, len: t.projectionAssoc.end - t.projectionAssoc.start)
        return self.chooseShortProjectionSource(sources: sources, member: member, site: t.span.start)
    }

    inout fn normalizeProjectionType(t: TypeAst) -> Result[TypeAst, CompileDiagnostic] {
        if t.namePath.count() != 0U64 {
            mut val names: Array[Span] = []
            mut val index = 0U64
            while index < t.namePath.count() { names.append(t.namePath[index].nameSpan) index += 1U64 }
            val headIndex = (try self.typePathHead(names: names))
            index = 0U64
            while index < headIndex {
                if t.namePath[index].args.count() != 0U64 { return <Result.Err error=self.diagnosticAt(offset: names[index].start, msg: "namespace segments do not accept type arguments") /> }
                index += 1U64
            }
            val head = t.namePath[headIndex]
            mut val associated = t.projectionAssoc
            mut val associatedSpan = t.projectionAssocSpan
            if headIndex + 1U64 < names.count() {
                val tail = t.namePath[headIndex + 1U64]
                if headIndex + 2U64 != names.count() || tail.args.count() != 0U64 || associated.bytes().count() != 0U64 {
                    return <Result.Err error=self.diagnosticAt(offset: tail.nameSpan.start, msg: "invalid associated-type projection path") />
                }
                associated = tail.name
                associatedSpan = tail.nameSpan
            }
            return self.normalizeProjectionType(t: <TypeAst name=head.name nameSpan=head.nameSpan args=head.args span=t.span extView=t.extView extViewSpan=t.extViewSpan viewNames=t.viewNames viewSources=t.viewSources viewNameSpans=t.viewNameSpans projectionTrait=t.projectionTrait projectionTraitSpan=t.projectionTraitSpan projectionTraitArgs=t.projectionTraitArgs projectionTraitArgLabels=t.projectionTraitArgLabels projectionTraitArgLabelSpans=t.projectionTraitArgLabelSpans projectionAssoc=associated projectionAssocSpan=associatedSpan isAny=t.isAny argLabels=head.argLabels argLabelSpans=head.argLabelSpans isSendable=t.isSendable isDiverging=t.isDiverging isRecord=t.isRecord />)
        }
        mut val args: Array[TypeAst] = []
        mut val i: U64 = 0
        while i < t.args.count() {
            args.append((try self.normalizeProjectionType(t: t.args[i])))
            i += 1
        }
        if t.projectionAssoc.bytes().count() > 0U64 && t.projectionTrait.bytes().count() == 0U64 {
            val moduleId = self.typeNamespaceModule(name: t.nameSpan)
            if moduleId != 4000000000U64 {
                self.recordNamespaceUse(name: t.projectionAssocSpan, moduleId: moduleId)
                return <Result.Ok value=<TypeAst name=t.projectionAssoc nameSpan=t.projectionAssocSpan args=args span=t.span extView=t.extView viewNames=t.viewNames viewSources=t.viewSources isAny=t.isAny argLabels=t.argLabels isSendable=t.isSendable isDiverging=t.isDiverging isRecord=t.isRecord /> />
            }
        }
        mut val projectionTraitArgs: Array[TypeAst] = []
        i = 0U64
        while i < t.projectionTraitArgs.count() {
            projectionTraitArgs.append((try self.normalizeProjectionType(t: t.projectionTraitArgs[i])))
            i += 1U64
        }
        return <Result.Ok value=<TypeAst name=t.name nameSpan=t.nameSpan args=args span=t.span extView=t.extView extViewSpan=t.extViewSpan viewNames=t.viewNames viewNameSpans=t.viewNameSpans viewSources=t.viewSources projectionTrait=t.projectionTrait projectionTraitSpan=t.projectionTraitSpan projectionTraitArgs=projectionTraitArgs projectionTraitArgLabels=t.projectionTraitArgLabels projectionTraitArgLabelSpans=t.projectionTraitArgLabelSpans projectionAssoc=t.projectionAssoc projectionAssocSpan=t.projectionAssocSpan isAny=t.isAny argLabels=t.argLabels argLabelSpans=t.argLabelSpans isSendable=t.isSendable isDiverging=t.isDiverging isRecord=t.isRecord /> />
    }

    inout fn normalizeParams(params: Array[ParamAst]) -> Result[Array[ParamAst], CompileDiagnostic] {
        mut val out: Array[ParamAst] = []
        mut val i: U64 = 0
        while i < params.count() {
            val p: ParamAst = params[i]
            out.append(<ParamAst name=p.name ty=(try self.normalizeProjectionType(t: p.ty)) isInout=p.isInout isMove=p.isMove isBorrow=p.isBorrow noLabel=p.noLabel hasDefault=p.hasDefault defaultVal=p.defaultVal span=p.span />)
            i += 1
        }
        return <Result.Ok value=out />
    }

    inout fn lowerTypeParamNames(names: Array[String], anchor: U64, sendableFlags: Array[Bool] = []) -> Result[Array[Bind], CompileDiagnostic] {
        mut val spans: Array[Bind] = []
        mut val i: U64 = 0
        while i < names.count() {
            spans.append(self.internBytes(s: names[i]))
            i += 1
        }
        return <Result.Ok value=(try self.lowerTypeParamBinds(names: spans, anchor: anchor, sendableFlags: sendableFlags)) />
    }

    // SyntaxFile already owns identifier spellings in the compiler source arena.
    // Preserve those spans instead of rebuilding String names solely to allocate
    // the same semantic generic binders.
    inout fn lowerTypeParamSpans(spans: Array[Span], anchor: U64, sendableFlags: Array[Bool] = []) -> Result[Array[Bind], CompileDiagnostic] {
        mut val names: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < spans.count() {
            val span: Span = spans[i]
            names.append(<Bind nameStart=span.start nameLen=span.end - span.start fieldStart=span.start fieldLen=span.end - span.start offset=span.start />)
            i += 1U64
        }
        return <Result.Ok value=(try self.lowerTypeParamBinds(names: names, anchor: anchor, sendableFlags: sendableFlags)) />
    }

    // The sole semantic binder sink for both value-AST and SyntaxFile decoders.
    // It assigns lexical ParamIds and enforces distinctness within one bracket list.
    inout fn lowerTypeParamBinds(names: Array[Bind], anchor: U64, sendableFlags: Array[Bool] = []) -> Result[Array[Bind], CompileDiagnostic] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < names.count() {
            val b: Bind = names[i]
            // A generic's own bracket list must have distinct names (spec/06): `f[T, T]`
            // is ambiguous. Checked per raw list, not a merged enclosing scope.
            val bId: U64 = intern(c: inout self, start: b.nameStart, len: b.nameLen)
            mut val k: U64 = 0
            while k < out.count() {
                if intern(c: inout self, start: out[k].nameStart, len: out[k].nameLen) == bId {
                    return <Result.Err error=self.diagnosticAt(offset: anchor, msg: "duplicate type-parameter name (each `[T]` in a generic must be distinct — spec/06)") />
                }
                k += 1
            }
            mut val isSendable: Bool = false
            if i < sendableFlags.count() {
                isSendable = sendableFlags[i]
            }
            val paramId: U64 = self.nextParamId
            self.nextParamId += 1U64
            out.append(<Bind nameStart=b.nameStart nameLen=b.nameLen nameId=bId paramId=paramId fieldStart=b.fieldStart fieldLen=b.fieldLen offset=b.offset isSendable=isSendable />)
            i += 1
        }
        return <Result.Ok value=out />
    }

    inout fn lowerFieldDef(f: FieldAst) -> Result[FieldDef, CompileDiagnostic] {
        val nm: Bind = self.internBytes(s: f.name)
        mut val tyStart: U64 = 0
        mut val tyLen: U64 = 0
        mut val tyIsArray: Bool = false
        mut val tyRef: U64 = 0
        if f.ty.name.bytes().count() > 0 || f.ty.isRecord {
            val pt: PType = (try self.lowerType(t: f.ty))
            tyStart = pt.start
            tyLen = pt.len
            tyIsArray = pt.isArray
            tyRef = pt.ref
        }
        mut val hasDefault: Bool = false
        mut val defaultVal: U64 = 0
        if f.hasDefault {
            defaultVal = (try self.lowerDefaultExpr(e: f.defaultVal))
            hasDefault = true
        }
        return <Result.Ok value=<FieldDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isMut=f.isMut hasDefault=hasDefault defaultVal=defaultVal vis=f.vis /> />
    }

    inout fn lowerSyntaxDeclTypeParams(d: SyntaxDecl) -> Result[Array[Bind], CompileDiagnostic] {
        mut val names: Array[Span] = []
        mut val flags: Array[Bool] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclTypeParamCount(file: self.syntax, decl: d) {
            names.append(syntaxDeclTypeParamSpan(file: self.syntax, decl: d, index: i))
            flags.append(syntaxDeclTypeParamIsSendable(file: self.syntax, decl: d, index: i))
            i += 1U64
        }
        return <Result.Ok value=(try self.lowerTypeParamSpans(spans: names, anchor: d.span.start, sendableFlags: flags)) />
    }

    inout fn lowerSyntaxFieldDef(f: SyntaxField) -> Result[FieldDef, CompileDiagnostic] {
        val pt: PType = (try self.lowerSyntaxType(id: f.ty))
        mut val defaultVal: U64 = 0U64
        if f.hasDefault { defaultVal = (try self.lowerSyntaxDefaultExpr(id: f.defaultVal)) }
        return <Result.Ok value=<FieldDef nameStart=f.name.start nameLen=f.name.end - f.name.start nameId=intern(c: inout self, start: f.name.start, len: f.name.end - f.name.start) tyStart=pt.start tyLen=pt.len tyNameId=intern(c: inout self, start: pt.start, len: pt.len) tyIsArray=pt.isArray ty=pt.ref isMut=f.isMut hasDefault=f.hasDefault defaultVal=defaultVal vis=f.vis /> />
    }

    // The declaration's own receiver preserves its lexical binder identities.
    // Synthetic methods use the same type contract as written impl methods.
    inout fn lowerDeclaredReceiver(nameStart: U64, nameLen: U64, parameters: Array[Bind], siteOffset: U64) -> U64 {
        mut val arguments: Array[U64] = []
        mut val index: U64 = 0U64
        while index < parameters.count() {
            val parameter = parameters[index]
            arguments.append(self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen paramId=parameter.paramId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />))
            index += 1U64
        }
        return self.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=arguments isRecord=false recordFieldLabels=[] recordFieldTerms=[] siteOffset=siteOffset />)
    }

    inout fn lowerSyntaxStructDecl(d: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        val typeParams: Array[Bind] = (try self.lowerSyntaxDeclTypeParams(d: d))
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val fields: Array[FieldDef] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclFieldCount(file: self.syntax, decl: d) {
            fields.append((try self.lowerSyntaxFieldDef(f: syntaxField(file: self.syntax, id: syntaxDeclField(file: self.syntax, decl: d, index: i)))))
            i += 1U64
        }
        if d.hasDeinit {
            val deinitName: Bind = self.internBytes(s: "deinit")
            val noParams: Array[Param] = []
            val body: U64 = (try self.lowerSyntaxBlock(id: d.deinitBody))
            val destructor = (try self.registerDeclaredFunc(f: <Func nameStart=deinitName.nameStart nameLen=deinitName.nameLen nameId=intern(c: inout self, start: deinitName.nameStart, len: deinitName.nameLen) recvId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) recvTy=self.lowerDeclaredReceiver(nameStart: d.name.start, nameLen: d.name.end - d.name.start, parameters: typeParams, siteOffset: d.name.start) typeParams=self.pushFuncBinds(binds: typeParams) params=self.pushFuncParams(params: noParams) hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=body hasRecv=true recvStart=d.name.start recvLen=d.name.end - d.name.start selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=d.span.start />))
            self.decls.deinits.append(destructor)
        }
        self.arena.registerStruct(<StructDef nameStart=d.name.start nameLen=d.name.end - d.name.start nameId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=typeParams fields=fields isUnique=d.isUnique isNonsendable=d.isNonsendable isExtern=false defOffset=d.span.start />)
        self.drainDerives(typeStart: d.name.start, typeLen: d.name.end - d.name.start, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
        return <Result.Ok value=() />
    }

    inout fn lowerSyntaxEnumDecl(d: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        val typeParams: Array[Bind] = (try self.lowerSyntaxDeclTypeParams(d: d))
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val variants: Array[Variant] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclVariantCount(file: self.syntax, decl: d) {
            val v: SyntaxVariant = syntaxVariant(file: self.syntax, id: syntaxDeclVariant(file: self.syntax, decl: d, index: i))
            mut val fields: Array[FieldDef] = []
            mut val j: U64 = 0U64
            while j < syntaxVariantFieldCount(file: self.syntax, variant: v) {
                fields.append((try self.lowerSyntaxFieldDef(f: syntaxField(file: self.syntax, id: syntaxVariantField(file: self.syntax, variant: v, index: j)))))
                j += 1U64
            }
            variants.append(<Variant nameStart=v.name.start nameLen=v.name.end - v.name.start nameId=intern(c: inout self, start: v.name.start, len: v.name.end - v.name.start) fields=fields />)
            i += 1U64
        }
        self.arena.registerEnum(<EnumDef nameStart=d.name.start nameLen=d.name.end - d.name.start nameId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=typeParams variants=variants isUnique=d.isUnique isNonsendable=d.isNonsendable defOffset=d.span.start />)
        self.drainDerives(typeStart: d.name.start, typeLen: d.name.end - d.name.start, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
        return <Result.Ok value=() />
    }

    inout fn lowerSyntaxDeclParams(d: SyntaxDecl) -> Result[Array[Param], CompileDiagnostic] {
        mut val out: Array[Param] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclParamCount(file: self.syntax, decl: d) {
            val p: SyntaxParam = syntaxParam(file: self.syntax, id: syntaxDeclParam(file: self.syntax, decl: d, index: i))
            val ty: PType = (try self.lowerSyntaxType(id: p.ty))
            mut val defaultExpr: U64 = 0U64
            if p.hasDefault { defaultExpr = (try self.lowerSyntaxDefaultExpr(id: p.defaultVal)) }
            val name: Bind = <Bind nameStart=p.name.start nameLen=p.name.end - p.name.start fieldStart=p.name.start fieldLen=p.name.end - p.name.start offset=p.name.start />
            out.append(self.appendLoweredParam(name: name, hasType: true, ty: ty, isInout: p.isInout, isMove: p.isMove, isBorrow: p.isBorrow, noLabel: p.noLabel, hasDefault: p.hasDefault, defaultExpr: defaultExpr))
            i += 1U64
        }
        return <Result.Ok value=out />
    }

    inout fn lowerSyntaxFuncDecl(d: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        val scope = self.sourceTypeUses.begin(kind: <SourceTypeScopeKind.FreeFunction />, anchor: d.name.start)
        val result = self.lowerSyntaxFuncDeclInSourceScope(d: d)
        if !self.sourceTypeUses.finish(token: scope, succeeded: result.isOk()) {
            return <Result.Err error=self.diagnosticAt(offset: d.name.start, msg: "invalid authored type scope restoration", failureDomain: <FailureDomain.Internal />) />
        }
        return result
    }

}

impl Comp {
    inout fn lowerSyntaxFuncDeclInSourceScope(d: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        val typeParams: Array[Bind] = (try self.lowerSyntaxDeclTypeParams(d: d))
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeId] = self.lowerWhereSyntaxTypes
        val savedWTr: Array[TypeId] = self.lowerWhereSyntaxTraitTypes
        self.cur.typeParams = typeParams
        mut val whereTypes: Array[TypeId] = []
        mut val whereTraits: Array[TypeId] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclWhereCount(file: self.syntax, decl: d) {
            whereTypes.append(syntaxDeclWhereType(file: self.syntax, decl: d, index: i))
            whereTraits.append(syntaxDeclWhereTraitType(file: self.syntax, decl: d, index: i))
            i += 1U64
        }
        self.lowerWhereSyntaxTypes = whereTypes
        self.lowerWhereSyntaxTraitTypes = whereTraits
        val params: Array[Param] = (try self.lowerSyntaxDeclParams(d: d))
        mut val retStart: U64 = 0U64
        mut val retLen: U64 = 0U64
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0U64
        mut val retUse = 0U64
        if d.hasRet {
            val pt: PType = (try self.lowerSyntaxType(id: d.ret))
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
            retUse = pt.authoredUse
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        try self.setAuthoredTypeUseRole(role: <SourceTypeUseRole.Body />, site: d.name.start)
        val body: U64 = (try self.lowerSyntaxBlock(id: d.body))
        try self.setAuthoredTypeUseRole(role: <SourceTypeUseRole.Declaration />, site: d.name.start)
        self.cur.lowerRetTy = savedRet
        val fnIdx: U64 = (try self.registerDeclaredFunc(f: <Func nameStart=d.name.start nameLen=d.name.end - d.name.start nameId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=self.pushFuncBinds(binds: typeParams) params=self.pushFuncParams(params: params) hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isDiverging=d.isDiverging isExposed=d.isExposed isExtern=false defOffset=d.name.start />))
        try self.appendSyntaxFuncBounds(fnIdx: fnIdx, decl: d)
        try self.bindAuthoredFunctionScope(scope: self.sourceTypeUses.currentScope(), function: fnIdx, site: d.name.start)
        mut val parameterUses: Array[U64] = []
        for parameter in params { parameterUses.append(parameter.authoredTypeUse) }
        if !self.sourceTypeUses.bindSignature(token: self.sourceTypeUses.currentScope(), function: fnIdx, parameters: parameterUses, result: retUse) {
            return <Result.Err error=self.diagnosticAt(offset: d.name.start, msg: "invalid authored signature binding", failureDomain: <FailureDomain.Internal />) />
        }
        self.cur.typeParams = savedTP
        self.lowerWhereSyntaxTypes = savedWT
        self.lowerWhereSyntaxTraitTypes = savedWTr
        self.drainDerives(typeStart: d.name.start, typeLen: d.name.end - d.name.start, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        return <Result.Ok value=() />
    }
}

pub impl Comp {

    inout fn lowerStructDecl(d: DeclAst) -> Result[(), CompileDiagnostic] {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = (try self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start, sendableFlags: d.typeParamSendable))
        // field types may reference `[T]` — make them the lowering-time scope so lowerType
        // marks type-parameter heads as skip (siteOffset 0). Restored at function end.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val fields: Array[FieldDef] = []
        mut val i: U64 = 0
        while i < d.fields.count() {
            fields.append((try self.lowerFieldDef(f: d.fields[i])))
            i += 1
        }
        // a `deinit { body }` lowers to a synthetic method `Type_deinit(Type self)`
        // (name span = the text "deinit") plus a self.decls.deinits record so scope-exit drops
        // fire it. Appended at the same point in self.arena.funcs as the native parser (during
        // this struct's processing), so the function stream order is preserved.
        if d.hasDeinit {
            val deinitN: Bind = self.internBytes(s: "deinit")
            val body: U64 = (try self.lowerBlock(b: d.deinitBody))
            val noParams: Array[Param] = []
            val destructor = (try self.registerDeclaredFunc(f: <Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout self, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) recvTy=self.lowerDeclaredReceiver(nameStart: nm.nameStart, nameLen: nm.nameLen, parameters: typeParams, siteOffset: d.nameSpan.start) typeParams=self.pushFuncBinds(binds: typeParams) params=self.pushFuncParams(params: noParams) hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=nm.nameStart recvLen=nm.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=d.span.start />))
            self.decls.deinits.append(destructor)
        }
        self.arena.registerStruct(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams fields=fields isUnique=d.isUnique isNonsendable=d.isNonsendable isExtern=false defOffset=d.span.start />)
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
        return <Result.Ok value=() />
    }

    inout fn lowerEnumDecl(d: DeclAst) -> Result[(), CompileDiagnostic] {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = (try self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start, sendableFlags: d.typeParamSendable))
        // variant payload types may reference `[T]` — see lowerStructDecl.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val variants: Array[Variant] = []
        mut val i: U64 = 0
        while i < d.variants.count() {
            val v: VariantAst = d.variants[i]
            val vn: Bind = self.internBytes(s: v.name)
            mut val vfields: Array[FieldDef] = []
            mut val j: U64 = 0
            while j < v.fields.count() {
                vfields.append((try self.lowerFieldDef(f: v.fields[j])))
                j += 1
            }
            variants.append(<Variant nameStart=vn.nameStart nameLen=vn.nameLen nameId=intern(c: inout self, start: vn.nameStart, len: vn.nameLen) fields=vfields />)
            i += 1
        }
        self.arena.registerEnum(<EnumDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams variants=variants isUnique=d.isUnique isNonsendable=d.isNonsendable defOffset=d.span.start />)
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
        return <Result.Ok value=() />
    }

    inout fn lowerFuncDecl(d: DeclAst) -> Result[(), CompileDiagnostic] {
        val scope = self.sourceTypeUses.begin(kind: <SourceTypeScopeKind.FreeFunction />, anchor: d.nameSpan.start)
        val result = self.lowerFuncDeclInSourceScope(d: d)
        if !self.sourceTypeUses.finish(token: scope, succeeded: result.isOk()) {
            return <Result.Err error=self.diagnosticAt(offset: d.nameSpan.start, msg: "invalid authored type scope restoration", failureDomain: <FailureDomain.Internal />) />
        }
        return result
    }

}

impl Comp {
    inout fn lowerFuncDeclInSourceScope(d: DeclAst) -> Result[(), CompileDiagnostic] {
        val nameStart: U64 = d.nameSpan.start
        val nameLen: U64 = d.nameSpan.end - d.nameSpan.start
        val typeParams: Array[Bind] = (try self.lowerTypeParamNames(names: d.typeParams, anchor: nameStart, sendableFlags: d.typeParamSendable))
        // param / return / body-local types may reference `[T]` — make them the lowering-time
        // scope so lowerType marks type-parameter heads as skip (siteOffset 0).
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeAst] = self.lowerWhereTypes
        val savedWTr: Array[TypeAst] = self.lowerWhereTraitTypes
        self.cur.typeParams = typeParams
        self.lowerWhereTypes = d.whereTypes
        self.lowerWhereTraitTypes = (try self.valueProjectionTraitTypes(subjects: d.whereTypes, names: d.whereTraits, types: d.whereTraitTypes))
        val normParams: Array[ParamAst] = (try self.normalizeParams(params: d.params))
        val params: Array[Param] = (try self.lowerParams(params: normParams))
        mut val retStart: U64 = 0
        mut val retLen: U64 = 0
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0
        mut val retUse = 0U64
        if d.hasRet {
            val pt: PType = (try self.lowerType(t: (try self.normalizeProjectionType(t: d.ret))))
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
            retUse = pt.authoredUse
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        try self.setAuthoredTypeUseRole(role: <SourceTypeUseRole.Body />, site: d.nameSpan.start)
        val body: U64 = (try self.lowerBlock(b: d.body))
        try self.setAuthoredTypeUseRole(role: <SourceTypeUseRole.Declaration />, site: d.nameSpan.start)
        self.cur.lowerRetTy = savedRet
        val fnIdx: U64 = (try self.registerDeclaredFunc(f: <Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) typeParams=self.pushFuncBinds(binds: typeParams) params=self.pushFuncParams(params: params) hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isDiverging=d.isDiverging isExposed=d.isExposed isExtern=false defOffset=nameStart />))
        // A `where T: P` is part of this function's declaration, not a later
        // name lookup.  Lower it while the same lexical binder scope that
        // lowered the parameters, return type, and body remains installed.
        // Restoring first loses T's ParamId and turns an unrelated global name
        // such as a user-written trait `T` into a false type-visibility error.
        try self.appendFuncBounds(fnIdx: fnIdx, params: d.whereParams, traits: d.whereTraits, types: d.whereTypes, traitTypes: d.whereTraitTypes)
        try self.bindAuthoredFunctionScope(scope: self.sourceTypeUses.currentScope(), function: fnIdx, site: d.nameSpan.start)
        mut val parameterUses: Array[U64] = []
        for parameter in params { parameterUses.append(parameter.authoredTypeUse) }
        if !self.sourceTypeUses.bindSignature(token: self.sourceTypeUses.currentScope(), function: fnIdx, parameters: parameterUses, result: retUse) {
            return <Result.Err error=self.diagnosticAt(offset: d.nameSpan.start, msg: "invalid authored signature binding", failureDomain: <FailureDomain.Internal />) />
        }
        self.cur.typeParams = savedTP
        self.lowerWhereTypes = savedWT
        self.lowerWhereTraitTypes = savedWTr
        // attach pending `@[...]` directives to this fn (a macro on a free function);
        // declStart/declEnd = the fn's source span for the gen harness slice.
        self.drainDerives(typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        return <Result.Ok value=() />
    }
}

pub impl Comp {

    inout fn lowerValueTraitConstraint(traitType: TypeAst, fnIdx: U64 = 18446744073709551615U64) -> Result[TraitConstraint, CompileDiagnostic] {
        val tn = self.lowerTypeName(name: traitType.name, span: traitType.nameSpan)
        val decoded = try self.decodeValueTraitConstraintArguments(traitType: traitType, owner: 0U64, site: traitType.span.start)
        val boundArgs = decoded.key.positionalArgs
        // Resolve the trait spelling at its authored use once.  An use
        // alias is a surface name, not the semantic trait identity stored
        // in a bound: every later proof/query must see the declaration
        // owner just as `impl … as Trait` does.
        // Resolve at the authored span even when the convenience spelling
        // was interned elsewhere: an alias must retain its declaration owner.
        mut val traitUseStart: U64 = tn.nameStart
        mut val traitUseLen: U64 = tn.nameLen
        // Some synthesized bounds carry the semantic TypeAst but no
        // source span.  A zero/empty span is not an authored lookup site;
        // keep the caller's spelling in that case rather than resolving
        // offset 0 in the entry module.
        if traitType.nameSpan.end > traitType.nameSpan.start {
            traitUseStart = traitType.nameSpan.start
            traitUseLen = traitType.nameSpan.end - traitType.nameSpan.start
        }
        val owner = if traitType.nameSpan.end == traitType.nameSpan.start && traitType.span.start != 0U64 {
            val selected = self.traitOwnerForSelector(siteOffset: traitType.span.start, text: traitType.name)
            val index = self.decls.traitOwnerIndex(offset: selected)
            give if index < self.decls.traitOwnerCount() && (boundArgs.count() == 0U64 || self.decls.traitOwnerAt(index: index).arity == boundArgs.count()) { give selected } else { give 0U64 }
        } else { give self.traitOwnerAtUse(start: traitUseStart, len: traitUseLen, arity: boundArgs.count(), openArgs: boundArgs.count() == 0U64) }
        mut val resolvedOwner: U64 = owner
        if resolvedOwner == 0U64 && self.modules.qualifiedUseIndex(offset: traitUseStart) >= self.modules.qualifiedUseCount() && fnIdx < self.arena.functionCount() {
            resolvedOwner = self.traitOwnerInScopeById(mod: self.moduleOf(offset: self.arena.functionAt(index: fnIdx).defOffset), nameId: tn.nameId, arity: boundArgs.count())
        }
        // A bound with no written positional arguments is open, not
        // necessarily an arity-zero trait (`where T: Add` means an
        // unspecified `Add[Rhs]`).  Resolve its lexical declaration only
        // when that surface is unique; a same-spelled ambiguity remains a
        // source error rather than silently picking an arity.
        if resolvedOwner == 0U64 && self.modules.qualifiedUseIndex(offset: traitUseStart) >= self.modules.qualifiedUseCount() && boundArgs.count() == 0U64 && fnIdx < self.arena.functionCount() {
            resolvedOwner = self.traitOwnerInScopeOpenById(mod: self.moduleOf(offset: self.arena.functionAt(index: fnIdx).defOffset), nameId: tn.nameId)
        }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=resolvedOwner positionalArgs=boundArgs /> positionalArgsOpen=decoded.positionalArgsOpen assocPredicates=decoded.assocPredicates /> />
    }

    inout fn appendFuncBounds(fnIdx: U64, params: Array[String], traits: Array[String], types: Array[TypeAst] = [], traitTypes: Array[TypeAst] = []) -> Result[(), CompileDiagnostic] {
        mut val i = 0U64
        while i < params.count() {
            val pn = self.internBytes(s: params[i])
            mut val traitType = <TypeAst name=traits[i] args=[] span=<Span start=0 end=0 /> />
            if i < traitTypes.count() { traitType = try self.normalizeProjectionType(t: traitTypes[i]) }
            mut val pty = 0U64
            if i < types.count() { pty = (try self.lowerType(t: (try self.normalizeProjectionType(t: types[i])))).ref }
            else { pty = self.simpleTypeRef(nameStart: pn.nameStart, nameLen: pn.nameLen) }
            val constraint = try self.lowerValueTraitConstraint(traitType: traitType, fnIdx: fnIdx)
            self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramTy=pty paramNameId=pn.nameId constraint=constraint />)
            i += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn appendSyntaxFuncBounds(fnIdx: U64, decl: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0U64
        while i < syntaxDeclWhereCount(file: self.syntax, decl: decl) {
            try self.appendSyntaxBound(fnIdx: fnIdx, param: syntaxDeclWhereParamSpan(file: self.syntax, decl: decl, index: i), rawTrait: syntaxDeclWhereTraitSpan(file: self.syntax, decl: decl, index: i), ty: syntaxDeclWhereType(file: self.syntax, decl: decl, index: i), traitTy: syntaxDeclWhereTraitType(file: self.syntax, decl: decl, index: i))
            i += 1U64
        }
        return <Result.Ok value=() />
    }

    // One semantic sink for every SyntaxFile where-clause owner.  Declaration,
    // impl and member readers differ only in how they enumerate their typed
    // pools; trait identity and associated-predicate construction live here.
    inout fn lowerSyntaxTraitConstraint(traitTy: TypeId, fnIdx: U64 = 18446744073709551615U64) -> Result[TraitConstraint, CompileDiagnostic] {
        val traitType: SyntaxType = (try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: traitTy)))
        val trait = traitType.name
        val decoded = try self.decodeSyntaxTraitConstraintArguments(traitType: traitType, owner: 0U64, site: trait.start)
        val args = decoded.key.positionalArgs
        val traitId: U64 = intern(c: inout self, start: trait.start, len: trait.end - trait.start)
        mut val owner: U64 = self.traitOwnerAtUse(start: trait.start, len: trait.end - trait.start, arity: args.count(), openArgs: args.count() == 0U64)
        if owner == 0U64 && self.modules.qualifiedUseIndex(offset: trait.start) >= self.modules.qualifiedUseCount() && fnIdx < self.arena.functionCount() { owner = self.traitOwnerInScopeById(mod: self.moduleOf(offset: self.arena.functionAt(index: fnIdx).defOffset), nameId: traitId, arity: args.count()) }
        if owner == 0U64 && self.modules.qualifiedUseIndex(offset: trait.start) >= self.modules.qualifiedUseCount() && args.count() == 0U64 && fnIdx < self.arena.functionCount() { owner = self.traitOwnerInScopeOpenById(mod: self.moduleOf(offset: self.arena.functionAt(index: fnIdx).defOffset), nameId: traitId) }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=args /> positionalArgsOpen=decoded.positionalArgsOpen assocPredicates=decoded.assocPredicates /> />
    }

    inout fn appendSyntaxBound(fnIdx: U64, param: Span, rawTrait: Span, ty: TypeId, traitTy: TypeId) -> Result[(), CompileDiagnostic] {
        val pty = (try self.lowerSyntaxType(id: ty)).ref
        val constraint = try self.lowerSyntaxTraitConstraint(traitTy: traitTy, fnIdx: fnIdx)
        self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=param.start paramLen=param.end - param.start paramTy=pty paramNameId=intern(c: inout self, start: param.start, len: param.end - param.start) constraint=constraint />)
        return <Result.Ok value=() />
    }
}
