// Part of the lowering pass (root: _.pw): struct / enum / function
// declaration lowering.

// Lower generic parameter names `[T, U]` (Array[String]) to the arena's Bind spans.

pub impl Comp {
    inout fn traitHasAssocId(traitId: U64, assocId: U64) -> Bool {
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val tr: TraitDef = self.decls.traits[ti]
            if tr.nameId == traitId {
                mut val ai: U64 = 0
                while ai < tr.assocTypes.count() {
                    if self.traitBindAt(binds: tr.assocTypes, index: ai).nameId == assocId {
                        return true
                    }
                    ai += 1
                }
            }
            ti += 1
        }
        return false
    }

    inout fn traitPositionalArity(traitId: U64) -> U64 {
        mut val ti: U64 = 0U64
        while ti < self.decls.traits.count() {
            val tr: TraitDef = self.decls.traits[ti]
            if tr.nameId == traitId { return tr.typeParams.count() }
            ti += 1U64
        }
        return 0U64
    }

    inout fn boundLhsMatchesType(lhs: TypeAst, t: TypeAst) -> Bool {
        if lhs.projectionAssoc.bytes().count() > 0 {
            return false
        }
        if lhs.extView.bytes().count() > 0 {
            return false
        }
        if lhs.name != t.name {
            return false
        }
        if lhs.args.count() != t.args.count() {
            return false
        }
        mut val i: U64 = 0
        while i < lhs.args.count() {
            if !(self.boundLhsMatchesType(lhs: lhs.args[i], t: t.args[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn uniqueProjectionTrait(t: TypeAst, whereTypes: Array[TypeAst], whereTraits: Array[String]) -> String {
        val assocN: Bind = self.internBytes(s: t.projectionAssoc)
        mut val found: String = ""
        mut val foundId: U64 = 0
        mut val count: U64 = 0
        mut val i: U64 = 0
        while i < whereTypes.count() {
            if self.boundLhsMatchesType(lhs: whereTypes[i], t: t) {
                if i < whereTraits.count() {
                    val trN: Bind = self.internBytes(s: whereTraits[i])
                    if self.traitHasAssocId(traitId: trN.nameId, assocId: assocN.nameId) {
                        if foundId != trN.nameId {
                            found = whereTraits[i]
                            foundId = trN.nameId
                            count += 1U64
                        }
                    }
                }
            }
            i += 1
        }
        if count == 1U64 {
            return found
        }
        if count == 0U64 {
            self.errorAt(offset: t.span.start, msg: "associated-type short projection has no unique trait source — write `T#Trait.Item` or add an appropriate `where T: Trait` bound (spec/08)")
        } else {
            self.errorAt(offset: t.span.start, msg: "associated-type short projection is ambiguous — write the canonical `T#Trait.Item` form (spec/08)")
        }
        return ""
    }

    inout fn boundLhsMatchesSyntaxType(lhs: TypeId, t: SyntaxType) -> Bool {
        val l: SyntaxType = syntaxType(file: self.syntax, id: lhs)
        if l.projectionAssoc.end > l.projectionAssoc.start { return false }
        if l.extView.end > l.extView.start { return false }
        if !(spansEqual(c: inout self, aStart: l.name.start, aLen: l.name.end - l.name.start, bStart: t.name.start, bLen: t.name.end - t.name.start)) { return false }
        if syntaxTypeArgCount(file: self.syntax, ty: l) != syntaxTypeArgCount(file: self.syntax, ty: t) { return false }
        mut val i: U64 = 0U64
        while i < syntaxTypeArgCount(file: self.syntax, ty: l) {
            val right: SyntaxType = syntaxType(file: self.syntax, id: syntaxTypeArg(file: self.syntax, ty: t, index: i))
            if !(self.boundLhsMatchesSyntaxType(lhs: syntaxTypeArg(file: self.syntax, ty: l, index: i), t: right)) { return false }
            i += 1U64
        }
        return true
    }

    // Resolve a short associated projection without allocating a replacement
    // SyntaxType node.  The immutable raw tree remains source truth; lowering
    // chooses the unique trait source as a local span for this semantic use.
    inout fn uniqueSyntaxProjectionTrait(t: SyntaxType) -> Span {
        val assocId: U64 = intern(c: inout self, start: t.projectionAssoc.start, len: t.projectionAssoc.end - t.projectionAssoc.start)
        mut val found: Span = <Span start=0U64 end=0U64 />
        mut val foundId: U64 = 0U64
        mut val count: U64 = 0U64
        mut val i: U64 = 0U64
        while i < self.lowerWhereSyntaxTypes.count() {
            if self.boundLhsMatchesSyntaxType(lhs: self.lowerWhereSyntaxTypes[i], t: t) {
                if i < self.lowerWhereSyntaxTraits.count() {
                    val traitSpan: Span = self.lowerWhereSyntaxTraits[i]
                    val traitId: U64 = intern(c: inout self, start: traitSpan.start, len: traitSpan.end - traitSpan.start)
                    if self.traitHasAssocId(traitId: traitId, assocId: assocId) {
                        if foundId != traitId {
                            found = traitSpan
                            foundId = traitId
                            count += 1U64
                        }
                    }
                }
            }
            i += 1U64
        }
        if count == 1U64 { return found }
        if count == 0U64 {
            self.errorAt(offset: t.span.start, msg: "associated-type short projection has no unique trait source — write `T#Trait.Item` or add an appropriate `where T: Trait` bound (spec/08)")
        } else {
            self.errorAt(offset: t.span.start, msg: "associated-type short projection is ambiguous — write the canonical `T#Trait.Item` form (spec/08)")
        }
        return <Span start=0U64 end=0U64 />
    }

    inout fn normalizeProjectionType(t: TypeAst, whereTypes: Array[TypeAst], whereTraits: Array[String]) -> TypeAst {
        mut val args: Array[TypeAst] = []
        mut val i: U64 = 0
        while i < t.args.count() {
            args.append(self.normalizeProjectionType(t: t.args[i], whereTypes: whereTypes, whereTraits: whereTraits))
            i += 1
        }
        mut val projectionTrait: String = t.projectionTrait
        if t.projectionAssoc.bytes().count() > 0 {
            if projectionTrait.bytes().count() == 0 {
                projectionTrait = self.uniqueProjectionTrait(t: t, whereTypes: whereTypes, whereTraits: whereTraits)
            } else {
                val traitN: Bind = self.internBytes(s: projectionTrait)
                // The spelling may be an import alias.  Resolve it at this
                // authored type site before comparing arity; a global
                // name-id scan would pick an unrelated same-spelled trait.
                val owner: U64 = self.traitOwnerAtUse(start: traitN.nameStart, len: traitN.nameLen, arity: t.projectionTraitArgs.count())
                if owner == 0U64 {
                    self.errorAt(offset: t.span.start, msg: "associated-type projection must specify the trait's positional type arguments")
                }
                mut val pi: U64 = 0U64
                while pi < t.projectionTraitArgLabels.count() {
                    if t.projectionTraitArgLabels[pi].bytes().count() > 0U64 {
                        self.errorAt(offset: t.span.start, msg: "associated-type projection source accepts positional trait type arguments only")
                    }
                    pi += 1U64
                }
            }
        }
        mut val projectionTraitArgs: Array[TypeAst] = []
        i = 0U64
        while i < t.projectionTraitArgs.count() {
            projectionTraitArgs.append(self.normalizeProjectionType(t: t.projectionTraitArgs[i], whereTypes: whereTypes, whereTraits: whereTraits))
            i += 1U64
        }
        return <TypeAst name=t.name args=args span=t.span extView=t.extView viewNames=t.viewNames projectionTrait=projectionTrait projectionTraitArgs=projectionTraitArgs projectionTraitArgLabels=t.projectionTraitArgLabels projectionAssoc=t.projectionAssoc isAny=t.isAny argLabels=t.argLabels isSendable=t.isSendable isRecord=t.isRecord />
    }

    inout fn normalizeProjectionTypeActive(t: TypeAst) -> TypeAst {
        return self.normalizeProjectionType(t: t, whereTypes: self.lowerWhereTypes, whereTraits: self.lowerWhereTraits)
    }

    inout fn normalizeParams(params: Array[ParamAst], whereTypes: Array[TypeAst], whereTraits: Array[String]) -> Array[ParamAst] {
        mut val out: Array[ParamAst] = []
        mut val i: U64 = 0
        while i < params.count() {
            val p: ParamAst = params[i]
            out.append(<ParamAst name=p.name ty=self.normalizeProjectionType(t: p.ty, whereTypes: whereTypes, whereTraits: whereTraits) isInout=p.isInout isMove=p.isMove isBorrow=p.isBorrow noLabel=p.noLabel hasDefault=p.hasDefault defaultVal=p.defaultVal span=p.span />)
            i += 1
        }
        return out
    }

    inout fn lowerTypeParamNames(names: Array[String], anchor: U64, sendableFlags: Array[Bool] = []) -> Array[Bind] {
        mut val spans: Array[Bind] = []
        mut val i: U64 = 0
        while i < names.count() {
            spans.append(self.internBytes(s: names[i]))
            i += 1
        }
        return self.lowerTypeParamBinds(names: spans, anchor: anchor, sendableFlags: sendableFlags)
    }

    // SyntaxFile already owns identifier spellings in the compiler source arena.
    // Preserve those spans instead of rebuilding String names solely to allocate
    // the same semantic generic binders.
    inout fn lowerTypeParamSpans(spans: Array[Span], anchor: U64, sendableFlags: Array[Bool] = []) -> Array[Bind] {
        mut val names: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < spans.count() {
            val span: Span = spans[i]
            names.append(<Bind nameStart=span.start nameLen=span.end - span.start fieldStart=span.start fieldLen=span.end - span.start offset=span.start />)
            i += 1U64
        }
        return self.lowerTypeParamBinds(names: names, anchor: anchor, sendableFlags: sendableFlags)
    }

    // The sole semantic binder sink for both value-AST and SyntaxFile decoders.
    // It assigns lexical ParamIds and enforces distinctness within one bracket list.
    inout fn lowerTypeParamBinds(names: Array[Bind], anchor: U64, sendableFlags: Array[Bool] = []) -> Array[Bind] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0U64
        while i < names.count() {
            val b: Bind = names[i]
            // A generic's own bracket list must have distinct names (spec/06): `f[T, T]`
            // is ambiguous. Checked per raw list, not a merged enclosing scope.
            val bId: U64 = intern(c: inout self, start: b.nameStart, len: b.nameLen)
            mut val k: U64 = 0
            while k < out.count() {
                if intern(c: inout self, start: out[k].nameStart, len: out[k].nameLen) == bId {
                    self.errorAt(offset: anchor, msg: "duplicate type-parameter name (each `[T]` in a generic must be distinct — spec/06)")
                }
                k += 1
            }
            mut val isSendable: Bool = false
            if i < sendableFlags.count() {
                isSendable = sendableFlags[i]
            }
            val paramId: U64 = self.nextParamId
            self.nextParamId += 1U64
            out.append(<Bind nameStart=b.nameStart nameLen=b.nameLen nameId=bId paramId=paramId fieldStart=b.fieldStart fieldLen=b.fieldLen offset=b.offset isSendable=isSendable />)
            i += 1
        }
        return out
    }

    inout fn lowerFieldDef(f: FieldAst) -> FieldDef {
        val nm: Bind = self.internBytes(s: f.name)
        mut val tyStart: U64 = 0
        mut val tyLen: U64 = 0
        mut val tyIsArray: Bool = false
        mut val tyRef: U64 = 0
        if f.ty.name.bytes().count() > 0 || f.ty.isRecord {
            val pt: PType = self.lowerType(t: f.ty)
            tyStart = pt.start
            tyLen = pt.len
            tyIsArray = pt.isArray
            tyRef = pt.ref
        }
        mut val hasDefault: Bool = false
        mut val defaultVal: U64 = 0
        if f.hasDefault {
            defaultVal = self.lowerExpr(e: f.defaultVal)
            hasDefault = true
        }
        return <FieldDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isMut=f.isMut hasDefault=hasDefault defaultVal=defaultVal vis=f.vis />
    }

    inout fn lowerSyntaxDeclTypeParams(d: SyntaxDecl) -> Array[Bind] {
        mut val names: Array[Span] = []
        mut val flags: Array[Bool] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclTypeParamCount(file: self.syntax, decl: d) {
            names.append(syntaxDeclTypeParamSpan(file: self.syntax, decl: d, index: i))
            flags.append(syntaxDeclTypeParamIsSendable(file: self.syntax, decl: d, index: i))
            i += 1U64
        }
        return self.lowerTypeParamSpans(spans: names, anchor: d.span.start, sendableFlags: flags)
    }

    inout fn lowerSyntaxFieldDef(f: SyntaxField) -> FieldDef {
        val pt: PType = self.lowerSyntaxType(id: f.ty)
        mut val defaultVal: U64 = 0U64
        if f.hasDefault { defaultVal = self.lowerSyntaxExpr(id: f.defaultVal) }
        return <FieldDef nameStart=f.name.start nameLen=f.name.end - f.name.start nameId=intern(c: inout self, start: f.name.start, len: f.name.end - f.name.start) tyStart=pt.start tyLen=pt.len tyNameId=intern(c: inout self, start: pt.start, len: pt.len) tyIsArray=pt.isArray ty=pt.ref isMut=f.isMut hasDefault=f.hasDefault defaultVal=defaultVal vis=f.vis />
    }

    inout fn lowerSyntaxStructDecl(d: SyntaxDecl) {
        val typeParams: Array[Bind] = self.lowerSyntaxDeclTypeParams(d: d)
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val fields: Array[FieldDef] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclFieldCount(file: self.syntax, decl: d) {
            fields.append(self.lowerSyntaxFieldDef(f: syntaxField(file: self.syntax, id: syntaxDeclField(file: self.syntax, decl: d, index: i))))
            i += 1U64
        }
        if d.hasDeinit {
            val deinitName: Bind = self.internBytes(s: "deinit")
            val noParams: Array[Param] = []
            val noTypeParams: Array[Bind] = []
            val body: U64 = self.lowerSyntaxBlock(id: d.deinitBody)
            self.registerDeclaredFunc(f: <Func nameStart=deinitName.nameStart nameLen=deinitName.nameLen nameId=intern(c: inout self, start: deinitName.nameStart, len: deinitName.nameLen) recvId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=self.pushFuncBinds(binds: noTypeParams) params=self.pushFuncParams(params: noParams) hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=body hasRecv=true recvStart=d.name.start recvLen=d.name.end - d.name.start selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=d.span.start />)
            self.decls.deinits.append(<Bind nameStart=d.name.start nameLen=d.name.end - d.name.start fieldStart=d.name.start fieldLen=d.name.end - d.name.start />)
        }
        self.arena.structs.append(<StructDef nameStart=d.name.start nameLen=d.name.end - d.name.start nameId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=typeParams fields=fields isUnique=d.isUnique isNonsendable=d.isNonsendable isExtern=false defOffset=d.span.start />)
        self.drainDerives(typeStart: d.name.start, typeLen: d.name.end - d.name.start, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerSyntaxEnumDecl(d: SyntaxDecl) {
        val typeParams: Array[Bind] = self.lowerSyntaxDeclTypeParams(d: d)
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val variants: Array[Variant] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclVariantCount(file: self.syntax, decl: d) {
            val v: SyntaxVariant = syntaxVariant(file: self.syntax, id: syntaxDeclVariant(file: self.syntax, decl: d, index: i))
            mut val fields: Array[FieldDef] = []
            mut val j: U64 = 0U64
            while j < syntaxVariantFieldCount(file: self.syntax, variant: v) {
                fields.append(self.lowerSyntaxFieldDef(f: syntaxField(file: self.syntax, id: syntaxVariantField(file: self.syntax, variant: v, index: j))))
                j += 1U64
            }
            variants.append(<Variant nameStart=v.name.start nameLen=v.name.end - v.name.start nameId=intern(c: inout self, start: v.name.start, len: v.name.end - v.name.start) fields=fields />)
            i += 1U64
        }
        self.arena.enums.append(<EnumDef nameStart=d.name.start nameLen=d.name.end - d.name.start nameId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=typeParams variants=variants isUnique=d.isUnique isNonsendable=d.isNonsendable defOffset=d.span.start />)
        self.drainDerives(typeStart: d.name.start, typeLen: d.name.end - d.name.start, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerSyntaxDeclParams(d: SyntaxDecl) -> Array[Param] {
        mut val out: Array[Param] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclParamCount(file: self.syntax, decl: d) {
            val p: SyntaxParam = syntaxParam(file: self.syntax, id: syntaxDeclParam(file: self.syntax, decl: d, index: i))
            val ty: PType = self.lowerSyntaxType(id: p.ty)
            mut val defaultExpr: U64 = 0U64
            if p.hasDefault { defaultExpr = self.lowerSyntaxExpr(id: p.defaultVal) }
            val name: Bind = <Bind nameStart=p.name.start nameLen=p.name.end - p.name.start fieldStart=p.name.start fieldLen=p.name.end - p.name.start offset=p.name.start />
            out.append(self.appendLoweredParam(name: name, hasType: true, ty: ty, isInout: p.isInout, isMove: p.isMove, isBorrow: p.isBorrow, noLabel: p.noLabel, hasDefault: p.hasDefault, defaultExpr: defaultExpr))
            i += 1U64
        }
        return out
    }

    inout fn lowerSyntaxFuncDecl(d: SyntaxDecl) {
        val typeParams: Array[Bind] = self.lowerSyntaxDeclTypeParams(d: d)
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeId] = self.lowerWhereSyntaxTypes
        val savedWTr: Array[Span] = self.lowerWhereSyntaxTraits
        self.cur.typeParams = typeParams
        mut val whereTypes: Array[TypeId] = []
        mut val whereTraits: Array[Span] = []
        mut val i: U64 = 0U64
        while i < syntaxDeclWhereCount(file: self.syntax, decl: d) {
            whereTypes.append(syntaxDeclWhereType(file: self.syntax, decl: d, index: i))
            whereTraits.append(syntaxDeclWhereTraitSpan(file: self.syntax, decl: d, index: i))
            i += 1U64
        }
        self.lowerWhereSyntaxTypes = whereTypes
        self.lowerWhereSyntaxTraits = whereTraits
        val params: Array[Param] = self.lowerSyntaxDeclParams(d: d)
        mut val retStart: U64 = 0U64
        mut val retLen: U64 = 0U64
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0U64
        if d.hasRet {
            val pt: PType = self.lowerSyntaxType(id: d.ret)
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        val body: U64 = self.lowerSyntaxBlock(id: d.body)
        self.cur.lowerRetTy = savedRet
        val fnIdx: U64 = self.registerDeclaredFunc(f: <Func nameStart=d.name.start nameLen=d.name.end - d.name.start nameId=intern(c: inout self, start: d.name.start, len: d.name.end - d.name.start) typeParams=self.pushFuncBinds(binds: typeParams) params=self.pushFuncParams(params: params) hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isExtern=false defOffset=d.name.start />)
        self.appendSyntaxFuncBounds(fnIdx: fnIdx, decl: d)
        self.cur.typeParams = savedTP
        self.lowerWhereSyntaxTypes = savedWT
        self.lowerWhereSyntaxTraits = savedWTr
        self.drainDerives(typeStart: d.name.start, typeLen: d.name.end - d.name.start, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
    }

    inout fn lowerStructDecl(d: DeclAst) {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start, sendableFlags: d.typeParamSendable)
        // field types may reference `[T]` — make them the lowering-time scope so lowerType
        // marks type-parameter heads as skip (siteOffset 0). Restored at function end.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val fields: Array[FieldDef] = []
        mut val i: U64 = 0
        while i < d.fields.count() {
            fields.append(self.lowerFieldDef(f: d.fields[i]))
            i += 1
        }
        // a `deinit { body }` lowers to a synthetic method `Type_deinit(Type self)`
        // (name span = the text "deinit") plus a self.decls.deinits record so scope-exit drops
        // fire it. Appended at the same point in self.arena.funcs as the native parser (during
        // this struct's processing), so the function stream order is preserved.
        if d.hasDeinit {
            val deinitN: Bind = self.internBytes(s: "deinit")
            val body: U64 = self.lowerBlock(b: d.deinitBody)
            val noParams: Array[Param] = []
            val noTypeParams: Array[Bind] = []
            self.registerDeclaredFunc(f: <Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout self, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=self.pushFuncBinds(binds: noTypeParams) params=self.pushFuncParams(params: noParams) hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=nm.nameStart recvLen=nm.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=d.span.start />)
            self.decls.deinits.append(<Bind nameStart=nm.nameStart nameLen=nm.nameLen fieldStart=nm.nameStart fieldLen=nm.nameLen />)
        }
        self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams fields=fields isUnique=d.isUnique isNonsendable=d.isNonsendable isExtern=false defOffset=d.span.start />)
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerEnumDecl(d: DeclAst) {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start, sendableFlags: d.typeParamSendable)
        // variant payload types may reference `[T]` — see lowerStructDecl.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val variants: Array[Variant] = []
        mut val i: U64 = 0
        while i < d.variants.count() {
            val v: VariantAst = d.variants[i]
            val vn: Bind = self.internBytes(s: v.name)
            mut val vfields: Array[FieldDef] = []
            mut val j: U64 = 0
            while j < v.fields.count() {
                vfields.append(self.lowerFieldDef(f: v.fields[j]))
                j += 1
            }
            variants.append(<Variant nameStart=vn.nameStart nameLen=vn.nameLen nameId=intern(c: inout self, start: vn.nameStart, len: vn.nameLen) fields=vfields />)
            i += 1
        }
        self.arena.enums.append(<EnumDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams variants=variants isUnique=d.isUnique isNonsendable=d.isNonsendable defOffset=d.span.start />)
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerFuncDecl(d: DeclAst) {
        val nameStart: U64 = d.nameSpan.start
        val nameLen: U64 = d.nameSpan.end - d.nameSpan.start
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: nameStart, sendableFlags: d.typeParamSendable)
        // param / return / body-local types may reference `[T]` — make them the lowering-time
        // scope so lowerType marks type-parameter heads as skip (siteOffset 0).
        val savedTP: Array[Bind] = self.cur.typeParams
        val savedWT: Array[TypeAst] = self.lowerWhereTypes
        val savedWTr: Array[String] = self.lowerWhereTraits
        self.cur.typeParams = typeParams
        self.lowerWhereTypes = d.whereTypes
        self.lowerWhereTraits = d.whereTraits
        val normParams: Array[ParamAst] = self.normalizeParams(params: d.params, whereTypes: d.whereTypes, whereTraits: d.whereTraits)
        val params: Array[Param] = self.lowerParams(params: normParams)
        mut val retStart: U64 = 0
        mut val retLen: U64 = 0
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0
        if d.hasRet {
            val pt: PType = self.lowerType(t: self.normalizeProjectionType(t: d.ret, whereTypes: d.whereTypes, whereTraits: d.whereTraits))
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        val body: U64 = self.lowerBlock(b: d.body)
        self.cur.lowerRetTy = savedRet
        val fnIdx: U64 = self.registerDeclaredFunc(f: <Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) typeParams=self.pushFuncBinds(binds: typeParams) params=self.pushFuncParams(params: params) hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isExtern=false defOffset=nameStart />)
        // A `where T: P` is part of this function's declaration, not a later
        // name lookup.  Lower it while the same lexical binder scope that
        // lowered the parameters, return type, and body remains installed.
        // Restoring first loses T's ParamId and turns an unrelated global name
        // such as a user-written trait `T` into a false type-visibility error.
        self.appendFuncBounds(fnIdx: fnIdx, params: d.whereParams, traits: d.whereTraits, types: d.whereTypes, traitTypes: d.whereTraitTypes)
        self.cur.typeParams = savedTP
        self.lowerWhereTypes = savedWT
        self.lowerWhereTraits = savedWTr
        // attach pending `@[...]` directives to this fn (a macro on a free function);
        // declStart/declEnd = the fn's source span for the gen harness slice.
        self.drainDerives(typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
    }

    inout fn appendFuncBounds(fnIdx: U64, params: Array[String], traits: Array[String], types: Array[TypeAst] = [], traitTypes: Array[TypeAst] = []) {
        mut val i: U64 = 0
        while i < params.count() {
            val pn: Bind = self.internBytes(s: params[i])
            val tn: Bind = self.internBytes(s: traits[i])
            mut val pty: U64 = 0
            if i < types.count() {
                pty = self.lowerType(t: self.normalizeProjectionType(t: types[i], whereTypes: types, whereTraits: traits)).ref
            } else {
                pty = self.simpleTypeRef(nameStart: pn.nameStart, nameLen: pn.nameLen)
            }
            mut val boundArgs: Array[U64] = []
            mut val boundAssocNames: Array[U64] = []
            mut val boundAssocValues: Array[U64] = []
            if i < traitTypes.count() {
                mut val ai: U64 = 0U64
                while ai < traitTypes[i].args.count() {
                    val boundRef: U64 = self.lowerType(t: self.normalizeProjectionType(t: traitTypes[i].args[ai], whereTypes: types, whereTraits: traits)).ref
                    mut val label: U64 = 0U64
                    if ai < traitTypes[i].argLabels.count() && traitTypes[i].argLabels[ai].bytes().count() > 0U64 {
                        val labelBind: Bind = self.internBytes(s: traitTypes[i].argLabels[ai])
                        label = labelBind.nameId
                    }
                    if label == 0U64 { boundArgs.append(boundRef) }
                    else {
                        boundAssocNames.append(label)
                        boundAssocValues.append(boundRef)
                    }
                    ai += 1U64
                }
            }
            // Resolve the trait spelling at its authored use once.  An import
            // alias is a surface name, not the semantic trait identity stored
            // in a bound: every later proof/query must see the declaration
            // owner just as `impl … as Trait` does.
            // `traits[i]` is a convenience spelling and may have been
            // re-interned away from the authored `where` clause.  Trait
            // identity is resolved at that use site: `where T: BP` must
            // retain B.P rather than some same-spelled imported P.
            mut val traitUseStart: U64 = tn.nameStart
            mut val traitUseLen: U64 = tn.nameLen
            // Some synthesized bounds carry the semantic TypeAst but no
            // source span.  A zero/empty span is not an authored lookup site;
            // keep the caller's spelling in that case rather than resolving
            // offset 0 in the entry module.
            if i < traitTypes.count() && traitTypes[i].span.end > traitTypes[i].span.start {
                traitUseStart = traitTypes[i].span.start
                traitUseLen = traitTypes[i].name.bytes().count()
            }
            val owner: U64 = self.traitOwnerAtUse(start: traitUseStart, len: traitUseLen, arity: boundArgs.count())
            mut val resolvedOwner: U64 = owner
            if resolvedOwner == 0U64 && fnIdx < self.arena.funcs.count() {
                resolvedOwner = self.traitOwnerInScopeById(mod: self.moduleOf(offset: self.arena.funcs[fnIdx].defOffset), nameId: tn.nameId, arity: boundArgs.count())
            }
            // A bound with no written positional arguments is open, not
            // necessarily an arity-zero trait (`where T: Add` means an
            // unspecified `Add[Rhs]`).  Resolve its lexical declaration only
            // when that surface is unique; a same-spelled ambiguity remains a
            // source error rather than silently picking an arity.
            if resolvedOwner == 0U64 && boundArgs.count() == 0U64 && fnIdx < self.arena.funcs.count() {
                resolvedOwner = self.traitOwnerInScopeOpenById(mod: self.moduleOf(offset: self.arena.funcs[fnIdx].defOffset), nameId: tn.nameId)
            }
            if resolvedOwner != 0U64 {
            }
            mut val predicates: Array[TraitAssocPredicate] = []
            mut val pi: U64 = 0U64
            while pi < boundAssocNames.count() && pi < boundAssocValues.count() {
                predicates.append(<TraitAssocPredicate member=boundAssocNames[pi] value=boundAssocValues[pi] span=traitUseStart />)
                pi += 1U64
            }
            // An empty authored argument list is an open bound (`T: Add`),
            // including when Add happens to have arity zero.  The latter has
            // identical observable matching today, while retaining this bit
            // makes the distinction available without reopening FuncBound's
            // legacy arrays.
            val constraint: TraitConstraint = <TraitConstraint key=<TraitInstanceKey owner=resolvedOwner positionalArgs=boundArgs /> positionalArgsOpen=boundArgs.count() == 0U64 assocPredicates=predicates />
            self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramTy=pty paramNameId=pn.nameId constraint=constraint />)
            i += 1
        }
    }

    inout fn appendSyntaxFuncBounds(fnIdx: U64, decl: SyntaxDecl) {
        mut val i: U64 = 0U64
        while i < syntaxDeclWhereCount(file: self.syntax, decl: decl) {
            self.appendSyntaxBound(fnIdx: fnIdx, param: syntaxDeclWhereParamSpan(file: self.syntax, decl: decl, index: i), trait: syntaxDeclWhereTraitSpan(file: self.syntax, decl: decl, index: i), ty: syntaxDeclWhereType(file: self.syntax, decl: decl, index: i), traitTy: syntaxDeclWhereTraitType(file: self.syntax, decl: decl, index: i))
            i += 1U64
        }
    }

    // One semantic sink for every SyntaxFile where-clause owner.  Declaration,
    // impl and member readers differ only in how they enumerate their typed
    // pools; trait identity and associated-predicate construction live here.
    inout fn appendSyntaxBound(fnIdx: U64, param: Span, trait: Span, ty: TypeId, traitTy: TypeId) {
        val pty: U64 = self.lowerSyntaxType(id: ty).ref
        val traitType: SyntaxType = syntaxType(file: self.syntax, id: traitTy)
        mut val args: Array[U64] = []
        mut val assocNames: Array[U64] = []
        mut val assocValues: Array[U64] = []
        mut val ai: U64 = 0U64
        while ai < syntaxTypeArgCount(file: self.syntax, ty: traitType) {
            val arg: U64 = self.lowerSyntaxType(id: syntaxTypeArg(file: self.syntax, ty: traitType, index: ai)).ref
            val label: Span = syntaxTypeArgLabel(file: self.syntax, ty: traitType, index: ai)
            if label.end > label.start {
                assocNames.append(intern(c: inout self, start: label.start, len: label.end - label.start))
                assocValues.append(arg)
            } else { args.append(arg) }
            ai += 1U64
        }
        val traitId: U64 = intern(c: inout self, start: trait.start, len: trait.end - trait.start)
        mut val owner: U64 = self.traitOwnerAtUse(start: trait.start, len: trait.end - trait.start, arity: args.count())
        if owner == 0U64 && fnIdx < self.arena.funcs.count() { owner = self.traitOwnerInScopeById(mod: self.moduleOf(offset: self.arena.funcs[fnIdx].defOffset), nameId: traitId, arity: args.count()) }
        if owner == 0U64 && args.count() == 0U64 && fnIdx < self.arena.funcs.count() { owner = self.traitOwnerInScopeOpenById(mod: self.moduleOf(offset: self.arena.funcs[fnIdx].defOffset), nameId: traitId) }
        mut val predicates: Array[TraitAssocPredicate] = []
        ai = 0U64
        while ai < assocNames.count() && ai < assocValues.count() {
            predicates.append(<TraitAssocPredicate member=assocNames[ai] value=assocValues[ai] span=trait.start />)
            ai += 1U64
        }
        self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=param.start paramLen=param.end - param.start paramTy=pty paramNameId=intern(c: inout self, start: param.start, len: param.end - param.start) constraint=<TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=args /> positionalArgsOpen=args.count() == 0U64 assocPredicates=predicates /> />)
    }
}
