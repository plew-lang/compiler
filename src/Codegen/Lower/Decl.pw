// Part of the lowering pass (root: _.pw): struct / enum / function
// declaration lowering.

// Lower generic parameter names `[T, U]` (Array[String]) to the arena's Bind spans.

pub impl Comp {
    inout fn lowerTypeParamNames(names: Array[String], anchor: U64) -> Array[Bind] {
        mut val out: Array[Bind] = []
        mut val i: U64 = 0
        while i < names.count() {
            val b: Bind = self.internBytes(s: names[i])
            // a generic's own bracket list must have distinct names (spec/06): `f[T, T]`
            // is ambiguous. Checked per RAW list (not the merged impl++method list, where
            // an impl param and a method param may legitimately share a name = shadowing).
            // `anchor` is the owning declaration's source offset (the Bind spans are
            // interned = map to no source file).
            val bId: U64 = intern(c: inout self, start: b.nameStart, len: b.nameLen)
            mut val k: U64 = 0
            while k < out.count() {
                if intern(c: inout self, start: out[k].nameStart, len: out[k].nameLen) == bId {
                    self.errorAt(offset: anchor, msg: "duplicate type-parameter name (each `[T]` in a generic must be distinct — spec/06)")
                }
                k += 1
            }
            out.append(b)
            i += 1
        }
        return out
    }

    inout fn lowerFieldDef(f: FieldAst) -> FieldDef {
        val nm: Bind = self.internBytes(s: f.name)
        mut val tyStart: U64 = 0
        mut val tyLen: U64 = 0
        mut val tyIsArray: Bool = false
        mut val tyRef: U64 = 0
        if f.ty.name.bytes().count() > 0 || f.ty.isRecord {
            val pt: PType = self.lowerType(t: f.ty)
            tyStart = pt.start
            tyLen = pt.len
            tyIsArray = pt.isArray
            tyRef = pt.ref
        }
        mut val hasDefault: Bool = false
        mut val defaultVal: U64 = 0
        if f.hasDefault {
            defaultVal = self.lowerExpr(e: f.defaultVal)
            hasDefault = true
        }
        return <FieldDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isMut=f.isMut hasDefault=hasDefault defaultVal=defaultVal vis=f.vis />
    }

    inout fn lowerStructDecl(d: DeclAst) {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start)
        // field types may reference `[T]` — make them the lowering-time scope so lowerType
        // marks type-parameter heads as skip (siteOffset 0). Restored at function end.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val fields: Array[FieldDef] = []
        mut val i: U64 = 0
        while i < d.fields.count() {
            fields.append(self.lowerFieldDef(f: d.fields[i]))
            i += 1
        }
        // a `deinit { body }` lowers to a synthetic method `Type_deinit(Type self)`
        // (name span = the text "deinit") plus a self.decls.deinits record so scope-exit drops
        // fire it. Appended at the same point in self.arena.funcs as the native parser (during
        // this struct's processing), so the function stream order is preserved.
        if d.hasDeinit {
            val deinitN: Bind = self.internBytes(s: "deinit")
            val body: U64 = self.lowerBlock(b: d.deinitBody)
            val noParams: Array[Param] = []
            val noTypeParams: Array[Bind] = []
            self.arena.funcs.append(<Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout self, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=nm.nameStart recvLen=nm.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false defOffset=d.span.start />)
            self.decls.deinits.append(<Bind nameStart=nm.nameStart nameLen=nm.nameLen fieldStart=nm.nameStart fieldLen=nm.nameLen />)
        }
        self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams fields=fields isUnique=d.isUnique isExtern=false defOffset=d.span.start />)
        // `defaultExtension #Ext` (spec/09): record (type, extension) so the extension's
        // methods join this type's bare resolution surface (findMethod).
        val tid: U64 = intern(c: inout self, start: nm.nameStart, len: nm.nameLen)
        mut val di: U64 = 0
        while di < d.defaultExts.count() {
            val extN: Bind = self.internBytes(s: d.defaultExts[di])
            self.decls.defaultExts.append(<DefaultExt typeId=tid extId=intern(c: inout self, start: extN.nameStart, len: extN.nameLen) />)
            di += 1
        }
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerEnumDecl(d: DeclAst) {
        val nm: Bind = self.internBytes(s: d.name)
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: d.span.start)
        // variant payload types may reference `[T]` — see lowerStructDecl.
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        mut val variants: Array[Variant] = []
        mut val i: U64 = 0
        while i < d.variants.count() {
            val v: VariantAst = d.variants[i]
            val vn: Bind = self.internBytes(s: v.name)
            mut val vfields: Array[FieldDef] = []
            mut val j: U64 = 0
            while j < v.fields.count() {
                vfields.append(self.lowerFieldDef(f: v.fields[j]))
                j += 1
            }
            variants.append(<Variant nameStart=vn.nameStart nameLen=vn.nameLen nameId=intern(c: inout self, start: vn.nameStart, len: vn.nameLen) fields=vfields />)
            i += 1
        }
        self.arena.enums.append(<EnumDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams variants=variants isUnique=d.isUnique defOffset=d.span.start />)
        // `defaultExtension #Ext` in the enum body (spec/09): record (type, extension) so
        // the extension's methods join this enum's bare resolution surface (findMethod).
        val tid: U64 = intern(c: inout self, start: nm.nameStart, len: nm.nameLen)
        mut val di: U64 = 0
        while di < d.defaultExts.count() {
            val extN: Bind = self.internBytes(s: d.defaultExts[di])
            self.decls.defaultExts.append(<DefaultExt typeId=tid extId=intern(c: inout self, start: extN.nameStart, len: extN.nameLen) />)
            di += 1
        }
        self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
        self.cur.typeParams = savedTP
    }

    inout fn lowerFuncDecl(d: DeclAst) {
        val nameStart: U64 = d.nameSpan.start
        val nameLen: U64 = d.nameSpan.end - d.nameSpan.start
        val typeParams: Array[Bind] = self.lowerTypeParamNames(names: d.typeParams, anchor: nameStart)
        // param / return / body-local types may reference `[T]` — make them the lowering-time
        // scope so lowerType marks type-parameter heads as skip (siteOffset 0).
        val savedTP: Array[Bind] = self.cur.typeParams
        self.cur.typeParams = typeParams
        val params: Array[Param] = self.lowerParams(params: d.params)
        mut val retStart: U64 = 0
        mut val retLen: U64 = 0
        mut val retIsArray: Bool = false
        mut val retRef: U64 = 0
        if d.hasRet {
            val pt: PType = self.lowerType(t: d.ret)
            retStart = pt.start
            retLen = pt.len
            retIsArray = pt.isArray
            retRef = pt.ref
        }
        val savedRet: U64 = self.cur.lowerRetTy
        self.cur.lowerRetTy = retRef
        val body: U64 = self.lowerBlock(b: d.body)
        self.cur.lowerRetTy = savedRet
        self.cur.typeParams = savedTP
        val fnIdx: U64 = self.arena.funcs.count()
        self.arena.funcs.append(<Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) typeParams=typeParams params=params hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isExtern=false defOffset=nameStart />)
        mut val wi: U64 = 0
        while wi < d.whereParams.count() {
            val pn: Bind = self.internBytes(s: d.whereParams[wi])
            val tn: Bind = self.internBytes(s: d.whereTraits[wi])
            self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramNameId=pn.nameId traitNameId=tn.nameId traitStart=tn.nameStart traitLen=tn.nameLen />)
            wi += 1
        }
        // attach pending `@[...]` directives to this fn (a macro on a free function);
        // declStart/declEnd = the fn's source span for the gen harness slice.
        self.drainDerives(typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
    }

    inout fn appendFuncBounds(fnIdx: U64, params: Array[String], traits: Array[String]) {
        mut val i: U64 = 0
        while i < params.count() {
            val pn: Bind = self.internBytes(s: params[i])
            val tn: Bind = self.internBytes(s: traits[i])
            self.decls.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramNameId=pn.nameId traitNameId=tn.nameId traitStart=tn.nameStart traitLen=tn.nameLen />)
            i += 1
        }
    }
}
