// Part of the lowering pass (root: _.pw): top-level item dispatch
// (extern / decl / import / directive / newtype / global).

// Lower an `extern(plewIntrinsic)` block (spec/15): each fn -> a Func(isExtern),
// each opaque struct -> a body-less StructDef(isExtern). Mirrors parseExtern. fns
// are appended before structs; within each array order is source order, which is
// all that matters (the arrays are independent). Reports a non-intrinsic ABI.

pub impl Comp {
    inout fn lowerExtern(e: ExternAst) {
        if !(e.abiOk) {
            self.errorAt(offset: e.abiSpan.start, msg: "unknown ABI — only `extern(plewIntrinsic)` (intrinsic floor) and `extern(c)` (foreign C) are supported")
        }
        mut val fi: U64 = 0
        while fi < e.fns.count() {
            // extern(c) functions take no argument labels (a C function has none — the
            // label would be invented provenance). The author must mark each parameter
            // label-suppressed `name~:` EXPLICITLY (spec/15): a labelled param is an
            // error, not a silently-stripped label (no hidden meaning). Labels for
            // readability/safety live in a Plew `fn` wrapper over the raw extern.
            if e.abiC {
                val sig: SigAst = e.fns[fi]
                mut val pj: U64 = 0
                while pj < sig.params.count() {
                    if !(sig.params[pj].noLabel) {
                        self.errorAt(offset: sig.params[pj].span.start, msg: "extern(c) function parameters take no label — write `<name>~:` (C functions have no argument labels; put labels on a Plew wrapper)")
                    }
                    pj += 1
                }
            }
            self.registerDeclaredFunc(f: self.lowerSigToFunc(sig: e.fns[fi], isExtern: true, isCExtern: e.abiC))
            fi += 1
        }
        mut val si: U64 = 0
        while si < e.structNames.count() {
            val nm: Bind = self.internBytes(s: e.structNames[si])
            // defOffset = the struct's REAL source offset (its `struct Name` span), so type
            // visibility can locate the declaring module. Without it (defOffset 0) a
            // non-ambient extern type — e.g. the internal `Buffer` / ref cell floor,
            // from @Std/Core — would fail `moduleOf(0)` and read as out-of-scope; it only
            // ever worked because the whole compiler is module 0 and `moduleOf(0)==0`.
            mut val defOff: U64 = 0
            if si < e.structSpans.count() { defOff = e.structSpans[si].start }
            // generic params for a generic opaque intrinsic (`struct Buffer[T]`): the
            // StructDef carries them like an ordinary generic struct, so `Buffer[E]` is a
            // genuine generic instance dispatched through the uniform path. Empty for the
            // non-generic intrinsics (`Ref`/`WeakRef`/the scalar lang-items) and FFI types.
            mut val externTP: Array[Bind] = []
            if si < e.structTypeParams.count() {
                mut val sendableFlags: Array[Bool] = []
                if si < e.structTypeParamSendable.count() {
                    sendableFlags = e.structTypeParamSendable[si]
                }
                externTP = self.lowerTypeParamNames(names: e.structTypeParams[si], anchor: defOff, sendableFlags: sendableFlags)
            }
            val noFields: Array[FieldDef] = []
            // `String` is the one intrinsic that is really a value-semantics struct over a
            // single `Array[U8]` buffer (spec/02): register it as a NON-extern struct with a
            // synthetic private `buffer: Array[U8]` field so the generic struct+Array ARC frees
            // it (no String-specific refcount). Its VALUE stays the flat {ptr,i64} layout (= the
            // buffer's layout), so it is a transparent single-field wrapper — the struct ARC
            // handles String's buffer as the whole value (see emitDeinitValue / deepCopyStructValue).
            mut val fields: Array[FieldDef] = noFields
            mut val isExt: Bool = true
            if rangeEquals(bytes: self.arena.bytes, start: nm.nameStart, len: nm.nameLen, kw: "String") {
                val u8nm: Bind = self.internBytes(s: "U8")
                val bufnm: Bind = self.internBytes(s: "buffer")
                fields.append(<FieldDef nameStart=bufnm.nameStart nameLen=bufnm.nameLen nameId=intern(c: inout self, start: bufnm.nameStart, len: bufnm.nameLen) tyStart=u8nm.nameStart tyLen=u8nm.nameLen tyNameId=intern(c: inout self, start: u8nm.nameStart, len: u8nm.nameLen) tyIsArray=true ty=0U64 isMut=false hasDefault=false defaultVal=0U64 vis=0U64 />)
                isExt = false
            }
            self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=externTP fields=fields isUnique=false isExtern=isExt isCExtern=e.abiC defOffset=defOff />)
            // a `@[...]` derive on this opaque extern type (spec/16): lower its directive to
            // pending derives and drain them onto this type, with the `struct Name` span as
            // the item source so the harness `parseItem` recovers a `Decl` (name = the type).
            if si < e.structDirectives.count() {
                val dir: DirectiveAst = e.structDirectives[si]
                if dir.reqs.count() > 0U64 {
                    self.lowerDirective(dir: dir)
                    val sp: Span = e.structSpans[si]
                    self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: sp.start, declEnd: sp.end)
                }
            }
            si += 1
        }
    }

    inout fn lowerSyntaxExtern(ext: SyntaxExtern) {
        if !(ext.abiOk) {
            self.errorAt(offset: ext.abiSpan.start, msg: "unknown ABI — only `extern(plewIntrinsic)` (intrinsic floor) and `extern(c)` (foreign C) are supported")
        }
        mut val i: U64 = 0U64
        while i < syntaxExternFnCount(file: self.syntax, ext: ext) {
            val sig: SyntaxSig = syntaxSig(file: self.syntax, id: syntaxExternFn(file: self.syntax, ext: ext, index: i))
            if ext.abiC {
                mut val pi: U64 = 0U64
                while pi < syntaxSigParamCount(file: self.syntax, sig: sig) {
                    val param: SyntaxParam = syntaxParam(file: self.syntax, id: syntaxSigParam(file: self.syntax, sig: sig, index: pi))
                    if !(param.noLabel) {
                        self.errorAt(offset: param.span.start, msg: "extern(c) function parameters take no label — write `<name>~:` (C functions have no argument labels; put labels on a Plew wrapper)")
                    }
                    pi += 1U64
                }
            }
            self.registerDeclaredFunc(f: self.lowerSyntaxSigToFunc(sig: sig, isExtern: true, isCExtern: ext.abiC))
            i += 1U64
        }
        i = 0U64
        while i < syntaxExternStructCount(file: self.syntax, ext: ext) {
            val name: Span = syntaxExternStructNameSpan(file: self.syntax, ext: ext, index: i)
            val defSpan: Span = syntaxExternStructSpan(file: self.syntax, ext: ext, index: i)
            mut val paramSpans: Array[Span] = []
            mut val paramFlags: Array[Bool] = []
            mut val pi: U64 = 0U64
            while pi < syntaxExternStructTypeParamCount(file: self.syntax, ext: ext, index: i) {
                paramSpans.append(syntaxExternStructTypeParamSpan(file: self.syntax, ext: ext, structIndex: i, index: pi))
                paramFlags.append(syntaxExternStructTypeParamIsSendable(file: self.syntax, ext: ext, structIndex: i, index: pi))
                pi += 1U64
            }
            val typeParams: Array[Bind] = self.lowerTypeParamSpans(spans: paramSpans, anchor: defSpan.start, sendableFlags: paramFlags)
            val noFields: Array[FieldDef] = []
            mut val fields: Array[FieldDef] = noFields
            mut val isExtern: Bool = true
            if rangeEquals(bytes: self.arena.bytes, start: name.start, len: name.end - name.start, kw: "String") {
                val u8: Bind = self.internBytes(s: "U8")
                val buffer: Bind = self.internBytes(s: "buffer")
                fields.append(<FieldDef nameStart=buffer.nameStart nameLen=buffer.nameLen nameId=intern(c: inout self, start: buffer.nameStart, len: buffer.nameLen) tyStart=u8.nameStart tyLen=u8.nameLen tyNameId=intern(c: inout self, start: u8.nameStart, len: u8.nameLen) tyIsArray=true ty=0U64 isMut=false hasDefault=false defaultVal=0U64 vis=0U64 />)
                isExtern = false
            }
            self.arena.structs.append(<StructDef nameStart=name.start nameLen=name.end - name.start nameId=intern(c: inout self, start: name.start, len: name.end - name.start) typeParams=typeParams fields=fields isUnique=false isExtern=isExtern isCExtern=ext.abiC defOffset=defSpan.start />)
            // Every extern struct has a parallel directive id.  Empty is not
            // equivalent to a drain: pending top-level derives must not be
            // consumed, matching the value-AST path exactly.
            val directive: SyntaxDirective = syntaxDirective(file: self.syntax, id: syntaxExternStructDirective(file: self.syntax, ext: ext, index: i))
            if syntaxDirectiveReqCount(file: self.syntax, directive: directive) > 0U64 {
                self.lowerSyntaxDirective(dir: directive)
                self.drainDerives(typeStart: name.start, typeLen: name.end - name.start, isEnum: false, declStart: defSpan.start, declEnd: defSpan.end)
            }
            i += 1U64
        }
    }

    inout fn lowerDecl(d: DeclAst) {
        match d.kind {
            DeclKind.Struct => { self.lowerStructDecl(d: d) }
            DeclKind.Enum => { self.lowerEnumDecl(d: d) }
            DeclKind.Func => { self.lowerFuncDecl(d: d) }
        }
    }

    inout fn lowerSyntaxDecl(d: SyntaxDecl) {
        match d.kind {
            DeclKind.Struct => { self.lowerSyntaxStructDecl(d: d) }
            DeclKind.Enum => { self.lowerSyntaxEnumDecl(d: d) }
            DeclKind.Func => { self.lowerSyntaxFuncDecl(d: d) }
        }
    }

    inout fn lowerImport(imp: ImportAst) {
        // a `with`-less import (`import @Std/Io`) binds the last path segment as a
        // namespace; `Io.print(args)` then resolves to `print` from that module. A path
        // alias `import @Std/Io as IO` binds `IO` instead (spec/15).
        if imp.isImport {
            if imp.names.count() == 0 {
                mut val nsStart: U64 = imp.segSpan.start
                mut val nsEnd: U64 = imp.segSpan.end
                if imp.aliasSpan.end > imp.aliasSpan.start {
                    nsStart = imp.aliasSpan.start
                    nsEnd = imp.aliasSpan.end
                }
                if nsEnd > nsStart {
                    self.decls.namespaces.append(<Bind nameStart=nsStart nameLen=nsEnd - nsStart fieldStart=0 fieldLen=0 />)
                }
            }
        }
        mut val i: U64 = 0
        while i < imp.names.count() {
            val nspan: Span = imp.nameSpans[i]
            mut val alias: Span = <Span start=0 end=0 />
            if i < imp.nameAliasSpans.count() { alias = imp.nameAliasSpans[i] }
            self.appendLoweredImportName(seg: imp.segSpan, name: nspan, alias: alias)
            i += 1
        }
    }

    inout fn lowerSyntaxImport(imp: SyntaxImport) {
        if imp.isImport && syntaxImportNameCount(file: self.syntax, imp: imp) == 0U64 {
            mut val nsStart: U64 = imp.segment.start
            mut val nsEnd: U64 = imp.segment.end
            if imp.alias.end > imp.alias.start {
                nsStart = imp.alias.start
                nsEnd = imp.alias.end
            }
            if nsEnd > nsStart {
                self.decls.namespaces.append(<Bind nameStart=nsStart nameLen=nsEnd - nsStart fieldStart=0 fieldLen=0 />)
            }
        }
        mut val i: U64 = 0U64
        while i < syntaxImportNameCount(file: self.syntax, imp: imp) {
            self.appendLoweredImportName(seg: imp.segment, name: syntaxImportNameSpan(file: self.syntax, imp: imp, index: i), alias: syntaxImportNameAliasSpan(file: self.syntax, imp: imp, index: i))
            i += 1U64
        }
    }

    inout fn appendLoweredImportName(seg: Span, name: Span, alias: Span) {
        self.markImport(segStart: seg.start, segLen: seg.end - seg.start, nameStart: name.start, nameLen: name.end - name.start)
        if alias.end > alias.start {
            self.decls.importAliases.append(<Bind nameStart=alias.start nameLen=alias.end - alias.start fieldStart=name.start fieldLen=name.end - name.start />)
        }
    }

    inout fn lowerReExport(imp: ImportAst) {
        mut val i: U64 = 0
        while i < imp.names.count() {
            val nspan: Span = imp.nameSpans[i]
            mut val alias: Span = <Span start=0 end=0 />
            if i < imp.nameAliasSpans.count() {
                alias = imp.nameAliasSpans[i]
            }
            self.appendLoweredReExportName(name: nspan, alias: alias)
            i += 1
        }
    }

    // Re-exports do not introduce a local binding.  Both input decoders only
    // choose the source spelling; this sink records the exported spelling.
    inout fn lowerSyntaxReExport(imp: SyntaxImport) {
        mut val i: U64 = 0U64
        while i < syntaxImportNameCount(file: self.syntax, imp: imp) {
            self.appendLoweredReExportName(name: syntaxImportNameSpan(file: self.syntax, imp: imp, index: i), alias: syntaxImportNameAliasSpan(file: self.syntax, imp: imp, index: i))
            i += 1U64
        }
    }

    inout fn appendLoweredReExportName(name: Span, alias: Span) {
        mut val exportName: Span = name
        if alias.end > alias.start {
            exportName = alias
        }
        self.recordExport(nameStart: exportName.start, nameLen: exportName.end - exportName.start)
    }

    inout fn isNamespaceName(name: String) -> Bool {
        val nb: Bind = self.internBytes(s: name)
        mut val i: U64 = 0
        while i < self.decls.namespaces.count() {
            if spansEqual(c: inout self, aStart: self.decls.namespaces[i].nameStart, aLen: self.decls.namespaces[i].nameLen, bStart: nb.nameStart, bLen: nb.nameLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // Keep namespace-call recognition in the same semantic namespace table as
    // the value-AST path.  SyntaxFile retains source spans rather than names,
    // so intern only the queried spelling instead of materializing a String.
    inout fn isNamespaceNameSpan(name: Span) -> Bool {
        mut val i: U64 = 0U64
        while i < self.decls.namespaces.count() {
            if spansEqual(c: inout self, aStart: self.decls.namespaces[i].nameStart, aLen: self.decls.namespaces[i].nameLen, bStart: name.start, bLen: name.end - name.start) {
                return true
            }
            i += 1U64
        }
        return false
    }

    inout fn lowerDirective(dir: DirectiveAst) {
        mut val i: U64 = 0
        while i < dir.reqs.count() {
            val r: DeriveReqAst = dir.reqs[i]
            val args: Array[MakeField] = self.lowerMakeFields(fields: r.args, typeName: "", variant: "", isEnum: false)
            self.parseScratch.pendingDerives.append(<DeriveReq typeStart=0 typeLen=0 isEnum=false nameStart=r.nameSpan.start nameLen=r.nameSpan.end - r.nameSpan.start declStart=0 declEnd=0 args=args />)
            i += 1
        }
    }

    inout fn lowerSyntaxDirective(dir: SyntaxDirective) {
        mut val i: U64 = 0U64
        while i < syntaxDirectiveReqCount(file: self.syntax, directive: dir) {
            val req: SyntaxDeriveReq = syntaxDeriveReq(file: self.syntax, id: syntaxDirectiveReq(file: self.syntax, directive: dir, index: i))
            mut val args: Array[MakeField] = []
            mut val ai: U64 = 0U64
            while ai < syntaxDeriveReqArgCount(file: self.syntax, req: req) {
                val field: SyntaxMakeField = syntaxMakeField(file: self.syntax, id: syntaxDeriveReqArg(file: self.syntax, req: req, index: ai))
                args.append(<MakeField nameStart=field.name.start nameLen=field.name.end - field.name.start value=self.lowerSyntaxExpr(id: field.value) offset=field.span.start />)
                ai += 1U64
            }
            self.parseScratch.pendingDerives.append(<DeriveReq typeStart=0U64 typeLen=0U64 isEnum=false nameStart=req.name.start nameLen=req.name.end - req.name.start declStart=0U64 declEnd=0U64 args=args />)
            i += 1U64
        }
    }

    inout fn lowerExportItem(inner: TopItemAst) {
        match inner {
            TopItemAst.Extern(val e) => {
                val xfB: U64 = self.arena.funcs.count()
                val xsB: U64 = self.arena.structs.count()
                self.lowerExtern(e: e)
                mut val xi: U64 = xfB
                while xi < self.arena.funcs.count() {
                    self.recordExport(nameStart: self.arena.funcs[xi].nameStart, nameLen: self.arena.funcs[xi].nameLen)
                    xi += 1
                }
                mut val xj: U64 = xsB
                while xj < self.arena.structs.count() {
                    self.recordExportFrom(nameStart: self.arena.structs[xj].nameStart, nameLen: self.arena.structs[xj].nameLen, moduleOffset: self.arena.structs[xj].defOffset)
                    xj += 1
                }
            }
            TopItemAst.Decl(val d) => {
                val sB: U64 = self.arena.structs.count()
                val eB: U64 = self.arena.enums.count()
                val fB: U64 = self.arena.funcs.count()
                self.lowerDecl(d: d)
                match d.kind {
                    DeclKind.Struct => { self.recordExportFrom(nameStart: self.arena.structs[sB].nameStart, nameLen: self.arena.structs[sB].nameLen, moduleOffset: self.arena.structs[sB].defOffset) }
                    DeclKind.Enum => { self.recordExportFrom(nameStart: self.arena.enums[eB].nameStart, nameLen: self.arena.enums[eB].nameLen, moduleOffset: self.arena.enums[eB].defOffset) }
                    DeclKind.Func => { self.recordExport(nameStart: self.arena.funcs[fB].nameStart, nameLen: self.arena.funcs[fB].nameLen) }
                }
            }
            TopItemAst.Trait(val t) => {
                val tB: U64 = self.decls.traits.count()
                self.lowerTrait(t: t)
                self.recordExport(nameStart: self.decls.traits[tB].nameStart, nameLen: self.decls.traits[tB].nameLen)
            }
            TopItemAst.GlobalVal(val s) => {
                val gB: U64 = self.arena.globals.count()
                self.lowerGlobalVal(s: s)
                if self.arena.globals.count() > gB {
                    self.recordExport(nameStart: self.arena.globals[gB].nameStart, nameLen: self.arena.globals[gB].nameLen)
                }
            }
            TopItemAst.NewType(val name, nameSpan: _, val ty, isPub: _, val span) => {
                // `export newtype Name = Underlying` (spec/10,15): lower the distinct type,
                // then record its name as exported so other modules can import it.
                val ntB: U64 = self.arena.newtypes.count()
                self.lowerNewtype(name: name, ty: ty, defOffset: span.start)
                if self.arena.newtypes.count() > ntB {
                    self.recordExportFrom(nameStart: self.arena.newtypes[ntB].nameStart, nameLen: self.arena.newtypes[ntB].nameLen, moduleOffset: self.arena.newtypes[ntB].defOffset)
                }
            }
            _ => { self.lowerTopItem(item: inner) }
        }
    }

    inout fn lowerTopItem(item: TopItemAst) {
        // reset the lowering-time type-parameter scope at every top-level item boundary, so a
        // generic decl's `[T]` can never leak into a sibling (siteOffset stamping in lowerType
        // reads self.cur.typeParams to skip type-parameter heads). Each generic decl-lowering
        // function then sets/restores its own scope around its signature + body.
        self.cur.typeParams = []
        match item {
            TopItemAst.Decl(val d) => { self.lowerDecl(d: d) }
            TopItemAst.Impl(val im) => { self.lowerImpl(im: im) }
            TopItemAst.Trait(val t) => { self.lowerTrait(t: t) }
            TopItemAst.Extern(val e) => { self.lowerExtern(e: e) }
            TopItemAst.Import(val imp) => { self.lowerImport(imp: imp) }
            TopItemAst.Export(val inner) => { self.lowerExportItem(inner: inner) }
            TopItemAst.ReExport(val imp) => { self.lowerReExport(imp: imp) }
            TopItemAst.Directive(val dir) => { self.lowerDirective(dir: dir) }
            TopItemAst.GlobalVal(val s) => { self.lowerGlobalVal(s: s) }
            TopItemAst.NewType(val name, nameSpan: _, val ty, val isPub, val span) => { self.lowerNewtype(name: name, ty: ty, defOffset: span.start) }
        }
    }

    inout fn lowerSyntaxExportItem(item: TopItemId) {
        match syntaxTopItemKind(file: self.syntax, item: item) {
            SyntaxTopItemKind.Extern => {
                val funcBefore: U64 = self.arena.funcs.count()
                val structBefore: U64 = self.arena.structs.count()
                self.lowerSyntaxExtern(ext: syntaxExtern(file: self.syntax, id: <ExternId raw=syntaxTopItemPayload(file: self.syntax, item: item) />))
                mut val i: U64 = funcBefore
                while i < self.arena.funcs.count() {
                    self.recordExport(nameStart: self.arena.funcs[i].nameStart, nameLen: self.arena.funcs[i].nameLen)
                    i += 1U64
                }
                i = structBefore
                while i < self.arena.structs.count() {
                    self.recordExportFrom(nameStart: self.arena.structs[i].nameStart, nameLen: self.arena.structs[i].nameLen, moduleOffset: self.arena.structs[i].defOffset)
                    i += 1U64
                }
            }
            SyntaxTopItemKind.Decl => {
                val d: SyntaxDecl = syntaxDecl(file: self.syntax, id: <DeclId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)
                val structBefore: U64 = self.arena.structs.count()
                val enumBefore: U64 = self.arena.enums.count()
                val funcBefore: U64 = self.arena.funcs.count()
                self.lowerSyntaxDecl(d: d)
                match d.kind {
                    DeclKind.Struct => { self.recordExportFrom(nameStart: self.arena.structs[structBefore].nameStart, nameLen: self.arena.structs[structBefore].nameLen, moduleOffset: self.arena.structs[structBefore].defOffset) }
                    DeclKind.Enum => { self.recordExportFrom(nameStart: self.arena.enums[enumBefore].nameStart, nameLen: self.arena.enums[enumBefore].nameLen, moduleOffset: self.arena.enums[enumBefore].defOffset) }
                    DeclKind.Func => { self.recordExport(nameStart: self.arena.funcs[funcBefore].nameStart, nameLen: self.arena.funcs[funcBefore].nameLen) }
                }
            }
            SyntaxTopItemKind.Trait => {
                val before: U64 = self.decls.traits.count()
                self.lowerSyntaxTrait(t: syntaxTrait(file: self.syntax, id: <TraitId raw=syntaxTopItemPayload(file: self.syntax, item: item) />))
                self.recordExport(nameStart: self.decls.traits[before].nameStart, nameLen: self.decls.traits[before].nameLen)
            }
            SyntaxTopItemKind.GlobalVal => {
                val before: U64 = self.arena.globals.count()
                self.lowerSyntaxGlobalVal(id: <StmtId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)
                if self.arena.globals.count() > before { self.recordExport(nameStart: self.arena.globals[before].nameStart, nameLen: self.arena.globals[before].nameLen) }
            }
            SyntaxTopItemKind.NewType => {
                val before: U64 = self.arena.newtypes.count()
                self.lowerSyntaxNewtype(id: <NewtypeId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)
                if self.arena.newtypes.count() > before { self.recordExportFrom(nameStart: self.arena.newtypes[before].nameStart, nameLen: self.arena.newtypes[before].nameLen, moduleOffset: self.arena.newtypes[before].defOffset) }
            }
            _ => { self.lowerSyntaxTopItem(item: item) }
        }
    }

    inout fn lowerSyntaxTopItem(item: TopItemId) {
        self.cur.typeParams = []
        match syntaxTopItemKind(file: self.syntax, item: item) {
            SyntaxTopItemKind.Decl => { self.lowerSyntaxDecl(d: syntaxDecl(file: self.syntax, id: <DeclId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.Impl => { self.lowerSyntaxImpl(im: syntaxImpl(file: self.syntax, id: <ImplId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.Trait => { self.lowerSyntaxTrait(t: syntaxTrait(file: self.syntax, id: <TraitId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.Extern => { self.lowerSyntaxExtern(ext: syntaxExtern(file: self.syntax, id: <ExternId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.Import => { self.lowerSyntaxImport(imp: syntaxImport(file: self.syntax, id: <ImportId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.Export => { self.lowerSyntaxExportItem(item: <TopItemId raw=syntaxTopItemPayload(file: self.syntax, item: item) />) }
            SyntaxTopItemKind.ReExport => { self.lowerSyntaxReExport(imp: syntaxImport(file: self.syntax, id: <ImportId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.Directive => { self.lowerSyntaxDirective(dir: syntaxDirective(file: self.syntax, id: <DirectiveId raw=syntaxTopItemPayload(file: self.syntax, item: item) />)) }
            SyntaxTopItemKind.GlobalVal => { self.lowerSyntaxGlobalVal(id: <StmtId raw=syntaxTopItemPayload(file: self.syntax, item: item) />) }
            SyntaxTopItemKind.NewType => { self.lowerSyntaxNewtype(id: <NewtypeId raw=syntaxTopItemPayload(file: self.syntax, item: item) />) }
        }
    }

    inout fn lowerNewtype(name: String, ty: TypeAst, defOffset: U64) {
        val nm: Bind = self.internBytes(s: name)
        val under: PType = self.lowerType(t: ty)
        self.appendLoweredNewtype(name: nm, under: under, defOffset: defOffset)
    }

    inout fn lowerSyntaxNewtype(id: NewtypeId) {
        val item: SyntaxNewtype = syntaxNewtype(file: self.syntax, id: id)
        val nameLen: U64 = item.name.end - item.name.start
        val name: Bind = <Bind nameStart=item.name.start nameLen=nameLen fieldStart=item.name.start fieldLen=nameLen />
        val under: PType = self.lowerSyntaxType(id: item.ty)
        self.appendLoweredNewtype(name: name, under: under, defOffset: item.span.start)
    }

    // Both source decoders converge here.  The semantic mutation is deliberately
    // shared so SyntaxFile migration cannot create a second newtype lowerer.
    inout fn appendLoweredNewtype(name: Bind, under: PType, defOffset: U64) {
        self.arena.newtypes.append(<NewtypeDef nameStart=name.nameStart nameLen=name.nameLen nameId=intern(c: inout self, start: name.nameStart, len: name.nameLen) underStart=under.start underLen=under.len underRef=under.ref defOffset=defOffset />)
    }

    inout fn lowerGlobalVal(s: StmtAst) {
        val stid: U64 = self.lowerStmt(s: s)
        self.appendLoweredGlobal(letStmt: stid)
    }

    inout fn lowerSyntaxGlobalVal(id: StmtId) {
        self.appendLoweredGlobal(letStmt: self.lowerSyntaxStmt(id: id))
    }

    inout fn appendLoweredGlobal(letStmt: U64) {
        match self.arena.stmts[letStmt] {
            Stmt.Let(val mutable, val nameStart, val nameLen, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: _) => {
                self.arena.globals.append(<Global nameStart=nameStart nameLen=nameLen letStmt=letStmt mutable=mutable />)
            }
            _ => {}
        }
    }
}
