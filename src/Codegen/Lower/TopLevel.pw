// Part of the lowering pass (root: _.pw): top-level item dispatch
// (extern / decl / import / directive / newtype / global).

// Lower an `extern "plew-intrinsic"` block (spec/15): each fn -> a Func(isExtern),
// each opaque struct -> a body-less StructDef(isExtern). Mirrors parseExtern. fns
// are appended before structs; within each array order is source order, which is
// all that matters (the arrays are independent). Reports a non-intrinsic ABI.

pub impl Comp {
    inout fn lowerExtern(e: ExternAst) {
        if !(e.abiOk) {
            self.errorAt(offset: e.abiSpan.start, msg: "unknown ABI — only `extern(plewIntrinsic)` (intrinsic floor) and `extern(c)` (foreign C) are supported")
        }
        mut val fi: U64 = 0
        while fi < e.fns.count() {
            // extern(c) functions take no argument labels (a C function has none — the
            // label would be invented provenance). The author must mark each parameter
            // label-suppressed `name~:` EXPLICITLY (spec/15): a labelled param is an
            // error, not a silently-stripped label (no hidden meaning). Labels for
            // readability/safety live in a Plew `fn` wrapper over the raw extern.
            if e.abiC {
                val sig: SigAst = e.fns[fi]
                mut val pj: U64 = 0
                while pj < sig.params.count() {
                    if !(sig.params[pj].noLabel) {
                        self.errorAt(offset: sig.params[pj].span.start, msg: "extern(c) function parameters take no label — write `<name>~:` (C functions have no argument labels; put labels on a Plew wrapper)")
                    }
                    pj += 1
                }
            }
            self.arena.funcs.append(self.lowerSigToFunc(sig: e.fns[fi], isExtern: true, isCExtern: e.abiC))
            fi += 1
        }
        mut val si: U64 = 0
        while si < e.structNames.count() {
            val nm: Bind = self.internBytes(s: e.structNames[si])
            // generic params for a generic opaque intrinsic (`struct Buffer[T]`): the
            // StructDef carries them like an ordinary generic struct, so `Buffer[E]` is a
            // genuine generic instance dispatched through the uniform path. Empty for the
            // non-generic intrinsics (`Ref`/`WeakRef`/the scalar lang-items) and FFI types.
            mut val externTP: Array[Bind] = []
            if si < e.structTypeParams.count() {
                externTP = self.lowerTypeParamNames(names: e.structTypeParams[si])
            }
            val noFields: Array[FieldDef] = []
            // defOffset = the struct's REAL source offset (its `struct Name` span), so type
            // visibility can locate the declaring module. Without it (defOffset 0) a
            // non-ambient extern type — e.g. the internal `Buffer`, or imported `Ref`
            // from @Std/Core — would fail `moduleOf(0)` and read as out-of-scope; it only
            // ever worked because the whole compiler is module 0 and `moduleOf(0)==0`.
            mut val defOff: U64 = 0
            if si < e.structSpans.count() { defOff = e.structSpans[si].start }
            // `String` is the one intrinsic that is really a value-semantics struct over a
            // single `Array[U8]` buffer (spec/02): register it as a NON-extern struct with a
            // synthetic private `buffer: Array[U8]` field so the generic struct+Array ARC frees
            // it (no String-specific refcount). Its VALUE stays the flat {ptr,i64} layout (= the
            // buffer's layout), so it is a transparent single-field wrapper — the struct ARC
            // handles String's buffer as the whole value (see emitDeinitValue / deepCopyStructValue).
            mut val fields: Array[FieldDef] = noFields
            mut val isExt: Bool = true
            if rangeEquals(bytes: self.arena.bytes, start: nm.nameStart, len: nm.nameLen, kw: "String") {
                val u8nm: Bind = self.internBytes(s: "U8".bytes())
                val bufnm: Bind = self.internBytes(s: "buffer".bytes())
                fields.append(<FieldDef nameStart=bufnm.nameStart nameLen=bufnm.nameLen nameId=intern(c: inout self, start: bufnm.nameStart, len: bufnm.nameLen) tyStart=u8nm.nameStart tyLen=u8nm.nameLen tyNameId=intern(c: inout self, start: u8nm.nameStart, len: u8nm.nameLen) tyIsArray=true ty=0U64 isMut=false hasDefault=false defaultVal=0U64 vis=0U64 />)
                isExt = false
            }
            self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) typeParams=externTP fields=fields isUnique=false isExtern=isExt isCExtern=e.abiC defOffset=defOff />)
            // a `@[...]` derive on this opaque extern type (spec/16): lower its directive to
            // pending derives and drain them onto this type, with the `struct Name` span as
            // the item source so the harness `parseItem` recovers a `Decl` (name = the type).
            if si < e.structDirectives.count() {
                val dir: DirectiveAst = e.structDirectives[si]
                if dir.reqs.count() > 0U64 {
                    self.lowerDirective(dir: dir)
                    val sp: Span = e.structSpans[si]
                    self.drainDerives(typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: sp.start, declEnd: sp.end)
                }
            }
            si += 1
        }
    }

    inout fn lowerDecl(d: DeclAst) {
        match d.kind {
            DeclKind.Struct => { self.lowerStructDecl(d: d) }
            DeclKind.Enum => { self.lowerEnumDecl(d: d) }
            DeclKind.Func => { self.lowerFuncDecl(d: d) }
        }
    }

    inout fn lowerImport(imp: ImportAst) {
        // a `with`-less import (`import @Std/Io`) binds the last path segment as a
        // namespace; `Io.print(args)` then resolves to `print` from that module. A path
        // alias `import @Std/Io as IO` binds `IO` instead (spec/15).
        if imp.isImport {
            if imp.names.count() == 0 {
                mut val nsStart: U64 = imp.segSpan.start
                mut val nsEnd: U64 = imp.segSpan.end
                if imp.aliasSpan.end > imp.aliasSpan.start {
                    nsStart = imp.aliasSpan.start
                    nsEnd = imp.aliasSpan.end
                }
                if nsEnd > nsStart {
                    self.decls.namespaces.append(<Bind nameStart=nsStart nameLen=nsEnd - nsStart fieldStart=0 fieldLen=0 />)
                }
            }
        }
        mut val i: U64 = 0
        while i < imp.names.count() {
            val nspan: Span = imp.nameSpans[i]
            self.markImport(segStart: imp.segSpan.start, segLen: imp.segSpan.end - imp.segSpan.start, nameStart: nspan.start, nameLen: nspan.end - nspan.start)
            // `real as alias`: record the local alias -> real-name mapping (spec/15).
            if i < imp.nameAliasSpans.count() {
                val al: Span = imp.nameAliasSpans[i]
                if al.end > al.start {
                    self.decls.importAliases.append(<Bind nameStart=al.start nameLen=al.end - al.start fieldStart=nspan.start fieldLen=nspan.end - nspan.start />)
                }
            }
            i += 1
        }
    }

    inout fn lowerReExport(imp: ImportAst) {
        mut val i: U64 = 0
        while i < imp.names.count() {
            val nspan: Span = imp.nameSpans[i]
            mut val exStart: U64 = nspan.start
            mut val exLen: U64 = nspan.end - nspan.start
            if i < imp.nameAliasSpans.count() {
                val al: Span = imp.nameAliasSpans[i]
                if al.end > al.start {
                    exStart = al.start
                    exLen = al.end - al.start
                }
            }
            self.recordExport(nameStart: exStart, nameLen: exLen)
            i += 1
        }
    }

    inout fn isNamespaceName(name: String) -> Bool {
        val nb: Bind = self.internBytes(s: name)
        mut val i: U64 = 0
        while i < self.decls.namespaces.count() {
            if spansEqual(c: inout self, aStart: self.decls.namespaces[i].nameStart, aLen: self.decls.namespaces[i].nameLen, bStart: nb.nameStart, bLen: nb.nameLen) {
                return true
            }
            i += 1
        }
        return false
    }

    inout fn lowerDirective(dir: DirectiveAst) {
        mut val i: U64 = 0
        while i < dir.reqs.count() {
            val r: DeriveReqAst = dir.reqs[i]
            val args: Array[MakeField] = self.lowerMakeFields(fields: r.args, typeName: "", variant: "", isEnum: false)
            self.parseScratch.pendingDerives.append(<DeriveReq typeStart=0 typeLen=0 isEnum=false nameStart=r.nameSpan.start nameLen=r.nameSpan.end - r.nameSpan.start declStart=0 declEnd=0 args=args />)
            i += 1
        }
    }

    inout fn lowerExportItem(inner: TopItemAst) {
        match inner {
            TopItemAst.Extern(val e) => {
                val xfB: U64 = self.arena.funcs.count()
                val xsB: U64 = self.arena.structs.count()
                self.lowerExtern(e: e)
                mut val xi: U64 = xfB
                while xi < self.arena.funcs.count() {
                    self.recordExport(nameStart: self.arena.funcs[xi].nameStart, nameLen: self.arena.funcs[xi].nameLen)
                    xi += 1
                }
                mut val xj: U64 = xsB
                while xj < self.arena.structs.count() {
                    self.recordExport(nameStart: self.arena.structs[xj].nameStart, nameLen: self.arena.structs[xj].nameLen)
                    xj += 1
                }
            }
            TopItemAst.Decl(val d) => {
                val sB: U64 = self.arena.structs.count()
                val eB: U64 = self.arena.enums.count()
                val fB: U64 = self.arena.funcs.count()
                self.lowerDecl(d: d)
                match d.kind {
                    DeclKind.Struct => { self.recordExport(nameStart: self.arena.structs[sB].nameStart, nameLen: self.arena.structs[sB].nameLen) }
                    DeclKind.Enum => { self.recordExport(nameStart: self.arena.enums[eB].nameStart, nameLen: self.arena.enums[eB].nameLen) }
                    DeclKind.Func => { self.recordExport(nameStart: self.arena.funcs[fB].nameStart, nameLen: self.arena.funcs[fB].nameLen) }
                }
            }
            TopItemAst.Trait(val t) => {
                val tB: U64 = self.decls.traits.count()
                self.lowerTrait(t: t)
                self.recordExport(nameStart: self.decls.traits[tB].nameStart, nameLen: self.decls.traits[tB].nameLen)
            }
            TopItemAst.GlobalVal(val s) => {
                val gB: U64 = self.arena.globals.count()
                self.lowerGlobalVal(s: s)
                if self.arena.globals.count() > gB {
                    self.recordExport(nameStart: self.arena.globals[gB].nameStart, nameLen: self.arena.globals[gB].nameLen)
                }
            }
            TopItemAst.NewType(val name, val ty, isPub: _, val span) => {
                // `export newtype Name = Underlying` (spec/10,15): lower the distinct type,
                // then record its name as exported so other modules can import it.
                val ntB: U64 = self.arena.newtypes.count()
                self.lowerNewtype(name: name, ty: ty, defOffset: span.start)
                if self.arena.newtypes.count() > ntB {
                    self.recordExport(nameStart: self.arena.newtypes[ntB].nameStart, nameLen: self.arena.newtypes[ntB].nameLen)
                }
            }
            _ => { self.lowerTopItem(item: inner) }
        }
    }

    inout fn lowerTopItem(item: TopItemAst) {
        // reset the lowering-time type-parameter scope at every top-level item boundary, so a
        // generic decl's `[T]` can never leak into a sibling (siteOffset stamping in lowerType
        // reads self.cur.typeParams to skip type-parameter heads). Each generic decl-lowering
        // function then sets/restores its own scope around its signature + body.
        self.cur.typeParams = []
        match item {
            TopItemAst.Decl(val d) => { self.lowerDecl(d: d) }
            TopItemAst.Impl(val im) => { self.lowerImpl(im: im) }
            TopItemAst.Trait(val t) => { self.lowerTrait(t: t) }
            TopItemAst.Extern(val e) => { self.lowerExtern(e: e) }
            TopItemAst.Import(val imp) => { self.lowerImport(imp: imp) }
            TopItemAst.Export(val inner) => { self.lowerExportItem(inner: inner) }
            TopItemAst.ReExport(val imp) => { self.lowerReExport(imp: imp) }
            TopItemAst.Directive(val dir) => { self.lowerDirective(dir: dir) }
            TopItemAst.GlobalVal(val s) => { self.lowerGlobalVal(s: s) }
            TopItemAst.NewType(val name, val ty, val isPub, val span) => { self.lowerNewtype(name: name, ty: ty, defOffset: span.start) }
        }
    }

    inout fn lowerNewtype(name: String, ty: TypeAst, defOffset: U64) {
        val nm: Bind = self.internBytes(s: name)
        val under: PType = self.lowerType(t: ty)
        self.arena.newtypes.append(<NewtypeDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout self, start: nm.nameStart, len: nm.nameLen) underStart=under.start underLen=under.len underRef=under.ref defOffset=defOffset />)
    }

    inout fn lowerGlobalVal(s: StmtAst) {
        val stid: U64 = self.lowerStmt(s: s)
        match self.arena.stmts[stid] {
            Stmt.Let(val mutable, val nameStart, val nameLen, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: _) => {
                self.arena.globals.append(<Global nameStart=nameStart nameLen=nameLen letStmt=stid mutable=mutable />)
            }
            _ => {}
        }
    }
}
