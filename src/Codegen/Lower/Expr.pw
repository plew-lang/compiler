// Structural expression lowering. Expected types are supplied by Record.

impl Comp {
    inout fn pushAuthoredIdentifier(start: U64, length: U64, spanStart: U64, spanEnd: U64) -> U64 {
        val expression = self.pushExpr(e: <Expr.Ident start=start len=length />)
        val count = self.authoredIdentifiers.count()
        if count != 0U64 && self.authoredIdentifiers[count - 1U64].expression >= expression { panic("internal error: identifier origins are not append-only") }
        self.authoredIdentifiers.append(<AuthoredIdentifier expression=expression serial=self.arena.exprOriginSerial[expression] start=start length=length spanStart=spanStart spanEnd=spanEnd />)
        return expression
    }

    inout fn pushAuthoredField(base: U64, start: U64, length: U64, spanStart: U64, spanEnd: U64) -> U64 {
        val expression = self.pushExpr(e: <Expr.Field base=base nameStart=start nameLen=length />)
        self.arena.exprSpanStart[expression] = spanStart
        self.arena.exprSpanEnd[expression] = spanEnd
        val count = self.authoredFields.count()
        if count != 0U64 && self.authoredFields[count - 1U64].expression >= expression { panic("internal error: field origins are not append-only") }
        self.authoredFields.append(<AuthoredField expression=expression serial=self.arena.exprOriginSerial[expression] base=base start=start length=length spanStart=spanStart spanEnd=spanEnd />)
        return expression
    }

    inout fn pushAuthoredBinaryExpression(op: I64, lhs: U64, rhs: U64, start: U64, end: U64) -> U64 {
        val exprId = self.pushExpr(e: <Expr.Binary op=op lhs=lhs rhs=rhs />)
        if isBinTraitOp(op: op) || op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            self.authoredBinaryExpressions[exprId] = <AuthoredBinaryExpression serial=self.arena.exprOriginSerial[exprId] start=start end=end op=op lhs=lhs rhs=rhs />
        }
        self.arena.exprSpanStart[exprId] = start
        self.arena.exprSpanEnd[exprId] = end
        return exprId
    }
}

pub impl Comp {
    // Value-position subscript syntax is an Index requirement call.  The
    // generated node has no source spelling of its own, so give it an explicit
    // synthetic origin before any semantic pass records templates.
    inout fn lowerIndexRead(recv: U64, key: U64) -> Result[U64, CompileDiagnostic] {
        // Preserve storage provenance beside the synthetic value read. A later
        // Record/freeze access elaborator decides whether this is a pure read
        // or get-modify-set; Lower never guesses from a method name.
        val place: U64 = self.pushExpr(e: <Expr.Index base=recv index=key />)
        val call: U64 = self.synthMethodCall(recv: recv, name: "index", arg0Label: "key", arg0: key, arg0HasLabel: true, hasArg1: false, arg1Label: "", arg1: 0U64, arg1HasLabel: false)
        val originSerial: U64 = self.arena.exprOriginSerial[call]
        try self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=call kind=<SyntheticCallKind.IndexRead /> originSerial=originSerial receiverTerm=0U64 />)
        // The write facet intentionally uses the read result only as a
        // declaration-time Value type anchor. It is detached from executable
        // source and cannot be scanned/emitted as a second call; access
        // elaboration replaces it with the materialized temporary after the
        // selected parent ABI says writeback is necessary.
        val write: U64 = self.synthMethodCall(recv: recv, name: "indexSet", arg0Label: "key", arg0: key, arg0HasLabel: true, hasArg1: true, arg1Label: "value", arg1: call, arg1HasLabel: false)
        try self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=write kind=<SyntheticCallKind.IndexWrite /> originSerial=self.arena.exprOriginSerial[write] receiverTerm=0U64 />)
        self.decls.registerAccessCandidate(<AccessCandidate readExpr=call writeExpr=write placeExpr=place originSerial=originSerial />, expressionCount: self.arena.exprs.count())
        return <Result.Ok value=call />
    }

    inout fn bodyTypeNeedsViewAdmission(ref: U64) -> Bool {
        if ref == 0U64 { return false }
        val term = self.arena.typeTermAt(index: ref)
        if term.assocNameId != 0U64 || term.hasTopLevelView() { return true }
        for index in 0U64..<self.typeTermRefChildCount(ref: ref) {
            if self.bodyTypeNeedsViewAdmission(ref: self.typeTermRefChildRef(ref: ref, index: index)) { return true }
        }
        return false
    }

    inout fn lowerCast(operand: U64, target: PType) -> U64 {
        val expression = self.pushExpr(e: <Expr.Cast operand=operand tyStart=target.start tyLen=target.len ty=target.ref />)
        if self.bodyTypeNeedsViewAdmission(ref: target.ref) { self.authoredCastTargets[expression] = target.authoredUse }
        return expression
    }

    inout fn retainClosureTypeSlots(expression: U64, parameters: Array[Param], result: PType) {
        mut val authored: Array[(index: U64, occurrence: U64)] = []
        if self.bodyTypeNeedsViewAdmission(ref: result.ref) { authored.append((index: 0U64, occurrence: result.authoredUse)) }
        for index in 0U64..<parameters.count() {
            val parameter = parameters[index]
            if self.bodyTypeNeedsViewAdmission(ref: parameter.ty) { authored.append((index: index + 1U64, occurrence: parameter.authoredTypeUse)) }
        }
        if authored.count() != 0U64 { self.authoredExpressionTypeSlots[expression] = authored }
    }

    // Only source expression lowering registers a block as a value producer
    // for this particular expression. A raw node can still reuse either ID.
    inout fn recordAuthoredValueBlockUses(exprId: U64) {
        match self.arena.exprs[exprId] {
            Expr.Block(body: val body, offset: _) => { self.authoredValueBlockOwners[body] = exprId }
            Expr.IfExpr(cond: _, thenBlk: val thenBlk, elseBlk: val elseBlk) => {
                self.authoredValueBlockOwners[thenBlk] = exprId
                self.authoredValueBlockOwners[elseBlk] = exprId
            }
            Expr.IfChain(conditions: _, thenBlk: val thenBlk, elseBlk: val elseBlk) => {
                self.authoredValueBlockOwners[thenBlk] = exprId
                self.authoredValueBlockOwners[elseBlk] = exprId
            }
            Expr.MatchExpr(scrut: _, arms: val arms) => {
                mut val index = 0U64
                while index < arms.len {
                    val arm = self.matchArmAt(arms: arms, index: index)
                    self.authoredValueBlockOwners[arm.body] = exprId
                    index += 1U64
                }
            }
            _ => {}
        }
    }

    inout fn lowerExpressionStatement(exprId: U64) -> U64 {
        match self.arena.exprs[exprId] {
            Expr.Block(body: val body, offset: _) => { self.authoredValueBlockOwners.remove(key: body) }
            _ => {}
        }
        return self.pushStmt(s: <Stmt.ExprStmt expr=exprId />)
    }

    inout fn lowerExpr(e: ExprAst) -> Result[U64, CompileDiagnostic] {
        val parent = self.loweringTypeUses
        self.loweringTypeUses = []
        val result = self.lowerExprScoped(e: e)
        val uses = self.loweringTypeUses
        self.loweringTypeUses = parent
        match result {
            Result.Ok(value: val node) => {
                if uses.count() != 0U64 {
                    mut val combined: Array[U64] = self.expressionTypeUses.getOr(key: node, fallback: [])
                    for occurrence in uses { combined.append(occurrence) }
                    self.expressionTypeUses[node] = combined
                    self.recordAuthoredTypeFrontier(node: <SourceControlNode.Expression id=node />, occurrences: uses)
                }
            }
            Result.Err(error: _) => {}
        }
        return result
    }

    inout fn lowerExprScoped(e: ExprAst) -> Result[U64, CompileDiagnostic] {
        mut val result: U64 = 0
        match e {
            ExprAst.IntLit(val value, val isBool, val tySuffix, literalSpan: _, tySuffixSpan: _, val span) => {
                mut val sStart: U64 = 0
                mut val sLen: U64 = 0
                if tySuffix.bytes().count() > 0 {
                    val sf: Bind = self.internBytes(s: tySuffix)
                    sStart = sf.nameStart
                    sLen = sf.nameLen
                }
                result = self.pushExpr(e: <Expr.Int value=value offset=span.start isBool=isBool tyStart=sStart tyLen=sLen isNeg=false />)
                self.recordAuthoredNumericOrigin(expression: result, start: span.start, end: span.end, floating: false, booleanLiteral: isBool, suffixLength: sLen)
            }
            ExprAst.FloatLit(val text, val tySuffix, literalSpan: _, tySuffixSpan: _, val span) => {
                val tb: Bind = self.internBytes(s: text)
                mut val sStart: U64 = 0
                mut val sLen: U64 = 0
                if tySuffix.bytes().count() > 0 {
                    val sf: Bind = self.internBytes(s: tySuffix)
                    sStart = sf.nameStart
                    sLen = sf.nameLen
                }
                result = self.pushExpr(e: <Expr.Float start=tb.nameStart len=tb.nameLen tyStart=sStart tyLen=sLen />)
                self.recordAuthoredNumericOrigin(expression: result, start: span.start, end: span.end, floating: true)
            }
            ExprAst.StrLit(val raw, val span) => {
                result = self.pushExpr(e: <Expr.Str start=span.start len=spanLen(s: span) />)
            }
            ExprAst.StringInterpolation(val parts, val span) => {
                result = try self.lowerStringInterpolation(parts: parts, span: span)
            }
            ExprAst.Ident(val name, val span) => {
                result = self.pushAuthoredIdentifier(start: span.start, length: spanLen(s: span), spanStart: span.start, spanEnd: span.end)
            }
            ExprAst.Unary(val op, val operand, val span) => {
                // fold a leading `-` on a BARE integer literal into a negative literal
                // (spec/02: `-128I8` is the literal -128, not Neg(128I8)). The parser
                // has already resolved precedence, so `operand` is a plain IntLit only
                // when the `-` binds directly to the literal (`-128.foo()` lowers its
                // operand to a Method, not an IntLit — left as a real Neg). codegen then
                // emits a constant `-128`, and the Neg witness is reserved for runtime
                // operands (which is where the checked-overflow semantics belong).
                mut val folded: Bool = false
                if op == opSub() {
                    match operand {
                        ExprAst.IntLit(val value, val isBool, val tySuffix, literalSpan: _, tySuffixSpan: _, span: val litSpan) => {
                            if !(isBool) {
                                mut val sStart: U64 = 0
                                mut val sLen: U64 = 0
                                if tySuffix.bytes().count() > 0 {
                                    val sf: Bind = self.internBytes(s: tySuffix)
                                    sStart = sf.nameStart
                                    sLen = sf.nameLen
                                }
                                result = self.pushExpr(e: <Expr.Int value=value offset=litSpan.start isBool=false tyStart=sStart tyLen=sLen isNeg=true />)
                                self.recordAuthoredNumericOrigin(expression: result, start: exprAstSpan(e: e).start, end: exprAstSpan(e: e).end, floating: false, suffixLength: sLen)
                                folded = true
                            }
                        }
                        _ => {}
                    }
                }
                if !(folded) {
                    val o: U64 = (try self.lowerExpr(e: operand))
                    result = self.pushExpr(e: <Expr.Unary op=op operand=o />)
                }
            }
            ExprAst.Binary(val op, val lhs, val rhs, val span) => {
                val l: U64 = (try self.lowerExpr(e: lhs))
                val r: U64 = (try self.lowerExpr(e: rhs))
                result = self.pushAuthoredBinaryExpression(op: op, lhs: l, rhs: r, start: span.start, end: span.end)
            }
            ExprAst.Call(val name, nameSpan: _, val args, val span) => {
                // ORIGINAL offset (name is at the call's span start) — feeds moduleOf.
                val a = (try self.lowerArgs(args: args))
                result = self.pushExpr(e: <Expr.Call nameStart=span.start nameLen=name.bytes().count() args=a />)
                self.authoredFreeCallOrigins[result] = (start: span.start, length: name.bytes().count(), arguments: a)
            }
            ExprAst.Field(val base, val name, val nameSpan, val span) => {
                // the field name's SOURCE span, not an interned copy: the bytes there ARE
                // the name (resolution compares by content), and a typo'd field then
                // errors at its own token — an interned span mapped to a garbage line.
                // Same policy as the destructure desugar's synthesized Fields.
                val b: U64 = (try self.lowerExpr(e: base))
                result = self.pushAuthoredField(base: b, start: nameSpan.start, length: name.bytes().count(), spanStart: span.start, spanEnd: span.end)
            }
            ExprAst.Method(val recv, val name, val nameSpan, val args, val span) => {
                val recvId = (try self.lowerExpr(e: recv))
                val loweredArgs = (try self.lowerArgs(args: args))
                result = self.pushExpr(e: <Expr.Method recv=recvId nameStart=nameSpan.start nameLen=name.bytes().count() args=loweredArgs />)
                self.authoredMethodExpressions.insert(result)
            }
            ExprAst.ArrowMethod(val recv, val name, val nameSpan, val args, val span) => {
                // `recv->name(args)`: a pointee method call. Lower the receiver, wrap it in a
                // `Deref` (the pointee place), and dispatch `name` on it like a normal `Method`
                // — the backend resolves `Deref`'s struct/type and self-place from the cell.
                val r: U64 = (try self.lowerExpr(e: recv))
                val d: U64 = self.pushExpr(e: <Expr.Deref base=r />)
                val a = (try self.lowerArgs(args: args))
                result = self.pushExpr(e: <Expr.Method recv=d nameStart=nameSpan.start nameLen=name.bytes().count() args=a />)
                self.authoredMethodExpressions.insert(result)
            }
            ExprAst.ExtMethod(val recv, val src, val srcSpan, val name, nameSpan: _, val args, val span) => {
                val r: U64 = (try self.lowerExpr(e: recv))
                val a = (try self.lowerArgs(args: args))
                val nm: Bind = self.internBytes(s: name)
                result = self.pushExpr(e: <Expr.ExtMethod recv=r source=(try self.lowerViewSourceSpan(siteOffset: span.start, start: srcSpan.start, len: srcSpan.end - srcSpan.start)) nameStart=nm.nameStart nameLen=nm.nameLen args=a />)
                self.authoredMethodExpressions.insert(result)
            }
            ExprAst.SourceSelection(val recv, val path, val application, val strip, sourceSpan: _, val span) => { result = try self.lowerValueSourceSelection(recv: recv, path: path, application: application, strip: strip, span: span) }
            ExprAst.ExtView(val recv, val src, val srcSpan, val strip, val span) => {
                val r: U64 = (try self.lowerExpr(e: recv))
                result = try self.lowerValueView(recv: r, source: (try self.lowerViewSourceSpan(siteOffset: span.start, start: srcSpan.start, len: srcSpan.end - srcSpan.start)), strip: strip)
            }
            ExprAst.Index(val base, val index, val span) => {
                val b: U64 = (try self.lowerExpr(e: base))
                val idx: U64 = (try self.lowerExpr(e: index))
                result = (try self.lowerIndexRead(recv: b, key: idx))
                self.retainAuthoredIndexRead(expression: result)
            }
            ExprAst.Make(val typeName, val typeNameSpan, val typePath, val typeArgs, val variant, val variantSpan, val isEnum, val fields, val span) => {
                mut val tn: Bind = self.lowerTypeName(name: typeName, span: typeNameSpan)
                mut val constructionEnum = isEnum
                mut val constructorVariant = variant
                mut val constructorVariantSpan = variantSpan
                mut val constructorArgs = typeArgs
                if typePath.count() != 0U64 {
                    mut val names: Array[Span] = []
                    mut val index = 0U64
                    while index < typePath.count() { names.append(typePath[index].nameSpan) index += 1U64 }
                    val headIndex = (try self.typePathHead(names: names))
                    index = 0U64
                    while index < typePath.count() {
                        if index != headIndex && typePath[index].args.count() != 0U64 { return <Result.Err error=self.diagnosticAt(offset: names[index].start, msg: "only the constructed type accepts type arguments") /> }
                        index += 1U64
                    }
                    val head = typePath[headIndex]
                    tn = self.lowerTypeName(name: head.name, span: head.nameSpan)
                    constructorArgs = head.args
                    constructionEnum = headIndex + 1U64 < typePath.count()
                    if constructionEnum {
                        if headIndex + 2U64 != typePath.count() { return <Result.Err error=self.diagnosticAt(offset: typeNameSpan.start, msg: "invalid construction path") /> }
                        constructorVariant = typePath[headIndex + 1U64].name
                        constructorVariantSpan = typePath[headIndex + 1U64].nameSpan
                    }
                }
                mut val targs: Array[U64] = []
                mut val authored: Array[(index: U64, occurrence: U64)] = []
                mut val ti: U64 = 0U64
                while ti < constructorArgs.count() {
                    val argument = try self.lowerType(t: constructorArgs[ti])
                    targs.append(argument.ref)
                    if self.bodyTypeNeedsViewAdmission(ref: argument.ref) { authored.append((index: ti, occurrence: argument.authoredUse)) }
                    ti += 1U64
                }
                val tyRef = try self.lowerConstructionType(nameStart: tn.nameStart, nameLen: tn.nameLen, args: targs, siteOffset: typeNameSpan.start)
                mut val vStart: U64 = 0
                mut val vLen: U64 = 0
                if constructionEnum {
                    val vb: Bind = self.lowerTypeName(name: constructorVariant, span: constructorVariantSpan)
                    vStart = vb.nameStart
                    vLen = vb.nameLen
                }
                val fs: Array[MakeField] = (try self.lowerMakeFields(fields: fields))
                result = self.pushExpr(e: <Expr.Make typeStart=tn.nameStart typeLen=tn.nameLen variantStart=vStart variantLen=vLen isEnum=constructionEnum ty=tyRef fields=self.pushMakeFields(fields: fs) />)
                self.authoredConstructions[result] = <AuthoredConstruction offset=span.start expression=self.arena.exprs[result] typeFromContext=false />
                if authored.count() != 0U64 { self.authoredExpressionTypeSlots[result] = authored }
                if typeNameSpan.start == typeNameSpan.end && typeName.bytes().count() == 0U64 { self.pendingConstructionContexts.insert(result) }
            }
            ExprAst.ArrayLit(val elems, val span) => {
                mut val es: Array[U64] = []
                mut val i: U64 = 0
                while i < elems.count() {
                    es.append((try self.lowerExpr(e: elems[i])))
                    i += 1
                }
                val children = self.pushExprs(exprs: es)
                result = self.pushExpr(e: <Expr.Array elems=children />)
                if children.len == 0U64 {
                    self.authoredArrayLiterals[result] = <AuthoredArrayLiteral serial=self.arena.exprOriginSerial[result] start=span.start end=span.end elements=children />
                }
            }
            ExprAst.DictLit(val keys, val vals, val span) => {
                // Keep source entries until Record supplies their expected type.
                result = (try self.lowerDictLit(keys: keys, vals: vals, span: span))
            }
            ExprAst.RecordLit(val fields, val span) => {
                // Labels and child expressions are structural source information.
                val fs: Array[MakeField] = (try self.lowerMakeFields(fields: fields))
                result = self.pushExpr(e: <Expr.Make typeStart=0 typeLen=0 variantStart=0 variantLen=0 isEnum=false ty=0 fields=self.pushMakeFields(fields: fs) />)
            }
            ExprAst.Cast(val operand, val ty, val span) => {
                val o: U64 = (try self.lowerExpr(e: operand))
                val pt: PType = (try self.lowerType(t: ty))
                result = self.lowerCast(operand: o, target: pt)
            }
            ExprAst.MatchExpr(val scrut, val arms, span: _) => {
                result = self.pushExpr(e: <Expr.MatchExpr scrut=(try self.lowerExpr(e: scrut)) arms=(try self.lowerMatchArms(arms: arms)) />)
                self.recordAuthoredValueBlockUses(exprId: result)
            }
            ExprAst.BlockExpr(val body, val span) => { result = self.pushExpr(e: <Expr.Block body=(try self.lowerBlock(b: body)) offset=span.start />) self.recordAuthoredValueBlockUses(exprId: result) }
            ExprAst.IfChain(val conditions, val thenBlk, val elseBlk, span: _) => {
                result = self.pushExpr(e: <Expr.IfChain conditions=(try self.lowerConditionClauses(conditions: conditions)) thenBlk=(try self.lowerBlock(b: thenBlk)) elseBlk=(try self.lowerBlock(b: elseBlk)) />)
                self.recordAuthoredValueBlockUses(exprId: result)
            }
            ExprAst.IfExpr(val cond, val thenBlk, val elseBlk, val span) => {
                val cnd: U64 = (try self.lowerExpr(e: cond))
                val tb: U64 = (try self.lowerBlock(b: thenBlk))
                val eb: U64 = (try self.lowerBlock(b: elseBlk))
                result = self.pushExpr(e: <Expr.IfExpr cond=cnd thenBlk=tb elseBlk=eb />)
                self.recordAuthoredValueBlockUses(exprId: result)
            }
            ExprAst.OptChain(val base, val cont, val memberSpan, val span) => {
                // the trailing chain `cont` is lowered with its ChainHole root intact; the
                // mono desugar substitutes the match-bound value for the hole. Anchor the
                // OptChain node at the `?.member` source token (diagnostics).
                val b: U64 = (try self.lowerExpr(e: base))
                val c: U64 = (try self.lowerExpr(e: cont))
                result = self.pushExpr(e: <Expr.OptChain base=b cont=c />)
                self.arena.exprSpanStart[result] = memberSpan.start
            }
            ExprAst.ChainHole(val span) => {
                result = self.pushExpr(e: <Expr.ChainHole />)
                self.arena.exprSpanStart[result] = span.start
            }
            ExprAst.Try(val operand, val span) => {
                val o: U64 = (try self.lowerExpr(e: operand))
                result = self.pushExpr(e: <Expr.Try expr=o />)
            }
            ExprAst.Arrow(val base, val name, val nameSpan, val span) => {
                // SOURCE span for the pointee field name (see ExprAst.Field above).
                val b: U64 = (try self.lowerExpr(e: base))
                result = self.pushExpr(e: <Expr.Arrow base=b nameStart=nameSpan.start nameLen=name.bytes().count() />)
            }
            ExprAst.Closure(val params, val hasRet, val ret, val body, val span, isDiverging: val diverging) => {
                val ps: Array[Param] = (try self.lowerParams(params: params))
                mut val rStart: U64 = 0
                mut val rLen: U64 = 0
                mut val rIsArray: Bool = false
                mut val rTy: U64 = 0
                mut val resultType: PType = <PType start=0U64 len=0U64 isArray=false ref=0U64 />
                if hasRet {
                    val pt: PType = (try self.lowerType(t: ret))
                    resultType = pt
                    rStart = pt.start
                    rLen = pt.len
                    rIsArray = pt.isArray
                    rTy = pt.ref
                }
                val savedRet: U64 = self.cur.lowerRetTy
                self.cur.lowerRetTy = rTy
                val bd: U64 = (try self.lowerBlock(b: body))
                self.cur.lowerRetTy = savedRet
                result = self.pushExpr(e: <Expr.Closure isDiverging=diverging params=ps hasRet=hasRet retStart=rStart retLen=rLen retIsArray=rIsArray retTy=rTy body=bd />)
                self.authoredClosureSignatures[result] = <AuthoredClosureSignature scope=self.sourceTypeUses.currentScope() serial=self.arena.exprOriginSerial[result] start=span.start end=span.end expression=self.arena.exprs[result] />
                self.retainClosureTypeSlots(expression: result, parameters: ps, result: resultType)
            }
            ExprAst.Move(val operand, val isBorrow, val span) => {
                val o: U64 = (try self.lowerExpr(e: operand))
                result = self.pushExpr(e: <Expr.Move operand=o isBorrow=isBorrow />)
            }
            ExprAst.Await(val operand, val span) => {
                val o: U64 = (try self.lowerExpr(e: operand))
                result = self.pushExpr(e: <Expr.Await operand=o />)
            }
        }
        // record the AST node's span for the lowered root (diagnostic-position store;
        // desugarings above may create several nodes — the root carries the source span)
        if result < self.arena.exprSpanStart.count() {
            self.arena.exprSpanStart[result] = exprAstSpan(e: e).start
            self.arena.exprSpanEnd[result] = exprAstSpan(e: e).end
        }
        return <Result.Ok value=result />
    }

    // Range syntax is fixed sugar for ordinary aggregate construction. Keep
    // both endpoint expressions in source order and let the common Make
    // inference/checking pipeline determine their element type.
    inout fn lowerRangeConstruction(low: U64, high: U64, inclusive: Bool, span: Span) -> Result[U64, CompileDiagnostic] {
        val name = if inclusive { give "ClosedRange" } else { give "HalfOpenRange" }
        val typeName = self.internBytes(s: name)
        val rangeTy = try self.lowerConstructionType(nameStart: typeName.nameStart, nameLen: typeName.nameLen, args: [], siteOffset: span.start)
        val result = self.pushExpr(e: <Expr.Range rangeTy=rangeTy endpoints=self.pushExprs(exprs: [low, high]) />)
        self.arena.exprSpanStart[result] = span.start
        self.arena.exprSpanEnd[result] = span.end
        return <Result.Ok value=result />
    }

    inout fn lowerSyntaxRange(expr: SyntaxExpr) -> Result[U64, CompileDiagnostic] {
        val low: U64 = (try self.lowerSyntaxExpr(id: expr.child0))
        val high: U64 = (try self.lowerSyntaxExpr(id: expr.child1))
        return self.lowerRangeConstruction(low: low, high: high, inclusive: expr.flag0, span: expr.span)
    }

    inout fn lowerSyntaxExpr(id: ExprId) -> Result[U64, CompileDiagnostic] {
        val parent = self.loweringTypeUses
        self.loweringTypeUses = []
        val result = self.lowerSyntaxExprScoped(id: id)
        val uses = self.loweringTypeUses
        self.loweringTypeUses = parent
        match result {
            Result.Ok(value: val node) => {
                if uses.count() != 0U64 {
                    mut val combined: Array[U64] = self.expressionTypeUses.getOr(key: node, fallback: [])
                    for occurrence in uses { combined.append(occurrence) }
                    self.expressionTypeUses[node] = combined
                    self.recordAuthoredTypeFrontier(node: <SourceControlNode.Expression id=node />, occurrences: uses)
                }
            }
            Result.Err(error: _) => {}
        }
        return result
    }

    inout fn lowerSyntaxExprScoped(id: ExprId) -> Result[U64, CompileDiagnostic] {
        val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
        mut val result: U64 = 0U64
        match e.kind {
            SyntaxExprKind.IntLit => {
                result = self.pushExpr(e: <Expr.Int value=e.intValue offset=e.text.start isBool=e.flag0 tyStart=e.name.start tyLen=e.name.end - e.name.start isNeg=false />)
                self.recordAuthoredNumericOrigin(expression: result, start: e.span.start, end: e.span.end, floating: false, booleanLiteral: e.flag0, suffixLength: e.name.end - e.name.start)
            }
            SyntaxExprKind.FloatLit => {
                result = self.pushExpr(e: <Expr.Float start=e.text.start len=e.text.end - e.text.start tyStart=e.name.start tyLen=e.name.end - e.name.start />)
                self.recordAuthoredNumericOrigin(expression: result, start: e.span.start, end: e.span.end, floating: true)
            }
            SyntaxExprKind.StrLit => {
                result = self.pushExpr(e: <Expr.Str start=e.text.start len=e.text.end - e.text.start />)
            }
            SyntaxExprKind.StringInterpolation => {
                result = try self.lowerSyntaxStringInterpolation(expr: e)
            }
            SyntaxExprKind.Ident => {
                result = self.pushAuthoredIdentifier(start: e.name.start, length: e.name.end - e.name.start, spanStart: e.span.start, spanEnd: e.span.end)
            }
            SyntaxExprKind.Unary => {
                mut val folded: Bool = false
                if e.op == opSub() {
                    val operand: SyntaxExpr = syntaxExpr(file: self.syntax, id: e.child0)
                    match operand.kind {
                        SyntaxExprKind.IntLit => {
                            if !(operand.flag0) {
                                result = self.pushExpr(e: <Expr.Int value=operand.intValue offset=operand.text.start isBool=false tyStart=operand.name.start tyLen=operand.name.end - operand.name.start isNeg=true />)
                                self.recordAuthoredNumericOrigin(expression: result, start: e.span.start, end: e.span.end, floating: false, suffixLength: operand.name.end - operand.name.start)
                                folded = true
                            }
                        }
                        _ => {}
                    }
                }
                if !(folded) {
                    result = self.pushExpr(e: <Expr.Unary op=e.op operand=(try self.lowerSyntaxExpr(id: e.child0)) />)
                }
            }
            SyntaxExprKind.Binary => {
                val lhs: U64 = (try self.lowerSyntaxExpr(id: e.child0))
                val rhs: U64 = (try self.lowerSyntaxExpr(id: e.child1))
                result = self.pushAuthoredBinaryExpression(op: e.op, lhs: lhs, rhs: rhs, start: e.span.start, end: e.span.end)
            }
            SyntaxExprKind.Call => {
                val args = (try self.lowerSyntaxArgs(expr: e))
                result = self.pushExpr(e: <Expr.Call nameStart=e.name.start nameLen=e.name.end - e.name.start args=args />)
                self.authoredFreeCallOrigins[result] = (start: e.name.start, length: e.name.end - e.name.start, arguments: args)
            }
            SyntaxExprKind.Field => {
                result = self.pushAuthoredField(base: (try self.lowerSyntaxExpr(id: e.child0)), start: e.name.start, length: e.name.end - e.name.start, spanStart: e.span.start, spanEnd: e.span.end)
            }
            SyntaxExprKind.Method => {
                val recv = (try self.lowerSyntaxExpr(id: e.child0))
                val args = (try self.lowerSyntaxArgs(expr: e))
                result = self.pushExpr(e: <Expr.Method recv=recv nameStart=e.name.start nameLen=e.name.end - e.name.start args=args />)
                self.authoredMethodExpressions.insert(result)
            }
            SyntaxExprKind.ArrowMethod => {
                val recv: U64 = (try self.lowerSyntaxExpr(id: e.child0))
                val deref: U64 = self.pushExpr(e: <Expr.Deref base=recv />)
                val args = (try self.lowerSyntaxArgs(expr: e))
                result = self.pushExpr(e: <Expr.Method recv=deref nameStart=e.name.start nameLen=e.name.end - e.name.start args=args />)
                self.authoredMethodExpressions.insert(result)
            }
            SyntaxExprKind.ExtMethod => {
                val recv: U64 = (try self.lowerSyntaxExpr(id: e.child0))
                val args = (try self.lowerSyntaxArgs(expr: e))
                result = self.pushExpr(e: <Expr.ExtMethod recv=recv source=(try self.lowerViewSourceSpan(siteOffset: e.span.start, start: e.text.start, len: e.text.end - e.text.start)) nameStart=e.name.start nameLen=e.name.end - e.name.start args=args />)
                self.authoredMethodExpressions.insert(result)
            }
            SyntaxExprKind.Arrow => {
                result = self.pushExpr(e: <Expr.Arrow base=(try self.lowerSyntaxExpr(id: e.child0)) nameStart=e.name.start nameLen=e.name.end - e.name.start />)
            }
            SyntaxExprKind.Index => {
                result = (try self.lowerIndexRead(recv: (try self.lowerSyntaxExpr(id: e.child0)), key: (try self.lowerSyntaxExpr(id: e.child1))))
                self.retainAuthoredIndexRead(expression: result)
            }
            SyntaxExprKind.Make => {
                mut val typeName = e.name
                mut val variantName = e.nameSpan
                mut val constructionEnum = e.flag0
                mut val headIndex = 0U64
                if e.typePath.count != 0U64 {
                    mut val names: Array[Span] = []
                    mut val index = 0U64
                    while index < e.typePath.count { names.append(syntaxExprTypeSegment(file: self.syntax, expr: e, index: index).name) index += 1U64 }
                    headIndex = (try self.typePathHead(names: names))
                    index = 0U64
                    while index < names.count() {
                        if index != headIndex && syntaxExprTypeSegment(file: self.syntax, expr: e, index: index).args.count != 0U64 { return <Result.Err error=self.diagnosticAt(offset: names[index].start, msg: "only the constructed type accepts type arguments") /> }
                        index += 1U64
                    }
                    typeName = names[headIndex]
                    constructionEnum = headIndex + 1U64 < names.count()
                    if constructionEnum {
                        if headIndex + 2U64 != names.count() { return <Result.Err error=self.diagnosticAt(offset: e.span.start, msg: "invalid construction path") /> }
                        variantName = names[headIndex + 1U64]
                    }
                }
                mut val typeArgs: Array[U64] = []
                mut val authored: Array[(index: U64, occurrence: U64)] = []
                mut val i: U64 = 0U64
                if e.typePath.count != 0U64 {
                    val head = syntaxExprTypeSegment(file: self.syntax, expr: e, index: headIndex)
                    while i < head.args.count {
                        val argument = try self.lowerSyntaxType(id: syntaxNameSegmentArg(file: self.syntax, segment: head, index: i))
                        typeArgs.append(argument.ref)
                        if self.bodyTypeNeedsViewAdmission(ref: argument.ref) { authored.append((index: i, occurrence: argument.authoredUse)) }
                        i += 1U64
                    }
                } else {
                    while i < syntaxExprTypeArgCount(file: self.syntax, expr: e) {
                        val argument = try self.lowerSyntaxType(id: syntaxExprTypeArg(file: self.syntax, expr: e, index: i))
                        typeArgs.append(argument.ref)
                        if self.bodyTypeNeedsViewAdmission(ref: argument.ref) { authored.append((index: i, occurrence: argument.authoredUse)) }
                        i += 1U64
                    }
                }
                val tyRef = try self.lowerConstructionType(nameStart: typeName.start, nameLen: typeName.end - typeName.start, args: typeArgs, siteOffset: e.name.start)
                val fields: Array[MakeField] = (try self.lowerSyntaxMakeFields(expr: e))
                result = self.pushExpr(e: <Expr.Make typeStart=typeName.start typeLen=typeName.end - typeName.start variantStart=variantName.start variantLen=variantName.end - variantName.start isEnum=constructionEnum ty=tyRef fields=self.pushMakeFields(fields: fields) />)
                self.authoredConstructions[result] = <AuthoredConstruction offset=e.span.start expression=self.arena.exprs[result] typeFromContext=false />
                if authored.count() != 0U64 { self.authoredExpressionTypeSlots[result] = authored }
                if e.name.start == e.name.end { self.pendingConstructionContexts.insert(result) }
            }
            SyntaxExprKind.Range => {
                result = (try self.lowerSyntaxRange(expr: e))
            }
            SyntaxExprKind.ArrayLit => {
                mut val elems: Array[U64] = []
                mut val i: U64 = 0U64
                while i < syntaxExprElemCount(file: self.syntax, expr: e) {
                    elems.append((try self.lowerSyntaxExpr(id: syntaxExprElem(file: self.syntax, expr: e, index: i))))
                    i += 1U64
                }
                val children = self.pushExprs(exprs: elems)
                result = self.pushExpr(e: <Expr.Array elems=children />)
                if children.len == 0U64 {
                    self.authoredArrayLiterals[result] = <AuthoredArrayLiteral serial=self.arena.exprOriginSerial[result] start=e.span.start end=e.span.end elements=children />
                }
            }
            SyntaxExprKind.DictLit => {
                result = (try self.lowerSyntaxDictLit(expr: e))
            }
            SyntaxExprKind.RecordLit => {
                val fields: Array[MakeField] = (try self.lowerSyntaxMakeFields(expr: e))
                result = self.pushExpr(e: <Expr.Make typeStart=0U64 typeLen=0U64 variantStart=0U64 variantLen=0U64 isEnum=false ty=0U64 fields=self.pushMakeFields(fields: fields) />)
            }
            SyntaxExprKind.Cast => {
                val ty: PType = (try self.lowerSyntaxType(id: e.type0))
                result = self.lowerCast(operand: (try self.lowerSyntaxExpr(id: e.child0)), target: ty)
            }
            SyntaxExprKind.BlockExpr => { result = self.pushExpr(e: <Expr.Block body=(try self.lowerSyntaxBlock(id: e.block0)) offset=e.span.start />) self.recordAuthoredValueBlockUses(exprId: result) }
            SyntaxExprKind.IfChain => {
                result = self.pushExpr(e: <Expr.IfChain conditions=(try self.lowerSyntaxConditionClauses(conditions: e.conditions)) thenBlk=(try self.lowerSyntaxBlock(id: e.block0)) elseBlk=(try self.lowerSyntaxBlock(id: e.block1)) />)
                self.recordAuthoredValueBlockUses(exprId: result)
            }
            SyntaxExprKind.IfExpr => {
                result = self.pushExpr(e: <Expr.IfExpr cond=(try self.lowerSyntaxExpr(id: e.child0)) thenBlk=(try self.lowerSyntaxBlock(id: e.block0)) elseBlk=(try self.lowerSyntaxBlock(id: e.block1)) />)
                self.recordAuthoredValueBlockUses(exprId: result)
            }
            SyntaxExprKind.MatchExpr => {
                result = (try self.lowerSyntaxMatchExprInto(expr: e))
                self.recordAuthoredValueBlockUses(exprId: result)
            }
            SyntaxExprKind.OptChain => {
                result = self.pushExpr(e: <Expr.OptChain base=(try self.lowerSyntaxExpr(id: e.child0)) cont=(try self.lowerSyntaxExpr(id: e.child1)) />)
            }
            SyntaxExprKind.ChainHole => {
                result = self.pushExpr(e: <Expr.ChainHole />)
            }
            SyntaxExprKind.Try => {
                result = self.pushExpr(e: <Expr.Try expr=(try self.lowerSyntaxExpr(id: e.child0)) />)
            }
            SyntaxExprKind.Move => {
                result = self.pushExpr(e: <Expr.Move operand=(try self.lowerSyntaxExpr(id: e.child0)) isBorrow=e.flag0 />)
            }
            SyntaxExprKind.Await => {
                result = self.pushExpr(e: <Expr.Await operand=(try self.lowerSyntaxExpr(id: e.child0)) />)
            }
            SyntaxExprKind.SourceSelection => { result = try self.lowerSyntaxSourceSelection(expr: e) }
            SyntaxExprKind.ExtView => {
                val receiver = (try self.lowerSyntaxExpr(id: e.child0))
                result = try self.lowerValueView(recv: receiver, source: (try self.lowerViewSourceSpan(siteOffset: e.span.start, start: e.text.start, len: e.text.end - e.text.start)), strip: e.flag0)
            }
            SyntaxExprKind.Closure => {
                val params: Array[Param] = (try self.lowerSyntaxExprParams(expr: e))
                mut val retStart: U64 = 0U64
                mut val retLen: U64 = 0U64
                mut val retIsArray: Bool = false
                mut val retTy: U64 = 0U64
                mut val resultType: PType = <PType start=0U64 len=0U64 isArray=false ref=0U64 />
                if e.flag0 {
                    val ret: PType = (try self.lowerSyntaxType(id: e.type0))
                    resultType = ret
                    retStart = ret.start
                    retLen = ret.len
                    retIsArray = ret.isArray
                    retTy = ret.ref
                }
                val savedRet: U64 = self.cur.lowerRetTy
                self.cur.lowerRetTy = retTy
                val body: U64 = (try self.lowerSyntaxBlock(id: e.block0))
                self.cur.lowerRetTy = savedRet
                result = self.pushExpr(e: <Expr.Closure isDiverging=e.flag1 params=params hasRet=e.flag0 retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retTy body=body />)
                self.authoredClosureSignatures[result] = <AuthoredClosureSignature scope=self.sourceTypeUses.currentScope() serial=self.arena.exprOriginSerial[result] start=e.span.start end=e.span.end expression=self.arena.exprs[result] />
                self.retainClosureTypeSlots(expression: result, parameters: params, result: resultType)
            }
            _ => {
                panic "compiler bug: incomplete SyntaxFile expression lowering was used before loader migration completed"
            }
        }
        if result < self.arena.exprSpanStart.count() {
            self.arena.exprSpanStart[result] = e.span.start
            self.arena.exprSpanEnd[result] = e.span.end
        }
        return <Result.Ok value=result />
    }
}
