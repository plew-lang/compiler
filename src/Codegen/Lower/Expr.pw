// Part of the lowering pass (root: _.pw): expression lowering
// (context-aware and plain).

// Lower an expression with a context type `ctxRef` (a TypeRef, 0 = none). A
// type-argument-less generic constructor `<Box v=… />` whose head matches the
// context type's head takes the context's type arguments (`Box[I64]`), so the
// instance is named/typed concretely without explicit `<Box[I64] …>`. (Bug11 —
// generic-constructor type-argument inference from the binding/return context.)
// Everything else falls through to the plain lowerExpr.

pub impl Comp {
    // Value-position subscript syntax is an Index requirement call.  The
    // generated node has no source spelling of its own, so give it an explicit
    // synthetic origin before any semantic pass records templates.
    inout fn lowerIndexRead(recv: U64, key: U64) -> U64 {
        // Preserve storage provenance beside the synthetic value read. A later
        // Record/freeze access elaborator decides whether this is a pure read
        // or get-modify-set; Lower never guesses from a method name.
        val place: U64 = self.pushExpr(e: <Expr.Index base=recv index=key />)
        val call: U64 = self.synthMethodCall(recv: recv, name: "index", arg0Label: "key", arg0: key, arg0HasLabel: true, hasArg1: false, arg1Label: "", arg1: 0U64, arg1HasLabel: false)
        val originSerial: U64 = self.arena.exprOriginSerial[call]
        self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=call originSerial=originSerial receiverTerm=0U64 />)
        // The write facet intentionally uses the read result only as a
        // declaration-time Value type anchor. It is detached from executable
        // source and cannot be scanned/emitted as a second call; access
        // elaboration replaces it with the materialized temporary after the
        // selected parent ABI says writeback is necessary.
        val write: U64 = self.synthMethodCall(recv: recv, name: "indexSet", arg0Label: "key", arg0: key, arg0HasLabel: true, hasArg1: true, arg1Label: "value", arg1: call, arg1HasLabel: false)
        self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=write originSerial=self.arena.exprOriginSerial[write] receiverTerm=0U64 />)
        self.decls.accessCandidates.append(<AccessCandidate readExpr=call writeExpr=write placeExpr=place originSerial=originSerial />)
        return call
    }

    inout fn lowerExprWithCtx(e: ExprAst, ctxRef: U64) -> U64 {
        if ctxRef != 0 {
            if ctxRef < self.arena.types.count() {
                val ct: TypeRef = self.arena.types[ctxRef]
                // a record literal adopting an annotated record type (`val p: (x: I64, y:
                // I64) = (x: 1, y: 2)`): the context already lowered to the synthetic record
                // struct (its name begins `(`), so build that struct directly.
                if ct.nameLen > 0U64 {
                    if self.arena.bytes[ct.nameStart] == '(' {
                        match e {
                            ExprAst.RecordLit(val fields, val span) => {
                                // pass the record struct's canonical name so makeFieldType can
                                // resolve each field's declared type — gives a NESTED record/dict
                                // literal field (`(a: (x:1,y:2), …)`) its own context (else the
                                // inner literal lowers context-free and the backend can't build it).
                                val recName: String = stringFromBytesUnchecked(extractSpan(buf: self.arena.bytes, start: ct.nameStart, len: ct.nameLen))
                                val fs: Array[MakeField] = self.lowerMakeFields(fields: fields, typeName: recName, variant: "", isEnum: false)
                                val rid: U64 = self.pushExpr(e: <Expr.Make typeStart=ct.nameStart typeLen=ct.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=self.pushMakeFields(fields: fs) />)
                                self.arena.exprSpanStart[rid] = span.start
                                return rid
                            }
                            _ => {}
                        }
                    }
                }
                if ct.args.count() > 0 {
                    match e {
                        ExprAst.Make(val typeName, typeNameSpan: _, val typeArgs, val variant, variantSpan: _, val isEnum, val fields, val span) => {
                            if !(isEnum) {
                                if typeArgs.count() == 0 {
                                    val tn: Bind = self.internBytes(s: typeName)
                                    if intern(c: inout self, start: tn.nameStart, len: tn.nameLen) == ct.nameId {
                                        val fs: Array[MakeField] = self.lowerMakeFields(fields: fields, typeName: typeName, variant: "", isEnum: false)
                                        val rid: U64 = self.pushExpr(e: <Expr.Make typeStart=tn.nameStart typeLen=tn.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=self.pushMakeFields(fields: fs) />)
                                        self.arena.exprSpanStart[rid] = span.start
                                        return rid
                                    }
                                }
                            }
                        }
                        ExprAst.DictLit(val keys, val vals, val span) => {
                            return self.lowerDictLit(keys: keys, vals: vals, ctxRef: ctxRef, span: span)
                        }
                        _ => {}
                    }
                }
            }
        }
        return self.lowerExpr(e: e)
    }

    inout fn lowerExpr(e: ExprAst) -> U64 {
        mut val result: U64 = 0
        match e {
            ExprAst.IntLit(val value, val isBool, val tySuffix, literalSpan: _, tySuffixSpan: _, val span) => {
                mut val sStart: U64 = 0
                mut val sLen: U64 = 0
                if tySuffix.bytes().count() > 0 {
                    val sf: Bind = self.internBytes(s: tySuffix)
                    sStart = sf.nameStart
                    sLen = sf.nameLen
                }
                result = self.pushExpr(e: <Expr.Int value=value offset=span.start isBool=isBool tyStart=sStart tyLen=sLen isNeg=false />)
            }
            ExprAst.FloatLit(val text, val tySuffix, literalSpan: _, tySuffixSpan: _, val span) => {
                val tb: Bind = self.internBytes(s: text)
                mut val sStart: U64 = 0
                mut val sLen: U64 = 0
                if tySuffix.bytes().count() > 0 {
                    val sf: Bind = self.internBytes(s: tySuffix)
                    sStart = sf.nameStart
                    sLen = sf.nameLen
                }
                result = self.pushExpr(e: <Expr.Float start=tb.nameStart len=tb.nameLen tyStart=sStart tyLen=sLen />)
            }
            ExprAst.StrLit(val raw, val span) => {
                result = self.pushExpr(e: <Expr.Str start=span.start len=spanLen(s: span) />)
            }
            ExprAst.Ident(val name, val span) => {
                result = self.pushExpr(e: <Expr.Ident start=span.start len=spanLen(s: span) />)
            }
            ExprAst.Unary(val op, val operand, val span) => {
                // fold a leading `-` on a BARE integer literal into a negative literal
                // (spec/02: `-128I8` is the literal -128, not Neg(128I8)). The parser
                // has already resolved precedence, so `operand` is a plain IntLit only
                // when the `-` binds directly to the literal (`-128.foo()` lowers its
                // operand to a Method, not an IntLit — left as a real Neg). codegen then
                // emits a constant `-128`, and the Neg witness is reserved for runtime
                // operands (which is where the checked-overflow semantics belong).
                mut val folded: Bool = false
                if op == opSub() {
                    match operand {
                        ExprAst.IntLit(val value, val isBool, val tySuffix, literalSpan: _, tySuffixSpan: _, span: val litSpan) => {
                            if !(isBool) {
                                mut val sStart: U64 = 0
                                mut val sLen: U64 = 0
                                if tySuffix.bytes().count() > 0 {
                                    val sf: Bind = self.internBytes(s: tySuffix)
                                    sStart = sf.nameStart
                                    sLen = sf.nameLen
                                }
                                result = self.pushExpr(e: <Expr.Int value=value offset=litSpan.start isBool=false tyStart=sStart tyLen=sLen isNeg=true />)
                                folded = true
                            }
                        }
                        _ => {}
                    }
                }
                if !(folded) {
                    val o: U64 = self.lowerExpr(e: operand)
                    result = self.pushExpr(e: <Expr.Unary op=op operand=o />)
                }
            }
            ExprAst.Binary(val op, val lhs, val rhs, val span) => {
                val l: U64 = self.lowerExpr(e: lhs)
                val r: U64 = self.lowerExpr(e: rhs)
                result = self.pushExpr(e: <Expr.Binary op=op lhs=l rhs=r />)
            }
            ExprAst.Call(val name, nameSpan: _, val args, val span) => {
                // ORIGINAL offset (name is at the call's span start) — feeds moduleOf.
                val a: Array[Arg] = self.lowerArgs(args: args, fnName: name)
                result = self.pushExpr(e: <Expr.Call nameStart=span.start nameLen=name.bytes().count() args=self.pushArgs(args: a) />)
            }
            ExprAst.Field(val base, val name, val nameSpan, val span) => {
                // the field name's SOURCE span, not an interned copy: the bytes there ARE
                // the name (resolution compares by content), and a typo'd field then
                // errors at its own token — an interned span mapped to a garbage line.
                // Same policy as the destructure desugar's synthesized Fields.
                val b: U64 = self.lowerExpr(e: base)
                result = self.pushExpr(e: <Expr.Field base=b nameStart=nameSpan.start nameLen=name.bytes().count() />)
            }
            ExprAst.Method(val recv, val name, val nameSpan, val args, val span) => {
                // a namespace call `Io.print(args)` (spec/15): the receiver is a namespace
                // bound by a `with`-less import. Lower to a bare free-function call using the
                // method name's ORIGINAL offset (feeds moduleOf) and record the import (so
                // the same export/visibility checks as `import … with { print }` apply).
                mut val isNsCall: Bool = false
                match recv {
                    ExprAst.Ident(name: val rname, span: _) => {
                        if self.isNamespaceName(name: rname) {
                            isNsCall = true
                        }
                    }
                    _ => {}
                }
                if isNsCall {
                    val a: Array[Arg] = self.lowerArgs(args: args, fnName: name)
                    self.markImport(segStart: nameSpan.start, segLen: name.bytes().count(), nameStart: nameSpan.start, nameLen: name.bytes().count())
                    result = self.pushExpr(e: <Expr.Call nameStart=nameSpan.start nameLen=name.bytes().count() args=self.pushArgs(args: a) />)
                } else {
                    val r: U64 = self.lowerExpr(e: recv)
                    val a: Array[Arg] = self.lowerMethodArgs(args: args, methodName: name)
                    // the name's SOURCE span, not an interned copy: resolution compares
                    // byte content (equivalent either way), and diagnostics anchored at
                    // nameStart (method visibility) need a real file:line.
                    result = self.pushExpr(e: <Expr.Method recv=r nameStart=nameSpan.start nameLen=name.bytes().count() args=self.pushArgs(args: a) />)
                }
            }
            ExprAst.ArrowMethod(val recv, val name, val nameSpan, val args, val span) => {
                // `recv->name(args)`: a pointee method call. Lower the receiver, wrap it in a
                // `Deref` (the pointee place), and dispatch `name` on it like a normal `Method`
                // — the backend resolves `Deref`'s struct/type and self-place from the cell.
                val r: U64 = self.lowerExpr(e: recv)
                val d: U64 = self.pushExpr(e: <Expr.Deref base=r />)
                val a: Array[Arg] = self.lowerMethodArgs(args: args, methodName: name)
                result = self.pushExpr(e: <Expr.Method recv=d nameStart=nameSpan.start nameLen=name.bytes().count() args=self.pushArgs(args: a) />)
            }
            ExprAst.ExtMethod(val recv, val src, srcSpan: _, val name, nameSpan: _, val args, val span) => {
                val r: U64 = self.lowerExpr(e: recv)
                val a: Array[Arg] = self.lowerArgs(args: args, fnName: "")
                val nm: Bind = self.internBytes(s: name)
                result = self.pushExpr(e: <Expr.ExtMethod recv=r source=self.lowerViewSource(siteOffset: span.start, text: src) nameStart=nm.nameStart nameLen=nm.nameLen args=self.pushArgs(args: a) />)
            }
            ExprAst.ExtView(val recv, val src, srcSpan: _, val strip, val span) => {
                val r: U64 = self.lowerExpr(e: recv)
                result = self.pushExpr(e: <Expr.ExtView recv=r source=self.lowerViewSource(siteOffset: span.start, text: src) strip=strip />)
            }
            ExprAst.Index(val base, val index, val span) => {
                val b: U64 = self.lowerExpr(e: base)
                val idx: U64 = self.lowerExpr(e: index)
                result = self.lowerIndexRead(recv: b, key: idx)
            }
            ExprAst.Make(val typeName, typeNameSpan: _, val typeArgs, val variant, variantSpan: _, val isEnum, val fields, val span) => {
                val tn: Bind = self.internBytes(s: typeName)
                mut val tyRef: U64 = 0
                if typeArgs.count() > 0 {
                    mut val targs: Array[U64] = []
                    mut val ti: U64 = 0
                    while ti < typeArgs.count() {
                        targs.append(self.lowerType(t: typeArgs[ti]).ref)
                        ti += 1
                    }
                    tyRef = self.pushType(t: <TypeRef nameStart=tn.nameStart nameLen=tn.nameLen args=targs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                }
                mut val vStart: U64 = 0
                mut val vLen: U64 = 0
                if isEnum {
                    val vb: Bind = self.internBytes(s: variant)
                    vStart = vb.nameStart
                    vLen = vb.nameLen
                }
                val fs: Array[MakeField] = self.lowerMakeFields(fields: fields, typeName: typeName, variant: variant, isEnum: isEnum)
                result = self.pushExpr(e: <Expr.Make typeStart=tn.nameStart typeLen=tn.nameLen variantStart=vStart variantLen=vLen isEnum=isEnum ty=tyRef fields=self.pushMakeFields(fields: fs) />)
            }
            ExprAst.ArrayLit(val elems, val span) => {
                mut val es: Array[U64] = []
                mut val i: U64 = 0
                while i < elems.count() {
                    es.append(self.lowerExpr(e: elems[i]))
                    i += 1
                }
                result = self.pushExpr(e: <Expr.Array elems=self.pushExprs(exprs: es) />)
            }
            ExprAst.DictLit(val keys, val vals, val span) => {
                // a bare dictionary literal with no binding/return context: K/V can't be
                // inferred (lowerDictLit reports the error).
                result = self.lowerDictLit(keys: keys, vals: vals, ctxRef: 0, span: span)
            }
            ExprAst.RecordLit(val fields, val span) => {
                // a record literal reached without a context type (no annotation / return
                // type). Lower to an Expr.Make whose struct is inferred from the field value
                // types at codegen (the synthetic record struct keyed by those types). ty=0
                // / no type name: the backend resolves the record struct from the values
                // (or st.expectedTy if a construction site set one).
                val fs: Array[MakeField] = self.lowerMakeFields(fields: fields, typeName: "", variant: "", isEnum: false)
                result = self.pushExpr(e: <Expr.Make typeStart=0 typeLen=0 variantStart=0 variantLen=0 isEnum=false ty=0 fields=self.pushMakeFields(fields: fs) />)
            }
            ExprAst.Cast(val operand, val ty, val span) => {
                val o: U64 = self.lowerExpr(e: operand)
                val pt: PType = self.lowerType(t: ty)
                result = self.pushExpr(e: <Expr.Cast operand=o tyStart=pt.start tyLen=pt.len ty=pt.ref />)
            }
            ExprAst.MatchExpr(val scrut, val arms, val span) => {
                if matchHasEnumOrStruct(arms: arms) {
                    if matchHasCapture(arms: arms) {
                        result = self.lowerEnumMatchCaptureExpr(scrut: scrut, arms: arms, span: span)
                    } else {
                        val s: U64 = self.lowerExpr(e: scrut)
                        val ma: MatchArmRange = self.lowerMatchArms(arms: arms, isExpr: true)
                        result = self.pushExpr(e: <Expr.MatchExpr scrut=s arms=ma />)
                    }
                } else {
                    result = self.lowerScalarMatchExpr(scrut: scrut, arms: arms, span: span)
                }
            }
            ExprAst.IfExpr(val cond, val thenBlk, val elseBlk, val span) => {
                val cnd: U64 = self.lowerExpr(e: cond)
                val tb: U64 = self.lowerBlock(b: thenBlk)
                val eb: U64 = self.lowerBlock(b: elseBlk)
                result = self.pushExpr(e: <Expr.IfExpr cond=cnd thenBlk=tb elseBlk=eb />)
            }
            ExprAst.OptChain(val base, val cont, val memberSpan, val span) => {
                // the trailing chain `cont` is lowered with its ChainHole root intact; the
                // mono desugar substitutes the match-bound value for the hole. Anchor the
                // OptChain node at the `?.member` source token (diagnostics).
                val b: U64 = self.lowerExpr(e: base)
                val c: U64 = self.lowerExpr(e: cont)
                result = self.pushExpr(e: <Expr.OptChain base=b cont=c />)
                self.arena.exprSpanStart[result] = memberSpan.start
            }
            ExprAst.ChainHole(val span) => {
                result = self.pushExpr(e: <Expr.ChainHole />)
                self.arena.exprSpanStart[result] = span.start
            }
            ExprAst.Try(val operand, val span) => {
                val o: U64 = self.lowerExpr(e: operand)
                result = self.pushExpr(e: <Expr.Try expr=o />)
            }
            ExprAst.Arrow(val base, val name, val nameSpan, val span) => {
                // SOURCE span for the pointee field name (see ExprAst.Field above).
                val b: U64 = self.lowerExpr(e: base)
                result = self.pushExpr(e: <Expr.Arrow base=b nameStart=nameSpan.start nameLen=name.bytes().count() />)
            }
            ExprAst.Closure(val params, val hasRet, val ret, val body, val span) => {
                val ps: Array[Param] = self.lowerParams(params: params)
                mut val rStart: U64 = 0
                mut val rLen: U64 = 0
                mut val rIsArray: Bool = false
                mut val rTy: U64 = 0
                if hasRet {
                    val pt: PType = self.lowerType(t: ret)
                    rStart = pt.start
                    rLen = pt.len
                    rIsArray = pt.isArray
                    rTy = pt.ref
                }
                val savedRet: U64 = self.cur.lowerRetTy
                self.cur.lowerRetTy = rTy
                val bd: U64 = self.lowerBlock(b: body)
                self.cur.lowerRetTy = savedRet
                result = self.pushExpr(e: <Expr.Closure params=ps hasRet=hasRet retStart=rStart retLen=rLen retIsArray=rIsArray retTy=rTy body=bd />)
            }
            ExprAst.Move(val operand, val isBorrow, val span) => {
                val o: U64 = self.lowerExpr(e: operand)
                result = self.pushExpr(e: <Expr.Move operand=o isBorrow=isBorrow />)
            }
            ExprAst.Await(val operand, val span) => {
                val o: U64 = self.lowerExpr(e: operand)
                result = self.pushExpr(e: <Expr.Await operand=o />)
            }
        }
        // record the AST node's span for the lowered root (diagnostic-position store;
        // desugarings above may create several nodes — the root carries the source span)
        if result < self.arena.exprSpanStart.count() {
            self.arena.exprSpanStart[result] = exprAstSpan(e: e).start
            self.arena.exprSpanEnd[result] = exprAstSpan(e: e).end
        }
        return result
    }

    // Context-aware SyntaxFile lowering. This mirrors lowerExprWithCtx without
    // reconstituting value AST nodes: context is semantic data, while every
    // child remains a stable immutable syntax ID.
    inout fn lowerSyntaxExprWithCtx(id: ExprId, ctxRef: U64) -> U64 {
        if ctxRef != 0U64 {
            if ctxRef < self.arena.types.count() {
                val ct: TypeRef = self.arena.types[ctxRef]
                val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
                if ct.nameLen > 0U64 {
                    if self.arena.bytes[ct.nameStart] == '(' {
                        match e.kind {
                            SyntaxExprKind.RecordLit => {
                                val fields: Array[MakeField] = self.lowerSyntaxMakeFields(expr: e, typeId: ct.nameId, variantId: 0U64, isEnum: false)
                                val result: U64 = self.pushExpr(e: <Expr.Make typeStart=ct.nameStart typeLen=ct.nameLen variantStart=0U64 variantLen=0U64 isEnum=false ty=ctxRef fields=self.pushMakeFields(fields: fields) />)
                                self.arena.exprSpanStart[result] = e.span.start
                                self.arena.exprSpanEnd[result] = e.span.end
                                return result
                            }
                            _ => {}
                        }
                    }
                }
                if ct.args.count() > 0U64 {
                    match e.kind {
                        SyntaxExprKind.Make => {
                            if !(e.flag0) {
                                if syntaxExprTypeArgCount(file: self.syntax, expr: e) == 0U64 {
                                    if intern(c: inout self, start: e.name.start, len: e.name.end - e.name.start) == ct.nameId {
                                        val fields: Array[MakeField] = self.lowerSyntaxMakeFields(expr: e, typeId: ct.nameId, variantId: 0U64, isEnum: false)
                                        val result: U64 = self.pushExpr(e: <Expr.Make typeStart=e.name.start typeLen=e.name.end - e.name.start variantStart=0U64 variantLen=0U64 isEnum=false ty=ctxRef fields=self.pushMakeFields(fields: fields) />)
                                        self.arena.exprSpanStart[result] = e.span.start
                                        self.arena.exprSpanEnd[result] = e.span.end
                                        return result
                                    }
                                }
                            }
                        }
                        SyntaxExprKind.DictLit => {
                            return self.lowerSyntaxDictLit(expr: e, ctxRef: ctxRef)
                        }
                        _ => {}
                    }
                }
            }
        }
        return self.lowerSyntaxExpr(id: id)
    }

    // SyntaxFile counterpart of expression lowering.  This path deliberately
    // reads scalar node views and child IDs only: it never materializes an
    // ExprAst/String tree from the immutable syntax arena.  More expression
    // categories are added before the normal loader is switched to SyntaxFile.
    inout fn lowerSyntaxExpr(id: ExprId) -> U64 {
        val e: SyntaxExpr = syntaxExpr(file: self.syntax, id: id)
        mut val result: U64 = 0U64
        match e.kind {
            SyntaxExprKind.IntLit => {
                result = self.pushExpr(e: <Expr.Int value=e.intValue offset=e.text.start isBool=e.flag0 tyStart=e.name.start tyLen=e.name.end - e.name.start isNeg=false />)
            }
            SyntaxExprKind.FloatLit => {
                result = self.pushExpr(e: <Expr.Float start=e.text.start len=e.text.end - e.text.start tyStart=e.name.start tyLen=e.name.end - e.name.start />)
            }
            SyntaxExprKind.StrLit => {
                result = self.pushExpr(e: <Expr.Str start=e.text.start len=e.text.end - e.text.start />)
            }
            SyntaxExprKind.Ident => {
                result = self.pushExpr(e: <Expr.Ident start=e.name.start len=e.name.end - e.name.start />)
            }
            SyntaxExprKind.Unary => {
                mut val folded: Bool = false
                if e.op == opSub() {
                    val operand: SyntaxExpr = syntaxExpr(file: self.syntax, id: e.child0)
                    match operand.kind {
                        SyntaxExprKind.IntLit => {
                            if !(operand.flag0) {
                                result = self.pushExpr(e: <Expr.Int value=operand.intValue offset=operand.text.start isBool=false tyStart=operand.name.start tyLen=operand.name.end - operand.name.start isNeg=true />)
                                folded = true
                            }
                        }
                        _ => {}
                    }
                }
                if !(folded) {
                    result = self.pushExpr(e: <Expr.Unary op=e.op operand=self.lowerSyntaxExpr(id: e.child0) />)
                }
            }
            SyntaxExprKind.Binary => {
                val lhs: U64 = self.lowerSyntaxExpr(id: e.child0)
                val rhs: U64 = self.lowerSyntaxExpr(id: e.child1)
                result = self.pushExpr(e: <Expr.Binary op=e.op lhs=lhs rhs=rhs />)
            }
            SyntaxExprKind.Field => {
                result = self.pushExpr(e: <Expr.Field base=self.lowerSyntaxExpr(id: e.child0) nameStart=e.name.start nameLen=e.name.end - e.name.start />)
            }
            SyntaxExprKind.Arrow => {
                result = self.pushExpr(e: <Expr.Arrow base=self.lowerSyntaxExpr(id: e.child0) nameStart=e.name.start nameLen=e.name.end - e.name.start />)
            }
            SyntaxExprKind.Index => {
                result = self.lowerIndexRead(recv: self.lowerSyntaxExpr(id: e.child0), key: self.lowerSyntaxExpr(id: e.child1))
            }
            SyntaxExprKind.Make => {
                mut val typeArgs: Array[U64] = []
                mut val i: U64 = 0U64
                while i < syntaxExprTypeArgCount(file: self.syntax, expr: e) {
                    typeArgs.append(self.lowerSyntaxType(id: syntaxExprTypeArg(file: self.syntax, expr: e, index: i)).ref)
                    i += 1U64
                }
                mut val tyRef: U64 = 0U64
                if typeArgs.count() > 0U64 {
                    tyRef = self.pushType(t: <TypeRef nameStart=e.name.start nameLen=e.name.end - e.name.start args=typeArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                }
                val typeId: U64 = intern(c: inout self, start: e.name.start, len: e.name.end - e.name.start)
                mut val variantId: U64 = 0U64
                if e.flag0 {
                    variantId = intern(c: inout self, start: e.nameSpan.start, len: e.nameSpan.end - e.nameSpan.start)
                }
                val fields: Array[MakeField] = self.lowerSyntaxMakeFields(expr: e, typeId: typeId, variantId: variantId, isEnum: e.flag0)
                result = self.pushExpr(e: <Expr.Make typeStart=e.name.start typeLen=e.name.end - e.name.start variantStart=e.nameSpan.start variantLen=e.nameSpan.end - e.nameSpan.start isEnum=e.flag0 ty=tyRef fields=self.pushMakeFields(fields: fields) />)
            }
            SyntaxExprKind.DictLit => {
                result = self.lowerSyntaxDictLit(expr: e, ctxRef: 0U64)
            }
            SyntaxExprKind.Cast => {
                val ty: PType = self.lowerSyntaxType(id: e.type0)
                result = self.pushExpr(e: <Expr.Cast operand=self.lowerSyntaxExpr(id: e.child0) tyStart=ty.start tyLen=ty.len ty=ty.ref />)
            }
            SyntaxExprKind.OptChain => {
                result = self.pushExpr(e: <Expr.OptChain base=self.lowerSyntaxExpr(id: e.child0) cont=self.lowerSyntaxExpr(id: e.child1) />)
            }
            SyntaxExprKind.ChainHole => {
                result = self.pushExpr(e: <Expr.ChainHole />)
            }
            SyntaxExprKind.Try => {
                result = self.pushExpr(e: <Expr.Try expr=self.lowerSyntaxExpr(id: e.child0) />)
            }
            SyntaxExprKind.Move => {
                result = self.pushExpr(e: <Expr.Move operand=self.lowerSyntaxExpr(id: e.child0) isBorrow=e.flag0 />)
            }
            SyntaxExprKind.Await => {
                result = self.pushExpr(e: <Expr.Await operand=self.lowerSyntaxExpr(id: e.child0) />)
            }
            SyntaxExprKind.ExtView => {
                result = self.pushExpr(e: <Expr.ExtView recv=self.lowerSyntaxExpr(id: e.child0) source=self.lowerViewSourceSpan(siteOffset: e.span.start, start: e.text.start, len: e.text.end - e.text.start) strip=e.flag0 />)
            }
            _ => {
                panic "compiler bug: incomplete SyntaxFile expression lowering was used before loader migration completed"
            }
        }
        if result < self.arena.exprSpanStart.count() {
            self.arena.exprSpanStart[result] = e.span.start
            self.arena.exprSpanEnd[result] = e.span.end
        }
        return result
    }
}
