// Part of the lowering pass (root: _.pw): type lowering, record-struct
// synthesis, and argument / field / dict-literal lowering.

pub impl Comp {

    // Register an Array element type name for later monomorphization (deduped by the
    // element name span, which is mangled for compound elements). fieldStart carries
    // the element's structured ref so genCElem / the runtime recover its C type and
    // ARC behaviour (0 = a simple named element — use the name path). Driven by
    // lowerType when it lowers an `Array[E]`.
    inout fn recordArrayElem(ty: PType) {
        if ty.isArray {
            mut val i: U64 = 0
            while i < self.monoWork.arrayElems.count() {
                val e: Bind = self.monoWork.arrayElems[i]
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: ty.start, bLen: ty.len) {
                    return
                }
                i += 1
            }
            mut val elemRef: U64 = 0
            if ty.ref < self.arena.types.count() {
                val at: TypeRef = self.arena.types[ty.ref]
                if at.args.count() > 0 {
                    elemRef = at.args[0]
                }
            }
            // a nested array element (`Array[Array[I32]]`) needs the inner
            // `PlewArray_<inner>` registered (and emitted) first.
            self.ensureArrayElemDeps(elemRef: elemRef)
            self.monoWork.arrayElems.append(<Bind nameStart=ty.start nameLen=ty.len fieldStart=elemRef fieldLen=0 />)
        }
    }

    // Lower a type expression, reproducing parseTypeTok's arena seeding (head name +
    // recursively-lowered args, Array element span / compound mangling). Records the
    // array element for monomorphization. (Function types `fn(...)->R` are not modeled
    // by the shared TypeAst yet — they appear only in signatures, not bodies.)
    // A canonical key string for a lowered field type (for the structural record name):
    // the head name plus, for a generic instance, its argument keys recursively — so
    // `(x: Optional[I64])` and `(x: Optional[String])` get distinct record types, and the
    // nesting is reflected to full depth (`Box[Box[I32]]` vs `Box[Box[String]]` do NOT
    // collide). Arg recursion delegates to recordTypeKeyFromRef so the lowered key matches
    // the one the grounding pass rebuilds for the same type.
    inout fn recordTypeKey(pty: PType) -> Array[U8] {
        mut val out: Array[U8] = []
        if pty.ref < self.arena.types.count() {
            if self.arena.types[pty.ref].isSendable {
                appendBytes(into: inout out, from: "sendable ".bytes())
            }
        }
        mut val i: U64 = 0
        while i < pty.len {
            out.append(self.arena.bytes[pty.start + i])
            i += 1
        }
        if pty.ref < self.arena.types.count() {
            val tr: TypeRef = self.arena.types[pty.ref]
            if tr.args.count() > 0U64 {
                appendBytes(into: inout out, from: "[".bytes())
                mut val a: U64 = 0
                while a < tr.args.count() {
                    if a > 0U64 {
                        appendBytes(into: inout out, from: ",".bytes())
                    }
                    appendBytes(into: inout out, from: self.recordTypeKeyFromRef(ref: tr.args[a]))
                    a += 1
                }
                appendBytes(into: inout out, from: "]".bytes())
            }
        }
        return out
    }
}

pub impl Comp {

    // Build the semantic Record node associated with an already-registered
    // canonical layout struct.  The layout name remains available to lowering
    // and LLVM, but it is deliberately not the source of record meaning:
    // generic inference and grounding recurse through the explicit field
    // terms below.  `ensureRecordStruct` sorts fields, so this is also the
    // canonical ordering for structural equality and keys.
    inout fn recordTypeTermForLayout(name: Bind) -> U64 {
        val si: U64 = self.anyStructIndex(nameStart: name.nameStart, nameLen: name.nameLen)
        if si >= self.arena.structs.count() {
            val noLabels: Array[U64] = []
            val noFields: Array[U64] = []
            return self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=noLabels recordFieldTerms=noFields />)
        }
        val fields: Array[FieldDef] = self.arena.structs[si].fields
        mut val labels: Array[U64] = []
        mut val terms: Array[U64] = []
        mut val i: U64 = 0U64
        while i < fields.count() {
            labels.append(fields[i].nameId)
            terms.append(fields[i].ty)
            i += 1U64
        }
        return self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=labels recordFieldTerms=terms />)
    }

    // Construct a Record TypeTerm from the lexical terms at its source site.
    // The synthetic StructDef is an ABI layout cache only: it may have been
    // first registered in a different generic scope whose same-spelled `T`
    // has a different ParamId.  Never recover semantic children from it here.
    inout fn recordTypeTerm(name: Bind, fieldNames: Array[String], fieldTerms: Array[U64]) -> U64 {
        if fieldNames.count() != fieldTerms.count() { return 0U64 }
        mut val order: Array[U64] = []
        mut val i: U64 = 0U64
        while i < fieldNames.count() {
            order.append(i)
            i += 1U64
        }
        mut val a: U64 = 0U64
        while a < order.count() {
            mut val b: U64 = a + 1U64
            while b < order.count() {
                if stringGt(a: fieldNames[order[a]], b: fieldNames[order[b]]) {
                    val tmp: U64 = order[a]
                    order[a] = order[b]
                    order[b] = tmp
                }
                b += 1U64
            }
            a += 1U64
        }
        mut val labels: Array[U64] = []
        mut val terms: Array[U64] = []
        mut val oi: U64 = 0U64
        while oi < order.count() {
            val label: Bind = self.internBytes(s: fieldNames[order[oi]])
            labels.append(label.nameId)
            terms.append(fieldTerms[order[oi]])
            oi += 1U64
        }
        return self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=labels recordFieldTerms=terms />)
    }

    // Register (or find) the synthetic struct for an anonymous record type with the given
    // field names and lowered field types (spec/02). The struct is keyed by a canonical
    // name built from the fields sorted by name, so two records with the same field
    // set are the same type (structural identity). Returns the struct's name Bind.
    inout fn ensureRecordStruct(fieldNames: Array[String], fieldTys: Array[PType]) -> Bind {
        // sort field indices by name (insertion sort — field counts are tiny).
        mut val order: Array[U64] = []
        mut val i: U64 = 0
        while i < fieldNames.count() {
            order.append(i)
            i += 1
        }
        mut val a: U64 = 0
        while a < order.count() {
            mut val b: U64 = a + 1U64
            while b < order.count() {
                if stringGt(a: fieldNames[order[a]], b: fieldNames[order[b]]) {
                    val tmp: U64 = order[a]
                    order[a] = order[b]
                    order[b] = tmp
                }
                b += 1
            }
            a += 1
        }
        // canonical name `(n1:key1,n2:key2,...)` over the sorted fields.
        mut val cn: Array[U8] = []
        appendBytes(into: inout cn, from: "(".bytes())
        mut val j: U64 = 0
        while j < order.count() {
            if j > 0U64 {
                appendBytes(into: inout cn, from: ",".bytes())
            }
            appendBytes(into: inout cn, from: fieldNames[order[j]].bytes())
            appendBytes(into: inout cn, from: ":".bytes())
            appendBytes(into: inout cn, from: self.recordTypeKey(pty: fieldTys[order[j]]))
            j += 1
        }
        appendBytes(into: inout cn, from: ")".bytes())
        val nm: Bind = self.internBytes(s: stringFromBytesUnchecked(cn))
        val nid: U64 = intern(c: inout self, start: nm.nameStart, len: nm.nameLen)
        // already registered?
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            if self.arena.structs[si].nameId == nid {
                return nm
            }
            si += 1
        }
        // build the StructDef with fields in canonical (sorted) order.
        mut val fields: Array[FieldDef] = []
        mut val f: U64 = 0
        while f < order.count() {
            val fn2: Bind = self.internBytes(s: fieldNames[order[f]])
            val fty: PType = fieldTys[order[f]]
            fields.append(<FieldDef nameStart=fn2.nameStart nameLen=fn2.nameLen nameId=intern(c: inout self, start: fn2.nameStart, len: fn2.nameLen) tyStart=fty.start tyLen=fty.len tyNameId=intern(c: inout self, start: fty.start, len: fty.len) tyIsArray=fty.isArray ty=fty.ref isMut=false hasDefault=false defaultVal=0 vis=2 />)
            f += 1
        }
        val noTP: Array[Bind] = []
        self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=nid typeParams=noTP fields=fields isUnique=false isExtern=false />)
        return nm
    }

    // SyntaxFile keeps record labels as original source spans.  These helpers
    // deliberately parallel the legacy String path rather than materializing a
    // transient Array[String]: record identity is still its sorted labels plus
    // semantic field terms, while the compiler-facing parser stays copy-free.
    inout fn sourceSpanGt(a: Span, b: Span) -> Bool {
        val aLen: U64 = a.end - a.start
        val bLen: U64 = b.end - b.start
        mut val i: U64 = 0U64
        while i < aLen && i < bLen {
            if self.arena.bytes[a.start + i] > self.arena.bytes[b.start + i] { return true }
            if self.arena.bytes[a.start + i] < self.arena.bytes[b.start + i] { return false }
            i += 1U64
        }
        return aLen > bLen
    }

    inout fn appendSourceSpan(into: inout Array[U8], span: Span) {
        mut val i: U64 = 0U64
        while i < span.end - span.start {
            into.append(self.arena.bytes[span.start + i])
            i += 1U64
        }
    }

    inout fn recordTypeTermSpans(name: Bind, fieldNames: Array[Span], fieldTerms: Array[U64]) -> U64 {
        if fieldNames.count() != fieldTerms.count() { return 0U64 }
        mut val order: Array[U64] = []
        mut val i: U64 = 0U64
        while i < fieldNames.count() {
            order.append(i)
            i += 1U64
        }
        mut val a: U64 = 0U64
        while a < order.count() {
            mut val b: U64 = a + 1U64
            while b < order.count() {
                if self.sourceSpanGt(a: fieldNames[order[a]], b: fieldNames[order[b]]) {
                    val tmp: U64 = order[a]
                    order[a] = order[b]
                    order[b] = tmp
                }
                b += 1U64
            }
            a += 1U64
        }
        mut val labels: Array[U64] = []
        mut val terms: Array[U64] = []
        mut val oi: U64 = 0U64
        while oi < order.count() {
            val label: Span = fieldNames[order[oi]]
            labels.append(intern(c: inout self, start: label.start, len: label.end - label.start))
            terms.append(fieldTerms[order[oi]])
            oi += 1U64
        }
        return self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=labels recordFieldTerms=terms />)
    }

    inout fn ensureRecordStructSpans(fieldNames: Array[Span], fieldTys: Array[PType]) -> Bind {
        mut val order: Array[U64] = []
        mut val i: U64 = 0U64
        while i < fieldNames.count() {
            order.append(i)
            i += 1U64
        }
        mut val a: U64 = 0U64
        while a < order.count() {
            mut val b: U64 = a + 1U64
            while b < order.count() {
                if self.sourceSpanGt(a: fieldNames[order[a]], b: fieldNames[order[b]]) {
                    val tmp: U64 = order[a]
                    order[a] = order[b]
                    order[b] = tmp
                }
                b += 1U64
            }
            a += 1U64
        }
        mut val canonical: Array[U8] = []
        appendBytes(into: inout canonical, from: "(".bytes())
        mut val j: U64 = 0U64
        while j < order.count() {
            if j > 0U64 { appendBytes(into: inout canonical, from: ",".bytes()) }
            self.appendSourceSpan(into: inout canonical, span: fieldNames[order[j]])
            appendBytes(into: inout canonical, from: ":".bytes())
            appendBytes(into: inout canonical, from: self.recordTypeKey(pty: fieldTys[order[j]]))
            j += 1U64
        }
        appendBytes(into: inout canonical, from: ")".bytes())
        val nm: Bind = self.internBytes(s: stringFromBytesUnchecked(canonical))
        val nameId: U64 = intern(c: inout self, start: nm.nameStart, len: nm.nameLen)
        mut val si: U64 = 0U64
        while si < self.arena.structs.count() {
            if self.arena.structs[si].nameId == nameId { return nm }
            si += 1U64
        }
        mut val fields: Array[FieldDef] = []
        mut val fi: U64 = 0U64
        while fi < order.count() {
            val label: Span = fieldNames[order[fi]]
            val pty: PType = fieldTys[order[fi]]
            val labelId: U64 = intern(c: inout self, start: label.start, len: label.end - label.start)
            fields.append(<FieldDef nameStart=label.start nameLen=label.end - label.start nameId=labelId tyStart=pty.start tyLen=pty.len tyNameId=intern(c: inout self, start: pty.start, len: pty.len) tyIsArray=pty.isArray ty=pty.ref isMut=false hasDefault=false defaultVal=0 vis=2 />)
            fi += 1U64
        }
        val noTypeParams: Array[Bind] = []
        self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=nameId typeParams=noTypeParams fields=fields isUnique=false isExtern=false />)
        return nm
    }

    inout fn lowerType(t: TypeAst) -> PType {
        return self.lowerTypeCore(t: self.normalizeProjectionTypeActive(t: t))
    }

    inout fn lowerTypeCore(t: TypeAst) -> PType {
        // a labelled anonymous record type `(x: I32, y: I32)` (spec/02): lower to its
        // synthetic structural struct and return a PType naming it.
        if t.isRecord {
            mut val fieldTys: Array[PType] = []
            mut val fi: U64 = 0
            while fi < t.args.count() {
                fieldTys.append(self.lowerType(t: t.args[fi]))
                fi += 1
            }
            val rnm: Bind = self.ensureRecordStruct(fieldNames: t.argLabels, fieldTys: fieldTys)
            mut val fieldTerms: Array[U64] = []
            mut val ti: U64 = 0U64
            while ti < fieldTys.count() {
                fieldTerms.append(fieldTys[ti].ref)
                ti += 1U64
            }
            val rref: U64 = self.recordTypeTerm(name: rnm, fieldNames: t.argLabels, fieldTerms: fieldTerms)
            return <PType start=rnm.nameStart len=rnm.nameLen isArray=false ref=rref />
        }
        val nm: Bind = self.internBytes(s: t.name)
        mut val args: Array[U64] = []
        mut val argPtys: Array[PType] = []
        mut val i: U64 = 0
        while i < t.args.count() {
            val ap: PType = self.lowerType(t: t.args[i])
            argPtys.append(ap)
            args.append(ap.ref)
            i += 1
        }
        mut val viewExtId: U64 = 0
        mut val viewIds: Array[U64] = []
        mut val viewSources: Array[ResolvedViewSource] = []
        // Every authored selector enters the source-set normal form, including
        // the one-source case. `viewExtId` remains a compatibility mirror while
        // scalar consumers are migrated, but never carries the only source fact.
        if t.viewNames.count() > 0U64 {
            mut val vi: U64 = 0U64
            while vi < t.viewNames.count() {
                val source: ResolvedViewSource = self.lowerViewSource(siteOffset: t.span.start, text: t.viewNames[vi])
                mut val present: Bool = false
                mut val si: U64 = 0U64
                while si < viewSources.count() {
                    if self.semanticViewSourceEq(a: viewSources[si], b: source) { present = true }
                    si += 1U64
                }
                if !present { viewSources.append(source) }
                vi += 1U64
            }
        }
        if t.extView.bytes().count() > 0 {
            val source: ResolvedViewSource = self.lowerViewSource(siteOffset: t.span.start, text: t.extView)
            mut val present: Bool = false
            mut val si: U64 = 0U64
            while si < viewSources.count() {
                if self.semanticViewSourceEq(a: viewSources[si], b: source) { present = true }
                si += 1U64
            }
            if !present { viewSources.append(source) }
        }
        viewIds = self.viewSourceIds(sources: viewSources)
        // `viewExtId` is a legacy compatibility mirror.
        // A multi-selector type must never silently mean just its last spelling.
        if viewIds.count() == 1U64 { viewExtId = viewIds[0U64] }
        mut val assocTraitStart: U64 = 0
        mut val assocTraitLen: U64 = 0
        mut val assocTraitId: U64 = 0
        if t.projectionTrait.bytes().count() > 0 {
            val atn: Bind = self.internBytes(s: t.projectionTrait)
            // A projection source is a declaration identity, not its import
            // alias spelling.  Preserve that owner in the lowered type so
            // `TextConvert` and `BytesConvert` can select distinct same-name
            // traits and their associated witnesses.
            val owner: U64 = self.traitOwnerAtUse(start: atn.nameStart, len: atn.nameLen, arity: t.projectionTraitArgs.count())
            if owner != 0U64 {
                assocTraitStart = owner
                assocTraitLen = self.traitNameLenByOwner(owner: owner)
                assocTraitId = intern(c: inout self, start: assocTraitStart, len: assocTraitLen)
            } else {
                assocTraitStart = atn.nameStart
                assocTraitLen = atn.nameLen
                assocTraitId = intern(c: inout self, start: atn.nameStart, len: atn.nameLen)
            }
        }
        mut val assocTraitArgs: Array[U64] = []
        mut val assocTraitArgLabels: Array[U64] = []
        mut val ati: U64 = 0U64
        while ati < t.projectionTraitArgs.count() {
            assocTraitArgs.append(self.lowerType(t: t.projectionTraitArgs[ati]).ref)
            if ati < t.projectionTraitArgLabels.count() && t.projectionTraitArgLabels[ati].bytes().count() > 0U64 {
                val label: Bind = self.internBytes(s: t.projectionTraitArgLabels[ati])
                assocTraitArgLabels.append(intern(c: inout self, start: label.nameStart, len: label.nameLen))
            } else {
                assocTraitArgLabels.append(0U64)
            }
            ati += 1U64
        }
        mut val assocNameStart: U64 = 0
        mut val assocNameLen: U64 = 0
        mut val assocNameId: U64 = 0
        if t.projectionAssoc.bytes().count() > 0 {
            val aan: Bind = self.internBytes(s: t.projectionAssoc)
            assocNameStart = aan.nameStart
            assocNameLen = aan.nameLen
            assocNameId = intern(c: inout self, start: aan.nameStart, len: aan.nameLen)
        }
        // intern any named binding labels (`Item`/`Output` in `any P[Item=I32]`) parallel
        // to args; 0 for a positional argument.
        mut val argLabels: Array[U64] = []
        mut val li: U64 = 0
        while li < t.argLabels.count() {
            if t.argLabels[li].bytes().count() > 0 {
                val lblN: Bind = self.internBytes(s: t.argLabels[li])
                argLabels.append(intern(c: inout self, start: lblN.nameStart, len: lblN.nameLen))
            } else {
                argLabels.append(0U64)
            }
            li += 1
        }
        // The REAL source offset of this annotation (TypeAst.span.start), for scoped
        // type-visibility (Check/Visibility.pw walks self.arena.types by siteOffset). 0 = skip:
        // a head naming an in-scope type parameter (self.cur.typeParams, set during lowering) is
        // a binder, not a module-scoped type — exclude it from the visibility walk.
        mut val site: U64 = t.span.start
        mut val paramId: U64 = 0U64
        mut val tpi: U64 = 0
        while tpi < self.cur.typeParams.count() {
            val tp: Bind = self.cur.typeParams[tpi]
            // A projection's receiver is still a lexical type parameter.  Do
            // not send `T#Trait.Item` through module type-name resolution just
            // because the outer term is a projection: during declaration-time
            // checks its receiver is a symbolic Param, not a concrete witness.
            if spansEqual(c: inout self, aStart: tp.nameStart, aLen: tp.nameLen, bStart: nm.nameStart, bLen: nm.nameLen) {
                site = 0U64
                paramId = tp.paramId
            }
            tpi += 1
        }
        val ref: U64 = self.pushType(t: <TypeRef nameStart=nm.nameStart nameLen=nm.nameLen paramId=paramId args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] viewExtId=viewExtId viewIds=viewIds viewSources=viewSources isAny=t.isAny argLabels=argLabels assocTraitStart=assocTraitStart assocTraitLen=assocTraitLen assocTraitId=assocTraitId assocTraitArgs=assocTraitArgs assocTraitArgLabels=assocTraitArgLabels assocNameStart=assocNameStart assocNameLen=assocNameLen assocNameId=assocNameId isSendable=t.isSendable siteOffset=site />)
        mut val result: PType = <PType start=nm.nameStart len=nm.nameLen isArray=false ref=ref />
        if t.args.count() > 0 {
            if rangeEquals(bytes: self.arena.bytes, start: nm.nameStart, len: nm.nameLen, kw: "Array") {
                if self.isCompoundType(ref: args[0]) {
                    val mn: Bind = self.appendMangleSpan(ref: args[0])
                    result = <PType start=mn.nameStart len=mn.nameLen isArray=true ref=ref />
                } else {
                    result = <PType start=argPtys[0].start len=argPtys[0].len isArray=true ref=ref />
                }
                self.recordArrayElem(ty: result)
            }
        }
        return result
    }

    // SyntaxFile path for type lowering. It has the same semantic output as
    // lowerType(TypeAst), but takes an immutable node ID and reads source
    // spellings directly from the compiler source arena. In particular, short
    // associated projections resolve to a local trait span rather than cloning
    // a normalized TypeAst.
    inout fn lowerSyntaxType(id: TypeId) -> PType {
        val t: SyntaxType = syntaxType(file: self.syntax, id: id)
        if t.isRecord {
            mut val fieldNames: Array[Span] = []
            mut val fieldTys: Array[PType] = []
            mut val fi: U64 = 0U64
            while fi < syntaxTypeArgCount(file: self.syntax, ty: t) {
                fieldNames.append(syntaxTypeArgLabel(file: self.syntax, ty: t, index: fi))
                fieldTys.append(self.lowerSyntaxType(id: syntaxTypeArg(file: self.syntax, ty: t, index: fi)))
                fi += 1U64
            }
            val recordName: Bind = self.ensureRecordStructSpans(fieldNames: fieldNames, fieldTys: fieldTys)
            mut val fieldTerms: Array[U64] = []
            mut val ti: U64 = 0U64
            while ti < fieldTys.count() {
                fieldTerms.append(fieldTys[ti].ref)
                ti += 1U64
            }
            val recordRef: U64 = self.recordTypeTermSpans(name: recordName, fieldNames: fieldNames, fieldTerms: fieldTerms)
            return <PType start=recordName.nameStart len=recordName.nameLen isArray=false ref=recordRef />
        }

        val nameLen: U64 = t.name.end - t.name.start
        val name: Bind = <Bind nameStart=t.name.start nameLen=nameLen fieldStart=t.name.start fieldLen=nameLen />
        mut val args: Array[U64] = []
        mut val argPtys: Array[PType] = []
        mut val i: U64 = 0U64
        while i < syntaxTypeArgCount(file: self.syntax, ty: t) {
            val arg: PType = self.lowerSyntaxType(id: syntaxTypeArg(file: self.syntax, ty: t, index: i))
            argPtys.append(arg)
            args.append(arg.ref)
            i += 1U64
        }

        mut val viewSources: Array[ResolvedViewSource] = []
        mut val vi: U64 = 0U64
        while vi < syntaxTypeViewNameCount(file: self.syntax, ty: t) {
            val viewSpan: Span = syntaxTypeViewName(file: self.syntax, ty: t, index: vi)
            val source: ResolvedViewSource = self.lowerViewSourceSpan(siteOffset: t.span.start, start: viewSpan.start, len: viewSpan.end - viewSpan.start)
            mut val present: Bool = false
            mut val si: U64 = 0U64
            while si < viewSources.count() {
                if self.semanticViewSourceEq(a: viewSources[si], b: source) { present = true }
                si += 1U64
            }
            if !present { viewSources.append(source) }
            vi += 1U64
        }
        if t.extView.end > t.extView.start {
            val source: ResolvedViewSource = self.lowerViewSourceSpan(siteOffset: t.span.start, start: t.extView.start, len: t.extView.end - t.extView.start)
            mut val present: Bool = false
            mut val si: U64 = 0U64
            while si < viewSources.count() {
                if self.semanticViewSourceEq(a: viewSources[si], b: source) { present = true }
                si += 1U64
            }
            if !present { viewSources.append(source) }
        }
        val viewIds: Array[U64] = self.viewSourceIds(sources: viewSources)
        mut val viewExtId: U64 = 0U64
        if viewIds.count() == 1U64 { viewExtId = viewIds[0U64] }

        mut val projectionTrait: Span = t.projectionTrait
        if t.projectionAssoc.end > t.projectionAssoc.start {
            if projectionTrait.end == projectionTrait.start {
                projectionTrait = self.uniqueSyntaxProjectionTrait(t: t)
            } else {
                val owner: U64 = self.traitOwnerAtUse(start: projectionTrait.start, len: projectionTrait.end - projectionTrait.start, arity: syntaxTypeProjectionTraitArgCount(file: self.syntax, ty: t))
                if owner == 0U64 {
                    self.errorAt(offset: t.span.start, msg: "associated-type projection must specify the trait's positional type arguments")
                }
                mut val pi: U64 = 0U64
                while pi < syntaxTypeProjectionTraitArgCount(file: self.syntax, ty: t) {
                    val label: Span = syntaxTypeProjectionTraitArgLabel(file: self.syntax, ty: t, index: pi)
                    if label.end > label.start {
                        self.errorAt(offset: t.span.start, msg: "associated-type projection source accepts positional trait type arguments only")
                    }
                    pi += 1U64
                }
            }
        }

        mut val assocTraitStart: U64 = 0U64
        mut val assocTraitLen: U64 = 0U64
        mut val assocTraitId: U64 = 0U64
        if projectionTrait.end > projectionTrait.start {
            val owner: U64 = self.traitOwnerAtUse(start: projectionTrait.start, len: projectionTrait.end - projectionTrait.start, arity: syntaxTypeProjectionTraitArgCount(file: self.syntax, ty: t))
            if owner != 0U64 {
                assocTraitStart = owner
                assocTraitLen = self.traitNameLenByOwner(owner: owner)
            } else {
                assocTraitStart = projectionTrait.start
                assocTraitLen = projectionTrait.end - projectionTrait.start
            }
            assocTraitId = intern(c: inout self, start: assocTraitStart, len: assocTraitLen)
        }
        mut val assocTraitArgs: Array[U64] = []
        mut val assocTraitArgLabels: Array[U64] = []
        mut val ati: U64 = 0U64
        while ati < syntaxTypeProjectionTraitArgCount(file: self.syntax, ty: t) {
            assocTraitArgs.append(self.lowerSyntaxType(id: syntaxTypeProjectionTraitArg(file: self.syntax, ty: t, index: ati)).ref)
            val label: Span = syntaxTypeProjectionTraitArgLabel(file: self.syntax, ty: t, index: ati)
            if label.end > label.start {
                assocTraitArgLabels.append(intern(c: inout self, start: label.start, len: label.end - label.start))
            } else { assocTraitArgLabels.append(0U64) }
            ati += 1U64
        }
        mut val assocNameStart: U64 = 0U64
        mut val assocNameLen: U64 = 0U64
        mut val assocNameId: U64 = 0U64
        if t.projectionAssoc.end > t.projectionAssoc.start {
            assocNameStart = t.projectionAssoc.start
            assocNameLen = t.projectionAssoc.end - t.projectionAssoc.start
            assocNameId = intern(c: inout self, start: assocNameStart, len: assocNameLen)
        }
        mut val argLabels: Array[U64] = []
        mut val li: U64 = 0U64
        while li < syntaxTypeArgCount(file: self.syntax, ty: t) {
            val label: Span = syntaxTypeArgLabel(file: self.syntax, ty: t, index: li)
            if label.end > label.start { argLabels.append(intern(c: inout self, start: label.start, len: label.end - label.start)) }
            else { argLabels.append(0U64) }
            li += 1U64
        }
        mut val site: U64 = t.span.start
        mut val paramId: U64 = 0U64
        mut val tpi: U64 = 0U64
        while tpi < self.cur.typeParams.count() {
            val param: Bind = self.cur.typeParams[tpi]
            if spansEqual(c: inout self, aStart: param.nameStart, aLen: param.nameLen, bStart: name.nameStart, bLen: name.nameLen) {
                site = 0U64
                paramId = param.paramId
            }
            tpi += 1U64
        }
        val ref: U64 = self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen paramId=paramId args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] viewExtId=viewExtId viewIds=viewIds viewSources=viewSources isAny=t.isAny argLabels=argLabels assocTraitStart=assocTraitStart assocTraitLen=assocTraitLen assocTraitId=assocTraitId assocTraitArgs=assocTraitArgs assocTraitArgLabels=assocTraitArgLabels assocNameStart=assocNameStart assocNameLen=assocNameLen assocNameId=assocNameId isSendable=t.isSendable siteOffset=site />)
        mut val result: PType = <PType start=name.nameStart len=name.nameLen isArray=false ref=ref />
        if syntaxTypeArgCount(file: self.syntax, ty: t) > 0U64 {
            if rangeEquals(bytes: self.arena.bytes, start: name.nameStart, len: name.nameLen, kw: "Array") {
                if self.isCompoundType(ref: args[0U64]) {
                    val mangled: Bind = self.appendMangleSpan(ref: args[0U64])
                    result = <PType start=mangled.nameStart len=mangled.nameLen isArray=true ref=ref />
                } else {
                    result = <PType start=argPtys[0U64].start len=argPtys[0U64].len isArray=true ref=ref />
                }
                self.recordArrayElem(ty: result)
            }
        }
        return result
    }

    // Lower a call/construction argument list.
    // The declared TypeRef of the parameter labelled `argLabel` of the free function
    // `fnName`, or 0 when it can't be resolved unambiguously (no such function, an
    // overloaded / generic / method candidate, or no matching label). The callee is
    // declared before any body that calls it (source order), so its param types are
    // registered TypeRefs here. Used to give a call-argument literal its context type.
    inout fn callArgType(fnName: String, argLabel: String) -> U64 {
        if fnName.bytes().count() == 0U64 {
            return 0U64
        }
        if argLabel.bytes().count() == 0U64 {
            return 0U64
        }
        val fnB: Bind = self.internBytes(s: fnName)
        val fnId: U64 = intern(c: inout self, start: fnB.nameStart, len: fnB.nameLen)
        val lb: Bind = self.internBytes(s: argLabel)
        val lid: U64 = intern(c: inout self, start: lb.nameStart, len: lb.nameLen)
        return self.callArgTypeByNameIds(nameId: fnId, labelId: lid, hasReceiver: false)
    }

    // SyntaxFile owns source spelling spans already.  Do not recreate Strings
    // merely to perform the same declaration-identity lookup.
    inout fn callArgTypeSpans(fnName: Span, argLabel: Span) -> U64 {
        if fnName.end <= fnName.start || argLabel.end <= argLabel.start {
            return 0U64
        }
        return self.callArgTypeByNameIds(nameId: intern(c: inout self, start: fnName.start, len: fnName.end - fnName.start), labelId: intern(c: inout self, start: argLabel.start, len: argLabel.end - argLabel.start), hasReceiver: false)
    }

    // The sole lookup rule for the conservative lowering-time argument context.
    // A free function and a method differ only in the receiver bit; ambiguous or
    // generic candidates intentionally produce no context rather than guessing.
    inout fn callArgTypeByNameIds(nameId: U64, labelId: U64, hasReceiver: Bool) -> U64 {
        mut val matchCount: U64 = 0
        mut val resultTy: U64 = 0
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            if self.arena.funcs[fi].nameId == nameId {
                if self.arena.funcs[fi].hasRecv == hasReceiver {
                    if self.arena.funcs[fi].typeParams.count() == 0U64 {
                        matchCount += 1
                        mut val pi: U64 = 0
                        while pi < self.arena.funcs[fi].params.count() {
                            val param: Param = self.funcParamAt(params: self.arena.funcs[fi].params, index: pi)
                            if intern(c: inout self, start: param.nameStart, len: param.nameLen) == labelId {
                                resultTy = param.ty
                            }
                            pi += 1
                        }
                    }
                }
            }
            fi += 1
        }
        if matchCount == 1U64 {
            return resultTy
        }
        return 0U64
    }

    // Like callArgType but for a METHOD call `recv.name(label: …)`: the receiver type is
    // not known at lowering, so resolve by method name + label across ALL methods. Only
    // when exactly one non-generic method is named `methodName` (so the label maps to a
    // single param type unambiguously) is the type adopted — otherwise 0 (context-free,
    // no guess). Gives a record/dict/`()` literal method-argument its context type.
    inout fn methodArgType(methodName: String, argLabel: String) -> U64 {
        if methodName.bytes().count() == 0U64 {
            return 0U64
        }
        if argLabel.bytes().count() == 0U64 {
            return 0U64
        }
        val mnB: Bind = self.internBytes(s: methodName)
        val mnId: U64 = intern(c: inout self, start: mnB.nameStart, len: mnB.nameLen)
        val lb: Bind = self.internBytes(s: argLabel)
        val lid: U64 = intern(c: inout self, start: lb.nameStart, len: lb.nameLen)
        return self.callArgTypeByNameIds(nameId: mnId, labelId: lid, hasReceiver: true)
    }

    inout fn methodArgTypeSpans(methodName: Span, argLabel: Span) -> U64 {
        if methodName.end <= methodName.start || argLabel.end <= argLabel.start {
            return 0U64
        }
        return self.callArgTypeByNameIds(nameId: intern(c: inout self, start: methodName.start, len: methodName.end - methodName.start), labelId: intern(c: inout self, start: argLabel.start, len: argLabel.end - argLabel.start), hasReceiver: true)
    }

    inout fn lowerArgs(args: Array[ArgAst], fnName: String) -> Array[Arg] {
        mut val out: Array[Arg] = []
        mut val i: U64 = 0
        while i < args.count() {
            val a: ArgAst = args[i]
            // flow the resolved parameter's type to a context-typed argument literal (a dict
            // / record / `()` whose type is only known from the parameter). Defensive: 0
            // falls back to context-free lowering (overloaded / generic / method calls).
            val actx: U64 = self.callArgType(fnName: fnName, argLabel: a.label)
            mut val e: U64 = 0
            if actx != 0U64 {
                e = self.lowerExprWithCtx(e: a.value, ctxRef: actx)
            } else {
                e = self.lowerExpr(e: a.value)
            }
            mut val label: Span = <Span start=0U64 end=0U64 />
            if a.hasLabel {
                val lb: Bind = self.internBytes(s: a.label)
                label = <Span start=lb.nameStart end=lb.nameStart + lb.nameLen />
            }
            out.append(self.appendLoweredArg(value: e, isInout: a.isInout, label: label, hasLabel: a.hasLabel))
            i += 1
        }
        return out
    }

    // Lower a method call's arguments, flowing each resolved parameter type (via
    // methodArgType) to a context-typed argument literal. Mirrors lowerArgs but resolves
    // by method name instead of free-fn name.
    inout fn lowerMethodArgs(args: Array[ArgAst], methodName: String) -> Array[Arg] {
        mut val out: Array[Arg] = []
        mut val i: U64 = 0
        while i < args.count() {
            val a: ArgAst = args[i]
            val actx: U64 = self.methodArgType(methodName: methodName, argLabel: a.label)
            mut val e: U64 = 0
            if actx != 0U64 {
                e = self.lowerExprWithCtx(e: a.value, ctxRef: actx)
            } else {
                e = self.lowerExpr(e: a.value)
            }
            mut val label: Span = <Span start=0U64 end=0U64 />
            if a.hasLabel {
                val lb: Bind = self.internBytes(s: a.label)
                label = <Span start=lb.nameStart end=lb.nameStart + lb.nameLen />
            }
            out.append(self.appendLoweredArg(value: e, isInout: a.isInout, label: label, hasLabel: a.hasLabel))
            i += 1
        }
        return out
    }

    // SyntaxFile counterpart of lowerArgs.  The source name remains a span so
    // contextual literal typing uses the same declaration lookup without
    // allocating a transient call-name String.
    inout fn lowerSyntaxArgs(expr: SyntaxExpr, fnName: Span) -> Array[Arg] {
        mut val out: Array[Arg] = []
        mut val i: U64 = 0U64
        while i < syntaxExprArgCount(file: self.syntax, expr: expr) {
            val a: SyntaxArg = syntaxArg(file: self.syntax, id: syntaxExprArg(file: self.syntax, expr: expr, index: i))
            val actx: U64 = self.callArgTypeSpans(fnName: fnName, argLabel: a.label)
            mut val value: U64 = 0U64
            if actx != 0U64 {
                value = self.lowerSyntaxExprWithCtx(id: a.value, ctxRef: actx)
            } else {
                value = self.lowerSyntaxExpr(id: a.value)
            }
            out.append(self.appendLoweredArg(value: value, isInout: a.isInout, label: a.label, hasLabel: a.hasLabel))
            i += 1U64
        }
        return out
    }

    // SyntaxFile counterpart of lowerMethodArgs.  It is deliberately separate
    // from free-call context lookup: a receiver call must remain ambiguous
    // until method candidate selection, exactly as on the value-AST path.
    inout fn lowerSyntaxMethodArgs(expr: SyntaxExpr, methodName: Span) -> Array[Arg] {
        mut val out: Array[Arg] = []
        mut val i: U64 = 0U64
        while i < syntaxExprArgCount(file: self.syntax, expr: expr) {
            val a: SyntaxArg = syntaxArg(file: self.syntax, id: syntaxExprArg(file: self.syntax, expr: expr, index: i))
            val actx: U64 = self.methodArgTypeSpans(methodName: methodName, argLabel: a.label)
            mut val value: U64 = 0U64
            if actx != 0U64 {
                value = self.lowerSyntaxExprWithCtx(id: a.value, ctxRef: actx)
            } else {
                value = self.lowerSyntaxExpr(id: a.value)
            }
            out.append(self.appendLoweredArg(value: value, isInout: a.isInout, label: a.label, hasLabel: a.hasLabel))
            i += 1U64
        }
        return out
    }

    inout fn appendLoweredArg(value: U64, isInout: Bool, label: Span, hasLabel: Bool) -> Arg {
        return <Arg expr=value isInout=isInout labelStart=label.start labelLen=label.end - label.start hasLabel=hasLabel />
    }
}

// The declared TypeRef of field `fieldName` on the type being constructed (a struct,
// or an enum variant's payload), or 0 when the owner / field can't be resolved. The
// owner type's declaration is lowered before any body that constructs it (source
// order), so its field types are registered TypeRefs here. Used to give a
// construction-field literal (`<Box m=[:] />`, `<Shape.Point at=(x:1,y:2) />`) its
// context type so an otherwise un-inferable dict / record / unit literal resolves.
pub impl Comp {
    inout fn makeFieldType(typeName: String, variant: String, isEnum: Bool, fieldName: String) -> U64 {
        val tn: Bind = self.internBytes(s: typeName)
        val tid: U64 = intern(c: inout self, start: tn.nameStart, len: tn.nameLen)
        val fn2: Bind = self.internBytes(s: fieldName)
        val fid: U64 = intern(c: inout self, start: fn2.nameStart, len: fn2.nameLen)
        mut val vid: U64 = 0U64
        if isEnum {
            val vn: Bind = self.internBytes(s: variant)
            vid = intern(c: inout self, start: vn.nameStart, len: vn.nameLen)
        }
        return self.makeFieldTypeByNameIds(typeId: tid, variantId: vid, isEnum: isEnum, fieldId: fid)
    }

    inout fn makeFieldTypeSpans(typeName: Span, variant: Span, isEnum: Bool, fieldName: Span) -> U64 {
        if typeName.end <= typeName.start || fieldName.end <= fieldName.start { return 0U64 }
        mut val variantId: U64 = 0U64
        if isEnum {
            variantId = intern(c: inout self, start: variant.start, len: variant.end - variant.start)
        }
        return self.makeFieldTypeByNameIds(typeId: intern(c: inout self, start: typeName.start, len: typeName.end - typeName.start), variantId: variantId, isEnum: isEnum, fieldId: intern(c: inout self, start: fieldName.start, len: fieldName.end - fieldName.start))
    }

    // The sole declaration lookup for a construction field's context type.
    inout fn makeFieldTypeByNameIds(typeId: U64, variantId: U64, isEnum: Bool, fieldId: U64) -> U64 {
        mut val tid: U64 = typeId
        // a newtype inherits the underlying struct's factory/fields (spec/10): resolve the
        // construction type name to the underlying struct so `<Brand code=255 />` finds the
        // `code` field's type for the literal's context (Brand = Rgb).
        mut val ntI: U64 = 0
        while ntI < self.arena.newtypes.count() {
            if self.arena.newtypes[ntI].nameId == tid {
                tid = intern(c: inout self, start: self.arena.newtypes[ntI].underStart, len: self.arena.newtypes[ntI].underLen)
                ntI = self.arena.newtypes.count()
            } else {
                ntI += 1
            }
        }
        if isEnum {
            mut val ei: U64 = 0
            while ei < self.arena.enums.count() {
                if self.arena.enums[ei].nameId == tid {
                    mut val vi: U64 = 0
                    while vi < self.arena.enums[ei].variants.count() {
                        if intern(c: inout self, start: self.arena.enums[ei].variants[vi].nameStart, len: self.arena.enums[ei].variants[vi].nameLen) == variantId {
                            mut val fj: U64 = 0
                            while fj < self.arena.enums[ei].variants[vi].fields.count() {
                                if intern(c: inout self, start: self.arena.enums[ei].variants[vi].fields[fj].nameStart, len: self.arena.enums[ei].variants[vi].fields[fj].nameLen) == fieldId {
                                    return self.arena.enums[ei].variants[vi].fields[fj].ty
                                }
                                fj += 1
                            }
                        }
                        vi += 1
                    }
                }
                ei += 1
            }
            return 0U64
        }
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            if self.arena.structs[si].nameId == tid {
                mut val fk: U64 = 0
                while fk < self.arena.structs[si].fields.count() {
                    if intern(c: inout self, start: self.arena.structs[si].fields[fk].nameStart, len: self.arena.structs[si].fields[fk].nameLen) == fieldId {
                        return self.arena.structs[si].fields[fk].ty
                    }
                    fk += 1
                }
            }
            si += 1
        }
        return 0U64
    }
}

pub impl Comp {

    // Materialize memberwise-factory defaults as ordinary Make fields.  A field
    // default is evaluated at this construction site, not in a backend-only
    // implicit path.  Keeping it in the Make expression means Verify, Mono's
    // final-callee walk, and LLVM all consume one identical expression tree.
    inout fn appendOmittedMakeDefaults(out: inout Array[MakeField], typeName: String, isEnum: Bool) {
        if isEnum || typeName.bytes().count() == 0U64 { return }
        val tn: Bind = self.internBytes(s: typeName)
        val real: Bind = self.aliasReal(start: tn.nameStart, len: tn.nameLen)
        self.appendOmittedMakeDefaultsByTypeId(out: inout out, typeId: intern(c: inout self, start: real.nameStart, len: real.nameLen), isEnum: isEnum)
    }

    inout fn appendOmittedMakeDefaultsSpans(out: inout Array[MakeField], typeName: Span, isEnum: Bool) {
        if typeName.end <= typeName.start { return }
        val real: Bind = self.aliasReal(start: typeName.start, len: typeName.end - typeName.start)
        self.appendOmittedMakeDefaultsByTypeId(out: inout out, typeId: intern(c: inout self, start: real.nameStart, len: real.nameLen), isEnum: isEnum)
    }

    inout fn appendOmittedMakeDefaultsByTypeId(out: inout Array[MakeField], typeId: U64, isEnum: Bool) {
        if isEnum { return }
        mut val si: U64 = 0U64
        while si < self.arena.structs.count() {
            if self.arena.structs[si].nameId == typeId { break }
            si += 1U64
        }
        if si >= self.arena.structs.count() { return }
        val declared: Array[FieldDef] = self.arena.structs[si].fields
        mut val fi: U64 = 0U64
        while fi < declared.count() {
            val fld: FieldDef = declared[fi]
            if fld.hasDefault {
                mut val supplied: Bool = false
                mut val mi: U64 = 0U64
                while mi < out.count() {
                    if spansEqual(c: inout self, aStart: out[mi].nameStart, aLen: out[mi].nameLen, bStart: fld.nameStart, bLen: fld.nameLen) {
                        supplied = true
                        mi = out.count()
                    } else {
                        mi += 1U64
                    }
                }
                if !supplied {
                    out.append(<MakeField nameStart=fld.nameStart nameLen=fld.nameLen value=fld.defaultVal offset=fld.nameStart />)
                }
            }
            fi += 1U64
        }
    }

    inout fn lowerMakeFields(fields: Array[MakeFieldAst], typeName: String, variant: String, isEnum: Bool) -> Array[MakeField] {
        mut val out: Array[MakeField] = []
        mut val i: U64 = 0
        while i < fields.count() {
            val f: MakeFieldAst = fields[i]
            // flow the field's declared type to its value so a context-typed literal in a
            // construction field infers (a dict / record / `()` whose type is only known
            // from the field). Defensive: 0 falls back to context-free lowering.
            val fctx: U64 = self.makeFieldType(typeName: typeName, variant: variant, isEnum: isEnum, fieldName: f.name)
            mut val v: U64 = 0
            if fctx != 0U64 {
                v = self.lowerExprWithCtx(e: f.value, ctxRef: fctx)
            } else {
                v = self.lowerExpr(e: f.value)
            }
            val nm: Bind = self.internBytes(s: f.name)
            out.append(<MakeField nameStart=nm.nameStart nameLen=nm.nameLen value=v offset=f.span.start />)
            i += 1
        }
        self.appendOmittedMakeDefaults(out: inout out, typeName: typeName, isEnum: isEnum)
        return out
    }

    // SyntaxFile counterpart of lowerMakeFields. The declaration lookup is by
    // canonical name IDs so this also serves anonymous-record contexts, whose
    // synthesized record name has no source spelling to reconstruct.
    inout fn lowerSyntaxMakeFields(expr: SyntaxExpr, typeId: U64, variantId: U64, isEnum: Bool) -> Array[MakeField] {
        mut val out: Array[MakeField] = []
        mut val i: U64 = 0U64
        while i < syntaxExprMakeFieldCount(file: self.syntax, expr: expr) {
            val f: SyntaxMakeField = syntaxMakeField(file: self.syntax, id: syntaxExprMakeField(file: self.syntax, expr: expr, index: i))
            val fctx: U64 = self.makeFieldTypeByNameIds(typeId: typeId, variantId: variantId, isEnum: isEnum, fieldId: intern(c: inout self, start: f.name.start, len: f.name.end - f.name.start))
            mut val value: U64 = 0U64
            if fctx != 0U64 {
                value = self.lowerSyntaxExprWithCtx(id: f.value, ctxRef: fctx)
            } else {
                value = self.lowerSyntaxExpr(id: f.value)
            }
            out.append(<MakeField nameStart=f.name.start nameLen=f.name.end - f.name.start value=value offset=f.span.start />)
            i += 1U64
        }
        self.appendOmittedMakeDefaultsByTypeId(out: inout out, typeId: typeId, isEnum: isEnum)
        return out
    }

    // A fresh `Buffer.new()` call for one statically selected parametric
    // receiver. The generated spelling has no source type arguments, so the
    // receiver belongs in SyntheticCallSite provenance rather than in the AST
    // node or a later backend recovery.
    inout fn synthBufferNew(elemRef: U64) -> U64 {
        val bufN: Bind = self.internBytes(s: "Buffer")
        val newN: Bind = self.internBytes(s: "new")
        val typeArgs: Array[U64] = [elemRef]
        val receiverTerm: U64 = self.pushType(t: <TypeRef nameStart=bufN.nameStart nameLen=bufN.nameLen args=typeArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        val recv: U64 = self.pushExpr(e: <Expr.Ident start=bufN.nameStart len=bufN.nameLen />)
        val noArgs: Array[Arg] = []
        val call: U64 = self.pushExpr(e: <Expr.Method recv=recv nameStart=newN.nameStart nameLen=newN.nameLen args=self.pushArgs(args: noArgs) />)
        val originSerial: U64 = self.nextExprOriginSerial
        self.nextExprOriginSerial += 1U64
        self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=call originSerial=originSerial receiverTerm=receiverTerm />)
        return call
    }

    // Build a fresh empty
    // `<Dictionary keys=Buffer.new() vals=Buffer.new() hashes=Buffer.new() buckets=Buffer.new() entryCount=0U64 />`
    // Make node typed as `ctxRef` (a `Dictionary[K, V]` TypeRef). The dict's columns are
    // `Buffer[K]`/`Buffer[V]`/`Buffer[U64]` (the storage floor) — built via `Buffer.new()`,
    // whose element type is inferred from the field type at codegen.
    inout fn synthEmptyDict(ctxRef: U64) -> U64 {
        val ct: TypeRef = self.arena.types[ctxRef]
        val kN: Bind = self.internBytes(s: "keys")
        val vN: Bind = self.internBytes(s: "vals")
        val hN: Bind = self.internBytes(s: "hashes")
        val bN: Bind = self.internBytes(s: "buckets")
        val cN: Bind = self.internBytes(s: "entryCount")
        val emptyKeys: U64 = self.synthBufferNew(elemRef: ct.args[0])
        val emptyVals: U64 = self.synthBufferNew(elemRef: ct.args[1])
        val u64N: Bind = self.internBytes(s: "U64")
        val u64Ref: U64 = self.simpleTypeRef(nameStart: u64N.nameStart, nameLen: u64N.nameLen)
        val emptyHashes: U64 = self.synthBufferNew(elemRef: u64Ref)
        val emptyBuckets: U64 = self.synthBufferNew(elemRef: u64Ref)
        val zero: U64 = self.pushExpr(e: <Expr.Int value=0 offset=0 isBool=false tyStart=u64N.nameStart tyLen=u64N.nameLen isNeg=false />)
        mut val fields: Array[MakeField] = []
        // offset = the interned (unloaded) name span: marks these as synthesized so the
        // construction-visibility gate skips them (a dict's fields are module-private).
        fields.append(<MakeField nameStart=kN.nameStart nameLen=kN.nameLen value=emptyKeys offset=kN.nameStart />)
        fields.append(<MakeField nameStart=vN.nameStart nameLen=vN.nameLen value=emptyVals offset=vN.nameStart />)
        fields.append(<MakeField nameStart=hN.nameStart nameLen=hN.nameLen value=emptyHashes offset=hN.nameStart />)
        fields.append(<MakeField nameStart=bN.nameStart nameLen=bN.nameLen value=emptyBuckets offset=bN.nameStart />)
        fields.append(<MakeField nameStart=cN.nameStart nameLen=cN.nameLen value=zero offset=cN.nameStart />)
        return self.pushExpr(e: <Expr.Make typeStart=ct.nameStart typeLen=ct.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=self.pushMakeFields(fields: fields) />)
    }

    // Lower a dictionary literal `[k0: v0, ...]` / `[:]` (spec/02). The K/V types come
    // from the binding/return context (`ctxRef` must be a `Dictionary[K, V]` TypeRef):
    // there is no element-based inference, so the literal needs a context type (an
    // annotated `let`/`return`), just like an empty array does. Lowers to a
    // value-position block:
    //   if (1) { mut val __dl: Dictionary[K,V] = <empty>; __dl.insert(k, v); ...;
    //            give move __dl } else { give <empty> }
    // `give move __dl` transfers the freshly-built dictionary out with no deep copy —
    // the temp is marked moved so the scope exit does not release it (the caller's
    // binding owns it). The else branch is dead (the cond is the constant `1`) but must
    // still yield a `Dictionary[K,V]` so the value-position block type-checks.
    inout fn lowerDictLit(keys: Array[ExprAst], vals: Array[ExprAst], ctxRef: U64, span: Span) -> U64 {
        if !(self.hasDictionaryLiteralContext(ctxRef: ctxRef)) {
            self.errorAt(offset: span.start, msg: "cannot infer the type of a dictionary literal; annotate the binding (`: Dictionary[K, V]`)")
            return self.pushExpr(e: <Expr.Int value=0 offset=span.start isBool=false tyStart=0 tyLen=0 isNeg=false />)
        }
        mut val loweredKeys: Array[U64] = []
        mut val loweredVals: Array[U64] = []
        mut val i: U64 = 0U64
        while i < keys.count() {
            loweredKeys.append(self.lowerExpr(e: keys[i]))
            loweredVals.append(self.lowerExpr(e: vals[i]))
            i += 1U64
        }
        return self.lowerDictLitValues(keys: loweredKeys, vals: loweredVals, ctxRef: ctxRef, span: span)
    }

    // SyntaxFile decoder for a dictionary literal. Validate the contextual type
    // before reading entries, exactly like the value-AST route: an invalid
    // container must not cause unrelated child diagnostics first.
    inout fn lowerSyntaxDictLit(expr: SyntaxExpr, ctxRef: U64) -> U64 {
        if !(self.hasDictionaryLiteralContext(ctxRef: ctxRef)) {
            self.errorAt(offset: expr.span.start, msg: "cannot infer the type of a dictionary literal; annotate the binding (`: Dictionary[K, V]`)")
            return self.pushExpr(e: <Expr.Int value=0 offset=expr.span.start isBool=false tyStart=0 tyLen=0 isNeg=false />)
        }
        mut val keys: Array[U64] = []
        mut val vals: Array[U64] = []
        mut val i: U64 = 0U64
        while i < syntaxExprDictEntryCount(file: self.syntax, expr: expr) {
            keys.append(self.lowerSyntaxExpr(id: syntaxExprDictKey(file: self.syntax, expr: expr, index: i)))
            vals.append(self.lowerSyntaxExpr(id: syntaxExprDictValue(file: self.syntax, expr: expr, index: i)))
            i += 1U64
        }
        return self.lowerDictLitValues(keys: keys, vals: vals, ctxRef: ctxRef, span: expr.span)
    }

    inout fn hasDictionaryLiteralContext(ctxRef: U64) -> Bool {
        if ctxRef != 0U64 {
            if ctxRef < self.arena.types.count() {
                val ct: TypeRef = self.arena.types[ctxRef]
                if rangeEquals(bytes: self.arena.bytes, start: ct.nameStart, len: ct.nameLen, kw: "Dictionary") {
                    if ct.args.count() >= 2U64 {
                        return true
                    }
                }
            }
        }
        return false
    }

    // The shared semantic construction for an already-lowered dictionary entry
    // sequence.  Value-AST and SyntaxFile decoders differ only in how they
    // produce these expression IDs; the dictionary desugar itself is singular.
    inout fn lowerDictLitValues(keys: Array[U64], vals: Array[U64], ctxRef: U64, span: Span) -> U64 {
        val ct: TypeRef = self.arena.types[ctxRef]
        val dlN: Bind = self.internBytes(s: "__dl")
        mut val stmts: Array[U64] = []
        val initMake: U64 = self.synthEmptyDict(ctxRef: ctxRef)
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=true nameStart=dlN.nameStart nameLen=dlN.nameLen tyStart=ct.nameStart tyLen=ct.nameLen tyIsArray=false ty=ctxRef init=initMake />))
        val insN: Bind = self.internBytes(s: "insert")
        val keyL: Bind = self.internBytes(s: "key")
        val valL: Bind = self.internBytes(s: "value")
        mut val i: U64 = 0
        while i < keys.count() {
            val recv: U64 = self.pushExpr(e: <Expr.Ident start=dlN.nameStart len=dlN.nameLen />)
            mut val args: Array[Arg] = []
            args.append(<Arg expr=keys[i] isInout=false labelStart=keyL.nameStart labelLen=keyL.nameLen hasLabel=true />)
            args.append(<Arg expr=vals[i] isInout=false labelStart=valL.nameStart labelLen=valL.nameLen hasLabel=true />)
            val m: U64 = self.pushExpr(e: <Expr.Method recv=recv nameStart=insN.nameStart nameLen=insN.nameLen args=self.pushArgs(args: args) />)
            stmts.append(self.pushStmt(s: <Stmt.ExprStmt expr=m />))
            i += 1
        }
        val giveRecv: U64 = self.pushExpr(e: <Expr.Ident start=dlN.nameStart len=dlN.nameLen />)
        val mv: U64 = self.pushExpr(e: <Expr.Move operand=giveRecv isBorrow=false />)
        stmts.append(self.pushStmt(s: <Stmt.Give value=mv />))
        val thenBlk: U64 = self.pushBlock(stmts: stmts)
        mut val elseStmts: Array[U64] = []
        val elseDict: U64 = self.synthEmptyDict(ctxRef: ctxRef)
        elseStmts.append(self.pushStmt(s: <Stmt.Give value=elseDict />))
        val elseBlk: U64 = self.pushBlock(stmts: elseStmts)
        val cond: U64 = self.pushExpr(e: <Expr.Int value=1 offset=span.start isBool=true tyStart=0 tyLen=0 isNeg=false />)
        val rid: U64 = self.pushExpr(e: <Expr.IfExpr cond=cond thenBlk=thenBlk elseBlk=elseBlk />)
        self.arena.exprSpanStart[rid] = span.start
        return rid
    }
}
