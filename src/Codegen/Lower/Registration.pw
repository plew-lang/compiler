// Declaration-candidate registration (root: Lower.pw).
//
// `Decls.callables` is the single candidate surface consumed by registration and
// resolution. Function bodies/signatures remain in `arena.funcs`; every source
// declaration enters the surface through registerDeclaredFunc.

pub impl Comp {
    inout fn funcDeclModule(f: Func) -> U64 {
        if self.offsetIsLoaded(offset: f.defOffset) {
            return self.moduleOf(offset: f.defOffset)
        }
        return self.moduleOf(offset: f.nameStart)
    }

    // Namespace and receiver-head filtering only.  This deliberately does NOT
    // compare complete receiver patterns: `Box[T]` and `Box[I64]` have a common
    // invocation, even though they are not alpha-equal declarations.  The shared
    // callable-form overlap check below owns that semantic question.
    inout fn sameFuncCandidateBucket(a: Func, b: Func) -> Bool {
        if a.hasRecv != b.hasRecv { return false }
        if a.isAssoc != b.isAssoc { return false }
        if a.hasRecv || a.isAssoc {
            if a.recvId != b.recvId { return false }
        }
        return a.extId == b.extId
    }

    inout fn sameFuncSelector(a: Func, b: Func) -> Bool {
        if a.nameId != b.nameId || a.params.count() != b.params.count() { return false }
        mut val i: U64 = 0
        while i < a.params.count() {
            if a.params[i].noLabel != b.params[i].noLabel { return false }
            if !(a.params[i].noLabel) && a.params[i].nameId != b.params[i].nameId { return false }
            i += 1U64
        }
        return true
    }

    inout fn binderIndex(params: Array[Bind], nameId: U64) -> U64 {
        mut val i: U64 = 0
        while i < params.count() {
            if params[i].nameId == nameId { return i }
            i += 1U64
        }
        return params.count()
    }

    // Semantic binder identity is lexical ParamId. NameId remains only the
    // legacy fallback for synthetic/old terms that have no ParamId yet.
    inout fn binderIdentity(b: Bind) -> U64 {
        if b.paramId != 0U64 { return b.paramId }
        return b.nameId
    }

    inout fn binderIndexIdentity(params: Array[Bind], identity: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < params.count() {
            if self.binderIdentity(b: params[i]) == identity { return i }
            i += 1U64
        }
        return params.count()
    }

    // View source order is presentation only.  Compare the selector names as a
    // duplicate-free set here; later verification classifies them as extensions
    // plus the single permitted trait selector.
    inout fn sameViewIdSet(a: Array[U64], b: Array[U64]) -> Bool {
        mut val ai: U64 = 0U64
        while ai < a.count() {
            mut val seenA: Bool = false
            mut val ap: U64 = 0U64
            while ap < ai {
                if a[ap] == a[ai] { seenA = true }
                ap += 1U64
            }
            if !(seenA) {
                mut val found: Bool = false
                mut val bi: U64 = 0U64
                while bi < b.count() {
                    if b[bi] == a[ai] { found = true }
                    bi += 1U64
                }
                if !(found) { return false }
            }
            ai += 1U64
        }
        mut val bi: U64 = 0U64
        while bi < b.count() {
            mut val found: Bool = false
            mut val aj: U64 = 0U64
            while aj < a.count() {
                if a[aj] == b[bi] { found = true }
                aj += 1U64
            }
            if !(found) { return false }
            bi += 1U64
        }
        return true
    }

    // Structural equality modulo the two declaration binder lists. This is the
    // declaration-key equality, not call-site type compatibility.
    inout fn typeRefsAlphaEq(a: U64, b: U64, aParams: Array[Bind], bParams: Array[Bind]) -> Bool {
        if a == 0U64 || b == 0U64 { return a == b }
        if a >= self.arena.types.count() || b >= self.arena.types.count() { return false }
        val ta: TypeRef = self.arena.types[a]
        val tb: TypeRef = self.arena.types[b]
        val ai: U64 = self.binderIndex(params: aParams, nameId: ta.nameId)
        val bi: U64 = self.binderIndex(params: bParams, nameId: tb.nameId)
        if ai < aParams.count() || bi < bParams.count() {
            return ai == bi && ai < aParams.count() && bi < bParams.count()
        }
        // Registration runs before the visibility pass annotates every
        // TypeRef with a declaration owner.  Compare owner identity whenever
        // both terms already carry it; later semantic consumers require it.
        if ta.nameId != tb.nameId || (ta.hasDecl && tb.hasDecl && ta.declOffset != tb.declOffset) || ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable { return false }
        if ta.assocTraitId != tb.assocTraitId || (ta.hasAssocTraitDecl && tb.hasAssocTraitDecl && ta.assocTraitDeclOffset != tb.assocTraitDeclOffset) || ta.assocNameId != tb.assocNameId { return false }
        if ta.args.count() != tb.args.count() { return false }
        mut val i: U64 = 0
        while i < ta.args.count() {
            if !(self.typeRefsAlphaEq(a: ta.args[i], b: tb.args[i], aParams: aParams, bParams: bParams)) { return false }
            i += 1U64
        }
        if ta.assocTraitArgs.count() != tb.assocTraitArgs.count() { return false }
        i = 0U64
        while i < ta.assocTraitArgs.count() {
            mut val al: U64 = 0U64
            mut val bl: U64 = 0U64
            if i < ta.assocTraitArgLabels.count() { al = ta.assocTraitArgLabels[i] }
            if i < tb.assocTraitArgLabels.count() { bl = tb.assocTraitArgLabels[i] }
            if al != bl || !(self.typeRefsAlphaEq(a: ta.assocTraitArgs[i], b: tb.assocTraitArgs[i], aParams: aParams, bParams: bParams)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn typeRefUsesBinders(ref: U64, params: Array[Bind]) -> Bool {
        if ref == 0U64 || ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[ref]
        if self.binderIndex(params: params, nameId: t.nameId) < params.count() { return true }
        mut val i: U64 = 0
        while i < t.args.count() {
            if self.typeRefUsesBinders(ref: t.args[i], params: params) { return true }
            i += 1U64
        }
        i = 0U64
        while i < t.assocTraitArgs.count() {
            if self.typeRefUsesBinders(ref: t.assocTraitArgs[i], params: params) { return true }
            i += 1U64
        }
        return false
    }

    inout fn sameGenericShape(a: Func, b: Func) -> Bool {
        if a.typeParams.count() != b.typeParams.count() || a.params.count() != b.params.count() { return false }
        mut val i: U64 = 0
        while i < a.params.count() {
            if self.typeRefUsesBinders(ref: a.params[i].ty, params: a.typeParams) != self.typeRefUsesBinders(ref: b.params[i].ty, params: b.typeParams) { return false }
            i += 1U64
        }
        return true
    }

    inout fn unificationBindingIndex(binds: Array[UnifyBind], side: U64, binderId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].side == side && binds[i].nameId == binderId { return i }
            i += 1U64
        }
        return binds.count()
    }

    // `viewExtId` is only the one-selector compatibility mirror.  Every
    // registration rule must ask this shared question so `T#E#P` cannot be
    // mistaken for bare `T` merely because its normal-form source set lives
    // in `viewIds`.
    inout fn hasTopLevelView(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[ref]
        return t.viewExtId != 0U64 || t.viewIds.count() != 0U64
    }

    // A type parameter is a free unification variable only in its bare form;
    // `T#P` / projections retain their structural view/projection constraints.
    inout fn plainBinder(ref: U64, params: Array[Bind]) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return params.count() }
        val t: TypeRef = self.arena.types[ref]
        if self.hasTopLevelView(ref: ref) || t.assocTraitId != 0U64 || t.args.count() != 0U64 { return params.count() }
        if t.paramId != 0U64 {
            mut val i: U64 = 0U64
            while i < params.count() {
                if params[i].paramId == t.paramId { return i }
                i += 1U64
            }
            return params.count()
        }
        return self.binderIndex(params: params, nameId: t.nameId)
    }

    inout fn occursInPattern(side: U64, binderId: U64, ref: U64, refSide: U64, aParams: Array[Bind], bParams: Array[Bind], binds: Array[UnifyBind]) -> Bool {
        mut val params: Array[Bind] = aParams
        if refSide != 0U64 { params = bParams }
        val bi: U64 = self.plainBinder(ref: ref, params: params)
        if bi < params.count() {
            if refSide == side && self.binderIdentity(b: params[bi]) == binderId { return true }
            // Corresponding generic parameters in two same-shape overloads are
            // one logical variable for overlap purposes (T in each signature),
            // even though their source binders are distinct records.
            mut val targetParams: Array[Bind] = aParams
            if side != 0U64 { targetParams = bParams }
            val targetIdx: U64 = self.binderIndexIdentity(params: targetParams, identity: binderId)
            if refSide != side && targetIdx == bi { return true }
            val bound: U64 = self.unificationBindingIndex(binds: binds, side: refSide, binderId: self.binderIdentity(b: params[bi]))
            if bound < binds.count() {
                return self.occursInPattern(side: side, binderId: binderId, ref: binds[bound].ref, refSide: binds[bound].refSide, aParams: aParams, bParams: bParams, binds: binds)
            }
            return false
        }
        if ref == 0U64 || ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[ref]
        mut val i: U64 = 0U64
        while i < t.args.count() {
            if self.occursInPattern(side: side, binderId: binderId, ref: t.args[i], refSide: refSide, aParams: aParams, bParams: bParams, binds: binds) { return true }
            i += 1U64
        }
        i = 0U64
        while i < t.assocTraitArgs.count() {
            if self.occursInPattern(side: side, binderId: binderId, ref: t.assocTraitArgs[i], refSide: refSide, aParams: aParams, bParams: bParams, binds: binds) { return true }
            i += 1U64
        }
        return false
    }

    // `ignoreTopView` is used only for receiver dispatch. A view chooses the
    // callable source; it does not replace the receiver's base type pattern.
    // Nested views remain ordinary type identity and must still match exactly.
    inout fn unifyPatterns(a: U64, aSide: U64, b: U64, bSide: U64, aParams: Array[Bind], bParams: Array[Bind], binds: inout Array[UnifyBind], ignoreTopView: Bool = false) -> Bool {
        mut val aScope: Array[Bind] = aParams
        if aSide != 0U64 { aScope = bParams }
        mut val bScope: Array[Bind] = aParams
        if bSide != 0U64 { bScope = bParams }
        val av: U64 = self.plainBinder(ref: a, params: aScope)
        val bv: U64 = self.plainBinder(ref: b, params: bScope)
        if av < aScope.count() && bv < bScope.count() {
            return av == bv
        }
        if av < aScope.count() {
            val binderId: U64 = self.binderIdentity(b: aScope[av])
            val found: U64 = self.unificationBindingIndex(binds: binds, side: aSide, binderId: binderId)
            if found < binds.count() {
                return self.unifyPatterns(a: binds[found].ref, aSide: binds[found].refSide, b: b, bSide: bSide, aParams: aParams, bParams: bParams, binds: inout binds, ignoreTopView: ignoreTopView)
            }
            if self.occursInPattern(side: aSide, binderId: binderId, ref: b, refSide: bSide, aParams: aParams, bParams: bParams, binds: binds) { return false }
            binds.append(<UnifyBind side=aSide nameId=binderId ref=b refSide=bSide />)
            return true
        }
        if bv < bScope.count() {
            return self.unifyPatterns(a: b, aSide: bSide, b: a, bSide: aSide, aParams: aParams, bParams: bParams, binds: inout binds, ignoreTopView: ignoreTopView)
        }
        if a == 0U64 || b == 0U64 || a >= self.arena.types.count() || b >= self.arena.types.count() { return a == b }
        val ta: TypeRef = self.arena.types[a]
        val tb: TypeRef = self.arena.types[b]
        if ta.nameId != tb.nameId || (ta.hasDecl && tb.hasDecl && ta.declOffset != tb.declOffset) || (!ignoreTopView && (ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)))) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable || ta.assocTraitId != tb.assocTraitId || (ta.hasAssocTraitDecl && tb.hasAssocTraitDecl && ta.assocTraitDeclOffset != tb.assocTraitDeclOffset) || ta.assocNameId != tb.assocNameId || ta.args.count() != tb.args.count() || ta.assocTraitArgs.count() != tb.assocTraitArgs.count() { return false }
        mut val i: U64 = 0U64
        while i < ta.args.count() {
            if !(self.unifyPatterns(a: ta.args[i], aSide: aSide, b: tb.args[i], bSide: bSide, aParams: aParams, bParams: bParams, binds: inout binds)) { return false }
            i += 1U64
        }
        i = 0U64
        while i < ta.assocTraitArgs.count() {
            mut val al: U64 = 0U64
            mut val bl: U64 = 0U64
            if i < ta.assocTraitArgLabels.count() { al = ta.assocTraitArgLabels[i] }
            if i < tb.assocTraitArgLabels.count() { bl = tb.assocTraitArgLabels[i] }
            if al != bl || !(self.unifyPatterns(a: ta.assocTraitArgs[i], aSide: aSide, b: tb.assocTraitArgs[i], bSide: bSide, aParams: aParams, bParams: bParams, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn copyUnifyBinds(binds: Array[UnifyBind]) -> Array[UnifyBind] {
        mut val copied: Array[UnifyBind] = []
        mut val i: U64 = 0U64
        while i < binds.count() {
            copied.append(binds[i])
            i += 1U64
        }
        return copied
    }

    // One primitive for asking whether a concrete type belongs to a declared
    // conformance's subject surface.  Registration uses the same unifier
    // through `conformancePatternsMayOverlap`; lookup must not regress to a
    // head-name-only approximation.
    inout fn conformanceSubjectMatches(cf: Conform, typeRef: U64) -> Bool {
        if typeRef == 0U64 || cf.subjectTy == 0U64 { return true }
        mut val binds: Array[UnifyBind] = []
        return self.unifyPatterns(a: cf.subjectTy, aSide: 0U64, b: typeRef, bSide: 1U64, aParams: self.copyConformBinds(binds: cf.typeParams), bParams: [], binds: inout binds, ignoreTopView: true)
    }

    // The trait-argument part of a conformance key.  A trait subject such as
    // `P[String]` is a pattern over a concrete conformance's instance
    // arguments, not merely an arity marker.  Keep this as the one instance
    // matcher so closure propagation, bounds, and views cannot each regress
    // to a count-only comparison.
    inout fn traitInstanceArgsMatch(pattern: Array[U64], patternParams: Array[Bind], actual: Array[U64]) -> Bool {
        if pattern.count() != actual.count() { return false }
        mut val binds: Array[UnifyBind] = []
        mut val i: U64 = 0U64
        while i < pattern.count() {
            if !(self.unifyPatterns(a: pattern[i], aSide: 0U64, b: actual[i], bSide: 1U64, aParams: patternParams, bParams: [], binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    // Instance-side counterpart of the registration overlap predicate.  A
    // conformance is selected only when both its receiver pattern and its
    // trait arguments unify with the requested trait instance; comparing just
    // the trait spelling would conflate `Sub` and `Sub[I64]`.
    // The concrete-query form of a conformance key.  Keep this independent of
    // `Conform`: associated-type bindings carry the same key, and must select
    // a witness by precisely the same rule as ordinary conformance lookup.
    inout fn witnessBindIndex(binds: Array[WitnessBind], binder: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].binder == binder { return i }
            i += 1U64
        }
        return binds.count()
    }

    // Semantic witness lookup is lexical. Keep the positional helper above
    // only for old callers that still carry a declaration-order slot.
    inout fn witnessBindParamIndex(binds: Array[WitnessBind], paramId: U64) -> U64 {
        if paramId == 0U64 { return binds.count() }
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].paramId == paramId { return i }
            i += 1U64
        }
        return binds.count()
    }

    // Convert the directional unifier's implementation-side bindings into the
    // public witness substitution. Query terms stay rigid: only a binder slot
    // declared by this conformance may appear on the left of the result.
    inout fn witnessMatchFromUnify(conformIdx: U64, typeParams: Array[Bind], binds: Array[UnifyBind]) -> WitnessMatch {
        mut val out: Array[WitnessBind] = []
        mut val i: U64 = 0U64
        while i < binds.count() {
            val b: UnifyBind = binds[i]
            if b.side == 0U64 {
                val slot: U64 = self.binderIndexIdentity(params: typeParams, identity: b.nameId)
                if slot < typeParams.count() {
                    val old: U64 = self.witnessBindIndex(binds: out, binder: slot)
                    if old == out.count() {
                        out.append(<WitnessBind binder=slot paramId=typeParams[slot].paramId term=b.ref />)
                    }
                }
            }
            i += 1U64
        }
        // `conformIdx` is one-based so `<WitnessMatch />` remains the no-match
        // sentinel and no caller can mistake the first conformance for failure.
        return <WitnessMatch conformIdx=conformIdx + 1U64 binds=out />
    }

    // Directional concrete-witness selection. This is the one entry that
    // matches receiver and trait arguments under a shared substitution, and it
    // returns that substitution instead of erasing it to a Bool.
    inout fn conformancePatternWitnessMatch(conformIdx: U64, subjectId: U64, subjectTy: U64, subjectArgs: Array[U64], typeParams: Array[Bind], declaredTraitArgs: Array[U64], typeRef: U64, traitArgs: Array[U64], traitArgsOpen: Bool = false) -> WitnessMatch {
        if !traitArgsOpen && declaredTraitArgs.count() != traitArgs.count() { return <WitnessMatch /> }
        mut val binds: Array[UnifyBind] = []
        if subjectTy != 0U64 {
            if !(self.unifyPatterns(a: subjectTy, aSide: 0U64, b: typeRef, bSide: 1U64, aParams: typeParams, bParams: [], binds: inout binds, ignoreTopView: true)) { return <WitnessMatch /> }
        } else {
            // A trait subject (`impl Sub as Marker`) has no nominal TypeRef
            // body in the receiver table.  That is not a wildcard subject:
            // preserve the same head-and-arguments match used by a structured
            // receiver, or the blanket declaration would incorrectly apply to
            // every concrete type before trait-subject conferral materializes it.
            if typeRef >= self.arena.types.count() { return <WitnessMatch /> }
            val actual: TypeRef = self.arena.types[typeRef]
            // `nameId` is an interning cache, not a semantic name. Synthetic
            // TypeRefs (including the receiver used while finalizing a
            // provided call) legitimately carry 0, so matching a legacy
            // head-only conformance must canonicalize that cache before
            // comparing declaration identity. Treating 0 as a distinct name
            // made a concrete `Counter: Iterator` witness disappear and left
            // its Item output symbolic in `MapIter`.
            mut val actualId: U64 = actual.nameId
            if actualId == 0U64 {
                actualId = intern(c: inout self, start: actual.nameStart, len: actual.nameLen)
            }
            if subjectId != actualId || subjectArgs.count() != actual.args.count() { return <WitnessMatch /> }
            mut val si: U64 = 0U64
            while si < subjectArgs.count() {
                if !(self.unifyPatterns(a: subjectArgs[si], aSide: 0U64, b: actual.args[si], bSide: 1U64, aParams: typeParams, bParams: [], binds: inout binds)) { return <WitnessMatch /> }
                si += 1U64
            }
        }
        if !traitArgsOpen {
            mut val i: U64 = 0U64
            while i < declaredTraitArgs.count() {
                if !(self.unifyPatterns(a: declaredTraitArgs[i], aSide: 0U64, b: traitArgs[i], bSide: 1U64, aParams: typeParams, bParams: [], binds: inout binds)) { return <WitnessMatch /> }
                i += 1U64
            }
        }
        return self.witnessMatchFromUnify(conformIdx: conformIdx, typeParams: typeParams, binds: binds)
    }

    // Compatibility projection for consumers still migrating to the witness
    // query. New trait-resolution code must consume `WitnessMatch` directly.
    inout fn conformancePatternMatchesTraitInstance(subjectId: U64, subjectTy: U64, subjectArgs: Array[U64], typeParams: Array[Bind], declaredTraitArgs: Array[U64], typeRef: U64, traitArgs: Array[U64], traitArgsOpen: Bool = false) -> Bool {
        val result: WitnessMatch = self.conformancePatternWitnessMatch(conformIdx: 0U64, subjectId: subjectId, subjectTy: subjectTy, subjectArgs: subjectArgs, typeParams: typeParams, declaredTraitArgs: declaredTraitArgs, typeRef: typeRef, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen)
        return result.conformIdx != 0U64
    }

    inout fn conformanceMatchesTraitInstance(cf: Conform, typeRef: U64, traitArgs: Array[U64], traitArgsOpen: Bool = false) -> Bool {
        return self.conformancePatternMatchesTraitInstance(subjectId: cf.typeId, subjectTy: cf.subjectTy, subjectArgs: self.copyConformTypes(types: cf.subjectArgs), typeParams: self.copyConformBinds(binds: cf.typeParams), declaredTraitArgs: self.copyConformTypes(types: cf.traitArgs), typeRef: typeRef, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen)
    }

    inout fn conformanceWitnessMatch(conformIdx: U64, typeRef: U64, traitArgs: Array[U64], traitArgsOpen: Bool = false) -> WitnessMatch {
        if conformIdx >= self.decls.conforms.count() { return <WitnessMatch /> }
        val cf: Conform = self.decls.conforms[conformIdx]
        return self.conformancePatternWitnessMatch(conformIdx: conformIdx, subjectId: cf.typeId, subjectTy: cf.subjectTy, subjectArgs: self.copyConformTypes(types: cf.subjectArgs), typeParams: self.copyConformBinds(binds: cf.typeParams), declaredTraitArgs: self.copyConformTypes(types: cf.traitArgs), typeRef: typeRef, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen)
    }

    // Registration-side counterpart of `conformanceSubjectMatches`: two
    // declarations collide exactly when one substitution satisfies both their
    // subject and trait-argument patterns.
    inout fn conformancePatternsMayOverlap(a: Conform, b: Conform) -> Bool {
        if a.traitArgs.count() != b.traitArgs.count() { return false }
        mut val binds: Array[UnifyBind] = []
        val aParams: Array[Bind] = self.copyConformBinds(binds: a.typeParams)
        val bParams: Array[Bind] = self.copyConformBinds(binds: b.typeParams)
        if !(self.unifyPatterns(a: a.subjectTy, aSide: 0U64, b: b.subjectTy, bSide: 1U64, aParams: aParams, bParams: bParams, binds: inout binds, ignoreTopView: true)) { return false }
        mut val i: U64 = 0U64
        while i < a.traitArgs.count() {
            if !(self.unifyPatterns(a: self.conformTypeAt(types: a.traitArgs, index: i), aSide: 0U64, b: self.conformTypeAt(types: b.traitArgs, index: i), bSide: 1U64, aParams: aParams, bParams: bParams, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    // Directional form of the same relation: can `provider` satisfy every
    // instance denoted by `subject`?  Subject binders are deliberately rigid
    // (they are not supplied as unification variables), while provider
    // binders remain free.  Thus `Box[T]` covers `Box[I64]`, but `Box[I64]`
    // does not cover `Box[T]`; likewise `Pair[T, T]` does not cover
    // `Pair[U, V]`.
    inout fn conformanceSubjectCovers(provider: Conform, subject: Conform) -> Bool {
        if provider.subjectTy == 0U64 || subject.subjectTy == 0U64 {
            return provider.typeId == subject.typeId && provider.subjectArgs.count() == subject.subjectArgs.count()
        }
        mut val binds: Array[UnifyBind] = []
        return self.unifyPatterns(a: provider.subjectTy, aSide: 0U64, b: subject.subjectTy, bSide: 1U64, aParams: self.copyConformBinds(binds: provider.typeParams), bParams: [], binds: inout binds, ignoreTopView: true)
    }

    // Definition-time form of a bare conformance query.  Unlike instance
    // lookup this proves coverage for an entire declared generic subject, as
    // required by a trait's supertrait obligation.
    inout fn bareConformanceCoversSubject(subject: Conform, traitStart: U64, traitLen: U64) -> Bool {
        // TraitDef.supertraits still store a legacy source Bind rather than a
        // canonical TraitInstanceKey.  Its owner migration belongs with that
        // lowering representation; direct instance queries must not fall back
        // to text, but this declaration-time compatibility input has not yet
        // crossed the canonical boundary.
        val traitId: U64 = intern(c: inout self, start: traitStart, len: traitLen)
        mut val i: U64 = 0U64
        while i < self.decls.conforms.count() {
            val provider: Conform = self.decls.conforms[i]
            if provider.extId == 0U64 && provider.traitId == traitId && self.conformanceSubjectCovers(provider: provider, subject: subject) {
                return true
            }
            i += 1U64
        }
        return false
    }

    inout fn receiverPatternsMayOverlap(a: Func, b: Func) -> Bool {
        if !(a.hasRecv || a.isAssoc) { return true }
        mut val binds: Array[UnifyBind] = []
        return self.unifyPatterns(a: a.recvTy, aSide: 0U64, b: b.recvTy, bSide: 1U64, aParams: a.typeParams, bParams: b.typeParams, binds: inout binds, ignoreTopView: true)
    }

    // Search the two default-argument selector automata for a shared form. A
    // label match is not forced: either side may omit a defaulted parameter to
    // expose a later form, so each branch owns an independent substitution.
    inout fn callableFormsMayOverlapAt(a: Func, b: Func, ai: U64, bi: U64, binds: Array[UnifyBind]) -> Bool {
        if ai == a.params.count() && bi == b.params.count() { return true }
        if ai == a.params.count() {
            if b.params[bi].hasDefault {
                return self.callableFormsMayOverlapAt(a: a, b: b, ai: ai, bi: bi + 1U64, binds: binds)
            }
            return false
        }
        if bi == b.params.count() {
            if a.params[ai].hasDefault {
                return self.callableFormsMayOverlapAt(a: a, b: b, ai: ai + 1U64, bi: bi, binds: binds)
            }
            return false
        }
        if a.params[ai].noLabel == b.params[bi].noLabel && (a.params[ai].noLabel || a.params[ai].nameId == b.params[bi].nameId) {
            if a.params[ai].tyIsArray == b.params[bi].tyIsArray {
                mut val matched: Array[UnifyBind] = self.copyUnifyBinds(binds: binds)
                if self.unifyPatterns(a: a.params[ai].ty, aSide: 0U64, b: b.params[bi].ty, bSide: 1U64, aParams: a.typeParams, bParams: b.typeParams, binds: inout matched) {
                    if self.callableFormsMayOverlapAt(a: a, b: b, ai: ai + 1U64, bi: bi + 1U64, binds: matched) { return true }
                }
            }
        }
        if a.params[ai].hasDefault {
            if self.callableFormsMayOverlapAt(a: a, b: b, ai: ai + 1U64, bi: bi, binds: self.copyUnifyBinds(binds: binds)) { return true }
        }
        if b.params[bi].hasDefault {
            if self.callableFormsMayOverlapAt(a: a, b: b, ai: ai, bi: bi + 1U64, binds: self.copyUnifyBinds(binds: binds)) { return true }
        }
        return false
    }

    // Do the two declarations expose one common callable form? Receiver and
    // selected arguments share one substitution: after `Box[T]` meets
    // `Box[I64]`, later `T` positions are necessarily I64 too.
    inout fn callableFormsMayOverlap(a: Func, b: Func) -> Bool {
        mut val binds: Array[UnifyBind] = []
        if a.hasRecv || a.isAssoc {
            if !(self.unifyPatterns(a: a.recvTy, aSide: 0U64, b: b.recvTy, bSide: 1U64, aParams: a.typeParams, bParams: b.typeParams, binds: inout binds, ignoreTopView: true)) { return false }
        }
        return self.callableFormsMayOverlapAt(a: a, b: b, ai: 0U64, bi: 0U64, binds: binds)
    }

    inout fn checkFuncRegistration(f: Func) {
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val priorEntry: Callable = self.decls.callables[i]
            val prior: Func = self.arena.funcs[priorEntry.funcIdx]
            if !prior.isProvided {
                // A bare declaration namespace is module-owned.  A named
                // extension is instead its own bundle: `#Ext` carries no module
                // qualifier at a call site, so every declaration named Ext must
                // enter this one collision domain even when loaded from another
                // module.
                val sameNamespace: Bool = (prior.extId != 0U64 && prior.extId == f.extId) || self.funcDeclModule(f: prior) == self.funcDeclModule(f: f)
                if sameNamespace {
                    if self.sameFuncCandidateBucket(a: prior, b: f) {
                        // Raw foreign/intrinsic functions have one linker symbol,
                        // not a Plew overload family. Their name collision is a
                        // registration collision before selector matching.
                        if !(f.hasRecv || f.isAssoc) && prior.nameId == f.nameId && (prior.isExtern || f.isExtern) {
                            self.errorAt(offset: f.defOffset, msg: "duplicate function name: extern declarations and ordinary functions share one top-level namespace in a module")
                        }
                    if prior.nameId == f.nameId {
                    if self.sameFuncSelector(a: prior, b: f) && self.receiverPatternsMayOverlap(a: prior, b: f) {
                        if !(self.sameGenericShape(a: prior, b: f)) {
                            self.errorAt(offset: f.defOffset, msg: "generic overloads with the same selector must have the same type-argument count and generic parameter positions (spec/07)")
                        }
                    }
                    if self.callableFormsMayOverlap(a: prior, b: f) {
                        self.errorAt(offset: f.defOffset, msg: "duplicate or overlapping callable form in one declaration namespace (spec/04,07,09)")
                    }
                    }
                    }
                }
            }
            i += 1U64
        }
    }

    // A trait-provided method is copied to each concrete conformer after source
    // declarations have been registered.  In a named extension that copy shares the
    // bundle's callable surface with direct members, whereas on the bare surface an
    // inherent member is intentionally the default.  Check this *post-conformance*
    // form: the original receivers (`Trait` and `Sample`) cannot reveal the collision.
    inout fn checkProvidedExtensionSurfaceCollision(f: Func) {
        if !(f.isProvided) || f.extId == 0U64 {
            return
        }
        mut val i: U64 = 0U64
        while i < self.decls.callables.count() {
            val prior: Func = self.arena.funcs[self.decls.callables[i].funcIdx]
            if !(prior.isProvided) && prior.extId == f.extId && prior.nameId == f.nameId {
                if self.sameFuncCandidateBucket(a: prior, b: f) {
                    if self.callableFormsMayOverlap(a: prior, b: f) {
                        self.errorAt(offset: f.defOffset, msg: "direct and trait-provided members overlap on one extension surface; selectability cannot distinguish them (spec/09)")
                    }
                }
            }
            i += 1U64
        }
    }

    inout fn registerDeclaredFunc(f: Func) -> U64 {
        val idx: U64 = self.arena.funcs.count()
        self.arena.funcs.append(f)
        self.registerCallable(funcIdx: idx, checkCollisions: true)
        return idx
    }

    // The only entrance to the resolver's surface table. Derived provided
    // methods call this after their body record is appended; source selection is
    // therefore represented once, instead of reconstructed separately by # calls.
    inout fn registerCallable(funcIdx: U64, checkCollisions: Bool = false) {
        if funcIdx >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[funcIdx]
        // Source declarations cannot enter a surface which already has a
        // call-indistinguishable candidate.  Provided copies are synthesized
        // dispatch artifacts; their source trait is selected separately and
        // therefore deliberately bypass this source-declaration check.
        if checkCollisions {
            self.checkFuncRegistration(f: f)
        }
        self.checkProvidedExtensionSurfaceCollision(f: f)
        mut val sourceKind: U64 = 0U64
        mut val sourceId: U64 = 0U64
        mut val sourceOwner: U64 = 0U64
        mut val sourceArity: U64 = 0U64
        mut val traitId: U64 = f.srcTraitId
        mut val traitOwner: U64 = f.srcTraitOwner
        mut val traitArity: U64 = f.provTraitArity
        if traitId != 0U64 && traitOwner == 0U64 {
            traitOwner = f.provTraitOwner
        }
        if f.extId != 0U64 {
            sourceKind = 1U64
            sourceId = f.extId
            // An extension name is one bundle across loaded modules (and is
            // collision-checked as such), so its interned bundle id is stable.
            sourceOwner = f.extId
        } else if f.srcTraitId != 0U64 {
            sourceKind = 2U64
            sourceId = f.srcTraitId
            sourceArity = f.provTraitArity
            sourceOwner = f.srcTraitOwner
            if sourceOwner == 0U64 { sourceOwner = f.provTraitOwner }
        }
        self.decls.callables.append(<Callable funcIdx=funcIdx sourceKind=sourceKind sourceId=sourceId sourceOwner=sourceOwner sourceArity=sourceArity traitId=traitId traitOwner=traitOwner traitArity=traitArity sourceModule=self.funcDeclModule(f: f) />)
    }

    inout fn callableIsBare(c: Callable) -> Bool {
        return c.sourceKind == 0U64
    }

    inout fn callableSourceKey(c: Callable) -> ViewSource {
        return <ViewSource kind=c.sourceKind id=c.sourceId owner=c.sourceOwner arity=c.sourceArity />
    }

    inout fn sameViewSource(a: ViewSource, b: ViewSource) -> Bool {
        return a.kind == b.kind && a.id == b.id && a.owner == b.owner && a.arity == b.arity
    }

    inout fn callableMatchesSource(c: Callable, source: ViewSource) -> Bool {
        return source.kind != 0U64 && self.sameViewSource(a: self.callableSourceKey(c: c), b: source)
    }

    inout fn callableTraitKey(c: Callable) -> ViewSource {
        return <ViewSource kind=2U64 id=c.traitId owner=c.traitOwner arity=c.traitArity />
    }

    inout fn callableMatchesTrait(c: Callable, source: ViewSource) -> Bool {
        return c.traitId != 0U64 && source.kind == 2U64 && self.sameViewSource(a: self.callableTraitKey(c: c), b: source)
    }

    // Candidate de-duplication is stricter than source selection.  `#E` names
    // one extension bundle, but E may intentionally expose distinct A- and
    // B-provided members that only `#E#A` / `#E#B` can distinguish.  They are
    // two candidates under E, not duplicate witnesses.  Only copies of the
    // same source *and* trait provenance denote one semantic callable.
    inout fn sameCallableSemanticOrigin(a: Callable, b: Callable) -> Bool {
        return self.sameViewSource(a: self.callableSourceKey(c: a), b: self.callableSourceKey(c: b)) && self.sameViewSource(a: self.callableTraitKey(c: a), b: self.callableTraitKey(c: b))
    }

    // Match a call receiver against the declaration's complete receiver pattern.
    // A generic impl such as Box[T] is a pattern, whereas Box[I64] is exact.
    // A trait-receiver *provided copy* is different: it may be declared on B
    // while the selected concrete receiver is S, justified by S: B. Ask the
    // same full-instance predicate used for extension applicability. A direct
    // conformance method is instead the implementation witness for B itself;
    // its visibility on S is represented by the separately registered copy.
    // Letting that witness match every S: B duplicates the copy (and turns one
    // proof into an ambiguity). Calls without a recovered TypeRef retain the
    // legacy head-name fallback.
    inout fn callableReceiverMatches(f: Func, recvId: U64, recvRef: U64) -> Bool {
        // A trait-subject origin needs its full path proof: the copied
        // receiver surface B is not the target trait A of `impl B as A`.
        // Direct origins intentionally retain the established direct-witness
        // predicate below; replacing them with a broader path search changes
        // their body environment and can conflate independent witnesses.
        mut val originIsTraitSubject: Bool = false
        if f.isProvided && f.originConformIdx != 0U64 {
            val ci: U64 = f.originConformIdx - 1U64
            if ci < self.decls.conforms.count() {
                val origin: Conform = self.decls.conforms[ci]
                originIsTraitSubject = self.isTraitName(start: origin.typeStart, len: origin.typeLen)
            }
        }
        if originIsTraitSubject && recvRef != 0U64 {
            // A provided copy's `recv*` describes the surface it was copied
            // onto (for `impl B as A`, B), not the trait that declared its
            // requirement/provided body (A).  Its origin metadata is the
            // only canonical target for proof selection.
            mut val traitId: U64 = f.originTraitId
            mut val traitOwner: U64 = f.originTraitOwner
            mut val traitArgs: Array[U64] = []
            if f.originConformIdx != 0U64 {
                val ci: U64 = f.originConformIdx - 1U64
                if ci < self.decls.conforms.count() {
                    val origin: Conform = self.decls.conforms[ci]
                    traitId = origin.traitId
                    traitOwner = origin.traitStart
                    traitArgs = self.copyConformTypes(types: origin.traitArgs)
                }
            }
            val proof: StaticConformanceProof = self.concreteConformanceProof(baseRef: recvRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs)
            match proof {
                StaticConformanceProof.Missing => { return false }
                _ => { return true }
            }
        }
        if f.recvId != recvId {
            if f.isProvided && self.methodRecvIsTrait(f: f) && recvRef != 0U64 {
                return self.conformsInstance(ref: recvRef, traitStart: f.recvStart, traitLen: f.recvLen, traitArgs: f.recvTraitArgs)
            }
            return false
        }
        if recvRef == 0U64 || f.recvTy == 0U64 { return true }
        if recvRef >= self.arena.types.count() || f.recvTy >= self.arena.types.count() { return true }
        mut val binds: Array[UnifyBind] = []
        mut val patternParams: Array[Bind] = f.typeParams
        if f.recvPatternParams.count() > 0U64 { patternParams = f.recvPatternParams }
        return self.unifyPatterns(a: f.recvTy, aSide: 0U64, b: recvRef, bSide: 1U64, aParams: patternParams, bParams: [], binds: inout binds, ignoreTopView: true)
    }

    inout fn sameTypeRefListAlphaEq(a: Array[U64], b: Array[U64], aParams: Array[Bind], bParams: Array[Bind]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0
        while i < a.count() {
            if !(self.typeRefsAlphaEq(a: a[i], b: b[i], aParams: aParams, bParams: bParams)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn checkConformanceRegistration(cf: Conform) {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val prior: Conform = self.decls.conforms[i]
            if !prior.derived {
                // As with methods, a named extension is one source-selectable
                // bundle, not one bundle per defining module.  Its conformance
                // key must therefore be unique across all of its parts.
                val sameNamespace: Bool = (prior.extId != 0U64 && prior.extId == cf.extId) || self.moduleOf(offset: prior.defOffset) == self.moduleOf(offset: cf.defOffset)
                if sameNamespace {
                    if prior.extId == cf.extId && prior.traitId == cf.traitId && prior.traitStart == cf.traitStart && prior.typeId == cf.typeId && prior.subjectArgs.count() == cf.subjectArgs.count() {
                        // A conformance is a callable-like source surface: its
                        // subject and trait arguments share one substitution.
                        // Alpha equality is insufficient (`Box[T]` overlaps
                        // `Box[I64]`), so use the same pattern unifier as
                        // callable-form registration.
                        if self.conformancePatternsMayOverlap(a: prior, b: cf) {
                            self.errorAt(offset: cf.defOffset, msg: "duplicate or overlapping trait conformance in one declaration namespace (spec/08,09)")
                        }
                    }
                }
            }
            i += 1U64
        }
    }

    inout fn registerDeclaredConformance(cf: Conform) {
        self.checkConformanceRegistration(cf: cf)
        self.decls.conforms.append(cf)
    }

}
