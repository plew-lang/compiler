// Declaration-candidate registration (root: Lower.pw).
//
// `Decls` callable surface is the single candidate surface consumed by registration and
// resolution. Function bodies/signatures remain in `arena.funcs`; every source
// declaration enters the surface through registerDeclaredFunc.

pub impl Comp {
    inout fn funcDeclModule(f: Func) -> U64 {
        match self.modules.sourceFileContaining(offset: f.defOffset) {
            Optional.Some(v: val index) => { return self.modules.sourceFileRange(index: index).moduleId }
            Optional.None => { return self.moduleOf(offset: f.nameStart) }
        }
    }

    // Namespace and receiver-head filtering only.  This deliberately does NOT
    // compare complete receiver patterns: `Box[T]` and `Box[I64]` have a common
    // invocation, even though they are not alpha-equal declarations.  The shared
    // callable-form overlap check below owns that semantic question.
    inout fn sameFuncCandidateBucket(a: Func, b: Func) -> Bool {
        if a.hasRecv != b.hasRecv { return false }
        if a.isAssoc != b.isAssoc { return false }
        if a.hasRecv || a.isAssoc {
            if a.recvTy < self.arena.typeCount() && b.recvTy < self.arena.typeCount() {
                val left = self.arena.typeTermAt(index: a.recvTy)
                val right = self.arena.typeTermAt(index: b.recvTy)
                if left.hasDecl && right.hasDecl {
                    if left.declOffset != right.declOffset { return false }
                } else if a.recvId != b.recvId { return false }
            } else if a.recvId != b.recvId { return false }
        }
        return a.extId == b.extId
    }

    inout fn binderIndex(params: PatternBindInput, nameId: U64) -> U64 {
        mut val i: U64 = 0
        while i < params.count() {
            if params.at(index: i, declarations: self.decls, functions: self.arena).nameId == nameId { return i }
            i += 1U64
        }
        return params.count()
    }

    // Semantic binder identity is lexical ParamId. NameId remains only the
    // legacy fallback for synthetic/old terms that have no ParamId yet.
    inout fn binderIdentity(b: Bind) -> U64 {
        if b.paramId != 0U64 { return b.paramId }
        return b.nameId
    }

    inout fn binderIndexIdentity(params: PatternBindInput, identity: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < params.count() {
            if self.binderIdentity(b: params.at(index: i, declarations: self.decls, functions: self.arena)) == identity { return i }
            i += 1U64
        }
        return params.count()
    }

    // View source order is presentation only.  Compare the selector names as a
    // duplicate-free set here; later verification classifies them as extensions
    // plus the single permitted trait selector.
    inout fn sameViewIdSet(a: Array[U64], b: Array[U64]) -> Bool {
        mut val ai: U64 = 0U64
        while ai < a.count() {
            mut val seenA: Bool = false
            mut val ap: U64 = 0U64
            while ap < ai {
                if a[ap] == a[ai] { seenA = true }
                ap += 1U64
            }
            if !(seenA) {
                mut val found: Bool = false
                mut val bi: U64 = 0U64
                while bi < b.count() {
                    if b[bi] == a[ai] { found = true }
                    bi += 1U64
                }
                if !(found) { return false }
            }
            ai += 1U64
        }
        mut val bi: U64 = 0U64
        while bi < b.count() {
            mut val found: Bool = false
            mut val aj: U64 = 0U64
            while aj < a.count() {
                if a[aj] == b[bi] { found = true }
                aj += 1U64
            }
            if !(found) { return false }
            bi += 1U64
        }
        return true
    }

    // Structural equality modulo the two declaration binder lists. This is the
    // declaration-key equality, not call-site type compatibility.
    inout fn typeRefsAlphaEq(a: U64, b: U64, aParams: Array[Bind], bParams: Array[Bind]) -> Bool {
        if a == 0U64 || b == 0U64 { return a == b }
        if a >= self.arena.typeCount() || b >= self.arena.typeCount() { return false }
        val ta: TypeRef = self.arena.typeAt(index: a)
        val tb: TypeRef = self.arena.typeAt(index: b)
        val ai: U64 = self.binderIndex(params: <PatternBindInput.Values values=aParams />, nameId: ta.nameId)
        val bi: U64 = self.binderIndex(params: <PatternBindInput.Values values=bParams />, nameId: tb.nameId)
        if ai < aParams.count() || bi < bParams.count() {
            return ai == bi && ai < aParams.count() && bi < bParams.count()
        }
        // Registration runs before the visibility pass annotates every
        // TypeRef with a declaration owner.  Compare owner identity whenever
        // both terms already carry it; later semantic consumers require it.
        if ((ta.hasDecl && tb.hasDecl) && ta.declOffset != tb.declOffset) || (!(ta.hasDecl && tb.hasDecl) && ta.nameId != tb.nameId) || ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable || ta.isDiverging != tb.isDiverging { return false }
        if ta.assocTraitId != tb.assocTraitId || (ta.hasAssocTraitDecl && tb.hasAssocTraitDecl && ta.assocTraitDeclOffset != tb.assocTraitDeclOffset) || ta.assocNameId != tb.assocNameId { return false }
        if ta.args.count() != tb.args.count() { return false }
        mut val i: U64 = 0
        while i < ta.args.count() {
            if !(self.typeRefsAlphaEq(a: ta.args[i], b: tb.args[i], aParams: aParams, bParams: bParams)) { return false }
            i += 1U64
        }
        if ta.assocTraitArgs.count() != tb.assocTraitArgs.count() { return false }
        i = 0U64
        while i < ta.assocTraitArgs.count() {
            mut val al: U64 = 0U64
            mut val bl: U64 = 0U64
            if i < ta.assocTraitArgLabels.count() { al = ta.assocTraitArgLabels[i] }
            if i < tb.assocTraitArgLabels.count() { bl = tb.assocTraitArgLabels[i] }
            if al != bl || !(self.typeRefsAlphaEq(a: ta.assocTraitArgs[i], b: tb.assocTraitArgs[i], aParams: aParams, bParams: bParams)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn unificationBindingIndex(binds: Array[UnifyBind], side: U64, binderId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].side == side && binds[i].nameId == binderId { return i }
            i += 1U64
        }
        return binds.count()
    }

    // `viewExtId` is only the one-selector compatibility mirror.  Every
    // registration rule must ask this shared question so `T#E#P` cannot be
    // mistaken for bare `T` merely because its normal-form source set lives
    // in `viewIds`.
    inout fn hasTopLevelView(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.typeCount() { return false }
        val term: TypeTerm = self.arena.typeTermAt(index: ref)
        return term.hasTopLevelView()
    }

    // A type parameter is a free unification variable only in its bare form;
    // `T#P` / projections retain their structural view/projection constraints.
    inout fn plainBinder(ref: U64, params: PatternBindInput) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeCount() { return params.count() }
        val term: TypeTerm = self.arena.typeTermAt(index: ref)
        if term.hasTopLevelView() || term.assocTraitId != 0U64 || term.args.len != 0U64 { return params.count() }
        if term.paramId != 0U64 {
            mut val i: U64 = 0U64
            while i < params.count() {
                if params.at(index: i, declarations: self.decls, functions: self.arena).paramId == term.paramId { return i }
                i += 1U64
            }
            return params.count()
        }
        return self.binderIndex(params: params, nameId: term.nameId)
    }

    // The raw selector relation is an unordered set, including when the
    // stored range contains duplicates. Keep it distinct from resolved views.
    fn sameTypeTermViewIdSet(a: TypeViewIdRange, b: TypeViewIdRange) -> Bool {
        mut val index: U64 = 0U64
        while index < a.len {
            val selector = self.arena.typeViewIdAt(index: a.start + index)
            mut val found = false
            mut val other: U64 = 0U64
            while other < b.len {
                if self.arena.typeViewIdAt(index: b.start + other) == selector { found = true }
                other += 1U64
            }
            if !found { return false }
            index += 1U64
        }
        index = 0U64
        while index < b.len {
            val selector = self.arena.typeViewIdAt(index: b.start + index)
            mut val found = false
            mut val other: U64 = 0U64
            while other < a.len {
                if self.arena.typeViewIdAt(index: a.start + other) == selector { found = true }
                other += 1U64
            }
            if !found { return false }
            index += 1U64
        }
        return true
    }

    inout fn occursInPattern(side: U64, binderId: U64, ref: U64, refSide: U64, aParams: PatternBindInput, bParams: PatternBindInput, binds: Array[UnifyBind]) -> Bool {
        mut val params: PatternBindInput = aParams
        if refSide != 0U64 { params = bParams }
        val bi: U64 = self.plainBinder(ref: ref, params: params)
        if bi < params.count() {
            if refSide == side && self.binderIdentity(b: params.at(index: bi, declarations: self.decls, functions: self.arena)) == binderId { return true }
            // Corresponding generic parameters in two same-shape overloads are
            // one logical variable for overlap purposes (T in each signature),
            // even though their source binders are distinct records.
            mut val targetParams: PatternBindInput = aParams
            if side != 0U64 { targetParams = bParams }
            val targetIdx: U64 = self.binderIndexIdentity(params: targetParams, identity: binderId)
            if refSide != side && targetIdx == bi { return true }
            val bound: U64 = self.unificationBindingIndex(binds: binds, side: refSide, binderId: self.binderIdentity(b: params.at(index: bi, declarations: self.decls, functions: self.arena)))
            if bound < binds.count() {
                return self.occursInPattern(side: side, binderId: binderId, ref: binds[bound].ref, refSide: binds[bound].refSide, aParams: aParams, bParams: bParams, binds: binds)
            }
            return false
        }
        if ref == 0U64 || ref >= self.arena.typeCount() { return false }
        val t: TypeTerm = self.arena.typeTermAt(index: ref)
        mut val i: U64 = 0U64
        while i < t.args.len {
            if self.occursInPattern(side: side, binderId: binderId, ref: self.arena.typeArgumentAt(index: t.args.start + i), refSide: refSide, aParams: aParams, bParams: bParams, binds: binds) { return true }
            i += 1U64
        }
        i = 0U64
        while i < t.assocTraitArgs.len {
            if self.occursInPattern(side: side, binderId: binderId, ref: self.arena.typeAssocArgumentAt(index: t.assocTraitArgs.start + i), refSide: refSide, aParams: aParams, bParams: bParams, binds: binds) { return true }
            i += 1U64
        }
        return false
    }

    // `ignoreTopView` is used only for receiver dispatch. A view chooses the
    // callable source; it does not replace the receiver's base type pattern.
    // Nested views remain ordinary type identity and must still match exactly.
    inout fn unifyPatterns(a: U64, aSide: U64, b: U64, bSide: U64, aParams: PatternBindInput, bParams: PatternBindInput, binds: inout Array[UnifyBind], ignoreTopView: Bool = false) -> Bool {
        mut val aScope: PatternBindInput = aParams
        if aSide != 0U64 { aScope = bParams }
        mut val bScope: PatternBindInput = aParams
        if bSide != 0U64 { bScope = bParams }
        val av: U64 = self.plainBinder(ref: a, params: aScope)
        val bv: U64 = self.plainBinder(ref: b, params: bScope)
        if av < aScope.count() && bv < bScope.count() {
            return av == bv
        }
        if av < aScope.count() {
            val binderId: U64 = self.binderIdentity(b: aScope.at(index: av, declarations: self.decls, functions: self.arena))
            val found: U64 = self.unificationBindingIndex(binds: binds, side: aSide, binderId: binderId)
            if found < binds.count() {
                return self.unifyPatterns(a: binds[found].ref, aSide: binds[found].refSide, b: b, bSide: bSide, aParams: aParams, bParams: bParams, binds: inout binds, ignoreTopView: ignoreTopView)
            }
            if self.occursInPattern(side: aSide, binderId: binderId, ref: b, refSide: bSide, aParams: aParams, bParams: bParams, binds: binds) { return false }
            binds.append(<UnifyBind side=aSide nameId=binderId ref=b refSide=bSide />)
            return true
        }
        if bv < bScope.count() {
            return self.unifyPatterns(a: b, aSide: bSide, b: a, bSide: aSide, aParams: aParams, bParams: bParams, binds: inout binds, ignoreTopView: ignoreTopView)
        }
        if a == 0U64 || b == 0U64 || a >= self.arena.typeCount() || b >= self.arena.typeCount() { return a == b }
        val ta: TypeTerm = self.arena.typeTermAt(index: a)
        val tb: TypeTerm = self.arena.typeTermAt(index: b)
        if ((ta.hasDecl && tb.hasDecl) && ta.declOffset != tb.declOffset) || (!(ta.hasDecl && tb.hasDecl) && ta.nameId != tb.nameId) || (!ignoreTopView && (ta.viewExtId != tb.viewExtId || !(self.sameTypeTermViewIdSet(a: ta.viewIds, b: tb.viewIds)))) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable || ta.isDiverging != tb.isDiverging || ta.assocTraitId != tb.assocTraitId || (ta.hasAssocTraitDecl && tb.hasAssocTraitDecl && ta.assocTraitDeclOffset != tb.assocTraitDeclOffset) || ta.assocNameId != tb.assocNameId || ta.args.len != tb.args.len || ta.assocTraitArgs.len != tb.assocTraitArgs.len { return false }
        mut val i: U64 = 0U64
        while i < ta.args.len {
            if !(self.unifyPatterns(a: self.arena.typeArgumentAt(index: ta.args.start + i), aSide: aSide, b: self.arena.typeArgumentAt(index: tb.args.start + i), bSide: bSide, aParams: aParams, bParams: bParams, binds: inout binds)) { return false }
            i += 1U64
        }
        i = 0U64
        while i < ta.assocTraitArgs.len {
            mut val al: U64 = 0U64
            mut val bl: U64 = 0U64
            if i < ta.assocTraitArgLabels.len { al = self.arena.typeAssocArgumentLabelAt(index: ta.assocTraitArgLabels.start + i) }
            if i < tb.assocTraitArgLabels.len { bl = self.arena.typeAssocArgumentLabelAt(index: tb.assocTraitArgLabels.start + i) }
            if al != bl || !(self.unifyPatterns(a: self.arena.typeAssocArgumentAt(index: ta.assocTraitArgs.start + i), aSide: aSide, b: self.arena.typeAssocArgumentAt(index: tb.assocTraitArgs.start + i), bSide: bSide, aParams: aParams, bParams: bParams, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn copyUnifyBinds(binds: Array[UnifyBind]) -> Array[UnifyBind] {
        mut val copied: Array[UnifyBind] = []
        mut val i: U64 = 0U64
        while i < binds.count() {
            copied.append(binds[i])
            i += 1U64
        }
        return copied
    }

    // One primitive for asking whether a concrete type belongs to a declared
    // conformance's subject surface.  Registration uses the same unifier
    // through `conformancePatternsMayOverlap`; lookup must not regress to a
    // head-name-only approximation.
    inout fn conformanceSubjectMatches(cf: Conform, typeRef: U64) -> Bool {
        if typeRef == 0U64 || cf.subjectTy == 0U64 { return true }
        mut val binds: Array[UnifyBind] = []
        return self.unifyPatterns(a: cf.subjectTy, aSide: 0U64, b: typeRef, bSide: 1U64, aParams: <PatternBindInput.Conformance range=cf.typeParams />, bParams: <PatternBindInput.Values values=[] />, binds: inout binds, ignoreTopView: true)
    }

    // The trait-argument part of a conformance key.  A trait subject such as
    // `P[String]` is a pattern over a concrete conformance's instance
    // arguments, not merely an arity marker.  Keep this as the one instance
    // matcher so closure propagation, bounds, and views cannot each regress
    // to a count-only comparison.
    inout fn traitInstanceArgsMatch(pattern: PatternTypeInput, patternParams: PatternBindInput, actual: PatternTypeInput) -> Bool {
        if pattern.count() != actual.count() { return false }
        mut val binds: Array[UnifyBind] = []
        mut val i: U64 = 0U64
        while i < pattern.count() {
            if !(self.unifyPatterns(a: pattern.at(index: i, declarations: self.decls), aSide: 0U64, b: actual.at(index: i, declarations: self.decls), bSide: 1U64, aParams: patternParams, bParams: <PatternBindInput.Values values=[] />, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    // Instance-side counterpart of the registration overlap predicate.  A
    // conformance is selected only when both its receiver pattern and its
    // trait arguments unify with the requested trait instance; comparing just
    // the trait spelling would conflate `Sub` and `Sub[I64]`.
    // The concrete-query form of a conformance key.  Keep this independent of
    // `Conform`: associated-type bindings carry the same key, and must select
    // a witness by precisely the same rule as ordinary conformance lookup.
    inout fn witnessBindIndex(binds: Array[WitnessBind], binder: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].binder == binder { return i }
            i += 1U64
        }
        return binds.count()
    }

    // Semantic witness lookup is lexical. Keep the positional helper above
    // only for old callers that still carry a declaration-order slot.
    inout fn witnessBindParamIndex(binds: Array[WitnessBind], paramId: U64) -> U64 {
        if paramId == 0U64 { return binds.count() }
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].paramId == paramId { return i }
            i += 1U64
        }
        return binds.count()
    }

    // Convert the directional unifier's implementation-side bindings into the
    // public witness substitution. Query terms stay rigid: only a binder slot
    // declared by this conformance may appear on the left of the result.
    inout fn witnessMatchFromUnify(conformIdx: U64, typeParams: PatternBindInput, binds: Array[UnifyBind]) -> WitnessMatch {
        mut val out: Array[WitnessBind] = []
        mut val i: U64 = 0U64
        while i < binds.count() {
            val b: UnifyBind = binds[i]
            if b.side == 0U64 {
                val slot: U64 = self.binderIndexIdentity(params: typeParams, identity: b.nameId)
                if slot < typeParams.count() {
                    val old: U64 = self.witnessBindIndex(binds: out, binder: slot)
                    if old == out.count() {
                        out.append(<WitnessBind binder=slot paramId=typeParams.at(index: slot, declarations: self.decls, functions: self.arena).paramId term=b.ref />)
                    }
                }
            }
            i += 1U64
        }
        // `conformIdx` is one-based so `<WitnessMatch />` remains the no-match
        // sentinel and no caller can mistake the first conformance for failure.
        return <WitnessMatch conformIdx=conformIdx + 1U64 binds=out />
    }

    // A selected proof retains semantic Self, while inherited newtype
    // implementations match their physical underlying subject.
    inout fn conformancePhysicalSubject(typeRef: U64) -> U64 {
        mut val matchRef: U64 = typeRef
        mut val depth: U64 = 0U64
        while matchRef != 0U64 && matchRef < self.arena.typeCount() && depth < self.arena.newtypeCount() {
            val underlying: U64 = self.arena.newtypeUnderlying(ref: matchRef)
            if underlying == 0U64 || underlying == matchRef { break }
            matchRef = underlying
            depth += 1U64
        }
        return matchRef
    }

    // Directional concrete-witness selection. This is the one entry that
    // matches receiver and trait arguments under a shared substitution, and it
    // returns that substitution instead of erasing it to a Bool.
    inout fn conformancePatternWitnessMatch(conformIdx: U64, subjectId: U64, subjectTy: U64, subjectArgs: PatternTypeInput, typeParams: PatternBindInput, declaredTraitArgs: PatternTypeInput, typeRef: U64, traitArgs: PatternTypeInput, traitArgsOpen: Bool = false) -> Result[WitnessMatch, CompileDiagnostic] {
        if !traitArgsOpen && declaredTraitArgs.count() != traitArgs.count() { return <Result.Ok value=<WitnessMatch /> />}
        // Match the inherited implementation against its physical subject,
        // but preserve the authored receiver as Self in the returned proof.
        val matchRef = self.conformancePhysicalSubject(typeRef: typeRef)
        mut val binds: Array[UnifyBind] = []
        if subjectTy != 0U64 {
            if !(self.unifyPatterns(a: subjectTy, aSide: 0U64, b: matchRef, bSide: 1U64, aParams: typeParams, bParams: <PatternBindInput.Values values=[] />, binds: inout binds, ignoreTopView: true)) { return <Result.Ok value=<WitnessMatch /> />}
        } else {
            // A trait subject (`impl Sub as Marker`) has no nominal TypeRef
            // body in the receiver table.  That is not a wildcard subject:
            // preserve the same head-and-arguments match used by a structured
            // receiver, or the blanket declaration would incorrectly apply to
            // every concrete type before trait-subject conferral materializes it.
            if matchRef >= self.arena.typeCount() { return <Result.Ok value=<WitnessMatch /> />}
            val actual: TypeRef = self.arena.typeAt(index: matchRef)
            // `nameId` is an interning cache, not a semantic name. Synthetic
            // TypeRefs (including the receiver used while finalizing a
            // provided call) legitimately carry 0, so matching a legacy
            // head-only conformance must canonicalize that cache before
            // comparing declaration identity. Treating 0 as a distinct name
            // made a concrete `Counter: Iterator` witness disappear and left
            // its Item output symbolic in `MapIter`.
            mut val actualId: U64 = actual.nameId
            if actualId == 0U64 {
                actualId = intern(c: inout self, start: actual.nameStart, len: actual.nameLen)
            }
            if subjectId != actualId || subjectArgs.count() != actual.args.count() { return <Result.Ok value=<WitnessMatch /> />}
            mut val si: U64 = 0U64
            while si < subjectArgs.count() {
                if !(self.unifyPatterns(a: subjectArgs.at(index: si, declarations: self.decls), aSide: 0U64, b: actual.args[si], bSide: 1U64, aParams: typeParams, bParams: <PatternBindInput.Values values=[] />, binds: inout binds)) { return <Result.Ok value=<WitnessMatch /> />}
                si += 1U64
            }
        }
        if !traitArgsOpen {
            mut val i: U64 = 0U64
            while i < declaredTraitArgs.count() {
                val partial: WitnessMatch = self.witnessMatchFromUnify(conformIdx: conformIdx, typeParams: typeParams, binds: binds)
                val selected: WitnessMatch = <WitnessMatch conformIdx=partial.conformIdx binds=partial.binds selfRef=typeRef />
                val declared: U64 = (try self.groundWitnessTypeTerm(ref: declaredTraitArgs.at(index: i, declarations: self.decls), params: typeParams, matchResult: selected))
                if !(self.unifyPatterns(a: declared, aSide: 0U64, b: traitArgs.at(index: i, declarations: self.decls), bSide: 1U64, aParams: typeParams, bParams: <PatternBindInput.Values values=[] />, binds: inout binds)) { return <Result.Ok value=<WitnessMatch /> />}
                i += 1U64
            }
        }
        val selected: WitnessMatch = self.witnessMatchFromUnify(conformIdx: conformIdx, typeParams: typeParams, binds: binds)
        return <Result.Ok value=<WitnessMatch conformIdx=selected.conformIdx binds=selected.binds selfRef=typeRef /> />
    }

    // Compatibility projection for consumers still migrating to the witness
    // query. New trait-resolution code must consume `WitnessMatch` directly.
    inout fn conformancePatternMatchesTraitInstance(subjectId: U64, subjectTy: U64, subjectArgs: PatternTypeInput, typeParams: PatternBindInput, declaredTraitArgs: PatternTypeInput, typeRef: U64, traitArgs: PatternTypeInput, traitArgsOpen: Bool = false) -> Result[Bool, CompileDiagnostic] {
        val result: WitnessMatch = (try self.conformancePatternWitnessMatch(conformIdx: 0U64, subjectId: subjectId, subjectTy: subjectTy, subjectArgs: subjectArgs, typeParams: typeParams, declaredTraitArgs: declaredTraitArgs, typeRef: typeRef, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen))
        return <Result.Ok value=result.conformIdx != 0U64 />
    }

    inout fn conformanceMatchesTraitInstance(cf: Conform, typeRef: U64, traitArgs: Array[U64], traitArgsOpen: Bool = false) -> Result[Bool, CompileDiagnostic] {
        return <Result.Ok value=(try self.conformancePatternMatchesTraitInstance(subjectId: cf.typeId, subjectTy: cf.subjectTy, subjectArgs: <PatternTypeInput.Conformance range=cf.subjectArgs />, typeParams: <PatternBindInput.Conformance range=cf.typeParams />, declaredTraitArgs: <PatternTypeInput.Conformance range=cf.traitArgs />, typeRef: typeRef, traitArgs: <PatternTypeInput.Values values=traitArgs />, traitArgsOpen: traitArgsOpen)) />
    }

    inout fn conformanceWitnessMatch(conformIdx: U64, typeRef: U64, traitArgs: Array[U64], traitArgsOpen: Bool = false) -> Result[WitnessMatch, CompileDiagnostic] {
        if conformIdx >= self.decls.conformCount() { return <Result.Ok value=<WitnessMatch /> />}
        val cf: Conform = self.decls.conformAt(index: conformIdx)
        return <Result.Ok value=(try self.conformancePatternWitnessMatch(conformIdx: conformIdx, subjectId: cf.typeId, subjectTy: cf.subjectTy, subjectArgs: <PatternTypeInput.Conformance range=cf.subjectArgs />, typeParams: <PatternBindInput.Conformance range=cf.typeParams />, declaredTraitArgs: <PatternTypeInput.Conformance range=cf.traitArgs />, typeRef: typeRef, traitArgs: <PatternTypeInput.Values values=traitArgs />, traitArgsOpen: traitArgsOpen)) />
    }

    // Registration-side counterpart of `conformanceSubjectMatches`: two
    // declarations collide exactly when one substitution satisfies both their
    // subject and trait-argument patterns.
    inout fn conformancePatternsMayOverlap(a: Conform, b: Conform) -> Bool {
        if a.traitArgs.count() != b.traitArgs.count() { return false }
        mut val binds: Array[UnifyBind] = []
        val aParams: PatternBindInput = <PatternBindInput.Conformance range=a.typeParams />
        val bParams: PatternBindInput = <PatternBindInput.Conformance range=b.typeParams />
        if !(self.unifyPatterns(a: a.subjectTy, aSide: 0U64, b: b.subjectTy, bSide: 1U64, aParams: aParams, bParams: bParams, binds: inout binds, ignoreTopView: true)) { return false }
        mut val i: U64 = 0U64
        while i < a.traitArgs.count() {
            if !(self.unifyPatterns(a: self.conformTypeAt(types: a.traitArgs, index: i), aSide: 0U64, b: self.conformTypeAt(types: b.traitArgs, index: i), bSide: 1U64, aParams: aParams, bParams: bParams, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    // Directional form of the same relation: can `provider` satisfy every
    // instance denoted by `subject`?  Subject binders are deliberately rigid
    // (they are not supplied as unification variables), while provider
    // binders remain free.  Thus `Box[T]` covers `Box[I64]`, but `Box[I64]`
    // does not cover `Box[T]`; likewise `Pair[T, T]` does not cover
    // `Pair[U, V]`.
    inout fn conformanceSubjectCovers(provider: Conform, subject: Conform) -> Bool {
        if provider.subjectTy == 0U64 || subject.subjectTy == 0U64 {
            return provider.typeId == subject.typeId && provider.subjectArgs.count() == subject.subjectArgs.count()
        }
        mut val binds: Array[UnifyBind] = []
        return self.unifyPatterns(a: provider.subjectTy, aSide: 0U64, b: subject.subjectTy, bSide: 1U64, aParams: <PatternBindInput.Conformance range=provider.typeParams />, bParams: <PatternBindInput.Values values=[] />, binds: inout binds, ignoreTopView: true)
    }

    // Canonical ParamIds identify lexical variables across the whole comparison.
    // Receiver unification relates separate impl binders; trait-owned binders
    // already share their owner identity. Method-owned ParamIds remain distinct.
    // Never use the positional alpha-matcher above as a disjointness oracle.
    inout fn structuralBindingIndex(bindings: Array[StructuralBinding], paramId: U64) -> U64 {
        mut val index = 0U64
        while index < bindings.count() {
            if bindings[index].paramId == paramId { return index }
            index += 1U64
        }
        return bindings.count()
    }

    inout fn structuralVariable(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeTermCount() { return 0U64 }
        val term = self.arena.typeTermAt(index: ref)
        if term.paramId == 0U64 || term.assocNameId != 0U64 || term.hasTopLevelView() || term.isAny || term.isSendable || term.isDiverging || self.typeTermRefChildCount(ref: ref) != 0U64 { return 0U64 }
        return term.paramId
    }

    inout fn structuralOccurrence(paramId: U64, ref: U64, bindings: Array[StructuralBinding], depth: U64) -> StructuralOccurrence {
        if depth >= 128U64 { return <StructuralOccurrence.AnalysisLimit /> }
        if ref >= self.arena.typeTermCount() { return <StructuralOccurrence.Unproved /> }
        val variable = self.structuralVariable(ref: ref)
        if variable != 0U64 {
            if variable == paramId { return <StructuralOccurrence.Present /> }
            val index = self.structuralBindingIndex(bindings: bindings, paramId: variable)
            if index < bindings.count() { return self.structuralOccurrence(paramId: paramId, ref: bindings[index].term, bindings: bindings, depth: depth + 1U64) }
            return <StructuralOccurrence.Absent />
        }
        val term = self.arena.typeTermAt(index: ref)
        if term.assocNameId != 0U64 || term.paramId != 0U64 { return <StructuralOccurrence.Unproved /> }
        mut val result = <StructuralOccurrence.Absent />
        mut val index = 0U64
        while index < self.typeTermRefChildCount(ref: ref) {
            match self.structuralOccurrence(paramId: paramId, ref: self.typeTermRefChildRef(ref: ref, index: index), bindings: bindings, depth: depth + 1U64) {
                StructuralOccurrence.Present => { return <StructuralOccurrence.Present /> }
                StructuralOccurrence.AnalysisLimit => { return <StructuralOccurrence.AnalysisLimit /> }
                StructuralOccurrence.Unproved => { result = <StructuralOccurrence.Unproved /> }
                StructuralOccurrence.Absent => {}
            }
            index += 1U64
        }
        return result
    }

    // Finite first-order structural equality under a retained substitution.
    // Unknown projections never supply negative evidence. Nominal fields are
    // not expanded; records, function labels and associated arguments use the
    // canonical child traversal shared with type identity.
    inout fn structuralOverlap(a: U64, b: U64, bindings: inout Array[StructuralBinding], depth: U64) -> StructuralOverlap {
        if depth >= 128U64 { return <StructuralOverlap.AnalysisLimit /> }
        if a >= self.arena.typeTermCount() || b >= self.arena.typeTermCount() { return <StructuralOverlap.Unproved /> }
        if a == b { return <StructuralOverlap.Possible /> }
        val av = self.structuralVariable(ref: a)
        val bv = self.structuralVariable(ref: b)
        if av != 0U64 {
            val index = self.structuralBindingIndex(bindings: bindings, paramId: av)
            if index < bindings.count() { return self.structuralOverlap(a: bindings[index].term, b: b, bindings: inout bindings, depth: depth + 1U64) }
        }
        if bv != 0U64 {
            val index = self.structuralBindingIndex(bindings: bindings, paramId: bv)
            if index < bindings.count() { return self.structuralOverlap(a: a, b: bindings[index].term, bindings: inout bindings, depth: depth + 1U64) }
        }
        if av != 0U64 {
            if av == bv { return <StructuralOverlap.Possible /> }
            match self.structuralOccurrence(paramId: av, ref: b, bindings: bindings, depth: depth + 1U64) {
                StructuralOccurrence.Present => { return <StructuralOverlap.Disjoint /> }
                StructuralOccurrence.Unproved => { return <StructuralOverlap.Unproved /> }
                StructuralOccurrence.AnalysisLimit => { return <StructuralOverlap.AnalysisLimit /> }
                StructuralOccurrence.Absent => {}
            }
            bindings.append(<StructuralBinding paramId=av term=b />)
            return <StructuralOverlap.Possible />
        }
        if bv != 0U64 { return self.structuralOverlap(a: b, b: a, bindings: inout bindings, depth: depth + 1U64) }
        val left = self.arena.typeTermAt(index: a)
        val right = self.arena.typeTermAt(index: b)
        if left.assocNameId != 0U64 || right.assocNameId != 0U64 || left.paramId != 0U64 || right.paramId != 0U64 { return <StructuralOverlap.Unproved /> }
        if !self.typeTermRefSameHead(a: a, b: b) { return <StructuralOverlap.Disjoint /> }
        val count = self.typeTermRefChildCount(ref: a)
        if count != self.typeTermRefChildCount(ref: b) { return <StructuralOverlap.Disjoint /> }
        mut val result = <StructuralOverlap.Possible />
        mut val index = 0U64
        while index < count {
            if self.typeTermRefIdentityChildLabel(ref: a, index: index) != self.typeTermRefIdentityChildLabel(ref: b, index: index) { return <StructuralOverlap.Disjoint /> }
            match self.structuralOverlap(a: self.typeTermRefChildRef(ref: a, index: index), b: self.typeTermRefChildRef(ref: b, index: index), bindings: inout bindings, depth: depth + 1U64) {
                StructuralOverlap.Disjoint => { return <StructuralOverlap.Disjoint /> }
                StructuralOverlap.AnalysisLimit => { return <StructuralOverlap.AnalysisLimit /> }
                StructuralOverlap.Unproved => { result = <StructuralOverlap.Unproved /> }
                StructuralOverlap.Possible => {}
            }
            index += 1U64
        }
        return result
    }

    // Declaration acceptance, not call applicability or pattern unification.
    // Normalize only this declaration's Self and retained signature equalities;
    // never borrow a caller/body cursor or substitute prospective call arguments.
    inout fn callableAdmissionTypes(function: Func) -> Result[Array[U64], CompileDiagnostic] {
        mut val types: Array[U64] = []
        mut val index = 0U64
        while index < function.params.count() {
            val parameter = self.funcParamAt(params: function.params, index: index)
            mut val term = parameter.ty
            if !self.arena.typeIsClosed(ref: term) {
                term = self.groundTermInEnvironment(ref: term, params: [], values: [], selfRef: function.recvTy)
                if self.arena.typeContainsAssociatedProjection(ref: term) {
                    mut val boundIndex = 0U64
                    while boundIndex < function.signatureBounds.len {
                        val clause = self.conformBoundAt(bounds: function.signatureBounds, index: boundIndex)
                        val bound = <TraitBound subject=clause.subject constraint=clause.constraint offset=clause.offset />
                        val traitIndex = self.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
                        if traitIndex < self.decls.traitCount() {
                            term = self.traitBoundTypeTerm(ref: term, bound: bound, traitIndex: traitIndex)
                        }
                        boundIndex += 1U64
                    }
                }
            }
            types.append(term)
            index += 1U64
        }
        return <Result.Ok value=types />
    }

    // Search common selectors of the two default-omission automata. Matching a
    // structurally disjoint argument discharges that path. Each position starts
    // from receiver bindings, never substitutions from other argument positions.
    inout fn combineStructuralAlternatives(a: StructuralOverlap, b: StructuralOverlap) -> StructuralOverlap {
        match a {
            StructuralOverlap.Possible => { return a }
            StructuralOverlap.AnalysisLimit => { return a }
            _ => {}
        }
        match b {
            StructuralOverlap.Possible => { return b }
            StructuralOverlap.AnalysisLimit => { return b }
            _ => {}
        }
        match a { StructuralOverlap.Unproved => { return a } _ => {} }
        return b
    }

    inout fn callableFormsConflictAt(a: Func, b: Func, aTypes: Array[U64], bTypes: Array[U64], receiverBindings: Array[StructuralBinding], ai: U64, bi: U64, memo: inout Dictionary[U64, StructuralOverlap]) -> Result[StructuralOverlap, CompileDiagnostic] {
        val key = ai * (b.params.count() + 1U64) + bi
        match memo.get(key: key) {
            Optional.Some(v: val result) => { return <Result.Ok value=result /> }
            Optional.None => {}
        }
        val result = try self.callableFormsConflictUncached(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: ai, bi: bi, memo: inout memo)
        memo[key] = result
        return <Result.Ok value=result />
    }

    inout fn callableFormsConflictUncached(a: Func, b: Func, aTypes: Array[U64], bTypes: Array[U64], receiverBindings: Array[StructuralBinding], ai: U64, bi: U64, memo: inout Dictionary[U64, StructuralOverlap]) -> Result[StructuralOverlap, CompileDiagnostic] {
        if ai == a.params.count() && bi == b.params.count() { return <Result.Ok value=<StructuralOverlap.Possible /> /> }
        if ai == a.params.count() {
            if !self.funcParamAt(params: b.params, index: bi).hasDefault { return <Result.Ok value=<StructuralOverlap.Disjoint /> /> }
            return self.callableFormsConflictAt(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: ai, bi: bi + 1U64, memo: inout memo)
        }
        if bi == b.params.count() {
            if !self.funcParamAt(params: a.params, index: ai).hasDefault { return <Result.Ok value=<StructuralOverlap.Disjoint /> /> }
            return self.callableFormsConflictAt(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: ai + 1U64, bi: bi, memo: inout memo)
        }
        val ap = self.funcParamAt(params: a.params, index: ai)
        val bp = self.funcParamAt(params: b.params, index: bi)
        mut val result = <StructuralOverlap.Disjoint />
        if ap.noLabel == bp.noLabel && (ap.noLabel || ap.nameId == bp.nameId) {
            mut val trial = receiverBindings
            val comparison = self.structuralOverlap(a: aTypes[ai], b: bTypes[bi], bindings: inout trial, depth: 0U64)
            match comparison {
                StructuralOverlap.AnalysisLimit => { return <Result.Err error=self.diagnosticAt(offset: bp.nameStart, msg: "overload argument structural analysis limit exceeded") /> }
                StructuralOverlap.Disjoint => {}
                _ => {
                    result = try self.callableFormsConflictAt(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: ai + 1U64, bi: bi + 1U64, memo: inout memo)
                    match comparison {
                        StructuralOverlap.Unproved => { match result { StructuralOverlap.Possible => { result = <StructuralOverlap.Unproved /> } _ => {} } }
                        _ => {}
                    }
                }
            }
        }
        if ap.hasDefault {
            val skipped = try self.callableFormsConflictAt(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: ai + 1U64, bi: bi, memo: inout memo)
            result = self.combineStructuralAlternatives(a: result, b: skipped)
        }
        if bp.hasDefault {
            val skipped = try self.callableFormsConflictAt(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: ai, bi: bi + 1U64, memo: inout memo)
            result = self.combineStructuralAlternatives(a: result, b: skipped)
        }
        return <Result.Ok value=result />
    }

    // One complete ordinary-overload decision for all declaration entries.
    // Domain/origin participation is supplied by the entry; receiver domains
    // are retained as explicit constraints for every argument-position query.
    inout fn callableDeclarationConflict(a: Func, b: Func) -> Result[Bool, CompileDiagnostic] {
        if a.nameId != b.nameId { return <Result.Ok value=false /> }
        mut val receiverBindings: Array[StructuralBinding] = []
        if a.hasRecv || a.isAssoc {
            val comparison = self.structuralOverlap(a: self.typeRefWithoutOuterViews(ref: a.recvTy), b: self.typeRefWithoutOuterViews(ref: b.recvTy), bindings: inout receiverBindings, depth: 0U64)
            match comparison {
                StructuralOverlap.Disjoint => { return <Result.Ok value=false /> }
                StructuralOverlap.Unproved => { return <Result.Err error=self.diagnosticAt(offset: b.defOffset, msg: "cannot prove overload receiver domain compatibility: unresolved type structure") /> }
                StructuralOverlap.AnalysisLimit => { return <Result.Err error=self.diagnosticAt(offset: b.defOffset, msg: "overload receiver structural analysis limit exceeded") /> }
                StructuralOverlap.Possible => {}
            }
        }
        val aTypes = try self.callableAdmissionTypes(function: a)
        val bTypes = try self.callableAdmissionTypes(function: b)
        mut val memo: Dictionary[U64, StructuralOverlap] = [:]
        match try self.callableFormsConflictAt(a: a, b: b, aTypes: aTypes, bTypes: bTypes, receiverBindings: receiverBindings, ai: 0U64, bi: 0U64, memo: inout memo) {
            StructuralOverlap.Possible => { return <Result.Ok value=true /> }
            StructuralOverlap.Disjoint => { return <Result.Ok value=false /> }
            StructuralOverlap.Unproved => { return <Result.Err error=self.diagnosticAt(offset: b.defOffset, msg: "cannot prove overload argument types distinct: unresolved type structure") /> }
            StructuralOverlap.AnalysisLimit => { return <Result.Err error=self.diagnosticAt(offset: b.defOffset, msg: "overload structural analysis limit exceeded") /> }
        }
    }

    inout fn checkFuncRegistration(f: Func, sourceModule: U64, before: U64) -> Result[(), CompileDiagnostic] {
        mut val i: U64 = self.decls.firstCallableNamed(nameId: f.nameId)
        while i < self.decls.callableCount() {
            val priorEntry: Callable = self.decls.callableAt(index: i)
            val prior: Func = self.arena.functionAt(index: priorEntry.funcIdx)
            if priorEntry.funcIdx < before && !prior.isProvided {
                // A bare declaration namespace is module-owned.  A named
                // extension is instead its own bundle: `#Ext` carries no module
                // qualifier at a call site, so every declaration named Ext must
                // enter this one collision domain even when loaded from another
                // module.
                val sameNamespace: Bool = (prior.extId != 0U64 && prior.extId == f.extId) || priorEntry.sourceModule == sourceModule
                if sameNamespace {
                    if self.sameFuncCandidateBucket(a: prior, b: f) {
                        // Raw foreign/intrinsic functions have one linker symbol,
                        // not a Plew overload family. Their name collision is a
                        // registration collision before selector matching.
                        if !(f.hasRecv || f.isAssoc) && prior.nameId == f.nameId && (prior.isExtern || f.isExtern) {
                            return <Result.Err error=self.diagnosticAt(offset: f.defOffset, msg: "duplicate function name: extern declarations and ordinary functions share one top-level namespace in a module") />
                        }
                        if try self.callableDeclarationConflict(a: prior, b: f) {
                            return <Result.Err error=self.diagnosticAt(offset: f.defOffset, msg: "duplicate or overlapping callable form in one declaration namespace: no provably distinct argument type (spec/04,07,09)") />
                        }
                    }
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return <Result.Ok value=() />
    }

    // A trait-provided method is copied to each concrete conformer after source
    // declarations have been registered.  In a named extension that copy shares the
    // bundle's callable surface with direct members, whereas on the bare surface an
    // inherent member is intentionally the default.  Check this *post-conformance*
    // form: the original receivers (`Trait` and `Sample`) cannot reveal the collision.
    inout fn checkProvidedExtensionSurfaceCollision(f: Func) -> Result[(), CompileDiagnostic] {
        if !(f.isProvided) || f.extId == 0U64 {
            return <Result.Ok value=() />
        }
        mut val i: U64 = self.decls.firstCallableNamed(nameId: f.nameId)
        while i < self.decls.callableCount() {
            val prior: Func = self.arena.functionAt(index: self.decls.callableAt(index: i).funcIdx)
            if !(prior.isProvided) && prior.extId == f.extId && prior.nameId == f.nameId {
                if self.sameFuncCandidateBucket(a: prior, b: f) {
                    if try self.callableDeclarationConflict(a: prior, b: f) {
                        return <Result.Err error=self.diagnosticAt(offset: f.defOffset, msg: "direct and trait-provided members overlap on one extension surface; selectability cannot distinguish them (spec/09)") />
                    }
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return <Result.Ok value=() />
    }

    inout fn registerDeclaredFunc(f: Func, registerSurface: Bool = true) -> Result[U64, CompileDiagnostic] {
        if f.isExposed {
            if f.hasRecv || f.isAssoc {
                return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "expose requires a free function; methods and associated functions cannot be exposed") />
            }
            if f.isAsync {
                return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "expose requires a synchronous function") />
            }
            if f.typeParams.len != 0U64 {
                return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "expose requires a nongeneric function") />
            }
            // The program entry owns the external main symbol and has the OS
            // entry ABI, rather than the source function's C-compatible ABI.
            if self.nameIsMain(f: f) {
                return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "exposed name conflicts with the program entry symbol `main`") />
            }
            mut val parameterIndex = 0U64
            while parameterIndex < f.params.count() {
                val parameter = self.funcParamAt(params: f.params, index: parameterIndex)
                if !parameter.noLabel {
                    return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "expose requires every parameter to be unlabeled (`~`)") />
                }
                parameterIndex += 1U64
            }
            mut val previous = self.arena.firstFunctionNamed(nameId: f.nameId)
            while previous < self.arena.functionCount() {
                if self.arena.functionAt(index: previous).isExposed {
                    return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "duplicate exposed function name") />
                }
                previous = self.arena.nextFunctionNamed(index: previous)
            }
        }
        val idx: U64 = self.arena.functionCount()
        self.arena.registerFunction(f, registerSurface: registerSurface)
        mut val boundIndex = 0U64
        while boundIndex < f.signatureBounds.len {
            val bound = self.conformBoundAt(bounds: f.signatureBounds, index: boundIndex)
            val subject = self.arena.typeAt(index: bound.subject)
            self.decls.funcBounds.append(<FuncBound fnIdx=idx paramStart=subject.nameStart paramLen=subject.nameLen paramNameId=subject.nameId paramTy=bound.subject constraint=bound.constraint />)
            boundIndex += 1U64
        }
        if registerSurface { try self.registerCallable(funcIdx: idx, checkCollisions: true) }
        return <Result.Ok value=idx />
    }

    // The only entrance to the resolver's surface table. Derived provided
    // methods call this after their body record is appended; source selection is
    // therefore represented once, instead of reconstructed separately by # calls.
    inout fn registerCallable(funcIdx: U64, checkCollisions: Bool = false) -> Result[(), CompileDiagnostic] {
        if funcIdx >= self.arena.functionCount() { return <Result.Ok value=() /> }
        val f: Func = self.arena.functionAt(index: funcIdx)
        val sourceModule = self.funcDeclModule(f: f)
        // Source declarations cannot enter a surface which already has a
        // call-indistinguishable candidate.  Provided copies are synthesized
        // dispatch artifacts; their source trait is selected separately and
        // therefore deliberately bypass this source-declaration check.
        if self.arena.typeDeclarationResolutionComplete() {
            if checkCollisions { try self.checkFuncRegistration(f: f, sourceModule: sourceModule, before: funcIdx) }
            try self.checkProvidedExtensionSurfaceCollision(f: f)
        }
        mut val sourceKind: U64 = 0U64
        mut val sourceId: U64 = 0U64
        mut val sourceOwner: U64 = 0U64
        mut val sourceArity: U64 = 0U64
        mut val traitId: U64 = f.srcTraitId
        mut val traitOwner: U64 = f.srcTraitOwner
        mut val traitArity: U64 = f.provTraitArity
        if traitId != 0U64 && traitOwner == 0U64 {
            traitOwner = f.provTraitOwner
        }
        if f.extId != 0U64 {
            sourceKind = 1U64
            sourceId = f.extId
            // An extension name is one bundle across loaded modules (and is
            // collision-checked as such), so its interned bundle id is stable.
            sourceOwner = f.extId
        } else if f.srcTraitId != 0U64 {
            sourceKind = 2U64
            sourceId = f.srcTraitId
            sourceArity = f.provTraitArity
            sourceOwner = f.srcTraitOwner
            if sourceOwner == 0U64 { sourceOwner = f.provTraitOwner }
        }
        self.decls.registerCallable(<Callable funcIdx=funcIdx sourceKind=sourceKind sourceId=sourceId sourceOwner=sourceOwner sourceArity=sourceArity traitId=traitId traitOwner=traitOwner traitArity=traitArity sourceModule=sourceModule requiresDeclarationAdmission=checkCollisions />, nameId: f.nameId, nameCount: self.interner.entries.count())
        return <Result.Ok value=() />
    }

    inout fn checkCallableDeclarationAdmission() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.decls.callableCount() {
            val candidate = self.decls.callableAt(index: index)
            val function = self.arena.functionAt(index: candidate.funcIdx)
            if candidate.requiresDeclarationAdmission {
                try self.checkFuncRegistration(f: function, sourceModule: candidate.sourceModule, before: candidate.funcIdx)
            }
            try self.checkProvidedExtensionSurfaceCollision(f: function)
            index += 1U64
        }
        try self.checkDuplicateTraitReqs()
        try self.checkMemberwiseFactoryCollisions()
        return <Result.Ok value=() />
    }

    inout fn callableIsBare(c: Callable) -> Bool {
        return c.sourceKind == 0U64
    }

    inout fn callableSourceKey(c: Callable) -> ViewSource {
        return <ViewSource kind=c.sourceKind id=c.sourceId owner=c.sourceOwner arity=c.sourceArity />
    }

    inout fn sameViewSource(a: ViewSource, b: ViewSource) -> Bool {
        return a.kind == b.kind && a.id == b.id && a.owner == b.owner && a.arity == b.arity
    }

    inout fn callableMatchesSource(c: Callable, source: ViewSource) -> Bool {
        return source.kind != 0U64 && self.sameViewSource(a: self.callableSourceKey(c: c), b: source)
    }

    inout fn callableTraitKey(c: Callable) -> ViewSource {
        return <ViewSource kind=2U64 id=c.traitId owner=c.traitOwner arity=c.traitArity />
    }

    inout fn callableMatchesTrait(c: Callable, source: ViewSource) -> Bool {
        return c.traitId != 0U64 && source.kind == 2U64 && self.sameViewSource(a: self.callableTraitKey(c: c), b: source)
    }

    // Candidate de-duplication is stricter than source selection.  `#E` names
    // one extension bundle, but E may intentionally expose distinct A- and
    // B-provided members that only `#E#A` / `#E#B` can distinguish.  They are
    // two candidates under E, not duplicate witnesses.  Only copies of the
    // same source *and* trait provenance denote one semantic callable.
    inout fn sameCallableSemanticOrigin(a: Callable, b: Callable) -> Bool {
        return self.sameViewSource(a: self.callableSourceKey(c: a), b: self.callableSourceKey(c: b)) && self.sameViewSource(a: self.callableTraitKey(c: a), b: self.callableTraitKey(c: b))
    }

    // Match a call receiver against the declaration's complete receiver pattern.
    // A generic impl such as Box[T] is a pattern, whereas Box[I64] is exact.
    // A trait-receiver *provided copy* is different: it may be declared on B
    // while the selected concrete receiver is S, justified by S: B. Ask the
    // same full-instance predicate used for extension applicability. A direct
    // conformance method is instead the implementation witness for B itself;
    // its visibility on S is represented by the separately registered copy.
    // Letting that witness match every S: B duplicates the copy (and turns one
    // proof into an ambiguity). Calls without a recovered TypeRef retain the
    // legacy head-name fallback.
    inout fn callableReceiverMatches(f: Func, recvId: U64, recvRef: U64) -> Result[Bool, CompileDiagnostic] {
        // A trait-subject origin needs its full path proof: the copied
        // receiver surface B is not the target trait A of `impl B as A`.
        // Direct origins intentionally retain the established direct-witness
        // predicate below; replacing them with a broader path search changes
        // their body environment and can conflate independent witnesses.
        mut val originIsTraitSubject: Bool = false
        if f.isProvided && f.originConformIdx != 0U64 {
            val ci: U64 = f.originConformIdx - 1U64
            if ci < self.decls.conformCount() {
                val origin: Conform = self.decls.conformAt(index: ci)
                originIsTraitSubject = origin.subjectTraitOwner != 0U64
            }
        }
        if originIsTraitSubject && recvRef != 0U64 {
            // Candidate provenance fixes the proof's source and placement.
            // Find matching completed paths before deciding their uniqueness.
            val proof = try self.providedBodyProof(f: f, receiverRef: recvRef)
            // The shared interpreter validated both distinct edge identities
            // and this candidate's complete receiver before publishing proof.
            return <Result.Ok value=!self.proofIsMissing(proof: proof) />
        }
        if f.recvId != recvId {
            if f.isProvided && self.methodRecvIsTrait(f: f) && recvRef != 0U64 {
                return <Result.Ok value=(try self.conformsInstance(demand: <ConformanceProofDemand.Existence />, ref: recvRef, traitStart: f.recvStart, traitLen: f.recvLen, traitArgs: self.copyFuncTypes(types: f.recvTraitArgs))) />
            }
            return <Result.Ok value=false />
        }
        if recvRef == 0U64 || f.recvTy == 0U64 { return <Result.Ok value=true />}
        if recvRef >= self.arena.typeCount() || f.recvTy >= self.arena.typeCount() { return <Result.Ok value=true />}
        mut val binds: Array[UnifyBind] = []
        mut val patternParams: Array[Bind] = self.copyFuncBinds(binds: f.typeParams)
        if f.recvPatternParams.count() > 0U64 { patternParams = self.copyFuncBinds(binds: f.recvPatternParams) }
        return <Result.Ok value=self.unifyPatterns(a: f.recvTy, aSide: 0U64, b: recvRef, bSide: 1U64, aParams: <PatternBindInput.Values values=patternParams />, bParams: <PatternBindInput.Values values=[] />, binds: inout binds, ignoreTopView: true) />
    }

    inout fn sameTypeRefListAlphaEq(a: Array[U64], b: Array[U64], aParams: Array[Bind], bParams: Array[Bind]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0
        while i < a.count() {
            if !(self.typeRefsAlphaEq(a: a[i], b: b[i], aParams: aParams, bParams: bParams)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn checkConformanceRegistration(cf: Conform) -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0
        while i < self.decls.conformCount() {
            val prior: Conform = self.decls.conformAt(index: i)
            if !prior.derived {
                // As with methods, a named extension is one source-selectable
                // bundle, not one bundle per defining module.  Its conformance
                // key must therefore be unique across all of its parts.
                val sameNamespace: Bool = (prior.extId != 0U64 && prior.extId == cf.extId) || prior.sourceModule == cf.sourceModule
                if sameNamespace {
                    if prior.extId == cf.extId && prior.traitId == cf.traitId && prior.traitStart == cf.traitStart && prior.typeId == cf.typeId && prior.subjectArgs.count() == cf.subjectArgs.count() {
                        // A conformance is a callable-like source surface: its
                        // subject and trait arguments share one substitution.
                        // Alpha equality is insufficient (`Box[T]` overlaps
                        // `Box[I64]`), so use the same pattern unifier as
                        // callable-form registration.
                        if self.conformancePatternsMayOverlap(a: prior, b: cf) {
                            return <Result.Err error=self.diagnosticAt(offset: cf.defOffset, msg: "duplicate or overlapping trait conformance in one declaration namespace (spec/08,09)") />
                        }
                    }
                }
            }
            i += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn registerDeclaredConformance(cf: Conform) -> Result[(), CompileDiagnostic] {
        try self.checkConformanceRegistration(cf: cf)
        self.decls.registerConform(cf)
        return <Result.Ok value=() />
    }

}
