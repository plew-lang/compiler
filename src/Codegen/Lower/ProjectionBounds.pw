// Source clauses are reserved together, then lowered once in their original
// declaration frame. Uses carry clause IDs instead of authoring their AST again.
impl Comp {
    fn projectionBoundParameterIds() -> Array[U64] {
        mut val parameters: Array[U64] = []
        for parameter in self.cur.typeParams { parameters.append(parameter.paramId) }
        return parameters
    }

    inout fn reserveValueProjectionBounds(parameters: Array[String], traits: Array[String], subjects: Array[TypeAst], traitTypes: Array[TypeAst], anchor: U64, inherited: SourceBoundRange = <SourceBoundRange />) -> Result[(), CompileDiagnostic] {
        val first = self.projectionBoundClauses.count() + 1U64
        val binders = self.projectionBoundParameterIds()
        mut val index = 0U64
        while index < parameters.count() {
            if index >= traits.count() { return <Result.Err error=self.diagnosticAt(offset: anchor, msg: "source bound names are misaligned", failureDomain: <FailureDomain.Input />) /> }
            val name = self.internBytes(s: parameters[index])
            val subject = if index < subjects.count() { give subjects[index] } else { give <TypeAst name=parameters[index] args=[] span=<Span start=anchor end=anchor /> /> }
            val traitType = if index < traitTypes.count() { give traitTypes[index] } else { give <TypeAst name=traits[index] args=[] span=<Span start=anchor end=anchor /> /> }
            self.projectionBoundClauses.append(<ProjectionBoundClause scope=self.sourceTypeUses.currentScope() parameters=binders syntax=<ProjectionBoundSyntax.Value subject=subject traitType=traitType parameter=name /> syntheticSubject=index >= subjects.count() />)
            index += 1U64
        }
        return self.useProjectionBounds(own: <SourceBoundRange first=first count=index />, inherited: inherited)
    }

    inout fn reserveSyntaxProjectionBounds(declaration: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        val first = self.projectionBoundClauses.count() + 1U64
        val parameters = self.projectionBoundParameterIds()
        mut val index = 0U64
        while index < syntaxDeclWhereCount(file: self.syntax, decl: declaration) {
            self.reserveSyntaxProjectionClause(subject: syntaxDeclWhereType(file: self.syntax, decl: declaration, index: index), traitType: syntaxDeclWhereTraitType(file: self.syntax, decl: declaration, index: index), parameter: syntaxDeclWhereParamSpan(file: self.syntax, decl: declaration, index: index), parameters: parameters)
            index += 1U64
        }
        return self.useProjectionBounds(own: <SourceBoundRange first=first count=index />)
    }

    inout fn reserveSyntaxProjectionClause(subject: TypeId, traitType: TypeId, parameter: Span, parameters: Array[U64]) {
        self.projectionBoundClauses.append(<ProjectionBoundClause scope=self.sourceTypeUses.currentScope() parameters=parameters syntax=<ProjectionBoundSyntax.Syntax subject=subject traitType=traitType parameter=parameter /> />)
    }

    inout fn useProjectionBounds(own: SourceBoundRange, inherited: SourceBoundRange = <SourceBoundRange />) -> Result[(), CompileDiagnostic] {
        if !self.sourceTypeUses.bindBounds(range: own) {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid source bound declaration owner", failureDomain: <FailureDomain.Internal />) />
        }
        self.activeProjectionBounds = <Optional.Some v=<ProjectionBoundContext own=own inherited=inherited /> />
        mut val index = 0U64
        while index < own.count {
            try self.preparedProjectionBound(id: own.first + index)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn preparedProjectionBound(id: U64, requestSite: Optional[U64] = <Optional.None />) -> Result[PreparedProjectionBound, CompileDiagnostic] {
        if id == 0U64 || id > self.projectionBoundClauses.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid source bound clause", failureDomain: <FailureDomain.Internal />) /> }
        val saved = self.projectionBoundClauses[id - 1U64]
        val active = self.sourceTypeUses.projectionBoundScope()
        if active == 0U64 || saved.scope == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound clause has no declaration owner", failureDomain: <FailureDomain.Internal />) />
        }
        if saved.scope != self.sourceTypeUses.currentScope() {
            val current = self.sourceTypeUses.scopeAt(token: active)
            if saved.scope != active && (!current.isSome() || current.unwrap().parent != saved.scope) {
                return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "foreign source bound clause", failureDomain: <FailureDomain.Internal />) />
            }
            match saved.state {
                ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound /> }
                _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "parent source bound was not prepared", failureDomain: <FailureDomain.Internal />) /> }
            }
        }
        match saved.state {
            ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound /> }
            ProjectionBoundState.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            ProjectionBoundState.Lowering => { return <Result.Err error=self.diagnosticAt(offset: requestSite.unwrapOr(fallback: self.sourceTypeUses.scopeAt(token: saved.scope).unwrap().anchor), msg: "associated-type short projection analysis limit exceeded", failureDomain: <FailureDomain.Limit />) /> }
            ProjectionBoundState.Unlowered => {}
        }
        val clause = saved
        if clause.scope != self.sourceTypeUses.currentScope() || clause.parameters.count() != self.cur.typeParams.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound must be prepared in its original declaration", failureDomain: <FailureDomain.Internal />) /> }
        mut val index = 0U64
        while index < clause.parameters.count() {
            if clause.parameters[index] != self.cur.typeParams[index].paramId { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound has a foreign lexical binder", failureDomain: <FailureDomain.Internal />) /> }
            index += 1U64
        }
        match self.sourceTypeUses.currentRole() {
            SourceTypeUseRole.Declaration => {}
            _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound must be prepared before parameter defaults and bodies", failureDomain: <FailureDomain.Internal />) /> }
        }
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject subject=clause.subject head=clause.head state=<ProjectionBoundState.Lowering /> />
        val result = self.lowerProjectionBoundClause(id: id, clause: clause)
        val state = match result {
            Result.Ok(value: val bound) => <ProjectionBoundState.Ready bound=bound />,
            Result.Err(error: val diagnostic) => <ProjectionBoundState.Failed diagnostic=diagnostic />,
        }
        val completed = self.projectionBoundClauses[id - 1U64]
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject subject=completed.subject head=completed.head state=state />
        if result.isOk() { self.recordBoundTypeDeclarationRoots(clause: id) }
        return result
    }

    // Subject identity is a separate prerequisite of the constraint RHS.
    // Preserve its exact occurrence and propagate genuine subject recursion.
    inout fn preparedProjectionSubject(id: U64) -> Result[PreparedProjectionSubject, CompileDiagnostic] {
        if id == 0U64 || id > self.projectionBoundClauses.count() { return <Result.Err error=self.associatedMemberInputFailure(message: "source bound has an invalid subject owner") /> }
        val clause = self.projectionBoundClauses[id - 1U64]
        if clause.scope == 0U64 || self.sourceTypeUses.projectionBoundScope() == 0U64 { return <Result.Err error=self.associatedMemberInputFailure(message: "source bound subject has no declaration frame") /> }
        if clause.scope != self.sourceTypeUses.currentScope() {
            val active = self.sourceTypeUses.projectionBoundScope()
            val current = self.sourceTypeUses.scopeAt(token: active)
            if clause.scope != active && (!current.isSome() || current.unwrap().parent != clause.scope) { return <Result.Err error=self.associatedMemberInputFailure(message: "foreign source bound subject") /> }
            match clause.subject {
                ProjectionBoundSubjectState.Ready(subject: val subject) => { return <Result.Ok value=subject /> }
                _ => { return <Result.Err error=self.associatedMemberInputFailure(message: "parent source bound subject was not prepared") /> }
            }
        }
        match clause.subject {
            ProjectionBoundSubjectState.Ready(subject: val subject) => { return <Result.Ok value=subject /> }
            ProjectionBoundSubjectState.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            ProjectionBoundSubjectState.Lowering => { return <Result.Err error=self.associatedMemberLimit(site: self.sourceTypeUses.scopeAt(token: clause.scope).unwrap().anchor) /> }
            ProjectionBoundSubjectState.Unlowered => {}
        }
        if clause.scope != self.sourceTypeUses.currentScope() || clause.parameters.count() != self.cur.typeParams.count() { return <Result.Err error=self.associatedMemberInputFailure(message: "source bound subject must be prepared in its original declaration") /> }
        for index in 0U64..<clause.parameters.count() { if clause.parameters[index] != self.cur.typeParams[index].paramId { return <Result.Err error=self.associatedMemberInputFailure(message: "source bound subject has a foreign binder") /> } }
        match self.sourceTypeUses.currentRole() { SourceTypeUseRole.Declaration => {} _ => { return <Result.Err error=self.associatedMemberInputFailure(message: "source bound subject must be prepared before defaults and bodies") /> } }
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject subject=<ProjectionBoundSubjectState.Lowering /> head=clause.head state=clause.state />
        val result = self.lowerProjectionBoundSubject(clause: clause)
        val state = match result { Result.Ok(value: val subject) => <ProjectionBoundSubjectState.Ready subject=subject /> Result.Err(error: val diagnostic) => <ProjectionBoundSubjectState.Failed diagnostic=diagnostic /> }
        val current = self.projectionBoundClauses[id - 1U64]
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject subject=state head=current.head state=current.state />
        return result
    }
    inout fn lowerProjectionBoundSubject(clause: ProjectionBoundClause) -> Result[PreparedProjectionSubject, CompileDiagnostic] {
        val lowered = match clause.syntax {
            ProjectionBoundSyntax.Value(subject: val subject, traitType: _, parameter: _) => {
                give if clause.syntheticSubject { give try self.lowerTypeCore(t: (try self.normalizeProjectionType(t: subject))) }
                else { give try self.lowerType(t: subject) }
            }
            ProjectionBoundSyntax.Syntax(subject: val subject, traitType: _, parameter: _) => (try self.lowerSyntaxType(id: subject))
        }
        val recipe = if clause.syntheticSubject { give 0U64 } else { give try self.authoredChildRecipe(type: lowered) }
        return <Result.Ok value=<PreparedProjectionSubject term=lowered.ref recipe=recipe /> />
    }
    inout fn lowerProjectionBoundClause(id: U64, clause: ProjectionBoundClause) -> Result[PreparedProjectionBound, CompileDiagnostic] {
        val loweredSubject = try self.preparedProjectionSubject(id: id)
        match clause.syntax {
            ProjectionBoundSyntax.Value(subject: _, traitType: val traitType, parameter: val parameter) => {
                val type = try self.normalizeProjectionType(t: traitType)
                val head = try self.projectionBoundDeclaredHead(id: id)
                val lowered = try self.lowerValueTraitConstraint(traitType: type, owner: head.traitInstance.owner, site: head.writtenStart)
                return <Result.Ok value=<PreparedProjectionBound source=head.withArguments(arguments: lowered.constraint.key.positionalArgs) subject=loweredSubject.term constraint=lowered.constraint arguments=lowered.arguments subjectRecipe=loweredSubject.recipe predicateRecipes=lowered.predicateRecipes parameter=parameter /> />
            }
            ProjectionBoundSyntax.Syntax(subject: _, traitType: val traitType, parameter: val parameter) => {
                val type = try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: traitType))
                val head = try self.projectionBoundDeclaredHead(id: id)
                val lowered = try self.lowerSyntaxTraitConstraint(traitType: type, owner: head.traitInstance.owner, site: head.writtenStart)
                return <Result.Ok value=<PreparedProjectionBound source=head.withArguments(arguments: lowered.constraint.key.positionalArgs) subject=loweredSubject.term constraint=lowered.constraint arguments=lowered.arguments subjectRecipe=loweredSubject.recipe predicateRecipes=lowered.predicateRecipes parameter=<Bind nameStart=parameter.start nameLen=parameter.end - parameter.start nameId=intern(c: inout self, start: parameter.start, len: parameter.end - parameter.start) fieldStart=0U64 fieldLen=0U64 /> /> />
            }
        }
    }

    inout fn appendPreparedFunctionBounds(function: U64) -> Result[(), CompileDiagnostic] {
        mut val bounds: Array[FuncBound] = []
        try self.collectPreparedFunctionBounds(function: function, into: inout bounds)
        self.publishFunctionBounds(bounds: bounds)
        return <Result.Ok value=() />
    }

    inout fn publishFunctionBounds(bounds: Array[FuncBound]) {
        for val bound in bounds { self.decls.funcBounds.append(bound) }
    }

    inout fn collectPreparedFunctionBounds(function: U64, into: inout Array[FuncBound]) -> Result[(), CompileDiagnostic] {
        val context = self.activeProjectionBounds.unwrap()
        try self.collectPreparedFunctionBoundRange(function: function, range: context.own, into: inout into)
        return self.collectPreparedFunctionBoundRange(function: function, range: context.inherited, into: inout into)
    }

    inout fn collectPreparedFunctionBoundRange(function: U64, range: SourceBoundRange, into: inout Array[FuncBound]) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < range.count {
            val id = range.first + index
            val bound = try self.preparedProjectionBound(id: id)
            into.append(<FuncBound fnIdx=function sourceClause=id paramStart=bound.parameter.nameStart paramLen=bound.parameter.nameLen paramTy=bound.subject paramNameId=bound.parameter.nameId constraint=bound.constraint />)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    // Namespace identity is independent of preparation success. This reader
    // lets dependency filtering precede consumption of a clause's state.
    inout fn projectionBoundDeclaredHead(id: U64) -> Result[ResolvedViewSource, CompileDiagnostic] {
        if id == 0U64 || id > self.projectionBoundClauses.count() { return <Result.Err error=self.associatedMemberInputFailure(message: "source bound has an invalid declared head") /> }
        val clause = self.projectionBoundClauses[id - 1U64]
        match clause.head { Optional.Some(v: val head) => { return <Result.Ok value=head /> } Optional.None => {} }
        match clause.state { ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound.source /> } _ => {} }
        val source = match clause.syntax {
            ProjectionBoundSyntax.Value(subject: _, traitType: val traitType, parameter: _) => {
                val type = try self.normalizeProjectionType(t: traitType)
                give try self.valueWhereTraitHead(traitType: type, origin: <Optional.Some v=self.sourceTypeUses.scopeAt(token: clause.scope).unwrap().anchor />)
            }
            ProjectionBoundSyntax.Syntax(subject: _, traitType: val traitType, parameter: _) => {
                val type = try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: traitType))
                give try self.syntaxWhereTraitHead(traitType: type)
            }
        }
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject subject=clause.subject head=<Optional.Some v=source /> state=clause.state />
        return <Result.Ok value=source />
    }

    inout fn appendAssociatedSelectionContext(context: PreparedAssociatedSelectionContext, bounds: inout Array[TraitBound], clauses: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        if context.bounds.count() != context.clauses.count() { return <Result.Err error=self.associatedMemberInputFailure(message: "associated context lost its source identities") /> }
        for index in 0U64..<context.clauses.count() {
            mut val present = false
            for previous in 0U64..<clauses.count() {
                if clauses[previous] == context.clauses[index] {
                    if !self.sameAssociatedMemberBound(first: bounds[previous], second: context.bounds[index]) { return <Result.Err error=self.associatedMemberInputFailure(message: "associated context changed its source clause") /> }
                    present = true
                    break
                }
            }
            if !present { bounds.append(context.bounds[index]) clauses.append(context.clauses[index]) }
        }
        return <Result.Ok value=() />
    }
    inout fn prepareShortProjectionSelection(receiver: U64, member: U64, site: U64) -> Result[LoweredShortProjection, CompileDiagnostic] {
        mut val roots: Array[TraitBound] = []
        mut val sources: Array[LoweredTypeViewRecipe] = []
        mut val equations: Array[TraitBound] = []
        mut val clauses: Array[U64] = []
        if self.activeProjectionBounds.isSome() {
            val context = self.activeProjectionBounds.unwrap()
            for index in 0U64..<context.count() {
                val id = context.clause(index: index)
                val head = try self.projectionBoundDeclaredHead(id: id)
                if !(try self.associatedMemberNamespaceContains(owner: head.traitInstance.owner, member: member, site: site)) { continue }
                val subject = try self.preparedProjectionSubject(id: id)
                val receiverContext = try self.prepareAssociatedSelectionTermEquations(terms: [subject.term, receiver], site: site)
                try self.appendAssociatedSelectionContext(context: receiverContext, bounds: inout equations, clauses: inout clauses)
                mut val normalization = <AssociatedMemberQueryWork context=equations />
                if !(try self.associatedSelectionReceiversEqual(subject: subject.term, receiver: receiver, site: site, work: inout normalization)) { continue }
                val bound = try self.preparedProjectionBound(id: id, requestSite: <Optional.Some v=site />)
                roots.append(<TraitBound subject=bound.subject constraint=bound.constraint offset=site />)
                sources.append(<LoweredTypeViewRecipe source=bound.source arguments=bound.arguments />)
            }
        }
        for root in roots {
            try self.appendAssociatedSelectionContext(context: (try self.prepareAssociatedSelectionEquations(root: root, site: site)), bounds: inout equations, clauses: inout clauses)
        }
        val result = try self.queryAssociatedMember(subject: receiver, roots: roots, equationContext: equations, member: member, site: site)
        match result.outcome {
            AssociatedMemberOutcome.Unique(candidate: _) => {
                val root = try result.representationRoot()
                if root >= sources.count() { return <Result.Err error=self.associatedMemberInputFailure(message: "short projection lost its representation recipes") /> }
                val source = sources[root]
                return <Result.Ok value=<LoweredShortProjection source=source.source arguments=source.arguments selection=<PreparedAssociatedMemberSelection site=site receiver=receiver member=member session=self.sourceFactSession() scope=self.sourceTypeUses.currentScope() representationRoot=root equationClauses=clauses result=result /> /> />
            }
            AssociatedMemberOutcome.Missing => { return <Result.Err error=self.diagnosticAt(offset: site, msg: "associated-type short projection has no unique trait source — write `T#Trait.Item` or add an appropriate `where T: Trait` bound (spec/08)", failureDomain: <FailureDomain.Source />) /> }
            AssociatedMemberOutcome.Ambiguous(candidates: _) => { return <Result.Err error=self.diagnosticAt(offset: site, msg: "associated-type short projection is ambiguous — write the canonical `T#Trait.Item` form (spec/08)", failureDomain: <FailureDomain.Source />) /> }
        }
    }

}


// Determine the equation owners used by this namespace query from explicit
// terms and reached headers. Binder substitution cannot invent a projection
// owner absent from either an argument or one of these declared edge terms.
impl Comp {
    inout fn appendAssociatedSelectionDependencies(root: TraitBound, dependencies: inout Array[AssociatedSelectionDependency], site: U64) -> Result[(), CompileDiagnostic] {
        // Reuse the explicit-substitution graph, so Self and trait parameters
        // in inherited edges name this query's receiver and actual arguments.
        mut val work = <AssociatedMemberQueryWork context=[root] />
        val index = try self.associatedMemberEquationGraph(context: 0U64, site: site, work: inout work)
        mut val pending: Array[U64] = []
        for bound in work.graphs[index].nodes {
            pending.append(bound.subject)
            for argument in bound.constraint.key.positionalArgs { pending.append(argument) }
            for predicate in bound.constraint.assocPredicates { pending.append(predicate.value) }
        }
        return self.appendAssociatedSelectionTermDependencies(terms: pending, dependencies: inout dependencies)
    }
    inout fn appendAssociatedSelectionTermDependencies(terms: Array[U64], dependencies: inout Array[AssociatedSelectionDependency]) -> Result[(), CompileDiagnostic] {
        mut val pending = terms
        mut val visited: Set[U64] = Set.new()
        mut val cursor = 0U64
        while cursor < pending.count() {
            val ref = pending[cursor]
            cursor += 1U64
            if visited.contains(ref) { continue }
            visited.insert(ref)
            if ref >= self.arena.typeTermCount() { return <Result.Err error=self.associatedMemberInputFailure(message: "associated selection has an unknown equation dependency") /> }
            val term = self.arena.typeAt(index: ref)
            if term.assocNameId != 0U64 {
                val owner = self.associatedProjectionTraitOwner(projection: term)
                val receiver = self.typeTermProjectionReceiver(t: term)
                mut val present = false
                for prior in dependencies { if prior.owner == owner && self.typeRefEq(a: prior.receiver, b: receiver, sourceTerms: true) { present = true break } }
                if !present { dependencies.append(<AssociatedSelectionDependency owner=owner receiver=receiver />) }
            }
            for index in 0U64..<self.typeTermRefChildCount(ref: ref) { pending.append(self.typeTermRefChildRef(ref: ref, index: index)) }
        }
        return <Result.Ok value=() />
    }
    inout fn associatedSelectionReceiversEqual(subject: U64, receiver: U64, site: U64, work: inout AssociatedMemberQueryWork) -> Result[Bool, CompileDiagnostic] {
        if self.typeRefEq(a: subject, b: receiver, sourceTerms: true) { return <Result.Ok value=true /> }
        val normalizedSubject = try self.normalizeAssociatedMemberTerm(ref: subject, site: site, depth: 0U64, active: [], work: inout work)
        val normalizedReceiver = try self.normalizeAssociatedMemberTerm(ref: receiver, site: site, depth: 0U64, active: [], work: inout work)
        return <Result.Ok value=self.typeRefEq(a: normalizedSubject, b: normalizedReceiver, sourceTerms: true) />
    }
    inout fn prepareAssociatedSelectionEquations(root: TraitBound, site: U64) -> Result[PreparedAssociatedSelectionContext, CompileDiagnostic] {
        if self.activeProjectionBounds.isNone() || self.activeProjectionBounds.unwrap().count() == 0U64 { return <Result.Ok value=<PreparedAssociatedSelectionContext bounds=[] clauses=[] /> /> }
        mut val dependencies: Array[AssociatedSelectionDependency] = []
        try self.appendAssociatedSelectionDependencies(root: root, dependencies: inout dependencies, site: site)
        return self.prepareAssociatedSelectionDependencies(roots: [root], needed: dependencies, site: site)
    }
    inout fn prepareAssociatedSelectionTermEquations(terms: Array[U64], site: U64) -> Result[PreparedAssociatedSelectionContext, CompileDiagnostic] {
        mut val dependencies: Array[AssociatedSelectionDependency] = []
        try self.appendAssociatedSelectionTermDependencies(terms: terms, dependencies: inout dependencies)
        return self.prepareAssociatedSelectionDependencies(roots: [], needed: dependencies, site: site)
    }
    inout fn prepareAssociatedSelectionDependencies(roots: Array[TraitBound], needed: Array[AssociatedSelectionDependency], site: U64) -> Result[PreparedAssociatedSelectionContext, CompileDiagnostic] {
        mut val equations: Array[TraitBound] = []
        mut val clauses: Array[U64] = []
        val context = match self.activeProjectionBounds { Optional.Some(v: val context) => context Optional.None => { return <Result.Ok value=<PreparedAssociatedSelectionContext bounds=equations clauses=clauses /> /> } }
        if context.count() == 0U64 || needed.count() == 0U64 { return <Result.Ok value=<PreparedAssociatedSelectionContext bounds=equations clauses=clauses /> /> }
        mut val dependencies = needed
        mut val included: Set[U64] = Set.new()
        mut val expanded: Set[U64] = Set.new()
        mut val normalization = <AssociatedMemberQueryWork context=roots />
        mut val normalizationCount = 0U64
        mut val changed = true
        while changed {
            changed = false
            for index in 0U64..<context.count() {
                val id = context.clause(index: index)
                if id == 0U64 || id > self.projectionBoundClauses.count() { return <Result.Err error=self.associatedMemberInputFailure(message: "associated selection has an invalid bound clause") /> }
                if expanded.contains(id) { continue }
                val clause = self.projectionBoundClauses[id - 1U64]
                val ready = match clause.state { ProjectionBoundState.Ready(bound: val bound) => <Optional.Some v=bound /> _ => <Optional.None /> }
                if ready.isSome() && !included.contains(id) {
                    val bound = ready.unwrap()
                    equations.append(<TraitBound subject=bound.subject constraint=bound.constraint offset=site />)
                    clauses.append(id)
                    included.insert(id)
                }
                if dependencies.count() == 0U64 { continue }
                val owner = if ready.isSome() { give ready.unwrap().constraint.key.owner } else { give (try self.projectionBoundDeclaredHead(id: id)).traitInstance.owner }
                mut val needed = false
                if owner != 0U64 {
                    for dependency in dependencies {
                        if !(try self.associatedMemberOwnerReachable(owner: owner, target: dependency.owner, site: site)) { continue }
                        val subject = if ready.isSome() { give ready.unwrap().subject } else { give (try self.preparedProjectionSubject(id: id)).term }
                        val count = dependencies.count()
                        try self.appendAssociatedSelectionTermDependencies(terms: [subject], dependencies: inout dependencies)
                        if dependencies.count() != count { changed = true }
                        if normalizationCount != equations.count() {
                            mut val available = roots
                            for equation in equations { available.append(equation) }
                            normalization = <AssociatedMemberQueryWork context=available />
                            normalizationCount = equations.count()
                        }
                        if try self.associatedSelectionReceiversEqual(subject: subject, receiver: dependency.receiver, site: site, work: inout normalization) { needed = true break }
                    }
                }
                if !needed { continue }
                val bound = if ready.isSome() { give ready.unwrap() } else { give try self.preparedProjectionBound(id: id, requestSite: <Optional.Some v=site />) }
                val equation = <TraitBound subject=bound.subject constraint=bound.constraint offset=site />
                if !included.contains(id) { equations.append(equation) clauses.append(id) included.insert(id) }
                expanded.insert(id)
                try self.appendAssociatedSelectionDependencies(root: equation, dependencies: inout dependencies, site: site)
                changed = true
            }
        }
        return <Result.Ok value=<PreparedAssociatedSelectionContext bounds=equations clauses=clauses /> />
    }
}
