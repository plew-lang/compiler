// Source clauses are reserved together, then lowered once in their original
// declaration frame. Uses carry clause IDs instead of authoring their AST again.
impl Comp {
    fn projectionBoundParameterIds() -> Array[U64] {
        mut val parameters: Array[U64] = []
        for parameter in self.cur.typeParams { parameters.append(parameter.paramId) }
        return parameters
    }

    inout fn reserveValueProjectionBounds(parameters: Array[String], traits: Array[String], subjects: Array[TypeAst], traitTypes: Array[TypeAst], anchor: U64, inherited: SourceBoundRange = <SourceBoundRange />) -> Result[(), CompileDiagnostic] {
        val first = self.projectionBoundClauses.count() + 1U64
        val binders = self.projectionBoundParameterIds()
        mut val index = 0U64
        while index < parameters.count() {
            if index >= traits.count() { return <Result.Err error=self.diagnosticAt(offset: anchor, msg: "source bound names are misaligned", failureDomain: <FailureDomain.Input />) /> }
            val name = self.internBytes(s: parameters[index])
            val subject = if index < subjects.count() { give subjects[index] } else { give <TypeAst name=parameters[index] args=[] span=<Span start=anchor end=anchor /> /> }
            val traitType = if index < traitTypes.count() { give traitTypes[index] } else { give <TypeAst name=traits[index] args=[] span=<Span start=anchor end=anchor /> /> }
            self.projectionBoundClauses.append(<ProjectionBoundClause scope=self.sourceTypeUses.currentScope() parameters=binders syntax=<ProjectionBoundSyntax.Value subject=subject traitType=traitType parameter=name /> syntheticSubject=index >= subjects.count() />)
            index += 1U64
        }
        return self.useProjectionBounds(own: <SourceBoundRange first=first count=index />, inherited: inherited)
    }

    inout fn reserveSyntaxProjectionBounds(declaration: SyntaxDecl) -> Result[(), CompileDiagnostic] {
        val first = self.projectionBoundClauses.count() + 1U64
        val parameters = self.projectionBoundParameterIds()
        mut val index = 0U64
        while index < syntaxDeclWhereCount(file: self.syntax, decl: declaration) {
            self.reserveSyntaxProjectionClause(subject: syntaxDeclWhereType(file: self.syntax, decl: declaration, index: index), traitType: syntaxDeclWhereTraitType(file: self.syntax, decl: declaration, index: index), parameter: syntaxDeclWhereParamSpan(file: self.syntax, decl: declaration, index: index), parameters: parameters)
            index += 1U64
        }
        return self.useProjectionBounds(own: <SourceBoundRange first=first count=index />)
    }

    inout fn reserveSyntaxProjectionClause(subject: TypeId, traitType: TypeId, parameter: Span, parameters: Array[U64]) {
        self.projectionBoundClauses.append(<ProjectionBoundClause scope=self.sourceTypeUses.currentScope() parameters=parameters syntax=<ProjectionBoundSyntax.Syntax subject=subject traitType=traitType parameter=parameter /> />)
    }

    inout fn useProjectionBounds(own: SourceBoundRange, inherited: SourceBoundRange = <SourceBoundRange />) -> Result[(), CompileDiagnostic] {
        if !self.sourceTypeUses.bindBounds(range: own) {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid source bound declaration owner", failureDomain: <FailureDomain.Internal />) />
        }
        self.activeProjectionBounds = <Optional.Some v=<ProjectionBoundContext own=own inherited=inherited /> />
        mut val index = 0U64
        while index < own.count {
            try self.preparedProjectionBound(id: own.first + index)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn preparedProjectionBound(id: U64, requestSite: Optional[U64] = <Optional.None />) -> Result[PreparedProjectionBound, CompileDiagnostic] {
        if id == 0U64 || id > self.projectionBoundClauses.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid source bound clause", failureDomain: <FailureDomain.Internal />) /> }
        val saved = self.projectionBoundClauses[id - 1U64]
        val active = self.sourceTypeUses.currentScope()
        if active == 0U64 || saved.scope == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound clause has no declaration owner", failureDomain: <FailureDomain.Internal />) />
        }
        if saved.scope != active {
            val current = self.sourceTypeUses.scopeAt(token: active)
            if !current.isSome() || current.unwrap().parent != saved.scope {
                return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "foreign source bound clause", failureDomain: <FailureDomain.Internal />) />
            }
            match saved.state {
                ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound /> }
                _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "parent source bound was not prepared", failureDomain: <FailureDomain.Internal />) /> }
            }
        }
        match saved.state {
            ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound /> }
            ProjectionBoundState.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            ProjectionBoundState.Lowering => { return <Result.Err error=self.diagnosticAt(offset: requestSite.unwrapOr(fallback: self.sourceTypeUses.scopeAt(token: saved.scope).unwrap().anchor), msg: "associated-type short projection analysis limit exceeded", failureDomain: <FailureDomain.Limit />) /> }
            ProjectionBoundState.Unlowered => {}
        }
        val clause = saved
        if clause.scope != self.sourceTypeUses.currentScope() || clause.parameters.count() != self.cur.typeParams.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound must be prepared in its original declaration", failureDomain: <FailureDomain.Internal />) /> }
        mut val index = 0U64
        while index < clause.parameters.count() {
            if clause.parameters[index] != self.cur.typeParams[index].paramId { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound has a foreign lexical binder", failureDomain: <FailureDomain.Internal />) /> }
            index += 1U64
        }
        match self.sourceTypeUses.currentRole() {
            SourceTypeUseRole.Declaration => {}
            _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source bound must be prepared before parameter defaults and bodies", failureDomain: <FailureDomain.Internal />) /> }
        }
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject head=clause.head state=<ProjectionBoundState.Lowering /> />
        val result = self.lowerProjectionBoundClause(clause: clause)
        val state = match result {
            Result.Ok(value: val bound) => <ProjectionBoundState.Ready bound=bound />,
            Result.Err(error: val diagnostic) => <ProjectionBoundState.Failed diagnostic=diagnostic />,
        }
        val completed = self.projectionBoundClauses[id - 1U64]
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject head=completed.head state=state />
        return result
    }

    inout fn lowerProjectionBoundClause(clause: ProjectionBoundClause) -> Result[PreparedProjectionBound, CompileDiagnostic] {
        match clause.syntax {
            ProjectionBoundSyntax.Value(subject: val subject, traitType: val traitType, parameter: val parameter) => {
                // A legacy name-only row has no authored subject TypeAst.
                // Construct its binder term without issuing a fictitious use.
                val loweredSubject = if clause.syntheticSubject { give (try self.lowerTypeCore(t: (try self.normalizeProjectionType(t: subject)))) } else { give (try self.lowerType(t: subject)) }
                val type = try self.normalizeProjectionType(t: traitType)
                val head = if clause.head.isSome() { give clause.head.unwrap() } else {
                    give try self.valueWhereTraitHead(traitType: type, origin: <Optional.Some v=self.sourceTypeUses.scopeAt(token: clause.scope).unwrap().anchor />)
                }
                val lowered = try self.lowerValueTraitConstraint(traitType: type, owner: head.traitInstance.owner, site: head.writtenStart)
                return <Result.Ok value=<PreparedProjectionBound source=head.withArguments(arguments: lowered.constraint.key.positionalArgs) subject=loweredSubject.ref constraint=lowered.constraint arguments=lowered.arguments subjectRecipe=(if clause.syntheticSubject { give 0U64 } else { give try self.authoredChildRecipe(type: loweredSubject) }) predicateRecipes=lowered.predicateRecipes parameter=parameter /> />
            }
            ProjectionBoundSyntax.Syntax(subject: val subject, traitType: val traitType, parameter: val parameter) => {
                val loweredSubject = try self.lowerSyntaxType(id: subject)
                val type = try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: traitType))
                val head = if clause.head.isSome() { give clause.head.unwrap() } else { give try self.syntaxWhereTraitHead(traitType: type) }
                val lowered = try self.lowerSyntaxTraitConstraint(traitType: type, owner: head.traitInstance.owner, site: head.writtenStart)
                return <Result.Ok value=<PreparedProjectionBound source=head.withArguments(arguments: lowered.constraint.key.positionalArgs) subject=loweredSubject.ref constraint=lowered.constraint arguments=lowered.arguments subjectRecipe=(try self.authoredChildRecipe(type: loweredSubject)) predicateRecipes=lowered.predicateRecipes parameter=<Bind nameStart=parameter.start nameLen=parameter.end - parameter.start nameId=intern(c: inout self, start: parameter.start, len: parameter.end - parameter.start) fieldStart=0U64 fieldLen=0U64 /> /> />
            }
        }
    }

    inout fn appendPreparedFunctionBounds(function: U64) -> Result[(), CompileDiagnostic] {
        mut val bounds: Array[FuncBound] = []
        try self.collectPreparedFunctionBounds(function: function, into: inout bounds)
        self.publishFunctionBounds(bounds: bounds)
        return <Result.Ok value=() />
    }

    inout fn publishFunctionBounds(bounds: Array[FuncBound]) {
        for val bound in bounds { self.decls.funcBounds.append(bound) }
    }

    inout fn collectPreparedFunctionBounds(function: U64, into: inout Array[FuncBound]) -> Result[(), CompileDiagnostic] {
        val context = self.activeProjectionBounds.unwrap()
        try self.collectPreparedFunctionBoundRange(function: function, range: context.own, into: inout into)
        return self.collectPreparedFunctionBoundRange(function: function, range: context.inherited, into: inout into)
    }

    inout fn collectPreparedFunctionBoundRange(function: U64, range: SourceBoundRange, into: inout Array[FuncBound]) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < range.count {
            val id = range.first + index
            val bound = try self.preparedProjectionBound(id: id)
            into.append(<FuncBound fnIdx=function sourceClause=id paramStart=bound.parameter.nameStart paramLen=bound.parameter.nameLen paramTy=bound.subject paramNameId=bound.parameter.nameId constraint=bound.constraint />)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    // Head binding is only a prefilter for not-yet-lowered candidates. Once
    // Ready, the exact canonical source is part of the saved bound result.
    inout fn projectionBoundCandidateSource(id: U64) -> Result[ResolvedViewSource, CompileDiagnostic] {
        val clause = self.projectionBoundClauses[id - 1U64]
        match clause.state {
            ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound.source /> }
            ProjectionBoundState.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            _ => {}
        }
        match clause.head { Optional.Some(v: val head) => { return <Result.Ok value=head /> } Optional.None => {} }
        val source = match clause.syntax {
            ProjectionBoundSyntax.Value(subject: _, traitType: val traitType, parameter: _) => {
                val type = try self.normalizeProjectionType(t: traitType)
                give try self.valueWhereTraitHead(traitType: type, origin: <Optional.Some v=self.sourceTypeUses.scopeAt(token: clause.scope).unwrap().anchor />)
            }
            ProjectionBoundSyntax.Syntax(subject: _, traitType: val traitType, parameter: _) => {
                val type = try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: traitType))
                give try self.syntaxWhereTraitHead(traitType: type)
            }
        }
        self.projectionBoundClauses[id - 1U64] = <ProjectionBoundClause scope=clause.scope parameters=clause.parameters syntax=clause.syntax syntheticSubject=clause.syntheticSubject head=<Optional.Some v=source /> state=clause.state />
        return <Result.Ok value=source />
    }

    // Pending rows use a prefilter to avoid evaluating a recursive RHS for an
    // unrelated subject. Only the prepared semantic term can grant evidence.
    inout fn pendingProjectionHeadMatches(name: Bind, site: U64, term: TypeTerm) -> Bool {
        val binder = self.sourceTypeParameter(name: name)
        if binder != term.paramId { return false }
        if binder != 0U64 { return true }
        val nameId = intern(c: inout self, start: name.nameStart, len: name.nameLen)
        val left = self.sourceNominalOwner(nameStart: name.nameStart, nameLen: name.nameLen, nameId: nameId, site: site)
        val right = self.sourceNominalOwner(nameStart: term.nameStart, nameLen: term.nameLen, nameId: term.nameId, site: term.siteOffset)
        if left.isSome() || right.isSome() { return left.isSome() && right.isSome() && left.unwrap() == right.unwrap() }
        return nameId == term.nameId
    }

    inout fn pendingValueProjectionSubjectMatches(subject: TypeAst, receiver: U64) -> Bool {
        val term = self.arena.typeTermAt(index: receiver)
        if subject.projectionAssoc.bytes().count() > 0U64 || subject.extView.bytes().count() > 0U64 || subject.args.count() != term.args.len {
            return false
        }
        val name = self.lowerTypeName(name: subject.name, span: subject.nameSpan)
        if !self.pendingProjectionHeadMatches(name: name, site: subject.span.start, term: term) { return false }
        mut val index = 0U64
        while index < term.args.len {
            if !self.pendingValueProjectionSubjectMatches(subject: subject.args[index], receiver: self.typeTermArgAt(ref: receiver, index: index)) { return false }
            index += 1U64
        }
        return true
    }

    inout fn pendingSyntaxProjectionSubjectMatches(raw: TypeId, receiver: U64) -> Result[Bool, CompileDiagnostic] {
        val subject = try self.resolveSyntaxTypePath(t: syntaxType(file: self.syntax, id: raw))
        val term = self.arena.typeTermAt(index: receiver)
        if subject.projectionAssoc.end > subject.projectionAssoc.start || subject.extView.end > subject.extView.start || syntaxTypeArgCount(file: self.syntax, ty: subject) != term.args.len {
            return <Result.Ok value=false />
        }
        val name = <Bind nameStart=subject.name.start nameLen=subject.name.end - subject.name.start fieldStart=0U64 fieldLen=0U64 />
        if !self.pendingProjectionHeadMatches(name: name, site: subject.span.start, term: term) { return <Result.Ok value=false /> }
        mut val index = 0U64
        while index < term.args.len {
            val child = syntaxTypeArg(file: self.syntax, ty: subject, index: index)
            if !(try self.pendingSyntaxProjectionSubjectMatches(raw: child, receiver: self.typeTermArgAt(ref: receiver, index: index))) { return <Result.Ok value=false /> }
            index += 1U64
        }
        return <Result.Ok value=true />
    }

    inout fn cachedValueProjectionSource(type: TypeAst, receiver: U64) -> Result[LoweredTypeViewRecipe, CompileDiagnostic] {
        val member = self.internBytes(s: type.projectionAssoc).nameId
        mut val sources: Array[LoweredTypeViewRecipe] = []
        val context = self.activeProjectionBounds.unwrap()
        mut val index = 0U64
        while index < context.count() {
            val id = context.clause(index: index)
            index += 1U64
            if id == 0U64 || id > self.projectionBoundClauses.count() {
                return <Result.Err error=self.diagnosticAt(offset: type.span.start, msg: "invalid source bound clause", failureDomain: <FailureDomain.Internal />) />
            }
            val clause = self.projectionBoundClauses[id - 1U64]
            match clause.state {
                ProjectionBoundState.Ready(bound: val bound) => {
                    if self.typeRefEq(a: bound.subject, b: receiver, sourceTerms: true) && self.traitOwnerHasAssocId(owner: bound.source.traitInstance.owner, assocId: member) {
                        try self.preparedProjectionBound(id: id)
                        sources.append(<LoweredTypeViewRecipe source=bound.source arguments=bound.arguments />)
                    }
                    continue
                }
                _ => {}
            }
            match clause.syntax {
                ProjectionBoundSyntax.Value(subject: val subject, traitType: _, parameter: _) => {
                    if self.pendingValueProjectionSubjectMatches(subject: (try self.normalizeProjectionType(t: subject)), receiver: receiver) {
                        val source = try self.projectionBoundCandidateSource(id: id)
                        if self.traitOwnerHasAssocId(owner: source.traitInstance.owner, assocId: member) {
                            val bound = try self.preparedProjectionBound(id: id, requestSite: <Optional.Some v=type.span.start />)
                            if self.typeRefEq(a: bound.subject, b: receiver, sourceTerms: true) {
                                sources.append(<LoweredTypeViewRecipe source=bound.source arguments=bound.arguments />)
                            }
                        }
                    }
                }
                _ => {}
            }
        }
        return self.chooseShortProjectionSource(sources: sources, member: member, site: type.span.start)
    }

    inout fn cachedSyntaxProjectionSource(type: SyntaxType, receiver: U64) -> Result[LoweredTypeViewRecipe, CompileDiagnostic] {
        val member = intern(c: inout self, start: type.projectionAssoc.start, len: type.projectionAssoc.end - type.projectionAssoc.start)
        mut val sources: Array[LoweredTypeViewRecipe] = []
        val context = self.activeProjectionBounds.unwrap()
        mut val index = 0U64
        while index < context.count() {
            val id = context.clause(index: index)
            index += 1U64
            if id == 0U64 || id > self.projectionBoundClauses.count() {
                return <Result.Err error=self.diagnosticAt(offset: type.span.start, msg: "invalid source bound clause", failureDomain: <FailureDomain.Internal />) />
            }
            val clause = self.projectionBoundClauses[id - 1U64]
            match clause.state {
                ProjectionBoundState.Ready(bound: val bound) => {
                    if self.typeRefEq(a: bound.subject, b: receiver, sourceTerms: true) && self.traitOwnerHasAssocId(owner: bound.source.traitInstance.owner, assocId: member) {
                        try self.preparedProjectionBound(id: id)
                        sources.append(<LoweredTypeViewRecipe source=bound.source arguments=bound.arguments />)
                    }
                    continue
                }
                _ => {}
            }
            match clause.syntax {
                ProjectionBoundSyntax.Syntax(subject: val subject, traitType: _, parameter: _) => {
                    if try self.pendingSyntaxProjectionSubjectMatches(raw: subject, receiver: receiver) {
                        val source = try self.projectionBoundCandidateSource(id: id)
                        if self.traitOwnerHasAssocId(owner: source.traitInstance.owner, assocId: member) {
                            val bound = try self.preparedProjectionBound(id: id, requestSite: <Optional.Some v=type.span.start />)
                            if self.typeRefEq(a: bound.subject, b: receiver, sourceTerms: true) {
                                sources.append(<LoweredTypeViewRecipe source=bound.source arguments=bound.arguments />)
                            }
                        }
                    }
                }
                _ => {}
            }
        }
        return self.chooseShortProjectionSource(sources: sources, member: member, site: type.span.start)
    }
}
