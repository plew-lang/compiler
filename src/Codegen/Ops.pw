// Part of name/type resolution (root: _.pw): integer-arithmetic typing helpers.
// (The operator opcodes themselves now live in the shared leaf module `@Ops`.)

pub impl Comp {

    // The integer result type of an arithmetic binary (operands share a type, so
    // either operand's recovered int type works). Width-less scalar if neither is a
    // recoverable integer type — then the overflow check is skipped (documented gap).
    inout fn arithIntType(lhs: U64, rhs: U64) -> TypeInfo {
        val lt: TypeInfo = self.typeOf(id: lhs)
        if lt.kind == 0 {
            if self.isIntType(start: lt.nameStart, len: lt.nameLen) {
                return lt
            }
        }
        val rt: TypeInfo = self.typeOf(id: rhs)
        if rt.kind == 0 {
            if self.isIntType(start: rt.nameStart, len: rt.nameLen) {
                return rt
            }
        }
        return scalarInfo()
    }
}
