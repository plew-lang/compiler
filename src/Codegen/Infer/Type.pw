// Part of type inference/checking (root: _.pw): expression type inference
// and type compatibility.

pub impl Comp {
    // `any P[Out, Item=I64]` carries both the trait's positional parameters
    // and associated-type bindings in TypeRef.args.  Only the former identify
    // the conformance instance; named associated bindings constrain dispatch
    // after that witness is selected.
    inout fn positionalTraitArgs(t: TypeRef) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < t.args.count() {
            mut val label: U64 = 0U64
            if i < t.argLabels.count() { label = t.argLabels[i] }
            if label == 0U64 { out.append(t.args[i]) }
            i += 1U64
        }
        return out
    }

    inout fn traitAssocArgNames(t: TypeRef) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < t.args.count() {
            if i < t.argLabels.count() && t.argLabels[i] != 0U64 { out.append(t.argLabels[i]) }
            i += 1U64
        }
        return out
    }

    inout fn traitAssocArgValues(t: TypeRef) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < t.args.count() {
            if i < t.argLabels.count() && t.argLabels[i] != 0U64 { out.append(t.args[i]) }
            i += 1U64
        }
        return out
    }

    inout fn inferType(id: U64) -> U64 {
        // an un-suffixed integer literal has no intrinsic type — it adapts to its context
        // (`u64var + 5`, `val x: I32 = 5`). typeOf may attach an emission-context width to
        // it, but for type CHECKING it is genuinely unknown, so report 0 (a typed literal
        // `5I64` keeps its suffix type; `true`/`false` fall through to Bool).
        match self.arena.exprs[id] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, val tyLen, isNeg: _) => {
                if !(isBool) {
                    if tyLen == 0U64 {
                        return 0U64
                    }
                }
            }
            _ => {}
        }
        val ti: TypeInfo = self.typeOf(id: id)
        if ti.ref != 0U64 {
            return ti.ref
        }
        if ti.nameLen == 0U64 {
            return 0U64
        }
        // arrays (kind 3): conservative for now — their element comparison is deferred.
        if ti.kind == 3 {
            return 0U64
        }
        return self.simpleTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
    }

    inout fn isConcreteTypeName(start: U64, len: U64) -> Bool {
        if self.isPrimType(start: start, len: len) {
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "String") {
            return true
        }
        if self.knownNamedTypeId(start: start, len: len) != 0U64 {
            return true
        }
        return false
    }

    inout fn typesCompatible(expected: U64, inferred: U64) -> Bool {
        if expected == 0U64 || inferred == 0U64 {
            return true
        }
        if expected >= self.arena.types.count() || inferred >= self.arena.types.count() {
            return true
        }
        // ground the expected type through any active generic env (a `-> T` return / `T`
        // param resolves to the concrete instantiation argument); inferred is grounded.
        val exp: U64 = self.groundTypeRef(ref: expected)
        if exp >= self.arena.types.count() {
            return true
        }
        val te: TypeRef = self.arena.types[exp]
        val tin: TypeRef = self.arena.types[inferred]
        if te.isSendable && !(self.typeRefIsSendable(ref: inferred)) {
            return false
        }
        if te.isAny || tin.isAny {
            // a CONCRETE value coercing INTO `any P` must conform to P (spec/08) — else its
            // existential box has no vtable entry and a member call null-dereferences at
            // runtime. Check the conformance table when the source is a known concrete
            // struct/enum; a generic param (id 0, conforms via its `where` bound) or an
            // existing `any` source is left to the conservative pass-through.
            if te.isAny {
                if !(tin.isAny) {
                    if self.isActiveTypeParam(t: tin) {
                        if !(self.activeTypeParamConformsToTrait(source: tin, trait: te)) {
                            return false
                        }
                        return true
                    }
                    val srcId: U64 = self.knownNamedTypeId(start: tin.nameStart, len: tin.nameLen)
                    if srcId != 0U64 {
                        // Existential formation uses the same complete trait
                        // instance query as `where`: a witness for `P[I64]`
                        // does not construct an `any P[String]` box.
                        val constraint: TraitConstraint = self.existentialTraitConstraint(ref: exp)
                        if inferred != 0U64 {
                            if !(self.conformsTraitConstraint(ref: inferred, constraint: constraint)) {
                                return false
                            }
                        } else {
                            val traitId: U64 = intern(c: inout self, start: te.nameStart, len: te.nameLen)
                            if constraint.key.positionalArgs.count() != 0U64 || !(self.conformExists(typeId: srcId, traitId: traitId)) {
                                return false
                            }
                        }
                    }
                }
            }
            return true
        }
        // float-to-float is exempt: F32 is currently lowered as F64 (true F32 deferred), so
        // an F64 value flowing into an F32 position is not a real mismatch yet, and a float
        // literal recovered as F64 may meet a float local reporting otherwise. But a float
        // paired with a NON-float (`val x: F64 = nI64`) IS a real mismatch — no implicit
        // int↔float conversion (spec/12) — so only exempt when BOTH sides are float. (An
        // untyped int LITERAL flowing into a float context is polymorphic and passes via the
        // unknown-id path below, not here.)
        val eFloat: Bool = self.isFloatType(start: te.nameStart, len: te.nameLen)
        val iFloat: Bool = self.isFloatType(start: tin.nameStart, len: tin.nameLen)
        if eFloat && iFloat {
            return true
        }
        if eFloat || iFloat {
            // one side float, the other not: a mismatch UNLESS the non-float side is an
            // untyped/unknown type (a bare int literal — polymorphic, handled below).
            if eFloat {
                if self.knownNamedTypeId(start: tin.nameStart, len: tin.nameLen) == 0U64 {
                    return true
                }
            } else {
                if self.knownNamedTypeId(start: te.nameStart, len: te.nameLen) == 0U64 {
                    return true
                }
            }
            return false
        }
        // generic-body abstract check (spec/06): a type parameter of the function being
        // checked (`self.cur.checkFn`) is an opaque DISTINCT type — incompatible with a
        // CONCRETE type or a DIFFERENT parameter of the same function, but lenient against
        // an unknown / another generic's type parameter (which unifies at instantiation,
        // e.g. passing this fn's `T` to `f[U](x: U)`). Active only while checking a generic
        // template body (curCheckFn valid); elsewhere isTypeParamOf is false.
        val eTp: Bool = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: te.nameStart, len: te.nameLen)
        val iTp: Bool = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: tin.nameStart, len: tin.nameLen)
        if eTp {
            if iTp {
                // both are this function's parameters: compatible iff the SAME one.
                return spansEqual(c: inout self, aStart: te.nameStart, aLen: te.nameLen, bStart: tin.nameStart, bLen: tin.nameLen)
            }
            // T vs a CONCRETE type -> incompatible; T vs unknown / another param -> lenient.
            if self.isConcreteTypeName(start: tin.nameStart, len: tin.nameLen) {
                return false
            }
            return true
        }
        if iTp {
            if self.isConcreteTypeName(start: te.nameStart, len: te.nameLen) {
                return false
            }
            return true
        }
        // the abstract Self of a trait provided-method body is likewise opaque: Self vs a
        // CONCRETE type -> incompatible (`return self` from `-> I64`), Self vs Self -> ok.
        val eSelf: Bool = self.isSelfTypeInProvided(start: te.nameStart, len: te.nameLen)
        val iSelf: Bool = self.isSelfTypeInProvided(start: tin.nameStart, len: tin.nameLen)
        if eSelf {
            if iSelf {
                return true
            }
            if self.isConcreteTypeName(start: tin.nameStart, len: tin.nameLen) {
                return false
            }
            return true
        }
        if iSelf {
            if self.isConcreteTypeName(start: te.nameStart, len: te.nameLen) {
                return false
            }
            return true
        }
        if te.isRecord || tin.isRecord {
            // A semantic Record may meet a still-legacy layout spelling at the
            // frontend/backend migration seam. Reify that spelling immediately
            // and then take the ordinary structural path; it is not a second
            // equality rule.
            mut val er: U64 = exp
            mut val ir: U64 = inferred
            if !(te.isRecord) {
                if te.nameLen == 0U64 || self.arena.bytes[te.nameStart] != 40U8 { return false }
                er = self.recordTypeTermForLayout(name: <Bind nameStart=te.nameStart nameLen=te.nameLen fieldStart=0U64 fieldLen=0U64 />)
            }
            if !(tin.isRecord) {
                if tin.nameLen == 0U64 || self.arena.bytes[tin.nameStart] != 40U8 { return false }
                ir = self.recordTypeTermForLayout(name: <Bind nameStart=tin.nameStart nameLen=tin.nameLen fieldStart=0U64 fieldLen=0U64 />)
            }
            return self.recordsCompatible(teRef: er, tinRef: ir)
        }
        // Bootstrap compatibility only: a compiler produced before TypeTerm.Record
        // may still feed this checker a record's synthetic layout spelling.  Reify
        // that spelling immediately, then use the same structural comparison as
        // every normal record path.  New resolution never constructs this form.
        if te.nameLen > 0U64 && tin.nameLen > 0U64 {
            if self.arena.bytes[te.nameStart] == 40U8 && self.arena.bytes[tin.nameStart] == 40U8 {
                val er: U64 = self.recordTypeTermForLayout(name: <Bind nameStart=te.nameStart nameLen=te.nameLen fieldStart=0U64 fieldLen=0U64 />)
                val ir: U64 = self.recordTypeTermForLayout(name: <Bind nameStart=tin.nameStart nameLen=tin.nameLen fieldStart=0U64 fieldLen=0U64 />)
                return self.recordsCompatible(teRef: er, tinRef: ir)
            }
        }
        return self.compatNamed(te: te, tin: tin)
    }

    // Structural field-by-field compatibility of two Record TypeTerms.
    inout fn recordsCompatible(teRef: U64, tinRef: U64) -> Bool {
        val te: TypeRef = self.arena.types[teRef]
        val tin: TypeRef = self.arena.types[tinRef]
        if !(te.isRecord) || !(tin.isRecord) { return false }
        if te.recordFieldLabels.count() != tin.recordFieldLabels.count() || te.recordFieldTerms.count() != tin.recordFieldTerms.count() || te.recordFieldLabels.count() != te.recordFieldTerms.count() {
            return false
        }
        // Constructors sort labels, so the corresponding structural children
        // occupy the same index.  Field values themselves are checked by
        // tcCheckMakeFields.
        mut val i: U64 = 0
        while i < te.recordFieldTerms.count() {
            if i >= te.recordFieldLabels.count() || i >= tin.recordFieldLabels.count() || te.recordFieldLabels[i] != tin.recordFieldLabels[i] { return false }
            // a record/tuple field widening concrete->`any P` has no backend repack (records are
            // not a covariant container the erasure handles), so reject it rather than silently
            // miscompile the differing field layout (spec/08; mirrors compatNamed's gate).
            if self.argWidensToAny(expectedArg: te.recordFieldTerms[i], inferredArg: tin.recordFieldTerms[i]) {
                return false
            }
            if !(self.typesCompatible(expected: te.recordFieldTerms[i], inferred: tin.recordFieldTerms[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn compatNamed(te: TypeRef, tin: TypeRef) -> Bool {
        mut val eId: U64 = self.knownNamedTypeId(start: te.nameStart, len: te.nameLen)
        mut val iId: U64 = self.knownNamedTypeId(start: tin.nameStart, len: tin.nameLen)
        // a GENERIC struct head (`Box` of `Box[I64]`) is a known type identity too.
        // knownNamedTypeId's struct lookup is concrete-only (its other callers gate
        // method/conformance checks that route generics through their own machinery),
        // so resolve the generic head here: instances of different generic defs are
        // incompatible, and same-def instances compare their args below — without
        // this, `Box[I64] = boxOfString` passed as "unknown head". (A generic ENUM
        // head is already found by knownNamedTypeId's arity-blind enum loop.)
        if eId == 0U64 {
            eId = self.genericStructHeadId(start: te.nameStart, len: te.nameLen)
        }
        if iId == 0U64 {
            iId = self.genericStructHeadId(start: tin.nameStart, len: tin.nameLen)
        }
        if eId == 0U64 || iId == 0U64 {
            return true
        }
        if eId != iId {
            return false
        }
        // same head: a generic head must agree on its type arguments.
        if te.args.count() == tin.args.count() {
            // covariant container erasure (spec/08, SE-0309): an arg widening concrete->`any P`
            // (`Dictionary[K, S]` -> `Dictionary[K, any P]`) is a genuine per-position REPACK,
            // which the backend performs only for `Array` and generic enums (Optional/Result/…).
            // For any OTHER head (Dictionary, a user struct, a tuple/record) the layouts differ
            // but no repack exists, so accepting it would silently miscompile — reject it here.
            val headErasable: Bool = rangeEquals(bytes: self.arena.bytes, start: te.nameStart, len: te.nameLen, kw: "Array") || self.genericEnumIndex(nameStart: te.nameStart, nameLen: te.nameLen) < self.arena.enums.count()
            mut val i: U64 = 0
            while i < te.args.count() {
                if !(headErasable) {
                    if self.argWidensToAny(expectedArg: te.args[i], inferredArg: tin.args[i]) {
                        return false
                    }
                }
                if !(self.typesCompatible(expected: te.args[i], inferred: tin.args[i])) {
                    return false
                }
                i += 1
            }
        }
        return true
    }

    // Whether `inferredArg` (a concrete named type) widens to `expectedArg` (`any P`) — the
    // covariant concrete->existential position. Used to gate that widening to the container
    // heads whose backend actually repacks it (compatNamed).
    inout fn argWidensToAny(expectedArg: U64, inferredArg: U64) -> Bool {
        if expectedArg >= self.arena.types.count() || inferredArg >= self.arena.types.count() {
            return false
        }
        val ea: TypeRef = self.arena.types[expectedArg]
        val ia: TypeRef = self.arena.types[inferredArg]
        if !(ea.isAny) || ia.isAny {
            return false
        }
        return self.knownNamedTypeId(start: ia.nameStart, len: ia.nameLen) != 0U64
    }

    inout fn activeTypeParamConformsToTrait(source: TypeRef, trait: TypeRef) -> Bool {
        if self.cur.checkFn >= self.arena.funcs.count() {
            return false
        }
        val qTp: U64 = source.nameId
        val constraint: TraitConstraint = self.existentialTraitConstraintFor(t: trait)
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == self.cur.checkFn {
                if fb.paramNameId == qTp {
                    if constraint.key.owner != 0U64 && fb.constraint.key.owner == constraint.key.owner && fb.constraint.key.positionalArgs.count() == constraint.key.positionalArgs.count() {
                        mut val binds: Array[UnifyBind] = []
                        mut val ai: U64 = 0U64
                        mut val matches: Bool = true
                        while ai < fb.constraint.key.positionalArgs.count() {
                            if !(self.unifyPatterns(a: fb.constraint.key.positionalArgs[ai], aSide: 0U64, b: constraint.key.positionalArgs[ai], bSide: 1U64, aParams: self.cur.typeParams, bParams: [], binds: inout binds)) {
                                matches = false
                            }
                            ai += 1U64
                        }
                        // Associated outputs are not positional trait inputs.
                        // A generic bound entails an existential constraint only
                        // when it promises the same selected-witness outputs;
                        // `T: Iter[Item=String]` must not erase to
                        // `any Iter[Item=I64]` merely because both share Iter.
                        if fb.constraint.assocPredicates.count() != constraint.assocPredicates.count() { matches = false }
                        mut val need: U64 = 0U64
                        while need < constraint.assocPredicates.count() {
                            mut val found: Bool = false
                            mut val bi: U64 = 0U64
                            while bi < fb.constraint.assocPredicates.count() {
                                val provided: TraitAssocPredicate = fb.constraint.assocPredicates[bi]
                                if provided.member == constraint.assocPredicates[need].member {
                                    if self.typeRefEq(a: provided.value, b: constraint.assocPredicates[need].value) { found = true }
                                }
                                bi += 1U64
                            }
                            if !found { matches = false }
                            need += 1U64
                        }
                        if matches {
                            return true
                        }
                    }
                }
            }
            bi += 1U64
        }
        return false
    }

    // The interned name id of a GENERIC struct def head (`Box` of `struct Box[T]`),
    // 0 when the span names no generic struct. compatNamed's identity supplement —
    // see the comment there.
    inout fn genericStructHeadId(start: U64, len: U64) -> U64 {
        val si: U64 = self.structDefByNameAny(start: start, len: len)
        if si < self.arena.structs.count() {
            if self.arena.structs[si].typeParams.count() > 0U64 {
                return self.arena.structs[si].nameId
            }
        }
        return 0U64
    }

    inout fn exprIsVoidCall(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val fi: U64 = self.resolvedCallee(id: id)
                if fi < self.arena.funcs.count() {
                    return !self.arena.funcs[fi].hasRet
                }
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                // The verifier has already resolved every method-shaped call to its
                // final callable.  Value-context checking must consume that decision,
                // not re-resolve only the bare spelling and accidentally exclude `#`.
                val mi: U64 = self.resolvedCallee(id: id)
                if mi < self.arena.funcs.count() {
                    return !self.arena.funcs[mi].hasRet
                }
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                val mi: U64 = self.resolvedCallee(id: id)
                if mi < self.arena.funcs.count() {
                    return !self.arena.funcs[mi].hasRet
                }
            }
            _ => {}
        }
        return false
    }
}
