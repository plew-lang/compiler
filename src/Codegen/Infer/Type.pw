// Part of type inference/checking (root: _.pw): expression type inference
// and type compatibility.

pub impl Comp {
    // `any P[Out, Item=I64]` carries both the trait's positional parameters
    // and associated-type bindings in TypeRef.args.  Only the former identify
    // the conformance instance; named associated bindings constrain dispatch
    // after that witness is selected.
    inout fn positionalTraitArgs(t: TypeRef) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < t.args.count() {
            mut val label: U64 = 0U64
            if i < t.argLabels.count() { label = t.argLabels[i] }
            if label == 0U64 { out.append(t.args[i]) }
            i += 1U64
        }
        return out
    }

    inout fn traitAssocArgNames(t: TypeRef) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < t.args.count() {
            if i < t.argLabels.count() && t.argLabels[i] != 0U64 { out.append(t.argLabels[i]) }
            i += 1U64
        }
        return out
    }

    inout fn traitAssocArgValues(t: TypeRef) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < t.args.count() {
            if i < t.argLabels.count() && t.argLabels[i] != 0U64 { out.append(t.args[i]) }
            i += 1U64
        }
        return out
    }

    inout fn inferType(id: U64) -> Result[U64, CompileDiagnostic] {
        // an un-suffixed integer literal has no intrinsic type — it adapts to its context
        // (`u64var + 5`, `val x: I32 = 5`). typeOf may attach an emission-context width to
        // it, but for type CHECKING it is genuinely unknown, so report 0 (a typed literal
        // `5I64` keeps its suffix type; `true`/`false` fall through to Bool).
        match self.arena.exprs[id] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, val tyLen, isNeg: _) => {
                if !(isBool) {
                    if tyLen == 0U64 {
                        return <Result.Ok value=0U64 />
                    }
                }
            }
            _ => {}
        }
        // Call inference and value compatibility consume the same body-local
        // semantic term, including recorded operand context and projections.
        return self.groundedTypeOf(id: id)
    }

    // The empty-view case needs no owned array. Preserve the existing set
    // semantics (including duplicate IDs) for the non-empty representation.
    inout fn sameCompatibilityViewSet(expectedRef: U64, inferredRef: U64) -> Bool {
        if self.arena.typeTerms[expectedRef].viewIds.len == 0U64 && self.arena.typeTerms[inferredRef].viewIds.len == 0U64 { return true }
        return self.sameViewIdSet(a: self.arena.typeAt(index: expectedRef).viewIds, b: self.arena.typeAt(index: inferredRef).viewIds)
    }

    inout fn isConcreteType(type: TypeTerm) -> Bool {
        if self.isPrimType(start: type.nameStart, len: type.nameLen) {
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: type.nameStart, len: type.nameLen, kw: "String") {
            return true
        }
        if self.knownNamedTypeIdForTerm(type: type) != 0U64 {
            return true
        }
        return false
    }

    // Predicate for candidate filters and callers that need only a proof of
    // success. Unresolved is false; final value checks retain its diagnostic.
    inout fn typesCompatible(expected: U64, inferred: U64) -> Result[Bool, CompileDiagnostic] {
        return <Result.Ok value=(try self.typeCompatibility(expected: expected, inferred: inferred)).isCompatible() />
    }

    inout fn typeCompatibility(expected: U64, inferred: U64) -> Result[TypeCompatibility, CompileDiagnostic] {
        if expected == 0U64 || inferred == 0U64 {
            return <Result.Ok value=<TypeCompatibility.Unresolved /> />
        }
        if expected >= self.arena.typeCount() || inferred >= self.arena.typeCount() {
            return <Result.Ok value=<TypeCompatibility.Unresolved /> />
        }
        // Normalize both sides in the same lexical environment. Inferred
        // locals can retain associated projections from their written annotation.
        val exp: U64 = (try self.groundTypeRef(ref: expected))
        val actual: U64 = (try self.groundTypeRef(ref: inferred))
        if exp == 0U64 || actual == 0U64 || exp >= self.arena.typeCount() || actual >= self.arena.typeCount() {
            return <Result.Ok value=<TypeCompatibility.Unresolved /> />
        }
        val te = self.arena.typeTerms[exp]
        val tin = self.arena.typeTerms[actual]
        if te.isSendable && !((try self.typeRefIsSendable(ref: actual))) {
            return <Result.Ok value=<TypeCompatibility.Incompatible /> />
        }
        if te.isAny || tin.isAny {
            if !te.isAny { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
            // a CONCRETE value coercing INTO `any P` must conform to P (spec/08) — else its
            // existential box has no vtable entry and a member call null-dereferences at
            // runtime. Symbolic parameters use their lexical assumptions; nominal
            // instances use the complete conformance query.
            if te.isAny {
                if !(tin.isAny) {
                    if self.isActiveTypeParam(t: self.arena.typeAt(index: actual)) {
                        if !(self.activeTypeParamConformsToTrait(source: self.arena.typeAt(index: actual), trait: self.arena.typeAt(index: exp))) {
                            return <Result.Ok value=<TypeCompatibility.Incompatible /> />
                        }
                        return <Result.Ok value=<TypeCompatibility.Compatible /> />
                    }
                    // Formation requires the full trait-instance proof. Candidate
                    // filters exclude generic declarations and cannot decide
                    // compatibility of an instantiated nominal type.
                    val constraint: TraitConstraint = self.existentialTraitConstraint(ref: exp)
                    if !((try self.conformsTraitConstraint(ref: actual, constraint: constraint))) {
                        return <Result.Ok value=<TypeCompatibility.Incompatible /> />
                    }
                }
            }
            return <Result.Ok value=<TypeCompatibility.Compatible /> />
        }
        // A typed floating value keeps its width. Contextual numeric expressions
        // are handled at the expression boundary, never by weakening type equality.
        val eFloat: Bool = self.isFloatType(start: te.nameStart, len: te.nameLen)
        val iFloat: Bool = self.isFloatType(start: tin.nameStart, len: tin.nameLen)
        if eFloat && iFloat {
            return <Result.Ok value=self.typeCompatibilityResult(matches: self.typeRefEq(a: exp, b: actual)) />
        }
        if eFloat || iFloat {
            return <Result.Ok value=<TypeCompatibility.Incompatible /> />
        }
        // All declared parameters are rigid here. Call-site inference owns
        // substitution; compatibility cannot bind another declaration's T.
        if te.paramId != 0U64 || tin.paramId != 0U64 || te.assocNameId != 0U64 || tin.assocNameId != 0U64 {
            return <Result.Ok value=self.typeCompatibilityResult(matches: self.typeRefEq(a: exp, b: actual)) />
        }
        if self.isSelfTypeInProvided(start: te.nameStart, len: te.nameLen) || self.isSelfTypeInProvided(start: tin.nameStart, len: tin.nameLen) {
            return <Result.Ok value=self.typeCompatibilityResult(matches: self.typeRefEq(a: exp, b: actual)) />
        }
        if te.isRecord || tin.isRecord {
            // A semantic Record may meet a still-legacy layout spelling at the
            // frontend/backend migration seam. Reify that spelling immediately
            // and then take the ordinary structural path; it is not a second
            // equality rule.
            mut val er: U64 = exp
            mut val ir: U64 = actual
            if !(te.isRecord) {
                if te.nameLen == 0U64 || self.arena.bytes[te.nameStart] != 40U8 { return <Result.Ok value=<TypeCompatibility.Incompatible /> />}
                er = (try self.recordTypeTermForLayout(name: <Bind nameStart=te.nameStart nameLen=te.nameLen fieldStart=0U64 fieldLen=0U64 />))
            }
            if !(tin.isRecord) {
                if tin.nameLen == 0U64 || self.arena.bytes[tin.nameStart] != 40U8 { return <Result.Ok value=<TypeCompatibility.Incompatible /> />}
                ir = (try self.recordTypeTermForLayout(name: <Bind nameStart=tin.nameStart nameLen=tin.nameLen fieldStart=0U64 fieldLen=0U64 />))
            }
            return <Result.Ok value=(try self.recordTypeCompatibility(teRef: er, tinRef: ir)) />
        }
        // Bootstrap compatibility only: a compiler produced before TypeTerm.Record
        // may still feed this checker a record's synthetic layout spelling.  Reify
        // that spelling immediately, then use the same structural comparison as
        // every normal record path.  New resolution never constructs this form.
        if te.nameLen > 0U64 && tin.nameLen > 0U64 {
            if self.arena.bytes[te.nameStart] == 40U8 && self.arena.bytes[tin.nameStart] == 40U8 {
                val er: U64 = (try self.recordTypeTermForLayout(name: <Bind nameStart=te.nameStart nameLen=te.nameLen fieldStart=0U64 fieldLen=0U64 />))
                val ir: U64 = (try self.recordTypeTermForLayout(name: <Bind nameStart=tin.nameStart nameLen=tin.nameLen fieldStart=0U64 fieldLen=0U64 />))
                return <Result.Ok value=(try self.recordTypeCompatibility(teRef: er, tinRef: ir)) />
            }
        }
        if self.isFnType(ref: exp) || self.isFnType(ref: actual) {
            if !(self.isFnType(ref: exp)) || !(self.isFnType(ref: actual)) { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
            if te.args.len != tin.args.len { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
            mut val index: U64 = 0U64
            while index < te.args.len {
                if self.typeTermRefIdentityChildLabel(ref: exp, index: index) != self.typeTermRefIdentityChildLabel(ref: actual, index: index) { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
                val expectedChild = self.arena.typeArgumentPool[te.args.start + index]
                val inferredChild = self.arena.typeArgumentPool[tin.args.start + index]
                if index == 0U64 {
                    val expectedUnit = self.callableResultIsUnit(ref: expectedChild)
                    val inferredUnit = self.callableResultIsUnit(ref: inferredChild)
                    if expectedUnit || inferredUnit {
                        if !(expectedUnit && inferredUnit) { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
                        index += 1U64
                        continue
                    }
                }
                match (try self.typeCompatibility(expected: expectedChild, inferred: inferredChild)) {
                    TypeCompatibility.Compatible => {}
                    TypeCompatibility.Incompatible => { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
                    TypeCompatibility.Unresolved => { return <Result.Ok value=<TypeCompatibility.Unresolved /> /> }
                }
                index += 1U64
            }
            return <Result.Ok value=<TypeCompatibility.Compatible /> />
        }
        return <Result.Ok value=(try self.namedTypeCompatibility(expectedRef: exp, inferredRef: actual, te: te, tin: tin)) />
    }

    // Structural field-by-field compatibility of two Record TypeTerms.
    inout fn recordTypeCompatibility(teRef: U64, tinRef: U64) -> Result[TypeCompatibility, CompileDiagnostic] {
        val te = self.arena.typeTerms[teRef]
        val tin = self.arena.typeTerms[tinRef]
        if !(te.isRecord) || !(tin.isRecord) { return <Result.Ok value=<TypeCompatibility.Incompatible /> />}
        if te.recordFieldLabels.len != tin.recordFieldLabels.len || te.recordFieldTerms.len != tin.recordFieldTerms.len || te.recordFieldLabels.len != te.recordFieldTerms.len {
            return <Result.Ok value=<TypeCompatibility.Incompatible /> />
        }
        // Constructors sort labels, so the corresponding structural children
        // occupy the same index.  Field values themselves are checked by
        // tcCheckMakeFields.
        mut val i: U64 = 0
        while i < te.recordFieldTerms.len {
            if i >= te.recordFieldLabels.len || i >= tin.recordFieldLabels.len || self.arena.typeRecordLabelPool[te.recordFieldLabels.start + i] != self.arena.typeRecordLabelPool[tin.recordFieldLabels.start + i] { return <Result.Ok value=<TypeCompatibility.Incompatible /> />}
            // a record/tuple field widening concrete->`any P` has no backend repack (records are
            // not a covariant container the erasure handles), so reject it rather than silently
            // miscompile the differing field layout (spec/08; mirrors compatNamed's gate).
            if self.argWidensToAny(expectedArg: self.arena.typeRecordFieldPool[te.recordFieldTerms.start + i], inferredArg: self.arena.typeRecordFieldPool[tin.recordFieldTerms.start + i]) {
                return <Result.Ok value=<TypeCompatibility.Incompatible /> />
            }
            match (try self.typeCompatibility(expected: self.arena.typeRecordFieldPool[te.recordFieldTerms.start + i], inferred: self.arena.typeRecordFieldPool[tin.recordFieldTerms.start + i])) {
                    TypeCompatibility.Compatible => {}
                    TypeCompatibility.Incompatible => { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
                    TypeCompatibility.Unresolved => { return <Result.Ok value=<TypeCompatibility.Unresolved /> /> }
                }
            i += 1
        }
        return <Result.Ok value=<TypeCompatibility.Compatible /> />
    }

    // Compiler-owned type constructors have no source declaration owner.
    // Their spelling identifies the constructor; their children still undergo
    // ordinary compatibility below. Unknown names are never builtin identities.
    inout fn isCompatibilityBuiltin(type: TypeTerm) -> Bool {
        if self.isPrimType(start: type.nameStart, len: type.nameLen) { return true }
        return rangeEquals(bytes: self.arena.bytes, start: type.nameStart, len: type.nameLen, kw: "String") || rangeEquals(bytes: self.arena.bytes, start: type.nameStart, len: type.nameLen, kw: "CPtr") || rangeEquals(bytes: self.arena.bytes, start: type.nameStart, len: type.nameLen, kw: "CMutPtr") || rangeEquals(bytes: self.arena.bytes, start: type.nameStart, len: type.nameLen, kw: "COpaque")
    }

    inout fn namedTypeCompatibility(expectedRef: U64, inferredRef: U64, te: TypeTerm, tin: TypeTerm) -> Result[TypeCompatibility, CompileDiagnostic] {
        val expectedBuiltin = self.isCompatibilityBuiltin(type: te)
        val inferredBuiltin = self.isCompatibilityBuiltin(type: tin)
        if expectedBuiltin || inferredBuiltin {
            if !(expectedBuiltin && inferredBuiltin) || !self.typeTermRefSameHead(a: expectedRef, b: inferredRef) {
                return <Result.Ok value=<TypeCompatibility.Incompatible /> />
            }
        } else if te.hasDecl && tin.hasDecl {
            if te.declOffset != tin.declOffset { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
        } else {
            // Resolve only legacy terms lacking an owner. The conservative
            // candidate head-name filter intentionally excludes C handles and
            // generic declarations, so it cannot prove final compatibility.
            val expectedDeclaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: te.nameStart), start: te.nameStart, len: te.nameLen)
            val inferredDeclaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: tin.nameStart), start: tin.nameStart, len: tin.nameLen)
            mut val expectedOwner = te.declOffset
            mut val inferredOwner = tin.declOffset
            if !te.hasDecl {
                if expectedDeclaration.nameLen == 0U64 { return <Result.Ok value=<TypeCompatibility.Unresolved /> /> }
                expectedOwner = expectedDeclaration.nameStart
            }
            if !tin.hasDecl {
                if inferredDeclaration.nameLen == 0U64 { return <Result.Ok value=<TypeCompatibility.Unresolved /> /> }
                inferredOwner = inferredDeclaration.nameStart
            }
            if expectedOwner != inferredOwner { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
        }
        // Once the nominal heads are known, a view is part of semantic type
        // identity even when the payload layout is unchanged. Unresolved
        // foreign binders above remain the responsibility of substitution.
        if te.viewExtId != tin.viewExtId || !self.sameCompatibilityViewSet(expectedRef: expectedRef, inferredRef: inferredRef) {
            return <Result.Ok value=<TypeCompatibility.Incompatible /> />
        }
        // same head: a generic head must agree on its type arguments.
        if te.args.len != tin.args.len { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
        if te.args.len != 0U64 {
            // covariant container erasure (spec/08, SE-0309): an arg widening concrete->`any P`
            // (`Dictionary[K, S]` -> `Dictionary[K, any P]`) is a genuine per-position REPACK,
            // which the backend performs only for `Array` and generic enums (Optional/Result/…).
            // For any OTHER head (Dictionary, a user struct, a tuple/record) the layouts differ
            // but no repack exists, so accepting it would silently miscompile — reject it here.
            mut val headErasable = rangeEquals(bytes: self.arena.bytes, start: te.nameStart, len: te.nameLen, kw: "Array")
            if !headErasable {
                headErasable = self.genericEnumIndexForType(ref: expectedRef) < self.arena.enumCount()
            }
            mut val i: U64 = 0
            while i < te.args.len {
                if !(headErasable) {
                    if self.argWidensToAny(expectedArg: self.arena.typeArgumentPool[te.args.start + i], inferredArg: self.arena.typeArgumentPool[tin.args.start + i]) {
                        return <Result.Ok value=<TypeCompatibility.Incompatible /> />
                    }
                }
                match (try self.typeCompatibility(expected: self.arena.typeArgumentPool[te.args.start + i], inferred: self.arena.typeArgumentPool[tin.args.start + i])) {
                    TypeCompatibility.Compatible => {}
                    TypeCompatibility.Incompatible => { return <Result.Ok value=<TypeCompatibility.Incompatible /> /> }
                    TypeCompatibility.Unresolved => { return <Result.Ok value=<TypeCompatibility.Unresolved /> /> }
                }
                i += 1
            }
        }
        return <Result.Ok value=<TypeCompatibility.Compatible /> />
    }

    // Whether `inferredArg` (a concrete named type) widens to `expectedArg` (`any P`) — the
    // covariant concrete->existential position. Used to gate that widening to the container
    // heads whose backend actually repacks it (compatNamed).
    inout fn argWidensToAny(expectedArg: U64, inferredArg: U64) -> Bool {
        if expectedArg >= self.arena.typeCount() || inferredArg >= self.arena.typeCount() {
            return false
        }
        val ea = self.arena.typeTerms[expectedArg]
        val ia = self.arena.typeTerms[inferredArg]
        if !(ea.isAny) || ia.isAny {
            return false
        }
        return self.knownNamedTypeIdForTerm(type: ia) != 0U64
    }

    inout fn activeTypeParamConformsToTrait(source: TypeRef, trait: TypeRef) -> Bool {
        if self.cur.checkFn >= self.arena.functionCount() {
            return false
        }
        val qTp: U64 = source.nameId
        val constraint: TraitConstraint = self.existentialTraitConstraintFor(t: trait)
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == self.cur.checkFn {
                if fb.paramNameId == qTp {
                    if constraint.key.owner != 0U64 && fb.constraint.key.owner == constraint.key.owner && fb.constraint.key.positionalArgs.count() == constraint.key.positionalArgs.count() {
                        mut val binds: Array[UnifyBind] = []
                        mut val ai: U64 = 0U64
                        mut val matches: Bool = true
                        while ai < fb.constraint.key.positionalArgs.count() {
                            if !(self.unifyPatterns(a: fb.constraint.key.positionalArgs[ai], aSide: 0U64, b: constraint.key.positionalArgs[ai], bSide: 1U64, aParams: <PatternBindInput.Values values=self.cur.typeParams />, bParams: <PatternBindInput.Values values=[] />, binds: inout binds)) {
                                matches = false
                            }
                            ai += 1U64
                        }
                        // Associated outputs are not positional trait inputs.
                        // A generic bound entails an existential constraint only
                        // when it promises the same selected-witness outputs;
                        // `T: Iter[Item=String]` must not erase to
                        // `any Iter[Item=I64]` merely because both share Iter.
                        if fb.constraint.assocPredicates.count() != constraint.assocPredicates.count() { matches = false }
                        mut val need: U64 = 0U64
                        while need < constraint.assocPredicates.count() {
                            mut val found: Bool = false
                            mut val bi: U64 = 0U64
                            while bi < fb.constraint.assocPredicates.count() {
                                val provided: TraitAssocPredicate = fb.constraint.assocPredicates[bi]
                                if provided.member == constraint.assocPredicates[need].member {
                                    if self.typeRefEq(a: provided.value, b: constraint.assocPredicates[need].value) { found = true }
                                }
                                bi += 1U64
                            }
                            if !found { matches = false }
                            need += 1U64
                        }
                        if matches {
                            return true
                        }
                    }
                }
            }
            bi += 1U64
        }
        return false
    }

    // The interned name id of a GENERIC struct def head (`Box` of `struct Box[T]`),
    // 0 when the span names no generic struct. compatNamed's identity supplement —
    // see the comment there.
    inout fn genericStructHeadId(start: U64, len: U64) -> U64 {
        val declaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: start), start: start, len: len)
        if declaration.nameLen == 0U64 { return 0U64 }
        val si = self.arena.structIndexByOffset(offset: declaration.nameStart)
        if si < self.arena.structCount() {
            if self.arena.structAt(index: si).typeParams.count() > 0U64 {
                return self.arena.structAt(index: si).nameId
            }
        }
        return 0U64
    }

    inout fn exprIsVoidCall(id: U64) -> Result[Bool, CompileDiagnostic] {
        match self.arena.exprs[id] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val fi: U64 = (try self.resolvedCallee(id: id))
                if fi < self.arena.functionCount() {
                    return <Result.Ok value=!self.arena.functionAt(index: fi).hasRet />
                }
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                // The verifier has already resolved every method-shaped call to its
                // final callable.  Value-context checking must consume that decision,
                // not re-resolve only the bare spelling and accidentally exclude `#`.
                val mi: U64 = (try self.resolvedCallee(id: id))
                if mi < self.arena.functionCount() {
                    return <Result.Ok value=!self.arena.functionAt(index: mi).hasRet />
                }
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                val mi: U64 = (try self.resolvedCallee(id: id))
                if mi < self.arena.functionCount() {
                    return <Result.Ok value=!self.arena.functionAt(index: mi).hasRet />
                }
            }
            _ => {}
        }
        return <Result.Ok value=false />
    }
    fn typeCompatibilityResult(matches: Bool) -> TypeCompatibility {
        if matches { return <TypeCompatibility.Compatible /> }
        return <TypeCompatibility.Incompatible />
    }
}
