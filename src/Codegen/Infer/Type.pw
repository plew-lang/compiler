// Part of type inference/checking (root: _.pw): expression type inference
// and type compatibility.

pub impl Comp {
    inout fn inferType(id: U64) -> U64 {
        // an un-suffixed integer literal has no intrinsic type — it adapts to its context
        // (`u64var + 5`, `val x: I32 = 5`). typeOf may attach an emission-context width to
        // it, but for type CHECKING it is genuinely unknown, so report 0 (a typed literal
        // `5I64` keeps its suffix type; `true`/`false` fall through to Bool).
        match self.arena.exprs[id] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, val tyLen, isNeg: _) => {
                if !(isBool) {
                    if tyLen == 0U64 {
                        return 0U64
                    }
                }
            }
            _ => {}
        }
        val ti: TypeInfo = self.typeOf(id: id)
        if ti.ref != 0U64 {
            return ti.ref
        }
        if ti.nameLen == 0U64 {
            return 0U64
        }
        // arrays (kind 3): conservative for now — their element comparison is deferred.
        if ti.kind == 3 {
            return 0U64
        }
        return self.simpleTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
    }

    inout fn isConcreteTypeName(start: U64, len: U64) -> Bool {
        if self.isPrimType(start: start, len: len) {
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "String") {
            return true
        }
        if self.knownNamedTypeId(start: start, len: len) != 0U64 {
            return true
        }
        return false
    }

    inout fn typesCompatible(expected: U64, inferred: U64) -> Bool {
        if expected == 0U64 || inferred == 0U64 {
            return true
        }
        if expected >= self.arena.types.count() || inferred >= self.arena.types.count() {
            return true
        }
        // ground the expected type through any active generic env (a `-> T` return / `T`
        // param resolves to the concrete instantiation argument); inferred is grounded.
        val exp: U64 = self.groundTypeRef(ref: expected)
        if exp >= self.arena.types.count() {
            return true
        }
        val te: TypeRef = self.arena.types[exp]
        val tin: TypeRef = self.arena.types[inferred]
        if te.isAny || tin.isAny {
            // a CONCRETE value coercing INTO `any P` must conform to P (spec/08) — else its
            // existential box has no vtable entry and a member call null-dereferences at
            // runtime. Check the conformance table when the source is a known concrete
            // struct/enum; a generic param (id 0, conforms via its `where` bound) or an
            // existing `any` source is left to the conservative pass-through.
            if te.isAny {
                if !(tin.isAny) {
                    val srcId: U64 = self.knownNamedTypeId(start: tin.nameStart, len: tin.nameLen)
                    if srcId != 0U64 {
                        val traitId: U64 = intern(c: inout self, start: te.nameStart, len: te.nameLen)
                        if !(self.conformExists(typeId: srcId, traitId: traitId)) {
                            return false
                        }
                    }
                }
            }
            return true
        }
        // float-to-float is exempt: F32 is currently lowered as F64 (true F32 deferred), so
        // an F64 value flowing into an F32 position is not a real mismatch yet, and a float
        // literal recovered as F64 may meet a float local reporting otherwise. But a float
        // paired with a NON-float (`val x: F64 = nI64`) IS a real mismatch — no implicit
        // int↔float conversion (spec/12) — so only exempt when BOTH sides are float. (An
        // untyped int LITERAL flowing into a float context is polymorphic and passes via the
        // unknown-id path below, not here.)
        val eFloat: Bool = self.isFloatType(start: te.nameStart, len: te.nameLen)
        val iFloat: Bool = self.isFloatType(start: tin.nameStart, len: tin.nameLen)
        if eFloat && iFloat {
            return true
        }
        if eFloat || iFloat {
            // one side float, the other not: a mismatch UNLESS the non-float side is an
            // untyped/unknown type (a bare int literal — polymorphic, handled below).
            if eFloat {
                if self.knownNamedTypeId(start: tin.nameStart, len: tin.nameLen) == 0U64 {
                    return true
                }
            } else {
                if self.knownNamedTypeId(start: te.nameStart, len: te.nameLen) == 0U64 {
                    return true
                }
            }
            return false
        }
        // generic-body abstract check (spec/06): a type parameter of the function being
        // checked (`self.cur.checkFn`) is an opaque DISTINCT type — incompatible with a
        // CONCRETE type or a DIFFERENT parameter of the same function, but lenient against
        // an unknown / another generic's type parameter (which unifies at instantiation,
        // e.g. passing this fn's `T` to `f[U](x: U)`). Active only while checking a generic
        // template body (curCheckFn valid); elsewhere isTypeParamOf is false.
        val eTp: Bool = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: te.nameStart, len: te.nameLen)
        val iTp: Bool = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: tin.nameStart, len: tin.nameLen)
        if eTp {
            if iTp {
                // both are this function's parameters: compatible iff the SAME one.
                return spansEqual(c: inout self, aStart: te.nameStart, aLen: te.nameLen, bStart: tin.nameStart, bLen: tin.nameLen)
            }
            // T vs a CONCRETE type -> incompatible; T vs unknown / another param -> lenient.
            if self.isConcreteTypeName(start: tin.nameStart, len: tin.nameLen) {
                return false
            }
            return true
        }
        if iTp {
            if self.isConcreteTypeName(start: te.nameStart, len: te.nameLen) {
                return false
            }
            return true
        }
        // the abstract Self of a trait provided-method body is likewise opaque: Self vs a
        // CONCRETE type -> incompatible (`return self` from `-> I64`), Self vs Self -> ok.
        val eSelf: Bool = self.isSelfTypeInProvided(start: te.nameStart, len: te.nameLen)
        val iSelf: Bool = self.isSelfTypeInProvided(start: tin.nameStart, len: tin.nameLen)
        if eSelf {
            if iSelf {
                return true
            }
            if self.isConcreteTypeName(start: tin.nameStart, len: tin.nameLen) {
                return false
            }
            return true
        }
        if iSelf {
            if self.isConcreteTypeName(start: te.nameStart, len: te.nameLen) {
                return false
            }
            return true
        }
        // two record types compare STRUCTURALLY, field-by-field — the record analog of the
        // generic-args comparison below. Records encode their components in the name, not in
        // top-level args, so a grounded `(a:I32,b:I32)` and the inferred template `(a:T,b:T)`
        // string-differ; recurse per field (`I32` vs `T`) so a type param matches its concrete
        // instantiation, exactly as `Box[T]` matches `Box[I32]`. Field VALUES are checked
        // precisely by tcCheckMakeFields; this only governs the type-level shape match.
        val eRec: Bool = te.nameLen > 0U64
        if eRec {
            if self.arena.bytes[te.nameStart] != 40U8 {
                return self.compatNamed(te: te, tin: tin)
            }
        } else {
            return self.compatNamed(te: te, tin: tin)
        }
        val iRec: Bool = tin.nameLen > 0U64
        if iRec {
            if self.arena.bytes[tin.nameStart] != 40U8 {
                return self.compatNamed(te: te, tin: tin)
            }
        } else {
            return self.compatNamed(te: te, tin: tin)
        }
        return self.recordsCompatible(teRef: exp, tinRef: inferred)
    }

    // Structural field-by-field compatibility of two record types (both names begin `(`).
    inout fn recordsCompatible(teRef: U64, tinRef: U64) -> Bool {
        val te: TypeRef = self.arena.types[teRef]
        val tin: TypeRef = self.arena.types[tinRef]
        val esi: U64 = self.structIndexByName(start: te.nameStart, len: te.nameLen)
        val isi: U64 = self.structIndexByName(start: tin.nameStart, len: tin.nameLen)
        if esi >= self.arena.structs.count() || isi >= self.arena.structs.count() {
            // a record StructDef not (yet) registered: fall back to exact name identity.
            return spansEqual(c: inout self, aStart: te.nameStart, aLen: te.nameLen, bStart: tin.nameStart, bLen: tin.nameLen)
        }
        val esd: StructDef = self.arena.structs[esi]
        val isd: StructDef = self.arena.structs[isi]
        if esd.fields.count() != isd.fields.count() {
            return false
        }
        // canonical layout is sorted by field name, so the i-th fields correspond; require
        // matching names and per-field type compatibility.
        mut val i: U64 = 0
        while i < esd.fields.count() {
            if !(spansEqual(c: inout self, aStart: esd.fields[i].nameStart, aLen: esd.fields[i].nameLen, bStart: isd.fields[i].nameStart, bLen: isd.fields[i].nameLen)) {
                return false
            }
            if !(self.typesCompatible(expected: esd.fields[i].ty, inferred: isd.fields[i].ty)) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn compatNamed(te: TypeRef, tin: TypeRef) -> Bool {
        mut val eId: U64 = self.knownNamedTypeId(start: te.nameStart, len: te.nameLen)
        mut val iId: U64 = self.knownNamedTypeId(start: tin.nameStart, len: tin.nameLen)
        // a GENERIC struct head (`Box` of `Box[I64]`) is a known type identity too.
        // knownNamedTypeId's struct lookup is concrete-only (its other callers gate
        // method/conformance checks that route generics through their own machinery),
        // so resolve the generic head here: instances of different generic defs are
        // incompatible, and same-def instances compare their args below — without
        // this, `Box[I64] = boxOfString` passed as "unknown head". (A generic ENUM
        // head is already found by knownNamedTypeId's arity-blind enum loop.)
        if eId == 0U64 {
            eId = self.genericStructHeadId(start: te.nameStart, len: te.nameLen)
        }
        if iId == 0U64 {
            iId = self.genericStructHeadId(start: tin.nameStart, len: tin.nameLen)
        }
        if eId == 0U64 || iId == 0U64 {
            return true
        }
        if eId != iId {
            return false
        }
        // same head: a generic head must agree on its type arguments.
        if te.args.count() == tin.args.count() {
            mut val i: U64 = 0
            while i < te.args.count() {
                if !(self.typesCompatible(expected: te.args[i], inferred: tin.args[i])) {
                    return false
                }
                i += 1
            }
        }
        return true
    }

    // The interned name id of a GENERIC struct def head (`Box` of `struct Box[T]`),
    // 0 when the span names no generic struct. compatNamed's identity supplement —
    // see the comment there.
    inout fn genericStructHeadId(start: U64, len: U64) -> U64 {
        val si: U64 = self.structDefByNameAny(start: start, len: len)
        if si < self.arena.structs.count() {
            if self.arena.structs[si].typeParams.count() > 0U64 {
                return self.arena.structs[si].nameId
            }
        }
        return 0U64
    }

    inout fn exprIsVoidCall(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val fi: U64 = self.resolvedCallee(id: id)
                if fi < self.arena.funcs.count() {
                    return !self.arena.funcs[fi].hasRet
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // (typeOf, cached: read only via kind==2 — a method receiver is never the
                // width-less int form, so this matches exprType.)
                val rt: TypeInfo = self.typeOf(id: recv)
                if rt.kind == 2 {
                    val mi: U64 = self.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if mi != self.arena.funcs.count() {
                        return !self.arena.funcs[mi].hasRet
                    }
                }
            }
            _ => {}
        }
        return false
    }
}
