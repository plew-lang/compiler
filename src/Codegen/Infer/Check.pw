// Part of type inference/checking (root: _.pw): checking expressions, operators,
// assignments, indices, and make-fields against an expected type.

pub impl Comp {
    inout fn tcCheckValue(expectedRef: U64, valueExpr: U64, pos: String) {
        if expectedRef == 0U64 {
            return
        }
        // a function VALUE (closure literal / function reference) flowing into a fn-typed
        // position must match the signature, everywhere tcCheckValue runs (binding, return,
        // arg, struct field, array element). isFnType-gated, so a no-op otherwise.
        self.checkFnValueSig(declTy: expectedRef, init: valueExpr)
        // a void function's result is `()` — using it where a typed value is expected
        // (`val x: I64 = doNothing()`) is a type error (spec/04).
        if self.exprIsVoidCall(id: valueExpr) {
            if !(self.tcLog) {
                compileErrorAt(line: self.lineOf(offset: self.exprOffset(id: valueExpr)), msg: "cannot use the result of a function that returns no value (spec/04)")
            }
            return
        }
        // an array literal (`[]` / `[a, b]`) in a Dictionary-typed position: `[]` is ALWAYS
        // an empty array, never a dict — `[:]` is the empty-dictionary literal (spec/02). An
        // empty `[]` here used to coincidentally read count 0 in a let binding yet reinterpret
        // to garbage as an argument; reject it with a clear pointer to `[:]`.
        if expectedRef < self.arena.types.count() {
            if rangeEquals(bytes: self.arena.bytes, start: self.arena.types[expectedRef].nameStart, len: self.arena.types[expectedRef].nameLen, kw: "Dictionary") {
                match self.arena.exprs[valueExpr] {
                    Expr.Array(elems: _) => {
                        if !(self.tcLog) {
                            compileErrorAt(line: self.lineOf(offset: self.exprOffset(id: valueExpr)), msg: "a dictionary value cannot be an array literal — use `[:]` for an empty dictionary, or `[k: v]` for entries (`[]` is an array literal; spec/02)")
                        }
                        return
                    }
                    _ => {}
                }
            }
        }
        // a generic construction in a typed position (`val o: Optional[I64] = <Optional.Some
        // v="x"/>`): recurse into its fields, grounding each declared field type under the
        // EXPECTED instance's type arguments, and check the field value. This is the
        // generic-payload case the head-name checks can't see (the un-annotated construction
        // carries no type args itself; they come from the expected type).
        self.tcCheckMakeFields(expectedRef: expectedRef, makeId: valueExpr)
        // a value-position if/match (`val x: I64 = if c { give A } else { give B }`): each
        // branch's give value must match the expected type — so a divergent branch (`give
        // "s"` where I64 is wanted) is caught even when another branch matches.
        match self.arena.exprs[valueExpr] {
            Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                val tv: U64 = self.tcBlockGiveValue(blockId: thenBlk)
                if tv != 0U64 {
                    self.tcCheckValue(expectedRef: expectedRef, valueExpr: tv, pos: "if-branch")
                }
                val ev: U64 = self.tcBlockGiveValue(blockId: elseBlk)
                if ev != 0U64 {
                    self.tcCheckValue(expectedRef: expectedRef, valueExpr: ev, pos: "if-branch")
                }
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count() {
                    // skip an arm that binds payload fields: its binds are not in scope at
                    // this (the match-expr) position and may shadow an outer name, so
                    // inferType on the arm body would resolve the shadowed name wrongly.
                    // a diverging arm (`=> panic`) yields no value to check.
                    if !(arms[ai].isDiverge) {
                        if arms[ai].binds.count() == 0U64 {
                            val g: U64 = self.blockGiveExpr(blkId: arms[ai].body)
                            if g < self.arena.exprs.count() {
                                self.tcCheckValue(expectedRef: expectedRef, valueExpr: g, pos: "match-branch")
                            }
                        }
                    }
                    ai += 1
                }
            }
            Expr.Array(val elems) => {
                // an array literal in a typed position (`Array[I64] = [1I64, true]`,
                // nested `Array[Array[I64]] = [[1I64], [true]]`): each element must match
                // the expected element type. Recurses, so arbitrary nesting is covered —
                // inferType doesn't precisely type a literal's element, so this is the
                // element check. (Only when the expected type is a known `Array[E]`.)
                if expectedRef < self.arena.types.count() {
                    val et: TypeRef = self.arena.types[expectedRef]
                    if rangeEquals(bytes: self.arena.bytes, start: et.nameStart, len: et.nameLen, kw: "Array") {
                        if et.args.count() > 0U64 {
                            mut val ei: U64 = 0
                            while ei < elems.count() {
                                self.tcCheckValue(expectedRef: et.args[0], valueExpr: elems[ei], pos: "element")
                                ei += 1
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        val inferred: U64 = self.inferType(id: valueExpr)
        if self.typesCompatible(expected: expectedRef, inferred: inferred) {
            return
        }
        if self.tcLog {
            eprint(text: "TC ")
            eprint(text: pos)
            eprint(text: " expected=")
            eprint(text: self.tcRefName(ref: self.groundTypeRef(ref: expectedRef)))
            eprint(text: " got=")
            eprint(text: self.tcRefName(ref: inferred))
            eprint(text: " from=")
            eprint(text: self.tcExprKind(id: valueExpr))
            eprint(text: " line=")
            eprintInt(n: self.lineOf(offset: self.exprOffset(id: valueExpr)))
            eprint(text: "\n")
        } else {
            compileErrorAt(line: self.lineOf(offset: self.exprOffset(id: valueExpr)), msg: "type mismatch: this value's type does not match the type required here (Plew has no implicit conversion — spec/12)")
        }
    }

    inout fn tcCheckBinop(op: I64, lhs: U64, rhs: U64) {
        // `&&` / `||` are short-circuit control flow (spec/12), not a trait op: both
        // operands must be Bool (`1I64 && true` has no truthiness coercion).
        if op == opAnd() || op == opOr() {
            val bs: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
            if bs.nameLen != 0U64 {
                val boolRef: U64 = self.simpleTypeRef(nameStart: bs.nameStart, nameLen: bs.nameLen)
                self.tcCheckValue(expectedRef: boolRef, valueExpr: lhs, pos: "logical")
                self.tcCheckValue(expectedRef: boolRef, valueExpr: rhs, pos: "logical")
            }
            return
        }
        // arithmetic (Add/Sub/Mul/Div/Rem) and comparison (Eq/Ne/Lt/Le/Gt/Ge).
        mut val isCompare: Bool = false
        if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            isCompare = true
        }
        mut val handled: Bool = isCompare
        if op == opAdd() || op == opSub() || op == opMul() || op == opDiv() || op == opRem() {
            handled = true
        }
        // bitwise/shift: a primitive's witnesses are all same-type (`impl I8 as Shl[I8]`,
        // not `Shl[U64]`), so mixed primitive operands have no witness — same as arith.
        if op == opBitAnd() || op == opBitOr() || op == opBitXor() || op == opShl() || op == opShr() {
            handled = true
        }
        if !(handled) {
            return
        }
        val l: U64 = self.inferType(id: lhs)
        val r: U64 = self.inferType(id: rhs)
        if l == 0U64 || r == 0U64 {
            return
        }
        if l >= self.arena.types.count() || r >= self.arena.types.count() {
            return
        }
        // comparison is `Eq`/`Ord` on the SAME type (no Rhs), so the operands must match
        // for EVERY type (`"a" == 1I64`, `aI32 < bI64`) — not just primitives.
        if isCompare {
            self.tcCheckValue(expectedRef: l, valueExpr: rhs, pos: "compare")
            return
        }
        // a PRIMITIVE numeric LHS forces the RHS to be the SAME type — a primitive's
        // operator witnesses are all same-type (`impl I32 as Add[I32]`, `Ord` on Self,
        // `Shl[I32]`), and `a OP b` always dispatches on the LHS type. So the RHS must
        // match `l` whether it is another primitive (`3I32 + 5I64`), a non-numeric
        // primitive (`1I64 + true`), or any other type — there is no `Add[Bool]` /
        // `Add[Money]` on a primitive int. typesCompatible carries the F32/F64 leniency
        // and the int↔float rejection. A non-numeric LHS (a user type whose `Add[Rhs]`
        // may legitimately differ) is excluded here — its witness is checked elsewhere.
        val lNum: Bool = self.isIntType(start: self.arena.types[l].nameStart, len: self.arena.types[l].nameLen) || self.isFloatType(start: self.arena.types[l].nameStart, len: self.arena.types[l].nameLen)
        if lNum {
            self.tcCheckValue(expectedRef: l, valueExpr: rhs, pos: "binop")
        }
    }

    inout fn tcIsUnsignedInt(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.types.count() {
            return false
        }
        val t: TypeRef = self.arena.types[ref]
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U8") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U16") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U32") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U64") { return true }
        return false
    }

    inout fn tcUnaryReject(operand: U64, msg: String) {
        if self.tcLog {
            eprint(text: "TC unary ")
            eprint(text: msg)
            eprint(text: " got=")
            eprint(text: self.tcRefName(ref: self.inferType(id: operand)))
            eprint(text: " line=")
            eprintInt(n: self.lineOf(offset: self.exprOffset(id: operand)))
            eprint(text: "\n")
        } else {
            compileErrorAt(line: self.lineOf(offset: self.exprOffset(id: operand)), msg: msg)
        }
    }

    inout fn tcCheckUnary(op: I64, operand: U64) {
        val t: U64 = self.inferType(id: operand)
        if t == 0U64 || t >= self.arena.types.count() {
            return
        }
        val tn: TypeRef = self.arena.types[t]
        val isInt: Bool = self.isIntType(start: tn.nameStart, len: tn.nameLen)
        val isBool: Bool = rangeEquals(bytes: self.arena.bytes, start: tn.nameStart, len: tn.nameLen, kw: "Bool")
        val isFloat: Bool = self.isFloatType(start: tn.nameStart, len: tn.nameLen)
        // String is a primitive with NO Neg/Not/BitNot witness, so judge it too (`-s`
        // falls to each branch's reject). only judge a primitive operand (int / Bool /
        // float / String); skip user types (which may implement Neg/Not/BitNot).
        val isString: Bool = rangeEquals(bytes: self.arena.bytes, start: tn.nameStart, len: tn.nameLen, kw: "String")
        if !(isInt || isBool || isFloat || isString) {
            return
        }
        if op == opSub() {
            if !(isFloat) {
                if !(isInt && !self.tcIsUnsignedInt(ref: t)) {
                    self.tcUnaryReject(operand: operand, msg: "unary `-` (Neg) is for signed integers / floats only (spec/12)")
                }
            }
        } else {
            if op == opNot() {
                if !(isBool) {
                    self.tcUnaryReject(operand: operand, msg: "unary `!` (Not) requires a Bool operand (spec/12)")
                }
            } else {
                if op == opBitNot() {
                    if !(isInt) {
                        self.tcUnaryReject(operand: operand, msg: "unary `~` (BitNot) requires an integer operand (spec/12)")
                    }
                }
            }
        }
    }

    inout fn tcIsPrimInt(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.types.count() {
            return false
        }
        return self.isIntType(start: self.arena.types[ref].nameStart, len: self.arena.types[ref].nameLen)
    }

    inout fn tcCheckCompoundAssign(op: I64, target: U64, value: U64) {
        if !(op == opAddAssign() || op == opSubAssign() || op == opMulAssign() || op == opDivAssign() || op == opRemAssign()) {
            return
        }
        val l: U64 = self.inferType(id: target)
        if l == 0U64 || l >= self.arena.types.count() {
            return
        }
        // a primitive numeric target forces the value to match (same as the binop it
        // desugars to: `x: I64; x += true` / `x += "a"` has no `Add[Bool]`/`Add[String]`
        // on I64). A user-type target uses `Add[Rhs]` and is checked by its own witness.
        if self.isIntType(start: self.arena.types[l].nameStart, len: self.arena.types[l].nameLen) || self.isFloatType(start: self.arena.types[l].nameStart, len: self.arena.types[l].nameLen) {
            self.tcCheckValue(expectedRef: l, valueExpr: value, pos: "compound")
        }
    }

    inout fn tcCheckArrayIndex(base: U64, index: U64) {
        val bt: TypeInfo = self.typeOf(id: base)
        if bt.kind == 3 {
            val u64: Bind = self.kwSpan(kw: "U64", kwLen: 3U64)
            if u64.nameLen == 0U64 {
                return
            }
            self.tcCheckValue(expectedRef: self.simpleTypeRef(nameStart: u64.nameStart, nameLen: u64.nameLen), valueExpr: index, pos: "index")
            return
        }
        val br: U64 = self.inferType(id: base)
        if br != 0U64 {
            if br < self.arena.types.count() {
                val bref: TypeRef = self.arena.types[br]
                if rangeEquals(bytes: self.arena.bytes, start: bref.nameStart, len: bref.nameLen, kw: "Dictionary") {
                    if bref.args.count() >= 1U64 {
                        self.tcCheckValue(expectedRef: bref.args[0], valueExpr: index, pos: "dictkey")
                    }
                }
            }
        }
    }

    inout fn tcBlockGiveValue(blockId: U64) -> U64 {
        if blockId == 0U64 || blockId >= self.arena.blocks.count() {
            return 0U64
        }
        val stmts: Array[U64] = self.arena.blocks[blockId].stmts
        if stmts.count() == 0U64 {
            return 0U64
        }
        match self.arena.stmts[stmts[stmts.count() - 1U64]] {
            Stmt.Give(val value) => { return value }
            _ => { return 0U64 }
        }
    }

    inout fn tcCheckMakeFields(expectedRef: U64, makeId: U64) {
        if expectedRef >= self.arena.types.count() {
            return
        }
        val et: TypeRef = self.arena.types[expectedRef]
        // a record literal in a typed record position (`pair: (a:I32,b:I32) = (a:3I32,b:4I32)`):
        // the literal carries the TEMPLATE record name `(a:T,b:T)` (lowered under the field's
        // declared type), but `et` is the GROUNDED record whose StructDef fields hold the
        // concrete types. Records encode their components in the name (no top-level args), so
        // the generic-args path below misses them — check each field value against the grounded
        // field type directly (`3I32` vs `I32`). This is the record analog of tcCheckFieldsUnder.
        if et.nameLen > 0U64 {
            if self.arena.bytes[et.nameStart] == 40U8 {
                match self.arena.exprs[makeId] {
                    Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                        val rsi: U64 = self.structIndexByName(start: et.nameStart, len: et.nameLen)
                        if rsi < self.arena.structs.count() {
                            val rsd: StructDef = self.arena.structs[rsi]
                            mut val rmi: U64 = 0
                            while rmi < fields.count() {
                                mut val rdi: U64 = 0
                                while rdi < rsd.fields.count() {
                                    if spansEqual(c: inout self, aStart: rsd.fields[rdi].nameStart, aLen: rsd.fields[rdi].nameLen, bStart: fields[rmi].nameStart, bLen: fields[rmi].nameLen) {
                                        if rsd.fields[rdi].ty != 0U64 {
                                            self.tcCheckValue(expectedRef: rsd.fields[rdi].ty, valueExpr: fields[rmi].value, pos: "record-field")
                                        }
                                        rdi = rsd.fields.count()
                                    } else {
                                        rdi += 1
                                    }
                                }
                                rmi += 1
                            }
                        }
                    }
                    _ => {}
                }
                return
            }
        }
        if et.args.count() == 0U64 {
            return
        }
        match self.arena.exprs[makeId] {
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, ty: _, val fields) => {
                if intern(c: inout self, start: typeStart, len: typeLen) != et.nameId {
                    return
                }
                // Ref[T] / WeakRef[T] are lang items (not registered generic structs), so
                // the struct lookup below misses them. Their `value` field is T — check it
                // (`<Ref[I64] value=true/>` would otherwise box a Bool as an I64).
                if rangeEquals(bytes: self.arena.bytes, start: et.nameStart, len: et.nameLen, kw: "Ref") || rangeEquals(bytes: self.arena.bytes, start: et.nameStart, len: et.nameLen, kw: "WeakRef") {
                    if et.args.count() >= 1U64 {
                        mut val rfi: U64 = 0
                        while rfi < fields.count() {
                            if rangeEquals(bytes: self.arena.bytes, start: fields[rfi].nameStart, len: fields[rfi].nameLen, kw: "value") {
                                self.tcCheckValue(expectedRef: et.args[0], valueExpr: fields[rfi].value, pos: "ref value")
                            }
                            rfi += 1
                        }
                    }
                    return
                }
                if isEnum {
                    val ei: U64 = self.genericEnumIndex(nameStart: et.nameStart, nameLen: et.nameLen)
                    if ei >= self.arena.enums.count() {
                        return
                    }
                    val vi: U64 = self.variantIndex(enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen)
                    if vi >= self.arena.enums[ei].variants.count() {
                        return
                    }
                    self.tcCheckFieldsUnder(params: self.arena.enums[ei].typeParams, targs: et.args, defFields: self.arena.enums[ei].variants[vi].fields, makeFields: fields)
                } else {
                    val si: U64 = self.genericStructIndex(nameStart: et.nameStart, nameLen: et.nameLen)
                    if si >= self.arena.structs.count() {
                        return
                    }
                    self.tcCheckFieldsUnder(params: self.arena.structs[si].typeParams, targs: et.args, defFields: self.arena.structs[si].fields, makeFields: fields)
                }
            }
            _ => {}
        }
    }

    inout fn tcCheckFieldsUnder(params: Array[Bind], targs: Array[U64], defFields: Array[FieldDef], makeFields: Array[MakeField]) {
        mut val mi: U64 = 0
        while mi < makeFields.count() {
            mut val di: U64 = 0
            while di < defFields.count() {
                if spansEqual(c: inout self, aStart: defFields[di].nameStart, aLen: defFields[di].nameLen, bStart: makeFields[mi].nameStart, bLen: makeFields[mi].nameLen) {
                    if defFields[di].ty != 0U64 {
                        val savedP: Array[Bind] = self.cur.typeParams
                        val savedA: Array[U64] = self.cur.typeArgs
                        self.cur.typeParams = params
                        self.cur.typeArgs = targs
                        val grounded: U64 = self.groundTypeRef(ref: defFields[di].ty)
                        self.cur.typeParams = savedP
                        self.cur.typeArgs = savedA
                        self.tcCheckValue(expectedRef: grounded, valueExpr: makeFields[mi].value, pos: "ginst-field")
                    }
                    di = defFields.count()
                } else {
                    di += 1
                }
            }
            mi += 1
        }
    }

    inout fn tcFieldPos(prefix: String, nameStart: U64, nameLen: U64) -> String {
        mut val bs: Array[U8] = []
        appendBytes(into: inout bs, from: prefix.bytes())
        mut val i: U64 = 0
        while i < nameLen {
            bs.append(self.arena.bytes[nameStart + i])
            i += 1
        }
        return stringFromBytesUnchecked(b: bs)
    }

    inout fn tcExprKind(id: U64) -> String {
        match self.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => { return "Call" }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { return "Method" }
            Expr.Field(base: _, val nameStart, val nameLen) => {
                mut val bs: Array[U8] = []
                appendBytes(into: inout bs, from: "Field:".bytes())
                mut val i: U64 = 0
                while i < nameLen {
                    bs.append(self.arena.bytes[nameStart + i])
                    i += 1
                }
                return stringFromBytesUnchecked(b: bs)
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, fields: _) => { return "Make" }
            Expr.MatchExpr(scrut: _, arms: _) => { return "MatchExpr" }
            Expr.Ident(val start, val len) => {
                mut val bs: Array[U8] = []
                appendBytes(into: inout bs, from: "Ident:".bytes())
                mut val i: U64 = 0
                while i < len {
                    bs.append(self.arena.bytes[start + i])
                    i += 1
                }
                return stringFromBytesUnchecked(b: bs)
            }
            Expr.Index(base: _, index: _) => { return "Index" }
            Expr.Binary(op: _, lhs: _, rhs: _) => { return "Binary" }
            Expr.Cast(operand: _, tyStart: _, tyLen: _, ty: _) => { return "Cast" }
            Expr.Int(value: _, offset: _, isBool: _, val tyStart, val tyLen, isNeg: _) => {
                mut val bs: Array[U8] = []
                appendBytes(into: inout bs, from: "Int:".bytes())
                mut val i: U64 = 0
                while i < tyLen {
                    bs.append(self.arena.bytes[tyStart + i])
                    i += 1
                }
                return stringFromBytesUnchecked(b: bs)
            }
            Expr.Unary(op: _, operand: _) => { return "Unary" }
            _ => { return "other" }
        }
    }

    inout fn tcRefName(ref: U64) -> String {
        if ref == 0U64 || ref >= self.arena.types.count() {
            return "?"
        }
        val t: TypeRef = self.arena.types[ref]
        mut val bs: Array[U8] = []
        mut val i: U64 = 0
        while i < t.nameLen {
            bs.append(self.arena.bytes[t.nameStart + i])
            i += 1
        }
        return stringFromBytesUnchecked(b: bs)
    }
}
