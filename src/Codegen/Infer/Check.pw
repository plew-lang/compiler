// Part of type inference/checking (root: _.pw): checking expressions, operators,
// assignments, indices, and make-fields against an expected type.

pub impl Comp {
    inout fn tcCheckValue(expectedRef: U64, valueExpr: U64, pos: String) -> Result[(), CompileDiagnostic] {
        if expectedRef == 0U64 {
            return <Result.Ok value=() />
        }
        try self.requireExpressionValue(exprId: valueExpr)
        // Unit is a known result state, independent of syntax and hasRet.
        // Compare its completed type before any construction-time fallback.
        if self.recordedExpressionHasUnitResult(exprId: valueExpr) {
            val expected = try self.groundTypeRef(ref: expectedRef)
            if expected != 0U64 && self.callableResultIsUnit(ref: expected) { return <Result.Ok value=() /> }
            if !(self.tcLog) {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "cannot use a Unit result where a non-Unit value is required (spec/04)") />
            }
            return <Result.Ok value=() />
        }
        // an array literal (`[]` / `[a, b]`) in a Dictionary-typed position: `[]` is ALWAYS
        // an empty array, never a dict — `[:]` is the empty-dictionary literal (spec/02). An
        // empty `[]` here used to coincidentally read count 0 in a let binding yet reinterpret
        // to garbage as an argument; reject it with a clear pointer to `[:]`.
        if expectedRef < self.arena.typeCount() {
            if rangeEquals(bytes: self.arena.bytes, start: self.arena.typeTerms[expectedRef].nameStart, len: self.arena.typeTerms[expectedRef].nameLen, kw: "Dictionary") {
                match self.arena.exprs[valueExpr] {
                    Expr.Array(elems: _) => {
                        if !(self.tcLog) {
                            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "a dictionary value cannot be an array literal — use `[:]` for an empty dictionary, or `[k: v]` for entries (`[]` is an array literal; spec/02)") />
                        }
                        return <Result.Ok value=() />
                    }
                    _ => {}
                }
            }
        }
        // a generic construction in a typed position (`val o: Optional[I64] = <Optional.Some
        // v="x"/>`): recurse into its fields, grounding each declared field type under the
        // EXPECTED instance's type arguments, and check the field value. This is the
        // generic-payload case the head-name checks can't see (the un-annotated construction
        // carries no type args itself; they come from the expected type).
        try self.tcCheckMakeFields(expectedRef: expectedRef, makeId: valueExpr)
        // Field checking supplies construction context. It is not evidence
        // that the complete source record matches the destination: the saved
        // semantic type must still pass the ordinary compatibility check.
        // Value-control results were checked with their lexical bindings by
        // Record. Do not reopen their give expressions outside that scope.
        match self.arena.exprs[valueExpr] {
            Expr.Array(val elems) => {
                // an array literal in a typed position (`Array[I64] = [1I64, true]`,
                // nested `Array[Array[I64]] = [[1I64], [true]]`): each element must match
                // the expected element type. Recurses, so arbitrary nesting is covered —
                // inferType doesn't precisely type a literal's element, so this is the
                // element check. (Only when the expected type is a known `Array[E]`.)
                if expectedRef < self.arena.typeCount() {
                    val et: TypeRef = self.arena.typeAt(index: expectedRef)
                    if rangeEquals(bytes: self.arena.bytes, start: et.nameStart, len: et.nameLen, kw: "Array") {
                        if et.args.count() > 0U64 {
                            mut val ei: U64 = 0
                            while ei < elems.len {
                                try self.tcCheckValue(expectedRef: et.args[0], valueExpr: self.exprAt(exprs: elems, index: ei), pos: "element")
                                ei += 1
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        // Numeric syntax supplies context only before a semantic type exists.
        // A recorded literal is an ordinary typed value, just like a binding
        // or an explicitly suffixed literal; never reinterpret it on recheck.
        if contextualNumericExpression(self.arena.exprs, exprId: valueExpr) && self.semanticExprTerm(exprId: valueExpr) == 0U64 {
            val expectedGround = (try self.groundTypeRef(ref: expectedRef))
            if expectedGround < self.arena.typeCount() {
                val expected = self.arena.typeAt(index: expectedGround)
                if self.isFloatType(start: expected.nameStart, len: expected.nameLen) {
                    return <Result.Ok value=() />
                }
            }
        }
        val inferred = try self.groundedTypeOf(id: valueExpr)
        val compatibility = try self.typeCompatibility(expected: expectedRef, inferred: inferred)
        if self.traceCodegen && !compatibility.isCompatible() {
            eprint(text: "[trace-codegen] value-type-mismatch expected=")
            self.traceMonoTypeHead(ref: expectedRef)
            eprint(text: " inferred=")
            self.traceMonoTypeHead(ref: inferred)
            eprint(text: " expr=")
            eprintU64(n: valueExpr)
            eprint(text: " position=")
            eprint(text: pos)
            eprint(text: " unresolved=")
            if compatibility.isUnresolved() { eprint(text: "true\n") } else { eprint(text: "false\n") }
        }
        match compatibility {
            TypeCompatibility.Compatible => { return <Result.Ok value=() /> }
            TypeCompatibility.Unresolved => {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "cannot establish this value's type from the available context") />
            }
            TypeCompatibility.Incompatible => {}
        }
        if !self.tcLog && self.isFnType(ref: expectedRef) && self.isFnType(ref: inferred) {
            val expectedGround = try self.groundTypeRef(ref: expectedRef)
            val expected = self.arena.typeTerms[expectedGround]
            val actual = self.arena.typeTerms[inferred]
            if expected.args.len != actual.args.len {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "function value has the wrong number of parameters for the expected function type (spec/04)") />
            }
            mut val index = 0U64
            while index < expected.args.len {
                if self.typeTermRefIdentityChildLabel(ref: expectedGround, index: index) != self.typeTermRefIdentityChildLabel(ref: inferred, index: index) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "function value's parameter label does not match the expected function type (spec/04)") />
                }
                if !((try self.typesCompatible(expected: self.arena.typeArgumentPool[expected.args.start + index], inferred: self.arena.typeArgumentPool[actual.args.start + index]))) {
                    if index == 0U64 {
                        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "function value's return type does not match the expected function type (spec/04)") />
                    }
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "function value's parameter type does not match the expected function type (spec/04)") />
                }
                index += 1U64
            }
        }
        if expectedRef < self.arena.typeCount() {
            val expectedGround: U64 = (try self.groundTypeRef(ref: expectedRef))
            if expectedGround < self.arena.typeCount() {
                val expectedTy: TypeRef = self.arena.typeAt(index: expectedGround)
                if expectedTy.isSendable {
                    if inferred != 0U64 {
                        if inferred < self.arena.typeCount() {
                            if !((try self.typeRefIsSendable(ref: inferred))) {
                                if !(self.tcLog) {
                                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "this value does not provide the `sendable` guarantee required here (use a `sendable fn` literal or a structurally sendable value; spec/04,14)") />
                                }
                                return <Result.Ok value=() />
                            }
                        }
                    }
                }
            }
        }
        if self.tcLog {
            eprint(text: "TC ")
            eprint(text: pos)
            eprint(text: " expected=")
            eprint(text: self.tcRefName(ref: (try self.groundTypeRef(ref: expectedRef))))
            eprint(text: " got=")
            eprint(text: self.tcRefName(ref: inferred))
            eprint(text: " from=")
            eprint(text: self.tcExprKind(id: valueExpr))
            eprint(text: " line=")
            eprintInt(n: self.lineOf(offset: self.exprOffset(id: valueExpr)))
            eprint(text: "\n")
        } else {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: valueExpr), msg: "type mismatch: this value's type does not match the type required here (Plew has no implicit conversion — spec/12)") />
        }
        return <Result.Ok value=() />
    }

    inout fn tcCheckBinop(op: I64, lhs: U64, rhs: U64) -> Result[(), CompileDiagnostic] {
        // `&&` / `||` are short-circuit control flow (spec/12), not a trait op: both
        // operands must be Bool (`1I64 && true` has no truthiness coercion).
        if op == opAnd() || op == opOr() {
            val bs: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
            if bs.nameLen != 0U64 {
                val boolRef: U64 = self.simpleTypeRef(nameStart: bs.nameStart, nameLen: bs.nameLen)
                try self.tcCheckValue(expectedRef: boolRef, valueExpr: lhs, pos: "logical")
                try self.tcCheckValue(expectedRef: boolRef, valueExpr: rhs, pos: "logical")
            }
            return <Result.Ok value=() />
        }
        // arithmetic (Add/Sub/Mul/Div/Rem) and comparison (Eq/Ne/Lt/Le/Gt/Ge).
        mut val isCompare: Bool = false
        if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            isCompare = true
        }
        mut val handled: Bool = isCompare
        if op == opAdd() || op == opSub() || op == opMul() || op == opDiv() || op == opRem() {
            handled = true
        }
        // bitwise/shift: a primitive's witnesses are all same-type (`impl I8 as Shl[I8]`,
        // not `Shl[U64]`), so mixed primitive operands have no witness — same as arith.
        if op == opBitAnd() || op == opBitOr() || op == opBitXor() || op == opShl() || op == opShr() {
            handled = true
        }
        if !(handled) {
            return <Result.Ok value=() />
        }
        mut val l = try self.inferType(id: lhs)
        mut val r = try self.inferType(id: rhs)
        // Resolve lexical Self/associated bindings before selecting a
        // signature, just as value compatibility normalizes its two terms.
        if l != 0U64 { l = try self.groundTypeRef(ref: l) }
        if r != 0U64 { r = try self.groundTypeRef(ref: r) }
        // An unsuffixed left operand takes the typed right operand's context,
        // using the same direction rule as semantic expression recording.
        if self.acceptsFloatingOperandContext(exprId: lhs, siblingExprId: rhs, siblingTerm: r) {
            try self.tcCheckValue(expectedRef: r, valueExpr: lhs, pos: "binop")
            return <Result.Ok value=() />
        }
        val resolution = try self.staticOperatorTemplateResolution(op: op, receiverTerm: l, isUnary: false)
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                val parameter = try self.staticRequirementParamTypeAt(resolution: resolution, paramIdx: 1U64)
                if parameter == 0U64 {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: rhs), msg: "operator requirement has no resolved right operand type") />
                }
                try self.tcCheckValue(expectedRef: parameter, valueExpr: rhs, pos: "operator argument")
                return <Result.Ok value=() />
            }
            _ => {}
        }
        if l == 0U64 || r == 0U64 {
            return <Result.Ok value=() />
        }
        if l >= self.arena.typeCount() || r >= self.arena.typeCount() {
            return <Result.Ok value=() />
        }
        // Availability is checked separately; operand compatibility must use
        // the complete selected signature for every receiver, not just numbers.
        val selected = try self.findBinTraitWitnessForRef(receiverRef: l, op: op, rhsRef: r, rhsUntyped: false)
        if selected < self.arena.functionCount() { return <Result.Ok value=() /> }
        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: rhs), msg: "type mismatch: this value's type does not match the type required here; no operator implementation accepts this right operand type (spec/12)") />
    }

    inout fn tcIsUnsignedInt(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.typeCount() {
            return false
        }
        val t: TypeRef = self.arena.typeAt(index: ref)
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U8") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U16") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U32") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "U64") { return true }
        return false
    }

    inout fn tcUnaryReject(operand: U64, msg: String) -> Result[(), CompileDiagnostic] {
        if self.tcLog {
            eprint(text: "TC unary ")
            eprint(text: msg)
            eprint(text: " got=")
            eprint(text: self.tcRefName(ref: (try self.inferType(id: operand))))
            eprint(text: " line=")
            eprintInt(n: self.lineOf(offset: self.exprOffset(id: operand)))
            eprint(text: "\n")
        } else {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: msg) />
        }
        return <Result.Ok value=() />
    }

    inout fn tcCheckUnary(op: I64, operand: U64) -> Result[(), CompileDiagnostic] {
        val t: U64 = (try self.inferType(id: operand))
        if t == 0U64 || t >= self.arena.typeCount() {
            return <Result.Ok value=() />
        }
        val tn: TypeRef = self.arena.typeAt(index: t)
        val isInt: Bool = self.isIntType(start: tn.nameStart, len: tn.nameLen)
        val isBool: Bool = rangeEquals(bytes: self.arena.bytes, start: tn.nameStart, len: tn.nameLen, kw: "Bool")
        val isFloat: Bool = self.isFloatType(start: tn.nameStart, len: tn.nameLen)
        // String is a primitive with NO Neg/Not/BitNot witness, so judge it too (`-s`
        // falls to each branch's reject). only judge a primitive operand (int / Bool /
        // float / String); skip user types (which may implement Neg/Not/BitNot).
        val isString: Bool = rangeEquals(bytes: self.arena.bytes, start: tn.nameStart, len: tn.nameLen, kw: "String")
        if !(isInt || isBool || isFloat || isString) {
            return <Result.Ok value=() />
        }
        if op == opSub() {
            if !(isFloat) {
                if !(isInt && !self.tcIsUnsignedInt(ref: t)) {
                    try self.tcUnaryReject(operand: operand, msg: "unary `-` (Neg) is for signed integers / floats only (spec/12)")
                }
            }
        } else {
            if op == opNot() {
                if !(isBool) {
                    try self.tcUnaryReject(operand: operand, msg: "unary `!` (Not) requires a Bool operand (spec/12)")
                }
            } else {
                if op == opBitNot() {
                    if !(isInt) {
                        try self.tcUnaryReject(operand: operand, msg: "unary `~` (BitNot) requires an integer operand (spec/12)")
                    }
                }
            }
        }
        return <Result.Ok value=() />
    }

    inout fn tcIsPrimInt(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.typeCount() {
            return false
        }
        val term = self.arena.typeTerms[ref]
        return self.isIntType(start: term.nameStart, len: term.nameLen)
    }

    inout fn tcCheckArrayIndex(base: U64, index: U64) -> Result[(), CompileDiagnostic] {
        val bt: TypeInfo = (try self.typeOf(id: base))
        if bt.kind == 3 {
            val u64: Bind = self.kwSpan(kw: "U64", kwLen: 3U64)
            if u64.nameLen == 0U64 {
                return <Result.Ok value=() />
            }
            try self.tcCheckValue(expectedRef: self.simpleTypeRef(nameStart: u64.nameStart, nameLen: u64.nameLen), valueExpr: index, pos: "index")
            return <Result.Ok value=() />
        }
        val br: U64 = (try self.inferType(id: base))
        if br != 0U64 {
            if br < self.arena.typeCount() {
                val bref: TypeRef = self.arena.typeAt(index: br)
                if rangeEquals(bytes: self.arena.bytes, start: bref.nameStart, len: bref.nameLen, kw: "Dictionary") {
                    if bref.args.count() >= 1U64 {
                        try self.tcCheckValue(expectedRef: bref.args[0], valueExpr: index, pos: "dictkey")
                    }
                }
            }
        }
        return <Result.Ok value=() />
    }

    inout fn tcCheckMakeFields(expectedRef: U64, makeId: U64) -> Result[(), CompileDiagnostic] {
        if expectedRef >= self.arena.typeCount() {
            return <Result.Ok value=() />
        }
        val et: TypeRef = self.arena.typeAt(index: expectedRef)
        // A Record's semantic field types live in its TypeTerm children. The
        // synthetic StructDef is an ABI layout cache and may originate in a
        // different lexical generic scope, so consulting it here would replace
        // the correct ParamId with an unrelated same-spelled binder.
        if et.isRecord {
            if et.recordFieldLabels.count() != et.recordFieldTerms.count() { return <Result.Ok value=() /> }
            match self.arena.exprs[makeId] {
                Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                    mut val mi: U64 = 0U64
                    while mi < fields.len {
                        val field: MakeField = self.makeFieldAt(fields: fields, index: mi)
                        val label: U64 = intern(c: inout self, start: field.nameStart, len: field.nameLen)
                        mut val ri: U64 = 0U64
                        while ri < et.recordFieldLabels.count() {
                            if et.recordFieldLabels[ri] == label {
                                try self.tcCheckValue(expectedRef: et.recordFieldTerms[ri], valueExpr: field.value, pos: "record-field")
                                ri = et.recordFieldLabels.count()
                            } else {
                                ri += 1U64
                            }
                        }
                        mi += 1U64
                    }
                }
                _ => {}
            }
            return <Result.Ok value=() />
        }
        if et.args.count() == 0U64 {
            return <Result.Ok value=() />
        }
        match self.arena.exprs[makeId] {
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                if et.hasDecl {
                    // Lowered construction types already carry lexical identity.
                    // Resolve spelling only for a legacy term without that facet.
                    mut val matchesDeclaration: Bool = false
                    if ty != 0U64 && ty < self.arena.typeCount() && self.arena.typeTerms[ty].hasDecl {
                        matchesDeclaration = self.arena.typeTerms[ty].declOffset == et.declOffset
                    } else {
                        val identity = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: typeStart), start: typeStart, len: typeLen)
                        matchesDeclaration = identity.nameLen != 0U64 && identity.nameStart == et.declOffset
                    }
                    if !matchesDeclaration {
                        return <Result.Ok value=() />
                    }
                } else if intern(c: inout self, start: typeStart, len: typeLen) != et.nameId {
                    return <Result.Ok value=() />
                }
                // Ref[T] / WeakRef[T] are lang items (not registered generic structs), so
                // the struct lookup below misses them. Their `value` field is T — check it
                // (`<Ref[I64] value=true/>` would otherwise box a Bool as an I64).
                if rangeEquals(bytes: self.arena.bytes, start: et.nameStart, len: et.nameLen, kw: "Ref") || rangeEquals(bytes: self.arena.bytes, start: et.nameStart, len: et.nameLen, kw: "WeakRef") {
                    if et.args.count() >= 1U64 {
                        mut val rfi: U64 = 0
                        while rfi < fields.len {
                            val field: MakeField = self.makeFieldAt(fields: fields, index: rfi)
                            if rangeEquals(bytes: self.arena.bytes, start: field.nameStart, len: field.nameLen, kw: "value") {
                                try self.tcCheckValue(expectedRef: et.args[0], valueExpr: field.value, pos: "ref value")
                            }
                            rfi += 1
                        }
                    }
                    return <Result.Ok value=() />
                }
                if isEnum {
                    val ei: U64 = self.enumIndexForType(ref: expectedRef)
                    if ei >= self.arena.enumCount() {
                        return <Result.Ok value=() />
                    }
                    val vi: U64 = self.variantIndexInDeclaration(enumIndex: ei, nameStart: variantStart, nameLen: variantLen)
                    if vi >= self.arena.enumAt(index: ei).variants.count() {
                        return <Result.Ok value=() />
                    }
                    try self.tcCheckFieldsUnder(params: self.arena.enumAt(index: ei).typeParams, targs: et.args, defFields: self.arena.enumVariantAt(enumIndex: ei, variantIndex: vi).fields, makeFields: fields)
                } else {
                    val si: U64 = self.structIndexForType(ref: expectedRef)
                    if si >= self.arena.structCount() {
                        return <Result.Ok value=() />
                    }
                    try self.tcCheckFieldsUnder(params: self.arena.structAt(index: si).typeParams, targs: et.args, defFields: self.arena.structAt(index: si).fields, makeFields: fields)
                }
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    inout fn tcCheckFieldsUnder(params: Array[Bind], targs: Array[U64], defFields: Array[FieldDef], makeFields: MakeFieldRange) -> Result[(), CompileDiagnostic] {
        mut val mi: U64 = 0
        while mi < makeFields.len {
            val makeField: MakeField = self.makeFieldAt(fields: makeFields, index: mi)
            mut val di: U64 = 0
            while di < defFields.count() {
                if spansEqual(c: inout self, aStart: defFields[di].nameStart, aLen: defFields[di].nameLen, bStart: makeField.nameStart, bLen: makeField.nameLen) {
                    if defFields[di].ty != 0U64 {
                        val grounded = try self.groundTermForBody(ref: defFields[di].ty, environment: <InstanceEnvironment params=params args=targs />, selfRef: 0U64, itemRef: 0U64)
                        try self.tcCheckValue(expectedRef: grounded, valueExpr: makeField.value, pos: "ginst-field")
                    }
                    di = defFields.count()
                } else {
                    di += 1
                }
            }
            mi += 1
        }
        return <Result.Ok value=() />
    }

    inout fn tcFieldPos(prefix: String, nameStart: U64, nameLen: U64) -> String {
        mut val bs: Array[U8] = []
        appendBytes(into: inout bs, from: prefix.bytes())
        mut val i: U64 = 0
        while i < nameLen {
            bs.append(self.arena.bytes[nameStart + i])
            i += 1
        }
        return stringFromBytesUnchecked(bs)
    }

    inout fn tcExprKind(id: U64) -> String {
        match self.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => { return "Call" }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { return "Method" }
            Expr.Field(base: _, val nameStart, val nameLen) => {
                mut val bs: Array[U8] = []
                appendBytes(into: inout bs, from: "Field:".bytes())
                mut val i: U64 = 0
                while i < nameLen {
                    bs.append(self.arena.bytes[nameStart + i])
                    i += 1
                }
                return stringFromBytesUnchecked(bs)
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, fields: _) => { return "Make" }
            Expr.MatchExpr(scrut: _, arms: _) => { return "MatchExpr" }
            Expr.Ident(val start, val len) => {
                mut val bs: Array[U8] = []
                appendBytes(into: inout bs, from: "Ident:".bytes())
                mut val i: U64 = 0
                while i < len {
                    bs.append(self.arena.bytes[start + i])
                    i += 1
                }
                return stringFromBytesUnchecked(bs)
            }
            Expr.Index(base: _, index: _) => { return "Index" }
            Expr.Binary(op: _, lhs: _, rhs: _) => { return "Binary" }
            Expr.Cast(operand: _, tyStart: _, tyLen: _, ty: _) => { return "Cast" }
            Expr.Int(value: _, offset: _, isBool: _, val tyStart, val tyLen, isNeg: _) => {
                mut val bs: Array[U8] = []
                appendBytes(into: inout bs, from: "Int:".bytes())
                mut val i: U64 = 0
                while i < tyLen {
                    bs.append(self.arena.bytes[tyStart + i])
                    i += 1
                }
                return stringFromBytesUnchecked(bs)
            }
            Expr.Unary(op: _, operand: _) => { return "Unary" }
            _ => { return "other" }
        }
    }

    inout fn tcRefName(ref: U64) -> String {
        if ref == 0U64 || ref >= self.arena.typeCount() {
            return "?"
        }
        val t: TypeRef = self.arena.typeAt(index: ref)
        mut val bs: Array[U8] = []
        mut val i: U64 = 0
        while i < t.nameLen {
            bs.append(self.arena.bytes[t.nameStart + i])
            i += 1
        }
        return stringFromBytesUnchecked(bs)
    }
}
