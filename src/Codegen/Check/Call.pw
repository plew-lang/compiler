// Part of compile-time checks (root: _.pw): call / argument / method type
// and ownership-mode checking.

// A bare place (variable/field/element) of a `unique` type in a value position
// is a forbidden copy (spec/03): unique values are move-only. Require `move`
// (consume), `borrow` (read), or `inout` (mutable borrow) at the use site.
// Fresh values (construction / call results) and the `move`/`borrow` prefixes
// (which lower to Expr.Move, not a place) pass. `inoutOk` exempts `inout` args.

pub impl Comp {
    // Generic bodies are verified against their declared trait bounds.  This
    // deliberately returns a requirement signature, never a concrete witness:
    // the latter belongs to Mono after T is instantiated.  Keeping the two
    // phases distinct prevents unrelated concrete conformance paths from
    // changing whether `fn f[T](x: T) where T: R { x.r() }` is well formed.
    inout fn checkSymbolicMethodArgs(fnIdx: U64, receiverRef: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[Bool, CompileDiagnostic] {
        if receiverRef == 0U64 || fnIdx >= self.arena.functionCount() { return <Result.Ok value=false /> }
        val resolution = (try self.staticMemberResolution(fnIdx: fnIdx, receiverRef: receiverRef, nameStart: nameStart, nameLen: nameLen, args: args))
        match resolution {
            StaticMemberResolution.Requirement(val proof, val traitIdx, val reqIdx) => {
                // Only symbolic proofs own declaration-time argument types.
                // Concrete witnesses retain the ordinary callable checks.
                mut val symbolic = false
                match proof {
                    StaticConformanceProof.AssumedBound(source: _) => { symbolic = true }
                    StaticConformanceProof.AssumedSupertraitPath(source: _, steps: _) => { symbolic = true }
                    StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: _, traitArgs: _) => { symbolic = true }
                    _ => {}
                }
                if !symbolic { return <Result.Ok value=false /> }
                val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: traitIdx).reqs, index: reqIdx)
                // Method binders are distinct from the trait instance's
                // binders. Infer them from this call before checking arguments;
                // an unrelated nominal type with the same spelling has no role.
                val methodParameters = self.copyFuncBinds(binds: requirement.typeParams)
                val methodArguments = (try self.inferFnArgs(f: requirement, args: args))
                if requirement.signatureBounds.len != 0U64 {
                    mut val traitBound = <TraitBound subject=receiverRef constraint=<TraitConstraint key=<TraitInstanceKey owner=self.decls.traitAt(index: traitIdx).nameStart positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] /> offset=nameStart />
                    match proof {
                        StaticConformanceProof.AssumedBound(val source) => { traitBound = self.declarationBound(source: source) }
                        StaticConformanceProof.AssumedSupertraitPath(val source, val steps) => { traitBound = self.assumedSupertraitBound(source: source, steps: steps) }
                        StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: val proofReceiver, val traitArgs) => {
                            traitBound = <TraitBound subject=proofReceiver constraint=<TraitConstraint key=<TraitInstanceKey owner=self.decls.traitAt(index: traitIdx).nameStart positionalArgs=traitArgs /> positionalArgsOpen=false assocPredicates=[] /> offset=nameStart />
                        }
                        _ => {}
                    }
                    mut val boundIndex = 0U64
                    while boundIndex < requirement.signatureBounds.len {
                        val bound = self.conformBoundAt(bounds: requirement.signatureBounds, index: boundIndex)
                        val subject = self.groundTermInEnvironment(ref: self.traitBoundTypeTerm(ref: bound.subject, bound: traitBound, traitIndex: traitIdx), params: methodParameters, values: methodArguments)
                        val constraint = self.groundTraitConstraintInEnvironment(constraint: self.traitConstraintInBound(constraint: bound.constraint, bound: traitBound, traitIndex: traitIdx), params: methodParameters, args: methodArguments)
                        if !(try self.viewedTypeConformsTraitConstraint(ref: subject, constraint: constraint, assumptions: self.functionBoundAssumptions(fnIdx: fnIdx))) {
                            return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "type argument does not conform to the trait required by the method's `where`") />
                        }
                        boundIndex += 1U64
                    }
                }
                mut val index = 0U64
                while index < args.len {
                    val parameterIndex = self.paramIndexForArg(params: requirement.params, args: args, argIdx: index)
                    if parameterIndex < requirement.params.count() {
                        val parameter = self.funcParamAt(params: requirement.params, index: parameterIndex)
                        val argument = self.argAt(args: args, index: index)
                        try self.checkArgInoutMode(p: parameter, arg: argument)
                        val traitExpected = self.staticRequirementParamType(resolution: resolution, args: args, argIdx: index)
                        val expected = self.groundTermInEnvironment(ref: traitExpected, params: methodParameters, values: methodArguments, selfRef: receiverRef)
                        if expected != 0U64 {
                            val type = self.typeInfoOfRef(ref: expected)
                            try self.checkLitSpanCtx(id: argument.expr, tyStart: type.nameStart, tyLen: type.nameLen, isArray: type.kind == 3, ctxRef: expected)
                        }
                        try self.tcCheckValue(expectedRef: expected, valueExpr: argument.expr, pos: "arg")
                    }
                    index += 1U64
                }
                return <Result.Ok value=true />
            }
            _ => { return <Result.Ok value=false /> }
        }
    }

    inout fn checkUniquePlaceCopy(exprId: U64, inoutOk: Bool) -> Result[(), CompileDiagnostic] {
        if inoutOk {
            return <Result.Ok value=() />
        }
        if self.isPlaceExpr(id: exprId) {
            // (typeOf, cached: read only via kind==2; a width-less int — typeOf's sole
            // divergence from exprType — is kind 0, taking neither this nor any sibling branch.)
            val ti: TypeInfo = (try self.typeOf(id: exprId))
            if ti.kind == 2 {
                if self.arena.typeTermIsUnique(ref: self.typedIrRefOfInfo(ti: ti)) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "a unique value cannot be copied; use `move`, `borrow`, or `inout`") />
                }
            }
        }
        return <Result.Ok value=() />
    }

    // Ownership belongs to the evaluated value, not to its spelling. Storage
    // reads and explicit borrows do not provide an owner; fresh results and
    // explicit moves do. Views preserve this contract. Field projections are
    // not whole-value transfers (aggregate partial move is unsupported).
    inout fn expressionProvidesOwnership(exprId: U64) -> Bool {
        match self.arena.exprs[exprId] {
            Expr.Move(operand: _, val isBorrow) => { return !isBorrow }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return self.expressionProvidesOwnership(exprId: operand) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.expressionProvidesOwnership(exprId: recv) }
            _ => { return !self.isPlaceExpr(id: exprId) }
        }
    }

    // Record publishes this decision; Mid consumers use the frozen fact.
    // Copyable ordinary matches keep independent-copy pattern semantics.
    inout fn matchConsumesValue(scrut: U64, typeTerm: U64) -> Bool {
        if !self.expressionProvidesOwnership(exprId: scrut) { return false }
        if self.matchScrutIsMove(scrut: scrut) { return true }
        if typeTerm == 0U64 || typeTerm >= self.arena.typeCount() { return false }
        return self.arena.typeTermIsUnique(ref: typeTerm)
    }

    inout fn matchScrutIsMove(scrut: U64) -> Bool {
        match self.arena.exprs[scrut] {
            Expr.Move(operand: _, val isBorrow) => { return !(isBorrow) }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return self.matchScrutIsMove(scrut: operand) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.matchScrutIsMove(scrut: recv) }
            _ => { return false }
        }
    }

    inout fn matchScrutIsBorrow(scrut: U64) -> Bool {
        match self.arena.exprs[scrut] {
            Expr.Move(operand: _, val isBorrow) => { return isBorrow }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return self.matchScrutIsBorrow(scrut: operand) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.matchScrutIsBorrow(scrut: recv) }
            _ => { return false }
        }
    }

    inout fn checkMatchAccessMode(scrut: U64, arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        return self.checkPatternAccessMode(scrut: scrut, isStruct: arms.len > 0U64 && self.matchArmAt(arms: arms, index: 0U64).isStruct)
    }

    inout fn checkPatternAccessMode(scrut: U64, isStruct: Bool) -> Result[(), CompileDiagnostic] {
        if self.matchScrutIsBorrow(scrut: scrut) {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: scrut), msg: "`match borrow` is not part of v1; match a copyable value directly, or use `match move` to consume a unique enum (spec/11)") />
        }
        if self.matchScrutIsMove(scrut: scrut) {
            if isStruct {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: scrut), msg: "`match move` is consuming enum match; struct destructuring by move would be aggregate partial move, which v1 rejects (spec/11)") />
            }
            return <Result.Ok value=() />
        }
        if self.isPlaceExpr(id: scrut) {
            val ti: TypeInfo = (try self.typeOf(id: scrut))
            if ti.kind == 2 {
                if self.arena.typeTermIsUnique(ref: self.typedIrRefOfInfo(ti: ti)) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: scrut), msg: "matching a unique storage place requires `match move`; bare `match` does not consume the owner (spec/11)") />
                }
            }
        }
        return <Result.Ok value=() />
    }

    inout fn checkUniqueArgModes(args: ArgRange) -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0
        while i < args.len {
            val arg: Arg = self.argAt(args: args, index: i)
            try self.checkUniquePlaceCopy(exprId: arg.expr, inoutOk: arg.isInout)
            i += 1
        }
        return <Result.Ok value=() />
    }

    inout fn tcCheckGenericArgConsistency(f: Func, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if f.typeParams.count() == 0U64 {
            return <Result.Ok value=() />
        }
        mut val tpi: U64 = 0
        while tpi < f.typeParams.count() {
            mut val firstRef: U64 = 0
            mut val ai: U64 = 0
            while ai < args.len {
                val pi: U64 = self.paramIndexForArg(params: f.params, args: args, argIdx: ai)
                if pi < f.params.count() {
                    val p: Param = self.funcParamAt(params: f.params, index: pi)
                    // Only a bare parameter position contributes an inverse
                    // binding.  A projection such as `T#Parser.Output` has
                    // the same legacy head spelling but cannot determine T.
                    if self.plainBinder(ref: p.ty, params: <PatternBindInput.Function range=f.typeParams />) == tpi {
                        val ar: U64 = (try self.inferType(id: self.argAt(args: args, index: ai).expr))
                        if ar != 0U64 {
                            if firstRef == 0U64 {
                                firstRef = ar
                            } else {
                                if !((try self.typesCompatible(expected: firstRef, inferred: ar))) {
                                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: self.argAt(args: args, index: ai).expr), msg: "inconsistent types for a type parameter: two arguments bound to the same `[T]` have different types") />
                                }
                            }
                        }
                    }
                }
                ai += 1U64
            }
            tpi += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkArgInoutMode(p: Param, arg: Arg) -> Result[(), CompileDiagnostic] {
        if p.isInout {
            if arg.isInout {
                // `inout` writes through the place, so the argument must (a) BE a place —
                // a local/field/subscript/Ref-pointee, not a literal or call result — and
                // (b) be mutable (spec/03: `inc(x: inout n)` needs `mut val n`).
                val place: U64 = self.materializablePlace(id: arg.expr)
                if !(self.exprIsPlace(id: place)) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: arg.expr), msg: "an `inout` argument must be a place (a variable or field), not a literal or temporary value (spec/03)") />
                }
                if !((try self.placeIsMutable(id: place))) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: arg.expr), msg: "an `inout` argument must be a mutable place; declare it `mut val` (spec/03)") />
                }
            } else {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: arg.expr), msg: "this parameter is `inout`; pass the argument with `inout` (spec/03)") />
            }
        } else {
            if arg.isInout {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: arg.expr), msg: "this parameter is not `inout`; remove `inout` from the argument (spec/03)") />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn localTypeRefByName(nameStart: U64, nameLen: U64) -> U64 {
        val index = self.localIndexByName(start: nameStart, len: nameLen)
        if index < self.cur.locals.count() { return self.cur.locals[index].ty }
        return 0U64
    }

    inout fn checkCallArgs(id: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        try self.checkUniqueArgModes(args: args)
        val fi: U64 = (try self.resolvedCallee(id: id))
        if fi == self.arena.functionCount() {
            // calling a function VALUE (`val f: fn(x: I64)->I64 = …; f(x: true)`): the name
            // is a local, not a declared function, so check each arg against the fn type's
            // parameter types (the TypeRef stores args as [return, param0, param1, …]).
            val lty: U64 = self.localTypeRefByName(nameStart: nameStart, nameLen: nameLen)
            if lty != 0U64 {
                if self.isFnType(ref: lty) {
                    val ft: TypeRef = self.arena.typeAt(index: lty)
                    mut val k: U64 = 0
                    while k < args.len {
                        if k + 1U64 < ft.args.count() {
                            try self.tcCheckValue(expectedRef: ft.args[k + 1U64], valueExpr: self.argAt(args: args, index: k).expr, pos: "fn-value arg")
                        }
                        k += 1
                    }
                    return <Result.Ok value=() />
                }
            }
            mut val i: U64 = 0
            while i < args.len {
                try self.checkLitCtx(id: self.argAt(args: args, index: i).expr, eKind: 1, eBits: 64, eSgn: true)
                i += 1
            }
            return <Result.Ok value=() />
        }
        val f: Func = self.arena.functionAt(index: fi)
        try self.tcCheckGenericArgConsistency(f: f, args: args)
        val ps: Array[Param] = self.copyFuncParams(params: f.params)
        val environment = try self.callParameterEnvironment(exprId: id, callee: fi, receiverRef: 0U64, args: args)
        mut val i: U64 = 0
        while i < args.len {
            val pi: U64 = self.paramIndexForArg(params: f.params, args: args, argIdx: i)
            if pi < ps.count() {
                val p: Param = ps[pi]
                try self.checkArgInoutMode(p: p, arg: self.argAt(args: args, index: i))
                val parameterType = try self.groundTermForBody(ref: p.ty, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                try self.checkLitTi(id: self.argAt(args: args, index: i).expr, ti: self.typeInfoOfRef(ref: parameterType))
                try self.tcCheckValue(expectedRef: parameterType, valueExpr: self.argAt(args: args, index: i).expr, pos: "arg")
            } else {
                try self.checkLitCtx(id: self.argAt(args: args, index: i).expr, eKind: 0, eBits: 0, eSgn: false)
            }
            i += 1
        }
        return <Result.Ok value=() />
    }

    inout fn recvOwnParamCount(rt: TypeInfo) -> U64 {
        val receiver = self.typedIrRefOfInfo(ti: rt)
        val si: U64 = self.structIndexForType(ref: receiver)
        if si < self.arena.structCount() {
            return self.arena.structAt(index: si).typeParams.count()
        }
        val ei: U64 = self.enumIndexForType(ref: receiver)
        if ei < self.arena.enumCount() {
            return self.arena.enumAt(index: ei).typeParams.count()
        }
        return 0U64
    }

    inout fn checkMethodArgs(exprId: U64, recv: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        try self.checkUniqueArgModes(args: args)
        try self.checkLitCtx(id: recv, eKind: 0, eBits: 0, eSgn: false)
        mut val receiverTerm = self.parametricExprTerm(exprId: recv)
        if receiverTerm == 0U64 { receiverTerm = (try self.inferType(id: recv)) }
        if (try self.checkSymbolicMethodArgs(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)) {
            return <Result.Ok value=() />
        }
        // (typeOf, cached: read via kind==2 then .ref — a receiver is never the width-less
        // int form, so this matches exprType exactly.)
        val rt: TypeInfo = (try self.typeOf(id: recv))
        // `dict.insert(key:, value:)` on a Dictionary[K, V] (also how a `[k: v]` literal
        // lowers): the generic-receiver arg grounding is incomplete, so check key->K and
        // value->V directly here (mirrors checkIndexKeyType for subscripts). spec/02.
        if rt.kind == 2 {
            if rt.ref != 0U64 {
                if rt.ref < self.arena.typeCount() {
                    val drt: TypeRef = self.arena.typeAt(index: rt.ref)
                    if rangeEquals(bytes: self.arena.bytes, start: drt.nameStart, len: drt.nameLen, kw: "Dictionary") {
                        if drt.args.count() >= 2U64 {
                            // the generic-receiver arg grounding is incomplete, so check the
                            // Dictionary's key/value args directly by LABEL: a `key` arg must
                            // be K, a `value`/`fallback` arg must be V. Covers insert / get /
                            // getOr / contains / at / remove (`d.get(key: 5I64)` on a
                            // Dictionary[String,_]). spec/02.
                            mut val dai: U64 = 0
                            while dai < args.len {
                                val arg: Arg = self.argAt(args: args, index: dai)
                                if arg.hasLabel {
                                    if rangeEquals(bytes: self.arena.bytes, start: arg.labelStart, len: arg.labelLen, kw: "key") {
                                        try self.tcCheckValue(expectedRef: drt.args[0], valueExpr: arg.expr, pos: "dict key")
                                    }
                                    if rangeEquals(bytes: self.arena.bytes, start: arg.labelStart, len: arg.labelLen, kw: "value") || rangeEquals(bytes: self.arena.bytes, start: arg.labelStart, len: arg.labelLen, kw: "fallback") {
                                        try self.tcCheckValue(expectedRef: drt.args[1], valueExpr: arg.expr, pos: "dict value")
                                    }
                                }
                                dai += 1
                            }
                        }
                    }
                }
            }
        }
        if rt.kind == 2 {
            // The abstract checker validates a bound receiver against its
            // requirement signature.  Concrete witness selection belongs to
            // Mono after T is instantiated; querying the global conformance
            // table here makes unrelated paths falsely ambiguous.
            if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: rt.nameStart, len: rt.nameLen) {
                return <Result.Ok value=() />
            }
            val mi: U64 = (try self.resolvedCallee(id: exprId))
            if mi != self.arena.functionCount() {
                val mf: Func = self.arena.functionAt(index: mi)
                try self.tcCheckGenericArgConsistency(f: mf, args: args)
                val ps: Array[Param] = self.copyFuncParams(params: mf.params)
                val environment = try self.callParameterEnvironment(exprId: exprId, callee: mi, receiverRef: rt.ref, args: args)
                mut val i: U64 = 0
                while i < args.len {
                    val pi: U64 = self.paramIndexForArg(params: mf.params, args: args, argIdx: i)
                    if pi < ps.count() {
                        val p: Param = ps[pi]
                        try self.checkArgInoutMode(p: p, arg: self.argAt(args: args, index: i))
                        val parameterType = try self.groundTermForBody(ref: p.ty, environment: environment, selfRef: environment.receiverRef, itemRef: (try self.finalMethodItemRef(f: mf, receiverRef: environment.receiverRef)))
                        try self.checkLitTi(id: self.argAt(args: args, index: i).expr, ti: self.typeInfoOfRef(ref: parameterType))
                        try self.tcCheckValue(expectedRef: parameterType, valueExpr: self.argAt(args: args, index: i).expr, pos: "arg")
                    } else {
                        try self.checkLitCtx(id: self.argAt(args: args, index: i).expr, eKind: 0, eBits: 0, eSgn: false)
                    }
                    i += 1
                }
                return <Result.Ok value=() />
            }
        }
        if rt.kind == 3 {
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "append") {
                // if the element type is itself an `Array[X]`, the appended value is
                // an array (e.g. `m.append([1,2,3])`) — check its elements against the
                // inner element X, not the outer (mangled) element name as a scalar.
                mut val innerArr: Bool = false
                mut val innerStart: U64 = 0
                mut val innerLen: U64 = 0
                val er: U64 = self.arrayElemRef(start: rt.nameStart, len: rt.nameLen)
                if er != 0 {
                    val rr: U64 = (try self.resolveTy(tyRef: er))
                    if rr < self.arena.typeCount() {
                        val rtp: TypeRef = self.arena.typeAt(index: rr)
                        if rangeEquals(bytes: self.arena.bytes, start: rtp.nameStart, len: rtp.nameLen, kw: "Array") {
                            if rtp.args.count() > 0 {
                                val xn: Bind = (try self.arrayElemNameForRef(elemRef: rtp.args[0]))
                                innerArr = true
                                innerStart = xn.nameStart
                                innerLen = xn.nameLen
                            }
                        }
                    }
                }
                mut val i: U64 = 0
                while i < args.len {
                    if innerArr {
                        try self.checkLitArray(id: self.argAt(args: args, index: i).expr, elemStart: innerStart, elemLen: innerLen)
                    } else {
                        try self.checkLitSpan(id: self.argAt(args: args, index: i).expr, tyStart: rt.nameStart, tyLen: rt.nameLen, isArray: false)
                        // a primitive-element array: the appended value's type must match the
                        // element type (`Array[I64].append(true)` — checkLitSpan range-checks a
                        // literal but a `true`/typed value of the wrong type slips through). Only
                        // primitives are checked (their simpleTypeRef is reliable; a struct/
                        // generic element name may be mangled and is left to other checks).
                        if self.isIntType(start: rt.nameStart, len: rt.nameLen) || self.isFloatType(start: rt.nameStart, len: rt.nameLen) || rangeEquals(bytes: self.arena.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Bool") || rangeEquals(bytes: self.arena.bytes, start: rt.nameStart, len: rt.nameLen, kw: "String") {
                            try self.tcCheckValue(expectedRef: self.simpleTypeRef(nameStart: rt.nameStart, nameLen: rt.nameLen), valueExpr: self.argAt(args: args, index: i).expr, pos: "append")
                        }
                    }
                    i += 1
                }
                return <Result.Ok value=() />
            }
        }
        // an assoc fn call `Type.make(...)`: the recv is a TYPE NAME (not a value), so the
        // instance-method lookups above miss it. Resolve the assoc fn and check its args
        // (the value `S.make(n: true)` would otherwise reinterpret a Bool as I64).
        match self.arena.exprs[recv] {
            Expr.Ident(start: val rStart, len: val rLen) => {
                // Consume the call site's selection, including the explicit
                // receiver and factory selected during lowering. Looking up
                // the bare type spelling here can select another overload.
                val ai: U64 = (try self.resolvedCallee(id: exprId))
                if ai < self.arena.functionCount() {
                    val af: Func = self.arena.functionAt(index: ai)
                    val aps: Array[Param] = self.copyFuncParams(params: af.params)
                    mut val qualifier = (try self.concreteTypeQualifierTerm(exprId: recv))
                    if qualifier == 0U64 { qualifier = (try self.associatedReceiverFromArguments(f: af, args: args)) }
                    val environment = try self.callParameterEnvironment(exprId: exprId, callee: ai, receiverRef: qualifier, args: args)
                    mut val k: U64 = 0
                    while k < args.len {
                        val pi: U64 = self.paramIndexForArg(params: af.params, args: args, argIdx: k)
                        if pi < aps.count() {
                            val ap: Param = aps[pi]
                            try self.checkArgInoutMode(p: ap, arg: self.argAt(args: args, index: k))
                            val parameter = try self.groundTermForBody(ref: ap.ty, environment: environment, selfRef: environment.receiverRef, itemRef: (try self.finalMethodItemRef(f: af, receiverRef: environment.receiverRef)))
                            try self.checkLitTi(id: self.argAt(args: args, index: k).expr, ti: self.typeInfoOfRef(ref: parameter))
                            try self.tcCheckValue(expectedRef: parameter, valueExpr: self.argAt(args: args, index: k).expr, pos: "arg")
                        }
                        k += 1
                    }
                    return <Result.Ok value=() />
                }
                if self.typeHasAssocFn(typeStart: rStart, typeLen: rLen, nameStart: nameStart, nameLen: nameLen) {
                    if args.len == 0U64 {
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "an associated function declaration cannot be used as a value; call it with the required arguments or wrap the call in an explicit closure (spec/07)") />
                    } else {
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "no matching associated function for this argument list (spec/07)") />
                    }
                    return <Result.Ok value=() />
                }
            }
            _ => {}
        }
        mut val i: U64 = 0
        while i < args.len {
            try self.checkLitCtx(id: self.argAt(args: args, index: i).expr, eKind: 1, eBits: 64, eSgn: true)
            i += 1
        }
        return <Result.Ok value=() />
    }
}
