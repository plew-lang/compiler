// Declaration success must establish the exact trait-view premise while the
// originating function's rigid binders are available. No body cursor is used.
pub impl Comp {
    inout fn checkedNominalUnderlying(ref: U64) -> Result[U64, CompileDiagnostic] {
        if ref == 0U64 || ref >= self.arena.typeCount() { return <Result.Ok value=0U64 /> }
        val term = self.arena.typeTermAt(index: ref)
        if !term.hasDecl { return <Result.Ok value=0U64 /> }
        val declaration = match self.arena.newtypeByOffset(offset: term.declOffset) {
            Optional.None => { return <Result.Ok value=0U64 /> }
            Optional.Some(v: val declaration) => declaration,
        }
        return self.readAdmittedNewtypeUnderlying(declaration: declaration)
    }

    inout fn admitAuthoredFunctionViews() -> Result[(), CompileDiagnostic] {
        match self.authoredSignatureAdmission {
            AuthoredSignatureAdmissionPhase.Open => {}
            AuthoredSignatureAdmissionPhase.Complete => { return <Result.Ok value=() /> }
            AuthoredSignatureAdmissionPhase.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            AuthoredSignatureAdmissionPhase.Checking => {
                return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "authored signature admission was re-entered", failureDomain: <FailureDomain.Internal />) />
            }
        }
        self.authoredSignatureAdmission = <AuthoredSignatureAdmissionPhase.Checking />
        val result = self.finishAuthoredSignatureAdmission()
        self.authoredSignatureAdmission = match result {
            Result.Ok(value: _) => <AuthoredSignatureAdmissionPhase.Complete />,
            Result.Err(error: val diagnostic) => <AuthoredSignatureAdmissionPhase.Failed diagnostic=diagnostic />,
        }
        return result
    }

    // Read an exact retained annotation and its canonical child recipes.
    // Every projection consumes the proof of its own authored occurrence.
    inout fn readAdmittedSignatureRoot(function: U64, slot: SourceSignatureSlot, environment: InstanceEnvironment) -> Result[U64, CompileDiagnostic] {
        val source = match self.sourceTypeUses.signatureFor(function: function) {
            Optional.Some(v: val source) => source,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "function has no registered authored signature", failureDomain: <FailureDomain.Internal />) /> },
        }
        val terms = try self.readAdmittedSignatureRoots(source: source, slots: [slot], environment: environment)
        return <Result.Ok value=terms[0U64] />
    }
}

impl Comp {
    inout fn associatedBindingOccurrence(binding: AssocBinding, witness: WitnessMatch) -> Result[AuthoredTypeUse, CompileDiagnostic] {
        val occurrence = try self.signatureOccurrence(id: binding.authoredTypeUse)
        val scope = self.sourceTypeUses.scopeAt(token: occurrence.scope)
        if scope.isNone() || scope.unwrap().anchor != binding.implOffset || occurrence.site != binding.authoredTypeSite || !self.typeRefEq(a: occurrence.term, b: binding.ty) {
            return <Result.Err error=self.diagnosticAt(offset: binding.tyStart, msg: "associated output has a foreign source occurrence", failureDomain: <FailureDomain.Internal />) />
        }
        val owner = scope.unwrap().implementation
        if owner.isSome() {
            match owner.unwrap().kind {
                SourceImplementationKind.Conformance(index: val index) => {
                    if index + 1U64 == witness.conformIdx { return <Result.Ok value=occurrence /> }
                }
                _ => {}
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: binding.tyStart, msg: "associated output has a foreign implementation owner", failureDomain: <FailureDomain.Internal />) />
    }

    inout fn selectedAssociatedBindingReceipt(bindingIndex: U64, witness: WitnessMatch) -> Result[AuthoredAssociatedBinding, CompileDiagnostic] {
        val binding = self.decls.assocBindings[bindingIndex]
        val saved = match self.authoredAssociatedBindings.get(key: bindingIndex) {
            Optional.Some(v: val admitted) => admitted,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: binding.tyStart, msg: "associated output lost its admitted binding", failureDomain: <FailureDomain.Internal />) /> },
        }
        val occurrence = try self.associatedBindingOccurrence(binding: binding, witness: witness)
        if saved.conformance + 1U64 != witness.conformIdx || saved.occurrence != binding.authoredTypeUse || occurrence.recipe != saved.recipe {
            return <Result.Err error=self.diagnosticAt(offset: binding.tyStart, msg: "associated output has a foreign binding receipt", failureDomain: <FailureDomain.Internal />) />
        }
        return <Result.Ok value=saved />
    }

    inout fn readProjectionForNormalization(proof: StaticConformanceProof, traitOwner: U64, assocId: U64) -> Result[SelectedProjectionOutput, CompileDiagnostic] {
        if self.associatedBindingAdmissionComplete { return self.readSelectedProjectionOutput(proof: proof, traitOwner: traitOwner, assocId: assocId) }
        val immediate = try self.associatedOutputTermInProof(proof: proof, traitOwner: traitOwner, assocId: assocId)
        return <Result.Ok value=<SelectedProjectionOutput immediate=immediate term=immediate normalizations=[] /> />
    }

    inout fn readSelectedProjectionOutput(proof: StaticConformanceProof, traitOwner: U64, assocId: U64, requirement: Optional[AssociatedBindingRequirementRead] = <Optional.None />) -> Result[SelectedProjectionOutput, CompileDiagnostic] {
        val normalizations = try self.retainedProofProjectionContext(proof: proof)
        mut val output = 0U64
        if self.associatedBindingAdmissionComplete {
            val binding = try self.selectedAssociatedBinding(proof: proof, traitOwner: traitOwner, assocId: assocId)
            if binding.isSome() {
                val selected = binding.unwrap()
                return self.readAssociatedBindingOutput(bindingIndex: selected.bindingIndex, proof: proof, witness: selected.witness, normalizations: normalizations, requirement: requirement)
            }
            output = try self.assumedProjectionOutput(proof: proof, traitOwner: traitOwner, assocId: assocId)
        } else {
            // All source declarations are registered before RHS admission.
            // Conditions can inspect a later binding's immediate equation
            // while that binding is still awaiting its own admission.
            output = try self.associatedOutputTermInProof(proof: proof, traitOwner: traitOwner, assocId: assocId)
        }
        if requirement.isSome() {
            // Only an assumed output is still expressed in the requirement's
            // lexical types. Selected bindings return in their own witness
            // environment and may already contain caller-owned terms.
            val environment = requirement.unwrap().environment
            output = self.groundTermInEnvironment(ref: output, params: environment.params, values: environment.args, selfRef: environment.receiverRef)
        }
        val term = try self.replayProjectionNormalizations(ref: output, normalizations: normalizations, offset: 0U64)
        return <Result.Ok value=<SelectedProjectionOutput immediate=output term=term normalizations=normalizations /> />
    }

    inout fn readAssociatedBindingOutput(bindingIndex: U64, proof: StaticConformanceProof, witness: WitnessMatch, normalizations: Array[ProjectionNormalizationStep], requirement: Optional[AssociatedBindingRequirementRead]) -> Result[SelectedProjectionOutput, CompileDiagnostic] {
        val binding = self.decls.assocBindings[bindingIndex]
        val saved = try self.selectedAssociatedBindingReceipt(bindingIndex: bindingIndex, witness: witness)
        for active in self.activeAssociatedBindingReads {
            if active.binding == bindingIndex && self.sameWitnessSubstitution(a: active.witness, b: witness) {
                return <Result.Err error=self.diagnosticAt(offset: binding.tyStart, msg: "associated binding output is cyclic", failureDomain: <FailureDomain.Source />) />
            }
        }
        val environment = try self.selectedConstraintEnvironment(witness: witness, proof: proof)
        val declaration = self.decls.conformAt(index: saved.conformance)
        if declaration.subjectTraitOwner == 0U64 {
            val subject = self.groundTermInEnvironment(ref: declaration.subjectTy, params: environment.params, values: environment.args)
            val declared = try self.replayProjectionNormalizations(ref: subject, normalizations: normalizations, offset: binding.tyStart)
            val actual = try self.conformancePhysicalSubject(typeRef: witness.selfRef)
            if witness.selfRef == 0U64 || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: declared), b: self.typeRefWithoutOuterViews(ref: actual)) {
                return <Result.Err error=self.diagnosticAt(offset: binding.tyStart, msg: "associated binding substitution does not match its witness subject", failureDomain: <FailureDomain.Internal />) />
            }
        }
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        self.activeAssociatedBindingReads.append((binding: bindingIndex, witness: witness))
        val result = self.readValidatedAssociatedBindingRecipe(saved: saved, witness: witness, proof: proof, environment: environment, memo: inout memo, requirement: requirement, offset: binding.tyStart)
        self.activeAssociatedBindingReads.removeLast()
        val read = try result
        val immediate = try self.groundWitnessTypeTerm(ref: binding.ty, params: <PatternBindInput.Conformance range=binding.typeParams />, matchResult: witness)
        mut val equations = normalizations
        for equation in read.normalizations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations) }
        return <Result.Ok value=<SelectedProjectionOutput immediate=immediate term=read.term normalizations=equations fromBinding=true /> />
    }

    inout fn readValidatedAssociatedBindingRecipe(saved: AuthoredAssociatedBinding, witness: WitnessMatch, proof: StaticConformanceProof, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead], requirement: Optional[AssociatedBindingRequirementRead], offset: U64) -> Result[AuthoredRecipeRead, CompileDiagnostic] {
        match proof {
            StaticConformanceProof.TraitPath | StaticConformanceProof.AssumedTraitPath => { try self.checkStaticProofEvidence(proof: proof, offset: offset) }
            _ => { try self.checkWitnessConditionEvidence(witness: witness, offset: offset) }
        }
        return self.readAuthoredTypeRecipe(proofs: saved.proofs, recipe: saved.recipe, environment: environment, memo: inout memo, context: <SignatureRecipeContext.AssociatedBinding requirement=requirement />)
    }

    inout fn admitAssociatedBindingRecipes() -> Result[(), CompileDiagnostic] {
        for bindingIndex in 0U64..<self.decls.assocBindings.count() {
            val binding = self.decls.assocBindings[bindingIndex]
            val occurrence = try self.signatureOccurrence(id: binding.authoredTypeUse)
            val source = match self.sourceTypeUses.scopeAt(token: occurrence.scope) {
                Optional.Some(v: val source) => source,
                Optional.None => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "associated binding lost its implementation scope", failureDomain: <FailureDomain.Internal />) /> },
            }
            val owner = match source.implementation {
                Optional.Some(v: val owner) => owner,
                Optional.None => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "associated binding lost its implementation owner", failureDomain: <FailureDomain.Internal />) /> },
            }
            match source.state {
                SourceTypeScopeState.Lowered => {}
                _ => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "associated binding implementation is not lowered", failureDomain: <FailureDomain.Internal />) /> }
            }
            val conformance = match owner.kind {
                SourceImplementationKind.Conformance(index: val index) => index,
                SourceImplementationKind.Inherent => { continue },
            }
            if conformance >= self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "associated binding has an invalid conformance owner", failureDomain: <FailureDomain.Internal />) /> }
            val declaration = self.decls.conformAt(index: conformance)
            mut val ownsBinding = false
            for index in 0U64..<declaration.assocBindingIds.count() {
                if self.conformFuncIdAt(ids: declaration.assocBindingIds, index: index) == bindingIndex { ownsBinding = true }
            }
            if !ownsBinding || source.anchor != binding.implOffset || occurrence.site != binding.authoredTypeSite || declaration.traitStart != binding.traitOwner || !self.typeRefEq(a: occurrence.term, b: binding.ty) {
                return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "associated binding has a foreign source occurrence", failureDomain: <FailureDomain.Internal />) />
            }
            val root = self.conformanceTraitBound(conformance: declaration)
            val receiverTrait = self.decls.traitIndexByOffset(offset: owner.receiverTrait)
            val selfParameter = if receiverTrait < self.decls.traitCount() { give self.decls.traitAt(index: receiverTrait).selfParamId } else { give 0U64 }
            val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.AssociatedBinding /> owner=conformance parameters=self.pushFuncBinds(binds: owner.parameters) selfParameter=selfParameter />
            val assumptions = try self.declarationScopeAssumptions(scope: scope)
            val scopes = <SignatureProofScopes local=scope assumptions=assumptions inherited=[] receiver=root.subject scopedBinders=true />
            mut val validation = <SignatureRecipeValidation />
            try self.checkAuthoredTypeRecipe(sourceScope: occurrence.scope, recipe: occurrence.recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: occurrence.site)
            self.authoredAssociatedBindings[bindingIndex] = <AuthoredAssociatedBinding conformance=conformance occurrence=binding.authoredTypeUse recipe=occurrence.recipe proofs=validation.proofs />
            self.markAdmittedRecipeTypeUses(recipe: occurrence.recipe)
        }
        self.associatedBindingAdmissionComplete = true
        return <Result.Ok value=() />
    }

    inout fn finishAuthoredSignatureAdmission() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.sourceTypeUses.signatureCount() {
            val signature = self.sourceTypeUses.signatureAt(index: index).unwrap()
            if !self.authoredSignatureViews.contains(key: signature.function) {
                try self.admitAuthoredFunctionViewSignature(signature: signature)
            }
            index += 1U64
        }
        index = 0U64
        while index < self.sourceTypeUses.requirementScopeCount() {
            val token = self.sourceTypeUses.requirementScopeAt(index: index)
            if !self.authoredRequirementViews.contains(key: token) {
                try self.admitRawRequirementSignature(token: token)
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkAuthoredSignatureAdmissionOutcome() -> Result[(), CompileDiagnostic] {
        match self.authoredSignatureAdmission {
            AuthoredSignatureAdmissionPhase.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            _ => { return <Result.Ok value=() /> }
        }
    }

    inout fn requireEarlySignatureConstruction(offset: U64) -> Result[(), CompileDiagnostic] {
        match self.authoredSignatureAdmission {
            AuthoredSignatureAdmissionPhase.Open => { return <Result.Ok value=() /> }
            AuthoredSignatureAdmissionPhase.Failed(diagnostic: val diagnostic) => { return <Result.Err error=diagnostic /> }
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected declaration lost its admitted signature evidence", failureDomain: <FailureDomain.Internal />) /> }
        }
    }

    // One read owns one declaration/environment validation and recipe memo.
    // Roots retain their distinct authored occurrences, even for equal terms.
    inout fn readAdmittedSignatureRoots(source: AuthoredFunctionSignature, slots: Array[SourceSignatureSlot], environment: InstanceEnvironment, context: SignatureRecipeContext = <SignatureRecipeContext.Concrete />) -> Result[Array[U64], CompileDiagnostic] {
        try self.checkAuthoredSignatureAdmissionOutcome()
        val function = source.function
        val admitted = match self.authoredSignatureViews.get(key: function) {
            Optional.Some(v: val admitted) => admitted,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "authored signature has no admitted trait views", failureDomain: <FailureDomain.Internal />) /> },
        }
        val signature = admitted.signature
        if signature.function != function {
            return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: function).defOffset, msg: "authored signature has a foreign function owner", failureDomain: <FailureDomain.Internal />) />
        }
        if signature.scope != source.scope || signature.parameters.count() != source.parameters.count() {
            return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: function).defOffset, msg: "authored signature has a foreign source scope or slot shape", failureDomain: <FailureDomain.Internal />) />
        }
        try self.checkSignatureEnvironment(signature: source, environment: environment)
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        mut val receiverEquations: Array[ProjectionNormalizationStep] = []
        for recipe in admitted.receiverRecipes {
            val read = try self.readAuthoredTypeRecipe(proofs: admitted.proofs, recipe: recipe, environment: environment, memo: inout memo, context: context)
            for equation in read.normalizations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout receiverEquations) }
        }
        mut val terms: Array[U64] = []
        for slot in slots {
            val occurrenceIds = match slot {
                SourceSignatureSlot.Parameter(index: val index) => {
                    if index >= signature.parameters.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid authored signature parameter slot", failureDomain: <FailureDomain.Input />) /> }
                    give (source: source.parameters[index], saved: signature.parameters[index])
                }
                SourceSignatureSlot.Result => { give (source: source.result, saved: signature.result) }
                SourceSignatureSlot.FactoryError => { give (source: source.factoryError, saved: signature.factoryError) }
            }
            val id = occurrenceIds.source
            if id != occurrenceIds.saved { return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: function).defOffset, msg: "authored signature has a foreign slot occurrence", failureDomain: <FailureDomain.Internal />) /> }
            if id == 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "signature slot has no authored annotation", failureDomain: <FailureDomain.Input />) /> }
            val occurrence = try self.signatureOccurrence(id: id)
            terms.append((try self.readAuthoredTypeRecipe(proofs: admitted.proofs, recipe: occurrence.recipe, environment: environment, memo: inout memo, receiverEquations: receiverEquations, context: context)).term)
        }
        return <Result.Ok value=terms />
    }

    // A closed lexical parameter can use the same admitted type as callers
    // and the executable body. A template retains its symbolic parameter.
    inout fn lexicalBodyParameterType(function: U64, index: U64, ref: U64, receiver: U64) -> Result[Optional[U64], CompileDiagnostic] {
        if !self.arena.typeContainsAssociatedProjection(ref: ref) { return <Result.Ok value=<Optional.None /> /> }
        val declaration = self.arena.functionAt(index: function)
        if declaration.typeParams.count() != 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<Optional.None /> /> }
        val source = match self.authoredSignatureViews.get(key: function) {
            Optional.Some(v: val admitted) => admitted.signature,
            Optional.None => { return <Result.Ok value=<Optional.None /> /> },
        }
        if index >= source.parameters.count() || source.parameters[index] == 0U64 { return <Result.Ok value=<Optional.None /> /> }
        val environment = <InstanceEnvironment receiverRef=receiver />
        val term = try self.readAdmittedSignatureRoot(function: function, slot: <SourceSignatureSlot.Parameter index=index />, environment: environment)
        return <Result.Ok value=<Optional.Some v=term /> />
    }

    inout fn checkSignatureEnvironment(signature: AuthoredFunctionSignature, environment: InstanceEnvironment) -> Result[(), CompileDiagnostic] {
        val declaration = self.arena.functionAt(index: signature.function)
        val parameters = declaration.typeParams
        val method = self.sourceTypeUses.methodScopeFor(function: signature.function)
        val count = environment.params.count()
        if count != environment.args.count() || count < parameters.len || (method.isNone() && count != parameters.len) {
            return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "signature reader requires its declaration substitution", failureDomain: <FailureDomain.Input />) />
        }
        for arg in environment.args {
            if arg >= self.arena.typeCount() { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "signature reader has an invalid substitution term", failureDomain: <FailureDomain.Input />) /> }
        }
        if method.isSome() {
            if environment.receiverRef == 0U64 || environment.receiverRef >= self.arena.typeCount() {
                return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "method signature requires its selected receiver", failureDomain: <FailureDomain.Input />) />
            }
            val selfParameter = self.arena.typeTermAt(index: declaration.recvTy).paramId
            if selfParameter == 0U64 && !self.bodyReceiverMatchesDeclaration(function: declaration, environment: environment) {
                return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "method signature has a foreign selected receiver", failureDomain: <FailureDomain.Input />) />
            }
            mut val selfBound = selfParameter == 0U64
            for index in 0U64..<count {
                val binder = environment.params[index].paramId
                for prior in 0U64..<index {
                    if environment.params[prior].paramId == binder { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "signature reader has duplicate substitution binders", failureDomain: <FailureDomain.Input />) /> }
                }
                if selfParameter != 0U64 && binder == selfParameter {
                    selfBound = self.typeRefEq(a: environment.args[index], b: environment.receiverRef)
                }
            }
            if !selfBound { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "signature reader has no matching lexical Self binding", failureDomain: <FailureDomain.Input />) /> }
        }
        mut val index = 0U64
        while index < parameters.len {
            val expected = self.funcBindAt(binds: parameters, index: index).paramId
            if environment.params[index].paramId != expected {
                mut val found = false
                if method.isSome() {
                    for binder in environment.params { if binder.paramId == expected { found = true } }
                }
                if !found { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "signature reader has a foreign substitution binder", failureDomain: <FailureDomain.Input />) /> }
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

}

impl Comp {
    // The memo belongs to one exact admitted signature and one environment.
    // No semantic-term cache or source reverse lookup can confer evidence.
    inout fn readAuthoredTypeRecipe(proofs: Array[AuthoredTypeViewProof], recipe: U64, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead], receiverEquations: Array[ProjectionNormalizationStep] = [], context: SignatureRecipeContext) -> Result[AuthoredRecipeRead, CompileDiagnostic] {
        match memo.get(key: recipe) {
            Optional.Some(v: val read) => {
                if read.reading {
                    return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "signature recipe re-entered an active equation", failureDomain: <FailureDomain.Internal />) />
                }
                return <Result.Ok value=read />
            }
            Optional.None => {}
        }
        val node = match self.sourceTypeUses.recipeAt(id: recipe) {
            Optional.Some(v: val node) => node,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "signature reader lost its admitted recipe", failureDomain: <FailureDomain.Internal />) /> },
        }
        mut val children: Array[U64] = []
        mut val reads: Array[AuthoredRecipeRead] = []
        mut val normalizations: Array[ProjectionNormalizationStep] = []
        for child in node.children {
            val read = try self.readAuthoredTypeRecipe(proofs: proofs, recipe: child, environment: environment, memo: inout memo, receiverEquations: receiverEquations, context: context)
            children.append(read.term)
            reads.append(read)
            for equation in read.normalizations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout normalizations) }
        }
        val original = self.arena.typeAt(index: node.term)
        val rebuilt = self.rebuildTypeTermChildren(ref: node.term, children: children)
        // Keep selector positions before normalization/replacement. Their
        // original nodes select the saved proof; these terms only instantiate it.
        mut val viewArguments: Array[U64] = []
        val ordinary = if original.isRecord { give original.recordFieldTerms.count() } else { give original.args.count() + original.assocTraitArgs.count() }
        if original.assocNameId == 0U64 {
            mut val index = ordinary
            while index < children.count() {
                viewArguments.append(children[index])
                index += 1U64
            }
        }
        val sourceViews = if original.assocNameId == 0U64 { give self.viewSourcesWithArguments(ref: node.term, arguments: viewArguments) } else { give reads[0U64].views }
        mut val term = rebuilt
        if original.assocNameId == 0U64 {
            match self.typeTermHeadReplacement(ref: node.term, params: environment.params, values: environment.args, selfRef: environment.receiverRef, itemRef: 0U64) {
                Optional.Some(v: val replacement) => {
                    // A source call can leave a method binder open for the
                    // argument matcher or the expected result to infer.
                    if replacement != 0U64 { term = self.typeRefWithAddedViewSources(ref: replacement, additions: sourceViews) }
                }
                Optional.None => {}
            }
        }
        match node.origin {
            SourceTypeRecipeOrigin.Authored => {
                val occurrence = self.sourceTypeUses.useAt(index: node.occurrence - 1U64).unwrap()
                val originalReceiver = if original.assocNameId == 0U64 { give node.term } else { give self.typeTermProjectionReceiver(t: original) }
                val receiver = if original.assocNameId == 0U64 { give term } else { give children[0U64] }
                val selectors = self.arena.typeViewSources(ref: originalReceiver)
                mut val proofEquations = normalizations
                for equation in receiverEquations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout proofEquations) }
                if selectors.count() != sourceViews.count() { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "signature reader changed source selectors", failureDomain: <FailureDomain.Internal />) /> }
                mut val index = 0U64
                while index < selectors.count() {
                    if selectors[index].traitInstance.owner != 0U64 {
                        val saved = try self.signatureOccurrenceView(proofs: proofs, occurrence: node.occurrence, selector: selectors[index], offset: occurrence.site)
                        val proofSubject = self.authoredTraitViewSubject(ref: receiver)
                        try self.readAuthoredOccurrenceProof(saved: saved, receiver: proofSubject, arguments: sourceViews[index].traitInstance.positionalArgs, environment: environment, offset: occurrence.site, normalizations: proofEquations, context: context)
                    }
                    index += 1U64
                }
                if original.assocNameId != 0U64 {
                    val owner = if original.assocTraitDeclOffset != 0U64 { give original.assocTraitDeclOffset } else { give original.assocTraitStart }
                    mut val arguments: Array[U64] = []
                    index = 1U64
                    while index < children.count() {
                        arguments.append(children[index])
                        index += 1U64
                    }
                    val selector = <ResolvedViewSource writtenStart=occurrence.site surfaceId=original.assocTraitId traitInstance=<TraitInstanceKey owner=owner positionalArgs=original.assocTraitArgs /> />
                    val saved = try self.signatureOccurrenceView(proofs: proofs, occurrence: node.occurrence, selector: selector, offset: occurrence.site)
                    val lexicalEquations = try self.readSignatureLexicalEquations(selected: saved, environment: environment, offset: occurrence.site)
                    if lexicalEquations.count() != 0U64 {
                        for index in 0U64..<arguments.count() {
                            arguments[index] = try self.replayProjectionNormalizations(ref: arguments[index], normalizations: lexicalEquations, offset: occurrence.site)
                        }
                    }
                    val projected = self.rebuildProjectionTerm(t: original, receiver: receiver, traitArgs: arguments)
                    term = projected
                    val proof = try self.readAuthoredOccurrenceProof(saved: saved, receiver: receiver, arguments: arguments, environment: environment, offset: occurrence.site, normalizations: proofEquations, context: context)
                    match context {
                        SignatureRecipeContext.Requirement(signature: val interface) => {
                            memo[recipe] = <AuthoredRecipeRead term=0U64 reading=true views=[] normalizations=[] />
                            val output = try self.readRequirementProjectionOutput(proof: proof, interface: interface, receiver: receiver, selector: selector, arguments: arguments, member: original.assocNameId, environment: environment, offset: occurrence.site, memo: inout memo)
                            if output != 0U64 { term = output }
                        }
                        SignatureRecipeContext.Provided(owner: val function) => {
                            memo[recipe] = <AuthoredRecipeRead term=0U64 reading=true views=[] normalizations=[] />
                            val output = try self.readProvidedProjectionOutput(proof: proof, function: function, receiver: receiver, selector: selector, arguments: arguments, member: original.assocNameId, environment: environment, offset: occurrence.site, memo: inout memo)
                            if output != 0U64 { term = output }
                        }
                        SignatureRecipeContext.Concrete | SignatureRecipeContext.AssociatedBinding(requirement: _) => {
                            memo[recipe] = <AuthoredRecipeRead term=0U64 reading=true views=[] normalizations=[] />
                            val requirement = match context {
                                SignatureRecipeContext.AssociatedBinding(requirement: val inherited) => inherited,
                                _ => <Optional.None />,
                            }
                            val source = if requirement.isSome() {
                                val bound = try self.staticProofBound(proof: proof, traitIdx: self.decls.traitIndexByOffset(offset: owner))
                                if bound.subject == 0U64 { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "associated binding projection lost its requirement subject", failureDomain: <FailureDomain.Internal />) /> }
                                give self.rebuildProjectionTerm(t: original, receiver: bound.subject, traitArgs: bound.constraint.key.positionalArgs)
                            } else { give projected }
                            term = source
                            val output = try self.readSelectedProjectionOutput(proof: proof, traitOwner: owner, assocId: original.assocNameId, requirement: requirement)
                            for equation in output.normalizations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout normalizations) }
                            val raw = output.immediate
                            val immediate = if raw != 0U64 && !self.typeRefEq(a: raw, b: source) { give raw } else { give 0U64 }
                            try self.appendRetainedProjectionEquation(step: <ProjectionNormalizationStep source=source proof=self.freezeStaticConformanceProof(proof: proof) output=immediate />, normalizations: inout normalizations)
                            if output.term != 0U64 {
                                term = output.term
                            } else if requirement.isSome() {
                                val lexical = requirement.unwrap().environment
                                term = self.groundTermInEnvironment(ref: source, params: lexical.params, values: lexical.args, selfRef: lexical.receiverRef)
                            } else {
                                match context {
                                    SignatureRecipeContext.Concrete => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "saved signature projection is not instantiated", failureDomain: <FailureDomain.Internal />) /> }
                                    _ => {}
                                }
                            }
                        }
                    }
                    term = try self.replayProjectionNormalizations(ref: term, normalizations: lexicalEquations, offset: occurrence.site)
                }
            }
            SourceTypeRecipeOrigin.ResultRepresentation => {
                val source = try self.readAuthoredTypeRecipe(proofs: proofs, recipe: node.sourceRecipe, environment: environment, memo: inout memo, receiverEquations: receiverEquations, context: context)
                term = self.semanticSourceResultTerm(ref: source.term)
                for equation in source.normalizations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout normalizations) }
            }
            SourceTypeRecipeOrigin.ProjectionReceiver | SourceTypeRecipeOrigin.LexicalParameter | SourceTypeRecipeOrigin.InheritedTraitArgument => {}
            SourceTypeRecipeOrigin.BoundSelection => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "signature reader encountered an unadmitted bound recipe", failureDomain: <FailureDomain.Internal />) /> }
        }
        val read = <AuthoredRecipeRead term=term views=sourceViews normalizations=normalizations />
        memo[recipe] = read
        return <Result.Ok value=read />
    }

    inout fn signatureOccurrenceView(proofs: Array[AuthoredTypeViewProof], occurrence: U64, selector: ResolvedViewSource, offset: U64) -> Result[AuthoredTypeViewProof, CompileDiagnostic] {
        for saved in proofs {
            if saved.occurrence == occurrence && self.semanticViewSourceEq(a: saved.selector, b: selector) { return <Result.Ok value=saved /> }
        }
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature view has no saved proof", failureDomain: <FailureDomain.Internal />) />
    }

    inout fn readAuthoredOccurrenceProof(saved: AuthoredTypeViewProof, receiver: U64, arguments: Array[U64], environment: InstanceEnvironment, offset: U64, normalizations: Array[ProjectionNormalizationStep], context: SignatureRecipeContext) -> Result[StaticConformanceProof, CompileDiagnostic] {
        match context {
            SignatureRecipeContext.Concrete => {
                return self.instantiateAuthoredViewProof(saved: saved, receiver: receiver, arguments: arguments, environment: environment, offset: offset, normalizations: normalizations)
            }
            SignatureRecipeContext.AssociatedBinding(requirement: val requirement) => {
                if !self.arena.hasStaticConformanceProof(id: saved.proof) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated binding lost its projection proof", failureDomain: <FailureDomain.Internal />) />
                }
                val proof = self.thawStaticConformanceProof(id: saved.proof)
                val state = try self.replayConstraintProof(proof: proof, receiver: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64, context: <Optional.None />, normalizations: normalizations, declaration: true)
                match state {
                    ConstraintProofReplay.Concrete(proof: val selected) | ConstraintProofReplay.Universal(proof: val selected) => {
                        try self.checkStaticProofEvidence(proof: selected, offset: offset)
                        val bound = try self.replayBoundNormalizations(bound: (try self.staticProofBound(proof: selected, traitIdx: self.decls.traitIndexByOffset(offset: saved.selector.traitInstance.owner))), normalizations: normalizations)
                        if bound.subject != 0U64 && self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: bound.subject), b: self.typeRefWithoutOuterViews(ref: receiver)) && self.sameResolvedTypeRefs(a: bound.constraint.key.positionalArgs, b: arguments) {
                            return self.readBindingRequirementProof(proof: selected, requirement: requirement, offset: offset)
                        }
                    }
                    ConstraintProofReplay.Deferred | ConstraintProofReplay.Missing => {}
                }
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated binding projection has no matching retained conformance", failureDomain: <FailureDomain.Internal />) />
            }
            _ => {
                val proof = self.thawStaticConformanceProof(id: saved.proof)
                match proof {
                    StaticConformanceProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature view lost its proof", failureDomain: <FailureDomain.Internal />) /> }
                    _ => { return <Result.Ok value=proof /> }
                }
            }
        }
    }

    // These equations were proved in the lexical Self environment. The reader
    // substitutes their endpoints as type terms, without reselecting evidence
    // or treating the lexical proof as an executable witness.
    inout fn readSignatureLexicalEquations(selected: AuthoredTypeViewProof, environment: InstanceEnvironment, offset: U64) -> Result[Array[ProjectionNormalizationStep], CompileDiagnostic] {
        val equations = selected.lexicalEquations
        if equations.count() == 0U64 { return <Result.Ok value=[] /> }
        val premise = self.signatureProjectionPremise(proof: self.thawStaticConformanceProof(id: selected.proof))
        if premise.steps.count() == 0U64 || premise.source.isNone() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature equations lost their lexical receiver", failureDomain: <FailureDomain.Internal />) />
        }
        match self.checkProjectionNormalizations(normalizations: equations, offset: offset, assumptions: [premise.source.unwrap()]) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: diagnostic.message, failureDomain: <FailureDomain.Internal />) /> }
        }
        mut val substitutions: Array[ProjectionNormalizationStep] = []
        for equation in equations {
            val source = self.groundTermInEnvironment(ref: equation.source, params: environment.params, values: environment.args, selfRef: environment.receiverRef)
            val output = self.groundTermInEnvironment(ref: equation.output, params: environment.params, values: environment.args, selfRef: environment.receiverRef)
            substitutions.append(<ProjectionNormalizationStep source=(try self.replayProjectionChildren(ref: source, normalizations: substitutions, offset: offset)) output=output proof=equation.proof />)
        }
        return <Result.Ok value=substitutions />
    }

    // Validate the saved constructor graph once per declaration. The semantic
    // visitor owns child shape and labels; recipes only retain the chosen edges.
    // false marks an active node, true a fully validated node of this owner.
    inout fn checkAuthoredTypeRecipe(sourceScope: U64, recipe: U64, edge: AuthoredRecipeEdge, scopes: SignatureProofScopes, validation: inout SignatureRecipeValidation, offset: U64) -> Result[(), CompileDiagnostic] {
        val node = match self.sourceTypeUses.recipeAt(id: recipe) {
            Optional.Some(v: val node) => node,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe has an invalid node", failureDomain: <FailureDomain.Internal />) /> },
        }
        if node.term >= self.arena.typeCount() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe has an invalid term", failureDomain: <FailureDomain.Internal />) /> }
        // Context is checked even for a memoized node: a previously validated
        // receiver/result cannot be reused as an ordinary authored argument.
        val permitted = match node.origin {
            SourceTypeRecipeOrigin.Authored => true,
            // A nested projection needs its own occurrence and retained proof;
            // a synthetic receiver constructor cannot hide that source step.
            SourceTypeRecipeOrigin.ProjectionReceiver => match edge { AuthoredRecipeEdge.ProjectionReceiver => self.arena.typeAt(index: node.term).assocNameId == 0U64, _ => false },
            SourceTypeRecipeOrigin.ResultRepresentation => match edge { AuthoredRecipeEdge.FunctionResult => true, _ => false },
            // Legacy lexical completion has no retained clause/binder origin.
            // It cannot authorize a source edge. Non-free owner migration must
            // forward the actual originating recipe before using this gate.
            SourceTypeRecipeOrigin.BoundSelection => false,
            SourceTypeRecipeOrigin.InheritedTraitArgument => match edge { AuthoredRecipeEdge.InheritedTraitArgument => true, _ => false },
            SourceTypeRecipeOrigin.LexicalParameter => match edge {
                AuthoredRecipeEdge.LexicalTraitArgument => node.children.count() == 0U64 && self.arena.typeTermAt(index: node.term).paramId != 0U64,
                _ => false,
            },
        }
        if !permitted { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe has an invalid derived edge", failureDomain: <FailureDomain.Internal />) /> }
        if validation.admittedDeclarations.getOr(key: recipe, fallback: false) { return <Result.Ok value=() /> }
        match validation.visited.get(key: recipe) {
            Optional.Some(v: val ready) => {
                if ready { return <Result.Ok value=() /> }
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe contains a cycle", failureDomain: <FailureDomain.Internal />) />
            }
            Optional.None => {}
        }
        validation.visited[recipe] = false
        match node.origin {
            SourceTypeRecipeOrigin.Authored => {
                if node.occurrence == 0U64 || node.sourceRecipe != 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe has no exact source occurrence", failureDomain: <FailureDomain.Internal />) /> }
                val occurrence = try self.signatureOccurrence(id: node.occurrence)
                if occurrence.scope != sourceScope {
                    if occurrence.scope != validation.parentScope || !validation.inherited.contains(key: recipe) {
                        return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature has a foreign type occurrence", failureDomain: <FailureDomain.Internal />) />
                    }
                    try self.checkSignatureOccurrence(occurrence: occurrence, scope: validation.parentScope, parameters: validation.parentParameters, selfParameter: validation.selfParameter, method: true)
                } else {
                    try self.checkSignatureOccurrence(occurrence: occurrence, scope: sourceScope, parameters: scopes.local.parameters, selfParameter: scopes.local.selfParameter, method: scopes.scopedBinders, useRole: scopes.useRole)
                }
                if occurrence.recipe != recipe || !self.typeRefEq(a: occurrence.term, b: node.term) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe changed its source occurrence", failureDomain: <FailureDomain.Internal />) /> }
            }
            SourceTypeRecipeOrigin.ResultRepresentation => {
                val source = self.sourceTypeUses.recipeAt(id: node.sourceRecipe)
                if node.occurrence != 0U64 || source.isNone() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe lost its result representation source", failureDomain: <FailureDomain.Internal />) /> }
                match source.unwrap().origin {
                    SourceTypeRecipeOrigin.Authored => {}
                    _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "result representation must retain an authored source", failureDomain: <FailureDomain.Internal />) /> }
                }
                if !self.sourceResultRepresentationMatches(source: source.unwrap().term, payload: node.term) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe has an invalid result representation", failureDomain: <FailureDomain.Internal />) /> }
                try self.checkAuthoredTypeRecipe(sourceScope: sourceScope, recipe: node.sourceRecipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: offset)
            }
            SourceTypeRecipeOrigin.ProjectionReceiver | SourceTypeRecipeOrigin.BoundSelection | SourceTypeRecipeOrigin.LexicalParameter | SourceTypeRecipeOrigin.InheritedTraitArgument => {
                if node.occurrence != 0U64 || node.sourceRecipe != 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "derived type recipe acquired source authority", failureDomain: <FailureDomain.Internal />) /> }
            }
        }
        val count = self.typeTermRefChildCount(ref: node.term)
        if node.children.count() != count || node.labels.count() != count { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe does not cover canonical children", failureDomain: <FailureDomain.Internal />) /> }
        mut val receiverOccurrence = 0U64
        mut val inheritedProjection = false
        mut val index = 0U64
        while index < count {
            val child = match self.sourceTypeUses.recipeAt(id: node.children[index]) {
                Optional.Some(v: val child) => child,
                Optional.None => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe has an invalid child", failureDomain: <FailureDomain.Internal />) /> },
            }
            if !self.typeRefEq(a: child.term, b: self.typeTermRefChildRef(ref: node.term, index: index)) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe child differs from canonical term", failureDomain: <FailureDomain.Internal />) /> }
            if node.labels[index] != self.typeTermRefIdentityChildLabel(ref: node.term, index: index) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored type recipe child has a foreign label", failureDomain: <FailureDomain.Internal />) /> }
            val term = self.arena.typeTermAt(index: node.term)
            if index == 0U64 && term.assocNameId != 0U64 && self.arena.typeTermAt(index: child.term).assocNameId != 0U64 {
                receiverOccurrence = child.occurrence
            }
            val inherited = match node.origin {
                SourceTypeRecipeOrigin.InheritedTraitArgument => true,
                SourceTypeRecipeOrigin.Authored => match child.origin {
                    SourceTypeRecipeOrigin.InheritedTraitArgument => term.assocNameId != 0U64 && index != 0U64 && index <= term.assocTraitArgs.len,
                    _ => false,
                },
                _ => false,
            }
            if inherited { inheritedProjection = true }
            val childEdge = if inherited { give <AuthoredRecipeEdge.InheritedTraitArgument /> }
              else if term.assocNameId != 0U64 && index == 0U64 { give <AuthoredRecipeEdge.ProjectionReceiver /> }
              else if index != 0U64 && index <= scopes.lexicalTraitArguments.count() && term.assocNameId != 0U64 && self.associatedProjectionTraitOwner(projection: self.arena.typeAt(index: node.term)) == scopes.lexicalTrait && self.typeRefEq(a: child.term, b: scopes.lexicalTraitArguments[index - 1U64]) { give <AuthoredRecipeEdge.LexicalTraitArgument /> }
              else if self.isFnType(ref: node.term) && index == 0U64 { give <AuthoredRecipeEdge.FunctionResult /> }
              else { give <AuthoredRecipeEdge.Source /> }
            try self.checkAuthoredTypeRecipe(sourceScope: sourceScope, recipe: node.children[index], edge: childEdge, scopes: scopes, validation: inout validation, offset: offset)
            index += 1U64
        }
        mut val equations: Array[ProjectionNormalizationStep] = []
        for child in node.children {
            match validation.equations.get(key: child) {
                Optional.Some(v: val childEquations) => {
                    for equation in childEquations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations) }
                }
                Optional.None => {}
            }
        }
        if node.sourceRecipe != 0U64 {
            match validation.equations.get(key: node.sourceRecipe) {
                Optional.Some(v: val sourceEquations) => {
                    for equation in sourceEquations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations) }
                }
                Optional.None => {}
            }
        }
        match node.origin {
            SourceTypeRecipeOrigin.Authored => {
                val occurrence = try self.signatureOccurrence(id: node.occurrence)
                if occurrence.scope == sourceScope {
                    try self.admitSignatureOccurrence(id: node.occurrence, occurrence: occurrence, scope: scopes.local, assumptions: scopes.assumptions, receiverRef: scopes.receiver, receiverEquations: validation.receiverEquations, equations: inout equations, proofs: inout validation.proofs, inheritedProjection: inheritedProjection, receiverOccurrence: receiverOccurrence)
                } else {
                    val parent = <DeclarationTypeScope owner=scopes.local.owner parameters=validation.parentParameters selfParameter=validation.selfParameter />
                    try self.admitSignatureOccurrence(id: node.occurrence, occurrence: occurrence, scope: parent, assumptions: scopes.inherited, receiverRef: scopes.receiver, receiverEquations: validation.receiverEquations, equations: inout equations, proofs: inout validation.proofs, inheritedProjection: inheritedProjection, receiverOccurrence: receiverOccurrence)
                }
            }
            _ => {}
        }
        if equations.count() != 0U64 { validation.equations[recipe] = equations }
        validation.visited[recipe] = true
        return <Result.Ok value=() />
    }

    // Both memberless views and projections must interpret their retained
    // premise. A value substitution alone never manufactures conformance.
    inout fn instantiateAuthoredViewProof(saved: AuthoredTypeViewProof, receiver: U64, arguments: Array[U64], environment: InstanceEnvironment, offset: U64, normalizations: Array[ProjectionNormalizationStep]) -> Result[StaticConformanceProof, CompileDiagnostic] {
        val state = try self.instantiateConstraintProof(proof: self.thawStaticConformanceProof(id: saved.proof), receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64, normalizations: normalizations)
        match state {
            StaticProofInstantiation.Ready(proof: val proof) => {
                try self.checkRetainedWitnessClause(expected: <TraitBound subject=receiver constraint=<TraitConstraint key=<TraitInstanceKey owner=saved.selector.traitInstance.owner positionalArgs=arguments /> assocPredicates=[] /> offset=offset />, proof: proof, normalizations: normalizations, offset: offset)
                return <Result.Ok value=proof />
            }
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "saved signature view is not instantiated", failureDomain: <FailureDomain.Internal />) /> }
        }
    }

    // Binder ownership is independent of whether an associated output is
    // concrete yet. Deferred-obligation analysis additionally requires a caller
    // dependency; that is not the contract of source type/view formation.
    inout fn checkAuthoredTypeBinders(ref: U64, scope: DeclarationTypeScope, offset: U64) -> Result[(), CompileDiagnostic] {
        if ref >= self.arena.typeTermCount() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "authored annotation has an invalid type term", failureDomain: <FailureDomain.Internal />) /> }
        if self.arena.typeIsClosed(ref: ref) { return <Result.Ok value=() /> }
        val term = self.arena.typeTermAt(index: ref)
        if term.paramId != 0U64 && term.assocNameId == 0U64 { try self.declarationParameterDependencies(parameter: term.paramId, scope: scope, offset: offset) }
        mut val index = 0U64
        while index < self.typeTermRefChildCount(ref: ref) {
            try self.checkAuthoredTypeBinders(ref: self.typeTermRefChildRef(ref: ref, index: index), scope: scope, offset: offset)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn signatureOccurrence(id: U64) -> Result[AuthoredTypeUse, CompileDiagnostic] {
        if id == 0U64 || id > self.sourceTypeUses.useCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "invalid authored type occurrence", failureDomain: <FailureDomain.Internal />) /> }
        return <Result.Ok value=self.sourceTypeUses.useAt(index: id - 1U64).unwrap() />
    }

    inout fn admitBodyTypeUse(id: U64, term: U64, owner: SemanticCompletionOwner) -> Result[LocalAnnotationProof, CompileDiagnostic] {
        val occurrence = try self.signatureOccurrence(id: id)
        val lexical = self.lexicalSourceFactOwner(owner: owner)
        val function = match lexical {
            SemanticCompletionOwner.Global(target: val target) => {
                val token = self.sourceTypeUses.globalScope(target: target)
                return self.admitGlobalTypeUse(occurrence: occurrence, id: id, term: term, target: target, token: token, role: <SourceTypeUseRole.Body />)
            }
            SemanticCompletionOwner.Function(index: val index) => index,
            _ => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored body type has no lexical declaration", failureDomain: <FailureDomain.Internal />) /> },
        }
        mut val declarationFunction = function
        mut val defaultToken: U64 = 0U64
        mut val fieldDefaultParent: Optional[U64] = <Optional.None />
        match self.decls.defaultGeneratorOrigins.get(key: function) {
            Optional.Some(v: val origin) => {
                val expression = try self.defaultOriginExpression(origin: origin, offset: occurrence.site)
                defaultToken = self.sourceTypeUses.defaultExpressionScope(origin: self.arena.exprOriginSerial[expression])
                if defaultToken == 0U64 {
                    return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "default generator has no authored expression scope", failureDomain: <FailureDomain.Internal />) />
                }
                match origin {
                    DefaultGeneratorOrigin.Parameter(function: val parent, parameter: _) => { declarationFunction = parent }
                    DefaultGeneratorOrigin.Field(structure: val structure, field: _) => {
                        fieldDefaultParent = <Optional.Some v=self.arena.structAt(index: structure).sourceTypeScope />
                    }
                }
            }
            Optional.None => {}
        }
        val signatureToken = match self.sourceTypeUses.signatureFor(function: declarationFunction) {
            Optional.Some(v: val signature) => signature.scope,
            Optional.None => self.sourceTypeUses.deinitScopeToken(function: declarationFunction),
        }
        val token = if defaultToken != 0U64 { give defaultToken } else { give signatureToken }
        val sourceScope = match self.sourceTypeUses.scopeAt(token: token) {
            Optional.Some(v: val scope) => scope,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored body type has no registered lexical declaration", failureDomain: <FailureDomain.Internal />) /> },
        }
        match sourceScope.state {
            SourceTypeScopeState.Lowered => {}
            _ => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored body type belongs to an unfinished declaration", failureDomain: <FailureDomain.Internal />) /> }
        }
        val matchesOwner = if defaultToken != 0U64 {
            give sourceScope.parent == fieldDefaultParent.unwrapOr(fallback: signatureToken)
        } else { give sourceScope.function.unwrapOr(fallback: 18446744073709551615U64) == function }
        if occurrence.term != term || occurrence.scope != token || !matchesOwner {
            return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored body type has a foreign occurrence", failureDomain: <FailureDomain.Internal />) />
        }
        val declaration = self.arena.functionAt(index: declarationFunction)
        val scope = try self.declarationTypeScope(owner: function)
        val assumptions = try self.declarationScopeAssumptions(scope: scope)
        val method = self.sourceTypeUses.methodScopeFor(function: declarationFunction).isSome()
        val role = if defaultToken != 0U64 { give <SourceTypeUseRole.DefaultArgument /> } else { give <SourceTypeUseRole.Body /> }
        mut val validation = <SignatureRecipeValidation />
        // Short projections may link to a where-clause argument or a parent
        // receiver argument. Other annotations have only body-owned recipes.
        if self.arena.typeContainsAssociatedProjection(ref: term) {
            try self.checkSignatureOccurrence(occurrence: occurrence, scope: token, parameters: scope.parameters, selfParameter: scope.selfParameter, method: method, useRole: role)
            match self.authoredSignatureViews.get(key: declarationFunction) {
                Optional.Some(v: val admitted) => {
                    if admitted.signature.scope != signatureToken || admitted.signature.function != declarationFunction {
                        return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored body type has a foreign signature admission", failureDomain: <FailureDomain.Internal />) />
                    }
                    validation = <SignatureRecipeValidation parentScope=admitted.parentScope parentParameters=admitted.parentParameters selfParameter=admitted.parentSelfParameter inherited=admitted.inheritedRecipes admittedDeclarations=admitted.recipeChecks equations=admitted.recipeEquations receiverEquations=admitted.receiverEquations proofs=admitted.proofs />
                }
                Optional.None => {}
            }
        }
        val inherited = self.methodSignatureInheritedAssumptions(parentScope: validation.parentScope, assumptions: assumptions)
        val scopes = <SignatureProofScopes local=scope assumptions=assumptions inherited=inherited receiver=declaration.recvTy scopedBinders=method useRole=role />
        try self.checkAuthoredTypeRecipe(sourceScope: token, recipe: occurrence.recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: occurrence.site)
        val receiverType = self.groundTermInEnvironment(ref: term, params: [], values: [], selfRef: scopes.receiver)
        val equations = validation.equations.getOr(key: occurrence.recipe, fallback: [])
        val sourceTerm = try self.replayProjectionNormalizations(ref: receiverType, normalizations: equations, offset: occurrence.site)
        return <Result.Ok value=<LocalAnnotationProof occurrence=id recipe=occurrence.recipe sourceTerm=sourceTerm normalizations=equations proofs=validation.proofs /> />
    }

    inout fn admitNominalTypeAnnotations() -> Result[(), CompileDiagnostic] {
        for index in 0U64..<self.arena.newtypeCount() {
            try self.admitNewtypeAnnotation(index: index)
        }
        self.newtypeAnnotationAdmissionOpen = false
        for index in 0U64..<self.arena.structCount() {
            val declaration = self.arena.structAt(index: index)
            if declaration.sourceTypeScope == 0U64 { continue }
            val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.Nominal /> owner=declaration.defOffset parameters=self.pushFuncBinds(binds: declaration.typeParams) />
            for fieldIndex in 0U64..<declaration.fields.count() {
                val field = declaration.fields[fieldIndex]
                val proof = try self.admitNominalTypeAnnotation(id: field.authoredTypeUse, site: field.authoredTypeSite, term: field.ty, token: declaration.sourceTypeScope, scope: scope)
                if proof.sourceTerm != field.ty {
                    self.arena.setAdmittedStructFieldType(index: index, field: fieldIndex, term: proof.sourceTerm)
                }
            }
        }
        for index in 0U64..<self.arena.enumCount() {
            val declaration = self.arena.enumAt(index: index)
            if declaration.sourceTypeScope == 0U64 { continue }
            val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.Nominal /> owner=declaration.defOffset parameters=self.pushFuncBinds(binds: declaration.typeParams) />
            for variantIndex in 0U64..<declaration.variants.count() {
                val variant = declaration.variants[variantIndex]
                for fieldIndex in 0U64..<variant.fields.count() {
                    val field = variant.fields[fieldIndex]
                    val proof = try self.admitNominalTypeAnnotation(id: field.authoredTypeUse, site: field.authoredTypeSite, term: field.ty, token: declaration.sourceTypeScope, scope: scope)
                    if proof.sourceTerm != field.ty {
                        self.arena.setAdmittedEnumFieldType(index: index, variant: variantIndex, field: fieldIndex, term: proof.sourceTerm)
                    }
                }
            }
        }
        return <Result.Ok value=() />
    }

    // Resolve once per declaration. A view requiring another newtype's
    // inherited conformance may request that underlying before its source row
    // is reached. Active declarations cannot supply their own prerequisites.
    inout fn readAdmittedNewtypeUnderlying(declaration: NewtypeDef) -> Result[U64, CompileDiagnostic] {
        val saved = try self.requireNominalTypeAnnotation(id: declaration.authoredTypeUse, site: declaration.authoredTypeSite, term: declaration.underRef, token: declaration.sourceTypeScope, owner: declaration.defOffset)
        try self.checkNominalAnnotationEvidence(saved: saved, offset: declaration.authoredTypeSite)
        return <Result.Ok value=declaration.underRef />
    }

    inout fn admitNewtypeAnnotation(index: U64) -> Result[(), CompileDiagnostic] {
        val declaration = self.arena.newtypeAt(index: index)
        if declaration.sourceTypeScope == 0U64 || self.nominalAnnotationProofs.contains(key: declaration.authoredTypeUse) {
            return <Result.Ok value=() />
        }
        if self.activeNewtypeAnnotations.contains(index) {
            return <Result.Err error=self.diagnosticAt(offset: declaration.authoredTypeSite, msg: "newtype underlying annotation has a cyclic dependency (spec/10)", failureDomain: <FailureDomain.Source />) />
        }
        self.activeNewtypeAnnotations.insert(index)
        val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.Nominal /> owner=declaration.defOffset parameters=<FuncBindRange start=0U64 len=0U64 /> />
        val result = self.admitNominalTypeAnnotation(id: declaration.authoredTypeUse, site: declaration.authoredTypeSite, term: declaration.underRef, token: declaration.sourceTypeScope, scope: scope)
        self.activeNewtypeAnnotations.remove(index)
        val proof = try result
        if proof.sourceTerm != declaration.underRef {
            self.arena.setAdmittedNewtypeUnderlying(index: index, term: proof.sourceTerm)
        }
        return <Result.Ok value=() />
    }

    // A selected field owns its written occurrence; only the exact nominal
    // instance supplies its substitutions. Open uses retain the admitted term
    // until a closed instance can interpret the saved conformance.
    inout fn selectedNominalFieldType(field: FieldDef, token: U64, owner: U64, params: Array[Bind], receiver: U64) -> Result[U64, CompileDiagnostic] {
        if token == 0U64 { return self.groundUnderInst(instRef: receiver, tyRef: field.ty) }
        if receiver == 0U64 || receiver >= self.arena.typeCount() {
            return <Result.Err error=self.diagnosticAt(offset: field.authoredTypeSite, msg: "nominal field has no selected receiver", failureDomain: <FailureDomain.Internal />) />
        }
        val head = self.arena.typeTermAt(index: receiver)
        if head.hasDecl && head.declOffset != owner {
            return <Result.Err error=self.diagnosticAt(offset: field.authoredTypeSite, msg: "nominal field has a foreign selected receiver", failureDomain: <FailureDomain.Internal />) />
        }
        val saved = try self.requireNominalTypeAnnotation(id: field.authoredTypeUse, site: field.authoredTypeSite, term: field.ty, token: token, owner: owner)
        try self.checkNominalAnnotationEvidence(saved: saved, offset: field.authoredTypeSite)
        if self.arena.typeIsClosed(ref: field.ty) {
            return <Result.Ok value=field.ty />
        }
        val instance = self.arena.typeAt(index: receiver)
        if instance.args.count() != params.count() || !self.arena.typeIsClosed(ref: receiver) {
            return self.groundUnderInst(instRef: receiver, tyRef: field.ty)
        }
        val environment = <InstanceEnvironment params=params args=instance.args receiverRef=receiver />
        if saved.proofs.count() == 0U64 {
            return <Result.Ok value=self.groundTermInEnvironment(ref: field.ty, params: params, values: instance.args, selfRef: receiver) />
        }
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        val admitted = try self.readAuthoredTypeRecipe(proofs: saved.proofs, recipe: saved.recipe, environment: environment, memo: inout memo, context: <SignatureRecipeContext.Concrete />)
        return <Result.Ok value=admitted.term />
    }

    inout fn requireNominalTypeAnnotation(id: U64, site: U64, term: U64, token: U64, owner: U64) -> Result[LocalAnnotationProof, CompileDiagnostic] {
        val occurrence = try self.signatureOccurrence(id: id)
        val source = self.sourceTypeUses.scopeAt(token: token)
        match self.nominalAnnotationProofs.get(key: id) {
            Optional.Some(v: val saved) => {
                if saved.occurrence == id && saved.recipe == occurrence.recipe && saved.sourceTerm == term && occurrence.site == site && occurrence.scope == token && source.isSome() && source.unwrap().anchor == owner {
                    return <Result.Ok value=saved />
                }
            }
            Optional.None => {}
        }
        return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "nominal type has no matching saved annotation", failureDomain: <FailureDomain.Internal />) />
    }

    // A proof for the same receiver and trait is insufficient: it can
    // name a different conformance. Compare against the exact selection
    // published for this recipe, without replaying witness discovery.
    inout fn checkNominalAnnotationEvidence(saved: LocalAnnotationProof, offset: U64) -> Result[(), CompileDiagnostic] {
        val selection = match self.nominalAnnotationSelections.get(key: saved.recipe) {
            Optional.Some(v: val selection) => selection,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "nominal annotation lost its selected evidence", failureDomain: <FailureDomain.Internal />) /> }
        }
        if saved.sourceTerm != selection.sourceTerm || saved.proofs.count() != selection.proofs.count() || saved.normalizations.count() != selection.equations.count() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "nominal annotation lost its selected evidence", failureDomain: <FailureDomain.Internal />) />
        }
        for index in 0U64..<selection.proofs.count() {
            val proof = saved.proofs[index]
            val expected = selection.proofs[index]
            if proof.proof != expected.proof || proof.occurrence != expected.occurrence || proof.receiver != expected.receiver || proof.lexicalEquations.count() != 0U64 || !self.semanticViewSourceEq(a: proof.selector, b: expected.selector) || !self.arena.hasStaticConformanceProof(id: proof.proof) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "nominal annotation has a foreign saved conformance", failureDomain: <FailureDomain.Internal />) />
            }
        }
        for index in 0U64..<selection.equations.count() {
            val expected = selection.equations[index]
            val equation = saved.normalizations[index]
            if equation.source != expected.source || equation.proof != expected.proof || equation.output != expected.output || !self.arena.hasStaticConformanceProof(id: equation.proof) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "nominal projection has a foreign saved equation", failureDomain: <FailureDomain.Internal />) />
            }
        }
        return <Result.Ok value=() />
    }

    // Surface visibility examines what was written. Field and representation
    // consumers use the admitted term, which may have erased private selectors.
    fn writtenNominalAnnotation(id: U64, fallback: U64) -> U64 {
        if id == 0U64 { return fallback }
        return self.sourceTypeUses.useAt(index: id - 1U64).unwrap().term
    }

    inout fn admitNominalTypeAnnotation(id: U64, site: U64, term: U64, token: U64, scope: DeclarationTypeScope) -> Result[LocalAnnotationProof, CompileDiagnostic] {
        val occurrence = try self.signatureOccurrence(id: id)
        val source = match self.sourceTypeUses.scopeAt(token: token) {
            Optional.Some(v: val source) => source,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "nominal annotation has no source scope", failureDomain: <FailureDomain.Internal />) /> }
        }
        match source.kind {
            SourceTypeScopeKind.Nominal => {}
            _ => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "nominal annotation has a foreign scope kind", failureDomain: <FailureDomain.Internal />) /> }
        }
        match source.state {
            SourceTypeScopeState.Lowered => {}
            _ => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "nominal annotation belongs to an unfinished declaration", failureDomain: <FailureDomain.Internal />) /> }
        }
        if source.anchor != scope.owner || occurrence.site != site || occurrence.scope != token || occurrence.term != term || self.nominalAnnotationProofs.contains(key: id) {
            return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "nominal annotation has a foreign source occurrence", failureDomain: <FailureDomain.Internal />) />
        }
        val scopes = <SignatureProofScopes local=scope assumptions=[] inherited=[] receiver=0U64 />
        mut val validation = <SignatureRecipeValidation />
        try self.checkAuthoredTypeRecipe(sourceScope: token, recipe: occurrence.recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: occurrence.site)
        val equations = validation.equations.getOr(key: occurrence.recipe, fallback: [])
        val sourceTerm = try self.replayProjectionNormalizations(ref: term, normalizations: equations, offset: occurrence.site)
        val proof = <LocalAnnotationProof occurrence=id recipe=occurrence.recipe sourceTerm=sourceTerm normalizations=equations proofs=validation.proofs />
        self.nominalAnnotationProofs[id] = proof
        self.nominalAnnotationSelections[occurrence.recipe] = <NominalAnnotationSelection sourceTerm=sourceTerm proofs=validation.proofs equations=equations />
        self.markAdmittedRecipeTypeUses(recipe: proof.recipe)
        return <Result.Ok value=proof />
    }

    inout fn admitGlobalAnnotations() -> Result[(), CompileDiagnostic] {
        for global in self.arena.globals {
            match self.arena.stmts[global.letStmt] {
                Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, val ty, init: _, val annotationOccurrence) => {
                    if ty == 0U64 && annotationOccurrence.isNone() { continue }
                    val id = annotationOccurrence.unwrapOr(fallback: 0U64)
                    val occurrence = try self.signatureOccurrence(id: id)
                    val token = self.sourceTypeUses.globalScope(target: global.nameStart)
                    val proof = try self.admitGlobalTypeUse(occurrence: occurrence, id: id, term: ty, target: global.nameStart, token: token, role: <SourceTypeUseRole.Declaration />)
                    self.markAdmittedRecipeTypeUses(recipe: proof.recipe)
                    self.globalAnnotationProofs[global.nameStart] = proof
                }
                _ => { return <Result.Err error=self.diagnosticAt(offset: global.nameStart, msg: "global declaration has no binding", failureDomain: <FailureDomain.Internal />) /> }
            }
        }
        return <Result.Ok value=() />
    }

    inout fn requireGlobalAnnotation(target: U64, id: Optional[U64], written: U64) -> Result[LocalAnnotationProof, CompileDiagnostic] {
        val annotation = match id {
            Optional.Some(v: val annotation) => annotation,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: target, msg: "global declaration has no authored annotation occurrence", failureDomain: <FailureDomain.Internal />) /> }
        }
        val occurrence = try self.signatureOccurrence(id: annotation)
        val proof = match self.globalAnnotationProofs.get(key: target) {
            Optional.Some(v: val proof) => proof,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "global declaration has no admitted annotation", failureDomain: <FailureDomain.Internal />) /> }
        }
        val token = self.sourceTypeUses.globalScope(target: target)
        if token == 0U64 || occurrence.scope != token || proof.occurrence != annotation || proof.recipe != occurrence.recipe || occurrence.term != written {
            return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "global declaration has a foreign annotation proof", failureDomain: <FailureDomain.Internal />) />
        }
        return <Result.Ok value=proof />
    }

    inout fn admitGlobalTypeUse(occurrence: AuthoredTypeUse, id: U64, term: U64, target: U64, token: U64, role: SourceTypeUseRole) -> Result[LocalAnnotationProof, CompileDiagnostic] {
        if token == 0U64 || occurrence.scope != token || occurrence.term != term {
            return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "global type has a foreign source occurrence", failureDomain: <FailureDomain.Internal />) />
        }
        val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.Global /> owner=target parameters=<FuncBindRange start=0U64 len=0U64 /> />
        val scopes = <SignatureProofScopes local=scope assumptions=[] inherited=[] receiver=0U64 useRole=role />
        mut val validation = <SignatureRecipeValidation />
        try self.checkAuthoredTypeRecipe(sourceScope: token, recipe: occurrence.recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: occurrence.site)
        val equations = validation.equations.getOr(key: occurrence.recipe, fallback: [])
        val sourceTerm = try self.replayProjectionNormalizations(ref: term, normalizations: equations, offset: occurrence.site)
        return <Result.Ok value=<LocalAnnotationProof occurrence=id recipe=occurrence.recipe sourceTerm=sourceTerm normalizations=equations proofs=validation.proofs /> />
    }

    fn methodSignatureInheritedAssumptions(parentScope: U64, assumptions: Array[DeclarationBoundRef]) -> Array[DeclarationBoundRef] {
        if parentScope == 0U64 { return [] }
        val parent = self.sourceTypeUses.scopeAt(token: parentScope).unwrap()
        val range = parent.bounds.unwrapOr(fallback: <SourceBoundRange />)
        mut val inherited: Array[DeclarationBoundRef] = []
        for assumption in assumptions {
            match assumption {
                DeclarationBoundRef.Function(index: val index) => {
                    val clause = self.decls.funcBounds.at(index: index).sourceClause
                    if clause >= range.first && clause - range.first < range.count { inherited.append(assumption) }
                }
                DeclarationBoundRef.MethodReceiver(index: _) => { inherited.append(assumption) }
                _ => {}
            }
        }
        return inherited
    }

    inout fn authoredSignatureOccurrence(signature: AuthoredFunctionSignature, id: U64) -> Result[AuthoredTypeUse, CompileDiagnostic] {
        val occurrence = try self.signatureOccurrence(id: id)
        val function = self.arena.functionAt(index: signature.function)
        val method = self.sourceTypeUses.methodScopeFor(function: signature.function).isSome()
        val selfParameter = if method && function.recvTy != 0U64 { give self.arena.typeTermAt(index: function.recvTy).paramId } else { give 0U64 }
        try self.checkSignatureOccurrence(occurrence: occurrence, scope: signature.scope, parameters: function.typeParams, selfParameter: selfParameter, method: method)
        return <Result.Ok value=occurrence />
    }

    inout fn checkSignatureOccurrence(occurrence: AuthoredTypeUse, scope: U64, parameters: FuncBindRange, selfParameter: U64, method: Bool, useRole: SourceTypeUseRole = <SourceTypeUseRole.Declaration />) -> Result[(), CompileDiagnostic] {
        if occurrence.scope != scope { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature has a foreign type occurrence", failureDomain: <FailureDomain.Internal />) /> }
        val matchingRole = match occurrence.role {
            SourceTypeUseRole.Declaration => match useRole { SourceTypeUseRole.Declaration => true, _ => false },
            SourceTypeUseRole.Body => match useRole { SourceTypeUseRole.Body => true, _ => false },
            SourceTypeUseRole.DefaultArgument => match useRole { SourceTypeUseRole.DefaultArgument => true, _ => false },
            _ => false,
        }
        if !matchingRole {
            return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored type occurrence does not belong to its checking phase", failureDomain: <FailureDomain.Internal />) />
        }
        if occurrence.term >= self.arena.typeCount() { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature has an invalid type term", failureDomain: <FailureDomain.Internal />) /> }
        mut val index = 0U64
        for binder in occurrence.parameters {
            if method && (binder.paramId == 0U64 || binder.paramId == selfParameter) { continue }
            if index >= parameters.len || binder.paramId != self.funcBindAt(binds: parameters, index: index).paramId {
                return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature has a foreign binder", failureDomain: <FailureDomain.Internal />) />
            }
            index += 1U64
        }
        if index != parameters.len { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature changed its binder scope", failureDomain: <FailureDomain.Internal />) /> }
        return <Result.Ok value=() />
    }

    inout fn retainInheritedSignatureRecipe(recipe: U64, into: inout Dictionary[U64, Bool], offset: U64) -> Result[(), CompileDiagnostic] {
        if into.contains(key: recipe) { return <Result.Ok value=() /> }
        val node = match self.sourceTypeUses.recipeAt(id: recipe) {
            Optional.Some(v: val node) => node,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "implementation signature lost an originating recipe", failureDomain: <FailureDomain.Internal />) /> },
        }
        into[recipe] = true
        for child in node.children { try self.retainInheritedSignatureRecipe(recipe: child, into: inout into, offset: offset) }
        if node.sourceRecipe != 0U64 { try self.retainInheritedSignatureRecipe(recipe: node.sourceRecipe, into: inout into, offset: offset) }
        return <Result.Ok value=() />
    }

    inout fn methodSignatureRecipes(method: SourceTypeScope, owner: SourceImplementationOwner, function: Func) -> Result[SignatureRecipeValidation, CompileDiagnostic] {
        val parent = self.sourceTypeUses.scopeAt(token: method.parent).unwrap()
        val parameters = function.typeParams
        if method.traitOwner != owner.receiverTrait || function.extId != owner.extensionId || self.moduleOf(offset: method.anchor) != owner.sourceModule || owner.parameters.count() > parameters.len {
            return <Result.Err error=self.diagnosticAt(offset: method.anchor, msg: "method signature lost its implementation identity", failureDomain: <FailureDomain.Internal />) />
        }
        val receiver = self.receiverSubjectTerm(receiver: owner.receiver, traitOwner: owner.receiverTrait)
        if receiver == 0U64 || !self.typeRefEq(a: receiver, b: function.recvTy) || !self.sameResolvedTypeRefs(a: owner.receiverArguments, b: self.copyFuncTypes(types: function.recvTraitArgs)) {
            return <Result.Err error=self.diagnosticAt(offset: method.anchor, msg: "method signature changed its implementation receiver", failureDomain: <FailureDomain.Internal />) />
        }
        mut val index = 0U64
        for parameter in owner.parameters {
            if parameter.paramId != self.funcBindAt(binds: parameters, index: index).paramId { return <Result.Err error=self.diagnosticAt(offset: method.anchor, msg: "method signature changed its implementation binders", failureDomain: <FailureDomain.Internal />) /> }
            index += 1U64
        }
        mut val inherited: Dictionary[U64, Bool] = [:]
        for recipe in owner.receiverArgumentRecipes { try self.retainInheritedSignatureRecipe(recipe: recipe, into: inout inherited, offset: parent.anchor) }
        val bounds = parent.bounds.unwrapOr(fallback: <SourceBoundRange />)
        index = 0U64
        while index < bounds.count {
            val id = bounds.first + index
            val clause = self.projectionBoundClauses[id - 1U64]
            if clause.scope != method.parent { return <Result.Err error=self.diagnosticAt(offset: parent.anchor, msg: "implementation signature has a foreign premise", failureDomain: <FailureDomain.Internal />) /> }
            match clause.state {
                ProjectionBoundState.Ready(bound: val bound) => {
                    for recipe in bound.arguments { try self.retainInheritedSignatureRecipe(recipe: recipe, into: inout inherited, offset: parent.anchor) }
                    if function.provTraitOwner != 0U64 && function.originTraitOwner == 0U64 {
                        if bound.subjectRecipe != 0U64 { try self.retainInheritedSignatureRecipe(recipe: bound.subjectRecipe, into: inout inherited, offset: parent.anchor) }
                        for recipe in bound.predicateRecipes { try self.retainInheritedSignatureRecipe(recipe: recipe, into: inout inherited, offset: parent.anchor) }
                    }
                }
                _ => { return <Result.Err error=self.diagnosticAt(offset: parent.anchor, msg: "implementation signature has an unfinished premise", failureDomain: <FailureDomain.Internal />) /> }
            }
            index += 1U64
        }
        return <Result.Ok value=<SignatureRecipeValidation parentScope=method.parent parentParameters=<FuncBindRange start=parameters.start len=owner.parameters.count() /> selfParameter=self.arena.typeTermAt(index: receiver).paramId inherited=inherited receiverRecipes=owner.receiverArgumentRecipes /> />
    }

    inout fn admitAuthoredFunctionViewSignature(signature: AuthoredFunctionSignature) -> Result[(), CompileDiagnostic] {
        val sourceScope = self.sourceTypeUses.scopeAt(token: signature.scope).unwrap()
        match sourceScope.state { SourceTypeScopeState.Lowered => {} _ => { return <Result.Err error=self.diagnosticAt(offset: sourceScope.anchor, msg: "authored signature scope did not finish lowering", failureDomain: <FailureDomain.Internal />) /> } }
        if signature.function >= self.arena.functionCount() || sourceScope.function.unwrapOr(fallback: 18446744073709551615U64) != signature.function { return <Result.Err error=self.diagnosticAt(offset: sourceScope.anchor, msg: "authored signature lost its function owner", failureDomain: <FailureDomain.Internal />) /> }
        val function = self.arena.functionAt(index: signature.function)
        mut val validation = <SignatureRecipeValidation />
        match sourceScope.kind {
            SourceTypeScopeKind.Method => {
                val owner = match self.sourceTypeUses.completedMethodImplementation(method: sourceScope) {
                    Optional.Some(v: val owner) => owner,
                    Optional.None => { return <Result.Err error=self.diagnosticAt(offset: sourceScope.anchor, msg: "method signature has no completed implementation", failureDomain: <FailureDomain.Internal />) /> },
                }
                validation = try self.methodSignatureRecipes(method: sourceScope, owner: owner, function: function)
            }
            _ => {}
        }
        if signature.parameters.count() != function.params.len { return <Result.Err error=self.diagnosticAt(offset: sourceScope.anchor, msg: "authored signature changed parameter slots", failureDomain: <FailureDomain.Internal />) /> }
        for index in 0U64..<signature.parameters.count() {
            if signature.parameters[index] != self.funcParamAt(params: function.params, index: index).authoredTypeUse {
                return <Result.Err error=self.diagnosticAt(offset: sourceScope.anchor, msg: "authored signature changed parameter occurrence", failureDomain: <FailureDomain.Internal />) />
            }
        }
        val scope = try self.declarationTypeScope(owner: signature.function)
        try self.checkAuthoredCallableSlots(function: function, token: signature.scope, result: signature.result, factoryError: signature.factoryError, scope: scope, scopedBinders: validation.parentScope != 0U64)
        val assumptions = try self.declarationScopeAssumptions(scope: scope)
        val inherited = self.methodSignatureInheritedAssumptions(parentScope: validation.parentScope, assumptions: assumptions)
        val scopes = <SignatureProofScopes local=scope assumptions=assumptions inherited=inherited receiver=function.recvTy scopedBinders=validation.parentScope != 0U64 />
        mut val receiverEquations: Array[ProjectionNormalizationStep] = []
        for recipe in validation.receiverRecipes {
            try self.checkAuthoredTypeRecipe(sourceScope: signature.scope, recipe: recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: sourceScope.anchor)
            for equation in validation.equations.getOr(key: recipe, fallback: []) {
                try self.appendRetainedProjectionEquation(step: equation, normalizations: inout receiverEquations)
            }
        }
        validation.receiverEquations = receiverEquations
        for id in signature.declarationUses {
            val occurrence = try self.authoredSignatureOccurrence(signature: signature, id: id)
            try self.checkAuthoredTypeRecipe(sourceScope: signature.scope, recipe: occurrence.recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: occurrence.site)
        }
        if self.isAuthoredProvidedDeclaration(function: signature.function) && validation.parentScope != 0U64 {
            val parent = self.sourceTypeUses.scopeAt(token: validation.parentScope).unwrap()
            val range = parent.bounds.unwrapOr(fallback: <SourceBoundRange />)
            for index in 0U64..<range.count {
                val bound = try self.retainedSignatureClause(scope: validation.parentScope, id: range.first + index, offset: parent.anchor)
                if bound.subjectRecipe != 0U64 { try self.checkAuthoredTypeRecipe(sourceScope: signature.scope, recipe: bound.subjectRecipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: parent.anchor) }
                for recipe in bound.arguments { try self.checkAuthoredTypeRecipe(sourceScope: signature.scope, recipe: recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: parent.anchor) }
                for recipe in bound.predicateRecipes { try self.checkAuthoredTypeRecipe(sourceScope: signature.scope, recipe: recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: parent.anchor) }
            }
        }
        val clauses = if self.isAuthoredProvidedDeclaration(function: signature.function) && validation.parentScope != 0U64 {
            give try self.admitProvidedClauseIdentities(signature: signature, own: sourceScope.bounds.unwrapOr(fallback: <SourceBoundRange />), parent: validation.parentScope, offset: sourceScope.anchor)
        } else { give [] }
        self.authoredSignatureViews[signature.function] = <AuthoredSignatureViews signature=signature proofs=validation.proofs receiverRecipes=validation.receiverRecipes recipeChecks=validation.visited recipeEquations=validation.equations receiverEquations=validation.receiverEquations parentScope=validation.parentScope parentParameters=validation.parentParameters parentSelfParameter=validation.selfParameter inheritedRecipes=validation.inherited clauses=clauses />
        return <Result.Ok value=() />
    }

    inout fn checkAuthoredCallableSlots(function: Func, token: U64, result: U64, factoryError: U64, scope: DeclarationTypeScope, scopedBinders: Bool) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < function.params.len {
            val parameter = self.funcParamAt(params: function.params, index: index)
            val id = parameter.authoredTypeUse
            if id != 0U64 {
                val occurrence = try self.signatureOccurrence(id: id)
                try self.checkSignatureOccurrence(occurrence: occurrence, scope: token, parameters: scope.parameters, selfParameter: scope.selfParameter, method: scopedBinders)
                if !self.typeRefEq(a: occurrence.term, b: parameter.ty) { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature changed parameter type", failureDomain: <FailureDomain.Internal />) /> }
            }
            index += 1U64
        }
        if function.isFactory {
            if !function.hasRet || result != 0U64 { return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "factory signature changed its implicit result", failureDomain: <FailureDomain.Internal />) /> }
            if factoryError != 0U64 {
                val error = try self.signatureOccurrence(id: factoryError)
            try self.checkSignatureOccurrence(occurrence: error, scope: token, parameters: scope.parameters, selfParameter: scope.selfParameter, method: scopedBinders)
                val args = self.arena.typeAt(index: function.retTy).args
                if args.count() != 2U64 || !self.typeRefEq(a: error.term, b: args[1U64]) { return <Result.Err error=self.diagnosticAt(offset: error.site, msg: "factory signature changed its authored error type", failureDomain: <FailureDomain.Internal />) /> }
            }
        } else if result != 0U64 {
            val occurrence = try self.signatureOccurrence(id: result)
            try self.checkSignatureOccurrence(occurrence: occurrence, scope: token, parameters: scope.parameters, selfParameter: scope.selfParameter, method: scopedBinders)
            if !function.hasRet || !self.typeRefEq(a: occurrence.term, b: function.retTy) { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored signature changed result type", failureDomain: <FailureDomain.Internal />) /> }
        } else if function.hasRet { return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "authored signature lost its result occurrence", failureDomain: <FailureDomain.Internal />) /> }
        return <Result.Ok value=() />
    }

    // Interface consumers can read signatures while recording initializers,
    // before the whole-declaration admission sweep.
    inout fn requireAdmittedRawRequirement(traitIndex: U64, slot: U64, offset: U64) -> Result[U64, CompileDiagnostic] {
        try self.checkAuthoredSignatureAdmissionOutcome()
        val trait = self.decls.traitAt(index: traitIndex)
        val token = match self.sourceTypeUses.requirementScopeFor(index: trait.reqs.start + slot) {
            Optional.Some(v: val token) => token,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected requirement has no authored signature", failureDomain: <FailureDomain.Internal />) /> },
        }
        if !self.authoredRequirementViews.contains(key: token) {
            try self.requireEarlySignatureConstruction(offset: offset)
            try self.admitRawRequirementSignature(token: token)
        }
        return <Result.Ok value=token />
    }

    inout fn admittedRequirementDeclaration(traitIndex: U64, slot: U64, offset: U64) -> Result[Func, CompileDiagnostic] {
        if traitIndex >= self.decls.traitCount() || slot >= self.decls.traitAt(index: traitIndex).reqs.count() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected requirement has no declaration slot", failureDomain: <FailureDomain.Internal />) />
        }
        val scope = try self.requireAdmittedRawRequirement(traitIndex: traitIndex, slot: slot, offset: offset)
        return <Result.Ok value=self.authoredRequirementViews[scope].declaration />
    }

    // The public interface interprets the selected declaration's recipe. Its
    // rigid Self and associated bindings are type substitutions, not static
    // conformance evidence for the erased receiver.
    inout fn readRequirementInterfaceSignature(scope: U64, bound: TraitBound, traitIndex: U64, proofRead: SignatureProofRead) -> Result[ExistentialRequirementSignature, CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[scope]
        val declaration = admitted.declaration
        val environment = self.requirementSignatureEnvironment(bound: bound, traitIndex: traitIndex)
        val interface = <RequirementSignatureRead scope=scope bound=bound proofRead=proofRead />
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        val terms = try self.readRequirementParameters(admitted: admitted, interface: interface, environment: environment, memo: inout memo)
        mut val passings: Array[CallArgumentPassing] = []
        for index in 0U64..<declaration.params.count() {
            val parameter = self.funcParamAt(params: declaration.params, index: index)
            if parameter.isInout { passings.append(<CallArgumentPassing.Inout />) }
            else if parameter.isMove { passings.append(<CallArgumentPassing.Move />) }
            else { passings.append(<CallArgumentPassing.Borrow />) }
        }
        mut val passing = <CallReceiverPassing.Borrow />
        if declaration.selfInout { passing = <CallReceiverPassing.Inout /> }
        else if declaration.selfMove { passing = <CallReceiverPassing.Move /> }
        val result = try self.readRequirementResult(interface: interface, environment: environment, memo: inout memo)
        return <Result.Ok value=<ExistentialRequirementSignature receiverPassing=passing parameterTypes=terms argumentPassings=passings resultType=self.callableResultSlot(ref: result) /> />
    }

    inout fn readRequirementParameters(admitted: AuthoredRequirementSignature, interface: RequirementSignatureRead, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[Array[U64], CompileDiagnostic] {
        val parameters = admitted.declaration.params
        mut val terms: Array[U64] = []
        for index in 0U64..<parameters.count() {
            terms.append(try self.readRequirementParameter(admitted: admitted, index: index, interface: interface, environment: environment, memo: inout memo))
        }
        return <Result.Ok value=terms />
    }

    inout fn requirementParameterTypes(signature: RequirementSignatureRead) -> Result[Array[U64], CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[signature.scope]
        if admitted.declaration.params.count() == 0U64 { return <Result.Ok value=[] /> }
        val environment = self.requirementSignatureEnvironment(bound: signature.bound, traitIndex: admitted.source.traitIndex)
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        return self.readRequirementParameters(admitted: admitted, interface: signature, environment: environment, memo: inout memo)
    }

    inout fn readRequirementParameter(admitted: AuthoredRequirementSignature, index: U64, interface: RequirementSignatureRead, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[U64, CompileDiagnostic] {
        val parameter = self.funcParamAt(params: admitted.declaration.params, index: index)
        val occurrence = try self.signatureOccurrence(id: parameter.authoredTypeUse)
        if admitted.proofs.count() == 0U64 && self.arena.typeIsClosed(ref: occurrence.term) {
            return <Result.Ok value=occurrence.term />
        }
        return <Result.Ok value=(try self.readAuthoredTypeRecipe(proofs: admitted.proofs, recipe: occurrence.recipe, environment: environment, memo: inout memo, context: <SignatureRecipeContext.Requirement signature=interface />)).term />
    }

    inout fn requirementParameterTypeAt(signature: RequirementSignatureRead, index: U64) -> Result[U64, CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[signature.scope]
        if index >= admitted.declaration.params.count() { return <Result.Ok value=0U64 /> }
        val environment = self.requirementSignatureEnvironment(bound: signature.bound, traitIndex: admitted.source.traitIndex)
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        return self.readRequirementParameter(admitted: admitted, index: index, interface: signature, environment: environment, memo: inout memo)
    }

    inout fn requirementSignatureEnvironment(bound: TraitBound, traitIndex: U64) -> InstanceEnvironment {
        val trait = self.decls.traitAt(index: traitIndex)
        mut val parameters = self.copyTraitBinds(binds: trait.typeParams)
        mut val values = bound.constraint.key.positionalArgs
        parameters.append(self.lexicalSelfBinder(parameter: trait.selfParamId))
        values.append(bound.subject)
        return <InstanceEnvironment params=parameters args=values receiverRef=bound.subject />
    }

    inout fn requireStaticSignatureProof(proof: StaticConformanceProof, offset: U64) -> Result[(), CompileDiagnostic] {
        if (try self.interfaceProofRoot(proof: proof)) != 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "universal interface evidence cannot authorize a static callable", failureDomain: <FailureDomain.Internal />) />
        }
        return <Result.Ok value=() />
    }

    inout fn staticRequirementSignatureContext(resolution: StaticMemberResolution) -> Result[Optional[RequirementSignatureRead], CompileDiagnostic] {
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIndex, reqIdx: val slot) => {
                if traitIndex >= self.decls.traitCount() || slot >= self.decls.traitAt(index: traitIndex).reqs.count() { return <Result.Ok value=<Optional.None /> /> }
                val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
                if bound.subject == 0U64 { return <Result.Ok value=<Optional.None /> /> }
                try self.requireStaticSignatureProof(proof: proof, offset: bound.offset)
                val scope = try self.requireAdmittedRawRequirement(traitIndex: traitIndex, slot: slot, offset: bound.offset)
                return <Result.Ok value=<Optional.Some v=<RequirementSignatureRead scope=scope bound=bound evidence=<RequirementSelfEvidence.Static proof=proof /> /> /> />
            }
            _ => { return <Result.Ok value=<Optional.None /> /> }
        }
    }

    inout fn readStaticRequirementResult(signature: RequirementSignatureRead) -> Result[U64, CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[signature.scope]
        val declaration = admitted.declaration
        if !declaration.hasRet {
            if declaration.isAsync { return <Result.Ok value=self.semanticCallableReturnTerm(function: declaration) /> }
            return <Result.Ok value=0U64 />
        }
        val environment = self.requirementSignatureEnvironment(bound: signature.bound, traitIndex: admitted.source.traitIndex)
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        return self.readRequirementResult(interface: signature, environment: environment, memo: inout memo)
    }

    inout fn readRequirementResult(interface: RequirementSignatureRead, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[U64, CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[interface.scope]
        val declaration = admitted.declaration
        val receiver = interface.bound.subject
        mut val result = self.semanticCallableReturnTerm(function: declaration)
        if admitted.source.result != 0U64 {
            val occurrence = try self.signatureOccurrence(id: admitted.source.result)
            if admitted.proofs.count() == 0U64 && self.arena.typeIsClosed(ref: occurrence.term) {
                return <Result.Ok value=occurrence.term />
            }
            result = (try self.readAuthoredTypeRecipe(proofs: admitted.proofs, recipe: occurrence.recipe, environment: environment, memo: inout memo, context: <SignatureRecipeContext.Requirement signature=interface />)).term
        } else if declaration.isFactory {
            if admitted.source.factoryError != 0U64 {
                val occurrence = try self.signatureOccurrence(id: admitted.source.factoryError)
                val error = (try self.readAuthoredTypeRecipe(proofs: admitted.proofs, recipe: occurrence.recipe, environment: environment, memo: inout memo, context: <SignatureRecipeContext.Requirement signature=interface />)).term
                // The wrapper was resolved with the declaration, just as the
                // explicit error annotation was. Only its two children change.
                result = self.rebuildTypeTermChildren(ref: result, children: [receiver, error])
            } else {
                result = self.groundTermInEnvironment(ref: result, params: environment.params, values: environment.args, selfRef: receiver)
            }
        }
        return <Result.Ok value=result />
    }

    // Replace only the provided declaration's own Self premise with the
    // selected receiver proof. Other admitted premises stay in lexical scope.
    inout fn readProvidedProjectionOutput(proof: StaticConformanceProof, function: U64, receiver: U64, selector: ResolvedViewSource, arguments: Array[U64], member: U64, environment: InstanceEnvironment, offset: U64, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[U64, CompileDiagnostic] {
        val premise = self.signatureProjectionPremise(proof: proof)
        if premise.source.isSome() {
            match premise.source.unwrap() {
                DeclarationBoundRef.MethodReceiver(index: val owner) => {
                    if owner != function { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "provided signature has a foreign receiver premise", failureDomain: <FailureDomain.Internal />) /> }
                    val declaration = self.arena.functionAt(index: owner)
                    val traitIndex = self.decls.traitIndexByOffset(offset: declaration.recvStart)
                    val root = try self.staticProofBound(proof: environment.proof, traitIdx: traitIndex)
                    return self.readSignatureSelfProjection(root: root, evidence: <RequirementSelfEvidence.Static proof=environment.proof />, steps: premise.steps, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
                }
                DeclarationBoundRef.AssociatedType(index: val index) => {
                    val associated = try self.signatureAssociatedEvidence(index: index, offset: offset)
                    val prerequisite = self.signatureProjectionPremise(proof: associated.prerequisite)
                    if prerequisite.source.isSome() && prerequisite.steps.count() == 0U64 {
                        match prerequisite.source.unwrap() {
                            DeclarationBoundRef.MethodReceiver(index: val owner) => {
                                if owner != function { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "provided signature has a foreign associated receiver premise", failureDomain: <FailureDomain.Internal />) /> }
                                val declaration = self.arena.functionAt(index: function)
                                val traitIndex = self.decls.traitIndexByOffset(offset: declaration.recvStart)
                                val bound = try self.staticProofBound(proof: environment.proof, traitIdx: traitIndex)
                                val root = try self.readSignatureAssociatedRootProof(index: index, associated: associated, bound: bound, evidence: <RequirementSelfEvidence.Static proof=environment.proof />, receiver: receiver, environment: environment, offset: offset, read: <SignatureProofRead.Admission />)
                                if root.isSome() {
                                    return self.readSignatureAssociatedProjection(root: root, steps: premise.steps, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
                                }
                            }
                            _ => {}
                        }
                    }
                }
                DeclarationBoundRef.Function(index: val assumption) => {
                    val admitted = try self.providedSignatureAdmission(function: function)
                    for clause in admitted.clauses {
                        if clause.assumption == assumption {
                            val prepared = try self.retainedSignatureClause(scope: clause.scope, id: clause.source, offset: offset)
                            val context = <SignatureRecipeContext.Provided owner=function />
                            val bound = try self.readSignatureProjectionClause(prepared: prepared, proofs: admitted.proofs, context: context, environment: environment, memo: inout memo, steps: premise.steps, member: member, offset: offset)
                            return self.readSelectedSignatureProjection(bound: bound, selected: <Optional.None />, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
                        }
                    }
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "provided signature has a foreign where premise", failureDomain: <FailureDomain.Internal />) />
                }
                _ => {}
            }
        }
        return self.readLexicalSignatureProjection(proof: proof, owner: selector.traitInstance.owner, member: member, environment: environment)
    }

    fn signatureProjectionPremise(proof: StaticConformanceProof) -> SignatureProjectionPremise {
        match proof {
            StaticConformanceProof.AssumedBound(source: val bound) => { return <SignatureProjectionPremise source=<Optional.Some v=bound /> /> }
            StaticConformanceProof.AssumedSupertraitPath(source: val bound, steps: val steps) => { return <SignatureProjectionPremise source=<Optional.Some v=bound /> steps=steps /> }
            _ => { return <SignatureProjectionPremise /> }
        }
    }

    inout fn readSignatureSelfProjection(root: TraitBound, evidence: RequirementSelfEvidence, steps: Array[SupertraitRef], receiver: U64, selector: ResolvedViewSource, arguments: Array[U64], member: U64, offset: U64) -> Result[U64, CompileDiagnostic] {
        val bound = self.supertraitBoundThroughSteps(root: root, steps: steps)
        val lexicalInstance = self.sameResolvedTypeRefs(a: bound.constraint.key.positionalArgs, b: arguments)
        match evidence {
            RequirementSelfEvidence.Conformance(index: val conformance) => {
                if steps.count() == 0U64 && lexicalInstance {
                    val proof = try self.conformanceDeclarationWitness(conformance: conformance, receiver: bound.subject)
                    val selected = <Optional.Some v=proof />
                    val checked = <TraitBound subject=bound.subject constraint=<TraitConstraint key=bound.constraint.key assocPredicates=[] /> offset=bound.offset />
                    return self.readSelectedSignatureProjection(bound: checked, selected: selected, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
                }
            }
            _ => {}
        }
        if lexicalInstance {
            val promised = try self.readSelectedSignatureProjection(bound: bound, selected: <Optional.None />, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
            if promised != 0U64 { return <Result.Ok value=promised /> }
        }
        val selected = try self.readSignatureSelfWitness(root: root, evidence: evidence, steps: steps, receiver: receiver, offset: offset)
        if !lexicalInstance && selected.isSome() {
            // A written argument recipe can read the concrete associated
            // output while the lexical constraint still contains the
            // projection. Compare against the retained parent instance.
            val actual = try self.staticProofBound(proof: selected.unwrap(), traitIdx: self.decls.traitIndexByOffset(offset: selector.traitInstance.owner))
            return self.readSelectedSignatureProjection(bound: actual, selected: selected, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
        }
        return self.readSelectedSignatureProjection(bound: bound, selected: selected, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
    }

    inout fn conformanceDeclarationWitness(conformance: U64, receiver: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        val declaration = self.decls.conformAt(index: conformance)
        mut val bindings: Array[WitnessBind] = []
        for index in 0U64..<declaration.typeParams.count() {
            val parameter = self.conformBindAt(binds: declaration.typeParams, index: index)
            val term = self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen paramId=parameter.paramId args=[] />)
            bindings.append(<WitnessBind binder=index paramId=parameter.paramId term=term />)
        }
        val substitution = <WitnessMatch conformIdx=conformance + 1U64 selfRef=receiver binds=bindings />
        mut val witness = substitution
        if declaration.bounds.len != 0U64 {
            mut val proofs: Array[U64] = []
            for assumption in self.conformanceBoundAssumptions(bounds: declaration.bounds) {
                proofs.append(self.freezeStaticConformanceProof(proof: <StaticConformanceProof.AssumedBound source=assumption />))
            }
            val plan = self.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=substitution proofs=proofs normalizations=[] />)
            witness = <WitnessMatch conformIdx=substitution.conformIdx selfRef=receiver binds=bindings conditions=plan />
        }
        if declaration.subjectTraitOwner != 0U64 {
            return <Result.Ok value=<StaticConformanceProof.AssumedTraitPath source=<DeclarationBoundRef.TraitSubject index=conformance /> steps=[] edges=[witness] /> />
        }
        return <Result.Ok value=<StaticConformanceProof.ConcreteWitness witness=witness /> />
    }

    inout fn readSignatureSelfWitness(root: TraitBound, evidence: RequirementSelfEvidence, steps: Array[SupertraitRef], receiver: U64, offset: U64) -> Result[Optional[StaticConformanceProof], CompileDiagnostic] {
        match evidence {
            RequirementSelfEvidence.Interface => { return <Result.Ok value=<Optional.None /> /> }
            RequirementSelfEvidence.Static(proof: val proof) => {
                if steps.count() == 0U64 { return <Result.Ok value=<Optional.Some v=proof /> /> }
                if self.selectedConstraintWitness(proof: proof).isNone() { return <Result.Ok value=<Optional.None /> /> }
                val prefix = try self.retainedConstraintPrefix(proof: proof, expected: root, normalizations: [])
                return self.readSignatureSupertraitWitness(proof: prefix, steps: steps, receiver: receiver, offset: offset)
            }
            RequirementSelfEvidence.Conformance(index: val conformance) => {
                if steps.count() == 0U64 { return <Result.Ok value=<Optional.None /> /> }
                val saved = try self.readConformanceSupertraitEvidence(conformance: conformance, step: steps[0U64])
                val proof = self.thawStaticConformanceProof(id: saved.proof)
                val bound = try self.replayBoundNormalizations(bound: saved.bound, normalizations: saved.normalizations)
                try self.checkRetainedWitnessClause(expected: bound, proof: proof, normalizations: saved.normalizations, offset: offset, assumptions: self.conformanceDeclarationAssumptions(conformIndex: conformance))
                mut val remaining: Array[SupertraitRef] = []
                for index in 1U64..<steps.count() { remaining.append(steps[index]) }
                return self.readSignatureSupertraitWitness(proof: proof, steps: remaining, receiver: receiver, offset: offset)
            }
        }
    }

    inout fn readSignatureSupertraitWitness(proof: StaticConformanceProof, steps: Array[SupertraitRef], receiver: U64, offset: U64) -> Result[Optional[StaticConformanceProof], CompileDiagnostic] {
        if self.proofIsMissing(proof: proof) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature projection lost its supertrait witness", failureDomain: <FailureDomain.Internal />) />
        }
        if steps.count() == 0U64 { return <Result.Ok value=<Optional.Some v=proof /> /> }
        match proof {
            StaticConformanceProof.AssumedBound(source: val source) => {
                return <Result.Ok value=<Optional.Some v=<StaticConformanceProof.AssumedSupertraitPath source=source steps=steps /> /> />
            }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val prefix) => {
                mut val path = prefix
                for step in steps { path.append(step) }
                return <Result.Ok value=<Optional.Some v=<StaticConformanceProof.AssumedSupertraitPath source=source steps=path /> /> />
            }
            _ => {}
        }
        if self.retainedConstraintPathTerminal(proof: proof).isNone() { return <Result.Ok value=<Optional.None /> /> }
        match (try self.replaySelectedSupertraits(proof: proof, steps: steps, receiver: receiver, declaration: !self.arena.typeIsClosed(ref: receiver))) {
            ConstraintProofReplay.Concrete(proof: val selected) | ConstraintProofReplay.Universal(proof: val selected) => { return <Result.Ok value=<Optional.Some v=selected /> /> }
            ConstraintProofReplay.Deferred => { return <Result.Ok value=<Optional.None /> /> }
            ConstraintProofReplay.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature projection lost its supertrait witness", failureDomain: <FailureDomain.Internal />) /> }
        }
    }

    inout fn readSelectedSignatureProjection(bound: TraitBound, selected: Optional[StaticConformanceProof], receiver: U64, selector: ResolvedViewSource, arguments: Array[U64], member: U64, offset: U64) -> Result[U64, CompileDiagnostic] {
        if bound.subject == 0U64 || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: bound.subject), b: self.typeRefWithoutOuterViews(ref: receiver)) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature projection changed its selected receiver", failureDomain: <FailureDomain.Internal />) />
        }
        if bound.constraint.key.owner != selector.traitInstance.owner || !self.sameResolvedTypeRefs(a: bound.constraint.key.positionalArgs, b: arguments) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature projection changed its selected trait instance", failureDomain: <FailureDomain.Internal />) />
        }
        for predicate in bound.constraint.assocPredicates {
            if predicate.member == member { return <Result.Ok value=predicate.value /> }
        }
        match selected {
            Optional.Some(v: val proof) => { return self.associatedOutputInProof(proof: proof, traitOwner: selector.traitInstance.owner, assocId: member) }
            Optional.None => { return <Result.Ok value=0U64 /> }
        }
    }

    inout fn readLexicalSignatureProjection(proof: StaticConformanceProof, owner: U64, member: U64, environment: InstanceEnvironment) -> Result[U64, CompileDiagnostic] {
        val output = try self.associatedOutputInProof(proof: proof, traitOwner: owner, assocId: member)
        if output == 0U64 { return <Result.Ok value=0U64 /> }
        return <Result.Ok value=self.groundTermInEnvironment(ref: output, params: environment.params, values: environment.args, selfRef: environment.receiverRef) />
    }

    inout fn readRequirementProjectionOutput(proof: StaticConformanceProof, interface: RequirementSignatureRead, receiver: U64, selector: ResolvedViewSource, arguments: Array[U64], member: U64, environment: InstanceEnvironment, offset: U64, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[U64, CompileDiagnostic] {
        val premise = self.signatureProjectionPremise(proof: proof)
        mut val raw: Optional[U64] = <Optional.None />
        if premise.source.isSome() {
            match premise.source.unwrap() {
                DeclarationBoundRef.RawRequirement(index: val index) => { raw = <Optional.Some v=index /> }
                _ => {}
            }
        }
        if raw.isSome() {
            val index = raw.unwrap()
            val first = self.rawRequirementRanges[interface.scope].first - 1U64
            if index >= self.rawRequirementPremises.count() || self.rawRequirementPremises[index].scope != interface.scope {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature projection belongs to another trait requirement", failureDomain: <FailureDomain.Internal />) />
            }
            if index == first {
                return self.readSignatureSelfProjection(root: interface.bound, evidence: interface.evidence, steps: premise.steps, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
            }
            val clause = self.rawRequirementPremises[index]
            val prepared = try self.retainedSignatureClause(scope: interface.scope, id: clause.sourceClause, offset: offset)
            val admitted = self.authoredRequirementViews[interface.scope]
            val context = <SignatureRecipeContext.Requirement signature=interface />
            val bound = try self.readSignatureProjectionClause(prepared: prepared, proofs: admitted.proofs, context: context, environment: environment, memo: inout memo, steps: premise.steps, member: member, offset: offset)
            return self.readSelectedSignatureProjection(bound: bound, selected: <Optional.None />, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
        }
        if premise.source.isSome() {
            match premise.source.unwrap() {
                DeclarationBoundRef.AssociatedType(index: val index) => {
                    val associated = try self.signatureAssociatedEvidence(index: index, offset: offset)
                    val clause = try self.readRequirementWitnessAssociatedClause(index: index, associated: associated, signature: interface, environment: environment, offset: offset)
                    if clause.isSome() {
                        val selected = clause.unwrap()
                        if !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: selected.receiver), b: self.typeRefWithoutOuterViews(ref: receiver)) {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature changed its selected associated subject", failureDomain: <FailureDomain.Internal />) />
                        }
                        return self.readSignatureAssociatedProjection(root: <Optional.Some v=selected.proof />, steps: premise.steps, receiver: receiver, selector: selector, arguments: arguments, member: member, offset: offset)
                    }
                }
                _ => {}
            }
        }
        if self.retainedConstraintPathTerminal(proof: proof).isSome() {
            val requirement = <AssociatedBindingRequirementRead signature=interface environment=environment />
            val output = try self.readSelectedProjectionOutput(proof: proof, traitOwner: selector.traitInstance.owner, assocId: member, requirement: <Optional.Some v=requirement />)
            return <Result.Ok value=output.term />
        }
        return self.readLexicalSignatureProjection(proof: proof, owner: selector.traitInstance.owner, member: member, environment: environment)
    }

    inout fn signatureAssociatedEvidence(index: U64, offset: U64) -> Result[AssociatedBoundEvidence, CompileDiagnostic] {
        if index >= self.arena.associatedBoundEvidenceCount() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature has no retained associated clause", failureDomain: <FailureDomain.Internal />) />
        }
        return <Result.Ok value=self.arena.associatedBoundEvidenceAt(index: index) />
    }

    // Interpret the one premise selected by this RHS occurrence in the
    // requirement's environment. The clause and path come from that proof.
    inout fn readBindingRequirementProof(proof: StaticConformanceProof, requirement: Optional[AssociatedBindingRequirementRead], offset: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        if requirement.isNone() { return <Result.Ok value=proof /> }
        val context = requirement.unwrap()
        val premise = self.signatureProjectionPremise(proof: proof)
        if premise.source.isSome() {
            match premise.source.unwrap() {
                DeclarationBoundRef.AssociatedType(index: val index) => {
                    val associated = try self.signatureAssociatedEvidence(index: index, offset: offset)
                    val root = try self.readRequirementWitnessAssociatedClause(index: index, associated: associated, signature: context.signature, environment: context.environment, offset: offset)
                    if root.isSome() {
                        val selected = root.unwrap()
                        val witness = try self.readSignatureSupertraitWitness(proof: selected.proof, steps: premise.steps, receiver: selected.receiver, offset: offset)
                        if witness.isSome() { return <Result.Ok value=witness.unwrap() /> }
                    }
                }
                _ => {}
            }
        }
        return <Result.Ok value=proof />
    }

    inout fn readRequirementWitnessAssociatedClause(index: U64, associated: AssociatedBoundEvidence, signature: RequirementSignatureRead, environment: InstanceEnvironment, offset: U64) -> Result[Optional[SelectedSignatureAssociatedClause], CompileDiagnostic] {
        val premise = self.signatureProjectionPremise(proof: associated.prerequisite)
        match premise.source {
            Optional.Some(v: val source) => {
                match source {
                    DeclarationBoundRef.RawRequirement(index: val root) => {
                        if root + 1U64 != self.rawRequirementRanges[signature.scope].first { return <Result.Ok value=<Optional.None /> /> }
                    }
                    _ => { return <Result.Ok value=<Optional.None /> /> }
                }
            }
            Optional.None => { return <Result.Ok value=<Optional.None /> /> }
        }
        val projectionRef = self.groundTermInEnvironment(ref: associated.projection, params: environment.params, values: environment.args, selfRef: environment.receiverRef)
        val projection = self.arena.typeAt(index: projectionRef)
        val owner = self.associatedProjectionTraitOwner(projection: projection)
        val selector = <ResolvedViewSource writtenStart=offset traitInstance=<TraitInstanceKey owner=owner positionalArgs=projection.assocTraitArgs /> />
        val selfReceiver = self.typeTermProjectionReceiver(t: projection)
        val output = try self.readSignatureSelfProjection(root: signature.bound, evidence: signature.evidence, steps: premise.steps, receiver: selfReceiver, selector: selector, arguments: projection.assocTraitArgs, member: projection.assocNameId, offset: offset)
        if output == 0U64 { return <Result.Ok value=<Optional.None /> /> }
        if premise.steps.count() == 0U64 {
            val selected = try self.readSignatureAssociatedRootProof(index: index, associated: associated, bound: signature.bound, evidence: signature.evidence, receiver: output, environment: environment, offset: offset, read: signature.proofRead)
            if selected.isNone() { return <Result.Ok value=<Optional.None /> /> }
            return <Result.Ok value=<Optional.Some v=<SelectedSignatureAssociatedClause receiver=output proof=selected.unwrap() /> /> />
        }
        val parent = try self.readSignatureSelfWitness(root: signature.bound, evidence: signature.evidence, steps: premise.steps, receiver: selfReceiver, offset: offset)
        if parent.isNone() { return <Result.Ok value=<Optional.None /> /> }
        val declaration = !self.arena.typeIsClosed(ref: selfReceiver) || !self.arena.typeIsClosed(ref: output)
        match (try self.replaySelectedAssociatedConstraint(index: index, selected: parent.unwrap(), projectionRef: projectionRef, receiverRef: output, context: <Optional.None />, inherited: [], declaration: declaration)) {
            ConstraintProofReplay.Concrete(proof: val proof) | ConstraintProofReplay.Universal(proof: val proof) => { return <Result.Ok value=<Optional.Some v=<SelectedSignatureAssociatedClause receiver=output proof=proof /> /> /> }
            ConstraintProofReplay.Deferred => { return <Result.Ok value=<Optional.None /> /> }
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature lost its selected associated condition", failureDomain: <FailureDomain.Internal />) /> }
        }
    }

    inout fn readSignatureAssociatedProjection(root: Optional[StaticConformanceProof], steps: Array[SupertraitRef], receiver: U64, selector: ResolvedViewSource, arguments: Array[U64], member: U64, offset: U64, unresolvedProjection: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        if root.isNone() { return <Result.Ok value=0U64 /> }
        val selected = try self.readSignatureSupertraitWitness(proof: root.unwrap(), steps: steps, receiver: receiver, offset: offset)
        if selected.isNone() { return <Result.Ok value=0U64 /> }
        val proof = selected.unwrap()
        val expected = <TraitBound subject=receiver constraint=<TraitConstraint key=<TraitInstanceKey owner=selector.traitInstance.owner positionalArgs=arguments /> assocPredicates=[] /> offset=offset />
        try self.checkRetainedWitnessClause(expected: expected, proof: proof, normalizations: (try self.retainedProofProjectionContext(proof: proof)), offset: offset)
        val output = try self.associatedOutputInProof(proof: proof, traitOwner: selector.traitInstance.owner, assocId: member)
        // A validated abstract clause can establish the projection without an
        // equality. Keep the member on the subject from the selected clause.
        if output == 0U64 && unresolvedProjection != 0U64 {
            return <Result.Ok value=self.rebuildProjectionTerm(t: self.arena.typeAt(index: unresolvedProjection), receiver: receiver, traitArgs: arguments) />
        }
        return <Result.Ok value=output />
    }

    inout fn readSignatureAssociatedRootProof(index: U64, associated: AssociatedBoundEvidence, bound: TraitBound, evidence: RequirementSelfEvidence, receiver: U64, environment: InstanceEnvironment, offset: U64, read: SignatureProofRead) -> Result[Optional[StaticConformanceProof], CompileDiagnostic] {
        match evidence {
            RequirementSelfEvidence.Conformance(index: val conformance) => {
                val saved = try self.readConformanceAssociatedClause(conformance: conformance, clause: associated.clause)
                val assumptions = self.conformanceDeclarationAssumptions(conformIndex: conformance)
                try self.checkProjectionNormalizations(normalizations: saved.normalizations, offset: offset, assumptions: assumptions)
                val expected = try self.replayBoundNormalizations(bound: saved.bound, normalizations: saved.normalizations)
                if !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: expected.subject), b: self.typeRefWithoutOuterViews(ref: receiver)) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "conformance signature has a different associated clause subject", failureDomain: <FailureDomain.Internal />) />
                }
                val proof = self.thawStaticConformanceProof(id: saved.proof)
                try self.checkRetainedWitnessClause(expected: expected, proof: proof, normalizations: saved.normalizations, offset: offset, assumptions: assumptions)
                return <Result.Ok value=<Optional.Some v=proof /> />
            }
            RequirementSelfEvidence.Static(proof: val proof) => {
                if self.selectedConstraintWitness(proof: proof).isSome() {
                    val selected = try self.retainedConstraintPrefix(proof: proof, expected: bound, normalizations: [])
                    val projection = self.groundTermInEnvironment(ref: associated.projection, params: environment.params, values: environment.args, selfRef: environment.receiverRef)
                    match (try self.replaySelectedAssociatedConstraint(index: index, selected: selected, projectionRef: projection, receiverRef: receiver, context: <Optional.None />, inherited: [])) {
                        ConstraintProofReplay.Concrete(proof: val concrete) => { return <Result.Ok value=<Optional.Some v=concrete /> /> }
                        ConstraintProofReplay.Deferred => { return <Result.Ok value=<Optional.None /> /> }
                        _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "static requirement lost its associated clause evidence", failureDomain: <FailureDomain.Internal />) /> }
                    }
                }
            }
            RequirementSelfEvidence.Interface => {}
        }
        if !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<Optional.None /> /> }
        // A caller-fixed associated value is independently known even when
        // the requirement's Self witness is abstract or erased.
        val clause = self.decls.traitAssociatedBoundPool[associated.clause]
        for predicate in bound.constraint.assocPredicates {
            if predicate.member == clause.member && self.typeRefEq(a: predicate.value, b: receiver) {
                val traitIndex = self.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
                val constraint = self.traitConstraintInBound(constraint: clause.constraint, bound: bound, traitIndex: traitIndex)
                return self.readFixedRequirementAssociatedProof(index: index, bound: <TraitBound subject=receiver constraint=constraint offset=offset />, read: read)
            }
        }
        return <Result.Ok value=<Optional.None /> />
    }

    inout fn readFixedRequirementAssociatedProof(index: U64, bound: TraitBound, read: SignatureProofRead) -> Result[Optional[StaticConformanceProof], CompileDiagnostic] {
        for argument in bound.constraint.key.positionalArgs { if !self.arena.typeIsClosed(ref: argument) { return <Result.Ok value=<Optional.None /> /> } }
        for predicate in bound.constraint.assocPredicates { if !self.arena.typeIsClosed(ref: predicate.value) { return <Result.Ok value=<Optional.None /> /> } }
        mut val receipts = self.fixedRequirementAssociatedProofs.getOr(key: index, fallback: [])
        for receipt in receipts {
            if self.typeRefEq(a: receipt.bound.subject, b: bound.subject) && self.sameTraitConstraint(a: receipt.bound.constraint, b: bound.constraint) {
                val proof = self.thawStaticConformanceProof(id: receipt.proof)
                if self.proofIsMissing(proof: proof) { return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "fixed requirement lost its admitted associated proof", failureDomain: <FailureDomain.Internal />) /> }
                try self.checkProjectionNormalizations(normalizations: receipt.normalizations, offset: bound.offset)
                try self.checkStaticProofEvidence(proof: proof, offset: bound.offset)
                // Fixed associated outputs are admitted with no lexical or
                // interface premise. Reuse the interface scope with no root.
                val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.InterfaceContract /> owner=0U64 parameters=<FuncBindRange start=0U64 len=0U64 /> />
                try self.scopedProofDependencies(proof: proof, scope: scope, offset: bound.offset, normalizations: receipt.normalizations)
                try self.scopedProjectionDependencies(equations: receipt.normalizations, context: receipt.normalizations, scope: scope, offset: bound.offset)
                val expected = try self.replayBoundNormalizations(bound: bound, normalizations: receipt.normalizations)
                if !(try self.retainedWitnessClauseMatches(expected: expected, proof: proof, normalizations: receipt.normalizations, offset: bound.offset)) {
                    return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "fixed requirement proof does not match its admitted associated clause", failureDomain: <FailureDomain.Internal />) />
                }
                return <Result.Ok value=<Optional.Some v=proof /> />
            }
        }
        match read {
            SignatureProofRead.Retained => { return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "fixed requirement lost its admitted associated proof", failureDomain: <FailureDomain.Internal />) /> }
            SignatureProofRead.Admission => {}
        }
        val proof = try self.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: bound.subject, constraint: bound.constraint)
        if self.proofIsMissing(proof: proof) { return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "fixed associated type does not satisfy its declared trait constraint", failureDomain: <FailureDomain.Source />) /> }
        val normalizations = try self.recordSelectedBoundNormalizations(bound: bound, proof: proof, assumptions: [])
        receipts.append(<FixedRequirementAssociatedProof bound=bound proof=self.freezeStaticConformanceProof(proof: proof) normalizations=normalizations />)
        self.fixedRequirementAssociatedProofs[index] = receipts
        return <Result.Ok value=<Optional.Some v=proof /> />
    }

    inout fn readRequirementBounds(signature: RequirementSignatureRead, methodArguments: Array[U64]) -> Result[Array[TraitBound], CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[signature.scope]
        val count = admitted.declaration.signatureBounds.len
        if count == 0U64 { return <Result.Ok value=[] /> }
        val original = self.requirementSignatureEnvironment(bound: signature.bound, traitIndex: admitted.source.traitIndex)
        mut val parameters = original.params
        mut val values = original.args
        if methodArguments.count() != 0U64 {
            if methodArguments.count() != admitted.declaration.typeParams.count() {
                return <Result.Err error=self.diagnosticAt(offset: admitted.declaration.defOffset, msg: "requirement clause has an incomplete method substitution", failureDomain: <FailureDomain.Internal />) />
            }
            for parameter in self.copyFuncBinds(binds: admitted.declaration.typeParams) { parameters.append(parameter) }
            for argument in methodArguments { values.append(argument) }
        }
        val environment = <InstanceEnvironment params=parameters args=values receiverRef=original.receiverRef />
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        return self.readRequirementBoundsInEnvironment(signature: signature, environment: environment, memo: inout memo)
    }

    inout fn readRequirementBoundsInEnvironment(signature: RequirementSignatureRead, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[Array[TraitBound], CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[signature.scope]
        val count = admitted.declaration.signatureBounds.len
        if count == 0U64 { return <Result.Ok value=[] /> }
        val range = self.rawRequirementRanges[signature.scope]
        mut val bounds: Array[TraitBound] = []
        for position in 0U64..<count {
            val premise = self.rawRequirementPremises[range.first + position]
            val bound = premise.bound
            val prepared = try self.retainedSignatureClause(scope: signature.scope, id: premise.sourceClause, offset: bound.offset)
            bounds.append(try self.readAuthoredSignatureClause(prepared: prepared, proofs: admitted.proofs, context: <SignatureRecipeContext.Requirement signature=signature />, environment: environment, memo: inout memo))
        }
        return <Result.Ok value=bounds />
    }

    // Bind registered assumption IDs to the exact lexical clause once,
    // while the signature is admitted. The ranges were published own-first.
    inout fn admitProvidedClauseIdentities(signature: AuthoredFunctionSignature, own: SourceBoundRange, parent: U64, offset: U64) -> Result[Array[AuthoredProvidedClause], CompileDiagnostic] {
        val inherited = self.sourceTypeUses.scopeAt(token: parent).unwrap().bounds.unwrapOr(fallback: <SourceBoundRange />)
        val assumptions = self.decls.funcBounds.indices(owner: signature.function)
        if assumptions.count() != own.count + inherited.count {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "provided signature changed its where clause count", failureDomain: <FailureDomain.Internal />) />
        }
        mut val clauses: Array[AuthoredProvidedClause] = []
        for position in 0U64..<assumptions.count() {
            val assumption = assumptions[position]
            val id = if position < own.count { give own.first + position } else { give inherited.first + (position - own.count) }
            val scope = if position < own.count { give signature.scope } else { give parent }
            val row = self.decls.funcBounds.at(index: assumption)
            val prepared = try self.retainedSignatureClause(scope: scope, id: id, offset: offset)
            if row.fnIdx != signature.function || row.sourceClause != id || !self.typeRefEq(a: row.paramTy, b: prepared.subject) || !self.sameTraitConstraint(a: row.constraint, b: prepared.constraint) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "provided where clause differs from its source declaration", failureDomain: <FailureDomain.Internal />) />
            }
            clauses.append(<AuthoredProvidedClause assumption=assumption scope=scope source=id />)
        }
        return <Result.Ok value=clauses />
    }

    // Materialization can copy a conformance implementation as well as a
    // provided declaration. Only the latter owns this source-clause contract.
    fn isAuthoredProvidedDeclaration(function: U64) -> Bool {
        val declaration = self.arena.functionAt(index: self.arena.functionLexicalOwner(index: function))
        return declaration.provTraitOwner != 0U64 && declaration.originTraitOwner == 0U64
    }

    inout fn providedSignatureAdmission(function: U64) -> Result[AuthoredSignatureViews, CompileDiagnostic] {
        try self.checkAuthoredSignatureAdmissionOutcome()
        val owner = try self.semanticBodyOwner(fnIdx: function)
        match self.authoredSignatureViews.get(key: owner) {
            Optional.Some(v: val admitted) => { return <Result.Ok value=admitted /> }
            Optional.None => {}
        }
        val source = match self.sourceTypeUses.signatureFor(function: owner) {
            Optional.Some(v: val source) => source,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: function).defOffset, msg: "provided where clause has no authored signature", failureDomain: <FailureDomain.Internal />) /> },
        }
        try self.requireEarlySignatureConstruction(offset: self.arena.functionAt(index: function).defOffset)
        try self.admitAuthoredFunctionViewSignature(signature: source)
        return <Result.Ok value=self.authoredSignatureViews[owner] />
    }

    inout fn readProvidedSignatureBounds(admitted: AuthoredSignatureViews, environment: InstanceEnvironment, concrete: Bool = false) -> Result[Array[TraitBound], CompileDiagnostic] {
        if admitted.clauses.count() == 0U64 { return <Result.Ok value=[] /> }
        val source = admitted.signature
        try self.checkSignatureEnvironment(signature: source, environment: environment)
        val offset = self.arena.functionAt(index: source.function).defOffset
        val context = if concrete { give <SignatureRecipeContext.Concrete /> } else { give <SignatureRecipeContext.Provided owner=source.function /> }
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        mut val bounds: Array[TraitBound] = []
        for clause in admitted.clauses {
            val prepared = try self.retainedSignatureClause(scope: clause.scope, id: clause.source, offset: offset)
            bounds.append(try self.readAuthoredSignatureClause(prepared: prepared, proofs: admitted.proofs, context: context, environment: environment, memo: inout memo))
        }
        return <Result.Ok value=bounds />
    }

    inout fn readSignatureProjectionClause(prepared: PreparedProjectionBound, proofs: Array[AuthoredTypeViewProof], context: SignatureRecipeContext, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead], steps: Array[SupertraitRef], member: U64, offset: U64) -> Result[TraitBound, CompileDiagnostic] {
        if steps.count() == 0U64 {
            return self.readAuthoredSignatureClause(prepared: prepared, proofs: proofs, context: context, environment: environment, memo: inout memo, onlyMember: member)
        }
        val traitIndex = steps[0U64].traitIndex
        if traitIndex >= self.decls.traitCount() || self.decls.traitAt(index: traitIndex).nameStart != prepared.constraint.key.owner {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature premise lost its selected supertrait path", failureDomain: <FailureDomain.Internal />) />
        }
        val declaration = self.decls.traitAt(index: traitIndex)
        if declaration.typeParams.count() != prepared.arguments.count() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature premise has incomplete trait arguments", failureDomain: <FailureDomain.Internal />) />
        }
        // Interpret the selected edges in the root trait's own vocabulary.
        // Its binders and unconstrained associated projections identify exactly
        // which source expressions the terminal signature uses.
        mut val parameters: Array[U64] = []
        for parameter in self.copyTraitBinds(binds: declaration.typeParams) {
            parameters.append(self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen nameId=parameter.nameId paramId=parameter.paramId args=[] />))
        }
        val symbolic = <TraitBound subject=self.lexicalSelfTerm(parameter: declaration.selfParamId) constraint=<TraitConstraint key=<TraitInstanceKey owner=declaration.nameStart positionalArgs=parameters /> assocPredicates=[] /> offset=offset />
        val terminal = self.supertraitBoundThroughSteps(root: symbolic, steps: steps)
        if terminal.subject == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature premise lost its selected supertrait path", failureDomain: <FailureDomain.Internal />) />
        }
        val subject = try self.readAuthoredClauseType(recipe: prepared.subjectRecipe, ref: prepared.subject, proofs: proofs, context: context, environment: environment, memo: inout memo)
        val read = <InheritedSignatureRead symbolic=symbolic subject=subject prepared=prepared proofs=proofs context=context environment=environment />
        mut val arguments: Array[U64] = []
        for argument in terminal.constraint.key.positionalArgs {
            arguments.append(try self.readInheritedSignatureTerm(ref: argument, read: read, memo: inout memo))
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        for predicate in terminal.constraint.assocPredicates {
            if predicate.member == member {
                val value = try self.readInheritedSignatureTerm(ref: predicate.value, read: read, memo: inout memo)
                predicates.append(<TraitAssocPredicate member=predicate.member value=value span=predicate.span />)
            }
        }
        return <Result.Ok value=<TraitBound subject=subject constraint=<TraitConstraint key=<TraitInstanceKey owner=terminal.constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=terminal.constraint.positionalArgsOpen assocPredicates=predicates /> offset=terminal.offset /> />
    }

    inout fn readInheritedSignatureTerm(ref: U64, read: InheritedSignatureRead, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[U64, CompileDiagnostic] {
        if self.arena.typeIsClosed(ref: ref) { return <Result.Ok value=ref /> }
        val term = self.arena.typeAt(index: ref)
        val key = read.symbolic.constraint.key
        val prepared = read.prepared
        mut val replacement = 0U64
        if term.assocNameId != 0U64 {
            if self.associatedProjectionTraitOwner(projection: term) == key.owner && self.typeRefEq(a: self.typeTermProjectionReceiver(t: term), b: read.symbolic.subject) && self.sameResolvedTypeRefs(a: term.assocTraitArgs, b: key.positionalArgs) {
                for index in 0U64..<prepared.predicateRecipes.count() {
                    val predicate = prepared.constraint.assocPredicates[index]
                    if predicate.member == term.assocNameId {
                        return self.readAuthoredClauseType(recipe: prepared.predicateRecipes[index], ref: predicate.value, proofs: read.proofs, context: read.context, environment: read.environment, memo: inout memo)
                    }
                }
            }
        } else if term.paramId != 0U64 {
            if term.paramId == self.arena.typeTermAt(index: read.symbolic.subject).paramId {
                replacement = read.subject
            } else {
                for index in 0U64..<key.positionalArgs.count() {
                    if term.paramId == self.arena.typeTermAt(index: key.positionalArgs[index]).paramId {
                        replacement = try self.readAuthoredClauseType(recipe: prepared.arguments[index], ref: prepared.constraint.key.positionalArgs[index], proofs: read.proofs, context: read.context, environment: read.environment, memo: inout memo)
                        break
                    }
                }
            }
        }
        mut val children: Array[U64] = []
        for index in 0U64..<self.typeTermRefChildCount(ref: ref) {
            children.append(try self.readInheritedSignatureTerm(ref: self.typeTermRefChildRef(ref: ref, index: index), read: read, memo: inout memo))
        }
        val rebuilt = self.rebuildTypeTermChildren(ref: ref, children: children)
        if replacement == 0U64 { return <Result.Ok value=rebuilt /> }
        return <Result.Ok value=self.typeRefWithAddedViewSources(ref: replacement, additions: self.arena.typeViewSources(ref: rebuilt)) />
    }

    inout fn readAuthoredSignatureClause(prepared: PreparedProjectionBound, proofs: Array[AuthoredTypeViewProof], context: SignatureRecipeContext, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead], onlyMember: U64 = 0U64) -> Result[TraitBound, CompileDiagnostic] {
        val constraint = prepared.constraint
        val subject = try self.readAuthoredClauseType(recipe: prepared.subjectRecipe, ref: prepared.subject, proofs: proofs, context: context, environment: environment, memo: inout memo)
        mut val arguments: Array[U64] = []
        for index in 0U64..<prepared.arguments.count() {
            arguments.append(try self.readAuthoredClauseType(recipe: prepared.arguments[index], ref: constraint.key.positionalArgs[index], proofs: proofs, context: context, environment: environment, memo: inout memo))
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        for index in 0U64..<prepared.predicateRecipes.count() {
            val predicate = constraint.assocPredicates[index]
            if onlyMember != 0U64 && predicate.member != onlyMember { continue }
            val value = try self.readAuthoredClauseType(recipe: prepared.predicateRecipes[index], ref: predicate.value, proofs: proofs, context: context, environment: environment, memo: inout memo)
            predicates.append(<TraitAssocPredicate member=predicate.member value=value span=predicate.span />)
        }
        return <Result.Ok value=<TraitBound subject=subject constraint=<TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates /> offset=prepared.parameter.nameStart /> />
    }

    inout fn readAuthoredClauseType(recipe: U64, ref: U64, proofs: Array[AuthoredTypeViewProof], context: SignatureRecipeContext, environment: InstanceEnvironment, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[U64, CompileDiagnostic] {
        if recipe == 0U64 {
            // Only the value adapter's name-only bound subject is synthetic.
            return <Result.Ok value=self.groundTermInEnvironment(ref: ref, params: environment.params, values: environment.args, selfRef: environment.receiverRef) />
        }
        if proofs.count() == 0U64 && self.arena.typeIsClosed(ref: ref) { return <Result.Ok value=ref /> }
        return <Result.Ok value=(try self.readAuthoredTypeRecipe(proofs: proofs, recipe: recipe, environment: environment, memo: inout memo, context: context)).term />
    }

    inout fn retainedSignatureClause(scope: U64, id: U64, offset: U64) -> Result[PreparedProjectionBound, CompileDiagnostic] {
        if id == 0U64 || id > self.projectionBoundClauses.count() || self.projectionBoundClauses[id - 1U64].scope != scope {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature clause has no original source identity", failureDomain: <FailureDomain.Internal />) />
        }
        match self.projectionBoundClauses[id - 1U64].state {
            ProjectionBoundState.Ready(bound: val bound) => { return <Result.Ok value=bound /> }
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature clause has no prepared source types", failureDomain: <FailureDomain.Internal />) /> }
        }
    }

    inout fn admitRawRequirementSignature(token: U64) -> Result[(), CompileDiagnostic] {
        val source = self.sourceTypeUses.scopeAt(token: token).unwrap()
        val owner = source.requirement.unwrap()
        val declaration = self.decls.traitAt(index: owner.traitIndex)
        val requirement = self.traitReqAt(reqs: declaration.reqs, index: owner.slot)
        val selfRef = self.lexicalSelfTerm(parameter: declaration.selfParamId)
        val traitParameters = self.copyTraitBinds(binds: declaration.typeParams)
        mut val arguments: Array[U64] = []
        for parameter in traitParameters {
            arguments.append(self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen nameId=parameter.nameId paramId=parameter.paramId args=[] />))
        }
        val parameters = if traitParameters.count() == 0U64 { give requirement.typeParams } else {
            mut val combined = traitParameters
            for parameter in self.copyFuncBinds(binds: requirement.typeParams) { combined.append(parameter) }
            give self.pushFuncBinds(binds: combined)
        }
        val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.RequirementSignature /> owner=token parameters=parameters selfParameter=declaration.selfParamId />
        try self.checkAuthoredCallableSlots(function: requirement, token: token, result: owner.result, factoryError: owner.factoryError, scope: scope, scopedBinders: true)
        if !self.rawRequirementRanges.contains(key: token) {
            val first = self.rawRequirementPremises.count() + 1U64
            val root = <TraitBound subject=selfRef constraint=<TraitConstraint key=<TraitInstanceKey owner=declaration.nameStart positionalArgs=arguments /> assocPredicates=[] /> offset=source.anchor />
            val sources = source.bounds.unwrapOr(fallback: <SourceBoundRange />)
            if sources.count != requirement.signatureBounds.len {
                return <Result.Err error=self.diagnosticAt(offset: source.anchor, msg: "requirement lost its prepared source clauses", failureDomain: <FailureDomain.Internal />) />
            }
            mut val premises = [<RawRequirementPremise scope=token bound=root />]
            for index in 0U64..<requirement.signatureBounds.len {
                val clause = self.conformBoundAt(bounds: requirement.signatureBounds, index: index)
                val id = sources.first + index
                val prepared = try self.retainedSignatureClause(scope: token, id: id, offset: clause.offset)
                if !self.typeRefEq(a: prepared.subject, b: clause.subject) || !self.sameTraitConstraint(a: prepared.constraint, b: clause.constraint) || prepared.arguments.count() != clause.constraint.key.positionalArgs.count() || prepared.predicateRecipes.count() != clause.constraint.assocPredicates.count() {
                    return <Result.Err error=self.diagnosticAt(offset: clause.offset, msg: "requirement clause differs from its prepared source types", failureDomain: <FailureDomain.Internal />) />
                }
                premises.append(<RawRequirementPremise scope=token bound=<TraitBound subject=prepared.subject constraint=prepared.constraint offset=clause.offset /> sourceClause=id />)
            }
            for premise in premises { self.rawRequirementPremises.append(premise) }
            self.rawRequirementRanges[token] = <SourceBoundRange first=first count=1U64 + requirement.signatureBounds.len />
        }
        val assumptions = try self.declarationScopeAssumptions(scope: scope)
        val scopes = <SignatureProofScopes local=scope assumptions=assumptions inherited=[] receiver=0U64 scopedBinders=true lexicalTrait=declaration.nameStart lexicalTraitArguments=arguments />
        mut val validation = <SignatureRecipeValidation />
        for id in self.sourceTypeUses.declarationUsesIn(scope: token) {
            val occurrence = try self.signatureOccurrence(id: id)
            try self.checkAuthoredTypeRecipe(sourceScope: token, recipe: occurrence.recipe, edge: <AuthoredRecipeEdge.Source />, scopes: scopes, validation: inout validation, offset: occurrence.site)
        }
        self.authoredRequirementViews[token] = <AuthoredRequirementSignature source=owner declaration=requirement proofs=validation.proofs />
        return <Result.Ok value=() />
    }

    // The selected trait is the goal of the query. Extension views still
    // supply its candidate sources, but the goal itself cannot enter Self.
    inout fn authoredTraitViewSubject(ref: U64) -> U64 {
        mut val extensions: Array[ResolvedViewSource] = []
        mut val hasTrait = false
        for source in self.arena.typeViewSources(ref: ref) {
            if source.traitInstance.owner == 0U64 { extensions.append(source) }
            else { hasTrait = true }
        }
        if !hasTrait { return ref }
        val base = self.typeRefWithoutOuterViews(ref: ref)
        if extensions.count() == 0U64 { return base }
        return self.typeRefWithViewSources(ref: base, sources: extensions)
    }

    inout fn authoredTraitSelectors(type: TypeRef, receiver: U64, site: U64) -> Result[Array[ResolvedViewSource], CompileDiagnostic] {
        mut val selectors: Array[ResolvedViewSource] = []
        for source in self.arena.typeViewSources(ref: receiver) {
            if source.traitInstance.owner != 0U64 { selectors.append(source) }
        }
        // Only receiver views participate in the view normal form. The
        // associated member's trait instance is a separate selection.
        if selectors.count() > 1U64 { return <Result.Err error=self.diagnosticAt(offset: site, msg: "a type view may select at most one trait source (spec/09)", failureDomain: <FailureDomain.Source />) /> }
        if type.assocNameId != 0U64 {
            val owner = if type.assocTraitDeclOffset != 0U64 { give type.assocTraitDeclOffset } else { give type.assocTraitStart }
            if owner == 0U64 || self.decls.traitIndexByOffset(offset: owner) >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: site, msg: "authored projection has no canonical trait owner", failureDomain: <FailureDomain.Internal />) /> }
            val projection = <ResolvedViewSource writtenStart=site surfaceId=type.assocTraitId traitInstance=<TraitInstanceKey owner=owner positionalArgs=type.assocTraitArgs /> />
            mut val present = false
            for selector in selectors { if self.semanticViewSourceEq(a: selector, b: projection) { present = true } }
            if !present { selectors.append(projection) }
        }
        return <Result.Ok value=selectors />
    }

    inout fn admitSignatureOccurrence(id: U64, occurrence: AuthoredTypeUse, scope: DeclarationTypeScope, assumptions: Array[DeclarationBoundRef], receiverRef: U64, receiverEquations: Array[ProjectionNormalizationStep], equations: inout Array[ProjectionNormalizationStep], proofs: inout Array[AuthoredTypeViewProof], inheritedProjection: Bool, receiverOccurrence: U64) -> Result[(), CompileDiagnostic] {
        try self.checkAuthoredTypeBinders(ref: occurrence.term, scope: scope, offset: occurrence.site)
        val type = self.arena.typeAt(index: occurrence.term)
        val receiver = if type.assocNameId == 0U64 { give occurrence.term } else { give self.typeTermProjectionReceiver(t: type) }
        val selectors = try self.authoredTraitSelectors(type: type, receiver: receiver, site: occurrence.site)
        if selectors.count() == 0U64 { return <Result.Ok value=() /> }
        val writtenSubject = if receiverRef != 0U64 { give self.groundTermInEnvironment(ref: receiver, params: [], values: [], selfRef: receiverRef) } else { give receiver }
        mut val context = equations
        for equation in receiverEquations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout context) }
        val subject = if context.count() != 0U64 { give (try self.replayProjectionChildren(ref: writtenSubject, normalizations: context, offset: occurrence.site)) } else { give writtenSubject }
        val selectedProjection = if receiverOccurrence != 0U64 {
            give <Optional.Some v=(try self.retainedSignatureReceiverProjection(occurrence: receiverOccurrence, ref: receiver, proofs: proofs, offset: occurrence.site)) />
        } else { give <Optional.None /> }
        for selector in selectors {
            if selector.traitInstance.owner != 0U64 {
                if self.decls.traitIndexByOffset(offset: selector.traitInstance.owner) >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "authored view has no canonical trait owner", failureDomain: <FailureDomain.Internal />) /> }
                mut val arguments = selector.traitInstance.positionalArgs
                if receiverRef != 0U64 || context.count() != 0U64 {
                    arguments = []
                    for argument in selector.traitInstance.positionalArgs {
                        val grounded = self.groundTermInEnvironment(ref: argument, params: [], values: [], selfRef: receiverRef)
                        arguments.append(try self.replayProjectionNormalizations(ref: grounded, normalizations: context, offset: occurrence.site))
                    }
                }
                val isProjection = type.assocNameId != 0U64 && selector.traitInstance.owner == self.associatedProjectionTraitOwner(projection: type) && self.sameResolvedTypeRefs(a: selector.traitInstance.positionalArgs, b: type.assocTraitArgs)
                mut val projectionAssumptions = assumptions
                mut val lexicalEquations: Array[ProjectionNormalizationStep] = []
                if inheritedProjection && isProjection {
                    projectionAssumptions = []
                    for assumption in assumptions {
                        if self.isSignatureLexicalReceiver(source: assumption, scope: scope) { projectionAssumptions.append(assumption) }
                    }
                    if projectionAssumptions.count() != 1U64 {
                        return <Result.Err error=self.diagnosticAt(offset: occurrence.site, msg: "inherited arguments have no unique lexical Self premise", failureDomain: <FailureDomain.Internal />) />
                    }
                    val lexical = projectionAssumptions[0U64]
                    val bound = self.declarationBound(source: lexical)
                    mut val normalized: Array[U64] = []
                    for argument in arguments {
                        normalized.append(try self.recordLexicalProjectionEquations(ref: argument, lexical: lexical, bound: bound, equations: inout lexicalEquations, offset: occurrence.site))
                    }
                    if lexicalEquations.count() != 0U64 {
                        try self.checkProjectionNormalizations(normalizations: lexicalEquations, offset: occurrence.site, assumptions: projectionAssumptions)
                        for equation in lexicalEquations {
                            try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations)
                            try self.appendRetainedProjectionEquation(step: equation, normalizations: inout context)
                        }
                        try self.requireDeclarationProofSupport(dependencies: (try self.scopedProjectionDependencies(equations: lexicalEquations, context: context, scope: scope, offset: occurrence.site)), offset: occurrence.site)
                    }
                    arguments = normalized
                }
                val instance = <TraitInstanceKey owner=selector.traitInstance.owner positionalArgs=arguments />
                val proofSubject = if type.assocNameId == 0U64 { give self.authoredTraitViewSubject(ref: subject) } else { give subject }
                mut val proof = try self.requireAuthoredViewProof(subject: proofSubject, instance: instance, assumptions: projectionAssumptions, offset: selector.writtenStart, selectedProjection: selectedProjection, normalizations: context)
                if isProjection {
                    proof = try self.selectSignatureProjectionEquation(proof: proof, subject: subject, owner: selector.traitInstance.owner, arguments: arguments, member: type.assocNameId, assumptions: projectionAssumptions, offset: occurrence.site)
                }
                try self.checkStaticProofEvidence(proof: proof, offset: occurrence.site, assumptions: assumptions)
                try self.requireDeclarationProofSupport(dependencies: (try self.scopedProofDependencies(proof: proof, scope: scope, offset: occurrence.site, normalizations: context)), offset: occurrence.site)
                if inheritedProjection && isProjection {
                    try self.checkInheritedSignatureProjection(proof: proof, scope: scope, subject: subject, selector: <TraitInstanceKey owner=selector.traitInstance.owner positionalArgs=arguments />, offset: occurrence.site)
                }
                val frozen = self.freezeStaticConformanceProof(proof: proof)
                if isProjection {
                    val raw = self.groundTermInEnvironment(ref: occurrence.term, params: [], values: [], selfRef: receiverRef)
                    // Replay matches a projection after its children have
                    // consumed their saved equations, at admission and run.
                    val projected = try self.replayProjectionChildren(ref: raw, normalizations: equations, offset: occurrence.site)
                    val output = match scope.origin {
                        DeclarationScopeOrigin.Nominal => {
                            val selected = try self.readProjectionForNormalization(proof: proof, traitOwner: selector.traitInstance.owner, assocId: type.assocNameId)
                            for equation in selected.normalizations { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations) }
                            give selected.immediate
                        }
                        _ => { give try self.associatedOutputTermInProof(proof: proof, traitOwner: selector.traitInstance.owner, assocId: type.assocNameId) }
                    }
                    val immediate = if output != 0U64 && !self.typeRefEq(a: output, b: projected) { give output } else { give 0U64 }
                    if self.arena.typeContainsAssociatedProjection(ref: immediate) {
                        match proof {
                            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: _) => {
                                mut val prerequisites: Array[ProjectionNormalizationStep] = []
                                try self.recordLexicalProjectionEquations(ref: immediate, lexical: source, bound: self.declarationBound(source: source), equations: inout prerequisites, offset: occurrence.site, active: [projected])
                                for equation in prerequisites {
                                    try self.appendRetainedProjectionEquation(step: equation, normalizations: inout lexicalEquations)
                                    try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations)
                                    try self.appendRetainedProjectionEquation(step: equation, normalizations: inout context)
                                }
                                try self.checkProjectionNormalizations(normalizations: lexicalEquations, offset: occurrence.site, assumptions: projectionAssumptions)
                                try self.requireDeclarationProofSupport(dependencies: (try self.scopedProjectionDependencies(equations: prerequisites, context: context, scope: scope, offset: occurrence.site)), offset: occurrence.site)
                            }
                            _ => {}
                        }
                    }
                    try self.appendRetainedProjectionEquation(step: <ProjectionNormalizationStep source=projected proof=frozen output=immediate />, normalizations: inout equations)
                }
                proofs.append(<AuthoredTypeViewProof occurrence=id receiver=receiver selector=selector proof=frozen lexicalEquations=lexicalEquations />)
            }
        }
        return <Result.Ok value=() />
    }

    inout fn requireAuthoredViewProof(subject: U64, instance: TraitInstanceKey, assumptions: Array[DeclarationBoundRef], offset: U64, selectedProjection: Optional[StaticConformanceProof] = <Optional.None />, normalizations: Array[ProjectionNormalizationStep] = [], missingMessage: String = "trait view requires a conformance for this receiver and exact trait instance (spec/09)") -> Result[StaticConformanceProof, CompileDiagnostic] {
        match (try self.queryTraitPatternProof(demand: <ConformanceProofDemand.SourceAdmission />, baseRef: subject, traitId: 0U64, traitOwner: instance.owner, traitArgs: <PatternTypeInput.Values values=instance.positionalArgs />, patternParams: <PatternBindInput.Values values=[] />, assumptions: assumptions, selectedProjection: selectedProjection, normalizations: normalizations)) {
            ConformanceProofResult.Found(proof: val proof) => { return <Result.Ok value=proof /> }
            ConformanceProofResult.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: missingMessage, failureDomain: <FailureDomain.Source />) /> }
            ConformanceProofResult.Ambiguous(owner: _, demand: _, selectedSource: _) => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "trait view does not have a unique conformance path (spec/09)", failureDomain: <FailureDomain.Source />) /> }
        }
    }

    // Equivalent declaration premises can contribute the equation for this
    // instance without allowing an unrelated conformance path to compete.
    inout fn selectSignatureProjectionEquation(proof: StaticConformanceProof, subject: U64, owner: U64, arguments: Array[U64], member: U64, assumptions: Array[DeclarationBoundRef], offset: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        val premise = self.signatureProjectionPremise(proof: proof)
        if premise.source.isNone() { return <Result.Ok value=proof /> }
        val root = premise.source.unwrap()
        mut val selected = <TraitProjectionEquality.Missing />
        mut val equationProof = proof
        for source in assumptions {
            if !self.sameSourceProofRoot(a: root, b: source) { continue }
            val bound = self.declarationBound(source: source)
            val equation = self.traitProjectionEquality(bound: bound, receiver: subject, owner: owner, arguments: arguments, member: member, context: bound, projectionPath: [], retainPath: true)
            match equation {
                TraitProjectionEquality.Value(term: _, steps: val steps) => {
                    match selected {
                        TraitProjectionEquality.Missing => {
                            equationProof = if steps.count() == 0U64 { give <StaticConformanceProof.AssumedBound source=source /> }
                              else { give <StaticConformanceProof.AssumedSupertraitPath source=source steps=steps /> }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            selected = self.mergeTraitProjectionEquality(selected: selected, candidate: equation)
        }
        match selected {
            TraitProjectionEquality.Conflict => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "inherited associated type has conflicting equations (spec/08)", failureDomain: <FailureDomain.Source />) /> }
            _ => { return <Result.Ok value=equationProof /> }
        }
    }

    // Record the bound that actually states the equality. An opaque path to
    // the same trait may establish conformance without stating its output.
    inout fn recordLexicalProjectionEquations(ref: U64, lexical: DeclarationBoundRef, bound: TraitBound, equations: inout Array[ProjectionNormalizationStep], offset: U64, active: Array[U64] = [], sourceOwners: Array[U64] = []) -> Result[U64, CompileDiagnostic] {
        if !self.arena.typeContainsAssociatedProjection(ref: ref) { return <Result.Ok value=ref /> }
        mut val children: Array[U64] = []
        for index in 0U64..<self.typeTermRefChildCount(ref: ref) {
            val child = self.typeTermRefChildRef(ref: ref, index: index)
            children.append(try self.recordLexicalProjectionEquations(ref: child, lexical: lexical, bound: bound, equations: inout equations, offset: offset, active: active))
        }
        val rebuilt = self.rebuildTypeTermChildren(ref: ref, children: children)
        val projection = self.arena.typeAt(index: rebuilt)
        if projection.assocNameId == 0U64 { return <Result.Ok value=rebuilt /> }
        for prior in active {
            if self.typeRefEq(a: prior, b: rebuilt) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "inherited argument projection equations are cyclic", failureDomain: <FailureDomain.Source />) />
            }
        }
        val owner = self.associatedProjectionTraitOwner(projection: projection)
        val receiver = self.typeTermProjectionReceiver(t: projection)
        match self.traitProjectionEquality(bound: bound, receiver: receiver, owner: owner, arguments: projection.assocTraitArgs, member: projection.assocNameId, context: bound, projectionPath: [rebuilt], retainPath: true, sourceOwners: sourceOwners) {
            TraitProjectionEquality.Missing | TraitProjectionEquality.Conflict => { return <Result.Ok value=rebuilt /> }
            TraitProjectionEquality.Value(term: _, steps: val steps) => {
                val proof = if steps.count() == 0U64 { give <StaticConformanceProof.AssumedBound source=lexical /> } else { give <StaticConformanceProof.AssumedSupertraitPath source=lexical steps=steps /> }
                val output = try self.associatedOutputTermInProof(proof: proof, traitOwner: owner, assocId: projection.assocNameId)
                if output == 0U64 {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "inherited argument equation lost its declared output", failureDomain: <FailureDomain.Internal />) />
                }
                if self.typeRefEq(a: output, b: rebuilt) { return <Result.Ok value=rebuilt /> }
                mut val next = active
                next.append(rebuilt)
                // A lexical equality can match an inherited instance whose
                // written key needs equations from a different parent path.
                // Keep those prerequisites before publishing this equation.
                val selected = self.supertraitBoundThroughSteps(root: bound, steps: steps, normalizeInstance: false)
                for argument in selected.constraint.key.positionalArgs {
                    try self.recordLexicalProjectionEquations(ref: argument, lexical: lexical, bound: bound, equations: inout equations, offset: offset, active: next)
                }
                // During concrete replay the witness may already return the
                // normalized output. Admit the RHS derivation first so the
                // verifier can establish equality using preceding evidence.
                val normalized = try self.recordLexicalProjectionEquations(ref: output, lexical: lexical, bound: bound, equations: inout equations, offset: offset, active: next)
                val equation = <ProjectionNormalizationStep source=rebuilt proof=self.freezeStaticConformanceProof(proof: proof) output=output />
                try self.appendRetainedProjectionEquation(step: equation, normalizations: inout equations)
                return <Result.Ok value=normalized />
            }
        }
    }

    inout fn retainedSignatureReceiverProjection(occurrence: U64, ref: U64, proofs: Array[AuthoredTypeViewProof], offset: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        val projection = self.arena.typeAt(index: ref)
        val receiver = self.typeTermProjectionReceiver(t: projection)
        val owner = self.associatedProjectionTraitOwner(projection: projection)
        for proof in proofs {
            if proof.occurrence == occurrence && proof.selector.traitInstance.owner == owner && self.typeRefEq(a: proof.receiver, b: receiver) && self.sameResolvedTypeRefs(a: proof.selector.traitInstance.positionalArgs, b: projection.assocTraitArgs) {
                return <Result.Ok value=self.thawStaticConformanceProof(id: proof.proof) />
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "signature projection receiver has no retained occurrence proof", failureDomain: <FailureDomain.Internal />) />
    }

    // The derived arguments are structural children of this exact projection.
    // Only the declaring signature's own Self premise authorizes those terms.
    inout fn checkInheritedSignatureProjection(proof: StaticConformanceProof, scope: DeclarationTypeScope, subject: U64, selector: TraitInstanceKey, offset: U64) -> Result[(), CompileDiagnostic] {
        val premise = self.signatureProjectionPremise(proof: proof)
        if premise.steps.count() != 0U64 && premise.source.isSome() {
            val source = premise.source.unwrap()
            if self.isSignatureLexicalReceiver(source: source, scope: scope) {
                val terminal = self.assumedSupertraitBound(source: source, steps: premise.steps)
                if self.typeRefEq(a: terminal.subject, b: subject) && terminal.constraint.key.owner == selector.owner && self.sameResolvedTypeRefs(a: terminal.constraint.key.positionalArgs, b: selector.positionalArgs) { return <Result.Ok value=() /> }
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "inherited signature arguments have no matching lexical supertrait path", failureDomain: <FailureDomain.Internal />) />
    }

    fn isSignatureLexicalReceiver(source: DeclarationBoundRef, scope: DeclarationTypeScope) -> Bool {
        match source {
            DeclarationBoundRef.RawRequirement(index: val index) => {
                return self.rawRequirementRanges.getOr(key: scope.owner, fallback: <SourceBoundRange />).first == index + 1U64
            }
            DeclarationBoundRef.MethodReceiver(index: val index) => { return index == scope.owner }
            _ => { return false }
        }
    }

}
