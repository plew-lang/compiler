// One immutable proof scope per selected erased-receiver operation. This is
// not a conformance of the existential container or a source opening feature.
impl Comp {
    fn interfaceEvidenceIsValid(index: U64) -> Bool {
        if index >= self.interfaceEvidence.count() { return false }
        match self.interfaceEvidence[index]->node {
            InterfaceEvidenceNode.Source(root: val root) => { return root.session == self.sourceFacts.session }
            InterfaceEvidenceNode.Contract(root: val root) => {
                return root.session == self.sourceFacts.session && root.traitIndex < self.decls.traitCount() && root.slot != 0U64 && root.slot <= self.decls.traitAt(index: root.traitIndex).reqs.count() && root.bound.constraint.key.owner == self.decls.traitAt(index: root.traitIndex).nameStart
            }
            InterfaceEvidenceNode.Instance(root: val root, owner: val owner, bound: _) => {
                if root == 0U64 || root > self.interfaceEvidence.count() { return false }
                match owner {
                    InterfaceEvidenceOwner.Body(index: val body) => { if body == 0U64 || body > self.arena.bodyInstanceCount() { return false } }
                    InterfaceEvidenceOwner.Declaration(environment: _) => {}
                }
                match self.interfaceEvidence[root - 1U64]->node {
                    InterfaceEvidenceNode.Source(root: val source) => { return source.session == self.sourceFacts.session }
                    InterfaceEvidenceNode.Contract(root: _) | InterfaceEvidenceNode.Instance(root: _, owner: _, bound: _) => { return false }
                }
            }
        }
    }

    fn interfaceEvidenceBound(index: U64) -> TraitBound {
        if !self.interfaceEvidenceIsValid(index: index) { return self.missingTraitBound() }
        return match self.interfaceEvidence[index]->node {
            InterfaceEvidenceNode.Source(root: val root) => root.bound,
            InterfaceEvidenceNode.Contract(root: val root) => root.bound,
            InterfaceEvidenceNode.Instance(root: _, owner: _, bound: val bound) => bound,
        }
    }

    fn interfaceSourceRoot(index: U64) -> U64 {
        if !self.interfaceEvidenceIsValid(index: index) { return 0U64 }
        return match self.interfaceEvidence[index]->node {
            InterfaceEvidenceNode.Source(root: _) | InterfaceEvidenceNode.Contract(root: _) => index + 1U64,
            InterfaceEvidenceNode.Instance(root: val root, owner: _, bound: _) => root,
        }
    }

    fn interfaceScopeParameter(scope: DeclarationTypeScope) -> U64 {
        if scope.interfaceRoot == 0U64 { return 0U64 }
        val bound = self.interfaceEvidenceBound(index: scope.interfaceRoot - 1U64)
        if bound.subject == 0U64 || bound.subject >= self.arena.typeCount() { return 0U64 }
        return self.arena.typeTermAt(index: bound.subject).paramId
    }

    inout fn checkInterfaceAssumptionScope(index: U64, scope: DeclarationTypeScope, offset: U64) -> Result[(), CompileDiagnostic] {
        if scope.interfaceRoot != index + 1U64 || !self.interfaceEvidenceIsValid(index: index) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "interface assumption belongs to another selected operation") />
        }
        val root = self.interfaceSourceRoot(index: index)
        val source = match self.interfaceEvidence[root - 1U64]->node {
            InterfaceEvidenceNode.Source(root: val source) => {
                match scope.origin {
                    DeclarationScopeOrigin.Lexical => {}
                    DeclarationScopeOrigin.InterfaceContract => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "source-call evidence cannot authorize an interface contract") /> }
                }
                give source
            }
            InterfaceEvidenceNode.Contract(root: _) => {
                match scope.origin {
                    DeclarationScopeOrigin.InterfaceContract => {
                        if scope.owner != 0U64 || scope.parameters.len != 0U64 || scope.selfParameter != 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "interface contract borrowed a lexical declaration scope") /> }
                        return <Result.Ok value=() />
                    }
                    DeclarationScopeOrigin.Lexical => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "interface-contract evidence cannot authorize a source call") /> }
                }
            }
            InterfaceEvidenceNode.Instance(root: _, owner: _, bound: _) => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "interface assumption has no source root") /> },
        }
        val lexical = try self.declarationTypeScope(owner: source.site.ownerFnIdx)
        if lexical.owner != scope.owner {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "interface assumption is not available in its lexical scope") />
        }
        return <Result.Ok value=() />
    }

    // Only selected source recording calls this constructor. Exact operation
    // matching and immutable publication, rather than a name lookup, grant use.
    inout fn createInterfaceEvidenceRoot(site: CallSiteKey, receiver: U64, traitIndex: U64) -> Result[U64, CompileDiagnostic] {
        if receiver == 0U64 || receiver >= self.arena.typeCount() || !self.arena.typeTermAt(index: receiver).isAny || traitIndex >= self.decls.traitCount() {
            return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "selected interface has no valid receiver or trait") />
        }
        val owner = match self.currentSourceOwner() {
            Optional.Some(v: val owner) => owner,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "selected interface has no source owner") /> },
        }
        if self.sourceOwnerConstructionClosed(owner: owner) {
            return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "completed source owner cannot create an interface scope") />
        }
        val constraint = self.existentialTraitConstraint(ref: receiver)
        if constraint.key.owner != self.decls.traitAt(index: traitIndex).nameStart {
            return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "selected interface belongs to another receiver trait") />
        }
        val parameter = self.nextParamId
        self.nextParamId += 1U64
        val name = self.internTmpName(prefix: "InterfaceSelf", n: parameter)
        val subject = self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen paramId=parameter args=[] />)
        val root = <InterfaceEvidenceRoot session=self.sourceFacts.session owner=owner site=site receiver=receiver traitIndex=traitIndex bound=<TraitBound subject=subject constraint=constraint offset=site.originStart /> />
        self.interfaceEvidence.append(<Ref value=<InterfaceEvidenceCell node=<InterfaceEvidenceNode.Source root=root /> /> />)
        return <Result.Ok value=self.interfaceEvidence.count() />
    }
}

impl Comp {
    inout fn retainSourceInterfaceRoot(site: CallSiteKey, receiver: U64, traitIndex: U64) -> Result[U64, CompileDiagnostic] {
        val index = self.callTemplateIndex(siteKey: site)
        if index < self.callTemplateLocations.count() {
            val root = selectedInterfaceRoot(template: self.callTemplateAt(index: index))
            if root != 0U64 {
                try self.requireSourceInterfaceRoot(root: root, site: site, receiver: receiver, traitIndex: traitIndex)
                return <Result.Ok value=root />
            }
        }
        return self.createInterfaceEvidenceRoot(site: site, receiver: receiver, traitIndex: traitIndex)
    }

    inout fn requireSourceInterfaceRoot(root: U64, site: CallSiteKey, receiver: U64, traitIndex: U64) -> Result[InterfaceEvidenceRoot, CompileDiagnostic] {
        if root == 0U64 || !self.interfaceEvidenceIsValid(index: root - 1U64) {
            return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "selected interface has no retained proof root") />
        }
        match self.interfaceEvidence[root - 1U64]->node {
            InterfaceEvidenceNode.Source(root: val source) => {
                if !self.sameCallSiteKey(a: source.site, b: site) || !self.typeRefEq(a: source.receiver, b: receiver) || source.traitIndex != traitIndex {
                    return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "selected interface proof belongs to another operation or receiver") />
                }
                val index = self.callTemplateIndex(siteKey: site)
                if index < self.callTemplateLocations.count() && !semanticCompletionOwnersEqual(recorded: source.owner, prepared: self.callTemplateLocations[index].owner) {
                    return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "selected interface proof belongs to another source owner") />
                }
                return <Result.Ok value=source />
            }
            InterfaceEvidenceNode.Contract(root: _) | InterfaceEvidenceNode.Instance(root: _, owner: _, bound: _) => { return <Result.Err error=self.diagnosticAt(offset: site.originStart, msg: "source interface requires its original source-call proof root") /> }
        }
    }

    inout fn callConstraintScope(template: CallTemplate) -> Result[DeclarationTypeScope, CompileDiagnostic] {
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        return <Result.Ok value=<DeclarationTypeScope owner=scope.owner parameters=scope.parameters selfParameter=scope.selfParameter interfaceRoot=selectedInterfaceRoot(template: template) /> />
    }

    inout fn sourceInterfaceSignatureBounds(template: CallTemplate, root: U64, traitIndex: U64, slot: U64) -> Result[Array[TraitBound], CompileDiagnostic] {
        val source = try self.requireSourceInterfaceRoot(root: root, site: template.siteKey, receiver: template.receiverTypeTerm, traitIndex: traitIndex)
        return self.interfaceSignatureBounds(root: root, bound: source.bound, traitIndex: traitIndex, slot: slot, offset: template.siteKey.originStart)
    }

    inout fn interfaceSignatureBounds(root: U64, bound: TraitBound, traitIndex: U64, slot: U64, offset: U64) -> Result[Array[TraitBound], CompileDiagnostic] {
        val trait = self.decls.traitAt(index: traitIndex)
        if slot == 0U64 || slot > trait.reqs.count() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected interface has no retained requirement") />
        }
        val requirement = self.traitReqAt(reqs: trait.reqs, index: slot - 1U64)
        val proof = <StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Interface index=root - 1U64 /> />
        val signature = <SourceCallSignature.Trait bound=bound traitIndex=traitIndex environment=<InstanceEnvironment receiverRef=bound.subject proof=proof /> />
        mut val bounds: Array[TraitBound] = []
        mut val index = 0U64
        while index < requirement.signatureBounds.len {
            val clause = self.conformBoundAt(bounds: requirement.signatureBounds, index: index)
            bounds.append(<TraitBound subject=(try self.sourceCallSignatureParameter(ref: clause.subject, signature: signature)) constraint=(try self.sourceCallSignatureConstraint(constraint: clause.constraint, signature: signature)) offset=clause.offset />)
            index += 1U64
        }
        return <Result.Ok value=bounds />
    }
}


impl Comp {
    inout fn declarationTypeDependencies(ref: U64, scope: DeclarationTypeScope, offset: U64) -> Result[DeclarationTypeDependencies, CompileDiagnostic] {
        if self.arena.typeIsClosed(ref: ref) { return <Result.Ok value=<DeclarationTypeDependencies /> /> }
        if ref >= self.arena.typeTermCount() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation has an invalid type term") /> }
        val term = self.arena.typeTermAt(index: ref)
        mut val caller = false
        mut val interfaceScoped = false
        // A projection's receiver child owns its binder. The old flat mirror
        // on a projection is not a second parameter occurrence or authority.
        if term.paramId != 0U64 && term.assocNameId == 0U64 {
            caller = term.paramId == scope.selfParameter
            mut val index = 0U64
            while index < scope.parameters.count() {
                if self.funcBindAt(binds: scope.parameters, index: index).paramId == term.paramId { caller = true }
                index += 1U64
            }
            if !caller && scope.interfaceRoot != 0U64 { interfaceScoped = self.interfaceScopeParameter(scope: scope) == term.paramId }
            if !caller && !interfaceScoped { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation refers to a type parameter outside its lexical scope") /> }
        }
        mut val index = 0U64
        while index < self.typeTermRefChildCount(ref: ref) {
            val child = try self.declarationTypeDependencies(ref: self.typeTermRefChildRef(ref: ref, index: index), scope: scope, offset: offset)
            if child.caller { caller = true }
            if child.interfaceScoped { interfaceScoped = true }
            index += 1U64
        }
        if !caller && !interfaceScoped { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "unresolved declaration type has no lexical parameter dependency") /> }
        return <Result.Ok value=<DeclarationTypeDependencies caller=caller interfaceScoped=interfaceScoped /> />
    }
}

// Interface provenance is followed through authored associated constraints,
// never inferred from a type name or an ambient body cursor.
impl Comp {
    inout fn mergeInterfaceProofRoots(first: U64, second: U64) -> Result[U64, CompileDiagnostic] {
        if first != 0U64 && second != 0U64 && first != second {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "condition evidence combines different interface scopes") />
        }
        return <Result.Ok value=if first != 0U64 { give first } else { give second } />
    }

    inout fn interfaceAssumptionRoot(source: DeclarationBoundRef, depth: U64) -> Result[U64, CompileDiagnostic] {
        match source {
            DeclarationBoundRef.Interface(index: val index) => {
                if !self.interfaceEvidenceIsValid(index: index) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface proof has no retained root") /> }
                return <Result.Ok value=index + 1U64 />
            }
            DeclarationBoundRef.AssociatedType(index: val index) => {
                if !self.declarationBoundIsValid(source: source) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface proof has no retained associated clause") /> }
                return self.interfaceProofRoot(proof: self.arena.associatedBoundEvidenceAt(index: index).prerequisite, depth: depth + 1U64)
            }
            _ => { return <Result.Ok value=0U64 /> }
        }
    }

    inout fn interfaceWitnessRoot(witness: WitnessMatch, depth: U64) -> Result[U64, CompileDiagnostic] {
        if witness.conditions == 0U64 { return <Result.Ok value=0U64 /> }
        if witness.conditions > self.arena.witnessConditionPlanCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected conformance has an invalid condition plan") /> }
        val plan = self.arena.witnessConditionPlanAt(index: witness.conditions - 1U64)
        mut val root = 0U64
        for proof in plan.proofs {
            root = try self.mergeInterfaceProofRoots(first: root, second: (try self.interfaceProofRoot(proof: self.thawStaticConformanceProof(id: proof), depth: depth + 1U64)))
        }
        for step in plan.normalizations {
            root = try self.mergeInterfaceProofRoots(first: root, second: (try self.interfaceProofRoot(proof: self.thawStaticConformanceProof(id: step.proof), depth: depth + 1U64)))
        }
        return <Result.Ok value=root />
    }

    inout fn interfaceProofRoot(proof: StaticConformanceProof, depth: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        if depth > 64U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface proof provenance expansion limit exceeded") /> }
        match proof {
            StaticConformanceProof.AssumedBound(source: val source) | StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: _) => {
                return self.interfaceAssumptionRoot(source: source, depth: depth)
            }
            StaticConformanceProof.ConcreteWitness(witness: val witness) => { return self.interfaceWitnessRoot(witness: witness, depth: depth) }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: _, edges: val edges) => {
                mut val root = try self.interfaceAssumptionRoot(source: source, depth: depth)
                for edge in edges { root = try self.mergeInterfaceProofRoots(first: root, second: (try self.interfaceWitnessRoot(witness: edge, depth: depth))) }
                return <Result.Ok value=root />
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: _) => {
                mut val root = 0U64
                for edge in edges { root = try self.mergeInterfaceProofRoots(first: root, second: (try self.interfaceWitnessRoot(witness: edge, depth: depth))) }
                return <Result.Ok value=root />
            }
            _ => { return <Result.Ok value=0U64 /> }
        }
    }

    inout fn interfaceAssumptionIsUniversal(source: DeclarationBoundRef, subject: U64) -> Result[Bool, CompileDiagnostic] {
        val root = try self.interfaceProofRoot(proof: <StaticConformanceProof.AssumedBound source=source />)
        if root == 0U64 { return <Result.Ok value=false /> }
        val bound = self.interfaceEvidenceBound(index: root - 1U64)
        return <Result.Ok value=self.typeTermContainsParameter(ref: subject, parameter: self.arena.typeTermAt(index: bound.subject).paramId) />
    }
}

impl Comp {
    // Schema promises stay attached to the exact interface and original clause,
    // including when Item=T has already normalized the projection to caller T.
    inout fn appendInterfaceAssociatedAssumptions(source: DeclarationBoundRef, steps: Array[SupertraitRef], assumptions: inout Array[DeclarationBoundRef], depth: U64 = 0U64) -> Result[(), CompileDiagnostic] {
        if depth > 64U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface guarantee expansion limit exceeded") /> }
        val parent = self.assumedSupertraitBound(source: source, steps: steps)
        val traitIndex = self.decls.traitIndexByOffset(offset: parent.constraint.key.owner)
        if traitIndex >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface guarantee has no retained trait declaration") /> }
        val trait = self.decls.traitAt(index: traitIndex)
        val prerequisite = if steps.count() == 0U64 { give <StaticConformanceProof.AssumedBound source=source /> } else { give <StaticConformanceProof.AssumedSupertraitPath source=source steps=steps /> }
        mut val clauseIndex = 0U64
        while clauseIndex < trait.assocBounds.len {
            val clause = self.traitAssociatedBoundAt(bounds: trait.assocBounds, index: clauseIndex)
            mut val memberIndex = 0U64
            while memberIndex < trait.assocTypes.count() {
                val member = self.traitBindAt(binds: trait.assocTypes, index: memberIndex)
                if member.nameId == clause.member {
                    val subject = self.arena.typeAt(index: parent.subject)
                    val projection = self.pushType(t: <TypeRef nameStart=subject.nameStart nameLen=subject.nameLen paramId=subject.paramId args=[] projectionReceiver=parent.subject assocTraitStart=trait.nameStart assocTraitLen=trait.nameLen assocTraitId=trait.nameId assocTraitArgs=parent.constraint.key.positionalArgs assocNameStart=member.nameStart assocNameLen=member.nameLen assocNameId=member.nameId hasAssocTraitDecl=true assocTraitDeclOffset=trait.nameStart />)
                    val index = trait.assocBounds.start + clauseIndex
                    val bound = try self.associatedClauseBound(projectionRef: projection, clauseIndex: index, prerequisite: prerequisite, offset: clause.offset)
                    assumptions.append(self.registerAssociatedBoundEvidence(evidence: <AssociatedBoundEvidence projection=projection clause=index prerequisite=prerequisite bound=bound />))
                }
                memberIndex += 1U64
            }
            clauseIndex += 1U64
        }
        mut val superIndex = 0U64
        while superIndex < trait.supertraits.count() {
            mut val path = steps
            path.append(<SupertraitRef traitIndex=traitIndex boundIndex=superIndex />)
            try self.appendInterfaceAssociatedAssumptions(source: source, steps: path, assumptions: inout assumptions, depth: depth + 1U64)
            superIndex += 1U64
        }
        return <Result.Ok value=() />
    }
}

// A table member's public contract has no enclosing source-call owner. Its
// explicit scope admits only the interface and its declared associated facts.
impl Comp {
    inout fn createInterfaceContractRoot(target: U64, traitIndex: U64, slot: U64) -> Result[U64, CompileDiagnostic] {
        if target == 0U64 || target >= self.arena.typeCount() || !self.arena.typeTermAt(index: target).isAny || !self.arena.typeIsClosed(ref: target) || traitIndex >= self.decls.traitCount() || slot == 0U64 || slot > self.decls.traitAt(index: traitIndex).reqs.count() {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface member contract has no closed target or requirement") />
        }
        val constraint = self.existentialTraitConstraint(ref: target)
        if constraint.key.owner != self.decls.traitAt(index: traitIndex).nameStart { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface member contract belongs to another trait") /> }
        val parameter = self.nextParamId
        self.nextParamId += 1U64
        val name = self.internTmpName(prefix: "InterfaceContractSelf", n: parameter)
        val subject = self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen paramId=parameter args=[] />)
        val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: traitIndex).reqs, index: slot - 1U64)
        val bound = <TraitBound subject=subject constraint=constraint offset=requirement.nameStart />
        self.interfaceEvidence.append(<Ref value=<InterfaceEvidenceCell node=<InterfaceEvidenceNode.Contract root=<InterfaceContractRoot session=self.sourceFacts.session receiver=target traitIndex=traitIndex slot=slot bound=bound /> /> /> />)
        return <Result.Ok value=self.interfaceEvidence.count() />
    }

    inout fn interfaceMethodConditions(target: U64, traitIndex: U64, requirement: U64) -> Result[Optional[ExistentialMethodConditions], CompileDiagnostic] {
        if traitIndex >= self.decls.traitCount() || requirement >= self.decls.traitAt(index: traitIndex).reqs.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface member has no selected requirement") /> }
        val declaration = self.traitReqAt(reqs: self.decls.traitAt(index: traitIndex).reqs, index: requirement)
        if declaration.signatureBounds.len == 0U64 { return <Result.Ok value=<Optional.Some v=<ExistentialMethodConditions root=0U64 bounds=[] proofs=[] /> /> /> }
        val root = try self.createInterfaceContractRoot(target: target, traitIndex: traitIndex, slot: requirement + 1U64)
        val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.InterfaceContract /> owner=0U64 parameters=<FuncBindRange start=0U64 len=0U64 /> interfaceRoot=root />
        val bounds = try self.interfaceSignatureBounds(root: root, bound: self.interfaceEvidenceBound(index: root - 1U64), traitIndex: traitIndex, slot: requirement + 1U64, offset: declaration.nameStart)
        val source = <DeclarationBoundRef.Interface index=root - 1U64 />
        mut val assumptions: Array[DeclarationBoundRef] = [source]
        try self.appendInterfaceAssociatedAssumptions(source: source, steps: [], assumptions: inout assumptions)
        mut val proofs: Array[U64] = []
        for bound in bounds {
            val proof = match (try self.queryViewedTraitConstraint(demand: <ConformanceProofDemand.SourceAdmission />, ref: bound.subject, constraint: bound.constraint, assumptions: assumptions)) {
                ConformanceProofResult.Found(proof: val proof) => proof,
                ConformanceProofResult.Missing | ConformanceProofResult.Ambiguous(owner: _, demand: _, selectedSource: _) => { return <Result.Ok value=<Optional.None /> /> },
            }
            try self.checkStaticProofEvidence(proof: proof, offset: bound.offset)
            val dependencies = try self.scopedProofDependencies(proof: proof, scope: scope, offset: bound.offset)
            if dependencies.unguaranteedInterface { return <Result.Ok value=<Optional.None /> /> }
            try self.checkSelectedCallConstraintBoundary(expected: bound, proof: proof, offset: bound.offset)
            proofs.append(self.freezeStaticConformanceProof(proof: proof))
        }
        return <Result.Ok value=<Optional.Some v=<ExistentialMethodConditions root=root bounds=bounds proofs=proofs /> /> />
    }
}
