// Part of compile-time checks (root: _.pw): trait-bound and conformance
// validation.


// The concrete type span that the conforming type `(recvStart,recvLen)` binds for
// the associated type named `(nameStart,nameLen)` (spec/08 `type Item = Concrete`),
// or the input name unchanged when it is not an associated type / has no binding.

pub impl Comp {
    // Compare canonical semantic constraints, excluding diagnostic spans.
    inout fn sameTraitConstraint(a: TraitConstraint, b: TraitConstraint) -> Bool {
        if a.key.owner != b.key.owner || a.positionalArgsOpen != b.positionalArgsOpen || !self.sameResolvedTypeRefs(a: a.key.positionalArgs, b: b.key.positionalArgs) || a.assocPredicates.count() != b.assocPredicates.count() { return false }
        mut val index = 0U64
        while index < a.assocPredicates.count() {
            val left = a.assocPredicates[index]
            val right = b.assocPredicates[index]
            if left.member != right.member || !self.typeRefEq(a: left.value, b: right.value) { return false }
            index += 1U64
        }
        return true
    }

    // The body key remains the operation owner. Only lexical binder and
    // assumption queries project a closure to its declaring function.
    fn sourceLexicalFunction(fnIdx: U64) -> U64 {
        return self.callTemplateLexicalRoots.getOr(key: fnIdx, fallback: fnIdx)
    }

    fn hasMethodReceiverAssumption(function: U64) -> Bool {
        if !functionHasTraitReceiver(self.arena, self.decls, fnIdx: function) { return false }
        match self.sourceTypeUses.methodScopeFor(function: function) {
            Optional.Some(v: val method) => {
                // A successful earlier member can be registered before a
                // later member rejects the entire originating impl.
                match self.sourceTypeUses.completedMethodImplementation(method: method) {
                    Optional.Some(v: val owner) => { return owner.receiverTrait == self.arena.functionAt(index: function).recvStart }
                    Optional.None => { return false }
                }
            }
            // Generated callable forms have their own function identity.
            Optional.None => { return true }
        }
    }

    fn functionBoundAssumptions(fnIdx: U64) -> Array[DeclarationBoundRef] {
        // A closure owns its call/body identity, but its generic assumptions
        // are declared by its lexical function. This mapping is published
        // before recording the closure body and preserves ParamId identity.
        val owner = self.sourceLexicalFunction(fnIdx: fnIdx)
        mut val result: Array[DeclarationBoundRef] = []
        for index in self.decls.funcBounds.indices(owner: owner) {
            result.append(<DeclarationBoundRef.Function index=index />)
        }
        if self.hasMethodReceiverAssumption(function: owner) { result.append(<DeclarationBoundRef.MethodReceiver index=owner />) }
        return result
    }

    fn conformanceBoundAssumptions(bounds: ConformBoundRange) -> Array[DeclarationBoundRef] {
        mut val result: Array[DeclarationBoundRef] = []
        mut val index = 0U64
        while index < bounds.len {
            result.append(<DeclarationBoundRef.Conformance index=bounds.start + index />)
            index += 1U64
        }
        return result
    }

    fn declarationBoundIsValid(source: DeclarationBoundRef) -> Bool {
        match source {
            DeclarationBoundRef.Function(val index) => { return index < self.decls.funcBounds.count() }
            DeclarationBoundRef.Conformance(val index) => { return index < self.decls.conformBoundPool.count() }
            DeclarationBoundRef.TraitSubject(val index) => { return index < self.decls.conformCount() }
            DeclarationBoundRef.AssociatedType(val index) => { return index < self.arena.associatedBoundEvidenceCount() }
            DeclarationBoundRef.MethodReceiver(val index) => { return self.hasMethodReceiverAssumption(function: index) }
            DeclarationBoundRef.Requirement(val index) => { return index < self.arena.requirementBoundEvidenceCount() }
            DeclarationBoundRef.Interface(val index) => { return self.interfaceEvidenceIsValid(index: index) }
            DeclarationBoundRef.RawRequirement(val index) => { return index < self.rawRequirementPremises.count() }
            DeclarationBoundRef.TraitDeclaration(val index) => { return self.traitDeclarationPremises.contains(key: index) }
        }
    }

    // The caller supplies a validated authored reference. No lookup by names
    // or by a method that happens to implement the same trait is involved.
    inout fn declarationBound(source: DeclarationBoundRef) -> TraitBound {
        match source {
            DeclarationBoundRef.Function(val index) => {
                val bound = self.decls.funcBounds.at(index: index)
                return <TraitBound subject=bound.paramTy constraint=bound.constraint offset=bound.paramStart />
            }
            DeclarationBoundRef.Conformance(val index) => {
                val bound = self.decls.conformBoundPool[index]
                return <TraitBound subject=bound.subject constraint=bound.constraint offset=bound.offset />
            }
            DeclarationBoundRef.TraitSubject(val index) => {
                val conformance = self.decls.conformAt(index: index)
                val owner = conformance.subjectTraitOwner
                return <TraitBound subject=self.receiverSubjectTerm(receiver: conformance.subjectTy, traitOwner: owner) constraint=<TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=self.copyConformTypes(types: conformance.subjectArgs) /> positionalArgsOpen=false assocPredicates=[] /> offset=conformance.defOffset />
            }
            DeclarationBoundRef.AssociatedType(val index) => { return self.arena.associatedBoundEvidenceAt(index: index).bound }
            DeclarationBoundRef.Requirement(val index) => { return self.arena.requirementBoundEvidenceAt(index: index).bound }
            DeclarationBoundRef.Interface(val index) => { return self.interfaceEvidenceBound(index: index) }
            DeclarationBoundRef.RawRequirement(val index) => { return self.rawRequirementPremises[index].bound }
            DeclarationBoundRef.TraitDeclaration(val index) => { return self.traitDeclarationPremises[index] }
            DeclarationBoundRef.MethodReceiver(val index) => {
                val function = self.arena.functionAt(index: index)
                return <TraitBound subject=function.recvTy constraint=<TraitConstraint key=<TraitInstanceKey owner=function.recvStart positionalArgs=self.copyFuncTypes(types: function.recvTraitArgs) /> positionalArgsOpen=false assocPredicates=[] /> offset=function.defOffset />
            }
        }
    }

    fn sameDeclarationBound(a: DeclarationBoundRef, b: DeclarationBoundRef) -> Bool {
        match a {
            DeclarationBoundRef.Function(index: val left) => {
                match b { DeclarationBoundRef.Function(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.Conformance(index: val left) => {
                match b { DeclarationBoundRef.Conformance(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.TraitSubject(index: val left) => {
                match b { DeclarationBoundRef.TraitSubject(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.AssociatedType(index: val left) => {
                match b { DeclarationBoundRef.AssociatedType(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.MethodReceiver(index: val left) => {
                match b { DeclarationBoundRef.MethodReceiver(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.Requirement(index: val left) => {
                match b { DeclarationBoundRef.Requirement(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.RawRequirement(index: val left) => {
                match b { DeclarationBoundRef.RawRequirement(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.TraitDeclaration(index: val left) => {
                match b { DeclarationBoundRef.TraitDeclaration(index: val right) => { return left == right } _ => { return false } }
            }
            DeclarationBoundRef.Interface(index: val left) => {
                match b { DeclarationBoundRef.Interface(index: val right) => { return left == right } _ => { return false } }
            }
        }
    }

    // Form the semantic constraint carried by an existential once, at the
    // boundary from a lowered TypeRef.  `any Alias` must retain the resolved
    // declaration selected at the authored use site: the spelling alone is
    // neither a trait identity nor a safe conformance-query input.
    //
    // This is intentionally not a general TypeRef-to-constraint conversion.
    // Only `any P[...]` owns associated-output predicates in the current
    // surface syntax; ordinary trait uses are lowered by FuncBound/Conform
    // with their owner already canonicalized.
    inout fn existentialTraitConstraintFor(t: TypeRef) -> TraitConstraint {
        if !(t.isAny) {
            return <TraitConstraint key=<TraitInstanceKey owner=0U64 positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] />
        }
        mut val owner: U64 = 0U64
        // Visibility resolution preserves the declaration selected by the
        // authored type occurrence.  It is stronger than a later spelling
        // lookup, which would lose aliases and same-name module identity.
        if t.hasDecl { owner = t.declOffset }
        if owner == 0U64 {
            owner = self.traitOwnerAtUse(start: t.nameStart, len: t.nameLen, arity: self.positionalTraitArgs(t: t).count())
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        val names: Array[U64] = self.traitAssocArgNames(t: t)
        val values: Array[U64] = self.traitAssocArgValues(t: t)
        mut val i: U64 = 0U64
        while i < names.count() && i < values.count() {
            predicates.append(<TraitAssocPredicate member=names[i] value=values[i] span=t.siteOffset />)
            i += 1U64
        }
        return <TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=self.positionalTraitArgs(t: t) /> positionalArgsOpen=false assocPredicates=predicates />
    }

    inout fn existentialTraitConstraint(ref: U64) -> TraitConstraint {
        if ref >= self.arena.typeCount() {
            return <TraitConstraint key=<TraitInstanceKey owner=0U64 positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] />
        }
        return self.existentialTraitConstraintFor(t: self.arena.typeAt(index: ref))
    }

    // Existential interfaces carry dynamic evidence, not a static generic
    // conformance. Follow only their authored interface and supertraits.
    inout fn existentialIterationItemInBound(bound: TraitBound, visited: Array[U64] = [], requiredOwner: U64 = 0U64) -> U64 {
        val owner = bound.constraint.key.owner
        for val prior in visited { if prior == owner { return 0U64 } }
        if owner != 0U64 && (requiredOwner == 0U64 || owner == requiredOwner) && (owner == self.coreTraitOwner(name: "Iterable") || owner == self.coreTraitOwner(name: "Iterator")) {
            val item = self.internBytes(s: "Item")
            for val predicate in bound.constraint.assocPredicates {
                if predicate.member == item.nameId { return predicate.value }
            }
        }
        val index = self.decls.traitIndexByOffset(offset: owner)
        if index >= self.decls.traitCount() { return 0U64 }
        val declaration = self.decls.traitAt(index: index)
        mut val path = visited
        path.append(owner)
        mut val clause = 0U64
        while clause < declaration.supertraits.count() {
            val parent = self.traitConstraintInBound(constraint: self.semanticSupertraitConstraintAt(constraints: declaration.supertraits, index: clause), bound: bound, traitIndex: index)
            val item = self.existentialIterationItemInBound(bound: <TraitBound subject=bound.subject constraint=parent offset=bound.offset />, visited: path, requiredOwner: requiredOwner)
            if item != 0U64 { return item }
            clause += 1U64
        }
        return 0U64
    }

    inout fn existentialIterationItemTerm(receiver: U64) -> U64 {
        if receiver == 0U64 || receiver >= self.arena.typeCount() || !self.arena.typeTermAt(index: receiver).isAny { return 0U64 }
        return self.existentialIterationItemInBound(bound: <TraitBound subject=receiver constraint=self.existentialTraitConstraint(ref: receiver) offset=self.arena.typeAt(index: receiver).siteOffset />)
    }

    // A for-loop contains a second operation on the result of iterator().
    // The erased receiver's interface does not become an extra static bound
    // on that result type. Check next() under the enclosing lexical facts.
    inout fn checkExistentialIterationReceiver(receiver: U64, fnIdx: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val item = self.existentialIterationItemTerm(receiver: receiver)
        if item == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "for-loop requires an Iterable or Iterator") /> }
        val name = self.internBytes(s: "iterator")
        val slot = try self.recordAnyRequirementSlot(anyRef: receiver, nameStart: name.nameStart, nameLen: name.nameLen, args: self.pushArgs(args: []))
        if slot == 0U64 { return <Result.Ok value=() /> }
        val traitIndex = self.recordAnyTraitIndex(anyRef: receiver)
        val cursor = (try self.anyMemberRetInfo(anyRef: receiver, traitIndex: traitIndex, slot: slot - 1U64)).ref
        val owner = self.coreTraitOwner(name: "Iterator")
        mut val valid = false
        if cursor != 0U64 && cursor < self.arena.typeCount() && owner != 0U64 {
            if self.arena.typeTermAt(index: cursor).isAny {
                val cursorItem = self.existentialIterationItemInBound(bound: <TraitBound subject=cursor constraint=self.existentialTraitConstraint(ref: cursor) offset=offset />, requiredOwner: owner)
                valid = cursorItem != 0U64 && self.typeRefEq(a: cursorItem, b: item)
            } else {
                val constraint = <TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[<TraitAssocPredicate member=self.internBytes(s: "Item").nameId value=item span=offset />] />
                valid = try self.viewedTypeConformsTraitConstraint(demand: <ConformanceProofDemand.SourceAdmission />, ref: cursor, constraint: constraint, assumptions: self.functionBoundAssumptions(fnIdx: fnIdx))
            }
        }
        if !valid { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "for-loop iterator result must satisfy Iterator with the declared Item type") /> }
        return <Result.Ok value=() />
    }

    // Ground every term owned by a constraint through one explicit instance
    // map.  This is the sole substitution boundary for a bound's trait key
    // and associated-output predicates; callers must not separately ground
    // the old `traitArgs` / `traitAssocValues` arrays.
    inout fn groundTraitConstraintInEnvironment(constraint: TraitConstraint, params: Array[Bind], args: Array[U64], selfRef: U64 = 0U64) -> TraitConstraint {
        mut val positional: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.key.positionalArgs.count() {
            positional.append(self.groundTermInEnvironment(ref: constraint.key.positionalArgs[i], params: params, values: args, selfRef: selfRef))
            i += 1U64
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        i = 0U64
        while i < constraint.assocPredicates.count() {
            val predicate: TraitAssocPredicate = constraint.assocPredicates[i]
            predicates.append(<TraitAssocPredicate member=predicate.member value=self.groundTermInEnvironment(ref: predicate.value, params: params, values: args, selfRef: selfRef) span=predicate.span />)
            i += 1U64
        }
        return <TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=positional /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates />
    }

    // Conditional impls bind their receiver parameters directionally through
    // a selected witness rather than by position in the caller's type-arg
    // array.  Ground the whole constraint under that same witness map so
    // positional inputs and associated-output predicates cannot diverge.
    inout fn groundTraitConstraintThroughWitness(constraint: TraitConstraint, params: PatternBindInput, matchResult: WitnessMatch) -> Result[TraitConstraint, CompileDiagnostic] {
        mut val positional: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.key.positionalArgs.count() {
            positional.append((try self.groundWitnessTypeTerm(ref: constraint.key.positionalArgs[i], params: params, matchResult: matchResult)))
            i += 1U64
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        i = 0U64
        while i < constraint.assocPredicates.count() {
            val predicate: TraitAssocPredicate = constraint.assocPredicates[i]
            predicates.append(<TraitAssocPredicate member=predicate.member value=(try self.groundWitnessTypeTerm(ref: predicate.value, params: params, matchResult: matchResult)) span=predicate.span />)
            i += 1U64
        }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=positional /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates /> />
    }

    // A view can establish a conformance that the bare receiver does not have.
    // Keep this policy beside the constraint API, rather than asking each
    // generic-bound checker to unpack owner, positional args and predicates.
    inout fn viewedTypeConformsTraitConstraint(demand: ConformanceProofDemand, ref: U64, constraint: TraitConstraint, assumptions: Array[DeclarationBoundRef] = []) -> Result[Bool, CompileDiagnostic] {
        return <Result.Ok value=self.conformanceQueryFound(answer: (try self.queryViewedTraitConstraint(demand: demand, ref: ref, constraint: constraint, assumptions: assumptions))) />
    }

    inout fn viewedTraitConstraintProof(demand: ConformanceProofDemand, ref: U64, constraint: TraitConstraint, assumptions: Array[DeclarationBoundRef] = []) -> Result[StaticConformanceProof, CompileDiagnostic] {
        return self.requireConformanceProof(answer: (try self.queryViewedTraitConstraint(demand: demand, ref: ref, constraint: constraint, assumptions: assumptions)))
    }

    inout fn queryViewedTraitConstraint(demand: ConformanceProofDemand, ref: U64, constraint: TraitConstraint, assumptions: Array[DeclarationBoundRef] = []) -> Result[ConformanceProofResult, CompileDiagnostic] {
        if constraint.key.owner == 0U64 { return <Result.Ok value=<ConformanceProofResult.Missing /> />}
        mut val names: Array[U64] = []
        mut val values: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.assocPredicates.count() {
            names.append(constraint.assocPredicates[i].member)
            values.append(constraint.assocPredicates[i].value)
            i += 1U64
        }
        return <Result.Ok value=(try self.queryViewedTraitProof(demand: demand, ref: ref, traitStart: constraint.key.owner, traitLen: self.traitNameLenByOwner(owner: constraint.key.owner), traitArgs: constraint.key.positionalArgs, traitArgsOpen: constraint.positionalArgsOpen, assocNames: names, assocValues: values, assumptions: assumptions)) />
    }

    // Declaration-time evidence is a separate query from concrete
    // conformance lookup.  In `where Parser: Convert[T]`, the receiver is
    // not a type parameter, yet the bound is still the only static proof
    // available while T is rigid.  Keep the complete receiver and positional
    // trait instance in the match; textual trait names alone are insufficient.
    // `positionalArgsOpen` controls concrete witness matching, not whether a
    // declaration-time bound names the same symbolic trait instance, so this
    // proof match deliberately compares the resolved owner and positional
    // terms only.
    // A declaration-time receiver is established either by its own `where`
    // constraint or by a concrete/trait-path witness.  Callers such as view
    // applicability must consume this proof rather than special-case generic
    // parameter names: `x#E` is valid exactly when E's receiver constraint is
    // statically proved for x.
    inout fn staticTraitPatternProof(receiverRef: U64, traitId: U64, traitOwner: U64, traitArgs: Array[U64], patternParams: PatternBindInput) -> Result[StaticConformanceProof, CompileDiagnostic] {
        val assumptions = self.functionBoundAssumptions(fnIdx: self.cur.checkFn)
        return <Result.Ok value=(try self.traitPatternProof(demand: <ConformanceProofDemand.SourceAdmission />, baseRef: receiverRef, traitId: traitId, traitOwner: traitOwner, traitArgs: <PatternTypeInput.Values values=traitArgs />, patternParams: patternParams, assumptions: assumptions)) />
    }

    inout fn staticRequirementMatchRank(resolution: StaticMemberResolution, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        val context = try self.staticRequirementSignatureContext(resolution: resolution)
        if context.isNone() { return <Result.Ok value=0U64 /> }
        val signature = context.unwrap()
        val requirement = self.authoredRequirementViews[signature.scope].declaration
        if !self.paramsLabelsOk(params: requirement.params, args: args) { return <Result.Ok value=0U64 /> }
        val types = try self.requirementParameterTypes(signature: signature)
        mut val values: Array[U64] = []
        while values.count() < requirement.typeParams.count() { values.append(0U64) }
        return self.callableParameterTypeMatchRank(function: requirement, args: args, signatures: types, receiver: signature.bound.subject, initialValues: values)
    }

    // A tentative map contains holes, unlike a complete instance environment.
    // Substitute only known slots; zero must not erase an unbound method term.
    inout fn groundKnownCallTypeArguments(ref: U64, params: FuncBindRange, values: Array[U64], receiver: U64) -> Result[U64, CompileDiagnostic] {
        if values.count() != params.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: candidate type argument map has the wrong size") /> }
        mut val knownParams: Array[Bind] = []
        mut val knownValues: Array[U64] = []
        mut val index = 0U64
        while index < values.count() {
            if values[index] != 0U64 { knownParams.append(self.funcBindAt(binds: params, index: index)) knownValues.append(values[index]) }
            index += 1U64
        }
        return <Result.Ok value=self.groundTermInEnvironment(ref: ref, params: knownParams, values: knownValues, selfRef: receiver) />
    }

    // Ranking uses only admitted parameter slots and the candidate receiver
    // substitution. Method-owned inference remains in the argument matcher.
    inout fn providedMemberMatchRank(proof: StaticConformanceProof, traitIndex: U64, function: U64, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        val declaration = self.arena.functionAt(index: function)
        if !self.paramsLabelsOk(params: declaration.params, args: args) { return <Result.Ok value=0U64 /> }
        val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
        if bound.subject == 0U64 { return <Result.Ok value=0U64 /> }
        val parameters = self.copyFuncBinds(binds: declaration.typeParams)
        mut val values: Array[U64] = []
        while values.count() < parameters.count() { values.append(0U64) }
        mut val index = 0U64
        while index < declaration.recvTraitArgs.count() {
            if index >= bound.constraint.key.positionalArgs.count() { return <Result.Ok value=0U64 /> }
            match self.matchCallTypeArguments(pattern: self.funcTypeAt(types: declaration.recvTraitArgs, index: index), argument: bound.constraint.key.positionalArgs[index], params: declaration.typeParams, values: inout values) {
                TypeArgumentMatch.Matched | TypeArgumentMatch.Deferred => {}
                _ => { return <Result.Ok value=0U64 /> }
            }
            index += 1U64
        }
        val environment = try self.withLexicalSelfBinding(f: declaration, environment: <InstanceEnvironment params=parameters args=values receiverRef=bound.subject proof=proof />)
        val types = try self.providedSourceSignature(function: function, environment: environment, read: <CallableSignatureRead.SourceParameters />)
        return self.callableParameterTypeMatchRank(function: declaration, args: args, signatures: types.parameterTypes, receiver: bound.subject, initialValues: values)
    }

    // Canonical protocols already carry an exact admitted instance. Select
    // its requirement using the same argument rank as written member calls.
    inout fn selectStaticRequirement(proof: StaticConformanceProof, traitIdx: U64, memberId: U64, args: ArgRange) -> Result[StaticMemberResolution, CompileDiagnostic] {
        val declaration = self.decls.traitAt(index: traitIdx)
        mut val selected: StaticMemberResolution = <StaticMemberResolution.Missing />
        mut val bestRank = 0U64
        mut val index = 0U64
        while index < declaration.reqs.count() {
            val requirement = self.traitReqAt(reqs: declaration.reqs, index: index)
            if requirement.nameId == memberId {
                val candidate = <StaticMemberResolution.Requirement proof=proof traitIdx=traitIdx reqIdx=index />
                val rank = try self.staticRequirementMatchRank(resolution: candidate, args: args)
                if rank == 2U64 && bestRank == 2U64 { return <Result.Err error=self.diagnosticAt(offset: requirement.nameStart, msg: "ambiguous call: multiple trait requirements match the arguments") /> }
                if rank > bestRank {
                    selected = candidate
                    bestRank = rank
                }
            }
            index += 1U64
        }
        return <Result.Ok value=selected />
    }

    // Operator grammar supplies an exact trait owner and operand arity, not
    // an authored argument-label range. Written calls use the shared frontier.
    inout fn staticOperatorRequirement(proof: StaticConformanceProof, traitIdx: U64, memberId: U64, arity: U64) -> StaticMemberResolution {
        val trait = self.decls.traitAt(index: traitIdx)
        mut val index = 0U64
        while index < trait.reqs.count() {
            val requirement = self.traitReqAt(reqs: trait.reqs, index: index)
            if requirement.nameId == memberId && requirement.params.count() == arity { return <StaticMemberResolution.Requirement proof=proof traitIdx=traitIdx reqIdx=index /> }
            index += 1U64
        }
        return <StaticMemberResolution.Missing />
    }

    inout fn staticOperatorInSupertraits(boundRef: DeclarationBoundRef, traitIdx: U64, memberId: U64, path: Array[SupertraitRef], requiredTraitOwner: U64, arity: U64, depth: U64 = 0U64) -> Result[StaticMemberResolution, CompileDiagnostic] {
        if depth > 64U64 || traitIdx >= self.decls.traitCount() { return <Result.Ok value=<StaticMemberResolution.Missing /> /> }
        val declaration = self.decls.traitAt(index: traitIdx)
        mut val index = 0U64
        while index < declaration.supertraits.count() {
            val constraint = self.semanticSupertraitConstraintAt(constraints: declaration.supertraits, index: index)
            val target = self.decls.traitIndexByOffset(offset: constraint.key.owner)
            if target < self.decls.traitCount() {
                mut val steps = path
                steps.append(<SupertraitRef traitIndex=traitIdx boundIndex=index />)
                if constraint.key.owner == requiredTraitOwner {
                    val selected = self.staticOperatorRequirement(proof: <StaticConformanceProof.AssumedSupertraitPath source=boundRef steps=steps />, traitIdx: target, memberId: memberId, arity: arity)
                    match selected { StaticMemberResolution.Missing => {} _ => { return <Result.Ok value=selected /> } }
                }
                val inherited = try self.staticOperatorInSupertraits(boundRef: boundRef, traitIdx: target, memberId: memberId, path: steps, requiredTraitOwner: requiredTraitOwner, arity: arity, depth: depth + 1U64)
                match inherited { StaticMemberResolution.Missing => {} _ => { return <Result.Ok value=inherited /> } }
            }
            index += 1U64
        }
        return <Result.Ok value=<StaticMemberResolution.Missing /> />
    }

    // One source frontier for ordinary symbolic and associated receivers.
    // Discovery and applicability are tentative; only the exact selected
    // instance is admitted and published. No expected result ranks candidates.
    inout fn staticMemberResolution(fnIdx: U64, receiverRef: U64, nameStart: U64, nameLen: U64, args: ArgRange, requiredTraitOwner: U64 = 0U64) -> Result[StaticMemberResolution, CompileDiagnostic] {
        if receiverRef == 0U64 || receiverRef >= self.arena.typeCount() { return <Result.Ok value=<StaticMemberResolution.Missing /> /> }
        val memberId = intern(c: inout self, start: nameStart, len: nameLen)
        val assumptions = self.functionBoundAssumptions(fnIdx: fnIdx)
        // Ordinary receivers without a matching lexical premise have no
        // symbolic frontier. Concrete method lookup owns their other surfaces.
        if self.arena.typeAt(index: receiverRef).assocNameId == 0U64 {
            mut val hasPremise = false
            val receiver = self.typeRefWithoutOuterViews(ref: receiverRef)
            for source in assumptions {
                val bound = self.declarationBound(source: source)
                if bound.subject != 0U64 && self.typeRefEq(a: bound.subject, b: receiver) { hasPremise = true break }
            }
            if !hasPremise { return <Result.Ok value=<StaticMemberResolution.Missing /> /> }
        }
        mut val candidates: Array[StaticMemberResolution] = []
        mut val preferredCandidates: Array[StaticMemberResolution] = []
        mut val sourceOwners: Array[U64] = []
        for source in self.arena.typeViewSources(ref: receiverRef) { if source.traitInstance.owner != 0U64 { sourceOwners.append(source.traitInstance.owner) } }
        mut val traitIndex = 0U64
        while traitIndex < self.decls.traitCount() {
            val declaration = self.decls.traitAt(index: traitIndex)
            if requiredTraitOwner == 0U64 || declaration.nameStart == requiredTraitOwner {
                mut val requirements: Array[U64] = []
                mut val index = 0U64
                while index < declaration.reqs.count() {
                    val requirement = self.traitReqAt(reqs: declaration.reqs, index: index)
                    if requirement.nameId == memberId && self.paramsLabelsOk(params: requirement.params, args: args) { requirements.append(index) }
                    index += 1U64
                }
                mut val provided: Array[U64] = []
                index = self.arena.firstFunctionNamed(nameId: memberId)
                while index < self.arena.functionCount() {
                    val function = self.arena.functionAt(index: index)
                    if !function.isProvided && function.originTraitOwner == 0U64 && function.hasRecv && function.body != 0U64 && function.recvId == declaration.nameId && function.provTraitOwner == declaration.nameStart && self.methodIsVisible(mf: function, offset: nameStart) && self.paramsLabelsOk(params: function.params, args: args) { provided.append(index) }
                    index = self.arena.nextFunctionNamed(index: index)
                }
                if requirements.count() != 0U64 || provided.count() != 0U64 {
                    val discovered = try self.traitMemberInstanceProofs(baseRef: receiverRef, traitId: declaration.nameId, traitOwner: declaration.nameStart, assumptions: assumptions)
                    mut val proofs: Array[StaticConformanceProof] = []
                    // Put preferred paths first before instance deduplication;
                    // another path to that instance cannot erase provenance.
                    if sourceOwners.count() != 0U64 {
                        for proof in discovered { if self.traitProofMatchesSources(proof: proof, traitOwner: declaration.nameStart, sourceOwners: sourceOwners) { proofs.append(proof) } }
                    }
                    for proof in discovered { if sourceOwners.count() == 0U64 || !self.traitProofMatchesSources(proof: proof, traitOwner: declaration.nameStart, sourceOwners: sourceOwners) { proofs.append(proof) } }
                    mut val instances: Array[TraitBound] = []
                    for proof in proofs {
                        val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
                        if bound.subject == 0U64 { continue }
                        mut val duplicate = false
                        for instance in instances {
                            if instance.constraint.key.owner == bound.constraint.key.owner && self.sameResolvedTypeRefs(a: instance.constraint.key.positionalArgs, b: bound.constraint.key.positionalArgs) { duplicate = true }
                        }
                        if duplicate { continue }
                        instances.append(bound)
                        val preferred = sourceOwners.count() != 0U64 && self.traitProofMatchesSources(proof: proof, traitOwner: declaration.nameStart, sourceOwners: sourceOwners)
                        for requirement in requirements {
                            val candidate = <StaticMemberResolution.Requirement proof=proof traitIdx=traitIndex reqIdx=requirement />
                            candidates.append(candidate)
                            if preferred { preferredCandidates.append(candidate) }
                        }
                        for function in provided {
                            val candidate = <StaticMemberResolution.Provided proof=proof traitIdx=traitIndex callee=function />
                            candidates.append(candidate)
                            if preferred { preferredCandidates.append(candidate) }
                        }
                    }
                }
            }
            traitIndex += 1U64
        }
        // Views choose the source of this selector, while unrelated members
        // remain available when the selected source does not provide it.
        if preferredCandidates.count() != 0U64 { candidates = preferredCandidates }
        mut val selected: StaticMemberResolution = <StaticMemberResolution.Missing />
        mut val mismatch = false
        mut val failure: Optional[CompileDiagnostic] = <Optional.None />
        mut val found = false
        for candidate in candidates {
            val ranking = match candidate {
                StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => { give self.staticRequirementMatchRank(resolution: candidate, args: args) },
                StaticMemberResolution.Provided(proof: val proof, traitIdx: val owner, callee: val function) => { give self.providedMemberMatchRank(proof: proof, traitIndex: owner, function: function, args: args) },
                StaticMemberResolution.Missing => <Result.Ok value=0U64 />,
            }
            val rank = match ranking {
                Result.Ok(value: val rank) => rank,
                Result.Err(error: val diagnostic) => { failure = <Optional.Some v=diagnostic /> give 0U64 },
            }
            if rank == 2U64 {
                if found { return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "ambiguous call: multiple trait member instances match the arguments") /> }
                selected = candidate
                found = true
            } else if rank == 1U64 {
                mismatch = true
            }
        }
        if !found {
            match failure { Optional.Some(v: val diagnostic) => { return <Result.Err error=diagnostic /> } Optional.None => {} }
            if mismatch { return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "type mismatch: no trait member matches these arguments") /> }
            return <Result.Ok value=<StaticMemberResolution.Missing /> />
        }
        return self.admitStaticMemberInstance(resolution: selected, receiverRef: receiverRef, assumptions: assumptions)
    }

    inout fn admitStaticMemberInstance(resolution: StaticMemberResolution, receiverRef: U64, assumptions: Array[DeclarationBoundRef]) -> Result[StaticMemberResolution, CompileDiagnostic] {
        val traitIndex = match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: _) => owner,
            StaticMemberResolution.Provided(proof: _, traitIdx: val owner, callee: _) => owner,
            StaticMemberResolution.Missing => { return <Result.Ok value=resolution /> },
        }
        val original = match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: _, reqIdx: _) => proof,
            StaticMemberResolution.Provided(proof: val proof, traitIdx: _, callee: _) => proof,
            StaticMemberResolution.Missing => <StaticConformanceProof.Missing />,
        }
        val bound = try self.staticProofBound(proof: original, traitIdx: traitIndex)
        val declaration = self.decls.traitAt(index: traitIndex)
        val proof = try self.traitPatternProof(demand: <ConformanceProofDemand.SourceAdmission />, baseRef: receiverRef, traitId: declaration.nameId, traitOwner: declaration.nameStart, traitArgs: <PatternTypeInput.Values values=bound.constraint.key.positionalArgs />, patternParams: <PatternBindInput.Values values=[] />, assumptions: assumptions)
        if self.proofIsMissing(proof: proof) { return <Result.Ok value=<StaticMemberResolution.Missing /> /> }
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: val requirement) => { return <Result.Ok value=<StaticMemberResolution.Requirement proof=proof traitIdx=owner reqIdx=requirement /> /> }
            StaticMemberResolution.Provided(proof: _, traitIdx: val owner, callee: val function) => { return <Result.Ok value=<StaticMemberResolution.Provided proof=proof traitIdx=owner callee=function /> /> }
            StaticMemberResolution.Missing => { return <Result.Ok value=resolution /> }
        }
    }

    // Operator syntax has no written argument labels, yet it is still a
    // source-level call to one fixed trait requirement.  Do not manufacture an
    // ArgRange merely to reuse `staticMemberResolution`: that would append
    // transient AST payload while answering a pure type query.  Its arity is
    // part of the operator grammar, so this is the same proof-backed selection
    // with the only applicable call shape stated explicitly.
    inout fn staticOperatorResolution(fnIdx: U64, receiverRef: U64, traitName: String, memberName: String, arity: U64, traitArity: U64 = 0U64) -> Result[StaticMemberResolution, CompileDiagnostic] {
        val targetOwner: U64 = self.coreTraitOwner(name: traitName, arity: traitArity)
        if targetOwner == 0U64 { return <Result.Ok value=<StaticMemberResolution.Missing /> />}
        val memberId: U64 = self.internBytes(s: memberName).nameId
        val assumptions = self.functionBoundAssumptions(fnIdx: fnIdx)
        mut val i: U64 = 0U64
        while i < assumptions.count() {
            val bound = self.declarationBound(source: assumptions[i])
            if bound.subject != 0U64 && self.typeRefEq(a: bound.subject, b: self.typeRefWithoutOuterViews(ref: receiverRef)) {
                if bound.constraint.key.owner == targetOwner {
                    val proof: StaticConformanceProof = <StaticConformanceProof.AssumedBound source=assumptions[i] />
                    match proof {
                        StaticConformanceProof.AssumedBound(source: _) => {
                            mut val ti: U64 = 0U64
                            while ti < self.decls.traitCount() {
                                val traitDef: TraitDef = self.decls.traitAt(index: ti)
                                if traitDef.nameStart == bound.constraint.key.owner && self.traitArityMatches(actual: traitDef.typeParams.count(), expected: bound.constraint.key.positionalArgs.count()) {
                                    mut val ri: U64 = 0U64
                                    while ri < traitDef.reqs.count() {
                                        val req: Func = self.traitReqAt(reqs: traitDef.reqs, index: ri)
                                        if req.nameId == memberId && req.params.count() == arity {
                                            return <Result.Ok value=<StaticMemberResolution.Requirement proof=proof traitIdx=ti reqIdx=ri /> />
                                        }
                                        ri += 1U64
                                    }
                                }
                                ti += 1U64
                            }
                        }
                        _ => {}
                    }
                }
            }
            i += 1U64
        }
        // Reuse the member resolver's supertrait path, retaining the
        // authored bound as evidence rather than inventing a direct bound.
        i = 0U64
        while i < assumptions.count() {
            val bound = self.declarationBound(source: assumptions[i])
            if bound.subject != 0U64 && self.typeRefEq(a: bound.subject, b: self.typeRefWithoutOuterViews(ref: receiverRef)) {
                match <StaticConformanceProof.AssumedBound source=assumptions[i] /> {
                    StaticConformanceProof.AssumedBound(source: val boundRef) => {
                        mut val ti: U64 = 0U64
                        while ti < self.decls.traitCount() {
                            val traitDef: TraitDef = self.decls.traitAt(index: ti)
                            if traitDef.nameStart == bound.constraint.key.owner && self.traitArityMatches(actual: traitDef.typeParams.count(), expected: bound.constraint.key.positionalArgs.count()) {
                                val inherited: StaticMemberResolution = (try self.staticOperatorInSupertraits(boundRef: boundRef, traitIdx: ti, memberId: memberId, path: [], requiredTraitOwner: targetOwner, arity: arity))
                                match inherited {
                                    StaticMemberResolution.Missing => {}
                                    _ => { return <Result.Ok value=inherited />}
                                }
                            }
                            ti += 1U64
                        }
                    }
                    _ => {}
                }
            }
            i += 1U64
        }
        return <Result.Ok value=<StaticMemberResolution.Missing /> />
    }

    // The selected trait owns Self independently of the caller's receiver.
    // Substitute that binder along with positional arguments at every depth.
    inout fn substituteTraitTypeTerm(ref: U64, parameters: TraitBindRange, selfParamId: U64, receiverRef: U64, traitArgs: Array[U64]) -> U64 {
        mut val params: Array[Bind] = self.copyTraitBinds(binds: parameters)
        mut val values: Array[U64] = traitArgs
        if selfParamId != 0U64 {
            val selfName: Bind = self.kwSpan(kw: "Self", kwLen: 4U64)
            params.append(<Bind nameStart=selfName.nameStart nameLen=selfName.nameLen nameId=selfName.nameId paramId=selfParamId fieldStart=0U64 fieldLen=0U64 />)
            values.append(receiverRef)
        }
        return self.groundTermInEnvironment(ref: ref, params: params, values: values, selfRef: receiverRef)
    }



    inout fn traitBoundTypeTerm(ref: U64, bound: TraitBound, traitIndex: U64, includeInherited: Bool = true) -> U64 {
        return self.traitBoundTypeTermInShape(ref: ref, bound: bound, shape: self.traitBoundShape(declaration: self.decls.traitAt(index: traitIndex)), includeInherited: includeInherited)
    }


    inout fn traitConstraintInBound(constraint: TraitConstraint, bound: TraitBound, traitIndex: U64, includeInherited: Bool = true) -> TraitConstraint {
        return self.traitConstraintInShape(constraint: constraint, bound: bound, shape: self.traitBoundShape(declaration: self.decls.traitAt(index: traitIndex)), includeInherited: includeInherited)
    }


    fn missingTraitBound() -> TraitBound {
        return <TraitBound subject=0U64 constraint=<TraitConstraint key=<TraitInstanceKey owner=0U64 positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] /> offset=0U64 />
    }

    inout fn assumedSupertraitBound(source: DeclarationBoundRef, steps: Array[SupertraitRef]) -> TraitBound {
        if !self.declarationBoundIsValid(source: source) { return self.missingTraitBound() }
        return self.supertraitBoundThroughSteps(root: self.declarationBound(source: source), steps: steps)
    }

    // Substitute each edge in its declaring bound, then normalize its
    // instance in the full lexical premise. A sibling of that edge can
    // establish an equation needed by its positional arguments.
    inout fn supertraitBoundThroughSteps(root: TraitBound, steps: Array[SupertraitRef], normalizeInstance: Bool = true) -> TraitBound {
        mut val bound = root
        for val step in steps {
            if step.traitIndex >= self.decls.traitCount() { return self.missingTraitBound() }
            val declaration = self.decls.traitAt(index: step.traitIndex)
            if declaration.nameStart != bound.constraint.key.owner || step.boundIndex >= declaration.supertraits.count() { return self.missingTraitBound() }
            if !self.supertraitOperandAvailable(slot: declaration.supertraits.start + step.boundIndex) { return self.missingTraitBound() }
            val required = self.semanticSupertraitConstraintAt(constraints: declaration.supertraits, index: step.boundIndex)
            mut val constraint = self.traitConstraintInBound(constraint: required, bound: bound, traitIndex: step.traitIndex)
            if normalizeInstance {
                val key = constraint.key
                mut val arguments = key.positionalArgs
                for val index in 0U64..<arguments.count() {
                    val argument = arguments[index]
                    val normalized = self.normalizeBoundProjectionTerm(ref: argument, context: root, projectionPath: [])
                    if normalized != argument { arguments[index] = normalized }
                }
                constraint = <TraitConstraint key=<TraitInstanceKey owner=key.owner positionalArgs=arguments /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=constraint.assocPredicates />
            }
            bound = <TraitBound subject=bound.subject constraint=constraint offset=declaration.nameStart />
        }
        return bound
    }

    // These terms already belong to the caller's environment. Only apply
    // equations, without substituting the lexical root's binders again.
    inout fn normalizeBoundProjectionTerm(ref: U64, context: TraitBound, projectionPath: Array[U64]) -> U64 {
        if !self.arena.typeContainsAssociatedProjection(ref: ref) { return ref }
        for visited in projectionPath { if self.typeRefEq(a: ref, b: visited) { return ref } }
        mut val children: Array[U64] = []
        for index in 0U64..<self.typeTermRefChildCount(ref: ref) {
            children.append(self.normalizeBoundProjectionTerm(ref: self.typeTermRefChildRef(ref: ref, index: index), context: context, projectionPath: projectionPath))
        }
        val rebuilt = self.rebuildTypeTermChildren(ref: ref, children: children)
        val projection = self.arena.typeAt(index: rebuilt)
        if projection.assocNameId == 0U64 { return rebuilt }
        mut val next = projectionPath
        next.append(rebuilt)
        match self.traitProjectionEquality(bound: context, receiver: self.typeTermProjectionReceiver(t: projection), owner: self.associatedProjectionTraitOwner(projection: projection), arguments: projection.assocTraitArgs, member: projection.assocNameId, context: context, projectionPath: next) {
            TraitProjectionEquality.Value(term: val output, steps: _) => { return output }
            TraitProjectionEquality.Missing | TraitProjectionEquality.Conflict => { return rebuilt }
        }
    }

    inout fn conformanceTraitBound(conformance: Conform, index: U64) -> TraitBound {
        val subject = self.receiverSubjectTerm(receiver: conformance.subjectTy, traitOwner: conformance.subjectTraitOwner)
        // Positional inputs and associated outputs belong to the same
        // declaration subject. In particular Add[Self] names this conformer,
        // not an unrelated ungrounded Self in the requirement's projection.
        mut val arguments: Array[U64] = []
        for argument in self.conformanceDeclarationTargetArguments(index: index, declaration: conformance) {
            arguments.append(self.groundTermInEnvironment(ref: argument, params: [], values: [], selfRef: subject))
        }
        mut val outputs: Array[TraitAssocPredicate] = []
        mut val index = 0U64
        while index < conformance.assocBindingIds.count() {
            val binding = self.decls.assocBindings[self.conformFuncIdAt(ids: conformance.assocBindingIds, index: index)]
            outputs.append(<TraitAssocPredicate member=binding.nameId value=self.groundTermInEnvironment(ref: binding.ty, params: [], values: [], selfRef: subject) span=binding.tyStart />)
            index += 1U64
        }
        return <TraitBound subject=subject constraint=<TraitConstraint key=<TraitInstanceKey owner=conformance.traitStart positionalArgs=arguments /> positionalArgsOpen=false assocPredicates=outputs /> offset=conformance.defOffset />
    }

    inout fn conformanceDeclarationAssumptions(conformIndex: U64) -> Array[DeclarationBoundRef] {
        val conformance = self.decls.conformAt(index: conformIndex)
        mut val result = self.conformanceBoundAssumptions(bounds: conformance.bounds)
        if conformance.subjectTraitOwner != 0U64 { result.append(<DeclarationBoundRef.TraitSubject index=conformIndex />) }
        return result
    }

    // The parameter type of one requirement selected by `resolution`.
    // The trait's binders are substituted with the bound's positional instance
    // arguments before returning to the enclosing function's symbolic scope.
    // `0` means that the selected member is a provided method or otherwise has
    // no direct requirement parameter at `argIdx`; its fuller CallResolution
    // migration remains deliberately separate from this requirement slice.
    // A selected proof owns the complete trait instance. Signature consumers
    // read this projection instead of reconstructing arguments from names or
    // assuming a path's target has zero parameters.
    inout fn staticProofBound(proof: StaticConformanceProof, traitIdx: U64) -> Result[TraitBound, CompileDiagnostic] {
        if traitIdx >= self.decls.traitCount() { return <Result.Ok value=self.missingTraitBound() /> }
        val traitDef = self.decls.traitAt(index: traitIdx)
        mut val bound = self.missingTraitBound()
        match proof {
            StaticConformanceProof.AssumedBound(source: val source) => {
                if self.declarationBoundIsValid(source: source) { bound = self.declarationBound(source: source) }
            }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => {
                bound = self.assumedSupertraitBound(source: source, steps: steps)
            }
            StaticConformanceProof.TraitSelf(traitIdx: val owner, receiverRef: val receiver, traitArgs: val arguments) => {
                if owner == traitIdx {
                    bound = <TraitBound subject=receiver constraint=<TraitConstraint key=<TraitInstanceKey owner=traitDef.nameStart positionalArgs=arguments /> positionalArgsOpen=false assocPredicates=[] /> offset=traitDef.nameStart />
                }
            }
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                if witness.conformIdx != 0U64 && witness.conformIdx <= self.decls.conformCount() {
                    val conform = self.decls.conformAt(index: witness.conformIdx - 1U64)
                    if conform.traitStart != traitDef.nameStart { return <Result.Ok value=self.missingTraitBound() /> }
                    mut val receiver = witness.selfRef
                    if receiver == 0U64 { receiver = try self.groundWitnessTypeTerm(ref: conform.subjectTy, params: <PatternBindInput.Conformance range=conform.typeParams />, matchResult: witness) }
                    bound = <TraitBound subject=receiver constraint=<TraitConstraint key=<TraitInstanceKey owner=conform.traitStart positionalArgs=(try self.groundedWitnessTraitArgs(cf: conform, witness: witness)) /> positionalArgsOpen=false assocPredicates=[] /> offset=conform.defOffset />
                }
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: _) => {
                return self.staticPathBound(edges: edges, traitIdx: traitIdx)
            }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                bound = try self.staticPathBound(edges: edges, traitIdx: traitIdx)
                if bound.subject == 0U64 { bound = self.assumedSupertraitBound(source: source, steps: steps) }
            }
            StaticConformanceProof.Missing => {}
        }
        if bound.constraint.key.owner != traitDef.nameStart || bound.constraint.key.positionalArgs.count() != traitDef.typeParams.count() {
            return <Result.Ok value=self.missingTraitBound() />
        }
        return <Result.Ok value=bound />
    }

    inout fn mergeTraitProjectionEquality(selected: TraitProjectionEquality, candidate: TraitProjectionEquality) -> TraitProjectionEquality {
        match selected {
            TraitProjectionEquality.Conflict => { return selected }
            TraitProjectionEquality.Missing => { return candidate }
            TraitProjectionEquality.Value(term: val value, steps: _) => {
                match candidate {
                    TraitProjectionEquality.Missing => { return selected }
                    TraitProjectionEquality.Conflict => { return candidate }
                    TraitProjectionEquality.Value(term: val other, steps: _) => {
                        if self.typeRefEq(a: value, b: other) { return selected }
                        return <TraitProjectionEquality.Conflict />
                    }
                }
            }
        }
    }

    // Read only equalities entailed by this authored bound and its parents.
    // Traversing a constraint substitutes its declaring trait's binders; it
    // does not search concrete implementations or create a static witness.
    inout fn traitProjectionEquality(bound: TraitBound, receiver: U64, owner: U64, arguments: Array[U64], member: U64, context: TraitBound, projectionPath: Array[U64], path: Array[U64] = [], retainPath: Bool = false, steps: Array[SupertraitRef] = [], sourceOwners: Array[U64] = []) -> TraitProjectionEquality {
        if !self.typeRefEq(a: bound.subject, b: receiver) { return <TraitProjectionEquality.Missing /> }
        for visited in path { if visited == bound.constraint.key.owner { return <TraitProjectionEquality.Missing /> } }
        val traitIndex = self.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
        if retainPath && traitIndex >= self.decls.traitCount() { return <TraitProjectionEquality.Missing /> }
        val available = self.availableTraitBoundShape(owner: bound.constraint.key.owner)
        if available.isNone() { return <TraitProjectionEquality.Missing /> }
        val declaration = available.unwrap()
        mut val selected = <TraitProjectionEquality.Missing />
        mut val sourceMatches = sourceOwners.count() == 0U64
        for sourceOwner in sourceOwners {
            if sourceOwner == owner { sourceMatches = true }
            for visited in path { if sourceOwner == visited { sourceMatches = true } }
        }
        if bound.constraint.key.owner == owner && sourceMatches {
            mut val normalizedArguments: Array[U64] = []
            for argument in bound.constraint.key.positionalArgs {
                normalizedArguments.append(self.normalizeBoundProjectionTerm(ref: argument, context: context, projectionPath: projectionPath))
            }
            for predicate in bound.constraint.assocPredicates {
                if predicate.member == member && self.sameResolvedTypeRefs(a: normalizedArguments, b: arguments) {
                    val value = self.normalizeBoundProjectionTerm(ref: predicate.value, context: context, projectionPath: projectionPath)
                    selected = self.mergeTraitProjectionEquality(selected: selected, candidate: <TraitProjectionEquality.Value term=value steps=steps />)
                }
            }
        }
        if declaration.supertraits.count() == 0U64 { return selected }
        mut val nextPath = path
        nextPath.append(bound.constraint.key.owner)
        mut val index = 0U64
        while index < declaration.supertraits.count() {
            if !self.supertraitOperandAvailable(slot: declaration.supertraits.start + index) { index += 1U64 continue }
            // Preparing this edge uses only its source environment. Recursing
            // into inherited normalization here would re-enter this traversal.
            val constraint = self.traitConstraintInShape(constraint: self.semanticSupertraitConstraintAt(constraints: declaration.supertraits, index: index), bound: bound, shape: declaration, includeInherited: false)
            val parent = <TraitBound subject=bound.subject constraint=constraint offset=bound.offset />
            mut val nextSteps = steps
            if retainPath { nextSteps.append(<SupertraitRef traitIndex=traitIndex boundIndex=index />) }
            selected = self.mergeTraitProjectionEquality(selected: selected, candidate: self.traitProjectionEquality(bound: parent, receiver: receiver, owner: owner, arguments: arguments, member: member, context: context, projectionPath: projectionPath, path: nextPath, retainPath: retainPath, steps: nextSteps, sourceOwners: sourceOwners))
            index += 1U64
        }
        return selected
    }

    // A provided copy can have a source-trait receiver while its body belongs
    // to the path's target. Project the requested declaration from the retained
    // path; the terminal edge alone is not the receiver's complete evidence.
    inout fn staticPathBound(edges: Array[WitnessMatch], traitIdx: U64) -> Result[TraitBound, CompileDiagnostic] {
        for edge in edges {
            val bound = try self.staticProofBound(proof: <StaticConformanceProof.ConcreteWitness witness=edge />, traitIdx: traitIdx)
            if bound.subject != 0U64 { return <Result.Ok value=bound /> }
        }
        return <Result.Ok value=self.missingTraitBound() />
    }

    inout fn staticRequirementParamType(resolution: StaticMemberResolution, args: ArgRange, argIdx: U64) -> Result[U64, CompileDiagnostic] {
        val context = try self.staticRequirementSignatureContext(resolution: resolution)
        if context.isNone() { return <Result.Ok value=0U64 /> }
        val signature = context.unwrap()
        val requirement = self.authoredRequirementViews[signature.scope].declaration
        val parameter = self.paramIndexForArg(params: requirement.params, args: args, argIdx: argIdx)
        return self.requirementParameterTypeAt(signature: signature, index: parameter)
    }

    inout fn staticRequirementParamTypeAt(resolution: StaticMemberResolution, paramIdx: U64) -> Result[U64, CompileDiagnostic] {
        val context = try self.staticRequirementSignatureContext(resolution: resolution)
        if context.isNone() { return <Result.Ok value=0U64 /> }
        return self.requirementParameterTypeAt(signature: context.unwrap(), index: paramIdx)
    }

    // Trait instance substitution and method binder substitution are distinct.
    // The latter belongs to this call, including associated projections rooted
    // in a method parameter (for example Output.Error).
    inout fn staticRequirementCallArguments(resolution: StaticMemberResolution, args: ArgRange) -> Result[Array[U64], CompileDiagnostic] {
        val context = try self.staticRequirementSignatureContext(resolution: resolution)
        if context.isNone() { return <Result.Ok value=[] /> }
        val signature = context.unwrap()
        val requirement = self.authoredRequirementViews[signature.scope].declaration
        val types = try self.requirementParameterTypes(signature: signature)
        return self.inferFnArgs(f: requirement, args: args, parameterTypes: types)
    }

    inout fn staticRequirementCallResultType(resolution: StaticMemberResolution, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        val context = try self.staticRequirementSignatureContext(resolution: resolution)
        if context.isNone() { return <Result.Ok value=0U64 /> }
        val signature = context.unwrap()
        val declaration = self.authoredRequirementViews[signature.scope].declaration
        val result = try self.readStaticRequirementResult(signature: signature)
        if declaration.typeParams.count() == 0U64 { return <Result.Ok value=result /> }
        val types = try self.requirementParameterTypes(signature: signature)
        val arguments = try self.inferFnArgs(f: declaration, args: args, parameterTypes: types)
        val environment = <InstanceEnvironment params=self.copyFuncBinds(binds: declaration.typeParams) args=arguments />
        return self.groundTermForBody(ref: result, environment: environment, selfRef: 0U64, itemRef: 0U64)
    }

    inout fn staticRequirementResultType(resolution: StaticMemberResolution) -> Result[U64, CompileDiagnostic] {
        val context = try self.staticRequirementSignatureContext(resolution: resolution)
        if context.isNone() { return <Result.Ok value=0U64 /> }
        return self.readStaticRequirementResult(signature: context.unwrap())
    }

    // A view is an unordered source set.  Bounds may use any active extension
    // source to establish the requested conformance; the trait selector itself
    // is already validated as singular when the TypeRef/value view is formed.
    fn conformanceQueryFound(answer: ConformanceProofResult) -> Bool {
        return match answer {
            ConformanceProofResult.Found(proof: _) => true,
            ConformanceProofResult.Missing | ConformanceProofResult.Ambiguous(owner: _, demand: _, selectedSource: _) => false,
        }
    }

    inout fn viewedTypeConforms(demand: ConformanceProofDemand, ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = [], assumptions: Array[DeclarationBoundRef] = []) -> Result[Bool, CompileDiagnostic] {
        return <Result.Ok value=self.conformanceQueryFound(answer: (try self.queryViewedTraitProof(demand: demand, ref: ref, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions))) />
    }

    inout fn queryViewedTraitProof(demand: ConformanceProofDemand, ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = [], assumptions: Array[DeclarationBoundRef] = []) -> Result[ConformanceProofResult, CompileDiagnostic] {
        if ref == 0U64 || ref >= self.arena.typeCount() || traitStart == 0U64 || self.traitNameLenByOwner(owner: traitStart) != traitLen { return <Result.Ok value=<ConformanceProofResult.Missing /> /> }
        // Projection closure belongs to this query's explicit premises, not
        // the body cursor. Otherwise an opaque interface promise can silently
        // be replaced by a concrete implementation of its fixed receiver.
        val resolved = if self.arena.typeAt(index: ref).assocNameId != 0U64 {
            give try self.closeBodyProjectionTerms(ref: ref, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64, assumptions: assumptions)
        } else { give try self.resolveTy(tyRef: ref) }
        val proof = (try self.queryTraitPatternProof(demand: demand, baseRef: resolved, traitId: 0U64, traitOwner: traitStart, traitArgs: <PatternTypeInput.Values values=traitArgs />, patternParams: <PatternBindInput.Values values=[] />, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions))
        return <Result.Ok value=proof />
    }

    // Completeness belongs to one selected impl, not every same-named
    // associated type on its receiver (Add.Output and Pow.Output may differ).
    // Compare requirement types in the implementation's binder environment.
    // Method binder spelling is immaterial; conformance binders remain rigid.
    inout fn conformanceParameterTypesMatch(cf: Conform, conformanceIndex: U64, witness: Func, requirement: Func, parameters: FuncParamRange) -> Bool {
        if parameters.count() != requirement.params.count() || witness.typeParams.count() != cf.typeParams.count() + requirement.typeParams.count() { return false }
        val traitIndex = self.resolveTraitDef(cf: cf)
        if traitIndex >= self.decls.traitCount() { return false }
        val bound = self.conformanceTraitBound(conformance: cf, index: conformanceIndex)
        mut val arguments: Array[U64] = []
        mut val index = 0U64
        while index < requirement.typeParams.count() {
            val parameter = self.funcBindAt(binds: witness.typeParams, index: cf.typeParams.count() + index)
            arguments.append(self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen paramId=parameter.paramId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />))
            index += 1U64
        }
        val binders = self.copyFuncBinds(binds: requirement.typeParams)
        index = 0U64
        while index < parameters.count() {
            val actual = self.funcParamAt(params: parameters, index: index)
            val expected = self.funcParamAt(params: requirement.params, index: index)
            if actual.noLabel != expected.noLabel || (!expected.noLabel && actual.nameId != expected.nameId) { return false }
            val expectedType = self.groundTermInEnvironment(ref: self.traitBoundTypeTerm(ref: expected.ty, bound: bound, traitIndex: traitIndex), params: binders, values: arguments)
            val actualType = self.traitBoundTypeTerm(ref: self.groundTermInEnvironment(ref: actual.ty, params: [], values: [], selfRef: bound.subject), bound: bound, traitIndex: traitIndex)
            if !self.typeRefEq(a: expectedType, b: actualType) { return false }
            index += 1U64
        }
        return true
    }

    inout fn resolveTraitDef(cf: Conform) -> U64 {
        mut val ti: U64 = 0
        while ti < self.decls.traitCount() {
            val t: TraitDef = self.decls.traitAt(index: ti)
            // `Conform.traitStart` is the declaration owner selected while
            // lowering the authored `as Trait` occurrence.  Do not recover a
            // trait from spelling/arity here: same-spelling declarations may
            // have different requirements.
            if t.nameStart == cf.traitStart { return ti }
            ti += 1
        }
        return self.decls.traitCount()
    }

    inout fn checkAnyFormation() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.arena.typeCount() {
            try self.checkAnyTypeFormation(ref: index)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkAnyTypeFormation(ref: U64) -> Result[(), CompileDiagnostic] {
        val t: TypeRef = self.arena.typeAt(index: ref)
        if t.isAny {
            val tri: U64 = self.recordAnyTraitIndex(anyRef: ref)
            if tri < self.decls.traitCount() {
                val tr: TraitDef = self.decls.traitAt(index: tri)
                // count positional bindings (argLabels entry 0 / absent).
                mut val positional: U64 = 0
                mut val ai: U64 = 0
                while ai < t.args.count() {
                    mut val lbl: U64 = 0
                    if ai < t.argLabels.count() {
                        lbl = t.argLabels[ai]
                    }
                    if lbl == 0U64 {
                        positional += 1U64
                    }
                    ai += 1
                }
                // each type parameter is bound positionally or by name.
                mut val tpi: U64 = 0
                mut val posNeed: U64 = 0
                while tpi < tr.typeParams.count() {
                    if !(self.anyHasNamedBinding(t: t, nameId: self.traitBindAt(binds: tr.typeParams, index: tpi).nameId)) {
                        posNeed += 1U64
                    }
                    tpi += 1
                }
                if positional < posNeed {
                    return <Result.Err error=self.diagnosticAt(offset: t.nameStart, msg: "`any P` leaves a type parameter unbound — bind all of the trait's type arguments (spec/08)") />
                }
                // each associated type must be bound by name.
                mut val asi: U64 = 0
                while asi < tr.assocTypes.count() {
                    if !(self.anyHasNamedBinding(t: t, nameId: self.traitBindAt(binds: tr.assocTypes, index: asi).nameId)) {
                        return <Result.Err error=self.diagnosticAt(offset: t.nameStart, msg: "`any P` leaves an associated type unbound — bind it as `any P[Item=Type]` (spec/08)") />
                    }
                    asi += 1
                }
            } else {
                return <Result.Err error=self.diagnosticAt(offset: t.nameStart, msg: "`any P` names an unknown trait — `any` exists only over a trait (spec/08)") />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn anyHasNamedBinding(t: TypeRef, nameId: U64) -> Bool {
        mut val i: U64 = 0
        while i < t.args.count() {
            if i < t.argLabels.count() {
                if t.argLabels[i] == nameId && nameId != 0U64 {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Substitute one trait declaration's associated-output and parameter
    // environment using only bindings owned by the selected conformance.
    inout fn conformanceAssociatedConstraintTerm(ref: U64, traitIndex: U64, receiver: U64, arguments: Array[U64], outputs: Array[TraitAssocPredicate]) -> U64 {
        val declaration = self.decls.traitAt(index: traitIndex)
        val reified = self.reifyBoundAssociatedTerms(ref: ref, shape: self.traitBoundShape(declaration: declaration), receiverRef: receiver, traitOwner: declaration.nameStart, traitArgs: arguments, predicates: outputs)
        return self.groundTraitRequirementType(ref: reified, traitIdx: traitIndex, receiverRef: receiver, params: self.copyTraitBinds(binds: declaration.typeParams), args: arguments)
    }

    inout fn conformanceAssociatedOutputs(conformance: Conform) -> Array[TraitAssocPredicate] {
        mut val outputs: Array[TraitAssocPredicate] = []
        mut val index = 0U64
        while index < conformance.assocBindingIds.count() {
            val binding = self.decls.assocBindings[self.conformFuncIdAt(ids: conformance.assocBindingIds, index: index)]
            val term = self.groundTermInEnvironment(ref: binding.ty, params: [], values: [], selfRef: conformance.subjectTy)
            outputs.append(<TraitAssocPredicate member=binding.nameId value=term span=binding.tyStart />)
            index += 1U64
        }
        return outputs
    }

    inout fn conformanceAssociatedDeclarationBound(conformance: Conform, conformanceIndex: U64, traitIndex: U64, clause: U64, outputs: Array[TraitAssocPredicate]) -> Result[TraitBound, CompileDiagnostic] {
        val declaration = self.decls.traitAt(index: traitIndex)
        if clause < declaration.assocBounds.start || clause - declaration.assocBounds.start >= declaration.assocBounds.len {
            return <Result.Err error=self.diagnosticAt(offset: conformance.defOffset, msg: "associated clause belongs to another trait", failureDomain: <FailureDomain.Internal />) />
        }
        val bound = self.traitAssociatedBoundAt(bounds: declaration.assocBounds, index: clause - declaration.assocBounds.start)
        mut val subject = 0U64
        mut val offset = conformance.defOffset
        for val output in outputs {
            if output.member == bound.member { subject = output.value offset = output.span }
        }
        if subject == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: conformance.defOffset, msg: "associated type required by a trait constraint is not bound") />
        }
        val targetArguments = self.conformanceDeclarationTargetArguments(index: conformanceIndex, declaration: conformance)
        mut val arguments: Array[U64] = []
        for val argument in bound.constraint.key.positionalArgs {
            val term = self.conformanceAssociatedConstraintTerm(ref: argument, traitIndex: traitIndex, receiver: conformance.subjectTy, arguments: targetArguments, outputs: outputs)
            arguments.append(term)
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        for val predicate in bound.constraint.assocPredicates {
            val term = self.conformanceAssociatedConstraintTerm(ref: predicate.value, traitIndex: traitIndex, receiver: conformance.subjectTy, arguments: targetArguments, outputs: outputs)
            predicates.append(<TraitAssocPredicate member=predicate.member value=term span=predicate.span />)
        }
        val constraint = <TraitConstraint key=<TraitInstanceKey owner=bound.constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=bound.constraint.positionalArgsOpen assocPredicates=predicates />
        return <Result.Ok value=<TraitBound subject=subject constraint=constraint offset=offset /> />
    }

    inout fn checkAssociatedBounds(conformIndex: U64, conformance: Conform, traitIndex: U64, assumptions: Array[DeclarationBoundRef]) -> Result[(), CompileDiagnostic] {
        if self.arena.hasConformanceAssociatedEvidence(conformance: conformIndex) { return <Result.Ok value=() /> }
        val declaration = self.decls.traitAt(index: traitIndex)
        mut val evidence: Array[ConformanceAssociatedEvidence] = []
        val outputs: Array[TraitAssocPredicate] = if declaration.assocBounds.len == 0U64 { give [] } else { give self.conformanceAssociatedOutputs(conformance: conformance) }
        mut val index = 0U64
        while index < declaration.assocBounds.len {
            val clause = declaration.assocBounds.start + index
            val original = try self.conformanceAssociatedDeclarationBound(conformance: conformance, conformanceIndex: conformIndex, traitIndex: traitIndex, clause: clause, outputs: outputs)
            val demand = <ConformanceProofDemand.SourceAdmission />
            mut val normalizations: Array[ProjectionNormalizationStep] = []
            try self.recordBoundInputProjectionEquations(bound: original, assumptions: assumptions, normalizations: inout normalizations, demand: demand)
            val expected = try self.replayBoundNormalizations(bound: original, normalizations: normalizations)
            val proof = try self.viewedTraitConstraintProof(demand: demand, ref: expected.subject, constraint: expected.constraint, assumptions: assumptions)
            if self.proofIsMissing(proof: proof) {
                return <Result.Err error=self.diagnosticAt(offset: original.offset, msg: "associated type does not satisfy its declared trait constraint") />
            }
            try self.recordBoundPredicateEquations(bound: original, proof: proof, assumptions: assumptions, normalizations: inout normalizations)
            try self.checkProjectionNormalizations(normalizations: normalizations, offset: original.offset, assumptions: assumptions)
            try self.checkRetainedWitnessClause(expected: expected, proof: proof, normalizations: normalizations, offset: original.offset, assumptions: assumptions)
            evidence.append(<ConformanceAssociatedEvidence clause=clause bound=original proof=self.freezeStaticConformanceProof(proof: proof) normalizations=normalizations />)
            index += 1U64
        }
        if !self.arena.publishConformanceAssociatedEvidence(conformance: conformIndex, evidence: evidence) { return <Result.Err error=self.diagnosticAt(offset: conformance.defOffset, msg: "associated constraint evidence could not be published") /> }
        return <Result.Ok value=() />
    }

    // A row and its proof can agree while both differ from the declaration.
    inout fn readConformanceAssociatedClause(conformance: U64, clause: U64) -> Result[ConformanceAssociatedEvidence, CompileDiagnostic] {
        val owner = self.decls.conformAt(index: conformance)
        val row = match self.arena.conformanceAssociatedClause(conformance: conformance, clause: clause) {
            Optional.Some(v: val row) => row,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: owner.defOffset, msg: "associated constraint has no retained declaration evidence", failureDomain: <FailureDomain.Internal />) /> },
        }
        val traitIndex = self.resolveTraitDef(cf: owner)
        if traitIndex >= self.decls.traitCount() {
            return <Result.Err error=self.diagnosticAt(offset: owner.defOffset, msg: "associated constraint has no declaration trait", failureDomain: <FailureDomain.Internal />) />
        }
        val expected = try self.conformanceAssociatedDeclarationBound(conformance: owner, conformanceIndex: conformance, traitIndex: traitIndex, clause: clause, outputs: self.conformanceAssociatedOutputs(conformance: owner))
        if !self.typeRefEq(a: row.bound.subject, b: expected.subject) || !self.sameTraitConstraint(a: row.bound.constraint, b: expected.constraint) {
            return <Result.Err error=self.diagnosticAt(offset: expected.offset, msg: "retained associated clause differs from its declared bound", failureDomain: <FailureDomain.Internal />) />
        }
        val trait = self.decls.traitIndexByOffset(offset: owner.subjectTraitOwner)
        val selfParameter = if trait < self.decls.traitCount() { give self.decls.traitAt(index: trait).selfParamId } else { give 0U64 }
        val scope = <DeclarationTypeScope origin=<DeclarationScopeOrigin.AssociatedBinding /> owner=conformance parameters=self.pushFuncBinds(binds: self.copyConformBinds(binds: owner.typeParams)) selfParameter=selfParameter />
        try self.scopedProofDependencies(proof: self.thawStaticConformanceProof(id: row.proof), scope: scope, offset: expected.offset, normalizations: row.normalizations)
        try self.scopedProjectionDependencies(equations: row.normalizations, context: row.normalizations, scope: scope, offset: expected.offset)
        return <Result.Ok value=row />
    }

    // A witness may implement a requirement for more inputs, but must not
    // require more from its callers. Publish the requirement's obligations on
    // the selected declaration so concrete calls use the normal bound checker.
    inout fn checkConformanceMethodBounds(conformIndex: U64, traitIndex: U64) -> Result[(), CompileDiagnostic] {
        val conformance = self.decls.conformAt(index: conformIndex)
        val trait = self.decls.traitAt(index: traitIndex)
        if trait.reqs.count() == 0U64 { return <Result.Ok value=() /> }
        val traitBound = self.conformanceTraitBound(conformance: conformance, index: conformIndex)
        val traitEnvironment = self.requirementSignatureEnvironment(bound: traitBound, traitIndex: traitIndex)
        mut val requirementIndex = 0U64
        while requirementIndex < trait.reqs.count() {
            val requirement = self.traitReqAt(reqs: trait.reqs, index: requirementIndex)
            mut val matched = false
            mut val witnessIndex = 0U64
            while witnessIndex < conformance.witnessFuncIds.count() {
                val functionIndex = self.conformFuncIdAt(ids: conformance.witnessFuncIds, index: witnessIndex)
                val function = self.arena.functionAt(index: functionIndex)
                if function.nameId == requirement.nameId && function.isDiverging == requirement.isDiverging && function.params.count() == requirement.params.count() && function.typeParams.count() == conformance.typeParams.count() + requirement.typeParams.count() {
                    val parameters = self.copyFuncBinds(binds: requirement.typeParams)
                    val arguments = self.conformanceRequirementMethodArguments(conformance: conformance, requirement: requirement, witness: function)
                    val scope = try self.requireAdmittedRawRequirement(traitIndex: traitIndex, slot: requirementIndex, offset: requirement.defOffset)
                    val signature = <RequirementSignatureRead scope=scope bound=traitBound evidence=<RequirementSelfEvidence.Conformance index=conformIndex /> />
                    val environment = self.conformanceRequirementEnvironment(base: traitEnvironment, parameters: parameters, arguments: arguments)
                    mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
                    if !(try self.conformanceRequirementParametersMatch(signature: signature, environment: environment, traitIndex: traitIndex, parameters: function.params, memo: inout memo)) {
                        witnessIndex += 1U64
                        continue
                    }
                    matched = true
                    if function.isFactory != requirement.isFactory || function.isAnonymousFactory != requirement.isAnonymousFactory {
                        return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "a factory requirement must be implemented by the matching factory declaration") />
                    }
                    if function.isAssoc != requirement.isAssoc || function.selfInout != requirement.selfInout || function.selfMove != requirement.selfMove || function.isAsync != requirement.isAsync {
                        return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "implementation calling convention does not match the trait requirement") />
                    }
                    mut val parameterIndex = 0U64
                    while parameterIndex < requirement.params.count() {
                        val actual = self.funcParamAt(params: function.params, index: parameterIndex)
                        val expected = self.funcParamAt(params: requirement.params, index: parameterIndex)
                        if actual.isInout != expected.isInout || actual.isMove != expected.isMove || actual.isBorrow != expected.isBorrow {
                            return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "implementation parameter ownership does not match the trait requirement") />
                        }
                        parameterIndex += 1U64
                    }
                    val expectedResult = try self.readRequirementResult(interface: signature, environment: environment, memo: inout memo)
                    val actualResult = self.traitBoundTypeTerm(ref: self.groundTermInEnvironment(ref: self.semanticCallableReturnTerm(function: function), params: [], values: [], selfRef: traitBound.subject), bound: traitBound, traitIndex: traitIndex)
                    if !self.callableResultTypesEqual(a: expectedResult, b: actualResult) {
                        if requirement.isFactory { return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "factory return type does not match the trait requirement") /> }
                        return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "implementation return type does not match the trait requirement") />
                    }
                    mut val requirementSources: Array[U64] = []
                    val clauses = try self.readRequirementBoundsInEnvironment(signature: signature, environment: environment, memo: inout memo)
                    mut val boundIndex = 0U64
                    for bound in clauses {
                        requirementSources.append(self.arena.publishRequirementBoundEvidence(evidence: <RequirementBoundEvidence conformance=conformIndex traitIndex=traitIndex requirement=requirementIndex implementation=functionIndex clause=requirement.signatureBounds.start + boundIndex bound=bound />))
                        boundIndex += 1U64
                    }
                    mut val assumptions = self.conformanceDeclarationAssumptions(conformIndex: conformIndex)
                    for source in requirementSources { assumptions.append(<DeclarationBoundRef.Requirement index=source />) }
                    mut val implementationIndices: Array[U64] = []
                    mut val implementationProofs: Array[U64] = []
                    val authoredCount = self.decls.funcBounds.count()
                    boundIndex = 0U64
                    while boundIndex < authoredCount {
                        val bound = self.decls.funcBounds.at(index: boundIndex)
                        if bound.fnIdx == functionIndex {
                            // Compare complete signatures under the same
                            // explicit receiver interpretation as results and
                            // public clauses; authored clause IDs stay intact.
                            val subject = self.traitBoundTypeTerm(ref: self.groundTermInEnvironment(ref: bound.paramTy, params: [], values: [], selfRef: traitBound.subject), bound: traitBound, traitIndex: traitIndex)
                            val constraint = self.traitConstraintInBound(constraint: self.groundTraitConstraintInEnvironment(constraint: bound.constraint, params: [], args: [], selfRef: traitBound.subject), bound: traitBound, traitIndex: traitIndex)
                            val proof = try self.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: subject, constraint: constraint, assumptions: assumptions)
                            if self.proofIsMissing(proof: proof) {
                                return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "implementation requires a trait constraint not guaranteed by the requirement") />
                            }
                            implementationIndices.append(boundIndex)
                            implementationProofs.append(self.freezeStaticConformanceProof(proof: proof))
                        }
                        boundIndex += 1U64
                    }
                    for bound in clauses {
                        if !(try self.viewedTypeConformsTraitConstraint(demand: <ConformanceProofDemand.SourceAdmission />, ref: bound.subject, constraint: bound.constraint, assumptions: self.functionBoundAssumptions(fnIdx: functionIndex))) {
                            val subject = self.arena.typeAt(index: bound.subject)
                            val proof = try self.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: bound.subject, constraint: bound.constraint, assumptions: assumptions)
                            if self.proofIsMissing(proof: proof) { return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement constraint has no retained declaration evidence") /> }
                            implementationIndices.append(self.decls.funcBounds.count())
                            implementationProofs.append(self.freezeStaticConformanceProof(proof: proof))
                            self.decls.funcBounds.append(<FuncBound fnIdx=functionIndex paramStart=subject.nameStart paramLen=subject.nameLen paramNameId=subject.nameId paramTy=bound.subject constraint=bound.constraint />)
                        }
                    }
                    if !self.arena.publishConformanceMethodEvidence(evidence: <ConformanceMethodEvidence conformance=conformIndex traitIndex=traitIndex requirement=requirementIndex implementation=functionIndex methodParameters=parameters methodArguments=arguments requirements=requirementSources indices=implementationIndices proofs=implementationProofs />) {
                        return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "implementation constraint evidence was already published or is incomplete") />
                    }
                }
                witnessIndex += 1U64
            }
            if !matched {
                return <Result.Err error=self.diagnosticAt(offset: conformance.typeStart, msg: "incomplete trait conformance: a requirement is not witnessed (define its body or bind it with `via`)") />
            }
            requirementIndex += 1U64
        }
        return <Result.Ok value=() />
    }

    // Retain the declaration's chosen parent evidence, including its impl
    // assumptions. Instantiation follows this edge rather than searching anew.
    inout fn prepareConformanceSupertraits(conformIndex: U64, traitIndex: U64) -> Result[(), CompileDiagnostic] {
        if self.arena.hasConformanceSupertraits(conformance: conformIndex) { return <Result.Ok value=() /> }
        val conformance = self.decls.conformAt(index: conformIndex)
        val traitDef = self.decls.traitAt(index: traitIndex)
        mut val evidence: Array[ConformanceSupertraitEvidence] = []
        if traitDef.supertraits.count() == 0U64 {
            if !self.arena.publishConformanceSupertraits(conformance: conformIndex, evidence: []) { return <Result.Err error=self.diagnosticAt(offset: conformance.typeStart, msg: "conformance supertrait evidence could not be published") /> }
            return <Result.Ok value=() />
        }
        val root = self.conformanceTraitBound(conformance: conformance, index: conformIndex)
        val assumptions = self.conformanceDeclarationAssumptions(conformIndex: conformIndex)
        val demand = <ConformanceProofDemand.SourceAdmission />
        mut val clause = 0U64
        while clause < traitDef.supertraits.count() {
            val required = self.semanticSupertraitConstraintAt(constraints: traitDef.supertraits, index: clause)
            val constraint = self.traitConstraintInBound(constraint: required, bound: root, traitIndex: traitIndex)
            val original = <TraitBound subject=conformance.subjectTy constraint=constraint offset=conformance.typeStart />
            mut val normalizations: Array[ProjectionNormalizationStep] = []
            try self.recordBoundInputProjectionEquations(bound: original, assumptions: assumptions, normalizations: inout normalizations, demand: demand)
            val expected = try self.replayBoundNormalizations(bound: original, normalizations: normalizations)
            val proof = try self.viewedTraitConstraintProof(demand: demand, ref: expected.subject, constraint: expected.constraint, assumptions: assumptions)
            if self.proofIsMissing(proof: proof) { return <Result.Err error=self.diagnosticAt(offset: conformance.typeStart, msg: "supertrait not satisfied: this type must also conform to the trait's supertrait") /> }
            try self.recordBoundPredicateEquations(bound: original, proof: proof, assumptions: assumptions, normalizations: inout normalizations)
            try self.checkProjectionNormalizations(normalizations: normalizations, offset: original.offset, assumptions: assumptions)
            try self.checkRetainedWitnessClause(expected: expected, proof: proof, normalizations: normalizations, offset: original.offset, assumptions: assumptions)
            evidence.append(<ConformanceSupertraitEvidence clause=traitDef.supertraits.start + clause bound=original proof=self.freezeStaticConformanceProof(proof: proof) normalizations=normalizations />)
            clause += 1U64
        }
        if !self.arena.publishConformanceSupertraits(conformance: conformIndex, evidence: evidence) { return <Result.Err error=self.diagnosticAt(offset: conformance.typeStart, msg: "conformance supertrait evidence could not be published") /> }
        return <Result.Ok value=() />
    }

    inout fn readConformanceSupertraitEvidence(conformance: U64, step: SupertraitRef) -> Result[ConformanceSupertraitEvidence, CompileDiagnostic] {
        if conformance >= self.decls.conformCount() || step.traitIndex >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "supertrait edge has an invalid declaration", failureDomain: <FailureDomain.Internal />) /> }
        val owner = self.decls.conformAt(index: conformance)
        val trait = self.decls.traitAt(index: step.traitIndex)
        if owner.traitStart != trait.nameStart || step.boundIndex >= trait.supertraits.count() { return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "supertrait edge belongs to another declaration", failureDomain: <FailureDomain.Internal />) /> }
        val row = match self.arena.conformanceSupertraitEvidence(conformance: conformance, clause: step.boundIndex) {
            Optional.Some(v: val evidence) => evidence,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "supertrait edge has no retained declaration evidence", failureDomain: <FailureDomain.Internal />) /> },
        }
        val required = self.semanticSupertraitConstraintAt(constraints: trait.supertraits, index: step.boundIndex)
        // The producer has already substituted this clause in the impl's
        // declaration environment. Verify the exact slot and its shape;
        // reinterpret only the saved terms in the selected instance.
        if row.clause != trait.supertraits.start + step.boundIndex || !self.typeRefEq(a: row.bound.subject, b: owner.subjectTy) || required.key.owner != row.bound.constraint.key.owner || required.key.positionalArgs.count() != row.bound.constraint.key.positionalArgs.count() || required.positionalArgsOpen != row.bound.constraint.positionalArgsOpen || required.assocPredicates.count() != row.bound.constraint.assocPredicates.count() || !self.arena.hasStaticConformanceProof(id: row.proof) {
            return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "retained supertrait evidence does not match its declaration", failureDomain: <FailureDomain.Internal />) />
        }
        for index in 0U64..<required.assocPredicates.count() {
            if required.assocPredicates[index].member != row.bound.constraint.assocPredicates[index].member {
                return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "retained supertrait evidence has a foreign associated member", failureDomain: <FailureDomain.Internal />) />
            }
        }
        return <Result.Ok value=row />
    }

    inout fn checkConformances() -> Result[(), CompileDiagnostic] {
        // Parent proofs are declaration-owned prerequisites of method
        // signatures. Complete their publication before comparing any method.
        for index in 0U64..<self.decls.conformCount() {
            val conformance = self.decls.conformAt(index: index)
            val traitIndex = self.decls.traitIndexByOffset(offset: conformance.traitStart)
            if traitIndex < self.decls.traitCount() {
                try self.prepareConformanceSupertraits(conformIndex: index, traitIndex: traitIndex)
            } else if !conformance.derived {
                return <Result.Err error=self.diagnosticAt(offset: conformance.traitStart, msg: "conformance to an unknown trait (is it declared / imported?)") />
            }
        }
        for index in 0U64..<self.decls.conformCount() {
            val conformance = self.decls.conformAt(index: index)
            if !conformance.derived {
                val traitIndex = self.decls.traitIndexByOffset(offset: conformance.traitStart)
                try self.checkAssociatedBounds(conformIndex: index, conformance: conformance, traitIndex: traitIndex, assumptions: self.conformanceDeclarationAssumptions(conformIndex: index))
            }
        }
        for index in 0U64..<self.decls.conformCount() {
            val conformance = self.decls.conformAt(index: index)
            if !conformance.derived {
                val traitIndex = self.decls.traitIndexByOffset(offset: conformance.traitStart)
                try self.checkConformanceMethodBounds(conformIndex: index, traitIndex: traitIndex)
            }
        }
        try self.checkViaTargets()
        return <Result.Ok value=() />
    }

    // Callable forms are synthesized before trait-subject conferral and the
    // general conformance check. Publish both kinds of declaration evidence
    // along the selected path before callable-form signature comparison.
    inout fn prepareCallableFormEvidence(conformanceIndex: U64, traitIndex: U64, prepared: inout Dictionary[U64, Bool]) -> Result[(), CompileDiagnostic] {
        if prepared.get(key: conformanceIndex).isSome() { return <Result.Ok value=() /> }
        try self.prepareConformanceSupertraits(conformIndex: conformanceIndex, traitIndex: traitIndex)
        prepared[conformanceIndex] = true
        val trait = self.decls.traitAt(index: traitIndex)
        for clause in 0U64..<trait.supertraits.count() {
            val row = self.arena.conformanceSupertraitEvidence(conformance: conformanceIndex, clause: clause)
            if row.isNone() { return <Result.Err error=self.diagnosticAt(offset: trait.nameStart, msg: "callable form lost its retained supertrait proof", failureDomain: <FailureDomain.Internal />) /> }
            val proof = self.thawStaticConformanceProof(id: row.unwrap().proof)
            match self.selectedConstraintWitness(proof: proof) {
                Optional.Some(v: val witness) => {
                    if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: trait.nameStart, msg: "callable form has an invalid parent conformance", failureDomain: <FailureDomain.Internal />) /> }
                    val parent = witness.conformIdx - 1U64
                    val parentTrait = self.resolveTraitDef(cf: self.decls.conformAt(index: parent))
                    if parentTrait >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: trait.nameStart, msg: "callable form has an invalid parent trait", failureDomain: <FailureDomain.Internal />) /> }
                    try self.prepareCallableFormEvidence(conformanceIndex: parent, traitIndex: parentTrait, prepared: inout prepared)
                }
                Optional.None => {}
            }
        }
        val conformance = self.decls.conformAt(index: conformanceIndex)
        return self.checkAssociatedBounds(conformIndex: conformanceIndex, conformance: conformance, traitIndex: traitIndex, assumptions: self.conformanceDeclarationAssumptions(conformIndex: conformanceIndex))
    }

    // Via uses the ordinary callable form, including omitted defaults, while
    // preserving the requirement's result and ownership contract.
    // Match the implementation directionally: requirement
    // binders remain rigid while the target's binders acquire one substitution.
    inout fn viaSignatureMatches(witness: Func, target: Func) -> Bool {
        if witness.hasRecv != target.hasRecv || witness.isAssoc != target.isAssoc || witness.selfInout != target.selfInout || witness.selfMove != target.selfMove || witness.isAsync != target.isAsync || witness.isDiverging != target.isDiverging {
            return false
        }
        val input = <CallableArgumentInput.Parameters range=witness.params />
        if !self.callableInputLabelsOk(params: target.params, input: input) { return false }
        mut val bindings: Array[UnifyBind] = []
        val targetParameters = <PatternBindInput.Function range=target.typeParams />
        val rigidParameters = <PatternBindInput.Values values=[] />
        if target.recvTy != 0U64 || witness.recvTy != 0U64 {
            if !self.unifyPatterns(a: target.recvTy, aSide: 0U64, b: witness.recvTy, bSide: 1U64, aParams: targetParameters, bParams: rigidParameters, binds: inout bindings) { return false }
        }
        mut val index = 0U64
        mut val targetIndex = 0U64
        while index < witness.params.count() {
            val expected = self.funcParamAt(params: witness.params, index: index)
            targetIndex = self.callableNextParameter(params: target.params, input: input, index: index, start: targetIndex)
            val actual = self.funcParamAt(params: target.params, index: targetIndex)
            targetIndex += 1U64
            if expected.noLabel != actual.noLabel || (!expected.noLabel && expected.nameId != actual.nameId) || expected.isInout != actual.isInout || expected.isMove != actual.isMove || expected.isBorrow != actual.isBorrow { return false }
            val expectedType = self.groundTermInEnvironment(ref: expected.ty, params: [], values: [], selfRef: witness.recvTy)
            val actualType = self.groundTermInEnvironment(ref: actual.ty, params: [], values: [], selfRef: witness.recvTy)
            if !self.unifyPatterns(a: actualType, aSide: 0U64, b: expectedType, bSide: 1U64, aParams: targetParameters, bParams: rigidParameters, binds: inout bindings) { return false }
            index += 1U64
        }
        val expectedResult = self.groundTermInEnvironment(ref: self.semanticCallableReturnTerm(function: witness), params: [], values: [], selfRef: witness.recvTy)
        val actualResult = self.groundTermInEnvironment(ref: self.semanticCallableReturnTerm(function: target), params: [], values: [], selfRef: witness.recvTy)
        if !(self.callableResultIsUnit(ref: expectedResult) && self.callableResultIsUnit(ref: actualResult)) && !self.unifyPatterns(a: actualResult, aSide: 0U64, b: expectedResult, bSide: 1U64, aParams: targetParameters, bParams: rigidParameters, binds: inout bindings) { return false }
        return true
    }

    inout fn checkViaTargets() -> Result[(), CompileDiagnostic] {
        for val binding in self.decls.viaWitnesses {
            val witness = self.arena.functionAt(index: binding.functionIndex)
            mut val foundName = false
            mut val foundSignature = false
            mut val index = self.decls.firstCallableNamed(nameId: binding.targetNameId)
            while index < self.decls.callableCount() {
                val candidateIndex = self.decls.callableAt(index: index).funcIdx
                val target = self.arena.functionAt(index: candidateIndex)
                if candidateIndex != binding.functionIndex && target.recvId == witness.recvId && (target.extId == 0U64 || target.extId == witness.extId) && self.methodIsVisible(mf: target, offset: witness.defOffset) {
                    foundName = true
                    if self.viaSignatureMatches(witness: witness, target: target) { foundSignature = true }
                }
                index = self.decls.nextCallableNamed(index: index)
            }
            if !foundName {
                return <Result.Err error=self.diagnosticAt(offset: witness.defOffset, msg: "`via` target is not a member of this type") />
            }
            if !foundSignature {
                return <Result.Err error=self.diagnosticAt(offset: witness.defOffset, msg: "`via` target signature does not match the declared requirement") />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn typeConformsTo(typeStart: U64, typeLen: U64, traitStart: U64, traitLen: U64) -> Bool {
        // No structural shortcut for Eq/Ord: every conformance is an explicit `impl` (spec/12,
        // operators are trait sugar). Primitives conform via their real `impl I64 as Eq`/`as
        // Ord` witnesses in Core/Num.pw, String via `impl String as Eq` in Core — all recorded
        // in the conformance table below. A type with no witness (String/Bool have no `Ord`) correctly
        // fails the bound, the same clean reject a missing struct/enum witness gives.
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.conformCount() {
            val cf: Conform = self.decls.conformAt(index: i)
            // A named extension contributes a conformance only through its
            // explicit view.  Letting it satisfy a bare bound leaks opt-in
            // meaning from `value#Ext` into plain `value`.
            if cf.extId == 0U64 && cf.typeId == qType {
                // An unparameterized spelling is the arity-zero instance,
                // never a shorthand for `Trait[...]`.
                if cf.traitStart == traitStart && cf.traitLen == traitLen && cf.traitArgs.count() == 0U64 {
                    return true
                }
            }
            i += 1
        }
        // a `newtype` inherits the underlying type's trait conformances automatically
        // (spec/10), so `UserId = String` satisfies `where T: Format` because String
        // does — `print(u)` type-checks and dispatches to the underlying's witness.
        val underlying = self.newtypeUnderRef(start: typeStart, len: typeLen)
        if underlying != 0U64 {
            val type = self.arena.typeAt(index: underlying)
            return self.typeConformsTo(typeStart: type.nameStart, typeLen: type.nameLen, traitStart: traitStart, traitLen: traitLen)
        }
        return false
    }

    // The witness fn (assoc or method) named (nameStart,nameLen) on type (typeStart,typeLen),
    // by receiver + name id — used to reach a conditional impl's `where`-bounds, which the
    // lowerer records as funcBounds on each witness fn (Lower/Impl.pw). funcs.count() = none.
    inout fn witnessFnFor(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> U64 {
        val qRecv: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = self.arena.firstFunctionNamed(nameId: qName)
        while i < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: i)
            if f.isAssoc || f.hasRecv {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return i
                    }
                }
            }
            i = self.arena.nextFunctionNamed(index: i)
        }
        return self.arena.functionCount()
    }

    // Boolean projection of the canonical source-witness proof query. Bare
    // conformance excludes outer views; each source condition is checked under
    // its own witness substitution, including trait-subject path conditions.
    inout fn conformsInstance(demand: ConformanceProofDemand, ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = []) -> Result[Bool, CompileDiagnostic] {
        return <Result.Ok value=(try self.viewedTypeConforms(demand: demand, ref: ref, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues)) />
    }

    inout fn typeConformsToName(typeStart: U64, typeLen: U64, traitName: String) -> Bool {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.conformCount() {
            val cf: Conform = self.decls.conformAt(index: i)
            if cf.typeId == qType {
                if rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: traitName) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // The `where` bounds of one fully-grounded body instance. Call finalization
    // invokes this before the instance enters the semantic worklist, so every
    // emitted generic body is checked by the same path regardless of whether
    // its substitutions came from arguments, a receiver, or an expected result.
    // The same closed callable constraint is checked whether selected during
    // declaration analysis or demanded later by executable discovery.
    inout fn groundCallableBound(bound: TraitBound, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[TraitBound, CompileDiagnostic] {
        val subject = try self.groundTermForBody(ref: bound.subject, environment: environment, selfRef: selfRef, itemRef: itemRef)
        mut val arguments: Array[U64] = []
        for argument in bound.constraint.key.positionalArgs {
            arguments.append((try self.groundTermForBody(ref: argument, environment: environment, selfRef: selfRef, itemRef: itemRef)))
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        for predicate in bound.constraint.assocPredicates {
            predicates.append(<TraitAssocPredicate member=predicate.member value=(try self.groundTermForBody(ref: predicate.value, environment: environment, selfRef: selfRef, itemRef: itemRef)) span=predicate.span />)
        }
        return <Result.Ok value=<TraitBound subject=subject constraint=<TraitConstraint key=<TraitInstanceKey owner=bound.constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=bound.constraint.positionalArgsOpen assocPredicates=predicates /> offset=bound.offset /> />
    }

    inout fn groundCallableSignatureBounds(fnIdx: U64, environment: InstanceEnvironment) -> Result[Array[TraitBound], CompileDiagnostic] {
        mut val bounds: Array[TraitBound] = []
        if self.arena.functionAt(index: fnIdx).isProvided && self.isAuthoredProvidedDeclaration(function: fnIdx) {
            val admitted = try self.providedSignatureAdmission(function: fnIdx)
            for bound in (try self.readProvidedSignatureBounds(admitted: admitted, environment: environment)) {
                bounds.append(try self.groundCallableBound(bound: bound, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64))
            }
            return <Result.Ok value=bounds />
        }
        for index in self.sourceDeclarationCallBoundIndices(functionIndex: fnIdx) {
            val bound = self.decls.funcBounds.at(index: index)
            bounds.append((try self.groundCallableBound(bound: <TraitBound subject=bound.paramTy constraint=bound.constraint offset=bound.paramStart />, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)))
        }
        return <Result.Ok value=bounds />
    }

    inout fn checkSelectedCallableBounds(fnIdx: U64, environment: InstanceEnvironment, assumptions: Array[DeclarationBoundRef] = []) -> Result[(), CompileDiagnostic] {
        for bound in (try self.groundCallableSignatureBounds(fnIdx: fnIdx, environment: environment)) {
            if !(try self.viewedTypeConformsTraitConstraint(demand: <ConformanceProofDemand.SourceAdmission />, ref: bound.subject, constraint: bound.constraint, assumptions: assumptions)) {
                return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "type argument does not conform to the trait required by `where`") />
            }
        }
        return <Result.Ok value=() />
    }

    // Translate public requirement evidence through the declaration's retained
    // entailment. Clause identities, not implementation array positions, bind it.
    inout fn instantiateRequirementCallConstraints(fnIdx: U64, environment: InstanceEnvironment, planIndex: U64, bounds: Array[TraitBound], proofs: Array[StaticConformanceProof], normalizations: Array[ProjectionNormalizationStep] = []) -> Result[CallableConstraintEvidence, CompileDiagnostic] {
        if planIndex >= self.arena.conformanceMethodEvidenceCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "requirement call has no retained implementation evidence") /> }
        val plan = self.arena.conformanceMethodEvidenceAt(index: planIndex)
        val function = self.arena.functionAt(index: fnIdx)
        val implementation = if function.sourceWitnessFuncId != 0U64 { give function.sourceWitnessFuncId - 1U64 } else { give fnIdx }
        val witness = self.proofWitnessForTrait(proof: environment.proof, traitIdx: plan.traitIndex)
        if implementation != plan.implementation || witness.conformIdx != plan.conformance + 1U64 {
            return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement evidence belongs to another implementation") />
        }
        val scope = try self.requireAdmittedRawRequirement(traitIndex: plan.traitIndex, slot: plan.requirement, offset: function.defOffset)
        val requirement = self.authoredRequirementViews[scope].declaration
        if bounds.count() != requirement.signatureBounds.len || proofs.count() != bounds.count() || plan.requirements.count() != bounds.count() {
            return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement call has incomplete public constraint evidence") />
        }
        mut val expectedBounds: Array[TraitBound] = []
        if bounds.count() != 0U64 {
            // Conformance admission retained the alpha map from the original
            // requirement's method binders to the implementation's terms.
            if plan.methodParameters.count() != requirement.typeParams.count() || plan.methodArguments.count() != plan.methodParameters.count() {
                return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement evidence has an incomplete method substitution") />
            }
            for position in 0U64..<plan.methodParameters.count() {
                if plan.methodParameters[position].paramId != self.funcBindAt(binds: requirement.typeParams, index: position).paramId {
                    return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement evidence has a foreign method substitution") />
                }
            }
            val selection = <StaticMemberResolution.Requirement proof=environment.proof traitIdx=plan.traitIndex reqIdx=plan.requirement />
            val context = try self.staticRequirementSignatureContext(resolution: selection)
            if context.isNone() { return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement evidence has no selected clause environment") /> }
            expectedBounds = try self.readRequirementBounds(signature: context.unwrap(), methodArguments: plan.methodArguments)
        }
        try self.checkProjectionNormalizations(normalizations: normalizations, offset: function.defOffset)
        mut val sources: Array[DeclarationBoundRef] = []
        mut val publicProofs: Array[U64] = []
        mut val publicBounds: Array[TraitBound] = []
        for index in plan.requirements {
            val source = self.arena.requirementBoundEvidenceAt(index: index)
            if source.clause < requirement.signatureBounds.start || source.clause - requirement.signatureBounds.start >= requirement.signatureBounds.len {
                return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "requirement evidence has a foreign clause identity") />
            }
            val position = source.clause - requirement.signatureBounds.start
            val substituted = self.substituteRetainedBound(bound: expectedBounds[position], environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
            val expected = try self.replayBoundNormalizations(bound: substituted, normalizations: normalizations)
            if !self.typeRefEq(a: expected.subject, b: bounds[position].subject) || !self.sameTraitConstraint(a: expected.constraint, b: bounds[position].constraint) {
                return <Result.Err error=self.diagnosticAt(offset: source.bound.offset, msg: "requirement evidence has a different public substitution") />
            }
            try self.checkRetainedWitnessClause(expected: expected, proof: proofs[position], normalizations: normalizations, offset: source.bound.offset)
            sources.append(<DeclarationBoundRef.Requirement index=index />)
            publicProofs.append(self.freezeStaticConformanceProof(proof: proofs[position]))
            publicBounds.append(expected)
        }
        val bindings = self.arena.prepareDeclarationConstraints(function: implementation, environment: environment, sources: sources, bounds: publicBounds, proofs: publicProofs)
        val derivation = <InstanceEnvironment params=environment.params args=environment.args receiverRef=environment.receiverRef proof=environment.proof constraints=<Optional.Some v=bindings /> />
        mut val implementationBounds: Array[TraitBound] = []
        mut val implementationProofs: Array[StaticConformanceProof] = []
        for index in self.sourceDeclarationCallBoundIndices(functionIndex: fnIdx) {
            mut val position = 0U64
            while position < plan.indices.count() && plan.indices[position] != index { position += 1U64 }
            if position >= plan.indices.count() { return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "implementation bound has no retained requirement derivation") /> }
            val declaration = self.decls.funcBounds.at(index: index)
            val bound = try self.groundCallableBound(bound: <TraitBound subject=declaration.paramTy constraint=declaration.constraint offset=declaration.paramStart />, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
            val state = try self.instantiateConstraintProof(proof: self.thawStaticConformanceProof(id: plan.proofs[position]), receiverRef: bound.subject, environment: derivation, selfRef: environment.receiverRef, itemRef: 0U64)
            match state {
                StaticProofInstantiation.Ready(proof: val proof) => { implementationBounds.append(bound) implementationProofs.append(proof) }
                _ => { return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "implementation constraint derivation is unresolved") /> }
            }
        }
        return <Result.Ok value=<CallableConstraintEvidence.Recorded bounds=implementationBounds proofs=implementationProofs /> />
    }

    // An instantiated source plan is checked against the body signature by
    // equality and retained proof admission, never by conformance selection.
    inout fn checkCallableConstraintEvidence(fnIdx: U64, environment: InstanceEnvironment, evidence: CallableConstraintEvidence) -> Result[(), CompileDiagnostic] {
        match evidence {
            CallableConstraintEvidence.Declaration => { return self.checkSelectedCallableBounds(fnIdx: fnIdx, environment: environment) }
            CallableConstraintEvidence.Requirement(plan: val plan, bounds: val bounds, proofs: val proofs, normalizations: val normalizations) => {
                val recorded = try self.instantiateRequirementCallConstraints(fnIdx: fnIdx, environment: environment, planIndex: plan, bounds: bounds, proofs: proofs, normalizations: normalizations)
                return self.checkCallableConstraintEvidence(fnIdx: fnIdx, environment: environment, evidence: recorded)
            }
            CallableConstraintEvidence.Recorded(val bounds, val proofs) => {
                val expected = try self.groundCallableSignatureBounds(fnIdx: fnIdx, environment: environment)
                if bounds.count() != expected.count() || proofs.count() != expected.count() {
                    return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "instantiated call has incomplete constraint evidence") />
                }
                mut val index = 0U64
                while index < expected.count() {
                    val bound = expected[index]
                    if !self.typeRefEq(a: bounds[index].subject, b: bound.subject) || !self.sameTraitConstraint(a: bounds[index].constraint, b: bound.constraint) {
                        return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "instantiated call constraint evidence has a different substitution") />
                    }
                    try self.checkStaticProofEvidence(proof: proofs[index], offset: bound.offset)
                    try self.checkSelectedCallConstraintBoundary(expected: bound, proof: proofs[index], offset: bound.offset)
                    index += 1U64
                }
            }
        }
        return <Result.Ok value=() />
    }

    // The recorded proofs are validated against the already instantiated
    // obligations before they can interpret any dependent signature recipe.
    // Keep this environment local until the authored contract matches it.
    inout fn prepareRecordedProvidedConstraints(fnIdx: U64, environment: InstanceEnvironment, bounds: Array[TraitBound], proofs: Array[StaticConformanceProof]) -> Result[InstanceEnvironment, CompileDiagnostic] {
        val admitted = try self.providedSignatureAdmission(function: fnIdx)
        val count = admitted.clauses.count()
        val offset = self.arena.functionAt(index: fnIdx).defOffset
        if bounds.count() != count || proofs.count() != count {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "instantiated call has incomplete constraint evidence") />
        }
        mut val indices: Array[U64] = []
        mut val retainedProofs: Array[U64] = []
        for index in 0U64..<count {
            val bound = bounds[index]
            val proof = proofs[index]
            try self.checkStaticProofEvidence(proof: proof, offset: bound.offset)
            try self.checkSelectedCallConstraintBoundary(expected: bound, proof: proof, offset: bound.offset)
            indices.append(admitted.clauses[index].assumption)
            retainedProofs.append(self.freezeStaticConformanceProof(proof: proof))
        }
        val prepared = self.arena.prepareCallableConstraints(function: fnIdx, environment: environment, indices: indices, bounds: bounds, proofs: retainedProofs)
        val candidate = <InstanceEnvironment params=environment.params args=environment.args receiverRef=environment.receiverRef proof=environment.proof constraints=<Optional.Some v=prepared /> />
        val expected = try self.readProvidedSignatureBounds(admitted: admitted, environment: candidate, concrete: true)
        for index in 0U64..<count {
            val bound = expected[index]
            if !self.typeRefEq(a: bounds[index].subject, b: bound.subject) || !self.sameTraitConstraint(a: bounds[index].constraint, b: bound.constraint) {
                return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "instantiated call constraint evidence has a different substitution") />
            }
        }
        return <Result.Ok value=candidate />
    }

    // Prepare the body substitution once. Source-recorded evidence is admitted
    // against the callee declaration before acquiring its declaration identities.
    inout fn environmentWithCallableConstraints(fnIdx: U64, environment: InstanceEnvironment, evidence: CallableConstraintEvidence) -> Result[InstanceEnvironment, CompileDiagnostic] {
        mut val proofs: Array[U64] = []
        mut val bounds: Array[TraitBound] = []
        match evidence {
            CallableConstraintEvidence.Requirement(plan: val plan, bounds: val bounds, proofs: val proofs, normalizations: val normalizations) => {
                val recorded = try self.instantiateRequirementCallConstraints(fnIdx: fnIdx, environment: environment, planIndex: plan, bounds: bounds, proofs: proofs, normalizations: normalizations)
                return self.environmentWithCallableConstraints(fnIdx: fnIdx, environment: environment, evidence: recorded)
            }
            CallableConstraintEvidence.Declaration => {
                bounds = try self.groundCallableSignatureBounds(fnIdx: fnIdx, environment: environment)
                for bound in bounds {
                    val proof = try self.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: bound.subject, constraint: bound.constraint)
                    if self.proofIsMissing(proof: proof) {
                        return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "type argument does not conform to the trait required by `where`") />
                    }
                    proofs.append(self.freezeStaticConformanceProof(proof: proof))
                }
            }
            CallableConstraintEvidence.Recorded(bounds: val recordedBounds, proofs: val recorded) => {
                if self.arena.functionAt(index: fnIdx).isProvided && self.isAuthoredProvidedDeclaration(function: fnIdx) {
                    return self.prepareRecordedProvidedConstraints(fnIdx: fnIdx, environment: environment, bounds: recordedBounds, proofs: recorded)
                }
                try self.checkCallableConstraintEvidence(fnIdx: fnIdx, environment: environment, evidence: evidence)
                bounds = recordedBounds
                for proof in recorded { proofs.append(self.freezeStaticConformanceProof(proof: proof)) }
            }
        }
        val prepared = self.arena.prepareCallableConstraints(function: fnIdx, environment: environment, indices: self.sourceDeclarationCallBoundIndices(functionIndex: fnIdx), bounds: bounds, proofs: proofs)
        return <Result.Ok value=<InstanceEnvironment params=environment.params args=environment.args receiverRef=environment.receiverRef proof=environment.proof constraints=<Optional.Some v=prepared /> /> />
    }

    // Resolve a no-argument protocol signature without demanding its body.
    // Zero retains an unresolved substitution for the later instance obligation.
    // Async declarations expose a Promise at the call boundary. An omitted
    // signature still needs its implicit result term; never substitute the
    // logical body return for the call result.
    fn hasDeclaredCallResult(function: Func) -> Bool {
        if !function.isAsync || !function.hasRet { return true }
        if function.retTy == 0U64 || function.retTy >= self.arena.typeCount() { return false }
        val result = self.arena.typeAt(index: function.retTy)
        return rangeEquals(bytes: self.arena.bytes, start: result.nameStart, len: result.nameLen, kw: "Promise")
    }

    // A declaration-time dependency reads the selected signature and its exact
    // substitutions. It never executes the producer or demands its body.
    // The site selects the published result recipe; the recipe's expression
    // is only a reference to the canonical source type fact. Never recover
    // a call result by rechecking the callee declaration or its bounds.
    inout fn sourceSelectedCallResult(siteKey: CallSiteKey) -> U64 {
        val index = self.callTemplateIndex(siteKey: siteKey)
        if index >= self.callTemplateLocations.count() { return 0U64 }
        val template = self.callTemplateAt(index: index)
        val recipeId = template.resultTypeRecipe
        if recipeId == 0U64 || recipeId > self.arena.semanticTypeRecipes.count() { return 0U64 }
        val recipe = self.arena.semanticTypeRecipes[recipeId - 1U64]
        if recipe.kind != 2U64 || !self.sameCallSiteKey(a: recipe.callSite, b: siteKey) { return 0U64 }
        match recipe.sourceExpression {
            Optional.Some(v: val expression) => { return self.recordedSourceExpressionTerm(exprId: expression) }
            Optional.None => {}
        }
        // Statement-owned protocols have no expression fact. Their selected
        // signature already stores the source result; it is not re-selected.
        match template.kind {
            CallTemplateKind.Protocol(receiver: _, selection: _, resultTerm: val result) => { return result }
            _ => { return 0U64 }
        }
    }

    inout fn closedSelectedCallResult(siteKey: CallSiteKey) -> Result[U64, CompileDiagnostic] {
        val result = self.sourceSelectedCallResult(siteKey: siteKey)
        if result == 0U64 || result >= self.arena.typeCount() || !self.arena.typeIsClosed(ref: result) { return <Result.Ok value=0U64 /> }
        return <Result.Ok value=result />
    }

    inout fn closedProtocolReceiver(receiver: CallTemplateReceiver) -> Result[U64, CompileDiagnostic] {
        match receiver {
            CallTemplateReceiver.Term(term: val term) => { return <Result.Ok value=term /> }
            CallTemplateReceiver.PriorCallResult(exprId: _, siteKey: val dependency) => { return self.closedSelectedCallResult(siteKey: dependency) }
            CallTemplateReceiver.PriorCallResultWithViews(exprId: _, siteKey: val dependency, views: val views) => {
                val term = try self.closedSelectedCallResult(siteKey: dependency)
                if term == 0U64 { return <Result.Ok value=0U64 /> }
                return <Result.Ok value=self.typeRefWithAddedViewSources(ref: term, additions: self.callTemplateViews(range: views)) />
            }
            _ => { return <Result.Ok value=0U64 /> }
        }
    }

    inout fn checkClosedIterationProtocols() -> Result[(), CompileDiagnostic] {
        val count = self.callTemplateLocations.count()
        mut val index = 0U64
        while index < count {
            try self.checkClosedIterationProtocol(templateIndex: index)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkClosedIterationProtocol(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        val template = self.callTemplateAt(index: templateIndex)
        match template.kind {
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Pending => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "for-loop requires an Iterable or Iterator") /> }
                    _ => {}
                }
                val receiver = template.receiverTypeTerm
                if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=() /> }
                if self.arena.typeTermAt(index: receiver).isAny {
                    try self.checkExistentialIterationReceiver(receiver: receiver, fnIdx: template.siteKey.ownerFnIdx, offset: template.siteKey.originStart)
                    return <Result.Ok value=() />
                }
                mut val callee = self.arena.functionCount()
                mut val proof = <StaticConformanceProof.Missing />
                match selection {
                    ProtocolSelection.Static(resolution: val resolution) => {
                        mut val symbolic = <StaticConformanceProof.Missing />
                        match resolution {
                            StaticMemberResolution.Requirement(proof: val evidence, traitIdx: _, reqIdx: _) => { symbolic = evidence }
                            StaticMemberResolution.Provided(proof: val evidence, traitIdx: _, callee: _) => { symbolic = evidence }
                            _ => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "implicit protocol has no selected requirement") /> }
                        }
                        val instantiation = try self.instantiateStaticMemberProof(proof: symbolic, receiverRef: receiver, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64)
                        match instantiation {
                            StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "implicit protocol has no concrete witness") /> }
                            StaticProofInstantiation.Deferred => { return <Result.Ok value=() /> }
                            StaticProofInstantiation.Ready(proof: val concrete) => { proof = concrete }
                        }
                        match resolution {
                            StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: val requirement) => {
                                callee = try self.proofConcreteWitness(proof: proof, receiverRef: receiver, traitIdx: owner, reqIdx: requirement)
                            }
                            StaticMemberResolution.Provided(proof: _, traitIdx: val owner, callee: val declaration) => {
                                callee = try self.providedCopyForDeclaration(declaration: declaration, receiverRef: receiver, proof: proof, traitIdx: owner, offset: template.siteKey.originStart)
                            }
                            _ => {}
                        }
                    }
                    _ => { return <Result.Ok value=() /> }
                }
                if callee >= self.arena.functionCount() { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "implicit protocol has no concrete witness") /> }
                val function = self.arena.functionAt(index: callee)
                val arguments = try self.callConstraintTypeArguments(function: function, receiver: receiver, proof: proof)
                for argument in arguments {
                    if argument == 0U64 || !self.arena.typeIsClosed(ref: argument) { return <Result.Ok value=() /> }
                }
                val environment = try self.bodyInstanceEnvironment(fnIdx: callee, args: arguments, recvInstRef: receiver, selectedProof: proof)
                try self.checkSelectedCallableBounds(fnIdx: callee, environment: environment)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // Selection closure is a prerequisite, not a whole-body checked token.
    // Symbolic obligations retain the same later instance checks as batch use.
    inout fn checkRecordedBodyCallConstraints(owner: U64) -> Result[(), CompileDiagnostic] {
        val limit = self.callTemplateLocations.count()
        mut val row = self.firstLexicalCallTemplate(owner: owner)
        while row != 0U64 && row <= limit {
            val index = row - 1U64
            try self.checkRecordedCallTemplateBound(templateIndex: index)
            try self.checkClosedIterationProtocol(templateIndex: index)
            row = self.callTemplateBodyNext[index]
        }
        return <Result.Ok value=() />
    }

    // Check one selected source call without scanning other bodies or
    // discovering executable instances. The caller owns demand/iteration.
    inout fn checkRecordedCallTemplateBound(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        try self.checkCallTemplateSelection(templateIndex: templateIndex)
        return self.checkRecordedCallConstraintEvidence(templateIndex: templateIndex)
    }

    // Unused source calls still impose constraints. Symbolic substitutions
    // retain their bound-aware abstract checking and later instance obligations.
    // This pass never registers an executable body or resolves a new callee.
    inout fn checkRecordedCallTemplateBounds() -> Result[(), CompileDiagnostic] {
        mut val constrained: Array[Bool] = []
        mut val index = 0U64
        while index < self.arena.functionCount() { constrained.append(false)
            index += 1U64 }
        index = 0U64
        while index < self.decls.funcBounds.count() {
            val bound = self.decls.funcBounds.at(index: index)
            if bound.fnIdx < constrained.count() { constrained.set(i: bound.fnIdx, value: true) }
            index += 1U64
        }
        index = 0U64
        while index < self.arena.functionCount() {
            val owner = self.arena.functionAt(index: index).lexicalOwnerFnId
            if owner != 0U64 && owner - 1U64 < constrained.count() && constrained[owner - 1U64] { constrained.set(i: index, value: true) }
            index += 1U64
        }
        val count = self.callTemplateLocations.count()
        index = 0U64
        while index < count {
            val template = self.callTemplateAt(index: index)
            match template.kind {
                CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                    if callee < constrained.count() && constrained[callee] {
                        try self.checkRecordedCallTemplateBound(templateIndex: index)
                    }
                }
                CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: _, resultTerm: _) => {
                    match resolution {
                        StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => {
                            if callee < constrained.count() && constrained[callee] { try self.checkRecordedCallTemplateBound(templateIndex: index) }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    // Shared declaration-receiver matcher. It is also the source of truth for
    // grounding a method result under a structural receiver pattern.
    inout fn methodReceiverEnvironment(f: Func, instRef: U64) -> Result[WitnessMatch, CompileDiagnostic] {
        if f.recvTy == 0U64 || instRef == 0U64 { return <Result.Ok value=<WitnessMatch /> />}
        val noArgs: Array[U64] = []
        // A conferred receiver pattern belongs to its conformance, not to the
        // nominal receiver/method binder vector of the generated callable.
        mut val patternParams = f.typeParams
        if f.recvPatternParams.count() > 0U64 { patternParams = f.recvPatternParams }
        return <Result.Ok value=(try self.conformancePatternWitnessMatch(conformIdx: 0U64, subjectId: f.recvId, subjectTy: f.recvTy, subjectArgs: <PatternTypeInput.Values values=noArgs />, typeParams: <PatternBindInput.Function range=patternParams />, declaredTraitArgs: <PatternTypeInput.Values values=noArgs />, typeRef: instRef, traitArgs: <PatternTypeInput.Values values=noArgs />)) />
    }

}

impl Comp {
    inout fn conformanceRequirementMethodArguments(conformance: Conform, requirement: Func, witness: Func) -> Array[U64] {
        mut val arguments: Array[U64] = []
        for index in 0U64..<requirement.typeParams.count() {
            val parameter = self.funcBindAt(binds: witness.typeParams, index: conformance.typeParams.count() + index)
            arguments.append(self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen paramId=parameter.paramId args=[] />))
        }
        return arguments
    }

    fn conformanceRequirementEnvironment(base: InstanceEnvironment, parameters: Array[Bind], arguments: Array[U64]) -> InstanceEnvironment {
        if parameters.count() == 0U64 { return base }
        mut val bindings = base.params
        mut val values = base.args
        for parameter in parameters { bindings.append(parameter) }
        for argument in arguments { values.append(argument) }
        return <InstanceEnvironment params=bindings args=values receiverRef=base.receiverRef />
    }

    inout fn conformanceCallableFormParametersMatch(conformanceIndex: U64, traitIndex: U64, slot: U64, witness: Func, parameters: FuncParamRange, preparedParents: inout Dictionary[U64, Bool]) -> Result[Bool, CompileDiagnostic] {
        val conformance = self.decls.conformAt(index: conformanceIndex)
        val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: traitIndex).reqs, index: slot)
        if parameters.count() != requirement.params.count() || witness.typeParams.count() != conformance.typeParams.count() + requirement.typeParams.count() { return <Result.Ok value=false /> }
        try self.prepareCallableFormEvidence(conformanceIndex: conformanceIndex, traitIndex: traitIndex, prepared: inout preparedParents)
        val scope = try self.requireAdmittedRawRequirement(traitIndex: traitIndex, slot: slot, offset: requirement.defOffset)
        val signature = <RequirementSignatureRead scope=scope bound=self.conformanceTraitBound(conformance: conformance, index: conformanceIndex) evidence=<RequirementSelfEvidence.Conformance index=conformanceIndex /> />
        val arguments = self.conformanceRequirementMethodArguments(conformance: conformance, requirement: requirement, witness: witness)
        val base = self.requirementSignatureEnvironment(bound: signature.bound, traitIndex: traitIndex)
        val environment = self.conformanceRequirementEnvironment(base: base, parameters: self.copyFuncBinds(binds: requirement.typeParams), arguments: arguments)
        mut val memo: Dictionary[U64, AuthoredRecipeRead] = [:]
        return self.conformanceRequirementParametersMatch(signature: signature, environment: environment, traitIndex: traitIndex, parameters: parameters, memo: inout memo)
    }

    inout fn conformanceRequirementParametersMatch(signature: RequirementSignatureRead, environment: InstanceEnvironment, traitIndex: U64, parameters: FuncParamRange, memo: inout Dictionary[U64, AuthoredRecipeRead]) -> Result[Bool, CompileDiagnostic] {
        val admitted = self.authoredRequirementViews[signature.scope]
        val requirement = admitted.declaration
        for index in 0U64..<parameters.count() {
            val actual = self.funcParamAt(params: parameters, index: index)
            val expected = self.funcParamAt(params: requirement.params, index: index)
            if actual.noLabel != expected.noLabel || (!expected.noLabel && actual.nameId != expected.nameId) { return <Result.Ok value=false /> }
            val expectedType = try self.readRequirementParameter(admitted: admitted, index: index, interface: signature, environment: environment, memo: inout memo)
            val actualType = self.traitBoundTypeTerm(ref: self.groundTermInEnvironment(ref: actual.ty, params: [], values: [], selfRef: signature.bound.subject), bound: signature.bound, traitIndex: traitIndex)
            if !self.typeRefEq(a: expectedType, b: actualType) { return <Result.Ok value=false /> }
        }
        return <Result.Ok value=true />
    }
}

impl Comp {
    fn traitBoundShape(declaration: TraitDef) -> TraitBoundShape {
        return <TraitBoundShape nameStart=declaration.nameStart selfParamId=declaration.selfParamId typeParams=declaration.typeParams assocTypes=declaration.assocTypes supertraits=declaration.supertraits />
    }

    fn availableTraitBoundShape(owner: U64) -> Optional[TraitBoundShape] {
        val index = self.decls.traitIndexByOffset(offset: owner)
        if index < self.decls.traitCount() {
            return <Optional.Some v=self.traitBoundShape(declaration: self.decls.traitAt(index: index)) />
        }
        return self.traitLexicalHeaders.get(key: owner)
    }

    inout fn traitBoundTypeTermInShape(ref: U64, bound: TraitBound, shape: TraitBoundShape, includeInherited: Bool = true) -> U64 {
        val reified = self.reifyBoundAssociatedTerms(ref: ref, shape: shape, receiverRef: bound.subject, traitOwner: shape.nameStart, traitArgs: bound.constraint.key.positionalArgs, predicates: bound.constraint.assocPredicates, includeInherited: includeInherited)
        return self.substituteTraitTypeTerm(ref: reified, parameters: shape.typeParams, selfParamId: shape.selfParamId, receiverRef: bound.subject, traitArgs: bound.constraint.key.positionalArgs)
    }

    inout fn traitConstraintInShape(constraint: TraitConstraint, bound: TraitBound, shape: TraitBoundShape, includeInherited: Bool) -> TraitConstraint {
        mut val arguments: Array[U64] = []
        for val argument in constraint.key.positionalArgs { arguments.append(self.traitBoundTypeTermInShape(ref: argument, bound: bound, shape: shape, includeInherited: includeInherited)) }
        mut val predicates: Array[TraitAssocPredicate] = []
        for val predicate in constraint.assocPredicates {
            predicates.append(<TraitAssocPredicate member=predicate.member value=self.traitBoundTypeTermInShape(ref: predicate.value, bound: bound, shape: shape, includeInherited: includeInherited) span=predicate.span />)
        }
        return <TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates />
    }

    // Reify every occurrence of the selected trait's associated-output binder
    // in a requirement result.  The owner is the already-selected TraitDef,
    // never a name search: `Optional[Item]` must receive the same treatment as
    // a top-level `Item` under `where T: Iterator[Item=E]`.
    inout fn reifyBoundAssociatedTerms(ref: U64, shape: TraitBoundShape, receiverRef: U64, traitOwner: U64, traitArgs: Array[U64], predicates: Array[TraitAssocPredicate], includeInherited: Bool = true, projectionPath: Array[U64] = []) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeCount() { return ref }
        val raw: TypeRef = self.arena.typeAt(index: ref)
        if raw.assocNameId != 0U64 {
            // Cyclic authored equations remain symbolic, never recurse forever
            // or acquire an answer by declaration order.
            for visited in projectionPath { if self.typeRefEq(a: ref, b: visited) { return ref } }
            mut val nextProjectionPath = projectionPath
            nextProjectionPath.append(ref)
            // A written projection and the associated binder denote the same
            // output only for this exact subject and trait instance.
            val receiver = self.reifyBoundAssociatedTerms(ref: self.typeTermProjectionReceiver(t: raw), shape: shape, receiverRef: receiverRef, traitOwner: traitOwner, traitArgs: traitArgs, predicates: predicates, includeInherited: includeInherited, projectionPath: projectionPath)
            mut val arguments: Array[U64] = []
            for argument in raw.assocTraitArgs {
                arguments.append(self.reifyBoundAssociatedTerms(ref: argument, shape: shape, receiverRef: receiverRef, traitOwner: traitOwner, traitArgs: traitArgs, predicates: predicates, includeInherited: includeInherited, projectionPath: projectionPath))
            }
            val selectedReceiver = self.substituteTraitTypeTerm(ref: receiver, parameters: shape.typeParams, selfParamId: shape.selfParamId, receiverRef: receiverRef, traitArgs: traitArgs)
            mut val selectedArguments: Array[U64] = []
            for argument in arguments { selectedArguments.append(self.substituteTraitTypeTerm(ref: argument, parameters: shape.typeParams, selfParamId: shape.selfParamId, receiverRef: receiverRef, traitArgs: traitArgs)) }
            val owner = if raw.hasAssocTraitDecl { give raw.assocTraitDeclOffset } else { give raw.assocTraitStart }
            if includeInherited {
                val bound = <TraitBound subject=receiverRef constraint=<TraitConstraint key=<TraitInstanceKey owner=traitOwner positionalArgs=traitArgs /> positionalArgsOpen=false assocPredicates=predicates /> offset=raw.siteOffset />
                match self.traitProjectionEquality(bound: bound, receiver: selectedReceiver, owner: owner, arguments: selectedArguments, member: raw.assocNameId, context: bound, projectionPath: nextProjectionPath) {
                    TraitProjectionEquality.Value(term: val value, steps: _) => { return value }
                    // Preserve unresolved projections rather than choosing a
                    // declaration-order-dependent answer from conflicting facts.
                    TraitProjectionEquality.Missing | TraitProjectionEquality.Conflict => {}
                }
            } else if owner == traitOwner && self.typeRefEq(a: selectedReceiver, b: receiverRef) && self.sameResolvedTypeRefs(a: selectedArguments, b: traitArgs) {
                for predicate in predicates {
                    if predicate.member == raw.assocNameId { return predicate.value }
                }
            }
            if receiver != self.typeTermProjectionReceiver(t: raw) || !self.sameResolvedTypeRefs(a: arguments, b: raw.assocTraitArgs) {
                return self.rebuildProjectionTerm(t: raw, receiver: receiver, traitArgs: arguments)
            }
            return ref
        }
        mut val rawName: U64 = raw.nameId
        if rawName == 0U64 { rawName = intern(c: inout self, start: raw.nameStart, len: raw.nameLen) }
        if raw.args.count() == 0U64 && !raw.hasDecl && raw.paramId == 0U64 {
            mut val ai: U64 = 0U64
            while ai < shape.assocTypes.count() {
                val assoc: Bind = self.traitBindAt(binds: shape.assocTypes, index: ai)
                if assoc.nameId == rawName {
                    mut val pi: U64 = 0U64
                    while pi < predicates.count() {
                        val predicate: TraitAssocPredicate = predicates[pi]
                        if predicate.member == rawName { return predicate.value }
                        pi += 1U64
                    }
                    if receiverRef >= self.arena.typeCount() { return ref }
                    val receiver: TypeRef = self.arena.typeAt(index: receiverRef)
                    val noLabels: Array[U64] = []
                    return self.pushType(t: <TypeRef nameStart=receiver.nameStart nameLen=receiver.nameLen paramId=receiver.paramId args=receiver.args isRecord=receiver.isRecord recordFieldLabels=receiver.recordFieldLabels recordFieldTerms=receiver.recordFieldTerms isAny=receiver.isAny argLabels=receiver.argLabels projectionReceiver=receiverRef assocTraitStart=traitOwner assocTraitLen=self.traitNameLenByOwner(owner: traitOwner) assocTraitId=intern(c: inout self, start: traitOwner, len: self.traitNameLenByOwner(owner: traitOwner)) assocTraitArgs=traitArgs assocTraitArgLabels=noLabels assocNameStart=assoc.nameStart assocNameLen=assoc.nameLen assocNameId=assoc.nameId isSendable=receiver.isSendable isDiverging=receiver.isDiverging hasDecl=receiver.hasDecl declOffset=receiver.declOffset hasAssocTraitDecl=true assocTraitDeclOffset=traitOwner siteOffset=0U64 />)
                }
                ai += 1U64
            }
        }
        if raw.isRecord {
            if raw.recordFieldLabels.count() != raw.recordFieldTerms.count() { return ref }
            mut val fields: Array[U64] = []
            mut val changed: Bool = false
            mut val ri: U64 = 0U64
            while ri < raw.recordFieldTerms.count() {
                val next: U64 = self.reifyBoundAssociatedTerms(ref: raw.recordFieldTerms[ri], shape: shape, receiverRef: receiverRef, traitOwner: traitOwner, traitArgs: traitArgs, predicates: predicates, includeInherited: includeInherited, projectionPath: projectionPath)
                if next != raw.recordFieldTerms[ri] { changed = true }
                fields.append(next)
                ri += 1U64
            }
            if changed { return self.rebuildRecordTypeTerm(t: raw, fieldTerms: fields) }
            return ref
        }
        mut val args: Array[U64] = []
        mut val argsChanged: Bool = false
        mut val i: U64 = 0U64
        while i < raw.args.count() {
            val next: U64 = self.reifyBoundAssociatedTerms(ref: raw.args[i], shape: shape, receiverRef: receiverRef, traitOwner: traitOwner, traitArgs: traitArgs, predicates: predicates, includeInherited: includeInherited, projectionPath: projectionPath)
            if next != raw.args[i] { argsChanged = true }
            args.append(next)
            i += 1U64
        }
        if argsChanged { return self.rebuildTypeTerm(t: raw, args: args, assocTraitArgs: raw.assocTraitArgs) }
        return ref
    }
}
