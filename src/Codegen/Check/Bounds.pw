// Part of compile-time checks (root: _.pw): trait-bound and conformance
// validation.

// The concrete type span that the conforming type `(recvStart,recvLen)` binds for
// the associated type named `(nameStart,nameLen)` (spec/08 `type Item = Concrete`),
// or the input name unchanged when it is not an associated type / has no binding.

pub impl Comp {
    // Form the semantic constraint carried by an existential once, at the
    // boundary from a lowered TypeRef.  `any Alias` must retain the resolved
    // declaration selected at the authored use site: the spelling alone is
    // neither a trait identity nor a safe conformance-query input.
    //
    // This is intentionally not a general TypeRef-to-constraint conversion.
    // Only `any P[...]` owns associated-output predicates in the current
    // surface syntax; ordinary trait uses are lowered by FuncBound/Conform
    // with their owner already canonicalized.
    inout fn existentialTraitConstraintFor(t: TypeRef) -> TraitConstraint {
        if !(t.isAny) {
            return <TraitConstraint key=<TraitInstanceKey owner=0U64 positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] />
        }
        mut val owner: U64 = 0U64
        // Visibility resolution preserves the declaration selected by the
        // authored type occurrence.  It is stronger than a later spelling
        // lookup, which would lose aliases and same-name module identity.
        if t.hasDecl { owner = t.declOffset }
        if owner == 0U64 {
            owner = self.traitOwnerAtUse(start: t.nameStart, len: t.nameLen, arity: self.positionalTraitArgs(t: t).count())
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        val names: Array[U64] = self.traitAssocArgNames(t: t)
        val values: Array[U64] = self.traitAssocArgValues(t: t)
        mut val i: U64 = 0U64
        while i < names.count() && i < values.count() {
            predicates.append(<TraitAssocPredicate member=names[i] value=values[i] span=t.siteOffset />)
            i += 1U64
        }
        return <TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=self.positionalTraitArgs(t: t) /> positionalArgsOpen=false assocPredicates=predicates />
    }

    inout fn existentialTraitConstraint(ref: U64) -> TraitConstraint {
        if ref >= self.arena.types.count() {
            return <TraitConstraint key=<TraitInstanceKey owner=0U64 positionalArgs=[] /> positionalArgsOpen=false assocPredicates=[] />
        }
        return self.existentialTraitConstraintFor(t: self.arena.types[ref])
    }

    // Compatibility projection for existing bool consumers.  The input is
    // already canonical; this wrapper deliberately has no spelling fallback.
    // It is the migration bridge until each consumer receives the selected
    // ConformanceProof rather than only its truth value.
    inout fn conformsTraitConstraint(ref: U64, constraint: TraitConstraint) -> Bool {
        if constraint.key.owner == 0U64 { return false }
        mut val names: Array[U64] = []
        mut val values: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.assocPredicates.count() {
            names.append(constraint.assocPredicates[i].member)
            values.append(constraint.assocPredicates[i].value)
            i += 1U64
        }
        return self.conformsInstance(ref: ref, traitStart: constraint.key.owner, traitLen: self.traitNameLenByOwner(owner: constraint.key.owner), traitArgs: constraint.key.positionalArgs, traitArgsOpen: constraint.positionalArgsOpen, assocNames: names, assocValues: values)
    }

    // Ground every term owned by a constraint through one explicit instance
    // map.  This is the sole substitution boundary for a bound's trait key
    // and associated-output predicates; callers must not separately ground
    // the old `traitArgs` / `traitAssocValues` arrays.
    inout fn groundTraitConstraintInEnvironment(constraint: TraitConstraint, params: Array[Bind], args: Array[U64]) -> TraitConstraint {
        mut val positional: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.key.positionalArgs.count() {
            positional.append(self.groundTermInEnvironment(ref: constraint.key.positionalArgs[i], params: params, values: args))
            i += 1U64
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        i = 0U64
        while i < constraint.assocPredicates.count() {
            val predicate: TraitAssocPredicate = constraint.assocPredicates[i]
            predicates.append(<TraitAssocPredicate member=predicate.member value=self.groundTermInEnvironment(ref: predicate.value, params: params, values: args) span=predicate.span />)
            i += 1U64
        }
        return <TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=positional /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates />
    }

    // Conditional impls bind their receiver parameters directionally through
    // a selected witness rather than by position in the caller's type-arg
    // array.  Ground the whole constraint under that same witness map so
    // positional inputs and associated-output predicates cannot diverge.
    inout fn groundTraitConstraintThroughWitness(constraint: TraitConstraint, params: Array[Bind], matchResult: WitnessMatch) -> TraitConstraint {
        mut val positional: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.key.positionalArgs.count() {
            positional.append(self.groundWitnessTypeTerm(ref: constraint.key.positionalArgs[i], params: params, matchResult: matchResult))
            i += 1U64
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        i = 0U64
        while i < constraint.assocPredicates.count() {
            val predicate: TraitAssocPredicate = constraint.assocPredicates[i]
            predicates.append(<TraitAssocPredicate member=predicate.member value=self.groundWitnessTypeTerm(ref: predicate.value, params: params, matchResult: matchResult) span=predicate.span />)
            i += 1U64
        }
        return <TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=positional /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates />
    }

    // A view can establish a conformance that the bare receiver does not have.
    // Keep this policy beside the constraint API, rather than asking each
    // generic-bound checker to unpack owner, positional args and predicates.
    inout fn viewedTypeConformsTraitConstraint(ref: U64, constraint: TraitConstraint) -> Bool {
        if constraint.key.owner == 0U64 { return false }
        mut val names: Array[U64] = []
        mut val values: Array[U64] = []
        mut val i: U64 = 0U64
        while i < constraint.assocPredicates.count() {
            names.append(constraint.assocPredicates[i].member)
            values.append(constraint.assocPredicates[i].value)
            i += 1U64
        }
        return self.viewedTypeConforms(ref: ref, traitStart: constraint.key.owner, traitLen: self.traitNameLenByOwner(owner: constraint.key.owner), traitArgs: constraint.key.positionalArgs, traitArgsOpen: constraint.positionalArgsOpen, assocNames: names, assocValues: values)
    }

    // Declaration-time evidence is a separate query from concrete
    // conformance lookup.  In `where Parser: Convert[T]`, the receiver is
    // not a type parameter, yet the bound is still the only static proof
    // available while T is rigid.  Keep the complete receiver and positional
    // trait instance in the match; textual trait names alone are insufficient.
    // `positionalArgsOpen` controls concrete witness matching, not whether a
    // declaration-time bound names the same symbolic trait instance, so this
    // proof match deliberately compares the resolved owner and positional
    // terms only.
    inout fn assumedBoundProof(fnIdx: U64, receiverRef: U64, constraint: TraitConstraint) -> StaticConformanceProof {
        mut val i: U64 = 0U64
        while i < self.decls.funcBounds.count() {
            val bound: FuncBound = self.decls.funcBounds[i]
            if bound.fnIdx == fnIdx && bound.constraint.key.owner == constraint.key.owner && bound.paramTy != 0U64 && self.typeRefEq(a: bound.paramTy, b: receiverRef) && bound.constraint.key.positionalArgs.count() == constraint.key.positionalArgs.count() {
                mut val same: Bool = true
                mut val ai: U64 = 0U64
                while ai < constraint.key.positionalArgs.count() {
                    if !(self.typeRefEq(a: bound.constraint.key.positionalArgs[ai], b: constraint.key.positionalArgs[ai])) { same = false }
                    ai += 1U64
                }
                if same { return <StaticConformanceProof.AssumedBound boundIdx=i /> }
            }
            i += 1U64
        }
        return <StaticConformanceProof.Missing />
    }

    // A declaration-time receiver is established either by its own `where`
    // constraint or by a concrete/trait-path witness.  Callers such as view
    // applicability must consume this proof rather than special-case generic
    // parameter names: `x#E` is valid exactly when E's receiver constraint is
    // statically proved for x.
    inout fn staticTraitPatternProof(receiverRef: U64, traitId: U64, traitOwner: U64, traitArgs: Array[U64], patternParams: Array[Bind]) -> StaticConformanceProof {
        if self.cur.checkFn < self.arena.funcs.count() {
            val requested: TraitConstraint = <TraitConstraint key=<TraitInstanceKey owner=traitOwner positionalArgs=traitArgs /> positionalArgsOpen=false assocPredicates=[] />
            val assumed: StaticConformanceProof = self.assumedBoundProof(fnIdx: self.cur.checkFn, receiverRef: receiverRef, constraint: requested)
            match assumed {
                StaticConformanceProof.Missing => {}
                _ => { return assumed }
            }
        }
        return self.concreteTraitPatternProof(baseRef: receiverRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams)
    }

    // Resolve a requirement through declaration-time proof, without consulting
    // a concrete impl that happens to be visible today.  This is deliberately
    // separate from `resolveMethodFinal`: in
    //
    //   fn f[T](p: Parser, x: T) -> Parser#Convert[T].Output
    //     where Parser: Convert[T] { p.convert(value: x) }
    //
    // `T` is rigid.  Selecting Parser's Convert[String] witness while checking
    // the template would be unsound; the only evidence is the bound itself.
    // The result carries both the proof and the selected declaration.  Its
    // associated result stays symbolic until the type-term/proof consumer
    // grounds the selected bound at an actual instantiation.
    inout fn staticMemberResolution(fnIdx: U64, receiverRef: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> StaticMemberResolution {
        val memberId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0U64
        while i < self.decls.funcBounds.count() {
            val bound: FuncBound = self.decls.funcBounds[i]
            if bound.fnIdx == fnIdx && bound.paramTy != 0U64 {
                val proof: StaticConformanceProof = self.assumedBoundProof(fnIdx: fnIdx, receiverRef: receiverRef, constraint: bound.constraint)
                match proof {
                    StaticConformanceProof.AssumedBound(boundIdx: _) => {
                        mut val ti: U64 = 0U64
                        while ti < self.decls.traits.count() {
                            val traitDef: TraitDef = self.decls.traits[ti]
                            // `traitStart` is the resolved declaration owner,
                            // not merely the spelling at the `where` site.
                            // Same-name/same-arity imported traits are distinct.
                            if traitDef.nameStart == bound.constraint.key.owner && self.traitArityMatches(actual: traitDef.typeParams.count(), expected: bound.constraint.key.positionalArgs.count()) {
                                mut val ri: U64 = 0U64
                                while ri < traitDef.reqs.count() {
                                    val req: Func = traitDef.reqs[ri]
                                    if req.nameId == memberId && self.paramsLabelsOk(params: req.params, args: args) {
                                        return <StaticMemberResolution.Requirement proof=proof traitIdx=ti reqIdx=ri />
                                    }
                                    ri += 1U64
                                }
                            }
                            ti += 1U64
                        }
                    }
                    _ => {}
                }
            }
            i += 1U64
        }
        return <StaticMemberResolution.Missing />
    }

    // The parameter type of one requirement selected by `resolution`.
    // The trait's binders are substituted with the bound's positional instance
    // arguments before returning to the enclosing function's symbolic scope.
    // `0` means that the selected member is a provided method or otherwise has
    // no direct requirement parameter at `argIdx`; its fuller CallResolution
    // migration remains deliberately separate from this requirement slice.
    inout fn staticRequirementParamType(resolution: StaticMemberResolution, args: Array[Arg], argIdx: U64) -> U64 {
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIdx, reqIdx: val reqIdx) => {
                match proof {
                    StaticConformanceProof.AssumedBound(boundIdx: val boundIdx) => {
                        if boundIdx >= self.decls.funcBounds.count() || traitIdx >= self.decls.traits.count() { return 0U64 }
                        val traitDef: TraitDef = self.decls.traits[traitIdx]
                        if reqIdx >= traitDef.reqs.count() { return 0U64 }
                        val req: Func = traitDef.reqs[reqIdx]
                        val paramIdx: U64 = self.paramIndexForArg(params: req.params, args: args, argIdx: argIdx)
                        if paramIdx >= req.params.count() { return 0U64 }
                        val bound: FuncBound = self.decls.funcBounds[boundIdx]
                        val savedParams: Array[Bind] = self.cur.typeParams
                        val savedArgs: Array[U64] = self.cur.typeArgs
                        self.cur.typeParams = traitDef.typeParams
                        self.cur.typeArgs = bound.constraint.key.positionalArgs
                        val out: U64 = self.groundTypeRef(ref: req.params[paramIdx].ty)
                        self.cur.typeParams = savedParams
                        self.cur.typeArgs = savedArgs
                        return out
                    }
                    _ => { return 0U64 }
                }
            }
            _ => {}
        }
        return 0U64
    }

    // Reify every occurrence of the selected trait's associated-output binder
    // in a requirement result.  The owner is the already-selected TraitDef,
    // never a name search: `Optional[Item]` must receive the same treatment as
    // a top-level `Item` under `where T: Iterator[Item=E]`.
    inout fn reifyBoundAssociatedTerms(ref: U64, traitDef: TraitDef, bound: FuncBound) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val raw: TypeRef = self.arena.types[ref]
        mut val rawName: U64 = raw.nameId
        if rawName == 0U64 { rawName = intern(c: inout self, start: raw.nameStart, len: raw.nameLen) }
        if raw.args.count() == 0U64 && raw.assocNameId == 0U64 {
            mut val ai: U64 = 0U64
            while ai < traitDef.assocTypes.count() {
                if traitDef.assocTypes[ai].nameId == rawName {
                    mut val pi: U64 = 0U64
                    while pi < bound.constraint.assocPredicates.count() {
                        val predicate: TraitAssocPredicate = bound.constraint.assocPredicates[pi]
                        if predicate.member == rawName { return predicate.value }
                        pi += 1U64
                    }
                    if bound.paramTy >= self.arena.types.count() { return ref }
                    val receiver: TypeRef = self.arena.types[bound.paramTy]
                    val noLabels: Array[U64] = []
                    return self.pushType(t: <TypeRef nameStart=receiver.nameStart nameLen=receiver.nameLen args=receiver.args isRecord=receiver.isRecord recordFieldLabels=receiver.recordFieldLabels recordFieldTerms=receiver.recordFieldTerms viewExtId=receiver.viewExtId viewIds=receiver.viewIds viewSources=receiver.viewSources isAny=receiver.isAny argLabels=receiver.argLabels assocTraitStart=bound.constraint.key.owner assocTraitLen=self.traitNameLenByOwner(owner: bound.constraint.key.owner) assocTraitId=intern(c: inout self, start: bound.constraint.key.owner, len: self.traitNameLenByOwner(owner: bound.constraint.key.owner)) assocTraitArgs=bound.constraint.key.positionalArgs assocTraitArgLabels=noLabels assocNameStart=traitDef.assocTypes[ai].nameStart assocNameLen=traitDef.assocTypes[ai].nameLen assocNameId=traitDef.assocTypes[ai].nameId isSendable=receiver.isSendable hasDecl=receiver.hasDecl declOffset=receiver.declOffset hasAssocTraitDecl=true assocTraitDeclOffset=bound.constraint.key.owner siteOffset=0U64 />)
                }
                ai += 1U64
            }
        }
        if raw.isRecord {
            if raw.recordFieldLabels.count() != raw.recordFieldTerms.count() { return ref }
            mut val fields: Array[U64] = []
            mut val changed: Bool = false
            mut val ri: U64 = 0U64
            while ri < raw.recordFieldTerms.count() {
                val next: U64 = self.reifyBoundAssociatedTerms(ref: raw.recordFieldTerms[ri], traitDef: traitDef, bound: bound)
                if next != raw.recordFieldTerms[ri] { changed = true }
                fields.append(next)
                ri += 1U64
            }
            if changed { return self.rebuildRecordTypeTerm(t: raw, fieldTerms: fields) }
            return ref
        }
        mut val args: Array[U64] = []
        mut val argsChanged: Bool = false
        mut val i: U64 = 0U64
        while i < raw.args.count() {
            val next: U64 = self.reifyBoundAssociatedTerms(ref: raw.args[i], traitDef: traitDef, bound: bound)
            if next != raw.args[i] { argsChanged = true }
            args.append(next)
            i += 1U64
        }
        if argsChanged { return self.rebuildTypeTerm(t: raw, args: args, assocTraitArgs: raw.assocTraitArgs) }
        return ref
    }

    // Reify a requirement result under the selected static proof. Ordinary
    // trait parameters ground first; then associated outputs reify recursively
    // through the selected proof's constraint.
    inout fn staticRequirementResultType(resolution: StaticMemberResolution) -> U64 {
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIdx, reqIdx: val reqIdx) => {
                match proof {
                    StaticConformanceProof.AssumedBound(boundIdx: val boundIdx) => {
                        if boundIdx >= self.decls.funcBounds.count() || traitIdx >= self.decls.traits.count() { return 0U64 }
                        val traitDef: TraitDef = self.decls.traits[traitIdx]
                        if reqIdx >= traitDef.reqs.count() { return 0U64 }
                        val req: Func = traitDef.reqs[reqIdx]
                        if !(req.hasRet) || req.retTy == 0U64 || req.retTy >= self.arena.types.count() { return 0U64 }
                        val bound: FuncBound = self.decls.funcBounds[boundIdx]
                        val savedParams: Array[Bind] = self.cur.typeParams
                        val savedArgs: Array[U64] = self.cur.typeArgs
                        self.cur.typeParams = traitDef.typeParams
                        self.cur.typeArgs = bound.constraint.key.positionalArgs
                        val grounded: U64 = self.groundTypeRef(ref: req.retTy)
                        self.cur.typeParams = savedParams
                        self.cur.typeArgs = savedArgs
                        return self.reifyBoundAssociatedTerms(ref: grounded, traitDef: traitDef, bound: bound)
                    }
                    _ => { return 0U64 }
                }
            }
            _ => {}
        }
        return 0U64
    }

    // A named trait argument constrains an associated output after the
    // positional instance key selected a conformance witness.
    // The selected conformance is the witness identity.  Do not look up an
    // associated output by receiver spelling: one receiver may implement the
    // same parameterized trait more than once, and an extension witness is
    // distinct from a bare one.  `implOffset` ties the output to that witness.
    inout fn traitAssocOutputsMatch(cf: Conform, matchResult: WitnessMatch, assocNames: Array[U64], assocValues: Array[U64]) -> Bool {
        if assocNames.count() != assocValues.count() { return false }
        if assocNames.count() == 0U64 { return true }
        mut val need: U64 = 0U64
        while need < assocNames.count() {
            mut val found: Bool = false
            mut val i: U64 = 0U64
            while i < self.decls.assocBindings.count() {
                val ab: AssocBinding = self.decls.assocBindings[i]
                if ab.implOffset == cf.defOffset && ab.traitOwner == cf.traitStart && ab.nameId == assocNames[need] {
                    val output: U64 = self.groundWitnessTypeTerm(ref: ab.ty, params: cf.typeParams, matchResult: matchResult)
                    if self.typesCompatible(expected: assocValues[need], inferred: output) { found = true }
                }
                i += 1U64
            }
            if !found { return false }
            need += 1U64
        }
        return true
    }

    // A view is an unordered source set.  Bounds may use any active extension
    // source to establish the requested conformance; the trait selector itself
    // is already validated as singular when the TypeRef/value view is formed.
    inout fn viewedTypeConforms(ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = []) -> Bool {
        if ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[ref]
        if self.conformsInstance(ref: ref, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues) { return true }
        mut val i: U64 = 0U64
        while i < t.viewIds.count() {
            if self.viewConformsTo(typeStart: t.nameStart, typeLen: t.nameLen, typeRef: ref, viewId: t.viewIds[i], traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, assocNames: assocNames, assocValues: assocValues) { return true }
            i += 1U64
        }
        if t.viewIds.count() == 0U64 && t.viewExtId != 0U64 {
            return self.viewConformsTo(typeStart: t.nameStart, typeLen: t.nameLen, typeRef: ref, viewId: t.viewExtId, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, assocNames: assocNames, assocValues: assocValues)
        }
        return false
    }

    inout fn assocBindingSpan(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bind {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.assocBindings.count() {
            val ab: AssocBinding = self.decls.assocBindings[i]
            if ab.recvId == qRecv {
                if ab.nameId == qName {
                    return <Bind nameStart=ab.tyStart nameLen=ab.tyLen nameId=intern(c: inout self, start: ab.tyStart, len: ab.tyLen) fieldStart=ab.tyStart fieldLen=ab.tyLen />
                }
            }
            i += 1
        }
        return <Bind nameStart=nameStart nameLen=nameLen nameId=qName fieldStart=nameStart fieldLen=nameLen />
    }

    inout fn substReqParamHeadId(recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64], prStart: U64, prLen: U64) -> U64 {
        if rangeEquals(bytes: self.arena.bytes, start: prStart, len: prLen, kw: "Self") {
            return intern(c: inout self, start: recvStart, len: recvLen)
        }
        val prId: U64 = intern(c: inout self, start: prStart, len: prLen)
        mut val k: U64 = 0
        while k < tps.count() {
            if tps[k].nameId == prId {
                if k < targs.count() {
                    return self.arena.types[targs[k]].nameId
                }
            }
            k += 1
        }
        val sub: Bind = self.assocBindingSpan(recvStart: recvStart, recvLen: recvLen, nameStart: prStart, nameLen: prLen)
        return sub.nameId
    }

    inout fn substReqParamArrayElemRef(tps: Array[Bind], targs: Array[U64], prStart: U64, prLen: U64) -> U64 {
        val prId: U64 = intern(c: inout self, start: prStart, len: prLen)
        mut val k: U64 = 0
        while k < tps.count() {
            if tps[k].nameId == prId {
                if k < targs.count() {
                    val tr: TypeRef = self.arena.types[targs[k]]
                    if rangeEquals(bytes: self.arena.bytes, start: tr.nameStart, len: tr.nameLen, kw: "Array") {
                        if tr.args.count() > 0U64 {
                            return targs[k]
                        }
                    }
                }
            }
            k += 1
        }
        return 0U64
    }

    inout fn paramSelectorEqSubst(w: Array[Param], r: Array[Param], recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64]) -> Bool {
        if w.count() != r.count() {
            return false
        }
        mut val i: U64 = 0
        while i < w.count() {
            val pw: Param = w[i]
            val pr: Param = r[i]
            if pw.nameId != pr.nameId {
                return false
            }
            // a requirement param that substitutes to an `Array[Elem]` (e.g. `convert(from:
            // Source)` with `impl String as TryFrom[Array[U8]]`): the witness side writes it
            // as an array param (`from: Array[U8]`, head id = the ELEMENT), so compare arrayness
            // + element rather than the bare head ("Array" vs "U8" would never match).
            val arrTarg: U64 = self.substReqParamArrayElemRef(tps: tps, targs: targs, prStart: pr.tyStart, prLen: pr.tyLen)
            if arrTarg != 0U64 {
                if pw.tyIsArray {
                    val elemRef: U64 = self.arena.types[arrTarg].args[0]
                    if pw.tyNameId == self.arena.types[elemRef].nameId {
                        i += 1
                    } else {
                        return false
                    }
                } else {
                    return false
                }
            } else {
            val subId: U64 = self.substReqParamHeadId(recvStart: recvStart, recvLen: recvLen, tps: tps, targs: targs, prStart: pr.tyStart, prLen: pr.tyLen)
            // the WITNESS side may also write `Self` (`fn eqTo(other: Self)` inside
            // `impl P as MyEq`): substitute its Self -> the conforming type too, so the
            // requirement's substituted Self (=recv) matches it. A concrete witness type
            // (`other: P`) keeps its own head id (pw.tyNameId).
            mut val wId: U64 = pw.tyNameId
            if rangeEquals(bytes: self.arena.bytes, start: pw.tyStart, len: pw.tyLen, kw: "Self") {
                wId = intern(c: inout self, start: recvStart, len: recvLen)
            }
            if wId != subId {
                return false
            }
            i += 1
            }
        }
        return true
    }

    inout fn reqReturnMismatch(w: Func, r: Func, recvStart: U64, recvLen: U64) -> Bool {
        if !(r.hasRet) {
            return false
        }
        if r.retIsArray {
            return false
        }
        // resolve an associated-type requirement return (`fn first()->Item` with
        // `type Item = I64`) through the conformance's binding, so the witness's concrete
        // return is compared to the bound concrete type.
        val rr: Bind = self.assocBindingSpan(recvStart: recvStart, recvLen: recvLen, nameStart: r.retStart, nameLen: r.retLen)
        if !(self.isPrimType(start: rr.nameStart, len: rr.nameLen)) {
            return false
        }
        // requirement returns a concrete primitive: the witness must return it exactly.
        if !(w.hasRet) {
            return true
        }
        if w.retIsArray {
            return true
        }
        if spansEqual(c: inout self, aStart: rr.nameStart, aLen: rr.nameLen, bStart: w.retStart, bLen: w.retLen) {
            return false
        }
        return true
    }

    inout fn witnessedHas(witnessed: Array[Func], r: Func, recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64]) -> Bool {
        mut val i: U64 = 0
        while i < witnessed.count() {
            val w: Func = witnessed[i]
            if w.nameId == r.nameId {
                if self.paramSelectorEqSubst(w: w.params, r: r.params, recvStart: recvStart, recvLen: recvLen, tps: tps, targs: targs) {
                    if !(self.reqReturnMismatch(w: w, r: r, recvStart: recvStart, recvLen: recvLen)) {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn confWitnessesAll(cf: Conform, t: TraitDef) -> Bool {
        mut val ri: U64 = 0
        while ri < t.reqs.count() {
            val r: Func = t.reqs[ri]
            if !(self.witnessedHas(witnessed: cf.witnessed, r: r, recvStart: cf.typeStart, recvLen: cf.typeLen, tps: t.typeParams, targs: cf.traitArgs)) {
                return false
            }
            ri += 1
        }
        return true
    }

    inout fn resolveTraitDef(cf: Conform) -> U64 {
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val t: TraitDef = self.decls.traits[ti]
            // `Conform.traitStart` is the declaration owner selected while
            // lowering the authored `as Trait` occurrence.  Do not recover a
            // trait from spelling/arity here: same-spelling declarations may
            // have different requirements.
            if t.nameStart == cf.traitStart { return ti }
            ti += 1
        }
        return self.decls.traits.count()
    }

    inout fn checkAnyFormation() {
        mut val ti: U64 = 0
        while ti < self.arena.types.count() {
            val t: TypeRef = self.arena.types[ti]
            if t.isAny {
                val tri: U64 = self.findTraitIdxByName(start: t.nameStart, len: t.nameLen)
                if tri < self.decls.traits.count() {
                    val tr: TraitDef = self.decls.traits[tri]
                    // count positional bindings (argLabels entry 0 / absent).
                    mut val positional: U64 = 0
                    mut val ai: U64 = 0
                    while ai < t.args.count() {
                        mut val lbl: U64 = 0
                        if ai < t.argLabels.count() {
                            lbl = t.argLabels[ai]
                        }
                        if lbl == 0U64 {
                            positional += 1U64
                        }
                        ai += 1
                    }
                    // each type parameter is bound positionally or by name.
                    mut val tpi: U64 = 0
                    mut val posNeed: U64 = 0
                    while tpi < tr.typeParams.count() {
                        if !(self.anyHasNamedBinding(t: t, nameId: tr.typeParams[tpi].nameId)) {
                            posNeed += 1U64
                        }
                        tpi += 1
                    }
                    if positional < posNeed {
                        self.errorAt(offset: t.nameStart, msg: "`any P` leaves a type parameter unbound — bind all of the trait's type arguments (spec/08)")
                    }
                    // each associated type must be bound by name.
                    mut val asi: U64 = 0
                    while asi < tr.assocTypes.count() {
                        if !(self.anyHasNamedBinding(t: t, nameId: tr.assocTypes[asi].nameId)) {
                            self.errorAt(offset: t.nameStart, msg: "`any P` leaves an associated type unbound — bind it as `any P[Item=Type]` (spec/08)")
                        }
                        asi += 1
                    }
                } else {
                    self.errorAt(offset: t.nameStart, msg: "`any P` names an unknown trait — `any` exists only over a trait (spec/08)")
                }
            }
            ti += 1
        }
    }

    inout fn anyHasNamedBinding(t: TypeRef, nameId: U64) -> Bool {
        mut val i: U64 = 0
        while i < t.args.count() {
            if i < t.argLabels.count() {
                if t.argLabels[i] == nameId && nameId != 0U64 {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn checkConformances() {
        mut val ci: U64 = 0
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.derived {
                // compiler-synthesized (`@[Eq]`/`@[Ord]`): trivially complete, and its
                // trait is compiler-known — exempt from unknown-trait/completeness.
                ci += 1
            } else {
            // resolve the one trait this conformance refers to (structural — see
            // resolveTraitDef); a conformance to an undeclared/unimported trait is a
            // loud error (spec/08: explicit conformance).
            val ti: U64 = self.resolveTraitDef(cf: cf)
            if ti < self.decls.traits.count() {
                val t: TraitDef = self.decls.traits[ti]
                // Re-check the requirements of the exact declaration owner.
                mut val ri: U64 = 0
                while ri < t.reqs.count() {
                    val r: Func = t.reqs[ri]
                    if !(self.witnessedHas(witnessed: cf.witnessed, r: r, recvStart: cf.typeStart, recvLen: cf.typeLen, tps: t.typeParams, targs: cf.traitArgs)) {
                        self.errorAt(offset: cf.typeStart, msg: "incomplete trait conformance: a requirement is not witnessed (define its body or bind it with `via`)")
                    }
                    ri += 1
                }
                // supertraits (spec/08): conforming to Sub requires conforming to
                // each Super (a constraint, not auto-implemented).
                mut val sti: U64 = 0
                while sti < t.supertraits.count() {
                    val sup: Bind = t.supertraits[sti]
                    if !(self.bareConformanceCoversSubject(subject: cf, traitStart: sup.nameStart, traitLen: sup.nameLen)) {
                        self.errorAt(offset: cf.typeStart, msg: "supertrait not satisfied: this type must also conform to the trait's supertrait")
                    }
                    sti += 1
                }
            } else {
                self.errorAt(offset: cf.traitStart, msg: "conformance to an unknown trait (is it declared / imported?)")
            }
            ci += 1
            }
        }
        self.checkViaTargets()
    }

    inout fn typeHasMember(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return true
                    }
                }
            } else {
                if f.isAssoc {
                    if f.recvId == qRecv {
                        if f.nameId == qName {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn checkViaTargets() {
        mut val i: U64 = 0
        while i < self.decls.methodAliases.count() {
            val al: MethodAlias = self.decls.methodAliases[i]
            if !(self.typeHasMember(recvStart: al.recvStart, recvLen: al.recvLen, nameStart: al.realStart, nameLen: al.realLen)) {
                self.errorAt(offset: al.aliasStart, msg: "`via` target is not a member of this type")
            }
            i += 1
        }
    }

    inout fn typeConformsTo(typeStart: U64, typeLen: U64, traitStart: U64, traitLen: U64) -> Bool {
        // No structural shortcut for Eq/Ord: every conformance is an explicit `impl` (spec/12,
        // operators are trait sugar). Primitives conform via their real `impl I64 as Eq`/`as
        // Ord` witnesses in Core/Num.pw, String via `impl String as Eq` in Core — all recorded
        // in decls.conforms below. A type with no witness (String/Bool have no `Ord`) correctly
        // fails the bound, the same clean reject a missing struct/enum witness gives.
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            // A named extension contributes a conformance only through its
            // explicit view.  Letting it satisfy a bare bound leaks opt-in
            // meaning from `value#Ext` into plain `value`.
            if cf.extId == 0U64 && cf.typeId == qType {
                // An unparameterized spelling is the arity-zero instance,
                // never a shorthand for `Trait[...]`.
                if cf.traitStart == traitStart && cf.traitLen == traitLen && cf.traitArgs.count() == 0U64 {
                    return true
                }
            }
            i += 1
        }
        // a `newtype` inherits the underlying type's trait conformances automatically
        // (spec/10), so `UserId = String` satisfies `where T: Format` because String
        // does — `print(u)` type-checks and dispatches to the underlying's witness.
        mut val ni: U64 = 0
        while ni < self.arena.newtypes.count() {
            if self.arena.newtypes[ni].nameId == qType {
                return self.typeConformsTo(typeStart: self.arena.newtypes[ni].underStart, typeLen: self.arena.newtypes[ni].underLen, traitStart: traitStart, traitLen: traitLen)
            }
            ni += 1
        }
        return false
    }

    // The witness fn (assoc or method) named (nameStart,nameLen) on type (typeStart,typeLen),
    // by receiver + name id — used to reach a conditional impl's `where`-bounds, which the
    // lowerer records as funcBounds on each witness fn (Lower/Impl.pw). funcs.count() = none.
    inout fn witnessFnFor(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> U64 {
        val qRecv: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.isAssoc || f.hasRecv {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    // Does the concrete type INSTANCE `ref` (a TypeRef, args carried) conform to the trait?
    // The single authoritative conformance query — CONDITIONAL conformance is a first-class
    // answer here, not a cascade of name checks across monomorphization levels. For
    // `impl[T] Array[T] as Eq where T: Eq`, `Array[NoEq]` returns FALSE by binding the impl's
    // `where` bound (recorded as a funcBound on the witness `Array.eq`, its param at position
    // i in the witness typeParams ↔ instance arg i) and recursing on `NoEq`. Name-level
    // conformance (primitive/String registered impls, newtype inheritance) is delegated to
    // `typeConformsTo`; the recursion terminates on finite type depth. Both the operator gate
    // (hasCompareWitness) and the `where` bound-check consult this, so acceptance == the
    // reality of instantiation and the diagnostic lands where the type is written.
    inout fn conformsInstance(ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = []) -> Bool {
        if ref >= self.arena.types.count() {
            return false
        }
        val rr: U64 = self.resolveTy(tyRef: ref)
        if rr != ref {
            return self.conformsInstance(ref: rr, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues)
        }
        val t: TypeRef = self.arena.types[ref]
        if t.assocNameId != 0U64 {
            return false
        }
        // Newtypes inherit the underlying type's conformance surface.  This
        // must happen before the full-subject candidate scan below: the scan is
        // deliberately exact for generic subjects, but a newtype has no copied
        // `Conform` entry of its own.  Delegating through the underlying
        // TypeRef keeps direct bounds, generic bounds, and method bounds on the
        // same `conformsInstance` authority.
        val underlying: U64 = self.newtypeUnderRef(start: t.nameStart, len: t.nameLen)
        if underlying != 0U64 && underlying != ref {
            return self.conformsInstance(ref: underlying, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues)
        }
        // Candidate existence is not conformance.  Match the full subject
        // pattern here, so `impl Box[I64] as P` never grants P to Box[String].
        mut val applies: Bool = false
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.extId == 0U64 && cf.traitStart == traitStart && cf.traitLen == traitLen {
                val matchResult: WitnessMatch = self.conformanceWitnessMatch(conformIdx: ci, typeRef: ref, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen)
                if matchResult.conformIdx != 0U64 {
                    if self.traitAssocOutputsMatch(cf: cf, matchResult: matchResult, assocNames: assocNames, assocValues: assocValues) {
                        applies = true
                    }
                }
            }
            ci += 1U64
        }
        if !(applies) { return false }
        // a non-generic instance (no args) has no conditional bounds to check.
        if t.args.count() == 0U64 {
            return true
        }
        // conditional impl: check the impl-level `where` bounds against THIS instance's args.
        mut val traitIdx: U64 = self.decls.traits.count()
        mut val traitScan: U64 = 0U64
        while traitScan < self.decls.traits.count() {
            if self.decls.traits[traitScan].nameStart == traitStart && self.decls.traits[traitScan].nameLen == traitLen {
                traitIdx = traitScan
            }
            traitScan += 1U64
        }
        if traitIdx >= self.decls.traits.count() {
            return true
        }
        val tr: TraitDef = self.decls.traits[traitIdx]
        if tr.reqs.count() == 0U64 {
            return true
        }
        // any requirement's witness carries the impl-level bounds (the lowerer duplicates them
        // onto every method of the impl), so one witness fn suffices to read them.
        val wfi: U64 = self.witnessFnFor(typeStart: t.nameStart, typeLen: t.nameLen, nameStart: tr.reqs[0].nameStart, nameLen: tr.reqs[0].nameLen)
        if wfi >= self.arena.funcs.count() {
            return true
        }
        val wf: Func = self.arena.funcs[wfi]
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == wfi {
                if fb.paramTy != 0U64 {
                    val lhs: U64 = self.groundTermInEnvironment(ref: fb.paramTy, params: wf.typeParams, values: t.args)
                    val constraint: TraitConstraint = self.groundTraitConstraintInEnvironment(constraint: fb.constraint, params: wf.typeParams, args: t.args)
                    if lhs >= self.arena.types.count() {
                        return false
                    }
                    if !(self.tyRefIsGround(ref: lhs)) {
                        return false
                    }
                    if !(self.conformsTraitConstraint(ref: lhs, constraint: constraint)) {
                        return false
                    }
                    bi += 1
                } else {
                // map the bound's type-param name to its position in the witness type params;
                // a receiver/impl param (position < instance arity) is checked against the
                // matching instance arg, a method-own param (position ≥ arity) is unrelated
                // to this instance and skipped.
                mut val pos: U64 = wf.typeParams.count()
                mut val k: U64 = 0
                while k < wf.typeParams.count() {
                    if wf.typeParams[k].nameId == fb.paramNameId {
                        pos = k
                    }
                    k += 1
                }
                if pos < t.args.count() {
                    val constraint: TraitConstraint = self.groundTraitConstraintInEnvironment(constraint: fb.constraint, params: wf.typeParams, args: t.args)
                    if !(self.conformsTraitConstraint(ref: t.args[pos], constraint: constraint)) {
                        return false
                    }
                }
                bi += 1
                }
            } else {
                bi += 1
            }
        }
        return true
    }

    inout fn typeConformsToName(typeStart: U64, typeLen: U64, traitName: String) -> Bool {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if cf.typeId == qType {
                if rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: traitName) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // The `where` bounds of ONE free-function instance — callable per instance so a
    // DEMAND-registered instance (ensureFnInst during emission, after the collection-time
    // checkFnBounds sweep already ran) gets the same soundness check as an eagerly
    // collected one, instead of silently escaping it.
    inout fn checkOneFnInstBounds(fin: FnInst) {
        val f: Func = self.arena.funcs[fin.fnIdx]
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == fin.fnIdx {
                val constraint: TraitConstraint = self.groundTraitConstraintInEnvironment(constraint: fb.constraint, params: f.typeParams, args: fin.args)
                if fb.paramTy != 0U64 {
                    val lhs: U64 = self.groundTermInEnvironment(ref: fb.paramTy, params: f.typeParams, values: fin.args)
                    if lhs < self.arena.types.count() {
                        val ok: Bool = self.viewedTypeConformsTraitConstraint(ref: lhs, constraint: constraint)
                        if !ok {
                            self.errorAt(offset: f.defOffset, msg: "type argument does not conform to the trait required by `where`")
                        }
                    }
                    bi += 1
                } else {
                mut val pi: U64 = 0
                while pi < f.typeParams.count() {
                    val tp: Bind = f.typeParams[pi]
                    if tp.nameId == fb.paramNameId {
                        if pi < fin.args.count() {
                            // a `#`-viewed type argument (`f(a: s#P)` / `g(x#Ext)`,
                            // spec/09) satisfies the bound via the conformance path the
                            // view selects, even when the bare type does not conform.
                            // conformsInstance checks CONDITIONAL conformance against the
                            // arg's full ref (`Array[NoEq]` ⟹ false here, at this bound's
                            // location — no deferral to a deeper monomorphization level).
                            val ok: Bool = self.viewedTypeConformsTraitConstraint(ref: fin.args[pi], constraint: constraint)
                            if !ok {
                                self.errorAt(offset: f.defOffset, msg: "type argument does not conform to the trait required by `where`")
                            }
                        }
                    }
                    pi += 1
                }
                bi += 1
                }
            } else {
                bi += 1
            }
        }
    }

    inout fn checkFnBounds() {
        mut val ii: U64 = 0
        while ii < self.monoWork.fnInsts.count() {
            self.checkOneFnInstBounds(fin: self.monoWork.fnInsts[ii])
            ii += 1
        }
        self.checkMethodBounds()
    }

    // A generic method's substitutions are not positional aliases for the
    // receiver declaration's substitutions.  Derive the method environment by
    // matching its declared receiver pattern against this concrete instance;
    // the resulting WitnessMatch is the same directional binder map used by
    // conformance proofs.  This is the first concrete InstanceEnvironment
    // consumer while the flat Cursor arrays are being retired.
    inout fn methodReceiverEnvironment(f: Func, instRef: U64) -> WitnessMatch {
        if f.recvTy == 0U64 || instRef == 0U64 { return <WitnessMatch /> }
        val noArgs: Array[U64] = []
        return self.conformancePatternWitnessMatch(conformIdx: 0U64, subjectId: f.recvId, subjectTy: f.recvTy, subjectArgs: noArgs, typeParams: f.typeParams, declaredTraitArgs: noArgs, typeRef: instRef, traitArgs: noArgs)
    }

    inout fn checkMethodBounds() {
        mut val gi: U64 = 0
        while gi < self.monoWork.genInsts.count() {
            val instRef: U64 = self.monoWork.genInsts[gi]
            val inst: TypeRef = self.arena.types[instRef]
            mut val mfi: U64 = 0
            while mfi < self.arena.funcs.count() {
                if self.methodMatchesInst(f: self.arena.funcs[mfi], instRef: instRef) {
                    val f: Func = self.arena.funcs[mfi]
                    mut val bi: U64 = 0
                    while bi < self.decls.funcBounds.count() {
                        val fb: FuncBound = self.decls.funcBounds[bi]
                        if fb.fnIdx == mfi {
                            val receiverEnv: WitnessMatch = self.methodReceiverEnvironment(f: f, instRef: instRef)
                            mut val constraint: TraitConstraint = self.groundTraitConstraintInEnvironment(constraint: fb.constraint, params: f.typeParams, args: inst.args)
                            if receiverEnv.conformIdx != 0U64 {
                                mut val positional: Array[U64] = []
                                mut val bai: U64 = 0U64
                                while bai < constraint.key.positionalArgs.count() {
                                    positional.append(self.groundWitnessTypeTerm(ref: constraint.key.positionalArgs[bai], params: f.typeParams, matchResult: receiverEnv))
                                    bai += 1U64
                                }
                                mut val predicates: Array[TraitAssocPredicate] = []
                                bai = 0U64
                                while bai < constraint.assocPredicates.count() {
                                    val predicate: TraitAssocPredicate = constraint.assocPredicates[bai]
                                    predicates.append(<TraitAssocPredicate member=predicate.member value=self.groundWitnessTypeTerm(ref: predicate.value, params: f.typeParams, matchResult: receiverEnv) span=predicate.span />)
                                    bai += 1U64
                                }
                                constraint = <TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=positional /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates />
                            }
                            if fb.paramTy != 0U64 {
                                mut val lhs: U64 = 0U64
                                if receiverEnv.conformIdx != 0U64 {
                                    lhs = self.groundWitnessTypeTerm(ref: fb.paramTy, params: f.typeParams, matchResult: receiverEnv)
                                } else {
                                    lhs = self.groundTermInEnvironment(ref: fb.paramTy, params: f.typeParams, values: inst.args)
                                }
                                if lhs < self.arena.types.count() {
                                    val ok: Bool = self.viewedTypeConformsTraitConstraint(ref: lhs, constraint: constraint)
                                    if !ok {
                                        self.errorAt(offset: fb.paramStart, msg: "receiver type argument does not conform to the trait required by the method's `where`")
                                    }
                                }
                            } else {
                            mut val pi: U64 = 0
                            while pi < f.typeParams.count() {
                                val tp: Bind = f.typeParams[pi]
                                if tp.nameId == fb.paramNameId {
                                    if pi < inst.args.count() {
                                        if !(self.conformsTraitConstraint(ref: inst.args[pi], constraint: constraint)) {
                                            self.errorAt(offset: fb.paramStart, msg: "receiver type argument does not conform to the trait required by the method's `where`")
                                        }
                                    }
                                }
                                pi += 1
                            }
                            }
                        }
                        bi += 1
                    }
                }
                mfi += 1
            }
            gi += 1
        }
    }
}
