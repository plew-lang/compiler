// Part of compile-time checks (root: _.pw): trait-bound and conformance
// validation.

// The concrete type span that the conforming type `(recvStart,recvLen)` binds for
// the associated type named `(nameStart,nameLen)` (spec/08 `type Item = Concrete`),
// or the input name unchanged when it is not an associated type / has no binding.

pub impl Comp {
    // Ground the full trait key of a bound in the function/method instance that
    // owns it.  Trait arguments belong to the bound, not to a later resolver
    // fallback: `where T: Add[T]` becomes `Add[I64]` for T=I64 here.
    inout fn groundedBoundTraitArgs(fb: FuncBound, params: Array[Bind], args: Array[U64]) -> Array[U64] {
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        self.cur.typeParams = params
        self.cur.typeArgs = args
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < fb.traitArgs.count() {
            out.append(self.groundTypeRef(ref: fb.traitArgs[i]))
            i += 1U64
        }
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        return out
    }

    inout fn groundedBoundTraitAssocValues(fb: FuncBound, params: Array[Bind], args: Array[U64]) -> Array[U64] {
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        self.cur.typeParams = params
        self.cur.typeArgs = args
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < fb.traitAssocValues.count() {
            out.append(self.groundTypeRef(ref: fb.traitAssocValues[i]))
            i += 1U64
        }
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        return out
    }

    // A named trait argument constrains an associated output after the
    // positional instance key selected a conformance witness.
    // The selected conformance is the witness identity.  Do not look up an
    // associated output by receiver spelling: one receiver may implement the
    // same parameterized trait more than once, and an extension witness is
    // distinct from a bare one.  `implOffset` ties the output to that witness.
    inout fn traitAssocOutputsMatch(cf: Conform, assocNames: Array[U64], assocValues: Array[U64]) -> Bool {
        if assocNames.count() != assocValues.count() { return false }
        if assocNames.count() == 0U64 { return true }
        mut val need: U64 = 0U64
        while need < assocNames.count() {
            mut val found: Bool = false
            mut val i: U64 = 0U64
            while i < self.decls.assocBindings.count() {
                val ab: AssocBinding = self.decls.assocBindings[i]
                if ab.implOffset == cf.defOffset && ab.traitId == cf.traitId && ab.nameId == assocNames[need] {
                    if self.typesCompatible(expected: assocValues[need], inferred: ab.ty) { found = true }
                }
                i += 1U64
            }
            if !found { return false }
            need += 1U64
        }
        return true
    }

    // A view is an unordered source set.  Bounds may use any active extension
    // source to establish the requested conformance; the trait selector itself
    // is already validated as singular when the TypeRef/value view is formed.
    inout fn viewedTypeConforms(ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = []) -> Bool {
        if ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[ref]
        if self.conformsInstance(ref: ref, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues) { return true }
        mut val i: U64 = 0U64
        while i < t.viewIds.count() {
            if self.viewConformsTo(typeStart: t.nameStart, typeLen: t.nameLen, typeRef: ref, viewId: t.viewIds[i], traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, assocNames: assocNames, assocValues: assocValues) { return true }
            i += 1U64
        }
        if t.viewIds.count() == 0U64 && t.viewExtId != 0U64 {
            return self.viewConformsTo(typeStart: t.nameStart, typeLen: t.nameLen, typeRef: ref, viewId: t.viewExtId, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, assocNames: assocNames, assocValues: assocValues)
        }
        return false
    }

    inout fn assocBindingSpan(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bind {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.assocBindings.count() {
            val ab: AssocBinding = self.decls.assocBindings[i]
            if ab.recvId == qRecv {
                if ab.nameId == qName {
                    return <Bind nameStart=ab.tyStart nameLen=ab.tyLen nameId=intern(c: inout self, start: ab.tyStart, len: ab.tyLen) fieldStart=ab.tyStart fieldLen=ab.tyLen />
                }
            }
            i += 1
        }
        return <Bind nameStart=nameStart nameLen=nameLen nameId=qName fieldStart=nameStart fieldLen=nameLen />
    }

    inout fn substReqParamHeadId(recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64], prStart: U64, prLen: U64) -> U64 {
        if rangeEquals(bytes: self.arena.bytes, start: prStart, len: prLen, kw: "Self") {
            return intern(c: inout self, start: recvStart, len: recvLen)
        }
        val prId: U64 = intern(c: inout self, start: prStart, len: prLen)
        mut val k: U64 = 0
        while k < tps.count() {
            if tps[k].nameId == prId {
                if k < targs.count() {
                    return self.arena.types[targs[k]].nameId
                }
            }
            k += 1
        }
        val sub: Bind = self.assocBindingSpan(recvStart: recvStart, recvLen: recvLen, nameStart: prStart, nameLen: prLen)
        return sub.nameId
    }

    inout fn substReqParamArrayElemRef(tps: Array[Bind], targs: Array[U64], prStart: U64, prLen: U64) -> U64 {
        val prId: U64 = intern(c: inout self, start: prStart, len: prLen)
        mut val k: U64 = 0
        while k < tps.count() {
            if tps[k].nameId == prId {
                if k < targs.count() {
                    val tr: TypeRef = self.arena.types[targs[k]]
                    if rangeEquals(bytes: self.arena.bytes, start: tr.nameStart, len: tr.nameLen, kw: "Array") {
                        if tr.args.count() > 0U64 {
                            return targs[k]
                        }
                    }
                }
            }
            k += 1
        }
        return 0U64
    }

    inout fn paramSelectorEqSubst(w: Array[Param], r: Array[Param], recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64]) -> Bool {
        if w.count() != r.count() {
            return false
        }
        mut val i: U64 = 0
        while i < w.count() {
            val pw: Param = w[i]
            val pr: Param = r[i]
            if pw.nameId != pr.nameId {
                return false
            }
            // a requirement param that substitutes to an `Array[Elem]` (e.g. `convert(from:
            // Source)` with `impl String as TryFrom[Array[U8]]`): the witness side writes it
            // as an array param (`from: Array[U8]`, head id = the ELEMENT), so compare arrayness
            // + element rather than the bare head ("Array" vs "U8" would never match).
            val arrTarg: U64 = self.substReqParamArrayElemRef(tps: tps, targs: targs, prStart: pr.tyStart, prLen: pr.tyLen)
            if arrTarg != 0U64 {
                if pw.tyIsArray {
                    val elemRef: U64 = self.arena.types[arrTarg].args[0]
                    if pw.tyNameId == self.arena.types[elemRef].nameId {
                        i += 1
                    } else {
                        return false
                    }
                } else {
                    return false
                }
            } else {
            val subId: U64 = self.substReqParamHeadId(recvStart: recvStart, recvLen: recvLen, tps: tps, targs: targs, prStart: pr.tyStart, prLen: pr.tyLen)
            // the WITNESS side may also write `Self` (`fn eqTo(other: Self)` inside
            // `impl P as MyEq`): substitute its Self -> the conforming type too, so the
            // requirement's substituted Self (=recv) matches it. A concrete witness type
            // (`other: P`) keeps its own head id (pw.tyNameId).
            mut val wId: U64 = pw.tyNameId
            if rangeEquals(bytes: self.arena.bytes, start: pw.tyStart, len: pw.tyLen, kw: "Self") {
                wId = intern(c: inout self, start: recvStart, len: recvLen)
            }
            if wId != subId {
                return false
            }
            i += 1
            }
        }
        return true
    }

    inout fn reqReturnMismatch(w: Func, r: Func, recvStart: U64, recvLen: U64) -> Bool {
        if !(r.hasRet) {
            return false
        }
        if r.retIsArray {
            return false
        }
        // resolve an associated-type requirement return (`fn first()->Item` with
        // `type Item = I64`) through the conformance's binding, so the witness's concrete
        // return is compared to the bound concrete type.
        val rr: Bind = self.assocBindingSpan(recvStart: recvStart, recvLen: recvLen, nameStart: r.retStart, nameLen: r.retLen)
        if !(self.isPrimType(start: rr.nameStart, len: rr.nameLen)) {
            return false
        }
        // requirement returns a concrete primitive: the witness must return it exactly.
        if !(w.hasRet) {
            return true
        }
        if w.retIsArray {
            return true
        }
        if spansEqual(c: inout self, aStart: rr.nameStart, aLen: rr.nameLen, bStart: w.retStart, bLen: w.retLen) {
            return false
        }
        return true
    }

    inout fn witnessedHas(witnessed: Array[Func], r: Func, recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64]) -> Bool {
        mut val i: U64 = 0
        while i < witnessed.count() {
            val w: Func = witnessed[i]
            if w.nameId == r.nameId {
                if self.paramSelectorEqSubst(w: w.params, r: r.params, recvStart: recvStart, recvLen: recvLen, tps: tps, targs: targs) {
                    if !(self.reqReturnMismatch(w: w, r: r, recvStart: recvStart, recvLen: recvLen)) {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn confWitnessesAll(cf: Conform, t: TraitDef) -> Bool {
        mut val ri: U64 = 0
        while ri < t.reqs.count() {
            val r: Func = t.reqs[ri]
            if !(self.witnessedHas(witnessed: cf.witnessed, r: r, recvStart: cf.typeStart, recvLen: cf.typeLen, tps: t.typeParams, targs: cf.traitArgs)) {
                return false
            }
            ri += 1
        }
        return true
    }

    inout fn resolveTraitDef(cf: Conform) -> U64 {
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val t: TraitDef = self.decls.traits[ti]
            // `Conform.traitStart` is the declaration owner selected while
            // lowering the authored `as Trait` occurrence.  Do not recover a
            // trait from spelling/arity here: same-spelling declarations may
            // have different requirements.
            if t.nameStart == cf.traitStart { return ti }
            ti += 1
        }
        return self.decls.traits.count()
    }

    inout fn checkAnyFormation() {
        mut val ti: U64 = 0
        while ti < self.arena.types.count() {
            val t: TypeRef = self.arena.types[ti]
            if t.isAny {
                val tri: U64 = self.findTraitIdxByName(start: t.nameStart, len: t.nameLen)
                if tri < self.decls.traits.count() {
                    val tr: TraitDef = self.decls.traits[tri]
                    // count positional bindings (argLabels entry 0 / absent).
                    mut val positional: U64 = 0
                    mut val ai: U64 = 0
                    while ai < t.args.count() {
                        mut val lbl: U64 = 0
                        if ai < t.argLabels.count() {
                            lbl = t.argLabels[ai]
                        }
                        if lbl == 0U64 {
                            positional += 1U64
                        }
                        ai += 1
                    }
                    // each type parameter is bound positionally or by name.
                    mut val tpi: U64 = 0
                    mut val posNeed: U64 = 0
                    while tpi < tr.typeParams.count() {
                        if !(self.anyHasNamedBinding(t: t, nameId: tr.typeParams[tpi].nameId)) {
                            posNeed += 1U64
                        }
                        tpi += 1
                    }
                    if positional < posNeed {
                        self.errorAt(offset: t.nameStart, msg: "`any P` leaves a type parameter unbound — bind all of the trait's type arguments (spec/08)")
                    }
                    // each associated type must be bound by name.
                    mut val asi: U64 = 0
                    while asi < tr.assocTypes.count() {
                        if !(self.anyHasNamedBinding(t: t, nameId: tr.assocTypes[asi].nameId)) {
                            self.errorAt(offset: t.nameStart, msg: "`any P` leaves an associated type unbound — bind it as `any P[Item=Type]` (spec/08)")
                        }
                        asi += 1
                    }
                } else {
                    self.errorAt(offset: t.nameStart, msg: "`any P` names an unknown trait — `any` exists only over a trait (spec/08)")
                }
            }
            ti += 1
        }
    }

    inout fn anyHasNamedBinding(t: TypeRef, nameId: U64) -> Bool {
        mut val i: U64 = 0
        while i < t.args.count() {
            if i < t.argLabels.count() {
                if t.argLabels[i] == nameId && nameId != 0U64 {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn checkConformances() {
        mut val ci: U64 = 0
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.derived {
                // compiler-synthesized (`@[Eq]`/`@[Ord]`): trivially complete, and its
                // trait is compiler-known — exempt from unknown-trait/completeness.
                ci += 1
            } else {
            // resolve the one trait this conformance refers to (structural — see
            // resolveTraitDef); a conformance to an undeclared/unimported trait is a
            // loud error (spec/08: explicit conformance).
            val ti: U64 = self.resolveTraitDef(cf: cf)
            if ti < self.decls.traits.count() {
                val t: TraitDef = self.decls.traits[ti]
                // Re-check the requirements of the exact declaration owner.
                mut val ri: U64 = 0
                while ri < t.reqs.count() {
                    val r: Func = t.reqs[ri]
                    if !(self.witnessedHas(witnessed: cf.witnessed, r: r, recvStart: cf.typeStart, recvLen: cf.typeLen, tps: t.typeParams, targs: cf.traitArgs)) {
                        self.errorAt(offset: cf.typeStart, msg: "incomplete trait conformance: a requirement is not witnessed (define its body or bind it with `via`)")
                    }
                    ri += 1
                }
                // supertraits (spec/08): conforming to Sub requires conforming to
                // each Super (a constraint, not auto-implemented).
                mut val sti: U64 = 0
                while sti < t.supertraits.count() {
                    val sup: Bind = t.supertraits[sti]
                    if !(self.bareConformanceCoversSubject(subject: cf, traitStart: sup.nameStart, traitLen: sup.nameLen)) {
                        self.errorAt(offset: cf.typeStart, msg: "supertrait not satisfied: this type must also conform to the trait's supertrait")
                    }
                    sti += 1
                }
            } else {
                self.errorAt(offset: cf.traitStart, msg: "conformance to an unknown trait (is it declared / imported?)")
            }
            ci += 1
            }
        }
        self.checkViaTargets()
    }

    inout fn typeHasMember(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return true
                    }
                }
            } else {
                if f.isAssoc {
                    if f.recvId == qRecv {
                        if f.nameId == qName {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn checkViaTargets() {
        mut val i: U64 = 0
        while i < self.decls.methodAliases.count() {
            val al: MethodAlias = self.decls.methodAliases[i]
            if !(self.typeHasMember(recvStart: al.recvStart, recvLen: al.recvLen, nameStart: al.realStart, nameLen: al.realLen)) {
                self.errorAt(offset: al.aliasStart, msg: "`via` target is not a member of this type")
            }
            i += 1
        }
    }

    inout fn typeConformsTo(typeStart: U64, typeLen: U64, traitStart: U64, traitLen: U64) -> Bool {
        // No structural shortcut for Eq/Ord: every conformance is an explicit `impl` (spec/12,
        // operators are trait sugar). Primitives conform via their real `impl I64 as Eq`/`as
        // Ord` witnesses in Core/Num.pw, String via `impl String as Eq` in Core — all recorded
        // in decls.conforms below. A type with no witness (String/Bool have no `Ord`) correctly
        // fails the bound, the same clean reject a missing struct/enum witness gives.
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        val qTrait: U64 = intern(c: inout self, start: traitStart, len: traitLen)
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            // A named extension contributes a conformance only through its
            // explicit view.  Letting it satisfy a bare bound leaks opt-in
            // meaning from `value#Ext` into plain `value`.
            if cf.extId == 0U64 && cf.typeId == qType {
                // An unparameterized spelling is the arity-zero instance,
                // never a shorthand for `Trait[...]`.
                if cf.traitId == qTrait && cf.traitArgs.count() == 0U64 {
                    return true
                }
            }
            i += 1
        }
        // a `newtype` inherits the underlying type's trait conformances automatically
        // (spec/10), so `UserId = String` satisfies `where T: Format` because String
        // does — `print(u)` type-checks and dispatches to the underlying's witness.
        mut val ni: U64 = 0
        while ni < self.arena.newtypes.count() {
            if self.arena.newtypes[ni].nameId == qType {
                return self.typeConformsTo(typeStart: self.arena.newtypes[ni].underStart, typeLen: self.arena.newtypes[ni].underLen, traitStart: traitStart, traitLen: traitLen)
            }
            ni += 1
        }
        return false
    }

    // The witness fn (assoc or method) named (nameStart,nameLen) on type (typeStart,typeLen),
    // by receiver + name id — used to reach a conditional impl's `where`-bounds, which the
    // lowerer records as funcBounds on each witness fn (Lower/Impl.pw). funcs.count() = none.
    inout fn witnessFnFor(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> U64 {
        val qRecv: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.isAssoc || f.hasRecv {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    // Does the concrete type INSTANCE `ref` (a TypeRef, args carried) conform to the trait?
    // The single authoritative conformance query — CONDITIONAL conformance is a first-class
    // answer here, not a cascade of name checks across monomorphization levels. For
    // `impl[T] Array[T] as Eq where T: Eq`, `Array[NoEq]` returns FALSE by binding the impl's
    // `where` bound (recorded as a funcBound on the witness `Array.eq`, its param at position
    // i in the witness typeParams ↔ instance arg i) and recursing on `NoEq`. Name-level
    // conformance (primitive/String registered impls, newtype inheritance) is delegated to
    // `typeConformsTo`; the recursion terminates on finite type depth. Both the operator gate
    // (hasCompareWitness) and the `where` bound-check consult this, so acceptance == the
    // reality of instantiation and the diagnostic lands where the type is written.
    inout fn conformsInstance(ref: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = [], traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = []) -> Bool {
        if ref >= self.arena.types.count() {
            return false
        }
        val rr: U64 = self.resolveTy(tyRef: ref)
        if rr != ref {
            return self.conformsInstance(ref: rr, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues)
        }
        val t: TypeRef = self.arena.types[ref]
        if t.assocNameId != 0U64 {
            return false
        }
        // Newtypes inherit the underlying type's conformance surface.  This
        // must happen before the full-subject candidate scan below: the scan is
        // deliberately exact for generic subjects, but a newtype has no copied
        // `Conform` entry of its own.  Delegating through the underlying
        // TypeRef keeps direct bounds, generic bounds, and method bounds on the
        // same `conformsInstance` authority.
        val underlying: U64 = self.newtypeUnderRef(start: t.nameStart, len: t.nameLen)
        if underlying != 0U64 && underlying != ref {
            return self.conformsInstance(ref: underlying, traitStart: traitStart, traitLen: traitLen, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues)
        }
        // Candidate existence is not conformance.  Match the full subject
        // pattern here, so `impl Box[I64] as P` never grants P to Box[String].
        val qTrait: U64 = intern(c: inout self, start: traitStart, len: traitLen)
        mut val applies: Bool = false
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.extId == 0U64 && cf.traitId == qTrait {
                if self.conformanceMatchesTraitInstance(cf: cf, typeRef: ref, traitArgs: traitArgs, traitArgsOpen: traitArgsOpen) {
                    if self.traitAssocOutputsMatch(cf: cf, assocNames: assocNames, assocValues: assocValues) {
                        applies = true
                    }
                }
            }
            ci += 1U64
        }
        if !(applies) { return false }
        // a non-generic instance (no args) has no conditional bounds to check.
        if t.args.count() == 0U64 {
            return true
        }
        // conditional impl: check the impl-level `where` bounds against THIS instance's args.
        val traitIdx: U64 = self.findTraitIdxByName(start: traitStart, len: traitLen)
        if traitIdx >= self.decls.traits.count() {
            return true
        }
        val tr: TraitDef = self.decls.traits[traitIdx]
        if tr.reqs.count() == 0U64 {
            return true
        }
        // any requirement's witness carries the impl-level bounds (the lowerer duplicates them
        // onto every method of the impl), so one witness fn suffices to read them.
        val wfi: U64 = self.witnessFnFor(typeStart: t.nameStart, typeLen: t.nameLen, nameStart: tr.reqs[0].nameStart, nameLen: tr.reqs[0].nameLen)
        if wfi >= self.arena.funcs.count() {
            return true
        }
        val wf: Func = self.arena.funcs[wfi]
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == wfi {
                if fb.paramTy != 0U64 {
                    val savedP: Array[Bind] = self.cur.typeParams
                    val savedA: Array[U64] = self.cur.typeArgs
                    self.cur.typeParams = wf.typeParams
                    self.cur.typeArgs = t.args
                    val lhs: U64 = self.groundTypeRef(ref: fb.paramTy)
                    val boundArgs: Array[U64] = self.groundedBoundTraitArgs(fb: fb, params: wf.typeParams, args: t.args)
                    val boundAssocValues: Array[U64] = self.groundedBoundTraitAssocValues(fb: fb, params: wf.typeParams, args: t.args)
                    self.cur.typeParams = savedP
                    self.cur.typeArgs = savedA
                    if lhs >= self.arena.types.count() {
                        return false
                    }
                    if !(self.tyRefIsGround(ref: lhs)) {
                        return false
                    }
                    if !(self.conformsInstance(ref: lhs, traitStart: fb.traitStart, traitLen: fb.traitLen, traitArgs: boundArgs, traitArgsOpen: boundArgs.count() == 0U64, assocNames: fb.traitAssocNames, assocValues: boundAssocValues)) {
                        return false
                    }
                    bi += 1
                } else {
                // map the bound's type-param name to its position in the witness type params;
                // a receiver/impl param (position < instance arity) is checked against the
                // matching instance arg, a method-own param (position ≥ arity) is unrelated
                // to this instance and skipped.
                mut val pos: U64 = wf.typeParams.count()
                mut val k: U64 = 0
                while k < wf.typeParams.count() {
                    if wf.typeParams[k].nameId == fb.paramNameId {
                        pos = k
                    }
                    k += 1
                }
                if pos < t.args.count() {
                    val boundArgs: Array[U64] = self.groundedBoundTraitArgs(fb: fb, params: wf.typeParams, args: t.args)
                    val boundAssocValues: Array[U64] = self.groundedBoundTraitAssocValues(fb: fb, params: wf.typeParams, args: t.args)
                    if !(self.conformsInstance(ref: t.args[pos], traitStart: fb.traitStart, traitLen: fb.traitLen, traitArgs: boundArgs, traitArgsOpen: boundArgs.count() == 0U64, assocNames: fb.traitAssocNames, assocValues: boundAssocValues)) {
                        return false
                    }
                }
                bi += 1
                }
            } else {
                bi += 1
            }
        }
        return true
    }

    inout fn typeConformsToName(typeStart: U64, typeLen: U64, traitName: String) -> Bool {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if cf.typeId == qType {
                if rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: traitName) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // The `where` bounds of ONE free-function instance — callable per instance so a
    // DEMAND-registered instance (ensureFnInst during emission, after the collection-time
    // checkFnBounds sweep already ran) gets the same soundness check as an eagerly
    // collected one, instead of silently escaping it.
    inout fn checkOneFnInstBounds(fin: FnInst) {
        val f: Func = self.arena.funcs[fin.fnIdx]
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == fin.fnIdx {
                val boundArgs: Array[U64] = self.groundedBoundTraitArgs(fb: fb, params: f.typeParams, args: fin.args)
                val boundAssocValues: Array[U64] = self.groundedBoundTraitAssocValues(fb: fb, params: f.typeParams, args: fin.args)
                if fb.paramTy != 0U64 {
                    val savedP: Array[Bind] = self.cur.typeParams
                    val savedA: Array[U64] = self.cur.typeArgs
                    self.cur.typeParams = f.typeParams
                    self.cur.typeArgs = fin.args
                    val lhs: U64 = self.groundTypeRef(ref: fb.paramTy)
                    self.cur.typeParams = savedP
                    self.cur.typeArgs = savedA
                    if lhs < self.arena.types.count() {
                        val at: TypeRef = self.arena.types[lhs]
                        val ok: Bool = self.viewedTypeConforms(ref: lhs, traitStart: fb.traitStart, traitLen: fb.traitLen, traitArgs: boundArgs, traitArgsOpen: boundArgs.count() == 0U64, assocNames: fb.traitAssocNames, assocValues: boundAssocValues)
                        if !ok {
                            self.errorAt(offset: fb.paramStart, msg: "type argument does not conform to the trait required by `where`")
                        }
                    }
                    bi += 1
                } else {
                mut val pi: U64 = 0
                while pi < f.typeParams.count() {
                    val tp: Bind = f.typeParams[pi]
                    if tp.nameId == fb.paramNameId {
                        if pi < fin.args.count() {
                            val at: TypeRef = self.arena.types[fin.args[pi]]
                            // a `#`-viewed type argument (`f(a: s#P)` / `g(x#Ext)`,
                            // spec/09) satisfies the bound via the conformance path the
                            // view selects, even when the bare type does not conform.
                            // conformsInstance checks CONDITIONAL conformance against the
                            // arg's full ref (`Array[NoEq]` ⟹ false here, at this bound's
                            // location — no deferral to a deeper monomorphization level).
                            val ok: Bool = self.viewedTypeConforms(ref: fin.args[pi], traitStart: fb.traitStart, traitLen: fb.traitLen, traitArgs: boundArgs, traitArgsOpen: boundArgs.count() == 0U64, assocNames: fb.traitAssocNames, assocValues: boundAssocValues)
                            if !ok {
                                self.errorAt(offset: fb.paramStart, msg: "type argument does not conform to the trait required by `where`")
                            }
                        }
                    }
                    pi += 1
                }
                bi += 1
                }
            } else {
                bi += 1
            }
        }
    }

    inout fn checkFnBounds() {
        mut val ii: U64 = 0
        while ii < self.monoWork.fnInsts.count() {
            self.checkOneFnInstBounds(fin: self.monoWork.fnInsts[ii])
            ii += 1
        }
        self.checkMethodBounds()
    }

    inout fn checkMethodBounds() {
        mut val gi: U64 = 0
        while gi < self.monoWork.genInsts.count() {
            val instRef: U64 = self.monoWork.genInsts[gi]
            val inst: TypeRef = self.arena.types[instRef]
            mut val mfi: U64 = 0
            while mfi < self.arena.funcs.count() {
                if self.methodMatchesInst(f: self.arena.funcs[mfi], instRef: instRef) {
                    val f: Func = self.arena.funcs[mfi]
                    mut val bi: U64 = 0
                    while bi < self.decls.funcBounds.count() {
                        val fb: FuncBound = self.decls.funcBounds[bi]
                        if fb.fnIdx == mfi {
                            val boundArgs: Array[U64] = self.groundedBoundTraitArgs(fb: fb, params: f.typeParams, args: inst.args)
                            val boundAssocValues: Array[U64] = self.groundedBoundTraitAssocValues(fb: fb, params: f.typeParams, args: inst.args)
                            if fb.paramTy != 0U64 {
                                val savedP: Array[Bind] = self.cur.typeParams
                                val savedA: Array[U64] = self.cur.typeArgs
                                self.cur.typeParams = f.typeParams
                                self.cur.typeArgs = inst.args
                                val lhs: U64 = self.groundTypeRef(ref: fb.paramTy)
                                self.cur.typeParams = savedP
                                self.cur.typeArgs = savedA
                                if lhs < self.arena.types.count() {
                                    val at: TypeRef = self.arena.types[lhs]
                                    val ok: Bool = self.viewedTypeConforms(ref: lhs, traitStart: fb.traitStart, traitLen: fb.traitLen, traitArgs: boundArgs, traitArgsOpen: boundArgs.count() == 0U64, assocNames: fb.traitAssocNames, assocValues: boundAssocValues)
                                    if !ok {
                                        self.errorAt(offset: fb.paramStart, msg: "receiver type argument does not conform to the trait required by the method's `where`")
                                    }
                                }
                            } else {
                            mut val pi: U64 = 0
                            while pi < f.typeParams.count() {
                                val tp: Bind = f.typeParams[pi]
                                if tp.nameId == fb.paramNameId {
                                    if pi < inst.args.count() {
                                        if !(self.conformsInstance(ref: inst.args[pi], traitStart: fb.traitStart, traitLen: fb.traitLen, traitArgs: boundArgs, traitArgsOpen: boundArgs.count() == 0U64, assocNames: fb.traitAssocNames, assocValues: boundAssocValues)) {
                                            self.errorAt(offset: fb.paramStart, msg: "receiver type argument does not conform to the trait required by the method's `where`")
                                        }
                                    }
                                }
                                pi += 1
                            }
                            }
                        }
                        bi += 1
                    }
                }
                mfi += 1
            }
            gi += 1
        }
    }
}
