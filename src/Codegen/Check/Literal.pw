// Part of compile-time checks (root: _.pw): literal context typing and
// integer-bounds checking.


pub impl Comp {

    // Fold a constant integer expression (literals, unary `-`, and `+ - *`). Lets us
    // catch constant overflow whose individual leaves each fit but whose result does
    // not (`val f: U8 = 200 + 100`). Other operators yield non-const (leaf checks
    // still apply). The fold works in a signed magnitude bounded by 2^63-1; a leaf
    // or intermediate beyond that yields non-const (the per-leaf range check still
    // applies), so the fold never needs an unrepresentable bound.
    inout fn foldConst(id: U64) -> ConstInt {
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Int(val value, offset: _, val isBool, tyStart: _, tyLen: _, val isNeg) => {
                if isBool { return notConst() }
                if value > 9223372036854775807U64 { return notConst() }
                return mkConst(neg: isNeg, mag: value)
            }
            Expr.Unary(val op, val operand) => {
                if op == opSub() {
                    val o: ConstInt = self.foldConst(id: operand)
                    if o.isConst { return mkConst(neg: !o.neg, mag: o.value) }
                }
                return notConst()
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                val a: ConstInt = self.foldConst(id: lhs)
                val b: ConstInt = self.foldConst(id: rhs)
                if a.isConst {
                    if b.isConst {
                        if op == opAdd() { return addConst(na: a.neg, a: a.value, nb: b.neg, b: b.value) }
                        if op == opSub() { return addConst(na: a.neg, a: a.value, nb: !b.neg, b: b.value) }
                        if op == opMul() {
                            if a.value == 0 { return mkConst(neg: false, mag: 0) }
                            if b.value > 9223372036854775807U64 / a.value { return notConst() }
                            return mkConst(neg: a.neg != b.neg, mag: a.value * b.value)
                        }
                    }
                }
                return notConst()
            }
            _ => { return notConst() }
        }
    }

    // Whether a recovered TypeInfo is a (width-bearing) integer type.
    inout fn tiIsInt(ti: TypeInfo) -> Bool {
        if ti.kind == 0 {
            if ti.nameLen != 0 {
                return self.isIntType(start: ti.nameStart, len: ti.nameLen)
            }
        }
        return false
    }

    // Whether a recovered TypeInfo names a float type (F32/F64).
    inout fn tiIsFloat(ti: TypeInfo) -> Bool {
        if ti.kind == 0 {
            if ti.nameLen != 0 {
                return self.isFloatType(start: ti.nameStart, len: ti.nameLen)
            }
        }
        return false
    }
}

pub impl Comp {


    // Range-check the literals reachable from `id` against an expected integer type
    // described as (eKind, eBits, eSgn): eKind 0 = no context type (spec: a literal
    // with no type is a compile error), 1 = integer of (eBits, eSgn), 2 = a non-
    // integer type (skip int checks). A `true`/`false` (isBool) or a suffixed
    // literal (`5U64`) carries its own type and is never context-ambiguous.
    inout fn checkLitLeaf(value: U64, neg: Bool, offset: U64, isBool: Bool, tyStart: U64, tyLen: U64, eKind: U64, eBits: U64, eSgn: Bool) {
        if isBool {
            return
        }
        if tyLen != 0 {
            // explicit type suffix: range-check against it (never ambiguous).
            if !(self.litFitsType(value: value, neg: neg, dstStart: tyStart, dstLen: tyLen)) {
                self.errorAt(offset: offset, msg: "integer literal is out of range for its type")
            }
            return
        }
        if eKind == 1 {
            if !(litFitsBits(value: value, neg: neg, bits: eBits, sgn: eSgn)) {
                self.errorAt(offset: offset, msg: "integer literal is out of range for its type")
            }
            return
        }
        if eKind == 0 {
            self.errorAt(offset: offset, msg: "integer literal has no type from context; add a type annotation or a suffix (e.g. `5I32`)")
        }
    }
}

pub impl Comp {

    inout fn checkLitCtx(id: U64, eKind: U64, eBits: U64, eSgn: Bool) {
        // record the int context in the complete semantic expression entry so `typeOf`
        // can recover an otherwise width-less form (`0-1` / `match{...}+1` typed only
        // by its binding). eKind 1
        // means a definite int context (bits/sgn known); the recursion below propagates
        // the same context to operands, so the whole arith subtree is recorded.
        if eKind == 1 {
            self.recordSemanticExprLiteralContext(exprId: id, context: intCtxCode(bits: eBits, sgn: eSgn))
        }
        if eKind == 2 {
            self.recordSemanticExprLiteralContext(exprId: id, context: floatCtxCode(bits: eBits))
        }
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, val isNeg) => {
                self.checkLitLeaf(value: value, neg: isNeg, offset: offset, isBool: isBool, tyStart: tyStart, tyLen: tyLen, eKind: eKind, eBits: eBits, eSgn: eSgn)
            }
            Expr.Unary(val op, val operand) => {
                if op == opSub() {
                    // a leading `-` on a literal folds into the literal (`-128:I8` is
                    // valid even though `128` alone exceeds I8), so check the magnitude
                    // with the negative sign; otherwise recurse with the same type.
                    val oe: Expr = self.arena.exprs[operand]
                    match oe {
                        Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, isNeg: _) => {
                            self.checkLitLeaf(value: value, neg: true, offset: offset, isBool: isBool, tyStart: tyStart, tyLen: tyLen, eKind: eKind, eBits: eBits, eSgn: eSgn)
                        }
                        _ => { self.checkLitCtx(id: operand, eKind: eKind, eBits: eBits, eSgn: eSgn) }
                    }
                } else {
                    if op == opBitNot() {
                        self.checkLitCtx(id: operand, eKind: eKind, eBits: eBits, eSgn: eSgn)
                    }
                }
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                mut val isArith: Bool = false
                if op >= 56 { if op <= 60 { isArith = true } }
                if op >= 74 { if op <= 78 { isArith = true } }
                if isArith {
                    if eKind == 2 {
                        // float CONTEXT (`val x: F64 = 1 + 2`) flows into both operands.
                        self.checkLitCtx(id: lhs, eKind: 2, eBits: eBits, eSgn: false)
                        self.checkLitCtx(id: rhs, eKind: 2, eBits: eBits, eSgn: false)
                    } else {
                        // eKind 0 (no context) or 1 (an int context O is available). One unified
                        // rule (spec/12): the operator's type is set by whichever operand carries
                        // a concrete type — left OR right (homogeneous numerics share one type) —
                        // or, for a heterogeneous operator-trait witness, by the witness; only when
                        // NEITHER operand has a type does the surrounding context O stand in (and
                        // with no O it is ambiguous → error). The context never overrides a
                        // concretely-typed operand, so `val r: U64 = money + 200` checks 200 against
                        // the witness's Rhs (I8), not U64.
                        mut val handled: Bool = false
                        // (1) a float operand on either side makes the op float (homogeneous).
                        if self.exprIsFloat(id: lhs) || self.exprIsFloat(id: rhs) {
                            self.checkArithNoCtx(lhs: lhs, rhs: rhs)
                            handled = true
                        }
                        // (2) a NON-numeric concrete lhs (struct/newtype kind 2, String kind 1)
                        // can carry a heterogeneous trait: type the rhs from the witness's Rhs
                        // param, the lhs from its own type. (exprType is non-caching, so a
                        // payload bind resolved here does not poison the typeOf cache.)
                        if !handled {
                            val lt: TypeInfo = self.exprType(id: lhs)
                            if lt.kind == 2 {
                                if self.checkBinTraitRhs(op: op, lhs: lhs, rhs: rhs) {
                                    self.checkLitCtx(id: lhs, eKind: 0, eBits: 0, eSgn: false)
                                    handled = true
                                }
                            }
                        }
                        // (3) homogeneous integer: a typed operand on EITHER side fixes the shared
                        // type (so `5 + big` types 5 from big, not just `big + 5`).
                        if !handled {
                            if self.exprIntTy(id: lhs).known || self.exprIntTy(id: rhs).known {
                                self.checkArithNoCtx(lhs: lhs, rhs: rhs)
                                handled = true
                            }
                        }
                        // (4) both operands are bare literals (no own type): use the context O if
                        // present (eKind 1), else it is genuinely untyped → checkArithNoCtx errors.
                        if !handled {
                            if eKind == 1 {
                                val cf: ConstInt = self.foldConst(id: id)
                                if cf.isConst {
                                    if !(litFitsBits(value: cf.value, neg: cf.neg, bits: eBits, sgn: eSgn)) {
                                        self.errorAt(offset: self.exprOffset(id: id), msg: "constant expression is out of range for its type")
                                    }
                                }
                                self.checkLitCtx(id: lhs, eKind: 1, eBits: eBits, eSgn: eSgn)
                                self.checkLitCtx(id: rhs, eKind: 1, eBits: eBits, eSgn: eSgn)
                            } else {
                                self.checkArithNoCtx(lhs: lhs, rhs: rhs)
                            }
                        }
                    }
                } else {
                    self.checkArithNoCtx(lhs: lhs, rhs: rhs)
                }
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                self.checkCallArgs(id: id, nameStart: nameStart, nameLen: nameLen, args: args)
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                self.checkMethodArgs(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
            }
            Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
                // The operand has its own type; a direct-literal operand is range-
                // checked by the cast itself, so only recurse into compound operands.
                val oe: Expr = self.arena.exprs[operand]
                match oe {
                    Expr.Int(value: _, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => {}
                    _ => { self.checkLitCtx(id: operand, eKind: 0, eBits: 0, eSgn: false) }
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                self.checkLitCtx(id: base, eKind: 0, eBits: 0, eSgn: false)
            }
            Expr.Index(val base, val index) => {
                self.checkLitCtx(id: base, eKind: 0, eBits: 0, eSgn: false)
                self.checkLitCtx(id: index, eKind: 1, eBits: 64, eSgn: false)
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                self.checkMakeFields(typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, ty: ty, fields: fields)
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.len {
                    self.checkLitCtx(id: self.exprAt(exprs: elems, index: i), eKind: eKind, eBits: eBits, eSgn: eSgn)
                    i += 1
                }
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                // a value-position `if`'s result is its branches' `give` values, so the
                // surrounding context flows to each give (an else-if chain recurses here
                // via the nested IfExpr give). The condition is self-typed (Bool).
                val tg: U64 = self.blockGiveExpr(blkId: thenBlk)
                if tg < self.arena.exprs.count() {
                    self.checkLitCtx(id: tg, eKind: eKind, eBits: eBits, eSgn: eSgn)
                }
                val eg: U64 = self.blockGiveExpr(blkId: elseBlk)
                if eg < self.arena.exprs.count() {
                    self.checkLitCtx(id: eg, eKind: eKind, eBits: eBits, eSgn: eSgn)
                }
            }
            Expr.MatchExpr(val scrut, val arms) => {
                self.checkLitCtx(id: scrut, eKind: 0, eBits: 0, eSgn: false)
                mut val i: U64 = 0
                while i < arms.len {
                    val arm: MatchArm = self.matchArmAt(arms: arms, index: i)
                    // context flows to each value arm's `give` value; diverging arms have none.
                    if !(arm.isDiverge) {
                        val g: U64 = self.blockGiveExpr(blkId: arm.body)
                        if g < self.arena.exprs.count() {
                            // bring the arm's payload binds into scope so a give-value that
                            // references them (`Shape.Square(val s) => s * s`) resolves to
                            // their real type, not a shadowing outer name — the operator /
                            // literal typing below reads operand types.
                            val armMark: U64 = self.scopeMark()
                            self.addArmBinds(a: arm, scrut: scrut)
                            self.checkLitCtx(id: g, eKind: eKind, eBits: eBits, eSgn: eSgn)
                            self.popLocals(mark: armMark)
                        }
                    }
                    i += 1
                }
            }
            Expr.OptChain(val base, cont: _) => {
                self.checkLitCtx(id: base, eKind: 0, eBits: 0, eSgn: false)
            }
            Expr.ChainHole => {}
            Expr.Try(val expr) => {
                self.checkLitCtx(id: expr, eKind: 0, eBits: 0, eSgn: false)
            }
            _ => {}
        }
    }

    // IntTy of a declared type span: known when (start,len) names an integer type.
    inout fn spanIntTy(start: U64, len: U64) -> IntTy {
        if self.isIntType(start: start, len: len) {
            return <IntTy known=true bits=self.intBits(start: start, len: len) sgn=self.intSigned(start: start, len: len) />
        }
        return <IntTy known=false bits=0 sgn=false />
    }

    // For a trait-dispatched binary operator (`a + b` with `impl T as Add[...]`), check
    // the rhs literal against the witness's rhs PARAMETER type, so `a + 10` types `10`
    // from the conformance's rhs (e.g. `Add[I64]`) instead of failing "no type from
    // context". Returns false when lhs has no operator-trait witness (caller falls back
    // to the ordinary same-type arithmetic rule).
    // Count the DISTINCT integer right-operand types among `name` witnesses on a type
    // (`impl T as Add[I32]` + `Add[I64]` -> 2). Lets the checker reject a bare-literal
    // rhs that could fit more than one (ambiguous), instead of silently picking the
    // first-declared overload.
    inout fn intRhsWitnessCount(typeStart: U64, typeLen: U64, name: String) -> U64 {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val seen: Array[U64] = []
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.isAssoc {
                if f.recvId == qType {
                    if rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                        if f.params.count() >= 2 {
                            if self.isIntType(start: f.params[1].tyStart, len: f.params[1].tyLen) {
                                if !(u64ArrayHas(a: seen, v: f.params[1].tyNameId)) {
                                    seen.append(f.params[1].tyNameId)
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        return seen.count()
    }

    inout fn checkBinTraitRhs(op: I64, lhs: U64, rhs: U64) -> Bool {
        if self.hasBinTraitWitness(op: op, lhs: lhs, rhs: rhs) {
            val lt: TypeInfo = self.binWitnessType(lhs: lhs, rhs: rhs)
            // a bare-literal rhs that could fit MULTIPLE integer right-operand overloads
            // (`impl T as Add[I32]` and `Add[I64]`) is ambiguous — no silent pick by
            // declaration order (spec: 曖昧はエラー). Demand a suffix (`a + 10I64`).
            val rt: TypeInfo = self.typeOf(id: rhs)
            if rt.kind == 0 {
                if rt.nameLen == 0 {
                    if self.intRhsWitnessCount(typeStart: lt.nameStart, typeLen: lt.nameLen, name: binTraitMethodName(op: op)) >= 2U64 {
                        self.errorAt(offset: self.exprOffset(id: rhs), msg: "ambiguous operator: the right operand matches more than one integer overload — add a suffix to the literal (e.g. `10I64`)")
                    }
                }
            }
            val fi: U64 = self.findBinTraitWitness(typeStart: lt.nameStart, typeLen: lt.nameLen, name: binTraitMethodName(op: op), rhs: rhs)
            if fi < self.arena.funcs.count() {
                val f: Func = self.arena.funcs[fi]
                if f.params.count() >= 2 {
                    val pit: IntTy = self.spanIntTy(start: f.params[1].tyStart, len: f.params[1].tyLen)
                    if pit.known {
                        self.checkLitCtx(id: rhs, eKind: 1, eBits: pit.bits, eSgn: pit.sgn)
                    } else {
                        self.checkLitCtx(id: rhs, eKind: 0, eBits: 0, eSgn: false)
                    }
                    return true
                }
            }
        }
        return false
    }

    // Recover an expression's integer type as (bits, sgn). Covers what exprType
    // reports width-less but is nonetheless integer-typed: `arr.count()` (U64) and an
    // array element read `arr[i]` (the element's int type) — so a literal sibling in
    // `0 ..< arr.count()` infers U64 and is not flagged ambiguous.
    inout fn exprIntTy(id: U64) -> IntTy {
        val ti: TypeInfo = self.exprType(id: id)
        if self.tiIsInt(ti: ti) {
            return <IntTy known=true bits=self.intBits(start: ti.nameStart, len: ti.nameLen) sgn=self.intSigned(start: ti.nameStart, len: ti.nameLen) />
        }
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Call(val nameStart, val nameLen, val args) => {
                // argCount() is the one integer-returning I/O builtin (I64).
                if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "argCount") {
                    return <IntTy known=true bits=64 sgn=true />
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "count") {
                    val bt: TypeInfo = self.exprType(id: base)
                    if bt.kind == 3 {
                        return <IntTy known=true bits=64 sgn=false />
                    }
                    if self.isBufferType(ti: bt) {
                        return <IntTy known=true bits=64 sgn=false />
                    }
                }
                if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "capacity") {
                    val bt: TypeInfo = self.exprType(id: base)
                    if self.isBufferType(ti: bt) {
                        return <IntTy known=true bits=64 sgn=false />
                    }
                }
            }
            Expr.Index(val base, val index) => {
                val bt: TypeInfo = self.exprType(id: base)
                if bt.kind == 3 {
                    if self.isIntType(start: bt.nameStart, len: bt.nameLen) {
                        return <IntTy known=true bits=self.intBits(start: bt.nameStart, len: bt.nameLen) sgn=self.intSigned(start: bt.nameStart, len: bt.nameLen) />
                    }
                }
            }
            _ => {}
        }
        return <IntTy known=false bits=0 sgn=false />
    }

    // Infer an arithmetic/comparison's literal operand type from a typed sibling
    // (Plew: both operands share a type). If neither operand has a known integer
    // type, the operands carry no context, so a literal there is ambiguous (error).
    inout fn checkArithNoCtx(lhs: U64, rhs: U64) {
        // a float-typed sibling makes the whole arith float (`1.5 + 2`); the untyped
        // literal types as a float there (spec/02,12).
        if self.exprIsFloat(id: lhs) || self.exprIsFloat(id: rhs) {
            self.checkLitCtx(id: lhs, eKind: 2, eBits: 64, eSgn: false)
            self.checkLitCtx(id: rhs, eKind: 2, eBits: 64, eSgn: false)
            return
        }
        val lt: IntTy = self.exprIntTy(id: lhs)
        if lt.known {
            self.checkLitCtx(id: lhs, eKind: 1, eBits: lt.bits, eSgn: lt.sgn)
            self.checkLitCtx(id: rhs, eKind: 1, eBits: lt.bits, eSgn: lt.sgn)
            return
        }
        val rt: IntTy = self.exprIntTy(id: rhs)
        if rt.known {
            self.checkLitCtx(id: lhs, eKind: 1, eBits: rt.bits, eSgn: rt.sgn)
            self.checkLitCtx(id: rhs, eKind: 1, eBits: rt.bits, eSgn: rt.sgn)
            return
        }
        self.checkLitCtx(id: lhs, eKind: 0, eBits: 0, eSgn: false)
        self.checkLitCtx(id: rhs, eKind: 0, eBits: 0, eSgn: false)
    }

    // checkLitCtx with the expected type given as a recovered TypeInfo.
    inout fn checkLitTi(id: U64, ti: TypeInfo) {
        if self.tiIsInt(ti: ti) {
            self.checkLitCtx(id: id, eKind: 1, eBits: self.intBits(start: ti.nameStart, len: ti.nameLen), eSgn: self.intSigned(start: ti.nameStart, len: ti.nameLen))
            return
        }
        if self.tiIsFloat(ti: ti) {
            // spec/02,12: a polymorphic int literal in a float context types as that
            // float (`val x: F64 = 5`, `1.5 + 2`) — no implicit conversion, the literal
            // simply IS a float here. Record the float context for the backend.
            mut val fbits: U64 = 64
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F32") { fbits = 32 }
            self.checkLitCtx(id: id, eKind: 2, eBits: fbits, eSgn: false)
            return
        }
        self.checkLitCtx(id: id, eKind: 0, eBits: 0, eSgn: false)
    }

    // A generic factory call rewritten from construction (`<Head[T] value=7 />` ->
    // `Head.value(value: 7)`) still needs the original expected result type to ground
    // factory params. Do it generally for assoc fns whose receiver head matches ctxRef,
    // so the special case remains at the intrinsic floor, not at Ref syntax.
    inout fn checkAssocArgsLitCtxFromExpected(recv: U64, nameStart: U64, nameLen: U64, args: ArgRange, ctxRef: U64) -> Bool {
        val arn: Bind = self.assocRecvName(recv: recv)
        if arn.nameLen == 0U64 {
            return false
        }
        val ai: U64 = self.findAssoc(recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        if ai >= self.arena.funcs.count() {
            return false
        }
        val f: Func = self.arena.funcs[ai]
        if f.typeParams.count() == 0U64 {
            return false
        }
        if ctxRef == 0U64 || !(self.isGenericInst(ref: ctxRef)) {
            return false
        }
        val ct: TypeRef = self.arena.types[ctxRef]
        if !(spansEqual(c: inout self, aStart: ct.nameStart, aLen: ct.nameLen, bStart: arn.nameStart, bLen: arn.nameLen)) {
            return false
        }
        if ct.args.count() != f.typeParams.count() {
            return false
        }
        mut val ginf: Array[U64] = self.inferFnArgs(f: f, args: args)
        mut val gi: U64 = 0
        while gi < ginf.count() {
            mut val needsGround: Bool = ginf[gi] == 0U64
            if !(needsGround) {
                if self.arena.types[ginf[gi]].nameLen == 0U64 {
                    needsGround = true
                }
            }
            if needsGround {
                ginf.set(i: gi, value: ct.args[gi])
            }
            gi += 1
        }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        self.cur.typeParams = f.typeParams
        self.cur.typeArgs = ginf
        mut val k: U64 = 0
        while k < args.len {
            val pi: U64 = self.paramIndexForArg(params: f.params, args: args, argIdx: k)
            if pi < f.params.count() {
                val p: Param = f.params[pi]
                mut val pref: U64 = 0
                if p.ty != 0U64 {
                    pref = self.groundTypeRef(ref: p.ty)
                }
                if pref != 0U64 && self.tyRefIsGround(ref: pref) {
                    self.checkLitTi(id: self.argAt(args: args, index: k).expr, ti: self.typeInfoOfRef(ref: pref))
                    self.tcCheckValue(expectedRef: pref, valueExpr: self.argAt(args: args, index: k).expr, pos: "arg")
                } else {
                    self.checkLitSpan(id: self.argAt(args: args, index: k).expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                }
            }
            k += 1
        }
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        return true
    }

    // Like checkLitSpan, but when the expected type is a generic enum/struct INSTANCE
    // (ref carries its type args) and the value is a construction, ground the make
    // fields from that instance's args — so `<Optional.Some v=5 />` at `Optional[I64]`
    // types its payload `5` as I64 (the head-name span alone drops the args). spec/02.
    inout fn checkLitSpanCtx(id: U64, tyStart: U64, tyLen: U64, isArray: Bool, ctxRef: U64) {
        if ctxRef != 0U64 {
            if !isArray {
                match self.arena.exprs[id] {
                    Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, ty: _, val fields) => {
                        if self.isGenericEnumInst(ref: ctxRef) || self.isGenericInst(ref: ctxRef) {
                            self.checkMakeFields(typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, ty: ctxRef, fields: fields)
                            return
                        }
                    }
                    _ => {}
                }
                match self.arena.exprs[id] {
                    Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                        if self.checkAssocArgsLitCtxFromExpected(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args, ctxRef: ctxRef) {
                            return
                        }
                    }
                    _ => {}
                }
            }
        }
        self.checkLitSpan(id: id, tyStart: tyStart, tyLen: tyLen, isArray: isArray)
    }

    // The assignment / compound-assignment RHS is subject to the same literal
    // type-determination as a `val` initializer: propagate the target place's type as
    // the expected context, so a determinable literal types at the target width and is
    // range-checked, and an undetermined literal is a compile error (spec/02 — no type
    // from context) rather than a silent i64 default that wraps at runtime. `typeOf`
    // gives the place type: kind 3 for a whole-array place (`xs = [...]`, nameStart names
    // the element) → propagate the element type to the array literal; an element place
    // (`xs[0]`) already recovers the element scalar; a generic-instance place carries its
    // ref so make fields ground. Mirrors Stmt.Let's checkLitSpanCtx.
    inout fn checkAssignRhsLit(target: U64, value: U64) {
        val ti: TypeInfo = self.typeOf(id: target)
        if ti.kind == 3 {
            self.checkLitSpan(id: value, tyStart: ti.nameStart, tyLen: ti.nameLen, isArray: true)
            return
        }
        if ti.nameLen == 0U64 {
            self.checkLitCtx(id: value, eKind: 0, eBits: 0, eSgn: false)
            return
        }
        self.checkLitSpanCtx(id: value, tyStart: ti.nameStart, tyLen: ti.nameLen, isArray: false, ctxRef: ti.ref)
    }

    // checkLitCtx against a written type span (annotation / param / field).
    inout fn checkLitSpan(id: U64, tyStart: U64, tyLen: U64, isArray: Bool) {
        if isArray {
            self.checkLitArray(id: id, elemStart: tyStart, elemLen: tyLen)
            return
        }
        self.checkLitTi(id: id, ti: self.typeInfoOfName(start: tyStart, len: tyLen, isArray: false))
    }

    // Range-check the elements of an array literal against the element type.
    inout fn checkLitArray(id: U64, elemStart: U64, elemLen: U64) {
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.len {
                    self.checkLitSpan(id: self.exprAt(exprs: elems, index: i), tyStart: elemStart, tyLen: elemLen, isArray: false)
                    i += 1
                }
            }
            _ => { self.checkLitCtx(id: id, eKind: 0, eBits: 0, eSgn: false) }
        }
    }
}
