// The store owns the stage transition. CoW snapshots exposed to readers
// cannot mutate its private rows, and construction cannot replace Prepared.
pub impl Comp {
    fn selectedCallConstraintPlan(index: U64) -> Optional[SelectedCallConstraints] {
        match self.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Building(plan: val plan) => { return <Optional.Some v=plan /> }
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot.constraints() /> }
                }
            }
            Optional.None => { return <Optional.None /> }
        }
    }

    inout fn recordBuildingCallConstraints(index: U64, plan: SelectedCallConstraints) -> Bool {
        match self.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: _) => { return false }
                    CallConstraintPlanState.Building(plan: _) => {}
                }
            }
            Optional.None => {}
        }
        self.selectedCallConstraints[index] = <CallConstraintPlanState.Building plan=plan />
        return true
    }

    fn preparedCallConstraints(index: U64) -> Optional[PreparedCallConstraints] {
        match self.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot /> }
                    CallConstraintPlanState.Building(plan: _) => { return <Optional.None /> }
                }
            }
            Optional.None => { return <Optional.None /> }
        }
    }
}

// Only frontend admission can publish a successful source snapshot.
impl Comp {
    inout fn publishPreparedCallConstraints(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        try self.checkRecordedCallConstraintEvidence(templateIndex: templateIndex)
        val template = self.callTemplates[templateIndex]
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        mut val plan = <SelectedCallConstraints owner=scope.owner bounds=[] proofs=[] />
        match self.selectedCallConstraints.get(key: templateIndex) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: _) => { return <Result.Ok value=() /> }
                    CallConstraintPlanState.Building(plan: val building) => { plan = building }
                }
            }
            Optional.None => {}
        }
        self.selectedCallConstraints[templateIndex] = <CallConstraintPlanState.Prepared snapshot=<PreparedCallConstraints plan=plan /> />
        return <Result.Ok value=() />
    }
}

pub impl Comp {
    fn callTemplateIndex(siteKey: CallSiteKey) -> U64 {
        val capacity: U64 = self.callTemplateIndexSlots.count()
        if capacity == 0U64 { return self.callTemplates.count() }
        mut val slot: U64 = siteKey.lookupHash() % capacity
        while self.callTemplateIndexSlots[slot] != 0U64 {
            val entry: U64 = self.callTemplateIndexSlots[slot] - 1U64
            if self.callTemplates[entry].siteKey.sameKey(other: siteKey) { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.callTemplates.count()
    }
}


pub impl Comp {
    fn callTemplateCount() -> U64 { return self.callTemplates.count() }
    fn callTemplateAt(index: U64) -> CallTemplate { return self.callTemplates[index] }
    fn callTemplateSnapshot() -> Array[CallTemplate] { return self.callTemplates }
    // Construction API; successful source publication removes write authority.
    inout fn replaceBuildingCallTemplate(index: U64, template: CallTemplate) -> Bool {
        if index >= self.callTemplates.count() || self.preparedCallConstraints(index: index).isSome() { return false }
        if !self.callTemplates[index].siteKey.sameKey(other: template.siteKey) { return false }
        self.callTemplates.set(i: index, value: template)
        return true
    }
}

impl Comp {
    inout fn replaceSourceCallTemplate(index: U64, template: CallTemplate) {
        if !self.replaceBuildingCallTemplate(index: index, template: template) {
            panic("internal error: cannot replace a prepared source call template")
        }
    }
}

pub impl Comp {
    inout fn requireCallTemplateStorage(index: U64) {
        val template = self.callTemplates[index]
        self.callTemplates.set(i: index, value: <CallTemplate siteKey=template.siteKey resultTypeRecipe=template.resultTypeRecipe kind=template.kind expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm mayHaveStorageArguments=true />)
    }
}

pub impl Comp {
    fn callTemplateOperandCount() -> U64 { return self.callTemplateOperandPool.count() }
    fn callTemplateOperandAt(index: U64) -> CallArgumentSource { return self.callTemplateOperandPool[index] }
}

pub impl Comp {
    fn nextLexicalCallTemplate(index: U64) -> U64 { return self.callTemplateBodyNext[index] }
    fn globalCallTemplates(target: U64) -> Array[U64] { return self.globalCallTemplateOwners.getOr(key: target, fallback: []) }
    // A closure/provided owner receives one immutable lexical root identity.
    inout fn registerCallTemplateLexicalRoot(owner: U64, root: U64) -> Bool {
        match self.callTemplateLexicalRoots.get(key: owner) {
            Optional.Some(v: val saved) => { return saved == root }
            Optional.None => {}
        }
        if self.lexicalBodyPreparations.get(key: owner).isSome() || self.callTemplateBodyHeads.getOr(key: owner, fallback: 0U64) != 0U64 { return false }
        self.callTemplateLexicalRoots[owner] = root
        return true
    }
}

pub impl Comp {
    fn lexicalBodyPreparationCount() -> U64 { return self.lexicalBodyPreparations.count() }
}

impl Comp {
    inout fn appendSourceCallTemplate(template: CallTemplate, resultExpression: Optional[U64] = <Optional.None />) {
        if !self.appendCallTemplate(template: template, resultExpression: resultExpression) {
            panic("internal error: cannot append to a completed source call owner")
        }
    }
}

impl Comp {
    inout fn recordGlobalCallTemplateOwner(templateIndex: U64) {
        if self.callTemplateAt(index: templateIndex).siteKey.ownerFnIdx != 18446744073709551615U64 { return }
        match self.cur.globalInitializerTarget {
            Optional.Some(v: val target) => {
                mut val indices = self.globalCallTemplateOwners.getOr(key: target, fallback: [])
                mut val present = false
                for index in indices { if index == templateIndex { present = true } }
                if !present { indices.append(templateIndex) }
                self.globalCallTemplateOwners[target] = indices
            }
            Optional.None => {}
        }
    }

    inout fn indexLexicalCallTemplate(templateIndex: U64) {
        val owner = self.callTemplateAt(index: templateIndex).siteKey.ownerFnIdx
        val root = self.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        val tail = self.callTemplateBodyTails.getOr(key: root, fallback: 0U64)
        self.callTemplateBodyNext.append(0U64)
        if tail == 0U64 {
            self.callTemplateBodyHeads[root] = templateIndex + 1U64
        } else {
            self.callTemplateBodyNext.set(i: tail - 1U64, value: templateIndex + 1U64)
        }
        self.callTemplateBodyTails[root] = templateIndex + 1U64
    }

}
