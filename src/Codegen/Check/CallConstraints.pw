// The store owns the stage transition. CoW snapshots exposed to readers
// cannot mutate its private rows, and construction cannot replace Prepared.
pub impl Comp {
    fn selectedCallConstraintPlan(index: U64) -> Optional[SelectedCallConstraints] {
        match self.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Building(plan: val plan) => { return <Optional.Some v=plan /> }
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot.constraints() /> }
                }
            }
            Optional.None => { return <Optional.None /> }
        }
    }

    inout fn recordBuildingCallConstraints(index: U64, plan: SelectedCallConstraints) -> Bool {
        match self.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: _) => { return false }
                    CallConstraintPlanState.Building(plan: _) => {}
                }
            }
            Optional.None => {}
        }
        self.selectedCallConstraints[index] = <CallConstraintPlanState.Building plan=plan />
        return true
    }

    fn preparedCallConstraints(index: U64) -> Optional[PreparedCallConstraints] {
        match self.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot /> }
                    CallConstraintPlanState.Building(plan: _) => { return <Optional.None /> }
                }
            }
            Optional.None => { return <Optional.None /> }
        }
    }
}

// Only frontend admission can publish a successful source snapshot.
impl Comp {
    inout fn admitSelectedCallConstraints(templateIndex: U64) -> Result[AdmittedCallConstraints, CompileDiagnostic] {
        try self.checkRecordedCallConstraintEvidence(templateIndex: templateIndex)
        val template = self.callTemplates[templateIndex]
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        val plan = match self.selectedCallConstraintPlan(index: templateIndex) {
            Optional.Some(v: val selected) => selected
            Optional.None => <SelectedCallConstraints owner=scope.owner bounds=[] proofs=[] />
        }
        return <Result.Ok value=<AdmittedCallConstraints templateIndex=templateIndex plan=plan /> />
    }

    inout fn publishPreparedCallConstraints(admitted: AdmittedCallConstraints) {
        // The capability owns the exact admitted value; construction changes
        // cannot replace it between admission and whole-owner success.
        self.selectedCallConstraints[admitted.templateIndex] = <CallConstraintPlanState.Prepared snapshot=<PreparedCallConstraints plan=admitted.plan /> />
    }

    inout fn admitRecordedBodyCallConstraints(owner: U64) -> Result[Array[AdmittedCallConstraints], CompileDiagnostic] {
        mut val admitted: Array[AdmittedCallConstraints] = []
        mut val row = self.firstLexicalCallTemplate(owner: owner)
        while row != 0U64 && row <= self.callTemplates.count() {
            val index = row - 1U64
            try self.checkCallTemplateSelection(templateIndex: index)
            admitted.append((try self.admitSelectedCallConstraints(templateIndex: index)))
            try self.checkClosedIterationProtocol(templateIndex: index)
            row = self.decls.callTemplateBodyNext[index]
        }
        return <Result.Ok value=admitted />
    }

    inout fn admitGlobalCallConstraints(target: U64) -> Result[Array[AdmittedCallConstraints], CompileDiagnostic] {
        mut val admitted: Array[AdmittedCallConstraints] = []
        for index in self.decls.globalCallTemplateOwners.getOr(key: target, fallback: []) {
            admitted.append((try self.admitSelectedCallConstraints(templateIndex: index)))
        }
        return <Result.Ok value=admitted />
    }

}


pub impl Comp {
    fn callTemplateIndex(siteKey: CallSiteKey) -> U64 {
        return findSourceCallTemplateIndex(templates: self.callTemplates, indexSlots: self.callTemplateIndexSlots, siteKey: siteKey)
    }
}


pub impl Comp {
    fn callTemplateCount() -> U64 { return self.callTemplates.count() }
    fn callTemplateAt(index: U64) -> CallTemplate { return self.callTemplates[index] }
    fn callTemplateSnapshot() -> Array[CallTemplate] { return self.callTemplates }
    // Construction API; successful source publication removes write authority.
    inout fn replaceBuildingCallTemplate(index: U64, template: CallTemplate) -> Bool {
        if index >= self.callTemplates.count() || self.preparedCallConstraints(index: index).isSome() { return false }
        if !self.callTemplates[index].siteKey.sameKey(other: template.siteKey) { return false }
        self.callTemplates.set(i: index, value: template)
        return true
    }
}

impl Comp {
    inout fn replaceSourceCallTemplate(index: U64, template: CallTemplate) {
        if !self.replaceBuildingCallTemplate(index: index, template: template) {
            panic("internal error: cannot replace a prepared source call template")
        }
    }
}

pub impl Comp {
    inout fn requireCallTemplateStorage(index: U64) {
        val template = self.callTemplates[index]
        self.callTemplates.set(i: index, value: <CallTemplate siteKey=template.siteKey resultTypeRecipe=template.resultTypeRecipe kind=template.kind expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm mayHaveStorageArguments=true />)
    }
}

pub impl Comp {
    fn callTemplateOperandCount() -> U64 { return self.callTemplateOperandPool.count() }
    fn callTemplateOperandAt(index: U64) -> CallArgumentSource { return self.callTemplateOperandPool[index] }
}
