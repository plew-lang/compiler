// The store owns the stage transition. CoW snapshots exposed to readers
// cannot mutate its private rows, and construction cannot replace Prepared.
pub impl Comp {
    fn selectedCallConstraintPlan(index: U64) -> Optional[SelectedCallConstraints] {
        match self.sourceCalls.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Building(plan: val plan) => { return <Optional.Some v=plan /> }
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot.constraints() /> }
                }
            }
            Optional.None => { return <Optional.None /> }
        }
    }

    inout fn recordBuildingCallConstraints(index: U64, plan: SelectedCallConstraints) -> Bool {
        match self.sourceCalls.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: _) => { return false }
                    CallConstraintPlanState.Building(plan: _) => {}
                }
            }
            Optional.None => {}
        }
        self.sourceCalls.selectedCallConstraints[index] = <CallConstraintPlanState.Building plan=plan />
        return true
    }

    fn preparedCallConstraints(index: U64) -> Optional[PreparedCallConstraints] {
        match self.sourceCalls.selectedCallConstraints.get(key: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot /> }
                    CallConstraintPlanState.Building(plan: _) => { return <Optional.None /> }
                }
            }
            Optional.None => { return <Optional.None /> }
        }
    }
}

// Only frontend admission can publish a successful source snapshot.
impl Comp {
    inout fn publishPreparedCallConstraints(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        try self.checkRecordedCallConstraintEvidence(templateIndex: templateIndex)
        val template = self.sourceCalls.callTemplates[templateIndex]
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        mut val plan = <SelectedCallConstraints owner=scope.owner bounds=[] proofs=[] />
        match self.sourceCalls.selectedCallConstraints.get(key: templateIndex) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: _) => { return <Result.Ok value=() /> }
                    CallConstraintPlanState.Building(plan: val building) => { plan = building }
                }
            }
            Optional.None => {}
        }
        self.sourceCalls.selectedCallConstraints[templateIndex] = <CallConstraintPlanState.Prepared snapshot=<PreparedCallConstraints plan=plan /> />
        return <Result.Ok value=() />
    }
}

pub impl Comp {
    fn callTemplateIndex(siteKey: CallSiteKey) -> U64 {
        val capacity: U64 = self.sourceCalls.callTemplateIndexSlots.count()
        if capacity == 0U64 { return self.sourceCalls.callTemplates.count() }
        mut val slot: U64 = siteKey.lookupHash() % capacity
        while self.sourceCalls.callTemplateIndexSlots[slot] != 0U64 {
            val entry: U64 = self.sourceCalls.callTemplateIndexSlots[slot] - 1U64
            if self.sourceCalls.callTemplates[entry].siteKey.sameKey(other: siteKey) { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.sourceCalls.callTemplates.count()
    }
}


pub impl Comp {
    fn callTemplateCount() -> U64 { return self.sourceCalls.callTemplates.count() }
    fn callTemplateAt(index: U64) -> CallTemplate { return self.sourceCalls.callTemplates[index] }
    fn callTemplateSnapshot() -> Array[CallTemplate] { return self.sourceCalls.callTemplates }
    // Construction API; successful source publication removes write authority.
    inout fn replaceBuildingCallTemplate(index: U64, template: CallTemplate) -> Bool {
        if index >= self.sourceCalls.callTemplates.count() || self.preparedCallConstraints(index: index).isSome() { return false }
        if !self.sourceCalls.callTemplates[index].siteKey.sameKey(other: template.siteKey) { return false }
        self.sourceCalls.callTemplates.set(i: index, value: template)
        return true
    }
}

impl Comp {
    inout fn replaceSourceCallTemplate(index: U64, template: CallTemplate) {
        if !self.replaceBuildingCallTemplate(index: index, template: template) {
            panic("internal error: cannot replace a prepared source call template")
        }
    }
}

pub impl Comp {
    inout fn requireCallTemplateStorage(index: U64) {
        val template = self.sourceCalls.callTemplates[index]
        self.sourceCalls.callTemplates.set(i: index, value: <CallTemplate siteKey=template.siteKey resultTypeRecipe=template.resultTypeRecipe kind=template.kind expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm mayHaveStorageArguments=true />)
    }
}

pub impl Comp {
    fn callTemplateOperandCount() -> U64 { return self.sourceCalls.callTemplateOperandPool.count() }
    fn callTemplateOperandAt(index: U64) -> CallArgumentSource { return self.sourceCalls.callTemplateOperandPool[index] }
}
