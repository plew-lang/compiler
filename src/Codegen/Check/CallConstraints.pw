// The source owner owns construction authority. Prepared snapshots are only
// published by its private successful preparation tail, which performs no
// further fallible work or callbacks before recording the owner's result.
// A completed owner therefore protects every row without reading/copying its
// retained constraint evidence merely to decide whether writing is allowed.
pub impl Comp {
    fn selectedCallConstraintPlan(index: U64) -> Optional[SelectedCallConstraints] {
        match self.sourceOperationConstraints(index: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Building(plan: val plan) => { return <Optional.Some v=plan /> }
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot.constraints() /> }
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }

    inout fn recordBuildingCallConstraints(index: U64, plan: SelectedCallConstraints) -> Bool {
        return self.storeBuildingOperationConstraints(index: index, state: <CallConstraintPlanState.Building plan=plan />)
    }

    fn preparedCallConstraints(index: U64) -> Optional[PreparedCallConstraints] {
        match self.sourceOperationConstraints(index: index) {
            Optional.Some(v: val state) => {
                match state {
                    CallConstraintPlanState.Prepared(snapshot: val snapshot) => { return <Optional.Some v=snapshot /> }
                    CallConstraintPlanState.Building(plan: _) => {}
                }
            }
            Optional.None => {}
        }
        return <Optional.None />
    }
}

// Only frontend admission can publish a successful source snapshot.
impl Comp {
    inout fn admitSelectedCallConstraints(templateIndex: U64) -> Result[AdmittedCallConstraints, CompileDiagnostic] {
        try self.checkRecordedCallConstraintEvidence(templateIndex: templateIndex)
        val plan = match self.selectedCallConstraintPlan(index: templateIndex) {
            // Admission already checked this plan against its declaration scope.
            Optional.Some(v: val selected) => selected
            Optional.None => {
                val template = self.callTemplateAt(index: templateIndex)
                val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
                give <SelectedCallConstraints owner=scope.owner bounds=[] proofs=[] />
            }
        }
        return <Result.Ok value=<AdmittedCallConstraints templateIndex=templateIndex plan=plan /> />
    }

    inout fn publishPreparedCallConstraints(admitted: AdmittedCallConstraints) {
        // The capability owns the exact admitted value; construction changes
        // cannot replace it between admission and whole-owner success.
        if !self.storeBuildingOperationConstraints(index: admitted.templateIndex, state: <CallConstraintPlanState.Prepared snapshot=<PreparedCallConstraints plan=admitted.plan /> />) {
            panic("internal error: cannot publish constraints after source owner completion")
        }
    }

    inout fn admitRecordedBodyCallConstraints(owner: U64) -> Result[Array[AdmittedCallConstraints], CompileDiagnostic] {
        mut val admitted: Array[AdmittedCallConstraints] = []
        mut val row = self.firstLexicalCallTemplate(owner: owner)
        while row != 0U64 && row <= self.callTemplateLocations.count() {
            val index = row - 1U64
            try self.checkCallTemplateSelection(templateIndex: index)
            admitted.append((try self.admitSelectedCallConstraints(templateIndex: index)))
            try self.checkClosedIterationProtocol(templateIndex: index)
            row = self.callTemplateBodyNext[index]
        }
        return <Result.Ok value=admitted />
    }

    inout fn admitGlobalCallConstraints(target: U64) -> Result[Array[AdmittedCallConstraints], CompileDiagnostic] {
        mut val admitted: Array[AdmittedCallConstraints] = []
        for index in self.globalCallTemplateOwners.getOr(key: target, fallback: []) {
            admitted.append((try self.admitSelectedCallConstraints(templateIndex: index)))
        }
        return <Result.Ok value=admitted />
    }

}


pub impl Comp {
    fn callTemplateIndex(siteKey: CallSiteKey) -> U64 {
        return findSourceCallTemplateIndex(locations: self.callTemplateLocations, indexSlots: self.callTemplateIndexSlots, siteKey: siteKey)
    }
}


pub impl Comp {
    fn callTemplateCount() -> U64 { return self.callTemplateLocations.count() }
    fn callTemplateAt(index: U64) -> CallTemplate {
        val location = self.callTemplateLocations[index]
        val cached = cachedSourceOperationReader(readers: self.sourceFacts.readers, index: self.cur.sourceFactReader, session: self.sourceFacts.session, owner: location.owner)
        val row = match cached {
            Optional.Some(v: val reader) => reader.operationAt(index: location.localIndex)
            Optional.None => self.sourceFacts.operation(owner: location.owner, index: location.localIndex)
        }
        match row {
            Optional.Some(v: val template) => {
                if template.siteKey.sameKey(other: location.siteKey) { return template }
            }
            Optional.None => {}
        }
        panic("internal error: source operation navigation has no owner row")
    }
    // Explicit inspection copy for diagnostics/tests, never a body reader.
    fn callTemplateSnapshot() -> Array[CallTemplate] {
        mut val result: Array[CallTemplate] = []
        mut val index = 0U64
        while index < self.callTemplateLocations.count() {
            result.append(self.callTemplateAt(index: index))
            index += 1U64
        }
        return result
    }
    // Construction API; successful source publication removes write authority.
    inout fn replaceBuildingCallTemplate(index: U64, template: CallTemplate) -> Bool {
        if index >= self.callTemplateLocations.count() { return false }
        val location = self.callTemplateLocations[index]
        if self.sourceOwnerConstructionClosed(owner: location.owner) || !location.siteKey.sameKey(other: template.siteKey) { return false }
        self.sourceFacts.activate(owner: location.owner)
        if location.localIndex >= self.sourceFacts.activeBuilder.data.operations.count() { return false }
        val prior = self.sourceFacts.activeBuilder.data.operations[location.localIndex]
        self.sourceFacts.activeBuilder.data.operations.set(i: location.localIndex, value: <SourceOperationRow template=template constraints=prior.constraints />)
        return true
    }
}

impl Comp {
    inout fn replaceSourceCallTemplate(index: U64, template: CallTemplate) {
        if !self.replaceBuildingCallTemplate(index: index, template: template) {
            panic("internal error: cannot replace a prepared source call template")
        }
    }
}

pub impl Comp {
    fn callTemplateOperandCount() -> U64 { return self.callTemplateOperandPool.count() }
    fn callTemplateOperandAt(index: U64) -> CallArgumentSource { return self.callTemplateOperandPool[index] }
}

pub impl Comp {
    fn nextLexicalCallTemplate(index: U64) -> U64 { return self.callTemplateBodyNext[index] }
    fn globalCallTemplates(target: U64) -> Array[U64] { return self.globalCallTemplateOwners.getOr(key: target, fallback: []) }
}

impl Comp {
    // A closure/provided owner receives one immutable lexical root identity.
    inout fn registerCallTemplateLexicalRoot(owner: U64, root: U64) -> Bool {
        match self.callTemplateLexicalRoots.get(key: owner) {
            Optional.Some(v: val saved) => { return saved == root }
            Optional.None => {}
        }
        if self.sourceFacts.outcome(owner: <SemanticCompletionOwner.Function index=owner />).isSome() || self.callTemplateBodyHeads.getOr(key: owner, fallback: 0U64) != 0U64 { return false }
        self.callTemplateLexicalRoots[owner] = root
        return true
    }
}

pub impl Comp {
    fn lexicalBodyPreparationCount() -> U64 { return self.sourceFacts.functionRequests }
    fn globalInitializerPreparationCount() -> U64 { return self.sourceFacts.globalRequests }
}

impl Comp {
    inout fn appendSourceCallTemplate(template: CallTemplate, resultExpression: Optional[U64] = <Optional.None />) {
        if !self.appendCallTemplate(template: template, resultExpression: resultExpression) {
            panic("internal error: cannot append to a completed source call owner")
        }
    }
}

impl Comp {
    inout fn recordGlobalCallTemplateOwner(templateIndex: U64) {
        match self.lexicalSourceFactOwner(owner: self.callTemplateLocations[templateIndex].owner) {
            SemanticCompletionOwner.Global(target: val target) => {
                mut val indices = self.globalCallTemplateOwners.getOr(key: target, fallback: [])
                mut val present = false
                for index in indices { if index == templateIndex { present = true } }
                if !present { indices.append(templateIndex) }
                self.globalCallTemplateOwners[target] = indices
            }
            SemanticCompletionOwner.Function(index: _) => {}
            SemanticCompletionOwner.Closure(expression: _) => { panic("internal error: closure call has no lexical parent") }
        }
    }

    inout fn indexLexicalCallTemplate(templateIndex: U64) {
        val owner = self.callTemplateLocations[templateIndex].siteKey.ownerFnIdx
        val root = self.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        val tail = self.callTemplateBodyTails.getOr(key: root, fallback: 0U64)
        self.callTemplateBodyNext.append(0U64)
        if tail == 0U64 {
            self.callTemplateBodyHeads[root] = templateIndex + 1U64
        } else {
            self.callTemplateBodyNext.set(i: tail - 1U64, value: templateIndex + 1U64)
        }
        self.callTemplateBodyTails[root] = templateIndex + 1U64
    }

}


impl Comp {
    fn sourceOperationConstraints(index: U64) -> Optional[CallConstraintPlanState] {
        if index >= self.callTemplateLocations.count() { return <Optional.None /> }
        val location = self.callTemplateLocations[index]
        match cachedSourceOperationReader(readers: self.sourceFacts.readers, index: self.cur.sourceFactReader, session: self.sourceFacts.session, owner: location.owner) {
            Optional.Some(v: val reader) => { return readSourceOperationConstraints(rows: reader.payload->operations, index: location.localIndex) }
            Optional.None => { return self.sourceFacts.operationConstraints(owner: location.owner, index: location.localIndex) }
        }
    }
    inout fn storeBuildingOperationConstraints(index: U64, state: CallConstraintPlanState) -> Bool {
        if index >= self.callTemplateLocations.count() { return false }
        val location = self.callTemplateLocations[index]
        if self.sourceOwnerConstructionClosed(owner: location.owner) { return false }
        self.sourceFacts.activate(owner: location.owner)
        if location.localIndex >= self.sourceFacts.activeBuilder.data.operations.count() { return false }
        val prior = self.sourceFacts.activeBuilder.data.operations[location.localIndex]
        self.sourceFacts.activeBuilder.data.operations.set(i: location.localIndex, value: <SourceOperationRow template=prior.template constraints=<Optional.Some v=state /> />)
        return true
    }
}
