// Part of compile-time checks (root: _.pw): impl-on-builtin / newtype and
// move-receiver validation.

pub impl Comp {
    inout fn checkImplOnBuiltin() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            // only primitive *scalars* (I8..U64, Bool) are method-less: their behaviour
            // is trait-only, so an inherent method on one is rejected. `String`/`Array`
            // are owned aggregate lang-items that legitimately carry inherent methods
            // (`isEmpty`, `append`, …) written in Core, so they are not in this group.
            mut val onBuiltin: Bool = false
            if f.hasRecv {
                onBuiltin = self.isPrimType(start: f.recvStart, len: f.recvLen)
            } else {
                if f.isAssoc {
                    onBuiltin = self.isPrimType(start: f.recvStart, len: f.recvLen)
                }
            }
            // a *trait-conformance* member on a primitive/String is allowed: Core owns
            // the type (`extern { struct I32 }`) and may coherently `impl I32 as Format`
            // (spec/07,09). An *inherent* method on a primitive (`impl I32 { fn foo }`)
            // is still rejected — primitive behaviour is trait-only, and a third party
            // must use `#Ext`. (Full owner-only enforcement of conformances awaits
            // module identity; a non-witnessing inherent method is the case we can tell
            // apart in the flat model, and it covers the impl-on-builtin footgun.)
            if onBuiltin {
                if self.methodWitnessesAConformance(recvStart: f.recvStart, recvLen: f.recvLen, mStart: f.nameStart, mLen: f.nameLen) {
                    onBuiltin = false
                }
            }
            // an extension method (`extension Ext { impl I64 { … } }`) legitimately adds
            // behaviour to a built-in via the `#Ext` view (spec/09) — not bare — so it is
            // exempt from the inherent-method-on-builtin rejection.
            if f.extId != 0U64 {
                onBuiltin = false
            }
            if onBuiltin {
                self.errorAt(offset: self.fnAnchor(f: f), msg: "cannot define methods on a built-in type you do not own (use a trait conformance via core, or an extension `#Ext`)")
            }
            i += 1
        }
    }

    inout fn checkImplOnNewtype() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv || f.isAssoc {
                if self.newtypeUnderRef(start: f.recvStart, len: f.recvLen) != 0U64 {
                    self.errorAt(offset: self.fnAnchor(f: f), msg: "cannot write `impl` on a newtype — it inherits the underlying type's methods and conformances automatically; wrap in a struct to add behaviour (spec/10)")
                }
            }
            i += 1
        }
    }

    inout fn checkTraitProvidedMethodOwners() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.extId == 0U64 {
                if self.methodRecvIsTrait(f: f) {
                    val ownerMod: U64 = self.traitModuleByOwner(owner: f.provTraitOwner)
                    if ownerMod != 4000000000U64 {
                        if self.moduleOf(offset: self.fnAnchor(f: f)) != ownerMod {
                            self.errorAt(offset: self.fnAnchor(f: f), msg: "provided methods for a trait must be declared in the trait owner's module; use a named extension for third-party additions (spec/08,15)")
                        }
                    }
                }
            }
            i += 1
        }
    }

    inout fn checkTraitSubjectConformOwners() {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if !(cf.derived) && cf.extId == 0U64 && !(self.isMacrointerfaceCompatConform(cf: cf)) {
                val ownerMod: U64 = self.traitModuleByIdArity(traitId: cf.typeId, arity: cf.subjectArgs.count())
                if ownerMod != 4000000000U64 {
                    if self.moduleOf(offset: cf.defOffset) != ownerMod {
                        self.errorAt(offset: cf.defOffset, msg: "bare inter-trait conformance `impl B as A` must be declared in the subject trait's owner module; use a named extension for third-party additions (spec/08,09)")
                    }
                }
            }
            i += 1
        }
    }

    // Trait-subject conformances are directed instance edges.  The concrete
    // conformance fixpoint is intentionally idempotent, but its fact
    // deduplication is not declaration-graph validation: a cycle is invalid
    // even if the fixpoint happens to stop adding duplicate facts.
    //
    // Every term carries the index of the declaration that introduced its
    // binders.  This lets one DFS compose `impl[T]` substitutions across an
    // arbitrary path instead of conflating same-spelled variables from two
    // declarations (or merely comparing generic patterns pairwise).
    // `scope` identifies one traversal of a declaration, rather than the
    // declaration itself.  Its low component chooses the Conform pattern;
    // the full value remains binder identity, so reusing one generic edge
    // freshens its variables.
    inout fn traitCycleDecl(scope: U64) -> U64 {
        if self.decls.conforms.count() == 0U64 { return 4000000000U64 }
        return scope % self.decls.conforms.count()
    }

    inout fn traitCycleBinder(ref: U64, scope: U64) -> U64 {
        val decl: U64 = self.traitCycleDecl(scope: scope)
        if decl >= self.decls.conforms.count() { return 4000000000U64 }
        return self.plainBinder(ref: ref, params: self.copyConformBinds(binds: self.decls.conforms[decl].typeParams))
    }

    inout fn traitCycleBindIndex(binds: Array[TraitCycleBind], scope: U64, nameId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].scope == scope && binds[i].nameId == nameId { return i }
            i += 1U64
        }
        return binds.count()
    }

    inout fn traitCycleOccurs(term: TraitCycleTerm, scope: U64, nameId: U64, binds: Array[TraitCycleBind]) -> Bool {
        val binder: U64 = self.traitCycleBinder(ref: term.ref, scope: term.scope)
        val decl: U64 = self.traitCycleDecl(scope: term.scope)
        if decl < self.decls.conforms.count() && binder < self.decls.conforms[decl].typeParams.count() {
            val bound: U64 = self.traitCycleBindIndex(binds: binds, scope: term.scope, nameId: self.conformBindAt(binds: self.decls.conforms[decl].typeParams, index: binder).nameId)
            if bound < binds.count() {
                return self.traitCycleOccurs(term: <TraitCycleTerm ref=binds[bound].ref scope=binds[bound].refScope />, scope: scope, nameId: nameId, binds: binds)
            }
            return term.scope == scope && self.conformBindAt(binds: self.decls.conforms[decl].typeParams, index: binder).nameId == nameId
        }
        if term.ref == 0U64 || term.ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[term.ref]
        // The closed child view includes record fields and a projection's
        // receiver, so occurs checking cannot accidentally flatten either.
        mut val i: U64 = 0U64
        while i < self.typeTermChildCount(t: t) {
            if self.traitCycleOccurs(term: <TraitCycleTerm ref=self.typeTermChildRef(t: t, index: i) scope=term.scope />, scope: scope, nameId: nameId, binds: binds) { return true }
            i += 1U64
        }
        return false
    }

    // 0 = structurally different, 1 = exactly unifiable, 2 = structurally
    // equal except that unifying it would require a self-embedding binder.
    // Keeping the third outcome separate is important: a growth in one
    // argument is not a cycle when another argument cannot match.
    inout fn traitCycleTermRelation(a: TraitCycleTerm, b: TraitCycleTerm, binds: inout Array[TraitCycleBind]) -> U64 {
        val ab: U64 = self.traitCycleBinder(ref: a.ref, scope: a.scope)
        val bb: U64 = self.traitCycleBinder(ref: b.ref, scope: b.scope)
        val aDecl: U64 = self.traitCycleDecl(scope: a.scope)
        val bDecl: U64 = self.traitCycleDecl(scope: b.scope)
        val aIsBinder: Bool = aDecl < self.decls.conforms.count() && ab < self.decls.conforms[aDecl].typeParams.count()
        val bIsBinder: Bool = bDecl < self.decls.conforms.count() && bb < self.decls.conforms[bDecl].typeParams.count()
        // Follow either existing substitution before deciding which free binder
        // to bind.  In particular, after `T = U`, comparing free `U` with `T`
        // must succeed as the same instance; binding U back to its own alias
        // would instead trip the occurs check and hide a generic cycle.
        if aIsBinder {
            val aName: U64 = self.conformBindAt(binds: self.decls.conforms[aDecl].typeParams, index: ab).nameId
            val aFound: U64 = self.traitCycleBindIndex(binds: binds, scope: a.scope, nameId: aName)
            if aFound < binds.count() {
                return self.traitCycleTermRelation(a: <TraitCycleTerm ref=binds[aFound].ref scope=binds[aFound].refScope />, b: b, binds: inout binds)
            }
        }
        if bIsBinder {
            val bName: U64 = self.conformBindAt(binds: self.decls.conforms[bDecl].typeParams, index: bb).nameId
            val bFound: U64 = self.traitCycleBindIndex(binds: binds, scope: b.scope, nameId: bName)
            if bFound < binds.count() {
                return self.traitCycleTermRelation(a: a, b: <TraitCycleTerm ref=binds[bFound].ref scope=binds[bFound].refScope />, binds: inout binds)
            }
        }
        if aIsBinder && bIsBinder && a.scope == b.scope && ab == bb { return 1U64 }
        if aIsBinder {
            val nameId: U64 = self.conformBindAt(binds: self.decls.conforms[aDecl].typeParams, index: ab).nameId
            if self.traitCycleOccurs(term: b, scope: a.scope, nameId: nameId, binds: binds) { return 2U64 }
            binds.append(<TraitCycleBind scope=a.scope nameId=nameId ref=b.ref refScope=b.scope />)
            return 1U64
        }
        if bIsBinder { return self.traitCycleTermRelation(a: b, b: a, binds: inout binds) }
        if a.ref == 0U64 || b.ref == 0U64 || a.ref >= self.arena.types.count() || b.ref >= self.arena.types.count() {
            if a.ref == b.ref { return 1U64 }
            return 0U64
        }
        val ta: TypeRef = self.arena.types[a.ref]
        val tb: TypeRef = self.arena.types[b.ref]
        if ta.assocNameId != 0U64 || tb.assocNameId != 0U64 {
            if ta.assocNameId == 0U64 || tb.assocNameId == 0U64 || ta.assocTraitId != tb.assocTraitId || ta.hasAssocTraitDecl != tb.hasAssocTraitDecl || ta.assocTraitDeclOffset != tb.assocTraitDeclOffset || ta.assocNameId != tb.assocNameId { return 0U64 }
        } else if ta.nameId != tb.nameId || ta.hasDecl != tb.hasDecl || ta.declOffset != tb.declOffset || ta.isRecord != tb.isRecord || ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable || ta.assocTraitId != tb.assocTraitId || ta.hasAssocTraitDecl != tb.hasAssocTraitDecl || ta.assocTraitDeclOffset != tb.assocTraitDeclOffset || ta.assocNameId != tb.assocNameId { return 0U64 }
        if self.typeTermChildCount(t: ta) != self.typeTermChildCount(t: tb) { return 0U64 }
        mut val i: U64 = 0U64
        mut val grows: Bool = false
        while i < self.typeTermChildCount(t: ta) {
            if self.typeTermChildLabel(t: ta, index: i) != self.typeTermChildLabel(t: tb, index: i) { return 0U64 }
            val relation: U64 = self.traitCycleTermRelation(a: <TraitCycleTerm ref=self.typeTermChildRef(t: ta, index: i) scope=a.scope />, b: <TraitCycleTerm ref=self.typeTermChildRef(t: tb, index: i) scope=b.scope />, binds: inout binds)
            if relation == 0U64 { return 0U64 }
            if relation == 2U64 { grows = true }
            i += 1U64
        }
        if grows { return 2U64 }
        return 1U64
    }

    inout fn unifyTraitCycleTerms(a: TraitCycleTerm, b: TraitCycleTerm, binds: inout Array[TraitCycleBind]) -> Bool {
        return self.traitCycleTermRelation(a: a, b: b, binds: inout binds) == 1U64
    }

    inout fn copyTraitCycleBinds(binds: Array[TraitCycleBind]) -> Array[TraitCycleBind] {
        mut val copied: Array[TraitCycleBind] = []
        mut val i: U64 = 0U64
        while i < binds.count() {
            copied.append(binds[i])
            i += 1U64
        }
        return copied
    }

    inout fn traitCycleNodeMatches(a: TraitCycleNode, b: TraitCycleNode, binds: inout Array[TraitCycleBind]) -> Bool {
        if a.owner != b.owner || a.args.count() != b.args.count() { return false }
        mut val i: U64 = 0U64
        while i < a.args.count() {
            if !(self.unifyTraitCycleTerms(a: <TraitCycleTerm ref=a.args[i] scope=a.scope />, b: <TraitCycleTerm ref=b.args[i] scope=b.scope />, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn traitCycleEdgeActive(cf: Conform, activeExtIds: Array[U64]) -> Bool {
        if cf.derived || self.isMacrointerfaceCompatConform(cf: cf) { return false }
        if self.canonicalTraitOwner(start: cf.typeStart, len: cf.typeLen) != cf.typeStart { return false }
        if self.canonicalTraitOwner(start: cf.traitStart, len: cf.traitLen) != cf.traitStart { return false }
        if cf.extId == 0U64 { return true }
        mut val i: U64 = 0U64
        while i < activeExtIds.count() {
            if activeExtIds[i] == cf.extId { return true }
            i += 1U64
        }
        return false
    }

    // Fresh traversal scopes are implementation artefacts.  Two states that
    // differ only in those names are one symbolic state, so compare their
    // reachable terms modulo a bijection of scope identities.
    inout fn traitCycleScopePairIndex(aScopes: Array[U64], bScopes: Array[U64], a: U64, b: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < aScopes.count() {
            if aScopes[i] == a {
                if bScopes[i] == b { return i }
                return aScopes.count()
            }
            if bScopes[i] == b { return aScopes.count() }
            i += 1U64
        }
        return aScopes.count()
    }

    inout fn traitCycleTermsAlphaEqual(a: TraitCycleTerm, b: TraitCycleTerm, aBinds: Array[TraitCycleBind], bBinds: Array[TraitCycleBind], aScopes: inout Array[U64], bScopes: inout Array[U64]) -> Bool {
        val aBinder: U64 = self.traitCycleBinder(ref: a.ref, scope: a.scope)
        val bBinder: U64 = self.traitCycleBinder(ref: b.ref, scope: b.scope)
        val aDecl: U64 = self.traitCycleDecl(scope: a.scope)
        val bDecl: U64 = self.traitCycleDecl(scope: b.scope)
        val aIsBinder: Bool = aDecl < self.decls.conforms.count() && aBinder < self.decls.conforms[aDecl].typeParams.count()
        val bIsBinder: Bool = bDecl < self.decls.conforms.count() && bBinder < self.decls.conforms[bDecl].typeParams.count()
        if aIsBinder {
            val ai: U64 = self.traitCycleBindIndex(binds: aBinds, scope: a.scope, nameId: self.conformBindAt(binds: self.decls.conforms[aDecl].typeParams, index: aBinder).nameId)
            if ai < aBinds.count() { return self.traitCycleTermsAlphaEqual(a: <TraitCycleTerm ref=aBinds[ai].ref scope=aBinds[ai].refScope />, b: b, aBinds: aBinds, bBinds: bBinds, aScopes: inout aScopes, bScopes: inout bScopes) }
        }
        if bIsBinder {
            val bi: U64 = self.traitCycleBindIndex(binds: bBinds, scope: b.scope, nameId: self.conformBindAt(binds: self.decls.conforms[bDecl].typeParams, index: bBinder).nameId)
            if bi < bBinds.count() { return self.traitCycleTermsAlphaEqual(a: a, b: <TraitCycleTerm ref=bBinds[bi].ref scope=bBinds[bi].refScope />, aBinds: aBinds, bBinds: bBinds, aScopes: inout aScopes, bScopes: inout bScopes) }
        }
        if aIsBinder || bIsBinder {
            if !(aIsBinder) || !(bIsBinder) || aDecl != bDecl || aBinder != bBinder { return false }
            val paired: U64 = self.traitCycleScopePairIndex(aScopes: aScopes, bScopes: bScopes, a: a.scope, b: b.scope)
            if paired < aScopes.count() { return true }
            aScopes.append(a.scope)
            bScopes.append(b.scope)
            return true
        }
        if a.ref == 0U64 || b.ref == 0U64 || a.ref >= self.arena.types.count() || b.ref >= self.arena.types.count() { return a.ref == b.ref }
        val ta: TypeRef = self.arena.types[a.ref]
        val tb: TypeRef = self.arena.types[b.ref]
        if ta.assocNameId != 0U64 || tb.assocNameId != 0U64 {
            if ta.assocNameId == 0U64 || tb.assocNameId == 0U64 || ta.assocTraitId != tb.assocTraitId || ta.hasAssocTraitDecl != tb.hasAssocTraitDecl || ta.assocTraitDeclOffset != tb.assocTraitDeclOffset || ta.assocNameId != tb.assocNameId { return false }
        } else if ta.nameId != tb.nameId || ta.hasDecl != tb.hasDecl || ta.declOffset != tb.declOffset || ta.isRecord != tb.isRecord || ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable || ta.assocTraitId != tb.assocTraitId || ta.hasAssocTraitDecl != tb.hasAssocTraitDecl || ta.assocTraitDeclOffset != tb.assocTraitDeclOffset || ta.assocNameId != tb.assocNameId { return false }
        if self.typeTermChildCount(t: ta) != self.typeTermChildCount(t: tb) { return false }
        mut val i: U64 = 0U64
        while i < self.typeTermChildCount(t: ta) {
            if self.typeTermChildLabel(t: ta, index: i) != self.typeTermChildLabel(t: tb, index: i) || !(self.traitCycleTermsAlphaEqual(a: <TraitCycleTerm ref=self.typeTermChildRef(t: ta, index: i) scope=a.scope />, b: <TraitCycleTerm ref=self.typeTermChildRef(t: tb, index: i) scope=b.scope />, aBinds: aBinds, bBinds: bBinds, aScopes: inout aScopes, bScopes: inout bScopes)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn traitCycleSearchEquivalent(a: TraitCycleSearch, b: TraitCycleSearch) -> Bool {
        if a.node.owner != b.node.owner || a.node.args.count() != b.node.args.count() { return false }
        mut val aScopes: Array[U64] = []
        mut val bScopes: Array[U64] = []
        mut val i: U64 = 0U64
        while i < a.node.args.count() {
            if !(self.traitCycleTermsAlphaEqual(a: <TraitCycleTerm ref=a.node.args[i] scope=a.node.scope />, b: <TraitCycleTerm ref=b.node.args[i] scope=b.node.scope />, aBinds: a.binds, bBinds: b.binds, aScopes: inout aScopes, bScopes: inout bScopes)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn traitCyclePathReaches(start: TraitCycleNode, node: TraitCycleNode, binds: Array[TraitCycleBind], activeExtIds: Array[U64]) -> Bool {
        mut val pending: Array[TraitCycleSearch] = [<TraitCycleSearch node=node binds=binds />]
        mut val visited: Array[TraitCycleSearch] = []
        mut val cursor: U64 = 0U64
        while cursor < pending.count() {
            val current: TraitCycleSearch = pending[cursor]
            cursor += 1U64
            mut val closedBinds: Array[TraitCycleBind] = self.copyTraitCycleBinds(binds: current.binds)
            if self.traitCycleNodeMatches(a: current.node, b: start, binds: inout closedBinds) { return true }
            mut val seen: Bool = false
            mut val vi: U64 = 0U64
            while vi < visited.count() {
                if self.traitCycleSearchEquivalent(a: current, b: visited[vi]) { seen = true }
                vi += 1U64
            }
            if seen { continue }
            visited.append(current)
            mut val ci: U64 = 0U64
            while ci < self.decls.conforms.count() {
                val edge: Conform = self.decls.conforms[ci]
                if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) {
                    mut val nextBinds: Array[TraitCycleBind] = self.copyTraitCycleBinds(binds: current.binds)
                    val scope: U64 = (cursor + 1U64) * self.decls.conforms.count() + ci
                    val subject: TraitCycleNode = <TraitCycleNode owner=edge.typeStart args=self.copyConformTypes(types: edge.subjectArgs) scope=scope />
                    if self.traitCycleNodeMatches(a: current.node, b: subject, binds: inout nextBinds) {
                        val target: TraitCycleNode = <TraitCycleNode owner=edge.traitStart args=self.copyConformTypes(types: edge.traitArgs) scope=scope />
                        pending.append(<TraitCycleSearch node=target binds=nextBinds />)
                    }
                }
                ci += 1U64
            }
        }
        return false
    }

    // The owner graph decides only SCC membership; exact trait instances are
    // handled by the symbolic automaton.  Build components once per active
    // source-set with iterative Kosaraju, keeping compiler-stack use bounded.
    inout fn traitCycleOwnerIndex(owners: Array[U64], owner: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < owners.count() {
            if owners[i] == owner { return i }
            i += 1U64
        }
        return owners.count()
    }

    inout fn traitCycleOwners(activeExtIds: Array[U64]) -> Array[U64] {
        mut val owners: Array[U64] = []
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val edge: Conform = self.decls.conforms[ci]
            if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) {
                if self.traitCycleOwnerIndex(owners: owners, owner: edge.typeStart) == owners.count() { owners.append(edge.typeStart) }
                if self.traitCycleOwnerIndex(owners: owners, owner: edge.traitStart) == owners.count() { owners.append(edge.traitStart) }
            }
            ci += 1U64
        }
        return owners
    }

    inout fn traitCycleOwnerComponents(owners: Array[U64], activeExtIds: Array[U64]) -> Array[U64] {
        mut val visited: Array[Bool] = []
        mut val components: Array[U64] = []
        mut val oi: U64 = 0U64
        while oi < owners.count() {
            visited.append(false)
            components.append(0U64)
            oi += 1U64
        }
        mut val finish: Array[U64] = []
        oi = 0U64
        while oi < owners.count() {
            if !(visited[oi]) {
                mut val nodes: Array[U64] = [owners[oi]]
                mut val nextEdges: Array[U64] = [0U64]
                visited[oi] = true
                while nodes.count() > 0U64 {
                    val top: U64 = nodes.count() - 1U64
                    val owner: U64 = nodes[top]
                    mut val ci: U64 = nextEdges[top]
                    mut val advanced: Bool = false
                    while ci < self.decls.conforms.count() && !(advanced) {
                        nextEdges[top] = ci + 1U64
                        val edge: Conform = self.decls.conforms[ci]
                        if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) && edge.typeStart == owner {
                            val ni: U64 = self.traitCycleOwnerIndex(owners: owners, owner: edge.traitStart)
                            if ni < owners.count() && !(visited[ni]) {
                                visited[ni] = true
                                nodes.append(edge.traitStart)
                                nextEdges.append(0U64)
                                advanced = true
                            }
                        }
                        ci += 1U64
                    }
                    if !(advanced) {
                        finish.append(owner)
                        nodes.removeLast()
                        nextEdges.removeLast()
                    }
                }
            }
            oi += 1U64
        }
        mut val component: U64 = 1U64
        mut val fi: U64 = finish.count()
        while fi > 0U64 {
            fi -= 1U64
            val root: U64 = finish[fi]
            val ri: U64 = self.traitCycleOwnerIndex(owners: owners, owner: root)
            if ri < owners.count() && components[ri] == 0U64 {
                mut val pending: Array[U64] = [root]
                components[ri] = component
                mut val pi: U64 = 0U64
                while pi < pending.count() {
                    val owner: U64 = pending[pi]
                    pi += 1U64
                    mut val ci: U64 = 0U64
                    while ci < self.decls.conforms.count() {
                        val edge: Conform = self.decls.conforms[ci]
                        if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) && edge.traitStart == owner {
                            val ni: U64 = self.traitCycleOwnerIndex(owners: owners, owner: edge.typeStart)
                            if ni < owners.count() && components[ni] == 0U64 {
                                components[ni] = component
                                pending.append(edge.typeStart)
                            }
                        }
                        ci += 1U64
                    }
                }
                component += 1U64
            }
        }
        return components
    }

    inout fn traitCycleConstructorCount(ref: U64, params: Array[Bind]) -> U64 {
        if self.plainBinder(ref: ref, params: params) < params.count() { return 0U64 }
        if ref == 0U64 || ref >= self.arena.types.count() { return 1U64 }
        val t: TypeRef = self.arena.types[ref]
        mut val count: U64 = 1U64
        mut val i: U64 = 0U64
        while i < self.typeTermChildCount(t: t) {
            count += self.traitCycleConstructorCount(ref: self.typeTermChildRef(t: t, index: i), params: params)
            i += 1U64
        }
        return count
    }

    inout fn traitCycleBinderOccurrences(ref: U64, params: Array[Bind], binder: U64) -> U64 {
        if self.plainBinder(ref: ref, params: params) == binder { return 1U64 }
        if ref == 0U64 || ref >= self.arena.types.count() { return 0U64 }
        val t: TypeRef = self.arena.types[ref]
        mut val count: U64 = 0U64
        mut val i: U64 = 0U64
        while i < self.typeTermChildCount(t: t) {
            count += self.traitCycleBinderOccurrences(ref: self.typeTermChildRef(t: t, index: i), params: params, binder: binder)
            i += 1U64
        }
        return count
    }

    // An edge inside an owner SCC may only preserve or shrink the finite
    // term carried by its positional trait arguments.  Compare the product of
    // all arguments: target constructors may not outnumber subject
    // constructors, and no subject binder may be introduced or duplicated.
    // This local ranking rule admits Array[T] -> T while rejecting T ->
    // Array[T] and T -> (T, T), without mistaking a shrinking path for an
    // occurs-check cycle.
    inout fn traitCycleEdgeIsNonIncreasing(cf: Conform) -> Bool {
        mut val subjectConstructors: U64 = 0U64
        mut val targetConstructors: U64 = 0U64
        mut val i: U64 = 0U64
        while i < cf.subjectArgs.count() {
            subjectConstructors += self.traitCycleConstructorCount(ref: self.conformTypeAt(types: cf.subjectArgs, index: i), params: self.copyConformBinds(binds: cf.typeParams))
            i += 1U64
        }
        i = 0U64
        while i < cf.traitArgs.count() {
            targetConstructors += self.traitCycleConstructorCount(ref: self.conformTypeAt(types: cf.traitArgs, index: i), params: self.copyConformBinds(binds: cf.typeParams))
            i += 1U64
        }
        if targetConstructors > subjectConstructors { return false }
        mut val binder: U64 = 0U64
        while binder < cf.typeParams.count() {
            mut val subjectUses: U64 = 0U64
            mut val targetUses: U64 = 0U64
            i = 0U64
            while i < cf.subjectArgs.count() {
                subjectUses += self.traitCycleBinderOccurrences(ref: self.conformTypeAt(types: cf.subjectArgs, index: i), params: self.copyConformBinds(binds: cf.typeParams), binder: binder)
                i += 1U64
            }
            i = 0U64
            while i < cf.traitArgs.count() {
                targetUses += self.traitCycleBinderOccurrences(ref: self.conformTypeAt(types: cf.traitArgs, index: i), params: self.copyConformBinds(binds: cf.typeParams), binder: binder)
                i += 1U64
            }
            if targetUses > subjectUses { return false }
            binder += 1U64
        }
        return true
    }

    // `activeExtIds` is empty for the declaration-time bare graph.  A view
    // passes its complete extension-source set, making extensions edge-active
    // only when the programmer explicitly selected them.
    inout fn checkTraitSubjectCycles(activeExtIds: Array[U64], offset: U64 = 0U64) {
        val owners: Array[U64] = self.traitCycleOwners(activeExtIds: activeExtIds)
        val components: Array[U64] = self.traitCycleOwnerComponents(owners: owners, activeExtIds: activeExtIds)
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val edge: Conform = self.decls.conforms[ci]
            if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) {
                val sourceOwner: U64 = self.traitCycleOwnerIndex(owners: owners, owner: edge.typeStart)
                val targetOwner: U64 = self.traitCycleOwnerIndex(owners: owners, owner: edge.traitStart)
                if sourceOwner < owners.count() && targetOwner < owners.count() && components[sourceOwner] == components[targetOwner] {
                    if !(self.traitCycleEdgeIsNonIncreasing(cf: edge)) {
                        mut val report: U64 = edge.defOffset
                        if offset != 0U64 { report = offset }
                        self.errorAt(offset: report, msg: "trait-to-trait conformance edge grows within a cycle")
                    }
                }
                val source: TraitCycleNode = <TraitCycleNode owner=edge.typeStart args=self.copyConformTypes(types: edge.subjectArgs) scope=ci />
                val target: TraitCycleNode = <TraitCycleNode owner=edge.traitStart args=self.copyConformTypes(types: edge.traitArgs) scope=ci />
                val binds: Array[TraitCycleBind] = []
                if self.traitCyclePathReaches(start: source, node: target, binds: binds, activeExtIds: activeExtIds) {
                    mut val report: U64 = edge.defOffset
                    if offset != 0U64 { report = offset }
                    self.errorAt(offset: report, msg: "trait-to-trait conformance cycle")
                }
            }
            ci += 1U64
        }
    }

    // A named extension is one module-crossing bundle.  Validate every
    // bundle only after registration has collected all of its declaration
    // parts and every bare edge, so the outcome cannot depend on load or
    // declaration order.  `checkTraitSubjectCycles` already treats bare
    // edges as present for every source-set; supplying one bundle id gives
    // exactly `bare ∪ bundle`.
    inout fn checkTraitSubjectCycleBundles() {
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.extId != 0U64 {
                mut val seen: Bool = false
                mut val earlier: U64 = 0U64
                while earlier < ci {
                    if self.decls.conforms[earlier].extId == cf.extId {
                        seen = true
                    }
                    earlier += 1U64
                }
                if !seen {
                    self.checkTraitSubjectCycles(activeExtIds: [cf.extId], offset: cf.defOffset)
                }
            }
            ci += 1U64
        }
    }

    // View cycle validity is structural too: once syntax has normalized a
    // source-set, extension names select their registered bundles regardless
    // of whether a particular receiver can use every member.  Applicability is
    // checked separately by the view validator.
    inout fn checkTraitSubjectViewCycles(viewIds: Array[U64], offset: U64) {
        mut val extIds: Array[U64] = []
        mut val i: U64 = 0U64
        while i < viewIds.count() {
            val id: U64 = viewIds[i]
            if id != 0U64 && id <= self.interner.entries.count() {
                val entry: InternedSpan = self.interner.entries[id - 1U64]
                if self.isExtName(start: entry.start, len: entry.len) {
                    mut val duplicate: Bool = false
                    mut val j: U64 = 0U64
                    while j < extIds.count() {
                        if extIds[j] == id { duplicate = true }
                        j += 1U64
                    }
                    if !duplicate { extIds.append(id) }
                }
            }
            i += 1U64
        }
        self.checkTraitSubjectCycles(activeExtIds: extIds, offset: offset)
    }

    inout fn isMacrointerfaceCompatConform(cf: Conform) -> Bool {
        // Compatibility shim until spec/16's `macro Foo as Derive` surface is lowered
        // to a dedicated macro-provider IR. The current M1 dogfood represents built-in
        // derives as `impl Eq/Hash as Derive` in @Plew/Syntax; these are macrointerface
        // provider registrations, not ordinary runtime inter-trait conformances.
        if cf.traitArgs.count() != 0U64 {
            return false
        }
        val ownerMod: U64 = self.traitModuleByIdArity(traitId: cf.traitId, arity: 0U64)
        if ownerMod == 4000000000U64 {
            return false
        }
        if self.moduleOf(offset: cf.defOffset) != ownerMod {
            return false
        }
        if !(self.moduleIsSyntaxRoot(mod: ownerMod)) {
            return false
        }
        if rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: "Derive") {
            return true
        }
        return rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: "ParameterizedDerive")
    }

    inout fn moduleIsSyntaxRoot(mod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.ranges.count() {
            if self.modules.ranges[i].fieldStart == mod {
                if i < self.modules.rangePaths.count() {
                    if self.pathHasSuffix(path: self.modules.rangePaths[i], suffix: "/syntax/src/_.pw") {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn pathHasSuffix(path: String, suffix: String) -> Bool {
        val p: Array[U8] = path.bytes()
        val s: Array[U8] = suffix.bytes()
        if p.count() < s.count() {
            return false
        }
        mut val i: U64 = 0
        val base: U64 = p.count() - s.count()
        while i < s.count() {
            if p[base + i] != s[i] {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn checkMoveFnReceivers() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.selfMove {
                    if !(self.typeIsUnique(start: f.recvStart, len: f.recvLen)) {
                        self.errorAt(offset: self.fnAnchor(f: f), msg: "`move fn` (consuming self) is only allowed on a unique type")
                    }
                }
            }
            i += 1
        }
    }
}
