// Part of compile-time checks (root: _.pw): impl-on-builtin / newtype and
// move-receiver validation.

pub impl Comp {
    inout fn checkImplOnBuiltin() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            // only primitive *scalars* (I8..U64, Bool) are method-less: their behaviour
            // is trait-only, so an inherent method on one is rejected. `String`/`Array`
            // are owned aggregate lang-items that legitimately carry inherent methods
            // (`isEmpty`, `append`, …) written in Core, so they are not in this group.
            mut val onBuiltin: Bool = false
            if f.hasRecv {
                onBuiltin = self.isPrimType(start: f.recvStart, len: f.recvLen)
            } else {
                if f.isAssoc {
                    onBuiltin = self.isPrimType(start: f.recvStart, len: f.recvLen)
                }
            }
            // a *trait-conformance* member on a primitive/String is allowed: Core owns
            // the type (`extern { struct I32 }`) and may coherently `impl I32 as Format`
            // (spec/07,09). An *inherent* method on a primitive (`impl I32 { fn foo }`)
            // is still rejected — primitive behaviour is trait-only, and a third party
            // must use `#Ext`. (Full owner-only enforcement of conformances awaits
            // module identity; a non-witnessing inherent method is the case we can tell
            // apart in the flat model, and it covers the impl-on-builtin footgun.)
            if onBuiltin {
                if self.methodWitnessesAConformance(recvStart: f.recvStart, recvLen: f.recvLen, mStart: f.nameStart, mLen: f.nameLen) {
                    onBuiltin = false
                }
            }
            // an extension method (`extension Ext { impl I64 { … } }`) legitimately adds
            // behaviour to a built-in via the `#Ext` view (spec/09) — not bare — so it is
            // exempt from the inherent-method-on-builtin rejection.
            if f.extId != 0U64 {
                onBuiltin = false
            }
            if onBuiltin {
                self.errorAt(offset: self.fnAnchor(f: f), msg: "cannot define methods on a built-in type you do not own (use a trait conformance via core, or an extension `#Ext`)")
            }
            i += 1
        }
    }

    inout fn checkImplOnNewtype() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv || f.isAssoc {
                if self.newtypeUnderRef(start: f.recvStart, len: f.recvLen) != 0U64 {
                    self.errorAt(offset: self.fnAnchor(f: f), msg: "cannot write `impl` on a newtype — it inherits the underlying type's methods and conformances automatically; wrap in a struct to add behaviour (spec/10)")
                }
            }
            i += 1
        }
    }

    inout fn checkTraitProvidedMethodOwners() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.extId == 0U64 {
                if self.methodRecvIsTrait(f: f) {
                    val ownerMod: U64 = self.traitModuleByOwner(owner: f.provTraitOwner)
                    if ownerMod != 4000000000U64 {
                        if self.moduleOf(offset: self.fnAnchor(f: f)) != ownerMod {
                            self.errorAt(offset: self.fnAnchor(f: f), msg: "provided methods for a trait must be declared in the trait owner's module; use a named extension for third-party additions (spec/08,15)")
                        }
                    }
                }
            }
            i += 1
        }
    }

    inout fn checkTraitSubjectConformOwners() {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if !(cf.derived) && cf.extId == 0U64 && !(self.isMacrointerfaceCompatConform(cf: cf)) {
                val ownerMod: U64 = self.traitModuleByIdArity(traitId: cf.typeId, arity: cf.subjectArgs.count())
                if ownerMod != 4000000000U64 {
                    if self.moduleOf(offset: cf.defOffset) != ownerMod {
                        self.errorAt(offset: cf.defOffset, msg: "bare inter-trait conformance `impl B as A` must be declared in the subject trait's owner module; use a named extension for third-party additions (spec/08,09)")
                    }
                }
            }
            i += 1
        }
    }

    // Trait-subject conformances are directed instance edges.  The concrete
    // conformance fixpoint is intentionally idempotent, but its fact
    // deduplication is not declaration-graph validation: a cycle is invalid
    // even if the fixpoint happens to stop adding duplicate facts.
    //
    // Every term carries the index of the declaration that introduced its
    // binders.  This lets one DFS compose `impl[T]` substitutions across an
    // arbitrary path instead of conflating same-spelled variables from two
    // declarations (or merely comparing generic patterns pairwise).
    // `scope` identifies one traversal of a declaration, rather than the
    // declaration itself.  Its low component chooses the Conform pattern;
    // the full value remains binder identity, so reusing one generic edge
    // freshens its variables.
    inout fn traitCycleDecl(scope: U64) -> U64 {
        if self.decls.conforms.count() == 0U64 { return 4000000000U64 }
        return scope % self.decls.conforms.count()
    }

    inout fn traitCycleBinder(ref: U64, scope: U64) -> U64 {
        val decl: U64 = self.traitCycleDecl(scope: scope)
        if decl >= self.decls.conforms.count() { return 4000000000U64 }
        return self.plainBinder(ref: ref, params: self.decls.conforms[decl].typeParams)
    }

    inout fn traitCycleBindIndex(binds: Array[TraitCycleBind], scope: U64, nameId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < binds.count() {
            if binds[i].scope == scope && binds[i].nameId == nameId { return i }
            i += 1U64
        }
        return binds.count()
    }

    inout fn traitCycleOccurs(term: TraitCycleTerm, scope: U64, nameId: U64, binds: Array[TraitCycleBind]) -> Bool {
        val binder: U64 = self.traitCycleBinder(ref: term.ref, scope: term.scope)
        val decl: U64 = self.traitCycleDecl(scope: term.scope)
        if decl < self.decls.conforms.count() && binder < self.decls.conforms[decl].typeParams.count() {
            val bound: U64 = self.traitCycleBindIndex(binds: binds, scope: term.scope, nameId: self.decls.conforms[decl].typeParams[binder].nameId)
            if bound < binds.count() {
                return self.traitCycleOccurs(term: <TraitCycleTerm ref=binds[bound].ref scope=binds[bound].refScope />, scope: scope, nameId: nameId, binds: binds)
            }
            return term.scope == scope && self.decls.conforms[decl].typeParams[binder].nameId == nameId
        }
        if term.ref == 0U64 || term.ref >= self.arena.types.count() { return false }
        val t: TypeRef = self.arena.types[term.ref]
        mut val i: U64 = 0U64
        while i < t.args.count() {
            if self.traitCycleOccurs(term: <TraitCycleTerm ref=t.args[i] scope=term.scope />, scope: scope, nameId: nameId, binds: binds) { return true }
            i += 1U64
        }
        return false
    }

    // 0 = structurally different, 1 = exactly unifiable, 2 = structurally
    // equal except that unifying it would require a self-embedding binder.
    // Keeping the third outcome separate is important: a growth in one
    // argument is not a cycle when another argument cannot match.
    inout fn traitCycleTermRelation(a: TraitCycleTerm, b: TraitCycleTerm, binds: inout Array[TraitCycleBind]) -> U64 {
        val ab: U64 = self.traitCycleBinder(ref: a.ref, scope: a.scope)
        val bb: U64 = self.traitCycleBinder(ref: b.ref, scope: b.scope)
        val aDecl: U64 = self.traitCycleDecl(scope: a.scope)
        val bDecl: U64 = self.traitCycleDecl(scope: b.scope)
        val aIsBinder: Bool = aDecl < self.decls.conforms.count() && ab < self.decls.conforms[aDecl].typeParams.count()
        val bIsBinder: Bool = bDecl < self.decls.conforms.count() && bb < self.decls.conforms[bDecl].typeParams.count()
        // Follow either existing substitution before deciding which free binder
        // to bind.  In particular, after `T = U`, comparing free `U` with `T`
        // must succeed as the same instance; binding U back to its own alias
        // would instead trip the occurs check and hide a generic cycle.
        if aIsBinder {
            val aName: U64 = self.decls.conforms[aDecl].typeParams[ab].nameId
            val aFound: U64 = self.traitCycleBindIndex(binds: binds, scope: a.scope, nameId: aName)
            if aFound < binds.count() {
                return self.traitCycleTermRelation(a: <TraitCycleTerm ref=binds[aFound].ref scope=binds[aFound].refScope />, b: b, binds: inout binds)
            }
        }
        if bIsBinder {
            val bName: U64 = self.decls.conforms[bDecl].typeParams[bb].nameId
            val bFound: U64 = self.traitCycleBindIndex(binds: binds, scope: b.scope, nameId: bName)
            if bFound < binds.count() {
                return self.traitCycleTermRelation(a: a, b: <TraitCycleTerm ref=binds[bFound].ref scope=binds[bFound].refScope />, binds: inout binds)
            }
        }
        if aIsBinder && bIsBinder && a.scope == b.scope && ab == bb { return 1U64 }
        if aIsBinder {
            val nameId: U64 = self.decls.conforms[aDecl].typeParams[ab].nameId
            if self.traitCycleOccurs(term: b, scope: a.scope, nameId: nameId, binds: binds) { return 2U64 }
            binds.append(<TraitCycleBind scope=a.scope nameId=nameId ref=b.ref refScope=b.scope />)
            return 1U64
        }
        if bIsBinder { return self.traitCycleTermRelation(a: b, b: a, binds: inout binds) }
        if a.ref == 0U64 || b.ref == 0U64 || a.ref >= self.arena.types.count() || b.ref >= self.arena.types.count() {
            if a.ref == b.ref { return 1U64 }
            return 0U64
        }
        val ta: TypeRef = self.arena.types[a.ref]
        val tb: TypeRef = self.arena.types[b.ref]
        if ta.nameId != tb.nameId || ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)) || ta.isAny != tb.isAny || ta.isSendable != tb.isSendable || ta.assocTraitId != tb.assocTraitId || ta.assocNameId != tb.assocNameId || ta.args.count() != tb.args.count() { return 0U64 }
        mut val i: U64 = 0U64
        mut val grows: Bool = false
        while i < ta.args.count() {
            val relation: U64 = self.traitCycleTermRelation(a: <TraitCycleTerm ref=ta.args[i] scope=a.scope />, b: <TraitCycleTerm ref=tb.args[i] scope=b.scope />, binds: inout binds)
            if relation == 0U64 { return 0U64 }
            if relation == 2U64 { grows = true }
            i += 1U64
        }
        if grows { return 2U64 }
        return 1U64
    }

    inout fn unifyTraitCycleTerms(a: TraitCycleTerm, b: TraitCycleTerm, binds: inout Array[TraitCycleBind]) -> Bool {
        return self.traitCycleTermRelation(a: a, b: b, binds: inout binds) == 1U64
    }

    inout fn copyTraitCycleBinds(binds: Array[TraitCycleBind]) -> Array[TraitCycleBind] {
        mut val copied: Array[TraitCycleBind] = []
        mut val i: U64 = 0U64
        while i < binds.count() {
            copied.append(binds[i])
            i += 1U64
        }
        return copied
    }

    inout fn traitCycleNodeMatches(a: TraitCycleNode, b: TraitCycleNode, binds: inout Array[TraitCycleBind]) -> Bool {
        if a.owner != b.owner || a.args.count() != b.args.count() { return false }
        mut val i: U64 = 0U64
        while i < a.args.count() {
            if !(self.unifyTraitCycleTerms(a: <TraitCycleTerm ref=a.args[i] scope=a.scope />, b: <TraitCycleTerm ref=b.args[i] scope=b.scope />, binds: inout binds)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn traitCycleEdgeActive(cf: Conform, activeExtIds: Array[U64]) -> Bool {
        if cf.derived || self.isMacrointerfaceCompatConform(cf: cf) { return false }
        if self.canonicalTraitOwner(start: cf.typeStart, len: cf.typeLen) != cf.typeStart { return false }
        if self.canonicalTraitOwner(start: cf.traitStart, len: cf.traitLen) != cf.traitStart { return false }
        if cf.extId == 0U64 { return true }
        mut val i: U64 = 0U64
        while i < activeExtIds.count() {
            if activeExtIds[i] == cf.extId { return true }
            i += 1U64
        }
        return false
    }

    inout fn traitCyclePathCloses(node: TraitCycleNode, stack: Array[TraitCycleNode], binds: inout Array[TraitCycleBind]) -> Bool {
        mut val i: U64 = 0U64
        while i < stack.count() {
            // Unification is speculative per candidate.  A partial binding
            // from one non-matching stack node must not constrain the next.
            mut val candidateBinds: Array[TraitCycleBind] = self.copyTraitCycleBinds(binds: binds)
            if self.traitCycleNodeMatches(a: node, b: stack[i], binds: inout candidateBinds) {
                binds = candidateBinds
                return true
            }
            i += 1U64
        }
        return false
    }

    inout fn traitCyclePathGrows(node: TraitCycleNode, stack: Array[TraitCycleNode], binds: Array[TraitCycleBind]) -> Bool {
        mut val i: U64 = 0U64
        while i < stack.count() {
            if node.owner == stack[i].owner && node.args.count() == stack[i].args.count() {
                mut val candidateBinds: Array[TraitCycleBind] = self.copyTraitCycleBinds(binds: binds)
                mut val grows: Bool = false
                mut val j: U64 = 0U64
                while j < node.args.count() {
                    val relation: U64 = self.traitCycleTermRelation(a: <TraitCycleTerm ref=node.args[j] scope=node.scope />, b: <TraitCycleTerm ref=stack[i].args[j] scope=stack[i].scope />, binds: inout candidateBinds)
                    if relation == 0U64 { break }
                    if relation == 2U64 { grows = true }
                    j += 1U64
                }
                if j == node.args.count() && grows { return true }
            }
            i += 1U64
        }
        return false
    }

    inout fn traitCyclePathReaches(node: TraitCycleNode, stack: Array[TraitCycleNode], binds: Array[TraitCycleBind], activeExtIds: Array[U64], depth: U64) -> Bool {
        mut val closedBinds: Array[TraitCycleBind] = self.copyTraitCycleBinds(binds: binds)
        if self.traitCyclePathCloses(node: node, stack: stack, binds: inout closedBinds) { return true }
        if self.traitCyclePathGrows(node: node, stack: stack, binds: binds) { return true }
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val edge: Conform = self.decls.conforms[ci]
            if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) {
                mut val nextBinds: Array[TraitCycleBind] = self.copyTraitCycleBinds(binds: binds)
                val scope: U64 = (depth + 1U64) * self.decls.conforms.count() + ci
                val subject: TraitCycleNode = <TraitCycleNode owner=edge.typeStart args=edge.subjectArgs scope=scope />
                if self.traitCycleNodeMatches(a: node, b: subject, binds: inout nextBinds) {
                    mut val nextStack: Array[TraitCycleNode] = stack
                    nextStack.append(node)
                    val target: TraitCycleNode = <TraitCycleNode owner=edge.traitStart args=edge.traitArgs scope=scope />
                    if self.traitCyclePathReaches(node: target, stack: nextStack, binds: nextBinds, activeExtIds: activeExtIds, depth: depth + 1U64) { return true }
                }
            }
            ci += 1U64
        }
        return false
    }

    // `activeExtIds` is empty for the declaration-time bare graph.  A view
    // passes its complete extension-source set, making extensions edge-active
    // only when the programmer explicitly selected them.
    inout fn checkTraitSubjectCycles(activeExtIds: Array[U64], offset: U64 = 0U64) {
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val edge: Conform = self.decls.conforms[ci]
            if self.traitCycleEdgeActive(cf: edge, activeExtIds: activeExtIds) {
                val source: TraitCycleNode = <TraitCycleNode owner=edge.typeStart args=edge.subjectArgs scope=ci />
                val target: TraitCycleNode = <TraitCycleNode owner=edge.traitStart args=edge.traitArgs scope=ci />
                val stack: Array[TraitCycleNode] = [source]
                val binds: Array[TraitCycleBind] = []
                if self.traitCyclePathReaches(node: target, stack: stack, binds: binds, activeExtIds: activeExtIds, depth: 1U64) {
                    mut val report: U64 = edge.defOffset
                    if offset != 0U64 { report = offset }
                    self.errorAt(offset: report, msg: "trait-to-trait conformance cycle")
                }
            }
            ci += 1U64
        }
    }

    // A named extension is one module-crossing bundle.  Validate every
    // bundle only after registration has collected all of its declaration
    // parts and every bare edge, so the outcome cannot depend on load or
    // declaration order.  `checkTraitSubjectCycles` already treats bare
    // edges as present for every source-set; supplying one bundle id gives
    // exactly `bare ∪ bundle`.
    inout fn checkTraitSubjectCycleBundles() {
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.extId != 0U64 {
                mut val seen: Bool = false
                mut val earlier: U64 = 0U64
                while earlier < ci {
                    if self.decls.conforms[earlier].extId == cf.extId {
                        seen = true
                    }
                    earlier += 1U64
                }
                if !seen {
                    self.checkTraitSubjectCycles(activeExtIds: [cf.extId], offset: cf.defOffset)
                }
            }
            ci += 1U64
        }
    }

    // View cycle validity is structural too: once syntax has normalized a
    // source-set, extension names select their registered bundles regardless
    // of whether a particular receiver can use every member.  Applicability is
    // checked separately by the view validator.
    inout fn checkTraitSubjectViewCycles(viewIds: Array[U64], offset: U64) {
        mut val extIds: Array[U64] = []
        mut val i: U64 = 0U64
        while i < viewIds.count() {
            val id: U64 = viewIds[i]
            if id != 0U64 && id <= self.interner.count {
                if self.isExtName(start: self.interner.starts[id - 1U64], len: self.interner.lens[id - 1U64]) {
                    mut val duplicate: Bool = false
                    mut val j: U64 = 0U64
                    while j < extIds.count() {
                        if extIds[j] == id { duplicate = true }
                        j += 1U64
                    }
                    if !duplicate { extIds.append(id) }
                }
            }
            i += 1U64
        }
        self.checkTraitSubjectCycles(activeExtIds: extIds, offset: offset)
    }

    inout fn isMacrointerfaceCompatConform(cf: Conform) -> Bool {
        // Compatibility shim until spec/16's `macro Foo as Derive` surface is lowered
        // to a dedicated macro-provider IR. The current M1 dogfood represents built-in
        // derives as `impl Eq/Hash as Derive` in @Plew/Syntax; these are macrointerface
        // provider registrations, not ordinary runtime inter-trait conformances.
        if cf.traitArgs.count() != 0U64 {
            return false
        }
        val ownerMod: U64 = self.traitModuleByIdArity(traitId: cf.traitId, arity: 0U64)
        if ownerMod == 4000000000U64 {
            return false
        }
        if self.moduleOf(offset: cf.defOffset) != ownerMod {
            return false
        }
        if !(self.moduleIsSyntaxRoot(mod: ownerMod)) {
            return false
        }
        if rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: "Derive") {
            return true
        }
        return rangeEquals(bytes: self.arena.bytes, start: cf.traitStart, len: cf.traitLen, kw: "ParameterizedDerive")
    }

    inout fn moduleIsSyntaxRoot(mod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.ranges.count() {
            if self.modules.ranges[i].fieldStart == mod {
                if i < self.modules.rangePaths.count() {
                    if self.pathHasSuffix(path: self.modules.rangePaths[i], suffix: "/syntax/src/_.pw") {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn pathHasSuffix(path: String, suffix: String) -> Bool {
        val p: Array[U8] = path.bytes()
        val s: Array[U8] = suffix.bytes()
        if p.count() < s.count() {
            return false
        }
        mut val i: U64 = 0
        val base: U64 = p.count() - s.count()
        while i < s.count() {
            if p[base + i] != s[i] {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn checkMoveFnReceivers() {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.selfMove {
                    if !(self.typeIsUnique(start: f.recvStart, len: f.recvLen)) {
                        self.errorAt(offset: self.fnAnchor(f: f), msg: "`move fn` (consuming self) is only allowed on a unique type")
                    }
                }
            }
            i += 1
        }
    }
}
