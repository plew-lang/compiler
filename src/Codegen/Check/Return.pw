// Source continuation and execution exits share one compositional analysis.

pub impl Comp {
    // A final consumer reads the owner's last Record result. Allocation,
    // signature readiness, and template closure are not source-check proofs.
    inout fn checkedSemanticExprCompletion(exprId: U64) -> Result[SourceCompletion, CompileDiagnostic] {
        if exprId < self.semanticExprTypes.count() {
            match self.semanticExprTypes[exprId].completion {
                Optional.Some(v: val fact) => {
                    if try self.semanticCompletionOwnerPrepared(owner: fact.owner) { return <Result.Ok value=fact.flow /> }
                }
                Optional.None => {}
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: expression completion requires a checked lexical owner") />
    }

    inout fn semanticCompletionOwnerPrepared(owner: SemanticCompletionOwner) -> Result[Bool, CompileDiagnostic] {
        match owner {
            SemanticCompletionOwner.Function(index: val index) => {
                if index < self.arena.functionCount() {
                    match self.lexicalBodyPreparations.get(key: index) {
                        Optional.Some(v: val prepared) => { try prepared return <Result.Ok value=true /> }
                        Optional.None => {}
                    }
                }
            }
            SemanticCompletionOwner.Global(target: val target) => {
                match self.globalInitializerPreparations.get(key: target) {
                    Optional.Some(v: val prepared) => { try prepared return <Result.Ok value=true /> }
                    Optional.None => {}
                }
            }
        }
        return <Result.Ok value=false />
    }

    inout fn checkedSemanticStmtCompletion(stmtId: U64) -> Result[SourceCompletion, CompileDiagnostic] {
        if stmtId < self.semanticStatementCompletions.count() {
            match self.semanticStatementCompletions[stmtId] {
                Optional.Some(v: val fact) => {
                    if try self.semanticCompletionOwnerPrepared(owner: fact.owner) { return <Result.Ok value=fact.flow /> }
                }
                Optional.None => {}
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: self.stmtPrincipalOffset(sid: stmtId), msg: "internal error: statement completion requires a checked lexical owner") />
    }

    inout fn checkedSemanticStmtCompletionOwner(stmtId: U64) -> Result[PreparedSemanticCompletionOwner, CompileDiagnostic] {
        if stmtId < self.semanticStatementCompletions.count() {
            match self.semanticStatementCompletions[stmtId] {
                Optional.Some(v: val fact) => {
                    if try self.semanticCompletionOwnerPrepared(owner: fact.owner) {
                        return <Result.Ok value=<PreparedSemanticCompletionOwner owner=fact.owner /> />
                    }
                }
                Optional.None => {}
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: self.stmtPrincipalOffset(sid: stmtId), msg: "internal error: statement completion requires a checked lexical owner") />
    }

    inout fn semanticStmtCompletionInOwner(stmtId: U64, owner: PreparedSemanticCompletionOwner) -> Result[SourceCompletion, CompileDiagnostic] {
        if stmtId < self.semanticStatementCompletions.count() {
            match self.semanticStatementCompletions[stmtId] {
                Optional.Some(v: val fact) => {
                    if semanticCompletionOwnersEqual(recorded: fact.owner, prepared: owner.owner) {
                        return <Result.Ok value=fact.flow />
                    }
                }
                Optional.None => {}
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: self.stmtPrincipalOffset(sid: stmtId), msg: "internal error: statement completion does not belong to this checked lexical owner") />
    }

    inout fn requireExpressionValue(exprId: U64) -> Result[(), CompileDiagnostic] {
        return self.requireExpressionCompletionValue(exprId: exprId, completion: self.exprCompletion(exprId: exprId))
    }

    inout fn requireExpressionCompletionValue(exprId: U64, completion: SourceCompletion) -> Result[(), CompileDiagnostic] {
        if !completion.source.normal() {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "a source-diverging expression cannot be used as a value (spec/11)") />
        }
        return <Result.Ok value=() />
    }

    inout fn warnUnreachableStatement(stmtId: U64) {
        val offset = self.stmtPrincipalOffset(sid: stmtId)
        if offset == 0U64 || self.reportedUnreachableStatements.contains(offset) { return }
        self.reportedUnreachableStatements.insert(offset)
        val location = self.diagnosticAt(offset: offset, msg: "unreachable code: preceding control flow cannot continue here (spec/11)")
        self.pendingDiagnostics.append(<CompileDiagnostic severity=<DiagnosticSeverity.Warning /> location=location.location message=location.message />)
    }

    inout fn conditionChainCompletion(conditions: ConditionClauseRange, thenBlk: U64, elseBlk: U64) -> SourceCompletion {
        mut val flow = self.blockCompletion(blkId: thenBlk)
        val failure = self.blockCompletion(blkId: elseBlk)
        mut val index = conditions.len
        while index > 0U64 {
            index -= 1U64
            val clause = self.conditionClauseAt(conditions: conditions, index: index)
            flow = completionThen(prefix: self.exprCompletion(exprId: clause.value), next: completionChoice(first: flow, second: failure))
        }
        return flow
    }

    inout fn blockCompletesNormally(blkId: U64) -> Bool {
        return self.blockCompletion(blkId: blkId).execution.normal()
    }

    inout fn exprCompletesNormally(exprId: U64) -> Bool {
        return self.exprCompletion(exprId: exprId).execution.normal()
    }

    inout fn blockCompletion(blkId: U64) -> SourceCompletion {
        mut val flow = <SourceCompletion />
        mut val index = 0U64
        while index < self.blockStmtCount(blkId: blkId) && (flow.source.normal() || flow.execution.normal()) {
            flow = completionThen(prefix: flow, next: self.stmtCompletion(stmtId: self.blockStmtAt(blkId: blkId, index: index)))
            index += 1U64
        }
        return completionBlock(flow: flow)
    }

    inout fn armsCompletion(arms: MatchArmRange) -> SourceCompletion {
        if arms.len == 0U64 { return completionTransfer(transfer: <CompletionTransfer.Diverge />) }
        mut val flow = <SourceCompletion source=<CompletionEdges.empty /> execution=<CompletionEdges.empty /> />
        mut val index = 0U64
        while index < arms.len {
            if !self.unreachableMatchArms.contains(arms.start + index) {
                flow = completionChoice(first: flow, second: self.blockCompletion(blkId: self.matchArmAt(arms: arms, index: index).body))
            }
            index += 1U64
        }
        return flow
    }

    inout fn argumentsCompletion(args: ArgRange) -> SourceCompletion {
        mut val flow = <SourceCompletion />
        mut val index = 0U64
        while index < args.len && (flow.source.normal() || flow.execution.normal()) {
            flow = completionThen(prefix: flow, next: self.exprCompletion(exprId: self.argAt(args: args, index: index).expr))
            index += 1U64
        }
        return flow
    }

    // Selection facts are published by typing, before executable call
    // templates. Pending is not rewritten to Returns by this construction-
    // time walker; finalized readers must require a completed selection.
    fn invocationDiverges(exprId: U64) -> Bool {
        if exprId >= self.semanticExprTypes.count() { return false }
        match self.semanticExprTypes[exprId].invocation {
            InvocationCompletion.Diverges => { return true }
            _ => { return false }
        }
    }

    inout fn exprCompletion(exprId: U64) -> SourceCompletion {
        val operands = self.exprOperandCompletion(exprId: exprId)
        if self.invocationDiverges(exprId: exprId) {
            return completionThen(prefix: operands, next: completionTransfer(transfer: <CompletionTransfer.Diverge />))
        }
        return operands
    }

    inout fn exprOperandCompletion(exprId: U64) -> SourceCompletion {
        if exprId >= self.arena.exprs.count() { return <SourceCompletion /> }
        match self.arena.exprs[exprId] {
            Expr.Block(val body, offset: _) | Expr.Sequence(val body) => { return self.blockCompletion(blkId: body) }
            Expr.IfChain(val conditions, val thenBlk, val elseBlk) => {
                return self.conditionChainCompletion(conditions: conditions, thenBlk: thenBlk, elseBlk: elseBlk)
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                val condition = self.exprCompletion(exprId: cond)
                if !condition.source.normal() && !condition.execution.normal() { return condition }
                return completionThen(prefix: condition, next: completionChoice(first: self.blockCompletion(blkId: thenBlk), second: self.blockCompletion(blkId: elseBlk)))
            }
            Expr.MatchExpr(val scrut, val arms) => {
                val subject = self.exprCompletion(exprId: scrut)
                if !subject.source.normal() && !subject.execution.normal() { return subject }
                return completionThen(prefix: subject, next: self.armsCompletion(arms: arms))
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                val left = self.exprCompletion(exprId: lhs)
                if !left.source.normal() && !left.execution.normal() { return left }
                mut val right = self.exprCompletion(exprId: rhs)
                if op == opAnd() || op == opOr() { right = completionChoice(first: right, second: <SourceCompletion />) }
                return completionThen(prefix: left, next: right)
            }
            Expr.Unary(op: _, val operand) | Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) | Expr.Move(val operand, isBorrow: _) | Expr.Await(val operand) => { return self.exprCompletion(exprId: operand) }
            Expr.Try(val expr) => {
                // Only an evaluated Result branches into Ok continuation or
                // Err propagation. The return escapes blocks and loops but
                // belongs to this invocation, never a surrounding closure.
                val outcome = completionChoice(first: <SourceCompletion />, second: completionTransfer(transfer: <CompletionTransfer.Return />))
                return completionThen(prefix: self.exprCompletion(exprId: expr), next: outcome)
            }
            Expr.Field(val base, nameStart: _, nameLen: _) | Expr.Arrow(val base, nameStart: _, nameLen: _) | Expr.Deref(val base) => { return self.exprCompletion(exprId: base) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.exprCompletion(exprId: recv) }
            Expr.Index(val base, val index) => { return completionThen(prefix: self.exprCompletion(exprId: base), next: self.exprCompletion(exprId: index)) }
            Expr.OptChain(val base, val cont) => {
                return completionThen(prefix: self.exprCompletion(exprId: base), next: completionChoice(first: self.exprCompletion(exprId: cont), second: <SourceCompletion />))
            }
            Expr.Call(nameStart: _, nameLen: _, val args) => { return self.argumentsCompletion(args: args) }
            Expr.Method(val recv, nameStart: _, nameLen: _, val args) | Expr.ExtMethod(val recv, source: _, nameStart: _, nameLen: _, val args) => {
                return completionThen(prefix: self.exprCompletion(exprId: recv), next: self.argumentsCompletion(args: args))
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                mut val flow = <SourceCompletion />
                mut val index = 0U64
                while index < fields.len && (flow.source.normal() || flow.execution.normal()) {
                    flow = completionThen(prefix: flow, next: self.exprCompletion(exprId: self.makeFieldAt(fields: fields, index: index).value))
                    index += 1U64
                }
                return flow
            }
            Expr.Array(val elems) | Expr.Dictionary(entries: val elems) | Expr.Range(rangeTy: _, endpoints: val elems) => {
                mut val flow = <SourceCompletion />
                mut val index = 0U64
                while index < elems.len && (flow.source.normal() || flow.execution.normal()) {
                    flow = completionThen(prefix: flow, next: self.exprCompletion(exprId: self.exprAt(exprs: elems, index: index)))
                    index += 1U64
                }
                return flow
            }
            _ => { return <SourceCompletion /> }
        }
    }

    inout fn stmtCompletion(stmtId: U64) -> SourceCompletion {
        match self.arena.stmts[stmtId] {
            Stmt.ExprStmt(val expr) => { return self.exprCompletion(exprId: expr) }
            Stmt.Give(val value) => { return completionThen(prefix: self.exprCompletion(exprId: value), next: completionTransfer(transfer: <CompletionTransfer.Give />)) }
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { return self.exprCompletion(exprId: init) }
            Stmt.Assign(val target, val value) => { return completionThen(prefix: self.exprCompletion(exprId: target), next: self.exprCompletion(exprId: value)) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                mut val flow = <SourceCompletion />
                if hasValue { flow = self.exprCompletion(exprId: value) }
                return completionThen(prefix: flow, next: completionTransfer(transfer: <CompletionTransfer.Return />))
            }
            Stmt.Panic(val msg, offset: _) => { return completionThen(prefix: self.exprCompletion(exprId: msg), next: completionTransfer(transfer: <CompletionTransfer.Diverge />)) }
            Stmt.Break(offset: _) => { return completionTransfer(transfer: <CompletionTransfer.Break />) }
            Stmt.Continue(offset: _) => { return completionTransfer(transfer: <CompletionTransfer.Continue />) }
            Stmt.IfChain(val conditions, val thenBlk, val elseBlk) => {
                return self.conditionChainCompletion(conditions: conditions, thenBlk: thenBlk, elseBlk: elseBlk)
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                val condition = self.exprCompletion(exprId: cond)
                if !condition.source.normal() && !condition.execution.normal() { return condition }
                mut val alternate = <SourceCompletion />
                if hasElse { alternate = self.blockCompletion(blkId: elseBlk) }
                return completionThen(prefix: condition, next: completionChoice(first: self.blockCompletion(blkId: thenBlk), second: alternate))
            }
            Stmt.Match(val scrut, val arms) => {
                val subject = self.exprCompletion(exprId: scrut)
                if !subject.source.normal() && !subject.execution.normal() { return subject }
                return completionThen(prefix: subject, next: self.armsCompletion(arms: arms))
            }
            Stmt.While(val cond, val body) => {
                val condition = self.exprCompletion(exprId: cond)
                if !condition.source.normal() && !condition.execution.normal() { return condition }
                val loopFlow = completionLoop(body: self.blockCompletion(blkId: body), maySkip: !self.condIsLiteralTrue(id: cond))
                return completionThen(prefix: condition, next: loopFlow)
            }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, varTy: _, val iter, val body, isStruct: _, patStart: _, patLen: _, binds: _) => {
                val iterator = self.exprCompletion(exprId: iter)
                return completionThen(prefix: iterator, next: completionLoop(body: self.blockCompletion(blkId: body), maySkip: true))
            }
        }
    }

    inout fn condIsLiteralTrue(id: U64) -> Bool {
        if id >= self.arena.exprs.count() {
            return false
        }
        match self.arena.exprs[id] {
            Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, isNeg: _) => {
                return isBool && value == 1
            }
            _ => { return false }
        }
    }

    // Declaration and closure bodies share the same invocation contract.
    // Use source exits for forbidden returns, including a return after a
    // non-terminating loop; use execution continuation for fallthrough.
    inout fn checkDivergingBody(blkId: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val flow = self.blockCompletion(blkId: blkId)
        if flow.source.returns() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "a diverging function cannot return to its caller (spec/04)") />
        }
        if flow.execution.normal() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "a diverging function cannot reach the end of its body (spec/04)") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkFunctionReturns(f: Func) -> Result[(), CompileDiagnostic] {
        if f.isDiverging && !f.isExtern && f.body != 0U64 {
            return self.checkDivergingBody(blkId: f.body, offset: f.nameStart)
        }
        // Preserve the existing exemptions: implicit Unit, extern/abstract,
        // async state machines, and the special main entry convention.
        if !f.hasRet || f.isExtern || f.isAsync || f.body == 0U64 || self.nameIsMain(f: f) {
            return <Result.Ok value=() />
        }
        if self.blockCompletesNormally(blkId: f.body) {
            return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "this function has a return type but can reach the end of its body without returning a value; add a `return` (or `panic`) on every path (Plew does not implicitly return the last expression)") />
        }
        return <Result.Ok value=() />
    }

}
