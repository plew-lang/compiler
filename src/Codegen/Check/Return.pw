// Normal continuation and loop escape are shared source-flow facts.

pub impl Comp {
    inout fn conditionChainCompletion(conditions: ConditionClauseRange, thenBlk: U64, elseBlk: U64) -> SourceCompletion {
        mut val flow = self.blockCompletion(blkId: thenBlk)
        val failure = self.blockCompletion(blkId: elseBlk)
        mut val index = conditions.len
        while index > 0U64 {
            index -= 1U64
            val clause = self.conditionClauseAt(conditions: conditions, index: index)
            flow = completionThen(prefix: self.exprCompletion(exprId: clause.value), next: completionChoice(first: flow, second: failure))
        }
        return flow
    }

    inout fn blockCompletesNormally(blkId: U64) -> Bool {
        return self.blockCompletion(blkId: blkId).normal
    }

    inout fn exprCompletesNormally(exprId: U64) -> Bool {
        return self.exprCompletion(exprId: exprId).normal
    }

    inout fn blockCompletion(blkId: U64) -> SourceCompletion {
        mut val flow = <SourceCompletion />
        mut val index = 0U64
        while index < self.blockStmtCount(blkId: blkId) && flow.normal {
            flow = completionThen(prefix: flow, next: self.stmtCompletion(stmtId: self.blockStmtAt(blkId: blkId, index: index)))
            index += 1U64
        }
        return flow
    }

    inout fn armsCompletion(arms: MatchArmRange) -> SourceCompletion {
        mut val flow = <SourceCompletion normal=false />
        mut val index = 0U64
        while index < arms.len {
            flow = completionChoice(first: flow, second: self.blockCompletion(blkId: self.matchArmAt(arms: arms, index: index).body))
            index += 1U64
        }
        return flow
    }

    inout fn argumentsCompletion(args: ArgRange) -> SourceCompletion {
        mut val flow = <SourceCompletion />
        mut val index = 0U64
        while index < args.len && flow.normal {
            flow = completionThen(prefix: flow, next: self.exprCompletion(exprId: self.argAt(args: args, index: index).expr))
            index += 1U64
        }
        return flow
    }

    inout fn exprCompletion(exprId: U64) -> SourceCompletion {
        if exprId >= self.arena.exprs.count() { return <SourceCompletion /> }
        match self.arena.exprs[exprId] {
            Expr.Block(val body, offset: _) | Expr.Sequence(val body) => { return self.blockCompletion(blkId: body) }
            Expr.IfChain(val conditions, val thenBlk, val elseBlk) => {
                return self.conditionChainCompletion(conditions: conditions, thenBlk: thenBlk, elseBlk: elseBlk)
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                val condition = self.exprCompletion(exprId: cond)
                if !condition.normal { return condition }
                return completionThen(prefix: condition, next: completionChoice(first: self.blockCompletion(blkId: thenBlk), second: self.blockCompletion(blkId: elseBlk)))
            }
            Expr.MatchExpr(val scrut, val arms) => {
                val subject = self.exprCompletion(exprId: scrut)
                if !subject.normal { return subject }
                return completionThen(prefix: subject, next: self.armsCompletion(arms: arms))
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                val left = self.exprCompletion(exprId: lhs)
                if !left.normal { return left }
                mut val right = self.exprCompletion(exprId: rhs)
                if op == opAnd() || op == opOr() { right = completionChoice(first: right, second: <SourceCompletion />) }
                return completionThen(prefix: left, next: right)
            }
            Expr.Unary(op: _, val operand) | Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) | Expr.Move(val operand, isBorrow: _) | Expr.Await(val operand) => { return self.exprCompletion(exprId: operand) }
            Expr.Try(val expr) => { return self.exprCompletion(exprId: expr) }
            Expr.Field(val base, nameStart: _, nameLen: _) | Expr.Arrow(val base, nameStart: _, nameLen: _) | Expr.Deref(val base) => { return self.exprCompletion(exprId: base) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.exprCompletion(exprId: recv) }
            Expr.Index(val base, val index) => { return completionThen(prefix: self.exprCompletion(exprId: base), next: self.exprCompletion(exprId: index)) }
            Expr.OptChain(val base, val cont) => {
                return completionThen(prefix: self.exprCompletion(exprId: base), next: completionChoice(first: self.exprCompletion(exprId: cont), second: <SourceCompletion />))
            }
            Expr.Call(nameStart: _, nameLen: _, val args) => { return self.argumentsCompletion(args: args) }
            Expr.Method(val recv, nameStart: _, nameLen: _, val args) | Expr.ExtMethod(val recv, source: _, nameStart: _, nameLen: _, val args) => {
                return completionThen(prefix: self.exprCompletion(exprId: recv), next: self.argumentsCompletion(args: args))
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                mut val flow = <SourceCompletion />
                mut val index = 0U64
                while index < fields.len && flow.normal {
                    flow = completionThen(prefix: flow, next: self.exprCompletion(exprId: self.makeFieldAt(fields: fields, index: index).value))
                    index += 1U64
                }
                return flow
            }
            Expr.Array(val elems) => {
                mut val flow = <SourceCompletion />
                mut val index = 0U64
                while index < elems.len && flow.normal {
                    flow = completionThen(prefix: flow, next: self.exprCompletion(exprId: self.exprAt(exprs: elems, index: index)))
                    index += 1U64
                }
                return flow
            }
            _ => { return <SourceCompletion /> }
        }
    }

    inout fn stmtCompletion(stmtId: U64) -> SourceCompletion {
        match self.arena.stmts[stmtId] {
            Stmt.ExprStmt(val expr) => { return self.exprCompletion(exprId: expr) }
            Stmt.Give(val value) => { return self.exprCompletion(exprId: value) }
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { return self.exprCompletion(exprId: init) }
            Stmt.Assign(val target, val value) => { return completionThen(prefix: self.exprCompletion(exprId: target), next: self.exprCompletion(exprId: value)) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                mut val flow = <SourceCompletion />
                if hasValue { flow = self.exprCompletion(exprId: value) }
                return completionThen(prefix: flow, next: <SourceCompletion normal=false />)
            }
            Stmt.Panic(val msg, offset: _) => { return completionThen(prefix: self.exprCompletion(exprId: msg), next: <SourceCompletion normal=false />) }
            Stmt.Break(offset: _) => { return <SourceCompletion normal=false breaks=true /> }
            Stmt.Continue(offset: _) => { return <SourceCompletion normal=false /> }
            Stmt.IfChain(val conditions, val thenBlk, val elseBlk) => {
                return self.conditionChainCompletion(conditions: conditions, thenBlk: thenBlk, elseBlk: elseBlk)
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                val condition = self.exprCompletion(exprId: cond)
                if !condition.normal { return condition }
                mut val alternate = <SourceCompletion />
                if hasElse { alternate = self.blockCompletion(blkId: elseBlk) }
                return completionThen(prefix: condition, next: completionChoice(first: self.blockCompletion(blkId: thenBlk), second: alternate))
            }
            Stmt.Match(val scrut, val arms) => {
                val subject = self.exprCompletion(exprId: scrut)
                if !subject.normal { return subject }
                return completionThen(prefix: subject, next: self.armsCompletion(arms: arms))
            }
            Stmt.While(val cond, val body) => {
                val condition = self.exprCompletion(exprId: cond)
                if !condition.normal { return condition }
                val normal = !self.condIsLiteralTrue(id: cond) || self.blockCompletion(blkId: body).breaks
                return completionThen(prefix: condition, next: <SourceCompletion normal=normal />)
            }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, val isRange, inclusive: _, val iter, val rangeHi, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => {
                val iterator = self.exprCompletion(exprId: iter)
                if !isRange { return iterator }
                return completionThen(prefix: iterator, next: self.exprCompletion(exprId: rangeHi))
            }
        }
    }

    inout fn condIsLiteralTrue(id: U64) -> Bool {
        if id >= self.arena.exprs.count() {
            return false
        }
        match self.arena.exprs[id] {
            Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, isNeg: _) => {
                return isBool && value == 1
            }
            _ => { return false }
        }
    }

    inout fn checkFunctionReturns(f: Func) -> Result[(), CompileDiagnostic] {
        // Preserve the existing exemptions: implicit Unit, extern/abstract,
        // async state machines, and the special main entry convention.
        if !f.hasRet || f.isExtern || f.isAsync || f.body == 0U64 || self.nameIsMain(f: f) {
            return <Result.Ok value=() />
        }
        if self.blockCompletesNormally(blkId: f.body) {
            return <Result.Err error=self.diagnosticAt(offset: f.nameStart, msg: "this function has a return type but can reach the end of its body without returning a value; add a `return` (or `panic`) on every path (Plew does not implicitly return the last expression)") />
        }
        return <Result.Ok value=() />
    }

    // The independent generation pipeline retains its existing whole-input
    // structural checks. Ordinary body checking uses the individual entry.
    inout fn checkReturns() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.arena.functionCount() {
            try self.checkFunctionReturns(f: self.arena.functionAt(index: index))
            index += 1U64
        }
        return <Result.Ok value=() />
    }
}
