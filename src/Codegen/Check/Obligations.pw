// Check source-call constraints without registering executable bodies. Open
// substitutions remain declaration obligations; concrete calls propagate them
// through their selected declarations and the same proof-instantiation API.
pub impl Comp {
    inout fn recordDeclarationConversion(exprId: U64, target: U64) -> Result[(), CompileDiagnostic] {
        if !self.cur.recordCallTemplates || target == 0U64 { return <Result.Ok value=() /> }
        val rawSource = self.parametricExprTerm(exprId: exprId)
        // Diverging arms produce no value. Every normal source, including an
        // unresolved one, must retain an obligation until declaration closure.
        if rawSource == 0U64 && !self.exprCompletion(exprId: exprId).source.normal() { return <Result.Ok value=() /> }
        if rawSource != 0U64 && self.typeRefEq(a: rawSource, b: target) { return <Result.Ok value=() /> }
        val source = if rawSource == 0U64 { give 0U64 } else { give try self.normalizedValueType(ref: rawSource) }
        val normalizedTarget = try self.normalizedValueType(ref: target)
        if self.typeRefEq(a: source, b: normalizedTarget) { return <Result.Ok value=() /> }
        val conversion = try self.callArgumentConversion(sourceRef: source, targetRef: normalizedTarget, assumptions: self.functionBoundAssumptions(fnIdx: self.cur.checkFn))
        match conversion {
            ValueConversionProof.Identity => { return <Result.Ok value=() /> }
            _ => {}
        }
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val owner = self.decls.callTemplateLexicalRoots.getOr(key: site.ownerFnIdx, fallback: site.ownerFnIdx)
        mut val indices = self.decls.declarationConversionOwners.getOr(key: owner, fallback: [])
        for index in indices {
            val prior = self.decls.declarationConversions[index]
            if self.sameCallSiteKey(a: prior.site, b: site) && self.typeRefEq(a: prior.source, b: source) && self.typeRefEq(a: prior.target, b: normalizedTarget) { return <Result.Ok value=() /> }
        }
        val proof = self.freezeValueConversionProof(proof: conversion)
        indices.append(self.decls.declarationConversions.count())
        self.decls.declarationConversions.append(<DeclarationConversion site=site source=source target=normalizedTarget proof=proof />)
        self.decls.declarationConversionOwners[owner] = indices
        return <Result.Ok value=() />
    }

    // Validate abstract member shapes without asking for executable bodies.
    // Reboxing Self is a reference to the selected input evidence, not a new
    // dependency request; recursively expanding it would revisit this box.
    inout fn checkAbstractExistentialPlans(evidence: ExistentialBoxEvidence) -> Result[(), CompileDiagnostic] {
        if evidence.traitIdx >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "existential conversion has no selected trait") /> }
        val trait = self.decls.traitAt(index: evidence.traitIdx)
        mut val index = 0U64
        while index < trait.reqs.count() {
            try self.existentialWitnessPlan(evidence: evidence, requirement: index, sourceReceiver: evidence.sourceRef)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkConversionObligations(conversion: ValueConversionProof, environment: InstanceEnvironment, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        mut val completion = <DeclarationObligationState.Complete />
        match conversion {
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: val traitIndex, proof: val proof) => {
                if self.proofIsMissing(proof: proof) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no conformance evidence") /> }
                val receiver = try self.groundTermForBody(ref: source, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                val targetType = try self.groundTermForBody(ref: target, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                if !self.arena.typeIsClosed(ref: receiver) {
                    try self.checkAbstractExistentialPlans(evidence: <ExistentialBoxEvidence sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=proof />)
                    return <Result.Ok value=<DeclarationObligationState.Deferred /> />
                }
                val instantiated = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match instantiated {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => {
                        try self.checkAbstractExistentialPlans(evidence: <ExistentialBoxEvidence sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=proof />)
                        return <Result.Ok value=<DeclarationObligationState.Deferred /> />
                    }
                    StaticProofInstantiation.Ready(proof: val evidence) => {
                        val trait = self.decls.traitAt(index: traitIndex)
                        mut val index = 0U64
                        while index < trait.reqs.count() {
                            match (try self.existentialImplementation(receiver: receiver, target: targetType, traitIndex: traitIndex, requirement: index, proof: evidence)) {
                                Optional.Some(v: val selected) => {
                                    val box = <ExistentialBoxEvidence sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=evidence />
                                    val sourceReceiver = self.canonicalBodyReceiverRef(fnIdx: selected.function, recvInstRef: receiver)
                                    match (try self.existentialWitnessPlan(evidence: box, requirement: index, sourceReceiver: sourceReceiver)) {
                                        Optional.Some(v: val plan) => {
                                            try self.checkExistentialWitnessSignature(plan: plan, implementation: selected, evidence: box)
                                            if (try self.appendCallConstraintInstance(function: selected.function, arguments: selected.arguments, receiver: receiver, proof: evidence, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() { completion = <DeclarationObligationState.Deferred /> }
                                        }
                                        Optional.None => {}
                                    }
                                }
                                Optional.None => {}
                            }
                            index += 1U64
                        }
                    }
                }
            }
            ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => {
                if (try self.checkConversionObligations(conversion: element, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() { completion = <DeclarationObligationState.Deferred /> }
            }
            ValueConversionProof.EnumRepack(sourceRef: _, targetRef: _, enumIdx: _, payloads: val payloads) => {
                for payload in payloads { if (try self.checkConversionObligations(conversion: payload.conversion, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() { completion = <DeclarationObligationState.Deferred /> } }
            }
            ValueConversionProof.Identity => {}
            ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source value does not satisfy the required conversion") /> }
        }
        return <Result.Ok value=completion />
    }

    inout fn callConstraintIsRelevant(function: U64, relevant: Array[Bool]) -> Result[Bool, CompileDiagnostic] {
        if function >= self.arena.functionCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no selected function") /> }
        val owner = try self.semanticBodyOwner(fnIdx: function)
        return <Result.Ok value=owner < relevant.count() && relevant[owner] />
    }

    inout fn appendCallConstraintInstance(function: U64, arguments: Array[U64], receiver: U64, proof: StaticConformanceProof, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        if function >= self.arena.functionCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no selected function") /> }
        // Provided copies can be registered after the relevance snapshot.
        // Their lexical owner, not the new row number, owns body obligations.
        val owner = try self.semanticBodyOwner(fnIdx: function)
        if owner >= relevant.count() || !relevant[owner] { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
        val declaration = self.arena.functionAt(index: function)
        if declaration.isExtern || declaration.body == 0U64 { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
        if arguments.count() != declaration.typeParams.count() { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "declaration obligation has incomplete type arguments") /> }
        mut val deferred = false
        for argument in arguments {
            if argument == 0U64 { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "declaration obligation has an unresolved type argument") /> }
            if !self.arena.typeIsClosed(ref: argument) { deferred = true }
        }
        if deferred { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        if (declaration.hasRecv || declaration.isAssoc) && (receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver)) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        val environment = try self.bodyInstanceEnvironment(fnIdx: function, args: arguments, recvInstRef: receiver, selectedProof: proof)
        mut val previous = heads.getOr(key: owner, fallback: 0U64)
        while previous != 0U64 {
            val prior = requests[previous - 1U64]
            if self.sameInstanceEnvironment(a: prior.environment, b: environment) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
            previous = prior.next
        }
        // Reject unbounded semantic request expansion rather than silently
        // accepting an unchecked recursive substitution. This is an execution
        // resource limit, not a restriction on recursion in the language.
        if depth > 64U64 {
            return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "static call constraint expansion limit exceeded") />
        }
        requests.append(<CallConstraintInstance function=owner environment=environment depth=depth next=heads.getOr(key: owner, fallback: 0U64) />)
        heads[owner] = requests.count()
        return <Result.Ok value=<DeclarationObligationState.Complete /> />
    }

    // A selected method's receiver binders are shared by ordinary static
    // members and operators. Provided-path binders come from its proof; the
    // receiver pattern supplies nominal implementation binders by ParamId.
    inout fn callConstraintTypeArguments(function: Func, receiver: U64, proof: StaticConformanceProof) -> Result[Array[U64], CompileDiagnostic] {
        mut val arguments = self.providedProofArguments(f: function, proof: proof)
        while arguments.count() < function.typeParams.count() { arguments.append(0U64) }
        if function.typeParams.count() == 0U64 { return <Result.Ok value=arguments /> }
        val bindings = try self.methodReceiverEnvironment(f: function, instRef: receiver)
        mut val index = 0U64
        while index < function.typeParams.count() {
            val parameter = self.funcBindAt(binds: function.typeParams, index: index)
            for binding in bindings.binds {
                if (binding.paramId != 0U64 && binding.paramId == parameter.paramId) || (binding.paramId == 0U64 && binding.binder == index) { arguments[index] = binding.term }
            }
            index += 1U64
        }
        return <Result.Ok value=arguments />
    }

    // Requirement method binders are alpha-renamed by conformance checking:
    // implementation binders are [conformance..., method...]. Provided copies
    // instead preserve their source ParamIds. Both consume recorded call args.
    inout fn staticMemberInstanceArguments(resolution: StaticMemberResolution, function: U64, receiver: U64, proof: StaticConformanceProof, methodArguments: Array[U64], environment: InstanceEnvironment) -> Result[Array[U64], CompileDiagnostic] {
        val declaration = self.arena.functionAt(index: function)
        mut val arguments = try self.callConstraintTypeArguments(function: declaration, receiver: receiver, proof: proof)
        mut val values: Array[U64] = []
        for argument in methodArguments { values.append(try self.groundTermForBody(ref: argument, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)) }
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: val index) => {
                val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: owner).reqs, index: index)
                if values.count() != requirement.typeParams.count() || arguments.count() < values.count() { return <Result.Err error=self.diagnosticAt(offset: requirement.nameStart, msg: "static method has incomplete recorded type arguments") /> }
                val start = arguments.count() - values.count()
                mut val index = 0U64
                while index < values.count() { arguments[start + index] = values[index] index += 1U64 }
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val source) => {
                val original = self.arena.functionAt(index: source)
                if values.count() != original.typeParams.count() { return <Result.Err error=self.diagnosticAt(offset: original.nameStart, msg: "static provided method has incomplete recorded type arguments") /> }
                val recorded = <InstanceEnvironment params=self.copyFuncBinds(binds: original.typeParams) args=values />
                val mapped = self.signatureTypeArguments(f: declaration, environment: recorded)
                mut val index = 0U64
                while index < mapped.count() { if mapped[index] != 0U64 { arguments[index] = mapped[index] } index += 1U64 }
            }
            _ => {}
        }
        return <Result.Ok value=arguments />
    }

    inout fn checkStaticMemberObligation(resolution: StaticMemberResolution, methodArguments: Array[U64] = [], receiver: U64, environment: InstanceEnvironment, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        mut val selected = self.arena.functionCount()
        mut val evidence = <StaticConformanceProof.Missing />
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val owner, reqIdx: val requirement) => {
                val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match instantiation {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                    StaticProofInstantiation.Ready(proof: val concrete) => { evidence = concrete }
                }
                selected = try self.proofConcreteWitness(proof: evidence, receiverRef: receiver, traitIdx: owner, reqIdx: requirement)
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: val owner, callee: val declaration) => {
                val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match instantiation {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                    StaticProofInstantiation.Ready(proof: val concrete) => { evidence = concrete }
                }
                selected = try self.providedCopyForDeclaration(declaration: declaration, receiverRef: receiver, proof: evidence, traitIdx: owner, offset: self.arena.functionAt(index: declaration).defOffset)
            }
            StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no selected member") /> }
        }
        if selected >= self.arena.functionCount() {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected trait member has no concrete conformance") />
        }
        val arguments = try self.staticMemberInstanceArguments(resolution: resolution, function: selected, receiver: receiver, proof: evidence, methodArguments: methodArguments, environment: environment)
        return self.appendCallConstraintInstance(function: selected, arguments: arguments, receiver: receiver, proof: evidence, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
    }

    inout fn checkCallConstraintTemplate(template: CallTemplate, environment: InstanceEnvironment, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                if !(try self.callConstraintIsRelevant(function: callee, relevant: relevant)) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, methodTypeArgs: _, resultTerm: _) => {}
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Direct(callee: val callee, proof: _) => {
                        if !(try self.callConstraintIsRelevant(function: callee, relevant: relevant)) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                    }
                    ProtocolSelection.Static(resolution: _) => {}
                    _ => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Primitive => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                    OperatorSelection.Direct(callee: val callee) => {
                        if !(try self.callConstraintIsRelevant(function: callee, relevant: relevant)) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                    }
                    _ => {}
                }
            }
            _ => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
        }
        val receiver = try self.groundTermForBody(ref: template.receiverTypeTerm, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: val typeArguments, proofId: val proofId) => {
                mut val arguments: Array[U64] = []
                for argument in self.callTemplateTypeArgs(range: typeArguments) {
                    arguments.append(try self.groundTermForBody(ref: argument, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64))
                }
                mut val proof = self.thawStaticConformanceProof(id: proofId)
                if receiver != 0U64 && self.arena.typeIsClosed(ref: receiver) && !self.proofIsMissing(proof: proof) {
                    val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                    match instantiation {
                        StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                        StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                        StaticProofInstantiation.Ready(proof: val concrete) => { proof = concrete }
                    }
                }
                return self.appendCallConstraintInstance(function: callee, arguments: arguments, receiver: receiver, proof: proof, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: val typeArgs, resultTerm: _) => {
                return self.checkStaticMemberObligation(resolution: resolution, methodArguments: self.callTemplateTypeArgs(range: typeArgs), receiver: receiver, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
            }
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Static(resolution: val resolution) => {
                        return self.checkStaticMemberObligation(resolution: resolution, receiver: receiver, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    ProtocolSelection.Direct(callee: val callee, proof: val selectedProof) => {
                        if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                        mut val proof = selectedProof
                        if !self.proofIsMissing(proof: proof) {
                            val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                            match instantiation {
                                StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                                StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                                StaticProofInstantiation.Ready(proof: val concrete) => { proof = concrete }
                            }
                        }
                        val arguments = try self.callConstraintTypeArguments(function: self.arena.functionAt(index: callee), receiver: receiver, proof: proof)
                        return self.appendCallConstraintInstance(function: callee, arguments: arguments, receiver: receiver, proof: proof, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    _ => {}
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Static(resolution: val resolution) => {
                        return self.checkStaticMemberObligation(resolution: resolution, receiver: receiver, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    OperatorSelection.Direct(callee: val callee) => {
                        if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                        val declaration = self.arena.functionAt(index: callee)
                        val arguments = try self.callConstraintTypeArguments(function: declaration, receiver: receiver, proof: <StaticConformanceProof.Missing />)
                        return self.appendCallConstraintInstance(function: callee, arguments: arguments, receiver: receiver, proof: <StaticConformanceProof.Missing />, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    OperatorSelection.Primitive => {}
                    OperatorSelection.Pending => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "operator constraint has no completed selection") /> }
                }
            }
            _ => {}
        }
        return <Result.Ok value=<DeclarationObligationState.Complete /> />
    }

    // Compute the backward slice of source calls which can reach a static
    // member requirement. Ordinary helpers without such obligations need no
    // type-environment requests. This is a least fixed point on declarations,
    // independent of concrete substitutions or executable reachability.
    inout fn memberObligationRelevance() -> Result[Array[Bool], CompileDiagnostic] {
        mut val owners: Array[U64] = []
        mut val relevant: Array[Bool] = []
        mut val function = 0U64
        while function < self.arena.functionCount() {
            owners.append(try self.semanticBodyOwner(fnIdx: function))
            relevant.append(false)
            function += 1U64
        }
        for conversion in self.decls.declarationConversions {
            val owner = self.decls.callTemplateLexicalRoots.getOr(key: conversion.site.ownerFnIdx, fallback: conversion.site.ownerFnIdx)
            if owner < relevant.count() { relevant[owner] = true }
        }
        mut val changed = true
        while changed {
            changed = false
            for template in self.decls.callTemplates {
                val owner = self.decls.callTemplateLexicalRoots.getOr(key: template.siteKey.ownerFnIdx, fallback: template.siteKey.ownerFnIdx)
                if owner < relevant.count() && !relevant[owner] {
                    mut val needed = false
                    match template.kind {
                        CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, methodTypeArgs: _, resultTerm: _) => { needed = true }
                        CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                            if callee < owners.count() && owners[callee] < relevant.count() { needed = relevant[owners[callee]] }
                        }
                        CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                            match selection {
                                ProtocolSelection.Static(resolution: _) => { needed = true }
                                ProtocolSelection.Direct(callee: val callee, proof: _) => {
                                    if callee < owners.count() && owners[callee] < relevant.count() { needed = relevant[owners[callee]] }
                                }
                                _ => {}
                            }
                        }
                        CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                            match selection {
                                OperatorSelection.Static(resolution: _) => { needed = true }
                                OperatorSelection.Direct(callee: val callee) => {
                                    if callee < owners.count() && owners[callee] < relevant.count() { needed = relevant[owners[callee]] }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    if needed { relevant[owner] = true
                        changed = true }
                }
            }
        }
        function = 0U64
        while function < owners.count() {
            if owners[function] < relevant.count() { relevant[function] = relevant[owners[function]] }
            function += 1U64
        }
        return <Result.Ok value=relevant />
    }

    inout fn declarationTypeScope(owner: U64) -> Result[DeclarationTypeScope, CompileDiagnostic] {
        val root = self.decls.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        val canonical = try self.semanticBodyOwner(fnIdx: root)
        if canonical >= self.arena.functionCount() {
            return <Result.Ok value=<DeclarationTypeScope owner=canonical parameters=<FuncBindRange start=0U64 len=0U64 /> /> />
        }
        val function = self.arena.functionAt(index: canonical)
        val lexical = try self.lexicalFunction(f: function)
        mut val selfParameter = 0U64
        if lexical.recvTy != 0U64 && lexical.recvTy < self.arena.typeTerms.count() { selfParameter = self.arena.typeTerms[lexical.recvTy].paramId }
        return <Result.Ok value=<DeclarationTypeScope owner=canonical parameters=function.typeParams selfParameter=selfParameter /> />
    }

    // Inspect canonical children, including projection receivers and record
    // fields. A foreign binder is not a legitimate reason to defer a check.
    inout fn declarationTypeDependency(ref: U64, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        if self.arena.typeIsClosed(ref: ref) { return <Result.Ok value=false /> }
        if ref >= self.arena.typeTerms.count() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation has an invalid type term") /> }
        val term = self.arena.typeTerms[ref]
        mut val dependent = false
        if term.paramId != 0U64 {
            dependent = term.paramId == scope.selfParameter
            mut val index = 0U64
            while index < scope.parameters.count() {
                if self.funcBindAt(binds: scope.parameters, index: index).paramId == term.paramId { dependent = true }
                index += 1U64
            }
            if !dependent { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation refers to a type parameter outside its lexical scope") /> }
        }
        mut val index = 0U64
        while index < self.typeTermRefChildCount(ref: ref) {
            if (try self.declarationTypeDependency(ref: self.typeTermRefChildRef(ref: ref, index: index), scope: scope, offset: offset)) { dependent = true }
            index += 1U64
        }
        if !dependent { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "unresolved declaration type has no lexical parameter dependency") /> }
        return <Result.Ok value=true />
    }

    inout fn declarationBoundDependency(bound: TraitBound, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        if bound.subject == 0U64 || bound.constraint.key.owner == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no valid trait bound") /> }
        mut val dependent = try self.declarationTypeDependency(ref: bound.subject, scope: scope, offset: offset)
        for argument in bound.constraint.key.positionalArgs {
            if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true }
        }
        for predicate in bound.constraint.assocPredicates {
            if (try self.declarationTypeDependency(ref: predicate.value, scope: scope, offset: offset)) { dependent = true }
        }
        return <Result.Ok value=dependent />
    }

    inout fn declarationWitnessDependency(witness: WitnessMatch, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        mut val dependent = try self.declarationTypeDependency(ref: witness.selfRef, scope: scope, offset: offset)
        for binding in witness.binds {
            if (try self.declarationTypeDependency(ref: binding.term, scope: scope, offset: offset)) { dependent = true }
        }
        return <Result.Ok value=dependent />
    }

    inout fn declarationProofDependency(proof: StaticConformanceProof, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        mut val dependent = false
        match proof {
            StaticConformanceProof.Missing => {}
            StaticConformanceProof.ConcreteWitness(witness: val witness) => { return self.declarationWitnessDependency(witness: witness, scope: scope, offset: offset) }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: _) => {
                for edge in edges { if (try self.declarationWitnessDependency(witness: edge, scope: scope, offset: offset)) { dependent = true } }
            }
            StaticConformanceProof.AssumedBound(source: val source) => {
                if !self.declarationBoundIsValid(source: source) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no valid trait bound") /> }
                return self.declarationBoundDependency(bound: self.declarationBound(source: source), scope: scope, offset: offset)
            }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => {
                return self.declarationBoundDependency(bound: self.assumedSupertraitBound(source: source, steps: steps), scope: scope, offset: offset)
            }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                dependent = try self.declarationBoundDependency(bound: self.assumedSupertraitBound(source: source, steps: steps), scope: scope, offset: offset)
                for edge in edges { if (try self.declarationWitnessDependency(witness: edge, scope: scope, offset: offset)) { dependent = true } }
            }
            StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: val receiver, traitArgs: val arguments) => {
                dependent = try self.declarationTypeDependency(ref: receiver, scope: scope, offset: offset)
                for argument in arguments { if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true } }
            }
        }
        return <Result.Ok value=dependent />
    }

    inout fn declarationStaticMemberDependency(resolution: StaticMemberResolution, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: _, reqIdx: _) => { return self.declarationProofDependency(proof: proof, scope: scope, offset: offset) }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: _, callee: _) => { return self.declarationProofDependency(proof: proof, scope: scope, offset: offset) }
            StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no selected member") /> }
        }
    }

    inout fn checkDeferredCallDependency(template: CallTemplate) -> Result[(), CompileDiagnostic] {
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        val offset = template.siteKey.originStart
        mut val dependent = try self.declarationTypeDependency(ref: template.receiverTypeTerm, scope: scope, offset: offset)
        match template.kind {
            CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: val arguments, proofId: val proof) => {
                for argument in self.callTemplateTypeArgs(range: arguments) { if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true } }
                if (try self.declarationProofDependency(proof: self.thawStaticConformanceProof(id: proof), scope: scope, offset: offset)) { dependent = true }
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: val arguments, resultTerm: _) => {
                for argument in self.callTemplateTypeArgs(range: arguments) { if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true } }
                if (try self.declarationStaticMemberDependency(resolution: resolution, scope: scope, offset: offset)) { dependent = true }
            }
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Direct(callee: _, proof: val proof) => { if (try self.declarationProofDependency(proof: proof, scope: scope, offset: offset)) { dependent = true } }
                    ProtocolSelection.Static(resolution: val resolution) => { if (try self.declarationStaticMemberDependency(resolution: resolution, scope: scope, offset: offset)) { dependent = true } }
                    _ => {}
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Static(resolution: val resolution) => { if (try self.declarationStaticMemberDependency(resolution: resolution, scope: scope, offset: offset)) { dependent = true } }
                    _ => {}
                }
            }
            _ => {}
        }
        if !dependent { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration call has no lexical parameter dependency") /> }
        return <Result.Ok value=() />
    }

    inout fn declarationConversionDependency(conversion: ValueConversionProof, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        mut val dependent = false
        match conversion {
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: _, proof: val proof) => {
                dependent = try self.declarationTypeDependency(ref: source, scope: scope, offset: offset)
                if (try self.declarationTypeDependency(ref: target, scope: scope, offset: offset)) { dependent = true }
                if (try self.declarationProofDependency(proof: proof, scope: scope, offset: offset)) { dependent = true }
            }
            ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => { return self.declarationConversionDependency(conversion: element, scope: scope, offset: offset) }
            ValueConversionProof.EnumRepack(sourceRef: _, targetRef: _, enumIdx: _, payloads: val payloads) => {
                for payload in payloads { if (try self.declarationConversionDependency(conversion: payload.conversion, scope: scope, offset: offset)) { dependent = true } }
            }
            ValueConversionProof.Identity => {}
            ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration conversion has no evidence") /> }
        }
        return <Result.Ok value=dependent />
    }

    inout fn checkRecordedMemberObligations() -> Result[(), CompileDiagnostic] {
        // Recording precedes ordinary source diagnostics. Keep failed evidence
        // rather than suppressing it or replacing those diagnostics early.
        // No unresolved conversion may survive declaration completion.
        for conversion in self.decls.declarationConversions {
            if conversion.source == 0U64 { return <Result.Err error=self.diagnosticAt(offset: conversion.site.originStart, msg: "source conversion requires a resolved value type") /> }
            match self.thawValueConversionProof(id: conversion.proof) {
                ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: conversion.site.originStart, msg: "source value does not satisfy the required conversion") /> }
                _ => {}
            }
        }

        tracePhase(c: inout self, label: "member-obligations:relevance:start")
        val relevant = try self.memberObligationRelevance()
        tracePhase(c: inout self, label: "member-obligations:roots:start")
        mut val requests: Array[CallConstraintInstance] = []
        mut val heads: Dictionary[U64, U64] = [:]
        val limit = self.decls.callTemplates.count()
        mut val index = 0U64
        mut val deferred = 0U64
        // Every source call is a root, including unused functions. Generic
        // calls become closed when reached through a caller's substitution.
        while index < limit {
            if (try self.checkCallConstraintTemplate(template: self.decls.callTemplates[index], environment: <InstanceEnvironment />, depth: 0U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                try self.checkDeferredCallDependency(template: self.decls.callTemplates[index])
                deferred += 1U64
            }
            index += 1U64
        }
        for conversion in self.decls.declarationConversions {
            if (try self.checkConversionObligations(conversion: self.thawValueConversionProof(id: conversion.proof), environment: <InstanceEnvironment />, depth: 0U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                val scope = try self.declarationTypeScope(owner: conversion.site.ownerFnIdx)
                if !(try self.declarationConversionDependency(conversion: self.thawValueConversionProof(id: conversion.proof), scope: scope, offset: conversion.site.originStart)) {
                    return <Result.Err error=self.diagnosticAt(offset: conversion.site.originStart, msg: "deferred declaration conversion has no lexical parameter dependency") />
                }
                deferred += 1U64
            }
        }
        tracePhaseCount(c: inout self, label: "member-obligations:roots:deferred", count: deferred)
        tracePhase(c: inout self, label: "member-obligations:instances:start")
        index = 0U64
        while index < requests.count() {
            val request = requests[index]
            for conversionIndex in self.decls.declarationConversionOwners.getOr(key: request.function, fallback: []) {
                val conversion = self.decls.declarationConversions[conversionIndex]
                if (try self.checkConversionObligations(conversion: self.thawValueConversionProof(id: conversion.proof), environment: request.environment, depth: request.depth + 1U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                    return <Result.Err error=self.diagnosticAt(offset: conversion.site.originStart, msg: "concrete declaration conversion retains an unresolved obligation") />
                }
            }
            mut val row = self.firstLexicalCallTemplate(owner: request.function)
            while row != 0U64 {
                val template = self.decls.callTemplates[row - 1U64]
                if (try self.checkCallConstraintTemplate(template: template, environment: request.environment, depth: request.depth + 1U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                    return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "concrete declaration call retains an unresolved obligation") />
                }
                row = self.decls.callTemplateBodyNext[row - 1U64]
            }
            index += 1U64
        }
        tracePhaseCount(c: inout self, label: "member-obligations:instances:done", count: requests.count())
        return <Result.Ok value=() />
    }
}
