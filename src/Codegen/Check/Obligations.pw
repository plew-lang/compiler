// Check source-call constraints without registering executable bodies. Open
// substitutions remain declaration obligations; concrete calls propagate them
// through their selected declarations and the same proof-instantiation API.
pub impl Comp {
    inout fn recordDeclarationConversion(exprId: U64, target: U64) -> Result[(), CompileDiagnostic] {
        if !self.cur.recordCallTemplates || target == 0U64 { return <Result.Ok value=() /> }
        val rawSource = self.parametricExprTerm(exprId: exprId)
        // Diverging arms produce no value. Every normal source, including an
        // unresolved one, must retain an obligation until declaration closure.
        if rawSource == 0U64 && !self.exprCompletion(exprId: exprId).source.normal() { return <Result.Ok value=() /> }
        if rawSource != 0U64 && self.typeRefEq(a: rawSource, b: target) { return <Result.Ok value=() /> }
        val source = if rawSource == 0U64 { give 0U64 } else { give try self.normalizedValueType(ref: rawSource) }
        val normalizedTarget = try self.normalizedValueType(ref: target)
        if self.typeRefEq(a: source, b: normalizedTarget) { return <Result.Ok value=() /> }
        val conversion = try self.callArgumentConversion(sourceRef: source, targetRef: normalizedTarget, assumptions: self.functionBoundAssumptions(fnIdx: self.cur.checkFn))
        match conversion {
            ValueConversionProof.Identity => { return <Result.Ok value=() /> }
            _ => {}
        }
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val owner = self.decls.callTemplateLexicalRoots.getOr(key: site.ownerFnIdx, fallback: site.ownerFnIdx)
        mut val indices = self.decls.declarationConversionOwners.getOr(key: owner, fallback: [])
        for index in indices {
            val prior = self.decls.declarationConversions[index]
            if self.sameCallSiteKey(a: prior.site, b: site) && self.typeRefEq(a: prior.source, b: source) && self.typeRefEq(a: prior.target, b: normalizedTarget) {
                self.recordGlobalConversionOwner(index: index)
                return <Result.Ok value=() />
            }
        }
        val proof = self.freezeValueConversionProof(proof: conversion)
        indices.append(self.decls.declarationConversions.count())
        self.decls.declarationConversions.append(<DeclarationConversion site=site source=source target=normalizedTarget proof=proof />)
        self.decls.declarationConversionOwners[owner] = indices
        self.recordGlobalConversionOwner(index: self.decls.declarationConversions.count() - 1U64)
        return <Result.Ok value=() />
    }

    inout fn recordGlobalConversionOwner(index: U64) {
        match self.sourceRecordingOwner() {
            Optional.Some(v: val owner) => {
                match owner {
                    SemanticCompletionOwner.Global(target: val target) => {
                        mut val indices = self.decls.globalDeclarationConversionOwners.getOr(key: target, fallback: [])
                        for prior in indices { if prior == index { return } }
                        indices.append(index)
                        self.decls.globalDeclarationConversionOwners[target] = indices
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }

    // Evidence admission is shared by local owner publication and whole-target
    // closure. Concrete instantiation and member constraints remain separate.
    inout fn checkDeclarationConversionEvidence(conversion: DeclarationConversion) -> Result[(), CompileDiagnostic] {
        val proof = self.thawValueConversionProof(id: conversion.proof)
        try self.checkConversionProofAtBoundary(proof: proof, source: conversion.source, target: conversion.target, offset: conversion.site.originStart)
        val scope = try self.declarationTypeScope(owner: conversion.site.ownerFnIdx)
        try self.declarationConversionDependency(conversion: proof, scope: scope, offset: conversion.site.originStart)
        return <Result.Ok value=() />
    }

    inout fn checkConversionProofAtBoundary(proof: ValueConversionProof, source: U64, target: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if source == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "source conversion requires a resolved value type") /> }
        if source >= self.arena.typeCount() || target == 0U64 || target >= self.arena.typeCount() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "source conversion has an invalid type boundary") />
        }
        try self.checkConversionProofBoundary(proof: proof, source: source, target: target, offset: offset)
        return self.checkConversionProofEvidence(proof: proof, offset: offset)
    }

    // A frozen plan cannot describe another conversion than the source row
    // authorizes. Identity preserves the complete type, including guarantees.
    inout fn checkConversionProofBoundary(proof: ValueConversionProof, source: U64, target: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val boundary = match proof {
            ValueConversionProof.Identity => {
                if !self.typeRefEq(a: source, b: target) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "identity conversion changes the source value type") /> }
                give (source: source, target: target)
            }
            ValueConversionProof.Missing => { return <Result.Ok value=() /> }
            ValueConversionProof.ExistentialRetag(sourceRef: val actualSource, targetRef: val actualTarget) => { give (source: actualSource, target: actualTarget) }
            ValueConversionProof.ExistentialBox(sourceRef: val actualSource, targetRef: val actualTarget, traitIdx: _, proof: _) => { give (source: actualSource, target: actualTarget) }
            ValueConversionProof.ArrayRepack(sourceRef: val actualSource, targetRef: val actualTarget, element: _) => { give (source: actualSource, target: actualTarget) }
            ValueConversionProof.EnumRepack(sourceRef: val actualSource, targetRef: val actualTarget, enumIdx: _, argumentProofs: _, payloads: _) => { give (source: actualSource, target: actualTarget) }
        }
        if !self.typeRefEq(a: source, b: boundary.source) || !self.typeRefEq(a: target, b: boundary.target) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "conversion proof does not match its recorded source and target types") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkConversionProofEvidence(proof: ValueConversionProof, offset: U64) -> Result[(), CompileDiagnostic] {
        match proof {
            ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "source value does not satisfy the required conversion") /> }
            ValueConversionProof.ExistentialRetag(sourceRef: val source, targetRef: val target) => {
                if !self.existentialTypesCompatible(sourceRef: source, targetRef: target) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "existential retag changes its dynamic interface or strengthens a guarantee") />
                }
            }
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: val traitIdx, proof: val evidence) => {
                if self.proofIsMissing(proof: evidence) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation has no conformance evidence") /> }
                if source == 0U64 || source >= self.arena.typeCount() || target == 0U64 || target >= self.arena.typeCount() || traitIdx >= self.decls.traitCount() {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "existential box evidence does not match its target trait instance") />
                }
                val targetType = self.arena.typeAt(index: target)
                if !targetType.isAny || !targetType.hasDecl || self.recordAnyTraitIndex(anyRef: target) != traitIdx {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "existential box evidence does not match its target trait instance") />
                }
                // Interpret the selected proof; never select another conformance
                // to repair a frozen plan, including traits with no members.
                try self.checkStaticProofEvidence(proof: evidence, offset: offset)
                val bound = try self.staticProofBound(proof: evidence, traitIdx: traitIdx)
                val required = self.existentialTraitConstraint(ref: target)
                if bound.subject == 0U64 || bound.constraint.key.owner != required.key.owner || !self.sameResolvedTypeRefs(a: bound.constraint.key.positionalArgs, b: required.key.positionalArgs) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "existential box evidence does not match its target trait instance") />
                }
                if !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: bound.subject), b: self.typeRefWithoutOuterViews(ref: source)) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "existential box evidence does not match its source value type") />
                }
                if !(try self.selectedProofAssociatedTypesMatch(proof: evidence, traitOwner: required.key.owner, names: self.traitAssocArgNames(t: targetType), values: self.traitAssocArgValues(t: targetType))) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "existential box evidence does not satisfy its target associated types") />
                }
            }
            ValueConversionProof.ArrayRepack(sourceRef: val source, targetRef: val target, element: val element) => {
                val boundary = try self.arrayConversionElementBoundary(sourceRef: source, targetRef: target, offset: offset)
                try self.checkConversionProofAtBoundary(proof: element, source: boundary.sourceRef, target: boundary.targetRef, offset: offset)
            }
            ValueConversionProof.EnumRepack(sourceRef: val source, targetRef: val target, enumIdx: val enumIndex, argumentProofs: val arguments, payloads: val payloads) => {
                val boundaries = try self.enumRepackPayloadBoundaries(sourceRef: source, targetRef: target, enumIdx: enumIndex)
                val sourceType = self.arena.typeAt(index: source)
                val targetType = self.arena.typeAt(index: target)
                if arguments.count() != sourceType.args.count() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "enum conversion type argument plan is incomplete") /> }
                mut val index = 0U64
                while index < arguments.count() {
                    try self.checkConversionProofAtBoundary(proof: arguments[index], source: sourceType.args[index], target: targetType.args[index], offset: offset)
                    index += 1U64
                }
                if payloads.count() != boundaries.count() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "enum conversion payload plan is incomplete") /> }
                index = 0U64
                while index < payloads.count() {
                    val payload = payloads[index]
                    val boundary = boundaries[index]
                    if !self.typeRefEq(a: payload.sourceRef, b: boundary.sourceRef) || !self.typeRefEq(a: payload.targetRef, b: boundary.targetRef) {
                        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "enum conversion payload does not match its declaration field") />
                    }
                    try self.checkConversionProofAtBoundary(proof: payload.conversion, source: boundary.sourceRef, target: boundary.targetRef, offset: offset)
                    index += 1U64
                }
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    inout fn checkStaticProofEvidence(proof: StaticConformanceProof, offset: U64) -> Result[(), CompileDiagnostic] {
        match proof {
            StaticConformanceProof.TraitSelf(traitIdx: val owner, receiverRef: val receiver, traitArgs: val arguments) => {
                // This proof denotes the selected interface's own lexical Self,
                // not an arbitrary in-scope type parameter claiming that trait.
                // Source authority remains a separate scope admission below.
                if owner >= self.decls.traitCount() || receiver == 0U64 || receiver >= self.arena.typeCount() {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected trait Self evidence has an invalid interface") />
                }
                val trait = self.decls.traitAt(index: owner)
                if arguments.count() != trait.typeParams.count() || !self.typeRefEq(a: receiver, b: (try self.existentialSelfTerm(traitIndex: owner))) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected trait Self evidence does not match its interface Self") />
                }
            }
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                if !(try self.selectedNominalWitnessSubjectMatches(witness: witness)) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not match its declaration subject") /> }
                try self.checkWitnessConditionEvidence(witness: witness, offset: offset)
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: val terminal) => {
                if edges.count() == 0U64 || edges[edges.count() - 1U64].conformIdx != terminal { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path has an invalid terminal") /> }
                try self.checkStaticPathEvidence(edges: edges, root: self.missingTraitBound(), offset: offset)
            }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                val root = self.assumedSupertraitBound(source: source, steps: steps)
                if root.subject == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path has an invalid assumption root") /> }
                try self.checkStaticPathEvidence(edges: edges, root: root, offset: offset)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // Interpret the recorded predecessor chain, including its nominal or
    // authored-bound root. Intermediate projection is a separate reader.
    inout fn checkStaticPathEvidence(edges: Array[WitnessMatch], root: TraitBound, offset: U64) -> Result[(), CompileDiagnostic] {
        if edges.count() == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path has no edges") /> }
        mut val previous = root
        mut val index = 0U64
        for witness in edges {
            if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path has an invalid edge") /> }
            val declaration = self.decls.conformAt(index: witness.conformIdx - 1U64)
            if index == 0U64 && previous.subject == 0U64 {
                if !(try self.selectedNominalWitnessSubjectMatches(witness: witness)) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not match its declaration subject") /> }
            } else {
                if declaration.subjectTraitOwner == 0U64 || declaration.subjectTraitOwner != previous.constraint.key.owner || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: witness.selfRef), b: self.typeRefWithoutOuterViews(ref: previous.subject)) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path does not match its predecessor") /> }
                mut val arguments: Array[U64] = []
                mut val argument = 0U64
                while argument < declaration.subjectArgs.count() {
                    arguments.append((try self.groundWitnessTypeTerm(ref: self.conformTypeAt(types: declaration.subjectArgs, index: argument), params: <PatternBindInput.Conformance range=declaration.typeParams />, matchResult: witness)))
                    argument += 1U64
                }
                if !self.sameResolvedTypeRefs(a: arguments, b: previous.constraint.key.positionalArgs) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path does not match its predecessor") /> }
            }
            try self.checkWitnessConditionEvidence(witness: witness, offset: offset)
            previous = try self.staticProofBound(proof: <StaticConformanceProof.ConcreteWitness witness=witness />, traitIdx: self.decls.traitIndexByOffset(offset: declaration.traitStart))
            if previous.subject == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance path has an invalid edge output") /> }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkWitnessConditionEvidence(witness: WitnessMatch, offset: U64) -> Result[(), CompileDiagnostic] {
        if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
        val declaration = self.decls.conformAt(index: witness.conformIdx - 1U64)
        if declaration.bounds.len == 0U64 && witness.conditions == 0U64 { return <Result.Ok value=() /> }
        if witness.conditions == 0U64 || witness.conditions > self.arena.witnessConditionPlans.count() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
        val plan = self.arena.witnessConditionPlans[witness.conditions - 1U64]
        if !self.sameWitnessSubstitution(a: plan.witness, b: witness) || plan.proofs.count() != declaration.bounds.len { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
        for active in self.activeConditionAdmission {
            if active == witness.conditions { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance condition evidence is cyclic") /> }
        }
        self.activeConditionAdmission.append(witness.conditions)
        val result = self.checkWitnessConditionChildren(witness: witness, proofs: plan.proofs, normalizations: plan.normalizations, offset: offset)
        self.activeConditionAdmission.removeLast()
        return result
    }

    inout fn checkProjectionNormalizations(normalizations: Array[ProjectionNormalizationStep], offset: U64) -> Result[(), CompileDiagnostic] {
        for step in normalizations {
            if step.source == 0U64 || step.source >= self.arena.typeCount() || step.output >= self.arena.typeCount() {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected condition has invalid projection evidence") />
            }
            val projection = self.arena.typeAt(index: step.source)
            if projection.assocNameId == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected condition has invalid projection evidence") /> }
            val owner = if projection.assocTraitDeclOffset != 0U64 { give projection.assocTraitDeclOffset } else { give projection.assocTraitStart }
            val proof = self.thawStaticConformanceProof(id: step.proof)
            try self.checkStaticProofEvidence(proof: proof, offset: offset)
            val bound = try self.staticProofBound(proof: proof, traitIdx: self.decls.traitIndexByOffset(offset: owner))
            val receiver = self.typeTermProjectionReceiver(t: projection)
            if bound.subject == 0U64 || bound.constraint.key.owner != owner || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: receiver), b: self.typeRefWithoutOuterViews(ref: bound.subject)) || !self.sameResolvedTypeRefs(a: projection.assocTraitArgs, b: bound.constraint.key.positionalArgs) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected condition projection evidence has a different receiver or trait") />
            }
            val output = try self.associatedOutputInProof(proof: proof, traitOwner: owner, assocId: projection.assocNameId)
            val comparable = if output == 0U64 || self.typeRefEq(a: output, b: step.source) { give 0U64 } else { give output }
            if !self.typeRefEq(a: comparable, b: step.output) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected condition projection evidence has a different output") /> }
        }
        return <Result.Ok value=() />
    }

    // Replay only the saved equations. No conformance/member query is allowed.
    inout fn replayProjectionNormalizations(ref: U64, normalizations: Array[ProjectionNormalizationStep], offset: U64, active: Array[U64] = []) -> Result[U64, CompileDiagnostic] {
        if normalizations.count() == 0U64 || !self.arena.typeContainsAssociatedProjection(ref: ref) { return <Result.Ok value=ref /> }
        if ref == 0U64 || ref >= self.arena.typeCount() { return <Result.Ok value=ref /> }
        val type = self.arena.typeAt(index: ref)
        if type.isRecord {
            mut val fields: Array[U64] = []
            mut val changed = false
            for field in type.recordFieldTerms {
                val normalized = try self.replayProjectionNormalizations(ref: field, normalizations: normalizations, offset: offset, active: active)
                if normalized != field { changed = true }
                fields.append(normalized)
            }
            if changed { return <Result.Ok value=self.rebuildRecordTypeTerm(t: type, fieldTerms: fields) /> }
            return <Result.Ok value=ref />
        }
        mut val arguments: Array[U64] = []
        mut val traitArguments: Array[U64] = []
        mut val changed = false
        if type.assocNameId == 0U64 {
            for argument in type.args {
                val normalized = try self.replayProjectionNormalizations(ref: argument, normalizations: normalizations, offset: offset, active: active)
                if normalized != argument { changed = true }
                arguments.append(normalized)
            }
        }
        for argument in type.assocTraitArgs {
            val normalized = try self.replayProjectionNormalizations(ref: argument, normalizations: normalizations, offset: offset, active: active)
            if normalized != argument { changed = true }
            traitArguments.append(normalized)
        }
        if type.assocNameId == 0U64 {
            if changed { return <Result.Ok value=self.rebuildTypeTerm(t: type, args: arguments, assocTraitArgs: traitArguments) /> }
            return <Result.Ok value=ref />
        }
        val rawReceiver = self.typeTermProjectionReceiver(t: type)
        val receiver = try self.replayProjectionNormalizations(ref: rawReceiver, normalizations: normalizations, offset: offset, active: active)
        val projection = if changed || receiver != rawReceiver { give self.rebuildProjectionTerm(t: type, receiver: receiver, traitArgs: traitArguments) } else { give ref }
        for step in normalizations {
            if self.typeRefEq(a: projection, b: step.source) {
                if step.output == 0U64 { return <Result.Ok value=projection /> }
                for previous in active {
                    if self.typeRefEq(a: previous, b: projection) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected condition projection evidence is cyclic") /> }
                }
                mut val next = active
                next.append(projection)
                return self.replayProjectionNormalizations(ref: step.output, normalizations: normalizations, offset: offset, active: next)
            }
        }
        return <Result.Ok value=projection />
    }

    inout fn replayConstraintNormalizations(constraint: TraitConstraint, normalizations: Array[ProjectionNormalizationStep], offset: U64) -> Result[TraitConstraint, CompileDiagnostic] {
        if normalizations.count() == 0U64 { return <Result.Ok value=constraint /> }
        mut val arguments: Array[U64] = []
        for argument in constraint.key.positionalArgs { arguments.append(try self.replayProjectionNormalizations(ref: argument, normalizations: normalizations, offset: offset)) }
        mut val predicates: Array[TraitAssocPredicate] = []
        for predicate in constraint.assocPredicates { predicates.append(<TraitAssocPredicate member=predicate.member value=(try self.replayProjectionNormalizations(ref: predicate.value, normalizations: normalizations, offset: offset)) span=predicate.span />) }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates /> />
    }

    inout fn checkWitnessConditionChildren(witness: WitnessMatch, proofs: Array[U64], normalizations: Array[ProjectionNormalizationStep], offset: U64) -> Result[(), CompileDiagnostic] {
        try self.checkProjectionNormalizations(normalizations: normalizations, offset: offset)
        val declaration = self.decls.conformAt(index: witness.conformIdx - 1U64)
        val parameters = self.copyConformBinds(binds: declaration.typeParams)
        mut val index = 0U64
        while index < proofs.count() {
            val clause = self.conformBoundAt(bounds: declaration.bounds, index: index)
            val rawSubject = try self.groundWitnessTypeTerm(ref: clause.subject, params: <PatternBindInput.Conformance range=declaration.typeParams />, matchResult: witness)
            val subject = try self.replayProjectionNormalizations(ref: rawSubject, normalizations: normalizations, offset: offset)
            val rawConstraint = try self.groundTraitConstraintThroughWitness(constraint: clause.constraint, params: parameters, matchResult: witness)
            val constraint = try self.replayConstraintNormalizations(constraint: rawConstraint, normalizations: normalizations, offset: offset)
            val traitIndex = self.decls.traitIndexByOffset(offset: constraint.key.owner)
            val proof = self.thawStaticConformanceProof(id: proofs[index])
            try self.checkStaticProofEvidence(proof: proof, offset: offset)
            val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
            val proofSubject = try self.replayProjectionNormalizations(ref: bound.subject, normalizations: normalizations, offset: offset)
            val proofConstraint = try self.replayConstraintNormalizations(constraint: bound.constraint, normalizations: normalizations, offset: offset)
            if bound.subject == 0U64 || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: subject), b: self.typeRefWithoutOuterViews(ref: proofSubject)) || bound.constraint.key.owner != constraint.key.owner || (!constraint.positionalArgsOpen && !self.sameResolvedTypeRefs(a: proofConstraint.key.positionalArgs, b: constraint.key.positionalArgs)) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
            mut val names: Array[U64] = []
            mut val values: Array[U64] = []
            for predicate in constraint.assocPredicates { names.append(predicate.member) values.append(predicate.value) }
            if !(try self.selectedProofAssociatedTypesMatch(proof: proof, traitOwner: constraint.key.owner, names: names, values: values)) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn arrayConversionElementBoundary(sourceRef: U64, targetRef: U64, offset: U64) -> Result[ValueConversionBoundary, CompileDiagnostic] {
        if !self.isLangArrayType(ref: sourceRef) || !self.isLangArrayType(ref: targetRef) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "array conversion has an invalid declaration boundary") />
        }
        return <Result.Ok value=<ValueConversionBoundary sourceRef=self.arena.typeAt(index: sourceRef).args[0U64] targetRef=self.arena.typeAt(index: targetRef).args[0U64] /> />
    }

    inout fn checkSourceConversionEvidence(owner: SemanticCompletionOwner) -> Result[(), CompileDiagnostic] {
        val indices = match owner {
            SemanticCompletionOwner.Function(index: val function) => { give self.decls.declarationConversionOwners.getOr(key: function, fallback: []) }
            SemanticCompletionOwner.Global(target: val target) => { give self.decls.globalDeclarationConversionOwners.getOr(key: target, fallback: []) }
        }
        for index in indices { try self.checkDeclarationConversionEvidence(conversion: self.decls.declarationConversions[index]) }
        return <Result.Ok value=() />
    }

    // Validate abstract member shapes without asking for executable bodies.
    // Reboxing Self is a reference to the selected input evidence, not a new
    // dependency request; recursively expanding it would revisit this box.
    inout fn checkAbstractExistentialPlans(evidence: ExistentialBoxEvidence) -> Result[(), CompileDiagnostic] {
        if evidence.traitIdx >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "existential conversion has no selected trait") /> }
        val trait = self.decls.traitAt(index: evidence.traitIdx)
        mut val index = 0U64
        while index < trait.reqs.count() {
            try self.existentialWitnessPlan(evidence: evidence, requirement: index, sourceReceiver: evidence.sourceRef)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    // A phantom argument changes static type, but produces no dynamic value.
    // Interpret the same proof instantiation and admission contracts while
    // avoiding executable witness plans and body requests for absent payloads.
    inout fn checkSemanticConversionObligations(conversion: ValueConversionProof, environment: InstanceEnvironment) -> Result[DeclarationObligationState, CompileDiagnostic] {
        mut val completion = <DeclarationObligationState.Complete />
        match conversion {
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: val traitIndex, proof: val proof) => {
                val receiver = try self.groundTermForBody(ref: source, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                val targetType = try self.groundTermForBody(ref: target, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match (try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)) {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => { completion = <DeclarationObligationState.Deferred /> }
                    StaticProofInstantiation.Ready(proof: val evidence) => { try self.checkConversionProofEvidence(proof: <ValueConversionProof.ExistentialBox sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=evidence />, offset: 0U64) }
                }
            }
            ValueConversionProof.ExistentialRetag(sourceRef: val source, targetRef: val target) => {
                val sourceType = try self.groundTermForBody(ref: source, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                val targetType = try self.groundTermForBody(ref: target, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                try self.checkConversionProofEvidence(proof: <ValueConversionProof.ExistentialRetag sourceRef=sourceType targetRef=targetType />, offset: 0U64)
            }
            ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => { return self.checkSemanticConversionObligations(conversion: element, environment: environment) }
            ValueConversionProof.EnumRepack(sourceRef: _, targetRef: _, enumIdx: _, argumentProofs: val arguments, payloads: val payloads) => {
                for argument in arguments { if (try self.checkSemanticConversionObligations(conversion: argument, environment: environment)).isDeferred() { completion = <DeclarationObligationState.Deferred /> } }
                for payload in payloads { if (try self.checkSemanticConversionObligations(conversion: payload.conversion, environment: environment)).isDeferred() { completion = <DeclarationObligationState.Deferred /> } }
            }
            ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source value does not satisfy the required conversion") /> }
            ValueConversionProof.Identity => {}
        }
        return <Result.Ok value=completion />
    }

    inout fn checkConversionObligations(conversion: ValueConversionProof, environment: InstanceEnvironment, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        mut val completion = <DeclarationObligationState.Complete />
        match conversion {
            ValueConversionProof.ExistentialRetag(sourceRef: val source, targetRef: val target) => {
                val sourceRef = try self.groundTermForBody(ref: source, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                val targetRef = try self.groundTermForBody(ref: target, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                if !self.existentialTypesCompatible(sourceRef: sourceRef, targetRef: targetRef) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "existential retag changes its dynamic interface or strengthens a guarantee") /> }
                if !self.arena.typeIsClosed(ref: sourceRef) || !self.arena.typeIsClosed(ref: targetRef) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
            }
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: val traitIndex, proof: val proof) => {
                if self.proofIsMissing(proof: proof) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no conformance evidence") /> }
                val receiver = try self.groundTermForBody(ref: source, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                val targetType = try self.groundTermForBody(ref: target, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                if !self.arena.typeIsClosed(ref: receiver) {
                    try self.checkAbstractExistentialPlans(evidence: <ExistentialBoxEvidence sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=proof />)
                    return <Result.Ok value=<DeclarationObligationState.Deferred /> />
                }
                val instantiated = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match instantiated {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => {
                        try self.checkAbstractExistentialPlans(evidence: <ExistentialBoxEvidence sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=proof />)
                        return <Result.Ok value=<DeclarationObligationState.Deferred /> />
                    }
                    StaticProofInstantiation.Ready(proof: val evidence) => {
                        val trait = self.decls.traitAt(index: traitIndex)
                        mut val index = 0U64
                        while index < trait.reqs.count() {
                            match (try self.existentialImplementation(receiver: receiver, target: targetType, traitIndex: traitIndex, requirement: index, proof: evidence)) {
                                Optional.Some(v: val selected) => {
                                    val box = <ExistentialBoxEvidence sourceRef=receiver targetRef=targetType traitIdx=traitIndex proof=evidence />
                                    val sourceReceiver = self.canonicalBodyReceiverRef(fnIdx: selected.function, recvInstRef: receiver)
                                    match (try self.existentialWitnessPlan(evidence: box, requirement: index, sourceReceiver: sourceReceiver)) {
                                        Optional.Some(v: val plan) => {
                                            try self.checkExistentialWitnessSignature(plan: plan, implementation: selected, evidence: box)
                                            if (try self.appendCallConstraintInstance(function: selected.function, arguments: selected.arguments, receiver: receiver, proof: evidence, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() { completion = <DeclarationObligationState.Deferred /> }
                                        }
                                        Optional.None => {}
                                    }
                                }
                                Optional.None => {}
                            }
                            index += 1U64
                        }
                    }
                }
            }
            ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => {
                if (try self.checkConversionObligations(conversion: element, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() { completion = <DeclarationObligationState.Deferred /> }
            }
            ValueConversionProof.EnumRepack(sourceRef: _, targetRef: _, enumIdx: _, argumentProofs: val arguments, payloads: val payloads) => {
                for argument in arguments { if (try self.checkSemanticConversionObligations(conversion: argument, environment: environment)).isDeferred() { completion = <DeclarationObligationState.Deferred /> } }
                for payload in payloads { if (try self.checkConversionObligations(conversion: payload.conversion, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() { completion = <DeclarationObligationState.Deferred /> } }
            }
            ValueConversionProof.Identity => {}
            ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "source value does not satisfy the required conversion") /> }
        }
        return <Result.Ok value=completion />
    }

    inout fn callConstraintIsRelevant(function: U64, relevant: Array[Bool]) -> Result[Bool, CompileDiagnostic] {
        if function >= self.arena.functionCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no selected function") /> }
        val owner = try self.semanticBodyOwner(fnIdx: function)
        return <Result.Ok value=owner < relevant.count() && relevant[owner] />
    }

    inout fn appendCallConstraintInstance(function: U64, arguments: Array[U64], receiver: U64, proof: StaticConformanceProof, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        if function >= self.arena.functionCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no selected function") /> }
        // Provided copies can be registered after the relevance snapshot.
        // Their lexical owner, not the new row number, owns body obligations.
        val owner = try self.semanticBodyOwner(fnIdx: function)
        if owner >= relevant.count() || !relevant[owner] { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
        val declaration = self.arena.functionAt(index: function)
        if declaration.isExtern || declaration.body == 0U64 { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
        if arguments.count() != declaration.typeParams.count() { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "declaration obligation has incomplete type arguments") /> }
        mut val deferred = false
        for argument in arguments {
            if argument == 0U64 { return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "declaration obligation has an unresolved type argument") /> }
            if !self.arena.typeIsClosed(ref: argument) { deferred = true }
        }
        if deferred { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        if (declaration.hasRecv || declaration.isAssoc) && (receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver)) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        val environment = try self.bodyInstanceEnvironment(fnIdx: function, args: arguments, recvInstRef: receiver, selectedProof: proof)
        mut val previous = heads.getOr(key: owner, fallback: 0U64)
        while previous != 0U64 {
            val prior = requests[previous - 1U64]
            if self.sameInstanceEnvironment(a: prior.environment, b: environment) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
            previous = prior.next
        }
        // Reject unbounded semantic request expansion rather than silently
        // accepting an unchecked recursive substitution. This is an execution
        // resource limit, not a restriction on recursion in the language.
        if depth > 64U64 {
            return <Result.Err error=self.diagnosticAt(offset: declaration.defOffset, msg: "static call constraint expansion limit exceeded") />
        }
        requests.append(<CallConstraintInstance function=owner environment=environment depth=depth next=heads.getOr(key: owner, fallback: 0U64) />)
        heads[owner] = requests.count()
        return <Result.Ok value=<DeclarationObligationState.Complete /> />
    }

    // A selected method's receiver binders are shared by ordinary static
    // members and operators. Provided-path binders come from its proof; the
    // receiver pattern supplies nominal implementation binders by ParamId.
    inout fn callConstraintTypeArguments(function: Func, receiver: U64, proof: StaticConformanceProof) -> Result[Array[U64], CompileDiagnostic] {
        mut val arguments = self.providedProofArguments(f: function, proof: proof)
        while arguments.count() < function.typeParams.count() { arguments.append(0U64) }
        if function.typeParams.count() == 0U64 { return <Result.Ok value=arguments /> }
        val bindings = try self.methodReceiverEnvironment(f: function, instRef: receiver)
        mut val index = 0U64
        while index < function.typeParams.count() {
            val parameter = self.funcBindAt(binds: function.typeParams, index: index)
            for binding in bindings.binds {
                if (binding.paramId != 0U64 && binding.paramId == parameter.paramId) || (binding.paramId == 0U64 && binding.binder == index) { arguments[index] = binding.term }
            }
            index += 1U64
        }
        return <Result.Ok value=arguments />
    }

    // Requirement method binders are alpha-renamed by conformance checking:
    // implementation binders are [conformance..., method...]. Provided copies
    // instead preserve their source ParamIds. Both consume recorded call args.
    inout fn staticMemberInstanceArguments(resolution: StaticMemberResolution, function: U64, receiver: U64, proof: StaticConformanceProof, methodArguments: Array[U64], environment: InstanceEnvironment) -> Result[Array[U64], CompileDiagnostic] {
        val declaration = self.arena.functionAt(index: function)
        mut val arguments = try self.callConstraintTypeArguments(function: declaration, receiver: receiver, proof: proof)
        mut val values: Array[U64] = []
        for argument in methodArguments { values.append(try self.groundTermForBody(ref: argument, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)) }
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: val index) => {
                val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: owner).reqs, index: index)
                if values.count() != requirement.typeParams.count() || arguments.count() < values.count() { return <Result.Err error=self.diagnosticAt(offset: requirement.nameStart, msg: "static method has incomplete recorded type arguments") /> }
                val start = arguments.count() - values.count()
                mut val index = 0U64
                while index < values.count() { arguments[start + index] = values[index] index += 1U64 }
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val source) => {
                val original = self.arena.functionAt(index: source)
                if values.count() != original.typeParams.count() { return <Result.Err error=self.diagnosticAt(offset: original.nameStart, msg: "static provided method has incomplete recorded type arguments") /> }
                val recorded = <InstanceEnvironment params=self.copyFuncBinds(binds: original.typeParams) args=values />
                val mapped = self.signatureTypeArguments(f: declaration, environment: recorded)
                mut val index = 0U64
                while index < mapped.count() { if mapped[index] != 0U64 { arguments[index] = mapped[index] } index += 1U64 }
            }
            _ => {}
        }
        return <Result.Ok value=arguments />
    }

    inout fn checkStaticMemberObligation(resolution: StaticMemberResolution, methodArguments: Array[U64] = [], receiver: U64, environment: InstanceEnvironment, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        mut val selected = self.arena.functionCount()
        mut val evidence = <StaticConformanceProof.Missing />
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val owner, reqIdx: val requirement) => {
                val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match instantiation {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                    StaticProofInstantiation.Ready(proof: val concrete) => { evidence = concrete }
                }
                selected = try self.proofConcreteWitness(proof: evidence, receiverRef: receiver, traitIdx: owner, reqIdx: requirement)
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: val owner, callee: val declaration) => {
                val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                match instantiation {
                    StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                    StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                    StaticProofInstantiation.Ready(proof: val concrete) => { evidence = concrete }
                }
                selected = try self.providedCopyForDeclaration(declaration: declaration, receiverRef: receiver, proof: evidence, traitIdx: owner, offset: self.arena.functionAt(index: declaration).defOffset)
            }
            StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no selected member") /> }
        }
        if selected >= self.arena.functionCount() {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected trait member has no concrete conformance") />
        }
        val arguments = try self.staticMemberInstanceArguments(resolution: resolution, function: selected, receiver: receiver, proof: evidence, methodArguments: methodArguments, environment: environment)
        return self.appendCallConstraintInstance(function: selected, arguments: arguments, receiver: receiver, proof: evidence, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
    }

    inout fn checkCallConstraintTemplate(template: CallTemplate, environment: InstanceEnvironment, depth: U64, requests: inout Array[CallConstraintInstance], heads: inout Dictionary[U64, U64], relevant: Array[Bool]) -> Result[DeclarationObligationState, CompileDiagnostic] {
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                if !(try self.callConstraintIsRelevant(function: callee, relevant: relevant)) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, methodTypeArgs: _, resultTerm: _) => {}
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Direct(callee: val callee, proof: _) => {
                        if !(try self.callConstraintIsRelevant(function: callee, relevant: relevant)) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                    }
                    ProtocolSelection.Static(resolution: _) => {}
                    _ => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Primitive => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                    OperatorSelection.Direct(callee: val callee) => {
                        if !(try self.callConstraintIsRelevant(function: callee, relevant: relevant)) { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
                    }
                    _ => {}
                }
            }
            _ => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
        }
        val receiver = try self.groundTermForBody(ref: template.receiverTypeTerm, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: val typeArguments, proofId: val proofId) => {
                mut val arguments: Array[U64] = []
                for argument in self.callTemplateTypeArgs(range: typeArguments) {
                    arguments.append(try self.groundTermForBody(ref: argument, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64))
                }
                mut val proof = self.thawStaticConformanceProof(id: proofId)
                if receiver != 0U64 && self.arena.typeIsClosed(ref: receiver) && !self.proofIsMissing(proof: proof) {
                    val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                    match instantiation {
                        StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                        StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                        StaticProofInstantiation.Ready(proof: val concrete) => { proof = concrete }
                    }
                }
                return self.appendCallConstraintInstance(function: callee, arguments: arguments, receiver: receiver, proof: proof, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: val typeArgs, resultTerm: _) => {
                return self.checkStaticMemberObligation(resolution: resolution, methodArguments: self.callTemplateTypeArgs(range: typeArgs), receiver: receiver, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
            }
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Static(resolution: val resolution) => {
                        return self.checkStaticMemberObligation(resolution: resolution, receiver: receiver, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    ProtocolSelection.Direct(callee: val callee, proof: val selectedProof) => {
                        if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                        mut val proof = selectedProof
                        if !self.proofIsMissing(proof: proof) {
                            val instantiation = try self.instantiateStaticMemberProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
                            match instantiation {
                                StaticProofInstantiation.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "declaration obligation has no concrete conformance evidence") /> }
                                StaticProofInstantiation.Deferred => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                                StaticProofInstantiation.Ready(proof: val concrete) => { proof = concrete }
                            }
                        }
                        val arguments = try self.callConstraintTypeArguments(function: self.arena.functionAt(index: callee), receiver: receiver, proof: proof)
                        return self.appendCallConstraintInstance(function: callee, arguments: arguments, receiver: receiver, proof: proof, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    _ => {}
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Static(resolution: val resolution) => {
                        return self.checkStaticMemberObligation(resolution: resolution, receiver: receiver, environment: environment, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    OperatorSelection.Direct(callee: val callee) => {
                        if receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
                        val declaration = self.arena.functionAt(index: callee)
                        val arguments = try self.callConstraintTypeArguments(function: declaration, receiver: receiver, proof: <StaticConformanceProof.Missing />)
                        return self.appendCallConstraintInstance(function: callee, arguments: arguments, receiver: receiver, proof: <StaticConformanceProof.Missing />, depth: depth, requests: inout requests, heads: inout heads, relevant: relevant)
                    }
                    OperatorSelection.Primitive => {}
                    OperatorSelection.Pending => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "operator constraint has no completed selection") /> }
                }
            }
            _ => {}
        }
        return <Result.Ok value=<DeclarationObligationState.Complete /> />
    }

    // Compute the backward slice of source calls which can reach a static
    // member requirement. Ordinary helpers without such obligations need no
    // type-environment requests. This is a least fixed point on declarations,
    // independent of concrete substitutions or executable reachability.
    inout fn memberObligationRelevance() -> Result[Array[Bool], CompileDiagnostic] {
        mut val owners: Array[U64] = []
        mut val relevant: Array[Bool] = []
        mut val function = 0U64
        while function < self.arena.functionCount() {
            owners.append(try self.semanticBodyOwner(fnIdx: function))
            relevant.append(false)
            function += 1U64
        }
        for conversion in self.decls.declarationConversions {
            val owner = self.decls.callTemplateLexicalRoots.getOr(key: conversion.site.ownerFnIdx, fallback: conversion.site.ownerFnIdx)
            if owner < relevant.count() { relevant[owner] = true }
        }
        mut val changed = true
        while changed {
            changed = false
            for template in self.decls.callTemplates {
                val owner = self.decls.callTemplateLexicalRoots.getOr(key: template.siteKey.ownerFnIdx, fallback: template.siteKey.ownerFnIdx)
                if owner < relevant.count() && !relevant[owner] {
                    mut val needed = false
                    match template.kind {
                        CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, methodTypeArgs: _, resultTerm: _) => { needed = true }
                        CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                            if callee < owners.count() && owners[callee] < relevant.count() { needed = relevant[owners[callee]] }
                        }
                        CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                            match selection {
                                ProtocolSelection.Static(resolution: _) => { needed = true }
                                ProtocolSelection.Direct(callee: val callee, proof: _) => {
                                    if callee < owners.count() && owners[callee] < relevant.count() { needed = relevant[owners[callee]] }
                                }
                                _ => {}
                            }
                        }
                        CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                            match selection {
                                OperatorSelection.Static(resolution: _) => { needed = true }
                                OperatorSelection.Direct(callee: val callee) => {
                                    if callee < owners.count() && owners[callee] < relevant.count() { needed = relevant[owners[callee]] }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    if needed { relevant[owner] = true
                        changed = true }
                }
            }
        }
        function = 0U64
        while function < owners.count() {
            if owners[function] < relevant.count() { relevant[function] = relevant[owners[function]] }
            function += 1U64
        }
        return <Result.Ok value=relevant />
    }

    inout fn declarationTypeScope(owner: U64) -> Result[DeclarationTypeScope, CompileDiagnostic] {
        val root = self.decls.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        val canonical = try self.semanticBodyOwner(fnIdx: root)
        if canonical >= self.arena.functionCount() {
            return <Result.Ok value=<DeclarationTypeScope owner=canonical parameters=<FuncBindRange start=0U64 len=0U64 /> /> />
        }
        val function = self.arena.functionAt(index: canonical)
        val lexical = try self.lexicalFunction(f: function)
        mut val selfParameter = 0U64
        if lexical.recvTy != 0U64 && lexical.recvTy < self.arena.typeTerms.count() { selfParameter = self.arena.typeTerms[lexical.recvTy].paramId }
        return <Result.Ok value=<DeclarationTypeScope owner=canonical parameters=function.typeParams selfParameter=selfParameter /> />
    }

    // Inspect canonical children, including projection receivers and record
    // fields. A foreign binder is not a legitimate reason to defer a check.
    inout fn declarationTypeDependency(ref: U64, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        if self.arena.typeIsClosed(ref: ref) { return <Result.Ok value=false /> }
        if ref >= self.arena.typeTerms.count() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation has an invalid type term") /> }
        val term = self.arena.typeTerms[ref]
        mut val dependent = false
        if term.paramId != 0U64 {
            dependent = term.paramId == scope.selfParameter
            mut val index = 0U64
            while index < scope.parameters.count() {
                if self.funcBindAt(binds: scope.parameters, index: index).paramId == term.paramId { dependent = true }
                index += 1U64
            }
            if !dependent { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration obligation refers to a type parameter outside its lexical scope") /> }
        }
        mut val index = 0U64
        while index < self.typeTermRefChildCount(ref: ref) {
            if (try self.declarationTypeDependency(ref: self.typeTermRefChildRef(ref: ref, index: index), scope: scope, offset: offset)) { dependent = true }
            index += 1U64
        }
        if !dependent { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "unresolved declaration type has no lexical parameter dependency") /> }
        return <Result.Ok value=true />
    }

    inout fn declarationBoundDependency(bound: TraitBound, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        if bound.subject == 0U64 || bound.constraint.key.owner == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no valid trait bound") /> }
        mut val dependent = try self.declarationTypeDependency(ref: bound.subject, scope: scope, offset: offset)
        for argument in bound.constraint.key.positionalArgs {
            if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true }
        }
        for predicate in bound.constraint.assocPredicates {
            if (try self.declarationTypeDependency(ref: predicate.value, scope: scope, offset: offset)) { dependent = true }
        }
        return <Result.Ok value=dependent />
    }

    inout fn declarationWitnessDependency(witness: WitnessMatch, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        mut val dependent = try self.declarationTypeDependency(ref: witness.selfRef, scope: scope, offset: offset)
        for binding in witness.binds {
            if (try self.declarationTypeDependency(ref: binding.term, scope: scope, offset: offset)) { dependent = true }
        }
        if witness.conditions != 0U64 {
            if witness.conditions > self.arena.witnessConditionPlans.count() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected conformance has an invalid condition plan") /> }
            for step in self.arena.witnessConditionPlans[witness.conditions - 1U64].normalizations {
                if step.source == 0U64 || step.source >= self.arena.typeCount() || self.arena.typeAt(index: step.source).assocNameId == 0U64 { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected condition has invalid projection evidence") /> }
                val projection = self.arena.typeAt(index: step.source)
                // Integrity has admitted the projection equation. Its free
                // dependencies are the receiver, trait arguments and output;
                // the proved projection itself is not an unresolved obligation.
                if (try self.declarationTypeDependency(ref: self.typeTermProjectionReceiver(t: projection), scope: scope, offset: offset)) { dependent = true }
                for argument in projection.assocTraitArgs {
                    if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true }
                }
                if (try self.declarationTypeDependency(ref: step.output, scope: scope, offset: offset)) { dependent = true }
                if (try self.declarationProofDependency(proof: self.thawStaticConformanceProof(id: step.proof), scope: scope, offset: offset)) { dependent = true }
            }
            for proof in self.arena.witnessConditionPlans[witness.conditions - 1U64].proofs {
                if (try self.declarationProofDependency(proof: self.thawStaticConformanceProof(id: proof), scope: scope, offset: offset)) { dependent = true }
            }
        }
        return <Result.Ok value=dependent />
    }

    // Binder compatibility does not authorize another body's assumptions.
    // Canonical source owners preserve legitimate closure/provided aliases.
    inout fn checkDeclarationAssumptionScope(source: DeclarationBoundRef, scope: DeclarationTypeScope, offset: U64) -> Result[(), CompileDiagnostic] {
        if !self.declarationBoundIsValid(source: source) { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no valid trait bound") /> }
        val owner = match source {
            DeclarationBoundRef.Function(index: val index) => { give self.decls.funcBounds.at(index: index).fnIdx }
            DeclarationBoundRef.MethodReceiver(index: val index) => { give index }
            DeclarationBoundRef.AssociatedType(index: val index) => {
                for active in self.activeAssumptionAdmission {
                    if active == index { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration assumption prerequisite is cyclic") /> }
                }
                self.activeAssumptionAdmission.append(index)
                val result = self.declarationProofDependency(proof: self.arena.associatedBoundEvidence[index].prerequisite, scope: scope, offset: offset)
                self.activeAssumptionAdmission.removeLast()
                try result
                val evidence = self.arena.associatedBoundEvidence[index]
                val expected = try self.associatedClauseBound(projectionRef: evidence.projection, clauseIndex: evidence.clause, prerequisite: evidence.prerequisite, offset: offset)
                if !self.typeRefEq(a: evidence.bound.subject, b: expected.subject) || !self.sameTraitConstraint(a: evidence.bound.constraint, b: expected.constraint) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption does not match its declaration clause") />
                }
                return <Result.Ok value=() />
            }
            // Function bodies receive impl/requirement conditions as FuncBound
            // facts. Declaration checking's pool references are not their
            // authority, even when the subjects happen to match.
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration assumption is not available in its lexical scope") /> }
        }
        val lexical = self.decls.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        if owner >= self.arena.functionCount() || (try self.semanticBodyOwner(fnIdx: lexical)) != scope.owner {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "declaration assumption is not available in its lexical scope") />
        }
        return <Result.Ok value=() />
    }

    inout fn declarationProofDependency(proof: StaticConformanceProof, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        mut val dependent = false
        match proof {
            StaticConformanceProof.Missing => {}
            StaticConformanceProof.ConcreteWitness(witness: val witness) => { return self.declarationWitnessDependency(witness: witness, scope: scope, offset: offset) }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: _) => {
                for edge in edges { if (try self.declarationWitnessDependency(witness: edge, scope: scope, offset: offset)) { dependent = true } }
            }
            StaticConformanceProof.AssumedBound(source: val source) => {
                try self.checkDeclarationAssumptionScope(source: source, scope: scope, offset: offset)
                return self.declarationBoundDependency(bound: self.declarationBound(source: source), scope: scope, offset: offset)
            }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => {
                try self.checkDeclarationAssumptionScope(source: source, scope: scope, offset: offset)
                return self.declarationBoundDependency(bound: self.assumedSupertraitBound(source: source, steps: steps), scope: scope, offset: offset)
            }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                try self.checkDeclarationAssumptionScope(source: source, scope: scope, offset: offset)
                dependent = try self.declarationBoundDependency(bound: self.assumedSupertraitBound(source: source, steps: steps), scope: scope, offset: offset)
                for edge in edges { if (try self.declarationWitnessDependency(witness: edge, scope: scope, offset: offset)) { dependent = true } }
            }
            StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: val receiver, traitArgs: val arguments) => {
                dependent = try self.declarationTypeDependency(ref: receiver, scope: scope, offset: offset)
                for argument in arguments { if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true } }
            }
        }
        return <Result.Ok value=dependent />
    }

    inout fn declarationStaticMemberDependency(resolution: StaticMemberResolution, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: _, reqIdx: _) => { return self.declarationProofDependency(proof: proof, scope: scope, offset: offset) }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: _, callee: _) => { return self.declarationProofDependency(proof: proof, scope: scope, offset: offset) }
            StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no selected member") /> }
        }
    }

    // Admission applies before deciding whether a call is closed or deferred.
    // The recorded source owner, not the current executable request, supplies
    // the authority of any retained declaration assumptions.
    // The saved proof must project the trait selected by this call, for the
    // saved receiver. A separately valid proof is not this call's evidence.
    inout fn checkDeclarationCallBoundary(proof: StaticConformanceProof, receiverRef: U64, traitIndex: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
        if bound.subject == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call evidence does not match its declaration trait") />
        }
        if receiverRef == 0U64 || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: receiverRef), b: self.typeRefWithoutOuterViews(ref: bound.subject)) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call evidence does not match its receiver type") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkDeclarationDirectCallBoundary(callee: U64, proof: StaticConformanceProof, receiverRef: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if callee >= self.arena.functionCount() {
            if self.proofIsMissing(proof: proof) { return <Result.Ok value=() /> }
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call evidence has no declaration") />
        }
        val function = self.arena.functionAt(index: callee)
        if self.proofIsMissing(proof: proof) {
            if function.isProvided {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected provided call has no conformance evidence") />
            }
            return <Result.Ok value=() />
        }
        // A copied provided callable is selected through its public target.
        // An original trait receiver declaration (including a default-value
        // function with that lexical receiver environment) uses that receiver
        // trait. Its public conformance target can be a different path edge.
        val owner = if function.isProvided || function.provTraitOwner == 0U64 { give function.originTraitOwner } else { give function.provTraitOwner }
        return self.checkDeclarationCallBoundary(proof: proof, receiverRef: receiverRef, traitIndex: self.decls.traitIndexByOffset(offset: owner), offset: offset)
    }

    inout fn checkDeclarationCallProof(proof: StaticConformanceProof, scope: DeclarationTypeScope, offset: U64) -> Result[(), CompileDiagnostic] {
        // Integrity precedes dependency traversal: malformed conditional plans
        // must not be interpreted as authorizing premises or recurse forever.
        try self.checkStaticProofEvidence(proof: proof, offset: offset)
        try self.declarationProofDependency(proof: proof, scope: scope, offset: offset)
        return <Result.Ok value=() />
    }

    inout fn checkDeclarationStaticCallEvidence(resolution: StaticMemberResolution, receiverRef: U64, scope: DeclarationTypeScope, offset: U64) -> Result[(), CompileDiagnostic] {
        try self.selectedStaticCallDeclaration(resolution: resolution, offset: offset)
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIndex, reqIdx: _) => {
                try self.checkDeclarationCallProof(proof: proof, scope: scope, offset: offset)
                return self.checkDeclarationCallBoundary(proof: proof, receiverRef: receiverRef, traitIndex: traitIndex, offset: offset)
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: val traitIndex, callee: _) => {
                try self.checkDeclarationCallProof(proof: proof, scope: scope, offset: offset)
                return self.checkDeclarationCallBoundary(proof: proof, receiverRef: receiverRef, traitIndex: traitIndex, offset: offset)
            }
            StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration obligation has no selected member") /> }
        }
    }

    // A source operand keeps its semantic type even after its lexical walk
    // ended. A late literal context is a recorded fact, never ABI inference.
    inout fn sourceCallArgumentType(source: CallArgumentSource) -> U64 {
        match source {
            CallArgumentSource.Term(exprId: _, term: val term) => { return term }
            CallArgumentSource.Local(exprId: val expression, declarationTarget: _, term: val term) => {
                if term != 0U64 { return term }
                return self.semanticExprTerm(exprId: expression)
            }
            CallArgumentSource.PriorCallResult(exprId: _, siteKey: val dependency) => { return self.sourceSelectedCallResult(siteKey: dependency) }
            CallArgumentSource.Legacy(exprId: val expression, info: _) => { return self.semanticExprTerm(exprId: expression) }
        }
    }

    inout fn checkSourceCallArgumentType(argument: CallTemplateArgument, expected: U64, owner: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val source = self.sourceCallArgumentType(source: argument.source)
        if source == 0U64 || source >= self.arena.typeCount() || expected == 0U64 || expected >= self.arena.typeCount() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call argument has no resolved signature type") />
        }
        if self.typeRefEq(a: source, b: expected) { return <Result.Ok value=() /> }
        val normalizedSource = try self.normalizedValueType(ref: source)
        val normalizedExpected = try self.normalizedValueType(ref: expected)
        if self.typeRefEq(a: normalizedSource, b: normalizedExpected) { return <Result.Ok value=() /> }
        val site = try self.templateCallSiteKey(fnIdx: owner, exprId: self.callArgumentExprId(source: argument.source))
        val lexical = self.decls.callTemplateLexicalRoots.getOr(key: site.ownerFnIdx, fallback: site.ownerFnIdx)
        for index in self.decls.declarationConversionOwners.getOr(key: lexical, fallback: []) {
            val conversion = self.decls.declarationConversions[index]
            if self.sameCallSiteKey(a: conversion.site, b: site) && self.typeRefEq(a: conversion.source, b: normalizedSource) && self.typeRefEq(a: conversion.target, b: normalizedExpected) {
                return self.checkDeclarationConversionEvidence(conversion: conversion)
            }
        }
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call argument does not match its signature or retained conversion") />
    }

    // Complete selections consume the same frozen operand plan. Root evidence
    // is admitted before either substitution context is constructed.
    inout fn checkSourceDirectCallArguments(template: CallTemplate, function: Func, arguments: CallTemplateArgumentRange, typeArgs: CallTemplateTypeArgumentRange, proofId: U64) -> Result[(), CompileDiagnostic] {
        if arguments.len == 0U64 { return <Result.Ok value=() /> }
        val environment = try self.recordedDirectCallEnvironment(function: function, receiverTerm: template.receiverTypeTerm, typeArgs: self.callTemplateTypeArgs(range: typeArgs), proof: self.thawStaticConformanceProof(id: proofId))
        return self.checkSourceCallArguments(template: template, function: function, arguments: arguments, signature: <SourceCallSignature.Direct environment=environment />)
    }

    inout fn checkSourceStaticCallArguments(template: CallTemplate, function: Func, arguments: CallTemplateArgumentRange, typeArgs: CallTemplateTypeArgumentRange, resolution: StaticMemberResolution) -> Result[(), CompileDiagnostic] {
        if arguments.len == 0U64 { return <Result.Ok value=() /> }
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIndex, reqIdx: _) => {
                val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
                val environment = <InstanceEnvironment params=self.copyFuncBinds(binds: function.typeParams) args=self.callTemplateTypeArgs(range: typeArgs) receiverRef=template.receiverTypeTerm proof=proof />
                return self.checkSourceCallArguments(template: template, function: function, arguments: arguments, signature: <SourceCallSignature.Trait bound=bound traitIndex=traitIndex environment=environment />)
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: val traitIndex, callee: _) => {
                val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
                val environment = try self.recordedDirectCallEnvironment(function: function, receiverTerm: template.receiverTypeTerm, typeArgs: self.callTemplateTypeArgs(range: typeArgs), proof: proof)
                return self.checkSourceCallArguments(template: template, function: function, arguments: arguments, signature: <SourceCallSignature.Trait bound=bound traitIndex=traitIndex environment=environment />)
            }
            StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "deferred declaration obligation has no selected member") /> }
        }
    }

    inout fn sourceCallSignatureParameter(ref: U64, signature: SourceCallSignature) -> Result[U64, CompileDiagnostic] {
        match signature {
            SourceCallSignature.Direct(environment: val environment) => {
                return self.groundTermForBody(ref: ref, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
            }
            SourceCallSignature.Trait(bound: val bound, traitIndex: val traitIndex, environment: val environment) => {
                val traitTerm = self.traitBoundTypeTerm(ref: ref, bound: bound, traitIndex: traitIndex)
                return self.groundTermForBody(ref: traitTerm, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)
            }
        }
    }

    inout fn checkSourceCallArguments(template: CallTemplate, function: Func, arguments: CallTemplateArgumentRange, signature: SourceCallSignature) -> Result[(), CompileDiagnostic] {
        val input = <CallableArgumentInput.Templates range=arguments />
        if !self.callableInputLabelsOk(params: function.params, input: input) {
            return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "selected call arguments do not match its parameter labels") />
        }
        mut val index = 0U64
        mut val position = 0U64
        while index < arguments.len {
            position = self.callableNextParameter(params: function.params, input: input, index: index, start: position)
            val parameter = self.funcParamAt(params: function.params, index: position)
            val argument = self.decls.callTemplateArgumentPool[arguments.start + index]
            if argument.isInout != parameter.isInout {
                return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "selected call argument does not match its parameter access mode") />
            }
            val expected = try self.sourceCallSignatureParameter(ref: parameter.ty, signature: signature)
            try self.checkSourceCallArgumentType(argument: argument, expected: expected, owner: template.siteKey.ownerFnIdx, offset: template.siteKey.originStart)
            position += 1U64
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn sourceCallSignatureConstraint(constraint: TraitConstraint, signature: SourceCallSignature) -> Result[TraitConstraint, CompileDiagnostic] {
        mut val arguments: Array[U64] = []
        for argument in constraint.key.positionalArgs { arguments.append(try self.sourceCallSignatureParameter(ref: argument, signature: signature)) }
        mut val predicates: Array[TraitAssocPredicate] = []
        for predicate in constraint.assocPredicates {
            predicates.append(<TraitAssocPredicate member=predicate.member value=(try self.sourceCallSignatureParameter(ref: predicate.value, signature: signature)) span=predicate.span />)
        }
        return <Result.Ok value=<TraitConstraint key=<TraitInstanceKey owner=constraint.key.owner positionalArgs=arguments /> positionalArgsOpen=constraint.positionalArgsOpen assocPredicates=predicates /> />
    }

    fn sourceDeclarationCallBoundIndices(functionIndex: U64) -> Array[U64] {
        val owner = self.arena.functionLexicalOwner(index: functionIndex)
        val direct = self.decls.funcBounds.indices(owner: functionIndex)
        if owner == functionIndex { return direct }
        val inherited = self.decls.funcBounds.indices(owner: owner)
        if direct.count() == 0U64 { return inherited }
        if inherited.count() == 0U64 { return direct }
        mut val indices: Array[U64] = []
        mut val cursor = 0U64
        for index in direct {
            while cursor < inherited.count() && inherited[cursor] < index {
                indices.append(inherited[cursor])
                cursor += 1U64
            }
            indices.append(index)
        }
        while cursor < inherited.count() {
            indices.append(inherited[cursor])
            cursor += 1U64
        }
        return indices
    }

    inout fn sourceDeclarationCallBounds(indices: Array[U64], signature: SourceCallSignature) -> Result[Array[TraitBound], CompileDiagnostic] {
        mut val bounds: Array[TraitBound] = []
        for index in indices {
            val bound = self.decls.funcBounds.at(index: index)
            bounds.append(<TraitBound subject=(try self.sourceCallSignatureParameter(ref: bound.paramTy, signature: signature)) constraint=(try self.sourceCallSignatureConstraint(constraint: bound.constraint, signature: signature)) offset=bound.paramStart />)
        }
        return <Result.Ok value=bounds />
    }

    // Interpret only the already-selected public signature. Requirement
    // obligations remain distinct from its eventual witness body's bounds.
    inout fn sourceSelectedCallBounds(template: CallTemplate) -> Result[Array[TraitBound], CompileDiagnostic] {
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: val arguments, proofId: val proofId) => {
                val indices = self.sourceDeclarationCallBoundIndices(functionIndex: callee)
                if indices.count() == 0U64 { return <Result.Ok value=[] /> }
                val function = self.arena.functionAt(index: callee)
                val environment = try self.recordedDirectCallEnvironment(function: function, receiverTerm: template.receiverTypeTerm, typeArgs: self.callTemplateTypeArgs(range: arguments), proof: self.thawStaticConformanceProof(id: proofId))
                return self.sourceDeclarationCallBounds(indices: indices, signature: <SourceCallSignature.Direct environment=environment />)
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: val arguments, resultTerm: _) => {
                val function = try self.selectedStaticCallDeclaration(resolution: resolution, offset: template.siteKey.originStart)
                match resolution {
                    StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIndex, reqIdx: _) => {
                        if function.signatureBounds.len == 0U64 { return <Result.Ok value=[] /> }
                        val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
                        val environment = <InstanceEnvironment params=self.copyFuncBinds(binds: function.typeParams) args=self.callTemplateTypeArgs(range: arguments) receiverRef=template.receiverTypeTerm proof=proof />
                        val signature = <SourceCallSignature.Trait bound=bound traitIndex=traitIndex environment=environment />
                        mut val bounds: Array[TraitBound] = []
                        mut val index = 0U64
                        while index < function.signatureBounds.len {
                            val clause = self.conformBoundAt(bounds: function.signatureBounds, index: index)
                            bounds.append(<TraitBound subject=(try self.sourceCallSignatureParameter(ref: clause.subject, signature: signature)) constraint=(try self.sourceCallSignatureConstraint(constraint: clause.constraint, signature: signature)) offset=clause.offset />)
                            index += 1U64
                        }
                        return <Result.Ok value=bounds />
                    }
                    StaticMemberResolution.Provided(proof: val proof, traitIdx: val traitIndex, callee: val callee) => {
                        val indices = self.sourceDeclarationCallBoundIndices(functionIndex: callee)
                        if indices.count() == 0U64 { return <Result.Ok value=[] /> }
                        val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
                        val environment = try self.recordedDirectCallEnvironment(function: function, receiverTerm: template.receiverTypeTerm, typeArgs: self.callTemplateTypeArgs(range: arguments), proof: proof)
                        return self.sourceDeclarationCallBounds(indices: indices, signature: <SourceCallSignature.Trait bound=bound traitIndex=traitIndex environment=environment />)
                    }
                    StaticMemberResolution.Missing => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "deferred declaration obligation has no selected member") /> }
                }
            }
            _ => { return <Result.Ok value=[] /> }
        }
    }

    // Admission precedes this boundary reader: a malformed child must never
    // participate in proof-dependent projection or associated-type lookup.
    inout fn checkSelectedCallConstraintBoundary(expected: TraitBound, proof: StaticConformanceProof, offset: U64) -> Result[(), CompileDiagnostic] {
        val traitIndex = self.decls.traitIndexByOffset(offset: expected.constraint.key.owner)
        val bound = try self.staticProofBound(proof: proof, traitIdx: traitIndex)
        if bound.subject == 0U64 || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: expected.subject), b: self.typeRefWithoutOuterViews(ref: bound.subject)) || bound.constraint.key.owner != expected.constraint.key.owner || (!expected.constraint.positionalArgsOpen && !self.sameResolvedTypeRefs(a: bound.constraint.key.positionalArgs, b: expected.constraint.key.positionalArgs)) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call constraint evidence does not satisfy its signature") />
        }
        mut val names: Array[U64] = []
        mut val values: Array[U64] = []
        for predicate in expected.constraint.assocPredicates { names.append(predicate.member) values.append(predicate.value) }
        if !(try self.selectedProofAssociatedTypesMatch(proof: proof, traitOwner: expected.constraint.key.owner, names: names, values: values)) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "selected call constraint evidence does not satisfy its signature") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkSelectedCallConstraintPlan(template: CallTemplate, expected: Array[TraitBound], plan: SelectedCallConstraints) -> Result[(), CompileDiagnostic] {
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        if plan.owner != scope.owner || plan.bounds.count() != expected.count() || plan.proofs.count() != expected.count() {
            return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "selected call has incomplete constraint evidence") />
        }
        mut val index = 0U64
        while index < expected.count() {
            val bound = expected[index]
            if !self.typeRefEq(a: plan.bounds[index].subject, b: bound.subject) || !self.sameTraitConstraint(a: plan.bounds[index].constraint, b: bound.constraint) {
                return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "selected call constraint evidence has a different substitution") />
            }
            val proof = self.thawStaticConformanceProof(id: plan.proofs[index])
            try self.checkDeclarationCallProof(proof: proof, scope: scope, offset: template.siteKey.originStart)
            try self.checkSelectedCallConstraintBoundary(expected: bound, proof: proof, offset: template.siteKey.originStart)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    // This is the construction frontier. A repeated request consumes the
    // existing plan; it cannot repair a missing or inconsistent selected proof.
    inout fn prepareCallTemplateConstraints(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        try self.checkCallTemplateSelection(templateIndex: templateIndex)
        val template = self.decls.callTemplates[templateIndex]
        val bounds = try self.sourceSelectedCallBounds(template: template)
        match self.decls.selectedCallConstraintPlan(index: templateIndex) {
            Optional.Some(v: val plan) => { return self.checkSelectedCallConstraintPlan(template: template, expected: bounds, plan: plan) }
            Optional.None => {}
        }
        // An empty signature needs no new evidence, but any retained plan
        // must still have matched that exact empty signature above.
        if bounds.count() == 0U64 { return <Result.Ok value=() /> }
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        val assumptions = self.functionBoundAssumptions(fnIdx: template.siteKey.ownerFnIdx)
        mut val proofs: Array[U64] = []
        for bound in bounds {
            val proof = try self.viewedTraitConstraintProof(ref: bound.subject, constraint: bound.constraint, assumptions: assumptions)
            if self.proofIsMissing(proof: proof) {
                return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "type argument does not conform to the trait required by `where`") />
            }
            try self.checkDeclarationCallProof(proof: proof, scope: scope, offset: template.siteKey.originStart)
            try self.checkSelectedCallConstraintBoundary(expected: bound, proof: proof, offset: template.siteKey.originStart)
            proofs.append(self.freezeStaticConformanceProof(proof: proof))
        }
        if !self.decls.recordBuildingCallConstraints(index: templateIndex, plan: <SelectedCallConstraints owner=scope.owner bounds=bounds proofs=proofs />) {
            return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "cannot replace prepared call constraint evidence") />
        }
        return <Result.Ok value=() />
    }

    // Publication uses the same lexical authority as plan construction and
    // admission, including closure and provided-body owner normalization.
    inout fn publishPreparedCallConstraints(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        val template = self.decls.callTemplates[templateIndex]
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        self.decls.sealSelectedCallConstraints(index: templateIndex, owner: scope.owner)
        return <Result.Ok value=() />
    }

    inout fn checkRecordedCallConstraintEvidence(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        val template = self.decls.callTemplates[templateIndex]
        val bounds = try self.sourceSelectedCallBounds(template: template)
        match self.decls.selectedCallConstraintPlan(index: templateIndex) {
            Optional.Some(v: val plan) => { return self.checkSelectedCallConstraintPlan(template: template, expected: bounds, plan: plan) }
            Optional.None => {
                if bounds.count() == 0U64 { return <Result.Ok value=() /> }
                return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "selected call has no retained constraint evidence") />
            }
        }
    }

    inout fn checkCallTemplateEvidence(template: CallTemplate) -> Result[(), CompileDiagnostic] {
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: val proof) => {
                if proof == 0U64 {
                    return self.checkDeclarationDirectCallBoundary(callee: callee, proof: <StaticConformanceProof.Missing />, receiverRef: template.receiverTypeTerm, offset: template.siteKey.originStart)
                }
                val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
                val selected = self.thawStaticConformanceProof(id: proof)
                try self.checkDeclarationCallProof(proof: selected, scope: scope, offset: template.siteKey.originStart)
                try self.checkDeclarationDirectCallBoundary(callee: callee, proof: selected, receiverRef: template.receiverTypeTerm, offset: template.siteKey.originStart)
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: _, resultTerm: _) => {
                val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
                try self.checkDeclarationStaticCallEvidence(resolution: resolution, receiverRef: template.receiverTypeTerm, scope: scope, offset: template.siteKey.originStart)
            }
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
                match selection {
                    ProtocolSelection.Direct(callee: val callee, proof: val proof) => {
                        try self.checkDeclarationCallProof(proof: proof, scope: scope, offset: template.siteKey.originStart)
                        try self.checkDeclarationDirectCallBoundary(callee: callee, proof: proof, receiverRef: template.receiverTypeTerm, offset: template.siteKey.originStart)
                    }
                    ProtocolSelection.Static(resolution: val resolution) => { try self.checkDeclarationStaticCallEvidence(resolution: resolution, receiverRef: template.receiverTypeTerm, scope: scope, offset: template.siteKey.originStart) }
                    _ => {}
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Static(resolution: val resolution) => {
                        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
                        try self.checkDeclarationStaticCallEvidence(resolution: resolution, receiverRef: template.receiverTypeTerm, scope: scope, offset: template.siteKey.originStart)
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    inout fn checkDeferredCallDependency(template: CallTemplate) -> Result[(), CompileDiagnostic] {
        val scope = try self.declarationTypeScope(owner: template.siteKey.ownerFnIdx)
        val offset = template.siteKey.originStart
        mut val dependent = try self.declarationTypeDependency(ref: template.receiverTypeTerm, scope: scope, offset: offset)
        match template.kind {
            CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: val arguments, proofId: val proof) => {
                for argument in self.callTemplateTypeArgs(range: arguments) { if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true } }
                if (try self.declarationProofDependency(proof: self.thawStaticConformanceProof(id: proof), scope: scope, offset: offset)) { dependent = true }
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: val arguments, resultTerm: _) => {
                for argument in self.callTemplateTypeArgs(range: arguments) { if (try self.declarationTypeDependency(ref: argument, scope: scope, offset: offset)) { dependent = true } }
                if (try self.declarationStaticMemberDependency(resolution: resolution, scope: scope, offset: offset)) { dependent = true }
            }
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                match selection {
                    ProtocolSelection.Direct(callee: _, proof: val proof) => { if (try self.declarationProofDependency(proof: proof, scope: scope, offset: offset)) { dependent = true } }
                    ProtocolSelection.Static(resolution: val resolution) => { if (try self.declarationStaticMemberDependency(resolution: resolution, scope: scope, offset: offset)) { dependent = true } }
                    _ => {}
                }
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Static(resolution: val resolution) => { if (try self.declarationStaticMemberDependency(resolution: resolution, scope: scope, offset: offset)) { dependent = true } }
                    _ => {}
                }
            }
            _ => {}
        }
        if !dependent { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration call has no lexical parameter dependency") /> }
        return <Result.Ok value=() />
    }

    inout fn declarationConversionDependency(conversion: ValueConversionProof, scope: DeclarationTypeScope, offset: U64) -> Result[Bool, CompileDiagnostic] {
        mut val dependent = false
        match conversion {
            ValueConversionProof.ExistentialRetag(sourceRef: val source, targetRef: val target) => {
                dependent = try self.declarationTypeDependency(ref: source, scope: scope, offset: offset)
                if (try self.declarationTypeDependency(ref: target, scope: scope, offset: offset)) { dependent = true }
            }
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: _, proof: val proof) => {
                dependent = try self.declarationTypeDependency(ref: source, scope: scope, offset: offset)
                if (try self.declarationTypeDependency(ref: target, scope: scope, offset: offset)) { dependent = true }
                if (try self.declarationProofDependency(proof: proof, scope: scope, offset: offset)) { dependent = true }
            }
            ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => { return self.declarationConversionDependency(conversion: element, scope: scope, offset: offset) }
            ValueConversionProof.EnumRepack(sourceRef: val source, targetRef: val target, enumIdx: _, argumentProofs: val arguments, payloads: val payloads) => {
                dependent = try self.declarationTypeDependency(ref: source, scope: scope, offset: offset)
                if (try self.declarationTypeDependency(ref: target, scope: scope, offset: offset)) { dependent = true }
                for argument in arguments { if (try self.declarationConversionDependency(conversion: argument, scope: scope, offset: offset)) { dependent = true } }
                for payload in payloads {
                    if (try self.declarationTypeDependency(ref: payload.sourceRef, scope: scope, offset: offset)) { dependent = true }
                    if (try self.declarationTypeDependency(ref: payload.targetRef, scope: scope, offset: offset)) { dependent = true }
                    if (try self.declarationConversionDependency(conversion: payload.conversion, scope: scope, offset: offset)) { dependent = true }
                }
            }
            ValueConversionProof.Identity => {}
            ValueConversionProof.Missing => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "deferred declaration conversion has no evidence") /> }
        }
        return <Result.Ok value=dependent />
    }

    inout fn checkRecordedMemberObligations() -> Result[(), CompileDiagnostic] {
        // Recording precedes ordinary source diagnostics. Keep failed evidence
        // rather than suppressing it or replacing those diagnostics early.
        // No unresolved conversion may survive declaration completion.
        for conversion in self.decls.declarationConversions {
            try self.checkDeclarationConversionEvidence(conversion: conversion)
        }

        try self.checkDiagnosticContinuationFailures()
        tracePhase(c: inout self, label: "member-obligations:relevance:start")
        val relevant = try self.memberObligationRelevance()
        tracePhase(c: inout self, label: "member-obligations:roots:start")
        mut val requests: Array[CallConstraintInstance] = []
        mut val heads: Dictionary[U64, U64] = [:]
        val limit = self.decls.callTemplates.count()
        mut val index = 0U64
        mut val deferred = 0U64
        // Every source call is a root, including unused functions. Generic
        // calls become closed when reached through a caller's substitution.
        while index < limit {
            if (try self.checkCallConstraintTemplate(template: self.decls.callTemplates[index], environment: <InstanceEnvironment />, depth: 0U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                try self.checkDeferredCallDependency(template: self.decls.callTemplates[index])
                deferred += 1U64
            }
            index += 1U64
        }
        for conversion in self.decls.declarationConversions {
            if (try self.checkConversionObligations(conversion: self.thawValueConversionProof(id: conversion.proof), environment: <InstanceEnvironment />, depth: 0U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                val scope = try self.declarationTypeScope(owner: conversion.site.ownerFnIdx)
                if !(try self.declarationConversionDependency(conversion: self.thawValueConversionProof(id: conversion.proof), scope: scope, offset: conversion.site.originStart)) {
                    return <Result.Err error=self.diagnosticAt(offset: conversion.site.originStart, msg: "deferred declaration conversion has no lexical parameter dependency") />
                }
                deferred += 1U64
            }
        }
        tracePhaseCount(c: inout self, label: "member-obligations:roots:deferred", count: deferred)
        tracePhase(c: inout self, label: "member-obligations:instances:start")
        index = 0U64
        while index < requests.count() {
            val request = requests[index]
            for conversionIndex in self.decls.declarationConversionOwners.getOr(key: request.function, fallback: []) {
                val conversion = self.decls.declarationConversions[conversionIndex]
                if (try self.checkConversionObligations(conversion: self.thawValueConversionProof(id: conversion.proof), environment: request.environment, depth: request.depth + 1U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                    return <Result.Err error=self.diagnosticAt(offset: conversion.site.originStart, msg: "concrete declaration conversion retains an unresolved obligation") />
                }
            }
            mut val row = self.firstLexicalCallTemplate(owner: request.function)
            while row != 0U64 {
                val template = self.decls.callTemplates[row - 1U64]
                if (try self.checkCallConstraintTemplate(template: template, environment: request.environment, depth: request.depth + 1U64, requests: inout requests, heads: inout heads, relevant: relevant)).isDeferred() {
                    return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "concrete declaration call retains an unresolved obligation") />
                }
                row = self.decls.callTemplateBodyNext[row - 1U64]
            }
            index += 1U64
        }
        tracePhaseCount(c: inout self, label: "member-obligations:instances:done", count: requests.count())
        return <Result.Ok value=() />
    }
}
