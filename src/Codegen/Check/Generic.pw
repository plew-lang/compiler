// Part of compile-time checks (root: _.pw): eager generic-body type
// checking.

// Whether (start,len) names the abstract Self type of the trait provided-method
// currently being checked (`c.cur.checkFn`) — i.e. it is a `self`-typed value in a
// `pub impl Trait { fn ... }` body, where Self's only members are the trait's
// requirements (and provided methods / supertraits). Returns the trait's name id
// via the receiver, so the capability check uses traitProvidesMember.

pub impl Comp {
    inout fn isSelfTypeInProvided(start: U64, len: U64) -> Bool {
        if self.cur.checkFn >= self.arena.funcs.count() {
            return false
        }
        val f: Func = self.arena.funcs[self.cur.checkFn]
        if !(self.methodRecvIsTrait(f: f)) {
            return false
        }
        return spansEqual(c: inout self, aStart: start, aLen: len, bStart: f.recvStart, bLen: f.recvLen)
    }

    inout fn isTypeParamOf(fnIdx: U64, start: U64, len: U64) -> Bool {
        if fnIdx >= self.arena.funcs.count() {
            return false
        }
        val tps: Array[Bind] = self.arena.funcs[fnIdx].typeParams
        val qTp: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = 0
        while i < tps.count() {
            if tps[i].nameId == qTp {
                return true
            }
            i += 1
        }
        return false
    }

    // The single name-resolution authority: resolve the identifier `start..len` to its
    // binding in ONE pass — the classification `code` (identValueCode / identFnCode /
    // identTypeQualCode / identUndefCode) and the backend-locate `target` together (see
    // Ir.IdentBinding). Categories: `self`, a local/parameter/global (all live in
    // c.cur.locals during these passes — seedGlobalLocals folds globals in — so
    // localIndexByName finds them) = a VALUE; a bare free-function name = a callable
    // DECLARATION, not a value; a type / primitive / type-parameter of `tpFn` = a type
    // QUALIFIER, valid only as an assoc-fn receiver (`Buffer.new()` / `T.make()`), never a
    // value read; anything else = UNDEF. The target:
    // for a local/param/global value, the DECLARATION's source offset (locals[li].nameStart)
    // — a unique per-declaration key the backend matches against its locStart, so it locates
    // exactly the declaration the resolver chose (not "the innermost same-named local"), with
    // a name scan as a safe fallback; for a callable declaration, the resolved fn index; identNoTarget()
    // for `self`, a type qualifier, or an undef. Each name table (locals, funcs) is scanned
    // at most once, so the classification and the target come from the SAME lookup and cannot
    // disagree — the resolver never re-derives what it already found. `tpFn >= funcs.count()`
    // means no type parameters are in scope (a non-generic body — isTypeParamOf
    // short-circuits to false). Kept as the one place that decides ident binding so the
    // generic/non-generic split the unification erased is not silently reintroduced at the
    // resolution layer (spec/04).
    inout fn resolveIdent(start: U64, len: U64, tpFn: U64) -> IdentBinding {
        if self.isSelfRef(start: start, len: len) {
            return <IdentBinding code=identValueCode() target=identNoTarget() />
        }
        val li: U64 = self.localIndexByName(start: start, len: len)
        if li < self.cur.locals.count() {
            return <IdentBinding code=identValueCode() target=self.cur.locals[li].nameStart />
        }
        val fi: U64 = self.firstFuncByName(nameStart: start, nameLen: len)
        if fi < self.arena.funcs.count() {
            return <IdentBinding code=identFnCode() target=fi />
        }
        if self.isTypeName(start: start, len: len) {
            return <IdentBinding code=identTypeQualCode() target=identNoTarget() />
        }
        if self.isPrimType(start: start, len: len) {
            return <IdentBinding code=identTypeQualCode() target=identNoTarget() />
        }
        if self.isTypeParamOf(fnIdx: tpFn, start: start, len: len) {
            return <IdentBinding code=identTypeQualCode() target=identNoTarget() />
        }
        return <IdentBinding code=identUndefCode() target=identNoTarget() />
    }

    // The classification alone, for callers (identIsTypeQualifier) that need only the kind.
    inout fn classifyIdent(start: U64, len: U64, tpFn: U64) -> I64 {
        return self.resolveIdent(start: start, len: len, tpFn: tpFn).code
    }

    // Resolve `id` (an Ident expr) and RECORD the binding in typeCache.identBind/identTarget
    // so the backend reads the resolver's decision instead of re-deriving it by name. Returns
    // the code. Called from the verify/check Ident walk, where c.cur.locals is valid (the
    // backend never fills locals, so it only reads this record). A node past the table
    // (synthesized after buildExprTyTable) is classified but not cached.
    inout fn recordIdent(id: U64, start: U64, len: U64, tpFn: U64) -> I64 {
        val b: IdentBinding = self.resolveIdent(start: start, len: len, tpFn: tpFn)
        if id < self.typeCache.identBind.count() {
            self.typeCache.identBind.set(i: id, value: b.code)
            self.typeCache.identTarget.set(i: id, value: b.target)
        }
        return b.code
    }

    // Whether a resolved binding code (a classifyIdent / recordIdent result) is a
    // VALUE-position read: only a value, not a callable declaration, a type qualifier
    // (`val x = SomeType` is a misuse), nor an unresolved name.
    inout fn bindIsValue(code: I64) -> Bool {
        return code == identValueCode()
    }

    inout fn identIsTypeQualifier(start: U64, len: U64, tpFn: U64) -> Bool {
        return self.classifyIdent(start: start, len: len, tpFn: tpFn) == identTypeQualCode()
    }

    inout fn traitProvidesMember(traitNameId: U64, traitArity: U64, qName: U64, args: Array[Arg], depth: U64, useMod: U64) -> Bool {
        if depth > 64U64 {
            return false
        }
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val t: TraitDef = self.decls.traits[ti]
            if t.nameId == traitNameId && self.traitArityMatches(actual: t.typeParams.count(), expected: traitArity) {
                val concreteArity: U64 = t.typeParams.count()
                // requirement of this trait
                mut val ri: U64 = 0
                while ri < t.reqs.count() {
                    val r: Func = t.reqs[ri]
                    if r.nameId == qName {
                        if self.paramsLabelsOk(params: r.params, args: args) {
                            return true
                        }
                    }
                    ri += 1
                }
                // recurse into supertraits (`trait Sub: Super + ...`)
                mut val sti: U64 = 0
                while sti < t.supertraits.count() {
                    val sup: Bind = t.supertraits[sti]
                    val supId: U64 = intern(c: inout self, start: sup.nameStart, len: sup.nameLen)
                    if self.traitProvidesMember(traitNameId: supId, traitArity: 4000000000U64, qName: qName, args: args, depth: depth + 1U64, useMod: useMod) {
                        return true
                    }
                    sti += 1
                }
                // provided method of this trait (a method with recv = the trait)
                val includePrivateProvided: Bool = useMod == self.traitModuleByIdArity(traitId: traitNameId, arity: concreteArity)
                mut val gi: U64 = 0
                while gi < self.arena.funcs.count() {
                    val g: Func = self.arena.funcs[gi]
                    if g.hasRecv {
                        if g.recvId == traitNameId && g.provTraitArity == concreteArity {
                            if includePrivateProvided || g.isPub {
                                if g.nameId == qName {
                                    if self.paramsLabelsOk(params: g.params, args: args) {
                                        return true
                                    }
                                }
                            }
                        }
                    }
                    gi += 1
                }
            }
            ti += 1
        }
        return false
    }

    inout fn boundProvidesMethod(fnIdx: U64, tpStart: U64, tpLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qTp: U64 = intern(c: inout self, start: tpStart, len: tpLen)
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == fnIdx {
                if fb.paramNameId == qTp {
                    val qTrait: U64 = intern(c: inout self, start: fb.traitStart, len: fb.traitLen)
                    if self.traitProvidesMember(traitNameId: qTrait, traitArity: 4000000000U64, qName: qName, args: args, depth: 0U64, useMod: self.moduleOf(offset: nameStart)) {
                        return true
                    }
                }
            }
            bi += 1
        }
        return false
    }

    inout fn boundHasTraitNamed(fnIdx: U64, tpStart: U64, tpLen: U64, traitName: String) -> Bool {
        val qTp: U64 = intern(c: inout self, start: tpStart, len: tpLen)
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == fnIdx {
                if fb.paramNameId == qTp {
                    if rangeEquals(bytes: self.arena.bytes, start: fb.traitStart, len: fb.traitLen, kw: traitName) {
                        return true
                    }
                }
            }
            bi += 1
        }
        return false
    }

    // Walk a method/assoc receiver in a generic body. A bare type / primitive / type-
    // parameter name here is a valid assoc-fn qualifier (`T.make()`, `Buffer.new()`),
    // not a value read — so it needs no value check (the parent Method arm bound-checks a
    // type-parameter receiver separately). Any other receiver is an ordinary value and is
    // walked normally (its Ident arm runs the value check).
    inout fn checkBoundsRecv(recv: U64, tpFn: U64) {
        match self.arena.exprs[recv] {
            Expr.Ident(val start, val len) => {
                if !(self.identIsTypeQualifier(start: start, len: len, tpFn: tpFn)) {
                    self.checkBoundsExpr(exprId: recv)
                }
            }
            _ => { self.checkBoundsExpr(exprId: recv) }
        }
    }

    inout fn binOpTraitName(op: I64) -> String {
        if op == opAdd() { return "Add" }
        if op == opSub() { return "Sub" }
        if op == opMul() { return "Mul" }
        if op == opDiv() { return "Div" }
        if op == opRem() { return "Rem" }
        if op == opBitAnd() { return "BitAnd" }
        if op == opBitOr() { return "BitOr" }
        if op == opBitXor() { return "BitXor" }
        if op == opShl() { return "Shl" }
        if op == opShr() { return "Shr" }
        return ""
    }

    inout fn unOpTraitName(op: I64) -> String {
        if op == opSub() { return "Neg" }
        if op == opNot() { return "Not" }
        if op == opBitNot() { return "BitNot" }
        return ""
    }

    inout fn checkBoundsExpr(exprId: U64) {
        match self.arena.exprs[exprId] {
            Expr.Unary(val op, val operand) => {
                self.checkBoundsExpr(exprId: operand)
                // a unary operator on a type-parameter value needs the matching bound
                // (`-x` -> `where T: Neg`, `!x` -> `: Not`, `~x` -> `: BitNot`). spec/12.
                val ut: TypeInfo = self.typeOf(id: operand)
                if ut.kind == 2 {
                    if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: ut.nameStart, len: ut.nameLen) {
                        val need: String = self.unOpTraitName(op: op)
                        if need.bytes().count() != 0U64 {
                            if !(self.boundHasTraitNamed(fnIdx: self.cur.checkFn, tpStart: ut.nameStart, tpLen: ut.nameLen, traitName: need)) {
                                self.errorAt(offset: self.exprOffset(id: operand), msg: "this unary operator on a type parameter needs the matching bound (add `where T: Neg` / `: Not` / `: BitNot`) (spec/12)")
                            }
                        }
                    }
                }
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                self.checkBoundsExpr(exprId: lhs)
                self.checkBoundsExpr(exprId: rhs)
                // concrete operand checks in a generic body (`1I64 + true`, `aT == 5I64`):
                // the same binop type-check verifyProgram runs on non-generic bodies, now
                // applied to EVERY module's generic templates (std included — no
                // trusted-import boundary).
                if self.cur.checkFn < self.arena.funcs.count() {
                    self.tcCheckBinop(op: op, lhs: lhs, rhs: rhs)
                }
                val lt: TypeInfo = self.typeOf(id: lhs)
                if lt.kind == 2 {
                    if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: lt.nameStart, len: lt.nameLen) {
                        mut val need: String = ""
                        if op >= 50 {
                            if op <= 55 {
                                need = "Ord"
                                if op == opEq() { need = "Eq" }
                                if op == opNe() { need = "Eq" }
                            }
                        }
                        // arithmetic / bitwise / shift desugar to their operator trait.
                        if need.bytes().count() == 0U64 {
                            need = self.binOpTraitName(op: op)
                        }
                        if need.bytes().count() != 0U64 {
                            if !(self.boundHasTraitNamed(fnIdx: self.cur.checkFn, tpStart: lt.nameStart, tpLen: lt.nameLen, traitName: need)) {
                                self.errorAt(offset: self.exprOffset(id: lhs), msg: "this operator on a type parameter needs the matching bound (e.g. `where T: Add` for `+`, `: Eq`/`: Ord` for comparison) (spec/12)")
                            }
                        }
                    }
                }
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                mut val i: U64 = 0
                while i < args.count() {
                    self.checkBoundsExpr(exprId: args[i].expr)
                    i += 1
                }
                // a `T` value passed to a CONCRETE-typed parameter (`f(x: a)` where `a: T`
                // and `f`'s `x: I64`) is a type error at the definition. The callee's own
                // type parameter (`f[U](x: U)`) is lenient (typesCompatible — they unify).
                val fi: U64 = self.resolvedCallee(id: exprId)
                if fi < self.arena.funcs.count() {
                    val ps: Array[Param] = self.arena.funcs[fi].params
                    mut val k: U64 = 0
                    while k < args.count() {
                        val pi: U64 = self.paramIndexForArg(params: ps, args: args, argIdx: k)
                        if pi < ps.count() {
                            if !(ps[pi].tyIsArray) {
                                self.checkGenericTypeMatch(expectedRef: ps[pi].ty, valueExpr: args[k].expr)
                            }
                        }
                        k += 1
                    }
                }
            }
            Expr.ExtMethod(val recv, srcStart: _, srcLen: _, nameStart: _, nameLen: _, val args) => {
                self.checkBoundsExpr(exprId: recv)
                mut val i: U64 = 0
                while i < args.count() {
                    self.checkBoundsExpr(exprId: args[i].expr)
                    i += 1
                }
            }
            Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
                self.checkBoundsExpr(exprId: recv)
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                self.checkBoundsRecv(recv: recv, tpFn: self.cur.checkFn)
                mut val i: U64 = 0
                while i < args.count() {
                    self.checkBoundsExpr(exprId: args[i].expr)
                    i += 1
                }
                val rt: TypeInfo = self.typeOf(id: recv)
                if rt.kind == 2 {
                    if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: rt.nameStart, len: rt.nameLen) {
                        if !(self.boundProvidesMethod(fnIdx: self.cur.checkFn, tpStart: rt.nameStart, tpLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)) {
                            self.errorAt(offset: nameStart, msg: "method not provided by the bounds of this type parameter (add a `where T: Trait` that declares it)")
                        }
                    } else {
                        if self.isSelfTypeInProvided(start: rt.nameStart, len: rt.nameLen) {
                            // a method call on `self` (Self) in a trait provided-method: Self's
                            // members are only the trait's requirements / provided methods /
                            // supertrait members (spec/08). Anything else is undefined on Self.
                            val qm: U64 = intern(c: inout self, start: nameStart, len: nameLen)
                            val selfTraitId: U64 = intern(c: inout self, start: self.arena.funcs[self.cur.checkFn].recvStart, len: self.arena.funcs[self.cur.checkFn].recvLen)
                            if !(self.traitProvidesMember(traitNameId: selfTraitId, traitArity: self.arena.funcs[self.cur.checkFn].provTraitArity, qName: qm, args: args, depth: 0U64, useMod: self.moduleOf(offset: nameStart))) {
                                self.errorAt(offset: nameStart, msg: "method not provided by this trait: a provided method's `self` (Self) can only use the trait's requirements / provided methods / supertrait members (spec/08)")
                            }
                        } else {
                        // a CONCRETE-receiver method: a `T` value passed to a concrete-typed
                        // parameter is a type error (`s.set(x: a)` where a: T, x: I64). A
                        // generic-receiver method's grounded param types are handled by the
                        // backend; here we check the non-generic-receiver case.
                        if !(self.isGenericInst(ref: rt.ref)) {
                            val mi: U64 = self.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                            if mi != self.arena.funcs.count() {
                                val mps: Array[Param] = self.arena.funcs[mi].params
                                mut val mk: U64 = 0
                                while mk < args.count() {
                                    val mpi: U64 = self.paramIndexForArg(params: mps, args: args, argIdx: mk)
                                    if mpi < mps.count() {
                                        if !(mps[mpi].tyIsArray) {
                                            self.checkGenericTypeMatch(expectedRef: mps[mpi].ty, valueExpr: args[mk].expr)
                                        }
                                    }
                                    mk += 1
                                }
                            }
                        }
                        }
                    }
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                match self.arena.exprs[base] {
                    Expr.Ident(val start, val len) => {
                        if self.identIsTypeQualifier(start: start, len: len, tpFn: self.cur.checkFn) {
                            if self.typeHasAssocFn(typeStart: start, typeLen: len, nameStart: nameStart, nameLen: nameLen) {
                                self.errorAt(offset: nameStart, msg: "an associated function declaration cannot be used as a value; wrap the call in an explicit closure (e.g. `fn(...) { return Type.name(...) }`) (spec/07)")
                            } else {
                                self.errorAt(offset: nameStart, msg: "a type name has no fields; use `Type.fn(...)` to call an associated function, or construct a value before reading fields (spec/07)")
                            }
                            return
                        }
                    }
                    _ => {}
                }
                self.checkBoundsExpr(exprId: base)
                // a field access on a type-parameter value is invalid: `T` is opaque and
                // traits declare methods, not fields, so a bound cannot grant a field
                // (spec/06). `.count()`/`.bytes()` etself. on a `T` value have no meaning.
                val bt: TypeInfo = self.typeOf(id: base)
                if bt.kind == 2 {
                    if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: bt.nameStart, len: bt.nameLen) {
                        self.errorAt(offset: nameStart, msg: "field access on a type parameter: `T` is opaque (traits declare methods, not fields) — no bound can provide a field (spec/06)")
                    }
                }
            }
            Expr.Index(val base, val index) => {
                self.checkBoundsExpr(exprId: base)
                self.checkBoundsExpr(exprId: index)
                // `x[i]` on a type-parameter value needs `where T: Index` (spec/12: the
                // subscript desugars to the Index trait).
                val ibt: TypeInfo = self.typeOf(id: base)
                if ibt.kind == 2 {
                    if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: ibt.nameStart, len: ibt.nameLen) {
                        if !(self.boundHasTraitNamed(fnIdx: self.cur.checkFn, tpStart: ibt.nameStart, tpLen: ibt.nameLen, traitName: "Index")) {
                            self.errorAt(offset: self.exprOffset(id: base), msg: "subscript `[]` on a type parameter needs a `where T: Index` bound (spec/12)")
                        }
                    }
                }
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                mut val i: U64 = 0
                while i < fields.count() {
                    self.checkBoundsExpr(exprId: fields[i].value)
                    // a `T` value placed into a CONCRETE-typed field (`<S a=valueT/>` where
                    // S.a: I64) is a type error at the definition. The field type comes from
                    // the (concrete) owner decl; a generic owner's type-param field is lenient.
                    val ft: TypeInfo = self.makeFieldType(typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: fields[i].nameStart, fieldLen: fields[i].nameLen)
                    if ft.nameLen > 0U64 {
                        mut val fref: U64 = ft.ref
                        if fref == 0U64 {
                            fref = self.simpleTypeRef(nameStart: ft.nameStart, nameLen: ft.nameLen)
                        }
                        self.checkGenericTypeMatch(expectedRef: fref, valueExpr: fields[i].value)
                    }
                    i += 1
                }
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.count() {
                    self.checkBoundsExpr(exprId: elems[i])
                    i += 1
                }
            }
            Expr.Cast(val operand, val tyStart, val tyLen, val ty) => { self.checkBoundsExpr(exprId: operand) }
            Expr.OptChain(val base, val cont) => {
                self.checkBoundsExpr(exprId: base)
                self.checkBoundsExpr(exprId: cont)
            }
            Expr.ChainHole => {}
            Expr.Try(val expr) => { self.checkBoundsExpr(exprId: expr) }
            Expr.Arrow(val base, val nameStart, val nameLen) => { self.checkBoundsExpr(exprId: base) }
            Expr.Deref(val base) => { self.checkBoundsExpr(exprId: base) }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.checkBoundsExpr(exprId: cond)
                self.checkBoundsBlock(blkId: thenBlk)
                self.checkBoundsBlock(blkId: elseBlk)
            }
            Expr.MatchExpr(val scrut, val arms) => {
                self.checkBoundsExpr(exprId: scrut)
                mut val ai: U64 = 0
                while ai < arms.count() {
                    val a: MatchArm = arms[ai]
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: self.typeOf(id: scrut))
                    self.checkBoundsBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Expr.Move(val operand, val isBorrow) => { self.checkBoundsExpr(exprId: operand) }
            Expr.Ident(val start, val len) => {
                // the same reachability-independent undefined-identifier check the
                // non-generic path runs (verifyExpr), now for EVERY module's GENERIC bodies —
                // walked here regardless of instantiation, so a dead generic's `return n`
                // (forgotten `self.`) is still caught at declaration (std included — no
                // trusted-import boundary). A named function is a callable declaration, not a
                // value. A bare type-parameter name is a valid assoc-fn receiver (`T.make()`),
                // like a type.
                // value position: a bare type / type-parameter name reaching here is NOT a
                // value (an assoc-fn receiver `T.make()` is rerouted via checkBoundsRecv) —
                // so it is an undefined-identifier misuse (`val x = SomeType`).
                if self.cur.checkFn < self.arena.funcs.count() {
                    val bindCode: I64 = self.recordIdent(id: exprId, start: start, len: len, tpFn: self.cur.checkFn)
                    if !(self.bindIsValue(code: bindCode)) {
                        if bindCode == identFnCode() {
                            self.errorAt(offset: start, msg: "a named function declaration cannot be used as a value; wrap it in an explicit closure (e.g. `fn(...) { return name(...) }`) (spec/04)")
                        } else {
                            self.errorAt(offset: start, msg: "undefined identifier: this name is not a local, parameter, or global in scope (a bare type name is valid only as an assoc-fn receiver like `Type.fn()`; a field of `self` needs `self.`) (spec/04)")
                        }
                    }
                }
            }
            _ => {}
        }
    }

    inout fn checkGenericTypeMatch(expectedRef: U64, valueExpr: U64) {
        if expectedRef == 0U64 {
            return
        }
        if self.cur.checkFn >= self.arena.funcs.count() {
            return
        }
        // an untyped numeric literal cannot flow into a type parameter / Self: `val y: T = 5`
        // is invalid — T is opaque, and no bound makes it numeric-literal-receptive (spec/06).
        if expectedRef < self.arena.types.count() {
            if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: self.arena.types[expectedRef].nameStart, len: self.arena.types[expectedRef].nameLen) || self.isSelfTypeInProvided(start: self.arena.types[expectedRef].nameStart, len: self.arena.types[expectedRef].nameLen) {
                match self.arena.exprs[valueExpr] {
                    Expr.Int(value: _, offset: _, val isBool, tyStart: _, val tyLen, isNeg: _) => {
                        if !(isBool) {
                            if tyLen == 0U64 {
                                self.errorAt(offset: self.exprOffset(id: valueExpr), msg: "cannot assign a literal to a type parameter: it is an opaque type with no numeric bound (spec/06)")
                            }
                        }
                    }
                    Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => {
                        self.errorAt(offset: self.exprOffset(id: valueExpr), msg: "cannot assign a literal to a type parameter: it is an opaque type with no numeric bound (spec/06)")
                    }
                    _ => {}
                }
            }
        }
        // a value-position if/match: each branch's `give` value must match the expected
        // type (`val x: I64 = if c { give a } else { give b }` with a: T).
        match self.arena.exprs[valueExpr] {
            Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                val tv: U64 = self.tcBlockGiveValue(blockId: thenBlk)
                if tv != 0U64 {
                    self.checkGenericTypeMatch(expectedRef: expectedRef, valueExpr: tv)
                }
                val ev: U64 = self.tcBlockGiveValue(blockId: elseBlk)
                if ev != 0U64 {
                    self.checkGenericTypeMatch(expectedRef: expectedRef, valueExpr: ev)
                }
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count() {
                    if !(arms[ai].isDiverge) {
                        if arms[ai].binds.count() == 0U64 {
                            val g: U64 = self.blockGiveExpr(blkId: arms[ai].body)
                            if g < self.arena.exprs.count() {
                                self.checkGenericTypeMatch(expectedRef: expectedRef, valueExpr: g)
                            }
                        }
                    }
                    ai += 1
                }
            }
            _ => {}
        }
        // an array literal in an `Array[E]` position: recurse element-wise (inferType
        // reports an array literal as unknown, so check each element against E).
        if expectedRef < self.arena.types.count() {
            if rangeEquals(bytes: self.arena.bytes, start: self.arena.types[expectedRef].nameStart, len: self.arena.types[expectedRef].nameLen, kw: "Array") {
                if self.arena.types[expectedRef].args.count() > 0U64 {
                    match self.arena.exprs[valueExpr] {
                        Expr.Array(val elems) => {
                            val elemRef: U64 = self.arena.types[expectedRef].args[0]
                            mut val ei: U64 = 0
                            while ei < elems.count() {
                                self.checkGenericTypeMatch(expectedRef: elemRef, valueExpr: elems[ei])
                                ei += 1
                            }
                            return
                        }
                        _ => {}
                    }
                }
            }
        }
        val inferred: U64 = self.inferType(id: valueExpr)
        if !(self.typesCompatible(expected: expectedRef, inferred: inferred)) {
            self.errorAt(offset: self.exprOffset(id: valueExpr), msg: "type mismatch in a generic body: a type parameter is a distinct opaque type, not the type required here (spec/06)")
        }
    }

    inout fn checkBoundsStmt(stmtId: U64) {
        match self.arena.stmts[stmtId] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                self.checkBoundsExpr(exprId: init)
                if tyLen > 0U64 {
                    // checkGenericTypeMatch recurses into an array literal against Array[E].
                    self.checkGenericTypeMatch(expectedRef: ty, valueExpr: init)
                    // the annotated width bounds a context-typed integer literal here too: a
                    // generic body is NOT walked by the verify literal pass (Verify/Stmt), so
                    // without this `val x: U8 = 200 + 100` would skip the constant-range check
                    // and wrap at runtime instead of being rejected (spec/12: no wraparound).
                    self.checkLitSpanCtx(id: init, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, ctxRef: ty)
                }
                self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, ty: ty, isInout: false, isMut: mutable, owned: true)
            }
            Stmt.Assign(val target, val value) => {
                self.checkBoundsExpr(exprId: target)
                self.checkBoundsExpr(exprId: value)
                // the assigned value must match the place's type (`x = a` / `x += a` where
                // x: I64 and a: T is a type error). The place type is inferType(target).
                self.checkGenericTypeMatch(expectedRef: self.inferType(id: target), valueExpr: value)
            }
            Stmt.ExprStmt(val expr) => { self.checkBoundsExpr(exprId: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                if hasValue {
                    self.checkBoundsExpr(exprId: value)
                    if self.cur.checkFn < self.arena.funcs.count() {
                        self.checkGenericTypeMatch(expectedRef: self.arena.funcs[self.cur.checkFn].retTy, valueExpr: value)
                    }
                }
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.checkBoundsExpr(exprId: cond)
                self.checkBoundsBlock(blkId: thenBlk)
                if hasElse {
                    self.checkBoundsBlock(blkId: elseBlk)
                }
            }
            Stmt.While(val cond, val body) => {
                self.checkBoundsExpr(exprId: cond)
                self.checkBoundsBlock(blkId: body)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
                val forMark: U64 = self.scopeMark()
                self.checkBoundsExpr(exprId: iter)
                if isRange {
                    self.checkBoundsExpr(exprId: rangeHi)
                    self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: 0, tyLen: 0, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    val et: TypeInfo = self.typeOf(id: iter)
                    if isStruct {
                        self.addForStructBinds(et: et, binds: binds)
                    } else {
                        if et.kind == 3 {
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                        } else {
                            // a general Iterable: the loop var is the iterator's Item type.
                            val elemTi: TypeInfo = self.iterableItemInfo(et: et)
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                        }
                    }
                }
                self.checkBoundsBlock(blkId: body)
                self.popLocals(mark: forMark)
            }
            Stmt.Match(val scrut, val arms) => {
                self.checkBoundsExpr(exprId: scrut)
                mut val ai: U64 = 0
                while ai < arms.count() {
                    val a: MatchArm = arms[ai]
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: self.typeOf(id: scrut))
                    self.checkBoundsBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Stmt.Panic(val msg, val offset) => { self.checkBoundsExpr(exprId: msg) }
            Stmt.Give(val value) => { self.checkBoundsExpr(exprId: value) }
            Stmt.Break(offset: _) => {}
            Stmt.Continue(offset: _) => {}
        }
    }

    inout fn checkBoundsBlock(blkId: U64) {
        val mark: U64 = self.scopeMark()
        val stmts: Array[U64] = self.arena.blocks[blkId].stmts
        mut val i: U64 = 0
        while i < stmts.count() {
            self.checkBoundsStmt(stmtId: stmts[i])
            i += 1
        }
        self.popLocals(mark: mark)
    }

    inout fn checkGenericBodies() {
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            // skip extern fns: they have no body (`body == 0` is a sentinel, not a real
            // block). Generic externs like `arrayPush[T]` would otherwise have block 0
            // (some unrelated function's body) walked under their own bound-less type
            // params, mis-flagging method calls inside it.
            // walk generic templates (any module — bound checks), and trait
            // provided-method templates (`pub impl Trait { fn m() {...} }` — Self abstract):
            // a dead provided method (no conforming type, so no concrete copy is verified)
            // would otherwise escape all checks. Every module is walked (std included — no
            // trusted-import boundary).
            mut val shouldCheck: Bool = false
            if f.typeParams.count() > 0 {
                shouldCheck = true
            }
            if self.methodRecvIsTrait(f: f) {
                shouldCheck = true
            }
            // a provided-method COPY on a conforming type (srcTraitId != 0, generated by
            // instantiateProvidedMethods) is NOT re-checked: spec/08 type-checks a provided
            // method body ONCE against the trait's abstract interface (the `impl Trait { }`
            // template, walked above), so re-checking each conformer's copy would re-derive
            // its associated types per conformance (`Item = (index: U64, value: E)` for
            // EnumerateIter) and false-positive. The template carries the real check.
            if f.srcTraitId != 0U64 {
                shouldCheck = false
            }
            if shouldCheck && !f.isExtern {
                val noParams: Array[Bind] = []
                val noArgs: Array[U64] = []
                self.cur.locals = []
                self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: f))
                self.cur.hasRecv = f.hasRecv
                self.cur.recvStart = f.recvStart
                self.cur.recvLen = f.recvLen
                self.cur.extId = f.extId
                self.cur.selfInout = f.selfInout
                self.cur.recvInstRef = 0
                self.cur.typeParams = noParams
                self.cur.typeArgs = noArgs
                self.cur.checkFn = fi
                mut val pi: U64 = 0
                while pi < f.params.count() {
                    val p: Param = f.params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    pi += 1
                }
                self.checkBoundsBlock(blkId: f.body)
            }
            fi += 1
        }
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.checkFn = self.arena.funcs.count()
    }
}
