// Part of compile-time checks (root: _.pw): trait-requirement and overload
// collision detection.

// Whether two parameter lists have the same label sequence (arity + labels) —
// the "selector" minus types. Used to detect a generic/concrete overload clash.

pub impl Comp {
    inout fn sameLabels(a: Array[Param], b: Array[Param]) -> Bool {
        if a.count() != b.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.count() {
            if a[i].nameId != b[i].nameId {
                return false
            }
            if a[i].noLabel != b[i].noLabel {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn paramTypesEqual(a: Array[Param], b: Array[Param]) -> Bool {
        if a.count() != b.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.count() {
            if a[i].tyIsArray != b[i].tyIsArray {
                return false
            }
            if intern(c: inout self, start: a[i].tyStart, len: a[i].tyLen) != intern(c: inout self, start: b[i].tyStart, len: b[i].tyLen) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn checkDuplicateTraitReqs() {
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val reqs: Array[Func] = self.decls.traits[ti].reqs
            mut val a: U64 = 0
            while a < reqs.count() {
                mut val b: U64 = a + 1U64
                while b < reqs.count() {
                    if reqs[a].nameId == reqs[b].nameId {
                        if self.sameLabels(a: reqs[a].params, b: reqs[b].params) {
                            if self.paramTypesEqual(a: reqs[a].params, b: reqs[b].params) {
                                self.errorAt(offset: reqs[b].nameStart, msg: "duplicate trait requirement: another requirement has the same name, labels, and parameter types (spec/08)")
                            }
                        }
                    }
                    b += 1U64
                }
                a += 1U64
            }
            ti += 1U64
        }
    }

    inout fn methodWitnessesAConformance(recvStart: U64, recvLen: U64, mStart: U64, mLen: U64) -> Bool {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qM: U64 = intern(c: inout self, start: mStart, len: mLen)
        mut val ci: U64 = 0
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.typeId == qRecv {
                mut val ti: U64 = 0
                while ti < self.decls.traits.count() {
                    val tr: TraitDef = self.decls.traits[ti]
                    if tr.nameId == cf.traitId {
                        mut val ri: U64 = 0
                        while ri < tr.reqs.count() {
                            if tr.reqs[ri].nameId == qM {
                                return true
                            }
                            ri += 1
                        }
                    }
                    ti += 1
                }
            }
            ci += 1
        }
        return false
    }

    inout fn sameSelector(a: Func, b: Func) -> Bool {
        if a.nameId != b.nameId {
            return false
        }
        if a.params.count() != b.params.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.params.count() {
            if a.params[i].noLabel != b.params[i].noLabel {
                return false
            }
            if !(a.params[i].noLabel) {
                if a.params[i].nameId != b.params[i].nameId {
                    return false
                }
            }
            i += 1
        }
        return true
    }

}
