// Part of compile-time checks (root: _.pw): trait-requirement and overload
// collision detection.

// Whether two parameter lists have the same label sequence (arity + labels) —
// the "selector" minus types. Used to detect a generic/concrete overload clash.

pub impl Comp {
    // Memberwise constructors have no executable Func, but expose an ordinary
    // callable signature. Compare that signature with custom anonymous factories
    // using the same receiver/default-argument unification as registration.
    inout fn checkMemberwiseFactoryCollisions() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.arena.functionCount() {
            val function = self.arena.functionAt(index: index)
            if function.isAnonymousFactory && !function.isProvided && function.extId == 0U64 && function.srcTraitId == 0U64 {
                val declaration = self.structIndexForType(ref: function.recvTy)
                if declaration < self.arena.structCount() {
                    val structure = self.arena.structAt(index: declaration)
                    if !structure.isExtern && !structure.isCExtern {
                        mut val parameters: Array[Param] = []
                        for field in structure.fields {
                            val term = (try self.fieldTypeRefOfReceiver(receiverRef: function.recvTy, fieldStart: field.nameStart, fieldLen: field.nameLen))
                            val info = self.typeInfoOfRef(ref: term)
                            parameters.append(<Param nameStart=field.nameStart nameLen=field.nameLen nameId=field.nameId tyStart=info.nameStart tyLen=info.nameLen tyIsArray=info.kind == 3I64 ty=term isInout=false isMove=false isBorrow=false noLabel=false hasDefault=field.hasDefault defaultExpr=field.defaultVal />)
                        }
                        val memberwise = <Func nameStart=function.nameStart nameLen=function.nameLen nameId=function.nameId recvTy=function.recvTy typeParams=function.typeParams params=self.pushFuncParams(params: parameters) hasRet=true retStart=structure.nameStart retLen=structure.nameLen retIsArray=false retTy=function.recvTy body=0U64 hasRecv=false recvStart=function.recvStart recvLen=function.recvLen selfInout=false selfMove=false isAssoc=true isAsync=false isExtern=false />
                        if self.callableFormsMayOverlap(a: function, b: memberwise) {
                            return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "anonymous factory overlaps the implicit memberwise factory (spec/05,07)") />
                        }
                    }
                }
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn sameLabels(a: FuncParamRange, b: FuncParamRange) -> Bool {
        if a.count() != b.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.count() {
            if self.funcParamAt(params: a, index: i).nameId != self.funcParamAt(params: b, index: i).nameId {
                return false
            }
            if self.funcParamAt(params: a, index: i).noLabel != self.funcParamAt(params: b, index: i).noLabel {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn paramTypesEqual(a: FuncParamRange, b: FuncParamRange) -> Bool {
        if a.count() != b.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.count() {
            val ap: Param = self.funcParamAt(params: a, index: i)
            val bp: Param = self.funcParamAt(params: b, index: i)
            if ap.tyIsArray != bp.tyIsArray {
                return false
            }
            if intern(c: inout self, start: ap.tyStart, len: ap.tyLen) != intern(c: inout self, start: bp.tyStart, len: bp.tyLen) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn checkDuplicateTraitReqs() -> Result[(), CompileDiagnostic] {
        mut val ti: U64 = 0
        while ti < self.decls.traitCount() {
            val reqs: Array[Func] = self.copyTraitReqs(reqs: self.decls.traitAt(index: ti).reqs)
            mut val a: U64 = 0
            while a < reqs.count() {
                mut val b: U64 = a + 1U64
                while b < reqs.count() {
                    if reqs[a].nameId == reqs[b].nameId {
                        if self.sameLabels(a: reqs[a].params, b: reqs[b].params) {
                            if self.paramTypesEqual(a: reqs[a].params, b: reqs[b].params) {
                                return <Result.Err error=self.diagnosticAt(offset: reqs[b].nameStart, msg: "duplicate trait requirement: another requirement has the same name, labels, and parameter types (spec/08)") />
                            }
                        }
                    }
                    b += 1U64
                }
                a += 1U64
            }
            ti += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn methodWitnessesAConformance(recvStart: U64, recvLen: U64, mStart: U64, mLen: U64) -> Bool {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qM: U64 = intern(c: inout self, start: mStart, len: mLen)
        mut val ci: U64 = 0
        while ci < self.decls.conformCount() {
            val cf: Conform = self.decls.conformAt(index: ci)
            if cf.typeId == qRecv {
                mut val ti: U64 = 0
                while ti < self.decls.traitCount() {
                    val tr: TraitDef = self.decls.traitAt(index: ti)
                    if tr.nameId == cf.traitId {
                        mut val ri: U64 = 0
                        while ri < tr.reqs.count() {
                            if self.traitReqAt(reqs: tr.reqs, index: ri).nameId == qM {
                                return true
                            }
                            ri += 1
                        }
                    }
                    ti += 1
                }
            }
            ci += 1
        }
        return false
    }

    inout fn sameSelector(a: Func, b: Func) -> Bool {
        if a.nameId != b.nameId {
            return false
        }
        if a.params.count() != b.params.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.params.count() {
            if self.funcParamAt(params: a.params, index: i).noLabel != self.funcParamAt(params: b.params, index: i).noLabel {
                return false
            }
            if !(self.funcParamAt(params: a.params, index: i).noLabel) {
                if self.funcParamAt(params: a.params, index: i).nameId != self.funcParamAt(params: b.params, index: i).nameId {
                    return false
                }
            }
            i += 1
        }
        return true
    }

}
