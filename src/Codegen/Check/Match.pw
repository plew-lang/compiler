// Part of compile-time checks (root: _.pw): match-pattern binding
// validation.

// Validate one match arm's pattern field names against the actual variant/struct
// fields. Skips wildcard arms and arms whose enum/struct/variant is not found (a
// separate concern — e.g. a match on a type parameter).

pub impl Comp {
    // Resolve the authored qualifier in its lexical module before recording
    // variant/layout facts. Subject spelling must never repair a missing name.
    inout fn checkEnumPatternSubject(scrut: U64, pattern: PatInfo) -> Result[(), CompileDiagnostic] {
        if pattern.isWildcard || pattern.isStruct || pattern.isValuePattern { return <Result.Ok value=() /> }
        val declaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: pattern.enumStart), start: pattern.enumStart, len: pattern.enumLen)
        if declaration.nameLen == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: pattern.enumStart, msg: "unknown or inaccessible enum type in pattern") />
        }
        val enumIndex = self.arena.enumIndexByOffset(offset: declaration.nameStart)
        if enumIndex >= self.arena.enumCount() {
            return <Result.Err error=self.diagnosticAt(offset: pattern.enumStart, msg: "variant pattern requires an enum type") />
        }
        val variant = self.variantIndexInDeclaration(enumIndex: enumIndex, nameStart: pattern.variantStart, nameLen: pattern.variantLen)
        if variant >= self.arena.enumAt(index: enumIndex).variants.count() {
            return <Result.Err error=self.diagnosticAt(offset: pattern.variantStart, msg: "unknown variant: this enum has no such variant") />
        }
        // A non-completing subject has no value to match, but authored names
        // and variants above still obey the ordinary source visibility rules.
        if !self.exprCompletesNormally(exprId: scrut) { return <Result.Ok value=() /> }
        val subject = self.lexicalLayoutReceiver(receiverTerm: self.parametricExprTerm(exprId: scrut))
        val subjectEnum = self.enumIndexForType(ref: subject)
        if subjectEnum < self.arena.enumCount() && subjectEnum != enumIndex {
            return <Result.Err error=self.diagnosticAt(offset: pattern.enumStart, msg: "this match arm pattern is a variant of a different enum than the value being matched") />
        }
        if subjectEnum != enumIndex {
            return <Result.Err error=self.diagnosticAt(offset: pattern.enumStart, msg: "enum pattern type does not match the value being matched") />
        }
        return <Result.Ok value=() />
    }

    inout fn warnUnreachableArm(arm: MatchArm) {
        if arm.offset == 0U64 || self.reportedUnreachableArms.contains(arm.offset) { return }
        self.reportedUnreachableArms.insert(arm.offset)
        val message = if arm.orGroup == 0U64 { give "unreachable match arm: earlier patterns already cover it (spec/11)" } else { give "unreachable match alternative: earlier patterns already cover it (spec/11)" }
        val location = self.diagnosticAt(offset: arm.offset, msg: message)
        self.pendingDiagnostics.append(<CompileDiagnostic severity=<DiagnosticSeverity.Warning /> location=location.location message=location.message />)
    }

    // Coverage is structural: arbitrary Eq calls (including repeated reads of
    // the same existing value) neither cover variants nor erase later effects.
    inout fn recordMatchCoverage(scrut: U64, arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        val term = self.semanticExprTerm(exprId: scrut)
        val enumIndex = self.enumIndexForType(ref: self.lexicalLayoutReceiver(receiverTerm: term))
        val boolName = self.kwSpan(kw: "Bool", kwLen: 4U64)
        val isBool = self.typeRefEq(a: term, b: self.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen))
        mut val positiveIntegers: Set[U64] = Set.new()
        mut val negativeIntegers: Set[U64] = Set.new()
        mut val strings: Array[Array[U8]] = []
        mut val variants: Set[U64] = Set.new()
        mut val allCovered = false
        mut val sawTrue = false
        mut val sawFalse = false
        mut val index = 0U64
        while index < arms.len {
            val arm = self.matchArmAt(arms: arms, index: index)
            mut val unreachable = allCovered || (isBool && sawTrue && sawFalse)
            if enumIndex < self.arena.enumCount() && variants.count() == self.arena.enumAt(index: enumIndex).variants.count() { unreachable = true }
            if arm.isWildcard || arm.isStruct {
                allCovered = true
            } else if arm.isValuePattern {
                match self.arena.exprs[arm.valueExpr] {
                    Expr.Int(val value, offset: _, val isBool, tyStart: _, tyLen: _, val isNeg) => {
                        if isBool {
                            if value == 0U64 { if sawFalse { unreachable = true } sawFalse = true }
                            if value == 1U64 { if sawTrue { unreachable = true } sawTrue = true }
                        } else if isNeg && value != 0U64 {
                            if negativeIntegers.contains(value) { unreachable = true }
                            negativeIntegers.insert(value)
                        } else {
                            if positiveIntegers.contains(value) { unreachable = true }
                            positiveIntegers.insert(value)
                        }
                    }
                    Expr.Str(val start, val len) => {
                        // Decode once using the same bytes consumed by LLVM;
                        // distinct escape spellings can denote the same value.
                        try self.prepareStringLiteral(start: start, len: len)
                        val bytes = self.decodedStringLiterals.at(key: start)
                        for val previous in strings {
                            if self.matchLiteralBytesEqual(first: previous, second: bytes) { unreachable = true }
                        }
                        if !unreachable { strings.append(bytes) }
                    }
                    _ => {}
                }
            } else if enumIndex < self.arena.enumCount() {
                val variant = self.variantIndexInDeclaration(enumIndex: enumIndex, nameStart: arm.variantStart, nameLen: arm.variantLen)
                if variant < self.arena.enumAt(index: enumIndex).variants.count() {
                    if variants.contains(variant) { unreachable = true }
                    variants.insert(variant)
                }
            }
            if unreachable {
                self.unreachableMatchArms.insert(arms.start + index)
                if self.cur.recordCallTemplates { self.warnUnreachableArm(arm: arm) }
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkArmBinds(a: MatchArm) -> Result[(), CompileDiagnostic] {
        return self.checkPatternBinds(a: self.patternInfo(arm: a))
    }

    inout fn checkPatternBinds(a: PatInfo) -> Result[(), CompileDiagnostic] {
        if a.isWildcard || a.isValuePattern {
            return <Result.Ok value=() />
        }
        val identity = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: a.enumStart), start: a.enumStart, len: a.enumLen)
        if identity.nameLen == 0U64 { return <Result.Ok value=() /> }
        if a.isStruct {
            val si: U64 = self.arena.structIndexByOffset(offset: identity.nameStart)
            if si < self.arena.structCount() {
                try self.checkBindsInFields(binds: a.binds, fields: self.arena.structAt(index: si).fields, ownerModule: self.moduleOf(offset: identity.nameStart))
            }
            return <Result.Ok value=() />
        }
        val ei: U64 = self.arena.enumIndexByOffset(offset: identity.nameStart)
        if ei >= self.arena.enumCount() {
            return <Result.Ok value=() />
        }
        val variants: Array[Variant] = self.arena.enumAt(index: ei).variants
        val qVar: U64 = intern(c: inout self, start: a.variantStart, len: a.variantLen)
        mut val vi: U64 = 0
        while vi < variants.count() {
            if variants[vi].nameId == qVar {
                try self.checkBindsInFields(binds: a.binds, fields: variants[vi].fields)
                return <Result.Ok value=() />
            }
            vi += 1
        }
        return <Result.Ok value=() />
    }

    // Or alternatives retain their source group until their binding types
    // are known. Executing a shared body is not a substitute for this check.
    inout fn checkOrPatternTypes(arms: MatchArmRange, scrut: U64) -> Result[(), CompileDiagnostic] {
        mut val group = 0U64
        mut val expected: Array[PatternBindingType] = []
        mut val index = 0U64
        while index < arms.len {
            val arm = self.matchArmAt(arms: arms, index: index)
            if arm.orGroup != 0U64 {
                val mark = self.scopeMark()
                val subject = self.semanticExprTypeInfo(exprId: scrut)
                try self.scanAddArmBinds(a: arm, scrutTi: subject)
                mut val bindings: Array[PatternBindingType] = []
                if arm.captureLen != 0U64 {
                    bindings.append(<PatternBindingType nameId=intern(c: inout self, start: arm.captureStart, len: arm.captureLen) term=self.typedIrRefOfInfo(ti: subject) isMutable=arm.captureMutable />)
                }
                mut val bindingIndex = 0U64
                while bindingIndex < arm.binds.len {
                    val binding = self.bindAt(binds: arm.binds, index: bindingIndex)
                    if binding.nameLen != 0U64 {
                        val local = try self.typedLocal(index: self.localIndexByName(start: binding.nameStart, len: binding.nameLen))
                        bindings.append(<PatternBindingType nameId=intern(c: inout self, start: binding.nameStart, len: binding.nameLen) term=local.ty isMutable=binding.isMutable />)
                    }
                    bindingIndex += 1U64
                }
                self.popLocals(mark: mark)
                if group != arm.orGroup {
                    group = arm.orGroup
                    expected = bindings
                } else {
                    if expected.count() != bindings.count() {
                        return <Result.Err error=self.diagnosticAt(offset: arm.orGroup - 1U64, msg: "or-pattern alternatives must bind the same names and types, with matching mutability (spec/11)") />
                    }
                    for val wanted in expected {
                        mut val found = false
                        for val actual in bindings {
                            if wanted.nameId == actual.nameId && wanted.isMutable == actual.isMutable && self.typeRefEq(a: wanted.term, b: actual.term) { found = true }
                        }
                        if !found { return <Result.Err error=self.diagnosticAt(offset: arm.orGroup - 1U64, msg: "or-pattern alternatives must bind the same names and types, with matching mutability (spec/11)") /> }
                    }
                }
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkMatchArmBinds(arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < arms.len {
            try self.checkArmBinds(a: self.matchArmAt(arms: arms, index: index))
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkMatchBinds() -> Result[(), CompileDiagnostic] {
        mut val si: U64 = 0
        while si < self.arena.stmts.count() {
            match self.arena.stmts[si] {
                Stmt.Match(val scrut, val arms) => {
                    try self.checkMatchArmBinds(arms: arms)
                }
                _ => {}
            }
            si += 1
        }
        mut val xi: U64 = 0
        while xi < self.arena.exprs.count() {
            match self.arena.exprs[xi] {
                Expr.MatchExpr(val scrut, val arms) => {
                    try self.checkMatchArmBinds(arms: arms)
                }
                _ => {}
            }
            xi += 1
        }
        return <Result.Ok value=() />
    }

    // Literal identity is byte equality, independent of user-defined Eq witnesses.
    fn matchLiteralBytesEqual(first: Array[U8], second: Array[U8]) -> Bool {
        if first.count() != second.count() { return false }
        mut val index = 0U64
        while index < first.count() {
            if first[index] != second[index] { return false }
            index += 1U64
        }
        return true
    }
}
