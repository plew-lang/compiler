// Part of compile-time checks (root: _.pw): match-pattern binding
// validation.

// Validate one match arm's pattern field names against the actual variant/struct
// fields. Skips wildcard arms and arms whose enum/struct/variant is not found (a
// separate concern — e.g. a match on a type parameter).

pub impl Comp {
    inout fn checkArmBinds(a: MatchArm) -> Result[(), CompileDiagnostic] {
        return self.checkPatternBinds(a: self.patternInfo(arm: a))
    }

    inout fn checkPatternBinds(a: PatInfo) -> Result[(), CompileDiagnostic] {
        if a.isWildcard {
            return <Result.Ok value=() />
        }
        val identity = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: a.enumStart), start: a.enumStart, len: a.enumLen)
        if identity.nameLen == 0U64 { return <Result.Ok value=() /> }
        if a.isStruct {
            val si: U64 = self.arena.structIndexByOffset(offset: identity.nameStart)
            if si < self.arena.structCount() {
                try self.checkBindsInFields(binds: a.binds, fields: self.arena.structAt(index: si).fields, ownerModule: self.moduleOf(offset: identity.nameStart))
            }
            return <Result.Ok value=() />
        }
        val ei: U64 = self.arena.enumIndexByOffset(offset: identity.nameStart)
        if ei >= self.arena.enumCount() {
            return <Result.Ok value=() />
        }
        val variants: Array[Variant] = self.arena.enumAt(index: ei).variants
        val qVar: U64 = intern(c: inout self, start: a.variantStart, len: a.variantLen)
        mut val vi: U64 = 0
        while vi < variants.count() {
            if variants[vi].nameId == qVar {
                try self.checkBindsInFields(binds: a.binds, fields: variants[vi].fields)
                return <Result.Ok value=() />
            }
            vi += 1
        }
        return <Result.Ok value=() />
    }

    // Or alternatives retain their source group until their binding types
    // are known. Executing a shared body is not a substitute for this check.
    inout fn checkOrPatternTypes(arms: MatchArmRange, scrut: U64) -> Result[(), CompileDiagnostic] {
        mut val group = 0U64
        mut val expected: Array[PatternBindingType] = []
        mut val index = 0U64
        while index < arms.len {
            val arm = self.matchArmAt(arms: arms, index: index)
            if arm.orGroup != 0U64 {
                val mark = self.scopeMark()
                val subject = self.semanticExprTypeInfo(exprId: scrut)
                try self.scanAddArmBinds(a: arm, scrutTi: subject)
                mut val bindings: Array[PatternBindingType] = []
                if arm.captureLen != 0U64 {
                    bindings.append(<PatternBindingType nameId=intern(c: inout self, start: arm.captureStart, len: arm.captureLen) term=self.typedIrRefOfInfo(ti: subject) isMutable=arm.captureMutable />)
                }
                mut val bindingIndex = 0U64
                while bindingIndex < arm.binds.len {
                    val binding = self.bindAt(binds: arm.binds, index: bindingIndex)
                    if binding.nameLen != 0U64 {
                        val local = try self.typedLocal(index: self.localIndexByName(start: binding.nameStart, len: binding.nameLen))
                        bindings.append(<PatternBindingType nameId=intern(c: inout self, start: binding.nameStart, len: binding.nameLen) term=local.ty isMutable=binding.isMutable />)
                    }
                    bindingIndex += 1U64
                }
                self.popLocals(mark: mark)
                if group != arm.orGroup {
                    group = arm.orGroup
                    expected = bindings
                } else {
                    if expected.count() != bindings.count() {
                        return <Result.Err error=self.diagnosticAt(offset: arm.orGroup - 1U64, msg: "or-pattern alternatives must bind the same names and types, with matching mutability (spec/11)") />
                    }
                    for val wanted in expected {
                        mut val found = false
                        for val actual in bindings {
                            if wanted.nameId == actual.nameId && wanted.isMutable == actual.isMutable && self.typeRefEq(a: wanted.term, b: actual.term) { found = true }
                        }
                        if !found { return <Result.Err error=self.diagnosticAt(offset: arm.orGroup - 1U64, msg: "or-pattern alternatives must bind the same names and types, with matching mutability (spec/11)") /> }
                    }
                }
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkMatchArmBinds(arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < arms.len {
            try self.checkArmBinds(a: self.matchArmAt(arms: arms, index: index))
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkMatchBinds() -> Result[(), CompileDiagnostic] {
        mut val si: U64 = 0
        while si < self.arena.stmts.count() {
            match self.arena.stmts[si] {
                Stmt.Match(val scrut, val arms) => {
                    try self.checkMatchArmBinds(arms: arms)
                }
                _ => {}
            }
            si += 1
        }
        mut val xi: U64 = 0
        while xi < self.arena.exprs.count() {
            match self.arena.exprs[xi] {
                Expr.MatchExpr(val scrut, val arms) => {
                    try self.checkMatchArmBinds(arms: arms)
                }
                _ => {}
            }
            xi += 1
        }
        return <Result.Ok value=() />
    }
}
