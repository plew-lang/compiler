// Part of compile-time checks (root: _.pw): match-pattern binding
// validation.

// Validate one match arm's pattern field names against the actual variant/struct
// fields. Skips wildcard arms and arms whose enum/struct/variant is not found (a
// separate concern — e.g. a match on a type parameter).

pub impl Comp {
    inout fn checkArmBinds(a: MatchArm) -> Result[(), CompileDiagnostic] {
        if a.isWildcard {
            return <Result.Ok value=() />
        }
        if a.isStruct {
            val si: U64 = self.structIndexByName(start: a.enumStart, len: a.enumLen)
            if si < self.arena.structCount() {
                try self.checkBindsInFields(binds: a.binds, fields: self.arena.structAt(index: si).fields)
            }
            return <Result.Ok value=() />
        }
        val ei: U64 = self.enumIndexByName(start: a.enumStart, len: a.enumLen)
        if ei >= self.arena.enumCount() {
            return <Result.Ok value=() />
        }
        val variants: Array[Variant] = self.arena.enumAt(index: ei).variants
        val qVar: U64 = intern(c: inout self, start: a.variantStart, len: a.variantLen)
        mut val vi: U64 = 0
        while vi < variants.count() {
            if variants[vi].nameId == qVar {
                try self.checkBindsInFields(binds: a.binds, fields: variants[vi].fields)
                return <Result.Ok value=() />
            }
            vi += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkMatchBinds() -> Result[(), CompileDiagnostic] {
        mut val si: U64 = 0
        while si < self.arena.stmts.count() {
            match self.arena.stmts[si] {
                Stmt.Match(val scrut, val arms) => {
                    mut val ai: U64 = 0
                    while ai < arms.len {
                        try self.checkArmBinds(a: self.matchArmAt(arms: arms, index: ai))
                        ai += 1
                    }
                }
                _ => {}
            }
            si += 1
        }
        mut val xi: U64 = 0
        while xi < self.arena.exprs.count() {
            match self.arena.exprs[xi] {
                Expr.MatchExpr(val scrut, val arms) => {
                    mut val ai: U64 = 0
                    while ai < arms.len {
                        try self.checkArmBinds(a: self.matchArmAt(arms: arms, index: ai))
                        ai += 1
                    }
                }
                _ => {}
            }
            xi += 1
        }
        return <Result.Ok value=() />
    }
}
