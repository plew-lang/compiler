// Part of compile-time checks (root: _.pw): import and use-site visibility
// constraints.

// Is `(nameStart,nameLen)` the name of an published declaration (spec/15)? Matched
// by text against the recorded export name spans (across all loaded modules).

pub impl Comp {
    inout fn moduleBindingFromOrigin(origin: ImportOrigin, requirePublic: Bool = true) -> ModuleBinding {
        if origin.isNamespace { return <ModuleBinding.Namespace moduleId=origin.targetModule /> }
        return self.moduleBindingFromSurface(moduleId: origin.targetModule, nameStart: origin.sourceStart, nameLen: origin.sourceLength, requirePublic: requirePublic)
    }

    inout fn moduleBindingFromSurface(moduleId: U64, nameStart: U64, nameLen: U64, requirePublic: Bool = true) -> ModuleBinding {
        if requirePublic && !self.isExportedFromModule(mod: moduleId, nameStart: nameStart, nameLen: nameLen) {
            return <ModuleBinding.Missing />
        }
        val nameId = intern(c: inout self, start: nameStart, len: nameLen)
        val index = self.modules.firstReExportOriginNamed(moduleId: moduleId, nameId: nameId)
        if index < self.modules.reExportOriginCount() {
            return self.moduleBindingFromOrigin(origin: self.modules.reExportOriginAt(index: index), requirePublic: requirePublic)
        }
        return <ModuleBinding.Declaration moduleId=moduleId nameStart=nameStart nameLen=nameLen />
    }

    inout fn moduleBindingAt(nameStart: U64, nameLen: U64, requirePublic: Bool = true) -> ModuleBinding {
        val qualified = self.modules.qualifiedUseIndex(offset: nameStart)
        if qualified < self.modules.qualifiedUseCount() {
            return self.moduleBindingFromOrigin(origin: self.modules.qualifiedUseAt(index: qualified), requirePublic: requirePublic)
        }
        val moduleId = self.moduleOf(offset: nameStart)
        val nameId = intern(c: inout self, start: nameStart, len: nameLen)
        val index = self.modules.firstImportOriginNamed(moduleId: moduleId, nameId: nameId)
        if index < self.modules.importOriginCount() {
            return self.moduleBindingFromOrigin(origin: self.modules.importOriginAt(index: index), requirePublic: requirePublic)
        }
        return <ModuleBinding.Declaration moduleId=moduleId nameStart=nameStart nameLen=nameLen />
    }

    inout fn sameModuleBinding(left: ModuleBinding, right: ModuleBinding) -> Bool {
        match left {
            ModuleBinding.Namespace(val moduleId) => {
                match right { ModuleBinding.Namespace(moduleId: val other) => { return moduleId == other } _ => {} }
            }
            ModuleBinding.Declaration(val moduleId, val nameStart, val nameLen) => {
                match right {
                    ModuleBinding.Declaration(moduleId: val other, nameStart: val start, nameLen: val len) => {
                        return moduleId == other && spansEqual(c: inout self, aStart: nameStart, aLen: nameLen, bStart: start, bLen: len)
                    }
                    _ => {}
                }
            }
            ModuleBinding.Missing => {}
        }
        return false
    }

    inout fn importedDeclIdentityFromSurface(surfaceMod: U64, start: U64, len: U64) -> Bind {
        val ty: Bind = self.typeDeclIdentityFromSurface(surfaceMod: surfaceMod, start: start, len: len)
        if ty.nameLen != 0U64 { return ty }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = 0U64
        while i < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: i)
            if !(f.hasRecv || f.isAssoc) && f.nameId == qId && self.funcDeclModule(f: f) == surfaceMod {
                return <Bind nameStart=f.defOffset nameLen=1 fieldStart=0 fieldLen=0 />
            }
            i += 1U64
        }
        i = 0U64
        while i < self.modules.reExportOriginCount() {
            val o: ImportOrigin = self.modules.reExportOriginAt(index: i)
            if o.localModule == surfaceMod {
                if spansEqual(c: inout self, aStart: o.localStart, aLen: o.localLength, bStart: start, bLen: len) {
                    return self.importedDeclIdentityFromSurface(surfaceMod: o.targetModule, start: o.sourceStart, len: o.sourceLength)
                }
            }
            i += 1U64
        }
        return <Bind nameStart=surfaceMod nameLen=1 fieldStart=start fieldLen=len />
    }

    inout fn isExportedName(nameStart: U64, nameLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports.at(index: i)
            if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: nameStart, bLen: nameLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // Is `(nameStart,nameLen)` exported BY the specific module `mod` (spec/15)? Unlike
    // `isExportedName` (which asks "does SOME module export this text"), this pins the
    // exporting module: an export entry's `nameStart` is the exported decl's real source
    // offset (free fn / global / newtype / re-export name all keep their original offset —
    // only struct/enum names are re-interned, and those go through type visibility, not
    // this free-fn path), so `moduleOf(e.nameStart)` recovers the module that exported it.
    // This is the (name, module) pairing that keeps a private same-named decl in another
    // module from riding an unrelated module's export of the same text.
    inout fn isExportedFromModule(mod: U64, nameStart: U64, nameLen: U64) -> Bool {
        mut val i: U64 = self.modules.exports.firstIn(moduleId: mod)
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports.at(index: i)
            if self.exportEntrySurfaceModule(e: e) == mod {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: nameStart, bLen: nameLen) {
                    return true
                }
            }
            i = self.modules.exports.nextIn(index: i)
        }
        return false
    }

    // Every imported binding must exist on its selected module's public
    // surface. Re-export chains use the same query as qualified call resolution.
    inout fn checkImports() -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0
        while i < self.modules.importOriginCount() {
            val origin = self.modules.importOriginAt(index: i)
            match self.moduleBindingFromOrigin(origin: origin) {
                ModuleBinding.Missing => {
                    return <Result.Err error=self.diagnosticAt(offset: origin.sourceStart, msg: "imported name is not exported by the specified module (declare it `pub` in that module)") />
                }
                _ => {}
            }
            i += 1U64
        }
        i = 0U64
        while i < self.modules.qualifiedUseCount() {
            val origin = self.modules.qualifiedUseAt(index: i)
            match self.moduleBindingFromOrigin(origin: origin) {
                ModuleBinding.Missing => {
                    return <Result.Err error=self.diagnosticAt(offset: origin.localStart, msg: "name is not public in the specified namespace") />
                }
                _ => {}
            }
            i += 1U64
        }
        // `with { name }` introduces a flat local binding.  Two distinct
        // import origins under the same local spelling have no provenance at a
        // bare call site, so require an explicit `as` before resolver lookup.
        i = 0U64
        while i < self.modules.importOriginCount() {
            val a: ImportOrigin = self.modules.importOriginAt(index: i)
            mut val j: U64 = 0U64
            while j < i {
                val b: ImportOrigin = self.modules.importOriginAt(index: j)
                if a.localModule == b.localModule {
                    if spansEqual(c: inout self, aStart: a.localStart, aLen: a.localLength, bStart: b.localStart, bLen: b.localLength) {
                        val left = self.moduleBindingFromOrigin(origin: a)
                        val right = self.moduleBindingFromOrigin(origin: b)
                        if !self.sameModuleBinding(left: left, right: right) {
                            return <Result.Err error=self.diagnosticAt(offset: a.localStart, msg: "duplicate flat import name from distinct modules; use `as` to preserve the import source (spec/15)") />
                        }
                    }
                }
                j += 1U64
            }
            i += 1U64
        }
        return <Result.Ok value=() />
    }

    // Was the name `(nameStart,nameLen)` imported into module `mod` via `import … with`?
    inout fn isImportedInto(mod: U64, nameStart: U64, nameLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.imports.count() {
            val im: Bind = self.modules.imports[i]
            if im.fieldStart == mod {
                if spansEqual(c: inout self, aStart: im.nameStart, aLen: im.nameLen, bStart: nameStart, bLen: nameLen) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Use-site diagnostic arm of scoped resolution (spec/15). Selection is already scoped
    // (`findFunc` only returns a callee visible from the call's module = same module, or
    // imported+exported). This pass turns the *failure* to resolve in scope into a good
    // error: if a free fn of this name exists in ANOTHER loaded module, the use needs an
    // import. A same-module match (e.g. wrong labels, reported elsewhere) or no match at
    // all (local / closure / builtin) is left alone — except `@Std` intrinsics the backend
    // intercepts by raw name (print / write / exit / …), which are not ambient and must be
    // imported too. Types are scoped separately (their resolution sites); member/method
    // visibility is a separate axis.
    inout fn checkUseVisibility() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.arena.exprs.count() {
            try self.checkExpressionVisibility(exprId: index)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkExpressionVisibility(exprId: U64) -> Result[(), CompileDiagnostic] {
        match self.arena.exprs[exprId] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val useMod: U64 = self.moduleOf(offset: nameStart)
                // The name is in scope iff some free fn of this name is visible from the
                // call's module (scoped resolution). If so, any remaining mismatch is an
                // overload/label/type error reported elsewhere — not a visibility issue.
                if self.firstVisibleFuncByName(useMod: useMod, nameStart: nameStart, nameLen: nameLen) >= self.arena.functionCount() {
                    if self.firstFuncByName(nameStart: nameStart, nameLen: nameLen) < self.arena.functionCount() {
                        // a free fn of this name exists only in other (loaded) modules and
                        // was not imported here — the use needs an import.
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "use of a function from another module without importing it (add `import … with { … }`)") />
                    } else {
                        // no free fn of this name anywhere: a local/closure/builtin, or an
                        // `@Std` intrinsic the backend intercepts by raw name (print /
                        // write / exit / …). The latter is NOT ambient (spec/15: only lang
                        // items are) and must be imported.
                        if self.isAmbientInterceptedName(start: nameStart, len: nameLen) {
                            if !(self.isImportedInto(mod: useMod, nameStart: nameStart, nameLen: nameLen)) {
                                return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "this @Std function is not ambient — import it (e.g. `import @Std/Io with { print }`); only lang items are usable without import (spec/15)") />
                            }
                        }
                    }
                } else {
                    // a free fn of this name IS visible, but the call's labels may match only
                    // a same-named fn PRIVATE to another module (an imported same-named export
                    // shadows the name by text). `findFunc` correctly rejects it — report the
                    // (name, module) visibility failure cleanly instead of an opaque backend
                    // error (spec/15).
                    if self.labelMatchOnlyInvisible(useMod: useMod, nameStart: nameStart, nameLen: nameLen, args: args) {
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "this call matches only a function that is not visible here — it is private to another module (spec/15: a private free fn is not reachable through an unrelated module's same-named export)") />
                    }
                }
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // Is a user type declaration named (start,len) VISIBLE from module `useMod` (scoped
    // resolution: same module, or imported+exported)? A type decl's OWN module comes from
    // its `defOffset` (a real source offset) — its `nameStart` is re-interned (module 0)
    // and cannot serve `moduleOf`. The import side is keyed by the name text (the use-site
    // span and the import record share it), independent of which decl matched.
    // Is a type declaration whose own module is `moduleOf(defOffset)` visible to a use in
    // module `useMod`? Only the same module is visible on this axis; cross-module visibility
    // goes through the import side (`isImportedInto` + `isExportedName`) in the caller. Ambient
    // lang-item TYPES are handled separately by `isAmbientInLang` at the type site (= @Std/Lang's
    // export surface) — no OTHER module is "ambient" as a whole (spec/15).
    inout fn defModuleVisible(defOffset: U64, useMod: U64) -> Bool {
        return self.moduleOf(offset: defOffset) == useMod
    }

    inout fn typeDeclVisibleFrom(useMod: U64, start: U64, len: U64) -> Bool {
        val qualified = self.modules.qualifiedUseIndex(offset: start)
        if qualified < self.modules.qualifiedUseCount() {
            match self.moduleBindingFromOrigin(origin: self.modules.qualifiedUseAt(index: qualified)) {
                ModuleBinding.Declaration(val moduleId, val nameStart, val nameLen) => {
                    return self.typeDeclIdentityInModule(mod: moduleId, start: nameStart, len: nameLen).nameLen != 0U64
                }
                _ => { return false }
            }
        }
        if self.typeDeclIdentityInModule(mod: useMod, start: start, len: len).nameLen != 0U64 { return true }
        val nameId = intern(c: inout self, start: start, len: len)
        val index = self.modules.firstImportOriginNamed(moduleId: useMod, nameId: nameId)
        if index < self.modules.importOriginCount() {
            match self.moduleBindingFromOrigin(origin: self.modules.importOriginAt(index: index)) {
                ModuleBinding.Declaration(val moduleId, val nameStart, val nameLen) => {
                    return self.typeDeclIdentityInModule(mod: moduleId, start: nameStart, len: nameLen).nameLen != 0U64
                }
                _ => {}
            }
        }
        return false
    }

    // Does a user type declaration named (start,len) exist in ANY loaded module? (Used to
    // tell a genuine out-of-scope type from a type parameter / Self / associated type,
    // which have no global declaration.)
    inout fn typeDeclExistsGlobally(start: U64, len: U64) -> Bool {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        if self.anyStructIndex(nameStart: start, nameLen: len) < self.arena.structCount() { return true }
        if self.anyEnumIndex(nameStart: start, nameLen: len) < self.arena.enumCount() { return true }
        mut val i: U64 = 0
        while i < self.decls.traitCount() {
            val td: TraitDef = self.decls.traitAt(index: i)
            if td.nameId == qId { return true }
            i += 1
        }
        i = 0
        while i < self.arena.newtypeCount() {
            val nt: NewtypeDef = self.arena.newtypeAt(index: i)
            if spansEqual(c: inout self, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) { return true }
            i += 1
        }
        return false
    }

    // Check one user-written type name (head span start,len) written at real source offset
    // `siteOffset`. It must resolve to a declaration in scope of `siteOffset`'s module (same
    // module, or imported+exported). Lang-item types are ambient. A type-parameter head was
    // already excluded at lowering (its TypeRef carries siteOffset 0, so the walk never reaches
    // here); `Self` / associated types have no global declaration, so the existence gate skips
    // them silently. A genuine out-of-scope type — one that exists in another module but isn't
    // imported — is the loud error.
    // Resolve a module-local import alias `import M with { Real as Alias }` to `Real`, scoped
    // to module `useMod` (the use site's module from its real siteOffset — the type-name span is
    // re-interned, so the alias's own moduleOf must be compared against useMod). Returns the real
    // name span, or the input unchanged when no alias of this module matches. c.modules.imports /
    // exports are keyed by the REAL name, so resolving first lets the ordinary visibility check
    // (imported + exported) succeed for an aliased type use.
    inout fn realTypeNameInModule(useMod: U64, start: U64, len: U64) -> Bind {
        mut val ai: U64 = 0
        while ai < self.decls.importAliases.count() {
            val al: Bind = self.decls.importAliases[ai]
            if spansEqual(c: inout self, aStart: al.nameStart, aLen: al.nameLen, bStart: start, bLen: len) {
                if self.moduleOf(offset: al.nameStart) == useMod {
                    return <Bind nameStart=al.fieldStart nameLen=al.fieldLen fieldStart=al.fieldStart fieldLen=al.fieldLen />
                }
            }
            ai += 1
        }
        return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
    }

    inout fn checkTypeName(siteOffset: U64, start: U64, len: U64) -> Result[(), CompileDiagnostic] {
        if len == 0 { return <Result.Ok value=() /> }
        if self.isAmbientInLang(start: start, len: len) { return <Result.Ok value=() /> }
        val useMod: U64 = self.moduleOf(offset: siteOffset)
        if self.typeDeclVisibleFrom(useMod: useMod, start: start, len: len) { return <Result.Ok value=() /> }
        val real: Bind = self.realTypeNameInModule(useMod: useMod, start: start, len: len)
        if self.typeDeclExistsGlobally(start: real.nameStart, len: real.nameLen) {
            return <Result.Err error=self.diagnosticAt(offset: siteOffset, msg: "use of a type from another module without importing it (add `import … with { … }`)") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkProjectionMember(type: TypeRef) -> Result[(), CompileDiagnostic] {
        if type.assocNameId == 0U64 || type.assocTraitId == 0U64 { return <Result.Ok value=() /> }
        val owner = if type.hasAssocTraitDecl { give type.assocTraitDeclOffset } else { give type.assocTraitStart }
        val index = self.decls.traitIndexByOffset(offset: owner)
        if index >= self.decls.traitCount() { return <Result.Ok value=() /> }
        val trait = self.decls.traitAt(index: index)
        mut val member = 0U64
        while member < trait.assocTypes.count() {
            if self.traitBindAt(binds: trait.assocTypes, index: member).nameId == type.assocNameId { return <Result.Ok value=() /> }
            member += 1U64
        }
        return <Result.Err error=self.diagnosticAt(offset: type.siteOffset, msg: "associated-type projection names an associated type that is not bound by the selected conformance (spec/08)") />
    }

    // A single authored use has identical semantics at declaration load and
    // lexical body request. Projection and visibility checks precede consumers.
    inout fn checkSourceTypeUses(types: Array[U64]) -> Result[(), CompileDiagnostic] {
        for ref in types {
            if !self.checkedTypeUses.contains(ref) {
                try self.checkAnyTypeFormation(ref: ref)
                try self.checkTypeUseVisibility(ref: ref)
                self.checkedTypeUses.insert(ref)
            }
        }
        return <Result.Ok value=() />
    }

    inout fn checkTypeUseVisibility(ref: U64) -> Result[(), CompileDiagnostic] {
        val type = self.arena.typeAt(index: ref)
        try self.checkProjectionMember(type: type)
        if type.siteOffset != 0U64 && self.offsetIsLoaded(offset: type.siteOffset) {
            try self.checkTypeName(siteOffset: type.siteOffset, start: type.nameStart, len: type.nameLen)
        }
        return <Result.Ok value=() />
    }

    inout fn checkTypeVisibility() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.arena.typeCount() {
            try self.checkTypeUseVisibility(ref: index)
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn typeDeclModuleMissing() -> U64 {
        return 4000000000U64
    }

    inout fn packageRootModuleOf(mod: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.modules.packageRoots.count() {
            val r: Bind = self.modules.packageRoots[i]
            if r.nameStart == mod {
                return r.fieldStart
            }
            i += 1
        }
        return mod
    }

    inout fn isPackageRootModule(mod: U64) -> Bool {
        return self.packageRootModuleOf(mod: mod) == mod
    }

    // Generated members without an authored function offset retain the
    // nominal receiver's owner. An unresolved term cannot borrow the module
    // of another declaration with the same spelling.
    inout fn typeDefinitionModule(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeCount() { return 4000000000U64 }
        val type = self.arena.typeTerms[ref]
        if !type.hasDecl { return 4000000000U64 }
        return self.moduleOf(offset: type.declOffset)
    }

    // A declaration identity is its real declaration offset. `nameLen == 0` is
    // the missing sentinel; this permits a genuine declaration at source offset 0.
    inout fn missingDeclIdentity() -> Bind {
        return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
    }

    inout fn typeDeclIdentityInModule(mod: U64, start: U64, len: U64) -> Bind {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = self.arena.firstStructNamed(nameId: qId)
        while i < self.arena.structCount() {
            val d: StructDef = self.arena.structAt(index: i)
            if d.nameId == qId && self.moduleOf(offset: d.defOffset) == mod {
                return <Bind nameStart=d.defOffset nameLen=1 fieldStart=0 fieldLen=0 />
            }
            i = self.arena.nextStructNamed(index: i)
        }
        i = self.arena.firstEnumNamed(nameId: qId)
        while i < self.arena.enumCount() {
            val d: EnumDef = self.arena.enumAt(index: i)
            if d.nameId == qId && self.moduleOf(offset: d.defOffset) == mod {
                return <Bind nameStart=d.defOffset nameLen=1 fieldStart=0 fieldLen=0 />
            }
            i = self.arena.nextEnumNamed(index: i)
        }
        i = self.decls.firstTraitNamed(nameId: qId)
        while i < self.decls.traitCount() {
            val d: TraitDef = self.decls.traitAt(index: i)
            if d.nameId == qId && self.moduleOf(offset: d.nameStart) == mod {
                return <Bind nameStart=d.nameStart nameLen=1 fieldStart=0 fieldLen=0 />
            }
            i = self.decls.nextTraitNamed(index: i)
        }
        i = self.arena.firstNewtypeNamed(nameId: qId)
        while i < self.arena.newtypeCount() {
            val d: NewtypeDef = self.arena.newtypeAt(index: i)
            if d.nameId == qId && self.moduleOf(offset: d.defOffset) == mod {
                return <Bind nameStart=d.defOffset nameLen=1 fieldStart=0 fieldLen=0 />
            }
            i = self.arena.nextNewtypeNamed(index: i)
        }
        return self.missingDeclIdentity()
    }

    // Resolve a name exposed by a module's surface. A re-export keeps the
    // declaration identity of its source rather than inventing an alias identity.
    inout fn typeDeclIdentityFromSurface(surfaceMod: U64, start: U64, len: U64) -> Bind {
        val local: Bind = self.typeDeclIdentityInModule(mod: surfaceMod, start: start, len: len)
        if local.nameLen != 0U64 { return local }
        val nameId = intern(c: inout self, start: start, len: len)
        val index = self.modules.firstReExportOriginNamed(moduleId: surfaceMod, nameId: nameId)
        if index < self.modules.reExportOriginCount() {
            val origin = self.modules.reExportOriginAt(index: index)
            return self.typeDeclIdentityFromSurface(surfaceMod: origin.targetModule, start: origin.sourceStart, len: origin.sourceLength)
        }
        return self.missingDeclIdentity()
    }

    // The real import-name length is stored in the source span itself; recover it
    // through the matching import/re-export provenance entry instead of guessing.
    inout fn typeDeclIdentityAt(useMod: U64, start: U64, len: U64) -> Bind {
        val qualified = self.modules.qualifiedUseIndex(offset: start)
        if qualified < self.modules.qualifiedUseCount() {
            val origin = self.modules.qualifiedUseAt(index: qualified)
            return self.typeDeclIdentityFromSurface(surfaceMod: origin.targetModule, start: origin.sourceStart, len: origin.sourceLength)
        }
        val local: Bind = self.typeDeclIdentityInModule(mod: useMod, start: start, len: len)
        if local.nameLen != 0U64 { return local }
        val nameId = intern(c: inout self, start: start, len: len)
        val index = self.modules.firstImportOriginNamed(moduleId: useMod, nameId: nameId)
        if index < self.modules.importOriginCount() {
            val origin = self.modules.importOriginAt(index: index)
            return self.typeDeclIdentityFromSurface(surfaceMod: origin.targetModule, start: origin.sourceStart, len: origin.sourceLength)
        }
        // @Std/Lang is the one ambient type surface. Its declarations are in
        // scope without an import, but they still need the same declaration
        // identity as an explicitly imported type: downstream TypeTerm,
        // proof, and Mid consumers must never fall back to the spelling
        // `Array`/`Optional`/etc. Re-exports are resolved by the surface query
        // so Core-owned primitive lang items retain their defining identity.
        val lang: U64 = self.modules.langModule
        if lang != 4000000000U64 {
            val ambient: Bind = self.typeDeclIdentityFromSurface(surfaceMod: lang, start: start, len: len)
            if ambient.nameLen != 0U64 { return ambient }
        }
        return self.missingDeclIdentity()
    }

    // Reachability is fixed for this check, after all declarations and import
    // identities have been established. Cache complete sets, including misses.
    inout fn publicSurfaceProvidesDecl(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, identity: Bind) -> Bool {
        if identity.nameLen == 0U64 { return true }
        if !surfaces.contains(surface: surfaceMod) {
            mut val declarations: Dictionary[U64, Bool] = [:]
            mut val visited: Dictionary[U64, Bool] = [:]
            self.collectPublicSurfaceDeclarations(surfaceMod: surfaceMod, declarations: inout declarations, visited: inout visited)
            surfaces.record(surface: surfaceMod, declarations: declarations)
        }
        return surfaces.provides(surface: surfaceMod, declaration: identity.nameStart)
    }

    inout fn collectPublicSurfaceDeclarations(surfaceMod: U64, declarations: inout Dictionary[U64, Bool], visited: inout Dictionary[U64, Bool]) {
        if visited.getOr(key: surfaceMod, fallback: false) { return }
        visited[surfaceMod] = true
        mut val i: U64 = self.modules.exports.firstIn(moduleId: surfaceMod)
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports.at(index: i)
            if self.exportEntrySurfaceModule(e: e) == surfaceMod {
                match self.moduleBindingFromSurface(moduleId: surfaceMod, nameStart: e.nameStart, nameLen: e.nameLen) {
                    ModuleBinding.Namespace(val moduleId) => {
                        self.collectPublicSurfaceDeclarations(surfaceMod: moduleId, declarations: inout declarations, visited: inout visited)
                    }
                    ModuleBinding.Declaration(val moduleId, val nameStart, val nameLen) => {
                        val exported = self.typeDeclIdentityInModule(mod: moduleId, start: nameStart, len: nameLen)
                        if exported.nameLen != 0U64 { declarations[exported.nameStart] = true }
                    }
                    ModuleBinding.Missing => {}
                }
            }
            i = self.modules.exports.nextIn(index: i)
        }
    }

    inout fn declIdentityHasName(identity: Bind, start: U64, len: U64) -> Bool {
        match self.arena.structNameByOffset(offset: identity.nameStart) {
            Optional.Some(v: val name) => { return spansEqual(c: inout self, aStart: name.start, aLen: name.len, bStart: start, bLen: len) }
            Optional.None => {}
        }
        match self.arena.enumNameByOffset(offset: identity.nameStart) {
            Optional.Some(v: val name) => { return spansEqual(c: inout self, aStart: name.start, aLen: name.len, bStart: start, bLen: len) }
            Optional.None => {}
        }
        match self.decls.traitNameByOffset(offset: identity.nameStart) {
            Optional.Some(v: val name) => { return spansEqual(c: inout self, aStart: name.start, aLen: name.len, bStart: start, bLen: len) }
            Optional.None => {}
        }
        match self.arena.newtypeNameByOffset(offset: identity.nameStart) {
            Optional.Some(v: val name) => { return spansEqual(c: inout self, aStart: name.start, aLen: name.len, bStart: start, bLen: len) }
            Optional.None => {}
        }
        return false
    }

    inout fn resolveTypeDeclIdentities() {
        mut val i: U64 = 0
        while i < self.arena.typeCount() {
            val t: TypeRef = self.arena.typeAt(index: i)
            if t.siteOffset != 0U64 && self.offsetIsLoaded(offset: t.siteOffset) {
                val useMod: U64 = self.moduleOf(offset: t.siteOffset)
                val decl: Bind = self.typeDeclIdentityAt(useMod: useMod, start: t.nameStart, len: t.nameLen)
                mut val assoc: Bind = self.missingDeclIdentity()
                if t.assocTraitLen != 0U64 {
                    assoc = self.typeDeclIdentityAt(useMod: useMod, start: t.assocTraitStart, len: t.assocTraitLen)
                }
                // Resolve both representations at the same declaration boundary.
                // The scalar reader must never observe pre-resolution identity.
                self.arena.resolveTypeDeclaration(index: i, hasDecl: decl.nameLen != 0U64, declOffset: decl.nameStart, hasAssocTraitDecl: assoc.nameLen != 0U64, assocTraitDeclOffset: assoc.nameStart)
            }
            i += 1
        }
    }

    inout fn checkSurfaceName(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, start: U64, len: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if self.isAmbientInLang(start: start, len: len) { return <Result.Ok value=() /> }
        val identity: Bind = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: offset), start: start, len: len)
        if identity.nameLen == 0U64 { return <Result.Ok value=() /> }
        val surfaceRoot: U64 = self.packageRootModuleOf(mod: surfaceMod)
        val declRoot: U64 = self.packageRootModuleOf(mod: self.moduleOf(offset: identity.nameStart))
        mut val requiredSurface: U64 = declRoot
        if declRoot == surfaceRoot { requiredSurface = surfaceRoot }
        if !(self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: requiredSurface, identity: identity)) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "public API signature mentions a package-local name that is not reachable from the package root public surface — export or re-export it from src/_.pw (spec/15 public API closure)") />
        }
        return <Result.Ok value=() />
    }

    // A lowered trait constraint already carries its declaration owner.  Do
    // not feed that owner span back through the exporting module's import
    // surface: `PrivateMarker as Marker` would otherwise look unresolved and
    // escape public-API closure.  The canonical identity is the thing whose
    // reachability must be checked.
    inout fn checkSurfaceTraitOwner(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, owner: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if owner == 0U64 { return <Result.Ok value=() /> }
        val identity: Bind = <Bind nameStart=owner nameLen=1 fieldStart=0 fieldLen=0 />
        val surfaceRoot: U64 = self.packageRootModuleOf(mod: surfaceMod)
        val traitRoot: U64 = self.packageRootModuleOf(mod: self.moduleOf(offset: owner))
        mut val requiredSurface: U64 = traitRoot
        if traitRoot == surfaceRoot { requiredSurface = surfaceRoot }
        if !(self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: requiredSurface, identity: identity)) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "public API signature mentions a package-local name that is not reachable from the package root public surface — export or re-export it from src/_.pw (spec/15 public API closure)") />
        }
        return <Result.Ok value=() />
    }

    inout fn isRecordSurfaceName(start: U64, len: U64) -> Bool {
        if len == 0 { return false }
        if start >= self.arena.bytes.count() { return false }
        return self.arena.bytes[start] == 40U8
    }

    inout fn checkRecordSurfaceFields(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, start: U64, len: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if !(self.isRecordSurfaceName(start: start, len: len)) { return <Result.Ok value=() /> }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val si: U64 = self.arena.firstStructNamed(nameId: qId)
        while si < self.arena.structCount() {
            val sd: StructDef = self.arena.structAt(index: si)
            if sd.nameId == qId {
                mut val fi: U64 = 0
                while fi < sd.fields.count() {
                    try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: sd.fields[fi].ty, offset: offset)
                    fi += 1
                }
                return <Result.Ok value=() />
            }
            si = self.arena.nextStructNamed(index: si)
        }
        return <Result.Ok value=() />
    }

    inout fn checkSurfaceType(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, ref: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if ref == 0U64 { return <Result.Ok value=() /> }
        if ref >= self.arena.typeCount() { return <Result.Ok value=() /> }
        val t: TypeRef = self.arena.typeAt(index: ref)
        if t.siteOffset == 0U64 {
            if self.isRecordSurfaceName(start: t.nameStart, len: t.nameLen) {
                try self.checkRecordSurfaceFields(surfaces: inout surfaces, surfaceMod: surfaceMod, start: t.nameStart, len: t.nameLen, offset: offset)
            }
            mut val ai0: U64 = 0
            while ai0 < t.args.count() {
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: t.args[ai0], offset: offset)
                ai0 += 1
            }
            return <Result.Ok value=() />
        }
        mut val errOffset: U64 = offset
        if t.siteOffset != 0U64 {
            if self.offsetIsLoaded(offset: t.siteOffset) {
                errOffset = t.siteOffset
            }
        }
        if t.hasDecl && !(self.isAmbientInLang(start: t.nameStart, len: t.nameLen)) {
            val identity: Bind = <Bind nameStart=t.declOffset nameLen=1 fieldStart=0 fieldLen=0 />
            val surfaceRoot: U64 = self.packageRootModuleOf(mod: surfaceMod)
            val declRoot: U64 = self.packageRootModuleOf(mod: self.moduleOf(offset: t.declOffset))
            mut val requiredSurface: U64 = declRoot
            if declRoot == surfaceRoot { requiredSurface = surfaceRoot }
            if !(self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: requiredSurface, identity: identity)) {
                return <Result.Err error=self.diagnosticAt(offset: errOffset, msg: "public API signature mentions a package-local name that is not reachable from the package root public surface — export or re-export it from src/_.pw (spec/15 public API closure)") />
            }
        }
        try self.checkRecordSurfaceFields(surfaces: inout surfaces, surfaceMod: surfaceMod, start: t.nameStart, len: t.nameLen, offset: errOffset)
        if t.hasAssocTraitDecl {
            val assoc: Bind = <Bind nameStart=t.assocTraitDeclOffset nameLen=1 fieldStart=0 fieldLen=0 />
            val surfaceRoot: U64 = self.packageRootModuleOf(mod: surfaceMod)
            val traitRoot: U64 = self.packageRootModuleOf(mod: self.moduleOf(offset: t.assocTraitDeclOffset))
            mut val requiredSurface: U64 = traitRoot
            if traitRoot == surfaceRoot { requiredSurface = surfaceRoot }
            if !(self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: requiredSurface, identity: assoc)) {
                return <Result.Err error=self.diagnosticAt(offset: errOffset, msg: "public API signature mentions a package-local name that is not reachable from the package root public surface — export or re-export it from src/_.pw (spec/15 public API closure)") />
            }
        }
        mut val i: U64 = 0
        while i < t.args.count() {
            try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: t.args[i], offset: errOffset)
            i += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkSurfaceParam(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, p: Param, offset: U64) -> Result[(), CompileDiagnostic] {
        try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: p.ty, offset: offset)
        return <Result.Ok value=() />
    }

    inout fn checkSurfaceFuncSignature(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, fnIdx: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if fnIdx >= self.arena.functionCount() { return <Result.Ok value=() /> }
        val f: Func = self.arena.functionAt(index: fnIdx)
        mut val pi: U64 = 0
        while pi < f.params.count() {
            try self.checkSurfaceParam(surfaces: inout surfaces, surfaceMod: surfaceMod, p: self.funcParamAt(params: f.params, index: pi), offset: offset)
            pi += 1
        }
        if f.hasRet {
            try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: f.retTy, offset: offset)
        }
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val b: FuncBound = self.decls.funcBounds[bi]
            if b.fnIdx == fnIdx {
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: b.paramTy, offset: offset)
                try self.checkSurfaceTraitOwner(surfaces: inout surfaces, surfaceMod: surfaceMod, owner: b.constraint.key.owner, offset: offset)
            }
            bi += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkStructSurfaceInModule(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, sd: StructDef) -> Result[(), CompileDiagnostic] {
        val publishesFactory = self.structHasPubFactory(structIndex: self.arena.structIndexByOffset(offset: sd.defOffset))
        mut val fi: U64 = 0
        while fi < sd.fields.count() {
            val f: FieldDef = sd.fields[fi]
            if f.vis != 0U64 || publishesFactory {
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: f.ty, offset: f.nameStart)
            }
            fi += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkEnumSurfaceInModule(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, ed: EnumDef) -> Result[(), CompileDiagnostic] {
        mut val vi: U64 = 0
        while vi < ed.variants.count() {
            val v: Variant = ed.variants[vi]
            mut val fi: U64 = 0
            while fi < v.fields.count() {
                val f: FieldDef = v.fields[fi]
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: f.ty, offset: f.nameStart)
                fi += 1
            }
            vi += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkNewtypeSurfaceInModule(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, nt: NewtypeDef) -> Result[(), CompileDiagnostic] {
        try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: nt.underRef, offset: nt.defOffset)
        return <Result.Ok value=() />
    }

    inout fn checkGlobalSurfaceInModule(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, g: Global) -> Result[(), CompileDiagnostic] {
        if g.letStmt >= self.arena.stmts.count() { return <Result.Ok value=() /> }
        match self.arena.stmts[g.letStmt] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                val eff: LetEff = (try self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init))
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: eff.ty, offset: g.nameStart)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    inout fn checkTraitSurfaceInModule(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, td: TraitDef) -> Result[(), CompileDiagnostic] {
        mut val si: U64 = 0
        while si < td.supertraits.count() {
            val supertrait = self.traitConstraintAt(constraints: td.supertraits, index: si)
            try self.checkSurfaceTraitOwner(surfaces: inout surfaces, surfaceMod: surfaceMod, owner: supertrait.key.owner, offset: td.nameStart)
            for val argument in supertrait.key.positionalArgs { try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: argument, offset: td.nameStart) }
            for val predicate in supertrait.assocPredicates { try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: predicate.value, offset: td.nameStart) }
            si += 1
        }
        mut val ri: U64 = 0
        while ri < td.reqs.count() {
            val req: Func = self.traitReqAt(reqs: td.reqs, index: ri)
            mut val pi: U64 = 0
            while pi < req.params.count() {
                try self.checkSurfaceParam(surfaces: inout surfaces, surfaceMod: surfaceMod, p: self.funcParamAt(params: req.params, index: pi), offset: req.nameStart)
                pi += 1
            }
            if req.hasRet {
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: req.retTy, offset: req.nameStart)
            }
            ri += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkPublicConformanceSurface(surfaces: inout PublicSurfaceIndex, cf: Conform) -> Result[(), CompileDiagnostic] {
        if !(cf.isPub) { return <Result.Ok value=() /> }
        if cf.extId != 0U64 { return <Result.Ok value=() /> }
        val useMod: U64 = cf.sourceModule
        val receiver: Bind = self.typeDeclIdentityAt(useMod: useMod, start: cf.typeStart, len: cf.typeLen)
        if receiver.nameLen == 0U64 { return <Result.Ok value=() /> }
        val typeMod: U64 = self.moduleOf(offset: receiver.nameStart)
        val surfaceMod: U64 = self.packageRootModuleOf(mod: typeMod)
        val trait: Bind = self.typeDeclIdentityAt(useMod: useMod, start: cf.traitStart, len: cf.traitLen)
        if trait.nameLen == 0U64 { return <Result.Ok value=() /> }
        if !(self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: surfaceMod, identity: receiver)) { return <Result.Ok value=() /> }
        val traitRoot: U64 = self.packageRootModuleOf(mod: self.moduleOf(offset: trait.nameStart))
        if !(self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: traitRoot, identity: trait)) { return <Result.Ok value=() /> }
        try self.checkSurfaceName(surfaces: inout surfaces, surfaceMod: surfaceMod, start: cf.traitStart, len: cf.traitLen, offset: cf.defOffset)
        mut val ai: U64 = 0
        while ai < cf.traitArgs.count() {
            try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: self.conformTypeAt(types: cf.traitArgs, index: ai), offset: cf.defOffset)
            ai += 1
        }
        try self.checkPublicConformanceAssocBindings(surfaces: inout surfaces, surfaceMod: surfaceMod, cf: cf)
        return <Result.Ok value=() />
    }

    inout fn checkPublicConformanceAssocBindings(surfaces: inout PublicSurfaceIndex, surfaceMod: U64, cf: Conform) -> Result[(), CompileDiagnostic] {
        mut val ai: U64 = 0
        while ai < self.decls.assocBindings.count() {
            val ab: AssocBinding = self.decls.assocBindings[ai]
            if ab.implOffset == cf.defOffset {
                try self.checkSurfaceType(surfaces: inout surfaces, surfaceMod: surfaceMod, ref: ab.ty, offset: ab.nameStart)
            }
            ai += 1
        }
        return <Result.Ok value=() />
    }

    inout fn surfaceCanExportDeclModule(surfaceMod: U64, declMod: U64) -> Bool {
        if surfaceMod == declMod { return true }
        mut val i: U64 = 0
        while i < self.modules.reExportEdges.count() {
            val e: Bind = self.modules.reExportEdges[i]
            if e.fieldStart == surfaceMod {
                if e.fieldLen == declMod { return true }
            }
            i += 1
        }
        return false
    }

    inout fn exportEntrySurfaceModule(e: Bind) -> U64 {
        // `recordExport` stamps this when lowering the source item. Do not derive
        // it from the name span: struct/enum names are interned and may no longer
        // point into their declaring module.
        return e.fieldStart
    }

    inout fn checkExportEntrySurface(surfaces: inout PublicSurfaceIndex, e: Bind, apiRoot: U64 = 4000000000U64) -> Result[(), CompileDiagnostic] {
        val entryModule = self.exportEntrySurfaceModule(e: e)
        val surfaceMod = if apiRoot == 4000000000U64 { give entryModule } else { give apiRoot }
        mut val declarationModule = entryModule
        mut val declarationName = e.nameStart
        mut val declarationLength = e.nameLen
        match self.moduleBindingFromSurface(moduleId: entryModule, nameStart: e.nameStart, nameLen: e.nameLen) {
            ModuleBinding.Namespace(val moduleId) => {
                // Imports form a DAG. Retain the original public root while
                // walking the namespace's public declarations.
                mut val index = self.modules.exports.firstIn(moduleId: moduleId)
                while index < self.modules.exports.count() {
                    val child = self.modules.exports.at(index: index)
                    if self.exportEntrySurfaceModule(e: child) == moduleId { try self.checkExportEntrySurface(surfaces: inout surfaces, e: child, apiRoot: surfaceMod) }
                    index = self.modules.exports.nextIn(index: index)
                }
                return <Result.Ok value=() />
            }
            ModuleBinding.Declaration(val moduleId, val nameStart, val nameLen) => {
                declarationModule = moduleId
                declarationName = nameStart
                declarationLength = nameLen
            }
            ModuleBinding.Missing => { return <Result.Ok value=() /> }
        }
        val identity = self.typeDeclIdentityInModule(mod: declarationModule, start: declarationName, len: declarationLength)
        mut val si: U64 = 0
        while si < self.arena.structCount() {
            val sd: StructDef = self.arena.structAt(index: si)
            if identity.nameLen != 0U64 && sd.defOffset == identity.nameStart {
                try self.checkStructSurfaceInModule(surfaces: inout surfaces, surfaceMod: surfaceMod, sd: sd)
            }
            si += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enumCount() {
            val ed: EnumDef = self.arena.enumAt(index: ei)
            if identity.nameLen != 0U64 && ed.defOffset == identity.nameStart {
                try self.checkEnumSurfaceInModule(surfaces: inout surfaces, surfaceMod: surfaceMod, ed: ed)
            }
            ei += 1
        }
        mut val nti: U64 = 0
        while nti < self.arena.newtypeCount() {
            val nt: NewtypeDef = self.arena.newtypeAt(index: nti)
            if identity.nameLen != 0U64 && nt.defOffset == identity.nameStart {
                try self.checkNewtypeSurfaceInModule(surfaces: inout surfaces, surfaceMod: surfaceMod, nt: nt)
            }
            nti += 1
        }
        mut val ti: U64 = 0
        while ti < self.decls.traitCount() {
            val td: TraitDef = self.decls.traitAt(index: ti)
            if identity.nameLen != 0U64 && td.nameStart == identity.nameStart {
                try self.checkTraitSurfaceInModule(surfaces: inout surfaces, surfaceMod: surfaceMod, td: td)
            }
            ti += 1
        }
        mut val gi: U64 = 0
        while gi < self.arena.globals.count() {
            val g: Global = self.arena.globals[gi]
            if self.moduleOf(offset: g.nameStart) == declarationModule && spansEqual(c: inout self, aStart: g.nameStart, aLen: g.nameLen, bStart: declarationName, bLen: declarationLength) {
                try self.checkGlobalSurfaceInModule(surfaces: inout surfaces, surfaceMod: surfaceMod, g: g)
            }
            gi += 1
        }
        mut val fi: U64 = 0
        while fi < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: fi)
            if !(f.hasRecv) {
                if !(f.isAssoc) {
                    if self.funcDeclModule(f: f) == declarationModule && spansEqual(c: inout self, aStart: f.nameStart, aLen: f.nameLen, bStart: declarationName, bLen: declarationLength) {
                        try self.checkSurfaceFuncSignature(surfaces: inout surfaces, surfaceMod: surfaceMod, fnIdx: fi, offset: f.nameStart)
                    }
                }
            }
            fi += 1
        }
        return <Result.Ok value=() />
    }

    inout fn checkPublicApiClosure() -> Result[(), CompileDiagnostic] {
        mut val surfaces = <PublicSurfaceIndex />
        mut val exi: U64 = 0
        while exi < self.modules.exports.count() {
            val exSurface: U64 = self.exportEntrySurfaceModule(e: self.modules.exports.at(index: exi))
            if self.isPackageRootModule(mod: exSurface) {
                try self.checkExportEntrySurface(surfaces: inout surfaces, e: self.modules.exports.at(index: exi))
            }
            exi += 1
        }
        mut val fi: U64 = 0
        while fi < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: fi)
            if f.hasRecv || f.isAssoc {
                if f.isPub {
                    mut val ownerMod: U64 = self.moduleOf(offset: f.defOffset)
                    if f.defOffset == 0U64 {
                        ownerMod = self.typeDefinitionModule(ref: f.recvTy)
                    }
                    if ownerMod != self.typeDeclModuleMissing() {
                        val surfaceMod: U64 = self.packageRootModuleOf(mod: ownerMod)
                        val receiver: Bind = self.typeDeclIdentityAt(useMod: ownerMod, start: f.recvStart, len: f.recvLen)
                        if receiver.nameLen != 0U64 {
                            if self.packageRootModuleOf(mod: self.moduleOf(offset: receiver.nameStart)) == surfaceMod {
                                if self.publicSurfaceProvidesDecl(surfaces: inout surfaces, surfaceMod: surfaceMod, identity: receiver) {
                                    try self.checkSurfaceFuncSignature(surfaces: inout surfaces, surfaceMod: surfaceMod, fnIdx: fi, offset: f.defOffset)
                                }
                            }
                        }
                    }
                }
            }
            fi += 1
        }
        mut val ci: U64 = 0
        while ci < self.decls.conformCount() {
            try self.checkPublicConformanceSurface(surfaces: inout surfaces, cf: self.decls.conformAt(index: ci))
            ci += 1
        }
        return <Result.Ok value=() />
    }
}

pub impl Comp {

    // DFS over the module import graph (colors: 0=white, 1=gray/on-stack, 2=black). A gray
    // target is a back edge → a circular import; report it at the offending import.
    inout fn dfsImportCycle(node: U64, color: inout Array[U64], parents: inout Array[U64], ef: Array[U64], et: Array[U64], eo: Array[U64]) -> Result[(), CompileDiagnostic] {
        color[node] = 1U64
        mut val k: U64 = 0
        while k < ef.count() {
            if ef[k] == node {
                val w: U64 = et[k]
                if color[w] == 1U64 {
                    return <Result.Err error=self.diagnosticAt(offset: eo[k], msg: self.importCycleMessage(node: node, target: w, parents: parents)) />
                }
                if color[w] == 0U64 {
                    parents[w] = node
                    try self.dfsImportCycle(node: w, color: inout color, parents: inout parents, ef: ef, et: et, eo: eo)
                }
            }
            k += 1
        }
        color[node] = 2U64
        return <Result.Ok value=() />
    }

    fn importModulePath(module: U64) -> String {
        mut val index = 0U64
        while index < self.modules.sourceFileCount() {
            if self.modules.sourceFileRange(index: index).moduleId == module {
                return self.modules.sourceFilePath(index: index)
            }
            index += 1U64
        }
        return "<unknown module>"
    }

    fn importCycleMessage(node: U64, target: U64, parents: Array[U64]) -> String {
        mut val reverse: Array[U64] = []
        mut val current = node
        while current != target {
            reverse.append(current)
            current = parents[current]
        }
        mut val message = "circular import: " + self.importModulePath(module: target)
        mut val index = reverse.count()
        while index > 0U64 {
            index -= 1U64
            message = message + " -> " + self.importModulePath(module: reverse[index])
        }
        return message + " -> " + self.importModulePath(module: target) + ". The module import graph must be acyclic (spec/15)."
    }

    // Every resolved import contributes an edge, independently of selected names,
    // aliases or re-exports. Parts themselves do not contribute import edges.
    inout fn detectImportCycles() -> Result[(), CompileDiagnostic] {
        mut val maxId: U64 = 0
        mut val ri: U64 = 0
        while ri < self.modules.sourceFileCount() {
            val moduleId = self.modules.sourceFileRange(index: ri).moduleId
            if moduleId > maxId { maxId = moduleId }
            ri += 1
        }
        val n: U64 = maxId + 1
        mut val ef: Array[U64] = []
        mut val et: Array[U64] = []
        mut val eo: Array[U64] = []
        mut val ii: U64 = 0
        while ii < self.modules.importEdges.count() {
            val edge = self.modules.importEdges[ii]
            ef.append(edge.fieldStart)
            et.append(edge.fieldLen)
            eo.append(edge.nameStart)
            ii += 1U64
        }
        mut val color: Array[U64] = []
        mut val parents: Array[U64] = []
        mut val ci: U64 = 0
        while ci < n {
            color.append(0U64)
            parents.append(0U64)
            ci += 1
        }
        mut val s: U64 = 0
        while s < n {
            if color[s] == 0U64 {
                try self.dfsImportCycle(node: s, color: inout color, parents: inout parents, ef: ef, et: et, eo: eo)
            }
            s += 1
        }
        return <Result.Ok value=() />
    }

    // Is (start,len) the name of an `@Std` function the LLVM backend intercepts by raw
    // name (so it would emit without an import)? These need a real import gate (spec/15):
    // the user-facing I/O / process / async intrinsics. (The Buffer/String/FFI floor
    // intrinsics are resolved through their loaded `extern` decls, so they fall under
    // the ordinary import check above and are not listed here.)
    inout fn isAmbientInterceptedName(start: U64, len: U64) -> Bool {
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "print") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "eprint") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "write") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "writeByte") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "readStdin") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "readFile") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "readFileBytes") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "fileExists") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "sleep") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "exit") { return true }
        // `assert` is a @Std/Core function (not a lang item): now that Core is ambient
        // (force-loaded), it resolves, but spec keeps it import-required, so gate it here.
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "assert") { return true }
        return false
    }
}

// Missing-return check (spec/11, loud-failure principle): Plew does not implicitly
// return a function's tail expression, so a non-`()` function whose body can reach
// the end without `return`/`panic`/divergence would silently return uninitialized
// memory. Reject that loudly. A block "always diverges" if any of its statements
// does (control then never falls through to the block's end); a statement diverges
// if it is `return`/`panic`, an `if`/`else` whose both branches diverge, an
// (exhaustive) `match` whose every arm diverges, or an unconditional infinite loop
// (`while true { … }` with no `break` that exits it).
