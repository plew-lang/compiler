// Part of compile-time checks (root: _.pw): import and use-site visibility
// constraints.

// Is `(nameStart,nameLen)` the name of an `export`ed declaration (spec/15)? Matched
// by text against the recorded export name spans (across all loaded modules).

pub impl Comp {
    inout fn isExportedName(nameStart: U64, nameLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports[i]
            if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: nameStart, bLen: nameLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // Is `(nameStart,nameLen)` exported BY the specific module `mod` (spec/15)? Unlike
    // `isExportedName` (which asks "does SOME module export this text"), this pins the
    // exporting module: an export entry's `nameStart` is the exported decl's real source
    // offset (free fn / global / newtype / re-export name all keep their original offset —
    // only struct/enum names are re-interned, and those go through type visibility, not
    // this free-fn path), so `moduleOf(e.nameStart)` recovers the module that exported it.
    // This is the (name, module) pairing that keeps a private same-named decl in another
    // module from riding an unrelated module's export of the same text.
    inout fn isExportedFromModule(mod: U64, nameStart: U64, nameLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports[i]
            if self.moduleOf(offset: e.nameStart) == mod {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: nameStart, bLen: nameLen) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Module visibility (spec/15): every name brought in by `import … with { }` must be
    // part of some loaded module's public surface (`export`). A use of a non-exported
    // name — or an import from the wrong module (whose own module then isn't loaded, so
    // the name is absent from the exported set) — is a compile error.
    inout fn checkImports() {
        mut val i: U64 = 0
        while i < self.modules.imports.count() {
            val im: Bind = self.modules.imports[i]
            if !(self.isExportedName(nameStart: im.nameStart, nameLen: im.nameLen)) {
                self.errorAt(offset: im.nameStart, msg: "imported name is not exported (mark it `export` in its module, or import it from the right module)")
            }
            i += 1
        }
    }

    // Was the name `(nameStart,nameLen)` imported into module `mod` via `import … with`?
    inout fn isImportedInto(mod: U64, nameStart: U64, nameLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.imports.count() {
            val im: Bind = self.modules.imports[i]
            if im.fieldStart == mod {
                if spansEqual(c: inout self, aStart: im.nameStart, aLen: im.nameLen, bStart: nameStart, bLen: nameLen) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Use-site diagnostic arm of scoped resolution (spec/15). Selection is already scoped
    // (`findFunc` only returns a callee visible from the call's module = same module, or
    // imported+exported). This pass turns the *failure* to resolve in scope into a good
    // error: if a free fn of this name exists in ANOTHER loaded module, the use needs an
    // import. A same-module match (e.g. wrong labels, reported elsewhere) or no match at
    // all (local / closure / builtin) is left alone — except `@Std` intrinsics the backend
    // intercepts by raw name (print / write / exit / …), which are not ambient and must be
    // imported too. Types are scoped separately (their resolution sites); member/method
    // visibility is a separate axis.
    inout fn checkUseVisibility() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Call(val nameStart, val nameLen, val args) => {
                    val useMod: U64 = self.moduleOf(offset: nameStart)
                    // The name is in scope iff some free fn of this name is visible from the
                    // call's module (scoped resolution). If so, any remaining mismatch is an
                    // overload/label/type error reported elsewhere — not a visibility issue.
                    if self.firstVisibleFuncByName(useMod: useMod, nameStart: nameStart, nameLen: nameLen) >= self.arena.funcs.count() {
                        if self.firstFuncByName(nameStart: nameStart, nameLen: nameLen) < self.arena.funcs.count() {
                            // a free fn of this name exists only in other (loaded) modules and
                            // was not imported here — the use needs an import.
                            self.errorAt(offset: nameStart, msg: "use of a function from another module without importing it (add `import … with { … }`)")
                        } else {
                            // no free fn of this name anywhere: a local/closure/builtin, or an
                            // `@Std` intrinsic the backend intercepts by raw name (print /
                            // write / exit / …). The latter is NOT ambient (spec/15: only lang
                            // items are) and must be imported.
                            if self.isAmbientInterceptedName(start: nameStart, len: nameLen) {
                                if !(self.isImportedInto(mod: useMod, nameStart: nameStart, nameLen: nameLen)) {
                                    self.errorAt(offset: nameStart, msg: "this @Std function is not ambient — import it (e.g. `import @Std/Io with { print }`); only lang items are usable without import (spec/15)")
                                }
                            }
                        }
                    } else {
                        // a free fn of this name IS visible, but the call's labels may match only
                        // a same-named fn PRIVATE to another module (an imported same-named export
                        // shadows the name by text). `findFunc` correctly rejects it — report the
                        // (name, module) visibility failure cleanly instead of an opaque backend
                        // error (spec/15).
                        if self.labelMatchOnlyInvisible(useMod: useMod, nameStart: nameStart, nameLen: nameLen, args: args) {
                            self.errorAt(offset: nameStart, msg: "this call matches only a function that is not visible here — it is private to another module (spec/15: a private free fn is not reachable through an unrelated module's same-named export)")
                        }
                    }
                    i += 1
                }
                _ => { i += 1 }
            }
        }
    }

    // Is a user type declaration named (start,len) VISIBLE from module `useMod` (scoped
    // resolution: same module, or imported+exported)? A type decl's OWN module comes from
    // its `defOffset` (a real source offset) — its `nameStart` is re-interned (module 0)
    // and cannot serve `moduleOf`. The import side is keyed by the name text (the use-site
    // span and the import record share it), independent of which decl matched.
    // Is a type declaration whose own module is `moduleOf(defOffset)` visible to a use in
    // module `useMod`? Only the same module is visible on this axis; cross-module visibility
    // goes through the import side (`isImportedInto` + `isExportedName`) in the caller. Ambient
    // lang-item TYPES are handled separately by `isAmbientInLang` at the type site (= @Std/Lang's
    // export surface) — no OTHER module is "ambient" as a whole (spec/15).
    inout fn defModuleVisible(defOffset: U64, useMod: U64) -> Bool {
        return self.moduleOf(offset: defOffset) == useMod
    }

    inout fn typeDeclVisibleFrom(useMod: U64, start: U64, len: U64) -> Bool {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = 0
        while i < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[i]
            if sd.nameId == qId {
                if self.defModuleVisible(defOffset: sd.defOffset, useMod: useMod) { return true }
            }
            i += 1
        }
        i = 0
        while i < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[i]
            if ed.nameId == qId {
                if self.defModuleVisible(defOffset: ed.defOffset, useMod: useMod) { return true }
            }
            i += 1
        }
        i = 0
        while i < self.decls.traits.count() {
            val td: TraitDef = self.decls.traits[i]
            if td.nameId == qId {
                if self.defModuleVisible(defOffset: td.nameStart, useMod: useMod) { return true }
            }
            i += 1
        }
        i = 0
        while i < self.arena.newtypes.count() {
            val nt: NewtypeDef = self.arena.newtypes[i]
            if spansEqual(c: inout self, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) {
                if self.defModuleVisible(defOffset: nt.defOffset, useMod: useMod) { return true }
            }
            i += 1
        }
        // imported into useMod from a module that exports it (name-text keyed)
        if self.isImportedInto(mod: useMod, nameStart: start, nameLen: len) {
            if self.isExportedName(nameStart: start, nameLen: len) { return true }
        }
        return false
    }

    // Does a user type declaration named (start,len) exist in ANY loaded module? (Used to
    // tell a genuine out-of-scope type from a type parameter / Self / associated type,
    // which have no global declaration.)
    inout fn typeDeclExistsGlobally(start: U64, len: U64) -> Bool {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        if self.anyStructIndex(nameStart: start, nameLen: len) < self.arena.structs.count() { return true }
        if self.anyEnumIndex(nameStart: start, nameLen: len) < self.arena.enums.count() { return true }
        mut val i: U64 = 0
        while i < self.decls.traits.count() {
            val td: TraitDef = self.decls.traits[i]
            if td.nameId == qId { return true }
            i += 1
        }
        i = 0
        while i < self.arena.newtypes.count() {
            val nt: NewtypeDef = self.arena.newtypes[i]
            if spansEqual(c: inout self, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) { return true }
            i += 1
        }
        return false
    }

    // Check one user-written type name (head span start,len) written at real source offset
    // `siteOffset`. It must resolve to a declaration in scope of `siteOffset`'s module (same
    // module, or imported+exported). Lang-item types are ambient. A type-parameter head was
    // already excluded at lowering (its TypeRef carries siteOffset 0, so the walk never reaches
    // here); `Self` / associated types have no global declaration, so the existence gate skips
    // them silently. A genuine out-of-scope type — one that exists in another module but isn't
    // imported — is the loud error.
    // Resolve a module-local import alias `import M with { Real as Alias }` to `Real`, scoped
    // to module `useMod` (the use site's module from its real siteOffset — the type-name span is
    // re-interned, so the alias's own moduleOf must be compared against useMod). Returns the real
    // name span, or the input unchanged when no alias of this module matches. c.modules.imports /
    // exports are keyed by the REAL name, so resolving first lets the ordinary visibility check
    // (imported + exported) succeed for an aliased type use.
    inout fn realTypeNameInModule(useMod: U64, start: U64, len: U64) -> Bind {
        mut val ai: U64 = 0
        while ai < self.decls.importAliases.count() {
            val al: Bind = self.decls.importAliases[ai]
            if spansEqual(c: inout self, aStart: al.nameStart, aLen: al.nameLen, bStart: start, bLen: len) {
                if self.moduleOf(offset: al.nameStart) == useMod {
                    return <Bind nameStart=al.fieldStart nameLen=al.fieldLen fieldStart=al.fieldStart fieldLen=al.fieldLen />
                }
            }
            ai += 1
        }
        return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
    }

    inout fn checkTypeName(siteOffset: U64, start: U64, len: U64) {
        if len == 0 { return }
        if self.isAmbientInLang(start: start, len: len) { return }
        val useMod: U64 = self.moduleOf(offset: siteOffset)
        // a `Real as Alias` use resolves to Real (imports/exports are keyed by the real name).
        val real: Bind = self.realTypeNameInModule(useMod: useMod, start: start, len: len)
        if self.typeDeclVisibleFrom(useMod: useMod, start: real.nameStart, len: real.nameLen) { return }
        if self.typeDeclExistsGlobally(start: real.nameStart, len: real.nameLen) {
            self.errorAt(offset: siteOffset, msg: "use of a type from another module without importing it (add `import … with { … }`)")
        }
    }

    // Type-side diagnostic arm of scoped resolution (spec/15), as a single choke-point pass:
    // EVERY user-written type annotation in the program is one TypeRef in c.arena.types,
    // stamped by the sole lowering choke point `lowerType` with its real source offset
    // (siteOffset). So one uniform walk covers every site — function params/returns, struct &
    // enum fields, local `val x: T`, newtype underlyings, trait requirement signatures, `as`
    // casts, explicit type arguments, closure signatures, and any future syntax — with no site
    // left to enumerate by hand. Generic arguments need no special recursion: each is itself a
    // TypeRef in the arena, visited by the same loop. siteOffset 0 marks a synthetic TypeRef
    // (compiler-built) or a type-parameter head — both skipped.
    inout fn checkTypeVisibility() {
        mut val i: U64 = 0
        while i < self.arena.types.count() {
            val t: TypeRef = self.arena.types[i]
            if t.siteOffset != 0U64 {
                if self.offsetIsLoaded(offset: t.siteOffset) {
                    self.checkTypeName(siteOffset: t.siteOffset, start: t.nameStart, len: t.nameLen)
                }
            }
            i += 1
        }
    }
}

pub impl Comp {

    // The module that DEFINES the name (start,len): a free function's own module, or a
    // type declaration's module (via defOffset / nameStart, since type nameStart is
    // re-interned). importCycleSentinel() if no such declaration is loaded. Used to turn an
    // `import … with { name }` record into a module→module dependency edge.
    inout fn definingModuleOfName(start: U64, len: U64) -> U64 {
        val fi: U64 = self.firstFuncByName(nameStart: start, nameLen: len)
        if fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            return self.moduleOf(offset: f.nameStart)
        }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = 0
        while i < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[i]
            if sd.nameId == qId {
                if sd.defOffset != 0U64 { return self.moduleOf(offset: sd.defOffset) }
            }
            i += 1
        }
        i = 0
        while i < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[i]
            if ed.nameId == qId {
                if ed.defOffset != 0U64 { return self.moduleOf(offset: ed.defOffset) }
            }
            i += 1
        }
        i = 0
        while i < self.decls.traits.count() {
            val td: TraitDef = self.decls.traits[i]
            if td.nameId == qId { return self.moduleOf(offset: td.nameStart) }
            i += 1
        }
        i = 0
        while i < self.arena.newtypes.count() {
            val nt: NewtypeDef = self.arena.newtypes[i]
            if spansEqual(c: inout self, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) {
                if nt.defOffset != 0U64 { return self.moduleOf(offset: nt.defOffset) }
            }
            i += 1
        }
        return importCycleSentinel()
    }
}

pub impl Comp {

    // DFS over the module import graph (colors: 0=white, 1=gray/on-stack, 2=black). A gray
    // target is a back edge → a circular import; report it at the offending import.
    inout fn dfsImportCycle(node: U64, color: inout Array[U64], ef: Array[U64], et: Array[U64], eo: Array[U64]) {
        color[node] = 1U64
        mut val k: U64 = 0
        while k < ef.count() {
            if ef[k] == node {
                val w: U64 = et[k]
                if color[w] == 1U64 {
                    self.errorAt(offset: eo[k], msg: "circular import: the module import graph must be acyclic (spec/15). A cycle means these files are logically one module — join them with `part` instead of `import`.")
                }
                if color[w] == 0U64 {
                    self.dfsImportCycle(node: w, color: inout color, ef: ef, et: et, eo: eo)
                }
            }
            k += 1
        }
        color[node] = 2U64
    }

    // Enforce the DAG rule (spec/15): the module `import` graph must have no cycle. Each
    // `import … with { name }` becomes an edge importing-module → defining-module-of-name;
    // a cycle among them is a compile error (parts share a module id, so they never form an
    // inter-module edge).
    inout fn detectImportCycles() {
        mut val maxId: U64 = 0
        mut val ri: U64 = 0
        while ri < self.modules.ranges.count() {
            val r: Bind = self.modules.ranges[ri]
            if r.fieldStart > maxId { maxId = r.fieldStart }
            ri += 1
        }
        val n: U64 = maxId + 1
        mut val ef: Array[U64] = []
        mut val et: Array[U64] = []
        mut val eo: Array[U64] = []
        mut val ii: U64 = 0
        while ii < self.modules.imports.count() {
            val im: Bind = self.modules.imports[ii]
            val from: U64 = im.fieldStart
            val to: U64 = self.definingModuleOfName(start: im.nameStart, len: im.nameLen)
            if to != importCycleSentinel() {
                if to != from {
                    ef.append(from)
                    et.append(to)
                    eo.append(im.nameStart)
                }
            }
            ii += 1
        }
        mut val color: Array[U64] = []
        mut val ci: U64 = 0
        while ci < n {
            color.append(0U64)
            ci += 1
        }
        mut val s: U64 = 0
        while s < n {
            if color[s] == 0U64 {
                self.dfsImportCycle(node: s, color: inout color, ef: ef, et: et, eo: eo)
            }
            s += 1
        }
    }

    // Is (start,len) the name of an `@Std` function the LLVM backend intercepts by raw
    // name (so it would emit without an import)? These need a real import gate (spec/15):
    // the user-facing I/O / process / async intrinsics. (The Buffer/String/FFI floor
    // intrinsics are resolved through their loaded `extern` decls, so they fall under
    // the ordinary import check above and are not listed here.)
    inout fn isAmbientInterceptedName(start: U64, len: U64) -> Bool {
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "print") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "eprint") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "write") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "writeByte") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "readStdin") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "readFile") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "readFileBytes") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "fileExists") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "sleep") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "exit") { return true }
        // `assert` is a @Std/Core function (not a lang item): now that Core is ambient
        // (force-loaded), it resolves, but spec keeps it import-required, so gate it here.
        if rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "assert") { return true }
        return false
    }
}

// Missing-return check (spec/11, loud-failure principle): Plew does not implicitly
// return a function's tail expression, so a non-`()` function whose body can reach
// the end without `return`/`panic`/divergence would silently return uninitialized
// memory. Reject that loudly. A block "always diverges" if any of its statements
// does (control then never falls through to the block's end); a statement diverges
// if it is `return`/`panic`, an `if`/`else` whose both branches diverge, an
// (exhaustive) `match` whose every arm diverges, or an unconditional infinite loop
// (`while true { … }` with no `break` that exits it).
