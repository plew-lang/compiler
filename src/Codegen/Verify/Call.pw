// Part of the acceptance verification pass (root: _.pw): call/method argument
// categories, enum-variant existence, and match-arm enum checks.

// The interned head-name id of a struct/enum type named (start,len), or 0 when it is
// not a known struct/enum (a primitive, a type variable, or an unrecovered name).
// Two same-type generic instances recover to the same head name -> same id, so an
// id comparison never false-rejects them; a 0 result means "don't know" and is
// treated as compatible (conservative — only definite mismatches are rejected).
// `extern(c)` opaque handle types (`type LLVMTypeRef`) also yield 0: they are FFI
// escape-hatch types, all lowered to `void*`, and treated as interchangeable at this
// boundary (the spec's value-semantics / no-conversion rules govern Plew types, not
// opaque C handles — and the compiler's own LLVM bindings rely on this, e.g. using an
// LLVMValueRef null as an LLVMTypeRef "none" sentinel).

pub impl Comp {
    // Generic bodies are verified against their declared trait bounds.  This
    // deliberately returns a requirement signature, never a concrete witness:
    // the latter belongs to Mono after T is instantiated.  Keeping the two
    // phases distinct prevents unrelated concrete conformance paths from
    // changing whether `fn f[T](x: T) where T: R { x.r() }` is well formed.
    inout fn verifyBoundMethodCall(fnIdx: U64, receiverRef: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[Bool, CompileDiagnostic] {
        if receiverRef == 0U64 || fnIdx >= self.arena.functionCount() { return <Result.Ok value=false /> }
        val resolution = (try self.staticMemberResolution(fnIdx: fnIdx, receiverRef: receiverRef, nameStart: nameStart, nameLen: nameLen, args: args))
        match resolution {
            StaticMemberResolution.Requirement(val proof, val traitIdx, val reqIdx) => {
                // Only symbolic proofs own declaration-time argument types.
                // Concrete witnesses retain the ordinary callable checks.
                mut val symbolic = false
                match proof {
                    StaticConformanceProof.AssumedBound(boundIdx: _) => { symbolic = true }
                    StaticConformanceProof.AssumedSupertraitPath(boundIdx: _, traits: _) => { symbolic = true }
                    StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: _, traitArgs: _) => { symbolic = true }
                    _ => {}
                }
                if !symbolic { return <Result.Ok value=false /> }
                val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: traitIdx).reqs, index: reqIdx)
                mut val index = 0U64
                while index < args.len {
                    val parameterIndex = self.paramIndexForArg(params: requirement.params, args: args, argIdx: index)
                    if parameterIndex < requirement.params.count() {
                        val parameter = self.funcParamAt(params: requirement.params, index: parameterIndex)
                        val argument = self.argAt(args: args, index: index)
                        try self.checkArgInoutMode(p: parameter, arg: argument)
                        try self.tcCheckValue(expectedRef: self.staticRequirementParamType(resolution: resolution, args: args, argIdx: index), valueExpr: argument.expr, pos: "arg")
                    }
                    index += 1U64
                }
                return <Result.Ok value=true />
            }
            _ => { return <Result.Ok value=false /> }
        }
    }

    inout fn knownNamedTypeId(start: U64, len: U64) -> U64 {
        // an import alias (`with { Real as Alias }`) denotes the same type identity as
        // `Real`: resolve so a value typed via its alias and one via the real name compare
        // equal, and so an enum match arm written with the alias name resolves (spec/15).
        val ar: Bind = self.aliasReal(start: start, len: len)
        val q: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        val si: U64 = self.structIndexByName(start: ar.nameStart, len: ar.nameLen)
        if si < self.arena.structCount() {
            if self.arena.structAt(index: si).isCExtern {
                return 0U64
            }
            return q
        }
        mut val ei: U64 = 0
        while ei < self.arena.enumCount() {
            if self.arena.enumAt(index: ei).nameId == q {
                return q
            }
            ei += 1
        }
        // a `newtype` (spec/10) is a distinct named type: give it its own id so the type
        // checker keeps it apart from its underlying (`val x: I64 = meter` needs `as`).
        mut val ni: U64 = 0
        while ni < self.arena.newtypeCount() {
            if self.arena.newtypeAt(index: ni).nameId == q {
                return q
            }
            ni += 1
        }
        return 0U64
    }

    // Final argument-type validation operates on the already source-selected
    // callable.  Bare and `#` method calls must not rediscover candidates by
    // different rules after resolution.
    inout fn checkResolvedMethodArgCategories(mf: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if mf >= self.arena.functionCount() { return <Result.Ok value=() /> }
        val cf: Func = self.arena.functionAt(index: mf)
        // Generic and provided methods need their resolved substitution before
        // this conservative non-generic category checker can compare values.
        // Preserve the ordinary-method boundary; this helper only removes the
        // source-selection split, it does not invent a second generic checker.
        if cf.typeParams.count() > 0U64 { return <Result.Ok value=() /> }
        if !(self.paramsLabelsOk(params: cf.params, args: args)) { return <Result.Ok value=() /> }
        mut val ai: U64 = 0U64
        while ai < args.len {
            val pIdx: U64 = self.paramIndexForArg(params: cf.params, args: args, argIdx: ai)
            if pIdx < cf.params.count() {
                try self.tcCheckValue(expectedRef: self.funcParamAt(params: cf.params, index: pIdx).ty, valueExpr: self.argAt(args: args, index: ai).expr, pos: "arg")
            }
            ai += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkResolvedMethodArgs(mf: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if mf >= self.arena.functionCount() { return <Result.Ok value=() /> }
        val cf: Func = self.arena.functionAt(index: mf)
        if !(self.paramsLabelsOk(params: cf.params, args: args)) { return <Result.Ok value=() /> }
        mut val ai: U64 = 0U64
        while ai < args.len {
            val pIdx: U64 = self.paramIndexForArg(params: cf.params, args: args, argIdx: ai)
            if pIdx < cf.params.count() {
                try self.checkArgInoutMode(p: self.funcParamAt(params: cf.params, index: pIdx), arg: self.argAt(args: args, index: ai))
            }
            ai += 1U64
        }
        try self.checkResolvedMethodArgCategories(mf: mf, args: args)
        return <Result.Ok value=() />
    }

    inout fn checkMethodArgCategories(recv: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        val rt: TypeInfo = (try self.typeOf(id: recv))
        if rt.kind != 2 {
            return <Result.Ok value=() />
        }
        val rId: U64 = self.knownNamedTypeId(start: rt.nameStart, len: rt.nameLen)
        if rId == 0U64 {
            return <Result.Ok value=() />
        }
        val nq: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val theFi: U64 = self.arena.functionCount()
        mut val count: U64 = 0
        mut val anyOther: Bool = false
        mut val fi: U64 = 0
        while fi < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: fi)
            if f.hasRecv && f.nameId == nq && f.recvId == rId {
                if f.typeParams.count() > 0U64 || f.isProvided || f.extId != 0U64 {
                    anyOther = true
                } else {
                    count += 1U64
                    theFi = fi
                }
            }
            fi += 1
        }
        if anyOther || count != 1U64 {
            return <Result.Ok value=() />
        }
        try self.checkResolvedMethodArgCategories(mf: theFi, args: args)
        return <Result.Ok value=() />
    }

    inout fn checkCallArgCategories(nameStart: U64, nameLen: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        val q: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val theFi: U64 = self.arena.functionCount()
        mut val count: U64 = 0
        mut val anyGen: Bool = false
        mut val fi: U64 = 0
        while fi < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: fi)
            if f.nameId == q && !f.hasRecv && !f.isExtern {
                if f.typeParams.count() > 0U64 {
                    anyGen = true
                } else {
                    count += 1U64
                    theFi = fi
                }
            }
            fi += 1
        }
        if anyGen || count != 1U64 {
            return <Result.Ok value=() />
        }
        val cf: Func = self.arena.functionAt(index: theFi)
        if !(self.paramsLabelsOk(params: cf.params, args: args)) {
            return <Result.Ok value=() />
        }
        mut val ai: U64 = 0
        while ai < args.len {
            val pIdx: U64 = self.paramIndexForArg(params: cf.params, args: args, argIdx: ai)
            if pIdx < cf.params.count() {
                try self.tcCheckValue(expectedRef: self.funcParamAt(params: cf.params, index: pIdx).ty, valueExpr: self.argAt(args: args, index: ai).expr, pos: "arg")
            }
            ai += 1
        }
        return <Result.Ok value=() />
    }

    inout fn variantExists(enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> Bool {
        // resolve an import alias (`with { Real as Alias }`) so a match arm written with the
        // enum's alias name finds the real enum's variants (spec/15).
        val arE: Bind = self.aliasReal(start: enumStart, len: enumLen)
        val qEnum: U64 = intern(c: inout self, start: arE.nameStart, len: arE.nameLen)
        val qVar: U64 = intern(c: inout self, start: variantStart, len: variantLen)
        mut val ei: U64 = 0
        while ei < self.arena.enumCount() {
            if self.arena.enumAt(index: ei).nameId == qEnum {
                val vars: Array[Variant] = self.arena.enumAt(index: ei).variants
                mut val vi: U64 = 0
                while vi < vars.count() {
                    if vars[vi].nameId == qVar {
                        return true
                    }
                    vi += 1
                }
            }
            ei += 1
        }
        return false
    }

    inout fn checkMatchArmsEnum(scrut: U64, arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        val st0: TypeInfo = (try self.typeOf(id: scrut))
        if st0.kind != 2 {
            return <Result.Ok value=() />
        }
        val sId: U64 = self.knownNamedTypeId(start: st0.nameStart, len: st0.nameLen)
        if sId == 0U64 {
            return <Result.Ok value=() />
        }
        mut val ai: U64 = 0
        while ai < arms.len {
            val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
            if !(a.isWildcard || a.isStruct || a.enumLen == 0U64) {
                val aId: U64 = self.knownNamedTypeId(start: a.enumStart, len: a.enumLen)
                if aId != 0U64 && aId != sId {
                    return <Result.Err error=self.diagnosticAt(offset: a.enumStart, msg: "this match arm pattern is a variant of a different enum than the value being matched") />
                } else {
                    // the named variant must exist on the enum (`Optional.Other` is not a
                    // variant of Optional) — else the arm is unreachable and the match's
                    // exhaustiveness count is wrong.
                    if a.variantLen > 0U64 {
                        if !(self.variantExists(enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen)) {
                            return <Result.Err error=self.diagnosticAt(offset: a.variantStart, msg: "unknown variant: this enum has no such variant") />
                        }
                    }
                }
            }
            ai += 1
        }
        return <Result.Ok value=() />
    }
}
