// Part of the acceptance verification pass (root: _.pw): call/method argument
// categories, enum-variant existence, and match-arm enum checks.

// The interned head-name id of a struct/enum type named (start,len), or 0 when it is
// not a known struct/enum (a primitive, a type variable, or an unrecovered name).
// Two same-type generic instances recover to the same head name -> same id, so an
// id comparison never false-rejects them; a 0 result means "don't know" and is
// treated as compatible (conservative — only definite mismatches are rejected).
// `extern(c)` opaque handle types (`type LLVMTypeRef`) also yield 0: they are FFI
// escape-hatch types, all lowered to `void*`, and treated as interchangeable at this
// boundary (the spec's value-semantics / no-conversion rules govern Plew types, not
// opaque C handles — and the compiler's own LLVM bindings rely on this, e.g. using an
// LLVMValueRef null as an LLVMTypeRef "none" sentinel).

pub impl Comp {
    inout fn knownNamedTypeId(start: U64, len: U64) -> U64 {
        val declaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: start), start: start, len: len)
        if declaration.nameLen == 0U64 { return 0U64 }
        return self.knownNamedTypeIdAt(offset: declaration.nameStart)
    }

    inout fn knownNamedTypeIdForTerm(type: TypeTerm) -> U64 {
        if type.hasDecl { return self.knownNamedTypeIdAt(offset: type.declOffset) }
        return self.knownNamedTypeId(start: type.nameStart, len: type.nameLen)
    }

    inout fn knownNamedTypeIdAt(offset: U64) -> U64 {
        val si = self.arena.structIndexByOffset(offset: offset)
        if si < self.arena.structCount() {
            val type = self.arena.structAt(index: si)
            if type.isCExtern || type.typeParams.count() != 0U64 { return 0U64 }
            return type.nameId
        }
        val ei = self.arena.enumIndexByOffset(offset: offset)
        if ei < self.arena.enumCount() { return self.arena.enumAt(index: ei).nameId }
        match self.arena.newtypeNameByOffset(offset: offset) {
            Optional.Some(v: val name) => { return intern(c: inout self, start: name.start, len: name.len) }
            Optional.None => {}
        }
        return 0U64
    }

    // Final argument-type validation operates on the already source-selected
    // callable.  Bare and `#` method calls must not rediscover candidates by
    // different rules after resolution.
    inout fn checkSelectedMethodArgCategories(exprId: U64, function: Func, environment: InstanceEnvironment, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if !(self.paramsLabelsOk(params: function.params, args: args)) { return <Result.Ok value=() /> }
        mut val ai: U64 = 0U64
        while ai < args.len {
            val pIdx: U64 = self.paramIndexForArg(params: function.params, args: args, argIdx: ai)
            if pIdx < function.params.count() {
                val parameter = try self.groundTermForBody(ref: self.funcParamAt(params: function.params, index: pIdx).ty, environment: environment, selfRef: environment.receiverRef, itemRef: (try self.finalMethodItemRef(f: function, receiverRef: environment.receiverRef)))
                try self.tcCheckValue(expectedRef: parameter, valueExpr: self.argAt(args: args, index: ai).expr, pos: "arg")
            }
            ai += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn checkSelectedMethodArguments(exprId: U64, function: Func, environment: InstanceEnvironment, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if !(self.paramsLabelsOk(params: function.params, args: args)) { return <Result.Ok value=() /> }
        mut val ai: U64 = 0U64
        while ai < args.len {
            val pIdx: U64 = self.paramIndexForArg(params: function.params, args: args, argIdx: ai)
            if pIdx < function.params.count() {
                try self.checkArgInoutMode(p: self.funcParamAt(params: function.params, index: pIdx), arg: self.argAt(args: args, index: ai))
            }
            ai += 1U64
        }
        try self.checkSelectedMethodArgCategories(exprId: exprId, function: function, environment: environment, args: args)
        return <Result.Ok value=() />
    }

    inout fn checkEmptyMatchSubject(scrut: U64, arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        val st0: TypeInfo = (try self.typeOf(id: scrut))
        if arms.len == 0U64 {
            val scrutineeType = self.typedIrRefOfInfo(ti: st0)
            val enumIndex = self.enumIndexForType(ref: scrutineeType)
            if enumIndex < self.arena.enumCount() {
                if self.arena.enumAt(index: enumIndex).variants.count() == 0U64 {
                    return <Result.Ok value=() />
                }
            }
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: scrut), msg: "an empty match requires an empty enum") />
        }
        return <Result.Ok value=() />
    }

}
