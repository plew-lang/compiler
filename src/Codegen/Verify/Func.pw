// Part of the acceptance verification pass (root: _.pw): per-function and
// per-block verification plus the move-tracking bookkeeping it relies on.

pub impl Comp {
    inout fn verifyFunc(f: Func) {
        if f.hasRet {
            self.cur.retVoid = false
            mut val rStart: U64 = f.retStart
            mut val rLen: U64 = f.retLen
            mut val rTy: U64 = f.retTy
            mut val rArr: Bool = f.retIsArray
            // an async fn's body returns the Promise's INNER type (`return n` yields I64
            // even for `-> Promise[I64]`; the implicit `-> I64` form is already the inner
            // type). Unwrap an explicitly-written Promise[T] to T so the return check uses
            // T. (tcCheckValue handles a literal/array return against the inner ref.)
            if f.isAsync {
                if rangeEquals(bytes: self.arena.bytes, start: rStart, len: rLen, kw: "Promise") {
                    if rTy != 0U64 {
                        if rTy < self.arena.types.count {
                            val pt: TypeRef = self.arena.types[rTy]
                            if pt.args.count >= 1U64 {
                                val innerRef: U64 = pt.args[0]
                                rTy = innerRef
                                rArr = false
                                if innerRef < self.arena.types.count {
                                    rStart = self.arena.types[innerRef].nameStart
                                    rLen = self.arena.types[innerRef].nameLen
                                }
                            }
                        }
                    }
                }
            }
            self.cur.retStart = rStart
            self.cur.retLen = rLen
            self.cur.retIsArray = rArr
            self.cur.retTy = rTy
        } else {
            self.cur.retVoid = true
            self.cur.retStart = 0
            self.cur.retLen = 0
            self.cur.retIsArray = false
            self.cur.retTy = 0
        }
        self.cur.hasRecv = f.hasRecv
        self.cur.recvStart = f.recvStart
        self.cur.recvLen = f.recvLen
        self.cur.selfInout = f.selfInout
        self.cur.selfMove = f.selfMove
        if f.hasRecv {
            self.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0)
        } else {
            self.clearSelfItemEnv()
        }
        self.cur.branchBase = 0
        self.cur.locals = []
        self.cur.verifyMovedIdx = []
        self.seedGlobalLocals()
        self.checkGenericArity(ref: f.retTy, offset: f.nameStart)
        mut val pi: U64 = 0
        while pi < f.params.count {
            val p: Param = f.params[pi]
            self.checkGenericArity(ref: p.ty, offset: p.nameStart)
            self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: p.isMove)
            pi += 1
        }
        self.verifyBlock(blockId: f.body)
    }

    inout fn verifyMarkMoved(idx: U64) {
        mut val i: U64 = 0
        while i < self.cur.verifyMovedIdx.count {
            if self.cur.verifyMovedIdx[i] == idx {
                return
            }
            i += 1
        }
        self.cur.verifyMovedIdx.append(idx)
    }

    inout fn verifyIsMoved(idx: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.cur.verifyMovedIdx.count {
            if self.cur.verifyMovedIdx[i] == idx {
                return true
            }
            i += 1
        }
        return false
    }

    inout fn verifyUnmarkMoved(idx: U64) {
        mut val kept: Array[U64] = []
        mut val i: U64 = 0
        while i < self.cur.verifyMovedIdx.count {
            if self.cur.verifyMovedIdx[i] != idx {
                kept.append(self.cur.verifyMovedIdx[i])
            }
            i += 1
        }
        self.cur.verifyMovedIdx = kept
    }

    inout fn verifyDropMovedAbove(mark: U64) {
        mut val kept: Array[U64] = []
        mut val i: U64 = 0
        while i < self.cur.verifyMovedIdx.count {
            if self.cur.verifyMovedIdx[i] < mark {
                kept.append(self.cur.verifyMovedIdx[i])
            }
            i += 1
        }
        self.cur.verifyMovedIdx = kept
    }

    inout fn verifyBlock(blockId: U64) {
        val mark: U64 = self.scopeMark()
        val b: Block = self.arena.blocks[blockId]
        mut val i: U64 = 0
        while i < b.stmts.count {
            self.verifyStmt(stmtId: b.stmts[i])
            i += 1
        }
        self.popLocals(mark: mark)
        self.verifyDropMovedAbove(mark: mark)
    }

    inout fn checkCondBool(cond: U64) {
        val bs: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
        if bs.nameLen == 0U64 {
            return
        }
        val boolRef: U64 = self.simpleTypeRef(nameStart: bs.nameStart, nameLen: bs.nameLen)
        self.tcCheckValue(expectedRef: boolRef, valueExpr: cond, pos: "condition")
    }

    inout fn exprIsUnit(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Make(typeStart: _, val typeLen, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                return typeLen == 0U64 && fields.count == 0U64
            }
            _ => {
                return false
            }
        }
    }

    inout fn checkIndexKeyType(base: U64, index: U64) {
        val bt: TypeInfo = self.typeOf(id: base)
        if bt.ref != 0U64 {
            if bt.ref < self.arena.types.count {
                val t: TypeRef = self.arena.types[bt.ref]
                if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Dictionary") {
                    if t.args.count >= 1U64 {
                        self.tcCheckValue(expectedRef: t.args[0], valueExpr: index, pos: "dict key")
                    }
                }
            }
        }
    }

    inout fn valueIsReliablyNonArray(value: U64) -> Bool {
        match self.arena.exprs[value] {
            Expr.Array(elems: _) => { return false }
            Expr.Int(value: _, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => { return true }
            Expr.Str(start: _, len: _) => { return true }
            _ => {
                val it: TypeInfo = self.typeOf(id: value)
                if it.kind == 1 {
                    return true
                }
                if it.kind == 2 {
                    return true
                }
                return false
            }
        }
    }
}
