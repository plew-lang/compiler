// Part of the acceptance verification pass (root: _.pw): statement-level
// verification (verifyStmt) and assignment type/mutability checks.

pub impl Comp {
    inout fn verifyStmt(stmtId: U64) {
        match self.arena.stmts[stmtId] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                // literal range against the annotation (or context-free if none).
                if tyLen > 0U64 {
                    self.checkLitSpanCtx(id: init, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, ctxRef: ty)
                } else {
                    self.checkLitCtx(id: init, eKind: 0, eBits: 0, eSgn: false)
                }
                // a bare unique place on the rhs is a forbidden copy (`val g = f`).
                self.checkUniquePlaceCopy(exprId: init, inoutOk: false)
                self.verifyExpr(id: init)
                // a record-destructure statement lowered to this temp Let: check its
                // bind list against the record's fields (spec/03 — the locals env is
                // live here, so a variable initializer types).
                self.checkDestructureSite(initId: init, isElem: false)
                // an explicit annotation whose category clearly disagrees with the
                // initializer reinterprets the bits — a hidden-meaning bug (`val x: I64 =
                // "s"` / `val a: A = <B…/>`). Reject only when the INITIALIZER is RELIABLY
                // typed: a String (kind 1) or a value of a KNOWN struct/enum (kind 2 whose
                // name resolves). typeOf returns kind 0 (numeric) BOTH for a real int AND
                // as an unrecovered default (a fn-value ref, a dict literal, a call), so an
                // init reported numeric is never trusted as a mismatch source (that sank the
                // first attempt — fn_value / dict / a call false-rejected). Skip arrays
                // (separate machinery) and floats (typeOf wobbles float literal vs local).
                self.checkGenericArity(ref: ty, offset: nameStart)
                // declared an array but initialized with a non-array (`val a: Array[I64] =
                // 5I64`) reinterprets the scalar bits as an array — a definite mismatch.
                if tyIsArray {
                    if self.valueIsReliablyNonArray(value: init) {
                        self.errorAt(offset: self.exprOffset(id: init), msg: "this binding is declared as an array, but the value is not an array (Plew has no implicit conversion — spec/12)")
                    }
                }
                if tyLen > 0U64 {
                    self.tcCheckValue(expectedRef: ty, valueExpr: init, pos: "let")
                    // an array binding's literal elements (`Array[I64] = ["a", "b"]`):
                    // category-check each element against the declared element type (tyStart
                    // names the element for an array annotation).
                    if tyIsArray {
                        match self.arena.exprs[init] {
                            Expr.Array(val elems) => {
                                // the declared element type as a TypeRef: the annotation's
                                // arg (`Array[I64]` -> I64) if structured, else by name.
                                mut val elemRef: U64 = 0
                                if ty != 0U64 {
                                    if self.arena.types[ty].args.count() > 0U64 {
                                        elemRef = self.arena.types[ty].args[0]
                                    }
                                }
                                mut val ek: U64 = 0
                                while ek < elems.len {
                                    self.tcCheckValue(expectedRef: elemRef, valueExpr: self.exprAt(exprs: elems, index: ek), pos: "element")
                                    ek += 1
                                }
                            }
                            _ => {
                                // a NON-literal array value (`val b: Array[I64] = s.bytes()`):
                                // inferType reports arrays as kind 0 (deferred), so tcCheckValue
                                // above can't compare element types. Compare the init's element
                                // type to the declared one directly, but only when BOTH are
                                // concrete primitives (a struct/generic element is left to the
                                // existing machinery — conservative).
                                if ty != 0U64 {
                                    if self.arena.types[ty].args.count() > 0U64 {
                                        val de: TypeRef = self.arena.types[self.arena.types[ty].args[0]]
                                        val it: TypeInfo = self.typeOf(id: init)
                                        if it.kind == 3 {
                                            if it.nameLen > 0U64 {
                                                if self.isPrimType(start: de.nameStart, len: de.nameLen) {
                                                    if self.isPrimType(start: it.nameStart, len: it.nameLen) {
                                                        if !(spansEqual(c: inout self, aStart: de.nameStart, aLen: de.nameLen, bStart: it.nameStart, bLen: it.nameLen)) {
                                                            self.errorAt(offset: self.exprOffset(id: init), msg: "array element type does not match the declared element type (Plew has no implicit conversion — spec/12)")
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // register the binding (after the init, so it can't see itself) with its
                // effective type and mutability, so later places resolve / check.
                val le: LetEff = self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
                // an UN-annotated array-literal binding infers `Array[E]` from its FIRST
                // element (inferLetType); the remaining elements must be checked against
                // that E exactly like the annotated loop above — without this a
                // heterogeneous literal (`val xs = ["a", 1I64]`) sails through and the
                // stray element's bits are reinterpreted at run time.
                if tyLen == 0U64 && le.arr && le.ty != 0U64 {
                    match self.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            if self.arena.types[le.ty].args.count() > 0U64 {
                                val infElemRef: U64 = self.arena.types[le.ty].args[0]
                                // element 0 DEFINED E; check the rest against it.
                                mut val ek: U64 = 1
                                while ek < elems.len {
                                    self.tcCheckValue(expectedRef: infElemRef, valueExpr: self.exprAt(exprs: elems, index: ek), pos: "element")
                                    ek += 1
                                }
                            }
                        }
                        _ => {}
                    }
                }
                self.markShadowedUniqueMoved(nameStart: nameStart, nameLen: nameLen)
                self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: true)
            }
            Stmt.Assign(val target, val value) => {
                self.verifyAssign(target: target, value: value)
            }
            Stmt.ExprStmt(val expr) => {
                self.checkLitCtx(id: expr, eKind: 0, eBits: 0, eSgn: false)
                self.verifyExpr(id: expr)
            }
            Stmt.Return(val value, val hasValue, val offset) => {
                if hasValue {
                    // a function with no declared return type (`fn f() { … }`) returns `()` —
                    // `return 5I64` from it is a type error (the value is silently dropped),
                    // unless the value is itself the unit `()` (a bare-record construction).
                    if self.cur.retVoid {
                        if !(self.exprIsUnit(id: value)) {
                            self.errorAt(offset: self.exprOffset(id: value), msg: "a function with no return type cannot return a value (spec/04)")
                        }
                    }
                    self.checkLitSpanCtx(id: value, tyStart: self.cur.retStart, tyLen: self.cur.retLen, isArray: self.cur.retIsArray, ctxRef: self.cur.retTy)
                    // returning a non-array where the declared return type IS an array
                    // (`return 5I64` from `-> Array[I64]`) reinterprets the scalar bits.
                    if self.cur.retIsArray {
                        if self.valueIsReliablyNonArray(value: value) {
                            self.errorAt(offset: self.exprOffset(id: value), msg: "this function returns an array, but the returned value is not an array (Plew has no implicit conversion — spec/12)")
                        }
                    }
                    // a returned value whose category disagrees with the declared return
                    // type (`return "s"` / `return <A…/>` from `-> I64`). Same shared,
                    // reliable-value discipline as bindings; curRetLen 0 = `()` return.
                    if self.cur.retLen > 0U64 {
                        self.tcCheckValue(expectedRef: self.cur.retTy, valueExpr: value, pos: "return")
                    }
                    self.verifyExpr(id: value)
                } else {
                    // a bare `return` in a value-returning function leaves the result
                    // uninitialized (spec/04: a non-`()` function must return a value on
                    // every path). Valid only when the return type is `()` / absent.
                    mut val retIsUnit: Bool = self.cur.retVoid || self.cur.retLen == 0U64
                    if rangeEquals(bytes: self.arena.bytes, start: self.cur.retStart, len: self.cur.retLen, kw: "()") {
                        retIsUnit = true
                    }
                    if !(retIsUnit) {
                        self.errorAt(offset: offset, msg: "a bare `return` cannot appear in a function that returns a value — return a value (spec/04)")
                    }
                }
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.checkLitCtx(id: cond, eKind: 0, eBits: 0, eSgn: false)
                self.checkCondBool(cond: cond)
                self.verifyExpr(id: cond)
                // locals already in scope are "outside" this branch (a `move` of one
                // inside would be conditional) — mark the boundary for the move guard.
                val savedBB: U64 = self.cur.branchBase
                self.cur.branchBase = self.scopeMark()
                self.verifyBlock(blockId: thenBlk)
                if hasElse {
                    self.verifyBlock(blockId: elseBlk)
                }
                self.cur.branchBase = savedBB
            }
            Stmt.While(val cond, val body) => {
                self.checkLitCtx(id: cond, eKind: 0, eBits: 0, eSgn: false)
                self.checkCondBool(cond: cond)
                self.verifyExpr(id: cond)
                val savedBB: U64 = self.cur.branchBase
                self.cur.branchBase = self.scopeMark()
                self.cur.verifyLoopDepth = self.cur.verifyLoopDepth + 1U64
                self.verifyBlock(blockId: body)
                self.cur.verifyLoopDepth = self.cur.verifyLoopDepth - 1U64
                self.cur.branchBase = savedBB
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, inclusive: _, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
                self.verifyExpr(id: iter)
                // a record loop pattern lowered to this For: check its bind list
                // against the ELEMENT record's fields (spec/03).
                self.checkDestructureSite(initId: iter, isElem: true)
                if isRange {
                    self.verifyExpr(id: rangeHi)
                    // a range is iterated via `Step`, which is integer-only (spec/02,11):
                    // `for x in 0.0..<5.0` has no Step witness. Reject a float-typed range
                    // (by the loop-var annotation or either bound).
                    mut val rangeIsFloat: Bool = self.exprIsFloat(id: iter) || self.exprIsFloat(id: rangeHi)
                    if varTyLen != 0U64 {
                        if self.isFloatType(start: varTyStart, len: varTyLen) {
                            rangeIsFloat = true
                        }
                    }
                    if rangeIsFloat {
                        self.errorAt(offset: self.exprOffset(id: iter), msg: "a range is iterated via Step, which is integer-only — a float range cannot be a for-loop iterable (spec/02,11)")
                    }
                    // a range bound annotated by the loop var (`for val i: I32 in …`)
                    // types both bounds; otherwise each must determine its own type, so a
                    // bare literal range (`0..<5`) is ambiguous and rejected.
                    if varTyLen != 0U64 {
                        self.checkLitSpan(id: iter, tyStart: varTyStart, tyLen: varTyLen, isArray: false)
                        self.checkLitSpan(id: rangeHi, tyStart: varTyStart, tyLen: varTyLen, isArray: false)
                        // checkLitSpan only range-checks a SUFFIXED literal against its own
                        // suffix, so a mismatched width (`for val i: I64 in 0I64..<5I32`)
                        // slips through — check each bound's type against the loop var type.
                        val vref: U64 = self.simpleTypeRef(nameStart: varTyStart, nameLen: varTyLen)
                        self.tcCheckValue(expectedRef: vref, valueExpr: iter, pos: "range bound")
                        self.tcCheckValue(expectedRef: vref, valueExpr: rangeHi, pos: "range bound")
                    } else {
                        self.checkArithNoCtx(lhs: iter, rhs: rangeHi)
                        // both bounds must share a type (`0I64..<5I32` is a width mismatch).
                        self.tcCheckValue(expectedRef: self.inferType(id: iter), valueExpr: rangeHi, pos: "range bound")
                    }
                }
                // scope the loop binding(s) to the body, mirroring genStmt's For.
                val forMark: U64 = self.scopeMark()
                val savedForBB: U64 = self.cur.branchBase
                self.cur.branchBase = forMark
                if isRange {
                    // loop var type: the annotation, else the range bound's own type.
                    mut val ltS: U64 = varTyStart
                    mut val ltL: U64 = varTyLen
                    if ltL == 0U64 {
                        val bt2: TypeInfo = self.typeOf(id: rangeHi)
                        if bt2.kind == 0 {
                            ltS = bt2.nameStart
                            ltL = bt2.nameLen
                        }
                    }
                    self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: ltS, tyLen: ltL, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    val et: TypeInfo = self.typeOf(id: iter)
                    if et.kind == 3 {
                        if isStruct {
                            // the destructure pattern type must name the element struct.
                            if intern(c: inout self, start: patStart, len: patLen) != intern(c: inout self, start: et.nameStart, len: et.nameLen) {
                                self.errorAt(offset: patStart, msg: "for-loop destructure pattern type does not match the element type")
                            }
                            mut val bi: U64 = 0
                            while bi < binds.count() {
                                val bd: Bind = binds[bi]
                                val ft: TypeInfo = self.forBindFieldType(et: et, bd: bd)
                                self.addLocal(nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
                                bi += 1
                            }
                        } else {
                            // single binding to the element type (`for val b in bs` -> U8).
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                        }
                    } else {
                        // a custom Iterator / Iterable (kind 2 — `for v in counter`, an adapter
                        // chain `xs.map(..).filter(..)`, or an `any Iterator`): recover the loop
                        // variable's Item type from next()'s Optional[Item] (iterableItemInfo)
                        // and bind it, so the body's references to it resolve. (When the Item is
                        // unresolvable — e.g. an existential's associated type — it degrades to a
                        // scalar binding, still in scope.)
                        val item: TypeInfo = self.iterableItemInfo(et: et)
                        if isStruct {
                            self.addForStructBinds(et: item, binds: binds)
                        } else {
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: item.nameStart, tyLen: item.nameLen, isArray: item.kind == 3, ty: item.ref, isInout: false, isMut: false, owned: false)
                        }
                    }
                }
                self.cur.verifyLoopDepth = self.cur.verifyLoopDepth + 1U64
                self.verifyBlock(blockId: body)
                self.cur.verifyLoopDepth = self.cur.verifyLoopDepth - 1U64
                self.cur.branchBase = savedForBB
                self.popLocals(mark: forMark)
            }
            Stmt.Match(val scrut, val arms) => {
                self.checkMatchAccessMode(scrut: scrut, arms: arms)
                self.verifyExpr(id: scrut)
                self.checkMatchArmsEnum(scrut: scrut, arms: arms)
                if !(self.matchExhaustive(arms: arms)) {
                    self.errorAt(offset: self.exprOffset(id: scrut), msg: "match must be exhaustive: cover all variants or add a wildcard")
                }
                mut val ai: U64 = 0
                while ai < arms.count() {
                    val armMark: U64 = self.scopeMark()
                    val savedArmBB: U64 = self.cur.branchBase
                    self.cur.branchBase = armMark
                    self.checkDestructureComplete(a: arms[ai])
                    self.verifyAddArmBinds(a: arms[ai], scrut: scrut)
                    self.verifyBlock(blockId: arms[ai].body)
                    self.cur.branchBase = savedArmBB
                    self.popLocals(mark: armMark)
                    ai += 1
                }
            }
            Stmt.Panic(val msg, offset: _) => {
                self.verifyExpr(id: msg)
            }
            Stmt.Give(val value) => {
                // a value-position if/match yielding a unique value isn't supported yet
                // (per-path move/drop handling); mirrors genStmt's Give guard.
                val gvt: TypeInfo = self.typeOf(id: value)
                if gvt.kind == 2 {
                    if self.typeIsUnique(start: gvt.nameStart, len: gvt.nameLen) {
                        self.errorAt(offset: self.exprOffset(id: value), msg: "a value-position if/match cannot yield a unique value yet; use a statement form")
                    }
                }
                self.verifyExpr(id: value)
            }
            Stmt.Break(val offset) => {
                if self.cur.verifyLoopDepth == 0U64 {
                    self.errorAt(offset: offset, msg: "`break` outside a loop (spec/11)")
                }
            }
            Stmt.Continue(val offset) => {
                if self.cur.verifyLoopDepth == 0U64 {
                    self.errorAt(offset: offset, msg: "`continue` outside a loop (spec/11)")
                }
            }
        }
    }

    inout fn verifyAssign(target: U64, value: U64) {
        match self.arena.exprs[target] {
            Expr.Index(val base, val index) => {
                if !(self.placeIsMutable(id: base)) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "cannot assign to an element of an immutable binding; declare it with `mut val`")
                }
                self.verifyExpr(id: base)
                self.verifyExpr(id: index)
                self.checkIndexKeyType(base: base, index: index)
            }
            Expr.Field(base: val fbase, val nameStart, val nameLen) => {
                // the whole place must be mutable (binding + field both `mut val`).
                if !(self.placeIsMutable(id: target)) {
                    self.errorAt(offset: self.exprOffset(id: target), msg: "cannot assign to an immutable place; the binding and field must be declared `mut val`")
                }
                // field-write visibility on the base's owner type.
                val bt: TypeInfo = self.typeOf(id: fbase)
                if bt.kind == 2 {
                    self.checkFieldWriteVis(ownerStart: bt.nameStart, ownerLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
                }
                self.verifyExpr(id: fbase)
            }
            Expr.Ident(val start, val len) => {
                // the target must name an existing binding (spec/03: assignment never
                // declares). Without this, an undeclared name slid past the mutability
                // check (localIsMutable defaults to true for names it cannot find) and
                // surfaced as a backend codegen error or a misleading literal-context
                // error on the RHS.
                if !(self.identIsBinding(start: start, len: len)) {
                    self.errorAt(offset: self.exprOffset(id: target), msg: "cannot assign to an undeclared name: it is not a local, parameter, or global in scope — declare it first with `val`/`mut val` (spec/03)")
                }
                if !(self.placeIsMutable(id: target)) {
                    // exprOffset, not the raw token start: a destructure's synthesized
                    // assign (`(x, val y) = r`) idents an INTERNED name — its source
                    // position lives in exprSpanStart (same for hand-written idents,
                    // where exprOffset falls back to the token start).
                    self.errorAt(offset: self.exprOffset(id: target), msg: "cannot assign to an immutable binding; declare it with `mut val`")
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // Only `MutableRef[T]` grants write capability through `->`. `Ref[T]` is
                // read-only, and weak refs must be upgraded first (spec/03). `->` also obeys
                // the pointee type's field WRITE visibility just like `.` (spec/05).
                val abt: TypeInfo = self.typeOf(id: base)
                if self.isWeakRefLikeInst(ref: abt.ref) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "a weak reference cannot be dereferenced with `->` (its referent may be gone); call `upgrade()` to get an `Optional` strong reference, then `->` the unwrapped value (spec/03)")
                } else if self.isRefInst(ref: abt.ref) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "cannot assign through `Ref[T]`; use `MutableRef[T]` for shared mutation or call a mutable handle before narrowing with `asRef()` (spec/03)")
                } else if self.isMutableRefInst(ref: abt.ref) {
                    // the pointee FIELD must be `mut val` — the MutableRef exception waives only the
                    // binding's mutability, not the field's (spec/03 `val` immutability).
                    if !(self.placeIsMutable(id: target)) {
                        self.errorAt(offset: self.exprOffset(id: target), msg: "cannot assign to an immutable pointee field; declare the field `mut val` (a `MutableRef` shares mutation through a `val` handle but does not make a `val` field writable — spec/03)")
                    }
                    val inst: TypeRef = self.arena.types[abt.ref]
                    val pt: TypeInfo = self.typeInfoOfRef(ref: inst.args[0])
                    if pt.kind == 2 {
                        self.checkFieldWriteVis(ownerStart: pt.nameStart, ownerLen: pt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
                    }
                }
                self.verifyExpr(id: base)
            }
            _ => {}
        }
        self.checkUniquePlaceCopy(exprId: value, inoutOk: false)
        // determine the RHS literal type from the target place (the same context a `val`
        // initializer gets): a determinable literal types at the target width and is
        // range-checked; an undetermined one is a compile error, not a silent i64 default.
        self.checkAssignRhsLit(target: target, value: value)
        self.verifyExpr(id: value)
        // a reassignment `u = e` reinitializes `u`, so it is live again — clear any
        // use-after-move mark (the value was verified above, so a moved read in `e` is
        // already reported). spec/03.
        match self.arena.exprs[target] {
            Expr.Ident(val start, val len) => {
                self.verifyUnmarkMoved(idx: self.localIndexByName(start: start, len: len))
            }
            _ => {}
        }
        // the assigned value's type must match the place's type (the TypeRef checker
        // subsumes the old numeric/String/named-id category checks here, with generic-arg
        // precision and Bool/width/sign distinctions). Compound assign was desugared to
        // `place = place OP value` in Lower, so the OP's operand check rides the binary's
        // own witness resolution — there is no separate compound check.
        self.tcCheckValue(expectedRef: self.inferType(id: target), valueExpr: value, pos: "assign")
    }
}
