// Part of the acceptance verification pass (root: _.pw): argument, field/
// method visibility, binary-operator, and `as`-cast lossless checks.

// verify each call/method argument's expression (the arg-mode checks themselves
// run via checkLitCtx -> checkCallArgs -> checkUniqueArgModes).

pub impl Comp {
    inout fn verifyArgs(args: Array[Arg]) {
        mut val i: U64 = 0
        while i < args.count() {
            self.verifyExpr(id: args[i].expr)
            i += 1
        }
        // overlapping `inout` (spec/03, Swift-equivalent granularity): two or more
        // `inout` positions of ONE call must not name overlapping places. Value-world
        // pairs are fully static (same-variable pairs error unless they diverge at
        // distinct fields); shared-world pairs (`r1->v`/`r2->v`) whose cell identity is
        // a runtime value get a cell-identity check emitted by the backend.
        mut val a: U64 = 0
        while a < args.count() {
            if args[a].isInout {
                mut val b: U64 = a + 1U64
                while b < args.count() {
                    if args[b].isInout {
                        self.checkInoutPair(a: args[a].expr, b: args[b].expr)
                    }
                    b += 1U64
                }
            }
            a += 1U64
        }
    }

    // One PAIR of `inout` places (spec/03 overlapping-inout, the static tier):
    // certain overlap -> compile error. Runtime-tier pairs (class 2) need nothing
    // here — the backend compares the already-evaluated cell addresses, so no index
    // or subexpression is ever re-evaluated.
    inout fn checkInoutPair(a: U64, b: U64) {
        if self.classifyInoutPair(a: a, b: b) == 1U64 {
            self.errorAt(offset: self.exprOffset(id: b), msg: "two `inout` positions in one call overlap: they reach into the same variable (or one contains the other) without diverging at distinct fields; overlapping `inout` is forbidden (spec/03)")
        }
    }

    // Classify one pair of `inout` places (spec/03, Swift-equivalent granularity):
    // 1 = certain overlap (compile error), 2 = a same-cell question only answerable at
    // runtime (the backend compares the cells just before the call), 0 = provably
    // distinct (no check). Two worlds: a deref-free place lives in value-semantics
    // storage, so it can only overlap a place rooted in the SAME variable — decided
    // fully statically at VARIABLE granularity (two subscripts into one variable
    // overlap regardless of the index values; only divergence at distinct field names
    // proves disjointness). A deref-crossing place lives in a heap cell, so it can
    // only overlap another deref-crossing place: distinct pointee fields are disjoint
    // whatever the cells; the same field (or containment) reduces to cell identity —
    // certain when the places share one syntactic variable path, runtime otherwise.
    // MIXED worlds never overlap (variable storage vs heap cell): `f(r: inout r1,
    // x: inout r1->n)` is legal — the backend's cell pin keeps the lent pointee alive
    // across a rebind of the variable.
    inout fn classifyInoutPair(a: U64, b: U64) -> U64 {
        val da: U64 = self.placeDepth(id: a)
        val db: U64 = self.placeDepth(id: b)
        if da == 0U64 || db == 0U64 {
            return 2
        }
        val hda: Bool = self.placeHasDeref(id: a)
        if hda != self.placeHasDeref(id: b) {
            return 0
        }
        if !hda {
            mut val sa: U64 = a
            mut val sb: U64 = b
            if da > db {
                sa = self.placeAncestor(id: a, up: da - db)
            } else {
                sb = self.placeAncestor(id: b, up: db - da)
            }
            if self.relValuePlaces(a: sa, b: sb) == 1U64 {
                return 0
            }
            return 1
        }
        // shared world: truncate each place to its outermost cell projection — the
        // first Field above the topmost deref (container granularity: everything below
        // an element access collapses onto its container field), or the whole pointee
        // when the place IS the deref.
        val pa: U64 = self.placePostDerefDepth(id: a)
        val pb: U64 = self.placePostDerefDepth(id: b)
        mut val ta: U64 = a
        mut val tb: U64 = b
        if pa > 1U64 {
            ta = self.placeAncestor(id: a, up: pa - 1U64)
        }
        if pb > 1U64 {
            tb = self.placeAncestor(id: b, up: pb - 1U64)
        }
        // whole pointee vs a pointee projection: containment — compare at the cell.
        if pa == 0U64 && pb != 0U64 {
            tb = self.placeAncestor(id: tb, up: 1U64)
        }
        if pb == 0U64 && pa != 0U64 {
            ta = self.placeAncestor(id: ta, up: 1U64)
        }
        if pa != 0U64 && pb != 0U64 {
            if self.derefProjNamesDiffer(a: ta, b: tb) {
                return 0
            }
        }
        if self.exprSyntaxEq(a: ta, b: tb) {
            return 1
        }
        return 2
    }

    // Levels of a place path (Ident root = 1, each Field/Index/Deref = +1). An Arrow
    // is semantically Field∘Deref — TWO levels — so a whole pointee (`r1->m()` self =
    // Deref, one level past the Ref) and a pointee field (`r2->n`, two levels) align
    // at the cell, not at the field offset. 0 when the path bottoms out in a non-place
    // expression (opaque — runtime check).
    inout fn placeDepth(id: U64) -> U64 {
        match self.arena.exprs[id] {
            Expr.Ident(start: _, len: _) => { return 1 }
            Expr.Field(val base, nameStart: _, nameLen: _) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 1U64
            }
            Expr.Index(val base, index: _) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 1U64
            }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 2U64
            }
            Expr.Deref(val base) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 1U64
            }
            _ => { return 0 }
        }
    }

    // The ancestor of a place path `up` levels toward the root (`arr[j].f`, up 1 ->
    // `arr[j]`). Stepping one level into an Arrow lands on its deref (the whole
    // pointee) — that sub-place has no node in the source expression, so a Deref node
    // is synthesized (compared/addressed exactly like a written `*r`).
    inout fn placeAncestor(id: U64, up: U64) -> U64 {
        mut val cur: U64 = id
        mut val i: U64 = 0
        while i < up {
            match self.arena.exprs[cur] {
                Expr.Field(val base, nameStart: _, nameLen: _) => { cur = base }
                Expr.Index(val base, index: _) => { cur = base }
                Expr.Arrow(val base, nameStart: _, nameLen: _) => { cur = self.pushExpr(e: <Expr.Deref base=base />) }
                Expr.Deref(val base) => { cur = base }
                _ => { return cur }
            }
            i += 1U64
        }
        return cur
    }

    inout fn placeHasDeref(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.placeHasDeref(id: base) }
            Expr.Index(val base, index: _) => { return self.placeHasDeref(id: base) }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Deref(base: _) => { return true }
            _ => { return false }
        }
    }

    // Relation of two EQUAL-DEPTH, deref-free place paths (Swift-equivalent variable
    // granularity): 0 = identical path, 1 = provably distinct (different variable
    // roots — value semantics cannot alias two variables — or divergence at distinct
    // Field names), 2 = overlapping (the same variable reached without a distinct-
    // field divergence; two subscripts into one container overlap REGARDLESS of the
    // index values — no distinctness proof over indices is attempted).
    inout fn relValuePlaces(a: U64, b: U64) -> U64 {
        match self.arena.exprs[a] {
            Expr.Ident(start: val s1, len: val l1) => {
                match self.arena.exprs[b] {
                    Expr.Ident(start: val s2, len: val l2) => {
                        if spansEqual(c: inout self, aStart: s1, aLen: l1, bStart: s2, bLen: l2) {
                            return 0
                        }
                        return 1
                    }
                    _ => { return 2 }
                }
            }
            Expr.Field(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[b] {
                    Expr.Field(base: val base2, nameStart: val n2s, nameLen: val n2l) => {
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r != 0U64 {
                            return r
                        }
                        if spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) {
                            return 0
                        }
                        return 1
                    }
                    Expr.Index(base: val base2, index: _) => {
                        // kind mismatch on one base (untypable in practice): same base ->
                        // conservatively overlapping, distinct bases stay distinct.
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r == 0U64 {
                            return 2
                        }
                        return r
                    }
                    _ => { return 2 }
                }
            }
            Expr.Index(base: val base1, index: _) => {
                match self.arena.exprs[b] {
                    Expr.Index(base: val base2, index: _) => {
                        // same container: overlapping at variable granularity, whatever
                        // the indices (identical AND differing index exprs both land here).
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r == 0U64 {
                            return 2
                        }
                        return r
                    }
                    Expr.Field(base: val base2, nameStart: _, nameLen: _) => {
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r == 0U64 {
                            return 2
                        }
                        return r
                    }
                    _ => { return 2 }
                }
            }
            _ => { return 2 }
        }
    }

    // Levels of a place path ABOVE its topmost deref: 0 = the place IS the pointee
    // (`Deref`, a pointee-method receiver), 1 = a direct cell projection (`r->f`),
    // 2+ = deeper (`r->xs[i]`, `r->a.b`). Only meaningful when placeHasDeref holds.
    inout fn placePostDerefDepth(id: U64) -> U64 {
        match self.arena.exprs[id] {
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.placePostDerefDepth(id: base) + 1U64 }
            Expr.Index(val base, index: _) => { return self.placePostDerefDepth(id: base) + 1U64 }
            // Arrow = Field∘Deref: the field is ONE level above its own deref, which is
            // the topmost deref of the whole path (anything deeper sits inside `base`).
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return 1 }
            _ => { return 0 }
        }
    }

    // Two direct cell projections: do they name provably DIFFERENT pointee fields?
    // Distinct fields are disjoint regardless of cell identity (fields of one cell are
    // disjoint; fields of two cells even more so). Non-Arrow shapes: unknown (false).
    inout fn derefProjNamesDiffer(a: U64, b: U64) -> Bool {
        match self.arena.exprs[a] {
            Expr.Arrow(base: _, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[b] {
                    Expr.Arrow(base: _, nameStart: val n2s, nameLen: val n2l) => { return !(spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l)) }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn exprSyntaxEq(a: U64, b: U64) -> Bool {
        match self.arena.exprs[a] {
            Expr.Ident(start: val s1, len: val l1) => {
                match self.arena.exprs[b] {
                    Expr.Ident(start: val s2, len: val l2) => { return spansEqual(c: inout self, aStart: s1, aLen: l1, bStart: s2, bLen: l2) }
                    _ => { return false }
                }
            }
            Expr.Int(value: val v1, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg1) => {
                match self.arena.exprs[b] {
                    Expr.Int(value: val v2, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg2) => { return v1 == v2 && neg1 == neg2 }
                    _ => { return false }
                }
            }
            Expr.Field(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[b] {
                    Expr.Field(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            Expr.Arrow(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[b] {
                    Expr.Arrow(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            Expr.Index(base: val base1, index: val idx1) => {
                match self.arena.exprs[b] {
                    Expr.Index(base: val base2, index: val idx2) => { return self.exprSyntaxEq(a: base1, b: base2) && self.exprSyntaxEq(a: idx1, b: idx2) }
                    _ => { return false }
                }
            }
            Expr.Deref(base: val base1) => {
                match self.arena.exprs[b] {
                    Expr.Deref(base: val base2) => { return self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn verifyFieldReadVis(base: U64, nameStart: U64, nameLen: U64) {
        match self.arena.exprs[base] {
            Expr.Ident(val start, val len) => {
                if self.identIsTypeQualifier(start: start, len: len, tpFn: self.arena.funcs.count()) {
                    if self.typeHasAssocFn(typeStart: start, typeLen: len, nameStart: nameStart, nameLen: nameLen) {
                        self.errorAt(offset: nameStart, msg: "an associated function declaration cannot be used as a value; wrap the call in an explicit closure (e.g. `fn(...) { return Type.name(...) }`) (spec/07)")
                    } else {
                        self.errorAt(offset: nameStart, msg: "a type name has no fields; use `Type.fn(...)` to call an associated function, or construct a value before reading fields (spec/07)")
                    }
                    return
                }
            }
            _ => {}
        }
        val bt: TypeInfo = self.typeOf(id: base)
        if bt.kind == 2 {
            // an enum value has no fields — `opt.x` / `e.field` is always invalid (reach a
            // payload with `match`, an Optional with `?.` / `unwrapOr`). Without this the
            // access slid to the backend's "field access only on a registered struct value
            // (so far)" message, which reads like a compiler limitation, not a user error.
            mut val fei: U64 = self.enumIdxByName(start: bt.nameStart, len: bt.nameLen)
            if fei >= self.arena.enums.count() {
                fei = self.genericEnumIndex(nameStart: bt.nameStart, nameLen: bt.nameLen)
            }
            if fei < self.arena.enums.count() {
                self.errorAt(offset: nameStart, msg: "an enum value has no fields; `match` on its variants to reach a payload (for an `Optional` use `?.` / `unwrapOr` / `match`) (spec/07)")
                return
            }
            if self.fieldVis(structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen) == 3U64 {
                if self.typeHasMethodNamed(recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: nameStart, nameLen: nameLen) {
                    self.errorAt(offset: nameStart, msg: "a method cannot be used as a value; call it, or wrap it in a closure (e.g. `fn() { obj.method() }`)")
                }
            }
            self.checkFieldReadVis(ownerStart: bt.nameStart, ownerLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
        } else {
            if bt.kind == 3 {
                val arrName: Bind = self.kwSpan(kw: "Array", kwLen: 5)
                self.checkFieldReadVis(ownerStart: arrName.nameStart, ownerLen: arrName.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
            }
        }
    }

    inout fn verifyMethodVis(recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
        val rt: TypeInfo = self.typeOf(id: recv)
        if rt.kind == 2 {
            // resolve the method on the receiver type to get its Func (checkMethodVis
            // inspects the impl block's visibility); skip if unresolved (a separate
            // "no such method" diagnostic covers that).
            val mi: U64 = self.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if mi < self.arena.funcs.count() {
                self.checkMethodVis(ownerStart: rt.nameStart, ownerLen: rt.nameLen, mf: self.arena.funcs[mi], offset: nameStart)
                // an `inout fn` method mutates the receiver, so it must be a mutable PLACE
                // — not an rvalue temporary (`<S…/>.bump()` / `mk().bump()` would mutate a
                // value that is immediately discarded — spec/03).
                if self.arena.funcs[mi].selfInout {
                    if !(self.exprIsPlace(id: recv)) {
                        self.errorAt(offset: self.exprOffset(id: recv), msg: "cannot call an `inout fn` method on a temporary value; the receiver must be a place (a variable or field) declared `mut val` (spec/03)")
                    }
                    if !(self.placeIsMutable(id: recv)) {
                        self.errorAt(offset: self.exprOffset(id: recv), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
                    }
                    // overlapping `inout` (spec/03): an `inout fn` self IS an inout
                    // position, so it pairs with every `inout` argument — statically-
                    // certain overlap (same place / containment like `a.merge(inout
                    // a.field)`) errors here; runtime-value pairs get the pre-call
                    // place-identity check from the backend.
                    mut val k: U64 = 0
                    while k < args.count() {
                        if args[k].isInout {
                            self.checkInoutPair(a: recv, b: args[k].expr)
                        }
                        k += 1U64
                    }
                }
            }
        }
        // a mutating built-in array method (`append`) on an immutable / non-place array.
        if rt.kind == 3 {
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "append") {
                if !(self.exprIsPlace(id: recv)) {
                    self.errorAt(offset: self.exprOffset(id: recv), msg: "cannot `append` to a temporary array; the receiver must be a place declared `mut val` (spec/03)")
                }
                if !(self.placeIsMutable(id: recv)) {
                    self.errorAt(offset: self.exprOffset(id: recv), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
                }
            }
        }
    }

    inout fn exprIsFloat(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => { return true }
            _ => {}
        }
        // a value whose recovered type names a float type — by NAME regardless of kind
        // (F64 is in isPrimType so typeOf gives kind 0 for a local, but kind 2 for a literal).
        val ti: TypeInfo = self.typeOf(id: id)
        if ti.nameLen > 0U64 {
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F64") {
                return true
            }
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F32") {
                return true
            }
        }
        return false
    }

    inout fn verifyBinaryOp(op: I64, lhs: U64, rhs: U64) {
        // gen mode (spec/16): the user's own code is thrown away (the backend replaces it
        // with the derive-runner harness), and a `@[Eq]`/`@[Ord]` type's witness is only
        // generated BY this run (into the `.gen.pw` auto-parted on the normal compile), so
        // an operator on such a type has no witness yet here. Skip — the real operator
        // verification happens when the final program is compiled normally (non-gen), like
        // checkDeclShapes.
        if self.genMode {
            return
        }
        // float arithmetic / comparison is accepted directly (the backend emits the IEEE
        // op); `%`/`Rem` is integer-only, so reject it on a float (spec/12).
        if self.exprIsFloat(id: lhs) || self.exprIsFloat(id: rhs) {
            if op == opRem() {
                self.errorAt(offset: self.exprOffset(id: lhs), msg: "`%` (remainder) is integer-only; not defined for floats (spec/12)")
            }
            return
        }
        // String `==`/`!=` is no longer a name-special case: String conforms to `Eq`
        // (`impl String as Eq` in Core, riding `bufferEq`), so it is accepted by the
        // general witness path below like any other Eq type (collections.md §3-付録4).
        if self.hasCompareWitness(op: op, lhs: lhs, rhs: rhs) {
            return
        }
        if self.compareNeedsTrait(op: op, lhs: lhs, rhs: rhs) {
            self.errorAt(offset: self.exprOffset(id: lhs), msg: "comparison needs an `Eq`/`Ord` witness — a struct/enum needs `impl T as Eq` (e.g. derive `@[Eq]`) for `==`/`!=` or `impl T as Ord` for `< <= > >=`; there is no built-in structural/tag comparison")
            return
        }
        if self.hasBinTraitWitness(op: op, lhs: lhs, rhs: rhs) {
            return
        }
        if self.binTraitNeedsTrait(op: op, lhs: lhs, rhs: rhs) {
            self.errorAt(offset: self.exprOffset(id: lhs), msg: "arithmetic operator needs Add/Sub/Mul/Div/Rem; not implemented for this type")
        }
    }

    inout fn castOperandIsBool(operand: U64) -> Bool {
        match self.arena.exprs[operand] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, tyLen: _, isNeg: _) => {
                if isBool { return true }
            }
            _ => {}
        }
        val st: TypeInfo = self.typeOf(id: operand)
        if st.nameLen > 0U64 {
            return rangeEquals(bytes: self.arena.bytes, start: st.nameStart, len: st.nameLen, kw: "Bool")
        }
        return false
    }

    inout fn verifyCastLossless(operand: U64, tyStart: U64, tyLen: U64) {
        // Bool is not a numeric type, so `as` (the lossless numeric / newtype-retag
        // conversion, spec/12) can't bridge Bool and a numeric type in either direction
        // (`true as I64`, `1I64 as Bool`) — use match / a comparison instead.
        val targetBool: Bool = rangeEquals(bytes: self.arena.bytes, start: tyStart, len: tyLen, kw: "Bool")
        val targetNum: Bool = self.isIntType(start: tyStart, len: tyLen) || self.isFloatType(start: tyStart, len: tyLen)
        if self.castOperandIsBool(operand: operand) {
            if targetNum {
                self.errorAt(offset: self.exprOffset(id: operand), msg: "`as` cannot cast a Bool to a numeric type (Bool is not numeric; spec/12)")
                return
            }
        } else {
            if targetBool {
                self.errorAt(offset: self.exprOffset(id: operand), msg: "`as` cannot cast to Bool (Bool is not numeric; spec/12)")
                return
            }
        }
        if self.isIntType(start: tyStart, len: tyLen) {
            // a float -> int `as` truncates the fractional part = lossy, so it is not a
            // valid `as` conversion (spec/12: `as` is lossless/total only). Use TryFrom.
            if self.exprIsFloat(id: operand) {
                self.errorAt(offset: self.exprOffset(id: operand), msg: "`as` cannot convert a float to an integer (it would truncate the fractional part); use a fallible TryFrom conversion (spec/12)")
                return
            }
            match self.arena.exprs[operand] {
                Expr.Int(val value, val offset, isBool: _, tyStart: _, tyLen: _, val isNeg) => {
                    if !(self.litFitsType(value: value, neg: isNeg, dstStart: tyStart, dstLen: tyLen)) {
                        self.errorAt(offset: offset, msg: "integer literal is out of range for the target type of `as`")
                    }
                }
                _ => {
                    val st: TypeInfo = self.typeOf(id: operand)
                    if self.isIntType(start: st.nameStart, len: st.nameLen) {
                        if !(self.losslessInt(srcStart: st.nameStart, srcLen: st.nameLen, dstStart: tyStart, dstLen: tyLen)) {
                            self.errorAt(offset: self.exprOffset(id: operand), msg: "`as` would lose information (narrowing or signedness change); use a fallible TryFrom conversion")
                        }
                    }
                }
            }
        }
    }
}
