// Part of the acceptance verification pass (root: _.pw): argument, field/
// method visibility, binary-operator, and `as`-cast lossless checks.

// verify each call/method argument's expression (the arg-mode checks themselves
// run via checkLitCtx -> checkCallArgs -> checkUniqueArgModes).

pub impl Comp {
    inout fn verifyArgs(args: ArgRange) -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0
        while i < args.len {
            try self.verifyExpr(id: self.argAt(args: args, index: i).expr)
            i += 1
        }
        // overlapping `inout` (spec/03, Swift-equivalent granularity): two or more
        // `inout` positions of ONE call must not name overlapping places. Value-world
        // pairs are fully static (same-variable pairs error unless they diverge at
        // distinct fields); shared-world pairs (`r1->v`/`r2->v`) whose cell identity is
        // a runtime value get a cell-identity check emitted by the backend.
        mut val a: U64 = 0
        while a < args.len {
            if self.argAt(args: args, index: a).isInout {
                mut val b: U64 = a + 1U64
                while b < args.len {
                    if self.argAt(args: args, index: b).isInout {
                        try self.checkInoutPair(a: self.argAt(args: args, index: a).expr, b: self.argAt(args: args, index: b).expr)
                    }
                    b += 1U64
                }
            }
            a += 1U64
        }
        return <Result.Ok value=() />
    }

    // One PAIR of `inout` places (spec/03 overlapping-inout, the static tier):
    // certain overlap -> compile error. Runtime-tier pairs (class 2) need nothing
    // here — the backend compares the already-evaluated cell addresses, so no index
    // or subexpression is ever re-evaluated.
    inout fn checkInoutPair(a: U64, b: U64) -> Result[(), CompileDiagnostic] {
        if self.classifyInoutPair(a: a, b: b) == 1U64 {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: b), msg: "two `inout` positions in one call overlap: they reach into the same variable (or one contains the other) without diverging at distinct fields; overlapping `inout` is forbidden (spec/03)") />
        }
        return <Result.Ok value=() />
    }

    // Classify one pair of `inout` places (spec/03, Swift-equivalent granularity):
    // 1 = certain overlap (compile error), 2 = a same-cell question only answerable at
    // runtime (the backend compares the cells just before the call), 0 = provably
    // distinct (no check). Two worlds: a deref-free place lives in value-semantics
    // storage, so it can only overlap a place rooted in the SAME variable — decided
    // fully statically at VARIABLE granularity (two subscripts into one variable
    // overlap regardless of the index values; only divergence at distinct field names
    // proves disjointness). A deref-crossing place lives in a heap cell, so it can
    // only overlap another deref-crossing place: distinct pointee fields are disjoint
    // whatever the cells; the same field (or containment) reduces to cell identity —
    // certain when the places share one syntactic variable path, runtime otherwise.
    // MIXED worlds never overlap (variable storage vs heap cell): `f(r: inout r1,
    // x: inout r1->n)` is legal — the backend's cell pin keeps the lent pointee alive
    // across a rebind of the variable.
    inout fn classifyInoutPair(a: U64, b: U64) -> U64 {
        val da: U64 = self.placeDepth(id: a)
        val db: U64 = self.placeDepth(id: b)
        if da == 0U64 || db == 0U64 {
            return 2
        }
        val hda: Bool = self.placeHasDeref(id: a)
        if hda != self.placeHasDeref(id: b) {
            return 0
        }
        if !hda {
            mut val sa: U64 = a
            mut val sb: U64 = b
            if da > db {
                sa = self.placeAncestor(id: a, up: da - db)
            } else {
                sb = self.placeAncestor(id: b, up: db - da)
            }
            if self.relValuePlaces(a: sa, b: sb) == 1U64 {
                return 0
            }
            return 1
        }
        // shared world: truncate each place to its outermost cell projection — the
        // first Field above the topmost deref (container granularity: everything below
        // an element access collapses onto its container field), or the whole pointee
        // when the place IS the deref.
        val pa: U64 = self.placePostDerefDepth(id: a)
        val pb: U64 = self.placePostDerefDepth(id: b)
        mut val ta: U64 = a
        mut val tb: U64 = b
        if pa > 1U64 {
            ta = self.placeAncestor(id: a, up: pa - 1U64)
        }
        if pb > 1U64 {
            tb = self.placeAncestor(id: b, up: pb - 1U64)
        }
        // whole pointee vs a pointee projection: containment — compare at the cell.
        if pa == 0U64 && pb != 0U64 {
            tb = self.placeAncestor(id: tb, up: 1U64)
        }
        if pb == 0U64 && pa != 0U64 {
            ta = self.placeAncestor(id: ta, up: 1U64)
        }
        if pa != 0U64 && pb != 0U64 {
            if self.derefProjNamesDiffer(a: ta, b: tb) {
                return 0
            }
        }
        if self.exprSyntaxEq(a: ta, b: tb) {
            return 1
        }
        return 2
    }

    // Every traversal reads Lower-published storage provenance. A synthetic
    // getter is the value facet of an indexed place, not an opaque runtime
    // root; nested field/index recursion must preserve the same distinction.
    // Levels of a place path (Ident root = 1, each Field/Index/Deref = +1). An Arrow
    // is semantically Field∘Deref — TWO levels — so a whole pointee (`r1->m()` self =
    // Deref, one level past the Ref) and a pointee field (`r2->n`, two levels) align
    // at the cell, not at the field offset. 0 when the path bottoms out in a non-place
    // expression (opaque — runtime check).
    inout fn placeDepth(id: U64) -> U64 {
        match self.arena.exprs[self.materializablePlace(id: id)] {
            Expr.Ident(start: _, len: _) => { return 1 }
            Expr.Field(val base, nameStart: _, nameLen: _) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 1U64
            }
            Expr.Index(val base, index: _) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 1U64
            }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 2U64
            }
            Expr.Deref(val base) => {
                val d: U64 = self.placeDepth(id: base)
                if d == 0U64 {
                    return 0
                }
                return d + 1U64
            }
            _ => { return 0 }
        }
    }

    // The ancestor of a place path `up` levels toward the root (`arr[j].f`, up 1 ->
    // `arr[j]`). Stepping one level into an Arrow lands on its deref (the whole
    // pointee) — that sub-place has no node in the source expression, so a Deref node
    // is synthesized (compared/addressed exactly like a written `*r`).
    inout fn placeAncestor(id: U64, up: U64) -> U64 {
        mut val cur: U64 = self.materializablePlace(id: id)
        mut val i: U64 = 0
        while i < up {
            match self.arena.exprs[cur] {
                Expr.Field(val base, nameStart: _, nameLen: _) => { cur = base }
                Expr.Index(val base, index: _) => { cur = base }
                Expr.Arrow(val base, nameStart: _, nameLen: _) => { cur = self.pushExpr(e: <Expr.Deref base=base />) }
                Expr.Deref(val base) => { cur = base }
                _ => { return cur }
            }
            cur = self.materializablePlace(id: cur)
            i += 1U64
        }
        return cur
    }

    inout fn placeHasDeref(id: U64) -> Bool {
        match self.arena.exprs[self.materializablePlace(id: id)] {
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.placeHasDeref(id: base) }
            Expr.Index(val base, index: _) => { return self.placeHasDeref(id: base) }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Deref(base: _) => { return true }
            _ => { return false }
        }
    }

    // Relation of two EQUAL-DEPTH, deref-free place paths (Swift-equivalent variable
    // granularity): 0 = identical path, 1 = provably distinct (different variable
    // roots — value semantics cannot alias two variables — or divergence at distinct
    // Field names), 2 = overlapping (the same variable reached without a distinct-
    // field divergence; two subscripts into one container overlap REGARDLESS of the
    // index values — no distinctness proof over indices is attempted).
    inout fn relValuePlaces(a: U64, b: U64) -> U64 {
        match self.arena.exprs[self.materializablePlace(id: a)] {
            Expr.Ident(start: val s1, len: val l1) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Ident(start: val s2, len: val l2) => {
                        if spansEqual(c: inout self, aStart: s1, aLen: l1, bStart: s2, bLen: l2) {
                            return 0
                        }
                        return 1
                    }
                    _ => { return 2 }
                }
            }
            Expr.Field(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Field(base: val base2, nameStart: val n2s, nameLen: val n2l) => {
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r != 0U64 {
                            return r
                        }
                        if spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) {
                            return 0
                        }
                        return 1
                    }
                    Expr.Index(base: val base2, index: _) => {
                        // kind mismatch on one base (untypable in practice): same base ->
                        // conservatively overlapping, distinct bases stay distinct.
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r == 0U64 {
                            return 2
                        }
                        return r
                    }
                    _ => { return 2 }
                }
            }
            Expr.Index(base: val base1, index: _) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Index(base: val base2, index: _) => {
                        // same container: overlapping at variable granularity, whatever
                        // the indices (identical AND differing index exprs both land here).
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r == 0U64 {
                            return 2
                        }
                        return r
                    }
                    Expr.Field(base: val base2, nameStart: _, nameLen: _) => {
                        val r: U64 = self.relValuePlaces(a: base1, b: base2)
                        if r == 0U64 {
                            return 2
                        }
                        return r
                    }
                    _ => { return 2 }
                }
            }
            _ => { return 2 }
        }
    }

    // Levels of a place path ABOVE its topmost deref: 0 = the place IS the pointee
    // (`Deref`, a pointee-method receiver), 1 = a direct cell projection (`r->f`),
    // 2+ = deeper (`r->xs[i]`, `r->a.b`). Only meaningful when placeHasDeref holds.
    inout fn placePostDerefDepth(id: U64) -> U64 {
        match self.arena.exprs[self.materializablePlace(id: id)] {
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.placePostDerefDepth(id: base) + 1U64 }
            Expr.Index(val base, index: _) => { return self.placePostDerefDepth(id: base) + 1U64 }
            // Arrow = Field∘Deref: the field is ONE level above its own deref, which is
            // the topmost deref of the whole path (anything deeper sits inside `base`).
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return 1 }
            _ => { return 0 }
        }
    }

    // Two direct cell projections: do they name provably DIFFERENT pointee fields?
    // Distinct fields are disjoint regardless of cell identity (fields of one cell are
    // disjoint; fields of two cells even more so). Non-Arrow shapes: unknown (false).
    inout fn derefProjNamesDiffer(a: U64, b: U64) -> Bool {
        match self.arena.exprs[self.materializablePlace(id: a)] {
            Expr.Arrow(base: _, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Arrow(base: _, nameStart: val n2s, nameLen: val n2l) => { return !(spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l)) }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn exprSyntaxEq(a: U64, b: U64) -> Bool {
        match self.arena.exprs[self.materializablePlace(id: a)] {
            Expr.Ident(start: val s1, len: val l1) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Ident(start: val s2, len: val l2) => { return spansEqual(c: inout self, aStart: s1, aLen: l1, bStart: s2, bLen: l2) }
                    _ => { return false }
                }
            }
            Expr.Int(value: val v1, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg1) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Int(value: val v2, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg2) => { return v1 == v2 && neg1 == neg2 }
                    _ => { return false }
                }
            }
            Expr.Field(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Field(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            Expr.Arrow(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Arrow(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            Expr.Index(base: val base1, index: val idx1) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Index(base: val base2, index: val idx2) => { return self.exprSyntaxEq(a: base1, b: base2) && self.exprSyntaxEq(a: idx1, b: idx2) }
                    _ => { return false }
                }
            }
            Expr.Deref(base: val base1) => {
                match self.arena.exprs[self.materializablePlace(id: b)] {
                    Expr.Deref(base: val base2) => { return self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn verifySelectedFieldExists(exprId: U64, receiverTerm: U64, nameStart: U64, nameLen: U64, message: String) -> Result[(), CompileDiagnostic] {
        if exprId < self.arena.exprs.count() && self.constructionExpression(exprId: exprId).hasFieldProjection { return <Result.Ok value=() /> }
        val storage = self.fieldStorageTypeRef(receiverRef: self.lexicalLayoutReceiver(receiverTerm: receiverTerm))
        if storage == 0U64 { return <Result.Ok value=() /> }
        val storageType = self.arena.typeAt(index: storage)
        mut val fieldCount: U64 = 0U64
        if storageType.isRecord {
            fieldCount = storageType.recordFieldLabels.count()
        } else {
            val structIndex = self.structIndexForType(ref: storage)
            if structIndex >= self.arena.structCount() { return <Result.Ok value=() /> }
            fieldCount = self.arena.structAt(index: structIndex).fields.count()
        }
        // Missing recording is not evidence of an absent field (for example,
        // a Unit field has no nonzero result term). Check the declaration.
        if self.fieldIndexOfReceiver(receiverRef: storage, fieldStart: nameStart, fieldLen: nameLen) >= fieldCount {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: message) />
        }
        return <Result.Ok value=() />
    }

    // Write capability belongs to the nearest dereference, not to every
    // reference used to obtain its handle. A MutableRef stored inside a Ref
    // can still mutate its own referent.
    inout fn placeHasReadOnlyReference(id: U64) -> Result[Bool, CompileDiagnostic] {
        match self.arena.exprs[id] {
            Expr.Field(val base, nameStart: _, nameLen: _) => { return <Result.Ok value=(try self.placeHasReadOnlyReference(id: base)) />}
            Expr.Index(val base, index: _) => { return <Result.Ok value=(try self.placeHasReadOnlyReference(id: base)) />}
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return <Result.Ok value=(try self.placeHasReadOnlyReference(id: operand)) />}
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { return <Result.Ok value=self.isRefInst(ref: (try self.typeOf(id: base)).ref) />}
            Expr.Deref(val base) => { return <Result.Ok value=self.isRefInst(ref: (try self.typeOf(id: base)).ref) />}
            _ => { return <Result.Ok value=false />}
        }
    }

    inout fn verifyFieldReadVis(exprId: U64, base: U64, nameStart: U64, nameLen: U64) -> Result[(), CompileDiagnostic] {
        match self.arena.exprs[base] {
            Expr.Ident(val start, val len) => {
                if self.identIsTypeQualifier(start: start, len: len, tpFn: self.arena.functionCount()) {
                    if self.typeHasAssocFn(typeStart: start, typeLen: len, nameStart: nameStart, nameLen: nameLen) {
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "an associated function declaration cannot be used as a value; wrap the call in an explicit closure (e.g. `fn(...) {{ return Type.name(...) }}`) (spec/07)") />
                    } else {
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "a type name has no fields; use `Type.fn(...)` to call an associated function, or construct a value before reading fields (spec/07)") />
                    }
                }
            }
            _ => {}
        }
        val bt: TypeInfo = (try self.typeOf(id: base))
        if bt.kind == 2 {
            // an enum value has no fields — `opt.x` / `e.field` is always invalid (reach a
            // payload with `match`, an Optional with `?.` / `unwrapOr`). Without this the
            // access slid to the backend's "field access only on a registered struct value
            // (so far)" message, which reads like a compiler limitation, not a user error.
            val fei = self.enumIndexForType(ref: self.typedIrRefOfInfo(ti: bt))
            if fei < self.arena.enumCount() {
                return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "an enum value has no fields; `match` on its variants to reach a payload (for an `Optional` use `?.` / `unwrapOr` / `match`) (spec/07)") />
            }
            if self.fieldVis(structIndex: self.structIndexForType(ref: self.typedIrRefOfInfo(ti: bt)), fieldStart: nameStart, fieldLen: nameLen) == 3U64 {
                if self.typeHasMethodNamed(recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: nameStart, nameLen: nameLen) {
                    return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "a method cannot be used as a value; call it, or wrap it in a closure (e.g. `fn() {{ obj.method() }}`)") />
                }
            }
            try self.verifySelectedFieldExists(exprId: exprId, receiverTerm: self.parametricExprTerm(exprId: base), nameStart: nameStart, nameLen: nameLen, message: "no such field on this value's type")
            try self.checkFieldReadVis(ownerRef: self.typedIrRefOfInfo(ti: bt), fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
        } else {
            if bt.kind == 3 {
                try self.verifySelectedFieldExists(exprId: exprId, receiverTerm: self.parametricExprTerm(exprId: base), nameStart: nameStart, nameLen: nameLen, message: "no such field on this value's type")
                try self.checkFieldReadVis(ownerRef: self.typedIrRefOfInfo(ti: bt), fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
            }
        }
        return <Result.Ok value=() />
    }

    // Source selection is already committed. Compatibility may inspect that
    // signature, but cannot reopen names, views or conformance candidates.
    inout fn verifyRecordedMethodCall(exprId: U64, recv: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        // Diagnostic location is separate from the lexical module authority
        // used by checkSourceMethodVisibility, and from synthetic identity.
        val offset = self.exprOffset(id: exprId)
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val index = self.callTemplateIndex(siteKey: site)
        if index >= self.callTemplateLocations.count() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: method validation has no recorded source selection") />
        }
        val template = self.callTemplateAt(index: index)
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: val typeArgs, proofId: val proofId) => {
                if callee >= self.arena.functionCount() {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected method has no declaration") />
                }
                val function = self.arena.functionAt(index: callee)
                try self.checkSourceMethodVisibility(exprId: exprId, receiverTerm: template.receiverTypeTerm, function: function)
                try self.verifySelectedMethodReceiver(recv: recv, function: function, args: args)
                val environment = try self.recordedDirectCallEnvironment(function: function, receiverTerm: template.receiverTypeTerm, typeArgs: self.callTemplateTypeArgs(range: typeArgs), proof: self.thawStaticConformanceProof(id: proofId))
                try self.checkSelectedMethodArguments(exprId: exprId, function: function, environment: environment, args: args)
                self.recordResolvedMethodCallee(id: exprId, callee: callee)
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: _, resultTerm: _) => {
                val function = try self.selectedStaticCallDeclaration(resolution: resolution, offset: offset)
                match resolution {
                    StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {
                        try self.checkSourceMethodVisibility(exprId: exprId, receiverTerm: template.receiverTypeTerm, function: function)
                    }
                    _ => {}
                }
                try self.verifySelectedMethodReceiver(recv: recv, function: function, args: args)
                // Argument types/bounds use the retained trait substitution in
                // source-call closure, including selected provided declarations.
            }
            CallTemplateKind.Dynamic(receiver: _, args: _, target: val target) => {
                match target {
                    DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot, interfaceRoot: _) => {
                        if traitIndex >= self.decls.traitCount() || slot == 0U64 || slot > self.decls.traitAt(index: traitIndex).reqs.count() {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected dynamic method has no requirement") />
                        }
                        try self.verifySelectedMethodReceiver(recv: recv, function: self.traitReqAt(reqs: self.decls.traitAt(index: traitIndex).reqs, index: slot - 1U64), args: args)
                    }
                    DynamicCallTemplateTarget.ClosureField(fieldIndex: _, fnTypeTerm: _) => {}
                    _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: recorded method has a non-method dynamic target") /> }
                }
            }
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: method validation has no completed source selection") /> }
        }
        return <Result.Ok value=() />
    }

    inout fn verifySelectedMethodReceiver(recv: U64, function: Func, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if function.selfMove {
            try self.verifyOwnershipSource(id: recv)
        }
        // an `inout fn` method mutates the receiver, so it must be a mutable PLACE
        // — not an rvalue temporary (`<S…/>.bump()` / `mk().bump()` would mutate a
        // value that is immediately discarded — spec/03).
        if function.selfInout {
            val receiverPlace: U64 = self.materializablePlace(id: recv)
            if (try self.placeHasReadOnlyReference(id: receiverPlace)) {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: recv), msg: "cannot use read-only Ref as an inout place; expected MutableRef") />
            }
            if !(self.exprIsPlace(id: receiverPlace)) {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: recv), msg: "cannot call an `inout fn` method on a temporary value; the receiver must be a place (a variable or field) declared `mut val` (spec/03)") />
            }
            if !((try self.placeIsMutable(id: receiverPlace))) {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: recv), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`") />
            }
            // overlapping `inout` (spec/03): an `inout fn` self IS an inout
            // position, so it pairs with every `inout` argument — statically-
            // certain overlap (same place / containment like `a.merge(inout
            // a.field)`) errors here; runtime-value pairs get the pre-call
            // place-identity check from the backend.
            mut val k: U64 = 0
            while k < args.len {
                if self.argAt(args: args, index: k).isInout {
                    try self.checkInoutPair(a: receiverPlace, b: self.materializablePlace(id: self.argAt(args: args, index: k).expr))
                }
                k += 1U64
            }
        }
        return <Result.Ok value=() />
    }

    inout fn exprIsFloat(id: U64) -> Result[Bool, CompileDiagnostic] {
        match self.arena.exprs[id] {
            Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => { return <Result.Ok value=true />}
            _ => {}
        }
        // a value whose recovered type names a float type — by NAME regardless of kind
        // (F64 is in isPrimType so typeOf gives kind 0 for a local, but kind 2 for a literal).
        val ti: TypeInfo = (try self.typeOf(id: id))
        if ti.nameLen > 0U64 {
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F64") {
                return <Result.Ok value=true />
            }
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F32") {
                return <Result.Ok value=true />
            }
        }
        return <Result.Ok value=false />
    }

    inout fn castOperandIsBool(operand: U64) -> Result[Bool, CompileDiagnostic] {
        match self.arena.exprs[operand] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, tyLen: _, isNeg: _) => {
                if isBool { return <Result.Ok value=true />}
            }
            _ => {}
        }
        val st: TypeInfo = (try self.typeOf(id: operand))
        if st.nameLen > 0U64 {
            return <Result.Ok value=rangeEquals(bytes: self.arena.bytes, start: st.nameStart, len: st.nameLen, kw: "Bool") />
        }
        return <Result.Ok value=false />
    }

    inout fn verifyCastLossless(operand: U64, tyStart: U64, tyLen: U64, targetTerm: U64) -> Result[(), CompileDiagnostic] {
        // Bool is not a numeric type, so `as` (the lossless numeric / newtype-retag
        // conversion, spec/12) can't bridge Bool and a numeric type in either direction
        // (`true as I64`, `1I64 as Bool`) — use match / a comparison instead.
        val targetBool: Bool = rangeEquals(bytes: self.arena.bytes, start: tyStart, len: tyLen, kw: "Bool")
        val targetNum: Bool = self.isIntType(start: tyStart, len: tyLen) || self.isFloatType(start: tyStart, len: tyLen)
        if (try self.castOperandIsBool(operand: operand)) {
            if targetNum {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`as` cannot cast a Bool to a numeric type (Bool is not numeric; spec/12)") />
            }
        } else {
            if targetBool {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`as` cannot cast to Bool (Bool is not numeric; spec/12)") />
            }
        }
        if self.isIntType(start: tyStart, len: tyLen) {
            // a float -> int `as` truncates the fractional part = lossy, so it is not a
            // valid `as` conversion (spec/12: `as` is lossless/total only). Use TryFrom.
            if (try self.exprIsFloat(id: operand)) {
                return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`as` cannot convert a float to an integer (it would truncate the fractional part); use a fallible TryFrom conversion (spec/12)") />
            }
            match self.arena.exprs[operand] {
                Expr.Int(val value, val offset, isBool: _, tyStart: _, tyLen: _, val isNeg) => {
                    if !(self.litFitsType(value: value, neg: isNeg, dstStart: tyStart, dstLen: tyLen)) {
                        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "integer literal is out of range for the target type of `as`") />
                    }
                }
                _ => {
                    val st: TypeInfo = (try self.typeOf(id: operand))
                    if self.isIntType(start: st.nameStart, len: st.nameLen) {
                        if !(self.losslessInt(srcStart: st.nameStart, srcLen: st.nameLen, dstStart: tyStart, dstLen: tyLen)) {
                            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`as` would lose information (narrowing or signedness change); use a fallible TryFrom conversion") />
                        }
                    }
                }
            }
        }
        // A direct unsuffixed numeric literal is materialized in the explicit
        // cast context. Preserve that checked context for Record and Mid,
        // just as annotated values and selected call parameters already do.
        val contextTerm: U64 = self.castLiteralContextTerm(operand: operand, targetTerm: targetTerm)
        if contextTerm != 0U64 {
            try self.checkLitTi(id: operand, ti: self.typeInfoOfRef(ref: contextTerm))
        }
        return <Result.Ok value=() />
    }
}
