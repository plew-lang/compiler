// Part of the acceptance verification pass (root: _.pw): per-expression
// verification (member visibility, `as` narrowing, match exhaustiveness,
// destructure completeness).

// Recursively verify an expression: member visibility (field read / method call),
// `as` narrowing, nested match exhaustiveness, and descent into sub-expressions.
// The literal-range / call-arg / make-field / unique-arg checks are driven by
// checkLitCtx at the statement level (it walks the same tree), so this walk adds
// only the checks checkLitCtx does not perform.

pub impl Comp {
    inout fn moveOperandIsAggregatePartial(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Field(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Index(base: _, index: _) => { return true }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Deref(base: _) => { return true }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return self.moveOperandIsAggregatePartial(id: operand) }
            Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => { return self.moveOperandIsAggregatePartial(id: recv) }
            _ => { return false }
        }
    }

    inout fn verifyExpr(id: U64) {
        match self.arena.exprs[id] {
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                // verify the closure BODY with the closure's own return type as context —
                // else `return e` inside a closure escapes the return-type check entirely
                // (the body was previously never walked). Captured outer locals stay visible
                // (the closure's params are pushed on top of the current scope).
                val sRV: Bool = self.cur.retVoid
                val sRS: U64 = self.cur.retStart
                val sRL: U64 = self.cur.retLen
                val sRA: Bool = self.cur.retIsArray
                val sRT: U64 = self.cur.retTy
                if hasRet {
                    self.cur.retVoid = false
                    self.cur.retStart = retStart
                    self.cur.retLen = retLen
                    self.cur.retIsArray = retIsArray
                    self.cur.retTy = retTy
                } else {
                    self.cur.retVoid = true
                    self.cur.retStart = 0
                    self.cur.retLen = 0
                    self.cur.retIsArray = false
                    self.cur.retTy = 0
                }
                val cmark: U64 = self.scopeMark()
                mut val cpi: U64 = 0
                while cpi < params.count() {
                    val cp: Param = params[cpi]
                    self.addLocal(nameStart: cp.nameStart, nameLen: cp.nameLen, tyStart: cp.tyStart, tyLen: cp.tyLen, isArray: cp.tyIsArray, ty: cp.ty, isInout: cp.isInout, isMut: false, owned: cp.isMove)
                    cpi += 1U64
                }
                // a closure is a function boundary: `break`/`continue` inside it do not
                // target an enclosing loop, so reset the loop depth across its body.
                val sLoopDepth: U64 = self.cur.verifyLoopDepth
                self.cur.verifyLoopDepth = 0U64
                self.verifyBlock(blockId: body)
                self.cur.verifyLoopDepth = sLoopDepth
                // a closure with a declared NON-unit return type must return on every path,
                // like a function (`fn()->I64 { }` is missing its return; `fn()->() { }` is
                // void and exempt). spec/04.
                if hasRet {
                    mut val retIsUnit: Bool = retLen == 0U64
                    if rangeEquals(bytes: self.arena.bytes, start: retStart, len: retLen, kw: "()") {
                        retIsUnit = true
                    }
                    if !(retIsUnit) {
                        if !(self.blockDiverges(blkId: body)) {
                            self.errorAt(offset: self.exprOffset(id: id), msg: "this closure has a return type but can reach the end of its body without returning a value; add a `return` (or `panic`) on every path (spec/04)")
                        }
                    }
                }
                self.popLocals(mark: cmark)
                self.cur.retVoid = sRV
                self.cur.retStart = sRS
                self.cur.retLen = sRL
                self.cur.retIsArray = sRA
                self.cur.retTy = sRT
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                self.verifyFieldReadVis(base: base, nameStart: nameStart, nameLen: nameLen)
                self.verifyExpr(id: base)
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                self.verifyRecv(recv: recv)
                self.verifyArgs(args: args)
                // Do not recover the receiver through `typeOf` here: during
                // abstract checking that cache can already carry a concrete
                // instantiation from another phase.  The installed local
                // declaration is the authority for whether this is `T` in the
                // current generic body.
                mut val boundStart: U64 = 0U64
                mut val boundLen: U64 = 0U64
                match self.arena.exprs[recv] {
                    Expr.Ident(start: val localStart, len: val localLen) => {
                        val localId: U64 = intern(c: inout self, start: localStart, len: localLen)
                        mut val li: U64 = self.cur.locals.count()
                        while li > 0U64 && boundLen == 0U64 {
                            li -= 1U64
                            val local: Local = self.cur.locals[li]
                            if local.nameId == localId && self.isTypeParamOf(fnIdx: self.cur.checkFn, start: local.tyStart, len: local.tyLen) {
                                boundStart = local.tyStart
                                boundLen = local.tyLen
                            }
                        }
                    }
                    _ => {}
                }
                if boundLen != 0U64 {
                    if self.verifyBoundMethodCall(fnIdx: self.cur.checkFn, tpStart: boundStart, tpLen: boundLen, nameStart: nameStart, nameLen: nameLen, args: args) {
                        return
                    }
                }
                val mf: U64 = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
                val rt: TypeInfo = self.typeOf(id: recv)
                if rt.nameLen != 0U64 { self.verifyResolvedMethodCall(recv: recv, ownerStart: rt.nameStart, ownerLen: rt.nameLen, nameStart: nameStart, mf: mf, args: args) }
                self.recordResolvedMethodCallee(id: id, callee: mf)
                self.checkResolvedMethodArgs(mf: mf, args: args)
            }
            Expr.ExtMethod(val recv, val srcStart, val srcLen, val nameStart, val nameLen, val args) => {
                val assoc: Bind = self.assocRecvName(recv: recv)
                if assoc.nameLen != 0U64 {
                    val assocRef: U64 = self.simpleTypeRef(nameStart: assoc.nameStart, nameLen: assoc.nameLen)
                    val source: ViewSource = self.resolveViewSourceKey(recvStart: assoc.nameStart, recvLen: assoc.nameLen, recvRef: assocRef, sourceId: intern(c: inout self, start: srcStart, len: srcLen))
                    if source.kind == 0U64 {
                        self.errorAt(offset: srcStart, msg: "cannot apply this view to the associated-call type qualifier")
                    }
                    val mf: U64 = self.resolveExtMethodFinal(recv: recv, srcStart: srcStart, srcLen: srcLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    self.recordResolvedMethodCallee(id: id, callee: mf)
                    self.checkResolvedMethodArgs(mf: mf, args: args)
                    self.verifyArgs(args: args)
                    return
                }
                self.checkViewValid(recv: recv, srcStart: srcStart, srcLen: srcLen, strip: false)
                val rt: TypeInfo = self.typeOf(id: recv)
                val mf: U64 = self.resolveExtMethodFinal(recv: recv, srcStart: srcStart, srcLen: srcLen, nameStart: nameStart, nameLen: nameLen, args: args)
                self.recordResolvedMethodCallee(id: id, callee: mf)
                if rt.nameLen != 0U64 {
                    self.verifyResolvedMethodCall(recv: recv, ownerStart: rt.nameStart, ownerLen: rt.nameLen, nameStart: nameStart, mf: mf, args: args)
                    self.checkResolvedMethodArgs(mf: mf, args: args)
                }
                self.verifyExpr(id: recv)
                self.verifyArgs(args: args)
            }
            Expr.ExtView(val recv, val srcStart, val srcLen, val strip) => {
                // When this node is the receiver of `Type#View.member()`, the
                // parent Method verifies the type qualifier and its view
                // source.  Descending here would turn the type name into an
                // ordinary value read.  A standalone type view remains
                // rejected by its enclosing expression's normal value checks.
                if self.assocRecvName(recv: id).nameLen != 0U64 {
                    return
                }
                self.checkViewValid(recv: recv, srcStart: srcStart, srcLen: srcLen, strip: strip)
                self.verifyExpr(id: recv)
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                self.verifyArgs(args: args)
                self.checkCallArgCategories(nameStart: nameStart, nameLen: nameLen, args: args)
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                // enum variant construction (`<E.A x=1 />`) must specify EVERY payload
                // field — a variant payload has no default values, so a missing field was
                // silently constructed with garbage (spec/05). (Struct construction is
                // covered by the backend missing-field check plus field defaults.)
                if isEnum {
                    mut val cei: U64 = self.enumIdxByName(start: typeStart, len: typeLen)
                    if cei >= self.arena.enums.count() {
                        cei = self.genericEnumIndex(nameStart: typeStart, nameLen: typeLen)
                    }
                    if cei < self.arena.enums.count() {
                        // a construction naming a variant the enum does not declare
                        // (`<E.Z />`) would silently build variant 0 (variantIndex returns 0
                        // for an unknown name) — a garbage tag. Reject it (spec/05).
                        mut val vfound: Bool = false
                        mut val vk: U64 = 0
                        while vk < self.arena.enums[cei].variants.count() {
                            if spansEqual(c: inout self, aStart: self.arena.enums[cei].variants[vk].nameStart, aLen: self.arena.enums[cei].variants[vk].nameLen, bStart: variantStart, bLen: variantLen) {
                                vfound = true
                            }
                            vk += 1
                        }
                        if !(vfound) {
                            self.errorAt(offset: self.exprOffset(id: id), msg: "unknown enum variant in construction (this enum has no such variant)")
                        }
                        val cvi: U64 = self.variantIndex(enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen)
                        if cvi < self.arena.enums[cei].variants.count() {
                            val cfs: Array[FieldDef] = self.arena.enums[cei].variants[cvi].fields
                            // for a NON-generic enum, also category-check each provided
                            // payload value against the field's declared type (`<E.V a="s"/>`
                            // for `a: I64`). Generic enums (payload types need env grounding)
                            // are deferred.
                            val enumIsGen: Bool = self.arena.enums[cei].typeParams.count() > 0U64
                            mut val cfi: U64 = 0
                            while cfi < cfs.count() {
                                if !(self.makeFieldsCoverField(fields: fields, fieldStart: cfs[cfi].nameStart, fieldLen: cfs[cfi].nameLen)) {
                                    self.errorAt(offset: self.exprOffset(id: id), msg: "variant construction is missing a payload field; every field of the variant must be set")
                                }
                                if !(enumIsGen) {
                                    mut val mfk: U64 = 0
                                    while mfk < fields.count() {
                                        if spansEqual(c: inout self, aStart: fields[mfk].nameStart, aLen: fields[mfk].nameLen, bStart: cfs[cfi].nameStart, bLen: cfs[cfi].nameLen) {
                                            self.tcCheckValue(expectedRef: cfs[cfi].ty, valueExpr: fields[mfk].value, pos: self.tcFieldPos(prefix: "payload:", nameStart: cfs[cfi].nameStart, nameLen: cfs[cfi].nameLen))
                                            mfk = fields.count()
                                        } else {
                                            mfk += 1U64
                                        }
                                    }
                                }
                                cfi += 1U64
                            }
                        }
                    }
                }
                // generic arity: a generic type's construction must supply exactly as many
                // type arguments as the type has parameters (`<Box[I64, I64] …/>` for a
                // `Box[T]` was silently accepted, dropping the extra) — spec/06.
                if ty != 0U64 {
                    val tr: TypeRef = self.arena.types[ty]
                    if tr.args.count() > 0U64 {
                        // look up the head as ANY struct/enum (not only generic ones): a
                        // 0-param struct/enum constructed with type arguments (`struct Bar`
                        // then `<Bar[I32] …/>`) is an arity error too. genericStructIndex
                        // filters typeParams>0 and would miss it — the same hole that let
                        // `Foo[I32]` through for a non-generic `Foo` (spec/06).
                        mut val tpCount: U64 = self.arena.structs.count() + self.arena.enums.count() + 1U64
                        val gsi: U64 = self.anyStructIndex(nameStart: typeStart, nameLen: typeLen)
                        if gsi < self.arena.structs.count() {
                            tpCount = self.arena.structs[gsi].typeParams.count()
                        } else {
                            val gei: U64 = self.anyEnumIndex(nameStart: typeStart, nameLen: typeLen)
                            if gei < self.arena.enums.count() {
                                tpCount = self.arena.enums[gei].typeParams.count()
                            }
                        }
                        if tpCount <= self.arena.structs.count() + self.arena.enums.count() {
                            if tr.args.count() != tpCount {
                                self.errorAt(offset: self.exprOffset(id: id), msg: "wrong number of type arguments for this generic type")
                            }
                        }
                    }
                }
                // a NON-GENERIC struct's field value whose category disagrees with the
                // field's declared type (`<A x="s" />` for `x: I64`) reinterprets the bits
                // — reject (same reliable-value discipline as the let-annotation check).
                // Generic structs / enums (field types need env grounding) are deferred.
                mut val nonGenSidx: U64 = self.arena.structs.count()
                if !(isEnum) {
                    if ty == 0U64 || self.arena.types[ty].args.count() == 0U64 {
                        val sidxC: U64 = self.structIndexByName(start: typeStart, len: typeLen)
                        if sidxC < self.arena.structs.count() {
                            if self.arena.structs[sidxC].typeParams.count() == 0U64 && !self.arena.structs[sidxC].isExtern {
                                nonGenSidx = sidxC
                            }
                        }
                    }
                }
                // field gate (spec/05): a non-`pub` field cannot be set from another module.
                self.checkConstructVis(typeStart: typeStart, typeLen: typeLen, isEnum: isEnum, fields: fields, offset: self.exprOffset(id: id))
                mut val i: U64 = 0
                while i < fields.count() {
                    self.verifyExpr(id: fields[i].value)
                    if nonGenSidx < self.arena.structs.count() {
                        val cfs: Array[FieldDef] = self.arena.structs[nonGenSidx].fields
                        mut val fk: U64 = 0
                        while fk < cfs.count() {
                            if spansEqual(c: inout self, aStart: cfs[fk].nameStart, aLen: cfs[fk].nameLen, bStart: fields[i].nameStart, bLen: fields[i].nameLen) {
                                self.tcCheckValue(expectedRef: cfs[fk].ty, valueExpr: fields[i].value, pos: "field")
                                fk = cfs.count()
                            } else {
                                fk += 1U64
                            }
                        }
                    }
                    // a field specified twice in one construction (`<P x=1 x=2 />`) is a
                    // silent last-wins bug otherwise — reject the duplicate (spec/05).
                    mut val j: U64 = 0
                    while j < i {
                        if spansEqual(c: inout self, aStart: fields[j].nameStart, aLen: fields[j].nameLen, bStart: fields[i].nameStart, bLen: fields[i].nameLen) {
                            self.errorAt(offset: fields[i].offset, msg: "duplicate field in construction; each field may be set at most once")
                        }
                        j += 1U64
                    }
                    i += 1
                }
            }
            Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
                self.verifyCastLossless(operand: operand, tyStart: tyStart, tyLen: tyLen)
                self.verifyExpr(id: operand)
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                self.verifyExpr(id: lhs)
                self.verifyExpr(id: rhs)
                self.verifyBinaryOp(op: op, lhs: lhs, rhs: rhs)
                self.tcCheckBinop(op: op, lhs: lhs, rhs: rhs)
            }
            Expr.Unary(val op, val operand) => {
                self.verifyExpr(id: operand)
                self.tcCheckUnary(op: op, operand: operand)
            }
            Expr.Index(val base, val index) => {
                self.verifyExpr(id: base)
                self.verifyExpr(id: index)
                self.tcCheckArrayIndex(base: base, index: index)
                self.checkIndexKeyType(base: base, index: index)
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.count() {
                    self.verifyExpr(id: elems[i])
                    i += 1
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                self.verifyExpr(id: base)
                // `r->field` is strong-ref-only: a weak ref field read/write must go through
                // `upgrade()` (spec/03). Same pointed diagnostic as the `->method()` case.
                // (typeOf, not exprType: cached; only `.ref` is read here and an int context's
                // ref is 0 like a scalar's, so the isRefInst branches are unaffected.)
                val abt: TypeInfo = self.typeOf(id: base)
                if self.isWeakRefLikeInst(ref: abt.ref) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "a weak reference cannot be dereferenced with `->` (its referent may be gone); call `upgrade()` to get an `Optional` strong reference, then `->` the unwrapped value (spec/03)")
                } else if self.isStrongRefInst(ref: abt.ref) {
                    // `->` touches the POINTEE's field, so it obeys the pointee type's field
                    // visibility exactly like `.` does (spec/05) — `->` must not be a privacy
                    // escape hatch.
                    val inst: TypeRef = self.arena.types[abt.ref]
                    val pt: TypeInfo = self.typeInfoOfRef(ref: inst.args[0])
                    if pt.kind == 2 {
                        self.checkFieldReadVis(ownerStart: pt.nameStart, ownerLen: pt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
                    }
                }
            }
            Expr.Deref(val base) => {
                self.verifyExpr(id: base)
                // `->` is the POINTEE operator and is strong-ref-only (spec/03). A weak ref has no
                // direct deref — its referent may be dead — so it must be `upgrade()`d to an
                // `Optional` strong reference first. Reject `w->…` with a pointed message rather than the
                // opaque backend "not a registered struct" error.
                // (typeOf: cached; only `.ref` read — int context ref is 0, branches unaffected.)
                val bt: TypeInfo = self.typeOf(id: base)
                if self.isWeakRefLikeInst(ref: bt.ref) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "a weak reference cannot be dereferenced with `->` (its referent may be gone); call `upgrade()` to get an `Optional` strong reference, then `->` the unwrapped value (spec/03)")
                } else if !(self.isStrongRefInst(ref: bt.ref)) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "`->` requires a `Ref[T]` or `MutableRef[T]` on the left (it dereferences a reference cell's pointee)")
                }
            }
            Expr.OptChain(val base, cont: _) => {
                self.verifyExpr(id: base)
                // `?.` desugars (spec/12) to a match over `base.chain()` — the Chain
                // trait. The rewrite runs in Mono BEFORE Verify, replacing this node with
                // the match whenever `base` IS a Chain type. So an OptChain that SURVIVES
                // to here means Mono declined: `base` has no conforming `chain()`. Report
                // that at the base, rather than letting the undesugared node reach the
                // backend as an "internal:" error. `Optional` and any user type that
                // implements `Chain` qualify; a plain struct or scalar does not — and
                // `Result` is deliberately NOT Chain (propagate its error with `try`).
                val bt: TypeInfo = self.typeOf(id: base)
                mut val baseIsChain: Bool = false
                if bt.kind == 2I64 {
                    if bt.nameLen > 0U64 {
                        baseIsChain = self.typeConformsToChain(nameStart: bt.nameStart, nameLen: bt.nameLen)
                    }
                }
                if !(baseIsChain) {
                    self.errorAt(offset: self.exprOffset(id: base), msg: "the left of `?.` must fully implement `Chain`: a `chain()` returning an `Optional`, plus `fromValue(value:)` and `empty()` factories (spec/12). `Optional` and user Chain types qualify; a plain struct/scalar does not, and `Result` is not Chain (use `try`)")
                }
            }
            Expr.ChainHole => {}
            Expr.Try(val expr) => {
                self.verifyExpr(id: expr)
                // `try` is only valid in a function that RETURNS a Result (spec/13): it
                // early-returns the enclosing function's Result on `Err`. In a void /
                // non-Result function this used to crash the backend (it indexed the
                // return type's variant table, which isn't a Result). Reject cleanly.
                mut val retIsResult: Bool = false
                if !(self.cur.retVoid) {
                    if self.cur.retLen > 0U64 {
                        if rangeEquals(bytes: self.arena.bytes, start: self.cur.retStart, len: self.cur.retLen, kw: "Result") {
                            retIsResult = true
                        }
                    }
                }
                if !(retIsResult) {
                    self.errorAt(offset: self.exprOffset(id: expr), msg: "`try` is only valid in a function that returns a Result (spec/13)")
                }
                // `try` works only on a Result (spec/13). The operand being some OTHER
                // registered enum (notably `Optional`) used to crash the backend (it
                // assumed Ok/Err variants and indexed out of bounds). An Optional uses
                // `unwrapOr` / `?.` / `match` instead.
                val tti: TypeInfo = self.typeOf(id: expr)
                if tti.nameLen > 0U64 {
                    mut val isEnum: Bool = self.enumIdxByName(start: tti.nameStart, len: tti.nameLen) < self.arena.enums.count()
                    if !(isEnum) {
                        isEnum = self.genericEnumIndex(nameStart: tti.nameStart, nameLen: tti.nameLen) < self.arena.enums.count()
                    }
                    if isEnum {
                        if !(rangeEquals(bytes: self.arena.bytes, start: tti.nameStart, len: tti.nameLen, kw: "Result")) {
                            self.errorAt(offset: self.exprOffset(id: expr), msg: "`try` works only on a Result; for an Optional use `unwrapOr` / `?.` / `match` (spec/13)")
                        }
                    }
                    // the operand's error type E' must either match the enclosing
                    // function's error type E, or E must own a `from` factory accepting
                    // E' (spec/13): `try` then propagates the Err either unchanged or
                    // through `E.from(E')`. Without one of those, `try g()`
                    // (Result[_, String]) inside `-> Result[_, I64]` would reinterpret
                    // the String error as an I64. Compare the Err args (index 1).
                    if retIsResult {
                        if tti.ref != 0U64 {
                            if tti.ref < self.arena.types.count() {
                                if self.cur.retTy != 0U64 {
                                    if self.cur.retTy < self.arena.types.count() {
                                        val opR: TypeRef = self.arena.types[tti.ref]
                                        val fnR: TypeRef = self.arena.types[self.cur.retTy]
                                        if opR.args.count() >= 2U64 {
                                            if fnR.args.count() >= 2U64 {
                                                if !(self.typeRefEq(a: fnR.args[1], b: opR.args[1])) {
                                                    // The "no conversion" branch requires E and E' to be
                                                    // the SAME type — structural identity (`typeRefEq`),
                                                    // NOT assignment-compatibility. `typesCompatible` is too
                                                    // loose here: it treats a concrete `C` as compatible with
                                                    // `any P` when `C: P`, so `try` a `Result[_, C]` into a
                                                    // `-> Result[_, any P]` looked "same-typed", skipped both
                                                    // the `from` AND the existential boxing, and rewrapped the
                                                    // raw `C` into an `{ptr,ptr}` slot (invalid IR / SEGV).
                                                    // E != E' is allowed only when E owns a `from` factory
                                                    // that ACCEPTS E' (the source error): `try` then converts
                                                    // E' -> E via E.from (spec/13). Resolving that overload by
                                                    // the source type is essential — a `from` taking some
                                                    // other type would reinterpret E' bits.
                                                    if !(self.typeRefHasFromFactory(errRef: fnR.args[1], srcRef: opR.args[1])) {
                                                        self.errorAt(offset: self.exprOffset(id: expr), msg: "`try` error type does not match the function's Result error type, and the function's error type has no `from` factory that accepts it (spec/13)")
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Expr.MatchExpr(val scrut, val arms) => {
                self.checkMatchAccessMode(scrut: scrut, arms: arms)
                self.verifyExpr(id: scrut)
                self.checkMatchArmsEnum(scrut: scrut, arms: arms)
                if !(self.matchExhaustive(arms: arms)) {
                    self.errorAt(offset: self.exprOffset(id: scrut), msg: "match must be exhaustive: cover all variants or add a wildcard")
                }
                mut val ai: U64 = 0
                while ai < arms.count() {
                    val armMark: U64 = self.scopeMark()
                    self.checkDestructureComplete(a: arms[ai])
                    self.verifyAddArmBinds(a: arms[ai], scrut: scrut)
                    self.checkBranchYieldsValue(blkId: arms[ai].body, offset: self.exprOffset(id: id))
                    self.verifyBlock(blockId: arms[ai].body)
                    self.popLocals(mark: armMark)
                    ai += 1
                }
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.verifyExpr(id: cond)
                self.checkBranchYieldsValue(blkId: thenBlk, offset: self.exprOffset(id: id))
                self.checkBranchYieldsValue(blkId: elseBlk, offset: self.exprOffset(id: id))
                self.verifyBlock(blockId: thenBlk)
                self.verifyBlock(blockId: elseBlk)
            }
            Expr.Ident(val start, val len) => {
                // an identifier in read position must resolve to a value in scope: `self`, a
                // local / parameter / global. A named function is a callable declaration, not a
                // value; pass it around with an explicit closure wrapper. Otherwise it is
                // undefined — caught here at declaration time over EVERY entry-module body
                // (reachability-independent), not as a backend codegen side-effect that only
                // fired for emitted/reachable bodies (spec/04).
                // value position: a bare type / primitive name reaching here is NOT a value
                // (an assoc-fn receiver `Buffer.new()` / `I64.fromBytes(...)` is rerouted via
                // verifyRecv) — so it is an undefined-identifier misuse (`val x = SomeType`).
                // recordIdent stores the binding (value/fn/type-qual/undef) the backend reads;
                // a non-generic body has no type params, so pass the funcs.count() sentinel.
                val bindCode: I64 = self.recordIdent(id: id, start: start, len: len, tpFn: self.arena.funcs.count())
                if !(self.bindIsValue(code: bindCode)) {
                    if bindCode == identFnCode() {
                        self.errorAt(offset: start, msg: "a named function declaration cannot be used as a value; wrap it in an explicit closure (e.g. `fn(...) { return name(...) }`) (spec/04)")
                    } else {
                        self.errorAt(offset: start, msg: "undefined identifier: this name is not a local, parameter, or global in scope (a bare type name is valid only as an assoc-fn receiver like `Type.fn()`; a field of `self` needs `self.`) (spec/04)")
                    }
                }
                // use-after-move (spec/03): reading a local whose value was `move`d away.
                if self.cur.verifyMovedIdx.count() > 0U64 {
                    if self.verifyIsMoved(idx: self.localIndexByName(start: start, len: len)) {
                        self.errorAt(offset: start, msg: "use of a value after it was moved (`move` transfers ownership away — the variable is dead; bind a fresh value to use it again) (spec/03)")
                    }
                }
            }
            Expr.Move(val operand, val isBorrow) => {
                // `move`/`borrow` of a place (mirrors genExpr's Move arm). v1 `move`
                // consumes only a whole named local. Moving out of a field/element/pointee
                // would leave the aggregate partially initialized, which the v1 drop model
                // deliberately rejects (spec/11). Conditional moves remain rejected until
                // drop-elaboration dataflow lands.
                if !(isBorrow) {
                    if self.moveOperandIsAggregatePartial(id: operand) {
                        self.errorAt(offset: self.exprOffset(id: operand), msg: "aggregate partial move is not part of v1; move the whole value, or use a replace/take-style API that leaves the aggregate valid (spec/11)")
                    } else {
                        match self.arena.exprs[operand] {
                            Expr.Ident(val start, val len) => {
                                if self.isSelfRef(start: start, len: len) {
                                    self.errorAt(offset: self.exprOffset(id: operand), msg: "moving `self` is not yet supported")
                                }
                                if self.localIndexByName(start: start, len: len) < self.cur.branchBase {
                                    self.errorAt(offset: self.exprOffset(id: operand), msg: "cannot `move` a variable declared outside the enclosing conditional/loop (the move would be conditional); move it unconditionally")
                                }
                            }
                            _ => {
                                self.errorAt(offset: self.exprOffset(id: operand), msg: "`move` is only supported from a whole local variable in v1")
                            }
                        }
                    }
                }
                // verify the operand FIRST (a second `move u` / a read after move resolves
                // through the Ident arm below and reports the use-after-move), THEN record
                // the move so later uses are caught. spec/03.
                self.verifyExpr(id: operand)
                if !(isBorrow) {
                    match self.arena.exprs[operand] {
                        Expr.Ident(val start, val len) => {
                            self.verifyMarkMoved(idx: self.localIndexByName(start: start, len: len))
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
    }

    // Verify a method/assoc receiver. A bare type / primitive name here is a valid assoc-
    // fn qualifier (`Buffer.new()`, `I64.fromBytes(...)`), not a value read — so it needs
    // no value check. Any other receiver is an ordinary value and is verified normally (its
    // Ident arm runs the value check). A non-generic body has no type parameters in scope,
    // so pass the funcs.count() sentinel to identIsTypeQualifier.
    inout fn verifyRecv(recv: U64) {
        if self.assocRecvName(recv: recv).nameLen != 0U64 {
            // A type-qualified associated call can carry `#` view selectors.
            // It is not a value read, so descending into its base Ident would
            // incorrectly demand a local named `Sample`.
            return
        }
        match self.arena.exprs[recv] {
            Expr.Ident(val start, val len) => {
                if !(self.identIsTypeQualifier(start: start, len: len, tpFn: self.arena.funcs.count())) {
                    self.verifyExpr(id: recv)
                }
            }
            _ => { self.verifyExpr(id: recv) }
        }
    }
}

pub impl Comp {

    // Whether any construction field matches the given field name (start,len).
    inout fn makeFieldsCoverField(fields: Array[MakeField], fieldStart: U64, fieldLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < fields.count() {
            if spansEqual(c: inout self, aStart: fields[i].nameStart, aLen: fields[i].nameLen, bStart: fieldStart, bLen: fieldLen) {
                return true
            }
            i += 1U64
        }
        return false
    }

    inout fn bindsCoverField(binds: Array[Bind], fieldStart: U64, fieldLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < binds.count() {
            if spansEqual(c: inout self, aStart: binds[i].fieldStart, aLen: binds[i].fieldLen, bStart: fieldStart, bLen: fieldLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // Whether any declared field matches the given name span (byte content).
    inout fn structFieldsContain(fields: Array[FieldDef], fieldStart: U64, fieldLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < fields.count() {
            if spansEqual(c: inout self, aStart: fields[i].nameStart, aLen: fields[i].nameLen, bStart: fieldStart, bLen: fieldLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // A record-destructuring statement / loop pattern must name EVERY field of the
    // record — bind it or discard it with `label: _` — and may name each field only
    // once (spec/03: no implicit dropping, no `..`, so adding a field to a record
    // breaks stale destructures loudly). Lower records each site's bind list
    // (DestructureSite — the temp+field-lets desugar erases it); this runs from the
    // owning statement's verify arm, where the locals env is live, keyed by the
    // lowered init/iter expr id. An unknown/non-record init type is left to the
    // regular per-field machinery (the synthesized Field reads still check).
    inout fn checkDestructureSite(initId: U64, isElem: Bool) {
        mut val si: U64 = 0
        while si < self.decls.destructureSites.count() {
            val site: DestructureSite = self.decls.destructureSites[si]
            if site.initId == initId && site.isElem == isElem {
                self.checkDestructureSiteBinds(site: site)
                return
            }
            si += 1
        }
    }

    inout fn checkDestructureSiteBinds(site: DestructureSite) {
        val ti: TypeInfo = self.typeOf(id: site.initId)
        mut val tnStart: U64 = ti.nameStart
        mut val tnLen: U64 = ti.nameLen
        if site.isElem {
            // the loop-source case: the record is the array's ELEMENT — a kind-3
            // TypeInfo's name span already names the element.
            if ti.kind != 3 {
                return
            }
        } else {
            if ti.ref != 0U64 && ti.ref < self.arena.types.count() {
                tnStart = self.arena.types[ti.ref].nameStart
                tnLen = self.arena.types[ti.ref].nameLen
            }
        }
        // the struct form (`P { val x } = e`) declares the type it destructures —
        // the initializer must actually BE that struct (another type silently
        // binding same-named fields would hide a type error, spec/03).
        if site.typeLen > 0U64 {
            if !(spansEqual(c: inout self, aStart: site.typeStart, aLen: site.typeLen, bStart: tnStart, bLen: tnLen)) {
                self.errorAt(offset: site.offset, msg: "the struct destructure's type name does not match the initializer's type (spec/03)")
                return
            }
        }
        val sidx: U64 = self.structIndexByName(start: tnStart, len: tnLen)
        if sidx >= self.arena.structs.count() {
            return
        }
        val sd: StructDef = self.arena.structs[sidx]
        mut val bi: U64 = 0
        while bi < site.binds.count() {
            // each named field must exist on the record (also covers a typo'd
            // `nope: _` discard, which synthesizes no Field read)…
            if !(self.structFieldsContain(fields: sd.fields, fieldStart: site.binds[bi].fieldStart, fieldLen: site.binds[bi].fieldLen)) {
                self.errorAt(offset: site.binds[bi].offset, msg: "no such field on this value's type (a record-destructure shorthand bind must spell the field's name — rename with `fieldName: val newName`)")
            }
            // …and only once.
            mut val bj: U64 = bi + 1U64
            while bj < site.binds.count() {
                if spansEqual(c: inout self, aStart: site.binds[bi].fieldStart, aLen: site.binds[bi].fieldLen, bStart: site.binds[bj].fieldStart, bLen: site.binds[bj].fieldLen) {
                    self.errorAt(offset: site.binds[bj].offset, msg: "this field is destructured more than once — a record destructure names each field exactly once (spec/03)")
                }
                bj += 1
            }
            bi += 1
        }
        mut val fi: U64 = 0
        while fi < sd.fields.count() {
            if !(self.bindsCoverField(binds: site.binds, fieldStart: sd.fields[fi].nameStart, fieldLen: sd.fields[fi].nameLen)) {
                self.errorAt(offset: site.offset, msg: "a record destructure must bind or discard every field (a field is missing — bind it or use `label: _`; `..` is not allowed, spec/03)")
            }
            fi += 1
        }
    }

    // A struct-destructure pattern `S { … }` must bind OR discard (`field: _`) EVERY
    // field — `..` is not allowed (spec/05,11). Omitting a field silently dropped it
    // before; now a missing field is a loud error, so adding a field to a struct makes
    // existing patterns fail (catching silent take-misses). Generic-struct patterns
    // (`Box[I32] { … }`) resolve fields via the generic def.
    inout fn checkDestructureComplete(a: MatchArm) {
        // a pattern names each field at most once — a duplicate bind would read the
        // same field into two locals while completeness lets another field slip.
        mut val di: U64 = 0
        while di < a.binds.count() {
            mut val dj: U64 = di + 1U64
            while dj < a.binds.count() {
                if spansEqual(c: inout self, aStart: a.binds[di].fieldStart, aLen: a.binds[di].fieldLen, bStart: a.binds[dj].fieldStart, bLen: a.binds[dj].fieldLen) {
                    self.errorAt(offset: a.binds[dj].offset, msg: "this field is destructured more than once — a pattern names each field exactly once (spec/05,11)")
                }
                dj += 1
            }
            di += 1
        }
        if a.isStruct {
            mut val si: U64 = self.structIndexByName(start: a.enumStart, len: a.enumLen)
            if si >= self.arena.structs.count() {
                si = self.genericStructIndex(nameStart: a.enumStart, nameLen: a.enumLen)
            }
            if si < self.arena.structs.count() {
                val sd: StructDef = self.arena.structs[si]
                mut val fi: U64 = 0
                while fi < sd.fields.count() {
                    if !(self.bindsCoverField(binds: a.binds, fieldStart: sd.fields[fi].nameStart, fieldLen: sd.fields[fi].nameLen)) {
                        self.errorAt(offset: a.enumStart, msg: "struct destructure must bind or discard every field (a field is missing — bind it or use `field: _`; `..` is not allowed)")
                    }
                    fi += 1
                }
            }
            return
        }
        // an enum payload destructure `E.V(val a, b: _)`: when the arm binds ANY payload
        // field it must cover EVERY field of the variant (bind or discard) — spec/05,11. A
        // bare tag match `E.V =>` (no binds) matches only the tag and is left alone.
        if a.binds.count() == 0U64 {
            return
        }
        val ei: U64 = self.enumIdxByName(start: a.enumStart, len: a.enumLen)
        if ei < self.arena.enums.count() {
            val vi: U64 = self.variantIndex(enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen)
            if vi < self.arena.enums[ei].variants.count() {
                val fs: Array[FieldDef] = self.arena.enums[ei].variants[vi].fields
                mut val fi: U64 = 0
                while fi < fs.count() {
                    if !(self.bindsCoverField(binds: a.binds, fieldStart: fs[fi].nameStart, fieldLen: fs[fi].nameLen)) {
                        self.errorAt(offset: a.binds[0].offset, msg: "variant payload destructure must bind or discard every field (a field is missing — bind it or use `field: _`); or match only the tag with a bare `E.V =>`")
                    }
                    fi += 1
                }
            }
        }
    }

    // A value-position `if`/`match` branch must yield a value. A block yields via `give`
    // (the bare-expr arm `=> e` desugars to one); a block with no `give` yields `()`, so
    // consuming it where a value is expected silently produced 0 / a confusing "literal
    // has no type from context". Reject it with a clear message. A branch that always
    // diverges (return/panic/…) needs no give.
    inout fn checkBranchYieldsValue(blkId: U64, offset: U64) {
        if self.blockDiverges(blkId: blkId) {
            return
        }
        if self.blockGiveExpr(blkId: blkId) >= self.arena.exprs.count() {
            self.errorAt(offset: offset, msg: "a value-position `if`/`match` branch must end with `give` to yield a value (a block with no `give` yields `()` — spec/11)")
        }
    }

    inout fn verifyAddArmBinds(a: MatchArm, scrut: U64) {
        if a.isWildcard {
            return
        }
        if a.isStruct {
            // a struct destructure requires a scrutinee OF that struct type (spec/11). A
            // mismatched / non-struct scrutinee (`match anI64 { P { … } }`, or an unknown
            // `P`) used to crash the field lookup (out-of-bounds) — reject cleanly.
            val st: TypeInfo = self.typeOf(id: scrut)
            if st.nameLen > 0U64 {
                if !(spansEqual(c: inout self, aStart: st.nameStart, aLen: st.nameLen, bStart: a.enumStart, bLen: a.enumLen)) {
                    self.errorAt(offset: armDiagOffset(a: a), msg: "struct destructure pattern type does not match the scrutinee type")
                }
            }
        }
        self.addArmBinds(a: a, scrut: scrut)
    }

    // Bring an arm's payload binds into scope (no diagnostics) — the bind-registration
    // half of verifyAddArmBinds, also used by the literal-typing walk (checkLitCtx),
    // which must see a give-value's payload binds at their real type but must not
    // re-emit verifyAddArmBinds's destructure diagnostic (that walk runs first).
    inout fn addArmBinds(a: MatchArm, scrut: U64) {
        if a.isWildcard {
            return
        }
        val st: TypeInfo = self.typeOf(id: scrut)
        val generic: Bool = self.isGenericInst(ref: st.ref)
        mut val bi: U64 = 0
        if a.isStruct {
            while bi < a.binds.count() {
                val bd: Bind = a.binds[bi]
                if bd.nameLen == 0U64 {
                    bi += 1
                    continue
                }
                mut val ft: TypeInfo = scalarInfo()
                if generic {
                    ft = self.genericFieldTypeInfo(instRef: st.ref, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                } else {
                    ft = self.fieldType(structStart: a.enumStart, structLen: a.enumLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                }
                self.addLocal(nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
                bi += 1
            }
        } else {
            while bi < a.binds.count() {
                val bd: Bind = a.binds[bi]
                if bd.nameLen == 0U64 {
                    bi += 1
                    continue
                }
                if generic {
                    val bti: TypeInfo = self.genericEnumFieldTypeInfo(instRef: st.ref, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                    self.addLocal(nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    self.addBindLocalCn(enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen, cnum: 0)
                }
                bi += 1
            }
        }
    }
}
