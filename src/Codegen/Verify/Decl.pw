// Part of the acceptance verification pass (root: _.pw): the pass entry
// (verifyProgram) plus declaration-level checks — shapes, duplicate type/
// function/field/label names, generic arity, lang-item redefinition.

// Verify every non-extern, non-template function body.

pub impl Comp {
    // A written `#Name` has no syntax for choosing between distinct trait
    // declarations and an extension of the same spelling.  Resolve that text
    // to source identities before member lookup; candidate type matching must
    // never silently choose one source for the user.
    inout fn viewSourceCount(typeStart: U64, typeLen: U64, typeRef: U64, srcStart: U64, srcLen: U64) -> U64 {
        val typeId: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        val traitOwner: U64 = self.canonicalTraitOwner(start: srcStart, len: srcLen)
        mut val count: U64 = 0U64
        if self.extAppliesToType(extStart: srcStart, extLen: srcLen, typeStart: typeStart, typeLen: typeLen, typeRef: typeRef) { count = 1U64 }
        mut val firstTraitOwner: U64 = 0U64
        mut val firstTraitArity: U64 = 0U64
        mut val i: U64 = 0U64
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if traitOwner != 0U64 && cf.extId == 0U64 && cf.typeId == typeId && cf.traitStart == traitOwner {
                val applies: Bool = self.conformanceSubjectMatches(cf: cf, typeRef: typeRef)
                if applies {
                    val arity: U64 = cf.traitArgs.count()
                    val owner: U64 = cf.traitStart
                    if firstTraitOwner == 0U64 {
                        firstTraitOwner = owner
                        firstTraitArity = arity
                        count += 1U64
                    } else if firstTraitOwner != owner || firstTraitArity != arity {
                        return 2U64
                    }
                }
            }
            i += 1U64
        }
        return count
    }

    inout fn verifyProgram() {
        // global initializers first: module-level `val g = …` is program code too, and
        // the acceptance rules (literal context/range, array-element consistency,
        // unique-copy, generic arity) reach it exactly like a function body. Without
        // this walk a module-level `val xs: Array[String] = ["a", 1I64]` was accepted
        // and the stray element's bits were reinterpreted at run time (SIGSEGV). Each
        // Let adds itself as a local as it goes, so a later init reading an earlier
        // global resolves — same shape as the record pass's globals walk.
        self.cur.retVoid = true
        self.cur.retStart = 0
        self.cur.retLen = 0
        self.cur.retIsArray = false
        self.cur.retTy = 0
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.clearSelfItemEnv()
        self.cur.branchBase = 0
        self.cur.locals = []
        self.cur.verifyMovedIdx = []
        self.checkTypeViewSources()
        mut val gvi: U64 = 0
        while gvi < self.arena.globals.count() {
            if self.tracePhases {
                eprint(text: "[trace-phase] verify:global index=")
                traceU64(n: gvi)
                eprint(text: "\n")
            }
            self.verifyStmt(stmtId: self.arena.globals[gvi].letStmt)
            gvi += 1
        }
        self.cur.locals = []
        self.cur.verifyMovedIdx = []
        // Verification consumes the closed source declaration frontier.  Its
        // expression checks can discover implementation-only callable rows;
        // feeding those rows back into this same acceptance walk makes the
        // verifier recursively verify its own derived work instead of the
        // program the user wrote.  Derived bodies are checked at their explicit
        // instantiation/emission boundary, so snapshot the authored frontier.
        val sourceFuncLimit: U64 = self.arena.funcs.count()
        mut val fi: U64 = 0
        while fi < sourceFuncLimit {
            val f: Func = self.arena.funcs[fi]
            // Verify EVERY module's bodies, not just the entry module: a Plew program's
            // acceptance rules apply uniformly to imported code too (std, the compiler's
            // own import submodules, future package deps) — "develops as spoken" reaches
            // across the import boundary, and verifying the compiler's own source (the
            // largest Plew program) is the deepest dogfood of the language. Cost is ~5% on
            // a self-compile and noise on an ordinary program (measured). The former
            // entry-module-only gate is gone; its false-reject rationale (a prelude
            // operator witness `Add[U64]` in SipHasher said to be loaded only on import) is
            // moot — Core is force-loaded WITH its witnesses (see Frontend force-load), so a
            // no-import program resolves them fine. extern fns have no body to verify.
            if !(f.isExtern) {
                if f.typeParams.count() > 0U64 {
                    // a generic template: its concrete instances are checked during the
                    // C emitter's instance emission (with the substitution env); this
                    // backend-independent pass covers non-generic bodies (where the
                    // reject-test surface lives) without a substitution env.
                } else {
                if self.methodRecvIsTrait(f: f) {
                    // a trait provided-method template — checked per conforming type
                    // (its concrete copies are ordinary funcs and get verified).
                } else {
                    // async bodies are checked too: an `async fn f() -> I64` body's
                    // `return n` yields the DECLARED type I64 (the Promise[I64] wrapping is
                    // implicit), so the return-context check uses f.retStart as-is. `await`
                    // expressions infer as unknown (0) and are left to the conservative
                    // pass-through. (The retired C emitter used to be the only check here.)
                    self.cur.checkFn = fi
                    if self.tracePhases {
                        eprint(text: "[trace-phase] verify:function index=")
                        traceU64(n: fi)
                        eprint(text: " offset=")
                        traceU64(n: f.defOffset)
                        eprint(text: "\n")
                    }
                    self.verifyFunc(f: f)
                }
                }
            }
            fi += 1
        }
        if self.tracePhases { eprint(text: "[trace-phase] verify:decl-shapes\n") }
        self.checkDeclShapes(sourceFuncLimit: sourceFuncLimit)
    }

    // The source-selection proof for both `value#Name` and `Type#Name`.
    // `allowMonomorphicFallback` exists only for expression type recovery:
    // scalar values have no TypeRef, whereas an authored type annotation does.
    inout fn checkViewSourceValid(typeStart: U64, typeLen: U64, typeRef: U64, srcStart: U64, srcLen: U64, offset: U64, allowMonomorphicFallback: Bool) {
        // `#X` names a source, not a syntactic category. A trait and an
        // extension may have the same spelling; accept the view when either
        // source is applicable and let callable lookup select (or loudly reject
        // an ambiguity between) the concrete source candidates.
        val traitNamed: Bool = self.canonicalTraitOwner(start: srcStart, len: srcLen) != 0U64
        // A trait view is an application of a concrete conformance, not a
        // name-level statement about the receiver head.  This is deliberately
        // the same query used by `where`: `Box[I64] as P` must not make
        // `Box[String]#P` well-formed.
        mut val traitApplies: Bool = false
        if traitNamed {
            if typeRef != 0U64 {
                traitApplies = self.conformsInstance(ref: typeRef, traitStart: srcStart, traitLen: srcLen)
            } else if allowMonomorphicFallback {
                // Scalars (and other monomorphic receiver heads) carry no
                // TypeRef in TypeInfo.  Name identity is complete only in
                // this arity-zero case; generic receivers must use the full
                // instance query above.
                traitApplies = self.typeConformsTo(typeStart: typeStart, typeLen: typeLen, traitStart: srcStart, traitLen: srcLen)
            }
        }
        val extNamed: Bool = self.isExtName(start: srcStart, len: srcLen)
        val extApplies: Bool = extNamed && self.extAppliesToType(extStart: srcStart, extLen: srcLen, typeStart: typeStart, typeLen: typeLen, typeRef: typeRef)
        if traitApplies || extApplies {
            if self.viewSourceCount(typeStart: typeStart, typeLen: typeLen, typeRef: typeRef, srcStart: srcStart, srcLen: srcLen) > 1U64 {
                self.errorAt(offset: offset, msg: "ambiguous view source: this `#` name denotes multiple declaration sources")
            }
            return
        }
        if traitNamed {
            self.errorAt(offset: offset, msg: "cannot view this value through that trait (`value#P`): its type does not conform to the trait — a trait view only narrows an existing conformance, it never confers one (spec/09)")
        }
        if extNamed {
            self.errorAt(offset: offset, msg: "extension does not apply to this trait instance or concrete receiver (spec/09)")
        }
        self.errorAt(offset: offset, msg: "unknown view `#X`: the name is neither an extension that applies here nor a trait this type conforms to (spec/09)")
    }

    inout fn checkTypeViewSources() {
        mut val i: U64 = 0U64
        while i < self.arena.types.count() {
            val t: TypeRef = self.arena.types[i]
            // Synthetic TypeRefs and type-parameter heads have no authored
            // annotation site. Every user-written `Type#Name` does.
            if t.siteOffset != 0U64 {
                val sources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: i)
                self.checkTraitSubjectViewCycles(viewIds: self.viewSourceIds(sources: sources), offset: t.siteOffset)
                mut val selectedCount: U64 = 0U64
                mut val vi: U64 = 0U64
                while vi < sources.count() {
                    val sourceSelector: ResolvedViewSource = sources[vi]
                    if sourceSelector.surfaceId != 0U64 && sourceSelector.surfaceId <= self.interner.entries.count() {
                        self.checkResolvedTypeViewSourceValid(typeRef: i, source: sourceSelector, offset: t.siteOffset)
                        val source: ViewSource = self.resolveViewSourceKey(recvStart: t.nameStart, recvLen: t.nameLen, recvRef: i, sourceId: sourceSelector.surfaceId, sourceOwner: sourceSelector.traitOwner)
                        if source.kind == 2U64 { selectedCount += 1U64 }
                    }
                    vi += 1U64
                }
                if selectedCount > 1U64 {
                    self.errorAt(offset: t.siteOffset, msg: "a type view may select at most one trait source; extension views compose but trait selection is singular (spec/09)")
                }
            }
            i += 1U64
        }
    }

    inout fn checkViewValid(recv: U64, srcStart: U64, srcLen: U64, strip: Bool) {
        if strip { return }
        val rt: TypeInfo = self.exprType(id: recv)
        if rt.nameLen == 0U64 { return }
        self.checkViewSourceValid(typeStart: rt.nameStart, typeLen: rt.nameLen, typeRef: rt.ref, srcStart: srcStart, srcLen: srcLen, offset: self.exprOffset(id: recv), allowMonomorphicFallback: rt.ref == 0U64 && self.recvOwnParamCount(rt: rt) == 0U64)
        // Views are normalized as an unordered extension set plus one optional
        // trait provenance selector.  Enforce the same cardinality rule for
        // value re-views as `checkTypeViewSources` does for `Type#…`: otherwise
        // only an expression chain could manufacture an unrepresentable
        // two-trait state.
        val selected: ViewSource = self.resolveViewSourceKey(recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: rt.ref, sourceId: intern(c: inout self, start: srcStart, len: srcLen))
        if selected.kind == 2U64 {
            val active: Array[ViewSource] = self.collectViewSources(recv: recv, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: rt.ref)
            mut val i: U64 = 0U64
            while i < active.count() {
                if active[i].kind == 2U64 && !(self.sameViewSource(a: active[i], b: selected)) {
                    self.errorAt(offset: self.exprOffset(id: recv), msg: "a view may select at most one trait source; extension views compose but trait selection is singular (spec/09)")
                }
                i += 1U64
            }
        }
    }

    // Value selectors already carry their lexical trait declaration owner.
    // Do not send them through the legacy spelling-based validation above:
    // its canonicalTraitOwner lookup has no re-export provenance and can
    // select a same-spelled trait from another loaded module.
    inout fn checkResolvedViewValid(recv: U64, source: ResolvedViewSource, strip: Bool) {
        if strip { return }
        val rt: TypeInfo = self.exprType(id: recv)
        if rt.nameLen == 0U64 { return }
        val selected: ViewSource = self.resolveViewSourceKey(recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: rt.ref, sourceId: source.surfaceId, sourceOwner: source.traitOwner)
        if selected.kind != 0U64 {
            // `#Trait` is a singleton selector in the normalized view state.
            // Compare semantic owners carried by both authored selectors; a
            // spelling-only reconstruction here would again make imports part
            // of the later resolver's meaning.
            if selected.kind == 2U64 {
                val active: Array[ViewSource] = self.collectViewSources(recv: recv, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: rt.ref)
                mut val i: U64 = 0U64
                while i < active.count() {
                    if active[i].kind == 2U64 && !(self.sameViewSource(a: active[i], b: selected)) {
                        self.errorAt(offset: source.writtenStart, msg: "a view may select at most one trait source; extension views compose but trait selection is singular (spec/09)")
                    }
                    i += 1U64
                }
            }
            return
        }
        if source.traitOwner != 0U64 {
            self.errorAt(offset: source.writtenStart, msg: "cannot view this value through that trait (`value#P`): its type does not conform to the trait — a trait view only narrows an existing conformance, it never confers one (spec/09)")
        }
        val entry: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
        if self.isExtName(start: entry.start, len: entry.len) {
            self.errorAt(offset: source.writtenStart, msg: "extension does not apply to this trait instance or concrete receiver (spec/09)")
        }
        self.errorAt(offset: source.writtenStart, msg: "unknown view `#X`: the name is neither an extension that applies here nor a trait this type conforms to (spec/09)")
    }

    // Type terms carry the same semantic selector child as value views. A
    // trait selector is identified by declaration owner, never by its
    // content-interned spelling.
    inout fn checkResolvedTypeViewSourceValid(typeRef: U64, source: ResolvedViewSource, offset: U64) {
        if typeRef == 0U64 || typeRef >= self.arena.types.count() { return }
        val t: TypeRef = self.arena.types[typeRef]
        val selected: ViewSource = self.resolveViewSourceKey(recvStart: t.nameStart, recvLen: t.nameLen, recvRef: typeRef, sourceId: source.surfaceId, sourceOwner: source.traitOwner)
        if selected.kind != 0U64 { return }
        if source.traitOwner != 0U64 {
            self.errorAt(offset: offset, msg: "cannot view this type through that trait: its instance does not conform to the selected trait (spec/09)")
        }
        val entry: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
        if self.isExtName(start: entry.start, len: entry.len) {
            self.errorAt(offset: offset, msg: "extension does not apply to this trait instance or concrete receiver (spec/09)")
        }
        self.errorAt(offset: offset, msg: "unknown view `#X`: the name is neither an extension that applies here nor a trait this type conforms to (spec/09)")
    }

    // A chain of `Expr.ExtView` nodes represents one normalized view, not a
    // succession of observable intermediate source-sets.  Its outermost node
    // is the only point that may run structural source-set validation.
    inout fn exprFeedsAnotherView(id: U64) -> Bool {
        mut val idx: U64 = 0U64
        while idx < self.arena.exprs.count() {
            match self.arena.exprs[idx] {
                Expr.ExtView(recv: val recv, source: _, strip: _) => { if recv == id { return true } }
                Expr.ExtMethod(recv: val recv, source: _, nameStart: _, nameLen: _, args: _) => { if recv == id { return true } }
                _ => {}
            }
            idx += 1U64
        }
        return false
    }

    inout fn checkDeclShapes(sourceFuncLimit: U64) {
        // the `--gen` harness (spec/16) is a synthesized, trusted artifact that may
        // duplicate derive scaffolding by construction; the actual generated source is
        // decl-shape-checked when the final program is compiled normally (non-gen).
        if self.genMode {
            return
        }
        self.checkLangItemRedef()
        self.checkBlanketHeadless()
        self.checkNewtypeCycles()
        self.checkDupTypeNames()
        self.checkDupParamLabels(sourceFuncLimit: sourceFuncLimit)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[si]
            if !(sd.isExtern) {
                if self.moduleOf(offset: sd.nameStart) == 0U64 {
                    self.checkDupFields(fs: sd.fields, ctx: "struct")
                }
            }
            si += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[ei]
            if self.moduleOf(offset: ed.nameStart) == 0U64 {
                // duplicate variant names, and duplicate fields within each variant.
                mut val vi: U64 = 0
                while vi < ed.variants.count() {
                    mut val vj: U64 = vi + 1U64
                    while vj < ed.variants.count() {
                        if spansEqual(c: inout self, aStart: ed.variants[vi].nameStart, aLen: ed.variants[vi].nameLen, bStart: ed.variants[vj].nameStart, bLen: ed.variants[vj].nameLen) {
                            self.errorAt(offset: ed.variants[vj].nameStart, msg: "duplicate enum variant name (each variant must be distinct)")
                        }
                        vj += 1
                    }
                    self.checkDupFields(fs: ed.variants[vi].fields, ctx: "variant")
                    vi += 1
                }
            }
            ei += 1
        }
    }

    // A newtype whose underlying chain never reaches a concrete type (`newtype A = B` /
    // `newtype B = A`) has no representation — resolution (llvmScalarTy and every other
    // underlying-chase) would follow the chain forever, hanging the compiler on first
    // use (audit-5 L5). Reject at declaration: more hops than there are newtypes is a
    // cycle by pigeonhole.
    inout fn checkNewtypeCycles() {
        mut val i: U64 = 0
        while i < self.arena.newtypes.count() {
            val nt: NewtypeDef = self.arena.newtypes[i]
            mut val curStart: U64 = nt.underStart
            mut val curLen: U64 = nt.underLen
            mut val hops: U64 = 0
            mut val chasing: Bool = true
            while chasing {
                // step by "is the current name itself a newtype?" — NOT by span progress:
                // a direct self-cycle (`newtype A = A`) resolves to the same span and a
                // progress test would wrongly conclude "done".
                val qid: U64 = intern(c: inout self, start: curStart, len: curLen)
                mut val found: Bool = false
                mut val j: U64 = 0
                while j < self.arena.newtypes.count() {
                    if self.arena.newtypes[j].nameId == qid {
                        curStart = self.arena.newtypes[j].underStart
                        curLen = self.arena.newtypes[j].underLen
                        found = true
                        j = self.arena.newtypes.count()
                    } else {
                        j += 1
                    }
                }
                if found {
                    hops += 1
                    if hops > self.arena.newtypes.count() {
                        self.errorAt(offset: nt.defOffset, msg: "newtype cycle: this newtype's underlying chain never reaches a concrete type (spec/10)")
                    }
                } else {
                    chasing = false
                }
            }
            i += 1
        }
    }

    inout fn checkBlanketHeadless() {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if !(cf.derived) {
                if self.moduleOf(offset: cf.typeStart) == 0U64 {
                    if self.isBlanketConform(cf: cf) {
                        self.errorAt(offset: cf.typeStart, msg: "a blanket impl over a bare type parameter (`impl[T] T as Trait where T: Bound`) is not allowed: the subject must be a concrete type or a trait. To make every conformer of one trait conform to another, use `impl B as A` (subject = the trait, spec/09)")
                    }
                }
            }
            i += 1U64
        }
    }

    inout fn checkLangItemRedef() {
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[si]
            // extern structs ARE the canonical lang-item declarations (String/Bool/numeric
            // intrinsics in Core, defOffset 0) — skip them; only a non-extern user redef hits.
            if !(sd.isExtern) {
                if self.offsetIsLoaded(offset: sd.defOffset) {
                    if self.moduleOf(offset: sd.defOffset) == 0U64 {
                        if self.isAmbientInLang(start: sd.nameStart, len: sd.nameLen) {
                            self.errorAt(offset: sd.defOffset, msg: "cannot redefine a built-in lang-item type (this name is reserved by the language)")
                        }
                    }
                }
            }
            si += 1U64
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[ei]
            if self.offsetIsLoaded(offset: ed.defOffset) {
                if self.moduleOf(offset: ed.defOffset) == 0U64 {
                    if self.isAmbientInLang(start: ed.nameStart, len: ed.nameLen) {
                        self.errorAt(offset: ed.defOffset, msg: "cannot redefine a built-in lang-item type (this name is reserved by the language)")
                    }
                }
            }
            ei += 1U64
        }
    }

    inout fn checkDupTypeNames() {
        mut val names: Array[U64] = []
        mut val offs: Array[U64] = []
        mut val mods: Array[U64] = []
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[si]
            if self.offsetIsLoaded(offset: sd.defOffset) {
                names.append(sd.nameId)
                offs.append(sd.defOffset)
                mods.append(self.moduleOf(offset: sd.defOffset))
            }
            si += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[ei]
            if self.offsetIsLoaded(offset: ed.defOffset) {
                names.append(intern(c: inout self, start: ed.nameStart, len: ed.nameLen))
                offs.append(ed.defOffset)
                mods.append(self.moduleOf(offset: ed.defOffset))
            }
            ei += 1
        }
        mut val i: U64 = 0
        while i < names.count() {
            mut val j: U64 = i + 1U64
            while j < names.count() {
                if mods[i] == mods[j] && names[i] == names[j] {
                    self.errorAt(offset: offs[j], msg: "duplicate type name (a struct/enum with this name is already declared in this module)")
                }
                j += 1
            }
            i += 1
        }
    }

    // This declaration-only check belongs to the same closed authored frontier
    // as verifyProgram.  It must not observe implementation rows appended while
    // expression verification resolves generic call sites.
    inout fn checkDupParamLabels(sourceFuncLimit: U64) {
        mut val fi: U64 = 0
        while fi < sourceFuncLimit {
            val f: Func = self.arena.funcs[fi]
            if !(f.isExtern || f.isProvided) {
                if self.moduleOf(offset: f.nameStart) == 0U64 {
                    mut val i: U64 = 0
                    while i < f.params.count() {
                        val param: Param = self.funcParamAt(params: f.params, index: i)
                        if !(param.noLabel) {
                            mut val j: U64 = i + 1U64
                            while j < f.params.count() {
                                val other: Param = self.funcParamAt(params: f.params, index: j)
                                if !(other.noLabel) {
                                    if param.nameId == other.nameId {
                                        self.errorAt(offset: other.nameStart, msg: "duplicate parameter label (each labelled parameter must have a distinct name)")
                                    }
                                }
                                j += 1
                            }
                        }
                        i += 1
                    }
                }
            }
            fi += 1
        }
    }

    inout fn fnHasDefault(f: Func) -> Bool {
        mut val i: U64 = 0
        while i < f.params.count() {
            if self.funcParamAt(params: f.params, index: i).hasDefault {
                return true
            }
            i += 1
        }
        return false
    }

    inout fn checkDupFields(fs: Array[FieldDef], ctx: String) {
        mut val i: U64 = 0
        while i < fs.count() {
            mut val j: U64 = i + 1U64
            while j < fs.count() {
                if spansEqual(c: inout self, aStart: fs[i].nameStart, aLen: fs[i].nameLen, bStart: fs[j].nameStart, bLen: fs[j].nameLen) {
                    self.errorAt(offset: fs[j].nameStart, msg: "duplicate field name (each field in a struct body / variant payload must be distinct)")
                }
                j += 1
            }
            i += 1
        }
    }

    inout fn checkGenericArity(ref: U64, offset: U64) {
        if ref == 0U64 {
            return
        }
        if ref >= self.arena.types.count() {
            return
        }
        val t: TypeRef = self.arena.types[ref]
        if t.args.count() > 0U64 {
            // look up the head name as ANY struct/enum (not only generic ones): a 0-param
            // struct/enum used with type arguments (`struct Bar` then `Bar[I32]`) is an arity
            // error too. genericStructIndex would skip it (it filters typeParams>0), which is
            // exactly the hole that let `Foo[I32]` through for a non-generic `Foo`. Names that
            // are not registered structs/enums (type params, `fn`, the array-special head,
            // `any P`) aren't found, so they pass as before.
            val si: U64 = self.anyStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
            if si < self.arena.structs.count() {
                if t.args.count() != self.arena.structs[si].typeParams.count() {
                    self.errorAt(offset: offset, msg: "wrong number of type arguments for this generic type (spec/06)")
                }
            } else {
                val ei: U64 = self.anyEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen)
                if ei < self.arena.enums.count() {
                    if t.args.count() != self.arena.enums[ei].typeParams.count() {
                        self.errorAt(offset: offset, msg: "wrong number of type arguments for this generic type (spec/06)")
                    }
                }
            }
            mut val ai: U64 = 0
            while ai < t.args.count() {
                self.checkGenericArity(ref: t.args[ai], offset: offset)
                ai += 1
            }
        }
    }
}
