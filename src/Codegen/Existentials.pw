// Existential member availability consumes normalized semantic types.

pub impl Comp {

inout fn typeTermContainsParameter(ref: U64, parameter: U64) -> Bool {
    if parameter == 0U64 || ref >= self.arena.typeCount() { return false }
    if self.arena.typeTerms[ref].paramId == parameter { return true }
    mut val index = 0U64
    while index < self.typeTermRefChildCount(ref: ref) {
        if self.typeTermContainsParameter(ref: self.typeTermRefChildRef(ref: ref, index: index), parameter: parameter) { return true }
        index += 1U64
    }
    return false
}

inout fn existentialSelfTerm(traitIndex: U64) -> Result[U64, CompileDiagnostic] {
    if traitIndex >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "existential member has no selected trait") /> }
    val trait = self.decls.traitAt(index: traitIndex)
    if trait.selfParamId == 0U64 { return <Result.Err error=self.diagnosticAt(offset: trait.nameStart, msg: "existential trait has no lexical Self identity") /> }
    val name = self.internBytes(s: "Self")
    return <Result.Ok value=self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId paramId=trait.selfParamId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />) />
}

inout fn existentialRequirementIsDispatchable(req: Func, target: U64, traitIndex: U64) -> Result[Bool, CompileDiagnostic] {
    if req.isAssoc { return <Result.Ok value=false /> }
    val source = try self.existentialSelfTerm(traitIndex: traitIndex)
    val bound = try self.existentialRequirementBound(target: target, traitIndex: traitIndex, receiver: source, offset: req.nameStart)
    val parameter = self.decls.traitAt(index: traitIndex).selfParamId
    mut val index = 0U64
    while index < req.params.count() {
        val input = self.funcParamAt(params: req.params, index: index)
        val normalized = self.traitBoundTypeTerm(ref: input.ty, bound: bound, traitIndex: traitIndex)
        if self.typeTermContainsParameter(ref: normalized, parameter: parameter) { return <Result.Ok value=false /> }
        index += 1U64
    }
    return <Result.Ok value=true />
}

// Input Self and output conversion are checked against the same selected
// interface. Associated projections normalize before the Self dependency test.
inout fn checkExistentialRequirementCall(req: Func, target: U64, traitIndex: U64, requirement: U64, offset: U64) -> Result[(), CompileDiagnostic] {
    if !(try self.existentialRequirementIsDispatchable(req: req, target: target, traitIndex: traitIndex)) {
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "this member is not callable through `any P`: `Self` appears in a non-receiver input — two `any P` values need not share a concrete type (spec/08)") />
    }
    val source = try self.existentialSelfTerm(traitIndex: traitIndex)
    val proof = <StaticConformanceProof.TraitSelf traitIdx=traitIndex receiverRef=source traitArgs=self.existentialTraitConstraint(ref: target).key.positionalArgs />
    val evidence = <ExistentialBoxEvidence sourceRef=source targetRef=target traitIdx=traitIndex proof=proof />
    match (try self.existentialWitnessPlan(evidence: evidence, requirement: requirement, sourceReceiver: source)) {
        Optional.Some(v: _) => {}
        Optional.None => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "this member's existential result conversion is not supported") /> }
    }
    return <Result.Ok value=() />
}

inout fn anyBindingEnv(anyRef: U64, traitIdx: U64, outParams: inout Array[Bind], outArgs: inout Array[U64]) -> Bool {
    val t: TraitDef = self.decls.traitAt(index: traitIdx)
    val ar: TypeRef = self.arena.typeAt(index: anyRef)
    // positional binding refs (argLabels entry 0), in source order.
    mut val positional: Array[U64] = []
    mut val ai: U64 = 0
    while ai < ar.args.count() {
        mut val lbl: U64 = 0
        if ai < ar.argLabels.count() {
            lbl = ar.argLabels[ai]
        }
        if lbl == 0U64 {
            positional.append(ar.args[ai])
        }
        ai += 1
    }
    mut val posIdx: U64 = 0
    // type parameters: a named binding wins, else the next positional.
    mut val tpi: U64 = 0
    while tpi < t.typeParams.count() {
        val tp: Bind = self.traitBindAt(binds: t.typeParams, index: tpi)
        mut val ref: U64 = 0
        mut val found: Bool = false
        mut val bi: U64 = 0
        while bi < ar.args.count() {
            if bi < ar.argLabels.count() {
                if ar.argLabels[bi] == tp.nameId && tp.nameId != 0U64 {
                    ref = ar.args[bi]
                    found = true
                }
            }
            bi += 1
        }
        if !(found) {
            if posIdx < positional.count() {
                ref = positional[posIdx]
                posIdx += 1
                found = true
            }
        }
        if !(found) {
            return false
        }
        outParams.append(tp)
        outArgs.append(ref)
        tpi += 1
    }
    // associated types: named binding only.
    mut val asi: U64 = 0
    while asi < t.assocTypes.count() {
        val at: Bind = self.traitBindAt(binds: t.assocTypes, index: asi)
        mut val ref2: U64 = 0
        mut val found2: Bool = false
        mut val bj: U64 = 0
        while bj < ar.args.count() {
            if bj < ar.argLabels.count() {
                if ar.argLabels[bj] == at.nameId && at.nameId != 0U64 {
                    ref2 = ar.args[bj]
                    found2 = true
                }
            }
            bj += 1
        }
        if !(found2) {
            return false
        }
        outParams.append(at)
        outArgs.append(ref2)
        asi += 1
    }
    return true
}
}
