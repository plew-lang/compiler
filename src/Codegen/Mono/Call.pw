// Part of monomorphization (root: _.pw): call-site / closure-capture
// registration and instance scanning.

import ../../Ir with { ForTypeRecipe, CallArgumentSource, CallTemplateArgument, CallTemplateKind, DynamicCallTemplateTarget, StaticMemberResolution, AccessUse, SemanticAccess, SemanticAggregate, SemanticAggregateElement, SemanticMatch, SemanticMatchArm, SemanticMatchPayload, FinalAggregateResolution, FinalMatchResolution, FinalMatchArmResolution, FinalMatchPayloadResolution, FinalReturnResolution, EnumPayloadConversion, ValueConversionProof, StaticConformanceProof, WitnessMatch, WitnessBind, StaticProofNode, FrozenWitnessMatch, ConversionProofNode, FrozenEnumPayloadConversion, CallResultProjection, CallReceiverPassing, CallArgumentPassing, CallResolutionTypeArgRange, CallResolutionParameterTypeRange, CallResolutionConversionRange, CallResolutionArgumentPassingRange, RuntimeIntrinsicDeclaration, NumericIntrinsic, NumericWidth, IntegerOperation, FloatWidth, FloatOperation, BoolOperation, NumericOverflow, BufferIntrinsic }
import ../../Diag with { eprintU64 }

// Walk an expression, registering any generic free function calls it contains
// (args before self, so a nested generic call is registered before the outer one
// whose argument type may depend on it).
// Can an enclosing local of this shape be value-captured? Scalars, String,
// arrays, reference cells, and plain (non-unique, non-generic) structs can: an immutable
// `val` value-captured is observationally identical to a reference capture, and
// heap-owning captures are retained into the env (then leaked). A `unique` type
// (no copy), a generic instantiation (per-inst share machinery), an enum, or a
// function-typed capture are not supported yet.

pub impl Comp {

    // Freeze semantic evidence once before it crosses a long-lived table
    // boundary. IDs are one-based: zero remains the explicit "not present"
    // sentinel in scalar descriptor rows.
    inout fn freezeWitnessMatch(witness: WitnessMatch) -> FrozenWitnessMatch {
        val start: U64 = self.arena.staticProofWitnessBindPool.count()
        mut val i: U64 = 0U64
        while i < witness.binds.count() {
            self.arena.staticProofWitnessBindPool.append(witness.binds[i])
            i += 1U64
        }
        return <FrozenWitnessMatch conformIdx=witness.conformIdx binds=start bindCount=witness.binds.count() />
    }

    inout fn freezeStaticConformanceProof(proof: StaticConformanceProof) -> U64 {
        val id: U64 = self.arena.staticProofs.count() + 1U64
        match proof {
            StaticConformanceProof.Missing => {
                self.arena.staticProofs.append(<StaticProofNode tag=0U64 />)
            }
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                val frozen: FrozenWitnessMatch = self.freezeWitnessMatch(witness: witness)
                self.arena.staticProofs.append(<StaticProofNode tag=1U64 conformIdx=frozen.conformIdx witnessBinds=frozen.binds witnessBindCount=frozen.bindCount />)
            }
            StaticConformanceProof.AssumedBound(boundIdx: val boundIdx) => {
                self.arena.staticProofs.append(<StaticProofNode tag=2U64 boundIdx=boundIdx />)
            }
            StaticConformanceProof.AssumedTraitPath(boundIdx: val boundIdx, edges: val edges) => {
                val start: U64 = self.arena.staticProofU64Pool.count()
                mut val i: U64 = 0U64
                while i < edges.count() {
                    self.arena.staticProofU64Pool.append(edges[i])
                    i += 1U64
                }
                self.arena.staticProofs.append(<StaticProofNode tag=3U64 boundIdx=boundIdx path=start pathCount=edges.count() />)
            }
            StaticConformanceProof.AssumedSupertraitPath(boundIdx: val boundIdx, traits: val traits) => {
                val start: U64 = self.arena.staticProofU64Pool.count()
                mut val i: U64 = 0U64
                while i < traits.count() {
                    self.arena.staticProofU64Pool.append(traits[i])
                    i += 1U64
                }
                self.arena.staticProofs.append(<StaticProofNode tag=4U64 boundIdx=boundIdx path=start pathCount=traits.count() />)
            }
            StaticConformanceProof.TraitSelf(traitIdx: val traitIdx, receiverRef: val receiverRef, traitArgs: val traitArgs) => {
                val start: U64 = self.arena.staticProofU64Pool.count()
                mut val i: U64 = 0U64
                while i < traitArgs.count() {
                    self.arena.staticProofU64Pool.append(traitArgs[i])
                    i += 1U64
                }
                self.arena.staticProofs.append(<StaticProofNode tag=5U64 traitIdx=traitIdx receiverRef=receiverRef path=start pathCount=traitArgs.count() />)
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: val terminalConformIdx) => {
                val start: U64 = self.arena.staticProofWitnessPool.count()
                mut val i: U64 = 0U64
                while i < edges.count() {
                    self.arena.staticProofWitnessPool.append(self.freezeWitnessMatch(witness: edges[i]))
                    i += 1U64
                }
                self.arena.staticProofs.append(<StaticProofNode tag=6U64 path=start pathCount=edges.count() terminalConformIdx=terminalConformIdx />)
            }
        }
        return id
    }

    inout fn freezeValueConversionProof(proof: ValueConversionProof) -> U64 {
        // Freeze children first. Their recursive appends must not claim the
        // parent's ID or interleave the parent's contiguous payload range.
        mut val node: ConversionProofNode = <ConversionProofNode tag=1U64 />
        match proof {
            ValueConversionProof.Identity => { node = <ConversionProofNode tag=0U64 /> }
            ValueConversionProof.Missing => { node = <ConversionProofNode tag=1U64 /> }
            ValueConversionProof.ExistentialBox(sourceRef: val sourceRef, targetRef: val targetRef, traitIdx: val traitIdx, proof: val staticProof) => {
                node = <ConversionProofNode tag=2U64 sourceRef=sourceRef targetRef=targetRef traitIdx=traitIdx staticProof=self.freezeStaticConformanceProof(proof: staticProof) />
            }
            ValueConversionProof.ArrayRepack(sourceRef: val sourceRef, targetRef: val targetRef, element: val element) => {
                node = <ConversionProofNode tag=3U64 sourceRef=sourceRef targetRef=targetRef element=self.freezeValueConversionProof(proof: element) />
            }
            ValueConversionProof.EnumRepack(sourceRef: val sourceRef, targetRef: val targetRef, enumIdx: val enumIdx, payloads: val payloads) => {
                mut val frozen: Array[FrozenEnumPayloadConversion] = []
                mut val i: U64 = 0U64
                while i < payloads.count() {
                    val payload: EnumPayloadConversion = payloads[i]
                    frozen.append(<FrozenEnumPayloadConversion sourceRef=payload.sourceRef targetRef=payload.targetRef conversion=self.freezeValueConversionProof(proof: payload.conversion) />)
                    i += 1U64
                }
                val start: U64 = self.arena.conversionPayloadPool.count()
                i = 0U64
                while i < frozen.count() {
                    self.arena.conversionPayloadPool.append(frozen[i])
                    i += 1U64
                }
                node = <ConversionProofNode tag=4U64 sourceRef=sourceRef targetRef=targetRef enumIdx=enumIdx payloads=start payloadCount=frozen.count() />
            }
        }
        self.arena.conversionProofs.append(node)
        return self.arena.conversionProofs.count()
    }

    fn frozenWitnessMatchAt(index: U64) -> FrozenWitnessMatch {
        return self.arena.staticProofWitnessPool[index]
    }

    fn thawFrozenWitnessMatch(witness: FrozenWitnessMatch) -> WitnessMatch {
        mut val binds: Array[WitnessBind] = []
        mut val i: U64 = 0U64
        while i < witness.bindCount {
            binds.append(self.arena.staticProofWitnessBindPool[witness.binds + i])
            i += 1U64
        }
        return <WitnessMatch conformIdx=witness.conformIdx binds=binds />
    }

    // Transitional compatibility reader. It is used only while Mid's draft
    // vocabulary still carries legacy proof values; canonical tables retain
    // IDs, and Mid's canonical freeze removes this reconstruction entirely.
    fn thawStaticConformanceProof(id: U64) -> StaticConformanceProof {
        if id == 0U64 || id > self.arena.staticProofs.count() { return <StaticConformanceProof.Missing /> }
        val node: StaticProofNode = self.arena.staticProofs[id - 1U64]
        if node.tag == 0U64 { return <StaticConformanceProof.Missing /> }
        if node.tag == 1U64 {
            return <StaticConformanceProof.ConcreteWitness witness=self.thawFrozenWitnessMatch(witness: <FrozenWitnessMatch conformIdx=node.conformIdx binds=node.witnessBinds bindCount=node.witnessBindCount />) />
        }
        if node.tag == 2U64 { return <StaticConformanceProof.AssumedBound boundIdx=node.boundIdx /> }
        if node.tag == 3U64 {
            mut val edges: Array[U64] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                edges.append(self.arena.staticProofU64Pool[node.path + i])
                i += 1U64
            }
            return <StaticConformanceProof.AssumedTraitPath boundIdx=node.boundIdx edges=edges />
        }
        if node.tag == 4U64 {
            mut val traits: Array[U64] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                traits.append(self.arena.staticProofU64Pool[node.path + i])
                i += 1U64
            }
            return <StaticConformanceProof.AssumedSupertraitPath boundIdx=node.boundIdx traits=traits />
        }
        if node.tag == 5U64 {
            mut val traitArgs: Array[U64] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                traitArgs.append(self.arena.staticProofU64Pool[node.path + i])
                i += 1U64
            }
            return <StaticConformanceProof.TraitSelf traitIdx=node.traitIdx receiverRef=node.receiverRef traitArgs=traitArgs />
        }
        if node.tag == 6U64 {
            mut val edges: Array[WitnessMatch] = []
            mut val i: U64 = 0U64
            while i < node.pathCount {
                edges.append(self.thawFrozenWitnessMatch(witness: self.frozenWitnessMatchAt(index: node.path + i)))
                i += 1U64
            }
            return <StaticConformanceProof.TraitPath edges=edges terminalConformIdx=node.terminalConformIdx />
        }
        return <StaticConformanceProof.Missing />
    }

    fn thawValueConversionProof(id: U64) -> ValueConversionProof {
        if id == 0U64 || id > self.arena.conversionProofs.count() { return <ValueConversionProof.Missing /> }
        val node: ConversionProofNode = self.arena.conversionProofs[id - 1U64]
        if node.tag == 0U64 { return <ValueConversionProof.Identity /> }
        if node.tag == 1U64 { return <ValueConversionProof.Missing /> }
        if node.tag == 2U64 { return <ValueConversionProof.ExistentialBox sourceRef=node.sourceRef targetRef=node.targetRef traitIdx=node.traitIdx proof=self.thawStaticConformanceProof(id: node.staticProof) /> }
        if node.tag == 3U64 { return <ValueConversionProof.ArrayRepack sourceRef=node.sourceRef targetRef=node.targetRef element=self.thawValueConversionProof(id: node.element) /> }
        if node.tag == 4U64 {
            mut val payloads: Array[EnumPayloadConversion] = []
            mut val i: U64 = 0U64
            while i < node.payloadCount {
                val payload: FrozenEnumPayloadConversion = self.arena.conversionPayloadPool[node.payloads + i]
                payloads.append(<EnumPayloadConversion sourceRef=payload.sourceRef targetRef=payload.targetRef conversion=self.thawValueConversionProof(id: payload.conversion) />)
                i += 1U64
            }
            return <ValueConversionProof.EnumRepack sourceRef=node.sourceRef targetRef=node.targetRef enumIdx=node.enumIdx payloads=payloads />
        }
        return <ValueConversionProof.Missing />
    }

    fn conversionProofIsIdentity(id: U64) -> Bool {
        return id != 0U64 && id <= self.arena.conversionProofs.count() && self.arena.conversionProofs[id - 1U64].tag == 0U64
    }

    fn conversionProofIsMissing(id: U64) -> Bool {
        return id == 0U64 || id > self.arena.conversionProofs.count() || self.arena.conversionProofs[id - 1U64].tag == 1U64
    }

    // Resolve a deferred semantic type source under the active BodyInstance.
    // The result is always an ordinary ground TypeTerm; recipes never cross
    // the frontend/backend freeze boundary.
    inout fn groundSemanticTypeRecipe(recipeId: U64) -> U64 {
        if recipeId == 0U64 || recipeId > self.arena.semanticTypeRecipes.count() { return 0U64 }
        val recipe: SemanticTypeRecipe = self.arena.semanticTypeRecipes[recipeId - 1U64]
        if recipe.kind == 1U64 {
            return self.groundTermForBody(ref: recipe.term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        }
        if recipe.kind == 2U64 {
            if recipe.siteIsStmt {
                return self.bodyCalleeResultRef(exprId: recipe.exprId, siteIsStmt: true, slot: recipe.callSite.slot)
            }
            return self.bodyCalleeResultForTemplateDependency(exprId: recipe.exprId, siteKey: recipe.callSite)
        }
        if recipe.kind == 3U64 {
            val receiver: U64 = self.groundSemanticTypeRecipe(recipeId: recipe.input)
            mut val args: Array[U64] = []
            mut val i: U64 = 0U64
            while i < recipe.traitArgs.count() {
                args.append(self.groundTermForBody(ref: recipe.traitArgs[i], environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef))
                i += 1U64
            }
            return self.assocBindingFor(baseRef: receiver, traitId: recipe.traitId, traitOwner: recipe.traitOwner, traitArgs: args, assocId: recipe.assocId)
        }
        if recipe.kind == 4U64 {
            val optional: U64 = self.groundSemanticTypeRecipe(recipeId: recipe.input)
            if optional == 0U64 || optional >= self.arena.types.count() { return 0U64 }
            val t: TypeRef = self.arena.types[optional]
            if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Optional") && t.args.count() == 1U64 {
                return t.args[0]
            }
            return 0U64
        }
        return 0U64
    }

    // Record owns one immutable source recipe for every non-range `for`.
    // This lookup is deliberately keyed by the statement navigation id, while
    // a nested CallResult recipe retains its own CallSiteKey identity.
    inout fn forItemTypeRecipe(stmtId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.forTypeRecipes.count() {
            val recipe: ForTypeRecipe = self.decls.forTypeRecipes[i]
            if recipe.stmtId == stmtId { return recipe.itemRecipe }
            i += 1U64
        }
        return 0U64
    }
    // CallResolution keys share one U64 namespace for ordinary Func bodies and
    // closure bodies.  Arena expression ids occupy the low range, so reserve
    // the high bit for a closure body.  This lets a closure's static calls be
    // finalized and emitted under its own lexical environment instead of
    // accidentally inheriting the surrounding function's table entries.
    inout fn closureBodyKey(closureId: U64) -> U64 {
        return 9223372036854775808U64 + closureId
    }

    // TypeRef indices are arena allocation identities, not semantic identities:
    // a plain `I64` can be reconstructed in more than one frontend phase.
    // A body is additionally selected by its Func identity, so a caller view is
    // not another receiver identity here: the selected Func already carries its
    // extension/trait provenance.  Body-instance keys compare the structural
    // runtime receiver (head plus arguments) and deliberately erase views.
    inout fn sameBodyRuntimeRef(a: U64, b: U64) -> Bool {
        if a == b { return true }
        if a >= self.arena.types.count() || b >= self.arena.types.count() { return false }
        val left: TypeRef = self.arena.types[a]
        val right: TypeRef = self.arena.types[b]
        // Source facets (view, capability, associated-type spelling) are
        // resolved before this point.  The emitted receiver representation is
        // determined solely by its runtime head/arguments and existential bit.
        // A few bootstrap-era TypeRef construction paths predate nameId and
        // legitimately carry 0.  Interned ids are a fast path, not part of the
        // runtime type contract; fall back to the head spelling for those
        // legacy nodes rather than splitting one emitted body in two.
        // A zero nameId is an absent cache entry, not an identifier.  Comparing
        // two such legacy refs as equal merged unrelated runtime receivers
        // (for example Counter and Two) in final-callable/body keys.  Use ids
        // only when BOTH exist; otherwise compare the authoritative spelling.
        if left.nameId == 0U64 || right.nameId == 0U64 {
            if !(spansEqual(c: inout self, aStart: left.nameStart, aLen: left.nameLen, bStart: right.nameStart, bLen: right.nameLen)) {
                return false
            }
        } else if left.nameId != right.nameId {
            return false
        }
        if left.isAny != right.isAny || left.args.count() != right.args.count() {
            return false
        }
        mut val i: U64 = 0U64
        while i < left.args.count() {
            if !(self.sameBodyRuntimeRef(a: left.args[i], b: right.args[i])) { return false }
            i += 1U64
        }
        return true
    }

    inout fn sameBodyReceiver(a: U64, b: U64) -> Bool {
        if a == 0U64 || b == 0U64 { return a == b }
        return self.sameBodyRuntimeRef(a: a, b: b)
    }

    // Canonical semantic receiver for a body instance.  `BodyInstance` is the
    // hand-off boundary between finalization and LLVM: both sides ask this one
    // helper for the key, never reconstruct it from incidental `self` state.
    //
    // A caller's view chooses *which Func* reaches this point, but is not by
    // itself part of that Func body's identity.  For example `String#Hash.hash`
    // selects String's Hash implementation; its body still has the ordinary
    // String receiver surface unless the Func explicitly carries a source view.
    // Retaining the caller's view made Mono record `String#Hash` while backend
    // emitted the same Func for `String`, producing two keys for one body.
    // Normalize to the runtime receiver first, then reapply only the selected
    // Func's own extension/trait surface below.
    inout fn canonicalBodyReceiverRef(fnIdx: U64, recvInstRef: U64) -> U64 {
        if fnIdx >= self.arena.funcs.count() { return recvInstRef }
        val f: Func = self.arena.funcs[fnIdx]
        mut val out: U64 = recvInstRef
        if out == 0U64 && (f.hasRecv || f.isAssoc) {
            out = self.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
        }
        if out == 0U64 || out >= self.arena.types.count() { return out }
        val base: TypeRef = self.arena.types[out]
        if base.viewExtId != 0U64 || base.viewIds.count() != 0U64 {
            val noViews: Array[U64] = []
            out = self.typeRefWithViews(ref: out, viewExtId: 0U64, viewIds: noViews)
        }
        if f.extId != 0U64 {
            val selectedView: Array[U64] = [f.extId]
            out = self.typeRefWithViews(ref: out, viewExtId: f.extId, viewIds: selectedView)
        }
        return out
    }

    // Recover an expression's concrete receiver TypeRef under the body instance
    // being scanned.  The parametric table normally supplies this directly.  A
    // plain scalar type parameter is deliberately representation-free in a few
    // older AST paths, so rebuild its named TypeRef before applying the same
    // body substitution.  This remains frontend resolution; backend never uses
    // this recovery.
    inout fn groundedBodyReceiverRef(exprId: U64) -> U64 {
        mut val out: U64 = 0U64
        // A nested call's concrete result is already part of its final
        // descriptor.  Consult it before the AST-wide type projection: that
        // projection is deliberately parametric and can lose a cast/view's
        // concrete surface, whereas the descriptor is the exact receiver for
        // the enclosing method (`(back as UserId).bytes().count()`).
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                out = self.bodyCalleeResultRef(exprId: exprId)
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                out = self.bodyCalleeResultRef(exprId: exprId)
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                out = self.bodyCalleeResultRef(exprId: exprId)
            }
            _ => {}
        }
        if out != 0U64 { return out }
        // Locals retain their declared structured type even when the generic
        // type-recovery projection exposes an Array through its element view.
        // Prefer that declaration for source selection.
        match self.arena.exprs[exprId] {
            Expr.Ident(val start, val len) => {
                if self.cur.hasRecv {
                    val selfName: Bind = self.kwSpan(kw: "self", kwLen: 4U64)
                    if spansEqual(c: inout self, aStart: start, aLen: len, bStart: selfName.nameStart, bLen: selfName.nameLen) {
                        // The body-instance receiver is the semantic identity
                        // that selected this callable.  Prefer it over the
                        // mutable Self/Item convenience environment: provided
                        // trait bodies are shared, and that ambient environment
                        // may still describe another conformer after a nested
                        // resolution query.
                        if self.cur.bodyEnvironment.receiverRef != 0U64 { return self.cur.bodyEnvironment.receiverRef }
                        if self.cur.bodySelfRef != 0U64 { return self.cur.bodySelfRef }
                    }
                }
                val li: U64 = self.localIndexByName(start: start, len: len)
                if li < self.cur.locals.count() {
                    val lo: Local = self.cur.locals[li]
                    out = lo.ty
                    if lo.isArray {
                        if out == 0U64 || out >= self.arena.types.count() || !(rangeEquals(bytes: self.arena.bytes, start: self.arena.types[out].nameStart, len: self.arena.types[out].nameLen, kw: "Array")) {
                            val elem: U64 = out
                            if elem != 0U64 { out = self.arrayRefOfElem(elemRef: elem) }
                        }
                    }
                    // A free generic parameter can have no standalone `ty`
                    // ref in an older lowered body, but its declaration span
                    // still identifies the binder. Consult the body-instance
                    // substitution before relying on that optional cache.
                    if !lo.isArray {
                        mut val binderI: U64 = 0U64
                        while binderI < self.cur.bodyEnvironment.params.count() {
                            if spansEqual(c: inout self, aStart: lo.tyStart, aLen: lo.tyLen, bStart: self.cur.bodyEnvironment.params[binderI].nameStart, bLen: self.cur.bodyEnvironment.params[binderI].nameLen) {
                                if binderI < self.cur.bodyEnvironment.args.count() && self.cur.bodyEnvironment.args[binderI] != 0U64 {
                                    return self.cur.bodyEnvironment.args[binderI]
                                }
                            }
                            binderI += 1U64
                        }
                    }
                    if out != 0U64 {
                        // A free generic parameter is represented by the
                        // parameter's bare TypeRef in the shared body.  Its
                        // body-instance argument is the semantic identity,
                        // including a `#Trait` / extension view; return that
                        // entry directly rather than reconstructing through a
                        // cache that may retain only the unviewed head.
                        val savedP: Array[Bind] = self.cur.typeParams
                        val savedA: Array[U64] = self.cur.typeArgs
                        val savedS: U64 = self.cur.selfRef
                        val savedI: U64 = self.cur.itemRef
                        val savedR: U64 = self.cur.recvInstRef
                        self.cur.typeParams = self.cur.bodyEnvironment.params
                        self.cur.typeArgs = self.cur.bodyEnvironment.args
                        self.cur.selfRef = self.cur.bodySelfRef
                        self.cur.itemRef = self.cur.bodyItemRef
                        self.cur.recvInstRef = self.cur.bodyEnvironment.receiverRef
                        out = self.groundBodyTerm(ref: out)
                        self.cur.typeParams = savedP
                        self.cur.typeArgs = savedA
                        self.cur.selfRef = savedS
                        self.cur.itemRef = savedI
                        self.cur.recvInstRef = savedR
                        return out
                    }
                }
            }
            _ => {}
        }
        // The final body instance is also usable before a caller has rebuilt
        // the lexical-local table (some layout/discovery walks intentionally
        // do not).  Recover a parameter `x: T` directly from the owning
        // function's declaration in that case.  This is not a second type
        // inference path: it reads the same body-instance substitution used
        // for locals above, including its view facets.
        match self.arena.exprs[exprId] {
            Expr.Ident(start: val identStart, len: val identLen) => {
                if self.cur.bodyFnIdx < self.arena.funcs.count() {
                    val owner: Func = self.arena.funcs[self.cur.bodyFnIdx]
                    mut val pi: U64 = 0U64
                    while pi < owner.params.count() {
                        val param: Param = self.funcParamAt(params: owner.params, index: pi)
                        if spansEqual(c: inout self, aStart: identStart, aLen: identLen, bStart: param.nameStart, bLen: param.nameLen) {
                            mut val ti: U64 = 0U64
                            while ti < self.cur.bodyEnvironment.params.count() {
                                if spansEqual(c: inout self, aStart: param.tyStart, aLen: param.tyLen, bStart: self.cur.bodyEnvironment.params[ti].nameStart, bLen: self.cur.bodyEnvironment.params[ti].nameLen) {
                                    if ti < self.cur.bodyEnvironment.args.count() && self.cur.bodyEnvironment.args[ti] != 0U64 {
                                        if param.tyIsArray {
                                            return self.arrayRefOfElem(elemRef: self.cur.bodyEnvironment.args[ti])
                                        }
                                        return self.cur.bodyEnvironment.args[ti]
                                    }
                                }
                                ti += 1U64
                            }
                        }
                        pi += 1U64
                    }
                }
            }
            _ => {}
        }
        // TypeInfo's legacy array projection is just its element type.  It is
        // useful for scalar typing, but not for a method receiver: an
        // `Array[U8]` local must retain the full instance identity selected at
        // the call site.  Ident locals above therefore win; non-local
        // expressions can use the ordinary typed-IR recovery.
        out = self.groundedTypeOf(id: exprId)
        if out != 0U64 {
            return out
        }
        val ti: TypeInfo = self.typeOf(id: exprId)
        if ti.nameLen == 0U64 {
            return 0U64
        }
        // Preserve a structured recovery such as Array[E] before falling back
        // to a bare head.  Rebuilding only `E` here was enough to make an
        // Array method's final Func known while losing the receiver instance
        // required to emit that very Func.
        out = self.typedIrRefOfInfo(ti: ti)
        if out == 0U64 {
            out = self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
        }
        if out == 0U64 {
            return 0U64
        }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        val savedS: U64 = self.cur.selfRef
        val savedI: U64 = self.cur.itemRef
        self.cur.typeParams = self.cur.bodyEnvironment.params
        self.cur.typeArgs = self.cur.bodyEnvironment.args
        self.cur.selfRef = self.cur.bodySelfRef
        self.cur.itemRef = self.cur.bodyItemRef
        out = self.groundBodyTerm(ref: out)
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        self.cur.selfRef = savedS
        self.cur.itemRef = savedI
        return out
    }

    // Adapt this BodyInstance's receiver to the frontend semantic call query.
    // `resolveMethodFinal(recv: ...)` is syntax-facing and starts from
    // `typeOf(recv)`; a shared generic body's node still spells `T`, so Mono
    // contributes only its grounded receiver term. Candidate selection itself
    // is owned by `resolveMethodForResolvedReceiver` in the frontend resolver.
    inout fn resolveBodyMethodForRef(recv: U64, recvRef: U64, sourceId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: ArgRange, useOffset: U64) -> U64 {
        // The receiver argument is normally `groundedBodyReceiverRef(recv)`,
        // but callers that arrived through an older TypeInfo recovery can hand
        // us its bare runtime head.  The body-local ref is authoritative: it
        // retains the caller's selected view (`S#P`) as part of the generic
        // substitution, whereas the head does not.  Normalize once at the
        // final resolver boundary so every Mono caller shares the same surface.
        mut val surfaceRef: U64 = recvRef
        // The explicit trailing `#Source` of an ExtMethod is semantic
        // provenance for *all* downstream queries, including the proof query
        // used by provided copies. `collectViewSources` used to receive it as
        // a side argument while `callableReceiverMatches` received bare S,
        // making an E-owned B -> A edge disappear between candidate selection
        // and receiver applicability. The TypeRef view is the current
        // migration carrier for this normalized source-set facet.
        if sourceId != 0U64 && surfaceRef != 0U64 {
            val additions: Array[ResolvedViewSource] = [<ResolvedViewSource surfaceId=sourceId traitOwner=sourceOwner />]
            surfaceRef = self.typeRefWithAddedViewSources(ref: surfaceRef, additions: additions)
        }
        val bodyRef: U64 = self.groundedBodyReceiverRef(exprId: recv)
        if bodyRef != 0U64 && bodyRef < self.arena.types.count() {
            val bodyTy: TypeRef = self.arena.types[bodyRef]
            if bodyTy.viewExtId != 0U64 || bodyTy.viewIds.count() != 0U64 {
                surfaceRef = bodyRef
            }
        }
        return self.resolveMethodForResolvedReceiver(recv: recv, surfaceRef: surfaceRef, sourceId: sourceId, sourceOwner: sourceOwner, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: useOffset)
    }

    // Control-flow protocol calls have no receiver expression at finalization:
    // their receiver is already a grounded CallTemplate term.  Do not feed a
    // statement's iterable AST back into view collection; all source facets
    // must have travelled with that term from Record.
    inout fn resolveProtocolMethodForReceiver(recvRef: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> U64 {
        return self.resolveMethodForResolvedReceiver(recv: 0U64, surfaceRef: recvRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: 0U64, readReceiverSyntax: false)
    }

    // The only reader for an implicit protocol receiver. Slot 1 owns either a
    // parametric source term or a prior written-call result; slot 2 explicitly
    // depends on slot 1's completed CallResolution. No fallback is permitted:
    // recovering `Stmt.For.iter` here would create a second semantic source.
    inout fn groundedProtocolTemplateReceiver(stmtId: U64, slot: U64) -> U64 {
        val key: CallSiteKey = self.currentCallSiteKey(exprId: stmtId, siteIsStmt: true, slot: slot)
        val index: U64 = self.callTemplateIndex(siteKey: key)
        if index >= self.decls.callTemplates.count() {
            self.errorAt(offset: 0U64, msg: "internal error: implicit protocol CallTemplate was not recorded")
            return 0U64
        }
        match self.decls.callTemplates[index].kind {
            CallTemplateKind.Protocol(val receiver) => {
                match receiver {
                    CallTemplateReceiver.Term(val term) => {
                        return self.groundTermForBody(ref: term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                    }
                    CallTemplateReceiver.PriorCallResult(exprId: val exprId, siteKey: val dependency) => {
                        return self.bodyCalleeResultForTemplateDependency(exprId: exprId, siteKey: dependency)
                    }
                    CallTemplateReceiver.PriorProtocolResult(slot: val priorSlot) => {
                        val result: U64 = self.bodyCalleeResultRef(exprId: stmtId, siteIsStmt: true, slot: priorSlot)
                        if result == 0U64 {
                            self.errorAt(offset: 0U64, msg: "internal error: implicit protocol dependency was not finalized")
                        }
                        return result
                    }
                    CallTemplateReceiver.PriorCallResultWithViews(exprId: val exprId, siteKey: val dependency, views: val views) => {
                        return self.typeRefWithAddedViewSources(ref: self.bodyCalleeResultForTemplateDependency(exprId: exprId, siteKey: dependency), additions: views)
                    }
                    CallTemplateReceiver.PriorProtocolResultWithViews(slot: val priorSlot, views: val views) => {
                        val result: U64 = self.bodyCalleeResultRef(exprId: stmtId, siteIsStmt: true, slot: priorSlot)
                        if result == 0U64 {
                            self.errorAt(offset: 0U64, msg: "internal error: implicit viewed protocol dependency was not finalized")
                        }
                        return self.typeRefWithAddedViewSources(ref: result, additions: views)
                    }
                    CallTemplateReceiver.None => {
                        self.errorAt(offset: 0U64, msg: "internal error: implicit protocol CallTemplate has no receiver")
                    }
                    CallTemplateReceiver.Opaque => {
                        self.errorAt(offset: 0U64, msg: "internal error: implicit protocol CallTemplate has no semantic receiver")
                    }
                }
            }
            _ => { self.errorAt(offset: 0U64, msg: "internal error: implicit protocol CallTemplate has the wrong site kind") }
        }
        return 0U64
    }

    // Direct and protocol calls use the same receiver source algebra. Keeping
    // this reader independent of syntax is what lets a method receiver be the
    // completed result of an earlier call in a shared generic body.
    inout fn groundCallTemplateReceiver(receiver: CallTemplateReceiver) -> U64 {
        match receiver {
            CallTemplateReceiver.None => { return 0U64 }
            CallTemplateReceiver.Opaque => { return 0U64 }
            CallTemplateReceiver.Term(val term) => {
                return self.groundTermForBody(ref: term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
            }
            CallTemplateReceiver.PriorCallResult(exprId: val exprId, siteKey: val siteKey) => {
                return self.bodyCalleeResultForTemplateDependency(exprId: exprId, siteKey: siteKey)
            }
            CallTemplateReceiver.PriorProtocolResult(slot: val slot) => {
                return self.bodyCalleeResultRef(exprId: self.cur.bodyFnIdx, siteIsStmt: true, slot: slot)
            }
            CallTemplateReceiver.PriorCallResultWithViews(exprId: val exprId, siteKey: val siteKey, views: val views) => {
                val base: U64 = self.bodyCalleeResultForTemplateDependency(exprId: exprId, siteKey: siteKey)
                return self.typeRefWithAddedViewSources(ref: base, additions: views)
            }
            CallTemplateReceiver.PriorProtocolResultWithViews(slot: val slot, views: val views) => {
                val base: U64 = self.bodyCalleeResultRef(exprId: self.cur.bodyFnIdx, siteIsStmt: true, slot: slot)
                return self.typeRefWithAddedViewSources(ref: base, additions: views)
            }
        }
    }

    // Resolve a receiver dependency only through the immutable descriptor
    // already published for this BodyInstance. `exprId` is not a semantic key:
    // the stored CallSiteKey guards against accidentally reading a different
    // shared generic body occurrence with the same arena navigation anchor.
    inout fn bodyCalleeResultForTemplateDependency(exprId: U64, siteKey: CallSiteKey) -> U64 {
        val bodyId: U64 = self.currentBodyInstanceId()
        mut val i: U64 = 0U64
        while i < self.arena.finalCallees.count() {
            val entry: CallResolution = self.arena.finalCallees[i]
            if entry.bodyId == bodyId && entry.exprId == exprId && self.sameCallSiteKey(a: entry.siteKey, b: siteKey) {
                return entry.resultTypeRef
            }
            i += 1U64
        }
        self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: implicit protocol call dependency was not finalized")
        return 0U64
    }

    // Instance collection discovers layouts before Record has produced the
    // declaration-time template table.  Its selection is provisional: it is
    // discarded before backend emission and may only enqueue reachable bodies.
    // Once Record has supplied this site, finalization must take the template
    // route above and may not recover the receiver from `Stmt.For.iter`.
    inout fn hasProtocolCallTemplate(stmtId: U64, slot: U64) -> Bool {
        val key: CallSiteKey = self.currentCallSiteKey(exprId: stmtId, siteIsStmt: true, slot: slot)
        return self.callTemplateIndex(siteKey: key) < self.decls.callTemplates.count()
    }

    // Ground a selected method's result under the same concrete receiver that
    // selected it.  Control-flow desugars such as `for` have no explicit AST
    // Method node for their iterator result, so this keeps that intermediate
    // type recovery in Mono instead of asking LLVM to rediscover it.
    inout fn groundedCalleeReturn(callee: U64, recvRef: U64) -> U64 {
        if callee >= self.arena.funcs.count() { return 0U64 }
        val f: Func = self.arena.funcs[callee]
        val noMethodArgs: Array[U64] = []
        val environment: InstanceEnvironment = self.bodyInstanceEnvironment(fnIdx: callee, args: noMethodArgs, recvInstRef: recvRef)
        return self.groundTermForBody(ref: f.retTy, environment: environment, selfRef: environment.receiverRef, itemRef: self.bodyProvidedItemTerm(f: f, environment: environment))
    }

    // The final descriptor carries the *complete* callable substitution
    // vector, including method-owned arguments.  Use it for every result
    // projection so later backend consumers never have to ground a declaration
    // under their own incidental environment.
    inout fn groundedSelectedCalleeReturn(callee: U64, recvRef: U64, calleeArgs: Array[U64]) -> U64 {
        if callee >= self.arena.funcs.count() { return 0U64 }
        val f: Func = self.arena.funcs[callee]
        if !(f.hasRet) { return 0U64 }
        if f.retTy == 0U64 {
            if f.retStart != 0U64 && f.retLen != 0U64 && !(f.retIsArray) {
                return self.simpleTypeRef(nameStart: f.retStart, nameLen: f.retLen)
            }
            return 0U64
        }
        val environment: InstanceEnvironment = self.bodyInstanceEnvironment(fnIdx: callee, args: calleeArgs, recvInstRef: recvRef)
        return self.groundTermForBody(ref: f.retTy, environment: environment, selfRef: environment.receiverRef, itemRef: self.bodyProvidedItemTerm(f: f, environment: environment))
    }

    // Parameter ABI types belong to the same completed call decision as its
    // result.  In particular, a generic free call `first[I64](value: Box[I64])`
    // must hand LLVM `Box[I64]`, not the declaration's symbolic `Box[T]`.
    inout fn groundedSelectedCalleeParameterTypes(callee: U64, recvRef: U64, calleeArgs: Array[U64]) -> Array[U64] {
        mut val out: Array[U64] = []
        if callee >= self.arena.funcs.count() { return out }
        val f: Func = self.arena.funcs[callee]
        val environment: InstanceEnvironment = self.bodyInstanceEnvironment(fnIdx: callee, args: calleeArgs, recvInstRef: recvRef)
        val itemRef: U64 = self.bodyProvidedItemTerm(f: f, environment: environment)
        mut val i: U64 = 0U64
        while i < f.params.count() {
            val param: Param = self.funcParamAt(params: f.params, index: i)
            if param.ty != 0U64 {
                out.append(self.groundTermForBody(ref: param.ty, environment: environment, selfRef: environment.receiverRef, itemRef: itemRef))
            } else {
                out.append(0U64)
            }
            i += 1U64
        }
        return out
    }

    // Construct the only semantic environment for a concrete callable body.
    // Function/impl binders arrive through `args`; nominal declaration binders
    // are recovered from the selected receiver. Their ParamIds are distinct,
    // including the common `struct Array[T]` / `impl[T] Array[T]` spelling.
    // Every body key and body-entry uses this constructor rather than carrying
    // parallel args/receiver projections.
    // The provided copy itself records which conformance created it. Preserve
    // that fact in the body environment: matching by the receiver again would
    // conflate same-head parameterized or view-selected witnesses.
    inout fn providedBodyProof(f: Func, receiverRef: U64) -> StaticConformanceProof {
        if !(f.isProvided) || f.originConformIdx == 0U64 || receiverRef == 0U64 { return <StaticConformanceProof.Missing /> }
        val ci: U64 = f.originConformIdx - 1U64
        if ci >= self.decls.conforms.count() { return <StaticConformanceProof.Missing /> }
        val cf: Conform = self.decls.conforms[ci]
        // A copy can be placed through a concrete edge while its shared body
        // originates in a distinct trait-subject edge:
        //
        //   P as Greet     (placement)
        //   Greet as Show  (source)
        //
        // The body is meaningful only under the complete P -> Greet -> Show
        // proof. `originConformIdx` identifies the placement, while
        // `sourceConformIdx` identifies the source impl's binders and target.
        // Do not validate the placement against `originTrait`: they differ in
        // exactly this legitimate two-edge case.
        if f.sourceConformIdx != 0U64 {
            val sourceIdx: U64 = f.sourceConformIdx - 1U64
            if sourceIdx >= self.decls.conforms.count() { return <StaticConformanceProof.Missing /> }
            val source: Conform = self.decls.conforms[sourceIdx]
            if source.traitId != f.originTraitId || source.traitStart != f.originTraitOwner { return <StaticConformanceProof.Missing /> }
            mut val proofReceiver: U64 = receiverRef
            if source.extId != 0U64 {
                val sources: Array[ResolvedViewSource] = [<ResolvedViewSource surfaceId=source.extId />]
                proofReceiver = self.typeRefWithAddedViewSources(ref: proofReceiver, additions: sources)
            }
            return self.concreteConformanceProof(baseRef: proofReceiver, traitId: source.traitId, traitOwner: source.traitStart, traitArgs: self.copyConformTypes(types: source.traitArgs))
        }
        // `originConformIdx` pins the placement edge that created this copy.
        // Its target must be the callable's origin trait. `srcTrait*` is the
        // source witness/binder owner and is deliberately not used to infer
        // the edge subject: a provided `impl A { fn double }` copied through
        // `impl B as A` has source trait A but placement subject B.
        val placementIsTraitSubject: Bool = self.isTraitName(start: cf.typeStart, len: cf.typeLen)
        if cf.traitId != f.originTraitId || cf.traitStart != f.originTraitOwner { return <StaticConformanceProof.Missing /> }
        // A direct implementation owns its output through its own witness;
        // keep that precise substitution rather than rediscovering a wider
        // path. Only a trait-subject origin (`impl B as A`) needs closure
        // traversal because the concrete receiver may reach A via S:B.
        if !placementIsTraitSubject {
            val witness: WitnessMatch = self.conformanceWitnessMatch(conformIdx: ci, typeRef: receiverRef, traitArgs: [], traitArgsOpen: true)
            if witness.conformIdx == 0U64 { return <StaticConformanceProof.Missing /> }
            return <StaticConformanceProof.ConcreteWitness witness=witness />
        }
        // The body key intentionally normalizes a caller's view away when it
        // denotes the same executable Func.  Proof construction must still
        // receive that Func's selected extension facet: `f.extId` is
        // declaration identity, not syntax to rediscover.  Without it, an
        // `extension E { impl B as A }` copy can no longer reify the concrete
        // `S#E: A` path required by its shared body.
        mut val proofReceiver: U64 = receiverRef
        if f.extId != 0U64 {
            val sources: Array[ResolvedViewSource] = [<ResolvedViewSource surfaceId=f.extId />]
            proofReceiver = self.typeRefWithAddedViewSources(ref: proofReceiver, additions: sources)
        }
        return self.concreteConformanceProof(baseRef: proofReceiver, traitId: cf.traitId, traitOwner: cf.traitStart, traitArgs: self.copyConformTypes(types: cf.traitArgs))
    }

    inout fn proofIsMissing(proof: StaticConformanceProof) -> Bool {
        match proof { StaticConformanceProof.Missing => { return true } _ => {} }
        return false
    }

    inout fn sameWitnessMatch(a: WitnessMatch, b: WitnessMatch) -> Bool {
        if a.conformIdx != b.conformIdx || a.binds.count() != b.binds.count() { return false }
        mut val i: U64 = 0U64
        while i < a.binds.count() {
            val left: WitnessBind = a.binds[i]
            val right: WitnessBind = b.binds[i]
            if left.binder != right.binder || left.paramId != right.paramId || !(self.typeRefEq(a: left.term, b: right.term)) { return false }
            i += 1U64
        }
        return true
    }

    inout fn sameProofTerms(a: Array[U64], b: Array[U64]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            if !(self.typeRefEq(a: a[i], b: b[i])) { return false }
            i += 1U64
        }
        return true
    }

    // Proof is semantic body input: two copies of the same executable method
    // with different conformance paths can resolve `Self` projections and
    // nested requirements differently.  ABI receiver equality alone is not a
    // valid BodyInstance identity.
    inout fn sameStaticConformanceProof(a: StaticConformanceProof, b: StaticConformanceProof) -> Bool {
        match a {
            StaticConformanceProof.Missing => { match b { StaticConformanceProof.Missing => { return true } _ => {} } }
            StaticConformanceProof.ConcreteWitness(witness: val left) => { match b { StaticConformanceProof.ConcreteWitness(witness: val right) => { return self.sameWitnessMatch(a: left, b: right) } _ => {} } }
            StaticConformanceProof.AssumedBound(boundIdx: val left) => { match b { StaticConformanceProof.AssumedBound(boundIdx: val right) => { return left == right } _ => {} } }
            StaticConformanceProof.AssumedTraitPath(boundIdx: val leftBound, edges: val leftEdges) => {
                match b {
                    StaticConformanceProof.AssumedTraitPath(boundIdx: val rightBound, edges: val rightEdges) => {
                        if leftBound != rightBound || leftEdges.count() != rightEdges.count() { return false }
                        mut val i: U64 = 0U64
                        while i < leftEdges.count() { if leftEdges[i] != rightEdges[i] { return false } i += 1U64 }
                        return true
                    }
                    _ => {}
                }
            }
            StaticConformanceProof.AssumedSupertraitPath(boundIdx: val leftBound, traits: val leftTraits) => {
                match b {
                    StaticConformanceProof.AssumedSupertraitPath(boundIdx: val rightBound, traits: val rightTraits) => {
                        if leftBound != rightBound || leftTraits.count() != rightTraits.count() { return false }
                        mut val i: U64 = 0U64
                        while i < leftTraits.count() { if leftTraits[i] != rightTraits[i] { return false } i += 1U64 }
                        return true
                    }
                    _ => {}
                }
            }
            StaticConformanceProof.TraitSelf(traitIdx: val leftTrait, receiverRef: val leftReceiver, traitArgs: val leftArgs) => {
                match b { StaticConformanceProof.TraitSelf(traitIdx: val rightTrait, receiverRef: val rightReceiver, traitArgs: val rightArgs) => { return leftTrait == rightTrait && self.typeRefEq(a: leftReceiver, b: rightReceiver) && self.sameProofTerms(a: leftArgs, b: rightArgs) } _ => {} }
            }
            StaticConformanceProof.TraitPath(edges: val leftEdges, terminalConformIdx: val leftTerminal) => {
                match b {
                    StaticConformanceProof.TraitPath(edges: val rightEdges, terminalConformIdx: val rightTerminal) => {
                        if leftTerminal != rightTerminal || leftEdges.count() != rightEdges.count() { return false }
                        mut val i: U64 = 0U64
                        while i < leftEdges.count() { if !(self.sameWitnessMatch(a: leftEdges[i], b: rightEdges[i])) { return false } i += 1U64 }
                        return true
                    }
                    _ => {}
                }
            }
        }
        return false
    }

    // A CallTemplate proof has become concrete at its selected receiver.  The
    // resulting evidence is part of a provided body's semantic environment,
    // not an implementation detail that may be reconstructed from its ABI
    // receiver after view normalization.
    inout fn concreteStaticMemberProof(proof: StaticConformanceProof, traitIdx: U64, receiverRef: U64) -> StaticConformanceProof {
        match proof {
            StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: _, traitArgs: _) => { return self.cur.bodyEnvironment.proof }
            _ => {}
        }
        if traitIdx >= self.decls.traits.count() { return <StaticConformanceProof.Missing /> }
        val traitDef: TraitDef = self.decls.traits[traitIdx]
        return self.concreteConformanceProof(baseRef: receiverRef, traitId: traitDef.nameId, traitOwner: traitDef.nameStart, traitArgs: [])
    }

    inout fn bodyInstanceEnvironment(fnIdx: U64, args: Array[U64], recvInstRef: U64, selectedProof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> InstanceEnvironment {
        mut val params: Array[Bind] = []
        mut val values: Array[U64] = []
        val canonicalRecv: U64 = self.canonicalBodyReceiverRef(fnIdx: fnIdx, recvInstRef: recvInstRef)
        mut val proof: StaticConformanceProof = <StaticConformanceProof.Missing />
        if fnIdx < self.arena.funcs.count() {
            val f: Func = self.lexicalFunction(f: self.arena.funcs[fnIdx])
            // A copied provided body still contains the source trait's
            // lexical `Self` ParamId.  Bind it here with the concrete
            // conformer, alongside ordinary method/receiver binders.
            if f.isProvided && f.provTraitOwner != 0U64 {
                mut val ti: U64 = 0U64
                while ti < self.decls.traits.count() {
                    val traitDef: TraitDef = self.decls.traits[ti]
                    if traitDef.nameStart == f.provTraitOwner && traitDef.selfParamId != 0U64 {
                        val selfName: Bind = self.kwSpan(kw: "Self", kwLen: 4U64)
                        params.append(<Bind nameStart=selfName.nameStart nameLen=selfName.nameLen nameId=intern(c: inout self, start: selfName.nameStart, len: selfName.nameLen) paramId=traitDef.selfParamId fieldStart=selfName.fieldStart fieldLen=selfName.fieldLen />)
                        values.append(canonicalRecv)
                        break
                    }
                    ti += 1U64
                }
            }
            mut val i: U64 = 0U64
            while i < f.typeParams.count() && i < args.count() {
                params.append(self.funcBindAt(binds: f.typeParams, index: i))
                values.append(args[i])
                i += 1U64
            }
            // The selected proof is part of a provided body's semantic
            // identity. LLVM consumes this exact BodyInstance through the
            // final descriptor; it must not replace it by a receiver-only
            // re-query. When a body is reached without a call descriptor,
            // its placement conformance supplies the canonical fallback.
            if !(self.proofIsMissing(proof: selectedProof)) {
                proof = selectedProof
            } else {
                proof = self.providedBodyProof(f: f, receiverRef: canonicalRecv)
            }
        }
        if canonicalRecv != 0U64 && canonicalRecv < self.arena.types.count() {
            val recv: TypeRef = self.arena.types[canonicalRecv]
            val si: U64 = self.genericStructIndex(nameStart: recv.nameStart, nameLen: recv.nameLen)
            if si < self.arena.structs.count() {
                val declared: Array[Bind] = self.arena.structs[si].typeParams
                mut val i: U64 = 0U64
                while i < declared.count() && i < recv.args.count() {
                    params.append(declared[i])
                    values.append(recv.args[i])
                    i += 1U64
                }
            } else {
                val ei: U64 = self.genericEnumIndex(nameStart: recv.nameStart, nameLen: recv.nameLen)
                if ei < self.arena.enums.count() {
                    val declared: Array[Bind] = self.arena.enums[ei].typeParams
                    mut val i: U64 = 0U64
                    while i < declared.count() && i < recv.args.count() {
                        params.append(declared[i])
                        values.append(recv.args[i])
                        i += 1U64
                    }
                }
            }
        }
        return <InstanceEnvironment params=params args=values receiverRef=canonicalRecv proof=proof />
    }

    inout fn sameInstanceEnvironment(a: InstanceEnvironment, b: InstanceEnvironment) -> Bool {
        if !(self.sameBodyReceiver(a: a.receiverRef, b: b.receiverRef)) { return false }
        if !(self.sameStaticConformanceProof(a: a.proof, b: b.proof)) { return false }
        if a.params.count() != b.params.count() || a.args.count() != b.args.count() { return false }
        mut val i: U64 = 0U64
        while i < a.params.count() {
            if a.params[i].paramId != b.params[i].paramId || !(self.typeRefEq(a: a.args[i], b: b.args[i])) { return false }
            i += 1U64
        }
        return true
    }

    // Intern the complete semantic key of an enclosing body.  Type-term
    // equality remains structural at this boundary, but it is paid once when a
    // body context is entered rather than once per call descriptor lookup.
    inout fn internBodyInstance(fnIdx: U64, environment: InstanceEnvironment) -> U64 {
        mut val i: U64 = 0U64
        while i < self.arena.bodyInstances.count() {
            val prior: BodyInstance = self.arena.bodyInstances[i]
            if prior.fnIdx == fnIdx && self.sameInstanceEnvironment(a: prior.environment, b: environment) {
                return i + 1U64
            }
            i += 1U64
        }
        self.arena.bodyInstances.append(<BodyInstance fnIdx=fnIdx environment=environment />)
        return self.arena.bodyInstances.count()
    }

    // Read the frontend-frozen identity without interning.  Backend consumers
    // use this at the Mid boundary: creating a BodyInstance after callable
    // finalization would make a semantic descriptor that was never scanned.
    inout fn findBodyInstance(fnIdx: U64, environment: InstanceEnvironment) -> U64 {
        mut val i: U64 = 0U64
        while i < self.arena.bodyInstances.count() {
            val prior: BodyInstance = self.arena.bodyInstances[i]
            if prior.fnIdx == fnIdx && self.sameInstanceEnvironment(a: prior.environment, b: environment) {
                return i + 1U64
            }
            i += 1U64
        }
        return 0U64
    }

    // This is the only normal entry point for the semantic body identity used
    // by Mono and LLVM.  Closure/global synthetic body keys are valid fnIdx
    // values too: their empty environment still needs a distinct call surface.
    inout fn enterBodyInstance(fnIdx: U64, environment: InstanceEnvironment) {
        self.cur.bodyFnIdx = fnIdx
        self.cur.bodyEnvironment = environment
        self.cur.bodyId = self.internBodyInstance(fnIdx: fnIdx, environment: environment)
    }

    // Queue a concrete callable body before LLVM starts.  This is deliberately
    // separate from FnInst: FnInst is a code-generation/mangling detail, while
    // this list is the semantic reachability closure whose bodies must have all
    // final call selections recorded.
    inout fn enqueueFinalBody(fnIdx: U64, args: Array[U64], recvInstRef: U64, selectedProof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> U64 {
        if fnIdx >= self.arena.funcs.count() { return 0U64 }
        val f: Func = self.arena.funcs[fnIdx]
        if f.isExtern || f.body == 0U64 { return 0U64 }
        // A concrete `where` clause is a property of the grounded body
        // instance, not of the old source-walk discovery queue. In particular,
        // a result-position call such as `val x: Token[Bad] = marker()` learns
        // T only when this final CallTemplate edge is grounded. Check exactly
        // here, before the instance becomes reachable by LLVM.
        val environment: InstanceEnvironment = self.bodyInstanceEnvironment(fnIdx: fnIdx, args: args, recvInstRef: recvInstRef, selectedProof: selectedProof)
        val declaration: Func = self.lexicalFunction(f: f)
        if declaration.hasRecv && environment.receiverRef != 0U64 {
            self.checkOneMethodReceiverBounds(fnIdx: fnIdx, f: declaration, args: args, instRef: environment.receiverRef)
        } else if f.typeParams.count() > 0U64 && args.count() == f.typeParams.count() && self.fnArgsAllGround(args: args) {
            self.checkOneFnInstBounds(fin: <FnInst fnIdx=fnIdx args=args recvInstRef=recvInstRef />)
        }
        // A provided copy has no standalone semantic body: its `Self`,
        // associated outputs and nested requirements are defined by the
        // conformance that selected it.  Never materialize one with Missing
        // evidence; abstract checking records its template, while a concrete
        // call re-enters here with a reified proof.
        if declaration.isProvided && self.proofIsMissing(proof: environment.proof) { return 0U64 }
        val bodyId: U64 = self.internBodyInstance(fnIdx: fnIdx, environment: environment)
        mut val i: U64 = 0U64
        while i < self.monoWork.bodyInstances.count() {
            if self.monoWork.bodyInstances[i] == bodyId { return bodyId }
            i += 1U64
        }
        self.monoWork.bodyInstances.append(bodyId)
        return bodyId
    }

    // An associated callable uses the generic-function ABI path even when it
    // has no type parameters.  Register that code-generation instance exactly
    // where Mono has the final callable descriptor, so explicit calls, implicit
    // protocol calls (`for`), and lowered operators cannot drift into separate
    // registration rules.
    inout fn enqueueSelectedAssocInstance(callee: U64, args: Array[U64], recvInstRef: U64) {
        if callee >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[callee]
        if f.isExtern || !(f.isAssoc) { return }
        if f.typeParams.count() > 0U64 {
            if args.count() != f.typeParams.count() || !(self.fnArgsAllGround(args: args)) { return }
        }
        if !(self.fnInstExists(fnIdx: callee, args: args, recvInstRef: recvInstRef)) {
            self.monoWork.fnInsts.append(<FnInst fnIdx=callee args=args recvInstRef=recvInstRef />)
        }
    }

    // Free-function instances (including the zero-type-argument case) use the
    // same final substitutions as any other selected callable.  Registering
    // them here removes the old second inference pass in `registerCallInst`,
    // which could see a shared generic AST without the concrete caller
    // environment.
    inout fn enqueueSelectedFreeInstance(callee: U64, args: Array[U64]) {
        if callee >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[callee]
        // Async functions have their own entry/resume declaration and emission
        // path.  They are final callables like any other call, but are never a
        // `gf` body instance: registering them here opens the async body under
        // the ordinary emitter, where `await` is intentionally not an Expr.
        if f.isExtern || f.hasRecv || f.isAssoc || f.isAsync { return }
        if f.typeParams.count() > 0U64 {
            if args.count() != f.typeParams.count() || !(self.fnArgsAllGround(args: args)) { return }
        }
        if !(self.fnInstExists(fnIdx: callee, args: args)) {
            self.monoWork.fnInsts.append(<FnInst fnIdx=callee args=args />)
        }
    }

    // A copied trait-provided callable inherits the conformance subject's
    // parameters followed by the trait requirement's parameters.  InferFnArgs
    // can recover the latter from ordinary arguments, but a contextless literal
    // (and `Self`-only requirement) must still receive the concrete trait
    // arguments recorded by the conformance.  Resolve that substitution once
    // here, at final-callee construction time.
    inout fn providedTraitArgsForFinalCallee(callee: U64, recvRef: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        if callee >= self.arena.funcs.count() || recvRef == 0U64 { return out }
        val f: Func = self.arena.funcs[callee]
        mut val traitId: U64 = f.originTraitId
        mut val traitOwner: U64 = f.originTraitOwner
        mut val traitArity: U64 = f.originTraitArity
        if traitId == 0U64 {
            traitId = f.srcTraitId
            traitOwner = f.srcTraitOwner
            traitArity = f.provTraitArity
        }
        if traitId == 0U64 || traitArity == 0U64 { return out }
        mut val ci: U64 = 0U64
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            if cf.traitId == traitId && cf.traitStart == traitOwner && cf.traitArgs.count() == traitArity {
                if self.conformanceSubjectMatches(cf: cf, typeRef: recvRef) {
                    mut val binds: Array[UnifyBind] = []
                    // Some primitive/lang-item conformances still use the
                    // legacy zero subject sentinel.  It is an already concrete
                    // subject (conformanceSubjectMatches accepted it), so no
                    // structural binder map is needed to ground its trait args.
                    if cf.subjectTy == 0U64 || self.unifyPatterns(a: cf.subjectTy, aSide: 0U64, b: recvRef, bSide: 1U64, aParams: self.copyConformBinds(binds: cf.typeParams), bParams: [], binds: inout binds, ignoreTopView: true) {
                        mut val subst: Array[U64] = []
                        mut val pi: U64 = 0U64
                        while pi < cf.typeParams.count() {
                            val bi: U64 = self.unificationBindingIndex(binds: binds, side: 0U64, binderId: self.binderIdentity(b: self.conformBindAt(binds: cf.typeParams, index: pi)))
                            if bi < binds.count() { subst.append(binds[bi].ref) }
                            else { subst.append(0U64) }
                            pi += 1U64
                        }
                        val savedP: Array[Bind] = self.cur.typeParams
                        val savedA: Array[U64] = self.cur.typeArgs
                        self.cur.typeParams = self.copyConformBinds(binds: cf.typeParams)
                        self.cur.typeArgs = subst
                        mut val ai: U64 = 0U64
                        while ai < cf.traitArgs.count() {
                            out.append(self.groundTypeRef(ref: self.conformTypeAt(types: cf.traitArgs, index: ai)))
                            ai += 1U64
                        }
                        self.cur.typeParams = savedP
                        self.cur.typeArgs = savedA
                        return out
                    }
                }
            }
            ci += 1U64
        }
        return out
    }

    // A conferred provided copy retains the declaration-local impl binders of
    // the conformance that created it. Those binders are not inferred from a
    // result projection: in `impl[E] B[E] as A { type Output = E }`, Output
    // is a result while the callable body needs the proof substitution
    // `E -> I64`. Recover it only from the exact selected edge and pair the
    // values by ParamId, never by spelling or receiver position.
    inout fn providedProofArgsForFinalCallee(callee: U64, proof: StaticConformanceProof) -> Array[U64] {
        mut val out: Array[U64] = []
        if callee >= self.arena.funcs.count() { return out }
        val f: Func = self.arena.funcs[callee]
        if !(f.isProvided) || f.sourceConformIdx == 0U64 { return out }
        mut val witness: WitnessMatch = <WitnessMatch />
        match proof {
            StaticConformanceProof.ConcreteWitness(witness: val direct) => {
                if direct.conformIdx == f.sourceConformIdx { witness = direct }
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: _) => {
                mut val i: U64 = 0U64
                while i < edges.count() {
                    if edges[i].conformIdx == f.sourceConformIdx { witness = edges[i] }
                    i += 1U64
                }
            }
            _ => {}
        }
        mut val pi: U64 = 0U64
        while pi < f.typeParams.count() {
            mut val value: U64 = 0U64
            if witness.conformIdx != 0U64 {
                val bi: U64 = self.witnessBindParamIndex(binds: witness.binds, paramId: self.funcBindAt(binds: f.typeParams, index: pi).paramId)
                if bi < witness.binds.count() { value = witness.binds[bi].term }
            }
            out.append(value)
            pi += 1U64
        }
        return out
    }

    // Default arguments are evaluated at the CALL SITE, not inside the callee
    // body.  Their AST belongs to the parameter declaration, so a body-only
    // walk misses its nested calls (`fn f(x: T = make())`; `f()`).  Scan every
    // omitted default under the active caller body instance, recording those
    // calls in the same final-callee table that LLVM will consult while it
    // materializes the ABI argument list.
    inout fn scanOmittedDefaultArgs(f: Func, args: ArgRange) {
        mut val pi: U64 = 0U64
        while pi < f.params.count() {
            val ai: U64 = self.argIndexForParam(params: f.params, args: args, paramIdx: pi)
            if ai >= args.len {
                val def: U64 = self.funcParamAt(params: f.params, index: pi).defaultExpr
                if def != 0U64 {
                    self.scanExprInsts(exprId: def)
                }
            }
            pi += 1U64
        }
    }

    // Derive the concrete environment of a selected source-level call and add
    // its callee body to the semantic worklist.  Resolution already happened;
    // this function only preserves that decision and its substitutions.
    inout fn traceMonoTypeHead(ref: U64) {
        if ref == 0U64 || ref >= self.arena.types.count() {
            eprint(text: "?")
            return
        }
        val t: TypeRef = self.arena.types[ref]
        mut val bytes: Array[U8] = []
        mut val i: U64 = 0U64
        while i < t.nameLen {
            bytes.append(self.arena.bytes[t.nameStart + i])
            i += 1U64
        }
        eprint(text: stringFromBytesUnchecked(bytes))
        if t.assocNameId != 0U64 {
            eprint(text: ".")
            bytes = []
            i = 0U64
            while i < t.assocNameLen {
                bytes.append(self.arena.bytes[t.assocNameStart + i])
                i += 1U64
            }
            eprint(text: stringFromBytesUnchecked(bytes))
        }
        if t.args.count() > 0U64 {
            eprint(text: "[")
            i = 0U64
            while i < t.args.count() {
                if i > 0U64 { eprint(text: ",") }
                self.traceMonoTypeHead(ref: t.args[i])
                i += 1U64
            }
            eprint(text: "]")
        }
    }

    inout fn traceIncompleteFinalCallee(exprId: U64, f: Func, args: Array[U64], recvRef: U64, expectedRef: U64) {
        if !(self.traceCodegen) { return }
        mut val name: Array[U8] = []
        mut val i: U64 = 0U64
        while i < f.nameLen {
            name.append(self.arena.bytes[f.nameStart + i])
            i += 1U64
        }
        eprint(text: "[trace-codegen] Mono incomplete callee name=")
        eprint(text: stringFromBytesUnchecked(name))
        eprint(text: " expected=")
        eprintU64(n: f.typeParams.count())
        eprint(text: " actual=")
        eprintU64(n: args.count())
        eprint(text: " receiverRef=")
        eprintU64(n: recvRef)
        eprint(text: " expr=")
        eprintU64(n: exprId)
        eprint(text: " offset=")
        eprintU64(n: self.exprOffset(id: exprId))
        eprint(text: " args=[")
        i = 0U64
        while i < args.count() {
            if i > 0U64 { eprint(text: ",") }
            self.traceMonoTypeHead(ref: args[i])
            i += 1U64
        }
        eprint(text: "] expectedResult=")
        self.traceMonoTypeHead(ref: expectedRef)
        eprint(text: " returnTemplate=")
        self.traceMonoTypeHead(ref: f.retTy)
        eprint(text: "\n")
    }

    inout fn traceProvidedFinalCallee(f: Func, args: Array[U64], recvRef: U64, resultRef: U64) {
        if !(self.traceCodegen) || !(f.isProvided) { return }
        mut val name: Array[U8] = []
        mut val i: U64 = 0U64
        while i < f.nameLen {
            name.append(self.arena.bytes[f.nameStart + i])
            i += 1U64
        }
        eprint(text: "[trace-codegen] Mono provided callee name=")
        eprint(text: stringFromBytesUnchecked(name))
        eprint(text: " receiverRef=")
        eprint(text: digitStrU(d: recvRef))
        eprint(text: " result=")
        self.traceMonoTypeHead(ref: resultRef)
        eprint(text: "\n")
    }

    inout fn enqueueSelectedCallee(selection: CallSiteSelection) {
        val exprId: U64 = selection.exprId
        val callee: U64 = selection.callee
        val siteIsStmt: Bool = selection.siteIsStmt
        val slot: U64 = selection.slot
        if callee >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[callee]
        mut val finalArgs: Array[U64] = []
        mut val recvInst: U64 = selection.receiverRef
        // A semantic call-resolution template can provide the selected
        // receiver directly.  In that case it outranks an AST type entry: a
        // shared generic desugar node necessarily stores `Head[T]`, while this
        // body instance may be compiling `Head[I64]`.
        // A bare generic type qualifier (`Buffer.new`) selects the declaration
        // but is not yet an instantiated receiver.  Treat it as absent here
        // so the semantic expected result may supply `Buffer[T]`; a concrete
        // `Buffer[I64].new` remains a selected receiver.
        mut val hasSelectedReceiver: Bool = selection.resultHintRef != 0U64
        if selection.receiverRef != 0U64 && selection.receiverRef < self.arena.types.count() {
            if !(f.isAssoc) || self.arena.types[selection.receiverRef].args.count() == f.typeParams.count() {
                hasSelectedReceiver = true
            }
        }
        val callArgs: ArgRange = selection.args
        if f.hasRecv && recvInst == 0U64 {
            recvInst = self.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
        }
        if f.hasRecv && recvInst != 0U64 && recvInst < self.arena.types.count() {
            val actual: TypeRef = self.arena.types[recvInst]
            val underlying: U64 = self.newtypeUnderRef(start: actual.nameStart, len: actual.nameLen)
            if underlying != 0U64 && underlying < self.arena.types.count() {
                val underTy: TypeRef = self.arena.types[underlying]
                if spansEqual(c: inout self, aStart: underTy.nameStart, aLen: underTy.nameLen, bStart: f.recvStart, bLen: f.recvLen) {
                    recvInst = underlying
                }
            }
        }
        if f.isAssoc && recvInst == 0U64 {
            recvInst = self.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
        }
        // An associated factory has no value receiver. Its source resolver
        // records the enclosing expected result as an explicit selection fact;
        // use that concrete subject before considering ambient scan state.
        if f.isAssoc && selection.resultHintRef != 0U64 && selection.resultHintRef < self.arena.types.count() {
            val hinted: TypeRef = self.arena.types[selection.resultHintRef]
            if spansEqual(c: inout self, aStart: hinted.nameStart, aLen: hinted.nameLen, bStart: f.recvStart, bLen: f.recvLen) {
                recvInst = selection.resultHintRef
            }
        }
        // A type-qualified generic associated call has no value receiver to
        // carry the subject arguments (`Optional.empty()` is parsed as a
        // Method whose receiver is the bare type name).  Its already-grounded
        // result supplies that same subject instance.  Preserve it here rather
        // than asking LLVM to infer type arguments from the spelling again.
        if f.isAssoc && f.typeParams.count() > 0U64 && !hasSelectedReceiver {
            val resultInst: U64 = selection.resultRef
            if resultInst != 0U64 && resultInst < self.arena.types.count() {
                val resultTy: TypeRef = self.arena.types[resultInst]
                if spansEqual(c: inout self, aStart: resultTy.nameStart, aLen: resultTy.nameLen, bStart: f.recvStart, bLen: f.recvLen) {
                    recvInst = resultInst
                }
            }
        }
        // Every provided callable enters its shared body through concrete
        // conformance evidence. Direct and StaticMethod templates can both
        // legitimately carry symbolic or absent proof at declaration time;
        // once this finalizer has the selected callee and grounded receiver,
        // close it here for all downstream uses. This is the single concrete
        // CallResolution boundary, so body reachability, generic arguments,
        // and the backend's calleeBodyId cannot observe different evidence.
        mut val calleeProof: StaticConformanceProof = selection.proof
        if f.isProvided && self.proofIsMissing(proof: calleeProof) {
            calleeProof = self.providedBodyProof(f: f, receiverRef: recvInst)
        }
        self.scanOmittedDefaultArgs(f: f, args: callArgs)
        if f.typeParams.count() > 0U64 {
            // An associated callable whose complete generic signature is its
            // receiver subject (`Optional[T].empty()` and
            // `Optional[T].fromValue(value:)`) takes T from that selected
            // receiver, not from an independent inference pass.  This holds
            // equally for zero- and value-argument factories.
            if f.isAssoc && recvInst != 0U64 && recvInst < self.arena.types.count() {
                val recvArgs: Array[U64] = self.arena.types[recvInst].args
                if recvArgs.count() == f.typeParams.count() && self.fnArgsAllGround(args: recvArgs) {
                    val calleeBodyId: U64 = self.enqueueFinalBody(fnIdx: callee, args: recvArgs, recvInstRef: recvInst, selectedProof: calleeProof)
                    self.completeStaticBodyCallee(exprId: exprId, callee: callee, recvRef: recvInst, calleeArgs: recvArgs, argumentSources: selection.argumentSources, resultRef: selection.resultRef, resultProjection: selection.resultProjection, siteIsStmt: siteIsStmt, slot: slot, calleeBodyId: calleeBodyId)
                    self.enqueueSelectedAssocInstance(callee: callee, args: recvArgs, recvInstRef: recvInst)
                    self.enqueueSelectedFreeInstance(callee: callee, args: recvArgs)
                    return
                }
            }
            // A recorded call template owns the parametric substitution.  Its
            // grounded values are the primary final-builder input; legacy
            // method producers that have not recorded substitutions yet keep
            // the existing inference adapter until their CallTemplate slice.
            mut val inferred: Array[U64] = selection.calleeTypeArgs
            // A CallTemplate is declared once for the shared source body. It
            // can therefore contain a symbolic associated output (`Item`) for
            // a `for` binding even though this concrete BodyInstance has
            // already proved that binding is `I64`.  The final callable must
            // use the latter: the body-local semantic term is the concrete
            // fact, while the template is provenance plus a fallback for
            // parameters that remain abstract in this instance.  Refine each
            // template slot independently; replacing the whole vector would
            // discard receiver-pattern substitutions that no value argument
            // mentions.
            // A Direct template carries semantic argument sources. Dynamic
            // closure/existential fallbacks have no declaration-time Direct
            // selection yet and retain the legacy reader until their own
            // template variants are introduced.
            mut val inferredFromBody: Array[U64] = []
            if selection.argumentSources.count() > 0U64 {
                inferredFromBody = self.inferFnArgsFromTemplate(f: f, args: callArgs, sources: selection.argumentSources)
            } else {
                inferredFromBody = self.inferFnArgs(f: f, args: callArgs)
            }
            if inferred.count() == 0U64 {
                inferred = inferredFromBody
            } else {
                mut val ii: U64 = 0U64
                while ii < inferredFromBody.count() {
                    if ii < inferred.count() {
                        if inferredFromBody[ii] != 0U64 && self.tyRefIsGround(ref: inferredFromBody[ii]) {
                            inferred.set(i: ii, value: inferredFromBody[ii])
                        }
                    }
                    ii += 1U64
                }
            }
            mut val recvCount: U64 = 0U64
            // Associated callables carry their generic subject exactly like
            // instance methods: `impl[T] Box[T] as Eq { fn eq… }` has no value
            // self, yet `T` is fixed by the selected Box instance.  Preserve
            // those leading substitutions here so LLVM never reconstructs them
            // from an operand or expected type.
            if (f.hasRecv || f.isAssoc) && recvInst != 0U64 && recvInst < self.arena.types.count() {
                recvCount = self.recvParamCount(nameStart: self.arena.types[recvInst].nameStart, nameLen: self.arena.types[recvInst].nameLen)
                // `Pair.of(...)` is written against the generic head `Pair`,
                // whose source TypeRef has no actual arguments.  In that form
                // the call arguments (or expected result) determine *all*
                // parameters; consume only substitutions the receiver actually
                // carries.
                if recvCount > self.arena.types[recvInst].args.count() {
                    recvCount = self.arena.types[recvInst].args.count()
                }
                mut val ri: U64 = 0U64
                while ri < recvCount {
                    if ri < self.arena.types[recvInst].args.count() {
                        finalArgs.append(self.arena.types[recvInst].args[ri])
                    }
                    ri += 1U64
                }
            }
            mut val ai: U64 = recvCount
            while ai < inferred.count() {
                finalArgs.append(inferred[ai])
                ai += 1U64
            }
            // Keep the vector positional even when a legacy inference path did
            // not materialize an unconstrained slot.  The conformance binding
            // below fills such slots by declaration identity; leaving the slot
            // absent would make that information impossible to apply.
            while finalArgs.count() < f.typeParams.count() {
                finalArgs.append(0U64)
            }
            // Generic return-position inference consumes the call template's
            // expected-result context, never the call result itself: before
            // substitution that result is merely `f.retTy` and cannot bind
            // the callee's own T.  `resultRef` remains the selected result of
            // dynamic/no-callable sites and is not inference evidence here.
            finalArgs = self.fillCalleeArgsFromResult(f: f, args: finalArgs, resultRef: selection.resultHintRef)
            // Conformance-declared trait arguments are semantic call inputs,
            // not a backend inference fallback.  They complete a provided
            // requirement whose type variable appears only as `Self` or under
            // a contextless literal.
            val traitArgs: Array[U64] = self.providedTraitArgsForFinalCallee(callee: callee, recvRef: recvInst)
            mut val tai: U64 = 0U64
            while tai < traitArgs.count() {
                val target: U64 = recvCount + tai
                if target < finalArgs.count() {
                    if finalArgs[target] == 0U64 || !(self.tyRefIsGround(ref: finalArgs[target])) { finalArgs[target] = traitArgs[tai] }
                }
                tai += 1U64
            }
            // The selected proof is more precise than return-position
            // inference. In particular a trait-path witness may bind a
            // conformance-local `Element` while the call result is the
            // unrelated projection `A.Output`; preserve the former in the
            // final callable key.
            val proofArgs: Array[U64] = self.providedProofArgsForFinalCallee(callee: callee, proof: calleeProof)
            mut val pai: U64 = 0U64
            while pai < proofArgs.count() && pai < finalArgs.count() {
                if proofArgs[pai] != 0U64 { finalArgs[pai] = proofArgs[pai] }
                pai += 1U64
            }
            if finalArgs.count() != f.typeParams.count() || !(self.fnArgsAllGround(args: finalArgs)) {
                // An incomplete generic call has no emittable final instance.
                self.traceIncompleteFinalCallee(exprId: exprId, f: f, args: finalArgs, recvRef: recvInst, expectedRef: selection.resultHintRef)
                return
            }
        }
        val calleeBodyId: U64 = self.enqueueFinalBody(fnIdx: callee, args: finalArgs, recvInstRef: recvInst, selectedProof: calleeProof)
        self.completeStaticBodyCallee(exprId: exprId, callee: callee, recvRef: recvInst, calleeArgs: finalArgs, argumentSources: selection.argumentSources, resultRef: selection.resultRef, resultProjection: selection.resultProjection, siteIsStmt: siteIsStmt, slot: slot, calleeBodyId: calleeBodyId)
        val finalResult: U64 = self.bodyCalleeResultRef(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        self.traceProvidedFinalCallee(f: f, args: finalArgs, recvRef: recvInst, resultRef: finalResult)
        self.enqueueSelectedAssocInstance(callee: callee, args: finalArgs, recvInstRef: recvInst)
        self.enqueueSelectedFreeInstance(callee: callee, args: finalArgs)
    }

    // `try`'s error conversion is an implicit associated call.  It must enter
    // the same final-callable table as written syntax: LLVM may only consume
    // the selected factory and its concrete substitutions, never rediscover a
    // `from` factory from the two Result spellings.
    inout fn registerTryConversion(exprId: U64, operand: U64) {
        val operandRef: U64 = self.groundedTypeOf(id: operand)
        mut val returnRef: U64 = 0U64
        if self.cur.bodyFnIdx < self.arena.funcs.count() {
            returnRef = self.groundTypeRef(ref: self.arena.funcs[self.cur.bodyFnIdx].retTy)
        }
        val operandErr: U64 = self.resultErrArgRef(ref: operandRef)
        val returnErr: U64 = self.resultErrArgRef(ref: returnRef)
        if operandErr == 0U64 || returnErr == 0U64 || self.typeRefEq(a: operandErr, b: returnErr) {
            return
        }
        val factory: U64 = self.typeRefFromFactoryIdx(errRef: returnErr, srcRef: operandErr)
        if factory >= self.arena.funcs.count() {
            // Verify owns the user diagnostic for a missing conversion. Mono
            // deliberately does not invent a fallback callable.
            return
        }
        val selection: CallSiteSelection = <CallSiteSelection exprId=exprId callee=factory receiverRef=returnErr resultHintRef=returnErr />
        self.recordSelectedBodyCallee(selection: selection)
        self.enqueueSelectedCallee(selection: selection)
    }

    // Ground one explicitly-recorded call argument. This is intentionally
    // separate from groundedBodyReceiverRef: that helper remains a migration
    // reader for arbitrary Expr navigation, whereas a CallTemplate owns its
    // complete semantic input and must not rediscover it from shared AST.
    inout fn groundCallArgumentSource(source: CallArgumentSource) -> U64 {
        match source {
            CallArgumentSource.Term(exprId: _, val term) => {
                return self.groundTermForBody(ref: term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
            }
            CallArgumentSource.Local(exprId: _, localIndex: val localIndex, term: val term) => {
                if localIndex < self.cur.locals.count() {
                    val local: Local = self.cur.locals[localIndex]
                    if local.ty != 0U64 {
                        return self.groundTermForBody(ref: local.ty, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                    }
                }
                return self.groundTermForBody(ref: term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
            }
            CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: val siteKey) => {
                return self.bodyCalleeResultForTemplateDependency(exprId: exprId, siteKey: siteKey)
            }
            CallArgumentSource.Legacy(exprId: val exprId, val info) => {
                // Literal context can be checked after the template captured
                // its unknown adapter. Consume that recorded semantic fact,
                // without reopening syntax or inferring from the callee ABI.
                val term: U64 = self.semanticExprTerm(exprId: exprId)
                if term != 0U64 {
                    return self.groundTermForBody(ref: term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                }
                return self.typedIrRefOfInfo(ti: info)
            }
        }
    }

    fn callArgumentExprId(source: CallArgumentSource) -> U64 {
        match source {
            CallArgumentSource.Term(val exprId, term: _) => { return exprId }
            CallArgumentSource.Local(val exprId, localIndex: _, term: _) => { return exprId }
            CallArgumentSource.PriorCallResult(val exprId, siteKey: _) => { return exprId }
            CallArgumentSource.Legacy(val exprId, info: _) => { return exprId }
        }
    }

    inout fn templateArgumentRange(arguments: Array[CallTemplateArgument]) -> ArgRange {
        mut val args: Array[Arg] = []
        mut val i: U64 = 0U64
        while i < arguments.count() {
            val argument: CallTemplateArgument = arguments[i]
            args.append(<Arg expr=self.callArgumentExprId(source: argument.source) isInout=argument.isInout labelStart=argument.labelStart labelLen=argument.labelLen hasLabel=argument.hasLabel />)
            i += 1U64
        }
        return self.pushArgs(args: args)
    }

    inout fn operatorTemplateArgs(operands: Array[CallArgumentSource]) -> ArgRange {
        val noLabel: Bind = self.kwSpan(kw: "", kwLen: 0U64)
        mut val args: Array[Arg] = []
        mut val i: U64 = 0U64
        while i < operands.count() {
            args.append(<Arg expr=self.callArgumentExprId(source: operands[i]) isInout=false labelStart=noLabel.nameStart labelLen=noLabel.nameLen hasLabel=false />)
            i += 1U64
        }
        return self.pushArgs(args: args)
    }

    // Same selector as check-time binary dispatch, but the RHS arrives through
    // the template instead of an Expr.  The untyped flag retains literal
    // adaptation without letting finalization reopen literal syntax.
    inout fn findBinTraitWitnessForRef(typeStart: U64, typeLen: U64, name: String, rhsRef: U64, rhsUntyped: Bool) -> U64 {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val rhsId: U64 = 0U64
        if rhsRef < self.arena.types.count() {
            val rhs: TypeRef = self.arena.types[rhsRef]
            rhsId = intern(c: inout self, start: rhs.nameStart, len: rhs.nameLen)
        }
        mut val firstMatch: U64 = self.arena.funcs.count()
        mut val intMatch: U64 = self.arena.funcs.count()
        mut val i: U64 = 0U64
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.isAssoc && f.recvId == qType && rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                if firstMatch == self.arena.funcs.count() { firstMatch = i }
                if f.params.count() >= 2U64 {
                    val rhs: Param = self.funcParamAt(params: f.params, index: 1U64)
                    if rhsId != 0U64 && rhs.tyNameId == rhsId { return i }
                    if rhsUntyped && intMatch == self.arena.funcs.count() && self.isIntType(start: rhs.tyStart, len: rhs.tyLen) {
                        intMatch = i
                    }
                }
            }
            i += 1U64
        }
        if rhsUntyped && intMatch < self.arena.funcs.count() { return intMatch }
        return firstMatch
    }

    // Operators are source-level calls to their selected associated witnesses.
    // The CallTemplate is the sole semantic input; Expr remains only a backend
    // navigation anchor after this final descriptor is published.
    inout fn recordBodyOperatorCallee(exprId: U64) {
        val template: CallTemplate = self.callTemplateForCurrentBody(exprId: exprId)
        mut val op: I64 = 0
        mut val operands: Array[CallArgumentSource] = []
        mut val resultTerm: U64 = 0U64
        match template.kind {
            CallTemplateKind.Operator(op: val storedOp, operands: val storedOperands, resolution: _, resultTerm: val storedResult) => {
                op = storedOp
                operands = storedOperands
                resultTerm = storedResult
            }
            _ => {
                // Collection runs once to establish concrete type instances
                // before Record produces semantic templates, then again to
                // finalize call reachability.  There is no valid operator
                // decision in the first phase; defer it rather than reopening
                // Expr syntax.  Once Record allocated the full table, a
                // missing site is an invariant violation.
                if self.arena.semanticExprTypes.count() < self.arena.exprs.count() { return }
                self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: operator CallTemplate was not recorded")
                return
            }
        }
        // A primitive operator may contain only contextual literals, hence no
        // operand TypeTerm of its own.  Its enclosing annotation is already a
        // semantic CallTemplate input and is the authoritative type in that
        // case; never fall back to Mono's AST/type-cache recovery.
        mut val expectedResultRef: U64 = 0U64
        if template.expectedResultTerm != 0U64 {
            expectedResultRef = self.groundTermForBody(ref: template.expectedResultTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        }
        mut val operandRefs: Array[U64] = []
        mut val oi: U64 = 0U64
        while oi < operands.count() {
            operandRefs.append(self.groundCallArgumentSource(source: operands[oi]))
            oi += 1U64
        }
        mut val selectedReceiverRef: U64 = 0U64
        if operandRefs.count() > 0U64 { selectedReceiverRef = operandRefs[0] }
        if selectedReceiverRef == 0U64 { selectedReceiverRef = expectedResultRef }
        mut val callee: U64 = self.arena.funcs.count()
        if !(op == opAnd() || op == opOr()) && selectedReceiverRef != 0U64 && selectedReceiverRef < self.arena.types.count() {
            val receiver: TypeRef = self.arena.types[selectedReceiverRef]
            if operands.count() == 1U64 {
                callee = self.unaryOperatorCallee(receiverRef: selectedReceiverRef, op: op)
            } else if operands.count() == 2U64 {
                mut val method: String = ""
                if op == opEq() || op == opNe() { method = "eq" }
                else if op == opLt() || op == opLe() || op == opGt() || op == opGe() { method = "compare" }
                else if isBinTraitOp(op: op) { method = binTraitMethodName(op: op) }
                if method.bytes().count() > 0U64 {
                    val rhsUntyped: Bool = operandRefs[1] == 0U64
                    callee = self.findBinTraitWitnessForRef(typeStart: receiver.nameStart, typeLen: receiver.nameLen, name: method, rhsRef: operandRefs[1], rhsUntyped: rhsUntyped)
                }
            }
        }
        mut val selectedResultRef: U64 = 0U64
        if resultTerm != 0U64 {
            selectedResultRef = self.groundTermForBody(ref: resultTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        }
        if selectedResultRef == 0U64 { selectedResultRef = expectedResultRef }
        // `Ord.compare` is the carrier selected for ordering syntax, but the
        // source expression is Bool even in an abstract std/generic body whose
        // template has not retained a result term.  This is selection semantics
        // (the same rule as Record's operator template), never a backend type
        // recovery.
        if selectedResultRef == 0U64 && (op == opLt() || op == opLe() || op == opGt() || op == opGe()) {
            val boolName: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
            selectedResultRef = self.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen)
        }
        if callee >= self.arena.funcs.count() && selectedResultRef == 0U64 { selectedResultRef = selectedReceiverRef }
        mut val target: CallTarget = <CallTarget.NoCallable />
        if callee < self.arena.funcs.count() { target = <CallTarget.Direct /> }
        mut val resultProjection: CallResultProjection = <CallResultProjection.Identity />
        if op == opNe() {
            resultProjection = <CallResultProjection.BoolNot />
        }
        if op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            resultProjection = <CallResultProjection.OrderingTest op=op />
        }
        val selection: CallSiteSelection = <CallSiteSelection exprId=exprId callee=callee receiverRef=selectedReceiverRef args=self.operatorTemplateArgs(operands: operands) resultHintRef=self.selectedResultHint(callee: callee) resultRef=selectedResultRef resultProjection=resultProjection target=target />
        self.recordSelectedBodyCallee(selection: selection)
        if callee < self.arena.funcs.count() { self.enqueueSelectedCallee(selection: selection) }
    }

    // Record the one final callable selected for `exprId` in the concrete body
    // currently being scanned.  Generic templates share their AST, so this
    // cannot live in the AST-global TypeCache (which is intentionally only for
    // instance-invariant decisions).
    inout fn finalCalleeCount() -> U64 { return self.arena.finalCallees.count() }

    inout fn currentBodyInstanceId() -> U64 {
        if self.cur.bodyId != 0U64 { return self.cur.bodyId }
        self.cur.bodyId = self.internBodyInstance(fnIdx: self.cur.bodyFnIdx, environment: self.cur.bodyEnvironment)
        return self.cur.bodyId
    }

    // Translate a backend navigation anchor into the frontend-owned semantic
    // origin.  Source, generated and implicit calls intentionally live in
    // disjoint namespaces; `exprId` is never compared as semantic identity.
    inout fn currentCallSiteKey(exprId: U64, siteIsStmt: Bool, slot: U64) -> CallSiteKey {
        // Provided copies share the lexical trait body that owns their call
        // templates.  The final descriptor must use that same canonical owner
        // or a generic associated/provided body writes under the copy while
        // LLVM reads under the template body (a descriptor miss despite both
        // sides having finalized the identical source call).
        val owner: U64 = self.callTemplateOwner(fnIdx: self.callTemplateBodyOwner(fnIdx: self.cur.bodyFnIdx))
        if siteIsStmt {
            mut val start: U64 = 0U64
            mut val end: U64 = 0U64
            if exprId < self.arena.stmts.count() {
                match self.arena.stmts[exprId] {
                    Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, rangeHi: _, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => {
                        start = self.exprOffset(id: iter)
                        if iter < self.arena.exprSpanEnd.count() { end = self.arena.exprSpanEnd[iter] }
                    }
                    _ => {}
                }
            }
            return <CallSiteKey ownerFnIdx=owner originKind=3U64 originStart=start originEnd=end originSerial=exprId + 1U64 slot=slot />
        }
        mut val si: U64 = 0U64
        while si < self.decls.syntheticCallSites.count() {
            val synthetic: SyntheticCallSite = self.decls.syntheticCallSites[si]
            if synthetic.exprId == exprId {
                return <CallSiteKey ownerFnIdx=owner originKind=2U64 originSerial=synthetic.originSerial slot=slot />
            }
            si += 1U64
        }
        val source: CallSiteKey = self.sourceCallSiteKey(fnIdx: self.cur.bodyFnIdx, exprId: exprId)
        return <CallSiteKey ownerFnIdx=source.ownerFnIdx originKind=source.originKind originStart=source.originStart originEnd=source.originEnd originSerial=source.originSerial slot=slot />
    }

    inout fn finalCalleeKeyEqual(entry: U64, bodyId: U64, siteKey: CallSiteKey) -> Bool {
        val e: CallResolution = self.arena.finalCallees[entry]
        return e.bodyId == bodyId && self.sameCallSiteKey(a: e.siteKey, b: siteKey)
    }

    fn finalCalleeHash(bodyId: U64, siteKey: CallSiteKey) -> U64 {
        // Keep every intermediate below 2^32.  U64 overflow is a checked
        // runtime failure in the compiler itself, so an ordinary polynomial
        // hash must normalize each full-width source offset before mixing.
        val modulus: U64 = 4294967291U64
        mut val h: U64 = bodyId % modulus
        h = ((h + siteKey.ownerFnIdx % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originKind % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originStart % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originEnd % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originSerial % modulus) * 65537U64) % modulus
        h = ((h + siteKey.slot % modulus) * 65537U64) % modulus
        return h
    }

    inout fn rebuildFinalCalleeIndex(capacity: U64) {
        self.arena.finalCalleeIndexSlots = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.arena.finalCalleeIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.finalCalleeCount() {
            val e: CallResolution = self.arena.finalCallees[entry]
            mut val slot: U64 = self.finalCalleeHash(bodyId: e.bodyId, siteKey: e.siteKey) % capacity
            while self.arena.finalCalleeIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.arena.finalCalleeIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureFinalCalleeIndex(nextCount: U64) {
        if self.arena.finalCalleeIndexSlots.count() == 0U64 {
            self.rebuildFinalCalleeIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.arena.finalCalleeIndexSlots.count() * 7U64 {
            self.rebuildFinalCalleeIndex(capacity: self.arena.finalCalleeIndexSlots.count() * 2U64)
        }
    }

    // A final callable row is deliberately scalar.  These are the only
    // owner-aware gateways for its variable-sized semantic payloads; callers
    // that truly need a transient Array must ask for an explicit copy.
    inout fn pushFinalCalleeTypeArgs(args: Array[U64]) -> CallResolutionTypeArgRange {
        val start: U64 = self.arena.finalCalleeTypeArgPool.count()
        mut val i: U64 = 0U64
        while i < args.count() {
            self.arena.finalCalleeTypeArgPool.append(args[i])
            i += 1U64
        }
        return <CallResolutionTypeArgRange start=start len=args.count() />
    }

    fn finalCalleeTypeArgAt(args: CallResolutionTypeArgRange, index: U64) -> U64 {
        return self.arena.finalCalleeTypeArgPool[args.start + index]
    }

    inout fn copyFinalCalleeTypeArgs(args: CallResolutionTypeArgRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < args.len {
            out.append(self.finalCalleeTypeArgAt(args: args, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushFinalCalleeParameterTypes(types: Array[U64]) -> CallResolutionParameterTypeRange {
        val start: U64 = self.arena.finalCalleeParameterTypePool.count()
        mut val i: U64 = 0U64
        while i < types.count() {
            self.arena.finalCalleeParameterTypePool.append(types[i])
            i += 1U64
        }
        return <CallResolutionParameterTypeRange start=start len=types.count() />
    }

    fn finalCalleeParameterTypeAt(types: CallResolutionParameterTypeRange, index: U64) -> U64 {
        return self.arena.finalCalleeParameterTypePool[types.start + index]
    }

    inout fn copyFinalCalleeParameterTypes(types: CallResolutionParameterTypeRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < types.len {
            out.append(self.finalCalleeParameterTypeAt(types: types, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushFinalCalleeConversions(conversions: Array[ValueConversionProof]) -> CallResolutionConversionRange {
        val start: U64 = self.arena.finalCalleeConversionPool.count()
        mut val i: U64 = 0U64
        while i < conversions.count() {
            self.arena.finalCalleeConversionPool.append(self.freezeValueConversionProof(proof: conversions[i]))
            i += 1U64
        }
        return <CallResolutionConversionRange start=start len=conversions.count() />
    }

    fn finalCalleeConversionAt(conversions: CallResolutionConversionRange, index: U64) -> U64 {
        return self.arena.finalCalleeConversionPool[conversions.start + index]
    }

    inout fn copyFinalCalleeConversions(conversions: CallResolutionConversionRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < conversions.len {
            out.append(self.finalCalleeConversionAt(conversions: conversions, index: i))
            i += 1U64
        }
        return out
    }

    inout fn pushFinalCalleeArgumentPassings(passings: Array[CallArgumentPassing]) -> CallResolutionArgumentPassingRange {
        val start: U64 = self.arena.finalCalleeArgumentPassingPool.count()
        mut val i: U64 = 0U64
        while i < passings.count() {
            self.arena.finalCalleeArgumentPassingPool.append(passings[i])
            i += 1U64
        }
        return <CallResolutionArgumentPassingRange start=start len=passings.count() />
    }

    fn finalCalleeArgumentPassingAt(passings: CallResolutionArgumentPassingRange, index: U64) -> CallArgumentPassing {
        return self.arena.finalCalleeArgumentPassingPool[passings.start + index]
    }

    inout fn copyFinalCalleeArgumentPassings(passings: CallResolutionArgumentPassingRange) -> Array[CallArgumentPassing] {
        mut val out: Array[CallArgumentPassing] = []
        mut val i: U64 = 0U64
        while i < passings.len {
            out.append(self.finalCalleeArgumentPassingAt(passings: passings, index: i))
            i += 1U64
        }
        return out
    }

    inout fn appendFinalCallee(exprId: U64, callee: U64, siteIsStmt: Bool, slot: U64, recvTypeRef: U64, resultTypeRef: U64, calleeTypeArgs: Array[U64] = [], parameterTypeRefs: Array[U64] = [], argumentConversions: Array[ValueConversionProof] = [], receiverPassing: CallReceiverPassing = <CallReceiverPassing.None />, argumentPassings: Array[CallArgumentPassing] = [], resultProjection: CallResultProjection = <CallResultProjection.Identity />, target: CallTarget = <CallTarget.Direct />, calleeBodyId: U64 = 0U64) {
        val bodyId: U64 = self.currentBodyInstanceId()
        val siteKey: CallSiteKey = self.currentCallSiteKey(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        self.ensureFinalCalleeIndex(nextCount: self.finalCalleeCount() + 1U64)
        val typeArgs: CallResolutionTypeArgRange = self.pushFinalCalleeTypeArgs(args: calleeTypeArgs)
        val parameterTypes: CallResolutionParameterTypeRange = self.pushFinalCalleeParameterTypes(types: parameterTypeRefs)
        val conversions: CallResolutionConversionRange = self.pushFinalCalleeConversions(conversions: argumentConversions)
        val passings: CallResolutionArgumentPassingRange = self.pushFinalCalleeArgumentPassings(passings: argumentPassings)
        self.arena.finalCallees.append(<CallResolution bodyId=bodyId calleeBodyId=calleeBodyId siteKey=siteKey exprId=exprId siteIsStmt=siteIsStmt slot=slot callee=callee calleeTypeArgs=typeArgs parameterTypeRefs=parameterTypes argumentConversions=conversions receiverPassing=receiverPassing argumentPassings=passings recvTypeRef=recvTypeRef resultTypeRef=resultTypeRef resultProjection=resultProjection target=target />)
        val capacity: U64 = self.arena.finalCalleeIndexSlots.count()
        mut val indexSlot: U64 = self.finalCalleeHash(bodyId: bodyId, siteKey: siteKey) % capacity
        while self.arena.finalCalleeIndexSlots[indexSlot] != 0U64 {
            indexSlot = (indexSlot + 1U64) % capacity
        }
        self.arena.finalCalleeIndexSlots.set(i: indexSlot, value: self.finalCalleeCount())
    }

    // Publish a dynamic or no-callable resolution exactly once.  Static calls
    // are completed by enqueueSelectedCallee because their generic ABI is not
    // known until its one grounding operation has run.  Neither path may use
    // an earlier descriptor or recover the receiver/result from the AST.
    inout fn recordSelectedBodyCallee(selection: CallSiteSelection) {
        val exprId: U64 = selection.exprId
        val callee: U64 = selection.callee
        val siteIsStmt: Bool = selection.siteIsStmt
        val slot: U64 = selection.slot
        // Persist an instance-invariant final decision in the AST-owned cache.
        // This is not a backend lookup fallback: it is the canonical storage
        // for calls whose body key has no substitutions or receiver instance.
        if !siteIsStmt && slot == 0U64 && self.cur.bodyEnvironment.params.count() == 0U64 {
            while self.arena.finalExprCallee.count() <= exprId {
                self.arena.finalExprCallee.append(calleeUnfilled())
            }
            self.arena.finalExprCallee.set(i: exprId, value: callee)
            if exprId < self.typeCache.callee.count() {
                self.typeCache.callee.set(i: exprId, value: callee)
            }
        }
        // A static descriptor has no meaningful partial state.  Its generic
        // arguments, ABI parameters, receiver and result are all available
        // together only after `enqueueSelectedCallee` grounds the selected
        // call.  Do not publish an entry here merely for that later operation
        // to overwrite: `completeStaticBodyCallee` is its single publisher.
        // Dynamic and primitive/no-callable selections have no such static
        // grounding step, so publish their already-complete selection directly.
        if self.callTargetIsDirect(target: selection.target) && callee < self.arena.funcs.count() {
            return
        }
        val priorIdx: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if priorIdx < self.finalCalleeCount() {
            val prior: CallResolution = self.arena.finalCallees[priorIdx]
            if !(self.samePublishedNonStaticSelection(prior: prior, selection: selection)) {
                self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: conflicting CallResolution republish")
            }
            return
        }
        self.appendFinalCallee(exprId: exprId, callee: callee, siteIsStmt: siteIsStmt, slot: slot, recvTypeRef: selection.receiverRef, resultTypeRef: selection.resultRef, resultProjection: selection.resultProjection, target: selection.target)
    }

    inout fn samePublishedNonStaticSelection(prior: CallResolution, selection: CallSiteSelection) -> Bool {
        return prior.callee == selection.callee && self.typeRefEq(a: prior.recvTypeRef, b: selection.receiverRef) && self.typeRefEq(a: prior.resultTypeRef, b: selection.resultRef) && self.sameCallResultProjection(a: prior.resultProjection, b: selection.resultProjection) && self.sameCallTarget(a: prior.target, b: selection.target)
    }

    fn sameCallTarget(a: CallTarget, b: CallTarget) -> Bool {
        match a {
            CallTarget.Direct => { match b { CallTarget.Direct => { return true } _ => {} } }
            CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
                match b {
                    CallTarget.RuntimeIntrinsic(intrinsic: val other) => {
                        match intrinsic {
                            RuntimeIntrinsic.Write => { match other { RuntimeIntrinsic.Write => { return true } _ => {} } }
                            RuntimeIntrinsic.Eprint => { match other { RuntimeIntrinsic.Eprint => { return true } _ => {} } }
                            RuntimeIntrinsic.ArgCount => { match other { RuntimeIntrinsic.ArgCount => { return true } _ => {} } }
                            RuntimeIntrinsic.Numeric(intrinsic: val left) => {
                                match other {
                                    RuntimeIntrinsic.Numeric(intrinsic: val right) => { return self.sameNumericIntrinsic(a: left, b: right) }
                                    _ => {}
                                }
                            }
                            RuntimeIntrinsic.Buffer(intrinsic: val left) => {
                                match other {
                                    RuntimeIntrinsic.Buffer(intrinsic: val right) => { return self.sameBufferIntrinsic(a: left, b: right) }
                                    _ => {}
                                }
                            }
                        }
                    }
                    _ => {}
                }
            }
            CallTarget.NoCallable => { match b { CallTarget.NoCallable => { return true } _ => {} } }
            CallTarget.ExistentialRequirement(val traitIdx, slot: val targetSlot) => {
                match b { CallTarget.ExistentialRequirement(traitIdx: val otherTrait, slot: val otherSlot) => { return traitIdx == otherTrait && targetSlot == otherSlot } _ => {} }
            }
            CallTarget.ClosureLocal(val bindingDeclStart, fnTypeRef: val fnRef) => {
                match b { CallTarget.ClosureLocal(bindingDeclStart: val otherBinding, fnTypeRef: val otherRef) => { return bindingDeclStart == otherBinding && fnRef == otherRef } _ => {} }
            }
            CallTarget.ClosureField(val fieldIndex, fnTypeRef: val fnRef) => {
                match b { CallTarget.ClosureField(fieldIndex: val otherIndex, fnTypeRef: val otherRef) => { return fieldIndex == otherIndex && fnRef == otherRef } _ => {} }
            }
        }
        return false
    }

    fn sameNumericIntrinsic(a: NumericIntrinsic, b: NumericIntrinsic) -> Bool {
        match a {
            NumericIntrinsic.Integer(width: val leftWidth, unsigned: val leftUnsigned, operation: val leftOperation, overflow: val leftOverflow) => {
                match b {
                    NumericIntrinsic.Integer(width: val rightWidth, unsigned: val rightUnsigned, operation: val rightOperation, overflow: val rightOverflow) => {
                        return self.sameNumericWidth(a: leftWidth, b: rightWidth) && leftUnsigned == rightUnsigned && self.sameIntegerOperation(a: leftOperation, b: rightOperation) && self.sameNumericOverflow(a: leftOverflow, b: rightOverflow)
                    }
                    _ => { return false }
                }
            }
            NumericIntrinsic.Float(width: val leftWidth, operation: val leftOperation) => {
                match b {
                    NumericIntrinsic.Float(width: val rightWidth, operation: val rightOperation) => { return self.sameFloatWidth(a: leftWidth, b: rightWidth) && self.sameFloatOperation(a: leftOperation, b: rightOperation) }
                    _ => { return false }
                }
            }
            NumericIntrinsic.Bool(operation: val leftOperation) => {
                match b {
                    NumericIntrinsic.Bool(operation: val rightOperation) => { return self.sameBoolOperation(a: leftOperation, b: rightOperation) }
                    _ => { return false }
                }
            }
        }
    }

    fn sameBufferIntrinsic(a: BufferIntrinsic, b: BufferIntrinsic) -> Bool {
        match a {
            BufferIntrinsic.New => { match b { BufferIntrinsic.New => { return true } _ => {} } }
            BufferIntrinsic.Count => { match b { BufferIntrinsic.Count => { return true } _ => {} } }
            BufferIntrinsic.Capacity => { match b { BufferIntrinsic.Capacity => { return true } _ => {} } }
            BufferIntrinsic.Reserve => { match b { BufferIntrinsic.Reserve => { return true } _ => {} } }
            BufferIntrinsic.Append => { match b { BufferIntrinsic.Append => { return true } _ => {} } }
            BufferIntrinsic.InsertAt => { match b { BufferIntrinsic.InsertAt => { return true } _ => {} } }
            BufferIntrinsic.Get => { match b { BufferIntrinsic.Get => { return true } _ => {} } }
            BufferIntrinsic.Set => { match b { BufferIntrinsic.Set => { return true } _ => {} } }
            BufferIntrinsic.RemoveLast => { match b { BufferIntrinsic.RemoveLast => { return true } _ => {} } }
            BufferIntrinsic.RemoveAt => { match b { BufferIntrinsic.RemoveAt => { return true } _ => {} } }
            BufferIntrinsic.SwapRemove => { match b { BufferIntrinsic.SwapRemove => { return true } _ => {} } }
            BufferIntrinsic.Clear => { match b { BufferIntrinsic.Clear => { return true } _ => {} } }
            BufferIntrinsic.Truncate => { match b { BufferIntrinsic.Truncate => { return true } _ => {} } }
            BufferIntrinsic.Eq => { match b { BufferIntrinsic.Eq => { return true } _ => {} } }
            BufferIntrinsic.BytewiseComparable => { match b { BufferIntrinsic.BytewiseComparable => { return true } _ => {} } }
        }
        return false
    }

    fn sameNumericWidth(a: NumericWidth, b: NumericWidth) -> Bool {
        match a {
            NumericWidth.W8 => { match b { NumericWidth.W8 => { return true } _ => { return false } } }
            NumericWidth.W16 => { match b { NumericWidth.W16 => { return true } _ => { return false } } }
            NumericWidth.W32 => { match b { NumericWidth.W32 => { return true } _ => { return false } } }
            NumericWidth.W64 => { match b { NumericWidth.W64 => { return true } _ => { return false } } }
        }
    }

    fn sameNumericOverflow(a: NumericOverflow, b: NumericOverflow) -> Bool {
        match a { NumericOverflow.Checked => { match b { NumericOverflow.Checked => { return true } _ => { return false } } } NumericOverflow.Wrapping => { match b { NumericOverflow.Wrapping => { return true } _ => { return false } } } }
    }

    fn sameFloatWidth(a: FloatWidth, b: FloatWidth) -> Bool {
        match a {
            FloatWidth.W32 => { match b { FloatWidth.W32 => { return true } _ => { return false } } }
            FloatWidth.W64 => { match b { FloatWidth.W64 => { return true } _ => { return false } } }
        }
    }

    fn sameIntegerOperation(a: IntegerOperation, b: IntegerOperation) -> Bool {
        match a {
            IntegerOperation.Add => { match b { IntegerOperation.Add => { return true } _ => {} } }
            IntegerOperation.Sub => { match b { IntegerOperation.Sub => { return true } _ => {} } }
            IntegerOperation.Mul => { match b { IntegerOperation.Mul => { return true } _ => {} } }
            IntegerOperation.Div => { match b { IntegerOperation.Div => { return true } _ => {} } }
            IntegerOperation.Rem => { match b { IntegerOperation.Rem => { return true } _ => {} } }
            IntegerOperation.Neg => { match b { IntegerOperation.Neg => { return true } _ => {} } }
            IntegerOperation.BitNot => { match b { IntegerOperation.BitNot => { return true } _ => {} } }
            IntegerOperation.BitAnd => { match b { IntegerOperation.BitAnd => { return true } _ => {} } }
            IntegerOperation.BitOr => { match b { IntegerOperation.BitOr => { return true } _ => {} } }
            IntegerOperation.BitXor => { match b { IntegerOperation.BitXor => { return true } _ => {} } }
            IntegerOperation.Shl => { match b { IntegerOperation.Shl => { return true } _ => {} } }
            IntegerOperation.Shr => { match b { IntegerOperation.Shr => { return true } _ => {} } }
            IntegerOperation.Eq => { match b { IntegerOperation.Eq => { return true } _ => {} } }
            IntegerOperation.Ne => { match b { IntegerOperation.Ne => { return true } _ => {} } }
            IntegerOperation.Lt => { match b { IntegerOperation.Lt => { return true } _ => {} } }
            IntegerOperation.Le => { match b { IntegerOperation.Le => { return true } _ => {} } }
            IntegerOperation.Gt => { match b { IntegerOperation.Gt => { return true } _ => {} } }
            IntegerOperation.Ge => { match b { IntegerOperation.Ge => { return true } _ => {} } }
        }
        return false
    }

    fn sameFloatOperation(a: FloatOperation, b: FloatOperation) -> Bool {
        match a {
            FloatOperation.Add => { match b { FloatOperation.Add => { return true } _ => {} } }
            FloatOperation.Sub => { match b { FloatOperation.Sub => { return true } _ => {} } }
            FloatOperation.Mul => { match b { FloatOperation.Mul => { return true } _ => {} } }
            FloatOperation.Div => { match b { FloatOperation.Div => { return true } _ => {} } }
            FloatOperation.Neg => { match b { FloatOperation.Neg => { return true } _ => {} } }
            FloatOperation.Eq => { match b { FloatOperation.Eq => { return true } _ => {} } }
            FloatOperation.Lt => { match b { FloatOperation.Lt => { return true } _ => {} } }
        }
        return false
    }

    fn sameBoolOperation(a: BoolOperation, b: BoolOperation) -> Bool {
        match a {
            BoolOperation.Not => { match b { BoolOperation.Not => { return true } _ => {} } }
            BoolOperation.Eq => { match b { BoolOperation.Eq => { return true } _ => {} } }
        }
        return false
    }

    fn sameCallResultProjection(a: CallResultProjection, b: CallResultProjection) -> Bool {
        match a {
            CallResultProjection.Identity => { match b { CallResultProjection.Identity => { return true } _ => {} } }
            CallResultProjection.BoolNot => { match b { CallResultProjection.BoolNot => { return true } _ => {} } }
            CallResultProjection.OrderingTest(op: val left) => {
                match b { CallResultProjection.OrderingTest(op: val right) => { return left == right } _ => {} }
            }
        }
        return false
    }

    // Capture expected-result provenance at the semantic selection boundary.
    // The final builder must not consult the collector's ambient expected type.
    inout fn selectedResultHint(callee: U64) -> U64 {
        if callee < self.arena.funcs.count() && self.arena.funcs[callee].isAssoc && self.monoWork.scanExpectedTy != 0U64 {
            return self.groundTypeRef(ref: self.monoWork.scanExpectedTy)
        }
        return 0U64
    }

    // `CallResolution` is keyed by the concrete body instance rather than AST alone:
    // generic templates share AST nodes, while their selected callees need not.
    // Keep the key comparison here, rather than duplicating it in every table
    // accessor.  Mono writes and LLVM reads the same one key definition.
    inout fn bodyCalleeIndex(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        val bodyId: U64 = self.currentBodyInstanceId()
        val siteKey: CallSiteKey = self.currentCallSiteKey(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        val capacity: U64 = self.arena.finalCalleeIndexSlots.count()
        if capacity == 0U64 { return self.finalCalleeCount() }
        mut val indexSlot: U64 = self.finalCalleeHash(bodyId: bodyId, siteKey: siteKey) % capacity
        while self.arena.finalCalleeIndexSlots[indexSlot] != 0U64 {
            val entry: U64 = self.arena.finalCalleeIndexSlots[indexSlot] - 1U64
            if self.finalCalleeKeyEqual(entry: entry, bodyId: bodyId, siteKey: siteKey) { return entry }
            indexSlot = (indexSlot + 1U64) % capacity
        }
        return self.finalCalleeCount()
    }

    // A call in a body without substitutions is instance-invariant.  Its
    // verifier/Mono decision is retained in the AST cache itself, while a
    // generic body uses the CallResolution table above. Both are final records;
    // this helper deliberately performs no name, overload, or source lookup.
    inout fn cachedInvariantCallee(exprId: U64, siteIsStmt: Bool, slot: U64) -> U64 {
        if siteIsStmt || slot != 0U64 || self.cur.bodyEnvironment.params.count() != 0U64 {
            return self.arena.funcs.count()
        }
        // A provided body is shared source syntax but not necessarily an
        // instance-invariant semantic body: its selected concrete receiver and
        // conformance proof determine nested requirement calls. Never let an
        // AST-global cache from (say) B-as-Show answer A-as-Show.
        if self.cur.bodyFnIdx < self.arena.funcs.count() && self.arena.funcs[self.cur.bodyFnIdx].isProvided {
            return self.arena.funcs.count()
        }
        if exprId < self.typeCache.callee.count() {
            val cached: U64 = self.typeCache.callee[exprId]
            if cached != calleeUnfilled() { return cached }
        }
        if exprId < self.arena.finalExprCallee.count() {
            val cached: U64 = self.arena.finalExprCallee[exprId]
            if cached != calleeUnfilled() { return cached }
        }
        return self.arena.funcs.count()
    }

    // The Mono-owned final-callee table is the only call-resolution input that
    // reaches code generation.  A missing entry is an internal pipeline error:
    // backend must never paper it over by re-running overload/source lookup.
    inout fn bodyCallee(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        val found: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if found < self.finalCalleeCount() {
            return self.arena.finalCallees[found].callee
        }
        // No AST-global fallback here.  A final callable is the boundary
        // between semantic resolution and LLVM; accepting a cache hit after a
        // descriptor-key miss reintroduces a second resolver and is observably
        // wrong for shared provided bodies.  Missing entries are reported below
        // so the Mono walk is completed at the true source of the omission.
        val currentBodyId: U64 = self.currentBodyInstanceId()
        mut val i: U64 = 0U64
        mut val mismatchedReceiver: Bool = false
        mut val mismatchedArgs: Bool = false
        mut val missingBodyArgs: Bool = false
        while i < self.finalCalleeCount() {
            val e: CallResolution = self.arena.finalCallees[i]
            if e.bodyId != currentBodyId && e.siteIsStmt == siteIsStmt && e.slot == slot && e.exprId == exprId {
                val priorBody: BodyInstance = self.arena.bodyInstances[e.bodyId - 1U64]
                if !(self.sameBodyReceiver(a: priorBody.environment.receiverRef, b: self.cur.bodyEnvironment.receiverRef)) {
                    mismatchedReceiver = true
                } else {
                    mismatchedArgs = true
                    if priorBody.environment.params.count() > 0U64 && self.cur.bodyEnvironment.params.count() == 0U64 {
                        missingBodyArgs = true
                    }
                }
            }
            i += 1U64
        }
        if mismatchedReceiver || mismatchedArgs {
            if siteIsStmt {
                if mismatchedReceiver {
                    self.errorAt(offset: 0U64, msg: "internal diagnostic: final callable receiver key differs between Mono and backend")
                } else if missingBodyArgs {
                    self.errorAt(offset: 0U64, msg: "internal diagnostic: backend opened a generic body without final type arguments")
                } else {
                    self.errorAt(offset: 0U64, msg: "internal diagnostic: final callable type-argument key differs between Mono and backend")
                }
            } else {
                if mismatchedReceiver {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: final callable receiver key differs between Mono and backend")
                } else if missingBodyArgs {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: backend opened a generic body without final type arguments")
                } else {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: final callable type-argument key differs between Mono and backend")
                }
            }
            return self.arena.funcs.count()
        }
        if siteIsStmt {
            self.errorAt(offset: 0U64, msg: "internal error: final callable was not recorded for this control-flow call site")
        } else {
            self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: final callable was not recorded for this body instance")
        }
        return self.arena.funcs.count()
    }

    // The receiver identity selected with a final callable.  This is a table
    // read, never a backend type-recovery query.
    inout fn bodyCalleeReceiverRef(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() { return self.arena.finalCallees[i].recvTypeRef }
        return 0U64
    }

    inout fn bodyCalleeResultRef(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() { return self.arena.finalCallees[i].resultTypeRef }
        return 0U64
    }

    inout fn bodyCalleeTypeArgs(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> Array[U64] {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() { return self.copyFinalCalleeTypeArgs(args: self.arena.finalCallees[i].calleeTypeArgs) }
        return []
    }

    inout fn bodyCalleeParameterTypeRefs(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> Array[U64] {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() { return self.copyFinalCalleeParameterTypes(types: self.arena.finalCallees[i].parameterTypeRefs) }
        return []
    }

    // Finalize the static portion of a selected call atomically.  The target
    // kind may already have been fixed for an existential/closure call, so it
    // is preserved; type arguments, ABI parameters, receiver and result are
    // one coherent grounding under the same selected invocation.
    inout fn sameResolvedTypeRefs(a: Array[U64], b: Array[U64]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            if !(self.typeRefEq(a: a[i], b: b[i])) { return false }
            i += 1U64
        }
        return true
    }

    inout fn sameValueConversionProof(a: ValueConversionProof, b: ValueConversionProof) -> Bool {
        match a {
            ValueConversionProof.Identity => { match b { ValueConversionProof.Identity => { return true } _ => {} } }
            ValueConversionProof.Missing => { match b { ValueConversionProof.Missing => { return true } _ => {} } }
            ValueConversionProof.ExistentialBox(sourceRef: val leftSource, targetRef: val leftTarget, traitIdx: val leftTrait, proof: val leftProof) => {
                match b { ValueConversionProof.ExistentialBox(sourceRef: val rightSource, targetRef: val rightTarget, traitIdx: val rightTrait, proof: val rightProof) => { return self.typeRefEq(a: leftSource, b: rightSource) && self.typeRefEq(a: leftTarget, b: rightTarget) && leftTrait == rightTrait && self.sameStaticConformanceProof(a: leftProof, b: rightProof) } _ => {} }
            }
            ValueConversionProof.ArrayRepack(sourceRef: val leftSource, targetRef: val leftTarget, element: val leftElement) => {
                match b { ValueConversionProof.ArrayRepack(sourceRef: val rightSource, targetRef: val rightTarget, element: val rightElement) => { return self.typeRefEq(a: leftSource, b: rightSource) && self.typeRefEq(a: leftTarget, b: rightTarget) && self.sameValueConversionProof(a: leftElement, b: rightElement) } _ => {} }
            }
            ValueConversionProof.EnumRepack(sourceRef: val leftSource, targetRef: val leftTarget, enumIdx: val leftEnum, payloads: val leftPayloads) => {
                match b {
                    ValueConversionProof.EnumRepack(sourceRef: val rightSource, targetRef: val rightTarget, enumIdx: val rightEnum, payloads: val rightPayloads) => {
                        if !(self.typeRefEq(a: leftSource, b: rightSource)) || !(self.typeRefEq(a: leftTarget, b: rightTarget)) || leftEnum != rightEnum || leftPayloads.count() != rightPayloads.count() { return false }
                        mut val i: U64 = 0U64
                        while i < leftPayloads.count() {
                            val leftPayload: EnumPayloadConversion = leftPayloads[i]
                            val rightPayload: EnumPayloadConversion = rightPayloads[i]
                            if !(self.typeRefEq(a: leftPayload.sourceRef, b: rightPayload.sourceRef)) || !(self.typeRefEq(a: leftPayload.targetRef, b: rightPayload.targetRef)) || !(self.sameValueConversionProof(a: leftPayload.conversion, b: rightPayload.conversion)) { return false }
                            i += 1U64
                        }
                        return true
                    }
                    _ => {}
                }
            }
        }
        return false
    }

    inout fn sameValueConversionProofs(a: Array[ValueConversionProof], b: Array[ValueConversionProof]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            if !(self.sameValueConversionProof(a: a[i], b: b[i])) { return false }
            i += 1U64
        }
        return true
    }

    inout fn sameFrozenValueConversionProofs(a: Array[U64], b: Array[ValueConversionProof]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            if !(self.sameValueConversionProof(a: self.thawValueConversionProof(id: a[i]), b: b[i])) { return false }
            i += 1U64
        }
        return true
    }

    fn selectedReceiverPassing(callee: U64) -> CallReceiverPassing {
        if callee >= self.arena.funcs.count() { return <CallReceiverPassing.None /> }
        val f: Func = self.arena.funcs[callee]
        if !(f.hasRecv) { return <CallReceiverPassing.None /> }
        if f.selfInout { return <CallReceiverPassing.Inout /> }
        if f.selfMove { return <CallReceiverPassing.Move /> }
        return <CallReceiverPassing.Borrow />
    }

    fn selectedArgumentPassings(callee: U64) -> Array[CallArgumentPassing] {
        mut val passings: Array[CallArgumentPassing] = []
        if callee >= self.arena.funcs.count() { return passings }
        val f: Func = self.arena.funcs[callee]
        mut val i: U64 = 0U64
        while i < f.params.count() {
            val parameter: Param = self.funcParamAt(params: f.params, index: i)
            if parameter.isInout {
                passings.append(<CallArgumentPassing.Inout />)
            } else if parameter.isMove {
                passings.append(<CallArgumentPassing.Move />)
            } else {
                passings.append(<CallArgumentPassing.Borrow />)
            }
            i += 1U64
        }
        return passings
    }

    fn sameCallReceiverPassing(a: CallReceiverPassing, b: CallReceiverPassing) -> Bool {
        match a {
            CallReceiverPassing.None => { match b { CallReceiverPassing.None => { return true } _ => {} } }
            CallReceiverPassing.Borrow => { match b { CallReceiverPassing.Borrow => { return true } _ => {} } }
            CallReceiverPassing.Inout => { match b { CallReceiverPassing.Inout => { return true } _ => {} } }
            CallReceiverPassing.Move => { match b { CallReceiverPassing.Move => { return true } _ => {} } }
        }
        return false
    }

    fn sameCallArgumentPassings(a: Array[CallArgumentPassing], b: Array[CallArgumentPassing]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            match a[i] {
                CallArgumentPassing.Borrow => { match b[i] { CallArgumentPassing.Borrow => {} _ => { return false } } }
                CallArgumentPassing.Inout => { match b[i] { CallArgumentPassing.Inout => {} _ => { return false } } }
                CallArgumentPassing.Move => { match b[i] { CallArgumentPassing.Move => {} _ => { return false } } }
            }
            i += 1U64
        }
        return true
    }

    inout fn sameStaticCallResolution(e: CallResolution, callee: U64, recvRef: U64, calleeArgs: Array[U64], parameterTypeRefs: Array[U64], argumentConversions: Array[ValueConversionProof], receiverPassing: CallReceiverPassing, argumentPassings: Array[CallArgumentPassing], resultRef: U64, resultProjection: CallResultProjection, target: CallTarget) -> Bool {
        return self.callTargetIsDirect(target: e.target) && self.sameCallTarget(a: e.target, b: target) && e.callee == callee && self.typeRefEq(a: e.recvTypeRef, b: recvRef) && self.typeRefEq(a: e.resultTypeRef, b: resultRef) && self.sameCallResultProjection(a: e.resultProjection, b: resultProjection) && self.sameResolvedTypeRefs(a: self.copyFinalCalleeTypeArgs(args: e.calleeTypeArgs), b: calleeArgs) && self.sameResolvedTypeRefs(a: self.copyFinalCalleeParameterTypes(types: e.parameterTypeRefs), b: parameterTypeRefs) && self.sameFrozenValueConversionProofs(a: self.copyFinalCalleeConversions(conversions: e.argumentConversions), b: argumentConversions) && self.sameCallReceiverPassing(a: e.receiverPassing, b: receiverPassing) && self.sameCallArgumentPassings(a: self.copyFinalCalleeArgumentPassings(passings: e.argumentPassings), b: argumentPassings)
    }

    // Expand an enum conversion through every physical payload field while the
    // concrete source/target TypeRefs are still frontend facts. The resulting
    // proof is in declaration variant order, so LLVM needs only enum layout to
    // extract the matching value; it never grounds a field type to choose a
    // conversion.
    inout fn enumRepackPayloadConversions(sourceRef: U64, targetRef: U64, enumIdx: U64) -> Array[EnumPayloadConversion] {
        mut val payloads: Array[EnumPayloadConversion] = []
        if sourceRef >= self.arena.types.count() || targetRef >= self.arena.types.count() || enumIdx >= self.arena.enums.count() { return payloads }
        val source: TypeRef = self.arena.types[sourceRef]
        val target: TypeRef = self.arena.types[targetRef]
        if source.args.count() != target.args.count() { return payloads }
        val savedParams: Array[Bind] = self.cur.typeParams
        val savedArgs: Array[U64] = self.cur.typeArgs
        mut val variant: U64 = 0U64
        while variant < self.arena.enums[enumIdx].variants.count() {
            val fields: Array[FieldDef] = self.arena.enums[enumIdx].variants[variant].fields
            mut val field: U64 = 0U64
            while field < fields.count() {
                self.cur.typeParams = self.arena.enums[enumIdx].typeParams
                self.cur.typeArgs = source.args
                val sourceFieldRef: U64 = self.groundTypeRef(ref: fields[field].ty)
                self.cur.typeArgs = target.args
                val targetFieldRef: U64 = self.groundTypeRef(ref: fields[field].ty)
                self.cur.typeParams = savedParams
                self.cur.typeArgs = savedArgs
                payloads.append(<EnumPayloadConversion sourceRef=sourceFieldRef targetRef=targetFieldRef conversion=self.callArgumentConversion(sourceRef: sourceFieldRef, targetRef: targetFieldRef) />)
                field += 1U64
            }
            variant += 1U64
        }
        self.cur.typeParams = savedParams
        self.cur.typeArgs = savedArgs
        return payloads
    }

    // Select a conversion from already-ground source and ABI terms. This is a
    // frontend proof boundary: later Mid/LLVM code receives the choice and
    // never uses an argument expression to rediscover it.
    inout fn callArgumentConversion(sourceRef: U64, targetRef: U64) -> ValueConversionProof {
        if sourceRef == 0U64 || targetRef == 0U64 || sourceRef >= self.arena.types.count() || targetRef >= self.arena.types.count() { return <ValueConversionProof.Missing /> }
        if self.typeRefEq(a: sourceRef, b: targetRef) { return <ValueConversionProof.Identity /> }
        val target: TypeRef = self.arena.types[targetRef]
        val source: TypeRef = self.arena.types[sourceRef]
        if target.isAny {
            // The existential TypeTerm already carries the resolver-selected
            // declaration identity. Reusing that identity prevents an import
            // or re-export with the same spelling from changing a conversion
            // proof during finalization.
            val traitIdx: U64 = self.recordAnyTraitIndex(anyRef: targetRef)
            if traitIdx >= self.decls.traits.count() { return <ValueConversionProof.Missing /> }
            val trait: TraitDef = self.decls.traits[traitIdx]
            val proof: StaticConformanceProof = self.concreteConformanceProof(baseRef: sourceRef, traitId: trait.nameId, traitOwner: trait.nameStart, traitArgs: [])
            if self.proofIsMissing(proof: proof) { return <ValueConversionProof.Missing /> }
            return <ValueConversionProof.ExistentialBox sourceRef=sourceRef targetRef=targetRef traitIdx=traitIdx proof=proof />
        }
        // Covariance is represented structurally, not re-detected in LLVM.
        // The type checker already decides which containers are covariant; this
        // mirrors that admitted Array / generic-enum surface and fails closed
        // for every other head or invariant position.
        if !(spansEqual(c: inout self, aStart: source.nameStart, aLen: source.nameLen, bStart: target.nameStart, bLen: target.nameLen)) || source.args.count() == 0U64 || source.args.count() != target.args.count() { return <ValueConversionProof.Missing /> }
        mut val arguments: Array[ValueConversionProof] = []
        mut val changed: Bool = false
        mut val i: U64 = 0U64
        while i < source.args.count() {
            val child: ValueConversionProof = self.callArgumentConversion(sourceRef: source.args[i], targetRef: target.args[i])
            match child { ValueConversionProof.Missing => { return <ValueConversionProof.Missing /> } ValueConversionProof.Identity => {} _ => { changed = true } }
            arguments.append(child)
            i += 1U64
        }
        if !changed { return <ValueConversionProof.Missing /> }
        if rangeEquals(bytes: self.arena.bytes, start: target.nameStart, len: target.nameLen, kw: "Array") && arguments.count() == 1U64 {
            return <ValueConversionProof.ArrayRepack sourceRef=sourceRef targetRef=targetRef element=arguments[0U64] />
        }
        val enumIdx: U64 = self.genericEnumIndex(nameStart: target.nameStart, nameLen: target.nameLen)
        if enumIdx < self.arena.enums.count() {
            val payloads: Array[EnumPayloadConversion] = self.enumRepackPayloadConversions(sourceRef: sourceRef, targetRef: targetRef, enumIdx: enumIdx)
            mut val payload: U64 = 0U64
            while payload < payloads.count() {
                match payloads[payload].conversion { ValueConversionProof.Missing => { return <ValueConversionProof.Missing /> } _ => {} }
                payload += 1U64
            }
            return <ValueConversionProof.EnumRepack sourceRef=sourceRef targetRef=targetRef enumIdx=enumIdx payloads=payloads />
        }
        return <ValueConversionProof.Missing />
    }

    inout fn callArgumentConversions(sources: Array[CallTemplateArgument], parameterTypeRefs: Array[U64]) -> Array[ValueConversionProof] {
        mut val conversions: Array[ValueConversionProof] = []
        mut val i: U64 = 0U64
        while i < parameterTypeRefs.count() {
            if i < sources.count() {
                conversions.append(self.callArgumentConversion(sourceRef: self.groundCallArgumentSource(source: sources[i].source), targetRef: parameterTypeRefs[i]))
            } else {
                // Omitted defaults own their conversion at the default's
                // semantic boundary, not at this caller.
                conversions.append(<ValueConversionProof.Identity />)
            }
            i += 1U64
        }
        return conversions
    }

    // Final aggregate resolutions are indexed exactly like final calls.  A
    // BodyInstance can instantiate the same source ExprId many ways, while an
    // aggregate expression can contain another aggregate with a distinct
    // ExprId; neither array position nor spelling is semantic identity.
    fn finalAggregateHash(bodyId: U64, exprId: U64) -> U64 {
        val modulus: U64 = 4294967291U64
        return (((bodyId % modulus + exprId % modulus) * 65537U64) + 17U64) % modulus
    }

    inout fn rebuildFinalAggregateIndex(capacity: U64) {
        self.arena.finalAggregateIndexSlots = []
        mut val zero: U64 = 0U64
        while zero < capacity {
            self.arena.finalAggregateIndexSlots.append(0U64)
            zero += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.arena.finalAggregates.count() {
            val fact: FinalAggregateResolution = self.arena.finalAggregates[entry]
            mut val slot: U64 = self.finalAggregateHash(bodyId: fact.bodyId, exprId: fact.exprId) % capacity
            while self.arena.finalAggregateIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.arena.finalAggregateIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureFinalAggregateIndex(nextCount: U64) {
        if self.arena.finalAggregateIndexSlots.count() == 0U64 {
            self.rebuildFinalAggregateIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.arena.finalAggregateIndexSlots.count() * 7U64 {
            self.rebuildFinalAggregateIndex(capacity: self.arena.finalAggregateIndexSlots.count() * 2U64)
        }
    }

    // Returns the table-count sentinel when no immutable fact exists.
    inout fn finalAggregateIndex(bodyId: U64, exprId: U64) -> U64 {
        val capacity: U64 = self.arena.finalAggregateIndexSlots.count()
        if capacity == 0U64 { return self.arena.finalAggregates.count() }
        mut val slot: U64 = self.finalAggregateHash(bodyId: bodyId, exprId: exprId) % capacity
        while self.arena.finalAggregateIndexSlots[slot] != 0U64 {
            val entry: U64 = self.arena.finalAggregateIndexSlots[slot] - 1U64
            val fact: FinalAggregateResolution = self.arena.finalAggregates[entry]
            if fact.bodyId == bodyId && fact.exprId == exprId { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.arena.finalAggregates.count()
    }

    inout fn putFinalAggregate(fact: FinalAggregateResolution) {
        val prior: U64 = self.finalAggregateIndex(bodyId: fact.bodyId, exprId: fact.exprId)
        if prior < self.arena.finalAggregates.count() {
            self.arena.finalAggregates.set(i: prior, value: fact)
            return
        }
        self.ensureFinalAggregateIndex(nextCount: self.arena.finalAggregates.count() + 1U64)
        self.arena.finalAggregates.append(fact)
        val capacity: U64 = self.arena.finalAggregateIndexSlots.count()
        mut val slot: U64 = self.finalAggregateHash(bodyId: fact.bodyId, exprId: fact.exprId) % capacity
        while self.arena.finalAggregateIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.arena.finalAggregateIndexSlots.set(i: slot, value: self.arena.finalAggregates.count())
    }

    inout fn rebuildFinalReturnIndex(capacity: U64) {
        self.arena.finalReturnIndexSlots = []
        mut val zero: U64 = 0U64
        while zero < capacity {
            self.arena.finalReturnIndexSlots.append(0U64)
            zero += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.arena.finalReturns.count() {
            val fact: FinalReturnResolution = self.arena.finalReturns[entry]
            mut val slot: U64 = self.finalAggregateHash(bodyId: fact.bodyId, exprId: fact.exprId) % capacity
            while self.arena.finalReturnIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.arena.finalReturnIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureFinalReturnIndex(nextCount: U64) {
        if self.arena.finalReturnIndexSlots.count() == 0U64 {
            self.rebuildFinalReturnIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.arena.finalReturnIndexSlots.count() * 7U64 {
            self.rebuildFinalReturnIndex(capacity: self.arena.finalReturnIndexSlots.count() * 2U64)
        }
    }

    // Returns the table-count sentinel when no frozen ABI return fact exists.
    inout fn finalReturnIndex(bodyId: U64, exprId: U64) -> U64 {
        val capacity: U64 = self.arena.finalReturnIndexSlots.count()
        if capacity == 0U64 { return self.arena.finalReturns.count() }
        mut val slot: U64 = self.finalAggregateHash(bodyId: bodyId, exprId: exprId) % capacity
        while self.arena.finalReturnIndexSlots[slot] != 0U64 {
            val entry: U64 = self.arena.finalReturnIndexSlots[slot] - 1U64
            val fact: FinalReturnResolution = self.arena.finalReturns[entry]
            if fact.bodyId == bodyId && fact.exprId == exprId { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.arena.finalReturns.count()
    }

    inout fn putFinalReturn(fact: FinalReturnResolution) {
        val prior: U64 = self.finalReturnIndex(bodyId: fact.bodyId, exprId: fact.exprId)
        if prior < self.arena.finalReturns.count() {
            self.arena.finalReturns.set(i: prior, value: fact)
            return
        }
        self.ensureFinalReturnIndex(nextCount: self.arena.finalReturns.count() + 1U64)
        self.arena.finalReturns.append(fact)
        val capacity: U64 = self.arena.finalReturnIndexSlots.count()
        mut val slot: U64 = self.finalAggregateHash(bodyId: fact.bodyId, exprId: fact.exprId) % capacity
        while self.arena.finalReturnIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.arena.finalReturnIndexSlots.set(i: slot, value: self.arena.finalReturns.count())
    }

    // Freeze one aggregate only after its children have been finalized in the
    // active BodyInstance. The Record carrier supplies the source tree and
    // physical slots; this pass supplies the one concrete substitution and
    // conformance proof per slot. No AST type/candidate recovery occurs here.
    inout fn finalizeCurrentBodyAggregate(exprId: U64) {
        val bodyId: U64 = self.currentBodyInstanceId()
        if bodyId == 0U64 { return }
        val sourceIndex: U64 = self.semanticAggregateIndex(ownerFnIdx: self.cur.bodyFnIdx, exprId: exprId)
        if sourceIndex >= self.decls.semanticAggregates.count() { return }
        val aggregate: SemanticAggregate = self.decls.semanticAggregates[sourceIndex]
        mut val targets: Array[U64] = []
        mut val conversions: Array[ValueConversionProof] = []
        mut val i: U64 = 0U64
        while i < aggregate.elements.count() {
            val element: SemanticAggregateElement = aggregate.elements[i]
            val sourceRef: U64 = self.groundTermForBody(ref: element.term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
            val targetRef: U64 = self.groundTermForBody(ref: element.targetTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
            targets.append(targetRef)
            conversions.append(self.callArgumentConversion(sourceRef: sourceRef, targetRef: targetRef))
            i += 1U64
        }
        self.putFinalAggregate(fact: <FinalAggregateResolution bodyId=bodyId exprId=exprId resultTypeRef=self.groundTermForBody(ref: aggregate.resultTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef) elementTargetRefs=targets elementConversions=conversions />)
    }

    fn finalMatchHash(bodyId: U64, stmtId: U64) -> U64 {
        val modulus: U64 = 4294967291U64
        return (((bodyId % modulus + stmtId % modulus) * 65537U64) + 31U64) % modulus
    }

    inout fn rebuildFinalMatchIndex(capacity: U64) {
        self.arena.finalMatchIndexSlots = []
        mut val zero: U64 = 0U64
        while zero < capacity {
            self.arena.finalMatchIndexSlots.append(0U64)
            zero += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.arena.finalMatches.count() {
            val fact: FinalMatchResolution = self.arena.finalMatches[entry]
            mut val slot: U64 = self.finalMatchHash(bodyId: fact.bodyId, stmtId: fact.stmtId) % capacity
            while self.arena.finalMatchIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.arena.finalMatchIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureFinalMatchIndex(nextCount: U64) {
        if self.arena.finalMatchIndexSlots.count() == 0U64 {
            self.rebuildFinalMatchIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.arena.finalMatchIndexSlots.count() * 7U64 {
            self.rebuildFinalMatchIndex(capacity: self.arena.finalMatchIndexSlots.count() * 2U64)
        }
    }

    // Returns the table-count sentinel when the active body has no frozen
    // enum-match layout for this source statement.
    inout fn finalMatchIndex(bodyId: U64, stmtId: U64) -> U64 {
        val capacity: U64 = self.arena.finalMatchIndexSlots.count()
        if capacity == 0U64 { return self.arena.finalMatches.count() }
        mut val slot: U64 = self.finalMatchHash(bodyId: bodyId, stmtId: stmtId) % capacity
        while self.arena.finalMatchIndexSlots[slot] != 0U64 {
            val entry: U64 = self.arena.finalMatchIndexSlots[slot] - 1U64
            val fact: FinalMatchResolution = self.arena.finalMatches[entry]
            if fact.bodyId == bodyId && fact.stmtId == stmtId { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.arena.finalMatches.count()
    }

    inout fn putFinalMatch(fact: FinalMatchResolution) {
        val prior: U64 = self.finalMatchIndex(bodyId: fact.bodyId, stmtId: fact.stmtId)
        if prior < self.arena.finalMatches.count() {
            self.arena.finalMatches.set(i: prior, value: fact)
            return
        }
        self.ensureFinalMatchIndex(nextCount: self.arena.finalMatches.count() + 1U64)
        self.arena.finalMatches.append(fact)
        val capacity: U64 = self.arena.finalMatchIndexSlots.count()
        mut val slot: U64 = self.finalMatchHash(bodyId: fact.bodyId, stmtId: fact.stmtId) % capacity
        while self.arena.finalMatchIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.arena.finalMatchIndexSlots.set(i: slot, value: self.arena.finalMatches.count())
    }

    // Ground one parametric SemanticMatch under the active BodyInstance. No
    // AST spelling or legacy type recovery participates after this boundary.
    inout fn finalizeCurrentBodyMatch(stmtId: U64) {
        val bodyId: U64 = self.currentBodyInstanceId()
        if bodyId == 0U64 { return }
        val sourceIndex: U64 = self.semanticMatchIndex(ownerFnIdx: self.cur.bodyFnIdx, stmtId: stmtId)
        if sourceIndex >= self.decls.semanticMatches.count() { return }
        val source: SemanticMatch = self.decls.semanticMatches[sourceIndex]
        val scrutineeTypeRef: U64 = self.groundTermForBody(ref: source.scrutineeTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        if scrutineeTypeRef == 0U64 { return }
        mut val arms: Array[FinalMatchArmResolution] = []
        mut val armIndex: U64 = 0U64
        while armIndex < source.arms.count() {
            val sourceArm: SemanticMatchArm = source.arms[armIndex]
            mut val payloads: Array[FinalMatchPayloadResolution] = []
            mut val payloadIndex: U64 = 0U64
            while payloadIndex < sourceArm.payloads.count() {
                val sourcePayload: SemanticMatchPayload = sourceArm.payloads[payloadIndex]
                val fieldTypeRef: U64 = self.groundTermForBody(ref: sourcePayload.fieldTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                if fieldTypeRef == 0U64 { return }
                payloads.append(<FinalMatchPayloadResolution bindTarget=sourcePayload.bindTarget fieldIndex=sourcePayload.fieldIndex fieldTypeRef=fieldTypeRef />)
                payloadIndex += 1U64
            }
            arms.append(<FinalMatchArmResolution hasVariant=sourceArm.hasVariant variantIndex=sourceArm.variantIndex payloads=payloads />)
            armIndex += 1U64
        }
        self.putFinalMatch(fact: <FinalMatchResolution bodyId=bodyId stmtId=stmtId scrutineeTypeRef=scrutineeTypeRef enumIndex=source.enumIndex arms=arms />)
    }

    // A return is a source-level value boundary just like a call argument. The
    // selected expression term and declared ABI result are frontend facts; this
    // finalizer grounds them once in the active BodyInstance and freezes the
    // proof before Mid ownership/drop processing begins.
    inout fn finalizeCurrentBodyReturn(exprId: U64) {
        val bodyId: U64 = self.currentBodyInstanceId()
        if bodyId == 0U64 || self.cur.bodyFnIdx >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[self.cur.bodyFnIdx]
        val targetRef: U64 = self.groundTermForBody(ref: f.retTy, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        mut val sourceRef: U64 = self.groundTermForBody(ref: self.semanticExprTerm(exprId: exprId), environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        // A direct record aggregate in return position has one ABI authority:
        // the declared return TypeTerm.  Its parametric aggregate carrier owns
        // source evaluation order, while this finalization supplies the
        // concrete result layout and physical field targets.  Without this,
        // an identity return can still preserve a declaration-time synthetic
        // record layout that is structurally equal but LLVM-nominally distinct
        // from the ABI result type.
        val semanticIndex: U64 = self.semanticAggregateIndex(ownerFnIdx: self.cur.bodyFnIdx, exprId: exprId)
        val finalIndex: U64 = self.finalAggregateIndex(bodyId: bodyId, exprId: exprId)
        if semanticIndex < self.decls.semanticAggregates.count() && finalIndex < self.arena.finalAggregates.count() && targetRef < self.arena.types.count() {
            val target: TypeRef = self.arena.types[targetRef]
            val aggregate: SemanticAggregate = self.decls.semanticAggregates[semanticIndex]
            if target.isRecord && target.recordFieldTerms.count() == aggregate.elements.count() {
                mut val targets: Array[U64] = []
                mut val conversions: Array[ValueConversionProof] = []
                mut val complete: Bool = true
                mut val i: U64 = 0U64
                while i < aggregate.elements.count() {
                    val element: SemanticAggregateElement = aggregate.elements[i]
                    if element.fieldIndex >= target.recordFieldTerms.count() {
                        complete = false
                    } else {
                        val source: U64 = self.groundTermForBody(ref: element.term, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                        val fieldTarget: U64 = target.recordFieldTerms[element.fieldIndex]
                        targets.append(fieldTarget)
                        conversions.append(self.callArgumentConversion(sourceRef: source, targetRef: fieldTarget))
                    }
                    i += 1U64
                }
                if complete {
                    self.putFinalAggregate(fact: <FinalAggregateResolution bodyId=bodyId exprId=exprId resultTypeRef=targetRef elementTargetRefs=targets elementConversions=conversions />)
                    sourceRef = targetRef
                }
            }
        }
        self.putFinalReturn(fact: <FinalReturnResolution bodyId=bodyId exprId=exprId targetTypeRef=targetRef conversion=self.callArgumentConversion(sourceRef: sourceRef, targetRef: targetRef) />)
    }

    // A final descriptor records the source value type, while codegen gets
    // the raw ABI result from its selected callable.  Keeping those facts
    // separate is essential for `Ord.compare`-backed operators: their callee
    // returns Ordering but `<` observes Bool.
    inout fn callResultProjectionIsValid(carrierRef: U64, resultRef: U64, projection: CallResultProjection) -> Bool {
        match projection {
            CallResultProjection.Identity => { return self.typeRefEq(a: carrierRef, b: resultRef) }
            CallResultProjection.BoolNot => { return self.typeRefEq(a: carrierRef, b: resultRef) }
            CallResultProjection.OrderingTest(op: _) => {
                // The closed projection is introduced only by Ord operator
                // selection.  Reconstructing `Ordering`/`Bool` by spelling
                // here loses module identity; its carrier contract belongs to
                // the projection variant, while `resultRef` is the already
                // selected source type.
                return carrierRef != 0U64 && resultRef != 0U64
            }
        }
    }

    // A CallSiteSelection is recorded on a shared generic source body.  Its
    // source result can therefore still be symbolic (`Buffer[T]` for the bare
    // qualifier in `Buffer.new()`) even though finalization has already chosen
    // the concrete callable instance (`Buffer[I64]`).  A final CallResolution
    // must never preserve that symbolic placeholder: its carrier is the one
    // concrete ABI result selected by `callee`/`recvRef`/`calleeArgs`.
    //
    // This is not expected-type recovery.  A ground source result remains
    // authoritative, including a deliberately different source result carried
    // by a closed projection.  Only an unresolved source term is replaced by
    // the already-selected carrier; if there is no carrier, the existing
    // validation below rejects the incomplete call.
    inout fn finalSelectedSourceResult(resultRef: U64, carrierRef: U64) -> U64 {
        if resultRef == 0U64 { return carrierRef }
        if self.tyRefIsGround(ref: resultRef) { return resultRef }
        return carrierRef
    }

    inout fn completeStaticBodyCallee(exprId: U64, callee: U64, recvRef: U64, calleeArgs: Array[U64], argumentSources: Array[CallTemplateArgument] = [], resultRef: U64 = 0U64, resultProjection: CallResultProjection = <CallResultProjection.Identity />, siteIsStmt: Bool = false, slot: U64 = 0U64, calleeBodyId: U64 = 0U64) {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        val params: Array[U64] = self.groundedSelectedCalleeParameterTypes(callee: callee, recvRef: recvRef, calleeArgs: calleeArgs)
        val conversions: Array[ValueConversionProof] = self.callArgumentConversions(sources: argumentSources, parameterTypeRefs: params)
        val receiverPassing: CallReceiverPassing = self.selectedReceiverPassing(callee: callee)
        val argumentPassings: Array[CallArgumentPassing] = self.selectedArgumentPassings(callee: callee)
        val carrierResult: U64 = self.groundedSelectedCalleeReturn(callee: callee, recvRef: recvRef, calleeArgs: calleeArgs)
        mut val result: U64 = self.finalSelectedSourceResult(resultRef: resultRef, carrierRef: carrierResult)
        val f: Func = self.arena.funcs[callee]
        if !(f.hasRet) {
            // Calls without a returned value have neither an ABI carrier nor a
            // source-observed result.  They may not carry a value projection:
            // a projection is a relationship between those two value types.
            match resultProjection {
                CallResultProjection.Identity => {}
                _ => {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: a no-result call cannot have a result projection")
                    return
                }
            }
            if resultRef != 0U64 {
                self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: a no-result call has a source result type")
                return
            }
            result = 0U64
        } else {
            if result == 0U64 || !(self.callResultProjectionIsValid(carrierRef: carrierResult, resultRef: result, projection: resultProjection)) {
                self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: final call result projection does not match its carrier or source result")
                return
            }
        }
        val target: CallTarget = self.runtimeIntrinsicTarget(callee: callee)
        if i < self.finalCalleeCount() {
            val prior: CallResolution = self.arena.finalCallees[i]
            if !(self.sameStaticCallResolution(e: prior, callee: callee, recvRef: recvRef, calleeArgs: calleeArgs, parameterTypeRefs: params, argumentConversions: conversions, receiverPassing: receiverPassing, argumentPassings: argumentPassings, resultRef: result, resultProjection: resultProjection, target: target)) {
                if siteIsStmt {
                    self.errorAt(offset: 0U64, msg: "internal error: conflicting static CallResolution publish")
                } else {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: conflicting static CallResolution publish")
                }
            }
            return
        }
        self.appendFinalCallee(exprId: exprId, callee: callee, siteIsStmt: siteIsStmt, slot: slot, recvTypeRef: recvRef, resultTypeRef: result, calleeTypeArgs: calleeArgs, parameterTypeRefs: params, argumentConversions: conversions, receiverPassing: receiverPassing, argumentPassings: argumentPassings, resultProjection: resultProjection, target: target, calleeBodyId: calleeBodyId)
        // A call result can be the sole reachable occurrence of a generic
        // layout (for example `val token: Token[String] = marker()`).  This
        // belongs to the completed CallResolution, not to an Expr.Method-only
        // AST walk: every static call publishes its selected result exactly
        // here, under the body environment that grounded the descriptor.
        if result != 0U64 { self.scanType(ref: result) }
    }

    // Extern lowering classified the declaration before call finalization. This
    // reader is deliberately source-free: it consumes the selected declaration
    // identity and never names an ABI operation itself.
    fn runtimeIntrinsicTarget(callee: U64) -> CallTarget {
        if callee >= self.arena.funcs.count() {
            return <CallTarget.Direct />
        }
        match self.arena.funcs[callee].runtimeIntrinsic {
            RuntimeIntrinsicDeclaration.None => {}
            RuntimeIntrinsicDeclaration.Bound(intrinsic: val intrinsic) => {
                return <CallTarget.RuntimeIntrinsic intrinsic=intrinsic />
            }
        }
        return <CallTarget.Direct />
    }

    fn callTargetIsDirect(target: CallTarget) -> Bool {
        match target {
            CallTarget.Direct => { return true }
            CallTarget.RuntimeIntrinsic(intrinsic: _) => { return true }
            _ => { return false }
        }
    }

    inout fn bodyCalleeTargetKind(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        return self.bodyCalleeTargetPart(exprId: exprId, part: 0U64, siteIsStmt: siteIsStmt, slot: slot)
    }

    inout fn bodyCalleeTargetTraitIdx(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        return self.bodyCalleeTargetPart(exprId: exprId, part: 1U64, siteIsStmt: siteIsStmt, slot: slot)
    }

    inout fn bodyCalleeTargetSlot(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        return self.bodyCalleeTargetPart(exprId: exprId, part: 2U64, siteIsStmt: siteIsStmt, slot: slot)
    }

    inout fn bodyCalleeTargetTypeRef(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        return self.bodyCalleeTargetPart(exprId: exprId, part: 3U64, siteIsStmt: siteIsStmt, slot: slot)
    }

    inout fn bodyCalleeBodyId(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() { return self.arena.finalCallees[i].calleeBodyId }
        return 0U64
    }

    inout fn bodyCalleeTargetBindingDeclStart(exprId: U64, siteIsStmt: Bool = false, slot: U64 = 0U64) -> U64 {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() {
            match self.arena.finalCallees[i].target {
                CallTarget.ClosureLocal(val bindingDeclStart, fnTypeRef: _) => { return bindingDeclStart }
                _ => {}
            }
        }
        return 0U64
    }

    inout fn bodyCalleeTargetPart(exprId: U64, part: U64, siteIsStmt: Bool, slot: U64) -> U64 {
        val i: U64 = self.bodyCalleeIndex(exprId: exprId, siteIsStmt: siteIsStmt, slot: slot)
        if i < self.finalCalleeCount() {
            val e: CallResolution = self.arena.finalCallees[i]
            match e.target {
                CallTarget.Direct => { if part == 0U64 { return 0U64 } }
                CallTarget.RuntimeIntrinsic(intrinsic: _) => { if part == 0U64 { return 0U64 } }
                CallTarget.NoCallable => { if part == 0U64 { return 4U64 } }
                CallTarget.ExistentialRequirement(val traitIdx, slot: val targetSlot) => {
                    if part == 0U64 { return 1U64 }
                    if part == 1U64 { return traitIdx }
                    if part == 2U64 { return targetSlot }
                }
                CallTarget.ClosureLocal(bindingDeclStart: _, val fnTypeRef) => {
                    if part == 0U64 { return 2U64 }
                    if part == 3U64 { return fnTypeRef }
                }
                CallTarget.ClosureField(val fieldIndex, val fnTypeRef) => {
                    if part == 0U64 { return 3U64 }
                    if part == 2U64 { return fieldIndex }
                    if part == 3U64 { return fnTypeRef }
                }
            }
        }
        return 0U64
    }

    // Same selector rule as witness-table construction: labels choose a trait
    // requirement; verification has already established its argument types.
    // Keeping it in Mono makes that choice part of the final-callable record.
    inout fn finalAnyRequirementSlot(anyRef: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> U64 {
        if anyRef == 0U64 || anyRef >= self.arena.types.count() { return 0U64 }
        val t: TypeRef = self.arena.types[anyRef]
        if !(t.isAny) { return 0U64 }
        val traitIdx: U64 = self.findTraitIdxByName(start: t.nameStart, len: t.nameLen)
        if traitIdx >= self.decls.traits.count() { return 0U64 }
        val nameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val tr: TraitDef = self.decls.traits[traitIdx]
        mut val ri: U64 = 0U64
        while ri < tr.reqs.count() {
            val req: Func = self.traitReqAt(reqs: tr.reqs, index: ri)
            if req.nameId == nameId && self.paramsLabelsOk(params: req.params, args: args) {
                return ri + 1U64
            }
            ri += 1U64
        }
        return 0U64
    }

    inout fn finalAnyTraitIdx(anyRef: U64) -> U64 {
        if anyRef == 0U64 || anyRef >= self.arena.types.count() { return self.decls.traits.count() }
        val t: TypeRef = self.arena.types[anyRef]
        if !(t.isAny) { return self.decls.traits.count() }
        return self.findTraitIdxByName(start: t.nameStart, len: t.nameLen)
    }

    // Source/implicit resolvers construct the whole dynamic call decision.
    // Finalization only copies this value into CallResolution; it never reopens
    // a shared expression or looks through an earlier descriptor.
    inout fn selectedClosureFieldCall(exprId: U64, callee: U64, recvRef: U64, resultHintRef: U64, nameStart: U64, nameLen: U64) -> CallSiteSelection {
        if recvRef == 0U64 || recvRef >= self.arena.types.count() { return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef /> }
        val rt: TypeRef = self.arena.types[recvRef]
        val sidx: U64 = self.structDefByNameAny(start: rt.nameStart, len: rt.nameLen)
        if sidx >= self.arena.structs.count() { return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef /> }
        val fieldName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val fi: U64 = 0U64
        while fi < self.arena.structs[sidx].fields.count() {
            if self.arena.structs[sidx].fields[fi].nameId == fieldName { break }
            fi += 1U64
        }
        if fi >= self.arena.structs[sidx].fields.count() { return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef /> }
        val fnRef: U64 = self.groundTypeRef(ref: self.arena.structs[sidx].fields[fi].ty)
        if fnRef != 0U64 && self.isFnType(ref: fnRef) {
            val fnTy: TypeRef = self.arena.types[fnRef]
            mut val resultRef: U64 = 0U64
            if fnTy.args.count() > 0U64 {
                resultRef = fnTy.args[0]
            }
            return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef resultRef=resultRef target=<CallTarget.ClosureField fieldIndex=fi fnTypeRef=fnRef /> />
        }
        return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef />
    }

    // Complete only generic slots that value arguments could not determine
    // from the call's already-selected result term. This is the ordinary
    // bidirectional case `val b: Buffer[I64] = Buffer.new()` and the wrapper
    // body `fn new[T]() -> Buffer[T] { bufferNew() }`: the result is semantic
    // call-site evidence, not a backend recovery or ambient expected-type
    // lookup.
    inout fn fillCalleeArgsFromResult(f: Func, args: Array[U64], resultRef: U64) -> Array[U64] {
        mut val out: Array[U64] = args
        if resultRef == 0U64 || resultRef >= self.arena.types.count() || f.retTy == 0U64 || f.retTy >= self.arena.types.count() {
            return out
        }
        while out.count() < f.typeParams.count() { out.append(0U64) }
        mut val i: U64 = 0U64
        while i < f.typeParams.count() {
            if out[i] == 0U64 || !(self.tyRefIsGround(ref: out[i])) {
                val p: Bind = self.funcBindAt(binds: f.typeParams, index: i)
                val inferred: U64 = self.unifyTypeParam(paramRef: f.retTy, argRef: resultRef, tpStart: p.nameStart, tpLen: p.nameLen)
                if inferred != 0U64 && self.tyRefIsGround(ref: inferred) {
                    out.set(i: i, value: inferred)
                }
            }
            i += 1U64
        }
        return out
    }

    inout fn selectBodyCall(exprId: U64, callee: U64, recvRef: U64, resultHintRef: U64) -> CallSiteSelection {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: val ns, nameLen: val nl, args: _) => {
                val li: U64 = self.localIndexByName(start: ns, len: nl)
                if li < self.cur.locals.count() {
                    val fnRef: U64 = self.groundTypeRef(ref: self.cur.locals[li].ty)
                    if fnRef != 0U64 && self.isFnType(ref: fnRef) {
                        val fnTy: TypeRef = self.arena.types[fnRef]
                        mut val resultRef: U64 = 0U64
                        if fnTy.args.count() > 0U64 { resultRef = fnTy.args[0] }
                        return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef resultRef=resultRef target=<CallTarget.ClosureLocal bindingDeclStart=self.cur.locals[li].nameStart fnTypeRef=fnRef /> />
                    }
                }
            }
            Expr.Method(recv: _, nameStart: val ns, nameLen: val nl, args: val args) => {
                if recvRef != 0U64 && recvRef < self.arena.types.count() && self.arena.types[recvRef].isAny {
                    val traitIdx: U64 = self.finalAnyTraitIdx(anyRef: recvRef)
                    val reqSlot: U64 = self.finalAnyRequirementSlot(anyRef: recvRef, nameStart: ns, nameLen: nl, args: args)
                    if traitIdx >= self.decls.traits.count() || reqSlot == 0U64 {
                        self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: existential call target was not finalized")
                    } else {
                        val req: Func = self.traitReqAt(reqs: self.decls.traits[traitIdx].reqs, index: reqSlot - 1U64)
                        return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef resultRef=self.anyMemberRetInfo(anyRef: recvRef, req: req).ref target=<CallTarget.ExistentialRequirement traitIdx=traitIdx slot=reqSlot /> />
                    }
                }
                val fieldSelection: CallSiteSelection = self.selectedClosureFieldCall(exprId: exprId, callee: callee, recvRef: recvRef, resultHintRef: resultHintRef, nameStart: ns, nameLen: nl)
                match fieldSelection.target { CallTarget.ClosureField(fieldIndex: _, fnTypeRef: _) => { return fieldSelection } _ => {} }
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: val ns, nameLen: val nl, args: val args) => {
                if recvRef != 0U64 && recvRef < self.arena.types.count() && self.arena.types[recvRef].isAny {
                    val traitIdx: U64 = self.finalAnyTraitIdx(anyRef: recvRef)
                    val reqSlot: U64 = self.finalAnyRequirementSlot(anyRef: recvRef, nameStart: ns, nameLen: nl, args: args)
                    if traitIdx < self.decls.traits.count() && reqSlot != 0U64 {
                        val req: Func = self.traitReqAt(reqs: self.decls.traits[traitIdx].reqs, index: reqSlot - 1U64)
                        return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=resultHintRef resultRef=self.anyMemberRetInfo(anyRef: recvRef, req: req).ref target=<CallTarget.ExistentialRequirement traitIdx=traitIdx slot=reqSlot /> />
                    }
                }
                val fieldSelection: CallSiteSelection = self.selectedClosureFieldCall(exprId: exprId, callee: callee, recvRef: recvRef, resultHintRef: resultHintRef, nameStart: ns, nameLen: nl)
                match fieldSelection.target { CallTarget.ClosureField(fieldIndex: _, fnTypeRef: _) => { return fieldSelection } _ => {} }
            }
            _ => {}
        }
        val expected: U64 = self.groundSemanticCallExpectedResult(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        val calleeArgs: Array[U64] = self.groundSemanticCallTypeArgs(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        return <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef args=self.selectedCallArgs(exprId: exprId) calleeTypeArgs=calleeArgs resultHintRef=expected resultRef=self.groundedTypeOf(id: exprId) />
    }

    // Extract source children exactly once at the resolver boundary.  The
    // static final builder receives this range and never pattern-matches Expr
    // to rediscover it. Operators have no call node, so this is also where
    // their two/one operand argument slices are materialized.
    inout fn selectedCallArgs(exprId: U64) -> ArgRange {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, val args) => { return args }
            Expr.Method(recv: _, nameStart: _, nameLen: _, val args) => { return args }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, val args) => { return args }
            Expr.Binary(op: _, val lhs, val rhs) => {
                val noLabel: Bind = self.kwSpan(kw: "", kwLen: 0U64)
                mut val args: Array[Arg] = []
                args.append(<Arg expr=lhs isInout=false labelStart=noLabel.nameStart labelLen=noLabel.nameLen hasLabel=false />)
                args.append(<Arg expr=rhs isInout=false labelStart=noLabel.nameStart labelLen=noLabel.nameLen hasLabel=false />)
                return self.pushArgs(args: args)
            }
            Expr.Unary(op: _, val operand) => {
                val noLabel: Bind = self.kwSpan(kw: "", kwLen: 0U64)
                mut val args: Array[Arg] = []
                args.append(<Arg expr=operand isInout=false labelStart=noLabel.nameStart labelLen=noLabel.nameLen hasLabel=false />)
                return self.pushArgs(args: args)
            }
            _ => {}
        }
        return <ArgRange start=0U64 len=0U64 />
    }

    inout fn selectedCallReceiverRef(exprId: U64) -> U64 {
        mut val si: U64 = 0U64
        while si < self.decls.syntheticCallSites.count() {
            val site: SyntheticCallSite = self.decls.syntheticCallSites[si]
            if site.exprId == exprId && site.receiverTerm != 0U64 {
                return self.groundBodyTerm(ref: site.receiverTerm)
            }
            si += 1U64
        }
        match self.arena.exprs[exprId] {
            Expr.Method(recv: val recv, nameStart: _, nameLen: _, args: _) => { return self.groundedBodyReceiverRef(exprId: recv) }
            Expr.ExtMethod(recv: val recv, source: _, nameStart: _, nameLen: _, args: _) => { return self.groundedBodyReceiverRef(exprId: recv) }
            _ => {}
        }
        return 0U64
    }

    // Build the finalizer input from a Direct CallTemplate alone. The ExprId
    // remains a navigation anchor for backend value emission, but callee,
    // receiver, argument shape, substitutions, and expected result all come
    // from frontend semantic facts recorded before BodyInstance finalization.
    inout fn selectDirectTemplateCall(exprId: U64, callee: U64, receiver: CallTemplateReceiver, arguments: Array[CallTemplateArgument], proof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> CallSiteSelection {
        val expected: U64 = self.groundSemanticCallExpectedResult(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        val calleeArgs: Array[U64] = self.groundSemanticCallTypeArgs(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        val receiverRef: U64 = self.groundCallTemplateReceiver(receiver: receiver)
        mut val concreteProof: StaticConformanceProof = proof
        // A Direct template has already selected its callable.  When that
        // callable is a provided copy, the template must nevertheless carry
        // the concrete conformance which makes the shared body meaningful.
        // Non-generic Record can legitimately have no symbolic proof to
        // preserve, so close that omission here from the selected copy's
        // placement identity and the already-ground receiver.  This is the
        // frontend's proof-construction boundary, not a backend re-selection:
        // the declaration and receiver were fixed by the template.
        if self.proofIsMissing(proof: concreteProof) && callee < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[callee]
            if f.isProvided {
                concreteProof = self.providedBodyProof(f: f, receiverRef: receiverRef)
            }
        }
        if !(self.proofIsMissing(proof: proof)) && callee < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[callee]
            if f.originTraitOwner != 0U64 {
                mut val traitIdx: U64 = 0U64
                while traitIdx < self.decls.traits.count() {
                    if self.decls.traits[traitIdx].nameStart == f.originTraitOwner && self.decls.traits[traitIdx].nameId == f.originTraitId {
                        concreteProof = self.concreteStaticMemberProof(proof: proof, traitIdx: traitIdx, receiverRef: receiverRef)
                    }
                    traitIdx += 1U64
                }
            }
        }
        val resultRef: U64 = self.groundSemanticExprTypeRef(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        return <CallSiteSelection exprId=exprId callee=callee receiverRef=receiverRef args=self.templateArgumentRange(arguments: arguments) argumentSources=arguments calleeTypeArgs=calleeArgs proof=concreteProof resultHintRef=expected resultRef=resultRef />
    }

    // Complete a dynamic call solely from its symbolic source template.  The
    // only per-instance operation is grounding the carried TypeTerm/receiver;
    // lexical lookup, field lookup, and existential requirement selection have
    // already happened in Record.
    inout fn selectDynamicTemplateCall(exprId: U64, receiver: CallTemplateReceiver, arguments: Array[CallTemplateArgument], target: DynamicCallTemplateTarget) -> CallSiteSelection {
        val expected: U64 = self.groundSemanticCallExpectedResult(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        val receiverRef: U64 = self.groundCallTemplateReceiver(receiver: receiver)
        val args: ArgRange = self.templateArgumentRange(arguments: arguments)
        val noCallee: U64 = self.arena.funcs.count()
        match target {
            DynamicCallTemplateTarget.ClosureLocal(bindingDeclStart: val bindingDeclStart, fnTypeTerm: val fnTypeTerm) => {
                val fnTypeRef: U64 = self.groundTermForBody(ref: fnTypeTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                if fnTypeRef == 0U64 || !(self.isFnType(ref: fnTypeRef)) {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: dynamic closure-local template did not ground to a function")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected />
                }
                val fnTy: TypeRef = self.arena.types[fnTypeRef]
                mut val resultRef: U64 = 0U64
                if fnTy.args.count() > 0U64 { resultRef = fnTy.args[0] }
                return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef target=<CallTarget.ClosureLocal bindingDeclStart=bindingDeclStart fnTypeRef=fnTypeRef /> />
            }
            DynamicCallTemplateTarget.ClosureField(fieldIndex: val fieldIndex, fnTypeTerm: val fnTypeTerm) => {
                val fnTypeRef: U64 = self.groundTermForBody(ref: fnTypeTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
                if fnTypeRef == 0U64 || !(self.isFnType(ref: fnTypeRef)) {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: dynamic closure-field template did not ground to a function")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected />
                }
                val fnTy: TypeRef = self.arena.types[fnTypeRef]
                mut val resultRef: U64 = 0U64
                if fnTy.args.count() > 0U64 { resultRef = fnTy.args[0] }
                return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef target=<CallTarget.ClosureField fieldIndex=fieldIndex fnTypeRef=fnTypeRef /> />
            }
            DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: val traitIdx, slot: val slot) => {
                if receiverRef == 0U64 || receiverRef >= self.arena.types.count() || traitIdx >= self.decls.traits.count() || slot == 0U64 || slot > self.decls.traits[traitIdx].reqs.count() {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: existential template has invalid receiver or requirement")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected />
                }
                val req: Func = self.traitReqAt(reqs: self.decls.traits[traitIdx].reqs, index: slot - 1U64)
                val resultRef: U64 = self.anyMemberRetInfo(anyRef: receiverRef, req: req).ref
                return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef target=<CallTarget.ExistentialRequirement traitIdx=traitIdx slot=slot /> />
            }
        }
    }

    // Ground a declaration-time trait requirement selected from a `where`
    // proof.  The requirement identity is carried by the template; the only
    // concrete lookup is its implementation on the already-ground receiver.
    // A provided trait body carries the exact concrete conformance that made
    // it callable in its BodyInstance.  Its nested `self.requirement()` must
    // retain that conformance's selected extension facet (`S#E` -> A), rather
    // than resolving from the bare receiver spelling.  The returned TypeRef
    // remains a value type; only the proof-selected source set is added.
    inout fn traitSelfBodyReceiver(ref: U64, requestedTraitOwner: U64) -> U64 {
        mut val conformIdx: U64 = 0U64
        match self.cur.bodyEnvironment.proof {
            StaticConformanceProof.ConcreteWitness(witness: val witness) => { conformIdx = witness.conformIdx }
            StaticConformanceProof.TraitPath(edges: _, terminalConformIdx: val terminal) => { conformIdx = terminal }
            _ => {}
        }
        if ref == 0U64 || conformIdx == 0U64 || conformIdx > self.decls.conforms.count() { return ref }
        val conform: Conform = self.decls.conforms[conformIdx - 1U64]
        // A selected extension path proves this body's terminal trait only.
        // It must not retag an unrelated subject-trait requirement in the
        // witness body: in `impl B as A { self.base() }`, E selects A while
        // `base` remains B's ordinary requirement. Conversely an A-provided
        // body calling `self.value()` must retain E, because A is the terminal
        // trait whose witness lives in that extension.
        if conform.extId != 0U64 && conform.traitStart == requestedTraitOwner {
            val additions: Array[ResolvedViewSource] = [<ResolvedViewSource surfaceId=conform.extId />]
            return self.typeRefWithAddedViewSources(ref: ref, additions: additions)
        }
        return ref
    }

    // Pick the proof edge that establishes one particular trait instance.
    // A trait-subject proof retains every edge: in `S: B` followed by
    // `B as A`, an A requirement uses the latter edge while `self.base()` in
    // its witness body uses the former.  Selecting the terminal unconditionally
    // loses that distinction and makes nested requirement dispatch impossible.
    inout fn bodyProofConformanceForTrait(traitIdx: U64) -> U64 {
        if traitIdx >= self.decls.traits.count() { return 0U64 }
        val requested: TraitDef = self.decls.traits[traitIdx]
        match self.cur.bodyEnvironment.proof {
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                if witness.conformIdx != 0U64 && witness.conformIdx <= self.decls.conforms.count() {
                    val conform: Conform = self.decls.conforms[witness.conformIdx - 1U64]
                    if conform.traitId == requested.nameId && conform.traitStart == requested.nameStart { return witness.conformIdx }
                }
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: _) => {
                // The path is ordered from the direct receiver conformance to
                // its derived target.  Each trait can occur at most once in a
                // validated acyclic proof, so its matching edge is exact.
                mut val edgeIdx: U64 = 0U64
                while edgeIdx < edges.count() {
                    val witness: WitnessMatch = edges[edgeIdx]
                    if witness.conformIdx != 0U64 && witness.conformIdx <= self.decls.conforms.count() {
                        val conform: Conform = self.decls.conforms[witness.conformIdx - 1U64]
                        if conform.traitId == requested.nameId && conform.traitStart == requested.nameStart { return witness.conformIdx }
                    }
                    edgeIdx += 1U64
                }
            }
            _ => {}
        }
        return 0U64
    }

    // Select a concrete member through the exact proof edge, not by
    // re-ranking the receiver surface.  The edge's witnessFuncIds names the
    // declaration which supplied the requirement; a trait-subject edge then
    // contributes one conferred copy with the same body/definition and the
    // selected path's source trait/extension identity.
    inout fn traitSelfConcreteWitness(traitIdx: U64, reqIdx: U64) -> U64 {
        if traitIdx >= self.decls.traits.count() || reqIdx >= self.decls.traits[traitIdx].reqs.count() { return self.arena.funcs.count() }
        val conformIdx: U64 = self.bodyProofConformanceForTrait(traitIdx: traitIdx)
        if conformIdx == 0U64 || conformIdx > self.decls.conforms.count() { return self.arena.funcs.count() }
        val conform: Conform = self.decls.conforms[conformIdx - 1U64]
        val req: Func = self.traitReqAt(reqs: self.decls.traits[traitIdx].reqs, index: reqIdx)
        mut val wi: U64 = 0U64
        while wi < conform.witnessFuncIds.count() {
            val sourceIdx: U64 = self.conformFuncIdAt(ids: conform.witnessFuncIds, index: wi)
            if sourceIdx < self.arena.funcs.count() {
                val source: Func = self.arena.funcs[sourceIdx]
                if source.nameId == req.nameId && source.params.count() == req.params.count() {
                    // A concrete impl owns its witness body directly.  The
                    // proof's witnessFuncIds is already the exact semantic
                    // selection, so do not require an imaginary provided
                    // copy merely because another edge in the enclosing path
                    // is trait-subject.  Trait-subject witnesses themselves
                    // still need the conferred copy below: their receiver is
                    // abstract (for example `impl B as A`) and cannot be
                    // emitted for S without the preceding S-as-B edge.
                    if !(self.methodRecvIsTrait(f: source)) && source.originTraitId == self.decls.traits[traitIdx].nameId && source.originTraitOwner == self.decls.traits[traitIdx].nameStart {
                        return sourceIdx
                    }
                    mut val ci: U64 = 0U64
                    while ci < self.arena.funcs.count() {
                        val candidate: Func = self.arena.funcs[ci]
                        // A trait-subject witness is emitted only through the
                        // copy conferred by this exact proof edge.  The copy's
                        // sourceConformIdx is the stable source-edge identity; it is
                        // stronger than matching receiver spelling, extension
                        // name, or srcTraitId (the latter denotes the edge's
                        // target trait, not its subject).  This keeps a
                        // B-as-A witness distinct from another A witness that
                        // happens to have the same member name.
                        if candidate.isProvided && candidate.sourceWitnessFuncId == sourceIdx + 1U64 && candidate.sourceConformIdx == conformIdx && candidate.originTraitId == self.decls.traits[traitIdx].nameId && candidate.originTraitOwner == self.decls.traits[traitIdx].nameStart {
                            return ci
                        }
                        ci += 1U64
                    }
                }
            }
            wi += 1U64
        }
        return self.arena.funcs.count()
    }

    inout fn selectStaticMethodTemplateCall(exprId: U64, receiver: CallTemplateReceiver, arguments: Array[CallTemplateArgument], resolution: StaticMemberResolution, resultTerm: U64) -> CallSiteSelection {
        val noCallee: U64 = self.arena.funcs.count()
        val receiverRef: U64 = self.groundCallTemplateReceiver(receiver: receiver)
        val args: ArgRange = self.templateArgumentRange(arguments: arguments)
        val expected: U64 = self.groundSemanticCallExpectedResult(exprId: exprId, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        mut val resultRef: U64 = self.groundTermForBody(ref: resultTerm, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        if resultRef == 0U64 { resultRef = expected }
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIdx, reqIdx: val reqIdx) => {
                if receiverRef == 0U64 || receiverRef >= self.arena.types.count() || traitIdx >= self.decls.traits.count() || reqIdx >= self.decls.traits[traitIdx].reqs.count() {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static method template has invalid proof or receiver")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
                }
                val req: Func = self.traitReqAt(reqs: self.decls.traits[traitIdx].reqs, index: reqIdx)
                mut val callee: U64 = self.arena.funcs.count()
                match proof {
                    StaticConformanceProof.TraitSelf(traitIdx: _, receiverRef: _, traitArgs: _) => {
                        callee = self.traitSelfConcreteWitness(traitIdx: traitIdx, reqIdx: reqIdx)
                        if callee >= self.arena.funcs.count() {
                            val proofReceiver: U64 = self.traitSelfBodyReceiver(ref: receiverRef, requestedTraitOwner: self.decls.traits[traitIdx].nameStart)
                            val proofSource: U64 = if proofReceiver != receiverRef && proofReceiver < self.arena.types.count() { give self.arena.types[proofReceiver].viewExtId } else { give 0U64 }
                            if req.isAssoc {
                                callee = self.resolveAssocForResolvedReceiver(surfaceRef: proofReceiver, sourceId: proofSource, sourceOwner: proofSource, nameStart: req.nameStart, nameLen: req.nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                            } else {
                                callee = self.resolveMethodForResolvedReceiver(recv: 0U64, surfaceRef: proofReceiver, sourceId: proofSource, sourceOwner: proofSource, nameStart: req.nameStart, nameLen: req.nameLen, args: args, useOffset: self.exprOffset(id: exprId), readReceiverSyntax: false)
                            }
                        }
                    }
                    _ => {
                        if req.isAssoc {
                            callee = self.resolveAssocForResolvedReceiver(surfaceRef: receiverRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: req.nameStart, nameLen: req.nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                        } else {
                            callee = self.resolveMethodForResolvedReceiver(recv: 0U64, surfaceRef: receiverRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: req.nameStart, nameLen: req.nameLen, args: args, useOffset: self.exprOffset(id: exprId), readReceiverSyntax: false)
                        }
                    }
                }
                if callee >= self.arena.funcs.count() {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static method proof has no concrete implementation")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
                }
                val f: Func = self.arena.funcs[callee]
                if f.originTraitId != self.decls.traits[traitIdx].nameId || f.originTraitOwner != self.decls.traits[traitIdx].nameStart {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static method selected a callable outside its proved trait")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
                }
                return <CallSiteSelection exprId=exprId callee=callee receiverRef=receiverRef args=args argumentSources=arguments proof=self.concreteStaticMemberProof(proof: proof, traitIdx: traitIdx, receiverRef: receiverRef) resultHintRef=expected resultRef=resultRef target=<CallTarget.Direct /> />
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: val traitIdx, callee: val declaration) => {
                if receiverRef == 0U64 || receiverRef >= self.arena.types.count() || traitIdx >= self.decls.traits.count() || declaration >= self.arena.funcs.count() {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static provided-method template has invalid proof or receiver")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
                }
                val declared: Func = self.arena.funcs[declaration]
                val callee: U64 = if declared.isAssoc {
                    give self.resolveAssocForResolvedReceiver(surfaceRef: receiverRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: declared.nameStart, nameLen: declared.nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                } else {
                    give self.resolveMethodForResolvedReceiver(recv: 0U64, surfaceRef: receiverRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: declared.nameStart, nameLen: declared.nameLen, args: args, useOffset: self.exprOffset(id: exprId), readReceiverSyntax: false)
                }
                if callee >= self.arena.funcs.count() {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static provided-method proof has no concrete implementation")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
                }
                val f: Func = self.arena.funcs[callee]
                if f.originTraitId != self.decls.traits[traitIdx].nameId || f.originTraitOwner != self.decls.traits[traitIdx].nameStart {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static provided method selected a callable outside its proved trait")
                    return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
                }
                if resultRef == 0U64 { resultRef = self.groundedSelectedCalleeReturn(callee: callee, recvRef: receiverRef, calleeArgs: []) }
                return <CallSiteSelection exprId=exprId callee=callee receiverRef=receiverRef args=args argumentSources=arguments proof=self.concreteStaticMemberProof(proof: proof, traitIdx: traitIdx, receiverRef: receiverRef) resultHintRef=expected resultRef=resultRef target=<CallTarget.Direct /> />
            }
            _ => {}
        }
        self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: static method template has no requirement")
        return <CallSiteSelection exprId=exprId callee=noCallee receiverRef=receiverRef args=args resultHintRef=expected resultRef=resultRef />
    }

    // Resolve once under Mono's concrete body environment, then retain that
    // decision for every downstream consumer (instance registration, type
    // recovery, and LLVM emission).
    inout fn resolveBodyCallee(exprId: U64) -> U64 {
        // An OptChain rewrite manufactures associated factory calls after the
        // written program was resolved.  Their ChainSite entry is therefore
        // the semantic call-resolution template.  Ground only its receiver
        // term under this body instance, then use the normal CallResolution /
        // reachability machinery; do not re-run name lookup on `Head.empty`.
        val chainTemplate: U64 = self.chainImplicitCallee(exprId: exprId)
        if chainTemplate < self.arena.funcs.count() {
            val stageTerm: U64 = self.chainImplicitStageRef(exprId: exprId)
            val stageRef: U64 = self.groundTypeRef(ref: stageTerm)
            // A generic declaration's AST is visited before any concrete body
            // instance exists.  Its Chain template is semantic evidence, not
            // an emittable call: wait until the body environment grounds the
            // stage.  Recording `Optional[T].empty()` here would leak a
            // symbolic descriptor into the final-call table and make LLVM see
            // a factory with an unfilled T.
            if stageRef == 0U64 || !(self.tyRefIsGround(ref: stageRef)) {
                return self.arena.funcs.count()
            }
            self.materializeImplicitAssocTemplate(exprId: exprId, callee: chainTemplate, recvRef: stageRef)
            return chainTemplate
        }
        val template: CallTemplate = self.callTemplateForCurrentBody(exprId: exprId)
        // A written static call was selected during Record. Its Direct
        // template is authoritative for the concrete BodyInstance: reopening
        // Expr.Call/Method/ExtMethod here would duplicate candidate selection
        // and lose a receiver/result dependency carried by CallSiteKey.
        match template.kind {
            CallTemplateKind.Direct(callee: val storedCallee, receiver: val receiver, args: val arguments, calleeTypeArgs: _, proof: val proof) => {
                if storedCallee < self.arena.funcs.count() {
                    val selection: CallSiteSelection = self.selectDirectTemplateCall(exprId: exprId, callee: storedCallee, receiver: receiver, arguments: arguments, proof: proof)
                    self.recordSelectedBodyCallee(selection: selection)
                    self.enqueueSelectedCallee(selection: selection)
                    return storedCallee
                }
            }
            CallTemplateKind.Dynamic(receiver: val receiver, args: val arguments, target: val target) => {
                val selection: CallSiteSelection = self.selectDynamicTemplateCall(exprId: exprId, receiver: receiver, arguments: arguments, target: target)
                self.recordSelectedBodyCallee(selection: selection)
                return selection.callee
            }
            CallTemplateKind.StaticMethod(receiver: val receiver, args: val arguments, resolution: val resolution, resultTerm: val resultTerm) => {
                val selection: CallSiteSelection = self.selectStaticMethodTemplateCall(exprId: exprId, receiver: receiver, arguments: arguments, resolution: resolution, resultTerm: resultTerm)
                self.recordSelectedBodyCallee(selection: selection)
                self.enqueueSelectedCallee(selection: selection)
                return selection.callee
            }
            _ => {}
        }
        if self.callTemplatesClosed {
            // Instance discovery precedes Record and may inspect the syntax to
            // enqueue reachable generic bodies.  It does not publish a call
            // descriptor.  After Record closes templates, however, reopening
            // a written call here would permit a BodyInstance to select a
            // different lexical target, field, trait slot, or view.
            if self.traceCodegen {
                eprint(text: "[trace-codegen] missing CallTemplate body=")
                eprintU64(n: self.cur.bodyFnIdx)
                eprint(text: " expr=")
                eprintU64(n: exprId)
                eprint(text: " offset=")
                eprintU64(n: self.exprOffset(id: exprId))
                eprint(text: " owner=")
                eprintU64(n: self.callTemplateBodyOwner(fnIdx: self.cur.bodyFnIdx))
                eprint(text: "\n")
            }
            self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal error: written call CallTemplate was not recorded")
            return self.arena.funcs.count()
        }
        // Non-generic verification may provide an instance-invariant final
        // callable, including generic free-call substitutions.  Keep that
        // descriptor: it is the call-site authority consumed by Mono and LLVM.
        // Its view choice is safe to reuse because overload matching itself
        // compares an explicit argument `#` source set before filling this
        // cache (rather than relying on a backend-only mismatch check).
        // Generic/provided bodies still resolve under their concrete instance
        // environment below.
        mut val bodyIsProvided: Bool = false
        if self.cur.bodyFnIdx < self.arena.funcs.count() {
            bodyIsProvided = self.arena.funcs[self.cur.bodyFnIdx].isProvided
        }
        if !bodyIsProvided && self.cur.bodyEnvironment.params.count() == 0U64 && exprId < self.typeCache.callee.count() {
            if self.typeCache.callee[exprId] != calleeUnfilled() && self.typeCache.callee[exprId] < self.arena.funcs.count() {
                val cached: U64 = self.typeCache.callee[exprId]
                val recvRef: U64 = self.selectedCallReceiverRef(exprId: exprId)
                val selection: CallSiteSelection = self.selectBodyCall(exprId: exprId, callee: cached, recvRef: recvRef, resultHintRef: self.selectedResultHint(callee: cached))
                self.recordSelectedBodyCallee(selection: selection)
                self.enqueueSelectedCallee(selection: selection)
                return cached
            }
        }
        mut val callee: U64 = self.arena.funcs.count()
        // A resolved receiver is part of a final call decision. In particular,
        // an OptChain desugar replaces its hole with a synthetic local whose
        // source spelling cannot be re-resolved after the rewrite.
        mut val resolvedReceiverRef: U64 = 0U64
        match self.arena.exprs[exprId] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val localIdx: U64 = self.localIndexByName(start: nameStart, len: nameLen)
                if localIdx >= self.cur.locals.count() || !(self.isFnType(ref: self.groundTypeRef(ref: self.cur.locals[localIdx].ty))) {
                    callee = self.findFunc(nameStart: nameStart, nameLen: nameLen, args: args)
                }
                // `pow(base:, exp:)` is source sugar for the selected Pow
                // associated callable.  Select it here with every other call;
                // LLVM must never rediscover it from the base expression.
                if callee >= self.arena.funcs.count() {
                    if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "pow") && args.len == 2U64 {
                        val baseRef: U64 = self.groundedBodyReceiverRef(exprId: self.argAt(args: args, index: 0U64).expr)
                        if baseRef != 0U64 && baseRef < self.arena.types.count() {
                            val baseTy: TypeRef = self.arena.types[baseRef]
                            callee = self.findAssoc(recvStart: baseTy.nameStart, recvLen: baseTy.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                        }
                    }
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // Factories (`<Type.name …/>`) are rewritten to Expr.Method so
                // they share the AST surface with value methods.  They are still
                // associated callables: decide that here, while source scope and
                // type-name identity are available, then retain the Func in the
                // same final-callable table as every other call.
                val assocRecv: Bind = self.assocRecvName(recv: recv)
                if assocRecv.nameLen != 0U64 {
                    // A lowering-created associated call can carry an exact
                    // receiver template even though its AST qualifier is the
                    // bare type name.  Preserve that selection through the
                    // same CallSiteSelection used by written methods.
                    resolvedReceiverRef = self.selectedCallReceiverRef(exprId: exprId)
                    callee = self.findAssoc(recvStart: assocRecv.nameStart, recvLen: assocRecv.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                } else {
                    val recvRef: U64 = self.groundedBodyReceiverRef(exprId: recv)
                    resolvedReceiverRef = recvRef
                    if recvRef != 0U64 && recvRef < self.arena.types.count() {
                        if rangeEquals(bytes: self.arena.bytes, start: self.arena.types[recvRef].nameStart, len: self.arena.types[recvRef].nameLen, kw: "Self") {
                            self.errorAt(offset: nameStart, msg: "internal diagnostic: final method receiver remained Self after body substitution")
                        }
                    }
                    // A selected outer conformance path does not flow into a
                    // shared witness body. Resolve `self.m()` from the body's
                    // lexical receiver surface; multiple concrete witnesses are
                    // therefore an ordinary ambiguity at this source call.
                    callee = self.resolveBodyMethodForRef(recv: recv, recvRef: recvRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                    if callee >= self.arena.funcs.count() {
                        callee = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
                    }
                    // Some compiler-internal aggregate fields expose their precise
                    // `Array[E]` ref only through the parametric type table.  This
                    // is still Mono resolution (never backend recovery): use that
                    // concrete receiver to finish the same final-callable query.
                    if callee >= self.arena.funcs.count() {
                        val recvRef: U64 = self.groundedBodyReceiverRef(exprId: recv)
                        if recvRef != 0U64 && recvRef < self.arena.types.count() {
                            val recvTy: TypeRef = self.arena.types[recvRef]
                            callee = self.findMethod(recvStart: recvTy.nameStart, recvLen: recvTy.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef, useOffset: self.exprOffset(id: exprId))
                        }
                    }
                    if self.traceCodegen && callee >= self.arena.funcs.count() {
                        eprint(text: "[trace-codegen] unresolved method expr=")
                        eprintU64(n: exprId)
                        eprint(text: " offset=")
                        eprintU64(n: self.exprOffset(id: exprId))
                        eprint(text: " body=")
                        eprintU64(n: self.cur.bodyFnIdx)
                        eprint(text: " receiver=")
                        self.traceMonoTypeHead(ref: recvRef)
                        if recvRef < self.arena.types.count() {
                            eprint(text: " any=")
                            if self.arena.types[recvRef].isAny { eprint(text: "1") } else { eprint(text: "0") }
                            eprint(text: " param=")
                            eprintU64(n: self.arena.types[recvRef].paramId)
                        }
                        eprint(text: "\n")
                    }
                }
            }
            Expr.ExtMethod(val recv, val source, val nameStart, val nameLen, val args) => {
                val recvRef: U64 = self.groundedBodyReceiverRef(exprId: recv)
                resolvedReceiverRef = recvRef
                val sourceId: U64 = source.surfaceId
                callee = self.resolveBodyMethodForRef(recv: recv, recvRef: recvRef, sourceId: sourceId, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                if callee >= self.arena.funcs.count() {
                    val sourceSpan: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
                    callee = self.resolveExtMethodFinal(recv: recv, srcStart: sourceSpan.start, srcLen: sourceSpan.len, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args)
                }
            }
            _ => {}
        }
        match self.arena.exprs[exprId] {
            Expr.Method(recv: _, val nameStart, val nameLen, args: _) => {
                if callee >= self.arena.funcs.count() {
                    if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "compare") {
                        self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: implicit compare was not resolved during finalization")
                    }
                }
            }
            _ => {}
        }
        val selection: CallSiteSelection = self.selectBodyCall(exprId: exprId, callee: callee, recvRef: resolvedReceiverRef, resultHintRef: self.selectedResultHint(callee: callee))
        self.recordSelectedBodyCallee(selection: selection)
        self.enqueueSelectedCallee(selection: selection)
        return callee
    }

    // Access writeback is reachable only through a parent call whose selected
    // ABI consumes an indexed receiver/argument as `inout`. Resolve the
    // detached setter facet while that parent body instance is active: this
    // consumes the Record-published template and joins its callee body to the
    // ordinary final-callable worklist, without a post-freeze name lookup.
    inout fn finalizeAccessWriteFacets(parentExpr: U64) {
        val parent: CallSiteKey = self.currentCallSiteKey(exprId: parentExpr, siteIsStmt: false, slot: 0U64)
        mut val useIndex: U64 = 0U64
        while useIndex < self.decls.accessUses.count() {
            val use: AccessUse = self.decls.accessUses[useIndex]
            if use.write && self.sameCallSiteKey(a: parent, b: use.parent) {
                if use.candidateIndex < self.decls.accessCandidates.count() {
                    val writeExpr: U64 = self.decls.accessCandidates[use.candidateIndex].writeExpr
                    if writeExpr < self.arena.exprs.count() {
                        self.resolveBodyCallee(exprId: writeExpr)
                        // A detached setter is itself an ordinary selected call.
                        // If its receiver is another indexed read, it owns the
                        // inner writeback edge. Close that edge here rather than
                        // depending on executable AST traversal (the setter has
                        // none), yielding one finite call/access closure.
                        self.finalizeAccessWriteFacets(parentExpr: writeExpr)
                    }
                }
            }
            useIndex += 1U64
        }
    }

    // Turn one declaration-time implicit associated-call template into the
    // concrete final decision for the active BodyInstance.  Unlike a written
    // source call, a template has already selected both callable and subject;
    // consulting its shared synthetic AST would reintroduce `Head[T]` and lose
    // the concrete receiver.  This is the narrow first consumer of the wider
    // CallResolution-template contract: selected callee + receiver term yield
    // a complete CallResolution without a second inference pass.
    inout fn materializeImplicitAssocTemplate(exprId: U64, callee: U64, recvRef: U64) {
        self.recordSelectedBodyCallee(selection: <CallSiteSelection exprId=exprId callee=callee receiverRef=recvRef resultHintRef=recvRef />)
        if callee >= self.arena.funcs.count() || recvRef == 0U64 || recvRef >= self.arena.types.count() {
            return
        }
        val f: Func = self.arena.funcs[callee]
        if !(f.isAssoc) {
            self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: implicit call template selected a non-associated callable")
            return
        }
        val args: Array[U64] = self.arena.types[recvRef].args
        if args.count() != f.typeParams.count() || !(self.fnArgsAllGround(args: args)) {
            self.errorAt(offset: self.exprOffset(id: exprId), msg: "internal diagnostic: implicit associated call template has no complete receiver substitution")
            return
        }
        self.completeStaticBodyCallee(exprId: exprId, callee: callee, recvRef: recvRef, calleeArgs: args)
        self.enqueueFinalBody(fnIdx: callee, args: args, recvInstRef: recvRef)
        self.enqueueSelectedAssocInstance(callee: callee, args: args, recvInstRef: recvRef)
        self.enqueueSelectedFreeInstance(callee: callee, args: args)
    }

    // Walk one already-selected concrete body instance.  It is the frontend
    // analogue of genLlvmFuncBody's environment setup: the same function args,
    // receiver instance, and Self/Item binding are installed before resolving
    // nested calls.  This is the only place generic bodies acquire their
    // instance-specific final-callable entries.
    inout fn scanFinalBodyInstance(bodyId: U64) {
        if self.tracePhases {
            self.traceFinalBodyScans += 1U64
            tracePhaseProgress(c: inout self, label: "finalize-callables:body", count: self.traceFinalBodyScans, stride: 16U64)
        }
        val instance: BodyInstance = self.arena.bodyInstances[bodyId - 1U64]
        val f: Func = self.arena.funcs[instance.fnIdx]
        // Shared provided bodies are keyed by concrete conformance proof as
        // well as receiver. Keep that key observable in trace mode: it is the
        // shortest diagnostic for a descriptor written for one witness and
        // read from another, without affecting the normal compilation path.
        if self.traceCodegen && f.isProvided {
            mut val name: Array[U8] = []
            mut val ni: U64 = 0U64
            while ni < f.nameLen {
                name.append(self.arena.bytes[f.nameStart + ni])
                ni += 1U64
            }
            eprint(text: "[trace-codegen] scan provided body=")
            eprint(text: stringFromBytesUnchecked(name))
            eprint(text: " fn=")
            eprint(text: digitStrU(d: instance.fnIdx))
            eprint(text: " body=")
            eprint(text: digitStrU(d: bodyId))
            eprint(text: " receiver=")
            self.traceMonoTypeHead(ref: instance.environment.receiverRef)
            eprint(text: "\n")
        }
        self.cur.locals = []
        self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: f))
        self.cur.hasRecv = f.hasRecv
        self.cur.recvStart = f.recvStart
        self.cur.recvLen = f.recvLen
        self.cur.extId = f.extId
        self.cur.selfInout = f.selfInout
        self.cur.recvInstRef = instance.environment.receiverRef
        self.cur.typeParams = instance.environment.params
        self.cur.typeArgs = instance.environment.args
        self.enterBodyInstance(fnIdx: instance.fnIdx, environment: instance.environment)
        // Associated callables have no value `self`, but their bodies may name
        // `Self`/associated types and their final-callable key is the concrete
        // subject selected at the call.  Mirror emitOneGenFn's assoc environment
        // here so Mono and LLVM use the same body-instance identity.
        if f.hasRecv || f.isAssoc {
            self.setSelfItemEnvForBody(f: f, environment: instance.environment)
        } else {
            self.clearSelfItemEnv()
        }
        // The worklist already carries the canonical receiver key.  Do not
        // rebuild it from `self` here: that would make finalization and backend
        // emission independently responsible for preserving source views.
        if self.cur.bodyEnvironment.receiverRef != 0U64 { self.cur.selfRef = self.cur.bodyEnvironment.receiverRef }
        self.cur.bodySelfRef = self.cur.selfRef
        self.cur.bodyItemRef = self.cur.itemRef
        // A body instance owns every concrete layout named by its ABI, even
        // when the source body never reads that parameter or return value.
        // This is deliberately beside the final semantic call closure: the
        // old provisional AST collector discovered these as an incidental
        // side effect before it later discarded its call decisions.
        mut val pi: U64 = 0U64
        while pi < f.params.count() {
            val p: Param = self.funcParamAt(params: f.params, index: pi)
            self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
            self.scanType(ref: p.ty)
            pi += 1U64
        }
        if f.hasRet { self.scanType(ref: f.retTy) }
        self.scanBlockInsts(blkId: f.body)
        if f.hasRecv || f.isAssoc { self.clearSelfItemEnv() }
    }

    // Trace the instance fan-out by callable, not merely its total. The normal
    // compilation path does not allocate this summary or inspect the body table.
    inout fn traceFinalBodyInstanceSummary() {
        if !(self.tracePhases) { return }
        mut val counts: Array[U64] = []
        mut val fi: U64 = 0U64
        while fi < self.arena.funcs.count() {
            counts.append(0U64)
            fi += 1U64
        }
        mut val bi: U64 = 0U64
        while bi < self.arena.bodyInstances.count() {
            val fnIdx: U64 = self.arena.bodyInstances[bi].fnIdx
            if fnIdx < counts.count() {
                counts[fnIdx] = counts[fnIdx] + 1U64
            }
            bi += 1U64
        }
        mut val rank: U64 = 0U64
        while rank < 12U64 {
            mut val bestFn: U64 = counts.count()
            mut val bestCount: U64 = 0U64
            fi = 0U64
            while fi < counts.count() {
                if counts[fi] > bestCount {
                    bestFn = fi
                    bestCount = counts[fi]
                }
                fi += 1U64
            }
            if bestCount == 0U64 { return }
            val f: Func = self.arena.funcs[bestFn]
            mut val nameBytes: Array[U8] = []
            mut val ni: U64 = 0U64
            while ni < f.nameLen {
                nameBytes.append(self.arena.bytes[f.nameStart + ni])
                ni += 1U64
            }
            eprint(text: "[trace-phase] finalize-callables:body-fn ")
            eprint(text: stringFromBytesUnchecked(nameBytes))
            eprint(text: "=")
            traceU64(n: bestCount)
            eprint(text: "\n")
            counts[bestFn] = 0U64
            rank += 1U64
        }
    }

    // A static CallResolution is the concrete semantic hand-off to lowering.
    // It is invalid for a generic declaration to reach LLVM with a symbolic
    // substitution, ABI parameter, receiver, or result still missing. Dynamic
    // calls have a different, already-selected target carrier and are checked
    // when that carrier is made into a sum type.
    inout fn finalStaticCalleeIsComplete(e: CallResolution) -> Bool {
        if !(self.callTargetIsDirect(target: e.target)) || e.callee >= self.arena.funcs.count() {
            return true
        }
        val f: Func = self.arena.funcs[e.callee]
        if e.calleeTypeArgs.count() != f.typeParams.count() {
            return false
        }
        // `fnArgsAllGround([])` intentionally returns false: callers use it
        // to distinguish absent generic inference from a real substitution.
        // A non-generic callable is nevertheless complete with zero args.
        if f.typeParams.count() > 0U64 && !(self.fnArgsAllGround(args: self.copyFinalCalleeTypeArgs(args: e.calleeTypeArgs))) {
            return false
        }
        if e.parameterTypeRefs.count() != f.params.count() {
            return false
        }
        if (f.hasRecv || f.isAssoc) && e.recvTypeRef == 0U64 {
            return false
        }
        if f.hasRet && e.resultTypeRef == 0U64 {
            return false
        }
        return true
    }

    inout fn traceIncompletePublishedStaticCallee(e: CallResolution) {
        if !(self.traceCodegen) { return }
        eprint(text: "[trace-codegen] incomplete published static call body=")
        eprint(text: digitStrU(d: e.bodyId))
        eprint(text: " expr=")
        eprint(text: digitStrU(d: e.exprId))
        eprint(text: " callee=")
        eprint(text: digitStrU(d: e.callee))
        if e.callee < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[e.callee]
            mut val name: Array[U8] = []
            mut val nameI: U64 = 0U64
            while nameI < f.nameLen {
                name.append(self.arena.bytes[f.nameStart + nameI])
                nameI += 1U64
            }
            eprint(text: " name=")
            eprint(text: stringFromBytesUnchecked(name))
            eprint(text: " needsRecv=")
            if f.hasRecv || f.isAssoc { eprint(text: "1") } else { eprint(text: "0") }
            eprint(text: " declaredParams=")
            eprint(text: digitStrU(d: f.params.count()))
        }
        eprint(text: " args=")
        eprint(text: digitStrU(d: e.calleeTypeArgs.count()))
        eprint(text: " params=")
        eprint(text: digitStrU(d: e.parameterTypeRefs.count()))
        eprint(text: " recv=")
        eprint(text: digitStrU(d: e.recvTypeRef))
        eprint(text: " result=")
        eprint(text: digitStrU(d: e.resultTypeRef))
        eprint(text: "\n")
    }

    // The frontend worklist is the only producer of final call descriptors.
    // Run this immediately before it freezes, while a violation can still be
    // attributed to a call-site instead of becoming a backend recovery path.
    inout fn verifyFinalCallResolutions() {
        mut val i: U64 = 0U64
        while i < self.finalCalleeCount() {
            val e: CallResolution = self.arena.finalCallees[i]
            if !(self.finalStaticCalleeIsComplete(e: e)) {
                self.traceIncompletePublishedStaticCallee(e: e)
                if e.siteIsStmt {
                    self.errorAt(offset: 0U64, msg: "internal error: frontend published an incomplete static CallResolution")
                } else {
                    self.errorAt(offset: self.exprOffset(id: e.exprId), msg: "internal error: frontend published an incomplete static CallResolution")
                }
            }
            i += 1U64
        }
    }

    // Find the body-instance resolution of an AccessCandidate's synthetic
    // Index.index read. The candidate and its parent were recorded from the
    // same lexical source body, so the parent's normalized owner is the
    // canonical origin namespace for the synthetic read as well.
    inout fn finalAccessReadResolution(bodyId: U64, candidateIndex: U64, parent: CallResolution) -> U64 {
        if candidateIndex >= self.decls.accessCandidates.count() { return self.finalCalleeCount() }
        val candidate = self.decls.accessCandidates[candidateIndex]
        val readKey: CallSiteKey = self.templateCallSiteKey(fnIdx: parent.siteKey.ownerFnIdx, exprId: candidate.readExpr)
        mut val i: U64 = 0U64
        while i < self.finalCalleeCount() {
            val resolved: CallResolution = self.arena.finalCallees[i]
            if resolved.bodyId == bodyId && self.sameCallSiteKey(a: resolved.siteKey, b: readKey) {
                return i
            }
            i += 1U64
        }
        return self.finalCalleeCount()
    }

    inout fn finalAccessWriteResolution(bodyId: U64, candidateIndex: U64, parent: CallResolution) -> U64 {
        if candidateIndex >= self.decls.accessCandidates.count() { return self.finalCalleeCount() }
        val candidate = self.decls.accessCandidates[candidateIndex]
        val writeKey: CallSiteKey = self.templateCallSiteKey(fnIdx: parent.siteKey.ownerFnIdx, exprId: candidate.writeExpr)
        mut val i: U64 = 0U64
        while i < self.finalCalleeCount() {
            val resolved: CallResolution = self.arena.finalCallees[i]
            if resolved.bodyId == bodyId && self.sameCallSiteKey(a: resolved.siteKey, b: writeKey) {
                return i
            }
            i += 1U64
        }
        return self.finalCalleeCount()
    }

    // Freeze storage provenance only after the final-callable worklist has
    // reached a fixpoint. This joins two already-selected calls; it neither
    // names Index/IndexSet nor asks the type checker to resolve a second
    // callable. Unreached source candidates intentionally produce no entry.
    inout fn freezeFinalAccesses() {
        self.arena.semanticAccesses = []
        mut val parentIndex: U64 = 0U64
        while parentIndex < self.finalCalleeCount() {
            val parent: CallResolution = self.arena.finalCallees[parentIndex]
            mut val useIndex: U64 = 0U64
            while useIndex < self.decls.accessUses.count() {
                val use = self.decls.accessUses[useIndex]
                if self.sameCallSiteKey(a: parent.siteKey, b: use.parent) {
                    val readResolution: U64 = self.finalAccessReadResolution(bodyId: parent.bodyId, candidateIndex: use.candidateIndex, parent: parent)
                    if readResolution >= self.finalCalleeCount() {
                        self.errorAt(offset: self.exprOffset(id: parent.exprId), msg: "internal error: access candidate read has no final CallResolution")
                    } else {
                        mut val writeResolution: U64 = self.finalCalleeCount()
                        if use.write {
                            writeResolution = self.finalAccessWriteResolution(bodyId: parent.bodyId, candidateIndex: use.candidateIndex, parent: parent)
                            if writeResolution >= self.finalCalleeCount() {
                                self.errorAt(offset: self.exprOffset(id: parent.exprId), msg: "internal error: access candidate write has no final CallResolution")
                            }
                        }
                        val candidate = self.decls.accessCandidates[use.candidateIndex]
                        match self.arena.exprs[candidate.placeExpr] {
                            Expr.Index(base: val baseExpr, index: val keyExpr) => {
                                val baseTerm: U64 = self.semanticExprTerm(exprId: baseExpr)
                                val keyTerm: U64 = self.semanticExprTerm(exprId: keyExpr)
                                val valueTerm: U64 = self.semanticExprTerm(exprId: candidate.readExpr)
                                val accessTerm: U64 = self.semanticExprTerm(exprId: use.accessExpr)
                        self.arena.semanticAccesses.append(<SemanticAccess bodyId=parent.bodyId candidateIndex=use.candidateIndex baseExpr=baseExpr keyExpr=keyExpr baseTerm=baseTerm keyTerm=keyTerm valueTerm=valueTerm accessExpr=use.accessExpr accessTerm=accessTerm readResolution=readResolution writeResolution=writeResolution parentResolution=parentIndex role=use.role argIndex=use.argIndex parameterIndex=use.parameterIndex write=use.write />)
                            }
                            _ => { self.errorAt(offset: self.exprOffset(id: parent.exprId), msg: "internal error: access candidate lost its indexed storage path") }
                        }
                    }
                }
                useIndex += 1U64
            }
            parentIndex += 1U64
        }
    }

    // Close the semantic call graph before backend emission.  The existing
    // Mono discovery lists still decide which generic layouts are required; this
    // pass adds the missing invariant: every emitted body instance has resolved
    // every static call exactly once in its own concrete environment.
    inout fn finalizeCallables() {
        self.arena.finalCallees = []
        self.arena.finalCalleeIndexSlots = []
        self.arena.finalAggregates = []
        self.arena.finalAggregateIndexSlots = []
        self.arena.finalReturns = []
        self.arena.finalReturnIndexSlots = []
        self.monoWork.bodyInstances = []
        // `collectFnInsts` predates final-callable construction and may have
        // registered a generic body from an AST-global / parametric type
        // projection.  Keeping that provisional worklist lets (for example)
        // a loop's `print[I64]` call leave an obsolete `print[Optional[…]]`
        // instance for LLVM to emit.  Final descriptors are the one authority
        // for call-driven instances, so rebuild this worklist from the roots
        // and descriptor closure below rather than mixing the two phases.
        // `collectFnInsts` predates final-callable construction and may have
        // registered a generic body from an AST-global / parametric type
        // projection.  Keeping that provisional worklist lets (for example)
        // a loop's `print[I64]` call leave an obsolete `print[Optional[…]]`
        // instance for LLVM to emit.  Final descriptors are the one authority
        // for call-driven instances, so rebuild this worklist from the roots
        // and descriptor closure below rather than mixing the two phases.
        self.monoWork.fnInsts = []
        val noParams: Array[Bind] = []
        val noArgs: Array[U64] = []
        // Global initializers are an anonymous body instance.  They can reach
        // ordinary functions and therefore seed the same queue as main.
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0U64
        self.cur.recvInstRef = 0U64
        self.cur.typeParams = noParams
        self.cur.typeArgs = noArgs
        self.enterBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
        mut val gi: U64 = 0U64
        while gi < self.arena.globals.count() {
            tracePhaseProgress(c: inout self, label: "finalize-callables:global", count: gi, stride: 16U64)
            self.scanStmtInsts(stmtId: self.arena.globals[gi].letStmt)
            gi += 1U64
        }
        // Main is the normal synchronous root.  Async declarations are emitted
        // as state machines by the current backend, so include their bodies too.
        mut val fi: U64 = 0U64
        while fi < self.arena.funcs.count() {
            tracePhaseProgress(c: inout self, label: "finalize-callables:function-root", count: fi, stride: 64U64)
            val f: Func = self.arena.funcs[fi]
            if !(f.isExtern) && f.body != 0U64 {
                // Backend declaration is deliberately lazy for provided/lang-item
                // methods, but lazy *emission* must not be lazy semantic
                // resolution.  Every concrete, non-generic body is therefore a
                // finalization root. Generic templates still enter only through
                // their concrete FnInst/body-instance substitutions.
                if f.typeParams.count() == 0U64 && !(self.methodRecvIsTrait(f: f)) {
                    // A method body is emitted with its receiver instance even
                    // when that receiver has no generic arguments.  Give Mono
                    // that same identity at the root: recording it as `0` then
                    // emitting it as `Counter` made CallResolution miss and fall
                    // back to the AST-global cache (where a shared provided
                    // body could inherit `Two`'s selection).
                    mut val rootRecv: U64 = 0U64
                    if f.hasRecv || f.isAssoc {
                        rootRecv = self.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
                    }
                    self.enqueueFinalBody(fnIdx: fi, args: [], recvInstRef: rootRecv)
                }
                if self.nameIsMain(f: f) || f.isAsync {
                    self.enqueueFinalBody(fnIdx: fi, args: [], recvInstRef: 0U64)
                }
            }
            fi += 1U64
        }
        // `genInsts` determines not only LLVM layouts but also the concrete
        // method bodies that LLVM may emit on demand.  Register each receiver-
        // generic, non-provided body here before code generation.  Previously
        // `emitOneGenMethod` could first reach (for example) MapIter.next after
        // finalization, leaving its nested calls without CallResolution entries and
        // tempting backend-local resolution.  Method-own generic parameters are
        // represented by an explicit FnInst at their call site, so this root set
        // includes only the exact receiver-argument arity.
        mut val gi2: U64 = 0U64
        while gi2 < self.monoWork.genInsts.count() {
            tracePhaseProgress(c: inout self, label: "finalize-callables:generic-instance", count: gi2, stride: 16U64)
            val instRef: U64 = self.monoWork.genInsts[gi2]
            if instRef < self.arena.types.count() {
                val inst: TypeRef = self.arena.types[instRef]
                mut val mfi: U64 = 0U64
                while mfi < self.arena.funcs.count() {
                    val mf: Func = self.arena.funcs[mfi]
                    // A trait receiver is an abstract interface, never a
                    // concrete generic instance. Its authored witness body is
                    // finalized only through the conferred/provided copy on a
                    // real conformer; enqueueing `B[Element]` here loses that
                    // conformance proof and makes `self.base()` impossible to
                    // resolve.
                    if !(mf.isProvided) && !(self.methodRecvIsTrait(f: mf)) && !(mf.isExtern) && mf.body != 0U64 {
                        if mf.hasRecv && mf.typeParams.count() == inst.args.count() {
                            if self.methodMatchesInst(f: mf, instRef: instRef) {
                                self.enqueueFinalBody(fnIdx: mfi, args: inst.args, recvInstRef: instRef)
                            }
                        }
                        // Trait conformance witnesses are associated functions:
                        // they have no value receiver and were therefore
                        // invisible to the old method root.  LLVM can emit
                        // them while constructing a reached generic type's
                        // witness table, so finalize their concrete body here
                        // before the backend starts.
                        if self.assocWitnessMatchesInst(f: mf, instRef: instRef) {
                            self.enqueueFinalBody(fnIdx: mfi, args: inst.args, recvInstRef: instRef)
                            self.enqueueSelectedAssocInstance(callee: mfi, args: inst.args, recvInstRef: instRef)
                        }
                    }
                    mfi += 1U64
                }
            }
            gi2 += 1U64
        }
        mut val bodyI: U64 = 0U64
        mut val fnI: U64 = 0U64
        while bodyI < self.monoWork.bodyInstances.count() || fnI < self.monoWork.fnInsts.count() {
            while fnI < self.monoWork.fnInsts.count() {
                tracePhaseProgress(c: inout self, label: "finalize-callables:function-instance", count: fnI, stride: 16U64)
                val fin: FnInst = self.monoWork.fnInsts[fnI]
                self.enqueueFinalBody(fnIdx: fin.fnIdx, args: fin.args, recvInstRef: fin.recvInstRef)
                fnI += 1U64
            }
            if bodyI < self.monoWork.bodyInstances.count() {
                self.scanFinalBodyInstance(bodyId: self.monoWork.bodyInstances[bodyI])
                bodyI += 1U64
            }
        }
        // Materializing a code-generation instance from a final descriptor can
        // reveal a new generic body.  That body must itself be finalized before
        // LLVM sees it; otherwise a later instance of the same AST observes an
        // older descriptor key.  Close descriptor→instance registration and
        // body scanning together as one worklist fixpoint.
        mut val callI: U64 = 0U64
        mut val closingFinalCalls: Bool = true
        while closingFinalCalls {
            while callI < self.finalCalleeCount() {
                tracePhaseProgress(c: inout self, label: "finalize-callables:descriptor", count: callI, stride: 64U64)
                val selected: CallResolution = self.arena.finalCallees[callI]
                self.enqueueSelectedAssocInstance(callee: selected.callee, args: self.copyFinalCalleeTypeArgs(args: selected.calleeTypeArgs), recvInstRef: selected.recvTypeRef)
                self.enqueueSelectedFreeInstance(callee: selected.callee, args: self.copyFinalCalleeTypeArgs(args: selected.calleeTypeArgs))
                callI += 1U64
            }
            while fnI < self.monoWork.fnInsts.count() {
                tracePhaseProgress(c: inout self, label: "finalize-callables:function-instance", count: fnI, stride: 16U64)
                val fin: FnInst = self.monoWork.fnInsts[fnI]
                self.enqueueFinalBody(fnIdx: fin.fnIdx, args: fin.args, recvInstRef: fin.recvInstRef)
                fnI += 1U64
            }
            while bodyI < self.monoWork.bodyInstances.count() {
                self.scanFinalBodyInstance(bodyId: self.monoWork.bodyInstances[bodyI])
                bodyI += 1U64
            }
            if callI >= self.finalCalleeCount() && fnI >= self.monoWork.fnInsts.count() && bodyI >= self.monoWork.bodyInstances.count() {
                closingFinalCalls = false
            }
        }
        self.verifyFinalCallResolutions()
        self.freezeFinalAccesses()
        // Do not leak the last scanned generic body's substitution environment
        // into backend pass setup.  Each emitter establishes its own instance;
        // leaving this ambient state live would make an otherwise argless
        // provided body look up a different CallResolution key.
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0U64
        self.cur.recvInstRef = 0U64
        self.cur.typeParams = noParams
        self.cur.typeArgs = noArgs
        self.cur.selfRef = 0U64
        self.cur.itemRef = 0U64
        self.enterBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
    }

    inout fn captureSupported(lo: Local) -> Bool {
        if lo.isArray {
            return true
        }
        if self.isPrimType(start: lo.tyStart, len: lo.tyLen) {
            return true
        }
        if rangeEquals(bytes: self.arena.bytes, start: lo.tyStart, len: lo.tyLen, kw: "String") {
            return true
        }
        if self.isStrongRefInst(ref: lo.ty) || self.isWeakRefLikeInst(ref: lo.ty) {
            return true
        }
        val si: U64 = self.structIndexByName(start: lo.tyStart, len: lo.tyLen)
        if si < self.arena.structs.count() {
            if self.arena.structs[si].isUnique {
                return false
            }
            if self.arena.structs[si].typeParams.count() > 0 {
                return false
            }
            return true
        }
        return false
    }

    inout fn recordCapture(closureId: U64, localIdx: U64) {
        val lo: Local = self.cur.locals[localIdx]
        mut val i: U64 = 0
        while i < self.monoWork.captures.count() {
            val e: CaptureEntry = self.monoWork.captures[i]
            if e.closureId == closureId {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: lo.nameStart, bLen: lo.nameLen) {
                    return
                }
            }
            i += 1
        }
        mut val boxed: Bool = false
        if lo.isMut {
            // a mutable capture must share storage (reference capture). v1 boxes only
            // scalar (`mut val`) cells; mutable non-scalar capture is additive later.
            // (an array's type span names its element, so guard isArray explicitly.)
            if lo.isArray {
                self.errorAt(offset: lo.nameStart, msg: "v1 rejects closure capture of mutable non-scalar values (`mut val` array/struct/string); use an explicit Ref/MutableRef wrapper when shared state is intended")
            } else {
                if self.isPrimType(start: lo.tyStart, len: lo.tyLen) {
                    boxed = true
                } else {
                    self.errorAt(offset: lo.nameStart, msg: "v1 rejects closure capture of mutable non-scalar values (`mut val` array/struct/string); use an explicit Ref/MutableRef wrapper when shared state is intended")
                }
            }
        } else {
            if !(self.captureSupported(lo: lo)) {
                self.errorAt(offset: lo.nameStart, msg: "v1 rejects closure capture of unique, generic-instantiated, enum, or function-typed values")
            }
        }
        self.monoWork.captures.append(<CaptureEntry closureId=closureId nameStart=lo.nameStart nameLen=lo.nameLen tyStart=lo.tyStart tyLen=lo.tyLen isArray=lo.isArray ty=lo.ty boxed=boxed />)
    }

    // Replace the ChainHole at the root of an OptChain's `cont` (the leftmost base
    // spine) with a reference to the match-bound value `__chainVal`, anchored at the
    // `?.member` source token. `cont` is `hole.b.c` -> `__chainVal.b.c`.
    inout fn retargetChainHole(exprId: U64, cvStart: U64, cvLen: U64, anchor: U64, valueRef: U64) {
        match self.arena.exprs[exprId] {
            Expr.ChainHole => {
                self.arena.exprs[exprId] = <Expr.Ident start=cvStart len=cvLen />
                self.arena.exprSpanStart[exprId] = anchor
                // `__chainVal` is a real semantic temporary after the rewrite.
                // Preserve the parent stage's parametric Value term on this
                // replacement node so finalization and LLVM never recover its
                // receiver from the synthetic spelling.
                self.recordSyntheticExprType(exprId: exprId, ref: valueRef)
            }
            Expr.Field(val base, nameStart: _, nameLen: _) => { self.retargetChainHole(exprId: base, cvStart: cvStart, cvLen: cvLen, anchor: anchor, valueRef: valueRef) }
            Expr.Method(val recv, nameStart: _, nameLen: _, args: _) => { self.retargetChainHole(exprId: recv, cvStart: cvStart, cvLen: cvLen, anchor: anchor, valueRef: valueRef) }
            Expr.Index(val base, index: _) => { self.retargetChainHole(exprId: base, cvStart: cvStart, cvLen: cvLen, anchor: anchor, valueRef: valueRef) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { self.retargetChainHole(exprId: base, cvStart: cvStart, cvLen: cvLen, anchor: anchor, valueRef: valueRef) }
            Expr.Deref(val base) => { self.retargetChainHole(exprId: base, cvStart: cvStart, cvLen: cvLen, anchor: anchor, valueRef: valueRef) }
            _ => {}
        }
    }

    // Synthetic desugar expressions are introduced after the ordinary typed-IR
    // table is populated.  Give them the same semantic type authority as
    // lowered expressions so later Mono resolution never has to recover a
    // generic receiver from its bare source spelling.
    inout fn recordSyntheticExprType(exprId: U64, ref: U64) {
        self.recordSemanticExprTerm(exprId: exprId, term: ref)
    }

    inout fn rewriteOptChainToChainMatch(exprId: U64, base: U64, cont: U64, memberStart: U64, headStart: U64, headLen: U64, stageRef: U64) {
        val chainN: Bind = self.internBytes(s: "chain")
        val fromValueN: Bind = self.internBytes(s: "fromValue")
        val emptyN: Bind = self.internBytes(s: "empty")
        val optN: Bind = self.internBytes(s: "Optional")
        val someN: Bind = self.internBytes(s: "Some")
        val noneN: Bind = self.internBytes(s: "None")
        val vFieldN: Bind = self.internBytes(s: "v")
        val cvN: Bind = self.internBytes(s: "__chainVal")
        val valueN: Bind = self.internBytes(s: "value")
        // scrutinee: base.chain()
        val noArgs: Array[Arg] = []
        val scrut: U64 = self.pushExpr(e: <Expr.Method recv=base nameStart=chainN.nameStart nameLen=chainN.nameLen args=self.pushArgs(args: noArgs) />)
        // Some(v: val __chainVal) => <Head.fromValue value=(cont with hole -> __chainVal) />
        val fromRecv: U64 = self.pushExpr(e: <Expr.Ident start=headStart len=headLen />)
        self.recordSyntheticExprType(exprId: fromRecv, ref: stageRef)
        mut val valueRef: U64 = 0U64
        if stageRef != 0U64 && stageRef < self.arena.types.count() {
            val stage: TypeRef = self.arena.types[stageRef]
            val valueIndex: U64 = self.chainValueArgIndex(headStart: stage.nameStart, headLen: stage.nameLen)
            if valueIndex < stage.args.count() {
                valueRef = stage.args[valueIndex]
            }
        }
        self.retargetChainHole(exprId: cont, cvStart: cvN.nameStart, cvLen: cvN.nameLen, anchor: memberStart, valueRef: valueRef)
        // the synthesized nodes anchor at the `?.member` source token: their own name
        // spans are interned (`chain`/`fromValue`/`__chainVal`), so a diagnostic on the
        // desugar would otherwise point at a garbage line outside the source. `cont`'s
        // own nodes keep their real source spans (set at lowering).
        self.arena.exprSpanStart[scrut] = memberStart
        self.arena.exprSpanStart[fromRecv] = memberStart
        mut val fromArgs: Array[Arg] = []
        fromArgs.append(<Arg expr=cont isInout=false labelStart=valueN.nameStart labelLen=valueN.nameLen hasLabel=true />)
        val fromCall: U64 = self.pushExpr(e: <Expr.Method recv=fromRecv nameStart=fromValueN.nameStart nameLen=fromValueN.nameLen args=self.pushArgs(args: fromArgs) />)
        self.recordSyntheticExprType(exprId: fromCall, ref: stageRef)
        self.arena.exprSpanStart[fromCall] = memberStart
        // `fromValue` is not a written call merely because its diagnostic
        // anchor is a written `?.` token.  Give every generated call its own
        // producer identity and retain the parametric receiver alongside it.
        // Mono and LLVM then find one CallResolution by the same synthetic
        // key under each concrete BodyInstance; source spans never stand in
        // for a compiler-created occurrence.
        val fromOriginSerial: U64 = self.nextExprOriginSerial
        self.nextExprOriginSerial += 1U64
        self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=fromCall originSerial=fromOriginSerial receiverTerm=stageRef />)
        mut val someStmts: Array[U64] = []
        someStmts.append(self.pushStmt(s: <Stmt.Give value=fromCall />))
        val someBlk: U64 = self.pushBlock(stmts: someStmts)
        mut val someBinds: Array[Bind] = []
        someBinds.append(<Bind nameStart=cvN.nameStart nameLen=cvN.nameLen nameId=cvN.nameId fieldStart=vFieldN.nameStart fieldLen=vFieldN.nameLen offset=memberStart />)
        val someArm: MatchArm = <MatchArm isWildcard=false enumStart=optN.nameStart enumLen=optN.nameLen variantStart=someN.nameStart variantLen=someN.nameLen binds=self.pushBinds(binds: someBinds) body=someBlk isStruct=false isDiverge=false />
        // None => <Head.empty />
        val emptyRecv: U64 = self.pushExpr(e: <Expr.Ident start=headStart len=headLen />)
        self.recordSyntheticExprType(exprId: emptyRecv, ref: stageRef)
        val emptyCall: U64 = self.pushExpr(e: <Expr.Method recv=emptyRecv nameStart=emptyN.nameStart nameLen=emptyN.nameLen args=self.pushArgs(args: noArgs) />)
        self.recordSyntheticExprType(exprId: emptyCall, ref: stageRef)
        self.arena.exprSpanStart[emptyRecv] = memberStart
        self.arena.exprSpanStart[emptyCall] = memberStart
        val emptyOriginSerial: U64 = self.nextExprOriginSerial
        self.nextExprOriginSerial += 1U64
        self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=emptyCall originSerial=emptyOriginSerial receiverTerm=stageRef />)
        mut val noneStmts: Array[U64] = []
        noneStmts.append(self.pushStmt(s: <Stmt.Give value=emptyCall />))
        val noneBlk: U64 = self.pushBlock(stmts: noneStmts)
        val noneArm: MatchArm = <MatchArm isWildcard=false enumStart=optN.nameStart enumLen=optN.nameLen variantStart=noneN.nameStart variantLen=noneN.nameLen binds=<BindRange start=0U64 len=0U64 /> body=noneBlk isStruct=false isDiverge=false />
        mut val arms: Array[MatchArm] = []
        arms.append(someArm)
        arms.append(noneArm)
        // Finalization runs after callable registration, so bind the nominal
        // Chain witnesses now and retain them in the structural template. The
        // later BodyInstance walk only grounds this decision; it never redoes
        // source/bare-surface lookup.
        val fromValueCallee: U64 = self.chainAssocWitness(recvStart: headStart, recvLen: headLen, nameStart: fromValueN.nameStart, nameLen: fromValueN.nameLen)
        val emptyCallee: U64 = self.chainAssocWitness(recvStart: headStart, recvLen: headLen, nameStart: emptyN.nameStart, nameLen: emptyN.nameLen)
        self.setChainSiteImplicitCalls(exprId: exprId, fromValueExprId: fromCall, fromValueCallee: fromValueCallee, emptyExprId: emptyCall, emptyCallee: emptyCallee)
        self.arena.exprs[exprId] = <Expr.MatchExpr scrut=scrut arms=self.pushMatchArms(arms: arms) />
    }

    // Which type-argument position of a `Chain` conformer named (headStart,headLen) is
    // its `Value` (spec/08 `type Value = <param>`)? An Optional-shaped conformer binds
    // Value to its sole type parameter (index 0); a multi-parameter conformer
    // (`enum Slot[Meta, T] as Chain { type Value = T }`) binds it elsewhere. Resolve the
    // associated binding to the parameter name and find its declared position, so the
    // desugar substitutes the RIGHT arg and preserves the others (a fixed args[0] both
    // crashed — index out of range — and dropped the sibling parameters). Falls back to 0
    // when the head is unregistered or the binding is not one of its type params.
    inout fn chainValueArgIndex(headStart: U64, headLen: U64) -> U64 {
        val valN: Bind = self.internBytes(s: "Value")
        val vb: Bind = self.assocBindingSpan(recvStart: headStart, recvLen: headLen, nameStart: valN.nameStart, nameLen: valN.nameLen)
        val si: U64 = self.structDefByNameAny(start: headStart, len: headLen)
        if si < self.arena.structs.count() {
            return self.paramPos(tps: self.arena.structs[si].typeParams, nameId: vb.nameId)
        }
        val ei: U64 = self.enumIdxByName(start: headStart, len: headLen)
        if ei < self.arena.enums.count() {
            return self.paramPos(tps: self.arena.enums[ei].typeParams, nameId: vb.nameId)
        }
        return 0U64
    }

    fn paramPos(tps: Array[Bind], nameId: U64) -> U64 {
        mut val k: U64 = 0
        while k < tps.count() {
            if tps[k].nameId == nameId {
                return k
            }
            k += 1
        }
        return 0U64
    }

    // The result `Head[…U…]` of one desugared `?.` stage under the ACTIVE env: ground the
    // receiver `Head[…V…]`, extract its chain Value V (the arg at the conformer's Value
    // position — see chainValueArgIndex), type the trailing chain `cont` with the
    // ChainHole bound to V (so `a?.b.c` yields U = typeof(V.b.c)), and rebuild the head
    // with the Value position replaced by U and every other argument preserved. Shared by
    // the mono registration and the read path (chainResultRef) so the two can never
    // disagree. Returns 0 when the receiver doesn't ground to an instance. Must run BEFORE
    // the rewrite substitutes the hole.
    inout fn chainStageResultRef(baseRef: U64, cont: U64) -> U64 {
        if baseRef == 0 || baseRef >= self.arena.types.count() {
            return 0
        }
        val g: U64 = self.groundTypeRef(ref: baseRef)
        if g >= self.arena.types.count() {
            return 0
        }
        val gt: TypeRef = self.arena.types[g]
        if gt.args.count() < 1 {
            return 0
        }
        val vi: U64 = self.chainValueArgIndex(headStart: gt.nameStart, headLen: gt.nameLen)
        if vi >= gt.args.count() {
            return 0
        }
        val vRef: U64 = gt.args[vi]
        // type `cont` under ChainHole = V. exprType's Field/Method arms ground member
        // types through V's instance (genericFieldTypeInfo for a generic chain Value),
        // so U comes back concrete — no separate groundUnderInst needed.
        val uInfo: TypeInfo = self.exprTypeWithChainHole(id: cont, chainHoleRef: vRef)
        mut val uRef: U64 = uInfo.ref
        if uRef == 0 {
            val noTArgs: Array[U64] = []
            uRef = self.pushType(t: <TypeRef nameStart=uInfo.nameStart nameLen=uInfo.nameLen args=noTArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        }
        // rebuild the head preserving every type argument, with the Value position -> U.
        mut val oArgs: Array[U64] = []
        mut val ai: U64 = 0
        while ai < gt.args.count() {
            if ai == vi {
                oArgs.append(uRef)
            } else {
                oArgs.append(gt.args[ai])
            }
            ai += 1
        }
        return self.pushType(t: <TypeRef nameStart=gt.nameStart nameLen=gt.nameLen args=oArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    // Register the instances a chain-rewritten `?.` stage needs, grounded under
    // the ACTIVE env — called from the MatchExpr scan arm, so EVERY fn instance
    // that reaches the shared rewritten tree registers its own groundings. The
    // result `Head[U]` and the no-arg `empty()` factory's instance can't be
    // inferred from arguments (empty has none), so they are registered explicitly.
    inout fn registerChainSiteInsts(exprId: U64) {
        val site: ChainSite = self.chainSiteFor(exprId: exprId)
        if site.stageRef == 0 {
            return
        }
        val oRef: U64 = self.groundTypeRef(ref: site.stageRef)
        if oRef == 0 || oRef >= self.arena.types.count() {
            return
        }
        // This shared rewritten tree is also visited while validating a
        // generic declaration.  `Head[T]` is a template then, not a concrete
        // monomorphization request: adding factory FnInsts at that point
        // creates an unfilled `empty[T]` body that survives to LLVM.  Concrete
        // BodyInstance scans revisit the same ChainSite with a ground stage.
        if !(self.tyRefIsGround(ref: oRef)) {
            return
        }
        val ot: TypeRef = self.arena.types[oRef]
        if ot.args.count() < 1 {
            return
        }
        val headStart: U64 = ot.nameStart
        val headLen: U64 = ot.nameLen
        val vi: U64 = self.chainValueArgIndex(headStart: headStart, headLen: headLen)
        if vi >= ot.args.count() {
            return
        }
        val uRef: U64 = ot.args[vi]
        val vRef: U64 = self.groundTypeRef(ref: site.valueRef)
        // The desugar tree is shared by generic body instances. Its synthetic
        // receiver/call entries were recorded once with the parametric
        // `stageRef` during rewriting; never overwrite those AST-global
        // entries with this instance's `oRef`. `groundedTypeOf` applies the
        // active BodyInstance environment when finalizing each call.
        self.scanType(ref: oRef)
        // the chain() result `Optional[V]` (V = the receiver's chain Value = its first
        // type arg): register the concrete instance so the desugar's `match base.chain()`
        // sets the enum env and types the Some-payload bind (the front-end method-result
        // typeOf can recover only the ungrounded `Optional[T]` template otherwise).
        val optN: Bind = self.internBytes(s: "Optional")
        mut val optArgs: Array[U64] = []
        optArgs.append(vRef)
        val optVRef: U64 = self.pushType(t: <TypeRef nameStart=optN.nameStart nameLen=optN.nameLen args=optArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        self.scanType(ref: optVRef)
        // registering the result `Head[U]` pulls in its own `chain()`, whose body builds
        // `Optional[U]`; register that too (U may differ from V — `Head[U]` vs receiver
        // `Head[V]`).
        mut val optUArgs: Array[U64] = []
        optUArgs.append(uRef)
        val optURef: U64 = self.pushType(t: <TypeRef nameStart=optN.nameStart nameLen=optN.nameLen args=optUArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        self.scanType(ref: optURef)
        // The two factories are reached through their ChainSite call
        // templates when the rewritten match arms are scanned below.  Do not
        // append raw FnInsts here: that bypasses the selected receiver and
        // duplicates a symbolic generic template as if it were concrete.
    }

    // The recorded `?.` site of a chain-rewritten match at `exprId`
    // (stageRef == 0 = not a chain site).
    fn chainSiteFor(exprId: U64) -> ChainSite {
        mut val i: U64 = 0
        while i < self.decls.chainSites.count() {
            if self.decls.chainSites[i].exprId == exprId {
                return self.decls.chainSites[i]
            }
            i += 1
        }
        return <ChainSite exprId=0 stageRef=0 valueRef=0 />
    }

    // Attach the two declaration-time selections made by the Chain desugar.
    // ChainSite is the declaration-owned template; CallResolution remains the
    // concrete, body-instance-owned result of grounding it.
    inout fn setChainSiteImplicitCalls(exprId: U64, fromValueExprId: U64, fromValueCallee: U64, emptyExprId: U64, emptyCallee: U64) {
        mut val i: U64 = 0U64
        while i < self.decls.chainSites.count() {
            val site: ChainSite = self.decls.chainSites[i]
            if site.exprId == exprId {
                self.decls.chainSites.set(i: i, value: <ChainSite exprId=site.exprId stageRef=site.stageRef valueRef=site.valueRef fromValueExprId=fromValueExprId fromValueCallee=fromValueCallee emptyExprId=emptyExprId emptyCallee=emptyCallee />)
                return
            }
            i += 1U64
        }
    }

    // Return the declaration-time template selected for an implicit Chain
    // factory call, or the normal no-callable sentinel.  This is deliberately
    // keyed by the synthetic call ExprId, not by its text: the text is only a
    // lowering artifact and may be shared by several generic body instances.
    fn chainImplicitCallee(exprId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.chainSites.count() {
            val site: ChainSite = self.decls.chainSites[i]
            if site.fromValueExprId == exprId { return site.fromValueCallee }
            if site.emptyExprId == exprId { return site.emptyCallee }
            i += 1U64
        }
        return self.arena.funcs.count()
    }

    fn chainImplicitStageRef(exprId: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.chainSites.count() {
            val site: ChainSite = self.decls.chainSites[i]
            if site.fromValueExprId == exprId || site.emptyExprId == exprId {
                return site.stageRef
            }
            i += 1U64
        }
        return 0U64
    }

    inout fn findAssocByName(recvStart: U64, recvLen: U64, name: String) -> U64 {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val nm: Bind = self.internBytes(s: name)
        val qName: U64 = intern(c: inout self, start: nm.nameStart, len: nm.nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if !(f.hasRecv) {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    // `?.` must call the factories that witness `impl Receiver as Chain`,
    // rather than an unrelated inherent factory with the same spelling.
    // `findAssoc` intentionally searches only the bare associated surface, so
    // it cannot select a trait witness here.  This selector uses the same
    // nominal trait identity as the conformance gate below.
    inout fn chainAssocWitness(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> U64 {
        val recvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val nameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val chain: Bind = self.internBytes(s: "Chain")
        mut val i: U64 = 0U64
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.isAssoc && f.recvId == recvId && f.nameId == nameId && f.originTraitId == chain.nameId {
                return i
            }
            i += 1U64
        }
        return self.arena.funcs.count()
    }

    // Does the type named (nameStart,nameLen) FULLY implement `Chain` (spec/12)? `?.`
    // desugars to `match base.chain() { Some(v) => <O.fromValue value=v.… />; None =>
    // <O.empty /> }`, so a conformer must supply ALL of: a `chain()` returning an
    // `Optional`, plus `fromValue(value:)` and `empty()` factories. Testing only for a
    // `chain` method (忖度) let a struct with an unrelated `chain()` — or one returning a
    // non-Optional, or lacking the factories — desugar and then fail deep in the backend
    // with an out-of-source line number. The Mono rewrite gate and the Verify survivor
    // check share this predicate so they never disagree on what conforms.
    inout fn typeConformsToChain(nameStart: U64, nameLen: U64) -> Bool {
        // `?.` is the `Chain` trait's desugar (spec/12), and Plew traits are NOMINAL:
        // a type is a `Chain` only if it declares `impl … as Chain`. Check that first —
        // else a type that merely happens to expose `chain()`/`fromValue`/`empty` with
        // the right arities would be duck-typed into `?.` (a hidden-meaning accept that
        // contradicts "忖度はしない"). Only `Optional` conforms in std/Core.pw.
        val recvId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val chainTrait: Bind = self.internBytes(s: "Chain")
        if !(self.conformExists(typeId: recvId, traitId: chainTrait.nameId)) {
            return false
        }
        val chN: Bind = self.internBytes(s: "chain")
        if !(self.typeHasMethodNamed(recvStart: nameStart, recvLen: nameLen, nameStart: chN.nameStart, nameLen: chN.nameLen)) {
            return false
        }
        val noArgs: Array[Arg] = []
        val mi: U64 = self.findMethod(recvStart: nameStart, recvLen: nameLen, nameStart: chN.nameStart, nameLen: chN.nameLen, args: self.pushArgs(args: noArgs))
        if mi >= self.arena.funcs.count() {
            return false
        }
        // `chain()` takes no argument and returns an `Optional` (spec/12).
        if self.arena.funcs[mi].params.count() != 0U64 {
            return false
        }
        if !(rangeEquals(bytes: self.arena.bytes, start: self.arena.funcs[mi].retStart, len: self.arena.funcs[mi].retLen, kw: "Optional")) {
            return false
        }
        // `fromValue(value:)` takes exactly one argument, `empty()` none — a wrong arity
        // means the desugar's `<O.fromValue value=…/>` / `<O.empty/>` would fail to
        // resolve deep in the backend (an out-of-source line number). Check them here.
        val fvN: Bind = self.internBytes(s: "fromValue")
        val fvIdx: U64 = self.chainAssocWitness(recvStart: nameStart, recvLen: nameLen, nameStart: fvN.nameStart, nameLen: fvN.nameLen)
        if fvIdx >= self.arena.funcs.count() {
            return false
        }
        if self.arena.funcs[fvIdx].params.count() != 1U64 {
            return false
        }
        val emN: Bind = self.internBytes(s: "empty")
        val emIdx: U64 = self.chainAssocWitness(recvStart: nameStart, recvLen: nameLen, nameStart: emN.nameStart, nameLen: emN.nameLen)
        if emIdx >= self.arena.funcs.count() {
            return false
        }
        if self.arena.funcs[emIdx].params.count() != 0U64 {
            return false
        }
        return true
    }

    inout fn scanExprInsts(exprId: U64) {
        if self.tracePhases {
            self.traceExprInstScans += 1U64
        }
        match self.arena.exprs[exprId] {
            Expr.Ident(val start, val len) => {
                // capture detection: inside a closure, an identifier that resolves to
                // a local below the closure's entry mark is an enclosing capture.
                if self.cur.inClosure {
                    val li: U64 = self.localIndexByName(start: start, len: len)
                    if li < self.cur.captureMark {
                        // a module-level variable (spec/15) seeded at the locals base
                        // (index < globals.count()) is globally accessible — not a capture.
                        if li >= self.arena.globals.count() {
                            self.recordCapture(closureId: self.cur.closureId, localIdx: li)
                        }
                    }
                }
            }
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                // a closure literal lexically inside another closure body: the inner
                // env construction would have to reach the outer env, which is not
                // wired yet — reject loudly rather than miscompile.
                if self.cur.inClosure {
                    self.errorAt(offset: self.exprOffset(id: exprId), msg: "v1 rejects nested closure literals; use a named helper or a single closure boundary")
                }
                // walk the body with the closure's own scope so enclosing references
                // become captures. Save/restore the capture context (single-level;
                // nested closures keep their own mark).
                val savedId: U64 = self.cur.closureId
                val savedIn: Bool = self.cur.inClosure
                val savedMark: U64 = self.cur.captureMark
                val savedBodyFn: U64 = self.cur.bodyFnIdx
                val savedBodyEnvironment: InstanceEnvironment = self.cur.bodyEnvironment
                val enclMark: U64 = self.scopeMark()
                self.cur.closureId = exprId
                self.cur.inClosure = true
                self.cur.captureMark = enclMark
                self.cur.bodyFnIdx = self.closureBodyKey(closureId: exprId)
                self.cur.bodyEnvironment = <InstanceEnvironment />
                self.cur.bodyId = 0U64
                mut val pi: U64 = 0
                while pi < params.count() {
                    val p: Param = params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    pi += 1
                }
                self.scanBlockInsts(blkId: body)
                self.popLocals(mark: enclMark)
                self.cur.closureId = savedId
                self.cur.inClosure = savedIn
                self.cur.captureMark = savedMark
                self.cur.bodyFnIdx = savedBodyFn
                self.cur.bodyEnvironment = savedBodyEnvironment
                self.cur.bodyId = 0U64
            }
            Expr.Unary(val op, val operand) => {
                self.scanExprInsts(exprId: operand)
                // Unary syntax is a source-level call just like binary syntax.
                // `!` is a primitive Bool operation, but Mono must still record
                // its explicit no-user-callable result so LLVM never confuses it
                // with an absent finalization entry.
                self.recordBodyOperatorCallee(exprId: exprId)
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                self.scanExprInsts(exprId: lhs)
                self.scanExprInsts(exprId: rhs)
                if op != opAnd() && op != opOr() {
                    self.recordBodyOperatorCallee(exprId: exprId)
                }
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                mut val i: U64 = 0
                while i < args.len {
                    self.scanExprInsts(exprId: self.argAt(args: args, index: i).expr)
                    i += 1
                }
                self.registerCallInst(id: exprId, nameStart: nameStart, nameLen: nameLen, args: args, finalIdx: self.resolveBodyCallee(exprId: exprId))
                self.finalizeAccessWriteFacets(parentExpr: exprId)
            }
            Expr.ExtMethod(val recv, source: _, val nameStart, val nameLen, val args) => {
                self.scanExprInsts(exprId: recv)
                mut val i: U64 = 0
                while i < args.len {
                    self.scanExprInsts(exprId: self.argAt(args: args, index: i).expr)
                    i += 1
                }
                self.registerMethodInst(callId: exprId, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args, finalIdx: self.resolveBodyCallee(exprId: exprId))
                self.finalizeAccessWriteFacets(parentExpr: exprId)
            }
            Expr.ExtView(val recv, source: _, strip: _) => {
                self.scanExprInsts(exprId: recv)
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                self.scanExprInsts(exprId: recv)
                mut val i: U64 = 0
                while i < args.len {
                    self.scanExprInsts(exprId: self.argAt(args: args, index: i).expr)
                    i += 1
                }
                val finalIdx: U64 = self.resolveBodyCallee(exprId: exprId)
                self.registerMethodInst(callId: exprId, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args, finalIdx: finalIdx)
                self.finalizeAccessWriteFacets(parentExpr: exprId)
            }
            Expr.Field(val base, val nameStart, val nameLen) => { self.scanExprInsts(exprId: base) }
            Expr.Index(val base, val index) => {
                // Record selected every non-structural subscript while the
                // lexical body was still parametric.  Here we only lower that
                // frozen choice to the method-shaped execution form consumed
                // by the existing call ABI; no type/name lookup is allowed
                // after CallTemplates close.
                val template: CallTemplate = self.callTemplateForCurrentBody(exprId: exprId)
                mut val selected: U64 = self.arena.funcs.count()
                mut val selectedName: Bind = self.kwSpan(kw: "index", kwLen: 5U64)
                mut val hasSelectedCall: Bool = false
                match template.kind {
                    CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proof: _) => {
                        selected = callee
                        if selected < self.arena.funcs.count() {
                            selectedName = <Bind nameStart=self.arena.funcs[selected].nameStart nameLen=self.arena.funcs[selected].nameLen fieldStart=self.arena.funcs[selected].nameStart fieldLen=self.arena.funcs[selected].nameLen />
                            hasSelectedCall = true
                        }
                    }
                    // A generic `T: Index` or `any Index` keeps a proof/dynamic
                    // target rather than a declaration callee. The authored
                    // Index surface is still fixed by Record, so use its
                    // canonical execution spelling without reopening lookup.
                    CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, resultTerm: _) => { hasSelectedCall = true }
                    CallTemplateKind.Dynamic(receiver: _, args: _, target: _) => { hasSelectedCall = true }
                    _ => {}
                }
                if hasSelectedCall {
                    val label: Bind = self.kwSpan(kw: "key", kwLen: 3U64)
                    val args: ArgRange = self.pushArgs(args: [<Arg expr=index isInout=false labelStart=label.nameStart labelLen=label.nameLen hasLabel=true />])
                    self.arena.exprs.set(i: exprId, value: <Expr.Method recv=base nameStart=selectedName.nameStart nameLen=selectedName.nameLen args=args />)
                    self.scanExprInsts(exprId: exprId)
                    return
                }
                self.scanExprInsts(exprId: base)
                self.scanExprInsts(exprId: index)
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                mut val i: U64 = 0
                while i < fields.len {
                    self.scanExprInsts(exprId: self.makeFieldAt(fields: fields, index: i).value)
                    i += 1
                }
                // bottom-up type-argument inference for a generic construction the front
                // end did NOT ground top-down (`val r = 0 ..< n` — no annotation / return /
                // field context). We run it HERE, inside the per-function body walk, so the
                // field values' types resolve under the live env (`n`'s local type). A
                // standalone global pass has empty `cur.locals` and can't type a local
                // endpoint. On success we rewrite Make.ty to the grounded instance so both
                // this scan and the backend read the concrete type; the untyped endpoint
                // literal (`0`) then takes T from the field's declared type at construction.
                mut val gty: U64 = ty
                if !isEnum {
                    if !(self.isGenericInst(ref: gty)) {
                        val inferred: U64 = self.inferMakeInstance(typeStart: typeStart, typeLen: typeLen, fields: fields)
                        if inferred != 0U64 {
                            self.arena.exprs.set(i: exprId, value: <Expr.Make typeStart=typeStart typeLen=typeLen variantStart=variantStart variantLen=variantLen isEnum=isEnum ty=inferred fields=fields />)
                            gty = inferred
                        }
                    }
                }
                // register the constructed type's grounded instance (`<Entry[K,V] …/>`
                // under K=U64,V=U64 -> Entry_U64_U64). Without this, a construction that
                // appears only as a call argument (`xs.append(<Entry[K,V] …/>)`) — whose
                // result type no field/return scan reaches — never gets its genInst typedef.
                if gty != 0U64 {
                    self.scanType(ref: gty)
                }
                self.finalizeCurrentBodyAggregate(exprId: exprId)
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.len {
                    self.scanExprInsts(exprId: self.exprAt(exprs: elems, index: i))
                    i += 1
                }
                self.finalizeCurrentBodyAggregate(exprId: exprId)
            }
            Expr.Cast(val operand, val tyStart, val tyLen, val ty) => { self.scanExprInsts(exprId: operand) }
            Expr.OptChain(val base, val cont) => {
                self.scanExprInsts(exprId: base)
                // Collection precedes Record, so it has no parametric TypeTerm
                // from which a shared ChainSite can be formed. Record owns the
                // one destructive normalization after it has that term.
            }
            Expr.Try(val expr) => {
                self.scanExprInsts(exprId: expr)
                self.registerTryConversion(exprId: exprId, operand: expr)
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => { self.scanExprInsts(exprId: base) }
            Expr.Deref(val base) => { self.scanExprInsts(exprId: base) }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.scanExprInsts(exprId: cond)
                self.scanBlockInsts(blkId: thenBlk)
                self.scanBlockInsts(blkId: elseBlk)
            }
            Expr.MatchExpr(val scrut, val arms) => {
                // a chain-rewritten `?.` stage: register its result/factory instances
                // under the ACTIVE env — every fn instance grounds the stage anew (the
                // AST rewrite is shared; the groundings are not).
                self.registerChainSiteInsts(exprId: exprId)
                self.scanExprInsts(exprId: scrut)
                mut val scrutTi: TypeInfo = self.typeOf(id: scrut)
                val groundedScrut: U64 = self.groundedTypeOf(id: scrut)
                if groundedScrut != 0U64 {
                    scrutTi = self.typeInfoOfRef(ref: groundedScrut)
                }
                mut val ai: U64 = 0
                while ai < arms.len {
                    val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: scrutTi)
                    self.scanBlockInsts(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Expr.Move(val operand, val isBorrow) => { self.scanExprInsts(exprId: operand) }
            // `await` changes control flow at LLVM lowering, but its operand is an
            // ordinary source call in the enclosing async body's semantic surface.
            // Finalization must visit it before the resume emitter consumes the
            // completed descriptor; skipping it made `await sleep(...)` look like
            // an unrecorded call solely because it crossed the async lowering seam.
            Expr.Await(val operand) => { self.scanExprInsts(exprId: operand) }
            _ => {}
        }
    }

    // Assignment targets are places, not value reads.  In particular an Index
    // nested below a field (`xs[i].field = …`) must remain an Index so LLVM can
    // take its storage address; scanExprInsts intentionally rewrites value
    // indexes to their resolved `index` method.  Walk only the navigation path
    // here, while still scanning an index key as an ordinary value expression.
    inout fn scanPlaceInsts(exprId: U64) {
        match self.arena.exprs[exprId] {
            Expr.Field(val base, nameStart: _, nameLen: _) => {
                self.scanPlaceInsts(exprId: base)
            }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => {
                self.scanPlaceInsts(exprId: base)
            }
            Expr.Index(val base, val index) => {
                self.scanPlaceInsts(exprId: base)
                self.scanExprInsts(exprId: index)
            }
            _ => {}
        }
    }

    inout fn scanAddArmBinds(a: MatchArm, scrutTi: TypeInfo) {
        // a struct-destructure arm `S { val x }`: bind each field from the scrutinee
        // struct (mirrors codegen's addForStructBinds), so a generic call on a bound
        // field (`print(items.count())`) recovers its type.
        if a.isStruct {
            self.addForStructBinds(et: scrutTi, binds: a.binds)
            return
        }
        val genericMatch: Bool = self.isGenericEnumInst(ref: scrutTi.ref)
        mut val bi: U64 = 0
        while bi < a.binds.len {
            val bd: Bind = self.bindAt(binds: a.binds, index: bi)
            if bd.nameLen == 0U64 {
                bi += 1
                continue
            }
            if genericMatch {
                val bti: TypeInfo = self.genericEnumFieldTypeInfo(instRef: scrutTi.ref, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                if self.traceCodegen {
                    eprint(text: "[trace-codegen] match binding scrutinee=")
                    self.traceMonoTypeHead(ref: scrutTi.ref)
                    eprint(text: " payload-ref=")
                    eprintU64(n: bti.ref)
                    eprint(text: " payload-type=")
                    self.traceMonoTypeHead(ref: bti.ref)
                    eprint(text: "\n")
                }
                // carry the payload's STRUCTURED ref (a generic payload `Pong[I64]`
                // loses its args as a bare name; an array payload reconstructs its
                // `Array[E]` form) so reads of the bind recover the full type.
                self.addLocal(nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: self.typedIrRefOfInfo(ti: bti), isInout: false, isMut: false, owned: false)
            } else {
                self.addBindLocal(enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
            }
            bi += 1
        }
    }

    inout fn scanStmtInsts(stmtId: U64) {
        match self.arena.stmts[stmtId] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                // expose the annotation as the expected type while scanning the
                // initializer, so an assoc-fn constructor whose type param comes only
                // from context (`val s: Set[I64] = Set.new()`) registers its instance.
                val savedExpected: U64 = self.monoWork.scanExpectedTy
                if !(tyIsArray) {
                    self.monoWork.scanExpectedTy = ty
                }
                self.scanExprInsts(exprId: init)
                self.monoWork.scanExpectedTy = savedExpected
                // register the local with its EFFECTIVE type (inferred when there is no
                // annotation), mirroring codegen — otherwise a later `p.x` on an
                // inferred-typed `val p = <P …/>` can't recover its type, so a generic
                // call like `print(p.x + p.y)` fails to discover its instantiation.
                val le: LetEff = self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
                self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: true)
                // an INFERRED non-literal type registers its instance the same way an
                // annotation does: `val r = makeBox()` reaches Box[I64] just like
                // `val r: Box[I64] = …`. (An array-literal let registers inside
                // inferLetType itself — shared with the flat module-level walk.)
                if tyLen == 0U64 && le.ty != ty {
                    self.scanType(ref: le.ty)
                }
                // an ANNOTATED let inside a generic body needs its type scanned UNDER
                // the active instance env (scanType grounds): `val xs: Array[Box[T]]`
                // in `wrapAll[I64]` registers Array[Box[I64]] + its element — the flat
                // env-less walk only sees the parametric template, and an unregistered
                // grounded instance died as a null value at emission (mirrors the
                // grounded param scanType above).
                if ty != 0U64 {
                    self.scanType(ref: ty)
                }
            }
            Stmt.Assign(val target, val value) => {
                self.scanPlaceInsts(exprId: target)
                self.scanExprInsts(exprId: value)
            }
            Stmt.ExprStmt(val expr) => { self.scanExprInsts(exprId: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                if hasValue {
                    self.scanExprInsts(exprId: value)
                    self.finalizeCurrentBodyReturn(exprId: value)
                }
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.scanExprInsts(exprId: cond)
                self.scanBlockInsts(blkId: thenBlk)
                if hasElse {
                    self.scanBlockInsts(blkId: elseBlk)
                }
            }
            Stmt.While(val cond, val body) => {
                self.scanExprInsts(exprId: cond)
                self.scanBlockInsts(blkId: body)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
                val forMark: U64 = self.scopeMark()
                self.scanExprInsts(exprId: iter)
                if isRange {
                    self.scanExprInsts(exprId: rangeHi)
                    // type the loop var so generic calls on it in the body (`print(i)`)
                    // ground: the annotation if given, else the bound's own type.
                    mut val rtS: U64 = varTyStart
                    mut val rtL: U64 = varTyLen
                    if rtL == 0 {
                        val bt: TypeInfo = self.typeOf(id: rangeHi)
                        if bt.kind == 0 {
                            rtS = bt.nameStart
                            rtL = bt.nameLen
                        }
                    }
                    self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: rtS, tyLen: rtL, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    // `for` is syntax for the Iterable/Iterator protocol.  It
                    // has no written Method AST nodes, so select both implicit
                    // calls here and retain them under the statement site. LLVM
                    // subsequently receives only these Func identities.
                    val useProtocolTemplate: Bool = self.hasProtocolCallTemplate(stmtId: stmtId, slot: 1U64)
                    mut val initialRef: U64 = 0U64
                    if useProtocolTemplate {
                        initialRef = self.groundedProtocolTemplateReceiver(stmtId: stmtId, slot: 1U64)
                    } else {
                        // Provisional reachability collection only. Its output
                        // is cleared by finalizeCallables; this AST recovery
                        // must never publish a final CallResolution.
                        initialRef = self.groundedBodyReceiverRef(exprId: iter)
                        if initialRef == 0U64 {
                            initialRef = self.bodyCalleeResultRef(exprId: iter)
                        }
                    }
                    mut val iteratorRef: U64 = initialRef
                    if initialRef != 0U64 && initialRef < self.arena.types.count() && !(self.arena.types[initialRef].isAny) {
                        val noArgs: Array[Arg] = []
                        val iteratorName: Bind = self.kwSpan(kw: "iterator", kwLen: 8U64)
                        mut val iteratorFn: U64 = self.arena.funcs.count()
                        if useProtocolTemplate {
                            iteratorFn = self.resolveProtocolMethodForReceiver(recvRef: initialRef, nameStart: iteratorName.nameStart, nameLen: iteratorName.nameLen, args: self.pushArgs(args: noArgs))
                        } else {
                            iteratorFn = self.resolveBodyMethodForRef(recv: iter, recvRef: initialRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: iteratorName.nameStart, nameLen: iteratorName.nameLen, args: self.pushArgs(args: noArgs), useOffset: 0U64)
                        }
                        iteratorRef = initialRef
                        // Record the iterator slot even when this value is already
                        // an Iterator.  The sentinel tells LLVM that there is no
                        // iterator() call; it must not rediscover that fact from
                        // the receiver spelling.  Only that sentinel case is an
                        // identity call.  A real `iterator()` has a distinct
                        // carrier (for example Array[T] -> ArrayIter[T]), so leave
                        // its source result absent and let completeStaticBodyCallee
                        // publish the selected callee return as the one result.
                        mut val iteratorResult: U64 = 0U64
                        if iteratorFn >= self.arena.funcs.count() {
                            iteratorResult = initialRef
                        }
                        val iteratorSelection: CallSiteSelection = <CallSiteSelection exprId=stmtId siteIsStmt=true slot=1U64 callee=iteratorFn receiverRef=initialRef resultRef=iteratorResult resultHintRef=initialRef />
                        self.recordSelectedBodyCallee(selection: iteratorSelection)
                        if iteratorFn < self.arena.funcs.count() {
                            self.enqueueSelectedCallee(selection: iteratorSelection)
                            // `iterator()` has just been finalized under this
                            // concrete body instance.  Its descriptor result
                            // is the sole authority for the next receiver:
                            // recomputing `Func.retTy` here loses the distinct
                            // substitutions owned by a generic receiver and a
                            // provided method, turning Array[I64] into
                            // ArrayIter[T].
                            val returned: U64 = self.bodyCalleeResultRef(exprId: stmtId, siteIsStmt: true, slot: 1U64)
                            if returned != 0U64 { iteratorRef = returned }
                        }
                        val nextName: Bind = self.kwSpan(kw: "next", kwLen: 4U64)
                        mut val nextFn: U64 = self.arena.funcs.count()
                        if useProtocolTemplate {
                            nextFn = self.resolveProtocolMethodForReceiver(recvRef: iteratorRef, nameStart: nextName.nameStart, nameLen: nextName.nameLen, args: self.pushArgs(args: noArgs))
                        } else {
                            nextFn = self.resolveBodyMethodForRef(recv: iter, recvRef: iteratorRef, sourceId: 0U64, sourceOwner: 0U64, nameStart: nextName.nameStart, nameLen: nextName.nameLen, args: self.pushArgs(args: noArgs), useOffset: 0U64)
                        }
                        val nextSelection: CallSiteSelection = <CallSiteSelection exprId=stmtId siteIsStmt=true slot=2U64 callee=nextFn receiverRef=iteratorRef resultHintRef=iteratorRef />
                        self.recordSelectedBodyCallee(selection: nextSelection)
                        if nextFn < self.arena.funcs.count() {
                            self.enqueueSelectedCallee(selection: nextSelection)
                        }
                    } else if initialRef != 0U64 {
                        // Dynamic existential protocol calls have no static Func
                        // body to enqueue, but their concrete `any P` receiver is
                        // still part of the final call-site contract.  Retain both
                        // slots so LLVM consumes the same source type rather than
                        // recovering it from the expression tree.
                        val none: U64 = self.arena.funcs.count()
                        self.recordSelectedBodyCallee(selection: <CallSiteSelection exprId=stmtId siteIsStmt=true slot=1U64 callee=none receiverRef=initialRef />)
                        val nextName: Bind = self.kwSpan(kw: "next", kwLen: 4U64)
                        val noArgs: Array[Arg] = []
                        val traitIdx: U64 = self.finalAnyTraitIdx(anyRef: initialRef)
                        val nextSlot: U64 = self.finalAnyRequirementSlot(anyRef: initialRef, nameStart: nextName.nameStart, nameLen: nextName.nameLen, args: self.pushArgs(args: noArgs))
                        if traitIdx >= self.decls.traits.count() || nextSlot == 0U64 {
                            self.errorAt(offset: 0U64, msg: "internal diagnostic: final existential iterator target was not finalized")
                        } else {
                            val nextReq: Func = self.traitReqAt(reqs: self.decls.traits[traitIdx].reqs, index: nextSlot - 1U64)
                            self.recordSelectedBodyCallee(selection: <CallSiteSelection exprId=stmtId siteIsStmt=true slot=2U64 callee=none receiverRef=initialRef resultRef=self.anyMemberRetInfo(anyRef: initialRef, req: nextReq).ref target=<CallTarget.ExistentialRequirement traitIdx=traitIdx slot=nextSlot /> />)
                        }
                    }
                    val et: TypeInfo = self.typeOf(id: iter)
                    // The Record pass and this instance scan introduce the
                    // same source binding.  Both must consume the one
                    // proof-derived Item TypeTerm, rather than letting Mono
                    // reconstruct a second, legacy TypeInfo approximation.
                    // `iteratorRef` is the final body-instance receiver: it
                    // also covers an Iterable whose implicit iterator() call
                    // changed the concrete iterator type.
                    mut val semanticItem: U64 = 0U64
                    if useProtocolTemplate {
                        val itemRecipe: U64 = self.forItemTypeRecipe(stmtId: stmtId)
                        if itemRecipe == 0U64 {
                            self.errorAt(offset: 0U64, msg: "internal diagnostic: final for binding type recipe was not recorded")
                        } else {
                            semanticItem = self.groundSemanticTypeRecipe(recipeId: itemRecipe)
                            if semanticItem == 0U64 {
                                self.errorAt(offset: 0U64, msg: "internal diagnostic: final for binding type recipe did not ground")
                            }
                        }
                    } else {
                        // Provisional collection has no Record contract yet.
                        // Its selections are discarded before backend emission.
                        semanticItem = self.iterableItemTerm(iterExpr: iter, iterTerm: iteratorRef)
                    }
                    if semanticItem != 0U64 {
                        val itemTi: TypeInfo = self.typeInfoOfRef(ref: semanticItem)
                        if isStruct {
                            self.addForStructBinds(et: itemTi, binds: binds)
                        } else {
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: itemTi.nameStart, tyLen: itemTi.nameLen, isArray: itemTi.kind == 3, ty: semanticItem, isInout: false, isMut: false, owned: false)
                        }
                    } else if isStruct {
                        self.addForStructBinds(et: et, binds: binds)
                    } else {
                        if et.kind == 3 {
                            // A loop variable over Array[E] has E's full
                            // structured type.  In particular E may be a
                            // closure `fn(...) -> R`; dropping its TypeRef
                            // here made `for f in fs { f() }` look like an
                            // unresolved free-function call downstream.
                            // `initialRef` is the final, body-grounded iterable
                            // identity.  Prefer its Array element over the
                            // legacy TypeInfo name projection: the latter loses
                            // `Optional[I64]` versus `Optional[String]` when
                            // two generic enum arrays occur in one body.
                            mut val elemRef: U64 = 0U64
                            if initialRef != 0U64 && initialRef < self.arena.types.count() {
                                val initialTy: TypeRef = self.arena.types[initialRef]
                                if rangeEquals(bytes: self.arena.bytes, start: initialTy.nameStart, len: initialTy.nameLen, kw: "Array") && initialTy.args.count() > 0U64 {
                                    elemRef = initialTy.args[0]
                                }
                            }
                            if elemRef == 0U64 {
                                elemRef = self.arrayElemRef(start: et.nameStart, len: et.nameLen)
                            }
                            if elemRef == 0U64 && et.ref != 0U64 && et.ref < self.arena.types.count() {
                                val arrRef: TypeRef = self.arena.types[et.ref]
                                if arrRef.args.count() > 0U64 { elemRef = arrRef.args[0] }
                            }
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: elemRef, isInout: false, isMut: false, owned: false)
                        } else {
                            // The selected implicit `next()` descriptor is the
                            // concrete iterator proof for this body instance.
                            // Its `Optional[Item]` result retains substitutions
                            // that AST-wide `iterableItemInfo` necessarily loses
                            // for a generic adapter chain.
                            mut val itemRef: U64 = 0U64
                            if iteratorRef != 0U64 && iteratorRef < self.arena.types.count() {
                                val iteratorTy: TypeRef = self.arena.types[iteratorRef]
                                // `for` is defined by the Iterator contract.
                                // Its associated output is therefore selected
                                // from the concrete conformance witness before
                                // consulting the requirement body's legacy
                                // template return type.
                                itemRef = self.assocItemRef(recvStart: iteratorTy.nameStart, recvLen: iteratorTy.nameLen, recvInstRef: iteratorRef)
                            }
                            val nextResult: U64 = self.bodyCalleeResultRef(exprId: stmtId, siteIsStmt: true, slot: 2U64)
                            if itemRef == 0U64 && nextResult != 0U64 && nextResult < self.arena.types.count() {
                                val nextTy: TypeRef = self.arena.types[nextResult]
                                if rangeEquals(bytes: self.arena.bytes, start: nextTy.nameStart, len: nextTy.nameLen, kw: "Optional") && nextTy.args.count() == 1U64 {
                                    itemRef = nextTy.args[0]
                                }
                            }
                            if itemRef != 0U64 {
                                val itemTi: TypeInfo = self.typeInfoOfRef(ref: itemRef)
                                self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: itemTi.nameStart, tyLen: itemTi.nameLen, isArray: itemTi.kind == 3, ty: itemRef, isInout: false, isMut: false, owned: false)
                            } else {
                                val elemTi: TypeInfo = self.iterableItemInfo(et: et)
                                self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                            }
                        }
                    }
                }
                self.scanBlockInsts(blkId: body)
                self.popLocals(mark: forMark)
            }
            Stmt.Match(val scrut, val arms) => {
                self.scanExprInsts(exprId: scrut)
                self.finalizeCurrentBodyMatch(stmtId: stmtId)
                // Match-arm bindings are typed from the concrete scrutinee
                // instance.  `typeOf` is AST-global and loses `Optional[I64]`
                // for a local loop item; use the body-local/grounded recovery
                // just as Expr.MatchExpr does above.
                mut val scrutTi: TypeInfo = self.exprType(id: scrut)
                // A match scrutinee is often a local introduced by `for` or a
                // prior arm.  Its exact instance lives in the body-local
                // environment; AST-global type recovery is only the fallback.
                mut val groundedScrut: U64 = self.groundedBodyReceiverRef(exprId: scrut)
                if groundedScrut == 0U64 {
                    groundedScrut = self.groundedTypeOf(id: scrut)
                }
                if groundedScrut != 0U64 {
                    scrutTi = self.typeInfoOfRef(ref: groundedScrut)
                }
                mut val ai: U64 = 0
                while ai < arms.len {
                    val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: scrutTi)
                    self.scanBlockInsts(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Stmt.Panic(val msg, val offset) => { self.scanExprInsts(exprId: msg) }
            Stmt.Give(val value) => { self.scanExprInsts(exprId: value) }
            Stmt.Break(offset: _) => {}
            Stmt.Continue(offset: _) => {}
        }
    }

    inout fn scanBlockInsts(blkId: U64) {
        val mark: U64 = self.scopeMark()
        mut val i: U64 = 0
        while i < self.blockStmtCount(blkId: blkId) {
            self.scanStmtInsts(stmtId: self.blockStmtAt(blkId: blkId, index: i))
            i += 1
        }
        self.popLocals(mark: mark)
    }

    inout fn scanGenInstMethodBodies() {
        mut val gi: U64 = 0
        while gi < self.monoWork.genInsts.count() {
            val instRef: U64 = self.monoWork.genInsts[gi]
            val inst: TypeRef = self.arena.types[instRef]
            // Array A: Array's own generic methods (append/get/set/removeLast, pure Plew
            // over self.data) are scanned like any other generic instance, so the transitive
            // `Buffer[T]` method instances their bodies call get discovered and declared.
            mut val mfi: U64 = 0
            while mfi < self.arena.funcs.count() {
                val mf: Func = self.arena.funcs[mfi]
                if self.methodMatchesInst(f: mf, instRef: instRef) {
                    // provided combinators (`map[B]`) instantiate from call sites, not here.
                    if !(mf.isProvided) && !(self.methodRecvIsTrait(f: mf)) {
                        if mf.body != 0 {
                            self.cur.locals = []
                            self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: mf))
                            self.cur.hasRecv = true
                            self.cur.recvStart = mf.recvStart
                            self.cur.recvLen = mf.recvLen
                            self.cur.extId = mf.extId
                            self.cur.selfInout = mf.selfInout
                            self.cur.recvInstRef = instRef
                            self.cur.typeParams = self.copyFuncBinds(binds: mf.typeParams)
                            self.cur.typeArgs = inst.args
                            self.cur.bodyFnIdx = mfi
                            self.cur.bodyEnvironment = self.bodyInstanceEnvironment(fnIdx: mfi, args: inst.args, recvInstRef: instRef)
                            self.cur.bodyId = 0U64
                            self.setSelfItemEnv(recvStart: mf.recvStart, recvLen: mf.recvLen, recvInstRef: instRef)
                            self.cur.bodySelfRef = self.cur.selfRef
                            self.cur.bodyItemRef = self.cur.itemRef
                            mut val pi: U64 = 0
                            while pi < mf.params.count() {
                                val p: Param = self.funcParamAt(params: mf.params, index: pi)
                                self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                                self.scanType(ref: p.ty)
                                pi += 1
                            }
                            if mf.hasRet {
                                self.scanType(ref: mf.retTy)
                            }
                            self.scanBlockInsts(blkId: mf.body)
                            self.clearSelfItemEnv()
                        }
                    }
                }
                mfi += 1
            }
            gi += 1
        }
        val noP: Array[Bind] = []
        val noA: Array[U64] = []
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.recvInstRef = 0
        self.cur.typeParams = noP
        self.cur.typeArgs = noA
        self.cur.bodyFnIdx = 18446744073709551615U64
        self.cur.bodyEnvironment = <InstanceEnvironment />
        self.cur.bodyId = 0U64
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
    }
}
