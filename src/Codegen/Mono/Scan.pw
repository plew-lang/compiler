// Part of monomorphization (root: _.pw): TypeInfo extraction and field-type
// substitution.

// TypeInfo of a fully-concrete TypeRef (for literal-context checking and the
// field/index/method dispatch). Generic instantiations report as kind-2 named
// (the head span); nested generic field types are deferred (G2a).

pub impl Comp {
    inout fn typeInfoOfRef(ref: U64) -> TypeInfo {
        val t: TypeRef = self.arena.types[ref]
        // A projection is a structured semantic term even when its receiver
        // has no ordinary type arguments.  Do not collapse
        // `Parser#Convert[T].Output` to a bare Parser TypeInfo: generic-body
        // compatibility must retain the trait instance and associated member.
        if t.assocNameId != 0U64 {
            return <TypeInfo kind=2 nameStart=t.nameStart nameLen=t.nameLen ref=ref viewExtId=t.viewExtId />
        }
        if t.args.count() == 0 {
            // an argless existential (`any Dup`): the isAny ref IS the type identity —
            // name-only recovery would degrade it to the plain trait name.
            if t.isAny {
                return <TypeInfo kind=2 nameStart=t.nameStart nameLen=t.nameLen ref=ref viewExtId=t.viewExtId />
            }
            val base: TypeInfo = self.typeInfoOfName(start: t.nameStart, len: t.nameLen, isArray: false)
            // A lexical type parameter is a semantic term, not merely a spelling.
            // Keep its ref even though its scalar TypeInfo has no runtime shape:
            // otherwise `Buffer[E][i]` reconstructs a fresh name-only `E`, losing
            // ParamId before the enclosing generic body can substitute it.
            if t.paramId != 0U64 {
                return <TypeInfo kind=base.kind nameStart=base.nameStart nameLen=base.nameLen ref=ref viewExtId=t.viewExtId />
            }
            // carry the view (`Person#Ext` has no args but a viewExtId) so recovery is
            // not lossy; the `ref`-shape is unchanged so downstream behavior is identical.
            if t.viewExtId != 0U64 || t.viewIds.count() > 0U64 {
                return <TypeInfo kind=base.kind nameStart=base.nameStart nameLen=base.nameLen ref=base.ref viewExtId=t.viewExtId />
            }
            return base
        }
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
            // kind 3 (element by name) as everywhere, but CARRY the structured
            // `Array[E]` ref alongside (TOTAL-REF, same as the array-local branch):
            // a field/method on an Array-typed `Self` value (`lhs.data` in Array's
            // own Eq witness) needs the instance ref to resolve.
            val el: TypeRef = self.arena.types[t.args[0]]
            val ab: TypeInfo = self.typeInfoOfName(start: el.nameStart, len: el.nameLen, isArray: true)
            return <TypeInfo kind=3 nameStart=ab.nameStart nameLen=ab.nameLen ref=ref />
        }
        // a compound type (`Ref[T]`, `Box[I32]`, `Optional[I32]`): keep its structured
        // ref so downstream `->`/`.field`/method resolution can recover the pointee or
        // instantiation arguments (dropping it loses generic/Ref-ness).
        return <TypeInfo kind=2 nameStart=t.nameStart nameLen=t.nameLen ref=ref viewExtId=t.viewExtId />
    }

    inout fn iterableItemInfo(et: TypeInfo) -> TypeInfo {
        val noArgs: Array[Arg] = []
        // an existential iterand (`for x in it` with `it: any Iter2[Item=I64]`,
        // spec/08): the item is the trait's `next` requirement return
        // (`Optional[Item]`) grounded under the existential's bindings.
        if et.ref != 0U64 && et.ref < self.arena.types.count() {
            if self.arena.types[et.ref].isAny {
                val atri: U64 = self.findTraitIdxByName(start: et.nameStart, len: et.nameLen)
                if atri < self.decls.traits.count() {
                    val nxq: Bind = self.kwSpan(kw: "next", kwLen: 4)
                    val nxId: U64 = intern(c: inout self, start: nxq.nameStart, len: nxq.nameLen)
                    val areqs: Array[Func] = self.decls.traits[atri].reqs
                    mut val ari: U64 = 0
                    while ari < areqs.count() {
                        if areqs[ari].nameId == nxId {
                            val oi: TypeInfo = self.anyMemberRetInfo(anyRef: et.ref, req: areqs[ari])
                            if oi.ref != 0U64 && oi.ref < self.arena.types.count() {
                                val ot2: TypeRef = self.arena.types[oi.ref]
                                if ot2.args.count() > 0U64 {
                                    return self.typeInfoOfRef(ref: ot2.args[0])
                                }
                            }
                            return scalarInfo()
                        }
                        ari += 1
                    }
                }
                return scalarInfo()
            }
        }
        // Iterable: iterator() returns the iterator; bare Iterator: the iterand is the
        // iterator (so `for v in xs.filter(p)` recovers the right element type).
        val itName: Bind = self.kwSpan(kw: "iterator", kwLen: 8)
        val imi: U64 = self.findMethod(recvStart: et.nameStart, recvLen: et.nameLen, nameStart: itName.nameStart, nameLen: itName.nameLen, args: self.pushArgs(args: noArgs))
        mut val itRef: U64 = et.ref
        mut val nrStart: U64 = et.nameStart
        mut val nrLen: U64 = et.nameLen
        if imi != self.arena.funcs.count() {
            val imf: Func = self.arena.funcs[imi]
            itRef = self.groundUnderInst(instRef: et.ref, tyRef: imf.retTy)
            nrStart = imf.retStart
            nrLen = imf.retLen
        }
        val nxName: Bind = self.kwSpan(kw: "next", kwLen: 4)
        val nmi: U64 = self.findMethod(recvStart: nrStart, recvLen: nrLen, nameStart: nxName.nameStart, nameLen: nxName.nameLen, args: self.pushArgs(args: noArgs))
        if nmi == self.arena.funcs.count() {
            return scalarInfo()
        }
        val nmf: Func = self.arena.funcs[nmi]
        // resolve Optional[Item] through the iterand's instantiation (Box[I64] ->
        // BoxIter[I64] -> Optional[I64]) so a generic iterand yields the concrete Item.
        val optRef: U64 = self.groundUnderInst(instRef: itRef, tyRef: nmf.retTy)
        if optRef < self.arena.types.count() {
            val ot: TypeRef = self.arena.types[optRef]
            if ot.args.count() > 0 {
                return self.typeInfoOfRef(ref: ot.args[0])
            }
        }
        return scalarInfo()
    }

    inout fn groundedArrayFieldInfo(params: Array[Bind], instArgs: Array[U64], arrayTyRef: U64) -> TypeInfo {
        val at: TypeRef = self.arena.types[arrayTyRef]
        if at.args.count() == 0 {
            return self.typeInfoOfRef(ref: arrayTyRef)
        }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        self.cur.typeParams = params
        self.cur.typeArgs = instArgs
        val grounded: U64 = self.groundTypeRef(ref: at.args[0])
        // carry the STRUCTURED `Array[<grounded elem>]` ref alongside the kind-3
        // element-name view (a compound element's name is a mangle — `Entry_K_V` —
        // so without the ref, downstream element recovery re-interns the mangle as
        // a meaningless name-ref). Existing kind-3 consumers key off the kind and
        // the element name; the ref only ADDS recoverable structure.
        val aref: U64 = self.arrayRefOfElem(elemRef: grounded)
        mut val ti: TypeInfo = scalarInfo()
        if self.isCompoundType(ref: grounded) {
            val mn: Bind = self.appendMangleSpan(ref: grounded)
            ti = <TypeInfo kind=3 nameStart=mn.nameStart nameLen=mn.nameLen ref=aref />
        } else {
            val gt: TypeRef = self.arena.types[grounded]
            ti = <TypeInfo kind=3 nameStart=gt.nameStart nameLen=gt.nameLen ref=aref />
        }
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        return ti
    }

    inout fn substTypeInfo(instRef: U64, params: Array[Bind], tyRef: U64) -> TypeInfo {
        val t: TypeRef = self.arena.types[tyRef]
        // an `Array[E]` field: ground E (which may be a bare param `T` or a compound
        // `Box[T]`) through the instance env so the use site names the concrete runtime.
        if t.args.count() > 0 {
            if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                return self.groundedArrayFieldInfo(params: params, instArgs: self.arena.types[instRef].args, arrayTyRef: tyRef)
            }
        }
        mut val i: U64 = 0
        while i < params.count() {
            val p: Bind = params[i]
            if t.nameId == p.nameId {
                val inst: TypeRef = self.arena.types[instRef]
                if i < inst.args.count() {
                    return self.typeInfoOfRef(ref: inst.args[i])
                }
            }
            i += 1
        }
        return self.typeInfoOfRef(ref: tyRef)
    }

    // Legacy TypeInfo projection. It remains until TypeInfo itself is retired:
    // scalar TypeInfo intentionally has no TypeRef payload, so it cannot be the
    // carrier for an exact chained field type.
    inout fn genericFieldTypeInfo(instRef: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
        val t: TypeRef = self.arena.types[instRef]
        val si: U64 = self.genericStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if si >= self.arena.structs.count() { return scalarInfo() }
        val s: StructDef = self.arena.structs[si]
        val fields: Array[FieldDef] = s.fields
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val i: U64 = 0U64
        while i < fields.count() {
            val fd: FieldDef = fields[i]
            if fd.nameId == qField {
                val ftr: TypeRef = self.arena.types[fd.ty]
                mut val pi: U64 = 0U64
                while pi < s.typeParams.count() {
                    val p: Bind = s.typeParams[pi]
                    if ftr.nameId == p.nameId { return self.typeInfoOfRef(ref: t.args[pi]) }
                    pi += 1U64
                }
                if rangeEquals(bytes: self.arena.bytes, start: ftr.nameStart, len: ftr.nameLen, kw: "Array") && ftr.args.count() > 0U64 {
                    return self.groundedArrayFieldInfo(params: s.typeParams, instArgs: t.args, arrayTyRef: fd.ty)
                }
                return self.typeInfoOfRef(ref: self.groundUnderInst(instRef: instRef, tyRef: fd.ty))
            }
            i += 1U64
        }
        return scalarInfo()
    }

    // Exact semantic field term. Unlike the legacy projection above, this is
    // suitable for a later field selection: `Holder[I32].pair.a` retains the
    // already-grounded record term instead of re-reading its declaration `T`.
    inout fn fieldTypeRefOfReceiver(receiverRef: U64, fieldStart: U64, fieldLen: U64) -> U64 {
        if receiverRef == 0U64 || receiverRef >= self.arena.types.count() { return 0U64 }
        val t: TypeRef = self.arena.types[receiverRef]
        // Record selection is a direct TypeTerm child query.  In particular,
        // `(index: U64, value: E).value` retains `E` without reopening the
        // synthetic layout StructDef or parsing its canonical name.
        if t.isRecord {
            val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
            if t.recordFieldLabels.count() != t.recordFieldTerms.count() { return 0U64 }
            mut val ri: U64 = 0U64
            while ri < t.recordFieldLabels.count() {
                if t.recordFieldLabels[ri] == qField { return t.recordFieldTerms[ri] }
                ri += 1U64
            }
            return 0U64
        }
        val si: U64 = self.anyStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if si >= self.arena.structs.count() { return 0U64 }
        val fields: Array[FieldDef] = self.arena.structs[si].fields
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val i: U64 = 0U64
        while i < fields.count() {
            val fd: FieldDef = fields[i]
            if fd.nameId == qField { return self.groundUnderInst(instRef: receiverRef, tyRef: fd.ty) }
            i += 1U64
        }
        return 0U64
    }

    // The same frontend field selection also supplies a physical slot for
    // MidPlace.Field.  A missing field returns the field-count sentinel; the
    // caller records it only after `fieldTypeRefOfReceiver` established that
    // the source field is valid.  Record/tuple projections have a separate
    // layout path and intentionally do not enter the first nominal-struct Mid
    // slice.
    inout fn fieldIndexOfReceiver(receiverRef: U64, fieldStart: U64, fieldLen: U64) -> U64 {
        if receiverRef == 0U64 || receiverRef >= self.arena.types.count() { return 0U64 }
        val t: TypeRef = self.arena.types[receiverRef]
        if t.isRecord { return 0U64 }
        val si: U64 = self.anyStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if si >= self.arena.structs.count() { return 0U64 }
        val fields: Array[FieldDef] = self.arena.structs[si].fields
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val i: U64 = 0U64
        while i < fields.count() {
            if fields[i].nameId == qField { return i }
            i += 1U64
        }
        return fields.count()
    }

    inout fn genericEnumFieldTypeInfo(instRef: U64, variantStart: U64, variantLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
        val t: TypeRef = self.arena.types[instRef]
        val ei: U64 = self.genericEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if ei >= self.arena.enums.count() {
            return scalarInfo()
        }
        val e: EnumDef = self.arena.enums[ei]
        val vars: Array[Variant] = e.variants
        val qVar: U64 = intern(c: inout self, start: variantStart, len: variantLen)
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val vi: U64 = 0
        while vi < vars.count() {
            val v: Variant = vars[vi]
            if v.nameId == qVar {
                val fs: Array[FieldDef] = v.fields
                mut val fi: U64 = 0
                while fi < fs.count() {
                    val fd: FieldDef = fs[fi]
                    if fd.nameId == qField {
                        // Variant fields use the same declaration-to-instance
                        // substitution as struct fields.  Keeping a separate
                        // `nameId` loop here made reconstructed `T` refs (whose
                        // cache id is 0) escape only through match bindings.
                        return self.typeInfoOfRef(ref: self.groundUnderInst(instRef: instRef, tyRef: fd.ty))
                    }
                    fi += 1
                }
            }
            vi += 1
        }
        return scalarInfo()
    }

    inout fn methodMatchesInst(f: Func, instRef: U64) -> Bool {
        if !(f.hasRecv) {
            return false
        }
        if f.typeParams.count() == 0 {
            return false
        }
        val inst: TypeRef = self.arena.types[instRef]
        if f.recvId != intern(c: inout self, start: inst.nameStart, len: inst.nameLen) {
            return false
        }
        return f.typeParams.count() == inst.args.count()
    }

    // A generic associated conformance witness has no value receiver, yet the
    // backend may emit it when materializing the witness table for a reached
    // receiver instance.  It therefore belongs to the same frontend body
    // reachability closure as a generic value method.  `isProvided` copies are
    // selected through CallResolution (their lexical trait body is shared), so
    // this predicate intentionally covers only the authored witness body.
    inout fn assocWitnessMatchesInst(f: Func, instRef: U64) -> Bool {
        if !(f.isAssoc) || f.isProvided || f.typeParams.count() == 0U64 { return false }
        val inst: TypeRef = self.arena.types[instRef]
        if f.recvId != intern(c: inout self, start: inst.nameStart, len: inst.nameLen) {
            return false
        }
        if f.typeParams.count() != inst.args.count() { return false }
        // Reaching a generic layout does not itself establish every
        // conditional conformance declared on that layout. In particular,
        // `Buffer[NoEq]` is a valid value type while the `Buffer[T] as Eq
        // where T: Eq` witness is absent. Only materialize an associated
        // witness body when its declared trait instance is actually proven
        // for this concrete receiver; otherwise LLVM would emit the abstract
        // `T == T` body without a witness.
        if f.originTraitOwner == 0U64 { return false }
        val constraint: TraitConstraint = <TraitConstraint key=<TraitInstanceKey owner=f.originTraitOwner positionalArgs=f.recvTraitArgs /> positionalArgsOpen=false assocPredicates=[] />
        return self.viewedTypeConformsTraitConstraint(ref: instRef, constraint: constraint)
    }
}
