// One proof interpretation frontier. Static clients can obtain only concrete
// results; an interface's universally scoped guarantee cannot become Ready.
pub impl Comp {
    inout fn instantiateConstraintProof(proof: StaticConformanceProof, receiverRef: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64, normalizations: Array[ProjectionNormalizationStep] = []) -> Result[StaticProofInstantiation, CompileDiagnostic] {
        try self.checkProjectionNormalizations(normalizations: normalizations, offset: 0U64)
        match (try self.replayConstraintProof(proof: proof, receiver: receiverRef, environment: environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.None />, normalizations: normalizations)) {
            ConstraintProofReplay.Missing => { return <Result.Ok value=<StaticProofInstantiation.Missing /> /> }
            ConstraintProofReplay.Deferred => { return <Result.Ok value=<StaticProofInstantiation.Deferred /> /> }
            ConstraintProofReplay.Concrete(proof: val proof) => { return <Result.Ok value=<StaticProofInstantiation.Ready proof=proof /> /> }
            ConstraintProofReplay.Universal(proof: _) => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "universal interface evidence cannot authorize a static callable") /> }
        }
    }

    inout fn instantiateProjectionNormalizations(normalizations: Array[ProjectionNormalizationStep], environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[Optional[Array[ProjectionNormalizationStep]], CompileDiagnostic] {
        return self.replayProjectionEquations(saved: normalizations, environment: environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.None />, inherited: [])
    }

}

impl Comp {
    inout fn instantiateSelectedSupertraitConstraint(proof: StaticConformanceProof, steps: Array[SupertraitRef], receiverRef: U64, normalizations: Array[ProjectionNormalizationStep] = []) -> Result[StaticProofInstantiation, CompileDiagnostic] {
        match (try self.replaySelectedSupertraits(proof: proof, steps: steps, receiver: receiverRef, normalizations: normalizations)) {
            ConstraintProofReplay.Concrete(proof: val selected) => { return <Result.Ok value=<StaticProofInstantiation.Ready proof=selected /> /> }
            ConstraintProofReplay.Deferred => { return <Result.Ok value=<StaticProofInstantiation.Deferred /> /> }
            ConstraintProofReplay.Missing => { return <Result.Ok value=<StaticProofInstantiation.Missing /> /> }
            ConstraintProofReplay.Universal(proof: _) => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "universal supertrait evidence cannot authorize a static callable", failureDomain: <FailureDomain.Internal />) /> }
        }
    }

    inout fn replaySelectedSupertraits(proof: StaticConformanceProof, steps: Array[SupertraitRef], receiver: U64, normalizations: Array[ProjectionNormalizationStep] = [], declaration: Bool = false) -> Result[ConstraintProofReplay, CompileDiagnostic] {
        try self.checkProjectionNormalizations(normalizations: normalizations, offset: 0U64)
        mut val current = proof
        for index in 0U64..<steps.count() {
            if declaration {
                match current {
                    StaticConformanceProof.AssumedBound(source: val source) => {
                        mut val path: Array[SupertraitRef] = []
                        for remaining in index..<steps.count() { path.append(steps[remaining]) }
                        return <Result.Ok value=<ConstraintProofReplay.Universal proof=<StaticConformanceProof.AssumedSupertraitPath source=source steps=path /> /> />
                    }
                    StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val prefix) => {
                        mut val path = prefix
                        for remaining in index..<steps.count() { path.append(steps[remaining]) }
                        return <Result.Ok value=<ConstraintProofReplay.Universal proof=<StaticConformanceProof.AssumedSupertraitPath source=source steps=path /> /> />
                    }
                    _ => {}
                }
            }
            val step = steps[index]
            val terminal = if declaration { give self.retainedConstraintPathTerminal(proof: current) } else { give self.selectedConstraintWitness(proof: current) }
            val witness = match terminal {
                Optional.Some(v: val witness) => { give witness }
                Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "supertrait root has no retained concrete witness") /> }
            }
            if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "supertrait root has an invalid conformance") /> }
            val owner = self.decls.conformAt(index: witness.conformIdx - 1U64)
            if self.resolveTraitDef(cf: owner) != step.traitIndex { return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "supertrait edge belongs to another trait") /> }
            val saved = match self.arena.conformanceSupertraitProof(conformance: witness.conformIdx - 1U64, clause: step.boundIndex) {
                Optional.Some(v: val proof) => { give proof }
                Optional.None => { return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "supertrait edge has no retained declaration evidence") /> }
            }
            val selectedEnvironment = try self.selectedConstraintEnvironment(witness: witness, proof: current)
            val state = try self.replayConstraintProof(proof: self.thawStaticConformanceProof(id: saved), receiver: receiver, environment: selectedEnvironment, selfRef: witness.selfRef, itemRef: 0U64, context: <Optional.None />, normalizations: normalizations, declaration: declaration)
            match state {
                ConstraintProofReplay.Concrete(proof: val proof) => { current = proof }
                ConstraintProofReplay.Universal(proof: val proof) => {
                    if !declaration { return <Result.Err error=self.diagnosticAt(offset: owner.typeStart, msg: "universal supertrait evidence cannot authorize a static callable", failureDomain: <FailureDomain.Internal />) /> }
                    current = proof
                }
                _ => { return <Result.Ok value=state /> }
            }
        }
        if declaration { return <Result.Ok value=<ConstraintProofReplay.Universal proof=current /> /> }
        return <Result.Ok value=<ConstraintProofReplay.Concrete proof=current /> />
    }

    // The caller has instantiated the source projection once. The clause row
    // belongs to the selected impl; a caller substitution is not its authority.
    inout fn replaySelectedAssociatedConstraint(index: U64, selected: StaticConformanceProof, projectionRef: U64, receiverRef: U64, context: Optional[InterfaceProofContext], inherited: Array[ProjectionNormalizationStep], declaration: Bool = false) -> Result[ConstraintProofReplay, CompileDiagnostic] {
        if index >= self.arena.associatedBoundEvidenceCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "associated constraint has no original clause") /> }
        val evidence = self.arena.associatedBoundEvidenceAt(index: index)
        val original = try self.associatedClauseBound(projectionRef: evidence.projection, clauseIndex: evidence.clause, prerequisite: evidence.prerequisite, offset: evidence.bound.offset)
        if !self.typeRefEq(a: original.subject, b: evidence.bound.subject) || !self.sameTraitConstraint(a: original.constraint, b: evidence.bound.constraint) { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint differs from its original declaration") /> }
        if projectionRef == 0U64 || projectionRef >= self.arena.typeCount() { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has an invalid instance projection") /> }
        val instanceProjection = try self.replayProjectionChildren(ref: projectionRef, normalizations: inherited, offset: evidence.bound.offset)
        val projection = self.arena.typeAt(index: instanceProjection)
        val authored = self.arena.typeAt(index: evidence.projection)
        val owner = self.associatedProjectionTraitOwner(projection: projection)
        if projection.assocNameId != authored.assocNameId || owner != self.associatedProjectionTraitOwner(projection: authored) { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has a foreign instance member") /> }
        val traitIndex = self.decls.traitIndexByOffset(offset: owner)
        if traitIndex >= self.decls.traitCount() { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has an invalid trait owner") /> }
        val trait = self.decls.traitAt(index: traitIndex)
        val parent = <TraitBound subject=self.typeTermProjectionReceiver(t: projection) constraint=<TraitConstraint key=<TraitInstanceKey owner=trait.nameStart positionalArgs=projection.assocTraitArgs /> assocPredicates=[] /> offset=evidence.bound.offset />
        try self.checkRetainedWitnessClause(expected: parent, proof: selected, normalizations: inherited, offset: evidence.bound.offset)
        val terminal = if declaration { give self.retainedConstraintPathTerminal(proof: selected) } else { give self.selectedConstraintWitness(proof: selected) }
        val witness = match terminal {
            Optional.Some(v: val witness) => witness,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint prerequisite has no selected conformance") /> },
        }
        if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has an invalid selected owner") /> }
        val conformance = witness.conformIdx - 1U64
        if self.resolveTraitDef(cf: self.decls.conformAt(index: conformance)) != traitIndex { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint row belongs to another trait") /> }
        if !self.arena.hasConformanceAssociatedEvidence(conformance: conformance) || self.arena.conformanceAssociatedClauseCount(conformance: conformance) != trait.assocBounds.len { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has an incomplete retained clause table") /> }
        for position in 0U64..<trait.assocBounds.len {
            if self.arena.conformanceAssociatedClause(conformance: conformance, clause: trait.assocBounds.start + position).isNone() { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has a missing or duplicate retained clause") /> }
        }
        val row = match self.arena.conformanceAssociatedClause(conformance: conformance, clause: evidence.clause) {
            Optional.Some(v: val row) => row,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has no retained declaration evidence") /> },
        }
        if row.bound.constraint.key.owner != original.constraint.key.owner || row.bound.constraint.positionalArgsOpen != original.constraint.positionalArgsOpen || row.bound.constraint.key.positionalArgs.count() != original.constraint.key.positionalArgs.count() || row.bound.constraint.assocPredicates.count() != original.constraint.assocPredicates.count() { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint row has a foreign clause shape") /> }
        for position in 0U64..<original.constraint.assocPredicates.count() {
            if row.bound.constraint.assocPredicates[position].member != original.constraint.assocPredicates[position].member { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint row has a foreign predicate") /> }
        }
        val environment = try self.selectedConstraintEnvironment(witness: witness, proof: selected)
        mut val outer = inherited
        for equation in (try self.retainedProofProjectionContext(proof: selected)) { try self.appendRetainedProjectionEquation(step: equation, normalizations: inout outer) }
        val normalizations = match (try self.replayProjectionEquations(saved: row.normalizations, environment: environment, selfRef: witness.selfRef, itemRef: 0U64, context: context, inherited: outer, declaration: declaration)) {
            Optional.Some(v: val normalizations) => normalizations,
            Optional.None => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> },
        }
        val rawSubject = self.groundTermInEnvironment(ref: row.bound.subject, params: environment.params, values: environment.args, selfRef: witness.selfRef)
        val rawConstraint = self.groundTraitConstraintInEnvironment(constraint: row.bound.constraint, params: environment.params, args: environment.args, selfRef: witness.selfRef)
        val expected = <TraitBound subject=(try self.replayProjectionNormalizations(ref: rawSubject, normalizations: normalizations, offset: evidence.bound.offset)) constraint=(try self.replayConstraintNormalizations(constraint: rawConstraint, normalizations: normalizations, offset: evidence.bound.offset)) offset=evidence.bound.offset />
        val symbolic = match context {
            Optional.Some(v: val scope) => match scope.interpretation { InterfaceRootInterpretation.Universal(root: _) => true, _ => false },
            Optional.None => false,
        }
        if !declaration && !symbolic {
            if !self.arena.typeIsClosed(ref: expected.subject) { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
            for argument in expected.constraint.key.positionalArgs { if !self.arena.typeIsClosed(ref: argument) { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> } }
            for predicate in expected.constraint.assocPredicates { if !self.arena.typeIsClosed(ref: predicate.value) { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> } }
        }
        val output = try self.replayProjectionNormalizations(ref: (try self.associatedOutputInProof(proof: selected, traitOwner: trait.nameStart, assocId: projection.assocNameId)), normalizations: normalizations, offset: evidence.bound.offset)
        if output == 0U64 || !self.typeRefEq(a: output, b: expected.subject) || !self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: receiverRef), b: self.typeRefWithoutOuterViews(ref: expected.subject)) { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has a different selected subject") /> }
        if !self.arena.hasStaticConformanceProof(id: row.proof) { return <Result.Err error=self.diagnosticAt(offset: evidence.bound.offset, msg: "associated constraint has no retained child proof") /> }
        val state = try self.replayConstraintProof(proof: self.thawStaticConformanceProof(id: row.proof), receiver: expected.subject, environment: environment, selfRef: witness.selfRef, itemRef: 0U64, context: context, normalizations: normalizations, declaration: declaration)
        match state {
            ConstraintProofReplay.Concrete(proof: val proof) | ConstraintProofReplay.Universal(proof: val proof) => { try self.checkRetainedWitnessClause(expected: expected, proof: proof, normalizations: normalizations, offset: evidence.bound.offset) }
            _ => {}
        }
        return <Result.Ok value=state />
    }

    inout fn replayProjectionEquations(saved: Array[ProjectionNormalizationStep], environment: InstanceEnvironment, selfRef: U64, itemRef: U64, context: Optional[InterfaceProofContext], inherited: Array[ProjectionNormalizationStep], declaration: Bool = false) -> Result[Optional[Array[ProjectionNormalizationStep]], CompileDiagnostic] {
        // Inherited context is already in this instance: never substitute it again.
        mut val normalizations = inherited
        for step in saved {
            val substituted = self.groundTermInEnvironment(ref: step.source, params: environment.params, values: environment.args, selfRef: selfRef, itemRef: itemRef)
            mut val output = self.groundTermInEnvironment(ref: step.output, params: environment.params, values: environment.args, selfRef: selfRef, itemRef: itemRef)
            if substituted == 0U64 || substituted >= self.arena.typeCount() || self.arena.typeAt(index: substituted).assocNameId == 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected condition has invalid projection evidence") /> }
            // Dependencies introduced by simultaneous substitution belong to the
            // existing context. Replay children before interpreting this head.
            val source = try self.replayProjectionChildren(ref: substituted, normalizations: normalizations, offset: 0U64)
            if source == 0U64 || source >= self.arena.typeCount() || self.arena.typeAt(index: source).assocNameId == 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected condition has invalid projection evidence") /> }
            val receiver = self.typeTermProjectionReceiver(t: self.arena.typeAt(index: source))
            val original = self.thawStaticConformanceProof(id: step.proof)
            match (try self.replayConstraintProof(proof: original, receiver: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, context: context, normalizations: normalizations, declaration: declaration)) {
                ConstraintProofReplay.Missing => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected condition has no concrete projection evidence") /> }
                ConstraintProofReplay.Deferred => { return <Result.Ok value=<Optional.None /> /> }
                ConstraintProofReplay.Concrete(proof: val proof) | ConstraintProofReplay.Universal(proof: val proof) => {
                    val projection = self.arena.typeAt(index: source)
                    val owner = if projection.assocTraitDeclOffset != 0U64 { give projection.assocTraitDeclOffset } else { give projection.assocTraitStart }
                    val associated = try self.associatedOutputTermInProof(proof: proof, traitOwner: owner, assocId: projection.assocNameId)
                    val immediate = if associated != 0U64 && !self.typeRefEq(a: associated, b: source) { give associated } else { give 0U64 }
                    if step.output != 0U64 {
                        val expected = try self.replayProjectionNormalizations(ref: output, normalizations: normalizations, offset: 0U64)
                        val actual = try self.replayProjectionNormalizations(ref: immediate, normalizations: normalizations, offset: 0U64)
                        if !self.typeRefEq(a: expected, b: actual) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "retained projection substitution has a different output") /> }
                    }
                    // Keep the immediate selected derivation, not its fully
                    // normalized result: later readers still need its provenance.
                    output = immediate
                    val proofId = if self.sameStaticConformanceProof(a: original, b: proof) { give step.proof } else { give self.freezeStaticConformanceProof(proof: proof) }
                    try self.appendRetainedProjectionEquation(step: <ProjectionNormalizationStep source=source proof=proofId output=output />, normalizations: inout normalizations)
                }
            }
        }
        try self.checkProjectionNormalizations(normalizations: normalizations, offset: 0U64)
        return <Result.Ok value=<Optional.Some v=normalizations /> />
    }

    // Terms have already crossed their one environment substitution frontier.
    inout fn finishRetainedWitness(witness: WitnessMatch, receiverRef: U64, normalizations: Array[ProjectionNormalizationStep], retain: Bool = true, symbolic: Bool = false) -> Result[SelectedWitnessInstantiation, CompileDiagnostic] {
        mut val bindings: Array[WitnessBind] = []
        for binding in witness.binds {
            val term = try self.replayProjectionNormalizations(ref: binding.term, normalizations: normalizations, offset: 0U64)
            if !symbolic && (term == 0U64 || !self.arena.typeIsClosed(ref: term)) { return <Result.Ok value=<SelectedWitnessInstantiation.Deferred /> /> }
            bindings.append(<WitnessBind binder=binding.binder paramId=binding.paramId term=term />)
        }
        val receiver = self.selectedWitnessReceiver(declared: (try self.replayProjectionNormalizations(ref: witness.selfRef, normalizations: normalizations, offset: 0U64)), requested: receiverRef)
        if !symbolic && (receiver == 0U64 || !self.arena.typeIsClosed(ref: receiver)) { return <Result.Ok value=<SelectedWitnessInstantiation.Deferred /> /> }
        val grounded = <WitnessMatch conformIdx=witness.conformIdx binds=bindings selfRef=receiver />
        if !retain || normalizations.count() == 0U64 { return <Result.Ok value=<SelectedWitnessInstantiation.Ready witness=grounded /> /> }
        // A closed binding may have consumed the whole context. Keep it only
        // when an associated definition will still need it after this read.
        mut val needed = false
        val declaration = self.decls.conformAt(index: grounded.conformIdx - 1U64)
        for index in 0U64..<declaration.assocBindingIds.count() {
            val binding = self.decls.assocBindings[self.conformFuncIdAt(ids: declaration.assocBindingIds, index: index)]
            val output = try self.groundWitnessTypeTerm(ref: binding.ty, params: <PatternBindInput.Conformance range=binding.typeParams />, matchResult: grounded)
            if self.arena.typeContainsAssociatedProjection(ref: output) { needed = true }
        }
        if !needed { return <Result.Ok value=<SelectedWitnessInstantiation.Ready witness=grounded /> /> }
        val conditionId = self.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=grounded proofs=[] normalizations=normalizations />)
        return <Result.Ok value=<SelectedWitnessInstantiation.Ready witness=<WitnessMatch conformIdx=grounded.conformIdx binds=grounded.binds selfRef=grounded.selfRef conditions=conditionId /> /> />
    }

    inout fn replaySelectedWitness(witness: WitnessMatch, receiverRef: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64, context: Optional[InterfaceProofContext], inherited: Array[ProjectionNormalizationStep] = [], declaration: Bool = false) -> Result[SelectedWitnessInstantiation, CompileDiagnostic] {
        if witness.conditions != 0U64 {
            for active in self.activeConditionReplay { if active == witness.conditions { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected condition replay is cyclic", failureDomain: <FailureDomain.Internal />) /> } }
            self.activeConditionReplay.append(witness.conditions)
        }
        val result = self.replaySelectedWitnessContext(witness: witness, receiverRef: receiverRef, environment: environment, selfRef: selfRef, itemRef: itemRef, context: context, inherited: inherited, declaration: declaration)
        if witness.conditions != 0U64 { self.activeConditionReplay.removeLast() }
        return result
    }

    inout fn replaySelectedWitnessContext(witness: WitnessMatch, receiverRef: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64, context: Optional[InterfaceProofContext], inherited: Array[ProjectionNormalizationStep], declaration: Bool = false) -> Result[SelectedWitnessInstantiation, CompileDiagnostic] {
        if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected conformance has an invalid owner") /> }
        mut val bindings: Array[WitnessBind] = []
        for binding in witness.binds {
            val raw = self.groundTermInEnvironment(ref: binding.term, params: environment.params, values: environment.args, selfRef: selfRef, itemRef: itemRef)
            bindings.append(<WitnessBind binder=binding.binder paramId=binding.paramId term=raw />)
        }
        val symbolic = if declaration { give true } else { give match context {
            Optional.Some(v: val scope) => { give match scope.interpretation { InterfaceRootInterpretation.Universal(root: _) => true, _ => false } }
            Optional.None => false,
        } }
        val rawReceiver = if witness.selfRef == 0U64 { give receiverRef } else { give self.groundTermInEnvironment(ref: witness.selfRef, params: environment.params, values: environment.args, selfRef: selfRef, itemRef: itemRef) }
        val owner = self.decls.conformAt(index: witness.conformIdx - 1U64)
        if witness.conditions == 0U64 {
            if owner.bounds.len != 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected conformance has no retained condition plan") /> }
            return self.finishRetainedWitness(witness: <WitnessMatch conformIdx=witness.conformIdx binds=bindings selfRef=rawReceiver />, receiverRef: receiverRef, normalizations: inherited, symbolic: symbolic)
        }
        if witness.conditions > self.arena.witnessConditionPlanCount() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected conformance has an invalid condition plan") /> }
        val plan = self.arena.witnessConditionPlanAt(index: witness.conditions - 1U64)
        if !self.sameWitnessSubstitution(a: witness, b: plan.witness) || plan.proofs.count() != owner.bounds.len { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
        mut val proofs: Array[U64] = []
        mut val changed = true
        val normalizations = match (try self.replayProjectionEquations(saved: plan.normalizations, environment: environment, selfRef: selfRef, itemRef: itemRef, context: context, inherited: inherited, declaration: declaration)) {
            Optional.Some(v: val equations) => equations,
            Optional.None => { return <Result.Ok value=<SelectedWitnessInstantiation.Deferred /> /> },
        }
        val finalized = try self.finishRetainedWitness(witness: <WitnessMatch conformIdx=witness.conformIdx binds=bindings selfRef=rawReceiver />, receiverRef: receiverRef, normalizations: normalizations, retain: false, symbolic: symbolic)
        val grounded = match finalized {
            SelectedWitnessInstantiation.Ready(witness: val grounded) => grounded,
            SelectedWitnessInstantiation.Deferred => { return <Result.Ok value=<SelectedWitnessInstantiation.Deferred /> /> },
        }
        changed = !self.sameWitnessSubstitution(a: witness, b: grounded) || normalizations.count() != plan.normalizations.count()
        if !changed {
            for index in 0U64..<normalizations.count() {
                if normalizations[index].source != plan.normalizations[index].source || normalizations[index].output != plan.normalizations[index].output || normalizations[index].proof != plan.normalizations[index].proof { changed = true }
            }
        }
        mut val index = 0U64
        while index < plan.proofs.count() {
            val clause = self.conformBoundAt(bounds: owner.bounds, index: index)
            val rawSubject = try self.groundWitnessTypeTerm(ref: clause.subject, params: <PatternBindInput.Conformance range=owner.typeParams />, matchResult: grounded)
            val subject = try self.replayProjectionNormalizations(ref: rawSubject, normalizations: normalizations, offset: clause.offset)
            val original = self.thawStaticConformanceProof(id: plan.proofs[index])
            match (try self.replayConstraintProof(proof: original, receiver: subject, environment: environment, selfRef: selfRef, itemRef: itemRef, context: context, normalizations: normalizations, declaration: declaration)) {
                ConstraintProofReplay.Missing => { return <Result.Err error=self.diagnosticAt(offset: clause.offset, msg: "selected conformance evidence does not satisfy its declaration conditions") /> }
                ConstraintProofReplay.Deferred => { return <Result.Ok value=<SelectedWitnessInstantiation.Deferred /> /> }
                ConstraintProofReplay.Concrete(proof: val proof) | ConstraintProofReplay.Universal(proof: val proof) => {
                    if self.sameStaticConformanceProof(a: original, b: proof) { proofs.append(plan.proofs[index]) }
                    else { proofs.append(self.freezeStaticConformanceProof(proof: proof)) changed = true }
                }
            }
            index += 1U64
        }
        if !changed { return <Result.Ok value=<SelectedWitnessInstantiation.Ready witness=<WitnessMatch conformIdx=grounded.conformIdx binds=grounded.binds selfRef=grounded.selfRef conditions=witness.conditions /> /> /> }
        val conditionId = self.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=grounded proofs=proofs normalizations=normalizations />)
        return <Result.Ok value=<SelectedWitnessInstantiation.Ready witness=<WitnessMatch conformIdx=grounded.conformIdx binds=grounded.binds selfRef=grounded.selfRef conditions=conditionId /> /> />
    }

    inout fn replayConstraintProof(proof: StaticConformanceProof, receiver: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64, context: Optional[InterfaceProofContext], normalizations: Array[ProjectionNormalizationStep] = [], declaration: Bool = false) -> Result[ConstraintProofReplay, CompileDiagnostic] {
        val root = try self.interfaceProofRoot(proof: proof)
        if root != 0U64 {
            val scope = match context {
                Optional.Some(v: val scope) => scope,
                Optional.None => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface evidence requires a universal call scope") /> },
            }
            if root != scope.sourceRoot { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface proof belongs to another selected operation") /> }
            val scoped = <InterfaceProofContext sourceRoot=scope.sourceRoot interpretation=scope.interpretation environment=scope.environment normalizations=normalizations />
            val replayed = try self.rebaseInterfaceProof(proof: proof, context: scoped, selfRef: selfRef, itemRef: itemRef)
            match scope.interpretation {
                InterfaceRootInterpretation.Universal(root: _) => { return <Result.Ok value=<ConstraintProofReplay.Universal proof=replayed /> /> }
                InterfaceRootInterpretation.Concrete(proof: _) => {
                    if (try self.interfaceProofRoot(proof: replayed)) != 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "concrete interface interpretation retains an abstract proof root") /> }
                    try self.checkStaticProofEvidence(proof: replayed, offset: 0U64)
                    return <Result.Ok value=<ConstraintProofReplay.Concrete proof=replayed /> />
                }
            }
        }
        if declaration {
            return self.replayDeclarationConstraintProof(proof: proof, receiver: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, normalizations: normalizations)
        }
        // Projection prerequisites have the same declaration authority as
        // condition children. Their use cannot turn saved Presence evidence
        // into a fresh member-dispatch query when its environment is missing.
        val concrete = try self.instantiateConcreteConstraintProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, normalizations: normalizations)
        match concrete {
            StaticProofInstantiation.Missing => { return <Result.Ok value=<ConstraintProofReplay.Missing /> /> }
            StaticProofInstantiation.Deferred => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
            StaticProofInstantiation.Ready(proof: val proof) => { return <Result.Ok value=<ConstraintProofReplay.Concrete proof=proof /> /> }
        }
    }

    // Signature checking substitutes the admitted derivation in its owner's
    // environment. Its result may still depend on the caller's rigid binders.
    inout fn replayDeclarationConstraintProof(proof: StaticConformanceProof, receiver: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64, normalizations: Array[ProjectionNormalizationStep]) -> Result[ConstraintProofReplay, CompileDiagnostic] {
        match proof {
            StaticConformanceProof.Missing => { return <Result.Ok value=<ConstraintProofReplay.Missing /> /> }
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                match (try self.replaySelectedWitness(witness: witness, receiverRef: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.None />, inherited: normalizations, declaration: true)) {
                    SelectedWitnessInstantiation.Deferred => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
                    SelectedWitnessInstantiation.Ready(witness: val grounded) => { return <Result.Ok value=<ConstraintProofReplay.Universal proof=<StaticConformanceProof.ConcreteWitness witness=grounded /> /> /> }
                }
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: val terminal) => {
                mut val grounded: Array[WitnessMatch] = []
                for edge in edges {
                    match (try self.replaySelectedWitness(witness: edge, receiverRef: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.None />, inherited: normalizations, declaration: true)) {
                        SelectedWitnessInstantiation.Deferred => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
                        SelectedWitnessInstantiation.Ready(witness: val witness) => { grounded.append(witness) }
                    }
                }
                return <Result.Ok value=<ConstraintProofReplay.Universal proof=<StaticConformanceProof.TraitPath edges=grounded terminalConformIdx=terminal /> /> />
            }
            StaticConformanceProof.AssumedBound(source: val source) => {
                return self.replayDeclarationAssumption(source: source, receiver: receiver, environment: environment)
            }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => {
                val state = try self.replayDeclarationAssumption(source: source, receiver: receiver, environment: environment)
                match state {
                    ConstraintProofReplay.Universal(proof: val root) => { return self.replaySelectedSupertraits(proof: root, steps: steps, receiver: receiver, normalizations: normalizations, declaration: true) }
                    _ => { return <Result.Ok value=state /> }
                }
            }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                val state = try self.replayDeclarationConstraintProof(proof: <StaticConformanceProof.AssumedSupertraitPath source=source steps=steps />, receiver: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, normalizations: normalizations)
                val root = match state {
                    ConstraintProofReplay.Universal(proof: val root) => root,
                    _ => { return <Result.Ok value=state /> },
                }
                mut val grounded: Array[WitnessMatch] = []
                for edge in edges {
                    match (try self.replaySelectedWitness(witness: edge, receiverRef: receiver, environment: environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.None />, inherited: normalizations, declaration: true)) {
                        SelectedWitnessInstantiation.Deferred => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
                        SelectedWitnessInstantiation.Ready(witness: val witness) => { grounded.append(witness) }
                    }
                }
                return <Result.Ok value=<ConstraintProofReplay.Universal proof=(try self.appendRetainedTraitPath(root: root, edges: grounded)) /> />
            }
            _ => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
        }
    }

    inout fn replayDeclarationAssumption(source: DeclarationBoundRef, receiver: U64, environment: InstanceEnvironment) -> Result[ConstraintProofReplay, CompileDiagnostic] {
        if !self.declarationBoundIsValid(source: source) { return <Result.Ok value=<ConstraintProofReplay.Missing /> /> }
        match source {
            DeclarationBoundRef.Conformance(index: val index) => {
                match self.retainedConstraintPathTerminal(proof: environment.proof) {
                    Optional.Some(v: val witness) => {
                        match (try self.retainedConformanceConstraint(declared: index, receiver: receiver, witness: witness, requireClosed: false)) {
                            StaticProofInstantiation.Ready(proof: val proof) => { return <Result.Ok value=<ConstraintProofReplay.Universal proof=proof /> /> }
                            StaticProofInstantiation.Deferred => { return <Result.Ok value=<ConstraintProofReplay.Deferred /> /> }
                            StaticProofInstantiation.Missing => { return <Result.Ok value=<ConstraintProofReplay.Missing /> /> }
                        }
                    }
                    Optional.None => {}
                }
            }
            _ => {}
        }
        return <Result.Ok value=<ConstraintProofReplay.Deferred /> />
    }

    inout fn rebaseInterfaceBound(source: DeclarationBoundRef, context: InterfaceProofContext, selfRef: U64, itemRef: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        match source {
            DeclarationBoundRef.Interface(index: val index) => {
                if index + 1U64 != context.sourceRoot { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface assumption belongs to another selected operation") /> }
                match context.interpretation {
                    InterfaceRootInterpretation.Universal(root: val root) => { return <Result.Ok value=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Interface index=root - 1U64 /> /> /> }
                    InterfaceRootInterpretation.Concrete(proof: val proof) => { return <Result.Ok value=proof /> }
                }
            }
            DeclarationBoundRef.AssociatedType(index: val index) => {
                if !self.declarationBoundIsValid(source: source) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface condition has no retained associated clause") /> }
                val saved = self.arena.associatedBoundEvidenceAt(index: index)
                val prerequisite = try self.rebaseInterfaceProof(proof: saved.prerequisite, context: context, selfRef: selfRef, itemRef: itemRef)
                val projection = self.groundTermInEnvironment(ref: saved.projection, params: context.environment.params, values: context.environment.args, selfRef: selfRef, itemRef: itemRef)
                match prerequisite {
                    StaticConformanceProof.ConcreteWitness(witness: _) | StaticConformanceProof.TraitPath(edges: _, terminalConformIdx: _) => {
                        // Concrete output comes from the selected prerequisite,
                        // then the original associated clause's retained proof.
                        val parent = match saved.prerequisite {
                            StaticConformanceProof.AssumedBound(source: val source) => self.declarationBound(source: source),
                            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => self.assumedSupertraitBound(source: source, steps: steps),
                            _ => { return <Result.Err error=self.diagnosticAt(offset: saved.bound.offset, msg: "interface associated condition lost its original prerequisite") /> },
                        }
                        val clause = self.decls.traitAssociatedBoundPool[saved.clause]
                        val output = try self.associatedOutputInProof(proof: prerequisite, traitOwner: parent.constraint.key.owner, assocId: clause.member)
                        if output == 0U64 { return <Result.Err error=self.diagnosticAt(offset: saved.bound.offset, msg: "selected interface prerequisite has no associated output") /> }
                        match (try self.replaySelectedAssociatedConstraint(index: index, selected: prerequisite, projectionRef: projection, receiverRef: output, context: <Optional.Some v=context />, inherited: context.normalizations)) {
                            ConstraintProofReplay.Concrete(proof: val proof) | ConstraintProofReplay.Universal(proof: val proof) => { return <Result.Ok value=proof /> }
                            _ => { return <Result.Err error=self.diagnosticAt(offset: saved.bound.offset, msg: "selected interface associated condition is unresolved") /> }
                        }
                    }
                    _ => {}
                }
                val bound = try self.associatedClauseBound(projectionRef: projection, clauseIndex: saved.clause, prerequisite: prerequisite, offset: saved.bound.offset)
                if self.arena.typeIsClosed(ref: bound.subject) {
                    // Only a caller-fixed associated output reaches this
                    // first-concrete admission. Hidden Self remains rigid.
                    match (try self.instantiateBoundProof(demand: <ConformanceProofDemand.SourceAdmission />, bound: bound, receiverRef: bound.subject, environment: context.environment, selfRef: selfRef, itemRef: itemRef)) {
                        StaticProofInstantiation.Ready(proof: val proof) => {
                            try self.checkSelectedCallConstraintBoundary(expected: bound, proof: proof, offset: saved.bound.offset)
                            return <Result.Ok value=proof />
                        }
                        _ => { return <Result.Err error=self.diagnosticAt(offset: saved.bound.offset, msg: "fixed interface associated condition has no concrete evidence") /> }
                    }
                }
                return <Result.Ok value=<StaticConformanceProof.AssumedBound source=self.registerAssociatedBoundEvidence(evidence: <AssociatedBoundEvidence projection=projection clause=saved.clause prerequisite=prerequisite bound=bound />) /> />
            }
            _ => {
                val bound = self.declarationBound(source: source)
                val receiver = try self.groundTermForBody(ref: bound.subject, environment: context.environment, selfRef: selfRef, itemRef: itemRef)
                match (try self.instantiateConstraintProof(proof: <StaticConformanceProof.AssumedBound source=source />, receiverRef: receiver, environment: context.environment, selfRef: selfRef, itemRef: itemRef)) {
                    StaticProofInstantiation.Ready(proof: val proof) => { return <Result.Ok value=proof /> }
                    _ => { return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "caller condition is unresolved in its interface scope") /> }
                }
            }
        }
    }

    inout fn rebaseInterfaceSupertrait(source: DeclarationBoundRef, steps: Array[SupertraitRef], context: InterfaceProofContext, selfRef: U64, itemRef: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        val root = try self.rebaseInterfaceBound(source: source, context: context, selfRef: selfRef, itemRef: itemRef)
        if steps.count() == 0U64 { return <Result.Ok value=root /> }
        match root {
            StaticConformanceProof.AssumedBound(source: val source) => { return <Result.Ok value=<StaticConformanceProof.AssumedSupertraitPath source=source steps=steps /> /> }
            _ => {
                val original = self.declarationBound(source: source)
                val receiver = try self.groundTermForBody(ref: original.subject, environment: context.environment, selfRef: selfRef, itemRef: itemRef)
                match (try self.instantiateSelectedSupertraitConstraint(proof: root, steps: steps, receiverRef: receiver)) {
                    StaticProofInstantiation.Ready(proof: val proof) => { return <Result.Ok value=proof /> }
                    _ => { return <Result.Err error=self.diagnosticAt(offset: original.offset, msg: "interface supertrait condition is unresolved") /> }
                }
            }
        }
    }

    inout fn rebaseInterfaceWitness(witness: WitnessMatch, context: InterfaceProofContext, selfRef: U64, itemRef: U64) -> Result[WitnessMatch, CompileDiagnostic] {
        val receiver = self.groundTermInEnvironment(ref: witness.selfRef, params: context.environment.params, values: context.environment.args, selfRef: selfRef, itemRef: itemRef)
        match (try self.replaySelectedWitness(witness: witness, receiverRef: receiver, environment: context.environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.Some v=context />, inherited: context.normalizations)) {
            SelectedWitnessInstantiation.Ready(witness: val witness) => { return <Result.Ok value=witness /> }
            SelectedWitnessInstantiation.Deferred => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface condition retains an unresolved trait edge") /> }
        }
    }

    inout fn rebaseInterfaceProof(proof: StaticConformanceProof, context: InterfaceProofContext, selfRef: U64, itemRef: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        match proof {
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                return <Result.Ok value=<StaticConformanceProof.ConcreteWitness witness=(try self.rebaseInterfaceWitness(witness: witness, context: context, selfRef: selfRef, itemRef: itemRef)) /> />
            }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: val terminal) => {
                mut val grounded: Array[WitnessMatch] = []
                for edge in edges { grounded.append(try self.rebaseInterfaceWitness(witness: edge, context: context, selfRef: selfRef, itemRef: itemRef)) }
                return <Result.Ok value=<StaticConformanceProof.TraitPath edges=grounded terminalConformIdx=terminal /> />
            }
            StaticConformanceProof.AssumedBound(source: val source) => { return self.rebaseInterfaceBound(source: source, context: context, selfRef: selfRef, itemRef: itemRef) }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => { return self.rebaseInterfaceSupertrait(source: source, steps: steps, context: context, selfRef: selfRef, itemRef: itemRef) }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                val root = try self.rebaseInterfaceSupertrait(source: source, steps: steps, context: context, selfRef: selfRef, itemRef: itemRef)
                mut val grounded: Array[WitnessMatch] = []
                for edge in edges { grounded.append(try self.rebaseInterfaceWitness(witness: edge, context: context, selfRef: selfRef, itemRef: itemRef)) }
                return self.appendRetainedTraitPath(root: root, edges: grounded)
            }
            _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface condition has no retained abstract derivation") /> }
        }
    }

    inout fn appendRetainedTraitPath(root: StaticConformanceProof, edges: Array[WitnessMatch]) -> Result[StaticConformanceProof, CompileDiagnostic] {
        match root {
            StaticConformanceProof.AssumedBound(source: val source) => { return <Result.Ok value=<StaticConformanceProof.AssumedTraitPath source=source steps=[] edges=edges /> /> }
            StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => { return <Result.Ok value=<StaticConformanceProof.AssumedTraitPath source=source steps=steps edges=edges /> /> }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val prefix) => {
                mut val path = prefix
                for edge in edges { path.append(edge) }
                return <Result.Ok value=<StaticConformanceProof.AssumedTraitPath source=source steps=steps edges=path /> />
            }
            _ => {}
        }
        mut val path: Array[WitnessMatch] = []
        match root {
            StaticConformanceProof.ConcreteWitness(witness: val witness) => { path.append(witness) }
            StaticConformanceProof.TraitPath(edges: val prefix, terminalConformIdx: _) => { path = prefix }
            _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "retained trait path has no valid premise", failureDomain: <FailureDomain.Internal />) /> }
        }
        for edge in edges { path.append(edge) }
        if path.count() == 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "retained trait path has no witness", failureDomain: <FailureDomain.Internal />) /> }
        return <Result.Ok value=<StaticConformanceProof.TraitPath edges=path terminalConformIdx=path[path.count() - 1U64].conformIdx /> />
    }

    inout fn createInterfaceProofContext(source: InterfaceEvidenceRoot, sourceRoot: U64, owner: InterfaceEvidenceOwner, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[InterfaceProofContext, CompileDiagnostic] {
        val parameter = self.nextParamId
        self.nextParamId += 1U64
        val name = self.internTmpName(prefix: "InterfaceInstanceSelf", n: parameter)
        val subject = self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen paramId=parameter args=[] />)
        val original = self.arena.typeAt(index: source.bound.subject)
        mut val parameters = environment.params
        mut val values = environment.args
        parameters.append(<Bind nameStart=original.nameStart nameLen=original.nameLen nameId=original.nameId paramId=original.paramId fieldStart=0U64 fieldLen=0U64 />)
        values.append(subject)
        val substitution = <InstanceEnvironment params=parameters args=values receiverRef=environment.receiverRef proof=environment.proof constraints=environment.constraints />
        val bound = try self.groundCallableBound(bound: source.bound, environment: substitution, selfRef: selfRef, itemRef: itemRef)
        self.interfaceEvidence.append(<Ref value=<InterfaceEvidenceCell node=<InterfaceEvidenceNode.Instance root=sourceRoot owner=owner bound=bound /> /> />)
        return <Result.Ok value=<InterfaceProofContext sourceRoot=sourceRoot interpretation=<InterfaceRootInterpretation.Universal root=self.interfaceEvidence.count() /> environment=substitution /> />
    }

    inout fn instantiateInterfaceCall(template: CallTemplate, owner: InterfaceEvidenceOwner, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[Optional[U64], CompileDiagnostic] {
        val root = selectedInterfaceRoot(template: template)
        if root == 0U64 { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call has no retained interface root") /> }
        val traitAndSlot = match template.kind {
            CallTemplateKind.Dynamic(receiver: _, args: _, target: val target) => {
                give match target {
                    DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot, interfaceRoot: _) => <InterfaceRequirementKey traitIndex=traitIndex slot=slot />,
                    _ => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call is not an interface requirement") /> },
                }
            }
            CallTemplateKind.Protocol(receiver: _, selection: val selection, resultTerm: _) => {
                give match selection {
                    ProtocolSelection.Existential(traitIdx: val traitIndex, slot: val slot, interfaceRoot: _) => <InterfaceRequirementKey traitIndex=traitIndex slot=slot />,
                    _ => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "protocol call is not an interface requirement") /> },
                }
            }
            _ => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "selected call is not an interface requirement") /> },
        }
        val source = try self.requireSourceInterfaceRoot(root: root, site: template.siteKey, receiver: template.receiverTypeTerm, traitIndex: traitAndSlot.traitIndex)
        if !(try self.semanticCompletionOwnerPrepared(owner: source.owner)) { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic interface source owner is not prepared") /> }
        match owner {
            InterfaceEvidenceOwner.Body(index: val bodyId) => {
                if bodyId == 0U64 || bodyId > self.arena.bodyInstanceCount() { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call has no caller body instance") /> }
                val body = self.arena.bodyInstanceAt(index: bodyId - 1U64)
                if !self.sameInstanceEnvironment(a: body.environment, b: environment) { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "interface substitution belongs to another caller environment") /> }
                val global: Optional[U64] = match source.owner { SemanticCompletionOwner.Global(target: val target) => <Optional.Some v=target />, _ => <Optional.None />, }
                if !semanticCompletionOwnersEqual(recorded: source.owner, prepared: (try self.bodySourceOwner(bodyId: bodyId, globalInitializerTarget: global))) { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "interface substitution belongs to another lexical source owner") /> }
            }
            InterfaceEvidenceOwner.Declaration(environment: val declared) => {
                if !self.sameInstanceEnvironment(a: declared, b: environment) { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "interface declaration substitution belongs to another environment") /> }
            }
        }
        val receiver = try self.groundTermForBody(ref: source.receiver, environment: environment, selfRef: selfRef, itemRef: itemRef)
        if !self.arena.typeIsClosed(ref: receiver) { return <Result.Ok value=<Optional.None /> /> }
        val index = self.callTemplateIndex(siteKey: template.siteKey)
        val snapshot = match self.preparedCallConstraints(index: index) {
            Optional.Some(v: val snapshot) => snapshot,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call has no prepared source constraints") /> },
        }
        val plan = snapshot.constraints()
        if plan.proofs.count() != plan.bounds.count() { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call has incomplete source constraints") /> }
        // No hidden binder is interpreted by an empty condition set. Retain
        // its source provenance without manufacturing an unused fresh scope.
        if plan.bounds.count() == 0U64 {
            self.interfaceCalls.append(<Ref value=<InterfaceCallEvidenceCell evidence=<InterfaceCallEvidence sourceRoot=root instanceRoot=root owner=owner receiver=receiver traitIndex=traitAndSlot.traitIndex slot=traitAndSlot.slot bounds=[] proofs=[] /> /> />)
            return <Result.Ok value=<Optional.Some v=self.interfaceCalls.count() /> />
        }
        val context = try self.createInterfaceProofContext(source: source, sourceRoot: root, owner: owner, environment: environment, selfRef: selfRef, itemRef: itemRef)
        val instanceRoot = match context.interpretation {
            InterfaceRootInterpretation.Universal(root: val root) => root,
            InterfaceRootInterpretation.Concrete(proof: _) => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call cannot borrow a concrete boxing interpretation") /> },
        }
        val lexical = try self.callConstraintScope(template: template)
        val scope = <DeclarationTypeScope owner=lexical.owner parameters=<FuncBindRange start=0U64 len=0U64 /> interfaceRoot=instanceRoot />
        val normalizations = match (try self.replayProjectionEquations(saved: plan.normalizations, environment: context.environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.Some v=context />, inherited: [])) {
            Optional.Some(v: val normalizations) => normalizations,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "dynamic call retains unresolved projection evidence", failureDomain: <FailureDomain.Internal />) /> }
        }
        mut val bounds: Array[TraitBound] = []
        mut val proofs: Array[U64] = []
        for position in 0U64..<plan.bounds.count() {
            val original = plan.bounds[position]
            val substituted = self.substituteRetainedBound(bound: original, environment: context.environment, selfRef: selfRef, itemRef: itemRef)
            val bound = try self.replayBoundNormalizations(bound: substituted, normalizations: normalizations)
            val proof = self.thawStaticConformanceProof(id: plan.proofs[position])
            if !self.typeTermContainsParameter(ref: bound.subject, parameter: self.interfaceScopeParameter(scope: scope)) {
                try self.checkFirstConcreteSourcePath(bound: original, proof: proof, receiverRef: bound.subject, environment: environment, selfRef: selfRef, itemRef: itemRef)
            }
            val replay = try self.replayConstraintProof(proof: proof, receiver: bound.subject, environment: environment, selfRef: selfRef, itemRef: itemRef, context: <Optional.Some v=context />, normalizations: normalizations)
            val instantiated = match replay {
                ConstraintProofReplay.Universal(proof: val proof) | ConstraintProofReplay.Concrete(proof: val proof) => proof,
                _ => { return <Result.Err error=self.diagnosticAt(offset: original.offset, msg: "dynamic call retains an unresolved condition") /> },
            }
            try self.checkDeclarationCallProof(proof: instantiated, scope: scope, offset: original.offset)
            try self.compareValidatedWitnessClause(expected: bound, proof: instantiated, normalizations: normalizations, offset: original.offset)
            bounds.append(bound)
            proofs.append(self.freezeStaticConformanceProof(proof: instantiated))
        }
        self.interfaceCalls.append(<Ref value=<InterfaceCallEvidenceCell evidence=<InterfaceCallEvidence sourceRoot=root instanceRoot=instanceRoot owner=owner receiver=receiver traitIndex=traitAndSlot.traitIndex slot=traitAndSlot.slot bounds=bounds proofs=proofs /> /> />)
        return <Result.Ok value=<Optional.Some v=self.interfaceCalls.count() /> />
    }
}

// Validate the immutable capability at publication and its actual consumers.
// No where-clause solver or source lookup can replace an absent capability.
pub impl Comp {
    inout fn checkFinalInterfaceEvidence(resolution: CallResolution) -> Result[(), CompileDiagnostic] {
        val requirement = match resolution.target {
            CallTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot) => <InterfaceRequirementKey traitIndex=traitIndex slot=slot />,
            _ => {
                if resolution.interfaceEvidence != 0U64 { return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "non-interface call has interface evidence") /> }
                return <Result.Ok value=() />
            },
        }
        if resolution.interfaceEvidence == 0U64 || resolution.interfaceEvidence > self.interfaceCalls.count() {
            return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "dynamic call has no interpreted interface evidence") />
        }
        val evidence = self.interfaceCalls[resolution.interfaceEvidence - 1U64]->evidence
        match evidence.owner {
            InterfaceEvidenceOwner.Body(index: val body) => { if body != resolution.bodyId { return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "interface evidence belongs to another caller body") /> } }
            InterfaceEvidenceOwner.Declaration(environment: _) => { return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "declaration interface evidence cannot authorize execution") /> }
        }
        if evidence.instanceRoot == 0U64 || !self.interfaceEvidenceIsValid(index: evidence.instanceRoot - 1U64) || evidence.traitIndex != requirement.traitIndex || evidence.slot != requirement.slot || !self.typeRefEq(a: evidence.receiver, b: resolution.recvTypeRef) {
            return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "dynamic interface evidence has a different receiver or requirement") />
        }
        val index = self.callTemplateIndex(siteKey: resolution.siteKey)
        if index >= self.callTemplateLocations.count() { return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "dynamic interface evidence has no source operation") /> }
        val template = self.callTemplateAt(index: index)
        if selectedInterfaceRoot(template: template) != evidence.sourceRoot || !self.sameCallSiteKey(a: template.siteKey, b: resolution.siteKey) {
            return <Result.Err error=self.diagnosticAt(offset: resolution.siteKey.originStart, msg: "interface evidence belongs to another selected operation") />
        }
        try self.requireSourceInterfaceRoot(root: evidence.sourceRoot, site: resolution.siteKey, receiver: template.receiverTypeTerm, traitIndex: requirement.traitIndex)
        return <Result.Ok value=() />
    }
}

impl Comp {
    inout fn checkInterfaceDeclarationCall(template: CallTemplate, environment: InstanceEnvironment) -> Result[DeclarationObligationState, CompileDiagnostic] {
        val index = self.callTemplateIndex(siteKey: template.siteKey)
        match self.preparedCallConstraints(index: index) {
            Optional.Some(v: val snapshot) => { if snapshot.constraints().bounds.count() == 0U64 { return <Result.Ok value=<DeclarationObligationState.Complete /> /> } }
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: template.siteKey.originStart, msg: "interface declaration call has no prepared source constraints") /> }
        }
        match (try self.instantiateInterfaceCall(template: template, owner: <InterfaceEvidenceOwner.Declaration environment=environment />, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64)) {
            Optional.Some(v: _) => { return <Result.Ok value=<DeclarationObligationState.Complete /> /> }
            Optional.None => { return <Result.Ok value=<DeclarationObligationState.Deferred /> /> }
        }
    }
}

impl Comp {
    inout fn concreteInterfaceConditions(conditions: ExistentialMethodConditions, evidence: ExistentialBoxEvidence, requirement: U64) -> Result[InstantiatedCallableConstraints, CompileDiagnostic] {
        if conditions.bounds.count() != conditions.proofs.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface contract has incomplete public evidence") /> }
        if conditions.bounds.count() == 0U64 {
            if conditions.root != 0U64 || conditions.normalizations.count() != 0U64 { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "empty interface contract unexpectedly owns a proof scope") /> }
            return <Result.Ok value=<InstantiatedCallableConstraints bounds=[] proofs=[] /> />
        }
        if conditions.root == 0U64 || !self.interfaceEvidenceIsValid(index: conditions.root - 1U64) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface contract has no admitted root") /> }
        val contract = match self.interfaceEvidence[conditions.root - 1U64]->node {
            InterfaceEvidenceNode.Contract(root: val root) => root,
            _ => { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "boxing cannot borrow a source-call interface scope") /> },
        }
        if contract.traitIndex != evidence.traitIdx || contract.slot != requirement + 1U64 || !self.typeRefEq(a: contract.receiver, b: evidence.targetRef) { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "interface contract belongs to another boxing target or requirement") /> }
        try self.checkConversionProofEvidence(proof: <ValueConversionProof.ExistentialBox sourceRef=evidence.sourceRef targetRef=evidence.targetRef traitIdx=evidence.traitIdx proof=evidence.proof />, offset: contract.bound.offset)
        val binder = self.arena.typeAt(index: contract.bound.subject)
        val environment = <InstanceEnvironment params=[<Bind nameStart=binder.nameStart nameLen=binder.nameLen nameId=binder.nameId paramId=binder.paramId fieldStart=0U64 fieldLen=0U64 />] args=[evidence.sourceRef] receiverRef=evidence.sourceRef proof=evidence.proof />
        val rootContext = <InterfaceProofContext sourceRoot=conditions.root interpretation=<InterfaceRootInterpretation.Concrete proof=evidence.proof /> environment=environment />
        val normalizations = match (try self.replayProjectionEquations(saved: conditions.normalizations, environment: environment, selfRef: evidence.sourceRef, itemRef: 0U64, context: <Optional.Some v=rootContext />, inherited: [])) {
            Optional.Some(v: val normalizations) => normalizations
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: contract.bound.offset, msg: "interface contract retains unresolved projection evidence") /> }
        }
        val context = <InterfaceProofContext sourceRoot=conditions.root interpretation=rootContext.interpretation environment=environment normalizations=normalizations />
        mut val bounds: Array[TraitBound] = []
        mut val proofs: Array[StaticConformanceProof] = []
        for index in 0U64..<conditions.bounds.count() {
            val original = conditions.bounds[index]
            val substituted = self.substituteRetainedBound(bound: original, environment: environment, selfRef: evidence.sourceRef, itemRef: 0U64)
            val bound = try self.replayBoundNormalizations(bound: substituted, normalizations: context.normalizations)
            val proof = match (try self.replayConstraintProof(proof: self.thawStaticConformanceProof(id: conditions.proofs[index]), receiver: bound.subject, environment: environment, selfRef: evidence.sourceRef, itemRef: 0U64, context: <Optional.Some v=context />, normalizations: context.normalizations)) {
                ConstraintProofReplay.Concrete(proof: val proof) => proof,
                _ => { return <Result.Err error=self.diagnosticAt(offset: bound.offset, msg: "promised interface member has no concrete condition evidence") /> },
            }
            try self.checkRetainedWitnessClause(expected: bound, proof: proof, normalizations: context.normalizations, offset: bound.offset)
            bounds.append(bound)
            proofs.append(proof)
        }
        return <Result.Ok value=<InstantiatedCallableConstraints bounds=bounds proofs=proofs normalizations=normalizations /> />
    }
}

impl Comp {
    inout fn prepareExistentialMember(evidence: ExistentialBoxEvidence, requirement: U64) -> Result[Optional[PreparedExistentialMember], CompileDiagnostic] {
        if evidence.traitIdx >= self.decls.traitCount() || requirement >= self.decls.traitAt(index: evidence.traitIdx).reqs.count() { return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "existential member has no selected declaration") /> }
        val requested = self.traitReqAt(reqs: self.decls.traitAt(index: evidence.traitIdx).reqs, index: requirement)
        if !(try self.existentialRequirementIsDispatchable(target: evidence.targetRef, traitIndex: evidence.traitIdx, slot: requirement)) { return <Result.Ok value=<Optional.None /> /> }
        val conditions = match (try self.interfaceMethodConditions(target: evidence.targetRef, traitIndex: evidence.traitIdx, requirement: requirement)) {
            Optional.Some(v: val conditions) => conditions,
            Optional.None => { return <Result.Ok value=<Optional.None /> /> },
        }
        val implementation = match (try self.existentialImplementation(receiver: evidence.sourceRef, target: evidence.targetRef, traitIndex: evidence.traitIdx, requirement: requirement, proof: evidence.proof)) {
            Optional.Some(v: val implementation) => implementation,
            Optional.None => { return <Result.Err error=self.diagnosticAt(offset: requested.nameStart, msg: "admitted interface member lost its selected implementation") /> },
        }
        val publicEvidence = try self.concreteInterfaceConditions(conditions: conditions, evidence: evidence, requirement: requirement)
        val plan = try self.selectedRequirementImplementationPlan(callee: implementation.function, proof: evidence.proof, traitIndex: evidence.traitIdx, requirement: requirement, offset: self.arena.functionAt(index: implementation.function).nameStart)
        val constraints = <CallableConstraintEvidence.Requirement plan=plan bounds=publicEvidence.bounds proofs=publicEvidence.proofs normalizations=publicEvidence.normalizations />
        val receiver = self.canonicalBodyReceiverRef(fnIdx: implementation.function, recvInstRef: evidence.sourceRef)
        val witness = match (try self.existentialWitnessPlan(evidence: evidence, requirement: requirement, sourceReceiver: receiver)) {
            Optional.Some(v: val witness) => witness,
            Optional.None => { return <Result.Ok value=<Optional.None /> /> },
        }
        val environment = try self.existentialImplementationEnvironment(implementation: implementation, evidence: evidence, constraints: constraints)
        try self.checkPreparedExistentialWitnessSignature(plan: witness, function: implementation.function, environment: environment)
        return <Result.Ok value=<Optional.Some v=<PreparedExistentialMember implementation=implementation environment=environment plan=witness /> /> />
    }

    inout fn existentialImplementationEnvironment(implementation: ExistentialImplementation, evidence: ExistentialBoxEvidence, constraints: CallableConstraintEvidence) -> Result[InstanceEnvironment, CompileDiagnostic] {
        val substitution = try self.bodyInstanceEnvironment(fnIdx: implementation.function, args: implementation.arguments, recvInstRef: evidence.sourceRef, selectedProof: evidence.proof)
        return self.environmentWithCallableConstraints(fnIdx: implementation.function, environment: substitution, evidence: constraints)
    }
}

impl Comp {
    inout fn preparedExistentialBoxIndex(evidence: ExistentialBoxEvidence) -> Result[U64, CompileDiagnostic] {
        for index in 0U64..<self.preparedExistentialBoxes.count() {
            val saved = self.preparedExistentialBoxes[index].evidence
            if self.typeRefEq(a: saved.sourceRef, b: evidence.sourceRef) && self.typeRefEq(a: saved.targetRef, b: evidence.targetRef) {
                if saved.traitIdx != evidence.traitIdx || !self.sameStaticConformanceProof(a: saved.proof, b: evidence.proof) {
                    return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "existential conversion replaced its prepared conformance evidence", failureDomain: <FailureDomain.Internal />) />
                }
                return <Result.Ok value=index />
            }
        }
        return <Result.Ok value=self.preparedExistentialBoxes.count() />
    }

    inout fn prepareExistentialBox(evidence: ExistentialBoxEvidence) -> Result[U64, CompileDiagnostic] {
        val index = try self.preparedExistentialBoxIndex(evidence: evidence)
        if index < self.preparedExistentialBoxes.count() { return <Result.Ok value=index /> }
        try self.checkConversionProofEvidence(proof: <ValueConversionProof.ExistentialBox sourceRef=evidence.sourceRef targetRef=evidence.targetRef traitIdx=evidence.traitIdx proof=evidence.proof />, offset: 0U64)
        val trait = self.decls.traitAt(index: evidence.traitIdx)
        mut val members: Array[Optional[PreparedExistentialMember]] = []
        for slot in 0U64..<trait.reqs.count() {
            members.append(try self.prepareExistentialMember(evidence: evidence, requirement: slot))
        }
        self.preparedExistentialBoxes.append(<PreparedExistentialBox evidence=evidence members=members />)
        // Publish before visiting adapter results so recursive Self returns
        // refer to the same prepared box.
        for member in members {
            match member {
                Optional.Some(v: val member) => {
                    match self.prepareConversionDependencies(conversion: member.plan.resultConversion) {
                        Result.Ok(value: _) => {}
                        Result.Err(error: val diagnostic) => {
                            self.preparedExistentialBoxes.truncate(count: index)
                            return <Result.Err error=diagnostic />
                        }
                    }
                }
                Optional.None => {}
            }
        }
        return <Result.Ok value=index />
    }
}

pub impl Comp {
    inout fn prepareConversionDependencies(conversion: ValueConversionProof) -> Result[(), CompileDiagnostic] {
        match conversion {
            ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: val trait, proof: val proof) => {
                try self.prepareExistentialBox(evidence: <ExistentialBoxEvidence sourceRef=source targetRef=target traitIdx=trait proof=proof />)
            }
            ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => {
                try self.prepareConversionDependencies(conversion: element)
            }
            ValueConversionProof.EnumRepack(sourceRef: _, targetRef: _, enumIdx: _, argumentProofs: _, payloads: val payloads) => {
                for payload in payloads { try self.prepareConversionDependencies(conversion: payload.conversion) }
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }
}
