// Part of monomorphization (root: _.pw): generic free-function inference and
// instance registration.

// Whether c.arena.functionAt(index: fi) is a generic free function (no receiver, has type params).


pub impl Comp {

    inout fn isGenericFreeFn(fi: U64) -> Bool {
        if fi >= self.arena.functionCount() {
            return false
        }
        val f: Func = self.arena.functionAt(index: fi)
        if f.hasRecv {
            return false
        }
        return f.typeParams.count() > 0
    }

    inout fn findOrAddTypeRef(nameStart: U64, nameLen: U64) -> U64 {
        val q: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val ref = self.arena.firstBareTypeNamed(nameId: q)
        if ref < self.arena.typeCount() { return ref }
        val noArgs: Array[U64] = []
        return self.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=noArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    inout fn closureFnTypeRef(params: Array[Param], retTy: U64, isDiverging: Bool = false) -> U64 {
        val fnName: Bind = self.kwSpan(kw: "fn", kwLen: 2)
        mut val args: Array[U64] = [retTy]
        mut val labels: Array[U64] = [0U64]
        mut val i: U64 = 0U64
        while i < params.count() {
            args.append(params[i].ty)
            if params[i].noLabel { labels.append(0U64) }
            else { labels.append(params[i].nameId) }
            i += 1U64
        }
        return self.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=args argLabels=labels isDiverging=isDiverging isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    inout fn tyRefOfInfo(ti: TypeInfo) -> U64 {
        if ti.ref != 0 {
            return ti.ref
        }
        if ti.nameLen == 0 {
            return 0
        }
        if ti.kind == 3 {
            // arrays as type arguments are deferred (no generic-over-array yet).
            return 0
        }
        return self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
    }

    inout fn argViewRef(argExpr: U64, baseRef: U64) -> U64 {
        if baseRef == 0 {
            return 0
        }
        match self.arena.exprs[argExpr] {
            Expr.ExtView(recv: _, val source, val strip) => {
                if strip {
                    return baseRef
                }
                val bt: TypeRef = self.arena.typeAt(index: baseRef)
                mut val sources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: baseRef)
                mut val present: Bool = false
                mut val i: U64 = 0U64
                while i < sources.count() {
                    if self.semanticViewSourceEq(a: sources[i], b: source) { present = true }
                    i += 1U64
                }
                if !present { sources.append(source) }
                return self.typeRefWithViewSources(ref: baseRef, sources: sources)
            }
            _ => {
                return baseRef
            }
        }
    }

    inout fn inferFnArgs(f: Func, args: ArgRange) -> Result[Array[U64], CompileDiagnostic] {
        mut val out: Array[U64] = []
        if f.typeParams.count() == 0U64 { return <Result.Ok value=out /> }
        while out.count() < f.typeParams.count() { out.append(0U64) }
        mut val index = 0U64
        while index < f.params.count() {
            val parameter = self.funcParamAt(params: f.params, index: index)
            val supplied = self.argIndexForParam(params: f.params, args: args, paramIdx: index)
            if supplied < args.len {
                val expression = self.argAt(args: args, index: supplied).expr
                if !self.expressionNeedsTypeContext(exprId: expression, allowPartialFunction: true) {
                    val argument = try self.inferenceArgumentType(exprId: expression)
                    out = try self.extendCallTypeArguments(pattern: parameter.ty, argument: argument, params: f.typeParams, values: out, offset: self.exprOffset(id: expression))
                }
            }
            index += 1U64
        }
        return <Result.Ok value=out />
    }

    inout fn fnArgsAllGround(args: Array[U64]) -> Result[Bool, CompileDiagnostic] {
        if args.count() == 0 {
            return <Result.Ok value=false />
        }
        mut val i: U64 = 0
        while i < args.count() {
            if args[i] == 0 {
                return <Result.Ok value=false />
            }
            if !((try self.tyRefIsGround(ref: args[i]))) {
                return <Result.Ok value=false />
            }
            i += 1
        }
        return <Result.Ok value=true />
    }

    // Code-generation instances are identified by the selected callable, its
    // complete substitutions, and its concrete receiver subject.  The latter
    // is empty for ordinary free functions, but is essential for associated
    // callables and provided bodies: their `Self` environment is part of the
    // emitted body.  Keeping this key here makes every registration path use
    // the same identity as final-body discovery and LLVM's function cache.
    inout fn fnInstExists(fnIdx: U64, args: Array[U64], recvInstRef: U64 = 0U64) -> Bool {
        mut val i: U64 = 0
        while i < self.monoWork.fnInsts.count() {
            val fin: FnInst = self.monoWork.fnInsts[i]
            if fin.fnIdx == fnIdx && self.sameBodyReceiver(a: fin.recvInstRef, b: recvInstRef) {
                if fin.args.count() == args.count() {
                    mut val same: Bool = true
                    mut val j: U64 = 0
                    while j < args.count() {
                        if !(self.typeRefEq(a: fin.args[j], b: args[j])) {
                            same = false
                        }
                        j += 1
                    }
                    if same {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn registerCallInst(id: U64, nameStart: U64, nameLen: U64, args: ArgRange, finalIdx: U64) -> Result[(), CompileDiagnostic] {
        val fi: U64 = finalIdx
        if fi < self.arena.functionCount() {
            if self.arena.functionAt(index: fi).isExtern {
                // a generic `extern(plewIntrinsic)` (e.g. `arrayPush[T]`, `arrayGet[T]`):
                // lowered inline at the call site, so it has no monomorphized instance —
                // never register one (else a bogus prototype/body with an unmapped return <Result.Ok value=() />
                // type leaks out).
            } else {
            if self.isGenericFreeFn(fi: fi) {
                // Finalization has already selected the callable and grounded
                // its substitutions for this exact body instance.  Re-inferring
                // from the shared AST here creates a second `fn[T]` instance
                // beside `fn[I64]`/`fn[String]`; that stale template then has
                // no concrete receiver for its nested calls.  Instance demand
                // is therefore a pure consumer of the final descriptor.
                val finalArgs: Array[U64] = (try self.bodyCalleeTypeArgs(exprId: id))
                if finalArgs.count() == self.arena.functionAt(index: fi).typeParams.count() && (try self.fnArgsAllGround(args: finalArgs)) {
                    if !(self.fnInstExists(fnIdx: fi, args: finalArgs)) {
                        // polymorphic-recursion ceiling: an ever-deepening type argument
                        // (`deep(v: (v, v))` through an anonymous record) grows fn instances
                        // without a matching genInst — gate here too, not only in scanType.
                        mut val di: U64 = 0
                        while di < finalArgs.count() {
                            try self.checkInstDepth(ref: finalArgs[di])
                            di += 1
                        }
                        self.monoWork.fnInsts.append(<FnInst fnIdx=fi args=finalArgs />)
                    }
                }
            }
            }
        }
        return <Result.Ok value=() />
    }

    // Ground unfound (or name-less) inferred type args from the call's result type when
    // it is a generic instance of the assoc fn's receiver head (the type params line up
    // 1:1 with the receiver's args for a `Type[params]` constructor). A no-op when the
    // args already determined every param.
    inout fn groundAssocFromResult(resultRef: U64, recvStart: U64, recvLen: U64, inferred: inout Array[U64]) {
        if resultRef == 0U64 {
            return
        }
        if !(self.isGenericInst(ref: resultRef)) {
            return
        }
        val rt: TypeRef = self.arena.typeAt(index: resultRef)
        if !(spansEqual(c: inout self, aStart: rt.nameStart, aLen: rt.nameLen, bStart: recvStart, bLen: recvLen)) {
            return
        }
        if rt.args.count() != inferred.count() {
            return
        }
        mut val i: U64 = 0
        while i < inferred.count() {
            mut val needsGround: Bool = inferred[i] == 0U64
            if !(needsGround) {
                if self.arena.typeTerms[inferred[i]].nameLen == 0U64 {
                    needsGround = true
                }
            }
            if needsGround {
                inferred.set(i: i, value: rt.args[i])
            }
            i += 1
        }
    }

    // Register a method instance from the final callable chosen by resolution.  The
    // optional index lets every call spelling (`.` and `#`) share demand discovery
    // without a second source-selection query in Mono.
    inout fn registerMethodInst(callId: U64 = 4000000000U64, recv: U64, nameStart: U64, nameLen: U64, args: ArgRange, finalIdx: U64 = 4000000000U64) -> Result[(), CompileDiagnostic] {
        // Demand discovery consumes the selected receiver result before any
        // construction-time query. A canonical receiver cannot be invalidated
        // by reopening its source expression merely to recover its name.
        val concreteRecvRef: U64 = (try self.groundedBodyReceiverRef(exprId: recv))
        val rt0: TypeInfo = if concreteRecvRef != 0U64 && concreteRecvRef < self.arena.typeCount() {
            give self.typeInfoOfRef(ref: concreteRecvRef)
        } else {
            give try self.typeOf(id: recv)
        }
        // recover the receiver type-name span: a struct/enum (kind 2) carries it; a
        // String value (kind 1) recovers "String"; a primitive (kind 0, e.g. `U64`)
        // already carries its name. A generic method on a primitive (`u64.hash[H]`)
        // must register its instance too, so we no longer bail on non-struct kinds —
        // only arrays (kind 3, handled per element type) and nameless values are skipped.
        mut val rt: TypeInfo = rt0
        // A method body can be the first use that exposes a nested generic
        // receiver (`self.data.append` => Buffer[T]).  Register that concrete
        // receiver before resolving its call so the final-callee body walk is
        // complete before backend starts emitting lazy generic methods.
        if concreteRecvRef != 0U64 {
            try self.scanType(ref: concreteRecvRef)
        } else if rt.ref != 0U64 {
            try self.scanType(ref: rt.ref)
        }
        if rt.kind == 3 {
            return <Result.Ok value=() />
        }
        if rt.nameLen == 0 {
            return <Result.Ok value=() />
        }
        val genericRecv: Bool = self.isGenericInst(ref: concreteRecvRef)
        mut val mi: U64 = finalIdx
        if mi == 4000000000U64 {
            mi = (try self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args))
        }
        if mi == self.arena.functionCount() {
            return <Result.Ok value=() />
        }
        val mf: Func = self.arena.functionAt(index: mi)
        // Associated functions have no value receiver.  Their instance is
        // registered from the completed final-callee table, where the selected
        // subject is explicit; treating the type-name AST as a method receiver
        // here creates a competing (often receiver-less) FnInst.
        if mf.isAssoc { return <Result.Ok value=() /> }
        if mf.typeParams.count() == 0 {
            return <Result.Ok value=() />
        }
        // a generic receiver supplies the first `rcount` type params; the method must
        // have its OWN params beyond that to need a call-site instance (`filterIter.map`).
        // Without own params (`filterIter.filter`) it is emitted per receiver
        // instantiation (emitMonoMethods), so skip it here.
        mut val rcount: U64 = 0
        mut val recvInst: U64 = 0
        if genericRecv {
            rcount = self.recvParamCount(ref: concreteRecvRef)
            recvInst = concreteRecvRef
            if mf.typeParams.count() <= rcount {
                return <Result.Ok value=() />
            }
        }
        try self.setSelfItemEnv(recvStart: rt.nameStart, recvLen: rt.nameLen, recvInstRef: recvInst)
        // As for free calls, a method-own instance is keyed by the resolved
        // callable descriptor.  Its receiver substitutions and own generic
        // substitutions are one vector selected by Mono, never a second
        // inference from this method AST.
        mut val fullArgs: Array[U64] = []
        if callId != 4000000000U64 {
            fullArgs = (try self.bodyCalleeTypeArgs(exprId: callId))
        }
        if (try self.fnArgsAllGround(args: fullArgs)) {
            if !(self.fnInstExists(fnIdx: mi, args: fullArgs, recvInstRef: recvInst)) {
                self.monoWork.fnInsts.append(<FnInst fnIdx=mi args=fullArgs recvInstRef=recvInst />)
            }
            // Mono has already selected and grounded this call under its
            // concrete receiver/proof.  Registration is a consumer of that
            // final decision, not another return-type resolver: re-grounding
            // `mf.retTy` from the shared provided-method template can turn a
            // completed `MapIter[..., fn[I64, I64], I64]` back into
            // `MapIter[..., fn[I64, Item], I64]`.  Use the descriptor both for
            // reachability and for the type scan; LLVM receives the same term.
            if mf.hasRet && callId != 4000000000U64 {
                val finalResult: U64 = (try self.bodyCalleeResultRef(exprId: callId))
                if finalResult != 0U64 {
                    try self.scanType(ref: finalResult)
                }
            }
        }
        self.clearSelfItemEnv()
        return <Result.Ok value=() />
    }

    inout fn recvParamCount(ref: U64) -> U64 {
        val gsi: U64 = self.structIndexForType(ref: ref)
        if gsi < self.arena.structCount() {
            return self.arena.structAt(index: gsi).typeParams.count()
        }
        val gei: U64 = self.enumIndexForType(ref: ref)
        if gei < self.arena.enumCount() {
            return self.arena.enumAt(index: gei).typeParams.count()
        }
        return 0
    }
}
