// Part of monomorphization (root: _.pw): generic free-function inference and
// instance registration.

// Whether c.arena.funcs[fi] is a generic free function (no receiver, has type params).

pub impl Comp {
    inout fn isGenericFreeFn(fi: U64) -> Bool {
        if fi >= self.arena.funcs.count() {
            return false
        }
        val f: Func = self.arena.funcs[fi]
        if f.hasRecv {
            return false
        }
        return f.typeParams.count() > 0
    }

    inout fn findOrAddTypeRef(nameStart: U64, nameLen: U64) -> U64 {
        val q: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.types.count() {
            val t: TypeRef = self.arena.types[i]
            if t.args.count() == 0 {
                // a bare NAME lookup must not alias a facet-carrying ref: `P#Ext`
                // (viewExtId) and `any P` (isAny) are distinct types from plain `P`
                // (spec/08,09) — returning one for the other leaks the facet.
                if t.nameId == q && t.viewExtId == 0U64 && !(t.isAny) {
                    return i
                }
            }
            i += 1
        }
        val noArgs: Array[U64] = []
        return self.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=noArgs />)
    }

    inout fn closureFnTypeRef(params: Array[Param], retTy: U64) -> U64 {
        val fnName: Bind = self.kwSpan(kw: "fn", kwLen: 2)
        mut val args: Array[U64] = []
        args.append(retTy)
        mut val i: U64 = 0
        while i < params.count() {
            args.append(params[i].ty)
            i += 1
        }
        return self.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=args />)
    }

    inout fn unifyTypeParam(paramRef: U64, argRef: U64, tpStart: U64, tpLen: U64) -> U64 {
        if paramRef >= self.arena.types.count() {
            return 0
        }
        val pt: TypeRef = self.arena.types[paramRef]
        if pt.args.count() == 0 {
            if pt.nameId == intern(c: inout self, start: tpStart, len: tpLen) {
                return argRef
            }
            return 0
        }
        if argRef >= self.arena.types.count() {
            return 0
        }
        val at: TypeRef = self.arena.types[argRef]
        mut val i: U64 = 0
        while i < pt.args.count() {
            if i < at.args.count() {
                val r: U64 = self.unifyTypeParam(paramRef: pt.args[i], argRef: at.args[i], tpStart: tpStart, tpLen: tpLen)
                if r != 0 {
                    return r
                }
            }
            i += 1
        }
        return 0
    }

    inout fn tyRefOfInfo(ti: TypeInfo) -> U64 {
        if ti.ref != 0 {
            return ti.ref
        }
        if ti.nameLen == 0 {
            return 0
        }
        if ti.kind == 3 {
            // arrays as type arguments are deferred (no generic-over-array yet).
            return 0
        }
        return self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
    }

    // The element ref of an `Array[E]`-typed argument, from the expression's type —
    // an array local's carried ref, a call's declared `Array[E]` return, a field, … —
    // not just an Ident local (an Ident-only walk left `f(xs: mkArr())` uninferred).
    // A NON-EMPTY array-literal argument (`f(xs: ["a", "b"])`) derives from its first
    // element (exprType reports the literal itself as unknown — element-wise typing).
    inout fn argArrayElemRef(argExpr: U64) -> U64 {
        val r: U64 = self.typedIrRefOfInfo(ti: self.typeOf(id: argExpr))
        if r != 0 && r < self.arena.types.count() {
            val t: TypeRef = self.arena.types[r]
            if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                if t.args.count() == 1 {
                    return t.args[0]
                }
            }
        }
        match self.arena.exprs[argExpr] {
            Expr.Array(val elems) => {
                if elems.count() > 0 {
                    return self.typedIrRefOfInfo(ti: self.exprType(id: elems[0]))
                }
            }
            _ => {}
        }
        return 0
    }

    inout fn argViewRef(argExpr: U64, baseRef: U64) -> U64 {
        if baseRef == 0 {
            return 0
        }
        match self.arena.exprs[argExpr] {
            Expr.ExtView(recv: _, val srcStart, val srcLen, val strip) => {
                if strip {
                    return baseRef
                }
                val vid: U64 = intern(c: inout self, start: srcStart, len: srcLen)
                val bt: TypeRef = self.arena.types[baseRef]
                return self.pushType(t: <TypeRef nameStart=bt.nameStart nameLen=bt.nameLen args=bt.args viewExtId=vid />)
            }
            _ => {
                return baseRef
            }
        }
    }

    inout fn inferFnArgs(f: Func, args: Array[Arg]) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val ti: U64 = 0
        while ti < f.typeParams.count() {
            val tp: Bind = f.typeParams[ti]
            mut val found: U64 = 0
            mut val pi: U64 = 0
            while pi < f.params.count() {
                val p: Param = f.params[pi]
                mut val cand: U64 = 0
                if p.tyIsArray {
                    // `Array[T]` param: infer T from the argument array's element.
                    if p.tyNameId == tp.nameId {
                        if pi < args.count() {
                            cand = self.argArrayElemRef(argExpr: args[pi].expr)
                        }
                    }
                } else {
                    // structurally unify the parameter's type against the argument's, so
                    // `T` is found whether it is the whole parameter type (`x: T`) or
                    // nested in it (`f: fn(x: Item) -> T`).
                    if pi < args.count() {
                        val at: TypeInfo = self.typeOf(id: args[pi].expr)
                        val argRef: U64 = self.argViewRef(argExpr: args[pi].expr, baseRef: self.tyRefOfInfo(ti: at))
                        cand = self.unifyTypeParam(paramRef: p.ty, argRef: argRef, tpStart: tp.nameStart, tpLen: tp.nameLen)
                    }
                }
                if cand != 0 {
                    if found == 0 {
                        found = cand
                    } else {
                        // two arguments pinning the SAME param to different concrete
                        // types (`lens(a: [1I64], b: ["x"])` with `a/b: Array[T]`) is a
                        // type error, not a first-one-wins (曖昧はエラー) — silently
                        // keeping the first sent emission after a witness that does not
                        // exist. Only two GROUND disagreeing refs are conclusive (a
                        // parametric candidate in a template body is not evidence).
                        if self.tyRefIsGround(ref: found) && self.tyRefIsGround(ref: cand) {
                            if !(self.sameMangle(refA: found, refB: cand)) {
                                compileErrorAt(line: self.lineOf(offset: self.exprOffset(id: args[pi].expr)), msg: "conflicting type arguments: this argument requires a different type for the same generic parameter (spec/06)")
                            }
                        }
                    }
                }
                pi += 1
            }
            out.append(found)
            ti += 1
        }
        return out
    }

    inout fn fnArgsAllGround(args: Array[U64]) -> Bool {
        if args.count() == 0 {
            return false
        }
        mut val i: U64 = 0
        while i < args.count() {
            if args[i] == 0 {
                return false
            }
            if !(self.tyRefIsGround(ref: args[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn fnInstExists(fnIdx: U64, args: Array[U64]) -> Bool {
        mut val i: U64 = 0
        while i < self.monoWork.fnInsts.count() {
            val fin: FnInst = self.monoWork.fnInsts[i]
            if fin.fnIdx == fnIdx {
                if fin.args.count() == args.count() {
                    mut val same: Bool = true
                    mut val j: U64 = 0
                    while j < args.count() {
                        if !(self.typeRefEq(a: fin.args[j], b: args[j])) {
                            same = false
                        }
                        j += 1
                    }
                    if same {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn registerCallInst(id: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
        val fi: U64 = self.resolvedCallee(id: id)
        if fi < self.arena.funcs.count() {
            if self.arena.funcs[fi].isExtern {
                // a generic `extern "plew-intrinsic"` (e.g. `arrayPush[T]`, `arrayGet[T]`):
                // lowered inline at the call site, so it has no monomorphized instance —
                // never register one (else a bogus prototype/body with an unmapped return
                // type leaks out).
            } else {
            if self.isGenericFreeFn(fi: fi) {
                val inferred: Array[U64] = self.inferFnArgs(f: self.arena.funcs[fi], args: args)
                if self.fnArgsAllGround(args: inferred) {
                    if !(self.fnInstExists(fnIdx: fi, args: inferred)) {
                        self.monoWork.fnInsts.append(<FnInst fnIdx=fi args=inferred />)
                    }
                }
            }
            }
        }
    }

    inout fn registerAssocInst(recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg], resultRef: U64) {
        val arn: Bind = self.assocRecvName(recv: recv)
        if arn.nameLen == 0U64 {
            return
        }
        val afi: U64 = self.findAssoc(recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        if afi >= self.arena.funcs.count() {
            return
        }
        if self.arena.funcs[afi].isExtern {
            return
        }
        if self.isGenericFreeFn(fi: afi) {
            mut val inferred: Array[U64] = self.inferFnArgs(f: self.arena.funcs[afi], args: args)
            // ground params the arguments didn't determine — a constructor whose type
            // param comes only from the expected result type (`Set.new()`, or
            // `Set.from([])` whose element type the empty literal can't supply). A
            // constructor returns `Recv[params]`, so when the call's result type is a
            // same-head generic instance, its args ARE the params. Mirrors the backend's
            // groundAssocFromExpected, at the mono-registration layer (else the instance
            // is never registered and the backend rejects the call as un-emittable).
            self.groundAssocFromResult(resultRef: resultRef, recvStart: arn.nameStart, recvLen: arn.nameLen, inferred: inout inferred)
            if self.fnArgsAllGround(args: inferred) {
                if !(self.fnInstExists(fnIdx: afi, args: inferred)) {
                    self.monoWork.fnInsts.append(<FnInst fnIdx=afi args=inferred />)
                }
            }
        }
    }
    // Ground unfound (or name-less) inferred type args from the call's result type when
    // it is a generic instance of the assoc fn's receiver head (the type params line up
    // 1:1 with the receiver's args for a `Type[params]` constructor). A no-op when the
    // args already determined every param.
    inout fn groundAssocFromResult(resultRef: U64, recvStart: U64, recvLen: U64, inferred: inout Array[U64]) {
        if resultRef == 0U64 {
            return
        }
        if !(self.isGenericInst(ref: resultRef)) {
            return
        }
        val rt: TypeRef = self.arena.types[resultRef]
        if !(spansEqual(c: inout self, aStart: rt.nameStart, aLen: rt.nameLen, bStart: recvStart, bLen: recvLen)) {
            return
        }
        if rt.args.count() != inferred.count() {
            return
        }
        mut val i: U64 = 0
        while i < inferred.count() {
            mut val needsGround: Bool = inferred[i] == 0U64
            if !(needsGround) {
                if self.arena.types[inferred[i]].nameLen == 0U64 {
                    needsGround = true
                }
            }
            if needsGround {
                inferred.set(i: i, value: rt.args[i])
            }
            i += 1
        }
    }

    inout fn registerMethodInst(recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
        val rt0: TypeInfo = self.typeOf(id: recv)
        // recover the receiver type-name span: a struct/enum (kind 2) carries it; a
        // String value (kind 1) recovers "String"; a primitive (kind 0, e.g. `U64`)
        // already carries its name. A generic method on a primitive (`u64.hash[H]`)
        // must register its instance too, so we no longer bail on non-struct kinds —
        // only arrays (kind 3, handled per element type) and nameless values are skipped.
        val rt: TypeInfo = rt0
        if rt.kind == 3 {
            return
        }
        if rt.nameLen == 0 {
            return
        }
        val genericRecv: Bool = self.isGenericInst(ref: rt.ref)
        val mi: U64 = self.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        if mi == self.arena.funcs.count() {
            return
        }
        val mf: Func = self.arena.funcs[mi]
        if mf.typeParams.count() == 0 {
            return
        }
        // a generic receiver supplies the first `rcount` type params; the method must
        // have its OWN params beyond that to need a call-site instance (`filterIter.map`).
        // Without own params (`filterIter.filter`) it is emitted per receiver
        // instantiation (emitMonoMethods), so skip it here.
        mut val rcount: U64 = 0
        mut val recvInst: U64 = 0
        if genericRecv {
            rcount = self.recvParamCount(nameStart: rt.nameStart, nameLen: rt.nameLen)
            recvInst = rt.ref
            if mf.typeParams.count() <= rcount {
                return
            }
        }
        self.setSelfItemEnv(recvStart: rt.nameStart, recvLen: rt.nameLen, recvInstRef: recvInst)
        val inferred: Array[U64] = self.inferFnArgs(f: mf, args: args)
        // build the full type-arg vector: the receiver's args fill the first `rcount`
        // slots (not inferrable from the call), the method-own args the rest.
        mut val fullArgs: Array[U64] = []
        if genericRecv {
            val inst: TypeRef = self.arena.types[recvInst]
            mut val ri: U64 = 0
            while ri < rcount {
                if ri < inst.args.count() {
                    fullArgs.append(inst.args[ri])
                }
                ri += 1
            }
            mut val oi: U64 = rcount
            while oi < inferred.count() {
                fullArgs.append(inferred[oi])
                oi += 1
            }
        } else {
            mut val ai: U64 = 0
            while ai < inferred.count() {
                fullArgs.append(inferred[ai])
                ai += 1
            }
        }
        if self.fnArgsAllGround(args: fullArgs) {
            if !(self.fnInstExists(fnIdx: mi, args: fullArgs)) {
                self.monoWork.fnInsts.append(<FnInst fnIdx=mi args=fullArgs recvInstRef=recvInst />)
            }
            // register the grounded return adapter (`MapIter[…,I64]`) + its transitive
            // instantiations, so its typedef/methods get emitted (a generic method is
            // skipped by the struct-field/signature scans).
            val savedP: Array[Bind] = self.cur.typeParams
            val savedA: Array[U64] = self.cur.typeArgs
            self.cur.typeParams = mf.typeParams
            self.cur.typeArgs = fullArgs
            if mf.hasRet {
                self.scanType(ref: mf.retTy)
            }
            self.cur.typeParams = savedP
            self.cur.typeArgs = savedA
        }
        self.clearSelfItemEnv()
    }

    inout fn recvParamCount(nameStart: U64, nameLen: U64) -> U64 {
        val gsi: U64 = self.genericStructIndex(nameStart: nameStart, nameLen: nameLen)
        if gsi < self.arena.structs.count() {
            return self.arena.structs[gsi].typeParams.count()
        }
        val gei: U64 = self.genericEnumIndex(nameStart: nameStart, nameLen: nameLen)
        if gei < self.arena.enums.count() {
            return self.arena.enums[gei].typeParams.count()
        }
        return 0
    }
}
