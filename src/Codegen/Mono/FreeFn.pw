// Part of monomorphization (root: _.pw): generic free-function inference and
// instance registration.

// Whether c.arena.funcs[fi] is a generic free function (no receiver, has type params).

pub impl Comp {
    inout fn isGenericFreeFn(fi: U64) -> Bool {
        if fi >= self.arena.funcs.count() {
            return false
        }
        val f: Func = self.arena.funcs[fi]
        if f.hasRecv {
            return false
        }
        return f.typeParams.count() > 0
    }

    inout fn findOrAddTypeRef(nameStart: U64, nameLen: U64) -> U64 {
        val q: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.types.count() {
            val t: TypeRef = self.arena.types[i]
            if t.args.count() == 0 {
                // a bare NAME lookup must not alias a facet-carrying ref: `P#Ext`
                // (viewExtId) and `any P` (isAny) are distinct types from plain `P`
                // (spec/08,09) — returning one for the other leaks the facet.
                if t.nameId == q && t.viewExtId == 0U64 && t.viewIds.count() == 0U64 && !(t.isAny) && !(t.isSendable) {
                    return i
                }
            }
            i += 1
        }
        val noArgs: Array[U64] = []
        return self.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=noArgs />)
    }

    inout fn closureFnTypeRef(params: Array[Param], retTy: U64) -> U64 {
        val fnName: Bind = self.kwSpan(kw: "fn", kwLen: 2)
        mut val args: Array[U64] = []
        args.append(retTy)
        mut val i: U64 = 0
        while i < params.count() {
            args.append(params[i].ty)
            i += 1
        }
        return self.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=args />)
    }

    inout fn unifyTypeParam(paramRef: U64, argRef: U64, tpStart: U64, tpLen: U64) -> U64 {
        if paramRef >= self.arena.types.count() {
            return 0
        }
        val pt: TypeRef = self.arena.types[paramRef]
        // A projection is not invertible.  From an argument of type
        // `T#Parser.Output` we cannot infer `T`: unrelated conformers may
        // expose the same output type.  Inference must first obtain T from an
        // injective occurrence (for example `x: T`), then ground the whole
        // projection and validate the argument against that result.  Treating
        // the legacy projection head as a bare T falsely inferred `T = I64`
        // from `out: T#Parser.Output` and conflicted with `x: P`.
        if pt.assocNameId != 0U64 {
            return 0
        }
        if pt.args.count() == 0 {
            // TypeRef.nameId is a cache; parameter refs rebuilt after parsing
            // may carry 0.  Generic unification must use the same canonical
            // spelling identity as grounding and final-callee keys.
            mut val paramNameId: U64 = pt.nameId
            if paramNameId == 0U64 {
                paramNameId = intern(c: inout self, start: pt.nameStart, len: pt.nameLen)
            }
            if paramNameId == intern(c: inout self, start: tpStart, len: tpLen) {
                return argRef
            }
            return 0
        }
        if argRef >= self.arena.types.count() {
            return 0
        }
        val at: TypeRef = self.arena.types[argRef]
        mut val i: U64 = 0
        while i < pt.args.count() {
            if i < at.args.count() {
                val r: U64 = self.unifyTypeParam(paramRef: pt.args[i], argRef: at.args[i], tpStart: tpStart, tpLen: tpLen)
                if r != 0 {
                    return r
                }
            }
            i += 1
        }
        return 0
    }

    inout fn tyRefOfInfo(ti: TypeInfo) -> U64 {
        if ti.ref != 0 {
            return ti.ref
        }
        if ti.nameLen == 0 {
            return 0
        }
        if ti.kind == 3 {
            // arrays as type arguments are deferred (no generic-over-array yet).
            return 0
        }
        return self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
    }

    // The element ref of an `Array[E]`-typed argument, from the expression's type —
    // an array local's carried ref, a call's declared `Array[E]` return, a field, … —
    // not just an Ident local (an Ident-only walk left `f(xs: mkArr())` uninferred).
    // A NON-EMPTY array-literal argument (`f(xs: ["a", "b"])`) derives from its first
    // element (exprType reports the literal itself as unknown — element-wise typing).
    inout fn argArrayElemRef(argExpr: U64) -> U64 {
        val r: U64 = self.typedIrRefOfInfo(ti: self.typeOf(id: argExpr))
        if r != 0 && r < self.arena.types.count() {
            val t: TypeRef = self.arena.types[r]
            if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                if t.args.count() == 1 {
                    return t.args[0]
                }
            }
        }
        match self.arena.exprs[argExpr] {
            Expr.Array(val elems) => {
                if elems.count() > 0 {
                    return self.typedIrRefOfInfo(ti: self.exprType(id: elems[0]))
                }
            }
            _ => {}
        }
        return 0
    }

    inout fn argViewRef(argExpr: U64, baseRef: U64) -> U64 {
        if baseRef == 0 {
            return 0
        }
        match self.arena.exprs[argExpr] {
            Expr.ExtView(recv: _, val source, val strip) => {
                if strip {
                    return baseRef
                }
                val bt: TypeRef = self.arena.types[baseRef]
                mut val sources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: baseRef)
                mut val present: Bool = false
                mut val i: U64 = 0U64
                while i < sources.count() {
                    if self.semanticViewSourceEq(a: sources[i], b: source) { present = true }
                    i += 1U64
                }
                if !present { sources.append(source) }
                return self.typeRefWithViewSources(ref: baseRef, sources: sources)
            }
            _ => {
                return baseRef
            }
        }
    }

    inout fn inferFnArgs(f: Func, args: Array[Arg]) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val ti: U64 = 0
        while ti < f.typeParams.count() {
            val tp: Bind = f.typeParams[ti]
            mut val found: U64 = 0
            mut val pi: U64 = 0
            while pi < f.params.count() {
                val p: Param = f.params[pi]
                mut val cand: U64 = 0
                if p.tyIsArray {
                    // `Array[T]` param: infer T from the argument array's element.
                    if p.tyNameId == tp.nameId {
                        val ai: U64 = self.argIndexForParam(params: f.params, args: args, paramIdx: pi)
                        if ai < args.count() {
                            cand = self.argArrayElemRef(argExpr: args[ai].expr)
                        }
                    }
                } else {
                    // structurally unify the parameter's type against the argument's, so
                    // `T` is found whether it is the whole parameter type (`x: T`) or
                    // nested in it (`f: fn(x: Item) -> T`).
                    val ai: U64 = self.argIndexForParam(params: f.params, args: args, paramIdx: pi)
                    if ai < args.count() {
                        // This runs while scanning one concrete body instance.
                        // `typeOf` is deliberately AST-global and can only
                        // report the pre-binding shape of a match payload;
                        // `exprType` sees the current local environment, which
                        // is where `Optional[I64].Some(v)` gives `v: I64`.
                        // Generic inference must use that same concrete type
                        // authority as final-callable resolution.
                        val at: TypeInfo = self.exprType(id: args[ai].expr)
                        mut val baseRef: U64 = self.tyRefOfInfo(ti: at)
                        // A final body instance owns the concrete type of a
                        // local/receiver.  It takes precedence even when the
                        // AST-global cache happens to contain another *ground*
                        // instantiation of the same generic template (for
                        // example Optional[I64] before Optional[String] in one
                        // loop body); a ground-looking cache entry is not proof
                        // that it belongs to this body instance.
                        // A suffix on a literal is explicit source meaning
                        // (`0I64`, `1U8`), stronger than a surrounding
                        // match/expected-type projection stored in parametric
                        // IR.  Locals and compound expressions, on the other
                        // hand, take their exact body-local identity below.
                        mut val literalIsExplicit: Bool = false
                        match self.arena.exprs[args[ai].expr] {
                            Expr.Int(value: _, offset: _, isBool: _, val tyStart, val tyLen, isNeg: _) => {
                                literalIsExplicit = tyLen != 0U64
                                if literalIsExplicit {
                                    baseRef = self.findOrAddTypeRef(nameStart: tyStart, nameLen: tyLen)
                                }
                            }
                            Expr.Str(start: _, len: _) => {
                                literalIsExplicit = true
                                val stringName: Bind = self.kwSpan(kw: "String", kwLen: 6U64)
                                baseRef = self.findOrAddTypeRef(nameStart: stringName.nameStart, nameLen: stringName.nameLen)
                            }
                            _ => {}
                        }
                        if !literalIsExplicit {
                            val grounded: U64 = self.groundedBodyReceiverRef(exprId: args[ai].expr)
                            if grounded != 0U64 { baseRef = grounded }
                            // A nested call/operator's selected result is the
                            // exact semantic type for this body instance.  The
                            // AST-wide TypeInfo is only a template projection and
                            // may be nonzero yet still retain an ungrounded
                            // provided-method result (`Item`, `B`, …).  Prefer the
                            // finalized descriptor whenever it exists; otherwise a
                            // surrounding generic call can lose its own argument
                            // despite the child having already been resolved.
                            val selectedResult: U64 = self.bodyCalleeResultRef(exprId: args[ai].expr)
                            if selectedResult != 0U64 {
                                baseRef = selectedResult
                            }
                            // The semantic expression term is the body-local
                            // type authority.  In particular, `p.value` in an
                            // iterator body is a field of this concrete
                            // iteration record; `exprType` can only recover
                            // the shared template's `E`.  Read the recorded
                            // term through the active body environment before
                            // consulting older receiver/call descriptor
                            // bridges.  This is not a second inference pass:
                            // it merely consumes the same semantic term used
                            // by Mono and LLVM elsewhere.
                            val semantic: U64 = self.groundedTypeOf(id: args[ai].expr)
                            if semantic != 0U64 {
                                baseRef = semantic
                            }
                        }
                        // A generic body is shared by all instances, so the
                        // AST-global TypeInfo for `self`/a local can still be
                        // the parameter spelling (`T`).  Mono owns its concrete
                        // body environment: use that exact receiver identity
                        // before attempting inference, never defer it to LLVM.
                        val argRef: U64 = self.argViewRef(argExpr: args[ai].expr, baseRef: baseRef)
                        cand = self.unifyTypeParam(paramRef: p.ty, argRef: argRef, tpStart: tp.nameStart, tpLen: tp.nameLen)
                    }
                }
                if cand != 0 {
                    if found == 0 {
                        found = cand
                    } else {
                        // two arguments pinning the SAME param to different concrete
                        // types (`lens(a: [1I64], b: ["x"])` with `a/b: Array[T]`) is a
                        // type error, not a first-one-wins (曖昧はエラー) — silently
                        // keeping the first sent emission after a witness that does not
                        // exist. Only two GROUND disagreeing refs are conclusive (a
                        // parametric candidate in a template body is not evidence).
                        if self.tyRefIsGround(ref: found) && self.tyRefIsGround(ref: cand) {
                            if !(self.sameMangle(refA: found, refB: cand)) {
                                val ai: U64 = self.argIndexForParam(params: f.params, args: args, paramIdx: pi)
                                mut val off: U64 = f.nameStart
                                if ai < args.count() {
                                    off = self.exprOffset(id: args[ai].expr)
                                }
                                self.errorAt(offset: off, msg: "conflicting type arguments: this argument requires a different type for the same generic parameter (spec/06)")
                            }
                        }
                    }
                }
                pi += 1
            }
            out.append(found)
            ti += 1
        }
        return out
    }

    inout fn fnArgsAllGround(args: Array[U64]) -> Bool {
        if args.count() == 0 {
            return false
        }
        mut val i: U64 = 0
        while i < args.count() {
            if args[i] == 0 {
                return false
            }
            if !(self.tyRefIsGround(ref: args[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    // Code-generation instances are identified by the selected callable, its
    // complete substitutions, and its concrete receiver subject.  The latter
    // is empty for ordinary free functions, but is essential for associated
    // callables and provided bodies: their `Self` environment is part of the
    // emitted body.  Keeping this key here makes every registration path use
    // the same identity as final-body discovery and LLVM's function cache.
    inout fn fnInstExists(fnIdx: U64, args: Array[U64], recvInstRef: U64 = 0U64) -> Bool {
        mut val i: U64 = 0
        while i < self.monoWork.fnInsts.count() {
            val fin: FnInst = self.monoWork.fnInsts[i]
            if fin.fnIdx == fnIdx && self.sameBodyReceiver(a: fin.recvInstRef, b: recvInstRef) {
                if fin.args.count() == args.count() {
                    mut val same: Bool = true
                    mut val j: U64 = 0
                    while j < args.count() {
                        if !(self.typeRefEq(a: fin.args[j], b: args[j])) {
                            same = false
                        }
                        j += 1
                    }
                    if same {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn registerCallInst(id: U64, nameStart: U64, nameLen: U64, args: Array[Arg], finalIdx: U64) {
        val fi: U64 = finalIdx
        if fi < self.arena.funcs.count() {
            if self.arena.funcs[fi].isExtern {
                // a generic `extern(plewIntrinsic)` (e.g. `arrayPush[T]`, `arrayGet[T]`):
                // lowered inline at the call site, so it has no monomorphized instance —
                // never register one (else a bogus prototype/body with an unmapped return
                // type leaks out).
            } else {
            if self.isGenericFreeFn(fi: fi) {
                // Finalization has already selected the callable and grounded
                // its substitutions for this exact body instance.  Re-inferring
                // from the shared AST here creates a second `fn[T]` instance
                // beside `fn[I64]`/`fn[String]`; that stale template then has
                // no concrete receiver for its nested calls.  Instance demand
                // is therefore a pure consumer of the final descriptor.
                val finalArgs: Array[U64] = self.bodyCalleeTypeArgs(exprId: id)
                if finalArgs.count() == self.arena.funcs[fi].typeParams.count() && self.fnArgsAllGround(args: finalArgs) {
                    if !(self.fnInstExists(fnIdx: fi, args: finalArgs)) {
                        // polymorphic-recursion ceiling: an ever-deepening type argument
                        // (`deep(v: (v, v))` through an anonymous record) grows fn instances
                        // without a matching genInst — gate here too, not only in scanType.
                        mut val di: U64 = 0
                        while di < finalArgs.count() {
                            self.checkInstDepth(ref: finalArgs[di])
                            di += 1
                        }
                        self.monoWork.fnInsts.append(<FnInst fnIdx=fi args=finalArgs />)
                    }
                }
            }
            }
        }
    }

    // Ground unfound (or name-less) inferred type args from the call's result type when
    // it is a generic instance of the assoc fn's receiver head (the type params line up
    // 1:1 with the receiver's args for a `Type[params]` constructor). A no-op when the
    // args already determined every param.
    inout fn groundAssocFromResult(resultRef: U64, recvStart: U64, recvLen: U64, inferred: inout Array[U64]) {
        if resultRef == 0U64 {
            return
        }
        if !(self.isGenericInst(ref: resultRef)) {
            return
        }
        val rt: TypeRef = self.arena.types[resultRef]
        if !(spansEqual(c: inout self, aStart: rt.nameStart, aLen: rt.nameLen, bStart: recvStart, bLen: recvLen)) {
            return
        }
        if rt.args.count() != inferred.count() {
            return
        }
        mut val i: U64 = 0
        while i < inferred.count() {
            mut val needsGround: Bool = inferred[i] == 0U64
            if !(needsGround) {
                if self.arena.types[inferred[i]].nameLen == 0U64 {
                    needsGround = true
                }
            }
            if needsGround {
                inferred.set(i: i, value: rt.args[i])
            }
            i += 1
        }
    }

    // Register a method instance from the final callable chosen by resolution.  The
    // optional index lets every call spelling (`.` and `#`) share demand discovery
    // without a second source-selection query in Mono.
    inout fn registerMethodInst(callId: U64 = 4000000000U64, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg], finalIdx: U64 = 4000000000U64) {
        val rt0: TypeInfo = self.typeOf(id: recv)
        // recover the receiver type-name span: a struct/enum (kind 2) carries it; a
        // String value (kind 1) recovers "String"; a primitive (kind 0, e.g. `U64`)
        // already carries its name. A generic method on a primitive (`u64.hash[H]`)
        // must register its instance too, so we no longer bail on non-struct kinds —
        // only arrays (kind 3, handled per element type) and nameless values are skipped.
        mut val rt: TypeInfo = rt0
        val concreteRecvRef: U64 = self.groundedBodyReceiverRef(exprId: recv)
        if concreteRecvRef != 0U64 && concreteRecvRef < self.arena.types.count() {
            rt = self.typeInfoOfRef(ref: concreteRecvRef)
        }
        // A method body can be the first use that exposes a nested generic
        // receiver (`self.data.append` => Buffer[T]).  Register that concrete
        // receiver before resolving its call so the final-callee body walk is
        // complete before backend starts emitting lazy generic methods.
        if concreteRecvRef != 0U64 {
            self.scanType(ref: concreteRecvRef)
        } else if rt.ref != 0U64 {
            self.scanType(ref: rt.ref)
        }
        if rt.kind == 3 {
            return
        }
        if rt.nameLen == 0 {
            return
        }
        val genericRecv: Bool = self.isGenericInst(ref: concreteRecvRef)
        mut val mi: U64 = finalIdx
        if mi == 4000000000U64 {
            mi = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        if mi == self.arena.funcs.count() {
            return
        }
        val mf: Func = self.arena.funcs[mi]
        // Associated functions have no value receiver.  Their instance is
        // registered from the completed final-callee table, where the selected
        // subject is explicit; treating the type-name AST as a method receiver
        // here creates a competing (often receiver-less) FnInst.
        if mf.isAssoc { return }
        if mf.typeParams.count() == 0 {
            return
        }
        // a generic receiver supplies the first `rcount` type params; the method must
        // have its OWN params beyond that to need a call-site instance (`filterIter.map`).
        // Without own params (`filterIter.filter`) it is emitted per receiver
        // instantiation (emitMonoMethods), so skip it here.
        mut val rcount: U64 = 0
        mut val recvInst: U64 = 0
        if genericRecv {
            rcount = self.recvParamCount(nameStart: rt.nameStart, nameLen: rt.nameLen)
            recvInst = concreteRecvRef
            if mf.typeParams.count() <= rcount {
                return
            }
        }
        self.setSelfItemEnv(recvStart: rt.nameStart, recvLen: rt.nameLen, recvInstRef: recvInst)
        // As for free calls, a method-own instance is keyed by the resolved
        // callable descriptor.  Its receiver substitutions and own generic
        // substitutions are one vector selected by Mono, never a second
        // inference from this method AST.
        mut val fullArgs: Array[U64] = []
        if callId != 4000000000U64 {
            fullArgs = self.bodyCalleeTypeArgs(exprId: callId)
        }
        if self.fnArgsAllGround(args: fullArgs) {
            if !(self.fnInstExists(fnIdx: mi, args: fullArgs, recvInstRef: recvInst)) {
                self.monoWork.fnInsts.append(<FnInst fnIdx=mi args=fullArgs recvInstRef=recvInst />)
            }
            // Mono has already selected and grounded this call under its
            // concrete receiver/proof.  Registration is a consumer of that
            // final decision, not another return-type resolver: re-grounding
            // `mf.retTy` from the shared provided-method template can turn a
            // completed `MapIter[..., fn[I64, I64], I64]` back into
            // `MapIter[..., fn[I64, Item], I64]`.  Use the descriptor both for
            // reachability and for the type scan; LLVM receives the same term.
            if mf.hasRet && callId != 4000000000U64 {
                val finalResult: U64 = self.bodyCalleeResultRef(exprId: callId)
                if finalResult != 0U64 {
                    self.scanType(ref: finalResult)
                }
            }
        }
        self.clearSelfItemEnv()
    }

    inout fn recvParamCount(nameStart: U64, nameLen: U64) -> U64 {
        val gsi: U64 = self.genericStructIndex(nameStart: nameStart, nameLen: nameLen)
        if gsi < self.arena.structs.count() {
            return self.arena.structs[gsi].typeParams.count()
        }
        val gei: U64 = self.genericEnumIndex(nameStart: nameStart, nameLen: nameLen)
        if gei < self.arena.enums.count() {
            return self.arena.enums[gei].typeParams.count()
        }
        return 0
    }
}
