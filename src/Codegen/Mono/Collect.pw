// Part of monomorphization (root: _.pw): the collection driver.

pub impl Comp {
    inout fn collectFnInsts() {
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            // skip generic templates (their instances come from call sites) and extern
            // fns (body == 0 is a sentinel; walking block 0 would scan an unrelated body).
            if !(f.typeParams.count() > 0 || f.isExtern) {
                val noParams: Array[Bind] = []
                val noArgs: Array[U64] = []
                self.cur.locals = []
                self.seedGlobalLocals()
                self.cur.hasRecv = f.hasRecv
                self.cur.recvStart = f.recvStart
                self.cur.recvLen = f.recvLen
                self.cur.selfInout = f.selfInout
                self.cur.recvInstRef = 0
                self.cur.typeParams = noParams
                self.cur.typeArgs = noArgs
                mut val pi: U64 = 0
                while pi < f.params.count() {
                    val p: Param = f.params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    self.scanType(ref: p.ty)
                    pi += 1
                }
                if f.hasRet {
                    self.scanType(ref: f.retTy)
                }
                self.scanBlockInsts(blkId: f.body)
            }
            fi += 1
        }
        // generic-receiver method bodies: walk them under the receiver env so a nested
        // generic call (`key.hash[H]` -> `String.hash[SipHasher]`) registers its instance
        // before the transitive worklist below scans it.
        self.scanGenInstMethodBodies()
        // transitive instantiation: walk each generic free function instance's body
        // with its type-parameter env active (so type-parameter-typed args resolve to
        // concrete types), registering the instances it calls. The loop re-reads
        // self.monoWork.fnInsts.count() each step, so newly appended instances are scanned too — a
        // worklist that runs to fixpoint (a generic fn calling another generic fn).
        mut val si: U64 = 0
        while si < self.monoWork.fnInsts.count() {
            val fin: FnInst = self.monoWork.fnInsts[si]
            val gf: Func = self.arena.funcs[fin.fnIdx]
            self.cur.locals = []
            self.seedGlobalLocals()
            // a generic *method* instance carries a receiver: set the self env (and the
            // receiver instantiation for a generic receiver) so `self`/`self.field`
            // resolve while scanning its body — without this, a derived `hash[H]` that
            // calls `self.field.hash(...)` can't type `self.field`, so the field's own
            // (transitive) generic-method instance is never discovered. A free function
            // has hasRecv=false, so this is a no-op for it (env stays cleared).
            self.cur.hasRecv = gf.hasRecv
            self.cur.recvStart = gf.recvStart
            self.cur.recvLen = gf.recvLen
            self.cur.selfInout = gf.selfInout
            self.cur.recvInstRef = fin.recvInstRef
            if gf.hasRecv {
                self.setSelfItemEnv(recvStart: gf.recvStart, recvLen: gf.recvLen, recvInstRef: fin.recvInstRef)
            }
            self.cur.typeParams = gf.typeParams
            self.cur.typeArgs = fin.args
            mut val gpi: U64 = 0
            while gpi < gf.params.count() {
                val gp: Param = gf.params[gpi]
                self.addLocal(nameStart: gp.nameStart, nameLen: gp.nameLen, tyStart: gp.tyStart, tyLen: gp.tyLen, isArray: gp.tyIsArray, ty: gp.ty, isInout: gp.isInout, isMut: false, owned: false)
                // register the grounded param type so an `Array[E]` param (-> `Array[I64]`)
                // gets its per-instance `%gs` typedef. The method body's `source.count()`
                // can't register it (registerMethodInst bails on an array receiver), and no
                // field/return scan reaches a param-only instance.
                self.scanType(ref: gp.ty)
                gpi += 1
            }
            if gf.hasRet {
                self.scanType(ref: gf.retTy)
            }
            self.scanBlockInsts(blkId: gf.body)
            if gf.hasRecv {
                self.clearSelfItemEnv()
            }
            si += 1
        }
        val noP: Array[Bind] = []
        val noA: Array[U64] = []
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.typeParams = noP
        self.cur.typeArgs = noA
        self.cur.inClosure = false
        self.cur.closureId = 0
        self.cur.captureMark = 0
    }
}
