// Part of monomorphization (root: _.pw): the collection driver.

pub impl Comp {
    inout fn collectFnInsts() {
        // gen mode (spec/16): the synthesized harness `genMainIdx` is the sole entry
        // point — the user's own `main` is dead (never linked). Skip it as a discovery
        // root so its body (which may call a `where T: Eq` generic over a type whose Eq
        // is produced by the derive we're about to GENERATE) doesn't register a premature
        // instance and trip a bounds check against a not-yet-materialized conformance.
        mut val deadMainId: U64 = 0
        if self.genMode {
            val mainN: Bind = self.internBytes(s: "main")
            deadMainId = intern(c: inout self, start: mainN.nameStart, len: mainN.nameLen)
        }
        // global initializers first: a module-level `val g = makeBox(v: 42I64)` is
        // program code too — its initializer expression registers the fn/method/type
        // instances it reaches, exactly like a function body (an un-scanned initializer
        // left the callee instance and the inferred type unregistered: a misleading
        // "not a registered struct" reject on field access, SIGSEGV on a method call).
        // Each Let adds itself as a local as it goes, so a later init reading an
        // earlier global resolves — same shape as the record and verify walks.
        val noParamsG: Array[Bind] = []
        val noArgsG: Array[U64] = []
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.recvInstRef = 0
        self.cur.typeParams = noParamsG
        self.cur.typeArgs = noArgsG
        self.cur.bodyFnIdx = 18446744073709551615U64
        self.cur.bodyRecvInstRef = 0U64
        self.cur.bodyTypeArgs = noArgsG
        self.cur.bodyTypeParams = noParamsG
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
        mut val gvi: U64 = 0
        while gvi < self.arena.globals.count() {
            self.scanStmtInsts(stmtId: self.arena.globals[gvi].letStmt)
            gvi += 1
        }
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            if self.genMode {
                if f.nameId == deadMainId {
                    if fi != self.genMainIdx {
                        fi += 1
                        continue
                    }
                }
            }
            // skip generic templates (their instances come from call sites) and extern
            // fns (body == 0 is a sentinel; walking block 0 would scan an unrelated body).
            // A provided trait body is a parametric template shared by every
            // conformer.  It has no concrete receiver instance on its own, so
            // it cannot own a final-callable table entry.  Its selected copies
            // are walked through their reachable concrete instances instead.
            if !(f.typeParams.count() > 0 || f.isExtern || self.methodRecvIsTrait(f: f)) {
                val noParams: Array[Bind] = []
                val noArgs: Array[U64] = []
                self.cur.locals = []
                self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: f))
                self.cur.hasRecv = f.hasRecv
                self.cur.recvStart = f.recvStart
                self.cur.recvLen = f.recvLen
                self.cur.extId = f.extId
                self.cur.selfInout = f.selfInout
                self.cur.recvInstRef = 0
                self.cur.typeParams = noParams
                self.cur.typeArgs = noArgs
                self.cur.bodyFnIdx = fi
                self.cur.bodyRecvInstRef = 0U64
                self.cur.bodyTypeArgs = noArgs
                self.cur.bodyTypeParams = noParams
                if f.hasRecv {
                    // A concrete provided-method copy still records its shared
                    // body through `Self`; give the Mono resolver the same
                    // receiver binding that genLlvmFuncBody will install.
                    self.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
                } else {
                    self.clearSelfItemEnv()
                }
                self.cur.bodySelfRef = self.cur.selfRef
                self.cur.bodyItemRef = self.cur.itemRef
                self.cur.bodyRecvInstRef = self.cur.selfRef
                mut val pi: U64 = 0
                while pi < f.params.count() {
                    val p: Param = f.params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    self.scanType(ref: p.ty)
                    pi += 1
                }
                if f.hasRet {
                    self.scanType(ref: f.retTy)
                }
                self.scanBlockInsts(blkId: f.body)
                if f.hasRecv {
                    self.clearSelfItemEnv()
                }
            }
            fi += 1
        }
        // generic-receiver method bodies: walk them under the receiver env so a nested
        // generic call (`key.hash[H]` -> `String.hash[SipHasher]`) registers its instance
        // before the transitive worklist below scans it.
        self.scanGenInstMethodBodies()
        // Transitive instantiation discovers generic layouts before final-callable
        // closure. Its call selection is provisional only; finalization below
        // replaces every callable identity under the concrete body instance.
        mut val si: U64 = 0U64
        while si < self.monoWork.fnInsts.count() {
            val fin: FnInst = self.monoWork.fnInsts[si]
            val gf: Func = self.arena.funcs[fin.fnIdx]
            self.cur.locals = []
            self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: gf))
            // a generic *method* instance carries a receiver: set the self env (and the
            // receiver instantiation for a generic receiver) so `self`/`self.field`
            // resolve while scanning its body — without this, a derived `hash[H]` that
            // calls `self.field.hash(...)` can't type `self.field`, so the field's own
            // (transitive) generic-method instance is never discovered. A free function
            // has hasRecv=false, so this is a no-op for it (env stays cleared).
            self.cur.hasRecv = gf.hasRecv
            self.cur.recvStart = gf.recvStart
            self.cur.recvLen = gf.recvLen
            self.cur.extId = gf.extId
            self.cur.selfInout = gf.selfInout
            self.cur.recvInstRef = fin.recvInstRef
            if gf.hasRecv {
                self.setSelfItemEnv(recvStart: gf.recvStart, recvLen: gf.recvLen, recvInstRef: fin.recvInstRef)
            }
            self.cur.typeParams = gf.typeParams
            self.cur.typeArgs = fin.args
            self.cur.bodyFnIdx = fin.fnIdx
            self.cur.bodyRecvInstRef = fin.recvInstRef
            self.cur.bodyTypeArgs = fin.args
            self.cur.bodyTypeParams = gf.typeParams
            self.cur.bodySelfRef = self.cur.selfRef
            self.cur.bodyItemRef = self.cur.itemRef
            mut val gpi: U64 = 0
            while gpi < gf.params.count() {
                val gp: Param = gf.params[gpi]
                self.addLocal(nameStart: gp.nameStart, nameLen: gp.nameLen, tyStart: gp.tyStart, tyLen: gp.tyLen, isArray: gp.tyIsArray, ty: gp.ty, isInout: gp.isInout, isMut: false, owned: false)
                // register the grounded param type so an `Array[E]` param (-> `Array[I64]`)
                // gets its per-instance `%gs` typedef. The method body's `source.count()`
                // can't register it (registerMethodInst bails on an array receiver), and no
                // field/return scan reaches a param-only instance.
                self.scanType(ref: gp.ty)
                gpi += 1
            }
            if gf.hasRet {
                self.scanType(ref: gf.retTy)
            }
            self.scanBlockInsts(blkId: gf.body)
            if gf.hasRecv {
                self.clearSelfItemEnv()
            }
            si += 1
        }
        val noP: Array[Bind] = []
        val noA: Array[U64] = []
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.typeParams = noP
        self.cur.typeArgs = noA
        self.cur.inClosure = false
        self.cur.closureId = 0
        self.cur.captureMark = 0
        self.cur.bodyFnIdx = 18446744073709551615U64
        self.cur.bodyRecvInstRef = 0U64
        self.cur.bodyTypeArgs = noA
        self.cur.bodyTypeParams = noP
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
    }
}
