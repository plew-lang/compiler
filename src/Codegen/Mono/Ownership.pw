// Close destruction alongside authored calls. LLVM consumes these facts;
// it may memoize semantic aliases, but never selects a destructor or field type.
pub impl Comp {
    // Ownership is a property of the selected nominal declaration. Spelling
    // cannot identify a declaration across modules or generic binders.
    fn typeTermIsUnique(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.typeTerms.count() { return false }
        val term = self.arena.typeTerms[ref]
        if term.paramId != 0U64 || term.assocNameId != 0U64 || term.projectionReceiver != 0U64 || term.isRecord || term.isAny || !term.hasDecl { return false }
        val underlying = self.arena.newtypeUnderlyingByOffset(offset: term.declOffset)
        if underlying != 0U64 { return self.typeTermIsUnique(ref: underlying) }
        val structure = self.arena.structIndexByOffset(offset: term.declOffset)
        if structure < self.arena.structCount() { return self.arena.structAt(index: structure).isUnique }
        val enumeration = self.arena.enumIndexByOffset(offset: term.declOffset)
        if enumeration < self.arena.enumCount() { return self.arena.enumAt(index: enumeration).isUnique }
        return false
    }

    // Synthetic control-flow values need the same finalized ownership facts
    // as authored values, before Mid starts constructing bodies.
    inout fn finalizeDiscriminantType() -> Result[(), CompileDiagnostic] {
        self.arena.loweringDiscriminantType = 0U64
        val name = self.internBytes(s: "I64")
        val term = self.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
        match (try self.arcClassOfRef(ref: term)) {
            ArcClass.Scalar => {
                try self.enqueueFinalDestruction(typeRef: term)
                self.arena.loweringDiscriminantType = term
            }
            _ => { return <Result.Err error=self.diagnosticAt(offset: name.nameStart, msg: "internal error: discriminant requires a primitive scalar type") /> }
        }
        return <Result.Ok value=() />
    }

    inout fn finalDestructorCallIsValid(call: FinalDestructorCall) -> Bool {
        if call.bodyId == 0U64 || call.bodyId > self.arena.bodyInstanceCount() || call.receiverType == 0U64 { return false }
        match call.receiverPassing { CallReceiverPassing.Borrow => {} _ => { return false } }
        val body = self.arena.bodyInstanceAt(index: call.bodyId - 1U64)
        if body.fnIdx >= self.arena.functionCount() || !self.arena.bodyIsCallable(bodyId: call.bodyId) { return false }
        val function = self.arena.functionAt(index: body.fnIdx)
        if !function.hasRecv || function.selfMove || function.selfInout || function.isAsync || function.isExtern || function.body == 0U64 || function.params.count() != 0U64 || function.hasRet { return false }
        val signature = self.arena.bodySignature(bodyId: call.bodyId)
        return signature.ready && signature.parameterTypes.count() == 0U64 && signature.resultType == 0U64 && self.typeRefEq(a: call.receiverType, b: body.environment.receiverRef)
    }

    inout fn finalizeDestructorCalls() -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < self.arena.finalDestructions.count() {
            val contract = self.arena.finalDestructions[index]
            val call = contract.deinitCall
            if call.bodyId != 0U64 {
                if !self.finalDestructorCallIsValid(call: call) {
                    return <Result.Err error=self.diagnosticAt(offset: self.arena.typeAt(index: contract.typeRef).nameStart, msg: "internal error: destructor requires a finalized borrowed receiver and a nullary Unit body") />
                }
                val finalized = <FinalDestructorCall bodyId=call.bodyId receiverType=call.receiverType receiverPassing=call.receiverPassing ready=true />
                self.arena.finalDestructions[index] = <FinalDestruction typeRef=contract.typeRef isUnique=contract.isUnique ownershipClass=contract.ownershipClass ready=contract.ready needsRelease=contract.needsRelease deinitCall=finalized structLayout=contract.structLayout isOpaquePointer=contract.isOpaquePointer underlying=contract.underlying fieldTypes=contract.fieldTypes fieldBoxed=contract.fieldBoxed fieldNeedsRelease=contract.fieldNeedsRelease variantFieldStarts=contract.variantFieldStarts />
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn finalDestructionIndex(typeRef: U64) -> U64 {
        if typeRef == 0U64 || typeRef >= self.arena.typeCount() { return 0U64 }
        if typeRef < self.arena.finalDestructionIds.count() {
            val known = self.arena.finalDestructionIds[typeRef]
            if known != 0U64 { return known }
        }
        val term = self.arena.typeTerms[typeRef]
        if term.hasDecl && !term.isRecord {
            mut val candidate = self.arena.finalDestructionNominalHeads.getOr(key: term.declOffset, fallback: 0U64)
            while candidate != 0U64 {
                if self.typeRefEq(a: self.arena.finalDestructions[candidate - 1U64].typeRef, b: typeRef) {
                    while self.arena.finalDestructionIds.count() <= typeRef { self.arena.finalDestructionIds.append(0U64) }
                    self.arena.finalDestructionIds[typeRef] = candidate
                    return candidate
                }
                candidate = self.arena.finalDestructionNominalNext[candidate - 1U64]
            }
        }
        mut val bucket = term.nameId
        if term.isRecord { bucket = 0U64 }
        mut val candidate = self.arena.finalDestructionHeads.getOr(key: bucket, fallback: 0U64)
        while candidate != 0U64 {
            if self.typeRefEq(a: self.arena.finalDestructions[candidate - 1U64].typeRef, b: typeRef) {
                while self.arena.finalDestructionIds.count() <= typeRef { self.arena.finalDestructionIds.append(0U64) }
                self.arena.finalDestructionIds[typeRef] = candidate
                return candidate
            }
            candidate = self.arena.finalDestructionNext[candidate - 1U64]
        }
        return 0U64
    }

    inout fn finalOwnershipClass(typeRef: U64) -> ArcClass {
        if typeRef == 0U64 { return <ArcClass.Scalar /> }
        return self.arena.finalDestructions[self.requireFinalDestruction(typeRef: typeRef) - 1U64].ownershipClass
    }

    inout fn finalNeedsRelease(typeRef: U64) -> Bool {
        // Zero is the closed Mid Unit term, with no owned payload.
        if typeRef == 0U64 { return false }
        return self.arena.finalDestructions[self.requireFinalDestruction(typeRef: typeRef) - 1U64].needsRelease
    }

    inout fn checkedFinalDestruction(typeRef: U64) -> Result[U64, CompileDiagnostic] {
        val identity = self.finalDestructionIndex(typeRef: typeRef)
        if identity != 0U64 && self.arena.finalDestructions[identity - 1U64].ready { return <Result.Ok value=identity /> }
        mut val offset = 0U64
        if typeRef < self.arena.typeCount() { offset = self.arena.typeAt(index: typeRef).nameStart }
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: ownership action has no finalized classification") />
    }

    // Transitional adapter for LLVM consumers not yet returning diagnostics.
    // Mid analysis uses checkedFinalDestruction and never terminates its host.
    inout fn requireFinalDestruction(typeRef: U64) -> U64 {
        match self.checkedFinalDestruction(typeRef: typeRef) {
            Result.Ok(value: val identity) => { return identity }
            Result.Err(error: _) => {}
        }
        eprint(text: "[ownership-contract] missing typeRef=")
        eprintU64(n: typeRef)
        eprint(text: " type=")
        self.traceMonoTypeHead(ref: typeRef)
        eprint(text: " function=")
        eprintU64(n: self.cur.checkFn)
        eprint(text: "\n")
        mut val offset = 0U64
        if typeRef < self.arena.typeCount() { offset = self.arena.typeAt(index: typeRef).nameStart }
        self.errorAt(offset: offset, msg: "internal error: ownership action has no finalized classification")
        return 0U64
    }

    // Collect shape first; no unfinished recursive node is interpreted as
    // release-free. Propagate positive effects over reverse dependency edges.
    inout fn enqueueFinalDestruction(typeRef: U64) -> Result[(), CompileDiagnostic] {
        if typeRef == 0U64 || typeRef >= self.arena.typeCount() { return <Result.Ok value=() /> }
        if self.finalDestructionIndex(typeRef: typeRef) != 0U64 { return <Result.Ok value=() /> }
        val start = self.arena.finalDestructions.count()
        try self.collectFinalDestruction(typeRef: typeRef)
        val count = self.arena.finalDestructions.count() - start
        mut val needs: Array[Bool] = []
        mut val heads: Array[U64] = []
        // Each edge stores (dependent node, previous edge), using one-based links.
        mut val edges: Array[U64] = []
        mut val pending: Array[U64] = []
        mut val index = 0U64
        while index < count {
            needs.append(false)
            heads.append(0U64)
            index += 1U64
        }
        index = 0U64
        while index < count {
            val contract = self.arena.finalDestructions[start + index]
            if contract.underlying != 0U64 {
                try self.recordFinalReleaseDependency(typeRef: contract.underlying, owner: index, start: start, needs: inout needs, heads: inout heads, edges: inout edges)
            } else {
                mut val aggregate = false
                match contract.ownershipClass {
                    ArcClass.Scalar => {}
                    ArcClass.StructVal(sidx: _) => { aggregate = true }
                    ArcClass.EnumVal(eidx: _) => { aggregate = true }
                    _ => { needs[index] = true }
                }
                if aggregate {
                    if contract.deinitCall.bodyId != 0U64 { needs[index] = true }
                    mut val field = 0U64
                    while field < contract.fieldTypes.count() {
                        if contract.fieldBoxed[field] { needs[index] = true }
                        else {
                            try self.recordFinalReleaseDependency(typeRef: contract.fieldTypes[field], owner: index, start: start, needs: inout needs, heads: inout heads, edges: inout edges)
                        }
                        field += 1U64
                    }
                }
            }
            if needs[index] { pending.append(index) }
            index += 1U64
        }
        index = 0U64
        while index < pending.count() {
            mut val edge = heads[pending[index]]
            while edge != 0U64 {
                val owner = edges[edge - 1U64]
                if !needs[owner] {
                    needs[owner] = true
                    pending.append(owner)
                }
                edge = edges[edge]
            }
            index += 1U64
        }
        index = 0U64
        while index < count {
            val contract = self.arena.finalDestructions[start + index]
            mut val releases: Array[Bool] = []
            mut val field = 0U64
            while field < contract.fieldTypes.count() {
                releases.append(contract.fieldBoxed[field] || (try self.collectedFinalReleaseEffect(typeRef: contract.fieldTypes[field], start: start, needs: needs)))
                field += 1U64
            }
            self.arena.finalDestructions[start + index] = <FinalDestruction typeRef=contract.typeRef isUnique=contract.isUnique ownershipClass=contract.ownershipClass ready=true needsRelease=needs[index] deinitCall=contract.deinitCall structLayout=contract.structLayout isOpaquePointer=contract.isOpaquePointer underlying=contract.underlying fieldTypes=contract.fieldTypes fieldBoxed=contract.fieldBoxed fieldNeedsRelease=releases variantFieldStarts=contract.variantFieldStarts />
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn recordFinalReleaseDependency(typeRef: U64, owner: U64, start: U64, needs: inout Array[Bool], heads: inout Array[U64], edges: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        if typeRef == 0U64 { return <Result.Ok value=() /> }
        val identity = self.finalDestructionIndex(typeRef: typeRef)
        if identity == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: ownership dependency has no collected shape") />
        }
        val child = identity - 1U64
        if child < start {
            val finalized = try self.checkedFinalDestruction(typeRef: typeRef)
            if self.arena.finalDestructions[finalized - 1U64].needsRelease { needs[owner] = true }
            return <Result.Ok value=() />
        }
        val edge = edges.count() + 1U64
        edges.append(owner)
        edges.append(heads[child - start])
        heads[child - start] = edge
        return <Result.Ok value=() />
    }

    inout fn collectedFinalReleaseEffect(typeRef: U64, start: U64, needs: Array[Bool]) -> Result[Bool, CompileDiagnostic] {
        if typeRef == 0U64 { return <Result.Ok value=false />}
        val identity = self.finalDestructionIndex(typeRef: typeRef)
        if identity == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: ownership field has no collected shape") />
        }
        if identity - 1U64 < start {
            val finalized = try self.checkedFinalDestruction(typeRef: typeRef)
            return <Result.Ok value=self.arena.finalDestructions[finalized - 1U64].needsRelease />
        }
        return <Result.Ok value=needs[identity - 1U64 - start] />
    }

    inout fn collectFinalDestruction(typeRef: U64) -> Result[(), CompileDiagnostic] {
        if typeRef == 0U64 || typeRef >= self.arena.typeCount() { return <Result.Ok value=() /> }
        if self.finalDestructionIndex(typeRef: typeRef) != 0U64 { return <Result.Ok value=() /> }
        val type = self.arena.typeAt(index: typeRef)
        val term = self.arena.typeTerms[typeRef]
        mut val bucket = term.nameId
        if term.isRecord { bucket = 0U64 }
        val contract = self.arena.finalDestructions.count() + 1U64
        self.arena.finalDestructions.append(<FinalDestruction typeRef=typeRef />)
        self.arena.finalDestructionNext.append(self.arena.finalDestructionHeads.getOr(key: bucket, fallback: 0U64))
        self.arena.finalDestructionHeads[bucket] = contract
        mut val nominalNext = 0U64
        if term.hasDecl && !term.isRecord {
            nominalNext = self.arena.finalDestructionNominalHeads.getOr(key: term.declOffset, fallback: 0U64)
            self.arena.finalDestructionNominalHeads[term.declOffset] = contract
        }
        self.arena.finalDestructionNominalNext.append(nominalNext)
        while self.arena.finalDestructionIds.count() <= typeRef { self.arena.finalDestructionIds.append(0U64) }
        self.arena.finalDestructionIds[typeRef] = contract
        val ownershipClass = (try self.arcClassOfRef(ref: typeRef))
        mut val fields: Array[U64] = []
        mut val boxed: Array[Bool] = []
        mut val variantStarts: Array[U64] = []
        mut val destructor = 0U64
        mut val underlying = 0U64
        mut val structLayout = 0U64
        // CPtr is a builtin FFI type constructor without a StructDef.
        mut val isOpaquePointer = rangeEquals(bytes: self.arena.bytes, start: type.nameStart, len: type.nameLen, kw: "CPtr")
        if type.isRecord {
            try self.collectRecordLayout(ref: typeRef)
            val layout = self.recordStructIndex(ref: typeRef)
            if layout >= self.arena.structCount() {
                return <Result.Err error=self.diagnosticAt(offset: type.nameStart, msg: "internal error: finalized record has no physical layout") />
            }
            structLayout = layout + 1U64
            fields = type.recordFieldTerms
            mut val field = 0U64
            while field < fields.count() {
                boxed.append(false)
                field += 1U64
            }
        } else {
            underlying = self.newtypeUnderRef(start: type.nameStart, len: type.nameLen)
            if underlying == typeRef { underlying = 0U64 }
            if underlying != 0U64 {
                try self.collectFinalDestruction(typeRef: underlying)
            } else {
                // Structural layout is independent of the specialized ARC
                // action (String/Buffer/Ref/Promise). Freeze declared fields
                // even when that action is not StructVal.
                val structure = self.structIndexForType(ref: typeRef)
                if structure < self.arena.structCount() {
                    val declaration = self.arena.structAt(index: structure)
                    isOpaquePointer = declaration.isCExtern || (declaration.isExtern && type.args.count() > 0U64)
                    if !declaration.isExtern && !declaration.isCExtern { structLayout = structure + 1U64 }
                    if declaration.isUnique {
                        val function = self.structOwnDeinitFi(sidx: structure)
                        if function < self.arena.functionCount() {
                            destructor = (try self.enqueueFinalBody(fnIdx: function, args: type.args, recvInstRef: typeRef))
                        }
                    }
                    mut val field = 0U64
                    while field < declaration.fields.count() {
                        fields.append(self.groundTermInEnvironment(ref: declaration.fields[field].ty, params: declaration.typeParams, values: type.args, selfRef: typeRef))
                        boxed.append(self.fieldIsBoxed(f: declaration.fields[field]))
                        field += 1U64
                    }
                }
                match ownershipClass {
                    ArcClass.StructVal(sidx: _) => {}
                    ArcClass.EnumVal(eidx: val index) => {
                        val declaration = self.arena.enumAt(index: index)
                        variantStarts.append(fields.count())
                        mut val variant = 0U64
                        while variant < declaration.variants.count() {
                            mut val field = 0U64
                            while field < declaration.variants[variant].fields.count() {
                                fields.append(self.groundTermInEnvironment(ref: declaration.variants[variant].fields[field].ty, params: declaration.typeParams, values: type.args, selfRef: typeRef))
                                boxed.append(self.fieldIsBoxed(f: declaration.variants[variant].fields[field]))
                                field += 1U64
                            }
                            variantStarts.append(fields.count())
                            variant += 1U64
                        }
                    }
                    ArcClass.BufferLike(elem: val element) => { try self.collectFinalDestruction(typeRef: element) }
                    ArcClass.RefCell(inst: val instance) => { try self.collectFinalDestruction(typeRef: self.arena.typeAt(index: instance).args[0U64]) }
                    ArcClass.PromiseCell(inst: val instance) => { try self.collectFinalDestruction(typeRef: self.arena.typeAt(index: instance).args[0U64]) }
                    // Weak references do not own their pointee. Erased values
                    // close their concrete owners at construction instead.
                    ArcClass.WeakCell(inst: _) => {}
                    ArcClass.ClosureVal => {}
                    ArcClass.AnyBox => {}
                    ArcClass.StringLike => {}
                    ArcClass.Scalar => {}
                }
            }
        }
        mut val field = 0U64
        while field < fields.count() {
            try self.collectFinalDestruction(typeRef: fields[field])
            field += 1U64
        }
        self.arena.finalDestructions[contract - 1U64] = <FinalDestruction typeRef=typeRef isUnique=self.typeTermIsUnique(ref: typeRef) ownershipClass=ownershipClass deinitCall=<FinalDestructorCall bodyId=destructor receiverType=typeRef receiverPassing=<CallReceiverPassing.Borrow /> /> structLayout=structLayout isOpaquePointer=isOpaquePointer underlying=underlying fieldTypes=fields fieldBoxed=boxed variantFieldStarts=variantStarts />
        return <Result.Ok value=() />
    }
}
