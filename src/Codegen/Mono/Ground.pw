// Part of monomorphization (root: _.pw): type grounding, record structs,
// and generic-instance collection.

// Walk a use-site TypeRef, recording every concrete generic instantiation it
// contains. Post-order (args before self) so a by-value nested instance is
// emitted before the type that contains it; deduped structurally. A type that
// still mentions a type parameter (a template like `Box[T]`) is not collected.
// Register the element type of an Array reached via a type argument into
// c.monoWork.arrayElems (deduped by name span) so its PlewArray runtime is emitted.
// If an array element is itself an `Array[X]`, its C type is `PlewArray_<X>`, so
// the inner element X must be registered (and emitted) before the outer. Register
// the inner first (recursively, for deeper nesting) so it lands earlier in
// c.monoWork.arrayElems and its runtime is defined before the dependent one.

pub impl Comp {
    // Ground a semantic type term through an explicit immutable substitution
    // map. This is intentionally separate from `groundTypeRef`, whose legacy
    // ambient Cursor path still supports old declaration-time callers. A body
    // instance must never infer its field type from that ambient state: its
    // ParamId map is the authority.
    inout fn groundTermInEnvironment(ref: U64, params: Array[Bind], values: Array[U64]) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val t: TypeRef = self.arena.types[ref]
        if t.isRecord {
            if t.recordFieldLabels.count() != t.recordFieldTerms.count() { return ref }
            mut val fields: Array[U64] = []
            mut val changed: Bool = false
            mut val ri: U64 = 0U64
            while ri < t.recordFieldTerms.count() {
                val next: U64 = self.groundTermInEnvironment(ref: t.recordFieldTerms[ri], params: params, values: values)
                if next != t.recordFieldTerms[ri] { changed = true }
                fields.append(next)
                ri += 1U64
            }
            if changed { return self.rebuildRecordTypeTerm(t: t, fieldTerms: fields) }
            return ref
        }
        // A projection's receiver is a child type term, not the projection
        // term itself.  Substitute it before considering the legacy flat
        // ParamId carried on the projection node: grounding
        // `T#Parser.Output` with T=P must produce `P#Parser.Output`, never P.
        // This is also why a closed TypeTerm traversal has to treat the
        // receiver and trait-instance arguments as children together.
        if t.assocNameId != 0U64 {
            val receiver: U64 = self.typeTermProjectionReceiver(t: t)
            val groundedReceiver: U64 = self.groundTermInEnvironment(ref: receiver, params: params, values: values)
            mut val traitArgs: Array[U64] = []
            mut val changed: Bool = groundedReceiver != receiver
            mut val ai: U64 = 0U64
            while ai < t.assocTraitArgs.count() {
                val next: U64 = self.groundTermInEnvironment(ref: t.assocTraitArgs[ai], params: params, values: values)
                if next != t.assocTraitArgs[ai] { changed = true }
                traitArgs.append(next)
                ai += 1U64
            }
            if !changed { return ref }
            return self.rebuildProjectionTerm(t: t, receiver: groundedReceiver, traitArgs: traitArgs)
        }
        if t.paramId != 0U64 {
            mut val pi: U64 = 0U64
            while pi < params.count() && pi < values.count() {
                if params[pi].paramId == t.paramId {
                    val replacement: U64 = values[pi]
                    if replacement != ref { return self.groundTermInEnvironment(ref: replacement, params: params, values: values) }
                    return ref
                }
                pi += 1U64
            }
        }
        // Some checked-in declaration templates predate ParamId stamping.  A
        // bare legacy term is still unambiguous *at this boundary*: `params`
        // are the binders owned by one explicitly selected receiver instance,
        // not the caller's ambient scope.  Resolve it only against that
        // immutable instance map.  This keeps `Optional`'s historical `T`
        // field from being re-read as an unbound nominal type (and recursively
        // registering `Optional[T]`), while preserving the final rule that all
        // newly lowered terms use ParamId.
        if t.paramId == 0U64 && t.args.count() == 0U64 {
            mut val termNameId: U64 = t.nameId
            if termNameId == 0U64 {
                termNameId = intern(c: inout self, start: t.nameStart, len: t.nameLen)
            }
            mut val pi: U64 = 0U64
            while pi < params.count() && pi < values.count() {
                val binder: Bind = params[pi]
                if termNameId == binder.nameId || (binder.nameId == 0U64 && spansEqual(c: inout self, aStart: t.nameStart, aLen: t.nameLen, bStart: binder.nameStart, bLen: binder.nameLen)) {
                    val replacement: U64 = values[pi]
                    if replacement != ref { return self.groundTermInEnvironment(ref: replacement, params: params, values: values) }
                    return ref
                }
                pi += 1U64
            }
        }
        mut val args: Array[U64] = []
        mut val assocArgs: Array[U64] = []
        mut val changed: Bool = false
        mut val i: U64 = 0U64
        while i < t.args.count() {
            val next: U64 = self.groundTermInEnvironment(ref: t.args[i], params: params, values: values)
            if next != t.args[i] { changed = true }
            args.append(next)
            i += 1U64
        }
        i = 0U64
        while i < t.assocTraitArgs.count() {
            val next: U64 = self.groundTermInEnvironment(ref: t.assocTraitArgs[i], params: params, values: values)
            if next != t.assocTraitArgs[i] { changed = true }
            assocArgs.append(next)
            i += 1U64
        }
        if changed { return self.rebuildTypeTerm(t: t, args: args, assocTraitArgs: assocArgs) }
        return ref
    }

    // Ground a body-owned semantic term through the caller-supplied immutable
    // environment. `selfRef`/`itemRef` are derived conveniences rather than
    // key fields, but are explicit here so a semantic read never silently
    // consults whichever callee environment happens to be in Cursor.
    inout fn groundTermForBody(ref: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val t: TypeRef = self.arena.types[ref]
        // Self/Item are derived projections of the selected receiver, not
        // ParamId bindings. Preserve their established semantic meaning before
        // consulting the explicit binder map.
        if t.args.count() == 0U64 {
            if environment.receiverRef != 0U64 && rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
                return environment.receiverRef
            }
            if itemRef != 0U64 && rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Item") {
                return itemRef
            }
        }
        val explicit: U64 = self.groundTermInEnvironment(ref: ref, params: environment.params, values: environment.args)
        if explicit != ref { return explicit }
        // ParamId-stamped terms are fully decided by the immutable map above.
        // Only old zero-ParamId terms retain the temporary compatibility path
        // while lowering is migrated; it is entered under the same body env,
        // never the incidental callee environment.
        if t.paramId != 0U64 { return ref }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        val savedS: U64 = self.cur.selfRef
        val savedI: U64 = self.cur.itemRef
        val savedR: U64 = self.cur.recvInstRef
        self.cur.typeParams = environment.params
        self.cur.typeArgs = environment.args
        self.cur.selfRef = selfRef
        self.cur.itemRef = itemRef
        self.cur.recvInstRef = environment.receiverRef
        val legacy: U64 = self.groundTypeRef(ref: ref)
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        self.cur.selfRef = savedS
        self.cur.itemRef = savedI
        self.cur.recvInstRef = savedR
        return legacy
    }

    // Compatibility wrapper for existing body consumers. New semantic queries
    // take an environment explicitly through groundTermForBody.
    inout fn groundBodyTerm(ref: U64) -> U64 {
        return self.groundTermForBody(ref: ref, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
    }

    // Rebuild one semantic type term while preserving every identity facet.
    // This is the only construction path used by term substitution: projection
    // trait arguments are children just like nominal arguments.
    inout fn rebuildTypeTerm(t: TypeRef, args: Array[U64], assocTraitArgs: Array[U64]) -> U64 {
        return self.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen paramId=t.paramId args=args isRecord=t.isRecord recordFieldLabels=t.recordFieldLabels recordFieldTerms=t.recordFieldTerms viewExtId=t.viewExtId viewIds=t.viewIds viewSources=t.viewSources isAny=t.isAny argLabels=t.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=assocTraitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=t.isSendable hasDecl=t.hasDecl declOffset=t.declOffset hasAssocTraitDecl=t.hasAssocTraitDecl assocTraitDeclOffset=t.assocTraitDeclOffset siteOffset=t.siteOffset />)
    }

    // Rebuild a Record TypeTerm after a closed traversal transformed its field
    // children.  The retained layout name is opaque ABI metadata; labels and
    // fields are the semantic identity and must travel together.
    inout fn rebuildRecordTypeTerm(t: TypeRef, fieldTerms: Array[U64]) -> U64 {
        return self.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen paramId=t.paramId args=t.args isRecord=true recordFieldLabels=t.recordFieldLabels recordFieldTerms=fieldTerms viewExtId=t.viewExtId viewIds=t.viewIds viewSources=t.viewSources isAny=t.isAny argLabels=t.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=t.assocTraitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=t.isSendable hasDecl=t.hasDecl declOffset=t.declOffset hasAssocTraitDecl=t.hasAssocTraitDecl assocTraitDeclOffset=t.assocTraitDeclOffset siteOffset=t.siteOffset />)
    }

    // The legacy arena represents a projection receiver through the same head
    // and arguments as the projection itself. Expose it as an explicit term so
    // all structural operations can recurse into it.
    inout fn typeTermProjectionReceiver(t: TypeRef) -> U64 {
        return self.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen paramId=t.paramId args=t.args isRecord=t.isRecord recordFieldLabels=t.recordFieldLabels recordFieldTerms=t.recordFieldTerms viewExtId=t.viewExtId viewIds=t.viewIds viewSources=t.viewSources isAny=t.isAny argLabels=t.argLabels isSendable=t.isSendable hasDecl=t.hasDecl declOffset=t.declOffset siteOffset=t.siteOffset />)
    }

    // Reassemble a projection after a structural traversal transformed its
    // receiver and/or positional trait arguments.  Keeping the receiver
    // replacement here prevents each substitution path from accidentally
    // treating a projection's flattened legacy head as the whole term.
    inout fn rebuildProjectionTerm(t: TypeRef, receiver: U64, traitArgs: Array[U64]) -> U64 {
        if receiver >= self.arena.types.count() { return 0U64 }
        val base: TypeRef = self.arena.types[receiver]
        return self.pushType(t: <TypeRef nameStart=base.nameStart nameLen=base.nameLen paramId=base.paramId args=base.args isRecord=base.isRecord recordFieldLabels=base.recordFieldLabels recordFieldTerms=base.recordFieldTerms viewExtId=base.viewExtId viewIds=base.viewIds viewSources=base.viewSources isAny=base.isAny argLabels=base.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=traitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=base.isSendable hasDecl=base.hasDecl declOffset=base.declOffset hasAssocTraitDecl=t.hasAssocTraitDecl assocTraitDeclOffset=t.assocTraitDeclOffset siteOffset=t.siteOffset />)
    }

    // Apply exactly one concrete witness's impl-binder substitution. Query
    // terms stay rigid: an unmatched binder remains symbolic.
    inout fn groundWitnessTypeTerm(ref: U64, params: Array[Bind], matchResult: WitnessMatch) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val semantic: TypeRef = self.arena.types[ref]
        if semantic.paramId != 0U64 {
            val byParam: U64 = self.witnessBindParamIndex(binds: matchResult.binds, paramId: semantic.paramId)
            if byParam < matchResult.binds.count() { return matchResult.binds[byParam].term }
        }
        val binder: U64 = self.plainBinder(ref: ref, params: params)
        if binder < params.count() {
            val found: U64 = self.witnessBindIndex(binds: matchResult.binds, binder: binder)
            if found < matchResult.binds.count() { return matchResult.binds[found].term }
            return ref
        }
        val t: TypeRef = semantic
        // Record fields are ordinary semantic children.  Witness grounding
        // must recurse through the same carrier as body grounding rather than
        // reopening the synthetic StructDef layout: the latter is ABI-only
        // and may have been registered under a different lexical binder.
        if t.isRecord {
            if t.recordFieldLabels.count() != t.recordFieldTerms.count() { return ref }
            mut val fields: Array[U64] = []
            mut val recordChanged: Bool = false
            mut val ri: U64 = 0U64
            while ri < t.recordFieldTerms.count() {
                val next: U64 = self.groundWitnessTypeTerm(ref: t.recordFieldTerms[ri], params: params, matchResult: matchResult)
                if next != t.recordFieldTerms[ri] { recordChanged = true }
                fields.append(next)
                ri += 1U64
            }
            if recordChanged { return self.rebuildRecordTypeTerm(t: t, fieldTerms: fields) }
            return ref
        }
        mut val args: Array[U64] = []
        mut val assocArgs: Array[U64] = []
        mut val changed: Bool = false
        mut val i: U64 = 0U64
        while i < t.args.count() {
            val next: U64 = self.groundWitnessTypeTerm(ref: t.args[i], params: params, matchResult: matchResult)
            if next != t.args[i] { changed = true }
            args.append(next)
            i += 1U64
        }
        i = 0U64
        while i < t.assocTraitArgs.count() {
            val next: U64 = self.groundWitnessTypeTerm(ref: t.assocTraitArgs[i], params: params, matchResult: matchResult)
            if next != t.assocTraitArgs[i] { changed = true }
            assocArgs.append(next)
            i += 1U64
        }
        if t.assocNameId != 0U64 {
            val receiver: U64 = self.typeTermProjectionReceiver(t: t)
            val groundedReceiver: U64 = self.groundWitnessTypeTerm(ref: receiver, params: params, matchResult: matchResult)
            if groundedReceiver != receiver {
                val rebuilt: U64 = self.rebuildProjectionTerm(t: t, receiver: groundedReceiver, traitArgs: assocArgs)
                if rebuilt != 0U64 { return rebuilt }
                return ref
            }
        }
        // The legacy arena stores an anonymous record's component terms in its
        // StructDef rather than in TypeRef.args.  A witness substitution must
        // nevertheless recurse into those components: `Item = (value: E)` in
        // `EnumerateIter[I,E]` becomes `(value: I64)` for a selected witness.
        // Keep this compatibility bridge here, at the sole witness-substitution
        // boundary; the semantic TypeTerm record node will make these ordinary
        // children and remove the scoped legacy representation.
        if t.args.count() == 0U64 && t.nameLen > 0U64 && self.arena.bytes[t.nameStart] == 40U8 {
            return self.groundWitnessRecordTerm(ref: ref, params: params, matchResult: matchResult)
        }
        if changed { return self.rebuildTypeTerm(t: t, args: args, assocTraitArgs: assocArgs) }
        return ref
    }

    // Apply a concrete witness map to the field terms carried by one legacy
    // anonymous-record StructDef.  `groundRecordStruct` is the existing,
    // canonical record-instantiation routine; installing this *explicit*
    // witness environment only adapts the old carrier representation, rather
    // than re-selecting a witness or reading a caller's ambient body scope.
    inout fn groundWitnessRecordTerm(ref: U64, params: Array[Bind], matchResult: WitnessMatch) -> U64 {
        mut val values: Array[U64] = []
        mut val i: U64 = 0U64
        while i < params.count() {
            val matchIdx: U64 = self.witnessBindIndex(binds: matchResult.binds, binder: i)
            if matchIdx < matchResult.binds.count() {
                values.append(matchResult.binds[matchIdx].term)
            } else {
                val p: Bind = params[i]
                values.append(self.pushType(t: <TypeRef nameStart=p.nameStart nameLen=p.nameLen paramId=p.paramId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />))
            }
            i += 1U64
        }
        val savedParams: Array[Bind] = self.cur.typeParams
        val savedArgs: Array[U64] = self.cur.typeArgs
        self.cur.typeParams = params
        self.cur.typeArgs = values
        val grounded: U64 = self.groundTypeRef(ref: ref)
        self.cur.typeParams = savedParams
        self.cur.typeArgs = savedArgs
        return grounded
    }

    inout fn ensureArrayElemDeps(elemRef: U64) {
        if elemRef == 0 {
            return
        }
        val r: U64 = self.resolveTy(tyRef: elemRef)
        if r >= self.arena.types.count() {
            return
        }
        val t: TypeRef = self.arena.types[r]
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
            if t.args.count() > 0 {
                self.registerArrayElemRef(elemRef: t.args[0])
            }
        }
    }

    inout fn registerArrayElemRef(elemRef: U64) {
        // resolve a bare type parameter (`Array[T]` inside a generic instance) to its
        // concrete argument under the active env, so the runtime is emitted for the
        // instantiation (`Array[I32]`), not the template (`PlewArray_T`).
        val re: U64 = self.resolveTy(tyRef: elemRef)
        if re >= self.arena.types.count() {
            return
        }
        self.ensureArrayElemDeps(elemRef: re)
        // a compound element (`Ref[I32]`, `Array[I32]`, `Box[I32]`) gets a mangled
        // name span + its ref, matching the parser's recordArrayElem (so the runtime
        // and use sites agree); a simple element uses its head name.
        mut val nStart: U64 = self.arena.types[re].nameStart
        mut val nLen: U64 = self.arena.types[re].nameLen
        mut val fRef: U64 = 0
        if self.isCompoundType(ref: re) {
            val mn: Bind = self.appendMangleSpan(ref: re)
            nStart = mn.nameStart
            nLen = mn.nameLen
            fRef = re
        }
        mut val i: U64 = 0
        while i < self.monoWork.arrayElems.count() {
            val ae: Bind = self.monoWork.arrayElems[i]
            if spansEqual(c: inout self, aStart: ae.nameStart, aLen: ae.nameLen, bStart: nStart, bLen: nLen) {
                return
            }
            i += 1
        }
        self.monoWork.arrayElems.append(<Bind nameStart=nStart nameLen=nLen fieldStart=fRef fieldLen=0 />)
    }

    inout fn recordTypeKeyFromRef(ref: U64) -> Array[U8] {
        mut val out: Array[U8] = []
        if ref >= self.arena.types.count() {
            return out
        }
        val tr: TypeRef = self.arena.types[ref]
        if tr.isSendable {
            appendBytes(into: inout out, from: "sendable ".bytes())
        }
        if tr.isRecord {
            if tr.recordFieldLabels.count() != tr.recordFieldTerms.count() { return out }
            val si: U64 = self.anyStructIndex(nameStart: tr.nameStart, nameLen: tr.nameLen)
            if si >= self.arena.structs.count() { return out }
            val fields: Array[FieldDef] = self.arena.structs[si].fields
            if fields.count() != tr.recordFieldTerms.count() { return out }
            appendBytes(into: inout out, from: "(".bytes())
            mut val ri: U64 = 0U64
            while ri < tr.recordFieldTerms.count() {
                if ri > 0U64 { appendBytes(into: inout out, from: ",".bytes()) }
                val fd: FieldDef = fields[ri]
                if fd.nameId != tr.recordFieldLabels[ri] { return [] }
                mut val bi: U64 = 0U64
                while bi < fd.nameLen {
                    out.append(self.arena.bytes[fd.nameStart + bi])
                    bi += 1U64
                }
                appendBytes(into: inout out, from: ":".bytes())
                appendBytes(into: inout out, from: self.recordTypeKeyFromRef(ref: tr.recordFieldTerms[ri]))
                ri += 1U64
            }
            appendBytes(into: inout out, from: ")".bytes())
            return out
        }
        mut val i: U64 = 0
        while i < tr.nameLen {
            out.append(self.arena.bytes[tr.nameStart + i])
            i += 1
        }
        if tr.args.count() > 0U64 {
            appendBytes(into: inout out, from: "[".bytes())
            mut val a: U64 = 0
            while a < tr.args.count() {
                if a > 0U64 {
                    appendBytes(into: inout out, from: ",".bytes())
                }
                // RECURSE into the arg's own structure — a one-level head-name key is lossy
                // (`Box[Box[I32]]` and `Box[Box[String]]` would both key to `Box[Box]` and
                // collide). The full nesting must be reflected so distinct nested record
                // component types stay distinct.
                appendBytes(into: inout out, from: self.recordTypeKeyFromRef(ref: tr.args[a]))
                a += 1
            }
            appendBytes(into: inout out, from: "]".bytes())
        }
        return out
    }

    inout fn groundRecordStruct(ref: U64) -> U64 {
        val t: TypeRef = self.arena.types[ref]
        if t.nameLen == 0U64 {
            return ref
        }
        if self.arena.bytes[t.nameStart] != 40U8 {
            return ref
        }
        val si: U64 = self.structIndexByName(start: t.nameStart, len: t.nameLen)
        if si >= self.arena.structs.count() {
            return ref
        }
        val sd: StructDef = self.arena.structs[si]
        mut val cn: Array[U8] = []
        appendBytes(into: inout cn, from: "(".bytes())
        mut val changed: Bool = false
        // collect the grounded field defs alongside the canonical name, so a missing
        // grounded instance can be registered (not left as the i64-defaulting template).
        mut val gfields: Array[FieldDef] = []
        mut val j: U64 = 0
        while j < sd.fields.count() {
            if j > 0U64 {
                appendBytes(into: inout cn, from: ",".bytes())
            }
            val fd: FieldDef = sd.fields[j]
            mut val k: U64 = 0
            while k < fd.nameLen {
                cn.append(self.arena.bytes[fd.nameStart + k])
                k += 1
            }
            appendBytes(into: inout cn, from: ":".bytes())
            mut val fieldTerm: U64 = fd.ty
            if t.isRecord && j < t.recordFieldTerms.count() {
                fieldTerm = t.recordFieldTerms[j]
            }
            val g: U64 = self.groundTypeRef(ref: fieldTerm)
            if g != fd.ty {
                changed = true
            }
            appendBytes(into: inout cn, from: self.recordTypeKeyFromRef(ref: g))
            val gt: TypeRef = self.arena.types[g]
            gfields.append(<FieldDef nameStart=fd.nameStart nameLen=fd.nameLen nameId=fd.nameId tyStart=gt.nameStart tyLen=gt.nameLen tyNameId=intern(c: inout self, start: gt.nameStart, len: gt.nameLen) tyIsArray=fd.tyIsArray ty=g isMut=fd.isMut hasDefault=fd.hasDefault defaultVal=fd.defaultVal vis=fd.vis />)
            j += 1
        }
        appendBytes(into: inout cn, from: ")".bytes())
        if !(changed) {
            return ref
        }
        val nm: Bind = self.internBytes(s: stringFromBytesUnchecked(cn))
        val nid: U64 = intern(c: inout self, start: nm.nameStart, len: nm.nameLen)
        mut val gi: U64 = 0
        mut val registered: Bool = false
        while gi < self.arena.structs.count() {
            if self.arena.structs[gi].nameId == nid {
                registered = true
                gi = self.arena.structs.count()
            } else {
                gi += 1
            }
        }
        // the grounded record instance is not yet a real struct: register it (canonical sorted
        // layout inherited from the template) so its fields carry the grounded types
        // (`value: I32`, not the template's `value: E` i64-defaulting), and registerGenStructBodies
        // gives it an LLVM body. Registration is the COLLECTION pass's job (inCollection) — it
        // reaches every record instance via scanType — so grounding stays PURE everywhere else
        // (type checker / backend just name the grounded record; the struct already exists from
        // collection). Mirrors ensureRecordStruct; idempotent via the nid scan above.
        if !(registered) {
            if self.inCollection {
                val noTP: Array[Bind] = []
                self.arena.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=nid typeParams=noTP fields=gfields isUnique=sd.isUnique isNonsendable=sd.isNonsendable isExtern=false defOffset=sd.defOffset />)
            }
        }
        return self.recordTypeTermForLayout(name: nm)
    }

    // Structural nesting depth of a TypeRef (`I64`=1, `Box[I64]`=2, `Box[Box[I64]]`=3).
    // Terminates because a ref's args are always pushed before the ref itself (indices
    // strictly decrease). Used by the instantiation-depth gate below.
    inout fn tyRefDepth(ref: U64) -> U64 {
        if ref >= self.arena.types.count() {
            return 0
        }
        val t: TypeRef = self.arena.types[ref]
        mut val d: U64 = 0
        mut val i: U64 = 0
        while i < t.args.count() {
            val ad: U64 = self.tyRefDepth(ref: t.args[i])
            if ad > d {
                d = ad
            }
            i += 1
        }
        return d + 1U64
    }

    // POLYMORPHIC RECURSION guard (rustc recursion_limit analogue): a generic that
    // recurses with an ever-deepening type argument (`deep(v: <Box[T] v=v />)`) grows a
    // fresh, deeper instance every worklist round — without a ceiling the collection
    // fixpoint never converges and the compiler hangs (audit-5 L5). Any legitimate
    // program's type nesting is far below 64.
    inout fn checkInstDepth(ref: U64) {
        if self.tyRefDepth(ref: ref) > 64U64 {
            self.errorAt(offset: self.arena.types[ref].nameStart, msg: "type recursion limit reached while instantiating a generic type — a generic appears to recurse with an ever-deepening type argument (polymorphic recursion is not supported)")
        }
    }

    inout fn groundTypeRef(ref: U64) -> U64 {
        if ref >= self.arena.types.count() {
            return ref
        }
        val t: TypeRef = self.arena.types[ref]
        if t.isRecord {
            if t.recordFieldLabels.count() != t.recordFieldTerms.count() { return ref }
            mut val fields: Array[U64] = []
            mut val changed: Bool = false
            mut val ri: U64 = 0U64
            while ri < t.recordFieldTerms.count() {
                val next: U64 = self.groundTypeRef(ref: t.recordFieldTerms[ri])
                if next != t.recordFieldTerms[ri] { changed = true }
                fields.append(next)
                ri += 1U64
            }
            if !changed { return ref }
            val rebuilt: U64 = self.rebuildRecordTypeTerm(t: t, fieldTerms: fields)
            // This is the sole semantic→ABI boundary for records: the traversal
            // above consumed only Record children; materialization registers the
            // concrete synthetic layout needed by the current LLVM backend.
            return self.groundRecordStruct(ref: rebuilt)
        }
        if t.assocNameId != 0U64 {
            return self.resolveTy(tyRef: ref)
        }
        if t.args.count() == 0 {
            val rg: U64 = self.groundRecordStruct(ref: ref)
            if rg != ref {
                return rg
            }
            return self.resolveTy(tyRef: ref)
        }
        mut val newArgs: Array[U64] = []
        mut val changed: Bool = false
        mut val i: U64 = 0
        while i < t.args.count() {
            val g: U64 = self.groundTypeRef(ref: t.args[i])
            if g != t.args[i] {
                changed = true
            }
            newArgs.append(g)
            i += 1
        }
        if changed {
            // rebuild with the identity facets preserved: the view (`P#Ext`) and the
            // existential (`any P`) are part of type identity — grounding the args
            // must not strip them.
            return self.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen paramId=t.paramId args=newArgs isRecord=t.isRecord recordFieldLabels=t.recordFieldLabels recordFieldTerms=t.recordFieldTerms viewExtId=t.viewExtId viewIds=t.viewIds viewSources=t.viewSources isAny=t.isAny argLabels=t.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=t.assocTraitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=t.isSendable />)
        }
        return ref
    }

    inout fn groundUnderInst(instRef: U64, tyRef: U64) -> U64 {
        if instRef == 0U64 || instRef >= self.arena.types.count() { return tyRef }
        val inst: TypeRef = self.arena.types[instRef]
        val si: U64 = self.genericStructIndex(nameStart: inst.nameStart, nameLen: inst.nameLen)
        mut val params: Array[Bind] = []
        if si < self.arena.structs.count() {
            params = self.arena.structs[si].typeParams
        } else {
            val ei: U64 = self.genericEnumIndex(nameStart: inst.nameStart, nameLen: inst.nameLen)
            if ei < self.arena.enums.count() {
                params = self.arena.enums[ei].typeParams
            }
        }
        if params.count() == 0U64 || params.count() != inst.args.count() {
            return tyRef
        }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        // `tyRef` belongs to the selected receiver declaration (`struct Box[E]`).
        // Evaluation under that receiver opens a lexical substitution frame: its
        // declaration binders shadow an enclosing body frame with the same
        // ParamId.  For example, in `Dist[Feet].from(d: Dist[Meters])`, grounding
        // `d.v` must read the nested receiver's `Unit -> Meters`, not the body's
        // `Unit -> Feet`.  The latter is not a contradictory binding; it belongs
        // to a different receiver instance.  Keep receiver entries first and add
        // only ambient binders that are not locally rebound.
        mut val composedP: Array[Bind] = []
        mut val composedA: Array[U64] = []
        mut val pi: U64 = 0U64
        while pi < params.count() {
            composedP.append(params[pi])
            if pi < inst.args.count() { composedA.append(inst.args[pi]) }
            pi += 1U64
        }
        pi = 0U64
        while pi < savedP.count() && pi < savedA.count() {
            mut val found: U64 = composedP.count()
            mut val ci: U64 = 0U64
            while ci < composedP.count() {
                if composedP[ci].paramId == savedP[pi].paramId {
                    found = ci
                    break
                }
                ci += 1U64
            }
            if found >= composedP.count() {
                composedP.append(savedP[pi])
                composedA.append(savedA[pi])
            }
            pi += 1U64
        }
        self.cur.typeParams = composedP
        self.cur.typeArgs = composedA
        val g: U64 = self.groundTermInEnvironment(ref: tyRef, params: composedP, values: composedA)
        // A legacy anonymous-record TypeRef has its components in the matching
        // StructDef rather than as TypeRef children. Normalize it while the
        // explicit receiver environment is installed, so `Holder[I32].pair`
        // becomes the concrete `(a:I32,b:I32)` record before a later `.a`
        // selection. This is the one carrier bridge for structural records;
        // the final TypeTerm node will make those fields ordinary children.
        mut val normalized: U64 = g
        if g != 0U64 && g < self.arena.types.count() {
            val gt: TypeRef = self.arena.types[g]
            if gt.nameLen > 0U64 && self.arena.bytes[gt.nameStart] == 40U8 {
                normalized = self.groundTypeRef(ref: g)
            }
        }
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        return normalized
    }

    inout fn simpleTypeRef(nameStart: U64, nameLen: U64) -> U64 {
        val noArgs: Array[U64] = []
        return self.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=noArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    inout fn assocItemRef(recvStart: U64, recvLen: U64, recvInstRef: U64) -> U64 {
        val item: Bind = self.kwSpan(kw: "Item", kwLen: 4U64)
        val itemId: U64 = intern(c: inout self, start: item.nameStart, len: item.nameLen)
        mut val receiver: U64 = recvInstRef
        if receiver == 0U64 {
            receiver = self.simpleTypeRef(nameStart: recvStart, nameLen: recvLen)
        }
        if receiver == 0U64 { return 0U64 }
        // `Item` is a temporary spelling-level bridge for provided Iterator
        // bodies.  The answer itself is selected through the complete concrete
        // conformance witness, so generic impl binders and associated output
        // substitutions cannot be confused with the receiver declaration's
        // generic parameters.  A non-Iterator same-named output is ambiguous
        // here and deliberately yields no Item environment rather than being
        // selected by declaration order.
        val out: U64 = self.assocBindingFor(baseRef: receiver, traitId: 0U64, traitOwner: 0U64, traitArgs: [], assocId: itemId)
        return out
    }

    inout fn setSelfItemEnv(recvStart: U64, recvLen: U64, recvInstRef: U64) {
        if recvInstRef != 0 {
            self.cur.selfRef = recvInstRef
        } else {
            self.cur.selfRef = self.simpleTypeRef(nameStart: recvStart, nameLen: recvLen)
        }
        val itemR0: U64 = self.assocItemRef(recvStart: recvStart, recvLen: recvLen, recvInstRef: recvInstRef)
        if itemR0 == 0 {
            self.cur.itemRef = 0
        } else {
            self.cur.itemRef = itemR0
        }
    }

    // Project an associated output from exactly the witness selected for this
    // body. This is deliberately not a receiver-name lookup: `ConformId` and
    // its one directional substitution are the proof that owns the output.
    inout fn associatedOutputInProof(proof: StaticConformanceProof, traitOwner: U64, assocId: U64) -> U64 {
        match proof {
            StaticConformanceProof.ConcreteWitness(val witness) => {
                if witness.conformIdx == 0U64 { return 0U64 }
                val ci: U64 = witness.conformIdx - 1U64
                if ci >= self.decls.conforms.count() { return 0U64 }
                val cf: Conform = self.decls.conforms[ci]
                if cf.traitStart != traitOwner { return 0U64 }
                mut val found: U64 = 0U64
                mut val count: U64 = 0U64
                mut val ai: U64 = 0U64
                while ai < cf.assocBindingIds.count() {
                    val bindingId: U64 = cf.assocBindingIds[ai]
                    if bindingId < self.decls.assocBindings.count() {
                        val ab: AssocBinding = self.decls.assocBindings[bindingId]
                        if ab.nameId == assocId {
                        found = self.groundWitnessTypeTerm(ref: ab.ty, params: cf.typeParams, matchResult: witness)
                        count += 1U64
                        }
                    }
                    ai += 1U64
                }
                if count == 1U64 { return found }
                return 0U64
            }
            StaticConformanceProof.TraitPath(val edges, val terminalConformIdx) => {
                if terminalConformIdx == 0U64 { return 0U64 }
                val ci: U64 = terminalConformIdx - 1U64
                if ci >= self.decls.conforms.count() { return 0U64 }
                val cf: Conform = self.decls.conforms[ci]
                if cf.traitStart != traitOwner { return 0U64 }
                mut val edgeIdx: U64 = 0U64
                mut val terminal: WitnessMatch = <WitnessMatch />
                while edgeIdx < edges.count() {
                    if edges[edgeIdx].conformIdx == terminalConformIdx {
                        terminal = edges[edgeIdx]
                    }
                    edgeIdx += 1U64
                }
                if terminal.conformIdx == 0U64 { return 0U64 }
                mut val found: U64 = 0U64
                mut val count: U64 = 0U64
                mut val ai: U64 = 0U64
                while ai < cf.assocBindingIds.count() {
                    val bindingId: U64 = cf.assocBindingIds[ai]
                    if bindingId < self.decls.assocBindings.count() {
                        val ab: AssocBinding = self.decls.assocBindings[bindingId]
                        if ab.nameId == assocId {
                            found = self.groundWitnessTypeTerm(ref: ab.ty, params: cf.typeParams, matchResult: terminal)
                            count += 1U64
                        }
                    }
                    ai += 1U64
                }
                if count == 1U64 { return found }
                return 0U64
            }
            _ => { return 0U64 }
        }
    }

    // Enter one concrete provided body from its immutable environment. `Self`
    // is its selected receiver; `Item` is the selected Iterator-style output
    // of that same conformance proof. Other body kinds retain the legacy
    // bridge until all associated-type terms are explicit TypeTerm nodes.
    inout fn setSelfItemEnvForBody(f: Func, environment: InstanceEnvironment) {
        if environment.receiverRef != 0U64 && environment.receiverRef < self.arena.types.count() {
            self.cur.selfRef = environment.receiverRef
        } else {
            self.cur.selfRef = self.simpleTypeRef(nameStart: f.recvStart, nameLen: f.recvLen)
        }
        self.cur.itemRef = 0U64
        if !(f.isProvided) { return }
        val item: Bind = self.kwSpan(kw: "Item", kwLen: 4U64)
        val itemId: U64 = intern(c: inout self, start: item.nameStart, len: item.nameLen)
        self.cur.itemRef = self.associatedOutputInProof(proof: environment.proof, traitOwner: f.originTraitOwner, assocId: itemId)
    }

    inout fn clearSelfItemEnv() {
        self.cur.selfRef = 0
        self.cur.itemRef = 0
    }

    inout fn instArgCollidesParamName(instRef: U64) -> Bool {
        val t: TypeRef = self.arena.types[instRef]
        if t.args.count() == 0U64 {
            return false
        }
        // the generic's own type-parameter names (struct or enum). The collision is
        // pervasive: with a name-based parameter identity, ANY generic — struct or enum —
        // whose type ARGUMENT coincides with one of its parameter names cannot be grounded
        // (the concrete type and the parameter are indistinguishable, so substitution never
        // terminates and the compiler stack-overflows). The lone exception is a generic
        // floored purely on an extern intrinsic (`Array[T]` over `Buffer`), which
        // terminates; rejecting that rare ambiguous case too is the accepted cost of a
        // simple, crash-proof rule (rename the colliding type).
        mut val params: Array[Bind] = []
        val gsi: U64 = self.genericStructIndex(nameStart: t.nameStart, nameLen: t.nameLen)
        if gsi < self.arena.structs.count() {
            params = self.arena.structs[gsi].typeParams
        } else {
            val gei: U64 = self.genericEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen)
            if gei < self.arena.enums.count() {
                params = self.arena.enums[gei].typeParams
            } else {
                return false
            }
        }
        mut val ai: U64 = 0
        while ai < t.args.count() {
            val arg: TypeRef = self.arena.types[t.args[ai]]
            // a bare argument whose head names a declared concrete type AND coincides with
            // one of this generic's parameter names (skip an argument that is itself a
            // parameter — a template position, resolved by the active env, not a collision).
            val argId: U64 = arg.nameId
            if argId != 0U64 {
                if !(self.isTypeParamName(start: arg.nameStart, len: arg.nameLen)) {
                    mut val pi: U64 = 0
                    while pi < params.count() {
                        if params[pi].nameId == argId {
                            return true
                        }
                        pi += 1
                    }
                }
            }
            ai += 1
        }
        return false
    }

    inout fn refArgNamesADeriveTarget(ref: U64) -> Bool {
        if self.decls.derives.count() == 0U64 {
            return false
        }
        val t: TypeRef = self.arena.types[ref]
        mut val i: U64 = 0
        while i < t.args.count() {
            val argT: TypeRef = self.arena.types[t.args[i]]
            mut val di: U64 = 0
            while di < self.decls.derives.count() {
                // Only the ENTRY file's (module 0) derive targets are being generated by
                // this `plew gen <file>` run (synthGenMain applies the same module-0 filter).
                // A derive target in a dependency — e.g. @Std/Core's primitive `@[IntTryFrom]`
                // on `U8` — is NOT generated here, so an `Array[U8]` instance must still be
                // collected (else the harness's own String/byte machinery can't be emitted).
                if self.moduleOf(offset: self.decls.derives[di].declStart) == 0U64 {
                    if spansEqual(c: inout self, aStart: argT.nameStart, aLen: argT.nameLen, bStart: self.decls.derives[di].typeStart, bLen: self.decls.derives[di].typeLen) {
                        return true
                    }
                }
                di += 1
            }
            i += 1
        }
        return false
    }

    inout fn scanType(ref: U64) {
        if ref >= self.arena.types.count() {
            return
        }
        // resolve any active env (a generic struct's field `Array[T]` -> `Array[I64]`)
        // so the grounded instantiation, not the template, is what gets registered.
        // (Shadows the parameter; the public label stays `ref` for all callers.)
        val ref: U64 = self.groundTypeRef(ref: ref)
        if ref >= self.arena.types.count() {
            return
        }
        val t: TypeRef = self.arena.types[ref]
        mut val i: U64 = 0
        while i < t.args.count() {
            self.scanType(ref: t.args[i])
            i += 1
        }
        // an `Array[E]` reached via a type argument (e.g. inside `Box[Array[I32]]`)
        // still needs its `PlewArray_E` runtime emitted — register the element.
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
            if t.args.count() == 1 {
                self.registerArrayElemRef(elemRef: t.args[0])
            }
        }
        // register a function type for its C typedef (deduped structurally).
        if self.isFnType(ref: ref) {
            mut val fj: U64 = 0
            mut val seen: Bool = false
            while fj < self.monoWork.fnTypes.count() {
                if self.typeRefEq(a: self.monoWork.fnTypes[fj], b: ref) {
                    seen = true
                }
                fj += 1
            }
            if !(seen) {
                self.monoWork.fnTypes.append(ref)
            }
        }
        // an anonymous record `(index:U64, value:I32)` (grounded + registered above by
        // groundTypeRef -> groundRecordStruct): scan its field types so a nested generic /
        // array / Ref element registers too. Records carry no type args, so the args loop
        // above misses their components. Detect by the leading `(`.
        if t.nameLen > 0U64 {
            if self.arena.bytes[t.nameStart] == 40U8 {
                val rsi: U64 = self.structIndexByName(start: t.nameStart, len: t.nameLen)
                if rsi < self.arena.structs.count() {
                    val rfs: Array[FieldDef] = self.arena.structs[rsi].fields
                    mut val rk: U64 = 0
                    while rk < rfs.count() {
                        self.scanType(ref: rfs[rk].ty)
                        rk += 1
                    }
                }
            }
        }
        if self.isGenericInst(ref: ref) {
            if self.tyRefIsGround(ref: ref) {
                mut val j: U64 = 0
                while j < self.monoWork.genInsts.count() {
                    if self.typeRefEq(a: self.monoWork.genInsts[j], b: ref) {
                        return
                    }
                    j += 1
                }
                if self.instArgCollidesParamName(instRef: ref) {
                    self.errorAt(offset: self.arena.types[ref].nameStart, msg: "a type argument's name collides with this generic's type-parameter name (e.g. `struct V` used as the value of `Dictionary[K, V]`); rename the type")
                }
                // gen mode: don't instantiate a generic over a to-be-derived type (spec/16).
                if self.genMode {
                    if self.refArgNamesADeriveTarget(ref: ref) {
                        return
                    }
                }
                self.checkInstDepth(ref: ref)
                self.monoWork.genInsts.append(ref)
                // scan the generic struct's fields under this instantiation's env so an
                // `Array[T]` field registers its concrete element (`Array[I32]`) — the
                // runtime is keyed off the instantiation, not the `PlewArray_T` template.
                self.scanGenInstFields(instRef: ref)
            }
        }
    }

    inout fn scanGenInstFields(instRef: U64) {
        val inst: TypeRef = self.arena.types[instRef]
        val qInst: U64 = intern(c: inout self, start: inst.nameStart, len: inst.nameLen)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[si]
            if sd.nameId == qInst {
                if sd.typeParams.count() == inst.args.count() {
                    if sd.typeParams.count() > 0 {
                        val savedP: Array[Bind] = self.cur.typeParams
                        val savedA: Array[U64] = self.cur.typeArgs
                        self.cur.typeParams = sd.typeParams
                        self.cur.typeArgs = inst.args
                        val fs: Array[FieldDef] = sd.fields
                        mut val k: U64 = 0
                        while k < fs.count() {
                            self.scanType(ref: fs[k].ty)
                            k += 1
                        }
                        // also scan this struct's methods' return/param types under the
                        // env, so a method returning another generic type (an iterable's
                        // `iterator() -> BoxIter[T]`) registers its grounded instantiation
                        // (`BoxIter[I64]`), whose typedef/methods would else be missing. A
                        // leftover (generic-method) param stays non-ground and is skipped.
                        mut val mfi: U64 = 0
                        while mfi < self.arena.funcs.count() {
                            val mf: Func = self.arena.funcs[mfi]
                            if mf.hasRecv {
                                // skip copied provided methods (`map[B] -> MapIter[Self,…]`):
                                // their instances come from call sites, and expanding one here
                                // under Self=this inst would recurse forever (MapIter[MapIter[…]]).
                                if !(mf.isProvided) {
                                if mf.recvId == qInst {
                                    // a non-generic method may still mention `Self`/`Item`
                                    // (`fn iterator() -> Self`); resolve them to this inst.
                                    self.setSelfItemEnv(recvStart: inst.nameStart, recvLen: inst.nameLen, recvInstRef: instRef)
                                    if mf.hasRet {
                                        self.scanType(ref: mf.retTy)
                                    }
                                    val mps: Array[Param] = mf.params
                                    mut val mpi: U64 = 0
                                    while mpi < mps.count() {
                                        self.scanType(ref: mps[mpi].ty)
                                        mpi += 1
                                    }
                                    self.clearSelfItemEnv()
                                }
                                }
                            }
                            mfi += 1
                        }
                        self.cur.typeParams = savedP
                        self.cur.typeArgs = savedA
                    }
                }
            }
            si += 1
        }
    }

    inout fn collectGenInsts() {
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            // skip generic templates: their param/return types contain type
            // parameters (not concrete), resolved per instantiation instead.
            if f.typeParams.count() <= 0 {
            // skip a provided-method template (receiver = a trait): it is not a real
            // method (it is copied onto each conformer), and scanning its signature
            // would resolve `Self` to the trait name and register a bogus instantiation
            // (`FilterIter[Iterator,…]`). The per-conformer copies are scanned instead.
            // Likewise skip a provided method copied onto a *generic* conformer (`filter`
            // on `MapIter`): it is still a template (Self/Item are the conformer's type
            // params, not concrete), emitted per receiver instantiation — scanning it as
            // concrete would register garbage like `FilterIter[MapIter, fn, B]`.
            mut val skipProvidedTemplate: Bool = false
            if self.methodRecvIsTrait(f: f) {
                skipProvidedTemplate = true
            }
            if f.isProvided {
                if self.genericStructIndex(nameStart: f.recvStart, nameLen: f.recvLen) < self.arena.structs.count() {
                    skipProvidedTemplate = true
                }
            }
            if !(skipProvidedTemplate) {
                // a provided method copied onto a concrete conformer (`filter` on
                // Counter) may mention `Self`/`Item` in its signature; resolve them to
                // the receiver so its adapter instantiation (`FilterIter[Counter,…,I64]`)
                // grounds instead of leaking literal `Self`.
                if f.hasRecv {
                    self.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0)
                } else {
                    self.clearSelfItemEnv()
                }
                if f.hasRet {
                    self.scanType(ref: f.retTy)
                }
                val ps: Array[Param] = f.params
                mut val pi: U64 = 0
                while pi < ps.count() {
                    self.scanType(ref: ps[pi].ty)
                    pi += 1
                }
                self.clearSelfItemEnv()
            }
            }
            fi += 1
        }
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val s: StructDef = self.arena.structs[si]
            if s.typeParams.count() == 0 {
                val fs: Array[FieldDef] = s.fields
                mut val k: U64 = 0
                while k < fs.count() {
                    self.scanType(ref: fs[k].ty)
                    k += 1
                }
            }
            si += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val e: EnumDef = self.arena.enums[ei]
            if e.typeParams.count() == 0 {
                val vs: Array[Variant] = e.variants
                mut val vi: U64 = 0
                while vi < vs.count() {
                    val vfs: Array[FieldDef] = vs[vi].fields
                    mut val k: U64 = 0
                    while k < vfs.count() {
                        self.scanType(ref: vfs[k].ty)
                        k += 1
                    }
                    vi += 1
                }
            }
            ei += 1
        }
        mut val sti: U64 = 0
        while sti < self.arena.stmts.count() {
            match self.arena.stmts[sti] {
                Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, val ty, init: _) => {
                    // annotations only: un-annotated lets register their INFERRED types
                    // via inferLetType's collection-time side effects inside the proper
                    // walks (scanStmtInsts — fn bodies, worklist template bodies, and the
                    // globals walk in collectFnInsts), which carry the right locals env.
                    // An env-less flat inference here typed body-locals under an empty
                    // scope, making the registered instance set walk-order dependent.
                    self.scanType(ref: ty)
                }
                _ => {}
            }
            sti += 1
        }
        mut val xi: U64 = 0
        while xi < self.arena.exprs.count() {
            match self.arena.exprs[xi] {
                Expr.Cast(val operand, val tyStart, val tyLen, val ty) => {
                    self.scanType(ref: ty)
                }
                Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                    self.scanType(ref: ty)
                }
                _ => {}
            }
            xi += 1
        }
    }
}
