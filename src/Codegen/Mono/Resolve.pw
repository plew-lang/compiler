// Part of monomorphization (root: _.pw): type-ref equality, name mangling,
// and ground-type resolution.

// Is `ref` a concrete generic *enum* instantiation specifically?

pub impl Comp {
    // A `#` view selects a callable source but never changes a value's runtime
    // representation. Every layout / receiver-instance consumer canonicalizes
    // through this one boundary; nested argument views remain type identity.
    inout fn runtimeTypeRef(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.types.count() { return ref }
        val t: TypeRef = self.arena.types[ref]
        if t.viewExtId == 0U64 && t.viewIds.count() == 0U64 { return ref }
        return self.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen paramId=t.paramId args=t.args isAny=t.isAny argLabels=t.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=t.assocTraitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=t.isSendable />)
    }

    inout fn plainRefOfProjection(t: TypeRef) -> U64 {
        return self.typeTermProjectionReceiver(t: t)
    }

    inout fn assocBindingFor(baseRef: U64, traitId: U64, traitOwner: U64, traitArgs: Array[U64], assocId: U64) -> U64 {
        if baseRef >= self.arena.types.count() {
            return 0
        }
        val base: TypeRef = self.arena.types[baseRef]
        mut val found: U64 = 0
        mut val count: U64 = 0
        mut val i: U64 = 0
        while i < self.decls.assocBindings.count() {
            val ab: AssocBinding = self.decls.assocBindings[i]
            if ab.recvId == base.nameId && ab.nameId == assocId {
                if (traitId == 0U64 || ab.traitId == traitId) && (traitOwner == 0U64 || ab.traitOwner == traitOwner) {
                    if !(self.conformancePatternMatchesTraitInstance(subjectId: ab.recvId, subjectTy: ab.subjectTy, subjectArgs: ab.subjectArgs, typeParams: ab.typeParams, declaredTraitArgs: ab.traitArgs, typeRef: baseRef, traitArgs: traitArgs)) {
                        i += 1U64
                        continue
                    }
                    found = i + 1U64
                    count += 1U64
                }
            }
            i += 1
        }
        if count == 1U64 {
            val ab: AssocBinding = self.decls.assocBindings[found - 1U64]
            mut val params: Array[Bind] = []
            val si: U64 = self.genericStructIndex(nameStart: base.nameStart, nameLen: base.nameLen)
            if si < self.arena.structs.count() {
                params = self.arena.structs[si].typeParams
            } else {
                val ei: U64 = self.genericEnumIndex(nameStart: base.nameStart, nameLen: base.nameLen)
                if ei < self.arena.enums.count() {
                    params = self.arena.enums[ei].typeParams
                }
            }
            if params.count() > 0U64 && params.count() == base.args.count() {
                val savedP: Array[Bind] = self.cur.typeParams
                val savedA: Array[U64] = self.cur.typeArgs
                self.cur.typeParams = params
                self.cur.typeArgs = base.args
                val g: U64 = self.groundTypeRef(ref: ab.ty)
                self.cur.typeParams = savedP
                self.cur.typeArgs = savedA
                return g
            }
            return ab.ty
        }
        return 0
    }

    inout fn resolveAssocProjection(tyRef: U64) -> U64 {
        val t: TypeRef = self.arena.types[tyRef]
        if t.assocNameId == 0U64 {
            return tyRef
        }
        val baseRef: U64 = self.groundTypeRef(ref: self.plainRefOfProjection(t: t))
        if baseRef >= self.arena.types.count() {
            return tyRef
        }
        // A projection is a semantic term during declaration checking.  Its
        // receiver may be an impl binder (`T#P.Item`) with no concrete
        // nominal declaration yet; resolving it here would turn structural
        // cycle validation into a failed witness lookup.  Concrete receivers
        // are annotated by the visibility pass before projection resolution.
        val base: TypeRef = self.arena.types[baseRef]
        // A lexical Param is a symbolic term even if an unrelated ambient
        // Mono context happens to bind the same spelling.  Projection
        // resolution is deferred until THIS ParamId is substituted.
        if base.paramId != 0U64 { return tyRef }
        if !base.hasDecl && !(base.isAny) && !(self.isPrimType(start: base.nameStart, len: base.nameLen)) {
            return tyRef
        }
        // Projection trait arguments are ordinary children of the type term.
        // Ground them under the active generic environment before selecting a
        // witness: `Parser#Convert[T].Output` in a `T = String` instance must
        // query Convert[String], never the template spelling `T`.
        mut val traitArgs: Array[U64] = []
        mut val ai: U64 = 0U64
        while ai < t.assocTraitArgs.count() {
            val arg: U64 = self.groundTypeRef(ref: t.assocTraitArgs[ai])
            if !(self.tyRefIsGround(ref: arg)) {
                return tyRef
            }
            traitArgs.append(arg)
            ai += 1U64
        }
        if t.assocTraitId == 0U64 {
            self.errorAt(offset: t.siteOffset, msg: "associated-type short projection was not resolved from a unique `where` source — write `T#Trait.Item` (spec/08)")
            return tyRef
        }
        // Lowering already records the canonical source owner; the later
        // visibility pass refines the same fact.  Synthetic/legacy terms may
        // not have passed that refinement, so keep the resolved lowering
        // owner rather than dropping identity back to text.
        mut val traitOwner: U64 = t.assocTraitDeclOffset
        if traitOwner == 0U64 { traitOwner = t.assocTraitStart }
        val bound: U64 = self.assocBindingFor(baseRef: baseRef, traitId: t.assocTraitId, traitOwner: traitOwner, traitArgs: traitArgs, assocId: t.assocNameId)
        if bound != 0U64 {
            return self.groundTypeRef(ref: bound)
        }
        self.errorAt(offset: t.siteOffset, msg: "associated-type projection names an associated type that is not bound by the selected conformance (spec/08)")
        return tyRef
    }

    inout fn isGenericEnumInst(ref: U64) -> Bool {
        if ref >= self.arena.types.count() {
            return false
        }
        val t: TypeRef = self.arena.types[ref]
        if t.args.count() == 0 {
            return false
        }
        return self.genericEnumIndex(nameStart: t.nameStart, nameLen: t.nameLen) < self.arena.enums.count()
    }

    inout fn typeRefEq(a: U64, b: U64) -> Bool {
        if a == b {
            return true
        }
        val ta: TypeRef = self.arena.types[a]
        val tb: TypeRef = self.arena.types[b]
        // `nameId == 0` is an unfilled interning cache, not a real type name.
        // Reconstructed scalar refs commonly carry it, so comparing two zero
        // ids as equal merged unrelated concrete instances (I64 and String)
        // in final-callable/body keys. Use ids only when both exist; spelling
        // is the canonical fallback used by runtime receiver identity too.
        if ta.nameId != 0U64 && tb.nameId != 0U64 {
            if ta.nameId != tb.nameId { return false }
        } else {
            if !(spansEqual(c: inout self, aStart: ta.nameStart, aLen: ta.nameLen, bStart: tb.nameStart, bLen: tb.nameLen)) { return false }
        }
        if ta.isAny != tb.isAny || ta.isSendable != tb.isSendable {
            return false
        }
        // a `#`-view is part of type identity (spec/09): `S`, `S#P`, `S#Q` are distinct
        // types, so two generic instantiations differing only by the view argument are
        // distinct instances (`useR[S#P]` vs `useR[S#Q]` get separate bodies/dispatch).
        if ta.viewExtId != tb.viewExtId || !(self.sameViewIdSet(a: ta.viewIds, b: tb.viewIds)) {
            return false
        }
        if (ta.hasDecl && tb.hasDecl && ta.declOffset != tb.declOffset) || ta.assocTraitId != tb.assocTraitId || (ta.hasAssocTraitDecl && tb.hasAssocTraitDecl && ta.assocTraitDeclOffset != tb.assocTraitDeclOffset) || ta.assocNameId != tb.assocNameId {
            return false
        }
        if ta.args.count() != tb.args.count() {
            return false
        }
        mut val i: U64 = 0
        while i < ta.args.count() {
            if !(self.typeRefEq(a: ta.args[i], b: tb.args[i])) {
                return false
            }
            i += 1
        }
        if ta.assocTraitArgs.count() != tb.assocTraitArgs.count() {
            return false
        }
        i = 0U64
        while i < ta.assocTraitArgs.count() {
            mut val al: U64 = 0U64
            mut val bl: U64 = 0U64
            if i < ta.assocTraitArgLabels.count() { al = ta.assocTraitArgLabels[i] }
            if i < tb.assocTraitArgLabels.count() { bl = tb.assocTraitArgLabels[i] }
            if al != bl || !(self.typeRefEq(a: ta.assocTraitArgs[i], b: tb.assocTraitArgs[i])) {
                return false
            }
            i += 1U64
        }
        return true
    }

    inout fn appendMangle(ref: U64) {
        val t: TypeRef = self.arena.types[self.resolveTy(tyRef: ref)]
        mut val j: U64 = 0
        while j < t.nameLen {
            self.arena.bytes.append(self.arena.bytes[t.nameStart + j])
            j += 1
        }
        mut val i: U64 = 0
        while i < t.args.count() {
            self.arena.bytes.append(95)
            self.appendMangle(ref: t.args[i])
            i += 1
        }
    }

    inout fn appendMangleSpan(ref: U64) -> Bind {
        val start: U64 = self.arena.bytes.count()
        self.appendMangle(ref: ref)
        val n: U64 = self.arena.bytes.count()
        return <Bind nameStart=start nameLen=(n - start) fieldStart=ref fieldLen=0 />
    }

    inout fn sameMangle(refA: U64, refB: U64) -> Bool {
        val ra: U64 = self.resolveTy(tyRef: refA)
        val rb: U64 = self.resolveTy(tyRef: refB)
        if ra >= self.arena.types.count() {
            return false
        }
        if rb >= self.arena.types.count() {
            return false
        }
        val a: TypeRef = self.arena.types[ra]
        val b: TypeRef = self.arena.types[rb]
        if a.nameId != b.nameId {
            return false
        }
        if a.args.count() != b.args.count() {
            return false
        }
        mut val i: U64 = 0
        while i < a.args.count() {
            if !(self.sameMangle(refA: a.args[i], refB: b.args[i])) {
                return false
            }
            i += 1
        }
        return true
    }

    inout fn isCompoundType(ref: U64) -> Bool {
        val r: U64 = self.resolveTy(tyRef: ref)
        if r >= self.arena.types.count() {
            return false
        }
        return self.arena.types[r].args.count() > 0
    }

    // Resolve a term that is a binder in the current method's receiver pattern
    // against the selected receiver instance.  This deliberately uses the
    // receiver pattern's lexical scope — not the ambient generic scope and not
    // a global name lookup — so it also forms the safe bridge for legacy terms
    // that have not yet been stamped with a ParamId.
    inout fn receiverPatternArgument(termRef: U64) -> U64 {
        mut val ref: U64 = self.cur.recvInstRef
        if ref == 0U64 { ref = self.cur.bodyRecvInstRef }
        if ref == 0U64 { ref = self.cur.selfRef }
        if ref == 0U64 || ref >= self.arena.types.count() { return 0U64 }
        if self.cur.bodyFnIdx >= self.arena.funcs.count() { return 0U64 }
        val bodyFn: Func = self.arena.funcs[self.cur.bodyFnIdx]
        if bodyFn.recvTy == 0U64 { return 0U64 }
        val binder: U64 = self.plainBinder(ref: termRef, params: bodyFn.typeParams)
        if binder >= bodyFn.typeParams.count() { return 0U64 }
        mut val binds: Array[UnifyBind] = []
        val matches: Bool = self.unifyPatterns(a: bodyFn.recvTy, aSide: 0U64, b: ref, bSide: 1U64, aParams: bodyFn.typeParams, bParams: [], binds: inout binds, ignoreTopView: true)
        if !(matches) { return 0U64 }
        val binderId: U64 = self.binderIdentity(b: bodyFn.typeParams[binder])
        val found: U64 = self.unificationBindingIndex(binds: binds, side: 0U64, binderId: binderId)
        if found < binds.count() { return binds[found].ref }
        return 0U64
    }

    // A method on `Set[I64]` may refer to the `E` bound by the *struct*
    // declaration, while its own impl/method binder is a distinct ParamId.
    // Recover that declaration-binder substitution from the selected receiver
    // instance. This is an explicit instance edge, never a spelling fallback.
    inout fn receiverParamArgument(paramId: U64) -> U64 {
        mut val ref: U64 = self.cur.recvInstRef
        if ref == 0U64 { ref = self.cur.bodyRecvInstRef }
        if ref == 0U64 { ref = self.cur.selfRef }
        if ref == 0U64 || ref >= self.arena.types.count() { return 0U64 }
        val recv: TypeRef = self.arena.types[ref]
        // A method's `impl[E] Set[E]` binder is distinct from the declaration
        // binder on `struct Set[E]`.  Its lexical ParamId therefore cannot be
        // recovered by merely pairing the nominal declaration's parameters with
        // the selected `Set[I64]`.  Match the method's full receiver pattern
        // against that selected instance through the shared structural unifier;
        // this is the same semantic instance relation used by conformance and
        // callable selection, and handles nested receiver patterns as well.
        if self.cur.bodyFnIdx < self.arena.funcs.count() {
            val bodyFn: Func = self.arena.funcs[self.cur.bodyFnIdx]
            mut val pi: U64 = 0U64
            while pi < bodyFn.typeParams.count() {
                if bodyFn.typeParams[pi].paramId == paramId {
                    val term: U64 = self.pushType(t: <TypeRef nameStart=bodyFn.typeParams[pi].nameStart nameLen=bodyFn.typeParams[pi].nameLen paramId=paramId args=[] />)
                    val matched: U64 = self.receiverPatternArgument(termRef: term)
                    if matched != 0U64 { return matched }
                }
                pi += 1U64
            }
        }
        mut val params: Array[Bind] = []
        val si: U64 = self.genericStructIndex(nameStart: recv.nameStart, nameLen: recv.nameLen)
        if si < self.arena.structs.count() {
            params = self.arena.structs[si].typeParams
        } else {
            val ei: U64 = self.genericEnumIndex(nameStart: recv.nameStart, nameLen: recv.nameLen)
            if ei < self.arena.enums.count() { params = self.arena.enums[ei].typeParams }
        }
        if params.count() != recv.args.count() { return 0U64 }
        mut val i: U64 = 0U64
        while i < params.count() {
            if params[i].paramId == paramId { return recv.args[i] }
            i += 1U64
        }
        return 0U64
    }

    inout fn resolveTy(tyRef: U64) -> U64 {
        if tyRef >= self.arena.types.count() {
            return tyRef
        }
        val t: TypeRef = self.arena.types[tyRef]
        if t.assocNameId != 0U64 {
            return self.resolveAssocProjection(tyRef: tyRef)
        }
        if t.paramId != 0U64 {
            mut val pi: U64 = 0U64
            while pi < self.cur.typeParams.count() {
                if self.cur.typeParams[pi].paramId == t.paramId {
                    if pi < self.cur.typeArgs.count() {
                        val arg: U64 = self.cur.typeArgs[pi]
                        // An instance may be symbolic relative to an enclosing
                        // instance: the receiver declaration's `E_struct` maps
                        // to the impl binder `E_impl`, which then maps to I64.
                        // Normalize the substitution value through the same
                        // ParamId lookup instead of treating one ambient pair as
                        // the whole environment.
                        if arg != tyRef { return self.resolveTy(tyRef: arg) }
                    }
                    return tyRef
                }
                pi += 1U64
            }
            val receiverArg: U64 = self.receiverParamArgument(paramId: t.paramId)
            if receiverArg != 0U64 && receiverArg != tyRef {
                return self.resolveTy(tyRef: receiverArg)
            }
            return tyRef
        }
        // The ParamId migration is intentionally incremental.  A legacy bare
        // term may still have paramId=0, but if it is a binder in this method's
        // receiver pattern its meaning is fully determined by that pattern and
        // the already-selected receiver instance.  Resolve only through that
        // structural relation; the textual fallback below remains for unrelated
        // old terms until TypeTerm construction is wholly unified.
        val receiverPatternArg: U64 = self.receiverPatternArgument(termRef: tyRef)
        if receiverPatternArg != 0U64 && receiverPatternArg != tyRef {
            return self.resolveTy(tyRef: receiverPatternArg)
        }
        if t.args.count() == 0 {
            // `Self`/`Item` as types (provided methods on a trait): resolve to the
            // receiver type and its associated `Item` binding (set per method).
            if self.cur.selfRef != 0 {
                if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
                    return self.cur.selfRef
                }
            }
            if self.cur.itemRef != 0 {
                if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Item") {
                    return self.cur.itemRef
                }
            }
            // last-match (iterate high → low): a method-own type param is appended to the
            // env AFTER the receiver's own params (providedCopyTypeParams), so when names
            // collide (`fold[B]` copied onto `MapIter[I, F, B]` — both named `B`) the inner
            // method-own `B` (the accumulator) must shadow the conformer's `B` (the item).
            // With all-distinct names first-match and last-match agree, so this only changes
            // the collision case, resolving it the way lexical shadowing requires.
            // TypeRef's nameId is an interning cache, not semantic state.  A
            // TypeRef reconstructed by a later frontend phase may legitimately
            // retain 0, while the active generic binder always has its interned
            // id.  Compare the canonical spelling in that case, just as the
            // final-callable/body keys do; otherwise a concrete print[I64]
            // instance can leave a nested receiver as literal `T`.
            mut val typeNameId: U64 = t.nameId
            if typeNameId == 0U64 {
                typeNameId = intern(c: inout self, start: t.nameStart, len: t.nameLen)
            }
            mut val i: U64 = self.cur.typeParams.count()
            while i > 0U64 {
                i -= 1
                val p: Bind = self.cur.typeParams[i]
                if typeNameId == p.nameId {
                    if i < self.cur.typeArgs.count() {
                        return self.cur.typeArgs[i]
                    }
                }
            }
        }
        return tyRef
    }

    inout fn isTypeParamName(start: U64, len: U64) -> Bool {
        // a name that names a declared struct/enum is a concrete type, never a type
        // parameter — even if some *other* generic's parameter shares the name (a user
        // struct `B` vs `MapIter[I, F, B]`'s `B`). Concrete types win the global check;
        // a template's own parameter is resolved by the active env before this matters.
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val ni: U64 = 0
        while ni < self.arena.structs.count() {
            if self.arena.structs[ni].typeParams.count() == 0 {
                if self.arena.structs[ni].nameId == qId {
                    return false
                }
            }
            ni += 1
        }
        mut val nj: U64 = 0
        while nj < self.arena.enums.count() {
            if self.arena.enums[nj].typeParams.count() == 0 {
                if self.arena.enums[nj].nameId == qId {
                    return false
                }
            }
            nj += 1
        }
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val tp: Array[Bind] = self.arena.structs[si].typeParams
            mut val k: U64 = 0
            while k < tp.count() {
                if tp[k].nameId == qId {
                    return true
                }
                k += 1
            }
            si += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val tp2: Array[Bind] = self.arena.enums[ei].typeParams
            mut val k2: U64 = 0
            while k2 < tp2.count() {
                if tp2[k2].nameId == qId {
                    return true
                }
                k2 += 1
            }
            ei += 1
        }
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val tp3: Array[Bind] = self.arena.funcs[fi].typeParams
            mut val k3: U64 = 0
            while k3 < tp3.count() {
                if tp3[k3].nameId == qId {
                    return true
                }
                k3 += 1
            }
            fi += 1
        }
        return false
    }

    inout fn tyRefIsGround(ref: U64) -> Bool {
        if ref >= self.arena.types.count() {
            return true
        }
        val t: TypeRef = self.arena.types[ref]
        if t.paramId != 0U64 { return false }
        // an existential `any P` is a concrete ground type — its `P` names a TRAIT, never a
        // type parameter (a single-letter trait name like `P` would otherwise be misread as a
        // type-param name by the check below, poisoning `Array[any P]` registration).
        if t.isAny {
            return true
        }
        if t.assocNameId != 0U64 {
            val r: U64 = self.resolveTy(tyRef: ref)
            if r == ref {
                return false
            }
            return self.tyRefIsGround(ref: r)
        }
        if self.isTypeParamName(start: t.nameStart, len: t.nameLen) {
            return false
        }
        // `Self` is a contextual keyword, not concrete without a method env; a flat
        // scan (Make/Cast) reaching a provided body's `<FilterIter[Self,…]>` must not
        // register it (the method-aware scan grounds the real instance). `Item` is NOT
        // treated this way — it is a legal user type name; resolveTy only rewrites it
        // when an Iterator method env is active (curItemRef set).
        if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
            return false
        }
        mut val i: U64 = 0
        while i < t.args.count() {
            if !(self.tyRefIsGround(ref: t.args[i])) {
                return false
            }
            i += 1
        }
        return true
    }
}
