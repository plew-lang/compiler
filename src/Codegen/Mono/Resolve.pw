// Part of monomorphization (root: _.pw): type-ref equality, name mangling,
// and ground-type resolution.

// Is `ref` a concrete generic *enum* instantiation specifically?

pub impl Comp {
    // A `#` view selects a callable source but never changes a value's runtime
    // representation. Every layout / receiver-instance consumer canonicalizes
    // through this one boundary; nested argument views remain type identity.
    inout fn runtimeTypeRef(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeCount() { return ref }
        val t: TypeRef = self.arena.typeAt(index: ref)
        if t.viewExtId == 0U64 && t.viewIds.count() == 0U64 { return ref }
        // Removing a value-view changes only the callable surface. It must
        // retain the nominal and projection declaration identities: later
        // proof/grounding and Mid storage consumers are not allowed to
        // reconstruct either identity from the spelling.
        return self.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen paramId=t.paramId args=t.args isRecord=t.isRecord recordFieldLabels=t.recordFieldLabels recordFieldTerms=t.recordFieldTerms isAny=t.isAny argLabels=t.argLabels assocTraitStart=t.assocTraitStart assocTraitLen=t.assocTraitLen assocTraitId=t.assocTraitId assocTraitArgs=t.assocTraitArgs assocTraitArgLabels=t.assocTraitArgLabels assocNameStart=t.assocNameStart assocNameLen=t.assocNameLen assocNameId=t.assocNameId isSendable=t.isSendable isDiverging=t.isDiverging hasDecl=t.hasDecl declOffset=t.declOffset hasAssocTraitDecl=t.hasAssocTraitDecl assocTraitDeclOffset=t.assocTraitDeclOffset siteOffset=t.siteOffset />)
    }

    inout fn plainRefOfProjection(t: TypeRef) -> U64 {
        return self.typeTermProjectionReceiver(t: t)
    }

    // Is one conformance source visible on this concrete type term?  A bare
    // conformance is always present; an extension conformance participates
    // only when the same extension occurs in the normalized view source set.
    inout fn proofSourceIsActive(baseRef: U64, extId: U64) -> Bool {
        if extId == 0U64 { return true }
        if baseRef >= self.arena.typeCount() { return false }
        val base: TypeRef = self.arena.typeAt(index: baseRef)
        mut val i: U64 = 0U64
        while i < base.viewIds.count() {
            if base.viewIds[i] == extId { return true }
            i += 1U64
        }
        return base.viewIds.count() == 0U64 && base.viewExtId == extId
    }

    inout fn sameProofTraitArgs(a: Array[U64], b: Array[U64]) -> Bool {
        if a.count() != b.count() { return false }
        mut val i: U64 = 0U64
        while i < a.count() {
            if !(self.typeRefEq(a: a[i], b: b[i])) { return false }
            i += 1U64
        }
        return true
    }

    // Ground the target trait arguments of a witness using that witness's
    // declaration-local impl binders.  This is deliberately the same binder
    // map later used for its associated output.
    inout fn groundedWitnessTraitArgs(cf: Conform, witness: WitnessMatch) -> Result[Array[U64], CompileDiagnostic] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < cf.traitArgs.count() {
            out.append((try self.groundWitnessTypeTerm(ref: self.conformTypeAt(types: cf.traitArgs, index: i), params: <PatternBindInput.Conformance range=cf.typeParams />, matchResult: witness)))
            i += 1U64
        }
        return <Result.Ok value=out />
    }

    // Match one `impl B[U] as A[...]` edge against the already-ground B
    // instance in a proof path.  The edge's own impl binders are the only
    // variables that can bind; the incoming path arguments are rigid.
    inout fn traitSubjectWitnessMatch(conformIdx: U64, subjectArgs: Array[U64], selfRef: U64) -> WitnessMatch {
        if conformIdx >= self.decls.conformCount() { return <WitnessMatch /> }
        val cf: Conform = self.decls.conformAt(index: conformIdx)
        if cf.subjectArgs.count() != subjectArgs.count() { return <WitnessMatch /> }
        mut val binds: Array[UnifyBind] = []
        mut val i: U64 = 0U64
        while i < cf.subjectArgs.count() {
            if !(self.unifyPatterns(a: self.conformTypeAt(types: cf.subjectArgs, index: i), aSide: 0U64, b: subjectArgs[i], bSide: 1U64, aParams: <PatternBindInput.Conformance range=cf.typeParams />, bParams: <PatternBindInput.Values values=[] />, binds: inout binds)) { return <WitnessMatch /> }
            i += 1U64
        }
        val selected: WitnessMatch = self.witnessMatchFromUnify(conformIdx: conformIdx, typeParams: <PatternBindInput.Conformance range=cf.typeParams />, binds: binds)
        return <WitnessMatch conformIdx=selected.conformIdx binds=selected.binds selfRef=selfRef />
    }

    fn sameTraitProofOrigin(a: TraitProofOrigin, b: TraitProofOrigin) -> Bool {
        match a {
            TraitProofOrigin.Witness => { match b { TraitProofOrigin.Witness => { return true } _ => { return false } } }
            TraitProofOrigin.Assumption(source: val source, steps: val steps) => { match b { TraitProofOrigin.Assumption(source: val other, steps: val otherSteps) => { return self.sameDeclarationBound(a: source, b: other) && self.sameSupertraitSteps(a: steps, b: otherSteps) } _ => { return false } } }
        }
    }

    // For inherited assumptions, derivation paths with the same complete
    // constraint carry equivalent facts. Keep one path without conflating
    // distinct associated equalities or roots.
    inout fn assumedTraitInstanceSeen(states: Array[TraitProofState], candidate: TraitProofState, bound: TraitBound) -> Bool {
        for val state in states {
            if state.edges.count() == 0U64 && state.traitOwner == candidate.traitOwner && self.sameProofTraitArgs(a: state.traitArgs, b: candidate.traitArgs) {
                match state.origin {
                    TraitProofOrigin.Assumption(source: val source, steps: val steps) => {
                        val existing = self.assumedSupertraitBound(source: source, steps: steps)
                        if self.typeRefEq(a: existing.subject, b: bound.subject) && existing.constraint.assocPredicates.count() == bound.constraint.assocPredicates.count() {
                            mut val equal = true
                            for val predicate in bound.constraint.assocPredicates {
                                mut val found = false
                                for val other in existing.constraint.assocPredicates { if predicate.member == other.member && self.typeRefEq(a: predicate.value, b: other.value) { found = true } }
                                if !found { equal = false }
                            }
                            if equal { return true }
                        }
                    }
                    TraitProofOrigin.Witness => {}
                }
            }
        }
        return false
    }

    // A member source selector constrains the proof path, not whether the
    // underlying type conforms. Keep declaration identity through every edge.
    fn traitProofStateMatchesSources(state: TraitProofState, sourceOwners: Array[U64]) -> Bool {
        if sourceOwners.count() == 0U64 { return true }
        for val owner in sourceOwners {
            if state.traitOwner == owner { return true }
            for val witness in state.edges {
                if witness.conformIdx != 0U64 && witness.conformIdx <= self.decls.conformCount() {
                    val edge = self.decls.conformAt(index: witness.conformIdx - 1U64)
                    if edge.traitStart == owner || edge.subjectTraitOwner == owner { return true }
                }
            }
        }
        return false
    }

    inout fn traitProofStateSeen(states: Array[TraitProofState], candidate: TraitProofState) -> Bool {
        for val state in states {
            if state.traitOwner == candidate.traitOwner && state.traitId == candidate.traitId && self.sameProofTraitArgs(a: state.traitArgs, b: candidate.traitArgs) && self.sameTraitProofOrigin(a: state.origin, b: candidate.origin) && state.edges.count() == candidate.edges.count() {
                mut val same = true
                mut val index = 0U64
                while index < state.edges.count() {
                    if !self.sameWitnessMatch(a: state.edges[index], b: candidate.edges[index]) { same = false }
                    index += 1U64
                }
                if same { return true }
            }
        }
        return false
    }

    // An edge may recur while its instance arguments shrink. Reject only a
    // repeated instantiated witness, preserving structurally terminating paths.
    inout fn traitProofPathContains(edges: Array[WitnessMatch], witness: WitnessMatch) -> Bool {
        for val edge in edges { if self.sameWitnessMatch(a: edge, b: witness) { return true } }
        return false
    }

    // Reify a worklist state as its retained static evidence.  A direct
    // conformance is a one-edge path; a trait-subject path keeps the direct
    // root and every bridge witness so the terminal associated output is
    // grounded by exactly the witness that owns it.
    inout fn traitProofStateEvidence(state: TraitProofState) -> StaticConformanceProof {
        match state.origin {
            TraitProofOrigin.Assumption(source: val source, steps: val steps) => {
                if state.edges.count() == 0U64 {
                    if steps.count() == 0U64 { return <StaticConformanceProof.AssumedBound source=source /> }
                    return <StaticConformanceProof.AssumedSupertraitPath source=source steps=steps />
                }
                return <StaticConformanceProof.AssumedTraitPath source=source steps=steps edges=state.edges />
            }
            TraitProofOrigin.Witness => {}
        }
        if state.edges.count() == 0U64 { return <StaticConformanceProof.Missing /> }
        if state.edges.count() == 1U64 {
            return <StaticConformanceProof.ConcreteWitness witness=state.edges[0] />
        }
        val terminal: WitnessMatch = state.edges[state.edges.count() - 1U64]
        return <StaticConformanceProof.TraitPath edges=state.edges terminalConformIdx=terminal.conformIdx />
    }

    // Interpret the selected declaration under its recorded substitution.
    // No matching candidate or new binder assignment repairs a stored proof.
    inout fn selectedNominalWitnessSubjectMatches(witness: WitnessMatch) -> Result[Bool, CompileDiagnostic] {
        if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() || witness.selfRef == 0U64 || witness.selfRef >= self.arena.typeCount() { return <Result.Ok value=false /> }
        val declaration = self.decls.conformAt(index: witness.conformIdx - 1U64)
        if declaration.subjectTraitOwner != 0U64 || declaration.subjectTy == 0U64 { return <Result.Ok value=false /> }
        val declared = try self.groundWitnessTypeTerm(ref: declaration.subjectTy, params: <PatternBindInput.Conformance range=declaration.typeParams />, matchResult: witness)
        val actual = self.conformancePhysicalSubject(typeRef: witness.selfRef)
        return <Result.Ok value=self.typeRefEq(a: self.typeRefWithoutOuterViews(ref: declared), b: self.typeRefWithoutOuterViews(ref: actual)) />
    }

    // Conditions belong to the source impl and are substituted by its selected
    // witness. An active obligation is not evidence for itself. Preserve stack
    // cleanup on diagnostics as well as success/failure.
    inout fn witnessConditionsSatisfied(witness: WitnessMatch, assumptions: Array[DeclarationBoundRef] = []) -> Result[Bool, CompileDiagnostic] {
        match (try self.witnessWithConditions(witness: witness, assumptions: assumptions)) {
            Optional.Some(v: _) => { return <Result.Ok value=true /> }
            Optional.None => { return <Result.Ok value=false /> }
        }
    }

    inout fn witnessWithConditions(witness: WitnessMatch, assumptions: Array[DeclarationBoundRef]) -> Result[Optional[WitnessMatch], CompileDiagnostic] {
        if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Ok value=<Optional.None /> /> }
        val source = self.decls.conformAt(index: witness.conformIdx - 1U64)
        if source.derived { return <Result.Ok value=<Optional.None /> /> }
        if source.bounds.len == 0U64 { return <Result.Ok value=<Optional.Some v=witness /> /> }
        for active in self.activeConformanceConditions {
            if self.sameWitnessSubstitution(a: active, b: witness) { return <Result.Ok value=<Optional.None /> /> }
        }
        self.activeConformanceConditions.append(witness)
        val result = self.selectWitnessConditionEvidence(source: source, witness: witness, assumptions: assumptions)
        self.activeConformanceConditions.removeLast()
        return result
    }

    inout fn selectWitnessConditionEvidence(source: Conform, witness: WitnessMatch, assumptions: Array[DeclarationBoundRef]) -> Result[Optional[WitnessMatch], CompileDiagnostic] {
        val parameters = self.copyConformBinds(binds: source.typeParams)
        mut val proofs: Array[U64] = []
        mut val normalizations: Array[ProjectionNormalizationStep] = []
        mut val index = 0U64
        while index < source.bounds.len {
            val bound = self.conformBoundAt(bounds: source.bounds, index: index)
            val rawSubject = try self.groundWitnessTypeTerm(ref: bound.subject, params: <PatternBindInput.Conformance range=source.typeParams />, matchResult: witness)
            val subject = try self.recordConditionTypeNormalization(ref: rawSubject, assumptions: assumptions, normalizations: inout normalizations)
            val rawConstraint = try self.groundTraitConstraintThroughWitness(constraint: bound.constraint, params: parameters, matchResult: witness)
            mut val arguments: Array[U64] = []
            for argument in rawConstraint.key.positionalArgs { arguments.append(try self.recordConditionTypeNormalization(ref: argument, assumptions: assumptions, normalizations: inout normalizations)) }
            mut val predicates: Array[TraitAssocPredicate] = []
            for predicate in rawConstraint.assocPredicates { predicates.append(<TraitAssocPredicate member=predicate.member value=(try self.recordConditionTypeNormalization(ref: predicate.value, assumptions: assumptions, normalizations: inout normalizations)) span=predicate.span />) }
            val constraint = <TraitConstraint key=<TraitInstanceKey owner=rawConstraint.key.owner positionalArgs=arguments /> positionalArgsOpen=rawConstraint.positionalArgsOpen assocPredicates=predicates />
            mut val names: Array[U64] = []
            mut val values: Array[U64] = []
            for predicate in constraint.assocPredicates { names.append(predicate.member) values.append(predicate.value) }
            val proof = try self.traitPatternProof(baseRef: subject, traitId: 0U64, traitOwner: constraint.key.owner, traitArgs: <PatternTypeInput.Values values=constraint.key.positionalArgs />, patternParams: <PatternBindInput.Values values=[] />, traitArgsOpen: constraint.positionalArgsOpen, assocNames: names, assocValues: values, assumptions: assumptions)
            if self.proofIsMissing(proof: proof) { return <Result.Ok value=<Optional.None /> /> }
            proofs.append(self.freezeStaticConformanceProof(proof: proof))
            index += 1U64
        }
        val substitution = <WitnessMatch selfRef=witness.selfRef conformIdx=witness.conformIdx binds=witness.binds />
        val conditionId = self.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=substitution proofs=proofs normalizations=normalizations />)
        return <Result.Ok value=<Optional.Some v=<WitnessMatch selfRef=witness.selfRef conformIdx=witness.conformIdx binds=witness.binds conditions=conditionId /> /> />
    }

    // Source precedence belongs to each conformance edge, not to the
    // traversal order or to the requested associated output. An active
    // extension replaces the bare source for the same instantiated subject
    // and trait arguments. Independent trait paths are not ranked against
    // each other merely because one path happens to contain an extension.
    inout fn witnessSourceSelected(witness: WitnessMatch, assumptions: Array[DeclarationBoundRef]) -> Result[Bool, CompileDiagnostic] {
        if witness.conformIdx == 0U64 || witness.conformIdx > self.decls.conformCount() { return <Result.Ok value=false /> }
        if witness.selfRef == 0U64 || witness.selfRef >= self.arena.typeCount() { return <Result.Ok value=true /> }
        val receiver = self.arena.typeTerms[witness.selfRef]
        if receiver.viewSources.len == 0U64 && receiver.viewIds.len == 0U64 && receiver.viewExtId == 0U64 { return <Result.Ok value=true /> }
        val source = self.decls.conformAt(index: witness.conformIdx - 1U64)
        val arguments = try self.groundedWitnessTraitArgs(cf: source, witness: witness)
        mut val subjectArguments: Array[U64] = []
        if source.subjectTraitOwner != 0U64 {
            mut val index = 0U64
            while index < source.subjectArgs.count() {
                subjectArguments.append((try self.groundWitnessTypeTerm(ref: self.conformTypeAt(types: source.subjectArgs, index: index), params: <PatternBindInput.Conformance range=source.typeParams />, matchResult: witness)))
                index += 1U64
            }
        }
        mut val index = 0U64
        while index < self.decls.conformCount() {
            val candidate = self.decls.conformAt(index: index)
            if index + 1U64 != witness.conformIdx && !candidate.derived && candidate.extId != 0U64 && candidate.traitStart == source.traitStart && candidate.subjectTraitOwner == source.subjectTraitOwner && self.proofSourceIsActive(baseRef: witness.selfRef, extId: candidate.extId) {
                mut val replacement = <WitnessMatch />
                if source.subjectTraitOwner == 0U64 {
                    replacement = try self.conformanceWitnessMatch(conformIdx: index, typeRef: witness.selfRef, traitArgs: arguments)
                } else {
                    replacement = self.traitSubjectWitnessMatch(conformIdx: index, subjectArgs: subjectArguments, selfRef: witness.selfRef)
                    if replacement.conformIdx != 0U64 && !self.sameProofTraitArgs(a: (try self.groundedWitnessTraitArgs(cf: candidate, witness: replacement)), b: arguments) { replacement = <WitnessMatch /> }
                }
                if replacement.conformIdx != 0U64 && (try self.witnessConditionsSatisfied(witness: replacement, assumptions: assumptions)) {
                    if source.extId == 0U64 { return <Result.Ok value=false /> }
                    return <Result.Err error=self.diagnosticAt(offset: source.defOffset, msg: "ambiguous conformance: active extensions provide the same trait instance") />
                }
            }
            index += 1U64
        }
        return <Result.Ok value=true />
    }

    // Only a complete candidate path is checked. Checking every unrelated root
    // eagerly would recursively solve conditions unrelated to the requested trait.
    inout fn completeTraitProofState(state: TraitProofState, assocNames: Array[U64], assocValues: Array[U64], assumptions: Array[DeclarationBoundRef]) -> Result[StaticConformanceProof, CompileDiagnostic] {
        if assocNames.count() != assocValues.count() { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        mut val edges: Array[WitnessMatch] = []
        for edge in state.edges {
            match (try self.witnessWithConditions(witness: edge, assumptions: assumptions)) {
                Optional.Some(v: val witness) => { edges.append(witness) }
                Optional.None => { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
            }
        }
        for edge in edges {
            if !(try self.witnessSourceSelected(witness: edge, assumptions: assumptions)) { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        }
        val completed = <TraitProofState origin=state.origin traitOwner=state.traitOwner traitId=state.traitId traitArgs=state.traitArgs edges=edges />
        val proof = self.traitProofStateEvidence(state: completed)
        if !(try self.selectedProofAssociatedTypesMatch(proof: proof, traitOwner: state.traitOwner, names: assocNames, values: assocValues)) { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        return <Result.Ok value=proof />
    }

    // Associated bindings constrain the selected proof's outputs, not which
    // conformance is selected. Selection and frozen evidence admission share
    // this reader so they cannot silently enforce different constraints.
    inout fn selectedProofAssociatedTypesMatch(proof: StaticConformanceProof, traitOwner: U64, names: Array[U64], values: Array[U64]) -> Result[Bool, CompileDiagnostic] {
        if names.count() != values.count() { return <Result.Ok value=false /> }
        mut val index = 0U64
        while index < names.count() {
            val output = try self.associatedOutputInProof(proof: proof, traitOwner: traitOwner, assocId: names[index])
            if output == 0U64 || !(try self.typesCompatible(expected: values[index], inferred: output)) { return <Result.Ok value=false /> }
            index += 1U64
        }
        return <Result.Ok value=true />
    }

    // Resolve a receiver under explicit declaration assumptions and its view set to a
    // trait *pattern*.  The target pattern's declaration binders may bind;
    // the proof state's positional arguments stay rigid. Exact trait
    // instance lookup is the `patternParams=[]` specialization below.
    inout fn traitPatternProof(baseRef: U64, traitId: U64, traitOwner: U64, traitArgs: PatternTypeInput, patternParams: PatternBindInput, traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = [], assumptions: Array[DeclarationBoundRef] = [], sourceOwners: Array[U64] = [], requireUniqueWitness: Bool = false) -> Result[StaticConformanceProof, CompileDiagnostic] {
        if baseRef == 0U64 || baseRef >= self.arena.typeCount() { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        if self.arena.typeAt(index: baseRef).assocNameId == 0U64 { return self.traitPatternProofFromFacts(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions, sourceOwners: sourceOwners, requireUniqueWitness: requireUniqueWitness) }
        for val active in self.activeProjectionProofs { if self.typeRefEq(a: active, b: baseRef) { return self.traitPatternProofFromFacts(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions, sourceOwners: sourceOwners, requireUniqueWitness: requireUniqueWitness) } }
        self.activeProjectionProofs.append(baseRef)
        val result = self.projectedTraitPatternProof(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions, sourceOwners: sourceOwners, requireUniqueWitness: requireUniqueWitness)
        self.activeProjectionProofs.removeLast()
        return result
    }

    inout fn projectedTraitPatternProof(baseRef: U64, traitId: U64, traitOwner: U64, traitArgs: PatternTypeInput, patternParams: PatternBindInput, traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = [], assumptions: Array[DeclarationBoundRef] = [], sourceOwners: Array[U64] = [], requireUniqueWitness: Bool = false) -> Result[StaticConformanceProof, CompileDiagnostic] {
        // An explicitly assumed projected constraint is already evidence for
        // that subject. Requiring the projection's parent conformance first
        // would lose a valid `where T#Parser.Output: Mark` premise. Schema-
        // derived constraints still require their parent proof below.
        if assumptions.count() != 0U64 {
            val assumed = try self.traitPatternProofFromFacts(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions, sourceOwners: sourceOwners, requireUniqueWitness: requireUniqueWitness, includeConcrete: false)
            match assumed { StaticConformanceProof.Missing => {} _ => { return <Result.Ok value=assumed /> } }
        }
        val projection = self.arena.typeAt(index: baseRef)
        val receiver = self.typeTermProjectionReceiver(t: projection)
        // The lowerer already canonicalizes the trait span. Declaration
        // identity mirrors may not yet be published during declaration checks.
        mut val owner = projection.assocTraitDeclOffset
        if !projection.hasAssocTraitDecl { owner = self.canonicalTraitOwner(start: projection.assocTraitStart, len: projection.assocTraitLen) }
        val declarationIndex = self.decls.traitIndexByOffset(offset: owner)
        if declarationIndex >= self.decls.traitCount() { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        val declaration = self.decls.traitAt(index: declarationIndex)
        val prerequisite = (try self.traitPatternProof(baseRef: receiver, traitId: declaration.nameId, traitOwner: owner, traitArgs: <PatternTypeInput.Values values=projection.assocTraitArgs />, patternParams: <PatternBindInput.Values values=[] />, assumptions: assumptions))
        match prerequisite { StaticConformanceProof.Missing => { return <Result.Ok value=<StaticConformanceProof.Missing /> /> } _ => {} }
        val output = (try self.associatedOutputInProof(proof: prerequisite, traitOwner: owner, assocId: projection.assocNameId))
        if output != 0U64 && !self.typeRefEq(a: output, b: baseRef) {
            return self.traitPatternProof(baseRef: output, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions, sourceOwners: sourceOwners, requireUniqueWitness: requireUniqueWitness)
        }
        // Only an abstract declaration assumption authorizes its schema's
        // associated constraints. Concrete witnesses must validate the actual
        // output above, never justify their own output from that schema.
        match prerequisite {
            StaticConformanceProof.AssumedBound(source: _) => {}
            StaticConformanceProof.AssumedSupertraitPath(source: _, steps: _) => {}
            _ => { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        }
        mut val facts = assumptions
        mut val index = 0U64
        while index < declaration.assocBounds.len {
            val clause = self.traitAssociatedBoundAt(bounds: declaration.assocBounds, index: index)
            if clause.member == projection.assocNameId {
                val clauseIndex = declaration.assocBounds.start + index
                val bound = try self.associatedClauseBound(projectionRef: baseRef, clauseIndex: clauseIndex, prerequisite: prerequisite, offset: clause.offset)
                val evidence = <AssociatedBoundEvidence projection=baseRef clause=clauseIndex prerequisite=prerequisite bound=bound />
                facts.append(self.registerAssociatedBoundEvidence(evidence: evidence))
            }
            index += 1U64
        }
        return self.traitPatternProofFromFacts(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: patternParams, traitArgsOpen: traitArgsOpen, assocNames: assocNames, assocValues: assocValues, assumptions: facts, sourceOwners: sourceOwners, requireUniqueWitness: requireUniqueWitness)
    }

    // Derive the clause from its retained receiver proof. Selection and later
    // admission share this interpretation; neither trusts a fabricated bound
    // or performs another conformance search to repair the evidence.
    inout fn associatedClauseBound(projectionRef: U64, clauseIndex: U64, prerequisite: StaticConformanceProof, offset: U64) -> Result[TraitBound, CompileDiagnostic] {
        if projectionRef == 0U64 || projectionRef >= self.arena.typeCount() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption has an invalid declaration projection") />
        }
        val projection = self.arena.typeAt(index: projectionRef)
        if projection.assocNameId == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption has an invalid declaration projection") />
        }
        mut val owner = projection.assocTraitDeclOffset
        if !projection.hasAssocTraitDecl { owner = self.canonicalTraitOwner(start: projection.assocTraitStart, len: projection.assocTraitLen) }
        val traitIndex = self.decls.traitIndexByOffset(offset: owner)
        if traitIndex >= self.decls.traitCount() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption has an invalid declaration clause") />
        }
        val declaration = self.decls.traitAt(index: traitIndex)
        if clauseIndex < declaration.assocBounds.start || clauseIndex - declaration.assocBounds.start >= declaration.assocBounds.len || clauseIndex >= self.decls.traitAssociatedBoundPool.count() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption has an invalid declaration clause") />
        }
        val clause = self.decls.traitAssociatedBoundPool[clauseIndex]
        if clause.member != projection.assocNameId {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption has an invalid declaration clause") />
        }
        match prerequisite {
            StaticConformanceProof.AssumedBound(source: _) => {}
            StaticConformanceProof.AssumedSupertraitPath(source: _, steps: _) => {}
            _ => { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption requires a declaration prerequisite") /> }
        }
        val receiver = self.typeTermProjectionReceiver(t: projection)
        val parent = try self.staticProofBound(proof: prerequisite, traitIdx: traitIndex)
        if parent.subject == 0U64 || !self.typeRefEq(a: parent.subject, b: receiver) || parent.constraint.key.owner != owner || !self.sameResolvedTypeRefs(a: parent.constraint.key.positionalArgs, b: projection.assocTraitArgs) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption does not match its receiver prerequisite") />
        }
        val output = try self.associatedOutputInProof(proof: prerequisite, traitOwner: owner, assocId: projection.assocNameId)
        if output != 0U64 && !self.typeRefEq(a: output, b: projectionRef) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "associated assumption does not match its selected output") />
        }
        mut val predicates: Array[TraitAssocPredicate] = []
        mut val index = 0U64
        while index < declaration.assocTypes.count() {
            val member = self.traitBindAt(binds: declaration.assocTypes, index: index)
            val value = try self.associatedOutputInProof(proof: prerequisite, traitOwner: owner, assocId: member.nameId)
            if value != 0U64 { predicates.append(<TraitAssocPredicate member=member.nameId value=value span=member.nameStart />) }
            index += 1U64
        }
        val context = <TraitBound subject=receiver constraint=<TraitConstraint key=<TraitInstanceKey owner=owner positionalArgs=projection.assocTraitArgs /> positionalArgsOpen=false assocPredicates=predicates /> offset=projection.siteOffset />
        return <Result.Ok value=<TraitBound subject=projectionRef constraint=self.traitConstraintInBound(constraint: clause.constraint, bound: context, traitIndex: traitIndex) offset=clause.offset /> />
    }

    inout fn registerAssociatedBoundEvidence(evidence: AssociatedBoundEvidence) -> DeclarationBoundRef {
        mut val index = 0U64
        while index < self.arena.associatedBoundEvidenceCount() {
            val existing = self.arena.associatedBoundEvidenceAt(index: index)
            if existing.clause == evidence.clause && self.typeRefEq(a: existing.projection, b: evidence.projection) && self.sameStaticConformanceProof(a: existing.prerequisite, b: evidence.prerequisite) { return <DeclarationBoundRef.AssociatedType index=index /> }
            index += 1U64
        }
        return <DeclarationBoundRef.AssociatedType index=self.arena.publishAssociatedBoundEvidence(evidence: evidence) />
    }

    inout fn traitPatternProofFromFacts(baseRef: U64, traitId: U64, traitOwner: U64, traitArgs: PatternTypeInput, patternParams: PatternBindInput, traitArgsOpen: Bool = false, assocNames: Array[U64] = [], assocValues: Array[U64] = [], assumptions: Array[DeclarationBoundRef] = [], sourceOwners: Array[U64] = [], requireUniqueWitness: Bool = false, includeConcrete: Bool = true) -> Result[StaticConformanceProof, CompileDiagnostic] {
        if baseRef >= self.arena.typeCount() { return <Result.Ok value=<StaticConformanceProof.Missing /> />}
        mut val selected: StaticConformanceProof = <StaticConformanceProof.Missing />
        mut val pending: Array[TraitProofState] = []
        mut val seen: Array[TraitProofState] = []
        for val source in assumptions {
            if self.declarationBoundIsValid(source: source) {
                val bound = self.declarationBound(source: source)
                if bound.subject != 0U64 && self.typeRefEq(a: bound.subject, b: self.typeRefWithoutOuterViews(ref: baseRef)) {
                    val traitIndex = self.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
                    if traitIndex < self.decls.traitCount() {
                        val start = <TraitProofState origin=<TraitProofOrigin.Assumption source=source steps=[] /> traitOwner=bound.constraint.key.owner traitId=self.decls.traitAt(index: traitIndex).nameId traitArgs=bound.constraint.key.positionalArgs edges=[] />
                        if self.traitProofStateMatchesSources(state: start, sourceOwners: sourceOwners) && start.traitOwner == traitOwner && (traitId == 0U64 || start.traitId == traitId) && (traitArgsOpen || self.typeRefListPatternMatches(pattern: traitArgs, patternParams: patternParams, actual: <PatternTypeInput.Values values=start.traitArgs />)) {
                            val completed = try self.completeTraitProofState(state: start, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions)
                            if !self.proofIsMissing(proof: completed) {
                                if !requireUniqueWitness { return <Result.Ok value=completed /> }
                                selected = try self.mergeMemberWitnessProof(selected: selected, candidate: completed, traitOwner: traitOwner)
                            }
                        }
                        if !self.traitProofStateSeen(states: seen, candidate: start) { seen.append(start) pending.append(start) }
                    }
                }
            }
        }
        mut val ci: U64 = 0U64
        while includeConcrete && ci < self.decls.conformCount() {
            val cf: Conform = self.decls.conformAt(index: ci)
            if !cf.derived && cf.subjectTraitOwner == 0U64 && self.proofSourceIsActive(baseRef: baseRef, extId: cf.extId) {
                val witness: WitnessMatch = (try self.conformanceWitnessMatch(conformIdx: ci, typeRef: baseRef, traitArgs: [], traitArgsOpen: true))
                if witness.conformIdx != 0U64 {
                    mut val edges: Array[WitnessMatch] = []
                    edges.append(witness)
                    val start: TraitProofState = <TraitProofState traitOwner=cf.traitStart traitId=cf.traitId traitArgs=(try self.groundedWitnessTraitArgs(cf: cf, witness: witness)) edges=edges />
                    if self.traitProofStateMatchesSources(state: start, sourceOwners: sourceOwners) && start.traitOwner == traitOwner && (traitId == 0U64 || start.traitId == traitId) && (traitArgsOpen || self.typeRefListPatternMatches(pattern: traitArgs, patternParams: patternParams, actual: <PatternTypeInput.Values values=start.traitArgs />)) {
                        val completed = try self.completeTraitProofState(state: start, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions)
                        if !self.proofIsMissing(proof: completed) {
                            if !requireUniqueWitness { return <Result.Ok value=completed /> }
                            selected = try self.mergeMemberWitnessProof(selected: selected, candidate: completed, traitOwner: traitOwner)
                        }
                    }
                    if !(self.traitProofStateSeen(states: seen, candidate: start)) {
                        seen.append(start)
                        pending.append(start)
                    }
                }
            }
            ci += 1U64
        }
        mut val cursor: U64 = 0U64
        while cursor < pending.count() {
            val state: TraitProofState = pending[cursor]
            // Supertraits follow authored evidence only. A concrete impl may
            // not discharge its own parent obligation by asserting its child.
            if state.edges.count() == 0U64 {
                match state.origin {
                    TraitProofOrigin.Assumption(source: val source, steps: val steps) => {
                        val bound = self.assumedSupertraitBound(source: source, steps: steps)
                        val parentIndex = self.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
                        if parentIndex < self.decls.traitCount() {
                            val parent = self.decls.traitAt(index: parentIndex)
                            mut val clause = 0U64
                            while clause < parent.supertraits.count() {
                                mut val nextSteps = steps
                                nextSteps.append(<SupertraitRef traitIndex=parentIndex boundIndex=clause />)
                                val inherited = self.assumedSupertraitBound(source: source, steps: nextSteps)
                                val targetIndex = self.decls.traitIndexByOffset(offset: inherited.constraint.key.owner)
                                if targetIndex < self.decls.traitCount() {
                                    val next = <TraitProofState origin=<TraitProofOrigin.Assumption source=source steps=nextSteps /> traitOwner=inherited.constraint.key.owner traitId=self.decls.traitAt(index: targetIndex).nameId traitArgs=inherited.constraint.key.positionalArgs edges=[] />
                                    if self.traitProofStateMatchesSources(state: next, sourceOwners: sourceOwners) && next.traitOwner == traitOwner && (traitId == 0U64 || next.traitId == traitId) && (traitArgsOpen || self.typeRefListPatternMatches(pattern: traitArgs, patternParams: patternParams, actual: <PatternTypeInput.Values values=next.traitArgs />)) {
                                        val completed = try self.completeTraitProofState(state: next, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions)
                                        if !self.proofIsMissing(proof: completed) {
                                            if !requireUniqueWitness { return <Result.Ok value=completed /> }
                                            selected = try self.mergeMemberWitnessProof(selected: selected, candidate: completed, traitOwner: traitOwner)
                                        }
                                    }
                                    if !self.assumedTraitInstanceSeen(states: seen, candidate: next, bound: inherited) { seen.append(next) pending.append(next) }
                                }
                                clause += 1U64
                            }
                        }
                    }
                    TraitProofOrigin.Witness => {}
                }
            }
            ci = 0U64
            while ci < self.decls.traitSubjectConformCount() {
                val edgeIndex = self.decls.traitSubjectConformIndexAt(index: ci)
                val edge: Conform = self.decls.conformAt(index: edgeIndex)
                if edge.subjectTraitOwner != 0U64 && edge.typeStart == state.traitOwner && edge.typeId == state.traitId && self.proofSourceIsActive(baseRef: baseRef, extId: edge.extId) {
                    val witness: WitnessMatch = self.traitSubjectWitnessMatch(conformIdx: edgeIndex, subjectArgs: state.traitArgs, selfRef: baseRef)
                    if witness.conformIdx != 0U64 && !self.traitProofPathContains(edges: state.edges, witness: witness) {
                        mut val edges: Array[WitnessMatch] = state.edges
                        edges.append(witness)
                        val next: TraitProofState = <TraitProofState origin=state.origin traitOwner=edge.traitStart traitId=edge.traitId traitArgs=(try self.groundedWitnessTraitArgs(cf: edge, witness: witness)) edges=edges />
                        if self.traitProofStateMatchesSources(state: next, sourceOwners: sourceOwners) && next.traitOwner == traitOwner && (traitId == 0U64 || next.traitId == traitId) && (traitArgsOpen || self.typeRefListPatternMatches(pattern: traitArgs, patternParams: patternParams, actual: <PatternTypeInput.Values values=next.traitArgs />)) {
                            val completed = try self.completeTraitProofState(state: next, assocNames: assocNames, assocValues: assocValues, assumptions: assumptions)
                            if !self.proofIsMissing(proof: completed) {
                                if !requireUniqueWitness { return <Result.Ok value=completed /> }
                                selected = try self.mergeMemberWitnessProof(selected: selected, candidate: completed, traitOwner: traitOwner)
                            }
                        }
                        if !(self.traitProofStateSeen(states: seen, candidate: next)) {
                            seen.append(next)
                            pending.append(next)
                        }
                    }
                }
                ci += 1U64
            }
            cursor += 1U64
        }
        return <Result.Ok value=selected />
    }

    // Existential conformance queries may stop at any proof. Executable
    // member selection must instead distinguish different terminal witnesses.
    // Paths to the same witness share a body; its own calls select their own
    // witnesses in the declaration environment, not in the caller's path.
    inout fn mergeMemberWitnessProof(selected: StaticConformanceProof, candidate: StaticConformanceProof, traitOwner: U64) -> Result[StaticConformanceProof, CompileDiagnostic] {
        if self.proofIsMissing(proof: selected) { return <Result.Ok value=candidate /> }
        val traitIndex = self.decls.traitIndexByOffset(offset: traitOwner)
        val prior = self.proofWitnessForTrait(proof: selected, traitIdx: traitIndex)
        val next = self.proofWitnessForTrait(proof: candidate, traitIdx: traitIndex)
        if prior.conformIdx != 0U64 && next.conformIdx != 0U64 && self.sameWitnessMatch(a: prior, b: next) { return <Result.Ok value=selected /> }
        if self.sameStaticConformanceProof(a: selected, b: candidate) { return <Result.Ok value=selected /> }
        return <Result.Err error=self.diagnosticAt(offset: traitOwner, msg: "ambiguous bare call: two conformed traits provide this method; select the source with `a#P.method()`") />
    }

    // Resolve an exact concrete trait instance through the same proof query
    // used by extension receiver applicability.  The queried positional args
    // are rigid, so no target binder list is supplied.
    inout fn concreteConformanceProof(baseRef: U64, traitId: U64, traitOwner: U64, traitArgs: PatternTypeInput, assumptions: Array[DeclarationBoundRef] = []) -> Result[StaticConformanceProof, CompileDiagnostic] {
        return <Result.Ok value=(try self.traitPatternProof(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: traitArgs, patternParams: <PatternBindInput.Values values=[] />, assumptions: assumptions)) />
    }

    inout fn assocBindingFor(baseRef: U64, traitId: U64, traitOwner: U64, traitArgs: Array[U64], assocId: U64) -> Result[U64, CompileDiagnostic] {
        val proof: StaticConformanceProof = (try self.concreteConformanceProof(baseRef: baseRef, traitId: traitId, traitOwner: traitOwner, traitArgs: <PatternTypeInput.Values values=traitArgs />))
        return <Result.Ok value=(try self.associatedOutputInProof(proof: proof, traitOwner: traitOwner, assocId: assocId)) />
    }

    inout fn resolveAssocProjection(tyRef: U64) -> Result[U64, CompileDiagnostic] {
        val t: TypeRef = self.arena.typeAt(index: tyRef)
        if t.assocNameId == 0U64 {
            return <Result.Ok value=tyRef />
        }
        // `groundTypeRef` preserves the projection receiver's additive view
        // facet while substituting a ParamId (`T#E` -> `S#E`).  Keeping that
        // law in the general substitution operation makes every consumer --
        // projections, ordinary extension calls, and final descriptors --
        // agree on the same source provenance.
        val baseRef: U64 = (try self.groundTypeRef(ref: self.plainRefOfProjection(t: t)))
        if baseRef >= self.arena.typeCount() {
            return <Result.Ok value=tyRef />
        }
        // A projection is a semantic term during declaration checking.  Its
        // receiver may be an impl binder (`T#P.Item`) with no concrete
        // nominal declaration yet; resolving it here would turn structural
        // cycle validation into a failed witness lookup.  Concrete receivers
        // are annotated by the visibility pass before projection resolution.
        val base: TypeRef = self.arena.typeAt(index: baseRef)
        // A lexical Param is a symbolic term even if an unrelated ambient
        // Mono context happens to bind the same spelling.  Projection
        // resolution is deferred until THIS ParamId is substituted.
        if base.paramId != 0U64 { return <Result.Ok value=tyRef />}
        if !base.hasDecl && !(base.isAny) && !(self.isPrimType(start: base.nameStart, len: base.nameLen)) {
            return <Result.Ok value=tyRef />
        }
        // A nominal head alone does not make a projection concrete. In
        // `Array[Self#Iterator.Item]`, the Array declaration is known but its
        // element remains abstract, so selecting an `Array : Iterator`
        // witness here would invent a conformance that the source never
        // established. Wait until every receiver child is grounded through a
        // concrete body environment.
        if !((try self.tyRefIsGround(ref: baseRef))) { return <Result.Ok value=tyRef />}
        // Projection trait arguments are ordinary children of the type term.
        // Ground them under the active generic environment before selecting a
        // witness: `Parser#Convert[T].Output` in a `T = String` instance must
        // query Convert[String], never the template spelling `T`.
        mut val traitArgs: Array[U64] = []
        mut val ai: U64 = 0U64
        while ai < t.assocTraitArgs.count() {
            val arg: U64 = (try self.groundTypeRef(ref: t.assocTraitArgs[ai]))
            if !((try self.tyRefIsGround(ref: arg))) {
                return <Result.Ok value=tyRef />
            }
            traitArgs.append(arg)
            ai += 1U64
        }
        if t.assocTraitId == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: t.siteOffset, msg: "associated-type short projection was not resolved from a unique `where` source — write `T#Trait.Item` (spec/08)") />
        }
        // Lowering already records the canonical source owner; the later
        // visibility pass refines the same fact.  Synthetic/legacy terms may
        // not have passed that refinement, so keep the resolved lowering
        // owner rather than dropping identity back to text.
        mut val traitOwner: U64 = t.assocTraitDeclOffset
        if traitOwner == 0U64 { traitOwner = t.assocTraitStart }
        val bound: U64 = (try self.assocBindingFor(baseRef: baseRef, traitId: t.assocTraitId, traitOwner: traitOwner, traitArgs: traitArgs, assocId: t.assocNameId))
        if bound != 0U64 {
            return <Result.Ok value=(try self.groundTypeRef(ref: bound)) />
        }
        return <Result.Err error=self.diagnosticAt(offset: t.siteOffset, msg: "associated-type projection names an associated type that is not bound by the selected conformance (spec/08)") />
    }

    inout fn isGenericEnumInst(ref: U64) -> Bool {
        if ref >= self.arena.typeCount() {
            return false
        }
        val t = self.arena.typeTerms[ref]
        if t.paramId == 0U64 && t.args.len == 0U64 {
            return false
        }
        return self.genericEnumIndexForType(ref: ref) < self.arena.enumCount()
    }

    inout fn typeRefEq(a: U64, b: U64) -> Bool {
        if a == b {
            return true
        }
        if a >= self.arena.typeTerms.count() || b >= self.arena.typeTerms.count() { return false }
        if !(self.typeTermRefSameHead(a: a, b: b)) { return false }
        val childCount = self.typeTermRefChildCount(ref: a)
        if childCount != self.typeTermRefChildCount(ref: b) { return false }
        mut val i: U64 = 0U64
        while i < childCount {
            if self.typeTermRefIdentityChildLabel(ref: a, index: i) != self.typeTermRefIdentityChildLabel(ref: b, index: i) || !(self.typeRefEq(a: self.typeTermRefChildRef(ref: a, index: i), b: self.typeTermRefChildRef(ref: b, index: i))) { return false }
            i += 1U64
        }
        return true
    }

    inout fn appendMangle(ref: U64) -> Result[(), CompileDiagnostic] {
        val t: TypeRef = self.arena.typeAt(index: (try self.resolveTy(tyRef: ref)))
        mut val j: U64 = 0
        while j < t.nameLen {
            self.arena.bytes.append(self.arena.bytes[t.nameStart + j])
            j += 1
        }
        mut val i: U64 = 0
        while i < t.args.count() {
            self.arena.bytes.append(95)
            try self.appendMangle(ref: t.args[i])
            i += 1
        }
        return <Result.Ok value=() />
    }

    inout fn appendMangleSpan(ref: U64) -> Result[Bind, CompileDiagnostic] {
        val start: U64 = self.arena.bytes.count()
        try self.appendMangle(ref: ref)
        val n: U64 = self.arena.bytes.count()
        return <Result.Ok value=<Bind nameStart=start nameLen=(n - start) fieldStart=ref fieldLen=0U64 /> />
    }

    inout fn sameMangle(refA: U64, refB: U64) -> Result[Bool, CompileDiagnostic] {
        val ra: U64 = (try self.resolveTy(tyRef: refA))
        val rb: U64 = (try self.resolveTy(tyRef: refB))
        if ra >= self.arena.typeCount() {
            return <Result.Ok value=false />
        }
        if rb >= self.arena.typeCount() {
            return <Result.Ok value=false />
        }
        val a: TypeRef = self.arena.typeAt(index: ra)
        val b: TypeRef = self.arena.typeAt(index: rb)
        if a.nameId != b.nameId {
            return <Result.Ok value=false />
        }
        if a.args.count() != b.args.count() {
            return <Result.Ok value=false />
        }
        mut val i: U64 = 0
        while i < a.args.count() {
            if !((try self.sameMangle(refA: a.args[i], refB: b.args[i]))) {
                return <Result.Ok value=false />
            }
            i += 1
        }
        return <Result.Ok value=true />
    }

    inout fn isCompoundType(ref: U64) -> Result[Bool, CompileDiagnostic] {
        val r: U64 = (try self.resolveTy(tyRef: ref))
        if r >= self.arena.typeCount() {
            return <Result.Ok value=false />
        }
        return <Result.Ok value=self.arena.typeAt(index: r).args.count() > 0U64 />
    }

    // Resolve a term that is a binder in the current method's receiver pattern
    // against the selected receiver instance.  This deliberately uses the
    // receiver pattern's lexical scope — not the ambient generic scope and not
    // a global name lookup — so it also forms the safe bridge for legacy terms
    // that have not yet been stamped with a ParamId.
    inout fn receiverPatternArgument(termRef: U64) -> U64 {
        mut val ref: U64 = self.cur.recvInstRef
        if ref == 0U64 { ref = self.cur.bodyEnvironment.receiverRef }
        if ref == 0U64 { ref = self.cur.selfRef }
        if ref == 0U64 || ref >= self.arena.typeCount() { return 0U64 }
        if self.cur.bodyFnIdx >= self.arena.functionCount() { return 0U64 }
        val bodyFn: Func = self.arena.functionAt(index: self.cur.bodyFnIdx)
        if bodyFn.recvTy == 0U64 { return 0U64 }
        val binder: U64 = self.plainBinder(ref: termRef, params: <PatternBindInput.Function range=bodyFn.typeParams />)
        if binder >= bodyFn.typeParams.count() { return 0U64 }
        mut val binds: Array[UnifyBind] = []
        val matches: Bool = self.unifyPatterns(a: bodyFn.recvTy, aSide: 0U64, b: ref, bSide: 1U64, aParams: <PatternBindInput.Function range=bodyFn.typeParams />, bParams: <PatternBindInput.Values values=[] />, binds: inout binds, ignoreTopView: true)
        if !(matches) { return 0U64 }
        val binderId: U64 = self.binderIdentity(b: self.funcBindAt(binds: bodyFn.typeParams, index: binder))
        val found: U64 = self.unificationBindingIndex(binds: binds, side: 0U64, binderId: binderId)
        if found < binds.count() { return binds[found].ref }
        return 0U64
    }

    // A method on `Set[I64]` may refer to the `E` bound by the *struct*
    // declaration, while its own impl/method binder is a distinct ParamId.
    // Recover that declaration-binder substitution from the selected receiver
    // instance. This is an explicit instance edge, never a spelling fallback.
    inout fn receiverParamArgument(paramId: U64) -> U64 {
        mut val ref: U64 = self.cur.recvInstRef
        if ref == 0U64 { ref = self.cur.bodyEnvironment.receiverRef }
        if ref == 0U64 { ref = self.cur.selfRef }
        if ref == 0U64 || ref >= self.arena.typeCount() { return 0U64 }
        val recv: TypeRef = self.arena.typeAt(index: ref)
        // A method's `impl[E] Set[E]` binder is distinct from the declaration
        // binder on `struct Set[E]`.  Its lexical ParamId therefore cannot be
        // recovered by merely pairing the nominal declaration's parameters with
        // the selected `Set[I64]`.  Match the method's full receiver pattern
        // against that selected instance through the shared structural unifier;
        // this is the same semantic instance relation used by conformance and
        // callable selection, and handles nested receiver patterns as well.
        if self.cur.bodyFnIdx < self.arena.functionCount() {
            val bodyFn: Func = self.arena.functionAt(index: self.cur.bodyFnIdx)
            mut val pi: U64 = 0U64
            while pi < bodyFn.typeParams.count() {
                val bind: Bind = self.funcBindAt(binds: bodyFn.typeParams, index: pi)
                if bind.paramId == paramId {
                    val term: U64 = self.pushType(t: <TypeRef nameStart=bind.nameStart nameLen=bind.nameLen paramId=paramId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                    val matched: U64 = self.receiverPatternArgument(termRef: term)
                    if matched != 0U64 { return matched }
                }
                pi += 1U64
            }
        }
        mut val params: Array[Bind] = []
        val si: U64 = self.structIndexForType(ref: ref)
        if si < self.arena.structCount() {
            params = self.arena.structAt(index: si).typeParams
        } else {
            val ei: U64 = self.enumIndexForType(ref: ref)
            if ei < self.arena.enumCount() { params = self.arena.enumAt(index: ei).typeParams }
        }
        if params.count() != recv.args.count() { return 0U64 }
        mut val i: U64 = 0U64
        while i < params.count() {
            if params[i].paramId == paramId { return recv.args[i] }
            i += 1U64
        }
        return 0U64
    }

    inout fn resolveTy(tyRef: U64) -> Result[U64, CompileDiagnostic] {
        if tyRef >= self.arena.typeCount() {
            return <Result.Ok value=tyRef />
        }
        val t: TypeRef = self.arena.typeAt(index: tyRef)
        if t.assocNameId != 0U64 {
            return <Result.Ok value=(try self.resolveAssocProjection(tyRef: tyRef)) />
        }
        // `any P[Args]` is an existential type constructor, not a bare use of
        // the spelling `P`.  In particular, a user trait named `T` must remain
        // `any T` while we are grounding `Optional[T]`: treating the
        // existential head as a legacy textual binder rewrites the entire
        // existential through Optional's declaration parameter and can create
        // a self-recursing type query.  Its positional arguments are grounded
        // structurally by groundTypeRef before this head-resolution step.
        //
        // The final TypeTerm makes this distinction representational
        // (`Existential` versus `Param`); `isAny` is the corresponding
        // migration-carrier tag, so this belongs at the semantic resolver
        // boundary rather than in an LLVM/backend special case.
        if t.isAny {
            return <Result.Ok value=tyRef />
        }
        if t.paramId != 0U64 {
            mut val pi: U64 = 0U64
            while pi < self.cur.typeParams.count() {
                if self.cur.typeParams[pi].paramId == t.paramId {
                    if pi < self.cur.typeArgs.count() {
                        val arg: U64 = self.cur.typeArgs[pi]
                        // An instance may be symbolic relative to an enclosing
                        // instance: the receiver declaration's `E_struct` maps
                        // to the impl binder `E_impl`, which then maps to I64.
                        // Normalize the substitution value through the same
                        // ParamId lookup instead of treating one ambient pair as
                        // the whole environment.
                        if arg != tyRef {
                            val resolved: U64 = (try self.resolveTy(tyRef: arg))
                            // Views are an outer term facet, not part of the
                            // substituted binder value.  Replacing `T#E`
                            // with S must therefore form S#E; returning S
                            // here would silently erase the selected
                            // extension source for every later proof/call
                            // query.
                            val additions: Array[ResolvedViewSource] = self.typeRefViewSources(ref: tyRef)
                            if additions.count() == 0U64 { return <Result.Ok value=resolved />}
                            return <Result.Ok value=self.typeRefWithAddedViewSources(ref: resolved, additions: additions) />
                        }
                    }
                    return <Result.Ok value=tyRef />
                }
                pi += 1U64
            }
            val receiverArg: U64 = self.receiverParamArgument(paramId: t.paramId)
            if receiverArg != 0U64 && receiverArg != tyRef {
                val resolved: U64 = (try self.resolveTy(tyRef: receiverArg))
                val additions: Array[ResolvedViewSource] = self.typeRefViewSources(ref: tyRef)
                if additions.count() == 0U64 { return <Result.Ok value=resolved />}
                return <Result.Ok value=self.typeRefWithAddedViewSources(ref: resolved, additions: additions) />
            }
            return <Result.Ok value=tyRef />
        }
        // The ParamId migration is intentionally incremental.  A legacy bare
        // term may still have paramId=0, but if it is a binder in this method's
        // receiver pattern its meaning is fully determined by that pattern and
        // the already-selected receiver instance.  Resolve only through that
        // structural relation; the textual fallback below remains for unrelated
        // old terms until TypeTerm construction is wholly unified.
        val receiverPatternArg: U64 = self.receiverPatternArgument(termRef: tyRef)
        if receiverPatternArg != 0U64 && receiverPatternArg != tyRef {
            return <Result.Ok value=(try self.resolveTy(tyRef: receiverPatternArg)) />
        }
        if t.args.count() == 0U64 {
            // `Self`/`Item` as types (provided methods on a trait): resolve to the
            // receiver type and its associated `Item` binding (set per method).
            if self.cur.selfRef != 0U64 {
                if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
                    return <Result.Ok value=self.cur.selfRef />
                }
            }
            if self.cur.itemRef != 0U64 {
                if rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Item") {
                    return <Result.Ok value=self.cur.itemRef />
                }
            }
            // last-match (iterate high → low): a method-own type param is appended to the
            // env AFTER the receiver's own params (providedCopyTypeParams), so when names
            // collide (`fold[B]` copied onto `MapIter[I, F, B]` — both named `B`) the inner
            // method-own `B` (the accumulator) must shadow the conformer's `B` (the item).
            // With all-distinct names first-match and last-match agree, so this only changes
            // the collision case, resolving it the way lexical shadowing requires.
            // TypeRef's nameId is an interning cache, not semantic state.  A
            // TypeRef reconstructed by a later frontend phase may legitimately
            // retain 0, while the active generic binder always has its interned
            // id.  Compare the canonical spelling in that case, just as the
            // final-callable/body keys do; otherwise a concrete print[I64]
            // instance can leave a nested receiver as literal `T`.
            mut val typeNameId: U64 = t.nameId
            if typeNameId == 0U64 {
                typeNameId = intern(c: inout self, start: t.nameStart, len: t.nameLen)
            }
            mut val i: U64 = self.cur.typeParams.count()
            while i > 0U64 {
                i -= 1
                val p: Bind = self.cur.typeParams[i]
                // Some pre-ParamId TypeRefs/Binds in the checked-in std
                // source legitimately have no interned id yet. `typeNameId`
                // above is recovered from the term spelling, but comparing it
                // to an absent binder id (0) can never substitute the term.
                // Use the binder's lexical span only for that legacy case;
                // stamped terms always use ParamId above, so equal spellings
                // from distinct scopes are never conflated here.
                if typeNameId == p.nameId || (p.nameId == 0U64 && spansEqual(c: inout self, aStart: t.nameStart, aLen: t.nameLen, bStart: p.nameStart, bLen: p.nameLen)) {
                    if i < self.cur.typeArgs.count() {
                        return <Result.Ok value=self.cur.typeArgs[i] />
                    }
                }
            }
        }
        return <Result.Ok value=tyRef />
    }

    inout fn isTypeParamName(start: U64, len: U64) -> Bool {
        // a name that names a declared struct/enum is a concrete type, never a type
        // parameter — even if some *other* generic's parameter shares the name (a user
        // struct `B` vs `MapIter[I, F, B]`'s `B`). Concrete types win the global check;
        // a template's own parameter is resolved by the active env before this matters.
        val qId: U64 = intern(c: inout self, start: start, len: len)
        return self.arena.hasTypeParameterName(nameId: qId)
    }

    inout fn tyRefIsGround(ref: U64) -> Result[Bool, CompileDiagnostic] {
        if ref >= self.arena.typeCount() {
            return <Result.Ok value=true />
        }
        val t: TypeRef = self.arena.typeAt(index: ref)
        if t.paramId != 0U64 { return <Result.Ok value=false />}
        // an existential `any P` is a concrete ground type — its `P` names a TRAIT, never a
        // type parameter (a single-letter trait name like `P` would otherwise be misread as a
        // type-param name by the check below, poisoning `Array[any P]` registration).
        if t.isAny {
            return <Result.Ok value=true />
        }
        if t.assocNameId != 0U64 {
            val r: U64 = (try self.resolveTy(tyRef: ref))
            if r == ref {
                return <Result.Ok value=false />
            }
            return <Result.Ok value=(try self.tyRefIsGround(ref: r)) />
        }
        if self.isTypeParamName(start: t.nameStart, len: t.nameLen) {
            return <Result.Ok value=false />
        }
        // `Self` is a contextual keyword, not concrete without a method env; a flat
        // scan (Make/Cast) reaching a provided body's `<FilterIter[Self,…]>` must not
        // register it (the method-aware scan grounds the real instance). `Item` is NOT
        // treated this way — it is a legal user type name; resolveTy only rewrites it
        // when an Iterator method env is active (curItemRef set).
        if t.paramId == 0U64 && rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
            return <Result.Ok value=false />
        }
        mut val i: U64 = 0
        while i < self.typeTermChildCount(t: t) {
            if !((try self.tyRefIsGround(ref: self.typeTermChildRef(t: t, index: i)))) {
                return <Result.Ok value=false />
            }
            i += 1
        }
        return <Result.Ok value=true />
    }
}
