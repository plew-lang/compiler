// Is `id` a place expression (a variable / field / element — an lvalue), as
// opposed to a fresh value (literal / call / construction)? Used to decide
// whether copying an array value is needed for value semantics.

pub impl Comp {
    inout fn isPlaceExpr(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Ident(val start, val len) => { return true }
            Expr.Field(val base, val nameStart, val nameLen) => { return true }
            Expr.Index(val base, val index) => { return true }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Deref(base: _) => { return true }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return self.isPlaceExpr(id: operand) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.isPlaceExpr(id: recv) }
            _ => { return false }
        }
    }

    inout fn isEnumName(start: U64, len: U64) -> Bool {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val ei: U64 = 0
        while ei < self.arena.enumCount() {
            val e: EnumDef = self.arena.enumAt(index: ei)
            if e.nameId == qId {
                return true
            }
            ei += 1
        }
        return false
    }

    // Acceptance soundness: comparison operators (== != < <= > >=) are pure trait sugar
    // (Eq/Ord, spec/12). Numbers/String/derived-`@[Eq]` types conform via a real witness
    // (resolved by hasCompareWitness); anything else — a struct/enum/array with no witness
    // — has no comparison and must be a clean compile error rather than broken codegen.
    // (Reached only after the witness path has been ruled out.)
    // The comparison operand type for witness lookup. A `newtype` inherits its underlying's
    // `Eq`/`Ord` with `Self` substituted, so a comparison of two values of the SAME newtype
    // resolves to the underlying's witness; a newtype compared with anything else stays the
    // newtype (no witness) and is rejected (sound, like the arithmetic path).
    inout fn cmpOperandType(lhs: U64, rhs: U64) -> Result[TypeInfo, CompileDiagnostic] {
        val lt: TypeInfo = (try self.typeOf(id: lhs))
        if lt.kind == 2 {
            val under: Bind = self.newtypeUnderName(start: lt.nameStart, len: lt.nameLen)
            if under.nameStart != lt.nameStart || under.nameLen != lt.nameLen {
                val rt: TypeInfo = (try self.typeOf(id: rhs))
                if rt.kind == 2 {
                    if spansEqual(c: inout self, aStart: lt.nameStart, aLen: lt.nameLen, bStart: rt.nameStart, bLen: rt.nameLen) {
                        return <Result.Ok value=self.typeInfoOfName(start: under.nameStart, len: under.nameLen, isArray: false) />
                    }
                }
            }
        }
        return <Result.Ok value=lt />
    }

    inout fn compareNeedsTrait(op: I64, lhs: U64, rhs: U64) -> Result[Bool, CompileDiagnostic] {
        if op < 50 {
            return <Result.Ok value=false />
        }
        if op > 55 {
            return <Result.Ok value=false />
        }
        val lt: TypeInfo = (try self.cmpOperandType(lhs: lhs, rhs: rhs))
        if lt.kind == 3 {
            return <Result.Ok value=true />
        }
        // A named aggregate — struct OR enum — with no witness (a witnessed type is
        // accepted by hasCompareWitness before this) needs an explicit `Eq`/`Ord` impl.
        // Enums are no longer exempt: there is no built-in tag comparison, so a bare
        // `enum ==` without `@[Eq]` is a clean "needs a witness" error, same as a struct.
        if lt.kind == 2 {
            return <Result.Ok value=true />
        }
        return <Result.Ok value=false />
    }
}

// Index of an assoc fn named `name` on type (typeStart,typeLen), or c.arena.functionCount().
// (A by-name lookup for the operator witnesses Eq.eq / Ord.compare, which have a
// single witness per type.)
pub impl Comp {
    inout fn findAssocByName(typeStart: U64, typeLen: U64, name: String) -> U64 {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: i)
            if f.isAssoc {
                if f.recvId == qType {
                    if rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.functionCount()
    }

    // Like findAssocByName but for a value method (`f.hasRecv`), resolved by receiver
    // type + selector name only (no argument arity/label match). Used to route `print`
    // through the type's `Format.format` witness (a single per-type impl, no overload).
    inout fn findMethodByName(typeStart: U64, typeLen: U64, name: String) -> U64 {
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: i)
            if f.hasRecv {
                if f.recvId == qType {
                    if rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.functionCount()
    }
}

pub impl Comp {

    // Whether the operand type carries the witness an operator needs: Eq's `eq` for
    // `==`/`!=`, Ord's `compare` for `< <= > >=` (spec/12). A named struct (kind 2) OR
    // a primitive scalar (kind 0 with a type name) whose type conforms desugars to the
    // witness — primitives are not special-cased (O6): `I32 < I32` routes through Core's
    // `impl I32 as Ord` to the `i32Lt` intrinsic. An untyped literal / String / enum has
    // no Eq/Ord here and keeps its own lowering (the dispatch handles those first).
    inout fn hasCompareWitness(op: I64, lhs: U64, rhs: U64) -> Result[Bool, CompileDiagnostic] {
        val lt: TypeInfo = (try self.cmpOperandType(lhs: lhs, rhs: rhs))
        // Array equality requires the complete element type's Eq proof.
        // Nested generic arguments must survive the legacy TypeInfo projection.
        if lt.kind == 3 {
            if op == opEq() || op == opNe() {
                mut val elemOk: Bool = false
                mut val er: U64 = 0U64
                if lt.ref != 0U64 && lt.ref < self.arena.typeCount() {
                    val arrayType = self.arena.typeAt(index: lt.ref)
                    if arrayType.args.count() == 1U64 { er = arrayType.args[0U64] }
                }
                if er == 0U64 { er = self.arrayElemRef(start: lt.nameStart, len: lt.nameLen) }
                if er != 0U64 {
                    val eqOwner: U64 = self.coreTraitOwner(name: "Eq")
                    elemOk = eqOwner != 0U64 && (try self.conformsInstance(ref: er, traitStart: eqOwner, traitLen: self.traitNameLenByOwner(owner: eqOwner)))
                } else {
                    // a bare scalar/named element with no registered structured ref
                    // (no type args to constrain): the name-based Eq check suffices.
                    elemOk = self.eqWitnessReady(ti: lt)
                }
                if elemOk {
                    val arr: Bind = self.internBytes(s: "Array")
                    return <Result.Ok value=self.findAssocByName(typeStart: arr.nameStart, typeLen: arr.nameLen, name: "eq") < self.arena.functionCount() />
                }
            }
            return <Result.Ok value=false />
        }
        if lt.kind == 2 || lt.kind == 0 {
            if lt.nameLen == 0 {
                return <Result.Ok value=false />
            }
            // `==`/`!=` desugar to Eq.eq; gated on an explicit `impl T as Eq` (spec/12:
            // operators are trait sugar, not implicit). `< <= > >=` likewise on Ord.
            if op == opEq() {
                return <Result.Ok value=self.eqWitnessReady(ti: lt) />
            }
            if op == opNe() {
                return <Result.Ok value=self.eqWitnessReady(ti: lt) />
            }
            if op >= 52 {
                if op <= 55 {
                    if self.typeConformsToName(typeStart: lt.nameStart, typeLen: lt.nameLen, traitName: "Ord") {
                        return <Result.Ok value=self.findAssocByName(typeStart: lt.nameStart, typeLen: lt.nameLen, name: "compare") < self.arena.functionCount() />
                    }
                }
            }
        }
        return <Result.Ok value=false />
    }

    // Whether the operand type both conforms to Eq and carries the `eq` witness.
    inout fn eqWitnessReady(ti: TypeInfo) -> Bool {
        if self.typeConformsToName(typeStart: ti.nameStart, typeLen: ti.nameLen, traitName: "Eq") {
            return self.findAssocByName(typeStart: ti.nameStart, typeLen: ti.nameLen, name: "eq") < self.arena.functionCount()
        }
        return false
    }
}

pub impl Comp {

    // The type to use for an operator's witness lookup. A named struct (kind 2) or a
    // typed scalar (kind 0 with a name) uses its own type; a width-less scalar (a
    // `typeOf` that recovers no name — e.g. some method-return / chain forms) recovers
    // the SHARED int type from both operands (Plew: operands share a type), so
    // `someU64Fn() + 1` still finds `impl U64 as Add` rather than falling to built-in.
    inout fn binWitnessType(lhs: U64, rhs: U64) -> Result[TypeInfo, CompileDiagnostic] {
        val lt: TypeInfo = (try self.typeOf(id: lhs))
        if lt.kind == 2 {
            return <Result.Ok value=lt />
        }
        if lt.kind == 0 {
            if lt.nameLen > 0 {
                return <Result.Ok value=lt />
            }
        }
        return <Result.Ok value=(try self.arithIntType(lhs: lhs, rhs: rhs)) />
    }

    // Verify uses the same Core declaration, full receiver identity, extension
    // visibility and right-operand compatibility as literal typing and dispatch.
    inout fn hasBinTraitWitness(op: I64, lhs: U64, rhs: U64) -> Result[Bool, CompileDiagnostic] {
        if !(isBinTraitOp(op: op)) {
            return <Result.Ok value=false />
        }
        val left = try self.binWitnessType(lhs: lhs, rhs: rhs)
        val right = try self.typeOf(id: rhs)
        val rightRef = self.operatorTypeRef(t: right)
        val callee = try self.findBinTraitWitnessForRef(receiverRef: self.operatorTypeRef(t: left), op: op, rhsRef: rightRef, rhsUntyped: rightRef == 0U64)
        return <Result.Ok value=callee < self.arena.functionCount() />
    }

    // A typed operand under an arithmetic op with no operator-trait witness: the C
    // `+`/`-`/... has no meaning, so it is a loud error (spec/12: an operator is only
    // callable when its trait is implemented), not a fall-through to clang. Covers a
    // struct/enum (kind 2) and a known primitive with no conformance (e.g. arithmetic
    // in a program that never loaded @Std/Core, so the primitive witnesses are absent).
    inout fn binTraitNeedsTrait(op: I64, lhs: U64, rhs: U64) -> Result[Bool, CompileDiagnostic] {
        if isBinTraitOp(op: op) {
            val lt: TypeInfo = (try self.binWitnessType(lhs: lhs, rhs: rhs))
            if lt.kind == 2 {
                return <Result.Ok value=true />
            }
            if lt.kind == 0 {
                // any scalar operand under an arithmetic operator must resolve to a
                // witness (no built-in fast path): a known primitive with no witness
                // (no @Std/Core) and a width-less operand both error. [WIP: width-less
                // error is on to catch every typeOf gap before deleting the built-in.]
                return <Result.Ok value=true />
            }
        }
        return <Result.Ok value=false />
    }
}

pub impl Comp {

    // Field type of a struct-destructure bind given the element type `et` (a struct,
    // possibly a generic instance). Shared by the for-loop destructure across the
    // check/mono/codegen passes so they agree on each bound field's type.
    inout fn forBindFieldType(et: TypeInfo, bd: Bind) -> Result[TypeInfo, CompileDiagnostic] {
        val receiver = (try self.destructureSubjectType(info: et, isElement: et.kind == 3))
        return <Result.Ok value=(try self.genericFieldTypeInfo(instRef: receiver, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)) />
    }

    // Add a for-loop struct-destructure's binds as locals (element type `et`), so the
    // body's references to the bound names resolve. Used by the check and mono scans
    // and by codegen (which also emits the C initializers).
    inout fn addForStructBinds(et: TypeInfo, binds: BindRange) -> Result[(), CompileDiagnostic] {
        mut val bi: U64 = 0
        while bi < binds.len {
            val bd: Bind = self.bindAt(binds: binds, index: bi)
            val ft: TypeInfo = (try self.forBindFieldType(et: et, bd: bd))
            self.addLocal(nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: bd.isMutable, owned: false)
            bi += 1
        }
        return <Result.Ok value=() />
    }
}
