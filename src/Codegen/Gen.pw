// ---- gen mode (`plew gen`, spec/16 metaprogramming) ----
//
// `plewc --gen <file>` compiles a *harness* program rather than the user's: it
// loads the file's whole module tree (so the macro structs and their `Derive`
// provided method `deriveFromSource` are in scope), suppresses the user's own
// `main` and the auto-part of `<Foo>.gen.pw`, and emits a synthesized `main`
// that, for each `@[Name(args)]` annotation, calls `<Name args/>.deriveFromSource`
// and writes the returned String to stdout. The `plew gen` shell runner pipes
// `plewc --gen <file> | clang | <run>` and redirects stdout into `<Foo>.gen.pw`
// (the same plewc|clang|run orchestration as bootstrap.sh / test.sh), so the
// runner is a version-agnostic String↔String machine that never touches the AST.
//
// M0: a trivial macro returns fixed text; the harness passes an empty source
// slice (`source: "", start: 0, end: 0`) since `parseItem` is a stub. M1 passes
// the annotated item's real source slice so macros can read the declaration.

pub impl Comp {
    inout fn internSourceLiteral(from: U64, to: U64) -> Bind {
        val start: U64 = self.arena.bytes.count()
        self.arena.bytes.append('"')
        mut val i: U64 = from
        while i < to {
            val b: U8 = self.arena.bytes[i]
            if b == '\\' {
                self.arena.bytes.append('\\')
                self.arena.bytes.append('\\')
            } else {
                if b == '"' {
                    self.arena.bytes.append('\\')
                    self.arena.bytes.append('"')
                } else {
                    if b == '\n' {
                        self.arena.bytes.append('\\')
                        self.arena.bytes.append('n')
                    } else {
                        if b == '\r' {
                            self.arena.bytes.append('\\')
                            self.arena.bytes.append('r')
                        } else {
                            if b == '\t' {
                                self.arena.bytes.append('\\')
                                self.arena.bytes.append('t')
                            } else {
                                self.arena.bytes.append(b)
                            }
                        }
                    }
                }
            }
            i += 1
        }
        self.arena.bytes.append('"')
        val len: U64 = self.arena.bytes.count() - start
        return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
    }

    inout fn checkDirectiveArgsPublic(d: DeriveReq) {
        mut val ai: U64 = 0
        while ai < d.args.count() {
            val mf: MakeField = d.args[ai]
            val v: U64 = self.fieldVis(structStart: d.nameStart, structLen: d.nameLen, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
            if v == 0U64 {
                self.errorAt(offset: mf.nameStart, msg: "directive argument sets a private field of the macro struct; a macro taking `@[Name(field: …)]` arguments must expose those fields publicly (mark them `pub`)")
            }
            ai += 1
        }
    }

    inout fn synthGenMain() {
        val writeN: Bind = self.internBytes(s: "write")
        val sN: Bind = self.internBytes(s: "s")
        val deriveN: Bind = self.internBytes(s: "derive")
        val parseN: Bind = self.internBytes(s: "parseItem")
        val inputN: Bind = self.internBytes(s: "input")
        val srcN: Bind = self.internBytes(s: "source")
        val startN: Bind = self.internBytes(s: "start")
        val endN: Bind = self.internBytes(s: "end")
        val mainN: Bind = self.internBytes(s: "main")
        mut val stmts: Array[U64] = []
        mut val i: U64 = 0
        while i < self.decls.derives.count() {
            val d: DeriveReq = self.decls.derives[i]
            // only generate from the ENTRY file's annotations (module 0), not those of its
            // dependencies (spec/16: `plew gen <file>` processes <file>, not the libraries it
            // imports). This matters now that std files carry `@[...]` (e.g. Core's primitive
            // `@[IntTryFrom]`): force-loading @Std/Core alongside an entry that IS Core would
            // otherwise collect the same annotations twice.
            if self.moduleOf(offset: d.declStart) != 0U64 {
                i += 1
                continue
            }
            // every `@[Name]` — `@[Eq]`/`@[Hash]` included — is a real derive macro now
            // (a type/trait implementing `Derive`), so all are run the same way.
            // directive arguments must set publicly-settable fields (enforce the
            // construction rule the post-checks pass skipped for this synthetic Make).
            self.checkDirectiveArgsPublic(d: d)
            // `parseItem(source: <item src>, start: declStart, end: declEnd)` — the
            // annotated item's own source slice, with its original offset so the macro
            // sees spans in original coordinates. (Synthesized post-checks, so the
            // free-fn cross-module use of `parseItem` bypasses import hygiene.)
            val srcLit: Bind = self.internSourceLiteral(from: d.declStart, to: d.declEnd)
            val srcE: U64 = self.pushExpr(e: <Expr.Str start=srcLit.nameStart len=srcLit.nameLen />)
            val startE: U64 = self.pushExpr(e: <Expr.Int value=d.declStart offset=0 isBool=false tyStart=0 tyLen=0 isNeg=false />)
            val endE: U64 = self.pushExpr(e: <Expr.Int value=d.declEnd offset=0 isBool=false tyStart=0 tyLen=0 isNeg=false />)
            mut val pargs: Array[Arg] = []
            pargs.append(<Arg expr=srcE isInout=false labelStart=srcN.nameStart labelLen=srcN.nameLen hasLabel=true />)
            pargs.append(<Arg expr=startE isInout=false labelStart=startN.nameStart labelLen=startN.nameLen hasLabel=true />)
            pargs.append(<Arg expr=endE isInout=false labelStart=endN.nameStart labelLen=endN.nameLen hasLabel=true />)
            val parseCall: U64 = self.pushExpr(e: <Expr.Call nameStart=parseN.nameStart nameLen=parseN.nameLen args=pargs />)
            // the receiver of `.derive`: a bare `@[X]` (no args) names the type/trait X
            // directly (assoc `Derive`); `@[X(args)]` constructs `<X args/>` first
            // (instance `ParameterizedDerive`, `self` = the config).
            mut val recv: U64 = 0
            if d.args.count() == 0 {
                recv = self.pushExpr(e: <Expr.Ident start=d.nameStart len=d.nameLen />)
            } else {
                recv = self.pushExpr(e: <Expr.Make typeStart=d.nameStart typeLen=d.nameLen variantStart=0 variantLen=0 isEnum=false ty=0 fields=d.args />)
            }
            // `recv.derive(input: parseItem(...))`
            mut val dargs: Array[Arg] = []
            dargs.append(<Arg expr=parseCall isInout=false labelStart=inputN.nameStart labelLen=inputN.nameLen hasLabel=true />)
            val call: U64 = self.pushExpr(e: <Expr.Method recv=recv nameStart=deriveN.nameStart nameLen=deriveN.nameLen args=dargs />)
            // `write(s: <that>)`.
            mut val wargs: Array[Arg] = []
            wargs.append(<Arg expr=call isInout=false labelStart=sN.nameStart labelLen=sN.nameLen hasLabel=true />)
            val wc: U64 = self.pushExpr(e: <Expr.Call nameStart=writeN.nameStart nameLen=writeN.nameLen args=wargs />)
            stmts.append(self.pushStmt(s: <Stmt.ExprStmt expr=wc />))
            i += 1
        }
        val blkId: U64 = self.arena.blocks.count()
        self.arena.blocks.append(<Block stmts=stmts />)
        val noTP: Array[Bind] = []
        val noParams: Array[Param] = []
        self.genMainIdx = self.arena.funcs.count()
        self.arena.funcs.append(<Func nameStart=mainN.nameStart nameLen=mainN.nameLen nameId=intern(c: inout self, start: mainN.nameStart, len: mainN.nameLen) typeParams=noTP params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=blkId hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    }
}
