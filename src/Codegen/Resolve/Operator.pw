// Part of name/type resolution (root: Frontend): binary / unary operator
// output-type inference, as `impl Comp` methods. `pub` during the methodization
// transition so still-free-function callers (Resolve/ExprType) can reach them.

pub impl Comp {
    // One concrete unary selector for declaration-time typing and final call
    // publication. The result comes from the selected declaration, not from
    // an assumption that Neg/Not/BitNot return their receiver type.
    inout fn unaryOperatorCallee(receiverRef: U64, op: I64) -> U64 {
        if receiverRef == 0U64 || receiverRef >= self.arena.typeCount() { return self.arena.functionCount() }
        val declaration = self.fieldStorageTypeRef(receiverRef: receiverRef)
        if declaration == 0U64 { return self.arena.functionCount() }
        val receiver: TypeRef = self.arena.typeAt(index: declaration)
        return self.findAssocByName(recvStart: receiver.nameStart, recvLen: receiver.nameLen, name: unaryMethodName(op: op))
    }

    inout fn unaryOperatorResultType(operand: TypeInfo, op: I64) -> Result[TypeInfo, CompileDiagnostic] {
        val receiver: U64 = self.operatorTypeRef(t: operand)
        if receiver == 0U64 { return <Result.Ok value=operand />}
        val resolution: StaticMemberResolution = (try self.staticOperatorTemplateResolution(op: op, receiverTerm: receiver, isUnary: true))
        val requiredResult: U64 = (try self.staticRequirementResultType(resolution: resolution))
        if requiredResult != 0U64 { return <Result.Ok value=self.typeInfoOfRef(ref: requiredResult) />}
        val callee: U64 = self.unaryOperatorCallee(receiverRef: receiver, op: op)
        if callee < self.arena.functionCount() {
            val function = self.arena.functionAt(index: callee)
            val result = function.retTy
            if result != 0U64 {
                val witness = (try self.methodReceiverEnvironment(f: function, instRef: receiver))
                return <Result.Ok value=self.typeInfoOfRef(ref: (try self.groundWitnessTypeTerm(ref: result, params: <PatternBindInput.Function range=function.typeParams />, matchResult: witness))) />
            }
        }
        return <Result.Ok value=<TypeInfo kind=0 nameStart=0U64 nameLen=0U64 ref=0U64 /> />
    }

    // Declaration-time generic operators use the bound proof, never a
    // currently-visible concrete witness.  In particular `T: Add[T,
    // Output=I64]` gives `a + b` the semantic term I64 even though T has no
    // concrete implementation while its body is checked.
    inout fn staticBinaryOperatorResultRef(lhs: U64, op: I64) -> Result[U64, CompileDiagnostic] {
        if !(isBinTraitOp(op: op)) || self.cur.checkFn >= self.arena.functionCount() { return <Result.Ok value=0U64 />}
        val receiverRef: U64 = (try self.inferType(id: lhs))
        if receiverRef == 0U64 { return <Result.Ok value=0U64 />}
        val resolution: StaticMemberResolution = (try self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverRef, traitName: self.binOpTraitName(op: op), memberName: binTraitMethodName(op: op), arity: 2U64, traitArity: 1U64))
        return <Result.Ok value=(try self.staticRequirementResultType(resolution: resolution)) />
    }

    // The result type of a binary operator `a OP b` (spec/12). For an arithmetic/bitwise
    // operator whose left operand's type declares `type Output = X` on the matching
    // operator trait (`Output != Self`, e.g. `Point - Point -> Vector`), return X;
    // otherwise the operands' shared type.
    // An operator result is its declared `Output`, not a continuation of the
    // receiver's source view.  `#Ext` selects members on the operand only; a
    // newly produced value is bare unless its declared result type says
    // otherwise.
    inout fn bareOperatorResult(t: TypeInfo) -> TypeInfo {
        if t.ref != 0U64 {
            return self.typeInfoOfRef(ref: self.runtimeTypeRef(ref: t.ref))
        }
        return <TypeInfo kind=t.kind nameStart=t.nameStart nameLen=t.nameLen ref=0 />
    }

    inout fn operatorTypeRef(t: TypeInfo) -> U64 {
        if t.ref != 0U64 { return self.runtimeTypeRef(ref: t.ref) }
        if t.nameLen == 0U64 { return 0U64 }
        return self.simpleTypeRef(nameStart: t.nameStart, nameLen: t.nameLen)
    }

    inout fn operatorOutputType(lt: TypeInfo, rt: TypeInfo, op: I64) -> Result[TypeInfo, CompileDiagnostic] {
        if !(isBinTraitOp(op: op)) {
            return <Result.Ok value=self.bareOperatorResult(t: lt) />
        }
        if lt.nameLen == 0U64 {
            return <Result.Ok value=self.bareOperatorResult(t: lt) />
        }
        val trN: Bind = self.internBytes(s: binTraitName(op: op))
        val leftRef: U64 = self.operatorTypeRef(t: lt)
        val rightRef: U64 = self.operatorTypeRef(t: rt)
        if leftRef == 0U64 || rightRef == 0U64 {
            return <Result.Ok value=self.bareOperatorResult(t: lt) />
        }
        mut val requestedArgs: Array[U64] = []
        requestedArgs.append(rightRef)
        mut val i: U64 = 0
        while i < self.decls.assocBindings.count() {
            val ab: AssocBinding = self.decls.assocBindings[i]
            if ab.traitId == trN.nameId {
                if ab.nameId != 0U64 && rangeEquals(bytes: self.arena.bytes, start: ab.nameStart, len: ab.nameLen, kw: "Output") {
                    val witness = (try self.conformancePatternWitnessMatch(conformIdx: 0U64, subjectId: ab.recvId, subjectTy: ab.subjectTy, subjectArgs: <PatternTypeInput.Conformance range=ab.subjectArgs />, typeParams: <PatternBindInput.Conformance range=ab.typeParams />, declaredTraitArgs: <PatternTypeInput.Conformance range=ab.traitArgs />, typeRef: leftRef, traitArgs: <PatternTypeInput.Values values=requestedArgs />))
                    if witness.conformIdx != 0U64 {
                        if ab.ty != 0U64 && ab.ty < self.arena.typeCount() {
                            val output = (try self.groundWitnessTypeTerm(ref: ab.ty, params: <PatternBindInput.Conformance range=ab.typeParams />, matchResult: witness))
                            return <Result.Ok value=self.typeInfoOfRef(ref: self.runtimeTypeRef(ref: output)) />
                        }
                        return <Result.Ok value=self.bareOperatorResult(t: self.typeInfoOfName(start: ab.tyStart, len: ab.tyLen, isArray: ab.tyIsArray)) />
                    }
                }
            }
            i += 1
        }
        return <Result.Ok value=self.bareOperatorResult(t: lt) />
    }

    // The result type of a binary: the operands share a type, so use whichever side
    // carries one (a struct/String/array result or a typed scalar), else the other
    // operand. Lets a chained `0 - big - 1` recover I32 from `big` not the untyped `0`.
    inout fn binResultTypeInfo(lhs: U64, rhs: U64, op: I64) -> Result[TypeInfo, CompileDiagnostic] {
        return <Result.Ok value=(try self.binResultTypeInfoWithChainHole(lhs: lhs, rhs: rhs, op: op, chainHoleRef: 0U64)) />
    }

    inout fn binResultTypeInfoWithChainHole(lhs: U64, rhs: U64, op: I64, chainHoleRef: U64) -> Result[TypeInfo, CompileDiagnostic] {
        val staticResult: U64 = (try self.staticBinaryOperatorResultRef(lhs: lhs, op: op))
        if staticResult != 0U64 { return <Result.Ok value=self.typeInfoOfRef(ref: staticResult) />}
        mut val lt: TypeInfo = (try self.exprTypeWithChainHole(id: lhs, chainHoleRef: chainHoleRef))
        val rt: TypeInfo = (try self.exprTypeWithChainHole(id: rhs, chainHoleRef: chainHoleRef))
        if lt.kind != 0 {
            return <Result.Ok value=(try self.operatorOutputType(lt: lt, rt: rt, op: op)) />
        }
        if lt.nameLen > 0 {
            return <Result.Ok value=(try self.operatorOutputType(lt: lt, rt: rt, op: op)) />
        }
        return <Result.Ok value=(try self.operatorOutputType(lt: rt, rt: lt, op: op)) />
    }
}
