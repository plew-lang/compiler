// Part of name/type resolution (root: Frontend): binary / unary operator
// output-type inference, as `impl Comp` methods. `pub` during the methodization
// transition so still-free-function callers (Resolve/ExprType) can reach them.

pub impl Comp {
    // The spelling indexes candidates; the Core trait declaration and full
    // receiver pattern authorize them. Unary and binary syntax use the same
    // selection rules, including extension visibility and ambiguity.
    inout fn operatorCalleeForRef(receiverRef: U64, traitOwner: U64, name: String, arity: U64, rhsRef: U64 = 0U64, rhsUntyped: Bool = false) -> Result[U64, CompileDiagnostic] {
        if receiverRef == 0U64 || receiverRef >= self.arena.typeCount() || traitOwner == 0U64 { return <Result.Ok value=self.arena.functionCount() /> }
        val nameId = self.internBytes(s: name).nameId
        mut val selected = self.arena.functionCount()
        mut val selectedRank = 0U64
        mut val ambiguous = false
        mut val index = self.arena.firstFunctionNamed(nameId: nameId)
        while index < self.arena.functionCount() {
            val function = self.arena.functionAt(index: index)
            if function.isAssoc && function.params.count() == arity && function.originTraitOwner == traitOwner && self.proofSourceIsActive(baseRef: receiverRef, extId: function.extId) {
                val implementationReceiver = self.canonicalBodyReceiverRef(fnIdx: index, recvInstRef: receiverRef)
                val witness = try self.methodReceiverEnvironment(f: function, instRef: implementationReceiver)
                if witness.conformIdx != 0U64 {
                    mut val matches = arity == 1U64
                    mut val rank = if function.extId == 0U64 { give 1U64 } else { give 3U64 }
                    if arity == 2U64 {
                        val parameter = self.funcParamAt(params: function.params, index: 1U64)
                        val rhs = try self.groundWitnessTypeTerm(ref: parameter.ty, params: <PatternBindInput.Function range=function.typeParams />, matchResult: witness)
                        matches = rhsRef != 0U64 && self.typeRefEq(a: rhs, b: rhsRef)
                        if rhsUntyped {
                            matches = true
                            val rhsType = self.arena.typeTerms[rhs]
                            if self.isIntType(start: rhsType.nameStart, len: rhsType.nameLen) { rank += 1U64 }
                        }
                    }
                    if matches {
                        if selected == self.arena.functionCount() || rank > selectedRank {
                            selected = index
                            selectedRank = rank
                            ambiguous = false
                        } else if rank == selectedRank { ambiguous = true }
                    }
                }
            }
            index = self.arena.nextFunctionNamed(index: index)
        }
        if ambiguous {
            if rhsUntyped && (selectedRank == 2U64 || selectedRank == 4U64) {
                return <Result.Err error=self.diagnosticAt(offset: self.arena.typeTerms[receiverRef].nameStart, msg: "ambiguous operator: the right operand matches more than one integer overload — add a suffix to the literal (e.g. `10I64`)") />
            }
            return <Result.Err error=self.diagnosticAt(offset: self.arena.typeTerms[receiverRef].nameStart, msg: "ambiguous operator: more than one implementation matches the operands; select a view or add a literal suffix (spec/12)") />
        }
        return <Result.Ok value=selected />
    }

    inout fn findBinTraitWitnessForRef(receiverRef: U64, op: I64, rhsRef: U64, rhsUntyped: Bool) -> Result[U64, CompileDiagnostic] {
        val comparison = op == opLt() || op == opLe() || op == opGt() || op == opGe()
        val equality = op == opEq() || op == opNe()
        val traitName = if equality { give "Eq" } else if comparison { give "Ord" } else { give self.binOpTraitName(op: op) }
        val name = if equality { give "eq" } else if comparison { give "compare" } else { give binTraitMethodName(op: op) }
        val traitArity = if equality || comparison { give 0U64 } else { give 1U64 }
        return self.operatorCalleeForRef(receiverRef: receiverRef, traitOwner: self.coreTraitOwner(name: traitName, arity: traitArity), name: name, arity: 2U64, rhsRef: rhsRef, rhsUntyped: rhsUntyped)
    }

    inout fn unaryOperatorCallee(receiverRef: U64, op: I64) -> Result[U64, CompileDiagnostic] {
        return self.operatorCalleeForRef(receiverRef: receiverRef, traitOwner: self.coreTraitOwner(name: self.unOpTraitName(op: op)), name: unaryMethodName(op: op), arity: 1U64)
    }

    inout fn unaryOperatorResultType(operand: TypeInfo, op: I64) -> Result[TypeInfo, CompileDiagnostic] {
        val receiver: U64 = self.operatorTypeRef(t: operand)
        if receiver == 0U64 { return <Result.Ok value=operand />}
        val resolution: StaticMemberResolution = (try self.staticOperatorTemplateResolution(op: op, receiverTerm: receiver, isUnary: true))
        val requiredResult: U64 = (try self.staticRequirementResultType(resolution: resolution))
        if requiredResult != 0U64 { return <Result.Ok value=self.typeInfoOfRef(ref: requiredResult) />}
        val callee: U64 = try self.unaryOperatorCallee(receiverRef: receiver, op: op)
        return self.operatorCalleeResultType(callee: callee, receiverRef: receiver)
    }

    // Parameter and result types use the environment of the selected
    // declaration. Associated bindings are not independently searched by name.
    inout fn operatorCalleeType(callee: U64, receiverRef: U64, term: U64) -> Result[U64, CompileDiagnostic] {
        val function = self.arena.functionAt(index: callee)
        val implementationReceiver = self.canonicalBodyReceiverRef(fnIdx: callee, recvInstRef: receiverRef)
        val witness = try self.methodReceiverEnvironment(f: function, instRef: implementationReceiver)
        return self.groundWitnessTypeTerm(ref: term, params: <PatternBindInput.Function range=function.typeParams />, matchResult: witness)
    }

    inout fn operatorCalleeResultType(callee: U64, receiverRef: U64) -> Result[TypeInfo, CompileDiagnostic] {
        if callee < self.arena.functionCount() {
            val result = self.arena.functionAt(index: callee).retTy
            if result != 0U64 {
                return <Result.Ok value=self.typeInfoOfRef(ref: (try self.operatorCalleeType(callee: callee, receiverRef: receiverRef, term: result))) />
            }
        }
        return <Result.Ok value=<TypeInfo kind=0 nameStart=0U64 nameLen=0U64 ref=0U64 /> />
    }

    // Declaration-time generic operators use the bound proof, never a
    // currently-visible concrete witness.  In particular `T: Add[T,
    // Output=I64]` gives `a + b` the semantic term I64 even though T has no
    // concrete implementation while its body is checked.
    inout fn staticBinaryOperatorResultRef(lhs: U64, op: I64) -> Result[U64, CompileDiagnostic] {
        if !(isBinTraitOp(op: op)) || self.cur.checkFn >= self.arena.functionCount() { return <Result.Ok value=0U64 />}
        val receiverRef: U64 = (try self.inferType(id: lhs))
        if receiverRef == 0U64 { return <Result.Ok value=0U64 />}
        val resolution: StaticMemberResolution = (try self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverRef, traitName: self.binOpTraitName(op: op), memberName: binTraitMethodName(op: op), arity: 2U64, traitArity: 1U64))
        return <Result.Ok value=(try self.staticRequirementResultType(resolution: resolution)) />
    }

    // The result type of a binary operator `a OP b` (spec/12). For an arithmetic/bitwise
    // operator whose left operand's type declares `type Output = X` on the matching
    // operator trait (`Output != Self`, e.g. `Point - Point -> Vector`), return X;
    // otherwise the operands' shared type.
    // An operator result is its declared `Output`, not a continuation of the
    // receiver's source view.  `#Ext` selects members on the operand only; a
    // newly produced value is bare unless its declared result type says
    // otherwise.
    inout fn bareOperatorResult(t: TypeInfo) -> TypeInfo {
        if t.ref != 0U64 {
            return self.typeInfoOfRef(ref: self.runtimeTypeRef(ref: t.ref))
        }
        return <TypeInfo kind=t.kind nameStart=t.nameStart nameLen=t.nameLen ref=0 />
    }

    inout fn operatorTypeRef(t: TypeInfo) -> U64 {
        if t.ref != 0U64 { return t.ref }
        if t.nameLen == 0U64 { return 0U64 }
        return self.simpleTypeRef(nameStart: t.nameStart, nameLen: t.nameLen)
    }

    inout fn operatorOutputType(lt: TypeInfo, rt: TypeInfo, op: I64) -> Result[TypeInfo, CompileDiagnostic] {
        if !(isBinTraitOp(op: op)) {
            return <Result.Ok value=self.bareOperatorResult(t: lt) />
        }
        if lt.nameLen == 0U64 {
            return <Result.Ok value=self.bareOperatorResult(t: lt) />
        }
        val leftRef = self.operatorTypeRef(t: lt)
        val rightRef = self.operatorTypeRef(t: rt)
        if leftRef == 0U64 { return <Result.Ok value=self.bareOperatorResult(t: lt) /> }
        val callee = try self.findBinTraitWitnessForRef(receiverRef: leftRef, op: op, rhsRef: rightRef, rhsUntyped: rightRef == 0U64)
        return self.operatorCalleeResultType(callee: callee, receiverRef: leftRef)
    }

    // The result type of a binary: the operands share a type, so use whichever side
    // carries one (a struct/String/array result or a typed scalar), else the other
    // operand. Lets a chained `0 - big - 1` recover I32 from `big` not the untyped `0`.
    inout fn binResultTypeInfo(lhs: U64, rhs: U64, op: I64) -> Result[TypeInfo, CompileDiagnostic] {
        return <Result.Ok value=(try self.binResultTypeInfoWithChainHole(lhs: lhs, rhs: rhs, op: op, chainHoleRef: 0U64)) />
    }

    inout fn binResultTypeInfoWithChainHole(lhs: U64, rhs: U64, op: I64, chainHoleRef: U64) -> Result[TypeInfo, CompileDiagnostic] {
        val staticResult: U64 = (try self.staticBinaryOperatorResultRef(lhs: lhs, op: op))
        if staticResult != 0U64 { return <Result.Ok value=self.typeInfoOfRef(ref: staticResult) />}
        mut val lt: TypeInfo = (try self.exprTypeWithChainHole(id: lhs, chainHoleRef: chainHoleRef))
        val rt: TypeInfo = (try self.exprTypeWithChainHole(id: rhs, chainHoleRef: chainHoleRef))
        if lt.kind != 0 {
            return <Result.Ok value=(try self.operatorOutputType(lt: lt, rt: rt, op: op)) />
        }
        if lt.nameLen > 0 {
            return <Result.Ok value=(try self.operatorOutputType(lt: lt, rt: rt, op: op)) />
        }
        return <Result.Ok value=(try self.operatorOutputType(lt: rt, rt: lt, op: op)) />
    }
}
