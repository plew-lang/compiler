// Part of name/type resolution (root: _.pw): local scopes and field /
// method / construct visibility checks.

pub impl Comp {
    inout fn addLocal(nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool, owned: Bool) {
        self.addLocalCn(nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: isArray, ty: ty, isInout: isInout, isMut: isMut, owned: owned, cnum: 0)
    }

    inout fn addLocalCn(nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool, owned: Bool, cnum: U64, isGlobal: Bool = false) {
        self.cur.locals.append(<Local isGlobal=isGlobal nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) isArray=isArray ty=ty isInout=isInout isMut=isMut owned=owned moved=false cnum=cnum />)
    }

    // A let binding owns one semantic TypeTerm.  For an annotation that is the
    // written type resolved in this declaration environment; without one it
    // is the already-recorded initializer term.
    // Keep this construction shared by Record and generic-body validation: an
    // unannotated `val it = self` in a provided trait method must remain
    // abstract `Self`, rather than degrading to a name-shaped fallback during
    // the later checker walk.
    inout fn addLetLocal(nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64, mutable: Bool, owned: Bool) -> Result[(), CompileDiagnostic] {
        val inferred: LetEff = (try self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init))
        // An annotation can contain abstract associated types below a nominal
        // constructor. Store Array[Self#Iterator.Item], not the unresolved
        // Array[Item] spelling that could alias an unrelated nominal Item.
        mut val term: U64 = (try self.groundTypeRef(ref: inferred.ty))
        if ty == 0U64 {
            val initializerTerm: U64 = self.parametricExprTerm(exprId: init)
            if initializerTerm != 0U64 { term = initializerTerm }
        }
        self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: inferred.start, tyLen: inferred.len, isArray: inferred.arr, ty: term, isInout: false, isMut: mutable, owned: owned)
        return <Result.Ok value=() />
    }

    inout fn scopeMark() -> U64 {
        return self.cur.locals.count()
    }

    inout fn popLocals(mark: U64) {
        mut val kept: Array[Local] = []
        mut val i: U64 = 0
        while i < mark {
            kept.append(self.cur.locals[i])
            i += 1
        }
        self.cur.locals = kept
        // Move facts use local slots as keys. Discard facts for departing
        // bindings before a sibling scope can reuse those slots.
        if self.cur.verifyMovedIdx.count() != 0U64 {
            self.verifyDropMovedAbove(mark: mark)
        }
    }

    inout fn localIsMutable(start: U64, len: U64) -> Bool {
        if self.isSelfRef(start: start, len: len) {
            // `self` is assignable only through an `inout fn` receiver.
            return self.cur.selfInout
        }
        val index = self.localIndexByName(start: start, len: len)
        if index < self.cur.locals.count() {
            val local = self.cur.locals[index]
            return local.isMut || local.isInout
        }
        return true
    }

    inout fn isSelfRef(start: U64, len: U64) -> Bool {
        if self.cur.hasRecv {
            return rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "self")
        }
        return false
    }


    // Whether an assignment-target identifier names a binding at all: `self` (an
    // inout receiver is replaceable), a closure capture, or a local / parameter /
    // resolved global declaration installed by localIndexByName. A name
    // that is none of these is undeclared — a fn or type name is not a place.
    inout fn identIsBinding(start: U64, len: U64) -> Bool {
        if self.isSelfRef(start: start, len: len) {
            return true
        }
        return self.localIndexByName(start: start, len: len) < self.cur.locals.count()
    }

    inout fn localIndexByName(start: U64, len: U64) -> U64 {
        val qualified = self.modules.qualifiedUseIndex(offset: start) < self.modules.qualifiedUseCount()
        val qId = intern(c: inout self, start: start, len: len)
        mut val index = self.cur.locals.count()
        if !qualified {
            while index > 0U64 {
                index -= 1U64
                val local = self.cur.locals[index]
                if !local.isGlobal && local.nameId == qId { return index }
            }
        }
        val globalIndex = self.globalIndexAtUse(start: start, len: len)
        if globalIndex >= self.arena.globals.count() { return self.cur.locals.count() }
        val global = self.arena.globals[globalIndex]
        index = 0U64
        while index < self.cur.locals.count() {
            val local = self.cur.locals[index]
            if local.isGlobal && local.nameStart == global.nameStart { return index }
            index += 1U64
        }
        // A declaration slot is not a new lexical binding. A later bare name
        // still resolves through its own module/import provenance.
        match self.arena.stmts[global.letStmt] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, init: _) => {
                self.cur.locals.append(<Local isGlobal=true globalTypePending=true nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) tyStart=tyStart tyLen=tyLen isArray=tyIsArray ty=ty isInout=false isMut=mutable owned=false moved=false cnum=0U64 />)
            }
            _ => {}
        }
        return index
    }

    // Shadowing cliff (spec/03): a new binding's initializer is checked in the old
    // environment, but at commit the previous owned `unique` binding with the same
    // name stops being an accessible owner. Mark only such locals moved; copyable
    // shadows remain ordinary locals until scope exit, and global declarations / borrow
    // params are not owned by this scope.
    inout fn markShadowedUniqueMoved(nameStart: U64, nameLen: U64) {
        val idx: U64 = self.localIndexByName(start: nameStart, len: nameLen)
        if idx >= self.cur.locals.count() {
            return
        }
        val lo: Local = self.cur.locals[idx]
        if !(lo.owned) {
            return
        }
        if lo.moved {
            return
        }
        if self.arena.typeTermIsUnique(ref: lo.ty) {
            self.verifyMarkMoved(idx: idx)
        }
    }

    // Result `Optional[U]` of a NON-rewritten `?.` on an Optional base (the fallback
    // path — a Chain base goes through chainResultRef). U = the type of the trailing
    // chain `cont` with the ChainHole bound to the Optional's payload T.
    inout fn optChainResultRef(base: U64, cont: U64) -> Result[U64, CompileDiagnostic] {
        val bt: TypeInfo = (try self.typeOf(id: base))
        if bt.kind != 2 {
            return <Result.Ok value=0 />
        }
        if bt.ref >= self.arena.typeCount() {
            return <Result.Ok value=0 />
        }
        val ot: TypeRef = self.arena.typeAt(index: bt.ref)
        if !(rangeEquals(bytes: self.arena.bytes, start: ot.nameStart, len: ot.nameLen, kw: "Optional")) {
            return <Result.Ok value=0 />
        }
        if ot.args.count() < 1 {
            return <Result.Ok value=0 />
        }
        val uInfo: TypeInfo = (try self.exprTypeWithChainHole(id: cont, chainHoleRef: ot.args[0]))
        mut val uRef: U64 = uInfo.ref
        if uRef == 0 {
            val noArgs: Array[U64] = []
            uRef = self.pushType(t: <TypeRef nameStart=uInfo.nameStart nameLen=uInfo.nameLen args=noArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        }
        mut val args: Array[U64] = []
        args.append(uRef)
        return <Result.Ok value=self.pushType(t: <TypeRef nameStart=ot.nameStart nameLen=ot.nameLen args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] />) />
    }

    inout fn fieldDeclaredMut(receiverRef: U64, fieldStart: U64, fieldLen: U64) -> Bool {
        val storage = self.fieldStorageTypeRef(receiverRef: receiverRef)
        if storage == 0U64 || storage >= self.arena.typeCount() { return true }
        mut val declaration = self.structIndexForType(ref: storage)
        if self.arena.typeTerms[storage].isRecord { declaration = self.recordStructIndex(ref: storage) }
        if declaration >= self.arena.structCount() { return true }
        val field = self.fieldIndexOfReceiver(receiverRef: storage, fieldStart: fieldStart, fieldLen: fieldLen)
        if field >= self.arena.structAt(index: declaration).fields.count() { return true }
        return self.arena.structFieldAt(structIndex: declaration, fieldIndex: field).isMut
    }

    inout fn fieldVis(structIndex: U64, fieldStart: U64, fieldLen: U64) -> U64 {
        if structIndex >= self.arena.structCount() { return 3U64 }
        val qField = intern(c: inout self, start: fieldStart, len: fieldLen)
        val fields = self.arena.structAt(index: structIndex).fields
        mut val index = 0U64
        while index < fields.count() {
            if fields[index].nameId == qField { return fields[index].vis }
            index += 1U64
        }
        return 3U64
    }

    inout fn typeHasMethodNamed(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = self.arena.firstFunctionNamed(nameId: qName)
        while i < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: i)
            if f.hasRecv {
                if f.nameId == qName {
                    if f.recvId == qRecv {
                        return true
                    }
                }
            }
            i = self.arena.nextFunctionNamed(index: i)
        }
        return false
    }

    inout fn inTypeDefinitionModule(ownerRef: U64, offset: U64) -> Bool {
        val index = self.structIndexForType(ref: ownerRef)
        if index >= self.arena.structCount() { return false }
        return self.moduleOf(offset: self.arena.structAt(index: index).nameStart) == self.moduleOf(offset: offset)
    }

    inout fn checkFieldReadVis(ownerRef: U64, fieldStart: U64, fieldLen: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val v: U64 = self.fieldVis(structIndex: self.structIndexForType(ref: ownerRef), fieldStart: fieldStart, fieldLen: fieldLen)
        if v == 0U64 {
            if !(self.inTypeDefinitionModule(ownerRef: ownerRef, offset: offset)) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "field is private (visible only in its defining module)") />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn checkFieldWriteVis(ownerRef: U64, fieldStart: U64, fieldLen: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        val v: U64 = self.fieldVis(structIndex: self.structIndexForType(ref: ownerRef), fieldStart: fieldStart, fieldLen: fieldLen)
        if v == 0U64 {
            if !(self.inTypeDefinitionModule(ownerRef: ownerRef, offset: offset)) {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "field is private (writable only in its defining module)") />
            }
        } else {
            if v == 1U64 {
                if !(self.inTypeDefinitionModule(ownerRef: ownerRef, offset: offset)) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "field is `pub(get)` — readable but writable only in its defining module") />
                }
            }
        }
        return <Result.Ok value=() />
    }

    inout fn checkMethodVis(ownerStart: U64, ownerLen: U64, mf: Func, offset: U64) -> Result[(), CompileDiagnostic] {
        if mf.isPub { return <Result.Ok value=() /> }
        // Provided bodies retain the module that authored the declaration;
        // conformance instantiation must not grant the caller new access.
        mut val ownerModule = self.moduleOf(offset: mf.defOffset)
        if mf.isProvided && mf.providedOwnerMod != 4000000000U64 {
            ownerModule = mf.providedOwnerMod
        } else if mf.provTraitOwner != 0U64 {
            ownerModule = self.traitModuleByOwner(owner: mf.provTraitOwner)
        } else if mf.defOffset == 0U64 {
            ownerModule = self.typeDefinitionModule(ref: mf.recvTy)
        }
        if ownerModule == self.typeDeclModuleMissing() || ownerModule != self.moduleOf(offset: offset) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "method is private (callable only in its defining module; put it in a `pub impl`)") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkConstructVis(typeRef: U64, isEnum: Bool, fields: MakeFieldRange, offset: U64) -> Result[(), CompileDiagnostic] {
        if isEnum { return <Result.Ok value=() /> }
        val sidx = self.structIndexForType(ref: typeRef)
        if sidx >= self.arena.structCount() { return <Result.Ok value=() /> }
        val sd: StructDef = self.arena.structAt(index: sidx)
        if sd.isExtern || sd.isStructuralLayout {
            return <Result.Ok value=() />
        }
        // Construction authority is independent of field read/write authority.
        // The default factory is always available in its declaration module;
        // explicitly publishing it exposes every field as an input parameter.
        if self.moduleOf(offset: sd.nameStart) != self.moduleOf(offset: offset) && !(self.structHasPubFactory(structIndex: sidx)) {
            mut val index: U64 = 0
            while index < fields.len {
                val field = self.makeFieldAt(fields: fields, index: index)
                if field.requiresFactoryAccess() {
                    return <Result.Err error=self.diagnosticAt(offset: field.offset, msg: "construction outside the defining module requires a public factory (`pub impl Type { factory }`)") />
                }
                index += 1U64
            }
            if fields.len == 0U64 {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "construction outside the defining module requires a public factory (`pub impl Type { factory }`)") />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn structHasPubFactory(structIndex: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.decls.pubFactoryTypes.count() {
            if self.structIndexForType(ref: self.decls.pubFactoryTypes[i]) == structIndex {
                return true
            }
            i += 1U64
        }
        return false
    }

    inout fn exprIsPlace(id: U64) -> Bool {
        // Nested indexing is lowered into nested synthetic Index.index calls.
        // Each candidate restores one authored Index place; recurse before
        // inspecting shape so an outer candidate does not leave its inner
        // candidate looking like a temporary.
        val materialized: U64 = self.materializablePlace(id: id)
        if materialized != id { return self.exprIsPlace(id: materialized) }
        match self.arena.exprs[id] {
            Expr.Ident(start: _, len: _) => { return true }
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.exprIsPlace(id: base) }
            Expr.Index(val base, index: _) => { return self.exprIsPlace(id: base) }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Deref(base: _) => { return true }
            // A cast or source view changes neither storage nor mutability
            // capability.  Treating `place#Ext` as a temporary made a valid
            // mutating call through an indexed/view-selected element fail
            // before the backend could take that element's address.
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { return self.exprIsPlace(id: operand) }
            Expr.ExtView(val recv, source: _, strip: _) => { return self.exprIsPlace(id: recv) }
            _ => { return false }
        }
    }

    // Lower represents an indexed read as a synthetic Index.index call, but
    // retains the original storage path in AccessCandidate.  This is not a
    // second lookup: it only recovers the Lower-published place so checking
    // can accept a later selected `inout` use which Mid will materialize and
    // write back through that exact candidate.
    fn materializablePlace(id: U64) -> U64 {
        return self.decls.placeSource(exprId: id)
    }

    inout fn placeIsMutable(id: U64) -> Result[Bool, CompileDiagnostic] {
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Ident(val start, val len) => {
                return <Result.Ok value=self.localIsMutable(start: start, len: len) />
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val bt: TypeInfo = (try self.typeOf(id: base))
                if bt.kind == 2 {
                    if self.fieldDeclaredMut(receiverRef: self.typedIrRefOfInfo(ti: bt), fieldStart: nameStart, fieldLen: nameLen) {
                        return <Result.Ok value=(try self.placeIsMutable(id: base)) />
                    }
                    return <Result.Ok value=false />
                }
                return <Result.Ok value=(try self.placeIsMutable(id: base)) />
            }
            Expr.Index(val base, val index) => {
                return <Result.Ok value=(try self.placeIsMutable(id: base)) />
            }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => {
                return <Result.Ok value=(try self.placeIsMutable(id: operand)) />
            }
            Expr.ExtView(val recv, source: _, strip: _) => {
                return <Result.Ok value=(try self.placeIsMutable(id: recv)) />
            }
            Expr.Deref(val base) => {
                return <Result.Ok value=self.isMutableRefInst(ref: (try self.typeOf(id: base)).ref) />
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // A MutableRef's pointee is writable through a `val` MutableRef BINDING — the
                // exception waives only the binding's val/mut (sharing is the MutableRef's
                // purpose), NOT the pointee field's own mutability. A `Ref` is read-only.
                val bt: TypeInfo = (try self.typeOf(id: base))
                if self.isMutableRefInst(ref: bt.ref) {
                    val inst: TypeRef = self.arena.typeAt(index: bt.ref)
                    val pt: TypeInfo = self.typeInfoOfRef(ref: inst.args[0])
                    if pt.kind == 2 {
                        return <Result.Ok value=self.fieldDeclaredMut(receiverRef: inst.args[0], fieldStart: nameStart, fieldLen: nameLen) />
                    }
                    return <Result.Ok value=true />
                }
                if self.isRefInst(ref: bt.ref) {
                    return <Result.Ok value=false />
                }
                return <Result.Ok value=true />
            }
            _ => { return <Result.Ok value=true />}
        }
    }
}
