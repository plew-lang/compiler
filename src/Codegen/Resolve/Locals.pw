// Part of name/type resolution (root: _.pw): local scopes and field /
// method / construct visibility checks.

pub impl Comp {
    inout fn addLocal(nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool, owned: Bool) {
        self.addLocalCn(nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: isArray, ty: ty, isInout: isInout, isMut: isMut, owned: owned, cnum: 0)
    }

    inout fn addLocalCn(nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool, owned: Bool, cnum: U64) {
        self.cur.locals.append(<Local nameStart=nameStart nameLen=nameLen nameId=intern(c: inout self, start: nameStart, len: nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout self, start: tyStart, len: tyLen) isArray=isArray ty=ty isInout=isInout isMut=isMut owned=owned moved=false cnum=cnum />)
    }

    // The "seed every global" sentinel for `seedGlobalLocals`: used when the referencing
    // function has no reliable module offset (a method / assoc fn — its `nameStart` is
    // re-interned to module 0), so gating would risk hiding a same-module global. Free
    // functions get their real module and are gated; methods stay conservative (their own
    // module's globals remain visible — the narrow residual is a method reading another
    // module's private global, which needs a real per-Func decl offset to close).
    inout fn globalSeedModeFor(f: Func) -> U64 {
        if f.hasRecv || f.isAssoc {
            return 4000000000U64
        }
        return self.moduleOf(offset: f.nameStart)
    }

    // Is a top-level global defined in module `gMod` with name `(nameStart,nameLen)` visible
    // from module `useMod` (spec/15)? Same module, or `export`ed by its own module and brought
    // in by a `with { }` import that reaches that module directly or through a re-exporting
    // barrel. Without this a non-`export` global was readable from any module (an ambient leak).
    inout fn globalVisibleFrom(useMod: U64, gMod: U64, nameStart: U64, nameLen: U64) -> Bool {
        if gMod == useMod {
            return true
        }
        if self.isExportedName(nameStart: nameStart, nameLen: nameLen) {
            if self.isImportedInto(mod: useMod, nameStart: nameStart, nameLen: nameLen) {
                if self.hasImportEdge(useMod: useMod, targetMod: gMod) {
                    return true
                }
                if self.importsBarrelForwarding(useMod: useMod, srcMod: gMod) {
                    return true
                }
            }
        }
        return false
    }

    // Seed the globals visible from `useMod` as locals so identifiers in a function body
    // resolve (spec/15). `useMod == 4_000_000_000` (the sentinel from `globalSeedModeFor`)
    // seeds every global (conservative, for a function with no reliable module). A global's
    // own module is `moduleOf` of its initializer offset (a real source offset — its name is
    // re-interned, so `nameStart` cannot serve `moduleOf`).
    inout fn seedGlobalLocals(useMod: U64) {
        mut val gi: U64 = 0
        while gi < self.arena.globals.count() {
            match self.arena.stmts[self.arena.globals[gi].letStmt] {
                Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                    mut val visible: Bool = useMod == 4000000000U64
                    if !visible {
                        val gMod: U64 = self.moduleOf(offset: self.exprOffset(id: init))
                        visible = self.globalVisibleFrom(useMod: useMod, gMod: gMod, nameStart: nameStart, nameLen: nameLen)
                    }
                    if visible {
                        val le: LetEff = self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
                        self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: false)
                    }
                }
                _ => {}
            }
            gi += 1
        }
    }

    inout fn scopeMark() -> U64 {
        return self.cur.locals.count()
    }

    inout fn popLocals(mark: U64) {
        mut val kept: Array[Local] = []
        mut val i: U64 = 0
        while i < mark {
            kept.append(self.cur.locals[i])
            i += 1
        }
        self.cur.locals = kept
    }

    inout fn localIsMutable(start: U64, len: U64) -> Bool {
        if self.isSelfRef(start: start, len: len) {
            // `self` is assignable only through an `inout fn` receiver.
            return self.cur.selfInout
        }
        // inside a closure, a capture is assignable only if it is a boxed (`mut val`)
        // reference capture; a by-value (`val`) capture is immutable.
        if self.cur.inClosure {
            if self.isCaptureOf(closureId: self.cur.closureId, start: start, len: len) {
                return self.isBoxedCaptureOf(closureId: self.cur.closureId, start: start, len: len)
            }
        }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = self.cur.locals.count()
        while i > 0 {
            i -= 1
            val lo: Local = self.cur.locals[i]
            if lo.nameId == qId {
                if lo.isMut {
                    return true
                }
                return lo.isInout
            }
        }
        return true
    }

    inout fn isSelfRef(start: U64, len: U64) -> Bool {
        if self.cur.hasRecv {
            return rangeEquals(bytes: self.arena.bytes, start: start, len: len, kw: "self")
        }
        return false
    }

    inout fn typeIsUnique(start: U64, len: U64) -> Bool {
        // a newtype over a unique type is itself unique (spec/10: uniqueness propagates —
        // else the newtype could be copied to dodge the underlying's single-ownership and
        // break resource safety). Resolve to the underlying before the struct lookup.
        val ntu: Bind = self.newtypeUnderName(start: start, len: len)
        mut val rStart: U64 = start
        mut val rLen: U64 = len
        if ntu.nameStart != start || ntu.nameLen != len {
            rStart = ntu.nameStart
            rLen = ntu.nameLen
        }
        val si: U64 = self.structIndexByName(start: rStart, len: rLen)
        if si >= self.arena.structs.count() {
            return false
        }
        return self.arena.structs[si].isUnique
    }

    inout fn localIndexByName(start: U64, len: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = self.cur.locals.count()
        while i > 0 {
            i -= 1
            val lo: Local = self.cur.locals[i]
            if lo.nameId == qId {
                return i
            }
        }
        return self.cur.locals.count()
    }

    inout fn optChainResultRef(base: U64, memberStart: U64, memberLen: U64) -> U64 {
        val bt: TypeInfo = self.typeOf(id: base)
        if bt.kind != 2 {
            return 0
        }
        if bt.ref >= self.arena.types.count() {
            return 0
        }
        val ot: TypeRef = self.arena.types[bt.ref]
        if !(rangeEquals(bytes: self.arena.bytes, start: ot.nameStart, len: ot.nameLen, kw: "Optional")) {
            return 0
        }
        if ot.args.count() < 1 {
            return 0
        }
        val tInfo: TypeInfo = self.typeInfoOfRef(ref: ot.args[0])
        val uInfo: TypeInfo = self.fieldType(structStart: tInfo.nameStart, structLen: tInfo.nameLen, fieldStart: memberStart, fieldLen: memberLen)
        mut val uRef: U64 = uInfo.ref
        if uRef == 0 {
            val noArgs: Array[U64] = []
            uRef = self.pushType(t: <TypeRef nameStart=uInfo.nameStart nameLen=uInfo.nameLen args=noArgs />)
        }
        mut val args: Array[U64] = []
        args.append(uRef)
        return self.pushType(t: <TypeRef nameStart=ot.nameStart nameLen=ot.nameLen args=args />)
    }

    inout fn fieldType(structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
        // resolve an import alias (`with { Real as Alias }`) so a field access on a value
        // typed by its alias finds the real struct's fields (spec/15).
        val arS: Bind = self.aliasReal(start: structStart, len: structLen)
        mut val qStruct: U64 = intern(c: inout self, start: arS.nameStart, len: arS.nameLen)
        // a newtype inherits the underlying struct's fields (spec/10): resolve to the
        // underlying so `<Brand code=… />` / `brand.code` finds Rgb's `code` (Brand = Rgb).
        mut val ntI: U64 = 0
        while ntI < self.arena.newtypes.count() {
            if self.arena.newtypes[ntI].nameId == qStruct {
                qStruct = intern(c: inout self, start: self.arena.newtypes[ntI].underStart, len: self.arena.newtypes[ntI].underLen)
                ntI = self.arena.newtypes.count()
            } else {
                ntI += 1
            }
        }
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val s: StructDef = self.arena.structs[si]
            if s.nameId == qStruct {
                val fs: Array[FieldDef] = s.fields
                mut val fi: U64 = 0
                while fi < fs.count() {
                    val f: FieldDef = fs[fi]
                    if f.nameId == qField {
                        // a generic-instantiation field type (`Optional[Node]`) carries its
                        // structured ref, so a match/dispatch on the field recovers the
                        // mangled C name (`Optional_Node`) and substitutes payload types.
                        if !(f.tyIsArray) {
                            if self.isGenericInst(ref: f.ty) {
                                return <TypeInfo kind=2 nameStart=f.tyStart nameLen=f.tyLen ref=f.ty />
                            }
                            // an existential (`inner: any Drawable`) or view-typed
                            // (`p: P#Ext`) field: the ref IS the identity facet
                            // (spec/08,09) — name-only recovery would drop it and a
                            // method on the field couldn't dispatch through it.
                            if f.ty != 0U64 && f.ty < self.arena.types.count() {
                                if self.arena.types[f.ty].isAny || self.arena.types[f.ty].viewExtId != 0U64 {
                                    return self.typeInfoOfRef(ref: f.ty)
                                }
                            }
                        }
                        return self.typeInfoOfName(start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                    }
                    fi += 1
                }
            }
            si += 1
        }
        return scalarInfo()
    }

    inout fn fieldDeclaredMut(structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> Bool {
        val qStruct: U64 = intern(c: inout self, start: structStart, len: structLen)
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val s: StructDef = self.arena.structs[si]
            if s.nameId == qStruct {
                val fs: Array[FieldDef] = s.fields
                mut val fi: U64 = 0
                while fi < fs.count() {
                    val f: FieldDef = fs[fi]
                    if f.nameId == qField {
                        return f.isMut
                    }
                    fi += 1
                }
            }
            si += 1
        }
        return true
    }

    inout fn fieldVis(structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> U64 {
        val qStruct: U64 = intern(c: inout self, start: structStart, len: structLen)
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val s: StructDef = self.arena.structs[si]
            if s.nameId == qStruct {
                val fs: Array[FieldDef] = s.fields
                mut val fi: U64 = 0
                while fi < fs.count() {
                    val f: FieldDef = fs[fi]
                    if f.nameId == qField {
                        return f.vis
                    }
                    fi += 1
                }
            }
            si += 1
        }
        return 3U64
    }

    inout fn typeHasMethodNamed(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.nameId == qName {
                    if f.recvId == qRecv {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn inAnonImplOf(ownerStart: U64, ownerLen: U64) -> Bool {
        if self.cur.hasRecv {
            return spansEqual(c: inout self, aStart: self.cur.recvStart, aLen: self.cur.recvLen, bStart: ownerStart, bLen: ownerLen)
        }
        if self.cur.recvStart != 0 {
            return spansEqual(c: inout self, aStart: self.cur.recvStart, aLen: self.cur.recvLen, bStart: ownerStart, bLen: ownerLen)
        }
        return false
    }

    inout fn checkFieldReadVis(ownerStart: U64, ownerLen: U64, fieldStart: U64, fieldLen: U64, offset: U64) {
        val v: U64 = self.fieldVis(structStart: ownerStart, structLen: ownerLen, fieldStart: fieldStart, fieldLen: fieldLen)
        if v == 0U64 {
            if !(self.inAnonImplOf(ownerStart: ownerStart, ownerLen: ownerLen)) {
                self.errorAt(offset: offset, msg: "field is private (visible only in its type's anonymous impl)")
            }
        }
    }

    inout fn checkFieldWriteVis(ownerStart: U64, ownerLen: U64, fieldStart: U64, fieldLen: U64, offset: U64) {
        val v: U64 = self.fieldVis(structStart: ownerStart, structLen: ownerLen, fieldStart: fieldStart, fieldLen: fieldLen)
        if v == 0U64 {
            if !(self.inAnonImplOf(ownerStart: ownerStart, ownerLen: ownerLen)) {
                self.errorAt(offset: offset, msg: "field is private (writable only in its type's anonymous impl)")
            }
        } else {
            if v == 1U64 {
                if !(self.inAnonImplOf(ownerStart: ownerStart, ownerLen: ownerLen)) {
                    self.errorAt(offset: offset, msg: "field is `pub(get)` — readable but writable only in its type's anonymous impl")
                }
            }
        }
    }

    inout fn checkMethodVis(ownerStart: U64, ownerLen: U64, mf: Func, offset: U64) {
        if !(mf.isPub) {
            if !(self.inAnonImplOf(ownerStart: ownerStart, ownerLen: ownerLen)) {
                self.errorAt(offset: offset, msg: "method is private (callable only in its type's anonymous impl; put it in a `pub impl`)")
            }
        }
    }

    inout fn checkConstructVis(typeStart: U64, typeLen: U64, isEnum: Bool, fields: Array[MakeField]) {
        if isEnum {
            return
        }
        if typeLen == 0U64 {
            return
        }
        // a record's canonical name begins '(' — its fields are structurally publiself.
        if self.arena.bytes[typeStart] == '(' {
            return
        }
        mut val sidx: U64 = self.structIndexByName(start: typeStart, len: typeLen)
        if sidx >= self.arena.structs.count() {
            sidx = self.genericStructIndex(nameStart: typeStart, nameLen: typeLen)
        }
        if sidx >= self.arena.structs.count() {
            return
        }
        val sd: StructDef = self.arena.structs[sidx]
        if sd.isExtern {
            return
        }
        val defMod: U64 = self.moduleOf(offset: sd.defOffset)
        mut val i: U64 = 0
        while i < fields.count() {
            val v: U64 = self.fieldVis(structStart: typeStart, structLen: typeLen, fieldStart: fields[i].nameStart, fieldLen: fields[i].nameLen)
            if v == 0U64 || v == 1U64 {
                // gate by the field's ORIGINAL source offset (nameStart is re-interned and
                // does not map to a module); synthesized constructions carry an unloaded
                // offset (the dict literal's `keys`/… use the interned span) and are skipped.
                if self.offsetIsLoaded(offset: fields[i].offset) {
                    if self.moduleOf(offset: fields[i].offset) != defMod {
                        if v == 0U64 {
                            self.errorAt(offset: fields[i].offset, msg: "cannot set a private field when constructing from another module (the field is not `pub`)")
                        } else {
                            self.errorAt(offset: fields[i].offset, msg: "cannot set a `pub(get)` field when constructing from another module (it is read-only outside its module)")
                        }
                    }
                }
            }
            i += 1U64
        }
        // factory publication gate (spec/05): even with all fields `pub`, the default
        // memberwise factory is module-private — constructing `<T …/>` from ANOTHER module
        // requires `T` to declare a public factory (`pub impl T { factory }`). Find a
        // representative construction-site offset (a loaded field) to locate its module.
        mut val ci: U64 = 0
        while ci < fields.count() {
            if self.offsetIsLoaded(offset: fields[ci].offset) {
                if self.moduleOf(offset: fields[ci].offset) != defMod {
                    if !(self.structHasPubFactory(nameId: sd.nameId)) {
                        self.errorAt(offset: fields[ci].offset, msg: "constructing this type from another module requires it to declare a public factory (`pub impl Type { factory }`); the default memberwise factory is module-private (spec/05)")
                    }
                }
                ci = fields.count()
            } else {
                ci += 1U64
            }
        }
    }

    inout fn structHasPubFactory(nameId: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.decls.pubFactories.count() {
            if self.decls.pubFactories[i] == nameId {
                return true
            }
            i += 1U64
        }
        return false
    }

    inout fn exprIsPlace(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Ident(start: _, len: _) => { return true }
            Expr.Field(val base, nameStart: _, nameLen: _) => { return self.exprIsPlace(id: base) }
            Expr.Index(val base, index: _) => { return self.exprIsPlace(id: base) }
            Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return true }
            Expr.Deref(base: _) => { return true }
            _ => { return false }
        }
    }

    inout fn placeIsMutable(id: U64) -> Bool {
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Ident(val start, val len) => {
                return self.localIsMutable(start: start, len: len)
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val bt: TypeInfo = self.typeOf(id: base)
                if bt.kind == 2 {
                    if self.fieldDeclaredMut(structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen) {
                        return self.placeIsMutable(id: base)
                    }
                    return false
                }
                return self.placeIsMutable(id: base)
            }
            Expr.Index(val base, val index) => {
                return self.placeIsMutable(id: base)
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // A Ref's pointee is writable through a `val` Ref BINDING — the Ref exception
                // (spec/03) waives only the binding's val/mut (sharing is the Ref's purpose),
                // NOT the pointee field's own mutability. A `val` field stays immutable even
                // through a Ref, or value-semantics' val-immutability would leak away for any
                // Ref-shared type.
                val bt: TypeInfo = self.typeOf(id: base)
                if self.isRefInst(ref: bt.ref) {
                    val inst: TypeRef = self.arena.types[bt.ref]
                    val pt: TypeInfo = self.typeInfoOfRef(ref: inst.args[0])
                    if pt.kind == 2 {
                        return self.fieldDeclaredMut(structStart: pt.nameStart, structLen: pt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
                    }
                }
                return true
            }
            _ => { return true }
        }
    }
}
