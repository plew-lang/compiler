// Part of name/type resolution (root: _.pw): the main expression
// type-recovery (exprType).

// Recover an expression's type. Only the cases plewc.pw exercises on the base
// of a field/index/method are precise; everything else falls back to scalar.

pub impl Comp {

    // The declared return TypeInfo of trait `traitNameId`'s member `qName` (requirement
    // or provided method, supertraits included) — the type-recovery analog of
    // traitProvidesMember, for typing a method reached through a type parameter's
    // bounds. A bare `Self` return maps back to the PARAMETRIC receiver name
    // (tpStart/tpLen — the conformer IS the type param, so it grounds per instance); a
    // structured return mentioning `Self`/`Item` stays unknown for now (recording it
    // raw would let the ENCLOSING method's Self substitute in — a different Self).
    inout fn traitMemberRetInfo(traitNameId: U64, traitArity: U64, qName: U64, args: Array[Arg], tpStart: U64, tpLen: U64, depth: U64, useMod: U64) -> TypeInfo {
        if depth > 64U64 {
            return scalarInfo()
        }
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            val t: TraitDef = self.decls.traits[ti]
            if t.nameId == traitNameId && self.traitArityMatches(actual: t.typeParams.count(), expected: traitArity) {
                val concreteArity: U64 = t.typeParams.count()
                mut val ri: U64 = 0
                while ri < t.reqs.count() {
                    val r: Func = t.reqs[ri]
                    if r.nameId == qName {
                        if self.paramsLabelsOk(params: r.params, args: args) {
                            return self.boundRetInfoOf(f: r, tpStart: tpStart, tpLen: tpLen)
                        }
                    }
                    ri += 1
                }
                mut val sti: U64 = 0
                while sti < t.supertraits.count() {
                    val sup: Bind = t.supertraits[sti]
                    val supId: U64 = intern(c: inout self, start: sup.nameStart, len: sup.nameLen)
                    val sr: TypeInfo = self.traitMemberRetInfo(traitNameId: supId, traitArity: 4000000000U64, qName: qName, args: args, tpStart: tpStart, tpLen: tpLen, depth: depth + 1U64, useMod: useMod)
                    if sr.nameLen != 0U64 {
                        return sr
                    }
                    sti += 1
                }
                val includePrivateProvided: Bool = useMod == self.traitModuleByIdArity(traitId: traitNameId, arity: concreteArity)
                mut val gi: U64 = 0
                while gi < self.arena.funcs.count() {
                    val g: Func = self.arena.funcs[gi]
                    if g.hasRecv && g.recvId == traitNameId && g.provTraitArity == concreteArity && g.nameId == qName {
                        if includePrivateProvided || g.isPub {
                            if self.paramsLabelsOk(params: g.params, args: args) {
                                return self.boundRetInfoOf(f: g, tpStart: tpStart, tpLen: tpLen)
                            }
                        }
                    }
                    gi += 1
                }
            }
            ti += 1
        }
        return scalarInfo()
    }

    // Raw declared TypeRef of struct `(structStart,structLen)`'s field `field`, or 0
    // when the struct or field is unknown (the arena field ty, pre-grounding).
    inout fn structFieldRawTyRef(structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> U64 {
        val qStruct: U64 = intern(c: inout self, start: structStart, len: structLen)
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            val s: StructDef = self.arena.structs[si]
            if s.nameId == qStruct {
                mut val fi: U64 = 0
                while fi < s.fields.count() {
                    if s.fields[fi].nameId == qField {
                        return s.fields[fi].ty
                    }
                    fi += 1
                }
            }
            si += 1
        }
        return 0
    }

    // The result TypeInfo of `recv.name(args)` when `name` is not a method but a
    // closure-typed FIELD (`struct Handler { val run: fn() -> I64 }`): the backend loads
    // the field and calls it indirectly (CallMethod's closure-field branch), so the
    // result is the fn type's return — args[0] of the {fn, [ret, p0, …]} ref. Grounded
    // through a generic receiver's env (`fn() -> T` on `Handler[I64]`). scalarInfo when
    // the name is not a closure field (the caller then keeps its unknown result).
    inout fn closureFieldRetInfo(rt: TypeInfo, nameStart: U64, nameLen: U64) -> TypeInfo {
        mut val fr: U64 = self.structFieldRawTyRef(structStart: rt.nameStart, structLen: rt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
        if fr == 0U64 {
            return scalarInfo()
        }
        if self.isGenericInst(ref: rt.ref) {
            fr = self.groundUnderInst(instRef: rt.ref, tyRef: fr)
        }
        if self.isFnType(ref: fr) {
            val ft: TypeRef = self.arena.types[fr]
            if ft.args.count() > 0U64 {
                return self.typeInfoOfRef(ref: ft.args[0])
            }
        }
        return scalarInfo()
    }

    // A declared return's TypeInfo: an `Array[E]` return prefers the STRUCTURED
    // retTy ref when it is ground — typeInfoOfName's kind-3 recovery drops the
    // element instance (ref 0), so a direct-call for-in source (`for c in mkArr()`)
    // lost `Ref[Cell]` elements and the body could not resolve `c->v`. A parametric
    // retTy (un-grounded generic) falls back to the bare name span, as before.
    inout fn declaredRetInfo(f: Func) -> TypeInfo {
        if f.retIsArray && f.retTy != 0U64 && f.retTy < self.arena.types.count() {
            if self.tyRefIsGround(ref: f.retTy) {
                return self.typeInfoOfRef(ref: f.retTy)
            }
        }
        // an existential `any P` return: the isAny ref IS the type identity, so a
        // name-only recovery would degrade it to the plain trait name — a `f().m()`
        // inline dispatch on the result would then misroute to the free-fn inference
        // path instead of dynamic dispatch (spec/08).
        if f.retTy != 0U64 && f.retTy < self.arena.types.count() {
            if self.arena.types[f.retTy].isAny {
                return self.typeInfoOfRef(ref: f.retTy)
            }
        }
        return self.typeInfoOfName(start: f.retStart, len: f.retLen, isArray: f.retIsArray)
    }

    // Ground a final method callable through its receiver instance.  `a.m()` and
    // `a#Source.m()` have already converged to the same `Func`; they must therefore
    // derive `T` in `impl[T] Box[T]` from the same receiver TypeRef as well.  Keeping
    // this here (rather than in either syntax arm) makes source qualification a pure
    // selection concern, never a second generic-inference mechanism.
    inout fn groundFinalMethodReturn(f: Func, recvTy: TypeInfo, args: Array[Arg]) -> U64 {
        // Declaration-time result typing must accept a symbolic generic
        // receiver (`Box[T_outer]`) as well as a concrete one (`Box[I64]`).
        // The receiver's argument terms still provide the complete mapping to
        // the selected method/impl binders; only an absent TypeRef is invalid.
        if f.retTy == 0U64 || recvTy.ref == 0U64 || recvTy.ref >= self.arena.types.count() {
            return 0U64
        }
        // A method's generic binder list can contain the nominal declaration
        // binder, an impl receiver-pattern binder, and method-owned binders.
        // They are lexical identities, not positional aliases. Match the
        // selected receiver against the declared pattern once and use that
        // directional substitution for the return term (the same operation
        // conformance proofs use).
        val receiverMatch: WitnessMatch = self.methodReceiverEnvironment(f: f, instRef: recvTy.ref)
        if receiverMatch.conformIdx == 0U64 { return 0U64 }
        mut val fullArgs: Array[U64] = []
        mut val fi: U64 = 0U64
        while fi < f.typeParams.count() {
            fullArgs.append(0U64)
            fi += 1U64
        }
        mut val bi: U64 = 0U64
        while bi < receiverMatch.binds.count() {
            val binding: WitnessBind = receiverMatch.binds[bi]
            mut val target: U64 = f.typeParams.count()
            if binding.paramId != 0U64 {
                mut val pi: U64 = 0U64
                while pi < f.typeParams.count() {
                    if f.typeParams[pi].paramId == binding.paramId {
                        target = pi
                        break
                    }
                    pi += 1U64
                }
            }
            if target >= fullArgs.count() { target = binding.binder }
            if target < fullArgs.count() {
                fullArgs.set(i: target, value: binding.term)
            }
            bi += 1U64
        }
        // Fill only binders the receiver pattern did not determine. Those are
        // method-owned generic parameters and may be inferred from arguments.
        val inferred: Array[U64] = self.inferFnArgs(f: f, args: args)
        fi = 0U64
        while fi < inferred.count() && fi < fullArgs.count() {
            if fullArgs[fi] == 0U64 { fullArgs.set(i: fi, value: inferred[fi]) }
            fi += 1U64
        }
        // This is a declaration-time semantic query as well as a concrete
        // codegen query.  A receiver such as `Box[T_outer]` supplies a fully
        // resolved *symbolic* argument for the method's `T_impl`; requiring a
        // concrete term here discards that relation and makes `?.read()` lose
        // its outer T.  Only an absent inference slot is incomplete.
        if fullArgs.count() != f.typeParams.count() || !(self.fnArgsAllResolved(args: fullArgs)) {
            return 0U64
        }
        // Preserve ParamId identity in the result. The legacy Cursor grounding
        // path can use spelling fallback while translating a method binder;
        // an immutable map cannot, so the returned outer `T` remains the
        // caller's lexical term for later BodyInstance grounding.
        val environment: InstanceEnvironment = <InstanceEnvironment params=f.typeParams args=fullArgs receiverRef=recvTy.ref />
        val grounded: U64 = self.groundTermForBody(ref: f.retTy, environment: environment, selfRef: recvTy.ref, itemRef: 0U64)
        if grounded != 0U64 {
            return grounded
        }
        return 0U64
    }

    // `fnArgsAllGround` is intentionally stricter: Mono may only enqueue a
    // concrete code-generation instance.  Frontend result typing instead
    // needs a complete substitution that is allowed to retain enclosing
    // ParamId terms until that enclosing body is instantiated.
    inout fn fnArgsAllResolved(args: Array[U64]) -> Bool {
        if args.count() == 0U64 { return false }
        mut val i: U64 = 0U64
        while i < args.count() {
            if args[i] == 0U64 { return false }
            i += 1U64
        }
        return true
    }

    // The non-generic receiver half of the same final-callable calculation.  `Self`
    // and `Item` are receiver-relative even when the receiver itself has no type
    // arguments; method-owned parameters are inferred from the call arguments.
    inout fn groundConcreteFinalMethodReturn(f: Func, recvTy: TypeInfo, args: Array[Arg]) -> U64 {
        if f.retTy == 0U64 || recvTy.nameLen == 0U64 || self.isGenericInst(ref: recvTy.ref) {
            return 0U64
        }
        val inferred: Array[U64] = self.inferFnArgs(f: f, args: args)
        if f.typeParams.count() > 0U64 {
            if inferred.count() != f.typeParams.count() || !(self.fnArgsAllGround(args: inferred)) {
                return 0U64
            }
        }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        val savedSelf: U64 = self.cur.selfRef
        val savedItem: U64 = self.cur.itemRef
        self.setSelfItemEnv(recvStart: recvTy.nameStart, recvLen: recvTy.nameLen, recvInstRef: 0U64)
        self.cur.typeParams = f.typeParams
        self.cur.typeArgs = inferred
        val grounded: U64 = self.groundTypeRef(ref: f.retTy)
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        self.cur.selfRef = savedSelf
        self.cur.itemRef = savedItem
        if grounded != 0U64 && self.tyRefIsGround(ref: grounded) {
            return grounded
        }
        return 0U64
    }

    inout fn boundRetInfoOf(f: Func, tpStart: U64, tpLen: U64) -> TypeInfo {
        if !(f.hasRet) {
            return scalarInfo()
        }
        if !(f.retIsArray) {
            if rangeEquals(bytes: self.arena.bytes, start: f.retStart, len: f.retLen, kw: "Self") {
                return <TypeInfo kind=2 nameStart=tpStart nameLen=tpLen ref=0 />
            }
        }
        // a structured return (`Optional[Self]`, an `Item`-mentioning combinator) is
        // left unknown: its inner Self/Item belong to the BOUND trait, not the
        // enclosing method's env, so recording the raw ref would mis-ground.
        if self.isGenericInst(ref: f.retTy) {
            return scalarInfo()
        }
        return self.typeInfoOfName(start: f.retStart, len: f.retLen, isArray: f.retIsArray)
    }

    // The return TypeInfo of `value.name(args)` where `value: T` and T is a bound type
    // parameter of `fnIdx` — rustc-style bound-based method typing: search each of T's
    // bound traits for the member and take its declared return.
    inout fn boundMethodRetInfo(fnIdx: U64, tpStart: U64, tpLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> TypeInfo {
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qTp: U64 = intern(c: inout self, start: tpStart, len: tpLen)
        mut val bi: U64 = 0
        while bi < self.decls.funcBounds.count() {
            val fb: FuncBound = self.decls.funcBounds[bi]
            if fb.fnIdx == fnIdx && fb.paramNameId == qTp {
                val owner: U64 = fb.constraint.key.owner
                val qTrait: U64 = intern(c: inout self, start: owner, len: self.traitNameLenByOwner(owner: owner))
                val r: TypeInfo = self.traitMemberRetInfo(traitNameId: qTrait, traitArity: fb.constraint.key.positionalArgs.count(), qName: qName, args: args, tpStart: tpStart, tpLen: tpLen, depth: 0U64, useMod: self.moduleOf(offset: nameStart))
                if r.nameLen != 0U64 {
                    return r
                }
            }
            bi += 1
        }
        return scalarInfo()
    }

    // The result type of trait member `req` called through the existential `anyRef`
    // (spec/08): `any P[I32]` binds P's type parameters positionally, `any
    // P[Item=I64]` binds a type parameter or associated type by label, and `Self`
    // re-erases to the existential itself — so the declared return grounds to a
    // concrete type under that env. Unknown (scalarInfo) when the grounded form
    // still mentions an unbound name — never record a half-ground type.
    inout fn anyMemberRetInfo(anyRef: U64, req: Func) -> TypeInfo {
        if !(req.hasRet) || req.retTy == 0U64 {
            return scalarInfo()
        }
        val t: TypeRef = self.arena.types[anyRef]
        val tri: U64 = self.findTraitIdxByName(start: t.nameStart, len: t.nameLen)
        if tri >= self.decls.traits.count() {
            return scalarInfo()
        }
        val tr: TraitDef = self.decls.traits[tri]
        mut val tp: Array[Bind] = []
        mut val ta: Array[U64] = []
        mut val pos: U64 = 0
        mut val ai: U64 = 0
        while ai < t.args.count() {
            mut val lbl: U64 = 0
            if ai < t.argLabels.count() {
                lbl = t.argLabels[ai]
            }
            if lbl == 0U64 {
                if pos < tr.typeParams.count() {
                    tp.append(tr.typeParams[pos])
                    ta.append(t.args[ai])
                    pos += 1
                }
            } else {
                mut val k: U64 = 0
                while k < tr.typeParams.count() {
                    if tr.typeParams[k].nameId == lbl {
                        tp.append(tr.typeParams[k])
                        ta.append(t.args[ai])
                    }
                    k += 1
                }
                k = 0
                while k < tr.assocTypes.count() {
                    if tr.assocTypes[k].nameId == lbl {
                        tp.append(tr.assocTypes[k])
                        ta.append(t.args[ai])
                    }
                    k += 1
                }
            }
            ai += 1
        }
        val savedP: Array[Bind] = self.cur.typeParams
        val savedA: Array[U64] = self.cur.typeArgs
        val savedS: U64 = self.cur.selfRef
        self.cur.typeParams = tp
        self.cur.typeArgs = ta
        self.cur.selfRef = anyRef
        val g: U64 = self.groundTypeRef(ref: req.retTy)
        self.cur.typeParams = savedP
        self.cur.typeArgs = savedA
        self.cur.selfRef = savedS
        if g != 0U64 && self.tyRefIsGround(ref: g) {
            return self.typeInfoOfRef(ref: g)
        }
        return scalarInfo()
    }

    // The context-free expression query. An optional-chain continuation uses
    // the explicit variant below: its root ChainHole is a structural input from
    // the preceding chain stage, never ambient mutable Cursor state.
    inout fn exprType(id: U64) -> TypeInfo {
        return self.exprTypeWithChainHole(id: id, chainHoleRef: 0U64)
    }

    // Type `id` with the one structural input an OptChain continuation owns.
    // A continuation AST has exactly one parent stage, so this is not a general
    // context cache: the parent supplies its parametric Value term and recursive
    // children receive that same input explicitly.
    inout fn exprTypeWithChainHole(id: U64, chainHoleRef: U64) -> TypeInfo {
        val e: Expr = self.arena.exprs[id]
        match e {
            Expr.Int(value: _, offset: _, val isBool, val tyStart, val tyLen, isNeg: _) => {
                // a `true`/`false` literal is `Bool`: recover a "Bool" span so a generic
                // call like `print(true)` infers T = Bool.
                if isBool {
                    val b: Bind = self.kwSpan(kw: "Bool", kwLen: 4)
                    if b.nameLen != 0 {
                        return <TypeInfo kind=0 nameStart=b.nameStart nameLen=b.nameLen ref=0 />
                    }
                }
                // a suffixed literal (`5U64`) carries its own type; otherwise the
                // type comes from context and is recovered elsewhere.
                if tyLen != 0 {
                    return self.typeInfoOfName(start: tyStart, len: tyLen, isArray: false)
                }
                return scalarInfo()
            }
            Expr.Float(start: _, len: _, val tyStart, val tyLen) => {
                // a float literal is F64 (or its explicit F32/F64 suffix). Reported as a
                // named type (kind 2) so it isn't confused with the int/String categories.
                if tyLen != 0 {
                    return <TypeInfo kind=2 nameStart=tyStart nameLen=tyLen ref=0 />
                }
                val fb: Bind = self.kwSpan(kw: "F64", kwLen: 3)
                return <TypeInfo kind=2 nameStart=fb.nameStart nameLen=fb.nameLen ref=0 />
            }
            Expr.Str(val start, val len) => {
                // carry the "String" name span so tyRefOfInfo can recover a String
                // TypeRef — a generic call `print("hi")` then infers T = String (without
                // the name, a string-literal argument left T uninferred -> no instance).
                val ss: Bind = self.stringTypeSpan()
                return <TypeInfo kind=2 nameStart=ss.nameStart nameLen=ss.nameLen ref=0 />
            }
            Expr.Ident(val start, val len) => {
                if self.isSelfRef(start: start, len: len) {
                    // the grounded Self instance ref. At backend emission `cur.recvInstRef` is
                    // NOT set (it drives front-end mono only); the per-instance Self is carried
                    // in `cur.selfRef` (setSelfItemEnv / emitOneGenMethod), so a `self` inside a
                    // provided or adapter method reports the CONCRETE instance
                    // (`SkipIter[Counter,I64]`), not the base receiver. Prefer selfRef, then the
                    // front-end recvInstRef, then the declared receiver name. (The typeOf cache
                    // gate excludes selfRef!=0 so this instance-specific answer is never cached.)
                    mut val sref: U64 = self.cur.selfRef
                    if sref == 0U64 {
                        sref = self.cur.recvInstRef
                    }
                    if sref != 0U64 {
                        val rt: TypeRef = self.arena.types[sref]
                        // self inside an `impl Array[T]` method types as an array (kind 3,
                        // element name) so the array/raw intrinsics dispatch on it.
                        if rangeEquals(bytes: self.arena.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Array") {
                            if rt.args.count() == 1 {
                                val en: Bind = self.arrayElemNameForRef(elemRef: rt.args[0])
                                return <TypeInfo kind=3 nameStart=en.nameStart nameLen=en.nameLen ref=sref />
                            }
                        }
                        return <TypeInfo kind=2 nameStart=rt.nameStart nameLen=rt.nameLen ref=sref />
                    }
                    return self.typeInfoOfName(start: self.cur.recvStart, len: self.cur.recvLen, isArray: false)
                }
                // inside a closure body a captured name is not a local; recover its
                // type from the capture entry (so field/index dispatch on it works).
                if self.cur.inClosure {
                    mut val ci: U64 = 0
                    while ci < self.monoWork.captures.count() {
                        val ce: CaptureEntry = self.monoWork.captures[ci]
                        if ce.closureId == self.cur.closureId {
                            if spansEqual(c: inout self, aStart: ce.nameStart, aLen: ce.nameLen, bStart: start, bLen: len) {
                                if self.isStrongRefInst(ref: ce.ty) || self.isWeakRefLikeInst(ref: ce.ty) {
                                    val rt2: TypeRef = self.arena.types[ce.ty]
                                    return <TypeInfo kind=2 nameStart=rt2.nameStart nameLen=rt2.nameLen ref=ce.ty />
                                }
                                return self.typeInfoOfName(start: ce.tyStart, len: ce.tyLen, isArray: ce.isArray)
                            }
                        }
                        ci += 1
                    }
                }
                val qLocal: U64 = intern(c: inout self, start: start, len: len)
                mut val i: U64 = self.cur.locals.count()
                while i > 0 {
                    i -= 1
                    val lo: Local = self.cur.locals[i]
                    if lo.nameId == qLocal {
                        // an array local stays kind 3 (element by name) even though
                        // `Array[E]` is now a genInst struct — all the array-special
                        // codegen (index/for/.count()/methods/value-semantics) keys off
                        // kind 3, so it must not be reported as a kind-2 instantiation.
                        if lo.isArray {
                            // carry the full `Array[E]` ref (lo.ty) alongside the kind-3 element-name
                            // view so tyRefOfInfo recovers the structured ref (the typed-IR store
                            // needs `Array[U8]`, not a ref-less kind-3 that projects to 0). The kind
                            // and element name are unchanged, so existing kind-3 consumers are
                            // unaffected; only ref goes from 0 to the declared array instance.
                            val ab: TypeInfo = self.typeInfoOfName(start: lo.tyStart, len: lo.tyLen, isArray: true)
                            return <TypeInfo kind=3 nameStart=ab.nameStart nameLen=ab.nameLen ref=lo.ty />
                        }
                        // Preserve every generic instance's complete TypeRef.
                        // Generic enums are not `isGenericInst` (that predicate
                        // names generic structs), yet a match payload such as
                        // `Optional[I64].Some(v)` needs its concrete enum
                        // subject to type `v` and infer `print(v)`.
                        if self.isGenericInst(ref: lo.ty) || self.isGenericEnumInst(ref: lo.ty) {
                            val lt: TypeRef = self.arena.types[lo.ty]
                            return <TypeInfo kind=2 nameStart=lt.nameStart nameLen=lt.nameLen ref=lo.ty />
                        }
                        // A declaration-time generic term such as
                        // `Optional[Box[T]]` is not a *concrete* generic
                        // instance, but it is still a complete semantic term.
                        // Preserve its TypeRef while recording so consumers
                        // can later substitute the lexical ParamId; reducing
                        // it to the `Optional` spelling loses every argument.
                        if lo.ty != 0U64 && lo.ty < self.arena.types.count() {
                            val declared: TypeRef = self.arena.types[lo.ty]
                            if declared.args.count() > 0U64 || declared.paramId != 0U64 {
                                return self.typeInfoOfRef(ref: lo.ty)
                            }
                        }
                        if self.isStrongRefInst(ref: lo.ty) || self.isWeakRefLikeInst(ref: lo.ty) {
                            val lt2: TypeRef = self.arena.types[lo.ty]
                            return <TypeInfo kind=2 nameStart=lt2.nameStart nameLen=lt2.nameLen ref=lo.ty />
                        }
                        // a Buffer[T] local: keep the structured ref so the floor
                        // intrinsics can recover the element type T from its argument.
                        if self.isRawBufInst(ref: lo.ty) {
                            val lt3: TypeRef = self.arena.types[lo.ty]
                            return <TypeInfo kind=2 nameStart=lt3.nameStart nameLen=lt3.nameLen ref=lo.ty />
                        }
                        // resolve a type-parameter-typed local under the active
                        // monomorphization env (so `x: T` reports as the concrete type
                        // for method dispatch inside a generic instance body).
                        if !(lo.isArray) {
                            mut val k: U64 = 0
                            while k < self.cur.typeParams.count() {
                                val tp: Bind = self.cur.typeParams[k]
                                if lo.tyNameId == tp.nameId {
                                    // A generic template is checked in a symbolic
                                    // environment: its binders are in scope, but it
                                    // deliberately has no monomorphization arguments.
                                    // Keep the declared TypeRef in that case.  Indexing
                                    // typeArgs here conflated abstract checking with a
                                    // concrete instantiation and caused the self-hosted
                                    // compiler to read past the empty argument list.
                                    if k < self.cur.typeArgs.count() {
                                        return self.typeInfoOfRef(ref: self.cur.typeArgs[k])
                                    }
                                    return <TypeInfo kind=2 nameStart=lo.tyStart nameLen=lo.tyLen ref=lo.ty />
                                }
                                k += 1
                            }
                            // a `Self`-typed local/param (an assoc fn's `lhs~: Self`)
                            // resolves through the active Self binding — parametric
                            // (`Buffer[T]`) during recording, concrete at emission.
                            if self.cur.selfRef != 0U64 {
                                if rangeEquals(bytes: self.arena.bytes, start: lo.tyStart, len: lo.tyLen, kw: "Self") {
                                    return self.typeInfoOfRef(ref: self.cur.selfRef)
                                }
                            }
                        }
                        // an `any P` local: keep the structured ref so its method calls can
                        // resolve through the trait P (the name-only form loses isAny).
                        if lo.ty != 0U64 {
                            if lo.ty < self.arena.types.count() {
                                if self.arena.types[lo.ty].isAny {
                                    return <TypeInfo kind=2 nameStart=self.arena.types[lo.ty].nameStart nameLen=self.arena.types[lo.ty].nameLen ref=lo.ty />
                                }
                                // A view-typed local/param keeps its declared ref.  The
                                // source set is a static type facet: reducing it to a name-only
                                // TypeInfo here would make `T#E#F` bare only in ordinary `.`
                                // syntax.  `viewExtId` is the legacy one-source spelling;
                                // `viewIds` is the multi-source normal form.
                                if self.arena.types[lo.ty].viewExtId != 0U64 || self.arena.types[lo.ty].viewIds.count() > 0U64 {
                                    val vb: TypeInfo = self.typeInfoOfName(start: lo.tyStart, len: lo.tyLen, isArray: lo.isArray)
                                    return <TypeInfo kind=vb.kind nameStart=vb.nameStart nameLen=vb.nameLen ref=lo.ty viewExtId=self.arena.types[lo.ty].viewExtId />
                                }
                            }
                        }
                        // A declared local always has a complete semantic type
                        // term, including the ordinary monomorphic `S` case.
                        // Returning only its head spelling made a later
                        // `s#Trait` reconstruct the receiver from text and
                        // lose both declaration identity and conformance
                        // evidence.  Keep TypeInfo's legacy kind/name view,
                        // but carry the exact TypeRef as the sole semantic
                        // receiver input for view/proof/call resolution.
                        val declared: TypeInfo = self.typeInfoOfName(start: lo.tyStart, len: lo.tyLen, isArray: lo.isArray)
                        return <TypeInfo kind=declared.kind nameStart=declared.nameStart nameLen=declared.nameLen ref=lo.ty viewExtId=declared.viewExtId />
                    }
                }
                return scalarInfo()
            }
            Expr.Unary(val op, val operand) => {
                // A struct operand is a trait-dispatched unary (Neg/Not/BitNot); its
                // result is the trait's Output, which for standard operators is Self.
                val ot: TypeInfo = self.exprTypeWithChainHole(id: operand, chainHoleRef: chainHoleRef)
                if ot.kind == 2 { return ot }
                // `-` / `~` preserve the operand's width; `!` is Bool (width-less).
                if op == opSub() { return ot }
                if op == opBitNot() { return ot }
                return scalarInfo()
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                // Arithmetic (56-60) and bitwise/shift (74-78) take the operands' shared
                // type; comparisons (50-55) and logical (61,62) are Bool. Recover from
                // whichever operand carries a type — `0 - big` (lhs is an untyped literal)
                // is I32 from `big`, so a chained `0 - big - 1` propagates the width
                // instead of reporting it as type-less. Comparisons fall to scalar Bool.
                if op >= 56 {
                    if op <= 60 {
                        return self.binResultTypeInfoWithChainHole(lhs: lhs, rhs: rhs, op: op, chainHoleRef: chainHoleRef)
                    }
                }
                if op >= 74 {
                    if op <= 78 {
                        return self.binResultTypeInfoWithChainHole(lhs: lhs, rhs: rhs, op: op, chainHoleRef: chainHoleRef)
                    }
                }
                // comparisons (50-55) and logical `&&`/`||` (61,62) produce Bool — report
                // it precisely so a `val x: I64 = a == b` mismatch is caught (was scalarInfo,
                // i.e. type-less, which the checker treated as unknown/compatible).
                val bb: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
                if bb.nameLen != 0U64 {
                    return <TypeInfo kind=2 nameStart=bb.nameStart nameLen=bb.nameLen ref=0 />
                }
                return scalarInfo()
            }
            Expr.Call(val nameStart, val nameLen, val args) => {
                // (I/O builtins are ordinary `extern(plewIntrinsic)` declarations now,
                // so their return type comes from the resolved Func below — no special
                // cases here.)
                // `pow(base:, exp:)` (spec/12): the bare call dispatches on the base
                // argument's type to its `Pow[Exp]` conformance's `pow` assoc fn — so its
                // type is that conformance's declared return (`type Output`), resolved
                // HERE (the type authority; the backend's genPowCall mirrors the same
                // dispatch at emission). Falls through to normal overload resolution when
                // the base has no matching `pow` (a user free `pow` with other labels).
                mut val fi: U64 = self.arena.funcs.count()
                if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "pow") {
                    if args.count() == 2U64 {
                        val br: U64 = self.typedIrRefOfInfo(ti: self.exprTypeWithChainHole(id: args[0].expr, chainHoleRef: chainHoleRef))
                        if br != 0U64 {
                            val brt: TypeRef = self.arena.types[br]
                            val powN: Bind = self.kwSpan(kw: "pow", kwLen: 3U64)
                            fi = self.findAssoc(recvStart: brt.nameStart, recvLen: brt.nameLen, nameStart: powN.nameStart, nameLen: powN.nameLen, args: args)
                        }
                    }
                }
                // resolve the right overload (by labels + arg types) for its return.
                if fi >= self.arena.funcs.count() {
                    fi = self.resolvedCallee(id: id)
                }
                if fi < self.arena.funcs.count() {
                    val f: Func = self.arena.funcs[fi]
                    if f.hasRet {
                        // a generic free function: ground its declared return type under the
                        // type args inferred from THIS call, uniformly for a bare type
                        // parameter (`-> T`), a generic instance (`-> Box[T]`), AND an
                        // anonymous record (`-> (v: T)`). Records are name-encoded (no
                        // top-level args), so without grounding their `(v:T)` would be
                        // compared as an opaque name against `(v:I32)` and wrongly rejected —
                        // the same treatment named generics already get via their args.
                        if self.isGenericFreeFn(fi: fi) {
                            if !(f.retIsArray) {
                                if f.retTy < self.arena.types.count() {
                                    val inferred: Array[U64] = self.inferFnArgs(f: f, args: args)
                                    val savedP: Array[Bind] = self.cur.typeParams
                                    val savedA: Array[U64] = self.cur.typeArgs
                                    self.cur.typeParams = f.typeParams
                                    self.cur.typeArgs = inferred
                                    val gr: U64 = self.groundTypeRef(ref: f.retTy)
                                    self.cur.typeParams = savedP
                                    self.cur.typeArgs = savedA
                                    if gr != f.retTy {
                                        return self.typeInfoOfRef(ref: gr)
                                    }
                                }
                            } else {
                                // an `Array[E]` return grounds the same way (`idArr(xs: zs)
                                // -> Array[U]` types as Array[I64]), so a generic CONSUMER
                                // of the call result can infer from it — without this the
                                // parametric `Array[U]` leaks out (uninferrable at best,
                                // self-referential grounding at worst). Gated on COMPLETE
                                // inference: a partial env substitutes holes for the
                                // unfound params (see the record pass's identical gate).
                                if f.retTy != 0U64 && f.retTy < self.arena.types.count() {
                                    val ainf: Array[U64] = self.inferFnArgs(f: f, args: args)
                                    if self.fnArgsAllGround(args: ainf) {
                                        val savedAP: Array[Bind] = self.cur.typeParams
                                        val savedAA: Array[U64] = self.cur.typeArgs
                                        self.cur.typeParams = f.typeParams
                                        self.cur.typeArgs = ainf
                                        val agr: U64 = self.groundTypeRef(ref: f.retTy)
                                        self.cur.typeParams = savedAP
                                        self.cur.typeArgs = savedAA
                                        if agr != f.retTy && self.tyRefIsGround(ref: agr) {
                                            return self.typeInfoOfRef(ref: agr)
                                        }
                                    }
                                }
                            }
                        }
                        // an `Array[E]` return stays kind 3 (handled below); only a true
                        // kind-2 instantiation (`Box[I32]`, an enum) reports as a genInst.
                        if !(f.retIsArray) {
                            if self.isGenericInst(ref: f.retTy) {
                                val rtr: TypeRef = self.arena.types[f.retTy]
                                return <TypeInfo kind=2 nameStart=rtr.nameStart nameLen=rtr.nameLen ref=f.retTy />
                            }
                        }
                        return self.declaredRetInfo(f: f)
                    }
                    return scalarInfo()
                }
                // a call to a fn-typed local (a closure value): its result type is the
                // function type's return (args[0] of the `fn` TypeRef). Without this a
                // generic call like `print(closure(x))` can't recover the arg type and
                // misses its instantiation (and `val r = closure(x)` mis-infers r).
                val lvi: U64 = self.localIndexByName(start: nameStart, len: nameLen)
                if lvi < self.cur.locals.count() {
                    val lty: U64 = self.cur.locals[lvi].ty
                    if self.isFnType(ref: lty) {
                        val ftr: TypeRef = self.arena.types[lty]
                        if ftr.args.count() > 0 {
                            return self.typeInfoOfRef(ref: ftr.args[0])
                        }
                    }
                }
                return scalarInfo()
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val bt: TypeInfo = self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef)
                // (`s.bytes()`/`arr.count()` are ordinary methods now — collections.md §3-付録4 —
                // typed through method resolution, not a field branch. A bare no-paren `arr.count`
                // has no property branch: it falls to field-type lookup, which finds no `count`
                // field on Array and rejects, per "Plew has no computed properties".)
                // `buf.count()` / `buf.capacity()` are ordinary methods now (collections.md
                // §3-付録4), resolved through normal method typing below — no property branch.
                // A generic struct instantiation's field type is substituted.
                if self.isGenericInst(ref: bt.ref) {
                    return self.genericFieldTypeInfo(instRef: bt.ref, fieldStart: nameStart, fieldLen: nameLen)
                }
                if bt.kind == 2 {
                    return self.fieldType(structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
                }
                return scalarInfo()
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                // a context-less record literal (`(a: e, b: f)` lowers to a Make with NO
                // type name): the literal is self-describing — resolve its canonical
                // record struct from the field labels + field value types
                // (inferRecordMakeRef), so an unannotated binding / destructure types it
                // without an annotation or construction-site context.
                if typeLen == 0U64 {
                    if !isEnum && ty == 0U64 {
                        val rr: U64 = self.inferRecordMakeRef(fields: fields)
                        if rr != 0U64 {
                            return self.typeInfoOfRef(ref: rr)
                        }
                    }
                    return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen ref=0 />
                }
                // ground the constructed instance's ref under the active env so a generic
                // build inside a generic body (`<Box v=x />` with x: T) reports the CONCRETE
                // instance (`Box[U8]`), matching the backend — not the parametric `Box[T]`.
                mut val g: U64 = ty
                if ty != 0U64 {
                    if self.cur.typeParams.count() > 0U64 {
                        g = self.groundTypeRef(ref: ty)
                    }
                }
                if self.isGenericInst(ref: g) {
                    return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen ref=g />
                }
                return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen ref=0 />
            }
            Expr.Array(val elems) => { return scalarInfo() }
            Expr.Index(val base, val index) => {
                val bt: TypeInfo = self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef)
                if bt.kind == 3 {
                    // nested array: if the element is itself an `Array[X]`, indexing
                    // yields an array (kind 3) whose element is X — not a kind-2 value
                    // named by the mangled element name.
                    val er: U64 = self.arrayElemRef(start: bt.nameStart, len: bt.nameLen)
                    if er != 0 {
                        val rr: U64 = self.resolveTy(tyRef: er)
                        if rr < self.arena.types.count() {
                            // an `Array[any P]` element (`xs[i]` where the element is the
                            // existential): carry the isAny ref so a bare `xs[i].m()`
                            // dispatches dynamically — name-only recovery below would
                            // degrade it to the plain trait name and misroute the call.
                            if self.arena.types[rr].isAny {
                                return self.typeInfoOfRef(ref: rr)
                            }
                            val rt: TypeRef = self.arena.types[rr]
                            if rangeEquals(bytes: self.arena.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Array") {
                                if rt.args.count() > 0 {
                                    val xn: Bind = self.arrayElemNameForRef(elemRef: rt.args[0])
                                    return <TypeInfo kind=3 nameStart=xn.nameStart nameLen=xn.nameLen ref=0 />
                                }
                            }
                            // a compound element (`Ref[Cell]`, `Box[I32]`): carry its
                            // structured ref so `arr[i]->field` / a generic field access
                            // can recover the pointee/instantiation (typeInfoOfRef would
                            // drop the ref for a non-Array compound). Only for compound
                            // elements — a simple scalar element (`U8`) must stay scalar.
                            if self.isCompoundType(ref: rr) {
                                return <TypeInfo kind=2 nameStart=rt.nameStart nameLen=rt.nameLen ref=rr />
                            }
                        }
                    }
                    return self.typeInfoOfName(start: bt.nameStart, len: bt.nameLen, isArray: false)
                }
                // `dict[k]` yields the Dictionary's value type V (args[1]) — the subscript
                // desugars to `.at(key:) -> V`.
                if self.isDictionaryType(ti: bt) {
                    val dt: TypeRef = self.arena.types[bt.ref]
                    if dt.args.count() > 1 {
                        return self.typeInfoOfRef(ref: dt.args[1])
                    }
                }
                // `buf[i]` on the Buffer floor yields the element type T (args[0]) — the
                // compiler-recognised subscript (value return; see genLlvmIndex).
                if self.isBufferType(ti: bt) {
                    if bt.ref != 0 {
                        val bft: TypeRef = self.arena.types[bt.ref]
                        if bft.args.count() > 0 {
                            return self.typeInfoOfRef(ref: bft.args[0])
                        }
                    }
                }
                // a user type's `a[k]` desugars to `a.index(key:k)`; its type is the
                // `index` method's return (the Index trait's `Output`).
                if bt.kind == 2 {
                    return self.firstMethodRetType(typeStart: bt.nameStart, typeLen: bt.nameLen, name: "index")
                }
                return scalarInfo()
            }
            Expr.ExtView(val recv, val source, val strip) => {
                // `recv#Ext` refines recv's TYPE with the extension view (spec/09): the
                // view is a static facet of the type (`TypeRef.viewExtId`), steering
                // method resolution and view-aware overload selection downstream — so the
                // typed IR must carry it, not drop it for the dispatch site to re-derive.
                // `recv#!Ext` (strip) removes the view (the result type is plain).
                val bt: TypeInfo = self.exprTypeWithChainHole(id: recv, chainHoleRef: chainHoleRef)
                val br: U64 = self.typedIrRefOfInfo(ti: bt)
                if br != 0U64 {
                    val brt: TypeRef = self.arena.types[br]
                    mut val sources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: br)
                    if strip {
                        sources = []
                    } else {
                        mut val present: Bool = false
                        mut val ii: U64 = 0U64
                        while ii < sources.count() {
                            if self.semanticViewSourceEq(a: sources[ii], b: source) { present = true }
                            ii += 1U64
                        }
                        if !(present) { sources.append(source) }
                    }
                    val vr: U64 = self.typeRefWithViewSources(ref: br, sources: sources)
                    val legacy: U64 = self.arena.types[vr].viewExtId
                    return <TypeInfo kind=bt.kind nameStart=bt.nameStart nameLen=bt.nameLen ref=vr viewExtId=legacy />
                }
                return <TypeInfo kind=bt.kind nameStart=bt.nameStart nameLen=bt.nameLen ref=bt.ref viewExtId=source.surfaceId />
            }
            Expr.ExtMethod(val recv, source: _, val nameStart, val nameLen, val args) => {
                // `recv#X.name(args)` (spec/09): return type from the resolved method. A
                // NAMED prim receiver (kind 0 carrying its name: `x#Doubler.double()` on
                // I64) joins the same lookup — extensions extend prims too. A `#X` view is
                // ADDITIVE: it never hides the receiver's other views or its base surface,
                // so resolution falls through X → the receiver's remaining view chain →
                // bare (which also covers `#P` naming a trait: its witnesses/provided
                // copies live on the type and resolve bare).
                val mfi: U64 = self.resolvedCallee(id: id)
                if mfi < self.arena.funcs.count() {
                    val mf: Func = self.arena.funcs[mfi]
                    if mf.hasRet {
                        val grounded: U64 = self.groundFinalMethodReturn(f: mf, recvTy: self.exprTypeWithChainHole(id: recv, chainHoleRef: chainHoleRef), args: args)
                        if grounded != 0U64 {
                            return self.typeInfoOfRef(ref: grounded)
                        }
                        val concreteGrounded: U64 = self.groundConcreteFinalMethodReturn(f: mf, recvTy: self.exprTypeWithChainHole(id: recv, chainHoleRef: chainHoleRef), args: args)
                        if concreteGrounded != 0U64 {
                            return self.typeInfoOfRef(ref: concreteGrounded)
                        }
                        return self.declaredRetInfo(f: mf)
                    }
                }
                return scalarInfo()
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // Mono has already selected this call under the concrete body
                // instance.  Its final result is the type authority for a
                // shared generic AST (`T` may carry an S#P view); asking the
                // syntax resolver again would erase that substitution and turn
                // the same call into a bare lookup.  The descriptor key includes
                // the current body instance, so this is safe for every phase.
                val finalResult: U64 = self.bodyCalleeResultRef(exprId: id)
                val finalRecv: U64 = self.groundedBodyReceiverRef(exprId: recv)
                if finalResult != 0U64 && finalResult < self.arena.types.count() && finalRecv != 0U64 && finalRecv < self.arena.types.count() {
                    val finalRecvTy: TypeRef = self.arena.types[finalRecv]
                    // The ordinary generic return-recovery below remains the
                    // authority for an unviewed receiver. The final descriptor
                    // is required specifically when the receiver's `#` facet
                    // would otherwise be erased by shared-AST recovery.
                    if finalRecvTy.viewExtId != 0U64 || finalRecvTy.viewIds.count() != 0U64 {
                        return self.typeInfoOfRef(ref: finalResult)
                    }
                }
                // `Type.name(args)` assoc-fn call: return type from the assoc fn.
                val arn: Bind = self.assocRecvName(recv: recv)
                if arn.nameLen != 0 {
                    val afi: U64 = self.findAssoc(recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if afi == self.arena.funcs.count() {
                        return scalarInfo()
                    }
                    val af: Func = self.arena.funcs[afi]
                    if af.hasRet {
                        // a factory / Self-returning assoc fn inherited through a newtype
                        // receiver (spec/10): the result Self is the SYNTACTIC receiver
                        // (`Brand`), not the underlying the fn is declared on (`Rgb`). When
                        // the declared return names the fn's own receiver type (a Self
                        // return) and the call receiver differs (a newtype), substitute it.
                        if !(af.retIsArray) {
                            if spansEqual(c: inout self, aStart: af.retStart, aLen: af.retLen, bStart: af.recvStart, bLen: af.recvLen) {
                                if !(spansEqual(c: inout self, aStart: arn.nameStart, aLen: arn.nameLen, bStart: af.recvStart, bLen: af.recvLen)) {
                                    return self.typeInfoOfName(start: arn.nameStart, len: arn.nameLen, isArray: false)
                                }
                            }
                        }
                        // a GENERIC assoc fn / factory (`Array.overBuffer(buffer:)` on
                        // `impl[T] Array[T]`): its declared return mentions the impl's own
                        // type params, so ground it under the args INFERRED from the call
                        // (T = U8 from `buffer: Buffer[U8]`) — the template form
                        // (`Array[T]`) would mis-ground under the enclosing body's env.
                        if af.typeParams.count() > 0U64 && af.retTy != 0U64 {
                            // only a COMPLETE inference is trusted (every param bound to a
                            // real ref): grounding under a partial env (an argless factory)
                            // yields a garbage inst (`Set[<sentinel>]`) that poisons every
                            // downstream consumer. Partial -> fall through to the
                            // name-level recovery below.
                            val ainf: Array[U64] = self.inferFnArgs(f: af, args: args)
                            mut val aComplete: Bool = ainf.count() >= af.typeParams.count()
                            mut val aci: U64 = 0
                            while aci < ainf.count() {
                                if ainf[aci] == 0U64 {
                                    aComplete = false
                                }
                                aci += 1
                            }
                            if aComplete {
                                val aSavedP: Array[Bind] = self.cur.typeParams
                                val aSavedA: Array[U64] = self.cur.typeArgs
                                self.cur.typeParams = af.typeParams
                                self.cur.typeArgs = ainf
                                val agr: U64 = self.groundTypeRef(ref: af.retTy)
                                self.cur.typeParams = aSavedP
                                self.cur.typeArgs = aSavedA
                                if agr != 0U64 && self.tyRefIsGround(ref: agr) {
                                    return self.typeInfoOfRef(ref: agr)
                                }
                            }
                        }
                        return self.declaredRetInfo(f: af)
                    }
                    return scalarInfo()
                }
                mut val rt: TypeInfo = self.exprTypeWithChainHole(id: recv, chainHoleRef: chainHoleRef)
                // a newtype receiver inherits its underlying's members (spec/10):
                // resolve the name to the underlying BEFORE method lookup (`u.bytes()`
                // where `newtype UserId = String` dispatches String's `bytes`).
                if rt.nameLen > 0U64 {
                    val ntu: Bind = self.newtypeUnderName(start: rt.nameStart, len: rt.nameLen)
                    if ntu.nameStart != rt.nameStart {
                        rt = <TypeInfo kind=rt.kind nameStart=ntu.nameStart nameLen=ntu.nameLen ref=rt.ref />
                    }
                }
                // a NAMED prim receiver (kind 0 carrying its name: `n.format(…)` on U64)
                // joins the concrete-receiver path: its `impl U64 { … }` methods resolve
                // through the same findMethod table, and a prim is never a generic inst,
                // so the generic-receiver blocks are naturally inert for it.
                if rt.kind == 2 || (rt.kind == 0 && rt.nameLen > 0) {
                    // a method on a BOUND type-parameter value (`value.format()` where
                    // value: T, T: Format): the bound trait's member signature types the
                    // result (rustc-style bound-based method typing).
                    if self.isTypeParamOf(fnIdx: self.cur.checkFn, start: rt.nameStart, len: rt.nameLen) {
                        return self.boundMethodRetInfo(fnIdx: self.cur.checkFn, tpStart: rt.nameStart, tpLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    }
                    // Keep the return of a requirement selected through an
                    // assumed bound symbolic during generic-body validation.
                    // Reusing a concrete implementation's return here would
                    // prematurely instantiate a rigid type parameter.
                    if self.cur.checkFn < self.arena.funcs.count() {
                        val staticResolution: StaticMemberResolution = self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: self.inferType(id: recv), nameStart: nameStart, nameLen: nameLen, args: args)
                        match staticResolution {
                            StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                                val result: U64 = self.staticRequirementResultType(resolution: staticResolution)
                                if result != 0U64 { return self.typeInfoOfRef(ref: result) }
                                return scalarInfo()
                            }
                            _ => {}
                        }
                    }
                    // a method call on `self` (Self) in a trait provided-method body being
                    // abstract-checked: resolve the result from the trait requirement's
                    // declared return type (concrete primitive/String only, so a `Self`/
                    // associated return stays unknown). Active only when curCheckFn is the
                    // provided method (else isSelfTypeInProvided is false).
                    if self.isSelfTypeInProvided(start: rt.nameStart, len: rt.nameLen) {
                        val sTrait: U64 = intern(c: inout self, start: rt.nameStart, len: rt.nameLen)
                        val sMethod: U64 = intern(c: inout self, start: nameStart, len: nameLen)
                        val sr: TypeInfo = self.traitMemberRetInfo(traitNameId: sTrait, traitArity: self.arena.funcs[self.cur.checkFn].provTraitArity, qName: sMethod, args: args, tpStart: rt.nameStart, tpLen: rt.nameLen, depth: 0U64, useMod: self.moduleOf(offset: nameStart))
                        if sr.nameLen != 0U64 {
                            return sr
                        }
                        return scalarInfo()
                    }
                    // a method call on an `any P` existential: the receiver names the trait
                    // P, so findMethod (which resolves methods on a TYPE) misses it. The
                    // result is the requirement's declared return grounded under the
                    // existential's bindings (`any P[I32]` / `any P[Item=I64]`, Self
                    // re-erased to the existential) — anyMemberRetInfo. Unknown when the
                    // return doesn't fully ground.
                    if rt.ref != 0U64 {
                        if rt.ref < self.arena.types.count() {
                            if self.arena.types[rt.ref].isAny {
                                val qTrait: U64 = intern(c: inout self, start: rt.nameStart, len: rt.nameLen)
                                val qMethod: U64 = intern(c: inout self, start: nameStart, len: nameLen)
                                mut val ti: U64 = 0
                                while ti < self.decls.traits.count() {
                                    if self.decls.traits[ti].nameId == qTrait {
                                        val reqs: Array[Func] = self.decls.traits[ti].reqs
                                        mut val ri: U64 = 0
                                        while ri < reqs.count() {
                                            if reqs[ri].nameId == qMethod {
                                                return self.anyMemberRetInfo(anyRef: rt.ref, req: reqs[ri])
                                            }
                                            ri += 1
                                        }
                                    }
                                    ti += 1
                                }
                                return scalarInfo()
                            }
                        }
                    }
                    mut val mi: U64 = self.resolvedCallee(id: id)
                    // Generic-body verification cannot pre-fill a callee for
                    // a synthetic ChainHole receiver. The continuation carries
                    // its receiver term explicitly, so select through that
                    // term only for this missing-descriptor case; ordinary
                    // source expressions keep their already-selected cache.
                    if mi == self.arena.funcs.count() && chainHoleRef != 0U64 {
                        mi = self.resolveMethodFinalForType(recv: recv, receiverType: rt, nameStart: nameStart, nameLen: nameLen, args: args)
                    }
                    if mi == self.arena.funcs.count() {
                        // not a method — but it may be a closure-typed FIELD called
                        // indirectly (`h.run()`); recover the fn type's return.
                        return self.closureFieldRetInfo(rt: rt, nameStart: nameStart, nameLen: nameLen)
                    }
                    val mf: Func = self.arena.funcs[mi]
                    if mf.hasRet {
                        val receiverGrounded: U64 = self.groundFinalMethodReturn(f: mf, recvTy: rt, args: args)
                        if receiverGrounded != 0U64 {
                            return self.typeInfoOfRef(ref: receiverGrounded)
                        }
                        val concreteReceiverGrounded: U64 = self.groundConcreteFinalMethodReturn(f: mf, recvTy: rt, args: args)
                        if concreteReceiverGrounded != 0U64 {
                            return self.typeInfoOfRef(ref: concreteReceiverGrounded)
                        }
                        // a non-generic receiver whose method returns a generic instantiation
                        // (`Counter.next() -> Optional[I64]`): keep the full ref so the caller
                        // (a `match` scrutinee / `for` iterand) recovers the mangled
                        // `Optional_I64`, not the bare head. Ground `Self`/`Item` first so a
                        // provided combinator (`Counter.filter() -> FilterIter[Self,…,Item]`)
                        // yields `FilterIter[Counter,…,I64]`, not the literal template.
                        if self.isGenericInst(ref: mf.retTy) {
                            val g2SavedSelf: U64 = self.cur.selfRef
                            val g2SavedItem: U64 = self.cur.itemRef
                            self.setSelfItemEnv(recvStart: rt.nameStart, recvLen: rt.nameLen, recvInstRef: 0)
                            // a generic method (`Counter.map[B]`): bind its method-own type
                            // params from the call (B from the closure arg) so the return
                            // `MapIter[Self,…,B]` grounds to `MapIter[Counter,…,I64]`.
                            val savedTP: Array[Bind] = self.cur.typeParams
                            val savedTA: Array[U64] = self.cur.typeArgs
                            if mf.typeParams.count() > 0 {
                                // infer BEFORE swapping the env (see the own-param hunk
                                // below): exprType inside inferFnArgs must not see the
                                // method's typeParams paired with the enclosing typeArgs.
                                val g2inf: Array[U64] = self.inferFnArgs(f: mf, args: args)
                                self.cur.typeParams = mf.typeParams
                                self.cur.typeArgs = g2inf
                            }
                            val gr2: U64 = self.groundTypeRef(ref: mf.retTy)
                            self.cur.typeParams = savedTP
                            self.cur.typeArgs = savedTA
                            self.cur.selfRef = g2SavedSelf
                            self.cur.itemRef = g2SavedItem
                            return self.typeInfoOfRef(ref: gr2)
                        }
                        // a method with OWN type params on a non-generic receiver whose
                        // return mentions one (`upTo.fold[A](init: 0U64, …) -> A`): bind
                        // them from the call and ground. An unresolved return must stay
                        // UNKNOWN — reporting the literal param name (`A`) would record a
                        // garbage type that registers a bogus instance downstream. An
                        // ARRAY return (`-> Array[A]`) grounds through the same path: its
                        // retTy is the structured {Array, [A]} ref (Ir.pw PType note).
                        if mf.typeParams.count() > 0 && mf.retTy != 0U64 {
                            // infer BEFORE swapping the env: inferFnArgs types the call's
                            // arguments via exprType, which reads cur.typeParams/typeArgs —
                            // swapping typeParams first would pair the method's params with
                            // the ENCLOSING env's typeArgs (length mismatch = OOB).
                            val oinf: Array[U64] = self.inferFnArgs(f: mf, args: args)
                            val oSavedP: Array[Bind] = self.cur.typeParams
                            val oSavedA: Array[U64] = self.cur.typeArgs
                            self.cur.typeParams = mf.typeParams
                            self.cur.typeArgs = oinf
                            val og: U64 = self.groundTypeRef(ref: mf.retTy)
                            self.cur.typeParams = oSavedP
                            self.cur.typeArgs = oSavedA
                            if og != 0U64 && self.tyRefIsGround(ref: og) {
                                return self.typeInfoOfRef(ref: og)
                            }
                            return scalarInfo()
                        }
                        return self.declaredRetInfo(f: mf)
                    }
                    return scalarInfo()
                }
                if rt.kind == 3 {
                    // a user method on `Array[E]` (`impl[T] Array[T] { … }`): resolve via
                    // the "Array" receiver, then GROUND the declared return under the
                    // receiver's element (T = E, plus any method-own params inferred from
                    // the call) — mirroring the generic-struct receiver arm above. The old
                    // bare-`T`-only substitution left every COMPOUND return
                    // (`pop() -> Optional[T]`) as the raw template span: the recorded
                    // typed-IR slot was unusable, so a discarded or un-annotated result
                    // was never classified for release (its deinit silently skipped).
                    val arrName: Bind = self.kwSpan(kw: "Array", kwLen: 5)
                    val mi: U64 = self.findMethod(recvStart: arrName.nameStart, recvLen: arrName.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if mi == self.arena.funcs.count() {
                        return scalarInfo()
                    }
                    val mf: Func = self.arena.funcs[mi]
                    if mf.hasRet {
                        // an ARRAY return (`-> Array[T]`) grounds through the same
                        // structured path — its retTy is the {Array, [T]} ref.
                        if mf.typeParams.count() >= 1 && mf.retTy != 0U64 {
                            // the element ref E — only the STRUCTURED ref off the carried
                            // `Array[E]` grounds (a compound element's registered name is a
                            // mangle — `Entry_K_V` — and grounding through a name-minted ref
                            // would record a garbage instance); a ref-less receiver falls to
                            // the bare-`T` name substitution below, as before.
                            mut val elemRef: U64 = 0
                            if rt.ref != 0U64 && rt.ref < self.arena.types.count() {
                                val art: TypeRef = self.arena.types[rt.ref]
                                if art.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: art.nameStart, len: art.nameLen, kw: "Array") {
                                    elemRef = art.args[0]
                                }
                            }
                            if elemRef != 0U64 {
                                mut val aargs: Array[U64] = []
                                aargs.append(elemRef)
                                if mf.typeParams.count() > 1U64 {
                                    // method-own params beyond the impl's T, from the call
                                    // (infer BEFORE swapping the env — inferFnArgs types the
                                    // arguments via exprType under the CURRENT env).
                                    val ainf: Array[U64] = self.inferFnArgs(f: mf, args: args)
                                    mut val ak: U64 = 1
                                    while ak < ainf.count() {
                                        aargs.append(ainf[ak])
                                        ak += 1
                                    }
                                }
                                // an honest env (no inference hole) substitutes
                                // unconditionally, like the generic-struct receiver arm —
                                // a PARAMETRIC element (`Entry[K,V]` inside the template
                                // body) legitimately yields a parametric result that the
                                // typed-IR store grounds per instance at emission.
                                mut val envOk: Bool = true
                                mut val ac: U64 = 0
                                while ac < aargs.count() {
                                    if aargs[ac] == 0U64 {
                                        envOk = false
                                    }
                                    ac += 1
                                }
                                if envOk {
                                    val aSavedP: Array[Bind] = self.cur.typeParams
                                    val aSavedA: Array[U64] = self.cur.typeArgs
                                    self.cur.typeParams = mf.typeParams
                                    self.cur.typeArgs = aargs
                                    val agr: U64 = self.groundTypeRef(ref: mf.retTy)
                                    self.cur.typeParams = aSavedP
                                    self.cur.typeArgs = aSavedA
                                    if agr != 0U64 {
                                        return self.typeInfoOfRef(ref: agr)
                                    }
                                }
                                // an inference hole: a bare-`T` return still substitutes the
                                // structured element ref (the pre-grounding behavior).
                                if mf.retTy < self.arena.types.count() {
                                    if self.arena.types[mf.retTy].nameId == mf.typeParams[0].nameId {
                                        return self.typeInfoOfRef(ref: elemRef)
                                    }
                                }
                            }
                            // a ref-less receiver: substitute a return that is EXACTLY the
                            // type parameter T with the element's name (the pre-grounding
                            // behavior — serves plain named elements only).
                            if mf.retTy < self.arena.types.count() {
                                if self.arena.types[mf.retTy].nameId == mf.typeParams[0].nameId {
                                    if rt.nameLen > 0U64 {
                                        return self.typeInfoOfName(start: rt.nameStart, len: rt.nameLen, isArray: false)
                                    }
                                }
                            }
                        }
                        return self.declaredRetInfo(f: mf)
                    }
                    return scalarInfo()
                }
                return scalarInfo()
            }
            Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
                return self.typeInfoOfName(start: tyStart, len: tyLen, isArray: false)
            }
            Expr.MatchExpr(val scrut, val arms) => {
                // a desugared non-Optional `?.` records its result type (its arm's give value
                // references a bound `__chainVal` not in scope from here, so re-deriving fails).
                val cr: U64 = self.chainResultRef(exprId: id)
                if cr != 0 {
                    return self.typeInfoOfRef(ref: cr)
                }
                // the result type is the give value of the first non-diverging arm.
                mut val mai: U64 = 0
                while mai < arms.count() {
                    if !(arms[mai].isDiverge) {
                        val mg: U64 = self.blockGiveExpr(blkId: arms[mai].body)
                        if mg < self.arena.exprs.count() {
                            return self.exprTypeWithChainHole(id: mg, chainHoleRef: chainHoleRef)
                        }
                    }
                    mai += 1
                }
                return scalarInfo()
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                val g: U64 = self.blockGiveExpr(blkId: thenBlk)
                if g < self.arena.exprs.count() {
                    return self.exprTypeWithChainHole(id: g, chainHoleRef: chainHoleRef)
                }
                return scalarInfo()
            }
            Expr.OptChain(val base, val cont) => {
                // once the mono scan records the ChainSite, its stage result `Head[U]` is
                // authoritative (the desugar's give value references a bound `__chainVal`
                // not in scope from here, so re-deriving through the tree fails).
                val cr: U64 = self.chainResultRef(exprId: id)
                if cr != 0 {
                    return self.typeInfoOfRef(ref: cr)
                }
                // pre-rewrite / Optional fallback: `base?.<cont>` : Optional[U] where U is
                // the type of `cont` with the ChainHole bound to the base's payload.
                val rr: U64 = self.optChainResultRef(base: base, cont: cont)
                if rr == 0 {
                    return scalarInfo()
                }
                return self.typeInfoOfRef(ref: rr)
            }
            Expr.ChainHole => {
                // the unwrapped chain Value, set by chainStageResultRef while typing `cont`.
                if chainHoleRef != 0U64 {
                    return self.typeInfoOfRef(ref: chainHoleRef)
                }
                return scalarInfo()
            }
            Expr.Try(val expr) => {
                // result type = the Result's Ok payload T (args[0] of Result[T, E]).
                val rt: TypeInfo = self.exprTypeWithChainHole(id: expr, chainHoleRef: chainHoleRef)
                if self.isGenericInst(ref: rt.ref) {
                    val inst: TypeRef = self.arena.types[rt.ref]
                    if inst.args.count() > 0 {
                        return self.typeInfoOfRef(ref: inst.args[0])
                    }
                }
                return scalarInfo()
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                // pointee field type: base is Ref[T] / MutableRef[T]; resolve T then T's field.
                val bt: TypeInfo = self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef)
                if self.isStrongRefInst(ref: bt.ref) {
                    val inst: TypeRef = self.arena.types[bt.ref]
                    val pt: TypeInfo = self.typeInfoOfRef(ref: inst.args[0])
                    if pt.kind == 2 {
                        return self.fieldType(structStart: pt.nameStart, structLen: pt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
                    }
                }
                return scalarInfo()
            }
            Expr.Deref(val base) => {
                // `*ref` (the receiver of `ref->method()`): the pointee type T of base:
                // Ref[T] / MutableRef[T], so method resolution / arg inference runs against T
                // like a normal receiver.
                val bt: TypeInfo = self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef)
                if self.isStrongRefInst(ref: bt.ref) {
                    val inst: TypeRef = self.arena.types[bt.ref]
                    if inst.args.count() > 0 {
                        return self.typeInfoOfRef(ref: inst.args[0])
                    }
                }
                return scalarInfo()
            }
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                // a closure literal's type is `fn(params) -> ret`; recover it so a
                // generic call can structurally infer a type parameter from it
                // (`map(f: fn(x:I64)->I64)` -> B = I64).
                return self.typeInfoOfRef(ref: self.closureFnTypeRef(params: params, retTy: retTy))
            }
            Expr.Move(val operand, val isBorrow) => {
                // `move`/`borrow` have the operand's type (the value just flows).
                return self.exprTypeWithChainHole(id: operand, chainHoleRef: chainHoleRef)
            }
            Expr.Await(val operand) => {
                // `await e` (e: Promise[T]) yields T: recover the operand's generic
                // type argument. A value-less Promise[()] (args empty) yields a scalar.
                val ot: TypeInfo = self.exprTypeWithChainHole(id: operand, chainHoleRef: chainHoleRef)
                if ot.ref != 0 {
                    val tr: TypeRef = self.arena.types[ot.ref]
                    if tr.args.count() > 0 {
                        return self.typeInfoOfRef(ref: tr.args[0])
                    }
                }
                return scalarInfo()
            }
        }
        return scalarInfo()
    }
}
