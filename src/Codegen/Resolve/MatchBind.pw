// Part of name/type resolution (root: _.pw): match-pattern binding to
// locals.

// The value expression of the last `give` in a block (the block's result), or
// `c.arena.exprs.count()` (one past the end) if the block has no `give`. A U64 sentinel
// keeps callers off signed indices. Used to infer a value-position `if`'s type.

pub impl Comp {
    inout fn blockGiveExpr(blkId: U64) -> U64 {
        mut val i: U64 = 0
        mut val found: U64 = self.arena.exprs.count()
        while i < self.blockStmtCount(blkId: blkId) {
            val s: Stmt = self.arena.stmts[self.blockStmtAt(blkId: blkId, index: i)]
            match s {
                Stmt.Give(val value) => { found = value }
                _ => {}
            }
            i += 1
        }
        return found
    }

}
