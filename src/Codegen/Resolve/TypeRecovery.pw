// Part of name/type resolution (root: _.pw): overload matching, match
// exhaustiveness, scalar info, and the keyword-span cache.

// Check call args against a parameter list: provided args must appear in parameter
// declaration order, but any defaulted parameter may be omitted (not only trailing
// ones). This is also the shared mapping used by type-checking and emission.

pub impl Comp {
    // During first-pass overload recovery the expression's explicit selector
    // can precede a stored local TypeRef. Preserve its resolved full instance,
    // and combine it with the base's retained source set without re-resolving
    // its written spelling. This is recovery, not new conformance evidence.
    inout fn argViewSources(argExpr: U64, ti: TypeInfo) -> Result[Array[ResolvedViewSource], CompileDiagnostic] {
        mut val sources: Array[ResolvedViewSource] = []
        mut val current = argExpr
        mut val keepBase = true
        mut val walking = true
        while walking {
            match self.arena.exprs[current] {
                Expr.ExtView(recv: val base, source: val source, strip: val strip) => {
                    if strip {
                        sources = []
                        keepBase = false
                        walking = false
                    } else {
                        sources.append(source)
                        current = base
                    }
                }
                _ => { walking = false }
            }
        }
        if keepBase {
            val base = (try self.exprType(id: current))
            for source in self.arena.typeViewSources(ref: base.ref) { sources.append(source) }
            if current == argExpr {
                for source in self.arena.typeViewSources(ref: ti.ref) { sources.append(source) }
            }
        }
        return <Result.Ok value=self.normalizedViewSources(sources: sources) />
    }

    inout fn callableLabelMatchesParameter(param: Param, hasLabel: Bool, labelStart: U64, labelLen: U64) -> Bool {
        if param.noLabel { return !hasLabel }
        if !hasLabel { return false }
        return intern(c: inout self, start: labelStart, len: labelLen) == param.nameId
    }

    inout fn argMatchesParamLabel(param: Param, arg: Arg) -> Bool {
        return self.callableLabelMatchesParameter(param: param, hasLabel: arg.hasLabel, labelStart: arg.labelStart, labelLen: arg.labelLen)
    }

    // Expressions and requirement signatures expose the same callable form.
    // Keep omitted-parameter traversal here, shared by selection and adapters.
    inout fn callableInputMatchesLabel(param: Param, input: CallableArgumentInput, index: U64) -> Bool {
        match input {
            CallableArgumentInput.Expressions(val range) => {
                return self.argMatchesParamLabel(param: param, arg: self.argAt(args: range, index: index))
            }
            CallableArgumentInput.Templates(val range) => {
                val argument = self.callTemplateArgumentPool[range.start + index]
                return self.callableLabelMatchesParameter(param: param, hasLabel: argument.hasLabel, labelStart: argument.labelStart, labelLen: argument.labelLen)
            }
            CallableArgumentInput.Parameters(val range) => {
                val supplied = self.funcParamAt(params: range, index: index)
                return param.noLabel == supplied.noLabel && (param.noLabel || param.nameId == supplied.nameId)
            }
        }
    }

    inout fn callableNextParameter(params: FuncParamRange, input: CallableArgumentInput, index: U64, start: U64) -> U64 {
        mut val position = start
        while position < params.count() {
            val parameter = self.funcParamAt(params: params, index: position)
            if self.callableInputMatchesLabel(param: parameter, input: input, index: index) { return position }
            if !parameter.hasDefault { return params.count() }
            position += 1U64
        }
        return params.count()
    }

    inout fn callableInputLabelsOk(params: FuncParamRange, input: CallableArgumentInput) -> Bool {
        if input.count() > params.count() { return false }
        mut val position = 0U64
        mut val index = 0U64
        while index < input.count() {
            position = self.callableNextParameter(params: params, input: input, index: index, start: position)
            if position == params.count() { return false }
            position += 1U64
            index += 1U64
        }
        while position < params.count() {
            if !self.funcParamAt(params: params, index: position).hasDefault { return false }
            position += 1U64
        }
        return true
    }

    inout fn paramIndexForArg(params: FuncParamRange, args: ArgRange, argIdx: U64) -> U64 {
        val input = <CallableArgumentInput.Expressions range=args />
        mut val position = 0U64
        mut val index = 0U64
        while index < args.len {
            position = self.callableNextParameter(params: params, input: input, index: index, start: position)
            if position == params.count() || index == argIdx { return position }
            position += 1U64
            index += 1U64
        }
        return params.count()
    }

    inout fn argIndexForParam(params: FuncParamRange, args: ArgRange, paramIdx: U64) -> U64 {
        val input = <CallableArgumentInput.Expressions range=args />
        mut val position = 0U64
        mut val index = 0U64
        while index < args.len {
            position = self.callableNextParameter(params: params, input: input, index: index, start: position)
            if position == paramIdx { return index }
            if position >= params.count() || position > paramIdx { return args.len }
            position += 1U64
            index += 1U64
        }
        return args.len
    }

    inout fn paramsLabelsOk(params: FuncParamRange, args: ArgRange) -> Bool {
        return self.callableInputLabelsOk(params: params, input: <CallableArgumentInput.Expressions range=args />)
    }

    // Whether two type refs may be compared by FULL structural identity for overload
    // discrimination (`Box[I64]` vs `Box[String]`): both must be generic instances (carry
    // type args) that are NOT function types or existentials — a closure literal's inferred
    // fn ref and an `any P` ref do not structurally match a declared param ref, so those
    // keep the head-name match (spec/07 discriminates on concrete generic args, not on
    // closure signatures / erased existentials).
    inout fn refsGenericArgComparable(a: U64, b: U64) -> Bool {
        if a == 0U64 || b == 0U64 {
            return false
        }
        if a >= self.arena.typeCount() || b >= self.arena.typeCount() {
            return false
        }
        if self.arena.typeTermAt(index: a).isAny || self.arena.typeTermAt(index: b).isAny {
            return false
        }
        if self.isFnType(ref: a) || self.isFnType(ref: b) {
            return false
        }
        return self.arena.typeAt(index: a).args.count() > 0U64 && self.arena.typeAt(index: b).args.count() > 0U64
    }

    // An argument's recovered type for overload discrimination. Prefer the parametric
    // store (recorded by recordParametricTypes with cur.locals populated): plain
    // exprType returns a NAMELESS scalar for a variable/field argument because
    // cur.locals is not populated during overload resolution / emission, which would
    // let a typed variable adapt to any int parameter and silently select the
    // first-declared overload (spec/06 misdispatch — a wrong-typed call, at worst a
    // memory-unsafe type pun). Only a GROUND recorded type overrides: a still-parametric
    // `T` argument does not discriminate overloads (spec/06), so it is left to the
    // exprType path unchanged.
    inout fn argResolvedTypeInfo(argExpr: U64) -> Result[TypeInfo, CompileDiagnostic] {
        if argExpr < self.arena.exprs.count() {
            val sref: U64 = self.semanticExprTerm(exprId: argExpr)
            if sref != 0U64 {
                if sref < self.arena.typeCount() {
                    if (try self.tyRefIsGround(ref: sref)) {
                        return <Result.Ok value=self.typeInfoOfRef(ref: sref) />
                    }
                }
            }
        }
        return <Result.Ok value=(try self.exprType(id: argExpr)) />
    }

    // A contextual function still supplies authored labels and annotated
    // components before its body is checked. Use this partial structural
    // evidence during selection without publishing an incomplete signature.
    inout fn contextualArgumentMatchesType(exprId: U64, expected: U64) -> Result[Bool, CompileDiagnostic] {
        if self.expressionNeedsTypeContext(exprId: exprId, allowPartialFunction: true) {
            return <Result.Ok value=self.contextualArrayArgumentMatchesType(exprId: exprId, expected: expected) />
        }
        val info = try self.exprType(id: exprId)
        if !self.isFnType(ref: info.ref) { return <Result.Ok value=true /> }
        if !self.isFnType(ref: expected) { return <Result.Ok value=!(try self.tyRefIsGround(ref: expected)) /> }
        val actual = self.arena.typeAt(index: info.ref)
        val target = self.arena.typeAt(index: expected)
        if actual.args.count() != target.args.count() || actual.argLabels.count() != target.argLabels.count() { return <Result.Ok value=false /> }
        mut val index = 0U64
        while index < actual.args.count() {
            if index < actual.argLabels.count() && actual.argLabels[index] != target.argLabels[index] { return <Result.Ok value=false /> }
            val source = actual.args[index]
            val destination = target.args[index]
            if source != 0U64 && (try self.tyRefIsGround(ref: source)) && (try self.tyRefIsGround(ref: destination)) {
                val same = if index == 0U64 && self.callableResultIsUnit(ref: source) && self.callableResultIsUnit(ref: destination) { give true } else { give self.typeRefEq(a: source, b: destination) }
                if !same { return <Result.Ok value=false /> }
            }
            index += 1U64
        }
        return <Result.Ok value=true />
    }

    // Whether an argument's recovered type matches a parameter's declared type head
    // (used to discriminate same-label overloads — spec: overload by argument type).
    // An untyped integer literal (no suffix) matches any integer-typed parameter.
    inout fn argMatchesParam(argExpr: U64, p: Param) -> Result[Bool, CompileDiagnostic] {
        if self.expressionNeedsTypeContext(exprId: argExpr) { return self.contextualArgumentMatchesType(exprId: argExpr, expected: p.ty) }
        val ti: TypeInfo = (try self.argResolvedTypeInfo(argExpr: argExpr))
        if p.tyIsArray {
            if ti.kind == 3 {
                // An array's element spelling omits nested arguments and
                // declaration identity. Its complete semantic term is the
                // discriminator, just as for other generic values.
                return <Result.Ok value=ti.ref != 0U64 && p.ty != 0U64 && self.typeRefEq(a: ti.ref, b: p.ty) />
            }
            return <Result.Ok value=false />
        }
        // Array TypeInfo carries the element name; it cannot match a scalar
        // parameter merely because that scalar has the same name.
        if ti.kind == 3 { return <Result.Ok value=false />}
        if ti.kind == 2 {
            // A source set is ordinary named-type identity.  Compare it even
            // when the base local has not acquired a TypeRef yet: `p#E` must
            // select `f(P#E)` rather than falling through to first-declared
            // `f(P)` and failing only in backend validation.
            val actualViews = (try self.argViewSources(argExpr: argExpr, ti: ti))
            val paramViews = self.arena.typeViewSources(ref: p.ty)
            if !self.semanticViewSourceSetsEqual(a: actualViews, b: paramViews) {
                return <Result.Ok value=false />
            }
            // generic-instance discrimination (spec/07: distinguish at concrete argument
            // positions): `f(b: Box[I64])` vs `f(b: Box[String])` share a head name but
            // differ in type args. Compare the FULL grounded refs when both sides are
            // comparable generic instances — head-name-only would mis-merge them (the
            // parametric store now hands us the ground `Box[String]` ref).
            if self.refsGenericArgComparable(a: ti.ref, b: p.ty) {
                return <Result.Ok value=self.typeRefEq(a: ti.ref, b: p.ty) />
            }
            // Function types are structural (labels, parameters, return type,
            // and sendability).  They must not collapse to the shared `fn`
            // head during overload resolution.
            if self.isFnType(ref: ti.ref) && self.isFnType(ref: p.ty) {
                return <Result.Ok value=self.typeRefEq(a: ti.ref, b: p.ty) />
            }
            // Existentials share their trait name as a head, but `any P` and
            // `any sendable P` are distinct callable parameter forms.  Route
            // them through the same complete TypeRef identity used for fn
            // types instead of letting the fallback erase the capability.
            if ti.ref != 0U64 && p.ty != 0U64 && ti.ref < self.arena.typeCount() && p.ty < self.arena.typeCount() {
                if self.arena.typeTermAt(index: ti.ref).isAny || self.arena.typeTermAt(index: p.ty).isAny {
                    return <Result.Ok value=self.typeRefEq(a: ti.ref, b: p.ty) />
                }
            }
            return <Result.Ok value=intern(c: inout self, start: ti.nameStart, len: ti.nameLen) == p.tyNameId />
        }
        // ti.kind == 0: a scalar / integer. A suffixed/typed value carries its name;
        // an untyped literal (no name) adapts to any integer parameter.
        if ti.nameLen != 0 {
            return <Result.Ok value=intern(c: inout self, start: ti.nameStart, len: ti.nameLen) == p.tyNameId />
        }
        return <Result.Ok value=self.isIntType(start: p.tyStart, len: p.tyLen) />
    }

    // One candidate-local forward type matcher for ordinary and requirement
    // calls. Entries normalize only their receiver/trait environment; this owner
    // keeps method inference transactional and checks the complete parameter.
    inout fn callableParameterTypeMatchRank(function: Func, args: ArgRange, signatures: Array[U64], receiver: U64, initialValues: Array[U64]) -> Result[U64, CompileDiagnostic] {
        mut val values = initialValues
        mut val deferred: Array[(expression: U64, signature: U64)] = []
        for index in 0U64..<args.len {
            val parameter = self.paramIndexForArg(params: function.params, args: args, argIdx: index)
            if parameter >= signatures.count() { return <Result.Ok value=1U64 /> }
            val signature = signatures[parameter]
            val expression = self.argAt(args: args, index: index).expr
            match (try self.matchPreparedCallArgument(expression: expression, signature: signature, parameters: function.typeParams, receiver: receiver, values: inout values)) {
                TypeArgumentMatch.Matched => {}
                TypeArgumentMatch.Deferred => { deferred.append((expression: expression, signature: signature)) }
                TypeArgumentMatch.Mismatch | TypeArgumentMatch.Conflict => { return <Result.Ok value=1U64 /> }
            }
        }
        // Only context-dependent operands are revisited. Independently typed
        // operands have already contributed their one candidate-local map.
        for context in deferred {
            match (try self.matchPreparedCallArgument(expression: context.expression, signature: context.signature, parameters: function.typeParams, receiver: receiver, values: inout values)) {
                TypeArgumentMatch.Mismatch | TypeArgumentMatch.Conflict => { return <Result.Ok value=1U64 /> }
                _ => {}
            }
        }
        return <Result.Ok value=2U64 />
    }

    // Rank 0: no selector; 1: selector-only diagnostic fallback; 2: full match.
    inout fn callableArgMatchRank(f: Func, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        if !self.paramsLabelsOk(params: f.params, args: args) { return <Result.Ok value=0U64 /> }
        mut val signatures: Array[U64] = []
        for parameter in self.copyFuncParams(params: f.params) { signatures.append(parameter.ty) }
        mut val values: Array[U64] = []
        while values.count() < f.typeParams.count() { values.append(0U64) }
        return self.callableParameterTypeMatchRank(function: f, args: args, signatures: signatures, receiver: 0U64, initialValues: values)
    }

    // Method declarations carry the receiver's generic binders in their
    // parameter types.  Overload selection must compare after substituting the
    // concrete receiver (`Optional[I32].unwrapOr` has `fallback: I32`, not
    // merely `fallback: T`); otherwise a closure can spuriously match the
    // eager overload and reach LLVM as an integer.  The argument belongs to
    // the *caller* body, however: never install the candidate callee cursor
    // before reading its recorded semantic TypeTerm.
    inout fn groundedMethodArgMatchRank(f: Func, args: ArgRange, recvRef: U64) -> Result[U64, CompileDiagnostic] {
        if !(self.paramsLabelsOk(params: f.params, args: args)) { return <Result.Ok value=0U64 />}
        val receiver = try self.callReceiverTerm(f: f, receiverRef: recvRef, args: args)
        if receiver == 0U64 || receiver >= self.arena.typeCount() {
            return <Result.Ok value=(try self.callableArgMatchRank(f: f, args: args)) />
        }
        // Capture the caller meaning before selecting a callee. The semantic
        // term of `v` in `out.append(v)` can be
        // `Self#Iterator.Item`; evaluating it under Array's temporary
        // receiver was the provenance leak that became
        // `Array#Iterator.Item`.
        // This is the candidate's immutable receiver-only substitution.
        // `methodReceiverEnvironment` is the shared structural unifier used
        // by finalization too. This stage fixes only receiver binders;
        // the shared candidate-local matcher below tentatively infers the
        // method-owned binders before final selected-call publication.
        val receiverMatch: WitnessMatch = (try self.methodReceiverEnvironment(f: f, instRef: receiver, sourceMatch: true))
        // A failed structural receiver match is not an empty substitution.
        // Provided members may instead be justified by a trait path; their
        // applicability is established by the static proof query.
        if f.recvTy != 0U64 && receiverMatch.conformIdx == 0U64 && !f.isProvided {
            return <Result.Ok value=0U64 />
        }
        mut val calleeParams: Array[Bind] = []
        mut val calleeArgs: Array[U64] = []
        mut val bindI: U64 = 0U64
        while bindI < receiverMatch.binds.count() {
            val binding: WitnessBind = receiverMatch.binds[bindI]
            mut val target: U64 = f.typeParams.count()
            if binding.paramId != 0U64 {
                mut val paramI: U64 = 0U64
                while paramI < f.typeParams.count() {
                    if self.funcBindAt(binds: f.typeParams, index: paramI).paramId == binding.paramId {
                        target = paramI
                        break
                    }
                    paramI += 1U64
                }
            }
            if target >= f.typeParams.count() { target = binding.binder }
            if target < f.typeParams.count() && binding.term != 0U64 {
                calleeParams.append(self.funcBindAt(binds: f.typeParams, index: target))
                calleeArgs.append(binding.term)
            }
            bindI += 1U64
        }
        val calleeEnvironment: InstanceEnvironment = <InstanceEnvironment params=calleeParams args=calleeArgs receiverRef=receiver />
        mut val signatures: Array[U64] = []
        mut val parameter = 0U64
        while parameter < f.params.count() {
            signatures.append(try self.groundTermForBody(ref: self.funcParamAt(params: f.params, index: parameter).ty, environment: calleeEnvironment, selfRef: receiver, itemRef: (try self.finalMethodItemRef(f: f, receiverRef: receiver))))
            parameter += 1U64
        }
        mut val values: Array[U64] = []
        while values.count() < f.typeParams.count() { values.append(0U64) }
        return self.callableParameterTypeMatchRank(function: f, args: args, signatures: signatures, receiver: receiver, initialValues: values)
    }

    // An argument that is an unsuffixed integer literal carries no type name, so it
    // adapts to any integer parameter (argMatchesParam's last clause). Such an
    // argument is the only source of "one call matches two overloads": a typed value
    // matches exactly one parameter type.
    inout fn argIsUntypedIntLit(argExpr: U64) -> Result[Bool, CompileDiagnostic] {
        val ti: TypeInfo = (try self.argResolvedTypeInfo(argExpr: argExpr))
        if ti.kind == 0 {
            return <Result.Ok value=ti.nameLen == 0 && self.contextualNumericArgument(exprId: argExpr, floatingLiterals: false) />
        }
        return <Result.Ok value=false />
    }

    // Two type-matching overloads are genuinely ambiguous for this call iff some
    // untyped integer-literal argument maps to differing parameter types between
    // them. (Overloads that agree on every provided arg type but differ only via
    // defaulted/omitted params are a separate concern, not flagged here.)
    inout fn overloadsAmbiguous(fa: Func, fb: Func, args: ArgRange) -> Result[Bool, CompileDiagnostic] {
        mut val i: U64 = 0
        while i < args.len {
            if (try self.argIsUntypedIntLit(argExpr: self.argAt(args: args, index: i).expr)) {
                val pa: U64 = self.paramIndexForArg(params: fa.params, args: args, argIdx: i)
                val pb: U64 = self.paramIndexForArg(params: fb.params, args: args, argIdx: i)
                if pa < fa.params.count() {
                    if pb < fb.params.count() {
                        if self.funcParamAt(params: fa.params, index: pa).tyNameId != self.funcParamAt(params: fb.params, index: pb).tyNameId {
                            return <Result.Ok value=true />
                        }
                    }
                }
            }
            i += 1
        }
        return <Result.Ok value=false />
    }

    // Loudly reject (exits) when the two type-matching overloads `a`/`b` are
    // ambiguous for this call — picking the first silently would invent meaning
    // (spec: 補完はする／忖度はしない／曖昧はエラー).
    inout fn checkOverloadAmbiguity(a: U64, b: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if b != self.arena.functionCount() {
            if (try self.overloadsAmbiguous(fa: self.arena.functionAt(index: a), fb: self.arena.functionAt(index: b), args: args)) {
                mut val off: U64 = 0
                if args.len > 0 {
                    off = self.exprOffset(id: self.argAt(args: args, index: 0U64).expr)
                }
                return <Result.Err error=self.diagnosticAt(offset: off, msg: "ambiguous call: an unsuffixed integer literal matches more than one overload; add a type suffix (e.g. `5I32`)") />
            }
        }
        return <Result.Ok value=() />
    }

    // Does some arm cover the variant (variantStart,variantLen)? A wildcard arm
    // covers everything.
    inout fn armCovers(arms: MatchArmRange, variantStart: U64, variantLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < arms.len {
            val a: MatchArm = self.matchArmAt(arms: arms, index: i)
            if a.isWildcard {
                return true
            }
            if !a.isValuePattern && spansEqual(c: inout self, aStart: a.variantStart, aLen: a.variantLen, bStart: variantStart, bLen: variantLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // Coverage follows the subject's type and each pattern's meaning. Runtime
    // Eq tests do not cover an enum variant merely because their names match.
    inout fn matchExhaustive(scrut: U64, arms: MatchArmRange) -> Result[Bool, CompileDiagnostic] {
        mut val sawTrue = false
        mut val sawFalse = false
        mut val index = 0U64
        while index < arms.len {
            val arm = self.matchArmAt(arms: arms, index: index)
            if arm.isWildcard || arm.isStruct { return <Result.Ok value=true /> }
            if arm.isValuePattern {
                match self.arena.exprs[arm.valueExpr] {
                    Expr.Int(val value, offset: _, val isBool, tyStart: _, tyLen: _, isNeg: _) => {
                        if isBool {
                            if value == 0U64 { sawFalse = true }
                            if value == 1U64 { sawTrue = true }
                        }
                    }
                    _ => {}
                }
            }
            index += 1U64
        }
        mut val type = self.semanticExprTerm(exprId: scrut)
        if type == 0U64 { type = self.typedIrRefOfInfo(ti: (try self.typeOf(id: scrut))) }
        val enumIndex = self.enumIndexForType(ref: self.lexicalLayoutReceiver(receiverTerm: type))
        if enumIndex < self.arena.enumCount() {
            val variants = self.arena.enumAt(index: enumIndex).variants
            for val variant in variants {
                if !self.armCovers(arms: arms, variantStart: variant.nameStart, variantLen: variant.nameLen) { return <Result.Ok value=false /> }
            }
            return <Result.Ok value=true />
        }
        if sawTrue && sawFalse {
            val name = self.kwSpan(kw: "Bool", kwLen: 4U64)
            return <Result.Ok value=self.typeRefEq(a: type, b: self.langTypeRefAt(nameStart: name.nameStart, nameLen: name.nameLen, args: [])) />
        }
        return <Result.Ok value=false />
    }

    // Tag index of `Enum.Variant` (the variant's position in its enum declaration).

}

pub impl Comp {

    // Preserve source append order and first-registration precedence.
    inout fn addKwSpan(kw: String) {
        val bytes: Array[U8] = kw.bytes()
        val start: U64 = self.arena.bytes.count()
        mut val index: U64 = 0U64
        while index < bytes.count() {
            self.arena.bytes.append(bytes[index])
            index += 1U64
        }
        self.keywordSpans.register(spelling: bytes, start: start)
    }

    // Register built-in spellings after lowering. Earlier source results are
    // replaced by these registrations; existing source offsets stay unchanged.
    inout fn buildKwCache() {
        self.addKwSpan(kw: "String")
        self.addKwSpan(kw: "U8")
        self.addKwSpan(kw: "U64")
        self.addKwSpan(kw: "Bool")
        self.addKwSpan(kw: "Array")
        self.addKwSpan(kw: "Self")
        self.addKwSpan(kw: "fn")
        self.addKwSpan(kw: "iterator")
        self.addKwSpan(kw: "next")
        self.addKwSpan(kw: "from")
        val langModule: U64 = self.modules.langModule
        val arrayName = self.kwSpan(kw: "Array", kwLen: 5U64)
        val arrayNameId = intern(c: inout self, start: arrayName.nameStart, len: arrayName.nameLen)
        mut val i = self.arena.firstStructNamed(nameId: arrayNameId)
        while i < self.arena.structCount() {
            val candidate: StructDef = self.arena.structAt(index: i)
            // StructDef.nameStart can be a re-interned span, whereas the
            // keyword cache deliberately uses a synthetic span. Compare the
            // declaration's immutable bytes here, once in the frontend, then
            // publish only its declaration identity to later consumers.
            if candidate.nameLen == 5U64 && rangeEquals(bytes: self.arena.bytes, start: candidate.nameStart, len: candidate.nameLen, kw: "Array") && candidate.defOffset != 0U64 && self.moduleOf(offset: candidate.defOffset) == langModule {
                // TypeRef.declOffset is the declaration's source identity.
                // `nameStart` is an interner span and can be reallocated while
                // loading later modules, so comparing it to a TypeRef's
                // declaration offset misclassifies the built-in Array as a
                // user Index witness. Keep this identity in its native form.
                self.langArrayDeclOffset = candidate.defOffset
                return
            }
            i = self.arena.nextStructNamed(index: i)
        }
    }

    // The table owns only query state; source/registration semantics stay here.
    inout fn kwSpan(kw: String, kwLen: U64) -> Bind {
        val span = self.keywordSpans.lookup(source: self.arena.bytes, spelling: kw.bytes(), requestLength: kwLen)
        return <Bind nameStart=span.start nameLen=span.length fieldStart=span.start fieldLen=span.length />
    }

    // String literals are monomorphic (always `String`), so `val s = "hi"` infers
    // `String`; recover a "String" span to name PlewString (else require annotation).
    inout fn stringTypeSpan() -> Bind {
        return self.kwSpan(kw: "String", kwLen: 6)
    }

    inout fn typeInfoOfName(start: U64, len: U64, isArray: Bool) -> TypeInfo {
        // resolve a use alias (`only { Real as Alias }`) to the real name so the carried
        // type identity is canonical for downstream struct/field lookup (spec/15).
        val ar: Bind = self.aliasReal(start: start, len: len)
        val rs: U64 = ar.nameStart
        val rl: U64 = ar.nameLen
        if isArray {
            return <TypeInfo kind=3 nameStart=rs nameLen=rl ref=0 />
        }
        if rl == 0 {
            return scalarInfo()
        }
        if rangeEquals(bytes: self.arena.bytes, start: rs, len: rl, kw: "String") {
            return <TypeInfo kind=2 nameStart=rs nameLen=rl ref=0 />
        }
        if self.isPrimType(start: rs, len: rl) {
            // kind=0 (scalar) but carry the type name so the width is recoverable
            // (e.g. for the lossless-`as` check). The C type stays 64-bit for now.
            return <TypeInfo kind=0 nameStart=rs nameLen=rl ref=0 />
        }
        return <TypeInfo kind=2 nameStart=rs nameLen=rl ref=0 />
    }
}

// Candidate applicability may read the shape of an unresolved array without
// recording it under a candidate's expectation. A fixed caller binder remains
// possible; a known non-Array constructor cannot provide an array context.
impl Comp {
    // An unbound callee variable can still receive a numeric expectation from
    // the call's result context. A rigid caller parameter cannot. A known
    // nonnumeric constructor remains impossible regardless of its arguments.
    inout fn numericContextHasInferenceHole(expected: U64, parameters: FuncBindRange, values: Array[U64]) -> Bool {
        if self.bareInferenceParamId(ref: expected) == 0U64 && !self.arena.typeTermAt(index: expected).isProjection() { return false }
        for index in 0U64..<parameters.count() {
            if values[index] == 0U64 && self.typeTermContainsParameter(ref: expected, parameter: self.funcBindAt(binds: parameters, index: index).paramId) { return true }
        }
        return false
    }

    // Observe an unfinished value, never reconstruct a lexical scope or replace
    // its recorded type. The same answer drives applicability and ambiguity.
    inout fn contextualNumericArgument(exprId: U64, floatingLiterals: Bool = true) -> Bool {
        if exprId >= self.arena.exprs.count() { return false }
        if self.semanticExprTerm(exprId: exprId) != 0U64 { return false }
        if contextualNumericExpression(self.arena.exprs, exprId: exprId, floatingLiterals: floatingLiterals) { return true }
        match self.arena.exprs[exprId] {
            Expr.Block(val body, offset: _) | Expr.Sequence(val body) => {
                return self.contextualNumericBlock(blockId: body, floatingLiterals: floatingLiterals).contextual
            }
            Expr.IfChain(conditions: _, val thenBlk, val elseBlk) | Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                val first = self.contextualNumericBlock(blockId: thenBlk, floatingLiterals: floatingLiterals)
                val second = self.contextualNumericBlock(blockId: elseBlk, floatingLiterals: floatingLiterals)
                return (first.normal || second.normal) && (!first.normal || first.contextual) && (!second.normal || second.contextual)
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                mut val normal = false
                for index in 0U64..<arms.len {
                    val branch = self.contextualNumericBlock(blockId: self.matchArmAt(arms: arms, index: index).body, floatingLiterals: floatingLiterals)
                    if branch.normal {
                        normal = true
                        if !branch.contextual { return false }
                    }
                }
                return normal
            }
            _ => { return false }
        }
    }

    inout fn contextualNumericBlock(blockId: U64, floatingLiterals: Bool) -> (normal: Bool, contextual: Bool) {
        match self.constructionValueBlock(blockId: blockId) {
            SemanticValueBlockTyping.Checked(val completion, val resultTerm) => {
                if !completion.source.normal() { return (normal: false, contextual: false) }
                if resultTerm != 0U64 { return (normal: true, contextual: false) }
            }
            SemanticValueBlockTyping.Pending => {
                if !self.blockCompletion(blkId: blockId).source.normal() { return (normal: false, contextual: false) }
            }
        }
        return (normal: true, contextual: self.contextualNumericArgument(exprId: self.blockGiveExpr(blkId: blockId), floatingLiterals: floatingLiterals))
    }

    inout fn contextualArrayArgumentMatchesType(exprId: U64, expected: U64) -> Bool {
        if exprId >= self.arena.exprs.count() || expected == 0U64 || expected >= self.arena.typeCount() { return true }
        match self.arena.exprs[exprId] {
            Expr.Array(val elems) => {
                val context = self.arena.typeTermAt(index: expected)
                if context.paramId != 0U64 || context.assocNameId != 0U64 { return true }
                if context.isRecord || context.isAny || self.isFnType(ref: expected) { return false }
                if !context.hasDecl || self.langArrayDeclOffset == 0U64 { return true }
                if context.declOffset != self.langArrayDeclOffset { return false }
                if context.args.len != 1U64 { return true }
                val element = self.arena.typeArgumentAt(index: context.args.start)
                for index in 0U64..<elems.len {
                    if !self.contextualArrayArgumentMatchesType(exprId: self.exprAt(exprs: elems, index: index), expected: element) { return false }
                }
            }
            Expr.Block(val body, offset: _) | Expr.Sequence(val body) => {
                return self.contextualArrayArgumentMatchesType(exprId: self.blockGiveExpr(blkId: body), expected: expected)
            }
            Expr.IfChain(conditions: _, val thenBlk, val elseBlk) | Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                return self.contextualArrayArgumentMatchesType(exprId: self.blockGiveExpr(blkId: thenBlk), expected: expected) && self.contextualArrayArgumentMatchesType(exprId: self.blockGiveExpr(blkId: elseBlk), expected: expected)
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                for index in 0U64..<arms.len {
                    if !self.contextualArrayArgumentMatchesType(exprId: self.blockGiveExpr(blkId: self.matchArmAt(arms: arms, index: index).body), expected: expected) { return false }
                }
            }
            _ => {}
        }
        return true
    }
}

// Prepared operands expose only their unfinished value recipe to candidate
// matching. This is separate from the entry policy that defers recording an
// expression: independently prepared fields and closed block locals stay put.
impl Comp {
    inout fn callArgumentHasInferenceHole(expected: U64, parameters: FuncBindRange, values: Array[U64]) -> Bool {
        for index in 0U64..<parameters.count() {
            if values[index] == 0U64 && self.typeTermContainsParameter(ref: expected, parameter: self.funcBindAt(binds: parameters, index: index).paramId) { return true }
        }
        return false
    }

    inout fn partialConstructionArgument(exprId: U64) -> Bool {
        if exprId >= self.arena.exprs.count() { return false }
        match self.arena.exprs[exprId] {
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: val isEnum, ty: _, fields: _) => {
                val term = self.semanticExprTerm(exprId: exprId)
                if term == 0U64 || term >= self.arena.typeCount() || self.arena.typeTermAt(index: term).args.len != 0U64 { return false }
                if isEnum {
                    val owner = self.enumIndexForType(ref: term)
                    return owner < self.arena.enumCount() && self.arena.enumAt(index: owner).typeParams.count() != 0U64
                }
                val owner = self.structIndexForType(ref: term)
                return owner < self.arena.structCount() && self.arena.structAt(index: owner).typeParams.count() != 0U64
            }
            _ => { return false }
        }
    }

    inout fn incompleteArgumentCall(exprId: U64) -> Result[Optional[CallTemplate], CompileDiagnostic] {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) | Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) | Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {}
            _ => { return <Result.Ok value=<Optional.None /> /> }
        }
        // A closed declaration result has no binder that a result context
        // could complete, even if an unrelated callee slot is unresolved.
        val term = self.semanticExprTerm(exprId: exprId)
        if term != 0U64 && term < self.arena.typeCount() && self.arena.typeIsClosed(ref: term) { return <Result.Ok value=<Optional.None /> /> }
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val index = self.callTemplateIndex(siteKey: site)
        if index >= self.callTemplateLocations.count() { return <Result.Ok value=<Optional.None /> /> }
        val template = self.callTemplateAt(index: index)
        val state = try self.selectedCallParameterStateWithOrigin(template: template, exprId: exprId, origin: <Optional.Some v=index />)
        match state {
            SourceCallParameterState.Incomplete(source: _) => {
                match template.kind {
                    CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: _, proofId: _) | CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: _, methodTypeArgs: _, resultTerm: _) => { return <Result.Ok value=<Optional.Some v=template /> /> }
                    _ => {}
                }
            }
            _ => {}
        }
        return <Result.Ok value=<Optional.None /> />
    }

    inout fn argumentRequiresResultContext(exprId: U64) -> Result[Bool, CompileDiagnostic] {
        if exprId >= self.arena.exprs.count() { return <Result.Ok value=false /> }
        if self.semanticExprTerm(exprId: exprId) == 0U64 || self.partialConstructionArgument(exprId: exprId) { return <Result.Ok value=true /> }
        if (try self.incompleteArgumentCall(exprId: exprId)).isSome() { return <Result.Ok value=true /> }
        match self.arena.exprs[exprId] {
            Expr.Block(val body, offset: _) | Expr.Sequence(val body) => { return self.argumentBlockRequiresResultContext(blockId: body) }
            Expr.IfChain(conditions: _, val thenBlk, val elseBlk) | Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                return <Result.Ok value=(try self.argumentBlockRequiresResultContext(blockId: thenBlk)) || (try self.argumentBlockRequiresResultContext(blockId: elseBlk)) />
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                for index in 0U64..<arms.len {
                    if (try self.argumentBlockRequiresResultContext(blockId: self.matchArmAt(arms: arms, index: index).body)) { return <Result.Ok value=true /> }
                }
            }
            _ => {}
        }
        return <Result.Ok value=false />
    }

    inout fn argumentBlockRequiresResultContext(blockId: U64) -> Result[Bool, CompileDiagnostic] {
        match self.constructionValueBlock(blockId: blockId) {
            SemanticValueBlockTyping.Checked(completion: val completion, resultTerm: _) => {
                if !completion.source.normal() { return <Result.Ok value=false /> }
            }
            _ => { return <Result.Ok value=false /> }
        }
        return self.argumentRequiresResultContext(exprId: self.blockGiveExpr(blkId: blockId))
    }

    inout fn matchPreparedArgumentBlock(blockId: U64, signature: U64, parameters: FuncBindRange, receiver: U64, values: inout Array[U64]) -> Result[TypeArgumentMatch, CompileDiagnostic] {
        match self.constructionValueBlock(blockId: blockId) {
            SemanticValueBlockTyping.Checked(completion: val completion, resultTerm: _) => {
                if !completion.source.normal() { return <Result.Ok value=<TypeArgumentMatch.Matched /> /> }
            }
            _ => {}
        }
        return self.matchPreparedCallArgument(expression: self.blockGiveExpr(blkId: blockId), signature: signature, parameters: parameters, receiver: receiver, values: inout values)
    }

    inout fn matchPreparedCallArgument(expression: U64, signature: U64, parameters: FuncBindRange, receiver: U64, values: inout Array[U64]) -> Result[TypeArgumentMatch, CompileDiagnostic] {
        mut val expected = try self.groundKnownCallTypeArguments(ref: signature, params: parameters, values: values, receiver: receiver)
        if expected == 0U64 || expected >= self.arena.typeCount() { return <Result.Ok value=<TypeArgumentMatch.Mismatch /> /> }
        if self.expressionNeedsTypeContext(exprId: expression) {
            return <Result.Ok value=if (try self.contextualArgumentMatchesType(exprId: expression, expected: expected)) { give <TypeArgumentMatch.Deferred /> } else { give <TypeArgumentMatch.Mismatch /> } />
        }
        if self.contextualNumericArgument(exprId: expression) {
            val term = self.arena.typeTermAt(index: expected)
            if self.isFloatType(start: term.nameStart, len: term.nameLen) || ((try self.argIsUntypedIntLit(argExpr: expression)) && self.isIntType(start: term.nameStart, len: term.nameLen)) { return <Result.Ok value=<TypeArgumentMatch.Matched /> /> }
            if self.numericContextHasInferenceHole(expected: expected, parameters: parameters, values: values) { return <Result.Ok value=<TypeArgumentMatch.Deferred /> /> }
            return <Result.Ok value=<TypeArgumentMatch.Mismatch /> />
        }
        if (try self.argumentRequiresResultContext(exprId: expression)) {
            match self.arena.exprs[expression] {
                Expr.Block(val body, offset: _) | Expr.Sequence(val body) => { return self.matchPreparedArgumentBlock(blockId: body, signature: signature, parameters: parameters, receiver: receiver, values: inout values) }
                Expr.IfChain(conditions: _, val thenBlk, val elseBlk) | Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                    val first = try self.matchPreparedArgumentBlock(blockId: thenBlk, signature: signature, parameters: parameters, receiver: receiver, values: inout values)
                    match first { TypeArgumentMatch.Mismatch | TypeArgumentMatch.Conflict => { return <Result.Ok value=first /> } _ => {} }
                    val second = try self.matchPreparedArgumentBlock(blockId: elseBlk, signature: signature, parameters: parameters, receiver: receiver, values: inout values)
                    match second { TypeArgumentMatch.Mismatch | TypeArgumentMatch.Conflict => { return <Result.Ok value=second /> } _ => {} }
                    return <Result.Ok value=if (match first { TypeArgumentMatch.Deferred => true _ => false }) || (match second { TypeArgumentMatch.Deferred => true _ => false }) { give <TypeArgumentMatch.Deferred /> } else { give <TypeArgumentMatch.Matched /> } />
                }
                Expr.MatchExpr(scrut: _, val arms) => {
                    mut val pending = false
                    for index in 0U64..<arms.len {
                        val matched = try self.matchPreparedArgumentBlock(blockId: self.matchArmAt(arms: arms, index: index).body, signature: signature, parameters: parameters, receiver: receiver, values: inout values)
                        match matched {
                            TypeArgumentMatch.Mismatch | TypeArgumentMatch.Conflict => { return <Result.Ok value=matched /> }
                            TypeArgumentMatch.Deferred => { pending = true }
                            _ => {}
                        }
                    }
                    return <Result.Ok value=if pending { give <TypeArgumentMatch.Deferred /> } else { give <TypeArgumentMatch.Matched /> } />
                }
                Expr.Make(typeStart: _, typeLen: _, variantStart: val variantStart, variantLen: val variantLen, isEnum: val isEnum, ty: _, fields: val fields) => {
                    if self.partialConstructionArgument(exprId: expression) {
                        if self.numericContextHasInferenceHole(expected: expected, parameters: parameters, values: values) { return <Result.Ok value=<TypeArgumentMatch.Deferred /> /> }
                        if !(try self.makeAcceptsExpectedTerm(exprId: expression, writtenTerm: self.semanticExprTerm(exprId: expression), isEnum: isEnum, fields: fields, expectedTerm: expected)) { return <Result.Ok value=<TypeArgumentMatch.Mismatch /> /> }
                        mut val pending = false
                        for index in 0U64..<fields.len {
                            val field = self.makeFieldAt(fields: fields, index: index)
                            val term = if isEnum { give (try self.genericEnumFieldType(instRef: expected, variantStart: variantStart, variantLen: variantLen, fieldStart: field.nameStart, fieldLen: field.nameLen)).term } else { give try self.fieldTypeRefOfReceiver(receiverRef: expected, fieldStart: field.nameStart, fieldLen: field.nameLen) }
                            if term == 0U64 { return <Result.Ok value=<TypeArgumentMatch.Mismatch /> /> }
                            val matched = try self.matchPreparedCallArgument(expression: field.value, signature: term, parameters: parameters, receiver: receiver, values: inout values)
                            match matched { TypeArgumentMatch.Mismatch | TypeArgumentMatch.Conflict => { return <Result.Ok value=matched /> } _ => {} }
                            pending = pending || (match matched { TypeArgumentMatch.Deferred => true _ => false })
                        }
                        return <Result.Ok value=if pending { give <TypeArgumentMatch.Deferred /> } else { give <TypeArgumentMatch.Matched /> } />
                    }
                }
                _ => {}
            }
            match (try self.incompleteArgumentCall(exprId: expression)) {
                Optional.Some(v: val template) => {
                    match (try self.prepareCallTemplateResult(kind: template.kind, expectedTerm: expected, receiverTerm: template.receiverTypeTerm, offset: self.exprOffset(id: expression))) {
                        Optional.Some(v: val completion) => {
                            if !(try self.typesCompatible(expected: expected, inferred: completion.result.resultType)) { return <Result.Ok value=<TypeArgumentMatch.Mismatch /> /> }
                            return <Result.Ok value=if self.callArgumentHasInferenceHole(expected: expected, parameters: parameters, values: values) { give <TypeArgumentMatch.Deferred /> } else { give <TypeArgumentMatch.Matched /> } />
                        }
                        Optional.None => { return <Result.Ok value=if self.callArgumentHasInferenceHole(expected: expected, parameters: parameters, values: values) { give <TypeArgumentMatch.Deferred /> } else { give <TypeArgumentMatch.Mismatch /> } /> }
                    }
                }
                Optional.None => {}
            }
        }
        val actual = try self.inferenceArgumentType(exprId: expression)
        mut val candidate = values
        match self.matchCallTypeArguments(pattern: signature, argument: actual, params: parameters, values: inout candidate) {
            TypeArgumentMatch.Matched | TypeArgumentMatch.Deferred => { values = candidate }
            TypeArgumentMatch.Mismatch => {}
            TypeArgumentMatch.Conflict => { return <Result.Ok value=<TypeArgumentMatch.Conflict /> /> }
        }
        expected = try self.groundKnownCallTypeArguments(ref: signature, params: parameters, values: values, receiver: receiver)
        return <Result.Ok value=if (try self.typesCompatible(expected: expected, inferred: actual)) { give <TypeArgumentMatch.Matched /> } else { give <TypeArgumentMatch.Mismatch /> } />
    }
}
