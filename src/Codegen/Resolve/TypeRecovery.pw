// Part of name/type resolution (root: _.pw): overload matching, match
// exhaustiveness, scalar info, and the keyword-span cache.

// Check call args against a parameter list: provided args must appear in parameter
// declaration order, but any defaulted parameter may be omitted (not only trailing
// ones). This is also the shared mapping used by type-checking and emission.

pub impl Comp {
    // The type resolver needs this before a body-local TypeInfo is available:
    // `f(value: p#E)` is selected while `p` may still be name-only, but the
    // written view is already a part of the argument's type identity.  Keep
    // this source-set recovery here, next to overload matching, rather than
    // letting a later backend check discover that the wrong overload won.
    inout fn typeRefViewIds(ref: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        if ref == 0U64 || ref >= self.arena.types.count() { return out }
        val t: TypeRef = self.arena.types[ref]
        out = t.viewIds
        if out.count() == 0U64 && t.viewExtId != 0U64 { out.append(t.viewExtId) }
        return out
    }

    inout fn appendDistinctViewId(ids: inout Array[U64], id: U64) {
        if id == 0U64 { return }
        mut val i: U64 = 0U64
        while i < ids.count() {
            if ids[i] == id { return }
            i += 1U64
        }
        ids.append(id)
    }

    // Recover a value's static source set from both its declared TypeRef and
    // explicit view syntax.  The latter is essential during first-pass free
    // overload resolution, before a local `P` has been promoted to a typed
    // local but after `p#E` has already made its provenance explicit.
    inout fn argViewIds(argExpr: U64, ti: TypeInfo) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val cur: U64 = argExpr
        mut val keepBase: Bool = true
        mut val walking: Bool = true
        while walking {
            match self.arena.exprs[cur] {
                Expr.ExtView(recv: val base, source: val source, strip: val strip) => {
                    if strip {
                        out = []
                        keepBase = false
                        walking = false
                    } else {
                        self.appendDistinctViewId(ids: inout out, id: source.surfaceId)
                        cur = base
                    }
                }
                _ => { walking = false }
            }
        }
        if keepBase {
            val base: TypeInfo = self.exprType(id: cur)
            val baseIds: Array[U64] = self.typeRefViewIds(ref: base.ref)
            mut val i: U64 = 0U64
            while i < baseIds.count() {
                self.appendDistinctViewId(ids: inout out, id: baseIds[i])
                i += 1U64
            }
            // A non-view expression can still carry a fully recovered ref.
            if cur == argExpr {
                val tiIds: Array[U64] = self.typeRefViewIds(ref: ti.ref)
                i = 0U64
                while i < tiIds.count() {
                    self.appendDistinctViewId(ids: inout out, id: tiIds[i])
                    i += 1U64
                }
            }
        }
        return out
    }

    inout fn argMatchesParamLabel(param: Param, arg: Arg) -> Bool {
        if param.noLabel {
            return !(arg.hasLabel)
        }
        if !(arg.hasLabel) {
            return false
        }
        return intern(c: inout self, start: arg.labelStart, len: arg.labelLen) == param.nameId
    }

    inout fn paramIndexForArg(params: FuncParamRange, args: ArgRange, argIdx: U64) -> U64 {
        mut val ai: U64 = 0
        mut val pi: U64 = 0
        while pi < params.count() {
            if ai < args.len {
                if self.argMatchesParamLabel(param: self.funcParamAt(params: params, index: pi), arg: self.argAt(args: args, index: ai)) {
                    if ai == argIdx {
                        return pi
                    }
                    ai += 1U64
                }
            }
            pi += 1U64
        }
        return params.count()
    }

    inout fn argIndexForParam(params: FuncParamRange, args: ArgRange, paramIdx: U64) -> U64 {
        mut val ai: U64 = 0
        mut val pi: U64 = 0
        while pi < params.count() {
            if ai < args.len {
                if self.argMatchesParamLabel(param: self.funcParamAt(params: params, index: pi), arg: self.argAt(args: args, index: ai)) {
                    if pi == paramIdx {
                        return ai
                    }
                    ai += 1U64
                }
            }
            pi += 1U64
        }
        return args.len
    }

    inout fn paramsLabelsOk(params: FuncParamRange, args: ArgRange) -> Bool {
        if args.len > params.count() {
            return false
        }
        mut val ai: U64 = 0
        mut val pi: U64 = 0
        while pi < params.count() {
            if ai < args.len {
                if self.argMatchesParamLabel(param: self.funcParamAt(params: params, index: pi), arg: self.argAt(args: args, index: ai)) {
                    ai += 1U64
                } else {
                    if !(self.funcParamAt(params: params, index: pi).hasDefault) {
                        return false
                    }
                }
            } else {
                if !(self.funcParamAt(params: params, index: pi).hasDefault) {
                    return false
                }
            }
            pi += 1U64
        }
        return ai == args.len
    }

    // Whether two type refs may be compared by FULL structural identity for overload
    // discrimination (`Box[I64]` vs `Box[String]`): both must be generic instances (carry
    // type args) that are NOT function types or existentials — a closure literal's inferred
    // fn ref and an `any P` ref do not structurally match a declared param ref, so those
    // keep the head-name match (spec/07 discriminates on concrete generic args, not on
    // closure signatures / erased existentials).
    inout fn refsGenericArgComparable(a: U64, b: U64) -> Bool {
        if a == 0U64 || b == 0U64 {
            return false
        }
        if a >= self.arena.types.count() || b >= self.arena.types.count() {
            return false
        }
        if self.arena.types[a].isAny || self.arena.types[b].isAny {
            return false
        }
        if self.isFnType(ref: a) || self.isFnType(ref: b) {
            return false
        }
        return self.arena.types[a].args.count() > 0U64 && self.arena.types[b].args.count() > 0U64
    }

    // An argument's recovered type for overload discrimination. Prefer the parametric
    // store (recorded by recordParametricTypes with cur.locals populated): plain
    // exprType returns a NAMELESS scalar for a variable/field argument because
    // cur.locals is not populated during overload resolution / emission, which would
    // let a typed variable adapt to any int parameter and silently select the
    // first-declared overload (spec/06 misdispatch — a wrong-typed call, at worst a
    // memory-unsafe type pun). Only a GROUND recorded type overrides: a still-parametric
    // `T` argument does not discriminate overloads (spec/06), so it is left to the
    // exprType path unchanged.
    inout fn argResolvedTypeInfo(argExpr: U64) -> TypeInfo {
        if argExpr < self.arena.semanticExprTypes.count() {
            val sref: U64 = self.semanticExprTerm(exprId: argExpr)
            if sref != 0U64 {
                if sref < self.arena.types.count() {
                    if self.tyRefIsGround(ref: sref) {
                        return self.typeInfoOfRef(ref: sref)
                    }
                }
            }
        }
        return self.exprType(id: argExpr)
    }

    // Whether an argument's recovered type matches a parameter's declared type head
    // (used to discriminate same-label overloads — spec: overload by argument type).
    // An untyped integer literal (no suffix) matches any integer-typed parameter.
    inout fn argMatchesParam(argExpr: U64, p: Param) -> Bool {
        val ti: TypeInfo = self.argResolvedTypeInfo(argExpr: argExpr)
        if p.tyIsArray {
            if ti.kind == 3 {
                return intern(c: inout self, start: ti.nameStart, len: ti.nameLen) == p.tyNameId
            }
            return false
        }
        if ti.kind == 2 {
            // A source set is ordinary named-type identity.  Compare it even
            // when the base local has not acquired a TypeRef yet: `p#E` must
            // select `f(P#E)` rather than falling through to first-declared
            // `f(P)` and failing only in backend validation.
            val actualViews: Array[U64] = self.argViewIds(argExpr: argExpr, ti: ti)
            val paramViews: Array[U64] = self.typeRefViewIds(ref: p.ty)
            if !(self.sameViewIdSet(a: actualViews, b: paramViews)) {
                return false
            }
            // generic-instance discrimination (spec/07: distinguish at concrete argument
            // positions): `f(b: Box[I64])` vs `f(b: Box[String])` share a head name but
            // differ in type args. Compare the FULL grounded refs when both sides are
            // comparable generic instances — head-name-only would mis-merge them (the
            // parametric store now hands us the ground `Box[String]` ref).
            if self.refsGenericArgComparable(a: ti.ref, b: p.ty) {
                return self.typeRefEq(a: ti.ref, b: p.ty)
            }
            // Function types are structural (labels, parameters, return type,
            // and sendability).  They must not collapse to the shared `fn`
            // head during overload resolution.
            if self.isFnType(ref: ti.ref) && self.isFnType(ref: p.ty) {
                return self.typeRefEq(a: ti.ref, b: p.ty)
            }
            // Existentials share their trait name as a head, but `any P` and
            // `any sendable P` are distinct callable parameter forms.  Route
            // them through the same complete TypeRef identity used for fn
            // types instead of letting the fallback erase the capability.
            if ti.ref != 0U64 && p.ty != 0U64 && ti.ref < self.arena.types.count() && p.ty < self.arena.types.count() {
                if self.arena.types[ti.ref].isAny || self.arena.types[p.ty].isAny {
                    return self.typeRefEq(a: ti.ref, b: p.ty)
                }
            }
            return intern(c: inout self, start: ti.nameStart, len: ti.nameLen) == p.tyNameId
        }
        // ti.kind == 0: a scalar / integer. A suffixed/typed value carries its name;
        // an untyped literal (no name) adapts to any integer parameter.
        if ti.nameLen != 0 {
            return intern(c: inout self, start: ti.nameStart, len: ti.nameLen) == p.tyNameId
        }
        return self.isIntType(start: p.tyStart, len: p.tyLen)
    }

    // Whether every provided argument's type matches its parameter's declared type.
    // Defaulted positions have already been checked at the declaration.
    inout fn paramsTypesMatch(params: FuncParamRange, args: ArgRange) -> Bool {
        mut val ai: U64 = 0
        while ai < args.len {
            val pi: U64 = self.paramIndexForArg(params: params, args: args, argIdx: ai)
            if pi < params.count() {
                if !(self.argMatchesParam(argExpr: self.argAt(args: args, index: ai).expr, p: self.funcParamAt(params: params, index: pi))) {
                    return false
                }
            } else {
                return false
            }
            ai += 1
        }
        return true
    }

    // The resolver's one argument-side classification.  Rank 0 is no exposed
    // callable form, 1 is a selector-only match (for diagnostics/fallback),
    // and 2 is a complete call match.  Every resolver entry point consumes the
    // same rank instead of composing label and type tests independently.
    inout fn callableArgMatchRank(f: Func, args: ArgRange) -> U64 {
        if !(self.paramsLabelsOk(params: f.params, args: args)) { return 0U64 }
        if self.paramsTypesMatch(params: f.params, args: args) { return 2U64 }
        return 1U64
    }

    // Method declarations carry the receiver's generic binders in their
    // parameter types.  Overload selection must compare after substituting the
    // concrete receiver (`Optional[I32].unwrapOr` has `fallback: I32`, not
    // merely `fallback: T`); otherwise a closure can spuriously match the
    // eager overload and reach LLVM as an integer.  The argument belongs to
    // the *caller* body, however: never install the candidate callee cursor
    // before reading its recorded semantic TypeTerm.
    inout fn groundedMethodArgMatchRank(f: Func, args: ArgRange, recvRef: U64) -> U64 {
        if !(self.paramsLabelsOk(params: f.params, args: args)) { return 0U64 }
        if recvRef == 0U64 || recvRef >= self.arena.types.count() {
            return self.callableArgMatchRank(f: f, args: args)
        }
        // Capture the caller meaning before selecting a callee. The semantic
        // term of `v` in `out.append(v)` can be
        // `Self#Iterator.Item`; evaluating it under Array's temporary
        // receiver was the provenance leak that became
        // `Array#Iterator.Item`.
        val callerEnvironment: InstanceEnvironment = <InstanceEnvironment params=self.cur.typeParams args=self.cur.typeArgs receiverRef=self.cur.recvInstRef proof=self.cur.bodyEnvironment.proof />
        val callerSelf: U64 = self.cur.selfRef
        val callerItem: U64 = self.cur.itemRef
        // This is the candidate's immutable receiver-only substitution.
        // `methodReceiverEnvironment` is the shared structural unifier used
        // by finalization too. Method-owned binders deliberately remain
        // absent while ranking; final callable publication performs their
        // one complete inference.
        val receiverMatch: WitnessMatch = self.methodReceiverEnvironment(f: f, instRef: recvRef)
        mut val calleeParams: Array[Bind] = []
        mut val calleeArgs: Array[U64] = []
        mut val bindI: U64 = 0U64
        while bindI < receiverMatch.binds.count() {
            val binding: WitnessBind = receiverMatch.binds[bindI]
            mut val target: U64 = f.typeParams.count()
            if binding.paramId != 0U64 {
                mut val paramI: U64 = 0U64
                while paramI < f.typeParams.count() {
                    if self.funcBindAt(binds: f.typeParams, index: paramI).paramId == binding.paramId {
                        target = paramI
                        break
                    }
                    paramI += 1U64
                }
            }
            if target >= f.typeParams.count() { target = binding.binder }
            if target < f.typeParams.count() && binding.term != 0U64 {
                calleeParams.append(self.funcBindAt(binds: f.typeParams, index: target))
                calleeArgs.append(binding.term)
            }
            bindI += 1U64
        }
        val calleeEnvironment: InstanceEnvironment = <InstanceEnvironment params=calleeParams args=calleeArgs receiverRef=recvRef />
        mut val allMatch: Bool = true
        mut val ai: U64 = 0U64
        while ai < args.len {
            val pi: U64 = self.paramIndexForArg(params: f.params, args: args, argIdx: ai)
            if pi >= f.params.count() {
                allMatch = false
            } else {
                val expected: U64 = self.groundTermForBody(ref: self.funcParamAt(params: f.params, index: pi).ty, environment: calleeEnvironment, selfRef: recvRef, itemRef: self.finalMethodItemRef(f: f, receiverRef: recvRef))
                // A method-owned binder remains abstract at this stage.  It is
                // intentionally inferred from the argument later; receiver
                // binders, by contrast, are concrete in calleeEnvironment.
                if expected != 0U64 && self.tyRefIsGround(ref: expected) {
                    val actual: TypeInfo = self.groundSemanticExprTypeInfo(exprId: self.argAt(args: args, index: ai).expr, environment: callerEnvironment, selfRef: callerSelf, itemRef: callerItem)
                    if actual.kind == 2I64 {
                        // Keep this discriminator congruent with argMatchesParam:
                        // a plain named type does not necessarily retain a TypeRef
                        // during method lookup, while generic/fn/any/view terms do
                        // require their complete semantic identity.
                        val expectedTerm: TypeRef = self.arena.types[expected]
                        val actualViews: Array[U64] = self.argViewIds(argExpr: self.argAt(args: args, index: ai).expr, ti: actual)
                        val expectedViews: Array[U64] = self.typeRefViewIds(ref: expected)
                        if !(self.sameViewIdSet(a: actualViews, b: expectedViews)) {
                            allMatch = false
                        } else if self.refsGenericArgComparable(a: actual.ref, b: expected) || (self.isFnType(ref: actual.ref) && self.isFnType(ref: expected)) || (actual.ref != 0U64 && actual.ref < self.arena.types.count() && (self.arena.types[actual.ref].isAny || expectedTerm.isAny)) {
                            if !(self.typeRefEq(a: actual.ref, b: expected)) {
                                allMatch = false
                            }
                        } else if intern(c: inout self, start: actual.nameStart, len: actual.nameLen) != expectedTerm.nameId {
                            allMatch = false
                        }
                    } else {
                        val et: TypeRef = self.arena.types[expected]
                        if actual.nameLen == 0U64 || intern(c: inout self, start: actual.nameStart, len: actual.nameLen) != et.nameId {
                            allMatch = false
                        }
                    }
                }
            }
            ai += 1U64
        }
        if allMatch { return 2U64 }
        return 1U64
    }

    // An argument that is an unsuffixed integer literal carries no type name, so it
    // adapts to any integer parameter (argMatchesParam's last clause). Such an
    // argument is the only source of "one call matches two overloads": a typed value
    // matches exactly one parameter type.
    inout fn argIsUntypedIntLit(argExpr: U64) -> Bool {
        val ti: TypeInfo = self.argResolvedTypeInfo(argExpr: argExpr)
        if ti.kind == 0 {
            return ti.nameLen == 0
        }
        return false
    }

    // Two type-matching overloads are genuinely ambiguous for this call iff some
    // untyped integer-literal argument maps to differing parameter types between
    // them. (Overloads that agree on every provided arg type but differ only via
    // defaulted/omitted params are a separate concern, not flagged here.)
    inout fn overloadsAmbiguous(fa: Func, fb: Func, args: ArgRange) -> Bool {
        mut val i: U64 = 0
        while i < args.len {
            if self.argIsUntypedIntLit(argExpr: self.argAt(args: args, index: i).expr) {
                val pa: U64 = self.paramIndexForArg(params: fa.params, args: args, argIdx: i)
                val pb: U64 = self.paramIndexForArg(params: fb.params, args: args, argIdx: i)
                if pa < fa.params.count() {
                    if pb < fb.params.count() {
                        if self.funcParamAt(params: fa.params, index: pa).tyNameId != self.funcParamAt(params: fb.params, index: pb).tyNameId {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    // Loudly reject (exits) when the two type-matching overloads `a`/`b` are
    // ambiguous for this call — picking the first silently would invent meaning
    // (spec: 補完はする／忖度はしない／曖昧はエラー).
    inout fn checkOverloadAmbiguity(a: U64, b: U64, args: ArgRange) {
        if b != self.arena.funcs.count() {
            if self.overloadsAmbiguous(fa: self.arena.funcs[a], fb: self.arena.funcs[b], args: args) {
                mut val off: U64 = 0
                if args.len > 0 {
                    off = self.exprOffset(id: self.argAt(args: args, index: 0U64).expr)
                }
                self.errorAt(offset: off, msg: "ambiguous call: an unsuffixed integer literal matches more than one overload; add a type suffix (e.g. `5I32`)")
            }
        }
    }

    // Does some arm cover the variant (variantStart,variantLen)? A wildcard arm
    // covers everything.
    inout fn armCovers(arms: MatchArmRange, variantStart: U64, variantLen: U64) -> Bool {
        mut val i: U64 = 0
        while i < arms.len {
            val a: MatchArm = self.matchArmAt(arms: arms, index: i)
            if a.isWildcard {
                return true
            }
            if spansEqual(c: inout self, aStart: a.variantStart, aLen: a.variantLen, bStart: variantStart, bLen: variantLen) {
                return true
            }
            i += 1
        }
        return false
    }

    // Acceptance soundness: spec requires match to be exhaustive (Rust-style). A
    // match is exhaustive iff it has a `_` wildcard, or every variant of the
    // scrutinee's enum is covered by some arm. (This compiler's match is always
    // over an enum, and has no `val x` catch-all arm, so those are the only cases.)
    inout fn matchExhaustive(arms: MatchArmRange) -> Bool {
        mut val enumStart: U64 = 0
        mut val enumLen: U64 = 0
        mut val i: U64 = 0
        while i < arms.len {
            val a: MatchArm = self.matchArmAt(arms: arms, index: i)
            if a.isWildcard {
                return true
            }
            if enumLen == 0 {
                if a.enumLen > 0 {
                    enumStart = a.enumStart
                    enumLen = a.enumLen
                }
            }
            i += 1
        }
        if enumLen == 0 {
            return true
        }
        val qEnum: U64 = intern(c: inout self, start: enumStart, len: enumLen)
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val e: EnumDef = self.arena.enums[ei]
            if e.nameId == qEnum {
                val vars: Array[Variant] = e.variants
                mut val vi: U64 = 0
                while vi < vars.count() {
                    val v: Variant = vars[vi]
                    if !(self.armCovers(arms: arms, variantStart: v.nameStart, variantLen: v.nameLen)) {
                        return false
                    }
                    vi += 1
                }
                return true
            }
            ei += 1
        }
        return true
    }

    // Tag index of `Enum.Variant` (the variant's position in its enum declaration).
    inout fn variantIndex(enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> U64 {
        // an import alias (`with { Real as Alias }`) names the same enum as `Real`, so its
        // variants share the real enum's tag indices (spec/15).
        val arE: Bind = self.aliasReal(start: enumStart, len: enumLen)
        val qEnum: U64 = intern(c: inout self, start: arE.nameStart, len: arE.nameLen)
        val qVar: U64 = intern(c: inout self, start: variantStart, len: variantLen)
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            val e: EnumDef = self.arena.enums[ei]
            if e.nameId == qEnum {
                val vars: Array[Variant] = e.variants
                mut val vi: U64 = 0
                while vi < vars.count() {
                    val v: Variant = vars[vi]
                    if v.nameId == qVar {
                        return vi
                    }
                    vi += 1
                }
            }
            ei += 1
        }
        return 0
    }
}

pub impl Comp {

    // A source span whose bytes read `kw` (length `kwLen`). The type system recovers
    // a named type from a (start,len) span; some values have a known type with no
    // source span to point at (a string literal's `String`, `.bytes()`'s `U8`). Reuse
    // any occurrence of `kw` in the source as a label span (the match is purely the
    // bytes; a comment/string occurrence works too). nameLen=0 if `kw` never appears.
    // Append `kw`'s bytes to `c.arena.bytes` and record their span in `c.decls.kwCache`, so a
    // built-in name with no guaranteed source occurrence has a stable, addressable
    // span without scanning (or planting a comment in) the source.
    inout fn addKwSpan(kw: String) {
        val start: U64 = self.arena.bytes.count()
        val b: Array[U8] = kw.bytes()
        mut val i: U64 = 0
        while i < b.count() {
            self.arena.bytes.append(b[i])
            i += 1
        }
        self.decls.kwCache.append(<Bind nameStart=start nameLen=b.count() fieldStart=start fieldLen=b.count() />)
    }

    // Build the built-in-name span cache once (before any kwSpan use). Covers exactly
    // the names kwSpan is asked for. Appended after the lexed source, so token offsets
    // are unaffected.
    inout fn buildKwCache() {
        self.addKwSpan(kw: "String")
        self.addKwSpan(kw: "U8")
        self.addKwSpan(kw: "U64")
        self.addKwSpan(kw: "Bool")
        self.addKwSpan(kw: "Array")
        self.addKwSpan(kw: "Self")
        self.addKwSpan(kw: "fn")
        self.addKwSpan(kw: "iterator")
        self.addKwSpan(kw: "next")
        val langModule: U64 = self.modules.langModule
        mut val i: U64 = 0U64
        while i < self.arena.structs.count() {
            val candidate: StructDef = self.arena.structs[i]
            // StructDef.nameStart can be a re-interned span, whereas the
            // keyword cache deliberately uses a synthetic span. Compare the
            // declaration's immutable bytes here, once in the frontend, then
            // publish only its declaration identity to later consumers.
            if candidate.nameLen == 5U64 && rangeEquals(bytes: self.arena.bytes, start: candidate.nameStart, len: candidate.nameLen, kw: "Array") && candidate.defOffset != 0U64 && self.moduleOf(offset: candidate.defOffset) == langModule {
                // TypeRef.declOffset is the declaration's source identity.
                // `nameStart` is an interner span and can be reallocated while
                // loading later modules, so comparing it to a TypeRef's
                // declaration offset misclassifies the built-in Array as a
                // user Index witness. Keep this identity in its native form.
                self.langArrayDeclOffset = candidate.defOffset
                return
            }
            i += 1U64
        }
    }

    // Return a stable source span naming `kw`. O(1) lookup in the prebuilt cache; any
    // name not pre-cached falls back to a source scan (a len-0 Bind if absent, which
    // callers treat as "no span").
    inout fn kwSpan(kw: String, kwLen: U64) -> Bind {
        mut val ci: U64 = 0
        while ci < self.decls.kwCache.count() {
            val e: Bind = self.decls.kwCache[ci]
            if rangeEquals(bytes: self.arena.bytes, start: e.nameStart, len: e.nameLen, kw: kw) {
                return e
            }
            ci += 1
        }
        val n: U64 = self.arena.bytes.count()
        if n < kwLen {
            return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
        }
        mut val i: U64 = 0
        val last: U64 = n - kwLen
        while i <= last {
            if rangeEquals(bytes: self.arena.bytes, start: i, len: kwLen, kw: kw) {
                return <Bind nameStart=i nameLen=kwLen fieldStart=i fieldLen=kwLen />
            }
            i += 1
        }
        return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
    }

    // String literals are monomorphic (always `String`), so `val s = "hi"` infers
    // `String`; recover a "String" span to name PlewString (else require annotation).
    inout fn stringTypeSpan() -> Bind {
        return self.kwSpan(kw: "String", kwLen: 6)
    }

    inout fn typeInfoOfName(start: U64, len: U64, isArray: Bool) -> TypeInfo {
        // resolve an import alias (`with { Real as Alias }`) to the real name so the carried
        // type identity is canonical for downstream struct/field lookup (spec/15).
        val ar: Bind = self.aliasReal(start: start, len: len)
        val rs: U64 = ar.nameStart
        val rl: U64 = ar.nameLen
        if isArray {
            return <TypeInfo kind=3 nameStart=rs nameLen=rl ref=0 />
        }
        if rl == 0 {
            return scalarInfo()
        }
        if rangeEquals(bytes: self.arena.bytes, start: rs, len: rl, kw: "String") {
            return <TypeInfo kind=2 nameStart=rs nameLen=rl ref=0 />
        }
        if self.isPrimType(start: rs, len: rl) {
            // kind=0 (scalar) but carry the type name so the width is recoverable
            // (e.g. for the lossless-`as` check). The C type stays 64-bit for now.
            return <TypeInfo kind=0 nameStart=rs nameLen=rl ref=0 />
        }
        return <TypeInfo kind=2 nameStart=rs nameLen=rl ref=0 />
    }
}
