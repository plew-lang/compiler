// Part of name/type resolution (root: _.pw): expression type-cache table
// construction.

use ../../Ir only { SemanticTry, SemanticAggregateKind, SemanticTypeRecipe, CallArgumentSource, CallTemplateArgument, CallTemplateArgumentRange, CallTemplateTypeArgumentRange, CallTemplateOperandRange, CallTemplateViewRange, DynamicCallTemplateTarget, StaticMemberResolution }

pub impl Comp {

    // Recipe ids are one-based so Local's default 0 retains the ordinary
    // TypeTerm path.  This graph is semantic provenance, not type identity.
    inout fn pushSemanticTypeRecipe(recipe: SemanticTypeRecipe) -> U64 {
        self.arena.semanticTypeRecipes.append(recipe)
        return self.arena.semanticTypeRecipes.count()
    }

    inout fn semanticTypeRecipeTerm(term: U64) -> U64 {
        return self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=1U64 term=term />)
    }

    // Semantic elaboration can append expressions after initial lowering.
    // Every publisher owns allocation of its destination slot.
    inout fn ensureExprTySlot(exprId: U64) {
        mut val i: U64 = self.typeCache.kind.count()
        while i <= exprId {
            self.typeCache.kind.append(typeUnfilled())
            self.typeCache.start.append(0)
            self.typeCache.len.append(0)
            self.typeCache.ref.append(0)
            self.typeCache.viewId.append(0)
            self.typeCache.callee.append(<CachedCallee.Uncomputed />)
            self.typeCache.identBind.append(identUnfilledCode())
            self.typeCache.identTarget.append(identNoTarget())
            i += 1
        }
    }

    inout fn buildExprTyTable() {
        if self.arena.exprs.count() != 0U64 { self.ensureExprTySlot(exprId: self.arena.exprs.count() - 1U64) }
    }
}

pub impl Comp {

    inout fn syntheticRequiredTraitOwner(exprId: U64) -> U64 {
        val index = self.syntheticCallSiteIndex(exprId: exprId)
        if index >= self.decls.syntheticCallSites.count() { return 0U64 }
        match self.decls.syntheticCallSites[index].kind {
            SyntheticCallKind.IndexRead => { return self.coreTraitOwner(name: "Index", arity: 1U64) }
            SyntheticCallKind.IndexWrite => { return self.coreTraitOwner(name: "IndexSet", arity: 1U64) }
            SyntheticCallKind.Format => { return self.coreTraitOwner(name: "Format", arity: 0U64) }
            SyntheticCallKind.TextWrite => { return self.coreTraitOwner(name: "TextOutput", arity: 0U64) }
            SyntheticCallKind.Ordinary | SyntheticCallKind.Factory => { return 0U64 }
        }
    }

    fn missingSyntheticRequirement(exprId: U64) -> String {
        val index = self.syntheticCallSiteIndex(exprId: exprId)
        if index < self.decls.syntheticCallSites.count() {
            match self.decls.syntheticCallSites[index].kind {
                SyntheticCallKind.Format => { return "string interpolation requires a Format implementation" }
                SyntheticCallKind.TextWrite => { return "string construction requires a TextOutput implementation" }
                SyntheticCallKind.IndexRead | SyntheticCallKind.IndexWrite => { return "subscript requires an Index implementation for reading or an IndexSet implementation for writing" }
                SyntheticCallKind.Ordinary | SyntheticCallKind.Factory => {}
            }
        }
        return "no matching implementation for the synthesized call"
    }

    fn isFactoryCall(exprId: U64) -> Bool {
        val index = self.syntheticCallSiteIndex(exprId: exprId)
        if index >= self.decls.syntheticCallSites.count() { return false }
        match self.decls.syntheticCallSites[index].kind {
            SyntheticCallKind.Factory => { return true }
            _ => { return false }
        }
    }

    // Local source validity is checked before a parent asks for a value type.
    // The legacy verifier shares these rules while its walk is being retired.
    inout fn checkIdentifierValueBinding(binding: I64, offset: U64) -> Result[(), CompileDiagnostic] {
        if !(self.bindIsValue(code: binding)) {
            if binding == identFnCode() {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "a named function declaration cannot be used as a value; wrap it in an explicit closure (e.g. `fn(...) {{ return name(...) }}`) (spec/04)") />
            } else {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "undefined identifier: this name is not a local, parameter, or global in scope (a bare type name is valid only as an assoc-fn receiver like `Type.fn()`; a field of `self` needs `self.`) (spec/04)") />
            }
        }
        return <Result.Ok value=() />
    }

    inout fn checkReferenceDereference(ref: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if self.isWeakRefLikeInst(ref: ref) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "a weak reference cannot be dereferenced with `->` (its referent may be gone); call `upgrade()` to get an `Optional` strong reference, then `->` the unwrapped value (spec/03)") />
        }
        if !self.isStrongRefInst(ref: ref) {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "`->` requires a `Ref[T]` or `MutableRef[T]` on the left (it dereferences a reference cell's pointee)") />
        }
        return <Result.Ok value=() />
    }

    inout fn checkCallDeclarationKind(exprId: U64, declaration: Func) -> Result[(), CompileDiagnostic] {
        val construction = self.isFactoryCall(exprId: exprId)
        if construction != declaration.isFactory {
            val message = if construction { give "construction syntax requires a factory declaration" } else { give "a factory must be called using construction syntax" }
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: message) />
        }
        return <Result.Ok value=() />
    }

    inout fn writtenCallReceiverTemplate(exprId: U64, receiverExpr: U64) -> Result[CallTemplateReceiver, CompileDiagnostic] {
        val synthetic = self.syntheticCallSiteIndex(exprId: exprId)
        if synthetic < self.decls.syntheticCallSites.count() {
            val site = self.decls.syntheticCallSites[synthetic]
            if site.receiverIsType { return <Result.Ok value=<CallTemplateReceiver.Term term=site.receiverTerm /> /> }
        }
        return self.directReceiverTemplateForExpr(exprId: receiverExpr)
    }

    inout fn symbolicCallQualifierTerm(exprId: U64, receiverExpr: U64) -> U64 {
        val synthetic = self.syntheticCallSiteIndex(exprId: exprId)
        if synthetic < self.decls.syntheticCallSites.count() {
            val site = self.decls.syntheticCallSites[synthetic]
            if site.receiverIsType && site.receiverTerm != 0U64 && site.receiverTerm < self.arena.typeCount() {
                val receiver = self.arena.typeTerms[site.receiverTerm]
                if receiver.paramId != 0U64 || receiver.assocNameId != 0U64 { return site.receiverTerm }
            }
        }
        return self.typeParameterQualifierTerm(exprId: receiverExpr)
    }

    inout fn resolveWrittenMethod(exprId: U64, recv: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        val synthetic = self.syntheticCallSiteIndex(exprId: exprId)
        if synthetic < self.decls.syntheticCallSites.count() {
            match self.decls.syntheticCallSites[synthetic].selectedFactory {
                Optional.Some(v: val declaration) => { return <Result.Ok value=declaration /> }
                Optional.None => {}
            }
        }
        val requiredTraitOwner = self.syntheticRequiredTraitOwner(exprId: exprId)
        val method = try self.resolveMethodFinalForType(recv: recv, receiverType: (try self.typeOf(id: recv)), nameStart: nameStart, nameLen: nameLen, args: args, requiredTraitOwner: requiredTraitOwner)
        if method < self.arena.functionCount() || requiredTraitOwner != 0U64 { return <Result.Ok value=method /> }
        // Type-qualified associated calls share this source-selection entry
        // with value methods. Consumers must not repeat a bare-name lookup.
        val qualifier = self.assocRecvName(recv: recv)
        if qualifier.nameLen != 0U64 {
            val receiver = self.syntheticCallReceiverTerm(exprId: exprId, fallback: (try self.methodReceiverTerm(exprId: recv)))
            return self.findAssoc(recvStart: qualifier.nameStart, recvLen: qualifier.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: receiver)
        }
        return <Result.Ok value=method />
    }

    // Pre-resolved final callable for Call / Method / ExtMethod expression `id`.
    // The AST node owns the decision, including a `#` source key; verification,
    // type recovery and codegen therefore cannot drift by looking it up again.
    inout fn resolvedCallee(id: U64) -> Result[U64, CompileDiagnostic] {
        if id < self.typeCache.callee.count() {
            match self.typeCache.callee[id] {
                CachedCallee.Selected(val callee) => { return <Result.Ok value=callee />}
                CachedCallee.NoStaticCallee => { return <Result.Ok value=self.arena.functionCount() />}
                CachedCallee.Uncomputed => {}
            }
        }
        mut val r: U64 = self.arena.functionCount()
        match self.arena.exprs[id] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                // A lexical closure binding shadows a same-spelled free
                // function.  It has no static Func identity, so retain the
                // sentinel here; Mono records the closure target in CallResolution.
                val li: U64 = self.localIndexByName(start: nameStart, len: nameLen)
                if li >= self.cur.locals.count() || !(self.isFnType(ref: self.cur.locals[li].ty)) {
                    r = (try self.findFunc(nameStart: nameStart, nameLen: nameLen, args: args))
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // A generic body has an abstract requirement surface here. Its
                // concrete witness is intentionally selected by Mono under the
                // instantiated receiver, not cached from whatever conformers
                // happen to be loaded while lowering the template.
                mut val abstractBound: Bool = false
                match self.arena.exprs[recv] {
                    Expr.Ident(start: val rs, len: val rl) => {
                        val li: U64 = self.localIndexByName(start: rs, len: rl)
                        if li < self.cur.locals.count() {
                            val lo: Local = self.cur.locals[li]
                            abstractBound = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: lo.tyStart, len: lo.tyLen)
                        }
                    }
                    _ => {}
                }
                if !abstractBound {
                    r = (try self.resolveWrittenMethod(exprId: id, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args))
                }
            }
            Expr.ExtMethod(val recv, val source, val nameStart, val nameLen, val args) => {
                val src: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
                r = (try self.resolveExtMethodFinal(recv: recv, srcStart: src.start, srcLen: src.len, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args))
            }
            _ => {}
        }
        // A free call is lexical and stable immediately. A method's receiver may
        // need the body-local environment, so only verification records its final
        // decision after that environment has been installed.
        match self.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                if id < self.typeCache.callee.count() {
                    self.typeCache.callee.set(i: id, value: self.calleeCacheEntry(callee: r))
                }
            }
            _ => {}
        }
        return <Result.Ok value=r />
    }

    inout fn recordResolvedMethodCallee(id: U64, callee: U64) {
        if id < self.typeCache.callee.count() {
            self.typeCache.callee.set(i: id, value: self.calleeCacheEntry(callee: callee))
        }
    }

    fn calleeCacheEntry(callee: U64) -> CachedCallee {
        if callee < self.arena.functionCount() { return <CachedCallee.Selected callee=callee /> }
        return <CachedCallee.NoStaticCallee />
    }
}

pub impl Comp {

    // The TypeInfo for `id`'s recorded int context (scalarInfo if none) — the fallback
    // `typeOf` uses for a width-less expression whose type came only from context.
    inout fn exprIntCtxTypeInfo(id: U64) -> TypeInfo {
        if id < self.arena.semanticExprTypes.count() {
            val code: U64 = self.arena.semanticExprTypes[id].literalContext
            if code != 0 {
                val kw: String = intCtxKw(code: code)
                val b: Bind = self.kwSpan(kw: kw, kwLen: kw.bytes().count())
                if b.nameLen != 0 {
                    return <TypeInfo kind=0 nameStart=b.nameStart nameLen=b.nameLen ref=0 />
                }
            }
        }
        return scalarInfo()
    }

    // The result TypeRef of a desugared non-Optional `?.` at `exprId` (a Chain
    // rewrite), or 0 if this node isn't one — the site's PARAMETRIC result
    // (ChainSite.stageRef) grounded under the ACTIVE env, so every generic
    // instance reading the SHARED rewritten tree derives its own grounding (a
    // stored grounded result would freeze the first instance's types into all
    // later instantiations). Lets typeOf / exprTypeRef recover a Chain stage's
    // type without re-deriving it from the rewritten match's internal bindings
    // (needed for a nested `a?.x?.y`).
    inout fn chainResultRef(exprId: U64) -> Result[U64, CompileDiagnostic] {
        val site: ChainSite = self.chainSiteFor(exprId: exprId)
        if site.stageRef == 0 {
            return <Result.Ok value=0 />
        }
        return <Result.Ok value=(try self.groundTypeRef(ref: site.stageRef)) />
    }

    // The type of expression `id` — the typed-AST read path that codegen and the
    // checker use instead of re-deriving with `exprType`. The result is cached
    // PERSISTENTLY (one slot per expr id, allocated by buildExprTyTable, never
    // cleared). The cache is INSTANCE-INDEPENDENT by construction: a slot is written
    // only when no monomorphization env is active (recvInstRef 0 AND typeParams empty
    // — see the fill path below), so it only ever holds a type that is the same for
    // every instantiation. Reads always return the right type: a cached slot is
    // instance-independent; an unfilled slot recomputes fresh under the current env.
    //
    // Why the write is gated rather than unconditional: `exprType`'s env-dependent arms
    // (`self` under recvInstRef, a type-parameter local grounded under typeParams) yield
    // an instance-SPECIFIC type. The backend re-walks the SAME expr ids for every generic
    // instance (emitOneGenMethod swaps cur.typeParams/typeArgs), so writing one instance's
    // grounding into the shared slot would poison a sibling instance's read. Gating the
    // write leaves generic-body slots unfilled — they recompute per instance (perf is
    // secondary), which is exactly what the backend's env-aware exprTypeRef path already
    // does for most generic reads. (intCtx width-less recovery below stays env-independent
    // — it reads the checker-recorded literal context, not the live env.)
    inout fn typeOf(id: U64) -> Result[TypeInfo, CompileDiagnostic] {
        mut val t: TypeInfo = scalarInfo()
        if id < self.typeCache.kind.count() {
            if self.typeCache.kind[id] == typeUnfilled() {
                t = (try self.exprType(id: id))
                // Cache the result ONLY in an instance-independent context (no active
                // monomorphization env). Under a live env — `recvInstRef` set (front-end
                // mono), or `cur.typeParams` non-empty during backend generic-instance
                // emission (emitOneGenMethod re-walks the SAME expr ids per instance,
                // swapping typeParams/typeArgs) — exprType grounds type-parameter nodes to
                // THIS instance's concrete types. Writing that into the persistent expr-id
                // slot (shared across every instantiation) would poison reads from a sibling
                // instance. So we return the fresh instance-specific type WITHOUT caching:
                // a generic body's slots stay unfilled and are recomputed per instance (perf
                // is secondary). Non-generic bodies always fill — their env is clear.
                if self.cur.recvInstRef == 0U64 && self.cur.typeParams.count() == 0U64 && self.cur.selfRef == 0U64 && self.cur.itemRef == 0U64 {
                    self.typeCache.kind[id] = t.kind
                    self.typeCache.start[id] = t.nameStart
                    self.typeCache.len[id] = t.nameLen
                    self.typeCache.ref[id] = t.ref
                    self.typeCache.viewId[id] = t.viewExtId
                }
            } else {
                t = <TypeInfo kind=self.typeCache.kind[id] nameStart=self.typeCache.start[id] nameLen=self.typeCache.len[id] ref=self.typeCache.ref[id] viewExtId=self.typeCache.viewId[id] />
            }
        } else {
            t = (try self.exprType(id: id))
        }
        // width-less recovery: a form whose type came only from context (`0-1` in an
        // `I32` binding, `match{...}+1`) is type-less to the structural recovery but the
        // checker recorded its int context — use it so the op routes through the witness.
        // Read fresh (not cached) since semantic literal context is filled during checking.
        if t.kind == 0 {
            if t.nameLen == 0 {
                val ctx: TypeInfo = self.exprIntCtxTypeInfo(id: id)
                if ctx.nameLen != 0 {
                    return <Result.Ok value=ctx />
                }
            }
        }
        return <Result.Ok value=t />
    }

    // The structured TypeRef for a recovered TypeInfo, for the typed-IR store: like
    // tyRefOfInfo but RECONSTRUCTING an array's full `Array[E]` form from the kind-3
    // element-name view when the producer carried no ref. tyRefOfInfo itself keeps
    // kind-3 -> 0 (its generic-type-arg callers defer arrays deliberately); the store
    // needs the full form — the struct-idx facet its consumers see. The element name
    // resolves via the registered array-element table (a mangled nested/compound
    // element included) or interns as a plain head name (a type-param element `T`
    // stays parametric and grounds per instance).
    // The `Array[E]` TypeRef for an element ref.
    inout fn arrayRefOfElem(elemRef: U64) -> U64 {
        val ab: Bind = self.kwSpan(kw: "Array", kwLen: 5)
        mut val args: Array[U64] = []
        args.append(elemRef)
        return self.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    inout fn typedIrRefOfInfo(ti: TypeInfo) -> U64 {
        if ti.ref == 0U64 && ti.kind == 3 && ti.nameLen > 0U64 {
            mut val er: U64 = self.arrayElemRef(start: ti.nameStart, len: ti.nameLen)
            if er == 0U64 {
                er = self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
            }
            if er != 0U64 {
                return self.arrayRefOfElem(elemRef: er)
            }
        }
        return self.tyRefOfInfo(ti: ti)
    }

    // The only write/read boundary for expression semantic types.  Legacy
    // TypeInfo is deliberately carried as an adapter payload while its many
    // consumers migrate; TypeTerm, shape and literal context nevertheless
    // share one ExprId-keyed entry rather than parallel caches.
    inout fn semanticExprShape(ti: TypeInfo) -> U64 {
        if ti.ref != 0U64 && ti.ref < self.arena.typeCount() {
            if self.arena.typeTerms[ti.ref].isAny { return 6U64 }
            if self.isFnType(ref: ti.ref) { return 5U64 }
        }
        if ti.kind == 3I64 { return 4U64 }
        if ti.kind == 2I64 { return 3U64 }
        if ti.kind == 1I64 { return 2U64 }
        if ti.nameLen != 0U64 { return 1U64 }
        return 0U64
    }

    inout fn checkCallTemplateTypeArguments(arguments: CallTemplateTypeArgumentRange, parameterCount: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if arguments.len != parameterCount || arguments.start > self.decls.callTemplateTypeArgumentPool.count() || arguments.len > self.decls.callTemplateTypeArgumentPool.count() - arguments.start {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "cannot infer all type arguments for this call") />
        }
        mut val index = 0U64
        while index < arguments.len {
            val term = self.decls.callTemplateTypeArgumentPool[arguments.start + index]
            if term == 0U64 || term >= self.arena.typeCount() { return <Result.Err error=self.diagnosticAt(offset: offset, msg: "cannot infer all type arguments for this call") /> }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn ensureSemanticExprType(exprId: U64) {
        while self.arena.semanticExprTypes.count() <= exprId {
            self.arena.semanticExprTypes.append(<SemanticExprType />)
        }
    }

    // Only a direct polymorphic literal takes its type from an explicit cast.
    // A newtype boundary supplies its declared immediate underlying type;
    // following further wrappers would invent additional implicit casts.
    inout fn castLiteralContextTerm(operand: U64, targetTerm: U64) -> U64 {
        if targetTerm == 0U64 || targetTerm >= self.arena.typeCount() { return 0U64 }
        mut val isFloat: Bool = false
        match self.arena.exprs[operand] {
            Expr.Int(value: _, offset: _, isBool: val isBool, tyStart: _, tyLen: val suffixLen, isNeg: _) => {
                if isBool || suffixLen != 0U64 { return 0U64 }
            }
            Expr.Float(start: _, len: _, tyStart: _, tyLen: val suffixLen) => {
                if suffixLen != 0U64 { return 0U64 }
                isFloat = true
            }
            _ => { return 0U64 }
        }
        mut val contextTerm: U64 = targetTerm
        val target = self.arena.typeAt(index: targetTerm)
        if target.hasDecl {
            val underlying = self.arena.newtypeUnderlyingByOffset(offset: target.declOffset)
            if underlying != 0U64 { contextTerm = underlying }
        }
        if contextTerm >= self.arena.typeCount() { return 0U64 }
        val context = self.arena.typeAt(index: contextTerm)
        if context.paramId != 0U64 || context.assocNameId != 0U64 { return 0U64 }
        if self.isFloatType(start: context.nameStart, len: context.nameLen) { return contextTerm }
        if !isFloat && self.isIntType(start: context.nameStart, len: context.nameLen) { return contextTerm }
        return 0U64
    }

    fn hasSemanticExprTypeFact(exprId: U64) -> Bool {
        if exprId >= self.arena.semanticExprTypes.count() { return false }
        match self.arena.semanticExprTypes[exprId].typeState {
            SemanticExpressionTypeState.Unrecorded => { return false }
            _ => { return true }
        }
    }

    // A zero term is unresolved here. Unit is established only by an explicit
    // empty-record term or a selected callable's completed result signature.
    inout fn refinedSemanticTypeState(prior: SemanticExpressionTypeState, term: U64) -> SemanticExpressionTypeState {
        match prior {
            SemanticExpressionTypeState.NoNormalValue => { return prior }
            SemanticExpressionTypeState.Unit => { if term == 0U64 { return prior } }
            _ => {}
        }
        if term == 0U64 || term >= self.arena.typeCount() { return <SemanticExpressionTypeState.Pending /> }
        if self.callableResultIsUnit(ref: term) { return <SemanticExpressionTypeState.Unit /> }
        return <SemanticExpressionTypeState.Value />
    }

    inout fn semanticExprTerm(exprId: U64) -> U64 {
        if exprId < self.arena.semanticExprTypes.count() {
            return self.arena.semanticExprTypes[exprId].term
        }
        return 0U64
    }

    // Readiness belongs to the lexical owner, not to a specialization or to
    // a global phase toggle. Provided copies consume their source's templates.
    inout fn callTemplatesClosedForBody(fnIdx: U64) -> Result[Bool, CompileDiagnostic] {
        if fnIdx >= self.arena.functionCount() {
            if self.globalCallTemplatesClosed { return <Result.Ok value=true />}
            if self.cur.inClosure && fnIdx == self.closureBodyKey(closureId: self.cur.closureId) {
                return <Result.Ok value=self.cur.closureCallTemplatesClosed />
            }
            match self.cur.globalInitializerTarget {
                Optional.Some(v: val target) => { return <Result.Ok value=self.globalInitializerPrepared(target: target) />}
                Optional.None => { return <Result.Ok value=false />}
            }
        }
        val owner = (try self.semanticBodyOwner(fnIdx: fnIdx))
        return <Result.Ok value=owner < self.closedCallTemplateBodies.count() && self.closedCallTemplateBodies[owner] />
    }

    // A selection can be published before its substitution is complete.
    // Closing the owner proves the descriptor is ready; it never turns a
    // missing substitution into a successful semantic check.
    inout fn checkCallTemplateSelection(templateIndex: U64) -> Result[(), CompileDiagnostic] {
        val template = self.decls.callTemplates[templateIndex]
        val offset = template.siteKey.originStart
        match template.kind {
            CallTemplateKind.Pending => {
                return <Result.Err error=self.diagnosticAt(offset: offset, msg: "cannot resolve this call from the available context") />
            }
            CallTemplateKind.Direct(val callee, receiver: _, val args, val calleeTypeArgs, proofId: _) => {
                if callee >= self.arena.functionCount() {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected call has no declaration") />
                }
                val function = self.arena.functionAt(index: callee)
                if self.traceCodegen {
                    eprint(text: "[trace-codegen] seal-direct owner=")
                    eprintU64(n: template.siteKey.ownerFnIdx)
                    eprint(text: " callee=")
                    eprintU64(n: callee)
                    eprint(text: " expected-args=")
                    eprintU64(n: function.typeParams.count())
                    eprint(text: " saved-args=")
                    eprintU64(n: calleeTypeArgs.len)
                    eprint(text: " receiver=")
                    self.traceMonoTypeHead(ref: template.receiverTypeTerm)
                    eprint(text: "\n")
                }
                try self.checkCallTemplateTypeArguments(arguments: calleeTypeArgs, parameterCount: function.typeParams.count(), offset: offset)
                if (function.hasRecv || function.isAssoc) && template.receiverTypeTerm == 0U64 {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "cannot establish the selected call's receiver type") />
                }
                try self.checkCallTemplateArguments(args: args, parameterCount: function.params.count(), offset: offset)
            }
            CallTemplateKind.StaticMethod(receiver: _, args: val args, resolution: val resolution, methodTypeArgs: val typeArgs, resultTerm: _) => {
                val function = try self.selectedStaticCallDeclaration(resolution: resolution, offset: offset)
                try self.checkCallTemplateTypeArguments(arguments: typeArgs, parameterCount: function.typeParams.count(), offset: offset)
                try self.checkCallTemplateArguments(args: args, parameterCount: function.params.count(), offset: offset)
            }
            CallTemplateKind.Operator(op: _, operands: val operands, resolution: val selection, resultTerm: _) => {
                if operands.len == 0U64 || operands.len > 2U64 || operands.start > self.decls.callTemplateOperandPool.count() || operands.len > self.decls.callTemplateOperandPool.count() - operands.start {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected operator has an incomplete operand plan") />
                }
                mut val parameterCount = operands.len
                match selection {
                    OperatorSelection.Pending => {
                        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "cannot resolve this operator from the available context") />
                    }
                    OperatorSelection.Direct(callee: val callee) => {
                        if callee >= self.arena.functionCount() {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected operator has no declaration") />
                        }
                        parameterCount = self.arena.functionAt(index: callee).params.count()
                    }
                    OperatorSelection.Static(resolution: val resolution) => {
                        parameterCount = (try self.selectedStaticCallDeclaration(resolution: resolution, offset: offset)).params.count()
                    }
                    OperatorSelection.Primitive => {}
                }
                if parameterCount != operands.len {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected operator operands do not match its signature") />
                }
            }
            CallTemplateKind.Dynamic(receiver: _, args: val args, target: val target) => {
                mut val parameterCount = 0U64
                mut val signature = 0U64
                match target {
                    DynamicCallTemplateTarget.ClosureLocal(bindingDeclStart: _, fnTypeTerm: val term) => { signature = term }
                    DynamicCallTemplateTarget.ClosureField(fieldIndex: _, fnTypeTerm: val term) => { signature = term }
                    DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: val traitIndex, slot: val slot) => {
                        if traitIndex >= self.decls.traitCount() || slot == 0U64 {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected dynamic call has no requirement") />
                        }
                        val requirements = self.decls.traitAt(index: traitIndex).reqs
                        if slot > requirements.count() {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected dynamic call has no requirement") />
                        }
                        parameterCount = self.traitReqAt(reqs: requirements, index: slot - 1U64).params.count()
                    }
                }
                match target {
                    DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: _, slot: _) => {}
                    _ => {
                        if signature == 0U64 || signature >= self.arena.typeCount() || !self.isFnType(ref: signature) {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected closure call has no function signature") />
                        }
                        val signatureArguments = self.arena.typeAt(index: signature).args
                        if signatureArguments.count() == 0U64 {
                            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected closure call has an incomplete signature") />
                        }
                        parameterCount = signatureArguments.count() - 1U64
                    }
                }
                try self.checkCallTemplateArguments(args: args, parameterCount: parameterCount, offset: offset)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // Every selected call family uses the same frozen parameter-order plan.
    inout fn checkCallTemplateArguments(args: CallTemplateArgumentRange, parameterCount: U64, offset: U64) -> Result[(), CompileDiagnostic] {
        if args.len != parameterCount || args.start > self.decls.callTemplateArgumentPool.count() || args.len > self.decls.callTemplateArgumentPool.count() - args.start {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: selected call has an incomplete argument plan") />
        }
        return <Result.Ok value=() />
    }

    // Consume a declaration and proof already selected by Record. Do not
    // retry member lookup if the recorded selection is missing or malformed.
    inout fn selectedStaticCallDeclaration(resolution: StaticMemberResolution, offset: U64) -> Result[Func, CompileDiagnostic] {
        match resolution {
            StaticMemberResolution.Requirement(proof: val proof, traitIdx: val traitIndex, reqIdx: val requirement) => {
                if !self.proofIsMissing(proof: proof) && traitIndex < self.decls.traitCount() {
                    val requirements = self.decls.traitAt(index: traitIndex).reqs
                    if requirement < requirements.count() { return <Result.Ok value=self.traitReqAt(reqs: requirements, index: requirement) /> }
                }
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: val traitIndex, callee: val callee) => {
                if !self.proofIsMissing(proof: proof) && traitIndex < self.decls.traitCount() && callee < self.arena.functionCount() {
                    return <Result.Ok value=self.arena.functionAt(index: callee) />
                }
            }
            StaticMemberResolution.Missing => {}
        }
        return <Result.Err error=self.diagnosticAt(offset: offset, msg: "internal error: static call has no selected declaration and proof") />
    }

    inout fn checkBodyCallTemplateSelections(owner: U64) -> Result[(), CompileDiagnostic] {
        mut val row = self.firstLexicalCallTemplate(owner: owner)
        while row != 0U64 {
            val index = row - 1U64
            try self.checkCallTemplateSelection(templateIndex: index)
            row = self.decls.callTemplateBodyNext[index]
        }
        return <Result.Ok value=() />
    }

    inout fn closeCallTemplatesForBody(fnIdx: U64) -> Result[(), CompileDiagnostic] {
        if fnIdx >= self.arena.functionCount() {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: lexical call closure has no declaration") />
        }
        val owner = (try self.semanticBodyOwner(fnIdx: fnIdx))
        if owner < self.closedCallTemplateBodies.count() && self.closedCallTemplateBodies[owner] { return <Result.Ok value=() /> }
        try self.checkBodyCallTemplateSelections(owner: owner)
        while self.closedCallTemplateBodies.count() <= owner {
            self.closedCallTemplateBodies.append(false)
        }
        self.closedCallTemplateBodies.set(i: owner, value: true)
        return <Result.Ok value=() />
    }

    // Ordinary compilation completes the entire source frontier before Mono.
    // There is deliberately no operation that reopens a completed owner.
    inout fn closeProgramCallTemplates() -> Result[(), CompileDiagnostic] {
        mut val index: U64 = 0U64
        while index < self.arena.functionCount() {
            try self.closeCallTemplatesForBody(fnIdx: index)
            index += 1U64
        }
        try self.checkBodyCallTemplateSelections(owner: 18446744073709551615U64)
        // Selection and expected-result completion are now stable. Compute
        // access demand once, rather than rebuilding it at every Record update.
        mut val required: Dictionary[U64, Bool] = [:]
        index = 0U64
        while index < self.decls.callTemplates.count() {
            val template = self.decls.callTemplates[index]
            if !required.getOr(key: template.siteKey.ownerFnIdx, fallback: false) {
                if self.recordedCallHasStorageArguments(kind: template.kind) {
                    required[template.siteKey.ownerFnIdx] = true
                } else {
                    self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=template.siteKey resultTypeRecipe=template.resultTypeRecipe kind=template.kind expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm mayHaveStorageArguments=false />)
                }
            }
            // Unexamined sites retain the conservative true default. Once an
            // owner is required, further precision cannot remove its body.
            index += 1U64
        }
        self.globalCallTemplatesClosed = true
        return <Result.Ok value=() />
    }

    // A source declaration body is the stable owner of a parametric call
    // template. Globals use a fixed sentinel: lazy preparation may append Func
    // rows, so the current function count cannot be a persistent owner key.
    inout fn callTemplateOwner(fnIdx: U64) -> U64 {
        // Synthetic closure keys already have a stable identity. Collapsing
        // them to the global owner aliases unrelated semantic body facts.
        if fnIdx < self.arena.functionCount() || fnIdx >= 9223372036854775808U64 { return fnIdx }
        return 18446744073709551615U64
    }

    // The source annotation may be absent while the callable still returns a
    // value: an async declaration without an annotation returns a value-less
    // Promise. Keep this separate from semanticBodyReturnTerm's Unit result.
    inout fn semanticCallableReturnTerm(function: Func) -> U64 {
        if function.isAsync && !function.hasRet {
            val promise = self.internBytes(s: "Promise")
            return self.pushType(t: <TypeRef nameStart=promise.nameStart nameLen=promise.nameLen args=[0U64] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
        }
        return function.retTy
    }

    // Source bodies expose their logical result, distinct from the async
    // callable boundary. Promise wrapping belongs to entry/completion lowering.
    // Closure facts are published before walking the nested body in Record.
    inout fn semanticBodyReturnTerm(fnIdx: U64) -> U64 {
        if fnIdx < self.arena.functionCount() {
            val function: Func = self.arena.functionAt(index: fnIdx)
            if !function.hasRet { return 0U64 }
            if function.isAsync && function.retTy != 0U64 && function.retTy < self.arena.typeCount() {
                val result: TypeRef = self.arena.typeAt(index: function.retTy)
                if rangeEquals(bytes: self.arena.bytes, start: result.nameStart, len: result.nameLen, kw: "Promise") && result.args.count() == 1U64 {
                    return result.args[0U64]
                }
            }
            return function.retTy
        }
        mut val index: U64 = 0U64
        while index < self.decls.semanticClosures.count() {
            val closure: SemanticClosure = self.decls.semanticClosures[index]
            if closure.bodyKey == fnIdx { return closure.returnTypeTerm }
            index += 1U64
        }
        return 0U64
    }

    // Signature Self remains abstract at the public boundary. Context inside
    // the declaration uses its lexical receiver, including its own binders.
    inout fn semanticBodyReturnContext(fnIdx: U64) -> U64 {
        val term = self.semanticBodyReturnTerm(fnIdx: fnIdx)
        if fnIdx >= self.arena.functionCount() { return term }
        return self.groundTermInEnvironment(ref: term, params: [], values: [], selfRef: self.parametricSelfRef(f: self.arena.functionAt(index: fnIdx)))
    }

    // A conferred callable executes an authored body under its own proof.
    // All declaration-time facts (calls, aggregates, matches and closures)
    // belong to that shared source body. The copy records its exact owner;
    // matching names or scanning for a coincidentally equal body is unnecessary.
    // Default generators have independent executable bodies and retain their
    // own fact identity even though they share a lexical binder environment.
    inout fn semanticBodyOwner(fnIdx: U64) -> Result[U64, CompileDiagnostic] {
        if fnIdx >= self.arena.functionCount() { return <Result.Ok value=self.callTemplateOwner(fnIdx: fnIdx) />}
        val selected: Func = self.arena.functionAt(index: fnIdx)
        if !(selected.isProvided) { return <Result.Ok value=fnIdx />}
        if selected.lexicalOwnerFnId == 0U64 || selected.lexicalOwnerFnId > self.arena.functionCount() {
            return <Result.Err error=self.diagnosticAt(offset: selected.defOffset, msg: "internal error: provided body has no source owner") />
        }
        val owner: U64 = selected.lexicalOwnerFnId - 1U64
        val declaration: Func = self.arena.functionAt(index: owner)
        if declaration.lexicalOwnerFnId != 0U64 || declaration.body != selected.body {
            return <Result.Err error=self.diagnosticAt(offset: selected.defOffset, msg: "internal error: provided source owner does not own its body") />
        }
        return <Result.Ok value=owner />
    }

    // Source calls are identified by the declaration body plus their complete
    // parsed span.  The arena index remains an implementation-navigation aid
    // only; using it as semantic identity made generated/shared bodies alias.
    inout fn sourceCallSiteKey(fnIdx: U64, exprId: U64, slot: U64 = 0U64) -> Result[CallSiteKey, CompileDiagnostic] {
        val owner: U64 = self.callTemplateOwner(fnIdx: (try self.semanticBodyOwner(fnIdx: fnIdx)))
        mut val start: U64 = 0U64
        mut val end: U64 = 0U64
        mut val serial: U64 = 0U64
        if exprId < self.arena.exprSpanStart.count() { start = self.arena.exprSpanStart[exprId] }
        if exprId < self.arena.exprSpanEnd.count() { end = self.arena.exprSpanEnd[exprId] }
        if exprId < self.arena.exprOriginSerial.count() { serial = self.arena.exprOriginSerial[exprId] }
        return <Result.Ok value=<CallSiteKey ownerFnIdx=owner originKind=1U64 originStart=start originEnd=end originSerial=serial slot=slot /> />
    }

    // Synthetic calls are created by several lowering rules, but their origin
    // has exactly one producer. Keep the semantic row and its ExprId
    // navigation index together here so readers never rediscover provenance by
    // scanning every lowered call in the compilation.
    inout fn recordSyntheticCallSite(site: SyntheticCallSite) -> Result[(), CompileDiagnostic] {
        while self.decls.syntheticCallSiteByExpr.count() <= site.exprId {
            self.decls.syntheticCallSiteByExpr.append(0U64)
        }
        if self.decls.syntheticCallSiteByExpr[site.exprId] != 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: site.exprId), msg: "internal error: synthetic call origin registered twice") />
        }
        self.decls.syntheticCallSites.append(site)
        self.decls.syntheticCallSiteByExpr.set(i: site.exprId, value: self.decls.syntheticCallSites.count())
        return <Result.Ok value=() />
    }

    // Return the semantic-table count when ExprId has no synthetic origin.
    // This mirrors the other canonical fact readers: callers can distinguish a
    // missing descriptor without inventing an ExprId-based semantic identity.
    fn syntheticCallSiteIndex(exprId: U64) -> U64 {
        if exprId < self.decls.syntheticCallSiteByExpr.count() {
            val entry: U64 = self.decls.syntheticCallSiteByExpr[exprId]
            if entry != 0U64 { return entry - 1U64 }
        }
        return self.decls.syntheticCallSites.count()
    }

    // The semantic identity of a call template uses the same origin namespace
    // as the final descriptor.  Lowered calls have no independent source span:
    // treating them as written calls here while Mono reads them as synthetic
    // made one body own two unrelated keys, so a finalized generic body could
    // not find the template that created its call.  `exprId` remains only the
    // navigation anchor for locating the producer-assigned serial.
    inout fn templateCallSiteKey(fnIdx: U64, exprId: U64, slot: U64 = 0U64) -> Result[CallSiteKey, CompileDiagnostic] {
        val owner: U64 = self.callTemplateOwner(fnIdx: (try self.semanticBodyOwner(fnIdx: fnIdx)))
        val index: U64 = self.syntheticCallSiteIndex(exprId: exprId)
        if index < self.decls.syntheticCallSites.count() {
            val synthetic: SyntheticCallSite = self.decls.syntheticCallSites[index]
            return <Result.Ok value=<CallSiteKey ownerFnIdx=owner originKind=2U64 originSerial=synthetic.originSerial slot=slot /> />
        }
        return <Result.Ok value=(try self.sourceCallSiteKey(fnIdx: fnIdx, exprId: exprId, slot: slot)) />
    }

    // `for` protocol calls have no Expr node. Their template key must match
    // Mono's statement-site final descriptor key exactly.
    inout fn templateProtocolSiteKey(fnIdx: U64, stmtId: U64, slot: U64) -> Result[CallSiteKey, CompileDiagnostic] {
        val owner: U64 = self.callTemplateOwner(fnIdx: (try self.semanticBodyOwner(fnIdx: fnIdx)))
        mut val start: U64 = 0U64
        mut val end: U64 = 0U64
        if stmtId < self.arena.stmts.count() {
            match self.arena.stmts[stmtId] {
                Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, varTy: _, val iter, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => {
                    start = self.exprOffset(id: iter)
                    if iter < self.arena.exprSpanEnd.count() { end = self.arena.exprSpanEnd[iter] }
                }
                _ => {}
            }
        }
        return <Result.Ok value=<CallSiteKey ownerFnIdx=owner originKind=3U64 originStart=start originEnd=end originSerial=stmtId + 1U64 slot=slot /> />
    }

    fn sameCallSiteKey(a: CallSiteKey, b: CallSiteKey) -> Bool {
        return a.sameKey(other: b)
    }

    // A CallTemplate's selection belongs to its lexical source declaration,
    // whereas a final CallResolution belongs to the BodyInstance that happens
    // to evaluate it.  These normally have the same owner.  They deliberately
    // differ for a parameter default: its expression is declared on the callee
    // but evaluated in each caller.  Origin is therefore the stable bridge for
    // that one cross-body execution case; `ownerFnIdx` remains part of the
    // full key used for template storage and final-resolution publication.
    fn sameCallSiteOrigin(a: CallSiteKey, b: CallSiteKey) -> Bool {
        return a.originKind == b.originKind && a.originStart == b.originStart && a.originEnd == b.originEnd && a.originSerial == b.originSerial && a.slot == b.slot
    }



    inout fn rebuildCallTemplateIndex(capacity: U64) {
        self.decls.callTemplateIndexSlots = []
        val emptyOwners: Dictionary[U64, U64] = [:]
        self.decls.callTemplateBodyHeads = emptyOwners
        self.decls.callTemplateBodyTails = emptyOwners
        self.decls.callTemplateBodyNext = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.decls.callTemplateIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.decls.callTemplates.count() {
            val siteKey: CallSiteKey = self.decls.callTemplates[entry].siteKey
            mut val slot: U64 = siteKey.lookupHash() % capacity
            while self.decls.callTemplateIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.decls.callTemplateIndexSlots.set(i: slot, value: entry + 1U64)
            self.indexLexicalCallTemplate(templateIndex: entry)
            entry += 1U64
        }
    }

    inout fn ensureCallTemplateIndex(nextCount: U64) {
        if self.decls.callTemplateIndexSlots.count() == 0U64 {
            self.rebuildCallTemplateIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.decls.callTemplateIndexSlots.count() * 7U64 {
            self.rebuildCallTemplateIndex(capacity: self.decls.callTemplateIndexSlots.count() * 2U64)
        }
    }

    // This summary is published at Record, while source argument modes and
    // the selected signature are available. Mid never reopens source syntax.
    fn sourceArgumentUsesStorage(exprId: U64) -> Bool {
        if exprId >= self.arena.exprs.count() { return true }
        match self.arena.exprs[exprId] {
            Expr.Move(operand: _, isBorrow: _) => { return true }
            Expr.Cast(operand: val operand, tyStart: _, tyLen: _, ty: _) => { return self.sourceArgumentUsesStorage(exprId: operand) }
            Expr.ExtView(recv: val operand, source: _, strip: _) => { return self.sourceArgumentUsesStorage(exprId: operand) }
            _ => { return false }
        }
    }

    fn callSourceUsesStorage(source: CallArgumentSource) -> Bool {
        match source {
            CallArgumentSource.Term(exprId: val exprId, term: _) => { return self.sourceArgumentUsesStorage(exprId: exprId) }
            CallArgumentSource.Local(exprId: val exprId, declarationTarget: _, term: _) => { return self.sourceArgumentUsesStorage(exprId: exprId) }
            CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: _) => { return self.sourceArgumentUsesStorage(exprId: exprId) }
            CallArgumentSource.Legacy(exprId: _, info: _) => { return true }
        }
    }

    fn signatureHasStorageParameters(function: Func) -> Bool {
        mut val index = 0U64
        while index < function.params.count() {
            val parameter = self.funcParamAt(params: function.params, index: index)
            if parameter.isBorrow || parameter.isMove || parameter.isInout { return true }
            index += 1U64
        }
        return false
    }

    fn staticSelectionHasStorageParameters(resolution: StaticMemberResolution) -> Bool {
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val traitIndex, reqIdx: val requirement) => {
                if traitIndex >= self.decls.traitCount() { return true }
                val requirements = self.decls.traitAt(index: traitIndex).reqs
                if requirement >= requirements.count() { return true }
                return self.signatureHasStorageParameters(function: self.traitReqAt(reqs: requirements, index: requirement))
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => {
                if callee >= self.arena.functionCount() { return true }
                return self.signatureHasStorageParameters(function: self.arena.functionAt(index: callee))
            }
            StaticMemberResolution.Missing => { return true }
        }
    }

    fn recordedCallHasStorageArguments(kind: CallTemplateKind) -> Bool {
        mut val arguments = <CallTemplateArgumentRange start=0U64 len=0U64 />
        match kind {
            CallTemplateKind.ExpectedValue => { return false }
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: val args, calleeTypeArgs: _, proofId: _) => {
                if callee >= self.arena.functionCount() || self.signatureHasStorageParameters(function: self.arena.functionAt(index: callee)) { return true }
                arguments = args
            }
            CallTemplateKind.StaticMethod(receiver: _, args: val args, resolution: val resolution, methodTypeArgs: _, resultTerm: _) => {
                if self.staticSelectionHasStorageParameters(resolution: resolution) { return true }
                arguments = args
            }
            CallTemplateKind.Operator(op: _, operands: val operands, resolution: _, resultTerm: _) => {
                // Operators have no separate receiver or implicit inout
                // arguments in parametric Mid. Only the recorded operands can
                // introduce a language storage borrow/move at this stage;
                // a missing static witness is not itself a storage argument.
                // Concrete passing and ownership are still verified later.
                if operands.start + operands.len > self.decls.callTemplateOperandPool.count() { return true }
                mut val index = 0U64
                while index < operands.len {
                    if self.callSourceUsesStorage(source: self.decls.callTemplateOperandPool[operands.start + index]) { return true }
                    index += 1U64
                }
                return false
            }
            _ => { return true }
        }
        if arguments.start + arguments.len > self.decls.callTemplateArgumentPool.count() { return true }
        mut val index = 0U64
        while index < arguments.len {
            val argument = self.decls.callTemplateArgumentPool[arguments.start + index]
            if argument.isInout || argument.isDispatchReceiver || self.callSourceUsesStorage(source: argument.source) { return true }
            index += 1U64
        }
        return false
    }

    inout fn appendCallTemplate(template: CallTemplate) {
        self.ensureCallTemplateIndex(nextCount: self.decls.callTemplates.count() + 1U64)
        val resultRecipe = self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 callSite=template.siteKey />)
        self.decls.callTemplates.append(<CallTemplate siteKey=template.siteKey resultTypeRecipe=resultRecipe kind=template.kind expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm />)
        val capacity: U64 = self.decls.callTemplateIndexSlots.count()
        mut val slot: U64 = template.siteKey.lookupHash() % capacity
        while self.decls.callTemplateIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.decls.callTemplateIndexSlots.set(i: slot, value: self.decls.callTemplates.count())
        self.indexLexicalCallTemplate(templateIndex: self.decls.callTemplates.count() - 1U64)
    }

    // Lists hold one-based rows, with zero as the end sentinel. Closure facts
    // are published before their calls, so grouping never depends on Cursor.
    inout fn indexLexicalCallTemplate(templateIndex: U64) {
        val owner = self.decls.callTemplates[templateIndex].siteKey.ownerFnIdx
        val root = self.decls.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        val tail = self.decls.callTemplateBodyTails.getOr(key: root, fallback: 0U64)
        self.decls.callTemplateBodyNext.append(0U64)
        if tail == 0U64 {
            self.decls.callTemplateBodyHeads[root] = templateIndex + 1U64
        } else {
            self.decls.callTemplateBodyNext.set(i: tail - 1U64, value: templateIndex + 1U64)
        }
        self.decls.callTemplateBodyTails[root] = templateIndex + 1U64
    }

    fn firstLexicalCallTemplate(owner: U64) -> U64 {
        val root = self.decls.callTemplateLexicalRoots.getOr(key: owner, fallback: owner)
        return self.decls.callTemplateBodyHeads.getOr(key: root, fallback: 0U64)
    }



    // Direct calls use the same source algebra as operators. The argument
    // syntax is copied once at Record time; Mono later grounds this immutable
    // template and must not inspect a shared Expr to rediscover labels, inout,
    // or an argument's parametric type.
    inout fn directCallTemplateArgs(args: ArgRange) -> Result[CallTemplateArgumentRange, CompileDiagnostic] {
        val start: U64 = self.decls.callTemplateArgumentPool.count()
        mut val i: U64 = 0U64
        while i < args.len {
            val arg: Arg = self.argAt(args: args, index: i)
            self.decls.callTemplateArgumentPool.append(<CallTemplateArgument source=(try self.callArgumentSource(exprId: arg.expr)) isInout=arg.isInout labelStart=arg.labelStart labelLen=arg.labelLen hasLabel=arg.hasLabel />)
            i += 1U64
        }
        return <Result.Ok value=<CallTemplateArgumentRange start=start len=self.decls.callTemplateArgumentPool.count() - start /> />
    }

    inout fn publishCallTemplateArguments(args: Array[CallTemplateArgument]) -> CallTemplateArgumentRange {
        val start: U64 = self.decls.callTemplateArgumentPool.count()
        mut val i: U64 = 0U64
        while i < args.count() {
            self.decls.callTemplateArgumentPool.append(args[i])
            i += 1U64
        }
        return <CallTemplateArgumentRange start=start len=self.decls.callTemplateArgumentPool.count() - start />
    }

    inout fn publishCallTemplateTypeArgs(args: Array[U64]) -> CallTemplateTypeArgumentRange {
        val start: U64 = self.decls.callTemplateTypeArgumentPool.count()
        mut val i: U64 = 0U64
        while i < args.count() {
            self.decls.callTemplateTypeArgumentPool.append(args[i])
            i += 1U64
        }
        return <CallTemplateTypeArgumentRange start=start len=self.decls.callTemplateTypeArgumentPool.count() - start />
    }

    fn callTemplateTypeArgs(range: CallTemplateTypeArgumentRange) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val i: U64 = 0U64
        while i < range.len {
            if range.start + i >= self.decls.callTemplateTypeArgumentPool.count() { return [] }
            out.append(self.decls.callTemplateTypeArgumentPool[range.start + i])
            i += 1U64
        }
        return out
    }

    fn callTemplateArguments(range: CallTemplateArgumentRange) -> Array[CallTemplateArgument] {
        mut val out: Array[CallTemplateArgument] = []
        mut val i: U64 = 0U64
        while i < range.len {
            if range.start + i >= self.decls.callTemplateArgumentPool.count() { return [] }
            out.append(self.decls.callTemplateArgumentPool[range.start + i])
            i += 1U64
        }
        return out
    }

    inout fn publishCallTemplateOperands(operands: Array[CallArgumentSource]) -> CallTemplateOperandRange {
        val start: U64 = self.decls.callTemplateOperandPool.count()
        mut val i: U64 = 0U64
        while i < operands.count() {
            self.decls.callTemplateOperandPool.append(operands[i])
            i += 1U64
        }
        return <CallTemplateOperandRange start=start len=self.decls.callTemplateOperandPool.count() - start />
    }

    inout fn publishCallTemplateViews(views: Array[ResolvedViewSource]) -> CallTemplateViewRange {
        val start: U64 = self.decls.callTemplateViewPool.count()
        mut val i: U64 = 0U64
        while i < views.count() {
            self.decls.callTemplateViewPool.append(views[i])
            i += 1U64
        }
        return <CallTemplateViewRange start=start len=self.decls.callTemplateViewPool.count() - start />
    }

    fn callTemplateViews(range: CallTemplateViewRange) -> Array[ResolvedViewSource] {
        mut val out: Array[ResolvedViewSource] = []
        mut val i: U64 = 0U64
        while i < range.len {
            if range.start + i >= self.decls.callTemplateViewPool.count() { return [] }
            out.append(self.decls.callTemplateViewPool[range.start + i])
            i += 1U64
        }
        return out
    }

    inout fn recordCallTemplate(exprId: U64, callee: U64, receiver: CallTemplateReceiver, args: ArgRange, calleeTypeArgs: Array[U64], proof: StaticConformanceProof = <StaticConformanceProof.Missing />, receiverTypeTerm: U64 = 0U64) -> Result[(), CompileDiagnostic] {
        mut val receiverTerm = receiverTypeTerm
        if receiverTerm == 0U64 {
            match receiver { CallTemplateReceiver.Term(term: val term) => { receiverTerm = term } _ => {} }
        }
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId))
        val templateArgs: CallTemplateArgumentRange = (try self.directCallTemplateArgs(args: args))
        val templateTypeArgs: CallTemplateTypeArgumentRange = self.publishCallTemplateTypeArgs(args: calleeTypeArgs)
        val proofId: U64 = self.freezeStaticConformanceProof(proof: proof)
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            val kind = (try self.completeCallTemplateResult(exprId: exprId, kind: <CallTemplateKind.Direct callee=callee receiver=receiver args=templateArgs calleeTypeArgs=templateTypeArgs proofId=proofId />, expectedTerm: prior.expectedResultTerm, receiverTerm: receiverTerm))
            receiverTerm = self.completeCallTemplateReceiver(kind: kind, receiverTerm: receiverTerm)
            self.decls.callTemplates.set(i: index, value: <CallTemplate resultTypeRecipe=prior.resultTypeRecipe siteKey=siteKey kind=kind expectedResultTerm=prior.expectedResultTerm receiverTypeTerm=receiverTerm />)
            return <Result.Ok value=() />
        }
        val kind = <CallTemplateKind.Direct callee=callee receiver=receiver args=templateArgs calleeTypeArgs=templateTypeArgs proofId=proofId />
        receiverTerm = self.completeCallTemplateReceiver(kind: kind, receiverTerm: receiverTerm)
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=kind receiverTypeTerm=receiverTerm />)
        return <Result.Ok value=() />
    }

    // A dynamic call is selected at Record too.  It carries the same receiver
    // and argument provenance as a direct call, while the target remains a
    // symbolic closure type or existential witness until a BodyInstance
    // grounds it.  Mono must never reopen the call expression to rediscover
    // lexical scope, field identity, or requirement overload selection.
    // Only completed signature producers call this API. Their zero result is
    // Unit; an unresolved expression still uses recordSemanticExprTerm(0).
    // Preserve the callable no-payload representation and publish its explicit
    // Unit state. Presence is never inferred from a zero term alone.
    inout fn recordKnownExpressionResult(exprId: U64, resultTerm: U64) -> Result[(), CompileDiagnostic] {
        self.recordSemanticExprTerm(exprId: exprId, term: resultTerm)
        if self.callableResultIsUnit(ref: resultTerm) {
            self.ensureSemanticExprType(exprId: exprId)
            val prior = self.arena.semanticExprTypes[exprId]
            val state = match prior.typeState {
                SemanticExpressionTypeState.NoNormalValue => <SemanticExpressionTypeState.NoNormalValue />,
                _ => <SemanticExpressionTypeState.Unit />,
            }
            self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType typeState=state completion=prior.completion invocation=prior.invocation term=prior.term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed />)
        }
        return <Result.Ok value=() />
    }

    inout fn recordInvocationCompletion(exprId: U64, diverging: Bool, returnsUnit: Bool = false) {
        self.ensureSemanticExprType(exprId: exprId)
        val prior = self.arena.semanticExprTypes[exprId]
        val contract = if diverging { give <InvocationCompletion.Diverges /> } else { give <InvocationCompletion.Returns /> }
        val state = if diverging { give <SemanticExpressionTypeState.NoNormalValue /> } else if returnsUnit { give <SemanticExpressionTypeState.Unit /> } else { give prior.typeState }

        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType
            typeState=state completion=prior.completion invocation=contract term=prior.term shape=prior.shape
            legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen
            legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext
            hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed
        />)
    }

    // A source site's owner exists before its type and completion are checked.
    // Sharing this identity rule does not publish a completed semantic fact.
    inout fn sourceRecordingOwner() -> Optional[SemanticCompletionOwner] {
        if !self.cur.recordCallTemplates { return <Optional.None /> }
        val owner = self.decls.callTemplateLexicalRoots.getOr(key: self.cur.checkFn, fallback: self.cur.checkFn)
        if owner != 18446744073709551615U64 {
            return <Optional.Some v=<SemanticCompletionOwner.Function index=owner /> />
        }
        match self.cur.globalInitializerTarget {
            Optional.Some(v: val target) => { return <Optional.Some v=<SemanticCompletionOwner.Global target=target /> /> }
            Optional.None => { return <Optional.None /> }
        }
    }

    // Publish only after the expression's operands and branches have been
    // checked and composed. A single arm's exit is not its parent's exit.
    inout fn recordedCompletionFact(completion: SourceCompletion) -> Optional[SemanticExpressionCompletion] {
        match self.sourceRecordingOwner() {
            Optional.Some(v: val owner) => { return <Optional.Some v=<SemanticExpressionCompletion owner=owner flow=completion /> /> }
            Optional.None => { return <Optional.None /> }
        }
    }

    inout fn recordSemanticExprCompletion(exprId: U64, completion: SourceCompletion) {
        if completion.source.normal() && !self.cur.recordCallTemplates { return }
        self.ensureSemanticExprType(exprId: exprId)
        val prior = self.arena.semanticExprTypes[exprId]
        mut val fact = prior.completion
        match self.recordedCompletionFact(completion: completion) {
            Optional.Some(v: val recorded) => { fact = <Optional.Some v=recorded /> }
            Optional.None => {}
        }
        val state = if completion.source.normal() { give prior.typeState } else { give <SemanticExpressionTypeState.NoNormalValue /> }
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType
            typeState=state completion=fact invocation=prior.invocation term=prior.term shape=prior.shape
            legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen
            legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext
            hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed
        />)
    }

    inout fn recordStaticInvocationCompletion(exprId: U64, resolution: StaticMemberResolution) {
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val trait, reqIdx: val requirement) => {
                val declaration = self.traitReqAt(reqs: self.decls.traitAt(index: trait).reqs, index: requirement)
                self.recordInvocationCompletion(exprId: exprId, diverging: declaration.isDiverging, returnsUnit: self.callableResultIsUnit(ref: self.semanticCallableReturnTerm(function: declaration)))
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => {
                self.recordInvocationCompletion(exprId: exprId, diverging: self.arena.functionAt(index: callee).isDiverging, returnsUnit: self.callableResultIsUnit(ref: self.semanticCallableReturnTerm(function: self.arena.functionAt(index: callee))))
            }
            StaticMemberResolution.Missing => {}
        }
    }

    inout fn recordDynamicCallTemplate(exprId: U64, receiver: CallTemplateReceiver, args: ArgRange, target: DynamicCallTemplateTarget, receiverTerm: U64 = 0U64) -> Result[(), CompileDiagnostic] {
        mut val functionType: U64 = 0U64
        match target {
            DynamicCallTemplateTarget.ClosureLocal(bindingDeclStart: _, fnTypeTerm: val term) => { functionType = term }
            DynamicCallTemplateTarget.ClosureField(fieldIndex: _, fnTypeTerm: val term) => { functionType = term }
            _ => {}
        }
        match target {
            DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: val trait, slot: val slot) => {
                if slot > 0U64 {
                    val declaration = self.traitReqAt(reqs: self.decls.traitAt(index: trait).reqs, index: slot - 1U64)
                    val signature = try self.existentialRequirementSignature(target: receiverTerm, traitIndex: trait, requirement: declaration)
                    try self.recordKnownExpressionResult(exprId: exprId, resultTerm: signature.resultType)
                    self.recordInvocationCompletion(exprId: exprId, diverging: declaration.isDiverging, returnsUnit: self.callableResultIsUnit(ref: signature.resultType))
                }
            }
            _ => {}
        }
        if functionType != 0U64 && self.isFnType(ref: functionType) {
            self.recordInvocationCompletion(exprId: exprId, diverging: self.arena.typeAt(index: functionType).isDiverging, returnsUnit: self.functionTypeReturnsUnit(ref: functionType))
            val signature: TypeRef = self.arena.typeAt(index: functionType)
            if signature.args.count() > 0U64 { try self.recordKnownExpressionResult(exprId: exprId, resultTerm: signature.args[0U64]) }
            mut val index: U64 = 0U64
            while index < args.len && index + 1U64 < signature.args.count() {
                val expected: U64 = signature.args[index + 1U64]
                val argument: U64 = self.argAt(args: args, index: index).expr
                // The function signature supplies context before either the
                // argument check or call-template publication can consume it.
                if expected != 0U64 && self.expressionNeedsTypeContext(exprId: argument) {
                    try self.recordExpr(exprId: argument, expectedTerm: expected)
                }
                if expected != 0U64 {
                    val parameter: TypeInfo = self.typeInfoOfRef(ref: expected)
                    try self.checkLitSpanCtx(id: argument, tyStart: parameter.nameStart, tyLen: parameter.nameLen, isArray: parameter.kind == 3, ctxRef: expected)
                    try self.recordSemanticExprExpectedResult(exprId: argument, expectedTerm: expected)
                }
                index += 1U64
            }
        }
        if !(self.cur.recordCallTemplates) { return <Result.Ok value=() /> }
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId))
        val templateArgs: CallTemplateArgumentRange = (try self.directCallTemplateArgs(args: args))
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate resultTypeRecipe=prior.resultTypeRecipe siteKey=prior.siteKey kind=<CallTemplateKind.Dynamic receiver=receiver args=templateArgs target=target /> expectedResultTerm=prior.expectedResultTerm />)
            return <Result.Ok value=() />
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.Dynamic receiver=receiver args=templateArgs target=target /> />)
        return <Result.Ok value=() />
    }

    inout fn recordStaticMethodTemplate(exprId: U64, receiverTerm: U64, receiver: CallTemplateReceiver, args: ArgRange, resolution: StaticMemberResolution, resultTerm: U64) -> Result[(), CompileDiagnostic] {
        self.recordStaticInvocationCompletion(exprId: exprId, resolution: resolution)
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val traitIndex, reqIdx: val requirementIndex) => {
                try self.checkCallDeclarationKind(exprId: exprId, declaration: self.traitReqAt(reqs: self.decls.traitAt(index: traitIndex).reqs, index: requirementIndex))
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => {
                try self.checkCallDeclarationKind(exprId: exprId, declaration: self.arena.functionAt(index: callee))
            }
            _ => {}
        }
        // A provided member has a selected declaration and proof just like
        // a requirement. Compute its result from that signature rather than
        // reading the still-untyped call expression back into its own record.
        mut val methodArguments: Array[U64] = []
        mut val selectedResult = resultTerm
        mut val selectedEnvironment = <InstanceEnvironment />
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: val index) => {
                val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: owner).reqs, index: index)
                methodArguments = try self.inferFnArgs(f: requirement, args: args)
                selectedEnvironment = <InstanceEnvironment params=self.copyFuncBinds(binds: requirement.typeParams) args=methodArguments />
            }
            StaticMemberResolution.Provided(proof: val proof, traitIdx: _, callee: val callee) => {
                val function = self.arena.functionAt(index: callee)
                val inferred = try self.inferMethodEnvironment(f: function, receiverRef: receiverTerm, args: args, selectedProof: proof)
                val environment = try self.withLexicalSelfBinding(f: function, environment: <InstanceEnvironment params=inferred.params args=inferred.args receiverRef=receiverTerm proof=proof />)
                selectedEnvironment = environment
                methodArguments = self.signatureTypeArguments(f: function, environment: environment)
                selectedResult = try self.groundTermForBody(ref: self.semanticCallableReturnTerm(function: function), environment: environment, selfRef: receiverTerm, itemRef: 0U64)
            }
            _ => {}
        }
        // The selected provided environment supplies both parameter and result
        // terms. Numeric literals need this context just as constructions do.
        mut val argumentIndex = 0U64
        while argumentIndex < args.len {
            val argument = self.argAt(args: args, index: argumentIndex).expr
            mut val expected = try self.staticRequirementParamType(resolution: resolution, args: args, argIdx: argumentIndex)
            match resolution {
                StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                    expected = try self.groundTermForBody(ref: expected, environment: selectedEnvironment, selfRef: receiverTerm, itemRef: 0U64)
                }
                StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => {
                    val function = self.arena.functionAt(index: callee)
                    val parameter = self.paramIndexForArg(params: function.params, args: args, argIdx: argumentIndex)
                    if parameter < function.params.count() {
                        expected = try self.groundTermForBody(ref: self.funcParamAt(params: function.params, index: parameter).ty, environment: selectedEnvironment, selfRef: receiverTerm, itemRef: 0U64)
                    }
                }
                _ => {}
            }
            if expected != 0U64 {
                if self.expressionNeedsTypeContext(exprId: argument) { try self.recordExpr(exprId: argument, expectedTerm: expected) }
                try self.recordSemanticExprExpectedResult(exprId: argument, expectedTerm: expected)
                try self.tcCheckValue(expectedRef: expected, valueExpr: argument, pos: "static method argument")
            }
            argumentIndex += 1U64
        }
        // Parent chains and match payloads read the expression term during
        // both Record walks, before call-template publication is enabled.
        val declaration = try self.selectedStaticCallDeclaration(resolution: resolution, offset: self.exprOffset(id: exprId))
        if self.callableResultIsUnit(ref: self.semanticCallableReturnTerm(function: declaration)) {
            try self.recordKnownExpressionResult(exprId: exprId, resultTerm: selectedResult)
        } else { self.recordSemanticExprTerm(exprId: exprId, term: selectedResult) }
        // Like Direct calls, keep the unsealed selection during preparation.
        // The generic checker needs its contextual substitution before the
        // publication walk; closure still happens only after validation.
        val methodTypeArgs = self.publishCallTemplateTypeArgs(args: methodArguments)
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId))
        mut val templateArgs: CallTemplateArgumentRange = (try self.directCallTemplateArgs(args: args))
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        val hasPriorTemplate = index < self.decls.callTemplates.count()
        // Defaults are completed from the recorded substitution after the
        // expected-result join, through the same path as Direct calls.
        if hasPriorTemplate {
            val prior: CallTemplate = self.decls.callTemplates[index]
            val kind = try self.completeCallTemplateResult(exprId: exprId, kind: <CallTemplateKind.StaticMethod receiver=receiver args=templateArgs resolution=resolution methodTypeArgs=methodTypeArgs resultTerm=selectedResult />, expectedTerm: prior.expectedResultTerm, receiverTerm: receiverTerm)
            self.decls.callTemplates.set(i: index, value: <CallTemplate resultTypeRecipe=prior.resultTypeRecipe siteKey=prior.siteKey kind=kind receiverTypeTerm=receiverTerm expectedResultTerm=prior.expectedResultTerm />)
            return <Result.Ok value=() />
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey receiverTypeTerm=receiverTerm kind=<CallTemplateKind.StaticMethod receiver=receiver args=templateArgs resolution=resolution methodTypeArgs=methodTypeArgs resultTerm=selectedResult /> />)
        return <Result.Ok value=() />
    }

    // Error propagation selects the Core From requirement while the lexical
    // assumptions are available. The error payload has a semantic type, not
    // a fabricated expression/local. Ordinary static-call obligations and
    // finalization consume this same template under each body environment.
    inout fn recordTryExpression(exprId: U64, operand: U64) -> Result[(), CompileDiagnostic] {
        val returnTerm = try self.normalizedValueType(ref: self.semanticBodyReturnTerm(fnIdx: self.cur.checkFn))
        if self.resultEnumIndex(ref: returnTerm) >= self.arena.enumCount() {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`try` is only valid in a function that returns a Result (spec/13)") />
        }
        val operandTerm = try self.normalizedValueType(ref: self.parametricExprTerm(exprId: operand))
        val enumIndex = self.resultEnumIndex(ref: operandTerm)
        if enumIndex >= self.arena.enumCount() {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`try` works only on a Result; for an Optional use `unwrapOr` / `?.` / `match` (spec/13)") />
        }
        val okName = self.kwSpan(kw: "Ok", kwLen: 2U64)
        val errName = self.kwSpan(kw: "Err", kwLen: 3U64)
        val okVariant = self.variantIndexInDeclaration(enumIndex: enumIndex, nameStart: okName.nameStart, nameLen: okName.nameLen)
        val errVariant = self.variantIndexInDeclaration(enumIndex: enumIndex, nameStart: errName.nameStart, nameLen: errName.nameLen)
        if okVariant >= self.arena.enumAt(index: enumIndex).variants.count() || errVariant >= self.arena.enumAt(index: enumIndex).variants.count() {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: Lang Result is missing its variants") />
        }
        val success = self.arena.typeArgumentPool[self.arena.typeTerms[operandTerm].args.start]
        self.recordSemanticExprTerm(exprId: exprId, term: success)
        val source = self.arena.typeArgumentPool[self.arena.typeTerms[operandTerm].args.start + 1U64]
        val target = self.arena.typeArgumentPool[self.arena.typeTerms[returnTerm].args.start + 1U64]
        try self.putSemanticTry(fact: <SemanticTry resultEnumIndex=enumIndex okVariantIndex=okVariant errVariantIndex=errVariant ownerFnIdx=(try self.semanticBodyOwner(fnIdx: self.cur.checkFn)) exprId=exprId operandTerm=operandTerm returnTerm=returnTerm successTerm=success sourceErrorTerm=source targetErrorTerm=target />)
        if self.typeRefEq(a: source, b: target) { return <Result.Ok value=() /> }
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId, slot: 1U64)
        if self.decls.callTemplateIndex(siteKey: site) < self.decls.callTemplates.count() { return <Result.Ok value=() /> }
        val owner = self.coreTraitOwner(name: "From", arity: 1U64)
        val traitIndex = self.decls.traitIndexByOffset(offset: owner)
        if owner == 0U64 || traitIndex >= self.decls.traitCount() {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "`try` error conversion requires the Core From trait") />
        }
        val trait = self.decls.traitAt(index: traitIndex)
        val proof = try self.staticTraitPatternProof(receiverRef: target, traitId: trait.nameId, traitOwner: owner, traitArgs: [source], patternParams: <PatternBindInput.Values values=[] />)
        if self.proofIsMissing(proof: proof) {
            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: operand), msg: "`try` error type does not match the function's Result error type, and the function's error type has no `from` factory that accepts it (spec/13)") />
        }
        mut val index = 0U64
        while index < trait.reqs.count() {
            val requirement = self.traitReqAt(reqs: trait.reqs, index: index)
            if requirement.isAnonymousFactory && requirement.params.count() == 1U64 {
                val parameter = self.funcParamAt(params: requirement.params, index: 0U64)
                val argument = <CallTemplateArgument source=<CallArgumentSource.Term exprId=exprId term=source /> isInout=false labelStart=parameter.nameStart labelLen=parameter.nameLen hasLabel=!parameter.noLabel />
                val arguments = self.publishCallTemplateArguments(args: [argument])
                val resolution = <StaticMemberResolution.Requirement proof=proof traitIdx=traitIndex reqIdx=index />
                self.appendCallTemplate(template: <CallTemplate siteKey=site receiverTypeTerm=target expectedResultTerm=target kind=<CallTemplateKind.StaticMethod receiver=<CallTemplateReceiver.Term term=target /> args=arguments resolution=resolution methodTypeArgs=self.publishCallTemplateTypeArgs(args: []) resultTerm=target /> />)
                return <Result.Ok value=() />
            }
            index += 1U64
        }
        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "internal error: Core From has no conversion requirement") />
    }

    inout fn recordProtocolCallTemplate(stmtId: U64, slot: U64, receiver: CallTemplateReceiver, receiverTerm: U64) -> Result[U64, CompileDiagnostic] {
        val name = if slot == 1U64 { give self.kwSpan(kw: "iterator", kwLen: 8U64) } else { give self.kwSpan(kw: "next", kwLen: 4U64) }
        val arguments = self.pushArgs(args: [])
        mut val selection = <ProtocolSelection.Pending />
        mut val resultTerm = 0U64
        if receiverTerm != 0U64 && receiverTerm < self.arena.typeCount() {
            if self.arena.typeTerms[receiverTerm].isAny {
                val owner = self.finalAnyTraitIdx(anyRef: receiverTerm)
                val requirementSlot = self.finalAnyRequirementSlot(anyRef: receiverTerm, nameStart: name.nameStart, nameLen: name.nameLen, args: arguments)
                if owner < self.decls.traitCount() && requirementSlot != 0U64 {
                    val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: owner).reqs, index: requirementSlot - 1U64)
                    resultTerm = (try self.anyMemberRetInfo(anyRef: receiverTerm, req: requirement)).ref
                    selection = <ProtocolSelection.Existential traitIdx=owner slot=requirementSlot />
                } else if slot == 1U64 { selection = <ProtocolSelection.Identity />
                    resultTerm = receiverTerm }
            } else {
                val resolution = try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: name.nameStart, nameLen: name.nameLen, args: arguments)
                match resolution {
                    StaticMemberResolution.Missing => {
                        val callee = try self.resolveProtocolMethodForReceiver(recvRef: receiverTerm, nameStart: name.nameStart, nameLen: name.nameLen, args: arguments)
                        if callee < self.arena.functionCount() {
                            val function = self.arena.functionAt(index: callee)
                            val proof = try self.providedBodyProof(f: function, receiverRef: receiverTerm)
                            val environment = try self.finalMethodEnvironment(f: function, receiverRef: receiverTerm, args: arguments, selectedProof: proof)
                            resultTerm = try self.groundTermForBody(ref: self.semanticCallableReturnTerm(function: function), environment: environment, selfRef: receiverTerm, itemRef: 0U64)
                            selection = <ProtocolSelection.Direct callee=callee proof=proof />
                        } else if slot == 1U64 { selection = <ProtocolSelection.Identity />
                            resultTerm = receiverTerm }
                    }
                    _ => {
                        resultTerm = try self.staticRequirementResultType(resolution: resolution)
                        selection = <ProtocolSelection.Static resolution=resolution />
                    }
                }
            }
        }
        if !self.cur.recordCallTemplates { return <Result.Ok value=resultTerm /> }
        val key = try self.templateProtocolSiteKey(fnIdx: self.cur.checkFn, stmtId: stmtId, slot: slot)
        val index = self.decls.callTemplateIndex(siteKey: key)
        val kind = <CallTemplateKind.Protocol receiver=receiver selection=selection resultTerm=resultTerm />
        if index < self.decls.callTemplates.count() {
            val prior = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate resultTypeRecipe=prior.resultTypeRecipe siteKey=prior.siteKey kind=kind receiverTypeTerm=receiverTerm expectedResultTerm=prior.expectedResultTerm />)
        } else { self.appendCallTemplate(template: <CallTemplate siteKey=key kind=kind receiverTypeTerm=receiverTerm />) }
        return <Result.Ok value=resultTerm />
    }

    inout fn callArgumentSource(exprId: U64) -> Result[CallArgumentSource, CompileDiagnostic] {
        match self.arena.exprs[exprId] {
            Expr.Ident(start: val start, len: val len) => {
                val localIndex: U64 = self.localIndexByName(start: start, len: len)
                if localIndex < self.cur.locals.count() {
                    val local = (try self.typedLocal(index: localIndex))
                    if local.isGlobal {
                        return <Result.Ok value=<CallArgumentSource.Term exprId=exprId term=local.ty /> />
                    }
                    return <Result.Ok value=<CallArgumentSource.Local exprId=exprId declarationTarget=local.nameStart term=self.parametricExprTerm(exprId: exprId) /> />
                }
            }
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=<CallArgumentSource.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=<CallArgumentSource.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=<CallArgumentSource.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            // Operators publish CallResolution entries too. A surrounding
            // direct call must depend on that finalized result exactly as it
            // depends on a written call: `print(!false)` cannot infer Print's
            // generic argument from the unary Expr's legacy TypeInfo.
            Expr.Unary(op: _, operand: _) => {
                return <Result.Ok value=<CallArgumentSource.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            Expr.Binary(op: val op, lhs: _, rhs: _) => {
                // Logical connectors are control flow, not trait calls. Their
                // Bool term is complete; Mid materializes their short-circuit
                // CFG through the ordinary value source path below.
                if op != opAnd() && op != opOr() {
                    return <Result.Ok value=<CallArgumentSource.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
                }
            }
            _ => {}
        }
        val term: U64 = self.parametricExprTerm(exprId: exprId)
        if term != 0U64 { return <Result.Ok value=<CallArgumentSource.Term exprId=exprId term=term /> />}
        // Record's post-order fallback has already captured every remaining
        // context-sensitive shape in SemanticExprType.  Do not reopen the AST
        // here: a missing TypeTerm is specifically the intentional legacy
        // adapter case (notably an unsuffixed integer), not a request for a
        // second declaration-time type recovery.
        return <Result.Ok value=<CallArgumentSource.Legacy exprId=exprId info=self.semanticExprTypeInfo(exprId: exprId) /> />
    }

    inout fn staticOperatorTemplateResolution(op: I64, receiverTerm: U64, isUnary: Bool) -> Result[StaticMemberResolution, CompileDiagnostic] {
        if self.cur.checkFn >= self.arena.functionCount() || receiverTerm == 0U64 { return <Result.Ok value=<StaticMemberResolution.Missing /> />}
        if isUnary {
            if op == opSub() || op == opNot() || op == opBitNot() {
                return <Result.Ok value=(try self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: self.unOpTraitName(op: op), memberName: unaryMethodName(op: op), arity: 1U64)) />
            }
            return <Result.Ok value=<StaticMemberResolution.Missing /> />
        }
        if isBinTraitOp(op: op) {
            return <Result.Ok value=(try self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: self.binOpTraitName(op: op), memberName: binTraitMethodName(op: op), arity: 2U64, traitArity: 1U64)) />
        }
        if op == opEq() || op == opNe() {
            return <Result.Ok value=(try self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: "Eq", memberName: "eq", arity: 2U64)) />
        }
        if op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            return <Result.Ok value=(try self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: "Ord", memberName: "compare", arity: 2U64)) />
        }
        return <Result.Ok value=<StaticMemberResolution.Missing /> />
    }

    // Ordering syntax is a projection of the selected Ord requirement, not a
    // direct spelling of `compare`: `a < b` selects `Ord.compare` as its
    // witness but its own value is always Bool.  Keeping that distinction at
    // the CallTemplate boundary prevents downstream body finalization from
    // treating an Ordering return as the source expression's result.
    inout fn staticOperatorTemplateResultTerm(op: I64, resolution: StaticMemberResolution) -> Result[U64, CompileDiagnostic] {
        if op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            val boolName: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
            if boolName.nameLen == 0U64 { return <Result.Ok value=0U64 />}
            return <Result.Ok value=self.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen) />
        }
        return <Result.Ok value=(try self.staticRequirementResultType(resolution: resolution)) />
    }

    inout fn recordedOperatorSelection(op: I64, receiverTerm: U64, operandExprs: Array[U64], resolution: StaticMemberResolution) -> Result[OperatorSelection, CompileDiagnostic] {
        match resolution {
            StaticMemberResolution.Missing => {}
            _ => { return <Result.Ok value=<OperatorSelection.Static resolution=resolution /> /> }
        }
        if receiverTerm == 0U64 || receiverTerm >= self.arena.typeCount() { return <Result.Ok value=<OperatorSelection.Pending /> /> }
        // A closed semantic term has no substitution to apply. Layout
        // materialization is not part of selecting its operator declaration.
        val receiver = if self.arena.typeIsClosed(ref: receiverTerm) { give receiverTerm } else { give try self.groundTypeRef(ref: receiverTerm) }
        mut val callee = self.arena.functionCount()
        if operandExprs.count() == 1U64 {
            callee = try self.unaryOperatorCallee(receiverRef: receiver, op: op)
        } else if operandExprs.count() == 2U64 {
            val rhs = self.parametricExprTerm(exprId: operandExprs[1])
            val groundedRhs = if rhs == 0U64 || self.arena.typeIsClosed(ref: rhs) { give rhs } else { give try self.groundTypeRef(ref: rhs) }
            callee = try self.findBinTraitWitnessForRef(receiverRef: receiver, op: op, rhsRef: groundedRhs, rhsUntyped: groundedRhs == 0U64)
        }
        if callee < self.arena.functionCount() { return <Result.Ok value=<OperatorSelection.Direct callee=callee /> /> }
        // Primitive lowering is explicit and still subject to the normal
        // operator legality checks. An unresolved aggregate is never primitive.
        val receiverType = self.arena.typeTerms[receiver]
        if self.isIntType(start: receiverType.nameStart, len: receiverType.nameLen) || self.isFloatType(start: receiverType.nameStart, len: receiverType.nameLen) || rangeEquals(bytes: self.arena.bytes, start: receiverType.nameStart, len: receiverType.nameLen, kw: "Bool") {
            return <Result.Ok value=<OperatorSelection.Primitive /> />
        }
        return <Result.Ok value=<OperatorSelection.Pending /> />
    }

    inout fn recordOperatorTemplate(exprId: U64, op: I64, operandExprs: Array[U64], isUnary: Bool) -> Result[(), CompileDiagnostic] {
        if !isUnary && (op == opAnd() || op == opOr()) { return <Result.Ok value=() /> }
        mut val receiverTerm: U64 = 0U64
        if operandExprs.count() > 0U64 { receiverTerm = self.parametricExprTerm(exprId: operandExprs[0]) }
        val resolution: StaticMemberResolution = (try self.staticOperatorTemplateResolution(op: op, receiverTerm: receiverTerm, isUnary: isUnary))
        // Concrete operand context must come from the same selected callable
        // as dispatch. Literal verification is not guaranteed to revisit an
        // operator nested inside another expression (for example `!(a == 2)`).
        val selection = if self.cur.recordCallTemplates {
            give try self.recordedOperatorSelection(op: op, receiverTerm: receiverTerm, operandExprs: operandExprs, resolution: resolution)
        } else { give <OperatorSelection.Pending /> }
        mut val operands: Array[CallArgumentSource] = []
        mut val i: U64 = 0U64
        while i < operandExprs.count() {
            val operand = operandExprs[i]
            mut val expected = try self.staticRequirementParamTypeAt(resolution: resolution, paramIdx: i)
            // This is inference context for an unresolved source operand,
            // not a new equality rule for an already-typed receiver. Selected
            // receiver conversion retains its source view and callable boundary.
            if expected == 0U64 && self.parametricExprTerm(exprId: operand) == 0U64 {
                match selection {
                    OperatorSelection.Direct(callee: val callee) => {
                        val function = self.arena.functionAt(index: callee)
                        if i < function.params.count() {
                            val parameter = self.funcParamAt(params: function.params, index: i)
                            expected = try self.operatorCalleeType(callee: callee, receiverRef: receiverTerm, term: parameter.ty)
                        }
                    }
                    _ => {}
                }
            }
            if expected != 0U64 {
                if self.expressionNeedsTypeContext(exprId: operand) { try self.recordExpr(exprId: operand, expectedTerm: expected) }
                try self.recordSemanticExprExpectedResult(exprId: operand, expectedTerm: expected)
                try self.tcCheckValue(expectedRef: expected, valueExpr: operand, pos: "operator operand")
            }
            operands.append((try self.callArgumentSource(exprId: operand)))
            i += 1U64
        }
        // Core operator requirements have an ordinary return contract;
        // conformance checking rejects diverging witnesses. The initial
        // expression pass needs that contract, not the concrete implementation.
        // Select and retain the implementation once when publishing templates.
        self.recordInvocationCompletion(exprId: exprId, diverging: false)
        val staticResult: U64 = (try self.staticOperatorTemplateResultTerm(op: op, resolution: resolution))
        if staticResult != 0U64 { self.recordSemanticExprTerm(exprId: exprId, term: staticResult) }
        if !(self.cur.recordCallTemplates) { return <Result.Ok value=() /> }
        val resultTerm: U64 = self.parametricExprTerm(exprId: exprId)
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId))
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate resultTypeRecipe=prior.resultTypeRecipe siteKey=prior.siteKey kind=<CallTemplateKind.Operator op=op operands=self.publishCallTemplateOperands(operands: operands) resolution=selection resultTerm=resultTerm /> receiverTypeTerm=receiverTerm expectedResultTerm=prior.expectedResultTerm />)
            return <Result.Ok value=() />
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.Operator op=op operands=self.publishCallTemplateOperands(operands: operands) resolution=selection resultTerm=resultTerm /> receiverTypeTerm=receiverTerm />)
        return <Result.Ok value=() />
    }

    // Source forms that own a call selection. Implicit calls are published
    // under their own synthetic sites; a surrounding value only owns context.
    fn sourceExprRequiresCallSelection(exprId: U64) -> Bool {
        if exprId >= self.arena.exprs.count() { return false }
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => { return true }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { return true }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => { return true }
            Expr.Unary(op: _, operand: _) => { return true }
            Expr.Binary(op: val op, lhs: _, rhs: _) => { return op != opAnd() && op != opOr() }
            _ => { return false }
        }
    }

    inout fn recordCallTemplateExpectedResult(exprId: U64, expectedTerm: U64) -> Result[(), CompileDiagnostic] {
        // Atomic values cannot select a call. Their contextual typing belongs
        // to SemanticExprType; publishing a Pending call here invents a call
        // obligation for a literal or a local read. Compound and synthetic
        // forms remain conservative until their actual selection is recorded.
        if exprId < self.arena.exprs.count() && self.syntheticCallSiteIndex(exprId: exprId) == self.decls.syntheticCallSites.count() {
            match self.arena.exprs[exprId] {
                Expr.Int(value: _, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => { return <Result.Ok value=() /> }
                Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => { return <Result.Ok value=() /> }
                Expr.Str(start: _, len: _) => { return <Result.Ok value=() /> }
                Expr.Ident(start: _, len: _) => { return <Result.Ok value=() /> }
                _ => {}
            }
        }
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId))
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        // Context can be known before declaration-time call selection. This
        // is normal for a type-qualified generic associated factory in a
        // shared body: its concrete receiver is not selected until Mono, but
        // its source expected result is already a complete template input.
        if index >= self.decls.callTemplates.count() {
            val kind = if exprId >= self.arena.exprs.count() || self.sourceExprRequiresCallSelection(exprId: exprId) || self.syntheticCallSiteIndex(exprId: exprId) < self.decls.syntheticCallSites.count() {
                give <CallTemplateKind.Pending />
            } else { give <CallTemplateKind.ExpectedValue /> }
            self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=kind expectedResultTerm=expectedTerm />)
            return <Result.Ok value=() />
        }
        val prior: CallTemplate = self.decls.callTemplates[index]
        val kind = (try self.completeCallTemplateResult(exprId: exprId, kind: prior.kind, expectedTerm: expectedTerm, receiverTerm: prior.receiverTypeTerm))
        val receiverTerm = self.completeCallTemplateReceiver(kind: kind, receiverTerm: prior.receiverTypeTerm)
        self.decls.callTemplates.set(i: index, value: <CallTemplate resultTypeRecipe=prior.resultTypeRecipe siteKey=prior.siteKey kind=kind expectedResultTerm=expectedTerm receiverTypeTerm=receiverTerm />)
        return <Result.Ok value=() />
    }

    // Expected results may fill only the selected declaration's unresolved
    // binders. A failed structural match never publishes a partial update.
    inout fn completeCallTypeArguments(function: Func, current: Array[U64], resultPattern: U64, expectedTerm: U64) -> Array[U64] {
        if expectedTerm == 0U64 || function.typeParams.count() == 0U64 || current.count() > function.typeParams.count() { return current }
        if current.count() == function.typeParams.count() && self.fnArgsAllResolved(args: current) { return current }
        mut val completed = current
        while completed.count() < function.typeParams.count() { completed.append(0U64) }
        if !self.matchCallResultArguments(pattern: resultPattern, expected: expectedTerm, params: function.typeParams, values: inout completed) { return current }
        return completed
    }

    // Bidirectional completion belongs to Record, before default evaluation
    // sites are formed. The same join is used whichever fact arrives first.
    // A contextual conversion may prevent exact matching; then retain the
    // selected evidence, never overwrite it or publish partial substitutions.
    inout fn completeCallTemplateResult(exprId: U64, kind: CallTemplateKind, expectedTerm: U64, receiverTerm: U64 = 0U64) -> Result[CallTemplateKind, CompileDiagnostic] {
        if expectedTerm == 0U64 { return <Result.Ok value=kind /> }
        match kind {
            CallTemplateKind.Direct(callee: val callee, receiver: val receiver, args: val args, calleeTypeArgs: val typeArgs, proofId: val proofId) => {
                if callee >= self.arena.functionCount() { return <Result.Ok value=kind /> }
                val function = self.arena.functionAt(index: callee)
                if function.typeParams.count() == 0U64 || typeArgs.len > function.typeParams.count() { return <Result.Ok value=kind /> }
                val current: Array[U64] = self.callTemplateTypeArgs(range: typeArgs)
                if typeArgs.len != current.count() { return <Result.Ok value=kind /> }
                if current.count() == function.typeParams.count() && self.fnArgsAllResolved(args: current) { return <Result.Ok value=kind /> }
                // Self in a callable result is a receiver recipe. Expose its
                // lexical pattern before matching the callee's binders; it
                // must not remain an unrelated nominal name in inference.
                val resultPattern = self.groundTermInEnvironment(ref: self.semanticCallableReturnTerm(function: function), params: [], values: [], selfRef: self.parametricSelfRef(f: function))
                val completed = self.completeCallTypeArguments(function: function, current: current, resultPattern: resultPattern, expectedTerm: expectedTerm)
                if completed.count() != function.typeParams.count() || !self.fnArgsAllResolved(args: completed) { return <Result.Ok value=kind /> }
                // The expected term constrains only this callee's binders.
                // Publish the substituted declaration result, never the expected
                // term itself. The same completed substitution is retained for Mono.
                val selectedReceiver = self.selectedCallableReceiver(function: function, receiver: receiver, receiverTerm: receiverTerm, params: self.copyFuncBinds(binds: function.typeParams), typeArgs: completed)
                val environment = try self.recordedDirectCallEnvironment(function: function, receiverTerm: selectedReceiver, typeArgs: completed, proof: self.thawStaticConformanceProof(id: proofId))
                val result = (try self.groundTermForBody(ref: function.retTy, environment: environment, selfRef: environment.receiverRef, itemRef: 0U64))
                self.recordSemanticExprTerm(exprId: exprId, term: result)
                return <Result.Ok value=<CallTemplateKind.Direct callee=callee receiver=receiver args=args calleeTypeArgs=self.publishCallTemplateTypeArgs(args: completed) proofId=proofId /> />
            }
            CallTemplateKind.StaticMethod(receiver: val receiver, args: val args, resolution: val resolution, methodTypeArgs: val typeArgs, resultTerm: _) => {
                val function = match resolution {
                    StaticMemberResolution.Requirement(proof: _, traitIdx: val owner, reqIdx: val index) => { give self.traitReqAt(reqs: self.decls.traitAt(index: owner).reqs, index: index) }
                    StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => { give self.arena.functionAt(index: callee) }
                    StaticMemberResolution.Missing => { return <Result.Ok value=kind /> }
                }
                mut val pattern = 0U64
                mut val proof = <StaticConformanceProof.Missing />
                match resolution {
                    StaticMemberResolution.Requirement(proof: val selectedProof, traitIdx: val owner, reqIdx: val index) => {
                        pattern = try self.staticRequirementResultType(resolution: resolution)
                        proof = selectedProof
                    }
                    StaticMemberResolution.Provided(proof: val selectedProof, traitIdx: _, callee: val callee) => {
                        val lexical = try self.withLexicalSelfBinding(f: function, environment: <InstanceEnvironment receiverRef=receiverTerm proof=selectedProof />)
                        pattern = self.groundTermInEnvironment(ref: self.semanticCallableReturnTerm(function: function), params: lexical.params, values: lexical.args, selfRef: receiverTerm)
                        proof = selectedProof
                    }
                    StaticMemberResolution.Missing => { return <Result.Ok value=kind /> }
                }
                val current = self.callTemplateTypeArgs(range: typeArgs)
                if typeArgs.len != current.count() { return <Result.Ok value=kind /> }
                if function.typeParams.count() == 0U64 || (current.count() == function.typeParams.count() && self.fnArgsAllResolved(args: current)) { return <Result.Ok value=kind /> }
                val completed = self.completeCallTypeArguments(function: function, current: current, resultPattern: pattern, expectedTerm: expectedTerm)
                if completed.count() != function.typeParams.count() || !self.fnArgsAllResolved(args: completed) { return <Result.Ok value=kind /> }
                val environment = <InstanceEnvironment params=self.copyFuncBinds(binds: function.typeParams) args=completed receiverRef=receiverTerm proof=proof />
                val result = try self.groundTermForBody(ref: pattern, environment: environment, selfRef: receiverTerm, itemRef: 0U64)
                self.recordSemanticExprTerm(exprId: exprId, term: result)
                return <Result.Ok value=<CallTemplateKind.StaticMethod receiver=receiver args=args resolution=resolution methodTypeArgs=self.publishCallTemplateTypeArgs(args: completed) resultTerm=result /> />
            }
            _ => { return <Result.Ok value=kind /> }
        }
    }

    // During body construction some call families still publish late. Every
    // migrated caller consumes its recorded substitution; the temporary
    // construction fallback is centralized here until all families seal.
    inout fn callParameterEnvironment(exprId: U64, callee: U64, receiverRef: U64, args: ArgRange) -> Result[InstanceEnvironment, CompileDiagnostic] {
        match (try self.recordedDirectCallEnvironmentAt(exprId: exprId, callee: callee)) {
            Optional.Some(v: val environment) => { return <Result.Ok value=environment /> }
            Optional.None => {}
        }
        val function = self.arena.functionAt(index: callee)
        val selectedReceiver = self.syntheticCallReceiverTerm(exprId: exprId, fallback: receiverRef)
        val environment = if selectedReceiver != 0U64 {
            give (try self.finalMethodEnvironment(f: function, receiverRef: selectedReceiver, args: args))
        } else {
            give (try self.freeCallParameterEnvironment(f: function, args: args))
        }
        if self.traceCodegen {
            eprint(text: "[trace-codegen] constructing-call-environment expr=")
            eprintU64(n: exprId)
            eprint(text: " callee=")
            eprintU64(n: callee)
            eprint(text: " receiver=")
            self.traceMonoTypeHead(ref: receiverRef)
            mut val binding = 0U64
            while binding < environment.params.count() && binding < environment.args.count() {
                eprint(text: " binding=")
                eprintU64(n: environment.params[binding].paramId)
                eprint(text: "->")
                self.traceMonoTypeHead(ref: environment.args[binding])
                binding += 1U64
            }
            eprint(text: "\n")
        }
        return <Result.Ok value=environment />
    }

    inout fn recordedDirectCallEnvironmentAt(exprId: U64, callee: U64) -> Result[Optional[InstanceEnvironment], CompileDiagnostic] {
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val index = self.decls.callTemplateIndex(siteKey: site)
        if index >= self.decls.callTemplates.count() { return <Result.Ok value=<Optional.None /> /> }
        val template = self.decls.callTemplates[index]
        match template.kind {
            CallTemplateKind.Direct(callee: val selected, receiver: val receiver, args: _, calleeTypeArgs: val typeArgs, proofId: val proofId) => {
                if selected != callee || selected >= self.arena.functionCount() { return <Result.Ok value=<Optional.None /> /> }
                val function = self.arena.functionAt(index: selected)
                val arguments = self.callTemplateTypeArgs(range: typeArgs)
                // This construction-time query returns an environment only
                // when every selected binder has a value. A published partial
                // call row is not a proof-complete signature.
                if arguments.count() != function.typeParams.count() || (arguments.count() != 0U64 && !self.fnArgsAllResolved(args: arguments)) {
                    return <Result.Ok value=<Optional.None /> />
                }
                val environment = try self.recordedDirectCallEnvironment(function: self.arena.functionAt(index: selected), receiverTerm: template.receiverTypeTerm, typeArgs: self.callTemplateTypeArgs(range: typeArgs), proof: self.thawStaticConformanceProof(id: proofId))
                if self.traceCodegen {
                    eprint(text: "[trace-codegen] recorded-call-environment expr=")
                    eprintU64(n: exprId)
                    eprint(text: " callee=")
                    eprintU64(n: selected)
                    eprint(text: " receiver=")
                    self.traceMonoTypeHead(ref: environment.receiverRef)
                    mut val binding = 0U64
                    while binding < environment.params.count() && binding < environment.args.count() {
                        eprint(text: " binding=")
                        eprintU64(n: environment.params[binding].paramId)
                        eprint(text: "->")
                        self.traceMonoTypeHead(ref: environment.args[binding])
                        binding += 1U64
                    }
                    eprint(text: "\n")
                }
                return <Result.Ok value=<Optional.Some v=environment /> />
            }
            _ => { return <Result.Ok value=<Optional.None /> /> }
        }
    }

    // One declaration-time substitution for both parameter checking and the
    // expression result. A caller's symbolic terms remain rigid values here.
    inout fn selectedCallableReceiver(function: Func, receiver: CallTemplateReceiver, receiverTerm: U64, params: Array[Bind], typeArgs: Array[U64]) -> U64 {
        mut val selectedReceiver = receiverTerm
        if selectedReceiver == 0U64 {
            match receiver {
                CallTemplateReceiver.Term(term: val term) => { selectedReceiver = term }
                _ => {}
            }
        }
        if selectedReceiver == 0U64 && function.isAssoc && function.recvTy != 0U64 {
            selectedReceiver = self.groundTermInEnvironment(ref: function.recvTy, params: params, values: typeArgs)
        }
        if function.isAssoc && selectedReceiver != 0U64 && selectedReceiver < self.arena.typeCount() && function.recvTy != 0U64 && function.recvTy < self.arena.typeCount() {
            // A qualifier with omitted arguments is completed from the same
            // recorded substitution as parameters and result. Do not replace
            // an explicit receiver or a distinct inherited newtype surface.
            if self.arena.typeTerms[selectedReceiver].args.len == 0U64 && self.arena.typeTerms[function.recvTy].args.len != 0U64 && self.typeTermRefSameHead(a: selectedReceiver, b: function.recvTy) {
                selectedReceiver = self.groundTermInEnvironment(ref: function.recvTy, params: params, values: typeArgs)
            }
        }
        return selectedReceiver
    }

    inout fn completeCallTemplateReceiver(kind: CallTemplateKind, receiverTerm: U64) -> U64 {
        match kind {
            CallTemplateKind.Direct(val callee, val receiver, args: _, val calleeTypeArgs, proofId: _) => {
                if callee < self.arena.functionCount() {
                    val function = self.arena.functionAt(index: callee)
                    if function.isAssoc && calleeTypeArgs.len == function.typeParams.count() {
                        val args = self.callTemplateTypeArgs(range: calleeTypeArgs)
                        if args.count() == 0U64 || self.fnArgsAllResolved(args: args) {
                            return self.selectedCallableReceiver(function: function, receiver: receiver, receiverTerm: receiverTerm, params: self.copyFuncBinds(binds: function.typeParams), typeArgs: args)
                        }
                    }
                }
            }
            _ => {}
        }
        return receiverTerm
    }

    inout fn recordedDirectCallEnvironment(function: Func, receiverTerm: U64, typeArgs: Array[U64], proof: StaticConformanceProof) -> Result[InstanceEnvironment, CompileDiagnostic] {
        val params = self.copyFuncBinds(binds: function.typeParams)
        return self.withLexicalSelfBinding(f: function, environment: <InstanceEnvironment params=params args=typeArgs receiverRef=receiverTerm proof=proof />)
    }

    // Decorations carry constraints and cannot be solved as a bare variable.
    // The identity belongs to a declaration binder, never its source spelling.
    inout fn bareInferenceParamId(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeTerms.count() { return 0U64 }
        val term = self.arena.typeTerms[ref]
        if term.paramId != 0U64 && !term.isAny && !term.isSendable && !term.isDiverging && term.args.len == 0U64 && term.assocNameId == 0U64 && term.assocTraitId == 0U64 && !term.hasTopLevelView() {
            return term.paramId
        }
        return 0U64
    }

    // Only the selected declaration's bare ParamIds are inference variables.
    // A projection is not invertible; retain obligations without inferring its
    // receiver. Head/child identity is shared with structural type equality.
    inout fn matchCallTypeArguments(pattern: U64, argument: U64, params: FuncBindRange, values: inout Array[U64]) -> TypeArgumentMatch {
        return self.matchTypeArgumentConstraints(pattern: pattern, argument: argument, params: <PatternBindInput.Function range=params />, values: inout values)
    }

    inout fn matchTypeArgumentConstraints(pattern: U64, argument: U64, params: PatternBindInput, values: inout Array[U64]) -> TypeArgumentMatch {
        if pattern == 0U64 || argument == 0U64 || pattern >= self.arena.typeTerms.count() || argument >= self.arena.typeTerms.count() { return <TypeArgumentMatch.Deferred /> }
        val term = self.arena.typeTerms[pattern]
        if term.assocNameId != 0U64 {
            if self.typeRefEq(a: pattern, b: argument) { return <TypeArgumentMatch.Matched /> }
            return <TypeArgumentMatch.Deferred />
        }
        if self.bareInferenceParamId(ref: pattern) != 0U64 {
            mut val index = 0U64
            while index < params.count() && index < values.count() {
                if params.at(index: index, declarations: self.decls, functions: self.arena).paramId == term.paramId {
                    if values[index] == 0U64 {
                        values.set(i: index, value: argument)
                        return <TypeArgumentMatch.Matched />
                    }
                    if self.typeRefEq(a: values[index], b: argument) { return <TypeArgumentMatch.Matched /> }
                    if self.arena.typeIsClosed(ref: values[index]) && self.arena.typeIsClosed(ref: argument) { return <TypeArgumentMatch.Conflict /> }
                    return <TypeArgumentMatch.Deferred />
                }
                index += 1U64
            }
        }
        if !self.typeTermRefSameHead(a: pattern, b: argument) { return <TypeArgumentMatch.Mismatch /> }
        val count = self.typeTermRefChildCount(ref: pattern)
        if count != self.typeTermRefChildCount(ref: argument) { return <TypeArgumentMatch.Mismatch /> }
        mut val deferred = false
        mut val index = 0U64
        while index < count {
            if self.typeTermRefIdentityChildLabel(ref: pattern, index: index) != self.typeTermRefIdentityChildLabel(ref: argument, index: index) { return <TypeArgumentMatch.Mismatch /> }
            match self.matchTypeArgumentConstraints(pattern: self.typeTermRefChildRef(ref: pattern, index: index), argument: self.typeTermRefChildRef(ref: argument, index: index), params: params, values: inout values) {
                TypeArgumentMatch.Matched => {}
                TypeArgumentMatch.Deferred => { deferred = true }
                TypeArgumentMatch.Mismatch => { return <TypeArgumentMatch.Mismatch /> }
                TypeArgumentMatch.Conflict => { return <TypeArgumentMatch.Conflict /> }
            }
            index += 1U64
        }
        if deferred { return <TypeArgumentMatch.Deferred /> }
        return <TypeArgumentMatch.Matched />
    }

    // Candidate writes are transactional: a mismatched constructor cannot
    // leak partially collected substitutions into the next argument.
    inout fn extendCallTypeArguments(pattern: U64, argument: U64, params: FuncBindRange, values: Array[U64], offset: U64) -> Result[Array[U64], CompileDiagnostic] {
        mut val candidate = values
        match self.matchCallTypeArguments(pattern: pattern, argument: argument, params: params, values: inout candidate) {
            TypeArgumentMatch.Matched | TypeArgumentMatch.Deferred => { return <Result.Ok value=candidate /> }
            TypeArgumentMatch.Mismatch => { return <Result.Ok value=values /> }
            TypeArgumentMatch.Conflict => {
                return <Result.Err error=self.typeArgumentConflictDiagnostic(offset: offset) />
            }
        }
    }

    // Expected-result refinement needs a complete match; a deferred equation
    // supplies no proof that the expected result fits the selected callable.
    inout fn matchCallResultArguments(pattern: U64, expected: U64, params: FuncBindRange, values: inout Array[U64]) -> Bool {
        mut val candidate = values
        match self.matchCallTypeArguments(pattern: pattern, argument: expected, params: params, values: inout candidate) {
            TypeArgumentMatch.Matched => {
                values = candidate
                return true
            }
            _ => { return false }
        }
    }

    inout fn callTemplateForCurrentBody(exprId: U64, slot: U64 = 0U64) -> Result[CallTemplate, CompileDiagnostic] {
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.bodyFnIdx, exprId: exprId, slot: slot))
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() { return <Result.Ok value=self.decls.callTemplates[index] />}
        // See sameCallSiteOrigin: a callee-owned default expression is
        // materialized under its caller BodyInstance.  Reusing its immutable
        // declaration-time template is not a second lookup; it is the one
        // lexical selection identified by the source origin.  Source spans
        // plus parser origin serial make the fallback unique.  If it is not
        // unique, retain the missing sentinel and fail closed at the consumer.
        mut val found: U64 = self.decls.callTemplates.count()
        mut val i: U64 = 0U64
        while i < self.decls.callTemplates.count() {
            val candidate: CallTemplate = self.decls.callTemplates[i]
            if self.sameCallSiteOrigin(a: candidate.siteKey, b: siteKey) {
                if found < self.decls.callTemplates.count() { return <Result.Ok value=<CallTemplate siteKey=siteKey /> />}
                found = i
            }
            i += 1U64
        }
        if found < self.decls.callTemplates.count() { return <Result.Ok value=self.decls.callTemplates[found] />}
        return <Result.Ok value=<CallTemplate siteKey=siteKey /> />
    }

    // Read the immutable Record result for one lexical source body without
    // installing a BodyInstance/Cursor. Mid's parametric builder uses this
    // exact-key query; it must not pretend to be the current Mono body or
    // recover a call from Expr spelling. Default-expression origin fallback is
    // deliberately excluded here: it belongs to the materializing caller,
    // whereas a parametric source body owns only its own recorded templates.
    // Unit is a known result of a selected signature, not a fallback for an
    // absent expression type. Keep that distinction at the frontend boundary.
    inout fn callTemplateReturnsUnit(template: CallTemplate) -> Bool {
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                return callee < self.arena.functionCount() && self.functionDeclarationReturnsUnit(f: self.arena.functionAt(index: callee))
            }
            CallTemplateKind.StaticMethod(receiver: _, args: _, resolution: val resolution, methodTypeArgs: _, resultTerm: _) => {
                return self.staticMemberReturnsUnit(resolution: resolution)
            }
            CallTemplateKind.Operator(op: _, operands: _, resolution: val selection, resultTerm: _) => {
                match selection {
                    OperatorSelection.Direct(callee: val callee) => { return self.functionDeclarationReturnsUnit(f: self.arena.functionAt(index: callee)) }
                    OperatorSelection.Static(resolution: val resolution) => { return self.staticMemberReturnsUnit(resolution: resolution) }
                    _ => { return false }
                }
            }
            CallTemplateKind.Dynamic(receiver: _, args: _, target: val target) => {
                match target {
                    DynamicCallTemplateTarget.ClosureLocal(bindingDeclStart: _, fnTypeTerm: val term) => { return self.functionTypeReturnsUnit(ref: term) }
                    DynamicCallTemplateTarget.ClosureField(fieldIndex: _, fnTypeTerm: val term) => { return self.functionTypeReturnsUnit(ref: term) }
                    DynamicCallTemplateTarget.ExistentialRequirement(traitIdx: val traitIdx, slot: val slot) => {
                        if slot == 0U64 { return false }
                        return self.traitRequirementReturnsUnit(traitIdx: traitIdx, reqIdx: slot - 1U64)
                    }
                }
            }
            _ => { return false }
        }
    }

    inout fn staticMemberReturnsUnit(resolution: StaticMemberResolution) -> Bool {
        match resolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val traitIdx, reqIdx: val reqIdx) => { return self.traitRequirementReturnsUnit(traitIdx: traitIdx, reqIdx: reqIdx) }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val callee) => { return callee < self.arena.functionCount() && self.functionDeclarationReturnsUnit(f: self.arena.functionAt(index: callee)) }
            _ => { return false }
        }
    }

    inout fn traitRequirementReturnsUnit(traitIdx: U64, reqIdx: U64) -> Bool {
        if traitIdx >= self.decls.traitCount() { return false }
        val declaration = self.decls.traitAt(index: traitIdx)
        if reqIdx >= declaration.reqs.count() { return false }
        return self.functionDeclarationReturnsUnit(f: self.traitReqAt(reqs: declaration.reqs, index: reqIdx))
    }

    fn functionDeclarationReturnsUnit(f: Func) -> Bool {
        // An async declaration's omitted payload result still yields a
        // Promise at the call site; it is not a Unit-valued call.
        return !f.hasRet && !f.isAsync
    }

    inout fn functionTypeReturnsUnit(ref: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.typeCount() || !self.isFnType(ref: ref) { return false }
        val signature: TypeRef = self.arena.typeAt(index: ref)
        if signature.args.count() == 0U64 { return false }
        return self.callableResultIsUnit(ref: signature.args[0U64])
    }

    // Only callable result slots interpret the omitted-type sentinel as ().
    // Explicit () is represented by the same empty record as other annotations.
    // Completed callable slots use the existing no-payload representation for
    // Unit. Normalize after substitution, since an associated result may be ().
    fn callableResultSlot(ref: U64) -> U64 {
        if self.callableResultIsUnit(ref: ref) { return 0U64 }
        return ref
    }

    // Equality at a completed callable result boundary, where an omitted
    // result and explicit () have the same meaning. Never use for unknown
    // expression types or parameter slots.
    inout fn callableResultTypesEqual(a: U64, b: U64) -> Bool {
        if self.callableResultIsUnit(ref: a) && self.callableResultIsUnit(ref: b) { return true }
        return self.typeRefEq(a: a, b: b)
    }

    fn callableResultIsUnit(ref: U64) -> Bool {
        if ref == 0U64 { return true }
        if ref >= self.arena.typeCount() { return false }
        val term = self.arena.typeTerms[ref]
        return (term.isRecord && term.recordFieldTerms.count() == 0U64) || (term.nameLen == 0U64 && term.args.count() == 0U64 && term.paramId == 0U64 && term.assocNameId == 0U64 && !term.isAny)
    }

    inout fn callTemplateForSourceBody(fnIdx: U64, exprId: U64) -> Result[CallTemplate, CompileDiagnostic] {
        val siteKey: CallSiteKey = (try self.templateCallSiteKey(fnIdx: fnIdx, exprId: exprId))
        val index: U64 = self.decls.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() { return <Result.Ok value=self.decls.callTemplates[index] />}
        return <Result.Ok value=<CallTemplate siteKey=siteKey /> />
    }

    // The declaration-time semantic term of an expression. Most expressions
    // are supplied by Record; an identifier's lexical Local is equally a
    // first-class producer, and remains available while a legacy TypeInfo
    // adapter is unable to represent a symbolic generic instance. This is one
    // central read boundary, not an OptChain-specific recovery.
    inout fn parametricExprTerm(exprId: U64) -> U64 {
        val recorded: U64 = self.semanticExprTerm(exprId: exprId)
        if recorded != 0U64 { return recorded }
        // A Chain desugar replaces an OptChain node with MatchExpr after the
        // ordinary expression record pass.  Its parametric result is therefore
        // owned by ChainSite rather than the AST-global expression entry.  This
        // belongs in the central semantic-term reader: an outer `?.` must be
        // able to use an already-rewritten inner `?.` as its receiver without
        // re-deriving the MatchExpr or falling back to a concrete instance.
        val chain: ChainSite = self.chainSiteFor(exprId: exprId)
        if chain.stageRef != 0U64 { return chain.stageRef }
        match self.arena.exprs[exprId] {
            Expr.Ident(val start, val len) => {
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    return self.cur.locals[localIdx].ty
                }
            }
            _ => {}
        }
        return 0U64
    }

    inout fn semanticExprTypeInfo(exprId: U64) -> TypeInfo {
        if exprId < self.arena.semanticExprTypes.count() {
            val e: SemanticExprType = self.arena.semanticExprTypes[exprId]
            return <TypeInfo kind=e.legacyKind nameStart=e.legacyNameStart nameLen=e.legacyNameLen ref=e.legacyRef viewExtId=e.legacyViewExtId />
        }
        return scalarInfo()
    }

    // Read a recorded expression type under an explicit body environment. An
    // unknown scalar intentionally keeps its recorded adapter: reconstructing
    // it from a term would prematurely choose a concrete numeric type. Every
    // other recorded shape derives its legacy projection from the grounded
    // term, so `T`/views/projections cannot leak across sibling instances.
    inout fn groundSemanticExprTypeInfo(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[TypeInfo, CompileDiagnostic] {
        val entry: TypeInfo = self.semanticExprTypeInfo(exprId: exprId)
        if exprId >= self.arena.semanticExprTypes.count() { return <Result.Ok value=entry />}
        val e: SemanticExprType = self.arena.semanticExprTypes[exprId]
        if e.shape == 0U64 || e.term == 0U64 { return <Result.Ok value=entry />}
        val grounded: U64 = (try self.groundTermForBody(ref: e.term, environment: environment, selfRef: selfRef, itemRef: itemRef))
        if grounded != 0U64 && grounded < self.arena.typeCount() {
            return <Result.Ok value=self.typeInfoOfRef(ref: grounded) />
        }
        return <Result.Ok value=entry />
    }

    // The TypeRef counterpart of groundSemanticExprTypeInfo.  It is the sole
    // read of an ExprId-owned semantic term under an explicit environment;
    // structural expressions such as field/index selection compose this query
    // instead of reopening typeOf.  A Chain rewrite owns its result in
    // ChainSite until it can be recorded in the ordinary slot.
    inout fn groundSemanticExprTypeRef(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[U64, CompileDiagnostic] {
        mut val term: U64 = self.semanticExprTerm(exprId: exprId)
        if term == 0U64 {
            term = self.chainSiteFor(exprId: exprId).stageRef
        }
        if term == 0U64 { return <Result.Ok value=0U64 />}
        return <Result.Ok value=(try self.groundTermForBody(ref: term, environment: environment, selfRef: selfRef, itemRef: itemRef)) />
    }


    inout fn recordSemanticExprInfo(exprId: U64, ti: TypeInfo) {
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        val term: U64 = self.typedIrRefOfInfo(ti: ti)
        // An unresolved adapter cannot invalidate a published semantic term
        // or its canonical projection. A partial structural shape supplies no
        // replacement type, just as an unknown scalar supplies none.
        if term == 0U64 && prior.term != 0U64 { return }
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType typeState=self.refinedSemanticTypeState(prior: prior.typeState, term: term) completion=prior.completion invocation=prior.invocation term=term shape=self.semanticExprShape(ti: ti) legacyKind=ti.kind legacyNameStart=ti.nameStart legacyNameLen=ti.nameLen legacyRef=ti.ref legacyViewExtId=ti.viewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed />)
    }

    // A context or synthetic lowering can refine an already-recorded type term.
    // Derive its legacy shape from the term at this single boundary instead of
    // leaving array/chain/operator-specific caches behind.
    inout fn recordSemanticExprTerm(exprId: U64, term: U64) {
        if term == 0U64 || term >= self.arena.typeCount() { return }
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        val ti: TypeInfo = self.typeInfoOfRef(ref: term)
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType typeState=self.refinedSemanticTypeState(prior: prior.typeState, term: term) completion=prior.completion invocation=prior.invocation term=term shape=self.semanticExprShape(ti: ti) legacyKind=ti.kind legacyNameStart=ti.nameStart legacyNameLen=ti.nameLen legacyRef=ti.ref legacyViewExtId=ti.viewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed />)
    }

    inout fn recordSemanticExprLiteralContext(exprId: U64, context: U64) {
        if context == 0U64 { return }
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        if prior.literalContext == context && prior.term != 0U64 { return }
        mut val term = prior.term
        if term == 0U64 && prior.shape == 0U64 {
            match prior.typeState {
                SemanticExpressionTypeState.Unrecorded | SemanticExpressionTypeState.Pending => {
                    val name = self.internBytes(s: intCtxKw(code: context))
                    term = self.findOrAddTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
                }
                _ => {}
            }
        }
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType typeState=self.refinedSemanticTypeState(prior: prior.typeState, term: term) completion=prior.completion invocation=prior.invocation term=term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=context hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed />)
    }

    // The frontend resolves a field name once, while the receiver's complete
    // TypeTerm still identifies its nominal layout.  Mid uses this selected
    // slot together with the expression's recorded result term; it never
    // re-runs a spelling-to-field lookup during code generation.
    inout fn recordSemanticExprFieldProjection(exprId: U64, index: U64, isBoxed: Bool) {
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType typeState=prior.typeState completion=prior.completion invocation=prior.invocation term=prior.term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext hasFieldProjection=true fieldProjectionIndex=index fieldProjectionIsBoxed=isBoxed />)
    }

    // Record selection evidence independently from the expression result
    // TypeTerm.  A later body-instance ground reads the term for type equality
    // and the provenance for CallResolution; neither reader needs AST recovery.
    inout fn recordSemanticExprCall(exprId: U64, callee: U64, receiver: CallTemplateReceiver, args: ArgRange, calleeTypeArgs: Array[U64], resultTerm: U64, proof: StaticConformanceProof = <StaticConformanceProof.Missing />, receiverTypeTerm: U64 = 0U64) -> Result[(), CompileDiagnostic] {
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        mut val contract = prior.invocation
        if callee < self.arena.functionCount() {
            contract = if self.arena.functionAt(index: callee).isDiverging { give <InvocationCompletion.Diverges /> } else { give <InvocationCompletion.Returns /> }
        }
        mut val state = prior.typeState
        mut val returnsUnit = false
        if callee < self.arena.functionCount() {
            val declaration = self.arena.functionAt(index: callee)
            returnsUnit = self.callableResultIsUnit(ref: self.semanticCallableReturnTerm(function: declaration))
            if declaration.isDiverging { state = <SemanticExpressionTypeState.NoNormalValue /> }
            else if returnsUnit { state = <SemanticExpressionTypeState.Unit /> }
        }
        mut val next: SemanticExprType = <SemanticExprType typeState=state completion=prior.completion invocation=contract term=prior.term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed />
        if resultTerm != 0U64 && resultTerm < self.arena.typeCount() {
            val ti: TypeInfo = self.typeInfoOfRef(ref: resultTerm)
            next = <SemanticExprType typeState=self.refinedSemanticTypeState(prior: next.typeState, term: resultTerm) completion=prior.completion invocation=contract term=resultTerm shape=self.semanticExprShape(ti: ti) legacyKind=ti.kind legacyNameStart=ti.nameStart legacyNameLen=ti.nameLen legacyRef=ti.ref legacyViewExtId=ti.viewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex fieldProjectionIsBoxed=prior.fieldProjectionIsBoxed />
        }
        self.arena.semanticExprTypes.set(i: exprId, value: next)
        if returnsUnit {
            try self.recordKnownExpressionResult(exprId: exprId, resultTerm: resultTerm)
        }
        // Every Direct producer (including one whose callee was cached by
        // verification) crosses this single semantic boundary.  If the
        // selected declaration is a provided copy, attach its static proof
        // here from the already-recorded receiver term; Mono must never infer
        // it from syntax again.
        mut val selectedProof: StaticConformanceProof = proof
        if self.proofIsMissing(proof: selectedProof) && callee < self.arena.functionCount() {
            val f: Func = self.arena.functionAt(index: callee)
            if f.isProvided {
                match receiver {
                    CallTemplateReceiver.Term(term: val receiverTerm) => {
                        val resolution: StaticMemberResolution = (try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: f.nameStart, nameLen: f.nameLen, args: args))
                        match resolution {
                            StaticMemberResolution.Requirement(proof: val resolved, traitIdx: _, reqIdx: _) => { selectedProof = resolved }
                            StaticMemberResolution.Provided(proof: val resolved, traitIdx: _, callee: _) => { selectedProof = resolved }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
        }
        try self.recordCallTemplate(exprId: exprId, callee: callee, receiver: receiver, args: args, calleeTypeArgs: calleeTypeArgs, proof: selectedProof, receiverTypeTerm: receiverTypeTerm)
        return <Result.Ok value=() />
    }

    // Select bidirectional construction context without recording its children.
    // Callers can establish the instance before visiting declaration defaults;
    // a written nominal specialization still owns its type arguments.
    inout fn makeAcceptsExpectedTerm(exprId: U64, writtenTerm: U64, isEnum: Bool, fields: MakeFieldRange, expectedTerm: U64) -> Result[Bool, CompileDiagnostic] {
        if expectedTerm == 0U64 || expectedTerm >= self.arena.typeCount() { return <Result.Ok value=false />}
        val expected = self.arena.typeTerms[expectedTerm]
        mut val acceptsContext: Bool = false
        // Structural record literals are bidirectional constructions.
        // Their synthetic layout declaration is not the owner of a
        // surrounding generic field's binders. Keep the expected
        // record's labelled children as the semantic slot types.
        mut val isRecord = false
        if !isEnum && !self.pendingConstructionContexts.contains(exprId) {
            match self.arena.exprs[exprId] {
                Expr.Make(typeStart: _, val typeLen, variantStart: _, variantLen: _, isEnum: _, ty: _, fields: _) => { isRecord = typeLen == 0U64 }
                _ => {}
            }
            if writtenTerm != 0U64 && writtenTerm < self.arena.typeCount() { isRecord = isRecord || self.arena.typeTerms[writtenTerm].isRecord }
        }
        // A structural literal owns its labels before it owns a result type.
        // Lower may supply a hint, but a missing hint cannot block semantic
        // context from reaching the fields. Pending nominal constructors are
        // resolved by their own producer before reaching this boundary.
        if expected.isRecord && isRecord && fields.len == expected.recordFieldTerms.len {
            acceptsContext = true
            mut val fieldIndex: U64 = 0U64
            while fieldIndex < fields.len {
                val field = self.makeFieldAt(fields: fields, index: fieldIndex)
                if self.fieldIndexOfReceiver(receiverRef: expectedTerm, fieldStart: field.nameStart, fieldLen: field.nameLen) >= expected.recordFieldTerms.len { acceptsContext = false }
                fieldIndex += 1U64
            }
        }
        if expected.hasDecl && expected.args.len > 0U64 && !expected.hasTopLevelView() {
            if writtenTerm != 0U64 && writtenTerm < self.arena.typeCount() {
                val written = self.arena.typeTerms[writtenTerm]
                acceptsContext = written.args.len == 0U64 && written.hasDecl && written.declOffset == expected.declOffset && !written.hasTopLevelView()
            } else if isEnum {
                // An enum constructor without written arguments has
                // no AST TypeRef. Its selected aggregate declaration
                // supplies identity; do not recover it by head spelling.
                val aggregateIndex = (try self.semanticAggregateIndex(ownerFnIdx: self.cur.checkFn, exprId: exprId))
                if aggregateIndex < self.decls.semanticAggregates.count() {
                    match self.decls.semanticAggregates[aggregateIndex].kind {
                        SemanticAggregateKind.Enum(enumIdx: val enumIndex, variantIndex: _) => {
                            if enumIndex < self.arena.enumCount() {
                                val declaration = self.arena.enumAt(index: enumIndex)
                                acceptsContext = declaration.defOffset == expected.declOffset && declaration.typeParams.count() == expected.args.len
                            }
                        }
                        _ => {}
                    }
                }
            }
        }
        return <Result.Ok value=acceptsContext />
    }

    inout fn acceptsFloatingOperandContext(exprId: U64, siblingExprId: U64, siblingTerm: U64) -> Bool {
        if siblingTerm == 0U64 || siblingTerm >= self.arena.typeCount() { return false }
        if contextualNumericExpression(self.arena.exprs, exprId: siblingExprId) || !contextualNumericExpression(self.arena.exprs, exprId: exprId) { return false }
        val type = self.arena.typeTerms[siblingTerm]
        return self.isFloatType(start: type.nameStart, len: type.nameLen)
    }

    inout fn recordFloatingOperandContext(lhs: U64, rhs: U64) -> Result[Bool, CompileDiagnostic] {
        val left = self.parametricExprTerm(exprId: lhs)
        val right = self.parametricExprTerm(exprId: rhs)
        if self.acceptsFloatingOperandContext(exprId: rhs, siblingExprId: lhs, siblingTerm: left) {
            try self.recordSemanticExprExpectedResult(exprId: rhs, expectedTerm: left)
            return <Result.Ok value=true />
        }
        if self.acceptsFloatingOperandContext(exprId: lhs, siblingExprId: rhs, siblingTerm: right) {
            try self.recordSemanticExprExpectedResult(exprId: lhs, expectedTerm: right)
            return <Result.Ok value=true />
        }
        return <Result.Ok value=false />
    }

    inout fn recordBlockExpectedResult(blkId: U64, expectedTerm: U64) -> Result[(), CompileDiagnostic] {
        // This is a construction-time refinement, not a type reader. Reuse
        // recorded completion when present and refresh the result fact after
        // contextualizing the child; parents consume only the published fact.
        mut val typing: SemanticValueBlockTyping = <SemanticValueBlockTyping.Pending />
        if blkId < self.arena.semanticValueBlocks.count() { typing = self.arena.semanticValueBlocks[blkId] }
        match typing {
            SemanticValueBlockTyping.Checked(val completion, resultTerm: _) => {
                if !completion.source.normal() { return <Result.Ok value=() /> }
            }
            SemanticValueBlockTyping.Pending => {
                if !self.blockCompletion(blkId: blkId).source.normal() { return <Result.Ok value=() /> }
            }
        }
        val value = self.blockGiveExpr(blkId: blkId)
        if value < self.arena.exprs.count() {
            try self.recordSemanticExprExpectedResult(exprId: value, expectedTerm: expectedTerm)
            match typing {
                SemanticValueBlockTyping.Checked(val completion, val resultTerm) => {
                    mut val refined = self.semanticExprTerm(exprId: value)
                    if refined == 0U64 { refined = resultTerm }
                    self.arena.semanticValueBlocks.set(i: blkId, value: <SemanticValueBlockTyping.Checked completion=completion resultTerm=refined />)
                }
                SemanticValueBlockTyping.Pending => {}
            }
        }
        return <Result.Ok value=() />
    }

    // Record the expected result while the lexical body is still being built.
    // A selected call uses it to complete its own binders before value checking.
    // The resulting type comes from that substitution into the declaration;
    // expected terms never replace the expression's independent meaning.
    inout fn recordSemanticExprExpectedResult(exprId: U64, expectedTerm: U64) -> Result[(), CompileDiagnostic] {
        // Normalize at the context boundary before inspecting expression shape.
        mut val normalizedContext = expectedTerm
        if self.typeTermContainsAssociatedProjection(ref: normalizedContext) {
            normalizedContext = try self.normalizedValueType(ref: normalizedContext)
        }
        if normalizedContext == 0U64 || normalizedContext >= self.arena.typeCount() { return <Result.Ok value=() /> }
        if self.expressionNeedsTypeContext(exprId: exprId) { try self.recordExpr(exprId: exprId, expectedTerm: normalizedContext) }
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        try self.recordCallTemplateExpectedResult(exprId: exprId, expectedTerm: normalizedContext)
        // Array construction is a bidirectional value form: at its explicit
        // expected-result boundary the Array[E] term is the semantic result,
        // not merely a hint for an empty literal. Record also refreshes its
        // aggregate carrier, so Mid consumes the same selected E and never
        // reconstructs it from an element literal or method receiver query.
        match self.arena.exprs[exprId] {
            // A value block passes its surrounding expectation to its give,
            // including expectations discovered after the initial arm walk.
            // Use recorded child types afterwards; never label a mismatched
            // explicit child with the expected type to make it pass.
            Expr.Sequence(val body) => {
                try self.recordBlockExpectedResult(blkId: body, expectedTerm: normalizedContext)
                self.recordValueBlockResult(exprId: exprId, blockId: body)
            }
            Expr.Block(val body, offset: _) => {
                try self.recordBlockExpectedResult(blkId: body, expectedTerm: normalizedContext)
                self.recordValueBlockResult(exprId: exprId, blockId: body)
            }
            Expr.IfChain(conditions: _, val thenBlk, val elseBlk) | Expr.IfExpr(cond: _, thenBlk: val thenBlk, elseBlk: val elseBlk) => {
                try self.recordBlockExpectedResult(blkId: thenBlk, expectedTerm: normalizedContext)
                try self.recordBlockExpectedResult(blkId: elseBlk, expectedTerm: normalizedContext)
                if !self.recordValueBlockResult(exprId: exprId, blockId: thenBlk) {
                    self.recordValueBlockResult(exprId: exprId, blockId: elseBlk)
                }
            }
            Expr.MatchExpr(scrut: _, arms: val arms) => {
                mut val index: U64 = 0U64
                mut val selected: Bool = false
                while index < arms.len {
                    val arm = self.matchArmAt(arms: arms, index: index)
                    try self.recordBlockExpectedResult(blkId: arm.body, expectedTerm: normalizedContext)
                    if !selected {
                        selected = self.recordValueBlockResult(exprId: exprId, blockId: arm.body)
                    }
                    index += 1U64
                }
            }

            Expr.Make(typeStart: val typeStart, typeLen: val typeLen, variantStart: val variantStart, variantLen: val variantLen, isEnum: val isEnum, ty: val writtenTerm, fields: val fields) => {
                val acceptsContext: Bool = (try self.makeAcceptsExpectedTerm(exprId: exprId, writtenTerm: writtenTerm, isEnum: isEnum, fields: fields, expectedTerm: normalizedContext))
                if acceptsContext {
                        self.recordSemanticExprTerm(exprId: exprId, term: normalizedContext)
                        mut val fieldIndex: U64 = 0U64
                        while fieldIndex < fields.len {
                            val field = self.makeFieldAt(fields: fields, index: fieldIndex)
                            mut val fieldTerm: U64 = 0U64
                            if isEnum {
                                fieldTerm = self.typedIrRefOfInfo(ti: (try self.genericEnumFieldTypeInfo(instRef: normalizedContext, variantStart: variantStart, variantLen: variantLen, fieldStart: field.nameStart, fieldLen: field.nameLen)))
                            } else {
                                fieldTerm = (try self.fieldTypeRefOfReceiver(receiverRef: normalizedContext, fieldStart: field.nameStart, fieldLen: field.nameLen))
                            }
                            try self.recordSemanticExprExpectedResult(exprId: field.value, expectedTerm: fieldTerm)
                            fieldIndex += 1U64
                        }
                        try self.recordSemanticAggregate(exprId: exprId)
                }
            }
            // A declared slot supplies the integer width before aggregate
            // recording, regardless of whether an enclosing Let visits it.
            // Reuse the literal checker so publishing a type never bypasses
            // range validation; explicit suffixes and Bool own their types.
            Expr.Int(value: _, offset: _, isBool: val isBool, tyStart: _, tyLen: val suffixLen, isNeg: _) => {
                if !isBool && suffixLen == 0U64 {
                    val expected: TypeRef = self.arena.typeAt(index: normalizedContext)
                    if self.isIntType(start: expected.nameStart, len: expected.nameLen) {
                        try self.checkLitCtx(id: exprId, eKind: 1U64, eBits: self.intBits(start: expected.nameStart, len: expected.nameLen), eSgn: self.intSigned(start: expected.nameStart, len: expected.nameLen))
                        self.recordSemanticExprTerm(exprId: exprId, term: normalizedContext)
                    } else if self.isFloatType(start: expected.nameStart, len: expected.nameLen) {
                        self.recordSemanticExprTerm(exprId: exprId, term: normalizedContext)
                    }
                }
            }
            // A suffix owns its type. An unsuffixed float is bidirectional in
            // the same way as an unsuffixed integer, but unlike integers the
            // old literal-context carrier has no float width. Publish the
            // already-validated F32/F64 term directly so every frozen
            // consumer, including Mid return resolution, observes it.
            Expr.Float(start: _, len: _, tyStart: _, tyLen: val suffixLen) => {
                if suffixLen == 0U64 {
                    val expected: TypeRef = self.arena.typeAt(index: normalizedContext)
                    if self.isFloatType(start: expected.nameStart, len: expected.nameLen) {
                        self.recordSemanticExprTerm(exprId: exprId, term: normalizedContext)
                    }
                }
            }
            Expr.Array(elems: _) => {
                try self.recordArrayLitCtx(exprId: exprId, ctxRef: normalizedContext)
            }
            _ => {}
        }
        // Bidirectional literal typing belongs to Record, not to Mono.  An
        // arithmetic subtree made solely of contextless literals has no
        // operand TypeTerm until its enclosing annotation supplies one (for
        // example `val x: F64 = 1 + 2 * 3`).  Propagate only through such
        // untyped arithmetic: an ordinary trait operation may have an
        // independent associated Output, and comparisons produce Bool, so
        // neither admits this equality propagation.
        val expectedNumeric = self.arena.typeTerms[normalizedContext]
        val floatingContext = self.isFloatType(start: expectedNumeric.nameStart, len: expectedNumeric.nameLen)
        val integerContext = self.isIntType(start: expectedNumeric.nameStart, len: expectedNumeric.nameLen)
        val numericContext = (floatingContext || integerContext) && contextualNumericExpression(self.arena.exprs, exprId: exprId, floatingLiterals: floatingContext)
        match self.arena.exprs[exprId] {
            Expr.Unary(val op, val operand) => {
                if numericContext {
                    try self.recordSemanticExprExpectedResult(exprId: operand, expectedTerm: normalizedContext)
                    val operandType = self.typeInfoOfRef(ref: self.parametricExprTerm(exprId: operand))
                    self.recordSemanticExprInfo(exprId: exprId, ti: (try self.unaryOperatorResultType(operand: operandType, op: op)))
                    try self.recordOperatorTemplate(exprId: exprId, op: op, operandExprs: [operand], isUnary: true)
                } else if (op == opSub() || op == opBitNot()) && self.parametricExprTerm(exprId: operand) == 0U64 {
                    try self.recordSemanticExprExpectedResult(exprId: operand, expectedTerm: normalizedContext)
                }
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                if numericContext {
                    try self.recordSemanticExprExpectedResult(exprId: lhs, expectedTerm: normalizedContext)
                    try self.recordSemanticExprExpectedResult(exprId: rhs, expectedTerm: normalizedContext)
                    val left = self.typeInfoOfRef(ref: self.parametricExprTerm(exprId: lhs))
                    val right = self.typeInfoOfRef(ref: self.parametricExprTerm(exprId: rhs))
                    self.recordSemanticExprInfo(exprId: exprId, ti: (try self.operatorOutputType(lt: left, rt: right, op: op)))
                    try self.recordOperatorTemplate(exprId: exprId, op: op, operandExprs: [lhs, rhs], isUnary: false)
                } else if isBinTraitOp(op: op) && self.parametricExprTerm(exprId: lhs) == 0U64 && self.parametricExprTerm(exprId: rhs) == 0U64 {
                    try self.recordSemanticExprExpectedResult(exprId: lhs, expectedTerm: normalizedContext)
                    try self.recordSemanticExprExpectedResult(exprId: rhs, expectedTerm: normalizedContext)
                }
            }
            _ => {}
        }
        try self.recordDeclarationConversion(exprId: exprId, target: normalizedContext)
        return <Result.Ok value=() />
    }

    // The explicit body-context read for the expected-result side of a call
    // template.  Zero means the source supplied no bidirectional context.
    inout fn groundSemanticCallExpectedResult(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[U64, CompileDiagnostic] {
        val expected: U64 = (try self.callTemplateForCurrentBody(exprId: exprId)).expectedResultTerm
        if expected == 0U64 { return <Result.Ok value=0U64 />}
        return <Result.Ok value=(try self.groundTermForBody(ref: expected, environment: environment, selfRef: selfRef, itemRef: itemRef)) />
    }

    // Ground the selected callee substitutions recorded beside an expression's
    // TypeTerm.  This is the direct producer→consumer handoff for generic free
    // calls; Mono must not re-infer a body-local `self` from AST/TypeInfo when
    // the parametric template already selected it.
    inout fn groundSemanticCallTypeArgs(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Result[Array[U64], CompileDiagnostic] {
        mut val out: Array[U64] = []
        mut val args: Array[U64] = []
        match (try self.callTemplateForCurrentBody(exprId: exprId)).kind {
            CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: val stored, proofId: _) => { args = self.callTemplateTypeArgs(range: stored) }
            _ => {}
        }
        mut val i: U64 = 0U64
        while i < args.count() {
            out.append((try self.groundTermForBody(ref: args[i], environment: environment, selfRef: selfRef, itemRef: itemRef)))
            i += 1U64
        }
        return <Result.Ok value=out />
    }

    // The grounded TypeRef of expression `id` under the BODY instance env — the typed-IR
    // read口 that replaces the backend's per-form exprTypeRef re-derivation. If the parametric
    // store has this expr's type (recorded during a locals-populated front-end walk), SUBSTITUTE
    // the emitted body's type args into it (groundTypeRef resolves `T`/`Self`/`Item`);
    // an already-grounded / scalar parametric ref grounds to itself. Grounding uses the
    // body-scoped env snapshot (cur.body*) — NOT the ambient cursor, which call
    // resolution transiently points at a CALLEE's env while this expr belongs to the
    // caller. Falls back to the instance-independent typeCache/typeOf projection (a
    // node the record pass could not reach).
    inout fn groundedTypeOf(id: U64) -> Result[U64, CompileDiagnostic] {
        // A shared generic body cannot take a field/index result from the
        // AST-global parametric cache: `self.items[i]` in `Set[E]` is stored
        // there as the lexical `E`, while this concrete body may be
        // `Set[String]`.  Derive the term through the selected body receiver
        // first.  This is a semantic type query, not a Mono/backend recovery:
        // every edge below is an explicit child of the TypeRef tree.
        match self.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                if self.cur.hasRecv && self.cur.bodyEnvironment.receiverRef != 0U64 {
                    val selfName: Bind = self.kwSpan(kw: "self", kwLen: 4U64)
                    if spansEqual(c: inout self, aStart: start, aLen: len, bStart: selfName.nameStart, bLen: selfName.nameLen) {
                        return <Result.Ok value=self.cur.bodyEnvironment.receiverRef />
                    }
                }
                // A body-local is a resolved semantic binding. Its TypeRef is
                // more precise than the shared AST cache: a `for` binding can
                // carry a concrete witness output such as
                // `(index: U64, value: I64)`, while the generic template at
                // the same expression site only knows `E`. Read the local
                // term first and ground it through this immutable body
                // environment; re-deriving it from TypeInfo loses the selected
                // proof and lets sibling instances contaminate one another.
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    val local: Local = self.cur.locals[localIdx]
                    if local.ty != 0U64 { return <Result.Ok value=(try self.groundBodyTerm(ref: local.ty)) />}
                }
            }
            // Field selection consumes the concrete receiver term.  In
            // particular, a direct `box#E.duplicate().first` must use the
            // nested call's completed CallResolution result, not re-open the
            // shared declaration template `(first: T, ...)`.  Probe the
            // descriptor only when the receiver is call syntax; calling the
            // full body-local receiver recovery for every ordinary field
            // turns declaration-time record walks into an O(body) hot path.
            // If Mono has not selected the nested call yet, preserve the
            // existing parametric query unchanged.
            Expr.Field(val base, val nameStart, val nameLen) => {
                mut val baseRef: U64 = 0U64
                match self.arena.exprs[base] {
                    Expr.Call(nameStart: _, nameLen: _, args: _) => { baseRef = (try self.bodyCalleeResultRef(exprId: base)) }
                    Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { baseRef = (try self.bodyCalleeResultRef(exprId: base)) }
                    Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => { baseRef = (try self.bodyCalleeResultRef(exprId: base)) }
                    _ => {}
                }
                if baseRef == 0U64 { baseRef = (try self.groundedTypeOf(id: base)) }
                if baseRef != 0U64 && baseRef < self.arena.typeCount() {
                    val fieldRef: U64 = (try self.fieldTypeRefOfReceiver(receiverRef: baseRef, fieldStart: nameStart, fieldLen: nameLen))
                    if fieldRef != 0U64 { return <Result.Ok value=fieldRef />}
                }
            }
            Expr.Index(val base, index: _) => {
                val baseRef: U64 = (try self.groundedTypeOf(id: base))
                if baseRef != 0U64 && baseRef < self.arena.typeCount() {
                    val baseTy: TypeRef = self.arena.typeAt(index: baseRef)
                    if baseTy.args.count() == 1U64 {
                        if rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Array") || rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Buffer") {
                            return <Result.Ok value=baseTy.args[0] />
                        }
                    }
                }
            }
            _ => {}
        }
        val recorded: U64 = (try self.groundSemanticExprTypeRef(exprId: id, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef))
        if recorded != 0U64 { return <Result.Ok value=recorded />}
        return <Result.Ok value=self.typedIrRefOfInfo(ti: (try self.typeOf(id: id))) />
    }
}

pub impl Comp {

    // Bottom-up type-argument inference for a generic construction whose head was NOT
    // grounded top-down during lowering (`val b = <Box v=1I32 />` — no annotation /
    // return / field context). The independent gen pipeline uses this flat walk
    // before collectGenerationBodyTypes. Ordinary bodies infer during Record.
    // For each un-grounded generic-struct Make, bind every type parameter from a field
    // whose declared type IS that bare parameter, using the field value's concrete type;
    // if every parameter is pinned consistently, rewrite Make.ty to the grounded instance.
    // Otherwise leave it un-grounded — a top-down context (backend expectedTy) may still
    // ground it, and a genuinely un-inferable construction is reported at construction.
    inout fn inferConstructTypeArgs() -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                    if !isEnum {
                        if !(self.isGenericInst(ref: ty)) {
                            val inferred: U64 = (try self.inferMakeInstance(typeStart: typeStart, typeLen: typeLen, typeRef: ty, fields: fields))
                            if inferred != 0U64 {
                                self.arena.exprs.set(i: i, value: <Expr.Make typeStart=typeStart typeLen=typeLen variantStart=variantStart variantLen=variantLen isEnum=isEnum ty=inferred fields=fields />)
                            }
                        }
                    }
                }
                _ => {}
            }
            i += 1
        }
        return <Result.Ok value=() />
    }

    // The synthetic record-struct TypeRef for a context-less record literal
    // (`(a: e, b: f)` lowers to a Make with NO type name): the literal is
    // self-describing — its labels plus its field values' types key the SAME
    // canonical struct an annotated record type lowers to (ensureRecordStruct),
    // so both spellings are one structural type. Returns 0 when any field
    // value's type is not inferable here (an unsuffixed literal keeps its
    // "no type from context" report). Recorded field terms include arrays and
    // other composite values, without reconstructing them from the legacy head.
    inout fn inferRecordMakeRef(fields: MakeFieldRange) -> Result[U64, CompileDiagnostic] {
        // the empty record `()` is the unit value — self-description degenerates to
        // the zero-field canonical struct `()` (the same struct an annotated
        // `val u: () = ()` lowers to), so a bare bind types without an annotation.
        mut val names: Array[String] = []
        mut val tys: Array[PType] = []
        mut val terms: Array[U64] = []
        mut val i: U64 = 0
        while i < fields.len {
            val mf: MakeField = self.makeFieldAt(fields: fields, index: i)
            mut val fref = self.parametricExprTerm(exprId: mf.value)
            if fref == 0U64 {
                fref = self.typedIrRefOfInfo(ti: (try self.exprType(id: mf.value)))
            }
            if fref == 0U64 { return <Result.Ok value=0U64 /> }
            val ti = self.typeInfoOfRef(ref: fref)
            mut val nb: Array[U8] = []
            mut val k: U64 = 0
            while k < mf.nameLen {
                nb.append(self.arena.bytes[mf.nameStart + k])
                k += 1
            }
            names.append(stringFromBytesUnchecked(nb))
            tys.append(<PType start=ti.nameStart len=ti.nameLen isArray=ti.kind == 3I64 ref=fref />)
            terms.append(fref)
            i += 1
        }
        val rnm: Bind = self.ensureRecordStruct(fieldNames: names, fieldTys: tys)
        return <Result.Ok value=(try self.recordTypeTerm(name: rnm, fieldNames: names, fieldTerms: terms)) />
    }

    // The grounded TypeRef inferred for a generic-struct construction, or 0 when it can't
    // be inferred: not a generic struct, a parameter no bare field pins, or a field value
    // that is untyped / an array element / conflicts with another field's binding.
    // Only declaration-owned parameters missing from this construction are
    // inference variables. Enclosing lexical parameters remain valid context.
    inout fn typeTermUsesOpenParameters(ref: U64, parameters: Array[Bind], boundCount: U64) -> Bool {
        if ref == 0U64 || ref >= self.arena.typeCount() { return false }
        val term = self.arena.typeAt(index: ref)
        mut val index = boundCount
        while index < parameters.count() {
            if term.paramId != 0U64 && term.paramId == parameters[index].paramId { return true }
            index += 1U64
        }
        index = 0U64
        while index < term.args.count() {
            if self.typeTermUsesOpenParameters(ref: term.args[index], parameters: parameters, boundCount: boundCount) { return true }
            index += 1U64
        }
        index = 0U64
        while index < term.recordFieldTerms.count() {
            if self.typeTermUsesOpenParameters(ref: term.recordFieldTerms[index], parameters: parameters, boundCount: boundCount) { return true }
            index += 1U64
        }
        if term.projectionReceiver != 0U64 && self.typeTermUsesOpenParameters(ref: term.projectionReceiver, parameters: parameters, boundCount: boundCount) { return true }
        index = 0U64
        while index < term.assocTraitArgs.count() {
            if self.typeTermUsesOpenParameters(ref: term.assocTraitArgs[index], parameters: parameters, boundCount: boundCount) { return true }
            index += 1U64
        }
        return false
    }

    inout fn constructionFieldContext(instance: U64, fieldTerm: U64) -> U64 {
        if instance == 0U64 || instance >= self.arena.typeCount() { return fieldTerm }
        val term = self.arena.typeAt(index: instance)
        mut val parameters: Array[Bind] = []
        val structure = self.structIndexForType(ref: instance)
        if structure < self.arena.structCount() {
            parameters = self.arena.structAt(index: structure).typeParams
        } else {
            val enumeration = self.enumIndexForType(ref: instance)
            if enumeration < self.arena.enumCount() { parameters = self.arena.enumAt(index: enumeration).typeParams }
        }
        if term.args.count() < parameters.count() && self.typeTermUsesOpenParameters(ref: fieldTerm, parameters: parameters, boundCount: term.args.count()) { return 0U64 }
        return fieldTerm
    }

    inout fn inferMakeInstance(typeStart: U64, typeLen: U64, typeRef: U64, fields: MakeFieldRange) -> Result[U64, CompileDiagnostic] {
        // Argument inference refines the selected declaration; it cannot
        // replace it with a same-spelled generic from another module.
        mut val declaration = <Bind nameStart=0U64 nameLen=0U64 fieldStart=0U64 fieldLen=0U64 />
        if typeRef != 0U64 && typeRef < self.arena.typeCount() {
            val term = self.arena.typeTerms[typeRef]
            if term.hasDecl { declaration = <Bind nameStart=term.declOffset nameLen=1U64 fieldStart=0U64 fieldLen=0U64 /> }
        }
        if declaration.nameLen == 0U64 { declaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: typeStart), start: typeStart, len: typeLen) }
        if declaration.nameLen == 0U64 { return <Result.Ok value=0U64 /> }
        val sidx = self.arena.structIndexByOffset(offset: declaration.nameStart)
        if sidx >= self.arena.structCount() {
            return <Result.Ok value=0U64 />
        }
        val sd: StructDef = self.arena.structAt(index: sidx)
        if sd.typeParams.count() == 0U64 {
            return <Result.Ok value=0U64 />
        }
        if sd.fields.count() == 0U64 {
            return <Result.Ok value=0U64 />
        }
        mut val args: Array[U64] = []
        while args.count() < sd.typeParams.count() { args.append(0U64) }
        val parameters = <PatternBindInput.Values values=sd.typeParams />
        mut val index = 0U64
        while index < sd.fields.count() {
            val field = sd.fields[index]
            val argument = try self.makeFieldArgRef(fieldNameId: field.nameId, fields: fields)
            mut val candidate = args
            match self.matchTypeArgumentConstraints(pattern: field.ty, argument: argument, params: parameters, values: inout candidate) {
                TypeArgumentMatch.Matched | TypeArgumentMatch.Deferred => { args = candidate }
                TypeArgumentMatch.Mismatch => {}
                TypeArgumentMatch.Conflict => { return <Result.Ok value=0U64 /> }
            }
            index += 1U64
        }
        if !self.fnArgsAllResolved(args: args) { return <Result.Ok value=0U64 /> }
        // Inference selects the arguments of this declaration; it must not
        // erase its nominal identity. Mid ownership classification and later
        // substitutions consume that identity without repeating name lookup.
        return <Result.Ok value=self.pushType(t: <TypeRef nameStart=typeStart nameLen=typeLen hasDecl=true declOffset=sd.defOffset args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] />) />
    }

    // Field values use the same lexical type authority as call arguments.
    // Unknown/contextual values remain unknown; concrete body substitutions
    // and spelling-based TypeRef reconstruction cannot choose the result.
    inout fn makeFieldArgRef(fieldNameId: U64, fields: MakeFieldRange) -> Result[U64, CompileDiagnostic] {
        mut val index = 0U64
        while index < fields.len {
            val field = self.makeFieldAt(fields: fields, index: index)
            if intern(c: inout self, start: field.nameStart, len: field.nameLen) == fieldNameId {
                return self.inferenceArgumentType(exprId: field.value)
            }
            index += 1U64
        }
        return <Result.Ok value=0U64 />
    }
}
