// Part of name/type resolution (root: _.pw): expression type-cache table
// construction.

pub impl Comp {

    // Allocate the typed-AST cache (one slot per expression node), all unfilled.
    // Called once before emission; expr ids are stable by then.
    inout fn buildExprTyTable() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            self.typeCache.kind.append(typeUnfilled())
            self.typeCache.start.append(0)
            self.typeCache.len.append(0)
            self.typeCache.ref.append(0)
            self.typeCache.viewId.append(0)
            self.typeCache.intCtx.append(0)
            self.typeCache.callee.append(calleeUnfilled())
            self.typeCache.identBind.append(identUnfilledCode())
            self.typeCache.identTarget.append(identNoTarget())
            i += 1
        }
    }
}

pub impl Comp {

    // Pre-resolved final callable for Call / Method / ExtMethod expression `id`.
    // The AST node owns the decision, including a `#` source key; verification,
    // type recovery and codegen therefore cannot drift by looking it up again.
    inout fn resolvedCallee(id: U64) -> U64 {
        if id < self.typeCache.callee.count() {
            if self.typeCache.callee[id] != calleeUnfilled() {
                return self.typeCache.callee[id]
            }
        }
        mut val r: U64 = self.arena.funcs.count()
        match self.arena.exprs[id] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                // A lexical closure binding shadows a same-spelled free
                // function.  It has no static Func identity, so retain the
                // sentinel here; Mono records the closure target in BodyCallee.
                val li: U64 = self.localIndexByName(start: nameStart, len: nameLen)
                if li >= self.cur.locals.count() || !(self.isFnType(ref: self.cur.locals[li].ty)) {
                    r = self.findFunc(nameStart: nameStart, nameLen: nameLen, args: args)
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // A generic body has an abstract requirement surface here. Its
                // concrete witness is intentionally selected by Mono under the
                // instantiated receiver, not cached from whatever conformers
                // happen to be loaded while lowering the template.
                mut val abstractBound: Bool = false
                match self.arena.exprs[recv] {
                    Expr.Ident(start: val rs, len: val rl) => {
                        val li: U64 = self.localIndexByName(start: rs, len: rl)
                        if li < self.cur.locals.count() {
                            val lo: Local = self.cur.locals[li]
                            abstractBound = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: lo.tyStart, len: lo.tyLen)
                        }
                    }
                    _ => {}
                }
                if !abstractBound {
                    r = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
                }
            }
            Expr.ExtMethod(val recv, val source, val nameStart, val nameLen, val args) => {
                val src: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
                r = self.resolveExtMethodFinal(recv: recv, srcStart: src.start, srcLen: src.len, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args)
            }
            _ => {}
        }
        // A free call is lexical and stable immediately. A method's receiver may
        // need the body-local environment, so only verification records its final
        // decision after that environment has been installed.
        match self.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                if id < self.typeCache.callee.count() {
                    self.typeCache.callee.set(i: id, value: r)
                }
            }
            _ => {}
        }
        return r
    }

    inout fn recordResolvedMethodCallee(id: U64, callee: U64) {
        if id < self.typeCache.callee.count() {
            self.typeCache.callee.set(i: id, value: callee)
        }
    }
}

pub impl Comp {

    // The TypeInfo for `id`'s recorded int context (scalarInfo if none) — the fallback
    // `typeOf` uses for a width-less expression whose type came only from context.
    inout fn exprIntCtxTypeInfo(id: U64) -> TypeInfo {
        if id < self.typeCache.intCtx.count() {
            val code: U64 = self.typeCache.intCtx[id]
            if code != 0 {
                val kw: String = intCtxKw(code: code)
                val b: Bind = self.kwSpan(kw: kw, kwLen: kw.bytes().count())
                if b.nameLen != 0 {
                    return <TypeInfo kind=0 nameStart=b.nameStart nameLen=b.nameLen ref=0 />
                }
            }
        }
        return scalarInfo()
    }

    // The result TypeRef of a desugared non-Optional `?.` at `exprId` (a Chain
    // rewrite), or 0 if this node isn't one — the site's PARAMETRIC result
    // (ChainSite.stageRef) grounded under the ACTIVE env, so every generic
    // instance reading the SHARED rewritten tree derives its own grounding (a
    // stored grounded result would freeze the first instance's types into all
    // later instantiations). Lets typeOf / exprTypeRef recover a Chain stage's
    // type without re-deriving it from the rewritten match's internal bindings
    // (needed for a nested `a?.x?.y`).
    inout fn chainResultRef(exprId: U64) -> U64 {
        val site: ChainSite = self.chainSiteFor(exprId: exprId)
        if site.stageRef == 0 {
            return 0
        }
        return self.groundTypeRef(ref: site.stageRef)
    }

    // The type of expression `id` — the typed-AST read path that codegen and the
    // checker use instead of re-deriving with `exprType`. The result is cached
    // PERSISTENTLY (one slot per expr id, allocated by buildExprTyTable, never
    // cleared). The cache is INSTANCE-INDEPENDENT by construction: a slot is written
    // only when no monomorphization env is active (recvInstRef 0 AND typeParams empty
    // — see the fill path below), so it only ever holds a type that is the same for
    // every instantiation. Reads always return the right type: a cached slot is
    // instance-independent; an unfilled slot recomputes fresh under the current env.
    //
    // Why the write is gated rather than unconditional: `exprType`'s env-dependent arms
    // (`self` under recvInstRef, a type-parameter local grounded under typeParams) yield
    // an instance-SPECIFIC type. The backend re-walks the SAME expr ids for every generic
    // instance (emitOneGenMethod swaps cur.typeParams/typeArgs), so writing one instance's
    // grounding into the shared slot would poison a sibling instance's read. Gating the
    // write leaves generic-body slots unfilled — they recompute per instance (perf is
    // secondary), which is exactly what the backend's env-aware exprTypeRef path already
    // does for most generic reads. (intCtx width-less recovery below stays env-independent
    // — it reads the checker-recorded literal context, not the live env.)
    inout fn typeOf(id: U64) -> TypeInfo {
        mut val t: TypeInfo = scalarInfo()
        if id < self.typeCache.kind.count() {
            if self.typeCache.kind[id] == typeUnfilled() {
                t = self.exprType(id: id)
                // Cache the result ONLY in an instance-independent context (no active
                // monomorphization env). Under a live env — `recvInstRef` set (front-end
                // mono), or `cur.typeParams` non-empty during backend generic-instance
                // emission (emitOneGenMethod re-walks the SAME expr ids per instance,
                // swapping typeParams/typeArgs) — exprType grounds type-parameter nodes to
                // THIS instance's concrete types. Writing that into the persistent expr-id
                // slot (shared across every instantiation) would poison reads from a sibling
                // instance. So we return the fresh instance-specific type WITHOUT caching:
                // a generic body's slots stay unfilled and are recomputed per instance (perf
                // is secondary). Non-generic bodies always fill — their env is clear.
                if self.cur.recvInstRef == 0U64 && self.cur.typeParams.count() == 0U64 && self.cur.selfRef == 0U64 && self.cur.itemRef == 0U64 {
                    self.typeCache.kind[id] = t.kind
                    self.typeCache.start[id] = t.nameStart
                    self.typeCache.len[id] = t.nameLen
                    self.typeCache.ref[id] = t.ref
                    self.typeCache.viewId[id] = t.viewExtId
                }
            } else {
                t = <TypeInfo kind=self.typeCache.kind[id] nameStart=self.typeCache.start[id] nameLen=self.typeCache.len[id] ref=self.typeCache.ref[id] viewExtId=self.typeCache.viewId[id] />
            }
        } else {
            t = self.exprType(id: id)
        }
        // width-less recovery: a form whose type came only from context (`0-1` in an
        // `I32` binding, `match{...}+1`) is type-less to the structural recovery but the
        // checker recorded its int context — use it so the op routes through the witness.
        // Read fresh (not cached) since typeCache.intCtx is filled during emission.
        if t.kind == 0 {
            if t.nameLen == 0 {
                val ctx: TypeInfo = self.exprIntCtxTypeInfo(id: id)
                if ctx.nameLen != 0 {
                    return ctx
                }
            }
        }
        return t
    }

    // The structured TypeRef for a recovered TypeInfo, for the typed-IR store: like
    // tyRefOfInfo but RECONSTRUCTING an array's full `Array[E]` form from the kind-3
    // element-name view when the producer carried no ref. tyRefOfInfo itself keeps
    // kind-3 -> 0 (its generic-type-arg callers defer arrays deliberately); the store
    // needs the full form — the struct-idx facet its consumers see. The element name
    // resolves via the registered array-element table (a mangled nested/compound
    // element included) or interns as a plain head name (a type-param element `T`
    // stays parametric and grounds per instance).
    // The `Array[E]` TypeRef for an element ref.
    inout fn arrayRefOfElem(elemRef: U64) -> U64 {
        val ab: Bind = self.kwSpan(kw: "Array", kwLen: 5)
        mut val args: Array[U64] = []
        args.append(elemRef)
        return self.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=args />)
    }

    inout fn typedIrRefOfInfo(ti: TypeInfo) -> U64 {
        if ti.ref == 0U64 && ti.kind == 3 && ti.nameLen > 0U64 {
            mut val er: U64 = self.arrayElemRef(start: ti.nameStart, len: ti.nameLen)
            if er == 0U64 {
                er = self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
            }
            if er != 0U64 {
                return self.arrayRefOfElem(elemRef: er)
            }
        }
        return self.tyRefOfInfo(ti: ti)
    }

    // The grounded TypeRef of expression `id` under the BODY instance env — the typed-IR
    // read口 that replaces the backend's per-form exprTypeRef re-derivation. If the parametric
    // store has this expr's type (recorded during a locals-populated front-end walk), SUBSTITUTE
    // the emitted body's type args into it (groundTypeRef resolves `T`/`Self`/`Item`);
    // an already-grounded / scalar parametric ref grounds to itself. Grounding uses the
    // body-scoped env snapshot (cur.body*) — NOT the ambient cursor, which call
    // resolution transiently points at a CALLEE's env while this expr belongs to the
    // caller. Falls back to the instance-independent typeCache/typeOf projection (a
    // node the record pass could not reach).
    inout fn groundedTypeOf(id: U64) -> U64 {
        // A shared generic body cannot take a field/index result from the
        // AST-global parametric cache: `self.items[i]` in `Set[E]` is stored
        // there as the lexical `E`, while this concrete body may be
        // `Set[String]`.  Derive the term through the selected body receiver
        // first.  This is a semantic type query, not a Mono/backend recovery:
        // every edge below is an explicit child of the TypeRef tree.
        match self.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                if self.cur.hasRecv && self.cur.bodyEnvironment.receiverRef != 0U64 {
                    val selfName: Bind = self.kwSpan(kw: "self", kwLen: 4U64)
                    if spansEqual(c: inout self, aStart: start, aLen: len, bStart: selfName.nameStart, bLen: selfName.nameLen) {
                        return self.cur.bodyEnvironment.receiverRef
                    }
                }
                // A body-local is a resolved semantic binding. Its TypeRef is
                // more precise than the shared AST cache: a `for` binding can
                // carry a concrete witness output such as
                // `(index: U64, value: I64)`, while the generic template at
                // the same expression site only knows `E`. Read the local
                // term first and ground it through this immutable body
                // environment; re-deriving it from TypeInfo loses the selected
                // proof and lets sibling instances contaminate one another.
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    val local: Local = self.cur.locals[localIdx]
                    if local.ty != 0U64 { return self.groundBodyTerm(ref: local.ty) }
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                val baseRef: U64 = self.groundedTypeOf(id: base)
                if baseRef != 0U64 && baseRef < self.arena.types.count() {
                    val fieldRef: U64 = self.fieldTypeRefOfReceiver(receiverRef: baseRef, fieldStart: nameStart, fieldLen: nameLen)
                    if fieldRef != 0U64 { return fieldRef }
                }
            }
            Expr.Index(val base, index: _) => {
                val baseRef: U64 = self.groundedTypeOf(id: base)
                if baseRef != 0U64 && baseRef < self.arena.types.count() {
                    val baseTy: TypeRef = self.arena.types[baseRef]
                    if baseTy.args.count() == 1U64 {
                        if rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Array") || rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Buffer") {
                            return baseTy.args[0]
                        }
                    }
                }
            }
            _ => {}
        }
        mut val pr: U64 = 0
        if id < self.parametricRef.count() {
            pr = self.parametricRef[id]
        }
        // a Chain-desugar MatchExpr has no parametric store entry of its own — its
        // parametric result lives in the ChainSite side list (stageRef); ground it
        // through the same body-env substitution so every consumer of the typed IR
        // (array-element stride, argument homes, ...) sees the stage type, not 0.
        if pr == 0U64 {
            pr = self.chainSiteFor(exprId: id).stageRef
        }
        if pr != 0U64 {
            val savedP: Array[Bind] = self.cur.typeParams
            val savedA: Array[U64] = self.cur.typeArgs
            val savedS: U64 = self.cur.selfRef
            val savedI: U64 = self.cur.itemRef
            val savedR: U64 = self.cur.recvInstRef
            self.cur.typeParams = self.cur.bodyEnvironment.params
            self.cur.typeArgs = self.cur.bodyEnvironment.args
            self.cur.selfRef = self.cur.bodySelfRef
            self.cur.itemRef = self.cur.bodyItemRef
            self.cur.recvInstRef = self.cur.bodyEnvironment.receiverRef
            val g: U64 = self.groundBodyTerm(ref: pr)
            self.cur.typeParams = savedP
            self.cur.typeArgs = savedA
            self.cur.selfRef = savedS
            self.cur.itemRef = savedI
            self.cur.recvInstRef = savedR
            return g
        }
        return self.typedIrRefOfInfo(ti: self.typeOf(id: id))
    }
}

pub impl Comp {

    // Bottom-up type-argument inference for a generic construction whose head was NOT
    // grounded top-down during lowering (`val b = <Box v=1I32 />` — no annotation /
    // return / field context). Runs once before collectGenInsts so a successfully
    // inferred instance is discovered and monomorphized (collectGenInsts scans Make.ty).
    // For each un-grounded generic-struct Make, bind every type parameter from a field
    // whose declared type IS that bare parameter, using the field value's concrete type;
    // if every parameter is pinned consistently, rewrite Make.ty to the grounded instance.
    // Otherwise leave it un-grounded — a top-down context (backend expectedTy) may still
    // ground it, and a genuinely un-inferable construction is reported at construction.
    inout fn inferConstructTypeArgs() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                    if !isEnum {
                        if !(self.isGenericInst(ref: ty)) {
                            val inferred: U64 = self.inferMakeInstance(typeStart: typeStart, typeLen: typeLen, fields: fields)
                            if inferred != 0U64 {
                                self.arena.exprs.set(i: i, value: <Expr.Make typeStart=typeStart typeLen=typeLen variantStart=variantStart variantLen=variantLen isEnum=isEnum ty=inferred fields=fields />)
                            }
                        }
                    }
                }
                _ => {}
            }
            i += 1
        }
    }

    // The synthetic record-struct TypeRef for a context-less record literal
    // (`(a: e, b: f)` lowers to a Make with NO type name): the literal is
    // self-describing — its labels plus its field values' types key the SAME
    // canonical struct an annotated record type lowers to (ensureRecordStruct),
    // so both spellings are one structural type. Returns 0 when any field
    // value's type is not inferable here (an unsuffixed literal keeps its
    // "no type from context" report; array-typed fields are not modeled).
    inout fn inferRecordMakeRef(fields: Array[MakeField]) -> U64 {
        // the empty record `()` is the unit value — self-description degenerates to
        // the zero-field canonical struct `()` (the same struct an annotated
        // `val u: () = ()` lowers to), so a bare bind types without an annotation.
        mut val names: Array[String] = []
        mut val tys: Array[PType] = []
        mut val i: U64 = 0
        while i < fields.count() {
            val mf: MakeField = fields[i]
            val ti: TypeInfo = self.exprType(id: mf.value)
            if ti.kind == 3 || ti.nameLen == 0U64 {
                return 0U64
            }
            mut val fref: U64 = ti.ref
            if fref == 0U64 {
                fref = self.simpleTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
            }
            mut val nb: Array[U8] = []
            mut val k: U64 = 0
            while k < mf.nameLen {
                nb.append(self.arena.bytes[mf.nameStart + k])
                k += 1
            }
            names.append(stringFromBytesUnchecked(nb))
            tys.append(<PType start=ti.nameStart len=ti.nameLen isArray=false ref=fref />)
            i += 1
        }
        val rnm: Bind = self.ensureRecordStruct(fieldNames: names, fieldTys: tys)
        return self.simpleTypeRef(nameStart: rnm.nameStart, nameLen: rnm.nameLen)
    }

    // The grounded TypeRef inferred for a generic-struct construction, or 0 when it can't
    // be inferred: not a generic struct, a parameter no bare field pins, or a field value
    // that is untyped / an array element / conflicts with another field's binding.
    inout fn inferMakeInstance(typeStart: U64, typeLen: U64, fields: Array[MakeField]) -> U64 {
        // generic structs are excluded from structIndexByName, so resolve the template
        // through genericStructIndex (a 0-arg / non-generic head is not our case).
        val sidx: U64 = self.genericStructIndex(nameStart: typeStart, nameLen: typeLen)
        if sidx >= self.arena.structs.count() {
            return 0U64
        }
        val sd: StructDef = self.arena.structs[sidx]
        if sd.typeParams.count() == 0U64 {
            return 0U64
        }
        if sd.fields.count() == 0U64 {
            return 0U64
        }
        mut val args: Array[U64] = []
        mut val pi: U64 = 0
        while pi < sd.typeParams.count() {
            val pName: U64 = sd.typeParams[pi].nameId
            mut val argRef: U64 = 0
            mut val fj: U64 = 0
            while fj < sd.fields.count() {
                val fd: FieldDef = sd.fields[fj]
                // only a field whose declared type IS this bare parameter (`v: T`, not
                // `xs: Array[T]` — nested unification is a follow-on) pins it.
                if !(fd.tyIsArray) {
                    if fd.tyNameId == pName {
                        // an untyped field value (a bare literal) does not pin the parameter —
                        // skip it; another (typed) field must, and this one is grounded to the
                        // inferred type by context downstream (`0..<n` binds T from `n`, then
                        // `0` takes T). A conflict between two TYPED fields fails inference.
                        val cand: U64 = self.makeFieldArgRef(fieldNameId: fd.nameId, fields: fields)
                        if cand != 0U64 {
                            if argRef == 0U64 {
                                argRef = cand
                            } else if !(self.typeRefEq(a: argRef, b: cand)) {
                                return 0U64
                            }
                        }
                    }
                }
                fj += 1
            }
            if argRef == 0U64 {
                return 0U64
            }
            args.append(argRef)
            pi += 1
        }
        return self.pushType(t: <TypeRef nameStart=typeStart nameLen=typeLen args=args />)
    }

    // The TypeRef for the value supplied to the make-field named `fieldNameId`, or 0 when
    // the field is absent, or its value's type is untyped / unknown / an array (which a
    // bare parameter can't take in this increment).
    inout fn makeFieldArgRef(fieldNameId: U64, fields: Array[MakeField]) -> U64 {
        mut val k: U64 = 0
        while k < fields.count() {
            val mf: MakeField = fields[k]
            if intern(c: inout self, start: mf.nameStart, len: mf.nameLen) == fieldNameId {
                val ti: TypeInfo = self.exprType(id: mf.value)
                if ti.kind == 3 {
                    return 0U64
                }
                if ti.nameLen == 0U64 {
                    return 0U64
                }
                // a generic-instance value (`v=<Box v2=1I32/>`): reuse its grounded ref.
                if ti.ref != 0U64 {
                    if self.isGenericInst(ref: ti.ref) {
                        return ti.ref
                    }
                }
                mut val noArgs: Array[U64] = []
                return self.pushType(t: <TypeRef nameStart=ti.nameStart nameLen=ti.nameLen args=noArgs />)
            }
            k += 1
        }
        return 0U64
    }
}
