// Part of name/type resolution (root: _.pw): expression type-cache table
// construction.

import ../../Ir with { SemanticTypeRecipe, CallArgumentSource, CallTemplateArgument, DynamicCallTemplateTarget, StaticMemberResolution }

pub impl Comp {

    // Recipe ids are one-based so Local's default 0 retains the ordinary
    // TypeTerm path.  This graph is semantic provenance, not type identity.
    inout fn pushSemanticTypeRecipe(recipe: SemanticTypeRecipe) -> U64 {
        self.arena.semanticTypeRecipes.append(recipe)
        return self.arena.semanticTypeRecipes.count()
    }

    inout fn semanticTypeRecipeTerm(term: U64) -> U64 {
        return self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=1U64 term=term />)
    }

    // Allocate the typed-AST cache (one slot per expression node), all unfilled.
    // Called once before emission; expr ids are stable by then.
    inout fn buildExprTyTable() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            self.typeCache.kind.append(typeUnfilled())
            self.typeCache.start.append(0)
            self.typeCache.len.append(0)
            self.typeCache.ref.append(0)
            self.typeCache.viewId.append(0)
            self.typeCache.callee.append(calleeUnfilled())
            self.typeCache.identBind.append(identUnfilledCode())
            self.typeCache.identTarget.append(identNoTarget())
            i += 1
        }
    }
}

pub impl Comp {

    // Pre-resolved final callable for Call / Method / ExtMethod expression `id`.
    // The AST node owns the decision, including a `#` source key; verification,
    // type recovery and codegen therefore cannot drift by looking it up again.
    inout fn resolvedCallee(id: U64) -> U64 {
        if id < self.typeCache.callee.count() {
            if self.typeCache.callee[id] != calleeUnfilled() {
                return self.typeCache.callee[id]
            }
        }
        mut val r: U64 = self.arena.funcs.count()
        match self.arena.exprs[id] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                // A lexical closure binding shadows a same-spelled free
                // function.  It has no static Func identity, so retain the
                // sentinel here; Mono records the closure target in CallResolution.
                val li: U64 = self.localIndexByName(start: nameStart, len: nameLen)
                if li >= self.cur.locals.count() || !(self.isFnType(ref: self.cur.locals[li].ty)) {
                    r = self.findFunc(nameStart: nameStart, nameLen: nameLen, args: args)
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                // A generic body has an abstract requirement surface here. Its
                // concrete witness is intentionally selected by Mono under the
                // instantiated receiver, not cached from whatever conformers
                // happen to be loaded while lowering the template.
                mut val abstractBound: Bool = false
                match self.arena.exprs[recv] {
                    Expr.Ident(start: val rs, len: val rl) => {
                        val li: U64 = self.localIndexByName(start: rs, len: rl)
                        if li < self.cur.locals.count() {
                            val lo: Local = self.cur.locals[li]
                            abstractBound = self.isTypeParamOf(fnIdx: self.cur.checkFn, start: lo.tyStart, len: lo.tyLen)
                        }
                    }
                    _ => {}
                }
                if !abstractBound {
                    r = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
                }
            }
            Expr.ExtMethod(val recv, val source, val nameStart, val nameLen, val args) => {
                val src: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
                r = self.resolveExtMethodFinal(recv: recv, srcStart: src.start, srcLen: src.len, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args)
            }
            _ => {}
        }
        // A free call is lexical and stable immediately. A method's receiver may
        // need the body-local environment, so only verification records its final
        // decision after that environment has been installed.
        match self.arena.exprs[id] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                if id < self.typeCache.callee.count() {
                    self.typeCache.callee.set(i: id, value: r)
                }
            }
            _ => {}
        }
        return r
    }

    inout fn recordResolvedMethodCallee(id: U64, callee: U64) {
        if id < self.typeCache.callee.count() {
            self.typeCache.callee.set(i: id, value: callee)
        }
    }
}

pub impl Comp {

    // The TypeInfo for `id`'s recorded int context (scalarInfo if none) — the fallback
    // `typeOf` uses for a width-less expression whose type came only from context.
    inout fn exprIntCtxTypeInfo(id: U64) -> TypeInfo {
        if id < self.arena.semanticExprTypes.count() {
            val code: U64 = self.arena.semanticExprTypes[id].literalContext
            if code != 0 {
                val kw: String = intCtxKw(code: code)
                val b: Bind = self.kwSpan(kw: kw, kwLen: kw.bytes().count())
                if b.nameLen != 0 {
                    return <TypeInfo kind=0 nameStart=b.nameStart nameLen=b.nameLen ref=0 />
                }
            }
        }
        return scalarInfo()
    }

    // The result TypeRef of a desugared non-Optional `?.` at `exprId` (a Chain
    // rewrite), or 0 if this node isn't one — the site's PARAMETRIC result
    // (ChainSite.stageRef) grounded under the ACTIVE env, so every generic
    // instance reading the SHARED rewritten tree derives its own grounding (a
    // stored grounded result would freeze the first instance's types into all
    // later instantiations). Lets typeOf / exprTypeRef recover a Chain stage's
    // type without re-deriving it from the rewritten match's internal bindings
    // (needed for a nested `a?.x?.y`).
    inout fn chainResultRef(exprId: U64) -> U64 {
        val site: ChainSite = self.chainSiteFor(exprId: exprId)
        if site.stageRef == 0 {
            return 0
        }
        return self.groundTypeRef(ref: site.stageRef)
    }

    // The type of expression `id` — the typed-AST read path that codegen and the
    // checker use instead of re-deriving with `exprType`. The result is cached
    // PERSISTENTLY (one slot per expr id, allocated by buildExprTyTable, never
    // cleared). The cache is INSTANCE-INDEPENDENT by construction: a slot is written
    // only when no monomorphization env is active (recvInstRef 0 AND typeParams empty
    // — see the fill path below), so it only ever holds a type that is the same for
    // every instantiation. Reads always return the right type: a cached slot is
    // instance-independent; an unfilled slot recomputes fresh under the current env.
    //
    // Why the write is gated rather than unconditional: `exprType`'s env-dependent arms
    // (`self` under recvInstRef, a type-parameter local grounded under typeParams) yield
    // an instance-SPECIFIC type. The backend re-walks the SAME expr ids for every generic
    // instance (emitOneGenMethod swaps cur.typeParams/typeArgs), so writing one instance's
    // grounding into the shared slot would poison a sibling instance's read. Gating the
    // write leaves generic-body slots unfilled — they recompute per instance (perf is
    // secondary), which is exactly what the backend's env-aware exprTypeRef path already
    // does for most generic reads. (intCtx width-less recovery below stays env-independent
    // — it reads the checker-recorded literal context, not the live env.)
    inout fn typeOf(id: U64) -> TypeInfo {
        mut val t: TypeInfo = scalarInfo()
        if id < self.typeCache.kind.count() {
            if self.typeCache.kind[id] == typeUnfilled() {
                t = self.exprType(id: id)
                // Cache the result ONLY in an instance-independent context (no active
                // monomorphization env). Under a live env — `recvInstRef` set (front-end
                // mono), or `cur.typeParams` non-empty during backend generic-instance
                // emission (emitOneGenMethod re-walks the SAME expr ids per instance,
                // swapping typeParams/typeArgs) — exprType grounds type-parameter nodes to
                // THIS instance's concrete types. Writing that into the persistent expr-id
                // slot (shared across every instantiation) would poison reads from a sibling
                // instance. So we return the fresh instance-specific type WITHOUT caching:
                // a generic body's slots stay unfilled and are recomputed per instance (perf
                // is secondary). Non-generic bodies always fill — their env is clear.
                if self.cur.recvInstRef == 0U64 && self.cur.typeParams.count() == 0U64 && self.cur.selfRef == 0U64 && self.cur.itemRef == 0U64 {
                    self.typeCache.kind[id] = t.kind
                    self.typeCache.start[id] = t.nameStart
                    self.typeCache.len[id] = t.nameLen
                    self.typeCache.ref[id] = t.ref
                    self.typeCache.viewId[id] = t.viewExtId
                }
            } else {
                t = <TypeInfo kind=self.typeCache.kind[id] nameStart=self.typeCache.start[id] nameLen=self.typeCache.len[id] ref=self.typeCache.ref[id] viewExtId=self.typeCache.viewId[id] />
            }
        } else {
            t = self.exprType(id: id)
        }
        // width-less recovery: a form whose type came only from context (`0-1` in an
        // `I32` binding, `match{...}+1`) is type-less to the structural recovery but the
        // checker recorded its int context — use it so the op routes through the witness.
        // Read fresh (not cached) since semantic literal context is filled during checking.
        if t.kind == 0 {
            if t.nameLen == 0 {
                val ctx: TypeInfo = self.exprIntCtxTypeInfo(id: id)
                if ctx.nameLen != 0 {
                    return ctx
                }
            }
        }
        return t
    }

    // The structured TypeRef for a recovered TypeInfo, for the typed-IR store: like
    // tyRefOfInfo but RECONSTRUCTING an array's full `Array[E]` form from the kind-3
    // element-name view when the producer carried no ref. tyRefOfInfo itself keeps
    // kind-3 -> 0 (its generic-type-arg callers defer arrays deliberately); the store
    // needs the full form — the struct-idx facet its consumers see. The element name
    // resolves via the registered array-element table (a mangled nested/compound
    // element included) or interns as a plain head name (a type-param element `T`
    // stays parametric and grounds per instance).
    // The `Array[E]` TypeRef for an element ref.
    inout fn arrayRefOfElem(elemRef: U64) -> U64 {
        val ab: Bind = self.kwSpan(kw: "Array", kwLen: 5)
        mut val args: Array[U64] = []
        args.append(elemRef)
        return self.pushType(t: <TypeRef nameStart=ab.nameStart nameLen=ab.nameLen args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    inout fn typedIrRefOfInfo(ti: TypeInfo) -> U64 {
        if ti.ref == 0U64 && ti.kind == 3 && ti.nameLen > 0U64 {
            mut val er: U64 = self.arrayElemRef(start: ti.nameStart, len: ti.nameLen)
            if er == 0U64 {
                er = self.findOrAddTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
            }
            if er != 0U64 {
                return self.arrayRefOfElem(elemRef: er)
            }
        }
        return self.tyRefOfInfo(ti: ti)
    }

    // The only write/read boundary for expression semantic types.  Legacy
    // TypeInfo is deliberately carried as an adapter payload while its many
    // consumers migrate; TypeTerm, shape and literal context nevertheless
    // share one ExprId-keyed entry rather than parallel caches.
    inout fn semanticExprShape(ti: TypeInfo) -> U64 {
        if ti.ref != 0U64 && ti.ref < self.arena.types.count() {
            val t: TypeRef = self.arena.types[ti.ref]
            if t.isAny { return 6U64 }
            if self.isFnType(ref: ti.ref) { return 5U64 }
        }
        if ti.kind == 3I64 { return 4U64 }
        if ti.kind == 2I64 { return 3U64 }
        if ti.kind == 1I64 { return 2U64 }
        if ti.nameLen != 0U64 { return 1U64 }
        return 0U64
    }

    inout fn ensureSemanticExprType(exprId: U64) {
        while self.arena.semanticExprTypes.count() <= exprId {
            self.arena.semanticExprTypes.append(<SemanticExprType />)
        }
    }

    inout fn semanticExprTerm(exprId: U64) -> U64 {
        if exprId < self.arena.semanticExprTypes.count() {
            val entry: SemanticExprType = self.arena.semanticExprTypes[exprId]
            if entry.term != 0U64 { return entry.term }
            // A checked numeric context is a semantic type constraint, even
            // when Record captured the literal before that context existed.
            // Preserve the unknown legacy shape for literal inference; typed
            // consumers share this projection instead of guessing a width.
            if entry.literalContext != 0U64 {
                return self.typedIrRefOfInfo(ti: self.exprIntCtxTypeInfo(id: exprId))
            }
        }
        return 0U64
    }

    // A source declaration body is the stable owner of a parametric call
    // template.  Globals use the one sentinel immediately after Func indices;
    // Mono normalizes its synthetic global body key to the same value.
    inout fn callTemplateOwner(fnIdx: U64) -> U64 {
        if fnIdx < self.arena.funcs.count() { return fnIdx }
        return self.arena.funcs.count()
    }

    // A provided method is copied once per conformance but deliberately shares
    // the trait declaration's body.  Parametric call templates belong to that
    // one lexical body, not to any selected conformance copy.  Keep this
    // canonicalization at the key boundary so every template producer and
    // consumer agrees without an ambient "current selected method" rule.
    inout fn callTemplateBodyOwner(fnIdx: U64) -> U64 {
        if fnIdx >= self.arena.funcs.count() { return self.callTemplateOwner(fnIdx: fnIdx) }
        val selected: Func = self.arena.funcs[fnIdx]
        if !(selected.isProvided) { return fnIdx }
        mut val i: U64 = 0U64
        while i < self.arena.funcs.count() {
            val candidate: Func = self.arena.funcs[i]
            if !(candidate.isProvided) && candidate.body == selected.body && candidate.nameId == selected.nameId && candidate.provTraitOwner == selected.provTraitOwner {
                return i
            }
            i += 1U64
        }
        // A malformed generated copy without its lexical source is an internal
        // error elsewhere; retain its own identity here rather than aliasing an
        // unrelated body with the same spelling.
        return fnIdx
    }

    // Source calls are identified by the declaration body plus their complete
    // parsed span.  The arena index remains an implementation-navigation aid
    // only; using it as semantic identity made generated/shared bodies alias.
    inout fn sourceCallSiteKey(fnIdx: U64, exprId: U64) -> CallSiteKey {
        val owner: U64 = self.callTemplateOwner(fnIdx: self.callTemplateBodyOwner(fnIdx: fnIdx))
        mut val start: U64 = 0U64
        mut val end: U64 = 0U64
        mut val serial: U64 = 0U64
        if exprId < self.arena.exprSpanStart.count() { start = self.arena.exprSpanStart[exprId] }
        if exprId < self.arena.exprSpanEnd.count() { end = self.arena.exprSpanEnd[exprId] }
        if exprId < self.arena.exprOriginSerial.count() { serial = self.arena.exprOriginSerial[exprId] }
        return <CallSiteKey ownerFnIdx=owner originKind=1U64 originStart=start originEnd=end originSerial=serial />
    }

    // The semantic identity of a call template uses the same origin namespace
    // as the final descriptor.  Lowered calls have no independent source span:
    // treating them as written calls here while Mono reads them as synthetic
    // made one body own two unrelated keys, so a finalized generic body could
    // not find the template that created its call.  `exprId` remains only the
    // navigation anchor for locating the producer-assigned serial.
    inout fn templateCallSiteKey(fnIdx: U64, exprId: U64) -> CallSiteKey {
        val owner: U64 = self.callTemplateOwner(fnIdx: self.callTemplateBodyOwner(fnIdx: fnIdx))
        mut val si: U64 = 0U64
        while si < self.decls.syntheticCallSites.count() {
            val synthetic: SyntheticCallSite = self.decls.syntheticCallSites[si]
            if synthetic.exprId == exprId {
                return <CallSiteKey ownerFnIdx=owner originKind=2U64 originSerial=synthetic.originSerial />
            }
            si += 1U64
        }
        return self.sourceCallSiteKey(fnIdx: fnIdx, exprId: exprId)
    }

    // `for` protocol calls have no Expr node. Their template key must match
    // Mono's statement-site final descriptor key exactly.
    inout fn templateProtocolSiteKey(fnIdx: U64, stmtId: U64, slot: U64) -> CallSiteKey {
        val owner: U64 = self.callTemplateOwner(fnIdx: self.callTemplateBodyOwner(fnIdx: fnIdx))
        mut val start: U64 = 0U64
        mut val end: U64 = 0U64
        if stmtId < self.arena.stmts.count() {
            match self.arena.stmts[stmtId] {
                Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, rangeHi: _, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => {
                    start = self.exprOffset(id: iter)
                    if iter < self.arena.exprSpanEnd.count() { end = self.arena.exprSpanEnd[iter] }
                }
                _ => {}
            }
        }
        return <CallSiteKey ownerFnIdx=owner originKind=3U64 originStart=start originEnd=end originSerial=stmtId + 1U64 slot=slot />
    }

    fn sameCallSiteKey(a: CallSiteKey, b: CallSiteKey) -> Bool {
        return a.ownerFnIdx == b.ownerFnIdx && a.originKind == b.originKind && a.originStart == b.originStart && a.originEnd == b.originEnd && a.originSerial == b.originSerial && a.slot == b.slot
    }

    // A CallTemplate's selection belongs to its lexical source declaration,
    // whereas a final CallResolution belongs to the BodyInstance that happens
    // to evaluate it.  These normally have the same owner.  They deliberately
    // differ for a parameter default: its expression is declared on the callee
    // but evaluated in each caller.  Origin is therefore the stable bridge for
    // that one cross-body execution case; `ownerFnIdx` remains part of the
    // full key used for template storage and final-resolution publication.
    fn sameCallSiteOrigin(a: CallSiteKey, b: CallSiteKey) -> Bool {
        return a.originKind == b.originKind && a.originStart == b.originStart && a.originEnd == b.originEnd && a.originSerial == b.originSerial && a.slot == b.slot
    }

    fn callTemplateHash(siteKey: CallSiteKey) -> U64 {
        // See finalCalleeHash: every intermediate remains below 2^32 because
        // arithmetic overflow is checked in the self-hosted compiler.
        val modulus: U64 = 4294967291U64
        mut val h: U64 = siteKey.ownerFnIdx % modulus
        h = ((h + siteKey.originKind % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originStart % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originEnd % modulus) * 65537U64) % modulus
        h = ((h + siteKey.originSerial % modulus) * 65537U64) % modulus
        h = ((h + siteKey.slot % modulus) * 65537U64) % modulus
        return h
    }

    inout fn rebuildCallTemplateIndex(capacity: U64) {
        self.decls.callTemplateIndexSlots = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.decls.callTemplateIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.decls.callTemplates.count() {
            val siteKey: CallSiteKey = self.decls.callTemplates[entry].siteKey
            mut val slot: U64 = self.callTemplateHash(siteKey: siteKey) % capacity
            while self.decls.callTemplateIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.decls.callTemplateIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureCallTemplateIndex(nextCount: U64) {
        if self.decls.callTemplateIndexSlots.count() == 0U64 {
            self.rebuildCallTemplateIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.decls.callTemplateIndexSlots.count() * 7U64 {
            self.rebuildCallTemplateIndex(capacity: self.decls.callTemplateIndexSlots.count() * 2U64)
        }
    }

    inout fn appendCallTemplate(template: CallTemplate) {
        self.ensureCallTemplateIndex(nextCount: self.decls.callTemplates.count() + 1U64)
        self.decls.callTemplates.append(template)
        val capacity: U64 = self.decls.callTemplateIndexSlots.count()
        mut val slot: U64 = self.callTemplateHash(siteKey: template.siteKey) % capacity
        while self.decls.callTemplateIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.decls.callTemplateIndexSlots.set(i: slot, value: self.decls.callTemplates.count())
    }

    inout fn callTemplateIndex(siteKey: CallSiteKey) -> U64 {
        val capacity: U64 = self.decls.callTemplateIndexSlots.count()
        if capacity == 0U64 { return self.decls.callTemplates.count() }
        mut val slot: U64 = self.callTemplateHash(siteKey: siteKey) % capacity
        while self.decls.callTemplateIndexSlots[slot] != 0U64 {
            val entry: U64 = self.decls.callTemplateIndexSlots[slot] - 1U64
            if self.sameCallSiteKey(a: self.decls.callTemplates[entry].siteKey, b: siteKey) { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.decls.callTemplates.count()
    }

    // Direct calls use the same source algebra as operators. The argument
    // syntax is copied once at Record time; Mono later grounds this immutable
    // template and must not inspect a shared Expr to rediscover labels, inout,
    // or an argument's parametric type.
    inout fn directCallTemplateArgs(args: ArgRange) -> Array[CallTemplateArgument] {
        mut val out: Array[CallTemplateArgument] = []
        mut val i: U64 = 0U64
        while i < args.len {
            val arg: Arg = self.argAt(args: args, index: i)
            out.append(<CallTemplateArgument source=self.callArgumentSource(exprId: arg.expr) isInout=arg.isInout labelStart=arg.labelStart labelLen=arg.labelLen hasLabel=arg.hasLabel />)
            i += 1U64
        }
        return out
    }

    inout fn recordCallTemplate(exprId: U64, callee: U64, receiver: CallTemplateReceiver, args: ArgRange, calleeTypeArgs: Array[U64], proof: StaticConformanceProof = <StaticConformanceProof.Missing />) {
        if !(self.cur.recordCallTemplates) { return }
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val templateArgs: Array[CallTemplateArgument] = self.directCallTemplateArgs(args: args)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.Direct callee=callee receiver=receiver args=templateArgs calleeTypeArgs=calleeTypeArgs proof=proof /> expectedResultTerm=prior.expectedResultTerm />)
            return
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.Direct callee=callee receiver=receiver args=templateArgs calleeTypeArgs=calleeTypeArgs proof=proof /> />)
    }

    // A dynamic call is selected at Record too.  It carries the same receiver
    // and argument provenance as a direct call, while the target remains a
    // symbolic closure type or existential witness until a BodyInstance
    // grounds it.  Mono must never reopen the call expression to rediscover
    // lexical scope, field identity, or requirement overload selection.
    inout fn recordDynamicCallTemplate(exprId: U64, receiver: CallTemplateReceiver, args: ArgRange, target: DynamicCallTemplateTarget) {
        if !(self.cur.recordCallTemplates) { return }
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val templateArgs: Array[CallTemplateArgument] = self.directCallTemplateArgs(args: args)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=prior.siteKey kind=<CallTemplateKind.Dynamic receiver=receiver args=templateArgs target=target /> expectedResultTerm=prior.expectedResultTerm />)
            return
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.Dynamic receiver=receiver args=templateArgs target=target /> />)
    }

    inout fn recordStaticMethodTemplate(exprId: U64, receiver: CallTemplateReceiver, args: ArgRange, resolution: StaticMemberResolution, resultTerm: U64) {
        if !(self.cur.recordCallTemplates) { return }
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val templateArgs: Array[CallTemplateArgument] = self.directCallTemplateArgs(args: args)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=prior.siteKey kind=<CallTemplateKind.StaticMethod receiver=receiver args=templateArgs resolution=resolution resultTerm=resultTerm /> expectedResultTerm=prior.expectedResultTerm />)
            return
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.StaticMethod receiver=receiver args=templateArgs resolution=resolution resultTerm=resultTerm /> />)
    }

    inout fn recordProtocolCallTemplate(stmtId: U64, slot: U64, receiver: CallTemplateReceiver) {
        if !(self.cur.recordCallTemplates) { return }
        val key: CallSiteKey = self.templateProtocolSiteKey(fnIdx: self.cur.checkFn, stmtId: stmtId, slot: slot)
        val index: U64 = self.callTemplateIndex(siteKey: key)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=prior.siteKey kind=<CallTemplateKind.Protocol receiver=receiver /> expectedResultTerm=prior.expectedResultTerm />)
            return
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=key kind=<CallTemplateKind.Protocol receiver=receiver /> />)
    }

    // A written call argument is an explicit semantic source. Calls keep a
    // dependency on their completed descriptor; an untyped literal retains its
    // Record-time adapter rather than inviting Mono to inspect the Expr.
    inout fn callArgumentSource(exprId: U64) -> CallArgumentSource {
        match self.arena.exprs[exprId] {
            Expr.Ident(start: val start, len: val len) => {
                val localIndex: U64 = self.localIndexByName(start: start, len: len)
                if localIndex < self.cur.locals.count() {
                    return <CallArgumentSource.Local exprId=exprId localIndex=localIndex term=self.parametricExprTerm(exprId: exprId) />
                }
            }
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return <CallArgumentSource.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return <CallArgumentSource.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return <CallArgumentSource.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            // Operators publish CallResolution entries too. A surrounding
            // direct call must depend on that finalized result exactly as it
            // depends on a written call: `print(!false)` cannot infer Print's
            // generic argument from the unary Expr's legacy TypeInfo.
            Expr.Unary(op: _, operand: _) => {
                return <CallArgumentSource.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            Expr.Binary(op: val op, lhs: _, rhs: _) => {
                // Logical connectors are control flow, not trait calls. Their
                // Bool term is complete; Mid materializes their short-circuit
                // CFG through the ordinary value source path below.
                if op != opAnd() && op != opOr() {
                    return <CallArgumentSource.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
                }
            }
            _ => {}
        }
        val term: U64 = self.parametricExprTerm(exprId: exprId)
        if term != 0U64 { return <CallArgumentSource.Term exprId=exprId term=term /> }
        // Record's post-order fallback has already captured every remaining
        // context-sensitive shape in SemanticExprType.  Do not reopen the AST
        // here: a missing TypeTerm is specifically the intentional legacy
        // adapter case (notably an unsuffixed integer), not a request for a
        // second declaration-time type recovery.
        return <CallArgumentSource.Legacy exprId=exprId info=self.semanticExprTypeInfo(exprId: exprId) />
    }

    inout fn staticOperatorTemplateResolution(op: I64, receiverTerm: U64, isUnary: Bool) -> StaticMemberResolution {
        if self.cur.checkFn >= self.arena.funcs.count() || receiverTerm == 0U64 { return <StaticMemberResolution.Missing /> }
        if isUnary {
            if op == opSub() || op == opNot() || op == opBitNot() {
                return self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: self.unOpTraitName(op: op), memberName: unaryMethodName(op: op), arity: 1U64)
            }
            return <StaticMemberResolution.Missing />
        }
        if isBinTraitOp(op: op) {
            return self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: self.binOpTraitName(op: op), memberName: binTraitMethodName(op: op), arity: 2U64)
        }
        if op == opEq() || op == opNe() {
            return self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: "Eq", memberName: "eq", arity: 2U64)
        }
        if op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            return self.staticOperatorResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, traitName: "Ord", memberName: "compare", arity: 2U64)
        }
        return <StaticMemberResolution.Missing />
    }

    // Ordering syntax is a projection of the selected Ord requirement, not a
    // direct spelling of `compare`: `a < b` selects `Ord.compare` as its
    // witness but its own value is always Bool.  Keeping that distinction at
    // the CallTemplate boundary prevents downstream body finalization from
    // treating an Ordering return as the source expression's result.
    inout fn staticOperatorTemplateResultTerm(op: I64, resolution: StaticMemberResolution) -> U64 {
        if op == opLt() || op == opLe() || op == opGt() || op == opGe() {
            val boolName: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
            if boolName.nameLen == 0U64 { return 0U64 }
            return self.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen)
        }
        return self.staticRequirementResultType(resolution: resolution)
    }

    inout fn recordOperatorTemplate(exprId: U64, op: I64, operandExprs: Array[U64], isUnary: Bool) {
        if !isUnary && (op == opAnd() || op == opOr()) { return }
        mut val operands: Array[CallArgumentSource] = []
        mut val i: U64 = 0U64
        while i < operandExprs.count() {
            operands.append(self.callArgumentSource(exprId: operandExprs[i]))
            i += 1U64
        }
        mut val receiverTerm: U64 = 0U64
        if operandExprs.count() > 0U64 { receiverTerm = self.parametricExprTerm(exprId: operandExprs[0]) }
        val resolution: StaticMemberResolution = self.staticOperatorTemplateResolution(op: op, receiverTerm: receiverTerm, isUnary: isUnary)
        val staticResult: U64 = self.staticOperatorTemplateResultTerm(op: op, resolution: resolution)
        if staticResult != 0U64 { self.recordSemanticExprTerm(exprId: exprId, term: staticResult) }
        if !(self.cur.recordCallTemplates) { return }
        val resultTerm: U64 = self.parametricExprTerm(exprId: exprId)
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() {
            val prior: CallTemplate = self.decls.callTemplates[index]
            self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=prior.siteKey kind=<CallTemplateKind.Operator op=op operands=operands resolution=resolution resultTerm=resultTerm /> expectedResultTerm=prior.expectedResultTerm />)
            return
        }
        self.appendCallTemplate(template: <CallTemplate siteKey=siteKey kind=<CallTemplateKind.Operator op=op operands=operands resolution=resolution resultTerm=resultTerm /> />)
    }

    inout fn recordCallTemplateExpectedResult(exprId: U64, expectedTerm: U64) {
        if !(self.cur.recordCallTemplates) { return }
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        // Context can be known before declaration-time call selection. This
        // is normal for a type-qualified generic associated factory in a
        // shared body: its concrete receiver is not selected until Mono, but
        // its source expected result is already a complete template input.
        if index >= self.decls.callTemplates.count() {
            self.appendCallTemplate(template: <CallTemplate siteKey=siteKey expectedResultTerm=expectedTerm />)
            return
        }
        val prior: CallTemplate = self.decls.callTemplates[index]
        self.decls.callTemplates.set(i: index, value: <CallTemplate siteKey=prior.siteKey kind=prior.kind expectedResultTerm=expectedTerm />)
    }

    inout fn callTemplateForCurrentBody(exprId: U64) -> CallTemplate {
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.bodyFnIdx, exprId: exprId)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() { return self.decls.callTemplates[index] }
        // See sameCallSiteOrigin: a callee-owned default expression is
        // materialized under its caller BodyInstance.  Reusing its immutable
        // declaration-time template is not a second lookup; it is the one
        // lexical selection identified by the source origin.  Source spans
        // plus parser origin serial make the fallback unique.  If it is not
        // unique, retain the missing sentinel and fail closed at the consumer.
        mut val found: U64 = self.decls.callTemplates.count()
        mut val i: U64 = 0U64
        while i < self.decls.callTemplates.count() {
            val candidate: CallTemplate = self.decls.callTemplates[i]
            if self.sameCallSiteOrigin(a: candidate.siteKey, b: siteKey) {
                if found < self.decls.callTemplates.count() { return <CallTemplate siteKey=siteKey /> }
                found = i
            }
            i += 1U64
        }
        if found < self.decls.callTemplates.count() { return self.decls.callTemplates[found] }
        return <CallTemplate siteKey=siteKey />
    }

    // Read the immutable Record result for one lexical source body without
    // installing a BodyInstance/Cursor. Mid's parametric builder uses this
    // exact-key query; it must not pretend to be the current Mono body or
    // recover a call from Expr spelling. Default-expression origin fallback is
    // deliberately excluded here: it belongs to the materializing caller,
    // whereas a parametric source body owns only its own recorded templates.
    inout fn callTemplateForSourceBody(fnIdx: U64, exprId: U64) -> CallTemplate {
        val siteKey: CallSiteKey = self.templateCallSiteKey(fnIdx: fnIdx, exprId: exprId)
        val index: U64 = self.callTemplateIndex(siteKey: siteKey)
        if index < self.decls.callTemplates.count() { return self.decls.callTemplates[index] }
        return <CallTemplate siteKey=siteKey />
    }

    // The declaration-time semantic term of an expression. Most expressions
    // are supplied by Record; an identifier's lexical Local is equally a
    // first-class producer, and remains available while a legacy TypeInfo
    // adapter is unable to represent a symbolic generic instance. This is one
    // central read boundary, not an OptChain-specific recovery.
    inout fn parametricExprTerm(exprId: U64) -> U64 {
        val recorded: U64 = self.semanticExprTerm(exprId: exprId)
        if recorded != 0U64 { return recorded }
        // A Chain desugar replaces an OptChain node with MatchExpr after the
        // ordinary expression record pass.  Its parametric result is therefore
        // owned by ChainSite rather than the AST-global expression entry.  This
        // belongs in the central semantic-term reader: an outer `?.` must be
        // able to use an already-rewritten inner `?.` as its receiver without
        // re-deriving the MatchExpr or falling back to a concrete instance.
        val chain: ChainSite = self.chainSiteFor(exprId: exprId)
        if chain.stageRef != 0U64 { return chain.stageRef }
        match self.arena.exprs[exprId] {
            Expr.Ident(val start, val len) => {
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    return self.cur.locals[localIdx].ty
                }
            }
            _ => {}
        }
        return 0U64
    }

    inout fn semanticExprTypeInfo(exprId: U64) -> TypeInfo {
        if exprId < self.arena.semanticExprTypes.count() {
            val e: SemanticExprType = self.arena.semanticExprTypes[exprId]
            return <TypeInfo kind=e.legacyKind nameStart=e.legacyNameStart nameLen=e.legacyNameLen ref=e.legacyRef viewExtId=e.legacyViewExtId />
        }
        return scalarInfo()
    }

    // Read a recorded expression type under an explicit body environment. An
    // unknown scalar intentionally keeps its recorded adapter: reconstructing
    // it from a term would prematurely choose a concrete numeric type. Every
    // other recorded shape derives its legacy projection from the grounded
    // term, so `T`/views/projections cannot leak across sibling instances.
    inout fn groundSemanticExprTypeInfo(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> TypeInfo {
        val entry: TypeInfo = self.semanticExprTypeInfo(exprId: exprId)
        if exprId >= self.arena.semanticExprTypes.count() { return entry }
        val e: SemanticExprType = self.arena.semanticExprTypes[exprId]
        if e.shape == 0U64 || e.term == 0U64 { return entry }
        val grounded: U64 = self.groundTermForBody(ref: e.term, environment: environment, selfRef: selfRef, itemRef: itemRef)
        if grounded != 0U64 && grounded < self.arena.types.count() {
            return self.typeInfoOfRef(ref: grounded)
        }
        return entry
    }

    // The TypeRef counterpart of groundSemanticExprTypeInfo.  It is the sole
    // read of an ExprId-owned semantic term under an explicit environment;
    // structural expressions such as field/index selection compose this query
    // instead of reopening typeOf.  A Chain rewrite owns its result in
    // ChainSite until it can be recorded in the ordinary slot.
    inout fn groundSemanticExprTypeRef(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> U64 {
        mut val term: U64 = self.semanticExprTerm(exprId: exprId)
        if term == 0U64 {
            term = self.chainSiteFor(exprId: exprId).stageRef
        }
        if term == 0U64 { return 0U64 }
        return self.groundTermForBody(ref: term, environment: environment, selfRef: selfRef, itemRef: itemRef)
    }


    inout fn recordSemanticExprInfo(exprId: U64, ti: TypeInfo) {
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        val term: U64 = self.typedIrRefOfInfo(ti: ti)
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType term=term shape=self.semanticExprShape(ti: ti) legacyKind=ti.kind legacyNameStart=ti.nameStart legacyNameLen=ti.nameLen legacyRef=ti.ref legacyViewExtId=ti.viewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex />)
    }

    // A context or synthetic lowering can refine an already-recorded type term.
    // Derive its legacy shape from the term at this single boundary instead of
    // leaving array/chain/operator-specific caches behind.
    inout fn recordSemanticExprTerm(exprId: U64, term: U64) {
        if term == 0U64 || term >= self.arena.types.count() { return }
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        val ti: TypeInfo = self.typeInfoOfRef(ref: term)
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType term=term shape=self.semanticExprShape(ti: ti) legacyKind=ti.kind legacyNameStart=ti.nameStart legacyNameLen=ti.nameLen legacyRef=ti.ref legacyViewExtId=ti.viewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex />)
    }

    inout fn recordSemanticExprLiteralContext(exprId: U64, context: U64) {
        if context == 0U64 { return }
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType term=prior.term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=context hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex />)
    }

    // The frontend resolves a field name once, while the receiver's complete
    // TypeTerm still identifies its nominal layout.  Mid uses this selected
    // slot together with the expression's recorded result term; it never
    // re-runs a spelling-to-field lookup during code generation.
    inout fn recordSemanticExprFieldProjection(exprId: U64, index: U64) {
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        self.arena.semanticExprTypes.set(i: exprId, value: <SemanticExprType term=prior.term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext hasFieldProjection=true fieldProjectionIndex=index />)
    }

    // Record selection evidence independently from the expression result
    // TypeTerm.  A later body-instance ground reads the term for type equality
    // and the provenance for CallResolution; neither reader needs AST recovery.
    inout fn recordSemanticExprCall(exprId: U64, callee: U64, receiver: CallTemplateReceiver, args: ArgRange, calleeTypeArgs: Array[U64], resultTerm: U64, proof: StaticConformanceProof = <StaticConformanceProof.Missing />) {
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        mut val next: SemanticExprType = <SemanticExprType term=prior.term shape=prior.shape legacyKind=prior.legacyKind legacyNameStart=prior.legacyNameStart legacyNameLen=prior.legacyNameLen legacyRef=prior.legacyRef legacyViewExtId=prior.legacyViewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex />
        if resultTerm != 0U64 && resultTerm < self.arena.types.count() {
            val ti: TypeInfo = self.typeInfoOfRef(ref: resultTerm)
            next = <SemanticExprType term=resultTerm shape=self.semanticExprShape(ti: ti) legacyKind=ti.kind legacyNameStart=ti.nameStart legacyNameLen=ti.nameLen legacyRef=ti.ref legacyViewExtId=ti.viewExtId literalContext=prior.literalContext hasFieldProjection=prior.hasFieldProjection fieldProjectionIndex=prior.fieldProjectionIndex />
        }
        self.arena.semanticExprTypes.set(i: exprId, value: next)
        // Every Direct producer (including one whose callee was cached by
        // verification) crosses this single semantic boundary.  If the
        // selected declaration is a provided copy, attach its static proof
        // here from the already-recorded receiver term; Mono must never infer
        // it from syntax again.
        mut val selectedProof: StaticConformanceProof = proof
        if self.proofIsMissing(proof: selectedProof) && callee < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[callee]
            if f.isProvided {
                match receiver {
                    CallTemplateReceiver.Term(term: val receiverTerm) => {
                        val resolution: StaticMemberResolution = self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: f.nameStart, nameLen: f.nameLen, args: args)
                        match resolution {
                            StaticMemberResolution.Requirement(proof: val resolved, traitIdx: _, reqIdx: _) => { selectedProof = resolved }
                            StaticMemberResolution.Provided(proof: val resolved, traitIdx: _, callee: _) => { selectedProof = resolved }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
        }
        self.recordCallTemplate(exprId: exprId, callee: callee, receiver: receiver, args: args, calleeTypeArgs: calleeTypeArgs, proof: selectedProof)
    }

    // Record the expected result at a semantic statement boundary.  It is not
    // a replacement expression type: an uninstantiated generic call still
    // owns its callee return TypeTerm.  Keeping the two facts distinct lets a
    // later BodyInstance infer a callee binder from the caller's binder
    // without reopening the AST or reading Mono's ambient scan state.
    inout fn recordSemanticExprExpectedResult(exprId: U64, expectedTerm: U64) {
        if expectedTerm == 0U64 || expectedTerm >= self.arena.types.count() { return }
        self.ensureSemanticExprType(exprId: exprId)
        val prior: SemanticExprType = self.arena.semanticExprTypes[exprId]
        self.recordCallTemplateExpectedResult(exprId: exprId, expectedTerm: expectedTerm)
        // Array construction is a bidirectional value form: at its explicit
        // expected-result boundary the Array[E] term is the semantic result,
        // not merely a hint for an empty literal. Record also refreshes its
        // aggregate carrier, so Mid consumes the same selected E and never
        // reconstructs it from an element literal or method receiver query.
        match self.arena.exprs[exprId] {
            Expr.Array(elems: _) => {
                self.recordSemanticExprTerm(exprId: exprId, term: expectedTerm)
                self.recordSemanticAggregate(exprId: exprId)
            }
            _ => {}
        }
        // Bidirectional literal typing belongs to Record, not to Mono.  An
        // arithmetic subtree made solely of contextless literals has no
        // operand TypeTerm until its enclosing annotation supplies one (for
        // example `val x: F64 = 1 + 2 * 3`).  Propagate only through such
        // untyped arithmetic: an ordinary trait operation may have an
        // independent associated Output, and comparisons produce Bool, so
        // neither admits this equality propagation.
        match self.arena.exprs[exprId] {
            Expr.Unary(val op, val operand) => {
                if (op == opSub() || op == opBitNot()) && self.parametricExprTerm(exprId: operand) == 0U64 {
                    self.recordSemanticExprExpectedResult(exprId: operand, expectedTerm: expectedTerm)
                }
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                if isBinTraitOp(op: op) && self.parametricExprTerm(exprId: lhs) == 0U64 && self.parametricExprTerm(exprId: rhs) == 0U64 {
                    self.recordSemanticExprExpectedResult(exprId: lhs, expectedTerm: expectedTerm)
                    self.recordSemanticExprExpectedResult(exprId: rhs, expectedTerm: expectedTerm)
                }
            }
            _ => {}
        }
    }

    // The explicit body-context read for the expected-result side of a call
    // template.  Zero means the source supplied no bidirectional context.
    inout fn groundSemanticCallExpectedResult(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> U64 {
        val expected: U64 = self.callTemplateForCurrentBody(exprId: exprId).expectedResultTerm
        if expected == 0U64 { return 0U64 }
        return self.groundTermForBody(ref: expected, environment: environment, selfRef: selfRef, itemRef: itemRef)
    }

    // Ground the selected callee substitutions recorded beside an expression's
    // TypeTerm.  This is the direct producer→consumer handoff for generic free
    // calls; Mono must not re-infer a body-local `self` from AST/TypeInfo when
    // the parametric template already selected it.
    inout fn groundSemanticCallTypeArgs(exprId: U64, environment: InstanceEnvironment, selfRef: U64, itemRef: U64) -> Array[U64] {
        mut val out: Array[U64] = []
        mut val args: Array[U64] = []
        match self.callTemplateForCurrentBody(exprId: exprId).kind {
            CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: val stored, proof: _) => { args = stored }
            _ => {}
        }
        mut val i: U64 = 0U64
        while i < args.count() {
            out.append(self.groundTermForBody(ref: args[i], environment: environment, selfRef: selfRef, itemRef: itemRef))
            i += 1U64
        }
        return out
    }

    // The grounded TypeRef of expression `id` under the BODY instance env — the typed-IR
    // read口 that replaces the backend's per-form exprTypeRef re-derivation. If the parametric
    // store has this expr's type (recorded during a locals-populated front-end walk), SUBSTITUTE
    // the emitted body's type args into it (groundTypeRef resolves `T`/`Self`/`Item`);
    // an already-grounded / scalar parametric ref grounds to itself. Grounding uses the
    // body-scoped env snapshot (cur.body*) — NOT the ambient cursor, which call
    // resolution transiently points at a CALLEE's env while this expr belongs to the
    // caller. Falls back to the instance-independent typeCache/typeOf projection (a
    // node the record pass could not reach).
    inout fn groundedTypeOf(id: U64) -> U64 {
        // A shared generic body cannot take a field/index result from the
        // AST-global parametric cache: `self.items[i]` in `Set[E]` is stored
        // there as the lexical `E`, while this concrete body may be
        // `Set[String]`.  Derive the term through the selected body receiver
        // first.  This is a semantic type query, not a Mono/backend recovery:
        // every edge below is an explicit child of the TypeRef tree.
        match self.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                if self.cur.hasRecv && self.cur.bodyEnvironment.receiverRef != 0U64 {
                    val selfName: Bind = self.kwSpan(kw: "self", kwLen: 4U64)
                    if spansEqual(c: inout self, aStart: start, aLen: len, bStart: selfName.nameStart, bLen: selfName.nameLen) {
                        return self.cur.bodyEnvironment.receiverRef
                    }
                }
                // A body-local is a resolved semantic binding. Its TypeRef is
                // more precise than the shared AST cache: a `for` binding can
                // carry a concrete witness output such as
                // `(index: U64, value: I64)`, while the generic template at
                // the same expression site only knows `E`. Read the local
                // term first and ground it through this immutable body
                // environment; re-deriving it from TypeInfo loses the selected
                // proof and lets sibling instances contaminate one another.
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    val local: Local = self.cur.locals[localIdx]
                    if local.ty != 0U64 { return self.groundBodyTerm(ref: local.ty) }
                }
            }
            // Field selection consumes the concrete receiver term.  In
            // particular, a direct `box#E.duplicate().first` must use the
            // nested call's completed CallResolution result, not re-open the
            // shared declaration template `(first: T, ...)`.  Probe the
            // descriptor only when the receiver is call syntax; calling the
            // full body-local receiver recovery for every ordinary field
            // turns declaration-time record walks into an O(body) hot path.
            // If Mono has not selected the nested call yet, preserve the
            // existing parametric query unchanged.
            Expr.Field(val base, val nameStart, val nameLen) => {
                mut val baseRef: U64 = 0U64
                match self.arena.exprs[base] {
                    Expr.Call(nameStart: _, nameLen: _, args: _) => { baseRef = self.bodyCalleeResultRef(exprId: base) }
                    Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { baseRef = self.bodyCalleeResultRef(exprId: base) }
                    Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => { baseRef = self.bodyCalleeResultRef(exprId: base) }
                    _ => {}
                }
                if baseRef == 0U64 { baseRef = self.groundedTypeOf(id: base) }
                if baseRef != 0U64 && baseRef < self.arena.types.count() {
                    val fieldRef: U64 = self.fieldTypeRefOfReceiver(receiverRef: baseRef, fieldStart: nameStart, fieldLen: nameLen)
                    if fieldRef != 0U64 { return fieldRef }
                }
            }
            Expr.Index(val base, index: _) => {
                val baseRef: U64 = self.groundedTypeOf(id: base)
                if baseRef != 0U64 && baseRef < self.arena.types.count() {
                    val baseTy: TypeRef = self.arena.types[baseRef]
                    if baseTy.args.count() == 1U64 {
                        if rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Array") || rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Buffer") {
                            return baseTy.args[0]
                        }
                    }
                }
            }
            _ => {}
        }
        val recorded: U64 = self.groundSemanticExprTypeRef(exprId: id, environment: self.cur.bodyEnvironment, selfRef: self.cur.bodySelfRef, itemRef: self.cur.bodyItemRef)
        if recorded != 0U64 { return recorded }
        return self.typedIrRefOfInfo(ti: self.typeOf(id: id))
    }
}

pub impl Comp {

    // Bottom-up type-argument inference for a generic construction whose head was NOT
    // grounded top-down during lowering (`val b = <Box v=1I32 />` — no annotation /
    // return / field context). Runs once before collectGenInsts so a successfully
    // inferred instance is discovered and monomorphized (collectGenInsts scans Make.ty).
    // For each un-grounded generic-struct Make, bind every type parameter from a field
    // whose declared type IS that bare parameter, using the field value's concrete type;
    // if every parameter is pinned consistently, rewrite Make.ty to the grounded instance.
    // Otherwise leave it un-grounded — a top-down context (backend expectedTy) may still
    // ground it, and a genuinely un-inferable construction is reported at construction.
    inout fn inferConstructTypeArgs() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                    if !isEnum {
                        if !(self.isGenericInst(ref: ty)) {
                            val inferred: U64 = self.inferMakeInstance(typeStart: typeStart, typeLen: typeLen, fields: fields)
                            if inferred != 0U64 {
                                self.arena.exprs.set(i: i, value: <Expr.Make typeStart=typeStart typeLen=typeLen variantStart=variantStart variantLen=variantLen isEnum=isEnum ty=inferred fields=fields />)
                            }
                        }
                    }
                }
                _ => {}
            }
            i += 1
        }
    }

    // The synthetic record-struct TypeRef for a context-less record literal
    // (`(a: e, b: f)` lowers to a Make with NO type name): the literal is
    // self-describing — its labels plus its field values' types key the SAME
    // canonical struct an annotated record type lowers to (ensureRecordStruct),
    // so both spellings are one structural type. Returns 0 when any field
    // value's type is not inferable here (an unsuffixed literal keeps its
    // "no type from context" report; array-typed fields are not modeled).
    inout fn inferRecordMakeRef(fields: MakeFieldRange) -> U64 {
        // the empty record `()` is the unit value — self-description degenerates to
        // the zero-field canonical struct `()` (the same struct an annotated
        // `val u: () = ()` lowers to), so a bare bind types without an annotation.
        mut val names: Array[String] = []
        mut val tys: Array[PType] = []
        mut val terms: Array[U64] = []
        mut val i: U64 = 0
        while i < fields.len {
            val mf: MakeField = self.makeFieldAt(fields: fields, index: i)
            val ti: TypeInfo = self.exprType(id: mf.value)
            if ti.kind == 3 || ti.nameLen == 0U64 {
                return 0U64
            }
            mut val fref: U64 = ti.ref
            if fref == 0U64 {
                fref = self.simpleTypeRef(nameStart: ti.nameStart, nameLen: ti.nameLen)
            }
            mut val nb: Array[U8] = []
            mut val k: U64 = 0
            while k < mf.nameLen {
                nb.append(self.arena.bytes[mf.nameStart + k])
                k += 1
            }
            names.append(stringFromBytesUnchecked(nb))
            tys.append(<PType start=ti.nameStart len=ti.nameLen isArray=false ref=fref />)
            terms.append(fref)
            i += 1
        }
        val rnm: Bind = self.ensureRecordStruct(fieldNames: names, fieldTys: tys)
        return self.recordTypeTerm(name: rnm, fieldNames: names, fieldTerms: terms)
    }

    // The grounded TypeRef inferred for a generic-struct construction, or 0 when it can't
    // be inferred: not a generic struct, a parameter no bare field pins, or a field value
    // that is untyped / an array element / conflicts with another field's binding.
    inout fn inferMakeInstance(typeStart: U64, typeLen: U64, fields: MakeFieldRange) -> U64 {
        // generic structs are excluded from structIndexByName, so resolve the template
        // through genericStructIndex (a 0-arg / non-generic head is not our case).
        val sidx: U64 = self.genericStructIndex(nameStart: typeStart, nameLen: typeLen)
        if sidx >= self.arena.structs.count() {
            return 0U64
        }
        val sd: StructDef = self.arena.structs[sidx]
        if sd.typeParams.count() == 0U64 {
            return 0U64
        }
        if sd.fields.count() == 0U64 {
            return 0U64
        }
        mut val args: Array[U64] = []
        mut val pi: U64 = 0
        while pi < sd.typeParams.count() {
            val pName: U64 = sd.typeParams[pi].nameId
            mut val argRef: U64 = 0
            mut val fj: U64 = 0
            while fj < sd.fields.count() {
                val fd: FieldDef = sd.fields[fj]
                // only a field whose declared type IS this bare parameter (`v: T`, not
                // `xs: Array[T]` — nested unification is a follow-on) pins it.
                if !(fd.tyIsArray) {
                    if fd.tyNameId == pName {
                        // an untyped field value (a bare literal) does not pin the parameter —
                        // skip it; another (typed) field must, and this one is grounded to the
                        // inferred type by context downstream (`0..<n` binds T from `n`, then
                        // `0` takes T). A conflict between two TYPED fields fails inference.
                        val cand: U64 = self.makeFieldArgRef(fieldNameId: fd.nameId, fields: fields)
                        if cand != 0U64 {
                            if argRef == 0U64 {
                                argRef = cand
                            } else if !(self.typeRefEq(a: argRef, b: cand)) {
                                return 0U64
                            }
                        }
                    }
                }
                fj += 1
            }
            if argRef == 0U64 {
                return 0U64
            }
            args.append(argRef)
            pi += 1
        }
        return self.pushType(t: <TypeRef nameStart=typeStart nameLen=typeLen args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    }

    // The TypeRef for the value supplied to the make-field named `fieldNameId`, or 0 when
    // the field is absent, or its value's type is untyped / unknown / an array (which a
    // bare parameter can't take in this increment).
    inout fn makeFieldArgRef(fieldNameId: U64, fields: MakeFieldRange) -> U64 {
        mut val k: U64 = 0
        while k < fields.len {
            val mf: MakeField = self.makeFieldAt(fields: fields, index: k)
            if intern(c: inout self, start: mf.nameStart, len: mf.nameLen) == fieldNameId {
                val ti: TypeInfo = self.exprType(id: mf.value)
                if ti.kind == 3 {
                    return 0U64
                }
                if ti.nameLen == 0U64 {
                    return 0U64
                }
                // a generic-instance value (`v=<Box v2=1I32/>`): reuse its grounded ref.
                if ti.ref != 0U64 {
                    if self.isGenericInst(ref: ti.ref) {
                        return ti.ref
                    }
                }
                mut val noArgs: Array[U64] = []
                return self.pushType(t: <TypeRef nameStart=ti.nameStart nameLen=ti.nameLen args=noArgs isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
            }
            k += 1
        }
        return 0U64
    }
}
