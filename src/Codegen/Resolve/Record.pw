                try self.recordValueBlock(exprId: exprId, blockId: thenBlk, expectedTerm: normalizedContext)
                try self.recordValueBlock(exprId: exprId, blockId: elseBlk, expectedTerm: normalizedContext)
            }
            Expr.OptChain(val base, val cont) => {
                // This form rewrites itself to MatchExpr below. Preserve its
                // pre-rewrite legacy adapter before changing the AST node;
                // other forms use the common post-order fallback.
                if exprId < self.arena.semanticExprTypes.count() {
