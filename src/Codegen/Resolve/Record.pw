                try self.recordParametricMethodCall(exprId: exprId, callee: methodCallee, receiverSource: receiverSource, receiverTerm: receiverTerm, args: args)
                if self.traceCodegen {
                    eprint(text: "[trace-codegen] viewed-call expr=")
                    eprintU64(n: exprId)
                    eprint(text: " callee=")
                    eprintU64(n: methodCallee)
                    eprint(text: " receiver=")
                    self.traceMonoTypeHead(ref: receiverTerm)
                    eprint(text: " result=")
                    self.traceMonoTypeHead(ref: self.parametricExprTerm(exprId: exprId))
                    eprint(text: "\n")
                }
