                }
                try self.recordSemanticAggregate(exprId: exprId)
            }
            Expr.Array(val elems) => {
                mut val elementContext = 0U64
                if normalizedContext != 0U64 && normalizedContext < self.arena.typeCount() {
                    val context = self.arena.typeAt(index: normalizedContext)
                    if context.args.count() == 1U64 && self.typeInfoOfRef(ref: normalizedContext).kind == 3I64 { elementContext = context.args[0U64] }
                }
