// Lexical semantic recording owns parametric expression facts and the
// checks that require local or pattern bindings. Consumers ground these
// facts under a BodyInstance; they do not repeat lexical type inference.

use ../../Ir only { SemanticTry, InstanceEnvironment, MatchSource, SemanticMatchKind, SemanticMatch, SemanticMatchArm, SemanticMatchPayload }

pub impl Comp {
    inout fn requireConstructionContext(ctxRef: U64, offset: U64) -> Result[U64, CompileDiagnostic] {
        if ctxRef == 0U64 || ctxRef >= self.arena.typeCount() {
            return <Result.Err error=self.diagnosticAt(offset: offset, msg: "a construction with an omitted type requires a unique expected type") />
        }
        return <Result.Ok value=ctxRef />
    }

    inout fn synthEmptyDict(ctxRef: U64) -> Result[U64, CompileDiagnostic] {
        val ct: TypeRef = self.arena.typeAt(index: ctxRef)
        val kN: Bind = self.internBytes(s: "keys")
        val vN: Bind = self.internBytes(s: "vals")
        val hN: Bind = self.internBytes(s: "hashes")
        val bN: Bind = self.internBytes(s: "buckets")
        val cN: Bind = self.internBytes(s: "entryCount")
        val emptyKeys: U64 = (try self.synthBufferNew(elemRef: ct.args[0]))
        val emptyVals: U64 = (try self.synthBufferNew(elemRef: ct.args[1]))
        val u64N: Bind = self.internBytes(s: "U64")
        val u64Ref: U64 = self.simpleTypeRef(nameStart: u64N.nameStart, nameLen: u64N.nameLen)
        val emptyHashes: U64 = (try self.synthBufferNew(elemRef: u64Ref))
        val emptyBuckets: U64 = (try self.synthBufferNew(elemRef: u64Ref))
        val zero: U64 = self.pushExpr(e: <Expr.Int value=0 offset=0 isBool=false tyStart=u64N.nameStart tyLen=u64N.nameLen isNeg=false />)
        mut val fields: Array[MakeField] = []
        // Dict storage fields are generated by lowering, not written by the caller.
        // Their explicit provenance grants construction access; offsets only diagnose.
        fields.append(<MakeField nameStart=kN.nameStart nameLen=kN.nameLen value=emptyKeys offset=kN.nameStart origin=<MakeFieldOrigin.Synthesized /> />)
        fields.append(<MakeField nameStart=vN.nameStart nameLen=vN.nameLen value=emptyVals offset=vN.nameStart origin=<MakeFieldOrigin.Synthesized /> />)
        fields.append(<MakeField nameStart=hN.nameStart nameLen=hN.nameLen value=emptyHashes offset=hN.nameStart origin=<MakeFieldOrigin.Synthesized /> />)
        fields.append(<MakeField nameStart=bN.nameStart nameLen=bN.nameLen value=emptyBuckets offset=bN.nameStart origin=<MakeFieldOrigin.Synthesized /> />)
        fields.append(<MakeField nameStart=cN.nameStart nameLen=cN.nameLen value=zero offset=cN.nameStart origin=<MakeFieldOrigin.Synthesized /> />)
        return <Result.Ok value=self.pushExpr(e: <Expr.Make typeStart=ct.nameStart typeLen=ct.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=self.pushMakeFields(fields: fields) />) />
    }


    inout fn hasDictionaryLiteralContext(ctxRef: U64) -> Bool {
        if ctxRef != 0U64 {
            if ctxRef < self.arena.typeCount() {
                val ct: TypeRef = self.arena.typeAt(index: ctxRef)
                if rangeEquals(bytes: self.arena.bytes, start: ct.nameStart, len: ct.nameLen, kw: "Dictionary") {
                    if ct.args.count() >= 2U64 {
                        return true
                    }
                }
            }
        }
        return false
    }

    // The shared semantic construction for an already-lowered dictionary entry
    // sequence.  Value-AST and SyntaxFile decoders differ only in how they
    // produce these expression IDs; the dictionary desugar itself is singular.
    inout fn elaborateDictionaryValues(keys: Array[U64], vals: Array[U64], ctxRef: U64, span: Span) -> Result[U64, CompileDiagnostic] {
        val ct: TypeRef = self.arena.typeAt(index: ctxRef)
        val dlN: Bind = self.internTmpName(prefix: "$dictionary", n: self.arena.exprs.count())
        mut val stmts: Array[U64] = []
        val initMake: U64 = (try self.synthEmptyDict(ctxRef: ctxRef))
        stmts.append(self.pushStmt(s: <Stmt.Let mutable=true nameStart=dlN.nameStart nameLen=dlN.nameLen tyStart=ct.nameStart tyLen=ct.nameLen tyIsArray=false ty=ctxRef init=initMake />))
        val insN: Bind = self.internBytes(s: "insert")
        val keyL: Bind = self.internBytes(s: "key")
        val valL: Bind = self.internBytes(s: "value")
        mut val i: U64 = 0
        while i < keys.count() {
            val recv: U64 = self.pushExpr(e: <Expr.Ident start=dlN.nameStart len=dlN.nameLen />)
            mut val args: Array[Arg] = []
            args.append(<Arg expr=keys[i] isInout=false labelStart=keyL.nameStart labelLen=keyL.nameLen hasLabel=true />)
            args.append(<Arg expr=vals[i] isInout=false labelStart=valL.nameStart labelLen=valL.nameLen hasLabel=true />)
            val m: U64 = self.pushExpr(e: <Expr.Method recv=recv nameStart=insN.nameStart nameLen=insN.nameLen args=self.pushArgs(args: args) />)
            stmts.append(self.pushStmt(s: <Stmt.ExprStmt expr=m />))
            i += 1
        }
        val giveRecv: U64 = self.pushExpr(e: <Expr.Ident start=dlN.nameStart len=dlN.nameLen />)
        val mv: U64 = self.pushExpr(e: <Expr.Move operand=giveRecv isBorrow=false />)
        stmts.append(self.pushStmt(s: <Stmt.Give value=mv />))
        val thenBlk: U64 = self.pushBlock(stmts: stmts)
        val rid: U64 = self.pushExpr(e: <Expr.Block body=thenBlk offset=span.start />)
        self.arena.exprSpanStart[rid] = span.start
        return <Result.Ok value=rid />
    }



    inout fn syntheticCallReceiverTerm(exprId: U64, fallback: U64) -> U64 {
        val index: U64 = self.syntheticCallSiteIndex(exprId: exprId)
        if index < self.decls.syntheticCallSites.count() {
            val site: SyntheticCallSite = self.decls.syntheticCallSites[index]
            if site.receiverTerm != 0U64 { return site.receiverTerm }
        }
        return fallback
    }

    // `value[key]` remains an Expr.Index so it can also name a place, but its
    // value read is an ordinary selected call.  Build the one argument range
    // at the frontend selection boundary; it is semantic call input, not a
    // request for Mono to manufacture and resolve a new method expression.
    inout fn indexCallArgs(key: U64) -> ArgRange {
        val label: Bind = self.kwSpan(kw: "key", kwLen: 3U64)
        return self.pushArgs(args: [<Arg expr=key isInout=false labelStart=label.nameStart labelLen=label.nameLen hasLabel=true />])
    }

    // Select the callable denoted by a non-structural subscript while Record
    // still owns lexical scope and the parametric receiver.  Array and Buffer
    // stay structural places; Dictionary's `at` and an Index witness become
    // ordinary frozen CallTemplates.  Mono may lower the already-selected
    // value form for code generation, but must never choose it from spelling.
    inout fn recordIndexCall(exprId: U64, base: U64, key: U64, receiverTerm: U64, receiverType: TypeInfo) -> Result[(), CompileDiagnostic] {
        if self.isBufferType(ti: receiverType) {
            return <Result.Ok value=() />
        }
        if rangeEquals(bytes: self.arena.bytes, start: receiverType.nameStart, len: receiverType.nameLen, kw: "Array") {
            return <Result.Ok value=() />
        }
        mut val name: Bind = self.kwSpan(kw: "index", kwLen: 5U64)
        if self.isDictionaryType(ti: receiverType) {
            name = self.kwSpan(kw: "at", kwLen: 2U64)
        } else if !(self.typeHasMethodNamed(typeStart: receiverType.nameStart, typeLen: receiverType.nameLen, name: "index")) {
            return <Result.Ok value=() />
        }
        val args: ArgRange = self.indexCallArgs(key: key)
        mut val callee: U64 = self.arena.functionCount()
        if receiverTerm != 0U64 {
            callee = (try self.resolveMethodForResolvedReceiver(recv: base, surfaceRef: receiverTerm, sourceId: 0U64, sourceOwner: 0U64, nameStart: name.nameStart, nameLen: name.nameLen, args: args, useOffset: self.exprOffset(id: exprId)))
        }
        if callee >= self.arena.functionCount() {
            callee = (try self.resolveMethodFinalForType(recv: base, receiverType: receiverType, nameStart: name.nameStart, nameLen: name.nameLen, args: args))
        }
        try self.recordParametricMethodCall(exprId: exprId, callee: callee, receiverSource: (try self.directReceiverTemplateForExpr(exprId: base)), receiverTerm: receiverTerm, args: args)
        return <Result.Ok value=() />
    }

    // Preserve an expression's semantic type source without placing a call
    // result inside TypeTerm. A written call is identified by its template key;
    // every other expression is an ordinary parametric term.
    inout fn semanticTypeRecipeForExpr(exprId: U64) -> Result[U64, CompileDiagnostic] {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=exprId callSite=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) />) />
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=exprId callSite=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) />) />
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=exprId callSite=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) />) />
            }
            _ => {}
        }
        return <Result.Ok value=self.semanticTypeRecipeTerm(term: self.parametricExprTerm(exprId: exprId)) />
    }

    // The source-level `for` binding is the payload of the selected `next()`
    // result. This is the desugaring's actual semantic boundary: it preserves
    // a static Iterator proof and an existential requirement witness through
    // the same immutable CallResolution, without a second trait lookup.
    // Recording it on Decls makes it survive fresh local scopes.
    inout fn recordForItemTypeRecipe(stmtId: U64) -> Result[(), CompileDiagnostic] {
        match self.decls.forTypeRecipe(stmtId: stmtId) {
            Optional.Some(v: _) => { return <Result.Ok value=() /> }
            Optional.None => {}
        }
        val iterator: U64 = self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=stmtId siteIsStmt=true callSite=(try self.templateProtocolSiteKey(fnIdx: self.cur.checkFn, stmtId: stmtId, slot: 1U64)) />)
        val next: U64 = self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=stmtId siteIsStmt=true callSite=(try self.templateProtocolSiteKey(fnIdx: self.cur.checkFn, stmtId: stmtId, slot: 2U64)) />)
        val item: U64 = self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=4U64 input=next />)
        self.decls.registerForTypeRecipe(recipe: <ForTypeRecipe stmtId=stmtId iteratorRecipe=iterator nextRecipe=next itemRecipe=item />)
        return <Result.Ok value=() />
    }

    // `for` protocol slot 1 consumes an iterable value. When that value is a
    // written call, its precise concrete receiver is the completed result of
    // that call under the active BodyInstance — not the call's declaration-time
    // result term, which can intentionally retain `Self`/`Item`. Record the
    // semantic dependency by CallSiteKey; ExprId is merely lookup navigation.
    inout fn protocolReceiverTemplateForExpr(exprId: U64) -> Result[CallTemplateReceiver, CompileDiagnostic] {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=<CallTemplateReceiver.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=<CallTemplateReceiver.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return <Result.Ok value=<CallTemplateReceiver.PriorCallResult exprId=exprId siteKey=(try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)) /> />
            }
            _ => {}
        }
        return <Result.Ok value=<CallTemplateReceiver.Term term=self.parametricExprTerm(exprId: exprId) /> />
    }

    // Written direct methods have exactly the same receiver provenance as a
    // protocol call: a nested written call supplies its completed descriptor;
    // every other receiver contributes its closed declaration-time TypeTerm.
    // Keep the site kinds separate in CallTemplate, but not their value-source
    // algebra.
    // A type parameter used as an associated-call qualifier is a lexical
    // binder, not a value expression. Keep its term on the call receiver only.
    inout fn typeParameterQualifierTerm(exprId: U64) -> U64 {
        if self.cur.checkFn >= self.arena.functionCount() { return 0U64 }
        match self.arena.exprs[exprId] {
            Expr.Ident(val start, val len) => {
                if !self.identIsTypeQualifier(start: start, len: len, tpFn: self.cur.checkFn) { return 0U64 }
                val nameId: U64 = intern(c: inout self, start: start, len: len)
                val params: FuncBindRange = self.arena.functionAt(index: self.cur.checkFn).typeParams
                mut val index: U64 = 0U64
                while index < params.count() {
                    val parameter: Bind = self.funcBindAt(binds: params, index: index)
                    if parameter.nameId == nameId {
                        return self.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen nameId=parameter.nameId paramId=parameter.paramId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                    }
                    index += 1U64
                }
            }
            _ => {}
        }
        return 0U64
    }

    // A concrete type qualifier is provenance, not a value expression. Bare
    // generic heads remain incomplete and use the existing inference route.
    inout fn concreteTypeQualifierTerm(exprId: U64) -> Result[U64, CompileDiagnostic] {
        val name = self.assocRecvName(recv: exprId)
        if name.nameLen == 0U64 { return <Result.Ok value=0U64 />}
        val declaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: self.exprOffset(id: exprId)), start: name.nameStart, len: name.nameLen)
        val term = self.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=declaration.nameLen != 0U64 declOffset=declaration.nameStart />)
        if term == 0U64 || !(try self.tyRefIsGround(ref: term)) { return <Result.Ok value=0U64 />}
        val storage = self.fieldStorageTypeRef(receiverRef: term)
        if storage == 0U64 { return <Result.Ok value=0U64 />}
        val type = self.arena.typeAt(index: storage)
        val structIndex = self.structIndexForType(ref: storage)
        if structIndex < self.arena.structCount() && self.arena.structAt(index: structIndex).typeParams.count() != type.args.count() { return <Result.Ok value=0U64 />}
        val enumIndex = self.enumIndexForType(ref: storage)
        if enumIndex < self.arena.enumCount() && self.arena.enumAt(index: enumIndex).typeParams.count() != type.args.count() { return <Result.Ok value=0U64 />}
        return <Result.Ok value=term />
    }

    inout fn methodReceiverTerm(exprId: U64) -> Result[U64, CompileDiagnostic] {
        val valueTerm: U64 = self.parametricExprTerm(exprId: exprId)
        if valueTerm != 0U64 { return <Result.Ok value=valueTerm />}
        val parameter = self.typeParameterQualifierTerm(exprId: exprId)
        if parameter != 0U64 { return <Result.Ok value=parameter />}
        return <Result.Ok value=(try self.concreteTypeQualifierTerm(exprId: exprId)) />
    }

    inout fn directReceiverTemplateForExpr(exprId: U64) -> Result[CallTemplateReceiver, CompileDiagnostic] {
        val qualifier: U64 = self.typeParameterQualifierTerm(exprId: exprId)
        if qualifier != 0U64 { return <Result.Ok value=<CallTemplateReceiver.Term term=qualifier /> />}
        val concrete = (try self.concreteTypeQualifierTerm(exprId: exprId))
        if concrete != 0U64 { return <Result.Ok value=<CallTemplateReceiver.Term term=concrete /> />}
        return <Result.Ok value=(try self.protocolReceiverTemplateForExpr(exprId: exprId)) />
    }

    // `Expr.ExtMethod` stores its `#` selector on the outer node rather than
    // manufacturing an `Expr.ExtView` receiver. Preserve that selector in the
    // receiver source itself. A prior call must remain a dependency, with the
    // view applied after its body-instance result is read; a plain value can
    // carry the already-decorated TypeTerm directly.
    inout fn viewedReceiverTemplateForExpr(exprId: U64, viewedTerm: U64) -> Result[CallTemplateReceiver, CompileDiagnostic] {
        val base: CallTemplateReceiver = (try self.directReceiverTemplateForExpr(exprId: exprId))
        match base {
            CallTemplateReceiver.Term(term: _) => { return <Result.Ok value=<CallTemplateReceiver.Term term=viewedTerm /> />}
            CallTemplateReceiver.PriorCallResult(exprId: val priorExpr, siteKey: val priorKey) => {
                return <Result.Ok value=<CallTemplateReceiver.PriorCallResultWithViews exprId=priorExpr siteKey=priorKey views=self.publishCallTemplateViews(views: self.typeRefViewSources(ref: viewedTerm)) /> />
            }
            CallTemplateReceiver.PriorProtocolResult(slot: val priorSlot) => {
                return <Result.Ok value=<CallTemplateReceiver.PriorProtocolResultWithViews slot=priorSlot views=self.publishCallTemplateViews(views: self.typeRefViewSources(ref: viewedTerm)) /> />
            }
            _ => {}
        }
        return <Result.Ok value=base />
    }

    // `for` introduces a source-level binding just like `val`: its type must
    // be the iterator proof's associated `Item` term, not the legacy
    // TypeInfo name recovered from the iterator head.  An adapter such as
    // `xs.map(...).filter(...)` owns `Item = E` in its conformance; retaining
    // that term is what lets a generic free call in the loop body later ground
    // E through the enclosing BodyInstance.
    inout fn iterableItemTerm(iterExpr: U64, iterTerm: U64) -> Result[U64, CompileDiagnostic] {
        if iterTerm == 0U64 || iterTerm >= self.arena.typeCount() { return <Result.Ok value=0U64 />}
        val iterTy: TypeRef = self.arena.typeAt(index: iterTerm)
        if iterTy.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: iterTy.nameStart, len: iterTy.nameLen, kw: "Array") {
            return <Result.Ok value=iterTy.args[0] />
        }
        val protocolItem: U64 = (try self.iterableProtocolItemTerm(iterTerm: iterTerm))
        if protocolItem != 0U64 { return <Result.Ok value=protocolItem />}
        // Prefer the resolved source carried by the iterator-producing call.
        // It is a declaration owner, so a user trait spelled `Iterator` can
        // never capture this proof query. A direct iterator value has no call
        // provenance and uses assocItemRef's Core-contract path below.
        mut val itemTerm: U64 = 0U64
        if iterExpr < self.arena.exprs.count() {
            val template: CallTemplate = (try self.callTemplateForCurrentBody(exprId: iterExpr))
            match template.kind {
                CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                    if callee < self.arena.functionCount() {
                        val selected: Func = self.arena.functionAt(index: callee)
                        if selected.originTraitOwner != 0U64 {
                            val item: Bind = self.kwSpan(kw: "Item", kwLen: 4U64)
                            itemTerm = (try self.assocBindingFor(baseRef: iterTerm, traitId: selected.originTraitId, traitOwner: selected.originTraitOwner, traitArgs: self.copyFuncTypes(types: selected.recvTraitArgs), assocId: intern(c: inout self, start: item.nameStart, len: item.nameLen)))
                        }
                    }
                }
                _ => {}
            }
        }
        if itemTerm == 0U64 {
            itemTerm = (try self.assocItemRef(recvStart: iterTy.nameStart, recvLen: iterTy.nameLen, recvInstRef: iterTerm))
        }
        if itemTerm != 0U64 { return <Result.Ok value=itemTerm />}
        return <Result.Ok value=0U64 />
    }

    // A body-local `Self` is a semantic receiver projection, not an opaque
    // nominal argument.  Generic-call recording needs its declaration-time
    // receiver pattern when the callee parameter structurally exposes that
    // receiver's arguments: in `impl[T] Buffer[T] as Eq`, passing
    // `lhs: Self` to `bufferEq[T](Buffer[T], Buffer[T])` selects the caller's
    // `T`.  Trait requirement bodies have no nominal receiver pattern and
    // intentionally retain abstract `Self`; their concrete witness instance
    // supplies it only when the shared body is grounded.
    inout fn parametricCallArgumentTerm(exprId: U64) -> U64 {
        val term: U64 = self.parametricExprTerm(exprId: exprId)
        if term == 0U64 || term >= self.arena.typeCount() { return term }
        val t: TypeRef = self.arena.typeAt(index: term)
        if t.args.count() != 0U64 || !(rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self")) {
            return term
        }
        if self.cur.checkFn >= self.arena.functionCount() { return term }
        val owner: Func = self.arena.functionAt(index: self.cur.checkFn)
        if owner.recvTy != 0U64 { return owner.recvTy }
        return term
    }

    // Build a source call substitution from the declaration-time argument
    // terms once. Record owns the lexical Self projection above; no legacy
    // TypeInfo result or concrete BodyInstance descriptor participates.
    // Signature verification checks the resulting argument constraints before
    // the lexical call template is sealed.
    inout fn inferRecordedFreeCallArgs(f: Func, args: ArgRange) -> Result[Array[U64], CompileDiagnostic] {
        mut val out: Array[U64] = []
        if f.typeParams.count() == 0U64 { return <Result.Ok value=out /> }
        while out.count() < f.typeParams.count() { out.append(0U64) }
        mut val index = 0U64
        while index < f.params.count() {
            val parameter = self.funcParamAt(params: f.params, index: index)
            val supplied = self.argIndexForParam(params: f.params, args: args, paramIdx: index)
            if supplied < args.len {
                val expression = self.argAt(args: args, index: supplied).expr
                val argument = self.parametricCallArgumentTerm(exprId: expression)
                out = try self.extendCallTypeArguments(pattern: parameter.ty, argument: argument, params: f.typeParams, values: out, offset: self.exprOffset(id: expression))
            }
            index += 1U64
        }
        return <Result.Ok value=out />
    }

    // Record the parametric result and the independently-carried source call
    // selection.  The result is a plain TypeTerm; callee/receiver/substitution
    // remain provenance so canonical type identity cannot depend on a call.
    // Record and declaration verification share the selected signature's
    // substitution. Templates are mutable construction records until the lexical
    // body is verified and sealed; consumers cannot treat an early row as proof.
    inout fn freeCallParameterEnvironment(f: Func, args: ArgRange) -> Result[InstanceEnvironment, CompileDiagnostic] {
        if f.typeParams.count() == 0U64 { return <Result.Ok value=<InstanceEnvironment /> /> }
        val inferred = try self.inferFnArgs(f: f, args: args)
        if !self.fnArgsAllResolved(args: inferred) { return <Result.Ok value=<InstanceEnvironment /> /> }
        return <Result.Ok value=<InstanceEnvironment params=self.copyFuncBinds(binds: f.typeParams) args=inferred /> />
    }

    inout fn recordParametricFreeCall(exprId: U64, callee: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if callee >= self.arena.functionCount() { return <Result.Ok value=() /> }
        val f: Func = self.arena.functionAt(index: callee)
        try self.checkCallDeclarationKind(exprId: exprId, declaration: f)
        mut val calleeArgs: Array[U64] = []
        if f.typeParams.count() > 0U64 {
            calleeArgs = try self.inferRecordedFreeCallArgs(f: f, args: args)
        }
        mut val result: U64 = f.retTy
        // A source body may call `id[T](value: T) -> T` while its own T is
        // still symbolic.  That is a complete *semantic* substitution even
        // though it is not an emittable Mono instance yet.  Preserve the
        // caller-owned T in the expression result; retaining the callee's
        // ParamId would make a later body environment unable to ground it.
        // `fnArgsAllGround` is deliberately reserved for reachability/codegen.
        if f.typeParams.count() == 0U64 || self.fnArgsAllResolved(args: calleeArgs) {
            // Substitution alone leaves a concrete receiver's associated
            // output as a projection. Close it with the same explicit
            // environment used by method signatures before publishing the
            // call result to field selection and local inference.
            val environment = <InstanceEnvironment params=self.copyFuncBinds(binds: f.typeParams) args=calleeArgs />
            result = (try self.groundTermForBody(ref: f.retTy, environment: environment, selfRef: 0U64, itemRef: 0U64))
        }
        try self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: <CallTemplateReceiver.None />, args: args, calleeTypeArgs: calleeArgs, resultTerm: result)
        return <Result.Ok value=() />
    }

    // A context-only row is not a callable selection. All written-call
    // families use this boundary once their lexical candidates are exhausted.
    inout fn recordedCallIsSelected(exprId: U64) -> Result[Bool, CompileDiagnostic] {
        val site = try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId)
        val index = self.decls.callTemplateIndex(siteKey: site)
        if index >= self.decls.callTemplates.count() { return <Result.Ok value=false /> }
        match self.decls.callTemplates[index].kind {
            CallTemplateKind.Pending => { return <Result.Ok value=false /> }
            CallTemplateKind.ExpectedValue => { return <Result.Ok value=false /> }
            _ => { return <Result.Ok value=true /> }
        }
    }

    // Resolve the lexical closure target while Record owns the source scope.
    // `bindingDeclStart` is the lowered declaration identity, so the final
    // descriptor cannot accidentally select a same-spelled shadow later.
    inout fn recordDynamicLocalCall(exprId: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[Bool, CompileDiagnostic] {
        val localIndex: U64 = self.localIndexByName(start: nameStart, len: nameLen)
        if localIndex >= self.cur.locals.count() { return <Result.Ok value=false /> }
        try self.recordDeclarationCapture(localIndex: localIndex)
        val local: Local = self.cur.locals[localIndex]
        if !(self.isFnType(ref: local.ty)) { return <Result.Ok value=false /> }
        try self.recordDynamicCallTemplate(exprId: exprId, receiver: <CallTemplateReceiver.None />, args: args, target: <DynamicCallTemplateTarget.ClosureLocal bindingDeclStart=local.nameStart fnTypeTerm=local.ty />)
        return <Result.Ok value=true />
    }

    // An `any` type has an already-resolved declaration identity in TypeRef.
    // Prefer that owner over a spelling scan so a use/re-export cannot
    // redirect an existential slot after the source resolver selected it.
    inout fn recordAnyTraitIndex(anyRef: U64) -> U64 {
        if anyRef == 0U64 || anyRef >= self.arena.typeCount() { return self.decls.traitCount() }
        val anyTy: TypeRef = self.arena.typeAt(index: anyRef)
        if !(anyTy.isAny) { return self.decls.traitCount() }
        mut val owner = anyTy.declOffset
        if !anyTy.hasDecl {
            owner = self.traitOwnerAtUse(start: anyTy.nameStart, len: anyTy.nameLen, arity: 0U64, openArgs: true)
        }
        if owner == 0U64 { return self.decls.traitCount() }
        mut val i: U64 = 0U64
        while i < self.decls.traitCount() {
            if self.decls.traitAt(index: i).nameStart == owner { return i }
            i += 1U64
        }
        return self.decls.traitCount()
    }

    inout fn recordAnyRequirementSlot(anyRef: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> U64 {
        val traitIndex: U64 = self.recordAnyTraitIndex(anyRef: anyRef)
        if traitIndex >= self.decls.traitCount() { return 0U64 }
        val nameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val tr: TraitDef = self.decls.traitAt(index: traitIndex)
        mut val i: U64 = 0U64
        while i < tr.reqs.count() {
            val req: Func = self.traitReqAt(reqs: tr.reqs, index: i)
            if req.nameId == nameId && self.paramsLabelsOk(params: req.params, args: args) { return i + 1U64 }
            i += 1U64
        }
        return 0U64
    }

    // A method expression whose receiver is a function-valued field or an
    // existential has no static Func callee.  Record its selected target while
    // the parametric receiver and source selector are both available; the
    // function TypeTerm is grounded only when the shared body is instantiated.
    inout fn recordDynamicMethodCall(exprId: U64, receiverExpr: U64, receiverTerm: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[Bool, CompileDiagnostic] {
        if self.traceCodegen {
            eprint(text: "[trace-codegen] record dynamic-method body=")
            eprintU64(n: self.cur.checkFn)
            eprint(text: " expr=")
            eprintU64(n: exprId)
            eprint(text: " receiver-expr=")
            eprintU64(n: receiverExpr)
            eprint(text: " receiver-term=")
            eprintU64(n: receiverTerm)
            eprint(text: " receiver-type=")
            self.traceMonoTypeHead(ref: receiverTerm)
            if receiverTerm != 0U64 && receiverTerm < self.arena.typeCount() {
                eprint(text: " receiver-any=")
                if self.arena.typeTerms[receiverTerm].isAny { eprint(text: "true") }
                else { eprint(text: "false") }
            }
            eprint(text: "\n")
        }
        if receiverTerm == 0U64 || receiverTerm >= self.arena.typeCount() { return <Result.Ok value=false /> }
        val receiver: CallTemplateReceiver = (try self.directReceiverTemplateForExpr(exprId: receiverExpr))
        val recvTy: TypeRef = self.arena.typeAt(index: receiverTerm)
        if recvTy.isAny {
            val traitIndex: U64 = self.recordAnyTraitIndex(anyRef: receiverTerm)
            val slot: U64 = self.recordAnyRequirementSlot(anyRef: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
            if traitIndex < self.decls.traitCount() && slot != 0U64 {
                val requirement = self.traitReqAt(reqs: self.decls.traitAt(index: traitIndex).reqs, index: slot - 1U64)
                try self.checkExistentialRequirementCall(req: requirement, target: receiverTerm, traitIndex: traitIndex, requirement: slot - 1U64, offset: self.exprOffset(id: exprId))
                try self.recordDynamicCallTemplate(exprId: exprId, receiver: receiver, args: args, target: <DynamicCallTemplateTarget.ExistentialRequirement traitIdx=traitIndex slot=slot />)
                return <Result.Ok value=true />
            }
            return <Result.Ok value=false />
        }
        val structIndex: U64 = self.structIndexForType(ref: receiverTerm)
        if structIndex >= self.arena.structCount() { return <Result.Ok value=false /> }
        val fieldName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val fields: Array[FieldDef] = self.arena.structAt(index: structIndex).fields
        mut val fieldIndex: U64 = 0U64
        while fieldIndex < fields.count() {
            if fields[fieldIndex].nameId == fieldName { break }
            fieldIndex += 1U64
        }
        if fieldIndex >= fields.count() { return <Result.Ok value=false /> }
        val fieldTerm: U64 = (try self.fieldTypeRefOfReceiver(receiverRef: receiverTerm, fieldStart: nameStart, fieldLen: nameLen))
        // A closure field must have a function type in its declaration.
        // Instantiation cannot retroactively make an unbounded type callable.
        if self.isFnType(ref: fieldTerm) {
            try self.recordDynamicCallTemplate(exprId: exprId, receiver: receiver, args: args, target: <DynamicCallTemplateTarget.ClosureField fieldIndex=fieldIndex fnTypeTerm=fieldTerm />)
            return <Result.Ok value=true />
        }
        return <Result.Ok value=false />
    }

    // A method whose concrete declaration is unavailable during the
    // declaration-time walk is not a dynamic call by default: it can still be
    // a statically selected requirement or provided trait member under a
    // generic bound.  Both ordinary and source-qualified (`#…`) method syntax
    // reach this one finalization point so they cannot diverge by silently
    // treating a view-qualified static call as a closure-field call.
    inout fn recordUnresolvedMethodTemplate(exprId: U64, receiver: CallTemplateReceiver, receiverExpr: U64, receiverTerm: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        val staticResolution: StaticMemberResolution = (try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args, requiredTraitOwner: self.syntheticRequiredTraitOwner(exprId: exprId)))
        match staticResolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: val traitIdx, reqIdx: val reqIdx) => {
                if self.typeParameterQualifierTerm(exprId: receiverExpr) != 0U64 && !self.traitReqAt(reqs: self.decls.traitAt(index: traitIdx).reqs, index: reqIdx).isAssoc {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "a type qualifier can only call an associated function") />
                }
                try self.recordStaticMethodTemplate(exprId: exprId, receiverTerm: receiverTerm, receiver: receiver, args: args, resolution: staticResolution, resultTerm: (try self.staticRequirementCallResultType(resolution: staticResolution, args: args)))
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: val declaration) => {
                if self.typeParameterQualifierTerm(exprId: receiverExpr) != 0U64 && !self.arena.functionAt(index: declaration).isAssoc {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "a type qualifier can only call an associated function") />
                }
                try self.recordStaticMethodTemplate(exprId: exprId, receiverTerm: receiverTerm, receiver: receiver, args: args, resolution: staticResolution, resultTerm: self.parametricExprTerm(exprId: exprId))
            }
            _ => {
                val selected = try self.recordDynamicMethodCall(exprId: exprId, receiverExpr: receiverExpr, receiverTerm: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
                // Selection failure is a result of this lexical query, not
                // inferred from whether a later publication pass wrote a row.
                if !selected && !self.cur.recordingAccessWriteFacet {
                    // No selected signature can provide further context here.
                    // Diagnose an untyped receiver before missing conformance.
                    if receiverTerm == 0U64 { try self.checkLitCtx(id: receiverExpr, eKind: 0U64, eBits: 0U64, eSgn: false) }
                    if self.syntheticRequiredTraitOwner(exprId: exprId) != 0U64 {
                        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: self.missingSyntheticRequirement(exprId: exprId)) />
                    }
                    if receiverTerm != 0U64 && receiverTerm < self.arena.typeCount() && self.arena.typeTerms[receiverTerm].isAny {
                        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "method is not part of the existential trait interface") />
                    }
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "no matching method for this argument list") />
                }
            }
        }
        return <Result.Ok value=() />
    }

    inout fn recordParametricMethodCall(exprId: U64, callee: U64, receiverSource: CallTemplateReceiver, receiverTerm: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        if callee >= self.arena.functionCount() { return <Result.Ok value=() /> }
        val f: Func = self.arena.functionAt(index: callee)
        try self.checkCallDeclarationKind(exprId: exprId, declaration: f)
        // Associated factories are syntactically method-shaped but have a
        // type qualifier, not a value receiver.  Their selected declaration
        // is complete without a receiver TypeTerm; the finalizer supplies the
        // declaration receiver (or an explicitly-recorded result hint for a
        // generic associated factory).  Do not discard that source selection.
        if receiverTerm == 0U64 {
            if f.isAssoc {
                val inferredReceiver = (try self.associatedReceiverFromArguments(f: f, args: args))
                if inferredReceiver != 0U64 {
                    try self.recordParametricMethodCall(exprId: exprId, callee: callee, receiverSource: <CallTemplateReceiver.Term term=inferredReceiver />, receiverTerm: inferredReceiver, args: args)
                    return <Result.Ok value=() />
                }
                try self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: <CallTemplateReceiver.None />, args: args, calleeTypeArgs: [], resultTerm: f.retTy)
                return <Result.Ok value=() />
            }
            // A compiler-internal receiver such as `Comp` has no language
            // TypeRef, but its method was nevertheless selected by Frontend.
            // Preserve that lexical selection instead of leaving Mono to
            // reopen the written call. Trait-provided calls are excluded:
            // their proof necessarily needs a real receiver term.
            if !(f.isProvided) {
                try self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: <CallTemplateReceiver.Opaque />, args: args, calleeTypeArgs: [], resultTerm: f.retTy)
            }
            return <Result.Ok value=() />
        }
        if receiverTerm >= self.arena.typeCount() { return <Result.Ok value=() /> }
        // A resolver can find the authored declaration of a trait-subject
        // witness while checking a provided body. That declaration is not a
        // concrete callee: `impl B as A` is abstract over B and must be
        // selected through the current static proof. Recording it as Direct
        // loses the proof and later enqueues the abstract body. A normal
        // requirement retains the established Direct-template route, whose
        // final descriptor owns the concrete implementation. `originTraitId`
        // distinguishes the former from `impl A { … }` and direct `S as A`.
        // The source body of `impl Named as Show` is checked once with a
        // symbolic trait receiver. `resolvedCallee` may incidentally see a
        // concrete copied witness loaded elsewhere (A.nm/B.nm), but that is
        // not a lexical selection for this shared body. Ask the source body's
        // trait proof first; a successful Requirement/Provided result becomes
        // a StaticMethod template and is reified per BodyInstance later.
        // Retain the selected-callee predicate for ordinary trait-receiver
        // declarations reached through their requirement surface.
        mut val sourceTraitReceiver: Bool = false
        if self.cur.checkFn < self.arena.functionCount() {
            sourceTraitReceiver = self.methodRecvIsTrait(f: self.arena.functionAt(index: self.cur.checkFn))
        }
        if (sourceTraitReceiver || self.methodRecvIsTrait(f: f)) && (sourceTraitReceiver || f.originTraitId != 0U64) {
            val staticResolution: StaticMemberResolution = (try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: f.nameStart, nameLen: f.nameLen, args: args, requiredTraitOwner: self.syntheticRequiredTraitOwner(exprId: exprId)))
            match staticResolution {
                StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                    val result: U64 = (try self.staticRequirementCallResultType(resolution: staticResolution, args: args))
                    if result != 0U64 { self.recordSemanticExprTerm(exprId: exprId, term: result) }
                    try self.recordStaticMethodTemplate(exprId: exprId, receiverTerm: receiverTerm, receiver: receiverSource, args: args, resolution: staticResolution, resultTerm: result)
                    return <Result.Ok value=() />
                }
                StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {
                    try self.recordStaticMethodTemplate(exprId: exprId, receiverTerm: receiverTerm, receiver: receiverSource, args: args, resolution: staticResolution, resultTerm: self.parametricExprTerm(exprId: exprId))
                    return <Result.Ok value=() />
                }
                _ => {}
            }
        }
        // Selection names the original declaration, but its public signature
        // substitutes the authored receiver. Mono supplies the adapter that
        // separates this surface from the executable body's original Self.
        val finalEnvironment: InstanceEnvironment = (try self.finalMethodEnvironment(f: f, receiverRef: receiverTerm, args: args))
        val result: U64 = (try self.groundFinalMethodSignatureInEnvironment(f: f, environment: finalEnvironment, signatureTerm: f.retTy))
        // The final callable's complete ParamId substitution is provenance,
        // not a Mono inference request.  Persist it beside the selected
        // callee so every downstream consumer sees the same method/impl
        // environment used above for result and argument terms.
        // An associated factory's syntactic qualifier can itself lower through
        // method-shaped nodes (for example `MutableRef[Cell]`).  It is never a
        // value produced by that node: its semantic receiver is the selected
        // type term.  Using the ordinary receiver source would misclassify it
        // as PriorCallResult and create a nonexistent descriptor dependency.
        mut val finalReceiverSource: CallTemplateReceiver = receiverSource
        if f.isAssoc { finalReceiverSource = <CallTemplateReceiver.Term term=receiverTerm /> }
        mut val proof: StaticConformanceProof = finalEnvironment.proof
        if f.isProvided {
            val resolution: StaticMemberResolution = (try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: f.nameStart, nameLen: f.nameLen, args: args, requiredTraitOwner: self.syntheticRequiredTraitOwner(exprId: exprId)))
            match resolution {
                StaticMemberResolution.Requirement(proof: val selected, traitIdx: _, reqIdx: _) => { proof = selected }
                StaticMemberResolution.Provided(proof: val selected, traitIdx: _, callee: _) => { proof = selected }
                _ => {}
            }
        }
        try self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: finalReceiverSource, args: args, calleeTypeArgs: self.signatureTypeArguments(f: f, environment: finalEnvironment), resultTerm: result, proof: proof, receiverTypeTerm: receiverTerm)
        return <Result.Ok value=() />
    }

    // The PARAMETRIC receiver ref for method `f` — the form `self` records as, chosen
    // so groundTypeRef at emission substitutes the instance: a trait provided-method
    // template records `Self` (grounds to the conformer via cur.selfRef); a generic
    // receiver records `Dictionary[K,V]` with the impl's own type-param names as args
    // (the first rcount of f.typeParams, matching emitOneGenMethod's env layout); a
    // non-generic receiver records its argless name ref (grounds to itself). No
    // receiver: 0.
    inout fn parametricSelfRef(f: Func) -> U64 {
        // an assoc fn has no `self` value (hasRecv false) but its recv spans still
        // name the owning type, and its `Self`-typed params (`assoc fn eq(lhs~:
        // Self, …)`) must resolve to the same parametric receiver.
        if !(f.hasRecv) && f.recvLen == 0U64 {
            return 0U64
        }
        if self.methodRecvIsTrait(f: f) {
            if f.recvTy != 0U64 && self.arena.typeTerms[f.recvTy].paramId != 0U64 { return f.recvTy }
            val sb: Bind = self.kwSpan(kw: "Self", kwLen: 4)
            mut val ti: U64 = 0U64
            while ti < self.decls.traitCount() {
                val traitDef: TraitDef = self.decls.traitAt(index: ti)
                if traitDef.nameStart == f.recvStart && traitDef.selfParamId != 0U64 {
                    return self.pushType(t: <TypeRef nameStart=sb.nameStart nameLen=sb.nameLen paramId=traitDef.selfParamId args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
                }
                ti += 1U64
            }
            return self.simpleTypeRef(nameStart: sb.nameStart, nameLen: sb.nameLen)
        }
        // An extension method's lexical `self` is `Recv#Ext`.  A conferred
        // witness does not inherit a caller's conformance-path view: its shared
        // body is checked against the surface written at its declaration.
        val vid: U64 = f.extId
        // `recvTy` is the declaration's already-lowered semantic receiver.
        // Rebuilding it from the first same-spelled f.typeParams used to erase
        // their ParamIds, making `self.field: I` fail to match an `I: Trait`
        // proof during abstract generic checking.  A non-extension receiver
        // ca use this exact term directly.  Extensions retain the view
        // decoration path below until TypeRef view construction is centralized.
        if f.recvTy != 0U64 {
            if vid == 0U64 {
                return f.recvTy
            }
            mut val extensionView: Array[U64] = []
            extensionView.append(vid)
            return self.typeRefWithViews(ref: f.recvTy, viewExtId: vid, viewIds: extensionView)
        }
        mut val rcount: U64 = 0
        val si: U64 = self.anyStructIndex(nameStart: f.recvStart, nameLen: f.recvLen)
        if si < self.arena.structCount() {
            rcount = self.arena.structAt(index: si).typeParams.count()
        } else {
            val ei: U64 = self.anyEnumIndex(nameStart: f.recvStart, nameLen: f.recvLen)
            if ei < self.arena.enumCount() {
                rcount = self.arena.enumAt(index: ei).typeParams.count()
            }
        }
        mut val args: Array[U64] = []
        mut val i: U64 = 0
        while i < rcount {
            if i < f.typeParams.count() {
                val tp: Bind = self.funcBindAt(binds: f.typeParams, index: i)
                args.append(self.simpleTypeRef(nameStart: tp.nameStart, nameLen: tp.nameLen))
            }
            i += 1
        }
        return self.pushType(t: <TypeRef nameStart=f.recvStart nameLen=f.recvLen args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] viewExtId=vid />)
    }

    // Context supplies only an Array element type. It cannot change the
    // constructor of the expression's semantic type. All expected-result
    // consumers use this boundary, including delayed argument refinement.
    inout fn recordArrayLitCtx(exprId: U64, ctxRef: U64) -> Result[(), CompileDiagnostic] {
        if ctxRef == 0U64 || ctxRef >= self.arena.typeCount() { return <Result.Ok value=() /> }
        match self.arena.exprs[exprId] {
            Expr.Array(elems: val elems) => {
                val context = self.arena.typeAt(index: ctxRef)
                if context.args.count() != 1U64 || self.typeInfoOfRef(ref: ctxRef).kind != 3I64 {
                    if elems.len == 0U64 && self.semanticExprTerm(exprId: exprId) == 0U64 {
                        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "cannot infer an empty array's element type from a non-array context (spec/02)") />
                    }
                    return <Result.Ok value=() />
                }
                val element = context.args[0U64]
                mut val index = 0U64
                while index < elems.len {
                    val expression = self.exprAt(exprs: elems, index: index)
                    try self.recordSemanticExprExpectedResult(exprId: expression, expectedTerm: element)
                    try self.tcCheckValue(expectedRef: element, valueExpr: expression, pos: "element")
                    index += 1U64
                }
                self.recordSemanticExprTerm(exprId: exprId, term: self.arrayRefOfElem(elemRef: element))
                try self.recordSemanticAggregate(exprId: exprId)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // `Record` is the last phase allowed to turn a construction's authored
    // labels/variant spelling into physical layout.  Mid receives only this
    // frozen carrier; its use of ExprId is navigation into an already-selected
    // aggregate tree, never a second name or field lookup.
    inout fn recordSemanticAggregate(exprId: U64) -> Result[(), CompileDiagnostic] {
        if !(self.cur.recordCallTemplates) { return <Result.Ok value=() /> }
        val resultTerm: U64 = self.parametricExprTerm(exprId: exprId)
        if resultTerm == 0U64 {
            if self.exprCompletesNormally(exprId: exprId) { return <Result.Ok value=() /> }
            // A construction can have an ordered evaluation without ever
            // producing a typed aggregate. Preserve that evaluation explicitly;
            // neither a made-up layout nor a made-up element type is needed.
            mut val values: Array[U64] = []
            match self.arena.exprs[exprId] {
                Expr.Array(val elems) => {
                    mut val index = 0U64
                    while index < elems.len { values.append(self.exprAt(exprs: elems, index: index))
                        index += 1U64 }
                }
                Expr.Make(typeStart: _, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, val fields) => {
                    // Only a structural record has no declared layout owner.
                    // Nominal constructors must still resolve and validate it.
                    if isEnum || typeLen != 0U64 || self.pendingConstructionContexts.contains(exprId) { return <Result.Ok value=() /> }
                    mut val index = 0U64
                    while index < fields.len { values.append(self.makeFieldAt(fields: fields, index: index).value)
                        index += 1U64 }
                }
                _ => { return <Result.Ok value=() /> }
            }
            mut val elements: Array[SemanticAggregateElement] = []
            mut val index = 0U64
            while index < values.count() {
                elements.append(<SemanticAggregateElement fieldIndex=index exprId=values[index] targetTerm=0U64 isBoxed=false term=self.parametricExprTerm(exprId: values[index]) />)
                index += 1U64
            }
            return self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.EvaluationOnly /> resultTerm=0U64 fieldCount=elements.count() elements=elements />)
        }
        match self.arena.exprs[exprId] {
            Expr.Make(typeStart: val typeStart, typeLen: val typeLen, variantStart: val variantStart, variantLen: val variantLen, isEnum: val isEnum, ty: _, fields: val fields) => {
                // Validate the resolved construction before publishing layout.
                // Earlier verification can still see deferred contextual arguments.
                val constructionType = resultTerm
                val storage = self.fieldStorageTypeRef(receiverRef: constructionType)
                if isEnum {
                    if self.enumIndexForType(ref: constructionType) >= self.arena.enumCount() {
                        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "this type has no enum variant or named factory with this construction") />
                    }
                } else if storage == 0U64 || storage >= self.arena.typeCount() || (!self.arena.typeAt(index: storage).isRecord && self.structIndexForType(ref: storage) >= self.arena.structCount()) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "this type has no memberwise factory; use a declared factory or enum variant") />
                }
                val storageDeclaration = self.structIndexForType(ref: storage)
                if !isEnum && storageDeclaration < self.arena.structCount() {
                    val declaration = self.arena.structAt(index: storageDeclaration)
                    if declaration.isExtern && !declaration.isCExtern {
                        return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "an opaque intrinsic type has no memberwise factory") />
                    }
                }
                mut val elements: Array[SemanticAggregateElement] = []
                mut val variantIndex: U64 = 0U64
                mut val enumIndex: U64 = self.arena.enumCount()
                if isEnum {
                    enumIndex = self.enumIndexForType(ref: resultTerm)
                    variantIndex = self.variantIndexInDeclaration(enumIndex: enumIndex, nameStart: variantStart, nameLen: variantLen)
                }
                mut val i: U64 = 0U64
                while i < fields.len {
                    val field: MakeField = self.makeFieldAt(fields: fields, index: i)
                    mut val fieldIndex: U64 = 0U64
                    if isEnum {
                        if enumIndex < self.arena.enumCount() && variantIndex < self.arena.enumAt(index: enumIndex).variants.count() {
                            val declaredFields = self.arena.enumVariantAt(enumIndex: enumIndex, variantIndex: variantIndex).fields
                            val name = intern(c: inout self, start: field.nameStart, len: field.nameLen)
                            while fieldIndex < declaredFields.count() {
                                if declaredFields[fieldIndex].nameId == name { break }
                                fieldIndex += 1U64
                            }
                        }
                    } else {
                        fieldIndex = self.fieldIndexOfReceiver(receiverRef: resultTerm, fieldStart: field.nameStart, fieldLen: field.nameLen)
                    }
                    // The physical recursive-field decision is frozen beside
                    // this selected slot. Keep it in Record's existing
                    // aggregate walk: this is layout selection, not a later
                    // backend query and not a separate semantic pass.
                    mut val isBoxed: Bool = false
                    if isEnum {
                        if enumIndex < self.arena.enumCount() && variantIndex < self.arena.enumAt(index: enumIndex).variants.count() {
                            val declaredFields: Array[FieldDef] = self.arena.enumVariantAt(enumIndex: enumIndex, variantIndex: variantIndex).fields
                            if fieldIndex < declaredFields.count() { isBoxed = self.fieldIsBoxed(f: declaredFields[fieldIndex]) }
                        }
                    } else if resultTerm < self.arena.typeCount() && !(self.arena.typeTerms[resultTerm].isRecord) {
                        val structIndex: U64 = self.structIndexForType(ref: self.fieldStorageTypeRef(receiverRef: resultTerm))
                        if structIndex < self.arena.structCount() {
                            val declaredFields: Array[FieldDef] = self.arena.structAt(index: structIndex).fields
                            if fieldIndex < declaredFields.count() { isBoxed = self.fieldIsBoxed(f: declaredFields[fieldIndex]) }
                        }
                    }
                    elements.append(<SemanticAggregateElement fieldIndex=fieldIndex exprId=field.value targetTerm=(try self.aggregateSlotTypeRef(resultRef: resultTerm, isEnum: isEnum, isArrayLiteral: false, variantIndex: variantIndex, fieldIndex: fieldIndex)) isBoxed=isBoxed term=self.parametricExprTerm(exprId: field.value) />)
                    i += 1U64
                }
                // Memberwise fields retain written explicit order followed
                // by defaults appended in declaration order. Destination slots
                // are independent of evaluation. Enum payloads retain their
                // existing declaration-order contract.
                if isEnum {
                    mut val position: U64 = 1U64
                    while position < elements.count() {
                        val element = elements[position]
                        mut val destination = position
                        while destination > 0U64 && elements[destination - 1U64].fieldIndex > element.fieldIndex {
                            elements.set(i: destination, value: elements[destination - 1U64])
                            destination -= 1U64
                        }
                        elements.set(i: destination, value: element)
                        position += 1U64
                    }
                }
                if isEnum {
                    mut val fieldCount: U64 = 0U64
                    if enumIndex < self.arena.enumCount() {
                        val declaration = self.arena.enumAt(index: enumIndex)
                        if variantIndex < declaration.variants.count() {
                            val variant = declaration.variants[variantIndex]
                            fieldCount = variant.fields.count()
                        }
                    }
                    try self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.Enum enumIdx=enumIndex variantIndex=variantIndex /> resultTerm=resultTerm fieldCount=fieldCount elements=elements />)
                } else {
                    mut val fieldCount: U64 = 0U64
                    val result = self.arena.typeAt(index: self.fieldStorageTypeRef(receiverRef: resultTerm))
                    if result.isRecord {
                        fieldCount = result.recordFieldTerms.count()
                    } else {
                        val structIndex: U64 = self.structIndexForType(ref: self.fieldStorageTypeRef(receiverRef: resultTerm))
                        if structIndex < self.arena.structCount() { fieldCount = self.arena.structAt(index: structIndex).fields.count() }
                    }
                    try self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.Struct /> resultTerm=resultTerm fieldCount=fieldCount elements=elements />)
                }
            }
            Expr.Array(elems: val elems) => {
                mut val elements: Array[SemanticAggregateElement] = []
                mut val i: U64 = 0U64
                while i < elems.len {
                    val child: U64 = self.exprAt(exprs: elems, index: i)
                    elements.append(<SemanticAggregateElement fieldIndex=i exprId=child targetTerm=(try self.aggregateSlotTypeRef(resultRef: resultTerm, isEnum: false, isArrayLiteral: true, variantIndex: 0U64, fieldIndex: i)) isBoxed=false term=self.parametricExprTerm(exprId: child) />)
                    i += 1U64
                }
                try self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.Array /> resultTerm=resultTerm fieldCount=elems.len elements=elements />)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // Context can refine an array literal after its first post-order visit.
    // Keep one source-body aggregate identity and replace its frozen facts as
    // a whole; parallel "early" and "contextual" carriers would be two
    // semantic roots for the same construction.
    fn semanticExpressionSiteHash(ownerFnIdx: U64, exprId: U64) -> U64 {
        // Keep every intermediate below 2^32: checked U64 arithmetic is part
        // of the self-hosted compiler's own execution contract.
        val modulus: U64 = 4294967291U64
        mut val h: U64 = ownerFnIdx % modulus
        h = ((h + exprId % modulus) * 65537U64) % modulus
        return h
    }

    inout fn rebuildSemanticAggregateIndex(capacity: U64) {
        self.decls.semanticAggregateIndexSlots = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.decls.semanticAggregateIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.decls.semanticAggregates.count() {
            val aggregate: SemanticAggregate = self.decls.semanticAggregates[entry]
            mut val slot: U64 = self.semanticExpressionSiteHash(ownerFnIdx: aggregate.ownerFnIdx, exprId: aggregate.exprId) % capacity
            while self.decls.semanticAggregateIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.decls.semanticAggregateIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureSemanticAggregateIndex(nextCount: U64) {
        if self.decls.semanticAggregateIndexSlots.count() == 0U64 {
            self.rebuildSemanticAggregateIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.decls.semanticAggregateIndexSlots.count() * 7U64 {
            self.rebuildSemanticAggregateIndex(capacity: self.decls.semanticAggregateIndexSlots.count() * 2U64)
        }
    }

    // Return the canonical array index, or count() when absent. The vector is
    // the semantic source; slots are a rebuildable reader for Record and Mid.
    inout fn semanticAggregateIndex(ownerFnIdx: U64, exprId: U64) -> Result[U64, CompileDiagnostic] {
        val sourceOwner: U64 = (try self.semanticBodyOwner(fnIdx: ownerFnIdx))
        val capacity: U64 = self.decls.semanticAggregateIndexSlots.count()
        if capacity == 0U64 { return <Result.Ok value=self.decls.semanticAggregates.count() />}
        mut val slot: U64 = self.semanticExpressionSiteHash(ownerFnIdx: sourceOwner, exprId: exprId) % capacity
        while self.decls.semanticAggregateIndexSlots[slot] != 0U64 {
            val entry: U64 = self.decls.semanticAggregateIndexSlots[slot] - 1U64
            val prior: SemanticAggregate = self.decls.semanticAggregates[entry]
            if prior.ownerFnIdx == sourceOwner && prior.exprId == exprId { return <Result.Ok value=entry />}
            slot = (slot + 1U64) % capacity
        }
        return <Result.Ok value=self.decls.semanticAggregates.count() />
    }

    inout fn putSemanticAggregate(aggregate: SemanticAggregate) -> Result[(), CompileDiagnostic] {
        val prior: U64 = (try self.semanticAggregateIndex(ownerFnIdx: aggregate.ownerFnIdx, exprId: aggregate.exprId))
        if prior < self.decls.semanticAggregates.count() {
            self.decls.semanticAggregates.set(i: prior, value: aggregate)
            return <Result.Ok value=() />
        }
        self.ensureSemanticAggregateIndex(nextCount: self.decls.semanticAggregates.count() + 1U64)
        self.decls.semanticAggregates.append(aggregate)
        val capacity: U64 = self.decls.semanticAggregateIndexSlots.count()
        mut val slot: U64 = self.semanticExpressionSiteHash(ownerFnIdx: aggregate.ownerFnIdx, exprId: aggregate.exprId) % capacity
        while self.decls.semanticAggregateIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.decls.semanticAggregateIndexSlots.set(i: slot, value: self.decls.semanticAggregates.count())
        return <Result.Ok value=() />
    }

    inout fn rebuildSemanticTryIndex(capacity: U64) {
        self.decls.semanticTryIndexSlots = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.decls.semanticTryIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.decls.semanticTries.count() {
            val fact: SemanticTry = self.decls.semanticTries[entry]
            mut val slot: U64 = self.semanticExpressionSiteHash(ownerFnIdx: fact.ownerFnIdx, exprId: fact.exprId) % capacity
            while self.decls.semanticTryIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.decls.semanticTryIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureSemanticTryIndex(nextCount: U64) {
        if self.decls.semanticTryIndexSlots.count() == 0U64 {
            self.rebuildSemanticTryIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.decls.semanticTryIndexSlots.count() * 7U64 {
            self.rebuildSemanticTryIndex(capacity: self.decls.semanticTryIndexSlots.count() * 2U64)
        }
    }

    // Return the canonical array index, or count() when absent. The vector is
    // the semantic source; slots are a rebuildable reader for Record and Mid.
    inout fn semanticTryIndex(ownerFnIdx: U64, exprId: U64) -> Result[U64, CompileDiagnostic] {
        val sourceOwner: U64 = (try self.semanticBodyOwner(fnIdx: ownerFnIdx))
        val capacity: U64 = self.decls.semanticTryIndexSlots.count()
        if capacity == 0U64 { return <Result.Ok value=self.decls.semanticTries.count() />}
        mut val slot: U64 = self.semanticExpressionSiteHash(ownerFnIdx: sourceOwner, exprId: exprId) % capacity
        while self.decls.semanticTryIndexSlots[slot] != 0U64 {
            val entry: U64 = self.decls.semanticTryIndexSlots[slot] - 1U64
            val prior: SemanticTry = self.decls.semanticTries[entry]
            if prior.ownerFnIdx == sourceOwner && prior.exprId == exprId { return <Result.Ok value=entry />}
            slot = (slot + 1U64) % capacity
        }
        return <Result.Ok value=self.decls.semanticTries.count() />
    }

    inout fn putSemanticTry(fact: SemanticTry) -> Result[(), CompileDiagnostic] {
        val prior: U64 = (try self.semanticTryIndex(ownerFnIdx: fact.ownerFnIdx, exprId: fact.exprId))
        if prior < self.decls.semanticTries.count() {
            self.decls.semanticTries.set(i: prior, value: fact)
            return <Result.Ok value=() />
        }
        self.ensureSemanticTryIndex(nextCount: self.decls.semanticTries.count() + 1U64)
        self.decls.semanticTries.append(fact)
        val capacity: U64 = self.decls.semanticTryIndexSlots.count()
        mut val slot: U64 = self.semanticExpressionSiteHash(ownerFnIdx: fact.ownerFnIdx, exprId: fact.exprId) % capacity
        while self.decls.semanticTryIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.decls.semanticTryIndexSlots.set(i: slot, value: self.decls.semanticTries.count())
        return <Result.Ok value=() />
    }

    fn semanticMatchHash(ownerFnIdx: U64, matchSource: MatchSource) -> U64 {
        val modulus: U64 = 4294967291U64
        val encoded: U64 = match matchSource { MatchSource.Statement(stmtId: val id) => { give id * 3U64 } MatchSource.Expression(exprId: val id) => { give id * 3U64 + 1U64 } MatchSource.Condition(clauseIndex: val id) => { give id * 3U64 + 2U64 } }
        return (((ownerFnIdx % modulus + encoded % modulus) * 65537U64) + 29U64) % modulus
    }

    fn sameMatchSource(a: MatchSource, b: MatchSource) -> Bool {
        match a {
            MatchSource.Statement(stmtId: val left) => { match b { MatchSource.Statement(stmtId: val right) => { return left == right } _ => { return false } } }
            MatchSource.Expression(exprId: val left) => { match b { MatchSource.Expression(exprId: val right) => { return left == right } _ => { return false } } }
            MatchSource.Condition(clauseIndex: val left) => { match b { MatchSource.Condition(clauseIndex: val right) => { return left == right } _ => { return false } } }
        }
    }

    inout fn rebuildSemanticMatchIndex(capacity: U64) {
        self.decls.semanticMatchIndexSlots = []
        mut val zero: U64 = 0U64
        while zero < capacity {
            self.decls.semanticMatchIndexSlots.append(0U64)
            zero += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.decls.semanticMatches.count() {
            val fact: SemanticMatch = self.decls.semanticMatches[entry]
            mut val slot: U64 = self.semanticMatchHash(ownerFnIdx: fact.ownerFnIdx, matchSource: fact.matchSource) % capacity
            while self.decls.semanticMatchIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.decls.semanticMatchIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureSemanticMatchIndex(nextCount: U64) {
        if self.decls.semanticMatchIndexSlots.count() == 0U64 {
            self.rebuildSemanticMatchIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.decls.semanticMatchIndexSlots.count() * 7U64 {
            self.rebuildSemanticMatchIndex(capacity: self.decls.semanticMatchIndexSlots.count() * 2U64)
        }
    }

    inout fn semanticMatchIndex(ownerFnIdx: U64, matchSource: MatchSource) -> Result[U64, CompileDiagnostic] {
        val sourceOwner: U64 = (try self.semanticBodyOwner(fnIdx: ownerFnIdx))
        val capacity: U64 = self.decls.semanticMatchIndexSlots.count()
        if capacity == 0U64 { return <Result.Ok value=self.decls.semanticMatches.count() />}
        mut val slot: U64 = self.semanticMatchHash(ownerFnIdx: sourceOwner, matchSource: matchSource) % capacity
        while self.decls.semanticMatchIndexSlots[slot] != 0U64 {
            val entry: U64 = self.decls.semanticMatchIndexSlots[slot] - 1U64
            val fact: SemanticMatch = self.decls.semanticMatches[entry]
            if fact.ownerFnIdx == sourceOwner && self.sameMatchSource(a: fact.matchSource, b: matchSource) { return <Result.Ok value=entry />}
            slot = (slot + 1U64) % capacity
        }
        return <Result.Ok value=self.decls.semanticMatches.count() />
    }

    inout fn putSemanticMatch(fact: SemanticMatch) -> Result[(), CompileDiagnostic] {
        val prior: U64 = (try self.semanticMatchIndex(ownerFnIdx: fact.ownerFnIdx, matchSource: fact.matchSource))
        if prior < self.decls.semanticMatches.count() {
            self.decls.semanticMatches.set(i: prior, value: fact)
            return <Result.Ok value=() />
        }
        self.ensureSemanticMatchIndex(nextCount: self.decls.semanticMatches.count() + 1U64)
        self.decls.semanticMatches.append(fact)
        val capacity: U64 = self.decls.semanticMatchIndexSlots.count()
        mut val slot: U64 = self.semanticMatchHash(ownerFnIdx: fact.ownerFnIdx, matchSource: fact.matchSource) % capacity
        while self.decls.semanticMatchIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.decls.semanticMatchIndexSlots.set(i: slot, value: self.decls.semanticMatches.count())
        return <Result.Ok value=() />
    }

    // Freeze struct field bindings while Record owns name-to-layout work.
    // Missing or invalid terms leave no fact; Mid must not reconstruct them.
    inout fn recordSemanticMatch(matchSource: MatchSource, scrut: U64, arms: MatchArmRange) -> Result[(), CompileDiagnostic] {
        mut val patterns: Array[PatInfo] = []
        mut val index = 0U64
        while index < arms.len {
            mut val arm = self.matchArmAt(arms: arms, index: index)
            try self.checkEnumPatternSubject(scrut: scrut, pattern: self.patternInfo(arm: arm))
            if arm.isValuePattern {
                if arm.testExpr == 0U64 {
                    val subject = self.pushExpr(e: <Expr.MatchSubject scrut=scrut />)
                    arm.testExpr = self.pushExpr(e: <Expr.Binary op=opEq() lhs=subject rhs=arm.valueExpr />)
                    self.arena.matchArmPool.set(i: arms.start + index, value: arm)
                }
                try self.recordExpr(exprId: arm.testExpr)
            }
            patterns.append(self.patternInfo(arm: arm))
            index += 1U64
        }
        try self.recordSemanticPatterns(matchSource: matchSource, scrut: scrut, arms: patterns)
        if self.cur.recordCallTemplates {
            if !(try self.matchExhaustive(scrut: scrut, arms: arms)) { return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: scrut), msg: "match must be exhaustive: cover all variants or add a wildcard") /> }
        }
        try self.recordMatchCoverage(scrut: scrut, arms: arms)
        val semanticIndex = try self.semanticMatchIndex(ownerFnIdx: self.cur.checkFn, matchSource: matchSource)
        if semanticIndex < self.decls.semanticMatches.count() {
            val fact = self.decls.semanticMatches[semanticIndex]
            mut val selectedArms = fact.arms
            index = 0U64
            while index < selectedArms.count() {
                mut val selected = selectedArms[index]
                selected.isReachable = !self.unreachableMatchArms.contains(arms.start + index)
                selectedArms.set(i: index, value: selected)
                index += 1U64
            }
            try self.putSemanticMatch(fact: <SemanticMatch isConsuming=fact.isConsuming ownerFnIdx=fact.ownerFnIdx matchSource=fact.matchSource scrutineeTerm=fact.scrutineeTerm kind=fact.kind arms=selectedArms />)
        }
        return <Result.Ok value=() />
    }

    // Extend the success environment only. The caller restores its mark before
    // visiting the single failure continuation.
    inout fn recordConditionClauses(conditions: ConditionClauseRange) -> Result[(), CompileDiagnostic] {
        mut val index = 0U64
        while index < conditions.len {
            val clause = self.conditionClauseAt(conditions: conditions, index: index)
            try self.recordExpr(exprId: clause.value)
            if clause.isBinding {
                try self.checkEnumPatternSubject(scrut: clause.value, pattern: clause.pattern)
                try self.checkPatternBinds(a: clause.pattern)
                val wildcard = <PatInfo isWildcard=true enumStart=0U64 enumLen=0U64 variantStart=0U64 variantLen=0U64 binds=<BindRange start=0U64 len=0U64 /> isStruct=false />
                try self.recordSemanticPatterns(matchSource: <MatchSource.Condition clauseIndex=conditions.start + index />, scrut: clause.value, arms: [clause.pattern, wildcard])
                try self.scanAddPatternBinds(a: clause.pattern, scrutTi: self.semanticExprTypeInfo(exprId: clause.value))
            }
            index += 1U64
        }
        return <Result.Ok value=() />
    }

    inout fn recordStructPattern(matchSource: MatchSource, isConsuming: Bool, scrutineeTerm: U64, layoutReceiver: U64, arms: Array[PatInfo]) -> Result[(), CompileDiagnostic] {
        val storage: U64 = self.fieldStorageTypeRef(receiverRef: layoutReceiver)
        if storage == 0U64 || storage >= self.arena.typeCount() { return <Result.Ok value=() /> }
        val declaration: TypeRef = self.arena.typeAt(index: storage)
        val structIndex: U64 = self.structIndexForType(ref: storage)
        if !declaration.isRecord && structIndex >= self.arena.structCount() { return <Result.Ok value=() /> }
        mut val fieldCount: U64 = declaration.recordFieldTerms.count()
        if !declaration.isRecord { fieldCount = self.arena.structAt(index: structIndex).fields.count() }
        mut val selectedArms: Array[SemanticMatchArm] = []
        mut val armIndex: U64 = 0U64
        while armIndex < arms.count() {
            val arm: PatInfo = arms[armIndex]
            if !arm.isStruct && !arm.isWildcard && !arm.isValuePattern { return <Result.Ok value=() /> }
            mut val payloads: Array[SemanticMatchPayload] = []
            mut val bindIndex: U64 = 0U64
            while !arm.isWildcard && bindIndex < arm.binds.len {
                val bind: Bind = self.bindAt(binds: arm.binds, index: bindIndex)
                if bind.nameLen != 0U64 {
                    val fieldIndex: U64 = self.fieldIndexOfReceiver(receiverRef: storage, fieldStart: bind.fieldStart, fieldLen: bind.fieldLen)
                    if fieldIndex >= fieldCount { return <Result.Ok value=() /> }
                    val fieldTerm: U64 = (try self.fieldTypeRefOfReceiver(receiverRef: storage, fieldStart: bind.fieldStart, fieldLen: bind.fieldLen))
                    if fieldTerm == 0U64 { return <Result.Ok value=() /> }
                    mut val isBoxed: Bool = false
                    if !declaration.isRecord { isBoxed = self.fieldIsBoxed(f: self.arena.structFieldAt(structIndex: structIndex, fieldIndex: fieldIndex)) }
                    payloads.append(<SemanticMatchPayload bindTarget=bind.nameStart fieldIndex=fieldIndex fieldTerm=fieldTerm isBoxed=isBoxed />)
                }
                bindIndex += 1U64
            }
            selectedArms.append(<SemanticMatchArm hasValueTest=arm.isValuePattern testExpr=arm.testExpr captureTarget=arm.captureStart hasCapture=arm.captureLen != 0U64 payloads=payloads />)
            armIndex += 1U64
        }
        try self.putSemanticMatch(fact: <SemanticMatch isConsuming=isConsuming ownerFnIdx=self.cur.checkFn matchSource=matchSource scrutineeTerm=scrutineeTerm kind=<SemanticMatchKind.Struct layoutTerm=storage /> arms=selectedArms />)
        return <Result.Ok value=() />
    }

    inout fn recordSemanticPatterns(matchSource: MatchSource, scrut: U64, arms: Array[PatInfo]) -> Result[(), CompileDiagnostic] {
        if !(self.cur.recordCallTemplates) { return <Result.Ok value=() /> }
        val scrutineeTerm: U64 = self.parametricExprTerm(exprId: scrut)
        if scrutineeTerm == 0U64 || scrutineeTerm >= self.arena.typeCount() { return <Result.Ok value=() /> }
        mut val onlyValuePatterns: Bool = arms.count() > 0U64
        mut val valueArms: Array[SemanticMatchArm] = []
        mut val valueIndex: U64 = 0U64
        while valueIndex < arms.count() {
            val arm = arms[valueIndex]
            if (!arm.isWildcard && !arm.isValuePattern) || arm.binds.len != 0U64 { onlyValuePatterns = false }
            valueArms.append(<SemanticMatchArm hasValueTest=arm.isValuePattern testExpr=arm.testExpr captureTarget=arm.captureStart hasCapture=arm.captureLen != 0U64 />)
            valueIndex += 1U64
        }
        if onlyValuePatterns {
            try self.putSemanticMatch(fact: <SemanticMatch isConsuming=self.matchConsumesValue(scrut: scrut, typeTerm: scrutineeTerm) ownerFnIdx=self.cur.checkFn matchSource=matchSource scrutineeTerm=scrutineeTerm kind=<SemanticMatchKind.Value /> arms=valueArms />)
            return <Result.Ok value=() />
        }
        // Patterns select the lexical declaration's shape, while the match
        // fact retains the original value type for BodyInstance grounding.
        val layoutReceiver: U64 = self.lexicalLayoutReceiver(receiverTerm: scrutineeTerm)
        val enumIndex: U64 = self.enumIndexForType(ref: layoutReceiver)
        if enumIndex >= self.arena.enumCount() {
            try self.recordStructPattern(matchSource: matchSource, isConsuming: self.matchScrutIsMove(scrut: scrut), scrutineeTerm: scrutineeTerm, layoutReceiver: layoutReceiver, arms: arms)
            return <Result.Ok value=() />
        }
        mut val selectedArms: Array[SemanticMatchArm] = []
        mut val armIndex: U64 = 0U64
        while armIndex < arms.count() {
            val arm: PatInfo = arms[armIndex]
            if arm.isStruct { return <Result.Ok value=() /> }
            if arm.isValuePattern {
                selectedArms.append(<SemanticMatchArm hasValueTest=true testExpr=arm.testExpr />)
            } else if arm.isWildcard {
                selectedArms.append(<SemanticMatchArm captureTarget=arm.captureStart hasCapture=arm.captureLen != 0U64 />)
            } else {
                val variantIndex: U64 = self.variantIndexInDeclaration(enumIndex: enumIndex, nameStart: arm.variantStart, nameLen: arm.variantLen)
                if variantIndex >= self.arena.enumAt(index: enumIndex).variants.count() { return <Result.Ok value=() /> }
                val fields: Array[FieldDef] = self.arena.enumVariantAt(enumIndex: enumIndex, variantIndex: variantIndex).fields
                mut val payloads: Array[SemanticMatchPayload] = []
                // Keep every active field in declaration order. Pattern spelling
                // chooses a binding or discard, never the destruction order.
                mut val fieldIndex: U64 = 0U64
                while fieldIndex < fields.count() {
                    mut val bindTarget: U64 = 0U64
                    mut val isDiscard: Bool = true
                    mut val bindIndex: U64 = 0U64
                    while bindIndex < arm.binds.len {
                        val bind: Bind = self.bindAt(binds: arm.binds, index: bindIndex)
                        val fieldName: U64 = intern(c: inout self, start: bind.fieldStart, len: bind.fieldLen)
                        if fields[fieldIndex].nameId == fieldName {
                            isDiscard = bind.nameLen == 0U64
                            if !isDiscard { bindTarget = bind.nameStart }
                            break
                        }
                        bindIndex += 1U64
                    }
                    val fieldTerm: U64 = (try self.aggregateSlotTypeRef(resultRef: layoutReceiver, isEnum: true, isArrayLiteral: false, variantIndex: variantIndex, fieldIndex: fieldIndex))
                    if fieldTerm == 0U64 { return <Result.Ok value=() /> }
                    payloads.append(<SemanticMatchPayload isDiscard=isDiscard bindTarget=bindTarget fieldIndex=fieldIndex fieldTerm=fieldTerm isBoxed=self.fieldIsBoxed(f: fields[fieldIndex]) />)
                    fieldIndex += 1U64
                }
                selectedArms.append(<SemanticMatchArm hasVariant=true variantIndex=variantIndex payloads=payloads />)
            }
            armIndex += 1U64
        }
        try self.putSemanticMatch(fact: <SemanticMatch isConsuming=self.matchConsumesValue(scrut: scrut, typeTerm: scrutineeTerm) ownerFnIdx=self.cur.checkFn matchSource=matchSource scrutineeTerm=scrutineeTerm kind=<SemanticMatchKind.Enum enumIndex=enumIndex /> arms=selectedArms />)
        return <Result.Ok value=() />
    }

    // Expected-result refinement publishes the block fact before its parent
    // reads it. A reader must not reopen a lexical give in a different scope.
    inout fn recordValueBlockResult(exprId: U64, blockId: U64) -> Bool {
        if blockId >= self.arena.semanticValueBlocks.count() { return false }
        match self.arena.semanticValueBlocks[blockId] {
            SemanticValueBlockTyping.Pending => { return false }
            SemanticValueBlockTyping.Checked(val completion, val resultTerm) => {
                if !completion.source.normal() || resultTerm == 0U64 { return false }
                self.recordSemanticExprTerm(exprId: exprId, term: resultTerm)
                return true
            }
        }
    }

    // Check and publish a block result while its local and pattern bindings
    // are still in scope. All value-control forms share this boundary.
    inout fn recordValueBlock(exprId: U64, blockId: U64, expectedTerm: U64) -> Result[(), CompileDiagnostic] {
        val mark = self.scopeMark()
        mut val resultTerm = expectedTerm
        if resultTerm == 0U64 { resultTerm = self.semanticExprTerm(exprId: exprId) }
        val completion = try self.recordBlockContents(blkId: blockId, resultContext: <BlockResultContext.Value expectedTerm=resultTerm />)
        if completion.source.normal() {
            val value = self.blockGiveExpr(blkId: blockId)
            if value < self.arena.exprs.count() {
                if resultTerm == 0U64 {
                    resultTerm = self.parametricExprTerm(exprId: value)
                }
                self.recordSemanticExprTerm(exprId: exprId, term: resultTerm)
            }
        }
        while self.arena.semanticValueBlocks.count() <= blockId { self.arena.semanticValueBlocks.append(<SemanticValueBlockTyping.Pending />) }
        if !completion.source.normal() { resultTerm = 0U64 }
        self.arena.semanticValueBlocks.set(i: blockId, value: <SemanticValueBlockTyping.Checked completion=completion resultTerm=resultTerm />)
        self.popLocals(mark: mark)
        return <Result.Ok value=() />
    }

    // `readExpr` is a synthetic Index.index call made by Lower.  The candidate
    // lets Record connect that value read back to its storage path without
    // asking a later phase to infer anything from a method name or collection
    // spelling.
    inout fn accessCandidateIndex(readExpr: U64) -> U64 {
        val candidate = self.decls.accessCandidateForExpr(exprId: readExpr)
        if candidate < self.decls.accessCandidateCount() { return candidate }
        // A selected inout use may project a field from an indexed value
        // (`items[i].field.append(...)`). The field is not a second storage
        // candidate: it retains the exact candidate underneath it, while the
        // access-use record carries the full projected expression separately.
        // Peel only representation-neutral wrappers; no member/type lookup is
        // reopened here, and an unrelated expression remains non-candidate.
        if readExpr < self.arena.exprs.count() {
            match self.arena.exprs[readExpr] {
                Expr.Field(base: val base, nameStart: _, nameLen: _) => { return self.accessCandidateIndex(readExpr: base) }
                Expr.Cast(operand: val operand, tyStart: _, tyLen: _, ty: _) => { return self.accessCandidateIndex(readExpr: operand) }
                Expr.ExtView(recv: val recv, source: _, strip: _) => { return self.accessCandidateIndex(readExpr: recv) }
                _ => {}
            }
        }
        return self.decls.accessCandidateCount()
    }

    // Record one selected call's relationship to an indexed access candidate.
    // This is available only in the final Record walk, so the ABI mode comes
    // from the selected declaration rather than a Lower-time name heuristic.
    inout fn recordAccessUse(parentExpr: U64, readExpr: U64, role: U64, argIndex: U64, parameterIndex: U64, modeKnown: Bool, write: Bool) -> Result[(), CompileDiagnostic] {
        if !(self.cur.recordCallTemplates) { return <Result.Ok value=() /> }
        val candidateIndex: U64 = self.accessCandidateIndex(readExpr: readExpr)
        if candidateIndex >= self.decls.accessCandidateCount() { return <Result.Ok value=() /> }
        val parent: CallSiteKey = (try self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: parentExpr))
        mut val i: U64 = 0U64
        while i < self.decls.accessUses.count() {
            val prior: AccessUse = self.decls.accessUses[i]
            if prior.candidateIndex == candidateIndex && prior.role == role && prior.argIndex == argIndex && self.sameCallSiteKey(a: prior.parent, b: parent) {
                self.decls.accessUses.set(i: i, value: <AccessUse candidateIndex=candidateIndex accessExpr=readExpr parent=parent role=role argIndex=argIndex parameterIndex=parameterIndex modeKnown=modeKnown write=write />)
                return <Result.Ok value=() />
            }
            i += 1U64
        }
        self.decls.accessUses.append(<AccessUse candidateIndex=candidateIndex accessExpr=readExpr parent=parent role=role argIndex=argIndex parameterIndex=parameterIndex modeKnown=modeKnown write=write />)
        return <Result.Ok value=() />
    }

    // Argument access provenance is independent of free/method call syntax.
    // The selected declaration owns the parameter mapping and write mode;
    // unresolved modes remain explicit until finalization.
    inout fn recordArgumentAccessUses(parentExpr: U64, callee: U64, args: ArgRange) -> Result[(), CompileDiagnostic] {
        mut val accessArg: U64 = 0U64
        while accessArg < args.len {
            val arg: Arg = self.argAt(args: args, index: accessArg)
            if arg.isInout {
                // The source marker says that the author requests an
                // access, not which ABI slot it occupies.  Preserve
                // the selected parameter mapping here: defaults and
                // labels can make source argument order differ from
                // the declaration order, and only that declaration
                // owns the final `isInout` mode.
                mut val accessWrite: Bool = false
                mut val paramIndex: U64 = args.len
                if callee < self.arena.functionCount() {
                    val selected: Func = self.arena.functionAt(index: callee)
                    paramIndex = self.paramIndexForArg(params: selected.params, args: args, argIdx: accessArg)
                    if paramIndex < selected.params.count() {
                        accessWrite = self.funcParamAt(params: selected.params, index: paramIndex).isInout
                    }
                }
                try self.recordAccessUse(parentExpr: parentExpr, readExpr: arg.expr, role: 2U64, argIndex: accessArg, parameterIndex: paramIndex, modeKnown: callee < self.arena.functionCount(), write: accessWrite)
                // An explicit `inout rows[i]` owns the same detached
                // get-modify-set write facet as an inout method
                // receiver.  Record it at this producer boundary while
                // the selected ABI still says that writeback occurs;
                // Mono may then close the frozen setter call without
                // reopening the authored Index expression.
                if accessWrite {
                    try self.recordAccessWriteFacet(readExpr: arg.expr)
                }
            }
            accessArg += 1U64
        }
        return <Result.Ok value=() />
    }

    // Record the detached IndexSet facet under exactly the same lexical
    // Record context as its Index read. The write node is a semantic template
    // only: its second argument is the read result as a type anchor and Mid
    // will later replace that value with a materialized mutable temporary.
    // The guard prevents `write(value: read())` from recursively re-entering
    // this routine while it records its anchor child.
    inout fn recordAccessWriteFacet(readExpr: U64) -> Result[(), CompileDiagnostic] {
        if self.cur.recordingAccessWriteFacet { return <Result.Ok value=() /> }
        val candidateIndex: U64 = self.accessCandidateIndex(readExpr: readExpr)
        if candidateIndex >= self.decls.accessCandidateCount() { return <Result.Ok value=() /> }
        val writeExpr: U64 = self.decls.accessCandidateAt(index: candidateIndex).writeExpr
        if writeExpr >= self.arena.exprs.count() { return <Result.Ok value=() /> }
        self.cur.recordingAccessWriteFacet = true
        try self.recordExpr(exprId: writeExpr)
        self.cur.recordingAccessWriteFacet = false
        return <Result.Ok value=() />
    }

    // Declaration layout selection is separate from the value's lexical type.
    // Keep Self in operand/signature facts so each BodyInstance can substitute
    // its nominal receiver, including an inherited newtype receiver.
    inout fn lexicalLayoutReceiver(receiverTerm: U64) -> U64 {
        // A bare lexical Self selects the declaration's field layout. Keep
        // the parameter and expression type unchanged: executable bodies use
        // the original receiver and adapters carry the inherited boundary.
        // In particular, do not rewrite Self inside Array[Self] or records.
        mut val layoutReceiver: U64 = receiverTerm
        if receiverTerm != 0U64 && receiverTerm < self.arena.typeCount() {
            val term = self.arena.typeAt(index: receiverTerm)
            if !term.isRecord && !term.isAny && term.args.count() == 0U64 && term.assocNameId == 0U64 {
                layoutReceiver = self.groundTermInEnvironment(ref: receiverTerm, params: [], values: [], selfRef: self.cur.selfRef, itemRef: 0U64)
            }
        }
        return layoutReceiver
    }

    // Field and Arrow share the same declaration-time selection. Arrow's
    // receiver term is its pointee; Mid must not repeat this layout lookup.
    inout fn recordFieldSelection(exprId: U64, receiverTerm: U64, nameStart: U64, nameLen: U64) -> Result[(), CompileDiagnostic] {
        val layoutReceiver: U64 = self.lexicalLayoutReceiver(receiverTerm: receiverTerm)
        val storageRef: U64 = self.fieldStorageTypeRef(receiverRef: layoutReceiver)
        val fieldTerm: U64 = (try self.fieldTypeRefOfReceiver(receiverRef: storageRef, fieldStart: nameStart, fieldLen: nameLen))
        if fieldTerm != 0U64 {
            self.recordSemanticExprTerm(exprId: exprId, term: fieldTerm)
            val fieldIndex: U64 = self.fieldIndexOfReceiver(receiverRef: storageRef, fieldStart: nameStart, fieldLen: nameLen)
            val receiver: TypeRef = self.arena.typeAt(index: storageRef)
            mut val isBoxed: Bool = false
            mut val fieldCount: U64 = receiver.recordFieldTerms.count()
            if !receiver.isRecord {
                val structIndex: U64 = self.structIndexForType(ref: storageRef)
                if structIndex < self.arena.structCount() {
                    fieldCount = self.arena.structAt(index: structIndex).fields.count()
                    if fieldIndex < fieldCount { isBoxed = self.fieldIsBoxed(f: self.arena.structFieldAt(structIndex: structIndex, fieldIndex: fieldIndex)) }
                }
            }
            if fieldIndex < fieldCount {
                self.recordSemanticExprFieldProjection(exprId: exprId, index: fieldIndex, isBoxed: isBoxed)
            }
        }
        return <Result.Ok value=() />
    }

    // Bidirectional values can be conditional results, not only direct
    // arguments. Defer their bodies until the consumer supplies a type.
    // Inference may read partial function annotations without checking bodies.
    inout fn expressionNeedsTypeContext(exprId: U64, allowPartialFunction: Bool = false) -> Bool {
        if exprId >= self.arena.exprs.count() { return false }
        if self.pendingConstructionContexts.contains(exprId) { return true }
        match self.arena.exprs[exprId] {
            Expr.Dictionary(entries: _) => { return true }
            Expr.Closure(val params, val hasRet, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _, isDiverging: val diverging) => {
                if allowPartialFunction || self.semanticExprTerm(exprId: exprId) != 0U64 { return false }
                if !hasRet && !diverging { return true }
                for parameter in params { if parameter.ty == 0U64 { return true } }
            }
            _ => {}
        }
        match self.arena.exprs[exprId] {
            Expr.Block(val body, offset: _) => { return self.expressionNeedsTypeContext(exprId: self.blockGiveExpr(blkId: body), allowPartialFunction: allowPartialFunction) }
            Expr.IfChain(conditions: _, val thenBlk, val elseBlk) | Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
                return self.expressionNeedsTypeContext(exprId: self.blockGiveExpr(blkId: thenBlk), allowPartialFunction: allowPartialFunction) || self.expressionNeedsTypeContext(exprId: self.blockGiveExpr(blkId: elseBlk), allowPartialFunction: allowPartialFunction)
            }
            Expr.MatchExpr(scrut: _, val arms) => {
                mut val index = 0U64
                while index < arms.len {
                    if self.expressionNeedsTypeContext(exprId: self.blockGiveExpr(blkId: self.matchArmAt(arms: arms, index: index).body), allowPartialFunction: allowPartialFunction) { return true }
                    index += 1U64
                }
            }
            Expr.Make(typeStart: _, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, val fields) => {
                // A nominal constructor/factory owns the context for its
                // arguments. Only an untyped structural record propagates its
                // children's demand to the surrounding expression.
                if isEnum || typeLen != 0U64 { return false }
                mut val index = 0U64
                while index < fields.len {
                    if self.expressionNeedsTypeContext(exprId: self.makeFieldAt(fields: fields, index: index).value, allowPartialFunction: allowPartialFunction) { return true }
                    index += 1U64
                }
            }
            Expr.Array(val elems) => {
                mut val index = 0U64
                while index < elems.len {
                    if self.expressionNeedsTypeContext(exprId: self.exprAt(exprs: elems, index: index), allowPartialFunction: allowPartialFunction) { return true }
                    index += 1U64
                }
            }
            _ => {}
        }
        return false
    }

    // All statically selected method surfaces use the same argument context.
    inout fn recordSelectedMethodArguments(callee: U64, receiverTerm: U64, args: ArgRange, chainHoleRef: U64, useOffset: U64) -> Result[(), CompileDiagnostic] {
        if callee < self.arena.functionCount() {
            val selectedMethod: Func = self.arena.functionAt(index: callee)
            try self.checkMethodVis(ownerStart: selectedMethod.recvStart, ownerLen: selectedMethod.recvLen, mf: selectedMethod, offset: useOffset)
            mut val mk: U64 = 0U64
            while mk < args.len {
                val parameterIndex: U64 = self.paramIndexForArg(params: selectedMethod.params, args: args, argIdx: mk)
                if parameterIndex < selectedMethod.params.count() {
                    val parameter: Param = self.funcParamAt(params: selectedMethod.params, index: parameterIndex)
                    val mctx: U64 = (try self.groundFinalMethodParameter(f: selectedMethod, recvTy: self.typeInfoOfRef(ref: receiverTerm), args: args, parameterTerm: parameter.ty))
                    val argumentExpr: U64 = self.argAt(args: args, index: mk).expr
                    if mctx != 0U64 && self.expressionNeedsTypeContext(exprId: argumentExpr) { try self.recordExpr(exprId: argumentExpr, chainHoleRef: chainHoleRef, expectedTerm: mctx) }
                    if mctx != 0U64 && (try self.tyRefIsGround(ref: mctx)) {
                        val parameterType: TypeInfo = self.typeInfoOfRef(ref: mctx)
                        try self.checkLitSpanCtx(id: argumentExpr, tyStart: parameterType.nameStart, tyLen: parameterType.nameLen, isArray: parameterType.kind == 3, ctxRef: mctx)
                        try self.recordSemanticExprExpectedResult(exprId: argumentExpr, expectedTerm: mctx)
                        try self.tcCheckValue(expectedRef: mctx, valueExpr: argumentExpr, pos: "arg")
                    }
                }
                mk += 1U64
            }
        }
        return <Result.Ok value=() />
    }

    // Record an expression under an optional-chain payload supplied by its
    // unique enclosing chain stage. The payload is a structural child input,
    // not Cursor state: ordinary expressions use 0, and every continuation
    // descendant receives the same explicit parametric term.
    inout fn recordExpr(exprId: U64, chainHoleRef: U64 = 0U64, expectedTerm: U64 = 0U64, deferContext: Bool = false, needsValue: Bool = true) -> Result[(), CompileDiagnostic] {
        // Normalize at the context boundary before inspecting expression shape.
        mut val normalizedContext = expectedTerm
        if self.typeTermContainsAssociatedProjection(ref: normalizedContext) {
            normalizedContext = try self.normalizedValueType(ref: normalizedContext)
        }
        // A deferred value block must be recorded again in its lexical scope
        // once the selected parameter supplies its result context.
        if normalizedContext == 0U64 && deferContext && self.expressionNeedsTypeContext(exprId: exprId) {
            if needsValue { try self.requireExpressionValue(exprId: exprId) }
            return <Result.Ok value=() />
        }
        match self.arena.exprs[exprId] {
            Expr.Range(val rangeTy, val endpoints) => {
                val head = self.arena.typeAt(index: rangeTy)
                val start = self.internBytes(s: "start")
                val end = self.internBytes(s: "end")
                val offset = self.exprOffset(id: exprId)
                val fields: Array[MakeField] = [
                    <MakeField nameStart=start.nameStart nameLen=start.nameLen value=self.exprAt(exprs: endpoints, index: 0U64) offset=offset />,
                    <MakeField nameStart=end.nameStart nameLen=end.nameLen value=self.exprAt(exprs: endpoints, index: 1U64) offset=offset />
                ]
                self.arena.exprs.set(i: exprId, value: <Expr.Make typeStart=head.nameStart typeLen=head.nameLen variantStart=0U64 variantLen=0U64 isEnum=false ty=rangeTy fields=self.pushMakeFields(fields: fields) />)
            }

            Expr.Dictionary(val entries) => {
                if !self.hasDictionaryLiteralContext(ctxRef: normalizedContext) {
                    return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "cannot infer the type of a dictionary literal; annotate the binding (`: Dictionary[K, V]`)") />
                }
                mut val keys: Array[U64] = []
                mut val values: Array[U64] = []
                mut val index = 0U64
                while index < entries.len {
                    keys.append(self.exprAt(exprs: entries, index: index))
                    values.append(self.exprAt(exprs: entries, index: index + 1U64))
                    index += 2U64
                }
                val expanded = try self.elaborateDictionaryValues(keys: keys, vals: values, ctxRef: normalizedContext, span: <Span start=self.exprOffset(id: exprId) end=self.arena.exprSpanEnd[exprId] />)
                self.arena.exprs.set(i: exprId, value: self.arena.exprs[expanded])
            }
            _ => {}
        }
        if self.pendingConstructionContexts.contains(exprId) {
            val context = (try self.requireConstructionContext(ctxRef: normalizedContext, offset: self.exprOffset(id: exprId)))
            try self.resolveConstructionContext(exprId: exprId, context: context)
        }
        if !self.genMode {
            if exprId < self.sourceExpressionLimit { try self.checkExpressionVisibility(exprId: exprId) }
            match self.expressionTypeUses.get(key: exprId) {
                Optional.Some(v: val uses) => { try self.checkSourceTypeUses(types: uses) }
                Optional.None => {}
            }
        }
        // Recording owns its destination slot. Parent expressions can be
        // newer than every child; type publication must not depend on an
        // unrelated expression having already extended this table.
        self.ensureExprTySlot(exprId: exprId)
        self.ensureSemanticExprType(exprId: exprId)
        // This full lexical semantic walk is observable only in phase tracing.
        // Reuse the existing transient work counter so normal compilation gains
        // neither stored state nor a second diagnostic traversal.
        if self.tracePhases {
            self.traceExprInstScans += 1U64
        }
        // Structural forms write their TypeTerm below.  The legacy TypeInfo
        // adapter is intentionally a post-order fallback: computing it first
        // recursively reopens children whose semantic producer has already
        // written the exact term.  This keeps type recovery a compatibility
        // boundary rather than the universal source of semantic truth.
        try self.prepareInterpolationWrite(exprId: exprId)
        try self.prepareFactoryConstruction(exprId: exprId, chainHoleRef: chainHoleRef)
        match self.arena.exprs[exprId] {
            // These literals have a type fixed by their own spelling.  Record
            // it as a TypeTerm directly instead of routing through TypeInfo;
            // only an unsuffixed integer remains context-polymorphic.
            Expr.Int(value: _, offset: _, val isBool, val tyStart, val tyLen, isNeg: _) => {
                if isBool {
                    val boolName: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen))
                } else if tyLen != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: tyStart, nameLen: tyLen))
                }
            }
            Expr.Float(start: _, len: _, val tyStart, val tyLen) => {
                if tyLen != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: tyStart, nameLen: tyLen))
                } else {
                    val floatName: Bind = self.kwSpan(kw: "F64", kwLen: 3U64)
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: floatName.nameStart, nameLen: floatName.nameLen))
                }
            }
            Expr.Str(start: _, len: _) => {
                val stringName: Bind = self.kwSpan(kw: "String", kwLen: 6U64)
                self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: stringName.nameStart, nameLen: stringName.nameLen))
            }
            // A local binding's declared TypeRef is the lexical source of
            // truth for an identifier. Record it directly after the legacy
            // adapter so a parametric annotation (`Optional[Box[T]]`) cannot
            // be collapsed to its head spelling by TypeInfo recovery.
            Expr.Ident(val start, val len) => {
                // Record owns the complete lexical walk, including generic
                // closure bodies that the declaration checker does not enter.
                val binding: I64 = self.recordIdent(id: exprId, start: start, len: len, tpFn: self.cur.checkFn)
                if binding == identUndefCode() { try self.checkIdentifierValueBinding(binding: binding, offset: start) }
                // `self` is the receiver's declaration-time TypeTerm, not an
                // ordinary local. Recording that lexical source is what lets
                // a structural projection such as `self.items` retain
                // `Array[T]`, so a following `.set(...)` can publish one
                // parametric CallTemplate. Falling back to `typeOf` here
                // loses the receiver argument and forces Mono to reopen AST.
                if self.isSelfRef(start: start, len: len) && self.cur.selfRef != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: self.cur.selfRef)
                }
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    try self.recordDeclarationCapture(localIndex: localIdx)
                    val local: Local = (try self.typedLocal(index: localIdx))
                    if local.ty != 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: local.ty)
                    }
                }
            }
            Expr.MatchSubject(val scrut) => { self.recordSemanticExprTerm(exprId: exprId, term: self.parametricExprTerm(exprId: scrut)) }
            Expr.Unary(val op, val operand) => {
                try self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef)
                val operandTerm = self.parametricExprTerm(exprId: operand)
                if operandTerm != 0U64 {
                    val result = try self.unaryOperatorResultType(operand: self.typeInfoOfRef(ref: operandTerm), op: op)
                    self.recordSemanticExprInfo(exprId: exprId, ti: result)
                }
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                try self.recordExpr(exprId: lhs, chainHoleRef: chainHoleRef)
                try self.recordExpr(exprId: rhs, chainHoleRef: chainHoleRef)
                if isBinTraitOp(op: op) || op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                    val contextual = (try self.recordFloatingOperandContext(lhs: lhs, rhs: rhs))
                    if contextual && isBinTraitOp(op: op) {
                        val left = self.typeInfoOfRef(ref: self.parametricExprTerm(exprId: lhs))
                        val right = self.typeInfoOfRef(ref: self.parametricExprTerm(exprId: rhs))
                        self.recordSemanticExprInfo(exprId: exprId, ti: (try self.operatorOutputType(lt: left, rt: right, op: op)))
                    }
                }
            }
            Expr.Call(nameStart: val callStart, nameLen: val callLen, args: val args) => {
                mut val i: U64 = 0
                while i < args.len {
                    try self.recordExpr(exprId: self.argAt(args: args, index: i).expr, chainHoleRef: chainHoleRef, deferContext: true)
                    i += 1
                }
                // `pow(base:, exp:)` has free-call syntax but is a static
                // associated member selected from its first argument's
                // conformance.  Record it through the same CallTemplate
                // producers as every other static call; Mono must not reopen
                // the spelling and rediscover its witness.
                mut val cfi: U64 = self.arena.functionCount()
                if rangeEquals(bytes: self.arena.bytes, start: callStart, len: callLen, kw: "pow") && args.len == 2U64 {
                    val baseExpr: U64 = self.argAt(args: args, index: 0U64).expr
                    val baseTerm: U64 = self.parametricExprTerm(exprId: baseExpr)
                    if baseTerm != 0U64 && baseTerm < self.arena.typeCount() {
                        val baseReceiver: CallTemplateReceiver = (try self.directReceiverTemplateForExpr(exprId: baseExpr))
                        val resolution: StaticMemberResolution = (try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: baseTerm, nameStart: callStart, nameLen: callLen, args: args, requiredTraitOwner: self.syntheticRequiredTraitOwner(exprId: exprId)))
                        match resolution {
                            StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                                try self.recordStaticMethodTemplate(exprId: exprId, receiverTerm: baseTerm, receiver: baseReceiver, args: args, resolution: resolution, resultTerm: (try self.staticRequirementCallResultType(resolution: resolution, args: args)))
                                return <Result.Ok value=() />
                            }
                            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {
                                try self.recordStaticMethodTemplate(exprId: exprId, receiverTerm: baseTerm, receiver: baseReceiver, args: args, resolution: resolution, resultTerm: self.parametricExprTerm(exprId: exprId))
                                return <Result.Ok value=() />
                            }
                            _ => {}
                        }
                        cfi = (try self.resolveAssocForResolvedReceiver(surfaceRef: baseTerm, sourceId: 0U64, sourceOwner: 0U64, nameStart: callStart, nameLen: callLen, args: args, useOffset: self.exprOffset(id: exprId)))
                        if cfi < self.arena.functionCount() {
                            try self.recordParametricMethodCall(exprId: exprId, callee: cfi, receiverSource: baseReceiver, receiverTerm: baseTerm, args: args)
                            return <Result.Ok value=() />
                        }
                    }
                }
                cfi = (try self.resolvedCallee(id: exprId))
                if cfi < self.arena.functionCount() {
                    val cf: Func = self.arena.functionAt(index: cfi)
                    val ps: Array[Param] = self.copyFuncParams(params: cf.params)
                    // A complete substitution may contain caller-owned symbolic
                    // terms. These are valid context in a generic declaration;
                    // only unresolved callee binders must stay out of the body.
                    val parameterEnvironment = try self.freeCallParameterEnvironment(f: cf, args: args)
                    val canSubstitute = cf.typeParams.count() == 0U64 || parameterEnvironment.args.count() == cf.typeParams.count()
                    mut val k: U64 = 0
                    while k < args.len {
                        val parameterIndex = self.paramIndexForArg(params: cf.params, args: args, argIdx: k)
                        if parameterIndex < ps.count() {
