// Part of name/type resolution (root: _.pw): typed-IR parametric-type
// recording (rustc writeback analog) — a DEDICATED, check-free walk over every
// function body that stores each expression's PARAMETRIC type in
// Comp.semanticExprTypes (type params left as `T`, trait `self` left as `Self`).
// The backend substitutes the instance's type args at read time (groundedTypeOf
// -> groundTypeRef), so one recording serves every instantiation.
//
// Why a separate pass (and not a hook inside checkGenericBodies / verify):
// recording needs an ENV the check passes must not have — a parametric
// `self` ref (`Dictionary[K,V]`) and coverage of non-generic bodies — and
// setting that env inside a check pass changes what the checks see (measured:
// reject tests started accepting). This walk runs exprType/typeOf only
// (read-only type recovery), never a compileErrorAt-carrying check.
//
// Body sharing is the reason the store is parametric: a generic template's one
// body is emitted per instance, and a trait provided method's body is SHARED by
// every conformer copy (instantiateProvidedMethods reuses `f.body`). Recording a
// concrete type would be wrong for every other instance — so copies
// (srcTraitId != 0) are skipped and the template records `Self`/`T` forms that
// ground differently under each instance env.
//
// Known holes (recorded as 0 -> groundedTypeOf falls back to typeCache/typeOf):
// backend-synthesized exprs (async lowering), generic struct field-default
// exprs, and any node this walk cannot scope (they surface in the Task-#3
// shadow and are closed there).

pub impl Comp {

    inout fn syntheticCallReceiverTerm(exprId: U64, fallback: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.syntheticCallSites.count() {
            val site: SyntheticCallSite = self.decls.syntheticCallSites[i]
            if site.exprId == exprId && site.receiverTerm != 0U64 { return site.receiverTerm }
            i += 1U64
        }
        return fallback
    }

    // Preserve an expression's semantic type source without placing a call
    // result inside TypeTerm. A written call is identified by its template key;
    // every other expression is an ordinary parametric term.
    inout fn semanticTypeRecipeForExpr(exprId: U64) -> U64 {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=exprId callSite=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />)
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=exprId callSite=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />)
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=exprId callSite=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />)
            }
            _ => {}
        }
        return self.semanticTypeRecipeTerm(term: self.parametricExprTerm(exprId: exprId))
    }

    // The source-level `for` binding is the payload of the selected `next()`
    // result. This is the desugaring's actual semantic boundary: it preserves
    // a static Iterator proof and an existential requirement witness through
    // the same immutable CallResolution, without a second trait lookup.
    // Recording it on Decls makes it survive fresh local scopes.
    inout fn recordForItemTypeRecipe(stmtId: U64) {
        val next: U64 = self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=stmtId siteIsStmt=true callSite=self.templateProtocolSiteKey(fnIdx: self.cur.checkFn, stmtId: stmtId, slot: 2U64) />)
        val item: U64 = self.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=4U64 input=next />)
        self.decls.forTypeRecipes.append(<ForTypeRecipe stmtId=stmtId itemRecipe=item />)
    }

    // `for` protocol slot 1 consumes an iterable value. When that value is a
    // written call, its precise concrete receiver is the completed result of
    // that call under the active BodyInstance — not the call's declaration-time
    // result term, which can intentionally retain `Self`/`Item`. Record the
    // semantic dependency by CallSiteKey; ExprId is merely lookup navigation.
    inout fn protocolReceiverTemplateForExpr(exprId: U64) -> CallTemplateReceiver {
        match self.arena.exprs[exprId] {
            Expr.Call(nameStart: _, nameLen: _, args: _) => {
                return <CallTemplateReceiver.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                return <CallTemplateReceiver.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => {
                return <CallTemplateReceiver.PriorCallResult exprId=exprId siteKey=self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: exprId) />
            }
            _ => {}
        }
        return <CallTemplateReceiver.Term term=self.parametricExprTerm(exprId: exprId) />
    }

    // Written direct methods have exactly the same receiver provenance as a
    // protocol call: a nested written call supplies its completed descriptor;
    // every other receiver contributes its closed declaration-time TypeTerm.
    // Keep the site kinds separate in CallTemplate, but not their value-source
    // algebra.
    inout fn directReceiverTemplateForExpr(exprId: U64) -> CallTemplateReceiver {
        return self.protocolReceiverTemplateForExpr(exprId: exprId)
    }

    // `Expr.ExtMethod` stores its `#` selector on the outer node rather than
    // manufacturing an `Expr.ExtView` receiver. Preserve that selector in the
    // receiver source itself. A prior call must remain a dependency, with the
    // view applied after its body-instance result is read; a plain value can
    // carry the already-decorated TypeTerm directly.
    inout fn viewedReceiverTemplateForExpr(exprId: U64, viewedTerm: U64) -> CallTemplateReceiver {
        val base: CallTemplateReceiver = self.directReceiverTemplateForExpr(exprId: exprId)
        match base {
            CallTemplateReceiver.Term(term: _) => { return <CallTemplateReceiver.Term term=viewedTerm /> }
            CallTemplateReceiver.PriorCallResult(exprId: val priorExpr, siteKey: val priorKey) => {
                return <CallTemplateReceiver.PriorCallResultWithViews exprId=priorExpr siteKey=priorKey views=self.typeRefViewSources(ref: viewedTerm) />
            }
            CallTemplateReceiver.PriorProtocolResult(slot: val priorSlot) => {
                return <CallTemplateReceiver.PriorProtocolResultWithViews slot=priorSlot views=self.typeRefViewSources(ref: viewedTerm) />
            }
            _ => {}
        }
        return base
    }

    // `for` introduces a source-level binding just like `val`: its type must
    // be the iterator proof's associated `Item` term, not the legacy
    // TypeInfo name recovered from the iterator head.  An adapter such as
    // `xs.map(...).filter(...)` owns `Item = E` in its conformance; retaining
    // that term is what lets a generic free call in the loop body later ground
    // E through the enclosing BodyInstance.
    inout fn iterableItemTerm(iterExpr: U64, iterTerm: U64) -> U64 {
        if iterTerm == 0U64 || iterTerm >= self.arena.types.count() { return 0U64 }
        val iterTy: TypeRef = self.arena.types[iterTerm]
        if iterTy.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: iterTy.nameStart, len: iterTy.nameLen, kw: "Array") {
            return iterTy.args[0]
        }
        // Prefer the resolved source carried by the iterator-producing call.
        // It is a declaration owner, so a user trait spelled `Iterator` can
        // never capture this proof query. A direct iterator value has no call
        // provenance and uses assocItemRef's Core-contract path below.
        mut val itemTerm: U64 = 0U64
        if iterExpr < self.arena.exprs.count() {
            val template: CallTemplate = self.callTemplateForCurrentBody(exprId: iterExpr)
            match template.kind {
                CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proof: _) => {
                    if callee < self.arena.funcs.count() {
                        val selected: Func = self.arena.funcs[callee]
                        if selected.originTraitOwner != 0U64 {
                            val item: Bind = self.kwSpan(kw: "Item", kwLen: 4U64)
                            itemTerm = self.assocBindingFor(baseRef: iterTerm, traitId: selected.originTraitId, traitOwner: selected.originTraitOwner, traitArgs: selected.recvTraitArgs, assocId: intern(c: inout self, start: item.nameStart, len: item.nameLen))
                        }
                    }
                }
                _ => {}
            }
        }
        if itemTerm == 0U64 {
            itemTerm = self.assocItemRef(recvStart: iterTy.nameStart, recvLen: iterTy.nameLen, recvInstRef: iterTerm)
        }
        if itemTerm != 0U64 { return itemTerm }
        return 0U64
    }

    // A body-local `Self` is a semantic receiver projection, not an opaque
    // nominal argument.  Generic-call recording needs its declaration-time
    // receiver pattern when the callee parameter structurally exposes that
    // receiver's arguments: in `impl[T] Buffer[T] as Eq`, passing
    // `lhs: Self` to `bufferEq[T](Buffer[T], Buffer[T])` selects the caller's
    // `T`.  Trait requirement bodies have no nominal receiver pattern and
    // intentionally retain abstract `Self`; their concrete witness instance
    // supplies it only when the shared body is grounded.
    inout fn parametricCallArgumentTerm(exprId: U64) -> U64 {
        val term: U64 = self.parametricExprTerm(exprId: exprId)
        if term == 0U64 || term >= self.arena.types.count() { return term }
        val t: TypeRef = self.arena.types[term]
        if t.args.count() != 0U64 || !(rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: "Self")) {
            return term
        }
        if self.cur.checkFn >= self.arena.funcs.count() { return term }
        val owner: Func = self.arena.funcs[self.cur.checkFn]
        if owner.recvTy != 0U64 { return owner.recvTy }
        return term
    }

    // Complete only the holes left by the general inference helper with the
    // declaration receiver pattern described above.  This deliberately lives
    // on the Record path: generic checking also calls `inferFnArgs`, where
    // abstract `Self` must remain opaque.  A recorded CallTemplate, by
    // contrast, is a body-owned substitution program and may retain the
    // enclosing `impl[T] Receiver[T]` pattern needed to ground the call later.
    inout fn completeRecordedFreeCallArgs(f: Func, args: ArgRange, inferred: Array[U64]) -> Array[U64] {
        mut val out: Array[U64] = inferred
        mut val ti: U64 = 0U64
        while ti < f.typeParams.count() {
            if ti >= out.count() { out.append(0U64) }
            // The semantic argument term is more precise than legacy
            // TypeInfo even when that adapter produced a nonzero answer:
            // a for-local can be `I64` by its selected Iterator proof while
            // TypeInfo still spells the provided method's template `Item`.
            // CallTemplate is the body-instance authority, so refine rather
            // than merely fill holes.
            val tp: Bind = f.typeParams[ti]
            mut val pi: U64 = 0U64
            while pi < f.params.count() {
                val p: Param = f.params[pi]
                val ai: U64 = self.argIndexForParam(params: f.params, args: args, paramIdx: pi)
                if ai < args.len {
                    val argTerm: U64 = self.parametricCallArgumentTerm(exprId: self.argAt(args: args, index: ai).expr)
                    mut val candidate: U64 = 0U64
                    if p.tyIsArray {
                        if p.tyNameId == tp.nameId && argTerm != 0U64 && argTerm < self.arena.types.count() {
                            val at: TypeRef = self.arena.types[argTerm]
                            if at.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: at.nameStart, len: at.nameLen, kw: "Array") {
                                candidate = at.args[0]
                            }
                        }
                    } else if argTerm != 0U64 {
                        candidate = self.unifyTypeParam(paramRef: p.ty, argRef: argTerm, tpStart: tp.nameStart, tpLen: tp.nameLen)
                    }
                    if candidate != 0U64 { out.set(i: ti, value: candidate) }
                }
                pi += 1U64
            }
            ti += 1U64
        }
        return out
    }

    // Record the parametric result and the independently-carried source call
    // selection.  The result is a plain TypeTerm; callee/receiver/substitution
    // remain provenance so canonical type identity cannot depend on a call.
    inout fn recordParametricFreeCall(exprId: U64, callee: U64, args: ArgRange) {
        if callee >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[callee]
        mut val calleeArgs: Array[U64] = []
        if f.typeParams.count() > 0U64 {
            calleeArgs = self.inferParametricFnArgs(f: f, args: args)
        }
        mut val result: U64 = f.retTy
        // A source body may call `id[T](value: T) -> T` while its own T is
        // still symbolic.  That is a complete *semantic* substitution even
        // though it is not an emittable Mono instance yet.  Preserve the
        // caller-owned T in the expression result; retaining the callee's
        // ParamId would make a later body environment unable to ground it.
        // `fnArgsAllGround` is deliberately reserved for reachability/codegen.
        if f.typeParams.count() > 0U64 && self.fnArgsAllResolved(args: calleeArgs) {
            result = self.groundTermInEnvironment(ref: f.retTy, params: f.typeParams, values: calleeArgs)
        }
        self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: <CallTemplateReceiver.None />, args: args, calleeTypeArgs: calleeArgs, resultTerm: result)
        // The existing SemanticExprType is still consumed by the abstract
        // checker, so it retains its established abstract substitution. The
        // final-call template is independent provenance and may carry the
        // receiver-pattern completion needed solely for body-instance
        // grounding.
        val templateArgs: Array[U64] = self.completeRecordedFreeCallArgs(f: f, args: args, inferred: calleeArgs)
        self.recordCallTemplate(exprId: exprId, callee: callee, receiver: <CallTemplateReceiver.None />, args: args, calleeTypeArgs: templateArgs)
    }

    // Resolve the lexical closure target while Record owns the source scope.
    // `bindingDeclStart` is the lowered declaration identity, so the final
    // descriptor cannot accidentally select a same-spelled shadow later.
    inout fn recordDynamicLocalCall(exprId: U64, nameStart: U64, nameLen: U64, args: ArgRange) {
        val localIndex: U64 = self.localIndexByName(start: nameStart, len: nameLen)
        if localIndex >= self.cur.locals.count() { return }
        val local: Local = self.cur.locals[localIndex]
        if !(self.isFnType(ref: local.ty)) { return }
        self.recordDynamicCallTemplate(exprId: exprId, receiver: <CallTemplateReceiver.None />, args: args, target: <DynamicCallTemplateTarget.ClosureLocal bindingDeclStart=local.nameStart fnTypeTerm=local.ty />)
    }

    // An `any` type has an already-resolved declaration identity in TypeRef.
    // Prefer that owner over a spelling scan so an import/re-export cannot
    // redirect an existential slot after the source resolver selected it.
    inout fn recordAnyTraitIndex(anyRef: U64) -> U64 {
        if anyRef == 0U64 || anyRef >= self.arena.types.count() { return self.decls.traits.count() }
        val anyTy: TypeRef = self.arena.types[anyRef]
        if !(anyTy.isAny) { return self.decls.traits.count() }
        if anyTy.hasDecl {
            mut val i: U64 = 0U64
            while i < self.decls.traits.count() {
                if self.decls.traits[i].nameStart == anyTy.declOffset { return i }
                i += 1U64
            }
        }
        return self.findTraitIdxByName(start: anyTy.nameStart, len: anyTy.nameLen)
    }

    inout fn recordAnyRequirementSlot(anyRef: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> U64 {
        val traitIndex: U64 = self.recordAnyTraitIndex(anyRef: anyRef)
        if traitIndex >= self.decls.traits.count() { return 0U64 }
        val nameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val tr: TraitDef = self.decls.traits[traitIndex]
        mut val i: U64 = 0U64
        while i < tr.reqs.count() {
            if tr.reqs[i].nameId == nameId && self.paramsLabelsOk(params: tr.reqs[i].params, args: args) { return i + 1U64 }
            i += 1U64
        }
        return 0U64
    }

    // A method expression whose receiver is a function-valued field or an
    // existential has no static Func callee.  Record its selected target while
    // the parametric receiver and source selector are both available; the
    // function TypeTerm is grounded only when the shared body is instantiated.
    inout fn recordDynamicMethodCall(exprId: U64, receiverExpr: U64, receiverTerm: U64, nameStart: U64, nameLen: U64, args: ArgRange) {
        if receiverTerm == 0U64 || receiverTerm >= self.arena.types.count() { return }
        val receiver: CallTemplateReceiver = self.directReceiverTemplateForExpr(exprId: receiverExpr)
        val recvTy: TypeRef = self.arena.types[receiverTerm]
        if recvTy.isAny {
            val traitIndex: U64 = self.recordAnyTraitIndex(anyRef: receiverTerm)
            val slot: U64 = self.recordAnyRequirementSlot(anyRef: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
            if traitIndex < self.decls.traits.count() && slot != 0U64 {
                self.recordDynamicCallTemplate(exprId: exprId, receiver: receiver, args: args, target: <DynamicCallTemplateTarget.ExistentialRequirement traitIdx=traitIndex slot=slot />)
            }
            return
        }
        val structIndex: U64 = self.structDefByNameAny(start: recvTy.nameStart, len: recvTy.nameLen)
        if structIndex >= self.arena.structs.count() { return }
        val fieldName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val fields: Array[FieldDef] = self.arena.structs[structIndex].fields
        mut val fieldIndex: U64 = 0U64
        while fieldIndex < fields.count() {
            if fields[fieldIndex].nameId == fieldName { break }
            fieldIndex += 1U64
        }
        if fieldIndex >= fields.count() { return }
        val fieldTerm: U64 = self.fieldTypeRefOfReceiver(receiverRef: receiverTerm, fieldStart: nameStart, fieldLen: nameLen)
        // A generic field such as `p: P` can be called only after P grounds
        // to a function type in its BodyInstance.  Call syntax has already
        // been validated by the frontend; preserve the symbolic field term
        // here and let the dynamic finalizer enforce the concrete fn shape.
        if fieldTerm != 0U64 {
            self.recordDynamicCallTemplate(exprId: exprId, receiver: receiver, args: args, target: <DynamicCallTemplateTarget.ClosureField fieldIndex=fieldIndex fnTypeTerm=fieldTerm />)
        }
    }

    // A method whose concrete declaration is unavailable during the
    // declaration-time walk is not a dynamic call by default: it can still be
    // a statically selected requirement or provided trait member under a
    // generic bound.  Both ordinary and source-qualified (`#…`) method syntax
    // reach this one finalization point so they cannot diverge by silently
    // treating a view-qualified static call as a closure-field call.
    inout fn recordUnresolvedMethodTemplate(exprId: U64, receiver: CallTemplateReceiver, receiverExpr: U64, receiverTerm: U64, nameStart: U64, nameLen: U64, args: ArgRange) {
        val staticResolution: StaticMemberResolution = self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
        match staticResolution {
            StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                self.recordStaticMethodTemplate(exprId: exprId, receiver: receiver, args: args, resolution: staticResolution, resultTerm: self.staticRequirementResultType(resolution: staticResolution))
            }
            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {
                self.recordStaticMethodTemplate(exprId: exprId, receiver: receiver, args: args, resolution: staticResolution, resultTerm: self.parametricExprTerm(exprId: exprId))
            }
            _ => {
                self.recordDynamicMethodCall(exprId: exprId, receiverExpr: receiverExpr, receiverTerm: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
            }
        }
    }

    inout fn recordParametricMethodCall(exprId: U64, callee: U64, receiverSource: CallTemplateReceiver, receiverTerm: U64, args: ArgRange) {
        if callee >= self.arena.funcs.count() { return }
        val f: Func = self.arena.funcs[callee]
        // Associated factories are syntactically method-shaped but have a
        // type qualifier, not a value receiver.  Their selected declaration
        // is complete without a receiver TypeTerm; the finalizer supplies the
        // declaration receiver (or an explicitly-recorded result hint for a
        // generic associated factory).  Do not discard that source selection.
        if receiverTerm == 0U64 {
            if !(f.isAssoc) { return }
            self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: <CallTemplateReceiver.None />, args: args, calleeTypeArgs: [], resultTerm: f.retTy)
            return
        }
        if receiverTerm >= self.arena.types.count() { return }
        // A resolver can find the authored declaration of a trait-subject
        // witness while checking a provided body. That declaration is not a
        // concrete callee: `impl B as A` is abstract over B and must be
        // selected through the current static proof. Recording it as Direct
        // loses the proof and later enqueues the abstract body. A normal
        // requirement retains the established Direct-template route, whose
        // final descriptor owns the concrete implementation. `originTraitId`
        // distinguishes the former from `impl A { … }` and direct `S as A`.
        // The source body of `impl Named as Show` is checked once with a
        // symbolic trait receiver. `resolvedCallee` may incidentally see a
        // concrete copied witness loaded elsewhere (A.nm/B.nm), but that is
        // not a lexical selection for this shared body. Ask the source body's
        // trait proof first; a successful Requirement/Provided result becomes
        // a StaticMethod template and is reified per BodyInstance later.
        // Retain the selected-callee predicate for ordinary trait-receiver
        // declarations reached through their requirement surface.
        mut val sourceTraitReceiver: Bool = false
        if self.cur.checkFn < self.arena.funcs.count() {
            sourceTraitReceiver = self.methodRecvIsTrait(f: self.arena.funcs[self.cur.checkFn])
        }
        if (sourceTraitReceiver || self.methodRecvIsTrait(f: f)) && (sourceTraitReceiver || f.originTraitId != 0U64) {
            val staticResolution: StaticMemberResolution = self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: f.nameStart, nameLen: f.nameLen, args: args)
            match staticResolution {
                StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                    val result: U64 = self.staticRequirementResultType(resolution: staticResolution)
                    if result != 0U64 { self.recordSemanticExprTerm(exprId: exprId, term: result) }
                    self.recordStaticMethodTemplate(exprId: exprId, receiver: receiverSource, args: args, resolution: staticResolution, resultTerm: result)
                    return
                }
                StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {
                    self.recordStaticMethodTemplate(exprId: exprId, receiver: receiverSource, args: args, resolution: staticResolution, resultTerm: self.parametricExprTerm(exprId: exprId))
                    return
                }
                _ => {}
            }
        }
        // Newtype member selection deliberately chooses the underlying
        // declaration, so its return-term environment must use the same
        // normalized receiver. The source value remains the newtype; this is
        // only the callee's `Self` substitution for signature grounding.
        mut val returnReceiver: U64 = receiverTerm
        val receiver: TypeRef = self.arena.types[receiverTerm]
        val underlying: U64 = self.newtypeUnderRef(start: receiver.nameStart, len: receiver.nameLen)
        if underlying != 0U64 && underlying < self.arena.types.count() {
            val under: TypeRef = self.arena.types[underlying]
            if spansEqual(c: inout self, aStart: under.nameStart, aLen: under.nameLen, bStart: f.recvStart, bLen: f.recvLen) {
                returnReceiver = underlying
            }
        }
        mut val result: U64 = self.groundFinalMethodReturn(f: f, recvTy: self.typeInfoOfRef(ref: returnReceiver), args: args)
        // `groundFinalMethodReturn` preserves symbolic receiver binders. A
        // non-generic receiver has no such environment, and is instead the
        // concrete half of the same final-callable calculation. Both are
        // frontend type facts; leaving the latter to exprType would make an
        // ordinary `String.bytes()[0]` force Mono to reconstruct a method
        // result from the shared AST.
        if result == 0U64 {
            result = self.groundConcreteFinalMethodReturn(f: f, recvTy: self.typeInfoOfRef(ref: returnReceiver), args: args)
        }
        // The final callable's complete ParamId substitution is provenance,
        // not a Mono inference request.  Persist it beside the selected
        // callee so every downstream consumer sees the same method/impl
        // environment used above for result and argument terms.
        val finalEnvironment: InstanceEnvironment = self.finalMethodEnvironment(f: f, receiverRef: returnReceiver, args: args)
        // An associated factory's syntactic qualifier can itself lower through
        // method-shaped nodes (for example `MutableRef[Cell]`).  It is never a
        // value produced by that node: its semantic receiver is the selected
        // type term.  Using the ordinary receiver source would misclassify it
        // as PriorCallResult and create a nonexistent descriptor dependency.
        mut val finalReceiverSource: CallTemplateReceiver = receiverSource
        if f.isAssoc { finalReceiverSource = <CallTemplateReceiver.Term term=receiverTerm /> }
        mut val proof: StaticConformanceProof = <StaticConformanceProof.Missing />
        if f.isProvided {
            val resolution: StaticMemberResolution = self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiverTerm, nameStart: f.nameStart, nameLen: f.nameLen, args: args)
            match resolution {
                StaticMemberResolution.Requirement(proof: val selected, traitIdx: _, reqIdx: _) => { proof = selected }
                StaticMemberResolution.Provided(proof: val selected, traitIdx: _, callee: _) => { proof = selected }
                _ => {}
            }
        }
        self.recordSemanticExprCall(exprId: exprId, callee: callee, receiver: finalReceiverSource, args: args, calleeTypeArgs: finalEnvironment.args, resultTerm: result, proof: proof)
    }

    // The PARAMETRIC receiver ref for method `f` — the form `self` records as, chosen
    // so groundTypeRef at emission substitutes the instance: a trait provided-method
    // template records `Self` (grounds to the conformer via cur.selfRef); a generic
    // receiver records `Dictionary[K,V]` with the impl's own type-param names as args
    // (the first rcount of f.typeParams, matching emitOneGenMethod's env layout); a
    // non-generic receiver records its argless name ref (grounds to itself). No
    // receiver: 0.
    inout fn parametricSelfRef(f: Func) -> U64 {
        // an assoc fn has no `self` value (hasRecv false) but its recv spans still
        // name the owning type, and its `Self`-typed params (`assoc fn eq(lhs~:
        // Self, …)`) must resolve to the same parametric receiver.
        if !(f.hasRecv) && f.recvLen == 0U64 {
            return 0U64
        }
        if self.methodRecvIsTrait(f: f) {
            val sb: Bind = self.kwSpan(kw: "Self", kwLen: 4)
            return self.simpleTypeRef(nameStart: sb.nameStart, nameLen: sb.nameLen)
        }
        // An extension method's lexical `self` is `Recv#Ext`.  A conferred
        // witness does not inherit a caller's conformance-path view: its shared
        // body is checked against the surface written at its declaration.
        val vid: U64 = f.extId
        // `recvTy` is the declaration's already-lowered semantic receiver.
        // Rebuilding it from the first same-spelled f.typeParams used to erase
        // their ParamIds, making `self.field: I` fail to match an `I: Trait`
        // proof during abstract generic checking.  A non-extension receiver
        // can use this exact term directly.  Extensions retain the view
        // decoration path below until TypeRef view construction is centralized.
        if f.recvTy != 0U64 {
            if vid == 0U64 {
                return f.recvTy
            }
            mut val extensionView: Array[U64] = []
            extensionView.append(vid)
            return self.typeRefWithViews(ref: f.recvTy, viewExtId: vid, viewIds: extensionView)
        }
        mut val rcount: U64 = 0
        val si: U64 = self.anyStructIndex(nameStart: f.recvStart, nameLen: f.recvLen)
        if si < self.arena.structs.count() {
            rcount = self.arena.structs[si].typeParams.count()
        } else {
            val ei: U64 = self.anyEnumIndex(nameStart: f.recvStart, nameLen: f.recvLen)
            if ei < self.arena.enums.count() {
                rcount = self.arena.enums[ei].typeParams.count()
            }
        }
        mut val args: Array[U64] = []
        mut val i: U64 = 0
        while i < rcount {
            if i < f.typeParams.count() {
                args.append(self.simpleTypeRef(nameStart: f.typeParams[i].nameStart, nameLen: f.typeParams[i].nameLen))
            }
            i += 1
        }
        return self.pushType(t: <TypeRef nameStart=f.recvStart nameLen=f.recvLen args=args isRecord=false recordFieldLabels=[] recordFieldTerms=[] viewExtId=vid />)
    }

    // An array literal is bidirectionally typed by its selected Array[E]
    // context. This applies to a nonempty literal too: `[1, 2]` passed where
    // Array[I32] is required must retain Array[I32], rather than freezing the
    // temporary default I64 shape inferred from its unsuffixed elements.
    inout fn recordArrayLitCtx(exprId: U64, ctxRef: U64) {
        if ctxRef == 0U64 || exprId >= self.arena.semanticExprTypes.count() {
            return
        }
        match self.arena.exprs[exprId] {
            Expr.Array(elems: val elems) => {
                self.recordSemanticExprTerm(exprId: exprId, term: ctxRef)
                if ctxRef < self.arena.types.count() {
                    val array: TypeRef = self.arena.types[ctxRef]
                    if array.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: array.nameStart, len: array.nameLen, kw: "Array") {
                        mut val i: U64 = 0U64
                        while i < elems.len {
                            self.recordSemanticExprExpectedResult(exprId: self.exprAt(exprs: elems, index: i), expectedTerm: array.args[0U64])
                            i += 1U64
                        }
                    }
                }
                self.recordSemanticAggregate(exprId: exprId)
            }
            _ => {}
        }
    }

    // `Record` is the last phase allowed to turn a construction's authored
    // labels/variant spelling into physical layout.  Mid receives only this
    // frozen carrier; its use of ExprId is navigation into an already-selected
    // aggregate tree, never a second name or field lookup.
    inout fn semanticAggregateFieldIndex(typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, fieldStart: U64, fieldLen: U64) -> U64 {
        val qField: U64 = intern(c: inout self, start: fieldStart, len: fieldLen)
        if isEnum {
            val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
            val qVariant: U64 = intern(c: inout self, start: variantStart, len: variantLen)
            mut val ei: U64 = 0U64
            while ei < self.arena.enums.count() {
                val en: EnumDef = self.arena.enums[ei]
                if en.nameId == qType {
                    mut val vi: U64 = 0U64
                    while vi < en.variants.count() {
                        val variant: Variant = en.variants[vi]
                        if variant.nameId == qVariant {
                            mut val fi: U64 = 0U64
                            while fi < variant.fields.count() {
                                if variant.fields[fi].nameId == qField { return fi }
                                fi += 1U64
                            }
                        }
                        vi += 1U64
                    }
                }
                ei += 1U64
            }
            return 0U64
        }
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val si: U64 = 0U64
        while si < self.arena.structs.count() {
            val st: StructDef = self.arena.structs[si]
            if st.nameId == qType {
                mut val fi: U64 = 0U64
                while fi < st.fields.count() {
                    if st.fields[fi].nameId == qField { return fi }
                    fi += 1U64
                }
            }
            si += 1U64
        }
        return 0U64
    }

    inout fn recordSemanticAggregate(exprId: U64) {
        if !(self.cur.recordCallTemplates) { return }
        val resultTerm: U64 = self.parametricExprTerm(exprId: exprId)
        if resultTerm == 0U64 { return }
        match self.arena.exprs[exprId] {
            Expr.Make(typeStart: val typeStart, typeLen: val typeLen, variantStart: val variantStart, variantLen: val variantLen, isEnum: val isEnum, ty: _, fields: val fields) => {
                mut val elements: Array[SemanticAggregateElement] = []
                mut val variantIndex: U64 = 0U64
                mut val enumIndex: U64 = self.arena.enums.count()
                if isEnum {
                    variantIndex = self.variantIndex(enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen)
                    enumIndex = self.anyEnumIndex(nameStart: typeStart, nameLen: typeLen)
                }
                mut val i: U64 = 0U64
                while i < fields.len {
                    val field: MakeField = self.makeFieldAt(fields: fields, index: i)
                    val fieldIndex: U64 = self.semanticAggregateFieldIndex(typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: field.nameStart, fieldLen: field.nameLen)
                    elements.append(<SemanticAggregateElement fieldIndex=fieldIndex exprId=field.value targetTerm=self.aggregateSlotTypeRef(resultRef: resultTerm, isEnum: isEnum, variantIndex: variantIndex, fieldIndex: fieldIndex) term=self.parametricExprTerm(exprId: field.value) />)
                    i += 1U64
                }
                if isEnum {
                    mut val fieldCount: U64 = 0U64
                    if enumIndex < self.arena.enums.count() && variantIndex < self.arena.enums[enumIndex].variants.count() { fieldCount = self.arena.enums[enumIndex].variants[variantIndex].fields.count() }
                    self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.Enum enumIdx=enumIndex variantIndex=variantIndex /> resultTerm=resultTerm fieldCount=fieldCount elements=elements />)
                } else {
                    mut val fieldCount: U64 = 0U64
                    val structIndex: U64 = self.anyStructIndex(nameStart: typeStart, nameLen: typeLen)
                    if structIndex < self.arena.structs.count() { fieldCount = self.arena.structs[structIndex].fields.count() }
                    self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.Struct /> resultTerm=resultTerm fieldCount=fieldCount elements=elements />)
                }
            }
            Expr.Array(elems: val elems) => {
                mut val elements: Array[SemanticAggregateElement] = []
                mut val i: U64 = 0U64
                while i < elems.len {
                    val child: U64 = self.exprAt(exprs: elems, index: i)
                    elements.append(<SemanticAggregateElement fieldIndex=i exprId=child targetTerm=self.aggregateSlotTypeRef(resultRef: resultTerm, isEnum: false, variantIndex: 0U64, fieldIndex: i) term=self.parametricExprTerm(exprId: child) />)
                    i += 1U64
                }
                self.putSemanticAggregate(aggregate: <SemanticAggregate ownerFnIdx=self.cur.checkFn exprId=exprId kind=<SemanticAggregateKind.Array /> resultTerm=resultTerm fieldCount=elems.len elements=elements />)
            }
            _ => {}
        }
    }

    // Context can refine an array literal after its first post-order visit.
    // Keep one source-body aggregate identity and replace its frozen facts as
    // a whole; parallel "early" and "contextual" carriers would be two
    // semantic roots for the same construction.
    fn semanticAggregateHash(ownerFnIdx: U64, exprId: U64) -> U64 {
        // Keep every intermediate below 2^32: checked U64 arithmetic is part
        // of the self-hosted compiler's own execution contract.
        val modulus: U64 = 4294967291U64
        mut val h: U64 = ownerFnIdx % modulus
        h = ((h + exprId % modulus) * 65537U64) % modulus
        return h
    }

    inout fn rebuildSemanticAggregateIndex(capacity: U64) {
        self.decls.semanticAggregateIndexSlots = []
        mut val zeroI: U64 = 0U64
        while zeroI < capacity {
            self.decls.semanticAggregateIndexSlots.append(0U64)
            zeroI += 1U64
        }
        mut val entry: U64 = 0U64
        while entry < self.decls.semanticAggregates.count() {
            val aggregate: SemanticAggregate = self.decls.semanticAggregates[entry]
            mut val slot: U64 = self.semanticAggregateHash(ownerFnIdx: aggregate.ownerFnIdx, exprId: aggregate.exprId) % capacity
            while self.decls.semanticAggregateIndexSlots[slot] != 0U64 {
                slot = (slot + 1U64) % capacity
            }
            self.decls.semanticAggregateIndexSlots.set(i: slot, value: entry + 1U64)
            entry += 1U64
        }
    }

    inout fn ensureSemanticAggregateIndex(nextCount: U64) {
        if self.decls.semanticAggregateIndexSlots.count() == 0U64 {
            self.rebuildSemanticAggregateIndex(capacity: 16U64)
        }
        if nextCount * 10U64 >= self.decls.semanticAggregateIndexSlots.count() * 7U64 {
            self.rebuildSemanticAggregateIndex(capacity: self.decls.semanticAggregateIndexSlots.count() * 2U64)
        }
    }

    // Return the canonical array index, or count() when absent. The vector is
    // the semantic source; slots are a rebuildable reader for Record and Mid.
    inout fn semanticAggregateIndex(ownerFnIdx: U64, exprId: U64) -> U64 {
        val capacity: U64 = self.decls.semanticAggregateIndexSlots.count()
        if capacity == 0U64 { return self.decls.semanticAggregates.count() }
        mut val slot: U64 = self.semanticAggregateHash(ownerFnIdx: ownerFnIdx, exprId: exprId) % capacity
        while self.decls.semanticAggregateIndexSlots[slot] != 0U64 {
            val entry: U64 = self.decls.semanticAggregateIndexSlots[slot] - 1U64
            val prior: SemanticAggregate = self.decls.semanticAggregates[entry]
            if prior.ownerFnIdx == ownerFnIdx && prior.exprId == exprId { return entry }
            slot = (slot + 1U64) % capacity
        }
        return self.decls.semanticAggregates.count()
    }

    inout fn putSemanticAggregate(aggregate: SemanticAggregate) {
        val prior: U64 = self.semanticAggregateIndex(ownerFnIdx: aggregate.ownerFnIdx, exprId: aggregate.exprId)
        if prior < self.decls.semanticAggregates.count() {
            self.decls.semanticAggregates.set(i: prior, value: aggregate)
            return
        }
        self.ensureSemanticAggregateIndex(nextCount: self.decls.semanticAggregates.count() + 1U64)
        self.decls.semanticAggregates.append(aggregate)
        val capacity: U64 = self.decls.semanticAggregateIndexSlots.count()
        mut val slot: U64 = self.semanticAggregateHash(ownerFnIdx: aggregate.ownerFnIdx, exprId: aggregate.exprId) % capacity
        while self.decls.semanticAggregateIndexSlots[slot] != 0U64 {
            slot = (slot + 1U64) % capacity
        }
        self.decls.semanticAggregateIndexSlots.set(i: slot, value: self.decls.semanticAggregates.count())
    }

    // The value of an expression block is its final `give`.  Read the term
    // after Record has visited the block, while its lexical arm bindings have
    // already supplied the give expression's own SemanticExprType.  This is a
    // producer boundary: it never re-runs exprType/typeOf after the block's
    // scope has been popped.
    inout fn recordValueBlockResult(exprId: U64, blockId: U64) -> Bool {
        val giveExpr: U64 = self.blockGiveExpr(blkId: blockId)
        if giveExpr >= self.arena.exprs.count() { return false }
        val term: U64 = self.parametricExprTerm(exprId: giveExpr)
        if term == 0U64 { return false }
        self.recordSemanticExprTerm(exprId: exprId, term: term)
        return true
    }

    // `readExpr` is a synthetic Index.index call made by Lower.  The candidate
    // lets Record connect that value read back to its storage path without
    // asking a later phase to infer anything from a method name or collection
    // spelling.
    inout fn accessCandidateIndex(readExpr: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.accessCandidates.count() {
            val candidate: AccessCandidate = self.decls.accessCandidates[i]
            // A method receiver is the synthetic Index.index read; an
            // explicit `inout` argument retains the authored Index place.
            // They are two evaluation views of one candidate, never two
            // separately inferred storage paths.
            if candidate.readExpr == readExpr || candidate.placeExpr == readExpr { return i }
            i += 1U64
        }
        // A selected inout use may project a field from an indexed value
        // (`items[i].field.append(...)`). The field is not a second storage
        // candidate: it retains the exact candidate underneath it, while the
        // access-use record carries the full projected expression separately.
        // Peel only representation-neutral wrappers; no member/type lookup is
        // reopened here, and an unrelated expression remains non-candidate.
        if readExpr < self.arena.exprs.count() {
            match self.arena.exprs[readExpr] {
                Expr.Field(base: val base, nameStart: _, nameLen: _) => { return self.accessCandidateIndex(readExpr: base) }
                Expr.Cast(operand: val operand, tyStart: _, tyLen: _, ty: _) => { return self.accessCandidateIndex(readExpr: operand) }
                Expr.ExtView(recv: val recv, source: _, strip: _) => { return self.accessCandidateIndex(readExpr: recv) }
                _ => {}
            }
        }
        return self.decls.accessCandidates.count()
    }

    // Record one selected call's relationship to an indexed access candidate.
    // This is available only in the final Record walk, so the ABI mode comes
    // from the selected declaration rather than a Lower-time name heuristic.
    inout fn recordAccessUse(parentExpr: U64, readExpr: U64, role: U64, argIndex: U64, parameterIndex: U64, modeKnown: Bool, write: Bool) {
        if !(self.cur.recordCallTemplates) { return }
        val candidateIndex: U64 = self.accessCandidateIndex(readExpr: readExpr)
        if candidateIndex >= self.decls.accessCandidates.count() { return }
        val parent: CallSiteKey = self.templateCallSiteKey(fnIdx: self.cur.checkFn, exprId: parentExpr)
        mut val i: U64 = 0U64
        while i < self.decls.accessUses.count() {
            val prior: AccessUse = self.decls.accessUses[i]
            if prior.candidateIndex == candidateIndex && prior.role == role && prior.argIndex == argIndex && self.sameCallSiteKey(a: prior.parent, b: parent) {
                self.decls.accessUses.set(i: i, value: <AccessUse candidateIndex=candidateIndex accessExpr=readExpr parent=parent role=role argIndex=argIndex parameterIndex=parameterIndex modeKnown=modeKnown write=write />)
                return
            }
            i += 1U64
        }
        self.decls.accessUses.append(<AccessUse candidateIndex=candidateIndex accessExpr=readExpr parent=parent role=role argIndex=argIndex parameterIndex=parameterIndex modeKnown=modeKnown write=write />)
    }

    // Record the detached IndexSet facet under exactly the same lexical
    // Record context as its Index read. The write node is a semantic template
    // only: its second argument is the read result as a type anchor and Mid
    // will later replace that value with a materialized mutable temporary.
    // The guard prevents `write(value: read())` from recursively re-entering
    // this routine while it records its anchor child.
    inout fn recordAccessWriteFacet(readExpr: U64) {
        if self.cur.recordingAccessWriteFacet { return }
        val candidateIndex: U64 = self.accessCandidateIndex(readExpr: readExpr)
        if candidateIndex >= self.decls.accessCandidates.count() { return }
        val writeExpr: U64 = self.decls.accessCandidates[candidateIndex].writeExpr
        if writeExpr >= self.arena.exprs.count() { return }
        self.cur.recordingAccessWriteFacet = true
        self.recordExpr(exprId: writeExpr)
        self.cur.recordingAccessWriteFacet = false
    }

    // Record an expression under an optional-chain payload supplied by its
    // unique enclosing chain stage. The payload is a structural child input,
    // not Cursor state: ordinary expressions use 0, and every continuation
    // descendant receives the same explicit parametric term.
    inout fn recordExpr(exprId: U64, chainHoleRef: U64 = 0U64) {
        // This full lexical semantic walk is observable only in phase tracing.
        // Reuse the existing transient work counter so normal compilation gains
        // neither stored state nor a second diagnostic traversal.
        if self.tracePhases {
            self.traceExprInstScans += 1U64
        }
        // Structural forms write their TypeTerm below.  The legacy TypeInfo
        // adapter is intentionally a post-order fallback: computing it first
        // recursively reopens children whose semantic producer has already
        // written the exact term.  This keeps type recovery a compatibility
        // boundary rather than the universal source of semantic truth.
        match self.arena.exprs[exprId] {
            // These literals have a type fixed by their own spelling.  Record
            // it as a TypeTerm directly instead of routing through TypeInfo;
            // only an unsuffixed integer remains context-polymorphic.
            Expr.Int(value: _, offset: _, val isBool, val tyStart, val tyLen, isNeg: _) => {
                if isBool {
                    val boolName: Bind = self.kwSpan(kw: "Bool", kwLen: 4U64)
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen))
                } else if tyLen != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: tyStart, nameLen: tyLen))
                }
            }
            Expr.Float(start: _, len: _, val tyStart, val tyLen) => {
                if tyLen != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: tyStart, nameLen: tyLen))
                } else {
                    val floatName: Bind = self.kwSpan(kw: "F64", kwLen: 3U64)
                    self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: floatName.nameStart, nameLen: floatName.nameLen))
                }
            }
            Expr.Str(start: _, len: _) => {
                val stringName: Bind = self.kwSpan(kw: "String", kwLen: 6U64)
                self.recordSemanticExprTerm(exprId: exprId, term: self.simpleTypeRef(nameStart: stringName.nameStart, nameLen: stringName.nameLen))
            }
            // A local binding's declared TypeRef is the lexical source of
            // truth for an identifier. Record it directly after the legacy
            // adapter so a parametric annotation (`Optional[Box[T]]`) cannot
            // be collapsed to its head spelling by TypeInfo recovery.
            Expr.Ident(val start, val len) => {
                // `self` is the receiver's declaration-time TypeTerm, not an
                // ordinary local. Recording that lexical source is what lets
                // a structural projection such as `self.items` retain
                // `Array[T]`, so a following `.set(...)` can publish one
                // parametric CallTemplate. Falling back to `typeOf` here
                // loses the receiver argument and forces Mono to reopen AST.
                if self.isSelfRef(start: start, len: len) && self.cur.selfRef != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: self.cur.selfRef)
                }
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    val local: Local = self.cur.locals[localIdx]
                    if local.ty != 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: local.ty)
                    }
                }
            }
            Expr.Unary(op: _, val operand) => { self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef) }
            Expr.Binary(op: _, val lhs, val rhs) => {
                self.recordExpr(exprId: lhs, chainHoleRef: chainHoleRef)
                self.recordExpr(exprId: rhs, chainHoleRef: chainHoleRef)
            }
            Expr.Call(nameStart: val callStart, nameLen: val callLen, args: val args) => {
                mut val i: U64 = 0
                while i < args.len {
                    self.recordExpr(exprId: self.argAt(args: args, index: i).expr, chainHoleRef: chainHoleRef)
                    i += 1
                }
                // `pow(base:, exp:)` has free-call syntax but is a static
                // associated member selected from its first argument's
                // conformance.  Record it through the same CallTemplate
                // producers as every other static call; Mono must not reopen
                // the spelling and rediscover its witness.
                mut val cfi: U64 = self.arena.funcs.count()
                if rangeEquals(bytes: self.arena.bytes, start: callStart, len: callLen, kw: "pow") && args.len == 2U64 {
                    val baseExpr: U64 = self.argAt(args: args, index: 0U64).expr
                    val baseTerm: U64 = self.parametricExprTerm(exprId: baseExpr)
                    if baseTerm != 0U64 && baseTerm < self.arena.types.count() {
                        val baseReceiver: CallTemplateReceiver = self.directReceiverTemplateForExpr(exprId: baseExpr)
                        val resolution: StaticMemberResolution = self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: baseTerm, nameStart: callStart, nameLen: callLen, args: args)
                        match resolution {
                            StaticMemberResolution.Requirement(proof: _, traitIdx: _, reqIdx: _) => {
                                self.recordStaticMethodTemplate(exprId: exprId, receiver: baseReceiver, args: args, resolution: resolution, resultTerm: self.staticRequirementResultType(resolution: resolution))
                                return
                            }
                            StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {
                                self.recordStaticMethodTemplate(exprId: exprId, receiver: baseReceiver, args: args, resolution: resolution, resultTerm: self.parametricExprTerm(exprId: exprId))
                                return
                            }
                            _ => {}
                        }
                        cfi = self.resolveAssocForResolvedReceiver(surfaceRef: baseTerm, sourceId: 0U64, sourceOwner: 0U64, nameStart: callStart, nameLen: callLen, args: args, useOffset: self.exprOffset(id: exprId))
                        if cfi < self.arena.funcs.count() {
                            self.recordParametricMethodCall(exprId: exprId, callee: cfi, receiverSource: baseReceiver, receiverTerm: baseTerm, args: args)
                            return
                        }
                    }
                }
                cfi = self.resolvedCallee(id: exprId)
                if cfi < self.arena.funcs.count() {
                    val cf: Func = self.arena.funcs[cfi]
                    val ps: Array[Param] = cf.params
                    // a generic callee's parametric param (`xs: Array[T]`) is grounded
                    // under THIS call's inferred type args before use as a literal
                    // context; only a GROUND context applies — the callee's own `T`
                    // means nothing in this body's env, and recording it sends emission
                    // into self-referential grounding (mirrors the Method arm's gate).
                    mut val canGround: Bool = false
                    mut val inferred: Array[U64] = []
                    if cf.typeParams.count() > 0U64 {
                        inferred = self.inferFnArgs(f: cf, args: args)
                        // only a COMPLETE inference grounds (a partially-inferred env
                        // substitutes 0 for the unfound param and the hole would pass
                        // the ground gate as an empty-named ref).
                        canGround = self.fnArgsAllGround(args: inferred)
                    }
                    mut val k: U64 = 0
                    while k < args.len {
                        if k < ps.count() {
                            mut val cctx: U64 = ps[k].ty
                            if cctx != 0U64 && canGround && !(self.tyRefIsGround(ref: cctx)) {
                                val savedP: Array[Bind] = self.cur.typeParams
                                val savedA: Array[U64] = self.cur.typeArgs
                                self.cur.typeParams = cf.typeParams
                                self.cur.typeArgs = inferred
                                cctx = self.groundTypeRef(ref: cctx)
                                self.cur.typeParams = savedP
                                self.cur.typeArgs = savedA
                            }
                            if cctx != 0U64 && self.tyRefIsGround(ref: cctx) {
                                self.recordSemanticExprExpectedResult(exprId: self.argAt(args: args, index: k).expr, expectedTerm: cctx)
                                self.recordArrayLitCtx(exprId: self.argAt(args: args, index: k).expr, ctxRef: cctx)
                            }
                        }
                        k += 1
                    }
                    // A call template owns the type of the value it actually
                    // passes, not the pre-context probe used to choose a
                    // parameter context.  In particular `[Sq]` at a selected
                    // `Array[any Shape]` parameter is one contextual
                    // aggregate boundary; its parent call therefore receives
                    // the already-converted `Array[any Shape]` and records an
                    // Identity conversion.  Recording the template before
                    // this loop left two incompatible facts for the same
                    // value (raw Array[Sq] in CallResolution, boxed elements
                    // in SemanticAggregate).
                    self.recordParametricFreeCall(exprId: exprId, callee: cfi, args: args)
                } else {
                    self.recordDynamicLocalCall(exprId: exprId, nameStart: callStart, nameLen: callLen, args: args)
                }
                // Explicit `inout` arguments retain their source role in the
                // call template. If one is an Index.index result, connect it
                // to the storage candidate now; its write mode is known for a
                // selected direct callee and explicitly deferred otherwise.
                mut val accessArg: U64 = 0U64
                while accessArg < args.len {
                    val arg: Arg = self.argAt(args: args, index: accessArg)
                    if arg.isInout {
                        // The source marker says that the author requests an
                        // access, not which ABI slot it occupies.  Preserve
                        // the selected parameter mapping here: defaults and
                        // labels can make source argument order differ from
                        // the declaration order, and only that declaration
                        // owns the final `isInout` mode.
                        mut val accessWrite: Bool = false
                        mut val paramIndex: U64 = args.len
                        if cfi < self.arena.funcs.count() {
                            val selected: Func = self.arena.funcs[cfi]
                            paramIndex = self.paramIndexForArg(params: selected.params, args: args, argIdx: accessArg)
                            if paramIndex < selected.params.count() {
                                accessWrite = selected.params[paramIndex].isInout
                            }
                        }
                        self.recordAccessUse(parentExpr: exprId, readExpr: arg.expr, role: 2U64, argIndex: accessArg, parameterIndex: paramIndex, modeKnown: cfi < self.arena.funcs.count(), write: accessWrite)
                        // An explicit `inout rows[i]` owns the same detached
                        // get-modify-set write facet as an inout method
                        // receiver.  Record it at this producer boundary while
                        // the selected ABI still says that writeback occurs;
                        // Mono may then close the frozen setter call without
                        // reopening the authored Index expression.
                        if accessWrite {
                            self.recordAccessWriteFacet(readExpr: arg.expr)
                        }
                    }
                    accessArg += 1U64
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef)
                mut val i: U64 = 0
                while i < args.len {
                    self.recordExpr(exprId: self.argAt(args: args, index: i).expr, chainHoleRef: chainHoleRef)
                    i += 1
                }
                val receiverTerm: U64 = self.syntheticCallReceiverTerm(exprId: exprId, fallback: self.parametricExprTerm(exprId: recv))
                mut val methodCallee: U64 = self.resolvedCallee(id: exprId)
                // A factory is lowered to Expr.Method but its receiver is a
                // type spelling, not a value receiver.  Select its associated
                // callable here while Record still owns that lexical/type-name
                // source; Mono must only ground the resulting Direct template.
                if methodCallee >= self.arena.funcs.count() {
                    val assocRecv: Bind = self.assocRecvName(recv: recv)
                    if assocRecv.nameLen != 0U64 {
                        methodCallee = self.findAssoc(recvStart: assocRecv.nameStart, recvLen: assocRecv.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    }
                }
                // Some valid inherited surfaces (notably a newtype's
                // underlying methods) have no early type-cache callee. Record
                // still owns the one frontend selection: resolve it now from
                // the already-recorded receiver, rather than leaving Mono to
                // reopen this method Expr during finalization.
                if methodCallee >= self.arena.funcs.count() && receiverTerm != 0U64 {
                    methodCallee = self.resolveMethodForResolvedReceiver(recv: recv, surfaceRef: receiverTerm, sourceId: 0U64, sourceOwner: 0U64, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                }
                // A parametric field receiver (`self.items: Array[T]`) has a
                // complete TypeTerm but can still require the ordinary
                // syntax-aware frontend query for its intrinsic collection
                // surface. This is still declaration-time source selection:
                // Record owns the lexical `self.items` scope and publishes the
                // resulting template once; Mono only grounds it later.
                if methodCallee >= self.arena.funcs.count() {
                    methodCallee = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
                }
                // Newtype member inheritance selects the underlying surface
                // while preserving the authored newtype as the value term.
                // The finalizer already normalizes that receiver for the
                // selected declaration; Record must make the same frontend
                // selection so it can publish a Direct template first.
                if methodCallee >= self.arena.funcs.count() && receiverTerm != 0U64 && receiverTerm < self.arena.types.count() {
                    val receiver: TypeRef = self.arena.types[receiverTerm]
                    val underlying: U64 = self.newtypeUnderRef(start: receiver.nameStart, len: receiver.nameLen)
                    if underlying != 0U64 && underlying < self.arena.types.count() {
                        val under: TypeRef = self.arena.types[underlying]
                        methodCallee = self.findMethod(recvStart: under.nameStart, recvLen: under.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: underlying, useOffset: self.exprOffset(id: exprId))
                    }
                }
                self.recordParametricMethodCall(exprId: exprId, callee: methodCallee, receiverSource: self.directReceiverTemplateForExpr(exprId: recv), receiverTerm: receiverTerm, args: args)
                if methodCallee >= self.arena.funcs.count() {
                    self.recordUnresolvedMethodTemplate(exprId: exprId, receiver: self.directReceiverTemplateForExpr(exprId: recv), receiverExpr: recv, receiverTerm: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
                }
                // A synthetic index read used as this receiver is an access
                // candidate.  Only a selected direct method supplies a final
                // self mode here; generic-bound/dynamic variants remain
                // explicitly deferred until their frozen target is grounded.
                if methodCallee < self.arena.funcs.count() {
                    self.recordAccessUse(parentExpr: exprId, readExpr: recv, role: 1U64, argIndex: 0U64, parameterIndex: 0U64, modeKnown: true, write: self.arena.funcs[methodCallee].selfInout)
                } else {
                    self.recordAccessUse(parentExpr: exprId, readExpr: recv, role: 1U64, argIndex: 0U64, parameterIndex: 0U64, modeKnown: false, write: false)
                }
                // The detached setter belongs to the indexed receiver, not
                // to this parent method call. Passing `exprId` only happened
                // to work for non-nested paths where another walk recorded
                // the facet; nested indexes require this exact candidate
                // identity to close every write dependency.
                self.recordAccessWriteFacet(readExpr: recv)
                // Context-type an array literal from the selected method
                // parameter. `receiverTerm` is the just-recorded semantic
                // receiver fact; reopening `typeOf(recv)` here loses an
                // Array's nested argument and can leave `[1, 2]` without its
                // required Array[I32] context. This is a producer boundary,
                // so ground the declaration parameter once under that term.
                if methodCallee < self.arena.funcs.count() {
                    val selectedMethod: Func = self.arena.funcs[methodCallee]
                    val mps: Array[Param] = selectedMethod.params
                    mut val mk: U64 = 0U64
                    while mk < args.len {
                        val parameterIndex: U64 = self.paramIndexForArg(params: mps, args: args, argIdx: mk)
                        if parameterIndex < mps.count() {
                            val mctx: U64 = self.groundFinalMethodParameter(f: selectedMethod, recvTy: self.typeInfoOfRef(ref: receiverTerm), args: args, parameterTerm: mps[parameterIndex].ty)
                            if mctx != 0U64 && self.tyRefIsGround(ref: mctx) {
                                val argumentExpr: U64 = self.argAt(args: args, index: mk).expr
                                self.recordSemanticExprExpectedResult(exprId: argumentExpr, expectedTerm: mctx)
                                self.recordArrayLitCtx(exprId: argumentExpr, ctxRef: mctx)
                            }
                        }
                        mk += 1U64
                    }
                }
            }
            Expr.ExtMethod(recv: val recv, source: val source, nameStart: val nameStart, nameLen: val nameLen, args: val args) => {
                self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef)
                mut val i: U64 = 0
                while i < args.len {
                    self.recordExpr(exprId: self.argAt(args: args, index: i).expr, chainHoleRef: chainHoleRef)
                    i += 1
                }
                mut val receiverTerm: U64 = self.parametricExprTerm(exprId: recv)
                if source.surfaceId != 0U64 && receiverTerm != 0U64 {
                    val additions: Array[ResolvedViewSource] = [<ResolvedViewSource surfaceId=source.surfaceId traitOwner=source.traitOwner />]
                    receiverTerm = self.typeRefWithAddedViewSources(ref: receiverTerm, additions: additions)
                }
                val receiverSource: CallTemplateReceiver = self.viewedReceiverTemplateForExpr(exprId: recv, viewedTerm: receiverTerm)
                mut val methodCallee: U64 = self.resolvedCallee(id: exprId)
                // `#` fixes a trait/view source at the syntax site.  Its
                // selected member must be recorded while that source is still
                // present in Record; the ordinary TypeCache intentionally
                // leaves some extension-path selections unfilled because the
                // final concrete receiver is not known during the early pass.
                if methodCallee >= self.arena.funcs.count() {
                    methodCallee = self.resolveMethodForResolvedReceiver(recv: recv, surfaceRef: receiverTerm, sourceId: source.surfaceId, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: self.exprOffset(id: exprId))
                }
                if methodCallee >= self.arena.funcs.count() && source.surfaceId != 0U64 && source.surfaceId <= self.interner.entries.count() {
                    val surface: InternedSpan = self.interner.entries[source.surfaceId - 1U64]
                    methodCallee = self.resolveExtMethodFinal(recv: recv, srcStart: surface.start, srcLen: surface.len, sourceOwner: source.traitOwner, nameStart: nameStart, nameLen: nameLen, args: args)
                }
                self.recordParametricMethodCall(exprId: exprId, callee: methodCallee, receiverSource: receiverSource, receiverTerm: receiverTerm, args: args)
                if methodCallee >= self.arena.funcs.count() {
                    self.recordUnresolvedMethodTemplate(exprId: exprId, receiver: receiverSource, receiverExpr: recv, receiverTerm: receiverTerm, nameStart: nameStart, nameLen: nameLen, args: args)
                }
            }
            Expr.ExtView(val recv, val source, val strip) => {
                self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef)
                // A view is a type-level facet of an existing value, not a
                // method-resolution query.  Preserve the receiver's exact
                // TypeTerm and apply the resolved source set once, matching
                // the canonical TypeRef representation used everywhere else.
                val receiverTerm: U64 = self.parametricExprTerm(exprId: recv)
                if receiverTerm != 0U64 && receiverTerm < self.arena.types.count() {
                    mut val sources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: receiverTerm)
                    if strip {
                        sources = []
                    } else {
                        mut val present: Bool = false
                        mut val i: U64 = 0U64
                        while i < sources.count() {
                            if self.semanticViewSourceEq(a: sources[i], b: source) {
                                present = true
                            }
                            i += 1U64
                        }
                        if !(present) {
                            sources.append(source)
                        }
                    }
                    self.recordSemanticExprTerm(exprId: exprId, term: self.typeRefWithViewSources(ref: receiverTerm, sources: sources))
                }
            }
            Expr.Field(val base, val nameStart, val nameLen) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                // Field selection is a structural type-term operation. Once the
                // receiver has been recorded, derive the exact field term here
                // rather than forcing every BodyInstance to re-walk Field in
                // groundedTypeOf. `groundUnderInst` preserves a symbolic
                // receiver argument (Box[T]) for later body grounding.
                val baseTerm: U64 = self.parametricExprTerm(exprId: base)
                val fieldTerm: U64 = self.fieldTypeRefOfReceiver(receiverRef: baseTerm, fieldStart: nameStart, fieldLen: nameLen)
                if fieldTerm != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: fieldTerm)
                    val fieldIndex: U64 = self.fieldIndexOfReceiver(receiverRef: baseTerm, fieldStart: nameStart, fieldLen: nameLen)
                    val structIndex: U64 = self.anyStructIndex(nameStart: self.arena.types[baseTerm].nameStart, nameLen: self.arena.types[baseTerm].nameLen)
                    if structIndex < self.arena.structs.count() && fieldIndex < self.arena.structs[structIndex].fields.count() {
                        self.recordSemanticExprFieldProjection(exprId: exprId, index: fieldIndex)
                    }
                }
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                mut val i: U64 = 0
                while i < fields.len {
                    val field: MakeField = self.makeFieldAt(fields: fields, index: i)
                    self.recordExpr(exprId: field.value, chainHoleRef: chainHoleRef)
                    val ft: TypeInfo = self.makeFieldType(typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: field.nameStart, fieldLen: field.nameLen)
                    mut val ctxRef: U64 = self.typedIrRefOfInfo(ti: ft)
                    // a generic construction's field context is the DECLARED field type
                    // (`items: Array[T]` on `<Box[I64] …/>`) — ground it under the
                    // instance so the literal records `Array[I64]`, and never store a
                    // still-parametric context (a non-instance Make leaves it as-is).
                    if ctxRef != 0U64 && ty != 0U64 && self.isGenericInst(ref: ty) {
                        ctxRef = self.groundUnderInst(instRef: ty, tyRef: ctxRef)
                    }
                    // A field declaration is a bidirectional semantic input
                    // for *every* expression placed in that field.  In a
                    // generic body it is intentionally parametric (`Buffer[E]`),
                    // so a later BodyInstance can ground `Buffer.new()` to
                    // `Buffer[String]`.  Dropping it merely because it is not
                    // ground loses the only result-side substitution for an
                    // argument-less generic associated call.
                    self.recordSemanticExprExpectedResult(exprId: field.value, expectedTerm: ctxRef)
                    // Empty array literals are different: their AST-owned
                    // literal type must itself be concrete, so retain the old
                    // ground-only gate for this literal-specific adapter.
                    mut val arrayCtx: U64 = ctxRef
                    if arrayCtx != 0U64 && !(self.tyRefIsGround(ref: arrayCtx)) {
                        arrayCtx = 0U64
                    }
                    self.recordArrayLitCtx(exprId: field.value, ctxRef: arrayCtx)
                    i += 1
                }
                // A named construction already owns its complete TypeTerm from
                // Lower.  It is the value's declared instance (including
                // lexical generic arguments), so reopening exprType would only
                // reconstruct the same fact from spelling and can erase those
                // arguments. Anonymous records intentionally keep the fallback:
                // their term is assembled from field terms by the record
                // canonicalizer, not stored on this node.
                if ty != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: ty)
                }
                self.recordSemanticAggregate(exprId: exprId)
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.len {
                    self.recordExpr(exprId: self.exprAt(exprs: elems, index: i), chainHoleRef: chainHoleRef)
                    i += 1
                }
                // an array literal types as `Array[E]` from its first element (exprType
                // reports a literal as unknown for the CHECK passes — element-wise checking
                // — so the refinement lives here, not in exprType). An empty literal stays
                // 0; its Let-context declared type records it (recordStmt).
                if elems.len > 0U64 {
                    val eRef: U64 = self.parametricExprTerm(exprId: self.exprAt(exprs: elems, index: 0U64))
                    if eRef != 0U64 {
                        if exprId < self.arena.semanticExprTypes.count() {
                            self.recordSemanticExprTerm(exprId: exprId, term: self.arrayRefOfElem(elemRef: eRef))
                        }
                    }
                }
                self.recordSemanticAggregate(exprId: exprId)
            }
            Expr.Index(val base, val index) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                self.recordExpr(exprId: index, chainHoleRef: chainHoleRef)
                // Array/Buffer indexing is equally structural: the selected
                // element term is an existing child of the recorded receiver.
                // Other index forms lower through a final method callable and
                // intentionally remain outside this direct type-term rule.
                mut val baseTerm: U64 = self.parametricExprTerm(exprId: base)
                // A selected inherited method can expose its exact result to
                // the frontend type query before its CallTemplate result has
                // been recorded as a direct TypeTerm. Normalize that query at
                // this producer boundary: `u.bytes()[0]` is structurally the
                // U8 child of Array[U8], never a Mono inference problem.
                if baseTerm == 0U64 {
                    baseTerm = self.typedIrRefOfInfo(ti: self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef))
                }
                if baseTerm != 0U64 && baseTerm < self.arena.types.count() {
                    val baseTy: TypeRef = self.arena.types[baseTerm]
                    if baseTy.args.count() == 1U64 {
                        if rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Array") || rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Buffer") {
                            self.recordSemanticExprTerm(exprId: exprId, term: baseTy.args[0])
                        }
                    }
                }
            }
            Expr.Cast(val operand, tyStart: _, tyLen: _, val ty) => {
                self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef)
                // `as Target` is an explicit source-level type boundary; Lower
                // has resolved Target into `ty`, so this is not an inference
                // query. Recording it directly preserves a generic/view term
                // exactly as written for every later BodyInstance.
                self.recordSemanticExprTerm(exprId: exprId, term: ty)
            }
            Expr.MatchExpr(val scrut, val arms) => {
                self.recordExpr(exprId: scrut, chainHoleRef: chainHoleRef)
                mut val ai: U64 = 0
                while ai < arms.len {
                    val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: self.typeOf(id: scrut))
                    self.recordBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
                // The type checker verifies that all non-diverging arms agree.
                // Select the first recorded value solely as that canonical
                // term; resolving it after `popLocals` would lose arm payload
                // binders such as `Choice.First(value: Box[T])`.
                mut val resultArm: U64 = 0U64
                while resultArm < arms.len {
                    val arm: MatchArm = self.matchArmAt(arms: arms, index: resultArm)
                    if !(arm.isDiverge) {
                        self.recordValueBlockResult(exprId: exprId, blockId: arm.body)
                        resultArm = arms.len
                    } else {
                        resultArm += 1U64
                    }
                }
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.recordExpr(exprId: cond, chainHoleRef: chainHoleRef)
                self.recordBlock(blkId: thenBlk)
                self.recordBlock(blkId: elseBlk)
                self.recordValueBlockResult(exprId: exprId, blockId: thenBlk)
            }
            Expr.OptChain(val base, val cont) => {
                // This form rewrites itself to MatchExpr below. Preserve its
                // pre-rewrite legacy adapter before changing the AST node;
                // other forms use the common post-order fallback.
                if exprId < self.arena.semanticExprTypes.count() {
                    self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                }
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                mut val baseInfo: TypeInfo = self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef)
                mut val baseRef: U64 = self.parametricExprTerm(exprId: base)
                if baseRef == 0U64 {
                    baseRef = self.typedIrRefOfInfo(ti: baseInfo)
                }
                if baseRef != 0U64 && baseRef < self.arena.types.count() {
                    val baseTerm: TypeRef = self.arena.types[baseRef]
                    // The structural semantic term is authoritative over the
                    // legacy TypeInfo adapter: nested `?.` has already become
                    // MatchExpr here, whose lexical arm binding cannot be
                    // re-derived outside the desugar.
                    baseInfo = self.typeInfoOfRef(ref: baseRef)
                    val valueIndex: U64 = self.chainValueArgIndex(headStart: baseTerm.nameStart, headLen: baseTerm.nameLen)
                    if valueIndex < baseTerm.args.count() {
                        self.recordExpr(exprId: cont, chainHoleRef: baseTerm.args[valueIndex])
                    }
                }
                // `?.` is a semantic desugar, not a late Mono recovery. Record
                // has now walked its base/continuation in the right lexical
                // environment and owns their parametric terms; normalize before
                // Verify can observe this shared AST node. Initial collection
                // deliberately does not do this because these terms do not yet
                // exist there.
                if baseInfo.kind == 2I64 && baseRef != 0U64 && baseRef < self.arena.types.count() {
                    if self.typeConformsToChain(nameStart: baseInfo.nameStart, nameLen: baseInfo.nameLen) {
                        val stageRef: U64 = self.chainStageResultRef(baseRef: baseRef, cont: cont)
                        if stageRef != 0U64 {
                            val baseTerm: TypeRef = self.arena.types[baseRef]
                            val valueIndex: U64 = self.chainValueArgIndex(headStart: baseTerm.nameStart, headLen: baseTerm.nameLen)
                            if valueIndex < baseTerm.args.count() {
                                self.decls.chainSites.append(<ChainSite exprId=exprId stageRef=stageRef valueRef=baseTerm.args[valueIndex] />)
                            }
                        }
                        self.rewriteOptChainToChainMatch(exprId: exprId, base: base, cont: cont, memberStart: self.exprOffset(id: exprId), headStart: baseInfo.nameStart, headLen: baseInfo.nameLen, stageRef: stageRef)
                    }
                }
            }
            Expr.ChainHole => {
                // The unique enclosing chain stage supplies this term explicitly;
                // it is never ambient resolver state.
                self.recordSemanticExprTerm(exprId: exprId, term: chainHoleRef)
            }
            Expr.Try(val expr) => {
                self.recordExpr(exprId: expr, chainHoleRef: chainHoleRef)
                val resultTerm: U64 = self.parametricExprTerm(exprId: expr)
                if self.isGenericInst(ref: resultTerm) {
                    val result: TypeRef = self.arena.types[resultTerm]
                    if result.args.count() > 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: result.args[0])
                    }
                }
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                val refTerm: U64 = self.parametricExprTerm(exprId: base)
                if self.isStrongRefInst(ref: refTerm) {
                    val reference: TypeRef = self.arena.types[refTerm]
                    if reference.args.count() > 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: self.fieldTypeRefOfReceiver(receiverRef: reference.args[0], fieldStart: nameStart, fieldLen: nameLen))
                    }
                }
            }
            Expr.Deref(val base) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                val refTerm: U64 = self.parametricExprTerm(exprId: base)
                if self.isStrongRefInst(ref: refTerm) {
                    val reference: TypeRef = self.arena.types[refTerm]
                    if reference.args.count() > 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: reference.args[0])
                    }
                }
            }
            Expr.Move(val operand, isBorrow: _) => {
                self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef)
                self.recordSemanticExprTerm(exprId: exprId, term: self.parametricExprTerm(exprId: operand))
            }
            Expr.Await(val operand) => {
                self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef)
                val promiseTerm: U64 = self.parametricExprTerm(exprId: operand)
                if promiseTerm != 0U64 && promiseTerm < self.arena.types.count() {
                    val promise: TypeRef = self.arena.types[promiseTerm]
                    if promise.args.count() > 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: promise.args[0])
                    }
                }
            }
            // a closure body is walked IN PLACE, its params scoped over the enclosing
            // locals (captures resolve to the enclosing bindings) — the hole the check
            // passes leave open (neither checkGenericBodies nor this pass's caller
            // descends into closures for scope reasons; here scoping is all we need).
            Expr.Closure(val params, hasRet: _, retStart: _, retLen: _, retIsArray: _, val retTy, val body) => {
                // A closure literal has an ordinary semantic function TypeTerm.
                // Recording it here lets a concrete generic-call inference
                // consume the same parametric producer as every other
                // expression instead of reconstructing it through exprType.
                self.recordSemanticExprTerm(exprId: exprId, term: self.closureFnTypeRef(params: params, retTy: retTy))
                val mark: U64 = self.scopeMark()
                // A closure owns a distinct Mono body key.  Its CallTemplates
                // must use the same owner while retaining the enclosing lexical
                // locals for capture typing; otherwise finalization searches the
                // closure key and finds only a Pending template recorded under
                // the parent function.
                val savedCheckFn: U64 = self.cur.checkFn
                self.cur.checkFn = self.closureBodyKey(closureId: exprId)
                mut val pi: U64 = 0
                while pi < params.count() {
                    val p: Param = params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    pi += 1
                }
                self.recordBlock(blkId: body)
                self.cur.checkFn = savedCheckFn
                self.popLocals(mark: mark)
            }
            _ => {}
        }
        if exprId < self.arena.semanticExprTypes.count() {
            if self.semanticExprTerm(exprId: exprId) == 0U64 {
                self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
            }
        }
        // Record only after child terms and fallback literal adapters are
        // available. The template is the unique semantic input for operator
        // finalization; Mono must not reopen this Binary/Unary expression.
        match self.arena.exprs[exprId] {
            Expr.Unary(val op, val operand) => {
                val operands: Array[U64] = [operand]
            self.recordOperatorTemplate(exprId: exprId, op: op, operandExprs: operands, isUnary: true)
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                val operands: Array[U64] = [lhs, rhs]
            self.recordOperatorTemplate(exprId: exprId, op: op, operandExprs: operands, isUnary: false)
            }
            _ => {}
        }
    }

    // Mirror checkBoundsStmt's SCOPE maintenance (Let/For/Match binds) without any of
    // its checks — the local env drives typeOf, so it must match what the backend's
    // own local table will hold at emission.
    inout fn recordStmt(stmtId: U64) {
        match self.arena.stmts[stmtId] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                self.recordExpr(exprId: init)
                self.recordSemanticExprExpectedResult(exprId: init, expectedTerm: ty)
                self.recordArrayLitCtx(exprId: init, ctxRef: ty)
                // an UNANNOTATED let (`mut val it = self`) infers its local type from the
                // init (rustc-style local inference, incl. an array-literal init) —
                // without this every later read of the local is unknown. The declared
                // annotation wins when present (inferLetType passes it through). Shared
                // with the scan pass so both see the same local type.
                val le: LetEff = self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
                // An unannotated binding is a semantic boundary: retain the
                // exact TypeTerm produced for its initializer.  Reopening
                // legacy `typeOf` here collapses a structurally-grounded
                // result such as `(first: I64, second: I64)` back to the
                // method declaration's naked `T`, so every later generic
                // call observes the wrong argument term.  The legacy LetEff
                // fields remain the spelling/kind adapter; `ty` is the
                // semantic source of truth whenever Record supplied one.
                mut val localTerm: U64 = le.ty
                if ty == 0U64 {
                    val initTerm: U64 = self.parametricExprTerm(exprId: init)
                    if initTerm != 0U64 { localTerm = initTerm }
                }
                self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: localTerm, isInout: false, isMut: mutable, owned: true)
            }
            Stmt.Assign(val target, val value) => {
                self.recordExpr(exprId: target)
                self.recordExpr(exprId: value)
                val expected: U64 = self.parametricExprTerm(exprId: target)
                self.recordSemanticExprExpectedResult(exprId: value, expectedTerm: expected)
                self.recordArrayLitCtx(exprId: value, ctxRef: expected)
            }
            Stmt.ExprStmt(val expr) => { self.recordExpr(exprId: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                if hasValue {
                    self.recordExpr(exprId: value)
                    if self.cur.checkFn < self.arena.funcs.count() {
                        val expected: U64 = self.arena.funcs[self.cur.checkFn].retTy
                        self.recordSemanticExprExpectedResult(exprId: value, expectedTerm: expected)
                        self.recordArrayLitCtx(exprId: value, ctxRef: expected)
                    }
                }
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.recordExpr(exprId: cond)
                self.recordBlock(blkId: thenBlk)
                if hasElse {
                    self.recordBlock(blkId: elseBlk)
                }
            }
            Stmt.While(val cond, val body) => {
                self.recordExpr(exprId: cond)
                self.recordBlock(blkId: body)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, inclusive: _, val iter, val rangeHi, val body, val isStruct, patStart: _, patLen: _, val binds) => {
                val forMark: U64 = self.scopeMark()
                self.recordExpr(exprId: iter)
                if isRange {
                    self.recordExpr(exprId: rangeHi)
                    // the annotated var type if any (`for i: U64 in a..b`); an unannotated
                    // range var stays untyped here, same as the check pass.
                    self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: varTyStart, tyLen: varTyLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    val et: TypeInfo = self.typeOf(id: iter)
                    val iterTerm: U64 = self.parametricExprTerm(exprId: iter)
                    val iteratorReceiver: CallTemplateReceiver = self.protocolReceiverTemplateForExpr(exprId: iter)
                    val nextReceiver: CallTemplateReceiver = <CallTemplateReceiver.PriorProtocolResult slot=1U64 />
                    self.recordProtocolCallTemplate(stmtId: stmtId, slot: 1U64, receiver: iteratorReceiver)
                    self.recordProtocolCallTemplate(stmtId: stmtId, slot: 2U64, receiver: nextReceiver)
                    self.recordForItemTypeRecipe(stmtId: stmtId)
                    val semanticItem: U64 = self.iterableItemTerm(iterExpr: iter, iterTerm: iterTerm)
                    if isStruct {
                        if semanticItem != 0U64 {
                            self.addForStructBinds(et: self.typeInfoOfRef(ref: semanticItem), binds: binds)
                        } else {
                            self.addForStructBinds(et: et, binds: binds)
                        }
                    } else {
                        if semanticItem != 0U64 {
                            val itemTi: TypeInfo = self.typeInfoOfRef(ref: semanticItem)
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: itemTi.nameStart, tyLen: itemTi.nameLen, isArray: itemTi.kind == 3, ty: semanticItem, isInout: false, isMut: false, owned: false)
                        } else if et.kind == 3 {
                            // carry the ELEMENT ref off the array's carried `Array[E]`
                            // (an `any P` / generic-inst element loses its structure as
                            // a bare name — `for s in shapes` then can't dispatch on s).
                            mut val fer: U64 = 0
                            if et.ref != 0U64 && et.ref < self.arena.types.count() {
                                val fat: TypeRef = self.arena.types[et.ref]
                                if fat.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: fat.nameStart, len: fat.nameLen, kw: "Array") {
                                    fer = fat.args[0]
                                }
                            }
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: fer, isInout: false, isMut: false, owned: false)
                        } else {
                            val elemTi: TypeInfo = self.iterableItemInfo(et: et)
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                        }
                    }
                }
                self.recordBlock(blkId: body)
                self.popLocals(mark: forMark)
            }
            Stmt.Match(val scrut, val arms) => {
                self.recordExpr(exprId: scrut)
                mut val ai: U64 = 0
                while ai < arms.len {
                    val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: self.typeOf(id: scrut))
                    self.recordBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Stmt.Panic(val msg, offset: _) => { self.recordExpr(exprId: msg) }
            Stmt.Give(val value) => { self.recordExpr(exprId: value) }
            Stmt.Break(offset: _) => {}
            Stmt.Continue(offset: _) => {}
        }
    }

    inout fn recordBlock(blkId: U64) {
        val mark: U64 = self.scopeMark()
        mut val i: U64 = 0
        while i < self.blockStmtCount(blkId: blkId) {
            self.recordStmt(stmtId: self.blockStmtAt(blkId: blkId, index: i))
            i += 1
        }
        self.popLocals(mark: mark)
    }

    // Record every function body's parametric types. Skips: externs / requirement
    // signatures (body 0 is the no-body sentinel), and provided-method COPIES
    // (srcTraitId != 0) — a copy SHARES the trait template's body, so recording it
    // would overwrite the template's `Self` forms with one conformer's concrete
    // types and corrupt every other conformer. The template's recording (Self/T
    // parametric) serves all of them via groundTypeRef at read.
    inout fn recordParametricTypes(recordCallTemplates: Bool = false) {
        val noParams: Array[Bind] = []
        val noArgs: Array[U64] = []
        // global initializers first (`val nums: Array[I64] = [...]` at module level):
        // their exprs are emitted too, and an array-literal init has no other record
        // point (the fallback typeOf reports a literal as unknown). recordStmt(Let)
        // adds each global as a local as it goes, so a later init reading an earlier
        // global resolves.
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.recvInstRef = 0
        self.cur.selfRef = 0
        self.cur.itemRef = 0
        self.cur.typeParams = noParams
        self.cur.typeArgs = noArgs
        self.cur.recordCallTemplates = recordCallTemplates
        self.cur.checkFn = self.arena.funcs.count()
        mut val gvi: U64 = 0
        while gvi < self.arena.globals.count() {
            self.recordStmt(stmtId: self.arena.globals[gvi].letStmt)
            gvi += 1
        }
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            // A trait-provided body is copied per conformance, but its lexical
            // source body owns one shared CallTemplate set.  Skipping every
            // `srcTraitId` body left operators in provided methods without the
            // semantic template that Mono is required to consume.  Record the
            // source declaration once and skip only generated provided copies.
            if !(f.isExtern) && f.body != 0U64 && !(f.isProvided && f.srcTraitId != 0U64) {
                self.cur.locals = []
                self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: f))
                self.cur.hasRecv = f.hasRecv
                self.cur.recvStart = f.recvStart
                self.cur.recvLen = f.recvLen
                self.cur.extId = f.extId
                self.cur.selfInout = f.selfInout
                self.cur.recvInstRef = 0
                self.cur.selfRef = self.parametricSelfRef(f: f)
                self.cur.itemRef = 0
                // This is a declaration-time walk: generic binders are in
                // lexical scope but have no concrete arguments. Keeping the
                // Func's ParamIds here lets `value: Optional[Box[T]]` record
                // its complete parametric term. Omitting them made the record
                // miss the base of a `?.` chain, after which Mono had to read
                // an incidental concrete `typeOf` result and froze T to the
                // first instantiated body.
                self.cur.typeParams = f.typeParams
                self.cur.typeArgs = noArgs
                self.cur.checkFn = fi
                mut val pi: U64 = 0
                while pi < f.params.count() {
                    val p: Param = f.params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    if p.hasDefault {
                        self.recordExpr(exprId: p.defaultExpr)
                    }
                    pi += 1
                }
                self.recordBlock(blkId: f.body)
            }
            fi += 1
        }
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.recvInstRef = 0
        self.cur.selfRef = 0
        self.cur.itemRef = 0
        self.cur.typeParams = []
        self.cur.typeArgs = []
        self.cur.checkFn = self.arena.funcs.count()
        self.cur.recordCallTemplates = false
    }
}
