                try self.recordValueBlock(exprId: exprId, blockId: thenBlk, expectedTerm: normalizedContext)
                self.popLocals(mark: mark)
                try self.recordValueBlock(exprId: exprId, blockId: elseBlk, expectedTerm: normalizedContext)
            }
