// Part of name/type resolution (root: _.pw): typed-IR parametric-type
// recording (rustc writeback analog) — a DEDICATED, check-free walk over every
// function body that stores each expression's PARAMETRIC type in
// Comp.semanticExprTypes (type params left as `T`, trait `self` left as `Self`).
// The backend substitutes the instance's type args at read time (groundedTypeOf
// -> groundTypeRef), so one recording serves every instantiation.
//
// Why a separate pass (and not a hook inside checkGenericBodies / verify):
// recording needs an ENV the check passes must not have — a parametric
// `self` ref (`Dictionary[K,V]`) and coverage of non-generic bodies — and
// setting that env inside a check pass changes what the checks see (measured:
// reject tests started accepting). This walk runs exprType/typeOf only
// (read-only type recovery), never a compileErrorAt-carrying check.
//
// Body sharing is the reason the store is parametric: a generic template's one
// body is emitted per instance, and a trait provided method's body is SHARED by
// every conformer copy (instantiateProvidedMethods reuses `f.body`). Recording a
// concrete type would be wrong for every other instance — so copies
// (srcTraitId != 0) are skipped and the template records `Self`/`T` forms that
// ground differently under each instance env.
//
// Known holes (recorded as 0 -> groundedTypeOf falls back to typeCache/typeOf):
// backend-synthesized exprs (async lowering), generic struct field-default
// exprs, and any node this walk cannot scope (they surface in the Task-#3
// shadow and are closed there).

pub impl Comp {

    // The PARAMETRIC receiver ref for method `f` — the form `self` records as, chosen
    // so groundTypeRef at emission substitutes the instance: a trait provided-method
    // template records `Self` (grounds to the conformer via cur.selfRef); a generic
    // receiver records `Dictionary[K,V]` with the impl's own type-param names as args
    // (the first rcount of f.typeParams, matching emitOneGenMethod's env layout); a
    // non-generic receiver records its argless name ref (grounds to itself). No
    // receiver: 0.
    inout fn parametricSelfRef(f: Func) -> U64 {
        // an assoc fn has no `self` value (hasRecv false) but its recv spans still
        // name the owning type, and its `Self`-typed params (`assoc fn eq(lhs~:
        // Self, …)`) must resolve to the same parametric receiver.
        if !(f.hasRecv) && f.recvLen == 0U64 {
            return 0U64
        }
        if self.methodRecvIsTrait(f: f) {
            val sb: Bind = self.kwSpan(kw: "Self", kwLen: 4)
            return self.simpleTypeRef(nameStart: sb.nameStart, nameLen: sb.nameLen)
        }
        // An extension method's lexical `self` is `Recv#Ext`.  A conferred
        // witness does not inherit a caller's conformance-path view: its shared
        // body is checked against the surface written at its declaration.
        val vid: U64 = f.extId
        mut val rcount: U64 = 0
        val si: U64 = self.anyStructIndex(nameStart: f.recvStart, nameLen: f.recvLen)
        if si < self.arena.structs.count() {
            rcount = self.arena.structs[si].typeParams.count()
        } else {
            val ei: U64 = self.anyEnumIndex(nameStart: f.recvStart, nameLen: f.recvLen)
            if ei < self.arena.enums.count() {
                rcount = self.arena.enums[ei].typeParams.count()
            }
        }
        mut val args: Array[U64] = []
        mut val i: U64 = 0
        while i < rcount {
            if i < f.typeParams.count() {
                args.append(self.simpleTypeRef(nameStart: f.typeParams[i].nameStart, nameLen: f.typeParams[i].nameLen))
            }
            i += 1
        }
        return self.pushType(t: <TypeRef nameStart=f.recvStart nameLen=f.recvLen args=args viewExtId=vid />)
    }

    // Context-type an array literal from its expected type (the record-pass analog of
    // bidirectional literal typing): an EMPTY `[]` has no element to derive a type
    // from, and Plew requires a value's type to equal its context's declared type, so
    // the context ref IS the literal's type. A no-op for any other node / an already
    // recorded literal / no context.
    inout fn recordArrayLitCtx(exprId: U64, ctxRef: U64) {
        if ctxRef == 0U64 || exprId >= self.arena.semanticExprTypes.count() {
            return
        }
        if self.semanticExprTerm(exprId: exprId) != 0U64 {
            return
        }
        match self.arena.exprs[exprId] {
            Expr.Array(elems: _) => { self.recordSemanticExprTerm(exprId: exprId, term: ctxRef) }
            _ => {}
        }
    }

    // Record an expression under an optional-chain payload supplied by its
    // unique enclosing chain stage. The payload is a structural child input,
    // not Cursor state: ordinary expressions use 0, and every continuation
    // descendant receives the same explicit parametric term.
    inout fn recordExpr(exprId: U64, chainHoleRef: U64 = 0U64) {
        // The flat TypeRef carrier cannot represent an anonymous-record value
        // and its fields as one semantic node yet.  Retain the legacy adapter
        // record for every expression, then let structural cases below refine
        // the exact term where the receiver already exposes one.
        if exprId < self.arena.semanticExprTypes.count() {
            self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
        }
        match self.arena.exprs[exprId] {
            // A local binding's declared TypeRef is the lexical source of
            // truth for an identifier. Record it directly after the legacy
            // adapter so a parametric annotation (`Optional[Box[T]]`) cannot
            // be collapsed to its head spelling by TypeInfo recovery.
            Expr.Ident(val start, val len) => {
                val localIdx: U64 = self.localIndexByName(start: start, len: len)
                if localIdx < self.cur.locals.count() {
                    val local: Local = self.cur.locals[localIdx]
                    if local.ty != 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: local.ty)
                    } else if exprId < self.arena.semanticExprTypes.count() {
                        self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                    }
                } else if exprId < self.arena.semanticExprTypes.count() {
                    // `self` and a small number of legacy global bindings do
                    // not live in locals; retain their established query until
                    // their explicit semantic nodes are introduced.
                    self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                }
            }
            Expr.Unary(op: _, val operand) => { self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef) }
            Expr.Binary(op: _, val lhs, val rhs) => {
                self.recordExpr(exprId: lhs, chainHoleRef: chainHoleRef)
                self.recordExpr(exprId: rhs, chainHoleRef: chainHoleRef)
            }
            Expr.Call(nameStart: _, nameLen: _, val args) => {
                mut val i: U64 = 0
                while i < args.count() {
                    self.recordExpr(exprId: args[i].expr, chainHoleRef: chainHoleRef)
                    i += 1
                }
                val cfi: U64 = self.resolvedCallee(id: exprId)
                if cfi < self.arena.funcs.count() {
                    val cf: Func = self.arena.funcs[cfi]
                    val ps: Array[Param] = cf.params
                    // a generic callee's parametric param (`xs: Array[T]`) is grounded
                    // under THIS call's inferred type args before use as a literal
                    // context; only a GROUND context applies — the callee's own `T`
                    // means nothing in this body's env, and recording it sends emission
                    // into self-referential grounding (mirrors the Method arm's gate).
                    mut val canGround: Bool = false
                    mut val inferred: Array[U64] = []
                    if cf.typeParams.count() > 0U64 {
                        inferred = self.inferFnArgs(f: cf, args: args)
                        // only a COMPLETE inference grounds (a partially-inferred env
                        // substitutes 0 for the unfound param and the hole would pass
                        // the ground gate as an empty-named ref).
                        canGround = self.fnArgsAllGround(args: inferred)
                    }
                    mut val k: U64 = 0
                    while k < args.count() {
                        if k < ps.count() {
                            mut val cctx: U64 = ps[k].ty
                            if cctx != 0U64 && canGround && !(self.tyRefIsGround(ref: cctx)) {
                                val savedP: Array[Bind] = self.cur.typeParams
                                val savedA: Array[U64] = self.cur.typeArgs
                                self.cur.typeParams = cf.typeParams
                                self.cur.typeArgs = inferred
                                cctx = self.groundTypeRef(ref: cctx)
                                self.cur.typeParams = savedP
                                self.cur.typeArgs = savedA
                            }
                            if cctx != 0U64 && self.tyRefIsGround(ref: cctx) {
                                self.recordArrayLitCtx(exprId: args[k].expr, ctxRef: cctx)
                            }
                        }
                        k += 1
                    }
                }
            }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef)
                mut val i: U64 = 0
                while i < args.count() {
                    self.recordExpr(exprId: args[i].expr, chainHoleRef: chainHoleRef)
                    i += 1
                }
                // context-type an array-literal argument from the resolved method's
                // declared param (mirrors the Call arm). A kind-3 receiver's methods
                // live on `Array`; a generic-receiver param (`append(value: T)`) is
                // grounded under the receiver's instance first — and only a GROUND
                // context applies (the callee's own `T` means nothing in this body's
                // env, so recording it would mis-ground at emission).
                val mrt: TypeInfo = self.typeOf(id: recv)
                mut val mrS: U64 = mrt.nameStart
                mut val mrL: U64 = mrt.nameLen
                if mrt.kind == 3 {
                    val mar: Bind = self.kwSpan(kw: "Array", kwLen: 5)
                    mrS = mar.nameStart
                    mrL = mar.nameLen
                }
                if mrL > 0U64 && !(self.isTypeParamOf(fnIdx: self.cur.checkFn, start: mrt.nameStart, len: mrt.nameLen)) {
                    val mmi: U64 = self.resolveMethodFinal(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
                    if mmi < self.arena.funcs.count() {
                        val mps: Array[Param] = self.arena.funcs[mmi].params
                        mut val mk: U64 = 0
                        while mk < args.count() {
                            if mk < mps.count() {
                                mut val mctx: U64 = mps[mk].ty
                                if mrt.ref != 0U64 {
                                    mctx = self.groundUnderInst(instRef: mrt.ref, tyRef: mctx)
                                }
                                if mctx != 0U64 && self.tyRefIsGround(ref: mctx) {
                                    self.recordArrayLitCtx(exprId: args[mk].expr, ctxRef: mctx)
                                }
                            }
                            mk += 1
                        }
                    }
                }
            }
            Expr.ExtMethod(val recv, source: _, nameStart: _, nameLen: _, val args) => {
                self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef)
                mut val i: U64 = 0
                while i < args.count() {
                    self.recordExpr(exprId: args[i].expr, chainHoleRef: chainHoleRef)
                    i += 1
                }
            }
            Expr.ExtView(val recv, source: _, strip: _) => { self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef) }
            Expr.Field(val base, val nameStart, val nameLen) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                // Field selection is a structural type-term operation. Once the
                // receiver has been recorded, derive the exact field term here
                // rather than forcing every BodyInstance to re-walk Field in
                // groundedTypeOf. `groundUnderInst` preserves a symbolic
                // receiver argument (Box[T]) for later body grounding.
                val baseTerm: U64 = self.parametricExprTerm(exprId: base)
                val fieldTerm: U64 = self.fieldTypeRefOfReceiver(receiverRef: baseTerm, fieldStart: nameStart, fieldLen: nameLen)
                if fieldTerm != 0U64 {
                    self.recordSemanticExprTerm(exprId: exprId, term: fieldTerm)
                } else if exprId < self.arena.semanticExprTypes.count() {
                    // Non-struct field syntax is still on the legacy carrier
                    // until enum/projection nodes become first-class terms.
                    self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                }
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                mut val i: U64 = 0
                while i < fields.count() {
                    self.recordExpr(exprId: fields[i].value, chainHoleRef: chainHoleRef)
                    val ft: TypeInfo = self.makeFieldType(typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: fields[i].nameStart, fieldLen: fields[i].nameLen)
                    mut val ctxRef: U64 = self.typedIrRefOfInfo(ti: ft)
                    // a generic construction's field context is the DECLARED field type
                    // (`items: Array[T]` on `<Box[I64] …/>`) — ground it under the
                    // instance so the literal records `Array[I64]`, and never store a
                    // still-parametric context (a non-instance Make leaves it as-is).
                    if ctxRef != 0U64 && ty != 0U64 && self.isGenericInst(ref: ty) {
                        ctxRef = self.groundUnderInst(instRef: ty, tyRef: ctxRef)
                    }
                    if ctxRef != 0U64 && !(self.tyRefIsGround(ref: ctxRef)) {
                        ctxRef = 0
                    }
                    self.recordArrayLitCtx(exprId: fields[i].value, ctxRef: ctxRef)
                    i += 1
                }
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.count() {
                    self.recordExpr(exprId: elems[i], chainHoleRef: chainHoleRef)
                    i += 1
                }
                // an array literal types as `Array[E]` from its first element (exprType
                // reports a literal as unknown for the CHECK passes — element-wise checking
                // — so the refinement lives here, not in exprType). An empty literal stays
                // 0; its Let-context declared type records it (recordStmt).
                if elems.count() > 0U64 {
                    val eRef: U64 = self.typedIrRefOfInfo(ti: self.exprType(id: elems[0]))
                    if eRef != 0U64 {
                        if exprId < self.arena.semanticExprTypes.count() {
                            self.recordSemanticExprTerm(exprId: exprId, term: self.arrayRefOfElem(elemRef: eRef))
                        }
                    }
                }
            }
            Expr.Index(val base, val index) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                self.recordExpr(exprId: index, chainHoleRef: chainHoleRef)
                // Array/Buffer indexing is equally structural: the selected
                // element term is an existing child of the recorded receiver.
                // Other index forms lower through a final method callable and
                // intentionally remain outside this direct type-term rule.
                val baseTerm: U64 = self.parametricExprTerm(exprId: base)
                if baseTerm != 0U64 && baseTerm < self.arena.types.count() {
                    val baseTy: TypeRef = self.arena.types[baseTerm]
                    if baseTy.args.count() == 1U64 {
                        if rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Array") || rangeEquals(bytes: self.arena.bytes, start: baseTy.nameStart, len: baseTy.nameLen, kw: "Buffer") {
                            self.recordSemanticExprTerm(exprId: exprId, term: baseTy.args[0])
                        } else if exprId < self.arena.semanticExprTypes.count() {
                            self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                        }
                    } else if exprId < self.arena.semanticExprTypes.count() {
                        self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                    }
                } else if exprId < self.arena.semanticExprTypes.count() {
                    self.recordSemanticExprInfo(exprId: exprId, ti: self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef))
                }
            }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef) }
            Expr.MatchExpr(val scrut, val arms) => {
                self.recordExpr(exprId: scrut, chainHoleRef: chainHoleRef)
                mut val ai: U64 = 0
                while ai < arms.count() {
                    val a: MatchArm = arms[ai]
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: self.typeOf(id: scrut))
                    self.recordBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.recordExpr(exprId: cond, chainHoleRef: chainHoleRef)
                self.recordBlock(blkId: thenBlk)
                self.recordBlock(blkId: elseBlk)
            }
            Expr.OptChain(val base, val cont) => {
                self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                val baseInfo: TypeInfo = self.exprTypeWithChainHole(id: base, chainHoleRef: chainHoleRef)
                val baseRef: U64 = self.typedIrRefOfInfo(ti: baseInfo)
                if baseRef != 0U64 && baseRef < self.arena.types.count() {
                    val baseTerm: TypeRef = self.arena.types[baseRef]
                    val valueIndex: U64 = self.chainValueArgIndex(headStart: baseTerm.nameStart, headLen: baseTerm.nameLen)
                    if valueIndex < baseTerm.args.count() {
                        self.recordExpr(exprId: cont, chainHoleRef: baseTerm.args[valueIndex])
                    }
                }
            }
            Expr.ChainHole => {}
            Expr.Try(val expr) => { self.recordExpr(exprId: expr, chainHoleRef: chainHoleRef) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { self.recordExpr(exprId: base, chainHoleRef: chainHoleRef) }
            Expr.Deref(val base) => { self.recordExpr(exprId: base, chainHoleRef: chainHoleRef) }
            Expr.Move(val operand, isBorrow: _) => { self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef) }
            Expr.Await(val operand) => { self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef) }
            // a closure body is walked IN PLACE, its params scoped over the enclosing
            // locals (captures resolve to the enclosing bindings) — the hole the check
            // passes leave open (neither checkGenericBodies nor this pass's caller
            // descends into closures for scope reasons; here scoping is all we need).
            Expr.Closure(val params, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, val body) => {
                val mark: U64 = self.scopeMark()
                mut val pi: U64 = 0
                while pi < params.count() {
                    val p: Param = params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    pi += 1
                }
                self.recordBlock(blkId: body)
                self.popLocals(mark: mark)
            }
            _ => {}
        }
    }

    // Mirror checkBoundsStmt's SCOPE maintenance (Let/For/Match binds) without any of
    // its checks — the local env drives typeOf, so it must match what the backend's
    // own local table will hold at emission.
    inout fn recordStmt(stmtId: U64) {
        match self.arena.stmts[stmtId] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                self.recordExpr(exprId: init)
                self.recordArrayLitCtx(exprId: init, ctxRef: ty)
                // an UNANNOTATED let (`mut val it = self`) infers its local type from the
                // init (rustc-style local inference, incl. an array-literal init) —
                // without this every later read of the local is unknown. The declared
                // annotation wins when present (inferLetType passes it through). Shared
                // with the scan pass so both see the same local type.
                val le: LetEff = self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
                self.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: true)
            }
            Stmt.Assign(val target, val value) => {
                self.recordExpr(exprId: target)
                self.recordExpr(exprId: value)
                self.recordArrayLitCtx(exprId: value, ctxRef: self.typedIrRefOfInfo(ti: self.typeOf(id: target)))
            }
            Stmt.ExprStmt(val expr) => { self.recordExpr(exprId: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                if hasValue {
                    self.recordExpr(exprId: value)
                    if self.cur.checkFn < self.arena.funcs.count() {
                        self.recordArrayLitCtx(exprId: value, ctxRef: self.arena.funcs[self.cur.checkFn].retTy)
                    }
                }
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.recordExpr(exprId: cond)
                self.recordBlock(blkId: thenBlk)
                if hasElse {
                    self.recordBlock(blkId: elseBlk)
                }
            }
            Stmt.While(val cond, val body) => {
                self.recordExpr(exprId: cond)
                self.recordBlock(blkId: body)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, inclusive: _, val iter, val rangeHi, val body, val isStruct, patStart: _, patLen: _, val binds) => {
                val forMark: U64 = self.scopeMark()
                self.recordExpr(exprId: iter)
                if isRange {
                    self.recordExpr(exprId: rangeHi)
                    // the annotated var type if any (`for i: U64 in a..b`); an unannotated
                    // range var stays untyped here, same as the check pass.
                    self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: varTyStart, tyLen: varTyLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    val et: TypeInfo = self.typeOf(id: iter)
                    if isStruct {
                        self.addForStructBinds(et: et, binds: binds)
                    } else {
                        if et.kind == 3 {
                            // carry the ELEMENT ref off the array's carried `Array[E]`
                            // (an `any P` / generic-inst element loses its structure as
                            // a bare name — `for s in shapes` then can't dispatch on s).
                            mut val fer: U64 = 0
                            if et.ref != 0U64 && et.ref < self.arena.types.count() {
                                val fat: TypeRef = self.arena.types[et.ref]
                                if fat.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: fat.nameStart, len: fat.nameLen, kw: "Array") {
                                    fer = fat.args[0]
                                }
                            }
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: fer, isInout: false, isMut: false, owned: false)
                        } else {
                            val elemTi: TypeInfo = self.iterableItemInfo(et: et)
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                        }
                    }
                }
                self.recordBlock(blkId: body)
                self.popLocals(mark: forMark)
            }
            Stmt.Match(val scrut, val arms) => {
                self.recordExpr(exprId: scrut)
                mut val ai: U64 = 0
                while ai < arms.count() {
                    val a: MatchArm = arms[ai]
                    val mark: U64 = self.scopeMark()
                    self.scanAddArmBinds(a: a, scrutTi: self.typeOf(id: scrut))
                    self.recordBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Stmt.Panic(val msg, offset: _) => { self.recordExpr(exprId: msg) }
            Stmt.Give(val value) => { self.recordExpr(exprId: value) }
            Stmt.Break(offset: _) => {}
            Stmt.Continue(offset: _) => {}
        }
    }

    inout fn recordBlock(blkId: U64) {
        val mark: U64 = self.scopeMark()
        val stmts: Array[U64] = self.arena.blocks[blkId].stmts
        mut val i: U64 = 0
        while i < stmts.count() {
            self.recordStmt(stmtId: stmts[i])
            i += 1
        }
        self.popLocals(mark: mark)
    }

    // Record every function body's parametric types. Skips: externs / requirement
    // signatures (body 0 is the no-body sentinel), and provided-method COPIES
    // (srcTraitId != 0) — a copy SHARES the trait template's body, so recording it
    // would overwrite the template's `Self` forms with one conformer's concrete
    // types and corrupt every other conformer. The template's recording (Self/T
    // parametric) serves all of them via groundTypeRef at read.
    inout fn recordParametricTypes() {
        val noParams: Array[Bind] = []
        val noArgs: Array[U64] = []
        // global initializers first (`val nums: Array[I64] = [...]` at module level):
        // their exprs are emitted too, and an array-literal init has no other record
        // point (the fallback typeOf reports a literal as unknown). recordStmt(Let)
        // adds each global as a local as it goes, so a later init reading an earlier
        // global resolves.
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.recvInstRef = 0
        self.cur.selfRef = 0
        self.cur.itemRef = 0
        self.cur.typeParams = noParams
        self.cur.typeArgs = noArgs
        self.cur.checkFn = self.arena.funcs.count()
        mut val gvi: U64 = 0
        while gvi < self.arena.globals.count() {
            self.recordStmt(stmtId: self.arena.globals[gvi].letStmt)
            gvi += 1
        }
        mut val fi: U64 = 0
        while fi < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[fi]
            if !(f.isExtern) && f.body != 0U64 && f.srcTraitId == 0U64 {
                self.cur.locals = []
                self.seedGlobalLocals(useMod: self.globalSeedModeFor(f: f))
                self.cur.hasRecv = f.hasRecv
                self.cur.recvStart = f.recvStart
                self.cur.recvLen = f.recvLen
                self.cur.extId = f.extId
                self.cur.selfInout = f.selfInout
                self.cur.recvInstRef = 0
                self.cur.selfRef = self.parametricSelfRef(f: f)
                self.cur.itemRef = 0
                // This is a declaration-time walk: generic binders are in
                // lexical scope but have no concrete arguments. Keeping the
                // Func's ParamIds here lets `value: Optional[Box[T]]` record
                // its complete parametric term. Omitting them made the record
                // miss the base of a `?.` chain, after which Mono had to read
                // an incidental concrete `typeOf` result and froze T to the
                // first instantiated body.
                self.cur.typeParams = f.typeParams
                self.cur.typeArgs = noArgs
                self.cur.checkFn = fi
                mut val pi: U64 = 0
                while pi < f.params.count() {
                    val p: Param = f.params[pi]
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                    if p.hasDefault {
                        self.recordExpr(exprId: p.defaultExpr)
                    }
                    pi += 1
                }
                self.recordBlock(blkId: f.body)
            }
            fi += 1
        }
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.selfRef = 0
        self.cur.itemRef = 0
        self.cur.checkFn = self.arena.funcs.count()
    }
}
