                // identity to close every write dependency.
                try self.recordAccessWriteFacet(readExpr: recv)
                try self.recordArgumentAccessUses(parentExpr: exprId, callee: methodCallee, args: args)

            }
            Expr.ExtMethod(recv: val recv, source: val source, nameStart: val nameStart, nameLen: val nameLen, args: val args) => {
                try self.recordExpr(exprId: recv, chainHoleRef: chainHoleRef)
                if self.assocRecvName(recv: recv).nameLen == 0U64 {
                    try self.checkResolvedViewValid(recv: recv, source: source, strip: false)
                }
                mut val i: U64 = 0
