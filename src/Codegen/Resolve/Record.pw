                    // legacy TypeInfo adapter: nested `?.` has already become
                    // MatchExpr here, whose lexical arm binding cannot be
                    // re-derived outside the desugar.
                    baseInfo = self.typeInfoOfRef(ref: baseRef)
                    val valueIndex: U64 = (try self.chainValueArgIndex(typeRef: baseRef))
                    if valueIndex < baseTerm.args.count() {
                        try self.recordExpr(exprId: cont, chainHoleRef: baseTerm.args[valueIndex])
                    }
                }
                // `?.` is a semantic desugar, not a late Mono recovery. Record
                // has now walked its base/continuation in the right lexical
                // environment and owns their parametric terms; normalize before
                // Verify can observe this shared AST node. Initial collection
                // deliberately does not do this because these terms do not yet
                // exist there.
                if baseInfo.kind == 2I64 && baseRef != 0U64 && baseRef < self.arena.typeCount() {
                    if (try self.typeConformsToChain(typeRef: baseRef)) {
                        val stageRef: U64 = (try self.chainStageResultRef(baseRef: baseRef, cont: cont))
                        if stageRef != 0U64 {
                            val baseTerm: TypeRef = self.arena.typeAt(index: baseRef)
                            val valueIndex: U64 = (try self.chainValueArgIndex(typeRef: baseRef))
                            if valueIndex < baseTerm.args.count() {
                                self.decls.chainSites.append(<ChainSite exprId=exprId stageRef=stageRef valueRef=baseTerm.args[valueIndex] />)
                            }
                        }
                        try self.rewriteOptChainToChainMatch(exprId: exprId, base: base, cont: cont, memberStart: self.exprOffset(id: exprId), headStart: baseInfo.nameStart, headLen: baseInfo.nameLen, stageRef: stageRef)
                        // Generated match nodes must satisfy the same typed
                        // contract before declaration verification as written
                        // matches. Revisit the replacement, not the old chain.
                        try self.recordExpr(exprId: exprId, chainHoleRef: chainHoleRef, expectedTerm: normalizedContext, needsValue: needsValue)
                    }
                }
            }
            Expr.ChainHole => {
                // The unique enclosing chain stage supplies this term explicitly;
                // it is never ambient resolver state.
                self.recordSemanticExprTerm(exprId: exprId, term: chainHoleRef)
            }
            Expr.Try(val expr) => {
                try self.recordExpr(exprId: expr, chainHoleRef: chainHoleRef)
                try self.recordTryExpression(exprId: exprId, operand: expr)
            }
            Expr.Arrow(val base, val nameStart, val nameLen) => {
                try self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                val refTerm: U64 = self.parametricExprTerm(exprId: base)
                if refTerm != 0U64 { try self.checkReferenceDereference(ref: refTerm, offset: self.exprOffset(id: base)) }
                if self.isStrongRefInst(ref: refTerm) {
                    val reference: TypeRef = self.arena.typeAt(index: refTerm)
                    if reference.args.count() > 0U64 {
                        try self.recordFieldSelection(exprId: exprId, receiverTerm: reference.args[0], nameStart: nameStart, nameLen: nameLen)
                    }
                }
            }
            Expr.Deref(val base) => {
                try self.recordExpr(exprId: base, chainHoleRef: chainHoleRef)
                val refTerm: U64 = self.parametricExprTerm(exprId: base)
                if refTerm != 0U64 { try self.checkReferenceDereference(ref: refTerm, offset: self.exprOffset(id: base)) }
                if self.isStrongRefInst(ref: refTerm) {
                    val reference: TypeRef = self.arena.typeAt(index: refTerm)
                    if reference.args.count() > 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: reference.args[0])
                    }
                }
            }
            Expr.Move(val operand, isBorrow: _) => {
                try self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef)
                self.recordSemanticExprTerm(exprId: exprId, term: self.parametricExprTerm(exprId: operand))
            }
            Expr.Await(val operand) => {
                try self.recordExpr(exprId: operand, chainHoleRef: chainHoleRef)
                val promiseTerm: U64 = self.parametricExprTerm(exprId: operand)
                if promiseTerm != 0U64 && promiseTerm < self.arena.typeCount() {
                    val promise: TypeRef = self.arena.typeAt(index: promiseTerm)
                    if promise.args.count() > 0U64 {
                        self.recordSemanticExprTerm(exprId: exprId, term: promise.args[0])
                    }
                }
            }
            // a closure body is walked IN PLACE, its params scoped over the enclosing
            // locals (captures resolve to the enclosing bindings) — the hole the check
            // passes leave open (neither checkGenericBodies nor this pass's caller
            // descends into closures for scope reasons; here scoping is all we need).
            Expr.Closure(val params, val hasRet, retStart: _, retLen: _, retIsArray: _, val retTy, val body, isDiverging: val diverging) => {
                // The enclosing lexical owner is already published before
                // entering its body. Unsupported nesting is a declaration
                // diagnostic, not a side effect of executable discovery.
                if self.cur.checkFn >= self.arena.functionCount() {
                    mut val enclosing = 0U64
                    while enclosing < self.decls.semanticClosures.count() {
                        if self.decls.semanticClosures[enclosing].bodyKey == self.cur.checkFn {
                            return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: exprId), msg: "v1 rejects nested closure literals; use a named helper or a single closure boundary") />
                        }
                        enclosing += 1U64
                    }
                }
                // A closure literal has an ordinary semantic function TypeTerm.
                // Recording it here lets a concrete generic-call inference
                // consume the same parametric producer as every other
                // expression instead of reconstructing it through exprType.
                val signature = try self.resolveClosureFunctionType(exprId: exprId, parameters: params, hasReturn: hasRet, returnType: retTy, expectedTerm: normalizedContext, isDiverging: diverging)
                self.recordSemanticExprTerm(exprId: exprId, term: signature)
                val result = self.arena.typeAt(index: signature).args[0U64]
                try self.publishSemanticClosure(ownerFnIdx: self.cur.checkFn, closureId: exprId, parameters: params, hasReturn: !self.callableResultIsUnit(ref: result), returnTypeTerm: result, bodyBlock: body)
                val mark: U64 = self.scopeMark()
                val savedClosureIndex = self.cur.recordClosureIndex
                val savedCaptureMark = self.cur.recordCaptureMark
                self.cur.recordClosureIndex = (try self.semanticClosureIndex(ownerFnIdx: self.cur.checkFn, exprId: exprId)) + 1U64
                self.cur.recordCaptureMark = mark
                // A closure owns a distinct Mono body key.  Its CallTemplates
                // must use the same owner while retaining the enclosing lexical
                // locals for capture typing; otherwise finalization searches the
                // closure key and finds only a Pending template recorded under
                // the parent function.
                val savedCheckFn: U64 = self.cur.checkFn
                self.cur.checkFn = self.closureBodyKey(closureId: exprId)
                mut val pi: U64 = 0
                while pi < params.count() {
                    val p: Param = params[pi]
                    val parameterType = self.arena.typeAt(index: signature).args[pi + 1U64]
                    val info = self.typeInfoOfRef(ref: parameterType)
                    self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: info.nameStart, tyLen: info.nameLen, isArray: info.kind == 3, ty: parameterType, isInout: p.isInout, isMut: false, owned: p.isMove)
                    pi += 1
                }
                try self.recordBlock(blkId: body)
                if diverging { try self.checkDivergingBody(blkId: body, offset: self.exprOffset(id: exprId)) }
                self.cur.checkFn = savedCheckFn
                self.cur.recordClosureIndex = savedClosureIndex
                self.cur.recordCaptureMark = savedCaptureMark
                self.popLocals(mark: mark)
            }
            _ => {}
        }
        val completion = self.exprCompletion(exprId: exprId)
        self.recordSemanticExprCompletion(exprId: exprId, completion: completion)
        if needsValue { try self.requireExpressionCompletionValue(exprId: exprId, completion: completion) }
        if exprId < self.arena.semanticExprTypes.count() {
            if self.semanticExprTerm(exprId: exprId) == 0U64 {
                self.recordSemanticExprInfo(exprId: exprId, ti: (try self.exprTypeWithChainHole(id: exprId, chainHoleRef: chainHoleRef)))
            }
        }
        if normalizedContext != 0U64 {
            try self.recordSemanticExprExpectedResult(exprId: exprId, expectedTerm: normalizedContext)
        }
        // Record only after child terms and fallback literal adapters are
        // available. The template is the unique semantic input for operator
        // finalization; Mono must not reopen this Binary/Unary expression.
        match self.arena.exprs[exprId] {
            Expr.Unary(val op, val operand) => {
                val operands: Array[U64] = [operand]
            try self.recordOperatorTemplate(exprId: exprId, op: op, operandExprs: operands, isUnary: true)
            }
            Expr.Binary(val op, val lhs, val rhs) => {
                val operands: Array[U64] = [lhs, rhs]
            try self.recordOperatorTemplate(exprId: exprId, op: op, operandExprs: operands, isUnary: false)
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }

    // Mirror checkBoundsStmt's SCOPE maintenance (Let/For/Match binds) without any of
    // its checks — the local env drives typeOf, so it must match what the backend's
    // own local table will hold at emission.
    inout fn recordStmt(stmtId: U64, expectedTerm: U64 = 0U64, explicitResult: Bool = true) -> Result[SourceCompletion, CompileDiagnostic] {
        match self.arena.stmts[stmtId] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                try self.collectRecordedType(ref: ty)
                try self.recordExpr(exprId: init, expectedTerm: ty)
                val previous = self.localIndexByName(start: nameStart, len: nameLen)
                if previous < self.cur.locals.count() {
                    val prior = self.cur.locals[previous]
                    if prior.owned && self.arena.typeTermIsUnique(ref: prior.ty) {
                        self.decls.semanticBindingEnds[stmtId] = prior.nameStart
                    }
                }
                try self.addLetLocal(nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init, mutable: mutable, owned: true)
                self.decls.semanticLetTerms[stmtId] = self.cur.locals[self.cur.locals.count() - 1U64].ty
            }
            Stmt.Assign(val target, val value) => {
                try self.recordExpr(exprId: target)
                val expected: U64 = self.parametricExprTerm(exprId: target)
                try self.recordExpr(exprId: value, expectedTerm: expected)
            }
            Stmt.ExprStmt(val expr) => { try self.recordExpr(exprId: expr, needsValue: false) }
            Stmt.Return(val value, val hasValue, offset: _) => {
                if hasValue {
                    val expected: U64 = self.semanticBodyReturnContext(fnIdx: self.cur.checkFn)
                    try self.recordExpr(exprId: value, expectedTerm: expected)
                }
            }
            Stmt.IfChain(val conditions, val thenBlk, val elseBlk) => {
                val mark = self.scopeMark()
                try self.recordConditionClauses(conditions: conditions)
                try self.recordBlock(blkId: thenBlk)
                self.popLocals(mark: mark)
                try self.recordBlock(blkId: elseBlk)
            }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                try self.recordExpr(exprId: cond)
                try self.recordBlock(blkId: thenBlk)
                if hasElse {
                    try self.recordBlock(blkId: elseBlk)
                }
            }
            Stmt.While(val cond, val body) => {
                try self.recordExpr(exprId: cond)
                try self.recordBlock(blkId: body)
            }
            Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val varTy, val isRange, inclusive: _, val iter, val rangeHi, val body, val isStruct, patStart: _, patLen: _, val binds) => {
                val forMark: U64 = self.scopeMark()
                mut val iteratorContext = 0U64
                if varTy != 0U64 {
                    match self.arena.exprs[iter] {
                        Expr.Range(val rangeTy, endpoints: _) => {
                            val head = self.arena.typeAt(index: rangeTy)
                            iteratorContext = self.rebuildTypeTerm(t: head, args: [varTy], assocTraitArgs: head.assocTraitArgs)
                        }
                        _ => {}
                    }
                }
                try self.recordExpr(exprId: iter, expectedTerm: iteratorContext)
                if isRange {
                    try self.recordExpr(exprId: rangeHi)
                    // the annotated var type if any (`for i: U64 in a..b`); an unannotated
                    // range var stays untyped here, same as the check pass.
                    self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: varTyStart, tyLen: varTyLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                } else {
                    val et: TypeInfo = (try self.sourceSubjectTypeInfo(exprId: iter))
                    mut val iterTerm: U64 = self.parametricExprTerm(exprId: iter)
                    if iterTerm == 0U64 { iterTerm = et.ref }
                    // The preparation pass establishes lexical item bindings;
                    // only the publication pass selects and stores protocol calls.
                    // Neither protocol result is an input to the item binding below.
                    if self.cur.recordCallTemplates {
                        val iteratorReceiver: CallTemplateReceiver = (try self.protocolReceiverTemplateForExpr(exprId: iter))
                        val nextReceiver: CallTemplateReceiver = <CallTemplateReceiver.PriorProtocolResult slot=1U64 />
                        val iteratorResult = try self.recordProtocolCallTemplate(stmtId: stmtId, slot: 1U64, receiver: iteratorReceiver, receiverTerm: iterTerm)
                        val nextResult = try self.recordProtocolCallTemplate(stmtId: stmtId, slot: 2U64, receiver: nextReceiver, receiverTerm: iteratorResult)
                    }
                    try self.recordForItemTypeRecipe(stmtId: stmtId)
                    val semanticItem: U64 = (try self.iterableItemTerm(iterExpr: iter, iterTerm: iterTerm))
                    if isStruct {
                        if semanticItem != 0U64 {
                            try self.addForStructBinds(et: self.typeInfoOfRef(ref: semanticItem), binds: binds)
                        } else {
                            try self.addForStructBinds(et: et, binds: binds)
                        }
                    } else {
                        if semanticItem != 0U64 {
                            val itemTi: TypeInfo = self.typeInfoOfRef(ref: semanticItem)
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: itemTi.nameStart, tyLen: itemTi.nameLen, isArray: itemTi.kind == 3, ty: semanticItem, isInout: false, isMut: false, owned: false)
                        } else if et.kind == 3 {
                            // carry the ELEMENT ref off the array's carried `Array[E]`
                            // (an `any P` / generic-inst element loses its structure as
                            // a bare name — `for s in shapes` then can't dispatch on s).
                            mut val fer: U64 = 0
                            if et.ref != 0U64 && et.ref < self.arena.typeCount() {
                                val fat: TypeRef = self.arena.typeAt(index: et.ref)
                                if fat.args.count() == 1U64 && rangeEquals(bytes: self.arena.bytes, start: fat.nameStart, len: fat.nameLen, kw: "Array") {
                                    fer = fat.args[0]
                                }
                            }
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: fer, isInout: false, isMut: false, owned: false)
                        } else {
                            val elemTi: TypeInfo = (try self.iterableItemInfo(et: et))
                            self.addLocal(nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                        }
                    }
                }
                try self.recordBlock(blkId: body)
                self.popLocals(mark: forMark)
            }
            Stmt.Match(val scrut, val arms) => {
                // Validate labels before publishing lexical pattern bindings.
                try self.checkMatchArmBinds(arms: arms)
                try self.recordExpr(exprId: scrut)
                try self.checkOrPatternTypes(arms: arms, scrut: scrut)
                try self.recordSemanticMatch(matchSource: <MatchSource.Statement stmtId=stmtId />, scrut: scrut, arms: arms)
                mut val ai: U64 = 0
                while ai < arms.len {
                    val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
                    val mark: U64 = self.scopeMark()
                    try self.scanAddArmBinds(a: a, scrutTi: self.semanticExprTypeInfo(exprId: scrut))
                    try self.recordBlock(blkId: a.body)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Stmt.Panic(val msg, offset: _) => { try self.recordExpr(exprId: msg) }
            Stmt.Give(val value) => {
                try self.recordExpr(exprId: value, expectedTerm: expectedTerm, needsValue: explicitResult)
            }
            Stmt.Break(offset: _) => {}
            Stmt.Continue(offset: _) => {}
        }
        val completion = self.stmtCompletion(stmtId: stmtId)
        if self.cur.recordCallTemplates {
            match self.recordedCompletionFact(completion: completion) {
                Optional.Some(v: val fact) => {
                    while self.arena.semanticStatementCompletions.count() <= stmtId {
                        self.arena.semanticStatementCompletions.append(<Optional.None />)
                    }
                    self.arena.semanticStatementCompletions.set(i: stmtId, value: <Optional.Some v=fact />)
                }
                Optional.None => {}
            }
        }
        return <Result.Ok value=completion />
    }

    inout fn recordBlock(blkId: U64) -> Result[(), CompileDiagnostic] {
        val mark = self.scopeMark()
        try self.recordBlockContents(blkId: blkId, resultContext: <BlockResultContext.Statement />)
        self.popLocals(mark: mark)
        return <Result.Ok value=() />
    }

    inout fn recordBlockContents(blkId: U64, resultContext: BlockResultContext) -> Result[SourceCompletion, CompileDiagnostic] {
        mut val expectedTerm = 0U64
        mut val permitsGive = false
        match resultContext {
            BlockResultContext.Statement => {}
            BlockResultContext.Value(expectedTerm: val expected) => {
                expectedTerm = expected
                permitsGive = true
            }
        }
        if !self.genMode {
            match self.blockTypeUses.get(key: blkId) {
                Optional.Some(v: val uses) => { try self.checkSourceTypeUses(types: uses) }
                Optional.None => {}
            }
        }
        mut val i: U64 = 0
        mut val flow = <SourceCompletion />
        mut val warned = false
        while i < self.blockStmtCount(blkId: blkId) {
            val statement = self.blockStmtAt(blkId: blkId, index: i)
            if !flow.source.normal() {
                return <Result.Err error=self.diagnosticAt(offset: self.stmtPrincipalOffset(sid: statement), msg: "code after a source control transfer is not allowed (spec/11)") />
            }
            if !flow.execution.normal() && !warned {
                self.warnUnreachableStatement(stmtId: statement)
                warned = true
            }
            match self.arena.stmts[statement] {
                Stmt.Give(val value) => {
                    if !permitsGive { return <Result.Err error=self.diagnosticAt(offset: self.exprOffset(id: value), msg: "`give` is only allowed in a value block (spec/11)") /> }
                }
                _ => {}
            }
            val statementFlow = try self.recordStmt(stmtId: statement, expectedTerm: expectedTerm, explicitResult: !self.arena.blocks[blkId].implicitResult)
            flow = completionThen(prefix: flow, next: statementFlow)
            if permitsGive && statementFlow.source.gives() {
                match self.arena.stmts[statement] {
                    Stmt.Give(val value) => {
                        // Keep source-position binding identity, including gives
                        // in analyzed-unreachable but source-valid regions.
                        try self.tcCheckValue(expectedRef: expectedTerm, valueExpr: value, pos: "block-result")
                        try self.checkGenericTypeMatch(expectedRef: expectedTerm, valueExpr: value)
                    }
                    _ => {}
                }
            }
            i += 1
        }
        match self.blockExitRequirements.get(key: blkId) {
            Optional.Some(v: val offset) => {
                if self.blockCompletesNormally(blkId: blkId) {
                    return <Result.Err error=self.diagnosticAt(offset: offset, msg: "`guard` else block must diverge (end in return / break / continue / panic) — spec/11") />
                }
            }
            Optional.None => {}
        }
        return <Result.Ok value=completionBlock(flow: flow) />
    }

    inout fn recordBodyReceiverTerm(fnIdx: U64, term: U64) {
        while self.decls.semanticBodyReceiverTerms.count() <= fnIdx {
            self.decls.semanticBodyReceiverTerms.append(0U64)
        }
        self.decls.semanticBodyReceiverTerms.set(i: fnIdx, value: term)
    }

    // A provided copy consumes its source body's receiver fact. Its placement
    // pattern and a grounded ABI receiver are not replacements for this term.
    inout fn semanticBodyReceiverTerm(fnIdx: U64) -> Result[U64, CompileDiagnostic] {
        val owner: U64 = (try self.semanticBodyOwner(fnIdx: fnIdx))
        if owner >= self.decls.semanticBodyReceiverTerms.count() { return <Result.Ok value=0U64 />}
        return <Result.Ok value=self.decls.semanticBodyReceiverTerms[owner] />
    }

    // Record one lexical declaration using the same contract as the eager walk.
    // Selection/order belongs to the caller; generated provided copies share
    // their source declaration's semantic rows and are never recorded twice.
    inout fn recordParametricFunction(fnIdx: U64, recordCallTemplates: Bool) -> Result[(), CompileDiagnostic] {
        self.cur.recordCallTemplates = recordCallTemplates
        val f: Func = self.arena.functionAt(index: fnIdx)
        // A trait-provided body is copied per conformance, but its lexical
        // source body owns one shared CallTemplate set.  Skipping every
        // `srcTraitId` body left operators in provided methods without the
        // semantic template that Mono is required to consume.  Record the
        // source declaration once and skip only generated provided copies.
        if !(f.isExtern) && f.body != 0U64 && !(f.isProvided && f.srcTraitId != 0U64) {
            tracePhaseProgress(c: inout self, label: "semantic-expression-record:body", count: fnIdx, stride: 64U64)
            self.cur.locals = []
            self.cur.hasRecv = f.hasRecv
            self.cur.recvStart = f.recvStart
            self.cur.recvLen = f.recvLen
            self.cur.extId = f.extId
            self.cur.selfInout = f.selfInout
            self.cur.recvInstRef = 0
            self.cur.selfRef = self.parametricSelfRef(f: f)
            if recordCallTemplates && f.hasRecv {
                self.recordBodyReceiverTerm(fnIdx: fnIdx, term: self.cur.selfRef)
            }
            self.cur.itemRef = self.abstractProvidedItemRef(f: f)
            // This is a declaration-time walk: generic binders are in
            // lexical scope but have no concrete arguments. Keeping the
            // Func's ParamIds here lets `value: Optional[Box[T]]` record
            // its complete parametric term. Omitting them made the record
            // miss the base of a `?.` chain, after which Mono had to read
            // an incidental concrete `typeOf` result and froze T to the
            // first instantiated body.
            self.cur.typeParams = self.copyFuncBinds(binds: f.typeParams)
            self.cur.typeArgs = []
            self.cur.checkFn = fnIdx
            if !recordCallTemplates { try self.checkDefaultGeneratorRestrictions(fnIdx: fnIdx) }
            mut val pi: U64 = 0
            while pi < f.params.count() {
                val p: Param = self.funcParamAt(params: f.params, index: pi)
                self.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                // After preparation the generator is the sole Record
                // owner of this expression and of its lexical locals.
                if p.hasDefault && self.decls.defaultGeneratorRanges.count() == 0U64 {
                    try self.recordExpr(exprId: p.defaultExpr, expectedTerm: p.ty)
                }
                pi += 1
            }
            try self.recordBlock(blkId: f.body)
            if !recordCallTemplates { try self.checkDefaultGenerator(fnIdx: fnIdx) }
        }
        return <Result.Ok value=() />
    }

    // Demand preparation preserves the same lexical phases as the eager
    // frontend. Specialization may consume this owner only after completion.
    inout fn prepareLexicalBody(fnIdx: U64) -> Result[(), CompileDiagnostic] {
        val owner = (try self.semanticBodyOwner(fnIdx: fnIdx))
        if owner >= self.arena.functionCount() {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: lexical body request has no declaration") />
        }
        match self.lexicalBodyPreparations.get(key: owner) {
            Optional.Some(v: val result) => { return result }
            Optional.None => {}
        }
        val saved = self.cur
        val result = self.prepareLexicalBodyUncached(owner: owner)
        self.cur = saved
        self.lexicalBodyPreparations.record(owner: owner, result: result)
        return result
    }

    // This local request does not recursively request another source body:
    // calls consume registered signatures, never their callees' preparation.
    // Template closure is not evidence that the source body was checked.
    // Only prepareLexicalBody's completed request cache authorizes reuse.
    inout fn prepareLexicalBodyUncached(owner: U64) -> Result[(), CompileDiagnostic] {
        self.cur.bodyFnIdx = owner
        self.cur.bodyEnvironment = <InstanceEnvironment />
        self.cur.bodyId = 0U64
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
        try self.recordParametricFunction(fnIdx: owner, recordCallTemplates: false)
        try self.checkGenericFunction(fnIdx: owner)
        try self.verifyFunctionDeclaration(fnIdx: owner)
        try self.recordParametricFunction(fnIdx: owner, recordCallTemplates: true)
        self.cur.recordCallTemplates = false
        if (try self.completeRecordedBodyDefaultCalls(owner: owner)) != 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: owner).defOffset, msg: "internal error: lexical body has incomplete default argument plans") />
        }
        try self.closeCallTemplatesForBody(fnIdx: owner)
        try self.checkRecordedBodyCallConstraints(owner: owner)
        return <Result.Ok value=() />
    }

    // Record every function body's parametric types. Skips: externs / requirement
    // signatures (body 0 is the no-body sentinel), and provided-method COPIES
    // (srcTraitId != 0) — a copy SHARES the trait template's body, so recording it
    // would overwrite the template's `Self` forms with one conformer's concrete
    // types and corrupt every other conformer. The template's recording (Self/T
    // parametric) serves all of them via groundTypeRef at read.
    inout fn recordParametricTypes(recordCallTemplates: Bool = false, includeBodies: Bool = true) -> Result[(), CompileDiagnostic] {
        val noParams: Array[Bind] = []
        val noArgs: Array[U64] = []
        // global initializers first (`val nums: Array[I64] = [...]` at module level):
        // their exprs are emitted too, and an array-literal init has no other record
        // point (the fallback typeOf reports a literal as unknown). recordStmt(Let)
        // adds each global as a local as it goes, so a later init reading an earlier
        // global resolves.
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.recvInstRef = 0
        self.cur.selfRef = 0
        self.cur.itemRef = 0
        self.cur.typeParams = noParams
        self.cur.typeArgs = noArgs
        self.cur.recordCallTemplates = recordCallTemplates
        self.cur.checkFn = 18446744073709551615U64
        mut val gvi: U64 = 0
        while !self.genMode && gvi < self.arena.globals.count() {
            try self.recordStmt(stmtId: self.arena.globals[gvi].letStmt)
            gvi += 1
        }
        // This phase records the parametric semantic contract of the declaration
        // set that existed at its start.  Recording can discover derived
        // call/proof facts, which may materialize implementation-only Func rows;
        // those are consumers of this contract, not new source declarations to
        // recursively record here.  Iterating the live growing table made one
        // semantic walk feed itself and eventually reinterpret range payloads as
        // owned values in a later duplicate body.  Freeze the declaration frontier
        // before the walk so each authored body is recorded exactly once.
        val sourceFuncLimit: U64 = self.arena.functionCount()
        mut val fi: U64 = 0
        while includeBodies && fi < sourceFuncLimit {
            try self.recordParametricFunction(fnIdx: fi, recordCallTemplates: recordCallTemplates)
            fi += 1
        }
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0
        self.cur.recvInstRef = 0
        self.cur.selfRef = 0
        self.cur.itemRef = 0
        self.cur.typeParams = []
        self.cur.typeArgs = []
        self.cur.checkFn = 18446744073709551615U64
        self.cur.recordCallTemplates = false
        return <Result.Ok value=() />
    }
}
