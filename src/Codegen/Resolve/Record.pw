                try self.recordSemanticMatch(matchSource: <MatchSource.Expression exprId=exprId />, scrut: scrut, arms: arms)
                mut val ai: U64 = 0
                while ai < arms.len {
                    val a: MatchArm = self.matchArmAt(arms: arms, index: ai)
                    val mark: U64 = self.scopeMark()
                    try self.scanAddArmBinds(a: a, scrutTi: self.semanticExprTypeInfo(exprId: scrut))
                    try self.recordValueBlock(exprId: exprId, blockId: a.body, expectedTerm: normalizedContext)
                    self.popLocals(mark: mark)
                    ai += 1
                }
            }
            Expr.Sequence(val body) => {
                try self.recordValueBlock(exprId: exprId, blockId: body, expectedTerm: normalizedContext)
            }
            Expr.Block(val body, offset: _) => {
                try self.recordValueBlock(exprId: exprId, blockId: body, expectedTerm: normalizedContext)
            }
            Expr.IfChain(val conditions, val thenBlk, val elseBlk) => {
                val mark = self.scopeMark()
