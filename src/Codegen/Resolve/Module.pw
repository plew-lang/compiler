// Part of name/type resolution (root: _.pw): module-of and visibility
// lookup, plus function / method / associated-item resolution.

// The module id owning the source byte `offset` (spec/15 visibility): the loader
// tags each file's [start,len) span in `bytes` with a module id (a module = a root
// file + its `part` tree; each `use` target a separate one). A declaration's or
// use's module is `moduleOf(its name offset)`. Returns 0 (the entry module) if no
// range matches (e.g. synthetic spans appended after loading).

pub impl Comp {
    inout fn moduleOf(offset: U64) -> U64 {
        match self.modules.sourceFileContaining(offset: offset) {
            Optional.Some(v: val index) => { return self.modules.sourceFileRange(index: index).moduleId }
            Optional.None => { return 0U64 }
        }
    }

    inout fn stmtPrincipalOffset(sid: U64) -> U64 {
        match self.arena.stmts[sid] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init, annotationOccurrence: _) => { return self.exprOffset(id: init) }
            Stmt.Assign(val target, value: _) => { return self.exprOffset(id: target) }
            Stmt.ExprStmt(val expr) => { return self.exprOffset(id: expr) }
            Stmt.Return(val value, val hasValue, val offset) => { if hasValue { return self.exprOffset(id: value) } return offset }
            Stmt.Break(val offset) | Stmt.Continue(val offset) => { return offset }
            Stmt.IfChain(val conditions, thenBlk: _, elseBlk: _) => {
                if conditions.len > 0U64 { return self.exprOffset(id: self.conditionClauseAt(conditions: conditions, index: 0U64).value) }
                return 0U64
            }
            Stmt.If(val cond, thenBlk: _, elseBlk: _, hasElse: _) => { return self.exprOffset(id: cond) }
            Stmt.While(val cond, body: _) => { return self.exprOffset(id: cond) }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, varTy: _, val iter, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => { return self.exprOffset(id: iter) }
            Stmt.Match(val scrut, arms: _) => { return self.exprOffset(id: scrut) }
            Stmt.Panic(msg: _, val offset) => { return offset }
            Stmt.Give(val value) => { return self.exprOffset(id: value) }
        }
    }

    inout fn methodInEntryModule(f: Func) -> Bool {
        if f.body == 0U64 {
            return false
        }
        if self.blockStmtCount(blkId: f.body) == 0U64 {
            return false
        }
        return self.moduleOf(offset: self.stmtPrincipalOffset(sid: self.blockStmtAt(blkId: f.body, index: 0U64))) == 0U64
    }

    inout fn isAmbientInLang(start: U64, len: U64) -> Bool {
        val lm: U64 = self.modules.langModule
        if lm == 4000000000U64 { return false }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        // declared in @Std/Lang (its declaration offset falls in the Lang module). The scan
        // looks for a LANG-owned declaration specifically (not the first match), so a user's
        // own `enum Optional` in module 0 does not mask Lang's ownership (→ redefinition gate).
        mut val i: U64 = self.arena.firstStructNamed(nameId: qId)
        while i < self.arena.structCount() {
            val sd: StructDef = self.arena.structAt(index: i)
            if sd.nameId == qId {
                if sd.defOffset != 0U64 {
                    if self.moduleOf(offset: sd.defOffset) == lm { return true }
                }
            }
            i = self.arena.nextStructNamed(index: i)
        }
        i = self.arena.firstEnumNamed(nameId: qId)
        while i < self.arena.enumCount() {
            val ed: EnumDef = self.arena.enumAt(index: i)
            if ed.nameId == qId {
                if ed.defOffset != 0U64 {
                    if self.moduleOf(offset: ed.defOffset) == lm { return true }
                }
            }
            i = self.arena.nextEnumNamed(index: i)
        }
        // re-exported by @Std/Lang (the primitives — defined in @Std/Core). A re-export
        // records the forwarded name as exported by Lang (`fieldStart` = the Lang module),
        // using the name's span in Lang's own source (so `moduleOf` is reliable).
        i = 0
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports[i]
            if e.fieldStart == lm {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) { return true }
            }
            i += 1
        }
        return false
    }

    inout fn offsetIsLoaded(offset: U64) -> Bool {
        return self.modules.sourceFileContaining(offset: offset).isSome()
    }

    inout fn inferLetType(tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64) -> Result[LetEff, CompileDiagnostic] {
        mut val effStart: U64 = tyStart
        mut val effLen: U64 = tyLen
        mut val effArr: Bool = tyIsArray
        mut val effTy: U64 = ty
        if tyLen == 0 {
            if !(tyIsArray) {
                // A selected call has an instance-owned result in
                // CallResolution. `exprType` is the shared
                // declaration-template projection, so using it alone would
                // bind `val pair = box#E.duplicate()` as `(first: T,
                // second: T)` after Mono had already proved its concrete
                // result. Local inference is the first consumer that gives
                // the result a stable body binding; it must read the same
                // semantic fact as later field selection and LLVM. Other
                // expressions retain the ordinary projection, including
                // uncontextualized literals.
                mut val ti: TypeInfo = (try self.exprType(id: init))
                mut val resolved: U64 = 0U64
                match self.arena.exprs[init] {
                    Expr.Call(nameStart: _, nameLen: _, args: _) => { resolved = (try self.bodyCalleeResultRef(exprId: init)) }
                    Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { resolved = (try self.bodyCalleeResultRef(exprId: init)) }
                    Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => { resolved = (try self.bodyCalleeResultRef(exprId: init)) }
                    _ => {}
                }
                if resolved != 0U64 && resolved < self.arena.typeCount() {
                    ti = self.typeInfoOfRef(ref: resolved)
                }
                // an array-literal init reports unknown via exprType (literal typing is
                // element-wise/bidirectional in the check passes), so derive `Array[E]`
                // from the first element HERE — the one un-annotated-let inference the
                // scan and record passes share — and `val xs = [10U8, 20U8]` types the
                // local everywhere. An empty literal stays unknown (annotation required).
                if ti.kind == 0 && ti.nameLen == 0 {
                    match self.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            if elems.len > 0 {
                                // The element's parametric semantic term is the
                                // declaration-time source of truth.  In a
                                // shared generic body it preserves the outer
                                // binder selected by a nested call; exprType
                                // alone can reopen that call's declaration and
                                // substitute the callee's unrelated `T`.
                                val first: U64 = self.exprAt(exprs: elems, index: 0U64)
                                mut val eRef: U64 = self.parametricExprTerm(exprId: first)
                                if eRef == 0U64 {
                                    eRef = self.typedIrRefOfInfo(ti: (try self.exprType(id: first)))
                                }
                                // an ARGLESS generic head (`<Optional.Some v=1 />` with no
                                // inferable instance reports its bare head name) must not be
                                // registered or named as the element: it aliases the generic
                                // TEMPLATE and sends the field grounding into infinite
                                // recursion. Leave the binding untyped — the element's own
                                // construction then reports cleanly downstream.
                                if eRef != 0 {
                                    if self.arena.typeAt(index: eRef).args.count() == 0U64 {
                                        if self.genericStructIndexForType(ref: eRef) < self.arena.structCount() {
                                            eRef = 0
                                        } else if self.genericEnumIndexForType(ref: eRef) < self.arena.enumCount() {
                                            eRef = 0
                                        }
                                    }
                                }
                                if eRef != 0 {
                                    // name the element by its REGISTERED span (the mangled
                                    // form for a compound element `Box[I64]`/`Ref[Cell]`) —
                                    // the kind-3 convention every consumer keys on. The bare
                                    // head name would alias an ARGLESS generic head and send
                                    // the field grounding into infinite recursion. During
                                    // collection the element AND the `Array[E]` instance are
                                    // registered here, exactly like a written annotation
                                    // (this is what makes the inferred type emittable —
                                    // an ARC-element array with no registered witnesses
                                    // loops at emission); later passes look the entry up.
                                    if self.inCollection {
                                        try self.registerArrayElemRef(elemRef: eRef)
                                        try self.scanType(ref: self.arrayRefOfElem(elemRef: eRef))
                                    }
                                    val en: Bind = (try self.arrayElemNameForRef(elemRef: eRef))
                                    // post-collection, a compound element whose mangled span
                                    // never got registered (the collection walk couldn't type
                                    // it) must NOT adopt the bare-head fallback name — leave
                                    // the binding untyped so downstream reports cleanly.
                                    mut val named: Bool = true
                                    if !(self.inCollection) {
                                        if (try self.isCompoundType(ref: eRef)) {
                                            if self.arrayElemRef(start: en.nameStart, len: en.nameLen) == 0U64 {
                                                named = false
                                            }
                                        }
                                    }
                                    if named {
                                        return <Result.Ok value=<LetEff start=en.nameStart len=en.nameLen arr=true ty=self.arrayRefOfElem(elemRef: eRef) /> />
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                effStart = ti.nameStart
                effLen = ti.nameLen
                // carry the FULL ref (a name-only kind-3 rebuilds its `Array[E]`) so the
                // local's type matches the store convention (locals' ty = the array ref).
                effTy = self.typedIrRefOfInfo(ti: ti)
                if ti.kind == 3 {
                    effArr = true
                }
            }
        }
        return <Result.Ok value=<LetEff start=effStart len=effLen arr=effArr ty=effTy /> />
    }

    // Does module `useMod` have a direct use edge to `targetMod` (it did
    // `use <path>` resolving to that module)? Drives the coexistence tiebreak.
    inout fn hasImportEdge(useMod: U64, targetMod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.importEdges.count() {
            val e: Bind = self.modules.importEdges[i]
            if e.fieldStart == useMod {
                if e.fieldLen == targetMod {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Is the candidate decl `(candStart,candLen)` (a free fn) visible from module `useMod`
    // (spec/15)? (name, module)-keyed: a cross-module candidate is visible only if the
    // candidate's OWN module exports the name AND `useMod` directly imported that module
    // (a use edge) AND brought this name into scope (a `only { }` use, not a bare
    // namespace import). Pinning the candidate's module is what stops a private same-named
    // decl in one module from being reached via an unrelated module's export of the same
    // text (the use + "exported somewhere" pair alone did not distinguish the source).
    // Does `useMod` use a barrel module that re-exports from `srcMod` (spec/15)? Composes
    // a direct use edge (useMod -> barrel) with a re-export edge (barrel -> srcMod), so a
    // name defined+exported in `srcMod` and forwarded by a barrel the use site imports is
    // reachable without the use site naming the source module directly.
    inout fn importsBarrelForwarding(useMod: U64, srcMod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.reExportEdges.count() {
            val e: Bind = self.modules.reExportEdges[i]
            if e.fieldLen == srcMod {
                if self.hasImportEdge(useMod: useMod, targetMod: e.fieldStart) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // The written scope contributes declaration identities, not a single owner.
    // A public surface can contain local overloads and forwarded overloads.
    inout fn appendFreeFunctionSurface(moduleId: U64, nameId: U64, publicOnly: Bool, candidates: inout Array[U64]) {
        mut val index = self.decls.firstCallableNamed(nameId: nameId)
        while index < self.decls.callableCount() {
            val candidate = self.decls.callableAt(index: index)
            if candidate.sourceModule == moduleId {
                val function = self.arena.functionAt(index: candidate.funcIdx)
                if !(function.hasRecv || function.isAssoc) {
                    if !publicOnly || self.modules.isPublicDeclaration(offset: function.defOffset) {
                        if !idInSet(set: candidates, id: candidate.funcIdx) { candidates.append(candidate.funcIdx) }
                    }
                }
            }
            index = self.decls.nextCallableNamed(index: index)
        }
        index = self.modules.firstReExportOriginNamed(moduleId: moduleId, nameId: nameId)
        while index < self.modules.reExportOriginCount() {
            val origin = self.modules.reExportOriginAt(index: index)
            // The origin index already selects this module and local name.
            if !origin.isNamespace {
                self.appendFreeFunctionSurface(moduleId: origin.targetModule, nameId: intern(c: inout self, start: origin.sourceStart, len: origin.sourceLength), publicOnly: true, candidates: inout candidates)
            }
            index = self.modules.nextReExportOriginNamed(index: index)
        }
    }

    inout fn visibleFreeFunctions(nameStart: U64, nameLen: U64) -> Array[U64] {
        mut val candidates: Array[U64] = []
        val qualified = self.modules.qualifiedUseIndex(offset: nameStart)
        if qualified < self.modules.qualifiedUseCount() {
            val origin = self.modules.qualifiedUseAt(index: qualified)
            if !origin.isNamespace {
                self.appendFreeFunctionSurface(moduleId: origin.targetModule, nameId: intern(c: inout self, start: origin.sourceStart, len: origin.sourceLength), publicOnly: true, candidates: inout candidates)
            }
            return candidates
        }
        val moduleId = self.moduleOf(offset: nameStart)
        val nameId = intern(c: inout self, start: nameStart, len: nameLen)
        self.appendFreeFunctionSurface(moduleId: moduleId, nameId: nameId, publicOnly: false, candidates: inout candidates)
        mut val index = self.modules.firstImportOriginNamed(moduleId: moduleId, nameId: nameId)
        while index < self.modules.importOriginCount() {
            val origin = self.modules.importOriginAt(index: index)
            // The origin index already selects this module and local name.
            if !origin.isNamespace {
                self.appendFreeFunctionSurface(moduleId: origin.targetModule, nameId: intern(c: inout self, start: origin.sourceStart, len: origin.sourceLength), publicOnly: true, candidates: inout candidates)
            }
            index = self.modules.nextImportOriginNamed(index: index)
        }
        return candidates
    }

    // Raw diagnostic observation, including selector-only candidates. Source
    // operations consume the typed selection outcome instead of this index.
    inout fn findFunc(nameStart: U64, nameLen: U64, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        return match (try self.selectFreeFunction(nameStart: nameStart, nameLen: nameLen, args: args)) {
            FreeFunctionSelection.Selected(function: val function) | FreeFunctionSelection.DiagnosticCandidate(function: val function) => <Result.Ok value=function />
            FreeFunctionSelection.NoCandidate => <Result.Ok value=self.arena.functionCount() />
            FreeFunctionSelection.AmbiguousVisibleDeclarations => <Result.Err error=self.diagnosticAt(offset: nameStart, msg: <FreeCallAmbiguityKind.VisibleDeclarations />.message()) />
            FreeFunctionSelection.AmbiguousNumericOverloads(offset: val offset) => <Result.Err error=self.diagnosticAt(offset: offset, msg: <FreeCallAmbiguityKind.NumericLiteralOverloads />.message()) />
        }
    }
}

impl Comp {
    inout fn freeCallAmbiguityDiagnostic(kind: FreeCallAmbiguityKind, expression: U64, nameStart: U64, nameLen: U64, args: ArgRange, offset: U64) -> CompileDiagnostic {
        val location = self.diagnosticLocationAt(offset: offset)
        val current = self.currentSourceOwner()
        val owner: DiagnosticOwner = match current {
            Optional.Some(v: val owner) => match owner {
                SemanticCompletionOwner.Function(index: val index) => <DiagnosticOwner.Function index=index />
                SemanticCompletionOwner.Global(target: val target) => <DiagnosticOwner.Global target=target />
                SemanticCompletionOwner.Closure(expression: val expression) => <DiagnosticOwner.Closure expression=expression />
            }
            Optional.None => <DiagnosticOwner.Unknown />
        }
        if self.isAuthoredFreeCall(exprId: expression, start: nameStart, length: nameLen, args: args) {
            match current {
                Optional.Some(v: val owner) => {
                    // A public cursor alone cannot create or replace source ownership.
                    if self.sourceFacts.isActive(owner: owner) {
                        mut val written: Array[Arg] = []
                        for index in 0U64..<args.len { written.append(self.argAt(args: args, index: index)) }
                        self.failedFreeCallAmbiguities[expression] = (kind: kind, location: location, owner: owner, nameStart: nameStart, nameLen: nameLen, arguments: written)
                    }
                }
                Optional.None => {}
            }
        }
        return <CompileDiagnostic.freeCallAmbiguity refusal=<FreeCallAmbiguityRefusal kind=kind session=self.sourceFactSession() owner=owner expression=expression nameStart=nameStart nameLen=nameLen argumentsStart=args.start argumentsCount=args.len location=location /> />
    }

    inout fn selectFreeFunction(nameStart: U64, nameLen: U64, args: ArgRange) -> Result[FreeFunctionSelection, CompileDiagnostic] {
        mut val firstLabel = self.arena.functionCount()
        mut val typeMatch = self.arena.functionCount()
        mut val typeMatch2 = self.arena.functionCount()
        val candidates = self.visibleFreeFunctions(nameStart: nameStart, nameLen: nameLen)
        mut val i = 0U64
        while i < candidates.count() {
            val functionId = candidates[i]
            val matchRank = (try self.callableArgMatchRank(function: functionId, args: args))
            if matchRank != 0U64 {
                if firstLabel == self.arena.functionCount() { firstLabel = functionId }
                if matchRank == 2U64 {
                    if typeMatch == self.arena.functionCount() { typeMatch = functionId }
                    else if typeMatch2 == self.arena.functionCount() { typeMatch2 = functionId }
                }
            }
            i += 1U64
        }
        if typeMatch != self.arena.functionCount() {
            val ambiguity = try self.numericOverloadAmbiguityOffset(a: typeMatch, b: typeMatch2, args: args)
            if ambiguity.isSome() { return <Result.Ok value=<FreeFunctionSelection.AmbiguousNumericOverloads offset=ambiguity.unwrap() /> /> }
            if typeMatch2 != self.arena.functionCount() {
                return <Result.Ok value=<FreeFunctionSelection.AmbiguousVisibleDeclarations /> />
            }
            return <Result.Ok value=<FreeFunctionSelection.Selected function=typeMatch /> />
        }
        if firstLabel != self.arena.functionCount() { return <Result.Ok value=<FreeFunctionSelection.DiagnosticCandidate function=firstLabel /> /> }
        // gen mode (spec/16): the synthesized derive-runner harness calls force-loaded std
        // free fns (`parseItem`/`write`/…) that the gen'd entry file does not `use` —
        // force-load is NOT use, so scoped resolution above found no visible candidate
        // (the harness's call has a re-interned nameStart, `moduleOf` 0, which can't see
        // @Plew/Syntax). The harness is trusted compiler-generated code, so resolve it
        // GLOBALLY here, gen-only (the pre-scoped-resolution behaviour): first label match,
        // type match preferred. Normal compilation never reaches this — it returns
        // "not found" (firstLabel == count) so checkUseVisibility can demand a use.
        if self.genMode {
            val qId = intern(c: inout self, start: nameStart, len: nameLen)
            mut val gLabel: U64 = self.arena.functionCount()
            mut val gj: U64 = self.decls.firstCallableNamed(nameId: qId)
            while gj < self.decls.callableCount() {
                val gc: Callable = self.decls.callableAt(index: gj)
                val gf: Func = self.arena.functionAt(index: gc.funcIdx)
                if !(gf.hasRecv || gf.isAssoc) {
                    if gf.nameId == qId {
                        val matchRank: U64 = (try self.callableArgMatchRank(function: gc.funcIdx, args: args))
                        if matchRank != 0U64 {
                            if matchRank == 2U64 {
                                return <Result.Ok value=<FreeFunctionSelection.Selected function=gc.funcIdx /> />
                            }
                            if gLabel == self.arena.functionCount() {
                                gLabel = gc.funcIdx
                            }
                        }
                    }
                }
                gj = self.decls.nextCallableNamed(index: gj)
            }
            if gLabel < self.arena.functionCount() { return <Result.Ok value=<FreeFunctionSelection.DiagnosticCandidate function=gLabel /> /> }
            return <Result.Ok value=<FreeFunctionSelection.NoCandidate /> />
        }
        return <Result.Ok value=<FreeFunctionSelection.NoCandidate /> />
    }
}

pub impl Comp {

    inout fn firstFuncByName(nameStart: U64, nameLen: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = self.decls.firstCallableNamed(nameId: qId)
        while i < self.decls.callableCount() {
            val cand: Callable = self.decls.callableAt(index: i)
            val f: Func = self.arena.functionAt(index: cand.funcIdx)
            // skip methods and associated fns: a bare name only names a free fn (see
            // findFunc — operator witnesses like `add` are assoc, not free).
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    return cand.funcIdx
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return self.arena.functionCount()
    }

    inout fn firstVisibleFuncByName(useMod: U64, nameStart: U64, nameLen: U64) -> U64 {
        val candidates = self.visibleFreeFunctions(nameStart: nameStart, nameLen: nameLen)
        if candidates.count() > 0U64 { return candidates[0U64] }
        return self.arena.functionCount()
    }

    // Does a free fn matching this call's name AND labels exist, but only in module(s) not
    // visible from `useMod`? Drives the use-site diagnostic for the (name, module) rule: when
    // an imported same-named export shadows the name by text, the actual label match may live
    // in another module's PRIVATE surface — `findFunc` correctly returns nothing (it is not a
    // candidate), and this turns that into a clean "not visible here" error instead of an
    // opaque backend failure. Returns false when a visible label match exists (then any
    // remaining mismatch is a normal overload/type error) or when nothing matches the labels
    // (a local / closure / builtin, handled elsewhere).
    inout fn labelMatchOnlyInvisible(useMod: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Bool {
        val candidates = self.visibleFreeFunctions(nameStart: nameStart, nameLen: nameLen)
        mut val index = 0U64
        while index < candidates.count() {
            if self.paramsLabelsOk(params: self.arena.functionAt(index: candidates[index]).params, args: args) { return false }
            index += 1U64
        }
        // Diagnose inaccessible declarations without adding them to resolution.
        mut val lookupStart = nameStart
        mut val lookupLen = nameLen
        match self.moduleBindingAt(nameStart: nameStart, nameLen: nameLen) {
            ModuleBinding.Declaration(moduleId: _, nameStart: val start, nameLen: val len) => { lookupStart = start
                lookupLen = len }
            _ => {}
        }
        val nameId = intern(c: inout self, start: lookupStart, len: lookupLen)
        index = self.decls.firstCallableNamed(nameId: nameId)
        while index < self.decls.callableCount() {
            val function = self.arena.functionAt(index: self.decls.callableAt(index: index).funcIdx)
            if !(function.hasRecv || function.isAssoc) && self.paramsLabelsOk(params: function.params, args: args) { return true }
            index = self.decls.nextCallableNamed(index: index)
        }
        return false
    }

    inout fn firstMethodRetType(typeStart: U64, typeLen: U64, name: String) -> TypeInfo {
        val qRecv: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.callableCount() {
            val cand: Callable = self.decls.callableAt(index: i)
            val f: Func = self.arena.functionAt(index: cand.funcIdx)
            if f.hasRecv {
                if f.recvId == qRecv {
                    if rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                        if f.hasRet {
                            if f.retTy != 0U64 { return self.typeInfoOfRef(ref: f.retTy) }
                            return scalarInfo()
                        }
                        return scalarInfo()
                    }
                }
            }
            i += 1
        }
        return scalarInfo()
    }

    // `nameStart` identifies the selector spelling, but lowering may intern a
    // selector for a synthetic call (`[]` -> `index`).  Visibility belongs to
    // the source call-site, not that interned helper span, so callers can pass
    // the real AST offset explicitly.
    inout fn findMethod(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64, useOffset: U64 = 0U64, associated: Bool = false, typeMatchOnly: Bool = false) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.observedMemberFunction(selection: (try self.findMethodWithOrigin(recvStart: recvStart, recvLen: recvLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef, useOffset: useOffset, associated: associated, typeMatchOnly: typeMatchOnly))) />
    }
}

impl Comp {
    fn hasAuthoredMethodExpression(exprId: U64) -> Bool {
        return exprId < self.arena.exprs.count() && self.authoredMethodExpressions.contains(exprId) && self.syntheticCallSiteIndex(exprId: exprId) >= self.decls.syntheticCallSites.count()
    }

    fn isAuthoredMethodLookup(exprId: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Bool {
        if !self.hasAuthoredMethodExpression(exprId: exprId) { return false }
        return match self.arena.exprs[exprId] {
            Expr.Method(recv: _, nameStart: val start, nameLen: val length, args: val written) |
            Expr.ExtMethod(recv: _, source: _, nameStart: val start, nameLen: val length, args: val written) =>
                start == nameStart && length == nameLen && written.start == args.start && written.len == args.len
            _ => false
        }
    }

    fn bareMethodAmbiguityDiagnostic(nameStart: U64, nameLen: U64, args: ArgRange, methodOrigin: MethodLookupOrigin) -> CompileDiagnostic {
        val domain = match methodOrigin.expression {
            Optional.Some(v: val exprId) => if self.isAuthoredMethodLookup(exprId: exprId, nameStart: nameStart, nameLen: nameLen, args: args) { give <FailureDomain.Source /> } else { give <FailureDomain.Unclassified /> }
            Optional.None => <FailureDomain.Unclassified />
        }
        return self.conformanceAmbiguityDiagnostic(owner: nameStart, demand: <ConformanceProofDemand.MemberDispatch />, selectedSource: false, domain: domain)
    }

    inout fn findMethodWithOrigin(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64, useOffset: U64 = 0U64, associated: Bool = false, typeMatchOnly: Bool = false, methodOrigin: MethodLookupOrigin = <MethodLookupOrigin />) -> Result[MemberCallLookup, CompileDiagnostic] {
        mut val firstLabel: U64 = self.arena.functionCount()
        mut val typeMatch: U64 = self.arena.functionCount()
        mut val typeMatch2: U64 = self.arena.functionCount()
        mut val typeMatchEntry: U64 = self.decls.callableCount()
        mut val typeMatch2Entry: U64 = self.decls.callableCount()
        mut val inherentMatch: U64 = self.arena.functionCount()
        mut val inherentMatch2: U64 = self.arena.functionCount()
        // Root-gated members remain unavailable to bare selection. Retain
        // their fully applicable semantic sources only for an accurate final
        // diagnostic when there is no ordinary bare candidate.
        mut val gatedCandidates: Array[U64] = []
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val receiverDeclaration = if associated && recvRef == 0U64 {
            give self.typeDeclIdentityAt(useMod: self.moduleOf(offset: recvStart), start: recvStart, len: recvLen)
        } else { give self.missingDeclIdentity() }
        mut val names = self.nominalMemberNames(name: qNameId, receiver: qRecvId, receiverTerm: recvRef, declaration: receiverDeclaration, surface: if associated { give <NominalMemberSurface.ProvidedAssociated /> } else { give <NominalMemberSurface.Instance /> })
        while true {
            val i = match self.nextNominalMemberName(cursor: inout names) {
                Optional.Some(v: val index) => index
                Optional.None => { break }
            }
            val cand = self.decls.callableAt(index: i)
            val f = self.arena.functionAt(index: cand.funcIdx)
            if f.viewOnly {
                if f.extId == 0U64 && cand.sourceKind == 2U64 { gatedCandidates.append(i) }
                continue
            }
            if !(try self.callableReceiverMatches(f: f, recvId: qRecvId, recvRef: recvRef)) { continue }
            val matchRank = try self.groundedMethodArgMatchRank(callee: cand.funcIdx, args: args, recvRef: recvRef)
            if matchRank != 0U64 {
                if firstLabel == self.arena.functionCount() {
                    firstLabel = cand.funcIdx
                }
                if matchRank == 2U64 {
                    if cand.sourceKind == 0U64 {
                        if inherentMatch == self.arena.functionCount() {
                            inherentMatch = cand.funcIdx
                        } else if inherentMatch2 == self.arena.functionCount() && cand.funcIdx != inherentMatch {
                            inherentMatch2 = cand.funcIdx
                        }
                    }
                    if typeMatch == self.arena.functionCount() {
                        typeMatch = cand.funcIdx
                        typeMatchEntry = i
                    } else {
                        if typeMatch2 == self.arena.functionCount() && !(try self.sameCallableMemberInstance(a: self.decls.callableAt(index: typeMatchEntry), b: cand, receiverRef: recvRef)) {
                            typeMatch2 = cand.funcIdx
                            typeMatch2Entry = i
                        }
                    }
                }
            }
        }
        // Inherent methods are the bare default over trait-provided methods with
        // the same selector.  The provided copy remains registered so `#Trait`
        // can select it; only bare lookup gives the inherent surface priority.
        if inherentMatch != self.arena.functionCount() {
            try self.checkMethodOverloadAmbiguity(a: inherentMatch, b: inherentMatch2, args: args, receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, methodOrigin: methodOrigin)
            if inherentMatch2 != self.arena.functionCount() {
                return <Result.Err error=self.memberCallAmbiguityDiagnostic(kind: <MemberCallAmbiguityKind.MethodOverloads />, receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin) />
            }
            return <Result.Ok value=<MemberCallLookup.Selected function=inherentMatch /> />
        }
        if typeMatch != self.arena.functionCount() {
            // Collection retained distinct declaration/instance identities.
            // Preserve the existing cross-trait diagnostic; collisions within
            // one source report the actual overload or instance ambiguity.
            if typeMatch2 != self.arena.functionCount() {
                if typeMatchEntry < self.decls.callableCount() && typeMatch2Entry < self.decls.callableCount() {
                    if self.decls.callableAt(index: typeMatchEntry).sourceKind == 2U64 && self.decls.callableAt(index: typeMatch2Entry).sourceKind == 2U64 {
                        val first = self.decls.callableAt(index: typeMatchEntry)
                        val second = self.decls.callableAt(index: typeMatch2Entry)
                        if self.sameCallableSourceOrigins(a: first, b: second) {
                            return <Result.Err error=self.memberCallAmbiguityDiagnostic(kind: self.memberCandidateAmbiguityKind(a: first, b: second), receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin) />
                        }
                        return <Result.Err error=self.bareMethodAmbiguityDiagnostic(nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin) />
                    }
                }
            }
            try self.checkMethodOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args, receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, methodOrigin: methodOrigin)
            return <Result.Ok value=<MemberCallLookup.Selected function=typeMatch /> />
        }
        if !typeMatchOnly && firstLabel != self.arena.functionCount() {
            return <Result.Ok value=<MemberCallLookup.DiagnosticCandidate function=firstLabel /> />
        }
        mut val gatedSources: Array[CallableSourceHead] = []
        for candidate in gatedCandidates {
            val entry = self.decls.callableAt(index: candidate)
            val function = self.arena.functionAt(index: entry.funcIdx)
            if !self.methodIsVisible(mf: function, offset: if useOffset != 0U64 { give useOffset } else { give nameStart }) { continue }
            if !(try self.callableReceiverMatches(f: function, recvId: qRecvId, recvRef: recvRef)) { continue }
            if (try self.groundedMethodArgMatchRank(callee: entry.funcIdx, args: args, recvRef: recvRef)) != 2U64 { continue }
            val source = self.callableSourceKey(c: entry)
            mut val seen = false
            for existing in gatedSources { if self.sameCallableSourceHead(a: existing, b: source) { seen = true } }
            if !seen { gatedSources.append(source) }
        }
        if gatedSources.count() > 1U64 {
            return <Result.Err error=self.bareMethodAmbiguityDiagnostic(nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin) />
        }
        return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
    }
}

pub impl Comp {

    // Resolve a written `#Name` to one semantic source key before method
    // lookup. The spelling is only an input to this conversion: candidates
    // thereafter compare kind + declaration/bundle owner + arity.
    inout fn resolveViewSourceKey(recvStart: U64, recvLen: U64, recvRef: U64, sourceId: U64, sourceOwner: U64 = 0U64) -> Result[CallableSourceHead, CompileDiagnostic] {
        val receiverHead = self.arena.typeHeadSpan(ref: recvRef, fallback: <InternedSpan start=recvStart len=recvLen />)
        // Lowering has already distinguished the extension bundle from a
        // trait declaration. Only trait selectors can use the conformance table.
        if sourceOwner == 0U64 {
            if self.traceCodegen { eprint(text: "[trace-codegen] legacy extension applicability query\n") }
            if try self.extAppliesToType(extensionId: sourceId, typeStart: receiverHead.start, typeLen: receiverHead.len, typeRef: recvRef, assumptions: self.functionBoundAssumptions(fnIdx: self.cur.checkFn)) {
                return <Result.Ok value=<CallableSourceHead kind=1U64 id=sourceId owner=sourceId /> />
            }
            return <Result.Ok value=<CallableSourceHead /> />
        }
        mut val found: CallableSourceHead = <CallableSourceHead />
        val traitOwner = sourceOwner
        // A declared bound establishes the same source identity as a concrete
        // conformance. Preserve the lexical trait owner through re-exports;
        // the receiver's spelling alone cannot identify an abstract proof.
        if recvRef != 0U64 && self.cur.checkFn < self.arena.functionCount() {
            mut val boundIndex = 0U64
            while boundIndex < self.decls.funcBounds.count() {
                val bound = self.decls.funcBounds.at(index: boundIndex)
                if bound.fnIdx == self.cur.checkFn && bound.constraint.key.owner == traitOwner && bound.paramTy != 0U64 && self.typeRefEq(a: bound.paramTy, b: self.typeRefWithoutOuterViews(ref: recvRef)) {
                    val key = <CallableSourceHead kind=2U64 id=sourceId owner=traitOwner arity=bound.constraint.key.positionalArgs.count() />
                    if found.kind == 0U64 { found = key }
                    else if !self.sameCallableSourceHead(a: found, b: key) { return <Result.Ok value=<CallableSourceHead /> /> }
                }
                boundIndex += 1U64
            }
        }
        if self.traceCodegen {
            eprint(text: "[trace-codegen] view-source trait query\n")
        }
        val recvId: U64 = intern(c: inout self, start: receiverHead.start, len: receiverHead.len)
        mut val i: U64 = 0U64
        while i < self.decls.conformCount() {
            val cf: Conform = self.decls.conformAt(index: i)
            if cf.extId == 0U64 && cf.typeId == recvId && cf.traitStart == traitOwner {
                if self.traceCodegen {
                    eprint(text: "[trace-codegen] view-source matching conformance key\n")
                }
                if self.conformanceSubjectMatches(cf: cf, typeRef: recvRef) {
                    if self.traceCodegen {
                        eprint(text: "[trace-codegen] view-source subject matches\n")
                    }
                    val key: CallableSourceHead = <CallableSourceHead kind=2U64 id=sourceId owner=cf.traitStart arity=cf.traitArgs.count() />
                    if found.kind == 0U64 {
                        found = key
                    } else if !(self.sameCallableSourceHead(a: found, b: key)) {
                        return <Result.Ok value=<CallableSourceHead /> />
                    }
                }
            }
            i += 1U64
        }
        return <Result.Ok value=found />
    }

    inout fn appendViewSource(sources: inout Array[CallableSourceHead], source: CallableSourceHead) {
        if source.kind == 0U64 { return }
        mut val i: U64 = 0U64
        while i < sources.count() {
            if self.sameCallableSourceHead(a: sources[i], b: source) { return }
            i += 1U64
        }
        sources.append(source)
    }
}

impl Comp {
    inout fn collectCallableViewSource(recvStart: U64, recvLen: U64, recvRef: U64, sourceId: U64, sourceOwner: U64, extensionProofs: Array[SourceExtensionViewProof]) -> Result[CallableSourceHead, CompileDiagnostic] {
        if sourceOwner == 0U64 {
            for saved in extensionProofs {
                if saved.source.surfaceId == sourceId {
                    return <Result.Ok value=<CallableSourceHead kind=1U64 id=sourceId owner=sourceId /> />
                }
            }
        }
        return self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: sourceId, sourceOwner: sourceOwner)
    }

    // Collect active view conditions without making their textual order semantic.
    // `value#E#A` and `value#A#E` therefore carry the same extension source E
    // and trait selector A. A strip ends the inherited chain but not the call's
    // own trailing source.
    inout fn collectViewSources(recv: U64, recvStart: U64, recvLen: U64, recvRef: U64, finalSourceId: U64 = 0U64, finalSourceOwner: U64 = 0U64, readReceiverSyntax: Bool = true, extensionProofs: Array[SourceExtensionViewProof] = [], admittedTrait: Optional[ResolvedViewSource] = <Optional.None />) -> Result[Array[CallableSourceHead], CompileDiagnostic] {
        mut val sources: Array[CallableSourceHead] = []
        // A TypeRef caches the source selectors already written on this
        // expression. Keep those AST selectors distinct from inherited local
        // type views, so the cache never re-resolves one written selector with
        // weaker provenance and turns it into another same-named owner.
        mut val writtenIds: Array[ResolvedViewSource] = []
        if admittedTrait.isSome() {
            val selected = admittedTrait.unwrap()
            val key = selected.traitInstance
            self.appendViewSource(sources: inout sources, source: <CallableSourceHead kind=2U64 id=selected.surfaceId owner=key.owner arity=key.positionalArgs.count() />)
            writtenIds.append(selected)
        }
        if finalSourceId != 0U64 && (!admittedTrait.isSome() || finalSourceOwner != admittedTrait.unwrap().traitInstance.owner) {
            self.appendViewSource(sources: inout sources, source: (try self.collectCallableViewSource(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: finalSourceId, sourceOwner: finalSourceOwner, extensionProofs: extensionProofs)))
            writtenIds.append(<ResolvedViewSource surfaceId=finalSourceId traitInstance=<TraitInstanceKey owner=finalSourceOwner positionalArgs=[] /> />)
        }
        mut val cur: U64 = recv
        mut val go: Bool = true
        mut val stripped: Bool = false
        if !(readReceiverSyntax) { go = false }
        while go {
            match self.arena.exprs[cur] {
                Expr.ExtView(recv: val base, source: val selector, strip: val strip) => {
                    if strip {
                        stripped = true
                        go = false
                    } else {
                        val selectorId: U64 = selector.surfaceId
                        // The outer `#Source` of an ExtMethod is passed as
                        // finalSourceId and is also this AST node. Normalize
                        // that selector exactly once with its authored
                        // provenance: resolving it again from only its
                        // spelling can select a different same-named trait
                        // owner and manufacture an ambiguity.
                        val retained = admittedTrait.isSome() && selector.traitInstance.owner == admittedTrait.unwrap().traitInstance.owner && selectorId == admittedTrait.unwrap().surfaceId
                        if !retained && (selectorId != finalSourceId || selector.traitInstance.owner != finalSourceOwner) {
                            self.appendViewSource(sources: inout sources, source: (try self.collectCallableViewSource(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: selectorId, sourceOwner: selector.traitInstance.owner, extensionProofs: extensionProofs)))
                        }
                        mut val written: Bool = false
                        mut val wi: U64 = 0U64
                        while wi < writtenIds.count() {
                            if writtenIds[wi].sameHead(other: selector) { written = true }
                            wi += 1U64
                        }
                        if !written { writtenIds.append(selector) }
                        cur = base
                    }
                }
                _ => { go = false }
            }
        }
        // The enclosing extension declaration establishes the implicit self
        // view, even before the receiver has a view-bearing type term.
        mut val lexicalExtension = 0U64
        if readReceiverSyntax && !stripped {
            match self.arena.exprs[cur] {
                Expr.Ident(start: val selfStart, len: val selfLen) => {
                    if self.isSelfRef(start: selfStart, len: selfLen) && self.cur.extId != 0U64 {
                        lexicalExtension = self.cur.extId
                        self.appendViewSource(sources: inout sources, source: <CallableSourceHead kind=1U64 id=lexicalExtension owner=lexicalExtension />)
                    }
                }
                _ => {}
            }
        }
        if !stripped && recvRef != 0U64 && recvRef < self.arena.typeCount() {
            val staticSources: Array[ResolvedViewSource] = self.arena.typeViewSources(ref: recvRef)
            mut val si: U64 = 0U64
            while si < staticSources.count() {
                mut val written: Bool = false
                mut val wi: U64 = 0U64
                while wi < writtenIds.count() {
                    if writtenIds[wi].sameHead(other: staticSources[si]) { written = true }
                    wi += 1U64
                }
                val inheritedLexical = staticSources[si].traitInstance.owner == 0U64 && staticSources[si].surfaceId == lexicalExtension
                if !written && !inheritedLexical {
                    self.appendViewSource(sources: inout sources, source: (try self.collectCallableViewSource(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: staticSources[si].surfaceId, sourceOwner: staticSources[si].traitInstance.owner, extensionProofs: extensionProofs)))
                }
                si += 1U64
            }
        }
        return <Result.Ok value=sources />
    }

    // Protocol syntax supplies a canonical trait identity. It narrows an
    // existing view set; an inherent same-named method cannot satisfy it.
    inout fn appendRequiredTraitSource(sources: inout Array[CallableSourceHead], owner: U64) -> Bool {
        if owner == 0U64 { return true }
        val index = self.decls.traitOwnerIndex(offset: owner)
        if index >= self.decls.traitOwnerCount() { return false }
        val declaration = self.decls.traitOwnerAt(index: index)
        self.appendViewSource(sources: inout sources, source: <CallableSourceHead kind=2U64 id=intern(c: inout self, start: owner, len: declaration.nameLen) owner=owner arity=declaration.arity />)
        return true
    }

    // The semantic query for a method call whose receiver has already been
    // grounded by a BodyInstance.  Candidate search, newtype normalization and
    // view-source normalization belong to the frontend resolver; Mono supplies
    // only the concrete receiver term it obtained from its environment.
    inout fn resolveMethodForResolvedReceiver(recv: U64, surfaceRef: U64, sourceId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: ArgRange, useOffset: U64, readReceiverSyntax: Bool = true, requiredTraitOwner: U64 = 0U64, extensionProofs: Array[SourceExtensionViewProof] = [], admittedTrait: Optional[ResolvedViewSource] = <Optional.None />) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.selectedMemberFunction(selection: (try self.resolveMethodForResolvedReceiverWithOrigin(recv: recv, surfaceRef: surfaceRef, sourceId: sourceId, sourceOwner: sourceOwner, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: useOffset, readReceiverSyntax: readReceiverSyntax, requiredTraitOwner: requiredTraitOwner, extensionProofs: extensionProofs, admittedTrait: admittedTrait))) />
    }
}

impl Comp {
    inout fn resolveMethodForResolvedReceiverWithOrigin(recv: U64, surfaceRef: U64, sourceId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: ArgRange, useOffset: U64, readReceiverSyntax: Bool = true, requiredTraitOwner: U64 = 0U64, extensionProofs: Array[SourceExtensionViewProof] = [], admittedTrait: Optional[ResolvedViewSource] = <Optional.None />, methodOrigin: MethodLookupOrigin = <MethodLookupOrigin />) -> Result[MemberCallLookup, CompileDiagnostic] {
        if surfaceRef == 0U64 || surfaceRef >= self.arena.typeCount() {
            return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
        }
        // A newtype is a distinct source type but inherits the underlying
        // callable surface and representation. Normalize inside the semantic
        // query so every caller applies the same rule.
        mut val resolvedRef: U64 = surfaceRef
        val original: TypeRef = self.arena.typeAt(index: surfaceRef)
        val underlying: U64 = try self.checkedNominalUnderlying(ref: surfaceRef)
        if underlying != 0U64 && underlying < self.arena.typeCount() {
            resolvedRef = underlying
        }
        val rt: TypeRef = self.arena.typeAt(index: resolvedRef)
        mut val sources: Array[CallableSourceHead] = (try self.collectViewSources(recv: recv, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: surfaceRef, finalSourceId: sourceId, finalSourceOwner: sourceOwner, readReceiverSyntax: readReceiverSyntax, extensionProofs: extensionProofs, admittedTrait: admittedTrait))
        if !self.appendRequiredTraitSource(sources: inout sources, owner: requiredTraitOwner) { return <Result.Ok value=<MemberCallLookup.NoCandidate /> /> }
        mut val callee: MemberCallLookup = <MemberCallLookup.NoCandidate />
        if sources.count() > 0U64 {
            callee = (try self.findCallableInViewSetWithOrigin(recvStart: rt.nameStart, recvLen: rt.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: false, recvRef: resolvedRef, requiredTraitOwner: requiredTraitOwner, methodOrigin: methodOrigin))
        }
        if self.memberLookupIsMissing(selection: callee) && requiredTraitOwner == 0U64 {
            callee = (try self.findMethodWithOrigin(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: resolvedRef, useOffset: useOffset, methodOrigin: methodOrigin))
        }
        return <Result.Ok value=callee />
    }
}

pub impl Comp {

}

pub impl Comp {
    // The associated-callable twin of resolveMethodForResolvedReceiver. A
    // bare `pow(base:, exp:)` is syntactically a free call, but its semantic
    // subject is the base value and its target is an associated trait member.
    // Keep view/newtype normalization in this one frontend query so static
    // associated calls and explicit `Type#View.member()` cannot drift.
    inout fn resolveAssocForResolvedReceiver(surfaceRef: U64, sourceId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: ArgRange, useOffset: U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.selectedMemberFunction(selection: (try self.lookupAssocForResolvedReceiver(surfaceRef: surfaceRef, sourceId: sourceId, sourceOwner: sourceOwner, nameStart: nameStart, nameLen: nameLen, args: args, useOffset: useOffset))) />
    }

    fn viewSetHasTrait(sources: Array[CallableSourceHead]) -> Bool {
        mut val i: U64 = 0U64
        while i < sources.count() {
            if sources[i].kind == 2U64 { return true }
            i += 1U64
        }
        return false
    }

    fn callableMatchesAnyExtension(c: Callable, sources: Array[CallableSourceHead]) -> Bool {
        if c.sourceKind != 1U64 { return false }
        mut val i: U64 = 0U64
        while i < sources.count() {
            if sources[i].kind == 1U64 && self.callableMatchesSource(c: c, source: sources[i]) { return true }
            i += 1U64
        }
        return false
    }

    fn callableMatchesAnyTrait(c: Callable, sources: Array[CallableSourceHead]) -> Bool {
        mut val i: U64 = 0U64
        while i < sources.count() {
            if sources[i].kind == 2U64 && self.callableMatchesTrait(c: c, source: sources[i]) { return true }
            i += 1U64
        }
        return false
    }

    // Resolve one final callable from an unordered set of active views. An
    // extension source shadows the bare surface; a trait source narrows the
    // extension candidates (or, if none exist, the bare trait candidates).
    // `associated` is deliberately a resolver dimension, rather than a
    // separate lookup implementation.  `Type#E.make()` and `value#E.make()`
    // differ only in the receiver surface they address; their active source
    // set, provenance narrowing, overload ranking, and ambiguity rule are
    // identical.
    inout fn findCallableInViewSet(recvStart: U64, recvLen: U64, sources: Array[CallableSourceHead], nameStart: U64, nameLen: U64, args: ArgRange, associated: Bool, recvRef: U64 = 0U64, requiredTraitOwner: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.observedMemberFunction(selection: (try self.findCallableInViewSetWithOrigin(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: associated, recvRef: recvRef, requiredTraitOwner: requiredTraitOwner, methodOrigin: <MethodLookupOrigin />))) />
    }
}
impl Comp {
    inout fn findCallableInViewSetWithOrigin(recvStart: U64, recvLen: U64, sources: Array[CallableSourceHead], nameStart: U64, nameLen: U64, args: ArgRange, associated: Bool, recvRef: U64 = 0U64, requiredTraitOwner: U64 = 0U64, methodOrigin: MethodLookupOrigin) -> Result[MemberCallLookup, CompileDiagnostic] {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val useMod: U64 = self.moduleOf(offset: nameStart)
        mut val pass: U64 = 0U64
        while pass < 2U64 {
            mut val firstLabel: U64 = self.arena.functionCount()
            mut val typeMatch: U64 = self.arena.functionCount()
            mut val typeMatch2: U64 = self.arena.functionCount()
            mut val typeMatchEntry: U64 = self.decls.callableCount()
            mut val typeMatch2Entry: U64 = self.decls.callableCount()
            mut val names = self.nominalMemberNames(name: qNameId, receiver: qRecvId, receiverTerm: recvRef, declaration: self.missingDeclIdentity(), surface: <NominalMemberSurface.ViewSet sources=sources associated=associated pass=pass requiredTraitOwner=requiredTraitOwner />)
            while true {
                val i = match self.nextNominalMemberName(cursor: inout names) { Optional.Some(v: val index) => index Optional.None => { break } }
                val cand = self.decls.callableAt(index: i)
                val f = self.arena.functionAt(index: cand.funcIdx)
                if !(try self.callableReceiverMatches(f: f, recvId: qRecvId, recvRef: recvRef)) { continue }
                val matchRank = try self.groundedMethodArgMatchRank(callee: cand.funcIdx, args: args, recvRef: recvRef)
                if matchRank != 0U64 {
                    if firstLabel == self.arena.functionCount() { firstLabel = cand.funcIdx }
                    if matchRank == 2U64 {
                        if typeMatch == self.arena.functionCount() {
                            typeMatch = cand.funcIdx
                            typeMatchEntry = i
                        } else if typeMatch2 == self.arena.functionCount() && !(try self.sameCallableMemberInstance(a: self.decls.callableAt(index: typeMatchEntry), b: cand, receiverRef: recvRef)) {
                            typeMatch2 = cand.funcIdx
                            typeMatch2Entry = i
                        }
                    }
                }
            }
            if typeMatch != self.arena.functionCount() {
                try self.checkMethodOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args, receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, methodOrigin: methodOrigin)
                if typeMatch2 != self.arena.functionCount() {
                    if typeMatchEntry < self.decls.callableCount() && typeMatch2Entry < self.decls.callableCount() {
                        return <Result.Err error=self.memberCallAmbiguityDiagnostic(kind: self.memberCandidateAmbiguityKind(a: self.decls.callableAt(index: typeMatchEntry), b: self.decls.callableAt(index: typeMatch2Entry)), receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin) />
                    }
                    return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "ambiguous source-qualified call: this source provides more than one matching method") />
                }
                return <Result.Ok value=<MemberCallLookup.Selected function=typeMatch /> />
            }
            if firstLabel != self.arena.functionCount() { return <Result.Ok value=<MemberCallLookup.DiagnosticCandidate function=firstLabel /> />}
            pass += 1U64
        }
        return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
    }

}
pub impl Comp {
    inout fn findMethodInViewSet(recvStart: U64, recvLen: U64, sources: Array[CallableSourceHead], nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64, requiredTraitOwner: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=(try self.findCallableInViewSet(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: false, recvRef: recvRef, requiredTraitOwner: requiredTraitOwner)) />
    }

    inout fn findAssocInViewSet(recvStart: U64, recvLen: U64, sources: Array[CallableSourceHead], nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=(try self.findCallableInViewSet(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: true, recvRef: recvRef)) />
    }

    // The one resolver for a source-selected method call. A `#` view is
    // additive: active extension candidates shadow the base surface, selected
    // traits narrow those candidates, then the bare surface is the fallback.
    // Type recovery, verifier, and backend consume this exact final Func.
    inout fn resolveExtMethodFinal(recv: U64, source: ResolvedViewSource, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.selectedMemberFunction(selection: (try self.resolveExtMethodFinalWithOrigin(recv: recv, source: source, nameStart: nameStart, nameLen: nameLen, args: args))) />
    }
}

impl Comp {
    inout fn resolveExtMethodFinalWithOrigin(recv: U64, source: ResolvedViewSource, nameStart: U64, nameLen: U64, args: ArgRange, methodOrigin: MethodLookupOrigin = <MethodLookupOrigin />) -> Result[MemberCallLookup, CompileDiagnostic] {
        // `Type#Source.member()` is the associated counterpart of a value
        // view.  It has no value TypeInfo, so select its source from the type
        // qualifier before entering the ordinary receiver path.
        val assoc: Bind = self.assocRecvName(recv: recv)
        if assoc.nameLen != 0U64 {
            val recvRef: U64 = self.simpleTypeRef(nameStart: assoc.nameStart, nameLen: assoc.nameLen)
            val sources: Array[CallableSourceHead] = (try self.collectViewSources(recv: recv, recvStart: assoc.nameStart, recvLen: assoc.nameLen, recvRef: recvRef, finalSourceId: source.surfaceId, finalSourceOwner: source.traitInstance.owner))
            val selected: MemberCallLookup = (try self.findCallableInViewSetWithOrigin(recvStart: assoc.nameStart, recvLen: assoc.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: true, recvRef: recvRef, methodOrigin: methodOrigin))
            if !self.memberLookupIsMissing(selection: selected) { return <Result.Ok value=selected />}
            return <Result.Ok value=(try self.findAssocWithOrigin(recvStart: assoc.nameStart, recvLen: assoc.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin)) />
        }
        val rt: TypeInfo = (try self.typeOf(id: recv))
        if !(rt.kind == 2 || (rt.kind == 0 && rt.nameLen > 0U64)) {
            return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
        }
        val sources: Array[CallableSourceHead] = (try self.collectViewSources(recv: recv, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: rt.ref, finalSourceId: source.surfaceId, finalSourceOwner: source.traitInstance.owner))
        mut val mfi: MemberCallLookup = (try self.findCallableInViewSetWithOrigin(recvStart: rt.nameStart, recvLen: rt.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: false, recvRef: rt.ref, methodOrigin: methodOrigin))
        if self.memberLookupIsMissing(selection: mfi) {
            mfi = (try self.findMethodWithOrigin(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: rt.ref, methodOrigin: methodOrigin))
        }
        return <Result.Ok value=mfi />
    }
}

pub impl Comp {

    // Ordinary syntax still carries a view when its receiver was declared as
    // `T#Source`. Resolve that static source before the additive bare surface;
    // this is the same final-callable contract as explicit `value#Source.m()`.
    inout fn resolveMethodFinal(recv: U64, nameStart: U64, nameLen: U64, args: ArgRange) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.selectedMemberFunction(selection: (try self.resolveMethodFinalWithOrigin(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args))) />
    }
}

impl Comp {
    inout fn resolveMethodFinalWithOrigin(recv: U64, nameStart: U64, nameLen: U64, args: ArgRange, methodOrigin: MethodLookupOrigin = <MethodLookupOrigin />) -> Result[MemberCallLookup, CompileDiagnostic] {
        return <Result.Ok value=(try self.resolveMethodFinalForTypeWithOrigin(recv: recv, receiverType: (try self.typeOf(id: recv)), nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin)) />
    }
}

pub impl Comp {

    // Selection over an already-resolved semantic receiver. A ChainHole
    // continuation owns that receiver term structurally, so re-deriving it
    // from the context-free ExprId query would discard the payload binding.
    inout fn resolveMethodFinalForType(recv: U64, receiverType: TypeInfo, nameStart: U64, nameLen: U64, args: ArgRange, requiredTraitOwner: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.selectedMemberFunction(selection: (try self.resolveMethodFinalForTypeWithOrigin(recv: recv, receiverType: receiverType, nameStart: nameStart, nameLen: nameLen, args: args, requiredTraitOwner: requiredTraitOwner))) />
    }
}

impl Comp {
    inout fn resolveMethodFinalForTypeWithOrigin(recv: U64, receiverType: TypeInfo, nameStart: U64, nameLen: U64, args: ArgRange, requiredTraitOwner: U64 = 0U64, methodOrigin: MethodLookupOrigin = <MethodLookupOrigin />) -> Result[MemberCallLookup, CompileDiagnostic] {
        val rt: TypeInfo = receiverType
        if !(rt.kind == 2 || rt.kind == 3 || (rt.kind == 0 && rt.nameLen > 0U64)) {
            return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
        }
        // Array values carry their element name in TypeInfo, while the method
        // namespace is the structured `Array[E]` TypeRef head.  Keep this
        // recovery in the final resolver so Mono, validation, and backend use
        // the same callable decision rather than a backend-only Array lookup.
        mut val recvStart: U64 = rt.nameStart
        mut val recvLen: U64 = rt.nameLen
        if rt.kind == 3 && rt.ref != 0U64 && rt.ref < self.arena.typeCount() {
            recvStart = self.arena.typeTermAt(index: rt.ref).nameStart
            recvLen = self.arena.typeTermAt(index: rt.ref).nameLen
        }
        mut val mfi: MemberCallLookup = <MemberCallLookup.NoCandidate />
        // Always start from the complete view set.  A multi-view TypeRef deliberately
        // has no legacy `viewExtId`, so using that scalar as the gate would silently
        // turn `T#E#F` back into a bare `T` at this one call-site shape.
        mut val sources: Array[CallableSourceHead] = (try self.collectViewSources(recv: recv, recvStart: recvStart, recvLen: recvLen, recvRef: rt.ref))
        // An identifier's declared view is authoritative even when an earlier
        // context-free recovery filled its expression cache before this body's
        // locals were installed. Keep this repair at the resolver boundary rather
        // than teaching each caller a separate static-view special case.
        if sources.count() == 0U64 {
            match self.arena.exprs[recv] {
                Expr.Ident(start: val localStart, len: val localLen) => {
                    val li = self.localIndexByName(start: localStart, len: localLen)
                    if li < self.cur.locals.count() {
                        val lo = (try self.typedLocal(index: li))
                        if lo.ty != 0U64 && lo.ty < self.arena.typeCount() {
                            val localTy: TypeRef = self.arena.typeAt(index: lo.ty)
                            val localSources: Array[ResolvedViewSource] = self.arena.typeViewSources(ref: lo.ty)
                            mut val vi: U64 = 0U64
                            while vi < localSources.count() {
                                val localSource: ResolvedViewSource = localSources[vi]
                                self.appendViewSource(sources: inout sources, source: (try self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: lo.ty, sourceId: localSource.surfaceId, sourceOwner: localSource.traitInstance.owner)))
                                vi += 1U64
                            }
                        }
                    }
                }
                _ => {}
            }
        }
        if !self.appendRequiredTraitSource(sources: inout sources, owner: requiredTraitOwner) { return <Result.Ok value=<MemberCallLookup.NoCandidate /> /> }
        if sources.count() > 0U64 {
            mfi = (try self.findCallableInViewSetWithOrigin(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: false, recvRef: rt.ref, requiredTraitOwner: requiredTraitOwner, methodOrigin: methodOrigin))
        }
        if self.memberLookupIsMissing(selection: mfi) && requiredTraitOwner == 0U64 {
            mfi = (try self.findMethodWithOrigin(recvStart: recvStart, recvLen: recvLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: rt.ref, methodOrigin: methodOrigin))
        }
        return <Result.Ok value=mfi />
    }
}

pub impl Comp {

    inout fn extMethodNameExists(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = self.decls.firstCallableNamed(nameId: qNameId)
        while i < self.decls.callableCount() {
            val cand: Callable = self.decls.callableAt(index: i)
            val f: Func = self.arena.functionAt(index: cand.funcIdx)
            if f.hasRecv {
                if f.extId != 0U64 {
                    if f.recvId == qRecvId {
                        if f.nameId == qNameId {
                            return true
                        }
                    }
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return false
    }

    inout fn viewOnlyMethodExists(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = self.decls.firstCallableNamed(nameId: qNameId)
        while i < self.decls.callableCount() {
            val cand: Callable = self.decls.callableAt(index: i)
            val f: Func = self.arena.functionAt(index: cand.funcIdx)
            if f.hasRecv {
                if f.viewOnly {
                    if f.recvId == qRecvId {
                        if f.nameId == qNameId {
                            return true
                        }
                    }
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return false
    }



    inout fn findExtMethodBySource(recvStart: U64, recvLen: U64, source: CallableSourceHead, nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.observedMemberFunction(selection: (try self.selectExtMethodBySource(recvStart: recvStart, recvLen: recvLen, source: source, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef))) />
    }

    // Associated lookup precedes argument inference, so an authored bare
    // generic qualifier may have no arguments yet. Restrict the declaration
    // identity here; argument/pattern checking remains in its normal phase.
    fn receiverDeclarationMatches(f: Func, receiverRef: U64) -> Bool {
        if receiverRef == 0U64 || receiverRef >= self.arena.typeCount() || f.recvTy == 0U64 || f.recvTy >= self.arena.typeCount() { return true }
        mut val receiver = receiverRef
        val underlying = self.arena.newtypeUnderlying(ref: receiver)
        if underlying != 0U64 { receiver = underlying }
        val selected = self.arena.typeTermAt(index: receiver)
        val declared = self.arena.typeTermAt(index: f.recvTy)
        if selected.hasDecl && declared.hasDecl { return selected.declOffset == declared.declOffset }
        return true
    }

    // A bare generic qualifier already determines its declaration even
    // though it cannot yet supply a complete instantiated receiver term.
    fn receiverDeclarationHasOwner(f: Func, declaration: Bind) -> Bool {
        if declaration.nameLen == 0U64 { return true }
        if f.recvTy == 0U64 || f.recvTy >= self.arena.typeCount() { return false }
        val receiver = self.arena.typeTermAt(index: f.recvTy)
        return receiver.hasDecl && receiver.declOffset == declaration.nameStart
    }

    inout fn findAssoc(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        return <Result.Ok value=self.observedMemberFunction(selection: (try self.findAssocWithOrigin(recvStart: recvStart, recvLen: recvLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef))) />
    }
}

impl Comp {
    inout fn findAssocWithOrigin(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64, methodOrigin: MethodLookupOrigin = <MethodLookupOrigin />) -> Result[MemberCallLookup, CompileDiagnostic] {
        mut val firstLabel: U64 = self.arena.functionCount()
        mut val typeMatch: U64 = self.arena.functionCount()
        mut val typeMatch2: U64 = self.arena.functionCount()
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        // a newtype inherits the underlying's assoc fns/factories (spec/10): resolve the
        // receiver name to the underlying so `Brand.checked(…)` finds Rgb's `checked`.
        val source = self.realTypeNameInModule(useMod: self.moduleOf(offset: recvStart), start: recvStart, len: recvLen)
        val rnu: Bind = self.newtypeUnderName(start: source.nameStart, len: source.nameLen)
        val qRecvId: U64 = intern(c: inout self, start: rnu.nameStart, len: rnu.nameLen)
        val receiverDeclaration = if recvRef == 0U64 {
            give self.typeDeclIdentityAt(useMod: self.moduleOf(offset: rnu.nameStart), start: rnu.nameStart, len: rnu.nameLen)
        } else { give self.missingDeclIdentity() }
        mut val names = self.nominalMemberNames(name: qNameId, receiver: qRecvId, receiverTerm: recvRef, declaration: receiverDeclaration, surface: <NominalMemberSurface.Associated />)
        while true {
            val i = match self.nextNominalMemberName(cursor: inout names) {
                Optional.Some(v: val index) => index
                Optional.None => { break }
            }
            val cand = self.decls.callableAt(index: i)
            val f = self.arena.functionAt(index: cand.funcIdx)
            // A bare head fixes the declaration, not missing type arguments.
            val candidateReceiver = if recvRef != 0U64 { give recvRef } else { give f.recvTy }
            val matchRank = try self.groundedMethodArgMatchRank(callee: cand.funcIdx, args: args, recvRef: candidateReceiver)
            if matchRank != 0U64 {
                if firstLabel == self.arena.functionCount() {
                    firstLabel = cand.funcIdx
                }
                if matchRank == 2U64 {
                    if typeMatch == self.arena.functionCount() {
                        typeMatch = cand.funcIdx
                    } else {
                        if typeMatch2 == self.arena.functionCount() {
                            typeMatch2 = cand.funcIdx
                        }
                    }
                }
            }
        }
        if typeMatch != self.arena.functionCount() {
            // A type qualifier carries only the receiver head (`Box.tag()`),
            // not generic arguments.  Distinct receiver patterns that both
            // reach this point therefore cannot be selected by the caller.
            if typeMatch2 != self.arena.functionCount() {
                return <Result.Err error=self.memberCallAmbiguityDiagnostic(kind: <MemberCallAmbiguityKind.AssociatedReceiverPatterns />, receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, args: args, methodOrigin: methodOrigin) />
            }
            try self.checkMethodOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args, receiverRef: recvRef, nameStart: nameStart, nameLen: nameLen, methodOrigin: methodOrigin)
            return <Result.Ok value=<MemberCallLookup.Selected function=typeMatch /> />
        }
        // A concrete trait-subject witness carries a trait source even on
        // the bare surface. Keep inherent/namespace calls above, then use
        // the shared provided-call contract instead of dropping that source.
        val provided = try self.findMethodWithOrigin(recvStart: rnu.nameStart, recvLen: rnu.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef, associated: true, typeMatchOnly: true, methodOrigin: methodOrigin)
        if !self.memberLookupIsMissing(selection: provided) { return <Result.Ok value=provided /> }
        if firstLabel != self.arena.functionCount() { return <Result.Ok value=<MemberCallLookup.DiagnosticCandidate function=firstLabel /> /> }
        return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
    }
}

pub impl Comp {

    inout fn isTypeName(start: U64, len: U64) -> Bool {
        val declaration = self.typeDeclIdentityAt(useMod: self.moduleOf(offset: start), start: start, len: len)
        return declaration.nameLen != 0U64
    }

    inout fn checkedAssociatedReceiverName(start: U64, len: U64) -> Result[Bind, CompileDiagnostic] {
        val useMod = self.moduleOf(offset: start)
        if self.arena.newtypeCount() == 0U64 {
            return <Result.Ok value=self.realTypeNameInModule(useMod: useMod, start: start, len: len) />
        }
        val identity = self.typeDeclIdentityAt(useMod: useMod, start: start, len: len)
        if identity.nameLen != 0U64 {
            match self.arena.newtypeByOffset(offset: identity.nameStart) {
                Optional.Some(v: val declaration) => {
                    val underlying = try self.readAdmittedNewtypeUnderlying(declaration: declaration)
                    val type = self.arena.typeAt(index: underlying)
                    return <Result.Ok value=<Bind nameStart=type.nameStart nameLen=type.nameLen fieldStart=0U64 fieldLen=0U64 /> />
                }
                Optional.None => {}
            }
        }
        return <Result.Ok value=self.realTypeNameInModule(useMod: useMod, start: start, len: len) />
    }

    inout fn typeHasAssocFn(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> Result[Bool, CompileDiagnostic] {
        // a newtype inherits the underlying type's factories/assoc fns (spec/10): resolve
        // to the underlying so `<Brand.checked …/>` finds Rgb's `checked` factory.
        val tnu = try self.checkedAssociatedReceiverName(start: typeStart, len: typeLen)
        val tId: U64 = intern(c: inout self, start: tnu.nameStart, len: tnu.nameLen)
        val nId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = self.decls.firstCallableNamed(nameId: nId)
        while i < self.decls.callableCount() {
            val cand: Callable = self.decls.callableAt(index: i)
            val f: Func = self.arena.functionAt(index: cand.funcIdx)
            if f.isAssoc {
                if f.recvId == tId {
                    if f.nameId == nId {
                        return <Result.Ok value=true />
                    }
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return <Result.Ok value=false />
    }

    inout fn funcDeclLineHasAssocVal(f: Func) -> Bool {
        mut val anchor: U64 = f.defOffset
        if anchor == 0U64 {
            anchor = f.nameStart
        }
        if anchor >= self.arena.bytes.count() {
            return false
        }
        mut val lineStart: U64 = anchor
        while lineStart > 0U64 {
            if self.arena.bytes[lineStart - 1U64] == 10U8 {
                break
            }
            lineStart -= 1
        }
        mut val sawAssoc: Bool = false
        mut val sawVal: Bool = false
        mut val i: U64 = lineStart
        while i < anchor {
            if i + 5U64 <= anchor {
                if rangeEquals(bytes: self.arena.bytes, start: i, len: 5U64, kw: "assoc") {
                    sawAssoc = true
                }
            }
            if i + 3U64 <= anchor {
                if rangeEquals(bytes: self.arena.bytes, start: i, len: 3U64, kw: "val") {
                    sawVal = true
                }
            }
            i += 1
        }
        return sawAssoc && sawVal
    }

    inout fn typeHasAssocVal(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> Result[Bool, CompileDiagnostic] {
        val tnu = try self.checkedAssociatedReceiverName(start: typeStart, len: typeLen)
        val tId: U64 = intern(c: inout self, start: tnu.nameStart, len: tnu.nameLen)
        val nId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = self.decls.firstCallableNamed(nameId: nId)
        while i < self.decls.callableCount() {
            val cand: Callable = self.decls.callableAt(index: i)
            val f: Func = self.arena.functionAt(index: cand.funcIdx)
            if f.isAssoc {
                if f.recvId == tId {
                    if f.nameId == nId {
                        if self.funcDeclLineHasAssocVal(f: f) {
                            return <Result.Ok value=true />
                        }
                    }
                }
            }
            i = self.decls.nextCallableNamed(index: i)
        }
        return <Result.Ok value=false />
    }

    // Result is a reserved Lang declaration, not the spelling of a projection
    // receiver or a generic binder. Callers normalize declaration terms first.
    inout fn resultEnumIndex(ref: U64) -> U64 {
        if ref == 0U64 || ref >= self.arena.typeCount() { return self.arena.enumCount() }
        val term = self.arena.typeTermAt(index: ref)
        if term.args.len != 2U64 { return self.arena.enumCount() }
        val index = self.enumIndexForType(ref: ref)
        if index >= self.arena.enumCount() { return index }
        val declaration = self.arena.enumAt(index: index)
        if self.moduleOf(offset: declaration.defOffset) != self.modules.langModule || !rangeEquals(bytes: self.arena.bytes, start: declaration.nameStart, len: declaration.nameLen, kw: "Result") {
            return self.arena.enumCount()
        }
        return index
    }

    inout fn rewriteAssocValReads() -> Result[(), CompileDiagnostic] {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Field(val base, val nameStart, val nameLen) => {
                    match self.arena.exprs[base] {
                        Expr.Ident(start: val tStart, len: val tLen) => {
                            if self.isTypeName(start: tStart, len: tLen) {
                                if try self.typeHasAssocVal(typeStart: tStart, typeLen: tLen, nameStart: nameStart, nameLen: nameLen) {
                                    self.arena.exprs[i] = <Expr.Method recv=base nameStart=nameStart nameLen=nameLen args=<ArgRange start=0U64 len=0U64 /> />
                                }
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            i += 1
        }
        return <Result.Ok value=() />
    }
}

impl Comp {
    inout fn sameCallableSourceOrigins(a: Callable, b: Callable) -> Bool {
        return self.sameCallableSourceHead(a: self.callableSourceKey(c: a), b: self.callableSourceKey(c: b)) && self.sameCallableSourceHead(a: self.callableTraitKey(c: a), b: self.callableTraitKey(c: b))
    }

    // A source bundle can contain different declarations and trait instances.
    // Copies coincide only at the same original declaration and receiver proof.
    inout fn sameCallableMemberInstance(a: Callable, b: Callable, receiverRef: U64) -> Result[Bool, CompileDiagnostic] {
        if a.funcIdx >= self.arena.functionCount() || b.funcIdx >= self.arena.functionCount() || !self.sameCallableSourceOrigins(a: a, b: b) { return <Result.Ok value=false /> }
        if a.funcIdx == b.funcIdx { return <Result.Ok value=true /> }
        val left = self.arena.functionAt(index: a.funcIdx)
        val right = self.arena.functionAt(index: b.funcIdx)
        if left.sourceWitnessFuncId == 0U64 || left.sourceWitnessFuncId > self.arena.functionCount() || left.sourceWitnessFuncId != right.sourceWitnessFuncId || !left.isProvided || !right.isProvided { return <Result.Ok value=false /> }
        val first = try self.providedBodyProof(f: left, receiverRef: receiverRef)
        val second = try self.providedBodyProof(f: right, receiverRef: receiverRef)
        if self.proofIsMissing(proof: first) || self.proofIsMissing(proof: second) { return <Result.Ok value=false /> }
        val firstSource = try self.providedMemberSourceProof(function: left, proof: first)
        val secondSource = try self.providedMemberSourceProof(function: right, proof: second)
        if self.proofIsMissing(proof: firstSource) || self.proofIsMissing(proof: secondSource) { return <Result.Ok value=false /> }
        return self.sameSourceProofPath(a: firstSource, b: secondSource)
    }

    inout fn memberCandidateAmbiguityKind(a: Callable, b: Callable) -> MemberCallAmbiguityKind {
        if !self.sameCallableSourceOrigins(a: a, b: b) { return <MemberCallAmbiguityKind.ActiveViews /> }
        val left = self.arena.functionAt(index: a.funcIdx)
        val right = self.arena.functionAt(index: b.funcIdx)
        if left.sourceWitnessFuncId != 0U64 && left.sourceWitnessFuncId == right.sourceWitnessFuncId { return <MemberCallAmbiguityKind.StaticInstances /> }
        return <MemberCallAmbiguityKind.MethodOverloads />
    }
}

impl Comp {
    inout fn selectExtMethodBySource(recvStart: U64, recvLen: U64, source: CallableSourceHead, nameStart: U64, nameLen: U64, args: ArgRange, recvRef: U64 = 0U64) -> Result[MemberCallLookup, CompileDiagnostic] {
        if source.kind == 0U64 { return <Result.Ok value=<MemberCallLookup.NoCandidate /> />}
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val firstLabel: U64 = self.arena.functionCount()
        mut val typeMatch: U64 = self.arena.functionCount()
        mut val typeMatch2: U64 = self.arena.functionCount()
        mut val typeMatchEntry: U64 = self.decls.callableCount()
        mut val typeMatch2Entry: U64 = self.decls.callableCount()
        mut val names = self.nominalMemberNames(name: qNameId, receiver: qRecvId, receiverTerm: recvRef, declaration: self.missingDeclIdentity(), surface: <NominalMemberSurface.Source source=source />)
        while true {
            val i = match self.nextNominalMemberName(cursor: inout names) { Optional.Some(v: val index) => index Optional.None => { break } }
            val cand = self.decls.callableAt(index: i)
            val f = self.arena.functionAt(index: cand.funcIdx)
            if !(try self.callableReceiverMatches(f: f, recvId: qRecvId, recvRef: recvRef)) { continue }
            val matchRank = try self.groundedMethodArgMatchRank(callee: cand.funcIdx, args: args, recvRef: recvRef)
            if matchRank != 0U64 {
                if firstLabel == self.arena.functionCount() {
                    firstLabel = cand.funcIdx
                }
                if matchRank == 2U64 {
                    if typeMatch == self.arena.functionCount() {
                        typeMatch = cand.funcIdx
                        typeMatchEntry = i
                    } else if typeMatch2 == self.arena.functionCount() && !(try self.sameCallableMemberInstance(a: self.decls.callableAt(index: typeMatchEntry), b: cand, receiverRef: recvRef)) {
                        typeMatch2 = cand.funcIdx
                        typeMatch2Entry = i
                    }
                }
            }
        }
        if typeMatch != self.arena.functionCount() {
            try self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            if typeMatch2 != self.arena.functionCount() {
                if typeMatchEntry < self.decls.callableCount() && typeMatch2Entry < self.decls.callableCount() {
                    if !(self.sameCallableSourceOrigins(a: self.decls.callableAt(index: typeMatchEntry), b: self.decls.callableAt(index: typeMatch2Entry))) {
                        return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "ambiguous source-qualified call: this `#` name resolves to multiple declaration sources") />
                    }
                }
                return <Result.Err error=self.diagnosticAt(offset: nameStart, msg: "ambiguous source-qualified call: this declaration source provides more than one matching method") />
            }
            return <Result.Ok value=<MemberCallLookup.Selected function=typeMatch /> />
        }
        if firstLabel != self.arena.functionCount() { return <Result.Ok value=<MemberCallLookup.DiagnosticCandidate function=firstLabel /> /> }
        return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
    }
}

impl Comp {
    fn memberLookupIsMissing(selection: MemberCallLookup) -> Bool {
        return match selection { MemberCallLookup.NoCandidate => true, _ => false }
    }
    fn selectedMemberFunction(selection: MemberCallLookup) -> U64 {
        return match selection {
            MemberCallLookup.Selected(function: val function) => function,
            _ => self.arena.functionCount(),
        }
    }
    // Only compatibility observers and immediate diagnostic checking use this.
    fn observedMemberFunction(selection: MemberCallLookup) -> U64 {
        return match selection {
            MemberCallLookup.Selected(function: val function) | MemberCallLookup.DiagnosticCandidate(function: val function) => function,
            MemberCallLookup.NoCandidate | MemberCallLookup.CachedNonStatic => self.arena.functionCount(),
        }
    }
}

impl Comp {
    inout fn lookupAssocForResolvedReceiver(surfaceRef: U64, sourceId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: ArgRange, useOffset: U64) -> Result[MemberCallLookup, CompileDiagnostic] {
        if surfaceRef == 0U64 || surfaceRef >= self.arena.typeCount() {
            return <Result.Ok value=<MemberCallLookup.NoCandidate /> />
        }
        mut val resolvedRef: U64 = surfaceRef
        val original: TypeRef = self.arena.typeAt(index: surfaceRef)
        val underlying: U64 = try self.checkedNominalUnderlying(ref: surfaceRef)
        if underlying != 0U64 && underlying < self.arena.typeCount() {
            resolvedRef = underlying
        }
        val rt: TypeRef = self.arena.typeAt(index: resolvedRef)
        val sources: Array[CallableSourceHead] = (try self.collectViewSources(recv: 0U64, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: surfaceRef, finalSourceId: sourceId, finalSourceOwner: sourceOwner, readReceiverSyntax: false))
        mut val callee: MemberCallLookup = <MemberCallLookup.NoCandidate />
        if sources.count() > 0U64 {
            callee = (try self.findCallableInViewSetWithOrigin(recvStart: rt.nameStart, recvLen: rt.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: true, recvRef: resolvedRef, methodOrigin: <MethodLookupOrigin />))
        }
        if self.memberLookupIsMissing(selection: callee) {
            callee = (try self.findAssocWithOrigin(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: resolvedRef))
        }
        return <Result.Ok value=callee />
    }
}

impl Comp {
    inout fn providedMemberSourceProof(function: Func, proof: StaticConformanceProof) -> Result[StaticConformanceProof, CompileDiagnostic] {
        if !function.isProvided || function.sourceWitnessFuncId == 0U64 || function.sourceWitnessFuncId > self.arena.functionCount() { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        val original = self.arena.functionAt(index: function.sourceWitnessFuncId - 1U64)
        val owner = if original.originTraitOwner != 0U64 { give original.originTraitOwner } else { give original.provTraitOwner }
        if owner == 0U64 || self.decls.traitIndexByOffset(offset: owner) >= self.decls.traitCount() { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        val target = if function.sourceConformIdx != 0U64 { give function.sourceConformIdx } else { give function.originConformIdx }
        return self.memberSourceProofEndpoint(proof: proof, targetConformance: target, traitOwner: owner, subject: original.originTraitOwner == 0U64 && function.sourceConformIdx != 0U64)
    }

    // An authored helper belongs to the subject of its final conferring edge;
    // an authored conformance body belongs to that edge itself. A repeated
    // generic owner/edge is not ambiguous here: only the pinned final position
    // can supply this body's instance. This comparison projection never replaces
    // the full proof retained for signature interpretation or execution.
    inout fn memberSourceProofEndpoint(proof: StaticConformanceProof, targetConformance: U64, traitOwner: U64, subject: Bool) -> Result[StaticConformanceProof, CompileDiagnostic] {
        mut val terminal: WitnessMatch = <WitnessMatch />
        mut val predecessor: WitnessMatch = <WitnessMatch />
        mut val root: StaticConformanceProof = <StaticConformanceProof.Missing />
        match proof {
            StaticConformanceProof.ConcreteWitness(witness: val witness) => { terminal = witness }
            StaticConformanceProof.TraitPath(edges: val edges, terminalConformIdx: val retained) => {
                if edges.count() == 0U64 { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
                terminal = edges[edges.count() - 1U64]
                if terminal.conformIdx != retained { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
                if edges.count() > 1U64 { predecessor = edges[edges.count() - 2U64] }
            }
            StaticConformanceProof.AssumedTraitPath(source: val source, steps: val steps, edges: val edges) => {
                if edges.count() == 0U64 { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
                terminal = edges[edges.count() - 1U64]
                if edges.count() > 1U64 { predecessor = edges[edges.count() - 2U64] }
                root = if steps.count() == 0U64 { give <StaticConformanceProof.AssumedBound source=source /> } else { give <StaticConformanceProof.AssumedSupertraitPath source=source steps=steps /> }
            }
            _ => { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        }
        if targetConformance == 0U64 || terminal.conformIdx != targetConformance || terminal.conformIdx > self.decls.conformCount() { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        val placement = self.decls.conformAt(index: terminal.conformIdx - 1U64)
        if subject && placement.subjectTraitOwner != traitOwner { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        val endpoint = if subject { give predecessor } else { give terminal }
        if endpoint.conformIdx == 0U64 {
            if !subject || self.proofIsMissing(proof: root) { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
            val bound = try self.staticProofBound(proof: root, traitIdx: self.decls.traitIndexByOffset(offset: traitOwner))
            if bound.subject == 0U64 || bound.constraint.key.owner != traitOwner { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
            return <Result.Ok value=root />
        }
        if endpoint.conformIdx > self.decls.conformCount() || self.decls.conformAt(index: endpoint.conformIdx - 1U64).traitStart != traitOwner { return <Result.Ok value=<StaticConformanceProof.Missing /> /> }
        return <Result.Ok value=<StaticConformanceProof.ConcreteWitness witness=endpoint /> />
    }
}
