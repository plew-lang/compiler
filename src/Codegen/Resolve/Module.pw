// Part of name/type resolution (root: _.pw): module-of and visibility
// lookup, plus function / method / associated-item resolution.

// The module id owning the source byte `offset` (spec/15 visibility): the loader
// tags each file's [start,len) span in `bytes` with a module id (a module = a root
// file + its `part` tree; each `import` target a separate one). A declaration's or
// use's module is `moduleOf(its name offset)`. Returns 0 (the entry module) if no
// range matches (e.g. synthetic spans appended after loading).

pub impl Comp {
    inout fn moduleOf(offset: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.modules.ranges.count() {
            val r: Bind = self.modules.ranges[i]
            if offset >= r.nameStart {
                if offset < r.nameStart + r.nameLen {
                    return r.fieldStart
                }
            }
            i += 1
        }
        return 0
    }

    inout fn stmtPrincipalOffset(sid: U64) -> U64 {
        match self.arena.stmts[sid] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { return self.exprOffset(id: init) }
            Stmt.Assign(val target, value: _) => { return self.exprOffset(id: target) }
            Stmt.ExprStmt(val expr) => { return self.exprOffset(id: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => { if hasValue { return self.exprOffset(id: value) } return 0U64 }
            Stmt.If(val cond, thenBlk: _, elseBlk: _, hasElse: _) => { return self.exprOffset(id: cond) }
            Stmt.While(val cond, body: _) => { return self.exprOffset(id: cond) }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, rangeHi: _, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => { return self.exprOffset(id: iter) }
            Stmt.Match(val scrut, arms: _) => { return self.exprOffset(id: scrut) }
            Stmt.Panic(msg: _, val offset) => { return offset }
            Stmt.Give(val value) => { return self.exprOffset(id: value) }
            _ => { return 0U64 }
        }
    }

    inout fn methodInEntryModule(f: Func) -> Bool {
        if f.body == 0U64 {
            return false
        }
        val blk: Block = self.arena.blocks[f.body]
        if blk.stmts.count() == 0U64 {
            return false
        }
        return self.moduleOf(offset: self.stmtPrincipalOffset(sid: blk.stmts[0])) == 0U64
    }

    inout fn isAmbientInLang(start: U64, len: U64) -> Bool {
        val lm: U64 = self.modules.langModule
        if lm == 4000000000U64 { return false }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        // declared in @Std/Lang (its declaration offset falls in the Lang module). The scan
        // looks for a LANG-owned declaration specifically (not the first match), so a user's
        // own `enum Optional` in module 0 does not mask Lang's ownership (→ redefinition gate).
        mut val i: U64 = 0
        while i < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[i]
            if sd.nameId == qId {
                if sd.defOffset != 0U64 {
                    if self.moduleOf(offset: sd.defOffset) == lm { return true }
                }
            }
            i += 1
        }
        i = 0
        while i < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[i]
            if ed.nameId == qId {
                if ed.defOffset != 0U64 {
                    if self.moduleOf(offset: ed.defOffset) == lm { return true }
                }
            }
            i += 1
        }
        // re-exported by @Std/Lang (the primitives — defined in @Std/Core). A re-export
        // records the forwarded name as exported by Lang (`fieldStart` = the Lang module),
        // using the name's span in Lang's own source (so `moduleOf` is reliable).
        i = 0
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports[i]
            if e.fieldStart == lm {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) { return true }
            }
            i += 1
        }
        return false
    }

    inout fn offsetIsLoaded(offset: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.ranges.count() {
            val r: Bind = self.modules.ranges[i]
            if offset >= r.nameStart {
                if offset < r.nameStart + r.nameLen {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn inferLetType(tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64) -> LetEff {
        mut val effStart: U64 = tyStart
        mut val effLen: U64 = tyLen
        mut val effArr: Bool = tyIsArray
        mut val effTy: U64 = ty
        if tyLen == 0 {
            if !(tyIsArray) {
                val ti: TypeInfo = self.exprType(id: init)
                // an array-literal init reports unknown via exprType (literal typing is
                // element-wise/bidirectional in the check passes), so derive `Array[E]`
                // from the first element HERE — the one un-annotated-let inference the
                // scan and record passes share — and `val xs = [10U8, 20U8]` types the
                // local everywhere. An empty literal stays unknown (annotation required).
                if ti.kind == 0 && ti.nameLen == 0 {
                    match self.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            if elems.count() > 0 {
                                val eRef: U64 = self.typedIrRefOfInfo(ti: self.exprType(id: elems[0]))
                                if eRef != 0 {
                                    // name the element by its REGISTERED span (the mangled
                                    // form for a compound element `Box[I64]`/`Ref[Cell]`) —
                                    // the kind-3 convention every consumer keys on. The bare
                                    // head name would alias an ARGLESS generic head and send
                                    // the field grounding into infinite recursion. During
                                    // collection the element AND the `Array[E]` instance are
                                    // registered here, exactly like a written annotation
                                    // (this is what makes the inferred type emittable —
                                    // an ARC-element array with no registered witnesses
                                    // loops at emission); later passes look the entry up.
                                    if self.inCollection {
                                        self.registerArrayElemRef(elemRef: eRef)
                                        self.scanType(ref: self.arrayRefOfElem(elemRef: eRef))
                                    }
                                    val en: Bind = self.arrayElemNameForRef(elemRef: eRef)
                                    // post-collection, a compound element whose mangled span
                                    // never got registered (the collection walk couldn't type
                                    // it) must NOT adopt the bare-head fallback name — leave
                                    // the binding untyped so downstream reports cleanly.
                                    mut val named: Bool = true
                                    if !(self.inCollection) {
                                        if self.isCompoundType(ref: eRef) {
                                            if self.arrayElemRef(start: en.nameStart, len: en.nameLen) == 0U64 {
                                                named = false
                                            }
                                        }
                                    }
                                    if named {
                                        return <LetEff start=en.nameStart len=en.nameLen arr=true ty=self.arrayRefOfElem(elemRef: eRef) />
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                effStart = ti.nameStart
                effLen = ti.nameLen
                // carry the FULL ref (a name-only kind-3 rebuilds its `Array[E]`) so the
                // local's type matches the store convention (locals' ty = the array ref).
                effTy = self.typedIrRefOfInfo(ti: ti)
                if ti.kind == 3 {
                    effArr = true
                }
            }
        }
        return <LetEff start=effStart len=effLen arr=effArr ty=effTy />
    }

    // Does module `useMod` have a direct import edge to `targetMod` (it did
    // `import <path>` resolving to that module)? Drives the coexistence tiebreak.
    inout fn hasImportEdge(useMod: U64, targetMod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.importEdges.count() {
            val e: Bind = self.modules.importEdges[i]
            if e.fieldStart == useMod {
                if e.fieldLen == targetMod {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Is the candidate decl `(candStart,candLen)` (a free fn) visible from module `useMod`
    // (spec/15)? (name, module)-keyed: a cross-module candidate is visible only if the
    // candidate's OWN module exports the name AND `useMod` directly imported that module
    // (an import edge) AND brought this name into scope (a `with { }` import, not a bare
    // namespace import). Pinning the candidate's module is what stops a private same-named
    // decl in one module from being reached via an unrelated module's export of the same
    // text (the import + "exported somewhere" pair alone did not distinguish the source).
    // Does `useMod` import a barrel module that re-exports from `srcMod` (spec/15)? Composes
    // a direct import edge (useMod -> barrel) with a re-export edge (barrel -> srcMod), so a
    // name defined+exported in `srcMod` and forwarded by a barrel the use site imports is
    // reachable without the use site naming the source module directly.
    inout fn importsBarrelForwarding(useMod: U64, srcMod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.reExportEdges.count() {
            val e: Bind = self.modules.reExportEdges[i]
            if e.fieldLen == srcMod {
                if self.hasImportEdge(useMod: useMod, targetMod: e.fieldStart) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn nameVisibleFrom(useMod: U64, candStart: U64, candLen: U64) -> Bool {
        val candMod: U64 = self.moduleOf(offset: candStart)
        if candMod == useMod {
            return true
        }
        // cross-module: the candidate's own module must export the name, and the use site must
        // bring the name into scope with a `with { }` import (not a bare namespace import) that
        // reaches the candidate's module either directly or through a re-exporting barrel.
        if self.isExportedFromModule(mod: candMod, nameStart: candStart, nameLen: candLen) {
            if self.isImportedInto(mod: useMod, nameStart: candStart, nameLen: candLen) {
                if self.hasImportEdge(useMod: useMod, targetMod: candMod) {
                    return true
                }
                if self.importsBarrelForwarding(useMod: useMod, srcMod: candMod) {
                    return true
                }
            }
        }
        return false
    }

    inout fn findFunc(nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        // Among candidates whose labels match, prefer the one whose parameter types
        // match the argument types (type-based overload). Fall back to the first label
        // match when none type-matches (or there is a single candidate). Resolution is
        // SCOPED (spec/15): only candidates visible from the call's module are considered
        // (`nameVisibleFrom` = same module, or imported+exported) — an out-of-scope
        // same-named free fn in another module is not a candidate at all. Same-module
        // candidates are additionally preferred so a module's own private fn wins over an
        // imported one of the same name.
        val useMod: U64 = self.moduleOf(offset: nameStart)
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        mut val firstLabelSame: U64 = self.arena.funcs.count()
        mut val typeMatchSame: U64 = self.arena.funcs.count()
        mut val typeMatch2Same: U64 = self.arena.funcs.count()
        // candidates whose module the use's module DIRECTLY imported — preferred over a
        // merely name-visible one so coexisting versions bind their own export.
        mut val firstLabelEdge: U64 = self.arena.funcs.count()
        mut val typeMatchEdge: U64 = self.arena.funcs.count()
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            // a bare call never resolves to a method (`hasRecv`) or an associated fn
            // (`isAssoc`, e.g. an operator witness `add`): both require `Type.` (or
            // `recv.`) qualification. Skipping them keeps a free fn / local closure
            // named `add` from colliding with Core's `Add.add` (spec/07).
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    if self.paramsLabelsOk(params: f.params, args: args) {
                        val same: Bool = self.moduleOf(offset: f.nameStart) == useMod
                        val visible: Bool = same || self.nameVisibleFrom(useMod: useMod, candStart: f.nameStart, candLen: f.nameLen)
                        val edged: Bool = visible && self.hasImportEdge(useMod: useMod, targetMod: self.moduleOf(offset: f.nameStart))
                        if visible {
                            if firstLabel == self.arena.funcs.count() {
                                firstLabel = i
                            }
                        }
                        if edged {
                            if firstLabelEdge == self.arena.funcs.count() {
                                firstLabelEdge = i
                            }
                        }
                        if same {
                            if firstLabelSame == self.arena.funcs.count() {
                                firstLabelSame = i
                            }
                        }
                        if self.paramsTypesMatch(params: f.params, args: args) {
                            if visible {
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = i
                                } else {
                                    if typeMatch2 == self.arena.funcs.count() {
                                        typeMatch2 = i
                                    }
                                }
                            }
                            if same {
                                if typeMatchSame == self.arena.funcs.count() {
                                    typeMatchSame = i
                                } else {
                                    if typeMatch2Same == self.arena.funcs.count() {
                                        typeMatch2Same = i
                                    }
                                }
                            }
                            if edged {
                                if typeMatchEdge == self.arena.funcs.count() {
                                    typeMatchEdge = i
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        // same-module first
        if typeMatchSame != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatchSame, b: typeMatch2Same, args: args)
            return typeMatchSame
        }
        if firstLabelSame != self.arena.funcs.count() {
            return firstLabelSame
        }
        // then a DIRECTLY-imported module's candidate (prefer the version this module
        // actually imported when a name is shared across coexisting versions).
        if typeMatchEdge != self.arena.funcs.count() {
            return typeMatchEdge
        }
        if firstLabelEdge != self.arena.funcs.count() {
            return firstLabelEdge
        }
        // no same-module candidate: fall back to an in-scope imported one (the general
        // accumulators only recorded `nameVisibleFrom` candidates, so an out-of-scope
        // cross-module fn is never returned — it simply doesn't resolve here).
        if typeMatch != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            return typeMatch
        }
        if firstLabel != self.arena.funcs.count() {
            return firstLabel
        }
        // gen mode (spec/16): the synthesized derive-runner harness calls force-loaded std
        // free fns (`parseItem`/`write`/…) that the gen'd entry file does not `import` —
        // force-load is NOT import, so scoped resolution above found no visible candidate
        // (the harness's call has a re-interned nameStart, `moduleOf` 0, which can't see
        // @Plew/Syntax). The harness is trusted compiler-generated code, so resolve it
        // GLOBALLY here, gen-only (the pre-scoped-resolution behaviour): first label match,
        // type match preferred. Normal compilation never reaches this — it returns
        // "not found" (firstLabel == count) so checkUseVisibility can demand an import.
        if self.genMode {
            mut val gLabel: U64 = self.arena.funcs.count()
            mut val gj: U64 = 0
            while gj < self.arena.funcs.count() {
                val gf: Func = self.arena.funcs[gj]
                if !(gf.hasRecv || gf.isAssoc) {
                    if gf.nameId == qId {
                        if self.paramsLabelsOk(params: gf.params, args: args) {
                            if self.paramsTypesMatch(params: gf.params, args: args) {
                                return gj
                            }
                            if gLabel == self.arena.funcs.count() {
                                gLabel = gj
                            }
                        }
                    }
                }
                gj += 1
            }
            return gLabel
        }
        return firstLabel
    }

    inout fn firstFuncByName(nameStart: U64, nameLen: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            // skip methods and associated fns: a bare name only names a free fn (see
            // findFunc — operator witnesses like `add` are assoc, not free).
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    return i
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    inout fn firstVisibleFuncByName(useMod: U64, nameStart: U64, nameLen: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    if self.nameVisibleFrom(useMod: useMod, candStart: f.nameStart, candLen: f.nameLen) {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    // Does a free fn matching this call's name AND labels exist, but only in module(s) not
    // visible from `useMod`? Drives the use-site diagnostic for the (name, module) rule: when
    // an imported same-named export shadows the name by text, the actual label match may live
    // in another module's PRIVATE surface — `findFunc` correctly returns nothing (it is not a
    // candidate), and this turns that into a clean "not visible here" error instead of an
    // opaque backend failure. Returns false when a visible label match exists (then any
    // remaining mismatch is a normal overload/type error) or when nothing matches the labels
    // (a local / closure / builtin, handled elsewhere).
    inout fn labelMatchOnlyInvisible(useMod: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val foundInvisible: Bool = false
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    if self.paramsLabelsOk(params: f.params, args: args) {
                        if self.nameVisibleFrom(useMod: useMod, candStart: f.nameStart, candLen: f.nameLen) {
                            return false
                        }
                        foundInvisible = true
                    }
                }
            }
            i += 1
        }
        return foundInvisible
    }

    inout fn firstMethodRetType(typeStart: U64, typeLen: U64, name: String) -> TypeInfo {
        val qRecv: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.recvId == qRecv {
                    if rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                        if f.hasRet {
                            return self.typeInfoOfName(start: f.retStart, len: f.retLen, isArray: f.retIsArray)
                        }
                        return scalarInfo()
                    }
                }
            }
            i += 1
        }
        return scalarInfo()
    }

    inout fn isDefaultExt(typeId: U64, extId: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.decls.defaultExts.count() {
            if self.decls.defaultExts[i].typeId == typeId {
                if self.decls.defaultExts[i].extId == extId {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn findMethod(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                // an extension method does not join bare resolution (spec/09): it is
                // reachable only through a `value#Ext.m()` view (findExtMethod) — unless
                // the receiver type declared it as a `defaultExtension`, which admits the
                // extension's methods to the type's bare surface.
                if !(f.extId != 0U64 && !self.isDefaultExt(typeId: qRecvId, extId: f.extId)) {
                // a multi-path inter-trait conformance witness (spec/09) does not join
                // bare resolution — the type does not conform to the target trait bare;
                // it is reachable only through the path view `value#P` (findExtMethodById).
                if !(f.viewOnly) {
                if f.nameId == qNameId {
                    if f.recvId == qRecvId {
                        if self.paramsLabelsOk(params: f.params, args: args) {
                            if firstLabel == self.arena.funcs.count() {
                                firstLabel = i
                            }
                            if self.paramsTypesMatch(params: f.params, args: args) {
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = i
                                } else {
                                    if typeMatch2 == self.arena.funcs.count() {
                                        typeMatch2 = i
                                    }
                                }
                            }
                        }
                    }
                }
                }
                }
            }
            i += 1
        }
        if typeMatch != self.arena.funcs.count() {
            // two provided-method copies from DIFFERENT source traits matching the same
            // bare selector: the bare call is ambiguous (spec/08) — select the source
            // with `a#P.foo()`. (Only this case errors here; ordinary arg-type overloads
            // are disambiguated by the args, and identical-trait copies are the same
            // method.)
            if typeMatch2 != self.arena.funcs.count() {
                if self.arena.funcs[typeMatch].srcTraitId != 0U64 {
                    if self.arena.funcs[typeMatch2].srcTraitId != 0U64 {
                        if self.arena.funcs[typeMatch].srcTraitId != self.arena.funcs[typeMatch2].srcTraitId {
                            compileErrorAt(line: self.lineOf(offset: nameStart), msg: "ambiguous bare call: two conformed traits provide this method; select the source with `a#P.method()`")
                        }
                    }
                }
            }
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            return typeMatch
        }
        if firstLabel != self.arena.funcs.count() {
            return firstLabel
        }
        // no direct method: a trait `via` alias may redirect this requirement name to
        // a real member (spec/08). Retry resolution under the real name.
        mut val ai: U64 = 0
        while ai < self.decls.methodAliases.count() {
            val al: MethodAlias = self.decls.methodAliases[ai]
            if al.recvId == qRecvId {
                if al.aliasId == qNameId {
                    return self.findMethod(recvStart: recvStart, recvLen: recvLen, nameStart: al.realStart, nameLen: al.realLen, args: args)
                }
            }
            ai += 1
        }
        return self.arena.funcs.count()
    }

    inout fn findExtMethod(recvStart: U64, recvLen: U64, srcStart: U64, srcLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        val qSrcId: U64 = intern(c: inout self, start: srcStart, len: srcLen)
        return self.findExtMethodById(recvStart: recvStart, recvLen: recvLen, srcId: qSrcId, nameStart: nameStart, nameLen: nameLen, args: args)
    }

    inout fn extMethodNameExists(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.extId != 0U64 {
                    if f.recvId == qRecvId {
                        if f.nameId == qNameId {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn viewOnlyMethodExists(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.viewOnly {
                    if f.recvId == qRecvId {
                        if f.nameId == qNameId {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn findExtMethodById(recvStart: U64, recvLen: U64, srcId: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qSrcId: U64 = srcId
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.extId == qSrcId || f.srcTraitId == qSrcId {
                    if f.nameId == qNameId {
                        if f.recvId == qRecvId {
                            if self.paramsLabelsOk(params: f.params, args: args) {
                                if firstLabel == self.arena.funcs.count() {
                                    firstLabel = i
                                }
                                if self.paramsTypesMatch(params: f.params, args: args) {
                                    return i
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        return firstLabel
    }

    inout fn findAssoc(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        // a newtype inherits the underlying's assoc fns/factories (spec/10): resolve the
        // receiver name to the underlying so `Brand.checked(…)` finds Rgb's `checked`.
        val rnu: Bind = self.newtypeUnderName(start: recvStart, len: recvLen)
        val qRecvId: U64 = intern(c: inout self, start: rnu.nameStart, len: rnu.nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.isAssoc {
                if f.nameId == qNameId {
                    if f.recvId == qRecvId {
                        if self.paramsLabelsOk(params: f.params, args: args) {
                            if firstLabel == self.arena.funcs.count() {
                                firstLabel = i
                            }
                            if self.paramsTypesMatch(params: f.params, args: args) {
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = i
                                } else {
                                    if typeMatch2 == self.arena.funcs.count() {
                                        typeMatch2 = i
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        if typeMatch != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            return typeMatch
        }
        return firstLabel
    }

    inout fn isTypeName(start: U64, len: U64) -> Bool {
        if self.structIndexByName(start: start, len: len) < self.arena.structs.count() {
            return true
        }
        // an import alias (`with { Real as Alias }`) names the same type as `Real`.
        val ar: Bind = self.aliasReal(start: start, len: len)
        val qId: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        // a newtype name is a type name too (it can be an assoc-fn/factory receiver
        // through its inherited assoc fns — `Brand.gray(…)`, spec/10).
        mut val nti: U64 = 0
        while nti < self.arena.newtypes.count() {
            if self.arena.newtypes[nti].nameId == qId {
                return true
            }
            nti += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            if self.arena.enums[ei].nameId == qId {
                return true
            }
            ei += 1
        }
        // a trait name also qualifies as an assoc-fn receiver: a trait can own
        // provided `assoc fn`s (no Self in their signature), called `Trait.fn(args)`
        // — the single provided impl makes it unambiguous (the derive model's
        // `Hash.derive(input)` rides on this). This is `isTypeName`'s only caller
        // (assocRecvName), so traits qualify only for that routing.
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            if self.decls.traits[ti].nameId == qId {
                return true
            }
            ti += 1
        }
        return self.genericStructIndex(nameStart: ar.nameStart, nameLen: ar.nameLen) < self.arena.structs.count()
    }

    inout fn typeHasAssocFn(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        // a newtype inherits the underlying type's factories/assoc fns (spec/10): resolve
        // to the underlying so `<Brand.checked …/>` finds Rgb's `checked` factory.
        val tnu: Bind = self.newtypeUnderName(start: typeStart, len: typeLen)
        val tId: U64 = intern(c: inout self, start: tnu.nameStart, len: tnu.nameLen)
        val nId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            if self.arena.funcs[i].isAssoc {
                if self.arena.funcs[i].recvId == tId {
                    if self.arena.funcs[i].nameId == nId {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn typeRefHasFromFactory(errRef: U64) -> Bool {
        if errRef >= self.arena.types.count() {
            return false
        }
        val eNameId: U64 = self.arena.types[errRef].nameId
        if eNameId == 0U64 {
            return false
        }
        val fromN: Bind = self.internBytes(s: "from")
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            if self.arena.funcs[i].isAssoc {
                if self.arena.funcs[i].recvId == eNameId {
                    if self.arena.funcs[i].nameId == fromN.nameId {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn typeRefFromFactoryIdx(errRef: U64) -> U64 {
        if errRef >= self.arena.types.count() {
            return self.arena.funcs.count()
        }
        val eNameId: U64 = self.arena.types[errRef].nameId
        if eNameId == 0U64 {
            return self.arena.funcs.count()
        }
        val fromN: Bind = self.internBytes(s: "from")
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            if self.arena.funcs[i].isAssoc {
                if self.arena.funcs[i].recvId == eNameId {
                    if self.arena.funcs[i].nameId == fromN.nameId {
                        return i
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    inout fn resultErrArgRef(ref: U64) -> U64 {
        if ref < self.arena.types.count() {
            if self.arena.types[ref].args.count() >= 2U64 {
                return self.arena.types[ref].args[1]
            }
        }
        return 0U64
    }

    inout fn rewriteAssocValReads() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Field(val base, val nameStart, val nameLen) => {
                    match self.arena.exprs[base] {
                        Expr.Ident(start: val tStart, len: val tLen) => {
                            if self.isTypeName(start: tStart, len: tLen) {
                                if self.typeHasAssocFn(typeStart: tStart, typeLen: tLen, nameStart: nameStart, nameLen: nameLen) {
                                    val noArgs: Array[Arg] = []
                                    self.arena.exprs[i] = <Expr.Method recv=base nameStart=nameStart nameLen=nameLen args=noArgs />
                                }
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            i += 1
        }
    }
}
