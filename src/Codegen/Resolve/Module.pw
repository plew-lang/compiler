// Part of name/type resolution (root: _.pw): module-of and visibility
// lookup, plus function / method / associated-item resolution.

// The module id owning the source byte `offset` (spec/15 visibility): the loader
// tags each file's [start,len) span in `bytes` with a module id (a module = a root
// file + its `part` tree; each `import` target a separate one). A declaration's or
// use's module is `moduleOf(its name offset)`. Returns 0 (the entry module) if no
// range matches (e.g. synthetic spans appended after loading).

pub impl Comp {
    inout fn moduleOf(offset: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.modules.ranges.count() {
            val r: Bind = self.modules.ranges[i]
            if offset >= r.nameStart {
                if offset < r.nameStart + r.nameLen {
                    return r.fieldStart
                }
            }
            i += 1
        }
        return 0
    }

    inout fn stmtPrincipalOffset(sid: U64) -> U64 {
        match self.arena.stmts[sid] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { return self.exprOffset(id: init) }
            Stmt.Assign(val target, value: _) => { return self.exprOffset(id: target) }
            Stmt.ExprStmt(val expr) => { return self.exprOffset(id: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => { if hasValue { return self.exprOffset(id: value) } return 0U64 }
            Stmt.If(val cond, thenBlk: _, elseBlk: _, hasElse: _) => { return self.exprOffset(id: cond) }
            Stmt.While(val cond, body: _) => { return self.exprOffset(id: cond) }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, rangeHi: _, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => { return self.exprOffset(id: iter) }
            Stmt.Match(val scrut, arms: _) => { return self.exprOffset(id: scrut) }
            Stmt.Panic(msg: _, val offset) => { return offset }
            Stmt.Give(val value) => { return self.exprOffset(id: value) }
            _ => { return 0U64 }
        }
    }

    inout fn methodInEntryModule(f: Func) -> Bool {
        if f.body == 0U64 {
            return false
        }
        val blk: Block = self.arena.blocks[f.body]
        if blk.stmts.count() == 0U64 {
            return false
        }
        return self.moduleOf(offset: self.stmtPrincipalOffset(sid: blk.stmts[0])) == 0U64
    }

    inout fn isAmbientInLang(start: U64, len: U64) -> Bool {
        val lm: U64 = self.modules.langModule
        if lm == 4000000000U64 { return false }
        val qId: U64 = intern(c: inout self, start: start, len: len)
        // declared in @Std/Lang (its declaration offset falls in the Lang module). The scan
        // looks for a LANG-owned declaration specifically (not the first match), so a user's
        // own `enum Optional` in module 0 does not mask Lang's ownership (→ redefinition gate).
        mut val i: U64 = 0
        while i < self.arena.structs.count() {
            val sd: StructDef = self.arena.structs[i]
            if sd.nameId == qId {
                if sd.defOffset != 0U64 {
                    if self.moduleOf(offset: sd.defOffset) == lm { return true }
                }
            }
            i += 1
        }
        i = 0
        while i < self.arena.enums.count() {
            val ed: EnumDef = self.arena.enums[i]
            if ed.nameId == qId {
                if ed.defOffset != 0U64 {
                    if self.moduleOf(offset: ed.defOffset) == lm { return true }
                }
            }
            i += 1
        }
        // re-exported by @Std/Lang (the primitives — defined in @Std/Core). A re-export
        // records the forwarded name as exported by Lang (`fieldStart` = the Lang module),
        // using the name's span in Lang's own source (so `moduleOf` is reliable).
        i = 0
        while i < self.modules.exports.count() {
            val e: Bind = self.modules.exports[i]
            if e.fieldStart == lm {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) { return true }
            }
            i += 1
        }
        return false
    }

    inout fn offsetIsLoaded(offset: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.ranges.count() {
            val r: Bind = self.modules.ranges[i]
            if offset >= r.nameStart {
                if offset < r.nameStart + r.nameLen {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn inferLetType(tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64) -> LetEff {
        mut val effStart: U64 = tyStart
        mut val effLen: U64 = tyLen
        mut val effArr: Bool = tyIsArray
        mut val effTy: U64 = ty
        if tyLen == 0 {
            if !(tyIsArray) {
                // A selected call has an instance-owned result in
                // CallResolution. `exprType` is the shared
                // declaration-template projection, so using it alone would
                // bind `val pair = box#E.duplicate()` as `(first: T,
                // second: T)` after Mono had already proved its concrete
                // result. Local inference is the first consumer that gives
                // the result a stable body binding; it must read the same
                // semantic fact as later field selection and LLVM. Other
                // expressions retain the ordinary projection, including
                // uncontextualized literals.
                mut val ti: TypeInfo = self.exprType(id: init)
                mut val resolved: U64 = 0U64
                match self.arena.exprs[init] {
                    Expr.Call(nameStart: _, nameLen: _, args: _) => { resolved = self.bodyCalleeResultRef(exprId: init) }
                    Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { resolved = self.bodyCalleeResultRef(exprId: init) }
                    Expr.ExtMethod(recv: _, source: _, nameStart: _, nameLen: _, args: _) => { resolved = self.bodyCalleeResultRef(exprId: init) }
                    _ => {}
                }
                if resolved != 0U64 && resolved < self.arena.types.count() {
                    ti = self.typeInfoOfRef(ref: resolved)
                }
                // an array-literal init reports unknown via exprType (literal typing is
                // element-wise/bidirectional in the check passes), so derive `Array[E]`
                // from the first element HERE — the one un-annotated-let inference the
                // scan and record passes share — and `val xs = [10U8, 20U8]` types the
                // local everywhere. An empty literal stays unknown (annotation required).
                if ti.kind == 0 && ti.nameLen == 0 {
                    match self.arena.exprs[init] {
                        Expr.Array(val elems) => {
                            if elems.count() > 0 {
                                mut val eRef: U64 = self.typedIrRefOfInfo(ti: self.exprType(id: elems[0]))
                                // an ARGLESS generic head (`<Optional.Some v=1 />` with no
                                // inferable instance reports its bare head name) must not be
                                // registered or named as the element: it aliases the generic
                                // TEMPLATE and sends the field grounding into infinite
                                // recursion. Leave the binding untyped — the element's own
                                // construction then reports cleanly downstream.
                                if eRef != 0 {
                                    if self.arena.types[eRef].args.count() == 0U64 {
                                        val eh: TypeRef = self.arena.types[eRef]
                                        if self.genericStructIndex(nameStart: eh.nameStart, nameLen: eh.nameLen) < self.arena.structs.count() {
                                            eRef = 0
                                        } else if self.genericEnumIndex(nameStart: eh.nameStart, nameLen: eh.nameLen) < self.arena.enums.count() {
                                            eRef = 0
                                        }
                                    }
                                }
                                if eRef != 0 {
                                    // name the element by its REGISTERED span (the mangled
                                    // form for a compound element `Box[I64]`/`Ref[Cell]`) —
                                    // the kind-3 convention every consumer keys on. The bare
                                    // head name would alias an ARGLESS generic head and send
                                    // the field grounding into infinite recursion. During
                                    // collection the element AND the `Array[E]` instance are
                                    // registered here, exactly like a written annotation
                                    // (this is what makes the inferred type emittable —
                                    // an ARC-element array with no registered witnesses
                                    // loops at emission); later passes look the entry up.
                                    if self.inCollection {
                                        self.registerArrayElemRef(elemRef: eRef)
                                        self.scanType(ref: self.arrayRefOfElem(elemRef: eRef))
                                    }
                                    val en: Bind = self.arrayElemNameForRef(elemRef: eRef)
                                    // post-collection, a compound element whose mangled span
                                    // never got registered (the collection walk couldn't type
                                    // it) must NOT adopt the bare-head fallback name — leave
                                    // the binding untyped so downstream reports cleanly.
                                    mut val named: Bool = true
                                    if !(self.inCollection) {
                                        if self.isCompoundType(ref: eRef) {
                                            if self.arrayElemRef(start: en.nameStart, len: en.nameLen) == 0U64 {
                                                named = false
                                            }
                                        }
                                    }
                                    if named {
                                        return <LetEff start=en.nameStart len=en.nameLen arr=true ty=self.arrayRefOfElem(elemRef: eRef) />
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                effStart = ti.nameStart
                effLen = ti.nameLen
                // carry the FULL ref (a name-only kind-3 rebuilds its `Array[E]`) so the
                // local's type matches the store convention (locals' ty = the array ref).
                effTy = self.typedIrRefOfInfo(ti: ti)
                if ti.kind == 3 {
                    effArr = true
                }
            }
        }
        return <LetEff start=effStart len=effLen arr=effArr ty=effTy />
    }

    // Does module `useMod` have a direct import edge to `targetMod` (it did
    // `import <path>` resolving to that module)? Drives the coexistence tiebreak.
    inout fn hasImportEdge(useMod: U64, targetMod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.importEdges.count() {
            val e: Bind = self.modules.importEdges[i]
            if e.fieldStart == useMod {
                if e.fieldLen == targetMod {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Is the candidate decl `(candStart,candLen)` (a free fn) visible from module `useMod`
    // (spec/15)? (name, module)-keyed: a cross-module candidate is visible only if the
    // candidate's OWN module exports the name AND `useMod` directly imported that module
    // (an import edge) AND brought this name into scope (a `with { }` import, not a bare
    // namespace import). Pinning the candidate's module is what stops a private same-named
    // decl in one module from being reached via an unrelated module's export of the same
    // text (the import + "exported somewhere" pair alone did not distinguish the source).
    // Does `useMod` import a barrel module that re-exports from `srcMod` (spec/15)? Composes
    // a direct import edge (useMod -> barrel) with a re-export edge (barrel -> srcMod), so a
    // name defined+exported in `srcMod` and forwarded by a barrel the use site imports is
    // reachable without the use site naming the source module directly.
    inout fn importsBarrelForwarding(useMod: U64, srcMod: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.modules.reExportEdges.count() {
            val e: Bind = self.modules.reExportEdges[i]
            if e.fieldLen == srcMod {
                if self.hasImportEdge(useMod: useMod, targetMod: e.fieldStart) {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    inout fn nameVisibleFrom(useMod: U64, candStart: U64, candLen: U64) -> Bool {
        val candMod: U64 = self.moduleOf(offset: candStart)
        if candMod == useMod {
            return true
        }
        // cross-module: the candidate's own module must export the name, and the use site must
        // bring the name into scope with a `with { }` import (not a bare namespace import) that
        // reaches the candidate's module either directly or through a re-exporting barrel.
        if self.isExportedFromModule(mod: candMod, nameStart: candStart, nameLen: candLen) {
            if self.isImportedInto(mod: useMod, nameStart: candStart, nameLen: candLen) {
                if self.hasImportEdge(useMod: useMod, targetMod: candMod) {
                    return true
                }
                if self.importsBarrelForwarding(useMod: useMod, srcMod: candMod) {
                    return true
                }
            }
        }
        return false
    }

    inout fn findFunc(nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        // Among candidates whose labels match, prefer the one whose parameter types
        // match the argument types (type-based overload). Fall back to the first label
        // match when none type-matches (or there is a single candidate). Resolution is
        // SCOPED (spec/15): only candidates visible from the call's module are considered
        // (`nameVisibleFrom` = same module, or imported+exported) — an out-of-scope
        // same-named free fn in another module is not a candidate at all. Same-module
        // candidates are additionally preferred so a module's own private fn wins over an
        // imported one of the same name.
        val useMod: U64 = self.moduleOf(offset: nameStart)
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        mut val firstLabelSame: U64 = self.arena.funcs.count()
        mut val typeMatchSame: U64 = self.arena.funcs.count()
        mut val typeMatch2Same: U64 = self.arena.funcs.count()
        // candidates whose module the use's module DIRECTLY imported — preferred over a
        // merely name-visible one so coexisting versions bind their own export.
        mut val firstLabelEdge: U64 = self.arena.funcs.count()
        mut val typeMatchEdge: U64 = self.arena.funcs.count()
        mut val typeMatch2Edge: U64 = self.arena.funcs.count()
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            // a bare call never resolves to a method (`hasRecv`) or an associated fn
            // (`isAssoc`, e.g. an operator witness `add`): both require `Type.` (or
            // `recv.`) qualification. Skipping them keeps a free fn / local closure
            // named `add` from colliding with Core's `Add.add` (spec/07).
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    val matchRank: U64 = self.callableArgMatchRank(f: f, args: args)
                    if matchRank != 0U64 {
                        val same: Bool = cand.sourceModule == useMod
                        val visible: Bool = same || self.nameVisibleFrom(useMod: useMod, candStart: f.nameStart, candLen: f.nameLen)
                        val edged: Bool = visible && self.hasImportEdge(useMod: useMod, targetMod: cand.sourceModule)
                        if visible {
                            if firstLabel == self.arena.funcs.count() {
                                firstLabel = cand.funcIdx
                            }
                        }
                        if edged {
                            if firstLabelEdge == self.arena.funcs.count() {
                                firstLabelEdge = cand.funcIdx
                            }
                        }
                        if same {
                            if firstLabelSame == self.arena.funcs.count() {
                                firstLabelSame = cand.funcIdx
                            }
                        }
                        if matchRank == 2U64 {
                            if visible {
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = cand.funcIdx
                                } else {
                                    if typeMatch2 == self.arena.funcs.count() {
                                        typeMatch2 = cand.funcIdx
                                    }
                                }
                            }
                            if same {
                                if typeMatchSame == self.arena.funcs.count() {
                                    typeMatchSame = cand.funcIdx
                                } else {
                                    if typeMatch2Same == self.arena.funcs.count() {
                                        typeMatch2Same = cand.funcIdx
                                    }
                                }
                            }
                            if edged {
                                if typeMatchEdge == self.arena.funcs.count() {
                                    typeMatchEdge = cand.funcIdx
                                } else {
                                    if typeMatch2Edge == self.arena.funcs.count() {
                                        typeMatch2Edge = cand.funcIdx
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        // same-module first
        if typeMatchSame != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatchSame, b: typeMatch2Same, args: args)
            return typeMatchSame
        }
        if firstLabelSame != self.arena.funcs.count() {
            return firstLabelSame
        }
        // then a DIRECTLY-imported module's candidate (prefer the version this module
        // actually imported when a name is shared across coexisting versions).
        if typeMatchEdge != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatchEdge, b: typeMatch2Edge, args: args)
            return typeMatchEdge
        }
        if firstLabelEdge != self.arena.funcs.count() {
            return firstLabelEdge
        }
        // no same-module candidate: fall back to an in-scope imported one (the general
        // accumulators only recorded `nameVisibleFrom` candidates, so an out-of-scope
        // cross-module fn is never returned — it simply doesn't resolve here).
        if typeMatch != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            return typeMatch
        }
        if firstLabel != self.arena.funcs.count() {
            return firstLabel
        }
        // gen mode (spec/16): the synthesized derive-runner harness calls force-loaded std
        // free fns (`parseItem`/`write`/…) that the gen'd entry file does not `import` —
        // force-load is NOT import, so scoped resolution above found no visible candidate
        // (the harness's call has a re-interned nameStart, `moduleOf` 0, which can't see
        // @Plew/Syntax). The harness is trusted compiler-generated code, so resolve it
        // GLOBALLY here, gen-only (the pre-scoped-resolution behaviour): first label match,
        // type match preferred. Normal compilation never reaches this — it returns
        // "not found" (firstLabel == count) so checkUseVisibility can demand an import.
        if self.genMode {
            mut val gLabel: U64 = self.arena.funcs.count()
            mut val gj: U64 = 0
            while gj < self.decls.callables.count() {
                val gc: Callable = self.decls.callables[gj]
                val gf: Func = self.arena.funcs[gc.funcIdx]
                if !(gf.hasRecv || gf.isAssoc) {
                    if gf.nameId == qId {
                        val matchRank: U64 = self.callableArgMatchRank(f: gf, args: args)
                        if matchRank != 0U64 {
                            if matchRank == 2U64 {
                                return gc.funcIdx
                            }
                            if gLabel == self.arena.funcs.count() {
                                gLabel = gc.funcIdx
                            }
                        }
                    }
                }
                gj += 1
            }
            return gLabel
        }
        return firstLabel
    }

    inout fn firstFuncByName(nameStart: U64, nameLen: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            // skip methods and associated fns: a bare name only names a free fn (see
            // findFunc — operator witnesses like `add` are assoc, not free).
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    return cand.funcIdx
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    inout fn firstVisibleFuncByName(useMod: U64, nameStart: U64, nameLen: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    if self.nameVisibleFrom(useMod: useMod, candStart: f.nameStart, candLen: f.nameLen) {
                        return cand.funcIdx
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    // Does a free fn matching this call's name AND labels exist, but only in module(s) not
    // visible from `useMod`? Drives the use-site diagnostic for the (name, module) rule: when
    // an imported same-named export shadows the name by text, the actual label match may live
    // in another module's PRIVATE surface — `findFunc` correctly returns nothing (it is not a
    // candidate), and this turns that into a clean "not visible here" error instead of an
    // opaque backend failure. Returns false when a visible label match exists (then any
    // remaining mismatch is a normal overload/type error) or when nothing matches the labels
    // (a local / closure / builtin, handled elsewhere).
    inout fn labelMatchOnlyInvisible(useMod: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
        val qId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val foundInvisible: Bool = false
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if !(f.hasRecv || f.isAssoc) {
                if f.nameId == qId {
                    if self.paramsLabelsOk(params: f.params, args: args) {
                        if self.nameVisibleFrom(useMod: useMod, candStart: f.nameStart, candLen: f.nameLen) {
                            return false
                        }
                        foundInvisible = true
                    }
                }
            }
            i += 1
        }
        return foundInvisible
    }

    inout fn firstMethodRetType(typeStart: U64, typeLen: U64, name: String) -> TypeInfo {
        val qRecv: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.hasRecv {
                if f.recvId == qRecv {
                    if rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                        if f.hasRet {
                            return self.typeInfoOfName(start: f.retStart, len: f.retLen, isArray: f.retIsArray)
                        }
                        return scalarInfo()
                    }
                }
            }
            i += 1
        }
        return scalarInfo()
    }

    // `nameStart` identifies the selector spelling, but lowering may intern a
    // selector for a synthetic call (`[]` -> `index`).  Visibility belongs to
    // the source call-site, not that interned helper span, so callers can pass
    // the real AST offset explicitly.
    inout fn findMethod(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg], recvRef: U64 = 0U64, useOffset: U64 = 0U64) -> U64 {
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        mut val typeMatchEntry: U64 = self.decls.callables.count()
        mut val typeMatch2Entry: U64 = self.decls.callables.count()
        mut val inherentMatch: U64 = self.arena.funcs.count()
        mut val inherentMatch2: U64 = self.arena.funcs.count()
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.hasRecv {
                // an extension method does not join bare resolution (spec/09): it is
                // reachable only through a `value#Ext.m()` view (findExtMethod).
                if cand.sourceKind != 1U64 {
                // a multi-path inter-trait conformance witness (spec/09) does not join
                // bare resolution — the type does not conform to the target trait bare;
                // it is reachable only through the path view `value#P` (findExtMethodById).
                if !(f.viewOnly) {
                if f.nameId == qNameId {
                    if self.callableReceiverMatches(f: f, recvId: qRecvId, recvRef: recvRef) {
                        val matchRank: U64 = self.groundedMethodArgMatchRank(f: f, args: args, recvRef: recvRef)
                        if matchRank != 0U64 {
                            if firstLabel == self.arena.funcs.count() {
                                firstLabel = cand.funcIdx
                            }
                            if matchRank == 2U64 {
                                if cand.sourceKind == 0U64 {
                                    if inherentMatch == self.arena.funcs.count() {
                                        inherentMatch = cand.funcIdx
                                    } else if inherentMatch2 == self.arena.funcs.count() {
                                        inherentMatch2 = cand.funcIdx
                                    }
                                }
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = cand.funcIdx
                                    typeMatchEntry = i
                                } else {
                                    if typeMatch2 == self.arena.funcs.count() {
                                        typeMatch2 = cand.funcIdx
                                        typeMatch2Entry = i
                                    }
                                }
                            }
                        }
                    }
                }
                }
                }
            }
            i += 1
        }
        // Inherent methods are the bare default over trait-provided methods with
        // the same selector.  The provided copy remains registered so `#Trait`
        // can select it; only bare lookup gives the inherent surface priority.
        if inherentMatch != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: inherentMatch, b: inherentMatch2, args: args)
            return inherentMatch
        }
        if typeMatch != self.arena.funcs.count() {
            // two provided-method copies from DIFFERENT source traits matching the same
            // bare selector: the bare call is ambiguous (spec/08) — select the source
            // with `a#P.foo()`. (Only this case errors here; ordinary arg-type overloads
            // are disambiguated by the args, and identical-trait copies are the same
            // method.)
            if typeMatch2 != self.arena.funcs.count() {
                if typeMatchEntry < self.decls.callables.count() && typeMatch2Entry < self.decls.callables.count() {
                    if self.decls.callables[typeMatchEntry].sourceKind == 2U64 && self.decls.callables[typeMatch2Entry].sourceKind == 2U64 {
                        if !(self.sameCallableSemanticOrigin(a: self.decls.callables[typeMatchEntry], b: self.decls.callables[typeMatch2Entry])) {
                            self.errorAt(offset: nameStart, msg: "ambiguous bare call: two conformed traits provide this method; select the source with `a#P.method()`")
                        }
                    }
                }
            }
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            return typeMatch
        }
        if firstLabel != self.arena.funcs.count() {
            return firstLabel
        }
        // no direct method: a trait `via` alias may redirect this requirement name to
        // a real member (spec/08). Retry resolution under the real name.
        mut val ai: U64 = 0
        while ai < self.decls.methodAliases.count() {
            val al: MethodAlias = self.decls.methodAliases[ai]
            if al.recvId == qRecvId {
                if al.aliasId == qNameId {
                    return self.findMethod(recvStart: recvStart, recvLen: recvLen, nameStart: al.realStart, nameLen: al.realLen, args: args, recvRef: recvRef)
                }
            }
            ai += 1
        }
        return self.arena.funcs.count()
    }

    inout fn findExtMethod(recvStart: U64, recvLen: U64, srcStart: U64, srcLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg], recvRef: U64 = 0U64) -> U64 {
        val qSrcId: U64 = intern(c: inout self, start: srcStart, len: srcLen)
        return self.findExtMethodById(recvStart: recvStart, recvLen: recvLen, srcId: qSrcId, sourceOwner: srcStart, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef)
    }

    // Resolve a written `#Name` to one semantic source key before method
    // lookup. The spelling is only an input to this conversion: candidates
    // thereafter compare kind + declaration/bundle owner + arity.
    inout fn resolveViewSourceKey(recvStart: U64, recvLen: U64, recvRef: U64, sourceId: U64, sourceOwner: U64 = 0U64) -> ViewSource {
        mut val found: ViewSource = <ViewSource />
        val entry: InternedSpan = self.interner.entries[sourceId - 1U64]
        if self.extAppliesToType(extStart: entry.start, extLen: entry.len, typeStart: recvStart, typeLen: recvLen, typeRef: recvRef) {
            found = <ViewSource kind=1U64 id=sourceId owner=sourceId arity=0U64 />
        }
        // A trait selector is resolved while lowering at its lexical use site.
        // Never reconstruct an absent owner from its spelling here: doing so lets
        // `#P` select an unimported, same-named trait from another module.
        // Extension bundles intentionally remain name-keyed above.
        val traitOwner: U64 = sourceOwner
        if self.traceCodegen {
            eprint(text: "[trace-codegen] view-source trait query\n")
        }
        val recvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0U64
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if traitOwner != 0U64 && cf.extId == 0U64 && cf.typeId == recvId && cf.traitStart == traitOwner {
                if self.traceCodegen {
                    eprint(text: "[trace-codegen] view-source matching conformance key\n")
                }
                if self.conformanceSubjectMatches(cf: cf, typeRef: recvRef) {
                    if self.traceCodegen {
                        eprint(text: "[trace-codegen] view-source subject matches\n")
                    }
                    val key: ViewSource = <ViewSource kind=2U64 id=sourceId owner=cf.traitStart arity=cf.traitArgs.count() />
                    if found.kind == 0U64 {
                        found = key
                    } else if !(self.sameViewSource(a: found, b: key)) {
                        return <ViewSource />
                    }
                }
            }
            i += 1U64
        }
        return found
    }

    inout fn appendViewSource(sources: inout Array[ViewSource], source: ViewSource) {
        if source.kind == 0U64 { return }
        mut val i: U64 = 0U64
        while i < sources.count() {
            if self.sameViewSource(a: sources[i], b: source) { return }
            i += 1U64
        }
        sources.append(source)
    }

    // Collect active view conditions without making their textual order semantic.
    // `value#E#A` and `value#A#E` therefore carry the same extension source E
    // and trait selector A. A strip ends the inherited chain but not the call's
    // own trailing source.
    inout fn collectViewSources(recv: U64, recvStart: U64, recvLen: U64, recvRef: U64, finalSourceId: U64 = 0U64, finalSourceOwner: U64 = 0U64) -> Array[ViewSource] {
        mut val sources: Array[ViewSource] = []
        // A TypeRef caches the source selectors already written on this
        // expression. Keep those AST selectors distinct from inherited local
        // type views, so the cache never re-resolves one written selector with
        // weaker provenance and turns it into another same-named owner.
        mut val writtenIds: Array[U64] = []
        if finalSourceId != 0U64 {
            self.appendViewSource(sources: inout sources, source: self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: finalSourceId, sourceOwner: finalSourceOwner))
            writtenIds.append(finalSourceId)
        }
        mut val cur: U64 = recv
        mut val go: Bool = true
        mut val stripped: Bool = false
        while go {
            match self.arena.exprs[cur] {
                Expr.ExtView(recv: val base, source: val selector, strip: val strip) => {
                    if strip {
                        stripped = true
                        go = false
                    } else {
                        val selectorId: U64 = selector.surfaceId
                        // The outer `#Source` of an ExtMethod is passed as
                        // finalSourceId and is also this AST node. Normalize
                        // that selector exactly once with its authored
                        // provenance: resolving it again from only its
                        // spelling can select a different same-named trait
                        // owner and manufacture an ambiguity.
                        if selectorId != finalSourceId {
                            self.appendViewSource(sources: inout sources, source: self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: selectorId, sourceOwner: selector.traitOwner))
                        }
                        mut val written: Bool = false
                        mut val wi: U64 = 0U64
                        while wi < writtenIds.count() {
                            if writtenIds[wi] == selectorId { written = true }
                            wi += 1U64
                        }
                        if !written { writtenIds.append(selectorId) }
                        cur = base
                    }
                }
                _ => { go = false }
            }
        }
        // During verification of an extension template, `self` has not yet
        // been materialized as a view-bearing TypeRef (that happens again for
        // each backend instance). Its source is nevertheless lexical and must
        // join the same source set as an explicit `self#Ext`.
        if !stripped {
            match self.arena.exprs[cur] {
                Expr.Ident(start: val selfStart, len: val selfLen) => {
                    if self.isSelfRef(start: selfStart, len: selfLen) && self.cur.extId != 0U64 {
                        self.appendViewSource(sources: inout sources, source: self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: self.cur.extId))
                    }
                }
                _ => {}
            }
        }
        if !stripped && recvRef != 0U64 && recvRef < self.arena.types.count() {
            val staticSources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: recvRef)
            mut val si: U64 = 0U64
            while si < staticSources.count() {
                mut val written: Bool = false
                mut val wi: U64 = 0U64
                while wi < writtenIds.count() {
                    if writtenIds[wi] == staticSources[si].surfaceId { written = true }
                    wi += 1U64
                }
                if !written {
                    self.appendViewSource(sources: inout sources, source: self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: staticSources[si].surfaceId, sourceOwner: staticSources[si].traitOwner))
                }
                si += 1U64
            }
        }
        return sources
    }

    // The semantic query for a method call whose receiver has already been
    // grounded by a BodyInstance.  Candidate search, newtype normalization and
    // view-source normalization belong to the frontend resolver; Mono supplies
    // only the concrete receiver term it obtained from its environment.
    inout fn resolveMethodForResolvedReceiver(recv: U64, surfaceRef: U64, sourceId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: Array[Arg], useOffset: U64) -> U64 {
        if surfaceRef == 0U64 || surfaceRef >= self.arena.types.count() {
            return self.arena.funcs.count()
        }
        // A newtype is a distinct source type but inherits the underlying
        // callable surface and representation. Normalize inside the semantic
        // query so every caller applies the same rule.
        mut val resolvedRef: U64 = surfaceRef
        val original: TypeRef = self.arena.types[surfaceRef]
        val underlying: U64 = self.newtypeUnderRef(start: original.nameStart, len: original.nameLen)
        if underlying != 0U64 && underlying < self.arena.types.count() {
            resolvedRef = underlying
        }
        val rt: TypeRef = self.arena.types[resolvedRef]
        val sources: Array[ViewSource] = self.collectViewSources(recv: recv, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: surfaceRef, finalSourceId: sourceId, finalSourceOwner: sourceOwner)
        mut val callee: U64 = self.arena.funcs.count()
        if sources.count() > 0U64 {
            callee = self.findMethodInViewSet(recvStart: rt.nameStart, recvLen: rt.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: resolvedRef)
        }
        if callee >= self.arena.funcs.count() {
            callee = self.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: resolvedRef, useOffset: useOffset)
        }
        return callee
    }

    inout fn viewSetHasTrait(sources: Array[ViewSource]) -> Bool {
        mut val i: U64 = 0U64
        while i < sources.count() {
            if sources[i].kind == 2U64 { return true }
            i += 1U64
        }
        return false
    }

    inout fn callableMatchesAnyExtension(c: Callable, sources: Array[ViewSource]) -> Bool {
        if c.sourceKind != 1U64 { return false }
        mut val i: U64 = 0U64
        while i < sources.count() {
            if sources[i].kind == 1U64 && self.callableMatchesSource(c: c, source: sources[i]) { return true }
            i += 1U64
        }
        return false
    }

    inout fn callableMatchesAnyTrait(c: Callable, sources: Array[ViewSource]) -> Bool {
        mut val i: U64 = 0U64
        while i < sources.count() {
            if sources[i].kind == 2U64 && self.callableMatchesTrait(c: c, source: sources[i]) { return true }
            i += 1U64
        }
        return false
    }

    // Resolve one final callable from an unordered set of active views. An
    // extension source shadows the bare surface; a trait source narrows the
    // extension candidates (or, if none exist, the bare trait candidates).
    // `associated` is deliberately a resolver dimension, rather than a
    // separate lookup implementation.  `Type#E.make()` and `value#E.make()`
    // differ only in the receiver surface they address; their active source
    // set, provenance narrowing, overload ranking, and ambiguity rule are
    // identical.
    inout fn findCallableInViewSet(recvStart: U64, recvLen: U64, sources: Array[ViewSource], nameStart: U64, nameLen: U64, args: Array[Arg], associated: Bool, recvRef: U64 = 0U64) -> U64 {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val useMod: U64 = self.moduleOf(offset: nameStart)
        val hasTrait: Bool = self.viewSetHasTrait(sources: sources)
        mut val pass: U64 = 0U64
        while pass < 2U64 {
            mut val firstLabel: U64 = self.arena.funcs.count()
            mut val typeMatch: U64 = self.arena.funcs.count()
            mut val typeMatch2: U64 = self.arena.funcs.count()
            mut val typeMatchEntry: U64 = self.decls.callables.count()
            mut val typeMatch2Entry: U64 = self.decls.callables.count()
            mut val i: U64 = 0U64
            while i < self.decls.callables.count() {
                val cand: Callable = self.decls.callables[i]
                val f: Func = self.arena.funcs[cand.funcIdx]
                mut val sourceMatches: Bool = false
                if pass == 0U64 {
                    sourceMatches = self.callableMatchesAnyExtension(c: cand, sources: sources)
                    // Direct extension members have no trait provenance and
                    // remain visible under an additional `#Trait`. Extension
                    // copies contributed through a trait subject, however,
                    // are narrowed by that one selected trait.
                    if sourceMatches && hasTrait && cand.traitId != 0U64 {
                        sourceMatches = self.callableMatchesAnyTrait(c: cand, sources: sources)
                    }
                } else {
                    sourceMatches = cand.sourceKind == 2U64 && self.callableMatchesAnyTrait(c: cand, sources: sources)
                }
                // A trait requirement has no executable body. It participates
                // in declaration-time static member resolution, but never in
                // this concrete callable surface; otherwise a trait receiver
                // proof makes the requirement compete with its implementation.
                if sourceMatches && (f.body != 0U64 || f.isExtern) && ((associated && f.isAssoc) || (!associated && f.hasRecv)) {
                    if f.nameId == qNameId && self.callableReceiverMatches(f: f, recvId: qRecvId, recvRef: recvRef) {
                        val matchRank: U64 = self.groundedMethodArgMatchRank(f: f, args: args, recvRef: recvRef)
                        if matchRank != 0U64 {
                            if firstLabel == self.arena.funcs.count() { firstLabel = cand.funcIdx }
                            if matchRank == 2U64 {
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = cand.funcIdx
                                    typeMatchEntry = i
                                } else if typeMatch2 == self.arena.funcs.count() {
                                    typeMatch2 = cand.funcIdx
                                    typeMatch2Entry = i
                                }
                            }
                        }
                    }
                }
                i += 1U64
            }
            if typeMatch != self.arena.funcs.count() {
                self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
                if typeMatch2 != self.arena.funcs.count() {
                    if typeMatchEntry < self.decls.callables.count() && typeMatch2Entry < self.decls.callables.count() {
                        if !(self.sameCallableSemanticOrigin(a: self.decls.callables[typeMatchEntry], b: self.decls.callables[typeMatch2Entry])) {
                            self.errorAt(offset: nameStart, msg: "ambiguous source-qualified call: active views provide multiple matching methods")
                        }
                        // A direct conformance and a single trait-to-trait
                        // propagation can materialize the same selected source
                        // twice. It is one semantic callable surface, not an
                        // ambiguity the caller can observe.
                        return typeMatch
                    }
                    self.errorAt(offset: nameStart, msg: "ambiguous source-qualified call: this source provides more than one matching method")
                }
                return typeMatch
            }
            if firstLabel != self.arena.funcs.count() { return firstLabel }
            pass += 1U64
        }
        return self.arena.funcs.count()
    }

    inout fn findMethodInViewSet(recvStart: U64, recvLen: U64, sources: Array[ViewSource], nameStart: U64, nameLen: U64, args: Array[Arg], recvRef: U64 = 0U64) -> U64 {
        return self.findCallableInViewSet(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: false, recvRef: recvRef)
    }

    inout fn findAssocInViewSet(recvStart: U64, recvLen: U64, sources: Array[ViewSource], nameStart: U64, nameLen: U64, args: Array[Arg], recvRef: U64 = 0U64) -> U64 {
        return self.findCallableInViewSet(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, associated: true, recvRef: recvRef)
    }

    // The one resolver for a source-selected method call. A `#` view is
    // additive: active extension candidates shadow the base surface, selected
    // traits narrow those candidates, then the bare surface is the fallback.
    // Type recovery, verifier, and backend consume this exact final Func.
    inout fn resolveExtMethodFinal(recv: U64, srcStart: U64, srcLen: U64, sourceOwner: U64 = 0U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        // `Type#Source.member()` is the associated counterpart of a value
        // view.  It has no value TypeInfo, so select its source from the type
        // qualifier before entering the ordinary receiver path.
        val assoc: Bind = self.assocRecvName(recv: recv)
        if assoc.nameLen != 0U64 {
            val recvRef: U64 = self.simpleTypeRef(nameStart: assoc.nameStart, nameLen: assoc.nameLen)
            mut val finalOwner: U64 = srcStart
            if sourceOwner != 0U64 { finalOwner = sourceOwner }
            val sources: Array[ViewSource] = self.collectViewSources(recv: recv, recvStart: assoc.nameStart, recvLen: assoc.nameLen, recvRef: recvRef, finalSourceId: intern(c: inout self, start: srcStart, len: srcLen), finalSourceOwner: finalOwner)
            val selected: U64 = self.findAssocInViewSet(recvStart: assoc.nameStart, recvLen: assoc.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef)
            if selected < self.arena.funcs.count() { return selected }
            return self.findAssoc(recvStart: assoc.nameStart, recvLen: assoc.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        val rt: TypeInfo = self.typeOf(id: recv)
        if !(rt.kind == 2 || (rt.kind == 0 && rt.nameLen > 0U64)) {
            return self.arena.funcs.count()
        }
        mut val finalOwner: U64 = srcStart
        if sourceOwner != 0U64 { finalOwner = sourceOwner }
        val sources: Array[ViewSource] = self.collectViewSources(recv: recv, recvStart: rt.nameStart, recvLen: rt.nameLen, recvRef: rt.ref, finalSourceId: intern(c: inout self, start: srcStart, len: srcLen), finalSourceOwner: finalOwner)
        mut val mfi: U64 = self.findMethodInViewSet(recvStart: rt.nameStart, recvLen: rt.nameLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: rt.ref)
        if mfi >= self.arena.funcs.count() {
            mfi = self.findMethod(recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: rt.ref)
        }
        return mfi
    }

    // Ordinary syntax still carries a view when its receiver was declared as
    // `T#Source`. Resolve that static source before the additive bare surface;
    // this is the same final-callable contract as explicit `value#Source.m()`.
    inout fn resolveMethodFinal(recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        return self.resolveMethodFinalForType(recv: recv, receiverType: self.typeOf(id: recv), nameStart: nameStart, nameLen: nameLen, args: args)
    }

    // Selection over an already-resolved semantic receiver. A ChainHole
    // continuation owns that receiver term structurally, so re-deriving it
    // from the context-free ExprId query would discard the payload binding.
    inout fn resolveMethodFinalForType(recv: U64, receiverType: TypeInfo, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        val rt: TypeInfo = receiverType
        if !(rt.kind == 2 || rt.kind == 3 || (rt.kind == 0 && rt.nameLen > 0U64)) {
            return self.arena.funcs.count()
        }
        // Array values carry their element name in TypeInfo, while the method
        // namespace is the structured `Array[E]` TypeRef head.  Keep this
        // recovery in the final resolver so Mono, validation, and backend use
        // the same callable decision rather than a backend-only Array lookup.
        mut val recvStart: U64 = rt.nameStart
        mut val recvLen: U64 = rt.nameLen
        if rt.kind == 3 && rt.ref != 0U64 && rt.ref < self.arena.types.count() {
            recvStart = self.arena.types[rt.ref].nameStart
            recvLen = self.arena.types[rt.ref].nameLen
        }
        mut val mfi: U64 = self.arena.funcs.count()
        // Always start from the complete view set.  A multi-view TypeRef deliberately
        // has no legacy `viewExtId`, so using that scalar as the gate would silently
        // turn `T#E#F` back into a bare `T` at this one call-site shape.
        mut val sources: Array[ViewSource] = self.collectViewSources(recv: recv, recvStart: recvStart, recvLen: recvLen, recvRef: rt.ref)
        // An identifier's declared view is authoritative even when an earlier
        // context-free recovery filled its expression cache before this body's
        // locals were installed. Keep this repair at the resolver boundary rather
        // than teaching each caller a separate static-view special case.
        if sources.count() == 0U64 {
            match self.arena.exprs[recv] {
                Expr.Ident(start: val localStart, len: val localLen) => {
                    val localId: U64 = intern(c: inout self, start: localStart, len: localLen)
                    mut val li: U64 = self.cur.locals.count()
                    while li > 0U64 && sources.count() == 0U64 {
                        li -= 1U64
                        val lo: Local = self.cur.locals[li]
                        if lo.nameId == localId && lo.ty != 0U64 && lo.ty < self.arena.types.count() {
                            val localTy: TypeRef = self.arena.types[lo.ty]
                            val localSources: Array[ResolvedViewSource] = self.typeRefViewSources(ref: lo.ty)
                            mut val vi: U64 = 0U64
                            while vi < localSources.count() {
                                val localSource: ResolvedViewSource = localSources[vi]
                                self.appendViewSource(sources: inout sources, source: self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: lo.ty, sourceId: localSource.surfaceId, sourceOwner: localSource.traitOwner))
                                vi += 1U64
                            }
                        }
                    }
                }
                _ => {}
            }
        }
        if sources.count() > 0U64 {
            mfi = self.findMethodInViewSet(recvStart: recvStart, recvLen: recvLen, sources: sources, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: rt.ref)
        }
        if mfi >= self.arena.funcs.count() {
            mfi = self.findMethod(recvStart: recvStart, recvLen: recvLen, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: rt.ref)
        }
        return mfi
    }

    inout fn extMethodNameExists(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.hasRecv {
                if f.extId != 0U64 {
                    if f.recvId == qRecvId {
                        if f.nameId == qNameId {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn viewOnlyMethodExists(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.hasRecv {
                if f.viewOnly {
                    if f.recvId == qRecvId {
                        if f.nameId == qNameId {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn findExtMethodById(recvStart: U64, recvLen: U64, srcId: U64, sourceOwner: U64, nameStart: U64, nameLen: U64, args: Array[Arg], recvRef: U64 = 0U64) -> U64 {
        if srcId == 0U64 || srcId > self.interner.entries.count() { return self.arena.funcs.count() }
        val source: ViewSource = self.resolveViewSourceKey(recvStart: recvStart, recvLen: recvLen, recvRef: recvRef, sourceId: srcId, sourceOwner: sourceOwner)
        return self.findExtMethodBySource(recvStart: recvStart, recvLen: recvLen, source: source, nameStart: nameStart, nameLen: nameLen, args: args, recvRef: recvRef)
    }

    inout fn findExtMethodBySource(recvStart: U64, recvLen: U64, source: ViewSource, nameStart: U64, nameLen: U64, args: Array[Arg], recvRef: U64 = 0U64) -> U64 {
        if source.kind == 0U64 { return self.arena.funcs.count() }
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        val qRecvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        mut val typeMatchEntry: U64 = self.decls.callables.count()
        mut val typeMatch2Entry: U64 = self.decls.callables.count()
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.hasRecv {
                if self.callableMatchesSource(c: cand, source: source) {
                        if f.nameId == qNameId {
                            if self.callableReceiverMatches(f: f, recvId: qRecvId, recvRef: recvRef) {
                                val matchRank: U64 = self.groundedMethodArgMatchRank(f: f, args: args, recvRef: recvRef)
                                if matchRank != 0U64 {
                                    if firstLabel == self.arena.funcs.count() {
                                        firstLabel = cand.funcIdx
                                    }
                                    if matchRank == 2U64 {
                                        if typeMatch == self.arena.funcs.count() {
                                            typeMatch = cand.funcIdx
                                            typeMatchEntry = i
                                        } else if typeMatch2 == self.arena.funcs.count() {
                                            typeMatch2 = cand.funcIdx
                                            typeMatch2Entry = i
                                        }
                                    }
                                }
                            }
                        }
                }
            }
            i += 1
        }
        if typeMatch != self.arena.funcs.count() {
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            if typeMatch2 != self.arena.funcs.count() {
                if typeMatchEntry < self.decls.callables.count() && typeMatch2Entry < self.decls.callables.count() {
                    if !(self.sameCallableSemanticOrigin(a: self.decls.callables[typeMatchEntry], b: self.decls.callables[typeMatch2Entry])) {
                        self.errorAt(offset: nameStart, msg: "ambiguous source-qualified call: this `#` name resolves to multiple declaration sources")
                    }
                }
                self.errorAt(offset: nameStart, msg: "ambiguous source-qualified call: this declaration source provides more than one matching method")
            }
            return typeMatch
        }
        return firstLabel
    }

    inout fn findAssoc(recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
        mut val firstLabel: U64 = self.arena.funcs.count()
        mut val typeMatch: U64 = self.arena.funcs.count()
        mut val typeMatch2: U64 = self.arena.funcs.count()
        val qNameId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        // a newtype inherits the underlying's assoc fns/factories (spec/10): resolve the
        // receiver name to the underlying so `Brand.checked(…)` finds Rgb's `checked`.
        val rnu: Bind = self.newtypeUnderName(start: recvStart, len: recvLen)
        val qRecvId: U64 = intern(c: inout self, start: rnu.nameStart, len: rnu.nameLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.isAssoc && self.callableIsBare(c: cand) {
                if f.nameId == qNameId {
                    if f.recvId == qRecvId {
                        val matchRank: U64 = self.callableArgMatchRank(f: f, args: args)
                        if matchRank != 0U64 {
                            if firstLabel == self.arena.funcs.count() {
                                firstLabel = cand.funcIdx
                            }
                            if matchRank == 2U64 {
                                if typeMatch == self.arena.funcs.count() {
                                    typeMatch = cand.funcIdx
                                } else {
                                    if typeMatch2 == self.arena.funcs.count() {
                                        typeMatch2 = cand.funcIdx
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        if typeMatch != self.arena.funcs.count() {
            // A type qualifier carries only the receiver head (`Box.tag()`),
            // not generic arguments.  Distinct receiver patterns that both
            // reach this point therefore cannot be selected by the caller.
            if typeMatch2 != self.arena.funcs.count() {
                self.errorAt(offset: nameStart, msg: "ambiguous associated call: this type qualifier matches more than one receiver pattern")
            }
            self.checkOverloadAmbiguity(a: typeMatch, b: typeMatch2, args: args)
            return typeMatch
        }
        return firstLabel
    }

    inout fn isTypeName(start: U64, len: U64) -> Bool {
        if self.structIndexByName(start: start, len: len) < self.arena.structs.count() {
            return true
        }
        // an import alias (`with { Real as Alias }`) names the same type as `Real`.
        val ar: Bind = self.aliasReal(start: start, len: len)
        val qId: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        // a newtype name is a type name too (it can be an assoc-fn/factory receiver
        // through its inherited assoc fns — `Brand.gray(…)`, spec/10).
        mut val nti: U64 = 0
        while nti < self.arena.newtypes.count() {
            if self.arena.newtypes[nti].nameId == qId {
                return true
            }
            nti += 1
        }
        mut val ei: U64 = 0
        while ei < self.arena.enums.count() {
            if self.arena.enums[ei].nameId == qId {
                return true
            }
            ei += 1
        }
        // a trait name also qualifies as an assoc-fn receiver: a trait can own
        // provided `assoc fn`s (no Self in their signature), called `Trait.fn(args)`
        // — the single provided impl makes it unambiguous (the derive model's
        // `Hash.derive(input)` rides on this). This is `isTypeName`'s only caller
        // (assocRecvName), so traits qualify only for that routing.
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            if self.decls.traits[ti].nameId == qId {
                return true
            }
            ti += 1
        }
        return self.genericStructIndex(nameStart: ar.nameStart, nameLen: ar.nameLen) < self.arena.structs.count()
    }

    inout fn typeHasAssocFn(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        // a newtype inherits the underlying type's factories/assoc fns (spec/10): resolve
        // to the underlying so `<Brand.checked …/>` finds Rgb's `checked` factory.
        val tnu: Bind = self.newtypeUnderName(start: typeStart, len: typeLen)
        val tId: U64 = intern(c: inout self, start: tnu.nameStart, len: tnu.nameLen)
        val nId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.isAssoc {
                if f.recvId == tId {
                    if f.nameId == nId {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn funcDeclLineHasAssocVal(f: Func) -> Bool {
        mut val anchor: U64 = f.defOffset
        if anchor == 0U64 {
            anchor = f.nameStart
        }
        if anchor >= self.arena.bytes.count() {
            return false
        }
        mut val lineStart: U64 = anchor
        while lineStart > 0U64 {
            if self.arena.bytes[lineStart - 1U64] == 10U8 {
                break
            }
            lineStart -= 1
        }
        mut val sawAssoc: Bool = false
        mut val sawVal: Bool = false
        mut val i: U64 = lineStart
        while i < anchor {
            if i + 5U64 <= anchor {
                if rangeEquals(bytes: self.arena.bytes, start: i, len: 5U64, kw: "assoc") {
                    sawAssoc = true
                }
            }
            if i + 3U64 <= anchor {
                if rangeEquals(bytes: self.arena.bytes, start: i, len: 3U64, kw: "val") {
                    sawVal = true
                }
            }
            i += 1
        }
        return sawAssoc && sawVal
    }

    inout fn typeHasAssocVal(typeStart: U64, typeLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val tnu: Bind = self.newtypeUnderName(start: typeStart, len: typeLen)
        val tId: U64 = intern(c: inout self, start: tnu.nameStart, len: tnu.nameLen)
        val nId: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.isAssoc {
                if f.recvId == tId {
                    if f.nameId == nId {
                        if self.funcDeclLineHasAssocVal(f: f) {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn typeRefHasFromFactory(errRef: U64, srcRef: U64) -> Bool {
        return self.typeRefFromFactoryIdx(errRef: errRef, srcRef: srcRef) < self.arena.funcs.count()
    }

    // spec/13: `try` converts the operand's error `F` to the function's error `E`
    // through `E`'s `from` factory, resolving the overload BY THE SOURCE TYPE `F`.
    // We must match the `from` whose sole parameter's type is `F` — matching by name
    // alone would pick an unrelated `from(I32)` and reinterpret an `F` bit-pattern as
    // `I32` (silent type-confusion IR). The parameter type is compared STRUCTURALLY
    // (head + every generic argument) via `typesCompatible`, so `from(Box[String])`
    // does NOT match a `Box[I64]` source (a head-name-only test read the I64 payload as
    // a String pointer -> SEGV). The head-id prefilter keeps the pre-`typesCompatible`
    // safety floor for the degenerate case where the parameter's full type is unresolved
    // (`ty == 0`, which `typesCompatible` treats permissively). Returns `funcs.count()`
    // (= no match) when no `from` on `E` accepts `F`.
    inout fn typeRefFromFactoryIdx(errRef: U64, srcRef: U64) -> U64 {
        if errRef >= self.arena.types.count() {
            return self.arena.funcs.count()
        }
        val eNameId: U64 = self.arena.types[errRef].nameId
        if eNameId == 0U64 {
            return self.arena.funcs.count()
        }
        if srcRef >= self.arena.types.count() {
            return self.arena.funcs.count()
        }
        val srcNameId: U64 = self.arena.types[srcRef].nameId
        if srcNameId == 0U64 {
            return self.arena.funcs.count()
        }
        val fromN: Bind = self.internBytes(s: "from")
        mut val i: U64 = 0
        while i < self.decls.callables.count() {
            val cand: Callable = self.decls.callables[i]
            val f: Func = self.arena.funcs[cand.funcIdx]
            if f.isAssoc {
                if f.recvId == eNameId {
                    if f.nameId == fromN.nameId {
                        // a From factory takes exactly the source error value; select the
                        // overload whose parameter type is `F` — head-id prefilter (the
                        // `ty == 0` floor) AND a full structural match on the generic args.
                        if f.params.count() == 1U64 {
                            if f.params[0].tyNameId == srcNameId {
                                if self.typesCompatible(expected: f.params[0].ty, inferred: srcRef) {
                                    return cand.funcIdx
                                }
                            }
                        }
                    }
                }
            }
            i += 1
        }
        return self.arena.funcs.count()
    }

    inout fn resultErrArgRef(ref: U64) -> U64 {
        if ref < self.arena.types.count() {
            if self.arena.types[ref].args.count() >= 2U64 {
                return self.arena.types[ref].args[1]
            }
        }
        return 0U64
    }

    inout fn rewriteAssocValReads() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Field(val base, val nameStart, val nameLen) => {
                    match self.arena.exprs[base] {
                        Expr.Ident(start: val tStart, len: val tLen) => {
                            if self.isTypeName(start: tStart, len: tLen) {
                                if self.typeHasAssocVal(typeStart: tStart, typeLen: tLen, nameStart: nameStart, nameLen: nameLen) {
                                    val noArgs: Array[Arg] = []
                                    self.arena.exprs[i] = <Expr.Method recv=base nameStart=nameStart nameLen=nameLen args=noArgs />
                                }
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            i += 1
        }
    }
}
