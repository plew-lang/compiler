// Source owner success is published only by these checked preparation phases.
impl Comp {
    inout fn sourceOwnerConstructionClosed(owner: SemanticCompletionOwner) -> Bool { return self.sourceFacts.outcome(owner: owner).isSome() }


    inout fn prepareLexicalBodyUncached(owner: U64) -> Result[(), CompileDiagnostic] {
        self.cur.bodyFnIdx = owner
        self.cur.bodyEnvironment = <InstanceEnvironment />
        self.cur.bodyId = 0U64
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
        // Construct calls with their source types before compatibility reads
        // them. Later validation must not reconstruct the chosen member.
        try self.recordParametricFunction(fnIdx: owner, recordCallTemplates: true)
        self.cur.recordCallTemplates = false
        try self.checkGenericFunction(fnIdx: owner)
        try self.verifyFunctionDeclaration(fnIdx: owner)
        if (try self.completeRecordedBodyDefaultCalls(owner: owner)) != 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: owner).defOffset, msg: "internal error: lexical body has incomplete default argument plans") />
        }
        try self.completeSourceConversions(owner: <SemanticCompletionOwner.Function index=owner />)
        try self.closeCallTemplatesForBody(fnIdx: owner)
        val admitted = try self.admitRecordedBodyCallConstraints(owner: owner)
        try self.checkSourceConversionEvidence(owner: <SemanticCompletionOwner.Function index=owner />)
        try self.checkSourceDiagnosticFailures(owner: <SemanticCompletionOwner.Function index=owner />)
        try self.checkSourceTypingObligations(owner: <SemanticCompletionOwner.Function index=owner />)
        try self.checkNestedSourceFacts(owner: <SemanticCompletionOwner.Function index=owner />)
        self.finalizeLexicalCallStorage(owner: owner)
        for token in admitted { self.publishPreparedCallConstraints(admitted: token) }
        return <Result.Ok value=() />
    }

    inout fn prepareGlobalInitializerUncached(target: U64) -> Result[(), CompileDiagnostic] {
        try self.enterGlobalInitializer(target: target)
        val index: U64 = self.globalIndexForDeclarationTarget(target: target)
        val stmt: U64 = self.arena.globals[index].letStmt
        self.cur.recordCallTemplates = true
        try self.recordStmt(stmtId: stmt)
        self.cur.recordCallTemplates = false
        try self.enterGlobalInitializer(target: target)
        try self.verifyStmt(stmtId: stmt)
        self.cur.recordCallTemplates = false
        if (try self.completeRecordedGlobalDefaultCalls(target: target)) != 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: target, msg: "internal error: global default argument plans are incomplete") />
        }
        try self.completeSourceConversions(owner: <SemanticCompletionOwner.Global target=target />)
        try self.prepareGlobalCallTemplateConstraints(target: target)
        val admitted = try self.admitGlobalCallConstraints(target: target)
        try self.checkSourceConversionEvidence(owner: <SemanticCompletionOwner.Global target=target />)
        try self.checkSourceDiagnosticFailures(owner: <SemanticCompletionOwner.Global target=target />)
        try self.checkSourceTypingObligations(owner: <SemanticCompletionOwner.Global target=target />)
        try self.checkNestedSourceFacts(owner: <SemanticCompletionOwner.Global target=target />)
        self.finalizeGlobalCallStorage(target: target)
        for token in admitted { self.publishPreparedCallConstraints(admitted: token) }
        return <Result.Ok value=() />
    }

    // This is a source-stable conservative summary, not a mutable result of a
    // later analysis. Only the successful construction tail may publish it.
    inout fn finalizeSourceCallStorage(index: U64) -> Bool {
        val template = self.callTemplateAt(index: index)
        val required = self.recordedCallHasStorageArguments(kind: template.kind)
        if !required {
            self.replaceSourceCallTemplate(index: index, template: <CallTemplate siteKey=template.siteKey resultTypeRecipe=template.resultTypeRecipe kind=template.kind expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm mayHaveStorageArguments=false />)
        }
        return required
    }

    inout fn finalizeLexicalCallStorage(owner: U64) {
        mut val required: Dictionary[U64, Bool] = [:]
        mut val row = self.firstLexicalCallTemplate(owner: owner)
        while row != 0U64 {
            val index = row - 1U64
            val sourceOwner = self.callTemplateHeadAt(index: index).siteKey.ownerFnIdx
            if !required.getOr(key: sourceOwner, fallback: false) {
                if self.finalizeSourceCallStorage(index: index) { required[sourceOwner] = true }
            }
            // Once this body's analysis is needed, unexamined sites retain
            // their conservative true default without scanning their operands.
            row = self.callTemplateBodyNext[index]
        }
    }

    inout fn finalizeGlobalCallStorage(target: U64) {
        mut val required: Dictionary[U64, Bool] = [:]
        for index in self.globalCallTemplateOwners.getOr(key: target, fallback: []) {
            val sourceOwner = self.callTemplateHeadAt(index: index).siteKey.ownerFnIdx
            if !required.getOr(key: sourceOwner, fallback: false) {
                if self.finalizeSourceCallStorage(index: index) { required[sourceOwner] = true }
            }
        }
    }
}
