// Part of name/type resolution (root: _.pw): global-init dependency
// ordering and use-alias / factory-construction rewriting.

use ../../Ir only { InstanceEnvironment }

pub impl Comp {
    fn globalInitializerPrepared(target: U64) -> Bool {
        mut val index: U64 = 0U64
        while index < self.preparedGlobalTargets.count() {
            if self.preparedGlobalTargets[index] == target { return true }
            index += 1U64
        }
        return false
    }

    inout fn selectReferencedGlobal(exprId: U64) {
        if !self.genMode { return }
        match self.recordedGlobalAddress(exprId: exprId) {
            Optional.Some(v: val address) => {
                mut val index: U64 = 0U64
                while index < self.selectedGlobalTargets.count() {
                    if self.selectedGlobalTargets[index] == address.declarationTarget { return }
                    index += 1U64
                }
                self.selectedGlobalTargets.append(address.declarationTarget)
            }
            Optional.None => {}
        }
    }

    inout fn globalIndexAtUse(start: U64, len: U64) -> U64 {
        match self.moduleBindingAt(nameStart: start, nameLen: len) {
            ModuleBinding.Declaration(val moduleId, val nameStart, val nameLen) => {
                mut val index = 0U64
                while index < self.arena.globals.count() {
                    val global = self.arena.globals[index]
                    if self.moduleOf(offset: global.nameStart) == moduleId && spansEqual(c: inout self, aStart: global.nameStart, aLen: global.nameLen, bStart: nameStart, bLen: nameLen) { return index }
                    index += 1U64
                }
            }
            _ => {}
        }
        return self.arena.globals.count()
    }

    // Name lookup installs declarations without evaluating their type queries.
    // Only a value-type consumer forces an unannotated global's initializer.
    inout fn typedLocal(index: U64) -> Result[Local, CompileDiagnostic] {
        val local: Local = self.cur.locals[index]
        if !local.globalTypePending { return <Result.Ok value=local />}
        val globalIndex: U64 = self.globalIndexForDeclarationTarget(target: local.nameStart)
        if globalIndex >= self.arena.globals.count() {
            return <Result.Err error=self.diagnosticAt(offset: local.nameStart, msg: "internal error: pending global type has no declaration") />
        }
        mut val resolving: U64 = 0U64
        while resolving < self.resolvingGlobalTypes.count() {
            if self.resolvingGlobalTypes[resolving] == local.nameStart {
                return <Result.Err error=self.diagnosticAt(offset: local.nameStart, msg: "cyclic global type inference") />
            }
            resolving += 1U64
        }
        val saved = self.cur
        val priorQueries = self.resolvingGlobalTypes
        self.resolvingGlobalTypes.append(local.nameStart)
        try self.enterGlobalInitializer(target: local.nameStart)
        mut val result: Local = local
        match self.arena.stmts[self.arena.globals[globalIndex].letStmt] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                val inferred = (try self.inferLetType(tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init))
                result = <Local isGlobal=local.isGlobal nameStart=local.nameStart nameLen=local.nameLen nameId=local.nameId tyStart=inferred.start tyLen=inferred.len tyNameId=intern(c: inout self, start: inferred.start, len: inferred.len) isArray=inferred.arr ty=inferred.ty isInout=local.isInout isMut=local.isMut owned=local.owned moved=local.moved cnum=local.cnum />
            }
            _ => {}
        }
        self.resolvingGlobalTypes = priorQueries
        self.cur = saved
        self.cur.locals.set(i: index, value: result)
        return <Result.Ok value=result />
    }

    inout fn enterGlobalInitializer(target: U64) -> Result[(), CompileDiagnostic] {
        self.cur.locals = []
        self.cur.hasRecv = false
        self.cur.extId = 0U64
        self.cur.recvInstRef = 0U64
        self.clearSelfItemEnv()
        self.cur.typeParams = []
        self.cur.typeArgs = []
        self.cur.checkFn = 18446744073709551615U64
        self.cur.recordCallTemplates = false
        self.cur.retVoid = true
        self.cur.retStart = 0U64
        self.cur.retLen = 0U64
        self.cur.retIsArray = false
        self.cur.retTy = 0U64
        self.cur.branchBase = 0U64
        self.cur.verifyMovedIdx = []
        self.enterBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
        self.cur.bodySelfRef = 0U64
        self.cur.bodyItemRef = 0U64
        self.cur.globalInitializerTarget = <Optional.Some v=target />
        return <Result.Ok value=() />
    }

    inout fn prepareGlobalInitializer(target: U64) -> Result[(), CompileDiagnostic] {
        if self.globalInitializerPrepared(target: target) { return <Result.Ok value=() /> }
        val saved = self.cur
        try self.enterGlobalInitializer(target: target)
        val index: U64 = self.globalIndexForDeclarationTarget(target: target)
        val stmt: U64 = self.arena.globals[index].letStmt
        try self.recordStmt(stmtId: stmt)
        try self.enterGlobalInitializer(target: target)
        try self.verifyStmt(stmtId: stmt)
        try self.enterGlobalInitializer(target: target)
        self.cur.recordCallTemplates = true
        try self.recordStmt(stmtId: stmt)
        self.cur.recordCallTemplates = false
        if (try self.completeRecordedDefaultCalls()) != 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: target, msg: "internal error: global default argument plans are incomplete") />
        }
        self.preparedGlobalTargets.append(target)
        self.cur = saved
        return <Result.Ok value=() />
    }

    inout fn retainSelectedGlobals() {
        mut val selected: Array[Global] = []
        mut val index: U64 = 0U64
        while index < self.arena.globals.count() {
            val global: Global = self.arena.globals[index]
            if self.globalInitializerPrepared(target: global.nameStart) { selected.append(global) }
            index += 1U64
        }
        self.arena.globals = selected
    }

    // Map a frozen global declaration identity to the current storage row.
    // Dependency ordering may reorder `arena.globals`, so callers must never
    // persist or reconstruct this row index as their semantic identity.
    // `nameStart == 0` is a valid declaration identity, hence the explicit
    // out-of-range sentinel rather than zero.
    fn globalIndexForDeclarationTarget(target: U64) -> U64 {
        mut val index: U64 = 0U64
        while index < self.arena.globals.count() {
            if self.arena.globals[index].nameStart == target { return index }
            index += 1U64
        }
        return self.arena.globals.count()
    }

    // Consume the existing identifier decision. In particular, do not seed
    // source locals or search names after Record has closed the lexical scope.
    fn recordedGlobalAddress(exprId: U64) -> Optional[SemanticGlobalAddress] {
        if exprId >= self.typeCache.identBind.count() || exprId >= self.typeCache.identTarget.count() { return <Optional.None /> }
        if self.typeCache.identBind[exprId] != identValueCode() { return <Optional.None /> }
        val target = self.typeCache.identTarget[exprId]
        if exprId >= self.arena.semanticExprTypes.count() { return <Optional.None /> }
        val term = self.arena.semanticExprTypes[exprId].term
        if term == 0U64 || term >= self.arena.typeCount() { return <Optional.None /> }
        mut val index: U64 = 0U64
        while index < self.arena.globals.count() {
            val global = self.arena.globals[index]
            if global.nameStart == target {
                return <Optional.Some v=<SemanticGlobalAddress declarationTarget=target typeTerm=term mutable=global.mutable /> />
            }
            index += 1U64
        }
        return <Optional.None />
    }

    inout fn globalInitExpr(g: Global) -> U64 {
        match self.arena.stmts[g.letStmt] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { return init }
            _ => { return 0 }
        }
    }
}

pub impl Comp {

    // Collect the indices (into c.arena.globals) of every global the expression `id` reads,
    // appended (deduped) to `into`. Covers the expression forms a global initializer can
    // take; rarer block-bearing forms (match/if/closure) contribute nothing — at worst a
    // forward reference there stays declaration-ordered, never misordered.
    inout fn collectGlobalDeps(id: U64, into: inout Array[U64]) {
        if id >= self.arena.exprs.count() {
            return
        }
        match self.arena.exprs[id] {
            Expr.Ident(val start, val len) => {
                val index = self.globalIndexAtUse(start: start, len: len)
                if index < self.arena.globals.count() && !u64ArrayHas(a: into, v: index) { into.append(index) }
            }
            Expr.Unary(op: _, val operand) => { self.collectGlobalDeps(id: operand, into: inout into) }
            Expr.Binary(op: _, val lhs, val rhs) => {
                self.collectGlobalDeps(id: lhs, into: inout into)
                self.collectGlobalDeps(id: rhs, into: inout into)
            }
            Expr.Call(nameStart: _, nameLen: _, val args) => {
                mut val i: U64 = 0
                while i < args.len { self.collectGlobalDeps(id: self.argAt(args: args, index: i).expr, into: inout into) i += 1 }
            }
            Expr.Method(val recv, nameStart: _, nameLen: _, val args) => {
                self.collectGlobalDeps(id: recv, into: inout into)
                mut val i: U64 = 0
                while i < args.len { self.collectGlobalDeps(id: self.argAt(args: args, index: i).expr, into: inout into) i += 1 }
            }
            Expr.Field(val base, nameStart: _, nameLen: _) => { self.collectGlobalDeps(id: base, into: inout into) }
            Expr.Index(val base, val index) => {
                self.collectGlobalDeps(id: base, into: inout into)
                self.collectGlobalDeps(id: index, into: inout into)
            }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                mut val i: U64 = 0
                while i < fields.len { self.collectGlobalDeps(id: self.makeFieldAt(fields: fields, index: i).value, into: inout into) i += 1 }
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.len { self.collectGlobalDeps(id: self.exprAt(exprs: elems, index: i), into: inout into) i += 1 }
            }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { self.collectGlobalDeps(id: operand, into: inout into) }
            Expr.OptChain(val base, val cont) => {
                self.collectGlobalDeps(id: base, into: inout into)
                self.collectGlobalDeps(id: cont, into: inout into)
            }
            Expr.ChainHole => {}
            Expr.Try(val expr) => { self.collectGlobalDeps(id: expr, into: inout into) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { self.collectGlobalDeps(id: base, into: inout into) }
            Expr.Deref(val base) => { self.collectGlobalDeps(id: base, into: inout into) }
            Expr.Move(val operand, isBorrow: _) => { self.collectGlobalDeps(id: operand, into: inout into) }
            Expr.Await(val operand) => { self.collectGlobalDeps(id: operand, into: inout into) }
            _ => {}
        }
    }

    // DFS post-order over the global dependency graph. `state[i]`: 0=unvisited,
    // 1=on-stack (a back-edge to it is a cycle), 2=done. Appends i after its deps. Deps
    // are recomputed here (rather than stored in a nested array, which self-host's array
    // codegen does not handle for `Array[Array[U64]]`).
    inout fn globalDfs(i: U64, state: inout Array[U64], order: inout Array[U64]) -> Result[(), CompileDiagnostic] {
        if state[i] == 2U64 {
            return <Result.Ok value=() />
        }
        if state[i] == 1U64 {
            return <Result.Err error=self.diagnosticAt(offset: self.arena.globals[i].nameStart, msg: "module-level variables form an initialization cycle (a global's initializer depends on itself transitively — spec/15)") />
        }
        state[i] = 1U64
        mut val d: Array[U64] = []
        self.collectGlobalDeps(id: self.globalInitExpr(g: self.arena.globals[i]), into: inout d)
        mut val k: U64 = 0
        while k < d.count() {
            try self.globalDfs(i: d[k], state: inout state, order: inout order)
            k += 1
        }
        state[i] = 2U64
        order.append(i)
        return <Result.Ok value=() />
    }

    inout fn orderGlobalsByDependency() -> Result[(), CompileDiagnostic] {
        val n: U64 = self.arena.globals.count()
        if n <= 1U64 {
            return <Result.Ok value=() />
        }
        mut val state: Array[U64] = []
        mut val j: U64 = 0
        while j < n {
            state.append(0U64)
            j += 1
        }
        mut val order: Array[U64] = []
        mut val s: U64 = 0
        while s < n {
            try self.globalDfs(i: s, state: inout state, order: inout order)
            s += 1
        }
        // rebuild self.arena.globals in dependency order (deps before dependents).
        mut val reordered: Array[Global] = []
        mut val o: U64 = 0
        while o < order.count() {
            reordered.append(self.arena.globals[order[o]])
            o += 1
        }
        self.arena.globals = reordered
        return <Result.Ok value=() />
    }

    // Post-load rewrite (spec/05): a named factory call `<Type.name attrs/>` parses as a
    // Make node (isEnum, variant=name). When `name` is NOT an enum variant but a named
    // factory (an assoc fn on Type), rewrite it to the assoc-fn call `Type.name(labels:
    // values)` so it rides the existing assoc-fn machinery. Enum-variant constructions
    // (`<Optional.Some v=…/>`) are untouched (Some has no assoc fn).
    inout fn rewriteFactoryConstruction() -> Result[(), CompileDiagnostic] {
        val fromN: Bind = self.internBytes(s: "from")
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, ty: val ty, val fields) => {
                    if isEnum {
                        if self.typeHasAssocFn(typeStart: typeStart, typeLen: typeLen, nameStart: variantStart, nameLen: variantLen) {
                            val recv: U64 = self.pushExpr(e: <Expr.Ident start=typeStart len=typeLen />)
                            mut val args: Array[Arg] = []
                            mut val fi: U64 = 0
                            while fi < fields.len {
                                val field: MakeField = self.makeFieldAt(fields: fields, index: fi)
                                args.append(<Arg expr=field.value isInout=false labelStart=field.nameStart labelLen=field.nameLen hasLabel=true />)
                                fi += 1
                            }
                            self.arena.exprs[i] = <Expr.Method recv=recv nameStart=variantStart nameLen=variantLen args=self.pushArgs(args: args) />
                            val receiverTerm: U64 = if ty != 0U64 { give ty } else { give self.simpleTypeRef(nameStart: typeStart, nameLen: typeLen) }
                            val originSerial: U64 = self.nextExprOriginSerial
                            self.nextExprOriginSerial += 1U64
                            try self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=i originSerial=originSerial receiverTerm=receiverTerm receiverIsType=true />)
                        }
                    }
                }
                Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
                    // `x as T` ⟺ `<T from=x/>` (spec/12): when `T` owns a `from` factory
                    // (an anonymous `factory(from: …)`), route the cast to it. Numeric casts
                    // are untouched (primitives have no `from` factory).
                    if self.typeHasAssocFn(typeStart: tyStart, typeLen: tyLen, nameStart: fromN.nameStart, nameLen: fromN.nameLen) {
                        val recv: U64 = self.pushExpr(e: <Expr.Ident start=tyStart len=tyLen />)
                        mut val cargs: Array[Arg] = []
                        cargs.append(<Arg expr=operand isInout=false labelStart=fromN.nameStart labelLen=fromN.nameLen hasLabel=true />)
                        self.arena.exprs[i] = <Expr.Method recv=recv nameStart=fromN.nameStart nameLen=fromN.nameLen args=self.pushArgs(args: cargs) />
                    }
                }
                _ => {}
            }
            i += 1
        }
        return <Result.Ok value=() />
    }

    // Resolve a module-local use alias to the real imported name (spec/15:
    // `use M only { Real as Alias }`). A use of `Alias` in a TYPE position (annotation,
    // construction head, assoc-fn receiver) resolves to `Real` for downstream struct/type
    // lookup — the call-expression alias rewrite (the lexical module-name pass) handles value
    // uses, this handles type uses. No-op when there are no aliases or the span does not
    // name a local alias (returns the input span unchanged). The alias is module-scoped:
    // only a use in the same module as the `only` clause resolves.
    inout fn aliasReal(start: U64, len: U64) -> Bind {
        if self.decls.importAliases.count() == 0U64 {
            return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
        }
        mut val ai: U64 = 0
        while ai < self.decls.importAliases.count() {
            val al: Bind = self.decls.importAliases[ai]
            if spansEqual(c: inout self, aStart: al.nameStart, aLen: al.nameLen, bStart: start, bLen: len) {
                if self.moduleOf(offset: al.nameStart) == self.moduleOf(offset: start) {
                    return <Bind nameStart=al.fieldStart nameLen=al.fieldLen fieldStart=al.fieldStart fieldLen=al.fieldLen />
                }
            }
            ai += 1
        }
        return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
    }

    // Parser AST values retain selector text but not a separate selector span.
    // Resolve that text in the surrounding expression/type module before it is
    // interned.  This preserves the imported declaration's span as the trait
    // identity carrier; it is deliberately shared by value and type views.
    inout fn aliasRealTextInModule(siteOffset: U64, text: String) -> Bind {
        val traitOwner: U64 = self.traitOwnerForSelector(siteOffset: siteOffset, text: text)
        if traitOwner != 0U64 {
            val traitLen: U64 = self.traitNameLenByOwner(owner: traitOwner)
            return <Bind nameStart=traitOwner nameLen=traitLen fieldStart=traitOwner fieldLen=traitLen />
        }
        mut val ai: U64 = 0U64
        while ai < self.decls.importAliases.count() {
            val al: Bind = self.decls.importAliases[ai]
            if self.moduleOf(offset: al.nameStart) == self.moduleOf(offset: siteOffset) {
                if rangeEquals(bytes: self.arena.bytes, start: al.nameStart, len: al.nameLen, kw: text) {
                    return <Bind nameStart=al.fieldStart nameLen=al.fieldLen fieldStart=al.fieldStart fieldLen=al.fieldLen />
                }
            }
            ai += 1U64
        }
        return self.internBytes(s: text)
    }

    // Lower an authored selector once.  `traitOwner` is an immutable
    // declaration identity, not a spelling to be resolved again by Verify,
    // Mono, or LLVM.  An extension bundle is receiver-dependent, so it keeps
    // its canonical surface key with traitOwner=0 until the common view query
    // decides whether that bundle applies.
    inout fn lowerViewSource(siteOffset: U64, text: String) -> ResolvedViewSource {
        val written: Bind = self.internBytes(s: text)
        val owner: U64 = self.traitOwnerForSelector(siteOffset: siteOffset, text: text)
        if owner != 0U64 {
            val ownerLen: U64 = self.traitNameLenByOwner(owner: owner)
            return <ResolvedViewSource writtenStart=siteOffset writtenLen=text.bytes().count() lexicalSurfaceModule=self.moduleOf(offset: siteOffset) surfaceId=intern(c: inout self, start: owner, len: ownerLen) traitOwner=owner />
        }
        return <ResolvedViewSource writtenStart=siteOffset writtenLen=text.bytes().count() lexicalSurfaceModule=self.moduleOf(offset: siteOffset) surfaceId=written.nameId />
    }

    inout fn lowerViewSourceSpan(siteOffset: U64, start: U64, len: U64) -> ResolvedViewSource {
        val owner: U64 = self.traitOwnerForSelectorSpan(siteOffset: siteOffset, start: start, len: len)
        if owner != 0U64 {
            val ownerLen: U64 = self.traitNameLenByOwner(owner: owner)
            return <ResolvedViewSource writtenStart=siteOffset writtenLen=len lexicalSurfaceModule=self.moduleOf(offset: siteOffset) surfaceId=intern(c: inout self, start: owner, len: ownerLen) traitOwner=owner />
        }
        return <ResolvedViewSource writtenStart=siteOffset writtenLen=len lexicalSurfaceModule=self.moduleOf(offset: siteOffset) surfaceId=intern(c: inout self, start: start, len: len) />
    }

    // If `recv` is a bare identifier naming a type (not a local value), return that
    // type's name span as an assoc-fn receiver; else signal "not an assoc call" by
    // returning len 0. Used by call codegen/type recovery to route `Type.name(args)`.
    inout fn assocRecvName(recv: U64) -> Bind {
        match self.arena.exprs[recv] {
            // A type qualifier may carry the same static view set as a value
            // (`Sample#Extra.value()`).  The caller obtains the source set
            // separately; this helper owns only the lexical type head.
            Expr.ExtView(recv: val base, source: _, strip: _) => {
                return self.assocRecvName(recv: base)
            }
            Expr.Ident(val start, val len) => {
                if self.isSelfRef(start: start, len: len) {
                    return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
                }
                if self.localIndexByName(start: start, len: len) < self.cur.locals.count() {
                    return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
                }
                if self.isTypeName(start: start, len: len) {
                    // resolve a use alias (`only { Real as Alias }`) so `Alias.fn(args)`
                    // dispatches to the assoc fn declared on the real type (spec/15).
                    return self.aliasReal(start: start, len: len)
                }
                return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
            }
            _ => { return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 /> }
        }
    }
}

pub impl Comp {
    inout fn anonymousConstructionCandidates(typeStart: U64, typeLen: U64) -> Array[U64] {
        val receiver = self.newtypeUnderName(start: typeStart, len: typeLen)
        val name = intern(c: inout self, start: receiver.nameStart, len: receiver.nameLen)
        return self.arena.anonymousFactoriesForReceiver(nameId: name)
    }

    inout fn constructionHasAnonymousFactories(exprId: U64) -> Bool {
        match self.arena.exprs[exprId] {
            Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, fields: _) => {
                return !isEnum && self.anonymousConstructionCandidates(typeStart: typeStart, typeLen: typeLen).count() != 0U64
            }
            _ => { return false }
        }
    }

    // Memberwise construction participates with its declared field types, not
    // merely with the first written label. Reuse ordinary argument matching.
    inout fn memberwiseConstructionMatches(receiver: U64, fields: MakeFieldRange, offset: U64) -> Result[Bool, CompileDiagnostic] {
        val declaration = self.structIndexForType(ref: receiver)
        if declaration >= self.arena.structCount() { return <Result.Ok value=false /> }
        val structure = self.arena.structAt(index: declaration)
        if !structure.isExtern && !structure.isStructuralLayout && self.moduleOf(offset: structure.nameStart) != self.moduleOf(offset: offset) && !self.structHasPubFactory(structIndex: declaration) {
            return <Result.Ok value=false />
        }
        val declared = structure.fields
        mut val index = 0U64
        while index < fields.len {
            val field = self.makeFieldAt(fields: fields, index: index)
            mut val matched = false
            for val candidate in declared {
                if spansEqual(c: inout self, aStart: field.nameStart, aLen: field.nameLen, bStart: candidate.nameStart, bLen: candidate.nameLen) {
                    val term = (try self.fieldTypeRefOfReceiver(receiverRef: receiver, fieldStart: candidate.nameStart, fieldLen: candidate.nameLen))
                    val info = self.typeInfoOfRef(ref: term)
                    val parameter = <Param nameStart=candidate.nameStart nameLen=candidate.nameLen nameId=candidate.nameId tyStart=info.nameStart tyLen=info.nameLen tyNameId=intern(c: inout self, start: info.nameStart, len: info.nameLen) tyIsArray=info.kind == 3I64 ty=term isInout=false isMove=false isBorrow=false noLabel=false hasDefault=candidate.hasDefault defaultExpr=candidate.defaultVal />
                    matched = (try self.argMatchesParam(argExpr: field.value, p: parameter))
                    break
                }
            }
            if !matched { return <Result.Ok value=false /> }
            index += 1U64
        }
        for val candidate in declared {
            if !candidate.hasDefault {
                mut val supplied = false
                index = 0U64
                while index < fields.len {
                    val field = self.makeFieldAt(fields: fields, index: index)
                    if spansEqual(c: inout self, aStart: field.nameStart, aLen: field.nameLen, bStart: candidate.nameStart, bLen: candidate.nameLen) { supplied = true }
                    index += 1U64
                }
                if !supplied { return <Result.Ok value=false /> }
            }
        }
        return <Result.Ok value=true />
    }

    // Run under Record's lexical scope. The selected declaration is carried
    // by the synthetic call, so later passes never redo factory selection.
    inout fn prepareAnonymousConstruction(exprId: U64, chainHoleRef: U64) -> Result[(), CompileDiagnostic] {
        match self.arena.exprs[exprId] {
            Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, val ty, val fields) => {
                if isEnum || self.arena.resolvedMemberwiseFactories.contains(exprId) { return <Result.Ok value=() /> }
                val candidates = self.anonymousConstructionCandidates(typeStart: typeStart, typeLen: typeLen)
                val receiver = if ty != 0U64 { give ty } else { give self.simpleTypeRef(nameStart: typeStart, nameLen: typeLen) }
                val abstractReceiver = receiver != 0U64 && receiver < self.arena.typeCount() && (self.arena.typeTerms[receiver].paramId != 0U64 || self.arena.typeTerms[receiver].assocNameId != 0U64)
                if candidates.count() == 0U64 && !abstractReceiver { return <Result.Ok value=() /> }
                mut val arguments: Array[Arg] = []
                mut val index = 0U64
                while index < fields.len {
                    val field = self.makeFieldAt(fields: fields, index: index)
                    try self.recordExpr(exprId: field.value, chainHoleRef: chainHoleRef)
                    arguments.append(<Arg expr=field.value isInout=false labelStart=field.nameStart labelLen=field.nameLen hasLabel=true />)
                    index += 1U64
                }
                val args = self.pushArgs(args: arguments)
                if abstractReceiver {
                    mut val callStart = typeStart
                    mut val callLen = 0U64
                    if fields.len != 0U64 {
                        val first = self.makeFieldAt(fields: fields, index: 0U64)
                        callStart = first.nameStart
                        callLen = first.nameLen
                    }
                    val resolution = (try self.staticMemberResolution(fnIdx: self.cur.checkFn, receiverRef: receiver, nameStart: callStart, nameLen: callLen, args: args))
                    mut val factoryRequirement = false
                    match resolution {
                        StaticMemberResolution.Requirement(proof: _, val traitIdx, val reqIdx) => {
                            val trait = self.decls.traitAt(index: traitIdx)
                            factoryRequirement = self.traitReqAt(reqs: trait.reqs, index: reqIdx).isAnonymousFactory
                        }
                        _ => {}
                    }
                    if !factoryRequirement {
                        return <Result.Err error=self.diagnosticAt(offset: typeStart, msg: "generic construction requires a matching factory requirement") />
                    }
                    val recv = self.pushExpr(e: <Expr.Ident start=typeStart len=typeLen />)
                    self.arena.exprs[exprId] = <Expr.Method recv=recv nameStart=callStart nameLen=callLen args=args />
                    val origin = self.nextExprOriginSerial
                    self.nextExprOriginSerial += 1U64
                    try self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=exprId originSerial=origin receiverTerm=receiver receiverIsType=true />)
                    return <Result.Ok value=() />
                }
                val memberwise = (try self.memberwiseConstructionMatches(receiver: receiver, fields: fields, offset: typeStart))
                mut val selected = self.arena.functionCount()
                mut val rank = 0U64
                mut val hidden = self.arena.functionCount()
                for val candidate in candidates {
                    val function = self.arena.functionAt(index: candidate)
                    if function.extId == 0U64 && function.srcTraitId == 0U64 && self.receiverDeclarationMatches(f: function, receiverRef: receiver) {
                        val matchRank = (try self.callableArgMatchRank(f: function, args: args))
                        if !self.methodIsVisible(mf: function, offset: typeStart) {
                            if matchRank != 0U64 && hidden == self.arena.functionCount() { hidden = candidate }
                        } else if matchRank > rank {
                            rank = matchRank
                            selected = candidate
                        } else if matchRank == 2U64 {
                            try self.checkOverloadAmbiguity(a: selected, b: candidate, args: args)
                            return <Result.Err error=self.diagnosticAt(offset: typeStart, msg: "ambiguous anonymous factory call") />
                        }
                    }
                }
                if memberwise {
                    // Factory bodies construct their completed Self through the
                    // memberwise surface (spec/05), not recursive factory calls.
                    mut val constructingSelf = false
                    if self.cur.checkFn < self.arena.functionCount() {
                        val enclosing = self.arena.functionAt(index: self.cur.checkFn)
                        constructingSelf = enclosing.isFactory && self.receiverDeclarationMatches(f: enclosing, receiverRef: receiver) && enclosing.recvId == intern(c: inout self, start: typeStart, len: typeLen)
                    }
                    if rank == 2U64 && !constructingSelf {
                        return <Result.Err error=self.diagnosticAt(offset: typeStart, msg: "ambiguous construction: both memberwise and anonymous factories match") />
                    }
                    self.arena.resolvedMemberwiseFactories.insert(exprId)
                    self.normalizeMemberwiseDefaultsAt(exprId: exprId)
                    return <Result.Ok value=() />
                }
                // A hidden candidate is retained only for the access diagnostic,
                // never to introduce ambiguity among the visible candidates.
                if selected == self.arena.functionCount() { selected = hidden }
                if selected < self.arena.functionCount() {
                    val function = self.arena.functionAt(index: selected)
                    val recv = self.pushExpr(e: <Expr.Ident start=typeStart len=typeLen />)
                    mut val callStart = typeStart
                    mut val callLen = 0U64
                    if fields.len != 0U64 {
                        val first = self.makeFieldAt(fields: fields, index: 0U64)
                        callStart = first.nameStart
                        callLen = first.nameLen
                    }
                    self.arena.exprs[exprId] = <Expr.Method recv=recv nameStart=callStart nameLen=callLen args=args />
                    val origin = self.nextExprOriginSerial
                    self.nextExprOriginSerial += 1U64
                    try self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=exprId originSerial=origin receiverTerm=receiver receiverIsType=true selectedFactory=<Optional.Some v=selected /> />)
                } else {
                    self.arena.resolvedMemberwiseFactories.insert(exprId)
                    self.normalizeMemberwiseDefaultsAt(exprId: exprId)
                }
            }
            _ => {}
        }
        return <Result.Ok value=() />
    }
}
