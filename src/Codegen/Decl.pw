

pub impl Comp {
    inout fn nameIsMain(f: Func) -> Bool {
        if f.hasRecv {
            return false
        }
        return rangeEquals(bytes: self.arena.bytes, start: f.nameStart, len: f.nameLen, kw: "main")
    }

    inout fn isTraitName(start: U64, len: U64) -> Bool {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = 0
        while i < self.decls.traitOwners.count() {
            val t: TraitOwner = self.decls.traitOwners[i]
            if t.nameId == qId {
                return true
            }
            i += 1
        }
        return false
    }

    inout fn methodRecvIsTrait(f: Func) -> Bool {
        if f.hasRecv {
            return self.traitModuleByIdArity(traitId: f.recvId, arity: f.provTraitArity) != 4000000000U64
        }
        return false
    }

    inout fn traitModuleByIdArity(traitId: U64, arity: U64) -> U64 {
        mut val i: U64 = 0
        while i < self.decls.traitOwners.count() {
            val t: TraitOwner = self.decls.traitOwners[i]
            if t.nameId == traitId {
                if t.arity == arity {
                    return self.moduleOf(offset: t.nameStart)
                }
            }
            i += 1
        }
        return 4000000000U64
    }

    inout fn traitDeclOffsetByIdArity(traitId: U64, arity: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            val t: TraitOwner = self.decls.traitOwners[i]
            if t.nameId == traitId && t.arity == arity {
                return t.nameStart
            }
            i += 1U64
        }
        return 0U64
    }

    inout fn traitNameLenByOwner(owner: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            if self.decls.traitOwners[i].nameStart == owner { return self.decls.traitOwners[i].nameLen }
            i += 1U64
        }
        return 0U64
    }

    // A selector reaches later passes as an interned span.  Only the canonical
    // declaration span is a trait identity there: an unresolved spelling must
    // never become a trait merely because another module happens to declare
    // the same text.
    inout fn canonicalTraitOwner(start: U64, len: U64) -> U64 {
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            val owner: TraitOwner = self.decls.traitOwners[i]
            if owner.nameStart == start && owner.nameLen == len { return owner.nameStart }
            i += 1U64
        }
        return 0U64
    }

    // Resolve a trait declaration inside one module.  TraitOwner is available
    // before trait bodies are lowered, so this is safe during impl lowering.
    inout fn traitOwnerInModule(mod: U64, start: U64, len: U64, arity: U64) -> U64 {
        val nameId: U64 = intern(c: inout self, start: start, len: len)
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            val t: TraitOwner = self.decls.traitOwners[i]
            if t.nameId == nameId && t.arity == arity && self.moduleOf(offset: t.nameStart) == mod {
                return t.nameStart
            }
            i += 1U64
        }
        return 0U64
    }

    // A public surface may forward a trait through any number of re-exports.
    // Resolve that forwarding before returning the declaration owner; a barrel
    // is never a new trait identity.
    inout fn traitOwnerFromSurface(surfaceMod: U64, start: U64, len: U64, arity: U64) -> U64 {
        val local: U64 = self.traitOwnerInModule(mod: surfaceMod, start: start, len: len, arity: arity)
        if local != 0U64 { return local }
        mut val i: U64 = 0U64
        while i < self.modules.reExportOrigins.count() {
            val origin: Bind = self.modules.reExportOrigins[i]
            if self.moduleOf(offset: origin.nameStart) == surfaceMod {
                if spansEqual(c: inout self, aStart: origin.nameStart, aLen: origin.nameLen, bStart: start, bLen: len) {
                    return self.traitOwnerFromSurface(surfaceMod: origin.fieldLen, start: origin.fieldStart, len: origin.nameId, arity: arity)
                }
            }
            i += 1U64
        }
        return 0U64
    }

    // Resolve a trait spelling at its authored use site once: lexical local
    // declaration, then the import surface (which may be a barrel), then its
    // declaration owner.  Traits are not ambient; absence of such a binding is
    // intentionally unresolved.
    inout fn traitOwnerAtUse(start: U64, len: U64, arity: U64) -> U64 {
        val useMod: U64 = self.moduleOf(offset: start)
        val local: U64 = self.traitOwnerInModule(mod: useMod, start: start, len: len, arity: arity)
        if local != 0U64 { return local }
        mut val i: U64 = 0U64
        i = 0U64
        while i < self.modules.importOrigins.count() {
            val origin: Bind = self.modules.importOrigins[i]
            if self.moduleOf(offset: origin.nameStart) == useMod {
                if spansEqual(c: inout self, aStart: origin.nameStart, aLen: origin.nameLen, bStart: start, bLen: len) {
                    return self.traitOwnerFromSurface(surfaceMod: origin.fieldLen, start: origin.fieldStart, len: origin.nameId, arity: arity)
                }
            }
            i += 1U64
        }
        return 0U64
    }

    // A selector has no written type arguments.  It may therefore name any
    // arity, but only when its visible surface identifies one declaration;
    // otherwise later source selection must diagnose the ambiguity.
    inout fn traitOwnerInModuleForSelector(mod: U64, start: U64, len: U64) -> U64 {
        val textId: U64 = intern(c: inout self, start: start, len: len)
        mut val found: U64 = 0U64
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            val t: TraitOwner = self.decls.traitOwners[i]
            if self.moduleOf(offset: t.nameStart) == mod && t.nameId == textId {
                if found != 0U64 && found != t.nameStart { return 0U64 }
                found = t.nameStart
            }
            i += 1U64
        }
        return found
    }

    inout fn traitOwnerFromSurfaceForSelector(surfaceMod: U64, start: U64, len: U64) -> U64 {
        val local: U64 = self.traitOwnerInModuleForSelector(mod: surfaceMod, start: start, len: len)
        if local != 0U64 { return local }
        mut val found: U64 = 0U64
        mut val i: U64 = 0U64
        while i < self.modules.reExportOrigins.count() {
            val origin: Bind = self.modules.reExportOrigins[i]
            if self.moduleOf(offset: origin.nameStart) == surfaceMod {
                if spansEqual(c: inout self, aStart: origin.nameStart, aLen: origin.nameLen, bStart: start, bLen: len) {
                    val owner: U64 = self.traitOwnerFromSurfaceForSelector(surfaceMod: origin.fieldLen, start: origin.fieldStart, len: origin.nameId)
                    if owner != 0U64 {
                        if found != 0U64 && found != owner { return 0U64 }
                        found = owner
                    }
                }
            }
            i += 1U64
        }
        return found
    }

    inout fn traitOwnerForSelector(siteOffset: U64, text: String) -> U64 {
        val useMod: U64 = self.moduleOf(offset: siteOffset)
        mut val found: U64 = 0U64
        mut val i: U64 = 0U64
        while i < self.decls.traitOwners.count() {
            val t: TraitOwner = self.decls.traitOwners[i]
            if self.moduleOf(offset: t.nameStart) == useMod && rangeEquals(bytes: self.arena.bytes, start: t.nameStart, len: t.nameLen, kw: text) {
                if found != 0U64 && found != t.nameStart { return 0U64 }
                found = t.nameStart
            }
            i += 1U64
        }
        if found != 0U64 { return found }
        i = 0U64
        while i < self.modules.importOrigins.count() {
            val origin: Bind = self.modules.importOrigins[i]
            if self.moduleOf(offset: origin.nameStart) == useMod && rangeEquals(bytes: self.arena.bytes, start: origin.nameStart, len: origin.nameLen, kw: text) {
                val owner: U64 = self.traitOwnerFromSurfaceForSelector(surfaceMod: origin.fieldLen, start: origin.fieldStart, len: origin.nameId)
                if owner != 0U64 {
                    if found != 0U64 && found != owner { return 0U64 }
                    found = owner
                }
            }
            i += 1U64
        }
        return found
    }

    inout fn traitModuleByOwner(owner: U64) -> U64 {
        if owner == 0U64 { return 4000000000U64 }
        return self.moduleOf(offset: owner)
    }

    inout fn traitArityMatches(actual: U64, expected: U64) -> Bool {
        if expected == 4000000000U64 {
            return true
        }
        return actual == expected
    }

    inout fn methodInRange(lo: U64, hi: U64, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        val qName: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = lo
        while i < hi {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn providedCopyTypeParams(recvStart: U64, recvLen: U64, ownParams: Array[Bind]) -> Array[Bind] {
        mut val out: Array[Bind] = []
        val qRecv: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val si: U64 = 0
        while si < self.arena.structs.count() {
            if self.arena.structs[si].typeParams.count() > 0 {
                if self.arena.structs[si].nameId == qRecv {
                    mut val k: U64 = 0
                    while k < self.arena.structs[si].typeParams.count() {
                        out.append(self.arena.structs[si].typeParams[k])
                        k += 1
                    }
                }
            }
            si += 1
        }
        mut val oi: U64 = 0
        while oi < ownParams.count() {
            out.append(ownParams[oi])
            oi += 1
        }
        return out
    }

    inout fn isBlanketConform(cf: Conform) -> Bool {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.recvId == cf.typeId {
                    mut val tp: U64 = 0
                    while tp < f.typeParams.count() {
                        if f.typeParams[tp].nameId == cf.typeId {
                            return true
                        }
                        tp += 1
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn conformExists(typeId: U64, traitId: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            if self.decls.conforms[i].typeId == typeId {
                if self.decls.conforms[i].traitId == traitId {
                    if self.decls.conforms[i].viewRootId == 0U64 {
                        return true
                    }
                }
            }
            i += 1
        }
        // a `newtype` inherits the underlying type's trait conformances automatically
        // (spec/10: methods, conformances, operators, factories). So `UserId = String`
        // satisfies `where T: Format` because String does — `print(u)` type-checks and
        // dispatches to String's witness (the newtype shares String's representation).
        mut val ni: U64 = 0
        while ni < self.arena.newtypes.count() {
            if self.arena.newtypes[ni].nameId == typeId {
                val underId: U64 = intern(c: inout self, start: self.arena.newtypes[ni].underStart, len: self.arena.newtypes[ni].underLen)
                return self.conformExists(typeId: underId, traitId: traitId)
            }
            ni += 1
        }
        return false
    }

    inout fn conformExistsTraitInstance(typeId: U64, traitId: U64, traitArgs: Array[U64], patternParams: Array[Bind]) -> Bool {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            if self.decls.conforms[i].typeId == typeId {
                if self.decls.conforms[i].traitId == traitId {
                    if self.traitInstanceArgsMatch(pattern: traitArgs, patternParams: patternParams, actual: self.decls.conforms[i].traitArgs) {
                        if self.decls.conforms[i].viewRootId == 0U64 {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        mut val ni: U64 = 0
        while ni < self.arena.newtypes.count() {
            if self.arena.newtypes[ni].nameId == typeId {
                val underId: U64 = intern(c: inout self, start: self.arena.newtypes[ni].underStart, len: self.arena.newtypes[ni].underLen)
                return self.conformExistsTraitInstance(typeId: underId, traitId: traitId, traitArgs: traitArgs, patternParams: patternParams)
            }
            ni += 1
        }
        return false
    }

    inout fn isExtName(start: U64, len: U64) -> Bool {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        if qId == 0U64 {
            return false
        }
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            if self.arena.funcs[i].extId == qId {
                return true
            }
            i += 1
        }
        // A conformance-only extension is still a named source surface.
        i = 0U64
        while i < self.decls.conforms.count() {
            if self.decls.conforms[i].extId == qId {
                return true
            }
            i += 1U64
        }
        return false
    }

    // Source applicability uses the complete receiver pattern when one is
    // available.  A named extension on `Box[I64]` must not make `Box[String]#X`
    // valid merely because both receivers share the `Box` head.
    inout fn extAppliesToType(extStart: U64, extLen: U64, typeStart: U64, typeLen: U64, typeRef: U64 = 0U64) -> Bool {
        val qExt: U64 = intern(c: inout self, start: extStart, len: extLen)
        val qType: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.extId == qExt {
                // A trait-receiver extension applies through a concrete value
                // only when that value conforms to the full trait instance.
                // Head-name equality (`B`) is not enough for B[I64] vs
                // B[String].
                if self.methodRecvIsTrait(f: f) && typeRef != 0U64 {
                    if self.conformsInstance(ref: typeRef, traitStart: f.recvStart, traitLen: f.recvLen, traitArgs: f.recvTraitArgs) {
                        return true
                    }
                }
                if f.recvId == qType {
                    if typeRef == 0U64 || f.recvTy == 0U64 {
                        return true
                    }
                    mut val binds: Array[UnifyBind] = []
                    if self.unifyPatterns(a: f.recvTy, aSide: 0U64, b: typeRef, bSide: 1U64, aParams: f.typeParams, bParams: [], binds: inout binds, ignoreTopView: true) {
                        return true
                    }
                }
            }
            i += 1
        }
        // A named extension may contribute only a conformance.  It is still a
        // real source surface: `value#Ext` is needed to expose that conformance
        // to a bound even when no member happens to be declared in the bundle.
        i = 0U64
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if cf.extId == qExt && cf.typeId == qType {
                if typeRef == 0U64 || cf.subjectTy == 0U64 {
                    return true
                }
                if self.conformanceSubjectMatches(cf: cf, typeRef: typeRef) {
                    return true
                }
            }
            i += 1U64
        }
        // a newtype inherits the underlying type's extensions (spec/10).
        mut val ni: U64 = 0
        while ni < self.arena.newtypes.count() {
            if self.arena.newtypes[ni].nameId == qType {
                return self.extAppliesToType(extStart: extStart, extLen: extLen, typeStart: self.arena.newtypes[ni].underStart, typeLen: self.arena.newtypes[ni].underLen)
            }
            ni += 1
        }
        return false
    }

    inout fn subjectPathCount(tId: U64, aTraitId: U64, aTraitArgs: Array[U64], patternParams: Array[Bind]) -> U64 {
        mut val count: U64 = 0
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            if !(cf.derived) && cf.extId == 0U64 {
                if cf.traitId == aTraitId && self.traitInstanceArgsMatch(pattern: aTraitArgs, patternParams: patternParams, actual: cf.traitArgs) {
                    if self.isTraitName(start: cf.typeStart, len: cf.typeLen) {
                        // cf is `impl B as A`; does tId conform to the subject trait B?
                        if self.conformExistsTraitInstance(typeId: tId, traitId: cf.typeId, traitArgs: cf.subjectArgs, patternParams: cf.typeParams) {
                            count += 1
                        }
                    }
                }
            }
            i += 1
        }
        return count
    }

    inout fn viewConformsTo(typeStart: U64, typeLen: U64, typeRef: U64, viewId: U64, traitStart: U64, traitLen: U64, traitArgs: Array[U64] = []) -> Bool {
        if viewId == 0U64 {
            return false
        }
        val typeId: U64 = intern(c: inout self, start: typeStart, len: typeLen)
        val targetId: U64 = intern(c: inout self, start: traitStart, len: traitLen)
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[i]
            // Direct `extension Ext { impl T as P }` conformances are view
            // facts too (not only trait-subject `impl B as A` edges).
            if cf.extId == viewId && cf.typeId == typeId && cf.traitId == targetId && self.conformanceMatchesTraitInstance(cf: cf, typeRef: typeRef, traitArgs: traitArgs) {
                if !(self.isTraitName(start: cf.typeStart, len: cf.typeLen)) {
                    return true
                }
            }
            val noParams: Array[Bind] = []
            if cf.traitId == targetId && self.traitInstanceArgsMatch(pattern: traitArgs, patternParams: noParams, actual: cf.traitArgs) {
                // cf must be a trait-subject conform (`impl B as A`) reachable via viewId:
                // a bare inter-trait conform whose subject trait is the view, or an
                // extension conform whose extId is the view.
                if self.isTraitName(start: cf.typeStart, len: cf.typeLen) {
                    mut val viaView: Bool = false
                    if cf.extId == 0U64 {
                        if cf.typeId == viewId {
                            viaView = true
                        }
                    } else {
                        if cf.extId == viewId {
                            viaView = true
                        }
                    }
                    if viaView {
                        // does the underlying type conform to the subject trait B?
                        if self.conformExistsTraitInstance(typeId: typeId, traitId: cf.typeId, traitArgs: cf.subjectArgs, patternParams: cf.typeParams) {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn instantiateTraitSubjectConforms() {
        // snapshot before any conferral: the dup guard and source-method scan must see
        // only originals, so sibling conferred copies coexist (multi-path ambiguity).
        val guardHi: U64 = self.arena.funcs.count()
        mut val changed: Bool = true
        while changed {
            val before: U64 = self.decls.conforms.count()
            // re-read the live count each pass: a conformance conferred earlier this pass
            // is a valid candidate for a later hop (transitivity).
            mut val ci: U64 = 0
            while ci < self.decls.conforms.count() {
                val cf: Conform = self.decls.conforms[ci]
                // a trait-subject conform: subject (typeStart,typeLen) names a trait B.
                // Skip extension conforms (`extension Ext { impl B as A }`, extId != 0):
                // those stay view-gated (`value#Ext`), handled by the extension machinery —
                // only an owner-module bare `impl B as A` auto-confers onto the bare surface.
                if cf.extId == 0U64 && self.isTraitName(start: cf.typeStart, len: cf.typeLen) {
                    // candidate concrete types: those conforming to the subject trait B.
                    mut val cj: U64 = 0
                    while cj < self.decls.conforms.count() {
                        val cand: Conform = self.decls.conforms[cj]
                        if cand.traitId == cf.typeId && self.traitInstanceArgsMatch(pattern: cf.subjectArgs, patternParams: cf.typeParams, actual: cand.traitArgs) {
                            if !(self.isTraitName(start: cand.typeStart, len: cand.typeLen)) {
                                // the view-root under which we confer A on T via this impl
                                // (spec/09 chain conflict). If the candidate conformance to B
                                // is already view-rooted (T reaches B only via #root), the
                                // chain stays rooted there — propagate it. Otherwise (T
                                // bare-conforms to B) a NEW root is born iff A is reached by T
                                // through more than one subject trait (multi-path): the root
                                // is THIS impl's subject. A single bare path → root 0 (bare).
                                mut val vr: U64 = cand.viewRootId
                                if vr == 0U64 {
                                    if self.subjectPathCount(tId: cand.typeId, aTraitId: cf.traitId, aTraitArgs: cf.traitArgs, patternParams: cf.typeParams) > 1U64 {
                                        vr = cf.typeId
                                    }
                                }
                                self.applyBlanketTo(blanket: cf, recvStart: cand.typeStart, recvLen: cand.typeLen, guardHi: guardHi, viewRoot: vr)
                            }
                        }
                        cj += 1
                    }
                }
                ci += 1
            }
            changed = self.decls.conforms.count() > before
        }
    }

    inout fn conferredCopyExists(recvId: U64, nameId: U64, srcTraitId: U64, srcTraitOwner: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.arena.funcs.count() {
            val f: Func = self.arena.funcs[i]
            if f.hasRecv {
                if f.recvId == recvId {
                    if f.nameId == nameId {
                        if f.srcTraitId == srcTraitId && f.srcTraitOwner == srcTraitOwner {
                            return true
                        }
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn conformWithRootExists(typeId: U64, traitId: U64, viewRootId: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.decls.conforms.count() {
            if self.decls.conforms[i].typeId == typeId {
                if self.decls.conforms[i].traitId == traitId {
                    if self.decls.conforms[i].viewRootId == viewRootId {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn applyBlanketTo(blanket: Conform, recvStart: U64, recvLen: U64, guardHi: U64, viewRoot: U64) {
        val recvId: U64 = intern(c: inout self, start: recvStart, len: recvLen)
        mut val srcTag: U64 = blanket.typeId
        if viewRoot != 0U64 {
            srcTag = viewRoot
        }
        mut val fi: U64 = 0
        while fi < guardHi {
            val f: Func = self.arena.funcs[fi]
            if f.hasRecv {
                if f.recvId == blanket.typeId {
                    // skip if the type already has an inherent method of this name
                    // (inherent wins); sibling conferred copies (appended ≥ guardHi) do
                    // not block, so multiple paths' methods coexist. Also skip if this
                    // exact path was already conferred (idempotent fixpoint re-scan).
                    if !(self.methodInRange(lo: 0, hi: guardHi, recvStart: recvStart, recvLen: recvLen, nameStart: f.nameStart, nameLen: f.nameLen)) && !(self.conferredCopyExists(recvId: recvId, nameId: f.nameId, srcTraitId: srcTag, srcTraitOwner: f.provTraitOwner)) {
                        // drop the subject param from the method's type params (none for a
                        // trait subject), keep the method-own params.
                        mut val copiedTP: Array[Bind] = []
                        mut val tp: U64 = 0
                        while tp < f.typeParams.count() {
                            if f.typeParams[tp].nameId != blanket.typeId {
                                copiedTP.append(f.typeParams[tp])
                            }
                            tp += 1
                        }
                        mut val providedOwnerMod: U64 = f.providedOwnerMod
                        if !(f.isPub) {
                            providedOwnerMod = self.traitModuleByOwner(owner: f.provTraitOwner)
                        }
                        val copyIdx: U64 = self.arena.funcs.count()
                        self.arena.funcs.append(<Func nameStart=f.nameStart nameLen=f.nameLen nameId=f.nameId recvId=recvId recvTraitArgs=f.recvTraitArgs typeParams=copiedTP params=f.params hasRet=f.hasRet retStart=f.retStart retLen=f.retLen retIsArray=f.retIsArray retTy=f.retTy body=f.body hasRecv=true recvStart=recvStart recvLen=recvLen selfInout=f.selfInout selfMove=f.selfMove isAssoc=f.isAssoc isAsync=f.isAsync isExtern=f.isExtern isPub=f.isPub isProvided=true srcTraitId=srcTag srcTraitOwner=f.provTraitOwner originTraitId=srcTag originTraitOwner=f.provTraitOwner originTraitArity=f.provTraitArity providedOwnerMod=providedOwnerMod provTraitArity=f.provTraitArity provTraitOwner=f.provTraitOwner viewOnly=(viewRoot != 0U64) defOffset=f.defOffset />)
                        self.registerCallable(funcIdx: copyIdx)
                    }
                }
            }
            fi += 1
        }
        if !(self.conformWithRootExists(typeId: recvId, traitId: blanket.traitId, viewRootId: viewRoot)) {
            self.decls.conforms.append(<Conform typeStart=recvStart typeLen=recvLen typeId=recvId traitStart=blanket.traitStart traitLen=blanket.traitLen traitId=blanket.traitId traitArgs=blanket.traitArgs derived=true witnessed=blanket.witnessed viewRootId=viewRoot defOffset=blanket.defOffset />)
        }
    }

    inout fn instantiateProvidedMethods() {
        val nFuncs: U64 = self.arena.funcs.count()
        mut val ci: U64 = 0
        while ci < self.decls.conforms.count() {
            val cf: Conform = self.decls.conforms[ci]
            // a view-rooted conform (spec/09 chain conflict) is reached only via
            // `value#root`; its trait's provided methods must not land on the bare
            // surface. The witness methods are already conferred (applyBlanketTo, tagged
            // for the view); skip the bare provided-method copy here.
            if cf.viewRootId != 0U64 {
                ci += 1
                continue
            }
            mut val fi: U64 = 0
            while fi < nFuncs {
                val f: Func = self.arena.funcs[fi]
                if f.hasRecv {
                    val copyOwnerMod: U64 = self.traitModuleByOwner(owner: cf.traitStart)
                    // match the conformance to the right same-name trait by arity (spec/08:
                    // trait names share a flat namespace — a user `trait Sub` vs Core's
                    // operator `Sub[Rhs]`). Without the arity gate a provided method on the
                    // 0-ary `Sub` would copy onto every type conforming to `Sub[Rhs]`.
                    if f.recvId == cf.traitId && f.provTraitArity == cf.traitArgs.count() && f.provTraitOwner == cf.traitStart && self.traitInstanceArgsMatch(pattern: f.recvTraitArgs, patternParams: f.typeParams, actual: cf.traitArgs) {
                        // Two conformed traits providing the same name both copy here, each tagged with
                        // its source trait (srcTraitId) — they coexist; bare `a.foo()` is
                        // then a use-site ambiguity (findMethod), while `a#P.foo()` selects
                        // the source trait (findExtMethod). An inherent same-name method is
                        // the bare default, but must not erase this explicit `#P` candidate.
                        // spec/08,09.
                            // a provided method copied onto a *generic* conformer inherits
                            // the conformer's type params (prepended), so methodMatchesInst
                            // emits it per receiver instantiation (`MapIter[Counter,…]`) like
                            // an inherent method. Onto a non-generic conformer this is a
                            // no-op (the conformer has no params).
                            val copiedTP: Array[Bind] = self.providedCopyTypeParams(recvStart: cf.typeStart, recvLen: cf.typeLen, ownParams: f.typeParams)
                            // preserve extId: a trait-subject extension method (spec/09
                            // `extension Ext { impl Trait { … } }`) stays view-gated on the
                            // conformer, reached via `value#Ext.m()` not a bare call.
                            mut val providedOwnerMod: U64 = 4000000000U64
                            if !(f.isPub) {
                                providedOwnerMod = copyOwnerMod
                            }
                            val copyIdx: U64 = self.arena.funcs.count()
                            self.arena.funcs.append(<Func nameStart=f.nameStart nameLen=f.nameLen nameId=f.nameId recvId=intern(c: inout self, start: cf.typeStart, len: cf.typeLen) recvTy=cf.subjectTy recvTraitArgs=f.recvTraitArgs typeParams=copiedTP params=f.params hasRet=f.hasRet retStart=f.retStart retLen=f.retLen retIsArray=f.retIsArray retTy=f.retTy body=f.body hasRecv=true recvStart=cf.typeStart recvLen=cf.typeLen selfInout=f.selfInout selfMove=f.selfMove isAssoc=f.isAssoc isAsync=f.isAsync isExtern=f.isExtern isPub=f.isPub isProvided=true srcTraitId=cf.traitId srcTraitOwner=cf.traitStart originTraitId=cf.traitId originTraitOwner=cf.traitStart originTraitArity=cf.traitArgs.count() providedOwnerMod=providedOwnerMod extId=f.extId provTraitArity=f.provTraitArity provTraitOwner=f.provTraitOwner defOffset=f.defOffset />)
                            self.registerCallable(funcIdx: copyIdx)
                    }
                }
                fi += 1
            }
            ci += 1
        }
    }

    inout fn structIndexByName(start: U64, len: U64) -> U64 {
        // a use of an import alias (`with { Real as Alias }`) resolves to the real name.
        val ar: Bind = self.aliasReal(start: start, len: len)
        val qId: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        mut val i: U64 = 0
        while i < self.arena.structs.count() {
            val s: StructDef = self.arena.structs[i]
            if s.typeParams.count() == 0 {
                if s.nameId == qId {
                    return i
                }
            }
            i += 1
        }
        return self.arena.structs.count()
    }

    // Like `structIndexByName` but ALSO matches a GENERIC struct def (`Array`, `Buffer`'s
    // user-side wrappers, any `struct Foo[T]`) — the structural ARC queries (valueArc /
    // arcNeedsRelease / structNeedsDeinit) resolve a generic struct VALUE by its type
    // name to enumerate its fields, with the instance env supplied separately (setStructEnv)
    // for grounding. `structIndexByName` intentionally excludes generics (concrete-struct
    // codegen routes those through the genStruct instance machinery); this is its any-arity
    // sibling for the field-recursion ARC paths. Name ids are unique, so a name matches one def.
    inout fn structDefByNameAny(start: U64, len: U64) -> U64 {
        val ar: Bind = self.aliasReal(start: start, len: len)
        val qId: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        mut val i: U64 = 0
        while i < self.arena.structs.count() {
            if self.arena.structs[i].nameId == qId {
                return i
            }
            i += 1
        }
        return self.arena.structs.count()
    }

    inout fn enumIdxByName(start: U64, len: U64) -> U64 {
        // an import alias (`with { Real as Alias }`) names the same enum as `Real` (spec/15).
        val ar: Bind = self.aliasReal(start: start, len: len)
        val q: U64 = intern(c: inout self, start: ar.nameStart, len: ar.nameLen)
        mut val i: U64 = 0
        while i < self.arena.enums.count() {
            if self.arena.enums[i].nameId == q {
                return i
            }
            i += 1
        }
        return self.arena.enums.count()
    }

    // enumIdxByName restricted to a CONCRETE (0-type-param) declaration — the backend's
    // bare-name TypeRef recovery sites (param / capture / payload bind / receiver) test
    // "is this name a plain enum" with this: a bare GENERIC head must not become an
    // argless TypeRef (it grounds to nothing and poisons downstream type reads).
    inout fn concreteEnumIdxByName(start: U64, len: U64) -> U64 {
        val i: U64 = self.enumIdxByName(start: start, len: len)
        if i < self.arena.enums.count() {
            if self.arena.enums[i].typeParams.count() == 0U64 {
                return i
            }
        }
        return self.arena.enums.count()
    }

    inout fn findTraitIdxByName(start: U64, len: U64) -> U64 {
        val qId: U64 = intern(c: inout self, start: start, len: len)
        mut val ti: U64 = 0
        while ti < self.decls.traits.count() {
            if self.decls.traits[ti].nameId == qId {
                return ti
            }
            ti += 1
        }
        return self.decls.traits.count()
    }

    inout fn addFnThunk(fi: U64) {
        mut val i: U64 = 0
        while i < self.monoWork.fnThunks.count() {
            if self.monoWork.fnThunks[i] == fi {
                return
            }
            i += 1
        }
        self.monoWork.fnThunks.append(fi)
    }

    inout fn collectFnThunks() {
        mut val i: U64 = 0
        while i < self.arena.exprs.count() {
            match self.arena.exprs[i] {
                Expr.Ident(val start, val len) => {
                    val fvi: U64 = self.firstFuncByName(nameStart: start, nameLen: len)
                    if fvi < self.arena.funcs.count() {
                        val f: Func = self.arena.funcs[fvi]
                        if !(f.hasRecv) {
                            if !(f.isAssoc) {
                                if f.typeParams.count() > 0 {
                                    // a generic free fn has no bare symbol (it is emitted
                                    // per instantiation) — not supported as a value yet.
                                } else {
                                    self.addFnThunk(fi: fvi)
                                }
                            }
                        }
                    }
                }
                _ => {}
            }
            i += 1
        }
    }

    inout fn isBoxedCaptureOf(closureId: U64, start: U64, len: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.monoWork.captures.count() {
            val e: CaptureEntry = self.monoWork.captures[i]
            if e.closureId == closureId {
                if e.boxed {
                    if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
                        return true
                    }
                }
            }
            i += 1
        }
        return false
    }

    inout fn isCaptureOf(closureId: U64, start: U64, len: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.monoWork.captures.count() {
            val e: CaptureEntry = self.monoWork.captures[i]
            if e.closureId == closureId {
                if spansEqual(c: inout self, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
                    return true
                }
            }
            i += 1
        }
        return false
    }
}
