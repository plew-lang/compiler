// Default expressions are independent full expressions (spec/04). Their
// implementation declarations share the owner's lexical type/proof environment,
// but take no value parameters and never capture `self` or another argument.
// They are deliberately absent from the source callable surface.
pub impl Comp {
    // The frontier is frozen: newly appended zero-argument generator calls
    // are already complete and must not turn this walk into a growing queue.
    // Return the incomplete count so the pipeline cannot mistake a partial
    // completion for readiness to close its call graph.
    inout fn completeRecordedDefaultCalls() -> Result[U64, CompileDiagnostic] {
        val limit = self.decls.callTemplates.count()
        mut val incomplete: U64 = 0U64
        mut val index: U64 = 0U64
        while index < limit {
            tracePhaseProgress(c: inout self, label: "default-call-completion:template", count: index, stride: 64U64)
            val template = self.decls.callTemplates[index]
            match template.kind {
                CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                    if !(try self.completeRecordedDirectDefaults(templateIndex: index, receiverTerm: template.receiverTypeTerm)) {
                        incomplete += 1U64
                        tracePhaseCount(c: inout self, label: "default-call-completion:incomplete-callee", count: callee)
                        tracePhaseCount(c: inout self, label: "default-call-completion:incomplete-owner", count: template.siteKey.ownerFnIdx)
                    }
                }
                _ => {}
            }
            index += 1U64
        }
        return <Result.Ok value=incomplete />
    }

    // Complete an already selected call after Record has joined its argument
    // and expected-result evidence. `receiverTerm` is the recorded receiver
    // recipe's result in the caller environment, never a fresh name lookup.
    // The parent row is published only once every parameter has an operand.
    inout fn completeRecordedDirectDefaults(templateIndex: U64, receiverTerm: U64) -> Result[Bool, CompileDiagnostic] {
        if templateIndex >= self.decls.callTemplates.count() { return <Result.Ok value=false />}
        val template = self.decls.callTemplates[templateIndex]
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: val receiver, args: val arguments, calleeTypeArgs: val typeArgs, proofId: val proofId) => {
                if callee >= self.arena.functionCount() { return <Result.Ok value=false />}
                val function = self.arena.functionAt(index: callee)
                val argumentValues: Array[CallTemplateArgument] = self.callTemplateArguments(range: arguments)
                val typeArgValues: Array[U64] = self.callTemplateTypeArgs(range: typeArgs)
                if argumentValues.count() != arguments.len || typeArgValues.count() != typeArgs.len { return <Result.Ok value=false />}
                // This also makes completion idempotent: the saved ordinary
                // default calls are not reclassified as omitted arguments.
                if argumentValues.count() == function.params.count() { return <Result.Ok value=true />}
                if argumentValues.count() > function.params.count() || self.decls.defaultGeneratorRanges.count() == 0U64 { return <Result.Ok value=false />}
                if typeArgValues.count() != function.typeParams.count() { return <Result.Ok value=false />}
                // Empty substitutions are complete for a zero-binder callable.
                // The inference helper also uses empty to mean no inference.
                if typeArgValues.count() > 0U64 && !self.fnArgsAllResolved(args: typeArgValues) { return <Result.Ok value=false />}
                if (function.hasRecv || function.isAssoc) && receiverTerm == 0U64 { return <Result.Ok value=false />}
                val proof: StaticConformanceProof = self.thawStaticConformanceProof(id: proofId)
                val environment = (try self.bodyInstanceEnvironment(fnIdx: callee, args: typeArgValues, recvInstRef: receiverTerm, selectedProof: proof))
                val item = (try self.bodyProvidedItemTerm(f: function, environment: environment))
                mut val parameterTerms: Array[U64] = []
                mut val index: U64 = 0U64
                while index < function.params.count() {
                    val parameter = self.funcParamAt(params: function.params, index: index)
                    parameterTerms.append((try self.groundTermForBody(ref: parameter.ty, environment: environment, selfRef: environment.receiverRef, itemRef: item)))
                    index += 1U64
                }
                // Source local resolution has ended. Install only the owner
                // used to key synthetic calls; never rebuild lexical locals.
                val previousOwner = self.cur.checkFn
                val previousRecording = self.cur.recordCallTemplates
                self.cur.checkFn = template.siteKey.ownerFnIdx
                self.cur.recordCallTemplates = true
                val completed = (try self.recordBoundCallArguments(callee: callee, args: argumentValues, receiver: receiver, calleeTypeArgs: typeArgValues, parameterTerms: parameterTerms, proof: environment.proof, receiverTypeTerm: receiverTerm))
                self.cur.checkFn = previousOwner
                self.cur.recordCallTemplates = previousRecording
                match completed {
                    Optional.Some(v: val args) => {
                        self.decls.callTemplates.set(i: templateIndex, value: <CallTemplate resultTypeRecipe=template.resultTypeRecipe siteKey=template.siteKey expectedResultTerm=template.expectedResultTerm receiverTypeTerm=template.receiverTypeTerm kind=<CallTemplateKind.Direct callee=callee receiver=receiver args=self.publishCallTemplateArguments(args: args) calleeTypeArgs=self.publishCallTemplateTypeArgs(args: typeArgValues) proofId=proofId /> />)
                        return <Result.Ok value=true />
                    }
                    Optional.None => { return <Result.Ok value=false />}
                }
            }
            _ => { return <Result.Ok value=false />}
        }
    }

    // Convert the selected parameter binding into the one argument sequence
    // consumed by finalization and Mid. Signature terms/substitutions arrive
    // from the caller's completed parametric selection, not from AST recovery.
    // An incomplete binding/signature does not publish a partial argument list.
    inout fn recordBoundCallArguments(callee: U64, args: Array[CallTemplateArgument], receiver: CallTemplateReceiver, calleeTypeArgs: Array[U64], parameterTerms: Array[U64], previous: Array[CallTemplateArgument] = [], proof: StaticConformanceProof = <StaticConformanceProof.Missing />, receiverTypeTerm: U64 = 0U64) -> Result[Optional[Array[CallTemplateArgument]], CompileDiagnostic] {
        mut val bindings: Array[CallParameterBinding] = []
        match self.bindCallParameters(callee: callee, args: self.templateArgumentRangeFromValues(arguments: args)) {
            Optional.Some(val v) => { bindings = v }
            Optional.None => {
                tracePhase(c: inout self, label: "default-call-completion:binding-unresolved")
                return <Result.Ok value=<Optional.None /> />
            }
        }
        if parameterTerms.count() != bindings.count() { return <Result.Ok value=<Optional.None /> />}
        // Check all required result terms before creating any call occurrence.
        mut val generatorArgs: Array[U64] = []
        mut val hasGeneratorArgs: Bool = false
        mut val index: U64 = 0U64
        while index < bindings.count() {
            match bindings[index] {
                CallParameterBinding.Default(val generator) => {
                    if parameterTerms[index] == 0U64 || parameterTerms[index] >= self.arena.typeCount() {
                        tracePhaseCount(c: inout self, label: "default-call-completion:invalid-parameter-term", count: parameterTerms[index])
                        return <Result.Ok value=<Optional.None /> />
                    }
                    // Every default of this callable shares one lexical binder
                    // environment. Project it once, not once per parameter.
                    if !hasGeneratorArgs {
                        match self.defaultGeneratorTypeArguments(callee: callee, generator: generator, args: calleeTypeArgs) {
                            Optional.Some(val v) => { generatorArgs = v }
                            Optional.None => { return <Result.Ok value=<Optional.None /> />}
                        }
                        hasGeneratorArgs = true
                    }
                }
                _ => {}
            }
            index += 1U64
        }
        val parameters: FuncParamRange = self.arena.functionAt(index: callee).params
        mut val completed: Array[CallTemplateArgument] = []
        index = 0U64
        while index < bindings.count() {
            match bindings[index] {
                CallParameterBinding.Explicit(val argumentIndex) => {
                    // Record already resolved lexical local identity and call
                    // dependencies. Completion has no lexical cursor and must
                    // not reconstruct these facts from the source expression.
                    completed.append(args[argumentIndex])
                }
                CallParameterBinding.Default(val generator) => {
                    mut val existing: U64 = self.arena.exprs.count()
                    if index < previous.count() {
                        match previous[index].source {
                            CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: val siteKey) => {
                                val template: CallTemplate = self.callTemplateForSourceBody(fnIdx: self.cur.checkFn, exprId: exprId)
                                if self.sameCallSiteKey(a: template.siteKey, b: siteKey) {
                                    match template.kind {
                                        CallTemplateKind.Direct(callee: val priorCallee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                                            if priorCallee == generator { existing = exprId }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    val call: U64 = (try self.recordDefaultArgumentCall(generator: generator, receiver: receiver, calleeTypeArgs: generatorArgs, resultTerm: parameterTerms[index], existingExpr: existing, proof: proof, receiverTypeTerm: receiverTypeTerm))
                    val parameter: Param = self.funcParamAt(params: parameters, index: index)
                    completed.append(<CallTemplateArgument source=self.callArgumentSource(exprId: call) isInout=false labelStart=parameter.nameStart labelLen=parameter.nameLen hasLabel=!parameter.noLabel />)
                }
            }
            index += 1U64
        }
        return <Result.Ok value=<Optional.Some v=completed /> />
    }

    // A default slot evaluates an ordinary, declaration-selected zero-argument
    // function. Its result is represented by the same PriorCallResult source
    // as a written nested call. The parent retains the returned expression in
    // its completed argument list; re-recording that slot reuses its identity,
    // while a different call occurrence allocates a fresh synthetic origin.
    // `resultTerm` and substitutions are already expressed in the caller's
    // parametric environment. This method performs no inference/name lookup.
    inout fn recordDefaultArgumentCall(generator: U64, receiver: CallTemplateReceiver, calleeTypeArgs: Array[U64], resultTerm: U64, existingExpr: U64, proof: StaticConformanceProof = <StaticConformanceProof.Missing />, receiverTypeTerm: U64 = 0U64) -> Result[U64, CompileDiagnostic] {
        if !self.cur.recordCallTemplates || generator >= self.arena.functionCount() {
            return <Result.Err error=self.diagnosticAt(offset: 0U64, msg: "internal error: default argument call requires a selected generator during Record") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        val function: Func = self.arena.functionAt(index: generator)
        if function.params.count() != 0U64 || function.hasRecv {
            return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "internal error: default argument generator captures value parameters") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        mut val call: U64 = existingExpr
        val noArgs: ArgRange = self.pushArgs(args: [])
        if call < self.arena.exprs.count() {
            val previous: CallTemplate = self.callTemplateForSourceBody(fnIdx: self.cur.checkFn, exprId: call)
            mut val matches: Bool = false
            match previous.kind {
                CallTemplateKind.Direct(callee: val callee, receiver: _, args: val args, calleeTypeArgs: _, proofId: _) => {
                    matches = callee == generator && args.len == 0U64
                }
                _ => {}
            }
            if !matches {
                return <Result.Err error=self.diagnosticAt(offset: function.defOffset, msg: "internal error: default argument evaluation identity changed") />
                return <Result.Ok value=self.arena.exprs.count() />
            }
        } else {
            call = self.pushExpr(e: <Expr.Call nameStart=function.nameStart nameLen=function.nameLen args=noArgs />)
            self.recordSyntheticCallSite(site: <SyntheticCallSite exprId=call originSerial=self.arena.exprOriginSerial[call] receiverTerm=0U64 />)
        }
        try self.recordSemanticExprCall(exprId: call, callee: generator, receiver: receiver, args: noArgs, calleeTypeArgs: calleeTypeArgs, resultTerm: resultTerm, proof: proof, receiverTypeTerm: receiverTypeTerm)
        return <Result.Ok value=call />
    }

    // Bind only after selecting the declaration. Keep the authored arguments
    // intact, but produce one entry per parameter in evaluation order. A single
    // monotone walk also rejects leftover/duplicate/out-of-order arguments.
    // None is an incomplete decision, never permission for a consumer to fill
    // missing operands by reopening the default expression in caller scope.
    inout fn bindCallParameters(callee: U64, args: ArgRange) -> Optional[Array[CallParameterBinding]] {
        if callee >= self.arena.functionCount() { return <Optional.None /> }
        val parameters: FuncParamRange = self.arena.functionAt(index: callee).params
        mut val bindings: Array[CallParameterBinding] = []
        mut val argumentIndex: U64 = 0U64
        mut val parameterIndex: U64 = 0U64
        while parameterIndex < parameters.count() {
            val parameter: Param = self.funcParamAt(params: parameters, index: parameterIndex)
            mut val explicit: Bool = false
            if argumentIndex < args.len {
                explicit = self.argMatchesParamLabel(param: parameter, arg: self.argAt(args: args, index: argumentIndex))
            }
            if explicit {
                bindings.append(<CallParameterBinding.Explicit argumentIndex=argumentIndex />)
                argumentIndex += 1U64
            } else {
                if !parameter.hasDefault { return <Optional.None /> }
                val generator: U64 = self.defaultArgumentGenerator(ownerFnIdx: callee, parameterIndex: parameterIndex)
                if generator >= self.arena.functionCount() { return <Optional.None /> }
                bindings.append(<CallParameterBinding.Default generator=generator />)
            }
            parameterIndex += 1U64
        }
        if argumentIndex != args.len { return <Optional.None /> }
        return <Optional.Some v=bindings />
    }

    fn defaultArgumentGenerator(ownerFnIdx: U64, parameterIndex: U64) -> U64 {
        if ownerFnIdx >= self.decls.defaultGeneratorRanges.count() { return self.arena.functionCount() }
        val range: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[ownerFnIdx]
        if parameterIndex >= range.len { return self.arena.functionCount() }
        val functionId: U64 = self.decls.defaultGeneratorFunctions[range.start + parameterIndex]
        if functionId == 0U64 { return self.arena.functionCount() }
        return functionId - 1U64
    }

    // Placed provided copies prepend receiver binders to the source method's
    // binders. A source-owned generator retains only its lexical signature;
    // positional truncation would substitute the receiver argument for T.
    inout fn defaultGeneratorTypeArguments(callee: U64, generator: U64, args: Array[U64]) -> Optional[Array[U64]] {
        if callee >= self.arena.functionCount() || generator >= self.arena.functionCount() { return <Optional.None /> }
        val source: FuncBindRange = self.arena.functionAt(index: callee).typeParams
        val target: FuncBindRange = self.arena.functionAt(index: generator).typeParams
        if args.count() != source.count() { return <Optional.None /> }
        if source.start == target.start && source.len == target.len { return <Optional.Some v=args /> }
        mut val projected: Array[U64] = []
        mut val index: U64 = 0U64
        while index < target.count() {
            val parameter: Bind = self.funcBindAt(binds: target, index: index)
            if parameter.paramId == 0U64 { return <Optional.None /> }
            mut val value: U64 = 0U64
            mut val matches: U64 = 0U64
            mut val candidate: U64 = 0U64
            while candidate < source.count() {
                if self.funcBindAt(binds: source, index: candidate).paramId == parameter.paramId {
                    value = args[candidate]
                    matches += 1U64
                }
                candidate += 1U64
            }
            if matches != 1U64 || value == 0U64 { return <Optional.None /> }
            projected.append(value)
            index += 1U64
        }
        return <Optional.Some v=projected />
    }

    // Field defaults have the same independent full-expression contract as
    // parameter defaults. Keep the original struct ParamIds, including binders
    // absent from the result type; each construction supplies the full instance.
    inout fn prepareFieldDefaultGenerators() {
        if self.decls.fieldDefaultGeneratorRanges.count() != 0U64 { return }
        val limit: U64 = self.arena.structCount()
        mut val structIndex: U64 = 0U64
        while structIndex < limit {
            val source: StructDef = self.arena.structAt(index: structIndex)
            val start: U64 = self.decls.fieldDefaultGeneratorFunctions.count()
            val binders: FuncBindRange = self.pushFuncBinds(binds: source.typeParams)
            mut val fieldIndex: U64 = 0U64
            while fieldIndex < source.fields.count() {
                val field: FieldDef = source.fields[fieldIndex]
                mut val functionId: U64 = 0U64
                if field.hasDefault {
                    val functionIndex: U64 = self.arena.functionCount()
                    val name: Bind = self.internTmpName(prefix: "$fieldDefault", n: functionIndex)
                    val returned: U64 = self.pushStmt(s: <Stmt.Return value=field.defaultVal hasValue=true offset=field.nameStart />)
                    val body: U64 = self.pushBlock(stmts: [returned])
                    self.arena.registerFunction(<Func
                        nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId
                        typeParams=binders
                        hasRet=true retStart=field.tyStart retLen=field.tyLen
                        retIsArray=field.tyIsArray retTy=field.ty body=body
                        hasRecv=false recvStart=0U64 recvLen=0U64
                        selfInout=false selfMove=false isAssoc=false
                        isAsync=false isExtern=false defOffset=source.defOffset />)
                    functionId = functionIndex + 1U64
                }
                self.decls.fieldDefaultGeneratorFunctions.append(functionId)
                fieldIndex += 1U64
            }
            self.decls.fieldDefaultGeneratorRanges.append(<DefaultGeneratorRange start=start len=source.fields.count() />)
            structIndex += 1U64
        }
    }

    fn recordsFieldDefault(field: MakeField) -> Bool {
        if !self.cur.recordCallTemplates || self.decls.fieldDefaultGeneratorRanges.count() == 0U64 { return false }
        match field.origin {
            MakeFieldOrigin.DeclarationDefault => { return true }
            _ => { return false }
        }
    }

    inout fn recordFieldDefaultCall(field: MakeField, instance: U64, resultTerm: U64) -> Result[U64, CompileDiagnostic] {
        if instance == 0U64 || instance >= self.arena.typeCount() {
            return <Result.Err error=self.diagnosticAt(offset: field.offset, msg: "internal error: field default has no selected construction instance") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        val instanceType: TypeRef = self.arena.typeAt(index: instance)
        val structIndex: U64 = self.anyStructIndex(nameStart: instanceType.nameStart, nameLen: instanceType.nameLen)
        val fieldIndex: U64 = self.fieldIndexOfReceiver(receiverRef: instance, fieldStart: field.nameStart, fieldLen: field.nameLen)
        if structIndex >= self.decls.fieldDefaultGeneratorRanges.count() {
            return <Result.Err error=self.diagnosticAt(offset: field.offset, msg: "internal error: field default has no declaration owner") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        val range: DefaultGeneratorRange = self.decls.fieldDefaultGeneratorRanges[structIndex]
        if fieldIndex >= range.len {
            return <Result.Err error=self.diagnosticAt(offset: field.offset, msg: "internal error: field default has no declaration slot") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        val functionId: U64 = self.decls.fieldDefaultGeneratorFunctions[range.start + fieldIndex]
        if functionId == 0U64 {
            return <Result.Err error=self.diagnosticAt(offset: field.offset, msg: "internal error: field default has no selected generator") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        val generator: U64 = functionId - 1U64
        val arguments: Array[U64] = self.copyTypeTermArgs(ref: instance)
        if arguments.count() != self.arena.functionAt(index: generator).typeParams.count() {
            return <Result.Err error=self.diagnosticAt(offset: field.offset, msg: "internal error: field default instance has incomplete type arguments") />
            return <Result.Ok value=self.arena.exprs.count() />
        }
        // The authored expression belongs only to the generator. A previously
        // completed occurrence retains its own synthetic call identity.
        mut val existing: U64 = self.arena.exprs.count()
        if field.value != self.arena.structFieldAt(structIndex: structIndex, fieldIndex: fieldIndex).defaultVal {
            existing = field.value
        }
        return <Result.Ok value=(try self.recordDefaultArgumentCall(generator: generator, receiver: <CallTemplateReceiver.None />, calleeTypeArgs: arguments, resultTerm: resultTerm, existingExpr: existing)) />
    }

    // Prepare before semantic recording, after checking the authored defaults.
    // The caller must transfer default-expression ownership to these bodies
    // when enabling this phase; recording the same expression as both a parent
    // default and a generator body would give it conflicting local identities.
    inout fn prepareDefaultArgumentGenerators() -> Result[(), CompileDiagnostic] {
        if self.decls.defaultGeneratorRanges.count() != 0U64 { return <Result.Ok value=() /> }
        val declarationLimit: U64 = self.arena.functionCount()
        val boundLimit: U64 = self.decls.funcBounds.count()
        mut val owners: Array[U64] = []
        mut val owner: U64 = 0U64
        while owner < declarationLimit {
            val source: Func = self.arena.functionAt(index: owner)
            val lexicalOwner: U64 = self.semanticBodyOwner(fnIdx: owner)
            owners.append(lexicalOwner)
            val start: U64 = self.decls.defaultGeneratorFunctions.count()
            mut val parameterIndex: U64 = 0U64
            while parameterIndex < source.params.count() {
                val parameter: Param = self.funcParamAt(params: source.params, index: parameterIndex)
                mut val functionId: U64 = 0U64
                if parameter.hasDefault && lexicalOwner == owner {
                    val generator: U64 = self.createDefaultArgumentGenerator(ownerFnIdx: owner, parameter: parameter)
                    functionId = generator + 1U64
                }
                self.decls.defaultGeneratorFunctions.append(functionId)
                parameterIndex += 1U64
            }
            self.decls.defaultGeneratorRanges.append(<DefaultGeneratorRange start=start len=source.params.count() />)
            owner += 1U64
        }
        // All canonical rows exist before resolving aliases, including a
        // placed copy which precedes its source declaration in the table.
        owner = 0U64
        while owner < declarationLimit {
            val lexicalOwner: U64 = owners[owner]
            if lexicalOwner != owner {
                val destination: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[owner]
                val source: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[lexicalOwner]
                if destination.len != source.len {
                    return <Result.Err error=self.diagnosticAt(offset: self.arena.functionAt(index: owner).defOffset, msg: "internal error: provided default parameter shape differs from its source") />
                }
                mut val parameterIndex: U64 = 0U64
                while parameterIndex < destination.len {
                    self.decls.defaultGeneratorFunctions.set(i: destination.start + parameterIndex, value: self.decls.defaultGeneratorFunctions[source.start + parameterIndex])
                    parameterIndex += 1U64
                }
            }
            owner += 1U64
        }
        self.copyDefaultGeneratorBounds(boundLimit: boundLimit, owners: owners)
        return <Result.Ok value=() />
    }

    // Walk authored bounds once, not once per generator. Each relevant row is
    // copied to the generator's function identity, retaining canonical binders.
    inout fn copyDefaultGeneratorBounds(boundLimit: U64, owners: Array[U64]) {
        mut val index: U64 = 0U64
        while index < boundLimit {
            val bound: FuncBound = self.decls.funcBounds[index]
            if bound.fnIdx < owners.count() && owners[bound.fnIdx] == bound.fnIdx {
                val range: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[bound.fnIdx]
                mut val parameterIndex: U64 = 0U64
                while parameterIndex < range.len {
                    val functionId: U64 = self.decls.defaultGeneratorFunctions[range.start + parameterIndex]
                    if functionId != 0U64 {
                        self.decls.funcBounds.append(<FuncBound fnIdx=functionId - 1U64 paramStart=bound.paramStart paramLen=bound.paramLen paramTy=bound.paramTy paramNameId=bound.paramNameId constraint=bound.constraint />)
                    }
                    parameterIndex += 1U64
                }
            }
            index += 1U64
        }
    }

    inout fn createDefaultArgumentGenerator(ownerFnIdx: U64, parameter: Param) -> U64 {
        val source: Func = self.arena.functionAt(index: ownerFnIdx)
        mut val lexicalOwner: U64 = source.lexicalOwnerFnId
        if lexicalOwner == 0U64 { lexicalOwner = ownerFnIdx + 1U64 }
        val functionIdx: U64 = self.arena.functionCount()
        // This spelling is diagnostic/mangling only. Selection uses the
        // owner/parameter table above, never a source-visible name lookup.
        val name: Bind = self.internTmpName(prefix: "$defaultArgument", n: functionIdx)
        val returned: U64 = self.pushStmt(s: <Stmt.Return value=parameter.defaultExpr hasValue=true offset=parameter.nameStart />)
        val body: U64 = self.pushBlock(stmts: [returned])
        val generator: Func = <Func
            nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId
            lexicalOwnerFnId=lexicalOwner
            typeParams=source.typeParams
            hasRet=true retStart=parameter.tyStart retLen=parameter.tyLen
            retIsArray=parameter.tyIsArray retTy=parameter.ty body=body
            hasRecv=false recvStart=source.recvStart recvLen=source.recvLen
            recvId=source.recvId recvTy=source.recvTy
            recvPatternParams=source.recvPatternParams recvTraitArgs=source.recvTraitArgs
            selfInout=false selfMove=false isAssoc=source.hasRecv || source.isAssoc
            isAsync=false isExtern=false
            extId=source.extId srcTraitId=source.srcTraitId srcTraitOwner=source.srcTraitOwner
            originTraitId=source.originTraitId originTraitOwner=source.originTraitOwner
            originTraitArity=source.originTraitArity originConformIdx=source.originConformIdx
            sourceConformIdx=source.sourceConformIdx providedOwnerMod=source.providedOwnerMod
            provTraitArity=source.provTraitArity provTraitOwner=source.provTraitOwner
            defOffset=source.defOffset />
        self.arena.registerFunction(generator)
        return functionIdx
    }
}
