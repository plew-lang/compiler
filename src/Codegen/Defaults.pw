// Default expressions are independent full expressions (spec/04). Their
// implementation declarations share the owner's lexical type/proof environment,
// but take no value parameters and never capture `self` or another argument.
// They are deliberately absent from the source callable surface.
pub impl Comp {
    // Convert the selected parameter binding into the one argument sequence
    // consumed by finalization and Mid. Signature terms/substitutions arrive
    // from the caller's completed parametric selection, not from AST recovery.
    // An incomplete binding/signature does not publish a partial argument list.
    inout fn recordBoundCallArguments(callee: U64, args: ArgRange, receiver: CallTemplateReceiver, calleeTypeArgs: Array[U64], parameterTerms: Array[U64], previous: Array[CallTemplateArgument] = [], proof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> Optional[Array[CallTemplateArgument]] {
        mut val bindings: Array[CallParameterBinding] = []
        match self.bindCallParameters(callee: callee, args: args) {
            Optional.Some(val v) => { bindings = v }
            Optional.None => { return <Optional.None /> }
        }
        if parameterTerms.count() != bindings.count() { return <Optional.None /> }
        // Check all required result terms before creating any call occurrence.
        mut val generatorArgs: Array[U64] = []
        mut val hasGeneratorArgs: Bool = false
        mut val index: U64 = 0U64
        while index < bindings.count() {
            match bindings[index] {
                CallParameterBinding.Default(val generator) => {
                    if parameterTerms[index] == 0U64 || parameterTerms[index] >= self.arena.types.count() { return <Optional.None /> }
                    // Every default of this callable shares one lexical binder
                    // environment. Project it once, not once per parameter.
                    if !hasGeneratorArgs {
                        match self.defaultGeneratorTypeArguments(callee: callee, generator: generator, args: calleeTypeArgs) {
                            Optional.Some(val v) => { generatorArgs = v }
                            Optional.None => { return <Optional.None /> }
                        }
                        hasGeneratorArgs = true
                    }
                }
                _ => {}
            }
            index += 1U64
        }
        val parameters: FuncParamRange = self.arena.funcs[callee].params
        mut val completed: Array[CallTemplateArgument] = []
        index = 0U64
        while index < bindings.count() {
            match bindings[index] {
                CallParameterBinding.Explicit(val argumentIndex) => {
                    val argument: Arg = self.argAt(args: args, index: argumentIndex)
                    completed.append(<CallTemplateArgument source=self.callArgumentSource(exprId: argument.expr) isInout=argument.isInout labelStart=argument.labelStart labelLen=argument.labelLen hasLabel=argument.hasLabel />)
                }
                CallParameterBinding.Default(val generator) => {
                    mut val existing: U64 = self.arena.exprs.count()
                    if index < previous.count() {
                        match previous[index].source {
                            CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: val siteKey) => {
                                val template: CallTemplate = self.callTemplateForSourceBody(fnIdx: self.cur.checkFn, exprId: exprId)
                                if self.sameCallSiteKey(a: template.siteKey, b: siteKey) {
                                    match template.kind {
                                        CallTemplateKind.Direct(callee: val priorCallee, receiver: _, args: _, calleeTypeArgs: _, proof: _) => {
                                            if priorCallee == generator { existing = exprId }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    val call: U64 = self.recordDefaultArgumentCall(generator: generator, receiver: receiver, calleeTypeArgs: generatorArgs, resultTerm: parameterTerms[index], existingExpr: existing, proof: proof)
                    val parameter: Param = self.funcParamAt(params: parameters, index: index)
                    completed.append(<CallTemplateArgument source=self.callArgumentSource(exprId: call) isInout=false labelStart=parameter.nameStart labelLen=parameter.nameLen hasLabel=!parameter.noLabel />)
                }
            }
            index += 1U64
        }
        return <Optional.Some v=completed />
    }

    // A default slot evaluates an ordinary, declaration-selected zero-argument
    // function. Its result is represented by the same PriorCallResult source
    // as a written nested call. The parent retains the returned expression in
    // its completed argument list; re-recording that slot reuses its identity,
    // while a different call occurrence allocates a fresh synthetic origin.
    // `resultTerm` and substitutions are already expressed in the caller's
    // parametric environment. This method performs no inference/name lookup.
    inout fn recordDefaultArgumentCall(generator: U64, receiver: CallTemplateReceiver, calleeTypeArgs: Array[U64], resultTerm: U64, existingExpr: U64, proof: StaticConformanceProof = <StaticConformanceProof.Missing />) -> U64 {
        if !self.cur.recordCallTemplates || generator >= self.arena.funcs.count() {
            self.errorAt(offset: 0U64, msg: "internal error: default argument call requires a selected generator during Record")
            return self.arena.exprs.count()
        }
        val function: Func = self.arena.funcs[generator]
        if function.params.count() != 0U64 || function.hasRecv {
            self.errorAt(offset: function.defOffset, msg: "internal error: default argument generator captures value parameters")
            return self.arena.exprs.count()
        }
        mut val call: U64 = existingExpr
        val noArgs: ArgRange = self.pushArgs(args: [])
        if call < self.arena.exprs.count() {
            val previous: CallTemplate = self.callTemplateForSourceBody(fnIdx: self.cur.checkFn, exprId: call)
            mut val matches: Bool = false
            match previous.kind {
                CallTemplateKind.Direct(callee: val callee, receiver: _, args: val args, calleeTypeArgs: _, proof: _) => {
                    matches = callee == generator && args.count() == 0U64
                }
                _ => {}
            }
            if !matches {
                self.errorAt(offset: function.defOffset, msg: "internal error: default argument evaluation identity changed")
                return self.arena.exprs.count()
            }
        } else {
            call = self.pushExpr(e: <Expr.Call nameStart=function.nameStart nameLen=function.nameLen args=noArgs />)
            self.decls.syntheticCallSites.append(<SyntheticCallSite exprId=call originSerial=self.arena.exprOriginSerial[call] receiverTerm=0U64 />)
        }
        self.recordSemanticExprCall(exprId: call, callee: generator, receiver: receiver, args: noArgs, calleeTypeArgs: calleeTypeArgs, resultTerm: resultTerm, proof: proof)
        return call
    }

    // Bind only after selecting the declaration. Keep the authored arguments
    // intact, but produce one entry per parameter in evaluation order. A single
    // monotone walk also rejects leftover/duplicate/out-of-order arguments.
    // None is an incomplete decision, never permission for a consumer to fill
    // missing operands by reopening the default expression in caller scope.
    inout fn bindCallParameters(callee: U64, args: ArgRange) -> Optional[Array[CallParameterBinding]] {
        if callee >= self.arena.funcs.count() { return <Optional.None /> }
        val parameters: FuncParamRange = self.arena.funcs[callee].params
        mut val bindings: Array[CallParameterBinding] = []
        mut val argumentIndex: U64 = 0U64
        mut val parameterIndex: U64 = 0U64
        while parameterIndex < parameters.count() {
            val parameter: Param = self.funcParamAt(params: parameters, index: parameterIndex)
            mut val explicit: Bool = false
            if argumentIndex < args.len {
                explicit = self.argMatchesParamLabel(param: parameter, arg: self.argAt(args: args, index: argumentIndex))
            }
            if explicit {
                bindings.append(<CallParameterBinding.Explicit argumentIndex=argumentIndex />)
                argumentIndex += 1U64
            } else {
                if !parameter.hasDefault { return <Optional.None /> }
                val generator: U64 = self.defaultArgumentGenerator(ownerFnIdx: callee, parameterIndex: parameterIndex)
                if generator >= self.arena.funcs.count() { return <Optional.None /> }
                bindings.append(<CallParameterBinding.Default generator=generator />)
            }
            parameterIndex += 1U64
        }
        if argumentIndex != args.len { return <Optional.None /> }
        return <Optional.Some v=bindings />
    }

    fn defaultArgumentGenerator(ownerFnIdx: U64, parameterIndex: U64) -> U64 {
        if ownerFnIdx >= self.decls.defaultGeneratorRanges.count() { return self.arena.funcs.count() }
        val range: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[ownerFnIdx]
        if parameterIndex >= range.len { return self.arena.funcs.count() }
        val functionId: U64 = self.decls.defaultGeneratorFunctions[range.start + parameterIndex]
        if functionId == 0U64 { return self.arena.funcs.count() }
        return functionId - 1U64
    }

    // Placed provided copies prepend receiver binders to the source method's
    // binders. A source-owned generator retains only its lexical signature;
    // positional truncation would substitute the receiver argument for T.
    inout fn defaultGeneratorTypeArguments(callee: U64, generator: U64, args: Array[U64]) -> Optional[Array[U64]] {
        if callee >= self.arena.funcs.count() || generator >= self.arena.funcs.count() { return <Optional.None /> }
        val source: FuncBindRange = self.arena.funcs[callee].typeParams
        val target: FuncBindRange = self.arena.funcs[generator].typeParams
        if args.count() != source.count() { return <Optional.None /> }
        if source.start == target.start && source.len == target.len { return <Optional.Some v=args /> }
        mut val projected: Array[U64] = []
        mut val index: U64 = 0U64
        while index < target.count() {
            val parameter: Bind = self.funcBindAt(binds: target, index: index)
            if parameter.paramId == 0U64 { return <Optional.None /> }
            mut val value: U64 = 0U64
            mut val matches: U64 = 0U64
            mut val candidate: U64 = 0U64
            while candidate < source.count() {
                if self.funcBindAt(binds: source, index: candidate).paramId == parameter.paramId {
                    value = args[candidate]
                    matches += 1U64
                }
                candidate += 1U64
            }
            if matches != 1U64 || value == 0U64 { return <Optional.None /> }
            projected.append(value)
            index += 1U64
        }
        return <Optional.Some v=projected />
    }

    // Prepare before semantic recording, after checking the authored defaults.
    // The caller must transfer default-expression ownership to these bodies
    // when enabling this phase; recording the same expression as both a parent
    // default and a generator body would give it conflicting local identities.
    inout fn prepareDefaultArgumentGenerators() {
        if self.decls.defaultGeneratorRanges.count() != 0U64 { return }
        val declarationLimit: U64 = self.arena.funcs.count()
        val boundLimit: U64 = self.decls.funcBounds.count()
        mut val owners: Array[U64] = []
        mut val owner: U64 = 0U64
        while owner < declarationLimit {
            val source: Func = self.arena.funcs[owner]
            val lexicalOwner: U64 = self.callTemplateBodyOwner(fnIdx: owner)
            owners.append(lexicalOwner)
            val start: U64 = self.decls.defaultGeneratorFunctions.count()
            mut val parameterIndex: U64 = 0U64
            while parameterIndex < source.params.count() {
                val parameter: Param = self.funcParamAt(params: source.params, index: parameterIndex)
                mut val functionId: U64 = 0U64
                if parameter.hasDefault && lexicalOwner == owner {
                    val generator: U64 = self.createDefaultArgumentGenerator(ownerFnIdx: owner, parameter: parameter)
                    functionId = generator + 1U64
                }
                self.decls.defaultGeneratorFunctions.append(functionId)
                parameterIndex += 1U64
            }
            self.decls.defaultGeneratorRanges.append(<DefaultGeneratorRange start=start len=source.params.count() />)
            owner += 1U64
        }
        // All canonical rows exist before resolving aliases, including a
        // placed copy which precedes its source declaration in the table.
        owner = 0U64
        while owner < declarationLimit {
            val lexicalOwner: U64 = owners[owner]
            if lexicalOwner != owner {
                val destination: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[owner]
                val source: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[lexicalOwner]
                if destination.len != source.len {
                    self.errorAt(offset: self.arena.funcs[owner].defOffset, msg: "internal error: provided default parameter shape differs from its source")
                }
                mut val parameterIndex: U64 = 0U64
                while parameterIndex < destination.len {
                    self.decls.defaultGeneratorFunctions.set(i: destination.start + parameterIndex, value: self.decls.defaultGeneratorFunctions[source.start + parameterIndex])
                    parameterIndex += 1U64
                }
            }
            owner += 1U64
        }
        self.copyDefaultGeneratorBounds(boundLimit: boundLimit, owners: owners)
    }

    // Walk authored bounds once, not once per generator. Each relevant row is
    // copied to the generator's function identity, retaining canonical binders.
    inout fn copyDefaultGeneratorBounds(boundLimit: U64, owners: Array[U64]) {
        mut val index: U64 = 0U64
        while index < boundLimit {
            val bound: FuncBound = self.decls.funcBounds[index]
            if bound.fnIdx < owners.count() && owners[bound.fnIdx] == bound.fnIdx {
                val range: DefaultGeneratorRange = self.decls.defaultGeneratorRanges[bound.fnIdx]
                mut val parameterIndex: U64 = 0U64
                while parameterIndex < range.len {
                    val functionId: U64 = self.decls.defaultGeneratorFunctions[range.start + parameterIndex]
                    if functionId != 0U64 {
                        self.decls.funcBounds.append(<FuncBound fnIdx=functionId - 1U64 paramStart=bound.paramStart paramLen=bound.paramLen paramTy=bound.paramTy paramNameId=bound.paramNameId constraint=bound.constraint />)
                    }
                    parameterIndex += 1U64
                }
            }
            index += 1U64
        }
    }

    inout fn createDefaultArgumentGenerator(ownerFnIdx: U64, parameter: Param) -> U64 {
        val source: Func = self.arena.funcs[ownerFnIdx]
        mut val lexicalOwner: U64 = source.lexicalOwnerFnId
        if lexicalOwner == 0U64 { lexicalOwner = ownerFnIdx + 1U64 }
        val functionIdx: U64 = self.arena.funcs.count()
        // This spelling is diagnostic/mangling only. Selection uses the
        // owner/parameter table above, never a source-visible name lookup.
        val name: Bind = self.internTmpName(prefix: "$defaultArgument", n: functionIdx)
        val returned: U64 = self.pushStmt(s: <Stmt.Return value=parameter.defaultExpr hasValue=true offset=parameter.nameStart />)
        val body: U64 = self.pushBlock(stmts: [returned])
        val generator: Func = <Func
            nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId
            lexicalOwnerFnId=lexicalOwner
            typeParams=source.typeParams
            hasRet=true retStart=parameter.tyStart retLen=parameter.tyLen
            retIsArray=parameter.tyIsArray retTy=parameter.ty body=body
            hasRecv=false recvStart=source.recvStart recvLen=source.recvLen
            recvId=source.recvId recvTy=source.recvTy
            recvPatternParams=source.recvPatternParams recvTraitArgs=source.recvTraitArgs
            selfInout=false selfMove=false isAssoc=source.hasRecv || source.isAssoc
            isAsync=false isExtern=false
            extId=source.extId srcTraitId=source.srcTraitId srcTraitOwner=source.srcTraitOwner
            originTraitId=source.originTraitId originTraitOwner=source.originTraitOwner
            originTraitArity=source.originTraitArity originConformIdx=source.originConformIdx
            sourceConformIdx=source.sourceConformIdx providedOwnerMod=source.providedOwnerMod
            provTraitArity=source.provTraitArity provTraitOwner=source.provTraitOwner
            defOffset=source.defOffset />
        self.arena.funcs.append(generator)
        return functionIdx
    }
}
