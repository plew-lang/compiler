// stage1 parser sketch #2: a parser that consumes the LEXER'S TOKEN STREAM
// (not raw bytes), written in Plew and compiled by stage0.
//
// calc.pw validated the parser phase over raw bytes. The new thing here is
// consuming an `Array[Tok]` produced by the lexer: the parser advances a token
// cursor, dispatches on `Tok.kind`, and reads an integer literal's value back
// out of the source bytes via the token's (start, len) span. This is exactly
// the shape the self-hosted compiler's parser needs.
//
// The lexer below is copied from lexer.pw (stage0 has no import mechanism yet,
// so each selfhost program is a single self-contained file). Only the subset
// the expression grammar needs is exercised.
//
// Reads an expression from stdin and prints its value. Precedence:
//   expr := term (('+' | '-') term)*
//   term := atom (('*' | '/' | '%') atom)*
//   atom := Int | '(' expr ')'

enum Kind {
    Eof
    Newline
    Int
    Str
    Ident
    KwFn
    KwStruct
    KwEnum
    KwMatch
    KwIf
    KwElse
    KwWhile
    KwFor
    KwBreak
    KwContinue
    KwReturn
    KwGive
    KwVal
    KwMut
    KwIn
    KwAs
    KwInout
    KwTrue
    KwFalse
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Eq
    EqEq
    Ne
    Lt
    Le
    Gt
    Ge
    Plus
    Minus
    Star
    Slash
    Percent
    AmpAmp
    PipePipe
    Bang
    Arrow
    FatArrow
    SlashGt
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    DotDotLt
    DotDotEq
    Unknown
}

struct Tok {
    val kind: Kind
    val start: U64
    val len: U64
}

struct Lexer {
    val bytes: Array[U8]
    mut val pos: U64
    mut val toks: Array[Tok]
    mut val depth: I64
}

fn at(lx: inout Lexer, off: U64) -> U8 {
    val i: U64 = lx.pos + off
    if i < lx.bytes.count {
        return lx.bytes[i]
    }
    return 0
}

fn isDigit(b: U8) -> Bool {
    if b >= 48 {
        if b <= 57 {
            return true
        }
    }
    return false
}

fn isAlpha(b: U8) -> Bool {
    if b == 95 {
        return true
    }
    if b >= 97 {
        if b <= 122 {
            return true
        }
    }
    if b >= 65 {
        if b <= 90 {
            return true
        }
    }
    return false
}

fn isAlnum(b: U8) -> Bool {
    if isAlpha(b) {
        return true
    }
    return isDigit(b)
}

fn rangeEquals(bytes: Array[U8], start: U64, len: U64, kw: String) -> Bool {
    val kb: Array[U8] = kw.bytes
    if len != kb.count {
        return false
    }
    mut val j: U64 = 0
    while j < len {
        if bytes[start + j] != kb[j] {
            return false
        }
        j += 1
    }
    return true
}

fn identKind(bytes: Array[U8], start: U64, len: U64) -> Kind {
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "fn") {
        return <Kind.KwFn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "struct") {
        return <Kind.KwStruct />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "enum") {
        return <Kind.KwEnum />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "match") {
        return <Kind.KwMatch />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "if") {
        return <Kind.KwIf />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "else") {
        return <Kind.KwElse />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "while") {
        return <Kind.KwWhile />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "for") {
        return <Kind.KwFor />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "break") {
        return <Kind.KwBreak />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "continue") {
        return <Kind.KwContinue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "return") {
        return <Kind.KwReturn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "give") {
        return <Kind.KwGive />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "val") {
        return <Kind.KwVal />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "mut") {
        return <Kind.KwMut />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "in") {
        return <Kind.KwIn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "as") {
        return <Kind.KwAs />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "inout") {
        return <Kind.KwInout />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "true") {
        return <Kind.KwTrue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "false") {
        return <Kind.KwFalse />
    }
    return <Kind.Ident />
}

fn emit(lx: inout Lexer, k: Kind, start: U64, len: U64) {
    lx.toks.append(<Tok kind=k start=start len=len />)
    lx.pos = start + len
}

fn lastWasNewline(lx: inout Lexer) -> Bool {
    val n: U64 = lx.toks.count
    if n == 0 {
        return false
    }
    val t: Tok = lx.toks[n - 1]
    match t.kind {
        Kind.Newline => { return true }
        _ => { return false }
    }
}

fn lastCanEnd(lx: inout Lexer) -> Bool {
    val n: U64 = lx.toks.count
    if n == 0 {
        return false
    }
    val t: Tok = lx.toks[n - 1]
    match t.kind {
        Kind.Ident => { return true }
        Kind.Int => { return true }
        Kind.Str => { return true }
        Kind.RParen => { return true }
        Kind.RBracket => { return true }
        Kind.RBrace => { return true }
        Kind.SlashGt => { return true }
        Kind.KwTrue => { return true }
        Kind.KwFalse => { return true }
        Kind.KwReturn => { return true }
        Kind.KwBreak => { return true }
        Kind.KwContinue => { return true }
        _ => { return false }
    }
}

fn lex(lx: inout Lexer) {
    while lx.pos < lx.bytes.count {
        val b: U8 = at(lx: inout lx, off: 0)
        if b == 32 {
            lx.pos += 1
            continue
        }
        if b == 9 {
            lx.pos += 1
            continue
        }
        if b == 13 {
            lx.pos += 1
            continue
        }
        if b == 10 {
            if lx.depth > 0 {
                lx.pos += 1
            } else {
                if lastCanEnd(lx: inout lx) {
                    if lastWasNewline(lx: inout lx) {
                        lx.pos += 1
                    } else {
                        emit(lx: inout lx, k: <Kind.Newline />, start: lx.pos, len: 1)
                    }
                } else {
                    lx.pos += 1
                }
            }
            continue
        }
        if b == 47 {
            if at(lx: inout lx, off: 1) == 47 {
                while lx.pos < lx.bytes.count {
                    if at(lx: inout lx, off: 0) == 10 {
                        break
                    }
                    lx.pos += 1
                }
                continue
            }
        }
        if isDigit(b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count {
                if isDigit(lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            emit(lx: inout lx, k: <Kind.Int />, start: start, len: j - start)
            continue
        }
        if isAlpha(b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count {
                if isAlnum(lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            val len: U64 = j - start
            val k: Kind = identKind(bytes: lx.bytes, start: start, len: len)
            emit(lx: inout lx, k: k, start: start, len: len)
            continue
        }
        if b == 34 {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos + 1
            while j < lx.bytes.count {
                if lx.bytes[j] == 34 {
                    j += 1
                    break
                }
                j += 1
            }
            emit(lx: inout lx, k: <Kind.Str />, start: start, len: j - start)
            continue
        }
        val b2: U8 = at(lx: inout lx, off: 1)
        if b == 46 {
            if b2 == 46 {
                val b3: U8 = at(lx: inout lx, off: 2)
                if b3 == 60 {
                    emit(lx: inout lx, k: <Kind.DotDotLt />, start: lx.pos, len: 3)
                    continue
                }
                if b3 == 61 {
                    emit(lx: inout lx, k: <Kind.DotDotEq />, start: lx.pos, len: 3)
                    continue
                }
            }
            emit(lx: inout lx, k: <Kind.Dot />, start: lx.pos, len: 1)
            continue
        }
        if b == 61 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.EqEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == 62 {
                emit(lx: inout lx, k: <Kind.FatArrow />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Eq />, start: lx.pos, len: 1)
            continue
        }
        if b == 33 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.Ne />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Bang />, start: lx.pos, len: 1)
            continue
        }
        if b == 60 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.Le />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Lt />, start: lx.pos, len: 1)
            continue
        }
        if b == 62 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.Ge />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Gt />, start: lx.pos, len: 1)
            continue
        }
        if b == 43 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.PlusEq />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Plus />, start: lx.pos, len: 1)
            continue
        }
        if b == 45 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.MinusEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == 62 {
                emit(lx: inout lx, k: <Kind.Arrow />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Minus />, start: lx.pos, len: 1)
            continue
        }
        if b == 42 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.StarEq />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Star />, start: lx.pos, len: 1)
            continue
        }
        if b == 47 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.SlashEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == 62 {
                emit(lx: inout lx, k: <Kind.SlashGt />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Slash />, start: lx.pos, len: 1)
            continue
        }
        if b == 37 {
            if b2 == 61 {
                emit(lx: inout lx, k: <Kind.PercentEq />, start: lx.pos, len: 2)
                continue
            }
            emit(lx: inout lx, k: <Kind.Percent />, start: lx.pos, len: 1)
            continue
        }
        if b == 38 {
            if b2 == 38 {
                emit(lx: inout lx, k: <Kind.AmpAmp />, start: lx.pos, len: 2)
                continue
            }
        }
        if b == 124 {
            if b2 == 124 {
                emit(lx: inout lx, k: <Kind.PipePipe />, start: lx.pos, len: 2)
                continue
            }
        }
        if b == 40 {
            emit(lx: inout lx, k: <Kind.LParen />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == 41 {
            emit(lx: inout lx, k: <Kind.RParen />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == 91 {
            emit(lx: inout lx, k: <Kind.LBracket />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == 93 {
            emit(lx: inout lx, k: <Kind.RBracket />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == 123 {
            emit(lx: inout lx, k: <Kind.LBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == 125 {
            emit(lx: inout lx, k: <Kind.RBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == 44 {
            emit(lx: inout lx, k: <Kind.Comma />, start: lx.pos, len: 1)
            continue
        }
        if b == 58 {
            emit(lx: inout lx, k: <Kind.Colon />, start: lx.pos, len: 1)
            continue
        }
        emit(lx: inout lx, k: <Kind.Unknown />, start: lx.pos, len: 1)
    }
    lx.toks.append(<Tok kind=<Kind.Eof /> start=lx.pos len=0 />)
}

// ---- parser over the token stream ----

enum Expr {
    Num { value: I64 }
    Bin { op: U8, lhs: U64, rhs: U64 }
}

struct Parser {
    val bytes: Array[U8]
    val toks: Array[Tok]
    mut val pos: U64
    mut val nodes: Array[Expr]
}

fn curKind(p: inout Parser) -> Kind {
    return p.toks[p.pos].kind
}

fn advance(p: inout Parser) {
    p.pos = p.pos + 1
}

fn push(p: inout Parser, e: Expr) -> U64 {
    val id: U64 = p.nodes.count
    p.nodes.append(e)
    return id
}

// Read an Int token's value back out of the source bytes via its (start, len).
fn tokenValue(p: inout Parser, t: Tok) -> I64 {
    mut val v: I64 = 0
    mut val j: U64 = 0
    while j < t.len {
        val b: U8 = p.bytes[t.start + j]
        v = v * 10 + (b as I64 - 48)
        j += 1
    }
    return v
}

fn parseAtom(p: inout Parser) -> U64 {
    val k: Kind = curKind(p: inout p)
    match k {
        Kind.LParen => {
            advance(p: inout p)
            val inner: U64 = parseExpr(p: inout p)
            match curKind(p: inout p) {
                Kind.RParen => { advance(p: inout p) }
                _ => {}
            }
            return inner
        }
        Kind.Int => {
            val t: Tok = p.toks[p.pos]
            advance(p: inout p)
            val v: I64 = tokenValue(p: inout p, t: t)
            return push(p: inout p, e: <Expr.Num value=v />)
        }
        _ => {
            return push(p: inout p, e: <Expr.Num value=0 />)
        }
    }
}

fn parseTerm(p: inout Parser) -> U64 {
    mut val left: U64 = parseAtom(p: inout p)
    while true {
        val k: Kind = curKind(p: inout p)
        match k {
            Kind.Star => {
                advance(p: inout p)
                val right: U64 = parseAtom(p: inout p)
                left = push(p: inout p, e: <Expr.Bin op=42 lhs=left rhs=right />)
            }
            Kind.Slash => {
                advance(p: inout p)
                val right: U64 = parseAtom(p: inout p)
                left = push(p: inout p, e: <Expr.Bin op=47 lhs=left rhs=right />)
            }
            Kind.Percent => {
                advance(p: inout p)
                val right: U64 = parseAtom(p: inout p)
                left = push(p: inout p, e: <Expr.Bin op=37 lhs=left rhs=right />)
            }
            _ => { break }
        }
    }
    return left
}

fn parseExpr(p: inout Parser) -> U64 {
    mut val left: U64 = parseTerm(p: inout p)
    while true {
        val k: Kind = curKind(p: inout p)
        match k {
            Kind.Plus => {
                advance(p: inout p)
                val right: U64 = parseTerm(p: inout p)
                left = push(p: inout p, e: <Expr.Bin op=43 lhs=left rhs=right />)
            }
            Kind.Minus => {
                advance(p: inout p)
                val right: U64 = parseTerm(p: inout p)
                left = push(p: inout p, e: <Expr.Bin op=45 lhs=left rhs=right />)
            }
            _ => { break }
        }
    }
    return left
}

fn eval(nodes: Array[Expr], id: U64) -> I64 {
    val node: Expr = nodes[id]
    match node {
        Expr.Num { val value } => { return value }
        Expr.Bin { val op, val lhs, val rhs } => {
            val l: I64 = eval(nodes: nodes, id: lhs)
            val r: I64 = eval(nodes: nodes, id: rhs)
            if op == 43 { return l + r }
            if op == 45 { return l - r }
            if op == 42 { return l * r }
            if op == 37 { return l % r }
            return l / r
        }
    }
    return 0
}

fn main() {
    val src: String = readStdin()
    mut val lx: Lexer = <Lexer bytes=src.bytes pos=0 toks=[] depth=0 />
    lex(lx: inout lx)
    mut val p: Parser = <Parser bytes=src.bytes toks=lx.toks pos=0 nodes=[] />
    val root: U64 = parseExpr(p: inout p)
    print(eval(nodes: p.nodes, id: root))
}
