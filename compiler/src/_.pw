// The module root of the self-hosted Plew compiler. It `part`s the
// backend-agnostic front-end (Ast / Parser / all Codegen analysis / Loader /
// Driver) plus the LLVM emitter (Backend/Llvm); `main` runs `runFrontend()`
// then `emitLlvm()`. The compiler links libLLVM (the emitter calls libLLVM-C)
// and emits textual LLVM IR, which clang lowers to an object/executable.
//
// Bootstrap from the checked-in IR seed: see bootstrap.sh. Fast in-place dev
// rebuild (current compiler/plewc recompiles this source): see dev-rebuild.sh.
//   compiler/plewc compiler/src/_.pw > out.ll
//   clang out.ll <runtime> $(llvm-config --ldflags --libs core) -o compiler/plewc

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint, fileExists }
import @Std/Process with { argCount, argAt, exit }
import @Std/Ffi with { cString, stringFromCString, arrayCPtr }
import @Std/Core with { stringFromBytes }
import @Std/Syntax with { Kind, Tok, Lexer, lex, kindCode, rangeEquals, P, parseBlockAst, parseExprAst, parseProgramAst, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst, emptyExpr }

part ./Ast
part ./Parser/Decl
part ./Codegen/Emit
part ./Codegen/Resolve
part ./Codegen/Ops
part ./Codegen/Check
part ./Codegen/Expr
part ./Codegen/Stmt
part ./Codegen/Decl
part ./Codegen/Mono
part ./Codegen/Array
part ./Codegen/Gen
part ./Codegen/Verify
part ./Codegen/Lower
part ./Codegen/Driver
part ./Backend/Llvm
part ./Loader

fn main() {
    // `plewc --runtime` emits the companion C runtime the generated IR links
    // against (no front-end needed — the runtime is program-independent so far).
    if argCount() > 1 {
        if argAt(1) == "--runtime" {
            emitLlvmRuntime()
            return
        }
    }
    mut val c: Comp = runFrontend()
    emitLlvm(c: inout c)
}
