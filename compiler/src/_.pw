// The self-hosted Plew compiler: hand-written lexer + recursive-descent parser
// -> arena AST (index handles) -> C transpilation. It compiles itself to a
// fixpoint (see bootstrap.sh). This is the module root; the compiler is split
// across part files (Lexer / Ast / Parser / Codegen), stitched in below, with
// the driver (multi-file assembly + main) kept here.
//
// I/O is not ambient in Plew (spec: `print` et al. live in @Std, must be
// imported). These imports are also what the compiler now *enforces* on every
// program it compiles, including this source.

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint }
import @Std/Process with { argCount, argAt, exit }

part ./Lexer
part ./Ast
part ./Parser
part ./Codegen

// ---- multi-file `part` ----
//
// A module may span several files: `part ./Name` stitches Name.pw into the same
// module (shared scope, no namespace). We resolve this by assembling all files
// into one byte buffer and lexing/parsing it as a unit (the single-arena, single
// C-output model has no separate compilation). Only `part ./Name` (sibling file)
// is supported for now; `_.pw` directories, `../`, and `/` roots are additive.

// Scan a lexed token stream for local-include directives — `part ./Name` and
// `import ./Name` — returning the module-name spans (into `rootBytes`). Both
// keywords are ordinary identifiers; only the `./Name` shape (Dot Slash Ident)
// is collected here. `import @Std/…` (At …), `import /…` (Slash …) and
// `import ../…` (Dot Dot …) do not match this pattern, so they are left for
// their own handling (intrinsic @Std / root-absolute / parent-relative).
fn collectParts(rootBytes: Array[U8], toks: Array[Tok]) -> Array[Bind] {
    mut val parts: Array[Bind] = []
    mut val i: U64 = 0
    while i < toks.count {
        val t: Tok = toks[i]
        mut val isPart: Bool = false
        match t.kind {
            Kind.Ident => {
                if rangeEquals(bytes: rootBytes, start: t.start, len: t.len, kw: "part") {
                    isPart = true
                }
                if rangeEquals(bytes: rootBytes, start: t.start, len: t.len, kw: "import") {
                    isPart = true
                }
            }
            _ => {}
        }
        if isPart {
            if i + 3 < toks.count {
                mut val okDot: Bool = false
                match toks[i + 1].kind {
                    Kind.Dot => { okDot = true }
                    _ => {}
                }
                mut val okSlash: Bool = false
                match toks[i + 2].kind {
                    Kind.Slash => { okSlash = true }
                    _ => {}
                }
                val nameT: Tok = toks[i + 3]
                mut val okName: Bool = false
                match nameT.kind {
                    Kind.Ident => { okName = true }
                    _ => {}
                }
                if okDot && okSlash && okName {
                    parts.append(<Bind nameStart=nameT.start nameLen=nameT.len fieldStart=nameT.start fieldLen=nameT.len />)
                }
            }
        }
        i += 1
    }
    return parts
}

// Append every byte of `from` onto `into`.
fn appendBytes(into: inout Array[U8], from: Array[U8]) {
    mut val i: U64 = 0
    while i < from.count {
        into.append(from[i])
        i += 1
    }
}

// Copy a byte span out of `buf` into a fresh array (paths live in a shared
// buffer; this extracts one for use as a file path).
fn extractSpan(buf: Array[U8], start: U64, len: U64) -> Array[U8] {
    mut val out: Array[U8] = []
    mut val i: U64 = 0
    while i < len {
        out.append(buf[start + i])
        i += 1
    }
    return out
}

// Length of the directory prefix of `path` (index just past the last '/'); 0 if
// the path has no '/'. So a sibling resolves as path[0..pre] + name.
fn dirPrefixLen(path: Array[U8]) -> U64 {
    mut val pre: U64 = 0
    mut val k: U64 = 0
    while k < path.count {
        if path[k] == 47 {
            pre = k + 1
        }
        k += 1
    }
    return pre
}

// Resolve a `./Name` local include against the importer's directory:
// base[0..baseLen] + Name + ".pw".
fn resolveSibling(base: Array[U8], baseLen: U64, nameBytes: Array[U8], nameStart: U64, nameLen: U64) -> Array[U8] {
    mut val path: Array[U8] = []
    mut val i: U64 = 0
    while i < baseLen {
        path.append(base[i])
        i += 1
    }
    mut val n: U64 = 0
    while n < nameLen {
        path.append(nameBytes[nameStart + n])
        n += 1
    }
    path.append(46)
    path.append(112)
    path.append(119)
    return path
}

// Whether `path` is already in the loaded set (each Bind is a span into `buf`).
// Dedup keeps a module included once and makes import cycles terminate.
fn pathSeen(buf: Array[U8], loaded: Array[Bind], path: Array[U8]) -> Bool {
    mut val i: U64 = 0
    while i < loaded.count {
        val b: Bind = loaded[i]
        if b.nameLen == path.count {
            mut val eq: Bool = true
            mut val j: U64 = 0
            while j < path.count {
                if buf[b.nameStart + j] != path[j] {
                    eq = false
                }
                j += 1
            }
            if eq {
                return true
            }
        }
        i += 1
    }
    return false
}

// ---- driver ----
//
// Reads a Plew program from a file argument (following `part` directives) or
// from stdin, parses it into an arena AST, and writes a C translation to stdout:
// the runtime preamble, nominal type decls, monomorphized array types, then
// prototypes and bodies.

fn main() {
    // Assemble the source. With a file argument we read it, follow its `part`
    // directives, and concatenate every file into one buffer; with no argument
    // we read a single program from stdin.
    mut val combined: Array[U8] = []
    if argCount() > 1 {
        // Module loader: a recursive, deduplicated worklist over local includes.
        // Each file's `part ./Name` / `import ./Name` directives resolve relative
        // to that file's own directory; every distinct file is concatenated once
        // into a single buffer (the compiler is single-arena / single-C-output).
        val rootPath: String = argAt(1)
        val entryBytes: Array[U8] = rootPath.bytes
        mut val pathBuf: Array[U8] = []
        mut val loaded: Array[Bind] = []
        val es: U64 = pathBuf.count
        appendBytes(into: inout pathBuf, from: entryBytes)
        loaded.append(<Bind nameStart=es nameLen=entryBytes.count fieldStart=es fieldLen=entryBytes.count />)
        mut val qi: U64 = 0
        while qi < loaded.count {
            val ent: Bind = loaded[qi]
            qi += 1
            val path: Array[U8] = extractSpan(buf: pathBuf, start: ent.nameStart, len: ent.nameLen)
            val src: String = readFileBytes(path)
            val sb: Array[U8] = src.bytes
            if combined.count > 0 {
                combined.append(10)
            }
            appendBytes(into: inout combined, from: sb)
            mut val lxp: Lexer = <Lexer bytes=sb pos=0 toks=[] depth=0 />
            lex(lx: inout lxp)
            val incs: Array[Bind] = collectParts(rootBytes: sb, toks: lxp.toks)
            val baseLen: U64 = dirPrefixLen(path: path)
            mut val pj: U64 = 0
            while pj < incs.count {
                val pb: Bind = incs[pj]
                val childPath: Array[U8] = resolveSibling(base: path, baseLen: baseLen, nameBytes: sb, nameStart: pb.nameStart, nameLen: pb.nameLen)
                if pathSeen(buf: pathBuf, loaded: loaded, path: childPath) {
                } else {
                    val cs: U64 = pathBuf.count
                    appendBytes(into: inout pathBuf, from: childPath)
                    loaded.append(<Bind nameStart=cs nameLen=childPath.count fieldStart=cs fieldLen=childPath.count />)
                }
                pj += 1
            }
        }
    } else {
        val s: String = readStdin()
        appendBytes(into: inout combined, from: s.bytes)
    }
    mut val lx: Lexer = <Lexer bytes=combined pos=0 toks=[] depth=0 />
    lex(lx: inout lx)
    mut val c: Comp = <Comp bytes=combined toks=lx.toks pos=0 exprs=[] stmts=[] blocks=[] funcs=[] structs=[] enums=[] arrayElems=[] locals=[] tmp=0 curIsMain=false curRetVoid=false curRetStart=0 curRetLen=0 curRetIsArray=false curHasRecv=false curRecvStart=0 curRecvLen=0 curSelfInout=false curGiveTmp=0 impPrint=false impWrite=false impWriteByte=false impReadStdin=false impReadFile=false impArgCount=false impArgAt=false impEprint=false impExit=false impReadFileBytes=false />
    parseProgram(c: inout c)
    // runtime preamble: includes, immutable String, and the I/O builtins'
    // C runtime (the contract stage0 also injects — emitted here so stage1's
    // output is self-contained).
    write(s: "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n")
    write(s: "typedef struct { const char* data; long long len; } PlewString;\n")
    write(s: "__attribute__((unused)) static int PlewString_eq(PlewString a, PlewString b) { if (a.len != b.len) return 0; for (long long i = 0; i < a.len; i++) if (a.data[i] != b.data[i]) return 0; return 1; }\n")
    write(s: "__attribute__((unused)) static PlewString plew_read_stdin(void) { size_t cap = 4096, len = 0; char* buf = (char*)malloc(cap); int ch; while ((ch = getchar()) != EOF) { if (len + 1 >= cap) { cap *= 2; buf = (char*)realloc(buf, cap); } buf[len++] = (char)ch; } PlewString s; s.data = buf; s.len = (long long)len; return s; }\n")
    write(s: "__attribute__((unused)) static void plew_write(PlewString s) { fwrite(s.data, 1, (size_t)s.len, stdout); }\n")
    write(s: "__attribute__((unused)) static void plew_eprint(PlewString s) { fwrite(s.data, 1, (size_t)s.len, stderr); }\n")
    write(s: "__attribute__((noreturn)) static void plew_panic(PlewString m) { fputs(\"panic: \", stderr); fwrite(m.data, 1, (size_t)m.len, stderr); fputc('\\n', stderr); exit(1); }\n")
    write(s: "__attribute__((unused)) static long long plew_div(long long a, long long b) { if (b == 0) plew_panic((PlewString){\"division by zero\", 16}); if (b == -1 && a == INT64_MIN) plew_panic((PlewString){\"integer overflow\", 16}); return a / b; }\n")
    write(s: "__attribute__((unused)) static long long plew_mod(long long a, long long b) { if (b == 0) plew_panic((PlewString){\"remainder by zero\", 17}); if (b == -1) return 0; return a % b; }\n")
    write(s: "static int plew_argc = 0;\nstatic char** plew_argv = 0;\n")
    write(s: "__attribute__((unused)) static long long plew_arg_count(void) { return (long long)plew_argc; }\n")
    write(s: "__attribute__((unused)) static PlewString plew_arg_at(long long i) { PlewString s; if (i < 0 || i >= plew_argc) { s.data = \"\"; s.len = 0; return s; } s.data = plew_argv[i]; s.len = (long long)strlen(plew_argv[i]); return s; }\n")
    write(s: "__attribute__((unused)) static PlewString plew_read_file(PlewString path) { FILE* f = fopen(path.data, \"rb\"); PlewString s; if (!f) { s.data = \"\"; s.len = 0; return s; } fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET); char* buf = (char*)malloc((size_t)sz + 1); size_t n = fread(buf, 1, (size_t)sz, f); fclose(f); buf[n] = 0; s.data = buf; s.len = (long long)n; return s; }\n")
    // forward typedefs for every nominal type (structs + enums).
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        write(s: "typedef struct ")
        writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
        write(s: " ")
        writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
        write(s: ";\n")
        si += 1
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        write(s: "typedef struct ")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: " ")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: ";\n")
        ei += 1
    }
    // array typedefs (element by pointer -> forward decls suffice). U8 is always
    // present (String.bytes); other element types come from declarations.
    genU8ArrayTypedef()
    // readFileBytes: read a file named by an Array[U8] path (used by multi-file
    // `part` to read a path built from byte spans). Needs PlewArray_U8 above and
    // plew_read_file from the preamble.
    write(s: "__attribute__((unused)) static PlewString plew_read_file_bytes(PlewArray_U8 p) { char* path = (char*)malloc((size_t)p.len + 1); memcpy(path, p.data, (size_t)p.len); path[p.len] = 0; PlewString r = plew_read_file((PlewString){path, p.len}); free(path); return r; }\n")
    mut val ai: U64 = 0
    while ai < c.arrayElems.count {
        val ae: Bind = c.arrayElems[ai]
        if isU8Elem(c: inout c, elemStart: ae.nameStart, elemLen: ae.nameLen) {
        } else {
            genArrayTypedef(c: inout c, elemStart: ae.nameStart, elemLen: ae.nameLen)
        }
        ai += 1
    }
    // nominal bodies (may contain arrays by value; typedefs above are complete).
    // Enums first: a struct may hold an enum by value (e.g. Tok holds Kind), but
    // no enum holds a struct by value, so this order resolves the dependency.
    // (A full topological sort is future work if that assumption breaks.)
    mut val ej: U64 = 0
    while ej < c.enums.count {
        genEnumDef(c: inout c, ei: ej)
        ej += 1
    }
    mut val sj: U64 = 0
    while sj < c.structs.count {
        genStructDef(c: inout c, si: sj)
        sj += 1
    }
    // array runtime (element by value -> needs full nominal defs above).
    genU8ArrayRuntime()
    mut val ar: U64 = 0
    while ar < c.arrayElems.count {
        val ae2: Bind = c.arrayElems[ar]
        if isU8Elem(c: inout c, elemStart: ae2.nameStart, elemLen: ae2.nameLen) {
        } else {
            genArrayRuntimeFns(c: inout c, elemStart: ae2.nameStart, elemLen: ae2.nameLen)
        }
        ar += 1
    }
    // prototypes (skip main)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if nameIsMain(c: inout c, f: f) {
        } else {
            genSignature(c: inout c, f: f)
            write(s: ";\n")
        }
        i += 1
    }
    // bodies (dogfooding the for-loop this compiler now supports)
    for val j in 0..<c.funcs.count {
        genFunc(c: inout c, fi: j)
    }
}
