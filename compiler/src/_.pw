// The self-hosted Plew compiler: hand-written lexer + recursive-descent parser
// -> arena AST (index handles) -> C transpilation. It compiles itself to a
// fixpoint (see bootstrap.sh). This is the module root; the compiler is split
// across part files (Ast / Parser / Codegen) plus the module loader (Loader),
// stitched in below; only the driver (`main`) stays here. The lexer is no longer
// a part — it lives in @Std/Syntax (shared with metaprogramming) and is imported.
//
// I/O is not ambient in Plew (spec: `print` et al. live in @Std, must be
// imported). These imports are also what the compiler now *enforces* on every
// program it compiles, including this source.

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint, fileExists }
import @Std/Process with { argCount, argAt, exit }
// The lexer AND the body parser are shared with metaprogramming: the compiler
// frontend and @Std/Syntax's `parseItem` lex+parse through the same code (spec/16 —
// one syntactic layer, no drift). The compiler drives the shared body parser (P /
// parseBlockAst) over its own tokens and lowers the value tree into its arena.
import @Std/Syntax with { Kind, Tok, Lexer, lex, kindCode, rangeEquals, P, parseBlockAst, parseExprAst, parseProgramAst, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst, emptyExpr }

part ./Ast
part ./Parser/Decl
part ./Codegen/Emit
part ./Codegen/Resolve
part ./Codegen/Ops
part ./Codegen/Check
part ./Codegen/Expr
part ./Codegen/Stmt
part ./Codegen/Decl
part ./Codegen/Mono
part ./Codegen/Array
part ./Codegen/Async
part ./Codegen/Gen
part ./Codegen/Lower
part ./Loader

// ---- driver ----
//
// Reads a Plew program from a file argument (following `part` directives) or
// from stdin, parses it into an arena AST, and writes a C translation to stdout:
// the runtime preamble, nominal type decls, monomorphized array types, then
// prototypes and bodies.

fn main() {
    // gen mode (spec/16): `plewc --gen <file>` synthesizes a derive-runner harness
    // instead of compiling the user program. The entry path then sits at argv[2].
    mut val genMode: Bool = false
    mut val entryArgIdx: I64 = 1
    if argCount() > 1 {
        if argAt(1) == "--gen" {
            genMode = true
            entryArgIdx = 2
        }
    }
    // The compiler arena. The loader below fills `bytes`/`moduleRanges` and lowers
    // every item into it: PARSE-DRIVEN LOADING — each file's source is appended to
    // `c.bytes`, parsed by the shared @Std/Syntax parser, its items lowered, and its
    // `import`/`part` nodes followed to more files. There is no separate directive
    // pre-scan: the parsed tree drives discovery. (`bytes` is built incrementally, so
    // a file's source sits at `fileStart` before its items lower, and re-interned
    // names land in between — harmless: writeSpan emits text, moduleOf uses the
    // per-file ranges. `toks`/`pos` are unused now that all parsing is per-file.)
    mut val c: Comp = <Comp bytes=[] exprs=[] stmts=[] blocks=[] funcs=[] structs=[] enums=[] traits=[] conforms=[] methodAliases=[] derives=[] pendingDerives=[] funcBounds=[] curCheckFn=0 curWitnessed=[] curWhereTraits=[] types=[] genInsts=[] fnInsts=[] fnTypes=[] fnThunks=[] captures=[] curClosureId=0 curInClosure=false curCaptureMark=0 arrayElems=[] locals=[] tmp=0 curIsMain=false curRetVoid=false curRetStart=0 curRetLen=0 curRetIsArray=false curRetTy=0 curHasRecv=false curRecvStart=0 curRecvLen=0 curSelfInout=false curSelfMove=false curTypeParams=[] curTypeArgs=[] curRecvInstRef=0 curGiveTmp=0 curLoopMark=0 curBranchBase=0 deinits=[] curAsync=false asyncState=0 curAsyncFn=0 asyncVarSeq=0 moduleRanges=[] exports=[] imports=[] />
    // reserve TypeRef index 0 as the "no type" sentinel so a `ty` field of 0
    // (synthetic locals, untyped positions) never aliases a real parsed type.
    c.types.append(<TypeRef nameStart=0 nameLen=0 args=[] />)
    // reserve Block index 0 as a dummy so a `body` field of 0 is an unambiguous
    // "no body" sentinel (extern fns, trait-requirement signatures). Without this,
    // the first function body lowered (the entry file, which loads before the
    // ambient Prelude) would land at block 0 and be indistinguishable from no body
    // — wrongly skipped by the body-walks that gate on `body != 0`.
    c.blocks.append(<Block stmts=[] />)
    c.genMode = genMode
    mut val nextModuleId: U64 = 1
    if argCount() > entryArgIdx {
        // Module loader: a recursive, deduplicated worklist over local includes.
        // Each file's `part`/`import` paths resolve relative to that file's own
        // directory; every distinct file is appended once (single-arena / single-C).
        val rootPath: String = argAt(entryArgIdx)
        val entryBytes: Array[U8] = rootPath.bytes
        // Loud-fail on a missing entry file: without this readFileBytes returns an
        // empty string and the compiler silently emits an empty program (exit 0),
        // which hides a typo'd path. (Acceptance soundness: never silently accept.)
        if fileExists(path: entryBytes) {
        } else {
            eprint(text: "plewc: error: cannot open source file: ")
            eprint(text: rootPath)
            eprint(text: "\n")
            exit(code: 1)
        }
        mut val pathBuf: Array[U8] = []
        mut val loaded: Array[Bind] = []
        // `loaded[i].fieldStart` carries each queued file's module id.
        // package src root for `/…` absolute imports (from the Plew.toml walk-up;
        // empty if no manifest is found, in which case `/…` imports are skipped).
        val srcRoot: Array[U8] = findSrcRoot(entry: entryBytes)
        // std library root for `@Std/…`: the `std/` directory next to the plewc
        // binary (argv[0]'s directory), so `@Std/Core` -> `<plewcdir>/std/Core.pw`.
        val stdRoot: Array[U8] = computeStdRoot(arg0: argAt(0).bytes)
        val es: U64 = pathBuf.count
        appendBytes(into: inout pathBuf, from: entryBytes)
        loaded.append(<Bind nameStart=es nameLen=entryBytes.count fieldStart=0 fieldLen=entryBytes.count />)
        // gen mode: force-load @Std/Io as its own module so the synthesized harness
        // `main` can call `write` even if the target file doesn't import it.
        if genMode {
            mut val ioPath: Array[U8] = []
            appendBytes(into: inout ioPath, from: stdRoot)
            appendBytes(into: inout ioPath, from: "Io.pw".bytes)
            if fileExists(path: ioPath) {
                val ios: U64 = pathBuf.count
                appendBytes(into: inout pathBuf, from: ioPath)
                loaded.append(<Bind nameStart=ios nameLen=ioPath.count fieldStart=nextModuleId fieldLen=ioPath.count />)
                nextModuleId = nextModuleId + 1
            }
            // force-load @Std/Syntax too: the harness calls `parseItem` and the derive
            // interfaces / built-in derivers (`impl Hash as Derive`) live there. Its
            // `part`s + `import @Std/Core` are followed by the BFS below; a target file
            // that also imports it dedups via pathSeen.
            mut val synPath: Array[U8] = []
            appendBytes(into: inout synPath, from: stdRoot)
            appendBytes(into: inout synPath, from: "Syntax.pw".bytes)
            if fileExists(path: synPath) {
                if pathSeen(buf: pathBuf, loaded: loaded, path: synPath) {
                } else {
                    val sys: U64 = pathBuf.count
                    appendBytes(into: inout pathBuf, from: synPath)
                    loaded.append(<Bind nameStart=sys nameLen=synPath.count fieldStart=nextModuleId fieldLen=synPath.count />)
                    nextModuleId = nextModuleId + 1
                }
            }
        }
        mut val qi: U64 = 0
        while qi < loaded.count {
            val ent: Bind = loaded[qi]
            qi += 1
            val moduleId: U64 = ent.fieldStart
            val path: Array[U8] = extractSpan(buf: pathBuf, start: ent.nameStart, len: ent.nameLen)
            val src: String = readFileBytes(path)
            val sb: Array[U8] = src.bytes
            if c.bytes.count > 0 {
                c.bytes.append(10)
            }
            val fileStart: U64 = c.bytes.count
            c.appendSrc(from: sb)
            c.moduleRanges.append(<Bind nameStart=fileStart nameLen=c.bytes.count - fileStart fieldStart=moduleId fieldLen=0 />)
            // parse the file and lower its items; the returned tree drives discovery.
            val items: Array[TopItemAst] = parseAndLowerFile(c: inout c, fileBytes: sb, fileStart: fileStart)
            val baseLen: U64 = dirPrefixLen(path: path)
            // follow `import`/`part` nodes to child files (in source order); note a
            // `@[...]` directive so the generated sibling can be auto-parted.
            mut val sawDirective: Bool = false
            mut val ii: U64 = 0
            while ii < items.count {
                match items[ii] {
                    TopItemAst.Import(val imp) => {
                        val childPath: Array[U8] = resolveImport(src: c.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, importer: path, baseLen: baseLen, srcRoot: srcRoot, srcRootLen: srcRoot.count, stdRoot: stdRoot, stdRootLen: stdRoot.count)
                        if childPath.count == 0 {
                        } else {
                            if pathSeen(buf: pathBuf, loaded: loaded, path: childPath) {
                            } else {
                                // a `part` (isImport=false) joins this module; an
                                // `import` (true) starts a fresh module.
                                mut val childModule: U64 = moduleId
                                if imp.isImport {
                                    childModule = nextModuleId
                                    nextModuleId = nextModuleId + 1
                                }
                                val cs: U64 = pathBuf.count
                                appendBytes(into: inout pathBuf, from: childPath)
                                loaded.append(<Bind nameStart=cs nameLen=childPath.count fieldStart=childModule fieldLen=childPath.count />)
                            }
                        }
                    }
                    TopItemAst.Directive(val dir) => { sawDirective = true }
                    _ => {}
                }
                ii += 1
            }
            // auto-part (spec/16): a file annotated with `@[...]` pulls in its
            // generated sibling `<file>.gen.pw` as a part of the same module (when it
            // exists); suppressed in gen mode, which is producing that sibling.
            if genMode {
            } else {
                if sawDirective {
                    val genPath: Array[U8] = genSiblingPath(path: path)
                    if genPath.count == 0 {
                    } else {
                        if fileExists(path: genPath) {
                            if pathSeen(buf: pathBuf, loaded: loaded, path: genPath) {
                            } else {
                                val gs: U64 = pathBuf.count
                                appendBytes(into: inout pathBuf, from: genPath)
                                loaded.append(<Bind nameStart=gs nameLen=genPath.count fieldStart=moduleId fieldLen=genPath.count />)
                            }
                        }
                    }
                }
            }
        }
    } else {
        val s: String = readStdin()
        val fileStart: U64 = c.bytes.count
        c.appendSrc(from: s.bytes)
        c.moduleRanges.append(<Bind nameStart=fileStart nameLen=c.bytes.count - fileStart fieldStart=0 fieldLen=0 />)
        val items: Array[TopItemAst] = parseAndLowerFile(c: inout c, fileBytes: s.bytes, fileStart: fileStart)
    }
    // Auto-load the implicit prelude (the ambient Array methods) as its own module,
    // appended + lowered last. It lives next to the binary at `std/Prelude.pw` and
    // needs no `import` — like the `Array` lang-item type, its methods are always in
    // scope. Skipped if absent (a freshly-seeded compiler still builds).
    mut val prelPath: Array[U8] = []
    appendBytes(into: inout prelPath, from: computeStdRoot(arg0: argAt(0).bytes))
    appendBytes(into: inout prelPath, from: "Prelude.pw".bytes)
    if fileExists(path: prelPath) {
        val prelSrc: String = readFileBytes(prelPath)
        if c.bytes.count > 0 {
            c.bytes.append(10)
        }
        val prelStart: U64 = c.bytes.count
        c.appendSrc(from: prelSrc.bytes)
        c.moduleRanges.append(<Bind nameStart=prelStart nameLen=c.bytes.count - prelStart fieldStart=nextModuleId fieldLen=0 />)
        nextModuleId = nextModuleId + 1
        val items: Array[TopItemAst] = parseAndLowerFile(c: inout c, fileBytes: prelSrc.bytes, fileStart: prelStart)
    }
    // built-in-name span cache (kwSpan): append the lang-item names at known
    // offsets so type recovery can name `String`/`U64`/`Array`/… without scanning
    // the source. Before any analysis (which calls kwSpan via exprType).
    buildKwCache(c: inout c)
    // derive (#5): synthesize `@[Eq]`/`@[Ord]` witnesses before any analysis.
    synthesizeDerives(c: inout c)
    // trait provided methods (spec/08): copy each `impl Trait { }` provided
    // method onto every conforming type, so they ride normal method resolution.
    instantiateProvidedMethods(c: inout c)
    // recursive value types (spec/03): mark fields that close a containment cycle
    // onto their owner; codegen stores them behind a heap pointer so the C type is
    // finite (hidden indirection; value semantics kept by deref-read/repoint-write).
    markBoxedFields(c: inout c)
    // ownership validity (spec/03): a struct owning a unique value must be
    // `unique`; parameter access modes must match copyability. Both exit on error.
    checkFieldContagion(c: inout c)
    checkFieldDefaults(c: inout c)
    checkAllParamModes(c: inout c)
    checkArrayElemsNotUnique(c: inout c)
    // match pattern soundness (spec/11): a variant/struct pattern must name real
    // fields (else codegen emits `_m.data.V.<missing>` -> broken C). Loud-reject.
    checkMatchBinds(c: inout c)
    // trait conformance is explicit and complete (spec/08): every requirement of
    // each `impl Type as Trait` must be witnessed (a body method or a `via` alias).
    checkConformances(c: inout c)
    // additional spec-fidelity checks (trait/generics audit): reject a generic vs
    // another same-selector overload, methods on built-in types, and `move fn` on
    // a copyable receiver.
    checkOverloadCollisions(c: inout c)
    checkImplOnBuiltin(c: inout c)
    checkMoveFnReceivers(c: inout c)
    // module visibility (spec/15): a name brought in by `import … with { }` must be
    // part of its module's public surface (`export`). Importing from the wrong
    // module also fails here — that module doesn't get loaded, so the name isn't
    // among the exported (loaded) declarations.
    checkImports(c: inout c)
    checkUseVisibility(c: inout c)
    // gen mode (spec/16): replace the program with the synthesized derive-runner
    // harness `main`. Added after the user-code checks (so its synthetic call to
    // `deriveFromSource`/`write` is exempt from import hygiene) and before
    // instantiation discovery (so its `print`/method instances are emitted).
    if c.genMode {
        synthGenMain(c: inout c)
    }
    // discover concrete generic instantiations to monomorphize.
    collectGenInsts(c: inout c)
    // discover concrete instantiations of generic free functions from call sites
    // (each emitted as a specialized C function `f_<arg-mangle>`).
    collectFnInsts(c: inout c)
    // discover bare function-value references (need a closure-ABI thunk each).
    collectFnThunks(c: inout c)
    // enforce `where T: Trait` bounds (spec/08): each instantiation's concrete
    // type argument must conform to the trait its parameter is bound to.
    checkFnBounds(c: inout c)
    // eager generic type-check (#9): every generic template body is checked once
    // against its `where` bounds — a method/operator on a type parameter must be
    // provided by its bounds (no C++-style "errors only at instantiation").
    checkGenericBodies(c: inout c)
    // unique types cannot be generic type arguments (wrap in Ref[T]); checked
    // after instantiation discovery since it scans the concrete genInsts.
    checkGenericUniqueArgs(c: inout c)
    // typed-AST cache (Phase B): one type slot per expression node, filled lazily
    // by `typeOf` during non-generic emission. Built now — expr ids are stable.
    buildExprTyTable(c: inout c)
    // runtime preamble: includes, immutable String, and the I/O builtins'
    // C runtime (the contract stage0 also injects — emitted here so stage1's
    // output is self-contained).
    write(s: "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n")
    write(s: "typedef struct { const char* data; long long len; } PlewString;\n")
    // ARC for heap buffers: a refcount (long long) sits just before the
    // elements. plew_arc_alloc returns a pointer past the header (rc=1); the
    // owning struct stores `rc` = a pointer to that header (= block start, so
    // free(rc) reclaims the whole block). A NULL rc marks a *borrowed* buffer
    // (e.g. String.bytes views a string's storage; literals are static) that
    // must never be freed. retain/release are NULL-safe no-ops on borrowed rc.
    write(s: "__attribute__((unused)) static void* plew_arc_alloc(long long bytes) { long long* p = (long long*)malloc(sizeof(long long) + (size_t)bytes); p[0] = 1; return (void*)(p + 1); }\n")
    write(s: "__attribute__((unused)) static void plew_arc_retain(long long* rc) { if (rc) (*rc) += 1; }\n")
    write(s: "__attribute__((unused)) static void plew_arc_release(long long* rc) { if (rc && (--(*rc)) == 0) free((void*)rc); }\n")
    // Ref boxes carry the same inline rc header (the Ref value points past it).
    // plew_ref_share retains and returns the pointer for share-on-bind.
    write(s: "__attribute__((unused)) static void* plew_ref_share(void* p) { if (p) ((long long*)p)[-1] += 1; return p; }\n")
    // RawBuffer floor: a refcounted raw buffer, the layer under Array. The block
    // is `[cap][rc][data...]` (two long-long header slots before data); the value
    // points past both, so data[-1]=rc and data[-2]=cap. alloc/cap/isUnique/share/
    // release are type-agnostic (they only touch the header through the void*);
    // the per-element bits (sizeof, indexing) are inlined at the call site.
    write(s: "__attribute__((unused)) static void* plew_rawbuf_alloc(long long elemSize, long long cap) { long long* h = (long long*)malloc(2 * sizeof(long long) + (size_t)(elemSize * cap)); h[0] = cap; h[1] = 1; return (void*)(h + 2); }\n")
    write(s: "__attribute__((unused)) static long long plew_rawbuf_cap(void* p) { return p ? ((long long*)p)[-2] : 0; }\n")
    write(s: "__attribute__((unused)) static int plew_rawbuf_is_unique(void* p) { return p ? (((long long*)p)[-1] == 1) : 1; }\n")
    write(s: "__attribute__((unused)) static void* plew_rawbuf_share(void* p) { if (p) ((long long*)p)[-1] += 1; return p; }\n")
    write(s: "__attribute__((unused)) static void plew_rawbuf_release(void* p) { if (p && (--(((long long*)p)[-1])) == 0) free(((long long*)p) - 2); }\n")
    // A first-class function value (closure) is a fat pointer: the C function
    // (uniform ABI `R fn(void* env, params...)`), an env pointer (NULL for
    // non-capturing closures and bare-function thunks), an inline rc header for
    // the env's ARC, and a `drop` that releases the env's captured fields. The
    // call site casts `fn` to the concrete signature recovered from the value's
    // static function type. share/release manage the env refcount; release runs
    // `drop` then frees the env block at the last reference.
    write(s: "typedef struct { void* fn; void* env; long long* rc; void (*drop)(void*); } PlewClosure;\n")
    write(s: "__attribute__((unused)) static PlewClosure plew_closure_share(PlewClosure cl) { plew_arc_retain(cl.rc); return cl; }\n")
    write(s: "__attribute__((unused)) static void plew_closure_release(PlewClosure cl) { if (cl.rc && (--(*cl.rc)) == 0) { if (cl.drop) cl.drop(cl.env); free((void*)cl.rc); } }\n")
    write(s: "__attribute__((unused)) static int PlewString_eq(PlewString a, PlewString b) { if (a.len != b.len) return 0; for (long long i = 0; i < a.len; i++) if (a.data[i] != b.data[i]) return 0; return 1; }\n")
    write(s: "__attribute__((unused)) static PlewString plew_readStdin(void) { size_t cap = 4096, len = 0; char* buf = (char*)malloc(cap); int ch; while ((ch = getchar()) != EOF) { if (len + 1 >= cap) { cap *= 2; buf = (char*)realloc(buf, cap); } buf[len++] = (char)ch; } PlewString s; s.data = buf; s.len = (long long)len; return s; }\n")
    write(s: "__attribute__((unused)) static void plew_write(PlewString s) { fwrite(s.data, 1, (size_t)s.len, stdout); }\n")
    write(s: "__attribute__((unused)) static void plew_writeByte(unsigned char b) { putchar((int)b); }\n")
    write(s: "__attribute__((noreturn)) static void plew_exit(long long code) { exit((int)code); }\n")
    write(s: "__attribute__((unused)) static void plew_eprint(PlewString s) { fwrite(s.data, 1, (size_t)s.len, stderr); }\n")
    write(s: "__attribute__((noreturn)) static void plew_panic(PlewString m) { fputs(\"panic: \", stderr); fwrite(m.data, 1, (size_t)m.len, stderr); fputc('\\n', stderr); exit(1); }\n")
    write(s: "__attribute__((unused)) static long long plew_div(long long a, long long b) { if (b == 0) plew_panic((PlewString){\"division by zero\", 16}); if (b == -1 && a == INT64_MIN) plew_panic((PlewString){\"integer overflow\", 16}); return a / b; }\n")
    write(s: "__attribute__((unused)) static long long plew_mod(long long a, long long b) { if (b == 0) plew_panic((PlewString){\"remainder by zero\", 17}); if (b == -1) return 0; return a % b; }\n")
    write(s: "static int plew_argc = 0;\nstatic char** plew_argv = 0;\n")
    write(s: "__attribute__((unused)) static long long plew_argCount(void) { return (long long)plew_argc; }\n")
    write(s: "__attribute__((unused)) static PlewString plew_argAt(long long i) { PlewString s; if (i < 0 || i >= plew_argc) { s.data = \"\"; s.len = 0; return s; } s.data = plew_argv[i]; s.len = (long long)strlen(plew_argv[i]); return s; }\n")
    write(s: "__attribute__((unused)) static PlewString plew_readFile(PlewString path) { FILE* f = fopen(path.data, \"rb\"); PlewString s; if (!f) { s.data = \"\"; s.len = 0; return s; } fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET); char* buf = (char*)malloc((size_t)sz + 1); size_t n = fread(buf, 1, (size_t)sz, f); fclose(f); buf[n] = 0; s.data = buf; s.len = (long long)n; return s; }\n")
    // async runtime (event loop / promises / timers), emitted only when the
    // program has an `async fn` (so non-async output stays byte-identical).
    emitAsyncRuntime(c: inout c)
    // forward typedefs for every nominal type (structs + enums).
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if s.typeParams.count > 0 || s.isExtern {
        } else {
            write(s: "typedef struct ")
            writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
            write(s: " ")
            writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
            write(s: ";\n")
        }
        si += 1
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.typeParams.count > 0 {
        } else {
            write(s: "typedef struct ")
            writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
            write(s: " ")
            writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
            write(s: ";\n")
        }
        ei += 1
    }
    // forward typedefs for each monomorphized generic instantiation.
    mut val mfi: U64 = 0
    while mfi < c.genInsts.count {
        emitMonoForward(c: inout c, instRef: c.genInsts[mfi])
        mfi += 1
    }
    // `Array[E]` genInst bodies are emitted HERE (before the nominal struct bodies),
    // unlike other genInsts: an `Array_E` is `{ E* data; uint64_t count; }`, so its
    // element is behind a pointer and only needs E forward-declared (done above) —
    // and a nominal struct (e.g. Comp) holds arrays by value, so `Array_E` must be a
    // complete type before those bodies. Non-array genInsts can hold a type by value
    // and so stay in the post-order mono pass after the nominal bodies.
    mut val afi: U64 = 0
    while afi < c.genInsts.count {
        val aft: TypeRef = c.types[c.genInsts[afi]]
        if rangeEquals(bytes: c.bytes, start: aft.nameStart, len: aft.nameLen, kw: "Array") {
            emitMonoStruct(c: inout c, instRef: c.genInsts[afi])
        }
        afi += 1
    }
    // Array_U8 is always present (String.bytes / file paths). It is hand-written
    // and kept out of the genInst machinery (the U8 guard in isGenericInst); every
    // other `Array[E]` C type comes from the prelude `struct Array[T]` via
    // emitMonoForward/emitMonoStruct above.
    genU8ArrayTypedef()
    // readFileBytes: read a file named by an Array[U8] path (used by multi-file
    // `part` to read a path built from byte spans). Needs Array_U8 above and
    // plew_readFile from the preamble.
    write(s: "__attribute__((unused)) static PlewString plew_readFileBytes(Array_U8 p) { char* path = (char*)malloc((size_t)p.count + 1); memcpy(path, p.data, (size_t)p.count); path[p.count] = 0; PlewString r = plew_readFile((PlewString){path, p.count}); free(path); return r; }\n")
    write(s: "__attribute__((unused)) static long long plew_fileExists(Array_U8 p) { char* path = (char*)malloc((size_t)p.count + 1); memcpy(path, p.data, (size_t)p.count); path[p.count] = 0; FILE* f = fopen(path, \"rb\"); free(path); if (f) { fclose(f); return 1; } return 0; }\n")
    // String construction from a byte array (Core's `stringFromBytes` intrinsic):
    // copies the bytes into a fresh buffer the String owns. (Strings are not yet
    // ARC-freed, so this leaks like other Strings — acceptable for now.)
    write(s: "__attribute__((unused)) static PlewString plew_stringFromBytes(Array_U8 p) { char* buf = (char*)malloc((size_t)p.count + 1); memcpy(buf, p.data, (size_t)p.count); buf[p.count] = 0; PlewString s; s.data = buf; s.len = p.count; return s; }\n")
    // nominal bodies (may contain arrays by value; typedefs above are complete).
    // Emitted in by-value dependency order (a type after every type it holds by
    // value): supports an enum holding a struct payload by value and any struct
    // definition order. See emitNominalBodiesTopo (Codegen/Decl).
    emitNominalBodiesTopo(c: inout c)
    // monomorphized generic bodies (post-order: nested instances first). Array
    // genInst bodies were already emitted above (before the nominal bodies), so
    // skip them here to avoid a duplicate definition.
    mut val mbi: U64 = 0
    while mbi < c.genInsts.count {
        val mbt: TypeRef = c.types[c.genInsts[mbi]]
        if rangeEquals(bytes: c.bytes, start: mbt.nameStart, len: mbt.nameLen, kw: "Array") {
        } else {
            if isGenericEnumInst(c: inout c, ref: c.genInsts[mbi]) {
                emitMonoEnum(c: inout c, instRef: c.genInsts[mbi])
            } else {
                emitMonoStruct(c: inout c, instRef: c.genInsts[mbi])
            }
        }
        mbi += 1
    }
    // struct copy/share/release prototypes — emitted BEFORE the array runtime
    // because array _copy/_release recurse into struct elements (mutual
    // recursion: struct fns also call the array runtime, whose defs come later).
    // deinit prototypes first, so struct _release defs can call a unique field's
    // deinit (the synthetic deinit Func's own proto comes later, redundantly).
    emitDeinitProtos(c: inout c)
    mut val spp: U64 = 0
    while spp < c.structs.count {
        val cps: StructDef = c.structs[spp]
        if cps.typeParams.count > 0 || cps.isExtern {
        } else {
            // CoW copy/share only for copyable structs (unique types never copy).
            if cps.isUnique {
            } else {
                if structNeedsCopy(c: inout c, start: cps.nameStart, len: cps.nameLen) {
                    emitStructCopyProto(c: inout c, si: spp)
                    emitStructShareProto(c: inout c, si: spp)
                }
            }
            if structNeedsRelease(c: inout c, start: cps.nameStart, len: cps.nameLen) {
                emitStructReleaseProto(c: inout c, si: spp)
            }
        }
        spp += 1
    }
    // concrete enum copy/share/release prototypes (value-semantics ARC for
    // recursive enums / enums owning heap). Alongside the struct ones.
    mut val epp: U64 = 0
    while epp < c.enums.count {
        val cpe: EnumDef = c.enums[epp]
        if cpe.typeParams.count > 0 {
        } else {
            if enumNeedsCopy(c: inout c, start: cpe.nameStart, len: cpe.nameLen) {
                emitEnumCopyProto(c: inout c, ei: epp)
                emitEnumShareProto(c: inout c, ei: epp)
            }
            if enumNeedsRelease(c: inout c, start: cpe.nameStart, len: cpe.nameLen) {
                emitEnumReleaseProto(c: inout c, ei: epp)
            }
        }
        epp += 1
    }
    // ALL mono struct/enum copy/share/release prototypes — emitted here (before
    // struct/enum defs) so a `_release`/`_copy` may forward-reference any mono
    // instance's `<Mangle>_release` etc. (e.g. a struct's release calling a boxed
    // generic-enum field's release).
    mut val mep: U64 = 0
    while mep < c.genInsts.count {
        val mei: U64 = c.genInsts[mep]
        val meEnum: Bool = isGenericEnumInst(c: inout c, ref: mei)
        mut val meCopy: Bool = false
        mut val meRel: Bool = false
        if meEnum {
            meCopy = monoEnumNeedsCopy(c: inout c, instRef: mei)
            meRel = monoEnumNeedsRelease(c: inout c, instRef: mei)
        } else {
            if isGenericInst(c: inout c, ref: mei) {
                meCopy = monoStructNeedsCopy(c: inout c, instRef: mei)
                meRel = monoStructNeedsRelease(c: inout c, instRef: mei)
            }
        }
        if meCopy {
            emitMonoModeProto(c: inout c, instRef: mei, mode: 0)
            emitMonoModeProto(c: inout c, instRef: mei, mode: 1)
        }
        if meRel {
            emitMonoModeProto(c: inout c, instRef: mei, mode: 2)
        }
        mep += 1
    }
    // array runtime (element by value -> needs full nominal defs above).
    genU8ArrayRuntime()
    mut val ar: U64 = 0
    while ar < c.arrayElems.count {
        val ae2: Bind = c.arrayElems[ar]
        if skipArrayElem(c: inout c, ae: ae2) {
        } else {
            genArrayRuntimeFns(c: inout c, elemStart: ae2.nameStart, elemLen: ae2.nameLen)
        }
        ar += 1
    }
    // struct copy/share/release definitions (protos emitted before the array
    // runtime above; defs go here since they call the array runtime fns).
    mut val scd: U64 = 0
    while scd < c.structs.count {
        val cs2: StructDef = c.structs[scd]
        if cs2.typeParams.count > 0 || cs2.isExtern {
        } else {
            if cs2.isUnique {
            } else {
                if structNeedsCopy(c: inout c, start: cs2.nameStart, len: cs2.nameLen) {
                    emitStructModeDef(c: inout c, si: scd, mode: 0)
                    emitStructModeDef(c: inout c, si: scd, mode: 1)
                }
            }
            if structNeedsRelease(c: inout c, start: cs2.nameStart, len: cs2.nameLen) {
                emitStructModeDef(c: inout c, si: scd, mode: 2)
            }
        }
        scd += 1
    }
    // concrete enum copy/share/release definitions.
    mut val ecd: U64 = 0
    while ecd < c.enums.count {
        val ce2: EnumDef = c.enums[ecd]
        if ce2.typeParams.count > 0 {
        } else {
            if enumNeedsCopy(c: inout c, start: ce2.nameStart, len: ce2.nameLen) {
                emitEnumModeDef(c: inout c, ei: ecd, mode: 0)
                emitEnumModeDef(c: inout c, ei: ecd, mode: 1)
            }
            if enumNeedsRelease(c: inout c, start: ce2.nameStart, len: ce2.nameLen) {
                emitEnumModeDef(c: inout c, ei: ecd, mode: 2)
            }
        }
        ecd += 1
    }
    // mono struct/enum copy/share/release definitions (unified; protos above).
    mut val mcd: U64 = 0
    while mcd < c.genInsts.count {
        val mdi: U64 = c.genInsts[mcd]
        val mdEnum: Bool = isGenericEnumInst(c: inout c, ref: mdi)
        mut val mdCopy: Bool = false
        mut val mdRel: Bool = false
        if mdEnum {
            mdCopy = monoEnumNeedsCopy(c: inout c, instRef: mdi)
            mdRel = monoEnumNeedsRelease(c: inout c, instRef: mdi)
        } else {
            if isGenericInst(c: inout c, ref: mdi) {
                mdCopy = monoStructNeedsCopy(c: inout c, instRef: mdi)
                mdRel = monoStructNeedsRelease(c: inout c, instRef: mdi)
            }
        }
        if mdCopy {
            emitMonoModeDef(c: inout c, instRef: mdi, isEnum: mdEnum, mode: 0)
            emitMonoModeDef(c: inout c, instRef: mdi, isEnum: mdEnum, mode: 1)
        }
        if mdRel {
            emitMonoModeDef(c: inout c, instRef: mdi, isEnum: mdEnum, mode: 2)
        }
        mcd += 1
    }
    // (Function types need no per-signature typedef: every function value is the
    // uniform PlewClosure struct from the preamble.)
    // closure env structs (after all value types, before any signature/closure
    // that allocates one).
    emitClosureEnvs(c: inout c)
    // async frame structs + resume forward-decls (frame fields may hold any value
    // type, so emit after all nominal/array/closure-env defs, before prototypes).
    emitAsyncDecls(c: inout c)
    // prototypes (skip main and generic templates — the latter are emitted per
    // instantiation below).
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if nameIsMain(c: inout c, f: f) {
        } else {
            if f.isExtern {
                // `extern "plew-intrinsic"` fn: the runtime provides `plew_<name>`;
                // emit no prototype/body (calls lower to it directly).
            } else {
            if f.typeParams.count > 0 {
            } else {
                if methodRecvIsTrait(c: inout c, f: f) {
                    // a provided-method template (receiver = a trait): emitted per
                    // conforming type, not under the trait name.
                } else {
                    // demand-driven: a copied provided combinator is emitted only if
                    // its adapter return is reachable, else its prototype references an
                    // unregistered FilterIter[…] (an unbounded self-returning family).
                    if f.isProvided && !providedRetReachable(c: inout c, mf: f, recvInstRef: 0) {
                    } else {
                        // its signature may mention `Self`/`Item`; set the env so the
                        // prototype matches the body (`genFunc` sets it).
                        if f.hasRecv {
                            setSelfItemEnv(c: inout c, recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0)
                        } else {
                            clearSelfItemEnv(c: inout c)
                        }
                        genSignature(c: inout c, f: f)
                        write(s: ";\n")
                        clearSelfItemEnv(c: inout c)
                    }
                }
            }
            }
        }
        i += 1
    }
    // generic method prototypes (one per receiver instantiation).
    emitMonoMethods(c: inout c, proto: true)
    // generic Array method prototypes (one per array element type).
    emitArrayMethods(c: inout c, proto: true)
    // generic free function instance prototypes (one per call-site instantiation).
    emitMonoFns(c: inout c, proto: true)
    // function-value thunk prototypes.
    emitThunks(c: inout c, proto: true)
    // lambda-lifted closure prototypes.
    emitClosures(c: inout c, proto: true)
    // bodies (skip generic templates).
    for val j in 0..<c.funcs.count {
        val fb: Func = c.funcs[j]
        // gen mode: the user's own `main` is dead (the synthesized harness main at
        // `genMainIdx` is the program), so skip every other `main` to avoid two C
        // `main`s. Non-gen builds emit all funcs as usual.
        mut val skipUserMain: Bool = false
        if c.genMode {
            if nameIsMain(c: inout c, f: fb) {
                if j == c.genMainIdx {
                } else {
                    skipUserMain = true
                }
            }
        }
        if skipUserMain {
        } else {
        if fb.typeParams.count > 0 {
        } else {
            if fb.isExtern {
                // `extern "plew-intrinsic"` fn: runtime-provided, no body.
            } else {
            if methodRecvIsTrait(c: inout c, f: fb) {
                // provided-method template — skip (emitted per conforming type).
            } else {
                if fb.isProvided && !providedRetReachable(c: inout c, mf: fb, recvInstRef: 0) {
                    // demand-driven: matches the prototype loop's skip above.
                } else {
                    if fb.isAsync {
                        genAsyncFunc(c: inout c, fi: j)
                    } else {
                        genFunc(c: inout c, fi: j)
                    }
                }
            }
            }
        }
        }
    }
    // generic method bodies.
    emitMonoMethods(c: inout c, proto: false)
    // generic Array method bodies (one per array element type).
    emitArrayMethods(c: inout c, proto: false)
    // generic free function instance bodies.
    emitMonoFns(c: inout c, proto: false)
    // function-value thunk bodies.
    emitThunks(c: inout c, proto: false)
    // lambda-lifted closure bodies.
    emitClosures(c: inout c, proto: false)
}
