// Part of the Plew compiler module (root: _.pw). Recursive-descent parser:
// token stream -> arena AST (plus import/part directive handling).

// ---- expression parser (precedence climbing) ----

// Binary operator precedence (higher binds tighter). Spec order, low to high:
// || < && < comparison < | < ^ < & < shift < +- < */%.
fn binPrec(k: Kind) -> I64 {
    return match k {
        Kind.PipePipe => 1
        Kind.AmpAmp => 2
        Kind.EqEq => 3
        Kind.Ne => 3
        Kind.Lt => 3
        Kind.Le => 3
        Kind.Gt => 3
        Kind.Ge => 3
        Kind.Pipe => 4
        Kind.Caret => 5
        Kind.Amp => 6
        Kind.Shl => 7
        Kind.Shr => 7
        Kind.Plus => 8
        Kind.Minus => 8
        Kind.Star => 9
        Kind.Slash => 9
        Kind.Percent => 9
        _ => 0
    }
}

// Decode a character literal token `'…'` (span includes both quotes) to its
// Unicode codepoint. Only a single scalar is allowed; multi-scalar (Grapheme)
// literals are rejected (Grapheme type unimplemented). UTF-8 is decoded with the
// canonical bitwise form (continuation bytes carry 6 bits each).
fn charValue(c: inout Comp, t: Tok) -> I64 {
    val contentLen: U64 = t.len - 2
    if contentLen == 0 {
        compileErrorAt(line: lineOf(c: inout c, offset: t.start), msg: "empty character literal")
    }
    val p: U64 = t.start + 1
    val b0: U8 = c.bytes[p]
    if b0 == '\\' {
        if contentLen != 2 {
            compileErrorAt(line: lineOf(c: inout c, offset: t.start), msg: "character literal must be a single scalar")
        }
        val e: U8 = c.bytes[p + 1]
        if e == 'n' { return '\n' }
        if e == 't' { return '\t' }
        if e == 'r' { return '\r' }
        if e == '0' { return '\0' }
        // \\ \' \" and any other escape: the byte itself
        return e
    }
    mut val consumed: U64 = 1
    mut val value: I64 = 0
    if b0 < 128 {
        consumed = 1
        value = b0
    } else {
        if b0 < 224 {
            consumed = 2
            value = ((b0 & 31) << 6) | (c.bytes[p + 1] & 63)
        } else {
            if b0 < 240 {
                consumed = 3
                value = ((b0 & 15) << 12) | ((c.bytes[p + 1] & 63) << 6) | (c.bytes[p + 2] & 63)
            } else {
                consumed = 4
                value = ((b0 & 7) << 18) | ((c.bytes[p + 1] & 63) << 12) | ((c.bytes[p + 2] & 63) << 6) | (c.bytes[p + 3] & 63)
            }
        }
    }
    if contentLen != consumed {
        compileErrorAt(line: lineOf(c: inout c, offset: t.start), msg: "multi-scalar character literal (Grapheme) is not yet supported")
    }
    return value
}

fn parsePrimary(c: inout Comp) -> U64 {
    val k: Kind = c.curKind()
    match k {
        Kind.Int => {
            val t: Tok = c.cur()
            c.advance()
            val v: I64 = c.tokenValue(t: t)
            // optional type suffix: an integer-type name written immediately
            // after the digits with no space (`5U64`, `1I32`). It gives a
            // context-free literal its type (spec: no default type).
            mut val sStart: U64 = 0
            mut val sLen: U64 = 0
            match c.curKind() {
                Kind.Ident => {
                    val st: Tok = c.cur()
                    if st.start == t.start + t.len {
                        if isIntType(c: inout c, start: st.start, len: st.len) {
                            sStart = st.start
                            sLen = st.len
                            c.advance()
                        }
                    }
                }
                _ => {}
            }
            return c.pushExpr(e: <Expr.Int value=v offset=t.start isBool=false tyStart=sStart tyLen=sLen />)
        }
        Kind.Char => {
            val t: Tok = c.cur()
            c.advance()
            val v: I64 = charValue(c: inout c, t: t)
            return c.pushExpr(e: <Expr.Int value=v offset=t.start isBool=false tyStart=0 tyLen=0 />)
        }
        Kind.Ident => {
            val t: Tok = c.cur()
            match c.peekKind(off: 1) {
                Kind.LParen => {
                    c.advance()
                    c.advance()
                    val args: Array[Arg] = parseCallArgs(c: inout c)
                    return c.pushExpr(e: <Expr.Call nameStart=t.start nameLen=t.len args=args />)
                }
                _ => {
                    c.advance()
                    return c.pushExpr(e: <Expr.Ident start=t.start len=t.len />)
                }
            }
        }
        Kind.KwTrue => {
            val tt: Tok = c.cur()
            c.advance()
            return c.pushExpr(e: <Expr.Int value=1 offset=tt.start isBool=true tyStart=0 tyLen=0 />)
        }
        Kind.KwFalse => {
            val tf: Tok = c.cur()
            c.advance()
            return c.pushExpr(e: <Expr.Int value=0 offset=tf.start isBool=true tyStart=0 tyLen=0 />)
        }
        Kind.LParen => {
            c.advance()
            val inner: U64 = parseExpr(c: inout c)
            match c.curKind() {
                Kind.RParen => { c.advance() }
                _ => {}
            }
            return inner
        }
        Kind.Lt => {
            return parseMake(c: inout c)
        }
        Kind.KwMatch => {
            return parseMatchExpr(c: inout c)
        }
        Kind.KwIf => {
            return parseIfExpr(c: inout c)
        }
        Kind.Str => {
            val t: Tok = c.cur()
            c.advance()
            return c.pushExpr(e: <Expr.Str start=t.start len=t.len />)
        }
        Kind.LBracket => {
            c.advance()
            mut val elems: Array[U64] = []
            while true {
                c.skipNewlines()
                match c.curKind() {
                    Kind.RBracket => {
                        c.advance()
                        break
                    }
                    Kind.Eof => { break }
                    _ => {
                        val e: U64 = parseExpr(c: inout c)
                        elems.append(e)
                        match c.curKind() {
                            Kind.Comma => { c.advance() }
                            _ => {}
                        }
                    }
                }
            }
            return c.pushExpr(e: <Expr.Array elems=elems />)
        }
        _ => {
            val te: Tok = c.cur()
            c.advance()
            return c.pushExpr(e: <Expr.Int value=0 offset=te.start isBool=false tyStart=0 tyLen=0 />)
        }
    }
}

fn parseUnary(c: inout Comp) -> U64 {
    val k: Kind = c.curKind()
    match k {
        Kind.Minus => {
            c.advance()
            val o: U64 = parseUnary(c: inout c)
            return c.pushExpr(e: <Expr.Unary op=57 operand=o />)
        }
        Kind.Bang => {
            c.advance()
            val o: U64 = parseUnary(c: inout c)
            return c.pushExpr(e: <Expr.Unary op=63 operand=o />)
        }
        Kind.Tilde => {
            c.advance()
            val o: U64 = parseUnary(c: inout c)
            return c.pushExpr(e: <Expr.Unary op=79 operand=o />)
        }
        _ => { return parsePostfix(c: inout c) }
    }
}

// Postfix chain: `.field` accesses (index `[]` comes later).
fn parsePostfix(c: inout Comp) -> U64 {
    mut val e: U64 = parsePrimary(c: inout c)
    while true {
        match c.curKind() {
            Kind.Dot => {
                c.advance()
                val nameTok: Tok = c.cur()
                c.advance()
                match c.curKind() {
                    Kind.LParen => {
                        c.advance()
                        val args: Array[Arg] = parseCallArgs(c: inout c)
                        e = c.pushExpr(e: <Expr.Method recv=e nameStart=nameTok.start nameLen=nameTok.len args=args />)
                    }
                    _ => {
                        e = c.pushExpr(e: <Expr.Field base=e nameStart=nameTok.start nameLen=nameTok.len />)
                    }
                }
            }
            Kind.LBracket => {
                c.advance()
                val idx: U64 = parseExpr(c: inout c)
                match c.curKind() {
                    Kind.RBracket => { c.advance() }
                    _ => {}
                }
                e = c.pushExpr(e: <Expr.Index base=e index=idx />)
            }
            Kind.KwAs => {
                c.advance()
                val ty: PType = parseTypeTok(c: inout c)
                e = c.pushExpr(e: <Expr.Cast operand=e tyStart=ty.start tyLen=ty.len />)
            }
            _ => { break }
        }
    }
    return e
}

// JSX construction `<Type field=expr ... />`. Current token is `<`. v3 handles
// struct construction; a dotted `.Variant` path (enum) is consumed but not yet
// modeled.
fn parseMake(c: inout Comp) -> U64 {
    c.advance()
    val typeTok: Tok = c.cur()
    c.advance()
    mut val variantStart: U64 = 0
    mut val variantLen: U64 = 0
    mut val isEnum: Bool = false
    match c.curKind() {
        Kind.Dot => {
            c.advance()
            val vTok: Tok = c.cur()
            c.advance()
            variantStart = vTok.start
            variantLen = vTok.len
            isEnum = true
        }
        _ => {}
    }
    mut val fields: Array[MakeField] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.SlashGt => {
                c.advance()
                break
            }
            Kind.Gt => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Ident => {
                val fTok: Tok = c.cur()
                c.advance()
                match c.curKind() {
                    Kind.Eq => { c.advance() }
                    _ => {}
                }
                val v: U64 = parseExpr(c: inout c)
                fields.append(<MakeField nameStart=fTok.start nameLen=fTok.len value=v />)
            }
            _ => { c.advance() }
        }
    }
    return c.pushExpr(e: <Expr.Make typeStart=typeTok.start typeLen=typeTok.len variantStart=variantStart variantLen=variantLen isEnum=isEnum fields=fields />)
}

fn parseBin(c: inout Comp, minPrec: I64) -> U64 {
    mut val left: U64 = parseUnary(c: inout c)
    while true {
        val k: Kind = c.curKind()
        val prec: I64 = binPrec(k: k)
        if prec == 0 {
            break
        }
        if prec < minPrec {
            break
        }
        val op: I64 = kindCode(k: k)
        c.advance()
        val right: U64 = parseBin(c: inout c, minPrec: prec + 1)
        left = c.pushExpr(e: <Expr.Binary op=op lhs=left rhs=right />)
    }
    return left
}

fn parseExpr(c: inout Comp) -> U64 {
    return parseBin(c: inout c, minPrec: 1)
}

// Parse a call's argument list (current token is just past `(`). Labels are
// accepted (`label: expr`) and dropped (positional C emission); an optional
// `inout` before the expression marks a by-reference argument.
fn parseCallArgs(c: inout Comp) -> Array[Arg] {
    mut val args: Array[Arg] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RParen => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            _ => {
                // optional argument label `name:`
                mut val labelStart: U64 = 0
                mut val labelLen: U64 = 0
                mut val hasLabel: Bool = false
                match c.curKind() {
                    Kind.Ident => {
                        match c.peekKind(off: 1) {
                            Kind.Colon => {
                                val lt: Tok = c.cur()
                                labelStart = lt.start
                                labelLen = lt.len
                                hasLabel = true
                                c.advance()
                                c.advance()
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                // optional `inout` marker
                mut val isInout: Bool = false
                match c.curKind() {
                    Kind.KwInout => {
                        c.advance()
                        isInout = true
                    }
                    _ => {}
                }
                val e: U64 = parseExpr(c: inout c)
                args.append(<Arg expr=e isInout=isInout labelStart=labelStart labelLen=labelLen hasLabel=hasLabel />)
                match c.curKind() {
                    Kind.Comma => { c.advance() }
                    _ => {}
                }
            }
        }
    }
    return args
}

// ---- statement parser ----

fn isAssignOp(k: Kind) -> Bool {
    match k {
        Kind.Eq => { return true }
        Kind.PlusEq => { return true }
        Kind.MinusEq => { return true }
        Kind.StarEq => { return true }
        Kind.SlashEq => { return true }
        Kind.PercentEq => { return true }
        Kind.AmpEq => { return true }
        Kind.PipeEq => { return true }
        Kind.CaretEq => { return true }
        Kind.ShlEq => { return true }
        Kind.ShrEq => { return true }
        _ => { return false }
    }
}

// Parse a type annotation into a PType. For `Array[E]` the span names the
// element E and isArray is true; otherwise the span names the type itself
// (scalar, String, or a named struct/enum). Nested element types beyond the
// first token are consumed but not modeled (plewc.pw uses none).
fn parseTypeTok(c: inout Comp) -> PType {
    val head: Tok = c.cur()
    c.advance()
    match c.curKind() {
        Kind.LBracket => {
            c.advance()
            val elem: Tok = c.cur()
            c.advance()
            mut val depth: I64 = 1
            while depth > 0 {
                match c.curKind() {
                    Kind.LBracket => { depth += 1 }
                    Kind.RBracket => { depth -= 1 }
                    Kind.Eof => { break }
                    _ => {}
                }
                c.advance()
            }
            return <PType start=elem.start len=elem.len isArray=true />
        }
        _ => {}
    }
    return <PType start=head.start len=head.len isArray=false />
}

// Register an Array element type name for later monomorphization (deduped).
fn recordArrayElem(c: inout Comp, ty: PType) {
    if ty.isArray {
        mut val i: U64 = 0
        while i < c.arrayElems.count {
            val e: Bind = c.arrayElems[i]
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: ty.start, bLen: ty.len) {
                return
            }
            i += 1
        }
        c.arrayElems.append(<Bind nameStart=ty.start nameLen=ty.len fieldStart=ty.start fieldLen=ty.len />)
    }
}

// `[mut] val name [: Type] = expr`. `mutable` says whether `mut` preceded it;
// the current token is `val`.
fn parseLet(c: inout Comp, mutable: Bool) -> U64 {
    c.advance()
    val nameTok: Tok = c.cur()
    c.advance()
    mut val tyStart: U64 = 0
    mut val tyLen: U64 = 0
    mut val tyIsArray: Bool = false
    match c.curKind() {
        Kind.Colon => {
            c.advance()
            val ty: PType = parseTypeTok(c: inout c)
            tyStart = ty.start
            tyLen = ty.len
            tyIsArray = ty.isArray
            recordArrayElem(c: inout c, ty: ty)
        }
        _ => {}
    }
    // `=`
    match c.curKind() {
        Kind.Eq => { c.advance() }
        _ => {}
    }
    val init: U64 = parseExpr(c: inout c)
    return c.pushStmt(s: <Stmt.Let mutable=mutable nameStart=nameTok.start nameLen=nameTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray init=init />)
}

fn parsePrint(c: inout Comp) -> U64 {
    val kw: Tok = c.cur()
    c.advance()
    c.advance()
    val e: U64 = parseExpr(c: inout c)
    match c.curKind() {
        Kind.RParen => { c.advance() }
        _ => {}
    }
    return c.pushStmt(s: <Stmt.Print expr=e offset=kw.start />)
}

// `panic <msg>`: a diverging statement. The `panic` identifier is current.
fn parsePanic(c: inout Comp) -> U64 {
    val kw: Tok = c.cur()
    c.advance()
    val msg: U64 = parseExpr(c: inout c)
    return c.pushStmt(s: <Stmt.Panic msg=msg offset=kw.start />)
}

fn parseReturn(c: inout Comp) -> U64 {
    c.advance()
    match c.curKind() {
        Kind.Newline => { return c.pushStmt(s: <Stmt.Return value=0 hasValue=false />) }
        Kind.RBrace => { return c.pushStmt(s: <Stmt.Return value=0 hasValue=false />) }
        Kind.Eof => { return c.pushStmt(s: <Stmt.Return value=0 hasValue=false />) }
        _ => {
            val e: U64 = parseExpr(c: inout c)
            return c.pushStmt(s: <Stmt.Return value=e hasValue=true />)
        }
    }
}

fn parseIf(c: inout Comp) -> U64 {
    c.advance()
    val cond: U64 = parseExpr(c: inout c)
    val thenBlk: U64 = parseBlock(c: inout c)
    c.skipNewlines()
    match c.curKind() {
        Kind.KwElse => {
            c.advance()
            // `else if` chains as a nested if inside a synthesized block.
            match c.curKind() {
                Kind.KwIf => {
                    val nested: U64 = parseIf(c: inout c)
                    mut val one: Array[U64] = []
                    one.append(nested)
                    val blkId: U64 = c.blocks.count
                    c.blocks.append(<Block stmts=one />)
                    return c.pushStmt(s: <Stmt.If cond=cond thenBlk=thenBlk elseBlk=blkId hasElse=true />)
                }
                _ => {
                    val elseBlk: U64 = parseBlock(c: inout c)
                    return c.pushStmt(s: <Stmt.If cond=cond thenBlk=thenBlk elseBlk=elseBlk hasElse=true />)
                }
            }
        }
        _ => {
            return c.pushStmt(s: <Stmt.If cond=cond thenBlk=thenBlk elseBlk=0 hasElse=false />)
        }
    }
}

// `if cond { ... give a } else { ... give b }` in expression position. Mirrors
// parseIf but `else` is mandatory (a value-position `if` must always yield) and
// it produces an Expr.IfExpr. `else if` chains as a nested if-expr wrapped in a
// synthesized `give` block, so codegen sees a uniform else block.
fn parseIfExpr(c: inout Comp) -> U64 {
    c.advance()
    val cond: U64 = parseExpr(c: inout c)
    val thenBlk: U64 = parseBlock(c: inout c)
    c.skipNewlines()
    match c.curKind() {
        Kind.KwElse => { c.advance() }
        _ => {}
    }
    match c.curKind() {
        Kind.KwIf => {
            val nested: U64 = parseIfExpr(c: inout c)
            mut val one: Array[U64] = []
            one.append(c.pushStmt(s: <Stmt.Give value=nested />))
            val blkId: U64 = c.blocks.count
            c.blocks.append(<Block stmts=one />)
            return c.pushExpr(e: <Expr.IfExpr cond=cond thenBlk=thenBlk elseBlk=blkId />)
        }
        _ => {
            val elseBlk: U64 = parseBlock(c: inout c)
            return c.pushExpr(e: <Expr.IfExpr cond=cond thenBlk=thenBlk elseBlk=elseBlk />)
        }
    }
}

// `give <expr>`: yield the enclosing value-position block's result.
fn parseGive(c: inout Comp) -> U64 {
    c.advance()
    val v: U64 = parseExpr(c: inout c)
    return c.pushStmt(s: <Stmt.Give value=v />)
}

fn parseWhile(c: inout Comp) -> U64 {
    c.advance()
    val cond: U64 = parseExpr(c: inout c)
    val body: U64 = parseBlock(c: inout c)
    return c.pushStmt(s: <Stmt.While cond=cond body=body />)
}

// `for val name in iter { body }` where iter is `lo ..< hi` / `lo ..= hi`
// (a range) or an array expression.
fn parseFor(c: inout Comp) -> U64 {
    c.advance()
    match c.curKind() {
        Kind.KwVal => { c.advance() }
        _ => {}
    }
    val nameTok: Tok = c.cur()
    c.advance()
    match c.curKind() {
        Kind.KwIn => { c.advance() }
        _ => {}
    }
    val lo: U64 = parseExpr(c: inout c)
    mut val isRange: Bool = false
    mut val inclusive: Bool = false
    mut val hi: U64 = 0
    match c.curKind() {
        Kind.DotDotLt => {
            c.advance()
            isRange = true
            hi = parseExpr(c: inout c)
        }
        Kind.DotDotEq => {
            c.advance()
            isRange = true
            inclusive = true
            hi = parseExpr(c: inout c)
        }
        _ => {}
    }
    c.skipNewlines()
    val body: U64 = parseBlock(c: inout c)
    return c.pushStmt(s: <Stmt.For varStart=nameTok.start varLen=nameTok.len isRange=isRange inclusive=inclusive iter=lo rangeHi=hi body=body />)
}

fn parseExprOrAssign(c: inout Comp) -> U64 {
    val lhs: U64 = parseExpr(c: inout c)
    val k: Kind = c.curKind()
    if isAssignOp(k: k) {
        val op: I64 = kindCode(k: k)
        c.advance()
        val rhs: U64 = parseExpr(c: inout c)
        return c.pushStmt(s: <Stmt.Assign op=op target=lhs value=rhs />)
    }
    return c.pushStmt(s: <Stmt.ExprStmt expr=lhs />)
}

// Parse a single match-arm pattern: `_` (wildcard) or `Enum.Variant
// [{ val f, ... }]`. Stops at the `|` (or-pattern) or `=>` that follows.
fn parsePattern(c: inout Comp) -> PatInfo {
    val firstTok: Tok = c.cur()
    mut val isWildcard: Bool = false
    mut val enumStart: U64 = 0
    mut val enumLen: U64 = 0
    mut val variantStart: U64 = 0
    mut val variantLen: U64 = 0
    mut val binds: Array[Bind] = []
    if rangeEquals(bytes: c.bytes, start: firstTok.start, len: firstTok.len, kw: "_") {
        isWildcard = true
        c.advance()
    } else {
        enumStart = firstTok.start
        enumLen = firstTok.len
        c.advance()
        // `.Variant`
        match c.curKind() {
            Kind.Dot => { c.advance() }
            _ => {}
        }
        val vTok: Tok = c.cur()
        variantStart = vTok.start
        variantLen = vTok.len
        c.advance()
        // optional `{ val f, ... }`
        match c.curKind() {
            Kind.LBrace => {
                c.advance()
                while true {
                    c.skipNewlines()
                    match c.curKind() {
                        Kind.RBrace => {
                            c.advance()
                            break
                        }
                        Kind.Eof => { break }
                        Kind.KwVal => {
                            // punning `val x`: field and binding are the same name.
                            c.advance()
                            val bTok: Tok = c.cur()
                            c.advance()
                            binds.append(<Bind nameStart=bTok.start nameLen=bTok.len fieldStart=bTok.start fieldLen=bTok.len />)
                            match c.curKind() {
                                Kind.Comma => { c.advance() }
                                _ => {}
                            }
                        }
                        Kind.Ident => {
                            // `field: val name` (rename) or `field: _` (discard).
                            val fTok: Tok = c.cur()
                            c.advance()
                            match c.curKind() {
                                Kind.Colon => { c.advance() }
                                _ => {}
                            }
                            match c.curKind() {
                                Kind.KwVal => {
                                    c.advance()
                                    val bTok: Tok = c.cur()
                                    c.advance()
                                    binds.append(<Bind nameStart=bTok.start nameLen=bTok.len fieldStart=fTok.start fieldLen=fTok.len />)
                                }
                                _ => {
                                    // `field: _` -> discard (consume the `_`), no binding.
                                    c.advance()
                                }
                            }
                            match c.curKind() {
                                Kind.Comma => { c.advance() }
                                _ => {}
                            }
                        }
                        _ => { c.advance() }
                    }
                }
            }
            _ => {}
        }
    }
    return <PatInfo isWildcard=isWildcard enumStart=enumStart enumLen=enumLen variantStart=variantStart variantLen=variantLen binds=binds />
}

// Do two bind lists introduce the same set of names? (order-independent; names
// are unique within a pattern, so equal counts + subset both ways = set equality)
fn bindNamesMatch(c: inout Comp, a: Array[Bind], b: Array[Bind]) -> Bool {
    if a.count != b.count {
        return false
    }
    mut val i: U64 = 0
    while i < a.count {
        val an: Bind = a[i]
        mut val found: Bool = false
        mut val j: U64 = 0
        while j < b.count {
            val bn: Bind = b[j]
            if spansEqual(c: inout c, aStart: an.nameStart, aLen: an.nameLen, bStart: bn.nameStart, bLen: bn.nameLen) {
                found = true
            }
            j += 1
        }
        if found {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Parse an arm's full pattern list `Pat ( | Pat )*` (or-patterns), consuming the
// trailing `=>`. Returns one PatInfo per alternative; the caller emits one
// MatchArm per alternative sharing the arm body. Spec: every alternative must
// bind the same set of names (so the shared body sees well-defined bindings).
fn parseArmPatterns(c: inout Comp) -> Array[PatInfo] {
    val startOff: U64 = c.cur().start
    mut val pats: Array[PatInfo] = []
    pats.append(parsePattern(c: inout c))
    while true {
        match c.curKind() {
            Kind.Pipe => {
                c.advance()
                c.skipNewlines()
                pats.append(parsePattern(c: inout c))
            }
            _ => { break }
        }
    }
    match c.curKind() {
        Kind.FatArrow => { c.advance() }
        _ => {}
    }
    // or-pattern alternatives must bind the same names (Rust-style).
    mut val pi: U64 = 1
    while pi < pats.count {
        val p0: PatInfo = pats[0]
        val pn: PatInfo = pats[pi]
        if bindNamesMatch(c: inout c, a: p0.binds, b: pn.binds) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: startOff), msg: "or-pattern alternatives must bind the same names")
        }
        pi += 1
    }
    return pats
}

// `match scrut { (pattern => { body })* }` in statement position: arm bodies are
// blocks. (Expression-position match with bare-expression arms is parseMatchExpr.)
fn parseMatch(c: inout Comp) -> U64 {
    c.advance()
    val scrut: U64 = parseExpr(c: inout c)
    c.skipNewlines()
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val arms: Array[MatchArm] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            _ => {
                val pats: Array[PatInfo] = parseArmPatterns(c: inout c)
                c.skipNewlines()
                val body: U64 = parseBlock(c: inout c)
                for val pi in pats {
                    arms.append(<MatchArm isWildcard=pi.isWildcard enumStart=pi.enumStart enumLen=pi.enumLen variantStart=pi.variantStart variantLen=pi.variantLen binds=pi.binds body=body />)
                }
            }
        }
    }
    return c.pushStmt(s: <Stmt.Match scrut=scrut arms=arms />)
}

// `match scrut { pattern => expr, ... }` in expression position: each arm yields
// an expression (no block). Lowers to a C statement-expression in codegen.
fn parseMatchExpr(c: inout Comp) -> U64 {
    c.advance()
    val scrut: U64 = parseExpr(c: inout c)
    c.skipNewlines()
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val arms: Array[MatchArm] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            _ => {
                val pats: Array[PatInfo] = parseArmPatterns(c: inout c)
                val body: U64 = parseExpr(c: inout c)
                for val pi in pats {
                    arms.append(<MatchArm isWildcard=pi.isWildcard enumStart=pi.enumStart enumLen=pi.enumLen variantStart=pi.variantStart variantLen=pi.variantLen binds=pi.binds body=body />)
                }
                match c.curKind() {
                    Kind.Comma => { c.advance() }
                    _ => {}
                }
            }
        }
    }
    return c.pushExpr(e: <Expr.MatchExpr scrut=scrut arms=arms />)
}

fn parseStmt(c: inout Comp) -> U64 {
    val k: Kind = c.curKind()
    match k {
        Kind.KwVal => { return parseLet(c: inout c, mutable: false) }
        Kind.KwMut => {
            c.advance()
            return parseLet(c: inout c, mutable: true)
        }
        Kind.KwIf => { return parseIf(c: inout c) }
        Kind.KwWhile => { return parseWhile(c: inout c) }
        Kind.KwFor => { return parseFor(c: inout c) }
        Kind.KwMatch => { return parseMatch(c: inout c) }
        Kind.KwBreak => {
            c.advance()
            return c.pushStmt(s: <Stmt.Break />)
        }
        Kind.KwContinue => {
            c.advance()
            return c.pushStmt(s: <Stmt.Continue />)
        }
        Kind.KwReturn => { return parseReturn(c: inout c) }
        Kind.Ident => {
            if c.identIs(kw: "print") {
                match c.peekKind(off: 1) {
                    Kind.LParen => { return parsePrint(c: inout c) }
                    _ => { return parseExprOrAssign(c: inout c) }
                }
            }
            if c.identIs(kw: "panic") {
                return parsePanic(c: inout c)
            }
            return parseExprOrAssign(c: inout c)
        }
        Kind.KwGive => { return parseGive(c: inout c) }
        _ => { return parseExprOrAssign(c: inout c) }
    }
}

// Parse `{ stmt* }`. Current token must be `{`.
fn parseBlock(c: inout Comp) -> U64 {
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val stmts: Array[U64] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            _ => {
                val s: U64 = parseStmt(c: inout c)
                stmts.append(s)
            }
        }
    }
    val id: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    return id
}

// ---- declaration parser ----

// `fn name ( params ) [-> ret] { body }`. The leading `fn` (and any `inout`
// receiver marker for methods) is already consumed; the current token is the
// name. `hasRecv`/`recv*`/`selfInout` describe an `impl Type` method receiver
// (none for a free function).
fn parseFuncCommon(c: inout Comp, hasRecv: Bool, recvStart: U64, recvLen: U64, selfInout: Bool) {
    val nameTok: Tok = c.cur()
    c.advance()
    mut val params: Array[Param] = []
    match c.curKind() {
        Kind.LParen => {
            c.advance()
            while true {
                c.skipNewlines()
                val k: Kind = c.curKind()
                match k {
                    Kind.RParen => {
                        c.advance()
                        break
                    }
                    Kind.Eof => { break }
                    _ => {
                        val pTok: Tok = c.cur()
                        c.advance()
                        mut val pTyStart: U64 = 0
                        mut val pTyLen: U64 = 0
                        mut val pTyIsArray: Bool = false
                        mut val pIsInout: Bool = false
                        match c.curKind() {
                            Kind.Colon => {
                                c.advance()
                                // optional `inout` before the type
                                match c.curKind() {
                                    Kind.KwInout => {
                                        c.advance()
                                        pIsInout = true
                                    }
                                    _ => {}
                                }
                                val pty: PType = parseTypeTok(c: inout c)
                                pTyStart = pty.start
                                pTyLen = pty.len
                                pTyIsArray = pty.isArray
                                recordArrayElem(c: inout c, ty: pty)
                            }
                            _ => {}
                        }
                        params.append(<Param nameStart=pTok.start nameLen=pTok.len tyStart=pTyStart tyLen=pTyLen tyIsArray=pTyIsArray isInout=pIsInout />)
                        match c.curKind() {
                            Kind.Comma => { c.advance() }
                            _ => {}
                        }
                    }
                }
            }
        }
        _ => {}
    }
    mut val hasRet: Bool = false
    mut val retStart: U64 = 0
    mut val retLen: U64 = 0
    mut val retIsArray: Bool = false
    match c.curKind() {
        Kind.Arrow => {
            c.advance()
            hasRet = true
            val rty: PType = parseTypeTok(c: inout c)
            retStart = rty.start
            retLen = rty.len
            retIsArray = rty.isArray
            recordArrayElem(c: inout c, ty: rty)
        }
        _ => {}
    }
    c.skipNewlines()
    val body: U64 = parseBlock(c: inout c)
    c.funcs.append(<Func nameStart=nameTok.start nameLen=nameTok.len params=params hasRet=hasRet retStart=retStart retLen=retLen retIsArray=retIsArray body=body hasRecv=hasRecv recvStart=recvStart recvLen=recvLen selfInout=selfInout />)
}

// `fn name(...)`: a free function. The current token is `fn`.
fn parseFunc(c: inout Comp) {
    c.advance()
    parseFuncCommon(c: inout c, hasRecv: false, recvStart: 0, recvLen: 0, selfInout: false)
}

// `impl Type { (fn | inout fn) name(...) ... }`: inherent methods. Each member
// is a function with an implicit `self` receiver (`inout fn` makes self
// mutable). The current token is the `impl` identifier.
fn parseImpl(c: inout Comp) {
    c.advance()
    val tyTok: Tok = c.cur()
    c.advance()
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.KwInout => {
                c.advance()
                match c.curKind() {
                    Kind.KwFn => { c.advance() }
                    _ => {}
                }
                parseFuncCommon(c: inout c, hasRecv: true, recvStart: tyTok.start, recvLen: tyTok.len, selfInout: true)
            }
            Kind.KwFn => {
                c.advance()
                parseFuncCommon(c: inout c, hasRecv: true, recvStart: tyTok.start, recvLen: tyTok.len, selfInout: false)
            }
            _ => { c.advance() }
        }
    }
}

// `struct Name { (val|mut val) field: Type ... }`. Field modifiers (val/mut/
// pub) are consumed and ignored; codegen maps each field's type to a C type.
fn parseStruct(c: inout Comp) {
    c.advance()
    val nameTok: Tok = c.cur()
    c.advance()
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val fields: Array[FieldDef] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            _ => {
                // a field declaration: `[mut] val name : Type`. `mut val` marks
                // assignable storage; bare `val` is immutable.
                mut val isMut: Bool = false
                match c.curKind() {
                    Kind.KwMut => {
                        c.advance()
                        isMut = true
                    }
                    _ => {}
                }
                match c.curKind() {
                    Kind.KwVal => { c.advance() }
                    _ => {}
                }
                val fTok: Tok = c.cur()
                c.advance()
                mut val tyStart: U64 = 0
                mut val tyLen: U64 = 0
                mut val tyIsArray: Bool = false
                match c.curKind() {
                    Kind.Colon => {
                        c.advance()
                        val ty: PType = parseTypeTok(c: inout c)
                        tyStart = ty.start
                        tyLen = ty.len
                        tyIsArray = ty.isArray
                        recordArrayElem(c: inout c, ty: ty)
                    }
                    _ => {}
                }
                fields.append(<FieldDef nameStart=fTok.start nameLen=fTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray isMut=isMut />)
            }
        }
    }
    c.structs.append(<StructDef nameStart=nameTok.start nameLen=nameTok.len fields=fields />)
}

// `enum Name { Variant [{ field: Type, ... }] ... }`. Variant fields take no
// modifiers (bare `name: Type`), per the language's variant-field rule.
fn parseEnum(c: inout Comp) {
    c.advance()
    val nameTok: Tok = c.cur()
    c.advance()
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val variants: Array[Variant] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Ident => {
                val vTok: Tok = c.cur()
                c.advance()
                mut val fields: Array[FieldDef] = []
                match c.curKind() {
                    Kind.LBrace => {
                        c.advance()
                        while true {
                            c.skipNewlines()
                            match c.curKind() {
                                Kind.RBrace => {
                                    c.advance()
                                    break
                                }
                                Kind.Eof => { break }
                                Kind.Ident => {
                                    val fTok: Tok = c.cur()
                                    c.advance()
                                    mut val tyStart: U64 = 0
                                    mut val tyLen: U64 = 0
                                    mut val tyIsArray: Bool = false
                                    match c.curKind() {
                                        Kind.Colon => {
                                            c.advance()
                                            val ty: PType = parseTypeTok(c: inout c)
                                            tyStart = ty.start
                                            tyLen = ty.len
                                            tyIsArray = ty.isArray
                                            recordArrayElem(c: inout c, ty: ty)
                                        }
                                        _ => {}
                                    }
                                    fields.append(<FieldDef nameStart=fTok.start nameLen=fTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray isMut=false />)
                                    match c.curKind() {
                                        Kind.Comma => { c.advance() }
                                        _ => {}
                                    }
                                }
                                _ => { c.advance() }
                            }
                        }
                    }
                    _ => {}
                }
                variants.append(<Variant nameStart=vTok.start nameLen=vTok.len fields=fields />)
            }
            _ => { c.advance() }
        }
    }
    c.enums.append(<EnumDef nameStart=nameTok.start nameLen=nameTok.len variants=variants />)
}

// Enable the builtin named (nameStart,nameLen) iff it was imported from its
// correct @Std submodule. `@Std/Io` owns print/write/writeByte/readStdin/
// readFile; `@Std/Process` owns argCount/argAt. A name imported from the wrong
// module stays disabled (so `import @Std/Process with { print }` is rejected).
fn markImport(c: inout Comp, segStart: U64, segLen: U64, nameStart: U64, nameLen: U64) {
    if rangeEquals(bytes: c.bytes, start: segStart, len: segLen, kw: "Io") {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "print") { c.impPrint = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") { c.impWrite = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "writeByte") { c.impWriteByte = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") { c.impReadStdin = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") { c.impReadFile = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") { c.impReadFileBytes = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "eprint") { c.impEprint = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "fileExists") { c.impFileExists = true }
    }
    if rangeEquals(bytes: c.bytes, start: segStart, len: segLen, kw: "Process") {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") { c.impArgCount = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") { c.impArgAt = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "exit") { c.impExit = true }
    }
}

// `import <path> [with { name, ... }]`. The leading `import` ident is current.
// We track the last path segment (the submodule, e.g. `Io` in `@Std/Io`) and,
// for the selective `with` list, enable each recognized (module, name) builtin.
// Only the `with { }` form binds flat names; the namespace form binds nothing
// the compiler can call bare (it would need `Io.print`, unsupported for now).
fn parseImport(c: inout Comp) {
    c.advance()
    mut val segStart: U64 = 0
    mut val segLen: U64 = 0
    while true {
        val k: Kind = c.curKind()
        match k {
            Kind.Newline => { break }
            Kind.Eof => { break }
            Kind.LBrace => { break }
            Kind.Ident => {
                if c.identIs(kw: "with") {
                    c.advance()
                    break
                }
                val t: Tok = c.cur()
                segStart = t.start
                segLen = t.len
                c.advance()
            }
            _ => { c.advance() }
        }
    }
    match c.curKind() {
        Kind.LBrace => {
            c.advance()
            while true {
                c.skipNewlines()
                val k: Kind = c.curKind()
                match k {
                    Kind.RBrace => {
                        c.advance()
                        break
                    }
                    Kind.Eof => { break }
                    Kind.Comma => { c.advance() }
                    Kind.Ident => {
                        val t: Tok = c.cur()
                        markImport(c: inout c, segStart: segStart, segLen: segLen, nameStart: t.start, nameLen: t.len)
                        c.advance()
                    }
                    _ => { c.advance() }
                }
            }
        }
        _ => {}
    }
}

fn parseProgram(c: inout Comp) {
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.KwFn => { parseFunc(c: inout c) }
            Kind.KwStruct => { parseStruct(c: inout c) }
            Kind.KwEnum => { parseEnum(c: inout c) }
            Kind.Ident => {
                if c.identIs(kw: "import") {
                    parseImport(c: inout c)
                } else {
                    if c.identIs(kw: "impl") {
                        parseImpl(c: inout c)
                    } else {
                        c.advance()
                    }
                }
            }
            Kind.Eof => { break }
            _ => { c.advance() }
        }
    }
}

