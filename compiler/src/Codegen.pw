// Part of the Plew compiler module (root: _.pw). Code generation: arena AST
// -> C, plus the lightweight type recovery and acceptance-soundness checks.

// ---- C code generation ----

fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

fn writeInt(n: I64) {
    if n < 0 {
        write(s: "-")
        writeInt(n: 0 - n)
        return
    }
    if n >= 10 {
        writeInt(n: n / 10)
    }
    write(s: digitStr(d: n % 10))
}

// U64 digit (0-9) -> its glyph. A U64 twin of digitStr: with no implicit
// conversions and `as` restricted to lossless, an I64 digitStr cannot serve a
// U64 caller (U64->I64 is not lossless), so unsigned printing needs its own.
fn digitStrU(d: U64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// Print a U64 (handle ids, indices, line numbers) with no sign handling — keeps
// the unsigned values unsigned end to end (no `U64 as I64` cast).
fn writeU64(n: U64) {
    if n >= 10 {
        writeU64(n: n / 10)
    }
    write(s: digitStrU(d: n % 10))
}

fn writeSpan(c: inout Comp, start: U64, len: U64) {
    mut val j: U64 = 0
    while j < len {
        writeByte(c.bytes[start + j])
        j += 1
    }
}

// Compiler diagnostics. Ordinary module functions (not ambient builtins) so the
// compiler source stays spec-valid: they report on stderr via @Std/Io `eprint`
// and stop via @Std/Process `exit`. `compileErrorAt` includes a source line.
fn eprintInt(n: I64) {
    if n >= 10 {
        eprintInt(n: n / 10)
    }
    eprint(text: digitStr(d: n % 10))
}

fn compileError(msg: String) {
    eprint(text: "plewc: error: ")
    eprint(text: msg)
    eprint(text: "\n")
    exit(code: 1)
}

fn compileErrorAt(line: I64, msg: String) {
    eprint(text: "plewc: error: line ")
    eprintInt(n: line)
    eprint(text: ": ")
    eprint(text: msg)
    eprint(text: "\n")
    exit(code: 1)
}

fn isPrimType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "Bool") { return true }
    return false
}

// Whether a type-name span is one of the 8 integer types (excludes Bool/String).
fn isIntType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    return false
}

// Bit width of an integer type-name span (0 if not an integer type).
fn intBits(c: inout Comp, start: U64, len: U64) -> U64 {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return 8 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return 8 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return 16 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return 16 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return 32 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return 32 }
    return 64
}

// Whether an integer type-name span is signed (`I*`). Assumes isIntType.
fn intSigned(c: inout Comp, start: U64, len: U64) -> Bool {
    return c.bytes[start] == 'I'
}

// Whether `src as dst` (both integer types) is lossless — i.e. dst represents
// every src value (spec: `as` is lossless-only; narrowing/signedness -> TryFrom).
fn losslessInt(c: inout Comp, srcStart: U64, srcLen: U64, dstStart: U64, dstLen: U64) -> Bool {
    val sBits: U64 = intBits(c: inout c, start: srcStart, len: srcLen)
    val dBits: U64 = intBits(c: inout c, start: dstStart, len: dstLen)
    val sSigned: Bool = intSigned(c: inout c, start: srcStart, len: srcLen)
    val dSigned: Bool = intSigned(c: inout c, start: dstStart, len: dstLen)
    if sSigned {
        if dSigned {
            return dBits >= sBits
        }
        // signed -> unsigned: negatives are unrepresentable.
        return false
    }
    if dSigned {
        // unsigned -> signed needs a strictly wider target (the sign bit).
        return dBits > sBits
    }
    return dBits >= sBits
}

// Whether the literal `value` fits the target integer type's range.
fn litFitsType(c: inout Comp, value: I64, dstStart: U64, dstLen: U64) -> Bool {
    val bits: U64 = intBits(c: inout c, start: dstStart, len: dstLen)
    val sgn: Bool = intSigned(c: inout c, start: dstStart, len: dstLen)
    return litFitsBits(value: value, bits: bits, sgn: sgn)
}

// Whether `value` fits an integer type of the given width and signedness. Span-
// free core of litFitsType, so synthetic contexts (index = U64, print = I64)
// can range-check literals without a type-name span in the source buffer.
fn litFitsBits(value: I64, bits: U64, sgn: Bool) -> Bool {
    // Per-width bounds as literals (no `1 << 31` / `1 << 32`, which would overflow
    // a 32-bit C int and give the wrong bound). Bounds fit I64 (< 2^63).
    if sgn {
        if bits == 8 {
            if value < (0 - 128) { return false }
            if value > 127 { return false }
            return true
        }
        if bits == 16 {
            if value < (0 - 32768) { return false }
            if value > 32767 { return false }
            return true
        }
        if bits == 32 {
            if value < (0 - 2147483648) { return false }
            if value > 2147483647 { return false }
            return true
        }
        return true
    }
    if value < 0 {
        return false
    }
    if bits == 8 {
        if value > 255 { return false }
        return true
    }
    if bits == 16 {
        if value > 65535 { return false }
        return true
    }
    if bits == 32 {
        if value > 4294967295 { return false }
        return true
    }
    return true
}

// Emit the C *element* type for a type-name span (no Array wrapper). Each Plew
// integer type maps to its exact-width C stdint type so storage width and
// signedness match the declared type (no hidden widening); U8 -> unsigned char
// (== uint8_t, keeps byte arrays aliasing a char buffer for String.bytes);
// Bool -> long long (width irrelevant); String -> PlewString; named -> echoed.
fn genCElem(c: inout Comp, start: U64, len: U64) {
    if len == 0 {
        write(s: "long long")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") {
        write(s: "unsigned char")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") {
        write(s: "int8_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") {
        write(s: "int16_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") {
        write(s: "uint16_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") {
        write(s: "int32_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") {
        write(s: "uint32_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") {
        write(s: "int64_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") {
        write(s: "uint64_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        write(s: "PlewString")
        return
    }
    if isPrimType(c: inout c, start: start, len: len) {
        // remaining prim = Bool
        write(s: "long long")
        return
    }
    writeSpan(c: inout c, start: start, len: len)
}

// Emit a C type for a (span, isArray) type. `Array[E]` -> `PlewArray_<E>`
// (the element name is C-identifier-safe, so it doubles as the mangle).
fn genCTypeRef(c: inout Comp, start: U64, len: U64, isArray: Bool) {
    if isArray {
        write(s: "PlewArray_")
        writeSpan(c: inout c, start: start, len: len)
        return
    }
    genCElem(c: inout c, start: start, len: len)
}

// Back-compat shim for non-array type positions (scalars / String / named).
fn genCType(c: inout Comp, start: U64, len: U64) {
    genCElem(c: inout c, start: start, len: len)
}

// Emit the C type for a recovered TypeInfo (used when the type comes from
// inference rather than a written annotation, e.g. a match-expression result).
fn genTypeInfoCType(c: inout Comp, ti: TypeInfo) {
    if ti.kind == 1 {
        write(s: "PlewString")
        return
    }
    if ti.kind == 2 {
        writeSpan(c: inout c, start: ti.nameStart, len: ti.nameLen)
        return
    }
    if ti.kind == 3 {
        write(s: "PlewArray_")
        writeSpan(c: inout c, start: ti.nameStart, len: ti.nameLen)
        return
    }
    write(s: "long long")
}

// Compare two source spans byte for byte.
fn spansEqual(c: inout Comp, aStart: U64, aLen: U64, bStart: U64, bLen: U64) -> Bool {
    if aLen != bLen {
        return false
    }
    mut val j: U64 = 0
    while j < aLen {
        if c.bytes[aStart + j] != c.bytes[bStart + j] {
            return false
        }
        j += 1
    }
    return true
}

// 1-based source line for a byte offset (count newlines before it). For
// diagnostics; works across the assembled multi-file buffer.
fn lineOf(c: inout Comp, offset: U64) -> I64 {
    mut val line: I64 = 1
    mut val i: U64 = 0
    while i < offset {
        if c.bytes[i] == 10 {
            line += 1
        }
        i += 1
    }
    return line
}

// Best-effort byte offset for an expression (for diagnostics). Leaf nodes with
// a span return it; compound nodes recurse to a representative child.
fn exprOffset(c: inout Comp, id: U64) -> U64 {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { value: _, val offset, isBool: _, tyStart: _, tyLen: _ } => { return offset }
        Expr.Ident { val start, val len } => { return start }
        Expr.Str { val start, val len } => { return start }
        Expr.Call { val nameStart, val nameLen, val args } => { return nameStart }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => { return nameStart }
        Expr.Field { val base, val nameStart, val nameLen } => { return exprOffset(c: inout c, id: base) }
        Expr.Index { val base, val index } => { return exprOffset(c: inout c, id: base) }
        Expr.Binary { val op, val lhs, val rhs } => { return exprOffset(c: inout c, id: lhs) }
        Expr.Unary { val op, val operand } => { return exprOffset(c: inout c, id: operand) }
        Expr.Cast { val operand, val tyStart, val tyLen, ty: _ } => { return exprOffset(c: inout c, id: operand) }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => { return typeStart }
        Expr.MatchExpr { val scrut, val arms } => { return exprOffset(c: inout c, id: scrut) }
        Expr.IfExpr { val cond, val thenBlk, val elseBlk } => { return exprOffset(c: inout c, id: cond) }
        _ => { return 0 }
    }
}

// Index of the top-level function named (nameStart,nameLen), or -1 if none.
// Names are unique (no overloading in this compiler), so the first match wins.
// Returns `c.funcs.count` (one past the end) when there is no match — kept as a
// U64 sentinel so callers never need a signed index (lossless-`as` discipline).
fn findFunc(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
        } else {
            if spansEqual(c: inout c, aStart: nameStart, aLen: nameLen, bStart: f.nameStart, bLen: f.nameLen) {
                return i
            }
        }
        i += 1
    }
    return c.funcs.count
}

// Index of the method named (nameStart,nameLen) on receiver type
// (recvStart,recvLen), or `c.funcs.count` (one past the end) if none.
fn findMethod(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> U64 {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if spansEqual(c: inout c, aStart: nameStart, aLen: nameLen, bStart: f.nameStart, bLen: f.nameLen) {
                if spansEqual(c: inout c, aStart: recvStart, aLen: recvLen, bStart: f.recvStart, bLen: f.recvLen) {
                    return i
                }
            }
        }
        i += 1
    }
    return c.funcs.count
}

// Check call args against a parameter list: arg count matches and every arg
// carries its parameter's label in declaration order (spec: labels required).
fn paramsLabelsOk(c: inout Comp, params: Array[Param], args: Array[Arg]) -> Bool {
    if params.count != args.count {
        return false
    }
    mut val i: U64 = 0
    while i < args.count {
        val a: Arg = args[i]
        if a.hasLabel {
            val p: Param = params[i]
            if spansEqual(c: inout c, aStart: a.labelStart, aLen: a.labelLen, bStart: p.nameStart, bLen: p.nameLen) {
            } else {
                return false
            }
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Acceptance soundness: spec requires every argument to carry its label, in
// declaration order. Check a call against the callee's params. Calls that don't
// resolve to a user function (I/O builtins, methods) return true here — they're
// handled on their own paths and keep their provisional calling conventions.
fn callLabelsOk(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
    val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen)
    if fi == c.funcs.count {
        return true
    }
    val f: Func = c.funcs[fi]
    return paramsLabelsOk(c: inout c, params: f.params, args: args)
}

// Does some arm cover the variant (variantStart,variantLen)? A wildcard arm
// covers everything.
fn armCovers(c: inout Comp, arms: Array[MatchArm], variantStart: U64, variantLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < arms.count {
        val a: MatchArm = arms[i]
        if a.isWildcard {
            return true
        }
        if spansEqual(c: inout c, aStart: a.variantStart, aLen: a.variantLen, bStart: variantStart, bLen: variantLen) {
            return true
        }
        i += 1
    }
    return false
}

// Acceptance soundness: spec requires match to be exhaustive (Rust-style). A
// match is exhaustive iff it has a `_` wildcard, or every variant of the
// scrutinee's enum is covered by some arm. (This compiler's match is always
// over an enum, and has no `val x` catch-all arm, so those are the only cases.)
fn matchExhaustive(c: inout Comp, arms: Array[MatchArm]) -> Bool {
    mut val enumStart: U64 = 0
    mut val enumLen: U64 = 0
    mut val i: U64 = 0
    while i < arms.count {
        val a: MatchArm = arms[i]
        if a.isWildcard {
            return true
        }
        if enumLen == 0 {
            enumStart = a.enumStart
            enumLen = a.enumLen
        }
        i += 1
    }
    if enumLen == 0 {
        return true
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if armCovers(c: inout c, arms: arms, variantStart: v.nameStart, variantLen: v.nameLen) {
                } else {
                    return false
                }
                vi += 1
            }
            return true
        }
        ei += 1
    }
    return true
}

// Tag index of `Enum.Variant` (the variant's position in its enum declaration).
fn variantIndex(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> U64 {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    return vi
                }
                vi += 1
            }
        }
        ei += 1
    }
    return 0
}

// ---- lightweight type recovery (for monomorphization + .bytes dispatch) ----

fn scalarInfo() -> TypeInfo {
    return <TypeInfo kind=0 nameStart=0 nameLen=0 />
}

fn typeInfoOfName(c: inout Comp, start: U64, len: U64, isArray: Bool) -> TypeInfo {
    if isArray {
        return <TypeInfo kind=3 nameStart=start nameLen=len />
    }
    if len == 0 {
        return scalarInfo()
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        return <TypeInfo kind=1 nameStart=start nameLen=len />
    }
    if isPrimType(c: inout c, start: start, len: len) {
        // kind=0 (scalar) but carry the type name so the width is recoverable
        // (e.g. for the lossless-`as` check). The C type stays 64-bit for now.
        return <TypeInfo kind=0 nameStart=start nameLen=len />
    }
    return <TypeInfo kind=2 nameStart=start nameLen=len />
}

fn addLocal(c: inout Comp, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool) {
    c.locals.append(<Local nameStart=nameStart nameLen=nameLen tyStart=tyStart tyLen=tyLen isArray=isArray ty=ty isInout=isInout isMut=isMut />)
}

// Whether the binding named (start,len) — most recent in scope — may be assigned
// to: `mut val` locals and `inout` params. Unknown names default to assignable
// (the C compile catches genuinely undeclared identifiers).
fn localIsMutable(c: inout Comp, start: U64, len: U64) -> Bool {
    if isSelfRef(c: inout c, start: start, len: len) {
        // `self` is assignable only through an `inout fn` receiver.
        return c.curSelfInout
    }
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
            if lo.isMut {
                return true
            }
            return lo.isInout
        }
    }
    return true
}

// Whether `name` refers to an `inout` parameter of the current function (so its
// uses must be dereferenced as `(*name)`).
fn isSelfRef(c: inout Comp, start: U64, len: U64) -> Bool {
    if c.curHasRecv {
        return rangeEquals(bytes: c.bytes, start: start, len: len, kw: "self")
    }
    return false
}

fn isInoutLocal(c: inout Comp, start: U64, len: U64) -> Bool {
    if isSelfRef(c: inout c, start: start, len: len) {
        // `inout fn` receivers are pointers, so a bare `self` is `(*self)`.
        return c.curSelfInout
    }
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
            return lo.isInout
        }
    }
    return false
}

// Type of field `fieldName` declared in struct `structName` (else scalar).
fn fieldType(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if spansEqual(c: inout c, aStart: s.nameStart, aLen: s.nameLen, bStart: structStart, bLen: structLen) {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: fieldStart, bLen: fieldLen) {
                    return typeInfoOfName(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                }
                fi += 1
            }
        }
        si += 1
    }
    return scalarInfo()
}

// Whether a struct field is declared `mut val` (assignable). Unknown struct or
// field defaults to true (don't reject what we can't resolve).
fn fieldDeclaredMut(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> Bool {
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if spansEqual(c: inout c, aStart: s.nameStart, aLen: s.nameLen, bStart: structStart, bLen: structLen) {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: fieldStart, bLen: fieldLen) {
                    return f.isMut
                }
                fi += 1
            }
        }
        si += 1
    }
    return true
}

// Whether an assignment target is a mutable *place* (spec: composite mutability).
// A bare binding must be `mut val`/`inout`; a field access additionally needs the
// field declared `mut val` and its base to be a mutable place; an index follows
// its array binding. Unresolved cases default to mutable (the C compile still
// catches genuinely undeclared names).
fn placeIsMutable(c: inout Comp, id: U64) -> Bool {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Ident { val start, val len } => {
            return localIsMutable(c: inout c, start: start, len: len)
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 2 {
                if fieldDeclaredMut(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen) {
                    return placeIsMutable(c: inout c, id: base)
                }
                return false
            }
            return placeIsMutable(c: inout c, id: base)
        }
        Expr.Index { val base, val index } => {
            return placeIsMutable(c: inout c, id: base)
        }
        _ => { return true }
    }
}

// Recover an expression's type. Only the cases plewc.pw exercises on the base
// of a field/index/method are precise; everything else falls back to scalar.
fn exprType(c: inout Comp, id: U64) -> TypeInfo {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { value: _, offset: _, isBool: _, val tyStart, val tyLen } => {
            // a suffixed literal (`5U64`) carries its own type; otherwise the
            // type comes from context and is recovered elsewhere.
            if tyLen != 0 {
                return typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false)
            }
            return scalarInfo()
        }
        Expr.Str { val start, val len } => { return <TypeInfo kind=1 nameStart=0 nameLen=0 /> }
        Expr.Ident { val start, val len } => {
            if isSelfRef(c: inout c, start: start, len: len) {
                return typeInfoOfName(c: inout c, start: c.curRecvStart, len: c.curRecvLen, isArray: false)
            }
            mut val i: U64 = c.locals.count
            while i > 0 {
                i -= 1
                val lo: Local = c.locals[i]
                if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
                    return typeInfoOfName(c: inout c, start: lo.tyStart, len: lo.tyLen, isArray: lo.isArray)
                }
            }
            return scalarInfo()
        }
        Expr.Unary { val op, val operand } => {
            // `-` / `~` preserve the operand's width; `!` is Bool (width-less).
            if op == 57 { return exprType(c: inout c, id: operand) }
            if op == 79 { return exprType(c: inout c, id: operand) }
            return scalarInfo()
        }
        Expr.Binary { val op, val lhs, val rhs } => {
            // Arithmetic (56-60) and bitwise/shift (74-78) take the left
            // operand's width; comparisons (50-55) and logical (61,62) are Bool.
            if op >= 56 {
                if op <= 60 {
                    return exprType(c: inout c, id: lhs)
                }
            }
            if op >= 74 {
                if op <= 78 {
                    return exprType(c: inout c, id: lhs)
                }
            }
            return scalarInfo()
        }
        Expr.Call { val nameStart, val nameLen, val args } => {
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            mut val fi: U64 = 0
            while fi < c.funcs.count {
                val f: Func = c.funcs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: nameStart, bLen: nameLen) {
                    if f.hasRet {
                        return typeInfoOfName(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
                    }
                    return scalarInfo()
                }
                fi += 1
            }
            return scalarInfo()
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 2 {
                return fieldType(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
            }
            return scalarInfo()
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen />
        }
        Expr.Array { val elems } => { return scalarInfo() }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 3 {
                return typeInfoOfName(c: inout c, start: bt.nameStart, len: bt.nameLen, isArray: false)
            }
            return scalarInfo()
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => {
            val rt: TypeInfo = exprType(c: inout c, id: recv)
            if rt.kind == 2 {
                val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen)
                if mi == c.funcs.count {
                    return scalarInfo()
                }
                val mf: Func = c.funcs[mi]
                if mf.hasRet {
                    return typeInfoOfName(c: inout c, start: mf.retStart, len: mf.retLen, isArray: mf.retIsArray)
                }
                return scalarInfo()
            }
            return scalarInfo()
        }
        Expr.Cast { val operand, val tyStart, val tyLen, ty: _ } => {
            return typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false)
        }
        Expr.MatchExpr { val scrut, val arms } => {
            if arms.count > 0 {
                return exprType(c: inout c, id: arms[0].body)
            }
            return scalarInfo()
        }
        Expr.IfExpr { val cond, val thenBlk, val elseBlk } => {
            val g: U64 = blockGiveExpr(c: inout c, blkId: thenBlk)
            if g < c.exprs.count {
                return exprType(c: inout c, id: g)
            }
            return scalarInfo()
        }
    }
    return scalarInfo()
}

// The value expression of the last `give` in a block (the block's result), or
// `c.exprs.count` (one past the end) if the block has no `give`. A U64 sentinel
// keeps callers off signed indices. Used to infer a value-position `if`'s type.
fn blockGiveExpr(c: inout Comp, blkId: U64) -> U64 {
    val blk: Block = c.blocks[blkId]
    val stmts: Array[U64] = blk.stmts
    mut val i: U64 = 0
    mut val found: U64 = c.exprs.count
    while i < stmts.count {
        val s: Stmt = c.stmts[stmts[i]]
        match s {
            Stmt.Give { val value } => { found = value }
            _ => {}
        }
        i += 1
    }
    return found
}

// Register a match-bound field as an in-scope local with its declared type.
// Register a match-bound field as an in-scope local. The field is found by
// (fieldStart,fieldLen); the local is named (bindStart,bindLen) — equal for
// punning, different for a `field: val name` rename.
fn addBindLocal(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, fieldStart: U64, fieldLen: U64, bindStart: U64, bindLen: U64) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: fieldStart, bLen: fieldLen) {
                            addLocal(c: inout c, nameStart: bindStart, nameLen: bindLen, tyStart: f.tyStart, tyLen: f.tyLen, isArray: f.tyIsArray, ty: f.ty, isInout: false, isMut: false)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
}

// Emit the C type of a match-bound field (looked up in the enum declaration).
fn genBindType(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, bindStart: U64, bindLen: U64) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: bindStart, bLen: bindLen) {
                            genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
    write(s: "long long")
}

fn binOpStr(op: I64) -> String {
    if op == 56 { return " + " }
    if op == 57 { return " - " }
    if op == 58 { return " * " }
    if op == 59 { return " / " }
    if op == 60 { return " % " }
    if op == 50 { return " == " }
    if op == 51 { return " != " }
    if op == 52 { return " < " }
    if op == 53 { return " <= " }
    if op == 54 { return " > " }
    if op == 55 { return " >= " }
    if op == 61 { return " && " }
    if op == 62 { return " || " }
    if op == 74 { return " & " }
    if op == 75 { return " | " }
    if op == 76 { return " ^ " }
    if op == 77 { return " << " }
    if op == 78 { return " >> " }
    return " ? "
}

fn unaryOpStr(op: I64) -> String {
    if op == 57 { return "-" }
    if op == 79 { return "~" }
    return "!"
}

// Decoded byte length of a string literal (span includes both quotes). Escapes
// like \n / \" / \\ count as one byte; plewc.pw uses only C-compatible escapes,
// so the content is emitted verbatim and just the length is computed here.
fn strDecodedLen(c: inout Comp, start: U64, len: U64) -> I64 {
    mut val n: I64 = 0
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if c.bytes[j] == 92 {
            j += 2
        } else {
            j += 1
        }
        n += 1
    }
    return n
}

// Whether a binary op is checked arithmetic (+ - *) whose result may overflow
// the operand type (spec: integer overflow always panics). `/` panics only on a
// zero divisor (handled by plew_div); shifts/bitwise never overflow.
fn isCheckedArith(op: I64) -> Bool {
    if op == 56 { return true }
    if op == 57 { return true }
    if op == 58 { return true }
    return false
}

// Map a compound-assign op (+= -= *=) to its binary op (+ - *) for the
// overflow check; 0 for ops whose compound form can't overflow (bitwise/shift)
// or isn't arithmetic. (/= and %= go through the checked plew_div/plew_mod.)
fn compoundCheckedBin(op: I64) -> I64 {
    if op == 67 { return 56 }
    if op == 68 { return 57 }
    if op == 69 { return 58 }
    return 0
}

// The clang overflow-detecting builtin for a checked-arith op.
fn overflowBuiltin(op: I64) -> String {
    if op == 56 { return "__builtin_add_overflow" }
    if op == 57 { return "__builtin_sub_overflow" }
    return "__builtin_mul_overflow"
}

// The integer result type of an arithmetic binary (operands share a type, so
// either operand's recovered int type works). Width-less scalar if neither is a
// recoverable integer type — then the overflow check is skipped (documented gap).
fn arithIntType(c: inout Comp, lhs: U64, rhs: U64) -> TypeInfo {
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind == 0 {
        if isIntType(c: inout c, start: lt.nameStart, len: lt.nameLen) {
            return lt
        }
    }
    val rt: TypeInfo = exprType(c: inout c, id: rhs)
    if rt.kind == 0 {
        if isIntType(c: inout c, start: rt.nameStart, len: rt.nameLen) {
            return rt
        }
    }
    return scalarInfo()
}

// Emit `a OP b` as an overflow-checked statement-expression: compute into a
// temp of the result type via the clang builtin, panic if it overflowed, else
// yield the temp. The builtin detects overflow against the temp's exact width,
// so storage being the declared width (Phase C) makes this precise.
fn genCheckedArith(c: inout Comp, op: I64, lhs: U64, rhs: U64, tyStart: U64, tyLen: U64) {
    write(s: "({ ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __ov; if (")
    write(s: overflowBuiltin(op: op))
    write(s: "((")
    genExpr(c: inout c, id: lhs)
    write(s: "), (")
    genExpr(c: inout c, id: rhs)
    write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
}

// Emit a bounds-checked array element read: `PlewArray_<E>_get(base, (idx))`.
fn genArrayGet(c: inout Comp, base: U64, index: U64, elemStart: U64, elemLen: U64) {
    write(s: "PlewArray_")
    writeSpan(c: inout c, start: elemStart, len: elemLen)
    write(s: "_get(")
    genExpr(c: inout c, id: base)
    write(s: ", (long long)(")
    genExpr(c: inout c, id: index)
    write(s: "))")
}

// The stdint.h MIN macro for a signed integer type (used in the INT_MIN / -1
// division-overflow guard). Assumes a signed int type span.
fn intMinMacro(c: inout Comp, start: U64, len: U64) -> String {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return "INT8_MIN" }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return "INT16_MIN" }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return "INT32_MIN" }
    return "INT64_MIN"
}

// Emit `-x` as an overflow-checked negation: negating the signed minimum has no
// representable result, so it panics. (Only emitted for signed int operands;
// `-` on unsigned is a type error the front end will reject later.)
fn genCheckedNeg(c: inout Comp, operand: U64, tyStart: U64, tyLen: U64) {
    write(s: "({ ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __ov; if (__builtin_sub_overflow((")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: ")0, (")
    genExpr(c: inout c, id: operand)
    write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
}

// Emit width- and sign-aware `/` or `%` (isMod) as a statement-expression:
// always panic on a zero divisor; for signed division, INT_MIN / -1 overflows
// (panic), and x % -1 is defined as 0 (sidesteps the C UB at INT_MIN % -1).
// Unsigned has neither overflow case. Computes at the exact result width.
fn genCheckedDiv(c: inout Comp, lhs: U64, rhs: U64, tyStart: U64, tyLen: U64, isMod: Bool) {
    val signedTy: Bool = intSigned(c: inout c, start: tyStart, len: tyLen)
    write(s: "({ ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __dl = (")
    genExpr(c: inout c, id: lhs)
    write(s: "); ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __dr = (")
    genExpr(c: inout c, id: rhs)
    write(s: "); if (__dr == 0) plew_panic((PlewString){")
    if isMod {
        write(s: "\"remainder by zero\", 17}); ")
    } else {
        write(s: "\"division by zero\", 16}); ")
    }
    if signedTy {
        if isMod {
            write(s: "(__dr == -1 ? 0 : __dl % __dr); })")
        } else {
            write(s: "if (__dr == -1 && __dl == ")
            write(s: intMinMacro(c: inout c, start: tyStart, len: tyLen))
            write(s: ") plew_panic((PlewString){\"integer overflow\", 16}); __dl / __dr; })")
        }
    } else {
        if isMod {
            write(s: "__dl % __dr; })")
        } else {
            write(s: "__dl / __dr; })")
        }
    }
}

fn assignOpStr(op: I64) -> String {
    if op == 49 { return " = " }
    if op == 67 { return " += " }
    if op == 68 { return " -= " }
    if op == 69 { return " *= " }
    if op == 70 { return " /= " }
    if op == 71 { return " %= " }
    if op == 80 { return " &= " }
    if op == 81 { return " |= " }
    if op == 82 { return " ^= " }
    if op == 83 { return " <<= " }
    return " >>= "
}

// Whether a compound-assign op is `/=` (70) or `%=` (71), whose expansion must
// go through the checked plew_div/plew_mod (spec: division by zero panics).
fn isCompoundDiv(op: I64) -> Bool {
    if op == 70 { return true }
    if op == 71 { return true }
    return false
}

// The checked-division C function (with its open paren) for `/=`/`%=`; "" for
// any other op (so callers can prefix unconditionally).
fn compoundDivFn(op: I64) -> String {
    if op == 70 { return "plew_div(" }
    if op == 71 { return "plew_mod(" }
    return ""
}

// The binary operator underlying a compound assignment (`+=` -> ` + `), used to
// expand `a[i] OP= v` into `set(a, i, get(a, i) OP v)`.
fn assignToBinStr(op: I64) -> String {
    if op == 67 { return " + " }
    if op == 68 { return " - " }
    if op == 69 { return " * " }
    if op == 70 { return " / " }
    if op == 71 { return " % " }
    if op == 80 { return " & " }
    if op == 81 { return " | " }
    if op == 82 { return " ^ " }
    if op == 83 { return " << " }
    return " >> "
}

// --- Phase D: literal context typing -------------------------------------
// Spec: integer literals have no default type; their type comes from context
// (annotation / field / param / return / array element / sibling operand). A
// literal that does not fit its context type is rejected, and a constant
// expression that overflows its type is rejected at compile time. checkLit*
// is a pure validation pass (emits compileError; does not change the C output).

struct ConstInt {
    val isConst: Bool
    val value: I64
}

fn notConst() -> ConstInt {
    return <ConstInt isConst=false value=0 />
}

// Fold a constant integer expression (literals, unary `-`, and `+ - *`). Lets us
// catch constant overflow whose individual leaves each fit but whose result does
// not (`val f: U8 = 200 + 100`). Other operators yield non-const (leaf checks
// still apply). The fold runs in the compiler's own checked I64 arithmetic, so a
// constant that overflows I64 itself aborts the compile loudly (pathological).
fn foldConst(c: inout Comp, id: U64) -> ConstInt {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value, offset: _, val isBool, tyStart: _, tyLen: _ } => {
            if isBool { return notConst() }
            return <ConstInt isConst=true value=value />
        }
        Expr.Unary { val op, val operand } => {
            if op == 57 {
                val o: ConstInt = foldConst(c: inout c, id: operand)
                if o.isConst { return <ConstInt isConst=true value=0 - o.value /> }
            }
            return notConst()
        }
        Expr.Binary { val op, val lhs, val rhs } => {
            val a: ConstInt = foldConst(c: inout c, id: lhs)
            val b: ConstInt = foldConst(c: inout c, id: rhs)
            if a.isConst {
                if b.isConst {
                    if op == 56 { return <ConstInt isConst=true value=a.value + b.value /> }
                    if op == 57 { return <ConstInt isConst=true value=a.value - b.value /> }
                    if op == 58 { return <ConstInt isConst=true value=a.value * b.value /> }
                }
            }
            return notConst()
        }
        _ => { return notConst() }
    }
}

// Whether a recovered TypeInfo is a (width-bearing) integer type.
fn tiIsInt(c: inout Comp, ti: TypeInfo) -> Bool {
    if ti.kind == 0 {
        if ti.nameLen != 0 {
            return isIntType(c: inout c, start: ti.nameStart, len: ti.nameLen)
        }
    }
    return false
}

// Range-check the literals reachable from `id` against an expected integer type
// described as (eKind, eBits, eSgn): eKind 0 = no context type (spec: a literal
// with no type is a compile error), 1 = integer of (eBits, eSgn), 2 = a non-
// integer type (skip int checks). A `true`/`false` (isBool) or a suffixed
// literal (`5U64`) carries its own type and is never context-ambiguous.
fn checkLitLeaf(c: inout Comp, value: I64, offset: U64, isBool: Bool, tyStart: U64, tyLen: U64, eKind: U64, eBits: U64, eSgn: Bool) {
    if isBool {
        return
    }
    if tyLen != 0 {
        // explicit type suffix: range-check against it (never ambiguous).
        if litFitsType(c: inout c, value: value, dstStart: tyStart, dstLen: tyLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal is out of range for its type")
        }
        return
    }
    if eKind == 1 {
        if litFitsBits(value: value, bits: eBits, sgn: eSgn) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal is out of range for its type")
        }
        return
    }
    if eKind == 0 {
        compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal has no type from context; add a type annotation or a suffix (e.g. `5I32`)")
    }
}

fn checkLitCtx(c: inout Comp, id: U64, eKind: U64, eBits: U64, eSgn: Bool) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value, val offset, val isBool, val tyStart, val tyLen } => {
            checkLitLeaf(c: inout c, value: value, offset: offset, isBool: isBool, tyStart: tyStart, tyLen: tyLen, eKind: eKind, eBits: eBits, eSgn: eSgn)
        }
        Expr.Unary { val op, val operand } => {
            if op == 57 {
                // a leading `-` on a literal folds into the literal (`-128:I8` is
                // valid even though `128` alone exceeds I8), so check the negated
                // value; otherwise recurse into the operand with the same type.
                val oe: Expr = c.exprs[operand]
                match oe {
                    Expr.Int { val value, val offset, val isBool, val tyStart, val tyLen } => {
                        checkLitLeaf(c: inout c, value: 0 - value, offset: offset, isBool: isBool, tyStart: tyStart, tyLen: tyLen, eKind: eKind, eBits: eBits, eSgn: eSgn)
                    }
                    _ => { checkLitCtx(c: inout c, id: operand, eKind: eKind, eBits: eBits, eSgn: eSgn) }
                }
            } else {
                if op == 79 {
                    checkLitCtx(c: inout c, id: operand, eKind: eKind, eBits: eBits, eSgn: eSgn)
                }
            }
        }
        Expr.Binary { val op, val lhs, val rhs } => {
            mut val isArith: Bool = false
            if op >= 56 { if op <= 60 { isArith = true } }
            if op >= 74 { if op <= 78 { isArith = true } }
            if isArith {
                if eKind == 1 {
                    val cf: ConstInt = foldConst(c: inout c, id: id)
                    if cf.isConst {
                        if litFitsBits(value: cf.value, bits: eBits, sgn: eSgn) {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: id)), msg: "constant expression is out of range for its type")
                        }
                    }
                    checkLitCtx(c: inout c, id: lhs, eKind: eKind, eBits: eBits, eSgn: eSgn)
                    checkLitCtx(c: inout c, id: rhs, eKind: eKind, eBits: eBits, eSgn: eSgn)
                } else {
                    checkArithNoCtx(c: inout c, lhs: lhs, rhs: rhs)
                }
            } else {
                checkArithNoCtx(c: inout c, lhs: lhs, rhs: rhs)
            }
        }
        Expr.Call { val nameStart, val nameLen, val args } => {
            checkCallArgs(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => {
            checkMethodArgs(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.Cast { val operand, val tyStart, val tyLen, ty: _ } => {
            // The operand has its own type; a direct-literal operand is range-
            // checked by the cast itself, so only recurse into compound operands.
            val oe: Expr = c.exprs[operand]
            match oe {
                Expr.Int { value: _, offset: _, isBool: _, tyStart: _, tyLen: _ } => {}
                _ => { checkLitCtx(c: inout c, id: operand, eKind: 0, eBits: 0, eSgn: false) }
            }
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            checkLitCtx(c: inout c, id: base, eKind: 0, eBits: 0, eSgn: false)
        }
        Expr.Index { val base, val index } => {
            checkLitCtx(c: inout c, id: base, eKind: 0, eBits: 0, eSgn: false)
            checkLitCtx(c: inout c, id: index, eKind: 1, eBits: 64, eSgn: false)
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            checkMakeFields(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fields: fields)
        }
        Expr.Array { val elems } => {
            mut val i: U64 = 0
            while i < elems.count {
                checkLitCtx(c: inout c, id: elems[i], eKind: eKind, eBits: eBits, eSgn: eSgn)
                i += 1
            }
        }
        Expr.MatchExpr { val scrut, val arms } => {
            checkLitCtx(c: inout c, id: scrut, eKind: 0, eBits: 0, eSgn: false)
            mut val i: U64 = 0
            while i < arms.count {
                checkLitCtx(c: inout c, id: arms[i].body, eKind: eKind, eBits: eBits, eSgn: eSgn)
                i += 1
            }
        }
        _ => {}
    }
}

struct IntTy {
    val known: Bool
    val bits: U64
    val sgn: Bool
}

// Recover an expression's integer type as (bits, sgn). Covers what exprType
// reports width-less but is nonetheless integer-typed: `arr.count` (U64) and an
// array element read `arr[i]` (the element's int type) — so a literal sibling in
// `0 ..< arr.count` infers U64 and is not flagged ambiguous.
fn exprIntTy(c: inout Comp, id: U64) -> IntTy {
    val ti: TypeInfo = exprType(c: inout c, id: id)
    if tiIsInt(c: inout c, ti: ti) {
        return <IntTy known=true bits=intBits(c: inout c, start: ti.nameStart, len: ti.nameLen) sgn=intSigned(c: inout c, start: ti.nameStart, len: ti.nameLen) />
    }
    val e: Expr = c.exprs[id]
    match e {
        Expr.Call { val nameStart, val nameLen, val args } => {
            // argCount() is the one integer-returning I/O builtin (I64).
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") {
                return <IntTy known=true bits=64 sgn=true />
            }
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "count") {
                val bt: TypeInfo = exprType(c: inout c, id: base)
                if bt.kind == 3 {
                    return <IntTy known=true bits=64 sgn=false />
                }
            }
        }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 3 {
                if isIntType(c: inout c, start: bt.nameStart, len: bt.nameLen) {
                    return <IntTy known=true bits=intBits(c: inout c, start: bt.nameStart, len: bt.nameLen) sgn=intSigned(c: inout c, start: bt.nameStart, len: bt.nameLen) />
                }
            }
        }
        _ => {}
    }
    return <IntTy known=false bits=0 sgn=false />
}

// Infer an arithmetic/comparison's literal operand type from a typed sibling
// (Plew: both operands share a type). If neither operand has a known integer
// type, the operands carry no context, so a literal there is ambiguous (error).
fn checkArithNoCtx(c: inout Comp, lhs: U64, rhs: U64) {
    val lt: IntTy = exprIntTy(c: inout c, id: lhs)
    if lt.known {
        checkLitCtx(c: inout c, id: lhs, eKind: 1, eBits: lt.bits, eSgn: lt.sgn)
        checkLitCtx(c: inout c, id: rhs, eKind: 1, eBits: lt.bits, eSgn: lt.sgn)
        return
    }
    val rt: IntTy = exprIntTy(c: inout c, id: rhs)
    if rt.known {
        checkLitCtx(c: inout c, id: lhs, eKind: 1, eBits: rt.bits, eSgn: rt.sgn)
        checkLitCtx(c: inout c, id: rhs, eKind: 1, eBits: rt.bits, eSgn: rt.sgn)
        return
    }
    checkLitCtx(c: inout c, id: lhs, eKind: 0, eBits: 0, eSgn: false)
    checkLitCtx(c: inout c, id: rhs, eKind: 0, eBits: 0, eSgn: false)
}

// checkLitCtx with the expected type given as a recovered TypeInfo.
fn checkLitTi(c: inout Comp, id: U64, ti: TypeInfo) {
    if tiIsInt(c: inout c, ti: ti) {
        checkLitCtx(c: inout c, id: id, eKind: 1, eBits: intBits(c: inout c, start: ti.nameStart, len: ti.nameLen), eSgn: intSigned(c: inout c, start: ti.nameStart, len: ti.nameLen))
        return
    }
    checkLitCtx(c: inout c, id: id, eKind: 0, eBits: 0, eSgn: false)
}

// checkLitCtx against a written type span (annotation / param / field).
fn checkLitSpan(c: inout Comp, id: U64, tyStart: U64, tyLen: U64, isArray: Bool) {
    if isArray {
        checkLitArray(c: inout c, id: id, elemStart: tyStart, elemLen: tyLen)
        return
    }
    checkLitTi(c: inout c, id: id, ti: typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false))
}

// Range-check the elements of an array literal against the element type.
fn checkLitArray(c: inout Comp, id: U64, elemStart: U64, elemLen: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Array { val elems } => {
            mut val i: U64 = 0
            while i < elems.count {
                checkLitSpan(c: inout c, id: elems[i], tyStart: elemStart, tyLen: elemLen, isArray: false)
                i += 1
            }
        }
        _ => { checkLitCtx(c: inout c, id: id, eKind: 0, eBits: 0, eSgn: false) }
    }
}

// Check call args against the callee's parameter types. Builtins (not found as a
// user function) keep their args lenient at I64 (placeholder I/O shims).
fn checkCallArgs(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen)
    if fi == c.funcs.count {
        mut val i: U64 = 0
        while i < args.count {
            checkLitCtx(c: inout c, id: args[i].expr, eKind: 1, eBits: 64, eSgn: true)
            i += 1
        }
        return
    }
    val f: Func = c.funcs[fi]
    val ps: Array[Param] = f.params
    mut val i: U64 = 0
    while i < args.count {
        if i < ps.count {
            val p: Param = ps[i]
            checkLitSpan(c: inout c, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
        } else {
            checkLitCtx(c: inout c, id: args[i].expr, eKind: 0, eBits: 0, eSgn: false)
        }
        i += 1
    }
}

// Check method-call args against the method's params; array `.append(x)` checks
// `x` against the element type. Other builtins keep args lenient at I64.
fn checkMethodArgs(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    checkLitCtx(c: inout c, id: recv, eKind: 0, eBits: 0, eSgn: false)
    val rt: TypeInfo = exprType(c: inout c, id: recv)
    if rt.kind == 2 {
        val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen)
        if mi != c.funcs.count {
            val mf: Func = c.funcs[mi]
            val ps: Array[Param] = mf.params
            mut val i: U64 = 0
            while i < args.count {
                if i < ps.count {
                    val p: Param = ps[i]
                    checkLitSpan(c: inout c, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                } else {
                    checkLitCtx(c: inout c, id: args[i].expr, eKind: 0, eBits: 0, eSgn: false)
                }
                i += 1
            }
            return
        }
    }
    if rt.kind == 3 {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "append") {
            mut val i: U64 = 0
            while i < args.count {
                checkLitSpan(c: inout c, id: args[i].expr, tyStart: rt.nameStart, tyLen: rt.nameLen, isArray: false)
                i += 1
            }
            return
        }
    }
    mut val i: U64 = 0
    while i < args.count {
        checkLitCtx(c: inout c, id: args[i].expr, eKind: 1, eBits: 64, eSgn: true)
        i += 1
    }
}

// Declared type of a Make field (struct field or enum variant field).
fn makeFieldType(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    if isEnum {
        mut val ei: U64 = 0
        while ei < c.enums.count {
            val en: EnumDef = c.enums[ei]
            if spansEqual(c: inout c, aStart: en.nameStart, aLen: en.nameLen, bStart: typeStart, bLen: typeLen) {
                val vars: Array[Variant] = en.variants
                mut val vi: U64 = 0
                while vi < vars.count {
                    val v: Variant = vars[vi]
                    if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                        val fs: Array[FieldDef] = v.fields
                        mut val fj: U64 = 0
                        while fj < fs.count {
                            val fd: FieldDef = fs[fj]
                            if spansEqual(c: inout c, aStart: fd.nameStart, aLen: fd.nameLen, bStart: fieldStart, bLen: fieldLen) {
                                return typeInfoOfName(c: inout c, start: fd.tyStart, len: fd.tyLen, isArray: fd.tyIsArray)
                            }
                            fj += 1
                        }
                    }
                    vi += 1
                }
            }
            ei += 1
        }
        return scalarInfo()
    }
    return fieldType(c: inout c, structStart: typeStart, structLen: typeLen, fieldStart: fieldStart, fieldLen: fieldLen)
}

// Check each provided Make field value against its declared field type.
fn checkMakeFields(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, fields: Array[MakeField]) {
    mut val i: U64 = 0
    while i < fields.count {
        val mf: MakeField = fields[i]
        val ft: TypeInfo = makeFieldType(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
        if ft.kind == 3 {
            checkLitArray(c: inout c, id: mf.value, elemStart: ft.nameStart, elemLen: ft.nameLen)
        } else {
            checkLitTi(c: inout c, id: mf.value, ti: ft)
        }
        i += 1
    }
}

fn genExpr(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value, offset: _, isBool: _, tyStart: _, tyLen: _ } => { writeInt(n: value) }
        Expr.Ident { val start, val len } => {
            if isInoutLocal(c: inout c, start: start, len: len) {
                write(s: "(*")
                writeSpan(c: inout c, start: start, len: len)
                write(s: ")")
            } else {
                writeSpan(c: inout c, start: start, len: len)
            }
        }
        Expr.Unary { val op, val operand } => {
            mut val negChecked: Bool = false
            if op == 57 {
                val ot: TypeInfo = exprType(c: inout c, id: operand)
                if ot.kind == 0 {
                    if isIntType(c: inout c, start: ot.nameStart, len: ot.nameLen) {
                        if intSigned(c: inout c, start: ot.nameStart, len: ot.nameLen) {
                            genCheckedNeg(c: inout c, operand: operand, tyStart: ot.nameStart, tyLen: ot.nameLen)
                            negChecked = true
                        }
                    }
                }
            }
            if negChecked {
            } else {
                write(s: unaryOpStr(op: op))
                write(s: "(")
                genExpr(c: inout c, id: operand)
                write(s: ")")
            }
        }
        Expr.Binary { val op, val lhs, val rhs } => {
            if isStringEq(c: inout c, op: op, lhs: lhs) {
                if op == 51 {
                    write(s: "(!PlewString_eq(")
                } else {
                    write(s: "PlewString_eq(")
                }
                genExpr(c: inout c, id: lhs)
                write(s: ", ")
                genExpr(c: inout c, id: rhs)
                if op == 51 {
                    write(s: "))")
                } else {
                    write(s: ")")
                }
            } else {
                if isEnumEq(c: inout c, op: op, lhs: lhs) {
                    emitEnumTagCmp(c: inout c, lhs: lhs, rhs: rhs, op: op, outer: true)
                } else {
                    if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
                    } else {
                        if op == 59 {
                            // `/`: zero divisor always panics; signed INT_MIN/-1
                            // overflows. Width-aware when the type is known; else
                            // the generic (zero-checked) plew_div.
                            val dt: TypeInfo = arithIntType(c: inout c, lhs: lhs, rhs: rhs)
                            if dt.nameLen > 0 {
                                genCheckedDiv(c: inout c, lhs: lhs, rhs: rhs, tyStart: dt.nameStart, tyLen: dt.nameLen, isMod: false)
                            } else {
                                write(s: "plew_div(")
                                genExpr(c: inout c, id: lhs)
                                write(s: ", ")
                                genExpr(c: inout c, id: rhs)
                                write(s: ")")
                            }
                        } else {
                            if op == 60 {
                                // `%`: same — divisor must be nonzero.
                                val mt: TypeInfo = arithIntType(c: inout c, lhs: lhs, rhs: rhs)
                                if mt.nameLen > 0 {
                                    genCheckedDiv(c: inout c, lhs: lhs, rhs: rhs, tyStart: mt.nameStart, tyLen: mt.nameLen, isMod: true)
                                } else {
                                    write(s: "plew_mod(")
                                    genExpr(c: inout c, id: lhs)
                                    write(s: ", ")
                                    genExpr(c: inout c, id: rhs)
                                    write(s: ")")
                                }
                            } else {
                                val at: TypeInfo = arithIntType(c: inout c, lhs: lhs, rhs: rhs)
                                if isCheckedArith(op: op) {
                                    if at.nameLen > 0 {
                                        genCheckedArith(c: inout c, op: op, lhs: lhs, rhs: rhs, tyStart: at.nameStart, tyLen: at.nameLen)
                                    } else {
                                        write(s: "(")
                                        genExpr(c: inout c, id: lhs)
                                        write(s: binOpStr(op: op))
                                        genExpr(c: inout c, id: rhs)
                                        write(s: ")")
                                    }
                                } else {
                                    write(s: "(")
                                    genExpr(c: inout c, id: lhs)
                                    write(s: binOpStr(op: op))
                                    genExpr(c: inout c, id: rhs)
                                    write(s: ")")
                                }
                            }
                        }
                    }
                }
            }
        }
        Expr.Call { val nameStart, val nameLen, val args } => {
            // compileError / compileErrorAt are ordinary module functions (defined
            // above via eprint/exit), so they are NOT special-cased here — calls
            // lower like any other user-function call. (Kept spec-valid: no ambient
            // diagnostic builtin.)
            // I/O builtins -> C runtime.
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") {
                if c.impWrite {
                    write(s: "plew_write(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "write is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "writeByte") {
                if c.impWriteByte {
                    write(s: "putchar((int)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "writeByte is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "eprint") {
                if c.impEprint {
                    write(s: "plew_eprint(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "eprint is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "exit") {
                if c.impExit {
                    write(s: "exit((int)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "exit is not ambient; import it from @Std/Process")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                if c.impReadStdin {
                    write(s: "plew_read_stdin()")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readStdin is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") {
                if c.impReadFile {
                    write(s: "plew_read_file(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readFile is not ambient; import it from @Std/Io")
                }
                return
            }
            // readFileBytes(path: Array[U8]) -> String. Bundled under the same
            // `readFile` import (an internal helper for multi-file `part`).
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") {
                if c.impReadFile {
                    write(s: "plew_read_file_bytes(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readFile is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "fileExists") {
                if c.impFileExists {
                    write(s: "plew_file_exists(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "fileExists is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") {
                if c.impArgCount {
                    write(s: "plew_arg_count()")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argCount is not ambient; import it from @Std/Process")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") {
                if c.impArgAt {
                    write(s: "plew_arg_at((long long)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argAt is not ambient; import it from @Std/Process")
                }
                return
            }
            if callLabelsOk(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args) {
            } else {
                // label missing / wrong / out of order -> undeclared identifier
                // so the C compile fails loudly (spec: labels are required).
                compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argument labels do not match the function parameters")
                return
            }
            writeSpan(c: inout c, start: nameStart, len: nameLen)
            write(s: "(")
            mut val i: U64 = 0
            while i < args.count {
                if i > 0 {
                    write(s: ", ")
                }
                val ar: Arg = args[i]
                if ar.isInout {
                    write(s: "&(")
                    genExpr(c: inout c, id: ar.expr)
                    write(s: ")")
                } else {
                    genExpr(c: inout c, id: ar.expr)
                }
                i += 1
            }
            write(s: ")")
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 1 {
                // String.bytes: view the string buffer as an Array[U8] (shared).
                write(s: "({ PlewString __s = ")
                genExpr(c: inout c, id: base)
                write(s: "; (PlewArray_U8){(unsigned char*)__s.data, __s.len, __s.len}; })")
                return
            }
            if bt.kind == 3 {
                // arr.count -> length
                write(s: "(long long)((")
                genExpr(c: inout c, id: base)
                write(s: ").len)")
                return
            }
            genExpr(c: inout c, id: base)
            write(s: ".")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
        }
        Expr.Str { val start, val len } => {
            write(s: "(PlewString){\"")
            writeSpan(c: inout c, start: start + 1, len: len - 2)
            write(s: "\", ")
            writeInt(n: strDecodedLen(c: inout c, start: start, len: len))
            write(s: "}")
        }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            write(s: "PlewArray_")
            writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
            write(s: "_get(")
            genExpr(c: inout c, id: base)
            write(s: ", (long long)(")
            genExpr(c: inout c, id: index)
            write(s: "))")
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => {
            val bt: TypeInfo = exprType(c: inout c, id: recv)
            if bt.kind == 3 {
                // array builtin: `.append(v)` mutates the receiver, so it must be
                // a mutable place (spec: `val` arrays are immutable).
                if placeIsMutable(c: inout c, id: recv) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: recv)), msg: "cannot mutate an immutable binding; declare it with `mut val`")
                    return
                }
                // array builtin: `.append(v)` -> PlewArray_E_push(&recv, v).
                write(s: "PlewArray_")
                writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                write(s: "_push(&(")
                genExpr(c: inout c, id: recv)
                write(s: "), ")
                genExpr(c: inout c, id: args[0].expr)
                write(s: ")")
            } else {
                // user method on a named type: `recv.m(args)` -> Recv_m(self, args)
                // (self by value, or &recv for an `inout fn` receiver).
                val mi: U64 = findMethod(c: inout c, recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: nameStart, nameLen: nameLen)
                if mi == c.funcs.count {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "no such method on this type")
                    return
                }
                val mf: Func = c.funcs[mi]
                if paramsLabelsOk(c: inout c, params: mf.params, args: args) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argument labels do not match the method parameters")
                    return
                }
                // an `inout fn` method mutates its receiver, so the receiver must
                // be a mutable place.
                if mf.selfInout {
                    if placeIsMutable(c: inout c, id: recv) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: recv)), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
                        return
                    }
                }
                writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                write(s: "_")
                writeSpan(c: inout c, start: nameStart, len: nameLen)
                write(s: "(")
                if mf.selfInout {
                    write(s: "&(")
                    genExpr(c: inout c, id: recv)
                    write(s: ")")
                } else {
                    genExpr(c: inout c, id: recv)
                }
                mut val i: U64 = 0
                while i < args.count {
                    write(s: ", ")
                    val ar: Arg = args[i]
                    if ar.isInout {
                        write(s: "&(")
                        genExpr(c: inout c, id: ar.expr)
                        write(s: ")")
                    } else {
                        genExpr(c: inout c, id: ar.expr)
                    }
                    i += 1
                }
                write(s: ")")
            }
        }
        Expr.Array { val elems } => {
            // Array literals appear only in typed positions (let init / JSX
            // field / array assignment), handled by genArrayLiteral with the
            // declared element type. A bare literal here has no element context.
            write(s: "0")
        }
        Expr.Cast { val operand, val tyStart, val tyLen, ty: _ } => {
            // lossless-`as` check (spec: `as` is infallible/lossless; narrowing or
            // signedness change must go through TryFrom). Only checked when the
            // target is an integer type and the source is a literal or has a
            // recoverable integer type; otherwise left to a later pass.
            if isIntType(c: inout c, start: tyStart, len: tyLen) {
                val opE: Expr = c.exprs[operand]
                match opE {
                    Expr.Int { val value, val offset, isBool: _, tyStart: _, tyLen: _ } => {
                        if litFitsType(c: inout c, value: value, dstStart: tyStart, dstLen: tyLen) {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal is out of range for the target type of `as`")
                            return
                        }
                    }
                    _ => {
                        val st: TypeInfo = exprType(c: inout c, id: operand)
                        if isIntType(c: inout c, start: st.nameStart, len: st.nameLen) {
                            if losslessInt(c: inout c, srcStart: st.nameStart, srcLen: st.nameLen, dstStart: tyStart, dstLen: tyLen) {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "`as` would lose information (narrowing or signedness change); use a fallible TryFrom conversion")
                                return
                            }
                        }
                    }
                }
            }
            write(s: "((")
            genCElem(c: inout c, start: tyStart, len: tyLen)
            write(s: ")(")
            genExpr(c: inout c, id: operand)
            write(s: "))")
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            if isEnum {
                write(s: "(")
                writeSpan(c: inout c, start: typeStart, len: typeLen)
                write(s: "){.tag = ")
                writeU64(n: variantIndex(c: inout c, enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen))
                if fields.count > 0 {
                    write(s: ", .data.")
                    writeSpan(c: inout c, start: variantStart, len: variantLen)
                    write(s: " = {")
                    mut val i: U64 = 0
                    while i < fields.count {
                        if i > 0 {
                            write(s: ", ")
                        }
                        val mf: MakeField = fields[i]
                        write(s: ".")
                        writeSpan(c: inout c, start: mf.nameStart, len: mf.nameLen)
                        write(s: " = ")
                        genExpr(c: inout c, id: mf.value)
                        i += 1
                    }
                    write(s: "}")
                }
                write(s: "}")
            } else {
                write(s: "(")
                genCType(c: inout c, start: typeStart, len: typeLen)
                write(s: "){")
                mut val i: U64 = 0
                while i < fields.count {
                    if i > 0 {
                        write(s: ", ")
                    }
                    val mf: MakeField = fields[i]
                    write(s: ".")
                    writeSpan(c: inout c, start: mf.nameStart, len: mf.nameLen)
                    write(s: " = ")
                    val ft: TypeInfo = fieldType(c: inout c, structStart: typeStart, structLen: typeLen, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
                    if ft.kind == 3 {
                        genArrayLiteral(c: inout c, exprId: mf.value, elemStart: ft.nameStart, elemLen: ft.nameLen)
                    } else {
                        genExpr(c: inout c, id: mf.value)
                    }
                    i += 1
                }
                write(s: "}")
            }
        }
        Expr.MatchExpr { val scrut, val arms } => {
            // value-position match -> C statement-expression. Mirrors the
            // Stmt.Match lowering but each arm assigns the result temp __mr.
            if matchExhaustive(c: inout c, arms: arms) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: scrut)), msg: "match must be exhaustive: cover all variants or add a wildcard")
                return
            }
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            // result type inferred from the first arm's expression (provisional:
            // a result type that depends on a pattern bind may mis-infer).
            val rt: TypeInfo = exprType(c: inout c, id: arms[0].body)
            mut val enumStart: U64 = 0
            mut val enumLen: U64 = 0
            mut val hasWildcard: Bool = false
            mut val q: U64 = 0
            while q < arms.count {
                val aq: MatchArm = arms[q]
                if aq.isWildcard {
                    hasWildcard = true
                } else {
                    if enumLen == 0 {
                        enumStart = aq.enumStart
                        enumLen = aq.enumLen
                    }
                }
                q += 1
            }
            write(s: "({ ")
            genTypeInfoCType(c: inout c, ti: rt)
            write(s: " __mr")
            writeU64(n: t)
            write(s: "; ")
            writeSpan(c: inout c, start: enumStart, len: enumLen)
            write(s: " __ms")
            writeU64(n: t)
            write(s: " = ")
            genExpr(c: inout c, id: scrut)
            write(s: "; ")
            mut val i: U64 = 0
            mut val firstCond: Bool = true
            while i < arms.count {
                val a: MatchArm = arms[i]
                if a.isWildcard {
                    write(s: "else { __mr")
                    writeU64(n: t)
                    write(s: " = (")
                    genExpr(c: inout c, id: a.body)
                    write(s: "); } ")
                } else {
                    if firstCond {
                        write(s: "if (__ms")
                        firstCond = false
                    } else {
                        write(s: "else if (__ms")
                    }
                    writeU64(n: t)
                    write(s: ".tag == ")
                    writeU64(n: variantIndex(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen))
                    write(s: ") { ")
                    val binds: Array[Bind] = a.binds
                    mut val bi: U64 = 0
                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        genBindType(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.fieldStart, bindLen: bd.fieldLen)
                        write(s: " ")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: " = __ms")
                        writeU64(n: t)
                        write(s: ".data.")
                        writeSpan(c: inout c, start: a.variantStart, len: a.variantLen)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
                        write(s: "; (void)")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: "; ")
                        addBindLocal(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
                        bi += 1
                    }
                    write(s: "__mr")
                    writeU64(n: t)
                    write(s: " = (")
                    genExpr(c: inout c, id: a.body)
                    write(s: "); } ")
                }
                i += 1
            }
            if hasWildcard {
            } else {
                write(s: "else { __builtin_unreachable(); } ")
            }
            write(s: "__mr")
            writeU64(n: t)
            write(s: "; })")
        }
        Expr.IfExpr { val cond, val thenBlk, val elseBlk } => {
            // value-position if -> C statement-expression. Each branch is a block
            // ending in `give`, which assigns the result temp __r<t>.
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            val g: U64 = blockGiveExpr(c: inout c, blkId: thenBlk)
            mut val rt: TypeInfo = scalarInfo()
            if g < c.exprs.count {
                rt = exprType(c: inout c, id: g)
            }
            write(s: "({ ")
            genTypeInfoCType(c: inout c, ti: rt)
            write(s: " __r")
            writeU64(n: t)
            write(s: "; if (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            val save: U64 = c.curGiveTmp
            c.curGiveTmp = t + 1
            genBlock(c: inout c, id: thenBlk)
            write(s: "    } else {\n")
            genBlock(c: inout c, id: elseBlk)
            c.curGiveTmp = save
            write(s: "    } __r")
            writeU64(n: t)
            write(s: "; })")
        }
    }
}

// Emit an array literal given the element type from context (declared type of
// the let / field it initializes). Empty -> _new(); non-empty -> a statement
// expression that news then pushes. Falls back to genExpr for non-literals.
fn genArrayLiteral(c: inout Comp, exprId: U64, elemStart: U64, elemLen: U64) {
    val e: Expr = c.exprs[exprId]
    match e {
        Expr.Array { val elems } => {
            if elems.count == 0 {
                write(s: "PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: "_new()")
            } else {
                write(s: "({ PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: " __a = PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: "_new(); ")
                mut val i: U64 = 0
                while i < elems.count {
                    write(s: "PlewArray_")
                    writeSpan(c: inout c, start: elemStart, len: elemLen)
                    write(s: "_push(&__a, ")
                    genExpr(c: inout c, id: elems[i])
                    write(s: "); ")
                    i += 1
                }
                write(s: "__a; })")
            }
        }
        _ => { genExpr(c: inout c, id: exprId) }
    }
}

// Whether `lhs OP rhs` is a String `==` / `!=` (which lowers to PlewString_eq
// rather than a C struct comparison).
fn isStringEq(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op == 50 {
    } else {
        if op == 51 {
        } else {
            return false
        }
    }
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    return lt.kind == 1
}

fn isEnumName(c: inout Comp, start: U64, len: U64) -> Bool {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
            return true
        }
        ei += 1
    }
    return false
}

// Whether every variant of the named enum is nullary (no payload). Tag-only
// `==` is exact for such enums; payload-bearing enums need structural Eq.
fn isAllNullary(c: inout Comp, start: U64, len: U64) -> Bool {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if v.fields.count > 0 {
                    return false
                }
                vi += 1
            }
            return true
        }
        ei += 1
    }
    return false
}

// Whether `lhs OP rhs` is an enum `==` / `!=`. Provisional: lowered to a tag
// (variant) comparison, NOT a payload-aware structural Eq. For all-nullary
// enums this coincides with structural equality; full Eq comes with @[Eq].
fn isEnumEq(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op == 50 {
    } else {
        if op == 51 {
        } else {
            return false
        }
    }
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind == 2 {
        return isEnumName(c: inout c, start: lt.nameStart, len: lt.nameLen)
    }
    return false
}

// Acceptance soundness: comparison operators (== != < <= > >=) are trait-backed
// (Eq/Ord). The compiler hardcodes them for numbers, String `==`/`!=`, and
// all-nullary enum `==`; applied to a struct or array there is no Eq/Ord, so it
// must be a compile error rather than broken C. (Reached only after the
// String-eq and enum-eq paths have been ruled out.)
fn compareNeedsTrait(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op < 50 {
        return false
    }
    if op > 55 {
        return false
    }
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind == 3 {
        return true
    }
    if lt.kind == 2 {
        if isEnumName(c: inout c, start: lt.nameStart, len: lt.nameLen) {
            return false
        }
        return true
    }
    return false
}

// Emit one operand of an enum tag comparison: a variant construction becomes
// its tag index literal; any other enum value becomes `(expr).tag`.
fn emitEnumOperand(c: inout Comp, id: U64, enStart: U64, enLen: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            if isEnum {
                writeU64(n: variantIndex(c: inout c, enumStart: enStart, enumLen: enLen, variantStart: variantStart, variantLen: variantLen))
                return
            }
        }
        _ => {}
    }
    write(s: "(")
    genExpr(c: inout c, id: id)
    write(s: ").tag")
}

// Emit an enum `==`/`!=` as a tag comparison. Resolves the enum from whichever
// operand is a value of that enum. PROVISIONAL: only all-nullary enums are
// allowed; a payload-bearing enum emits an undeclared identifier so the C
// compile fails loudly (structural Eq awaits @[Eq] — never compare blind).
fn emitEnumTagCmp(c: inout Comp, lhs: U64, rhs: U64, op: I64, outer: Bool) {
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    mut val enStart: U64 = 0
    mut val enLen: U64 = 0
    if lt.kind == 2 {
        enStart = lt.nameStart
        enLen = lt.nameLen
    } else {
        val rt: TypeInfo = exprType(c: inout c, id: rhs)
        enStart = rt.nameStart
        enLen = rt.nameLen
    }
    if isAllNullary(c: inout c, start: enStart, len: enLen) {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "enum == needs structural Eq for payload variants (only all-nullary enums compare by tag)")
        return
    }
    if outer {
        write(s: "(")
    }
    emitEnumOperand(c: inout c, id: lhs, enStart: enStart, enLen: enLen)
    if op == 51 {
        write(s: " != ")
    } else {
        write(s: " == ")
    }
    emitEnumOperand(c: inout c, id: rhs, enStart: enStart, enLen: enLen)
    if outer {
        write(s: ")")
    }
}

// Emit an expression in condition position. A top-level binary drops its outer
// parens (the `if (...)` / `while (...)` already supplies them), which avoids
// the `-Wparentheses-equality` warning on `if ((a == b))`. String/enum equality
// have their own lowerings handled here too.
fn genCond(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Binary { val op, val lhs, val rhs } => {
            if isStringEq(c: inout c, op: op, lhs: lhs) {
                genExpr(c: inout c, id: id)
            } else {
                if isEnumEq(c: inout c, op: op, lhs: lhs) {
                    emitEnumTagCmp(c: inout c, lhs: lhs, rhs: rhs, op: op, outer: false)
                } else {
                    if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
                    } else {
                        genExpr(c: inout c, id: lhs)
                        write(s: binOpStr(op: op))
                        genExpr(c: inout c, id: rhs)
                    }
                }
            }
        }
        _ => { genExpr(c: inout c, id: id) }
    }
}

fn genStmt(c: inout Comp, id: U64) {
    val s: Stmt = c.stmts[id]
    match s {
        Stmt.Let { val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init } => {
            checkLitSpan(c: inout c, id: init, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray)
            write(s: "    ")
            genCTypeRef(c: inout c, start: tyStart, len: tyLen, isArray: tyIsArray)
            write(s: " ")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
            write(s: " = ")
            if tyIsArray {
                genArrayLiteral(c: inout c, exprId: init, elemStart: tyStart, elemLen: tyLen)
            } else {
                genExpr(c: inout c, id: init)
            }
            write(s: ";\n")
            addLocal(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, ty: ty, isInout: false, isMut: mutable)
        }
        Stmt.Assign { val op, val target, val value } => {
            val te: Expr = c.exprs[target]
            match te {
                Expr.Index { val base, val index } => {
                    // a[i] = v / a[i] OP= v -> bounds-checked PlewArray_E_set.
                    // The array binding must be a mutable place (mutating an
                    // element is a mutation of the array value).
                    if placeIsMutable(c: inout c, id: base) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "cannot assign to an element of an immutable binding; declare it with `mut val`")
                        return
                    }
                    val bt: TypeInfo = exprType(c: inout c, id: base)
                    if bt.kind == 3 {
                        checkLitSpan(c: inout c, id: value, tyStart: bt.nameStart, tyLen: bt.nameLen, isArray: false)
                    }
                    write(s: "    PlewArray_")
                    writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                    write(s: "_set(&(")
                    genExpr(c: inout c, id: base)
                    write(s: "), (long long)(")
                    genExpr(c: inout c, id: index)
                    write(s: "), ")
                    if op == 49 {
                        genExpr(c: inout c, id: value)
                    } else {
                        // `a[i] OP= v` -> set(a, i, get(a, i) OP v). Arithmetic
                        // is overflow-checked, `/=`/`%=` route through the checked
                        // plew_div/plew_mod (zero divisor / INT64_MIN -1), same as
                        // `a[i] = a[i] OP v`.
                        val cbin: I64 = compoundCheckedBin(op: op)
                        val elemInt: Bool = isIntType(c: inout c, start: bt.nameStart, len: bt.nameLen)
                        if isCompoundDiv(op: op) {
                            write(s: compoundDivFn(op: op))
                            genArrayGet(c: inout c, base: base, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                            write(s: ", ")
                            genExpr(c: inout c, id: value)
                            write(s: ")")
                        } else {
                            mut val checkedElem: Bool = false
                            if cbin != 0 {
                                if elemInt {
                                    checkedElem = true
                                }
                            }
                            if checkedElem {
                                write(s: "({ ")
                                genCElem(c: inout c, start: bt.nameStart, len: bt.nameLen)
                                write(s: " __ov; if (")
                                write(s: overflowBuiltin(op: cbin))
                                write(s: "((")
                                genArrayGet(c: inout c, base: base, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                                write(s: "), (")
                                genExpr(c: inout c, id: value)
                                write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
                            } else {
                                genArrayGet(c: inout c, base: base, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                                write(s: assignToBinStr(op: op))
                                genExpr(c: inout c, id: value)
                            }
                        }
                    }
                    write(s: ");\n")
                }
                _ => {
                    // Acceptance soundness: the target must be a mutable place.
                    // A plain `val` binding is immutable (only `mut val` locals /
                    // `inout` params assign); a `base.field` target additionally
                    // needs the field declared `mut val` (composite mutability).
                    if placeIsMutable(c: inout c, id: target) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "cannot assign to an immutable place; the binding and field must be declared `mut val`")
                        return
                    }
                    val ctt: TypeInfo = exprType(c: inout c, id: target)
                    if ctt.kind == 3 {
                        checkLitArray(c: inout c, id: value, elemStart: ctt.nameStart, elemLen: ctt.nameLen)
                    } else {
                        checkLitTi(c: inout c, id: value, ti: ctt)
                    }
                    write(s: "    ")
                    genExpr(c: inout c, id: target)
                    if isCompoundDiv(op: op) {
                        // `x /= v` / `x %= v` -> x = checked(x / v): zero divisor
                        // and signed INT_MIN/-1 panic, like `x = x / v`.
                        write(s: " = ")
                        val dt: TypeInfo = exprType(c: inout c, id: target)
                        if dt.kind == 0 {
                            if isIntType(c: inout c, start: dt.nameStart, len: dt.nameLen) {
                                genCheckedDiv(c: inout c, lhs: target, rhs: value, tyStart: dt.nameStart, tyLen: dt.nameLen, isMod: op == 71)
                            } else {
                                write(s: compoundDivFn(op: op))
                                genExpr(c: inout c, id: target)
                                write(s: ", ")
                                genExpr(c: inout c, id: value)
                                write(s: ")")
                            }
                        } else {
                            write(s: compoundDivFn(op: op))
                            genExpr(c: inout c, id: target)
                            write(s: ", ")
                            genExpr(c: inout c, id: value)
                            write(s: ")")
                        }
                    } else {
                        val tt: TypeInfo = exprType(c: inout c, id: target)
                        val cbin: I64 = compoundCheckedBin(op: op)
                        mut val checked: Bool = false
                        if cbin != 0 {
                            if tt.kind == 0 {
                                if isIntType(c: inout c, start: tt.nameStart, len: tt.nameLen) {
                                    checked = true
                                }
                            }
                        }
                        if checked {
                            // `x OP= v` -> `x = checked(x OP v)`. The place has no
                            // side effects in this subset, so the re-evaluation is
                            // observationally identical (hidden cost only).
                            write(s: " = ")
                            genCheckedArith(c: inout c, op: cbin, lhs: target, rhs: value, tyStart: tt.nameStart, tyLen: tt.nameLen)
                        } else {
                            write(s: assignOpStr(op: op))
                            if tt.kind == 3 {
                                genArrayLiteral(c: inout c, exprId: value, elemStart: tt.nameStart, elemLen: tt.nameLen)
                            } else {
                                genExpr(c: inout c, id: value)
                            }
                        }
                    }
                    write(s: ";\n")
                }
            }
        }
        Stmt.Print { val expr, val offset } => {
            if c.impPrint {
                // print is a placeholder I/O builtin that accepts any integer; its
                // literal arg defaults to I64 (a documented shim, not spec surface).
                checkLitCtx(c: inout c, id: expr, eKind: 1, eBits: 64, eSgn: true)
                write(s: "    printf(\"%lld\\n\", (long long)(")
                genExpr(c: inout c, id: expr)
                write(s: "));\n")
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "print is not ambient; import it from @Std/Io")
            }
        }
        Stmt.ExprStmt { val expr } => {
            checkLitCtx(c: inout c, id: expr, eKind: 0, eBits: 0, eSgn: false)
            write(s: "    ")
            genExpr(c: inout c, id: expr)
            write(s: ";\n")
        }
        Stmt.Return { val value, val hasValue } => {
            if c.curIsMain {
                write(s: "    return 0;\n")
            } else {
                if c.curRetVoid {
                    write(s: "    return;\n")
                } else {
                    if hasValue {
                        checkLitSpan(c: inout c, id: value, tyStart: c.curRetStart, tyLen: c.curRetLen, isArray: c.curRetIsArray)
                    }
                    write(s: "    return ")
                    if hasValue {
                        genExpr(c: inout c, id: value)
                    } else {
                        write(s: "0")
                    }
                    write(s: ";\n")
                }
            }
        }
        Stmt.If { val cond, val thenBlk, val elseBlk, val hasElse } => {
            checkLitCtx(c: inout c, id: cond, eKind: 0, eBits: 0, eSgn: false)
            write(s: "    if (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            genBlock(c: inout c, id: thenBlk)
            write(s: "    }\n")
            if hasElse {
                write(s: "    else {\n")
                genBlock(c: inout c, id: elseBlk)
                write(s: "    }\n")
            }
        }
        Stmt.While { val cond, val body } => {
            checkLitCtx(c: inout c, id: cond, eKind: 0, eBits: 0, eSgn: false)
            write(s: "    while (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            genBlock(c: inout c, id: body)
            write(s: "    }\n")
        }
        Stmt.For { val varStart, val varLen, val isRange, val inclusive, val iter, val rangeHi, val body } => {
            if isRange {
                checkArithNoCtx(c: inout c, lhs: iter, rhs: rangeHi)
            }
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            if isRange {
                // for (long long var = lo; var (< | <=) __fe; var++) { body }
                write(s: "    {\n")
                write(s: "    long long __fe")
                writeU64(n: t)
                write(s: " = ")
                genExpr(c: inout c, id: rangeHi)
                write(s: ";\n")
                write(s: "    for (long long ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: " = ")
                genExpr(c: inout c, id: iter)
                write(s: "; ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                if inclusive {
                    write(s: " <= __fe")
                } else {
                    write(s: " < __fe")
                }
                writeU64(n: t)
                write(s: "; ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: "++) {\n")
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: 0, tyLen: 0, isArray: false, ty: 0, isInout: false, isMut: false)
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            } else {
                // walk an array by index, binding `var` to each element
                val et: TypeInfo = exprType(c: inout c, id: iter)
                write(s: "    {\n")
                write(s: "    ")
                wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                write(s: " __fa")
                writeU64(n: t)
                write(s: " = ")
                genExpr(c: inout c, id: iter)
                write(s: ";\n")
                write(s: "    for (long long __fi")
                writeU64(n: t)
                write(s: " = 0; __fi")
                writeU64(n: t)
                write(s: " < __fa")
                writeU64(n: t)
                write(s: ".len; __fi")
                writeU64(n: t)
                write(s: "++) {\n")
                write(s: "        ")
                genCElem(c: inout c, start: et.nameStart, len: et.nameLen)
                write(s: " ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: " = ")
                wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                write(s: "_get(__fa")
                writeU64(n: t)
                write(s: ", __fi")
                writeU64(n: t)
                write(s: ");\n")
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false)
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            }
        }
        Stmt.Panic { val msg, val offset } => {
            // diverging: plew_panic is noreturn (writes the message + exit(1)).
            write(s: "    plew_panic(")
            genExpr(c: inout c, id: msg)
            write(s: ");\n")
        }
        Stmt.Give { val value } => {
            // assign the active value-position block's result temp (set by the
            // enclosing IfExpr/MatchExpr lowering).
            if c.curGiveTmp != 0 {
                write(s: "    __r")
                writeU64(n: c.curGiveTmp - 1)
                write(s: " = (")
                genExpr(c: inout c, id: value)
                write(s: ");\n")
            }
        }
        Stmt.Break => {
            write(s: "    break;\n")
        }
        Stmt.Continue => {
            write(s: "    continue;\n")
        }
        Stmt.Match { val scrut, val arms } => {
            if matchExhaustive(c: inout c, arms: arms) {
            } else {
                // non-exhaustive match -> undeclared identifier so the C compile
                // fails loudly (spec: match must be exhaustive).
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: scrut)), msg: "match must be exhaustive: cover all variants or add a wildcard")
                return
            }
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            // enum type for the scrutinee temp = the enum named by the first
            // non-wildcard arm's pattern.
            mut val enumStart: U64 = 0
            mut val enumLen: U64 = 0
            mut val hasWildcard: Bool = false
            mut val q: U64 = 0
            while q < arms.count {
                val aq: MatchArm = arms[q]
                if aq.isWildcard {
                    hasWildcard = true
                } else {
                    if enumLen == 0 {
                        enumStart = aq.enumStart
                        enumLen = aq.enumLen
                    }
                }
                q += 1
            }
            write(s: "    {\n")
            write(s: "    ")
            writeSpan(c: inout c, start: enumStart, len: enumLen)
            write(s: " _m")
            writeU64(n: t)
            write(s: " = ")
            genExpr(c: inout c, id: scrut)
            write(s: ";\n")
            mut val i: U64 = 0
            mut val firstCond: Bool = true
            while i < arms.count {
                val a: MatchArm = arms[i]
                if a.isWildcard {
                    write(s: "    else {\n")
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                } else {
                    if firstCond {
                        write(s: "    if (_m")
                        firstCond = false
                    } else {
                        write(s: "    else if (_m")
                    }
                    writeU64(n: t)
                    write(s: ".tag == ")
                    writeU64(n: variantIndex(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen))
                    write(s: ") {\n")
                    val binds: Array[Bind] = a.binds
                    mut val bi: U64 = 0
                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        write(s: "        ")
                        genBindType(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.fieldStart, bindLen: bd.fieldLen)
                        write(s: " ")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: " = _m")
                        writeU64(n: t)
                        write(s: ".data.")
                        writeSpan(c: inout c, start: a.variantStart, len: a.variantLen)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
                        write(s: ";\n")
                        // mark used so an unreferenced bind doesn't warn
                        write(s: "        (void)")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: ";\n")
                        addBindLocal(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
                        bi += 1
                    }
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                }
                i += 1
            }
            // exhaustive match without a wildcard: the final fall-through is
            // unreachable (so a value-returning function does not "fall off").
            if hasWildcard {
            } else {
                write(s: "    else { __builtin_unreachable(); }\n")
            }
            write(s: "    }\n")
        }
    }
}

fn genBlock(c: inout Comp, id: U64) {
    val b: Block = c.blocks[id]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        genStmt(c: inout c, id: stmts[i])
        i += 1
    }
}

fn nameIsMain(c: inout Comp, f: Func) -> Bool {
    if f.hasRecv {
        return false
    }
    return rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: "main")
}

// Emit a struct body `struct Name { <ctype> field; ... };`. Forward typedefs
// are emitted separately so structs can reference each other by name; by-value
// struct fields still require their definition to appear earlier (v3 relies on
// source order being dependency order).
fn genStructDef(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    write(s: "struct ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " {\n")
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        val f: FieldDef = fields[i]
        write(s: "    ")
        genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
        write(s: " ")
        writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
        write(s: ";\n")
        i += 1
    }
    write(s: "};\n")
}

// Emit a C function signature (no trailing `;` or `{`). `main` is special:
// `int main(void)`. The return type and each parameter type come from the
// declared Plew types via genCType (scalars -> long long, named types echoed).
fn genSignature(c: inout Comp, f: Func) {
    if nameIsMain(c: inout c, f: f) {
        write(s: "int main(int argc, char** argv)")
        return
    }
    if f.hasRet {
        genCTypeRef(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
        write(s: " ")
    } else {
        write(s: "void ")
    }
    // method: mangle to `Recv_name` with a leading `self` parameter.
    if f.hasRecv {
        writeSpan(c: inout c, start: f.recvStart, len: f.recvLen)
        write(s: "_")
    }
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
    write(s: "(")
    val params: Array[Param] = f.params
    if f.hasRecv {
        genCTypeRef(c: inout c, start: f.recvStart, len: f.recvLen, isArray: false)
        if f.selfInout {
            write(s: "*")
        }
        write(s: " self")
        mut val i: U64 = 0
        while i < params.count {
            write(s: ", ")
            val p: Param = params[i]
            genCTypeRef(c: inout c, start: p.tyStart, len: p.tyLen, isArray: p.tyIsArray)
            if p.isInout {
                write(s: "*")
            }
            write(s: " ")
            writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
            i += 1
        }
    } else {
        if params.count == 0 {
            write(s: "void")
        } else {
            mut val i: U64 = 0
            while i < params.count {
                if i > 0 {
                    write(s: ", ")
                }
                val p: Param = params[i]
                genCTypeRef(c: inout c, start: p.tyStart, len: p.tyLen, isArray: p.tyIsArray)
                if p.isInout {
                    write(s: "*")
                }
                write(s: " ")
                writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
                i += 1
            }
        }
    }
    write(s: ")")
}

fn genFunc(c: inout Comp, fi: U64) {
    val f: Func = c.funcs[fi]
    val isMain: Bool = nameIsMain(c: inout c, f: f)
    c.curIsMain = isMain
    if f.hasRet {
        c.curRetVoid = false
        c.curRetStart = f.retStart
        c.curRetLen = f.retLen
        c.curRetIsArray = f.retIsArray
    } else {
        c.curRetVoid = true
        c.curRetStart = 0
        c.curRetLen = 0
        c.curRetIsArray = false
    }
    // expose the method receiver so a bare `self` in the body resolves (and
    // lowers to `(*self)` for `inout fn`).
    c.curHasRecv = f.hasRecv
    c.curRecvStart = f.recvStart
    c.curRecvLen = f.recvLen
    c.curSelfInout = f.selfInout
    // fresh local scope for this function: parameters are the initial bindings
    c.locals = []
    val params: Array[Param] = f.params
    mut val pi: U64 = 0
    while pi < params.count {
        val p: Param = params[pi]
        addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false)
        pi += 1
    }
    genSignature(c: inout c, f: f)
    write(s: " {\n")
    if isMain {
        write(s: "    plew_argc = argc; plew_argv = argv;\n")
    }
    genBlock(c: inout c, id: f.body)
    if isMain {
        write(s: "    return 0;\n")
    }
    write(s: "}\n")
}

// Emit an enum as a tagged union: `struct E { long long tag; union { struct
// {...} V; ... } data; };`. Nullary variants get a dummy member so the inner
// struct is never empty.
fn genEnumDef(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    write(s: "struct ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " {\n")
    write(s: "    long long tag;\n")
    write(s: "    union {\n")
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val v: Variant = vars[vi]
        write(s: "        struct {")
        val fs: Array[FieldDef] = v.fields
        if fs.count == 0 {
            write(s: " char _u; ")
        } else {
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                write(s: " ")
                genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                write(s: " ")
                writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
                write(s: ";")
                fi += 1
            }
            write(s: " ")
        }
        write(s: "} ")
        writeSpan(c: inout c, start: v.nameStart, len: v.nameLen)
        write(s: ";\n")
        vi += 1
    }
    write(s: "    } data;\n")
    write(s: "};\n")
}

// Write the array C name `PlewArray_<elem>`.
fn wPA(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "PlewArray_")
    writeSpan(c: inout c, start: elemStart, len: elemLen)
}

// `typedef struct { ET* data; long long len; long long cap; } PlewArray_E;`
fn genArrayTypedef(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "typedef struct { ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* data; long long len; long long cap; } ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: ";\n")
}

// Monomorphized array runtime for one element type (new / get / set / push).
// Old buffers leak on growth (stage0/stage1 never free — throwaway model).
fn genArrayRuntimeFns(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "__attribute__((unused)) static ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_new(void) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a; a.data = 0; a.len = 0; a.cap = 0; return a; }\n")

    write(s: "__attribute__((unused)) static ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_get(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a, long long i) { if (i < 0 || i >= a.len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")

    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_set(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, long long i, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (i < 0 || i >= a->len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } a->data[i] = v; }\n")

    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_push(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (a->len >= a->cap) { long long nc = a->cap < 4 ? 4 : a->cap * 2; ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* nd = (")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "*)malloc(sizeof(")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: ") * nc); for (long long i = 0; i < a->len; i++) nd[i] = a->data[i]; a->data = nd; a->cap = nc; } a->data[a->len] = v; a->len++; }\n")
}

fn isU8Elem(c: inout Comp, elemStart: U64, elemLen: U64) -> Bool {
    return rangeEquals(bytes: c.bytes, start: elemStart, len: elemLen, kw: "U8")
}

// PlewArray_U8 is always available (String.bytes yields it) and is emitted with
// literal text so it needs no source span for "U8".
fn genU8ArrayTypedef() {
    write(s: "typedef struct { unsigned char* data; long long len; long long cap; } PlewArray_U8;\n")
}

fn genU8ArrayRuntime() {
    write(s: "__attribute__((unused)) static PlewArray_U8 PlewArray_U8_new(void) { PlewArray_U8 a; a.data = 0; a.len = 0; a.cap = 0; return a; }\n")
    write(s: "__attribute__((unused)) static unsigned char PlewArray_U8_get(PlewArray_U8 a, long long i) { if (i < 0 || i >= a.len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")
    write(s: "__attribute__((unused)) static void PlewArray_U8_set(PlewArray_U8* a, long long i, unsigned char v) { if (i < 0 || i >= a->len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } a->data[i] = v; }\n")
    write(s: "__attribute__((unused)) static void PlewArray_U8_push(PlewArray_U8* a, unsigned char v) { if (a->len >= a->cap) { long long nc = a->cap < 4 ? 4 : a->cap * 2; unsigned char* nd = (unsigned char*)malloc(sizeof(unsigned char) * nc); for (long long i = 0; i < a->len; i++) nd[i] = a->data[i]; a->data = nd; a->cap = nc; } a->data[a->len] = v; a->len++; }\n")
}

