// Part of the Plew compiler module (root: _.pw). Code generation: arena AST
// -> C, plus the lightweight type recovery and acceptance-soundness checks.

// ---- C code generation ----

fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

fn writeInt(n: I64) {
    if n < 0 {
        write(s: "-")
        writeInt(n: 0 - n)
        return
    }
    if n >= 10 {
        writeInt(n: n / 10)
    }
    write(s: digitStr(d: n % 10))
}

fn writeSpan(c: inout Comp, start: U64, len: U64) {
    mut val j: U64 = 0
    while j < len {
        writeByte(c.bytes[start + j])
        j += 1
    }
}

fn isPrimType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "Bool") { return true }
    return false
}

// Emit the C *element* type for a type-name span (no Array wrapper): scalars
// -> long long, except U8 -> unsigned char (so byte arrays alias a char buffer
// for String.bytes); String -> PlewString; named struct/enum -> echoed.
fn genCElem(c: inout Comp, start: U64, len: U64) {
    if len == 0 {
        write(s: "long long")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") {
        write(s: "unsigned char")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        write(s: "PlewString")
        return
    }
    if isPrimType(c: inout c, start: start, len: len) {
        write(s: "long long")
        return
    }
    writeSpan(c: inout c, start: start, len: len)
}

// Emit a C type for a (span, isArray) type. `Array[E]` -> `PlewArray_<E>`
// (the element name is C-identifier-safe, so it doubles as the mangle).
fn genCTypeRef(c: inout Comp, start: U64, len: U64, isArray: Bool) {
    if isArray {
        write(s: "PlewArray_")
        writeSpan(c: inout c, start: start, len: len)
        return
    }
    genCElem(c: inout c, start: start, len: len)
}

// Back-compat shim for non-array type positions (scalars / String / named).
fn genCType(c: inout Comp, start: U64, len: U64) {
    genCElem(c: inout c, start: start, len: len)
}

// Compare two source spans byte for byte.
fn spansEqual(c: inout Comp, aStart: U64, aLen: U64, bStart: U64, bLen: U64) -> Bool {
    if aLen != bLen {
        return false
    }
    mut val j: U64 = 0
    while j < aLen {
        if c.bytes[aStart + j] != c.bytes[bStart + j] {
            return false
        }
        j += 1
    }
    return true
}

// 1-based source line for a byte offset (count newlines before it). For
// diagnostics; works across the assembled multi-file buffer.
fn lineOf(c: inout Comp, offset: U64) -> I64 {
    mut val line: I64 = 1
    mut val i: U64 = 0
    while i < offset {
        if c.bytes[i] == 10 {
            line += 1
        }
        i += 1
    }
    return line
}

// Best-effort byte offset for an expression (for diagnostics). Leaf nodes with
// a span return it; compound nodes recurse to a representative child.
fn exprOffset(c: inout Comp, id: U64) -> U64 {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Ident { val start, val len } => { return start }
        Expr.Str { val start, val len } => { return start }
        Expr.Call { val nameStart, val nameLen, val args } => { return nameStart }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => { return nameStart }
        Expr.Field { val base, val nameStart, val nameLen } => { return exprOffset(c: inout c, id: base) }
        Expr.Index { val base, val index } => { return exprOffset(c: inout c, id: base) }
        Expr.Binary { val op, val lhs, val rhs } => { return exprOffset(c: inout c, id: lhs) }
        Expr.Unary { val op, val operand } => { return exprOffset(c: inout c, id: operand) }
        Expr.Cast { val operand, val tyStart, val tyLen } => { return exprOffset(c: inout c, id: operand) }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => { return typeStart }
        _ => { return 0 }
    }
}

// Index of the top-level function named (nameStart,nameLen), or -1 if none.
// Names are unique (no overloading in this compiler), so the first match wins.
fn findFunc(c: inout Comp, nameStart: U64, nameLen: U64) -> I64 {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
        } else {
            if spansEqual(c: inout c, aStart: nameStart, aLen: nameLen, bStart: f.nameStart, bLen: f.nameLen) {
                return i as I64
            }
        }
        i += 1
    }
    return 0 - 1
}

// Index of the method named (nameStart,nameLen) on receiver type
// (recvStart,recvLen), or -1 if none.
fn findMethod(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> I64 {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if spansEqual(c: inout c, aStart: nameStart, aLen: nameLen, bStart: f.nameStart, bLen: f.nameLen) {
                if spansEqual(c: inout c, aStart: recvStart, aLen: recvLen, bStart: f.recvStart, bLen: f.recvLen) {
                    return i as I64
                }
            }
        }
        i += 1
    }
    return 0 - 1
}

// Check call args against a parameter list: arg count matches and every arg
// carries its parameter's label in declaration order (spec: labels required).
fn paramsLabelsOk(c: inout Comp, params: Array[Param], args: Array[Arg]) -> Bool {
    if params.count != args.count {
        return false
    }
    mut val i: U64 = 0
    while i < args.count {
        val a: Arg = args[i]
        if a.hasLabel {
            val p: Param = params[i]
            if spansEqual(c: inout c, aStart: a.labelStart, aLen: a.labelLen, bStart: p.nameStart, bLen: p.nameLen) {
            } else {
                return false
            }
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Acceptance soundness: spec requires every argument to carry its label, in
// declaration order. Check a call against the callee's params. Calls that don't
// resolve to a user function (I/O builtins, methods) return true here — they're
// handled on their own paths and keep their provisional calling conventions.
fn callLabelsOk(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
    val fi: I64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen)
    if fi < 0 {
        return true
    }
    val f: Func = c.funcs[fi as U64]
    return paramsLabelsOk(c: inout c, params: f.params, args: args)
}

// Does some arm cover the variant (variantStart,variantLen)? A wildcard arm
// covers everything.
fn armCovers(c: inout Comp, arms: Array[MatchArm], variantStart: U64, variantLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < arms.count {
        val a: MatchArm = arms[i]
        if a.isWildcard {
            return true
        }
        if spansEqual(c: inout c, aStart: a.variantStart, aLen: a.variantLen, bStart: variantStart, bLen: variantLen) {
            return true
        }
        i += 1
    }
    return false
}

// Acceptance soundness: spec requires match to be exhaustive (Rust-style). A
// match is exhaustive iff it has a `_` wildcard, or every variant of the
// scrutinee's enum is covered by some arm. (This compiler's match is always
// over an enum, and has no `val x` catch-all arm, so those are the only cases.)
fn matchExhaustive(c: inout Comp, arms: Array[MatchArm]) -> Bool {
    mut val enumStart: U64 = 0
    mut val enumLen: U64 = 0
    mut val i: U64 = 0
    while i < arms.count {
        val a: MatchArm = arms[i]
        if a.isWildcard {
            return true
        }
        if enumLen == 0 {
            enumStart = a.enumStart
            enumLen = a.enumLen
        }
        i += 1
    }
    if enumLen == 0 {
        return true
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if armCovers(c: inout c, arms: arms, variantStart: v.nameStart, variantLen: v.nameLen) {
                } else {
                    return false
                }
                vi += 1
            }
            return true
        }
        ei += 1
    }
    return true
}

// Tag index of `Enum.Variant` (the variant's position in its enum declaration).
fn variantIndex(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> I64 {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    return vi as I64
                }
                vi += 1
            }
        }
        ei += 1
    }
    return 0
}

// ---- lightweight type recovery (for monomorphization + .bytes dispatch) ----

fn scalarInfo() -> TypeInfo {
    return <TypeInfo kind=0 nameStart=0 nameLen=0 />
}

fn typeInfoOfName(c: inout Comp, start: U64, len: U64, isArray: Bool) -> TypeInfo {
    if isArray {
        return <TypeInfo kind=3 nameStart=start nameLen=len />
    }
    if len == 0 {
        return scalarInfo()
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        return <TypeInfo kind=1 nameStart=start nameLen=len />
    }
    if isPrimType(c: inout c, start: start, len: len) {
        return scalarInfo()
    }
    return <TypeInfo kind=2 nameStart=start nameLen=len />
}

fn addLocal(c: inout Comp, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, isInout: Bool, isMut: Bool) {
    c.locals.append(<Local nameStart=nameStart nameLen=nameLen tyStart=tyStart tyLen=tyLen isArray=isArray isInout=isInout isMut=isMut />)
}

// Whether the binding named (start,len) — most recent in scope — may be assigned
// to: `mut val` locals and `inout` params. Unknown names default to assignable
// (the C compile catches genuinely undeclared identifiers).
fn localIsMutable(c: inout Comp, start: U64, len: U64) -> Bool {
    if isSelfRef(c: inout c, start: start, len: len) {
        // `self` is assignable only through an `inout fn` receiver.
        return c.curSelfInout
    }
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
            if lo.isMut {
                return true
            }
            return lo.isInout
        }
    }
    return true
}

// Whether `name` refers to an `inout` parameter of the current function (so its
// uses must be dereferenced as `(*name)`).
fn isSelfRef(c: inout Comp, start: U64, len: U64) -> Bool {
    if c.curHasRecv {
        return rangeEquals(bytes: c.bytes, start: start, len: len, kw: "self")
    }
    return false
}

fn isInoutLocal(c: inout Comp, start: U64, len: U64) -> Bool {
    if isSelfRef(c: inout c, start: start, len: len) {
        // `inout fn` receivers are pointers, so a bare `self` is `(*self)`.
        return c.curSelfInout
    }
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
            return lo.isInout
        }
    }
    return false
}

// Type of field `fieldName` declared in struct `structName` (else scalar).
fn fieldType(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if spansEqual(c: inout c, aStart: s.nameStart, aLen: s.nameLen, bStart: structStart, bLen: structLen) {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: fieldStart, bLen: fieldLen) {
                    return typeInfoOfName(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                }
                fi += 1
            }
        }
        si += 1
    }
    return scalarInfo()
}

// Recover an expression's type. Only the cases plewc.pw exercises on the base
// of a field/index/method are precise; everything else falls back to scalar.
fn exprType(c: inout Comp, id: U64) -> TypeInfo {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value } => { return scalarInfo() }
        Expr.Str { val start, val len } => { return <TypeInfo kind=1 nameStart=0 nameLen=0 /> }
        Expr.Ident { val start, val len } => {
            if isSelfRef(c: inout c, start: start, len: len) {
                return typeInfoOfName(c: inout c, start: c.curRecvStart, len: c.curRecvLen, isArray: false)
            }
            mut val i: U64 = c.locals.count
            while i > 0 {
                i -= 1
                val lo: Local = c.locals[i]
                if spansEqual(c: inout c, aStart: lo.nameStart, aLen: lo.nameLen, bStart: start, bLen: len) {
                    return typeInfoOfName(c: inout c, start: lo.tyStart, len: lo.tyLen, isArray: lo.isArray)
                }
            }
            return scalarInfo()
        }
        Expr.Unary { val op, val operand } => { return scalarInfo() }
        Expr.Binary { val op, val lhs, val rhs } => { return scalarInfo() }
        Expr.Call { val nameStart, val nameLen, val args } => {
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") {
                return <TypeInfo kind=1 nameStart=0 nameLen=0 />
            }
            mut val fi: U64 = 0
            while fi < c.funcs.count {
                val f: Func = c.funcs[fi]
                if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: nameStart, bLen: nameLen) {
                    if f.hasRet {
                        return typeInfoOfName(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
                    }
                    return scalarInfo()
                }
                fi += 1
            }
            return scalarInfo()
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 2 {
                return fieldType(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
            }
            return scalarInfo()
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen />
        }
        Expr.Array { val elems } => { return scalarInfo() }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 3 {
                return typeInfoOfName(c: inout c, start: bt.nameStart, len: bt.nameLen, isArray: false)
            }
            return scalarInfo()
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => {
            val rt: TypeInfo = exprType(c: inout c, id: recv)
            if rt.kind == 2 {
                val mi: I64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen)
                if mi < 0 {
                    return scalarInfo()
                }
                val mf: Func = c.funcs[mi as U64]
                if mf.hasRet {
                    return typeInfoOfName(c: inout c, start: mf.retStart, len: mf.retLen, isArray: mf.retIsArray)
                }
                return scalarInfo()
            }
            return scalarInfo()
        }
        Expr.Cast { val operand, val tyStart, val tyLen } => {
            return typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false)
        }
    }
    return scalarInfo()
}

// Register a match-bound field as an in-scope local with its declared type.
fn addBindLocal(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, bindStart: U64, bindLen: U64) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: bindStart, bLen: bindLen) {
                            addLocal(c: inout c, nameStart: bindStart, nameLen: bindLen, tyStart: f.tyStart, tyLen: f.tyLen, isArray: f.tyIsArray, isInout: false, isMut: false)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
}

// Emit the C type of a match-bound field (looked up in the enum declaration).
fn genBindType(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, bindStart: U64, bindLen: U64) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: enumStart, bLen: enumLen) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if spansEqual(c: inout c, aStart: v.nameStart, aLen: v.nameLen, bStart: variantStart, bLen: variantLen) {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if spansEqual(c: inout c, aStart: f.nameStart, aLen: f.nameLen, bStart: bindStart, bLen: bindLen) {
                            genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
    write(s: "long long")
}

fn binOpStr(op: I64) -> String {
    if op == 56 { return " + " }
    if op == 57 { return " - " }
    if op == 58 { return " * " }
    if op == 59 { return " / " }
    if op == 60 { return " % " }
    if op == 50 { return " == " }
    if op == 51 { return " != " }
    if op == 52 { return " < " }
    if op == 53 { return " <= " }
    if op == 54 { return " > " }
    if op == 55 { return " >= " }
    if op == 61 { return " && " }
    if op == 62 { return " || " }
    if op == 74 { return " & " }
    if op == 75 { return " | " }
    if op == 76 { return " ^ " }
    if op == 77 { return " << " }
    if op == 78 { return " >> " }
    return " ? "
}

fn unaryOpStr(op: I64) -> String {
    if op == 57 { return "-" }
    if op == 79 { return "~" }
    return "!"
}

// Decoded byte length of a string literal (span includes both quotes). Escapes
// like \n / \" / \\ count as one byte; plewc.pw uses only C-compatible escapes,
// so the content is emitted verbatim and just the length is computed here.
fn strDecodedLen(c: inout Comp, start: U64, len: U64) -> I64 {
    mut val n: I64 = 0
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if c.bytes[j] == 92 {
            j += 2
        } else {
            j += 1
        }
        n += 1
    }
    return n
}

fn assignOpStr(op: I64) -> String {
    if op == 49 { return " = " }
    if op == 67 { return " += " }
    if op == 68 { return " -= " }
    if op == 69 { return " *= " }
    if op == 70 { return " /= " }
    return " %= "
}

// The binary operator underlying a compound assignment (`+=` -> ` + `), used to
// expand `a[i] OP= v` into `set(a, i, get(a, i) OP v)`.
fn assignToBinStr(op: I64) -> String {
    if op == 67 { return " + " }
    if op == 68 { return " - " }
    if op == 69 { return " * " }
    if op == 70 { return " / " }
    return " % "
}

fn genExpr(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int { val value } => { writeInt(n: value) }
        Expr.Ident { val start, val len } => {
            if isInoutLocal(c: inout c, start: start, len: len) {
                write(s: "(*")
                writeSpan(c: inout c, start: start, len: len)
                write(s: ")")
            } else {
                writeSpan(c: inout c, start: start, len: len)
            }
        }
        Expr.Unary { val op, val operand } => {
            write(s: unaryOpStr(op: op))
            write(s: "(")
            genExpr(c: inout c, id: operand)
            write(s: ")")
        }
        Expr.Binary { val op, val lhs, val rhs } => {
            if isStringEq(c: inout c, op: op, lhs: lhs) {
                if op == 51 {
                    write(s: "(!PlewString_eq(")
                } else {
                    write(s: "PlewString_eq(")
                }
                genExpr(c: inout c, id: lhs)
                write(s: ", ")
                genExpr(c: inout c, id: rhs)
                if op == 51 {
                    write(s: "))")
                } else {
                    write(s: ")")
                }
            } else {
                if isEnumEq(c: inout c, op: op, lhs: lhs) {
                    emitEnumTagCmp(c: inout c, lhs: lhs, rhs: rhs, op: op, outer: true)
                } else {
                    if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
                    } else {
                        write(s: "(")
                        genExpr(c: inout c, id: lhs)
                        write(s: binOpStr(op: op))
                        genExpr(c: inout c, id: rhs)
                        write(s: ")")
                    }
                }
            }
        }
        Expr.Call { val nameStart, val nameLen, val args } => {
            // compileError(msg): the compiler's own diagnostic primitive —
            // prints to stderr and exits non-zero. Compiler-internal (used by
            // the acceptance-soundness checks below), so it is ambient (not
            // import-gated); it is not a user-facing language construct.
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "compileError") {
                write(s: "plew_compile_error(")
                genExpr(c: inout c, id: args[0].expr)
                write(s: ")")
                return
            }
            // compileErrorAt(line, msg): like compileError but with a source line.
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "compileErrorAt") {
                write(s: "plew_compile_error_at(")
                genExpr(c: inout c, id: args[0].expr)
                write(s: ", ")
                genExpr(c: inout c, id: args[1].expr)
                write(s: ")")
                return
            }
            // I/O builtins -> C runtime.
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") {
                if c.impWrite {
                    write(s: "plew_write(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "write is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "writeByte") {
                if c.impWriteByte {
                    write(s: "putchar((int)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "writeByte is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                if c.impReadStdin {
                    write(s: "plew_read_stdin()")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readStdin is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") {
                if c.impReadFile {
                    write(s: "plew_read_file(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readFile is not ambient; import it from @Std/Io")
                }
                return
            }
            // readFileBytes(path: Array[U8]) -> String. Bundled under the same
            // `readFile` import (an internal helper for multi-file `part`).
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") {
                if c.impReadFile {
                    write(s: "plew_read_file_bytes(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readFile is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") {
                if c.impArgCount {
                    write(s: "plew_arg_count()")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argCount is not ambient; import it from @Std/Process")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") {
                if c.impArgAt {
                    write(s: "plew_arg_at((long long)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argAt is not ambient; import it from @Std/Process")
                }
                return
            }
            if callLabelsOk(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args) {
            } else {
                // label missing / wrong / out of order -> undeclared identifier
                // so the C compile fails loudly (spec: labels are required).
                compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argument labels do not match the function parameters")
                return
            }
            writeSpan(c: inout c, start: nameStart, len: nameLen)
            write(s: "(")
            mut val i: U64 = 0
            while i < args.count {
                if i > 0 {
                    write(s: ", ")
                }
                val ar: Arg = args[i]
                if ar.isInout {
                    write(s: "&(")
                    genExpr(c: inout c, id: ar.expr)
                    write(s: ")")
                } else {
                    genExpr(c: inout c, id: ar.expr)
                }
                i += 1
            }
            write(s: ")")
        }
        Expr.Field { val base, val nameStart, val nameLen } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 1 {
                // String.bytes: view the string buffer as an Array[U8] (shared).
                write(s: "({ PlewString __s = ")
                genExpr(c: inout c, id: base)
                write(s: "; (PlewArray_U8){(unsigned char*)__s.data, __s.len, __s.len}; })")
                return
            }
            if bt.kind == 3 {
                // arr.count -> length
                write(s: "(long long)((")
                genExpr(c: inout c, id: base)
                write(s: ").len)")
                return
            }
            genExpr(c: inout c, id: base)
            write(s: ".")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
        }
        Expr.Str { val start, val len } => {
            write(s: "(PlewString){\"")
            writeSpan(c: inout c, start: start + 1, len: len - 2)
            write(s: "\", ")
            writeInt(n: strDecodedLen(c: inout c, start: start, len: len))
            write(s: "}")
        }
        Expr.Index { val base, val index } => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            write(s: "PlewArray_")
            writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
            write(s: "_get(")
            genExpr(c: inout c, id: base)
            write(s: ", (long long)(")
            genExpr(c: inout c, id: index)
            write(s: "))")
        }
        Expr.Method { val recv, val nameStart, val nameLen, val args } => {
            val bt: TypeInfo = exprType(c: inout c, id: recv)
            if bt.kind == 3 {
                // array builtin: `.append(v)` -> PlewArray_E_push(&recv, v).
                write(s: "PlewArray_")
                writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                write(s: "_push(&(")
                genExpr(c: inout c, id: recv)
                write(s: "), ")
                genExpr(c: inout c, id: args[0].expr)
                write(s: ")")
            } else {
                // user method on a named type: `recv.m(args)` -> Recv_m(self, args)
                // (self by value, or &recv for an `inout fn` receiver).
                val mi: I64 = findMethod(c: inout c, recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: nameStart, nameLen: nameLen)
                if mi < 0 {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "no such method on this type")
                    return
                }
                val mf: Func = c.funcs[mi as U64]
                if paramsLabelsOk(c: inout c, params: mf.params, args: args) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argument labels do not match the method parameters")
                    return
                }
                writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                write(s: "_")
                writeSpan(c: inout c, start: nameStart, len: nameLen)
                write(s: "(")
                if mf.selfInout {
                    write(s: "&(")
                    genExpr(c: inout c, id: recv)
                    write(s: ")")
                } else {
                    genExpr(c: inout c, id: recv)
                }
                mut val i: U64 = 0
                while i < args.count {
                    write(s: ", ")
                    val ar: Arg = args[i]
                    if ar.isInout {
                        write(s: "&(")
                        genExpr(c: inout c, id: ar.expr)
                        write(s: ")")
                    } else {
                        genExpr(c: inout c, id: ar.expr)
                    }
                    i += 1
                }
                write(s: ")")
            }
        }
        Expr.Array { val elems } => {
            // Array literals appear only in typed positions (let init / JSX
            // field / array assignment), handled by genArrayLiteral with the
            // declared element type. A bare literal here has no element context.
            write(s: "0")
        }
        Expr.Cast { val operand, val tyStart, val tyLen } => {
            write(s: "((")
            genCElem(c: inout c, start: tyStart, len: tyLen)
            write(s: ")(")
            genExpr(c: inout c, id: operand)
            write(s: "))")
        }
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            if isEnum {
                write(s: "(")
                writeSpan(c: inout c, start: typeStart, len: typeLen)
                write(s: "){.tag = ")
                writeInt(n: variantIndex(c: inout c, enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen))
                if fields.count > 0 {
                    write(s: ", .data.")
                    writeSpan(c: inout c, start: variantStart, len: variantLen)
                    write(s: " = {")
                    mut val i: U64 = 0
                    while i < fields.count {
                        if i > 0 {
                            write(s: ", ")
                        }
                        val mf: MakeField = fields[i]
                        write(s: ".")
                        writeSpan(c: inout c, start: mf.nameStart, len: mf.nameLen)
                        write(s: " = ")
                        genExpr(c: inout c, id: mf.value)
                        i += 1
                    }
                    write(s: "}")
                }
                write(s: "}")
            } else {
                write(s: "(")
                genCType(c: inout c, start: typeStart, len: typeLen)
                write(s: "){")
                mut val i: U64 = 0
                while i < fields.count {
                    if i > 0 {
                        write(s: ", ")
                    }
                    val mf: MakeField = fields[i]
                    write(s: ".")
                    writeSpan(c: inout c, start: mf.nameStart, len: mf.nameLen)
                    write(s: " = ")
                    val ft: TypeInfo = fieldType(c: inout c, structStart: typeStart, structLen: typeLen, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
                    if ft.kind == 3 {
                        genArrayLiteral(c: inout c, exprId: mf.value, elemStart: ft.nameStart, elemLen: ft.nameLen)
                    } else {
                        genExpr(c: inout c, id: mf.value)
                    }
                    i += 1
                }
                write(s: "}")
            }
        }
    }
}

// Emit an array literal given the element type from context (declared type of
// the let / field it initializes). Empty -> _new(); non-empty -> a statement
// expression that news then pushes. Falls back to genExpr for non-literals.
fn genArrayLiteral(c: inout Comp, exprId: U64, elemStart: U64, elemLen: U64) {
    val e: Expr = c.exprs[exprId]
    match e {
        Expr.Array { val elems } => {
            if elems.count == 0 {
                write(s: "PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: "_new()")
            } else {
                write(s: "({ PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: " __a = PlewArray_")
                writeSpan(c: inout c, start: elemStart, len: elemLen)
                write(s: "_new(); ")
                mut val i: U64 = 0
                while i < elems.count {
                    write(s: "PlewArray_")
                    writeSpan(c: inout c, start: elemStart, len: elemLen)
                    write(s: "_push(&__a, ")
                    genExpr(c: inout c, id: elems[i])
                    write(s: "); ")
                    i += 1
                }
                write(s: "__a; })")
            }
        }
        _ => { genExpr(c: inout c, id: exprId) }
    }
}

// Whether `lhs OP rhs` is a String `==` / `!=` (which lowers to PlewString_eq
// rather than a C struct comparison).
fn isStringEq(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op == 50 {
    } else {
        if op == 51 {
        } else {
            return false
        }
    }
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    return lt.kind == 1
}

fn isEnumName(c: inout Comp, start: U64, len: U64) -> Bool {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
            return true
        }
        ei += 1
    }
    return false
}

// Whether every variant of the named enum is nullary (no payload). Tag-only
// `==` is exact for such enums; payload-bearing enums need structural Eq.
fn isAllNullary(c: inout Comp, start: U64, len: U64) -> Bool {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if v.fields.count > 0 {
                    return false
                }
                vi += 1
            }
            return true
        }
        ei += 1
    }
    return false
}

// Whether `lhs OP rhs` is an enum `==` / `!=`. Provisional: lowered to a tag
// (variant) comparison, NOT a payload-aware structural Eq. For all-nullary
// enums this coincides with structural equality; full Eq comes with @[Eq].
fn isEnumEq(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op == 50 {
    } else {
        if op == 51 {
        } else {
            return false
        }
    }
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind == 2 {
        return isEnumName(c: inout c, start: lt.nameStart, len: lt.nameLen)
    }
    return false
}

// Acceptance soundness: comparison operators (== != < <= > >=) are trait-backed
// (Eq/Ord). The compiler hardcodes them for numbers, String `==`/`!=`, and
// all-nullary enum `==`; applied to a struct or array there is no Eq/Ord, so it
// must be a compile error rather than broken C. (Reached only after the
// String-eq and enum-eq paths have been ruled out.)
fn compareNeedsTrait(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op < 50 {
        return false
    }
    if op > 55 {
        return false
    }
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind == 3 {
        return true
    }
    if lt.kind == 2 {
        if isEnumName(c: inout c, start: lt.nameStart, len: lt.nameLen) {
            return false
        }
        return true
    }
    return false
}

// Emit one operand of an enum tag comparison: a variant construction becomes
// its tag index literal; any other enum value becomes `(expr).tag`.
fn emitEnumOperand(c: inout Comp, id: U64, enStart: U64, enLen: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Make { val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val fields } => {
            if isEnum {
                writeInt(n: variantIndex(c: inout c, enumStart: enStart, enumLen: enLen, variantStart: variantStart, variantLen: variantLen))
                return
            }
        }
        _ => {}
    }
    write(s: "(")
    genExpr(c: inout c, id: id)
    write(s: ").tag")
}

// Emit an enum `==`/`!=` as a tag comparison. Resolves the enum from whichever
// operand is a value of that enum. PROVISIONAL: only all-nullary enums are
// allowed; a payload-bearing enum emits an undeclared identifier so the C
// compile fails loudly (structural Eq awaits @[Eq] — never compare blind).
fn emitEnumTagCmp(c: inout Comp, lhs: U64, rhs: U64, op: I64, outer: Bool) {
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    mut val enStart: U64 = 0
    mut val enLen: U64 = 0
    if lt.kind == 2 {
        enStart = lt.nameStart
        enLen = lt.nameLen
    } else {
        val rt: TypeInfo = exprType(c: inout c, id: rhs)
        enStart = rt.nameStart
        enLen = rt.nameLen
    }
    if isAllNullary(c: inout c, start: enStart, len: enLen) {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "enum == needs structural Eq for payload variants (only all-nullary enums compare by tag)")
        return
    }
    if outer {
        write(s: "(")
    }
    emitEnumOperand(c: inout c, id: lhs, enStart: enStart, enLen: enLen)
    if op == 51 {
        write(s: " != ")
    } else {
        write(s: " == ")
    }
    emitEnumOperand(c: inout c, id: rhs, enStart: enStart, enLen: enLen)
    if outer {
        write(s: ")")
    }
}

// Emit an expression in condition position. A top-level binary drops its outer
// parens (the `if (...)` / `while (...)` already supplies them), which avoids
// the `-Wparentheses-equality` warning on `if ((a == b))`. String/enum equality
// have their own lowerings handled here too.
fn genCond(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Binary { val op, val lhs, val rhs } => {
            if isStringEq(c: inout c, op: op, lhs: lhs) {
                genExpr(c: inout c, id: id)
            } else {
                if isEnumEq(c: inout c, op: op, lhs: lhs) {
                    emitEnumTagCmp(c: inout c, lhs: lhs, rhs: rhs, op: op, outer: false)
                } else {
                    if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
                    } else {
                        genExpr(c: inout c, id: lhs)
                        write(s: binOpStr(op: op))
                        genExpr(c: inout c, id: rhs)
                    }
                }
            }
        }
        _ => { genExpr(c: inout c, id: id) }
    }
}

fn genStmt(c: inout Comp, id: U64) {
    val s: Stmt = c.stmts[id]
    match s {
        Stmt.Let { val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val init } => {
            write(s: "    ")
            genCTypeRef(c: inout c, start: tyStart, len: tyLen, isArray: tyIsArray)
            write(s: " ")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
            write(s: " = ")
            if tyIsArray {
                genArrayLiteral(c: inout c, exprId: init, elemStart: tyStart, elemLen: tyLen)
            } else {
                genExpr(c: inout c, id: init)
            }
            write(s: ";\n")
            addLocal(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, isInout: false, isMut: mutable)
        }
        Stmt.Assign { val op, val target, val value } => {
            val te: Expr = c.exprs[target]
            match te {
                Expr.Index { val base, val index } => {
                    // a[i] = v / a[i] OP= v -> bounds-checked PlewArray_E_set
                    val bt: TypeInfo = exprType(c: inout c, id: base)
                    write(s: "    PlewArray_")
                    writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                    write(s: "_set(&(")
                    genExpr(c: inout c, id: base)
                    write(s: "), (long long)(")
                    genExpr(c: inout c, id: index)
                    write(s: "), ")
                    if op == 49 {
                        genExpr(c: inout c, id: value)
                    } else {
                        write(s: "PlewArray_")
                        writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                        write(s: "_get(")
                        genExpr(c: inout c, id: base)
                        write(s: ", (long long)(")
                        genExpr(c: inout c, id: index)
                        write(s: "))")
                        write(s: assignToBinStr(op: op))
                        genExpr(c: inout c, id: value)
                    }
                    write(s: ");\n")
                }
                _ => {
                    // Acceptance soundness: assigning to a plain `val` binding is
                    // a spec violation (`val` is immutable; only `mut val` locals
                    // and `inout` params are assignable). Field/index targets have
                    // their own (composite) mutability rules, not checked here.
                    val tk: Expr = c.exprs[target]
                    match tk {
                        Expr.Ident { val start, val len } => {
                            if localIsMutable(c: inout c, start: start, len: len) {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: start), msg: "cannot assign to an immutable binding; declare it with `mut val`")
                                return
                            }
                        }
                        _ => {}
                    }
                    write(s: "    ")
                    genExpr(c: inout c, id: target)
                    write(s: assignOpStr(op: op))
                    val tt: TypeInfo = exprType(c: inout c, id: target)
                    if tt.kind == 3 {
                        genArrayLiteral(c: inout c, exprId: value, elemStart: tt.nameStart, elemLen: tt.nameLen)
                    } else {
                        genExpr(c: inout c, id: value)
                    }
                    write(s: ";\n")
                }
            }
        }
        Stmt.Print { val expr, val offset } => {
            if c.impPrint {
                write(s: "    printf(\"%lld\\n\", (long long)(")
                genExpr(c: inout c, id: expr)
                write(s: "));\n")
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "print is not ambient; import it from @Std/Io")
            }
        }
        Stmt.ExprStmt { val expr } => {
            write(s: "    ")
            genExpr(c: inout c, id: expr)
            write(s: ";\n")
        }
        Stmt.Return { val value, val hasValue } => {
            if c.curIsMain {
                write(s: "    return 0;\n")
            } else {
                if c.curRetVoid {
                    write(s: "    return;\n")
                } else {
                    write(s: "    return ")
                    if hasValue {
                        genExpr(c: inout c, id: value)
                    } else {
                        write(s: "0")
                    }
                    write(s: ";\n")
                }
            }
        }
        Stmt.If { val cond, val thenBlk, val elseBlk, val hasElse } => {
            write(s: "    if (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            genBlock(c: inout c, id: thenBlk)
            write(s: "    }\n")
            if hasElse {
                write(s: "    else {\n")
                genBlock(c: inout c, id: elseBlk)
                write(s: "    }\n")
            }
        }
        Stmt.While { val cond, val body } => {
            write(s: "    while (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            genBlock(c: inout c, id: body)
            write(s: "    }\n")
        }
        Stmt.For { val varStart, val varLen, val isRange, val inclusive, val iter, val rangeHi, val body } => {
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            if isRange {
                // for (long long var = lo; var (< | <=) __fe; var++) { body }
                write(s: "    {\n")
                write(s: "    long long __fe")
                writeInt(n: t as I64)
                write(s: " = ")
                genExpr(c: inout c, id: rangeHi)
                write(s: ";\n")
                write(s: "    for (long long ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: " = ")
                genExpr(c: inout c, id: iter)
                write(s: "; ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                if inclusive {
                    write(s: " <= __fe")
                } else {
                    write(s: " < __fe")
                }
                writeInt(n: t as I64)
                write(s: "; ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: "++) {\n")
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: 0, tyLen: 0, isArray: false, isInout: false, isMut: false)
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            } else {
                // walk an array by index, binding `var` to each element
                val et: TypeInfo = exprType(c: inout c, id: iter)
                write(s: "    {\n")
                write(s: "    ")
                wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                write(s: " __fa")
                writeInt(n: t as I64)
                write(s: " = ")
                genExpr(c: inout c, id: iter)
                write(s: ";\n")
                write(s: "    for (long long __fi")
                writeInt(n: t as I64)
                write(s: " = 0; __fi")
                writeInt(n: t as I64)
                write(s: " < __fa")
                writeInt(n: t as I64)
                write(s: ".len; __fi")
                writeInt(n: t as I64)
                write(s: "++) {\n")
                write(s: "        ")
                genCElem(c: inout c, start: et.nameStart, len: et.nameLen)
                write(s: " ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: " = ")
                wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                write(s: "_get(__fa")
                writeInt(n: t as I64)
                write(s: ", __fi")
                writeInt(n: t as I64)
                write(s: ");\n")
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, isInout: false, isMut: false)
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            }
        }
        Stmt.Panic { val msg, val offset } => {
            // diverging: plew_panic is noreturn (writes the message + exit(1)).
            write(s: "    plew_panic(")
            genExpr(c: inout c, id: msg)
            write(s: ");\n")
        }
        Stmt.Break => {
            write(s: "    break;\n")
        }
        Stmt.Continue => {
            write(s: "    continue;\n")
        }
        Stmt.Match { val scrut, val arms } => {
            if matchExhaustive(c: inout c, arms: arms) {
            } else {
                // non-exhaustive match -> undeclared identifier so the C compile
                // fails loudly (spec: match must be exhaustive).
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: scrut)), msg: "match must be exhaustive: cover all variants or add a wildcard")
                return
            }
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            // enum type for the scrutinee temp = the enum named by the first
            // non-wildcard arm's pattern.
            mut val enumStart: U64 = 0
            mut val enumLen: U64 = 0
            mut val hasWildcard: Bool = false
            mut val q: U64 = 0
            while q < arms.count {
                val aq: MatchArm = arms[q]
                if aq.isWildcard {
                    hasWildcard = true
                } else {
                    if enumLen == 0 {
                        enumStart = aq.enumStart
                        enumLen = aq.enumLen
                    }
                }
                q += 1
            }
            write(s: "    {\n")
            write(s: "    ")
            writeSpan(c: inout c, start: enumStart, len: enumLen)
            write(s: " _m")
            writeInt(n: t as I64)
            write(s: " = ")
            genExpr(c: inout c, id: scrut)
            write(s: ";\n")
            mut val i: U64 = 0
            mut val firstCond: Bool = true
            while i < arms.count {
                val a: MatchArm = arms[i]
                if a.isWildcard {
                    write(s: "    else {\n")
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                } else {
                    if firstCond {
                        write(s: "    if (_m")
                        firstCond = false
                    } else {
                        write(s: "    else if (_m")
                    }
                    writeInt(n: t as I64)
                    write(s: ".tag == ")
                    writeInt(n: variantIndex(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen))
                    write(s: ") {\n")
                    val binds: Array[Bind] = a.binds
                    mut val bi: U64 = 0
                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        write(s: "        ")
                        genBindType(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
                        write(s: " ")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: " = _m")
                        writeInt(n: t as I64)
                        write(s: ".data.")
                        writeSpan(c: inout c, start: a.variantStart, len: a.variantLen)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: ";\n")
                        // mark used so an unreferenced bind doesn't warn
                        write(s: "        (void)")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: ";\n")
                        addBindLocal(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
                        bi += 1
                    }
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                }
                i += 1
            }
            // exhaustive match without a wildcard: the final fall-through is
            // unreachable (so a value-returning function does not "fall off").
            if hasWildcard {
            } else {
                write(s: "    else { __builtin_unreachable(); }\n")
            }
            write(s: "    }\n")
        }
    }
}

fn genBlock(c: inout Comp, id: U64) {
    val b: Block = c.blocks[id]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        genStmt(c: inout c, id: stmts[i])
        i += 1
    }
}

fn nameIsMain(c: inout Comp, f: Func) -> Bool {
    if f.hasRecv {
        return false
    }
    return rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: "main")
}

// Emit a struct body `struct Name { <ctype> field; ... };`. Forward typedefs
// are emitted separately so structs can reference each other by name; by-value
// struct fields still require their definition to appear earlier (v3 relies on
// source order being dependency order).
fn genStructDef(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    write(s: "struct ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " {\n")
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        val f: FieldDef = fields[i]
        write(s: "    ")
        genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
        write(s: " ")
        writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
        write(s: ";\n")
        i += 1
    }
    write(s: "};\n")
}

// Emit a C function signature (no trailing `;` or `{`). `main` is special:
// `int main(void)`. The return type and each parameter type come from the
// declared Plew types via genCType (scalars -> long long, named types echoed).
fn genSignature(c: inout Comp, f: Func) {
    if nameIsMain(c: inout c, f: f) {
        write(s: "int main(int argc, char** argv)")
        return
    }
    if f.hasRet {
        genCTypeRef(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
        write(s: " ")
    } else {
        write(s: "void ")
    }
    // method: mangle to `Recv_name` with a leading `self` parameter.
    if f.hasRecv {
        writeSpan(c: inout c, start: f.recvStart, len: f.recvLen)
        write(s: "_")
    }
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
    write(s: "(")
    val params: Array[Param] = f.params
    if f.hasRecv {
        genCTypeRef(c: inout c, start: f.recvStart, len: f.recvLen, isArray: false)
        if f.selfInout {
            write(s: "*")
        }
        write(s: " self")
        mut val i: U64 = 0
        while i < params.count {
            write(s: ", ")
            val p: Param = params[i]
            genCTypeRef(c: inout c, start: p.tyStart, len: p.tyLen, isArray: p.tyIsArray)
            if p.isInout {
                write(s: "*")
            }
            write(s: " ")
            writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
            i += 1
        }
    } else {
        if params.count == 0 {
            write(s: "void")
        } else {
            mut val i: U64 = 0
            while i < params.count {
                if i > 0 {
                    write(s: ", ")
                }
                val p: Param = params[i]
                genCTypeRef(c: inout c, start: p.tyStart, len: p.tyLen, isArray: p.tyIsArray)
                if p.isInout {
                    write(s: "*")
                }
                write(s: " ")
                writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
                i += 1
            }
        }
    }
    write(s: ")")
}

fn genFunc(c: inout Comp, fi: U64) {
    val f: Func = c.funcs[fi]
    val isMain: Bool = nameIsMain(c: inout c, f: f)
    c.curIsMain = isMain
    if f.hasRet {
        c.curRetVoid = false
    } else {
        c.curRetVoid = true
    }
    // expose the method receiver so a bare `self` in the body resolves (and
    // lowers to `(*self)` for `inout fn`).
    c.curHasRecv = f.hasRecv
    c.curRecvStart = f.recvStart
    c.curRecvLen = f.recvLen
    c.curSelfInout = f.selfInout
    // fresh local scope for this function: parameters are the initial bindings
    c.locals = []
    val params: Array[Param] = f.params
    mut val pi: U64 = 0
    while pi < params.count {
        val p: Param = params[pi]
        addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, isInout: p.isInout, isMut: false)
        pi += 1
    }
    genSignature(c: inout c, f: f)
    write(s: " {\n")
    if isMain {
        write(s: "    plew_argc = argc; plew_argv = argv;\n")
    }
    genBlock(c: inout c, id: f.body)
    if isMain {
        write(s: "    return 0;\n")
    }
    write(s: "}\n")
}

// Emit an enum as a tagged union: `struct E { long long tag; union { struct
// {...} V; ... } data; };`. Nullary variants get a dummy member so the inner
// struct is never empty.
fn genEnumDef(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    write(s: "struct ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " {\n")
    write(s: "    long long tag;\n")
    write(s: "    union {\n")
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val v: Variant = vars[vi]
        write(s: "        struct {")
        val fs: Array[FieldDef] = v.fields
        if fs.count == 0 {
            write(s: " char _u; ")
        } else {
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                write(s: " ")
                genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                write(s: " ")
                writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
                write(s: ";")
                fi += 1
            }
            write(s: " ")
        }
        write(s: "} ")
        writeSpan(c: inout c, start: v.nameStart, len: v.nameLen)
        write(s: ";\n")
        vi += 1
    }
    write(s: "    } data;\n")
    write(s: "};\n")
}

// Write the array C name `PlewArray_<elem>`.
fn wPA(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "PlewArray_")
    writeSpan(c: inout c, start: elemStart, len: elemLen)
}

// `typedef struct { ET* data; long long len; long long cap; } PlewArray_E;`
fn genArrayTypedef(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "typedef struct { ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* data; long long len; long long cap; } ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: ";\n")
}

// Monomorphized array runtime for one element type (new / get / set / push).
// Old buffers leak on growth (stage0/stage1 never free — throwaway model).
fn genArrayRuntimeFns(c: inout Comp, elemStart: U64, elemLen: U64) {
    write(s: "__attribute__((unused)) static ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_new(void) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a; a.data = 0; a.len = 0; a.cap = 0; return a; }\n")

    write(s: "__attribute__((unused)) static ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_get(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a, long long i) { if (i < 0 || i >= a.len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")

    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_set(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, long long i, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (i < 0 || i >= a->len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } a->data[i] = v; }\n")

    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_push(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (a->len >= a->cap) { long long nc = a->cap < 4 ? 4 : a->cap * 2; ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* nd = (")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "*)malloc(sizeof(")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: ") * nc); for (long long i = 0; i < a->len; i++) nd[i] = a->data[i]; a->data = nd; a->cap = nc; } a->data[a->len] = v; a->len++; }\n")
}

fn isU8Elem(c: inout Comp, elemStart: U64, elemLen: U64) -> Bool {
    return rangeEquals(bytes: c.bytes, start: elemStart, len: elemLen, kw: "U8")
}

// PlewArray_U8 is always available (String.bytes yields it) and is emitted with
// literal text so it needs no source span for "U8".
fn genU8ArrayTypedef() {
    write(s: "typedef struct { unsigned char* data; long long len; long long cap; } PlewArray_U8;\n")
}

fn genU8ArrayRuntime() {
    write(s: "__attribute__((unused)) static PlewArray_U8 PlewArray_U8_new(void) { PlewArray_U8 a; a.data = 0; a.len = 0; a.cap = 0; return a; }\n")
    write(s: "__attribute__((unused)) static unsigned char PlewArray_U8_get(PlewArray_U8 a, long long i) { if (i < 0 || i >= a.len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")
    write(s: "__attribute__((unused)) static void PlewArray_U8_set(PlewArray_U8* a, long long i, unsigned char v) { if (i < 0 || i >= a->len) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } a->data[i] = v; }\n")
    write(s: "__attribute__((unused)) static void PlewArray_U8_push(PlewArray_U8* a, unsigned char v) { if (a->len >= a->cap) { long long nc = a->cap < 4 ? 4 : a->cap * 2; unsigned char* nd = (unsigned char*)malloc(sizeof(unsigned char) * nc); for (long long i = 0; i < a->len; i++) nd[i] = a->data[i]; a->data = nd; a->cap = nc; } a->data[a->len] = v; a->len++; }\n")
}

