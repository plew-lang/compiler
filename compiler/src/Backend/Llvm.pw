                st.terminated = true
            } else {
                compileErrorAt(line: 0, msg: "LLVM backend: `break` outside a loop")
            }
        }
        Stmt.Continue(offset: _) => {
            if st.loopDepth > 0U64 {
                LLVMBuildBr(st.b, st.loopContBB[st.loopDepth - 1U64])
                st.terminated = true
            } else {
                compileErrorAt(line: 0, msg: "LLVM backend: `continue` outside a loop")
            }
        }
        Stmt.Match(val scrut, val arms) => {
            genLlvmMatch(c: inout c, st: inout st, scrut: scrut, arms: arms)
        }
        Stmt.Give(val value) => {
            // yield the enclosing value-position block's result (IfExpr reads it).
            st.giveValue = genLlvmExpr(c: inout c, st: inout st, id: value)
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            if isStruct {
                genLlvmForArrayStruct(c: inout c, st: inout st, patStart: patStart, patLen: patLen, iter: iter, binds: binds, body: body)
            } else {
                if isRange {
                    genLlvmForRange(c: inout c, st: inout st, varStart: varStart, varLen: varLen, varTyStart: varTyStart, varTyLen: varTyLen, inclusive: inclusive, lo: iter, hi: rangeHi, body: body)
                } else {
                    genLlvmForArray(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, body: body)
                }
            }
        }
        _ => {
            compileErrorAt(line: 0, msg: "LLVM backend: statement form not yet supported")
        }
    }
}

// Lower `match scrut { Pat => block, ... }` on a registered enum: store the
// scrutinee, switch on its tag through a chain of compare/branch blocks, and in
// each arm bind the variant's payload fields (extracted from the payload area)
// before emitting its body. Exhaustiveness is guaranteed by the front-end; a
// wildcard `_` arm is the catch-all.
fn genLlvmMatch(c: inout Comp, st: inout LlvmCtx, scrut: U64, arms: Array[MatchArm]) {
    val sv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: scrut)
    val sty: LLVMTypeRef = LLVMTypeOf(sv)
    // a struct destructuring match `match s { S { val x } => … }` is irrefutable
    // (one arm, no tag): store the scrutinee, bind its fields, emit the body.
    if arms.count > 0U64 {
        if arms[0].isStruct {
            val ssidx: U64 = exprStructIdx(c: inout c, st: inout st, id: scrut)
            val savedSP: Array[Bind] = c.curTypeParams
            val savedSA: Array[U64] = c.curTypeArgs
            val didSetS: Bool = setStructEnv(c: inout c, st: inout st, ref: exprTypeRef(c: inout c, st: inout st, id: scrut))
            val sslot0: LLVMValueRef = entryAlloca(st: inout st, ty: sty)
            LLVMBuildStore(st.b, sv, sslot0)
            val mark0: U64 = st.nLocals
            bindStructPattern(c: inout c, st: inout st, sidx: ssidx, binds: arms[0].binds, scrutTy: sty, scrutSlot: sslot0)
            genLlvmBlock(c: inout c, st: inout st, id: arms[0].body)
            st.nLocals = mark0
            if didSetS {
                c.curTypeParams = savedSP
                c.curTypeArgs = savedSA
            }
            return
        }
    }
    // The scrutinee's enum instance ref. The enum env (for payload-type resolution)
    // is set ONLY around bindMatchPayload — NOT for the arm bodies, which must keep
    // the outer (e.g. monomorphized-method) env so a body's `self.f` / `self.inner`
    // still grounds. Saved here so each arm can set/restore around its bind.
    val scrutRef: U64 = exprTypeRef(c: inout c, st: inout st, id: scrut)
    val savedMP: Array[Bind] = c.curTypeParams
    val savedMA: Array[U64] = c.curTypeArgs
    // the enum: from the first non-wildcard, non-struct arm.
    mut val eid: U64 = c.enums.count
    mut val ai0: U64 = 0
    while ai0 < arms.count {
        if arms[ai0].isWildcard {
        } else {
            if arms[ai0].isStruct {
            } else {
                if eid == c.enums.count {
                    eid = enumIdxByName(c: inout c, start: arms[ai0].enumStart, len: arms[ai0].enumLen)
                }
            }
        }
        ai0 += 1
    }
    if eid < c.enums.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: match is only supported on a registered enum (so far)")
        return
    }
    // store the scrutinee so payload fields can be read back as a variant struct.
    val sslot: LLVMValueRef = entryAlloca(st: inout st, ty: sty)
    LLVMBuildStore(st.b, sv, sslot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, sty, sslot, 0U64, anon()), anon())
    val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "match.end"))
    // the tag-test chain lives in `checkBB`; each arm body lives in its own block.
    // Re-position at checkBB before every compare so emitting an arm body (which
    // moves the builder) doesn't append the next compare after a ret.
    mut val checkBB: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    mut val lastWasWildcard: Bool = false
    mut val anyFallthrough: Bool = false
    mut val ai: U64 = 0
    while ai < arms.count {
        val arm: MatchArm = arms[ai]
        val armBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "arm"))
        LLVMPositionBuilderAtEnd(st.b, checkBB)
        if arm.isWildcard {
            LLVMBuildBr(st.b, armBB)
            lastWasWildcard = true
        } else {
            val vi: U64 = variantIndex(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
            val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "match.next"))
            val eq: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, vi, 0I32), anon())
            LLVMBuildCondBr(st.b, eq, armBB, nextBB)
            checkBB = nextBB
            lastWasWildcard = false
        }
        // emit the arm body in armBB, with payload binds in a fresh scope.
        val savedBB: U64 = st.nLocals
        LLVMPositionBuilderAtEnd(st.b, armBB)
        st.terminated = false
        if arm.isWildcard {
        } else {
            // bind the payload under the enum env, then restore the outer env so the
            // arm body grounds against the enclosing method/function, not the enum.
            val didB: Bool = setEnumEnv(c: inout c, st: inout st, ref: scrutRef)
            bindMatchPayload(c: inout c, st: inout st, eid: eid, arm: arm, scrutTy: sty, scrutSlot: sslot)
            if didB {
                c.curTypeParams = savedMP
                c.curTypeArgs = savedMA
            }
        }
        genLlvmBlock(c: inout c, st: inout st, id: arm.body)
        st.nLocals = savedBB
        if st.terminated {
        } else {
            LLVMBuildBr(st.b, contBB)
            anyFallthrough = true
        }
        ai += 1
    }
    // close the dangling final check block (exhaustive, so unreachable) unless a
    // wildcard already terminated it.
    if lastWasWildcard {
    } else {
        LLVMPositionBuilderAtEnd(st.b, checkBB)
        LLVMBuildUnreachable(st.b)
    }
    // the continuation is reachable only if some arm fell through.
    LLVMPositionBuilderAtEnd(st.b, contBB)
    if anyFallthrough {
        st.terminated = false
    } else {
        LLVMBuildUnreachable(st.b)
        st.terminated = true
    }
}

// Bind a match arm's payload fields as locals: read the variant payload struct
// back from the scrutinee's payload area and extractvalue each bound field.
fn bindMatchPayload(c: inout Comp, st: inout LlvmCtx, eid: U64, arm: MatchArm, scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
    if arm.binds.count == 0U64 {
        return
    }
    val vi: U64 = variantIndex(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
    val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eid, vi: vi)
    val payload: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, scrutTy, scrutSlot, 1U64, anon()), anon())
    val fs: Array[FieldDef] = c.enums[eid].variants[vi].fields
    mut val bi: U64 = 0
    while bi < arm.binds.count {
        val b: Bind = arm.binds[bi]
        // resolve which variant field this bind reads (by field name = b.fieldStart).
        mut val fidx: U64 = fs.count
        mut val fj: U64 = 0
        while fj < fs.count {
            if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                fidx = fj
                fj = fs.count
            } else {
                fj += 1
            }
        }
        if fidx < fs.count {
            val fd: FieldDef = fs[fidx]
            // an array-typed payload field (declared `Array[E]` or a type param that
            // grounds to one): the bound local is the {ptr,i64} array value, tracked
            // as an array so `v[i]` / `v.count` work in the arm body.
            val elemRef: U64 = arrayFieldElemRef(c: inout c, f: fd)
            mut val pty: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fd.tyStart, tyLen: fd.tyLen)
            mut val isArrF: Bool = false
            mut val elemTyF: LLVMTypeRef = st.i64ty
            mut val elemKindF: U64 = 0U64
            if elemRef != 0U64 {
                pty = st.arrayTy
                isArrF = true
                elemTyF = llvmTypeOfRef(c: inout c, st: inout st, ref: elemRef)
                val et: TypeRef = c.types[elemRef]
                elemKindF = kindFromTySpan(c: inout c, tyStart: et.nameStart, tyLen: et.nameLen)
            }
            // a generic-instance payload field (`Leaf(v: Optional[I64])`,
            // `Some(v: Box[I32])`): the stored value is the instance's named tagged-
            // union / struct type, not the head-name scalar. Resolve it (grounded under
            // the active env) so the alloca + extractvalue + a nested match agree.
            mut val genFieldRef: U64 = 0
            if elemRef == 0U64 {
                if fd.ty != 0U64 {
                    mut val gfp: U64 = fd.ty
                    if c.curTypeParams.count > 0U64 {
                        gfp = groundTypeRef(c: inout c, ref: fd.ty)
                    }
                    if isGenericInst(c: inout c, ref: gfp) {
                        if rangeEquals(bytes: c.bytes, start: c.types[gfp].nameStart, len: c.types[gfp].nameLen, kw: "Array") {
                        } else {
                            genFieldRef = gfp
                            pty = llvmTypeOfRef(c: inout c, st: inout st, ref: gfp)
                        }
                    }
                }
            }
            // a boxed (recursive) payload field holds a heap pointer; load the boxed
            // value back. A non-boxed field is the value directly.
            mut val fv: LLVMValueRef = LLVMBuildExtractValue(st.b, payload, fidx, anon())
            if fieldIsBoxed(c: inout c, f: fd) {
                fv = LLVMBuildLoad2(st.b, pty, fv, anon())
            }
            // inside an async fn the bind's storage is a frame field (survives an
            // `await` inside the arm); otherwise a plain alloca.
            mut val slot: LLVMValueRef = LLVMConstNull(st.ptrty)
            if st.curAsync {
                slot = asyncFrameSlot(c: inout c, st: inout st, idx: st.asyncFieldNext)
                st.asyncFieldNext = st.asyncFieldNext + 1
            } else {
                slot = entryAlloca(st: inout st, ty: pty)
            }
            LLVMBuildStore(st.b, fv, slot)
            // an enum-typed bind carries a bare enum TypeRef so a nested match on it
            // (the recursive case) recovers the enum (typeOf can't see this local).
            mut val tref: U64 = 0
            if enumRegSlot(c: inout c, st: inout st, start: fd.tyStart, len: fd.tyLen) < st.enumIdxs.count {
                tref = simpleTypeRef(c: inout c, nameStart: fd.tyStart, nameLen: fd.tyLen)
            }
            // a generic-instance payload bind carries the full instance TypeRef so a
            // nested match / field access on it recovers the substitution env.
            if genFieldRef != 0U64 {
                tref = genFieldRef
            }
            // a type-parameter payload field (`Optional.Some(v: T)`): ground T under
            // the active enum-instance env (set by the caller around bindMatchPayload)
            // so a String/Bool payload is recognized as kind 1/2, not defaulted to int
            // (which would miscompile the bound {ptr,i64} value at the arm's use site).
            mut val bindKind: U64 = kindFromTySpan(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen)
            if fd.ty != 0U64 {
                if c.curTypeParams.count > 0U64 {
                    val gft: U64 = groundTypeRef(c: inout c, ref: fd.ty)
                    if gft != 0U64 {
                        bindKind = kindFromTySpan(c: inout c, tyStart: c.types[gft].nameStart, tyLen: c.types[gft].nameLen)
                    }
                }
            }
            // a generic-instance payload bind (`Some(v: N[I64])` of a recursive generic):
            // its struct index is the generic struct DEF (via genStructSlot), not a
            // lookup by the un-grounded param name `fd.tyStart` (`T`), so field access
            // `v.field` in the arm body resolves.
            mut val bindStructIdx: U64 = localStructIdxFor(c: inout c, st: inout st, start: fd.tyStart, len: fd.tyLen)
            if genFieldRef != 0U64 {
                if isGenericInst(c: inout c, ref: genFieldRef) {
                    val gbs: U64 = genStructSlot(c: inout c, st: inout st, ref: genFieldRef)
                    if gbs < st.genStructRefs.count {
                        bindStructIdx = st.genStructDefs[gbs]
                    }
                }
            }
            pushLocalR(st: inout st, nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: pty, kind: bindKind, structIdx: bindStructIdx, isArr: isArrF, elemTy: elemTyF, elemKind: elemKindF, typeRef: tref)
            // an array-of-struct payload bind (`Expr.Call(.., val args)` with
            // args: Array[Arg]): track the element struct + ref so `args[i].field`
            // and nested-array/Ref elements resolve in the arm body.
            if isArrF {
                if elemRef != 0U64 {
                    val et2: TypeRef = c.types[elemRef]
                    val esi: U64 = localStructIdxFor(c: inout c, st: inout st, start: et2.nameStart, len: et2.nameLen)
                    if esi < c.structs.count {
                        setLocalElemStruct(st: inout st, esi: esi)
                    }
                    setLocalElemTypeRef(st: inout st, ref: elemRef)
                }
            }
        }
        bi += 1
    }
}

// Bind the fields of a struct destructuring pattern `S { val x, field: val y,
// field2: _ }` (irrefutable — a struct has one shape). Each named bind reads its
// field from the stored scrutinee, honoring array / nested-struct / type-param
// field types (under any generic env the caller set). Discards (`_`, empty name)
// are skipped.
fn bindStructPattern(c: inout Comp, st: inout LlvmCtx, sidx: U64, binds: Array[Bind], scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
    val fs: Array[FieldDef] = c.structs[sidx].fields
    mut val bi: U64 = 0
    while bi < binds.count {
        val b: Bind = binds[bi]
        if b.nameLen == 0U64 {
            bi += 1
        } else {
            // resolve which field this bind reads (by field name = b.fieldStart).
            mut val fidx: U64 = fs.count
            mut val fj: U64 = 0
            while fj < fs.count {
                if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                    fidx = fj
                    fj = fs.count
                } else {
                    fj += 1
                }
            }
            if fidx < fs.count {
                val fld: FieldDef = fs[fidx]
                val fty: LLVMTypeRef = llvmTypeFor(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen, isArray: fld.tyIsArray)
                val fv: LLVMValueRef = LLVMBuildLoad2(st.b, fty, LLVMBuildStructGEP2(st.b, scrutTy, scrutSlot, fidx, anon()), anon())
                val slot: LLVMValueRef = entryAlloca(st: inout st, ty: fty)
                LLVMBuildStore(st.b, fv, slot)
                mut val elemTy: LLVMTypeRef = st.i64ty
                mut val elemKind: U64 = 0
                if fld.tyIsArray {
                    elemTy = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                    elemKind = kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                }
                pushLocal(st: inout st, nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: fty, kind: kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: fld.tyStart, len: fld.tyLen), isArr: fld.tyIsArray, elemTy: elemTy, elemKind: elemKind)
            }
            bi += 1
        }
    }
}

// `for i in lo ..< hi { body }` (or `..= hi`): a counter loop. The loop variable
// is bound to a fresh slot incremented each iteration; range elements are U64.
fn genLlvmForRange(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, varTyStart: U64, varTyLen: U64, inclusive: Bool, lo: U64, hi: U64, body: U64) {
    val mark: U64 = st.nLocals
    mut val vty: LLVMTypeRef = st.i64ty
    if varTyLen > 0U64 {
        vty = llvmScalarTy(c: inout c, st: inout st, tyStart: varTyStart, tyLen: varTyLen)
    }
    val loV: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: lo), target: vty, unsigned: true)
    val hiV: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: hi), target: vty, unsigned: true)
    val islot: LLVMValueRef = entryAlloca(st: inout st, ty: vty)
    LLVMBuildStore(st.b, loV, islot)
    pushLocal(st: inout st, nameStart: varStart, nameLen: varLen, ptr: islot, ty: vty, kind: 3U64, structIdx: c.structs.count, isArr: false, elemTy: st.i64ty, elemKind: 0U64)
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.body"))
    // a dedicated step block (increment) so `continue` re-runs the step, not skips it.
    val stepBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.step"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    val iv: LLVMValueRef = LLVMBuildLoad2(st.b, vty, islot, anon())
    mut val pred: U32 = llvmIntUlt()
    if inclusive {
        pred = llvmIntUle()
    }
    LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, pred, iv, hiV, anon()), bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    pushLoop(st: inout st, breakBB: endBB, contBB: stepBB)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    popLoop(st: inout st)
    if st.terminated {
    } else {
        LLVMBuildBr(st.b, stepBB)
    }
    // step: increment the counter and re-test.
    LLVMPositionBuilderAtEnd(st.b, stepBB)
    val iv2: LLVMValueRef = LLVMBuildLoad2(st.b, vty, islot, anon())
    LLVMBuildStore(st.b, LLVMBuildAdd(st.b, iv2, LLVMConstInt(vty, 1U64, 0I32), anon()), islot)
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// `for x in arr { body }`: walk an array by index, binding x to each element.
// `for x in iterable { body }` over a user Iterable (spec/11): desugar to the
// iterator protocol — `it = iterable.iterator(); loop { match it.next() { Some(v)
// => { x = v; body }, None => break } }`. The iterator is stored in a mutable slot
// (next() is `inout`); each next() yields an Optional[Item] matched by tag.
fn genLlvmForIterable(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, body: U64) {
    // an existential iterator (`for x in (it: any Iter[Item=I64])`): each iteration
    // dynamically dispatches `next()` on the any value (spec/08). The box is shared
    // via the fat pointer's data field, so the iterator state advances across calls.
    val recvRef: U64 = exprTypeRef(c: inout c, st: inout st, id: iter)
    if refIsAny(c: inout c, ref: recvRef) {
        genLlvmForAnyIter(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, anyRef: recvRef, body: body)
        return
    }
    // Generic-instance iterable/iterator (`Box[I64]` / `BoxIter[I64]`): the
    // iterator()/next() methods are monomorphized into the generic-method slots,
    // so route through that path rather than the plain user-fn slots.
    if recvRef != 0U64 {
        if isGenericInst(c: inout c, ref: recvRef) {
            genLlvmForGenIterable(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, body: body, recvRef: recvRef)
            return
        }
    }
    val isidx: U64 = exprStructIdx(c: inout c, st: inout st, id: iter)
    if isidx < c.structs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: for-loop over a non-array (Iterable) not yet supported")
        return
    }
    val isd: StructDef = c.structs[isidx]
    val noArgs: Array[Arg] = []
    val iterableVal: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iter)
    // acquire the iterator: an Iterable provides `iterator()`; an Iterator IS its own
    // iterator (it has `next()` directly). Resolve the iterator value + its struct.
    mut val iterVal: LLVMValueRef = iterableVal
    mut val iterStructStart: U64 = isd.nameStart
    mut val iterStructLen: U64 = isd.nameLen
    val itB: Bind = kwSpan(c: inout c, kw: "iterator", kwLen: 8U64)
    val itfi: U64 = findMethod(c: inout c, recvStart: isd.nameStart, recvLen: isd.nameLen, nameStart: itB.nameStart, nameLen: itB.nameLen, args: noArgs)
    if itfi < c.funcs.count {
        val itSlotF: U64 = userFnSlot(st: inout st, idx: itfi)
        if itSlotF < st.fnIdx.count {
        } else {
            compileErrorAt(line: 0, msg: "LLVM backend: this Iterable's iterator method is not emittable yet")
            return
        }
        mut val itArgs: Array[LLVMValueRef] = []
        itArgs.append(value: iterableVal)
        iterVal = LLVMBuildCall2(st.b, st.fnTy[itSlotF], st.fnVal[itSlotF], arrayCPtr(itArgs), 1U64, anon())
        iterStructStart = c.funcs[itfi].retStart
        iterStructLen = c.funcs[itfi].retLen
    }
    // next() on the Iter struct -> Optional[Item]
    val nextB: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4U64)
    val nfi: U64 = findMethod(c: inout c, recvStart: iterStructStart, recvLen: iterStructLen, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
    if nfi < c.funcs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: Iterable for-loop needs a `next` method on the iterator")
        return
    }
    val nSlotF: U64 = userFnSlot(st: inout st, idx: nfi)
    if nSlotF < st.fnIdx.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: this iterator's next method is not emittable yet")
        return
    }
    val nf: Func = c.funcs[nfi]
    emitIterNextLoop(c: inout c, st: inout st, iterVal: iterVal, optRef: nf.retTy, nextTy: st.fnTy[nSlotF], nextVal: st.fnVal[nSlotF], varStart: varStart, varLen: varLen, body: body)
}

// `for x in genericIterable` where the receiver is a generic instance (`Box[I64]`).
// iterator()/next() are monomorphized into the generic-method slots; the iterator
// instance ref is recovered by grounding iterator()'s return type under the
// receiver's env, and the Optional[Item] return by grounding next()'s under the
// iterator instance's env.
fn genLlvmForGenIterable(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, body: U64, recvRef: U64) {
    val gt: TypeRef = c.types[recvRef]
    val noArgs: Array[Arg] = []
    mut val iterVal: LLVMValueRef = LLVMConstInt(st.i64ty, 0U64, 0I32)
    mut val iterInstRef: U64 = recvRef
    val itB: Bind = kwSpan(c: inout c, kw: "iterator", kwLen: 8U64)
    val itfi: U64 = findMethod(c: inout c, recvStart: gt.nameStart, recvLen: gt.nameLen, nameStart: itB.nameStart, nameLen: itB.nameLen, args: noArgs)
    if itfi < c.funcs.count {
        // an Iterable: call iterator() and switch the instance ref to the iterator's.
        val itSlot: U64 = ensureGenMethodDeclared(c: inout c, st: inout st, mfi: itfi, instRef: recvRef, ownArgs: [])
        if itSlot < st.genMethK.count {
        } else {
            compileErrorAt(line: 0, msg: "LLVM backend: this generic Iterable's iterator method is not emittable yet")
            return
        }
        iterVal = genGenMethodCall(c: inout c, st: inout st, recv: iter, mfi: itfi, slot: itSlot, instRef: recvRef, args: noArgs)
        val itf: Func = c.funcs[itfi]
        val sP: Array[Bind] = c.curTypeParams
        val sA: Array[U64] = c.curTypeArgs
        c.curTypeParams = itf.typeParams
        c.curTypeArgs = gt.args
        iterInstRef = groundTypeRef(c: inout c, ref: itf.retTy)
        c.curTypeParams = sP
        c.curTypeArgs = sA
    } else {
        // the value IS its own Iterator (it has next() directly).
        iterVal = genLlvmExpr(c: inout c, st: inout st, id: iter)
    }
    val it: TypeRef = c.types[iterInstRef]
    val nextB: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4U64)
    val nfi: U64 = findMethod(c: inout c, recvStart: it.nameStart, recvLen: it.nameLen, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
    if nfi < c.funcs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: generic Iterable for-loop needs a `next` method on the iterator")
        return
    }
    val nSlot: U64 = ensureGenMethodDeclared(c: inout c, st: inout st, mfi: nfi, instRef: iterInstRef, ownArgs: [])
    if nSlot < st.genMethK.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: this generic iterator's next method is not emittable yet")
        return
    }
    val nf: Func = c.funcs[nfi]
    val sP2: Array[Bind] = c.curTypeParams
    val sA2: Array[U64] = c.curTypeArgs
    c.curTypeParams = nf.typeParams
    c.curTypeArgs = it.args
    val optRef: U64 = groundTypeRef(c: inout c, ref: nf.retTy)
    c.curTypeParams = sP2
    c.curTypeArgs = sA2
    emitIterNextLoop(c: inout c, st: inout st, iterVal: iterVal, optRef: optRef, nextTy: st.genMethTy[nSlot], nextVal: st.genMethVal[nSlot], varStart: varStart, varLen: varLen, body: body)
}

// Drive the iterator-protocol loop: store `iterVal` in a mutable slot (next() is
// `inout`), and on each `next()` call (callee `nextTy`/`nextVal`) match the ground
// `optRef` Optional[Item] — bind x to the Some payload + run body, else break.
fn emitIterNextLoop(c: inout Comp, st: inout LlvmCtx, iterVal: LLVMValueRef, optRef: U64, nextTy: LLVMTypeRef, nextVal: LLVMValueRef, varStart: U64, varLen: U64, body: U64) {
    val iterTy: LLVMTypeRef = LLVMTypeOf(iterVal)
    val iterSlot: LLVMValueRef = entryAlloca(st: inout st, ty: iterTy)
    LLVMBuildStore(st.b, iterVal, iterSlot)
    // resolve the Optional enum (def + Some variant) under its instance env.
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val didSet: Bool = setEnumEnv(c: inout c, st: inout st, ref: optRef)
    val ge: U64 = genEnumSlot(c: inout c, st: inout st, ref: optRef)
    if ge < st.genEnumRefs.count {
    } else {
        if didSet { c.curTypeParams = savedP  c.curTypeArgs = savedA }
        compileErrorAt(line: 0, msg: "LLVM backend: iterator next must return a registered Optional instance")
        return
    }
    val optEid: U64 = st.genEnumDefs[ge]
    val optTy: LLVMTypeRef = st.genEnumTys[ge]
    val ed: EnumDef = c.enums[optEid]
    val someB: Bind = kwSpan(c: inout c, kw: "Some", kwLen: 4U64)
    val someVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: someB.nameStart, variantLen: someB.nameLen)
    val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: optEid, vi: someVi)
    // the bound element's declared type (the Some payload's single field).
    val itemFs: Array[FieldDef] = ed.variants[someVi].fields
    val mark: U64 = st.nLocals
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fit.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fit.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fit.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    // it.next() — self is `inout` (the iterator slot pointer); yields Optional[Item].
    mut val nArgs: Array[LLVMValueRef] = []
    nArgs.append(value: iterSlot)
    val opt: LLVMValueRef = LLVMBuildCall2(st.b, nextTy, nextVal, arrayCPtr(nArgs), 1U64, anon())
    val optSlot: LLVMValueRef = entryAlloca(st: inout st, ty: optTy)
    LLVMBuildStore(st.b, opt, optSlot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, optTy, optSlot, 0U64, anon()), anon())
    val isSome: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, someVi, 0I32), anon())
    LLVMBuildCondBr(st.b, isSome, bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    // bind x = the Some payload's field 0.
    val payload: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, optTy, optSlot, 1U64, anon()), anon())
    val xVal: LLVMValueRef = LLVMBuildExtractValue(st.b, payload, 0U64, anon())
    val xTy: LLVMTypeRef = LLVMTypeOf(xVal)
    val xSlot: LLVMValueRef = entryAlloca(st: inout st, ty: xTy)
    LLVMBuildStore(st.b, xVal, xSlot)
    mut val xStart: U64 = itemFs[0].tyStart
    mut val xLen: U64 = itemFs[0].tyLen
    // ground the element type through the active enum env so its kind is concrete
    // (a `map`-to-Bool element is i1 -> kind 2, zero-extended on print, not -1).
    if itemFs[0].ty != 0U64 {
        if c.curTypeParams.count > 0U64 {
            val gx: U64 = groundTypeRef(c: inout c, ref: itemFs[0].ty)
            xStart = c.types[gx].nameStart
            xLen = c.types[gx].nameLen
        }
    }
    pushLocalR(st: inout st, nameStart: varStart, nameLen: varLen, ptr: xSlot, ty: xTy, kind: kindFromTySpan(c: inout c, tyStart: xStart, tyLen: xLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: xStart, len: xLen), isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: 0U64)
    if didSet { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    // `continue` -> condBB (next() again), `break` -> endBB.
    pushLoop(st: inout st, breakBB: endBB, contBB: condBB)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    popLoop(st: inout st)
    st.nLocals = mark
    if st.terminated {
    } else {
        LLVMBuildBr(st.b, condBB)
    }
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// `for x in anyIter` where the receiver is an existential `any Iter[Item=…]`: loop
// dynamically dispatching `next()` on the any value (the box's iterator state
// advances in place), binding `x` to each `Some` payload until `None`.
fn genLlvmForAnyIter(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, anyRef: U64, body: U64) {
    val traitIdx: U64 = findTraitIdxByName(c: inout c, start: c.types[anyRef].nameStart, len: c.types[anyRef].nameLen)
    if traitIdx < c.traits.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: for-loop over `any` needs a trait with a `next` method")
        return
    }
    val nextB: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4U64)
    val noArgs: Array[Arg] = []
    // the grounded Optional[Item] the existential's next() returns.
    val optRef: U64 = anyMethodRetRef(c: inout c, anyRef: anyRef, traitIdx: traitIdx, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
    if optRef != 0U64 {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: this `any` iterator has no `next() -> Optional[Item]` requirement")
        return
    }
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val didSet: Bool = setEnumEnv(c: inout c, st: inout st, ref: optRef)
    val ge: U64 = genEnumSlot(c: inout c, st: inout st, ref: optRef)
    if ge < st.genEnumRefs.count {
    } else {
        if didSet { c.curTypeParams = savedP  c.curTypeArgs = savedA }
        compileErrorAt(line: 0, msg: "LLVM backend: `any` iterator next must return a registered Optional instance")
        return
    }
    val optEid: U64 = st.genEnumDefs[ge]
    val optTy: LLVMTypeRef = st.genEnumTys[ge]
    val ed: EnumDef = c.enums[optEid]
    val someB: Bind = kwSpan(c: inout c, kw: "Some", kwLen: 4U64)
    val someVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: someB.nameStart, variantLen: someB.nameLen)
    val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: optEid, vi: someVi)
    val itemFs: Array[FieldDef] = ed.variants[someVi].fields
    val mark: U64 = st.nLocals
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fai.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fai.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fai.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    // it.next() via dynamic dispatch (the loaded fat pointer's stable data ptr -> the
    // shared box, mutated in place).
    val opt: LLVMValueRef = genLlvmAnyDispatch(c: inout c, st: inout st, recv: iter, anyRef: anyRef, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
    val optSlot: LLVMValueRef = entryAlloca(st: inout st, ty: optTy)
    LLVMBuildStore(st.b, opt, optSlot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, optTy, optSlot, 0U64, anon()), anon())
    val isSome: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, someVi, 0I32), anon())
    LLVMBuildCondBr(st.b, isSome, bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    val payload: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, optTy, optSlot, 1U64, anon()), anon())
    val xVal: LLVMValueRef = LLVMBuildExtractValue(st.b, payload, 0U64, anon())
    val xTy: LLVMTypeRef = LLVMTypeOf(xVal)
    val xSlot: LLVMValueRef = entryAlloca(st: inout st, ty: xTy)
    LLVMBuildStore(st.b, xVal, xSlot)
    mut val xStart: U64 = itemFs[0].tyStart
    mut val xLen: U64 = itemFs[0].tyLen
    if itemFs[0].ty != 0U64 {
        if c.curTypeParams.count > 0U64 {
            val gx: U64 = groundTypeRef(c: inout c, ref: itemFs[0].ty)
            xStart = c.types[gx].nameStart
            xLen = c.types[gx].nameLen
        }
    }
    pushLocalR(st: inout st, nameStart: varStart, nameLen: varLen, ptr: xSlot, ty: xTy, kind: kindFromTySpan(c: inout c, tyStart: xStart, tyLen: xLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: xStart, len: xLen), isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: 0U64)
    if didSet { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    pushLoop(st: inout st, breakBB: endBB, contBB: condBB)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    popLoop(st: inout st)
    st.nLocals = mark
    if st.terminated {
    } else {
        LLVMBuildBr(st.b, condBB)
    }
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

fn genLlvmForArray(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, body: U64) {
    if exprIsArray(c: inout c, st: inout st, id: iter) {
    } else {
        genLlvmForIterable(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, body: body)
        return
    }
    val mark: U64 = st.nLocals
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: iter)
    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iter)
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
    val idxslot: LLVMValueRef = entryAlloca(st: inout st, ty: st.i64ty)
    LLVMBuildStore(st.b, LLVMConstInt(st.i64ty, 0U64, 0I32), idxslot)
    val vslot: LLVMValueRef = entryAlloca(st: inout st, ty: elemTy)
    // an `Array[any P]` element: track the loop var's existential TypeRef so a bare
    // `s.m()` in the body dispatches dynamically (spec/08).
    val forElemRef: U64 = arrayExprElemRef(c: inout c, st: inout st, arrayExpr: iter)
    if refIsAny(c: inout c, ref: forElemRef) {
        pushLocalR(st: inout st, nameStart: varStart, nameLen: varLen, ptr: vslot, ty: elemTy, kind: 0U64, structIdx: c.structs.count, isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: forElemRef)
    } else {
        // a struct / record element (`for val e in arrayOfStructs { e.field }`): track
        // the element's struct index and TypeRef so a field access / method call on the
        // loop var resolves (a generic-instance element keeps its instance ref).
        mut val elemSidx: U64 = c.structs.count
        if forElemRef != 0U64 {
            if forElemRef < c.types.count {
                if isGenericInst(c: inout c, ref: forElemRef) {
                    val egs: U64 = genStructSlot(c: inout c, st: inout st, ref: forElemRef)
                    if egs < st.genStructRefs.count {
                        elemSidx = st.genStructDefs[egs]
                    }
                } else {
                    // only a backend-registered struct (not a primitive / String): gate on
                    // structRegSlot so an `Array[I32]` element stays a plain scalar.
                    if structRegSlot(c: inout c, st: inout st, start: c.types[forElemRef].nameStart, len: c.types[forElemRef].nameLen) < st.structIdxs.count {
                        elemSidx = structIndexByName(c: inout c, start: c.types[forElemRef].nameStart, len: c.types[forElemRef].nameLen)
                    }
                }
            }
        }
        if elemSidx < c.structs.count {
            pushLocalR(st: inout st, nameStart: varStart, nameLen: varLen, ptr: vslot, ty: elemTy, kind: 0U64, structIdx: elemSidx, isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: forElemRef)
        } else {
            pushLocal(st: inout st, nameStart: varStart, nameLen: varLen, ptr: vslot, ty: elemTy, kind: 0U64, structIdx: c.structs.count, isArr: false, elemTy: st.i64ty, elemKind: 0U64)
        }
    }
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.body"))
    val stepBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.step"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    val iv: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
    LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, llvmIntUlt(), iv, count, anon()), bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    LLVMBuildStore(st.b, LLVMBuildLoad2(st.b, elemTy, arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: iv), anon()), vslot)
    pushLoop(st: inout st, breakBB: endBB, contBB: stepBB)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    popLoop(st: inout st)
    if st.terminated {
    } else {
        LLVMBuildBr(st.b, stepBB)
    }
    LLVMPositionBuilderAtEnd(st.b, stepBB)
    val iv2: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
    LLVMBuildStore(st.b, LLVMBuildAdd(st.b, iv2, LLVMConstInt(st.i64ty, 1U64, 0I32), anon()), idxslot)
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// `for S { val x } in arr { body }`: walk an array of structs, binding each
// element's fields (per the struct pattern) directly each iteration, mirroring
// the match struct pattern. The element struct is stored in a slot so its fields
// can be GEP'd; field binds are popped at the end of every iteration.
fn genLlvmForArrayStruct(c: inout Comp, st: inout LlvmCtx, patStart: U64, patLen: U64, iter: U64, binds: Array[Bind], body: U64) {
    if exprIsArray(c: inout c, st: inout st, id: iter) {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: struct-destructure for-loop over a non-array not yet supported")
        return
    }
    val sidx: U64 = localStructIdxFor(c: inout c, st: inout st, start: patStart, len: patLen)
    if sidx < c.structs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: struct-destructure for-loop needs a registered struct pattern")
        return
    }
    val mark: U64 = st.nLocals
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: iter)
    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iter)
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
    val idxslot: LLVMValueRef = entryAlloca(st: inout st, ty: st.i64ty)
    LLVMBuildStore(st.b, LLVMConstInt(st.i64ty, 0U64, 0I32), idxslot)
    val eslot: LLVMValueRef = entryAlloca(st: inout st, ty: elemTy)
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    val iv: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
    LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, llvmIntUlt(), iv, count, anon()), bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    LLVMBuildStore(st.b, LLVMBuildLoad2(st.b, elemTy, arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: iv), anon()), eslot)
    val bmark: U64 = st.nLocals
    bindStructPattern(c: inout c, st: inout st, sidx: sidx, binds: binds, scrutTy: elemTy, scrutSlot: eslot)
    val stepBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.step"))
    pushLoop(st: inout st, breakBB: endBB, contBB: stepBB)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    popLoop(st: inout st)
    st.nLocals = bmark
    if st.terminated {
    } else {
        LLVMBuildBr(st.b, stepBB)
    }
    LLVMPositionBuilderAtEnd(st.b, stepBB)
    val iv2: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
    LLVMBuildStore(st.b, LLVMBuildAdd(st.b, iv2, LLVMConstInt(st.i64ty, 1U64, 0I32), anon()), idxslot)
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// The `deinit` method index of struct `sidx`, or c.funcs.count if it has none.
fn structDeinitFi(c: inout Comp, sidx: U64) -> U64 {
    val sd: StructDef = c.structs[sidx]
    val b: Bind = kwSpan(c: inout c, kw: "deinit", kwLen: 6U64)
    val noArgs: Array[Arg] = []
    return findMethod(c: inout c, recvStart: sd.nameStart, recvLen: sd.nameLen, nameStart: b.nameStart, nameLen: b.nameLen, args: noArgs)
}

// Whether destroying a value of struct `sidx` runs any deinit — its own, or a
// (registered, non-array) field's, recursively (spec/03).
fn structNeedsDeinit(c: inout Comp, st: inout LlvmCtx, sidx: U64) -> Bool {
    if structDeinitFi(c: inout c, sidx: sidx) < c.funcs.count {
        return true
    }
    val sd: StructDef = c.structs[sidx]
    mut val i: U64 = 0
    while i < sd.fields.count {
        val fd: FieldDef = sd.fields[i]
        if fd.tyIsArray {
        } else {
            val fsi: U64 = structIndexByName(c: inout c, start: fd.tyStart, len: fd.tyLen)
            if fsi < c.structs.count {
                if c.structs[fsi].isExtern {
                } else {
                    if structNeedsDeinit(c: inout c, st: inout st, sidx: fsi) {
                        return true
                    }
                }
            }
        }
        i += 1
    }
    return false
}

// Destroy a struct VALUE `v` of struct `sidx` (spec/03): run its own `deinit` body
// first, then each field's deinit in declaration order, recursively.
fn emitDeinitValue(c: inout Comp, st: inout LlvmCtx, v: LLVMValueRef, sidx: U64) {
    val sd: StructDef = c.structs[sidx]
    val fi: U64 = structDeinitFi(c: inout c, sidx: sidx)
    if fi < c.funcs.count {
        val slot: U64 = userFnSlot(st: inout st, idx: fi)
        if slot < st.fnIdx.count {
            mut val av: Array[LLVMValueRef] = []
            av.append(value: v)
            LLVMBuildCall2(st.b, st.fnTy[slot], st.fnVal[slot], arrayCPtr(av), 1U64, anon())
        }
    }
    mut val i: U64 = 0
    while i < sd.fields.count {
        val fd: FieldDef = sd.fields[i]
        if fd.tyIsArray {
        } else {
            val fsi: U64 = structIndexByName(c: inout c, start: fd.tyStart, len: fd.tyLen)
            if fsi < c.structs.count {
                if c.structs[fsi].isExtern {
                } else {
                    if structNeedsDeinit(c: inout c, st: inout st, sidx: fsi) {
                        emitDeinitValue(c: inout c, st: inout st, v: LLVMBuildExtractValue(st.b, v, i, anon()), sidx: fsi)
                    }
                }
            }
        }
        i += 1
    }
}

// Run scope-exit destruction of local `li` (spec/03) if it is an owned, not-moved
// unique struct local whose type needs a deinit (own or a field's). The struct
// value is loaded and destroyed recursively.
fn emitDeinitCall(c: inout Comp, st: inout LlvmCtx, li: U64) {
    // skip a borrow/inout param (not owned here) or a value already moved out.
    if st.locOwned[li] {
    } else {
        return
    }
    if st.locMoved[li] {
        return
    }
    // a `Ref[T]` local with a deinit-bearing pointee: release the shared cell; when
    // the last owner drops (refcount hits 0), destroy the pointee (spec/03).
    val rpsi: U64 = refDeinitPointeeSidx(c: inout c, st: inout st, refTy: st.locTypeRef[li])
    if rpsi < c.structs.count {
        val cell: LLVMValueRef = LLVMBuildLoad2(st.b, st.ptrty, st.locPtr[li], anon())
        val newcount: LLVMValueRef = rawbufRelease(c: inout c, st: inout st, cell: cell)
        val isZero: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), newcount, LLVMConstInt(st.i64ty, 0U64, 0I32), anon())
        val deinitBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "refdrop.deinit"))
        val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "refdrop.cont"))
        LLVMBuildCondBr(st.b, isZero, deinitBB, contBB)
        LLVMPositionBuilderAtEnd(st.b, deinitBB)
        val pty: LLVMTypeRef = refPointeeTy(c: inout c, st: inout st, refTy: st.locTypeRef[li])
        emitDeinitValue(c: inout c, st: inout st, v: LLVMBuildLoad2(st.b, pty, cell, anon()), sidx: rpsi)
        LLVMBuildBr(st.b, contBB)
        LLVMPositionBuilderAtEnd(st.b, contBB)
        return
    }
    val sidx: U64 = st.locStructIdx[li]
    if sidx < c.structs.count {
    } else {
        return
    }
    if structNeedsDeinit(c: inout c, st: inout st, sidx: sidx) {
    } else {
        return
    }
    val selfVal: LLVMValueRef = LLVMBuildLoad2(st.b, st.locTy[li], st.locPtr[li], anon())
    emitDeinitValue(c: inout c, st: inout st, v: selfVal, sidx: sidx)
}

// Drop (deinit) the live locals in [fromMark, nLocals) in REVERSE declaration order
// — spec/03's deterministic scope-exit destruction. `excludeLi` (or a large
// sentinel) is skipped, so a unique value being moved out (e.g. returned) is not
// also dropped here. Only deinit-bearing locals emit a call.
fn dropScope(c: inout Comp, st: inout LlvmCtx, fromMark: U64, excludeLi: U64) {
    mut val i: U64 = st.nLocals
    while i > fromMark {
        i -= 1U64
        if i == excludeLi {
        } else {
            emitDeinitCall(c: inout c, st: inout st, li: i)
        }
    }
}

fn genLlvmBlock(c: inout Comp, st: inout LlvmCtx, id: U64) {
    // lexical scope: bindings declared in this block leave scope at its end.
    val mark: U64 = st.nLocals
    val blk: Block = c.blocks[id]
    mut val i: U64 = 0
    while i < blk.stmts.count {
        if st.terminated {
            st.nLocals = mark
            return
        }
        genLlvmStmt(c: inout c, st: inout st, id: blk.stmts[i])
        i += 1
    }
    // fall-through exit: run scope-exit deinits for this block's locals (a return
    // inside already dropped all live locals and set terminated).
    if st.terminated {
    } else {
        dropScope(c: inout c, st: inout st, fromMark: mark, excludeLi: 18446744073709551615U64)
    }
    st.nLocals = mark
}

// ---- the LLVM backend entry ----
//
// Build the module from the analyzed arena and print its IR. v1 emits the user's
// `main` only (other functions / types arrive in later increments).
fn emitLlvm(c: inout Comp) {
    val ctx: LLVMContextRef = LLVMContextCreate()
    val m: LLVMModuleRef = LLVMModuleCreateWithNameInContext(cstr(s: "plew"), ctx)
    val ptrty: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0U32)
    val i64ty: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
    // String = { i8* data, i64 len } (ABI-identical to the C runtime's PlewString).
    mut val strelems: Array[LLVMTypeRef] = []
    strelems.append(value: ptrty)
    strelems.append(value: i64ty)
    val strty: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(strelems), 2U64, 0I32)
    mut val arrelems: Array[LLVMTypeRef] = []
    arrelems.append(value: ptrty)
    arrelems.append(value: i64ty)
    val arrayTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(arrelems), 2U64, 0I32)
    mut val cloelems: Array[LLVMTypeRef] = []
    cloelems.append(value: ptrty)
    cloelems.append(value: ptrty)
    val closureTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(cloelems), 2U64, 0I32)
    // any P = { ptr data, ptr vtable } (fat pointer for existentials).
    mut val anyelems: Array[LLVMTypeRef] = []
    anyelems.append(value: ptrty)
    anyelems.append(value: ptrty)
    val anyTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(anyelems), 2U64, 0I32)
    // PlewPromise = { i32 done, i64 value, ptr k, ptr kframe } (ABI-identical to
    // the C runtime). Awaited values are type-erased through `value` (i64).
    mut val promelems: Array[LLVMTypeRef] = []
    promelems.append(value: LLVMInt32TypeInContext(ctx))
    promelems.append(value: i64ty)
    promelems.append(value: ptrty)
    promelems.append(value: ptrty)
    val promiseTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(promelems), 4U64, 0I32)
    mut val st: LlvmCtx = <LlvmCtx
        ctx=ctx mod=m b=LLVMCreateBuilderInContext(ctx)
        i1ty=LLVMInt1TypeInContext(ctx) i8ty=LLVMInt8TypeInContext(ctx) i16ty=LLVMInt16TypeInContext(ctx)
        i32ty=LLVMInt32TypeInContext(ctx) i64ty=i64ty f64ty=LLVMDoubleTypeInContext(ctx)
        voidty=LLVMVoidTypeInContext(ctx) ptrty=ptrty strty=strty arrayTy=arrayTy closureTy=closureTy anyTy=anyTy anyVtType=[] anyVtTrait=[] anyVtBindKey=[] anyVtVal=[]
        curFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32) terminated=false
        curIsMain=false curRetVoid=true curRetTy=LLVMVoidTypeInContext(ctx) curRetTyStart=0 curRetTyLen=0 giveValue=LLVMConstInt(LLVMInt64TypeInContext(ctx), 0U64, 0I32) structIdxs=[] structTys=[] genStructRefs=[] genStructTys=[] genStructDefs=[] genEnumRefs=[] genEnumTys=[] genEnumDefs=[] enumIdxs=[] enumTys=[] selfStart=0 selfLen=0 curRecvInstRef=0 expectedTy=0 curRetRef=0 curBodyMark=0 nLocals=0
        fnIdx=[] fnVal=[] fnTy=[] genFnK=[] genFnVal=[] genFnTy=[] genMethK=[] genMethInst=[] genMethVal=[] genMethTy=[] genMethOwn=[]
        locStart=[] locLen=[] locPtr=[] locTy=[] locKind=[] locStructIdx=[] locIsArr=[] locElemTy=[] locElemKind=[] locTypeRef=[] locElemStructIdx=[] locElemTypeRef=[] locOwned=[] locMoved=[] declId=[] declFn=[] declTy=[] reachAssoc=[] cloIdx=[] cloVal=[] cloTy=[] thunkIdx=[] thunkVal=[] thunkTy=[] provEmit=[] genMethEmit=[]
        promiseTy=promiseTy curAsync=false
        curFrameBase=LLVMConstNull(ptrty) curFrameTy=i64ty
        curResumeFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncSwitch=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncState=0 asyncFieldNext=0 asyncFnIdx=[] asyncFrameTy=[] asyncResumeFn=[] asyncSlotPtrs=[] loopBreakBB=[] loopContBB=[] loopDepth=0 />

    // a "self" byte span (appended past the source) to bind method receivers.
    st.selfStart = c.bytes.count
    c.appendSrc(from: "self".bytes)
    st.selfLen = 4U64

    // register user struct + enum types, then generic struct/enum instances. ALL
    // NAMES first (plain structs, plain enums, generic-struct instances, generic-enum
    // instances), THEN all cross-referencing bodies — so a struct/enum body may hold a
    // member of generic-instance type (`struct Pair { a: Optional[I64] }`) regardless
    // of declaration order. (Plain enums and generic-enum instances are self-contained
    // `{ i64 tag, [maxWords] payload }`, sized by the front-end, so their bodies are
    // set with their names; only struct + generic-struct bodies cross-reference named
    // types, so those are deferred to the body passes.)
    registerStructNames(c: inout c, st: inout st)
    registerEnums(c: inout c, st: inout st)
    registerGenStructNames(c: inout c, st: inout st)
    registerGenEnums(c: inout c, st: inout st)
    registerStructBodies(c: inout c, st: inout st)
    registerGenStructBodies(c: inout c, st: inout st)

    // determine which assoc fns are actually reached (called) before declaring.
    collectReachableAssoc(c: inout c, st: inout st)

    // pass 1: declare all plain user functions + generic free-fn instances + generic
    // method instances (one per receiver instantiation).
    declareUserFns(c: inout c, st: inout st)
    declareGenFns(c: inout c, st: inout st)
    declareGenMethods(c: inout c, st: inout st)
    // async fns: build each frame struct + resume fn, and a non-main entry symbol
    // in the fnIdx table (so a call `doubler(x: 21)` resolves to a promise-returning
    // call). Done before bodies emit so main's resume can call them.
    declareAsyncFns(c: inout c, st: inout st)
    // declare lambda-lifted closures (after the named types + functions they may
    // reference exist), so a closure literal can build its {fn, env} value.
    collectClosures(c: inout c, st: inout st)
    // declare function-value thunks (a bare function reference -> {thunk, null}).
    collectThunks(c: inout c, st: inout st)

    // module-level variables (spec/15): emit `plew_init_globals` (one body that runs
    // every global's initializer once) and record each global's metadata, BEFORE any
    // function body so `seedGlobals` can re-bind them at every body entry. Done after
    // pass-1 declarations so an initializer may call a user function.
    genLlvmInitGlobals(c: inout c, st: inout st)

    // pass 2: emit `main` and every plain user function's body.
    mut val fi: U64 = 0
    mut val foundMain: Bool = false
    while fi < c.funcs.count {
        // gen mode (spec/16): the program is the synthesized harness main at
        // `genMainIdx`; the user's own `main` is dead (it calls macro-generated
        // functions that don't exist in this build), so it is neither the entry
        // main nor a plain fn. Treat only genMainIdx as main here.
        mut val isMainFn: Bool = nameIsMain(c: inout c, f: c.funcs[fi])
        if c.genMode {
            if isMainFn {
                if fi == c.genMainIdx {
                } else {
                    isMainFn = false
                }
            }
        }
        if isMainFn {
            // an `async fn main` is lowered with the rest of the async fns (entry +
            // resume + drain the event loop); a plain main is the synchronous shape.
            if isAsyncFn(c: inout c, fi: fi) {
            } else {
                genLlvmMain(c: inout c, st: inout st, fi: fi)
            }
            foundMain = true
        } else {
            if c.genMode && nameIsMain(c: inout c, f: c.funcs[fi]) {
                // the dead user main: skip entirely.
            } else {
                if isPlainUserFn(c: inout c, st: inout st, fi: fi) {
                    genLlvmFunc(c: inout c, st: inout st, fi: fi)
                }
            }
        }
        fi += 1
    }
    // async fn entry + resume bodies (main's entry drains the loop).
    emitAsyncFns(c: inout c, st: inout st)
    // generic free-function + generic-method instance bodies.
    emitGenFns(c: inout c, st: inout st)
    emitGenMethods(c: inout c, st: inout st)
    // lambda-lifted closure bodies + function-value thunks.
    emitClosures(c: inout c, st: inout st)
    emitThunks(c: inout c, st: inout st)
    // provided trait methods + lazily-declared std/generic methods reached during
    // the passes above. Both queues can grow as bodies emit (a provided body calls
    // a std generic method, a generic body reaches a provided one), so drain to a
    // fixpoint: loop until neither queue advances.
    mut val provDone: U64 = 0
    mut val genmDone: U64 = 0
    mut val draining: Bool = true
    while draining {
        while provDone < st.provEmit.count {
            genLlvmFuncBody(c: inout c, st: inout st, fi: st.provEmit[provDone], fv: st.fnVal[userFnSlot(st: inout st, idx: st.provEmit[provDone])])
            provDone += 1
        }
        while genmDone < st.genMethEmit.count {
            emitOneGenMethod(c: inout c, st: inout st, slot: st.genMethEmit[genmDone])
            genmDone += 1
        }
        if provDone >= st.provEmit.count {
            if genmDone >= st.genMethEmit.count {
                draining = false
            }
        }
    }
    if foundMain {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: no `main` function found")
    }

    val ir: CPtr[U8] = LLVMPrintModuleToString(st.mod)
    write(s: stringFromCString(ir))
    LLVMDisposeMessage(ir)
}

// Emit `void @plew_init_globals()` (spec/15): one body that runs each module-level
// variable's initializer in lowering (= declaration) order and stores the result into
// its LLVM global. Each initializer is the same `Stmt.Let` a local binding produces,
// so we emit it through the normal statement path (which pushes a fully-typed local +
// alloca), then copy that local's recovered value into a fresh LLVM global and record
// its metadata in `gval*` so `seedGlobals` can re-bind it at every body entry. A later
// global's initializer can reference an earlier one (resolved as the alloca-local just
// pushed). Globals are program-lifetime, so they are never deinit'd (no scope-exit
// drop here — the same leak level as a top-level array/String value).
fn genLlvmInitGlobals(c: inout Comp, st: inout LlvmCtx) {
    if c.globals.count == 0U64 {
        return
    }
    mut val noParams: Array[LLVMTypeRef] = []
    val fnTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(noParams), 0U64, 0I32)
    val fv: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_init_globals", nameId: 9120U64, fnTy: fnTy)
    st.curFn = fv
    st.curIsMain = false
    st.curRetVoid = true
    st.curAsync = false
    beginFnBody(st: inout st, fv: fv)
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    mut val gi: U64 = 0
    while gi < c.globals.count {
        genLlvmStmt(c: inout c, st: inout st, id: c.globals[gi].letStmt)
        val li: U64 = st.nLocals - 1U64
        val lty: LLVMTypeRef = st.locTy[li]
        val gv: LLVMValueRef = LLVMAddGlobal(st.mod, lty, cstr(s: globalSymbol(idx: gi)))
        LLVMSetInitializer(gv, LLVMConstNull(lty))
        val cur: LLVMValueRef = LLVMBuildLoad2(st.b, lty, st.locPtr[li], anon())
        LLVMBuildStore(st.b, cur, gv)
        st.gvalRef.append(value: gv)
        st.gvalLty.append(value: lty)
        st.gvalKind.append(value: st.locKind[li])
        st.gvalSidx.append(value: st.locStructIdx[li])
        st.gvalIsArr.append(value: st.locIsArr[li])
        st.gvalElemTy.append(value: st.locElemTy[li])
        st.gvalElemKind.append(value: st.locElemKind[li])
        st.gvalTref.append(value: st.locTypeRef[li])
        st.gvalElemStructIdx.append(value: st.locElemStructIdx[li])
        st.gvalElemTypeRef.append(value: st.locElemTypeRef[li])
        gi += 1
    }
    LLVMBuildRetVoid(st.b)
}

// A unique, stable LLVM symbol for the module-level variable at lowering index `idx`
// ("plew.g.<idx>"), so a same-named user local never collides with the global symbol.
fn globalSymbol(idx: U64) -> String {
    mut val s: Array[U8] = []
    appendBytes(into: inout s, from: "plew.g.".bytes)
    appendU64Dec(into: inout s, n: idx)
    return stringFromBytes(s)
}

// Re-register every module-level variable as a local pointing at its LLVM global, so
// reads (`x`), writes (`x = …` for a `mut val` global), and all type-recovery
// (`x.field`, `x[i]`, method dispatch) resolve through the normal local machinery
// (findLocal). Called at the start of each function/closure/async body AFTER the local
// reset and BEFORE params/captures — so a same-named param or local shadows the global
// (findLocal returns the most-recently pushed match).
fn seedGlobals(c: inout Comp, st: inout LlvmCtx) {
    mut val gi: U64 = 0
    while gi < st.gvalRef.count {
        pushLocalR(st: inout st, nameStart: c.globals[gi].nameStart, nameLen: c.globals[gi].nameLen, ptr: st.gvalRef[gi], ty: st.gvalLty[gi], kind: st.gvalKind[gi], structIdx: st.gvalSidx[gi], isArr: st.gvalIsArr[gi], elemTy: st.gvalElemTy[gi], elemKind: st.gvalElemKind[gi], typeRef: st.gvalTref[gi])
        setLocalElemStruct(st: inout st, esi: st.gvalElemStructIdx[gi])
        setLocalElemTypeRef(st: inout st, ref: st.gvalElemTypeRef[gi])
        gi += 1
    }
}

// Emit the user `main` as C `i32 @main()` returning 0 (Plew main returns ()).
fn genLlvmMain(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    // `i32 main(i32 argc, ptr argv)` so the program can read its command-line args
    // (@Std/Process argCount/argAt) — the args are stashed into the runtime via
    // plew_set_args before the body runs.
    mut val mainParams: Array[LLVMTypeRef] = []
    mainParams.append(value: st.i32ty)
    mainParams.append(value: st.ptrty)
    val mainTy: LLVMTypeRef = LLVMFunctionType(st.i32ty, arrayCPtr(mainParams), 2U64, 0I32)
    val mainFn: LLVMValueRef = LLVMAddFunction(st.mod, cstr(s: "main"), mainTy)
    st.curFn = mainFn
    st.curIsMain = true
    st.curRetVoid = false
    beginFnBody(st: inout st, fv: mainFn)
    // plew_set_args(argc, argv).
    mut val saTys: Array[LLVMTypeRef] = []
    saTys.append(value: st.i32ty)
    saTys.append(value: st.ptrty)
    val saTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(saTys), 2U64, 0I32)
    val saFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_set_args", nameId: 56U64, fnTy: saTy)
    mut val saArgs: Array[LLVMValueRef] = []
    saArgs.append(value: LLVMGetParam(mainFn, 0U64))
    saArgs.append(value: LLVMGetParam(mainFn, 1U64))
    LLVMBuildCall2(st.b, saTy, saFn, arrayCPtr(saArgs), 2U64, anon())
    // initialize module-level variables (spec/15) before the body runs.
    callInitGlobals(c: inout c, st: inout st)
    // fresh local scope.
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    seedGlobals(c: inout c, st: inout st)
    genLlvmBlock(c: inout c, st: inout st, id: c.funcs[fi].body)
    if st.terminated {
    } else {
        LLVMBuildRet(st.b, LLVMConstInt(st.i32ty, 0U64, 0I32))
    }
}

// Emit a call to `plew_init_globals` (a no-op when there are no module-level vars).
fn callInitGlobals(c: inout Comp, st: inout LlvmCtx) {
    if c.globals.count == 0U64 {
        return
    }
    mut val noParams: Array[LLVMTypeRef] = []
    val igTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(noParams), 0U64, 0I32)
    val igFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_init_globals", nameId: 9120U64, fnTy: igTy)
    mut val noArgs: Array[LLVMValueRef] = []
    LLVMBuildCall2(st.b, igTy, igFn, arrayCPtr(noArgs), 0U64, anon())
}

// ---- async lowering (spec/14): stackless state machine ----
//
// Mirrors Codegen/Async.pw (the C backend) in LLVM IR. Each `async fn` becomes a
// frame struct (state + the returned `self` promise + the awaited `sub` promise +
// every param and hoisted local, so values survive `await` suspensions), a resume
// fn (the body, with a dispatch `switch` at entry that re-enters at the right
// await point), and an entry fn (allocates the frame, copies params, creates
// `self`, runs resume once, returns `self`). The promise value is a type-erased
// i64 (scalars / () for now; struct/String results are additive). The runtime
// (promises, FIFO ready queue, virtual-clock timers, event loop, sleep) is the
// SAME C as the C backend, emitted by `--runtime` (external linkage so the IR
// links against it). The state machine is the only part lowered to IR.

fn isAsyncFn(c: inout Comp, fi: U64) -> Bool {
    return c.funcs[fi].isAsync
}

// The LLVM type of an async frame field (a param or a hoisted local): a `Promise`
// is a pointer (PlewPromise*), an array its {ptr,i64} value, a generic instance /
// enum / scalar its normal type. Type-erased await values are i64, but a binding
// keeps its declared type (the coerce happens at the store).
fn asyncFieldTy(c: inout Comp, st: inout LlvmCtx, tyStart: U64, tyLen: U64, ty: U64, isArray: Bool) -> LLVMTypeRef {
    if isArray {
        return st.arrayTy
    }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "Promise") {
        return st.ptrty
    }
    if isGenericInst(c: inout c, ref: ty) {
        return llvmTypeOfRef(c: inout c, st: inout st, ref: ty)
    }
    if isRefInst(c: inout c, ref: ty) {
        return st.ptrty
    }
    return llvmScalarTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen)
}

// One async param's frame-field type (Promise -> ptr; otherwise the param's
// normal LLVM type, array-aware).
fn asyncParamTy(c: inout Comp, st: inout LlvmCtx, p: Param) -> LLVMTypeRef {
    return asyncFieldTy(c: inout c, st: inout st, tyStart: p.tyStart, tyLen: p.tyLen, ty: p.ty, isArray: p.tyIsArray)
}

// Append the LLVM types of an async body's hoisted locals (each `let` binding and
// each enum-match payload bind) to `tys`, in the SAME DFS order the resume codegen
// hands out frame fields — so field index N in the pre-pass is the N-th
// `asyncFrameSlot` the body pass consumes. Recurses into if/while/match.
fn collectAsyncFieldTys(c: inout Comp, st: inout LlvmCtx, blockId: U64, tys: inout Array[LLVMTypeRef]) {
    val b: Block = c.blocks[blockId]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        match c.stmts[stmts[i]] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                // an `await`-initialized binding holds the type-erased value coerced
                // to its declared type; a normal binding holds its declared/inferred
                // type. Both keep the annotation's LLVM type as the field.
                tys.append(value: asyncFieldTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen, ty: ty, isArray: tyIsArray))
            }
            Stmt.If(cond: _, val thenBlk, val elseBlk, val hasElse) => {
                collectAsyncFieldTys(c: inout c, st: inout st, blockId: thenBlk, tys: inout tys)
                if hasElse {
                    collectAsyncFieldTys(c: inout c, st: inout st, blockId: elseBlk, tys: inout tys)
                }
            }
            Stmt.While(cond: _, val body) => {
                collectAsyncFieldTys(c: inout c, st: inout st, blockId: body, tys: inout tys)
            }
            Stmt.Match(scrut: _, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count {
                    val a: MatchArm = arms[ai]
                    if a.isWildcard {
                    } else {
                        if a.isStruct {
                        } else {
                            collectAsyncMatchBindTys(c: inout c, st: inout st, arm: a, tys: inout tys)
                        }
                    }
                    collectAsyncFieldTys(c: inout c, st: inout st, blockId: a.body, tys: inout tys)
                    ai += 1
                }
            }
            _ => {}
        }
        i += 1
    }
}

// Append one enum-match arm's payload-bind frame-field types (mirrors
// bindMatchPayload's per-field type recovery: array -> {ptr,i64}, boxed -> ptr,
// else the field's scalar type), in bind order.
fn collectAsyncMatchBindTys(c: inout Comp, st: inout LlvmCtx, arm: MatchArm, tys: inout Array[LLVMTypeRef]) {
    val eid: U64 = enumIdxByName(c: inout c, start: arm.enumStart, len: arm.enumLen)
    if eid < c.enums.count {
    } else {
        return
    }
    val vi: U64 = variantIndex(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
    val fs: Array[FieldDef] = c.enums[eid].variants[vi].fields
    val binds: Array[Bind] = arm.binds
    mut val bi: U64 = 0
    while bi < binds.count {
        val b: Bind = binds[bi]
        mut val fidx: U64 = fs.count
        mut val fj: U64 = 0
        while fj < fs.count {
            if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                fidx = fj
                fj = fs.count
            } else {
                fj += 1
            }
        }
        mut val pty: LLVMTypeRef = st.i64ty
        if fidx < fs.count {
            val fd: FieldDef = fs[fidx]
            if arrayFieldElemRef(c: inout c, f: fd) != 0U64 {
                pty = st.arrayTy
            } else {
                if fieldIsBoxed(c: inout c, f: fd) {
                    pty = st.ptrty
                } else {
                    pty = llvmScalarTy(c: inout c, st: inout st, tyStart: fd.tyStart, tyLen: fd.tyLen)
                }
            }
        }
        tys.append(value: pty)
        bi += 1
    }
}

// Build (once) an async fn's named frame struct type `{ i32 state, ptr self,
// ptr sub, <param fields...>, <hoisted-local fields...> }`.
fn buildAsyncFrameTy(c: inout Comp, st: inout LlvmCtx, fi: U64) -> LLVMTypeRef {
    val f: Func = c.funcs[fi]
    mut val tys: Array[LLVMTypeRef] = []
    tys.append(value: st.i32ty)
    tys.append(value: st.ptrty)
    tys.append(value: st.ptrty)
    mut val pi: U64 = 0
    while pi < f.params.count {
        tys.append(value: asyncParamTy(c: inout c, st: inout st, p: f.params[pi]))
        pi += 1
    }
    collectAsyncFieldTys(c: inout c, st: inout st, blockId: f.body, tys: inout tys)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "__af".bytes)
    appendU64Dec(into: inout nm, n: fi)
    nm.append(value: 0)
    val frameTy: LLVMTypeRef = LLVMStructCreateNamed(st.ctx, arrayCPtr(nm))
    LLVMStructSetBody(frameTy, arrayCPtr(tys), tys.count, 0I32)
    return frameTy
}

// Declare every async fn: build its frame struct type + resume fn, and (for a
// non-main async fn) its entry symbol in the fnIdx table (signature: params ->
// PlewPromise*, so a call site `doubler(x: 21)` resolves to a promise-returning
// call). `main` keeps the C `i32 main()` shape (handled at emit).
fn declareAsyncFns(c: inout Comp, st: inout LlvmCtx) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        if isAsyncFn(c: inout c, fi: fi) {
            if c.funcs[fi].typeParams.count > 0U64 {
                compileErrorAt(line: lineOf(c: inout c, offset: c.funcs[fi].nameStart), msg: "LLVM backend: generic `async fn` is not yet supported")
            }
            if c.funcs[fi].hasRecv {
                compileErrorAt(line: lineOf(c: inout c, offset: c.funcs[fi].nameStart), msg: "LLVM backend: `async fn` methods are not yet supported (only free `async fn`)")
            }
            val frameTy: LLVMTypeRef = buildAsyncFrameTy(c: inout c, st: inout st, fi: fi)
            // resume fn: void __af<fi>_resume(void*).
            mut val rptys: Array[LLVMTypeRef] = []
            rptys.append(value: st.ptrty)
            val resumeTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(rptys), 1U64, 0I32)
            mut val rnm: Array[U8] = []
            appendBytes(into: inout rnm, from: "__af".bytes)
            appendU64Dec(into: inout rnm, n: fi)
            appendBytes(into: inout rnm, from: "_resume".bytes)
            rnm.append(value: 0)
            val resumeFn: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(rnm), resumeTy)
            st.asyncFnIdx.append(value: fi)
            st.asyncFrameTy.append(value: frameTy)
            st.asyncResumeFn.append(value: resumeFn)
            // entry symbol (non-main): params -> ptr (Promise).
            if nameIsMain(c: inout c, f: c.funcs[fi]) {
            } else {
                mut val ptys: Array[LLVMTypeRef] = []
                mut val pi: U64 = 0
                while pi < c.funcs[fi].params.count {
                    ptys.append(value: asyncParamTy(c: inout c, st: inout st, p: c.funcs[fi].params[pi]))
                    pi += 1
                }
                val fty: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(ptys), ptys.count, 0I32)
                mut val enm: Array[U8] = []
                appendBytes(into: inout enm, from: "pf".bytes)
                appendU64Dec(into: inout enm, n: fi)
                enm.append(value: 0)
                val entryFn: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(enm), fty)
                st.fnIdx.append(value: fi)
                st.fnVal.append(value: entryFn)
                st.fnTy.append(value: fty)
            }
        }
        fi += 1
    }
}

// The async-fn registry slot for `fi` (frame type / resume fn), or count if absent.
fn asyncSlotOf(st: inout LlvmCtx, fi: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.asyncFnIdx.count {
        if st.asyncFnIdx[i] == fi {
            return i
        }
        i += 1
    }
    return st.asyncFnIdx.count
}

// A pointer to async frame field `idx`: the cached GEP built in the resume entry
// block (so it dominates every switch-reachable resume block).
fn asyncFrameSlot(c: inout Comp, st: inout LlvmCtx, idx: U64) -> LLVMValueRef {
    return st.asyncSlotPtrs[idx]
}

// Emit one `await operand` suspension point (mirrors emitAsyncSuspend): stash the
// awaited promise in the frame, bump+store the state, and if it is not already
// resolved register the resume continuation and return; otherwise fall straight
// through. The resume block is added as a dispatch case so a later resume re-enters
// here. After this the awaited value is `__f->__sub->value` (asyncSubValue).
fn emitLlvmAsyncSuspend(c: inout Comp, st: inout LlvmCtx, operandId: U64) {
    st.curAsyncState = st.curAsyncState + 1
    val state: U64 = st.curAsyncState
    val subPromise: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: operandId)
    LLVMBuildStore(st.b, subPromise, asyncFrameSlot(c: inout c, st: inout st, idx: 2U64))
    LLVMBuildStore(st.b, LLVMConstInt(st.i32ty, state, 0I32), asyncFrameSlot(c: inout c, st: inout st, idx: 0U64))
    val donePtr: LLVMValueRef = LLVMBuildStructGEP2(st.b, st.promiseTy, subPromise, 0U64, anon())
    val done: LLVMValueRef = LLVMBuildLoad2(st.b, st.i32ty, donePtr, anon())
    val doneNz: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntNe(), done, LLVMConstInt(st.i32ty, 0U64, 0I32), anon())
    val resumeBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "async.resume"))
    val suspendBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "async.suspend"))
    LLVMBuildCondBr(st.b, doneNz, resumeBB, suspendBB)
    // suspend: register (resume fn, frame) as the promise's continuation, return.
    LLVMPositionBuilderAtEnd(st.b, suspendBB)
    LLVMBuildStore(st.b, st.curResumeFn, LLVMBuildStructGEP2(st.b, st.promiseTy, subPromise, 2U64, anon()))
    LLVMBuildStore(st.b, st.curFrameBase, LLVMBuildStructGEP2(st.b, st.promiseTy, subPromise, 3U64, anon()))
    LLVMBuildRetVoid(st.b)
    // resume target (also the dispatch case for this state).
    LLVMAddCase(st.curAsyncSwitch, LLVMConstInt(st.i32ty, state, 0I32), resumeBB)
    LLVMPositionBuilderAtEnd(st.b, resumeBB)
    st.terminated = false
}

// The just-awaited value: reload `__f->__sub` from the frame (the SSA from before
// the suspend doesn't dominate the resume block, reached via the dispatch switch),
// then load its `value` (type-erased i64).
fn asyncSubValue(c: inout Comp, st: inout LlvmCtx) -> LLVMValueRef {
    val sub: LLVMValueRef = LLVMBuildLoad2(st.b, st.ptrty, asyncFrameSlot(c: inout c, st: inout st, idx: 2U64), anon())
    val valPtr: LLVMValueRef = LLVMBuildStructGEP2(st.b, st.promiseTy, sub, 1U64, anon())
    return LLVMBuildLoad2(st.b, st.i64ty, valPtr, anon())
}

fn exprIsAwaitLL(c: inout Comp, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Await(operand: _) => { return true }
        _ => { return false }
    }
}

// Lower a `let` whose initializer is `await e` inside an async fn: suspend, then
// store the (type-erased) awaited value, coerced to the binding's declared type,
// into its frame field.
fn genLlvmAsyncAwaitLet(c: inout Comp, st: inout LlvmCtx, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, ty: U64, operand: U64) {
    emitLlvmAsyncSuspend(c: inout c, st: inout st, operandId: operand)
    mut val v: LLVMValueRef = asyncSubValue(c: inout c, st: inout st)
    val lty: LLVMTypeRef = asyncFieldTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen, ty: ty, isArray: false)
    if tyLen > 0U64 {
        v = coerceIntTo(c: inout c, st: inout st, v: v, tyStart: tyStart, tyLen: tyLen)
    }
    val slot: LLVMValueRef = asyncFrameSlot(c: inout c, st: inout st, idx: st.asyncFieldNext)
    st.asyncFieldNext = st.asyncFieldNext + 1
    LLVMBuildStore(st.b, v, slot)
    mut val tref: U64 = 0
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "Promise") {
        tref = 0U64
    }
    pushLocalR(st: inout st, nameStart: nameStart, nameLen: nameLen, ptr: slot, ty: lty, kind: kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: tyStart, len: tyLen), isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: tref)
}

// Lower a `return` inside an async fn (mirrors genAsyncReturn): resolve `__self`
// with the (type-erased) value — a `return await e` first suspends — then free the
// frame and return from the resume fn.
fn genLlvmAsyncReturn(c: inout Comp, st: inout LlvmCtx, value: U64, hasValue: Bool) {
    mut val rv: LLVMValueRef = LLVMConstInt(st.i64ty, 0U64, 0I32)
    if hasValue {
        if exprIsAwaitLL(c: inout c, id: value) {
            match c.exprs[value] {
                Expr.Await(val operand) => {
                    emitLlvmAsyncSuspend(c: inout c, st: inout st, operandId: operand)
                    rv = asyncSubValue(c: inout c, st: inout st)
                }
                _ => {}
            }
        } else {
            rv = extendToI64(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), unsigned: false)
        }
    }
    asyncResolveAndReturn(c: inout c, st: inout st, value: rv)
}

// Resolve `__self` with an i64 value, free the frame, and `ret void` from the
// resume fn. The shared tail of return and fall-through.
fn asyncResolveAndReturn(c: inout Comp, st: inout LlvmCtx, value: LLVMValueRef) {
    val self: LLVMValueRef = LLVMBuildLoad2(st.b, st.ptrty, asyncFrameSlot(c: inout c, st: inout st, idx: 1U64), anon())
    mut val rargs: Array[LLVMValueRef] = []
    rargs.append(value: self)
    rargs.append(value: value)
    mut val rty: Array[LLVMTypeRef] = []
    rty.append(value: st.ptrty)
    rty.append(value: st.i64ty)
    val resolveTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(rty), 2U64, 0I32)
    val resolve: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_promise_resolve", nameId: 41U64, fnTy: resolveTy)
    val ignore: LLVMValueRef = LLVMBuildCall2(st.b, resolveTy, resolve, arrayCPtr(rargs), 2U64, anon())
    asyncFreeFrame(c: inout c, st: inout st, frame: st.curFrameBase)
    LLVMBuildRetVoid(st.b)
    st.terminated = true
}

fn asyncFreeFrame(c: inout Comp, st: inout LlvmCtx, frame: LLVMValueRef) {
    mut val fargs: Array[LLVMValueRef] = []
    fargs.append(value: frame)
    mut val fty: Array[LLVMTypeRef] = []
    fty.append(value: st.ptrty)
    val freeTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(fty), 1U64, 0I32)
    val freeFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_frame_free", nameId: 45U64, fnTy: freeTy)
    val ignore: LLVMValueRef = LLVMBuildCall2(st.b, freeTy, freeFn, arrayCPtr(fargs), 1U64, anon())
}

fn asyncPromiseNew(c: inout Comp, st: inout LlvmCtx) -> LLVMValueRef {
    mut val noargs: Array[LLVMValueRef] = []
    mut val noty: Array[LLVMTypeRef] = []
    val newTy: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(noty), 0U64, 0I32)
    val newFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_promise_new", nameId: 40U64, fnTy: newTy)
    return LLVMBuildCall2(st.b, newTy, newFn, arrayCPtr(noargs), 0U64, anon())
}

fn asyncFrameAlloc(c: inout Comp, st: inout LlvmCtx, frameTy: LLVMTypeRef) -> LLVMValueRef {
    mut val aargs: Array[LLVMValueRef] = []
    aargs.append(value: LLVMSizeOf(frameTy))
    mut val aty: Array[LLVMTypeRef] = []
    aty.append(value: st.i64ty)
    val allocTy: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(aty), 1U64, 0I32)
    val allocFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_frame_alloc", nameId: 44U64, fnTy: allocTy)
    return LLVMBuildCall2(st.b, allocTy, allocFn, arrayCPtr(aargs), 1U64, anon())
}

fn asyncLoopRun(c: inout Comp, st: inout LlvmCtx) {
    mut val noargs: Array[LLVMValueRef] = []
    mut val noty: Array[LLVMTypeRef] = []
    val loopTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(noty), 0U64, 0I32)
    val loopFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_loop_run", nameId: 43U64, fnTy: loopTy)
    val ignore: LLVMValueRef = LLVMBuildCall2(st.b, loopTy, loopFn, arrayCPtr(noargs), 0U64, anon())
}

// Bind an async fn's params as resume-fn locals pointing at their frame fields
// (fields 3 .. 3+nparams-1), so the body reads/writes them through the frame and
// they survive suspensions. Mirrors bindOneParam's type/kind/enum-ref recovery.
fn bindAsyncParam(c: inout Comp, st: inout LlvmCtx, p: Param, fieldIdx: U64) {
    val slot: LLVMValueRef = asyncFrameSlot(c: inout c, st: inout st, idx: fieldIdx)
    mut val pty: LLVMTypeRef = asyncParamTy(c: inout c, st: inout st, p: p)
    mut val pElem: LLVMTypeRef = st.i64ty
    mut val pSidx: U64 = localStructIdxFor(c: inout c, st: inout st, start: p.tyStart, len: p.tyLen)
    mut val pRef: U64 = 0
    if p.tyIsArray {
        pElem = llvmScalarTy(c: inout c, st: inout st, tyStart: p.tyStart, tyLen: p.tyLen)
    } else {
        if isGenericInst(c: inout c, ref: p.ty) {
            pRef = p.ty
            val pgs: U64 = genStructSlot(c: inout c, st: inout st, ref: p.ty)
            if pgs < st.genStructRefs.count {
                pSidx = st.genStructDefs[pgs]
            }
        }
        if pRef == 0U64 {
            if enumRegSlot(c: inout c, st: inout st, start: p.tyStart, len: p.tyLen) < st.enumIdxs.count {
                pRef = simpleTypeRef(c: inout c, nameStart: p.tyStart, nameLen: p.tyLen)
            }
        }
    }
    pushLocalR(st: inout st, nameStart: p.nameStart, nameLen: p.nameLen, ptr: slot, ty: pty, kind: kindFromTySpan(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen), structIdx: pSidx, isArr: p.tyIsArray, elemTy: pElem, elemKind: 0U64, typeRef: pRef)
}

// Emit one async fn's entry + resume bodies.
fn genLlvmAsyncFunc(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    val slot: U64 = asyncSlotOf(st: inout st, fi: fi)
    if slot < st.asyncFnIdx.count {
    } else {
        return
    }
    val f: Func = c.funcs[fi]
    val frameTy: LLVMTypeRef = st.asyncFrameTy[slot]
    val resumeFn: LLVMValueRef = st.asyncResumeFn[slot]
    val isMain: Bool = nameIsMain(c: inout c, f: f)
    // ---- entry function ----
    mut val entryFn: LLVMValueRef = resumeFn
    if isMain {
        mut val noParams: Array[LLVMTypeRef] = []
        val mainTy: LLVMTypeRef = LLVMFunctionType(st.i32ty, arrayCPtr(noParams), 0U64, 0I32)
        entryFn = LLVMAddFunction(st.mod, cstr(s: "main"), mainTy)
    } else {
        entryFn = st.fnVal[userFnSlot(st: inout st, idx: fi)]
    }
    st.curFn = entryFn
    val entryBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, entryFn, cstr(s: "entry"))
    LLVMPositionBuilderAtEnd(st.b, entryBB)
    st.terminated = false
    // an `async fn main`: initialize module-level variables (spec/15) before the
    // first resume runs (so an init referencing a global, or main reading one, sees it).
    if isMain {
        callInitGlobals(c: inout c, st: inout st)
    }
    val frame: LLVMValueRef = asyncFrameAlloc(c: inout c, st: inout st, frameTy: frameTy)
    // __f->__state = 0
    LLVMBuildStore(st.b, LLVMConstInt(st.i32ty, 0U64, 0I32), LLVMBuildStructGEP2(st.b, frameTy, frame, 0U64, anon()))
    // copy params into frame fields 3..
    mut val pi: U64 = 0
    while pi < f.params.count {
        LLVMBuildStore(st.b, LLVMGetParam(entryFn, pi), LLVMBuildStructGEP2(st.b, frameTy, frame, 3U64 + pi, anon()))
        pi += 1
    }
    // __self = plew_promise_new(); __f->__self = __self (capture before resume — a
    // synchronously-completing resume frees the frame, so __f->__self would dangle).
    val self: LLVMValueRef = asyncPromiseNew(c: inout c, st: inout st)
    LLVMBuildStore(st.b, self, LLVMBuildStructGEP2(st.b, frameTy, frame, 1U64, anon()))
    mut val cargs: Array[LLVMValueRef] = []
    cargs.append(value: frame)
    mut val cty: Array[LLVMTypeRef] = []
    cty.append(value: st.ptrty)
    val resumeFnTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(cty), 1U64, 0I32)
    val ignore: LLVMValueRef = LLVMBuildCall2(st.b, resumeFnTy, resumeFn, arrayCPtr(cargs), 1U64, anon())
    if isMain {
        asyncLoopRun(c: inout c, st: inout st)
        LLVMBuildRet(st.b, LLVMConstInt(st.i32ty, 0U64, 0I32))
    } else {
        LLVMBuildRet(st.b, self)
    }
    // ---- resume function ----
    st.curFn = resumeFn
    st.curIsMain = false
    st.curRetVoid = true
    st.curAsync = true
    st.curFrameTy = frameTy
    st.curFrameBase = LLVMGetParam(resumeFn, 0U64)
    st.curResumeFn = resumeFn
    st.curAsyncState = 0
    val rEntry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, resumeFn, cstr(s: "entry"))
    val startBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, resumeFn, cstr(s: "async.start"))
    LLVMPositionBuilderAtEnd(st.b, rEntry)
    // precompute a GEP for every frame field in the entry block (dominates all
    // resume blocks), so a field read in a switch-reachable block has a dominating
    // pointer. Built before the switch so they dominate the default path too.
    st.asyncSlotPtrs = []
    val nfields: U64 = LLVMCountStructElementTypes(frameTy) as U64
    mut val fidx: U64 = 0
    while fidx < nfields {
        st.asyncSlotPtrs.append(value: LLVMBuildStructGEP2(st.b, frameTy, st.curFrameBase, fidx, anon()))
        fidx += 1
    }
    val state: LLVMValueRef = LLVMBuildLoad2(st.b, st.i32ty, st.asyncSlotPtrs[0], anon())
    st.curAsyncSwitch = LLVMBuildSwitch(st.b, state, startBB, 8U32)
    LLVMPositionBuilderAtEnd(st.b, startBB)
    st.terminated = false
    // fresh locals: params bound to frame fields 3..; lets/binds get fields after.
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    // module-level variables (spec/15): seed them as locals (pointing at the true
    // LLVM globals, not frame slots) before async params bind to frame fields.
    seedGlobals(c: inout c, st: inout st)
    mut val qi: U64 = 0
    while qi < f.params.count {
        bindAsyncParam(c: inout c, st: inout st, p: f.params[qi], fieldIdx: 3U64 + qi)
        qi += 1
    }
    st.asyncFieldNext = 3U64 + f.params.count
    genLlvmBlock(c: inout c, st: inout st, id: f.body)
    // fall-through end: a value-less async resolves with 0.
    if st.terminated {
    } else {
        asyncResolveAndReturn(c: inout c, st: inout st, value: LLVMConstInt(st.i64ty, 0U64, 0I32))
    }
    st.curAsync = false
}

// Emit entry + resume bodies for every async fn (after declareAsyncFns).
fn emitAsyncFns(c: inout Comp, st: inout LlvmCtx) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        if isAsyncFn(c: inout c, fi: fi) {
            genLlvmAsyncFunc(c: inout c, st: inout st, fi: fi)
        }
        fi += 1
    }
}

// ---- companion C runtime ----
//
// `plewc-llvm --runtime` emits the small C runtime the generated IR links
// against (the `plew_*` symbols the emitter declares). Scalar/pointer signatures
// only — no struct-by-value — so the IR can pass String as (i8* data, i64 len)
// without modeling the C struct ABI. Grows as the backend covers more.
// One overflow-checked binary (`Add`/`Sub`/`Mul`) for width-prefix `p`/C-type
// `ct`, using the clang builtin `bi` (mirrors the C backend's wNumChecked but with
// external linkage and plew_panic_raw).
fn wOvf(p: String, ct: String, name: String, bi: String) {
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: name)
    write(s: "(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ ")
    write(s: ct)
    write(s: " r; if(")
    write(s: bi)
    write(s: "(a,b,&r)) plew_panic_raw(\"integer overflow\",16); return r; }\n")
}

// The checked integer helpers for one width-prefix `p` / C-type `ct` (signed min
// `mn`, `sgn` = signed). Add/Sub/Mul overflow-panic, Div/Rem div-by-zero-panic
// (+ signed INT_MIN/-1 overflow), and signed widths also get a checked Neg.
fn wLlvmChecked(p: String, ct: String, mn: String, sgn: Bool) {
    wOvf(p: p, ct: ct, name: "Add", bi: "__builtin_add_overflow")
    wOvf(p: p, ct: ct, name: "Sub", bi: "__builtin_sub_overflow")
    wOvf(p: p, ct: ct, name: "Mul", bi: "__builtin_mul_overflow")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "Div(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ if(b==0) plew_panic_raw(\"division by zero\",16); ")
    if sgn {
        write(s: "if(b==-1 && a==")
        write(s: mn)
        write(s: ") plew_panic_raw(\"integer overflow\",16); ")
    }
    write(s: "return a/b; }\n")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "Rem(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b){ if(b==0) plew_panic_raw(\"remainder by zero\",17); ")
    if sgn {
        write(s: "if(b==-1) return 0; ")
    }
    write(s: "return a%b; }\n")
    if sgn {
        write(s: ct)
        write(s: " plew_")
        write(s: p)
        write(s: "Neg(")
        write(s: ct)
        write(s: " a){ ")
        write(s: ct)
        write(s: " r; if(__builtin_sub_overflow((")
        write(s: ct)
        write(s: ")0,a,&r)) plew_panic_raw(\"integer overflow\",16); return r; }\n")
    }
}

// All width-prefixed checked integer helpers (i8..i64 signed, u8..u64 unsigned).
fn emitLlvmIntChecked() {
    wLlvmChecked(p: "i8", ct: "int8_t", mn: "INT8_MIN", sgn: true)
    wLlvmChecked(p: "i16", ct: "int16_t", mn: "INT16_MIN", sgn: true)
    wLlvmChecked(p: "i32", ct: "int32_t", mn: "INT32_MIN", sgn: true)
    wLlvmChecked(p: "i64", ct: "int64_t", mn: "INT64_MIN", sgn: true)
    wLlvmChecked(p: "u8", ct: "unsigned char", mn: "", sgn: false)
    wLlvmChecked(p: "u16", ct: "uint16_t", mn: "", sgn: false)
    wLlvmChecked(p: "u32", ct: "uint32_t", mn: "", sgn: false)
    wLlvmChecked(p: "u64", ct: "uint64_t", mn: "", sgn: false)
}

fn emitLlvmRuntime() {
    write(s: "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n")
    write(s: "void plew_exit(long long code){ exit((int)code); }\n")
    write(s: "void plew_write_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); }\n")
    write(s: "void plew_eprint_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stderr); }\n")
    write(s: "__attribute__((noreturn)) void plew_panic_raw(const char* d, long long n){ fputs(\"panic: \",stderr); fwrite(d,1,(size_t)n,stderr); fputc('\\n',stderr); exit(1); }\n")
    // print(x) formatters (textual form + newline), matching the Plew Format impls.
    write(s: "void plew_print_str(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); fputc('\\n',stdout); }\n")
    write(s: "void plew_print_i64(long long v){ printf(\"%lld\\n\", v); }\n")
    write(s: "void plew_print_f64(double v){ printf(\"%g\\n\", v); }\n")
    write(s: "void plew_print_u64(unsigned long long v){ printf(\"%llu\\n\", v); }\n")
    write(s: "void plew_print_bool(long long v){ fputs(v?\"1\":\"0\",stdout); fputc('\\n',stdout); }\n")
    write(s: "long long plew_str_eq(const char* a, long long na, const char* b, long long nb){ if(na!=nb) return 0; for(long long i=0;i<na;i++) if(a[i]!=b[i]) return 0; return 1; }\n")
    // read all of stdin into a String ({ i8* data, i64 len }), matching the C runtime.
    write(s: "typedef struct { char* d; long long n; } PlewStrR;\n")
    write(s: "PlewStrR plew_f64_to_str(double v){ char* buf=(char*)malloc(32); int n=snprintf(buf,32,\"%g\",v); PlewStrR s; s.d=buf; s.n=(long long)n; return s; }\n")
    write(s: "void plew_f64_nan_check(double a, double b){ if(a!=a || b!=b) plew_panic_raw(\"NaN comparison\",14); }\n")
    write(s: "PlewStrR plew_readStdin(void){ size_t cap=4096,len=0; char* buf=(char*)malloc(cap); int ch; while((ch=getchar())!=EOF){ if(len+1>=cap){cap*=2;buf=(char*)realloc(buf,cap);} buf[len++]=(char)ch; } PlewStrR s; s.d=buf; s.n=(long long)len; return s; }\n")
    // FFI String <-> C-string (spec/15): cString materializes a NUL-terminated copy
    // (owned by C until freed); stringFromCString copies a NUL-terminated C string.
    write(s: "unsigned char* plew_cString(char* d, long long n){ unsigned char* b=(unsigned char*)malloc((size_t)n+1); if(n) memcpy(b,d,(size_t)n); b[n]=0; return b; }\n")
    write(s: "PlewStrR plew_stringFromCString(unsigned char* p){ PlewStrR s; if(!p){ s.d=(char*)\"\"; s.n=0; return s; } size_t n=strlen((const char*)p); char* b=(char*)malloc(n+1); memcpy(b,p,n); b[n]=0; s.d=b; s.n=(long long)n; return s; }\n")
    // Array storage floor (a [cap][rc][data...] buffer; ARC/CoW not yet modeled —
    // copies share, no free; documented gap). alloc/cap/grow are element-size
    // generic; per-element load/store is inlined in IR via typed GEP.
    write(s: "void* plew_rawbuf_alloc(long long elemSize, long long cap){ long long* h=(long long*)malloc(2*sizeof(long long)+(size_t)(elemSize*cap)); h[0]=cap; h[1]=1; return (void*)(h+2); }\n")
    write(s: "long long plew_rawbuf_cap(void* p){ return p?((long long*)p)[-2]:0; }\n")
    write(s: "void* plew_arr_grow(void* data, long long elemSize, long long count){ long long cap=plew_rawbuf_cap(data); if(count<cap) return data; long long nc=cap<8?8:cap*2; void* nd=plew_rawbuf_alloc(elemSize,nc); if(count) memcpy(nd,data,(size_t)(elemSize*count)); return nd; }\n")
    write(s: "void* plew_arr_copy(void* data, long long elemSize, long long count){ void* nd=plew_rawbuf_alloc(elemSize,count<1?1:count); if(count) memcpy(nd,data,(size_t)(elemSize*count)); return nd; }\n")
    write(s: "void plew_rawbuf_retain(void* p){ if(p) ((long long*)p)[-1]++; }\n")
    write(s: "long long plew_rawbuf_release(void* p){ if(!p) return 0; return --((long long*)p)[-1]; }\n")
    write(s: "void plew_bounds(long long i, long long n){ if(i<0||i>=n){ fputs(\"panic: index out of bounds\\n\",stderr); exit(1); } }\n")
    // checked integer arithmetic floor (overflow / divide-by-zero panic, spec/12):
    // the witness/compound paths call `plew_<w><Op>` instead of a raw IR op, so the
    // LLVM backend matches the C backend's loud overflow/div-zero behaviour.
    emitLlvmIntChecked()
    // ---- process args + file I/O (the path-taking intrinsics take (ptr,i64), so
    // no struct-by-value ABI is assumed; readers return PlewStrR {ptr,i64}). ----
    write(s: "static int plew_argc = 0; static char** plew_argv = 0;\n")
    write(s: "void plew_set_args(int argc, char** argv){ plew_argc = argc; plew_argv = argv; }\n")
    write(s: "long long plew_argCount(void){ return (long long)plew_argc; }\n")
    write(s: "PlewStrR plew_argAt(long long i){ PlewStrR s; if(i<0||i>=plew_argc){ s.d=(char*)\"\"; s.n=0; return s; } s.d=plew_argv[i]; s.n=(long long)strlen(plew_argv[i]); return s; }\n")
    write(s: "void plew_writeByte(unsigned char b){ putchar((int)b); }\n")
    write(s: "unsigned long long plew_random_u64(void){ unsigned long long x=0; FILE* f=fopen(\"/dev/urandom\",\"rb\"); if(f){ size_t r=fread(&x,sizeof(x),1,f); fclose(f); if(r==1) return x; } return ((unsigned long long)(uintptr_t)&x * 0x9E3779B97F4A7C15ULL) | 1ULL; }\n")
    write(s: "unsigned long long plew_dict_seed(void){ static unsigned long long s=0; static int init=0; if(!init){ s=plew_random_u64(); init=1; } return s; }\n")
    write(s: "static PlewStrR plew_readPath(const char* path){ FILE* f=fopen(path,\"rb\"); PlewStrR s; if(!f){ s.d=(char*)\"\"; s.n=0; return s; } fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char* buf=(char*)malloc((size_t)sz+1); size_t n=fread(buf,1,(size_t)sz,f); fclose(f); buf[n]=0; s.d=buf; s.n=(long long)n; return s; }\n")
    write(s: "PlewStrR plew_readFile(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; PlewStrR r=plew_readPath(p); free(p); return r; }\n")
    write(s: "PlewStrR plew_readFileBytes(char* d, long long n){ return plew_readFile(d,n); }\n")
    write(s: "long long plew_fileExists(char* d, long long n){ char* p=(char*)malloc((size_t)n+1); if(n) memcpy(p,d,(size_t)n); p[n]=0; FILE* f=fopen(p,\"rb\"); free(p); if(f){ fclose(f); return 1; } return 0; }\n")
    // ---- async runtime (event loop / promises / timers) ----
    //
    // The SAME runtime as the C backend (Codegen/Async.pw), but the symbols the IR
    // calls (promise_new / promise_resolve / sleep / loop_run / frame_alloc /
    // frame_free) have EXTERNAL linkage — the IR is a separate translation unit, so
    // `static` (file-local, as in the single-TU C backend) would leave them
    // unresolved at link time. The queues/timers and their helpers stay file-local.
    // PlewPromise's layout matches the IR's { i32 done, i64 value, ptr k, ptr kframe }.
    write(s: "typedef struct PlewPromise PlewPromise;\n")
    write(s: "typedef void (*PlewResumeFn)(void*);\n")
    write(s: "struct PlewPromise { int done; long long value; PlewResumeFn k; void* kframe; };\n")
    write(s: "typedef struct { PlewResumeFn fn; void* arg; } PlewTask;\n")
    write(s: "static PlewTask* plew_ready = 0; static long long plew_ready_len = 0, plew_ready_cap = 0, plew_ready_head = 0;\n")
    write(s: "static void plew_enqueue(PlewResumeFn fn, void* arg) { if (plew_ready_len == plew_ready_cap) { plew_ready_cap = plew_ready_cap ? plew_ready_cap * 2 : 16; plew_ready = (PlewTask*)realloc(plew_ready, (size_t)plew_ready_cap * sizeof(PlewTask)); } plew_ready[plew_ready_len].fn = fn; plew_ready[plew_ready_len].arg = arg; plew_ready_len++; }\n")
    write(s: "static int plew_dequeue(PlewTask* out) { if (plew_ready_head >= plew_ready_len) { plew_ready_head = 0; plew_ready_len = 0; return 0; } *out = plew_ready[plew_ready_head++]; return 1; }\n")
    write(s: "typedef struct { long long deadline; PlewPromise* p; } PlewTimer;\n")
    write(s: "static PlewTimer* plew_timers = 0; static long long plew_timers_len = 0, plew_timers_cap = 0; static long long plew_vnow = 0;\n")
    write(s: "void* plew_frame_alloc(long long sz) { return malloc((size_t)sz); }\n")
    write(s: "void plew_frame_free(void* p) { free(p); }\n")
    write(s: "PlewPromise* plew_promise_new(void) { PlewPromise* p = (PlewPromise*)malloc(sizeof(PlewPromise)); p->done = 0; p->value = 0; p->k = 0; p->kframe = 0; return p; }\n")
    write(s: "void plew_promise_resolve(PlewPromise* p, long long v) { p->done = 1; p->value = v; if (p->k) { PlewResumeFn k = p->k; void* f = p->kframe; p->k = 0; plew_enqueue(k, f); } }\n")
    write(s: "static void plew_timer_add(long long delay, PlewPromise* p) { if (plew_timers_len == plew_timers_cap) { plew_timers_cap = plew_timers_cap ? plew_timers_cap * 2 : 8; plew_timers = (PlewTimer*)realloc(plew_timers, (size_t)plew_timers_cap * sizeof(PlewTimer)); } plew_timers[plew_timers_len].deadline = plew_vnow + delay; plew_timers[plew_timers_len].p = p; plew_timers_len++; }\n")
    write(s: "PlewPromise* plew_sleep(long long ms) { PlewPromise* p = plew_promise_new(); plew_timer_add(ms, p); return p; }\n")
    write(s: "void plew_loop_run(void) { PlewTask t; while (1) { while (plew_dequeue(&t)) { t.fn(t.arg); } if (plew_timers_len == 0) break; long long bi = -1, bd = 0; for (long long i = 0; i < plew_timers_len; i++) { if (bi < 0 || plew_timers[i].deadline < bd) { bi = i; bd = plew_timers[i].deadline; } } PlewPromise* p = plew_timers[bi].p; plew_vnow = plew_timers[bi].deadline; plew_timers[bi] = plew_timers[--plew_timers_len]; plew_promise_resolve(p, 0); } }\n")
}
