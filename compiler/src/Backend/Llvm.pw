                    // element pointer + store (the buffer is shared; no CoW yet).
                    // A user IndexSet-impl subscript desugars `g[i] = v` to
                    // `g.indexSet(key: i, value: v)` via the IndexSet witness (the
                    // compound form `g[i] OP= v` desugars `v` to `g[i] OP v` first).
                    if exprIsArray(c: inout c, st: inout st, id: ibase) {
                    } else {
                        val ibsi: U64 = exprStructIdx(c: inout c, st: inout st, id: ibase)
                        if ibsi < c.structs.count {
                            // a Dictionary `d[k] = v` lowers to `d.insert(key:, value:)`.
                            if rangeEquals(bytes: c.bytes, start: c.structs[ibsi].nameStart, len: c.structs[ibsi].nameLen, kw: "Dictionary") {
                                // `d[k] = v` -> d.insert(key: k, value: v). A compound
                                // `d[k] OP= v` first builds the new value `d[k] OP v` (the
                                // missing-key read panics, like a bare `d[k]`), then inserts.
                                mut val insVal: U64 = value
                                if op == opAssign() {
                                } else {
                                    val getExpr: U64 = c.pushExpr(e: <Expr.Index base=ibase index=iindex />)
                                    insVal = c.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=getExpr rhs=value />)
                                }
                                val m: U64 = synthDictMethod(c: inout c, recv: ibase, name: "insert", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: insVal)
                                genLlvmExpr(c: inout c, st: inout st, id: m)
                                return
                            }
                            if typeHasMethodNamed(c: inout c, typeStart: c.structs[ibsi].nameStart, typeLen: c.structs[ibsi].nameLen, name: "indexSet") {
                                mut val rhsExpr: U64 = value
                                if op == opAssign() {
                                } else {
                                    val getExpr: U64 = c.pushExpr(e: <Expr.Index base=ibase index=iindex />)
                                    rhsExpr = c.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=getExpr rhs=value />)
                                }
                                val m: U64 = synthDictMethod(c: inout c, recv: ibase, name: "indexSet", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: rhsExpr)
                                genLlvmExpr(c: inout c, st: inout st, id: m)
                                return
                            }
                        }
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: ibase)), msg: "LLVM backend: user IndexSet subscript needs an `indexSet` method")
                        return
                    }
                    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: ibase)
                    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: ibase)
                    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
                    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
                    val idx: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iindex)
                    emitBoundsCheck(c: inout c, st: inout st, idx: idx, count: count)
                    val ep: LLVMValueRef = arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: idx)
                    val rv: LLVMValueRef = coerceElem(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), elemTy: elemTy)
                    if op == opAssign() {
                        LLVMBuildStore(st.b, rv, ep)
                    } else {
                        val cur: LLVMValueRef = LLVMBuildLoad2(st.b, elemTy, ep, anon())
                        LLVMBuildStore(st.b, buildBinOpChecked(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: valueKind(c: inout c, st: inout st, id: target) == 3U64), ep)
                    }
                }
                Expr.Field(base: val fbase, nameStart: val fnameStart, nameLen: val fnameLen) => {
                    // place mutation `base.field = v`: GEP into the base local's
                    // alloca + store (base must be an addressable struct local).
                    match c.exprs[fbase] {
                        Expr.Ident(start: val bs, len: val bl) => {
                            val li: U64 = findLocal(c: inout c, st: inout st, start: bs, len: bl)
                            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: fbase)
                            if li < st.nLocals && sidx < c.structs.count {
                                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: fnameStart, len: fnameLen)
                                if fidx < c.structs[sidx].fields.count {
                                    val fld: FieldDef = c.structs[sidx].fields[fidx]
                                    val gep: LLVMValueRef = LLVMBuildStructGEP2(st.b, st.locTy[li], st.locPtr[li], fidx, anon())
                                    // a boxed (recursive) field (`a.next = <Optional.None/>`):
                                    // build the value (its type is the expected type, so a
                                    // bare construction infers its args), heap-allocate a
                                    // FRESH cell, and repoint the field — value semantics
                                    // (a copy that still points at the old cell is unchanged).
                                    if op == opAssign() {
                                        if fieldIsBoxed(c: inout c, f: fld) {
                                            st.expectedTy = fld.ty
                                            val bv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: value)
                                            st.expectedTy = 0U64
                                            val cell: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(LLVMTypeOf(bv)), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
                                            LLVMBuildStore(st.b, bv, cell)
                                            LLVMBuildStore(st.b, cell, gep)
                                            return
                                        }
                                        val gfr: U64 = fieldGenInstRef(c: inout c, fld: fld)
                                        if gfr != 0U64 {
                                            st.expectedTy = gfr
                                            val gv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: value)
                                            st.expectedTy = 0U64
                                            LLVMBuildStore(st.b, gv, gep)
                                            return
                                        }
                                    }
                                    val rv: LLVMValueRef = coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                    if op == opAssign() {
                                        LLVMBuildStore(st.b, rv, gep)
                                    } else {
                                        val ftype: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                        val cur: LLVMValueRef = LLVMBuildLoad2(st.b, ftype, gep, anon())
                                        LLVMBuildStore(st.b, buildBinOpChecked(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen)), gep)
                                    }
                                    return
                                }
                            }
                            compileErrorAt(line: lineOf(c: inout c, offset: fnameStart), msg: "LLVM backend: field assignment only on a registered struct local (so far)")
                        }
                        _ => {
                            // a general place base (`arr[i].field = v`, get-modify-set):
                            // the base struct pointer via placePtrOf, then GEP the field.
                            val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: fbase)
                            mut val handled: Bool = false
                            if bsi < c.structs.count {
                                val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fnameStart, len: fnameLen)
                                if fidx < c.structs[bsi].fields.count {
                                    val baseTy: LLVMTypeRef = structLlvmTyOfExpr(c: inout c, st: inout st, structExpr: fbase, sidx: bsi)
                                    if LLVMIsNull(baseTy) == 0I32 {
                                        val fld: FieldDef = c.structs[bsi].fields[fidx]
                                        val basePtr: LLVMValueRef = placePtrOf(c: inout c, st: inout st, id: fbase)
                                        val gep: LLVMValueRef = LLVMBuildStructGEP2(st.b, baseTy, basePtr, fidx, anon())
                                        val gfr2: U64 = fieldGenInstRef(c: inout c, fld: fld)
                                        if op == opAssign() && gfr2 != 0U64 {
                                            st.expectedTy = gfr2
                                            val gv2: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: value)
                                            st.expectedTy = 0U64
                                            LLVMBuildStore(st.b, gv2, gep)
                                            return
                                        }
                                        val rv: LLVMValueRef = coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                        if op == opAssign() {
                                            LLVMBuildStore(st.b, rv, gep)
                                        } else {
                                            val ftype: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                            val cur: LLVMValueRef = LLVMBuildLoad2(st.b, ftype, gep, anon())
                                            LLVMBuildStore(st.b, buildBinOpChecked(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv, unsigned: isUnsignedName(c: inout c, start: fld.tyStart, len: fld.tyLen)), gep)
                                        }
                                        handled = true
                                    }
                                }
                            }
                            if handled {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "LLVM backend: nested place assignment not yet supported")
                            }
                        }
                    }
                }
