                if exprIsAwaitLL(c: inout c, id: expr) {
                    match c.exprs[expr] {
                        Expr.Await(val operand) => {
                            emitLlvmAsyncSuspend(c: inout c, st: inout st, operandId: operand)
                        }
                        _ => {}
                    }
                    return
                }
