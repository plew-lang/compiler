// Part of the LLVM-backend root (_llvm.pw). The second backend: walk the same
// analyzed arena the C backend (emitC) does, but build a real LLVM module in
// process through libLLVM-C (spec/15 FFI) instead of emitting C text. This part
// is parted ONLY by _llvm.pw, so the C-backend binary (compiler/plewc) never
// references libLLVM (its clang-only bootstrap is preserved); the libLLVM-linked
// binary (compiler/plewc-llvm) is built on demand by compiler/plewc.
//
// Bring-up strategy: construct the module with the real API (the transferable
// 90% — SSA / basic-blocks / CFG), and for now emit it as text via
// LLVMPrintModuleToString -> stdout, linked against a small C runtime emitted by
// `plewc-llvm --runtime` (PlewString / plew_* are ABI-identical to the C backend).
//
// COVERAGE: the entry module's `main` + plain free functions (params, returns,
// recursion, default args, lexical scope/shadowing); width-accurate integers
// (i8/i16/i32/i64 with sext/zext/trunc coercion at typed sinks — literal width
// from the suffix or the checker's exprIntCtx; overflow-panic still TODO); the
// full operator set (arithmetic / bitwise / shift / unary / comparison; >> is
// arithmetic, a logical-shift-on-unsigned TODO); Bool; String (value `{ptr,i64}`,
// literals, ==/!=); `if`/`while`; and the intrinsics exit / write / eprint /
// print / panic (print dispatches by the arg's type-kind to a runtime formatter).
// A per-local type-kind tag (int/String/Bool/uint) drives String-vs-int and
// signed-vs-unsigned decisions without c.locals (which the backend doesn't
// populate). NOT yet: structs/enums, arrays, generics, methods, closures, async,
// ARC, multi-module user code (only module 0 is emitted). Anything unsupported is
// rejected loudly (no silent miscompile — acceptance soundness).

// ---- libLLVM-C bindings (raw FFI floor; positional, no labels) ----
//
// Opaque handles are void* ABI-identical to the real LLVM `…Opaque *` typedefs,
// so no <llvm-c/*.h> include is needed — the compiler self-emits the prototypes.
extern(c) {
    type LLVMContextRef
    type LLVMModuleRef
    type LLVMTypeRef
    type LLVMValueRef
    type LLVMBasicBlockRef
    type LLVMBuilderRef

    // Context / module.
    fn LLVMContextCreate() -> LLVMContextRef
    fn LLVMModuleCreateWithNameInContext(name~: CPtr[U8], ctx~: LLVMContextRef) -> LLVMModuleRef
    fn LLVMPrintModuleToString(m~: LLVMModuleRef) -> CPtr[U8]
    fn LLVMDisposeMessage(msg~: CPtr[U8])

    // Types.
    fn LLVMInt1TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt8TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt16TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt32TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMInt64TypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMVoidTypeInContext(ctx~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMPointerTypeInContext(ctx~: LLVMContextRef, addrSpace~: U32) -> LLVMTypeRef
    fn LLVMStructTypeInContext(ctx~: LLVMContextRef, elemTypes~: CPtr[LLVMTypeRef], count~: U32, packed~: I32) -> LLVMTypeRef
    fn LLVMStructCreateNamed(ctx~: LLVMContextRef, name~: CPtr[U8]) -> LLVMTypeRef
    fn LLVMStructSetBody(structTy~: LLVMTypeRef, elemTypes~: CPtr[LLVMTypeRef], count~: U64, packed~: I32)
    fn LLVMArrayType2(elemTy~: LLVMTypeRef, count~: U64) -> LLVMTypeRef
    fn LLVMBuildStructGEP2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, idx~: U64, name~: CPtr[U8]) -> LLVMValueRef
    // count is the C API's `unsigned`; declared U64 here because Plew has no
    // narrowing `as` yet (an Array.count is U64). Safe on LP64 (arm64/x86-64):
    // the callee reads the low 32 bits, and our counts are tiny. Revisit once
    // integer narrowing (wrapping / TryFrom) lands.
    fn LLVMFunctionType(ret~: LLVMTypeRef, params~: CPtr[LLVMTypeRef], count~: U64, isVarArg~: I32) -> LLVMTypeRef

    // Functions / basic blocks / params.
    fn LLVMAddFunction(m~: LLVMModuleRef, name~: CPtr[U8], fnTy~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMGetParam(func~: LLVMValueRef, index~: U64) -> LLVMValueRef
    fn LLVMAppendBasicBlockInContext(ctx~: LLVMContextRef, func~: LLVMValueRef, name~: CPtr[U8]) -> LLVMBasicBlockRef

    // Constants / introspection.
    fn LLVMConstInt(ty~: LLVMTypeRef, n~: U64, signExtend~: I32) -> LLVMValueRef
    fn LLVMConstNull(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMIsNull(v~: LLVMValueRef) -> I32
    fn LLVMSizeOf(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMBuildGEP2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, indices~: CPtr[LLVMValueRef], numIndices~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMTypeOf(v~: LLVMValueRef) -> LLVMTypeRef
    fn LLVMGetIntTypeWidth(ty~: LLVMTypeRef) -> U32
    fn LLVMGetTypeKind(ty~: LLVMTypeRef) -> U32

    // Builder + instructions.
    fn LLVMCreateBuilderInContext(ctx~: LLVMContextRef) -> LLVMBuilderRef
    fn LLVMPositionBuilderAtEnd(b~: LLVMBuilderRef, bb~: LLVMBasicBlockRef)
    fn LLVMGetInsertBlock(b~: LLVMBuilderRef) -> LLVMBasicBlockRef
    fn LLVMBuildRet(b~: LLVMBuilderRef, v~: LLVMValueRef) -> LLVMValueRef
    fn LLVMBuildRetVoid(b~: LLVMBuilderRef) -> LLVMValueRef
    fn LLVMBuildCall2(b~: LLVMBuilderRef, fnTy~: LLVMTypeRef, func~: LLVMValueRef, args~: CPtr[LLVMValueRef], numArgs~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAdd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSub(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildMul(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSRem(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildUDiv(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildURem(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildLShr(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildNeg(b~: LLVMBuilderRef, v~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildNot(b~: LLVMBuilderRef, v~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAnd(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildOr(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildXor(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildShl(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAShr(b~: LLVMBuilderRef, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildICmp(b~: LLVMBuilderRef, pred~: U32, lhs~: LLVMValueRef, rhs~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSelect(b~: LLVMBuilderRef, cond~: LLVMValueRef, thenV~: LLVMValueRef, elseV~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildZExt(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildSExt(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildTrunc(b~: LLVMBuilderRef, v~: LLVMValueRef, destTy~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildAlloca(b~: LLVMBuilderRef, ty~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildLoad2(b~: LLVMBuilderRef, ty~: LLVMTypeRef, ptr~: LLVMValueRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildStore(b~: LLVMBuilderRef, v~: LLVMValueRef, ptr~: LLVMValueRef) -> LLVMValueRef
    fn LLVMBuildBr(b~: LLVMBuilderRef, dest~: LLVMBasicBlockRef) -> LLVMValueRef
    fn LLVMBuildCondBr(b~: LLVMBuilderRef, cond~: LLVMValueRef, thenBB~: LLVMBasicBlockRef, elseBB~: LLVMBasicBlockRef) -> LLVMValueRef
    fn LLVMBuildUnreachable(b~: LLVMBuilderRef) -> LLVMValueRef
    fn LLVMBuildPhi(b~: LLVMBuilderRef, ty~: LLVMTypeRef, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMAddIncoming(phi~: LLVMValueRef, vals~: CPtr[LLVMValueRef], blocks~: CPtr[LLVMBasicBlockRef], count~: U64)

    // Aggregates / globals (String = {ptr, i64}).
    fn LLVMGetUndef(ty~: LLVMTypeRef) -> LLVMValueRef
    fn LLVMBuildInsertValue(b~: LLVMBuilderRef, agg~: LLVMValueRef, elt~: LLVMValueRef, index~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildExtractValue(b~: LLVMBuilderRef, agg~: LLVMValueRef, index~: U64, name~: CPtr[U8]) -> LLVMValueRef
    fn LLVMBuildGlobalStringPtr(b~: LLVMBuilderRef, str~: CPtr[U8], name~: CPtr[U8]) -> LLVMValueRef
}

// LLVMIntPredicate codes (from <llvm-c/Core.h>): integer compare predicates.
fn llvmIntEq() -> U32 { return 32U32 }
fn llvmIntNe() -> U32 { return 33U32 }
fn llvmIntSlt() -> U32 { return 40U32 }
fn llvmIntSle() -> U32 { return 41U32 }
fn llvmIntSgt() -> U32 { return 38U32 }
fn llvmIntSge() -> U32 { return 39U32 }
fn llvmIntUlt() -> U32 { return 36U32 }
fn llvmIntUle() -> U32 { return 37U32 }
fn llvmIntUgt() -> U32 { return 34U32 }
fn llvmIntUge() -> U32 { return 35U32 }

// ---- backend state (threaded inout through the emitters) ----
//
// Holds the LLVM context/module/builder, cached primitive types, the current
// function being emitted, and the local-variable environment (a stack of
// name-span -> alloca pointer + element type; searched from the end so a
// shadowing redeclaration wins). `terminated` tracks whether the current basic
// block already has a terminator, so we never append after a ret/br.
struct LlvmCtx {
    pub val ctx: LLVMContextRef
    pub val mod: LLVMModuleRef
    pub mut val b: LLVMBuilderRef
    pub val i1ty: LLVMTypeRef
    pub val i8ty: LLVMTypeRef
    pub val i16ty: LLVMTypeRef
    pub val i32ty: LLVMTypeRef
    pub val i64ty: LLVMTypeRef
    pub val voidty: LLVMTypeRef
    pub val ptrty: LLVMTypeRef
    // String value type: { i8* data, i64 len } (ABI-identical to C PlewString).
    pub val strty: LLVMTypeRef
    // Array value type: { ptr data, i64 count } (element behind the pointer).
    pub val arrayTy: LLVMTypeRef
    // Closure / function-value type: { ptr fn, ptr env } — a lambda-lifted function
    // pointer plus its captured-environment pointer (NULL for non-capturing). Every
    // `fn(...) -> ...` value is this fat pointer; the callee ABI takes env first.
    pub val closureTy: LLVMTypeRef
    pub mut val curFn: LLVMValueRef
    pub mut val terminated: Bool
    // the function currently being emitted: is it `main` (returns i32 0), and its
    // LLVM return type + whether it returns void (Plew `()`), so `return` and the
    // fall-through epilogue terminate with the right instruction.
    pub mut val curIsMain: Bool
    pub mut val curRetVoid: Bool
    pub mut val curRetTy: LLVMTypeRef
    pub mut val curRetTyStart: U64
    pub mut val curRetTyLen: U64
    // the value yielded by the innermost value-position block (a `give` statement
    // sets it; IfExpr reads it after emitting each branch block).
    pub mut val giveValue: LLVMValueRef
    // registered struct types (parallel: c.structs index -> named LLVM struct type).
    pub mut val structIdxs: Array[U64]
    pub mut val structTys: Array[LLVMTypeRef]
    // generic struct instances (parallel: TypeRef index -> LLVM type, generic def
    // index). A generic-typed local points locStructIdx at the def and locTypeRef
    // at the instance, so field access reuses the struct machinery + substitution.
    pub mut val genStructRefs: Array[U64]
    pub mut val genStructTys: Array[LLVMTypeRef]
    pub mut val genStructDefs: Array[U64]
    // registered enum types (parallel: c.enums index -> named LLVM type
    // `{ i64 tag, [maxWords x i64] payload }`).
    pub mut val enumIdxs: Array[U64]
    pub mut val enumTys: Array[LLVMTypeRef]
    // generic enum instances (parallel: TypeRef ref -> LLVM type, generic def idx).
    pub mut val genEnumRefs: Array[U64]
    pub mut val genEnumTys: Array[LLVMTypeRef]
    pub mut val genEnumDefs: Array[U64]
    // a byte span whose content is "self" (appended to c.bytes), to bind the
    // method receiver as a local that the body's `self` identifiers resolve to.
    pub mut val selfStart: U64
    pub mut val selfLen: U64
    // while emitting a generic method body, the receiver's instantiation TypeRef
    // (so `self`'s LLVM type / struct-or-enum env resolve to the instance). 0 when
    // emitting a free function or a non-generic method.
    pub mut val curRecvInstRef: U64
    // the expected type of the expression about to be emitted (a let annotation, a
    // boxed field's pointee type, …) — used to infer a JSX generic-enum/struct
    // construction whose own `ty` is the ungrounded head (`<Optional.Some v=42 />`
    // with no `[I64]`). Consumed (cleared to 0) by the construction that uses it so
    // it doesn't leak into sub-expressions. 0 when no expectation is in effect.
    pub mut val expectedTy: U64
    // the current function/closure's return TypeRef (0 = void / none), so a `return
    // <Optional.Some …/>` infers its type args from the declared return type.
    pub mut val curRetRef: U64
    // the local index of the current function's FIRST body local (= param count
    // incl. self), so scope-exit deinit drops skip params (borrows/inout self that
    // the caller still owns and will deinit).
    pub mut val curBodyMark: U64
    // declared user functions, cached by c.funcs index (parallel arrays), so a call
    // resolves to the same LLVMValueRef without name mangling (the symbol name is a
    // synthetic unique `pf<idx>`; only `main`/runtime symbols have meaningful names).
    pub mut val fnIdx: Array[U64]
    pub mut val fnVal: Array[LLVMValueRef]
    pub mut val fnTy: Array[LLVMTypeRef]
    // generic free-function instances (parallel: c.fnInsts index -> value, type).
    pub mut val genFnK: Array[U64]
    pub mut val genFnVal: Array[LLVMValueRef]
    pub mut val genFnTy: Array[LLVMTypeRef]
    // generic-method instances, one per (method func, receiver instantiation):
    // a method on a generic struct/enum (`box.get()`, `maybe.unwrapOr(...)`) is
    // monomorphized per receiver instance, keyed by (genMethK, genMethInst).
    pub mut val genMethK: Array[U64]
    pub mut val genMethInst: Array[U64]
    pub mut val genMethVal: Array[LLVMValueRef]
    pub mut val genMethTy: Array[LLVMTypeRef]
    // local environment (parallel arrays). `nLocals` is the logical count: blocks
    // save it on entry and restore it on exit (lexical scope), so a shadowing
    // binding inside a block leaves scope at the block's end and a later reference
    // resolves to the outer binding. push overwrites the slot at `nLocals` (or
    // appends), so the arrays may be longer than `nLocals` — only [0, nLocals) is live.
    pub mut val nLocals: U64
    pub mut val locStart: Array[U64]
    pub mut val locLen: Array[U64]
    pub mut val locPtr: Array[LLVMValueRef]
    pub mut val locTy: Array[LLVMTypeRef]
    // a small Plew-type-kind tag per local (0 int/signed, 1 String, 2 Bool, 3
    // unsigned int), so String ==/!= and print pick the right lowering without
    // c.locals (which the LLVM backend doesn't populate, so typeOf can't see locals).
    pub mut val locKind: Array[U64]
    // per-local owning struct index (c.structs.count = not a struct), so field
    // access x.field can resolve the layout from a struct-typed local.
    pub mut val locStructIdx: Array[U64]
    // per-local array element type + is-array flag (for arr[i] / .append / .count).
    pub mut val locIsArr: Array[Bool]
    pub mut val locElemTy: Array[LLVMTypeRef]
    pub mut val locElemKind: Array[U64]
    pub mut val locTypeRef: Array[U64]
    // per-array-local element struct index (c.structs.count = element is not a
    // struct), so `arr[i].field` on an array-of-struct LOCAL resolves the element.
    pub mut val locElemStructIdx: Array[U64]
    // per-array-local element TypeRef (0 = none), so `arr[i]` recovers the element's
    // instance — a Ref (`Array[Ref[Box]]` -> `ys[0]->v`) or a nested array.
    pub mut val locElemTypeRef: Array[U64]
    // per-local ownership for scope-exit deinit (spec/03): `locOwned` = this local's
    // value is owned here and must be deinit'd at scope exit (body locals + `move`
    // params + a `move fn` self; false for inout/borrow params / by-value-self
    // borrows the caller owns). `locMoved` = ownership was handed off (a `move`
    // arg / `move fn` receiver / `move x`), so it is NOT deinit'd here.
    pub mut val locOwned: Array[Bool]
    pub mut val locMoved: Array[Bool]
    // declared runtime/intrinsic functions, cached by name id (parallel arrays).
    pub mut val declId: Array[U64]
    pub mut val declFn: Array[LLVMValueRef]
    pub mut val declTy: Array[LLVMTypeRef]
    // associated functions reached (called) from emitted code — only these are
    // emitted, so derive-generated but uncalled witnesses (the LLVM backend lowers
    // Eq/Ord natively, bypassing them) aren't emitted into failing bodies.
    pub mut val reachAssoc: Array[U64]
    // lambda-lifted closures, cached by Closure-expr arena id (parallel arrays):
    // the emitted `__closure<id>` LLVM function value and its function type (env
    // pointer first param). A closure literal builds a {fn, env} value from these.
    pub mut val cloIdx: Array[U64]
    pub mut val cloVal: Array[LLVMValueRef]
    pub mut val cloTy: Array[LLVMTypeRef]
    // function-value thunks, cached by c.funcs index: a bare function reference
    // (`val g = twice`) becomes a closure {thunk, null}, where the thunk adapts the
    // plain function to the env-first closure ABI by forwarding its arguments.
    pub mut val thunkIdx: Array[U64]
    pub mut val thunkVal: Array[LLVMValueRef]
    pub mut val thunkTy: Array[LLVMTypeRef]
    // provided trait methods reached (called) during emission: declared lazily (so
    // an uncalled std-trait adapter method — map/filter, whose body constructs an
    // unsupported adapter — is never emitted), then their bodies drained after the
    // main pass (a body may reach further provided methods — fixpoint).
    pub mut val provEmit: Array[U64]
    // generic-method instances declared LAZILY on demand (a std/non-entry-module
    // generic method — Optional.unwrapOr, MapIter.next — reached by a call): the
    // genMeth* slot index is queued here and its body drained after the main pass,
    // looping until the queue stops growing (a body may reach further ones).
    pub mut val genMethEmit: Array[U64]
}

// A NUL-terminated C string from a Plew literal, for the many `const char*` name
// arguments LLVM builders take (cString leaks a small per-call buffer — fine for
// a one-shot compiler pass).
fn cstr(s: String) -> CPtr[U8] {
    return cString(s)
}

// Empty instruction name (LLVM auto-numbers unnamed values).
fn anon() -> CPtr[U8] {
    return cString("")
}

// ---- type mapping ----
//
// Map a Plew scalar type name span to an LLVM integer type. v1 recognizes the
// fixed-width integer lang-items and Bool; everything else falls back to i64
// (the C backend's `long long` default scalar). Width/signedness refinement and
// non-scalar types (String/struct/array) come in later increments.
fn llvmScalarTy(c: inout Comp, st: inout LlvmCtx, tyStart: U64, tyLen: U64) -> LLVMTypeRef {
    // generic substitution: a type-parameter name (T) in scope resolves to its
    // concrete argument (the monomorphization env curTypeParams -> curTypeArgs,
    // set while emitting a generic instance). No-op outside a generic context.
    if c.curTypeParams.count > 0U64 {
        val qid: U64 = intern(c: inout c, start: tyStart, len: tyLen)
        mut val ti: U64 = 0
        while ti < c.curTypeParams.count {
            if c.curTypeParams[ti].nameId == qid {
                // a type param bound to a generic instance (`I -> MapIter[Counter,…]`)
                // must resolve to that registered instance type — recursing on the
                // bare name would drop the args and miss it.
                val argRef: U64 = c.curTypeArgs[ti]
                if isGenericInst(c: inout c, ref: argRef) {
                    return llvmTypeOfRef(c: inout c, st: inout st, ref: argRef)
                }
                val at: TypeRef = c.types[argRef]
                // an array argument (`T -> Array[I32]`) is the {ptr,i64} value type.
                if rangeEquals(bytes: c.bytes, start: at.nameStart, len: at.nameLen, kw: "Array") {
                    return st.arrayTy
                }
                return llvmScalarTy(c: inout c, st: inout st, tyStart: at.nameStart, tyLen: at.nameLen)
            }
            ti += 1
        }
    }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "String") {
        return st.strty
    }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "Bool") {
        return st.i1ty
    }
    // a `Ref[T]` is a pointer to a heap cell holding the pointee (opaque ptr).
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "Ref") {
        return st.ptrty
    }
    // a function-value type `fn(...) -> ...` is the {fn, env} closure fat pointer.
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "fn") {
        return st.closureTy
    }
    // Width-accurate integers: I8/U8 -> i8, I16/U16 -> i16, I32/U32 -> i32, else
    // i64 (signedness is tracked separately as a kind, not in the LLVM type).
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "I8") { return st.i8ty }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "U8") { return st.i8ty }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "I16") { return st.i16ty }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "U16") { return st.i16ty }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "I32") { return st.i32ty }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "U32") { return st.i32ty }
    // a registered (all-primitive-field) user struct -> its named LLVM struct type.
    val reg: U64 = structRegSlot(c: inout c, st: inout st, start: tyStart, len: tyLen)
    if reg < st.structIdxs.count {
        return st.structTys[reg]
    }
    // a registered enum -> its named tagged-union type.
    val ereg: U64 = enumRegSlot(c: inout c, st: inout st, start: tyStart, len: tyLen)
    if ereg < st.enumIdxs.count {
        return st.enumTys[ereg]
    }
    return st.i64ty
}

// Index into st.struct* for a registered struct named (start,len), or
// st.structIdxs.count if the type is not a registered struct.
fn structRegSlot(c: inout Comp, st: inout LlvmCtx, start: U64, len: U64) -> U64 {
    val sidx: U64 = structIndexByName(c: inout c, start: start, len: len)
    if sidx < c.structs.count {
        mut val i: U64 = 0
        while i < st.structIdxs.count {
            if st.structIdxs[i] == sidx {
                return i
            }
            i += 1
        }
    }
    return st.structIdxs.count
}

// Whether a struct is registerable as a named LLVM value type in this increment:
// non-generic, non-extern, non-unique, and every field is either an array (the
// {ptr,i64} value type, element-agnostic), a primitive scalar/String/Bool, an
// extern lang-item struct field (I64/String/Bool), or a *nested registerable*
// struct (struct-of-struct). Enum fields and generic-instance fields are not yet
// modeled. Value types cannot be cyclic by value, so the recursion terminates.
fn structRegisterable(c: inout Comp, sidx: U64) -> Bool {
    val sd: StructDef = c.structs[sidx]
    if sd.typeParams.count > 0 { return false }
    if sd.isExtern { return false }
    // unique structs are now registerable (same field layout); their deinit runs at
    // scope-exit drop (emitted via the synthetic `deinit` method).
    mut val i: U64 = 0
    while i < sd.fields.count {
        val f: FieldDef = sd.fields[i]
        // a boxed (recursive) field is a heap pointer regardless of its pointee
        // type — always representable, and it breaks the recursion cycle (we don't
        // recurse into the pointee, so a mutually-recursive struct still terminates).
        if fieldIsBoxed(c: inout c, f: f) {
            i += 1
        } else {
            if f.tyIsArray {
            } else {
                // enum field: not yet.
                if isEnumName(c: inout c, start: f.tyStart, len: f.tyLen) {
                    return false
                }
                val fsi: U64 = structIndexByName(c: inout c, start: f.tyStart, len: f.tyLen)
                if fsi < c.structs.count {
                    // an extern struct field is a primitive lang-item (ok); a real nested
                    // struct must itself be registerable (recursively).
                    if c.structs[fsi].isExtern {
                    } else {
                        if structRegisterable(c: inout c, sidx: fsi) {
                        } else {
                            return false
                        }
                    }
                }
                // else: a primitive scalar name (I8.. / unknown) -> treated as a scalar.
            }
            i += 1
        }
    }
    return true
}

// Register every registerable struct as a named LLVM struct type. Two passes so a
// nested-struct field resolves to the (already-created) named type of the field's
// struct: pass 1 creates all the named types, pass 2 sets their bodies. Called once
// before function emission. (Ref / unique / generic / enum-field structs stay
// unregistered, so their construction/access is rejected, not miscompiled.)
fn registerStructs(c: inout Comp, st: inout LlvmCtx) {
    mut val i: U64 = 0
    while i < c.structs.count {
        if structRegisterable(c: inout c, sidx: i) {
            mut val nm: Array[U8] = []
            appendBytes(into: inout nm, from: "st".bytes)
            appendU64Dec(into: inout nm, n: i)
            nm.append(value: 0)
            st.structIdxs.append(value: i)
            st.structTys.append(value: LLVMStructCreateNamed(st.ctx, arrayCPtr(nm)))
        }
        i += 1
    }
    mut val s: U64 = 0
    while s < st.structIdxs.count {
        val sd: StructDef = c.structs[st.structIdxs[s]]
        mut val elems: Array[LLVMTypeRef] = []
        mut val fi: U64 = 0
        while fi < sd.fields.count {
            // a boxed (recursive) field is stored as a heap pointer.
            if fieldIsBoxed(c: inout c, f: sd.fields[fi]) {
                elems.append(value: st.ptrty)
            } else {
                elems.append(value: llvmTypeFor(c: inout c, st: inout st, tyStart: sd.fields[fi].tyStart, tyLen: sd.fields[fi].tyLen, isArray: sd.fields[fi].tyIsArray))
            }
            fi += 1
        }
        LLVMStructSetBody(st.structTys[s], arrayCPtr(elems), sd.fields.count, 0I32)
        s += 1
    }
}

// ---- enums (tagged unions) ----

// Index into st.enum* for a registered enum named (start,len), or st.enumIdxs.count.
fn enumRegSlot(c: inout Comp, st: inout LlvmCtx, start: U64, len: U64) -> U64 {
    val eid: U64 = enumIdxByName(c: inout c, start: start, len: len)
    if eid < c.enums.count {
        mut val i: U64 = 0
        while i < st.enumIdxs.count {
            if st.enumIdxs[i] == eid {
                return i
            }
            i += 1
        }
    }
    return st.enumIdxs.count
}

// The c.enums index of the enum named (start,len), or c.enums.count.
fn enumIdxByName(c: inout Comp, start: U64, len: U64) -> U64 {
    val q: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.enums.count {
        if c.enums[i].nameId == q {
            return i
        }
        i += 1
    }
    return c.enums.count
}

// How many i64 words a primitive field occupies in the enum payload area (String
// is {ptr,i64} = 2; scalar/Bool = 1; a registered struct = sum of its fields).
fn fieldWords(c: inout Comp, st: inout LlvmCtx, tyStart: U64, tyLen: U64) -> U64 {
    // substitute a type parameter via the active env (so a payload field of type T
    // is sized as its concrete argument).
    if c.curTypeParams.count > 0U64 {
        val qid: U64 = intern(c: inout c, start: tyStart, len: tyLen)
        mut val ti: U64 = 0
        while ti < c.curTypeParams.count {
            if c.curTypeParams[ti].nameId == qid {
                val at: TypeRef = c.types[c.curTypeArgs[ti]]
                // an array argument (`T -> Array[I32]`) is the {ptr,i64} value (2 words).
                if rangeEquals(bytes: c.bytes, start: at.nameStart, len: at.nameLen, kw: "Array") {
                    return 2U64
                }
                return fieldWords(c: inout c, st: inout st, tyStart: at.nameStart, tyLen: at.nameLen)
            }
            ti += 1
        }
    }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "String") {
        return 2U64
    }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "Array") {
        return 2U64
    }
    val sreg: U64 = structRegSlot(c: inout c, st: inout st, start: tyStart, len: tyLen)
    if sreg < st.structIdxs.count {
        val sd: StructDef = c.structs[st.structIdxs[sreg]]
        mut val w: U64 = 0
        mut val i: U64 = 0
        while i < sd.fields.count {
            w = w + fieldWordsF(c: inout c, st: inout st, f: sd.fields[i])
            i += 1
        }
        return w
    }
    return 1U64
}

// The payload-word count of an enum field, honoring boxing: a boxed (recursive)
// field is a single heap pointer (1 word); otherwise its type's natural size.
fn fieldWordsF(c: inout Comp, st: inout LlvmCtx, f: FieldDef) -> U64 {
    if fieldIsBoxed(c: inout c, f: f) {
        return 1U64
    }
    // an array field (declared `Array[E]`, tyStart naming the element) is the
    // {ptr,i64} value (2 words) — fieldWords reads the element span and would miss it.
    if f.tyIsArray {
        return 2U64
    }
    return fieldWords(c: inout c, st: inout st, tyStart: f.tyStart, tyLen: f.tyLen)
}

// Whether all variant fields of an enum are primitive (scalar/String/Bool/
// registered-struct, no array) — registerable here.
fn enumAllPrimitive(c: inout Comp, st: inout LlvmCtx, eid: U64) -> Bool {
    val e: EnumDef = c.enums[eid]
    mut val vi: U64 = 0
    while vi < e.variants.count {
        val fs: Array[FieldDef] = e.variants[vi].fields
        mut val fj: U64 = 0
        while fj < fs.count {
            // a boxed (recursive) field is stored as a heap pointer (1 word), so it
            // is always representable regardless of the pointee type — skip the
            // primitive checks for it.
            if fieldIsBoxed(c: inout c, f: fs[fj]) {
                fj += 1
            } else {
                if fs[fj].tyIsArray {
                    // an array field is the {ptr,i64} value (2 words) — representable
                    // in the word-based payload, like String. (Deep copy/release of
                    // its elements is ARC/CoW, deferred — leaky but observably correct.)
                    fj += 1
                } else {
                    val si: U64 = structIndexByName(c: inout c, start: fs[fj].tyStart, len: fs[fj].tyLen)
                    if si < c.structs.count {
                        if c.structs[si].isExtern {
                        } else {
                            if structRegSlot(c: inout c, st: inout st, start: fs[fj].tyStart, len: fs[fj].tyLen) < st.structIdxs.count {
                            } else {
                                return false
                            }
                        }
                    }
                    if isEnumName(c: inout c, start: fs[fj].tyStart, len: fs[fj].tyLen) {
                        return false
                    }
                    fj += 1
                }
            }
        }
        vi += 1
    }
    return true
}

// Register every non-generic, all-primitive-variant enum as a named LLVM type
// `{ i64 tag, [maxWords x i64] payload }`. Called after registerStructs.
fn registerEnums(c: inout Comp, st: inout LlvmCtx) {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.typeParams.count > 0 {
        } else {
            if enumAllPrimitive(c: inout c, st: inout st, eid: ei) {
                mut val maxWords: U64 = 0
                mut val vi: U64 = 0
                while vi < e.variants.count {
                    val fs: Array[FieldDef] = e.variants[vi].fields
                    mut val w: U64 = 0
                    mut val fj: U64 = 0
                    while fj < fs.count {
                        w = w + fieldWordsF(c: inout c, st: inout st, f: fs[fj])
                        fj += 1
                    }
                    if w > maxWords {
                        maxWords = w
                    }
                    vi += 1
                }
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "en".bytes)
                appendU64Dec(into: inout nm, n: ei)
                nm.append(value: 0)
                val ty: LLVMTypeRef = LLVMStructCreateNamed(st.ctx, arrayCPtr(nm))
                mut val elems: Array[LLVMTypeRef] = []
                elems.append(value: st.i64ty)
                elems.append(value: LLVMArrayType2(st.i64ty, maxWords))
                LLVMStructSetBody(ty, arrayCPtr(elems), 2U64, 0I32)
                st.enumIdxs.append(value: ei)
                st.enumTys.append(value: ty)
            }
        }
        ei += 1
    }
}

// The LLVM struct type of a variant's payload (its fields in declared order).
fn variantPayloadTy(c: inout Comp, st: inout LlvmCtx, eid: U64, vi: U64) -> LLVMTypeRef {
    val fs: Array[FieldDef] = c.enums[eid].variants[vi].fields
    mut val elems: Array[LLVMTypeRef] = []
    mut val i: U64 = 0
    while i < fs.count {
        // a boxed (recursive) field is a heap pointer; an array field is the {ptr,i64}
        // value type; otherwise its scalar type.
        if fieldIsBoxed(c: inout c, f: fs[i]) {
            elems.append(value: st.ptrty)
        } else {
            if arrayFieldElemRef(c: inout c, f: fs[i]) != 0U64 {
                elems.append(value: st.arrayTy)
            } else {
                elems.append(value: llvmScalarTy(c: inout c, st: inout st, tyStart: fs[i].tyStart, tyLen: fs[i].tyLen))
            }
        }
        i += 1
    }
    return LLVMStructTypeInContext(st.ctx, arrayCPtr(elems), elems.count, 0I32)
}

// Construct an enum value `<E.V f=e ... />`: alloca {tag,payload}, store the tag
// and (if any) the variant payload struct, then load the whole value.
fn genLlvmMakeEnum(c: inout Comp, st: inout LlvmCtx, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, ty: U64, fields: Array[MakeField]) -> LLVMValueRef {
    // a JSX construction without explicit type args (`<Optional.Some v=42 />`) has
    // an ungrounded head `ty`; fall back to the expected type from context (a let
    // annotation / boxed-field pointee) when it names this same generic enum. Consume
    // it so it can't leak into the payload sub-expressions.
    mut val ty: U64 = ty
    if isGenericInst(c: inout c, ref: ty) {
    } else {
        if st.expectedTy != 0U64 {
            if isGenericInst(c: inout c, ref: st.expectedTy) {
                val et: TypeRef = c.types[st.expectedTy]
                if spansEqual(c: inout c, aStart: et.nameStart, aLen: et.nameLen, bStart: typeStart, bLen: typeLen) {
                    ty = st.expectedTy
                }
            }
        }
    }
    st.expectedTy = 0U64
    // a generic enum instance (Optional[I64]): build under its substitution env.
    if isGenericInst(c: inout c, ref: ty) {
        val gslot: U64 = genEnumSlot(c: inout c, st: inout st, ref: ty)
        if gslot < st.genEnumRefs.count {
            val savedP: Array[Bind] = c.curTypeParams
            val savedA: Array[U64] = c.curTypeArgs
            // MERGE the enum's env onto the outer one (don't replace) so a payload
            // sub-expression referencing the enclosing method's type params still
            // grounds (e.g. `self.f` in MapIter.next's `<Optional.Some v=self.f(x:v)/>`).
            c.curTypeParams = concatParams(add: c.enums[st.genEnumDefs[gslot]].typeParams, base: savedP)
            c.curTypeArgs = concatArgs(add: c.types[ty].args, base: savedA)
            val v: LLVMValueRef = buildEnumValue(c: inout c, st: inout st, eid: st.genEnumDefs[gslot], ety: st.genEnumTys[gslot], typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, fields: fields)
            c.curTypeParams = savedP
            c.curTypeArgs = savedA
            return v
        }
    }
    val reg: U64 = enumRegSlot(c: inout c, st: inout st, start: typeStart, len: typeLen)
    if reg < st.enumIdxs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: typeStart), msg: "LLVM backend: construction of this enum not yet supported (generic / array-field enums are TODO)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    return buildEnumValue(c: inout c, st: inout st, eid: st.enumIdxs[reg], ety: st.enumTys[reg], typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, fields: fields)
}

// Build an enum value of LLVM type `ety` for def `eid`: store the tag + the
// variant payload struct (under the active substitution env).
fn buildEnumValue(c: inout Comp, st: inout LlvmCtx, eid: U64, ety: LLVMTypeRef, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, fields: Array[MakeField]) -> LLVMValueRef {
    val vi: U64 = variantIndex(c: inout c, enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen)
    val slot: LLVMValueRef = LLVMBuildAlloca(st.b, ety, anon())
    // zero the whole cell first (tag + payload) so unused payload words are
    // deterministic — a payload-less variant then has an all-zero payload, making
    // tag+word structural `==` well-defined.
    LLVMBuildStore(st.b, LLVMConstNull(ety), slot)
    LLVMBuildStore(st.b, LLVMConstInt(st.i64ty, vi, 0I32), LLVMBuildStructGEP2(st.b, ety, slot, 0U64, anon()))
    val fs: Array[FieldDef] = c.enums[eid].variants[vi].fields
    if fs.count > 0U64 {
        val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eid, vi: vi)
        mut val agg: LLVMValueRef = LLVMGetUndef(payloadTy)
        mut val fj: U64 = 0
        while fj < fs.count {
            mut val valExpr: U64 = 0
            mut val found: Bool = false
            mut val mi: U64 = 0
            while mi < fields.count {
                if spansEqual(c: inout c, aStart: fields[mi].nameStart, aLen: fields[mi].nameLen, bStart: fs[fj].nameStart, bLen: fs[fj].nameLen) {
                    valExpr = fields[mi].value
                    found = true
                    mi = fields.count
                } else {
                    mi += 1
                }
            }
            if found {
            } else {
                if fj < fields.count {
                    valExpr = fields[fj].value
                }
            }
            // a boxed (recursive) field: build the payload value, heap-allocate a
            // cell, store the value, and put the cell pointer in the payload. (No
            // refcount/free yet — leaky, but observably correct, like Ref.)
            if fieldIsBoxed(c: inout c, f: fs[fj]) {
                st.expectedTy = fs[fj].ty
                val boxedVal: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: valExpr)
                val boxedTy: LLVMTypeRef = LLVMTypeOf(boxedVal)
                val cell: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(boxedTy), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
                LLVMBuildStore(st.b, boxedVal, cell)
                agg = LLVMBuildInsertValue(st.b, agg, cell, fj, anon())
            } else {
                // a payload field of array type — declared `Array[E]` or a type param
                // grounding to one (`v: T` with T -> Array[I32]): an array-literal
                // value must be built with the field's concrete element type, not
                // i64-defaulted.
                val gfElem: U64 = arrayFieldElemRef(c: inout c, f: fs[fj])
                if gfElem != 0U64 {
                    match c.exprs[valExpr] {
                        Expr.Array(val elems) => {
                            agg = LLVMBuildInsertValue(st.b, agg, genLlvmArrayLit(c: inout c, st: inout st, elems: elems, elemTy: llvmTypeOfRef(c: inout c, st: inout st, ref: gfElem)), fj, anon())
                        }
                        _ => {
                            agg = LLVMBuildInsertValue(st.b, agg, genLlvmExpr(c: inout c, st: inout st, id: valExpr), fj, anon())
                        }
                    }
                } else {
                    val fv: LLVMValueRef = coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: valExpr), tyStart: fs[fj].tyStart, tyLen: fs[fj].tyLen)
                    agg = LLVMBuildInsertValue(st.b, agg, fv, fj, anon())
                }
            }
            fj += 1
        }
        LLVMBuildStore(st.b, agg, LLVMBuildStructGEP2(st.b, ety, slot, 1U64, anon()))
    }
    return LLVMBuildLoad2(st.b, ety, slot, anon())
}

// The element type ref of an array-typed field `fd` of a base value `base` (a
// struct expr), resolved under base's generic instance env — covers a field whose
// type is a param grounding to `Array[E]` (`Box[Array[I32]].v`). 0 if not array.
fn fieldArrayElemRefUnderBase(c: inout Comp, st: inout LlvmCtx, base: U64, fd: FieldDef) -> U64 {
    if fd.ty == 0U64 {
        return 0U64
    }
    // ground the field type under base's instance env (a direct `Array[Box[T]]`
    // grounds to `Array[Box[I64]]`; a type-param field `v: T` to `Array[I32]`).
    val baseRef: U64 = exprTypeRef(c: inout c, st: inout st, id: base)
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val didSet: Bool = setStructEnv(c: inout c, st: inout st, ref: baseRef)
    mut val g: U64 = fd.ty
    if c.curTypeParams.count > 0U64 {
        g = groundTypeRef(c: inout c, ref: fd.ty)
    }
    val gt: TypeRef = c.types[g]
    mut val r: U64 = 0U64
    if rangeEquals(bytes: c.bytes, start: gt.nameStart, len: gt.nameLen, kw: "Array") {
        if gt.args.count > 0U64 {
            r = gt.args[0]
        }
    }
    if didSet {
        c.curTypeParams = savedP
        c.curTypeArgs = savedA
    }
    return r
}

// If field `f` is of array type — declared `Array[E]`, or a type param that
// grounds (under the active env) to `Array[E]` — the element type ref E, else 0.
fn arrayFieldElemRef(c: inout Comp, f: FieldDef) -> U64 {
    if f.tyIsArray {
        if f.ty != 0U64 {
            val t: TypeRef = c.types[f.ty]
            if t.args.count > 0U64 {
                return t.args[0]
            }
        }
        return 0U64
    }
    if f.ty != 0U64 {
        if c.curTypeParams.count > 0U64 {
            val g: U64 = groundTypeRef(c: inout c, ref: f.ty)
            val gt: TypeRef = c.types[g]
            if rangeEquals(bytes: c.bytes, start: gt.nameStart, len: gt.nameLen, kw: "Array") {
                if gt.args.count > 0U64 {
                    return gt.args[0]
                }
            }
        }
    }
    return 0U64
}

// Build an enum value of LLVM type `ety` for def `eid`, variant `vi`, from
// already-computed LLVM payload values (vs. buildEnumValue which evaluates expr
// ids). Used by the `?.` / `try` desugar where the payload is an extracted SSA
// value. The payload value types must match the variant's payload struct.
fn buildEnumFromValues(c: inout Comp, st: inout LlvmCtx, eid: U64, ety: LLVMTypeRef, vi: U64, payloadVals: Array[LLVMValueRef]) -> LLVMValueRef {
    val slot: LLVMValueRef = LLVMBuildAlloca(st.b, ety, anon())
    LLVMBuildStore(st.b, LLVMConstNull(ety), slot)
    LLVMBuildStore(st.b, LLVMConstInt(st.i64ty, vi, 0I32), LLVMBuildStructGEP2(st.b, ety, slot, 0U64, anon()))
    if payloadVals.count > 0U64 {
        val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eid, vi: vi)
        mut val agg: LLVMValueRef = LLVMGetUndef(payloadTy)
        mut val j: U64 = 0
        while j < payloadVals.count {
            agg = LLVMBuildInsertValue(st.b, agg, payloadVals[j], j, anon())
            j += 1
        }
        LLVMBuildStore(st.b, agg, LLVMBuildStructGEP2(st.b, ety, slot, 1U64, anon()))
    }
    return LLVMBuildLoad2(st.b, ety, slot, anon())
}

// ---- generic struct instances ----

// Register each concrete generic-struct instantiation (from c.genInsts) as a named
// LLVM type with its type parameters substituted (env curTypeParams->curTypeArgs).
fn registerGenStructs(c: inout Comp, st: inout LlvmCtx) {
    // Pass A: create every instance's NAMED struct type (opaque, body unset) and
    // record its def. Two passes so a field of generic-instance type (an adapter
    // wrapping another adapter: FilterIter's inner = MapIter[…]) resolves to the
    // already-created named type regardless of registration order.
    mut val k: U64 = 0
    while k < c.genInsts.count {
        val ref: U64 = c.genInsts[k]
        if isGenericInst(c: inout c, ref: ref) {
            val t: TypeRef = c.types[ref]
            val defIdx: U64 = genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
            if defIdx < c.structs.count {
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "gs".bytes)
                appendU64Dec(into: inout nm, n: k)
                nm.append(value: 0)
                st.genStructRefs.append(value: ref)
                st.genStructTys.append(value: LLVMStructCreateNamed(st.ctx, arrayCPtr(nm)))
                st.genStructDefs.append(value: defIdx)
            }
        }
        k += 1
    }
    // Pass B: set each instance's body (field types under its substitution env; a
    // generic-instance field now resolves via llvmTypeFor -> llvmScalarTy ->
    // llvmTypeOfRef to the named type created in pass A).
    mut val s: U64 = 0
    while s < st.genStructRefs.count {
        val ref: U64 = st.genStructRefs[s]
        val sd: StructDef = c.structs[st.genStructDefs[s]]
        val savedP: Array[Bind] = c.curTypeParams
        val savedA: Array[U64] = c.curTypeArgs
        c.curTypeParams = sd.typeParams
        c.curTypeArgs = c.types[ref].args
        mut val elems: Array[LLVMTypeRef] = []
        mut val fi: U64 = 0
        while fi < sd.fields.count {
            elems.append(value: llvmTypeFor(c: inout c, st: inout st, tyStart: sd.fields[fi].tyStart, tyLen: sd.fields[fi].tyLen, isArray: sd.fields[fi].tyIsArray))
            fi += 1
        }
        LLVMStructSetBody(st.genStructTys[s], arrayCPtr(elems), sd.fields.count, 0I32)
        c.curTypeParams = savedP
        c.curTypeArgs = savedA
        s += 1
    }
}

// Index into st.genStruct* for the registered instance structurally equal to `ref`,
// or st.genStructRefs.count.
fn genStructSlot(c: inout Comp, st: inout LlvmCtx, ref: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.genStructRefs.count {
        if typeRefEq(c: inout c, a: st.genStructRefs[i], b: ref) {
            return i
        }
        i += 1
    }
    return st.genStructRefs.count
}

// Register each concrete generic-enum instantiation as a named tagged-union type
// `{ i64 tag, [maxWords(args) x i64] payload }` with type parameters substituted.
fn registerGenEnums(c: inout Comp, st: inout LlvmCtx) {
    mut val k: U64 = 0
    while k < c.genInsts.count {
        val ref: U64 = c.genInsts[k]
        if isGenericInst(c: inout c, ref: ref) {
            val t: TypeRef = c.types[ref]
            val defIdx: U64 = genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
            if defIdx < c.enums.count {
                val e: EnumDef = c.enums[defIdx]
                val savedP: Array[Bind] = c.curTypeParams
                val savedA: Array[U64] = c.curTypeArgs
                c.curTypeParams = e.typeParams
                c.curTypeArgs = t.args
                mut val maxWords: U64 = 0
                mut val vi: U64 = 0
                while vi < e.variants.count {
                    val fs: Array[FieldDef] = e.variants[vi].fields
                    mut val w: U64 = 0
                    mut val fj: U64 = 0
                    while fj < fs.count {
                        w = w + fieldWords(c: inout c, st: inout st, tyStart: fs[fj].tyStart, tyLen: fs[fj].tyLen)
                        fj += 1
                    }
                    if w > maxWords {
                        maxWords = w
                    }
                    vi += 1
                }
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "ge".bytes)
                appendU64Dec(into: inout nm, n: k)
                nm.append(value: 0)
                val ty: LLVMTypeRef = LLVMStructCreateNamed(st.ctx, arrayCPtr(nm))
                mut val elems: Array[LLVMTypeRef] = []
                elems.append(value: st.i64ty)
                elems.append(value: LLVMArrayType2(st.i64ty, maxWords))
                LLVMStructSetBody(ty, arrayCPtr(elems), 2U64, 0I32)
                c.curTypeParams = savedP
                c.curTypeArgs = savedA
                st.genEnumRefs.append(value: ref)
                st.genEnumTys.append(value: ty)
                st.genEnumDefs.append(value: defIdx)
            }
        }
        k += 1
    }
}

// The tracked TypeRef of an expression (an Ident local's locTypeRef, or a struct
// field whose declared type is a generic instance), or 0.
fn exprTypeRef(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locTypeRef[li]
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            // a field of generic-instance type (`node.next : Optional[Node]`): yield
            // the instance ref (grounded under any active env) so a match on the
            // field read recovers the enum's substitution env.
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    val fd: FieldDef = c.structs[sidx].fields[fidx]
                    // ground the field type under the BASE's instance env (so `bb.v`
                    // with bb: Box[Box[I32]] yields Box[I32]) AND any active env (a
                    // monomorphized adapter's `inner: I` -> MapIter[Counter,…]).
                    val baseRef: U64 = exprTypeRef(c: inout c, st: inout st, id: base)
                    val savedP: Array[Bind] = c.curTypeParams
                    val savedA: Array[U64] = c.curTypeArgs
                    val didSet: Bool = setStructEnv(c: inout c, st: inout st, ref: baseRef)
                    mut val g: U64 = fd.ty
                    if fd.ty != 0U64 {
                        if c.curTypeParams.count > 0U64 {
                            g = groundTypeRef(c: inout c, ref: fd.ty)
                        }
                    }
                    if didSet {
                        c.curTypeParams = savedP
                        c.curTypeArgs = savedA
                    }
                    if g != 0U64 {
                        if isGenericInst(c: inout c, ref: g) {
                            return g
                        }
                    }
                }
            }
        }
        Expr.Index(val base, index: _) => {
            // `arr[i]` : the array's element TypeRef (a Ref element `Array[Ref[Box]]`
            // -> `ys[i]->v`, a generic element, or a nested-array element).
            match c.exprs[base] {
                Expr.Ident(start: val bs, len: val bl) => {
                    val bli: U64 = findLocal(c: inout c, st: inout st, start: bs, len: bl)
                    if bli < st.nLocals {
                        return st.locElemTypeRef[bli]
                    }
                }
                Expr.Field(base: val fb, nameStart: val fns2, nameLen: val fnl2) => {
                    // an array struct field's element (`hc.items[0]` for
                    // items: Array[Ref[Cell]]): the field's grounded element ref.
                    val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: fb)
                    if bsi < c.structs.count {
                        val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns2, len: fnl2)
                        if fidx < c.structs[bsi].fields.count {
                            return fieldArrayElemRefUnderBase(c: inout c, st: inout st, base: fb, fd: c.structs[bsi].fields[fidx])
                        }
                    }
                }
                _ => {
                    // a nested index (`t[0][0]`): unwrap one Array level from the base
                    // array's element type ref.
                    val br: U64 = exprTypeRef(c: inout c, st: inout st, id: base)
                    if br != 0U64 {
                        val bt: TypeRef = c.types[br]
                        if rangeEquals(bytes: c.bytes, start: bt.nameStart, len: bt.nameLen, kw: "Array") {
                            if bt.args.count > 0U64 {
                                return bt.args[0]
                            }
                        }
                    }
                }
            }
        }
        Expr.OptChain(val base, val memberStart, val memberLen) => {
            // `base?.member : Optional[U]` — so a chained `a?.b?.c` types its inner.
            return optChainResultRefLL(c: inout c, st: inout st, base: base, memberStart: memberStart, memberLen: memberLen)
        }
        Expr.Method(val recv, val nameStart, val nameLen, args: _) => {
            // `xs.map(f)` / `xs.filter(p)` : the lazy adapter instance it produces,
            // so a `for v in xs.map(f).filter(p)` (and the chain) types its iterand.
            return adapterCallResultInst(c: inout c, st: inout st, recv: recv, nameStart: nameStart, nameLen: nameLen)
        }
        _ => {}
    }
    return 0U64
}

// The `Optional[U]` result-type ref of `base?.member`, resolved through the
// LLVM-side type tracker (exprTypeRef) rather than the typed-AST cache (typeOf,
// unpopulated in this backend). Returns 0 if base isn't a concrete Optional whose
// element struct has the named field.
fn optChainResultRefLL(c: inout Comp, st: inout LlvmCtx, base: U64, memberStart: U64, memberLen: U64) -> U64 {
    val baseRef: U64 = exprTypeRef(c: inout c, st: inout st, id: base)
    if baseRef == 0U64 { return 0U64 }
    if baseRef < c.types.count {
    } else {
        return 0U64
    }
    val bt: TypeRef = c.types[baseRef]
    if rangeEquals(bytes: c.bytes, start: bt.nameStart, len: bt.nameLen, kw: "Optional") {
    } else {
        return 0U64
    }
    if bt.args.count < 1U64 { return 0U64 }
    val tName: TypeRef = c.types[bt.args[0]]
    val tSidx: U64 = structIndexByName(c: inout c, start: tName.nameStart, len: tName.nameLen)
    if tSidx < c.structs.count {
    } else {
        return 0U64
    }
    val fidx: U64 = structFieldIndex(c: inout c, sidx: tSidx, start: memberStart, len: memberLen)
    if fidx < c.structs[tSidx].fields.count {
    } else {
        return 0U64
    }
    val fd: FieldDef = c.structs[tSidx].fields[fidx]
    mut val uRef: U64 = fd.ty
    if uRef == 0U64 {
        val noArgs: Array[U64] = []
        uRef = c.pushType(t: <TypeRef nameStart=fd.tyStart nameLen=fd.tyLen args=noArgs />)
    }
    mut val rArgs: Array[U64] = []
    rArgs.append(value: uRef)
    return c.pushType(t: <TypeRef nameStart=bt.nameStart nameLen=bt.nameLen args=rArgs />)
}

// Concatenate two type-param lists (`add` first, then `base`). Used to MERGE a
// nested generic construct's env onto the enclosing one — e.g. building
// `<Optional.Some v=self.f(x:v) />` inside a monomorphized `MapIter.next`: the
// field type `T` resolves via Optional's params while the payload sub-expression
// `self.f` resolves via MapIter's (the outer env). Disjoint names, so first-match
// in groundTypeRef picks the right one; same length so args pair 1:1.
fn concatParams(add: Array[Bind], base: Array[Bind]) -> Array[Bind] {
    mut val r: Array[Bind] = []
    mut val i: U64 = 0
    while i < add.count { r.append(value: add[i])  i += 1 }
    mut val j: U64 = 0
    while j < base.count { r.append(value: base[j])  j += 1 }
    return r
}
fn concatArgs(add: Array[U64], base: Array[U64]) -> Array[U64] {
    mut val r: Array[U64] = []
    mut val i: U64 = 0
    while i < add.count { r.append(value: add[i])  i += 1 }
    mut val j: U64 = 0
    while j < base.count { r.append(value: base[j])  j += 1 }
    return r
}

// If `ref` is a generic enum instance, set the substitution env to it and return
// the saved-params (so the caller restores). Returns an empty saved env otherwise.
// Pairs with restoreEnv. Encoded via the inout saved arrays.
fn setEnumEnv(c: inout Comp, st: inout LlvmCtx, ref: U64) -> Bool {
    if ref == 0U64 {
        return false
    }
    val ge: U64 = genEnumSlot(c: inout c, st: inout st, ref: ref)
    if ge < st.genEnumRefs.count {
        c.curTypeParams = c.enums[st.genEnumDefs[ge]].typeParams
        c.curTypeArgs = c.types[ref].args
        return true
    }
    return false
}

// If `ref` is a generic struct instance, set the substitution env to it (so a
// destructured field of type `T` grounds to the instance's concrete arg). Returns
// whether it set the env (caller restores). Mirrors setEnumEnv for structs.
fn setStructEnv(c: inout Comp, st: inout LlvmCtx, ref: U64) -> Bool {
    if ref == 0U64 {
        return false
    }
    val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: ref)
    if gs < st.genStructRefs.count {
        c.curTypeParams = c.structs[st.genStructDefs[gs]].typeParams
        c.curTypeArgs = c.types[ref].args
        return true
    }
    return false
}

// Index into st.genEnum* for the registered instance structurally equal to `ref`.
fn genEnumSlot(c: inout Comp, st: inout LlvmCtx, ref: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.genEnumRefs.count {
        if typeRefEq(c: inout c, a: st.genEnumRefs[i], b: ref) {
            return i
        }
        i += 1
    }
    return st.genEnumRefs.count
}

// The c.structs index for a local/param/return of type (start,len) if that type
// is a REGISTERED struct, else c.structs.count (not a struct value).
fn localStructIdxFor(c: inout Comp, st: inout LlvmCtx, start: U64, len: U64) -> U64 {
    // substitute a type parameter via the env (a generic-fn body's `x: T` with
    // T = A resolves to A's struct, so `x.get()` dispatches to A.get()).
    if c.curTypeParams.count > 0U64 {
        val qid: U64 = intern(c: inout c, start: start, len: len)
        mut val ti: U64 = 0
        while ti < c.curTypeParams.count {
            if c.curTypeParams[ti].nameId == qid {
                val at: TypeRef = c.types[c.curTypeArgs[ti]]
                return localStructIdxFor(c: inout c, st: inout st, start: at.nameStart, len: at.nameLen)
            }
            ti += 1
        }
    }
    if structRegSlot(c: inout c, st: inout st, start: start, len: len) < st.structIdxs.count {
        return structIndexByName(c: inout c, start: start, len: len)
    }
    return c.structs.count
}

// The declared index of field (start,len) in struct sidx, or sd.fields.count.
fn structFieldIndex(c: inout Comp, sidx: U64, start: U64, len: U64) -> U64 {
    val sd: StructDef = c.structs[sidx]
    mut val i: U64 = 0
    while i < sd.fields.count {
        if spansEqual(c: inout c, aStart: sd.fields[i].nameStart, aLen: sd.fields[i].nameLen, bStart: start, bLen: len) {
            return i
        }
        i += 1
    }
    return sd.fields.count
}

// The owning struct index of an expression (Ident local / Make), or
// c.structs.count if it is not a (resolvable) struct value.
fn exprStructIdx(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locStructIdx[li]
            }
        }
        Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, val ty, fields: _) => {
            if isEnum {
            } else {
                // a generic struct construction (`<Holder[I64] … />`): point at the
                // generic def so field access on the binding works.
                if isGenericInst(c: inout c, ref: ty) {
                    val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: ty)
                    if gs < st.genStructRefs.count {
                        return st.genStructDefs[gs]
                    }
                }
                return localStructIdxFor(c: inout c, st: inout st, start: typeStart, len: typeLen)
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            // a nested-struct field access (`ln.b`): the field's declared type is
            // itself a (registered) struct, so its struct index drives further
            // field access / method dispatch on the result.
            val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if bsi < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: nameStart, len: nameLen)
                if fidx < c.structs[bsi].fields.count {
                    val fld: FieldDef = c.structs[bsi].fields[fidx]
                    if fld.tyIsArray {
                    } else {
                        // ground a generic field type under the BASE's instance env
                        // (so `bb.v` with bb: Box[Box[I32]] resolves v -> Box[I32]),
                        // as well as any active env (a monomorphized method's `inner: I`).
                        val baseRef: U64 = exprTypeRef(c: inout c, st: inout st, id: base)
                        val savedP: Array[Bind] = c.curTypeParams
                        val savedA: Array[U64] = c.curTypeArgs
                        val didSet: Bool = setStructEnv(c: inout c, st: inout st, ref: baseRef)
                        mut val g: U64 = fld.ty
                        if fld.ty != 0U64 {
                            if c.curTypeParams.count > 0U64 {
                                g = groundTypeRef(c: inout c, ref: fld.ty)
                            }
                        }
                        mut val result: U64 = c.structs.count
                        if g != 0U64 {
                            if isGenericInst(c: inout c, ref: g) {
                                val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: g)
                                if gs < st.genStructRefs.count {
                                    result = st.genStructDefs[gs]
                                }
                            }
                        }
                        if result == c.structs.count {
                            mut val tStart: U64 = fld.tyStart
                            mut val tLen: U64 = fld.tyLen
                            if g != 0U64 {
                                tStart = c.types[g].nameStart
                                tLen = c.types[g].nameLen
                            }
                            result = localStructIdxFor(c: inout c, st: inout st, start: tStart, len: tLen)
                        }
                        if didSet {
                            c.curTypeParams = savedP
                            c.curTypeArgs = savedA
                        }
                        return result
                    }
                }
            }
        }
        Expr.Method(recv: val mrecv, nameStart: val mnameStart, nameLen: val mnameLen, args: val margs) => {
            // `arr.get(i:)` is array-index sugar — its element struct (so
            // `self.entries.get(i:i).key` resolves Entry[K,V] inside a generic method).
            if rangeEquals(bytes: c.bytes, start: mnameStart, len: mnameLen, kw: "get") {
                val ger: U64 = arrFieldElemStructIdx(c: inout c, st: inout st, arrayExpr: mrecv)
                if ger < c.structs.count {
                    return ger
                }
            }
            // a method/assoc-fn result used as a struct (`Vec2.add(...).sum()`,
            // `p.scaled().x`): resolve the callee's return struct.
            val marn: Bind = assocRecvName(c: inout c, recv: mrecv)
            if marn.nameLen != 0U64 {
                val afi: U64 = findAssoc(c: inout c, recvStart: marn.nameStart, recvLen: marn.nameLen, nameStart: mnameStart, nameLen: mnameLen, args: margs)
                if afi < c.funcs.count {
                    if c.funcs[afi].hasRet {
                        return localStructIdxFor(c: inout c, st: inout st, start: c.funcs[afi].retStart, len: c.funcs[afi].retLen)
                    }
                }
            } else {
                val mrsi: U64 = exprStructIdx(c: inout c, st: inout st, id: mrecv)
                if mrsi < c.structs.count {
                    val mfi: U64 = findMethod(c: inout c, recvStart: c.structs[mrsi].nameStart, recvLen: c.structs[mrsi].nameLen, nameStart: mnameStart, nameLen: mnameLen, args: margs)
                    if mfi < c.funcs.count {
                        if c.funcs[mfi].hasRet {
                            return localStructIdxFor(c: inout c, st: inout st, start: c.funcs[mfi].retStart, len: c.funcs[mfi].retLen)
                        }
                    }
                }
            }
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            // a call result used as a struct (`firstOf(...).get()`): resolve the
            // callee's return struct, grounding a generic return under the inferred
            // type arguments.
            val cfi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
            if cfi < c.funcs.count {
                val cf: Func = c.funcs[cfi]
                if cf.hasRet {
                    if isGenericFreeFn(c: inout c, fi: cfi) {
                        val savedP: Array[Bind] = c.curTypeParams
                        val savedA: Array[U64] = c.curTypeArgs
                        c.curTypeParams = cf.typeParams
                        c.curTypeArgs = llvmInferFnArgs(c: inout c, st: inout st, f: cf, args: args)
                        val r: U64 = localStructIdxFor(c: inout c, st: inout st, start: cf.retStart, len: cf.retLen)
                        c.curTypeParams = savedP
                        c.curTypeArgs = savedA
                        return r
                    }
                    return localStructIdxFor(c: inout c, st: inout st, start: cf.retStart, len: cf.retLen)
                }
            }
        }
        Expr.Unary(val op, val operand) => {
            // a unary operator result used as a struct (`(-m).cents`): the witness's
            // return type drives further field access.
            val uwfi: U64 = unaryWitnessFn(c: inout c, st: inout st, op: op, operand: operand)
            if uwfi < c.funcs.count {
                if c.funcs[uwfi].hasRet {
                    return localStructIdxFor(c: inout c, st: inout st, start: c.funcs[uwfi].retStart, len: c.funcs[uwfi].retLen)
                }
            }
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            // a binary operator result used as a struct (`(a + b).x`): the witness's
            // return type drives further field access.
            if isBinTraitOp(op: op) {
                val wfi: U64 = binWitnessFn(c: inout c, st: inout st, op: op, lhs: lhs, rhs: rhs)
                if wfi < c.funcs.count {
                    if c.funcs[wfi].hasRet {
                        return localStructIdxFor(c: inout c, st: inout st, start: c.funcs[wfi].retStart, len: c.funcs[wfi].retLen)
                    }
                }
            }
        }
        Expr.Index(val base, index: _) => {
            // an array element used as a struct (`h.items[0].v`): the array's element
            // struct, grounded under the base value's instance env.
            return arrFieldElemStructIdx(c: inout c, st: inout st, arrayExpr: base)
        }
        _ => {}
    }
    return c.structs.count
}

// The element struct def index of an array-typed struct field expression
// (`h.items` / `self.entries`), grounded under the base value's generic instance
// env, or c.structs.count if not such an array. Drives `arr[i].field` /
// `arr.get(i:).field` dispatch.
fn arrFieldElemStructIdx(c: inout Comp, st: inout LlvmCtx, arrayExpr: U64) -> U64 {
    match c.exprs[arrayExpr] {
        Expr.Ident(val start, val len) => {
            // an array-of-struct local (`store : Array[Box]`): its tracked element
            // struct (sentinel-large = element is not a struct). Safe now that array
            // value-semantics CoW makes an aliased `b = a` independent.
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locElemStructIdx[li] < c.structs.count {
                    return st.locElemStructIdx[li]
                }
                // a generic struct element (`Array[Box[I32]]`): via the element ref.
                if st.locElemTypeRef[li] != 0U64 {
                    if isGenericInst(c: inout c, ref: st.locElemTypeRef[li]) {
                        val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: st.locElemTypeRef[li])
                        if gs < st.genStructRefs.count {
                            return st.genStructDefs[gs]
                        }
                    }
                }
            }
        }
        Expr.Field(base: val fbase, nameStart: val fns, nameLen: val fnl) => {
            val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: fbase)
            if bsi < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns, len: fnl)
                if fidx < c.structs[bsi].fields.count {
                    val fd: FieldDef = c.structs[bsi].fields[fidx]
                    if fd.tyIsArray {
                        if fd.ty != 0U64 {
                            val ft: TypeRef = c.types[fd.ty]
                            if ft.args.count > 0U64 {
                                val baseRef: U64 = exprTypeRef(c: inout c, st: inout st, id: fbase)
                                val savedP: Array[Bind] = c.curTypeParams
                                val savedA: Array[U64] = c.curTypeArgs
                                val didSet: Bool = setStructEnv(c: inout c, st: inout st, ref: baseRef)
                                val g: U64 = groundTypeRef(c: inout c, ref: ft.args[0])
                                val gt: TypeRef = c.types[g]
                                mut val r: U64 = c.structs.count
                                if isGenericInst(c: inout c, ref: g) {
                                    val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: g)
                                    if gs < st.genStructRefs.count {
                                        r = st.genStructDefs[gs]
                                    }
                                } else {
                                    r = localStructIdxFor(c: inout c, st: inout st, start: gt.nameStart, len: gt.nameLen)
                                }
                                if didSet {
                                    c.curTypeParams = savedP
                                    c.curTypeArgs = savedA
                                }
                                return r
                            }
                        }
                    }
                }
            }
        }
        _ => {}
    }
    return c.structs.count
}

// The result TypeRef of a call/method expression, grounding a generic return
// under the inferred type arguments — so an un-annotated binding to a generic
// constructor (`val r = makeBox()` with makeBox -> Box[I64]) recovers the
// instance ref for field substitution. 0 when not a structured call result.
fn exprResultRef(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Call(val nameStart, val nameLen, val args) => {
            val cfi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
            if cfi < c.funcs.count {
                val cf: Func = c.funcs[cfi]
                if cf.hasRet {
                    if isGenericFreeFn(c: inout c, fi: cfi) {
                        val savedP: Array[Bind] = c.curTypeParams
                        val savedA: Array[U64] = c.curTypeArgs
                        c.curTypeParams = cf.typeParams
                        c.curTypeArgs = llvmInferFnArgs(c: inout c, st: inout st, f: cf, args: args)
                        val r: U64 = groundTypeRef(c: inout c, ref: cf.retTy)
                        c.curTypeParams = savedP
                        c.curTypeArgs = savedA
                        return r
                    }
                    return cf.retTy
                }
            }
        }
        Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, val isEnum, val ty, fields: _) => {
            // a generic construction (`<Holder[I64] … />`) used un-annotated: its
            // instance ref (grounded under any active env) so the binding tracks it.
            mut val g: U64 = ty
            if c.curTypeParams.count > 0U64 {
                g = groundTypeRef(c: inout c, ref: ty)
            }
            if isGenericInst(c: inout c, ref: g) {
                return g
            }
        }
        _ => {}
    }
    return 0U64
}

// The LLVM type for a declared type span, honoring array-ness: an array is the
// {ptr,i64} value type; otherwise the scalar/String/struct/enum type.
fn llvmTypeFor(c: inout Comp, st: inout LlvmCtx, tyStart: U64, tyLen: U64, isArray: Bool) -> LLVMTypeRef {
    if isArray {
        return st.arrayTy
    }
    return llvmScalarTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen)
}

// The LLVM type of a structured TypeRef: a generic struct/enum instance resolves
// to its registered instance type; otherwise the head name (array refs are
// handled by the isArray flag at declaration sites, not here).
fn llvmTypeOfRef(c: inout Comp, st: inout LlvmCtx, ref: U64) -> LLVMTypeRef {
    // `Array[T]` is the special {ptr,i64} value type, NOT a generic struct instance
    // (the front-end models it as one, but the LLVM array machinery — literal /
    // append / for / index — all use arrayTy). Mapping it here keeps a function
    // param/return/field of array type consistent with that machinery.
    if ref < c.types.count {
        val at: TypeRef = c.types[ref]
        if rangeEquals(bytes: c.bytes, start: at.nameStart, len: at.nameLen, kw: "Array") {
            return st.arrayTy
        }
    }
    if isGenericInst(c: inout c, ref: ref) {
        val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: ref)
        if gs < st.genStructRefs.count {
            return st.genStructTys[gs]
        }
        val ge: U64 = genEnumSlot(c: inout c, st: inout st, ref: ref)
        if ge < st.genEnumRefs.count {
            return st.genEnumTys[ge]
        }
    }
    val t: TypeRef = c.types[ref]
    return llvmScalarTy(c: inout c, st: inout st, tyStart: t.nameStart, tyLen: t.nameLen)
}

// Sign/zero-extend an integer value to i64 for the runtime boundary (print / exit
// take i64). No-op if already i64; unsigned -> zext, signed -> sext.
fn extendToI64(st: inout LlvmCtx, v: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
    if LLVMGetIntTypeWidth(LLVMTypeOf(v)) >= 64U32 {
        return v
    }
    if unsigned {
        return LLVMBuildZExt(st.b, v, st.i64ty, anon())
    }
    return LLVMBuildSExt(st.b, v, st.i64ty, anon())
}

// Adjust an integer value to a target integer width (trunc / sext / zext), so a
// value reaching a typed sink (annotated let, call arg, return) matches the
// expected width — e.g. an i64-defaulted literal `5` stored into an `I32` local.
fn coerceInt(st: inout LlvmCtx, v: LLVMValueRef, target: LLVMTypeRef, unsigned: Bool) -> LLVMValueRef {
    // only integers are width-coerced; arrays/structs/enums/String pass through.
    if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
    } else {
        return v
    }
    if LLVMGetTypeKind(target) == 8U32 {
    } else {
        return v
    }
    val vw: U32 = LLVMGetIntTypeWidth(LLVMTypeOf(v))
    val tw: U32 = LLVMGetIntTypeWidth(target)
    if vw == tw {
        return v
    }
    if vw > tw {
        return LLVMBuildTrunc(st.b, v, target, anon())
    }
    if unsigned {
        return LLVMBuildZExt(st.b, v, target, anon())
    }
    return LLVMBuildSExt(st.b, v, target, anon())
}

// Coerce an int value to the integer type named by a type span, unless that type
// is String (kind 1) — then pass through (no width concept).
fn coerceIntTo(c: inout Comp, st: inout LlvmCtx, v: LLVMValueRef, tyStart: U64, tyLen: U64) -> LLVMValueRef {
    if kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen) == 1U64 {
        return v
    }
    return coerceInt(st: inout st, v: v, target: llvmScalarTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen), unsigned: isUnsignedName(c: inout c, start: tyStart, len: tyLen))
}

// Is this type name a fixed-width primitive integer (the operator-witness owners).
fn isPrimIntName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    return isUnsignedName(c: inout c, start: start, len: len)
}

// Lower a primitive numeric operator-witness assoc call (`I32.add(lhs:, rhs:)`,
// `I64.neg(value:)`, `U8.bitnot(value:)`) directly to the LLVM op. Binary ops take
// `lhs`/`rhs`, unary `value`; the result is the receiver primitive's type and
// signedness. Returns a null sentinel for an unrecognized method (the caller then
// falls back to the normal assoc path).
fn genPrimOpWitness(c: inout Comp, st: inout LlvmCtx, tyStart: U64, tyLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
    val ty: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen)
    val uns: Bool = isUnsignedName(c: inout c, start: tyStart, len: tyLen)
    // unary: neg / bitnot (one `value` arg).
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "neg") {
        return LLVMBuildNeg(st.b, coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: args[0].expr), target: ty, unsigned: uns), anon())
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "bitnot") {
        return LLVMBuildNot(st.b, coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: args[0].expr), target: ty, unsigned: uns), anon())
    }
    // binary: map the method name to an Op, then reuse buildBinOpS.
    mut val op: I64 = -1I64
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "add") { op = opAdd() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "sub") { op = opSub() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "mul") { op = opMul() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "div") { op = opDiv() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rem") { op = opRem() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "bitand") { op = opBitAnd() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "bitor") { op = opBitOr() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "bitxor") { op = opBitXor() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "shl") { op = opShl() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "shr") { op = opShr() }
    if op == -1I64 {
        return LLVMConstNull(st.ptrty)
    }
    val l: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: args[0].expr), target: ty, unsigned: uns)
    val r: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: args[1].expr), target: ty, unsigned: uns)
    return buildBinOpS(c: inout c, st: inout st, op: op, l: l, r: r, unsigned: uns)
}

// The c.funcs index of the binary operator-trait witness `T.<name>(lhs:, rhs:)`
// for a struct/enum lhs operand (so `money + money` dispatches to the user's
// `impl Money as Add`), or c.funcs.count when the lhs isn't a registered
// aggregate (a primitive — the caller keeps the built-in op). Mirrors the C
// backend's findBinTraitWitness, but recovers the rhs type via the LLVM env
// (typeOf can't see locals here), so `a + b` (rhs Vec2) picks `Add[Vec2]` over
// `Add[I64]` correctly.
fn binWitnessFn(c: inout Comp, st: inout LlvmCtx, op: I64, lhs: U64, rhs: U64) -> U64 {
    mut val ownStart: U64 = 0
    mut val ownLen: U64 = 0
    val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: lhs)
    if sidx < c.structs.count {
        ownStart = c.structs[sidx].nameStart
        ownLen = c.structs[sidx].nameLen
    } else {
        val eid: U64 = exprEnumIdx(c: inout c, st: inout st, id: lhs)
        if eid < c.enums.count {
            ownStart = c.enums[eid].nameStart
            ownLen = c.enums[eid].nameLen
        } else {
            return c.funcs.count
        }
    }
    val qType: U64 = intern(c: inout c, start: ownStart, len: ownLen)
    val name: String = binTraitMethodName(op: op)
    // the rhs type id, recovered from the LLVM env: a known struct/enum has an
    // exact name (-> exact overload); a primitive rhs is int-ish (-> int overload).
    mut val rhsId: U64 = 0
    mut val rhsKnown: Bool = false
    val rsidx: U64 = exprStructIdx(c: inout c, st: inout st, id: rhs)
    if rsidx < c.structs.count {
        rhsId = intern(c: inout c, start: c.structs[rsidx].nameStart, len: c.structs[rsidx].nameLen)
        rhsKnown = true
    } else {
        val reid: U64 = exprEnumIdx(c: inout c, st: inout st, id: rhs)
        if reid < c.enums.count {
            rhsId = intern(c: inout c, start: c.enums[reid].nameStart, len: c.enums[reid].nameLen)
            rhsKnown = true
        }
    }
    mut val firstMatch: U64 = c.funcs.count
    mut val intMatch: U64 = c.funcs.count
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.isAssoc {
            if f.recvId == qType {
                if rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                    if firstMatch == c.funcs.count {
                        firstMatch = i
                    }
                    if f.params.count >= 2U64 {
                        if rhsKnown {
                            if f.params[1].tyNameId == rhsId {
                                return i
                            }
                        }
                        if intMatch == c.funcs.count {
                            if isIntType(c: inout c, start: f.params[1].tyStart, len: f.params[1].tyLen) {
                                intMatch = i
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    if rhsKnown {
    } else {
        if intMatch < c.funcs.count {
            return intMatch
        }
    }
    return firstMatch
}

// The c.funcs index of the prefix-unary operator-trait witness `T.<name>(value:)`
// for a struct/enum operand (`-money` -> `Money.neg(value:)`), or c.funcs.count
// when the operand isn't a registered aggregate.
fn unaryWitnessFn(c: inout Comp, st: inout LlvmCtx, op: I64, operand: U64) -> U64 {
    val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: operand)
    if sidx < c.structs.count {
        return findAssocByName(c: inout c, typeStart: c.structs[sidx].nameStart, typeLen: c.structs[sidx].nameLen, name: unaryMethodName(op: op))
    }
    val eid: U64 = exprEnumIdx(c: inout c, st: inout st, id: operand)
    if eid < c.enums.count {
        return findAssocByName(c: inout c, typeStart: c.enums[eid].nameStart, typeLen: c.enums[eid].nameLen, name: unaryMethodName(op: op))
    }
    return c.funcs.count
}

// Emit a call to a resolved operator-trait witness assoc fn (binary: lhs/rhs;
// unary: just lhs). The witness must be emitted (collectReachableAssoc seeds all
// operator witnesses); a missing slot is a loud not-yet-emittable error.
fn emitWitnessCall(c: inout Comp, st: inout LlvmCtx, fi: U64, lhs: U64, rhs: U64, binary: Bool) -> LLVMValueRef {
    val aslot: U64 = userFnSlot(st: inout st, idx: fi)
    if aslot < st.fnIdx.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "LLVM backend: operator witness not emittable yet")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val af: Func = c.funcs[fi]
    mut val av: Array[LLVMValueRef] = []
    av.append(value: genArgValue(c: inout c, st: inout st, argExpr: lhs, p: af.params[0]))
    if binary {
        av.append(value: genArgValue(c: inout c, st: inout st, argExpr: rhs, p: af.params[1]))
    }
    return LLVMBuildCall2(st.b, st.fnTy[aslot], st.fnVal[aslot], arrayCPtr(av), av.count, anon())
}

// Is this type name an unsigned integer (for choosing signed vs unsigned ops /
// formatting)? Defaults to signed.
fn isUnsignedName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    return false
}

// ---- local environment ----

fn pushLocal(st: inout LlvmCtx, nameStart: U64, nameLen: U64, ptr: LLVMValueRef, ty: LLVMTypeRef, kind: U64, structIdx: U64, isArr: Bool, elemTy: LLVMTypeRef, elemKind: U64) {
    pushLocalR(st: inout st, nameStart: nameStart, nameLen: nameLen, ptr: ptr, ty: ty, kind: kind, structIdx: structIdx, isArr: isArr, elemTy: elemTy, elemKind: elemKind, typeRef: 0U64)
}
fn pushLocalR(st: inout LlvmCtx, nameStart: U64, nameLen: U64, ptr: LLVMValueRef, ty: LLVMTypeRef, kind: U64, structIdx: U64, isArr: Bool, elemTy: LLVMTypeRef, elemKind: U64, typeRef: U64) {
    if st.nLocals < st.locStart.count {
        st.locStart[st.nLocals] = nameStart
        st.locLen[st.nLocals] = nameLen
        st.locPtr[st.nLocals] = ptr
        st.locTy[st.nLocals] = ty
        st.locKind[st.nLocals] = kind
        st.locStructIdx[st.nLocals] = structIdx
        st.locIsArr[st.nLocals] = isArr
        st.locElemTy[st.nLocals] = elemTy
        st.locElemKind[st.nLocals] = elemKind
        st.locTypeRef[st.nLocals] = typeRef
        st.locElemStructIdx[st.nLocals] = 18446744073709551615U64
        st.locElemTypeRef[st.nLocals] = 0U64
        st.locOwned[st.nLocals] = true
        st.locMoved[st.nLocals] = false
    } else {
        st.locStart.append(value: nameStart)
        st.locLen.append(value: nameLen)
        st.locPtr.append(value: ptr)
        st.locTy.append(value: ty)
        st.locKind.append(value: kind)
        st.locStructIdx.append(value: structIdx)
        st.locIsArr.append(value: isArr)
        st.locElemTy.append(value: elemTy)
        st.locElemKind.append(value: elemKind)
        st.locTypeRef.append(value: typeRef)
        st.locElemStructIdx.append(value: 18446744073709551615U64)
        st.locElemTypeRef.append(value: 0U64)
        st.locOwned.append(value: true)
        st.locMoved.append(value: false)
    }
    st.nLocals = st.nLocals + 1
}

// Set the just-pushed local's array element struct index (for an array-of-struct
// local, so `arr[i].field` resolves the element). Call right after pushLocalR.
fn setLocalElemStruct(st: inout LlvmCtx, esi: U64) {
    if st.nLocals > 0U64 {
        st.locElemStructIdx[st.nLocals - 1U64] = esi
    }
}

// Set the just-pushed array local's element TypeRef (a Ref / nested-array element).
fn setLocalElemTypeRef(st: inout LlvmCtx, ref: U64) {
    if st.nLocals > 0U64 {
        st.locElemTypeRef[st.nLocals - 1U64] = ref
    }
}

// Set the just-pushed local's ownership (false = a borrow/inout param the caller
// owns, so it is not deinit'd here).
fn setLocalOwned(st: inout LlvmCtx, owned: Bool) {
    if st.nLocals > 0U64 {
        st.locOwned[st.nLocals - 1U64] = owned
    }
}

// Mark the local named (start,len) as moved-out (ownership handed off): it is not
// deinit'd at this scope's exit.
fn markLocalMoved(c: inout Comp, st: inout LlvmCtx, start: U64, len: U64) {
    val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
    if li < st.nLocals {
        st.locMoved[li] = true
    }
}

// The Plew-type-kind tag (0 int/signed, 1 String, 2 Bool, 3 unsigned) of a type
// name span. Used to tag locals/params at declaration.
fn kindFromTySpan(c: inout Comp, tyStart: U64, tyLen: U64) -> U64 {
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "String") { return 1U64 }
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "Bool") { return 2U64 }
    if isUnsignedName(c: inout c, start: tyStart, len: tyLen) { return 3U64 }
    return 0U64
}

// Recover the type-kind of an expression: locals from the env tag; literals from
// their shape; everything else via the front-end's typeOf (which resolves call
// returns etc. without needing c.locals).
fn valueKind(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Str(start: _, len: _) => { return 1U64 }
        Expr.Int(value: _, offset: _, val isBool, val tyStart, val tyLen, isNeg: _) => {
            if isBool { return 2U64 }
            if tyLen > 0U64 {
                if isUnsignedName(c: inout c, start: tyStart, len: tyLen) { return 3U64 }
            }
            return 0U64
        }
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locKind[li]
            }
        }
        Expr.Unary(val op, val operand) => {
            if op == opNot() { return 2U64 }
            return valueKind(c: inout c, st: inout st, id: operand)
        }
        Expr.Binary(val op, val lhs, rhs: _) => {
            if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                return 2U64
            }
            return valueKind(c: inout c, st: inout st, id: lhs)
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    return kindFromTySpan(c: inout c, tyStart: c.structs[sidx].fields[fidx].tyStart, tyLen: c.structs[sidx].fields[fidx].tyLen)
                }
            }
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            val rsidx: U64 = exprStructIdx(c: inout c, st: inout st, id: recv)
            if rsidx < c.structs.count {
                val mfi: U64 = findMethod(c: inout c, recvStart: c.structs[rsidx].nameStart, recvLen: c.structs[rsidx].nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if mfi < c.funcs.count {
                    if c.funcs[mfi].hasRet {
                        return kindFromTySpan(c: inout c, tyStart: c.funcs[mfi].retStart, tyLen: c.funcs[mfi].retLen)
                    }
                }
            }
            // a method on a generic enum/struct instance (`opt.isSome()`,
            // `res.isOk()` -> Bool): resolve via the receiver's instance ref, since
            // exprStructIdx doesn't see enums. The concrete return kind comes from
            // the method's declared return span (Bool/numeric).
            val rRef: U64 = exprTypeRef(c: inout c, st: inout st, id: recv)
            if rRef != 0U64 {
                val rt: TypeRef = c.types[rRef]
                val gmfi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if gmfi < c.funcs.count {
                    if c.funcs[gmfi].hasRet {
                        return kindFromTySpan(c: inout c, tyStart: c.funcs[gmfi].retStart, tyLen: c.funcs[gmfi].retLen)
                    }
                }
            }
        }
        Expr.Index(val base, index: _) => {
            // element kind: from the array local's tracked element kind (so an
            // Array[U16] element is unsigned), else inferred from the element type.
            match c.exprs[base] {
                Expr.Ident(start: val s2, len: val l2) => {
                    val li2: U64 = findLocal(c: inout c, st: inout st, start: s2, len: l2)
                    if li2 < st.nLocals {
                        if st.locIsArr[li2] {
                            return st.locElemKind[li2]
                        }
                    }
                }
                _ => {}
            }
            val et: LLVMTypeRef = exprArrElemTy(c: inout c, st: inout st, id: base)
            if LLVMGetTypeKind(et) == 10U32 { return 1U64 }
            if LLVMGetTypeKind(et) == 8U32 {
                if LLVMGetIntTypeWidth(et) == 1U32 { return 2U64 }
            }
            return 0U64
        }
        _ => {}
    }
    // fallback: the typed-AST cache (works for call results, fields, …).
    val t: TypeInfo = typeOf(c: inout c, id: id)
    if t.kind == 1 { return 1U64 }
    if t.kind == 0 {
        if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Bool") { return 2U64 }
        if isUnsignedName(c: inout c, start: t.nameStart, len: t.nameLen) { return 3U64 }
    }
    return 0U64
}

// Index of the live local matching (start,len) by content, searched from the most
// recent so a shadowing declaration wins. Returns st.nLocals if not found.
fn findLocal(c: inout Comp, st: inout LlvmCtx, start: U64, len: U64) -> U64 {
    mut val i: U64 = st.nLocals
    while i > 0 {
        i -= 1
        if spansEqual(c: inout c, aStart: st.locStart[i], aLen: st.locLen[i], bStart: start, bLen: len) {
            return i
        }
    }
    return st.nLocals
}

// ---- runtime-function declarations (cached) ----
//
// Look up a previously declared runtime/intrinsic function by name id, or declare
// it (a body-less prototype resolved at link time against the emitted runtime.c).
fn getOrDeclare(c: inout Comp, st: inout LlvmCtx, name: String, nameId: U64, fnTy: LLVMTypeRef) -> LLVMValueRef {
    mut val i: U64 = 0
    while i < st.declId.count {
        if st.declId[i] == nameId {
            return st.declFn[i]
        }
        i += 1
    }
    val f: LLVMValueRef = LLVMAddFunction(st.mod, cstr(s: name), fnTy)
    st.declId.append(value: nameId)
    st.declFn.append(value: f)
    st.declTy.append(value: fnTy)
    return f
}

// ---- string literals ----
//
// Decode one C-style escape (the byte after a backslash) to its actual byte.
fn escByte(nx: U8) -> U8 {
    if nx == 110 { return 10 }
    if nx == 116 { return 9 }
    if nx == 114 { return 13 }
    if nx == 48 { return 0 }
    return nx
}

// Decode a string literal's source span (start = the opening quote) to its actual
// bytes plus a trailing NUL, mirroring strDecodedLen's escape model (a backslash
// escapes the next byte). The trailing NUL makes it usable as a C string for
// LLVMBuildGlobalStringPtr; the PlewString length excludes it.
fn strDecodeBytes(c: inout Comp, start: U64, len: U64) -> Array[U8] {
    mut val out: Array[U8] = []
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if c.bytes[j] == 92 {
            out.append(value: escByte(nx: c.bytes[j + 1]))
            j += 2
        } else {
            out.append(value: c.bytes[j])
            j += 1
        }
    }
    out.append(value: 0)
    return out
}

// Build a String value (strty `{i8*, i64}`) from a literal: a private global for
// the bytes + the decoded length.
fn genLlvmStr(c: inout Comp, st: inout LlvmCtx, start: U64, len: U64) -> LLVMValueRef {
    mut val bytes: Array[U8] = strDecodeBytes(c: inout c, start: start, len: len)
    val n: U64 = bytes.count - 1
    val ptr: LLVMValueRef = LLVMBuildGlobalStringPtr(st.b, arrayCPtr(bytes), anon())
    mut val agg: LLVMValueRef = LLVMGetUndef(st.strty)
    agg = LLVMBuildInsertValue(st.b, agg, ptr, 0U64, anon())
    agg = LLVMBuildInsertValue(st.b, agg, LLVMConstInt(st.i64ty, n, 0I32), 1U64, anon())
    return agg
}

// Decompose a String value to (i8* data, i64 len) and call a 2-arg runtime sink
// (`plew_write_raw` / `plew_eprint_raw` / `plew_panic_raw`). Passing scalars, not
// the struct by value, sidesteps the C struct-by-value ABI until it is modeled.
fn emitStrSink(c: inout Comp, st: inout LlvmCtx, rtName: String, rtId: U64, argExpr: U64) -> LLVMValueRef {
    val sv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: argExpr)
    val ptr: LLVMValueRef = LLVMBuildExtractValue(st.b, sv, 0U64, anon())
    val len: LLVMValueRef = LLVMBuildExtractValue(st.b, sv, 1U64, anon())
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(ptys), 2U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: rtName, nameId: rtId, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: ptr)
    av.append(value: len)
    return LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 2U64, anon())
}

// Call a 1-arg i64 runtime sink (`plew_print_i64` / `plew_print_u64` /
// `plew_print_bool`) with an already-i64 value.
fn emitI64Sink(c: inout Comp, st: inout LlvmCtx, rtName: String, rtId: U64, v: LLVMValueRef) -> LLVMValueRef {
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(ptys), 1U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: rtName, nameId: rtId, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: v)
    return LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 1U64, anon())
}

// `print(x)` (spec/02): lower by the argument's recovered type to a runtime
// formatter that writes the textual form + a newline. This bypasses the Plew
// Format trait machinery (generics + methods + arrays) for the built-in scalar /
// String types — observably identical. A user type implementing Format is not yet
// supported here (rejected loudly).
fn emitPrint(c: inout Comp, st: inout LlvmCtx, argExpr: U64) -> LLVMValueRef {
    if exprStructIdx(c: inout c, st: inout st, id: argExpr) < c.structs.count {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: argExpr)), msg: "LLVM backend: print of a struct (Format witness) not yet supported")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val k: U64 = valueKind(c: inout c, st: inout st, id: argExpr)
    if k == 1U64 {
        return emitStrSink(c: inout c, st: inout st, rtName: "plew_print_str", rtId: 5U64, argExpr: argExpr)
    }
    if k == 2U64 {
        val bv: LLVMValueRef = LLVMBuildZExt(st.b, genLlvmExpr(c: inout c, st: inout st, id: argExpr), st.i64ty, anon())
        return emitI64Sink(c: inout c, st: inout st, rtName: "plew_print_bool", rtId: 6U64, v: bv)
    }
    val v: LLVMValueRef = extendToI64(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: argExpr), unsigned: k == 3U64)
    if k == 3U64 {
        return emitI64Sink(c: inout c, st: inout st, rtName: "plew_print_u64", rtId: 7U64, v: v)
    }
    return emitI64Sink(c: inout c, st: inout st, rtName: "plew_print_i64", rtId: 8U64, v: v)
}

// Byte-compare two String VALUES (strty) -> i1 (true if equal).
fn emitStrEqValues(c: inout Comp, st: inout LlvmCtx, a: LLVMValueRef, b: LLVMValueRef) -> LLVMValueRef {
    val pa: LLVMValueRef = LLVMBuildExtractValue(st.b, a, 0U64, anon())
    val la: LLVMValueRef = LLVMBuildExtractValue(st.b, a, 1U64, anon())
    val pb: LLVMValueRef = LLVMBuildExtractValue(st.b, b, 0U64, anon())
    val lb: LLVMValueRef = LLVMBuildExtractValue(st.b, b, 1U64, anon())
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    ptys.append(value: st.i64ty)
    ptys.append(value: st.ptrty)
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.i64ty, arrayCPtr(ptys), 4U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_str_eq", nameId: 9U64, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: pa)
    av.append(value: la)
    av.append(value: pb)
    av.append(value: lb)
    val r: LLVMValueRef = LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 4U64, anon())
    return LLVMBuildICmp(st.b, llvmIntNe(), r, LLVMConstInt(st.i64ty, 0U64, 0I32), anon())
}

// Compare two field values of declared type (tyStart,tyLen) for equality -> i1.
fn cmpFieldEq(c: inout Comp, st: inout LlvmCtx, a: LLVMValueRef, b: LLVMValueRef, tyStart: U64, tyLen: U64) -> LLVMValueRef {
    if rangeEquals(bytes: c.bytes, start: tyStart, len: tyLen, kw: "String") {
        return emitStrEqValues(c: inout c, st: inout st, a: a, b: b)
    }
    val sreg: U64 = structRegSlot(c: inout c, st: inout st, start: tyStart, len: tyLen)
    if sreg < st.structIdxs.count {
        return emitStructEq(c: inout c, st: inout st, a: a, b: b, sidx: st.structIdxs[sreg])
    }
    return LLVMBuildICmp(st.b, llvmIntEq(), a, b, anon())
}

// Structural equality of two struct VALUES -> i1 (AND of per-field comparisons).
fn emitStructEq(c: inout Comp, st: inout LlvmCtx, a: LLVMValueRef, b: LLVMValueRef, sidx: U64) -> LLVMValueRef {
    val sd: StructDef = c.structs[sidx]
    mut val acc: LLVMValueRef = LLVMConstInt(st.i1ty, 1U64, 0I32)
    mut val i: U64 = 0
    while i < sd.fields.count {
        val fl: LLVMValueRef = LLVMBuildExtractValue(st.b, a, i, anon())
        val fr: LLVMValueRef = LLVMBuildExtractValue(st.b, b, i, anon())
        acc = LLVMBuildAnd(st.b, acc, cmpFieldEq(c: inout c, st: inout st, a: fl, b: fr, tyStart: sd.fields[i].tyStart, tyLen: sd.fields[i].tyLen), anon())
        i += 1
    }
    return acc
}

// Compare two scalar / nested-struct field VALUES, yielding an i32 ordering
// (-1 / 0 / 1) — the Ord witness lowered without a runtime call. String fields
// are deferred (structOrdSupported gates them out).
fn cmpFieldOrd(c: inout Comp, st: inout LlvmCtx, a: LLVMValueRef, b: LLVMValueRef, tyStart: U64, tyLen: U64) -> LLVMValueRef {
    val sreg: U64 = structRegSlot(c: inout c, st: inout st, start: tyStart, len: tyLen)
    if sreg < st.structIdxs.count {
        return emitStructCmp(c: inout c, st: inout st, a: a, b: b, sidx: st.structIdxs[sreg])
    }
    val uns: Bool = isUnsignedName(c: inout c, start: tyStart, len: tyLen)
    mut val gtPred: U32 = llvmIntSgt()
    mut val ltPred: U32 = llvmIntSlt()
    if uns {
        gtPred = llvmIntUgt()
        ltPred = llvmIntUlt()
    }
    val gt: LLVMValueRef = LLVMBuildICmp(st.b, gtPred, a, b, anon())
    val lt: LLVMValueRef = LLVMBuildICmp(st.b, ltPred, a, b, anon())
    // i32 -1 as the 32-bit all-ones pattern (avoids an underflowing literal).
    val negOne: LLVMValueRef = LLVMConstInt(st.i32ty, 4294967295U64, 0I32)
    val zero: LLVMValueRef = LLVMConstInt(st.i32ty, 0U64, 0I32)
    val one: LLVMValueRef = LLVMConstInt(st.i32ty, 1U64, 0I32)
    val lo: LLVMValueRef = LLVMBuildSelect(st.b, lt, negOne, zero, anon())
    return LLVMBuildSelect(st.b, gt, one, lo, anon())
}

// Lexicographic comparison of two struct VALUES -> i32 ordering (-1/0/1): the
// first (lowest-index) field whose comparison is nonzero decides. Built as a
// select chain folded from the last field back to the first.
fn emitStructCmp(c: inout Comp, st: inout LlvmCtx, a: LLVMValueRef, b: LLVMValueRef, sidx: U64) -> LLVMValueRef {
    val sd: StructDef = c.structs[sidx]
    mut val acc: LLVMValueRef = LLVMConstInt(st.i32ty, 0U64, 0I32)
    mut val i: U64 = sd.fields.count
    while i > 0U64 {
        i -= 1
        val fl: LLVMValueRef = LLVMBuildExtractValue(st.b, a, i, anon())
        val fr: LLVMValueRef = LLVMBuildExtractValue(st.b, b, i, anon())
        val ci: LLVMValueRef = cmpFieldOrd(c: inout c, st: inout st, a: fl, b: fr, tyStart: sd.fields[i].tyStart, tyLen: sd.fields[i].tyLen)
        val isZero: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), ci, LLVMConstInt(st.i32ty, 0U64, 0I32), anon())
        acc = LLVMBuildSelect(st.b, isZero, acc, ci, anon())
    }
    return acc
}

// Whether a struct's fields are all orderable here (scalar or nested orderable
// struct — String/array/enum fields deferred).
fn structOrdSupported(c: inout Comp, st: inout LlvmCtx, sidx: U64) -> Bool {
    val sd: StructDef = c.structs[sidx]
    mut val i: U64 = 0
    while i < sd.fields.count {
        if sd.fields[i].tyIsArray {
            return false
        }
        if rangeEquals(bytes: c.bytes, start: sd.fields[i].tyStart, len: sd.fields[i].tyLen, kw: "String") {
            return false
        }
        if isEnumName(c: inout c, start: sd.fields[i].tyStart, len: sd.fields[i].tyLen) {
            return false
        }
        val sreg: U64 = structRegSlot(c: inout c, st: inout st, start: sd.fields[i].tyStart, len: sd.fields[i].tyLen)
        if sreg < st.structIdxs.count {
            if structOrdSupported(c: inout c, st: inout st, sidx: st.structIdxs[sreg]) {
            } else {
                return false
            }
        }
        i += 1
    }
    return true
}

// Apply an ordering operator (`< <= > >=`) to a struct comparison: build the i32
// ordering, then compare it against 0 (signed).
fn emitStructOrdOp(c: inout Comp, st: inout LlvmCtx, op: I64, a: LLVMValueRef, b: LLVMValueRef, sidx: U64) -> LLVMValueRef {
    val ord: LLVMValueRef = emitStructCmp(c: inout c, st: inout st, a: a, b: b, sidx: sidx)
    val zero: LLVMValueRef = LLVMConstInt(st.i32ty, 0U64, 0I32)
    mut val pred: U32 = llvmIntSlt()
    if op == opLe() { pred = llvmIntSle() }
    if op == opGt() { pred = llvmIntSgt() }
    if op == opGe() { pred = llvmIntSge() }
    return LLVMBuildICmp(st.b, pred, ord, zero, anon())
}

// The c.enums index of an expression's enum type, or c.enums.count. A JSX enum
// construction (`<Kind.LParen />`) carries the enum name directly; otherwise the
// typed-AST cache supplies a named type (kind 2). (Opaque extern LLVMTypeRefs
// can't be `==`-compared in Plew, so detection is via the AST, not the value type.)
fn exprEnumIdx(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, fields: _) => {
            if isEnum {
                return enumIdxByName(c: inout c, start: typeStart, len: typeLen)
            }
        }
        _ => {}
    }
    // an enum local carries a bare enum TypeRef on locTypeRef (typeOf can't see it).
    val tr: U64 = exprTypeRef(c: inout c, st: inout st, id: id)
    if tr != 0U64 {
        val tt: TypeRef = c.types[tr]
        val ei: U64 = enumIdxByName(c: inout c, start: tt.nameStart, len: tt.nameLen)
        if ei < c.enums.count {
            return ei
        }
    }
    val t: TypeInfo = typeOf(c: inout c, id: id)
    if t.kind == 2 {
        return enumIdxByName(c: inout c, start: t.nameStart, len: t.nameLen)
    }
    return c.enums.count
}

// Whether every variant of an enum is payload-less (so `==` is a tag comparison;
// payload-carrying enums need a per-variant switch, deferred).
fn enumPayloadless(c: inout Comp, eid: U64) -> Bool {
    val ed: EnumDef = c.enums[eid]
    mut val i: U64 = 0
    while i < ed.variants.count {
        if ed.variants[i].fields.count > 0U64 {
            return false
        }
        i += 1
    }
    return true
}

// The payload-word count of an enum (max over variants of summed field words) — the
// length of the `[N x i64]` payload area.
fn enumMaxWords(c: inout Comp, st: inout LlvmCtx, eid: U64) -> U64 {
    val ed: EnumDef = c.enums[eid]
    mut val maxW: U64 = 0
    mut val vi: U64 = 0
    while vi < ed.variants.count {
        val fs: Array[FieldDef] = ed.variants[vi].fields
        mut val w: U64 = 0
        mut val fj: U64 = 0
        while fj < fs.count {
            w = w + fieldWordsF(c: inout c, st: inout st, f: fs[fj])
            fj += 1
        }
        if w > maxW { maxW = w }
        vi += 1
    }
    return maxW
}

// Whether a payload-carrying enum's `==` can use raw tag+word bit-equality: every
// payload field is a scalar int/Bool (no String/struct/array, whose bytes don't
// compare by identity). Bit-equality on a zero-initialized payload is then exact.
fn enumEqWordable(c: inout Comp, st: inout LlvmCtx, eid: U64) -> Bool {
    val ed: EnumDef = c.enums[eid]
    mut val vi: U64 = 0
    while vi < ed.variants.count {
        val fs: Array[FieldDef] = ed.variants[vi].fields
        mut val fj: U64 = 0
        while fj < fs.count {
            if fs[fj].tyIsArray { return false }
            if rangeEquals(bytes: c.bytes, start: fs[fj].tyStart, len: fs[fj].tyLen, kw: "String") { return false }
            if isEnumName(c: inout c, start: fs[fj].tyStart, len: fs[fj].tyLen) { return false }
            if structRegSlot(c: inout c, st: inout st, start: fs[fj].tyStart, len: fs[fj].tyLen) < st.structIdxs.count { return false }
            fj += 1
        }
        vi += 1
    }
    return true
}

// Structural `==` of two payload-carrying enum VALUES (gated by enumEqWordable):
// tags equal AND every payload word equal (the payload is zero-initialized, so
// inactive words are 0 and equal-valued same-variant values are bit-identical).
fn emitEnumEqWords(c: inout Comp, st: inout LlvmCtx, l: LLVMValueRef, r: LLVMValueRef, eid: U64) -> LLVMValueRef {
    mut val acc: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), LLVMBuildExtractValue(st.b, l, 0U64, anon()), LLVMBuildExtractValue(st.b, r, 0U64, anon()), anon())
    val maxW: U64 = enumMaxWords(c: inout c, st: inout st, eid: eid)
    if maxW > 0U64 {
        val plL: LLVMValueRef = LLVMBuildExtractValue(st.b, l, 1U64, anon())
        val plR: LLVMValueRef = LLVMBuildExtractValue(st.b, r, 1U64, anon())
        mut val i: U64 = 0
        while i < maxW {
            val wEq: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), LLVMBuildExtractValue(st.b, plL, i, anon()), LLVMBuildExtractValue(st.b, plR, i, anon()), anon())
            acc = LLVMBuildAnd(st.b, acc, wEq, anon())
            i += 1
        }
    }
    return acc
}

// Whether a payload-carrying enum's Ord can be lowered here: every payload field
// is orderable (scalar int/Bool, or a nested orderable struct — String/array/enum
// fields deferred). Mirrors structOrdSupported over each variant's fields.
fn enumOrdSupported(c: inout Comp, st: inout LlvmCtx, eid: U64) -> Bool {
    val ed: EnumDef = c.enums[eid]
    mut val vi: U64 = 0
    while vi < ed.variants.count {
        val fs: Array[FieldDef] = ed.variants[vi].fields
        mut val fj: U64 = 0
        while fj < fs.count {
            if fs[fj].tyIsArray { return false }
            if rangeEquals(bytes: c.bytes, start: fs[fj].tyStart, len: fs[fj].tyLen, kw: "String") { return false }
            if isEnumName(c: inout c, start: fs[fj].tyStart, len: fs[fj].tyLen) { return false }
            val sreg: U64 = structRegSlot(c: inout c, st: inout st, start: fs[fj].tyStart, len: fs[fj].tyLen)
            if sreg < st.structIdxs.count {
                if structOrdSupported(c: inout c, st: inout st, sidx: st.structIdxs[sreg]) {
                } else {
                    return false
                }
            }
            fj += 1
        }
        vi += 1
    }
    return true
}

// Lexicographic ordering of one variant's payload (the typed payload struct loaded
// from the payload area) -> i32 ordering: the first field whose compare is nonzero
// decides. Built as a select chain folded from the last field back to the first.
fn emitVariantPayloadCmp(c: inout Comp, st: inout LlvmCtx, eid: U64, vi: U64, pA: LLVMValueRef, pB: LLVMValueRef) -> LLVMValueRef {
    val fs: Array[FieldDef] = c.enums[eid].variants[vi].fields
    mut val acc: LLVMValueRef = LLVMConstInt(st.i32ty, 0U64, 0I32)
    mut val i: U64 = fs.count
    while i > 0U64 {
        i -= 1
        val fl: LLVMValueRef = LLVMBuildExtractValue(st.b, pA, i, anon())
        val fr: LLVMValueRef = LLVMBuildExtractValue(st.b, pB, i, anon())
        val ci: LLVMValueRef = cmpFieldOrd(c: inout c, st: inout st, a: fl, b: fr, tyStart: fs[i].tyStart, tyLen: fs[i].tyLen)
        val isZero: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), ci, LLVMConstInt(st.i32ty, 0U64, 0I32), anon())
        acc = LLVMBuildSelect(st.b, isZero, acc, ci, anon())
    }
    return acc
}

// Lexicographic comparison of two enum VALUES -> i32 ordering (-1/0/1): compare
// tags first (a smaller tag is smaller); on equal tags, compare that variant's
// payload. The payload compare for every payloaded variant is computed and the
// active one is selected by tag (the inactive loads read the same zero-initialized
// area harmlessly — no side effects). sty is the enum's LLVM struct type.
fn emitEnumCmp(c: inout Comp, st: inout LlvmCtx, a: LLVMValueRef, b: LLVMValueRef, eid: U64, sty: LLVMTypeRef) -> LLVMValueRef {
    val aslot: LLVMValueRef = LLVMBuildAlloca(st.b, sty, anon())
    LLVMBuildStore(st.b, a, aslot)
    val bslot: LLVMValueRef = LLVMBuildAlloca(st.b, sty, anon())
    LLVMBuildStore(st.b, b, bslot)
    val tagA: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, sty, aslot, 0U64, anon()), anon())
    val tagB: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, sty, bslot, 0U64, anon()), anon())
    mut val payloadOrd: LLVMValueRef = LLVMConstInt(st.i32ty, 0U64, 0I32)
    val ed: EnumDef = c.enums[eid]
    mut val vi: U64 = 0
    while vi < ed.variants.count {
        if ed.variants[vi].fields.count > 0U64 {
            val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eid, vi: vi)
            val pA: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, sty, aslot, 1U64, anon()), anon())
            val pB: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, sty, bslot, 1U64, anon()), anon())
            val vOrd: LLVMValueRef = emitVariantPayloadCmp(c: inout c, st: inout st, eid: eid, vi: vi, pA: pA, pB: pB)
            val isThis: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tagA, LLVMConstInt(st.i64ty, vi, 0I32), anon())
            payloadOrd = LLVMBuildSelect(st.b, isThis, vOrd, payloadOrd, anon())
        }
        vi += 1
    }
    val negOne: LLVMValueRef = LLVMConstInt(st.i32ty, 4294967295U64, 0I32)
    val one: LLVMValueRef = LLVMConstInt(st.i32ty, 1U64, 0I32)
    val tagLt: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntUlt(), tagA, tagB, anon())
    val tagGt: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntUgt(), tagA, tagB, anon())
    val inner: LLVMValueRef = LLVMBuildSelect(st.b, tagGt, one, payloadOrd, anon())
    return LLVMBuildSelect(st.b, tagLt, negOne, inner, anon())
}

// Apply an ordering operator (`< <= > >=`) to an enum comparison: build the i32
// ordering, then compare it against 0 (signed).
fn emitEnumOrdOp(c: inout Comp, st: inout LlvmCtx, op: I64, a: LLVMValueRef, b: LLVMValueRef, eid: U64, sty: LLVMTypeRef) -> LLVMValueRef {
    val ord: LLVMValueRef = emitEnumCmp(c: inout c, st: inout st, a: a, b: b, eid: eid, sty: sty)
    val zero: LLVMValueRef = LLVMConstInt(st.i32ty, 0U64, 0I32)
    mut val pred: U32 = llvmIntSlt()
    if op == opLe() { pred = llvmIntSle() }
    if op == opGt() { pred = llvmIntSgt() }
    if op == opGe() { pred = llvmIntSge() }
    return LLVMBuildICmp(st.b, pred, ord, zero, anon())
}

// Whether a struct's fields are all comparable here (no array/enum field).
fn structEqSupported(c: inout Comp, st: inout LlvmCtx, sidx: U64) -> Bool {
    val sd: StructDef = c.structs[sidx]
    mut val i: U64 = 0
    while i < sd.fields.count {
        if sd.fields[i].tyIsArray {
            return false
        }
        if isEnumName(c: inout c, start: sd.fields[i].tyStart, len: sd.fields[i].tyLen) {
            return false
        }
        i += 1
    }
    return true
}

// String ==/!= : decompose both operands to (ptr,len) and call a byte-compare
// runtime, yielding an i1 (so it works in both condition and Bool-value contexts).
fn emitStrEq(c: inout Comp, st: inout LlvmCtx, op: I64, lhs: U64, rhs: U64) -> LLVMValueRef {
    val a: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: lhs)
    val b: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: rhs)
    val pa: LLVMValueRef = LLVMBuildExtractValue(st.b, a, 0U64, anon())
    val la: LLVMValueRef = LLVMBuildExtractValue(st.b, a, 1U64, anon())
    val pb: LLVMValueRef = LLVMBuildExtractValue(st.b, b, 0U64, anon())
    val lb: LLVMValueRef = LLVMBuildExtractValue(st.b, b, 1U64, anon())
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    ptys.append(value: st.i64ty)
    ptys.append(value: st.ptrty)
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.i64ty, arrayCPtr(ptys), 4U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_str_eq", nameId: 9U64, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: pa)
    av.append(value: la)
    av.append(value: pb)
    av.append(value: lb)
    val r: LLVMValueRef = LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 4U64, anon())
    mut val pred: U32 = llvmIntNe()
    if op == opNe() {
        pred = llvmIntEq()
    }
    return LLVMBuildICmp(st.b, pred, r, LLVMConstInt(st.i64ty, 0U64, 0I32), anon())
}

// ---- arithmetic / comparison ----

// Build an integer binary op as a single LLVM instruction. v1: signed semantics
// for division/remainder/comparison (widths/unsigned/overflow-panic are TODO).
// Comparisons yield i1; arithmetic yields the operand width.
fn buildBinOp(c: inout Comp, st: inout LlvmCtx, op: I64, l: LLVMValueRef, r: LLVMValueRef) -> LLVMValueRef {
    return buildBinOpS(c: inout c, st: inout st, op: op, l: l, r: r, unsigned: false)
}

// Build an integer binary op, choosing unsigned vs signed forms (div/rem/cmp/shr)
// by the operand signedness.
fn buildBinOpS(c: inout Comp, st: inout LlvmCtx, op: I64, l: LLVMValueRef, r: LLVMValueRef, unsigned: Bool) -> LLVMValueRef {
    if op == opAdd() { return LLVMBuildAdd(st.b, l, r, anon()) }
    if op == opSub() { return LLVMBuildSub(st.b, l, r, anon()) }
    if op == opMul() { return LLVMBuildMul(st.b, l, r, anon()) }
    if op == opDiv() { if unsigned { return LLVMBuildUDiv(st.b, l, r, anon()) } return LLVMBuildSDiv(st.b, l, r, anon()) }
    if op == opRem() { if unsigned { return LLVMBuildURem(st.b, l, r, anon()) } return LLVMBuildSRem(st.b, l, r, anon()) }
    if op == opBitAnd() { return LLVMBuildAnd(st.b, l, r, anon()) }
    if op == opBitOr() { return LLVMBuildOr(st.b, l, r, anon()) }
    if op == opBitXor() { return LLVMBuildXor(st.b, l, r, anon()) }
    if op == opShl() { return LLVMBuildShl(st.b, l, r, anon()) }
    if op == opShr() { if unsigned { return LLVMBuildLShr(st.b, l, r, anon()) } return LLVMBuildAShr(st.b, l, r, anon()) }
    if op == opEq() { return LLVMBuildICmp(st.b, llvmIntEq(), l, r, anon()) }
    if op == opNe() { return LLVMBuildICmp(st.b, llvmIntNe(), l, r, anon()) }
    if op == opLt() { if unsigned { return LLVMBuildICmp(st.b, llvmIntUlt(), l, r, anon()) } return LLVMBuildICmp(st.b, llvmIntSlt(), l, r, anon()) }
    if op == opLe() { if unsigned { return LLVMBuildICmp(st.b, llvmIntUle(), l, r, anon()) } return LLVMBuildICmp(st.b, llvmIntSle(), l, r, anon()) }
    if op == opGt() { if unsigned { return LLVMBuildICmp(st.b, llvmIntUgt(), l, r, anon()) } return LLVMBuildICmp(st.b, llvmIntSgt(), l, r, anon()) }
    if op == opGe() { if unsigned { return LLVMBuildICmp(st.b, llvmIntUge(), l, r, anon()) } return LLVMBuildICmp(st.b, llvmIntSge(), l, r, anon()) }
    // unsupported op (bitwise/shift land in a later increment): reject loudly.
    compileErrorAt(line: 0, msg: "LLVM backend: operator not yet supported")
    return l
}

// Construct a registered struct value from a JSX `<Type field=expr ... />`: build
// each declared field (matched by name, or its default) in order via insertvalue.
fn genLlvmMake(c: inout Comp, st: inout LlvmCtx, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, ty: U64, fields: Array[MakeField]) -> LLVMValueRef {
    // inside a generic method/function body, a construction `<Box[T] … />` names
    // the syntactic `Box[T]`; ground its type args through the active env so it
    // resolves to the registered concrete instance (`Box[I32]`).
    mut val gty: U64 = ty
    if c.curTypeParams.count > 0U64 {
        gty = groundTypeRef(c: inout c, ref: ty)
    }
    if isEnum {
        return genLlvmMakeEnum(c: inout c, st: inout st, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, ty: gty, fields: fields)
    }
    // `<Ref[T] value=e />`: allocate a heap cell holding the pointee, store e, and
    // yield the cell pointer (the Ref value). Refcount/release is hidden cost,
    // deferred (no deinit in these cases yet) — the pointer aliases on copy so
    // shared mutation through `->` is visible.
    if rangeEquals(bytes: c.bytes, start: typeStart, len: typeLen, kw: "Ref") {
        return genLlvmMakeRef(c: inout c, st: inout st, ty: gty, fields: fields)
    }
    // a generic struct instance (Box[I32]): build under its substitution env.
    if isGenericInst(c: inout c, ref: gty) {
        val gslot: U64 = genStructSlot(c: inout c, st: inout st, ref: gty)
        if gslot < st.genStructRefs.count {
            val sd: StructDef = c.structs[st.genStructDefs[gslot]]
            val savedP: Array[Bind] = c.curTypeParams
            val savedA: Array[U64] = c.curTypeArgs
            // MERGE (see genLlvmMakeEnum) so a field sub-expression referencing the
            // enclosing method's type params still grounds.
            c.curTypeParams = concatParams(add: sd.typeParams, base: savedP)
            c.curTypeArgs = concatArgs(add: c.types[gty].args, base: savedA)
            val v: LLVMValueRef = buildStructValue(c: inout c, st: inout st, sd: sd, sty: st.genStructTys[gslot], fields: fields, errOffset: typeStart)
            c.curTypeParams = savedP
            c.curTypeArgs = savedA
            return v
        }
    }
    val reg: U64 = structRegSlot(c: inout c, st: inout st, start: typeStart, len: typeLen)
    if reg < st.structIdxs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: typeStart), msg: "LLVM backend: construction of this type not yet supported (Ref / nested-struct structs are TODO)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    return buildStructValue(c: inout c, st: inout st, sd: c.structs[st.structIdxs[reg]], sty: st.structTys[reg], fields: fields, errOffset: typeStart)
}

// The LLVM type of a `Ref[T]`'s pointee T (from the instance's first type arg).
fn refPointeeTy(c: inout Comp, st: inout LlvmCtx, refTy: U64) -> LLVMTypeRef {
    if isRefInst(c: inout c, ref: refTy) {
        return llvmTypeOfRef(c: inout c, st: inout st, ref: c.types[refTy].args[0])
    }
    return st.i64ty
}

// The Ref instance TypeRef of an expression that evaluates to a `Ref[T]` (a local
// carries it on locTypeRef), or 0 if it is not a Ref-typed expression.
fn exprRefTypeRef(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    val r: U64 = exprTypeRef(c: inout c, st: inout st, id: id)
    if isRefInst(c: inout c, ref: r) {
        return r
    }
    return 0U64
}

// The struct index of a `Ref[T]` base's pointee T (for `->field` resolution), or
// c.structs.count if the base isn't a Ref to a registered struct.
fn refPointeeStructIdx(c: inout Comp, st: inout LlvmCtx, base: U64) -> U64 {
    val r: U64 = exprRefTypeRef(c: inout c, st: inout st, id: base)
    if r != 0U64 {
        val t: TypeRef = c.types[r]
        if t.args.count > 0U64 {
            val pt: TypeRef = c.types[t.args[0]]
            return localStructIdxFor(c: inout c, st: inout st, start: pt.nameStart, len: pt.nameLen)
        }
    }
    return c.structs.count
}

// Load a `Ref[T]` base's pointee struct VALUE (`*cell`) — the basis for `->field`.
fn loadRefPointee(c: inout Comp, st: inout LlvmCtx, base: U64) -> LLVMValueRef {
    val r: U64 = exprRefTypeRef(c: inout c, st: inout st, id: base)
    val pty: LLVMTypeRef = refPointeeTy(c: inout c, st: inout st, refTy: r)
    val cellPtr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: base)
    return LLVMBuildLoad2(st.b, pty, cellPtr, anon())
}

// Build a `Ref[T]` value: malloc a cell of sizeof(T), store the `value` field's
// pointee into it, and return the cell pointer.
fn genLlvmMakeRef(c: inout Comp, st: inout LlvmCtx, ty: U64, fields: Array[MakeField]) -> LLVMValueRef {
    // a `Ref[T]` whose pointee T has a deinit needs refcount-based release (the last
    // Ref to drop runs the pointee's deinit once). That ARC isn't modeled yet —
    // reject rather than leak the deinit. (Ref to a plain value type is supported.)
    if c.types[ty].args.count > 0U64 {
        val pt: TypeRef = c.types[c.types[ty].args[0]]
        val psi: U64 = structIndexByName(c: inout c, start: pt.nameStart, len: pt.nameLen)
        if psi < c.structs.count {
            if structDeinitFi(c: inout c, sidx: psi) < c.funcs.count {
                compileErrorAt(line: lineOf(c: inout c, offset: 0U64), msg: "LLVM backend: a `Ref` to a type with deinit needs refcount release (not yet supported)")
                return LLVMConstInt(st.i64ty, 0U64, 0I32)
            }
        }
    }
    val pty: LLVMTypeRef = refPointeeTy(c: inout c, st: inout st, refTy: ty)
    val cell: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(pty), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
    // the pointee value (the `value` field).
    mut val valExpr: U64 = 0
    mut val mi: U64 = 0
    while mi < fields.count {
        if rangeEquals(bytes: c.bytes, start: fields[mi].nameStart, len: fields[mi].nameLen, kw: "value") {
            valExpr = fields[mi].value
            mi = fields.count
        } else {
            mi += 1
        }
    }
    mut val v: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: valExpr)
    if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
        v = coerceInt(st: inout st, v: v, target: pty, unsigned: false)
    }
    LLVMBuildStore(st.b, v, cell)
    return cell
}

// Build a struct value of LLVM type `sty` from def `sd`: each declared field
// (matched by name, or its default), under the active substitution env.
fn buildStructValue(c: inout Comp, st: inout LlvmCtx, sd: StructDef, sty: LLVMTypeRef, fields: Array[MakeField], errOffset: U64) -> LLVMValueRef {
    mut val agg: LLVMValueRef = LLVMGetUndef(sty)
    mut val fi: U64 = 0
    while fi < sd.fields.count {
        val fld: FieldDef = sd.fields[fi]
        mut val provided: Bool = false
        mut val valExpr: U64 = 0
        mut val mi: U64 = 0
        while mi < fields.count {
            if spansEqual(c: inout c, aStart: fields[mi].nameStart, aLen: fields[mi].nameLen, bStart: fld.nameStart, bLen: fld.nameLen) {
                provided = true
                valExpr = fields[mi].value
                mi = fields.count
            } else {
                mi += 1
            }
        }
        if provided {
        } else {
            if fld.hasDefault {
                valExpr = fld.defaultVal
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: errOffset), msg: "LLVM backend: missing struct field in construction")
                return agg
            }
        }
        agg = LLVMBuildInsertValue(st.b, agg, genFieldValue(c: inout c, st: inout st, valExpr: valExpr, fld: fld), fi, anon())
        fi += 1
    }
    return agg
}

// ---- expression emission ----
//
// Emit `id` and return its LLVM value. v1 handles integer literals, locals (a
// load from the alloca), arithmetic/comparison binaries, and calls. Anything else
// is rejected loudly (no silent miscompile) until its increment lands.
fn genLlvmExpr(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMValueRef {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int(val value, offset: _, val isBool, tyStart: _, tyLen: _, val isNeg) => {
            mut val ty: LLVMTypeRef = st.i64ty
            if isBool {
                ty = st.i1ty
            } else {
                // width from the literal's recovered type (typeOf folds in the
                // suffix and the checker-recorded context width exprIntCtx).
                val t: TypeInfo = typeOf(c: inout c, id: id)
                if t.kind == 0 {
                    ty = llvmScalarTy(c: inout c, st: inout st, tyStart: t.nameStart, tyLen: t.nameLen)
                }
            }
            val k: LLVMValueRef = LLVMConstInt(ty, value, 0I32)
            if isNeg {
                return LLVMBuildNeg(st.b, k, anon())
            }
            return k
        }
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return LLVMBuildLoad2(st.b, st.locTy[li], st.locPtr[li], anon())
            }
            // a bare reference to a free function (`val g = twice`): the closure
            // {thunk, env=null} value, where the thunk adapts it to the closure ABI.
            val fvi: U64 = firstFuncByName(c: inout c, nameStart: start, nameLen: len)
            if fvi < c.funcs.count {
                val ts: U64 = thunkSlot(st: inout st, fi: fvi)
                if ts < st.thunkIdx.count {
                    mut val cv: LLVMValueRef = LLVMGetUndef(st.closureTy)
                    cv = LLVMBuildInsertValue(st.b, cv, st.thunkVal[ts], 0U64, anon())
                    cv = LLVMBuildInsertValue(st.b, cv, LLVMConstNull(st.ptrty), 1U64, anon())
                    return cv
                }
            }
            compileErrorAt(line: lineOf(c: inout c, offset: start), msg: "LLVM backend: unknown identifier (only locals supported so far)")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            // String ==/!= compares bytes via a runtime call (the operands are
            // {ptr,i64} structs, not icmp-able).
            if op == opEq() || op == opNe() {
                if valueKind(c: inout c, st: inout st, id: lhs) == 1U64 {
                    return emitStrEq(c: inout c, st: inout st, op: op, lhs: lhs, rhs: rhs)
                }
            }
            // struct/enum arithmetic / bitwise / shift: dispatch to the user's
            // operator-trait witness assoc fn (`money + money` -> `Money.add`),
            // mirroring the C backend's emitBinTraitCall. A primitive lhs has no
            // aggregate witness (binWitnessFn -> none) and falls through.
            if isBinTraitOp(op: op) {
                val wfi: U64 = binWitnessFn(c: inout c, st: inout st, op: op, lhs: lhs, rhs: rhs)
                if wfi < c.funcs.count {
                    return emitWitnessCall(c: inout c, st: inout st, fi: wfi, lhs: lhs, rhs: rhs, binary: true)
                }
            }
            mut val l: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: lhs)
            mut val r: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: rhs)
            // struct ==/!= : structural (field-by-field) equality (the Eq witness).
            if op == opEq() || op == opNe() {
                val sidxE: U64 = exprStructIdx(c: inout c, st: inout st, id: lhs)
                if sidxE < c.structs.count {
                    if structEqSupported(c: inout c, st: inout st, sidx: sidxE) {
                        val eqv: LLVMValueRef = emitStructEq(c: inout c, st: inout st, a: l, b: r, sidx: sidxE)
                        if op == opNe() {
                            return LLVMBuildNot(st.b, eqv, anon())
                        }
                        return eqv
                    }
                }
                // enum ==/!= : a payload-less enum compares by tag (field 0). A
                // payload-carrying enum needs a per-variant switch (deferred).
                mut val eidE: U64 = exprEnumIdx(c: inout c, st: inout st, id: lhs)
                if eidE >= c.enums.count {
                    eidE = exprEnumIdx(c: inout c, st: inout st, id: rhs)
                }
                if eidE < c.enums.count {
                    if enumPayloadless(c: inout c, eid: eidE) {
                        val tagL: LLVMValueRef = LLVMBuildExtractValue(st.b, l, 0U64, anon())
                        val tagR: LLVMValueRef = LLVMBuildExtractValue(st.b, r, 0U64, anon())
                        mut val pred: U32 = llvmIntEq()
                        if op == opNe() {
                            pred = llvmIntNe()
                        }
                        return LLVMBuildICmp(st.b, pred, tagL, tagR, anon())
                    }
                    // a payload-carrying enum with all-scalar payloads: tag + word
                    // bit-equality (correct on the zero-initialized payload).
                    if enumEqWordable(c: inout c, st: inout st, eid: eidE) {
                        val eqv: LLVMValueRef = emitEnumEqWords(c: inout c, st: inout st, l: l, r: r, eid: eidE)
                        if op == opNe() {
                            return LLVMBuildNot(st.b, eqv, anon())
                        }
                        return eqv
                    }
                }
            }
            // struct ordering (`< <= > >=`): lexicographic field compare (the Ord
            // witness) -> an i32 ordering compared against 0.
            if op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                val sidxO: U64 = exprStructIdx(c: inout c, st: inout st, id: lhs)
                if sidxO < c.structs.count {
                    if structOrdSupported(c: inout c, st: inout st, sidx: sidxO) {
                        return emitStructOrdOp(c: inout c, st: inout st, op: op, a: l, b: r, sidx: sidxO)
                    }
                }
                // enum ordering (`< <= > >=`): tag-then-payload lexicographic compare.
                mut val eidO: U64 = exprEnumIdx(c: inout c, st: inout st, id: lhs)
                if eidO >= c.enums.count {
                    eidO = exprEnumIdx(c: inout c, st: inout st, id: rhs)
                }
                if eidO < c.enums.count {
                    if enumOrdSupported(c: inout c, st: inout st, eid: eidO) {
                        return emitEnumOrdOp(c: inout c, st: inout st, op: op, a: l, b: r, eid: eidO, sty: LLVMTypeOf(l))
                    }
                }
            }
            // any remaining struct/enum (aggregate) operand routes through an Eq/Ord
            // witness in the C backend; not modeled here — reject loudly rather than
            // emit an invalid icmp/arith on an aggregate.
            if LLVMGetTypeKind(LLVMTypeOf(l)) == 8U32 {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "LLVM backend: struct/enum operator (Eq/Ord/Add/... witness) not yet supported")
                return LLVMConstInt(st.i1ty, 0U64, 0I32)
            }
            // normalize operand widths: a context-less literal defaults to i64 but
            // may meet a narrower typed operand — extend the narrower to the wider
            // (using that operand's signedness) so the op is single-width.
            val wl: U32 = LLVMGetIntTypeWidth(LLVMTypeOf(l))
            val wr: U32 = LLVMGetIntTypeWidth(LLVMTypeOf(r))
            if wl < wr {
                l = coerceInt(st: inout st, v: l, target: LLVMTypeOf(r), unsigned: valueKind(c: inout c, st: inout st, id: lhs) == 3U64)
            } else {
                if wr < wl {
                    r = coerceInt(st: inout st, v: r, target: LLVMTypeOf(l), unsigned: valueKind(c: inout c, st: inout st, id: rhs) == 3U64)
                }
            }
            mut val uns: Bool = false
            if valueKind(c: inout c, st: inout st, id: lhs) == 3U64 { uns = true }
            if valueKind(c: inout c, st: inout st, id: rhs) == 3U64 { uns = true }
            return buildBinOpS(c: inout c, st: inout st, op: op, l: l, r: r, unsigned: uns)
        }
        Expr.Str(val start, val len) => {
            return genLlvmStr(c: inout c, st: inout st, start: start, len: len)
        }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            return genLlvmMake(c: inout c, st: inout st, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, ty: ty, fields: fields)
        }
        Expr.Array(val elems) => {
            mut val et: LLVMTypeRef = st.i64ty
            if elems.count > 0U64 {
                et = exprLlvmType(c: inout c, st: inout st, id: elems[0])
            }
            return genLlvmArrayLit(c: inout c, st: inout st, elems: elems, elemTy: et)
        }
        Expr.Index(val base, val index) => {
            return genLlvmIndex(c: inout c, st: inout st, base: base, index: index)
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            // `s.bytes` on a String: the String value IS the {ptr,i64} byte array
            // (same layout), so the view is the value itself (no copy).
            if isStringBytesField(c: inout c, st: inout st, base: base, nameStart: nameStart, nameLen: nameLen) {
                return genLlvmExpr(c: inout c, st: inout st, id: base)
            }
            // `arr.count` — an array's count is field 1.
            if exprIsArray(c: inout c, st: inout st, id: base) {
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "count") {
                    return LLVMBuildExtractValue(st.b, genLlvmExpr(c: inout c, st: inout st, id: base), 1U64, anon())
                }
            }
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    val fd: FieldDef = c.structs[sidx].fields[fidx]
                    val raw: LLVMValueRef = LLVMBuildExtractValue(st.b, genLlvmExpr(c: inout c, st: inout st, id: base), fidx, anon())
                    // a boxed (recursive) field holds a heap pointer; deref it to the
                    // boxed value (its pointee type comes from the field's TypeRef so a
                    // generic-instance field — Optional[Node] — resolves correctly).
                    if fieldIsBoxed(c: inout c, f: fd) {
                        return LLVMBuildLoad2(st.b, llvmTypeOfRef(c: inout c, st: inout st, ref: fd.ty), raw, anon())
                    }
                    return raw
                }
            }
            compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: field access only on a registered struct value (so far)")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
        Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => {
            // a closure literal is the {fn, env} fat pointer: the lambda-lifted
            // function plus its environment. A capturing closure heap-allocates an env
            // struct and copies each captured value (or the shared cell pointer for a
            // `mut val` capture) into it; a non-capturing one has a NULL env.
            val slot: U64 = closureSlot(st: inout st, id: id)
            if slot < st.cloIdx.count {
                mut val env: LLVMValueRef = LLVMConstNull(st.ptrty)
                val caps: Array[CaptureEntry] = closureCaptures(c: inout c, cloId: id)
                if caps.count > 0U64 {
                    val envTy: LLVMTypeRef = closureEnvTy(c: inout c, st: inout st, caps: caps)
                    env = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(envTy), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
                    mut val ci: U64 = 0
                    while ci < caps.count {
                        val cap: CaptureEntry = caps[ci]
                        val li: U64 = findLocal(c: inout c, st: inout st, start: cap.nameStart, len: cap.nameLen)
                        if li < st.nLocals {
                            // a boxed (mut) capture stores the cell pointer (the local
                            // already IS that pointer); a by-value capture stores the
                            // loaded value.
                            mut val cv2: LLVMValueRef = LLVMBuildLoad2(st.b, st.locTy[li], st.locPtr[li], anon())
                            LLVMBuildStore(st.b, cv2, LLVMBuildStructGEP2(st.b, envTy, env, ci, anon()))
                        }
                        ci += 1
                    }
                }
                mut val cv: LLVMValueRef = LLVMGetUndef(st.closureTy)
                cv = LLVMBuildInsertValue(st.b, cv, st.cloVal[slot], 0U64, anon())
                cv = LLVMBuildInsertValue(st.b, cv, env, 1U64, anon())
                return cv
            }
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: id)), msg: "LLVM backend: closure not declared")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
        Expr.Arrow(val base, val nameStart, val nameLen) => {
            // `r->field`: load the pointee struct from the cell and extract `field`
            // (an array field yields the {ptr,i64} value, whose buffer is shared, so
            // `r->arr[i] = v` mutates through any alias).
            val psidx: U64 = refPointeeStructIdx(c: inout c, st: inout st, base: base)
            if psidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: nameStart, len: nameLen)
                if fidx < c.structs[psidx].fields.count {
                    return LLVMBuildExtractValue(st.b, loadRefPointee(c: inout c, st: inout st, base: base), fidx, anon())
                }
            }
            compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: `->` only on a Ref to a registered struct (so far)")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            return genLlvmCall(c: inout c, st: inout st, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            return genLlvmMethod(c: inout c, st: inout st, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            return genLlvmIfExpr(c: inout c, st: inout st, cond: cond, thenBlk: thenBlk, elseBlk: elseBlk)
        }
        Expr.MatchExpr(val scrut, val arms) => {
            return genLlvmMatchExpr(c: inout c, st: inout st, scrut: scrut, arms: arms)
        }
        Expr.OptChain(val base, val memberStart, val memberLen) => {
            return genLlvmOptChain(c: inout c, st: inout st, base: base, memberStart: memberStart, memberLen: memberLen)
        }
        Expr.Try(val expr) => {
            return genLlvmTry(c: inout c, st: inout st, expr: expr)
        }
        Expr.Move(val operand, val isBorrow) => {
            // `move x` / `borrow x` lower to the operand's value; `move` additionally
            // marks the source local moved (so its deinit is not run here — the new
            // owner runs it). `borrow` leaves the source owned (a non-consuming read).
            val v: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: operand)
            if isBorrow {
            } else {
                match c.exprs[operand] {
                    Expr.Ident(start: val s, len: val l) => {
                        markLocalMoved(c: inout c, st: inout st, start: s, len: l)
                    }
                    _ => {}
                }
            }
            return v
        }
        Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
            // `x as T` (spec/12: lossless): an int-width conversion (sext if the
            // source is signed, zext if unsigned, or same width). Non-int / From
            // conversions are not yet modeled.
            val ov: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: operand)
            if LLVMGetTypeKind(LLVMTypeOf(ov)) == 8U32 {
                if kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen) == 1U64 {
                } else {
                    return coerceInt(st: inout st, v: ov, target: llvmScalarTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen), unsigned: valueKind(c: inout c, st: inout st, id: operand) == 3U64)
                }
            }
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "LLVM backend: this `as` conversion is not yet supported (int-width only)")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
        Expr.Unary(val op, val operand) => {
            // a struct/enum operand dispatches to its unary operator-trait witness
            // (`-money` -> `Money.neg(value:)`, `!switch` -> `Switch.not`). A
            // primitive operand has no aggregate witness and keeps the LLVM op.
            val uwfi: U64 = unaryWitnessFn(c: inout c, st: inout st, op: op, operand: operand)
            if uwfi < c.funcs.count {
                return emitWitnessCall(c: inout c, st: inout st, fi: uwfi, lhs: operand, rhs: operand, binary: false)
            }
            if op == opSub() {
                return LLVMBuildNeg(st.b, genLlvmExpr(c: inout c, st: inout st, id: operand), anon())
            }
            // `!` (Bool) and `~` (BitNot) are both LLVM `xor x, -1` (i1: flips the
            // single bit; iN: flips all bits).
            if op == opNot() || op == opBitNot() {
                return LLVMBuildNot(st.b, genLlvmExpr(c: inout c, st: inout st, id: operand), anon())
            }
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "LLVM backend: unary operator not yet supported")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
        _ => {
            eprint(text: "[exprform] ")
            eprint(text: exprFormName(c: inout c, id: id))
            eprint(text: "\n")
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: id)), msg: "LLVM backend: expression form not yet supported")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
    }
}

// (diagnostic) The name of an expression's arena variant.
fn exprFormName(c: inout Comp, id: U64) -> String {
    match c.exprs[id] {
        Expr.Index(base: _, index: _) => { return "Index" }
        Expr.Array(elems: _) => { return "Array" }
        Expr.Cast(operand: _, tyStart: _, tyLen: _, ty: _) => { return "Cast" }
        Expr.MatchExpr(scrut: _, arms: _) => { return "MatchExpr" }
        Expr.IfExpr(cond: _, thenBlk: _, elseBlk: _) => { return "IfExpr" }
        Expr.OptChain(base: _, memberStart: _, memberLen: _) => { return "OptChain" }
        Expr.Try(expr: _) => { return "Try" }
        Expr.Arrow(base: _, nameStart: _, nameLen: _) => { return "Arrow" }
        Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => { return "Closure" }
        Expr.Move(operand: _, isBorrow: _) => { return "Move" }
        Expr.Await(operand: _) => { return "Await" }
        _ => { return "other" }
    }
}

// Value-position `if cond { … give a } else { … give b }`: emit each branch
// block (its `give` sets st.giveValue), then a PHI merges the two results.
fn genLlvmIfExpr(c: inout Comp, st: inout LlvmCtx, cond: U64, thenBlk: U64, elseBlk: U64) -> LLVMValueRef {
    val cv: LLVMValueRef = genLlvmCond(c: inout c, st: inout st, id: cond)
    val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "vif.then"))
    val elseBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "vif.else"))
    val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "vif.end"))
    LLVMBuildCondBr(st.b, cv, thenBB, elseBB)
    LLVMPositionBuilderAtEnd(st.b, thenBB)
    st.terminated = false
    val markT: U64 = st.nLocals
    genLlvmBlock(c: inout c, st: inout st, id: thenBlk)
    st.nLocals = markT
    val thenVal: LLVMValueRef = st.giveValue
    val thenEnd: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    LLVMBuildBr(st.b, contBB)
    LLVMPositionBuilderAtEnd(st.b, elseBB)
    st.terminated = false
    val markE: U64 = st.nLocals
    genLlvmBlock(c: inout c, st: inout st, id: elseBlk)
    st.nLocals = markE
    val elseVal: LLVMValueRef = st.giveValue
    val elseEnd: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    LLVMBuildBr(st.b, contBB)
    LLVMPositionBuilderAtEnd(st.b, contBB)
    st.terminated = false
    val phi: LLVMValueRef = LLVMBuildPhi(st.b, LLVMTypeOf(thenVal), anon())
    mut val vals: Array[LLVMValueRef] = []
    vals.append(value: thenVal)
    // unify the else branch's width to the then branch (context-less literals).
    vals.append(value: coerceInt(st: inout st, v: elseVal, target: LLVMTypeOf(thenVal), unsigned: false))
    mut val blocks: Array[LLVMBasicBlockRef] = []
    blocks.append(value: thenEnd)
    blocks.append(value: elseEnd)
    LLVMAddIncoming(phi, arrayCPtr(vals), arrayCPtr(blocks), 2U64)
    return phi
}

// Value-position `match scrut { Pat => exprValue, ... }`: each arm body is an
// expression; a PHI over the arm blocks merges their values.
fn genLlvmMatchExpr(c: inout Comp, st: inout LlvmCtx, scrut: U64, arms: Array[MatchArm]) -> LLVMValueRef {
    val sv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: scrut)
    val sty: LLVMTypeRef = LLVMTypeOf(sv)
    // a value-position struct destructuring match (irrefutable, one arm): bind the
    // scrutinee's fields (under any generic env), then evaluate the arm expression.
    if arms.count > 0U64 {
        if arms[0].isStruct {
            val ssidx: U64 = exprStructIdx(c: inout c, st: inout st, id: scrut)
            val savedSP: Array[Bind] = c.curTypeParams
            val savedSA: Array[U64] = c.curTypeArgs
            val didSetS: Bool = setStructEnv(c: inout c, st: inout st, ref: exprTypeRef(c: inout c, st: inout st, id: scrut))
            val sslot0: LLVMValueRef = LLVMBuildAlloca(st.b, sty, anon())
            LLVMBuildStore(st.b, sv, sslot0)
            val mark0: U64 = st.nLocals
            bindStructPattern(c: inout c, st: inout st, sidx: ssidx, binds: arms[0].binds, scrutTy: sty, scrutSlot: sslot0)
            val rv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: arms[0].body)
            st.nLocals = mark0
            if didSetS {
                c.curTypeParams = savedSP
                c.curTypeArgs = savedSA
            }
            return rv
        }
    }
    // The scrutinee's enum instance ref. As in genLlvmMatch, the enum env is set
    // ONLY around bindMatchPayload, never for the arm bodies (which keep the outer
    // env so a body's `self.f` grounds against the enclosing method).
    val scrutRef: U64 = exprTypeRef(c: inout c, st: inout st, id: scrut)
    val savedVP: Array[Bind] = c.curTypeParams
    val savedVA: Array[U64] = c.curTypeArgs
    mut val eid: U64 = c.enums.count
    mut val ai0: U64 = 0
    while ai0 < arms.count {
        if arms[ai0].isWildcard {
        } else {
            if arms[ai0].isStruct {
            } else {
                if eid == c.enums.count {
                    eid = enumIdxByName(c: inout c, start: arms[ai0].enumStart, len: arms[ai0].enumLen)
                }
            }
        }
        ai0 += 1
    }
    if eid < c.enums.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: value-match is only supported on a registered enum (so far)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val sslot: LLVMValueRef = LLVMBuildAlloca(st.b, sty, anon())
    LLVMBuildStore(st.b, sv, sslot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, sty, sslot, 0U64, anon()), anon())
    val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "vmatch.end"))
    mut val checkBB: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    mut val lastWasWildcard: Bool = false
    mut val phiVals: Array[LLVMValueRef] = []
    mut val phiBlocks: Array[LLVMBasicBlockRef] = []
    mut val ai: U64 = 0
    while ai < arms.count {
        val arm: MatchArm = arms[ai]
        val armBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "varm"))
        LLVMPositionBuilderAtEnd(st.b, checkBB)
        if arm.isWildcard {
            LLVMBuildBr(st.b, armBB)
            lastWasWildcard = true
        } else {
            val vi: U64 = variantIndex(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
            val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "vmatch.next"))
            LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, vi, 0I32), anon()), armBB, nextBB)
            checkBB = nextBB
            lastWasWildcard = false
        }
        val saved: U64 = st.nLocals
        LLVMPositionBuilderAtEnd(st.b, armBB)
        st.terminated = false
        if arm.isWildcard {
        } else {
            val didB: Bool = setEnumEnv(c: inout c, st: inout st, ref: scrutRef)
            bindMatchPayload(c: inout c, st: inout st, eid: eid, arm: arm, scrutTy: sty, scrutSlot: sslot)
            if didB {
                c.curTypeParams = savedVP
                c.curTypeArgs = savedVA
            }
        }
        mut val armVal: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: arm.body)
        st.nLocals = saved
        // unify integer arm values to the first arm's width (a context-less literal
        // may default wider/narrower) so the PHI is single-typed.
        if phiVals.count > 0U64 {
            armVal = coerceInt(st: inout st, v: armVal, target: LLVMTypeOf(phiVals[0]), unsigned: false)
        }
        phiVals.append(value: armVal)
        phiBlocks.append(value: LLVMGetInsertBlock(st.b))
        LLVMBuildBr(st.b, contBB)
        ai += 1
    }
    if lastWasWildcard {
    } else {
        LLVMPositionBuilderAtEnd(st.b, checkBB)
        LLVMBuildUnreachable(st.b)
    }
    LLVMPositionBuilderAtEnd(st.b, contBB)
    st.terminated = false
    val phi: LLVMValueRef = LLVMBuildPhi(st.b, LLVMTypeOf(phiVals[0]), anon())
    LLVMAddIncoming(phi, arrayCPtr(phiVals), arrayCPtr(phiBlocks), phiVals.count)
    return phi
}

// `base?.member` (spec/12): read the Optional `base`; `Some(v)` yields
// `Some(v.member)`, `None` yields `None` (short-circuit). Result is `Optional[U]`
// where U is the member field type. Couples to @Std/Core Optional. The base and
// result Optional instances must both be registered generic enums.
fn genLlvmOptChain(c: inout Comp, st: inout LlvmCtx, base: U64, memberStart: U64, memberLen: U64) -> LLVMValueRef {
    // resolve the base Optional[T] instance via the LLVM-side type tracker (the
    // typed-AST cache typeOf relies on isn't populated in this backend).
    val baseRef: U64 = exprTypeRef(c: inout c, st: inout st, id: base)
    val bge: U64 = genEnumSlot(c: inout c, st: inout st, ref: baseRef)
    if bge < st.genEnumRefs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "LLVM backend: `?.` base must be a registered Optional instance")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val beid: U64 = st.genEnumDefs[bge]
    val bety: LLVMTypeRef = st.genEnumTys[bge]
    val ed: EnumDef = c.enums[beid]
    val someB: Bind = kwSpan(c: inout c, kw: "Some", kwLen: 4U64)
    val noneB: Bind = kwSpan(c: inout c, kw: "None", kwLen: 4U64)
    val someVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: someB.nameStart, variantLen: someB.nameLen)
    val noneVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: noneB.nameStart, variantLen: noneB.nameLen)
    // the inner element struct (Optional's arg0) and the member field index.
    val tRef: U64 = c.types[baseRef].args[0]
    val tName: TypeRef = c.types[tRef]
    val tSidx: U64 = structIndexByName(c: inout c, start: tName.nameStart, len: tName.nameLen)
    if tSidx < c.structs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "LLVM backend: `?.` element must be a registered struct")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val fidx: U64 = structFieldIndex(c: inout c, sidx: tSidx, start: memberStart, len: memberLen)
    if fidx < c.structs[tSidx].fields.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "LLVM backend: `?.` element has no such field")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    // result Optional[U] where U is the member field's type: build the ref and find
    // its registered instance (structural match in genEnumSlot).
    val memberFd: FieldDef = c.structs[tSidx].fields[fidx]
    mut val uRef: U64 = memberFd.ty
    if uRef == 0U64 {
        val noArgs: Array[U64] = []
        uRef = c.pushType(t: <TypeRef nameStart=memberFd.tyStart nameLen=memberFd.tyLen args=noArgs />)
    }
    mut val rArgs: Array[U64] = []
    rArgs.append(value: uRef)
    val rr: U64 = c.pushType(t: <TypeRef nameStart=ed.nameStart nameLen=ed.nameLen args=rArgs />)
    val rge: U64 = genEnumSlot(c: inout c, st: inout st, ref: rr)
    if rge < st.genEnumRefs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "LLVM backend: `?.` result Optional instance is not registered")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val reid: U64 = st.genEnumDefs[rge]
    val rety: LLVMTypeRef = st.genEnumTys[rge]
    val sv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: base)
    val sslot: LLVMValueRef = LLVMBuildAlloca(st.b, bety, anon())
    LLVMBuildStore(st.b, sv, sslot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, bety, sslot, 0U64, anon()), anon())
    val isSome: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, someVi, 0I32), anon())
    val resSlot: LLVMValueRef = LLVMBuildAlloca(st.b, rety, anon())
    val someBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "oc.some"))
    val noneBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "oc.none"))
    val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "oc.end"))
    LLVMBuildCondBr(st.b, isSome, someBB, noneBB)
    // Some: extract the inner value (under base env), read its member, rebuild Some.
    LLVMPositionBuilderAtEnd(st.b, someBB)
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val didB: Bool = setEnumEnv(c: inout c, st: inout st, ref: baseRef)
    val basePayloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: beid, vi: someVi)
    if didB { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    val payload: LLVMValueRef = LLVMBuildLoad2(st.b, basePayloadTy, LLVMBuildStructGEP2(st.b, bety, sslot, 1U64, anon()), anon())
    val innerVal: LLVMValueRef = LLVMBuildExtractValue(st.b, payload, 0U64, anon())
    val memberVal: LLVMValueRef = LLVMBuildExtractValue(st.b, innerVal, fidx, anon())
    val didR: Bool = setEnumEnv(c: inout c, st: inout st, ref: rr)
    mut val someArgs: Array[LLVMValueRef] = []
    someArgs.append(value: memberVal)
    val someResult: LLVMValueRef = buildEnumFromValues(c: inout c, st: inout st, eid: reid, ety: rety, vi: someVi, payloadVals: someArgs)
    if didR { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    LLVMBuildStore(st.b, someResult, resSlot)
    LLVMBuildBr(st.b, contBB)
    // None: rebuild None.
    LLVMPositionBuilderAtEnd(st.b, noneBB)
    mut val noneArgs: Array[LLVMValueRef] = []
    val noneResult: LLVMValueRef = buildEnumFromValues(c: inout c, st: inout st, eid: reid, ety: rety, vi: noneVi, payloadVals: noneArgs)
    LLVMBuildStore(st.b, noneResult, resSlot)
    LLVMBuildBr(st.b, contBB)
    LLVMPositionBuilderAtEnd(st.b, contBB)
    st.terminated = false
    return LLVMBuildLoad2(st.b, rety, resSlot, anon())
}

// `try expr` (spec/13): evaluate the Result `expr`; on `Err(e)` early-return the
// enclosing function's own Result with that error (first cut: matching error
// types — no `From` conversion yet); on `Ok(v)` yield `v` and continue. Couples
// to @Std/Core Result (Ok / Err). Only valid in a fn returning a Result.
fn genLlvmTry(c: inout Comp, st: inout LlvmCtx, expr: U64) -> LLVMValueRef {
    mut val exprRef: U64 = exprResultRef(c: inout c, st: inout st, id: expr)
    if exprRef == 0U64 {
        exprRef = exprTypeRef(c: inout c, st: inout st, id: expr)
    }
    val ege: U64 = genEnumSlot(c: inout c, st: inout st, ref: exprRef)
    val rge: U64 = genEnumSlot(c: inout c, st: inout st, ref: st.curRetRef)
    if ege < st.genEnumRefs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: expr)), msg: "LLVM backend: `try` needs a registered Result instance")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    if rge < st.genEnumRefs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: expr)), msg: "LLVM backend: `try` is only valid in a function returning a registered Result")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val eeid: U64 = st.genEnumDefs[ege]
    val eety: LLVMTypeRef = st.genEnumTys[ege]
    val reid: U64 = st.genEnumDefs[rge]
    val rety: LLVMTypeRef = st.genEnumTys[rge]
    val ed: EnumDef = c.enums[eeid]
    val okB: Bind = kwSpan(c: inout c, kw: "Ok", kwLen: 2U64)
    val errB: Bind = kwSpan(c: inout c, kw: "Err", kwLen: 3U64)
    val okVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: okB.nameStart, variantLen: okB.nameLen)
    val errVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: errB.nameStart, variantLen: errB.nameLen)
    val ev: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: expr)
    val eslot: LLVMValueRef = LLVMBuildAlloca(st.b, eety, anon())
    LLVMBuildStore(st.b, ev, eslot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, eety, eslot, 0U64, anon()), anon())
    val isErr: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, errVi, 0I32), anon())
    val errBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "try.err"))
    val okBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "try.ok"))
    LLVMBuildCondBr(st.b, isErr, errBB, okBB)
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    // Err: extract the error (source env), rebuild the function's Result Err, return.
    LLVMPositionBuilderAtEnd(st.b, errBB)
    val didE: Bool = setEnumEnv(c: inout c, st: inout st, ref: exprRef)
    val errPayloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eeid, vi: errVi)
    val errPayload: LLVMValueRef = LLVMBuildLoad2(st.b, errPayloadTy, LLVMBuildStructGEP2(st.b, eety, eslot, 1U64, anon()), anon())
    val errVal: LLVMValueRef = LLVMBuildExtractValue(st.b, errPayload, 0U64, anon())
    if didE { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    val didR: Bool = setEnumEnv(c: inout c, st: inout st, ref: st.curRetRef)
    mut val errArgs: Array[LLVMValueRef] = []
    errArgs.append(value: errVal)
    val retResult: LLVMValueRef = buildEnumFromValues(c: inout c, st: inout st, eid: reid, ety: rety, vi: errVi, payloadVals: errArgs)
    if didR { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    LLVMBuildRet(st.b, retResult)
    // Ok: extract and yield the value; control continues at okBB.
    LLVMPositionBuilderAtEnd(st.b, okBB)
    st.terminated = false
    val didO: Bool = setEnumEnv(c: inout c, st: inout st, ref: exprRef)
    val okPayloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eeid, vi: okVi)
    val okPayload: LLVMValueRef = LLVMBuildLoad2(st.b, okPayloadTy, LLVMBuildStructGEP2(st.b, eety, eslot, 1U64, anon()), anon())
    val okVal: LLVMValueRef = LLVMBuildExtractValue(st.b, okPayload, 0U64, anon())
    if didO { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    return okVal
}

// ---- arrays ----
//
// Recover an expression's LLVM type WITHOUT emitting (for element-type inference
// and array detection). Covers the common forms; falls back to i64.
fn exprLlvmType(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMTypeRef {
    match c.exprs[id] {
        Expr.Int(value: _, offset: _, val isBool, tyStart: _, tyLen: _, isNeg: _) => {
            if isBool { return st.i1ty }
            val t: TypeInfo = typeOf(c: inout c, id: id)
            if t.kind == 0 {
                return llvmScalarTy(c: inout c, st: inout st, tyStart: t.nameStart, tyLen: t.nameLen)
            }
            return st.i64ty
        }
        Expr.Str(start: _, len: _) => { return st.strty }
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locIsArr[li] {
                    return st.arrayTy
                }
                return st.locTy[li]
            }
            return st.i64ty
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    return llvmScalarTy(c: inout c, st: inout st, tyStart: c.structs[sidx].fields[fidx].tyStart, tyLen: c.structs[sidx].fields[fidx].tyLen)
                }
            }
            return st.i64ty
        }
        Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, val isEnum, ty: _, fields: _) => {
            return llvmScalarTy(c: inout c, st: inout st, tyStart: typeStart, tyLen: typeLen)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            val rsidx: U64 = exprStructIdx(c: inout c, st: inout st, id: recv)
            if rsidx < c.structs.count {
                val mfi: U64 = findMethod(c: inout c, recvStart: c.structs[rsidx].nameStart, recvLen: c.structs[rsidx].nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if mfi < c.funcs.count {
                    return llvmFnRetTy(c: inout c, st: inout st, f: c.funcs[mfi])
                }
            }
            return st.i64ty
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            val cfi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
            if cfi < c.funcs.count {
                return llvmFnRetTy(c: inout c, st: inout st, f: c.funcs[cfi])
            }
            return st.i64ty
        }
        Expr.Binary(val op, val lhs, rhs: _) => {
            if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                return st.i1ty
            }
            return exprLlvmType(c: inout c, st: inout st, id: lhs)
        }
        Expr.Unary(val op, val operand) => {
            if op == opNot() { return st.i1ty }
            return exprLlvmType(c: inout c, st: inout st, id: operand)
        }
        Expr.Array(elems: _) => { return st.arrayTy }
        _ => { return st.i64ty }
    }
}

// The element LLVM type of an array-typed expression (Ident local / literal).
fn exprArrElemTy(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMTypeRef {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locIsArr[li] {
                    return st.locElemTy[li]
                }
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            if isStringBytesField(c: inout c, st: inout st, base: base, nameStart: nameStart, nameLen: nameLen) {
                return st.i8ty
            }
        }
        Expr.Array(val elems) => {
            if elems.count > 0U64 {
                return exprLlvmType(c: inout c, st: inout st, id: elems[0])
            }
        }
        _ => {}
    }
    return st.i64ty
}

// `s.bytes` on a String value: String is `{i8*, i64}`, layout-identical to
// Array[U8] `{ptr, i64}`, so `.bytes` is the String value viewed as a U8 array
// (O(1), no copy — spec/02). The view's element type is i8 (unsigned).
fn isStringBytesField(c: inout Comp, st: inout LlvmCtx, base: U64, nameStart: U64, nameLen: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "bytes") {
        return valueKind(c: inout c, st: inout st, id: base) == 1U64
    }
    return false
}

// Whether an expression is array-typed (for routing `.count`/`.append`/index).
fn exprIsArray(c: inout Comp, st: inout LlvmCtx, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locIsArr[li]
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            if isStringBytesField(c: inout c, st: inout st, base: base, nameStart: nameStart, nameLen: nameLen) {
                return true
            }
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    val fd: FieldDef = c.structs[sidx].fields[fidx]
                    if fd.tyIsArray {
                        return true
                    }
                    // a generic field grounding to an array (`Box[Array[I32]].v`).
                    return fieldArrayElemRefUnderBase(c: inout c, st: inout st, base: base, fd: fd) != 0U64
                }
            }
        }
        Expr.Arrow(val base, val nameStart, val nameLen) => {
            val psidx: U64 = refPointeeStructIdx(c: inout c, st: inout st, base: base)
            if psidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: nameStart, len: nameLen)
                if fidx < c.structs[psidx].fields.count {
                    return c.structs[psidx].fields[fidx].tyIsArray
                }
            }
        }
        Expr.Array(elems: _) => { return true }
        Expr.Index(base: _, index: _) => {
            // a nested-array element (`m[i]` where m: Array[Array[I32]]): its element
            // type ref is itself an Array.
            val r: U64 = exprTypeRef(c: inout c, st: inout st, id: id)
            if r != 0U64 {
                return rangeEquals(bytes: c.bytes, start: c.types[r].nameStart, len: c.types[r].nameLen, kw: "Array")
            }
        }
        _ => {}
    }
    return false
}

// The element type of an array-typed receiver (Ident local / struct field).
fn arrElemTyOf(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMTypeRef {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locIsArr[li] { return st.locElemTy[li] }
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            if isStringBytesField(c: inout c, st: inout st, base: base, nameStart: nameStart, nameLen: nameLen) {
                return st.i8ty
            }
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    val fd: FieldDef = c.structs[sidx].fields[fidx]
                    // an array field's element type, resolved under the base's instance
                    // env (`Holder[I64].items : Array[Box[T]]` -> Box[I64]; a generic
                    // field `Box[Array[I32]].v` -> I32).
                    val er: U64 = fieldArrayElemRefUnderBase(c: inout c, st: inout st, base: base, fd: fd)
                    if er != 0U64 {
                        return llvmTypeOfRef(c: inout c, st: inout st, ref: er)
                    }
                    return llvmScalarTy(c: inout c, st: inout st, tyStart: fd.tyStart, tyLen: fd.tyLen)
                }
            }
        }
        Expr.Arrow(val base, val nameStart, val nameLen) => {
            val psidx: U64 = refPointeeStructIdx(c: inout c, st: inout st, base: base)
            if psidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: nameStart, len: nameLen)
                if fidx < c.structs[psidx].fields.count {
                    return llvmScalarTy(c: inout c, st: inout st, tyStart: c.structs[psidx].fields[fidx].tyStart, tyLen: c.structs[psidx].fields[fidx].tyLen)
                }
            }
        }
        Expr.Index(base: _, index: _) => {
            // a nested-array element's element type (`m[i]` -> the inner element of
            // m[i], e.g. i32 for m: Array[Array[I32]]): unwrap the element ref.
            val r: U64 = exprTypeRef(c: inout c, st: inout st, id: id)
            if r != 0U64 {
                val t: TypeRef = c.types[r]
                if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
                    if t.args.count > 0U64 {
                        return llvmTypeOfRef(c: inout c, st: inout st, ref: t.args[0])
                    }
                }
            }
        }
        _ => {}
    }
    return st.i64ty
}

// The element kind (0 int/signed, 1 String, 2 Bool, 3 unsigned) of an array-valued
// expression — for tracking an un-annotated array binding's element kind.
fn arrElemKindOf(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locIsArr[li] { return st.locElemKind[li] }
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            if isStringBytesField(c: inout c, st: inout st, base: base, nameStart: nameStart, nameLen: nameLen) {
                return 3U64
            }
        }
        _ => {}
    }
    return 0U64
}

// A pointer to the {ptr,i64} storage of an array place (an array local or an
// array struct field of a struct local), so `.append` can grow it in place.
// Returns LLVMConstNull(ptr) if not an addressable array place.
fn arrStoragePtr(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMValueRef {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locIsArr[li] { return st.locPtr[li] }
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
            if sidx < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: nameStart, len: nameLen)
                if fidx < c.structs[sidx].fields.count {
                    // GEP into the base local's storage using ITS tracked LLVM type
                    // (so a generic-struct field — Holder[I64].items — uses the gen
                    // struct type, not a non-generic structTys lookup that overflows).
                    match c.exprs[base] {
                        Expr.Ident(start: val bs, len: val bl) => {
                            val bli: U64 = findLocal(c: inout c, st: inout st, start: bs, len: bl)
                            if bli < st.nLocals {
                                return LLVMBuildStructGEP2(st.b, st.locTy[bli], st.locPtr[bli], fidx, anon())
                            }
                        }
                        _ => {}
                    }
                }
            }
        }
        _ => {}
    }
    return LLVMConstNull(st.ptrty)
}

// A pointer to a struct place's storage (an addressable struct local), or
// LLVMConstNull(ptr).
fn structPlacePtr(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMValueRef {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locPtr[li]
            }
        }
        _ => {}
    }
    return LLVMConstNull(st.ptrty)
}

// Build a struct/enum field value, honoring an array field's element type (so an
// array-literal field uses the field's element type, not i64-defaulted).
fn genFieldValue(c: inout Comp, st: inout LlvmCtx, valExpr: U64, fld: FieldDef) -> LLVMValueRef {
    if fld.tyIsArray {
        match c.exprs[valExpr] {
            Expr.Array(val elems) => {
                return genLlvmArrayLit(c: inout c, st: inout st, elems: elems, elemTy: llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen))
            }
            _ => {}
        }
        // value semantics: an array field initialized from a place (`<Holder items=a/>`)
        // copies the buffer so later mutation of the source leaves the struct's
        // field unchanged.
        mut val av: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: valExpr)
        if arrayExprIsPlace(c: inout c, id: valExpr) {
            av = copyArrayValue(c: inout c, st: inout st, arrVal: av, elemTy: llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen))
        }
        return av
    }
    // a boxed (recursive) struct field: build the value, heap-allocate a cell, store
    // it, and put the cell pointer in the struct (leaky, like Ref — no free yet).
    if fieldIsBoxed(c: inout c, f: fld) {
        // the boxed value is in the field's (pointee) type context, so a nested
        // un-suffixed JSX construction (`next=<Optional.Some … />`) infers its args.
        st.expectedTy = fld.ty
        val boxedVal: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: valExpr)
        val boxedTy: LLVMTypeRef = LLVMTypeOf(boxedVal)
        val cell: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(boxedTy), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
        LLVMBuildStore(st.b, boxedVal, cell)
        return cell
    }
    return coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: valExpr), tyStart: fld.tyStart, tyLen: fld.tyLen)
}

// Declare/cache `plew_rawbuf_alloc(i64 elemSize, i64 cap) -> ptr`.
fn rawbufAlloc(c: inout Comp, st: inout LlvmCtx, elemSize: LLVMValueRef, cap: LLVMValueRef) -> LLVMValueRef {
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.i64ty)
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(ptys), 2U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_rawbuf_alloc", nameId: 20U64, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: elemSize)
    av.append(value: cap)
    return LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 2U64, anon())
}

// Eager value-semantics copy of an array value `{data,count}`: allocate a fresh
// buffer of `count` elements (size from elemTy) and memcpy, returning the new
// `{newdata,count}`. Shallow — the elements themselves are bit-copied (correct for
// primitives / flat structs; a deep copy of array/Ref-bearing elements is a later
// ARC refinement). Used so binding/assigning an array from an existing place gives
// an independent value (`val b = a` then `a[0]=…` leaves b unchanged).
fn copyArrayValue(c: inout Comp, st: inout LlvmCtx, arrVal: LLVMValueRef, elemTy: LLVMTypeRef) -> LLVMValueRef {
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arrVal, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arrVal, 1U64, anon())
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    ptys.append(value: st.i64ty)
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(ptys), 3U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_arr_copy", nameId: 24U64, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: data)
    av.append(value: LLVMSizeOf(elemTy))
    av.append(value: count)
    val nd: LLVMValueRef = LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 3U64, anon())
    mut val agg: LLVMValueRef = LLVMGetUndef(st.arrayTy)
    agg = LLVMBuildInsertValue(st.b, agg, nd, 0U64, anon())
    agg = LLVMBuildInsertValue(st.b, agg, count, 1U64, anon())
    return agg
}

// Whether an array-valued expression is an existing PLACE (an array local or a
// struct field) — copying it makes a new independent owner (value semantics). A
// literal `[…]`, an append/call result, etc. already produce a fresh owned buffer
// and must NOT be re-copied.
fn arrayExprIsPlace(c: inout Comp, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Ident(start: _, len: _) => { return true }
        Expr.Field(base: _, nameStart: _, nameLen: _) => { return true }
        _ => { return false }
    }
}

// Deep value-semantics copy of a struct value `v` of struct `sidx`: the aggregate
// is already bit-copied (LLVM by-value), but each ARRAY field's buffer is shared,
// so copy it (and recurse into nested-struct fields) — `val y = x` then
// `x.items[0]=…` must leave y.items unchanged. Fields under a generic env resolve
// via the active substitution. Non-array/non-struct fields pass through unchanged.
fn deepCopyStructValue(c: inout Comp, st: inout LlvmCtx, v: LLVMValueRef, sidx: U64) -> LLVMValueRef {
    val sd: StructDef = c.structs[sidx]
    mut val agg: LLVMValueRef = v
    mut val fi: U64 = 0
    while fi < sd.fields.count {
        val fd: FieldDef = sd.fields[fi]
        // an array field (declared `Array[E]` or a type param grounding to one under
        // the active env): deep-copy the buffer.
        val er: U64 = arrayFieldElemRef(c: inout c, f: fd)
        if er != 0U64 {
            val elem: LLVMValueRef = LLVMBuildExtractValue(st.b, agg, fi, anon())
            val et: LLVMTypeRef = llvmTypeOfRef(c: inout c, st: inout st, ref: er)
            agg = LLVMBuildInsertValue(st.b, agg, copyArrayValue(c: inout c, st: inout st, arrVal: elem, elemTy: et), fi, anon())
        } else {
            if fieldIsBoxed(c: inout c, f: fd) {
                // a boxed (recursive) field is a shared heap pointer — leave it (deep
                // copy of the cyclic graph is a later ARC refinement).
            } else {
                val nsi: U64 = localStructIdxFor(c: inout c, st: inout st, start: fd.tyStart, len: fd.tyLen)
                if nsi < c.structs.count {
                    val elem: LLVMValueRef = LLVMBuildExtractValue(st.b, agg, fi, anon())
                    agg = LLVMBuildInsertValue(st.b, agg, deepCopyStructValue(c: inout c, st: inout st, v: elem, sidx: nsi), fi, anon())
                }
            }
        }
        fi += 1
    }
    return agg
}

// Whether a non-array expression is an existing struct PLACE (Ident/Field) whose
// value-copy must deep-copy array fields.
fn structExprIsPlace(c: inout Comp, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Ident(start: _, len: _) => { return true }
        Expr.Field(base: _, nameStart: _, nameLen: _) => { return true }
        _ => { return false }
    }
}

// Value-semantics copy of `rv` (the already-emitted value of `valueExpr`) when
// `valueExpr` is an existing array/struct PLACE being moved into a NEW owner
// (return, assignment RHS, a struct/array field initializer). A literal / call /
// append result already owns its buffer and is returned unchanged. Over-copying is
// observably harmless (value semantics shares nothing); under-copying miscompiles.
fn copyValueIfPlace(c: inout Comp, st: inout LlvmCtx, rv: LLVMValueRef, valueExpr: U64) -> LLVMValueRef {
    if exprIsArray(c: inout c, st: inout st, id: valueExpr) {
        if arrayExprIsPlace(c: inout c, id: valueExpr) {
            return copyArrayValue(c: inout c, st: inout st, arrVal: rv, elemTy: arrElemTyOf(c: inout c, st: inout st, id: valueExpr))
        }
        return rv
    }
    if structExprIsPlace(c: inout c, id: valueExpr) {
        val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: valueExpr)
        if sidx < c.structs.count {
            // set the value's generic instance env so a field of param type that
            // grounds to an array (`Box[Array[I32]].v`) is deep-copied.
            val ref: U64 = exprTypeRef(c: inout c, st: inout st, id: valueExpr)
            val savedP: Array[Bind] = c.curTypeParams
            val savedA: Array[U64] = c.curTypeArgs
            val didSet: Bool = setStructEnv(c: inout c, st: inout st, ref: ref)
            val copied: LLVMValueRef = deepCopyStructValue(c: inout c, st: inout st, v: rv, sidx: sidx)
            if didSet {
                c.curTypeParams = savedP
                c.curTypeArgs = savedA
            }
            return copied
        }
    }
    return rv
}

// Bounds-check `i` against `count` via the runtime (panics on out-of-range).
fn emitBoundsCheck(c: inout Comp, st: inout LlvmCtx, idx: LLVMValueRef, count: LLVMValueRef) {
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.i64ty)
    ptys.append(value: st.i64ty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(ptys), 2U64, 0I32)
    val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_bounds", nameId: 21U64, fnTy: fty)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: idx)
    av.append(value: count)
    LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 2U64, anon())
}

// GEP &data[i] for element type elemTy.
fn arrElemPtr(st: inout LlvmCtx, elemTy: LLVMTypeRef, data: LLVMValueRef, idx: LLVMValueRef) -> LLVMValueRef {
    mut val idxs: Array[LLVMValueRef] = []
    idxs.append(value: idx)
    return LLVMBuildGEP2(st.b, elemTy, data, arrayCPtr(idxs), 1U64, anon())
}

// Coerce an element value to the array's element type (int width only).
fn coerceElem(st: inout LlvmCtx, v: LLVMValueRef, elemTy: LLVMTypeRef) -> LLVMValueRef {
    if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
        if LLVMGetTypeKind(elemTy) == 8U32 {
            return coerceInt(st: inout st, v: v, target: elemTy, unsigned: false)
        }
    }
    return v
}

// Build an array literal `[e0, e1, ...]` of element type `elemTy` (provided by the
// caller from the annotation, or inferred from the first element) as a
// `{ ptr data, i64 count }` value.
fn genLlvmArrayLit(c: inout Comp, st: inout LlvmCtx, elems: Array[U64], elemTy: LLVMTypeRef) -> LLVMValueRef {
    mut val agg: LLVMValueRef = LLVMGetUndef(st.arrayTy)
    val n: U64 = elems.count
    if n == 0U64 {
        agg = LLVMBuildInsertValue(st.b, agg, LLVMConstNull(st.ptrty), 0U64, anon())
        agg = LLVMBuildInsertValue(st.b, agg, LLVMConstInt(st.i64ty, 0U64, 0I32), 1U64, anon())
        return agg
    }
    val data: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(elemTy), cap: LLVMConstInt(st.i64ty, n, 0I32))
    mut val i: U64 = 0
    while i < n {
        val ev: LLVMValueRef = coerceElem(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: elems[i]), elemTy: elemTy)
        LLVMBuildStore(st.b, ev, arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: LLVMConstInt(st.i64ty, i, 0I32)))
        i += 1
    }
    agg = LLVMBuildInsertValue(st.b, agg, data, 0U64, anon())
    agg = LLVMBuildInsertValue(st.b, agg, LLVMConstInt(st.i64ty, n, 0I32), 1U64, anon())
    return agg
}

// `arr[i]` read: bounds-checked element load.
fn genLlvmIndex(c: inout Comp, st: inout LlvmCtx, base: U64, index: U64) -> LLVMValueRef {
    // only a built-in Array is indexed directly; a user `Index`-impl subscript
    // (struct `g[i]`) desugars to `g.index(key: i)` via the Index witness (spec/12).
    if exprIsArray(c: inout c, st: inout st, id: base) {
    } else {
        val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
        if bsi < c.structs.count {
            if typeHasMethodNamed(c: inout c, typeStart: c.structs[bsi].nameStart, typeLen: c.structs[bsi].nameLen, name: "index") {
                val m: U64 = synthDictMethod(c: inout c, recv: base, name: "index", arg0Label: "key", arg0: index, hasArg1: false, arg1Label: "", arg1: 0)
                return genLlvmExpr(c: inout c, st: inout st, id: m)
            }
        }
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "LLVM backend: user Index subscript needs an `index` method")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: base)
    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: base)
    // the base must be an array {ptr,i64} aggregate; a non-aggregate here means a
    // nested array (Array[Array[T]]) or unsupported element typing — reject loudly
    // rather than extractvalue on a scalar (which crashes the LLVM builder).
    if LLVMGetTypeKind(LLVMTypeOf(arr)) == 10U32 {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "LLVM backend: nested arrays / this index form not yet supported")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
    val idx: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: index)
    emitBoundsCheck(c: inout c, st: inout st, idx: idx, count: count)
    return LLVMBuildLoad2(st.b, elemTy, arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: idx), anon())
}

// `arr.append(v)` on an array local: grow the buffer if full, store v at `count`,
// increment count (mutating the local's {data,count}). No CoW yet (shares buffer).
// The element TypeRef of an array-valued expression (an array local's
// locElemTypeRef, or a struct field's grounded element ref), or 0.
fn arrayExprElemRef(c: inout Comp, st: inout LlvmCtx, arrayExpr: U64) -> U64 {
    match c.exprs[arrayExpr] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locElemTypeRef[li]
            }
        }
        Expr.Field(base: val fb, nameStart: val fns, nameLen: val fnl) => {
            val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: fb)
            if bsi < c.structs.count {
                val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fns, len: fnl)
                if fidx < c.structs[bsi].fields.count {
                    return fieldArrayElemRefUnderBase(c: inout c, st: inout st, base: fb, fd: c.structs[bsi].fields[fidx])
                }
            }
        }
        _ => {}
    }
    return 0U64
}

fn genLlvmAppend(c: inout Comp, st: inout LlvmCtx, recv: U64, valueExpr: U64) -> LLVMValueRef {
    val arrPtr: LLVMValueRef = arrStoragePtr(c: inout c, st: inout st, id: recv)
    if LLVMIsNull(arrPtr) == 0I32 {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: append only on an array local / struct field (so far)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: recv)
    val dataPtr: LLVMValueRef = LLVMBuildStructGEP2(st.b, st.arrayTy, arrPtr, 0U64, anon())
    val countPtr: LLVMValueRef = LLVMBuildStructGEP2(st.b, st.arrayTy, arrPtr, 1U64, anon())
    val data: LLVMValueRef = LLVMBuildLoad2(st.b, st.ptrty, dataPtr, anon())
    val count: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, countPtr, anon())
    // newdata = plew_arr_grow(data, elemSize, count)
    mut val gtys: Array[LLVMTypeRef] = []
    gtys.append(value: st.ptrty)
    gtys.append(value: st.i64ty)
    gtys.append(value: st.i64ty)
    val gfty: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(gtys), 3U64, 0I32)
    val grow: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_arr_grow", nameId: 22U64, fnTy: gfty)
    mut val gav: Array[LLVMValueRef] = []
    gav.append(value: data)
    gav.append(value: LLVMSizeOf(elemTy))
    gav.append(value: count)
    val newdata: LLVMValueRef = LLVMBuildCall2(st.b, gfty, grow, arrayCPtr(gav), 3U64, anon())
    LLVMBuildStore(st.b, newdata, dataPtr)
    // build the appended value. An array-LITERAL appended to a nested array
    // (`m.append([1,2,3])` for m: Array[Array[I32]]) must use the inner element
    // type, not i64-defaulted — recover it from the receiver's element ref.
    mut val ev: LLVMValueRef = LLVMConstInt(st.i64ty, 0U64, 0I32)
    mut val builtLit: Bool = false
    match c.exprs[valueExpr] {
        Expr.Array(val elems) => {
            val recvElemRef: U64 = arrayExprElemRef(c: inout c, st: inout st, arrayExpr: recv)
            if recvElemRef != 0U64 {
                val ret: TypeRef = c.types[recvElemRef]
                if rangeEquals(bytes: c.bytes, start: ret.nameStart, len: ret.nameLen, kw: "Array") {
                    if ret.args.count > 0U64 {
                        ev = genLlvmArrayLit(c: inout c, st: inout st, elems: elems, elemTy: llvmTypeOfRef(c: inout c, st: inout st, ref: ret.args[0]))
                        builtLit = true
                    }
                }
            }
        }
        _ => {}
    }
    if builtLit {
    } else {
        ev = coerceElem(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: valueExpr), elemTy: elemTy)
    }
    LLVMBuildStore(st.b, ev, arrElemPtr(st: inout st, elemTy: elemTy, data: newdata, idx: count))
    LLVMBuildStore(st.b, LLVMBuildAdd(st.b, count, LLVMConstInt(st.i64ty, 1U64, 0I32), anon()), countPtr)
    return LLVMConstInt(st.i64ty, 0U64, 0I32)
}

// `arr.set(i:, value:)`: bounds-checked element store through the array's shared
// buffer (same place mutation as `arr[i] = v`; no CoW yet). Returns a unit value.
fn genLlvmArraySet(c: inout Comp, st: inout LlvmCtx, recv: U64, indexExpr: U64, valueExpr: U64) -> LLVMValueRef {
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: recv)
    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: recv)
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
    val idx: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: indexExpr)
    emitBoundsCheck(c: inout c, st: inout st, idx: idx, count: count)
    val ep: LLVMValueRef = arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: idx)
    val rv: LLVMValueRef = coerceElem(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: valueExpr), elemTy: elemTy)
    LLVMBuildStore(st.b, rv, ep)
    return LLVMConstInt(st.i64ty, 0U64, 0I32)
}

// The local index of an array-typed receiver Ident, or st.nLocals.
fn arrLocalIndex(c: inout Comp, st: inout LlvmCtx, id: U64) -> U64 {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                if st.locIsArr[li] {
                    return li
                }
            }
        }
        _ => {}
    }
    return st.nLocals
}

// Emit a condition expression as an i1. A comparison binary already yields i1; any
// other integer becomes `x != 0`.
fn genLlvmCond(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMValueRef {
    match c.exprs[id] {
        Expr.Binary(val op, lhs: _, rhs: _) => {
            if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
                return genLlvmExpr(c: inout c, st: inout st, id: id)
            }
        }
        _ => {}
    }
    val v: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: id)
    return LLVMBuildICmp(st.b, llvmIntNe(), v, LLVMConstInt(st.i1ty, 0U64, 0I32), anon())
}

// ---- iterator adapter (map/filter) construction ----
//
// `xs.map(f)` / `xs.filter(p)` are lazy combinators (@Std/Core Iterator provided
// methods): each just WRAPS the receiver iterator + the closure into an adapter
// struct (MapIter/FilterIter) whose `next()` does the work. The provided method
// has its own type param (B) and an associated-type `Item` in its signature —
// monomorphizing its body is hard — but the body is a one-line construction
// `<MapIter inner=self f=f />`, so we build the adapter inline at the call site
// instead. The adapter instance is already registered (front-end mono), found
// here by matching its first type arg (the inner) to the receiver's type.
//
// Find the registered adapter instance (head `headKw`, e.g. "MapIter") whose
// inner (arg0) is the receiver's type, or 0 if none (the receiver isn't a known
// Iterator feeding this combinator). Couples to the @Std/Core adapter names.
fn findAdapterInst(c: inout Comp, st: inout LlvmCtx, recv: U64, headKw: String) -> U64 {
    val recvRef: U64 = exprTypeRef(c: inout c, st: inout st, id: recv)
    val recvSidx: U64 = exprStructIdx(c: inout c, st: inout st, id: recv)
    mut val gi: U64 = 0
    while gi < c.genInsts.count {
        val ref: U64 = c.genInsts[gi]
        val t: TypeRef = c.types[ref]
        if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: headKw) {
            if t.args.count > 0U64 {
                val arg0: U64 = t.args[0]
                if recvRef != 0U64 {
                    if typeRefEq(c: inout c, a: arg0, b: recvRef) {
                        return ref
                    }
                } else {
                    if recvSidx < c.structs.count {
                        val a0: TypeRef = c.types[arg0]
                        if a0.args.count == 0U64 {
                            if spansEqual(c: inout c, aStart: a0.nameStart, aLen: a0.nameLen, bStart: c.structs[recvSidx].nameStart, bLen: c.structs[recvSidx].nameLen) {
                                return ref
                            }
                        }
                    }
                }
            }
        }
        gi += 1
    }
    return 0U64
}

// If `recv.name(args)` is a known iterator combinator (`map`/`filter`), the
// registered adapter instance it produces, else 0. (The head names couple to
// @Std/Core's MapIter / FilterIter.)
fn adapterCallResultInst(c: inout Comp, st: inout LlvmCtx, recv: U64, nameStart: U64, nameLen: U64) -> U64 {
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "map") {
        return findAdapterInst(c: inout c, st: inout st, recv: recv, headKw: "MapIter")
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "filter") {
        return findAdapterInst(c: inout c, st: inout st, recv: recv, headKw: "FilterIter")
    }
    return 0U64
}

// Build the adapter struct value inline: field 0 (the inner) = the receiver, the
// remaining fields = the method args in order (map's `f`, filter's `p`), under the
// adapter instance's substitution env. Mirrors the provided method's one-line body
// `<MapIter inner=self f=f />` with `self` = the receiver.
fn genLlvmAdapterWrap(c: inout Comp, st: inout LlvmCtx, recv: U64, args: Array[Arg], adapterRef: U64) -> LLVMValueRef {
    val gslot: U64 = genStructSlot(c: inout c, st: inout st, ref: adapterRef)
    if gslot < st.genStructRefs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: iterator adapter struct is not registered")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val sd: StructDef = c.structs[st.genStructDefs[gslot]]
    mut val fields: Array[MakeField] = []
    // field 0 = inner = the receiver expression.
    fields.append(value: <MakeField nameStart=sd.fields[0].nameStart nameLen=sd.fields[0].nameLen value=recv />)
    mut val i: U64 = 1
    while i < sd.fields.count {
        if i - 1U64 < args.count {
            fields.append(value: <MakeField nameStart=sd.fields[i].nameStart nameLen=sd.fields[i].nameLen value=args[i - 1U64].expr />)
        }
        i += 1
    }
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    c.curTypeParams = sd.typeParams
    c.curTypeArgs = c.types[adapterRef].args
    val v: LLVMValueRef = buildStructValue(c: inout c, st: inout st, sd: sd, sty: st.genStructTys[gslot], fields: fields, errOffset: exprOffset(c: inout c, id: recv))
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
    return v
}

// ---- call emission ----
//
// Resolve the callee like the C backend (findFunc), then lower it. v1 supports the
// `exit` intrinsic only; other callees are rejected loudly until their increment.
// The LLVM function type of a `fn(...) -> R` TypeRef under the closure ABI: env
// pointer first, then the declared params, returning R (void for a `()` return).
// fn TypeRef args = [retTy, paramTy0, paramTy1, ...].
fn closureLlvmFnTy(c: inout Comp, st: inout LlvmCtx, fnRef: U64) -> LLVMTypeRef {
    val t: TypeRef = c.types[fnRef]
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    mut val i: U64 = 1
    while i < t.args.count {
        ptys.append(value: llvmTypeOfRef(c: inout c, st: inout st, ref: t.args[i]))
        i += 1
    }
    mut val rty: LLVMTypeRef = st.voidty
    if t.args.count > 0U64 {
        val rt: TypeRef = c.types[t.args[0]]
        // a `()` return (the unnamed unit record) is void; any named type is a value.
        if rt.nameLen == 0U64 {
        } else {
            rty = llvmTypeOfRef(c: inout c, st: inout st, ref: t.args[0])
        }
    }
    return LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count, 0I32)
}

// Emit an indirect call of a closure VALUE (the {fn, env} aggregate) of type fnRef:
// extract the function pointer + environment, then call fn(env, coerced-args...).
fn emitClosureCallValue(c: inout Comp, st: inout LlvmCtx, cloVal: LLVMValueRef, fnRef: U64, args: Array[Arg]) -> LLVMValueRef {
    val fnPtr: LLVMValueRef = LLVMBuildExtractValue(st.b, cloVal, 0U64, anon())
    val env: LLVMValueRef = LLVMBuildExtractValue(st.b, cloVal, 1U64, anon())
    val fty: LLVMTypeRef = closureLlvmFnTy(c: inout c, st: inout st, fnRef: fnRef)
    val ft: TypeRef = c.types[fnRef]
    mut val av: Array[LLVMValueRef] = []
    av.append(value: env)
    mut val i: U64 = 0
    while i < args.count {
        mut val v: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: args[i].expr)
        // coerce an int arg to the declared param width (fn args = [ret, p0, p1, …]).
        if i + 1U64 < ft.args.count {
            if LLVMGetTypeKind(LLVMTypeOf(v)) == 8U32 {
                val pt: TypeRef = c.types[ft.args[i + 1U64]]
                v = coerceInt(st: inout st, v: v, target: llvmTypeOfRef(c: inout c, st: inout st, ref: ft.args[i + 1U64]), unsigned: isUnsignedName(c: inout c, start: pt.nameStart, len: pt.nameLen))
            }
        }
        av.append(value: v)
        i += 1
    }
    return LLVMBuildCall2(st.b, fty, fnPtr, arrayCPtr(av), av.count, anon())
}

// Emit an indirect closure call where the callee is closure-typed local `li`.
fn genLlvmClosureCall(c: inout Comp, st: inout LlvmCtx, li: U64, args: Array[Arg]) -> LLVMValueRef {
    val cloVal: LLVMValueRef = LLVMBuildLoad2(st.b, st.closureTy, st.locPtr[li], anon())
    return emitClosureCallValue(c: inout c, st: inout st, cloVal: cloVal, fnRef: st.locTypeRef[li], args: args)
}

fn genLlvmCall(c: inout Comp, st: inout LlvmCtx, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
    // a call whose "name" is a closure-typed local (`g(n: 4)` where g: fn(...)) is
    // an indirect call: load the {fn, env} value, then call fn(env, args).
    val cli: U64 = findLocal(c: inout c, st: inout st, start: nameStart, len: nameLen)
    if cli < st.nLocals {
        if isFnType(c: inout c, ref: st.locTypeRef[cli]) {
            return genLlvmClosureCall(c: inout c, st: inout st, li: cli, args: args)
        }
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "print") {
        return emitPrint(c: inout c, st: inout st, argExpr: args[0].expr)
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") {
        return emitStrSink(c: inout c, st: inout st, rtName: "plew_write_raw", rtId: 2U64, argExpr: args[0].expr)
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "eprint") {
        return emitStrSink(c: inout c, st: inout st, rtName: "plew_eprint_raw", rtId: 3U64, argExpr: args[0].expr)
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "assert") {
        // assert(cond): branch to a panic block when the condition is false.
        val cond: LLVMValueRef = genLlvmCond(c: inout c, st: inout st, id: args[0].expr)
        val okBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "assert.ok"))
        val failBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "assert.fail"))
        LLVMBuildCondBr(st.b, cond, okBB, failBB)
        LLVMPositionBuilderAtEnd(st.b, failBB)
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(value: st.ptrty)
        ptys.append(value: st.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(ptys), 2U64, 0I32)
        val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_panic_raw", nameId: 4U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(value: LLVMBuildGlobalStringPtr(st.b, cstr(s: "assertion failed"), anon()))
        av.append(value: LLVMConstInt(st.i64ty, 16U64, 0I32))
        LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 2U64, anon())
        LLVMBuildUnreachable(st.b)
        LLVMPositionBuilderAtEnd(st.b, okBB)
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "exit") {
        // void plew_exit(i64): truncate-free (the code is already i64), then call.
        mut val ptys: Array[LLVMTypeRef] = []
        ptys.append(value: st.i64ty)
        val fty: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(ptys), 1U64, 0I32)
        val callee: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_exit", nameId: 1U64, fnTy: fty)
        mut val av: Array[LLVMValueRef] = []
        av.append(value: extendToI64(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: args[0].expr), unsigned: valueKind(c: inout c, st: inout st, id: args[0].expr) == 3U64))
        return LLVMBuildCall2(st.b, fty, callee, arrayCPtr(av), 1U64, anon())
    }
    // a user-defined free function: resolve like the C backend, then call the
    // cached LLVMValueRef (declared in pass 1). Generic / extern / overload cases
    // beyond a plain match arrive in later increments.
    val cfi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
    if cfi < c.funcs.count {
        val slot: U64 = userFnSlot(st: inout st, idx: cfi)
        if slot < st.fnIdx.count {
            val cf: Func = c.funcs[cfi]
            mut val av2: Array[LLVMValueRef] = []
            mut val ai: U64 = 0
            while ai < args.count {
                // coerce each argument to the parameter's integer width.
                av2.append(value: genArgValue(c: inout c, st: inout st, argExpr: args[ai].expr, p: cf.params[ai]))
                ai += 1
            }
            // fill omitted trailing params with their default expressions (spec/04).
            mut val di: U64 = args.count
            while di < cf.params.count {
                av2.append(value: genArgValue(c: inout c, st: inout st, argExpr: cf.params[di].defaultExpr, p: cf.params[di]))
                di += 1
            }
            return LLVMBuildCall2(st.b, st.fnTy[slot], st.fnVal[slot], arrayCPtr(av2), av2.count, anon())
        }
        // a generic free-function call: infer its concrete type args, find the
        // instance, build args under the instance env, and call it.
        if isGenericFreeFn(c: inout c, fi: cfi) {
            val inferred: Array[U64] = llvmInferFnArgs(c: inout c, st: inout st, f: c.funcs[cfi], args: args)
            val gslot: U64 = genFnSlotFor(c: inout c, fnIdx: cfi, args: inferred, st: inout st)
            if gslot < st.genFnK.count {
                val cf: Func = c.funcs[cfi]
                val savedP: Array[Bind] = c.curTypeParams
                val savedA: Array[U64] = c.curTypeArgs
                c.curTypeParams = cf.typeParams
                c.curTypeArgs = inferred
                mut val av3: Array[LLVMValueRef] = []
                mut val ai3: U64 = 0
                while ai3 < args.count {
                    av3.append(value: genArgValue(c: inout c, st: inout st, argExpr: args[ai3].expr, p: cf.params[ai3]))
                    ai3 += 1
                }
                mut val di3: U64 = args.count
                while di3 < cf.params.count {
                    av3.append(value: genArgValue(c: inout c, st: inout st, argExpr: cf.params[di3].defaultExpr, p: cf.params[di3]))
                    di3 += 1
                }
                c.curTypeParams = savedP
                c.curTypeArgs = savedA
                return LLVMBuildCall2(st.b, st.genFnTy[gslot], st.genFnVal[gslot], arrayCPtr(av3), av3.count, anon())
            }
        }
    }
    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: this call is not yet supported (intrinsic or plain user function only)")
    return LLVMConstInt(st.i64ty, 0U64, 0I32)
}

// Emit a method call `recv.m(args)`: resolve the method on the receiver's struct,
// pass self first (a pointer for `inout fn`, else the struct value), then the
// coerced arguments, and call the cached LLVMValueRef.
fn genLlvmMethod(c: inout Comp, st: inout LlvmCtx, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
    // associated-function call `Type.name(args)` (the receiver is a type name, not
    // a value): dispatch to the assoc fn (no self argument).
    val arn: Bind = assocRecvName(c: inout c, recv: recv)
    if arn.nameLen != 0U64 {
        // a primitive numeric operator witness (`I32.add(lhs:, rhs:)`, `I64.neg(value:)`)
        // lowers straight to the LLVM op rather than emitting the std witness body
        // (which bottoms out in intrinsics). The result type / signedness is the
        // receiver primitive's.
        if isPrimIntName(c: inout c, start: arn.nameStart, len: arn.nameLen) {
            val pv: LLVMValueRef = genPrimOpWitness(c: inout c, st: inout st, tyStart: arn.nameStart, tyLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if LLVMIsNull(pv) == 0I32 {
                return pv
            }
        }
        val afi: U64 = findAssoc(c: inout c, recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        if afi < c.funcs.count {
            val aslot: U64 = userFnSlot(st: inout st, idx: afi)
            if aslot < st.fnIdx.count {
                val af: Func = c.funcs[afi]
                mut val aav: Array[LLVMValueRef] = []
                mut val aai: U64 = 0
                while aai < args.count {
                    aav.append(value: genArgValue(c: inout c, st: inout st, argExpr: args[aai].expr, p: af.params[aai]))
                    aai += 1
                }
                mut val adi: U64 = args.count
                while adi < af.params.count {
                    aav.append(value: genArgValue(c: inout c, st: inout st, argExpr: af.params[adi].defaultExpr, p: af.params[adi]))
                    adi += 1
                }
                return LLVMBuildCall2(st.b, st.fnTy[aslot], st.fnVal[aslot], arrayCPtr(aav), aav.count, anon())
            }
            compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: this assoc fn is not emittable yet (generic / std / trait)")
            return LLVMConstInt(st.i64ty, 0U64, 0I32)
        }
    }
    // iterator combinator (`xs.map(f)` / `xs.filter(p)`): build the lazy adapter
    // struct inline (it just wraps the receiver + closure), bypassing the provided
    // method's body (which has method-own type params + an associated type).
    val adapterRef: U64 = adapterCallResultInst(c: inout c, st: inout st, recv: recv, nameStart: nameStart, nameLen: nameLen)
    if adapterRef != 0U64 {
        return genLlvmAdapterWrap(c: inout c, st: inout st, recv: recv, args: args, adapterRef: adapterRef)
    }
    // generic-receiver method dispatch (`box.get()`, `maybe.unwrapOr(...)`): the
    // receiver local carries its instantiation ref; route to the monomorphized
    // method instance emitted by declareGenMethods.
    val recvRef: U64 = exprTypeRef(c: inout c, st: inout st, id: recv)
    if recvRef != 0U64 {
        val rtnm: TypeRef = c.types[recvRef]
        if isGenericInst(c: inout c, ref: recvRef) && !rangeEquals(bytes: c.bytes, start: rtnm.nameStart, len: rtnm.nameLen, kw: "Array") {
            val grt: TypeRef = c.types[recvRef]
            val gmfi: U64 = findMethod(c: inout c, recvStart: grt.nameStart, recvLen: grt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if gmfi < c.funcs.count {
                val gslot: U64 = ensureGenMethodDeclared(c: inout c, st: inout st, mfi: gmfi, instRef: recvRef)
                if gslot < st.genMethK.count {
                    return genGenMethodCall(c: inout c, st: inout st, recv: recv, mfi: gmfi, slot: gslot, instRef: recvRef, args: args)
                }
                compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: this generic method is not emittable yet (provided / std / method-own type params)")
                return LLVMConstInt(st.i64ty, 0U64, 0I32)
            }
        }
    }
    // array methods (append / get / set; user methods on Array are TODO).
    if exprIsArray(c: inout c, st: inout st, id: recv) {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "append") {
            return genLlvmAppend(c: inout c, st: inout st, recv: recv, valueExpr: args[0].expr)
        }
        // `arr.get(i:)` is the prelude's checked element read (same as `arr[i]`).
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "get") {
            return genLlvmIndex(c: inout c, st: inout st, base: recv, index: args[0].expr)
        }
        // `arr.set(i:, value:)` is the prelude's checked element write (`arr[i]=v`).
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "set") {
            return genLlvmArraySet(c: inout c, st: inout st, recv: recv, indexExpr: args[0].expr, valueExpr: args[1].expr)
        }
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: this array method is not yet supported (append / get / set)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    // wrapping arithmetic on a primitive integer receiver: two's-complement wrap
    // is LLVM's default add/sub/mul (no overflow check), so `x.wrappingAdd(by: y)`
    // is a plain op at the receiver's width. (Checked `+`/`-`/`*` aren't modeled
    // here yet either, so the distinction is currently a no-op — but routing the
    // method keeps the call accepted and correct on wraparound.)
    mut val wop: I64 = -1I64
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "wrappingAdd") { wop = opAdd() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "wrappingSub") { wop = opSub() }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "wrappingMul") { wop = opMul() }
    if wop != -1I64 {
        val rv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: recv)
        if LLVMGetTypeKind(LLVMTypeOf(rv)) == 8U32 {
            val uns: Bool = valueKind(c: inout c, st: inout st, id: recv) == 3U64
            val bv: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: args[0].expr), target: LLVMTypeOf(rv), unsigned: uns)
            return buildBinOpS(c: inout c, st: inout st, op: wop, l: rv, r: bv, unsigned: uns)
        }
    }
    val rsidx: U64 = exprStructIdx(c: inout c, st: inout st, id: recv)
    if rsidx < c.structs.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: method call only on a registered struct value (so far)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val sd: StructDef = c.structs[rsidx]
    val mfi: U64 = findMethod(c: inout c, recvStart: sd.nameStart, recvLen: sd.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
    if mfi < c.funcs.count {
    } else {
        // `self.f(n: x)` where `f` is a closure-typed field (the iterator-adapter
        // pattern — a struct holds a mapping/predicate closure): load the field value
        // and call it indirectly. The field type grounds through any generic env.
        val ffi: U64 = structFieldIndex(c: inout c, sidx: rsidx, start: nameStart, len: nameLen)
        if ffi < sd.fields.count {
            val grounded: U64 = groundTypeRef(c: inout c, ref: sd.fields[ffi].ty)
            if isFnType(c: inout c, ref: grounded) {
                val recvVal: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: recv)
                val cloVal: LLVMValueRef = LLVMBuildExtractValue(st.b, recvVal, ffi, anon())
                return emitClosureCallValue(c: inout c, st: inout st, cloVal: cloVal, fnRef: grounded, args: args)
            }
        }
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: method not found / not yet supported")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    mut val slot: U64 = userFnSlot(st: inout st, idx: mfi)
    // a provided trait method is declared+queued lazily the first time it is called.
    if slot < st.fnIdx.count {
    } else {
        if c.funcs[mfi].isProvided {
            slot = ensureProvidedDeclared(c: inout c, st: inout st, fi: mfi)
        }
    }
    if slot < st.fnIdx.count {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: this method is not emittable yet (generic / provided / trait receiver)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val mf: Func = c.funcs[mfi]
    // a `move fn` consumes self (its deinit runs in the callee): mark the receiver
    // local moved so the caller does not also deinit it.
    if mf.selfMove {
        match c.exprs[recv] {
            Expr.Ident(start: val s, len: val l) => {
                markLocalMoved(c: inout c, st: inout st, start: s, len: l)
            }
            _ => {}
        }
    }
    mut val av: Array[LLVMValueRef] = []
    // self: an `inout fn` needs the receiver's address (a place); else its value.
    if mf.selfInout {
        av.append(value: placePtrOf(c: inout c, st: inout st, id: recv))
    } else {
        av.append(value: genLlvmExpr(c: inout c, st: inout st, id: recv))
    }
    mut val ai: U64 = 0
    while ai < args.count {
        av.append(value: genArgValue(c: inout c, st: inout st, argExpr: args[ai].expr, p: mf.params[ai]))
        ai += 1
    }
    mut val di: U64 = args.count
    while di < mf.params.count {
        av.append(value: genArgValue(c: inout c, st: inout st, argExpr: mf.params[di].defaultExpr, p: mf.params[di]))
        di += 1
    }
    return LLVMBuildCall2(st.b, st.fnTy[slot], st.fnVal[slot], arrayCPtr(av), av.count, anon())
}

// Emit a call to a monomorphized generic method (slot in st.genMeth*). The self
// value is built in the caller's context; the call arguments are built under the
// receiver's substitution env (so a `fallback: T` arg coerces to the instance's
// concrete type).
fn genGenMethodCall(c: inout Comp, st: inout LlvmCtx, recv: U64, mfi: U64, slot: U64, instRef: U64, args: Array[Arg]) -> LLVMValueRef {
    val mf: Func = c.funcs[mfi]
    mut val av: Array[LLVMValueRef] = []
    if mf.selfInout {
        av.append(value: placePtrOf(c: inout c, st: inout st, id: recv))
    } else {
        av.append(value: genLlvmExpr(c: inout c, st: inout st, id: recv))
    }
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    c.curTypeParams = mf.typeParams
    c.curTypeArgs = c.types[instRef].args
    mut val ai: U64 = 0
    while ai < args.count {
        av.append(value: genArgValue(c: inout c, st: inout st, argExpr: args[ai].expr, p: mf.params[ai]))
        ai += 1
    }
    mut val di: U64 = args.count
    while di < mf.params.count {
        av.append(value: genArgValue(c: inout c, st: inout st, argExpr: mf.params[di].defaultExpr, p: mf.params[di]))
        di += 1
    }
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
    return LLVMBuildCall2(st.b, st.genMethTy[slot], st.genMethVal[slot], arrayCPtr(av), av.count, anon())
}

// The address of an addressable place (a struct local), for `inout` self. Falls
// back to a fresh alloca holding the value for a non-place receiver.
// The LLVM struct type of a struct-valued expression `structExpr` (def `sidx`):
// its generic instance type if it carries one, else the registered non-generic
// type. LLVMConstNull(ptr) if neither (so the caller can fall back / error).
fn structLlvmTyOfExpr(c: inout Comp, st: inout LlvmCtx, structExpr: U64, sidx: U64) -> LLVMTypeRef {
    val ref: U64 = exprTypeRef(c: inout c, st: inout st, id: structExpr)
    if ref != 0U64 {
        if isGenericInst(c: inout c, ref: ref) {
            val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: ref)
            if gs < st.genStructRefs.count {
                return st.genStructTys[gs]
            }
        }
    }
    val reg: U64 = structRegSlot(c: inout c, st: inout st, start: c.structs[sidx].nameStart, len: c.structs[sidx].nameLen)
    if reg < st.structIdxs.count {
        return st.structTys[reg]
    }
    return LLVMConstNull(st.ptrty)
}

fn placePtrOf(c: inout Comp, st: inout LlvmCtx, id: U64) -> LLVMValueRef {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => {
            val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
            if li < st.nLocals {
                return st.locPtr[li]
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            // a field place `self.inner` (the adapter pattern: `self.inner.next()`
            // with `inout` next): GEP into the base's storage so the callee mutates
            // in place, not a copy. The base must be an addressable struct local.
            match c.exprs[base] {
                Expr.Ident(start: val bs, len: val bl) => {
                    val bli: U64 = findLocal(c: inout c, st: inout st, start: bs, len: bl)
                    val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: base)
                    if bli < st.nLocals && bsi < c.structs.count {
                        val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: nameStart, len: nameLen)
                        if fidx < c.structs[bsi].fields.count {
                            return LLVMBuildStructGEP2(st.b, st.locTy[bli], st.locPtr[bli], fidx, anon())
                        }
                    }
                }
                _ => {}
            }
        }
        Expr.Index(val base, val index) => {
            // an array element place `xs[i]` (get-modify-set: `xs[i].bump()` with an
            // `inout` method): the element pointer into the owned buffer, so the
            // callee mutates in place. (The buffer is owned — value-semantics CoW
            // already split any alias — so direct mutation is observably correct.)
            if exprIsArray(c: inout c, st: inout st, id: base) {
                val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: base)
                val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: base)
                val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
                val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
                val idx: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: index)
                emitBoundsCheck(c: inout c, st: inout st, idx: idx, count: count)
                return arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: idx)
            }
        }
        _ => {}
    }
    val v: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: id)
    val slot: LLVMValueRef = LLVMBuildAlloca(st.b, LLVMTypeOf(v), anon())
    LLVMBuildStore(st.b, v, slot)
    return slot
}

// Emit a call argument for a parameter `p`: an array-literal arg is built with the
// parameter's element type (so `[10,20]` for an `Array[I32]` param uses i32, not
// i64-defaulted elements); a scalar arg is width-coerced to the parameter type.
fn genArgValue(c: inout Comp, st: inout LlvmCtx, argExpr: U64, p: Param) -> LLVMValueRef {
    if p.isInout {
        // pass the caller's place address (the callee mutates in place).
        return placePtrOf(c: inout c, st: inout st, id: argExpr)
    }
    // a `move` parameter consumes the argument — the callee owns it and runs
    // deinit, so mark the source local moved (excluded from the caller's drop).
    if p.isMove {
        match c.exprs[argExpr] {
            Expr.Ident(start: val s, len: val l) => {
                markLocalMoved(c: inout c, st: inout st, start: s, len: l)
            }
            _ => {}
        }
    }
    if p.tyIsArray {
        match c.exprs[argExpr] {
            Expr.Array(val elems) => {
                return genLlvmArrayLit(c: inout c, st: inout st, elems: elems, elemTy: llvmScalarTy(c: inout c, st: inout st, tyStart: p.tyStart, tyLen: p.tyLen))
            }
            _ => {}
        }
        return genLlvmExpr(c: inout c, st: inout st, id: argExpr)
    }
    return coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: argExpr), tyStart: p.tyStart, tyLen: p.tyLen)
}

// Index into st.fn* for a cached user function (by c.funcs index), or st.fnIdx.count.
fn userFnSlot(st: inout LlvmCtx, idx: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.fnIdx.count {
        if st.fnIdx[i] == idx {
            return i
        }
        i += 1
    }
    return st.fnIdx.count
}

// Whether a Func is a plain user free function the LLVM backend emits directly
// (not main / extern / generic / method / assoc / provided / trait-receiver).
// Restricted to the ENTRY module (id 0): the std library (Prelude/Core/…) is full
// of features not yet covered, and a simple program doesn't call them — emitting
// only the user's own module keeps bring-up tractable. (Proper call-graph
// reachability, which will pull in exactly the reached std functions, replaces
// this once arrays/methods/generics land.)
// ---- reachable associated functions ----
//
// Mark assoc fn `fi` reached, if not already (so its body is scanned for further
// assoc calls and it gets emitted). Returns whether it was newly added.
fn markReachAssoc(st: inout LlvmCtx, fi: U64) -> Bool {
    mut val i: U64 = 0
    while i < st.reachAssoc.count {
        if st.reachAssoc[i] == fi {
            return false
        }
        i += 1
    }
    st.reachAssoc.append(value: fi)
    return true
}

// Whether an assoc-fn name is an operator-trait witness (binary add/sub/mul/div/
// rem/bitand/bitor/bitxor/shl/shr, unary neg/not/bitnot). Used to seed reachable
// emission for operator desugar, which leaves no call node to scan.
fn isOperatorWitnessName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "add") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "sub") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "mul") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "div") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "rem") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "bitand") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "bitor") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "bitxor") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "shl") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "shr") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "neg") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "not") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "bitnot") { return true }
    return false
}

fn inReachAssoc(st: inout LlvmCtx, fi: U64) -> Bool {
    mut val i: U64 = 0
    while i < st.reachAssoc.count {
        if st.reachAssoc[i] == fi {
            return true
        }
        i += 1
    }
    return false
}

// Walk an expression, marking every `Type.name(args)` assoc-fn call it reaches.
fn scanExprAssoc(c: inout Comp, st: inout LlvmCtx, id: U64) {
    match c.exprs[id] {
        Expr.Unary(op: _, val operand) => { scanExprAssoc(c: inout c, st: inout st, id: operand) }
        Expr.Binary(op: _, val lhs, val rhs) => { scanExprAssoc(c: inout c, st: inout st, id: lhs) scanExprAssoc(c: inout c, st: inout st, id: rhs) }
        Expr.Call(nameStart: _, nameLen: _, val args) => {
            mut val i: U64 = 0
            while i < args.count { scanExprAssoc(c: inout c, st: inout st, id: args[i].expr) i += 1 }
        }
        Expr.Field(val base, nameStart: _, nameLen: _) => { scanExprAssoc(c: inout c, st: inout st, id: base) }
        Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
            mut val i: U64 = 0
            while i < fields.count { scanExprAssoc(c: inout c, st: inout st, id: fields[i].value) i += 1 }
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count { scanExprAssoc(c: inout c, st: inout st, id: elems[i]) i += 1 }
        }
        Expr.Index(val base, val index) => { scanExprAssoc(c: inout c, st: inout st, id: base) scanExprAssoc(c: inout c, st: inout st, id: index) }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            val arn: Bind = assocRecvName(c: inout c, recv: recv)
            if arn.nameLen != 0U64 {
                val afi: U64 = findAssoc(c: inout c, recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if afi < c.funcs.count {
                    markReachAssoc(st: inout st, fi: afi)
                }
            } else {
                scanExprAssoc(c: inout c, st: inout st, id: recv)
            }
            mut val i: U64 = 0
            while i < args.count { scanExprAssoc(c: inout c, st: inout st, id: args[i].expr) i += 1 }
        }
        Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { scanExprAssoc(c: inout c, st: inout st, id: operand) }
        Expr.MatchExpr(val scrut, val arms) => {
            scanExprAssoc(c: inout c, st: inout st, id: scrut)
            mut val i: U64 = 0
            while i < arms.count { scanExprAssoc(c: inout c, st: inout st, id: arms[i].body) i += 1 }
        }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            scanExprAssoc(c: inout c, st: inout st, id: cond)
            scanBlockAssoc(c: inout c, st: inout st, id: thenBlk)
            scanBlockAssoc(c: inout c, st: inout st, id: elseBlk)
        }
        Expr.OptChain(val base, memberStart: _, memberLen: _) => { scanExprAssoc(c: inout c, st: inout st, id: base) }
        Expr.Try(val expr) => { scanExprAssoc(c: inout c, st: inout st, id: expr) }
        Expr.Arrow(val base, nameStart: _, nameLen: _) => { scanExprAssoc(c: inout c, st: inout st, id: base) }
        Expr.Move(val operand, isBorrow: _) => { scanExprAssoc(c: inout c, st: inout st, id: operand) }
        Expr.Await(val operand) => { scanExprAssoc(c: inout c, st: inout st, id: operand) }
        Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, val body) => { scanBlockAssoc(c: inout c, st: inout st, id: body) }
        _ => {}
    }
}

fn scanStmtAssoc(c: inout Comp, st: inout LlvmCtx, id: U64) {
    match c.stmts[id] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { scanExprAssoc(c: inout c, st: inout st, id: init) }
        Stmt.Assign(op: _, val target, val value) => { scanExprAssoc(c: inout c, st: inout st, id: target) scanExprAssoc(c: inout c, st: inout st, id: value) }
        Stmt.ExprStmt(val expr) => { scanExprAssoc(c: inout c, st: inout st, id: expr) }
        Stmt.Return(val value, val hasValue) => { if hasValue { scanExprAssoc(c: inout c, st: inout st, id: value) } }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            scanExprAssoc(c: inout c, st: inout st, id: cond)
            scanBlockAssoc(c: inout c, st: inout st, id: thenBlk)
            if hasElse { scanBlockAssoc(c: inout c, st: inout st, id: elseBlk) }
        }
        Stmt.While(val cond, val body) => { scanExprAssoc(c: inout c, st: inout st, id: cond) scanBlockAssoc(c: inout c, st: inout st, id: body) }
        Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, val rangeHi, val body, isStruct: _, patStart: _, patLen: _, binds: _) => {
            scanExprAssoc(c: inout c, st: inout st, id: iter)
            scanExprAssoc(c: inout c, st: inout st, id: rangeHi)
            scanBlockAssoc(c: inout c, st: inout st, id: body)
        }
        Stmt.Match(val scrut, val arms) => {
            scanExprAssoc(c: inout c, st: inout st, id: scrut)
            mut val i: U64 = 0
            while i < arms.count { scanBlockAssoc(c: inout c, st: inout st, id: arms[i].body) i += 1 }
        }
        Stmt.Panic(val msg, offset: _) => { scanExprAssoc(c: inout c, st: inout st, id: msg) }
        Stmt.Give(val value) => { scanExprAssoc(c: inout c, st: inout st, id: value) }
        _ => {}
    }
}

fn scanBlockAssoc(c: inout Comp, st: inout LlvmCtx, id: U64) {
    if id == 0U64 {
        return
    }
    val blk: Block = c.blocks[id]
    mut val i: U64 = 0
    while i < blk.stmts.count {
        scanStmtAssoc(c: inout c, st: inout st, id: blk.stmts[i])
        i += 1
    }
}

// Collect the assoc fns reachable from emitted code: seed by scanning every
// non-assoc function body (those we emit), then iterate to a fixpoint over the
// reached assoc fns' own bodies (which may call further assoc fns). Run before
// declareUserFns, which only emits an assoc fn that is reachable.
fn collectReachableAssoc(c: inout Comp, st: inout LlvmCtx) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        if c.funcs[fi].isAssoc {
            // an operator-trait witness (add/sub/.../neg/not/bitnot) is reached
            // structurally, not by call-graph: operator desugar (`a + b`, `-x`)
            // leaves no `Type.name(...)` call in the AST for the scan to see, and
            // a value operand's type isn't known at scan time (c.locals is empty
            // outside codegen). These names never collide with derive-generated
            // Eq/Ord (eq/compare), so derived witnesses stay correctly excluded.
            if isOperatorWitnessName(c: inout c, start: c.funcs[fi].nameStart, len: c.funcs[fi].nameLen) {
                markReachAssoc(st: inout st, fi: fi)
            }
        } else {
            scanBlockAssoc(c: inout c, st: inout st, id: c.funcs[fi].body)
        }
        fi += 1
    }
    mut val prev: U64 = c.funcs.count + 1U64
    while st.reachAssoc.count != prev {
        prev = st.reachAssoc.count
        mut val ri: U64 = 0
        while ri < st.reachAssoc.count {
            scanBlockAssoc(c: inout c, st: inout st, id: c.funcs[st.reachAssoc[ri]].body)
            ri += 1
        }
    }
}

fn isPlainUserFn(c: inout Comp, st: inout LlvmCtx, fi: U64) -> Bool {
    val f: Func = c.funcs[fi]
    if nameIsMain(c: inout c, f: f) { return false }
    if f.isExtern { return false }
    // a provided trait method is NOT emitted upfront: it is declared+emitted lazily
    // the first time a call resolves to it (ensureProvidedDeclared), so an uncalled
    // std-trait adapter method (map/filter, whose body builds an unsupported adapter)
    // never gets emitted. The body offset can't tell std from entry reliably here, so
    // reachability is the gate, not module membership.
    if f.isProvided { return false }
    if f.typeParams.count > 0 { return false }
    if f.isAssoc {
        // an associated function (`Type.name(args)`, no self) is emitted like a
        // free function, gated to a registered owner type in the entry module AND
        // actually reached (called) — so derive-generated but uncalled witnesses
        // (Eq/Ord lowered natively here) aren't emitted into failing bodies.
        // Trait assoc fns and generic ones are deferred.
        if inReachAssoc(st: inout st, fi: fi) {
        } else {
            return false
        }
        if isTraitName(c: inout c, start: f.recvStart, len: f.recvLen) { return false }
        if structRegSlot(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen) < st.structIdxs.count {
            return methodInEntryModule(c: inout c, f: f)
        }
        if enumRegSlot(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen) < st.enumIdxs.count {
            return methodInEntryModule(c: inout c, f: f)
        }
        return false
    }
    if f.hasRecv {
        // a method: emit it iff its receiver is a registered struct AND it is
        // defined in the entry module. (A method name is re-interned so moduleOf on
        // it is unreliable; use the body's first statement, whose exprs keep their
        // original source offsets, to recover the defining module — this keeps std
        // struct methods, full of not-yet-supported constructs, from being emitted.)
        if isTraitName(c: inout c, start: f.recvStart, len: f.recvLen) { return false }
        if structRegSlot(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen) < st.structIdxs.count {
        } else {
            return false
        }
        return methodInEntryModule(c: inout c, f: f)
    }
    // a free function: entry module only (see registerStructs note on reachability).
    return moduleOf(c: inout c, offset: f.nameStart) == 0U64
}

// The source offset of a statement's principal expression (which carries an
// original-source offset, unlike re-interned decl names), for recovering the
// defining module. Falls back to 0 (= module 0) for offsetless statements.
fn stmtPrincipalOffset(c: inout Comp, sid: U64) -> U64 {
    match c.stmts[sid] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { return exprOffset(c: inout c, id: init) }
        Stmt.Assign(op: _, val target, value: _) => { return exprOffset(c: inout c, id: target) }
        Stmt.ExprStmt(val expr) => { return exprOffset(c: inout c, id: expr) }
        Stmt.Return(val value, val hasValue) => { if hasValue { return exprOffset(c: inout c, id: value) } return 0U64 }
        Stmt.If(val cond, thenBlk: _, elseBlk: _, hasElse: _) => { return exprOffset(c: inout c, id: cond) }
        Stmt.While(val cond, body: _) => { return exprOffset(c: inout c, id: cond) }
        Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, rangeHi: _, body: _, isStruct: _, patStart: _, patLen: _, binds: _) => { return exprOffset(c: inout c, id: iter) }
        Stmt.Match(val scrut, arms: _) => { return exprOffset(c: inout c, id: scrut) }
        Stmt.Panic(msg: _, val offset) => { return offset }
        Stmt.Give(val value) => { return exprOffset(c: inout c, id: value) }
        _ => { return 0U64 }
    }
}

// Whether a method is defined in the entry module (id 0), via the body's first
// statement's principal-expr offset.
fn methodInEntryModule(c: inout Comp, f: Func) -> Bool {
    if f.body == 0U64 {
        return false
    }
    val blk: Block = c.blocks[f.body]
    if blk.stmts.count == 0U64 {
        return false
    }
    return moduleOf(c: inout c, offset: stmtPrincipalOffset(c: inout c, sid: blk.stmts[0])) == 0U64
}

// The LLVM type of a parameter: a pointer for an `inout` parameter (it receives
// the caller's address and mutates in place), else the value type (array-aware).
fn paramLlvmTy(c: inout Comp, st: inout LlvmCtx, p: Param) -> LLVMTypeRef {
    if p.isInout {
        return st.ptrty
    }
    // ground a generic-instance param type (`Box[T]`) through the active env.
    mut val pt: U64 = p.ty
    if c.curTypeParams.count > 0U64 {
        pt = groundTypeRef(c: inout c, ref: pt)
    }
    if isGenericInst(c: inout c, ref: pt) {
        return llvmTypeOfRef(c: inout c, st: inout st, ref: pt)
    }
    return llvmTypeFor(c: inout c, st: inout st, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
}

// The LLVM type of a method's `self` parameter: a pointer for `inout fn` (mutates
// the caller's value), else the receiver struct by value.
fn selfParamTy(c: inout Comp, st: inout LlvmCtx, f: Func) -> LLVMTypeRef {
    if f.selfInout {
        return st.ptrty
    }
    return llvmScalarTy(c: inout c, st: inout st, tyStart: f.recvStart, tyLen: f.recvLen)
}

// The LLVM return type of a function (and whether it is void = Plew `()`).
fn llvmFnRetTy(c: inout Comp, st: inout LlvmCtx, f: Func) -> LLVMTypeRef {
    if f.hasRet {
        // ground a generic-instance return (`Box[T]`) through the active env so it
        // resolves to the registered concrete instance (`Box[I32]`).
        mut val rt: U64 = f.retTy
        if c.curTypeParams.count > 0U64 {
            rt = groundTypeRef(c: inout c, ref: rt)
        }
        if isGenericInst(c: inout c, ref: rt) {
            return llvmTypeOfRef(c: inout c, st: inout st, ref: rt)
        }
        return llvmTypeFor(c: inout c, st: inout st, tyStart: f.retStart, tyLen: f.retLen, isArray: f.retIsArray)
    }
    return st.voidty
}

// Pass 1: declare every plain user function as `pf<idx>` with its LLVM signature,
// caching (idx -> value, type) so calls resolve without name mangling.
fn declareUserFns(c: inout Comp, st: inout LlvmCtx) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        if isPlainUserFn(c: inout c, st: inout st, fi: fi) {
            mut val ptys: Array[LLVMTypeRef] = []
            if f.hasRecv {
                ptys.append(value: selfParamTy(c: inout c, st: inout st, f: f))
            }
            mut val pi: U64 = 0
            while pi < f.params.count {
                ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: f.params[pi]))
                pi += 1
            }
            val rty: LLVMTypeRef = llvmFnRetTy(c: inout c, st: inout st, f: f)
            val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count, 0I32)
            mut val nm: Array[U8] = []
            appendBytes(into: inout nm, from: "pf".bytes)
            appendU64Dec(into: inout nm, n: fi)
            nm.append(value: 0)
            val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
            st.fnIdx.append(value: fi)
            st.fnVal.append(value: fv)
            st.fnTy.append(value: fty)
        }
        fi += 1
    }
}

// Lazily declare a (non-generic) provided trait method `fi` reached at a call site:
// add its `pf<fi>` symbol with the self-first method signature and queue its body
// for emission (provEmit). Returns the fnIdx slot, or st.fnIdx.count if it can't be
// emitted (generic / non-struct receiver). Idempotent (returns the existing slot).
fn ensureProvidedDeclared(c: inout Comp, st: inout LlvmCtx, fi: U64) -> U64 {
    val existing: U64 = userFnSlot(st: inout st, idx: fi)
    if existing < st.fnIdx.count {
        return existing
    }
    val f: Func = c.funcs[fi]
    if f.typeParams.count > 0U64 {
        return st.fnIdx.count
    }
    if f.hasRecv {
    } else {
        return st.fnIdx.count
    }
    if structRegSlot(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen) < st.structIdxs.count {
    } else {
        return st.fnIdx.count
    }
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: selfParamTy(c: inout c, st: inout st, f: f))
    mut val pi: U64 = 0
    while pi < f.params.count {
        ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: f.params[pi]))
        pi += 1
    }
    val fty: LLVMTypeRef = LLVMFunctionType(llvmFnRetTy(c: inout c, st: inout st, f: f), arrayCPtr(ptys), ptys.count, 0I32)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "pf".bytes)
    appendU64Dec(into: inout nm, n: fi)
    nm.append(value: 0)
    val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
    st.fnIdx.append(value: fi)
    st.fnVal.append(value: fv)
    st.fnTy.append(value: fty)
    st.provEmit.append(value: fi)
    return st.fnIdx.count - 1U64
}

// Append the decimal digits of n to a byte buffer (for synthetic symbol names).
// Uses digitStrU's per-digit String (its bytes are U8) to avoid a U64->U8 narrow,
// which Plew's lossless `as` does not allow.
fn appendU64Dec(into: inout Array[U8], n: U64) {
    if n >= 10U64 {
        appendU64Dec(into: inout into, n: n / 10U64)
    }
    appendBytes(into: inout into, from: digitStrU(d: n % 10U64).bytes)
}

// Pass 2: emit a plain user function's body.
// Declare each concrete generic free-function instantiation (c.fnInsts) as a
// symbol `gf<k>` with its signature built under the instance's substitution env.
fn declareGenFns(c: inout Comp, st: inout LlvmCtx) {
    mut val k: U64 = 0
    while k < c.fnInsts.count {
        val fin: FnInst = c.fnInsts[k]
        // free-function instances only (recvInstRef == 0); methods are a later step.
        // restrict to the entry module: a std generic fn (print[T] etc.) has a body
        // full of not-yet-supported constructs and shouldn't be emitted (print is
        // special-cased at the call site, so its instance is never called).
        if fin.recvInstRef == 0U64 && moduleOf(c: inout c, offset: c.funcs[fin.fnIdx].nameStart) == 0U64 {
            if isGenericFreeFn(c: inout c, fi: fin.fnIdx) {
                val f: Func = c.funcs[fin.fnIdx]
                val savedP: Array[Bind] = c.curTypeParams
                val savedA: Array[U64] = c.curTypeArgs
                c.curTypeParams = f.typeParams
                c.curTypeArgs = fin.args
                mut val ptys: Array[LLVMTypeRef] = []
                mut val pi: U64 = 0
                while pi < f.params.count {
                    ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: f.params[pi]))
                    pi += 1
                }
                val fty: LLVMTypeRef = LLVMFunctionType(llvmFnRetTy(c: inout c, st: inout st, f: f), arrayCPtr(ptys), f.params.count, 0I32)
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "gf".bytes)
                appendU64Dec(into: inout nm, n: k)
                nm.append(value: 0)
                val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
                c.curTypeParams = savedP
                c.curTypeArgs = savedA
                st.genFnK.append(value: k)
                st.genFnVal.append(value: fv)
                st.genFnTy.append(value: fty)
            }
        }
        k += 1
    }
}

// Emit each generic free-function instance body under its env.
fn emitGenFns(c: inout Comp, st: inout LlvmCtx) {
    mut val slot: U64 = 0
    while slot < st.genFnK.count {
        val fin: FnInst = c.fnInsts[st.genFnK[slot]]
        val f: Func = c.funcs[fin.fnIdx]
        val savedP: Array[Bind] = c.curTypeParams
        val savedA: Array[U64] = c.curTypeArgs
        c.curTypeParams = f.typeParams
        c.curTypeArgs = fin.args
        genLlvmFuncBody(c: inout c, st: inout st, fi: fin.fnIdx, fv: st.genFnVal[slot])
        c.curTypeParams = savedP
        c.curTypeArgs = savedA
        slot += 1
    }
}

// The TypeRef of a call argument, using the LLVM backend's own local tracking
// (the front-end `typeOf` can't see locals — the LLVM backend doesn't populate
// c.locals). A generic-instance local carries its ref; a struct value maps to a
// bare TypeRef by its struct name; a scalar/String comes from the typed-AST cache
// (which works for literals/expressions). 0 when no type can be recovered.
fn llvmArgTypeRef(c: inout Comp, st: inout LlvmCtx, argExpr: U64) -> U64 {
    val tr: U64 = exprTypeRef(c: inout c, st: inout st, id: argExpr)
    if tr != 0U64 {
        return tr
    }
    val si: U64 = exprStructIdx(c: inout c, st: inout st, id: argExpr)
    if si < c.structs.count {
        return findOrAddTypeRef(c: inout c, nameStart: c.structs[si].nameStart, nameLen: c.structs[si].nameLen)
    }
    val t: TypeInfo = typeOf(c: inout c, id: argExpr)
    if t.kind == 0 {
        return findOrAddTypeRef(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    }
    if t.kind == 1 {
        return findOrAddTypeRef(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    }
    return 0U64
}

// Infer a generic free function's type arguments from a call's arguments, mirroring
// the front-end `inferFnArgs` but recovering each argument's type via the LLVM
// backend's local tracking (so a struct local arg resolves, which front-end typeOf
// can't for an unpopulated c.locals).
fn llvmInferFnArgs(c: inout Comp, st: inout LlvmCtx, f: Func, args: Array[Arg]) -> Array[U64] {
    mut val out: Array[U64] = []
    mut val ti: U64 = 0
    while ti < f.typeParams.count {
        val tp: Bind = f.typeParams[ti]
        mut val found: U64 = 0
        mut val pi: U64 = 0
        while pi < f.params.count {
            val p: Param = f.params[pi]
            if p.tyIsArray {
                if p.tyNameId == tp.nameId {
                    if pi < args.count {
                        if found == 0U64 {
                            found = argArrayElemRef(c: inout c, argExpr: args[pi].expr)
                        }
                    }
                }
            } else {
                if pi < args.count {
                    if found == 0U64 {
                        val argRef: U64 = llvmArgTypeRef(c: inout c, st: inout st, argExpr: args[pi].expr)
                        found = unifyTypeParam(c: inout c, paramRef: p.ty, argRef: argRef, tpStart: tp.nameStart, tpLen: tp.nameLen)
                    }
                }
            }
            pi += 1
        }
        out.append(value: found)
        ti += 1
    }
    return out
}

// Find the registered generic-fn instance slot for (fnIdx, args), or count.
fn genFnSlotFor(c: inout Comp, fnIdx: U64, args: Array[U64], st: inout LlvmCtx) -> U64 {
    mut val slot: U64 = 0
    while slot < st.genFnK.count {
        val fin: FnInst = c.fnInsts[st.genFnK[slot]]
        if fin.fnIdx == fnIdx {
            if typeArgsEq(c: inout c, a: fin.args, b: args) {
                return slot
            }
        }
        slot += 1
    }
    return st.genFnK.count
}

// ---- generic methods (monomorphized per receiver instantiation) ----
//
// A method on a generic struct/enum receiver (`box.get()`, `maybe.unwrapOr(...)`)
// has no method-own type params (those go through the FnInst path); it is emitted
// once per receiver instance, like the C backend's emitMonoMethods. Keyed by
// (method func idx, receiver instance ref). Restricted to entry-module,
// non-provided methods (std combinators / provided Iterator methods are deferred).

// The st.genMeth* slot for (mfi, instRef), or st.genMethK.count if not registered.
fn genMethSlotFor(c: inout Comp, st: inout LlvmCtx, mfi: U64, instRef: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.genMethK.count {
        if st.genMethK[i] == mfi {
            if typeRefEq(c: inout c, a: st.genMethInst[i], b: instRef) {
                return i
            }
        }
        i += 1
    }
    return st.genMethK.count
}

// Declare an LLVM function for each (generic instance, matching method): self + the
// method's params, return type — all under the receiver's substitution env.
fn declareGenMethods(c: inout Comp, st: inout LlvmCtx) {
    mut val gi: U64 = 0
    while gi < c.genInsts.count {
        val instRef: U64 = c.genInsts[gi]
        val gt: TypeRef = c.types[instRef]
        // Array instances keep their methods on the array-special path; skip here.
        if rangeEquals(bytes: c.bytes, start: gt.nameStart, len: gt.nameLen, kw: "Array") {
        } else {
            mut val mfi: U64 = 0
            while mfi < c.funcs.count {
                val mf: Func = c.funcs[mfi]
                if methodMatchesInst(c: inout c, f: mf, instRef: instRef) {
                    if mf.isProvided {
                    } else {
                        if methodInEntryModule(c: inout c, f: mf) {
                            if genMethSlotFor(c: inout c, st: inout st, mfi: mfi, instRef: instRef) == st.genMethK.count {
                                declareOneGenMethod(c: inout c, st: inout st, mfi: mfi, instRef: instRef)
                            }
                        }
                    }
                }
                mfi += 1
            }
        }
        gi += 1
    }
}

fn declareOneGenMethod(c: inout Comp, st: inout LlvmCtx, mfi: U64, instRef: U64) {
    val mf: Func = c.funcs[mfi]
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val savedR: U64 = st.curRecvInstRef
    c.curTypeParams = mf.typeParams
    c.curTypeArgs = c.types[instRef].args
    st.curRecvInstRef = instRef
    mut val ptys: Array[LLVMTypeRef] = []
    if mf.selfInout {
        ptys.append(value: st.ptrty)
    } else {
        ptys.append(value: llvmTypeOfRef(c: inout c, st: inout st, ref: instRef))
    }
    mut val pi: U64 = 0
    while pi < mf.params.count {
        ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: mf.params[pi]))
        pi += 1
    }
    val fty: LLVMTypeRef = LLVMFunctionType(llvmFnRetTy(c: inout c, st: inout st, f: mf), arrayCPtr(ptys), ptys.count, 0I32)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "gm".bytes)
    appendU64Dec(into: inout nm, n: mfi)
    appendBytes(into: inout nm, from: "_".bytes)
    appendU64Dec(into: inout nm, n: instRef)
    nm.append(value: 0)
    val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
    st.genMethK.append(value: mfi)
    st.genMethInst.append(value: instRef)
    st.genMethVal.append(value: fv)
    st.genMethTy.append(value: fty)
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
    st.curRecvInstRef = savedR
}

// Emit one generic-method instance body (slot index into genMeth*) under its
// receiver's substitution env.
fn emitOneGenMethod(c: inout Comp, st: inout LlvmCtx, slot: U64) {
    val mfi: U64 = st.genMethK[slot]
    val instRef: U64 = st.genMethInst[slot]
    val mf: Func = c.funcs[mfi]
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val savedR: U64 = st.curRecvInstRef
    c.curTypeParams = mf.typeParams
    c.curTypeArgs = c.types[instRef].args
    st.curRecvInstRef = instRef
    genLlvmFuncBody(c: inout c, st: inout st, fi: mfi, fv: st.genMethVal[slot])
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
    st.curRecvInstRef = savedR
}

// Emit each eagerly-declared generic-method instance body under its receiver's env.
fn emitGenMethods(c: inout Comp, st: inout LlvmCtx) {
    mut val slot: U64 = 0
    while slot < st.genMethK.count {
        emitOneGenMethod(c: inout c, st: inout st, slot: slot)
        slot += 1
    }
}

// Declare a generic-method instance on demand — a std / non-entry-module generic
// method (Optional.unwrapOr, MapIter.next) reached by a call — and queue its body
// for the post-pass drain. Returns the genMeth* slot, or genMethK.count if it
// can't be declared (the method has its own type params beyond the receiver
// instance's — provided map[B]/filter is handled separately). Idempotent.
fn ensureGenMethodDeclared(c: inout Comp, st: inout LlvmCtx, mfi: U64, instRef: U64) -> U64 {
    val existing: U64 = genMethSlotFor(c: inout c, st: inout st, mfi: mfi, instRef: instRef)
    if existing < st.genMethK.count {
        return existing
    }
    // the method's type params must pair 1:1 with the instance's type args (the
    // instance fully grounds the method's env); a mismatch means method-own params.
    val mf: Func = c.funcs[mfi]
    if mf.typeParams.count == c.types[instRef].args.count {
    } else {
        return st.genMethK.count
    }
    declareOneGenMethod(c: inout c, st: inout st, mfi: mfi, instRef: instRef)
    val slot: U64 = st.genMethK.count - 1U64
    st.genMethEmit.append(value: slot)
    return slot
}

// Drain the lazily-declared generic-method queue: emit each queued body (which may
// reach further lazy generic methods, appending to the queue — so loop on count).
fn emitQueuedGenMethods(c: inout Comp, st: inout LlvmCtx) {
    mut val i: U64 = 0
    while i < st.genMethEmit.count {
        emitOneGenMethod(c: inout c, st: inout st, slot: st.genMethEmit[i])
        i += 1
    }
}

// Element-wise structural equality of two type-argument lists.
fn typeArgsEq(c: inout Comp, a: Array[U64], b: Array[U64]) -> Bool {
    if a.count != b.count {
        return false
    }
    mut val i: U64 = 0
    while i < a.count {
        if typeRefEq(c: inout c, a: a[i], b: b[i]) {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Bind one function/closure parameter (the LLVM arg at `argIdx`) as a local: an
// array param is the {ptr,i64} value; a generic-instance / Ref / enum param tracks
// its instance/enum ref; an `inout` param binds the caller pointer directly, else
// the value is stored into a fresh alloca.
fn bindOneParam(c: inout Comp, st: inout LlvmCtx, p: Param, fv: LLVMValueRef, argIdx: U64) {
    mut val pty: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: p.tyStart, tyLen: p.tyLen)
    mut val pElem: LLVMTypeRef = st.i64ty
    mut val pSidx: U64 = localStructIdxFor(c: inout c, st: inout st, start: p.tyStart, len: p.tyLen)
    mut val pRef: U64 = 0
    if p.tyIsArray {
        pElem = pty
        pty = st.arrayTy
    } else {
        if isGenericInst(c: inout c, ref: p.ty) {
            pty = llvmTypeOfRef(c: inout c, st: inout st, ref: p.ty)
            pRef = p.ty
            val pgs: U64 = genStructSlot(c: inout c, st: inout st, ref: p.ty)
            if pgs < st.genStructRefs.count {
                pSidx = st.genStructDefs[pgs]
            }
        }
        if isRefInst(c: inout c, ref: p.ty) {
            pty = st.ptrty
            pRef = p.ty
        }
        // a function-value param (`f: fn(n: I32) -> I32`): track the fn TypeRef so a
        // call `f(n: x)` resolves the closure signature for the indirect call.
        if isFnType(c: inout c, ref: p.ty) {
            pRef = p.ty
        }
        if pRef == 0U64 {
            if enumRegSlot(c: inout c, st: inout st, start: p.tyStart, len: p.tyLen) < st.enumIdxs.count {
                pRef = simpleTypeRef(c: inout c, nameStart: p.tyStart, nameLen: p.tyLen)
            }
        }
    }
    val pKind: U64 = kindFromTySpan(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen)
    if p.isInout {
        pushLocalR(st: inout st, nameStart: p.nameStart, nameLen: p.nameLen, ptr: LLVMGetParam(fv, argIdx), ty: pty, kind: pKind, structIdx: pSidx, isArr: p.tyIsArray, elemTy: pElem, elemKind: pKind, typeRef: pRef)
    } else {
        val slot2: LLVMValueRef = LLVMBuildAlloca(st.b, pty, anon())
        LLVMBuildStore(st.b, LLVMGetParam(fv, argIdx), slot2)
        pushLocalR(st: inout st, nameStart: p.nameStart, nameLen: p.nameLen, ptr: slot2, ty: pty, kind: pKind, structIdx: pSidx, isArr: p.tyIsArray, elemTy: pElem, elemKind: pKind, typeRef: pRef)
    }
}

// ---- closures (lambda-lifted function values) ----
//
// The captures of closure `cloId`, in declaration order (the env struct layout).
fn closureCaptures(c: inout Comp, cloId: U64) -> Array[CaptureEntry] {
    mut val out: Array[CaptureEntry] = []
    mut val i: U64 = 0
    while i < c.captures.count {
        if c.captures[i].closureId == cloId {
            out.append(value: c.captures[i])
        }
        i += 1
    }
    return out
}

// The LLVM type of a capture slot in the env struct: a `mut val` (boxed) capture is
// a pointer to the shared cell; otherwise the captured value's own type.
fn captureSlotTy(c: inout Comp, st: inout LlvmCtx, cap: CaptureEntry) -> LLVMTypeRef {
    if cap.boxed {
        return st.ptrty
    }
    if cap.isArray {
        return st.arrayTy
    }
    if isGenericInst(c: inout c, ref: cap.ty) {
        return llvmTypeOfRef(c: inout c, st: inout st, ref: cap.ty)
    }
    return llvmScalarTy(c: inout c, st: inout st, tyStart: cap.tyStart, tyLen: cap.tyLen)
}

// The env struct type for closure `cloId` (its captures in order). Caller guards on
// caps.count > 0 before using it.
fn closureEnvTy(c: inout Comp, st: inout LlvmCtx, caps: Array[CaptureEntry]) -> LLVMTypeRef {
    mut val elems: Array[LLVMTypeRef] = []
    mut val i: U64 = 0
    while i < caps.count {
        elems.append(value: captureSlotTy(c: inout c, st: inout st, cap: caps[i]))
        i += 1
    }
    return LLVMStructTypeInContext(st.ctx, arrayCPtr(elems), elems.count, 0I32)
}

// Index into st.clo* for a Closure-expr arena id, or st.cloIdx.count.
fn closureSlot(st: inout LlvmCtx, id: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.cloIdx.count {
        if st.cloIdx[i] == id {
            return i
        }
        i += 1
    }
    return st.cloIdx.count
}

// Whether the LLVM backend can lower closure `cloId` yet: a `mut val` (boxed,
// shared-cell) capture isn't modeled, so such a closure is left undeclared and its
// literal rejects loudly (a clean unsupported, not a miscompile).
fn closureSupported(c: inout Comp, cloId: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        if c.captures[i].closureId == cloId {
            if c.captures[i].boxed {
                return false
            }
        }
        i += 1
    }
    return true
}

// Declare a closure as `__closure<id>(ptr env, params...)` (env first per the
// uniform closure ABI) and cache it. Idempotent (skips an already-declared id);
// a closure with an unsupported (boxed) capture is left undeclared.
fn declareClosure(c: inout Comp, st: inout LlvmCtx, id: U64) {
    if closureSlot(st: inout st, id: id) < st.cloIdx.count {
        return
    }
    if closureSupported(c: inout c, cloId: id) {
    } else {
        return
    }
    match c.exprs[id] {
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, body: _) => {
            mut val ptys: Array[LLVMTypeRef] = []
            ptys.append(value: st.ptrty)
            mut val pi: U64 = 0
            while pi < params.count {
                ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: params[pi]))
                pi += 1
            }
            mut val rty: LLVMTypeRef = st.voidty
            if hasRet {
                if isGenericInst(c: inout c, ref: retTy) {
                    rty = llvmTypeOfRef(c: inout c, st: inout st, ref: retTy)
                } else {
                    rty = llvmTypeFor(c: inout c, st: inout st, tyStart: retStart, tyLen: retLen, isArray: retIsArray)
                }
            }
            val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count, 0I32)
            mut val nm: Array[U8] = []
            appendBytes(into: inout nm, from: "__closure".bytes)
            appendU64Dec(into: inout nm, n: id)
            nm.append(value: 0)
            val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
            st.cloIdx.append(value: id)
            st.cloVal.append(value: fv)
            st.cloTy.append(value: fty)
        }
        _ => {}
    }
}

// Walk an expression / statement / block, declaring every Closure it contains
// (and nested closures via the declared closure's own body scan, run later).
fn scanExprClosures(c: inout Comp, st: inout LlvmCtx, id: U64) {
    match c.exprs[id] {
        Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, body: _) => {
            declareClosure(c: inout c, st: inout st, id: id)
        }
        Expr.Unary(op: _, val operand) => { scanExprClosures(c: inout c, st: inout st, id: operand) }
        Expr.Binary(op: _, val lhs, val rhs) => { scanExprClosures(c: inout c, st: inout st, id: lhs) scanExprClosures(c: inout c, st: inout st, id: rhs) }
        Expr.Call(nameStart: _, nameLen: _, val args) => {
            mut val i: U64 = 0
            while i < args.count { scanExprClosures(c: inout c, st: inout st, id: args[i].expr) i += 1 }
        }
        Expr.Method(val recv, nameStart: _, nameLen: _, val args) => {
            scanExprClosures(c: inout c, st: inout st, id: recv)
            mut val i: U64 = 0
            while i < args.count { scanExprClosures(c: inout c, st: inout st, id: args[i].expr) i += 1 }
        }
        Expr.Field(val base, nameStart: _, nameLen: _) => { scanExprClosures(c: inout c, st: inout st, id: base) }
        Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
            mut val i: U64 = 0
            while i < fields.count { scanExprClosures(c: inout c, st: inout st, id: fields[i].value) i += 1 }
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count { scanExprClosures(c: inout c, st: inout st, id: elems[i]) i += 1 }
        }
        Expr.Index(val base, val index) => { scanExprClosures(c: inout c, st: inout st, id: base) scanExprClosures(c: inout c, st: inout st, id: index) }
        Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { scanExprClosures(c: inout c, st: inout st, id: operand) }
        Expr.MatchExpr(val scrut, val arms) => {
            scanExprClosures(c: inout c, st: inout st, id: scrut)
            mut val i: U64 = 0
            while i < arms.count { scanExprClosures(c: inout c, st: inout st, id: arms[i].body) i += 1 }
        }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            scanExprClosures(c: inout c, st: inout st, id: cond)
            scanBlockClosures(c: inout c, st: inout st, id: thenBlk)
            scanBlockClosures(c: inout c, st: inout st, id: elseBlk)
        }
        Expr.OptChain(val base, memberStart: _, memberLen: _) => { scanExprClosures(c: inout c, st: inout st, id: base) }
        Expr.Try(val expr) => { scanExprClosures(c: inout c, st: inout st, id: expr) }
        Expr.Arrow(val base, nameStart: _, nameLen: _) => { scanExprClosures(c: inout c, st: inout st, id: base) }
        Expr.Move(val operand, isBorrow: _) => { scanExprClosures(c: inout c, st: inout st, id: operand) }
        Expr.Await(val operand) => { scanExprClosures(c: inout c, st: inout st, id: operand) }
        _ => {}
    }
}

fn scanStmtClosures(c: inout Comp, st: inout LlvmCtx, id: U64) {
    match c.stmts[id] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { scanExprClosures(c: inout c, st: inout st, id: init) }
        Stmt.Assign(op: _, val target, val value) => { scanExprClosures(c: inout c, st: inout st, id: target) scanExprClosures(c: inout c, st: inout st, id: value) }
        Stmt.ExprStmt(val expr) => { scanExprClosures(c: inout c, st: inout st, id: expr) }
        Stmt.Return(val value, val hasValue) => { if hasValue { scanExprClosures(c: inout c, st: inout st, id: value) } }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            scanExprClosures(c: inout c, st: inout st, id: cond)
            scanBlockClosures(c: inout c, st: inout st, id: thenBlk)
            if hasElse { scanBlockClosures(c: inout c, st: inout st, id: elseBlk) }
        }
        Stmt.While(val cond, val body) => { scanExprClosures(c: inout c, st: inout st, id: cond) scanBlockClosures(c: inout c, st: inout st, id: body) }
        Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, val rangeHi, val body, isStruct: _, patStart: _, patLen: _, binds: _) => {
            scanExprClosures(c: inout c, st: inout st, id: iter)
            scanExprClosures(c: inout c, st: inout st, id: rangeHi)
            scanBlockClosures(c: inout c, st: inout st, id: body)
        }
        Stmt.Match(val scrut, val arms) => {
            scanExprClosures(c: inout c, st: inout st, id: scrut)
            mut val i: U64 = 0
            while i < arms.count { scanBlockClosures(c: inout c, st: inout st, id: arms[i].body) i += 1 }
        }
        Stmt.Panic(val msg, offset: _) => { scanExprClosures(c: inout c, st: inout st, id: msg) }
        Stmt.Give(val value) => { scanExprClosures(c: inout c, st: inout st, id: value) }
        _ => {}
    }
}

fn scanBlockClosures(c: inout Comp, st: inout LlvmCtx, id: U64) {
    if id == 0U64 {
        return
    }
    val blk: Block = c.blocks[id]
    mut val i: U64 = 0
    while i < blk.stmts.count {
        scanStmtClosures(c: inout c, st: inout st, id: blk.stmts[i])
        i += 1
    }
}

// Declare every closure reachable from emitted code (main + plain user fns), then
// fixpoint over declared closures' own bodies (nested closures). Run before bodies.
fn collectClosures(c: inout Comp, st: inout LlvmCtx) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        if nameIsMain(c: inout c, f: c.funcs[fi]) || isPlainUserFn(c: inout c, st: inout st, fi: fi) {
            scanBlockClosures(c: inout c, st: inout st, id: c.funcs[fi].body)
        }
        fi += 1
    }
    mut val seen: U64 = 0
    while seen < st.cloIdx.count {
        val cid: U64 = st.cloIdx[seen]
        match c.exprs[cid] {
            Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, val body) => {
                scanBlockClosures(c: inout c, st: inout st, id: body)
            }
            _ => {}
        }
        seen += 1
    }
}

// Emit each declared closure's body: env pointer is arg 0 (ignored for a
// non-capturing closure), the closure params follow at 1.., then the body.
fn emitClosures(c: inout Comp, st: inout LlvmCtx) {
    mut val s: U64 = 0
    while s < st.cloIdx.count {
        val cid: U64 = st.cloIdx[s]
        val fv: LLVMValueRef = st.cloVal[s]
        match c.exprs[cid] {
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                st.curFn = fv
                st.curIsMain = false
                st.curRetVoid = !hasRet
                if hasRet {
                    if isGenericInst(c: inout c, ref: retTy) {
                        st.curRetTy = llvmTypeOfRef(c: inout c, st: inout st, ref: retTy)
                    } else {
                        st.curRetTy = llvmTypeFor(c: inout c, st: inout st, tyStart: retStart, tyLen: retLen, isArray: retIsArray)
                    }
                } else {
                    st.curRetTy = st.voidty
                }
                st.curRetTyStart = retStart
                st.curRetTyLen = retLen
                st.curRetRef = retTy
                val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, fv, cstr(s: "entry"))
                LLVMPositionBuilderAtEnd(st.b, entry)
                st.terminated = false
                st.nLocals = 0
                st.locStart = []
                st.locLen = []
                st.locPtr = []
                st.locTy = []
                st.locKind = []
                st.locStructIdx = []
                st.locIsArr = []
                st.locElemTy = []
                st.locElemKind = []
                st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
                st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
                st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
                st.locOwned = []
                st.locMoved = []
                // bind captures from the env pointer (param 0): each capture loads
                // from its env slot into a fresh local, so the body's identifier
                // accesses resolve normally. (Immutable captures are by-value; a
                // boxed `mut val` capture binds the cell pointer as a Ref-like local.)
                val caps: Array[CaptureEntry] = closureCaptures(c: inout c, cloId: cid)
                if caps.count > 0U64 {
                    val envTy: LLVMTypeRef = closureEnvTy(c: inout c, st: inout st, caps: caps)
                    val envPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
                    mut val ci: U64 = 0
                    while ci < caps.count {
                        val cap: CaptureEntry = caps[ci]
                        val slotTy: LLVMTypeRef = captureSlotTy(c: inout c, st: inout st, cap: cap)
                        val cv: LLVMValueRef = LLVMBuildLoad2(st.b, slotTy, LLVMBuildStructGEP2(st.b, envTy, envPtr, ci, anon()), anon())
                        val a: LLVMValueRef = LLVMBuildAlloca(st.b, slotTy, anon())
                        LLVMBuildStore(st.b, cv, a)
                        mut val cRef: U64 = 0
                        if cap.boxed {
                            cRef = cap.ty
                        } else {
                            if isGenericInst(c: inout c, ref: cap.ty) {
                                cRef = cap.ty
                            } else {
                                if enumRegSlot(c: inout c, st: inout st, start: cap.tyStart, len: cap.tyLen) < st.enumIdxs.count {
                                    cRef = simpleTypeRef(c: inout c, nameStart: cap.tyStart, nameLen: cap.tyLen)
                                }
                            }
                        }
                        mut val cElem: LLVMTypeRef = st.i64ty
                        if cap.isArray {
                            cElem = llvmScalarTy(c: inout c, st: inout st, tyStart: cap.tyStart, tyLen: cap.tyLen)
                        }
                        pushLocalR(st: inout st, nameStart: cap.nameStart, nameLen: cap.nameLen, ptr: a, ty: slotTy, kind: kindFromTySpan(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: cap.tyStart, len: cap.tyLen), isArr: cap.isArray, elemTy: cElem, elemKind: kindFromTySpan(c: inout c, tyStart: cap.tyStart, tyLen: cap.tyLen), typeRef: cRef)
                        ci += 1
                    }
                }
                mut val pi: U64 = 0
                while pi < params.count {
                    bindOneParam(c: inout c, st: inout st, p: params[pi], fv: fv, argIdx: pi + 1U64)
                    pi += 1
                }
                genLlvmBlock(c: inout c, st: inout st, id: body)
                if st.terminated {
                } else {
                    if st.curRetVoid {
                        LLVMBuildRetVoid(st.b)
                    } else {
                        LLVMBuildUnreachable(st.b)
                    }
                }
            }
            _ => {}
        }
        s += 1
    }
}

// ---- function-value thunks ----
//
// Index into st.thunk* for a function index, or st.thunkIdx.count.
fn thunkSlot(st: inout LlvmCtx, fi: U64) -> U64 {
    mut val i: U64 = 0
    while i < st.thunkIdx.count {
        if st.thunkIdx[i] == fi {
            return i
        }
        i += 1
    }
    return st.thunkIdx.count
}

// Declare a thunk `__fnthunk<fi>(ptr env, params...)` for plain user function `fi`
// (so a bare reference to it can be the {fn, env} value). Idempotent; only declares
// for a function the backend actually emits (a plain user fn).
fn declareThunk(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    if thunkSlot(st: inout st, fi: fi) < st.thunkIdx.count {
        return
    }
    if isPlainUserFn(c: inout c, st: inout st, fi: fi) {
    } else {
        return
    }
    val f: Func = c.funcs[fi]
    if f.hasRecv {
        return
    }
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    mut val pi: U64 = 0
    while pi < f.params.count {
        ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: f.params[pi]))
        pi += 1
    }
    val fty: LLVMTypeRef = LLVMFunctionType(llvmFnRetTy(c: inout c, st: inout st, f: f), arrayCPtr(ptys), ptys.count, 0I32)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "__fnthunk".bytes)
    appendU64Dec(into: inout nm, n: fi)
    nm.append(value: 0)
    val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
    st.thunkIdx.append(value: fi)
    st.thunkVal.append(value: fv)
    st.thunkTy.append(value: fty)
}

// Declare a thunk for every bare identifier that names a plain free function (a
// function-as-value use; over-approx is harmless — an unused thunk just sits).
fn collectThunks(c: inout Comp, st: inout LlvmCtx) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        match c.exprs[i] {
            Expr.Ident(val start, val len) => {
                val fvi: U64 = firstFuncByName(c: inout c, nameStart: start, nameLen: len)
                if fvi < c.funcs.count {
                    val f: Func = c.funcs[fvi]
                    if f.hasRecv || f.isAssoc || f.typeParams.count > 0U64 {
                    } else {
                        declareThunk(c: inout c, st: inout st, fi: fvi)
                    }
                }
            }
            _ => {}
        }
        i += 1
    }
}

// Emit each thunk body: forward the closure args (skipping env at 0) to the plain
// function pf<fi>, returning its result.
fn emitThunks(c: inout Comp, st: inout LlvmCtx) {
    mut val s: U64 = 0
    while s < st.thunkIdx.count {
        val fi: U64 = st.thunkIdx[s]
        val fv: LLVMValueRef = st.thunkVal[s]
        val f: Func = c.funcs[fi]
        val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, fv, cstr(s: "entry"))
        LLVMPositionBuilderAtEnd(st.b, entry)
        val callSlot: U64 = userFnSlot(st: inout st, idx: fi)
        mut val av: Array[LLVMValueRef] = []
        mut val pi: U64 = 0
        while pi < f.params.count {
            av.append(value: LLVMGetParam(fv, pi + 1U64))
            pi += 1
        }
        val r: LLVMValueRef = LLVMBuildCall2(st.b, st.fnTy[callSlot], st.fnVal[callSlot], arrayCPtr(av), av.count, anon())
        if f.hasRet {
            LLVMBuildRet(st.b, r)
        } else {
            LLVMBuildRetVoid(st.b)
        }
        s += 1
    }
}

fn genLlvmFunc(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    val slot: U64 = userFnSlot(st: inout st, idx: fi)
    genLlvmFuncBody(c: inout c, st: inout st, fi: fi, fv: st.fnVal[slot])
}

// Emit function `fi`'s body into the LLVM function value `fv` (under the active
// substitution env, if any — used for both plain functions and generic instances).
fn genLlvmFuncBody(c: inout Comp, st: inout LlvmCtx, fi: U64, fv: LLVMValueRef) {
    val f: Func = c.funcs[fi]
    st.curFn = fv
    st.curIsMain = false
    st.curRetVoid = !f.hasRet
    st.curRetTy = llvmFnRetTy(c: inout c, st: inout st, f: f)
    st.curRetTyStart = f.retStart
    st.curRetTyLen = f.retLen
    // ground the return ref under any active generic env (a monomorphized method
    // body: `Optional[T]` -> `Optional[I64]`) so return-context enum construction
    // can infer the concrete instance.
    st.curRetRef = groundTypeRef(c: inout c, ref: f.retTy)
    val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, fv, cstr(s: "entry"))
    LLVMPositionBuilderAtEnd(st.b, entry)
    st.terminated = false
    // fresh local scope; bind each param into an alloca (so it reads/writes
    // uniformly with locals).
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    // method receiver: bind `self` as a local pointing at the struct storage —
    // an `inout fn`'s self IS the pointer param; a by-value self is stored into a
    // fresh alloca (so mutations stay local). Field access then GEPs locPtr
    // uniformly. Params follow self at index 1.
    mut val base: U64 = 0
    if f.hasRecv {
        // a generic method's receiver is its instantiation (curRecvInstRef): its
        // LLVM type / struct-index / env come from the instance, not the bare head
        // name (which `llvmScalarTy` can't resolve to a registered generic type).
        mut val recvTy: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: f.recvStart, tyLen: f.recvLen)
        mut val recvSidx: U64 = localStructIdxFor(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen)
        mut val recvRef: U64 = 0
        if st.curRecvInstRef != 0U64 {
            recvRef = st.curRecvInstRef
            recvTy = llvmTypeOfRef(c: inout c, st: inout st, ref: st.curRecvInstRef)
            val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: st.curRecvInstRef)
            if gs < st.genStructRefs.count {
                recvSidx = st.genStructDefs[gs]
            } else {
                recvSidx = c.structs.count
            }
        }
        mut val selfPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
        if f.selfInout {
        } else {
            selfPtr = LLVMBuildAlloca(st.b, recvTy, anon())
            LLVMBuildStore(st.b, LLVMGetParam(fv, 0U64), selfPtr)
        }
        pushLocalR(st: inout st, nameStart: st.selfStart, nameLen: st.selfLen, ptr: selfPtr, ty: recvTy, kind: 0U64, structIdx: recvSidx, isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: recvRef)
        // a `move fn` self is owned (deinit'd in the callee); `fn`/`inout fn`/
        // `borrow fn` self is a borrow the caller owns.
        setLocalOwned(st: inout st, owned: f.selfMove)
        base = 1U64
    }
    mut val pi: U64 = 0
    while pi < f.params.count {
        bindOneParam(c: inout c, st: inout st, p: f.params[pi], fv: fv, argIdx: pi + base)
        // a `move` param is owned (deinit'd here); inout/borrow/by-value are not.
        setLocalOwned(st: inout st, owned: f.params[pi].isMove)
        pi += 1
    }
    st.curBodyMark = st.nLocals
    genLlvmBlock(c: inout c, st: inout st, id: f.body)
    if st.terminated {
    } else {
        // fall-through: the body block dropped its body locals; now drop owned
        // params (a `move` param / `move fn` self the callee deinits).
        dropScope(c: inout c, st: inout st, fromMark: 0U64, excludeLi: 18446744073709551615U64)
        // checkReturns guarantees a non-() function diverges on every path, so a
        // fall-through here is a () function: return void.
        if st.curRetVoid {
            LLVMBuildRetVoid(st.b)
        } else {
            LLVMBuildUnreachable(st.b)
        }
    }
}

// ---- statement / block emission ----

fn genLlvmStmt(c: inout Comp, st: inout LlvmCtx, id: U64) {
    if st.terminated {
        return
    }
    val s: Stmt = c.stmts[id]
    match s {
        Stmt.Let(mutable: _, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
            // an array binding: element type from the annotation, else the literal's
            // first element. Tracked so arr[i] / .append know the element layout.
            mut val isArr: Bool = tyIsArray
            mut val elemTy: LLVMTypeRef = st.i64ty
            mut val elemKind: U64 = 0
            if tyIsArray {
                elemTy = llvmScalarTy(c: inout c, st: inout st, tyStart: tyStart, tyLen: tyLen)
                // a compound element (`Array[Ref[Box]]`, `Array[Box[I32]]`) has a
                // mangled tyStart llvmScalarTy can't resolve — use the element ref.
                if ty != 0U64 {
                    if c.types[ty].args.count > 0U64 {
                        elemTy = llvmTypeOfRef(c: inout c, st: inout st, ref: c.types[ty].args[0])
                    }
                }
                elemKind = kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen)
            } else {
                match c.exprs[init] {
                    Expr.Array(val elems) => {
                        isArr = true
                        if elems.count > 0U64 {
                            elemTy = exprLlvmType(c: inout c, st: inout st, id: elems[0])
                            elemKind = valueKind(c: inout c, st: inout st, id: elems[0])
                        }
                    }
                    _ => {
                        // an un-annotated array-valued initializer (`val bs = s.bytes`):
                        // track it as an array so `bs.count` / `bs[i]` resolve.
                        if exprIsArray(c: inout c, st: inout st, id: init) {
                            isArr = true
                            elemTy = arrElemTyOf(c: inout c, st: inout st, id: init)
                            elemKind = arrElemKindOf(c: inout c, st: inout st, id: init)
                        }
                    }
                }
            }
            // an array literal initializer is built with the binding's element type
            // (so `Array[U16] = [300, 1000]` uses i16 elements, not i64-defaulted).
            mut val v: LLVMValueRef = LLVMConstInt(st.i64ty, 0U64, 0I32)
            mut val builtArr: Bool = false
            if isArr {
                match c.exprs[init] {
                    Expr.Array(val elems) => {
                        v = genLlvmArrayLit(c: inout c, st: inout st, elems: elems, elemTy: elemTy)
                        builtArr = true
                    }
                    _ => {}
                }
            }
            if builtArr {
            } else {
                // a let annotation provides the expected type so an un-suffixed JSX
                // generic construction (`val o: Optional[I64] = <Optional.Some … />`)
                // infers its type args. Consumed by the construction (cleared there).
                if isArr {
                } else {
                    st.expectedTy = ty
                }
                v = genLlvmExpr(c: inout c, st: inout st, id: init)
                st.expectedTy = 0U64
                // value semantics: binding an array from an existing place (`val b = a`)
                // copies the buffer so later mutation through one binding leaves the
                // other unchanged (CoW, here eager).
                if isArr {
                    if arrayExprIsPlace(c: inout c, id: init) {
                        v = copyArrayValue(c: inout c, st: inout st, arrVal: v, elemTy: elemTy)
                    }
                } else {
                    // a struct value bound from a place deep-copies its array fields
                    // (`val y = x` then `x.items[0]=…` leaves y.items unchanged; a
                    // generic field grounding to an array is handled under the env).
                    v = copyValueIfPlace(c: inout c, st: inout st, rv: v, valueExpr: init)
                }
            }
            mut val kind: U64 = valueKind(c: inout c, st: inout st, id: init)
            if tyLen > 0U64 {
                if isArr {
                } else {
                    v = coerceIntTo(c: inout c, st: inout st, v: v, tyStart: tyStart, tyLen: tyLen)
                    kind = kindFromTySpan(c: inout c, tyStart: tyStart, tyLen: tyLen)
                }
            }
            val lty: LLVMTypeRef = LLVMTypeOf(v)
            mut val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: init)
            if tyLen > 0U64 {
                sidx = localStructIdxFor(c: inout c, st: inout st, start: tyStart, len: tyLen)
            }
            // a generic struct instance (Box[I32]): point at the generic def (so
            // field access works) and track the instance ref for substitution.
            mut val tref: U64 = 0
            if isGenericInst(c: inout c, ref: ty) {
                val gslot: U64 = genStructSlot(c: inout c, st: inout st, ref: ty)
                if gslot < st.genStructRefs.count {
                    sidx = st.genStructDefs[gslot]
                    tref = ty
                } else {
                    if genEnumSlot(c: inout c, st: inout st, ref: ty) < st.genEnumRefs.count {
                        tref = ty
                    }
                }
            }
            // a `Ref[T]` local: track the instance so `->` resolves the pointee
            // struct (Ref isn't a registered generic struct/enum, so isGenericInst
            // is false for it).
            if isRefInst(c: inout c, ref: ty) {
                tref = ty
            }
            // a function-value local (`val g: fn(n: I32) -> I32 = …`): track the fn
            // TypeRef so a call `g(n: 4)` resolves the closure signature.
            if isFnType(c: inout c, ref: ty) {
                tref = ty
            }
            // an un-annotated binding to a call returning a generic instance
            // (`val r = makeBox()` -> Box[I64]): recover the instance ref + def so
            // `r.v` substitutes T. (typeOf can't see this local; resolve from AST.)
            if tref == 0U64 {
                if tyLen == 0U64 {
                    if isArr {
                    } else {
                        val rref: U64 = exprResultRef(c: inout c, st: inout st, id: init)
                        if isGenericInst(c: inout c, ref: rref) {
                            val gslot2: U64 = genStructSlot(c: inout c, st: inout st, ref: rref)
                            if gslot2 < st.genStructRefs.count {
                                sidx = st.genStructDefs[gslot2]
                                tref = rref
                            } else {
                                if genEnumSlot(c: inout c, st: inout st, ref: rref) < st.genEnumRefs.count {
                                    tref = rref
                                }
                            }
                        }
                    }
                }
            }
            // a non-generic enum local: track a bare TypeRef so `==`/match recover
            // the enum (typeOf can't see locals — c.locals is unpopulated here).
            if tref == 0U64 {
                if tyLen > 0U64 {
                    if enumRegSlot(c: inout c, st: inout st, start: tyStart, len: tyLen) < st.enumIdxs.count {
                        tref = simpleTypeRef(c: inout c, nameStart: tyStart, nameLen: tyLen)
                    }
                }
            }
            val slot: LLVMValueRef = LLVMBuildAlloca(st.b, lty, anon())
            LLVMBuildStore(st.b, v, slot)
            pushLocalR(st: inout st, nameStart: nameStart, nameLen: nameLen, ptr: slot, ty: lty, kind: kind, structIdx: sidx, isArr: isArr, elemTy: elemTy, elemKind: elemKind, typeRef: tref)
            // an array-of-struct local (`store: Array[Box]`): track the element struct
            // so `store[i].field` resolves the element (tyStart names the element type).
            if isArr {
                if tyLen > 0U64 {
                    val esi: U64 = localStructIdxFor(c: inout c, st: inout st, start: tyStart, len: tyLen)
                    if esi < c.structs.count {
                        setLocalElemStruct(st: inout st, esi: esi)
                    }
                }
                // track the element's TypeRef so `ys[i]` recovers a Ref / nested-array
                // element. `ty` is the Array[E] ref, so the element is its first arg.
                if tyIsArray {
                    if ty != 0U64 {
                        val at: TypeRef = c.types[ty]
                        if at.args.count > 0U64 {
                            setLocalElemTypeRef(st: inout st, ref: at.args[0])
                        }
                    }
                }
            }
        }
        Stmt.Assign(val op, val target, val value) => {
            match c.exprs[target] {
                Expr.Ident(val start, val len) => {
                    val li: U64 = findLocal(c: inout c, st: inout st, start: start, len: len)
                    if li < st.nLocals {
                        mut val rv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: value)
                        // coerce the value to the local's width (a context-less
                        // literal may default wider/narrower).
                        if LLVMGetTypeKind(LLVMTypeOf(rv)) == 8U32 {
                            rv = coerceInt(st: inout st, v: rv, target: st.locTy[li], unsigned: st.locKind[li] == 3U64)
                        }
                        // value semantics: a plain assignment from an array/struct place
                        // (`b = a`) copies so the two bindings stay independent.
                        if op == opAssign() {
                            rv = copyValueIfPlace(c: inout c, st: inout st, rv: rv, valueExpr: value)
                        }
                        if op == opAssign() {
                            // reassigning a unique local deinits its PREVIOUS value
                            // first (spec/03) — load and destroy the old, unless the
                            // local was moved out (no live value) or not owned.
                            if st.locOwned[li] {
                                if st.locMoved[li] {
                                } else {
                                    val osi: U64 = st.locStructIdx[li]
                                    if osi < c.structs.count {
                                        if structNeedsDeinit(c: inout c, st: inout st, sidx: osi) {
                                            emitDeinitValue(c: inout c, st: inout st, v: LLVMBuildLoad2(st.b, st.locTy[li], st.locPtr[li], anon()), sidx: osi)
                                        }
                                    }
                                }
                            }
                            // the local re-owns the new value (clear any moved flag).
                            st.locMoved[li] = false
                            LLVMBuildStore(st.b, rv, st.locPtr[li])
                        } else {
                            val cur: LLVMValueRef = LLVMBuildLoad2(st.b, st.locTy[li], st.locPtr[li], anon())
                            val nv: LLVMValueRef = buildBinOp(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv)
                            LLVMBuildStore(st.b, nv, st.locPtr[li])
                        }
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: start), msg: "LLVM backend: assignment target must be a local (so far)")
                    }
                }
                Expr.Index(base: val ibase, index: val iindex) => {
                    // place mutation `arr[i] = v` / `arr[i] OP= v`: bounds-checked
                    // element pointer + store (the buffer is shared; no CoW yet).
                    // A user IndexSet-impl subscript desugars `g[i] = v` to
                    // `g.indexSet(key: i, value: v)` via the IndexSet witness (the
                    // compound form `g[i] OP= v` desugars `v` to `g[i] OP v` first).
                    if exprIsArray(c: inout c, st: inout st, id: ibase) {
                    } else {
                        val ibsi: U64 = exprStructIdx(c: inout c, st: inout st, id: ibase)
                        if ibsi < c.structs.count {
                            if typeHasMethodNamed(c: inout c, typeStart: c.structs[ibsi].nameStart, typeLen: c.structs[ibsi].nameLen, name: "indexSet") {
                                mut val rhsExpr: U64 = value
                                if op == opAssign() {
                                } else {
                                    val getExpr: U64 = c.pushExpr(e: <Expr.Index base=ibase index=iindex />)
                                    rhsExpr = c.pushExpr(e: <Expr.Binary op=compoundBinOp(op: op) lhs=getExpr rhs=value />)
                                }
                                val m: U64 = synthDictMethod(c: inout c, recv: ibase, name: "indexSet", arg0Label: "key", arg0: iindex, hasArg1: true, arg1Label: "value", arg1: rhsExpr)
                                genLlvmExpr(c: inout c, st: inout st, id: m)
                                return
                            }
                        }
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: ibase)), msg: "LLVM backend: user IndexSet subscript needs an `indexSet` method")
                        return
                    }
                    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: ibase)
                    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: ibase)
                    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
                    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
                    val idx: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iindex)
                    emitBoundsCheck(c: inout c, st: inout st, idx: idx, count: count)
                    val ep: LLVMValueRef = arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: idx)
                    val rv: LLVMValueRef = coerceElem(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), elemTy: elemTy)
                    if op == opAssign() {
                        LLVMBuildStore(st.b, rv, ep)
                    } else {
                        val cur: LLVMValueRef = LLVMBuildLoad2(st.b, elemTy, ep, anon())
                        LLVMBuildStore(st.b, buildBinOp(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv), ep)
                    }
                }
                Expr.Field(base: val fbase, nameStart: val fnameStart, nameLen: val fnameLen) => {
                    // place mutation `base.field = v`: GEP into the base local's
                    // alloca + store (base must be an addressable struct local).
                    match c.exprs[fbase] {
                        Expr.Ident(start: val bs, len: val bl) => {
                            val li: U64 = findLocal(c: inout c, st: inout st, start: bs, len: bl)
                            val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: fbase)
                            if li < st.nLocals && sidx < c.structs.count {
                                val fidx: U64 = structFieldIndex(c: inout c, sidx: sidx, start: fnameStart, len: fnameLen)
                                if fidx < c.structs[sidx].fields.count {
                                    val fld: FieldDef = c.structs[sidx].fields[fidx]
                                    val gep: LLVMValueRef = LLVMBuildStructGEP2(st.b, st.locTy[li], st.locPtr[li], fidx, anon())
                                    val rv: LLVMValueRef = coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                    if op == opAssign() {
                                        LLVMBuildStore(st.b, rv, gep)
                                    } else {
                                        val ftype: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                        val cur: LLVMValueRef = LLVMBuildLoad2(st.b, ftype, gep, anon())
                                        LLVMBuildStore(st.b, buildBinOp(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv), gep)
                                    }
                                    return
                                }
                            }
                            compileErrorAt(line: lineOf(c: inout c, offset: fnameStart), msg: "LLVM backend: field assignment only on a registered struct local (so far)")
                        }
                        _ => {
                            // a general place base (`arr[i].field = v`, get-modify-set):
                            // the base struct pointer via placePtrOf, then GEP the field.
                            val bsi: U64 = exprStructIdx(c: inout c, st: inout st, id: fbase)
                            mut val handled: Bool = false
                            if bsi < c.structs.count {
                                val fidx: U64 = structFieldIndex(c: inout c, sidx: bsi, start: fnameStart, len: fnameLen)
                                if fidx < c.structs[bsi].fields.count {
                                    val baseTy: LLVMTypeRef = structLlvmTyOfExpr(c: inout c, st: inout st, structExpr: fbase, sidx: bsi)
                                    if LLVMIsNull(baseTy) == 0I32 {
                                        val fld: FieldDef = c.structs[bsi].fields[fidx]
                                        val basePtr: LLVMValueRef = placePtrOf(c: inout c, st: inout st, id: fbase)
                                        val gep: LLVMValueRef = LLVMBuildStructGEP2(st.b, baseTy, basePtr, fidx, anon())
                                        val rv: LLVMValueRef = coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                                        if op == opAssign() {
                                            LLVMBuildStore(st.b, rv, gep)
                                        } else {
                                            val ftype: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                            val cur: LLVMValueRef = LLVMBuildLoad2(st.b, ftype, gep, anon())
                                            LLVMBuildStore(st.b, buildBinOp(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv), gep)
                                        }
                                        handled = true
                                    }
                                }
                            }
                            if handled {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "LLVM backend: nested place assignment not yet supported")
                            }
                        }
                    }
                }
                Expr.Arrow(base: val abase, nameStart: val ans, nameLen: val anl) => {
                    // `r->field = v`: GEP into the Ref's cell (the pointee struct) and
                    // store. The cell is shared, so the write is visible through any
                    // alias of the Ref.
                    val psidx: U64 = refPointeeStructIdx(c: inout c, st: inout st, base: abase)
                    if psidx < c.structs.count {
                        val fidx: U64 = structFieldIndex(c: inout c, sidx: psidx, start: ans, len: anl)
                        if fidx < c.structs[psidx].fields.count {
                            val fld: FieldDef = c.structs[psidx].fields[fidx]
                            val pty: LLVMTypeRef = refPointeeTy(c: inout c, st: inout st, refTy: exprRefTypeRef(c: inout c, st: inout st, id: abase))
                            val cellPtr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: abase)
                            val gep: LLVMValueRef = LLVMBuildStructGEP2(st.b, pty, cellPtr, fidx, anon())
                            val rv: LLVMValueRef = coerceIntTo(c: inout c, st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: value), tyStart: fld.tyStart, tyLen: fld.tyLen)
                            if op == opAssign() {
                                LLVMBuildStore(st.b, rv, gep)
                            } else {
                                val ftype: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                                val cur: LLVMValueRef = LLVMBuildLoad2(st.b, ftype, gep, anon())
                                LLVMBuildStore(st.b, buildBinOp(c: inout c, st: inout st, op: compoundBinOp(op: op), l: cur, r: rv), gep)
                            }
                            return
                        }
                    }
                    compileErrorAt(line: lineOf(c: inout c, offset: ans), msg: "LLVM backend: `->` assignment only on a Ref to a registered struct (so far)")
                }
                _ => {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "LLVM backend: only simple `name = …` assignment is supported so far")
                }
            }
        }
        Stmt.ExprStmt(val expr) => {
            val ignore: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: expr)
        }
        Stmt.Panic(val msg, offset: _) => {
            val ignore: LLVMValueRef = emitStrSink(c: inout c, st: inout st, rtName: "plew_panic_raw", rtId: 4U64, argExpr: msg)
            LLVMBuildUnreachable(st.b)
            st.terminated = true
        }
        Stmt.Return(val value, val hasValue) => {
            val sentinel: U64 = 18446744073709551615U64
            if st.curIsMain {
                // Plew `main` returns () -> C `int main` returns 0; drop live locals.
                dropScope(c: inout c, st: inout st, fromMark: 0U64, excludeLi: sentinel)
                LLVMBuildRet(st.b, LLVMConstInt(st.i32ty, 0U64, 0I32))
            } else {
                if hasValue {
                    // the declared return type is the expected type, so a returned
                    // un-suffixed generic construction (`return <Optional.Some …/>`)
                    // infers its type args. Consumed by the construction.
                    st.expectedTy = st.curRetRef
                    mut val rv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: value)
                    st.expectedTy = 0U64
                    if st.curRetTyLen > 0U64 {
                        rv = coerceIntTo(c: inout c, st: inout st, v: rv, tyStart: st.curRetTyStart, tyLen: st.curRetTyLen)
                    }
                    // value semantics: returning an array/struct place gives the caller
                    // an independent value (`return b.xs` then caller's `r[0]=…`).
                    rv = copyValueIfPlace(c: inout c, st: inout st, rv: rv, valueExpr: value)
                    // scope-exit deinits for all live locals — but a returned local is
                    // moved out to the caller, so exclude it.
                    mut val excludeLi: U64 = sentinel
                    match c.exprs[value] {
                        Expr.Ident(start: val s, len: val l) => {
                            val li: U64 = findLocal(c: inout c, st: inout st, start: s, len: l)
                            if li < st.nLocals {
                                excludeLi = li
                            }
                        }
                        _ => {}
                    }
                    dropScope(c: inout c, st: inout st, fromMark: 0U64, excludeLi: excludeLi)
                    LLVMBuildRet(st.b, rv)
                } else {
                    dropScope(c: inout c, st: inout st, fromMark: 0U64, excludeLi: sentinel)
                    LLVMBuildRetVoid(st.b)
                }
            }
            st.terminated = true
        }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            val cv: LLVMValueRef = genLlvmCond(c: inout c, st: inout st, id: cond)
            val thenBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "then"))
            val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "endif"))
            mut val elseBB: LLVMBasicBlockRef = contBB
            if hasElse {
                elseBB = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "else"))
            }
            LLVMBuildCondBr(st.b, cv, thenBB, elseBB)
            // then
            LLVMPositionBuilderAtEnd(st.b, thenBB)
            st.terminated = false
            genLlvmBlock(c: inout c, st: inout st, id: thenBlk)
            if st.terminated {
            } else {
                LLVMBuildBr(st.b, contBB)
            }
            // else
            if hasElse {
                LLVMPositionBuilderAtEnd(st.b, elseBB)
                st.terminated = false
                genLlvmBlock(c: inout c, st: inout st, id: elseBlk)
                if st.terminated {
                } else {
                    LLVMBuildBr(st.b, contBB)
                }
            }
            LLVMPositionBuilderAtEnd(st.b, contBB)
            st.terminated = false
        }
        Stmt.While(val cond, val body) => {
            val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "while.cond"))
            val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "while.body"))
            val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "while.end"))
            LLVMBuildBr(st.b, condBB)
            LLVMPositionBuilderAtEnd(st.b, condBB)
            val cv: LLVMValueRef = genLlvmCond(c: inout c, st: inout st, id: cond)
            LLVMBuildCondBr(st.b, cv, bodyBB, endBB)
            LLVMPositionBuilderAtEnd(st.b, bodyBB)
            st.terminated = false
            genLlvmBlock(c: inout c, st: inout st, id: body)
            if st.terminated {
            } else {
                LLVMBuildBr(st.b, condBB)
            }
            LLVMPositionBuilderAtEnd(st.b, endBB)
            st.terminated = false
        }
        Stmt.Match(val scrut, val arms) => {
            genLlvmMatch(c: inout c, st: inout st, scrut: scrut, arms: arms)
        }
        Stmt.Give(val value) => {
            // yield the enclosing value-position block's result (IfExpr reads it).
            st.giveValue = genLlvmExpr(c: inout c, st: inout st, id: value)
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            if isStruct {
                genLlvmForArrayStruct(c: inout c, st: inout st, patStart: patStart, patLen: patLen, iter: iter, binds: binds, body: body)
            } else {
                if isRange {
                    genLlvmForRange(c: inout c, st: inout st, varStart: varStart, varLen: varLen, varTyStart: varTyStart, varTyLen: varTyLen, inclusive: inclusive, lo: iter, hi: rangeHi, body: body)
                } else {
                    genLlvmForArray(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, body: body)
                }
            }
        }
        _ => {
            compileErrorAt(line: 0, msg: "LLVM backend: statement form not yet supported")
        }
    }
}

// Lower `match scrut { Pat => block, ... }` on a registered enum: store the
// scrutinee, switch on its tag through a chain of compare/branch blocks, and in
// each arm bind the variant's payload fields (extracted from the payload area)
// before emitting its body. Exhaustiveness is guaranteed by the front-end; a
// wildcard `_` arm is the catch-all.
fn genLlvmMatch(c: inout Comp, st: inout LlvmCtx, scrut: U64, arms: Array[MatchArm]) {
    val sv: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: scrut)
    val sty: LLVMTypeRef = LLVMTypeOf(sv)
    // a struct destructuring match `match s { S { val x } => … }` is irrefutable
    // (one arm, no tag): store the scrutinee, bind its fields, emit the body.
    if arms.count > 0U64 {
        if arms[0].isStruct {
            val ssidx: U64 = exprStructIdx(c: inout c, st: inout st, id: scrut)
            val savedSP: Array[Bind] = c.curTypeParams
            val savedSA: Array[U64] = c.curTypeArgs
            val didSetS: Bool = setStructEnv(c: inout c, st: inout st, ref: exprTypeRef(c: inout c, st: inout st, id: scrut))
            val sslot0: LLVMValueRef = LLVMBuildAlloca(st.b, sty, anon())
            LLVMBuildStore(st.b, sv, sslot0)
            val mark0: U64 = st.nLocals
            bindStructPattern(c: inout c, st: inout st, sidx: ssidx, binds: arms[0].binds, scrutTy: sty, scrutSlot: sslot0)
            genLlvmBlock(c: inout c, st: inout st, id: arms[0].body)
            st.nLocals = mark0
            if didSetS {
                c.curTypeParams = savedSP
                c.curTypeArgs = savedSA
            }
            return
        }
    }
    // The scrutinee's enum instance ref. The enum env (for payload-type resolution)
    // is set ONLY around bindMatchPayload — NOT for the arm bodies, which must keep
    // the outer (e.g. monomorphized-method) env so a body's `self.f` / `self.inner`
    // still grounds. Saved here so each arm can set/restore around its bind.
    val scrutRef: U64 = exprTypeRef(c: inout c, st: inout st, id: scrut)
    val savedMP: Array[Bind] = c.curTypeParams
    val savedMA: Array[U64] = c.curTypeArgs
    // the enum: from the first non-wildcard, non-struct arm.
    mut val eid: U64 = c.enums.count
    mut val ai0: U64 = 0
    while ai0 < arms.count {
        if arms[ai0].isWildcard {
        } else {
            if arms[ai0].isStruct {
            } else {
                if eid == c.enums.count {
                    eid = enumIdxByName(c: inout c, start: arms[ai0].enumStart, len: arms[ai0].enumLen)
                }
            }
        }
        ai0 += 1
    }
    if eid < c.enums.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: match is only supported on a registered enum (so far)")
        return
    }
    // store the scrutinee so payload fields can be read back as a variant struct.
    val sslot: LLVMValueRef = LLVMBuildAlloca(st.b, sty, anon())
    LLVMBuildStore(st.b, sv, sslot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, sty, sslot, 0U64, anon()), anon())
    val contBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "match.end"))
    // the tag-test chain lives in `checkBB`; each arm body lives in its own block.
    // Re-position at checkBB before every compare so emitting an arm body (which
    // moves the builder) doesn't append the next compare after a ret.
    mut val checkBB: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    mut val lastWasWildcard: Bool = false
    mut val anyFallthrough: Bool = false
    mut val ai: U64 = 0
    while ai < arms.count {
        val arm: MatchArm = arms[ai]
        val armBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "arm"))
        LLVMPositionBuilderAtEnd(st.b, checkBB)
        if arm.isWildcard {
            LLVMBuildBr(st.b, armBB)
            lastWasWildcard = true
        } else {
            val vi: U64 = variantIndex(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
            val nextBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "match.next"))
            val eq: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, vi, 0I32), anon())
            LLVMBuildCondBr(st.b, eq, armBB, nextBB)
            checkBB = nextBB
            lastWasWildcard = false
        }
        // emit the arm body in armBB, with payload binds in a fresh scope.
        val savedBB: U64 = st.nLocals
        LLVMPositionBuilderAtEnd(st.b, armBB)
        st.terminated = false
        if arm.isWildcard {
        } else {
            // bind the payload under the enum env, then restore the outer env so the
            // arm body grounds against the enclosing method/function, not the enum.
            val didB: Bool = setEnumEnv(c: inout c, st: inout st, ref: scrutRef)
            bindMatchPayload(c: inout c, st: inout st, eid: eid, arm: arm, scrutTy: sty, scrutSlot: sslot)
            if didB {
                c.curTypeParams = savedMP
                c.curTypeArgs = savedMA
            }
        }
        genLlvmBlock(c: inout c, st: inout st, id: arm.body)
        st.nLocals = savedBB
        if st.terminated {
        } else {
            LLVMBuildBr(st.b, contBB)
            anyFallthrough = true
        }
        ai += 1
    }
    // close the dangling final check block (exhaustive, so unreachable) unless a
    // wildcard already terminated it.
    if lastWasWildcard {
    } else {
        LLVMPositionBuilderAtEnd(st.b, checkBB)
        LLVMBuildUnreachable(st.b)
    }
    // the continuation is reachable only if some arm fell through.
    LLVMPositionBuilderAtEnd(st.b, contBB)
    if anyFallthrough {
        st.terminated = false
    } else {
        LLVMBuildUnreachable(st.b)
        st.terminated = true
    }
}

// Bind a match arm's payload fields as locals: read the variant payload struct
// back from the scrutinee's payload area and extractvalue each bound field.
fn bindMatchPayload(c: inout Comp, st: inout LlvmCtx, eid: U64, arm: MatchArm, scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
    if arm.binds.count == 0U64 {
        return
    }
    val vi: U64 = variantIndex(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen)
    val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: eid, vi: vi)
    val payload: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, scrutTy, scrutSlot, 1U64, anon()), anon())
    val fs: Array[FieldDef] = c.enums[eid].variants[vi].fields
    mut val bi: U64 = 0
    while bi < arm.binds.count {
        val b: Bind = arm.binds[bi]
        // resolve which variant field this bind reads (by field name = b.fieldStart).
        mut val fidx: U64 = fs.count
        mut val fj: U64 = 0
        while fj < fs.count {
            if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                fidx = fj
                fj = fs.count
            } else {
                fj += 1
            }
        }
        if fidx < fs.count {
            val fd: FieldDef = fs[fidx]
            // an array-typed payload field (declared `Array[E]` or a type param that
            // grounds to one): the bound local is the {ptr,i64} array value, tracked
            // as an array so `v[i]` / `v.count` work in the arm body.
            val elemRef: U64 = arrayFieldElemRef(c: inout c, f: fd)
            mut val pty: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: fd.tyStart, tyLen: fd.tyLen)
            mut val isArrF: Bool = false
            mut val elemTyF: LLVMTypeRef = st.i64ty
            mut val elemKindF: U64 = 0U64
            if elemRef != 0U64 {
                pty = st.arrayTy
                isArrF = true
                elemTyF = llvmTypeOfRef(c: inout c, st: inout st, ref: elemRef)
                val et: TypeRef = c.types[elemRef]
                elemKindF = kindFromTySpan(c: inout c, tyStart: et.nameStart, tyLen: et.nameLen)
            }
            // a boxed (recursive) payload field holds a heap pointer; load the boxed
            // value back. A non-boxed field is the value directly.
            mut val fv: LLVMValueRef = LLVMBuildExtractValue(st.b, payload, fidx, anon())
            if fieldIsBoxed(c: inout c, f: fd) {
                fv = LLVMBuildLoad2(st.b, pty, fv, anon())
            }
            val slot: LLVMValueRef = LLVMBuildAlloca(st.b, pty, anon())
            LLVMBuildStore(st.b, fv, slot)
            // an enum-typed bind carries a bare enum TypeRef so a nested match on it
            // (the recursive case) recovers the enum (typeOf can't see this local).
            mut val tref: U64 = 0
            if enumRegSlot(c: inout c, st: inout st, start: fd.tyStart, len: fd.tyLen) < st.enumIdxs.count {
                tref = simpleTypeRef(c: inout c, nameStart: fd.tyStart, nameLen: fd.tyLen)
            }
            pushLocalR(st: inout st, nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: pty, kind: kindFromTySpan(c: inout c, tyStart: fd.tyStart, tyLen: fd.tyLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: fd.tyStart, len: fd.tyLen), isArr: isArrF, elemTy: elemTyF, elemKind: elemKindF, typeRef: tref)
        }
        bi += 1
    }
}

// Bind the fields of a struct destructuring pattern `S { val x, field: val y,
// field2: _ }` (irrefutable — a struct has one shape). Each named bind reads its
// field from the stored scrutinee, honoring array / nested-struct / type-param
// field types (under any generic env the caller set). Discards (`_`, empty name)
// are skipped.
fn bindStructPattern(c: inout Comp, st: inout LlvmCtx, sidx: U64, binds: Array[Bind], scrutTy: LLVMTypeRef, scrutSlot: LLVMValueRef) {
    val fs: Array[FieldDef] = c.structs[sidx].fields
    mut val bi: U64 = 0
    while bi < binds.count {
        val b: Bind = binds[bi]
        if b.nameLen == 0U64 {
            bi += 1
        } else {
            // resolve which field this bind reads (by field name = b.fieldStart).
            mut val fidx: U64 = fs.count
            mut val fj: U64 = 0
            while fj < fs.count {
                if spansEqual(c: inout c, aStart: fs[fj].nameStart, aLen: fs[fj].nameLen, bStart: b.fieldStart, bLen: b.fieldLen) {
                    fidx = fj
                    fj = fs.count
                } else {
                    fj += 1
                }
            }
            if fidx < fs.count {
                val fld: FieldDef = fs[fidx]
                val fty: LLVMTypeRef = llvmTypeFor(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen, isArray: fld.tyIsArray)
                val fv: LLVMValueRef = LLVMBuildLoad2(st.b, fty, LLVMBuildStructGEP2(st.b, scrutTy, scrutSlot, fidx, anon()), anon())
                val slot: LLVMValueRef = LLVMBuildAlloca(st.b, fty, anon())
                LLVMBuildStore(st.b, fv, slot)
                mut val elemTy: LLVMTypeRef = st.i64ty
                mut val elemKind: U64 = 0
                if fld.tyIsArray {
                    elemTy = llvmScalarTy(c: inout c, st: inout st, tyStart: fld.tyStart, tyLen: fld.tyLen)
                    elemKind = kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen)
                }
                pushLocal(st: inout st, nameStart: b.nameStart, nameLen: b.nameLen, ptr: slot, ty: fty, kind: kindFromTySpan(c: inout c, tyStart: fld.tyStart, tyLen: fld.tyLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: fld.tyStart, len: fld.tyLen), isArr: fld.tyIsArray, elemTy: elemTy, elemKind: elemKind)
            }
            bi += 1
        }
    }
}

// `for i in lo ..< hi { body }` (or `..= hi`): a counter loop. The loop variable
// is bound to a fresh slot incremented each iteration; range elements are U64.
fn genLlvmForRange(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, varTyStart: U64, varTyLen: U64, inclusive: Bool, lo: U64, hi: U64, body: U64) {
    val mark: U64 = st.nLocals
    mut val vty: LLVMTypeRef = st.i64ty
    if varTyLen > 0U64 {
        vty = llvmScalarTy(c: inout c, st: inout st, tyStart: varTyStart, tyLen: varTyLen)
    }
    val loV: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: lo), target: vty, unsigned: true)
    val hiV: LLVMValueRef = coerceInt(st: inout st, v: genLlvmExpr(c: inout c, st: inout st, id: hi), target: vty, unsigned: true)
    val islot: LLVMValueRef = LLVMBuildAlloca(st.b, vty, anon())
    LLVMBuildStore(st.b, loV, islot)
    pushLocal(st: inout st, nameStart: varStart, nameLen: varLen, ptr: islot, ty: vty, kind: 3U64, structIdx: c.structs.count, isArr: false, elemTy: st.i64ty, elemKind: 0U64)
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "for.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    val iv: LLVMValueRef = LLVMBuildLoad2(st.b, vty, islot, anon())
    mut val pred: U32 = llvmIntUlt()
    if inclusive {
        pred = llvmIntUle()
    }
    LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, pred, iv, hiV, anon()), bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    genLlvmBlock(c: inout c, st: inout st, id: body)
    if st.terminated {
    } else {
        val iv2: LLVMValueRef = LLVMBuildLoad2(st.b, vty, islot, anon())
        LLVMBuildStore(st.b, LLVMBuildAdd(st.b, iv2, LLVMConstInt(vty, 1U64, 0I32), anon()), islot)
        LLVMBuildBr(st.b, condBB)
    }
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// `for x in arr { body }`: walk an array by index, binding x to each element.
// `for x in iterable { body }` over a user Iterable (spec/11): desugar to the
// iterator protocol — `it = iterable.iterator(); loop { match it.next() { Some(v)
// => { x = v; body }, None => break } }`. The iterator is stored in a mutable slot
// (next() is `inout`); each next() yields an Optional[Item] matched by tag.
fn genLlvmForIterable(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, body: U64) {
    // Generic-instance iterable/iterator (`Box[I64]` / `BoxIter[I64]`): the
    // iterator()/next() methods are monomorphized into the generic-method slots,
    // so route through that path rather than the plain user-fn slots.
    val recvRef: U64 = exprTypeRef(c: inout c, st: inout st, id: iter)
    if recvRef != 0U64 {
        if isGenericInst(c: inout c, ref: recvRef) {
            genLlvmForGenIterable(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, body: body, recvRef: recvRef)
            return
        }
    }
    val isidx: U64 = exprStructIdx(c: inout c, st: inout st, id: iter)
    if isidx < c.structs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: for-loop over a non-array (Iterable) not yet supported")
        return
    }
    val isd: StructDef = c.structs[isidx]
    val noArgs: Array[Arg] = []
    val iterableVal: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iter)
    // acquire the iterator: an Iterable provides `iterator()`; an Iterator IS its own
    // iterator (it has `next()` directly). Resolve the iterator value + its struct.
    mut val iterVal: LLVMValueRef = iterableVal
    mut val iterStructStart: U64 = isd.nameStart
    mut val iterStructLen: U64 = isd.nameLen
    val itB: Bind = kwSpan(c: inout c, kw: "iterator", kwLen: 8U64)
    val itfi: U64 = findMethod(c: inout c, recvStart: isd.nameStart, recvLen: isd.nameLen, nameStart: itB.nameStart, nameLen: itB.nameLen, args: noArgs)
    if itfi < c.funcs.count {
        val itSlotF: U64 = userFnSlot(st: inout st, idx: itfi)
        if itSlotF < st.fnIdx.count {
        } else {
            compileErrorAt(line: 0, msg: "LLVM backend: this Iterable's iterator method is not emittable yet")
            return
        }
        mut val itArgs: Array[LLVMValueRef] = []
        itArgs.append(value: iterableVal)
        iterVal = LLVMBuildCall2(st.b, st.fnTy[itSlotF], st.fnVal[itSlotF], arrayCPtr(itArgs), 1U64, anon())
        iterStructStart = c.funcs[itfi].retStart
        iterStructLen = c.funcs[itfi].retLen
    }
    // next() on the Iter struct -> Optional[Item]
    val nextB: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4U64)
    val nfi: U64 = findMethod(c: inout c, recvStart: iterStructStart, recvLen: iterStructLen, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
    if nfi < c.funcs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: Iterable for-loop needs a `next` method on the iterator")
        return
    }
    val nSlotF: U64 = userFnSlot(st: inout st, idx: nfi)
    if nSlotF < st.fnIdx.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: this iterator's next method is not emittable yet")
        return
    }
    val nf: Func = c.funcs[nfi]
    emitIterNextLoop(c: inout c, st: inout st, iterVal: iterVal, optRef: nf.retTy, nextTy: st.fnTy[nSlotF], nextVal: st.fnVal[nSlotF], varStart: varStart, varLen: varLen, body: body)
}

// `for x in genericIterable` where the receiver is a generic instance (`Box[I64]`).
// iterator()/next() are monomorphized into the generic-method slots; the iterator
// instance ref is recovered by grounding iterator()'s return type under the
// receiver's env, and the Optional[Item] return by grounding next()'s under the
// iterator instance's env.
fn genLlvmForGenIterable(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, body: U64, recvRef: U64) {
    val gt: TypeRef = c.types[recvRef]
    val noArgs: Array[Arg] = []
    mut val iterVal: LLVMValueRef = LLVMConstInt(st.i64ty, 0U64, 0I32)
    mut val iterInstRef: U64 = recvRef
    val itB: Bind = kwSpan(c: inout c, kw: "iterator", kwLen: 8U64)
    val itfi: U64 = findMethod(c: inout c, recvStart: gt.nameStart, recvLen: gt.nameLen, nameStart: itB.nameStart, nameLen: itB.nameLen, args: noArgs)
    if itfi < c.funcs.count {
        // an Iterable: call iterator() and switch the instance ref to the iterator's.
        val itSlot: U64 = ensureGenMethodDeclared(c: inout c, st: inout st, mfi: itfi, instRef: recvRef)
        if itSlot < st.genMethK.count {
        } else {
            compileErrorAt(line: 0, msg: "LLVM backend: this generic Iterable's iterator method is not emittable yet")
            return
        }
        iterVal = genGenMethodCall(c: inout c, st: inout st, recv: iter, mfi: itfi, slot: itSlot, instRef: recvRef, args: noArgs)
        val itf: Func = c.funcs[itfi]
        val sP: Array[Bind] = c.curTypeParams
        val sA: Array[U64] = c.curTypeArgs
        c.curTypeParams = itf.typeParams
        c.curTypeArgs = gt.args
        iterInstRef = groundTypeRef(c: inout c, ref: itf.retTy)
        c.curTypeParams = sP
        c.curTypeArgs = sA
    } else {
        // the value IS its own Iterator (it has next() directly).
        iterVal = genLlvmExpr(c: inout c, st: inout st, id: iter)
    }
    val it: TypeRef = c.types[iterInstRef]
    val nextB: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4U64)
    val nfi: U64 = findMethod(c: inout c, recvStart: it.nameStart, recvLen: it.nameLen, nameStart: nextB.nameStart, nameLen: nextB.nameLen, args: noArgs)
    if nfi < c.funcs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: generic Iterable for-loop needs a `next` method on the iterator")
        return
    }
    val nSlot: U64 = ensureGenMethodDeclared(c: inout c, st: inout st, mfi: nfi, instRef: iterInstRef)
    if nSlot < st.genMethK.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: this generic iterator's next method is not emittable yet")
        return
    }
    val nf: Func = c.funcs[nfi]
    val sP2: Array[Bind] = c.curTypeParams
    val sA2: Array[U64] = c.curTypeArgs
    c.curTypeParams = nf.typeParams
    c.curTypeArgs = it.args
    val optRef: U64 = groundTypeRef(c: inout c, ref: nf.retTy)
    c.curTypeParams = sP2
    c.curTypeArgs = sA2
    emitIterNextLoop(c: inout c, st: inout st, iterVal: iterVal, optRef: optRef, nextTy: st.genMethTy[nSlot], nextVal: st.genMethVal[nSlot], varStart: varStart, varLen: varLen, body: body)
}

// Drive the iterator-protocol loop: store `iterVal` in a mutable slot (next() is
// `inout`), and on each `next()` call (callee `nextTy`/`nextVal`) match the ground
// `optRef` Optional[Item] — bind x to the Some payload + run body, else break.
fn emitIterNextLoop(c: inout Comp, st: inout LlvmCtx, iterVal: LLVMValueRef, optRef: U64, nextTy: LLVMTypeRef, nextVal: LLVMValueRef, varStart: U64, varLen: U64, body: U64) {
    val iterTy: LLVMTypeRef = LLVMTypeOf(iterVal)
    val iterSlot: LLVMValueRef = LLVMBuildAlloca(st.b, iterTy, anon())
    LLVMBuildStore(st.b, iterVal, iterSlot)
    // resolve the Optional enum (def + Some variant) under its instance env.
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    val didSet: Bool = setEnumEnv(c: inout c, st: inout st, ref: optRef)
    val ge: U64 = genEnumSlot(c: inout c, st: inout st, ref: optRef)
    if ge < st.genEnumRefs.count {
    } else {
        if didSet { c.curTypeParams = savedP  c.curTypeArgs = savedA }
        compileErrorAt(line: 0, msg: "LLVM backend: iterator next must return a registered Optional instance")
        return
    }
    val optEid: U64 = st.genEnumDefs[ge]
    val optTy: LLVMTypeRef = st.genEnumTys[ge]
    val ed: EnumDef = c.enums[optEid]
    val someB: Bind = kwSpan(c: inout c, kw: "Some", kwLen: 4U64)
    val someVi: U64 = variantIndex(c: inout c, enumStart: ed.nameStart, enumLen: ed.nameLen, variantStart: someB.nameStart, variantLen: someB.nameLen)
    val payloadTy: LLVMTypeRef = variantPayloadTy(c: inout c, st: inout st, eid: optEid, vi: someVi)
    // the bound element's declared type (the Some payload's single field).
    val itemFs: Array[FieldDef] = ed.variants[someVi].fields
    val mark: U64 = st.nLocals
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fit.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fit.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fit.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    // it.next() — self is `inout` (the iterator slot pointer); yields Optional[Item].
    mut val nArgs: Array[LLVMValueRef] = []
    nArgs.append(value: iterSlot)
    val opt: LLVMValueRef = LLVMBuildCall2(st.b, nextTy, nextVal, arrayCPtr(nArgs), 1U64, anon())
    val optSlot: LLVMValueRef = LLVMBuildAlloca(st.b, optTy, anon())
    LLVMBuildStore(st.b, opt, optSlot)
    val tag: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, LLVMBuildStructGEP2(st.b, optTy, optSlot, 0U64, anon()), anon())
    val isSome: LLVMValueRef = LLVMBuildICmp(st.b, llvmIntEq(), tag, LLVMConstInt(st.i64ty, someVi, 0I32), anon())
    LLVMBuildCondBr(st.b, isSome, bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    // bind x = the Some payload's field 0.
    val payload: LLVMValueRef = LLVMBuildLoad2(st.b, payloadTy, LLVMBuildStructGEP2(st.b, optTy, optSlot, 1U64, anon()), anon())
    val xVal: LLVMValueRef = LLVMBuildExtractValue(st.b, payload, 0U64, anon())
    val xTy: LLVMTypeRef = LLVMTypeOf(xVal)
    val xSlot: LLVMValueRef = LLVMBuildAlloca(st.b, xTy, anon())
    LLVMBuildStore(st.b, xVal, xSlot)
    mut val xStart: U64 = itemFs[0].tyStart
    mut val xLen: U64 = itemFs[0].tyLen
    // ground the element type through the active enum env so its kind is concrete
    // (a `map`-to-Bool element is i1 -> kind 2, zero-extended on print, not -1).
    if itemFs[0].ty != 0U64 {
        if c.curTypeParams.count > 0U64 {
            val gx: U64 = groundTypeRef(c: inout c, ref: itemFs[0].ty)
            xStart = c.types[gx].nameStart
            xLen = c.types[gx].nameLen
        }
    }
    pushLocalR(st: inout st, nameStart: varStart, nameLen: varLen, ptr: xSlot, ty: xTy, kind: kindFromTySpan(c: inout c, tyStart: xStart, tyLen: xLen), structIdx: localStructIdxFor(c: inout c, st: inout st, start: xStart, len: xLen), isArr: false, elemTy: st.i64ty, elemKind: 0U64, typeRef: 0U64)
    if didSet { c.curTypeParams = savedP  c.curTypeArgs = savedA }
    genLlvmBlock(c: inout c, st: inout st, id: body)
    st.nLocals = mark
    if st.terminated {
    } else {
        LLVMBuildBr(st.b, condBB)
    }
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

fn genLlvmForArray(c: inout Comp, st: inout LlvmCtx, varStart: U64, varLen: U64, iter: U64, body: U64) {
    if exprIsArray(c: inout c, st: inout st, id: iter) {
    } else {
        genLlvmForIterable(c: inout c, st: inout st, varStart: varStart, varLen: varLen, iter: iter, body: body)
        return
    }
    val mark: U64 = st.nLocals
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: iter)
    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iter)
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
    val idxslot: LLVMValueRef = LLVMBuildAlloca(st.b, st.i64ty, anon())
    LLVMBuildStore(st.b, LLVMConstInt(st.i64ty, 0U64, 0I32), idxslot)
    val vslot: LLVMValueRef = LLVMBuildAlloca(st.b, elemTy, anon())
    pushLocal(st: inout st, nameStart: varStart, nameLen: varLen, ptr: vslot, ty: elemTy, kind: 0U64, structIdx: c.structs.count, isArr: false, elemTy: st.i64ty, elemKind: 0U64)
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fora.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    val iv: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
    LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, llvmIntUlt(), iv, count, anon()), bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    LLVMBuildStore(st.b, LLVMBuildLoad2(st.b, elemTy, arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: iv), anon()), vslot)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    if st.terminated {
    } else {
        val iv2: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
        LLVMBuildStore(st.b, LLVMBuildAdd(st.b, iv2, LLVMConstInt(st.i64ty, 1U64, 0I32), anon()), idxslot)
        LLVMBuildBr(st.b, condBB)
    }
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// `for S { val x } in arr { body }`: walk an array of structs, binding each
// element's fields (per the struct pattern) directly each iteration, mirroring
// the match struct pattern. The element struct is stored in a slot so its fields
// can be GEP'd; field binds are popped at the end of every iteration.
fn genLlvmForArrayStruct(c: inout Comp, st: inout LlvmCtx, patStart: U64, patLen: U64, iter: U64, binds: Array[Bind], body: U64) {
    if exprIsArray(c: inout c, st: inout st, id: iter) {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: struct-destructure for-loop over a non-array not yet supported")
        return
    }
    val sidx: U64 = localStructIdxFor(c: inout c, st: inout st, start: patStart, len: patLen)
    if sidx < c.structs.count {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: struct-destructure for-loop needs a registered struct pattern")
        return
    }
    val mark: U64 = st.nLocals
    val elemTy: LLVMTypeRef = arrElemTyOf(c: inout c, st: inout st, id: iter)
    val arr: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: iter)
    val data: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 0U64, anon())
    val count: LLVMValueRef = LLVMBuildExtractValue(st.b, arr, 1U64, anon())
    val idxslot: LLVMValueRef = LLVMBuildAlloca(st.b, st.i64ty, anon())
    LLVMBuildStore(st.b, LLVMConstInt(st.i64ty, 0U64, 0I32), idxslot)
    val eslot: LLVMValueRef = LLVMBuildAlloca(st.b, elemTy, anon())
    val condBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.cond"))
    val bodyBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.body"))
    val endBB: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, st.curFn, cstr(s: "fors.end"))
    LLVMBuildBr(st.b, condBB)
    LLVMPositionBuilderAtEnd(st.b, condBB)
    val iv: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
    LLVMBuildCondBr(st.b, LLVMBuildICmp(st.b, llvmIntUlt(), iv, count, anon()), bodyBB, endBB)
    LLVMPositionBuilderAtEnd(st.b, bodyBB)
    st.terminated = false
    LLVMBuildStore(st.b, LLVMBuildLoad2(st.b, elemTy, arrElemPtr(st: inout st, elemTy: elemTy, data: data, idx: iv), anon()), eslot)
    val bmark: U64 = st.nLocals
    bindStructPattern(c: inout c, st: inout st, sidx: sidx, binds: binds, scrutTy: elemTy, scrutSlot: eslot)
    genLlvmBlock(c: inout c, st: inout st, id: body)
    st.nLocals = bmark
    if st.terminated {
    } else {
        val iv2: LLVMValueRef = LLVMBuildLoad2(st.b, st.i64ty, idxslot, anon())
        LLVMBuildStore(st.b, LLVMBuildAdd(st.b, iv2, LLVMConstInt(st.i64ty, 1U64, 0I32), anon()), idxslot)
        LLVMBuildBr(st.b, condBB)
    }
    LLVMPositionBuilderAtEnd(st.b, endBB)
    st.terminated = false
    st.nLocals = mark
}

// The `deinit` method index of struct `sidx`, or c.funcs.count if it has none.
fn structDeinitFi(c: inout Comp, sidx: U64) -> U64 {
    val sd: StructDef = c.structs[sidx]
    val b: Bind = kwSpan(c: inout c, kw: "deinit", kwLen: 6U64)
    val noArgs: Array[Arg] = []
    return findMethod(c: inout c, recvStart: sd.nameStart, recvLen: sd.nameLen, nameStart: b.nameStart, nameLen: b.nameLen, args: noArgs)
}

// Whether destroying a value of struct `sidx` runs any deinit — its own, or a
// (registered, non-array) field's, recursively (spec/03).
fn structNeedsDeinit(c: inout Comp, st: inout LlvmCtx, sidx: U64) -> Bool {
    if structDeinitFi(c: inout c, sidx: sidx) < c.funcs.count {
        return true
    }
    val sd: StructDef = c.structs[sidx]
    mut val i: U64 = 0
    while i < sd.fields.count {
        val fd: FieldDef = sd.fields[i]
        if fd.tyIsArray {
        } else {
            val fsi: U64 = structIndexByName(c: inout c, start: fd.tyStart, len: fd.tyLen)
            if fsi < c.structs.count {
                if c.structs[fsi].isExtern {
                } else {
                    if structNeedsDeinit(c: inout c, st: inout st, sidx: fsi) {
                        return true
                    }
                }
            }
        }
        i += 1
    }
    return false
}

// Destroy a struct VALUE `v` of struct `sidx` (spec/03): run its own `deinit` body
// first, then each field's deinit in declaration order, recursively.
fn emitDeinitValue(c: inout Comp, st: inout LlvmCtx, v: LLVMValueRef, sidx: U64) {
    val sd: StructDef = c.structs[sidx]
    val fi: U64 = structDeinitFi(c: inout c, sidx: sidx)
    if fi < c.funcs.count {
        val slot: U64 = userFnSlot(st: inout st, idx: fi)
        if slot < st.fnIdx.count {
            mut val av: Array[LLVMValueRef] = []
            av.append(value: v)
            LLVMBuildCall2(st.b, st.fnTy[slot], st.fnVal[slot], arrayCPtr(av), 1U64, anon())
        }
    }
    mut val i: U64 = 0
    while i < sd.fields.count {
        val fd: FieldDef = sd.fields[i]
        if fd.tyIsArray {
        } else {
            val fsi: U64 = structIndexByName(c: inout c, start: fd.tyStart, len: fd.tyLen)
            if fsi < c.structs.count {
                if c.structs[fsi].isExtern {
                } else {
                    if structNeedsDeinit(c: inout c, st: inout st, sidx: fsi) {
                        emitDeinitValue(c: inout c, st: inout st, v: LLVMBuildExtractValue(st.b, v, i, anon()), sidx: fsi)
                    }
                }
            }
        }
        i += 1
    }
}

// Run scope-exit destruction of local `li` (spec/03) if it is an owned, not-moved
// unique struct local whose type needs a deinit (own or a field's). The struct
// value is loaded and destroyed recursively.
fn emitDeinitCall(c: inout Comp, st: inout LlvmCtx, li: U64) {
    // skip a borrow/inout param (not owned here) or a value already moved out.
    if st.locOwned[li] {
    } else {
        return
    }
    if st.locMoved[li] {
        return
    }
    val sidx: U64 = st.locStructIdx[li]
    if sidx < c.structs.count {
    } else {
        return
    }
    if structNeedsDeinit(c: inout c, st: inout st, sidx: sidx) {
    } else {
        return
    }
    val selfVal: LLVMValueRef = LLVMBuildLoad2(st.b, st.locTy[li], st.locPtr[li], anon())
    emitDeinitValue(c: inout c, st: inout st, v: selfVal, sidx: sidx)
}

// Drop (deinit) the live locals in [fromMark, nLocals) in REVERSE declaration order
// — spec/03's deterministic scope-exit destruction. `excludeLi` (or a large
// sentinel) is skipped, so a unique value being moved out (e.g. returned) is not
// also dropped here. Only deinit-bearing locals emit a call.
fn dropScope(c: inout Comp, st: inout LlvmCtx, fromMark: U64, excludeLi: U64) {
    mut val i: U64 = st.nLocals
    while i > fromMark {
        i -= 1U64
        if i == excludeLi {
        } else {
            emitDeinitCall(c: inout c, st: inout st, li: i)
        }
    }
}

fn genLlvmBlock(c: inout Comp, st: inout LlvmCtx, id: U64) {
    // lexical scope: bindings declared in this block leave scope at its end.
    val mark: U64 = st.nLocals
    val blk: Block = c.blocks[id]
    mut val i: U64 = 0
    while i < blk.stmts.count {
        if st.terminated {
            st.nLocals = mark
            return
        }
        genLlvmStmt(c: inout c, st: inout st, id: blk.stmts[i])
        i += 1
    }
    // fall-through exit: run scope-exit deinits for this block's locals (a return
    // inside already dropped all live locals and set terminated).
    if st.terminated {
    } else {
        dropScope(c: inout c, st: inout st, fromMark: mark, excludeLi: 18446744073709551615U64)
    }
    st.nLocals = mark
}

// ---- the LLVM backend entry ----
//
// Build the module from the analyzed arena and print its IR. v1 emits the user's
// `main` only (other functions / types arrive in later increments).
fn emitLlvm(c: inout Comp) {
    val ctx: LLVMContextRef = LLVMContextCreate()
    val m: LLVMModuleRef = LLVMModuleCreateWithNameInContext(cstr(s: "plew"), ctx)
    val ptrty: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0U32)
    val i64ty: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
    // String = { i8* data, i64 len } (ABI-identical to the C runtime's PlewString).
    mut val strelems: Array[LLVMTypeRef] = []
    strelems.append(value: ptrty)
    strelems.append(value: i64ty)
    val strty: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(strelems), 2U32, 0I32)
    mut val arrelems: Array[LLVMTypeRef] = []
    arrelems.append(value: ptrty)
    arrelems.append(value: i64ty)
    val arrayTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(arrelems), 2U32, 0I32)
    mut val cloelems: Array[LLVMTypeRef] = []
    cloelems.append(value: ptrty)
    cloelems.append(value: ptrty)
    val closureTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(cloelems), 2U32, 0I32)
    mut val st: LlvmCtx = <LlvmCtx
        ctx=ctx mod=m b=LLVMCreateBuilderInContext(ctx)
        i1ty=LLVMInt1TypeInContext(ctx) i8ty=LLVMInt8TypeInContext(ctx) i16ty=LLVMInt16TypeInContext(ctx)
        i32ty=LLVMInt32TypeInContext(ctx) i64ty=i64ty
        voidty=LLVMVoidTypeInContext(ctx) ptrty=ptrty strty=strty arrayTy=arrayTy closureTy=closureTy
        curFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32) terminated=false
        curIsMain=false curRetVoid=true curRetTy=LLVMVoidTypeInContext(ctx) curRetTyStart=0 curRetTyLen=0 giveValue=LLVMConstInt(LLVMInt64TypeInContext(ctx), 0U64, 0I32) structIdxs=[] structTys=[] genStructRefs=[] genStructTys=[] genStructDefs=[] genEnumRefs=[] genEnumTys=[] genEnumDefs=[] enumIdxs=[] enumTys=[] selfStart=0 selfLen=0 curRecvInstRef=0 expectedTy=0 curRetRef=0 curBodyMark=0 nLocals=0
        fnIdx=[] fnVal=[] fnTy=[] genFnK=[] genFnVal=[] genFnTy=[] genMethK=[] genMethInst=[] genMethVal=[] genMethTy=[]
        locStart=[] locLen=[] locPtr=[] locTy=[] locKind=[] locStructIdx=[] locIsArr=[] locElemTy=[] locElemKind=[] locTypeRef=[] locElemStructIdx=[] locElemTypeRef=[] locOwned=[] locMoved=[] declId=[] declFn=[] declTy=[] reachAssoc=[] cloIdx=[] cloVal=[] cloTy=[] thunkIdx=[] thunkVal=[] thunkTy=[] provEmit=[] genMethEmit=[] />

    // a "self" byte span (appended past the source) to bind method receivers.
    st.selfStart = c.bytes.count
    c.appendSrc(from: "self".bytes)
    st.selfLen = 4U64

    // register user struct + enum types, then generic struct instances.
    registerStructs(c: inout c, st: inout st)
    registerEnums(c: inout c, st: inout st)
    registerGenStructs(c: inout c, st: inout st)
    registerGenEnums(c: inout c, st: inout st)

    // determine which assoc fns are actually reached (called) before declaring.
    collectReachableAssoc(c: inout c, st: inout st)

    // pass 1: declare all plain user functions + generic free-fn instances + generic
    // method instances (one per receiver instantiation).
    declareUserFns(c: inout c, st: inout st)
    declareGenFns(c: inout c, st: inout st)
    declareGenMethods(c: inout c, st: inout st)
    // declare lambda-lifted closures (after the named types + functions they may
    // reference exist), so a closure literal can build its {fn, env} value.
    collectClosures(c: inout c, st: inout st)
    // declare function-value thunks (a bare function reference -> {thunk, null}).
    collectThunks(c: inout c, st: inout st)

    // pass 2: emit `main` and every plain user function's body.
    mut val fi: U64 = 0
    mut val foundMain: Bool = false
    while fi < c.funcs.count {
        if nameIsMain(c: inout c, f: c.funcs[fi]) {
            genLlvmMain(c: inout c, st: inout st, fi: fi)
            foundMain = true
        } else {
            if isPlainUserFn(c: inout c, st: inout st, fi: fi) {
                genLlvmFunc(c: inout c, st: inout st, fi: fi)
            }
        }
        fi += 1
    }
    // generic free-function + generic-method instance bodies.
    emitGenFns(c: inout c, st: inout st)
    emitGenMethods(c: inout c, st: inout st)
    // lambda-lifted closure bodies + function-value thunks.
    emitClosures(c: inout c, st: inout st)
    emitThunks(c: inout c, st: inout st)
    // provided trait methods + lazily-declared std/generic methods reached during
    // the passes above. Both queues can grow as bodies emit (a provided body calls
    // a std generic method, a generic body reaches a provided one), so drain to a
    // fixpoint: loop until neither queue advances.
    mut val provDone: U64 = 0
    mut val genmDone: U64 = 0
    mut val draining: Bool = true
    while draining {
        while provDone < st.provEmit.count {
            genLlvmFuncBody(c: inout c, st: inout st, fi: st.provEmit[provDone], fv: st.fnVal[userFnSlot(st: inout st, idx: st.provEmit[provDone])])
            provDone += 1
        }
        while genmDone < st.genMethEmit.count {
            emitOneGenMethod(c: inout c, st: inout st, slot: st.genMethEmit[genmDone])
            genmDone += 1
        }
        if provDone >= st.provEmit.count {
            if genmDone >= st.genMethEmit.count {
                draining = false
            }
        }
    }
    if foundMain {
    } else {
        compileErrorAt(line: 0, msg: "LLVM backend: no `main` function found")
    }

    val ir: CPtr[U8] = LLVMPrintModuleToString(st.mod)
    write(s: stringFromCString(ir))
    LLVMDisposeMessage(ir)
}

// Emit the user `main` as C `i32 @main()` returning 0 (Plew main returns ()).
fn genLlvmMain(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    mut val noParams: Array[LLVMTypeRef] = []
    val mainTy: LLVMTypeRef = LLVMFunctionType(st.i32ty, arrayCPtr(noParams), 0U64, 0I32)
    val mainFn: LLVMValueRef = LLVMAddFunction(st.mod, cstr(s: "main"), mainTy)
    st.curFn = mainFn
    st.curIsMain = true
    st.curRetVoid = false
    val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, mainFn, cstr(s: "entry"))
    LLVMPositionBuilderAtEnd(st.b, entry)
    st.terminated = false
    // fresh local scope.
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    genLlvmBlock(c: inout c, st: inout st, id: c.funcs[fi].body)
    if st.terminated {
    } else {
        LLVMBuildRet(st.b, LLVMConstInt(st.i32ty, 0U64, 0I32))
    }
}

// ---- companion C runtime ----
//
// `plewc-llvm --runtime` emits the small C runtime the generated IR links
// against (the `plew_*` symbols the emitter declares). Scalar/pointer signatures
// only — no struct-by-value — so the IR can pass String as (i8* data, i64 len)
// without modeling the C struct ABI. Grows as the backend covers more.
fn emitLlvmRuntime() {
    write(s: "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n")
    write(s: "void plew_exit(long long code){ exit((int)code); }\n")
    write(s: "void plew_write_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); }\n")
    write(s: "void plew_eprint_raw(const char* d, long long n){ fwrite(d,1,(size_t)n,stderr); }\n")
    write(s: "__attribute__((noreturn)) void plew_panic_raw(const char* d, long long n){ fputs(\"panic: \",stderr); fwrite(d,1,(size_t)n,stderr); fputc('\\n',stderr); exit(1); }\n")
    // print(x) formatters (textual form + newline), matching the Plew Format impls.
    write(s: "void plew_print_str(const char* d, long long n){ fwrite(d,1,(size_t)n,stdout); fputc('\\n',stdout); }\n")
    write(s: "void plew_print_i64(long long v){ printf(\"%lld\\n\", v); }\n")
    write(s: "void plew_print_u64(unsigned long long v){ printf(\"%llu\\n\", v); }\n")
    write(s: "void plew_print_bool(long long v){ fputs(v?\"1\":\"0\",stdout); fputc('\\n',stdout); }\n")
    write(s: "long long plew_str_eq(const char* a, long long na, const char* b, long long nb){ if(na!=nb) return 0; for(long long i=0;i<na;i++) if(a[i]!=b[i]) return 0; return 1; }\n")
    // Array storage floor (a [cap][rc][data...] buffer; ARC/CoW not yet modeled —
    // copies share, no free; documented gap). alloc/cap/grow are element-size
    // generic; per-element load/store is inlined in IR via typed GEP.
    write(s: "void* plew_rawbuf_alloc(long long elemSize, long long cap){ long long* h=(long long*)malloc(2*sizeof(long long)+(size_t)(elemSize*cap)); h[0]=cap; h[1]=1; return (void*)(h+2); }\n")
    write(s: "long long plew_rawbuf_cap(void* p){ return p?((long long*)p)[-2]:0; }\n")
    write(s: "void* plew_arr_grow(void* data, long long elemSize, long long count){ long long cap=plew_rawbuf_cap(data); if(count<cap) return data; long long nc=cap<8?8:cap*2; void* nd=plew_rawbuf_alloc(elemSize,nc); if(count) memcpy(nd,data,(size_t)(elemSize*count)); return nd; }\n")
    write(s: "void* plew_arr_copy(void* data, long long elemSize, long long count){ void* nd=plew_rawbuf_alloc(elemSize,count<1?1:count); if(count) memcpy(nd,data,(size_t)(elemSize*count)); return nd; }\n")
    write(s: "void plew_bounds(long long i, long long n){ if(i<0||i>=n){ fputs(\"panic: index out of bounds\\n\",stderr); exit(1); } }\n")
}
