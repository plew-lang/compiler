                    // builds with the declared element type, not i64-defaulted.
                    if st.curRetTyLen > 0U64 {
                        match c.exprs[value] {
                            Expr.Array(val elems) => {
                                // an `Array[any P]` return literal: box each element.
                                mut val retElemRef: U64 = 0
                                mut val retElemTy: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: st.curRetTyStart, tyLen: st.curRetTyLen)
                                if st.curRetRef != 0U64 {
                                    if c.types[st.curRetRef].args.count > 0U64 {
