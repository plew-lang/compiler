// Part of the LLVM backend (root: _.pw): existential `any P` vtable, witness, boxing, and dynamic dispatch.

// ---- existential `any P` (spec/08): vtable, boxing, dynamic dispatch ----
//
// An `any P` value is the fat pointer st.anyTy = { ptr data, ptr vtable }. `data`
// points at an ARC-boxed copy of the erased concrete value (a rawbuf cell, so it is
// refcountable later); `vtable` at a static per-(concrete-struct, trait) global of
// function pointers: slot 0 reserved for a drop thunk (null in this increment —
// boxes leak at the same rigor as arrays/strings today), slots 1.. = a thunk per
// trait requirement in declaration order. Each thunk has the ERASED requirement
// signature `(ptr self_data, <req params>) -> <req ret>` and forwards to the
// concrete witness pf<wfi> after loading the boxed self.

// Do two parameter lists have identical labels positionally (a conformance witness
// reproduces the requirement's labels)?
fn paramLabelsEqual(c: inout Comp, a: Array[Param], b: Array[Param]) -> Bool {
    if a.count != b.count {
        return false
    }
    mut val i: U64 = 0
    while i < a.count {
        if a[i].nameId != b[i].nameId {
            return false
        }
        i += 1
    }
    return true
}

// The witness method on concrete struct `sidx` for trait requirement `req` (matched
// by name + param labels). c.arena.funcs.count if none.
fn findWitnessFor(c: inout Comp, sidx: U64, req: Func) -> U64 {
    val sd: StructDef = c.arena.structs[sidx]
    val recvId: U64 = intern(c: inout c, start: sd.nameStart, len: sd.nameLen)
    mut val i: U64 = 0
    while i < c.arena.funcs.count {
        val f: Func = c.arena.funcs[i]
        if f.hasRecv && f.extId == 0U64 && !f.isAssoc {
            if f.nameId == req.nameId && f.recvId == recvId {
                if paramLabelsEqual(c: inout c, a: f.params, b: req.params) {
                    return i
                }
            }
        }
        i += 1
    }
    return c.arena.funcs.count
}

// Does requirement `req` mention `Self` in a non-receiver INPUT position (a param)?
// Such a member is NOT callable through `any` (spec/08: two `any P` values need not
// share a concrete type, so a `Self` argument cannot be supplied).
fn reqUsesSelfInInput(c: inout Comp, req: Func) -> Bool {
    mut val i: U64 = 0
    while i < req.params.count {
        if rangeEquals(bytes: c.arena.bytes, start: req.params[i].tyStart, len: req.params[i].tyLen, kw: "Self") {
            return true
        }
        i += 1
    }
    return false
}

// Does requirement `req` return bare `Self`? Such a member IS callable through `any`
// (spec/08): the output `Self` is re-erased to `any P` — the thunk re-boxes the
// witness's concrete result into the existential. (A `Self` nested in a generic
// return like `Optional[Self]` is not handled yet.)
fn reqReturnsSelf(c: inout Comp, req: Func) -> Bool {
    if req.hasRet {
        return rangeEquals(bytes: c.arena.bytes, start: req.retStart, len: req.retLen, kw: "Self")
    }
    return false
}

// Build the thunk for requirement `idx` (`req`) on concrete struct `sidx`. Returns
// its function pointer, or a null ptr when the requirement can't be dispatched
// through `any` in this increment (assoc, inout/move self, or Self outside the
// receiver). Saves/restores the builder position around the thunk body.
fn buildAnyThunk(c: inout Comp, st: inout LlvmCtx, sidx: U64, anyRef: U64, traitIdx: U64, req: Func, idx: U64) -> LLVMValueRef {
    // a trait requirement Func carries no `self` param (hasRecv=false; self is
    // implicit) — a method requirement is `!isAssoc`. An assoc-fn requirement has no
    // receiver to carry the witness, so it is not dispatchable through `any`.
    if req.isAssoc {
        return LLVMConstNull(st.ptrty)
    }
    if reqUsesSelfInInput(c: inout c, req: req) {
        return LLVMConstNull(st.ptrty)
    }
    // a `-> Self` requirement: the thunk re-erases the witness's concrete result back
    // into the existential (the slot's signature returns the fat pointer).
    val retsSelf: Bool = reqReturnsSelf(c: inout c, req: req)
    val wfi: U64 = findWitnessFor(c: inout c, sidx: sidx, req: req)
    if wfi >= c.arena.funcs.count {
        return LLVMConstNull(st.ptrty)
    }
    val wslot: U64 = userFnSlot(st: inout st, idx: wfi)
    if wslot >= st.fnIdx.count {
        return LLVMConstNull(st.ptrty)
    }
    val sd: StructDef = c.arena.structs[sidx]
    val regSlot: U64 = structRegSlot(c: inout c, st: inout st, start: sd.nameStart, len: sd.nameLen)
    if regSlot >= st.structIdxs.count {
        return LLVMConstNull(st.ptrty)
    }
    val concreteTy: LLVMTypeRef = st.structTys[regSlot]
    // the erased thunk signature uses the requirement's types with the trait's type
    // parameters / associated types substituted by the existential's bindings
    // (`Rhs`/`Output`/`Item` -> the bound concrete), set as the active env so
    // paramLlvmTy / llvmFnRetTy ground them.
    mut val envParams: Array[Bind] = []
    mut val envArgs: Array[U64] = []
    val haveEnv: Bool = anyBindingEnv(c: inout c, anyRef: anyRef, traitIdx: traitIdx, outParams: inout envParams, outArgs: inout envArgs)
    val savedEP: Array[Bind] = c.cur.typeParams
    val savedEA: Array[U64] = c.cur.typeArgs
    if haveEnv {
        c.cur.typeParams = envParams
        c.cur.typeArgs = envArgs
    }
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    mut val pi: U64 = 0
    while pi < req.params.count {
        ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: req.params[pi]))
        pi += 1
    }
    mut val rty: LLVMTypeRef = llvmFnRetTy(c: inout c, st: inout st, f: req)
    if haveEnv {
        c.cur.typeParams = savedEP
        c.cur.typeArgs = savedEA
    }
    // a `-> Self` thunk returns the existential fat pointer (the re-erased result).
    if retsSelf {
        rty = st.anyTy
    }
    val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count, 0I32)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "pfvt".bytes)
    appendU64Dec(into: inout nm, n: sidx)
    appendBytes(into: inout nm, from: "_".bytes)
    appendU64Dec(into: inout nm, n: idx)
    appendBytes(into: inout nm, from: "_".bytes)
    appendU64Dec(into: inout nm, n: anyBindKey(c: inout c, args: envArgs))
    nm.append(value: 0)
    val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
    val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, fv, cstr(s: "entry"))
    LLVMPositionBuilderAtEnd(st.b, entry)
    // self: an `inout fn` witness takes self by pointer (mutates the boxed value in
    // place — the box is shared via the fat pointer's data field, so the mutation
    // persists); a by-value self is loaded from the box.
    mut val selfArg: LLVMValueRef = LLVMGetParam(fv, 0U64)
    if !(req.selfInout) {
        selfArg = LLVMBuildLoad2(st.b, concreteTy, LLVMGetParam(fv, 0U64), anon())
    }
    mut val av: Array[LLVMValueRef] = []
    av.append(value: selfArg)
    mut val ai: U64 = 0
    while ai < req.params.count {
        av.append(value: LLVMGetParam(fv, ai + 1U64))
        ai += 1
    }
    val r: LLVMValueRef = LLVMBuildCall2(st.b, st.fnTy[wslot], st.fnVal[wslot], arrayCPtr(av), av.count, anon())
    if req.hasRet {
        if retsSelf {
            // re-erase: box the witness's concrete result (the same concrete type as
            // the boxed self) back into `any P` with this existential's vtable.
            LLVMBuildRet(st.b, boxIntoAny(c: inout c, st: inout st, v: r, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx))
        } else {
            LLVMBuildRet(st.b, r)
        }
    } else {
        LLVMBuildRetVoid(st.b)
    }
    LLVMPositionBuilderAtEnd(st.b, savedBB)
    return fv
}

// Build the copy thunk for concrete struct `sidx` (vtable slot 0): `copy(ptr src)
// -> ptr` allocates a fresh box, deep-copies the boxed concrete value into it (value
// semantics — array/String fields are copied so the two existentials are
// independent), and returns the new box pointer. Used to give `any P` value
// semantics on copy (a `mut val b = a` must not alias a's boxed value).
fn buildAnyCopyThunk(c: inout Comp, st: inout LlvmCtx, sidx: U64) -> LLVMValueRef {
    val sd: StructDef = c.arena.structs[sidx]
    val regSlot: U64 = structRegSlot(c: inout c, st: inout st, start: sd.nameStart, len: sd.nameLen)
    if regSlot >= st.structIdxs.count {
        return LLVMConstNull(st.ptrty)
    }
    val concreteTy: LLVMTypeRef = st.structTys[regSlot]
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(ptys), 1U64, 0I32)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "pfvtcopy".bytes)
    appendU64Dec(into: inout nm, n: sidx)
    nm.append(value: 0)
    val fv: LLVMValueRef = LLVMAddFunction(st.mod, arrayCPtr(nm), fty)
    val savedBB: LLVMBasicBlockRef = LLVMGetInsertBlock(st.b)
    val entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(st.ctx, fv, cstr(s: "entry"))
    LLVMPositionBuilderAtEnd(st.b, entry)
    val srcVal: LLVMValueRef = LLVMBuildLoad2(st.b, concreteTy, LLVMGetParam(fv, 0U64), anon())
    val copied: LLVMValueRef = deepCopyStructValue(c: inout c, st: inout st, v: srcVal, sidx: sidx)
    val cell: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
    LLVMBuildStore(st.b, copied, cell)
    LLVMBuildRet(st.b, cell)
    LLVMPositionBuilderAtEnd(st.b, savedBB)
    return fv
}

// Value-semantics copy of an `any P` fat-pointer value: invoke its vtable's copy
// thunk (slot 0) to duplicate the boxed concrete, returning a fresh `{ newdata,
// vtable }`. So `mut val b = a` (and other place->owner copies) yields an
// independent existential whose later mutation doesn't affect the source.
fn copyAnyValue(c: inout Comp, st: inout LlvmCtx, fat: LLVMValueRef) -> LLVMValueRef {
    val dataPtr: LLVMValueRef = LLVMBuildExtractValue(st.b, fat, 0U64, anon())
    val vtPtr: LLVMValueRef = LLVMBuildExtractValue(st.b, fat, 1U64, anon())
    val copyFn: LLVMValueRef = LLVMBuildLoad2(st.b, st.ptrty, vtPtr, anon())
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    val fty: LLVMTypeRef = LLVMFunctionType(st.ptrty, arrayCPtr(ptys), 1U64, 0I32)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: dataPtr)
    val newData: LLVMValueRef = LLVMBuildCall2(st.b, fty, copyFn, arrayCPtr(av), 1U64, anon())
    mut val agg: LLVMValueRef = LLVMGetUndef(st.anyTy)
    agg = LLVMBuildInsertValue(st.b, agg, newData, 0U64, anon())
    agg = LLVMBuildInsertValue(st.b, agg, vtPtr, 1U64, anon())
    return agg
}

// Whether `id` is an `any P` PLACE (an Ident or Field) whose copy into a new owner
// must duplicate the boxed value (value semantics).
fn anyExprIsPlace(c: inout Comp, id: U64) -> Bool {
    match c.arena.exprs[id] {
        Expr.Ident(start: _, len: _) => { return true }
        Expr.Field(base: _, nameStart: _, nameLen: _) => { return true }
        _ => { return false }
    }
}

// If `valueExpr` is an existing `any P` place being copied into a new owner, return
// a value-semantics copy of its already-emitted value `rv`; else `rv` unchanged.
fn copyAnyIfPlace(c: inout Comp, st: inout LlvmCtx, rv: LLVMValueRef, valueExpr: U64) -> LLVMValueRef {
    if refIsAny(c: inout c, ref: exprTypeRef(c: inout c, st: inout st, id: valueExpr)) {
        if anyExprIsPlace(c: inout c, id: valueExpr) {
            return copyAnyValue(c: inout c, st: inout st, fat: rv)
        }
    }
    return rv
}

// Build (or fetch cached) the vtable global for (concrete struct `sidx`, trait
// `traitIdx`): an array of ptr slots — slot 0 = copy thunk (value semantics), slot
// 1.. = a thunk per requirement in declaration order. Returns the global pointer.
fn ensureAnyVtable(c: inout Comp, st: inout LlvmCtx, sidx: U64, anyRef: U64, traitIdx: U64) -> LLVMValueRef {
    // distinct existential bindings (`any Add[I32,…]` vs `any Add[I64,…]`) need
    // distinct vtables; the key folds the bound concretes (0 for the no-binding case).
    mut val envP: Array[Bind] = []
    mut val envA: Array[U64] = []
    anyBindingEnv(c: inout c, anyRef: anyRef, traitIdx: traitIdx, outParams: inout envP, outArgs: inout envA)
    val bindKey: U64 = anyBindKey(c: inout c, args: envA)
    mut val ci: U64 = 0
    while ci < st.anyVtType.count {
        if st.anyVtType[ci] == sidx && st.anyVtTrait[ci] == traitIdx && st.anyVtBindKey[ci] == bindKey {
            return st.anyVtVal[ci]
        }
        ci += 1
    }
    val t: TraitDef = c.decls.traits[traitIdx]
    // pre-create the global (with its final array type) and CACHE it before building
    // thunks, so a `-> Self` re-erasure thunk that re-boxes into this same existential
    // resolves to this vtable instead of recursing into ensureAnyVtable forever.
    val slotCount: U64 = 1U64 + t.reqs.count
    val arrTy: LLVMTypeRef = LLVMArrayType2(st.ptrty, slotCount)
    mut val nm: Array[U8] = []
    appendBytes(into: inout nm, from: "pfvtbl".bytes)
    appendU64Dec(into: inout nm, n: sidx)
    appendBytes(into: inout nm, from: "_".bytes)
    appendU64Dec(into: inout nm, n: traitIdx)
    appendBytes(into: inout nm, from: "_".bytes)
    appendU64Dec(into: inout nm, n: bindKey)
    nm.append(value: 0)
    val g: LLVMValueRef = LLVMAddGlobal(st.mod, arrTy, arrayCPtr(nm))
    LLVMSetGlobalConstant(g, 1I32)
    st.anyVtType.append(value: sidx)
    st.anyVtTrait.append(value: traitIdx)
    st.anyVtBindKey.append(value: bindKey)
    st.anyVtVal.append(value: g)
    mut val slots: Array[LLVMValueRef] = []
    slots.append(value: buildAnyCopyThunk(c: inout c, st: inout st, sidx: sidx))
    mut val ri: U64 = 0
    while ri < t.reqs.count {
        slots.append(value: buildAnyThunk(c: inout c, st: inout st, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx, req: t.reqs[ri], idx: ri))
        ri += 1
    }
    LLVMSetInitializer(g, LLVMConstArray2(st.ptrty, arrayCPtr(slots), slots.count))
    return g
}

// The slot index (into the vtable) of trait `traitIdx`'s requirement matching method
// (nameStart,nameLen) with the call's argument labels, or 0 (the reserved drop slot
// = "not found"). Slot = 1 + requirement-declaration-index.
fn anyMethodSlot(c: inout Comp, traitIdx: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
    val qNameId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    val t: TraitDef = c.decls.traits[traitIdx]
    mut val ri: U64 = 0
    while ri < t.reqs.count {
        if t.reqs[ri].nameId == qNameId {
            if paramsLabelsOk(c: inout c, params: t.reqs[ri].params, args: args) {
                return ri + 1U64
            }
        }
        ri += 1
    }
    return 0U64
}

// Box concrete value `v` of struct `sidx` into a fresh ARC cell and wrap it with the
// (sidx, traitIdx) vtable, producing an `any P` fat-pointer value.
fn boxIntoAny(c: inout Comp, st: inout LlvmCtx, v: LLVMValueRef, sidx: U64, anyRef: U64, traitIdx: U64) -> LLVMValueRef {
    val sd: StructDef = c.arena.structs[sidx]
    val regSlot: U64 = structRegSlot(c: inout c, st: inout st, start: sd.nameStart, len: sd.nameLen)
    val concreteTy: LLVMTypeRef = st.structTys[regSlot]
    val cell: LLVMValueRef = rawbufAlloc(c: inout c, st: inout st, elemSize: LLVMSizeOf(concreteTy), cap: LLVMConstInt(st.i64ty, 1U64, 0I32))
    LLVMBuildStore(st.b, v, cell)
    val vt: LLVMValueRef = ensureAnyVtable(c: inout c, st: inout st, sidx: sidx, anyRef: anyRef, traitIdx: traitIdx)
    mut val agg: LLVMValueRef = LLVMGetUndef(st.anyTy)
    agg = LLVMBuildInsertValue(st.b, agg, cell, 0U64, anon())
    agg = LLVMBuildInsertValue(st.b, agg, vt, 1U64, anon())
    return agg
}

// If target TypeRef `targetRef` is an existential `any P` and `valueExpr` is a
// concrete struct conforming to P, emit `valueExpr`, box it, and return the `any P`
// fat pointer. Returns a null sentinel (LLVMConstNull check via outBoxed) when no
// coercion applies. `outBoxed` is set true iff a coercion happened.
fn coerceToAnyIfNeeded(c: inout Comp, st: inout LlvmCtx, targetRef: U64, valueExpr: U64, outBoxed: inout Bool) -> LLVMValueRef {
    outBoxed = false
    if !(refIsAny(c: inout c, ref: targetRef)) {
        return LLVMConstNull(st.ptrty)
    }
    // already an `any` value (e.g. passing an `any P` local to an `any P` param):
    // no re-boxing.
    val srcRef: U64 = exprTypeRef(c: inout c, st: inout st, id: valueExpr)
    if refIsAny(c: inout c, ref: srcRef) {
        return LLVMConstNull(st.ptrty)
    }
    val sidx: U64 = exprStructIdx(c: inout c, st: inout st, id: valueExpr)
    if sidx >= c.arena.structs.count {
        return LLVMConstNull(st.ptrty)
    }
    val tr: TypeRef = c.arena.types[targetRef]
    val traitIdx: U64 = findTraitIdxByName(c: inout c, start: tr.nameStart, len: tr.nameLen)
    if traitIdx >= c.decls.traits.count {
        return LLVMConstNull(st.ptrty)
    }
    // value semantics: boxing a concrete PLACE (`val a: any P = h`) deep-copies its
    // array/struct fields into the box, matching a plain struct copy — so a later
    // mutation of the source leaves the existential's boxed value unchanged.
    val v: LLVMValueRef = copyValueIfPlace(c: inout c, st: inout st, rv: genLlvmExpr(c: inout c, st: inout st, id: valueExpr), valueExpr: valueExpr)
    outBoxed = true
    return boxIntoAny(c: inout c, st: inout st, v: v, sidx: sidx, anyRef: targetRef, traitIdx: traitIdx)
}

// Dynamic dispatch of `recv.name(args)` where `recv` is an existential `any P`
// (anyRef names the trait). Loads the data + vtable from the fat pointer, indexes
// the requirement's vtable slot, and calls the thunk with (data, args). Self-input
// requirements have no vtable slot (anyMethodSlot returns 0) and are rejected.
fn genLlvmAnyDispatch(c: inout Comp, st: inout LlvmCtx, recv: U64, anyRef: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> LLVMValueRef {
    val tr: TypeRef = c.arena.types[anyRef]
    val traitIdx: U64 = findTraitIdxByName(c: inout c, start: tr.nameStart, len: tr.nameLen)
    if traitIdx >= c.decls.traits.count {
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "LLVM backend: `any` over an unknown trait")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val slot: U64 = anyMethodSlot(c: inout c, traitIdx: traitIdx, nameStart: nameStart, nameLen: nameLen, args: args)
    if slot == 0U64 {
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "this member is not callable through `any P`: it takes `Self` in a non-receiver position, is an associated function, or is not a requirement of the trait (spec/08)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val req: Func = c.decls.traits[traitIdx].reqs[slot - 1U64]
    // spec/08: a member with `Self` in a non-receiver INPUT position is not callable
    // through `any` (the erased concretes need not match, so a `Self` argument cannot
    // be supplied). A `-> Self` return IS callable — it is re-erased to `any P`.
    if reqUsesSelfInInput(c: inout c, req: req) {
        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "this member is not callable through `any P`: `Self` appears in a non-receiver input — two `any P` values need not share a concrete type (spec/08)")
        return LLVMConstInt(st.i64ty, 0U64, 0I32)
    }
    val retsSelf: Bool = reqReturnsSelf(c: inout c, req: req)
    val fat: LLVMValueRef = genLlvmExpr(c: inout c, st: inout st, id: recv)
    val dataPtr: LLVMValueRef = LLVMBuildExtractValue(st.b, fat, 0U64, anon())
    val vtPtr: LLVMValueRef = LLVMBuildExtractValue(st.b, fat, 1U64, anon())
    // &vtable[slot] via flat ptr-element GEP (element type ptr), then load the fn ptr.
    mut val gepIdx: Array[LLVMValueRef] = []
    gepIdx.append(value: LLVMConstInt(st.i64ty, slot, 0I32))
    val slotPtr: LLVMValueRef = LLVMBuildGEP2(st.b, st.ptrty, vtPtr, arrayCPtr(gepIdx), 1U64, anon())
    val fnPtr: LLVMValueRef = LLVMBuildLoad2(st.b, st.ptrty, slotPtr, anon())
    // reconstruct the erased thunk signature: (ptr self, <req params>) -> <req ret>,
    // grounding the requirement's `Rhs`/`Item`/`Output` under the existential's
    // bindings (matching the thunk built in buildAnyThunk).
    mut val envParams: Array[Bind] = []
    mut val envArgs: Array[U64] = []
    val haveEnv: Bool = anyBindingEnv(c: inout c, anyRef: anyRef, traitIdx: traitIdx, outParams: inout envParams, outArgs: inout envArgs)
    val savedEP: Array[Bind] = c.cur.typeParams
    val savedEA: Array[U64] = c.cur.typeArgs
    if haveEnv {
        c.cur.typeParams = envParams
        c.cur.typeArgs = envArgs
    }
    mut val ptys: Array[LLVMTypeRef] = []
    ptys.append(value: st.ptrty)
    mut val pi: U64 = 0
    while pi < req.params.count {
        ptys.append(value: paramLlvmTy(c: inout c, st: inout st, p: req.params[pi]))
        pi += 1
    }
    mut val rty: LLVMTypeRef = llvmFnRetTy(c: inout c, st: inout st, f: req)
    if haveEnv {
        c.cur.typeParams = savedEP
        c.cur.typeArgs = savedEA
    }
    // a `-> Self` requirement's thunk returns the re-erased existential fat pointer.
    if retsSelf {
        rty = st.anyTy
    }
    val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count, 0I32)
    mut val av: Array[LLVMValueRef] = []
    av.append(value: dataPtr)
    mut val ai: U64 = 0
    while ai < args.count {
        av.append(value: genArgValue(c: inout c, st: inout st, argExpr: args[ai].expr, p: req.params[ai]))
        ai += 1
    }
    return LLVMBuildCall2(st.b, fty, fnPtr, arrayCPtr(av), av.count, anon())
}

fn genLlvmFunc(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    val slot: U64 = userFnSlot(st: inout st, idx: fi)
    genLlvmFuncBody(c: inout c, st: inout st, fi: fi, fv: st.fnVal[slot])
}

// Emit function `fi`'s body into the LLVM function value `fv` (under the active
// substitution env, if any — used for both plain functions and generic instances).
fn genLlvmFuncBody(c: inout Comp, st: inout LlvmCtx, fi: U64, fv: LLVMValueRef) {
    val f: Func = c.arena.funcs[fi]
    st.curFn = fv
    st.curIsMain = false
    st.curRetVoid = !f.hasRet
    // a plain method's `Self` resolves to the receiver type, so `-> Self` / a `Self`
    // param / `return self` ground (the generic-method path sets this via its
    // instantiation elsewhere; here it covers a non-generic method on a plain type).
    val didSelf: Bool = f.hasRecv && st.curRecvInstRef == 0U64 && c.cur.selfRef == 0U64
    if didSelf {
        setSelfItemEnv(c: inout c, recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
    }
    st.curRetTy = llvmFnRetTy(c: inout c, st: inout st, f: f)
    st.curRetTyStart = f.retStart
    st.curRetTyLen = f.retLen
    // ground the return ref under any active generic env (a monomorphized method
    // body: `Optional[T]` -> `Optional[I64]`) so return-context enum construction
    // can infer the concrete instance.
    st.curRetRef = groundTypeRef(c: inout c, ref: f.retTy)
    beginFnBody(st: inout st, fv: fv)
    // fresh local scope; bind each param into an alloca (so it reads/writes
    // uniformly with locals).
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    // module-level variables (spec/15) are visible everywhere: seed them as locals
    // (before self/params, so a same-named local shadows the global).
    seedGlobals(c: inout c, st: inout st)
    // method receiver: bind `self` as a local pointing at the struct storage —
    // an `inout fn`'s self IS the pointer param; a by-value self is stored into a
    // fresh alloca (so mutations stay local). Field access then GEPs locPtr
    // uniformly. Params follow self at index 1.
    mut val base: U64 = 0
    if f.hasRecv {
        // a generic method's receiver is its instantiation (curRecvInstRef): its
        // LLVM type / struct-index / env come from the instance, not the bare head
        // name (which `llvmScalarTy` can't resolve to a registered generic type).
        mut val recvTy: LLVMTypeRef = llvmScalarTy(c: inout c, st: inout st, tyStart: f.recvStart, tyLen: f.recvLen)
        mut val recvSidx: U64 = localStructIdxFor(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen)
        mut val recvRef: U64 = 0
        if st.curRecvInstRef != 0U64 {
            recvRef = st.curRecvInstRef
            recvTy = llvmTypeOfRef(c: inout c, st: inout st, ref: st.curRecvInstRef)
            val gs: U64 = genStructSlot(c: inout c, st: inout st, ref: st.curRecvInstRef)
            if gs < st.genStructRefs.count {
                recvSidx = st.genStructDefs[gs]
            } else {
                // a method-own-type-param pseudo instance (`Pair[Bag]` where Pair is
                // NOT generic): keep the receiver-name's struct so `self.a` resolves.
                recvSidx = localStructIdxFor(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen)
            }
        }
        // an `Array[T]` receiver (a user method `impl[T] Array[T]`): self is the
        // {ptr,i64} array value, bound as an array so `self.get`/`self.count` resolve.
        mut val selfIsArr: Bool = false
        mut val selfElemTy: LLVMTypeRef = st.i64ty
        if st.curRecvInstRef != 0U64 {
            if rangeEquals(bytes: c.arena.bytes, start: c.arena.types[st.curRecvInstRef].nameStart, len: c.arena.types[st.curRecvInstRef].nameLen, kw: "Array") {
                recvTy = st.arrayTy
                selfIsArr = true
                if c.arena.types[st.curRecvInstRef].args.count > 0U64 {
                    selfElemTy = llvmTypeOfRef(c: inout c, st: inout st, ref: c.arena.types[st.curRecvInstRef].args[0])
                }
            }
        }
        // an enum receiver (`impl Color { fn code() … }`): track its TypeRef so a
        // bare `match self` / `self == …` in the body recovers the enum.
        if recvRef == 0U64 {
            if recvSidx >= c.arena.structs.count {
                if enumRegSlot(c: inout c, st: inout st, start: f.recvStart, len: f.recvLen) < st.enumIdxs.count {
                    recvRef = simpleTypeRef(c: inout c, nameStart: f.recvStart, nameLen: f.recvLen)
                }
            }
        }
        mut val selfPtr: LLVMValueRef = LLVMGetParam(fv, 0U64)
        if !(f.selfInout) {
            selfPtr = entryAlloca(st: inout st, ty: recvTy)
            LLVMBuildStore(st.b, LLVMGetParam(fv, 0U64), selfPtr)
        }
        // an extension method's self is viewed as `Recv#Ext` (spec/09): a bare
        // `self.m()` in the body resolves through the same extension (so it is
        // recursion, not a call to a shadowed bare method); reach the shadowed
        // method with `self#!Ext.m()`.
        if f.extId != 0U64 {
            if recvRef == 0U64 {
                mut val selfViewArgs: Array[U64] = []
                recvRef = c.pushType(t: <TypeRef nameStart=f.recvStart nameLen=f.recvLen args=selfViewArgs viewExtId=f.extId />)
            }
        }
        // a view-rooted conferred witness (spec/09 chain conflict, `s#C.a()`): self is
        // viewed as `Recv#root`, so an internal `self.m()` to a multi-path intermediate
        // resolves through the SAME root C (findExtMethodById via the view chain).
        if f.selfViewId != 0U64 {
            if recvRef == 0U64 {
                mut val selfRootArgs: Array[U64] = []
                recvRef = c.pushType(t: <TypeRef nameStart=f.recvStart nameLen=f.recvLen args=selfRootArgs viewExtId=f.selfViewId />)
            }
        }
        pushLocalR(st: inout st, nameStart: st.selfStart, nameLen: st.selfLen, ptr: selfPtr, ty: recvTy, kind: kindFromTySpan(c: inout c, tyStart: f.recvStart, tyLen: f.recvLen), structIdx: recvSidx, isArr: selfIsArr, elemTy: selfElemTy, elemKind: 0U64, typeRef: recvRef)
        // a `move fn` self is owned (deinit'd in the callee); `fn`/`inout fn`/
        // `borrow fn` self is a borrow the caller owns.
        setLocalOwned(st: inout st, owned: f.selfMove)
        base = 1U64
    }
    mut val pi: U64 = 0
    while pi < f.params.count {
        bindOneParam(c: inout c, st: inout st, p: f.params[pi], fv: fv, argIdx: pi + base)
        // a `move` param is owned (deinit'd here); inout/borrow/by-value are not.
        setLocalOwned(st: inout st, owned: f.params[pi].isMove)
        pi += 1
    }
    st.curBodyMark = st.nLocals
    genLlvmBlock(c: inout c, st: inout st, id: f.body)
    if !(st.terminated) {
        // fall-through: the body block dropped its body locals; now drop owned
        // params (a `move` param / `move fn` self the callee deinits).
        dropScope(c: inout c, st: inout st, fromMark: 0U64, excludeLi: 18446744073709551615U64)
        // checkReturns guarantees a non-() function diverges on every path, so a
        // fall-through here is a () function: return void.
        if st.curRetVoid {
            LLVMBuildRetVoid(st.b)
        } else {
            LLVMBuildUnreachable(st.b)
        }
    }
    if didSelf {
        clearSelfItemEnv(c: inout c)
    }
}

