// Part of the LLVM backend (root: _.pw): the LLVM backend entry (emitLlvm), global init, and main.

// ---- the LLVM backend entry ----
//
// Build the module from the analyzed arena and print its IR. v1 emits the user's
// `main` only (other functions / types arrive in later increments).
export fn emitLlvm(c: inout Comp) {
    val ctx: LLVMContextRef = LLVMContextCreate()
    val m: LLVMModuleRef = LLVMModuleCreateWithNameInContext(cstr(s: "plew"), ctx)
    val ptrty: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0U32)
    val i64ty: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
    // String = { i8* data, i64 len } (ABI-identical to the C runtime's PlewString).
    mut val strelems: Array[LLVMTypeRef] = []
    strelems.append(value: ptrty)
    strelems.append(value: i64ty)
    val strty: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(strelems), 2U64, 0I32)
    mut val arrelems: Array[LLVMTypeRef] = []
    arrelems.append(value: ptrty)
    arrelems.append(value: i64ty)
    val arrayTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(arrelems), 2U64, 0I32)
    mut val cloelems: Array[LLVMTypeRef] = []
    cloelems.append(value: ptrty)
    cloelems.append(value: ptrty)
    val closureTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(cloelems), 2U64, 0I32)
    // any P = { ptr data, ptr vtable } (fat pointer for existentials).
    mut val anyelems: Array[LLVMTypeRef] = []
    anyelems.append(value: ptrty)
    anyelems.append(value: ptrty)
    val anyTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(anyelems), 2U64, 0I32)
    // PlewPromise = { i32 done, i64 value, ptr k, ptr kframe } (ABI-identical to
    // the C runtime). Awaited values are type-erased through `value` (i64).
    mut val promelems: Array[LLVMTypeRef] = []
    promelems.append(value: LLVMInt32TypeInContext(ctx))
    promelems.append(value: i64ty)
    promelems.append(value: ptrty)
    promelems.append(value: ptrty)
    val promiseTy: LLVMTypeRef = LLVMStructTypeInContext(ctx, arrayCPtr(promelems), 4U64, 0I32)
    mut val st: LlvmCtx = <LlvmCtx
        ctx=ctx mod=m b=LLVMCreateBuilderInContext(ctx)
        i1ty=LLVMInt1TypeInContext(ctx) i8ty=LLVMInt8TypeInContext(ctx) i16ty=LLVMInt16TypeInContext(ctx)
        i32ty=LLVMInt32TypeInContext(ctx) i64ty=i64ty f64ty=LLVMDoubleTypeInContext(ctx)
        voidty=LLVMVoidTypeInContext(ctx) ptrty=ptrty strty=strty arrayTy=arrayTy closureTy=closureTy anyTy=anyTy anyVtType=[] anyVtTrait=[] anyVtBindKey=[] anyVtVal=[]
        curFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32) terminated=false
        curIsMain=false curRetVoid=true curRetTy=LLVMVoidTypeInContext(ctx) curRetTyStart=0 curRetTyLen=0 giveValue=LLVMConstInt(LLVMInt64TypeInContext(ctx), 0U64, 0I32) structIdxs=[] structTys=[] genStructRefs=[] genStructTys=[] genStructDefs=[] genEnumRefs=[] genEnumTys=[] genEnumDefs=[] enumIdxs=[] enumTys=[] selfStart=0 selfLen=0 curRecvInstRef=0 expectedTy=0 curRetRef=0 curBodyMark=0 nLocals=0
        fnIdx=[] fnVal=[] fnTy=[] genFnK=[] genFnVal=[] genFnTy=[] genMethK=[] genMethInst=[] genMethVal=[] genMethTy=[] genMethOwn=[]
        locStart=[] locLen=[] locPtr=[] locTy=[] locKind=[] locStructIdx=[] locIsArr=[] locElemTy=[] locElemKind=[] locTypeRef=[] locElemStructIdx=[] locElemTypeRef=[] locOwned=[] locMoved=[] declId=[] declFn=[] declTy=[] reachAssoc=[] cloIdx=[] cloVal=[] cloTy=[] thunkIdx=[] thunkVal=[] thunkTy=[] provEmit=[] genMethEmit=[]
        promiseTy=promiseTy curAsync=false
        curFrameBase=LLVMConstNull(ptrty) curFrameTy=i64ty
        curResumeFn=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncSwitch=LLVMConstInt(LLVMInt32TypeInContext(ctx), 0U64, 0I32)
        curAsyncState=0 asyncFieldNext=0 asyncFnIdx=[] asyncFrameTy=[] asyncResumeFn=[] asyncSlotPtrs=[] loopBreakBB=[] loopContBB=[] loopDepth=0 />

    // a "self" byte span (appended past the source) to bind method receivers.
    st.selfStart = c.arena.bytes.count
    c.appendSrc(from: "self".bytes)
    st.selfLen = 4U64

    // register user struct + enum types, then generic struct/enum instances. ALL
    // NAMES first (plain structs, plain enums, generic-struct instances, generic-enum
    // instances), THEN all cross-referencing bodies — so a struct/enum body may hold a
    // member of generic-instance type (`struct Pair { a: Optional[I64] }`) regardless
    // of declaration order. (Plain enums and generic-enum instances are self-contained
    // `{ i64 tag, [maxWords] payload }`, sized by the front-end, so their bodies are
    // set with their names; only struct + generic-struct bodies cross-reference named
    // types, so those are deferred to the body passes.)
    registerStructNames(c: inout c, st: inout st)
    st.registerEnums(c: inout c)
    registerGenStructNames(c: inout c, st: inout st)
    registerGenEnums(c: inout c, st: inout st)
    registerStructBodies(c: inout c, st: inout st)
    registerGenStructBodies(c: inout c, st: inout st)

    // determine which assoc fns are actually reached (called) before declaring.
    st.collectReachableAssoc(c: inout c)

    // pass 1: declare all plain user functions + generic free-fn instances + generic
    // method instances (one per receiver instantiation).
    st.declareUserFns(c: inout c)
    st.declareGenFns(c: inout c)
    declareGenMethods(c: inout c, st: inout st)
    // async fns: build each frame struct + resume fn, and a non-main entry symbol
    // in the fnIdx table (so a call `doubler(x: 21)` resolves to a promise-returning
    // call). Done before bodies emit so main's resume can call them.
    declareAsyncFns(c: inout c, st: inout st)
    // declare lambda-lifted closures (after the named types + functions they may
    // reference exist), so a closure literal can build its {fn, env} value.
    st.collectClosures(c: inout c)
    // declare function-value thunks (a bare function reference -> {thunk, null}).
    st.collectThunks(c: inout c)

    // module-level variables (spec/15): emit `plew_init_globals` (one body that runs
    // every global's initializer once) and record each global's metadata, BEFORE any
    // function body so `seedGlobals` can re-bind them at every body entry. Done after
    // pass-1 declarations so an initializer may call a user function.
    genLlvmInitGlobals(c: inout c, st: inout st)

    // pass 2: emit `main` and every plain user function's body.
    mut val fi: U64 = 0
    mut val foundMain: Bool = false
    while fi < c.arena.funcs.count {
        // gen mode (spec/16): the program is the synthesized harness main at
        // `genMainIdx`; the user's own `main` is dead (it calls macro-generated
        // functions that don't exist in this build), so it is neither the entry
        // main nor a plain fn. Treat only genMainIdx as main here.
        mut val isMainFn: Bool = c.nameIsMain(f: c.arena.funcs[fi])
        if c.genMode {
            if isMainFn {
                if fi != c.genMainIdx {
                    isMainFn = false
                }
            }
        }
        if isMainFn {
            // an `async fn main` is lowered with the rest of the async fns (entry +
            // resume + drain the event loop); a plain main is the synchronous shape.
            if !(isAsyncFn(c: inout c, fi: fi)) {
                genLlvmMain(c: inout c, st: inout st, fi: fi)
            }
            foundMain = true
        } else {
            if c.genMode && c.nameIsMain(f: c.arena.funcs[fi]) {
                // the dead user main: skip entirely.
            } else {
                if st.isPlainUserFn(c: inout c, fi: fi) {
                    genLlvmFunc(c: inout c, st: inout st, fi: fi)
                }
            }
        }
        fi += 1
    }
    // async fn entry + resume bodies (main's entry drains the loop).
    emitAsyncFns(c: inout c, st: inout st)
    // generic free-function + generic-method instance bodies.
    st.emitGenFns(c: inout c)
    emitGenMethods(c: inout c, st: inout st)
    // lambda-lifted closure bodies + function-value thunks.
    st.emitClosures(c: inout c)
    st.emitThunks(c: inout c)
    // provided trait methods + lazily-declared std/generic methods reached during
    // the passes above. Both queues can grow as bodies emit (a provided body calls
    // a std generic method, a generic body reaches a provided one), so drain to a
    // fixpoint: loop until neither queue advances.
    mut val provDone: U64 = 0
    mut val genmDone: U64 = 0
    mut val draining: Bool = true
    while draining {
        while provDone < st.provEmit.count {
            genLlvmFuncBody(c: inout c, st: inout st, fi: st.provEmit[provDone], fv: st.fnVal[userFnSlot(st: inout st, idx: st.provEmit[provDone])])
            provDone += 1
        }
        while genmDone < st.genMethEmit.count {
            emitOneGenMethod(c: inout c, st: inout st, slot: st.genMethEmit[genmDone])
            genmDone += 1
        }
        if provDone >= st.provEmit.count {
            if genmDone >= st.genMethEmit.count {
                draining = false
            }
        }
    }
    if !(foundMain) {
        compileErrorAt(line: 0, msg: "LLVM backend: no `main` function found")
    }

    val ir: CPtr[U8] = LLVMPrintModuleToString(st.mod)
    write(s: stringFromCString(ir))
    LLVMDisposeMessage(ir)
}

// Emit `void @plew_init_globals()` (spec/15): one body that runs each module-level
// variable's initializer in lowering (= declaration) order and stores the result into
// its LLVM global. Each initializer is the same `Stmt.Let` a local binding produces,
// so we emit it through the normal statement path (which pushes a fully-typed local +
// alloca), then copy that local's recovered value into a fresh LLVM global and record
// its metadata in `gval*` so `seedGlobals` can re-bind it at every body entry. A later
// global's initializer can reference an earlier one (resolved as the alloca-local just
// pushed). Globals are program-lifetime, so they are never deinit'd (no scope-exit
// drop here — the same leak level as a top-level array/String value).
fn genLlvmInitGlobals(c: inout Comp, st: inout LlvmCtx) {
    if c.arena.globals.count == 0U64 {
        return
    }
    mut val noParams: Array[LLVMTypeRef] = []
    val fnTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(noParams), 0U64, 0I32)
    val fv: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_init_globals", nameId: 9120U64, fnTy: fnTy)
    st.curFn = fv
    st.curIsMain = false
    st.curRetVoid = true
    st.curAsync = false
    beginFnBody(st: inout st, fv: fv)
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    mut val gi: U64 = 0
    while gi < c.arena.globals.count {
        st.genLlvmStmt(c: inout c, id: c.arena.globals[gi].letStmt)
        val li: U64 = st.nLocals - 1U64
        val lty: LLVMTypeRef = st.locTy[li]
        val gv: LLVMValueRef = LLVMAddGlobal(st.mod, lty, cstr(s: globalSymbol(idx: gi)))
        LLVMSetInitializer(gv, LLVMConstNull(lty))
        val cur: LLVMValueRef = LLVMBuildLoad2(st.b, lty, st.locPtr[li], anon())
        LLVMBuildStore(st.b, cur, gv)
        st.gvalRef.append(value: gv)
        st.gvalLty.append(value: lty)
        st.gvalKind.append(value: st.locKind[li])
        st.gvalSidx.append(value: st.locStructIdx[li])
        st.gvalIsArr.append(value: st.locIsArr[li])
        st.gvalElemTy.append(value: st.locElemTy[li])
        st.gvalElemKind.append(value: st.locElemKind[li])
        st.gvalTref.append(value: st.locTypeRef[li])
        st.gvalElemStructIdx.append(value: st.locElemStructIdx[li])
        st.gvalElemTypeRef.append(value: st.locElemTypeRef[li])
        gi += 1
    }
    LLVMBuildRetVoid(st.b)
}

// A unique, stable LLVM symbol for the module-level variable at lowering index `idx`
// ("plew.g.<idx>"), so a same-named user local never collides with the global symbol.
fn globalSymbol(idx: U64) -> String {
    mut val s: Array[U8] = []
    appendBytes(into: inout s, from: "plew.g.".bytes)
    appendU64Dec(into: inout s, n: idx)
    return stringFromBytesUnchecked(s)
}

// Re-register every module-level variable as a local pointing at its LLVM global, so
// reads (`x`), writes (`x = …` for a `mut val` global), and all type-recovery
// (`x.field`, `x[i]`, method dispatch) resolve through the normal local machinery
// (findLocal). Called at the start of each function/closure/async body AFTER the local
// reset and BEFORE params/captures — so a same-named param or local shadows the global
// (findLocal returns the most-recently pushed match).
fn seedGlobals(c: inout Comp, st: inout LlvmCtx) {
    mut val gi: U64 = 0
    while gi < st.gvalRef.count {
        pushLocalR(st: inout st, nameStart: c.arena.globals[gi].nameStart, nameLen: c.arena.globals[gi].nameLen, ptr: st.gvalRef[gi], ty: st.gvalLty[gi], kind: st.gvalKind[gi], structIdx: st.gvalSidx[gi], isArr: st.gvalIsArr[gi], elemTy: st.gvalElemTy[gi], elemKind: st.gvalElemKind[gi], typeRef: st.gvalTref[gi])
        setLocalElemStruct(st: inout st, esi: st.gvalElemStructIdx[gi])
        setLocalElemTypeRef(st: inout st, ref: st.gvalElemTypeRef[gi])
        gi += 1
    }
}

// Emit the user `main` as C `i32 @main()` returning 0 (Plew main returns ()).
fn genLlvmMain(c: inout Comp, st: inout LlvmCtx, fi: U64) {
    // `i32 main(i32 argc, ptr argv)` so the program can read its command-line args
    // (@Std/Process argCount/argAt) — the args are stashed into the runtime via
    // plew_set_args before the body runs.
    mut val mainParams: Array[LLVMTypeRef] = []
    mainParams.append(value: st.i32ty)
    mainParams.append(value: st.ptrty)
    val mainTy: LLVMTypeRef = LLVMFunctionType(st.i32ty, arrayCPtr(mainParams), 2U64, 0I32)
    val mainFn: LLVMValueRef = LLVMAddFunction(st.mod, cstr(s: "main"), mainTy)
    st.curFn = mainFn
    st.curIsMain = true
    st.curRetVoid = false
    beginFnBody(st: inout st, fv: mainFn)
    // plew_set_args(argc, argv).
    mut val saTys: Array[LLVMTypeRef] = []
    saTys.append(value: st.i32ty)
    saTys.append(value: st.ptrty)
    val saTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(saTys), 2U64, 0I32)
    val saFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_set_args", nameId: 56U64, fnTy: saTy)
    mut val saArgs: Array[LLVMValueRef] = []
    saArgs.append(value: LLVMGetParam(mainFn, 0U64))
    saArgs.append(value: LLVMGetParam(mainFn, 1U64))
    LLVMBuildCall2(st.b, saTy, saFn, arrayCPtr(saArgs), 2U64, anon())
    // initialize module-level variables (spec/15) before the body runs.
    callInitGlobals(c: inout c, st: inout st)
    // fresh local scope.
    st.nLocals = 0
    st.locStart = []
    st.locLen = []
    st.locPtr = []
    st.locTy = []
    st.locKind = []
    st.locStructIdx = []
    st.locIsArr = []
    st.locElemTy = []
    st.locElemKind = []
    st.locTypeRef = []
    st.locElemStructIdx = []
    st.locElemTypeRef = []
    st.locOwned = []
    st.locMoved = []
    seedGlobals(c: inout c, st: inout st)
    st.genLlvmBlock(c: inout c, id: c.arena.funcs[fi].body)
    if !(st.terminated) {
        LLVMBuildRet(st.b, LLVMConstInt(st.i32ty, 0U64, 0I32))
    }
}

// Emit a call to `plew_init_globals` (a no-op when there are no module-level vars).
fn callInitGlobals(c: inout Comp, st: inout LlvmCtx) {
    if c.arena.globals.count == 0U64 {
        return
    }
    mut val noParams: Array[LLVMTypeRef] = []
    val igTy: LLVMTypeRef = LLVMFunctionType(st.voidty, arrayCPtr(noParams), 0U64, 0I32)
    val igFn: LLVMValueRef = getOrDeclare(c: inout c, st: inout st, name: "plew_init_globals", nameId: 9120U64, fnTy: igTy)
    mut val noArgs: Array[LLVMValueRef] = []
    LLVMBuildCall2(st.b, igTy, igFn, arrayCPtr(noArgs), 0U64, anon())
}

