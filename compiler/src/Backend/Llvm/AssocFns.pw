// Part of the LLVM backend (root: _.pw): reachable-associated-fn marking, scanning, and user-fn declaration.

// Whether a Func is a plain user free function the LLVM backend emits directly
// (not main / extern / generic / method / assoc / provided / trait-receiver).
// Restricted to the ENTRY module (id 0): the std library (Prelude/Core/…) is full
// of features not yet covered, and a simple program doesn't call them — emitting
// only the user's own module keeps bring-up tractable. (Proper call-graph
// reachability, which will pull in exactly the reached std functions, replaces
// this once arrays/methods/generics land.)
// ---- reachable associated functions ----
//
// Mark assoc fn `fi` reached, if not already (so its body is scanned for further
// assoc calls and it gets emitted). Returns whether it was newly added.

pub impl LlvmCtx {
    inout fn markReachAssoc(fi: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.reachAssoc.count {
            if self.reachAssoc[i] == fi {
                return false
            }
            i += 1
        }
        self.reachAssoc.append(value: fi)
        return true
    }
}

// Whether an assoc-fn name is an operator-trait witness (binary add/sub/mul/div/
// rem/bitand/bitor/bitxor/shl/shr, unary neg/not/bitnot). Used to seed reachable
// emission for operator desugar, which leaves no call node to scan.
fn isOperatorWitnessName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "add") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "sub") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "mul") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "div") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "rem") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "bitand") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "bitor") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "bitxor") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "shl") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "shr") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "neg") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "not") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "bitnot") { return true }
    return false
}

pub impl LlvmCtx {

    inout fn inReachAssoc(fi: U64) -> Bool {
        mut val i: U64 = 0
        while i < self.reachAssoc.count {
            if self.reachAssoc[i] == fi {
                return true
            }
            i += 1
        }
        return false
    }

    // Walk an expression, marking every `Type.name(args)` assoc-fn call it reaches.
    inout fn scanExprAssoc(c: inout Comp, id: U64) {
        match c.arena.exprs[id] {
            Expr.Unary(op: _, val operand) => { self.scanExprAssoc(c: inout c, id: operand) }
            Expr.Binary(op: _, val lhs, val rhs) => { self.scanExprAssoc(c: inout c, id: lhs) self.scanExprAssoc(c: inout c, id: rhs) }
            Expr.Call(nameStart: _, nameLen: _, val args) => {
                mut val i: U64 = 0
                while i < args.count { self.scanExprAssoc(c: inout c, id: args[i].expr) i += 1 }
            }
            Expr.Field(val base, nameStart: _, nameLen: _) => { self.scanExprAssoc(c: inout c, id: base) }
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
                mut val i: U64 = 0
                while i < fields.count { self.scanExprAssoc(c: inout c, id: fields[i].value) i += 1 }
            }
            Expr.Array(val elems) => {
                mut val i: U64 = 0
                while i < elems.count { self.scanExprAssoc(c: inout c, id: elems[i]) i += 1 }
            }
            Expr.Index(val base, val index) => { self.scanExprAssoc(c: inout c, id: base) self.scanExprAssoc(c: inout c, id: index) }
            Expr.Method(val recv, val nameStart, val nameLen, val args) => {
                val arn: Bind = c.assocRecvName(recv: recv)
                if arn.nameLen != 0U64 {
                    val afi: U64 = c.findAssoc(recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                    if afi < c.arena.funcs.count {
                        self.markReachAssoc(fi: afi)
                    }
                } else {
                    self.scanExprAssoc(c: inout c, id: recv)
                }
                mut val i: U64 = 0
                while i < args.count { self.scanExprAssoc(c: inout c, id: args[i].expr) i += 1 }
            }
            Expr.ExtMethod(val recv, srcStart: _, srcLen: _, nameStart: _, nameLen: _, val args) => {
                self.scanExprAssoc(c: inout c, id: recv)
                mut val i: U64 = 0
                while i < args.count { self.scanExprAssoc(c: inout c, id: args[i].expr) i += 1 }
            }
            Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
                self.scanExprAssoc(c: inout c, id: recv)
            }
            Expr.Cast(val operand, tyStart: _, tyLen: _, ty: _) => { self.scanExprAssoc(c: inout c, id: operand) }
            Expr.MatchExpr(val scrut, val arms) => {
                self.scanExprAssoc(c: inout c, id: scrut)
                mut val i: U64 = 0
                while i < arms.count {
                    self.scanBlockAssoc(c: inout c, id: arms[i].body)
                    i += 1
                }
            }
            Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
                self.scanExprAssoc(c: inout c, id: cond)
                self.scanBlockAssoc(c: inout c, id: thenBlk)
                self.scanBlockAssoc(c: inout c, id: elseBlk)
            }
            Expr.OptChain(val base, memberStart: _, memberLen: _) => { self.scanExprAssoc(c: inout c, id: base) }
            Expr.Try(val expr) => { self.scanExprAssoc(c: inout c, id: expr) }
            Expr.Arrow(val base, nameStart: _, nameLen: _) => { self.scanExprAssoc(c: inout c, id: base) }
            Expr.Move(val operand, isBorrow: _) => { self.scanExprAssoc(c: inout c, id: operand) }
            Expr.Await(val operand) => { self.scanExprAssoc(c: inout c, id: operand) }
            Expr.Closure(params: _, hasRet: _, retStart: _, retLen: _, retIsArray: _, retTy: _, val body) => { self.scanBlockAssoc(c: inout c, id: body) }
            _ => {}
        }
    }

    inout fn scanStmtAssoc(c: inout Comp, id: U64) {
        match c.arena.stmts[id] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => { self.scanExprAssoc(c: inout c, id: init) }
            Stmt.Assign(op: _, val target, val value) => { self.scanExprAssoc(c: inout c, id: target) self.scanExprAssoc(c: inout c, id: value) }
            Stmt.ExprStmt(val expr) => { self.scanExprAssoc(c: inout c, id: expr) }
            Stmt.Return(val value, val hasValue, offset: _) => { if hasValue { self.scanExprAssoc(c: inout c, id: value) } }
            Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
                self.scanExprAssoc(c: inout c, id: cond)
                self.scanBlockAssoc(c: inout c, id: thenBlk)
                if hasElse { self.scanBlockAssoc(c: inout c, id: elseBlk) }
            }
            Stmt.While(val cond, val body) => { self.scanExprAssoc(c: inout c, id: cond) self.scanBlockAssoc(c: inout c, id: body) }
            Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, isRange: _, inclusive: _, val iter, val rangeHi, val body, isStruct: _, patStart: _, patLen: _, binds: _) => {
                self.scanExprAssoc(c: inout c, id: iter)
                self.scanExprAssoc(c: inout c, id: rangeHi)
                self.scanBlockAssoc(c: inout c, id: body)
            }
            Stmt.Match(val scrut, val arms) => {
                self.scanExprAssoc(c: inout c, id: scrut)
                mut val i: U64 = 0
                while i < arms.count {
                    self.scanBlockAssoc(c: inout c, id: arms[i].body)
                    i += 1
                }
            }
            Stmt.Panic(val msg, offset: _) => { self.scanExprAssoc(c: inout c, id: msg) }
            Stmt.Give(val value) => { self.scanExprAssoc(c: inout c, id: value) }
            _ => {}
        }
    }

    inout fn scanBlockAssoc(c: inout Comp, id: U64) {
        if id == 0U64 {
            return
        }
        val blk: Block = c.arena.blocks[id]
        mut val i: U64 = 0
        while i < blk.stmts.count {
            self.scanStmtAssoc(c: inout c, id: blk.stmts[i])
            i += 1
        }
    }

    // Collect the assoc fns reachable from emitted code: seed by scanning every
    // non-assoc function body (those we emit), then iterate to a fixpoint over the
    // reached assoc fns' own bodies (which may call further assoc fns). Run before
    // declareUserFns, which only emits an assoc fn that is reachable.
    inout fn collectReachableAssoc(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.funcs.count {
            if c.arena.funcs[fi].isAssoc {
                // an operator-trait witness (add/sub/.../neg/not/bitnot) is reached
                // structurally, not by call-graph: operator desugar (`a + b`, `-x`)
                // leaves no `Type.name(...)` call in the AST for the scan to see, and
                // a value operand's type isn't known at scan time (c.cur.locals is empty
                // outside codegen). These names never collide with derive-generated
                // Eq/Ord (eq/compare), so derived witnesses stay correctly excluded.
                if isOperatorWitnessName(c: inout c, start: c.arena.funcs[fi].nameStart, len: c.arena.funcs[fi].nameLen) {
                    self.markReachAssoc(fi: fi)
                }
            } else {
                self.scanBlockAssoc(c: inout c, id: c.arena.funcs[fi].body)
            }
            fi += 1
        }
        mut val prev: U64 = c.arena.funcs.count + 1U64
        while self.reachAssoc.count != prev {
            prev = self.reachAssoc.count
            mut val ri: U64 = 0
            while ri < self.reachAssoc.count {
                self.scanBlockAssoc(c: inout c, id: c.arena.funcs[self.reachAssoc[ri]].body)
                ri += 1
            }
        }
    }

    inout fn isPlainUserFn(c: inout Comp, fi: U64) -> Bool {
        val f: Func = c.arena.funcs[fi]
        if c.nameIsMain(f: f) { return false }
        if f.isExtern { return false }
        // an `async fn` is lowered to a state machine (entry + resume), not a plain
        // body — declared/emitted by declareAsyncFns / emitAsyncFns.
        if f.isAsync { return false }
        // a provided trait method is NOT emitted upfront: it is declared+emitted lazily
        // the first time a call resolves to it (ensureProvidedDeclared), so an uncalled
        // std-trait adapter method (map/filter, whose body builds an unsupported adapter)
        // never gets emitted. The body offset can't tell std from entry reliably here, so
        // reachability is the gate, not module membership.
        if f.isProvided { return false }
        if f.typeParams.count > 0 { return false }
        if f.isAssoc {
            // an associated function (`Type.name(args)`, no self) is emitted like a
            // free function, gated to a registered owner type in the entry module AND
            // actually reached (called) — so derive-generated but uncalled witnesses
            // (Eq/Ord lowered natively here) aren't emitted into failing bodies.
            // Trait assoc fns and generic ones are deferred.
            if !(self.inReachAssoc(fi: fi)) {
                return false
            }
            if c.isTraitName(start: f.recvStart, len: f.recvLen) { return false }
            if self.structRegSlot(c: inout c, start: f.recvStart, len: f.recvLen) < self.structIdxs.count {
                return c.methodInEntryModule(f: f)
            }
            if self.enumRegSlot(c: inout c, start: f.recvStart, len: f.recvLen) < self.enumIdxs.count {
                return c.methodInEntryModule(f: f)
            }
            return false
        }
        if f.hasRecv {
            // a method: emit it iff its receiver is a registered struct OR enum AND it is
            // defined in the entry module. (A method name is re-interned so moduleOf on
            // it is unreliable; use the body's first statement, whose exprs keep their
            // original source offsets, to recover the defining module — this keeps std
            // struct methods, full of not-yet-supported constructs, from being emitted.)
            if c.isTraitName(start: f.recvStart, len: f.recvLen) { return false }
            if self.structRegSlot(c: inout c, start: f.recvStart, len: f.recvLen) >= self.structIdxs.count {
                if self.enumRegSlot(c: inout c, start: f.recvStart, len: f.recvLen) >= self.enumIdxs.count {
                    return false
                }
            }
            return c.methodInEntryModule(f: f)
        }
        // a free function: entry module only (see registerStructs note on reachability).
        return c.moduleOf(offset: f.nameStart) == 0U64
    }

    // The LLVM type of a parameter: a pointer for an `inout` parameter (it receives
    // the caller's address and mutates in place), else the value type (array-aware).
    inout fn paramLlvmTy(c: inout Comp, p: Param) -> LLVMTypeRef {
        if p.isInout {
            return self.ptrty
        }
        // a `Self`-typed param resolves to the receiver type (Self env set during method
        // emission).
        if c.cur.selfRef != 0U64 {
            if rangeEquals(bytes: c.arena.bytes, start: p.tyStart, len: p.tyLen, kw: "Self") {
                return self.llvmTypeOfRef(c: inout c, ref: c.cur.selfRef)
            }
        }
        // an existential `any P` param: the fat pointer (spec/08).
        if refIsAny(c: inout c, ref: p.ty) {
            return self.anyTy
        }
        // ground a generic-instance param type (`Box[T]`) through the active env.
        mut val pt: U64 = p.ty
        if c.cur.typeParams.count > 0U64 {
            pt = c.groundTypeRef(ref: pt)
        }
        if c.isGenericInst(ref: pt) {
            return self.llvmTypeOfRef(c: inout c, ref: pt)
        }
        return self.llvmTypeFor(c: inout c, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
    }

    // The LLVM type of a method's `self` parameter: a pointer for `inout fn` (mutates
    // the caller's value), else the receiver struct by value.
    inout fn selfParamTy(c: inout Comp, f: Func) -> LLVMTypeRef {
        if f.selfInout {
            return self.ptrty
        }
        return self.llvmScalarTy(c: inout c, tyStart: f.recvStart, tyLen: f.recvLen)
    }

    // The LLVM return type of a function (and whether it is void = Plew `()`).
    inout fn llvmFnRetTy(c: inout Comp, f: Func) -> LLVMTypeRef {
        if f.hasRet {
            // a `-> Self` return resolves to the receiver type (the Self env is set while
            // emitting a method): `fn dup() -> Self` on N returns N.
            if c.cur.selfRef != 0U64 {
                if rangeEquals(bytes: c.arena.bytes, start: f.retStart, len: f.retLen, kw: "Self") {
                    return self.llvmTypeOfRef(c: inout c, ref: c.cur.selfRef)
                }
            }
            // an existential `any P` return: the fat pointer (spec/08).
            if refIsAny(c: inout c, ref: f.retTy) {
                return self.anyTy
            }
            // ground a generic-instance return (`Box[T]`) through the active env so it
            // resolves to the registered concrete instance (`Box[I32]`). Also ground when
            // only a Self/Item env is active (a non-generic method on a conforming type:
            // `first() -> Optional[Item]` on Counter grounds Item -> I64 via curItemRef,
            // even though Counter has no type params).
            mut val rt: U64 = f.retTy
            if c.cur.typeParams.count > 0U64 || c.cur.itemRef != 0U64 || c.cur.selfRef != 0U64 {
                rt = c.groundTypeRef(ref: rt)
            }
            if c.isGenericInst(ref: rt) {
                return self.llvmTypeOfRef(c: inout c, ref: rt)
            }
            return self.llvmTypeFor(c: inout c, tyStart: f.retStart, tyLen: f.retLen, isArray: f.retIsArray)
        }
        return self.voidty
    }

    // Pass 1: declare every plain user function as `pf<idx>` with its LLVM signature,
    // caching (idx -> value, type) so calls resolve without name mangling.
    inout fn declareUserFns(c: inout Comp) {
        mut val fi: U64 = 0
        while fi < c.arena.funcs.count {
            val f: Func = c.arena.funcs[fi]
            if self.isPlainUserFn(c: inout c, fi: fi) {
                // a plain method's `Self` (in `-> Self` / a `Self` param) resolves to the
                // receiver type; set the Self env so the signature types ground.
                val didSelf: Bool = f.hasRecv
                if didSelf {
                    c.setSelfItemEnv(recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0U64)
                }
                mut val ptys: Array[LLVMTypeRef] = []
                if f.hasRecv {
                    ptys.append(value: self.selfParamTy(c: inout c, f: f))
                }
                mut val pi: U64 = 0
                while pi < f.params.count {
                    ptys.append(value: self.paramLlvmTy(c: inout c, p: f.params[pi]))
                    pi += 1
                }
                val rty: LLVMTypeRef = self.llvmFnRetTy(c: inout c, f: f)
                if didSelf {
                    c.clearSelfItemEnv()
                }
                val fty: LLVMTypeRef = LLVMFunctionType(rty, arrayCPtr(ptys), ptys.count, 0I32)
                mut val nm: Array[U8] = []
                appendBytes(into: inout nm, from: "pf".bytes)
                appendU64Dec(into: inout nm, n: fi)
                nm.append(value: 0)
                val fv: LLVMValueRef = LLVMAddFunction(self.mod, arrayCPtr(nm), fty)
                self.fnIdx.append(value: fi)
                self.fnVal.append(value: fv)
                self.fnTy.append(value: fty)
            }
            fi += 1
        }
    }
}
