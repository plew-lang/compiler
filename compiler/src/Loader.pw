// ---- multi-file module loading (parse-driven) ----
//
// A module may span several files: `part <path>` stitches a file into the same
// module (shared scope), `import <path>` pulls in a separate module. Loading is
// PARSE-DRIVEN: the driver (main) appends each file's source to the arena's byte
// buffer, parses it with the shared @Std/Syntax parser (parseAndLowerFile), lowers
// its items, and follows the `import`/`part` nodes the parser returns to discover
// more files — no separate directive pre-scan. Every distinct file is appended once
// (single-arena, single-C-output; no separate compilation). `resolveImport` turns a
// path node into a file path (`@Std/X`, `/Seg`, `./Name`, `../Name`).

// Parse one already-appended file (its bytes sit at c.arena.bytes[fileStart..]) through the
// shared @Std/Syntax parser and lower its items into the arena (spec/15,16). `base =
// fileStart` so every node span is an absolute offset into c.arena.bytes (module tagging
// via moduleOf works). Returns the parsed item list so the loader can follow the
// `Import` items (part/import) to more files and notice `@[...]` directives.
fn parseAndLowerFile(c: inout Comp, fileBytes: Array[U8], fileStart: U64) -> Array[TopItemAst] {
    mut val lx: Lexer = <Lexer bytes=fileBytes pos=0 toks=[] depth=0 />
    lex(lx: inout lx)
    mut val p: P = <P bytes=fileBytes toks=lx.toks pos=0 base=fileStart />
    val items: Array[TopItemAst] = parseProgramAst(p: inout p)
    if p.hasErr {
        compileErrorAt(line: lineOf(c: inout c, offset: p.errOff), msg: p.errMsg)
    }
    mut val i: U64 = 0
    while i < items.count {
        c.lowerTopItem(item: items[i])
        i += 1
    }
    return items
}
