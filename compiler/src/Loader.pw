// ---- multi-file module loading (parse-driven) ----
//
// A module may span several files: `part <path>` stitches a file into the same
// module (shared scope), `import <path>` pulls in a separate module. Loading is
// PARSE-DRIVEN: the driver (main) appends each file's source to the arena's byte
// buffer, parses it with the shared @Std/Syntax parser (parseAndLowerFile), lowers
// its items, and follows the `import`/`part` nodes the parser returns to discover
// more files — no separate directive pre-scan. Every distinct file is appended once
// (single-arena, single-C-output; no separate compilation). `resolveImport` turns a
// path node into a file path (`@Std/X`, `/Seg`, `./Name`, `../Name`).

// Parse one already-appended file (its bytes sit at c.arena.bytes[fileStart..]) through the
// shared @Std/Syntax parser and lower its items into the arena (spec/15,16). `base =
// fileStart` so every node span is an absolute offset into c.arena.bytes (module tagging
// via moduleOf works). Returns the parsed item list so the loader can follow the
// `Import` items (part/import) to more files and notice `@[...]` directives.
fn parseAndLowerFile(c: inout Comp, fileBytes: Array[U8], fileStart: U64) -> Array[TopItemAst] {
    mut val lx: Lexer = <Lexer bytes=fileBytes pos=0 toks=[] depth=0 />
    lex(lx: inout lx)
    mut val p: P = <P bytes=fileBytes toks=lx.toks pos=0 base=fileStart />
    val items: Array[TopItemAst] = parseProgramAst(p: inout p)
    if p.hasErr {
        compileErrorAt(line: lineOf(c: inout c, offset: p.errOff), msg: p.errMsg)
    }
    mut val i: U64 = 0
    while i < items.count {
        lowerTopItem(c: inout c, item: items[i])
        i += 1
    }
    return items
}

// Remove `n` trailing directory components from the prefix path[0..baseLen]
// (baseLen points just past a trailing '/'); returns the new prefix length. Used
// for `../` (each strips one component from the importer's directory).
fn stripParents(path: Array[U8], baseLen: U64, n: U64) -> U64 {
    mut val end: U64 = baseLen
    mut val c: U64 = 0
    while c < n {
        if end > 0 {
            end -= 1
            mut val go: Bool = true
            while go {
                if end > 0 {
                    if path[end - 1] == 47 {
                        go = false
                    } else {
                        end -= 1
                    }
                } else {
                    go = false
                }
            }
        }
        c += 1
    }
    return end
}

// Resolve an import/part path span into a file path, or an empty array to skip
// (`@…` intrinsic/external, or `/…` with no package root). `/Seg` → srcRoot +
// Seg + ".pw"; `./Name` → importerDir + Name + ".pw"; `../Name` → parent(s) of
// importerDir + Name + ".pw". The trailing-`/` subpath stays (subdirectories).
// Turn a module base path (no extension) into the file to load: `<base>.pw` if it
// exists, else the directory module `<base>/_.pw` (spec/15 — `_` is a directory's root
// module, so `import /Models` resolves to `src/Models.pw` OR `src/Models/_.pw`). When
// neither exists, returns the `.pw` form so the loader reports the missing file. When
// `base` already ends with `/` (the bare-`/` root import = `src/`), the directory form
// is `<base>_.pw` (no doubled slash).
fn finishModulePath(base: Array[U8]) -> Array[U8] {
    mut val withPw: Array[U8] = []
    appendBytes(into: inout withPw, from: base)
    appendBytes(into: inout withPw, from: ".pw".bytes)
    if fileExists(path: withPw) {
        return withPw
    }
    mut val under: Array[U8] = []
    appendBytes(into: inout under, from: base)
    if base.count > 0 {
        if base[base.count - 1] == 47 {
            appendBytes(into: inout under, from: "_.pw".bytes)
        } else {
            appendBytes(into: inout under, from: "/_.pw".bytes)
        }
    } else {
        appendBytes(into: inout under, from: "/_.pw".bytes)
    }
    if fileExists(path: under) {
        return under
    }
    return withPw
}

fn resolveImport(src: Array[U8], pStart: U64, pLen: U64, importer: Array[U8], baseLen: U64, srcRoot: Array[U8], srcRootLen: U64, stdRoot: Array[U8], stdRootLen: U64) -> Array[U8] {
    mut val out: Array[U8] = []
    if pLen == 0 {
        return out
    }
    val end: U64 = pStart + pLen
    val b0: U8 = src[pStart]
    if b0 == 64 {
        // `@Std/<rest>` -> stdRoot + <rest> + ".pw" (the language std library).
        // Other `@dep/...` (external packages) are not resolved yet -> skip.
        if pLen >= 5 {
            if rangeEquals(bytes: src, start: pStart + 1, len: 4, kw: "Std/") {
                if stdRootLen == 0 {
                    return out
                }
                appendBytes(into: inout out, from: stdRoot)
                appendBytes(into: inout out, from: extractSpan(buf: src, start: pStart + 5, len: end - (pStart + 5)))
                appendBytes(into: inout out, from: ".pw".bytes)
                return out
            }
        }
        return out
    }
    if b0 == 47 {
        if srcRootLen == 0 {
            return out
        }
        appendBytes(into: inout out, from: srcRoot)
        appendBytes(into: inout out, from: extractSpan(buf: src, start: pStart + 1, len: end - (pStart + 1)))
        return finishModulePath(base: out)
    }
    // relative ('.')
    mut val rest: U64 = pStart
    mut val parents: U64 = 0
    if pStart + 1 < end {
        if src[pStart] == 46 {
            if src[pStart + 1] == 47 {
                rest = pStart + 2
            } else {
                mut val go: Bool = true
                while go {
                    if rest + 2 < end {
                        if src[rest] == 46 {
                            if src[rest + 1] == 46 {
                                if src[rest + 2] == 47 {
                                    parents += 1
                                    rest += 3
                                } else {
                                    go = false
                                }
                            } else {
                                go = false
                            }
                        } else {
                            go = false
                        }
                    } else {
                        go = false
                    }
                }
            }
        }
    }
    val dirLen: U64 = stripParents(path: importer, baseLen: baseLen, n: parents)
    appendBytes(into: inout out, from: extractSpan(buf: importer, start: 0, len: dirLen))
    appendBytes(into: inout out, from: extractSpan(buf: src, start: rest, len: end - rest))
    return finishModulePath(base: out)
}

// Append every byte of `from` onto `into`.
fn appendBytes(into: inout Array[U8], from: Array[U8]) {
    mut val i: U64 = 0
    while i < from.count {
        into.append(from[i])
        i += 1
    }
}

// Copy a byte span out of `buf` into a fresh array (paths live in a shared
// buffer; this extracts one for use as a file path).
fn extractSpan(buf: Array[U8], start: U64, len: U64) -> Array[U8] {
    mut val out: Array[U8] = []
    mut val i: U64 = 0
    while i < len {
        out.append(buf[start + i])
        i += 1
    }
    return out
}

// Length of the directory prefix of `path` (index just past the last '/'); 0 if
// the path has no '/'. So a sibling resolves as path[0..pre] + name.
fn dirPrefixLen(path: Array[U8]) -> U64 {
    mut val pre: U64 = 0
    mut val k: U64 = 0
    while k < path.count {
        if path[k] == 47 {
            pre = k + 1
        }
        k += 1
    }
    return pre
}

// The std library root: the directory of the plewc binary (argv[0]) with `std/`
// appended. So invoking `compiler/plewc` resolves `@Std/X` to `compiler/std/X.pw`.
fn computeStdRoot(arg0: Array[U8]) -> Array[U8] {
    val pre: U64 = dirPrefixLen(path: arg0)
    mut val out: Array[U8] = []
    appendBytes(into: inout out, from: extractSpan(buf: arg0, start: 0, len: pre))
    appendBytes(into: inout out, from: "std/".bytes)
    return out
}

// Find the package source root for `/…` absolute imports: walk up from the
// entry file's directory to the nearest ancestor containing `Plew.toml` (the
// manifest), and return `<that dir>/src/`. Empty if no manifest is found (then
// `/…` imports are unresolved). spec: sources live under `src/` (manifest may
// override later); only the manifest's *location* is used for now.
fn findSrcRoot(entry: Array[U8]) -> Array[U8] {
    mut val dirLen: U64 = dirPrefixLen(path: entry)
    mut val go: Bool = true
    while go {
        mut val mani: Array[U8] = []
        mut val i: U64 = 0
        while i < dirLen {
            mani.append(entry[i])
            i += 1
        }
        val mn: Array[U8] = "Plew.toml".bytes
        appendBytes(into: inout mani, from: mn)
        if fileExists(path: mani) {
            mut val sr: Array[U8] = []
            mut val j: U64 = 0
            while j < dirLen {
                sr.append(entry[j])
                j += 1
            }
            val sx: Array[U8] = "src/".bytes
            appendBytes(into: inout sr, from: sx)
            return sr
        }
        if dirLen == 0 {
            go = false
        } else {
            val nd: U64 = stripParents(path: entry, baseLen: dirLen, n: 1)
            if nd == dirLen {
                go = false
            } else {
                dirLen = nd
            }
        }
    }
    mut val empty: Array[U8] = []
    return empty
}
// `<path>.pw` -> `<path>.gen.pw` (the auto-parted generated sibling). Empty if
// `path` does not end in `.pw` (46='.', 112='p', 119='w').
fn genSiblingPath(path: Array[U8]) -> Array[U8] {
    mut val out: Array[U8] = []
    val n: U64 = path.count
    if n < 3 {
        return out
    }
    if path[n - 3] == 46 {
        if path[n - 2] == 112 {
            if path[n - 1] == 119 {
                appendBytes(into: inout out, from: extractSpan(buf: path, start: 0, len: n - 3))
                appendBytes(into: inout out, from: ".gen.pw".bytes)
                return out
            }
        }
    }
    return out
}

// Whether `path` is already in the loaded set (each Bind is a span into `buf`).
// Dedup keeps a module included once and makes import cycles terminate.
fn pathSeen(buf: Array[U8], loaded: Array[Bind], path: Array[U8]) -> Bool {
    mut val i: U64 = 0
    while i < loaded.count {
        val b: Bind = loaded[i]
        if b.nameLen == path.count {
            mut val eq: Bool = true
            mut val j: U64 = 0
            while j < path.count {
                if buf[b.nameStart + j] != path[j] {
                    eq = false
                }
                j += 1
            }
            if eq {
                return true
            }
        }
        i += 1
    }
    return false
}
