// ---- declaration parser ----

// Parse a parenthesized parameter list `( name: [inout] Type, ... )` into
// Param nodes (shared by function/method declarations and closure literals).
// If the current token is not `(`, returns an empty list.
fn parseParamList(c: inout Comp) -> Array[Param] {
    mut val params: Array[Param] = []
    match c.curKind() {
        Kind.LParen => {
            c.advance()
            while true {
                c.skipNewlines()
                val k: Kind = c.curKind()
                match k {
                    Kind.RParen => {
                        c.advance()
                        break
                    }
                    Kind.Eof => { break }
                    _ => {
                        val pTok: Tok = c.cur()
                        c.advance()
                        mut val pTyStart: U64 = 0
                        mut val pTyLen: U64 = 0
                        mut val pTyIsArray: Bool = false
                        mut val pTyRef: U64 = 0
                        mut val pIsInout: Bool = false
                        mut val pIsMove: Bool = false
                        mut val pIsBorrow: Bool = false
                        // label suppression `name~:` -> the arg is positional.
                        mut val pNoLabel: Bool = false
                        match c.curKind() {
                            Kind.Tilde => {
                                if c.peekKind(off: 1) == <Kind.Colon /> {
                                    c.advance()
                                    pNoLabel = true
                                }
                            }
                            _ => {}
                        }
                        match c.curKind() {
                            Kind.Colon => {
                                c.advance()
                                match c.curKind() {
                                    Kind.KwInout => {
                                        c.advance()
                                        pIsInout = true
                                    }
                                    Kind.KwMove => {
                                        c.advance()
                                        pIsMove = true
                                    }
                                    Kind.KwBorrow => {
                                        c.advance()
                                        pIsBorrow = true
                                    }
                                    _ => {}
                                }
                                val pty: PType = parseTypeTok(c: inout c)
                                pTyStart = pty.start
                                pTyLen = pty.len
                                pTyIsArray = pty.isArray
                                pTyRef = pty.ref
                                recordArrayElem(c: inout c, ty: pty)
                            }
                            _ => {}
                        }
                        // optional default `= expr`.
                        mut val pHasDefault: Bool = false
                        mut val pDefault: U64 = 0
                        match c.curKind() {
                            Kind.Eq => {
                                c.advance()
                                pHasDefault = true
                                pDefault = parseExpr(c: inout c)
                            }
                            _ => {}
                        }
                        params.append(<Param nameStart=pTok.start nameLen=pTok.len tyStart=pTyStart tyLen=pTyLen tyIsArray=pTyIsArray ty=pTyRef isInout=pIsInout isMove=pIsMove isBorrow=pIsBorrow noLabel=pNoLabel hasDefault=pHasDefault defaultExpr=pDefault />)
                        match c.curKind() {
                            Kind.Comma => { c.advance() }
                            _ => {}
                        }
                    }
                }
            }
        }
        _ => {}
    }
    return params
}

// `fn name ( params ) [-> ret] { body }`. The leading `fn` (and any `inout`
// receiver marker for methods) is already consumed; the current token is the
// name. `hasRecv`/`recv*`/`selfInout` describe an `impl Type` method receiver
// (none for a free function).
fn parseFuncCommon(c: inout Comp, hasRecv: Bool, recvStart: U64, recvLen: U64, selfInout: Bool, selfMove: Bool, implParams: Array[Bind], traitImpl: Bool, isAssoc: Bool) {
    val nameTok: Tok = c.cur()
    c.advance()
    // type parameters in scope = those introduced by the enclosing `impl[T]`
    // (for a method) followed by the function's own `fn id[U](...)`.
    val ownParams: Array[Bind] = parseTypeParams(c: inout c)
    mut val typeParams: Array[Bind] = []
    mut val ipi: U64 = 0
    while ipi < implParams.count {
        typeParams.append(implParams[ipi])
        ipi += 1
    }
    mut val opi: U64 = 0
    while opi < ownParams.count {
        typeParams.append(ownParams[opi])
        opi += 1
    }
    val params: Array[Param] = parseParamList(c: inout c)
    mut val hasRet: Bool = false
    mut val retStart: U64 = 0
    mut val retLen: U64 = 0
    mut val retIsArray: Bool = false
    mut val retRef: U64 = 0
    match c.curKind() {
        Kind.Arrow => {
            c.advance()
            hasRet = true
            val rty: PType = parseTypeTok(c: inout c)
            retStart = rty.start
            retLen = rty.len
            retIsArray = rty.isArray
            retRef = rty.ref
            recordArrayElem(c: inout c, ty: rty)
        }
        _ => {}
    }
    // optional `where T: Trait [+ Trait] [, U: Trait]` bounds (spec/08). Each
    // atom (one trait per `+`/`,` expansion) is collected as parallel param/trait
    // spans and recorded as a FuncBound once the function's index is known.
    val boundParams: Array[Bind] = parseWhereClause(c: inout c)
    mut val boundTraits: Array[Bind] = c.curWhereTraits
    // a trait-impl member witnesses a requirement either by `via real` (an alias
    // to an existing member) or by defining a body here (spec/08). `via` follows
    // the signature on the same line; record the witnessed requirement name.
    if traitImpl {
        // record the witnessed requirement's signature (name + params + ret) so
        // the completeness check can match by selector, not just name. Append the
        // Func inline (no intermediate local): a `val wsig` local would, at the
        // `via` early return, release its `params` array a second time (struct
        // literal field bind does not retain, but the local's release does),
        // freeing the buffer the appended copy still references — a UAF.
        if c.identIs(kw: "via") {
            c.advance()
            val realTok: Tok = c.cur()
            c.advance()
            c.methodAliases.append(<MethodAlias recvStart=recvStart recvLen=recvLen aliasStart=nameTok.start aliasLen=nameTok.len realStart=realTok.start realLen=realTok.len />)
            c.curWitnessed.append(<Func nameStart=nameTok.start nameLen=nameTok.len typeParams=typeParams params=params hasRet=hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false />)
            return
        }
        c.curWitnessed.append(<Func nameStart=nameTok.start nameLen=nameTok.len typeParams=typeParams params=params hasRet=hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false />)
    }
    c.skipNewlines()
    val body: U64 = parseBlock(c: inout c)
    val fnIdx: U64 = c.funcs.count
    c.funcs.append(<Func nameStart=nameTok.start nameLen=nameTok.len typeParams=typeParams params=params hasRet=hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=hasRecv recvStart=recvStart recvLen=recvLen selfInout=selfInout selfMove=selfMove isAssoc=isAssoc />)
    mut val wbi: U64 = 0
    while wbi < boundParams.count {
        val bp: Bind = boundParams[wbi]
        val bt: Bind = boundTraits[wbi]
        c.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=bp.nameStart paramLen=bp.nameLen traitStart=bt.nameStart traitLen=bt.nameLen />)
        wbi += 1
    }
}

// Parse an optional `where T: Trait [+ Trait] [, U: Trait]` clause. Returns the
// bounded type-parameter spans; the parallel trait spans are left in
// c.curWhereTraits (a scratch slot — two return values are awkward without a
// tuple). Empty when no `where` is present. Stops at `{`, newline, or EOF.
fn parseWhereClause(c: inout Comp) -> Array[Bind] {
    mut val boundParams: Array[Bind] = []
    mut val boundTraits: Array[Bind] = []
    if c.identIs(kw: "where") {
        c.advance()
        mut val cont: Bool = true
        while cont {
            c.skipNewlines()
            match c.curKind() {
                Kind.Ident => {
                    val pTok: Tok = c.cur()
                    c.advance()
                    match c.curKind() {
                        Kind.Colon => { c.advance() }
                        _ => {}
                    }
                    mut val moreTraits: Bool = true
                    while moreTraits {
                        match c.curKind() {
                            Kind.Ident => {
                                val tTok: Tok = c.cur()
                                c.advance()
                                boundParams.append(<Bind nameStart=pTok.start nameLen=pTok.len fieldStart=pTok.start fieldLen=pTok.len />)
                                boundTraits.append(<Bind nameStart=tTok.start nameLen=tTok.len fieldStart=tTok.start fieldLen=tTok.len />)
                            }
                            _ => {}
                        }
                        match c.curKind() {
                            Kind.Plus => { c.advance() }
                            _ => { moreTraits = false }
                        }
                    }
                    match c.curKind() {
                        Kind.Comma => { c.advance() }
                        _ => { cont = false }
                    }
                }
                _ => { cont = false }
            }
        }
    }
    c.curWhereTraits = boundTraits
    return boundParams
}

// `fn name(...)`: a free function. The current token is `fn`.
fn parseFunc(c: inout Comp) {
    c.advance()
    val noParams: Array[Bind] = []
    parseFuncCommon(c: inout c, hasRecv: false, recvStart: 0, recvLen: 0, selfInout: false, selfMove: false, implParams: noParams, traitImpl: false, isAssoc: false)
}

// `impl Type { (fn | inout fn) name(...) ... }`: inherent methods. Each member
// is a function with an implicit `self` receiver (`inout fn` makes self
// mutable). The current token is the `impl` identifier.
fn parseImpl(c: inout Comp) {
    c.advance()
    // optional `impl[T]` binder, then the receiver type (`Box[T]` / `Comp`).
    // recvStart/recvLen names the receiver head; the self type's `[T]` args are
    // consumed by parseTypeTok and the params flow to each method's typeParams.
    val implParams: Array[Bind] = parseTypeParams(c: inout c)
    val recvPty: PType = parseTypeTok(c: inout c)
    val recvStart: U64 = recvPty.start
    val recvLen: U64 = recvPty.len
    // `impl Type as Trait { ... }` (spec/08): a conformance. The members witness
    // the trait's requirements (body or `via`); each `fn` is registered as a
    // method on Type exactly like an inherent member, so it rides the existing
    // method-resolution machinery. A bare `impl Type { ... }` is inherent.
    mut val isTraitImpl: Bool = false
    mut val traitStart: U64 = 0
    mut val traitLen: U64 = 0
    match c.curKind() {
        Kind.KwAs => {
            c.advance()
            val traitTok: Tok = c.cur()
            c.advance()
            isTraitImpl = true
            traitStart = traitTok.start
            traitLen = traitTok.len
            c.curWitnessed = []
        }
        _ => {}
    }
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.KwInout => {
                c.advance()
                match c.curKind() {
                    Kind.KwFn => { c.advance() }
                    _ => {}
                }
                parseFuncCommon(c: inout c, hasRecv: true, recvStart: recvStart, recvLen: recvLen, selfInout: true, selfMove: false, implParams: implParams, traitImpl: isTraitImpl, isAssoc: false)
            }
            Kind.KwFn => {
                c.advance()
                parseFuncCommon(c: inout c, hasRecv: true, recvStart: recvStart, recvLen: recvLen, selfInout: false, selfMove: false, implParams: implParams, traitImpl: isTraitImpl, isAssoc: false)
            }
            Kind.KwMove => {
                // `move fn` (consuming self): the method takes ownership of self.
                c.advance()
                match c.curKind() {
                    Kind.KwFn => { c.advance() }
                    _ => {}
                }
                parseFuncCommon(c: inout c, hasRecv: true, recvStart: recvStart, recvLen: recvLen, selfInout: false, selfMove: true, implParams: implParams, traitImpl: isTraitImpl, isAssoc: false)
            }
            Kind.KwBorrow => {
                // `borrow fn` (read self, non-consuming): observationally identical
                // to `fn` for a unique value, so accept it as a synonym.
                c.advance()
                match c.curKind() {
                    Kind.KwFn => { c.advance() }
                    _ => {}
                }
                parseFuncCommon(c: inout c, hasRecv: true, recvStart: recvStart, recvLen: recvLen, selfInout: false, selfMove: false, implParams: implParams, traitImpl: isTraitImpl, isAssoc: false)
            }
            Kind.KwDeinit => {
                // `deinit { body }` (spec/03): no params, no return, read self.
                // Lowered to a synthetic method `Type_deinit(Type self)` (name span
                // = the `deinit` keyword) and recorded so scope-exit drops fire it.
                val deinitTok: Tok = c.cur()
                c.advance()
                c.skipNewlines()
                val body: U64 = parseBlock(c: inout c)
                val noParams: Array[Param] = []
                val noTypeParams: Array[Bind] = []
                c.funcs.append(<Func nameStart=deinitTok.start nameLen=deinitTok.len typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=recvStart recvLen=recvLen selfInout=false selfMove=false isAssoc=false />)
                c.deinits.append(<Bind nameStart=recvStart nameLen=recvLen fieldStart=recvStart fieldLen=recvLen />)
            }
            _ => {
                // `assoc fn name(...)` (spec/07,12): an associated function on the
                // type — no `self`, but mangled into the type's namespace. The
                // call site is `Type.name(args)`. Any other ident is skipped.
                if c.identIs(kw: "assoc") {
                    c.advance()
                    match c.curKind() {
                        Kind.KwFn => { c.advance() }
                        _ => {}
                    }
                    parseFuncCommon(c: inout c, hasRecv: false, recvStart: recvStart, recvLen: recvLen, selfInout: false, selfMove: false, implParams: implParams, traitImpl: isTraitImpl, isAssoc: true)
                } else {
                    c.advance()
                }
            }
        }
    }
    // record the conformance with the requirement names it witnessed, for the
    // completeness check (spec/08: every requirement must be witnessed).
    if isTraitImpl {
        c.conforms.append(<Conform typeStart=recvStart typeLen=recvLen traitStart=traitStart traitLen=traitLen derived=false witnessed=c.curWitnessed />)
    }
}

// `trait Name { fn req(...) [-> T] ... }` (spec/08). The body holds only
// requirements (no body). T1 records each method requirement's name; the
// signature (type params, params, return) is parsed and discarded. Non-`fn`
// lines (field / associated-type / factory requirements) are skipped for now.
fn parseTrait(c: inout Comp) {
    c.advance()
    val nameTok: Tok = c.cur()
    c.advance()
    // optional supertraits `: Super [+ Super2]` (spec/08: a constraint).
    mut val supertraits: Array[Bind] = []
    match c.curKind() {
        Kind.Colon => {
            c.advance()
            mut val more: Bool = true
            while more {
                match c.curKind() {
                    Kind.Ident => {
                        val st: Tok = c.cur()
                        c.advance()
                        supertraits.append(<Bind nameStart=st.start nameLen=st.len fieldStart=st.start fieldLen=st.len />)
                    }
                    _ => {}
                }
                match c.curKind() {
                    Kind.Plus => { c.advance() }
                    _ => { more = false }
                }
            }
        }
        _ => {}
    }
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val reqs: Array[Func] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.KwFn => {
                c.advance()
                reqs.append(parseReqSig(c: inout c, isAssoc: false))
            }
            _ => {
                // `assoc fn name(...)` requirement (spec/12: operator requirements
                // like `Eq.eq` are assoc fns).
                if c.identIs(kw: "assoc") {
                    c.advance()
                    match c.curKind() {
                        Kind.KwFn => { c.advance() }
                        _ => {}
                    }
                    reqs.append(parseReqSig(c: inout c, isAssoc: true))
                } else {
                    c.advance()
                }
            }
        }
    }
    c.traits.append(<TraitDef nameStart=nameTok.start nameLen=nameTok.len supertraits=supertraits reqs=reqs />)
}

// Parse a trait requirement signature `name [typeParams] (params) [-> ret]` into
// a body-less Func (body=0, hasRecv=false). The leading `fn`/`assoc fn` is
// already consumed; `isAssoc` records which form.
fn parseReqSig(c: inout Comp, isAssoc: Bool) -> Func {
    val reqTok: Tok = c.cur()
    c.advance()
    val tps: Array[Bind] = parseTypeParams(c: inout c)
    val ps: Array[Param] = parseParamList(c: inout c)
    mut val hasRet: Bool = false
    mut val rs: U64 = 0
    mut val rl: U64 = 0
    mut val ria: Bool = false
    mut val rr: U64 = 0
    match c.curKind() {
        Kind.Arrow => {
            c.advance()
            val rty: PType = parseTypeTok(c: inout c)
            hasRet = true
            rs = rty.start
            rl = rty.len
            ria = rty.isArray
            rr = rty.ref
            recordArrayElem(c: inout c, ty: rty)
        }
        _ => {}
    }
    val sig: Func = <Func nameStart=reqTok.start nameLen=reqTok.len typeParams=tps params=ps hasRet=hasRet retStart=rs retLen=rl retIsArray=ria retTy=rr body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=isAssoc />
    return sig
}

// `[unique] struct Name { (val|mut val) field: Type ... }`. Field modifiers
// (val/mut/pub) are consumed and ignored; codegen maps each field's type to a C
// type. `isUnique` is set when a leading `unique` keyword was consumed.
fn parseStruct(c: inout Comp, isUnique: Bool) {
    c.advance()
    val nameTok: Tok = c.cur()
    c.advance()
    val typeParams: Array[Bind] = parseTypeParams(c: inout c)
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val fields: Array[FieldDef] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Comma => {
                // Struct fields are newline-separated (spec/05). A comma would
                // otherwise be swallowed as an empty-named field (`long long ,;`),
                // so reject it loudly instead of miscompiling.
                compileErrorAt(line: lineOf(c: inout c, offset: c.cur().start), msg: "struct fields are separated by newlines, not commas")
            }
            Kind.KwDeinit => {
                // `deinit { body }` written in the struct body (spec/03's primary
                // form). Same lowering as the impl form: a synthetic
                // `Type_deinit(Type self)` method + a c.deinits record.
                val deinitTok: Tok = c.cur()
                c.advance()
                c.skipNewlines()
                val body: U64 = parseBlock(c: inout c)
                val noParams: Array[Param] = []
                val noTypeParams: Array[Bind] = []
                c.funcs.append(<Func nameStart=deinitTok.start nameLen=deinitTok.len typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=nameTok.start recvLen=nameTok.len selfInout=false selfMove=false isAssoc=false />)
                c.deinits.append(<Bind nameStart=nameTok.start nameLen=nameTok.len fieldStart=nameTok.start fieldLen=nameTok.len />)
            }
            _ => {
                // a field declaration: `[mut] val name : Type`. `mut val` marks
                // assignable storage; bare `val` is immutable.
                mut val isMut: Bool = false
                match c.curKind() {
                    Kind.KwMut => {
                        c.advance()
                        isMut = true
                    }
                    _ => {}
                }
                match c.curKind() {
                    Kind.KwVal => { c.advance() }
                    _ => {}
                }
                val fTok: Tok = c.cur()
                c.advance()
                mut val tyStart: U64 = 0
                mut val tyLen: U64 = 0
                mut val tyIsArray: Bool = false
                mut val tyRef: U64 = 0
                match c.curKind() {
                    Kind.Colon => {
                        c.advance()
                        val ty: PType = parseTypeTok(c: inout c)
                        tyStart = ty.start
                        tyLen = ty.len
                        tyIsArray = ty.isArray
                        tyRef = ty.ref
                        recordArrayElem(c: inout c, ty: ty)
                    }
                    _ => {}
                }
                // optional field default `val x: T = expr` (spec/05). Consume the
                // `=` and the expression so it lands in FieldDef (else `= expr`
                // would be mis-parsed as phantom fields); used by the memberwise
                // factory when a construction omits this field.
                mut val hasDefault: Bool = false
                mut val defaultVal: U64 = 0
                match c.curKind() {
                    Kind.Eq => {
                        c.advance()
                        defaultVal = parseExpr(c: inout c)
                        hasDefault = true
                    }
                    _ => {}
                }
                fields.append(<FieldDef nameStart=fTok.start nameLen=fTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef isMut=isMut hasDefault=hasDefault defaultVal=defaultVal />)
            }
        }
    }
    c.structs.append(<StructDef nameStart=nameTok.start nameLen=nameTok.len typeParams=typeParams fields=fields isUnique=isUnique />)
    drainDerives(c: inout c, typeStart: nameTok.start, typeLen: nameTok.len, isEnum: false)
}

// `enum Name { Variant [{ field: Type, ... }] ... }`. Variant fields take no
// modifiers (bare `name: Type`), per the language's variant-field rule.
fn parseEnum(c: inout Comp) {
    c.advance()
    val nameTok: Tok = c.cur()
    c.advance()
    val typeParams: Array[Bind] = parseTypeParams(c: inout c)
    match c.curKind() {
        Kind.LBrace => { c.advance() }
        _ => {}
    }
    mut val variants: Array[Variant] = []
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.RBrace => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Ident => {
                val vTok: Tok = c.cur()
                c.advance()
                mut val fields: Array[FieldDef] = []
                // variant payload is record-form `V(x: I32, y: I32)` (spec/05).
                // The legacy brace form `V { x: I32 }` is still accepted during
                // the migration; either bracket closes it.
                mut val vopen: Bool = false
                match c.curKind() {
                    Kind.LBrace => {
                        c.advance()
                        vopen = true
                    }
                    Kind.LParen => {
                        c.advance()
                        vopen = true
                    }
                    _ => {}
                }
                if vopen {
                    while true {
                        c.skipNewlines()
                        match c.curKind() {
                            Kind.RBrace => {
                                c.advance()
                                break
                            }
                            Kind.RParen => {
                                c.advance()
                                break
                            }
                            Kind.Eof => { break }
                            Kind.Ident => {
                                val fTok: Tok = c.cur()
                                c.advance()
                                mut val tyStart: U64 = 0
                                mut val tyLen: U64 = 0
                                mut val tyIsArray: Bool = false
                                mut val tyRef: U64 = 0
                                match c.curKind() {
                                    Kind.Colon => {
                                        c.advance()
                                        val ty: PType = parseTypeTok(c: inout c)
                                        tyStart = ty.start
                                        tyLen = ty.len
                                        tyIsArray = ty.isArray
                                        tyRef = ty.ref
                                        recordArrayElem(c: inout c, ty: ty)
                                    }
                                    _ => {}
                                }
                                fields.append(<FieldDef nameStart=fTok.start nameLen=fTok.len tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef isMut=false hasDefault=false defaultVal=0 />)
                                match c.curKind() {
                                    Kind.Comma => { c.advance() }
                                    _ => {}
                                }
                            }
                            _ => { c.advance() }
                        }
                    }
                }
                variants.append(<Variant nameStart=vTok.start nameLen=vTok.len fields=fields />)
            }
            _ => { c.advance() }
        }
    }
    c.enums.append(<EnumDef nameStart=nameTok.start nameLen=nameTok.len typeParams=typeParams variants=variants />)
    drainDerives(c: inout c, typeStart: nameTok.start, typeLen: nameTok.len, isEnum: true)
}

// `@[Eq, Ord, ...]` directive (spec/16): collect the derive names into
// pendingDerives, applied to the next type declaration. The `@` lexes as
// Kind.Unknown; the leading `@` is the current token.
fn parseDirective(c: inout Comp) {
    c.advance()
    match c.curKind() {
        Kind.LBracket => { c.advance() }
        _ => {}
    }
    while true {
        match c.curKind() {
            Kind.RBracket => {
                c.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Comma => { c.advance() }
            Kind.Ident => {
                val t: Tok = c.cur()
                c.advance()
                c.pendingDerives.append(<Bind nameStart=t.start nameLen=t.len fieldStart=t.start fieldLen=t.len />)
            }
            _ => { c.advance() }
        }
    }
}

// Attach the pending `@[...]` derive requests to the just-parsed type, then clear
// the scratch list for the next declaration.
fn drainDerives(c: inout Comp, typeStart: U64, typeLen: U64, isEnum: Bool) {
    mut val i: U64 = 0
    while i < c.pendingDerives.count {
        val d: Bind = c.pendingDerives[i]
        c.derives.append(<DeriveReq typeStart=typeStart typeLen=typeLen isEnum=isEnum nameStart=d.nameStart nameLen=d.nameLen />)
        i += 1
    }
    c.pendingDerives = []
}

// Append a string's bytes to c.bytes and return its (start,len) span — for
// synthetic identifier names referenced by derived code (#5: `@[Eq]`/`@[Ord]`).
fn internBytes(c: inout Comp, s: String) -> Bind {
    val start: U64 = c.bytes.count
    val sb: Array[U8] = s.bytes
    mut val i: U64 = 0
    while i < sb.count {
        c.bytes.append(sb[i])
        i += 1
    }
    return <Bind nameStart=start nameLen=sb.count fieldStart=start fieldLen=sb.count />
}

// A type-typed parameter `name: Type` (copyable, no mode/default) for a
// synthesized assoc fn.
fn synthParam(nameSpan: Bind, tyStart: U64, tyLen: U64) -> Param {
    val p: Param = <Param nameStart=nameSpan.nameStart nameLen=nameSpan.nameLen tyStart=tyStart tyLen=tyLen tyIsArray=false ty=0 isInout=false isMove=false isBorrow=false noLabel=false hasDefault=false defaultExpr=0 />
    return p
}

// Synthesize `@[Eq]` for a struct: an assoc fn `eq(lhs: T, rhs: T) -> Bool` whose
// body is `lhs.f0 == rhs.f0 && lhs.f1 == rhs.f1 && ...` (true for a field-less
// struct), plus a derived `Conform(T, Eq)`. Each field `==` lowers per its own
// type (scalar/String built-in; a struct field needs its own Eq).
fn synthStructEq(c: inout Comp, d: DeriveReq, eqN: Bind, lhsN: Bind, rhsN: Bind, boolN: Bind, eqTrait: Bind) {
    val si: U64 = structIndexByName(c: inout c, start: d.typeStart, len: d.typeLen)
    if si >= c.structs.count {
        return
    }
    val fields: Array[FieldDef] = c.structs[si].fields
    mut val params: Array[Param] = []
    params.append(synthParam(nameSpan: lhsN, tyStart: d.typeStart, tyLen: d.typeLen))
    params.append(synthParam(nameSpan: rhsN, tyStart: d.typeStart, tyLen: d.typeLen))
    val lhsId: U64 = c.pushExpr(e: <Expr.Ident start=lhsN.nameStart len=lhsN.nameLen />)
    val rhsId: U64 = c.pushExpr(e: <Expr.Ident start=rhsN.nameStart len=rhsN.nameLen />)
    mut val acc: U64 = 0
    mut val first: Bool = true
    mut val fi: U64 = 0
    while fi < fields.count {
        val f: FieldDef = fields[fi]
        val lf: U64 = c.pushExpr(e: <Expr.Field base=lhsId nameStart=f.nameStart nameLen=f.nameLen />)
        val rf: U64 = c.pushExpr(e: <Expr.Field base=rhsId nameStart=f.nameStart nameLen=f.nameLen />)
        val eqi: U64 = c.pushExpr(e: <Expr.Binary op=50 lhs=lf rhs=rf />)
        if first {
            acc = eqi
            first = false
        } else {
            acc = c.pushExpr(e: <Expr.Binary op=61 lhs=acc rhs=eqi />)
        }
        fi += 1
    }
    if first {
        acc = c.pushExpr(e: <Expr.Int value=1 offset=0 isBool=true tyStart=0 tyLen=0 />)
    }
    val ret: U64 = c.pushStmt(s: <Stmt.Return value=acc hasValue=true />)
    mut val stmts: Array[U64] = []
    stmts.append(ret)
    val blkId: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    val noTP: Array[Bind] = []
    c.funcs.append(<Func nameStart=eqN.nameStart nameLen=eqN.nameLen typeParams=noTP params=params hasRet=true retStart=boolN.nameStart retLen=boolN.nameLen retIsArray=false retTy=0 body=blkId hasRecv=false recvStart=d.typeStart recvLen=d.typeLen selfInout=false selfMove=false isAssoc=true />)
    mut val wit: Array[Func] = []
    c.conforms.append(<Conform typeStart=d.typeStart typeLen=d.typeLen traitStart=eqTrait.nameStart traitLen=eqTrait.nameLen derived=true witnessed=wit />)
}

// A decimal digit (0-9) as its ASCII byte. (`48 + d` would need a U64->U8 cast,
// which the lossless-`as` discipline forbids, so spell it out.)
fn digitByte(d: U64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}

fn appendU64Digits(c: inout Comp, n: U64) {
    if n >= 10 {
        appendU64Digits(c: inout c, n: n / 10)
    }
    c.bytes.append(digitByte(d: n % 10))
}

// Intern a fresh synthetic name `<prefix><n>` (e.g. `L0`, `R3`) for a match bind.
fn internName(c: inout Comp, prefix: U8, n: U64) -> Bind {
    val start: U64 = c.bytes.count
    c.bytes.append(prefix)
    appendU64Digits(c: inout c, n: n)
    val len: U64 = c.bytes.count - start
    return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
}

// Index of the enum named (start,len), or c.enums.count if none.
fn enumIndexByName(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val i: U64 = 0
    while i < c.enums.count {
        if spansEqual(c: inout c, aStart: c.enums[i].nameStart, aLen: c.enums[i].nameLen, bStart: start, bLen: len) {
            return i
        }
        i += 1
    }
    return c.enums.count
}

// A `true`/`false` Bool literal expression.
fn synthBool(c: inout Comp, v: I64) -> U64 {
    return c.pushExpr(e: <Expr.Int value=v offset=0 isBool=true tyStart=0 tyLen=0 />)
}

// Synthesize `@[Eq]` for an enum: `eq(lhs: E, rhs: E) -> Bool` as a value-position
// match `match lhs { E.V(L..) => match rhs { E.V(R..) => L0==R0 && ..., _ => false }, ... }`
// (tags must agree, then payloads compare field-wise). The outer match is
// exhaustive over the variants; each inner match has a `_ => false` for tag
// mismatch. Plus a derived `Conform(E, Eq)`.
fn synthEnumEq(c: inout Comp, d: DeriveReq, eqN: Bind, lhsN: Bind, rhsN: Bind, boolN: Bind, eqTrait: Bind) {
    val ei: U64 = enumIndexByName(c: inout c, start: d.typeStart, len: d.typeLen)
    if ei >= c.enums.count {
        return
    }
    val variants: Array[Variant] = c.enums[ei].variants
    mut val params: Array[Param] = []
    params.append(synthParam(nameSpan: lhsN, tyStart: d.typeStart, tyLen: d.typeLen))
    params.append(synthParam(nameSpan: rhsN, tyStart: d.typeStart, tyLen: d.typeLen))
    val lhsId: U64 = c.pushExpr(e: <Expr.Ident start=lhsN.nameStart len=lhsN.nameLen />)
    val rhsId: U64 = c.pushExpr(e: <Expr.Ident start=rhsN.nameStart len=rhsN.nameLen />)
    mut val counter: U64 = 0
    mut val outerArms: Array[MatchArm] = []
    mut val vi: U64 = 0
    while vi < variants.count {
        val v: Variant = variants[vi]
        val flds: Array[FieldDef] = v.fields
        // lhs/rhs payload binds (fresh names L<n>/R<n>) + the field comparison.
        mut val lhsBinds: Array[Bind] = []
        mut val rhsBinds: Array[Bind] = []
        mut val payload: U64 = 0
        mut val firstp: Bool = true
        mut val fj: U64 = 0
        while fj < flds.count {
            val f: FieldDef = flds[fj]
            val ln: Bind = internName(c: inout c, prefix: 76, n: counter)
            counter += 1
            val rn: Bind = internName(c: inout c, prefix: 82, n: counter)
            counter += 1
            lhsBinds.append(<Bind nameStart=ln.nameStart nameLen=ln.nameLen fieldStart=f.nameStart fieldLen=f.nameLen />)
            rhsBinds.append(<Bind nameStart=rn.nameStart nameLen=rn.nameLen fieldStart=f.nameStart fieldLen=f.nameLen />)
            val li: U64 = c.pushExpr(e: <Expr.Ident start=ln.nameStart len=ln.nameLen />)
            val ri: U64 = c.pushExpr(e: <Expr.Ident start=rn.nameStart len=rn.nameLen />)
            val eqj: U64 = c.pushExpr(e: <Expr.Binary op=50 lhs=li rhs=ri />)
            if firstp {
                payload = eqj
                firstp = false
            } else {
                payload = c.pushExpr(e: <Expr.Binary op=61 lhs=payload rhs=eqj />)
            }
            fj += 1
        }
        if firstp {
            payload = synthBool(c: inout c, v: 1)
        }
        // inner match on rhs: this variant -> payload, anything else -> false.
        mut val innerArms: Array[MatchArm] = []
        innerArms.append(<MatchArm isWildcard=false enumStart=d.typeStart enumLen=d.typeLen variantStart=v.nameStart variantLen=v.nameLen binds=rhsBinds body=payload />)
        val noBinds: Array[Bind] = []
        innerArms.append(<MatchArm isWildcard=true enumStart=0 enumLen=0 variantStart=0 variantLen=0 binds=noBinds body=synthBool(c: inout c, v: 0) />)
        val innerMatch: U64 = c.pushExpr(e: <Expr.MatchExpr scrut=rhsId arms=innerArms />)
        outerArms.append(<MatchArm isWildcard=false enumStart=d.typeStart enumLen=d.typeLen variantStart=v.nameStart variantLen=v.nameLen binds=lhsBinds body=innerMatch />)
        vi += 1
    }
    val outerMatch: U64 = c.pushExpr(e: <Expr.MatchExpr scrut=lhsId arms=outerArms />)
    val ret: U64 = c.pushStmt(s: <Stmt.Return value=outerMatch hasValue=true />)
    mut val stmts: Array[U64] = []
    stmts.append(ret)
    val blkId: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    val noTP: Array[Bind] = []
    c.funcs.append(<Func nameStart=eqN.nameStart nameLen=eqN.nameLen typeParams=noTP params=params hasRet=true retStart=boolN.nameStart retLen=boolN.nameLen retIsArray=false retTy=0 body=blkId hasRecv=false recvStart=d.typeStart recvLen=d.typeLen selfInout=false selfMove=false isAssoc=true />)
    mut val wit: Array[Func] = []
    c.conforms.append(<Conform typeStart=d.typeStart typeLen=d.typeLen traitStart=eqTrait.nameStart traitLen=eqTrait.nameLen derived=true witnessed=wit />)
}

// An `<Ordering.Variant />` construction (Less/Equal/Greater) for derived Ord.
fn synthOrdering(c: inout Comp, ordN: Bind, variantN: Bind) -> U64 {
    val noFields: Array[MakeField] = []
    return c.pushExpr(e: <Expr.Make typeStart=ordN.nameStart typeLen=ordN.nameLen variantStart=variantN.nameStart variantLen=variantN.nameLen isEnum=true ty=0 fields=noFields />)
}

// A `{ return <expr> }` block (one statement), returning its block index.
fn synthReturnBlock(c: inout Comp, value: U64) -> U64 {
    val ret: U64 = c.pushStmt(s: <Stmt.Return value=value hasValue=true />)
    mut val stmts: Array[U64] = []
    stmts.append(ret)
    val blkId: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    return blkId
}

// Synthesize `@[Ord]` for a struct: `compare(lhs: T, rhs: T) -> Ordering` as a
// lexicographic field walk — `if lhs.f < rhs.f { return Less } if lhs.f > rhs.f
// { return Greater }` per field, then `return Equal`. Each `<`/`>` lowers per the
// field's type (scalar built-in; an Ord-bearing field via its compare). Plus a
// derived Conform(T, Ord). Requires `enum Ordering` in scope.
fn synthStructOrd(c: inout Comp, d: DeriveReq, cmpN: Bind, lhsN: Bind, rhsN: Bind, ordN: Bind, lessN: Bind, greaterN: Bind, equalN: Bind, ordTrait: Bind) {
    val si: U64 = structIndexByName(c: inout c, start: d.typeStart, len: d.typeLen)
    if si >= c.structs.count {
        return
    }
    val fields: Array[FieldDef] = c.structs[si].fields
    mut val params: Array[Param] = []
    params.append(synthParam(nameSpan: lhsN, tyStart: d.typeStart, tyLen: d.typeLen))
    params.append(synthParam(nameSpan: rhsN, tyStart: d.typeStart, tyLen: d.typeLen))
    val lhsId: U64 = c.pushExpr(e: <Expr.Ident start=lhsN.nameStart len=lhsN.nameLen />)
    val rhsId: U64 = c.pushExpr(e: <Expr.Ident start=rhsN.nameStart len=rhsN.nameLen />)
    mut val stmts: Array[U64] = []
    mut val fi: U64 = 0
    while fi < fields.count {
        val f: FieldDef = fields[fi]
        val lf1: U64 = c.pushExpr(e: <Expr.Field base=lhsId nameStart=f.nameStart nameLen=f.nameLen />)
        val rf1: U64 = c.pushExpr(e: <Expr.Field base=rhsId nameStart=f.nameStart nameLen=f.nameLen />)
        val lt: U64 = c.pushExpr(e: <Expr.Binary op=52 lhs=lf1 rhs=rf1 />)
        val lessBlk: U64 = synthReturnBlock(c: inout c, value: synthOrdering(c: inout c, ordN: ordN, variantN: lessN))
        stmts.append(c.pushStmt(s: <Stmt.If cond=lt thenBlk=lessBlk elseBlk=0 hasElse=false />))
        val lf2: U64 = c.pushExpr(e: <Expr.Field base=lhsId nameStart=f.nameStart nameLen=f.nameLen />)
        val rf2: U64 = c.pushExpr(e: <Expr.Field base=rhsId nameStart=f.nameStart nameLen=f.nameLen />)
        val gt: U64 = c.pushExpr(e: <Expr.Binary op=54 lhs=lf2 rhs=rf2 />)
        val grBlk: U64 = synthReturnBlock(c: inout c, value: synthOrdering(c: inout c, ordN: ordN, variantN: greaterN))
        stmts.append(c.pushStmt(s: <Stmt.If cond=gt thenBlk=grBlk elseBlk=0 hasElse=false />))
        fi += 1
    }
    stmts.append(c.pushStmt(s: <Stmt.Return value=synthOrdering(c: inout c, ordN: ordN, variantN: equalN) hasValue=true />))
    val blkId: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    val noTP: Array[Bind] = []
    c.funcs.append(<Func nameStart=cmpN.nameStart nameLen=cmpN.nameLen typeParams=noTP params=params hasRet=true retStart=ordN.nameStart retLen=ordN.nameLen retIsArray=false retTy=0 body=blkId hasRecv=false recvStart=d.typeStart recvLen=d.typeLen selfInout=false selfMove=false isAssoc=true />)
    mut val wit: Array[Func] = []
    c.conforms.append(<Conform typeStart=d.typeStart typeLen=d.typeLen traitStart=ordTrait.nameStart traitLen=ordTrait.nameLen derived=true witnessed=wit />)
}

// Synthesize all recorded `@[...]` derives (#5): `@[Eq]` (struct + enum) and
// `@[Ord]` (struct). `@[Ord]` requires `enum Ordering` in scope.
fn synthesizeDerives(c: inout Comp) {
    if c.derives.count == 0 {
        return
    }
    val eqN: Bind = internBytes(c: inout c, s: "eq")
    val lhsN: Bind = internBytes(c: inout c, s: "lhs")
    val rhsN: Bind = internBytes(c: inout c, s: "rhs")
    val boolN: Bind = internBytes(c: inout c, s: "Bool")
    val eqTrait: Bind = internBytes(c: inout c, s: "Eq")
    val cmpN: Bind = internBytes(c: inout c, s: "compare")
    val ordN: Bind = internBytes(c: inout c, s: "Ordering")
    val lessN: Bind = internBytes(c: inout c, s: "Less")
    val greaterN: Bind = internBytes(c: inout c, s: "Greater")
    val equalN: Bind = internBytes(c: inout c, s: "Equal")
    val ordTrait: Bind = internBytes(c: inout c, s: "Ord")
    mut val i: U64 = 0
    while i < c.derives.count {
        val d: DeriveReq = c.derives[i]
        if rangeEquals(bytes: c.bytes, start: d.nameStart, len: d.nameLen, kw: "Eq") {
            if d.isEnum {
                synthEnumEq(c: inout c, d: d, eqN: eqN, lhsN: lhsN, rhsN: rhsN, boolN: boolN, eqTrait: eqTrait)
            } else {
                synthStructEq(c: inout c, d: d, eqN: eqN, lhsN: lhsN, rhsN: rhsN, boolN: boolN, eqTrait: eqTrait)
            }
        }
        if rangeEquals(bytes: c.bytes, start: d.nameStart, len: d.nameLen, kw: "Ord") {
            if enumIndexByName(c: inout c, start: ordN.nameStart, len: ordN.nameLen) >= c.enums.count {
                compileErrorAt(line: lineOf(c: inout c, offset: d.nameStart), msg: "deriving `Ord` requires `enum Ordering` to be in scope")
            } else {
                if d.isEnum {
                    // enum Ord (lexicographic over tags then payloads) is deferred.
                    compileErrorAt(line: lineOf(c: inout c, offset: d.nameStart), msg: "`@[Ord]` on an enum is not yet supported (derive it on structs; enums: manual impl for now)")
                } else {
                    synthStructOrd(c: inout c, d: d, cmpN: cmpN, lhsN: lhsN, rhsN: rhsN, ordN: ordN, lessN: lessN, greaterN: greaterN, equalN: equalN, ordTrait: ordTrait)
                }
            }
        }
        i += 1
    }
}

// Enable the builtin named (nameStart,nameLen) iff it was imported from its
// correct @Std submodule. `@Std/Io` owns print/write/writeByte/readStdin/
// readFile; `@Std/Process` owns argCount/argAt. A name imported from the wrong
// module stays disabled (so `import @Std/Process with { print }` is rejected).
fn markImport(c: inout Comp, segStart: U64, segLen: U64, nameStart: U64, nameLen: U64) {
    if rangeEquals(bytes: c.bytes, start: segStart, len: segLen, kw: "Io") {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "print") { c.impPrint = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") { c.impWrite = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "writeByte") { c.impWriteByte = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") { c.impReadStdin = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") { c.impReadFile = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") { c.impReadFileBytes = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "eprint") { c.impEprint = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "fileExists") { c.impFileExists = true }
    }
    if rangeEquals(bytes: c.bytes, start: segStart, len: segLen, kw: "Process") {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") { c.impArgCount = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") { c.impArgAt = true }
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "exit") { c.impExit = true }
    }
}

// `import <path> [with { name, ... }]`. The leading `import` ident is current.
// We track the last path segment (the submodule, e.g. `Io` in `@Std/Io`) and,
// for the selective `with` list, enable each recognized (module, name) builtin.
// Only the `with { }` form binds flat names; the namespace form binds nothing
// the compiler can call bare (it would need `Io.print`, unsupported for now).
fn parseImport(c: inout Comp) {
    c.advance()
    mut val segStart: U64 = 0
    mut val segLen: U64 = 0
    while true {
        val k: Kind = c.curKind()
        match k {
            Kind.Newline => { break }
            Kind.Eof => { break }
            Kind.LBrace => { break }
            Kind.Ident => {
                if c.identIs(kw: "with") {
                    c.advance()
                    break
                }
                val t: Tok = c.cur()
                segStart = t.start
                segLen = t.len
                c.advance()
            }
            _ => { c.advance() }
        }
    }
    match c.curKind() {
        Kind.LBrace => {
            c.advance()
            while true {
                c.skipNewlines()
                val k: Kind = c.curKind()
                match k {
                    Kind.RBrace => {
                        c.advance()
                        break
                    }
                    Kind.Eof => { break }
                    Kind.Comma => { c.advance() }
                    Kind.Ident => {
                        val t: Tok = c.cur()
                        markImport(c: inout c, segStart: segStart, segLen: segLen, nameStart: t.start, nameLen: t.len)
                        c.advance()
                    }
                    _ => { c.advance() }
                }
            }
        }
        _ => {}
    }
}

fn parseProgram(c: inout Comp) {
    while true {
        c.skipNewlines()
        val k: Kind = c.curKind()
        match k {
            Kind.KwFn => { parseFunc(c: inout c) }
            Kind.KwStruct => { parseStruct(c: inout c, isUnique: false) }
            Kind.KwUnique => {
                // `unique struct ...`: consume `unique`, then the struct keyword
                // follows (parseStruct skips it). `unique` on anything else is a
                // parse no-op for now (only structs may be unique in v1).
                c.advance()
                match c.curKind() {
                    Kind.KwStruct => { parseStruct(c: inout c, isUnique: true) }
                    _ => {}
                }
            }
            Kind.KwEnum => { parseEnum(c: inout c) }
            Kind.Ident => {
                if c.identIs(kw: "import") {
                    parseImport(c: inout c)
                } else {
                    if c.identIs(kw: "impl") {
                        parseImpl(c: inout c)
                    } else {
                        if c.identIs(kw: "trait") {
                            parseTrait(c: inout c)
                        } else {
                            c.advance()
                        }
                    }
                }
            }
            Kind.Eof => { break }
            _ => {
                // `@[Eq, Ord]` derive directive (`@` lexes as Unknown, then `[`).
                if c.peekKind(off: 1) == <Kind.LBracket /> {
                    parseDirective(c: inout c)
                } else {
                    c.advance()
                }
            }
        }
    }
}

