// Part of the Plew compiler module (root: _.pw). Async lowering (spec/14):
// `async fn` -> a stackless state machine (method B, native-C). Each async fn
// becomes three C entities:
//   1. a frame struct `__af_<sel>` holding `__state`, the returned `__self`
//      promise, the `__sub` promise being awaited, and every parameter + local
//      (hoisted so values survive `await` suspensions);
//   2. a resume function `__af_<sel>_resume(void*)` whose body is the source body
//      with each `await` expanded to save-state / suspend / resume (a `goto`
//      labelled dispatch at the top re-enters at the right point);
//   3. an entry function (the fn's normal C symbol) that allocates the frame,
//      copies params, creates `__self`, runs resume once, and returns `__self`.
//
// Stage 1-2 scope: the async body is a flat statement sequence (Let / ExprStmt /
// Return / Print) with `await` only at statement head; nested control flow and
// mid-expression await are additive (stage 3). The promise value slot is a
// type-erased `long long` (scalars / () for now; String/struct results later).

// Does the program contain any `async fn`? Gates the async runtime preamble so a
// program with no async stays byte-for-byte identical (fixpoint safety).
fn hasAnyAsync(c: inout Comp) -> Bool {
    mut val i: U64 = 0
    while i < c.funcs.count {
        if c.funcs[i].isAsync {
            return true
        }
        i += 1
    }
    return false
}

// The async runtime: promises, a FIFO ready queue, a virtual-clock timer list,
// the event loop, and `sleep`. The clock is virtual (timers fire in deadline
// order, advancing a logical `now`) so ordering is deterministic and no real
// time is consumed. Emitted only when the program has an `async fn`.
fn emitAsyncRuntime(c: inout Comp) {
    if hasAnyAsync(c: inout c) {
    } else {
        return
    }
    write(s: "// ---- async runtime (event loop / promises / timers) ----\n")
    write(s: "typedef struct PlewPromise PlewPromise;\n")
    write(s: "typedef void (*PlewResumeFn)(void*);\n")
    write(s: "struct PlewPromise { int done; long long value; PlewResumeFn k; void* kframe; };\n")
    write(s: "typedef struct { PlewResumeFn fn; void* arg; } PlewTask;\n")
    write(s: "static PlewTask* plew_ready = 0; static long long plew_ready_len = 0, plew_ready_cap = 0, plew_ready_head = 0;\n")
    write(s: "static void plew_enqueue(PlewResumeFn fn, void* arg) { if (plew_ready_len == plew_ready_cap) { plew_ready_cap = plew_ready_cap ? plew_ready_cap * 2 : 16; plew_ready = (PlewTask*)realloc(plew_ready, (size_t)plew_ready_cap * sizeof(PlewTask)); } plew_ready[plew_ready_len++] = (PlewTask){fn, arg}; }\n")
    write(s: "static int plew_dequeue(PlewTask* out) { if (plew_ready_head >= plew_ready_len) { plew_ready_head = 0; plew_ready_len = 0; return 0; } *out = plew_ready[plew_ready_head++]; return 1; }\n")
    write(s: "typedef struct { long long deadline; PlewPromise* p; } PlewTimer;\n")
    write(s: "static PlewTimer* plew_timers = 0; static long long plew_timers_len = 0, plew_timers_cap = 0; static long long plew_vnow = 0;\n")
    write(s: "static PlewPromise* plew_promise_new(void) { PlewPromise* p = (PlewPromise*)malloc(sizeof(PlewPromise)); p->done = 0; p->value = 0; p->k = 0; p->kframe = 0; return p; }\n")
    write(s: "static void plew_promise_resolve(PlewPromise* p, long long v) { p->done = 1; p->value = v; if (p->k) { PlewResumeFn k = p->k; void* f = p->kframe; p->k = 0; plew_enqueue(k, f); } }\n")
    write(s: "static void plew_timer_add(long long delay, PlewPromise* p) { if (plew_timers_len == plew_timers_cap) { plew_timers_cap = plew_timers_cap ? plew_timers_cap * 2 : 8; plew_timers = (PlewTimer*)realloc(plew_timers, (size_t)plew_timers_cap * sizeof(PlewTimer)); } plew_timers[plew_timers_len].deadline = plew_vnow + delay; plew_timers[plew_timers_len].p = p; plew_timers_len++; }\n")
    write(s: "__attribute__((unused)) static PlewPromise* plew_sleep(long long ms) { PlewPromise* p = plew_promise_new(); plew_timer_add(ms, p); return p; }\n")
    write(s: "static void plew_loop_run(void) { PlewTask t; while (1) { while (plew_dequeue(&t)) { t.fn(t.arg); } if (plew_timers_len == 0) break; long long bi = -1, bd = 0; for (long long i = 0; i < plew_timers_len; i++) { if (bi < 0 || plew_timers[i].deadline < bd) { bi = i; bd = plew_timers[i].deadline; } } PlewPromise* p = plew_timers[bi].p; plew_vnow = plew_timers[bi].deadline; plew_timers[bi] = plew_timers[--plew_timers_len]; plew_promise_resolve(p, 0); } }\n")
}

// Write the frame struct name `__af_<recvprefix><selector>` for an async fn (the
// resume function appends `_resume`). Mirrors genSignature's name mangling so the
// entry/resume/await sites all agree.
fn writeAsyncFrameName(c: inout Comp, f: Func) {
    write(s: "__af_")
    if f.hasRecv {
        writeSpan(c: inout c, start: f.recvStart, len: f.recvLen)
        write(s: "_")
    }
    writeFnSelector(c: inout c, f: f)
}

// Reject async-body constructs the lowering does not handle yet. Stage 3a adds
// `if`/`while` (and the await points inside them); `for`/`match`/`give` and
// mid-expression await remain additive (stage 3b/3c). Recurses into if/while
// bodies so a rejected construct nested under them is still caught.
fn rejectAsyncUnsupported(c: inout Comp, blockId: U64) {
    val b: Block = c.blocks[blockId]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        match c.stmts[stmts[i]] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: _) => {}
            Stmt.Assign(op: _, target: _, value: _) => {}
            Stmt.ExprStmt(expr: _) => {}
            Stmt.Return(value: _, hasValue: _) => {}
            Stmt.Print(expr: _, offset: _) => {}
            Stmt.Break => {}
            Stmt.Continue => {}
            Stmt.Panic(msg: _, offset: _) => {}
            Stmt.If(cond: _, val thenBlk, val elseBlk, val hasElse) => {
                rejectAsyncUnsupported(c: inout c, blockId: thenBlk)
                if hasElse {
                    rejectAsyncUnsupported(c: inout c, blockId: elseBlk)
                }
            }
            Stmt.While(cond: _, val body) => {
                rejectAsyncUnsupported(c: inout c, blockId: body)
            }
            Stmt.Match(scrut: _, val arms) => {
                // enum match is supported; struct-destructure match is additive.
                if arms.count > 0 {
                    if arms[0].isStruct {
                        compileError(msg: "struct-destructure `match` is not yet supported inside an `async fn` (enum match is; this is additive)")
                    }
                }
                mut val ai: U64 = 0
                while ai < arms.count {
                    rejectAsyncUnsupported(c: inout c, blockId: arms[ai].body)
                    ai += 1
                }
            }
            _ => {
                compileError(msg: "this statement is not yet supported inside an `async fn` (for / give and mid-expression await are additive; if / while / match / bindings / calls / returns are supported)")
            }
        }
        i += 1
    }
}

// Recursively collect an async body's bindings into frame-struct fields (so
// every local survives `await` suspensions). Each binding gets a monotonic suffix
// (nextAsyncVar) so repeated names across sibling branches / match arms don't
// collide in the flat frame. Walks the body in the SAME DFS order as the resume
// codegen, so the suffixes line up. Recurses into if/while/match bodies.
fn collectAsyncFields(c: inout Comp, blockId: U64) {
    val b: Block = c.blocks[blockId]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        match c.stmts[stmts[i]] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                val cnum: U64 = nextAsyncVar(c: inout c)
                val le: LetEff = inferLetType(c: inout c, tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
                write(s: "    ")
                genCTypeOf(c: inout c, tyRef: le.ty, fallStart: le.start, fallLen: le.len, isArray: le.arr)
                write(s: " ")
                writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
                write(s: ";\n")
                addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: false, cnum: cnum)
            }
            Stmt.If(cond: _, val thenBlk, val elseBlk, val hasElse) => {
                collectAsyncFields(c: inout c, blockId: thenBlk)
                if hasElse {
                    collectAsyncFields(c: inout c, blockId: elseBlk)
                }
            }
            Stmt.While(cond: _, val body) => {
                collectAsyncFields(c: inout c, blockId: body)
            }
            Stmt.Match(val scrut, val arms) => {
                val scrutRef: U64 = exprType(c: inout c, id: scrut).ref
                val genericMatch: Bool = isGenericEnumInst(c: inout c, ref: scrutRef)
                mut val ai: U64 = 0
                while ai < arms.count {
                    val a: MatchArm = arms[ai]
                    if a.isWildcard {
                    } else {
                        if a.isStruct {
                            // struct-destructure match is rejected in async (below);
                            // skip its binds here (the body is never codegen'd).
                        } else {
                            collectAsyncMatchBinds(c: inout c, scrutRef: scrutRef, genericMatch: genericMatch, arm: a)
                        }
                    }
                    collectAsyncFields(c: inout c, blockId: a.body)
                    ai += 1
                }
            }
            _ => {}
        }
        i += 1
    }
}

// Collect one enum-match arm's payload binds as frame fields (mirrors the resume
// codegen's bind emission: same type lookup, same monotonic suffix order).
fn collectAsyncMatchBinds(c: inout Comp, scrutRef: U64, genericMatch: Bool, arm: MatchArm) {
    val binds: Array[Bind] = arm.binds
    mut val bi: U64 = 0
    while bi < binds.count {
        val bd: Bind = binds[bi]
        val cnum: U64 = nextAsyncVar(c: inout c)
        write(s: "    ")
        if genericMatch {
            genBindTypeInst(c: inout c, instRef: scrutRef, variantStart: arm.variantStart, variantLen: arm.variantLen, bindStart: bd.fieldStart, bindLen: bd.fieldLen)
        } else {
            genBindType(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen, bindStart: bd.fieldStart, bindLen: bd.fieldLen)
        }
        write(s: " ")
        writeNameCn(c: inout c, start: bd.nameStart, len: bd.nameLen, cnum: cnum)
        write(s: ";\n")
        if genericMatch {
            val bti: TypeInfo = genericEnumFieldTypeInfo(c: inout c, instRef: scrutRef, variantStart: arm.variantStart, variantLen: arm.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
            addLocalCn(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false, cnum: cnum)
        } else {
            addBindLocalCn(c: inout c, enumStart: arm.enumStart, enumLen: arm.enumLen, variantStart: arm.variantStart, variantLen: arm.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen, cnum: cnum)
        }
        bi += 1
    }
}

// Emit one `await operand` suspension point: stash the awaited promise, bump the
// state, suspend (register the resume continuation and return) unless it is
// already resolved, then drop the resume label. After this the awaited value is
// readable as `__f->__sub->value`.
fn emitAsyncSuspend(c: inout Comp, operandId: U64) {
    val st: U64 = c.asyncState + 1
    c.asyncState = st
    write(s: "    __f->__sub = (")
    genExpr(c: inout c, id: operandId)
    write(s: ");\n    __f->__state = ")
    writeU64(n: st)
    write(s: ";\n    if (!__f->__sub->done) { __f->__sub->k = ")
    writeAsyncFrameName(c: inout c, f: c.funcs[c.curAsyncFn])
    write(s: "_resume; __f->__sub->kframe = (void*)__f; return; }\n    __L")
    writeU64(n: st)
    write(s: ": ;\n")
}

// The next per-async-fn binding suffix (see Comp.asyncVarSeq). Frame fields and
// resume-body references both pull from this in matching DFS order.
fn nextAsyncVar(c: inout Comp) -> U64 {
    c.asyncVarSeq = c.asyncVarSeq + 1
    return c.asyncVarSeq
}

// Lower a top-level binding inside an async fn to a frame-field assignment
// `__f->name_sN = init;` (the field is declared in the frame struct). An
// `await`-initialized binding first suspends, then reads `__f->__sub->value`.
// Called from genStmt's Let arm when c.curAsync.
fn genAsyncLet(c: inout Comp, nameStart: U64, nameLen: U64, effStart: U64, effLen: U64, effArr: Bool, effTy: U64, init: U64, mutable: Bool) {
    val cnum: U64 = nextAsyncVar(c: inout c)
    match c.exprs[init] {
        Expr.Await(val operand) => {
            emitAsyncSuspend(c: inout c, operandId: operand)
            // record the local first so writeLocalCName routes the LHS to the frame.
            addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: effStart, tyLen: effLen, isArray: effArr, ty: effTy, isInout: false, isMut: mutable, owned: false, cnum: cnum)
            write(s: "    __f->")
            writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
            write(s: " = (")
            genCTypeOf(c: inout c, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: effArr)
            write(s: ")(__f->__sub->value);\n")
        }
        _ => {
            checkLitSpan(c: inout c, id: init, tyStart: effStart, tyLen: effLen, isArray: effArr)
            addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: effStart, tyLen: effLen, isArray: effArr, ty: effTy, isInout: false, isMut: mutable, owned: false, cnum: cnum)
            write(s: "    __f->")
            writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
            write(s: " = ")
            if effArr {
                genArrayValue(c: inout c, exprId: init, elemStart: effStart, elemLen: effLen)
            } else {
                genCopyValue(c: inout c, exprId: init, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: false)
            }
            write(s: ";\n")
        }
    }
}

// Lower a `return` inside an async fn: resolve `__self` with the value (a `return
// await e` first suspends), free the frame, and return from the resume function.
// Called from genStmt's Return arm when c.curAsync.
fn genAsyncReturn(c: inout Comp, value: U64, hasValue: Bool) {
    if hasValue {
        match c.exprs[value] {
            Expr.Await(val operand) => {
                emitAsyncSuspend(c: inout c, operandId: operand)
                write(s: "    plew_promise_resolve(__f->__self, (long long)(__f->__sub->value));\n")
            }
            _ => {
                write(s: "    plew_promise_resolve(__f->__self, (long long)(")
                genExpr(c: inout c, id: value)
                write(s: "));\n")
            }
        }
    } else {
        write(s: "    plew_promise_resolve(__f->__self, 0);\n")
    }
    write(s: "    free(__f);\n    return;\n")
}

// Emit the frame struct typedef + the static resume forward-decl for one async
// fn. Walks the body's top-level bindings (with locals registered so each Let's
// type infers against the prior ones) to lay out the frame fields.
fn emitAsyncFrameStruct(c: inout Comp, fi: U64) {
    val f: Func = c.funcs[fi]
    val savedLocals: Array[Local] = c.locals
    c.locals = []
    write(s: "typedef struct {\n")
    write(s: "    int __state; PlewPromise* __self; PlewPromise* __sub;\n")
    val params: Array[Param] = f.params
    mut val pi: U64 = 0
    while pi < params.count {
        val p: Param = params[pi]
        write(s: "    ")
        genCTypeOf(c: inout c, tyRef: p.ty, fallStart: p.tyStart, fallLen: p.tyLen, isArray: p.tyIsArray)
        write(s: " ")
        writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
        write(s: ";\n")
        addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: false, isMut: false, owned: false)
        pi += 1
    }
    c.asyncVarSeq = 0
    collectAsyncFields(c: inout c, blockId: f.body)
    write(s: "} ")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: ";\n")
    // static resume forward declaration.
    write(s: "static void ")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "_resume(void*);\n")
    c.locals = savedLocals
}

// Emit frame structs + resume forward-decls for every async fn. Called once,
// after the nominal type definitions and before function prototypes.
fn emitAsyncDecls(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.isAsync {
            if f.typeParams.count > 0 {
                // generic async fns are not supported yet (no instantiation path).
                compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "generic `async fn` is not yet supported")
            } else {
                if f.hasRecv {
                    // async methods need self in the frame (spec/14: self is copied
                    // or moved, never borrowed) — additive after free async fns work.
                    compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "`async fn` methods are not yet supported (only free `async fn` for now)")
                } else {
                    emitAsyncFrameStruct(c: inout c, fi: i)
                }
            }
        }
        i += 1
    }
}

// Emit the entry function + resume function for one async fn. The entry IS the
// fn's normal C symbol (so call sites are unchanged); the resume carries the
// state machine. `async fn main` keeps the C `int main(...)` shape and, after a
// single resume, drains the event loop.
fn genAsyncFunc(c: inout Comp, fi: U64) {
    val f: Func = c.funcs[fi]
    val isMain: Bool = nameIsMain(c: inout c, f: f)
    val params: Array[Param] = f.params
    // ---- entry function ----
    if isMain {
        write(s: "int main(int argc, char** argv) {\n")
        write(s: "    plew_argc = argc; plew_argv = argv;\n")
    } else {
        genSignature(c: inout c, f: f)
        write(s: " {\n")
    }
    write(s: "    ")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "* __f = (")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "*)malloc(sizeof(")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "));\n    __f->__state = 0;\n")
    mut val pi: U64 = 0
    while pi < params.count {
        val p: Param = params[pi]
        write(s: "    __f->")
        writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
        write(s: " = ")
        writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
        write(s: ";\n")
        pi += 1
    }
    // Capture __self in a local BEFORE resume: a synchronously-completing async
    // fn (no suspension) frees __f inside resume, so reading __f->__self after the
    // call would be a use-after-free. The local copy is safe.
    write(s: "    PlewPromise* __self = plew_promise_new();\n    __f->__self = __self;\n    ")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "_resume((void*)__f);\n")
    if isMain {
        write(s: "    plew_loop_run();\n    return 0;\n}\n")
    } else {
        write(s: "    return __self;\n}\n")
    }
    // ---- resume function ----
    rejectAsyncUnsupported(c: inout c, blockId: f.body)
    write(s: "static void ")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "_resume(void* __fp) {\n    ")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "* __f = (")
    writeAsyncFrameName(c: inout c, f: f)
    write(s: "*)__fp;\n")
    // count await points to emit the dispatch (state 0 falls through to the start).
    val nstates: U64 = countAsyncAwaits(c: inout c, blockId: f.body)
    if nstates > 0 {
        write(s: "    switch (__f->__state) {\n")
        mut val s: U64 = 1
        while s <= nstates {
            write(s: "        case ")
            writeU64(n: s)
            write(s: ": goto __L")
            writeU64(n: s)
            write(s: ";\n")
            s += 1
        }
        write(s: "        default: break;\n    }\n")
    }
    // body: async mode, fresh locals (params + lets registered as we emit).
    val savedLocals: Array[Local] = c.locals
    c.locals = []
    c.curAsync = true
    c.asyncState = 0
    c.asyncVarSeq = 0
    c.curAsyncFn = fi
    c.curIsMain = false
    c.curHasRecv = false
    c.curBranchBase = 0
    c.curRetVoid = true
    mut val qi: U64 = 0
    while qi < params.count {
        val p2: Param = params[qi]
        addLocal(c: inout c, nameStart: p2.nameStart, nameLen: p2.nameLen, tyStart: p2.tyStart, tyLen: p2.tyLen, isArray: p2.tyIsArray, ty: p2.ty, isInout: false, isMut: false, owned: false)
        qi += 1
    }
    genBlock(c: inout c, id: f.body)
    // fall-through end: a value-less async (e.g. `async fn main`) resolves with 0.
    write(s: "    plew_promise_resolve(__f->__self, 0);\n    free(__f);\n}\n")
    c.curAsync = false
    c.locals = savedLocals
}

// Count `await` suspension points in an async body (each is one resume state).
// Recurses into if/while bodies (stage 3a). await is at statement head (Let
// init, Return value, bare ExprStmt).
fn countAsyncAwaits(c: inout Comp, blockId: U64) -> U64 {
    val b: Block = c.blocks[blockId]
    val stmts: Array[U64] = b.stmts
    mut val n: U64 = 0
    mut val i: U64 = 0
    while i < stmts.count {
        match c.stmts[stmts[i]] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, val init) => {
                if exprIsAwait(c: inout c, id: init) {
                    n += 1
                }
            }
            Stmt.Return(val value, val hasValue) => {
                if hasValue {
                    if exprIsAwait(c: inout c, id: value) {
                        n += 1
                    }
                }
            }
            Stmt.ExprStmt(val expr) => {
                if exprIsAwait(c: inout c, id: expr) {
                    n += 1
                }
            }
            Stmt.If(cond: _, val thenBlk, val elseBlk, val hasElse) => {
                n += countAsyncAwaits(c: inout c, blockId: thenBlk)
                if hasElse {
                    n += countAsyncAwaits(c: inout c, blockId: elseBlk)
                }
            }
            Stmt.While(cond: _, val body) => {
                n += countAsyncAwaits(c: inout c, blockId: body)
            }
            Stmt.Match(scrut: _, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count {
                    n += countAsyncAwaits(c: inout c, blockId: arms[ai].body)
                    ai += 1
                }
            }
            _ => {}
        }
        i += 1
    }
    return n
}

// Is expression `id` an `await` node?
fn exprIsAwait(c: inout Comp, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Await(operand: _) => { return true }
        _ => { return false }
    }
}
