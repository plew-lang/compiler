// The array intrinsic floor (spec/15 core-library boundary): a handful of named
// `extern "plew-intrinsic"` generic functions that Core's `Array` methods call,
// each lowering to the per-element-type runtime `PlewArray_<E>_<op>`. The element
// type E is recovered from the first argument (an `Array[T]`). This is the
// irreducible array floor (cf. Swift's `Builtin` array ops); the methods on top
// (`append`, …) are pure Plew. Returns true if `(nameStart,nameLen)` named one.
fn emitArrayIntrinsic(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayPush") {
        val et: TypeInfo = typeOf(c: inout c, id: args[0].expr)
        wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
        write(s: "_push(&(")
        genExpr(c: inout c, id: args[0].expr)
        write(s: "), ")
        emitArrayElemValue(c: inout c, argExpr: args[1].expr, arrStart: et.nameStart, arrLen: et.nameLen)
        write(s: ")")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayGet") {
        val et: TypeInfo = typeOf(c: inout c, id: args[0].expr)
        wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
        write(s: "_get((")
        genExpr(c: inout c, id: args[0].expr)
        write(s: "), (long long)(")
        genExpr(c: inout c, id: args[1].expr)
        write(s: "))")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arraySet") {
        val et: TypeInfo = typeOf(c: inout c, id: args[0].expr)
        wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
        write(s: "_set(&(")
        genExpr(c: inout c, id: args[0].expr)
        write(s: "), (long long)(")
        genExpr(c: inout c, id: args[1].expr)
        write(s: "), ")
        emitArrayElemValue(c: inout c, argExpr: args[2].expr, arrStart: et.nameStart, arrLen: et.nameLen)
        write(s: ")")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayLen") {
        write(s: "((")
        genExpr(c: inout c, id: args[0].expr)
        write(s: ").count)")
        return true
    }
    return false
}

// Emit an element value being pushed/set into `Array[E]`. When the element is
// itself an `Array[X]` the value is an array (literal/value) needing the typed
// constructor; otherwise a plain expression.
fn emitArrayElemValue(c: inout Comp, argExpr: U64, arrStart: U64, arrLen: U64) {
    val aer: U64 = arrayElemRef(c: inout c, start: arrStart, len: arrLen)
    if aer != 0 {
        val arr2: U64 = resolveTy(c: inout c, tyRef: aer)
        if arr2 < c.types.count {
            val atp: TypeRef = c.types[arr2]
            if rangeEquals(bytes: c.bytes, start: atp.nameStart, len: atp.nameLen, kw: "Array") {
                if atp.args.count > 0 {
                    val xn: Bind = arrayElemNameForRef(c: inout c, elemRef: atp.args[0])
                    genArrayValue(c: inout c, exprId: argExpr, elemStart: xn.nameStart, elemLen: xn.nameLen)
                    return
                }
            }
        }
    }
    genExpr(c: inout c, id: argExpr)
}

// The raw-memory floor (spec/02): `RawBuffer[T]` intrinsics, the irreducible
// layer under `Array`. `RawBuffer[T]` lowers to a C `Tc*` whose data is preceded
// by a `[cap][rc]` header (two long longs); alloc/cap/isUnique/share/release are
// type-agnostic runtime calls (operating on the header via the void*), while the
// per-element bits (`sizeof(Tc)`, `b[i]`) are inlined here. Returns true if
// `(nameStart,nameLen)` named one.
//   rawAlloc(cap: U64, of: T) -> RawBuffer[T]   (`of` is a type witness; until
//       return-context inference lands, T comes from `of`'s type — spec/06)
//   rawLoad(b: RawBuffer[T], i: U64) -> T   rawStore(b: RawBuffer[T], i: U64, v: T)
//   rawCap(b: RawBuffer[T]) -> U64          rawIsUnique(b: RawBuffer[T]) -> Bool
fn emitRawIntrinsic(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawAlloc") {
        val et: TypeInfo = typeOf(c: inout c, id: args[1].expr)
        write(s: "(")
        emitElemCType(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
        write(s: "*)plew_rawbuf_alloc(sizeof(")
        emitElemCType(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
        write(s: "), (long long)(")
        genExpr(c: inout c, id: args[0].expr)
        write(s: "))")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawLoad") {
        write(s: "((")
        genExpr(c: inout c, id: args[0].expr)
        write(s: ")[(")
        genExpr(c: inout c, id: args[1].expr)
        write(s: ")])")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawStore") {
        write(s: "((")
        genExpr(c: inout c, id: args[0].expr)
        write(s: ")[(")
        genExpr(c: inout c, id: args[1].expr)
        write(s: ")] = (")
        genExpr(c: inout c, id: args[2].expr)
        write(s: "))")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawCap") {
        write(s: "plew_rawbuf_cap((void*)(")
        genExpr(c: inout c, id: args[0].expr)
        write(s: "))")
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawIsUnique") {
        write(s: "plew_rawbuf_is_unique((void*)(")
        genExpr(c: inout c, id: args[0].expr)
        write(s: "))")
        return true
    }
    return false
}

// Write the C element type for a `RawBuffer`/array element name (a type-parameter
// element resolves through the active mono env, like `wPA`; otherwise `genCElem`).
fn emitElemCType(c: inout Comp, elemStart: U64, elemLen: U64) {
    mut val k: U64 = 0
    while k < c.curTypeParams.count {
        val p: Bind = c.curTypeParams[k]
        if spansEqual(c: inout c, aStart: p.nameStart, aLen: p.nameLen, bStart: elemStart, bLen: elemLen) {
            emitConcreteCType(c: inout c, ref: c.curTypeArgs[k])
            return
        }
        k += 1
    }
    genCElem(c: inout c, start: elemStart, len: elemLen)
}

// Is `(nameStart,nameLen)` a raw-floor intrinsic name?
fn isRawIntrinsicName(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawAlloc") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawLoad") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawStore") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawCap") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawIsUnique") { return true }
    return false
}

// Is `(nameStart,nameLen)` an array intrinsic name (for the exprType of its
// result and the call lowering)?
fn isArrayIntrinsicName(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayPush") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayGet") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arraySet") { return true }
    if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayLen") { return true }
    return false
}

// Write the array C name `PlewArray_<elem>`. A type-parameter element name
// (`Array[T]` inside a generic instance) resolves to its concrete argument's
// mangle via the active env, so the name matches the instantiated runtime.
fn wPA(c: inout Comp, elemStart: U64, elemLen: U64) {
    mut val k: U64 = 0
    while k < c.curTypeParams.count {
        val p: Bind = c.curTypeParams[k]
        if spansEqual(c: inout c, aStart: p.nameStart, aLen: p.nameLen, bStart: elemStart, bLen: elemLen) {
            write(s: "Array_")
            emitMangle(c: inout c, ref: c.curTypeArgs[k])
            return
        }
        k += 1
    }
    write(s: "Array_")
    writeSpan(c: inout c, start: elemStart, len: elemLen)
}

// (The `Array_<E>` C struct typedef now comes from the prelude `struct Array[T]`
// via emitMonoForward/emitMonoStruct — `{ E* data; uint64_t count; }`, the same
// shape — so no hand-written array typedef is emitted here. `Array_U8` is the lone
// exception: hand-written and always present, see genU8ArrayTypedef.)

// Monomorphized array runtime for one element type, over the `RawBuffer` floor
// (cap + CoW refcount live in the buffer header, reached via `plew_rawbuf_*`).
// Order matters: _copy, _share and _unique are emitted before _set/_push, which
// call _unique to realize copy-on-write (mutate a private buffer when shared).
fn genArrayRuntimeFns(c: inout Comp, elemStart: U64, elemLen: U64) {
    // empty: a fresh 0-capacity RawBuffer (header present so cap/unique/share are
    // well-defined; the first push grows it).
    write(s: "__attribute__((unused)) static ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_new(void) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a; a.data = (")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "*)plew_rawbuf_alloc(sizeof(")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "), 0); a.count = 0; return a; }\n")

    write(s: "__attribute__((unused)) static ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_get(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a, long long i) { if (i < 0 || i >= a.count) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")

    // value-semantics deep copy: a fresh private buffer (rc=1) with the same
    // elements. Element copy is by C assignment for scalars/immutable Strings; Ref
    // elements are retained and struct elements deep-copied (so a CoW split yields
    // independent elements — required for release below to be double-free-safe).
    write(s: "__attribute__((unused)) static ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_copy(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " r; r.count = a.count; r.data = (")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "*)plew_rawbuf_alloc(sizeof(")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "), a.count); for (long long i = 0; i < a.count; i++) ")
    if structNeedsCopy(c: inout c, start: elemStart, len: elemLen) {
        write(s: "r.data[i] = ")
        writeSpan(c: inout c, start: elemStart, len: elemLen)
        write(s: "_copy(a.data[i]);")
    } else {
        if elemIsRef(c: inout c, elemStart: elemStart, elemLen: elemLen) {
            write(s: "r.data[i] = plew_ref_share(a.data[i]);")
        } else {
            write(s: "r.data[i] = a.data[i];")
        }
    }
    write(s: " return r; }\n")

    // release: drop one buffer ref. At the last reference (rc==1 before release)
    // recursively release heap-owning elements — safe because _copy is deep, so
    // each buffer's elements are uniquely owned — then free the buffer.
    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_release(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a) { if (!a.data) return; ")
    if structNeedsCopy(c: inout c, start: elemStart, len: elemLen) {
        write(s: "if (plew_rawbuf_is_unique((void*)a.data)) { for (long long i = 0; i < a.count; i++) ")
        writeSpan(c: inout c, start: elemStart, len: elemLen)
        write(s: "_release(a.data[i]); } ")
    } else {
        if elemIsRef(c: inout c, elemStart: elemStart, elemLen: elemLen) {
            write(s: "if (plew_rawbuf_is_unique((void*)a.data)) { for (long long i = 0; i < a.count; i++) if (a.data[i]) { long long* __erc = ((long long*)a.data[i]) - 1; if ((--(*__erc)) == 0) free(__erc); } } ")
        }
    }
    write(s: "plew_rawbuf_release((void*)a.data); }\n")

    // CoW share: retain and alias the same buffer (the binding gets its own ref).
    write(s: "__attribute__((unused)) static ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_share(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " a) { plew_rawbuf_share((void*)a.data); return a; }\n")

    // CoW make-unique: if the buffer is shared (not unique), replace it with a
    // private deep copy before any in-place mutation, so writes never leak across
    // bindings. Releasing the old buffer only decrements (it stays alive for the
    // other owners), so no element release here.
    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_unique(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a) { if (!plew_rawbuf_is_unique((void*)a->data)) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: " nc = ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_copy(*a); plew_rawbuf_release((void*)a->data); *a = nc; } }\n")

    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_set(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, long long i, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { if (i < 0 || i >= a->count) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_unique(a); ")
    if structNeedsCopy(c: inout c, start: elemStart, len: elemLen) {
        writeSpan(c: inout c, start: elemStart, len: elemLen)
        write(s: "_release(a->data[i]); a->data[i] = ")
        writeSpan(c: inout c, start: elemStart, len: elemLen)
        write(s: "_copy(v); }\n")
    } else {
        if elemIsRef(c: inout c, elemStart: elemStart, elemLen: elemLen) {
            write(s: "if (a->data[i]) { long long* __erc = ((long long*)a->data[i]) - 1; if ((--(*__erc)) == 0) free(__erc); } a->data[i] = plew_ref_share(v); }\n")
        } else {
            write(s: "a->data[i] = v; }\n")
        }
    }

    write(s: "__attribute__((unused)) static void ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_push(")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "* a, ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: " v) { ")
    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
    write(s: "_unique(a); if (a->count >= (long long)plew_rawbuf_cap((void*)a->data)) { long long __cap = (long long)plew_rawbuf_cap((void*)a->data); long long nc = __cap < 4 ? 4 : __cap * 2; ")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "* nd = (")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "*)plew_rawbuf_alloc(sizeof(")
    genCElem(c: inout c, start: elemStart, len: elemLen)
    write(s: "), nc); for (long long i = 0; i < a->count; i++) nd[i] = a->data[i]; plew_rawbuf_release((void*)a->data); a->data = nd; } a->data[a->count] = ")
    if structNeedsCopy(c: inout c, start: elemStart, len: elemLen) {
        writeSpan(c: inout c, start: elemStart, len: elemLen)
        write(s: "_copy(v)")
    } else {
        if elemIsRef(c: inout c, elemStart: elemStart, elemLen: elemLen) {
            write(s: "plew_ref_share(v)")
        } else {
            write(s: "v")
        }
    }
    write(s: "; a->count++; }\n")
}

fn isU8Elem(c: inout Comp, elemStart: U64, elemLen: U64) -> Bool {
    return rangeEquals(bytes: c.bytes, start: elemStart, len: elemLen, kw: "U8")
}

// Is the array element a `Ref[T]` (a refcounted box)? Such an element is ARC'd:
// the array retains it on copy/store and releases it at scope exit, so it is not
// freed while the array still references it (and is freed when the last owner
// drops). Deep release of a heap-owning pointee is a further refinement.
fn elemIsRef(c: inout Comp, elemStart: U64, elemLen: U64) -> Bool {
    val er: U64 = arrayElemRef(c: inout c, start: elemStart, len: elemLen)
    if er == 0 {
        return false
    }
    return isRefInst(c: inout c, ref: er)
}

// Whether an array element entry should be skipped by the runtime-emit loop:
// U8 (its runtime is hand-written) or a bare type-parameter name (`Array[T]` in
// a generic template — only its concrete instantiations get a runtime).
fn skipArrayElem(c: inout Comp, ae: Bind) -> Bool {
    if isU8Elem(c: inout c, elemStart: ae.nameStart, elemLen: ae.nameLen) {
        return true
    }
    if isTypeParamName(c: inout c, start: ae.nameStart, len: ae.nameLen) {
        return true
    }
    // a non-ground compound element (`Pair[K,V]` recorded from a generic struct's
    // `Array[Pair[K,V]]` field template): only its ground instantiations
    // (`Pair[I64,I64]`) get a runtime. The mangled name (`Pair_K_V`) is not a bare
    // type-param name, so check the recorded element ref for residual type params.
    if ae.fieldStart != 0 {
        if tyRefIsGround(c: inout c, ref: ae.fieldStart) {
        } else {
            return true
        }
    }
    return false
}

// Array_U8 is always available (String.bytes yields it) and is emitted with
// literal text so it needs no source span for "U8". Same RawBuffer-backed shape
// as the generated element runtime: cap + rc live in the buffer header.
fn genU8ArrayTypedef() {
    write(s: "typedef struct { unsigned char* data; long long count; } Array_U8;\n")
}

fn genU8ArrayRuntime() {
    write(s: "__attribute__((unused)) static Array_U8 Array_U8_new(void) { Array_U8 a; a.data = (unsigned char*)plew_rawbuf_alloc(sizeof(unsigned char), 0); a.count = 0; return a; }\n")
    write(s: "__attribute__((unused)) static unsigned char Array_U8_get(Array_U8 a, long long i) { if (i < 0 || i >= a.count) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } return a.data[i]; }\n")
    write(s: "__attribute__((unused)) static Array_U8 Array_U8_copy(Array_U8 a) { Array_U8 r; r.count = a.count; r.data = (unsigned char*)plew_rawbuf_alloc(sizeof(unsigned char), a.count); for (long long i = 0; i < a.count; i++) r.data[i] = a.data[i]; return r; }\n")
    write(s: "__attribute__((unused)) static void Array_U8_release(Array_U8 a) { if (!a.data) return; plew_rawbuf_release((void*)a.data); }\n")
    write(s: "__attribute__((unused)) static Array_U8 Array_U8_share(Array_U8 a) { plew_rawbuf_share((void*)a.data); return a; }\n")
    write(s: "__attribute__((unused)) static void Array_U8_unique(Array_U8* a) { if (!plew_rawbuf_is_unique((void*)a->data)) { Array_U8 nc = Array_U8_copy(*a); plew_rawbuf_release((void*)a->data); *a = nc; } }\n")
    write(s: "__attribute__((unused)) static void Array_U8_set(Array_U8* a, long long i, unsigned char v) { if (i < 0 || i >= a->count) { fprintf(stderr, \"panic: index out of range\\n\"); exit(1); } Array_U8_unique(a); a->data[i] = v; }\n")
    write(s: "__attribute__((unused)) static void Array_U8_push(Array_U8* a, unsigned char v) { Array_U8_unique(a); if (a->count >= (long long)plew_rawbuf_cap((void*)a->data)) { long long __cap = (long long)plew_rawbuf_cap((void*)a->data); long long nc = __cap < 4 ? 4 : __cap * 2; unsigned char* nd = (unsigned char*)plew_rawbuf_alloc(sizeof(unsigned char), nc); for (long long i = 0; i < a->count; i++) nd[i] = a->data[i]; plew_rawbuf_release((void*)a->data); a->data = nd; } a->data[a->count] = v; a->count++; }\n")
}

