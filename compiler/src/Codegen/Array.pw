// @Codegen/Array — name predicates for the array and raw-buffer intrinsic floor
// (spec/15 core-library boundary): the small set of `extern "plew-intrinsic"`
// operations Core's `Array`/`RawBuffer` methods call. A DAG-bottom leaf module
// (`Ir ← Codegen/Array`) imported by the front-end's type recovery — it only
// reads name spans, so it depends on nothing but the shared IR and the lexer's
// `rangeEquals`.

import @Std/Syntax with { rangeEquals }
import ../Ir with { Comp }

// Is `(nameStart,nameLen)` a raw-floor intrinsic name?
export fn isRawIntrinsicName(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "rawAlloc") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "rawLoad") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "rawStore") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "rawCap") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "rawIsUnique") { return true }
    return false
}

// Is `(nameStart,nameLen)` an array intrinsic name (for the exprType of its
// result and the call lowering)?
export fn isArrayIntrinsicName(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "arrayPush") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "arrayGet") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "arraySet") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: nameStart, len: nameLen, kw: "arrayLen") { return true }
    return false
}
