// Part of monomorphization (root: _.pw): call-site / closure-capture
// registration and instance scanning.

// Walk an expression, registering any generic free function calls it contains
// (args before self, so a nested generic call is registered before the outer one
// whose argument type may depend on it).
// Can an enclosing local of this shape be value-captured? Scalars, String,
// arrays, Ref, and plain (non-unique, non-generic) structs can: an immutable
// `val` value-captured is observationally identical to a reference capture, and
// heap-owning captures are retained into the env (then leaked). A `unique` type
// (no copy), a generic instantiation (per-inst share machinery), an enum, or a
// function-typed capture are not supported yet.
fn captureSupported(c: inout Comp, lo: Local) -> Bool {
    if lo.isArray {
        return true
    }
    if isPrimType(c: inout c, start: lo.tyStart, len: lo.tyLen) {
        return true
    }
    if rangeEquals(bytes: c.arena.bytes, start: lo.tyStart, len: lo.tyLen, kw: "String") {
        return true
    }
    if rangeEquals(bytes: c.arena.bytes, start: lo.tyStart, len: lo.tyLen, kw: "Ref") {
        return true
    }
    val si: U64 = c.structIndexByName(start: lo.tyStart, len: lo.tyLen)
    if si < c.arena.structs.count {
        if c.arena.structs[si].isUnique {
            return false
        }
        if c.arena.structs[si].typeParams.count > 0 {
            return false
        }
        return true
    }
    return false
}

// Record that the active closure captures the enclosing local at `localIdx`.
// Dedup per (closure, name). v1: value-capture of immutable values — a `mut val`
// (needs shared reference semantics) and unsupported shapes (unique / generic
// instantiation / enum / function value) are rejected loudly (no silent meaning
// loss; mutable reference capture is additive later).
fn recordCapture(c: inout Comp, closureId: U64, localIdx: U64) {
    val lo: Local = c.cur.locals[localIdx]
    mut val i: U64 = 0
    while i < c.monoWork.captures.count {
        val e: CaptureEntry = c.monoWork.captures[i]
        if e.closureId == closureId {
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: lo.nameStart, bLen: lo.nameLen) {
                return
            }
        }
        i += 1
    }
    mut val boxed: Bool = false
    if lo.isMut {
        // a mutable capture must share storage (reference capture). v1 boxes only
        // scalar (`mut val`) cells; mutable non-scalar capture is additive later.
        // (an array's type span names its element, so guard isArray explicitly.)
        if lo.isArray {
            compileErrorAt(line: lineOf(c: inout c, offset: lo.nameStart), msg: "capturing a mutable non-scalar value (`mut val` array/struct/string) in a closure is not yet supported")
        } else {
            if isPrimType(c: inout c, start: lo.tyStart, len: lo.tyLen) {
                boxed = true
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: lo.nameStart), msg: "capturing a mutable non-scalar value (`mut val` array/struct/string) in a closure is not yet supported")
            }
        }
    } else {
        if !(captureSupported(c: inout c, lo: lo)) {
            compileErrorAt(line: lineOf(c: inout c, offset: lo.nameStart), msg: "capturing this value (unique / generic / enum / function) in a closure is not yet supported")
        }
    }
    c.monoWork.captures.append(<CaptureEntry closureId=closureId nameStart=lo.nameStart nameLen=lo.nameLen tyStart=lo.tyStart tyLen=lo.tyLen isArray=lo.isArray ty=lo.ty boxed=boxed />)
}

// Optional chaining over a NON-Optional `Chain` type (spec/12): rewrite the
// `base?.member` node in place into the trait desugar so the rest of the pipeline
// (instance discovery, verify, backend) sees only ordinary nodes — `?.` is not
// special-cased to `Optional` (the backend keeps an inlined fast path for the
// Optional identity case, an observable-equivalent optimization). With `base: R`
// (head `Rh`, `R: Chain`):
//
//   match base.chain() {                              // chain() -> Optional[Value]
//       Optional.Some(v: val __chainVal) => <Rh.fromValue value=__chainVal.member />
//       Optional.None                     => <Rh.empty />
//   }
//
// `Rh.fromValue`/`Rh.empty` are assoc-fn (factory) calls; their type args are
// inferred from the member value (so the result is `Rh[U]`, U = member's type).
// Runs inside the scope-aware Mono walk because typeOf(base) needs the local env.
fn rewriteOptChainToChainMatch(c: inout Comp, exprId: U64, base: U64, memberStart: U64, memberLen: U64, headStart: U64, headLen: U64) {
    val chainN: Bind = internBytes(c: inout c, s: "chain")
    val fromValueN: Bind = internBytes(c: inout c, s: "fromValue")
    val emptyN: Bind = internBytes(c: inout c, s: "empty")
    val optN: Bind = internBytes(c: inout c, s: "Optional")
    val someN: Bind = internBytes(c: inout c, s: "Some")
    val noneN: Bind = internBytes(c: inout c, s: "None")
    val vFieldN: Bind = internBytes(c: inout c, s: "v")
    val cvN: Bind = internBytes(c: inout c, s: "__chainVal")
    val valueN: Bind = internBytes(c: inout c, s: "value")
    // scrutinee: base.chain()
    val noArgs: Array[Arg] = []
    val scrut: U64 = c.pushExpr(e: <Expr.Method recv=base nameStart=chainN.nameStart nameLen=chainN.nameLen args=noArgs />)
    // Some(v: val __chainVal) => <Head.fromValue value=__chainVal.member />
    val fromRecv: U64 = c.pushExpr(e: <Expr.Ident start=headStart len=headLen />)
    val cvRef: U64 = c.pushExpr(e: <Expr.Ident start=cvN.nameStart len=cvN.nameLen />)
    val memberField: U64 = c.pushExpr(e: <Expr.Field base=cvRef nameStart=memberStart nameLen=memberLen />)
    mut val fromArgs: Array[Arg] = []
    fromArgs.append(value: <Arg expr=memberField isInout=false labelStart=valueN.nameStart labelLen=valueN.nameLen hasLabel=true />)
    val fromCall: U64 = c.pushExpr(e: <Expr.Method recv=fromRecv nameStart=fromValueN.nameStart nameLen=fromValueN.nameLen args=fromArgs />)
    mut val someStmts: Array[U64] = []
    someStmts.append(value: c.pushStmt(s: <Stmt.Give value=fromCall />))
    val someBlk: U64 = c.arena.blocks.count
    c.arena.blocks.append(value: <Block stmts=someStmts />)
    mut val someBinds: Array[Bind] = []
    someBinds.append(value: <Bind nameStart=cvN.nameStart nameLen=cvN.nameLen nameId=cvN.nameId fieldStart=vFieldN.nameStart fieldLen=vFieldN.nameLen offset=memberStart />)
    val someArm: MatchArm = <MatchArm isWildcard=false enumStart=optN.nameStart enumLen=optN.nameLen variantStart=someN.nameStart variantLen=someN.nameLen binds=someBinds body=someBlk isStruct=false isDiverge=false />
    // None => <Head.empty />
    val emptyRecv: U64 = c.pushExpr(e: <Expr.Ident start=headStart len=headLen />)
    val emptyCall: U64 = c.pushExpr(e: <Expr.Method recv=emptyRecv nameStart=emptyN.nameStart nameLen=emptyN.nameLen args=noArgs />)
    mut val noneStmts: Array[U64] = []
    noneStmts.append(value: c.pushStmt(s: <Stmt.Give value=emptyCall />))
    val noneBlk: U64 = c.arena.blocks.count
    c.arena.blocks.append(value: <Block stmts=noneStmts />)
    val noBinds: Array[Bind] = []
    val noneArm: MatchArm = <MatchArm isWildcard=false enumStart=optN.nameStart enumLen=optN.nameLen variantStart=noneN.nameStart variantLen=noneN.nameLen binds=noBinds body=noneBlk isStruct=false isDiverge=false />
    mut val arms: Array[MatchArm] = []
    arms.append(value: someArm)
    arms.append(value: noneArm)
    c.arena.exprs[exprId] = <Expr.MatchExpr scrut=scrut arms=arms />
}

// Register the instances the Chain desugar needs that aren't reachable by argument
// inference: the result type `Head[U]` (so its struct/enum + methods are emitted)
// and the `empty()` factory's monomorphized instance keyed by [U] (empty takes no
// argument, so its type param can only come from the result type's context).
fn registerChainResultInsts(c: inout Comp, exprId: U64, baseRef: U64, memberStart: U64, memberLen: U64, headStart: U64, headLen: U64) {
    if baseRef >= c.arena.types.count {
        return
    }
    if c.arena.types[baseRef].args.count < 1 {
        return
    }
    val vRef: U64 = c.arena.types[baseRef].args[0]
    val vInfo: TypeInfo = c.typeInfoOfRef(ref: vRef)
    val uInfo: TypeInfo = c.fieldType(structStart: vInfo.nameStart, structLen: vInfo.nameLen, fieldStart: memberStart, fieldLen: memberLen)
    mut val uRef: U64 = uInfo.ref
    if uRef == 0 {
        val noTArgs: Array[U64] = []
        uRef = c.pushType(t: <TypeRef nameStart=uInfo.nameStart nameLen=uInfo.nameLen args=noTArgs />)
    }
    mut val oArgs: Array[U64] = []
    oArgs.append(value: uRef)
    val oRef: U64 = c.pushType(t: <TypeRef nameStart=headStart nameLen=headLen args=oArgs />)
    c.scanType(ref: oRef)
    // record this chain stage's result type `Head[U]` so typeOf/exprTypeRef on the
    // rewritten MatchExpr recover it (a nested `a?.x?.y` types its inner stage).
    c.decls.chainResults.append(value: <Bind nameStart=exprId nameLen=0 fieldStart=oRef fieldLen=0 />)
    // the chain() result `Optional[V]` (V = the receiver's chain Value = its first
    // type arg): register the concrete instance so the desugar's `match base.chain()`
    // sets the enum env and types the Some-payload bind (the front-end method-result
    // typeOf can recover only the ungrounded `Optional[T]` template otherwise).
    val optN: Bind = internBytes(c: inout c, s: "Optional")
    mut val optArgs: Array[U64] = []
    optArgs.append(value: vRef)
    val optVRef: U64 = c.pushType(t: <TypeRef nameStart=optN.nameStart nameLen=optN.nameLen args=optArgs />)
    c.scanType(ref: optVRef)
    // registering the result `Head[U]` pulls in its own `chain()`, whose body builds
    // `Optional[U]`; register that too (U may differ from V — `Head[U]` vs receiver
    // `Head[V]`).
    mut val optUArgs: Array[U64] = []
    optUArgs.append(value: uRef)
    val optURef: U64 = c.pushType(t: <TypeRef nameStart=optN.nameStart nameLen=optN.nameLen args=optUArgs />)
    c.scanType(ref: optURef)
    // both factories monomorphize to `Head[U]`: `empty()` has no argument, and the
    // `fromValue(value:)` argument is the synthesized `__chainVal.member` whose type
    // the argument-inference path can't recover (a fresh match-bound place), so
    // register both instances explicitly keyed by [U].
    registerChainFactoryInst(c: inout c, headStart: headStart, headLen: headLen, name: "empty", uRef: uRef)
    registerChainFactoryInst(c: inout c, headStart: headStart, headLen: headLen, name: "fromValue", uRef: uRef)
}

// Register `Head.<name>` (a Chain factory) monomorphized at [uRef].
fn registerChainFactoryInst(c: inout Comp, headStart: U64, headLen: U64, name: String, uRef: U64) {
    val fi: U64 = findAssocByName(c: inout c, recvStart: headStart, recvLen: headLen, name: name)
    if fi >= c.arena.funcs.count {
        return
    }
    if !(c.isGenericFreeFn(fi: fi)) {
        return
    }
    mut val fArgs: Array[U64] = []
    fArgs.append(value: uRef)
    if !(c.fnInstExists(fnIdx: fi, args: fArgs)) {
        c.monoWork.fnInsts.append(<FnInst fnIdx=fi args=fArgs />)
    }
}

// The c.arena.funcs index of an assoc fn `Head.name` (no self), by name only — used to
// register a Chain factory instance whose type args can't be inferred from the call.
export fn findAssocByName(c: inout Comp, recvStart: U64, recvLen: U64, name: String) -> U64 {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val nm: Bind = internBytes(c: inout c, s: name)
    val qName: U64 = intern(c: inout c, start: nm.nameStart, len: nm.nameLen)
    mut val i: U64 = 0
    while i < c.arena.funcs.count {
        val f: Func = c.arena.funcs[i]
        if !(f.hasRecv) {
            if f.recvId == qRecv {
                if f.nameId == qName {
                    return i
                }
            }
        }
        i += 1
    }
    return c.arena.funcs.count
}

fn scanExprInsts(c: inout Comp, exprId: U64) {
    match c.arena.exprs[exprId] {
        Expr.Ident(val start, val len) => {
            // capture detection: inside a closure, an identifier that resolves to
            // a local below the closure's entry mark is an enclosing capture.
            if c.cur.inClosure {
                val li: U64 = c.localIndexByName(start: start, len: len)
                if li < c.cur.captureMark {
                    // a module-level variable (spec/15) seeded at the locals base
                    // (index < globals.count) is globally accessible — not a capture.
                    if li >= c.arena.globals.count {
                        recordCapture(c: inout c, closureId: c.cur.closureId, localIdx: li)
                    }
                }
            }
        }
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
            // a closure literal lexically inside another closure body: the inner
            // env construction would have to reach the outer env, which is not
            // wired yet — reject loudly rather than miscompile.
            if c.cur.inClosure {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: exprId)), msg: "nested closures are not yet supported")
            }
            // walk the body with the closure's own scope so enclosing references
            // become captures. Save/restore the capture context (single-level;
            // nested closures keep their own mark).
            val savedId: U64 = c.cur.closureId
            val savedIn: Bool = c.cur.inClosure
            val savedMark: U64 = c.cur.captureMark
            val enclMark: U64 = c.scopeMark()
            c.cur.closureId = exprId
            c.cur.inClosure = true
            c.cur.captureMark = enclMark
            mut val pi: U64 = 0
            while pi < params.count {
                val p: Param = params[pi]
                c.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                pi += 1
            }
            scanBlockInsts(c: inout c, blkId: body)
            c.popLocals(mark: enclMark)
            c.cur.closureId = savedId
            c.cur.inClosure = savedIn
            c.cur.captureMark = savedMark
        }
        Expr.Unary(val op, val operand) => { scanExprInsts(c: inout c, exprId: operand) }
        Expr.Binary(val op, val lhs, val rhs) => {
            scanExprInsts(c: inout c, exprId: lhs)
            scanExprInsts(c: inout c, exprId: rhs)
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            mut val i: U64 = 0
            while i < args.count {
                scanExprInsts(c: inout c, exprId: args[i].expr)
                i += 1
            }
            c.registerCallInst(id: exprId, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.ExtMethod(val recv, srcStart: _, srcLen: _, nameStart: _, nameLen: _, val args) => {
            scanExprInsts(c: inout c, exprId: recv)
            mut val i: U64 = 0
            while i < args.count {
                scanExprInsts(c: inout c, exprId: args[i].expr)
                i += 1
            }
        }
        Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
            scanExprInsts(c: inout c, exprId: recv)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            scanExprInsts(c: inout c, exprId: recv)
            mut val i: U64 = 0
            while i < args.count {
                scanExprInsts(c: inout c, exprId: args[i].expr)
                i += 1
            }
            c.registerMethodInst(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
            // an assoc-fn call `Type.make(args)` (type-name receiver): register its
            // monomorphized instance through the free-fn machinery (no self).
            c.registerAssocInst(recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
            // register the call's result type: a combinator on a generic receiver
            // (`mapIter.filter(p)`) yields a new adapter instantiation
            // (`FilterIter[MapIter[…],…]`) that no field/signature scan reaches, so
            // its typedef + methods (and the provided method's reachability) depend
            // on registering it here.
            val mrt: TypeInfo = typeOf(c: inout c, id: exprId)
            if mrt.ref != 0 {
                c.scanType(ref: mrt.ref)
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => { scanExprInsts(c: inout c, exprId: base) }
        Expr.Index(val base, val index) => {
            scanExprInsts(c: inout c, exprId: base)
            scanExprInsts(c: inout c, exprId: index)
        }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            mut val i: U64 = 0
            while i < fields.count {
                scanExprInsts(c: inout c, exprId: fields[i].value)
                i += 1
            }
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count {
                scanExprInsts(c: inout c, exprId: elems[i])
                i += 1
            }
        }
        Expr.Cast(val operand, val tyStart, val tyLen, val ty) => { scanExprInsts(c: inout c, exprId: operand) }
        Expr.OptChain(val base, val memberStart, val memberLen) => {
            scanExprInsts(c: inout c, exprId: base)
            // a non-Optional `Chain` receiver: rewrite to the trait desugar (a match
            // over `base.chain()` with `fromValue`/`empty`) and scan the new tree so
            // its method/assoc instances are discovered. Optional keeps the backend
            // fast path (an observable-equivalent inlining, not a special case).
            val bt: TypeInfo = typeOf(c: inout c, id: base)
            if bt.kind == 2 {
                if !(rangeEquals(bytes: c.arena.bytes, start: bt.nameStart, len: bt.nameLen, kw: "Optional")) {
                    val chN: Bind = internBytes(c: inout c, s: "chain")
                    if c.typeHasMethodNamed(recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: chN.nameStart, nameLen: chN.nameLen) {
                        rewriteOptChainToChainMatch(c: inout c, exprId: exprId, base: base, memberStart: memberStart, memberLen: memberLen, headStart: bt.nameStart, headLen: bt.nameLen)
                        scanExprInsts(c: inout c, exprId: exprId)
                        // the result `Head[U]` and the no-arg `empty()` factory's
                        // instance can't be inferred from arguments (empty has none),
                        // so register them explicitly: U = member's type on the chain
                        // Value (the receiver's first type arg, by the v1 assumption
                        // that `type Value` is the first type parameter).
                        registerChainResultInsts(c: inout c, exprId: exprId, baseRef: bt.ref, memberStart: memberStart, memberLen: memberLen, headStart: bt.nameStart, headLen: bt.nameLen)
                        return
                    }
                }
            }
            // register the Optional[U] result so its C struct is emitted.
            val rr: U64 = c.optChainResultRef(base: base, memberStart: memberStart, memberLen: memberLen)
            if rr != 0 {
                c.scanType(ref: rr)
            }
        }
        Expr.Try(val expr) => { scanExprInsts(c: inout c, exprId: expr) }
        Expr.Arrow(val base, val nameStart, val nameLen) => { scanExprInsts(c: inout c, exprId: base) }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            scanExprInsts(c: inout c, exprId: cond)
            scanBlockInsts(c: inout c, blkId: thenBlk)
            scanBlockInsts(c: inout c, blkId: elseBlk)
        }
        Expr.MatchExpr(val scrut, val arms) => {
            scanExprInsts(c: inout c, exprId: scrut)
            mut val ai: U64 = 0
            while ai < arms.count {
                val a: MatchArm = arms[ai]
                val mark: U64 = c.scopeMark()
                scanAddArmBinds(c: inout c, a: a, scrutTi: typeOf(c: inout c, id: scrut))
                scanBlockInsts(c: inout c, blkId: a.body)
                c.popLocals(mark: mark)
                ai += 1
            }
        }
        Expr.Move(val operand, val isBorrow) => { scanExprInsts(c: inout c, exprId: operand) }
        _ => {}
    }
}

// Add a match arm's field binds to the local scope (for type recovery during the
// instance-collection walk; mirrors codegen's addBindLocal, minus emission).
fn scanAddArmBinds(c: inout Comp, a: MatchArm, scrutTi: TypeInfo) {
    // a struct-destructure arm `S { val x }`: bind each field from the scrutinee
    // struct (mirrors codegen's addForStructBinds), so a generic call on a bound
    // field (`print(items.count)`) recovers its type.
    if a.isStruct {
        addForStructBinds(c: inout c, et: scrutTi, binds: a.binds)
        return
    }
    val genericMatch: Bool = c.isGenericEnumInst(ref: scrutTi.ref)
    mut val bi: U64 = 0
    while bi < a.binds.count {
        val bd: Bind = a.binds[bi]
        if genericMatch {
            val bti: TypeInfo = c.genericEnumFieldTypeInfo(instRef: scrutTi.ref, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
            c.addLocal(nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false)
        } else {
            c.addBindLocal(enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
        }
        bi += 1
    }
}

// Walk a statement, registering generic free function calls and maintaining the
// local scope for type recovery (mirrors codegen's binding management).
fn scanStmtInsts(c: inout Comp, stmtId: U64) {
    match c.arena.stmts[stmtId] {
        Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
            scanExprInsts(c: inout c, exprId: init)
            // register the local with its EFFECTIVE type (inferred when there is no
            // annotation), mirroring codegen — otherwise a later `p.x` on an
            // inferred-typed `val p = <P …/>` can't recover its type, so a generic
            // call like `print(p.x + p.y)` fails to discover its instantiation.
            val le: LetEff = inferLetType(c: inout c, tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
            c.addLocal(nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: true)
        }
        Stmt.Assign(val op, val target, val value) => {
            scanExprInsts(c: inout c, exprId: target)
            scanExprInsts(c: inout c, exprId: value)
        }
        Stmt.ExprStmt(val expr) => { scanExprInsts(c: inout c, exprId: expr) }
        Stmt.Return(val value, val hasValue, offset: _) => {
            if hasValue {
                scanExprInsts(c: inout c, exprId: value)
            }
        }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            scanExprInsts(c: inout c, exprId: cond)
            scanBlockInsts(c: inout c, blkId: thenBlk)
            if hasElse {
                scanBlockInsts(c: inout c, blkId: elseBlk)
            }
        }
        Stmt.While(val cond, val body) => {
            scanExprInsts(c: inout c, exprId: cond)
            scanBlockInsts(c: inout c, blkId: body)
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            val forMark: U64 = c.scopeMark()
            scanExprInsts(c: inout c, exprId: iter)
            if isRange {
                scanExprInsts(c: inout c, exprId: rangeHi)
                // type the loop var so generic calls on it in the body (`print(i)`)
                // ground: the annotation if given, else the bound's own type.
                mut val rtS: U64 = varTyStart
                mut val rtL: U64 = varTyLen
                if rtL == 0 {
                    val bt: TypeInfo = typeOf(c: inout c, id: rangeHi)
                    if bt.kind == 0 {
                        rtS = bt.nameStart
                        rtL = bt.nameLen
                    }
                }
                c.addLocal(nameStart: varStart, nameLen: varLen, tyStart: rtS, tyLen: rtL, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
            } else {
                val et: TypeInfo = typeOf(c: inout c, id: iter)
                if isStruct {
                    addForStructBinds(c: inout c, et: et, binds: binds)
                } else {
                    if et.kind == 3 {
                        c.addLocal(nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                    } else {
                        val elemTi: TypeInfo = c.iterableItemInfo(et: et)
                        c.addLocal(nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                    }
                }
            }
            scanBlockInsts(c: inout c, blkId: body)
            c.popLocals(mark: forMark)
        }
        Stmt.Match(val scrut, val arms) => {
            scanExprInsts(c: inout c, exprId: scrut)
            mut val ai: U64 = 0
            while ai < arms.count {
                val a: MatchArm = arms[ai]
                val mark: U64 = c.scopeMark()
                scanAddArmBinds(c: inout c, a: a, scrutTi: typeOf(c: inout c, id: scrut))
                scanBlockInsts(c: inout c, blkId: a.body)
                c.popLocals(mark: mark)
                ai += 1
            }
        }
        Stmt.Panic(val msg, val offset) => { scanExprInsts(c: inout c, exprId: msg) }
        Stmt.Give(val value) => { scanExprInsts(c: inout c, exprId: value) }
        Stmt.Break(offset: _) => {}
        Stmt.Continue(offset: _) => {}
    }
}

// Walk a block (its own local scope), registering generic free function calls.
fn scanBlockInsts(c: inout Comp, blkId: U64) {
    val mark: U64 = c.scopeMark()
    val stmts: Array[U64] = c.arena.blocks[blkId].stmts
    mut val i: U64 = 0
    while i < stmts.count {
        scanStmtInsts(c: inout c, stmtId: stmts[i])
        i += 1
    }
    c.popLocals(mark: mark)
}

// Discover concrete instantiations of generic free functions by walking each
// non-generic function's body with its local scope reconstructed (params, lets,
// for/match binds) so argument types recover. Generic templates are skipped
// (their body types are unresolved — transitive instantiation is deferred).
// A generic-receiver method body (`Dictionary[String,U64].insert`) is emitted per
// receiver instantiation (emitMonoMethods), but its body may call another generic
// method/fn (`key.hash[H]` -> `String.hash[SipHasher]`) whose instance no signature
// scan reaches. Walk every such body once per receiver instantiation, under the
// same env emitMonoMethod uses (type params -> the receiver's args, Self/Item set),
// so the nested instances register; the transitive worklist in collectFnInsts then
// scans them. `Array[E]` user methods are emitted by the Array-specific path
// (emitArrayMethods, keyed off kind-3 receivers), not emitMonoMethods — scanning
// them here would mis-ground `self` and register `Array_T_*`, so they are skipped.
fn scanGenInstMethodBodies(c: inout Comp) {
    mut val gi: U64 = 0
    while gi < c.monoWork.genInsts.count {
        val instRef: U64 = c.monoWork.genInsts[gi]
        val inst: TypeRef = c.arena.types[instRef]
        if rangeEquals(bytes: c.arena.bytes, start: inst.nameStart, len: inst.nameLen, kw: "Array") {
            gi += 1
        } else {
            mut val mfi: U64 = 0
            while mfi < c.arena.funcs.count {
                val mf: Func = c.arena.funcs[mfi]
                if c.methodMatchesInst(f: mf, instRef: instRef) {
                    // provided combinators (`map[B]`) instantiate from call sites, not here.
                    if !(mf.isProvided) {
                        if mf.body != 0 {
                            c.cur.locals = []
                            c.seedGlobalLocals()
                            c.cur.hasRecv = true
                            c.cur.recvStart = mf.recvStart
                            c.cur.recvLen = mf.recvLen
                            c.cur.selfInout = mf.selfInout
                            c.cur.recvInstRef = instRef
                            c.cur.typeParams = mf.typeParams
                            c.cur.typeArgs = inst.args
                            c.setSelfItemEnv(recvStart: mf.recvStart, recvLen: mf.recvLen, recvInstRef: instRef)
                            mut val pi: U64 = 0
                            while pi < mf.params.count {
                                val p: Param = mf.params[pi]
                                c.addLocal(nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                                pi += 1
                            }
                            scanBlockInsts(c: inout c, blkId: mf.body)
                            c.clearSelfItemEnv()
                        }
                    }
                }
                mfi += 1
            }
            gi += 1
        }
    }
    val noP: Array[Bind] = []
    val noA: Array[U64] = []
    c.cur.locals = []
    c.cur.hasRecv = false
    c.cur.recvInstRef = 0
    c.cur.typeParams = noP
    c.cur.typeArgs = noA
}

