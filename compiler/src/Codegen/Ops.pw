// Part of name/type resolution (root: _.pw): integer-arithmetic typing helpers.
// (The operator opcodes themselves now live in the shared leaf module `@Ops`.)

pub impl Comp {

    // The integer result type of an arithmetic binary (operands share a type, so
    // either operand's recovered int type works). Width-less scalar if neither is a
    // recoverable integer type — then the overflow check is skipped (documented gap).
    inout fn arithIntType(lhs: U64, rhs: U64) -> TypeInfo {
        val lt: TypeInfo = self.typeOf(id: lhs)
        if lt.kind == 0 {
            if self.isIntType(start: lt.nameStart, len: lt.nameLen) {
                return lt
            }
        }
        val rt: TypeInfo = self.typeOf(id: rhs)
        if rt.kind == 0 {
            if self.isIntType(start: rt.nameStart, len: rt.nameLen) {
                return rt
            }
        }
        return scalarInfo()
    }

    // Wrapping arithmetic (spec/02): integer `* + -` panic on overflow; the
    // `wrapping*` methods opt into two's-complement wraparound instead (the only
    // way to wrap — there is no `&+` operator). A privileged lowering on integer
    // receivers until the integer trait tower subsumes it. Whether a method name is
    // one of the supported wrapping ops.
    inout fn isWrappingMethod(nameStart: U64, nameLen: U64) -> Bool {
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "wrappingMul") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "wrappingAdd") { return true }
        if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "wrappingSub") { return true }
        return false
    }
}
