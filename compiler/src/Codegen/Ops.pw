fn binOpStr(op: I64) -> String {
    if op == 56 { return " + " }
    if op == 57 { return " - " }
    if op == 58 { return " * " }
    if op == 59 { return " / " }
    if op == 60 { return " % " }
    if op == 50 { return " == " }
    if op == 51 { return " != " }
    if op == 52 { return " < " }
    if op == 53 { return " <= " }
    if op == 54 { return " > " }
    if op == 55 { return " >= " }
    if op == 61 { return " && " }
    if op == 62 { return " || " }
    if op == 74 { return " & " }
    if op == 75 { return " | " }
    if op == 76 { return " ^ " }
    if op == 77 { return " << " }
    if op == 78 { return " >> " }
    return " ? "
}

fn unaryOpStr(op: I64) -> String {
    if op == 57 { return "-" }
    if op == 79 { return "~" }
    return "!"
}

// Decoded byte length of a string literal (span includes both quotes). Escapes
// like \n / \" / \\ count as one byte; plewc.pw uses only C-compatible escapes,
// so the content is emitted verbatim and just the length is computed here.
fn strDecodedLen(c: inout Comp, start: U64, len: U64) -> I64 {
    mut val n: I64 = 0
    mut val j: U64 = start + 1
    val end: U64 = start + len - 1
    while j < end {
        if c.bytes[j] == 92 {
            j += 2
        } else {
            j += 1
        }
        n += 1
    }
    return n
}

// Whether a binary op is checked arithmetic (+ - *) whose result may overflow
// the operand type (spec: integer overflow always panics). `/` panics only on a
// zero divisor (handled by plew_div); shifts/bitwise never overflow.
fn isCheckedArith(op: I64) -> Bool {
    if op == 56 { return true }
    if op == 57 { return true }
    if op == 58 { return true }
    return false
}

// Map a compound-assign op (+= -= *=) to its binary op (+ - *) for the
// overflow check; 0 for ops whose compound form can't overflow (bitwise/shift)
// or isn't arithmetic. (/= and %= go through the checked plew_div/plew_mod.)
fn compoundCheckedBin(op: I64) -> I64 {
    if op == 67 { return 56 }
    if op == 68 { return 57 }
    if op == 69 { return 58 }
    return 0
}

// The clang overflow-detecting builtin for a checked-arith op.
fn overflowBuiltin(op: I64) -> String {
    if op == 56 { return "__builtin_add_overflow" }
    if op == 57 { return "__builtin_sub_overflow" }
    return "__builtin_mul_overflow"
}

// The integer result type of an arithmetic binary (operands share a type, so
// either operand's recovered int type works). Width-less scalar if neither is a
// recoverable integer type — then the overflow check is skipped (documented gap).
fn arithIntType(c: inout Comp, lhs: U64, rhs: U64) -> TypeInfo {
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind == 0 {
        if isIntType(c: inout c, start: lt.nameStart, len: lt.nameLen) {
            return lt
        }
    }
    val rt: TypeInfo = exprType(c: inout c, id: rhs)
    if rt.kind == 0 {
        if isIntType(c: inout c, start: rt.nameStart, len: rt.nameLen) {
            return rt
        }
    }
    return scalarInfo()
}

// Emit `a OP b` as an overflow-checked statement-expression: compute into a
// temp of the result type via the clang builtin, panic if it overflowed, else
// yield the temp. The builtin detects overflow against the temp's exact width,
// so storage being the declared width (Phase C) makes this precise.
fn genCheckedArith(c: inout Comp, op: I64, lhs: U64, rhs: U64, tyStart: U64, tyLen: U64) {
    write(s: "({ ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __ov; if (")
    write(s: overflowBuiltin(op: op))
    write(s: "((")
    genExpr(c: inout c, id: lhs)
    write(s: "), (")
    genExpr(c: inout c, id: rhs)
    write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
}

// Emit a bounds-checked array element read: `PlewArray_<E>_get(base, (idx))`.
fn genArrayGet(c: inout Comp, base: U64, index: U64, elemStart: U64, elemLen: U64) {
    write(s: "PlewArray_")
    writeSpan(c: inout c, start: elemStart, len: elemLen)
    write(s: "_get(")
    genExpr(c: inout c, id: base)
    write(s: ", (long long)(")
    genExpr(c: inout c, id: index)
    write(s: "))")
}

// The stdint.h MIN macro for a signed integer type (used in the INT_MIN / -1
// division-overflow guard). Assumes a signed int type span.
fn intMinMacro(c: inout Comp, start: U64, len: U64) -> String {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return "INT8_MIN" }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return "INT16_MIN" }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return "INT32_MIN" }
    return "INT64_MIN"
}

// Emit `-x` as an overflow-checked negation: negating the signed minimum has no
// representable result, so it panics. (Only emitted for signed int operands;
// `-` on unsigned is a type error the front end will reject later.)
fn genCheckedNeg(c: inout Comp, operand: U64, tyStart: U64, tyLen: U64) {
    write(s: "({ ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __ov; if (__builtin_sub_overflow((")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: ")0, (")
    genExpr(c: inout c, id: operand)
    write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
}

// Emit width- and sign-aware `/` or `%` (isMod) as a statement-expression:
// always panic on a zero divisor; for signed division, INT_MIN / -1 overflows
// (panic), and x % -1 is defined as 0 (sidesteps the C UB at INT_MIN % -1).
// Unsigned has neither overflow case. Computes at the exact result width.
fn genCheckedDiv(c: inout Comp, lhs: U64, rhs: U64, tyStart: U64, tyLen: U64, isMod: Bool) {
    val signedTy: Bool = intSigned(c: inout c, start: tyStart, len: tyLen)
    write(s: "({ ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __dl = (")
    genExpr(c: inout c, id: lhs)
    write(s: "); ")
    genCElem(c: inout c, start: tyStart, len: tyLen)
    write(s: " __dr = (")
    genExpr(c: inout c, id: rhs)
    write(s: "); if (__dr == 0) plew_panic((PlewString){")
    if isMod {
        write(s: "\"remainder by zero\", 17}); ")
    } else {
        write(s: "\"division by zero\", 16}); ")
    }
    if signedTy {
        if isMod {
            write(s: "(__dr == -1 ? 0 : __dl % __dr); })")
        } else {
            write(s: "if (__dr == -1 && __dl == ")
            write(s: intMinMacro(c: inout c, start: tyStart, len: tyLen))
            write(s: ") plew_panic((PlewString){\"integer overflow\", 16}); __dl / __dr; })")
        }
    } else {
        if isMod {
            write(s: "__dl % __dr; })")
        } else {
            write(s: "__dl / __dr; })")
        }
    }
}

fn assignOpStr(op: I64) -> String {
    if op == 49 { return " = " }
    if op == 67 { return " += " }
    if op == 68 { return " -= " }
    if op == 69 { return " *= " }
    if op == 70 { return " /= " }
    if op == 71 { return " %= " }
    if op == 80 { return " &= " }
    if op == 81 { return " |= " }
    if op == 82 { return " ^= " }
    if op == 83 { return " <<= " }
    return " >>= "
}

// Whether a compound-assign op is `/=` (70) or `%=` (71), whose expansion must
// go through the checked plew_div/plew_mod (spec: division by zero panics).
fn isCompoundDiv(op: I64) -> Bool {
    if op == 70 { return true }
    if op == 71 { return true }
    return false
}

// The checked-division C function (with its open paren) for `/=`/`%=`; "" for
// any other op (so callers can prefix unconditionally).
fn compoundDivFn(op: I64) -> String {
    if op == 70 { return "plew_div(" }
    if op == 71 { return "plew_mod(" }
    return ""
}

// The binary operator underlying a compound assignment (`+=` -> ` + `), used to
// expand `a[i] OP= v` into `set(a, i, get(a, i) OP v)`.
fn assignToBinStr(op: I64) -> String {
    if op == 67 { return " + " }
    if op == 68 { return " - " }
    if op == 69 { return " * " }
    if op == 70 { return " / " }
    if op == 71 { return " % " }
    if op == 80 { return " & " }
    if op == 81 { return " | " }
    if op == 82 { return " ^ " }
    if op == 83 { return " << " }
    return " >> "
}

