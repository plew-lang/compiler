// Part of compile-time checks (root: _.pw): import and use-site visibility
// constraints.

// Is `(nameStart,nameLen)` the name of an `export`ed declaration (spec/15)? Matched
// by text against the recorded export name spans (across all loaded modules).
fn isExportedName(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.modules.exports.count {
        val e: Bind = c.modules.exports[i]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: nameStart, bLen: nameLen) {
            return true
        }
        i += 1
    }
    return false
}

// Module visibility (spec/15): every name brought in by `import … with { }` must be
// part of some loaded module's public surface (`export`). A use of a non-exported
// name — or an import from the wrong module (whose own module then isn't loaded, so
// the name is absent from the exported set) — is a compile error.
fn checkImports(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.modules.imports.count {
        val im: Bind = c.modules.imports[i]
        if !(isExportedName(c: inout c, nameStart: im.nameStart, nameLen: im.nameLen)) {
            compileErrorAt(line: lineOf(c: inout c, offset: im.nameStart), msg: "imported name is not exported (mark it `export` in its module, or import it from the right module)")
        }
        i += 1
    }
}

// Was the name `(nameStart,nameLen)` imported into module `mod` via `import … with`?
fn isImportedInto(c: inout Comp, mod: U64, nameStart: U64, nameLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.modules.imports.count {
        val im: Bind = c.modules.imports[i]
        if im.fieldStart == mod {
            if spansEqual(c: inout c, aStart: im.nameStart, aLen: im.nameLen, bStart: nameStart, bLen: nameLen) {
                return true
            }
        }
        i += 1
    }
    return false
}

// Use-site diagnostic arm of scoped resolution (spec/15). Selection is already scoped
// (`findFunc` only returns a callee visible from the call's module = same module, or
// imported+exported). This pass turns the *failure* to resolve in scope into a good
// error: if a free fn of this name exists in ANOTHER loaded module, the use needs an
// import. A same-module match (e.g. wrong labels, reported elsewhere) or no match at
// all (local / closure / builtin) is left alone — except `@Std` intrinsics the backend
// intercepts by raw name (print / write / exit / …), which are not ambient and must be
// imported too. Types are scoped separately (their resolution sites); member/method
// visibility is a separate axis.
fn checkUseVisibility(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.arena.exprs.count {
        match c.arena.exprs[i] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val useMod: U64 = moduleOf(c: inout c, offset: nameStart)
                // The name is in scope iff some free fn of this name is visible from the
                // call's module (scoped resolution). If so, any remaining mismatch is an
                // overload/label/type error reported elsewhere — not a visibility issue.
                if firstVisibleFuncByName(c: inout c, useMod: useMod, nameStart: nameStart, nameLen: nameLen) >= c.arena.funcs.count {
                    if firstFuncByName(c: inout c, nameStart: nameStart, nameLen: nameLen) < c.arena.funcs.count {
                        // a free fn of this name exists only in other (loaded) modules and
                        // was not imported here — the use needs an import.
                        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "use of a function from another module without importing it (add `import … with { … }`)")
                    } else {
                        // no free fn of this name anywhere: a local/closure/builtin, or an
                        // `@Std` intrinsic the backend intercepts by raw name (print /
                        // write / exit / …). The latter is NOT ambient (spec/15: only lang
                        // items are) and must be imported.
                        if isAmbientInterceptedName(c: inout c, start: nameStart, len: nameLen) {
                            if !(isImportedInto(c: inout c, mod: useMod, nameStart: nameStart, nameLen: nameLen)) {
                                compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "this @Std function is not ambient — import it (e.g. `import @Std/Io with { print }`); only lang items are usable without import (spec/15)")
                            }
                        }
                    }
                }
                i += 1
            }
            _ => { i += 1 }
        }
    }
}

// Is a user type declaration named (start,len) VISIBLE from module `useMod` (scoped
// resolution: same module, or imported+exported)? A type decl's OWN module comes from
// its `defOffset` (a real source offset) — its `nameStart` is re-interned (module 0)
// and cannot serve `moduleOf`. The import side is keyed by the name text (the use-site
// span and the import record share it), independent of which decl matched.
// Is a type declaration whose own module is `moduleOf(defOffset)` visible to a use in
// module `useMod` on the same-module / ambient-prelude axes? Same module is trivially
// visible. The auto-loaded prelude (Driver: std/Prelude.pw) is ambient — its types are in
// scope everywhere without an `import` (it has no import path), like the lang-item types —
// so a type defined in the prelude module is visible from any module.
fn defModuleVisible(c: inout Comp, defOffset: U64, useMod: U64) -> Bool {
    val dm: U64 = moduleOf(c: inout c, offset: defOffset)
    if dm == useMod { return true }
    if dm == c.modules.preludeModule { return true }
    return false
}

fn typeDeclVisibleFrom(c: inout Comp, useMod: U64, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.arena.structs.count {
        val sd: StructDef = c.arena.structs[i]
        if sd.nameId == qId {
            if defModuleVisible(c: inout c, defOffset: sd.defOffset, useMod: useMod) { return true }
        }
        i += 1
    }
    i = 0
    while i < c.arena.enums.count {
        val ed: EnumDef = c.arena.enums[i]
        if ed.nameId == qId {
            if defModuleVisible(c: inout c, defOffset: ed.defOffset, useMod: useMod) { return true }
        }
        i += 1
    }
    i = 0
    while i < c.decls.traits.count {
        val td: TraitDef = c.decls.traits[i]
        if td.nameId == qId {
            if defModuleVisible(c: inout c, defOffset: td.nameStart, useMod: useMod) { return true }
        }
        i += 1
    }
    i = 0
    while i < c.arena.newtypes.count {
        val nt: NewtypeDef = c.arena.newtypes[i]
        if spansEqual(c: inout c, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) {
            if defModuleVisible(c: inout c, defOffset: nt.defOffset, useMod: useMod) { return true }
        }
        i += 1
    }
    // imported into useMod from a module that exports it (name-text keyed)
    if isImportedInto(c: inout c, mod: useMod, nameStart: start, nameLen: len) {
        if isExportedName(c: inout c, nameStart: start, nameLen: len) { return true }
    }
    return false
}

// Does a user type declaration named (start,len) exist in ANY loaded module? (Used to
// tell a genuine out-of-scope type from a type parameter / Self / associated type,
// which have no global declaration.)
fn typeDeclExistsGlobally(c: inout Comp, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    if structIndexByName(c: inout c, start: start, len: len) < c.arena.structs.count { return true }
    if enumIndexByName(c: inout c, start: start, len: len) < c.arena.enums.count { return true }
    mut val i: U64 = 0
    while i < c.decls.traits.count {
        val td: TraitDef = c.decls.traits[i]
        if td.nameId == qId { return true }
        i += 1
    }
    i = 0
    while i < c.arena.newtypes.count {
        val nt: NewtypeDef = c.arena.newtypes[i]
        if spansEqual(c: inout c, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) { return true }
        i += 1
    }
    return false
}

// Check one user-written type name (head span start,len) written at real source offset
// `siteOffset`. It must resolve to a declaration in scope of `siteOffset`'s module (same
// module, or imported+exported). Lang-item types are ambient. A type-parameter head was
// already excluded at lowering (its TypeRef carries siteOffset 0, so the walk never reaches
// here); `Self` / associated types have no global declaration, so the existence gate skips
// them silently. A genuine out-of-scope type — one that exists in another module but isn't
// imported — is the loud error.
// Resolve a module-local import alias `import M with { Real as Alias }` to `Real`, scoped
// to module `useMod` (the use site's module from its real siteOffset — the type-name span is
// re-interned, so the alias's own moduleOf must be compared against useMod). Returns the real
// name span, or the input unchanged when no alias of this module matches. c.modules.imports /
// exports are keyed by the REAL name, so resolving first lets the ordinary visibility check
// (imported + exported) succeed for an aliased type use.
fn realTypeNameInModule(c: inout Comp, useMod: U64, start: U64, len: U64) -> Bind {
    mut val ai: U64 = 0
    while ai < c.decls.importAliases.count {
        val al: Bind = c.decls.importAliases[ai]
        if spansEqual(c: inout c, aStart: al.nameStart, aLen: al.nameLen, bStart: start, bLen: len) {
            if moduleOf(c: inout c, offset: al.nameStart) == useMod {
                return <Bind nameStart=al.fieldStart nameLen=al.fieldLen fieldStart=al.fieldStart fieldLen=al.fieldLen />
            }
        }
        ai += 1
    }
    return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
}

fn checkTypeName(c: inout Comp, siteOffset: U64, start: U64, len: U64) {
    if len == 0 { return }
    if isLangItemTypeName(c: inout c, start: start, len: len) { return }
    val useMod: U64 = moduleOf(c: inout c, offset: siteOffset)
    // a `Real as Alias` use resolves to Real (imports/exports are keyed by the real name).
    val real: Bind = realTypeNameInModule(c: inout c, useMod: useMod, start: start, len: len)
    if typeDeclVisibleFrom(c: inout c, useMod: useMod, start: real.nameStart, len: real.nameLen) { return }
    if typeDeclExistsGlobally(c: inout c, start: real.nameStart, len: real.nameLen) {
        compileErrorAt(line: lineOf(c: inout c, offset: siteOffset), msg: "use of a type from another module without importing it (add `import … with { … }`)")
    }
}

// Type-side diagnostic arm of scoped resolution (spec/15), as a single choke-point pass:
// EVERY user-written type annotation in the program is one TypeRef in c.arena.types,
// stamped by the sole lowering choke point `lowerType` with its real source offset
// (siteOffset). So one uniform walk covers every site — function params/returns, struct &
// enum fields, local `val x: T`, newtype underlyings, trait requirement signatures, `as`
// casts, explicit type arguments, closure signatures, and any future syntax — with no site
// left to enumerate by hand. Generic arguments need no special recursion: each is itself a
// TypeRef in the arena, visited by the same loop. siteOffset 0 marks a synthetic TypeRef
// (compiler-built) or a type-parameter head — both skipped.
fn checkTypeVisibility(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.arena.types.count {
        val t: TypeRef = c.arena.types[i]
        if t.siteOffset != 0U64 {
            if offsetIsLoaded(c: inout c, offset: t.siteOffset) {
                checkTypeName(c: inout c, siteOffset: t.siteOffset, start: t.nameStart, len: t.nameLen)
            }
        }
        i += 1
    }
}

// Sentinel for "no defining module found" (a value no real module id takes).
fn importCycleSentinel() -> U64 { return 4000000000U64 }

// The module that DEFINES the name (start,len): a free function's own module, or a
// type declaration's module (via defOffset / nameStart, since type nameStart is
// re-interned). importCycleSentinel() if no such declaration is loaded. Used to turn an
// `import … with { name }` record into a module→module dependency edge.
fn definingModuleOfName(c: inout Comp, start: U64, len: U64) -> U64 {
    val fi: U64 = firstFuncByName(c: inout c, nameStart: start, nameLen: len)
    if fi < c.arena.funcs.count {
        val f: Func = c.arena.funcs[fi]
        return moduleOf(c: inout c, offset: f.nameStart)
    }
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.arena.structs.count {
        val sd: StructDef = c.arena.structs[i]
        if sd.nameId == qId {
            if sd.defOffset != 0U64 { return moduleOf(c: inout c, offset: sd.defOffset) }
        }
        i += 1
    }
    i = 0
    while i < c.arena.enums.count {
        val ed: EnumDef = c.arena.enums[i]
        if ed.nameId == qId {
            if ed.defOffset != 0U64 { return moduleOf(c: inout c, offset: ed.defOffset) }
        }
        i += 1
    }
    i = 0
    while i < c.decls.traits.count {
        val td: TraitDef = c.decls.traits[i]
        if td.nameId == qId { return moduleOf(c: inout c, offset: td.nameStart) }
        i += 1
    }
    i = 0
    while i < c.arena.newtypes.count {
        val nt: NewtypeDef = c.arena.newtypes[i]
        if spansEqual(c: inout c, aStart: nt.nameStart, aLen: nt.nameLen, bStart: start, bLen: len) {
            if nt.defOffset != 0U64 { return moduleOf(c: inout c, offset: nt.defOffset) }
        }
        i += 1
    }
    return importCycleSentinel()
}

// DFS over the module import graph (colors: 0=white, 1=gray/on-stack, 2=black). A gray
// target is a back edge → a circular import; report it at the offending import.
fn dfsImportCycle(c: inout Comp, node: U64, color: inout Array[U64], ef: Array[U64], et: Array[U64], eo: Array[U64]) {
    color[node] = 1U64
    mut val k: U64 = 0
    while k < ef.count {
        if ef[k] == node {
            val w: U64 = et[k]
            if color[w] == 1U64 {
                compileErrorAt(line: lineOf(c: inout c, offset: eo[k]), msg: "circular import: the module import graph must be acyclic (spec/15). A cycle means these files are logically one module — join them with `part` instead of `import`.")
            }
            if color[w] == 0U64 {
                dfsImportCycle(c: inout c, node: w, color: inout color, ef: ef, et: et, eo: eo)
            }
        }
        k += 1
    }
    color[node] = 2U64
}

// Enforce the DAG rule (spec/15): the module `import` graph must have no cycle. Each
// `import … with { name }` becomes an edge importing-module → defining-module-of-name;
// a cycle among them is a compile error (parts share a module id, so they never form an
// inter-module edge).
fn detectImportCycles(c: inout Comp) {
    mut val maxId: U64 = 0
    mut val ri: U64 = 0
    while ri < c.modules.ranges.count {
        val r: Bind = c.modules.ranges[ri]
        if r.fieldStart > maxId { maxId = r.fieldStart }
        ri += 1
    }
    val n: U64 = maxId + 1
    mut val ef: Array[U64] = []
    mut val et: Array[U64] = []
    mut val eo: Array[U64] = []
    mut val ii: U64 = 0
    while ii < c.modules.imports.count {
        val im: Bind = c.modules.imports[ii]
        val from: U64 = im.fieldStart
        val to: U64 = definingModuleOfName(c: inout c, start: im.nameStart, len: im.nameLen)
        if to != importCycleSentinel() {
            if to != from {
                ef.append(from)
                et.append(to)
                eo.append(im.nameStart)
            }
        }
        ii += 1
    }
    mut val color: Array[U64] = []
    mut val ci: U64 = 0
    while ci < n {
        color.append(0U64)
        ci += 1
    }
    mut val s: U64 = 0
    while s < n {
        if color[s] == 0U64 {
            dfsImportCycle(c: inout c, node: s, color: inout color, ef: ef, et: et, eo: eo)
        }
        s += 1
    }
}

// Is (start,len) the name of an `@Std` function the LLVM backend intercepts by raw
// name (so it would emit without an import)? These need a real import gate (spec/15):
// the user-facing I/O / process / async intrinsics. (The RawBuffer/String/FFI floor
// intrinsics are resolved through their loaded `extern` decls, so they fall under
// the ordinary import check above and are not listed here.)
fn isAmbientInterceptedName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "print") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "eprint") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "write") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "writeByte") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "readStdin") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "readFile") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "readFileBytes") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "fileExists") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "sleep") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "exit") { return true }
    // `assert` is a @Std/Core function (not a lang item): now that Core is ambient
    // (force-loaded), it resolves, but spec keeps it import-required, so gate it here.
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "assert") { return true }
    return false
}

// Missing-return check (spec/11, loud-failure principle): Plew does not implicitly
// return a function's tail expression, so a non-`()` function whose body can reach
// the end without `return`/`panic`/divergence would silently return uninitialized
// memory. Reject that loudly. A block "always diverges" if any of its statements
// does (control then never falls through to the block's end); a statement diverges
// if it is `return`/`panic`, an `if`/`else` whose both branches diverge, an
// (exhaustive) `match` whose every arm diverges, or an unconditional infinite loop
// (`while true { … }` with no `break` that exits it).

