// Part of compile-time checks (root: _.pw): call / argument / method type
// and ownership-mode checking.

// A bare place (variable/field/element) of a `unique` type in a value position
// is a forbidden copy (spec/03): unique values are move-only. Require `move`
// (consume), `borrow` (read), or `inout` (mutable borrow) at the use site.
// Fresh values (construction / call results) and the `move`/`borrow` prefixes
// (which lower to Expr.Move, not a place) pass. `inoutOk` exempts `inout` args.

pub impl Comp {
    inout fn checkUniquePlaceCopy(exprId: U64, inoutOk: Bool) {
        if inoutOk {
            return
        }
        if isPlaceExpr(c: inout self, id: exprId) {
            val ti: TypeInfo = exprType(c: inout self, id: exprId)
            if ti.kind == 2 {
                if self.typeIsUnique(start: ti.nameStart, len: ti.nameLen) {
                    compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: exprId)), msg: "a unique value cannot be copied; use `move`, `borrow`, or `inout`")
                }
            }
        }
    }

    inout fn checkUniqueArgModes(args: Array[Arg]) {
        mut val i: U64 = 0
        while i < args.count {
            self.checkUniquePlaceCopy(exprId: args[i].expr, inoutOk: args[i].isInout)
            i += 1
        }
    }

    inout fn tcCheckGenericArgConsistency(f: Func, args: Array[Arg]) {
        if f.typeParams.count == 0U64 {
            return
        }
        mut val tpi: U64 = 0
        while tpi < f.typeParams.count {
            val tpId: U64 = f.typeParams[tpi].nameId
            mut val firstRef: U64 = 0
            mut val ai: U64 = 0
            while ai < args.count {
                if ai < f.params.count {
                    val p: Param = f.params[ai]
                    if p.tyLen > 0U64 {
                        if intern(c: inout self, start: p.tyStart, len: p.tyLen) == tpId {
                            val ar: U64 = self.inferType(id: args[ai].expr)
                            if ar != 0U64 {
                                if firstRef == 0U64 {
                                    firstRef = ar
                                } else {
                                    if !(self.typesCompatible(expected: firstRef, inferred: ar)) {
                                        compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: args[ai].expr)), msg: "inconsistent types for a type parameter: two arguments bound to the same `[T]` have different types")
                                    }
                                }
                            }
                        }
                    }
                }
                ai += 1U64
            }
            tpi += 1U64
        }
    }

    inout fn checkArgInoutMode(p: Param, arg: Arg) {
        if p.isInout {
            if arg.isInout {
                // `inout` writes through the place, so the argument must (a) BE a place —
                // a local/field/subscript/Ref-pointee, not a literal or call result — and
                // (b) be mutable (spec/03: `inc(x: inout n)` needs `mut val n`).
                if !(self.exprIsPlace(id: arg.expr)) {
                    compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: arg.expr)), msg: "an `inout` argument must be a place (a variable or field), not a literal or temporary value (spec/03)")
                }
                if !(self.placeIsMutable(id: arg.expr)) {
                    compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: arg.expr)), msg: "an `inout` argument must be a mutable place; declare it `mut val` (spec/03)")
                }
            } else {
                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: arg.expr)), msg: "this parameter is `inout`; pass the argument with `inout` (spec/03)")
            }
        } else {
            if arg.isInout {
                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: arg.expr)), msg: "this parameter is not `inout`; remove `inout` from the argument (spec/03)")
            }
        }
    }

    inout fn checkFnSigAgainst(ft: TypeRef, params: Array[Param], retTy: U64, offset: U64) {
        // return type: ft.args[0].
        if ft.args.count >= 1U64 {
            if retTy != 0U64 {
                if !(self.typesCompatible(expected: ft.args[0], inferred: retTy)) {
                    compileErrorAt(line: lineOf(c: inout self, offset: offset), msg: "function value's return type does not match the expected function type (spec/04)")
                }
            }
        }
        mut val k: U64 = 0
        while k < params.count {
            if k + 1U64 < ft.args.count {
                if params[k].ty != 0U64 {
                    if !(self.typesCompatible(expected: ft.args[k + 1U64], inferred: params[k].ty)) {
                        compileErrorAt(line: lineOf(c: inout self, offset: offset), msg: "function value's parameter type does not match the expected function type (spec/04)")
                    }
                }
            }
            k += 1
        }
    }

    inout fn checkFnValueSig(declTy: U64, init: U64) {
        if !(isFnType(c: inout self, ref: declTy)) {
            return
        }
        val ft: TypeRef = self.arena.types[declTy]
        match self.arena.exprs[init] {
            Expr.Closure(val params, hasRet: _, retStart: _, retLen: _, retIsArray: _, val retTy, body: _) => {
                self.checkFnSigAgainst(ft: ft, params: params, retTy: retTy, offset: exprOffset(c: inout self, id: init))
            }
            Expr.Ident(start: val s, len: val l) => {
                val fi: U64 = firstFuncByName(c: inout self, nameStart: s, nameLen: l)
                if fi < self.arena.funcs.count {
                    self.checkFnSigAgainst(ft: ft, params: self.arena.funcs[fi].params, retTy: self.arena.funcs[fi].retTy, offset: exprOffset(c: inout self, id: init))
                }
            }
            _ => {}
        }
    }

    inout fn localTypeRefByName(nameStart: U64, nameLen: U64) -> U64 {
        val q: U64 = intern(c: inout self, start: nameStart, len: nameLen)
        mut val i: U64 = self.cur.locals.count
        while i > 0U64 {
            i -= 1
            if self.cur.locals[i].nameId == q {
                return self.cur.locals[i].ty
            }
        }
        return 0U64
    }

    inout fn checkCallArgs(id: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
        self.checkUniqueArgModes(args: args)
        val fi: U64 = resolvedCallee(c: inout self, id: id)
        if fi == self.arena.funcs.count {
            // calling a function VALUE (`val f: fn(x: I64)->I64 = …; f(x: true)`): the name
            // is a local, not a declared function, so check each arg against the fn type's
            // parameter types (the TypeRef stores args as [return, param0, param1, …]).
            val lty: U64 = self.localTypeRefByName(nameStart: nameStart, nameLen: nameLen)
            if lty != 0U64 {
                if isFnType(c: inout self, ref: lty) {
                    val ft: TypeRef = self.arena.types[lty]
                    mut val k: U64 = 0
                    while k < args.count {
                        if k + 1U64 < ft.args.count {
                            self.tcCheckValue(expectedRef: ft.args[k + 1U64], valueExpr: args[k].expr, pos: "fn-value arg")
                        }
                        k += 1
                    }
                    return
                }
            }
            mut val i: U64 = 0
            while i < args.count {
                checkLitCtx(c: inout self, id: args[i].expr, eKind: 1, eBits: 64, eSgn: true)
                i += 1
            }
            return
        }
        val f: Func = self.arena.funcs[fi]
        self.tcCheckGenericArgConsistency(f: f, args: args)
        val ps: Array[Param] = f.params
        mut val i: U64 = 0
        while i < args.count {
            if i < ps.count {
                val p: Param = ps[i]
                self.checkArgInoutMode(p: p, arg: args[i])
                checkLitSpan(c: inout self, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                self.checkClosureArgArity(argExpr: args[i].expr, p: p)
                // full type-compatibility (not just literal context): a non-literal VALUE
                // argument whose type disagrees with the parameter (a closure with the wrong
                // return type for a `fn(...)->R` param, etself.) — checkLitSpan only sees
                // literals. tcCheckValue rejects only DEFINITE mismatches (unknown/generic
                // types pass through).
                self.tcCheckValue(expectedRef: p.ty, valueExpr: args[i].expr, pos: "arg")
            } else {
                checkLitCtx(c: inout self, id: args[i].expr, eKind: 0, eBits: 0, eSgn: false)
            }
            i += 1
        }
    }

    inout fn checkClosureArgArity(argExpr: U64, p: Param) {
        if p.ty == 0U64 {
            return
        }
        if !(isFnType(c: inout self, ref: p.ty)) {
            return
        }
        match self.arena.exprs[argExpr] {
            Expr.Closure(val params, val hasRet, retStart: _, retLen: _, retIsArray: _, val retTy, body: _) => {
                val want: U64 = self.arena.types[p.ty].args.count
                if want > 0U64 {
                    if params.count == want - 1U64 {
                        // each closure-literal parameter label must equal the expected
                        // function type's label (spec/04: labels are part of a function
                        // type's identity — no relabel coercion, to prevent a silent
                        // argument swap). argLabels parallels args ([return, p0, p1, …]),
                        // so the label for closure param j is argLabels[j+1]; 0 = an
                        // unlabeled (`~:`) position, which the closure must also leave bare.
                        val expLabels: Array[U64] = self.arena.types[p.ty].argLabels
                        mut val pj: U64 = 0
                        while pj < params.count {
                            if pj + 1U64 < expLabels.count {
                                val expLbl: U64 = expLabels[pj + 1U64]
                                if expLbl != 0U64 {
                                    if params[pj].nameId != expLbl {
                                        compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: argExpr)), msg: "closure parameter label does not match the expected function type (spec/04: a function type's labels are part of its identity — rename the closure's parameter to match)")
                                    }
                                }
                            }
                            pj += 1U64
                        }
                    } else {
                        compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: argExpr)), msg: "closure has the wrong number of parameters for the expected function type")
                    }
                    // the closure's declared return type must match the expected function
                    // type's return (`fn(...)->R` args = [R, param0, …]) — else the caller
                    // reads back the wrong-typed result (`fn(x:I64)->F64` where `->I64` is
                    // wanted reinterprets the bits). spec/04 (a function type's identity).
                    if hasRet {
                        if retTy != 0U64 {
                            val expRet: U64 = self.arena.types[p.ty].args[0]
                            if expRet != 0U64 {
                                if !(self.typesCompatible(expected: expRet, inferred: retTy)) {
                                    compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: argExpr)), msg: "closure return type does not match the expected function type")
                                }
                            }
                        }
                    }
                }
            }
            _ => {}
        }
    }

    inout fn recvOwnParamCount(rt: TypeInfo) -> U64 {
        val si: U64 = self.genericStructIndex(nameStart: rt.nameStart, nameLen: rt.nameLen)
        if si < self.arena.structs.count {
            return self.arena.structs[si].typeParams.count
        }
        val ei: U64 = self.genericEnumIndex(nameStart: rt.nameStart, nameLen: rt.nameLen)
        if ei < self.arena.enums.count {
            return self.arena.enums[ei].typeParams.count
        }
        return 0U64
    }

    inout fn checkMethodArgs(recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
        self.checkUniqueArgModes(args: args)
        checkLitCtx(c: inout self, id: recv, eKind: 0, eBits: 0, eSgn: false)
        val rt: TypeInfo = exprType(c: inout self, id: recv)
        // `dict.insert(key:, value:)` on a Dictionary[K, V] (also how a `[k: v]` literal
        // lowers): the generic-receiver arg grounding is incomplete, so check key->K and
        // value->V directly here (mirrors checkIndexKeyType for subscripts). spec/02.
        if rt.kind == 2 {
            if rt.ref != 0U64 {
                if rt.ref < self.arena.types.count {
                    val drt: TypeRef = self.arena.types[rt.ref]
                    if rangeEquals(bytes: self.arena.bytes, start: drt.nameStart, len: drt.nameLen, kw: "Dictionary") {
                        if drt.args.count >= 2U64 {
                            // the generic-receiver arg grounding is incomplete, so check the
                            // Dictionary's key/value args directly by LABEL: a `key` arg must
                            // be K, a `value`/`fallback` arg must be V. Covers insert / get /
                            // getOr / contains / at / remove (`d.get(key: 5I64)` on a
                            // Dictionary[String,_]). spec/02.
                            mut val dai: U64 = 0
                            while dai < args.count {
                                if args[dai].hasLabel {
                                    if rangeEquals(bytes: self.arena.bytes, start: args[dai].labelStart, len: args[dai].labelLen, kw: "key") {
                                        self.tcCheckValue(expectedRef: drt.args[0], valueExpr: args[dai].expr, pos: "dict key")
                                    }
                                    if rangeEquals(bytes: self.arena.bytes, start: args[dai].labelStart, len: args[dai].labelLen, kw: "value") || rangeEquals(bytes: self.arena.bytes, start: args[dai].labelStart, len: args[dai].labelLen, kw: "fallback") {
                                        self.tcCheckValue(expectedRef: drt.args[1], valueExpr: args[dai].expr, pos: "dict value")
                                    }
                                }
                                dai += 1
                            }
                        }
                    }
                }
            }
        }
        if rt.kind == 2 {
            val mi: U64 = findMethod(c: inout self, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if mi != self.arena.funcs.count {
                val mf: Func = self.arena.funcs[mi]
                self.tcCheckGenericArgConsistency(f: mf, args: args)
                val ps: Array[Param] = mf.params
                val genericRecv: Bool = isGenericInst(c: inout self, ref: rt.ref)
                mut val i: U64 = 0
                while i < args.count {
                    if i < ps.count {
                        val p: Param = ps[i]
                        self.checkArgInoutMode(p: p, arg: args[i])
                        if genericRecv {
                            // a CONCRETE primitive param (`n: I64`) on a generic receiver
                            // needs no grounding — check it directly. (substTypeInfo with the
                            // method's own type params mis-grounds a method-own generic like
                            // `fold[B]`'s `B`, so only primitives are checked this way.)
                            if isPrimType(c: inout self, start: p.tyStart, len: p.tyLen) {
                                checkLitSpan(c: inout self, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                                self.tcCheckValue(expectedRef: p.ty, valueExpr: args[i].expr, pos: "arg")
                            } else {
                                // resolve the param's type under the receiver's
                                // instantiation so a literal arg gets the concrete context.
                                val pti: TypeInfo = self.substTypeInfo(instRef: rt.ref, params: mf.typeParams, tyRef: p.ty)
                                checkLitTi(c: inout self, id: args[i].expr, ti: pti)
                                // full type-compatibility against the GROUNDED param type — a
                                // typed value whose type disagrees with the (instantiated)
                                // parameter (`w.combine(x: 5I64)` on `W[String]` stores an I64
                                // where a String is expected). checkLitTi only range-checks a
                                // literal against its own suffix. A grounded String/primitive
                                // carries no TypeRef ref (kind 1 / kind 0 are name-only), so
                                // synthesize one from the grounded name. BUT a param whose head
                                // is a METHOD-OWN type param (the tail of mf.typeParams beyond the
                                // receiver's own params — e.g. `fold[B]`'s accumulator `B`, which
                                // may even share a NAME with a conformer param) is NOT grounded by
                                // the receiver instance: it is abstract here, so keep it lenient
                                // (else `fold(init: 0U64, …)` on `MapIter[…,B=I64]` false-rejects).
                                mut val headMethodOwn: Bool = false
                                if p.ty != 0U64 {
                                    val nConf: U64 = self.recvOwnParamCount(rt: rt)
                                    val headId: U64 = self.arena.types[p.ty].nameId
                                    mut val mk: U64 = nConf
                                    while mk < mf.typeParams.count {
                                        if mf.typeParams[mk].nameId == headId {
                                            headMethodOwn = true
                                        }
                                        mk += 1U64
                                    }
                                }
                                if !(headMethodOwn) {
                                    mut val pref: U64 = pti.ref
                                    if pref == 0U64 {
                                        if pti.nameLen > 0U64 {
                                            pref = self.simpleTypeRef(nameStart: pti.nameStart, nameLen: pti.nameLen)
                                        }
                                    }
                                    if pref != 0U64 {
                                        self.tcCheckValue(expectedRef: pref, valueExpr: args[i].expr, pos: "arg")
                                    }
                                }
                            }
                        } else {
                            checkLitSpan(c: inout self, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                            self.tcCheckValue(expectedRef: p.ty, valueExpr: args[i].expr, pos: "arg")
                        }
                    } else {
                        checkLitCtx(c: inout self, id: args[i].expr, eKind: 0, eBits: 0, eSgn: false)
                    }
                    i += 1
                }
                return
            }
        }
        if rt.kind == 3 {
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "append") {
                // if the element type is itself an `Array[X]`, the appended value is
                // an array (e.g. `m.append([1,2,3])`) — check its elements against the
                // inner element X, not the outer (mangled) element name as a scalar.
                mut val innerArr: Bool = false
                mut val innerStart: U64 = 0
                mut val innerLen: U64 = 0
                val er: U64 = arrayElemRef(c: inout self, start: rt.nameStart, len: rt.nameLen)
                if er != 0 {
                    val rr: U64 = self.resolveTy(tyRef: er)
                    if rr < self.arena.types.count {
                        val rtp: TypeRef = self.arena.types[rr]
                        if rangeEquals(bytes: self.arena.bytes, start: rtp.nameStart, len: rtp.nameLen, kw: "Array") {
                            if rtp.args.count > 0 {
                                val xn: Bind = arrayElemNameForRef(c: inout self, elemRef: rtp.args[0])
                                innerArr = true
                                innerStart = xn.nameStart
                                innerLen = xn.nameLen
                            }
                        }
                    }
                }
                mut val i: U64 = 0
                while i < args.count {
                    if innerArr {
                        checkLitArray(c: inout self, id: args[i].expr, elemStart: innerStart, elemLen: innerLen)
                    } else {
                        checkLitSpan(c: inout self, id: args[i].expr, tyStart: rt.nameStart, tyLen: rt.nameLen, isArray: false)
                        // a primitive-element array: the appended value's type must match the
                        // element type (`Array[I64].append(true)` — checkLitSpan range-checks a
                        // literal but a `true`/typed value of the wrong type slips through). Only
                        // primitives are checked (their simpleTypeRef is reliable; a struct/
                        // generic element name may be mangled and is left to other checks).
                        if isIntType(c: inout self, start: rt.nameStart, len: rt.nameLen) || isFloatType(c: inout self, start: rt.nameStart, len: rt.nameLen) || rangeEquals(bytes: self.arena.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Bool") || rangeEquals(bytes: self.arena.bytes, start: rt.nameStart, len: rt.nameLen, kw: "String") {
                            self.tcCheckValue(expectedRef: self.simpleTypeRef(nameStart: rt.nameStart, nameLen: rt.nameLen), valueExpr: args[i].expr, pos: "append")
                        }
                    }
                    i += 1
                }
                return
            }
        }
        // an assoc fn call `Type.make(...)`: the recv is a TYPE NAME (not a value), so the
        // instance-method lookups above miss it. Resolve the assoc fn and check its args
        // (the value `S.make(n: true)` would otherwise reinterpret a Bool as I64).
        match self.arena.exprs[recv] {
            Expr.Ident(start: val rStart, len: val rLen) => {
                val ai: U64 = findAssoc(c: inout self, recvStart: rStart, recvLen: rLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if ai < self.arena.funcs.count {
                    val aps: Array[Param] = self.arena.funcs[ai].params
                    mut val k: U64 = 0
                    while k < args.count {
                        if k < aps.count {
                            val ap: Param = aps[k]
                            self.checkArgInoutMode(p: ap, arg: args[k])
                            checkLitSpan(c: inout self, id: args[k].expr, tyStart: ap.tyStart, tyLen: ap.tyLen, isArray: ap.tyIsArray)
                            self.tcCheckValue(expectedRef: ap.ty, valueExpr: args[k].expr, pos: "arg")
                        }
                        k += 1
                    }
                    return
                }
            }
            _ => {}
        }
        mut val i: U64 = 0
        while i < args.count {
            checkLitCtx(c: inout self, id: args[i].expr, eKind: 1, eBits: 64, eSgn: true)
            i += 1
        }
    }
}
