// ---- generic monomorphization (G2a: structs) ----
//
// A generic struct `Box[T]` is a template: it is skipped in the normal struct
// emission and instead emitted once per concrete instantiation (`Box_I32`,
// `Box_String`, ...) with the type parameters substituted in field types.
// Instantiations are discovered from use-site TypeRefs after parsing.

// Index in c.structs of a generic struct named (nameStart,nameLen), or
// c.structs.count if there is no such generic struct.
fn genericStructIndex(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.structs.count {
        val s: StructDef = c.structs[i]
        if s.typeParams.count > 0 {
            if s.nameId == qId {
                return i
            }
        }
        i += 1
    }
    return c.structs.count
}

// Index in c.enums of a generic enum named (nameStart,nameLen), or c.enums.count
// if there is no such generic enum.
fn genericEnumIndex(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.enums.count {
        val e: EnumDef = c.enums[i]
        if e.typeParams.count > 0 {
            if e.nameId == qId {
                return i
            }
        }
        i += 1
    }
    return c.enums.count
}

// Is `ref` a concrete generic instantiation (head names a generic struct OR
// enum and it carries type arguments)?
fn isGenericInst(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    if t.args.count == 0 {
        return false
    }
    // `Array[U8]` stays out of the genInst machinery: its C type (`Array_U8`) and
    // runtime are hand-written and always emitted (file paths / String.bytes need
    // it even when no source mentions `Array[U8]`), so it must not also get a
    // genInst typedef. Every other `Array[E]` is an ordinary genInst of the prelude
    // `struct Array[T]`.
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
        val a0: TypeRef = c.types[t.args[0]]
        if rangeEquals(bytes: c.bytes, start: a0.nameStart, len: a0.nameLen, kw: "U8") {
            return false
        }
    }
    if genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen) < c.structs.count {
        return true
    }
    return genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen) < c.enums.count
}

// Is `ref` a function type (head `fn`, args = [return, params...])?
fn isFnType(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    return rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "fn")
}

// Is `ref` a `Ref[T]` instantiation? `Ref` is a blessed primitive (a shared
// mutable heap box), lowered to a C `T*` — not a user struct/enum.
fn isRefInst(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    if t.args.count != 1 {
        return false
    }
    return rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Ref")
}

// Is `ref` a `RawBuffer[T]` instantiation? `RawBuffer` is a blessed primitive
// (the refcounted raw buffer that Array's storage is built on), lowered like
// `Ref` to a C `T*` (with a {rc,cap} header before data) — not a user type.
fn isRawBufInst(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    if t.args.count != 1 {
        return false
    }
    return rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "RawBuffer")
}

// ── Recursive-value-type boxing (spec/03) ────────────────────────────────────
// A field whose declared type transitively contains its own owning type forms a
// containment cycle; emitted inline it would be an infinite C struct. We break
// the cycle by storing such a field behind a heap pointer (`T*`). Detection is a
// reachability walk over the *concrete* (non-generic) struct/enum graph, treating
// `Array`/`RawBuffer`/`Ref`/`WeakRef` as cycle-breaking (already pointer-backed)
// and `Optional`/`Result` as transparent (their payload holds the arg by value).

// Does this type head name an already-indirect container (pointer-backed), so it
// cannot transmit a by-value cycle? (Array/RawBuffer/Ref/WeakRef.)
fn isIndirectContainer(c: inout Comp, nStart: U64, nLen: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nStart, len: nLen, kw: "Array") {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nStart, len: nLen, kw: "RawBuffer") {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: nStart, len: nLen, kw: "Ref") {
        return true
    }
    return rangeEquals(bytes: c.bytes, start: nStart, len: nLen, kw: "WeakRef")
}

// A transparent generic container whose type arguments are held by value
// (Optional/Result) — the owner reaches whatever its args reach.
fn isTransparentContainer(c: inout Comp, nStart: U64, nLen: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: nStart, len: nLen, kw: "Optional") {
        return true
    }
    return rangeEquals(bytes: c.bytes, start: nStart, len: nLen, kw: "Result")
}

// Index of a concrete (non-generic) enum by name, else c.enums.count.
fn concreteEnumIndex(c: inout Comp, nStart: U64, nLen: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: nStart, len: nLen)
    mut val i: U64 = 0
    while i < c.enums.count {
        val e: EnumDef = c.enums[i]
        if e.typeParams.count == 0 {
            if e.nameId == qId {
                return i
            }
        }
        i += 1
    }
    return c.enums.count
}

fn containsU64(xs: Array[U64], v: U64) -> Bool {
    mut val i: U64 = 0
    while i < xs.count {
        if xs[i] == v {
            return true
        }
        i += 1
    }
    return false
}

// Does a type, named `nStart/nLen` with `args`, by-value reach the owner type
// `tStart/tLen`? `visited` holds declaration `nameStart`s of user types already
// entered (cycle guard). Indirect containers cut; transparent containers descend
// into args; concrete user struct/enum descend into fields (and args).
fn nameReachesOwner(c: inout Comp, nStart: U64, nLen: U64, args: Array[U64], tStart: U64, tLen: U64, visited: inout Array[U64]) -> Bool {
    if isIndirectContainer(c: inout c, nStart: nStart, nLen: nLen) {
        return false
    }
    if intern(c: inout c, start: nStart, len: nLen) == intern(c: inout c, start: tStart, len: tLen) {
        return true
    }
    if isTransparentContainer(c: inout c, nStart: nStart, nLen: nLen) {
        mut val ai: U64 = 0
        while ai < args.count {
            if typeRefReachesOwner(c: inout c, ref: args[ai], tStart: tStart, tLen: tLen, visited: inout visited) {
                return true
            }
            ai += 1
        }
        return false
    }
    // a struct head, generic OR not: scan its fields for a path back to the owner.
    // genericStructIndex is tried too (structIndexByName skips generics) — else a
    // MUTUALLY recursive GENERIC value type (`Foo[T]` ↔ `Bar[T]`) misses the cycle
    // through the generic partner's fields, fails to box, and overflows at sizing.
    mut val si: U64 = structIndexByName(c: inout c, start: nStart, len: nLen)
    if si < c.structs.count {
    } else {
        si = genericStructIndex(c: inout c, nameStart: nStart, nameLen: nLen)
    }
    if si < c.structs.count {
        val key: U64 = c.structs[si].nameStart
        if containsU64(xs: visited, v: key) {
            return false
        }
        visited.append(key)
        val fields: Array[FieldDef] = c.structs[si].fields
        mut val fi: U64 = 0
        while fi < fields.count {
            if fieldReachesOwner(c: inout c, f: fields[fi], tStart: tStart, tLen: tLen, visited: inout visited) {
                return true
            }
            fi += 1
        }
        return false
    }
    // an enum head, generic OR not (genericEnumIndex too — concreteEnumIndex skips
    // generics — so a mutually recursive generic ENUM `E1[T]` ↔ `E2[T]` boxes its
    // cyclic variant payload instead of overflowing at sizing, mirroring the struct case).
    mut val ei: U64 = concreteEnumIndex(c: inout c, nStart: nStart, nLen: nLen)
    if ei < c.enums.count {
    } else {
        ei = genericEnumIndex(c: inout c, nameStart: nStart, nameLen: nLen)
    }
    if ei < c.enums.count {
        val key: U64 = c.enums[ei].nameStart
        if containsU64(xs: visited, v: key) {
            return false
        }
        visited.append(key)
        val vars: Array[Variant] = c.enums[ei].variants
        mut val vi: U64 = 0
        while vi < vars.count {
            val vf: Array[FieldDef] = vars[vi].fields
            mut val fj: U64 = 0
            while fj < vf.count {
                if fieldReachesOwner(c: inout c, f: vf[fj], tStart: tStart, tLen: tLen, visited: inout visited) {
                    return true
                }
                fj += 1
            }
            vi += 1
        }
        return false
    }
    // unknown/generic head: conservatively descend into its type arguments.
    mut val gi: U64 = 0
    while gi < args.count {
        if typeRefReachesOwner(c: inout c, ref: args[gi], tStart: tStart, tLen: tLen, visited: inout visited) {
            return true
        }
        gi += 1
    }
    return false
}

fn typeRefReachesOwner(c: inout Comp, ref: U64, tStart: U64, tLen: U64, visited: inout Array[U64]) -> Bool {
    if ref == 0 {
        return false
    }
    if ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    return nameReachesOwner(c: inout c, nStart: t.nameStart, nLen: t.nameLen, args: t.args, tStart: tStart, tLen: tLen, visited: inout visited)
}

// Does field `f`'s declared type by-value reach the owner type `tStart/tLen`? An
// array field is pointer-backed (cut). A field with a parsed TypeRef uses it
// (carries generic args); otherwise the bare name span with no args.
fn fieldReachesOwner(c: inout Comp, f: FieldDef, tStart: U64, tLen: U64, visited: inout Array[U64]) -> Bool {
    if f.tyIsArray {
        return false
    }
    if f.ty != 0 {
        return typeRefReachesOwner(c: inout c, ref: f.ty, tStart: tStart, tLen: tLen, visited: inout visited)
    }
    val noArgs: Array[U64] = []
    return nameReachesOwner(c: inout c, nStart: f.tyStart, nLen: f.tyLen, args: noArgs, tStart: tStart, tLen: tLen, visited: inout visited)
}

// Codegen query: is field `f` stored boxed (behind a heap pointer)?
fn fieldIsBoxed(c: inout Comp, f: FieldDef) -> Bool {
    return containsU64(xs: c.boxedFields, v: f.nameStart)
}

// The FieldDef sentinel returned when a lookup fails (nameLen == 0).
fn noField() -> FieldDef {
    return <FieldDef nameStart=0 nameLen=0 tyStart=0 tyLen=0 tyIsArray=false ty=0 isMut=false hasDefault=false defaultVal=0 vis=0 />
}

// Look up a declared field of a concrete struct (isEnum=false) or enum variant
// (isEnum=true) by name. Returns noField() (nameLen == 0) when not found. Used at
// construction/access sites to recover a field's boxed flag and declared type.
fn findFieldDef(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, fieldStart: U64, fieldLen: U64) -> FieldDef {
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    if isEnum {
        val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
        val ei: U64 = concreteEnumIndex(c: inout c, nStart: typeStart, nLen: typeLen)
        if ei >= c.enums.count {
            return noField()
        }
        val vars: Array[Variant] = c.enums[ei].variants
        mut val vi: U64 = 0
        while vi < vars.count {
            val v: Variant = vars[vi]
            if v.nameId == qVar {
                val fs: Array[FieldDef] = v.fields
                mut val fj: U64 = 0
                while fj < fs.count {
                    if fs[fj].nameId == qField {
                        return fs[fj]
                    }
                    fj += 1
                }
            }
            vi += 1
        }
        return noField()
    }
    val si: U64 = structIndexByName(c: inout c, start: typeStart, len: typeLen)
    if si >= c.structs.count {
        return noField()
    }
    val fs: Array[FieldDef] = c.structs[si].fields
    mut val fi: U64 = 0
    while fi < fs.count {
        if fs[fi].nameId == qField {
            return fs[fi]
        }
        fi += 1
    }
    return noField()
}

// Pre-pass: record every concrete struct/enum field that closes a containment
// cycle back onto its owner. Only concrete (non-generic) owners are boxed; a
// generic type's recursion is broken at the concrete user field that points into
// it (so Optional/Result instantiations stay inline and keep their fixed layout).
fn markBoxedFields(c: inout Comp) {
    // GENERIC templates are included (no `typeParams.count == 0` guard): a recursive
    // GENERIC value type (`struct N[T] { next: Optional[N[T]] }`) must box its cyclic
    // field too, else monomorphizing `N[I64]` builds an infinite struct layout and the
    // compiler stack-overflows. Boxing is keyed by the field's name span, so the
    // template's boxed field is inherited by every instance (fieldIsBoxed reads
    // nameStart). fieldReachesOwner follows the type graph by name, so it detects the
    // cycle through `Optional[N[T]]` (a non-recursive `Box[T]` field `v: T` does not
    // reach its owner and stays unboxed).
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        val fields: Array[FieldDef] = s.fields
        mut val fi: U64 = 0
        while fi < fields.count {
            val f: FieldDef = fields[fi]
            mut val visited: Array[U64] = []
            if fieldReachesOwner(c: inout c, f: f, tStart: s.nameStart, tLen: s.nameLen, visited: inout visited) {
                c.boxedFields.append(f.nameStart)
            }
            fi += 1
        }
        si += 1
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        val vars: Array[Variant] = e.variants
        mut val vi: U64 = 0
        while vi < vars.count {
            val vf: Array[FieldDef] = vars[vi].fields
            mut val fj: U64 = 0
            while fj < vf.count {
                val f: FieldDef = vf[fj]
                mut val visited: Array[U64] = []
                if fieldReachesOwner(c: inout c, f: f, tStart: e.nameStart, tLen: e.nameLen, visited: inout visited) {
                    c.boxedFields.append(f.nameStart)
                }
                fj += 1
            }
            vi += 1
        }
        ei += 1
    }
}

// Is `ref` a concrete generic *enum* instantiation specifically?
fn isGenericEnumInst(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    if t.args.count == 0 {
        return false
    }
    return genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen) < c.enums.count
}

// Structural equality of two TypeRefs (head span + args, recursively).
fn typeRefEq(c: inout Comp, a: U64, b: U64) -> Bool {
    if a == b {
        return true
    }
    val ta: TypeRef = c.types[a]
    val tb: TypeRef = c.types[b]
    if ta.nameId == tb.nameId {
    } else {
        return false
    }
    if ta.args.count != tb.args.count {
        return false
    }
    mut val i: U64 = 0
    while i < ta.args.count {
        if typeRefEq(c: inout c, a: ta.args[i], b: tb.args[i]) {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Append the mangled name of `ref` (the same text emitMangle would write) to the
// end of c.bytes, so a compound array element type (`Ref[I32]`, `Array[I32]`,
// `Box[I32]`) gets a unique source-span name (`Ref_I32`) the existing name-span
// machinery can use. The bytes trail all real source, so they never shift a
// diagnostic line; the lexer has already run, so appending is safe.
fn appendMangle(c: inout Comp, ref: U64) {
    val t: TypeRef = c.types[resolveTy(c: inout c, tyRef: ref)]
    mut val j: U64 = 0
    while j < t.nameLen {
        c.bytes.append(c.bytes[t.nameStart + j])
        j += 1
    }
    mut val i: U64 = 0
    while i < t.args.count {
        c.bytes.append(95)
        appendMangle(c: inout c, ref: t.args[i])
        i += 1
    }
}

// A compound type's mangled name as a (start,len) span, with the element ref
// stashed in fieldStart so genCElem / the array runtime can recover the C type
// and ARC behaviour. Used for compound Array element types.
fn appendMangleSpan(c: inout Comp, ref: U64) -> Bind {
    val start: U64 = c.bytes.count
    appendMangle(c: inout c, ref: ref)
    val n: U64 = c.bytes.count
    return <Bind nameStart=start nameLen=(n - start) fieldStart=ref fieldLen=0 />
}

// Do two type refs have the same mangled name (same head + same args,
// recursively)? Type refs are not interned — the same type parsed twice gets
// distinct indices — so identity must compare structure, not the index.
fn sameMangle(c: inout Comp, refA: U64, refB: U64) -> Bool {
    val ra: U64 = resolveTy(c: inout c, tyRef: refA)
    val rb: U64 = resolveTy(c: inout c, tyRef: refB)
    if ra >= c.types.count {
        return false
    }
    if rb >= c.types.count {
        return false
    }
    val a: TypeRef = c.types[ra]
    val b: TypeRef = c.types[rb]
    if a.nameId == b.nameId {
    } else {
        return false
    }
    if a.args.count != b.args.count {
        return false
    }
    mut val i: U64 = 0
    while i < a.args.count {
        if sameMangle(c: inout c, refA: a.args[i], refB: b.args[i]) {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Is `ref` a compound type (a generic application / Ref / Array — has type
// arguments), as opposed to a simple named type whose head name is enough?
fn isCompoundType(c: inout Comp, ref: U64) -> Bool {
    val r: U64 = resolveTy(c: inout c, tyRef: ref)
    if r >= c.types.count {
        return false
    }
    return c.types[r].args.count > 0
}

// Resolve a TypeRef under the active body-substitution env: a bare type
// parameter (`T`) maps to its concrete argument; everything else is unchanged.
// (Nested substitution like `Optional[T]` is deferred.)
fn resolveTy(c: inout Comp, tyRef: U64) -> U64 {
    if tyRef >= c.types.count {
        return tyRef
    }
    val t: TypeRef = c.types[tyRef]
    if t.args.count == 0 {
        // `Self`/`Item` as types (provided methods on a trait): resolve to the
        // receiver type and its associated `Item` binding (set per method).
        if c.curSelfRef != 0 {
            if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
                return c.curSelfRef
            }
        }
        if c.curItemRef != 0 {
            if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Item") {
                return c.curItemRef
            }
        }
        // last-match (iterate high → low): a method-own type param is appended to the
        // env AFTER the receiver's own params (providedCopyTypeParams), so when names
        // collide (`fold[B]` copied onto `MapIter[I, F, B]` — both named `B`) the inner
        // method-own `B` (the accumulator) must shadow the conformer's `B` (the item).
        // With all-distinct names first-match and last-match agree, so this only changes
        // the collision case, resolving it the way lexical shadowing requires.
        mut val i: U64 = c.curTypeParams.count
        while i > 0U64 {
            i -= 1
            val p: Bind = c.curTypeParams[i]
            if t.nameId == p.nameId {
                if i < c.curTypeArgs.count {
                    return c.curTypeArgs[i]
                }
            }
        }
    }
    return tyRef
}

// Is (start,len) the name of a generic type parameter of some struct/enum/fn?
// (Used to tell a template type like `Box[T]` from a concrete `Box[I32]`.)
fn isTypeParamName(c: inout Comp, start: U64, len: U64) -> Bool {
    // a name that names a declared struct/enum is a concrete type, never a type
    // parameter — even if some *other* generic's parameter shares the name (a user
    // struct `B` vs `MapIter[I, F, B]`'s `B`). Concrete types win the global check;
    // a template's own parameter is resolved by the active env before this matters.
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val ni: U64 = 0
    while ni < c.structs.count {
        if c.structs[ni].typeParams.count == 0 {
            if c.structs[ni].nameId == qId {
                return false
            }
        }
        ni += 1
    }
    mut val nj: U64 = 0
    while nj < c.enums.count {
        if c.enums[nj].typeParams.count == 0 {
            if c.enums[nj].nameId == qId {
                return false
            }
        }
        nj += 1
    }
    mut val si: U64 = 0
    while si < c.structs.count {
        val tp: Array[Bind] = c.structs[si].typeParams
        mut val k: U64 = 0
        while k < tp.count {
            if tp[k].nameId == qId {
                return true
            }
            k += 1
        }
        si += 1
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val tp2: Array[Bind] = c.enums[ei].typeParams
        mut val k2: U64 = 0
        while k2 < tp2.count {
            if tp2[k2].nameId == qId {
                return true
            }
            k2 += 1
        }
        ei += 1
    }
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val tp3: Array[Bind] = c.funcs[fi].typeParams
        mut val k3: U64 = 0
        while k3 < tp3.count {
            if tp3[k3].nameId == qId {
                return true
            }
            k3 += 1
        }
        fi += 1
    }
    return false
}

// Is `ref` a fully-ground type (no type parameter anywhere in head or args)?
fn tyRefIsGround(c: inout Comp, ref: U64) -> Bool {
    if ref >= c.types.count {
        return true
    }
    val t: TypeRef = c.types[ref]
    if isTypeParamName(c: inout c, start: t.nameStart, len: t.nameLen) {
        return false
    }
    // `Self` is a contextual keyword, not concrete without a method env; a flat
    // scan (Make/Cast) reaching a provided body's `<FilterIter[Self,…]>` must not
    // register it (the method-aware scan grounds the real instance). `Item` is NOT
    // treated this way — it is a legal user type name; resolveTy only rewrites it
    // when an Iterator method env is active (curItemRef set).
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Self") {
        return false
    }
    mut val i: U64 = 0
    while i < t.args.count {
        if tyRefIsGround(c: inout c, ref: t.args[i]) {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Walk a use-site TypeRef, recording every concrete generic instantiation it
// contains. Post-order (args before self) so a by-value nested instance is
// emitted before the type that contains it; deduped structurally. A type that
// still mentions a type parameter (a template like `Box[T]`) is not collected.
// Register the element type of an Array reached via a type argument into
// c.arrayElems (deduped by name span) so its PlewArray runtime is emitted.
// If an array element is itself an `Array[X]`, its C type is `PlewArray_<X>`, so
// the inner element X must be registered (and emitted) before the outer. Register
// the inner first (recursively, for deeper nesting) so it lands earlier in
// c.arrayElems and its runtime is defined before the dependent one.
fn ensureArrayElemDeps(c: inout Comp, elemRef: U64) {
    if elemRef == 0 {
        return
    }
    val r: U64 = resolveTy(c: inout c, tyRef: elemRef)
    if r >= c.types.count {
        return
    }
    val t: TypeRef = c.types[r]
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
        if t.args.count > 0 {
            registerArrayElemRef(c: inout c, elemRef: t.args[0])
        }
    }
}

fn registerArrayElemRef(c: inout Comp, elemRef: U64) {
    // resolve a bare type parameter (`Array[T]` inside a generic instance) to its
    // concrete argument under the active env, so the runtime is emitted for the
    // instantiation (`Array[I32]`), not the template (`PlewArray_T`).
    val re: U64 = resolveTy(c: inout c, tyRef: elemRef)
    if re >= c.types.count {
        return
    }
    ensureArrayElemDeps(c: inout c, elemRef: re)
    // a compound element (`Ref[I32]`, `Array[I32]`, `Box[I32]`) gets a mangled
    // name span + its ref, matching the parser's recordArrayElem (so the runtime
    // and use sites agree); a simple element uses its head name.
    mut val nStart: U64 = c.types[re].nameStart
    mut val nLen: U64 = c.types[re].nameLen
    mut val fRef: U64 = 0
    if isCompoundType(c: inout c, ref: re) {
        val mn: Bind = appendMangleSpan(c: inout c, ref: re)
        nStart = mn.nameStart
        nLen = mn.nameLen
        fRef = re
    }
    mut val i: U64 = 0
    while i < c.arrayElems.count {
        val ae: Bind = c.arrayElems[i]
        if spansEqual(c: inout c, aStart: ae.nameStart, aLen: ae.nameLen, bStart: nStart, bLen: nLen) {
            return
        }
        i += 1
    }
    c.arrayElems.append(<Bind nameStart=nStart nameLen=nLen fieldStart=fRef fieldLen=0 />)
}

// Substitute the active monomorphization env (curTypeParams -> curTypeArgs) into
// a TypeRef, returning a ground ref. A bare type parameter resolves to its arg; a
// compound type (`Array[T]`, `Box[T]`) rebuilds with grounded args (appending a
// fresh TypeRef only when an arg actually changed). Returns `ref` unchanged when
// it is already ground or a param has no binding. Used so a generic struct's
// non-ground field type (`Array[T]` inside `Box[I64]`) registers its grounded
// instantiation (`Array[I64]`), whose C typedef would otherwise never be emitted.
// The record-field key for a (grounded) TypeRef, matching `recordTypeKey`'s output for
// the equivalent PType: the head-name span, then `[arg-heads]` for a generic instance.
// Used to rebuild a record struct's canonical name from grounded field types.
fn recordTypeKeyFromRef(c: inout Comp, ref: U64) -> Array[U8] {
    mut val out: Array[U8] = []
    if ref >= c.types.count {
        return out
    }
    val tr: TypeRef = c.types[ref]
    mut val i: U64 = 0
    while i < tr.nameLen {
        out.append(value: c.bytes[tr.nameStart + i])
        i += 1
    }
    if tr.args.count > 0U64 {
        appendBytes(into: inout out, from: "[".bytes)
        mut val a: U64 = 0
        while a < tr.args.count {
            if a > 0U64 {
                appendBytes(into: inout out, from: ",".bytes)
            }
            val ar: TypeRef = c.types[tr.args[a]]
            mut val k: U64 = 0
            while k < ar.nameLen {
                out.append(value: c.bytes[ar.nameStart + k])
                k += 1
            }
            a += 1
        }
        appendBytes(into: inout out, from: "]".bytes)
    }
    return out
}

// Ground a record struct's FIELD types under the active env and resolve to the
// concrete record (spec/02). A record `(index:U64,value:E)` lowers to a canonical
// struct whose name bakes in the field types — so `groundTypeRef` (which substitutes
// type ARGS) never grounds `E`. Here, when `ref` names a record struct (`(`-prefixed)
// and some field grounds to a different type, rebuild the canonical name from the
// grounded fields and return the matching registered struct's ref. Returns `ref`
// unchanged for a non-record, an all-concrete record, or an unregistered grounded one.
fn groundRecordStruct(c: inout Comp, ref: U64) -> U64 {
    val t: TypeRef = c.types[ref]
    if t.nameLen == 0U64 {
        return ref
    }
    if c.bytes[t.nameStart] != 40U8 {
        return ref
    }
    val si: U64 = structIndexByName(c: inout c, start: t.nameStart, len: t.nameLen)
    if si >= c.structs.count {
        return ref
    }
    val sd: StructDef = c.structs[si]
    mut val cn: Array[U8] = []
    appendBytes(into: inout cn, from: "(".bytes)
    mut val changed: Bool = false
    mut val j: U64 = 0
    while j < sd.fields.count {
        if j > 0U64 {
            appendBytes(into: inout cn, from: ",".bytes)
        }
        val fd: FieldDef = sd.fields[j]
        mut val k: U64 = 0
        while k < fd.nameLen {
            cn.append(value: c.bytes[fd.nameStart + k])
            k += 1
        }
        appendBytes(into: inout cn, from: ":".bytes)
        val g: U64 = groundTypeRef(c: inout c, ref: fd.ty)
        if g != fd.ty {
            changed = true
        }
        appendBytes(into: inout cn, from: recordTypeKeyFromRef(c: inout c, ref: g))
        j += 1
    }
    appendBytes(into: inout cn, from: ")".bytes)
    if changed {
    } else {
        return ref
    }
    val nm: Bind = internBytes(c: inout c, s: stringFromBytes(b: cn))
    val nid: U64 = intern(c: inout c, start: nm.nameStart, len: nm.nameLen)
    mut val gi: U64 = 0
    while gi < c.structs.count {
        if c.structs[gi].nameId == nid {
            mut val noArgs: Array[U64] = []
            return c.pushType(t: <TypeRef nameStart=nm.nameStart nameLen=nm.nameLen args=noArgs />)
        }
        gi += 1
    }
    return ref
}

fn groundTypeRef(c: inout Comp, ref: U64) -> U64 {
    if ref >= c.types.count {
        return ref
    }
    val t: TypeRef = c.types[ref]
    if t.args.count == 0 {
        val rg: U64 = groundRecordStruct(c: inout c, ref: ref)
        if rg != ref {
            return rg
        }
        return resolveTy(c: inout c, tyRef: ref)
    }
    mut val newArgs: Array[U64] = []
    mut val changed: Bool = false
    mut val i: U64 = 0
    while i < t.args.count {
        val g: U64 = groundTypeRef(c: inout c, ref: t.args[i])
        if g == t.args[i] {
        } else {
            changed = true
        }
        newArgs.append(g)
        i += 1
    }
    if changed {
        return c.pushType(t: <TypeRef nameStart=t.nameStart nameLen=t.nameLen args=newArgs />)
    }
    return ref
}

// Ground `tyRef` under the env of the generic struct instantiation `instRef`
// (its type params -> its concrete args). Returns `tyRef` unchanged when `instRef`
// is not a ground generic struct instance. Used to resolve an iterable's
// iterator()/next() return types through the concrete iterand (`Box[I64]` ->
// `BoxIter[I64]`, then `BoxIter[I64]`'s `next` -> `Optional[I64]`).
fn groundUnderInst(c: inout Comp, instRef: U64, tyRef: U64) -> U64 {
    if isGenericInst(c: inout c, ref: instRef) {
    } else {
        return tyRef
    }
    val inst: TypeRef = c.types[instRef]
    val si: U64 = genericStructIndex(c: inout c, nameStart: inst.nameStart, nameLen: inst.nameLen)
    if si >= c.structs.count {
        return tyRef
    }
    val sd: StructDef = c.structs[si]
    if sd.typeParams.count == inst.args.count {
    } else {
        return tyRef
    }
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    c.curTypeParams = sd.typeParams
    c.curTypeArgs = inst.args
    val g: U64 = groundTypeRef(c: inout c, ref: tyRef)
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
    return g
}

// Append a bare (no-args) TypeRef for a type name, returning its index. Used to
// give `Self` a concrete TypeRef when the receiver is non-generic (no inst ref).
fn simpleTypeRef(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val noArgs: Array[U64] = []
    return c.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=noArgs />)
}

// The bound type ref of a receiver's `type Item = X` associated binding (the
// Iterator conformance's element), or 0 if none. Keyed by the receiver type name.
fn assocItemRef(c: inout Comp, recvStart: U64, recvLen: U64) -> U64 {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    mut val i: U64 = 0
    while i < c.assocBindings.count {
        val ab: AssocBinding = c.assocBindings[i]
        if ab.recvId == qRecv {
            if rangeEquals(bytes: c.bytes, start: ab.nameStart, len: ab.nameLen, kw: "Item") {
                return ab.ty
            }
        }
        i += 1
    }
    return 0
}

// Set the `Self`/`Item`-as-type env for a method on the given receiver (recvInstRef
// = its concrete instantiation when generic, else 0). Self = the receiver type;
// Item = its `type Item` binding, grounded under the instantiation so a generic
// receiver's Item resolves to the concrete element. Pair with clearSelfItemEnv.
fn setSelfItemEnv(c: inout Comp, recvStart: U64, recvLen: U64, recvInstRef: U64) {
    if recvInstRef != 0 {
        c.curSelfRef = recvInstRef
    } else {
        c.curSelfRef = simpleTypeRef(c: inout c, nameStart: recvStart, nameLen: recvLen)
    }
    val itemR0: U64 = assocItemRef(c: inout c, recvStart: recvStart, recvLen: recvLen)
    if itemR0 == 0 {
        c.curItemRef = 0
    } else {
        if recvInstRef != 0 {
            c.curItemRef = groundUnderInst(c: inout c, instRef: recvInstRef, tyRef: itemR0)
        } else {
            c.curItemRef = itemR0
        }
    }
}

fn clearSelfItemEnv(c: inout Comp) {
    c.curSelfRef = 0
    c.curItemRef = 0
}

// A generic instantiation whose type ARGUMENT names a type whose head collides with
// one of the generic's own type-PARAMETER names (`Dictionary[String, V]` where the
// user also declares `struct V` — V is both Dictionary's value param and a concrete
// type). Type-parameter identity is name-based, so the two are indistinguishable and
// substitution/grounding cannot terminate (it would otherwise stack-overflow). Detect
// it so the front-end can reject loudly (spec: 曖昧はエラー) instead of crashing.
fn instArgCollidesParamName(c: inout Comp, instRef: U64) -> Bool {
    val t: TypeRef = c.types[instRef]
    if t.args.count == 0U64 {
        return false
    }
    // the generic's own type-parameter names (struct or enum). The collision is
    // pervasive: with a name-based parameter identity, ANY generic — struct or enum —
    // whose type ARGUMENT coincides with one of its parameter names cannot be grounded
    // (the concrete type and the parameter are indistinguishable, so substitution never
    // terminates and the compiler stack-overflows). The lone exception is a generic
    // floored purely on an extern intrinsic (`Array[T]` over `RawBuffer`), which
    // terminates; rejecting that rare ambiguous case too is the accepted cost of a
    // simple, crash-proof rule (rename the colliding type).
    mut val params: Array[Bind] = []
    val gsi: U64 = genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if gsi < c.structs.count {
        params = c.structs[gsi].typeParams
    } else {
        val gei: U64 = genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
        if gei < c.enums.count {
            params = c.enums[gei].typeParams
        } else {
            return false
        }
    }
    mut val ai: U64 = 0
    while ai < t.args.count {
        val arg: TypeRef = c.types[t.args[ai]]
        // a bare argument whose head names a declared concrete type AND coincides with
        // one of this generic's parameter names (skip an argument that is itself a
        // parameter — a template position, resolved by the active env, not a collision).
        val argId: U64 = arg.nameId
        if argId != 0U64 {
            if isTypeParamName(c: inout c, start: arg.nameStart, len: arg.nameLen) {
            } else {
                mut val pi: U64 = 0
                while pi < params.count {
                    if params[pi].nameId == argId {
                        return true
                    }
                    pi += 1
                }
            }
        }
        ai += 1
    }
    return false
}

// Whether a type argument of `ref` names a type that has a pending `@[...]` derive
// (so its `Hash`/`Eq`/... impl is generated by THIS `plew gen` run, not yet present).
// In gen mode such a generic instance must not register (spec/16): monomorphizing e.g.
// `Dictionary[Pair, _]`'s `where K: Hash` methods would demand a `Pair.hash` the run
// hasn't produced. The real program instantiates it normally in phase 2 (the
// auto-parted `.gen.pw` supplies the derive). Only relevant when `c.genMode`.
fn refArgNamesADeriveTarget(c: inout Comp, ref: U64) -> Bool {
    if c.derives.count == 0U64 {
        return false
    }
    val t: TypeRef = c.types[ref]
    mut val i: U64 = 0
    while i < t.args.count {
        val argT: TypeRef = c.types[t.args[i]]
        mut val di: U64 = 0
        while di < c.derives.count {
            if spansEqual(c: inout c, aStart: argT.nameStart, aLen: argT.nameLen, bStart: c.derives[di].typeStart, bLen: c.derives[di].typeLen) {
                return true
            }
            di += 1
        }
        i += 1
    }
    return false
}

fn scanType(c: inout Comp, ref: U64) {
    if ref >= c.types.count {
        return
    }
    // resolve any active env (a generic struct's field `Array[T]` -> `Array[I64]`)
    // so the grounded instantiation, not the template, is what gets registered.
    // (Shadows the parameter; the public label stays `ref` for all callers.)
    val ref: U64 = groundTypeRef(c: inout c, ref: ref)
    if ref >= c.types.count {
        return
    }
    val t: TypeRef = c.types[ref]
    mut val i: U64 = 0
    while i < t.args.count {
        scanType(c: inout c, ref: t.args[i])
        i += 1
    }
    // an `Array[E]` reached via a type argument (e.g. inside `Box[Array[I32]]`)
    // still needs its `PlewArray_E` runtime emitted — register the element.
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
        if t.args.count == 1 {
            registerArrayElemRef(c: inout c, elemRef: t.args[0])
        }
    }
    // register a function type for its C typedef (deduped structurally).
    if isFnType(c: inout c, ref: ref) {
        mut val fj: U64 = 0
        mut val seen: Bool = false
        while fj < c.fnTypes.count {
            if typeRefEq(c: inout c, a: c.fnTypes[fj], b: ref) {
                seen = true
            }
            fj += 1
        }
        if seen {
        } else {
            c.fnTypes.append(ref)
        }
    }
    if isGenericInst(c: inout c, ref: ref) {
        if tyRefIsGround(c: inout c, ref: ref) {
            mut val j: U64 = 0
            while j < c.genInsts.count {
                if typeRefEq(c: inout c, a: c.genInsts[j], b: ref) {
                    return
                }
                j += 1
            }
            if instArgCollidesParamName(c: inout c, instRef: ref) {
                compileErrorAt(line: lineOf(c: inout c, offset: c.types[ref].nameStart), msg: "a type argument's name collides with this generic's type-parameter name (e.g. `struct V` used as the value of `Dictionary[K, V]`); rename the type")
            }
            // gen mode: don't instantiate a generic over a to-be-derived type (spec/16).
            if c.genMode {
                if refArgNamesADeriveTarget(c: inout c, ref: ref) {
                    return
                }
            }
            c.genInsts.append(ref)
            // scan the generic struct's fields under this instantiation's env so an
            // `Array[T]` field registers its concrete element (`Array[I32]`) — the
            // runtime is keyed off the instantiation, not the `PlewArray_T` template.
            scanGenInstFields(c: inout c, instRef: ref)
        }
    }
}

// Scan the fields of the generic struct named by `instRef` with the env set to
// this instantiation (params -> args), so array-typed fields register their
// resolved element type.
fn scanGenInstFields(c: inout Comp, instRef: U64) {
    val inst: TypeRef = c.types[instRef]
    val qInst: U64 = intern(c: inout c, start: inst.nameStart, len: inst.nameLen)
    mut val si: U64 = 0
    while si < c.structs.count {
        val sd: StructDef = c.structs[si]
        if sd.nameId == qInst {
            if sd.typeParams.count == inst.args.count {
                if sd.typeParams.count > 0 {
                    val savedP: Array[Bind] = c.curTypeParams
                    val savedA: Array[U64] = c.curTypeArgs
                    c.curTypeParams = sd.typeParams
                    c.curTypeArgs = inst.args
                    val fs: Array[FieldDef] = sd.fields
                    mut val k: U64 = 0
                    while k < fs.count {
                        scanType(c: inout c, ref: fs[k].ty)
                        k += 1
                    }
                    // also scan this struct's methods' return/param types under the
                    // env, so a method returning another generic type (an iterable's
                    // `iterator() -> BoxIter[T]`) registers its grounded instantiation
                    // (`BoxIter[I64]`), whose typedef/methods would else be missing. A
                    // leftover (generic-method) param stays non-ground and is skipped.
                    mut val mfi: U64 = 0
                    while mfi < c.funcs.count {
                        val mf: Func = c.funcs[mfi]
                        if mf.hasRecv {
                            // skip copied provided methods (`map[B] -> MapIter[Self,…]`):
                            // their instances come from call sites, and expanding one here
                            // under Self=this inst would recurse forever (MapIter[MapIter[…]]).
                            if mf.isProvided {
                            } else {
                            if mf.recvId == qInst {
                                // a non-generic method may still mention `Self`/`Item`
                                // (`fn iterator() -> Self`); resolve them to this inst.
                                setSelfItemEnv(c: inout c, recvStart: inst.nameStart, recvLen: inst.nameLen, recvInstRef: instRef)
                                if mf.hasRet {
                                    scanType(c: inout c, ref: mf.retTy)
                                }
                                val mps: Array[Param] = mf.params
                                mut val mpi: U64 = 0
                                while mpi < mps.count {
                                    scanType(c: inout c, ref: mps[mpi].ty)
                                    mpi += 1
                                }
                                clearSelfItemEnv(c: inout c)
                            }
                            }
                        }
                        mfi += 1
                    }
                    c.curTypeParams = savedP
                    c.curTypeArgs = savedA
                }
            }
        }
        si += 1
    }
}

// Discover all concrete generic instantiations from use sites (function params/
// returns, non-generic struct/enum fields, let bindings, casts). G2 has no
// generic functions yet, so every use-site type argument is concrete.
fn collectGenInsts(c: inout Comp) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        // skip generic templates: their param/return types contain type
        // parameters (not concrete), resolved per instantiation instead.
        if f.typeParams.count > 0 {
        } else {
        // skip a provided-method template (receiver = a trait): it is not a real
        // method (it is copied onto each conformer), and scanning its signature
        // would resolve `Self` to the trait name and register a bogus instantiation
        // (`FilterIter[Iterator,…]`). The per-conformer copies are scanned instead.
        // Likewise skip a provided method copied onto a *generic* conformer (`filter`
        // on `MapIter`): it is still a template (Self/Item are the conformer's type
        // params, not concrete), emitted per receiver instantiation — scanning it as
        // concrete would register garbage like `FilterIter[MapIter, fn, B]`.
        mut val skipProvidedTemplate: Bool = false
        if methodRecvIsTrait(c: inout c, f: f) {
            skipProvidedTemplate = true
        }
        if f.isProvided {
            if genericStructIndex(c: inout c, nameStart: f.recvStart, nameLen: f.recvLen) < c.structs.count {
                skipProvidedTemplate = true
            }
        }
        if skipProvidedTemplate {
        } else {
            // a provided method copied onto a concrete conformer (`filter` on
            // Counter) may mention `Self`/`Item` in its signature; resolve them to
            // the receiver so its adapter instantiation (`FilterIter[Counter,…,I64]`)
            // grounds instead of leaking literal `Self`.
            if f.hasRecv {
                setSelfItemEnv(c: inout c, recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0)
            } else {
                clearSelfItemEnv(c: inout c)
            }
            if f.hasRet {
                scanType(c: inout c, ref: f.retTy)
            }
            val ps: Array[Param] = f.params
            mut val pi: U64 = 0
            while pi < ps.count {
                scanType(c: inout c, ref: ps[pi].ty)
                pi += 1
            }
            clearSelfItemEnv(c: inout c)
        }
        }
        fi += 1
    }
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if s.typeParams.count == 0 {
            val fs: Array[FieldDef] = s.fields
            mut val k: U64 = 0
            while k < fs.count {
                scanType(c: inout c, ref: fs[k].ty)
                k += 1
            }
        }
        si += 1
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.typeParams.count == 0 {
            val vs: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vs.count {
                val vfs: Array[FieldDef] = vs[vi].fields
                mut val k: U64 = 0
                while k < vfs.count {
                    scanType(c: inout c, ref: vfs[k].ty)
                    k += 1
                }
                vi += 1
            }
        }
        ei += 1
    }
    mut val sti: U64 = 0
    while sti < c.stmts.count {
        match c.stmts[sti] {
            Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, val ty, init: _) => {
                scanType(c: inout c, ref: ty)
            }
            _ => {}
        }
        sti += 1
    }
    mut val xi: U64 = 0
    while xi < c.exprs.count {
        match c.exprs[xi] {
            Expr.Cast(val operand, val tyStart, val tyLen, val ty) => {
                scanType(c: inout c, ref: ty)
            }
            Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
                scanType(c: inout c, ref: ty)
            }
            _ => {}
        }
        xi += 1
    }
}

// TypeInfo of a fully-concrete TypeRef (for literal-context checking and the
// field/index/method dispatch). Generic instantiations report as kind-2 named
// (the head span); nested generic field types are deferred (G2a).
fn typeInfoOfRef(c: inout Comp, ref: U64) -> TypeInfo {
    val t: TypeRef = c.types[ref]
    if t.args.count == 0 {
        return typeInfoOfName(c: inout c, start: t.nameStart, len: t.nameLen, isArray: false)
    }
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
        val el: TypeRef = c.types[t.args[0]]
        return typeInfoOfName(c: inout c, start: el.nameStart, len: el.nameLen, isArray: true)
    }
    // a compound type (`Ref[T]`, `Box[I32]`, `Optional[I32]`): keep its structured
    // ref so downstream `->`/`.field`/method resolution can recover the pointee or
    // instantiation arguments (dropping it loses generic/Ref-ness).
    return <TypeInfo kind=2 nameStart=t.nameStart nameLen=t.nameLen ref=ref />
}

// The element (`Item`) type of an Iterable iterand of type `et` (a struct with an
// `iterator()` method), recovered from the iterator's `next() -> Optional[Item]`
// return type. Returns scalarInfo() when `et` is not iterable. Shared by the for-
// loop's check, mono scan, and codegen so all three agree on the loop-var type.
fn iterableItemInfo(c: inout Comp, et: TypeInfo) -> TypeInfo {
    val noArgs: Array[Arg] = []
    // Iterable: iterator() returns the iterator; bare Iterator: the iterand is the
    // iterator (so `for v in xs.filter(p)` recovers the right element type).
    val itName: Bind = kwSpan(c: inout c, kw: "iterator", kwLen: 8)
    val imi: U64 = findMethod(c: inout c, recvStart: et.nameStart, recvLen: et.nameLen, nameStart: itName.nameStart, nameLen: itName.nameLen, args: noArgs)
    mut val itRef: U64 = et.ref
    mut val nrStart: U64 = et.nameStart
    mut val nrLen: U64 = et.nameLen
    if imi == c.funcs.count {
    } else {
        val imf: Func = c.funcs[imi]
        itRef = groundUnderInst(c: inout c, instRef: et.ref, tyRef: imf.retTy)
        nrStart = imf.retStart
        nrLen = imf.retLen
    }
    val nxName: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4)
    val nmi: U64 = findMethod(c: inout c, recvStart: nrStart, recvLen: nrLen, nameStart: nxName.nameStart, nameLen: nxName.nameLen, args: noArgs)
    if nmi == c.funcs.count {
        return scalarInfo()
    }
    val nmf: Func = c.funcs[nmi]
    // resolve Optional[Item] through the iterand's instantiation (Box[I64] ->
    // BoxIter[I64] -> Optional[I64]) so a generic iterand yields the concrete Item.
    val optRef: U64 = groundUnderInst(c: inout c, instRef: itRef, tyRef: nmf.retTy)
    if optRef < c.types.count {
        val ot: TypeRef = c.types[optRef]
        if ot.args.count > 0 {
            return typeInfoOfRef(c: inout c, ref: ot.args[0])
        }
    }
    return scalarInfo()
}

// TypeInfo for an `Array[E]` field/parameter of a generic instance, grounding E's
// type parameters via the instance env (`params` -> `instArgs`). Returns the
// grounded element's name (its head for a simple element, its mangled name for a
// compound one like `Box[T]` -> `Box_I64`) as a kind=3 (array) TypeInfo, so the
// use site emits `Array_<grounded>` instead of the un-substituted template name
// `Array_Box_T`. ref stays 0 (an array TypeInfo carries no element ref). Unifies
// the bare-param (`Array[T]`) and compound-element (`Array[Box[T]]`) cases.
fn groundedArrayFieldInfo(c: inout Comp, params: Array[Bind], instArgs: Array[U64], arrayTyRef: U64) -> TypeInfo {
    val at: TypeRef = c.types[arrayTyRef]
    if at.args.count == 0 {
        return typeInfoOfRef(c: inout c, ref: arrayTyRef)
    }
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    c.curTypeParams = params
    c.curTypeArgs = instArgs
    val grounded: U64 = groundTypeRef(c: inout c, ref: at.args[0])
    mut val ti: TypeInfo = scalarInfo()
    if isCompoundType(c: inout c, ref: grounded) {
        val mn: Bind = appendMangleSpan(c: inout c, ref: grounded)
        ti = <TypeInfo kind=3 nameStart=mn.nameStart nameLen=mn.nameLen ref=0 />
    } else {
        val gt: TypeRef = c.types[grounded]
        ti = <TypeInfo kind=3 nameStart=gt.nameStart nameLen=gt.nameLen ref=0 />
    }
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
    return ti
}

// TypeInfo of a type `tyRef` after substituting any type parameter (`params[i]`)
// with the instantiation `instRef`'s concrete argument. Used to resolve a
// generic method's parameter types at a call site.
fn substTypeInfo(c: inout Comp, instRef: U64, params: Array[Bind], tyRef: U64) -> TypeInfo {
    val t: TypeRef = c.types[tyRef]
    // an `Array[E]` field: ground E (which may be a bare param `T` or a compound
    // `Box[T]`) through the instance env so the use site names the concrete runtime.
    if t.args.count > 0 {
        if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "Array") {
            return groundedArrayFieldInfo(c: inout c, params: params, instArgs: c.types[instRef].args, arrayTyRef: tyRef)
        }
    }
    mut val i: U64 = 0
    while i < params.count {
        val p: Bind = params[i]
        if t.nameId == p.nameId {
            val inst: TypeRef = c.types[instRef]
            if i < inst.args.count {
                return typeInfoOfRef(c: inout c, ref: inst.args[i])
            }
        }
        i += 1
    }
    return typeInfoOfRef(c: inout c, ref: tyRef)
}

// TypeInfo of a generic struct instantiation's field, substituting the type
// parameter with the instantiation's concrete argument (`Box[I32]`.v -> I32).
fn genericFieldTypeInfo(c: inout Comp, instRef: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    val t: TypeRef = c.types[instRef]
    val si: U64 = genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if si >= c.structs.count {
        return scalarInfo()
    }
    val s: StructDef = c.structs[si]
    val fields: Array[FieldDef] = s.fields
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    mut val i: U64 = 0
    while i < fields.count {
        val fd: FieldDef = fields[i]
        if fd.nameId == qField {
            val ftr: TypeRef = c.types[fd.ty]
            mut val pi: U64 = 0
            while pi < s.typeParams.count {
                val p: Bind = s.typeParams[pi]
                if ftr.nameId == p.nameId {
                    return typeInfoOfRef(c: inout c, ref: t.args[pi])
                }
                pi += 1
            }
            // an `Array[E]` field: ground E (a bare param `T` or a compound
            // `Box[T]`) through the instance env so the use site (memberwise
            // factory, field action, index/method call) names the concrete runtime.
            if rangeEquals(bytes: c.bytes, start: ftr.nameStart, len: ftr.nameLen, kw: "Array") {
                if ftr.args.count > 0 {
                    return groundedArrayFieldInfo(c: inout c, params: s.typeParams, instArgs: t.args, arrayTyRef: fd.ty)
                }
            }
            return typeInfoOfRef(c: inout c, ref: fd.ty)
        }
        i += 1
    }
    return scalarInfo()
}

// TypeInfo of a generic enum instantiation's variant field, substituting the
// type parameter with the instantiation's concrete argument.
fn genericEnumFieldTypeInfo(c: inout Comp, instRef: U64, variantStart: U64, variantLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    val t: TypeRef = c.types[instRef]
    val ei: U64 = genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if ei >= c.enums.count {
        return scalarInfo()
    }
    val e: EnumDef = c.enums[ei]
    val vars: Array[Variant] = e.variants
    val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    mut val vi: U64 = 0
    while vi < vars.count {
        val v: Variant = vars[vi]
        if v.nameId == qVar {
            val fs: Array[FieldDef] = v.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val fd: FieldDef = fs[fi]
                if fd.nameId == qField {
                    val ftr: TypeRef = c.types[fd.ty]
                    mut val pi: U64 = 0
                    while pi < e.typeParams.count {
                        val p: Bind = e.typeParams[pi]
                        if ftr.nameId == p.nameId {
                            return typeInfoOfRef(c: inout c, ref: t.args[pi])
                        }
                        pi += 1
                    }
                    // an `Array[E]` variant field: ground E through the instance env.
                    if ftr.args.count > 0 {
                        if rangeEquals(bytes: c.bytes, start: ftr.nameStart, len: ftr.nameLen, kw: "Array") {
                            return groundedArrayFieldInfo(c: inout c, params: e.typeParams, instArgs: t.args, arrayTyRef: fd.ty)
                        }
                    }
                    return typeInfoOfRef(c: inout c, ref: fd.ty)
                }
                fi += 1
            }
        }
        vi += 1
    }
    return scalarInfo()
}

// Function types no longer get a per-signature C typedef: every function value
// is the uniform `PlewClosure` struct (defined in the preamble). The concrete
// signature is recovered at each call site to cast `PlewClosure.fn`.

// Does generic method `f` belong to the receiver instantiation `instRef`?
// (A method on `impl[T] Box[T]`: hasRecv, head name matches, and every type
// parameter is bound by the receiver's args — first cut excludes methods with
// their own extra type parameters.)
fn methodMatchesInst(c: inout Comp, f: Func, instRef: U64) -> Bool {
    if f.hasRecv {
    } else {
        return false
    }
    if f.typeParams.count == 0 {
        return false
    }
    val inst: TypeRef = c.types[instRef]
    if f.recvId == intern(c: inout c, start: inst.nameStart, len: inst.nameLen) {
    } else {
        return false
    }
    return f.typeParams.count == inst.args.count
}

// ---- generic free function monomorphization (call-site instantiation) ----
//
// A generic free function `fn f[T](x: T)` has no receiver to drive its
// instantiation, so it is specialized per call site: the type arguments are
// inferred from the call's argument types and a C function `f_<arg-mangle...>`
// is emitted under the type-parameter env (T -> the concrete arg). Only ground
// (fully concrete) instantiations are collected; transitive instantiation from
// inside another generic body is deferred.

// Whether c.funcs[fi] is a generic free function (no receiver, has type params).
fn isGenericFreeFn(c: inout Comp, fi: U64) -> Bool {
    if fi >= c.funcs.count {
        return false
    }
    val f: Func = c.funcs[fi]
    if f.hasRecv {
        return false
    }
    return f.typeParams.count > 0
}

// Find a bare (argument-less) TypeRef named (start,len), or create one. Dedups
// by name bytes so the same concrete type maps to one TypeRef for mangling.
fn findOrAddTypeRef(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val q: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.types.count {
        val t: TypeRef = c.types[i]
        if t.args.count == 0 {
            if t.nameId == q {
                return i
            }
        }
        i += 1
    }
    val noArgs: Array[U64] = []
    return c.pushType(t: <TypeRef nameStart=nameStart nameLen=nameLen args=noArgs />)
}

// The concrete TypeRef for a recovered TypeInfo (used as a generic type arg). A
// generic instantiation / Ref already carries a TypeRef (ti.ref); a named or
// scalar type maps to a bare TypeRef by its name span. Returns 0 (the no-type
// sentinel) when there is no name to mangle (an untyped literal / array), which
// the caller reads as "inference failed".
// Build a `fn(params) -> ret` TypeRef for a closure literal (so its type can be
// structurally unified against a `fn(...)->B` parameter). The fn-type layout is
// args[0] = return, args[1..] = parameter types (matching parseTypeTok / the
// closure-call ABI). Appended fresh; deduping is unnecessary (used transiently).
fn closureFnTypeRef(c: inout Comp, params: Array[Param], retTy: U64) -> U64 {
    val fnName: Bind = kwSpan(c: inout c, kw: "fn", kwLen: 2)
    mut val args: Array[U64] = []
    args.append(retTy)
    mut val i: U64 = 0
    while i < params.count {
        args.append(params[i].ty)
        i += 1
    }
    return c.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=args />)
}

// Structurally unify a parameter type `paramRef` against an argument type `argRef`
// to find the binding for the type parameter (tpStart,tpLen). When the parameter
// type IS the type parameter (`x: T`), bind it to the whole argument type; for a
// compound parameter (`f: fn(x: Item) -> B`, `b: Box[T]`) recurse into matching
// argument slots, returning the first binding found (0 if none). This generalizes
// inference from "the parameter is the type variable" to "the variable appears
// anywhere inside the parameter's type".
fn unifyTypeParam(c: inout Comp, paramRef: U64, argRef: U64, tpStart: U64, tpLen: U64) -> U64 {
    if paramRef >= c.types.count {
        return 0
    }
    val pt: TypeRef = c.types[paramRef]
    if pt.args.count == 0 {
        if pt.nameId == intern(c: inout c, start: tpStart, len: tpLen) {
            return argRef
        }
        return 0
    }
    if argRef >= c.types.count {
        return 0
    }
    val at: TypeRef = c.types[argRef]
    mut val i: U64 = 0
    while i < pt.args.count {
        if i < at.args.count {
            val r: U64 = unifyTypeParam(c: inout c, paramRef: pt.args[i], argRef: at.args[i], tpStart: tpStart, tpLen: tpLen)
            if r != 0 {
                return r
            }
        }
        i += 1
    }
    return 0
}

fn tyRefOfInfo(c: inout Comp, ti: TypeInfo) -> U64 {
    if ti.ref != 0 {
        return ti.ref
    }
    // a String value (kind 1) carries no name span in TypeInfo, but as a type argument
    // it must infer to `String` (a string-literal accumulator `fold(init: "z", …)`), not
    // unknown — else the inferred own arg is 0 and the env gets the index-0 dummy ref.
    if ti.kind == 1 {
        val ss: Bind = stringTypeSpan(c: inout c)
        if ss.nameLen != 0 {
            return simpleTypeRef(c: inout c, nameStart: ss.nameStart, nameLen: ss.nameLen)
        }
    }
    if ti.nameLen == 0 {
        return 0
    }
    if ti.kind == 3 {
        // arrays as type arguments are deferred (no generic-over-array yet).
        return 0
    }
    return findOrAddTypeRef(c: inout c, nameStart: ti.nameStart, nameLen: ti.nameLen)
}

// Infer a generic free function's type arguments from a call's argument types.
// For each type parameter, find a parameter declared with exactly that bare
// type-parameter name and take the matching argument's concrete TypeRef. Returns
// an array aligned to f.typeParams; an entry is 0 where inference failed.
// The element TypeRef of an array-typed argument expression (for inferring a
// type parameter from an `Array[T]` parameter), or 0. Recovered from the arg's
// binding type, since exprType does not carry an array's element ref.
fn argArrayElemRef(c: inout Comp, argExpr: U64) -> U64 {
    match c.exprs[argExpr] {
        Expr.Ident(val start, val len) => {
            val li: U64 = localIndexByName(c: inout c, start: start, len: len)
            if li < c.locals.count {
                val lo: Local = c.locals[li]
                if lo.ty < c.types.count {
                    val lt: TypeRef = c.types[lo.ty]
                    if rangeEquals(bytes: c.bytes, start: lt.nameStart, len: lt.nameLen, kw: "Array") {
                        if lt.args.count > 0 {
                            return lt.args[0]
                        }
                    }
                }
            }
        }
        _ => {}
    }
    return 0
}

fn inferFnArgs(c: inout Comp, f: Func, args: Array[Arg]) -> Array[U64] {
    mut val out: Array[U64] = []
    mut val ti: U64 = 0
    while ti < f.typeParams.count {
        val tp: Bind = f.typeParams[ti]
        mut val found: U64 = 0
        mut val pi: U64 = 0
        while pi < f.params.count {
            val p: Param = f.params[pi]
            if p.tyIsArray {
                // `Array[T]` param: infer T from the argument array's element.
                if p.tyNameId == tp.nameId {
                    if pi < args.count {
                        if found == 0 {
                            found = argArrayElemRef(c: inout c, argExpr: args[pi].expr)
                        }
                    }
                }
            } else {
                // structurally unify the parameter's type against the argument's, so
                // `T` is found whether it is the whole parameter type (`x: T`) or
                // nested in it (`f: fn(x: Item) -> T`).
                if pi < args.count {
                    if found == 0 {
                        val at: TypeInfo = typeOf(c: inout c, id: args[pi].expr)
                        val argRef: U64 = tyRefOfInfo(c: inout c, ti: at)
                        found = unifyTypeParam(c: inout c, paramRef: p.ty, argRef: argRef, tpStart: tp.nameStart, tpLen: tp.nameLen)
                    }
                }
            }
            pi += 1
        }
        out.append(found)
        ti += 1
    }
    return out
}

// Whether every inferred type argument resolved (nonzero) and is fully ground.
fn fnArgsAllGround(c: inout Comp, args: Array[U64]) -> Bool {
    if args.count == 0 {
        return false
    }
    mut val i: U64 = 0
    while i < args.count {
        if args[i] == 0 {
            return false
        }
        if tyRefIsGround(c: inout c, ref: args[i]) {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Whether the FnInst (fnIdx, args) is already registered (structural arg match).
fn fnInstExists(c: inout Comp, fnIdx: U64, args: Array[U64]) -> Bool {
    mut val i: U64 = 0
    while i < c.fnInsts.count {
        val fin: FnInst = c.fnInsts[i]
        if fin.fnIdx == fnIdx {
            if fin.args.count == args.count {
                mut val same: Bool = true
                mut val j: U64 = 0
                while j < args.count {
                    if typeRefEq(c: inout c, a: fin.args[j], b: args[j]) {
                    } else {
                        same = false
                    }
                    j += 1
                }
                if same {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Register a call as a generic free function instance if it resolves to one and
// its type arguments all infer to ground types (deduped). Type recovery needs
// the caller's local scope, so this runs during a scope-aware walk (below), not
// a flat scan of the expression arena.
fn registerCallInst(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
    if fi < c.funcs.count {
        if c.funcs[fi].isExtern {
            // a generic `extern "plew-intrinsic"` (e.g. `rawAlloc[T]`, `arrayPush[T]`):
            // lowered inline at the call site, so it has no monomorphized instance —
            // never register one (else a bogus prototype/body with an unmapped return
            // type leaks out).
        } else {
        if isGenericFreeFn(c: inout c, fi: fi) {
            val inferred: Array[U64] = inferFnArgs(c: inout c, f: c.funcs[fi], args: args)
            if fnArgsAllGround(c: inout c, args: inferred) {
                if fnInstExists(c: inout c, fnIdx: fi, args: inferred) {
                } else {
                    c.fnInsts.append(<FnInst fnIdx=fi args=inferred />)
                }
            }
        }
        }
    }
}

// Register an associated-function call `Type.make(args)` (the receiver is a type name,
// not a value) as a generic free-function instance. An assoc fn has no self, so it
// rides the FnInst/genFn machinery (declareGenFns/emitGenFns) exactly like a generic
// free function; the type args infer from the call (`make(v: T)` with `v: I64` -> T=I64).
fn registerAssocInst(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val arn: Bind = assocRecvName(c: inout c, recv: recv)
    if arn.nameLen == 0U64 {
        return
    }
    val afi: U64 = findAssoc(c: inout c, recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
    if afi >= c.funcs.count {
        return
    }
    if c.funcs[afi].isExtern {
        return
    }
    if isGenericFreeFn(c: inout c, fi: afi) {
        val inferred: Array[U64] = inferFnArgs(c: inout c, f: c.funcs[afi], args: args)
        if fnArgsAllGround(c: inout c, args: inferred) {
            if fnInstExists(c: inout c, fnIdx: afi, args: inferred) {
            } else {
                c.fnInsts.append(<FnInst fnIdx=afi args=inferred />)
            }
        }
    }
}

// Register a generic method call on a non-generic receiver (`counter.map[B](f)`)
// as an instance to emit, type args inferred from the call (Self/Item resolved so
// `fn(x: Item) -> B` yields B). Methods on a generic receiver are emitted per
// receiver instantiation (emitMonoMethods), so are skipped here. Reuses the FnInst
// machinery; the receiver is recovered from the Func (recvStart). The instance
// mangles `Recv_selector_<argMangle…>` (writeMethodInstSuffix) at def and call.
fn registerMethodInst(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val rt0: TypeInfo = typeOf(c: inout c, id: recv)
    // recover the receiver type-name span: a struct/enum (kind 2) carries it; a
    // String value (kind 1) recovers "String"; a primitive (kind 0, e.g. `U64`)
    // already carries its name. A generic method on a primitive (`u64.hash[H]`)
    // must register its instance too, so we no longer bail on non-struct kinds —
    // only arrays (kind 3, handled per element type) and nameless values are skipped.
    mut val rt: TypeInfo = rt0
    if rt0.kind == 1 {
        val ss: Bind = stringTypeSpan(c: inout c)
        if ss.nameLen != 0 {
            rt = <TypeInfo kind=2 nameStart=ss.nameStart nameLen=ss.nameLen ref=0 />
        }
    }
    if rt.kind == 3 {
        return
    }
    if rt.nameLen == 0 {
        return
    }
    val genericRecv: Bool = isGenericInst(c: inout c, ref: rt.ref)
    val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
    if mi == c.funcs.count {
        return
    }
    val mf: Func = c.funcs[mi]
    if mf.typeParams.count == 0 {
        return
    }
    // a generic receiver supplies the first `rcount` type params; the method must
    // have its OWN params beyond that to need a call-site instance (`filterIter.map`).
    // Without own params (`filterIter.filter`) it is emitted per receiver
    // instantiation (emitMonoMethods), so skip it here.
    mut val rcount: U64 = 0
    mut val recvInst: U64 = 0
    if genericRecv {
        rcount = recvParamCount(c: inout c, nameStart: rt.nameStart, nameLen: rt.nameLen)
        recvInst = rt.ref
        if mf.typeParams.count > rcount {
        } else {
            return
        }
    }
    setSelfItemEnv(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, recvInstRef: recvInst)
    val inferred: Array[U64] = inferFnArgs(c: inout c, f: mf, args: args)
    // build the full type-arg vector: the receiver's args fill the first `rcount`
    // slots (not inferrable from the call), the method-own args the rest.
    mut val fullArgs: Array[U64] = []
    if genericRecv {
        val inst: TypeRef = c.types[recvInst]
        mut val ri: U64 = 0
        while ri < rcount {
            if ri < inst.args.count {
                fullArgs.append(inst.args[ri])
            }
            ri += 1
        }
        mut val oi: U64 = rcount
        while oi < inferred.count {
            fullArgs.append(inferred[oi])
            oi += 1
        }
    } else {
        mut val ai: U64 = 0
        while ai < inferred.count {
            fullArgs.append(inferred[ai])
            ai += 1
        }
    }
    if fnArgsAllGround(c: inout c, args: fullArgs) {
        if fnInstExists(c: inout c, fnIdx: mi, args: fullArgs) {
        } else {
            c.fnInsts.append(<FnInst fnIdx=mi args=fullArgs recvInstRef=recvInst />)
        }
        // register the grounded return adapter (`MapIter[…,I64]`) + its transitive
        // instantiations, so its typedef/methods get emitted (a generic method is
        // skipped by the struct-field/signature scans).
        val savedP: Array[Bind] = c.curTypeParams
        val savedA: Array[U64] = c.curTypeArgs
        c.curTypeParams = mf.typeParams
        c.curTypeArgs = fullArgs
        if mf.hasRet {
            scanType(c: inout c, ref: mf.retTy)
        }
        c.curTypeParams = savedP
        c.curTypeArgs = savedA
    }
    clearSelfItemEnv(c: inout c)
}

// The number of type parameters a struct/enum named (start,len) declares (0 if it
// is not a generic type). For a generic method on a generic receiver, the first
// this-many of the method's type args come from the receiver instantiation; the
// rest are the method's own (encoded in the mangle suffix).
fn recvParamCount(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val gsi: U64 = genericStructIndex(c: inout c, nameStart: nameStart, nameLen: nameLen)
    if gsi < c.structs.count {
        return c.structs[gsi].typeParams.count
    }
    val gei: U64 = genericEnumIndex(c: inout c, nameStart: nameStart, nameLen: nameLen)
    if gei < c.enums.count {
        return c.enums[gei].typeParams.count
    }
    return 0
}

// Walk an expression, registering any generic free function calls it contains
// (args before self, so a nested generic call is registered before the outer one
// whose argument type may depend on it).
// Can an enclosing local of this shape be value-captured? Scalars, String,
// arrays, Ref, and plain (non-unique, non-generic) structs can: an immutable
// `val` value-captured is observationally identical to a reference capture, and
// heap-owning captures are retained into the env (then leaked). A `unique` type
// (no copy), a generic instantiation (per-inst share machinery), an enum, or a
// function-typed capture are not supported yet.
fn captureSupported(c: inout Comp, lo: Local) -> Bool {
    if lo.isArray {
        return true
    }
    if isPrimType(c: inout c, start: lo.tyStart, len: lo.tyLen) {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: lo.tyStart, len: lo.tyLen, kw: "String") {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: lo.tyStart, len: lo.tyLen, kw: "Ref") {
        return true
    }
    val si: U64 = structIndexByName(c: inout c, start: lo.tyStart, len: lo.tyLen)
    if si < c.structs.count {
        if c.structs[si].isUnique {
            return false
        }
        if c.structs[si].typeParams.count > 0 {
            return false
        }
        return true
    }
    return false
}

// Record that the active closure captures the enclosing local at `localIdx`.
// Dedup per (closure, name). v1: value-capture of immutable values — a `mut val`
// (needs shared reference semantics) and unsupported shapes (unique / generic
// instantiation / enum / function value) are rejected loudly (no silent meaning
// loss; mutable reference capture is additive later).
fn recordCapture(c: inout Comp, closureId: U64, localIdx: U64) {
    val lo: Local = c.locals[localIdx]
    mut val i: U64 = 0
    while i < c.captures.count {
        val e: CaptureEntry = c.captures[i]
        if e.closureId == closureId {
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: lo.nameStart, bLen: lo.nameLen) {
                return
            }
        }
        i += 1
    }
    mut val boxed: Bool = false
    if lo.isMut {
        // a mutable capture must share storage (reference capture). v1 boxes only
        // scalar (`mut val`) cells; mutable non-scalar capture is additive later.
        // (an array's type span names its element, so guard isArray explicitly.)
        if lo.isArray {
            compileErrorAt(line: lineOf(c: inout c, offset: lo.nameStart), msg: "capturing a mutable non-scalar value (`mut val` array/struct/string) in a closure is not yet supported")
        } else {
            if isPrimType(c: inout c, start: lo.tyStart, len: lo.tyLen) {
                boxed = true
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: lo.nameStart), msg: "capturing a mutable non-scalar value (`mut val` array/struct/string) in a closure is not yet supported")
            }
        }
    } else {
        if captureSupported(c: inout c, lo: lo) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: lo.nameStart), msg: "capturing this value (unique / generic / enum / function) in a closure is not yet supported")
        }
    }
    c.captures.append(<CaptureEntry closureId=closureId nameStart=lo.nameStart nameLen=lo.nameLen tyStart=lo.tyStart tyLen=lo.tyLen isArray=lo.isArray ty=lo.ty boxed=boxed />)
}

fn scanExprInsts(c: inout Comp, exprId: U64) {
    match c.exprs[exprId] {
        Expr.Ident(val start, val len) => {
            // capture detection: inside a closure, an identifier that resolves to
            // a local below the closure's entry mark is an enclosing capture.
            if c.curInClosure {
                val li: U64 = localIndexByName(c: inout c, start: start, len: len)
                if li < c.curCaptureMark {
                    // a module-level variable (spec/15) seeded at the locals base
                    // (index < globals.count) is globally accessible — not a capture.
                    if li < c.globals.count {
                    } else {
                        recordCapture(c: inout c, closureId: c.curClosureId, localIdx: li)
                    }
                }
            }
        }
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
            // a closure literal lexically inside another closure body: the inner
            // env construction would have to reach the outer env, which is not
            // wired yet — reject loudly rather than miscompile.
            if c.curInClosure {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: exprId)), msg: "nested closures are not yet supported")
            }
            // walk the body with the closure's own scope so enclosing references
            // become captures. Save/restore the capture context (single-level;
            // nested closures keep their own mark).
            val savedId: U64 = c.curClosureId
            val savedIn: Bool = c.curInClosure
            val savedMark: U64 = c.curCaptureMark
            val enclMark: U64 = scopeMark(c: inout c)
            c.curClosureId = exprId
            c.curInClosure = true
            c.curCaptureMark = enclMark
            mut val pi: U64 = 0
            while pi < params.count {
                val p: Param = params[pi]
                addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                pi += 1
            }
            scanBlockInsts(c: inout c, blkId: body)
            popLocals(c: inout c, mark: enclMark)
            c.curClosureId = savedId
            c.curInClosure = savedIn
            c.curCaptureMark = savedMark
        }
        Expr.Unary(val op, val operand) => { scanExprInsts(c: inout c, exprId: operand) }
        Expr.Binary(val op, val lhs, val rhs) => {
            scanExprInsts(c: inout c, exprId: lhs)
            scanExprInsts(c: inout c, exprId: rhs)
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            mut val i: U64 = 0
            while i < args.count {
                scanExprInsts(c: inout c, exprId: args[i].expr)
                i += 1
            }
            registerCallInst(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.ExtMethod(val recv, srcStart: _, srcLen: _, nameStart: _, nameLen: _, val args) => {
            scanExprInsts(c: inout c, exprId: recv)
            mut val i: U64 = 0
            while i < args.count {
                scanExprInsts(c: inout c, exprId: args[i].expr)
                i += 1
            }
        }
        Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
            scanExprInsts(c: inout c, exprId: recv)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            scanExprInsts(c: inout c, exprId: recv)
            mut val i: U64 = 0
            while i < args.count {
                scanExprInsts(c: inout c, exprId: args[i].expr)
                i += 1
            }
            registerMethodInst(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
            // an assoc-fn call `Type.make(args)` (type-name receiver): register its
            // monomorphized instance through the free-fn machinery (no self).
            registerAssocInst(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
            // register the call's result type: a combinator on a generic receiver
            // (`mapIter.filter(p)`) yields a new adapter instantiation
            // (`FilterIter[MapIter[…],…]`) that no field/signature scan reaches, so
            // its typedef + methods (and the provided method's reachability) depend
            // on registering it here.
            val mrt: TypeInfo = typeOf(c: inout c, id: exprId)
            if mrt.ref != 0 {
                scanType(c: inout c, ref: mrt.ref)
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => { scanExprInsts(c: inout c, exprId: base) }
        Expr.Index(val base, val index) => {
            scanExprInsts(c: inout c, exprId: base)
            scanExprInsts(c: inout c, exprId: index)
        }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            mut val i: U64 = 0
            while i < fields.count {
                scanExprInsts(c: inout c, exprId: fields[i].value)
                i += 1
            }
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count {
                scanExprInsts(c: inout c, exprId: elems[i])
                i += 1
            }
        }
        Expr.Cast(val operand, val tyStart, val tyLen, val ty) => { scanExprInsts(c: inout c, exprId: operand) }
        Expr.OptChain(val base, val memberStart, val memberLen) => {
            scanExprInsts(c: inout c, exprId: base)
            // register the Optional[U] result so its C struct is emitted.
            val rr: U64 = optChainResultRef(c: inout c, base: base, memberStart: memberStart, memberLen: memberLen)
            if rr == 0 {
            } else {
                scanType(c: inout c, ref: rr)
            }
        }
        Expr.Try(val expr) => { scanExprInsts(c: inout c, exprId: expr) }
        Expr.Arrow(val base, val nameStart, val nameLen) => { scanExprInsts(c: inout c, exprId: base) }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            scanExprInsts(c: inout c, exprId: cond)
            scanBlockInsts(c: inout c, blkId: thenBlk)
            scanBlockInsts(c: inout c, blkId: elseBlk)
        }
        Expr.MatchExpr(val scrut, val arms) => {
            scanExprInsts(c: inout c, exprId: scrut)
            mut val ai: U64 = 0
            while ai < arms.count {
                val a: MatchArm = arms[ai]
                val mark: U64 = scopeMark(c: inout c)
                scanAddArmBinds(c: inout c, a: a, scrutTi: typeOf(c: inout c, id: scrut))
                scanBlockInsts(c: inout c, blkId: a.body)
                popLocals(c: inout c, mark: mark)
                ai += 1
            }
        }
        Expr.Move(val operand, val isBorrow) => { scanExprInsts(c: inout c, exprId: operand) }
        _ => {}
    }
}

// Add a match arm's field binds to the local scope (for type recovery during the
// instance-collection walk; mirrors codegen's addBindLocal, minus emission).
fn scanAddArmBinds(c: inout Comp, a: MatchArm, scrutTi: TypeInfo) {
    // a struct-destructure arm `S { val x }`: bind each field from the scrutinee
    // struct (mirrors codegen's addForStructBinds), so a generic call on a bound
    // field (`print(items.count)`) recovers its type.
    if a.isStruct {
        addForStructBinds(c: inout c, et: scrutTi, binds: a.binds)
        return
    }
    val genericMatch: Bool = isGenericEnumInst(c: inout c, ref: scrutTi.ref)
    mut val bi: U64 = 0
    while bi < a.binds.count {
        val bd: Bind = a.binds[bi]
        if genericMatch {
            val bti: TypeInfo = genericEnumFieldTypeInfo(c: inout c, instRef: scrutTi.ref, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
            addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false)
        } else {
            addBindLocal(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen)
        }
        bi += 1
    }
}

// Walk a statement, registering generic free function calls and maintaining the
// local scope for type recovery (mirrors codegen's binding management).
fn scanStmtInsts(c: inout Comp, stmtId: U64) {
    match c.stmts[stmtId] {
        Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
            scanExprInsts(c: inout c, exprId: init)
            // register the local with its EFFECTIVE type (inferred when there is no
            // annotation), mirroring codegen — otherwise a later `p.x` on an
            // inferred-typed `val p = <P …/>` can't recover its type, so a generic
            // call like `print(p.x + p.y)` fails to discover its instantiation.
            val le: LetEff = inferLetType(c: inout c, tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
            addLocal(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: true)
        }
        Stmt.Assign(val op, val target, val value) => {
            scanExprInsts(c: inout c, exprId: target)
            scanExprInsts(c: inout c, exprId: value)
        }
        Stmt.ExprStmt(val expr) => { scanExprInsts(c: inout c, exprId: expr) }
        Stmt.Return(val value, val hasValue, offset: _) => {
            if hasValue {
                scanExprInsts(c: inout c, exprId: value)
            }
        }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            scanExprInsts(c: inout c, exprId: cond)
            scanBlockInsts(c: inout c, blkId: thenBlk)
            if hasElse {
                scanBlockInsts(c: inout c, blkId: elseBlk)
            }
        }
        Stmt.While(val cond, val body) => {
            scanExprInsts(c: inout c, exprId: cond)
            scanBlockInsts(c: inout c, blkId: body)
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            val forMark: U64 = scopeMark(c: inout c)
            scanExprInsts(c: inout c, exprId: iter)
            if isRange {
                scanExprInsts(c: inout c, exprId: rangeHi)
                // type the loop var so generic calls on it in the body (`print(i)`)
                // ground: the annotation if given, else the bound's own type.
                mut val rtS: U64 = varTyStart
                mut val rtL: U64 = varTyLen
                if rtL == 0 {
                    val bt: TypeInfo = typeOf(c: inout c, id: rangeHi)
                    if bt.kind == 0 {
                        rtS = bt.nameStart
                        rtL = bt.nameLen
                    }
                }
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: rtS, tyLen: rtL, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
            } else {
                val et: TypeInfo = typeOf(c: inout c, id: iter)
                if isStruct {
                    addForStructBinds(c: inout c, et: et, binds: binds)
                } else {
                    if et.kind == 3 {
                        addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                    } else {
                        val elemTi: TypeInfo = iterableItemInfo(c: inout c, et: et)
                        addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                    }
                }
            }
            scanBlockInsts(c: inout c, blkId: body)
            popLocals(c: inout c, mark: forMark)
        }
        Stmt.Match(val scrut, val arms) => {
            scanExprInsts(c: inout c, exprId: scrut)
            mut val ai: U64 = 0
            while ai < arms.count {
                val a: MatchArm = arms[ai]
                val mark: U64 = scopeMark(c: inout c)
                scanAddArmBinds(c: inout c, a: a, scrutTi: typeOf(c: inout c, id: scrut))
                scanBlockInsts(c: inout c, blkId: a.body)
                popLocals(c: inout c, mark: mark)
                ai += 1
            }
        }
        Stmt.Panic(val msg, val offset) => { scanExprInsts(c: inout c, exprId: msg) }
        Stmt.Give(val value) => { scanExprInsts(c: inout c, exprId: value) }
        Stmt.Break(offset: _) => {}
        Stmt.Continue(offset: _) => {}
    }
}

// Walk a block (its own local scope), registering generic free function calls.
fn scanBlockInsts(c: inout Comp, blkId: U64) {
    val mark: U64 = scopeMark(c: inout c)
    val stmts: Array[U64] = c.blocks[blkId].stmts
    mut val i: U64 = 0
    while i < stmts.count {
        scanStmtInsts(c: inout c, stmtId: stmts[i])
        i += 1
    }
    popLocals(c: inout c, mark: mark)
}

// Discover concrete instantiations of generic free functions by walking each
// non-generic function's body with its local scope reconstructed (params, lets,
// for/match binds) so argument types recover. Generic templates are skipped
// (their body types are unresolved — transitive instantiation is deferred).
// A generic-receiver method body (`Dictionary[String,U64].insert`) is emitted per
// receiver instantiation (emitMonoMethods), but its body may call another generic
// method/fn (`key.hash[H]` -> `String.hash[SipHasher]`) whose instance no signature
// scan reaches. Walk every such body once per receiver instantiation, under the
// same env emitMonoMethod uses (type params -> the receiver's args, Self/Item set),
// so the nested instances register; the transitive worklist in collectFnInsts then
// scans them. `Array[E]` user methods are emitted by the Array-specific path
// (emitArrayMethods, keyed off kind-3 receivers), not emitMonoMethods — scanning
// them here would mis-ground `self` and register `Array_T_*`, so they are skipped.
fn scanGenInstMethodBodies(c: inout Comp) {
    mut val gi: U64 = 0
    while gi < c.genInsts.count {
        val instRef: U64 = c.genInsts[gi]
        val inst: TypeRef = c.types[instRef]
        if rangeEquals(bytes: c.bytes, start: inst.nameStart, len: inst.nameLen, kw: "Array") {
            gi += 1
        } else {
            mut val mfi: U64 = 0
            while mfi < c.funcs.count {
                val mf: Func = c.funcs[mfi]
                if methodMatchesInst(c: inout c, f: mf, instRef: instRef) {
                    // provided combinators (`map[B]`) instantiate from call sites, not here.
                    if mf.isProvided {
                    } else {
                        if mf.body != 0 {
                            c.locals = []
                            seedGlobalLocals(c: inout c)
                            c.curHasRecv = true
                            c.curRecvStart = mf.recvStart
                            c.curRecvLen = mf.recvLen
                            c.curSelfInout = mf.selfInout
                            c.curRecvInstRef = instRef
                            c.curTypeParams = mf.typeParams
                            c.curTypeArgs = inst.args
                            setSelfItemEnv(c: inout c, recvStart: mf.recvStart, recvLen: mf.recvLen, recvInstRef: instRef)
                            mut val pi: U64 = 0
                            while pi < mf.params.count {
                                val p: Param = mf.params[pi]
                                addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                                pi += 1
                            }
                            scanBlockInsts(c: inout c, blkId: mf.body)
                            clearSelfItemEnv(c: inout c)
                        }
                    }
                }
                mfi += 1
            }
            gi += 1
        }
    }
    val noP: Array[Bind] = []
    val noA: Array[U64] = []
    c.locals = []
    c.curHasRecv = false
    c.curRecvInstRef = 0
    c.curTypeParams = noP
    c.curTypeArgs = noA
}

fn collectFnInsts(c: inout Comp) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        // skip generic templates (their instances come from call sites) and extern
        // fns (body == 0 is a sentinel; walking block 0 would scan an unrelated body).
        if f.typeParams.count > 0 || f.isExtern {
        } else {
            val noParams: Array[Bind] = []
            val noArgs: Array[U64] = []
            c.locals = []
            seedGlobalLocals(c: inout c)
            c.curHasRecv = f.hasRecv
            c.curRecvStart = f.recvStart
            c.curRecvLen = f.recvLen
            c.curSelfInout = f.selfInout
            c.curRecvInstRef = 0
            c.curTypeParams = noParams
            c.curTypeArgs = noArgs
            mut val pi: U64 = 0
            while pi < f.params.count {
                val p: Param = f.params[pi]
                addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                pi += 1
            }
            scanBlockInsts(c: inout c, blkId: f.body)
        }
        fi += 1
    }
    // generic-receiver method bodies: walk them under the receiver env so a nested
    // generic call (`key.hash[H]` -> `String.hash[SipHasher]`) registers its instance
    // before the transitive worklist below scans it.
    scanGenInstMethodBodies(c: inout c)
    // transitive instantiation: walk each generic free function instance's body
    // with its type-parameter env active (so type-parameter-typed args resolve to
    // concrete types), registering the instances it calls. The loop re-reads
    // c.fnInsts.count each step, so newly appended instances are scanned too — a
    // worklist that runs to fixpoint (a generic fn calling another generic fn).
    mut val si: U64 = 0
    while si < c.fnInsts.count {
        val fin: FnInst = c.fnInsts[si]
        val gf: Func = c.funcs[fin.fnIdx]
        c.locals = []
        seedGlobalLocals(c: inout c)
        // a generic *method* instance carries a receiver: set the self env (and the
        // receiver instantiation for a generic receiver) so `self`/`self.field`
        // resolve while scanning its body — without this, a derived `hash[H]` that
        // calls `self.field.hash(...)` can't type `self.field`, so the field's own
        // (transitive) generic-method instance is never discovered. A free function
        // has hasRecv=false, so this is a no-op for it (env stays cleared).
        c.curHasRecv = gf.hasRecv
        c.curRecvStart = gf.recvStart
        c.curRecvLen = gf.recvLen
        c.curSelfInout = gf.selfInout
        c.curRecvInstRef = fin.recvInstRef
        if gf.hasRecv {
            setSelfItemEnv(c: inout c, recvStart: gf.recvStart, recvLen: gf.recvLen, recvInstRef: fin.recvInstRef)
        }
        c.curTypeParams = gf.typeParams
        c.curTypeArgs = fin.args
        mut val gpi: U64 = 0
        while gpi < gf.params.count {
            val gp: Param = gf.params[gpi]
            addLocal(c: inout c, nameStart: gp.nameStart, nameLen: gp.nameLen, tyStart: gp.tyStart, tyLen: gp.tyLen, isArray: gp.tyIsArray, ty: gp.ty, isInout: gp.isInout, isMut: false, owned: false)
            gpi += 1
        }
        scanBlockInsts(c: inout c, blkId: gf.body)
        if gf.hasRecv {
            clearSelfItemEnv(c: inout c)
        }
        si += 1
    }
    val noP: Array[Bind] = []
    val noA: Array[U64] = []
    c.locals = []
    c.curHasRecv = false
    c.curTypeParams = noP
    c.curTypeArgs = noA
    c.curInClosure = false
    c.curClosureId = 0
    c.curCaptureMark = 0
}

