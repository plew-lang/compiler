                            }
                            write(s: " ")
                            writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        }
                        mut val smBoxed: Bool = false
                        if genericMatch {
                        } else {
                            val smfd: FieldDef = findFieldDef(c: inout c, typeStart: a.enumStart, typeLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, isEnum: true, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                            if smfd.nameLen > 0 {
                                smBoxed = fieldIsBoxed(c: inout c, f: smfd)
                            }
                        }
                        write(s: " = ")
                        if smBoxed {
                            // boxed (recursive) payload: deref the heap cell (copy out).
                            write(s: "*(")
                        }
                        write(s: "_m")
                        writeU64(n: t)
                        write(s: ".data.")
                        writeSpan(c: inout c, start: a.variantStart, len: a.variantLen)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
                        if smBoxed {
                            write(s: ")")
                        }
                        write(s: ";\n")
                        if c.curAsync {
                            // (-w silences unused warnings; no `(void)` needed.)
                        } else {
                            // mark used so an unreferenced bind doesn't warn
                            write(s: "        (void)")
                            writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                            write(s: ";\n")
                        }
                        if genericMatch {
                            val bti: TypeInfo = genericEnumFieldTypeInfo(c: inout c, instRef: scrutRef, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                            addLocalCn(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false, cnum: bcn)
                        } else {
                            addBindLocalCn(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen, cnum: bcn)
                        }
                        bi += 1
                    }
                    c.curBranchBase = armMark
                    genBlock(c: inout c, id: a.body)
                    scopeExit(c: inout c, mark: armMark)
                    write(s: "    }\n")
                }
                i += 1
            }
            c.curBranchBase = savedBB
            // exhaustive match without a wildcard: the final fall-through is
            // unreachable (so a value-returning function does not "fall off").
            if hasWildcard {
            } else {
                write(s: "    else { __builtin_unreachable(); }\n")
            }
            write(s: "    }\n")
        }
    }
}

fn genBlock(c: inout Comp, id: U64) {
    val mark: U64 = scopeMark(c: inout c)
    val b: Block = c.blocks[id]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        genStmt(c: inout c, id: stmts[i])
        i += 1
    }
    scopeExit(c: inout c, mark: mark)
}

