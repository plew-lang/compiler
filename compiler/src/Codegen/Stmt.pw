// Is `id` a place expression (a variable / field / element — an lvalue), as
// opposed to a fresh value (literal / call / construction)? Used to decide
// whether copying an array value is needed for value semantics.
fn isPlaceExpr(c: inout Comp, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Ident(val start, val len) => { return true }
        Expr.Field(val base, val nameStart, val nameLen) => { return true }
        Expr.Index(val base, val index) => { return true }
        _ => { return false }
    }
}

// Emit an array *value* for a binding/store: copy (value semantics) when the
// source is an existing place, else emit the fresh literal/expression directly.
// (Eager-copy realizes value semantics; lazy CoW + freeing are deferred hidden
// cost. Copying from a place gives the binding its own buffer.)
fn genArrayValue(c: inout Comp, exprId: U64, elemStart: U64, elemLen: U64) {
    if isPlaceExpr(c: inout c, id: exprId) {
        // CoW: binding from a place shares the buffer (retain) rather than deep-
        // copying; a later mutation through _set/_push splits off a private copy.
        wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
        write(s: "_share(")
        genExpr(c: inout c, id: exprId)
        write(s: ")")
        return
    }
    genArrayLiteral(c: inout c, exprId: exprId, elemStart: elemStart, elemLen: elemLen)
}

// Emit an array literal given the element type from context (declared type of
// the let / field it initializes). Empty -> _new(); non-empty -> a statement
// expression that news then pushes. Falls back to genExpr for non-literals.
fn genArrayLiteral(c: inout Comp, exprId: U64, elemStart: U64, elemLen: U64) {
    val e: Expr = c.exprs[exprId]
    match e {
        Expr.Array(val elems) => {
            if elems.count == 0 {
                wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
                write(s: "_new()")
            } else {
                write(s: "({ ")
                wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
                write(s: " __a = ")
                wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
                write(s: "_new(); ")
                mut val i: U64 = 0
                while i < elems.count {
                    wPA(c: inout c, elemStart: elemStart, elemLen: elemLen)
                    write(s: "_push(&__a, ")
                    genExpr(c: inout c, id: elems[i])
                    write(s: "); ")
                    i += 1
                }
                write(s: "__a; })")
            }
        }
        _ => { genExpr(c: inout c, id: exprId) }
    }
}

// Whether `lhs OP rhs` is a String `==` / `!=` (which lowers to PlewString_eq
// rather than a C struct comparison).
fn isStringEq(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op == opEq() {
    } else {
        if op == opNe() {
        } else {
            return false
        }
    }
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    return lt.kind == 1
}

fn isEnumName(c: inout Comp, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.nameId == qId {
            return true
        }
        ei += 1
    }
    return false
}

// Whether every variant of the named enum is nullary (no payload). Tag-only
// `==` is exact for such enums; payload-bearing enums need structural Eq.
fn isAllNullary(c: inout Comp, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.nameId == qId {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if v.fields.count > 0 {
                    return false
                }
                vi += 1
            }
            return true
        }
        ei += 1
    }
    return false
}

// Whether `lhs OP rhs` is an enum `==` / `!=`. Provisional: lowered to a tag
// (variant) comparison, NOT a payload-aware structural Eq. For all-nullary
// enums this coincides with structural equality; full Eq comes with @[Eq].
fn isEnumEq(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op == opEq() {
    } else {
        if op == opNe() {
        } else {
            return false
        }
    }
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    if lt.kind == 2 {
        return isEnumName(c: inout c, start: lt.nameStart, len: lt.nameLen)
    }
    return false
}

// Acceptance soundness: comparison operators (== != < <= > >=) are trait-backed
// (Eq/Ord). The compiler hardcodes them for numbers, String `==`/`!=`, and
// all-nullary enum `==`; applied to a struct or array there is no Eq/Ord, so it
// must be a compile error rather than broken C. (Reached only after the
// String-eq and enum-eq paths have been ruled out.)
fn compareNeedsTrait(c: inout Comp, op: I64, lhs: U64) -> Bool {
    if op < 50 {
        return false
    }
    if op > 55 {
        return false
    }
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    if lt.kind == 3 {
        return true
    }
    if lt.kind == 2 {
        if isEnumName(c: inout c, start: lt.nameStart, len: lt.nameLen) {
            return false
        }
        return true
    }
    return false
}

// Emit one operand of an enum tag comparison: a variant construction becomes
// its tag index literal; any other enum value becomes `(expr).tag`.
fn emitEnumOperand(c: inout Comp, id: U64, enStart: U64, enLen: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            if isEnum {
                writeU64(n: variantIndex(c: inout c, enumStart: enStart, enumLen: enLen, variantStart: variantStart, variantLen: variantLen))
                return
            }
        }
        _ => {}
    }
    write(s: "(")
    genExpr(c: inout c, id: id)
    write(s: ").tag")
}

// Emit an enum `==`/`!=` as a tag comparison. Resolves the enum from whichever
// operand is a value of that enum. PROVISIONAL: only all-nullary enums are
// allowed; a payload-bearing enum emits an undeclared identifier so the C
// compile fails loudly (structural Eq awaits @[Eq] — never compare blind).
fn emitEnumTagCmp(c: inout Comp, lhs: U64, rhs: U64, op: I64, outer: Bool) {
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    mut val enStart: U64 = 0
    mut val enLen: U64 = 0
    if lt.kind == 2 {
        enStart = lt.nameStart
        enLen = lt.nameLen
    } else {
        val rt: TypeInfo = typeOf(c: inout c, id: rhs)
        enStart = rt.nameStart
        enLen = rt.nameLen
    }
    if isAllNullary(c: inout c, start: enStart, len: enLen) {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "enum == needs structural Eq for payload variants (only all-nullary enums compare by tag)")
        return
    }
    if outer {
        write(s: "(")
    }
    emitEnumOperand(c: inout c, id: lhs, enStart: enStart, enLen: enLen)
    if op == opNe() {
        write(s: " != ")
    } else {
        write(s: " == ")
    }
    emitEnumOperand(c: inout c, id: rhs, enStart: enStart, enLen: enLen)
    if outer {
        write(s: ")")
    }
}

// Index of an assoc fn named `name` on type (typeStart,typeLen), or c.funcs.count.
// (A by-name lookup for the operator witnesses Eq.eq / Ord.compare, which have a
// single witness per type.)
fn findAssocByName(c: inout Comp, typeStart: U64, typeLen: U64, name: String) -> U64 {
    val qType: U64 = intern(c: inout c, start: typeStart, len: typeLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.isAssoc {
            if f.recvId == qType {
                if rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                    return i
                }
            }
        }
        i += 1
    }
    return c.funcs.count
}

// Tag index of the `Ordering` enum's variant named `name` (Less/Equal/Greater),
// or 0 if `Ordering` is not declared. Used to lower Ord comparisons.
fn orderingVariantIndex(c: inout Comp, name: String) -> U64 {
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if rangeEquals(bytes: c.bytes, start: e.nameStart, len: e.nameLen, kw: "Ordering") {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                if rangeEquals(bytes: c.bytes, start: vars[vi].nameStart, len: vars[vi].nameLen, kw: name) {
                    return vi
                }
                vi += 1
            }
        }
        ei += 1
    }
    return 0
}

// Whether the operand type carries the witness an operator needs: Eq's `eq` for
// `==`/`!=`, Ord's `compare` for `< <= > >=` (spec/12). A named struct (kind 2) OR
// a primitive scalar (kind 0 with a type name) whose type conforms desugars to the
// witness — primitives are not special-cased (O6): `I32 < I32` routes through Core's
// `impl I32 as Ord` to the `i32Lt` intrinsic. An untyped literal / String / enum has
// no Eq/Ord here and keeps its own lowering (the dispatch handles those first).
fn hasCompareWitness(c: inout Comp, op: I64, lhs: U64) -> Bool {
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    if lt.kind == 2 || lt.kind == 0 {
        if lt.nameLen == 0 {
            return false
        }
        // `==`/`!=` desugar to Eq.eq; gated on an explicit `impl T as Eq` (spec/12:
        // operators are trait sugar, not implicit). `< <= > >=` likewise on Ord.
        if op == opEq() {
            return eqWitnessReady(c: inout c, ti: lt)
        }
        if op == opNe() {
            return eqWitnessReady(c: inout c, ti: lt)
        }
        if op >= 52 {
            if op <= 55 {
                if typeConformsToName(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, traitName: "Ord") {
                    return findAssocByName(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, name: "compare") < c.funcs.count
                }
            }
        }
    }
    return false
}

// Whether the operand type both conforms to Eq and carries the `eq` witness.
fn eqWitnessReady(c: inout Comp, ti: TypeInfo) -> Bool {
    if typeConformsToName(c: inout c, typeStart: ti.nameStart, typeLen: ti.nameLen, traitName: "Eq") {
        return findAssocByName(c: inout c, typeStart: ti.nameStart, typeLen: ti.nameLen, name: "eq") < c.funcs.count
    }
    return false
}

// Emit `T_eq_...(lhs, rhs)` for the Eq witness assoc fn.
fn emitEqCall(c: inout Comp, typeStart: U64, typeLen: U64, lhs: U64, rhs: U64) {
    val fi: U64 = findAssocByName(c: inout c, typeStart: typeStart, typeLen: typeLen, name: "eq")
    writeSpan(c: inout c, start: typeStart, len: typeLen)
    write(s: "_")
    writeFnSelector(c: inout c, f: c.funcs[fi])
    write(s: "(")
    genExpr(c: inout c, id: lhs)
    write(s: ", ")
    genExpr(c: inout c, id: rhs)
    write(s: ")")
}

// Lower an Eq/Ord comparison on a struct to its trait witness (spec/12):
// `==` -> eq, `!=` -> !eq, and `< <= > >=` -> a tag test on `compare`'s Ordering
// (`a<b` ⟺ compare(a,b) == Less, `a<=b` ⟺ != Greater, etc.).
fn emitTraitCompare(c: inout Comp, op: I64, lhs: U64, rhs: U64) {
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    if op == opEq() {
        emitEqCall(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, lhs: lhs, rhs: rhs)
        return
    }
    if op == opNe() {
        write(s: "(!")
        emitEqCall(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, lhs: lhs, rhs: rhs)
        write(s: ")")
        return
    }
    val ci: U64 = findAssocByName(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, name: "compare")
    val lessIdx: U64 = orderingVariantIndex(c: inout c, name: "Less")
    val greaterIdx: U64 = orderingVariantIndex(c: inout c, name: "Greater")
    write(s: "(")
    writeSpan(c: inout c, start: lt.nameStart, len: lt.nameLen)
    write(s: "_")
    writeFnSelector(c: inout c, f: c.funcs[ci])
    write(s: "(")
    genExpr(c: inout c, id: lhs)
    write(s: ", ")
    genExpr(c: inout c, id: rhs)
    write(s: ").tag ")
    if op == opLt() {
        write(s: "== ")
        writeU64(n: lessIdx)
    }
    if op == opLe() {
        write(s: "!= ")
        writeU64(n: greaterIdx)
    }
    if op == opGt() {
        write(s: "== ")
        writeU64(n: greaterIdx)
    }
    if op == opGe() {
        write(s: "!= ")
        writeU64(n: lessIdx)
    }
    write(s: ")")
}

// Whether a binary op is a trait-dispatched operator (spec/12): arithmetic
// (Add/Sub/Mul/Div/Rem) or bitwise/shift (BitAnd/BitOr/BitXor/Shl/Shr). Comparison
// (Eq/Ord) and `&&`/`||`/`??` are handled separately.
fn isBinTraitOp(op: I64) -> Bool {
    if op == opAdd() { return true }
    if op == opSub() { return true }
    if op == opMul() { return true }
    if op == opDiv() { return true }
    if op == opRem() { return true }
    if op == opBitAnd() { return true }
    if op == opBitOr() { return true }
    if op == opBitXor() { return true }
    if op == opShl() { return true }
    if op == opShr() { return true }
    return false
}

// The operator trait name for a binary op (`+` -> "Add", `&` -> "BitAnd").
fn binTraitName(op: I64) -> String {
    if op == opAdd() { return "Add" }
    if op == opSub() { return "Sub" }
    if op == opMul() { return "Mul" }
    if op == opDiv() { return "Div" }
    if op == opRem() { return "Rem" }
    if op == opBitAnd() { return "BitAnd" }
    if op == opBitOr() { return "BitOr" }
    if op == opBitXor() { return "BitXor" }
    if op == opShl() { return "Shl" }
    return "Shr"
}

// The witness assoc-fn name for a binary op (`+` -> "add", `&` -> "bitand").
fn binTraitMethodName(op: I64) -> String {
    if op == opAdd() { return "add" }
    if op == opSub() { return "sub" }
    if op == opMul() { return "mul" }
    if op == opDiv() { return "div" }
    if op == opRem() { return "rem" }
    if op == opBitAnd() { return "bitand" }
    if op == opBitOr() { return "bitor" }
    if op == opBitXor() { return "bitxor" }
    if op == opShl() { return "shl" }
    return "shr"
}

// Resolve the arithmetic witness assoc fn named `name` on type (typeStart,typeLen),
// disambiguating right-operand overloads (`Mul[Vector]` vs `Mul[F64]`) by the rhs
// type: the assoc whose 2nd param type's head id matches typeOf(rhs). Falls back to
// the first assoc of that name (e.g. an untyped-literal rhs). c.funcs.count = none.
fn findBinTraitWitness(c: inout Comp, typeStart: U64, typeLen: U64, name: String, rhs: U64) -> U64 {
    val qType: U64 = intern(c: inout c, start: typeStart, len: typeLen)
    val rt: TypeInfo = typeOf(c: inout c, id: rhs)
    val rhsId: U64 = intern(c: inout c, start: rt.nameStart, len: rt.nameLen)
    // an unsuffixed integer literal has no recovered type (kind 0, no name); it can
    // adapt to any integer rhs, so prefer an overload whose rhs param is an int type.
    val rhsUntyped: Bool = rt.kind == 0 && rt.nameLen == 0
    mut val firstMatch: U64 = c.funcs.count
    mut val intMatch: U64 = c.funcs.count
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.isAssoc {
            if f.recvId == qType {
                if rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: name) {
                    if firstMatch == c.funcs.count {
                        firstMatch = i
                    }
                    if f.params.count >= 2 {
                        if f.params[1].tyNameId == rhsId {
                            return i
                        }
                        if intMatch == c.funcs.count {
                            if isIntType(c: inout c, start: f.params[1].tyStart, len: f.params[1].tyLen) {
                                intMatch = i
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    if rhsUntyped {
        if intMatch < c.funcs.count {
            return intMatch
        }
    }
    return firstMatch
}

// The type to use for an operator's witness lookup. A named struct (kind 2) or a
// typed scalar (kind 0 with a name) uses its own type; a width-less scalar (a
// `typeOf` that recovers no name — e.g. some method-return / chain forms) recovers
// the SHARED int type from both operands (Plew: operands share a type), so
// `someU64Fn() + 1` still finds `impl U64 as Add` rather than falling to built-in.
fn binWitnessType(c: inout Comp, lhs: U64, rhs: U64) -> TypeInfo {
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    if lt.kind == 2 {
        return lt
    }
    if lt.kind == 0 {
        if lt.nameLen > 0 {
            return lt
        }
    }
    return arithIntType(c: inout c, lhs: lhs, rhs: rhs)
}

// Whether an arithmetic op's operands carry the operator-trait witness (spec/12:
// `a + b` desugars to `T.add(lhs: a, rhs: b)` iff `impl T as Add[…]`). A named
// struct OR a primitive scalar (incl. width-less ones recovered from the sibling)
// whose type conforms desugars to the witness — primitives are not special-cased
// (O6). A genuinely typeless operand (untyped literal / String / array) keeps the
// built-in arithmetic (the fallback in the dispatch).
fn hasBinTraitWitness(c: inout Comp, op: I64, lhs: U64, rhs: U64) -> Bool {
    if isBinTraitOp(op: op) {
    } else {
        return false
    }
    val lt: TypeInfo = binWitnessType(c: inout c, lhs: lhs, rhs: rhs)
    if lt.kind == 2 || lt.kind == 0 {
        if lt.nameLen > 0 {
            if typeConformsToName(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, traitName: binTraitName(op: op)) {
                return findAssocByName(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, name: binTraitMethodName(op: op)) < c.funcs.count
            }
        }
    }
    return false
}

// A typed operand under an arithmetic op with no operator-trait witness: the C
// `+`/`-`/... has no meaning, so it is a loud error (spec/12: an operator is only
// callable when its trait is implemented), not a fall-through to clang. Covers a
// struct/enum (kind 2) and a known primitive with no conformance (e.g. arithmetic
// in a program that never loaded @Std/Core, so the primitive witnesses are absent).
fn binTraitNeedsTrait(c: inout Comp, op: I64, lhs: U64, rhs: U64) -> Bool {
    if isBinTraitOp(op: op) {
        val lt: TypeInfo = binWitnessType(c: inout c, lhs: lhs, rhs: rhs)
        if lt.kind == 2 {
            return true
        }
        if lt.kind == 0 {
            // any scalar operand under an arithmetic operator must resolve to a
            // witness (no built-in fast path): a known primitive with no witness
            // (no @Std/Core) and a width-less operand both error. [WIP: width-less
            // error is on to catch every typeOf gap before deleting the built-in.]
            return true
        }
    }
    return false
}

// Emit `T_<sel>(lhs, rhs)` for the resolved arithmetic witness assoc fn.
fn emitBinTraitCall(c: inout Comp, op: I64, lhs: U64, rhs: U64) {
    val lt: TypeInfo = binWitnessType(c: inout c, lhs: lhs, rhs: rhs)
    val fi: U64 = findBinTraitWitness(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, name: binTraitMethodName(op: op), rhs: rhs)
    writeSpan(c: inout c, start: lt.nameStart, len: lt.nameLen)
    write(s: "_")
    writeFnSelector(c: inout c, f: c.funcs[fi])
    write(s: "(")
    genExpr(c: inout c, id: lhs)
    write(s: ", ")
    genExpr(c: inout c, id: rhs)
    write(s: ")")
}

// The operator trait / witness names for a prefix unary op (spec/12): `-` -> Neg.neg,
// `!` -> Not.not, `~` -> BitNot.bitnot.
fn unaryTraitName(op: I64) -> String {
    if op == opSub() { return "Neg" }
    if op == opNot() { return "Not" }
    return "BitNot"
}
fn unaryMethodName(op: I64) -> String {
    if op == opSub() { return "neg" }
    if op == opNot() { return "not" }
    return "bitnot"
}

// Whether a prefix-unary operand carries the operator-trait witness (spec/12: `-x`
// desugars to `T.neg(value: x)` iff `impl T as Neg`). A named struct (kind 2) OR a
// primitive scalar (kind 0 with a type name) whose type conforms desugars to the
// witness (O6 — `-i: I64` routes through Core's `impl I64 as Neg`). An untyped
// literal / non-conforming scalar keeps the built-in negate / logical-not / bit-not.
// A leading `-` on a bare integer literal is folded into a negative literal at
// lower (`-128I8` is the literal -128, not Neg — spec/02), so it never reaches here
// as a Unary: only runtime operands do, which is where checked-overflow Neg belongs.
fn hasUnaryWitness(c: inout Comp, op: I64, operand: U64) -> Bool {
    val ot: TypeInfo = typeOf(c: inout c, id: operand)
    if ot.kind == 2 || ot.kind == 0 {
        if ot.nameLen > 0 {
            if typeConformsToName(c: inout c, typeStart: ot.nameStart, typeLen: ot.nameLen, traitName: unaryTraitName(op: op)) {
                return findAssocByName(c: inout c, typeStart: ot.nameStart, typeLen: ot.nameLen, name: unaryMethodName(op: op)) < c.funcs.count
            }
        }
    }
    return false
}

// A typed operand under a prefix unary op with no operator-trait witness is a loud
// error (spec/12), not a fall-through to a meaningless C `-`/`!`/`~`: a struct/enum
// (kind 2) and a known primitive with no witness (e.g. `-x` in a program that never
// loaded @Std/Core). A genuinely width-less operand keeps the plain built-in op.
fn unaryNeedsTrait(c: inout Comp, operand: U64) -> Bool {
    val ot: TypeInfo = typeOf(c: inout c, id: operand)
    if ot.kind == 2 {
        return true
    }
    if ot.kind == 0 {
        return ot.nameLen > 0
    }
    return false
}

// Emit `T_<sel>(operand)` for the resolved unary witness assoc fn.
fn emitUnaryCall(c: inout Comp, op: I64, operand: U64) {
    val ot: TypeInfo = typeOf(c: inout c, id: operand)
    val fi: U64 = findAssocByName(c: inout c, typeStart: ot.nameStart, typeLen: ot.nameLen, name: unaryMethodName(op: op))
    writeSpan(c: inout c, start: ot.nameStart, len: ot.nameLen)
    write(s: "_")
    writeFnSelector(c: inout c, f: c.funcs[fi])
    write(s: "(")
    genExpr(c: inout c, id: operand)
    write(s: ")")
}

// Emit an expression in condition position. A top-level binary drops its outer
// parens (the `if (...)` / `while (...)` already supplies them), which avoids
// the `-Wparentheses-equality` warning on `if ((a == b))`. String/enum equality
// have their own lowerings handled here too.
fn genCond(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Binary(val op, val lhs, val rhs) => {
            if isStringEq(c: inout c, op: op, lhs: lhs) {
                genExpr(c: inout c, id: id)
            } else {
                if hasCompareWitness(c: inout c, op: op, lhs: lhs) {
                    emitTraitCompare(c: inout c, op: op, lhs: lhs, rhs: rhs)
                } else {
                    if isEnumEq(c: inout c, op: op, lhs: lhs) {
                        emitEnumTagCmp(c: inout c, lhs: lhs, rhs: rhs, op: op, outer: false)
                    } else {
                        if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
                        } else {
                            genExpr(c: inout c, id: lhs)
                            write(s: binOpStr(op: op))
                            genExpr(c: inout c, id: rhs)
                        }
                    }
                }
            }
        }
        _ => { genExpr(c: inout c, id: id) }
    }
}

// `arr[i].field = v` -> get-modify-set (CLAUDE.md / spec/03): the element is a
// value, so we copy it out, set the field on the copy, and store it back via
// PlewArray_E_set (which bounds-checks and CoW-uniques). Returns true if it
// handled the assignment (target is a field of an array element), false to let
// the normal target dispatch run. Compound ops and inout-method-through-element
// are not handled here yet (see review-items.md).
fn tryArrayElemFieldAssign(c: inout Comp, op: I64, target: U64, value: U64) -> Bool {
    val te: Expr = c.exprs[target]
    match te {
        Expr.Field(val base, val nameStart, val nameLen) => {
            val be: Expr = c.exprs[base]
            match be {
                Expr.Index(base: val abase, index: val index) => {
                    val bt: TypeInfo = typeOf(c: inout c, id: abase)
                    if bt.kind == 3 {
                    } else {
                        return false
                    }
                    if placeIsMutable(c: inout c, id: target) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "cannot assign through this place; the binding and field must be declared `mut val`")
                        return true
                    }
                    val ft: TypeInfo = fieldType(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
                    if op == opAssign() {
                        checkLitTi(c: inout c, id: value, ti: ft)
                    }
                    // get-modify-set: store back `({ E __ge = get; __ge.field = …; __ge; })`.
                    // For `OP=` the new field value is computed from the current
                    // `__ge.field` with the same overflow/zero-divisor checks as a
                    // plain field compound-assign.
                    write(s: "    Array_")
                    writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                    write(s: "_set(&(")
                    genExpr(c: inout c, id: abase)
                    write(s: "), (long long)(")
                    genExpr(c: inout c, id: index)
                    write(s: "), ({ ")
                    genCElem(c: inout c, start: bt.nameStart, len: bt.nameLen)
                    write(s: " __ge = ")
                    genArrayGet(c: inout c, base: abase, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                    write(s: "; __ge.")
                    writeSpan(c: inout c, start: nameStart, len: nameLen)
                    write(s: " = ")
                    if op == opAssign() {
                        genExpr(c: inout c, id: value)
                    } else {
                        val cbin: I64 = compoundCheckedBin(op: op)
                        val fieldInt: Bool = isIntType(c: inout c, start: ft.nameStart, len: ft.nameLen)
                        if isCompoundDiv(op: op) {
                            write(s: compoundDivFn(op: op))
                            write(s: "__ge.")
                            writeSpan(c: inout c, start: nameStart, len: nameLen)
                            write(s: ", ")
                            genExpr(c: inout c, id: value)
                            write(s: ")")
                        } else {
                            mut val checkedF: Bool = false
                            if cbin != 0 {
                                if fieldInt {
                                    checkedF = true
                                }
                            }
                            if checkedF {
                                write(s: "({ ")
                                genCElem(c: inout c, start: ft.nameStart, len: ft.nameLen)
                                write(s: " __ov; if (")
                                write(s: overflowBuiltin(op: cbin))
                                write(s: "((__ge.")
                                writeSpan(c: inout c, start: nameStart, len: nameLen)
                                write(s: "), (")
                                genExpr(c: inout c, id: value)
                                write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
                            } else {
                                write(s: "__ge.")
                                writeSpan(c: inout c, start: nameStart, len: nameLen)
                                write(s: assignToBinStr(op: op))
                                genExpr(c: inout c, id: value)
                            }
                        }
                    }
                    write(s: "; __ge; }));\n")
                    return true
                }
                _ => { return false }
            }
        }
        _ => { return false }
    }
}

// Emit a struct destructuring match arm (irrefutable): bind each pattern field
// from the scrutinee temp and run the body. `arm.enumStart` names the struct.
fn emitStructMatch(c: inout Comp, scrut: U64, arm: MatchArm) {
    val t: U64 = c.tmp
    c.tmp = c.tmp + 1
    val st: TypeInfo = typeOf(c: inout c, id: scrut)
    val generic: Bool = isGenericInst(c: inout c, ref: st.ref)
    val mark: U64 = scopeMark(c: inout c)
    write(s: "    {\n    ")
    genCTypeOf(c: inout c, tyRef: st.ref, fallStart: st.nameStart, fallLen: st.nameLen, isArray: false)
    write(s: " _m")
    writeU64(n: t)
    write(s: " = ")
    genExpr(c: inout c, id: scrut)
    write(s: ";\n")
    val binds: Array[Bind] = arm.binds
    mut val bi: U64 = 0
    while bi < binds.count {
        val bd: Bind = binds[bi]
        mut val ft: TypeInfo = scalarInfo()
        if generic {
            ft = genericFieldTypeInfo(c: inout c, instRef: st.ref, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
        } else {
            ft = fieldType(c: inout c, structStart: st.nameStart, structLen: st.nameLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
        }
        write(s: "        ")
        genCTypeOf(c: inout c, tyRef: ft.ref, fallStart: ft.nameStart, fallLen: ft.nameLen, isArray: ft.kind == 3)
        write(s: " ")
        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
        write(s: " = _m")
        writeU64(n: t)
        write(s: ".")
        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
        write(s: ";\n        (void)")
        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
        write(s: ";\n")
        addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
        bi += 1
    }
    val savedBB: U64 = c.curBranchBase
    c.curBranchBase = mark
    genBlock(c: inout c, id: arm.body)
    c.curBranchBase = savedBB
    scopeExit(c: inout c, mark: mark)
    write(s: "    }\n")
}

// Field type of a struct-destructure bind given the element type `et` (a struct,
// possibly a generic instance). Shared by the for-loop destructure across the
// check/mono/codegen passes so they agree on each bound field's type.
fn forBindFieldType(c: inout Comp, et: TypeInfo, bd: Bind) -> TypeInfo {
    if isGenericInst(c: inout c, ref: et.ref) {
        return genericFieldTypeInfo(c: inout c, instRef: et.ref, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
    }
    return fieldType(c: inout c, structStart: et.nameStart, structLen: et.nameLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
}

// Add a for-loop struct-destructure's binds as locals (element type `et`), so the
// body's references to the bound names resolve. Used by the check and mono scans
// and by codegen (which also emits the C initializers).
fn addForStructBinds(c: inout Comp, et: TypeInfo, binds: Array[Bind]) {
    mut val bi: U64 = 0
    while bi < binds.count {
        val bd: Bind = binds[bi]
        val ft: TypeInfo = forBindFieldType(c: inout c, et: et, bd: bd)
        addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
        bi += 1
    }
}

// A `for x in iterable` over a user type that conforms to Iterable: desugar to
// the iterator protocol — `it = iterable.iterator(); while { match it.next() {
// Some(v) => { x = v; body } None => break } }`. The array and range iterands
// keep their fast paths (handled in the For arm); this covers any struct that
// has an `iterator()` method. The iterator and Item types are recovered from the
// method return types (concrete instantiations for now; generic iterables and
// the iterator struct's ARC drop are later steps).
fn compileIterableFor(c: inout Comp, t: U64, varStart: U64, varLen: U64, iter: U64, body: U64, et: TypeInfo) {
    val noArgs: Array[Arg] = []
    // An Iterable iterand has `iterator()` (returning a fresh iterator); a bare
    // Iterator iterand has only `next()` and is its own iterator (so `for v in
    // xs.filter(p)` works). Pick the iterator's type ref + fallback name span + the
    // init expression accordingly.
    val itName: Bind = kwSpan(c: inout c, kw: "iterator", kwLen: 8)
    val imi: U64 = findMethod(c: inout c, recvStart: et.nameStart, recvLen: et.nameLen, nameStart: itName.nameStart, nameLen: itName.nameLen, args: noArgs)
    mut val itRef: U64 = 0
    mut val itFallStart: U64 = 0
    mut val itFallLen: U64 = 0
    mut val itFallArr: Bool = false
    mut val isIterable: Bool = false
    if imi == c.funcs.count {
        // not Iterable: the iterand is itself the iterator (its type is the iterator).
        itRef = et.ref
        itFallStart = et.nameStart
        itFallLen = et.nameLen
    } else {
        // Iterable: resolve the iterator instantiation through the (possibly generic)
        // iterand (`Box[I64].iterator()` -> `BoxIter[I64]`, not the template).
        isIterable = true
        val imf: Func = c.funcs[imi]
        itRef = groundUnderInst(c: inout c, instRef: et.ref, tyRef: imf.retTy)
        itFallStart = imf.retStart
        itFallLen = imf.retLen
        itFallArr = imf.retIsArray
    }
    val itGeneric: Bool = isGenericInst(c: inout c, ref: itRef)
    // next(): find on the iterator type, recover Optional[Item] -> Item.
    val nxName: Bind = kwSpan(c: inout c, kw: "next", kwLen: 4)
    val nmi: U64 = findMethod(c: inout c, recvStart: itFallStart, recvLen: itFallLen, nameStart: nxName.nameStart, nameLen: nxName.nameLen, args: noArgs)
    if nmi == c.funcs.count {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: iter)), msg: "type is not iterable: no `iterator()` or `next()` method (conform to Iterable or Iterator)")
        return
    }
    val nmf: Func = c.funcs[nmi]
    // next() lives on the iterator type; resolve its Optional[Item] through itRef
    // so a generic iterator yields the concrete element (`Optional[I64]`).
    val optRef: U64 = groundUnderInst(c: inout c, instRef: itRef, tyRef: nmf.retTy)
    // Item = the type argument of the Optional[Item] that next() returns.
    mut val itemRef: U64 = 0
    if optRef < c.types.count {
        val ot: TypeRef = c.types[optRef]
        if ot.args.count > 0 {
            itemRef = ot.args[0]
        }
    }
    val itemInfo: TypeInfo = typeInfoOfRef(c: inout c, ref: itemRef)
    val itemIsArr: Bool = itemInfo.kind == 3
    // { IterT __it = recv.iterator()  (Iterable)  |  recv  (bare Iterator);
    write(s: "    {\n")
    write(s: "    ")
    genCTypeOf(c: inout c, tyRef: itRef, fallStart: itFallStart, fallLen: itFallLen, isArray: itFallArr)
    write(s: " __it")
    writeU64(n: t)
    write(s: " = ")
    if isIterable {
        if isGenericInst(c: inout c, ref: et.ref) {
            emitMangle(c: inout c, ref: et.ref)
        } else {
            writeSpan(c: inout c, start: et.nameStart, len: et.nameLen)
        }
        write(s: "_iterator(")
        genExpr(c: inout c, id: iter)
        write(s: ")")
    } else {
        genExpr(c: inout c, id: iter)
    }
    write(s: ";\n")
    // while (1) { OptT __o = Iter_next(&__it); if (__o.tag != 0) break;
    write(s: "    while (1) {\n")
    write(s: "        ")
    genCTypeOf(c: inout c, tyRef: optRef, fallStart: nmf.retStart, fallLen: nmf.retLen, isArray: nmf.retIsArray)
    write(s: " __o")
    writeU64(n: t)
    write(s: " = ")
    if itGeneric {
        emitMangle(c: inout c, ref: itRef)
    } else {
        writeSpan(c: inout c, start: itFallStart, len: itFallLen)
    }
    write(s: "_next(&__it")
    writeU64(n: t)
    write(s: ");\n")
    write(s: "        if (__o")
    writeU64(n: t)
    write(s: ".tag != 0) { break; }\n")
    // ElemT var = __o.data.Some.v;
    write(s: "        ")
    genCTypeOf(c: inout c, tyRef: itemRef, fallStart: itemInfo.nameStart, fallLen: itemInfo.nameLen, isArray: itemIsArr)
    write(s: " ")
    writeSpan(c: inout c, start: varStart, len: varLen)
    write(s: " = __o")
    writeU64(n: t)
    write(s: ".data.Some.v;\n")
    addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: itemInfo.nameStart, tyLen: itemInfo.nameLen, isArray: itemIsArr, ty: itemRef, isInout: false, isMut: false, owned: false)
    genBlock(c: inout c, id: body)
    write(s: "    }\n    }\n")
}

fn genStmt(c: inout Comp, id: U64) {
    val s: Stmt = c.stmts[id]
    match s {
        Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
            // No annotation (`val x = expr`): infer the binding's type from the
            // initializer (shared with the async frame-field collection). Without
            // this the type stays empty and genCTypeOf falls back to `long long`,
            // miscompiling every non-integer initializer (String/Array/struct/Ref/
            // call result/var copy). TypeInfo kinds: 0 scalar 1 String 2 named 3 array.
            val le: LetEff = inferLetType(c: inout c, tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
            val effStart: U64 = le.start
            val effLen: U64 = le.len
            val effArr: Bool = le.arr
            val effTy: U64 = le.ty
            // an async fn lowers each top-level binding to a frame-struct field
            // (`__f->name = init`) so its value survives `await` suspensions.
            if c.curAsync {
                genAsyncLet(c: inout c, nameStart: nameStart, nameLen: nameLen, effStart: effStart, effLen: effLen, effArr: effArr, effTy: effTy, init: init, mutable: mutable)
                return
            }
            checkLitSpan(c: inout c, id: init, tyStart: effStart, tyLen: effLen, isArray: effArr)
            // unique values are move-only: `val g = f` (a bare unique place) is a
            // forbidden copy — require `val g = move f`.
            checkUniquePlaceCopy(c: inout c, exprId: init, inoutOk: false)
            // shadowing (spec/03,11 — unlimited): if this name already names a
            // live local, give the C variable a fresh suffix so two same-named
            // bindings in one block don't collide. Computed before addLocal so it
            // counts only the prior bindings.
            val cnum: U64 = shadowCount(c: inout c, nameStart: nameStart, nameLen: nameLen)
            // a `mut val` captured by a closure is heap-boxed (an implicit ARC
            // cell) so the closure and this scope share one storage. The C local
            // is a pointer; reads/writes dereference it (genExpr handles that).
            if isBoxedLocalAt(c: inout c, nameStart: nameStart) {
                write(s: "    ")
                genCTypeOf(c: inout c, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: effArr)
                write(s: "* ")
                writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
                write(s: " = (")
                genCTypeOf(c: inout c, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: effArr)
                write(s: "*)plew_arc_alloc(sizeof(")
                genCTypeOf(c: inout c, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: effArr)
                write(s: ")); *")
                writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
                write(s: " = ")
                genExpr(c: inout c, id: init)
                write(s: ";\n")
                addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: effStart, tyLen: effLen, isArray: effArr, ty: effTy, isInout: false, isMut: mutable, owned: true, cnum: cnum)
                return
            }
            write(s: "    ")
            genCTypeOf(c: inout c, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: effArr)
            write(s: " ")
            writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
            write(s: " = ")
            if effArr {
                genArrayValue(c: inout c, exprId: init, elemStart: effStart, elemLen: effLen)
            } else {
                // CoW: both mutable and immutable bindings share-on-bind (structs
                // retain heap fields; scalars/Strings/fresh values emit directly).
                // The mutable/immutable split now only governs assignability.
                genCopyValue(c: inout c, exprId: init, tyRef: effTy, fallStart: effStart, fallLen: effLen, isArray: false)
            }
            write(s: ";\n")
            addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: effStart, tyLen: effLen, isArray: effArr, ty: effTy, isInout: false, isMut: mutable, owned: true, cnum: cnum)
        }
        Stmt.Assign(val op, val target, val value) => {
            // place mutation through an array element: `arr[i].field = v`
            // (CLAUDE.md / spec/03 — get-modify-set). Without this the generic
            // Field path emits `PlewArray_E_get(...).field = v`, an unassignable
            // rvalue. Handle it before the normal target dispatch.
            if tryArrayElemFieldAssign(c: inout c, op: op, target: target, value: value) {
                return
            }
            val te: Expr = c.exprs[target]
            match te {
                Expr.Index(val base, val index) => {
                    // a[i] = v / a[i] OP= v -> bounds-checked PlewArray_E_set.
                    // The array binding must be a mutable place (mutating an
                    // element is a mutation of the array value).
                    if placeIsMutable(c: inout c, id: base) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "cannot assign to an element of an immutable binding; declare it with `mut val`")
                        return
                    }
                    val bt: TypeInfo = typeOf(c: inout c, id: base)
                    // `dict[k] = v` (spec/02): the Dictionary subscript-set desugars to
                    // `.insert(key: k, value: v)` (insert-or-update). Compound forms
                    // (`dict[k] += v`) are not yet supported.
                    if isDictionaryType(c: inout c, ti: bt) {
                        if op == opAssign() {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "compound assignment to a dictionary element is not supported; use `dict[k] = ...`")
                            return
                        }
                        write(s: "    ")
                        val mexpr: U64 = synthDictMethod(c: inout c, recv: base, name: "insert", arg0Label: "key", arg0: index, hasArg1: true, arg1Label: "value", arg1: value)
                        genExpr(c: inout c, id: mexpr)
                        write(s: ";\n")
                        return
                    }
                    if bt.kind == 3 {
                        checkLitSpan(c: inout c, id: value, tyStart: bt.nameStart, tyLen: bt.nameLen, isArray: false)
                    }
                    write(s: "    Array_")
                    writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
                    write(s: "_set(&(")
                    genExpr(c: inout c, id: base)
                    write(s: "), (long long)(")
                    genExpr(c: inout c, id: index)
                    write(s: "), ")
                    if op == opAssign() {
                        genExpr(c: inout c, id: value)
                    } else {
                        // `a[i] OP= v` -> set(a, i, get(a, i) OP v). Arithmetic
                        // is overflow-checked, `/=`/`%=` route through the checked
                        // plew_div/plew_mod (zero divisor / INT64_MIN -1), same as
                        // `a[i] = a[i] OP v`.
                        val cbin: I64 = compoundCheckedBin(op: op)
                        val elemInt: Bool = isIntType(c: inout c, start: bt.nameStart, len: bt.nameLen)
                        if isCompoundDiv(op: op) {
                            write(s: compoundDivFn(op: op))
                            genArrayGet(c: inout c, base: base, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                            write(s: ", ")
                            genExpr(c: inout c, id: value)
                            write(s: ")")
                        } else {
                            mut val checkedElem: Bool = false
                            if cbin != 0 {
                                if elemInt {
                                    checkedElem = true
                                }
                            }
                            if checkedElem {
                                write(s: "({ ")
                                genCElem(c: inout c, start: bt.nameStart, len: bt.nameLen)
                                write(s: " __ov; if (")
                                write(s: overflowBuiltin(op: cbin))
                                write(s: "((")
                                genArrayGet(c: inout c, base: base, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                                write(s: "), (")
                                genExpr(c: inout c, id: value)
                                write(s: "), &__ov)) plew_panic((PlewString){\"integer overflow\", 16}); __ov; })")
                            } else {
                                genArrayGet(c: inout c, base: base, index: index, elemStart: bt.nameStart, elemLen: bt.nameLen)
                                write(s: assignToBinStr(op: op))
                                genExpr(c: inout c, id: value)
                            }
                        }
                    }
                    write(s: ");\n")
                }
                _ => {
                    // Acceptance soundness: the target must be a mutable place.
                    // A plain `val` binding is immutable (only `mut val` locals /
                    // `inout` params assign); a `base.field` target additionally
                    // needs the field declared `mut val` (composite mutability).
                    if placeIsMutable(c: inout c, id: target) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "cannot assign to an immutable place; the binding and field must be declared `mut val`")
                        return
                    }
                    // member visibility (spec/05): writing `base.field` needs the
                    // field externally writable — only `pub` (vis 2); private and
                    // pub(get) are writable only inside the type's anonymous impl.
                    match c.exprs[target] {
                        Expr.Field(val base, val nameStart, val nameLen) => {
                            val fbt: TypeInfo = typeOf(c: inout c, id: base)
                            if fbt.kind == 2 {
                                checkFieldWriteVis(c: inout c, ownerStart: fbt.nameStart, ownerLen: fbt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
                                // boxed (recursive) field write: repoint the pointer to a
                                // FRESH heap cell rather than mutate the (possibly shared)
                                // cell in place — preserves value semantics. Plain `=` only
                                // (boxed fields are struct/enum values, never arithmetic).
                                val afd: FieldDef = findFieldDef(c: inout c, typeStart: fbt.nameStart, typeLen: fbt.nameLen, variantStart: 0, variantLen: 0, isEnum: false, fieldStart: nameStart, fieldLen: nameLen)
                                if afd.nameLen > 0 {
                                    if fieldIsBoxed(c: inout c, f: afd) {
                                        if op == opAssign() {
                                            write(s: "    ")
                                            genExpr(c: inout c, id: base)
                                            write(s: ".")
                                            writeSpan(c: inout c, start: nameStart, len: nameLen)
                                            write(s: " = ")
                                            genBoxCell(c: inout c, fd: afd, valueId: value)
                                            write(s: ";\n")
                                            return
                                        }
                                    }
                                }
                            } else {
                                if fbt.kind == 3 {
                                    val arrW: Bind = kwSpan(c: inout c, kw: "Array", kwLen: 5)
                                    checkFieldWriteVis(c: inout c, ownerStart: arrW.nameStart, ownerLen: arrW.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
                                }
                            }
                        }
                        _ => {}
                    }
                    val ctt: TypeInfo = typeOf(c: inout c, id: target)
                    // reassigning a unique place: deinit the previous value first
                    // (deterministic — it would otherwise be skipped), then store the
                    // new one. The RHS must be moved/fresh, not a copied place (which
                    // would double-deinit). Only plain `=` is valid for a unique.
                    if ctt.kind == 2 {
                        if typeIsUnique(c: inout c, start: ctt.nameStart, len: ctt.nameLen) {
                            if op == opAssign() {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "compound assignment is not valid for a unique value")
                                return
                            }
                            checkUniquePlaceCopy(c: inout c, exprId: value, inoutOk: false)
                            write(s: "    ")
                            if structHasDeinit(c: inout c, start: ctt.nameStart, len: ctt.nameLen) {
                                writeSpan(c: inout c, start: ctt.nameStart, len: ctt.nameLen)
                                write(s: "_deinit(")
                                genExpr(c: inout c, id: target)
                                write(s: "); ")
                            }
                            if structNeedsRelease(c: inout c, start: ctt.nameStart, len: ctt.nameLen) {
                                writeSpan(c: inout c, start: ctt.nameStart, len: ctt.nameLen)
                                write(s: "_release(")
                                genExpr(c: inout c, id: target)
                                write(s: "); ")
                            }
                            genExpr(c: inout c, id: target)
                            write(s: " = ")
                            genCopyValue(c: inout c, exprId: value, tyRef: ctt.ref, fallStart: ctt.nameStart, fallLen: ctt.nameLen, isArray: false)
                            write(s: ";\n")
                            return
                        }
                    }
                    if ctt.kind == 3 {
                        checkLitArray(c: inout c, id: value, elemStart: ctt.nameStart, elemLen: ctt.nameLen)
                    } else {
                        checkLitTi(c: inout c, id: value, ti: ctt)
                    }
                    write(s: "    ")
                    genExpr(c: inout c, id: target)
                    if op == opAssign() {
                        // plain assignment: value semantics (CoW copy of the rhs).
                        val tt: TypeInfo = typeOf(c: inout c, id: target)
                        write(s: " = ")
                        genCopyValue(c: inout c, exprId: value, tyRef: tt.ref, fallStart: tt.nameStart, fallLen: tt.nameLen, isArray: tt.kind == 3)
                    } else {
                        // `target OP= value` desugars to `target = target OP value`
                        // (spec/12 pure desugar; the place has no side effects in this
                        // subset, so re-evaluating it is observationally identical).
                        // The `OP` routes through the operator-trait witness like any
                        // binary — primitives are not special-cased (O6).
                        val binOp: I64 = compoundBinOp(op: op)
                        write(s: " = ")
                        if hasBinTraitWitness(c: inout c, op: binOp, lhs: target, rhs: value) {
                            emitBinTraitCall(c: inout c, op: binOp, lhs: target, rhs: value)
                        } else {
                            if binTraitNeedsTrait(c: inout c, op: binOp, lhs: target, rhs: value) {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "compound-assignment operator needs its trait (Add/Sub/.../BitAnd/...); not implemented for this type")
                            } else {
                                // built-in fallback for a width-less place (no witness
                                // recoverable): checked div / plain op, like a binary.
                                if isCompoundDiv(op: op) {
                                    write(s: compoundDivFn(op: op))
                                    genExpr(c: inout c, id: target)
                                    write(s: ", ")
                                    genExpr(c: inout c, id: value)
                                    write(s: ")")
                                } else {
                                    write(s: "(")
                                    genExpr(c: inout c, id: target)
                                    write(s: assignToBinStr(op: op))
                                    genExpr(c: inout c, id: value)
                                    write(s: ")")
                                }
                            }
                        }
                    }
                    write(s: ";\n")
                }
            }
        }
        Stmt.ExprStmt(val expr) => {
            // a bare `await e` (discarded) inside an async fn suspends, ignoring
            // the resolved value.
            if c.curAsync {
                match c.exprs[expr] {
                    Expr.Await(val operand) => {
                        emitAsyncSuspend(c: inout c, operandId: operand)
                        return
                    }
                    _ => {}
                }
            }
            checkLitCtx(c: inout c, id: expr, eKind: 0, eBits: 0, eSgn: false)
            write(s: "    ")
            genExpr(c: inout c, id: expr)
            write(s: ";\n")
        }
        Stmt.Return(val value, val hasValue) => {
            // inside an async fn, `return e` resolves the frame's `__self` promise
            // (a `return await e` first suspends) and frees the frame.
            if c.curAsync {
                genAsyncReturn(c: inout c, value: value, hasValue: hasValue)
                return
            }
            // ARC: a return exits every enclosing scope, so release all owned
            // locals here (emitScopeDrops from 0; params are borrows, skipped).
            // The return value is captured into a temp first — a returned local
            // shares its buffer into the temp (retain) and is then released
            // (net-zero), handing the caller a balanced reference.
            if c.curIsMain {
                emitScopeDrops(c: inout c, mark: 0, exclIdx: c.locals.count)
                write(s: "    return 0;\n")
            } else {
                if c.curRetVoid {
                    emitScopeDrops(c: inout c, mark: 0, exclIdx: c.locals.count)
                    emitSelfDeinit(c: inout c)
                    write(s: "    return;\n")
                } else {
                    if hasValue {
                        checkLitSpan(c: inout c, id: value, tyStart: c.curRetStart, tyLen: c.curRetLen, isArray: c.curRetIsArray)
                    }
                    val rt: U64 = c.tmp
                    c.tmp = c.tmp + 1
                    write(s: "    { ")
                    genCTypeOf(c: inout c, tyRef: c.curRetTy, fallStart: c.curRetStart, fallLen: c.curRetLen, isArray: c.curRetIsArray)
                    write(s: " __ret")
                    writeU64(n: rt)
                    write(s: " = ")
                    if hasValue {
                        // value semantics: returning a place array/struct hands
                        // back an independent (CoW-shared) value, so the caller
                        // cannot mutate the callee's source (e.g. `return self.items`).
                        genCopyValue(c: inout c, exprId: value, tyRef: c.curRetTy, fallStart: c.curRetStart, fallLen: c.curRetLen, isArray: c.curRetIsArray)
                    } else {
                        write(s: "0")
                    }
                    write(s: ";\n")
                    // returning a unique place consumes it: exclude that one local
                    // from THIS exit's drops so the callee doesn't deinit the value
                    // the caller now owns. The exclusion is per-exit (not a
                    // persisted move), so a different return path still drops it —
                    // `if c { return a } return b` deinits the unreturned one on
                    // each path. A unique field/element return is a partial move
                    // (untracked) and is rejected.
                    mut val retExcl: U64 = c.locals.count
                    if hasValue {
                        val vt: TypeInfo = typeOf(c: inout c, id: value)
                        if vt.kind == 2 {
                            if typeIsUnique(c: inout c, start: vt.nameStart, len: vt.nameLen) {
                                match c.exprs[value] {
                                    Expr.Ident(val start, val len) => {
                                        if c.curSelfMove {
                                            if isSelfRef(c: inout c, start: start, len: len) {
                                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: value)), msg: "returning `self` from a `move fn` is not yet supported")
                                            }
                                        }
                                        retExcl = localIndexByName(c: inout c, start: start, len: len)
                                    }
                                    Expr.Field(val base, val nameStart, val nameLen) => {
                                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: value)), msg: "returning a field of a unique value is a partial move (not yet supported)")
                                    }
                                    Expr.Index(val base, val index) => {
                                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: value)), msg: "returning an element of a unique value is a partial move (not yet supported)")
                                    }
                                    _ => {}
                                }
                            }
                        }
                    }
                    emitScopeDrops(c: inout c, mark: 0, exclIdx: retExcl)
                    emitSelfDeinit(c: inout c)
                    write(s: "    return __ret")
                    writeU64(n: rt)
                    write(s: "; }\n")
                }
            }
        }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            checkLitCtx(c: inout c, id: cond, eKind: 0, eBits: 0, eSgn: false)
            write(s: "    if (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            // moves inside a branch may only consume locals declared in the branch
            // (a conditional move of an outer local is unsound — see curBranchBase).
            val savedBB: U64 = c.curBranchBase
            c.curBranchBase = scopeMark(c: inout c)
            genBlock(c: inout c, id: thenBlk)
            write(s: "    }\n")
            if hasElse {
                write(s: "    else {\n")
                c.curBranchBase = scopeMark(c: inout c)
                genBlock(c: inout c, id: elseBlk)
                write(s: "    }\n")
            }
            c.curBranchBase = savedBB
        }
        Stmt.While(val cond, val body) => {
            checkLitCtx(c: inout c, id: cond, eKind: 0, eBits: 0, eSgn: false)
            write(s: "    while (")
            genCond(c: inout c, id: cond)
            write(s: ") {\n")
            val savedLoopMark: U64 = c.curLoopMark
            c.curLoopMark = scopeMark(c: inout c)
            val savedBB: U64 = c.curBranchBase
            c.curBranchBase = scopeMark(c: inout c)
            genBlock(c: inout c, id: body)
            c.curBranchBase = savedBB
            c.curLoopMark = savedLoopMark
            write(s: "    }\n")
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            if isRange {
                // a loop-var type annotation (`for val i: I32 in 0..<5`) types the
                // range bounds, so bare literals need no suffix; otherwise both bounds
                // must determine their own type (checkArithNoCtx).
                if varTyLen != 0 {
                    checkLitSpan(c: inout c, id: iter, tyStart: varTyStart, tyLen: varTyLen, isArray: false)
                    checkLitSpan(c: inout c, id: rangeHi, tyStart: varTyStart, tyLen: varTyLen, isArray: false)
                } else {
                    checkArithNoCtx(c: inout c, lhs: iter, rhs: rangeHi)
                }
                if isStruct {
                    compileErrorAt(line: lineOf(c: inout c, offset: patStart), msg: "a struct-destructure for-loop iterates an array, not a range")
                }
            }
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            // the loop variable is scoped to the for-statement (popped below).
            val forMark: U64 = scopeMark(c: inout c)
            // break/continue inside the body release owned locals pushed since
            // here (the for-var is a borrow, so it is skipped). Save/restore for
            // nested loops.
            val savedLoopMark: U64 = c.curLoopMark
            c.curLoopMark = forMark
            val savedBB: U64 = c.curBranchBase
            c.curBranchBase = forMark
            if isRange {
                // for (long long var = lo; var (< | <=) __fe; var++) { body }
                write(s: "    {\n")
                write(s: "    long long __fe")
                writeU64(n: t)
                write(s: " = ")
                genExpr(c: inout c, id: rangeHi)
                write(s: ";\n")
                write(s: "    for (long long ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: " = ")
                genExpr(c: inout c, id: iter)
                write(s: "; ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                if inclusive {
                    write(s: " <= __fe")
                } else {
                    write(s: " < __fe")
                }
                writeU64(n: t)
                write(s: "; ")
                writeSpan(c: inout c, start: varStart, len: varLen)
                write(s: "++) {\n")
                // record the loop var with its type so the body sees `i: I32` (and
                // generic calls on it ground): the annotation if given, else the
                // bound's own type. Mirrors the mono scan (Mono.pw For).
                mut val ltS: U64 = varTyStart
                mut val ltL: U64 = varTyLen
                if ltL == 0 {
                    val bt2: TypeInfo = typeOf(c: inout c, id: rangeHi)
                    if bt2.kind == 0 {
                        ltS = bt2.nameStart
                        ltL = bt2.nameLen
                    }
                }
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: ltS, tyLen: ltL, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            } else {
                // walk an array by index, binding `var` to each element
                val et: TypeInfo = typeOf(c: inout c, id: iter)
                if et.kind == 3 {
                } else {
                    // not an array: a general Iterable (struct with iterator()).
                    if isStruct {
                        compileErrorAt(line: lineOf(c: inout c, offset: patStart), msg: "a struct-destructure for-loop iterates an array, not an iterable")
                    }
                    compileIterableFor(c: inout c, t: t, varStart: varStart, varLen: varLen, iter: iter, body: body, et: et)
                    c.curBranchBase = savedBB
                    c.curLoopMark = savedLoopMark
                    scopeExit(c: inout c, mark: forMark)
                    return
                }
                write(s: "    {\n")
                write(s: "    ")
                wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                write(s: " __fa")
                writeU64(n: t)
                write(s: " = ")
                genExpr(c: inout c, id: iter)
                write(s: ";\n")
                write(s: "    for (long long __fi")
                writeU64(n: t)
                write(s: " = 0; __fi")
                writeU64(n: t)
                write(s: " < (long long)__fa")
                writeU64(n: t)
                write(s: ".count; __fi")
                writeU64(n: t)
                write(s: "++) {\n")
                if isStruct {
                    // the written pattern type must name the element struct.
                    if intern(c: inout c, start: patStart, len: patLen) == intern(c: inout c, start: et.nameStart, len: et.nameLen) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: patStart), msg: "for-loop destructure pattern type does not match the element type")
                    }
                    // copy the element into a temp, then bind each field from it.
                    write(s: "        ")
                    genCElem(c: inout c, start: et.nameStart, len: et.nameLen)
                    write(s: " __fe")
                    writeU64(n: t)
                    write(s: " = ")
                    wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                    write(s: "_get(__fa")
                    writeU64(n: t)
                    write(s: ", __fi")
                    writeU64(n: t)
                    write(s: ");\n")
                    mut val bi: U64 = 0
                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        val ft: TypeInfo = forBindFieldType(c: inout c, et: et, bd: bd)
                        write(s: "        ")
                        genCTypeOf(c: inout c, tyRef: ft.ref, fallStart: ft.nameStart, fallLen: ft.nameLen, isArray: ft.kind == 3)
                        write(s: " ")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: " = __fe")
                        writeU64(n: t)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
                        write(s: ";\n        (void)")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: ";\n")
                        bi += 1
                    }
                    addForStructBinds(c: inout c, et: et, binds: binds)
                } else {
                    write(s: "        ")
                    genCElem(c: inout c, start: et.nameStart, len: et.nameLen)
                    write(s: " ")
                    writeSpan(c: inout c, start: varStart, len: varLen)
                    write(s: " = ")
                    wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                    write(s: "_get(__fa")
                    writeU64(n: t)
                    write(s: ", __fi")
                    writeU64(n: t)
                    write(s: ");\n")
                    addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                }
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            }
            c.curBranchBase = savedBB
            c.curLoopMark = savedLoopMark
            scopeExit(c: inout c, mark: forMark)
        }
        Stmt.Panic(val msg, val offset) => {
            // diverging: plew_panic is noreturn (writes the message + exit(1)).
            write(s: "    plew_panic(")
            genExpr(c: inout c, id: msg)
            write(s: ");\n")
        }
        Stmt.Give(val value) => {
