            // per-path move handling. Reject loudly (a bare place would double
            // deinit; a `give move` of an outer local would be a conditional move).
            // Use a statement-form if/match with the binding outside.
            val gvt: TypeInfo = typeOf(c: inout c, id: value)
            if gvt.kind == 2 {
                if typeIsUnique(c: inout c, start: gvt.nameStart, len: gvt.nameLen) {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: value)), msg: "a value-position if/match cannot yield a unique value yet; use a statement form")
                }
            }
            // assign the active value-position block's result temp (set by the
            // enclosing IfExpr/MatchExpr lowering).
            if c.curGiveTmp != 0 {
                write(s: "    __r")
                writeU64(n: c.curGiveTmp - 1)
                write(s: " = (")
                genExpr(c: inout c, id: value)
                write(s: ");\n")
            }
        }
        Stmt.Break => {
            // break exits the loop: release owned locals pushed in the body.
            emitScopeDrops(c: inout c, mark: c.curLoopMark, exclIdx: c.locals.count)
            write(s: "    break;\n")
        }
