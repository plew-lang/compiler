                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        val ft: TypeInfo = forBindFieldType(c: inout c, et: et, bd: bd)
                        write(s: "        ")
                        genCTypeOf(c: inout c, tyRef: ft.ref, fallStart: ft.nameStart, fallLen: ft.nameLen, isArray: ft.kind == 3)
                        write(s: " ")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: " = __fe")
                        writeU64(n: t)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
                        write(s: ";\n        (void)")
                        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        write(s: ";\n")
                        bi += 1
                    }
                    addForStructBinds(c: inout c, et: et, binds: binds)
                } else {
                    write(s: "        ")
                    genCElem(c: inout c, start: et.nameStart, len: et.nameLen)
                    write(s: " ")
                    writeSpan(c: inout c, start: varStart, len: varLen)
                    write(s: " = ")
                    wPA(c: inout c, elemStart: et.nameStart, elemLen: et.nameLen)
                    write(s: "_get(__fa")
                    writeU64(n: t)
                    write(s: ", __fi")
                    writeU64(n: t)
                    write(s: ");\n")
                    addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                }
                genBlock(c: inout c, id: body)
                write(s: "    }\n    }\n")
            }
            c.curBranchBase = savedBB
            c.curLoopMark = savedLoopMark
            scopeExit(c: inout c, mark: forMark)
        }
        Stmt.Panic(val msg, val offset) => {
            // diverging: plew_panic is noreturn (writes the message + exit(1)).
            write(s: "    plew_panic(")
            genExpr(c: inout c, id: msg)
            write(s: ");\n")
        }
        Stmt.Give(val value) => {
            // A value-position block (if/match expression) yielding a unique value
            // is not supported yet: the result temp vs the block's scope drops need
            // per-path move handling. Reject loudly (a bare place would double
            // deinit; a `give move` of an outer local would be a conditional move).
            // Use a statement-form if/match with the binding outside.
            val gvt: TypeInfo = exprType(c: inout c, id: value)
            if gvt.kind == 2 {
                if typeIsUnique(c: inout c, start: gvt.nameStart, len: gvt.nameLen) {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: value)), msg: "a value-position if/match cannot yield a unique value yet; use a statement form")
                }
            }
            // assign the active value-position block's result temp (set by the
            // enclosing IfExpr/MatchExpr lowering).
            if c.curGiveTmp != 0 {
                write(s: "    __r")
                writeU64(n: c.curGiveTmp - 1)
                write(s: " = (")
                genExpr(c: inout c, id: value)
                write(s: ");\n")
            }
        }
        Stmt.Break => {
            // break exits the loop: release owned locals pushed in the body.
            emitScopeDrops(c: inout c, mark: c.curLoopMark, exclIdx: c.locals.count)
            write(s: "    break;\n")
        }
        Stmt.Continue => {
            // continue ends the iteration: release the body's owned locals.
            emitScopeDrops(c: inout c, mark: c.curLoopMark, exclIdx: c.locals.count)
            write(s: "    continue;\n")
        }
        Stmt.Match(val scrut, val arms) => {
            // struct destructuring `match s { S { val x, val y } => … }`: the
            // pattern is irrefutable (a struct has one shape), so there is one arm
            // and no tag — bind the fields directly from the scrutinee temp.
            if arms.count > 0 {
                if arms[0].isStruct {
                    emitStructMatch(c: inout c, scrut: scrut, arm: arms[0])
                    return
                }
            }
            if matchExhaustive(c: inout c, arms: arms) {
            } else {
                // non-exhaustive match -> undeclared identifier so the C compile
                // fails loudly (spec: match must be exhaustive).
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: scrut)), msg: "match must be exhaustive: cover all variants or add a wildcard")
                return
            }
            val t: U64 = c.tmp
            c.tmp = c.tmp + 1
            // a generic enum scrutinee (`Optional[I32]`) lowers its temp to the
            // mangled C name and substitutes bind field types.
            val scrutRef: U64 = exprType(c: inout c, id: scrut).ref
            val genericMatch: Bool = isGenericEnumInst(c: inout c, ref: scrutRef)
            // enum type for the scrutinee temp = the enum named by the first
            // non-wildcard arm's pattern.
            mut val enumStart: U64 = 0
            mut val enumLen: U64 = 0
            mut val hasWildcard: Bool = false
            mut val q: U64 = 0
            while q < arms.count {
                val aq: MatchArm = arms[q]
                if aq.isWildcard {
                    hasWildcard = true
                } else {
                    if enumLen == 0 {
                        enumStart = aq.enumStart
                        enumLen = aq.enumLen
                    }
                }
                q += 1
            }
            write(s: "    {\n")
            write(s: "    ")
            if genericMatch {
                emitMangle(c: inout c, ref: scrutRef)
            } else {
                writeSpan(c: inout c, start: enumStart, len: enumLen)
            }
            write(s: " _m")
            writeU64(n: t)
            write(s: " = ")
            genExpr(c: inout c, id: scrut)
            write(s: ";\n")
            mut val i: U64 = 0
            mut val firstCond: Bool = true
            // each arm body is a branch: moves may only consume arm-local binds.
            val savedBB: U64 = c.curBranchBase
            while i < arms.count {
                val a: MatchArm = arms[i]
                if a.isWildcard {
                    write(s: "    else {\n")
                    c.curBranchBase = scopeMark(c: inout c)
                    genBlock(c: inout c, id: a.body)
                    write(s: "    }\n")
                } else {
                    if firstCond {
                        write(s: "    if (_m")
                        firstCond = false
                    } else {
                        write(s: "    else if (_m")
                    }
                    writeU64(n: t)
                    write(s: ".tag == ")
                    writeU64(n: variantIndex(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen))
                    write(s: ") {\n")
                    // pattern binds are scoped to this arm (popped below).
                    val armMark: U64 = scopeMark(c: inout c)
                    val binds: Array[Bind] = a.binds
                    mut val bi: U64 = 0
                    while bi < binds.count {
                        val bd: Bind = binds[bi]
                        // in an async fn the bind is a frame field (`__f->name_sN`)
                        // so it survives an await inside the arm; otherwise a normal
                        // C local. The payload read is identical.
                        mut val bcn: U64 = 0
                        if c.curAsync {
                            bcn = nextAsyncVar(c: inout c)
                            write(s: "        __f->")
                            writeNameCn(c: inout c, start: bd.nameStart, len: bd.nameLen, cnum: bcn)
                        } else {
                            write(s: "        ")
                            if genericMatch {
                                genBindTypeInst(c: inout c, instRef: scrutRef, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.fieldStart, bindLen: bd.fieldLen)
                            } else {
                                genBindType(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, bindStart: bd.fieldStart, bindLen: bd.fieldLen)
                            }
                            write(s: " ")
                            writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                        }
                        write(s: " = _m")
                        writeU64(n: t)
                        write(s: ".data.")
                        writeSpan(c: inout c, start: a.variantStart, len: a.variantLen)
                        write(s: ".")
                        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
                        write(s: ";\n")
                        if c.curAsync {
                            // (-w silences unused warnings; no `(void)` needed.)
                        } else {
                            // mark used so an unreferenced bind doesn't warn
                            write(s: "        (void)")
                            writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
                            write(s: ";\n")
                        }
                        if genericMatch {
                            val bti: TypeInfo = genericEnumFieldTypeInfo(c: inout c, instRef: scrutRef, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                            addLocalCn(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false, cnum: bcn)
                        } else {
                            addBindLocalCn(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen, cnum: bcn)
                        }
                        bi += 1
                    }
                    c.curBranchBase = armMark
                    genBlock(c: inout c, id: a.body)
                    scopeExit(c: inout c, mark: armMark)
                    write(s: "    }\n")
                }
                i += 1
            }
            c.curBranchBase = savedBB
            // exhaustive match without a wildcard: the final fall-through is
            // unreachable (so a value-returning function does not "fall off").
            if hasWildcard {
            } else {
                write(s: "    else { __builtin_unreachable(); }\n")
            }
            write(s: "    }\n")
        }
    }
}

fn genBlock(c: inout Comp, id: U64) {
    val mark: U64 = scopeMark(c: inout c)
    val b: Block = c.blocks[id]
    val stmts: Array[U64] = b.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        genStmt(c: inout c, id: stmts[i])
        i += 1
    }
    scopeExit(c: inout c, mark: mark)
}

