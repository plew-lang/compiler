// Part of the Plew compiler module (root: _.pw). Lowering: the shared @Std/Syntax
// body value tree (ExprAst / StmtAst / BlockAst / PatternAst) -> the compiler's
// arena (Expr / Stmt / Block / MatchArm). This is how the compiler frontend reuses
// the ONE shared parser (spec/16, worklog A): `parseBlock` drives the shared
// `parseBlockAst` over the compiler's own token stream and lowers the result here,
// so function bodies are parsed by exactly the code metaprogramming uses — no
// second parser to drift.
//
// Names: most are re-interned into c.bytes (codegen `writeSpan` emits the text and
// resolution compares bytes, both of which work on a re-interned copy). The two
// names that feed `moduleOf` (cross-module visibility) keep their ORIGINAL offset:
// a `Call` name (at its node span's start) and a function *declaration* name (still
// produced by the compiler's own declaration parser, untouched here). String and
// `Ident` text also use the original span (exact bytes matter for string literals).

// Byte length of a span.
fn spanLen(s: Span) -> U64 {
    return s.end - s.start
}

// Register an Array element type name for later monomorphization (deduped by the
// element name span, which is mangled for compound elements). fieldStart carries
// the element's structured ref so genCElem / the runtime recover its C type and
// ARC behaviour (0 = a simple named element — use the name path). Driven by
// lowerType when it lowers an `Array[E]`.
fn recordArrayElem(c: inout Comp, ty: PType) {
    if ty.isArray {
        mut val i: U64 = 0
        while i < c.arrayElems.count {
            val e: Bind = c.arrayElems[i]
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: ty.start, bLen: ty.len) {
                return
            }
            i += 1
        }
        mut val elemRef: U64 = 0
        if ty.ref < c.types.count {
            val at: TypeRef = c.types[ty.ref]
            if at.args.count > 0 {
                elemRef = at.args[0]
            }
        }
        // a nested array element (`Array[Array[I32]]`) needs the inner
        // `PlewArray_<inner>` registered (and emitted) first.
        ensureArrayElemDeps(c: inout c, elemRef: elemRef)
        c.arrayElems.append(<Bind nameStart=ty.start nameLen=ty.len fieldStart=elemRef fieldLen=0 />)
    }
}

// Lower a type expression, reproducing parseTypeTok's arena seeding (head name +
// recursively-lowered args, Array element span / compound mangling). Records the
// array element for monomorphization. (Function types `fn(...)->R` are not modeled
// by the shared TypeAst yet — they appear only in signatures, not bodies.)
// A canonical key string for a lowered field type (for the structural record name):
// the head name plus, for a generic instance, its argument head names — so
// `(x: Optional[I64])` and `(x: Optional[String])` get distinct record types.
fn recordTypeKey(c: inout Comp, pty: PType) -> Array[U8] {
    mut val out: Array[U8] = []
    mut val i: U64 = 0
    while i < pty.len {
        out.append(value: c.bytes[pty.start + i])
        i += 1
    }
    if pty.ref < c.types.count {
        val tr: TypeRef = c.types[pty.ref]
        if tr.args.count > 0U64 {
            appendBytes(into: inout out, from: "[".bytes)
            mut val a: U64 = 0
            while a < tr.args.count {
                if a > 0U64 {
                    appendBytes(into: inout out, from: ",".bytes)
                }
                val ar: TypeRef = c.types[tr.args[a]]
                mut val k: U64 = 0
                while k < ar.nameLen {
                    out.append(value: c.bytes[ar.nameStart + k])
                    k += 1
                }
                a += 1
            }
            appendBytes(into: inout out, from: "]".bytes)
        }
    }
    return out
}

// Whether string `a` sorts after string `b` (byte-lexicographic) — for ordering a
// record's fields by name into a canonical layout.
fn stringGt(a: String, b: String) -> Bool {
    mut val i: U64 = 0
    while i < a.bytes.count {
        if i >= b.bytes.count {
            return true
        }
        if a.bytes[i] > b.bytes[i] {
            return true
        }
        if a.bytes[i] < b.bytes[i] {
            return false
        }
        i += 1
    }
    return false
}

// Register (or find) the synthetic struct for an anonymous record type with the given
// field names and lowered field types (spec/02). The struct is keyed by a canonical
// name built from the fields sorted by name, so two records with the same field
// set are the same type (structural identity). Returns the struct's name Bind.
fn ensureRecordStruct(c: inout Comp, fieldNames: Array[String], fieldTys: Array[PType]) -> Bind {
    // sort field indices by name (insertion sort — field counts are tiny).
    mut val order: Array[U64] = []
    mut val i: U64 = 0
    while i < fieldNames.count {
        order.append(value: i)
        i += 1
    }
    mut val a: U64 = 0
    while a < order.count {
        mut val b: U64 = a + 1U64
        while b < order.count {
            if stringGt(a: fieldNames[order[a]], b: fieldNames[order[b]]) {
                val tmp: U64 = order[a]
                order[a] = order[b]
                order[b] = tmp
            }
            b += 1
        }
        a += 1
    }
    // canonical name `(n1:key1,n2:key2,...)` over the sorted fields.
    mut val cn: Array[U8] = []
    appendBytes(into: inout cn, from: "(".bytes)
    mut val j: U64 = 0
    while j < order.count {
        if j > 0U64 {
            appendBytes(into: inout cn, from: ",".bytes)
        }
        appendBytes(into: inout cn, from: fieldNames[order[j]].bytes)
        appendBytes(into: inout cn, from: ":".bytes)
        appendBytes(into: inout cn, from: recordTypeKey(c: inout c, pty: fieldTys[order[j]]))
        j += 1
    }
    appendBytes(into: inout cn, from: ")".bytes)
    val nm: Bind = internBytes(c: inout c, s: stringFromBytes(b: cn))
    val nid: U64 = intern(c: inout c, start: nm.nameStart, len: nm.nameLen)
    // already registered?
    mut val si: U64 = 0
    while si < c.structs.count {
        if c.structs[si].nameId == nid {
            return nm
        }
        si += 1
    }
    // build the StructDef with fields in canonical (sorted) order.
    mut val fields: Array[FieldDef] = []
    mut val f: U64 = 0
    while f < order.count {
        val fn2: Bind = internBytes(c: inout c, s: fieldNames[order[f]])
        val fty: PType = fieldTys[order[f]]
        fields.append(value: <FieldDef nameStart=fn2.nameStart nameLen=fn2.nameLen nameId=intern(c: inout c, start: fn2.nameStart, len: fn2.nameLen) tyStart=fty.start tyLen=fty.len tyNameId=intern(c: inout c, start: fty.start, len: fty.len) tyIsArray=fty.isArray ty=fty.ref isMut=false hasDefault=false defaultVal=0 vis=2 />)
        f += 1
    }
    val noTP: Array[Bind] = []
    c.structs.append(value: <StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=nid typeParams=noTP fields=fields isUnique=false isExtern=false />)
    return nm
}

fn lowerType(c: inout Comp, t: TypeAst) -> PType {
    // a labelled anonymous record type `(x: I32, y: I32)` (spec/02): lower to its
    // synthetic structural struct and return a PType naming it.
    if t.isRecord {
        mut val fieldTys: Array[PType] = []
        mut val fi: U64 = 0
        while fi < t.args.count {
            fieldTys.append(value: lowerType(c: inout c, t: t.args[fi]))
            fi += 1
        }
        val rnm: Bind = ensureRecordStruct(c: inout c, fieldNames: t.argLabels, fieldTys: fieldTys)
        val rref: U64 = c.pushType(t: <TypeRef nameStart=rnm.nameStart nameLen=rnm.nameLen args=[] />)
        return <PType start=rnm.nameStart len=rnm.nameLen isArray=false ref=rref />
    }
    val nm: Bind = internBytes(c: inout c, s: t.name)
    mut val args: Array[U64] = []
    mut val argPtys: Array[PType] = []
    mut val i: U64 = 0
    while i < t.args.count {
        val ap: PType = lowerType(c: inout c, t: t.args[i])
        argPtys.append(ap)
        args.append(ap.ref)
        i += 1
    }
    mut val viewExtId: U64 = 0
    if t.extView.bytes.count > 0 {
        val evN: Bind = internBytes(c: inout c, s: t.extView)
        viewExtId = intern(c: inout c, start: evN.nameStart, len: evN.nameLen)
    }
    // intern any named binding labels (`Item`/`Output` in `any P[Item=I32]`) parallel
    // to args; 0 for a positional argument.
    mut val argLabels: Array[U64] = []
    mut val li: U64 = 0
    while li < t.argLabels.count {
        if t.argLabels[li].bytes.count > 0 {
            val lblN: Bind = internBytes(c: inout c, s: t.argLabels[li])
            argLabels.append(intern(c: inout c, start: lblN.nameStart, len: lblN.nameLen))
        } else {
            argLabels.append(0U64)
        }
        li += 1
    }
    val ref: U64 = c.pushType(t: <TypeRef nameStart=nm.nameStart nameLen=nm.nameLen args=args viewExtId=viewExtId isAny=t.isAny argLabels=argLabels />)
    mut val result: PType = <PType start=nm.nameStart len=nm.nameLen isArray=false ref=ref />
    if t.args.count > 0 {
        if rangeEquals(bytes: c.bytes, start: nm.nameStart, len: nm.nameLen, kw: "Array") {
            if isCompoundType(c: inout c, ref: args[0]) {
                val mn: Bind = appendMangleSpan(c: inout c, ref: args[0])
                result = <PType start=mn.nameStart len=mn.nameLen isArray=true ref=ref />
            } else {
                result = <PType start=argPtys[0].start len=argPtys[0].len isArray=true ref=ref />
            }
            recordArrayElem(c: inout c, ty: result)
        }
    }
    return result
}

// Lower a call/construction argument list.
// The declared TypeRef of the parameter labelled `argLabel` of the free function
// `fnName`, or 0 when it can't be resolved unambiguously (no such function, an
// overloaded / generic / method candidate, or no matching label). The callee is
// declared before any body that calls it (source order), so its param types are
// registered TypeRefs here. Used to give a call-argument literal its context type.
fn callArgType(c: inout Comp, fnName: String, argLabel: String) -> U64 {
    if fnName.bytes.count == 0U64 {
        return 0U64
    }
    if argLabel.bytes.count == 0U64 {
        return 0U64
    }
    val fnB: Bind = internBytes(c: inout c, s: fnName)
    val fnId: U64 = intern(c: inout c, start: fnB.nameStart, len: fnB.nameLen)
    val lb: Bind = internBytes(c: inout c, s: argLabel)
    val lid: U64 = intern(c: inout c, start: lb.nameStart, len: lb.nameLen)
    mut val matchCount: U64 = 0
    mut val resultTy: U64 = 0
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        if f.nameId == fnId {
            if f.hasRecv {
            } else {
                if f.typeParams.count == 0U64 {
                    matchCount += 1
                    mut val pi: U64 = 0
                    while pi < f.params.count {
                        if intern(c: inout c, start: f.params[pi].nameStart, len: f.params[pi].nameLen) == lid {
                            resultTy = f.params[pi].ty
                        }
                        pi += 1
                    }
                }
            }
        }
        fi += 1
    }
    if matchCount == 1U64 {
        return resultTy
    }
    return 0U64
}

fn lowerArgs(c: inout Comp, args: Array[ArgAst], fnName: String) -> Array[Arg] {
    mut val out: Array[Arg] = []
    mut val i: U64 = 0
    while i < args.count {
        val a: ArgAst = args[i]
        // flow the resolved parameter's type to a context-typed argument literal (a dict
        // / record / `()` whose type is only known from the parameter). Defensive: 0
        // falls back to context-free lowering (overloaded / generic / method calls).
        val actx: U64 = callArgType(c: inout c, fnName: fnName, argLabel: a.label)
        mut val e: U64 = 0
        if actx != 0U64 {
            e = lowerExprWithCtx(c: inout c, e: a.value, ctxRef: actx)
        } else {
            e = lowerExpr(c: inout c, e: a.value)
        }
        mut val labelStart: U64 = 0
        mut val labelLen: U64 = 0
        if a.hasLabel {
            val lb: Bind = internBytes(c: inout c, s: a.label)
            labelStart = lb.nameStart
            labelLen = lb.nameLen
        }
        out.append(<Arg expr=e isInout=a.isInout labelStart=labelStart labelLen=labelLen hasLabel=a.hasLabel />)
        i += 1
    }
    return out
}

// The declared TypeRef of field `fieldName` on the type being constructed (a struct,
// or an enum variant's payload), or 0 when the owner / field can't be resolved. The
// owner type's declaration is lowered before any body that constructs it (source
// order), so its field types are registered TypeRefs here. Used to give a
// construction-field literal (`<Box m=[:] />`, `<Shape.Point at=(x:1,y:2) />`) its
// context type so an otherwise un-inferable dict / record / unit literal resolves.
fn makeFieldType(c: inout Comp, typeName: String, variant: String, isEnum: Bool, fieldName: String) -> U64 {
    val tn: Bind = internBytes(c: inout c, s: typeName)
    val tid: U64 = intern(c: inout c, start: tn.nameStart, len: tn.nameLen)
    val fn2: Bind = internBytes(c: inout c, s: fieldName)
    val fid: U64 = intern(c: inout c, start: fn2.nameStart, len: fn2.nameLen)
    if isEnum {
        val vn: Bind = internBytes(c: inout c, s: variant)
        val vid: U64 = intern(c: inout c, start: vn.nameStart, len: vn.nameLen)
        mut val ei: U64 = 0
        while ei < c.enums.count {
            if c.enums[ei].nameId == tid {
                mut val vi: U64 = 0
                while vi < c.enums[ei].variants.count {
                    if intern(c: inout c, start: c.enums[ei].variants[vi].nameStart, len: c.enums[ei].variants[vi].nameLen) == vid {
                        mut val fj: U64 = 0
                        while fj < c.enums[ei].variants[vi].fields.count {
                            if intern(c: inout c, start: c.enums[ei].variants[vi].fields[fj].nameStart, len: c.enums[ei].variants[vi].fields[fj].nameLen) == fid {
                                return c.enums[ei].variants[vi].fields[fj].ty
                            }
                            fj += 1
                        }
                    }
                    vi += 1
                }
            }
            ei += 1
        }
        return 0U64
    }
    mut val si: U64 = 0
    while si < c.structs.count {
        if c.structs[si].nameId == tid {
            mut val fk: U64 = 0
            while fk < c.structs[si].fields.count {
                if intern(c: inout c, start: c.structs[si].fields[fk].nameStart, len: c.structs[si].fields[fk].nameLen) == fid {
                    return c.structs[si].fields[fk].ty
                }
                fk += 1
            }
        }
        si += 1
    }
    return 0U64
}

fn lowerMakeFields(c: inout Comp, fields: Array[MakeFieldAst], typeName: String, variant: String, isEnum: Bool) -> Array[MakeField] {
    mut val out: Array[MakeField] = []
    mut val i: U64 = 0
    while i < fields.count {
        val f: MakeFieldAst = fields[i]
        // flow the field's declared type to its value so a context-typed literal in a
        // construction field infers (a dict / record / `()` whose type is only known
        // from the field). Defensive: 0 falls back to context-free lowering.
        val fctx: U64 = makeFieldType(c: inout c, typeName: typeName, variant: variant, isEnum: isEnum, fieldName: f.name)
        mut val v: U64 = 0
        if fctx != 0U64 {
            v = lowerExprWithCtx(c: inout c, e: f.value, ctxRef: fctx)
        } else {
            v = lowerExpr(c: inout c, e: f.value)
        }
        val nm: Bind = internBytes(c: inout c, s: f.name)
        out.append(<MakeField nameStart=nm.nameStart nameLen=nm.nameLen value=v offset=f.span.start />)
        i += 1
    }
    return out
}

// Build a fresh empty `<Dictionary keys=[] vals=[] hashes=[] buckets=[] count=0 />`
// Make node typed as `ctxRef` (a `Dictionary[K, V]` TypeRef). The empty array
// literals take their element type from the struct field at codegen, so no element
// type is needed here.
fn synthEmptyDict(c: inout Comp, ctxRef: U64) -> U64 {
    val ct: TypeRef = c.types[ctxRef]
    val kN: Bind = internBytes(c: inout c, s: "keys")
    val vN: Bind = internBytes(c: inout c, s: "vals")
    val hN: Bind = internBytes(c: inout c, s: "hashes")
    val bN: Bind = internBytes(c: inout c, s: "buckets")
    val cN: Bind = internBytes(c: inout c, s: "count")
    val noElems: Array[U64] = []
    val emptyKeys: U64 = c.pushExpr(e: <Expr.Array elems=noElems />)
    val emptyVals: U64 = c.pushExpr(e: <Expr.Array elems=noElems />)
    val emptyHashes: U64 = c.pushExpr(e: <Expr.Array elems=noElems />)
    val emptyBuckets: U64 = c.pushExpr(e: <Expr.Array elems=noElems />)
    val zero: U64 = c.pushExpr(e: <Expr.Int value=0 offset=0 isBool=false tyStart=0 tyLen=0 isNeg=false />)
    mut val fields: Array[MakeField] = []
    fields.append(<MakeField nameStart=kN.nameStart nameLen=kN.nameLen value=emptyKeys />)
    fields.append(<MakeField nameStart=vN.nameStart nameLen=vN.nameLen value=emptyVals />)
    fields.append(<MakeField nameStart=hN.nameStart nameLen=hN.nameLen value=emptyHashes />)
    fields.append(<MakeField nameStart=bN.nameStart nameLen=bN.nameLen value=emptyBuckets />)
    fields.append(<MakeField nameStart=cN.nameStart nameLen=cN.nameLen value=zero />)
    return c.pushExpr(e: <Expr.Make typeStart=ct.nameStart typeLen=ct.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=fields />)
}

// Lower a dictionary literal `[k0: v0, ...]` / `[:]` (spec/02). The K/V types come
// from the binding/return context (`ctxRef` must be a `Dictionary[K, V]` TypeRef):
// there is no element-based inference, so the literal needs a context type (an
// annotated `let`/`return`), just like an empty array does. Lowers to a
// value-position block:
//   if (1) { mut val __dl: Dictionary[K,V] = <empty>; __dl.insert(k, v); ...;
//            give move __dl } else { give <empty> }
// `give move __dl` transfers the freshly-built dictionary out with no deep copy —
// the temp is marked moved so the block exit does not release it (the caller's
// binding owns it). The else branch is dead (the cond is the constant `1`) but must
// still yield a `Dictionary[K,V]` so the value-position block type-checks.
fn lowerDictLit(c: inout Comp, keys: Array[ExprAst], vals: Array[ExprAst], ctxRef: U64, span: Span) -> U64 {
    mut val ok: Bool = false
    if ctxRef != 0 {
        if ctxRef < c.types.count {
            val ct: TypeRef = c.types[ctxRef]
            if rangeEquals(bytes: c.bytes, start: ct.nameStart, len: ct.nameLen, kw: "Dictionary") {
                if ct.args.count >= 2 {
                    ok = true
                }
            }
        }
    }
    if ok {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: span.start), msg: "cannot infer the type of a dictionary literal; annotate the binding (`: Dictionary[K, V]`)")
        return c.pushExpr(e: <Expr.Int value=0 offset=span.start isBool=false tyStart=0 tyLen=0 isNeg=false />)
    }
    val ct: TypeRef = c.types[ctxRef]
    val dlN: Bind = internBytes(c: inout c, s: "__dl")
    mut val stmts: Array[U64] = []
    val initMake: U64 = synthEmptyDict(c: inout c, ctxRef: ctxRef)
    stmts.append(c.pushStmt(s: <Stmt.Let mutable=true nameStart=dlN.nameStart nameLen=dlN.nameLen tyStart=ct.nameStart tyLen=ct.nameLen tyIsArray=false ty=ctxRef init=initMake />))
    val insN: Bind = internBytes(c: inout c, s: "insert")
    val keyL: Bind = internBytes(c: inout c, s: "key")
    val valL: Bind = internBytes(c: inout c, s: "value")
    mut val i: U64 = 0
    while i < keys.count {
        val kId: U64 = lowerExpr(c: inout c, e: keys[i])
        val vId: U64 = lowerExpr(c: inout c, e: vals[i])
        val recv: U64 = c.pushExpr(e: <Expr.Ident start=dlN.nameStart len=dlN.nameLen />)
        mut val args: Array[Arg] = []
        args.append(<Arg expr=kId isInout=false labelStart=keyL.nameStart labelLen=keyL.nameLen hasLabel=true />)
        args.append(<Arg expr=vId isInout=false labelStart=valL.nameStart labelLen=valL.nameLen hasLabel=true />)
        val m: U64 = c.pushExpr(e: <Expr.Method recv=recv nameStart=insN.nameStart nameLen=insN.nameLen args=args />)
        stmts.append(c.pushStmt(s: <Stmt.ExprStmt expr=m />))
        i += 1
    }
    val giveRecv: U64 = c.pushExpr(e: <Expr.Ident start=dlN.nameStart len=dlN.nameLen />)
    val mv: U64 = c.pushExpr(e: <Expr.Move operand=giveRecv isBorrow=false />)
    stmts.append(c.pushStmt(s: <Stmt.Give value=mv />))
    val thenBlk: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    mut val elseStmts: Array[U64] = []
    val elseDict: U64 = synthEmptyDict(c: inout c, ctxRef: ctxRef)
    elseStmts.append(c.pushStmt(s: <Stmt.Give value=elseDict />))
    val elseBlk: U64 = c.blocks.count
    c.blocks.append(<Block stmts=elseStmts />)
    val cond: U64 = c.pushExpr(e: <Expr.Int value=1 offset=span.start isBool=true tyStart=0 tyLen=0 isNeg=false />)
    return c.pushExpr(e: <Expr.IfExpr cond=cond thenBlk=thenBlk elseBlk=elseBlk />)
}

// Lower an expression with a context type `ctxRef` (a TypeRef, 0 = none). A
// type-argument-less generic constructor `<Box v=… />` whose head matches the
// context type's head takes the context's type arguments (`Box[I64]`), so the
// instance is named/typed concretely without explicit `<Box[I64] …>`. (Bug11 —
// generic-constructor type-argument inference from the binding/return context.)
// Everything else falls through to the plain lowerExpr.
fn lowerExprWithCtx(c: inout Comp, e: ExprAst, ctxRef: U64) -> U64 {
    if ctxRef != 0 {
        if ctxRef < c.types.count {
            val ct: TypeRef = c.types[ctxRef]
            // a record literal adopting an annotated record type (`val p: (x: I64, y:
            // I64) = (x: 1, y: 2)`): the context already lowered to the synthetic record
            // struct (its name begins `(`), so build that struct directly.
            if ct.nameLen > 0U64 {
                if c.bytes[ct.nameStart] == '(' {
                    match e {
                        ExprAst.RecordLit(val fields, val span) => {
                            val fs: Array[MakeField] = lowerMakeFields(c: inout c, fields: fields, typeName: "", variant: "", isEnum: false)
                            return c.pushExpr(e: <Expr.Make typeStart=ct.nameStart typeLen=ct.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=fs />)
                        }
                        _ => {}
                    }
                }
            }
            if ct.args.count > 0 {
                match e {
                    ExprAst.Make(val typeName, val typeArgs, val variant, val isEnum, val fields, val span) => {
                        if isEnum {
                        } else {
                            if typeArgs.count == 0 {
                                val tn: Bind = internBytes(c: inout c, s: typeName)
                                if intern(c: inout c, start: tn.nameStart, len: tn.nameLen) == ct.nameId {
                                    val fs: Array[MakeField] = lowerMakeFields(c: inout c, fields: fields, typeName: typeName, variant: "", isEnum: false)
                                    return c.pushExpr(e: <Expr.Make typeStart=tn.nameStart typeLen=tn.nameLen variantStart=0 variantLen=0 isEnum=false ty=ctxRef fields=fs />)
                                }
                            }
                        }
                    }
                    ExprAst.DictLit(val keys, val vals, val span) => {
                        return lowerDictLit(c: inout c, keys: keys, vals: vals, ctxRef: ctxRef, span: span)
                    }
                    _ => {}
                }
            }
        }
    }
    return lowerExpr(c: inout c, e: e)
}

fn lowerExpr(c: inout Comp, e: ExprAst) -> U64 {
    mut val result: U64 = 0
    match e {
        ExprAst.IntLit(val value, val isBool, val tySuffix, val span) => {
            mut val sStart: U64 = 0
            mut val sLen: U64 = 0
            if tySuffix.bytes.count > 0 {
                val sf: Bind = internBytes(c: inout c, s: tySuffix)
                sStart = sf.nameStart
                sLen = sf.nameLen
            }
            result = c.pushExpr(e: <Expr.Int value=value offset=span.start isBool=isBool tyStart=sStart tyLen=sLen isNeg=false />)
        }
        ExprAst.FloatLit(val text, val tySuffix, val span) => {
            val tb: Bind = internBytes(c: inout c, s: text)
            mut val sStart: U64 = 0
            mut val sLen: U64 = 0
            if tySuffix.bytes.count > 0 {
                val sf: Bind = internBytes(c: inout c, s: tySuffix)
                sStart = sf.nameStart
                sLen = sf.nameLen
            }
            result = c.pushExpr(e: <Expr.Float start=tb.nameStart len=tb.nameLen tyStart=sStart tyLen=sLen />)
        }
        ExprAst.StrLit(val raw, val span) => {
            result = c.pushExpr(e: <Expr.Str start=span.start len=spanLen(s: span) />)
        }
        ExprAst.Ident(val name, val span) => {
            result = c.pushExpr(e: <Expr.Ident start=span.start len=spanLen(s: span) />)
        }
        ExprAst.Unary(val op, val operand, val span) => {
            // fold a leading `-` on a BARE integer literal into a negative literal
            // (spec/02: `-128I8` is the literal -128, not Neg(128I8)). The parser
            // has already resolved precedence, so `operand` is a plain IntLit only
            // when the `-` binds directly to the literal (`-128.foo()` lowers its
            // operand to a Method, not an IntLit — left as a real Neg). codegen then
            // emits a constant `-128`, and the Neg witness is reserved for runtime
            // operands (which is where the checked-overflow semantics belong).
            mut val folded: Bool = false
            if op == opSub() {
                match operand {
                    ExprAst.IntLit(val value, val isBool, val tySuffix, span: val litSpan) => {
                        if isBool {
                        } else {
                            mut val sStart: U64 = 0
                            mut val sLen: U64 = 0
                            if tySuffix.bytes.count > 0 {
                                val sf: Bind = internBytes(c: inout c, s: tySuffix)
                                sStart = sf.nameStart
                                sLen = sf.nameLen
                            }
                            result = c.pushExpr(e: <Expr.Int value=value offset=litSpan.start isBool=false tyStart=sStart tyLen=sLen isNeg=true />)
                            folded = true
                        }
                    }
                    _ => {}
                }
            }
            if folded {
            } else {
                val o: U64 = lowerExpr(c: inout c, e: operand)
                result = c.pushExpr(e: <Expr.Unary op=op operand=o />)
            }
        }
        ExprAst.Binary(val op, val lhs, val rhs, val span) => {
            val l: U64 = lowerExpr(c: inout c, e: lhs)
            val r: U64 = lowerExpr(c: inout c, e: rhs)
            result = c.pushExpr(e: <Expr.Binary op=op lhs=l rhs=r />)
        }
        ExprAst.Call(val name, val args, val span) => {
            // ORIGINAL offset (name is at the call's span start) — feeds moduleOf.
            val a: Array[Arg] = lowerArgs(c: inout c, args: args, fnName: name)
            result = c.pushExpr(e: <Expr.Call nameStart=span.start nameLen=name.bytes.count args=a />)
        }
        ExprAst.Field(val base, val name, val span) => {
            val b: U64 = lowerExpr(c: inout c, e: base)
            val nm: Bind = internBytes(c: inout c, s: name)
            result = c.pushExpr(e: <Expr.Field base=b nameStart=nm.nameStart nameLen=nm.nameLen />)
        }
        ExprAst.Method(val recv, val name, val args, val span) => {
            val r: U64 = lowerExpr(c: inout c, e: recv)
            val a: Array[Arg] = lowerArgs(c: inout c, args: args, fnName: "")
            val nm: Bind = internBytes(c: inout c, s: name)
            result = c.pushExpr(e: <Expr.Method recv=r nameStart=nm.nameStart nameLen=nm.nameLen args=a />)
        }
        ExprAst.ExtMethod(val recv, val src, val name, val args, val span) => {
            val r: U64 = lowerExpr(c: inout c, e: recv)
            val a: Array[Arg] = lowerArgs(c: inout c, args: args, fnName: "")
            val srcN: Bind = internBytes(c: inout c, s: src)
            val nm: Bind = internBytes(c: inout c, s: name)
            result = c.pushExpr(e: <Expr.ExtMethod recv=r srcStart=srcN.nameStart srcLen=srcN.nameLen nameStart=nm.nameStart nameLen=nm.nameLen args=a />)
        }
        ExprAst.ExtView(val recv, val src, val strip, val span) => {
            val r: U64 = lowerExpr(c: inout c, e: recv)
            val srcN: Bind = internBytes(c: inout c, s: src)
            result = c.pushExpr(e: <Expr.ExtView recv=r srcStart=srcN.nameStart srcLen=srcN.nameLen strip=strip />)
        }
        ExprAst.Index(val base, val index, val span) => {
            val b: U64 = lowerExpr(c: inout c, e: base)
            val idx: U64 = lowerExpr(c: inout c, e: index)
            result = c.pushExpr(e: <Expr.Index base=b index=idx />)
        }
        ExprAst.Make(val typeName, val typeArgs, val variant, val isEnum, val fields, val span) => {
            val tn: Bind = internBytes(c: inout c, s: typeName)
            mut val tyRef: U64 = 0
            if typeArgs.count > 0 {
                mut val targs: Array[U64] = []
                mut val ti: U64 = 0
                while ti < typeArgs.count {
                    targs.append(lowerType(c: inout c, t: typeArgs[ti]).ref)
                    ti += 1
                }
                tyRef = c.pushType(t: <TypeRef nameStart=tn.nameStart nameLen=tn.nameLen args=targs />)
            }
            mut val vStart: U64 = 0
            mut val vLen: U64 = 0
            if isEnum {
                val vb: Bind = internBytes(c: inout c, s: variant)
                vStart = vb.nameStart
                vLen = vb.nameLen
            }
            val fs: Array[MakeField] = lowerMakeFields(c: inout c, fields: fields, typeName: typeName, variant: variant, isEnum: isEnum)
            result = c.pushExpr(e: <Expr.Make typeStart=tn.nameStart typeLen=tn.nameLen variantStart=vStart variantLen=vLen isEnum=isEnum ty=tyRef fields=fs />)
        }
        ExprAst.ArrayLit(val elems, val span) => {
            mut val es: Array[U64] = []
            mut val i: U64 = 0
            while i < elems.count {
                es.append(lowerExpr(c: inout c, e: elems[i]))
                i += 1
            }
            result = c.pushExpr(e: <Expr.Array elems=es />)
        }
        ExprAst.DictLit(val keys, val vals, val span) => {
            // a bare dictionary literal with no binding/return context: K/V can't be
            // inferred (lowerDictLit reports the error).
            result = lowerDictLit(c: inout c, keys: keys, vals: vals, ctxRef: 0, span: span)
        }
        ExprAst.RecordLit(val fields, val span) => {
            // a record literal reached without a context type (no annotation / return
            // type). Lower to an Expr.Make whose struct is inferred from the field value
            // types at codegen (the synthetic record struct keyed by those types). ty=0
            // / no type name: the backend resolves the record struct from the values
            // (or st.expectedTy if a construction site set one).
            val fs: Array[MakeField] = lowerMakeFields(c: inout c, fields: fields, typeName: "", variant: "", isEnum: false)
            result = c.pushExpr(e: <Expr.Make typeStart=0 typeLen=0 variantStart=0 variantLen=0 isEnum=false ty=0 fields=fs />)
        }
        ExprAst.Cast(val operand, val ty, val span) => {
            val o: U64 = lowerExpr(c: inout c, e: operand)
            val pt: PType = lowerType(c: inout c, t: ty)
            result = c.pushExpr(e: <Expr.Cast operand=o tyStart=pt.start tyLen=pt.len ty=pt.ref />)
        }
        ExprAst.MatchExpr(val scrut, val arms, val span) => {
            val s: U64 = lowerExpr(c: inout c, e: scrut)
            val ma: Array[MatchArm] = lowerMatchArms(c: inout c, arms: arms, isExpr: true)
            result = c.pushExpr(e: <Expr.MatchExpr scrut=s arms=ma />)
        }
        ExprAst.IfExpr(val cond, val thenBlk, val elseBlk, val span) => {
            val cnd: U64 = lowerExpr(c: inout c, e: cond)
            val tb: U64 = lowerBlock(c: inout c, b: thenBlk)
            val eb: U64 = lowerBlock(c: inout c, b: elseBlk)
            result = c.pushExpr(e: <Expr.IfExpr cond=cnd thenBlk=tb elseBlk=eb />)
        }
        ExprAst.OptChain(val base, val member, val span) => {
            val b: U64 = lowerExpr(c: inout c, e: base)
            val nm: Bind = internBytes(c: inout c, s: member)
            result = c.pushExpr(e: <Expr.OptChain base=b memberStart=nm.nameStart memberLen=nm.nameLen />)
        }
        ExprAst.Try(val operand, val span) => {
            val o: U64 = lowerExpr(c: inout c, e: operand)
            result = c.pushExpr(e: <Expr.Try expr=o />)
        }
        ExprAst.Arrow(val base, val name, val span) => {
            val b: U64 = lowerExpr(c: inout c, e: base)
            val nm: Bind = internBytes(c: inout c, s: name)
            result = c.pushExpr(e: <Expr.Arrow base=b nameStart=nm.nameStart nameLen=nm.nameLen />)
        }
        ExprAst.Closure(val params, val hasRet, val ret, val body, val span) => {
            val ps: Array[Param] = lowerParams(c: inout c, params: params)
            mut val rStart: U64 = 0
            mut val rLen: U64 = 0
            mut val rIsArray: Bool = false
            mut val rTy: U64 = 0
            if hasRet {
                val pt: PType = lowerType(c: inout c, t: ret)
                rStart = pt.start
                rLen = pt.len
                rIsArray = pt.isArray
                rTy = pt.ref
            }
            val savedRet: U64 = c.lowerRetTy
            c.lowerRetTy = rTy
            val bd: U64 = lowerBlock(c: inout c, b: body)
            c.lowerRetTy = savedRet
            result = c.pushExpr(e: <Expr.Closure params=ps hasRet=hasRet retStart=rStart retLen=rLen retIsArray=rIsArray retTy=rTy body=bd />)
        }
        ExprAst.Move(val operand, val isBorrow, val span) => {
            val o: U64 = lowerExpr(c: inout c, e: operand)
            result = c.pushExpr(e: <Expr.Move operand=o isBorrow=isBorrow />)
        }
        ExprAst.Await(val operand, val span) => {
            val o: U64 = lowerExpr(c: inout c, e: operand)
            result = c.pushExpr(e: <Expr.Await operand=o />)
        }
    }
    return result
}

fn lowerParams(c: inout Comp, params: Array[ParamAst]) -> Array[Param] {
    mut val out: Array[Param] = []
    mut val i: U64 = 0
    while i < params.count {
        val p: ParamAst = params[i]
        val nm: Bind = internBytes(c: inout c, s: p.name)
        mut val tyStart: U64 = 0
        mut val tyLen: U64 = 0
        mut val tyIsArray: Bool = false
        mut val tyRef: U64 = 0
        // a record type has an empty `name` (its fields ride in args/argLabels), so gate
        // on isRecord too — else a record-typed param keeps no type and `p.field` fails.
        if p.ty.name.bytes.count > 0 || p.ty.isRecord {
            val pt: PType = lowerType(c: inout c, t: p.ty)
            tyStart = pt.start
            tyLen = pt.len
            tyIsArray = pt.isArray
            tyRef = pt.ref
        }
        // a default argument `name: T = expr` (spec/04). Closures never carry one
        // (hasDefault is always false there), so this is a no-op for closure params.
        mut val hasDefault: Bool = false
        mut val defaultExpr: U64 = 0
        if p.hasDefault {
            defaultExpr = lowerExpr(c: inout c, e: p.defaultVal)
            hasDefault = true
        }
        out.append(<Param nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout c, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isInout=p.isInout isMove=p.isMove isBorrow=p.isBorrow noLabel=p.noLabel hasDefault=hasDefault defaultExpr=defaultExpr />)
        i += 1
    }
    return out
}

fn lowerBinds(c: inout Comp, binds: Array[BindAst]) -> Array[Bind] {
    mut val out: Array[Bind] = []
    mut val i: U64 = 0
    while i < binds.count {
        val b: BindAst = binds[i]
        val nm: Bind = internBytes(c: inout c, s: b.name)
        val fd: Bind = internBytes(c: inout c, s: b.field)
        out.append(<Bind nameStart=nm.nameStart nameLen=nm.nameLen nameId=nm.nameId fieldStart=fd.nameStart fieldLen=fd.nameLen offset=b.span.start />)
        i += 1
    }
    return out
}

// Lower a pattern into the arena MatchArm fields (minus the body).
fn lowerPatternInfo(c: inout Comp, p: PatternAst) -> PatInfo {
    if p.isWildcard {
        val noBinds: Array[Bind] = []
        return <PatInfo isWildcard=true enumStart=0 enumLen=0 variantStart=0 variantLen=0 binds=noBinds isStruct=false />
    }
    val en: Bind = internBytes(c: inout c, s: p.typeName)
    mut val vStart: U64 = 0
    mut val vLen: U64 = 0
    if p.variant.bytes.count > 0 {
        val vb: Bind = internBytes(c: inout c, s: p.variant)
        vStart = vb.nameStart
        vLen = vb.nameLen
    }
    val binds: Array[Bind] = lowerBinds(c: inout c, binds: p.binds)
    return <PatInfo isWildcard=false enumStart=en.nameStart enumLen=en.nameLen variantStart=vStart variantLen=vLen binds=binds isStruct=p.isStruct />
}

// Lower match arms. For an expression-position match (isExpr), each arm's body is a
// synthesized one-`give` block; its arena `body` is the give value's Expr index.
// For a statement-position match, the arena `body` is the block index.
fn lowerMatchArms(c: inout Comp, arms: Array[MatchArmAst], isExpr: Bool) -> Array[MatchArm] {
    mut val out: Array[MatchArm] = []
    mut val i: U64 = 0
    while i < arms.count {
        val arm: MatchArmAst = arms[i]
        val pi: PatInfo = lowerPatternInfo(c: inout c, p: arm.pattern)
        mut val body: U64 = 0
        if isExpr {
            // the give-block's single statement is `give <expr>`; lower that expr.
            mut val gv: ExprAst = emptyExpr()
            if arm.body.stmts.count > 0 {
                match arm.body.stmts[0] {
                    StmtAst.Give(val value, val span) => { gv = value }
                    _ => {}
                }
            }
            body = lowerExpr(c: inout c, e: gv)
        } else {
            body = lowerBlock(c: inout c, b: arm.body)
        }
        out.append(<MatchArm isWildcard=pi.isWildcard enumStart=pi.enumStart enumLen=pi.enumLen variantStart=pi.variantStart variantLen=pi.variantLen binds=pi.binds body=body isStruct=pi.isStruct />)
        i += 1
    }
    return out
}

fn lowerStmt(c: inout Comp, s: StmtAst) -> U64 {
    mut val result: U64 = 0
    match s {
        StmtAst.Let(val mutable, val name, val hasTy, val ty, val init, val span) => {
            val nm: Bind = internBytes(c: inout c, s: name)
            mut val tyStart: U64 = 0
            mut val tyLen: U64 = 0
            mut val tyIsArray: Bool = false
            mut val tyRef: U64 = 0
            if hasTy {
                val pt: PType = lowerType(c: inout c, t: ty)
                tyStart = pt.start
                tyLen = pt.len
                tyIsArray = pt.isArray
                tyRef = pt.ref
            }
            val iv: U64 = lowerExprWithCtx(c: inout c, e: init, ctxRef: tyRef)
            result = c.pushStmt(s: <Stmt.Let mutable=mutable nameStart=nm.nameStart nameLen=nm.nameLen tyStart=tyStart tyLen=tyLen tyIsArray=tyIsArray ty=tyRef init=iv />)
        }
        StmtAst.Assign(val op, val target, val value, val span) => {
            val t: U64 = lowerExpr(c: inout c, e: target)
            val v: U64 = lowerExpr(c: inout c, e: value)
            result = c.pushStmt(s: <Stmt.Assign op=op target=t value=v />)
        }
        StmtAst.ExprStmt(val expr, val span) => {
            val e: U64 = lowerExpr(c: inout c, e: expr)
            result = c.pushStmt(s: <Stmt.ExprStmt expr=e />)
        }
        StmtAst.Return(val value, val hasValue, val span) => {
            mut val v: U64 = 0
            if hasValue {
                v = lowerExprWithCtx(c: inout c, e: value, ctxRef: c.lowerRetTy)
            }
            result = c.pushStmt(s: <Stmt.Return value=v hasValue=hasValue />)
        }
        StmtAst.If(val cond, val thenBlk, val elseBlk, val hasElse, val span) => {
            val cnd: U64 = lowerExpr(c: inout c, e: cond)
            val tb: U64 = lowerBlock(c: inout c, b: thenBlk)
            mut val eb: U64 = 0
            if hasElse {
                eb = lowerBlock(c: inout c, b: elseBlk)
            }
            result = c.pushStmt(s: <Stmt.If cond=cnd thenBlk=tb elseBlk=eb hasElse=hasElse />)
        }
        StmtAst.While(val cond, val body, val span) => {
            val cnd: U64 = lowerExpr(c: inout c, e: cond)
            val bd: U64 = lowerBlock(c: inout c, b: body)
            result = c.pushStmt(s: <Stmt.While cond=cnd body=bd />)
        }
        StmtAst.For(val varName, val varTy, val hasVarTy, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patType, val binds, val span) => {
            // a record loop pattern `for (val x, val y) in xs` (patType="__rec__"): bind a
            // fresh element local `__fe` and prepend `val x = __fe.field` per bind to the
            // body (arena-level interned names, since an AST synthetic `Ident` reads the
            // source by span). The element's struct is tracked by the for-over-array path.
            if patType == "__rec__" {
                val fe: Bind = internBytes(c: inout c, s: "__fe")
                val lo2: U64 = lowerExpr(c: inout c, e: iter)
                val inner: U64 = lowerBlock(c: inout c, b: body)
                mut val bstmts: Array[U64] = []
                mut val bi: U64 = 0
                while bi < binds.count {
                    val fldName: Bind = internBytes(c: inout c, s: binds[bi].field)
                    val nameB: Bind = internBytes(c: inout c, s: binds[bi].name)
                    val recv: U64 = c.pushExpr(e: <Expr.Ident start=fe.nameStart len=fe.nameLen />)
                    val fld: U64 = c.pushExpr(e: <Expr.Field base=recv nameStart=fldName.nameStart nameLen=fldName.nameLen />)
                    bstmts.append(value: c.pushStmt(s: <Stmt.Let mutable=false nameStart=nameB.nameStart nameLen=nameB.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=fld />))
                    bi += 1
                }
                mut val ob: U64 = 0
                while ob < c.blocks[inner].stmts.count {
                    bstmts.append(value: c.blocks[inner].stmts[ob])
                    ob += 1
                }
                val bd2: U64 = c.blocks.count
                c.blocks.append(value: <Block stmts=bstmts />)
                result = c.pushStmt(s: <Stmt.For varStart=fe.nameStart varLen=fe.nameLen varTyStart=0 varTyLen=0 isRange=false inclusive=false iter=lo2 rangeHi=0 body=bd2 isStruct=false patStart=0 patLen=0 binds=[] />)
                return result
            }
            mut val vStart: U64 = 0
            mut val vLen: U64 = 0
            if varName.bytes.count > 0 {
                val vb: Bind = internBytes(c: inout c, s: varName)
                vStart = vb.nameStart
                vLen = vb.nameLen
            }
            mut val vtStart: U64 = 0
            mut val vtLen: U64 = 0
            if hasVarTy {
                val vpt: PType = lowerType(c: inout c, t: varTy)
                vtStart = vpt.start
                vtLen = vpt.len
            }
            val lo: U64 = lowerExpr(c: inout c, e: iter)
            mut val hi: U64 = 0
            if isRange {
                hi = lowerExpr(c: inout c, e: rangeHi)
            }
            val bd: U64 = lowerBlock(c: inout c, b: body)
            mut val pStart: U64 = 0
            mut val pLen: U64 = 0
            if patType.bytes.count > 0 {
                val pb: Bind = internBytes(c: inout c, s: patType)
                pStart = pb.nameStart
                pLen = pb.nameLen
            }
            val bnds: Array[Bind] = lowerBinds(c: inout c, binds: binds)
            result = c.pushStmt(s: <Stmt.For varStart=vStart varLen=vLen varTyStart=vtStart varTyLen=vtLen isRange=isRange inclusive=inclusive iter=lo rangeHi=hi body=bd isStruct=isStruct patStart=pStart patLen=pLen binds=bnds />)
        }
        StmtAst.Match(val scrut, val arms, val span) => {
            val sc: U64 = lowerExpr(c: inout c, e: scrut)
            val ma: Array[MatchArm] = lowerMatchArms(c: inout c, arms: arms, isExpr: false)
            result = c.pushStmt(s: <Stmt.Match scrut=sc arms=ma />)
        }
        StmtAst.Panic(val msg, val span) => {
            val m: U64 = lowerExpr(c: inout c, e: msg)
            result = c.pushStmt(s: <Stmt.Panic msg=m offset=span.start />)
        }
        StmtAst.Give(val value, val span) => {
            val v: U64 = lowerExpr(c: inout c, e: value)
            result = c.pushStmt(s: <Stmt.Give value=v />)
        }
        StmtAst.Break(val span) => { result = c.pushStmt(s: <Stmt.Break />) }
        StmtAst.Continue(val span) => { result = c.pushStmt(s: <Stmt.Continue />) }
        StmtAst.Destructure(val binds, val init, val span) => {
            // normally expanded by lowerBlock into several statements; reached only if a
            // destructuring appears outside a statement list — lower the initializer as a
            // plain expression statement so the value is still evaluated.
            result = c.pushStmt(s: <Stmt.ExprStmt expr=lowerExpr(c: inout c, e: init) />)
        }
    }
    return result
}

// Lower a record-destructuring `(val x, val y) = init` into a temp binding plus one
// `val` per field, appended to `stmts`: `val __dtmp = init; val x = __dtmp.x; …`. The
// temp's struct is recovered from the initializer (records track their struct like any
// value), so no annotation is needed; `__dtmp` is reused (later destructures shadow it,
// harmlessly — each temp is consumed by the field reads that immediately follow).
fn lowerDestructureInto(c: inout Comp, binds: Array[BindAst], init: ExprAst, stmts: inout Array[U64]) {
    val tmp: Bind = internBytes(c: inout c, s: "__dtmp")
    val iv: U64 = lowerExpr(c: inout c, e: init)
    stmts.append(value: c.pushStmt(s: <Stmt.Let mutable=false nameStart=tmp.nameStart nameLen=tmp.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=iv />))
    mut val bi: U64 = 0
    while bi < binds.count {
        val fldName: Bind = internBytes(c: inout c, s: binds[bi].field)
        val nameB: Bind = internBytes(c: inout c, s: binds[bi].name)
        val recv: U64 = c.pushExpr(e: <Expr.Ident start=tmp.nameStart len=tmp.nameLen />)
        val fld: U64 = c.pushExpr(e: <Expr.Field base=recv nameStart=fldName.nameStart nameLen=fldName.nameLen />)
        stmts.append(value: c.pushStmt(s: <Stmt.Let mutable=false nameStart=nameB.nameStart nameLen=nameB.nameLen tyStart=0 tyLen=0 tyIsArray=false ty=0 init=fld />))
        bi += 1
    }
}

fn lowerBlock(c: inout Comp, b: BlockAst) -> U64 {
    mut val stmts: Array[U64] = []
    mut val i: U64 = 0
    while i < b.stmts.count {
        // a destructuring statement expands to several arena statements (temp + fields).
        match b.stmts[i] {
            StmtAst.Destructure(val binds, val init, val span) => {
                lowerDestructureInto(c: inout c, binds: binds, init: init, stmts: inout stmts)
            }
            _ => {
                stmts.append(lowerStmt(c: inout c, s: b.stmts[i]))
            }
        }
        i += 1
    }
    val id: U64 = c.blocks.count
    c.blocks.append(<Block stmts=stmts />)
    return id
}

// ---- declaration lowering (shared DeclAst value tree -> the compiler arena) ----
//
// Mirrors Parser/Decl.pw's parseStruct/parseEnum arena seeding so the frontend can
// parse nominal declarations through the ONE shared @Std/Syntax parser (spec/16,
// worklog A). Names are re-interned (codegen reads bytes; the emitted C is
// byte-identical) — struct/enum names never feed `moduleOf` (types are ambient, not
// visibility-gated), so re-interning is sound here. (A *function* declaration name
// does feed moduleOf; that path keeps the original offset — handled when free
// functions move to this lowering.)

// Lower generic parameter names `[T, U]` (Array[String]) to the arena's Bind spans.
fn lowerTypeParamNames(c: inout Comp, names: Array[String]) -> Array[Bind] {
    mut val out: Array[Bind] = []
    mut val i: U64 = 0
    while i < names.count {
        out.append(internBytes(c: inout c, s: names[i]))
        i += 1
    }
    return out
}

// Lower one field (struct or enum-variant payload) to a FieldDef. A field with no
// type annotation leaves the type spans zero (matching parseTypeTok's behaviour),
// rather than interning an empty type.
fn lowerFieldDef(c: inout Comp, f: FieldAst) -> FieldDef {
    val nm: Bind = internBytes(c: inout c, s: f.name)
    mut val tyStart: U64 = 0
    mut val tyLen: U64 = 0
    mut val tyIsArray: Bool = false
    mut val tyRef: U64 = 0
    if f.ty.name.bytes.count > 0 || f.ty.isRecord {
        val pt: PType = lowerType(c: inout c, t: f.ty)
        tyStart = pt.start
        tyLen = pt.len
        tyIsArray = pt.isArray
        tyRef = pt.ref
    }
    mut val hasDefault: Bool = false
    mut val defaultVal: U64 = 0
    if f.hasDefault {
        defaultVal = lowerExpr(c: inout c, e: f.defaultVal)
        hasDefault = true
    }
    return <FieldDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout c, start: tyStart, len: tyLen) tyIsArray=tyIsArray ty=tyRef isMut=f.isMut hasDefault=hasDefault defaultVal=defaultVal vis=f.vis />
}

// Lower a `struct` DeclAst: append a StructDef, a synthetic `Type_deinit` method +
// a c.deinits record when the struct carries a `deinit`, then drain pending
// `@[...]` derives onto the type. Mirrors parseStruct.
fn lowerStructDecl(c: inout Comp, d: DeclAst) {
    val nm: Bind = internBytes(c: inout c, s: d.name)
    val typeParams: Array[Bind] = lowerTypeParamNames(c: inout c, names: d.typeParams)
    mut val fields: Array[FieldDef] = []
    mut val i: U64 = 0
    while i < d.fields.count {
        fields.append(lowerFieldDef(c: inout c, f: d.fields[i]))
        i += 1
    }
    // a `deinit { body }` lowers to a synthetic method `Type_deinit(Type self)`
    // (name span = the text "deinit") plus a c.deinits record so scope-exit drops
    // fire it. Appended at the same point in c.funcs as the native parser (during
    // this struct's processing), so the function stream order is preserved.
    if d.hasDeinit {
        val deinitN: Bind = internBytes(c: inout c, s: "deinit")
        val body: U64 = lowerBlock(c: inout c, b: d.deinitBody)
        val noParams: Array[Param] = []
        val noTypeParams: Array[Bind] = []
        c.funcs.append(<Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout c, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=nm.nameStart recvLen=nm.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
        c.deinits.append(<Bind nameStart=nm.nameStart nameLen=nm.nameLen fieldStart=nm.nameStart fieldLen=nm.nameLen />)
    }
    c.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams fields=fields isUnique=d.isUnique isExtern=false />)
    // `defaultExtension #Ext` (spec/09): record (type, extension) so the extension's
    // methods join this type's bare resolution surface (findMethod).
    val tid: U64 = intern(c: inout c, start: nm.nameStart, len: nm.nameLen)
    mut val di: U64 = 0
    while di < d.defaultExts.count {
        val extN: Bind = internBytes(c: inout c, s: d.defaultExts[di])
        c.defaultExts.append(<DefaultExt typeId=tid extId=intern(c: inout c, start: extN.nameStart, len: extN.nameLen) />)
        di += 1
    }
    drainDerives(c: inout c, typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
}

// Lower an `enum` DeclAst: append an EnumDef, then drain pending derives. Mirrors
// parseEnum. Variant payload fields take no modifiers (vis 0, not mut, no default).
fn lowerEnumDecl(c: inout Comp, d: DeclAst) {
    val nm: Bind = internBytes(c: inout c, s: d.name)
    val typeParams: Array[Bind] = lowerTypeParamNames(c: inout c, names: d.typeParams)
    mut val variants: Array[Variant] = []
    mut val i: U64 = 0
    while i < d.variants.count {
        val v: VariantAst = d.variants[i]
        val vn: Bind = internBytes(c: inout c, s: v.name)
        mut val vfields: Array[FieldDef] = []
        mut val j: U64 = 0
        while j < v.fields.count {
            vfields.append(lowerFieldDef(c: inout c, f: v.fields[j]))
            j += 1
        }
        variants.append(<Variant nameStart=vn.nameStart nameLen=vn.nameLen nameId=intern(c: inout c, start: vn.nameStart, len: vn.nameLen) fields=vfields />)
        i += 1
    }
    c.enums.append(<EnumDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) typeParams=typeParams variants=variants />)
    // `defaultExtension #Ext` in the enum body (spec/09): record (type, extension) so
    // the extension's methods join this enum's bare resolution surface (findMethod).
    val tid: U64 = intern(c: inout c, start: nm.nameStart, len: nm.nameLen)
    mut val di: U64 = 0
    while di < d.defaultExts.count {
        val extN: Bind = internBytes(c: inout c, s: d.defaultExts[di])
        c.defaultExts.append(<DefaultExt typeId=tid extId=intern(c: inout c, start: extN.nameStart, len: extN.nameLen) />)
        di += 1
    }
    drainDerives(c: inout c, typeStart: nm.nameStart, typeLen: nm.nameLen, isEnum: true, declStart: d.span.start, declEnd: d.span.end)
}

// Lower a free function DeclAst: append a Func, then a FuncBound per `where` atom.
// Mirrors parseFunc/parseFuncCommon for the free-function case (no receiver, no
// impl-level bounds). The function's NAME keeps its ORIGINAL offset (d.nameSpan):
// `moduleOf` attributes the declaration to its module for cross-module visibility
// (checkUseVisibility), so it must not be re-interned.
fn lowerFuncDecl(c: inout Comp, d: DeclAst) {
    val nameStart: U64 = d.nameSpan.start
    val nameLen: U64 = d.nameSpan.end - d.nameSpan.start
    val typeParams: Array[Bind] = lowerTypeParamNames(c: inout c, names: d.typeParams)
    val params: Array[Param] = lowerParams(c: inout c, params: d.params)
    mut val retStart: U64 = 0
    mut val retLen: U64 = 0
    mut val retIsArray: Bool = false
    mut val retRef: U64 = 0
    if d.hasRet {
        val pt: PType = lowerType(c: inout c, t: d.ret)
        retStart = pt.start
        retLen = pt.len
        retIsArray = pt.isArray
        retRef = pt.ref
    }
    val savedRet: U64 = c.lowerRetTy
    c.lowerRetTy = retRef
    val body: U64 = lowerBlock(c: inout c, b: d.body)
    c.lowerRetTy = savedRet
    val fnIdx: U64 = c.funcs.count
    c.funcs.append(<Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout c, start: nameStart, len: nameLen) typeParams=typeParams params=params hasRet=d.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=d.isAsync isExtern=false />)
    mut val wi: U64 = 0
    while wi < d.whereParams.count {
        val pn: Bind = internBytes(c: inout c, s: d.whereParams[wi])
        val tn: Bind = internBytes(c: inout c, s: d.whereTraits[wi])
        c.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramNameId=pn.nameId traitNameId=tn.nameId traitStart=tn.nameStart traitLen=tn.nameLen />)
        wi += 1
    }
    // attach pending `@[...]` directives to this fn (a macro on a free function);
    // declStart/declEnd = the fn's source span for the gen harness slice.
    drainDerives(c: inout c, typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: d.span.start, declEnd: d.span.end)
}

// Append a FuncBound per `where` atom (parallel name lists) onto function `fnIdx`.
// Names are re-interned (funcBounds are text-matched downstream; only error-path
// `lineOf` reads the offset, which doesn't fire in correct code).
fn appendFuncBounds(c: inout Comp, fnIdx: U64, params: Array[String], traits: Array[String]) {
    mut val i: U64 = 0
    while i < params.count {
        val pn: Bind = internBytes(c: inout c, s: params[i])
        val tn: Bind = internBytes(c: inout c, s: traits[i])
        c.funcBounds.append(<FuncBound fnIdx=fnIdx paramStart=pn.nameStart paramLen=pn.nameLen paramNameId=pn.nameId traitNameId=tn.nameId traitStart=tn.nameStart traitLen=tn.nameLen />)
        i += 1
    }
}

// Lower a method / assoc-fn member of an impl block. Mirrors parseFuncCommon for
// the impl-member case: a witnessed requirement signature (for a trait impl, body-
// less, before the body), then either a `via` alias (no body/func) or the real
// method appended to c.funcs with its `where`-bounds (method-own then impl-level).
// `recvN` is the (re-interned) receiver type name; `implParamBinds` the impl's `[T]`.
fn lowerMethodMember(c: inout Comp, im: ImplAst, m: MemberAst, recvN: Bind, implParamBinds: Array[Bind], hasRecv: Bool, isAssoc: Bool, witnessed: inout Array[Func]) {
    val nameN: Bind = internBytes(c: inout c, s: m.name)
    // typeParams = impl's `[T]` (in scope for every member) ++ the method's own.
    mut val typeParams: Array[Bind] = []
    mut val ipi: U64 = 0
    while ipi < implParamBinds.count {
        typeParams.append(implParamBinds[ipi])
        ipi += 1
    }
    val ownParams: Array[Bind] = lowerTypeParamNames(c: inout c, names: m.typeParams)
    mut val opi: U64 = 0
    while opi < ownParams.count {
        typeParams.append(ownParams[opi])
        opi += 1
    }
    val params: Array[Param] = lowerParams(c: inout c, params: m.params)
    mut val retStart: U64 = 0
    mut val retLen: U64 = 0
    mut val retIsArray: Bool = false
    mut val retRef: U64 = 0
    if m.hasRet {
        val pt: PType = lowerType(c: inout c, t: m.ret)
        retStart = pt.start
        retLen = pt.len
        retIsArray = pt.isArray
        retRef = pt.ref
    }
    // a trait-impl member witnesses a requirement (body or via). The witnessed sig
    // is a pure requirement signature (body 0, no recv/self/assoc/async).
    if im.isTraitImpl {
        if m.isVia {
            val realN: Bind = internBytes(c: inout c, s: m.viaName)
            c.methodAliases.append(<MethodAlias recvStart=recvN.nameStart recvLen=recvN.nameLen recvId=intern(c: inout c, start: recvN.nameStart, len: recvN.nameLen) aliasStart=nameN.nameStart aliasLen=nameN.nameLen aliasId=intern(c: inout c, start: nameN.nameStart, len: nameN.nameLen) realStart=realN.nameStart realLen=realN.nameLen realId=intern(c: inout c, start: realN.nameStart, len: realN.nameLen) />)
            witnessed.append(<Func nameStart=nameN.nameStart nameLen=nameN.nameLen nameId=intern(c: inout c, start: nameN.nameStart, len: nameN.nameLen) typeParams=typeParams params=params hasRet=m.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
            return
        }
        witnessed.append(<Func nameStart=nameN.nameStart nameLen=nameN.nameLen nameId=intern(c: inout c, start: nameN.nameStart, len: nameN.nameLen) typeParams=typeParams params=params hasRet=m.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    }
    val savedRet: U64 = c.lowerRetTy
    c.lowerRetTy = retRef
    val body: U64 = lowerBlock(c: inout c, b: m.body)
    c.lowerRetTy = savedRet
    val fnIdx: U64 = c.funcs.count
    // an extension method (spec/09) is tagged with its extension's name id so it is
    // excluded from bare resolution (reachable only via `value#Ext.m()`).
    mut val extId: U64 = 0
    if im.extName.bytes.count > 0 {
        val extN: Bind = internBytes(c: inout c, s: im.extName)
        extId = intern(c: inout c, start: extN.nameStart, len: extN.nameLen)
    }
    c.funcs.append(<Func nameStart=nameN.nameStart nameLen=nameN.nameLen nameId=intern(c: inout c, start: nameN.nameStart, len: nameN.nameLen) recvId=intern(c: inout c, start: recvN.nameStart, len: recvN.nameLen) typeParams=typeParams params=params hasRet=m.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=body hasRecv=hasRecv recvStart=recvN.nameStart recvLen=recvN.nameLen selfInout=m.selfInout selfMove=m.selfMove isAssoc=isAssoc isAsync=m.isAsync isExtern=false isPub=im.isPub extId=extId />)
    appendFuncBounds(c: inout c, fnIdx: fnIdx, params: m.whereParams, traits: m.whereTraits)
    appendFuncBounds(c: inout c, fnIdx: fnIdx, params: im.whereParams, traits: im.whereTraits)
}

// Lower an `impl` block (spec/07,08): each member becomes a method / assoc-fn Func
// (with receiver), a synthetic deinit, or an associated-type binding; a trait impl
// also records a Conform with the witnessed requirement signatures. Mirrors
// parseImpl. All impl names are re-interned (none feed moduleOf — methods resolve by
// receiver+selector, conformances by text), keeping the emitted C byte-identical.
fn lowerImpl(c: inout Comp, im: ImplAst) {
    val recvN: Bind = internBytes(c: inout c, s: im.recvType.name)
    val implParamBinds: Array[Bind] = lowerTypeParamNames(c: inout c, names: im.implParams)
    mut val witnessed: Array[Func] = []
    mut val mi: U64 = 0
    while mi < im.members.count {
        val m: MemberAst = im.members[mi]
        match m.kind {
            MemberKind.Method => {
                lowerMethodMember(c: inout c, im: im, m: m, recvN: recvN, implParamBinds: implParamBinds, hasRecv: true, isAssoc: false, witnessed: inout witnessed)
            }
            MemberKind.AssocFn => {
                lowerMethodMember(c: inout c, im: im, m: m, recvN: recvN, implParamBinds: implParamBinds, hasRecv: false, isAssoc: true, witnessed: inout witnessed)
            }
            MemberKind.Deinit => {
                val deinitN: Bind = internBytes(c: inout c, s: "deinit")
                val body: U64 = lowerBlock(c: inout c, b: m.body)
                val noParams: Array[Param] = []
                val noTypeParams: Array[Bind] = []
                c.funcs.append(<Func nameStart=deinitN.nameStart nameLen=deinitN.nameLen nameId=intern(c: inout c, start: deinitN.nameStart, len: deinitN.nameLen) recvId=intern(c: inout c, start: recvN.nameStart, len: recvN.nameLen) typeParams=noTypeParams params=noParams hasRet=false retStart=0 retLen=0 retIsArray=false retTy=0 body=body hasRecv=true recvStart=recvN.nameStart recvLen=recvN.nameLen selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
                c.deinits.append(<Bind nameStart=recvN.nameStart nameLen=recvN.nameLen fieldStart=recvN.nameStart fieldLen=recvN.nameLen />)
            }
            MemberKind.AssocType => {
                val pt: PType = lowerType(c: inout c, t: m.assocTy)
                val atN: Bind = internBytes(c: inout c, s: m.name)
                c.assocBindings.append(<AssocBinding recvStart=recvN.nameStart recvLen=recvN.nameLen recvId=intern(c: inout c, start: recvN.nameStart, len: recvN.nameLen) nameStart=atN.nameStart nameLen=atN.nameLen nameId=intern(c: inout c, start: atN.nameStart, len: atN.nameLen) tyStart=pt.start tyLen=pt.len tyIsArray=pt.isArray ty=pt.ref />)
            }
        }
        mi += 1
    }
    if im.isTraitImpl {
        val traitN: Bind = internBytes(c: inout c, s: im.traitName)
        mut val traitArgs: Array[U64] = []
        mut val ti: U64 = 0
        while ti < im.traitArgs.count {
            val pt: PType = lowerType(c: inout c, t: im.traitArgs[ti])
            traitArgs.append(pt.ref)
            ti += 1
        }
        c.conforms.append(<Conform typeStart=recvN.nameStart typeLen=recvN.nameLen typeId=intern(c: inout c, start: recvN.nameStart, len: recvN.nameLen) traitStart=traitN.nameStart traitLen=traitN.nameLen traitId=intern(c: inout c, start: traitN.nameStart, len: traitN.nameLen) traitArgs=traitArgs derived=false witnessed=witnessed />)
    }
    // attach pending `@[...]` directives to this impl block (a macro on an impl);
    // declStart/declEnd = the impl block's source span for the gen harness slice.
    drainDerives(c: inout c, typeStart: recvN.nameStart, typeLen: recvN.nameLen, isEnum: false, declStart: im.span.start, declEnd: im.span.end)
}

// Lower a body-less signature (trait requirement / extern decl) to a Func. The
// name keeps its ORIGINAL offset (sig.nameSpan): an extern fn name feeds moduleOf
// for cross-module calls; a trait req name is harmless to keep original. Mirrors
// parseReqSig.
fn lowerSigToFunc(c: inout Comp, sig: SigAst, isExtern: Bool, isCExtern: Bool) -> Func {
    val nameStart: U64 = sig.nameSpan.start
    val nameLen: U64 = sig.nameSpan.end - sig.nameSpan.start
    val typeParams: Array[Bind] = lowerTypeParamNames(c: inout c, names: sig.typeParams)
    val params: Array[Param] = lowerParams(c: inout c, params: sig.params)
    mut val retStart: U64 = 0
    mut val retLen: U64 = 0
    mut val retIsArray: Bool = false
    mut val retRef: U64 = 0
    if sig.hasRet {
        val pt: PType = lowerType(c: inout c, t: sig.ret)
        retStart = pt.start
        retLen = pt.len
        retIsArray = pt.isArray
        retRef = pt.ref
    }
    return <Func nameStart=nameStart nameLen=nameLen nameId=intern(c: inout c, start: nameStart, len: nameLen) typeParams=typeParams params=params hasRet=sig.hasRet retStart=retStart retLen=retLen retIsArray=retIsArray retTy=retRef body=0 hasRecv=false recvStart=0 recvLen=0 selfInout=sig.selfInout selfMove=false isAssoc=sig.isAssoc isAsync=false isExtern=isExtern isCExtern=isCExtern />
}

// Lower a `trait` declaration to a TraitDef (spec/08). Requirement signatures are
// body-less Funcs; supertrait/assoc-type names are re-interned (text-matched
// downstream). Mirrors parseTrait.
fn lowerTrait(c: inout Comp, t: TraitAst) {
    val nameStart: U64 = t.nameSpan.start
    val nameLen: U64 = t.nameSpan.end - t.nameSpan.start
    mut val supertraits: Array[Bind] = []
    mut val si: U64 = 0
    while si < t.supertraits.count {
        supertraits.append(internBytes(c: inout c, s: t.supertraits[si]))
        si += 1
    }
    mut val reqs: Array[Func] = []
    mut val ri: U64 = 0
    while ri < t.reqs.count {
        reqs.append(lowerSigToFunc(c: inout c, sig: t.reqs[ri], isExtern: false, isCExtern: false))
        ri += 1
    }
    mut val assocTypes: Array[Bind] = []
    mut val ai: U64 = 0
    while ai < t.assocTypes.count {
        assocTypes.append(internBytes(c: inout c, s: t.assocTypes[ai]))
        ai += 1
    }
    val typeParams: Array[Bind] = lowerTypeParamNames(c: inout c, names: t.typeParams)
    c.traits.append(<TraitDef nameStart=nameStart nameLen=nameLen nameId=intern(c: inout c, start: nameStart, len: nameLen) typeParams=typeParams supertraits=supertraits reqs=reqs assocTypes=assocTypes />)
    // attach pending `@[...]` directives to this trait (a macro on a trait);
    // declStart/declEnd = the trait's source span for the gen harness slice.
    drainDerives(c: inout c, typeStart: nameStart, typeLen: nameLen, isEnum: false, declStart: t.span.start, declEnd: t.span.end)
}

// Lower an `extern "plew-intrinsic"` block (spec/15): each fn -> a Func(isExtern),
// each opaque struct -> a body-less StructDef(isExtern). Mirrors parseExtern. fns
// are appended before structs; within each array order is source order, which is
// all that matters (the arrays are independent). Reports a non-intrinsic ABI.
fn lowerExtern(c: inout Comp, e: ExternAst) {
    if e.abiOk {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: e.abiSpan.start), msg: "unknown ABI — only `extern(plewIntrinsic)` (intrinsic floor) and `extern(c)` (foreign C) are supported")
    }
    mut val fi: U64 = 0
    while fi < e.fns.count {
        // extern(c) functions take no argument labels (a C function has none — the
        // label would be invented provenance). The author must mark each parameter
        // label-suppressed `name~:` EXPLICITLY (spec/15): a labelled param is an
        // error, not a silently-stripped label (no hidden meaning). Labels for
        // readability/safety live in a Plew `fn` wrapper over the raw extern.
        if e.abiC {
            val sig: SigAst = e.fns[fi]
            mut val pj: U64 = 0
            while pj < sig.params.count {
                if sig.params[pj].noLabel {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: sig.params[pj].span.start), msg: "extern(c) function parameters take no label — write `<name>~:` (C functions have no argument labels; put labels on a Plew wrapper)")
                }
                pj += 1
            }
        }
        c.funcs.append(lowerSigToFunc(c: inout c, sig: e.fns[fi], isExtern: true, isCExtern: e.abiC))
        fi += 1
    }
    mut val si: U64 = 0
    while si < e.structNames.count {
        val nm: Bind = internBytes(c: inout c, s: e.structNames[si])
        val noTP: Array[Bind] = []
        val noFields: Array[FieldDef] = []
        c.structs.append(<StructDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) typeParams=noTP fields=noFields isUnique=false isExtern=true isCExtern=e.abiC />)
        si += 1
    }
}

// Lower a nominal declaration by kind (struct / enum / free function).
fn lowerDecl(c: inout Comp, d: DeclAst) {
    match d.kind {
        DeclKind.Struct => { lowerStructDecl(c: inout c, d: d) }
        DeclKind.Enum => { lowerEnumDecl(c: inout c, d: d) }
        DeclKind.Func => { lowerFuncDecl(c: inout c, d: d) }
    }
}

// Lower an `import … with { names }` statement (spec/15): record each imported name
// in c.imports (its ORIGINAL offset feeds moduleOf for the importing module). The
// path itself is consumed by the loader to find files; nothing else is recorded.
fn lowerImport(c: inout Comp, imp: ImportAst) {
    mut val i: U64 = 0
    while i < imp.names.count {
        val nspan: Span = imp.nameSpans[i]
        markImport(c: inout c, segStart: imp.segSpan.start, segLen: imp.segSpan.end - imp.segSpan.start, nameStart: nspan.start, nameLen: nspan.end - nspan.start)
        i += 1
    }
}

// Lower a `@[...]` directive (spec/16): each derive request becomes a pendingDerive
// (applied to the next type declaration via drainDerives). The directive name keeps
// its ORIGINAL offset (text-matched downstream); args lower to MakeField.
fn lowerDirective(c: inout Comp, dir: DirectiveAst) {
    mut val i: U64 = 0
    while i < dir.reqs.count {
        val r: DeriveReqAst = dir.reqs[i]
        val args: Array[MakeField] = lowerMakeFields(c: inout c, fields: r.args, typeName: "", variant: "", isEnum: false)
        c.pendingDerives.append(<DeriveReq typeStart=0 typeLen=0 isEnum=false nameStart=r.nameSpan.start nameLen=r.nameSpan.end - r.nameSpan.start declStart=0 declEnd=0 args=args />)
        i += 1
    }
}

// Lower an `export <inner>` item: lower the inner declaration, then record its
// name(s) as exported (spec/15). Mirrors parseExport's per-kind recording: a struct/
// enum/fn/trait records the one decl; an `export extern { }` block records every fn
// and opaque struct it adds.
fn lowerExportItem(c: inout Comp, inner: TopItemAst) {
    match inner {
        TopItemAst.Extern(val e) => {
            val xfB: U64 = c.funcs.count
            val xsB: U64 = c.structs.count
            lowerExtern(c: inout c, e: e)
            mut val xi: U64 = xfB
            while xi < c.funcs.count {
                recordExport(c: inout c, nameStart: c.funcs[xi].nameStart, nameLen: c.funcs[xi].nameLen)
                xi += 1
            }
            mut val xj: U64 = xsB
            while xj < c.structs.count {
                recordExport(c: inout c, nameStart: c.structs[xj].nameStart, nameLen: c.structs[xj].nameLen)
                xj += 1
            }
        }
        TopItemAst.Decl(val d) => {
            val sB: U64 = c.structs.count
            val eB: U64 = c.enums.count
            val fB: U64 = c.funcs.count
            lowerDecl(c: inout c, d: d)
            match d.kind {
                DeclKind.Struct => { recordExport(c: inout c, nameStart: c.structs[sB].nameStart, nameLen: c.structs[sB].nameLen) }
                DeclKind.Enum => { recordExport(c: inout c, nameStart: c.enums[eB].nameStart, nameLen: c.enums[eB].nameLen) }
                DeclKind.Func => { recordExport(c: inout c, nameStart: c.funcs[fB].nameStart, nameLen: c.funcs[fB].nameLen) }
            }
        }
        TopItemAst.Trait(val t) => {
            val tB: U64 = c.traits.count
            lowerTrait(c: inout c, t: t)
            recordExport(c: inout c, nameStart: c.traits[tB].nameStart, nameLen: c.traits[tB].nameLen)
        }
        TopItemAst.GlobalVal(val s) => {
            val gB: U64 = c.globals.count
            lowerGlobalVal(c: inout c, s: s)
            if c.globals.count > gB {
                recordExport(c: inout c, nameStart: c.globals[gB].nameStart, nameLen: c.globals[gB].nameLen)
            }
        }
        _ => { lowerTopItem(c: inout c, item: inner) }
    }
}

// Lower one top-level item (spec/15): dispatch each parsed `TopItemAst` to its arena
// / Comp-state lowering. This is the single frontend lowering entry; the compiler's
// `parseProgram` parses a file with the shared `parseProgramAst` and lowers each item
// through here.
fn lowerTopItem(c: inout Comp, item: TopItemAst) {
    match item {
        TopItemAst.Decl(val d) => { lowerDecl(c: inout c, d: d) }
        TopItemAst.Impl(val im) => { lowerImpl(c: inout c, im: im) }
        TopItemAst.Trait(val t) => { lowerTrait(c: inout c, t: t) }
        TopItemAst.Extern(val e) => { lowerExtern(c: inout c, e: e) }
        TopItemAst.Import(val imp) => { lowerImport(c: inout c, imp: imp) }
        TopItemAst.Export(val inner) => { lowerExportItem(c: inout c, inner: inner) }
        TopItemAst.ReExport(val pathSpan) => {}
        TopItemAst.Directive(val dir) => { lowerDirective(c: inout c, dir: dir) }
        TopItemAst.GlobalVal(val s) => { lowerGlobalVal(c: inout c, s: s) }
        TopItemAst.NewType(val name, val ty, val isPub, val span) => { lowerNewtype(c: inout c, name: name, ty: ty) }
    }
}

// Lower a `newtype Name = Underlying` (spec/10): record the distinct name and its
// underlying type. Codegen resolves the name to the underlying for representation and
// method dispatch; the type checker keeps them distinct.
fn lowerNewtype(c: inout Comp, name: String, ty: TypeAst) {
    val nm: Bind = internBytes(c: inout c, s: name)
    val under: PType = lowerType(c: inout c, t: ty)
    c.newtypes.append(value: <NewtypeDef nameStart=nm.nameStart nameLen=nm.nameLen nameId=intern(c: inout c, start: nm.nameStart, len: nm.nameLen) underStart=under.start underLen=under.len underRef=under.ref />)
}

// Lower a module-level variable (spec/15). The shared parser hands us the same
// `StmtAst.Let` a local binding produces; we lower it to an arena `Stmt.Let` (so the
// initializer / type are arena nodes) and record a `Comp.globals` entry keyed by the
// binding's name. The backend emits the LLVM global and its one-time init.
fn lowerGlobalVal(c: inout Comp, s: StmtAst) {
    val stid: U64 = lowerStmt(c: inout c, s: s)
    match c.stmts[stid] {
        Stmt.Let(val mutable, val nameStart, val nameLen, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: _) => {
            c.globals.append(<Global nameStart=nameStart nameLen=nameLen letStmt=stid mutable=mutable />)
        }
        _ => {}
    }
}

