// Part of the Plew compiler module (root: _.pw). Code generation: arena AST
// -> C, plus the lightweight type recovery and acceptance-soundness checks.

// ---- C code generation ----

fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

fn writeInt(n: I64) {
    if n < 0 {
        write(s: "-")
        writeInt(n: 0 - n)
        return
    }
    if n >= 10 {
        writeInt(n: n / 10)
    }
    write(s: digitStr(d: n % 10))
}

// U64 digit (0-9) -> its glyph. A U64 twin of digitStr: with no implicit
// conversions and `as` restricted to lossless, an I64 digitStr cannot serve a
// U64 caller (U64->I64 is not lossless), so unsigned printing needs its own.
fn digitStrU(d: U64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// Print a U64 (handle ids, indices, line numbers) with no sign handling — keeps
// the unsigned values unsigned end to end (no `U64 as I64` cast).
fn writeU64(n: U64) {
    if n >= 10 {
        writeU64(n: n / 10)
    }
    write(s: digitStrU(d: n % 10))
}

// Emit an integer-literal magnitude (Expr.Int.value; a leading `-` is emitted
// separately by the Unary node). A bare C decimal constant > LLONG_MAX is ill-
// formed, so values above 2^63-1 get a `ULL` suffix to read as unsigned.
fn writeIntLit(n: U64) {
    writeU64(n: n)
    if n > 9223372036854775807U64 {
        write(s: "ULL")
    }
}

// Emit a byte span verbatim (no identifier mangling). Used for raw content such
// as string-literal bytes, where a `_` suffix would corrupt the value.
fn writeSpanRaw(c: inout Comp, start: U64, len: U64) {
    mut val j: U64 = 0
    while j < len {
        writeByte(c.bytes[start + j])
        j += 1
    }
}

// Whether the span is exactly a C reserved word. Plew identifiers (lowercase
// vars/fns/fields/params) may legally be C keywords (`default`, `double`, …) and
// would emit broken C; type names are PascalCase and never match. Fast pre-check:
// C keywords are lowercase and at most 8 bytes long.
fn isCKeyword(c: inout Comp, start: U64, len: U64) -> Bool {
    if len == 0 {
        return false
    }
    if len > 8 {
        return false
    }
    val b0: U8 = c.bytes[start]
    if b0 < 97 {
        return false
    }
    if b0 > 122 {
        return false
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "auto") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "break") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "case") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "char") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "const") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "continue") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "default") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "do") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "double") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "else") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "enum") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "extern") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "float") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "for") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "goto") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "if") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "inline") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "int") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "long") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "register") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "restrict") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "return") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "short") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "signed") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "sizeof") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "static") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "struct") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "switch") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "typedef") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "union") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "unsigned") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "void") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "volatile") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "while") { return true }
    return false
}

// Emit an identifier span, mangling C reserved words (append `_`) so a Plew name
// like `default`/`double` becomes valid C. Deterministic and content-based, so a
// declaration and every use mangle identically. (String-literal content goes
// through writeSpanRaw — it must not be mangled.)
fn writeSpan(c: inout Comp, start: U64, len: U64) {
    writeSpanRaw(c: inout c, start: start, len: len)
    if isCKeyword(c: inout c, start: start, len: len) {
        writeByte(95)
    }
}

// Compiler diagnostics. Ordinary module functions (not ambient builtins) so the
// compiler source stays spec-valid: they report on stderr via @Std/Io `eprint`
// and stop via @Std/Process `exit`. `compileErrorAt` includes a source line.
fn eprintInt(n: I64) {
    if n >= 10 {
        eprintInt(n: n / 10)
    }
    eprint(text: digitStr(d: n % 10))
}

fn compileError(msg: String) {
    eprint(text: "plewc: error: ")
    eprint(text: msg)
    eprint(text: "\n")
    exit(code: 1)
}

fn compileErrorAt(line: I64, msg: String) {
    eprint(text: "plewc: error: line ")
    eprintInt(n: line)
    eprint(text: ": ")
    eprint(text: msg)
    eprint(text: "\n")
    exit(code: 1)
}

fn isPrimType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "Bool") { return true }
    return false
}

// Whether a type-name span is one of the 8 integer types (excludes Bool/String).
fn isIntType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") { return true }
    return false
}

// Bit width of an integer type-name span (0 if not an integer type).
fn intBits(c: inout Comp, start: U64, len: U64) -> U64 {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") { return 8 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") { return 8 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") { return 16 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") { return 16 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") { return 32 }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") { return 32 }
    return 64
}

// Whether an integer type-name span is signed (`I*`). Assumes isIntType.
fn intSigned(c: inout Comp, start: U64, len: U64) -> Bool {
    return c.bytes[start] == 'I'
}

// Whether `src as dst` (both integer types) is lossless — i.e. dst represents
// every src value (spec: `as` is lossless-only; narrowing/signedness -> TryFrom).
fn losslessInt(c: inout Comp, srcStart: U64, srcLen: U64, dstStart: U64, dstLen: U64) -> Bool {
    val sBits: U64 = intBits(c: inout c, start: srcStart, len: srcLen)
    val dBits: U64 = intBits(c: inout c, start: dstStart, len: dstLen)
    val sSigned: Bool = intSigned(c: inout c, start: srcStart, len: srcLen)
    val dSigned: Bool = intSigned(c: inout c, start: dstStart, len: dstLen)
    if sSigned {
        if dSigned {
            return dBits >= sBits
        }
        // signed -> unsigned: negatives are unrepresentable.
        return false
    }
    if dSigned {
        // unsigned -> signed needs a strictly wider target (the sign bit).
        return dBits > sBits
    }
    return dBits >= sBits
}

// Whether the literal (magnitude `value`, negated if `neg`) fits the target
// integer type's range.
fn litFitsType(c: inout Comp, value: U64, neg: Bool, dstStart: U64, dstLen: U64) -> Bool {
    val bits: U64 = intBits(c: inout c, start: dstStart, len: dstLen)
    val sgn: Bool = intSigned(c: inout c, start: dstStart, len: dstLen)
    return litFitsBits(value: value, neg: neg, bits: bits, sgn: sgn)
}

// Whether the literal (non-negative magnitude `value`, negated when `neg`) fits
// an integer type of the given width and signedness. Span-free core of
// litFitsType, so synthetic contexts (index = U64, print = I64) can range-check
// literals without a type-name span. The 64-bit signed-negative bound (2^63) is
// expressed via `value - 1 <= 2^63-1` so no 2^63 literal is needed.
fn litFitsBits(value: U64, neg: Bool, bits: U64, sgn: Bool) -> Bool {
    if neg {
        // a negative literal needs a signed target; magnitude <= 2^(bits-1).
        if sgn {
        } else {
            return false
        }
        if bits == 8 { return value <= 128 }
        if bits == 16 { return value <= 32768 }
        if bits == 32 { return value <= 2147483648 }
        if value == 0 { return true }
        return (value - 1) <= 9223372036854775807U64
    }
    if sgn {
        if bits == 8 { return value <= 127 }
        if bits == 16 { return value <= 32767 }
        if bits == 32 { return value <= 2147483647 }
        return value <= 9223372036854775807U64
    }
    if bits == 8 { return value <= 255 }
    if bits == 16 { return value <= 65535 }
    if bits == 32 { return value <= 4294967295 }
    return true
}

// Emit the C *element* type for a type-name span (no Array wrapper). Each Plew
// integer type maps to its exact-width C stdint type so storage width and
// signedness match the declared type (no hidden widening); U8 -> unsigned char
// (== uint8_t, keeps byte arrays aliasing a char buffer for String.bytes);
// Bool -> long long (width irrelevant); String -> PlewString; named -> echoed.
// The element ref recorded for the array-element name span (start,len), or 0 if
// it is not a recorded element (genCElem falls back to the name path then).
fn arrayElemRef(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val i: U64 = 0
    while i < c.arrayElems.count {
        val ae: Bind = c.arrayElems[i]
        if spansEqual(c: inout c, aStart: ae.nameStart, aLen: ae.nameLen, bStart: start, bLen: len) {
            return ae.fieldStart
        }
        i += 1
    }
    return 0
}

// The registered array-element name span for a given element ref (head name for
// a simple element, the mangled name for a compound one). Falls back to the
// type's head name. Used to recover a nested array's element name in exprType.
fn arrayElemNameForRef(c: inout Comp, elemRef: U64) -> Bind {
    mut val i: U64 = 0
    while i < c.arrayElems.count {
        val ae: Bind = c.arrayElems[i]
        // match by mangle (type refs are not interned, so the same type can have
        // a different index than the one stored at registration). Skip a non-ground
        // (template) entry like `Array[T]`'s element `T`: sameMangle resolves through
        // the active type-param env, so under an `impl[T] Array[T]` method's env
        // (T -> the concrete element) a stored `T` would spuriously match the
        // concrete lookup ref and return the template name (`Array_T_get`). Only a
        // ground stored element is a real match; the fallback below covers the rest.
        if ae.fieldStart != 0 {
            if tyRefIsGround(c: inout c, ref: ae.fieldStart) {
                if sameMangle(c: inout c, refA: ae.fieldStart, refB: elemRef) {
                    return <Bind nameStart=ae.nameStart nameLen=ae.nameLen fieldStart=elemRef fieldLen=0 />
                }
            }
        }
        i += 1
    }
    if elemRef < c.types.count {
        val t: TypeRef = c.types[elemRef]
        return <Bind nameStart=t.nameStart nameLen=t.nameLen fieldStart=elemRef fieldLen=0 />
    }
    return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
}

// --- numeric intrinsic runtime (O6) ---------------------------------------
// The C floor under the operator-trait witnesses: Core's `impl I32 as Add[I32]`
// etc. call intrinsics (`i32Add`), which lower to these `plew_*` functions. Per
// width and signedness: add/sub/mul are overflow-checked, div/rem zero-checked
// (+ signed INT_MIN/-1 / x%-1==0), bitwise/shift unchecked, bitnot truncates,
// neg checked (signed only). clang inlines them, so routing every `+` through a
// witness call is free at -O (spec/12: primitives are not special-cased — the
// operator desugars to a witness uniformly, the cost is hidden in the floor).

// `__attribute__((unused)) static <ct> plew_<p><name>(<ct> a, <ct> b) { `
fn wNumHdr2(c: inout Comp, p: String, name: String, ct: String) {
    write(s: "__attribute__((unused)) static ")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: name)
    write(s: "(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b) { ")
}

// An overflow-checked binary (`add`/`sub`/`mul`) via the clang builtin.
fn wNumChecked(c: inout Comp, p: String, name: String, ct: String, bi: String) {
    wNumHdr2(c: inout c, p: p, name: name, ct: ct)
    write(s: ct)
    write(s: " r; if (")
    write(s: bi)
    write(s: "(a, b, &r)) plew_panic((PlewString){\"integer overflow\", 16}); return r; }\n")
}

// An unchecked binary (`return a OP b;`): bitwise and shifts.
fn wNumPlain(c: inout Comp, p: String, name: String, ct: String, opc: String) {
    wNumHdr2(c: inout c, p: p, name: name, ct: ct)
    write(s: "return a")
    write(s: opc)
    write(s: "b; }\n")
}

// All operator intrinsics for one integer width.
fn emitIntRuntime(c: inout Comp, p: String, ct: String, mn: String, sgn: Bool) {
    wNumChecked(c: inout c, p: p, name: "Add", ct: ct, bi: "__builtin_add_overflow")
    wNumChecked(c: inout c, p: p, name: "Sub", ct: ct, bi: "__builtin_sub_overflow")
    wNumChecked(c: inout c, p: p, name: "Mul", ct: ct, bi: "__builtin_mul_overflow")
    wNumHdr2(c: inout c, p: p, name: "Div", ct: ct)
    write(s: "if (b == 0) plew_panic((PlewString){\"division by zero\", 16}); ")
    if sgn {
        write(s: "if (b == -1 && a == ")
        write(s: mn)
        write(s: ") plew_panic((PlewString){\"integer overflow\", 16}); ")
    }
    write(s: "return a / b; }\n")
    wNumHdr2(c: inout c, p: p, name: "Rem", ct: ct)
    write(s: "if (b == 0) plew_panic((PlewString){\"remainder by zero\", 17}); ")
    if sgn {
        write(s: "if (b == -1) return 0; ")
    }
    write(s: "return a % b; }\n")
    wNumPlain(c: inout c, p: p, name: "BitAnd", ct: ct, opc: " & ")
    wNumPlain(c: inout c, p: p, name: "BitOr", ct: ct, opc: " | ")
    wNumPlain(c: inout c, p: p, name: "BitXor", ct: ct, opc: " ^ ")
    wNumPlain(c: inout c, p: p, name: "Shl", ct: ct, opc: " << ")
    wNumPlain(c: inout c, p: p, name: "Shr", ct: ct, opc: " >> ")
    // comparison intrinsics return Bool (long long): Eq backs `==`, Lt backs
    // Ord.compare (which the `< <= > >=` desugar tag-tests via Ordering).
    write(s: "__attribute__((unused)) static long long plew_")
    write(s: p)
    write(s: "Eq(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b) { return a == b; }\n")
    write(s: "__attribute__((unused)) static long long plew_")
    write(s: p)
    write(s: "Lt(")
    write(s: ct)
    write(s: " a, ")
    write(s: ct)
    write(s: " b) { return a < b; }\n")
    write(s: "__attribute__((unused)) static ")
    write(s: ct)
    write(s: " plew_")
    write(s: p)
    write(s: "BitNot(")
    write(s: ct)
    write(s: " a) { return (")
    write(s: ct)
    write(s: ")(~a); }\n")
    if sgn {
        write(s: "__attribute__((unused)) static ")
        write(s: ct)
        write(s: " plew_")
        write(s: p)
        write(s: "Neg(")
        write(s: ct)
        write(s: " a) { ")
        write(s: ct)
        write(s: " r; if (__builtin_sub_overflow((")
        write(s: ct)
        write(s: ")0, a, &r)) plew_panic((PlewString){\"integer overflow\", 16}); return r; }\n")
    }
}

// Emit the full numeric intrinsic floor (all widths + Bool's `not`).
fn emitNumRuntime(c: inout Comp) {
    emitIntRuntime(c: inout c, p: "i8", ct: "int8_t", mn: "INT8_MIN", sgn: true)
    emitIntRuntime(c: inout c, p: "i16", ct: "int16_t", mn: "INT16_MIN", sgn: true)
    emitIntRuntime(c: inout c, p: "i32", ct: "int32_t", mn: "INT32_MIN", sgn: true)
    emitIntRuntime(c: inout c, p: "i64", ct: "int64_t", mn: "INT64_MIN", sgn: true)
    emitIntRuntime(c: inout c, p: "u8", ct: "unsigned char", mn: "", sgn: false)
    emitIntRuntime(c: inout c, p: "u16", ct: "uint16_t", mn: "", sgn: false)
    emitIntRuntime(c: inout c, p: "u32", ct: "uint32_t", mn: "", sgn: false)
    emitIntRuntime(c: inout c, p: "u64", ct: "uint64_t", mn: "", sgn: false)
    write(s: "__attribute__((unused)) static long long plew_boolNot(long long a) { return !a; }\n")
    write(s: "__attribute__((unused)) static long long plew_boolEq(long long a, long long b) { return a == b; }\n")
}

fn genCElem(c: inout Comp, start: U64, len: U64) {
    if len == 0 {
        write(s: "long long")
        return
    }
    // a type-parameter element (`Array[T]` in a generic instance) resolves to its
    // concrete argument's C type via the active env.
    mut val k: U64 = 0
    while k < c.curTypeParams.count {
        val p: Bind = c.curTypeParams[k]
        if spansEqual(c: inout c, aStart: p.nameStart, aLen: p.nameLen, bStart: start, bLen: len) {
            emitConcreteCType(c: inout c, ref: c.curTypeArgs[k])
            return
        }
        k += 1
    }
    // a compound array element (`Ref[I32]`, `Array[I32]`, `Box[I32]`) has a
    // mangled name span; recover its real C type from the stored ref.
    val er: U64 = arrayElemRef(c: inout c, start: start, len: len)
    if er != 0 {
        if isCompoundType(c: inout c, ref: er) {
            emitConcreteCType(c: inout c, ref: er)
            return
        }
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U8") {
        write(s: "unsigned char")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I8") {
        write(s: "int8_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I16") {
        write(s: "int16_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U16") {
        write(s: "uint16_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I32") {
        write(s: "int32_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U32") {
        write(s: "uint32_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "I64") {
        write(s: "int64_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "U64") {
        write(s: "uint64_t")
        return
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        write(s: "PlewString")
        return
    }
    if isPrimType(c: inout c, start: start, len: len) {
        // remaining prim = Bool
        write(s: "long long")
        return
    }
    writeSpan(c: inout c, start: start, len: len)
}

// Emit a C type for a (span, isArray) type. `Array[E]` -> `PlewArray_<E>`
// (the element name is C-identifier-safe, so it doubles as the mangle).
fn genCTypeRef(c: inout Comp, start: U64, len: U64, isArray: Bool) {
    if isArray {
        // wPA resolves a type-parameter element (`Array[T]` -> `PlewArray_I32`)
        // via the active env; in a non-generic context it is just `PlewArray_<elem>`.
        wPA(c: inout c, elemStart: start, elemLen: len)
        return
    }
    genCElem(c: inout c, start: start, len: len)
}

// Back-compat shim for non-array type positions (scalars / String / named).
fn genCType(c: inout Comp, start: U64, len: U64) {
    genCElem(c: inout c, start: start, len: len)
}

// Emit the C type for a recovered TypeInfo (used when the type comes from
// inference rather than a written annotation, e.g. a match-expression result).
fn genTypeInfoCType(c: inout Comp, ti: TypeInfo) {
    if ti.kind == 1 {
        write(s: "PlewString")
        return
    }
    if ti.kind == 2 {
        writeSpan(c: inout c, start: ti.nameStart, len: ti.nameLen)
        return
    }
    if ti.kind == 3 {
        wPA(c: inout c, elemStart: ti.nameStart, elemLen: ti.nameLen)
        return
    }
    write(s: "long long")
}

// Compare two source spans byte for byte.
fn spansEqual(c: inout Comp, aStart: U64, aLen: U64, bStart: U64, bLen: U64) -> Bool {
    if aLen != bLen {
        return false
    }
    mut val j: U64 = 0
    while j < aLen {
        if c.bytes[aStart + j] != c.bytes[bStart + j] {
            return false
        }
        j += 1
    }
    return true
}

// --- Phase C name interning ---------------------------------------------------
// Map each name span's CONTENT to a stable 1-based integer id, so name equality
// becomes integer == on precomputed ids instead of a byte-by-byte spansEqual.
// internBytes gives each declaration a distinct byte range, so the only correct
// key is content (FNV-1a 64-bit here); collisions fall back to spansEqual, so the
// hash only affects speed, not correctness. Backed by a hand-rolled
// open-addressing table (a Dictionary[String,U64] would force a String alloc per
// intern — there's no span→String slice — on this hot path).
fn internHash(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val h: U64 = 14695981039346656037U64
    mut val j: U64 = 0
    while j < len {
        h = h ^ (c.bytes[start + j] as U64)
        h = h.wrappingMul(by: 1099511628211U64)
        j += 1
    }
    return h
}

// Grow the bucket index (double, or 8 from empty), re-placing every interned span
// by re-hashing. The dense internStarts/internLens arrays are untouched (ids stay
// stable). Capacity is a power of two so the slot index is a bitmask (& cap-1).
fn internGrow(c: inout Comp) {
    mut val newCap: U64 = 8
    if c.internBuckets.count > 0 {
        newCap = c.internBuckets.count * 2
    }
    mut val nb: Array[U64] = []
    mut val k: U64 = 0
    while k < newCap {
        nb.append(value: 0)
        k += 1
    }
    mut val i: U64 = 0
    while i < c.internCount {
        val code: U64 = internHash(c: inout c, start: c.internStarts[i], len: c.internLens[i])
        mut val slot: U64 = code & (newCap - 1)
        while nb[slot] != 0 {
            slot = (slot + 1) & (newCap - 1)
        }
        nb.set(i: slot, value: i + 1)
        i += 1
    }
    c.internBuckets = nb
}

// Intern a name span to its stable 1-based id (equal content ⇒ equal id; 0 is
// never returned, so a `nameId` field's default 0 is a pure "unfilled" sentinel).
fn intern(c: inout Comp, start: U64, len: U64) -> U64 {
    if c.internBuckets.count == 0 {
        internGrow(c: inout c)
    } else {
        if (c.internCount + 1) * 4 > c.internBuckets.count * 3 {
            internGrow(c: inout c)
        }
    }
    val code: U64 = internHash(c: inout c, start: start, len: len)
    val cap: U64 = c.internBuckets.count
    mut val slot: U64 = code & (cap - 1)
    while true {
        val b: U64 = c.internBuckets[slot]
        if b == 0 {
            c.internStarts.append(value: start)
            c.internLens.append(value: len)
            c.internCount += 1
            c.internBuckets.set(i: slot, value: c.internCount)
            return c.internCount
        }
        if spansEqual(c: inout c, aStart: c.internStarts[b - 1], aLen: c.internLens[b - 1], bStart: start, bLen: len) {
            return b
        }
        slot = (slot + 1) & (cap - 1)
    }
}

// 1-based source line for a byte offset (count newlines before it). For
// diagnostics; works across the assembled multi-file buffer.
fn lineOf(c: inout Comp, offset: U64) -> I64 {
    mut val line: I64 = 1
    mut val i: U64 = 0
    while i < offset {
        if c.bytes[i] == 10 {
            line += 1
        }
        i += 1
    }
    return line
}

// Best-effort byte offset for an expression (for diagnostics). Leaf nodes with
// a span return it; compound nodes recurse to a representative child.
fn exprOffset(c: inout Comp, id: U64) -> U64 {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int(value: _, val offset, isBool: _, tyStart: _, tyLen: _, isNeg: _) => { return offset }
        Expr.Ident(val start, val len) => { return start }
        Expr.Str(val start, val len) => { return start }
        Expr.Call(val nameStart, val nameLen, val args) => { return nameStart }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => { return nameStart }
        Expr.Field(val base, val nameStart, val nameLen) => { return exprOffset(c: inout c, id: base) }
        Expr.Index(val base, val index) => { return exprOffset(c: inout c, id: base) }
        Expr.Binary(val op, val lhs, val rhs) => { return exprOffset(c: inout c, id: lhs) }
        Expr.Unary(val op, val operand) => { return exprOffset(c: inout c, id: operand) }
        Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => { return exprOffset(c: inout c, id: operand) }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => { return typeStart }
        Expr.MatchExpr(val scrut, val arms) => { return exprOffset(c: inout c, id: scrut) }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => { return exprOffset(c: inout c, id: cond) }
        Expr.Try(val expr) => { return exprOffset(c: inout c, id: expr) }
        Expr.Arrow(val base, val nameStart, val nameLen) => { return exprOffset(c: inout c, id: base) }
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => { return retStart }
        _ => { return 0 }
    }
}

