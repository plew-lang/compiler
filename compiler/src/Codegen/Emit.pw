// Part of the Plew compiler module (root: _.pw). Shared codegen utilities used
// across the frontend and the LLVM backend: integer/number formatting, string
// interning, span equality, type predicates (primitive / integer width+sign,
// lossless-conversion / literal-fits checks), array element-type lookup, and
// source line/offset tracking.

fn digitStr(d: I64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// U64 digit (0-9) -> its glyph. A U64 twin of digitStr: with no implicit
// conversions and `as` restricted to lossless, an I64 digitStr cannot serve a
// U64 caller (U64->I64 is not lossless), so unsigned printing needs its own.
fn digitStrU(d: U64) -> String {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// Compiler diagnostics. Ordinary module functions (not ambient builtins) so the
// compiler source stays spec-valid: they report on stderr via @Std/Io `eprint`
// and stop via @Std/Process `exit`. `compileErrorAt` includes a source line.
fn eprintInt(n: I64) {
    if n >= 10 {
        eprintInt(n: n / 10)
    }
    eprint(text: digitStr(d: n % 10))
}

fn compileErrorAt(line: I64, msg: String) {
    eprint(text: "plewc: error: line ")
    eprintInt(n: line)
    eprint(text: ": ")
    eprint(text: msg)
    eprint(text: "\n")
    exit(code: 1)
}

fn isPrimType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U64") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "Bool") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "F32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "F64") { return true }
    return false
}

// Whether a type-name span names a float type (F32 / F64).
fn isFloatType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "F32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "F64") { return true }
    return false
}

// Whether a type-name span is one of the 8 integer types (excludes Bool/String).
fn isIntType(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I64") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U8") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U16") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U32") { return true }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U64") { return true }
    return false
}

// Bit width of an integer type-name span (0 if not an integer type).
fn intBits(c: inout Comp, start: U64, len: U64) -> U64 {
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I8") { return 8 }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U8") { return 8 }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I16") { return 16 }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U16") { return 16 }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "I32") { return 32 }
    if rangeEquals(bytes: c.arena.bytes, start: start, len: len, kw: "U32") { return 32 }
    return 64
}

// Whether an integer type-name span is signed (`I*`). Assumes isIntType.
fn intSigned(c: inout Comp, start: U64, len: U64) -> Bool {
    return c.arena.bytes[start] == 'I'
}

// Whether `src as dst` (both integer types) is lossless — i.e. dst represents
// every src value (spec: `as` is lossless-only; narrowing/signedness -> TryFrom).
fn losslessInt(c: inout Comp, srcStart: U64, srcLen: U64, dstStart: U64, dstLen: U64) -> Bool {
    val sBits: U64 = intBits(c: inout c, start: srcStart, len: srcLen)
    val dBits: U64 = intBits(c: inout c, start: dstStart, len: dstLen)
    val sSigned: Bool = intSigned(c: inout c, start: srcStart, len: srcLen)
    val dSigned: Bool = intSigned(c: inout c, start: dstStart, len: dstLen)
    if sSigned {
        if dSigned {
            return dBits >= sBits
        }
        // signed -> unsigned: negatives are unrepresentable.
        return false
    }
    if dSigned {
        // unsigned -> signed needs a strictly wider target (the sign bit).
        return dBits > sBits
    }
    return dBits >= sBits
}

// Whether the literal (magnitude `value`, negated if `neg`) fits the target
// integer type's range.
fn litFitsType(c: inout Comp, value: U64, neg: Bool, dstStart: U64, dstLen: U64) -> Bool {
    val bits: U64 = intBits(c: inout c, start: dstStart, len: dstLen)
    val sgn: Bool = intSigned(c: inout c, start: dstStart, len: dstLen)
    return litFitsBits(value: value, neg: neg, bits: bits, sgn: sgn)
}

// Whether the literal (non-negative magnitude `value`, negated when `neg`) fits
// an integer type of the given width and signedness. Span-free core of
// litFitsType, so synthetic contexts (index = U64, print = I64) can range-check
// literals without a type-name span. The 64-bit signed-negative bound (2^63) is
// expressed via `value - 1 <= 2^63-1` so no 2^63 literal is needed.
fn litFitsBits(value: U64, neg: Bool, bits: U64, sgn: Bool) -> Bool {
    if neg {
        // a negative literal needs a signed target; magnitude <= 2^(bits-1).
        if !(sgn) {
            return false
        }
        if bits == 8 { return value <= 128 }
        if bits == 16 { return value <= 32768 }
        if bits == 32 { return value <= 2147483648 }
        if value == 0 { return true }
        return (value - 1) <= 9223372036854775807U64
    }
    if sgn {
        if bits == 8 { return value <= 127 }
        if bits == 16 { return value <= 32767 }
        if bits == 32 { return value <= 2147483647 }
        return value <= 9223372036854775807U64
    }
    if bits == 8 { return value <= 255 }
    if bits == 16 { return value <= 65535 }
    if bits == 32 { return value <= 4294967295 }
    return true
}

// Emit the C *element* type for a type-name span (no Array wrapper). Each Plew
// integer type maps to its exact-width C stdint type so storage width and
// signedness match the declared type (no hidden widening); U8 -> unsigned char
// (== uint8_t, keeps byte arrays aliasing a char buffer for String.bytes);
// Bool -> long long (width irrelevant); String -> PlewString; named -> echoed.
// The element ref recorded for the array-element name span (start,len), or 0 if
// it is not a recorded element (genCElem falls back to the name path then).
fn arrayElemRef(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val i: U64 = 0
    while i < c.monoWork.arrayElems.count {
        val ae: Bind = c.monoWork.arrayElems[i]
        if spansEqual(c: inout c, aStart: ae.nameStart, aLen: ae.nameLen, bStart: start, bLen: len) {
            return ae.fieldStart
        }
        i += 1
    }
    return 0
}

// The registered array-element name span for a given element ref (head name for
// a simple element, the mangled name for a compound one). Falls back to the
// type's head name. Used to recover a nested array's element name in exprType.
fn arrayElemNameForRef(c: inout Comp, elemRef: U64) -> Bind {
    mut val i: U64 = 0
    while i < c.monoWork.arrayElems.count {
        val ae: Bind = c.monoWork.arrayElems[i]
        // match by mangle (type refs are not interned, so the same type can have
        // a different index than the one stored at registration). Skip a non-ground
        // (template) entry like `Array[T]`'s element `T`: sameMangle resolves through
        // the active type-param env, so under an `impl[T] Array[T]` method's env
        // (T -> the concrete element) a stored `T` would spuriously match the
        // concrete lookup ref and return the template name (`Array_T_get`). Only a
        // ground stored element is a real match; the fallback below covers the rest.
        if ae.fieldStart != 0 {
            if tyRefIsGround(c: inout c, ref: ae.fieldStart) {
                if sameMangle(c: inout c, refA: ae.fieldStart, refB: elemRef) {
                    return <Bind nameStart=ae.nameStart nameLen=ae.nameLen fieldStart=elemRef fieldLen=0 />
                }
            }
        }
        i += 1
    }
    if elemRef < c.arena.types.count {
        val t: TypeRef = c.arena.types[elemRef]
        return <Bind nameStart=t.nameStart nameLen=t.nameLen fieldStart=elemRef fieldLen=0 />
    }
    return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
}

// --- numeric intrinsic runtime (O6) ---------------------------------------
// The C floor under the operator-trait witnesses: Core's `impl I32 as Add[I32]`
// etc. call intrinsics (`i32Add`), which lower to these `plew_*` functions. Per
// width and signedness: add/sub/mul are overflow-checked, div/rem zero-checked
// (+ signed INT_MIN/-1 / x%-1==0), bitwise/shift unchecked, bitnot truncates,
// neg checked (signed only). clang inlines them, so routing every `+` through a
// witness call is free at -O (spec/12: primitives are not special-cased — the
// operator desugars to a witness uniformly, the cost is hidden in the floor).

// Compare two source spans byte for byte.
fn spansEqual(c: inout Comp, aStart: U64, aLen: U64, bStart: U64, bLen: U64) -> Bool {
    if aLen != bLen {
        return false
    }
    mut val j: U64 = 0
    while j < aLen {
        if c.arena.bytes[aStart + j] != c.arena.bytes[bStart + j] {
            return false
        }
        j += 1
    }
    return true
}

// --- Phase C name interning ---------------------------------------------------
// Map each name span's CONTENT to a stable 1-based integer id, so name equality
// becomes integer == on precomputed ids instead of a byte-by-byte spansEqual.
// internBytes gives each declaration a distinct byte range, so the only correct
// key is content (FNV-1a 64-bit here); collisions fall back to spansEqual, so the
// hash only affects speed, not correctness. Backed by a hand-rolled
// open-addressing table (a Dictionary[String,U64] would force a String alloc per
// intern — there's no span→String slice — on this hot path).
fn internHash(c: inout Comp, start: U64, len: U64) -> U64 {
    mut val h: U64 = 14695981039346656037U64
    mut val j: U64 = 0
    while j < len {
        h = h ^ (c.arena.bytes[start + j] as U64)
        h = h.wrappingMul(by: 1099511628211U64)
        j += 1
    }
    return h
}

// Grow the bucket index (double, or 8 from empty), re-placing every interned span
// by re-hashing. The dense interner.starts/lens arrays are untouched (ids stay
// stable). Capacity is a power of two so the slot index is a bitmask (& cap-1).
fn internGrow(c: inout Comp) {
    mut val newCap: U64 = 8
    if c.interner.buckets.count > 0 {
        newCap = c.interner.buckets.count * 2
    }
    mut val nb: Array[U64] = []
    mut val k: U64 = 0
    while k < newCap {
        nb.append(value: 0)
        k += 1
    }
    mut val i: U64 = 0
    while i < c.interner.count {
        val code: U64 = internHash(c: inout c, start: c.interner.starts[i], len: c.interner.lens[i])
        mut val slot: U64 = code & (newCap - 1)
        while nb[slot] != 0 {
            slot = (slot + 1) & (newCap - 1)
        }
        nb.set(i: slot, value: i + 1)
        i += 1
    }
    c.interner.buckets = nb
}

// Intern a name span to its stable 1-based id (equal content ⇒ equal id; 0 is
// never returned, so a `nameId` field's default 0 is a pure "unfilled" sentinel).
// If (start, len) names a `newtype` (spec/10), its underlying type's TypeRef; else 0.
// Codegen resolves a newtype to its underlying for representation / method dispatch.
fn newtypeUnderRef(c: inout Comp, start: U64, len: U64) -> U64 {
    if c.arena.newtypes.count == 0U64 {
        return 0U64
    }
    val nid: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.arena.newtypes.count {
        if c.arena.newtypes[i].nameId == nid {
            return c.arena.newtypes[i].underRef
        }
        i += 1
    }
    return 0U64
}

// The underlying type's head-name span for a `newtype` named (start, len), or the
// input span unchanged when it is not a newtype.
fn newtypeUnderName(c: inout Comp, start: U64, len: U64) -> Bind {
    if c.arena.newtypes.count != 0U64 {
        val nid: U64 = intern(c: inout c, start: start, len: len)
        mut val i: U64 = 0
        while i < c.arena.newtypes.count {
            if c.arena.newtypes[i].nameId == nid {
                return <Bind nameStart=c.arena.newtypes[i].underStart nameLen=c.arena.newtypes[i].underLen fieldStart=0 fieldLen=0 />
            }
            i += 1
        }
    }
    return <Bind nameStart=start nameLen=len fieldStart=0 fieldLen=0 />
}

fn intern(c: inout Comp, start: U64, len: U64) -> U64 {
    if c.interner.buckets.count == 0 {
        internGrow(c: inout c)
    } else {
        if (c.interner.count + 1) * 4 > c.interner.buckets.count * 3 {
            internGrow(c: inout c)
        }
    }
    val code: U64 = internHash(c: inout c, start: start, len: len)
    val cap: U64 = c.interner.buckets.count
    mut val slot: U64 = code & (cap - 1)
    while true {
        val b: U64 = c.interner.buckets[slot]
        if b == 0 {
            c.interner.starts.append(value: start)
            c.interner.lens.append(value: len)
            c.interner.count += 1
            c.interner.buckets.set(i: slot, value: c.interner.count)
            return c.interner.count
        }
        if spansEqual(c: inout c, aStart: c.interner.starts[b - 1], aLen: c.interner.lens[b - 1], bStart: start, bLen: len) {
            return b
        }
        slot = (slot + 1) & (cap - 1)
    }
}

// 1-based source line for a byte offset (count newlines before it). For
// diagnostics; works across the assembled multi-file buffer.
fn lineOf(c: inout Comp, offset: U64) -> I64 {
    mut val line: I64 = 1
    mut val i: U64 = 0
    while i < offset {
        if c.arena.bytes[i] == 10 {
            line += 1
        }
        i += 1
    }
    return line
}

// Best-effort byte offset for an expression (for diagnostics). Leaf nodes with
// a span return it; compound nodes recurse to a representative child.
fn exprOffset(c: inout Comp, id: U64) -> U64 {
    val e: Expr = c.arena.exprs[id]
    match e {
        Expr.Int(value: _, val offset, isBool: _, tyStart: _, tyLen: _, isNeg: _) => { return offset }
        Expr.Ident(val start, val len) => { return start }
        Expr.Str(val start, val len) => { return start }
        Expr.Call(val nameStart, val nameLen, val args) => { return nameStart }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => { return nameStart }
        Expr.ExtMethod(val recv, srcStart: _, srcLen: _, val nameStart, nameLen: _, args: _) => { return nameStart }
        Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => { return exprOffset(c: inout c, id: recv) }
        Expr.Field(val base, val nameStart, val nameLen) => { return exprOffset(c: inout c, id: base) }
        Expr.Index(val base, val index) => { return exprOffset(c: inout c, id: base) }
        Expr.Binary(val op, val lhs, val rhs) => { return exprOffset(c: inout c, id: lhs) }
        Expr.Unary(val op, val operand) => { return exprOffset(c: inout c, id: operand) }
        Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => { return exprOffset(c: inout c, id: operand) }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => { return typeStart }
        Expr.MatchExpr(val scrut, val arms) => { return exprOffset(c: inout c, id: scrut) }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => { return exprOffset(c: inout c, id: cond) }
        Expr.OptChain(val base, memberStart: _, memberLen: _) => { return exprOffset(c: inout c, id: base) }
        Expr.Try(val expr) => { return exprOffset(c: inout c, id: expr) }
        Expr.Arrow(val base, val nameStart, val nameLen) => { return exprOffset(c: inout c, id: base) }
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => { return retStart }
        _ => { return 0 }
    }
}

