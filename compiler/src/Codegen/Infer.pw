// The TypeRef-based type checker (approach B). A clean type layer over the existing,
// already-debugged resolution (overload / trait / generic). It represents a type as a
// `Comp.types` index (a TypeRef carrying head name + generic args), with 0 meaning
// "unknown" — distinct from any concrete type, so the int/Bool/unknown conflation of
// the kind-based TypeInfo is gone. Developed in LOG mode (`plewc --tc-log`): it prints
// every mismatch it finds instead of rejecting, so coverage can be grown and triaged
// against self-compile without breaking the build. Once accurate it flips to rejecting
// and subsumes the ad-hoc category checks.

// The precise type of an expression as a TypeRef index, or 0 (unknown) when the type
// cannot be recovered. Built over the existing recovery (`typeOf`): a structured type
// keeps its ref (generic instances `Optional[I64]` compare with their args); a named /
// primitive / String / Bool yields a simple TypeRef by name (so Bool != I32); an
// untyped literal or unrecovered form is honestly unknown (0), never defaulted to int.
fn inferType(c: inout Comp, id: U64) -> U64 {
    // an un-suffixed integer literal has no intrinsic type — it adapts to its context
    // (`u64var + 5`, `val x: I32 = 5`). typeOf may attach an emission-context width to
    // it, but for type CHECKING it is genuinely unknown, so report 0 (a typed literal
    // `5I64` keeps its suffix type; `true`/`false` fall through to Bool).
    match c.exprs[id] {
        Expr.Int(value: _, offset: _, val isBool, tyStart: _, val tyLen, isNeg: _) => {
            if isBool {
            } else {
                if tyLen == 0U64 {
                    return 0U64
                }
            }
        }
        _ => {}
    }
    val ti: TypeInfo = typeOf(c: inout c, id: id)
    if ti.ref != 0U64 {
        return ti.ref
    }
    if ti.nameLen == 0U64 {
        return 0U64
    }
    // arrays (kind 3): conservative for now — their element comparison is deferred.
    if ti.kind == 3 {
        return 0U64
    }
    return simpleTypeRef(c: inout c, nameStart: ti.nameStart, nameLen: ti.nameLen)
}

// Whether a value of type `inferred` is acceptable where `expected` is required.
// Conservative: returns true (compatible / don't-judge) unless it finds a DEFINITE
// mismatch, so it never false-rejects on an unrecovered or not-yet-modeled form.
// Definite mismatches: two different known head types (Bool vs I32, String vs A, A vs
// B, Optional vs Result), or the same generic head with an incompatible type argument
// (Optional[I64] vs Optional[String]). Exemptions: unknown (0) on either side; an
// existential `any P` target (a concrete value coerces into it); `extern(c)` opaque
// FFI handles (all void*, knownNamedTypeId yields 0 for them).
// Whether (start,len) names a CONCRETE type (a recognized primitive / String / Bool
// or a known struct/enum/newtype) — as opposed to an opaque type-parameter name. Used
// by the generic-body abstract check to tell `T` vs `I64` (reject) from `T` vs another
// generic's parameter `U` (lenient — they unify at instantiation).
fn isConcreteTypeName(c: inout Comp, start: U64, len: U64) -> Bool {
    if isPrimType(c: inout c, start: start, len: len) {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        return true
    }
    if knownNamedTypeId(c: inout c, start: start, len: len) != 0U64 {
        return true
    }
    return false
}

fn typesCompatible(c: inout Comp, expected: U64, inferred: U64) -> Bool {
    if expected == 0U64 || inferred == 0U64 {
        return true
    }
    if expected >= c.types.count || inferred >= c.types.count {
        return true
    }
    // ground the expected type through any active generic env (a `-> T` return / `T`
    // param resolves to the concrete instantiation argument); inferred is grounded.
    val exp: U64 = groundTypeRef(c: inout c, ref: expected)
    if exp >= c.types.count {
        return true
    }
    val te: TypeRef = c.types[exp]
    val tin: TypeRef = c.types[inferred]
    if te.isAny || tin.isAny {
        // a CONCRETE value coercing INTO `any P` must conform to P (spec/08) — else its
        // existential box has no vtable entry and a member call null-dereferences at
        // runtime. Check the conformance table when the source is a known concrete
        // struct/enum; a generic param (id 0, conforms via its `where` bound) or an
        // existing `any` source is left to the conservative pass-through.
        if te.isAny {
            if tin.isAny {
            } else {
                val srcId: U64 = knownNamedTypeId(c: inout c, start: tin.nameStart, len: tin.nameLen)
                if srcId != 0U64 {
                    val traitId: U64 = intern(c: inout c, start: te.nameStart, len: te.nameLen)
                    if conformExists(c: inout c, typeId: srcId, traitId: traitId) {
                    } else {
                        return false
                    }
                }
            }
        }
        return true
    }
    // float-to-float is exempt: F32 is currently lowered as F64 (true F32 deferred), so
    // an F64 value flowing into an F32 position is not a real mismatch yet, and a float
    // literal recovered as F64 may meet a float local reporting otherwise. But a float
    // paired with a NON-float (`val x: F64 = nI64`) IS a real mismatch — no implicit
    // int↔float conversion (spec/12) — so only exempt when BOTH sides are float. (An
    // untyped int LITERAL flowing into a float context is polymorphic and passes via the
    // unknown-id path below, not here.)
    val eFloat: Bool = isFloatType(c: inout c, start: te.nameStart, len: te.nameLen)
    val iFloat: Bool = isFloatType(c: inout c, start: tin.nameStart, len: tin.nameLen)
    if eFloat && iFloat {
        return true
    }
    if eFloat || iFloat {
        // one side float, the other not: a mismatch UNLESS the non-float side is an
        // untyped/unknown type (a bare int literal — polymorphic, handled below).
        if eFloat {
            if knownNamedTypeId(c: inout c, start: tin.nameStart, len: tin.nameLen) == 0U64 {
                return true
            }
        } else {
            if knownNamedTypeId(c: inout c, start: te.nameStart, len: te.nameLen) == 0U64 {
                return true
            }
        }
        return false
    }
    // generic-body abstract check (spec/06): a type parameter of the function being
    // checked (`c.curCheckFn`) is an opaque DISTINCT type — incompatible with a
    // CONCRETE type or a DIFFERENT parameter of the same function, but lenient against
    // an unknown / another generic's type parameter (which unifies at instantiation,
    // e.g. passing this fn's `T` to `f[U](x: U)`). Active only while checking a generic
    // template body (curCheckFn valid); elsewhere isTypeParamOf is false.
    val eTp: Bool = isTypeParamOf(c: inout c, fnIdx: c.curCheckFn, start: te.nameStart, len: te.nameLen)
    val iTp: Bool = isTypeParamOf(c: inout c, fnIdx: c.curCheckFn, start: tin.nameStart, len: tin.nameLen)
    if eTp {
        if iTp {
            // both are this function's parameters: compatible iff the SAME one.
            return spansEqual(c: inout c, aStart: te.nameStart, aLen: te.nameLen, bStart: tin.nameStart, bLen: tin.nameLen)
        }
        // T vs a CONCRETE type -> incompatible; T vs unknown / another param -> lenient.
        if isConcreteTypeName(c: inout c, start: tin.nameStart, len: tin.nameLen) {
            return false
        }
        return true
    }
    if iTp {
        if isConcreteTypeName(c: inout c, start: te.nameStart, len: te.nameLen) {
            return false
        }
        return true
    }
    val eId: U64 = knownNamedTypeId(c: inout c, start: te.nameStart, len: te.nameLen)
    val iId: U64 = knownNamedTypeId(c: inout c, start: tin.nameStart, len: tin.nameLen)
    if eId == 0U64 || iId == 0U64 {
        return true
    }
    if eId != iId {
        return false
    }
    // same head: a generic head must agree on its type arguments.
    if te.args.count == tin.args.count {
        mut val i: U64 = 0
        while i < te.args.count {
            if typesCompatible(c: inout c, expected: te.args[i], inferred: tin.args[i]) {
            } else {
                return false
            }
            i += 1
        }
    }
    return true
}

// Check that `valueExpr`'s inferred type is compatible with `expectedRef` at a typed
// position (a binding annotation, a return, a call argument, …). On a DEFINITE
// mismatch it rejects (spec/12: no implicit conversion) — unless `--tc-log` is set,
// where it instead prints a `TC` diagnostic and continues, so a NEW check position can
// be developed/triaged against self-compile before it goes live.
// Whether `id` is a call to a user function/method that returns no value (`()`),
// so its "result" can't be used where a value is expected (spec/04).
fn exprIsVoidCall(c: inout Comp, id: U64) -> Bool {
    match c.exprs[id] {
        Expr.Call(val nameStart, val nameLen, val args) => {
            val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
            if fi < c.funcs.count {
                return !c.funcs[fi].hasRet
            }
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            val rt: TypeInfo = exprType(c: inout c, id: recv)
            if rt.kind == 2 {
                val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if mi != c.funcs.count {
                    return !c.funcs[mi].hasRet
                }
            }
        }
        _ => {}
    }
    return false
}

fn tcCheckValue(c: inout Comp, expectedRef: U64, valueExpr: U64, pos: String) {
    if expectedRef == 0U64 {
        return
    }
    // a function VALUE (closure literal / function reference) flowing into a fn-typed
    // position must match the signature, everywhere tcCheckValue runs (binding, return,
    // arg, struct field, array element). isFnType-gated, so a no-op otherwise.
    checkFnValueSig(c: inout c, declTy: expectedRef, init: valueExpr)
    // a void function's result is `()` — using it where a typed value is expected
    // (`val x: I64 = doNothing()`) is a type error (spec/04).
    if exprIsVoidCall(c: inout c, id: valueExpr) {
        if c.tcLog {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: valueExpr)), msg: "cannot use the result of a function that returns no value (spec/04)")
        }
        return
    }
    // a generic construction in a typed position (`val o: Optional[I64] = <Optional.Some
    // v="x"/>`): recurse into its fields, grounding each declared field type under the
    // EXPECTED instance's type arguments, and check the field value. This is the
    // generic-payload case the head-name checks can't see (the un-annotated construction
    // carries no type args itself; they come from the expected type).
    tcCheckMakeFields(c: inout c, expectedRef: expectedRef, makeId: valueExpr)
    // a value-position if/match (`val x: I64 = if c { give A } else { give B }`): each
    // branch's give value must match the expected type — so a divergent branch (`give
    // "s"` where I64 is wanted) is caught even when another branch matches.
    match c.exprs[valueExpr] {
        Expr.IfExpr(cond: _, val thenBlk, val elseBlk) => {
            val tv: U64 = tcBlockGiveValue(c: inout c, blockId: thenBlk)
            if tv != 0U64 {
                tcCheckValue(c: inout c, expectedRef: expectedRef, valueExpr: tv, pos: "if-branch")
            }
            val ev: U64 = tcBlockGiveValue(c: inout c, blockId: elseBlk)
            if ev != 0U64 {
                tcCheckValue(c: inout c, expectedRef: expectedRef, valueExpr: ev, pos: "if-branch")
            }
        }
        Expr.MatchExpr(scrut: _, val arms) => {
            mut val ai: U64 = 0
            while ai < arms.count {
                // skip an arm that binds payload fields: its binds are not in scope at
                // this (the match-expr) position and may shadow an outer name, so
                // inferType on the arm body would resolve the shadowed name wrongly.
                if arms[ai].binds.count == 0U64 {
                    tcCheckValue(c: inout c, expectedRef: expectedRef, valueExpr: arms[ai].body, pos: "match-branch")
                }
                ai += 1
            }
        }
        Expr.Array(val elems) => {
            // an array literal in a typed position (`Array[I64] = [1I64, true]`,
            // nested `Array[Array[I64]] = [[1I64], [true]]`): each element must match
            // the expected element type. Recurses, so arbitrary nesting is covered —
            // inferType doesn't precisely type a literal's element, so this is the
            // element check. (Only when the expected type is a known `Array[E]`.)
            if expectedRef < c.types.count {
                val et: TypeRef = c.types[expectedRef]
                if rangeEquals(bytes: c.bytes, start: et.nameStart, len: et.nameLen, kw: "Array") {
                    if et.args.count > 0U64 {
                        mut val ei: U64 = 0
                        while ei < elems.count {
                            tcCheckValue(c: inout c, expectedRef: et.args[0], valueExpr: elems[ei], pos: "element")
                            ei += 1
                        }
                    }
                }
            }
        }
        _ => {}
    }
    val inferred: U64 = inferType(c: inout c, id: valueExpr)
    if typesCompatible(c: inout c, expected: expectedRef, inferred: inferred) {
        return
    }
    if c.tcLog {
        eprint(text: "TC ")
        eprint(text: pos)
        eprint(text: " expected=")
        eprint(text: tcRefName(c: inout c, ref: groundTypeRef(c: inout c, ref: expectedRef)))
        eprint(text: " got=")
        eprint(text: tcRefName(c: inout c, ref: inferred))
        eprint(text: " from=")
        eprint(text: tcExprKind(c: inout c, id: valueExpr))
        eprint(text: " line=")
        eprintInt(n: lineOf(c: inout c, offset: exprOffset(c: inout c, id: valueExpr)))
        eprint(text: "\n")
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: valueExpr)), msg: "type mismatch: this value's type does not match the type required here (Plew has no implicit conversion — spec/12)")
    }
}

// Check an arithmetic binary's operands have the same type. Gated on the op being
// arithmetic (Add/Sub/Mul/Div/Rem) AND both operands being primitive integer types:
// a user type's `a + b` desugars to `Add[Rhs]` (the operands may legitimately differ),
// but a primitive only has same-type witnesses (`impl I32 as Add[I32]`), so two
// different primitive int operands (`3I32 + 5I64`) are a no-implicit-conversion error.
fn tcCheckBinop(c: inout Comp, op: I64, lhs: U64, rhs: U64) {
    // `&&` / `||` are short-circuit control flow (spec/12), not a trait op: both
    // operands must be Bool (`1I64 && true` has no truthiness coercion).
    if op == opAnd() || op == opOr() {
        val bs: Bind = kwSpan(c: inout c, kw: "Bool", kwLen: 4U64)
        if bs.nameLen != 0U64 {
            val boolRef: U64 = simpleTypeRef(c: inout c, nameStart: bs.nameStart, nameLen: bs.nameLen)
            tcCheckValue(c: inout c, expectedRef: boolRef, valueExpr: lhs, pos: "logical")
            tcCheckValue(c: inout c, expectedRef: boolRef, valueExpr: rhs, pos: "logical")
        }
        return
    }
    // arithmetic (Add/Sub/Mul/Div/Rem) and comparison (Eq/Ne/Lt/Le/Gt/Ge).
    mut val isCompare: Bool = false
    if op == opEq() || op == opNe() || op == opLt() || op == opLe() || op == opGt() || op == opGe() {
        isCompare = true
    }
    mut val handled: Bool = isCompare
    if op == opAdd() || op == opSub() || op == opMul() || op == opDiv() || op == opRem() {
        handled = true
    }
    // bitwise/shift: a primitive's witnesses are all same-type (`impl I8 as Shl[I8]`,
    // not `Shl[U64]`), so mixed primitive operands have no witness — same as arith.
    if op == opBitAnd() || op == opBitOr() || op == opBitXor() || op == opShl() || op == opShr() {
        handled = true
    }
    if handled {
    } else {
        return
    }
    val l: U64 = inferType(c: inout c, id: lhs)
    val r: U64 = inferType(c: inout c, id: rhs)
    if l == 0U64 || r == 0U64 {
        return
    }
    if l >= c.types.count || r >= c.types.count {
        return
    }
    // comparison is `Eq`/`Ord` on the SAME type (no Rhs), so the operands must match
    // for EVERY type (`"a" == 1I64`, `aI32 < bI64`) — not just primitives.
    if isCompare {
        tcCheckValue(c: inout c, expectedRef: l, valueExpr: rhs, pos: "compare")
        return
    }
    // a PRIMITIVE numeric LHS forces the RHS to be the SAME type — a primitive's
    // operator witnesses are all same-type (`impl I32 as Add[I32]`, `Ord` on Self,
    // `Shl[I32]`), and `a OP b` always dispatches on the LHS type. So the RHS must
    // match `l` whether it is another primitive (`3I32 + 5I64`), a non-numeric
    // primitive (`1I64 + true`), or any other type — there is no `Add[Bool]` /
    // `Add[Money]` on a primitive int. typesCompatible carries the F32/F64 leniency
    // and the int↔float rejection. A non-numeric LHS (a user type whose `Add[Rhs]`
    // may legitimately differ) is excluded here — its witness is checked elsewhere.
    val lNum: Bool = isIntType(c: inout c, start: c.types[l].nameStart, len: c.types[l].nameLen) || isFloatType(c: inout c, start: c.types[l].nameStart, len: c.types[l].nameLen)
    if lNum {
        tcCheckValue(c: inout c, expectedRef: l, valueExpr: rhs, pos: "binop")
    }
}

// Whether a TypeRef is an unsigned primitive integer (U8..U64).
fn tcIsUnsignedInt(c: inout Comp, ref: U64) -> Bool {
    if ref == 0U64 || ref >= c.types.count {
        return false
    }
    val t: TypeRef = c.types[ref]
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "U8") { return true }
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "U16") { return true }
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "U32") { return true }
    if rangeEquals(bytes: c.bytes, start: t.nameStart, len: t.nameLen, kw: "U64") { return true }
    return false
}

// Log (under --tc-log) or reject a unary-operator-applicability error.
fn tcUnaryReject(c: inout Comp, operand: U64, msg: String) {
    if c.tcLog {
        eprint(text: "TC unary ")
        eprint(text: msg)
        eprint(text: " got=")
        eprint(text: tcRefName(c: inout c, ref: inferType(c: inout c, id: operand)))
        eprint(text: " line=")
        eprintInt(n: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)))
        eprint(text: "\n")
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: msg)
    }
}

// Operator-applicability for the unary operators (spec/12), PRIMITIVE operands only —
// a user type may implement Neg/Not/BitNot, so a non-primitive operand is never judged:
//   `-` (Neg): signed integers / floats only (no Neg witness for unsigned or Bool);
//   `!` (Not): Bool only; `~` (BitNot): integers only.
fn tcCheckUnary(c: inout Comp, op: I64, operand: U64) {
    val t: U64 = inferType(c: inout c, id: operand)
    if t == 0U64 || t >= c.types.count {
        return
    }
    val tn: TypeRef = c.types[t]
    val isInt: Bool = isIntType(c: inout c, start: tn.nameStart, len: tn.nameLen)
    val isBool: Bool = rangeEquals(bytes: c.bytes, start: tn.nameStart, len: tn.nameLen, kw: "Bool")
    val isFloat: Bool = isFloatType(c: inout c, start: tn.nameStart, len: tn.nameLen)
    // String is a primitive with NO Neg/Not/BitNot witness, so judge it too (`-s`
    // falls to each branch's reject). only judge a primitive operand (int / Bool /
    // float / String); skip user types (which may implement Neg/Not/BitNot).
    val isString: Bool = rangeEquals(bytes: c.bytes, start: tn.nameStart, len: tn.nameLen, kw: "String")
    if isInt || isBool || isFloat || isString {
    } else {
        return
    }
    if op == opSub() {
        if isFloat {
        } else {
            if isInt && !tcIsUnsignedInt(c: inout c, ref: t) {
            } else {
                tcUnaryReject(c: inout c, operand: operand, msg: "unary `-` (Neg) is for signed integers / floats only (spec/12)")
            }
        }
    } else {
        if op == opNot() {
            if isBool {
            } else {
                tcUnaryReject(c: inout c, operand: operand, msg: "unary `!` (Not) requires a Bool operand (spec/12)")
            }
        } else {
            if op == opBitNot() {
                if isInt {
                } else {
                    tcUnaryReject(c: inout c, operand: operand, msg: "unary `~` (BitNot) requires an integer operand (spec/12)")
                }
            }
        }
    }
}

// Whether a TypeRef is a primitive integer type.
fn tcIsPrimInt(c: inout Comp, ref: U64) -> Bool {
    if ref == 0U64 || ref >= c.types.count {
        return false
    }
    return isIntType(c: inout c, start: c.types[ref].nameStart, len: c.types[ref].nameLen)
}

// A compound-arith assignment `x OP= y` desugars to `x = x OP y` (spec/12), so for a
// primitive its operands must share a type (`x: I64; x += 5I32` has no Add[I32] on
// I64). Gated on the op being arithmetic (`+= -= *= /= %=`) and BOTH sides primitive
// ints (a user type uses Add[Rhs]; shift/bitwise compounds are Rhs-parameterized).
fn tcCheckCompoundAssign(c: inout Comp, op: I64, target: U64, value: U64) {
    if op == opAddAssign() || op == opSubAssign() || op == opMulAssign() || op == opDivAssign() || op == opRemAssign() {
    } else {
        return
    }
    val l: U64 = inferType(c: inout c, id: target)
    if l == 0U64 || l >= c.types.count {
        return
    }
    // a primitive numeric target forces the value to match (same as the binop it
    // desugars to: `x: I64; x += true` / `x += "a"` has no `Add[Bool]`/`Add[String]`
    // on I64). A user-type target uses `Add[Rhs]` and is checked by its own witness.
    if isIntType(c: inout c, start: c.types[l].nameStart, len: c.types[l].nameLen) || isFloatType(c: inout c, start: c.types[l].nameStart, len: c.types[l].nameLen) {
        tcCheckValue(c: inout c, expectedRef: l, valueExpr: value, pos: "compound")
    }
}

// A subscript `base[i]`: an array indexes with a `U64` (spec/02); a `Dictionary[K, V]`
// indexes with its key type `K` (the `dict[k]` -> `.at(key: k)` desugar is a generic
// method, which the arg check skips, so the key type is checked here directly).
fn tcCheckArrayIndex(c: inout Comp, base: U64, index: U64) {
    val bt: TypeInfo = typeOf(c: inout c, id: base)
    if bt.kind == 3 {
        val u64: Bind = kwSpan(c: inout c, kw: "U64", kwLen: 3U64)
        if u64.nameLen == 0U64 {
            return
        }
        tcCheckValue(c: inout c, expectedRef: simpleTypeRef(c: inout c, nameStart: u64.nameStart, nameLen: u64.nameLen), valueExpr: index, pos: "index")
        return
    }
    val br: U64 = inferType(c: inout c, id: base)
    if br != 0U64 {
        if br < c.types.count {
            val bref: TypeRef = c.types[br]
            if rangeEquals(bytes: c.bytes, start: bref.nameStart, len: bref.nameLen, kw: "Dictionary") {
                if bref.args.count >= 1U64 {
                    tcCheckValue(c: inout c, expectedRef: bref.args[0], valueExpr: index, pos: "dictkey")
                }
            }
        }
    }
}

// The give value of a block that ends in `give <expr>` (a value-position if branch),
// or 0 if the block has no trailing give.
fn tcBlockGiveValue(c: inout Comp, blockId: U64) -> U64 {
    if blockId == 0U64 || blockId >= c.blocks.count {
        return 0U64
    }
    val stmts: Array[U64] = c.blocks[blockId].stmts
    if stmts.count == 0U64 {
        return 0U64
    }
    match c.stmts[stmts[stmts.count - 1U64]] {
        Stmt.Give(val value) => { return value }
        _ => { return 0U64 }
    }
}

// If `valueExpr` is a construction (`<T … />`) of the same generic head as the
// expected instance `expectedRef`, check each provided field's value against the
// field's declared type grounded under the expected instance's type arguments. Covers
// `<Optional.Some v="x"/>` for an expected `Optional[I64]` (the construction itself is
// un-annotated, so the type args come from the expected type). A no-op unless expected
// is a generic instance and the heads match.
fn tcCheckMakeFields(c: inout Comp, expectedRef: U64, makeId: U64) {
    if expectedRef >= c.types.count {
        return
    }
    val et: TypeRef = c.types[expectedRef]
    if et.args.count == 0U64 {
        return
    }
    match c.exprs[makeId] {
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, ty: _, val fields) => {
            if intern(c: inout c, start: typeStart, len: typeLen) == et.nameId {
            } else {
                return
            }
            // Ref[T] / WeakRef[T] are lang items (not registered generic structs), so
            // the struct lookup below misses them. Their `value` field is T — check it
            // (`<Ref[I64] value=true/>` would otherwise box a Bool as an I64).
            if rangeEquals(bytes: c.bytes, start: et.nameStart, len: et.nameLen, kw: "Ref") || rangeEquals(bytes: c.bytes, start: et.nameStart, len: et.nameLen, kw: "WeakRef") {
                if et.args.count >= 1U64 {
                    mut val rfi: U64 = 0
                    while rfi < fields.count {
                        if rangeEquals(bytes: c.bytes, start: fields[rfi].nameStart, len: fields[rfi].nameLen, kw: "value") {
                            tcCheckValue(c: inout c, expectedRef: et.args[0], valueExpr: fields[rfi].value, pos: "ref value")
                        }
                        rfi += 1
                    }
                }
                return
            }
            if isEnum {
                val ei: U64 = genericEnumIndex(c: inout c, nameStart: et.nameStart, nameLen: et.nameLen)
                if ei >= c.enums.count {
                    return
                }
                val vi: U64 = variantIndex(c: inout c, enumStart: typeStart, enumLen: typeLen, variantStart: variantStart, variantLen: variantLen)
                if vi >= c.enums[ei].variants.count {
                    return
                }
                tcCheckFieldsUnder(c: inout c, params: c.enums[ei].typeParams, targs: et.args, defFields: c.enums[ei].variants[vi].fields, makeFields: fields)
            } else {
                val si: U64 = genericStructIndex(c: inout c, nameStart: et.nameStart, nameLen: et.nameLen)
                if si >= c.structs.count {
                    return
                }
                tcCheckFieldsUnder(c: inout c, params: c.structs[si].typeParams, targs: et.args, defFields: c.structs[si].fields, makeFields: fields)
            }
        }
        _ => {}
    }
}

// For each provided make-field, ground the matching declared field's type under
// (params -> targs) and check the field value against it (in the OUTER env — the
// field value lives in the caller's scope, so the instance env is used only to ground
// the EXPECTED field type, then restored before checking the value).
fn tcCheckFieldsUnder(c: inout Comp, params: Array[Bind], targs: Array[U64], defFields: Array[FieldDef], makeFields: Array[MakeField]) {
    mut val mi: U64 = 0
    while mi < makeFields.count {
        mut val di: U64 = 0
        while di < defFields.count {
            if spansEqual(c: inout c, aStart: defFields[di].nameStart, aLen: defFields[di].nameLen, bStart: makeFields[mi].nameStart, bLen: makeFields[mi].nameLen) {
                if defFields[di].ty != 0U64 {
                    val savedP: Array[Bind] = c.curTypeParams
                    val savedA: Array[U64] = c.curTypeArgs
                    c.curTypeParams = params
                    c.curTypeArgs = targs
                    val grounded: U64 = groundTypeRef(c: inout c, ref: defFields[di].ty)
                    c.curTypeParams = savedP
                    c.curTypeArgs = savedA
                    tcCheckValue(c: inout c, expectedRef: grounded, valueExpr: makeFields[mi].value, pos: "ginst-field")
                }
                di = defFields.count
            } else {
                di += 1
            }
        }
        mi += 1
    }
}

// A diagnostic position label "<prefix><fieldName>" (so a payload/field mismatch
// names the field). Temporary (development scaffold).
fn tcFieldPos(c: inout Comp, prefix: String, nameStart: U64, nameLen: U64) -> String {
    mut val bs: Array[U8] = []
    appendBytes(into: inout bs, from: prefix.bytes)
    mut val i: U64 = 0
    while i < nameLen {
        bs.append(value: c.bytes[nameStart + i])
        i += 1
    }
    return stringFromBytes(b: bs)
}

// The expression form (for diagnostics), so a TC mismatch can be located.
fn tcExprKind(c: inout Comp, id: U64) -> String {
    match c.exprs[id] {
        Expr.Call(nameStart: _, nameLen: _, args: _) => { return "Call" }
        Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => { return "Method" }
        Expr.Field(base: _, val nameStart, val nameLen) => {
            mut val bs: Array[U8] = []
            appendBytes(into: inout bs, from: "Field:".bytes)
            mut val i: U64 = 0
            while i < nameLen {
                bs.append(value: c.bytes[nameStart + i])
                i += 1
            }
            return stringFromBytes(b: bs)
        }
        Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, fields: _) => { return "Make" }
        Expr.MatchExpr(scrut: _, arms: _) => { return "MatchExpr" }
        Expr.Ident(val start, val len) => {
            mut val bs: Array[U8] = []
            appendBytes(into: inout bs, from: "Ident:".bytes)
            mut val i: U64 = 0
            while i < len {
                bs.append(value: c.bytes[start + i])
                i += 1
            }
            return stringFromBytes(b: bs)
        }
        Expr.Index(base: _, index: _) => { return "Index" }
        Expr.Binary(op: _, lhs: _, rhs: _) => { return "Binary" }
        Expr.Cast(operand: _, tyStart: _, tyLen: _, ty: _) => { return "Cast" }
        Expr.Int(value: _, offset: _, isBool: _, val tyStart, val tyLen, isNeg: _) => {
            mut val bs: Array[U8] = []
            appendBytes(into: inout bs, from: "Int:".bytes)
            mut val i: U64 = 0
            while i < tyLen {
                bs.append(value: c.bytes[tyStart + i])
                i += 1
            }
            return stringFromBytes(b: bs)
        }
        Expr.Unary(op: _, operand: _) => { return "Unary" }
        _ => { return "other" }
    }
}

// The head-name text of a TypeRef (for diagnostics), or "?" for the unknown ref 0.
fn tcRefName(c: inout Comp, ref: U64) -> String {
    if ref == 0U64 || ref >= c.types.count {
        return "?"
    }
    val t: TypeRef = c.types[ref]
    mut val bs: Array[U8] = []
    mut val i: U64 = 0
    while i < t.nameLen {
        bs.append(value: c.bytes[t.nameStart + i])
        i += 1
    }
    return stringFromBytes(b: bs)
}
