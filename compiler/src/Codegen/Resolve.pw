// The module id owning the source byte `offset` (spec/15 visibility): the loader
// tags each file's [start,len) span in `bytes` with a module id (a module = a root
// file + its `part` tree; each `import` target a separate one). A declaration's or
// use's module is `moduleOf(its name offset)`. Returns 0 (the entry module) if no
// range matches (e.g. synthetic spans appended after loading).
fn moduleOf(c: inout Comp, offset: U64) -> U64 {
    mut val i: U64 = 0
    while i < c.moduleRanges.count {
        val r: Bind = c.moduleRanges[i]
        if offset >= r.nameStart {
            if offset < r.nameStart + r.nameLen {
                return r.fieldStart
            }
        }
        i += 1
    }
    return 0
}

// The effective declared type of a `val`/`mut val` binding: the written
// annotation, or — when omitted (`val x = expr`) — inferred from the initializer.
// (start,len,arr) is the head/array view; ty the structured TypeRef. Shared by
// genStmt's Let lowering and the async frame-field collection so they agree.
struct LetEff {
    pub val start: U64
    pub val len: U64
    pub val arr: Bool
    pub val ty: U64
}

// Compute a binding's effective type (see LetEff). Mirrors genStmt's Let
// inference: no annotation -> exprType(init); a bare String value recovers a
// "String" name span so genCTypeOf can name PlewString.
fn inferLetType(c: inout Comp, tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64) -> LetEff {
    mut val effStart: U64 = tyStart
    mut val effLen: U64 = tyLen
    mut val effArr: Bool = tyIsArray
    mut val effTy: U64 = ty
    if tyLen == 0 {
        if tyIsArray {
        } else {
            val ti: TypeInfo = exprType(c: inout c, id: init)
            effStart = ti.nameStart
            effLen = ti.nameLen
            effTy = ti.ref
            if ti.kind == 3 {
                effArr = true
            }
            if ti.kind == 1 {
                if effLen == 0 {
                    val ss: Bind = stringTypeSpan(c: inout c)
                    if ss.nameLen == 0 {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: init)), msg: "cannot infer the type of this binding; add a type annotation (e.g. `: String`)")
                    } else {
                        effStart = ss.nameStart
                        effLen = ss.nameLen
                    }
                }
            }
        }
    }
    return <LetEff start=effStart len=effLen arr=effArr ty=effTy />
}

// Resolve a free-function call to its overload. Candidates share the name; among
// them the one whose selector (labels + arg types) matches the call is chosen.
// `args` carries the call's labels/types. Returns the func index, or
// c.funcs.count (a U64 sentinel, no signed index) if none matches.
fn findFunc(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
    // Among candidates whose labels match, prefer the one whose parameter types
    // match the argument types (type-based overload). Fall back to the first
    // label match when none type-matches (or there is a single candidate) — so a
    // unique-name call resolves exactly as before. A free fn defined in the SAME
    // module as the call wins over a same-named one in another module (spec/15:
    // free-fn resolution is same-module first; another module's name is reachable
    // only when imported) — without this, a private free fn in another loaded
    // module could shadow the caller's own and trigger a spurious "use without
    // importing" reject (and the wrong C symbol).
    val useMod: U64 = moduleOf(c: inout c, offset: nameStart)
    mut val firstLabel: U64 = c.funcs.count
    mut val typeMatch: U64 = c.funcs.count
    mut val typeMatch2: U64 = c.funcs.count
    mut val firstLabelSame: U64 = c.funcs.count
    mut val typeMatchSame: U64 = c.funcs.count
    mut val typeMatch2Same: U64 = c.funcs.count
    val qId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        // a bare call never resolves to a method (`hasRecv`) or an associated fn
        // (`isAssoc`, e.g. an operator witness `add`): both require `Type.` (or
        // `recv.`) qualification. Skipping them keeps a free fn / local closure
        // named `add` from colliding with Core's `Add.add` (spec/07).
        if f.hasRecv || f.isAssoc {
        } else {
            if f.nameId == qId {
                if paramsLabelsOk(c: inout c, params: f.params, args: args) {
                    val same: Bool = moduleOf(c: inout c, offset: f.nameStart) == useMod
                    if firstLabel == c.funcs.count {
                        firstLabel = i
                    }
                    if same {
                        if firstLabelSame == c.funcs.count {
                            firstLabelSame = i
                        }
                    }
                    if paramsTypesMatch(c: inout c, params: f.params, args: args) {
                        if typeMatch == c.funcs.count {
                            typeMatch = i
                        } else {
                            if typeMatch2 == c.funcs.count {
                                typeMatch2 = i
                            }
                        }
                        if same {
                            if typeMatchSame == c.funcs.count {
                                typeMatchSame = i
                            } else {
                                if typeMatch2Same == c.funcs.count {
                                    typeMatch2Same = i
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    // same-module first
    if typeMatchSame != c.funcs.count {
        checkOverloadAmbiguity(c: inout c, a: typeMatchSame, b: typeMatch2Same, args: args)
        return typeMatchSame
    }
    if firstLabelSame != c.funcs.count {
        return firstLabelSame
    }
    // no same-module candidate: fall back to any module (cross-module use is still
    // gated separately by checkUseVisibility, which requires an import).
    if typeMatch != c.funcs.count {
        checkOverloadAmbiguity(c: inout c, a: typeMatch, b: typeMatch2, args: args)
        return typeMatch
    }
    return firstLabel
}

// Index of the first free function named (start,len), or c.funcs.count if none.
// Used where a bare function name is taken as a value (function pointer): there is
// no call to pick an overload, so the first is used (overloaded fn-values are a
// later concern).
fn firstFuncByName(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        // skip methods and associated fns: a bare name only names a free fn (see
        // findFunc — operator witnesses like `add` are assoc, not free).
        if f.hasRecv || f.isAssoc {
        } else {
            if f.nameId == qId {
                return i
            }
        }
        i += 1
    }
    return c.funcs.count
}

// Whether any free function (non-method) is named (start,len), regardless of
// signature. Distinguishes "unknown name / builtin" from "name exists but no
// overload's labels matched" for diagnostics.
fn funcNameExists(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    return firstFuncByName(c: inout c, nameStart: nameStart, nameLen: nameLen) != c.funcs.count
}

// Index of the method named (nameStart,nameLen) on receiver type
// (recvStart,recvLen), resolving overloads by labels + arg types (like findFunc),
// or `c.funcs.count` if none. Falls back to the first label match.
fn findMethod(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
    mut val firstLabel: U64 = c.funcs.count
    mut val typeMatch: U64 = c.funcs.count
    mut val typeMatch2: U64 = c.funcs.count
    val qNameId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    val qRecvId: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.nameId == qNameId {
                if f.recvId == qRecvId {
                    if paramsLabelsOk(c: inout c, params: f.params, args: args) {
                        if firstLabel == c.funcs.count {
                            firstLabel = i
                        }
                        if paramsTypesMatch(c: inout c, params: f.params, args: args) {
                            if typeMatch == c.funcs.count {
                                typeMatch = i
                            } else {
                                if typeMatch2 == c.funcs.count {
                                    typeMatch2 = i
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    if typeMatch != c.funcs.count {
        checkOverloadAmbiguity(c: inout c, a: typeMatch, b: typeMatch2, args: args)
        return typeMatch
    }
    if firstLabel != c.funcs.count {
        return firstLabel
    }
    // no direct method: a trait `via` alias may redirect this requirement name to
    // a real member (spec/08). Retry resolution under the real name.
    mut val ai: U64 = 0
    while ai < c.methodAliases.count {
        val al: MethodAlias = c.methodAliases[ai]
        if al.recvId == qRecvId {
            if al.aliasId == qNameId {
                return findMethod(c: inout c, recvStart: recvStart, recvLen: recvLen, nameStart: al.realStart, nameLen: al.realLen, args: args)
            }
        }
        ai += 1
    }
    return c.funcs.count
}

// Index of the assoc fn named (nameStart,nameLen) on type (recvStart,recvLen),
// resolving overloads by labels + arg types, or c.funcs.count if none. An assoc
// fn has hasRecv=false (no self) but recvStart/recvLen name its owning type.
fn findAssoc(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> U64 {
    mut val firstLabel: U64 = c.funcs.count
    mut val typeMatch: U64 = c.funcs.count
    mut val typeMatch2: U64 = c.funcs.count
    val qNameId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    val qRecvId: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.isAssoc {
            if f.nameId == qNameId {
                if f.recvId == qRecvId {
                    if paramsLabelsOk(c: inout c, params: f.params, args: args) {
                        if firstLabel == c.funcs.count {
                            firstLabel = i
                        }
                        if paramsTypesMatch(c: inout c, params: f.params, args: args) {
                            if typeMatch == c.funcs.count {
                                typeMatch = i
                            } else {
                                if typeMatch2 == c.funcs.count {
                                    typeMatch2 = i
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    if typeMatch != c.funcs.count {
        checkOverloadAmbiguity(c: inout c, a: typeMatch, b: typeMatch2, args: args)
        return typeMatch
    }
    return firstLabel
}

// Whether (start,len) names a struct or enum type (used to detect an assoc-fn
// call `Type.name(args)`, where the receiver is a bare type name, not a value).
fn isTypeName(c: inout Comp, start: U64, len: U64) -> Bool {
    if structIndexByName(c: inout c, start: start, len: len) < c.structs.count {
        return true
    }
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        if c.enums[ei].nameId == qId {
            return true
        }
        ei += 1
    }
    // a trait name also qualifies as an assoc-fn receiver: a trait can own
    // provided `assoc fn`s (no Self in their signature), called `Trait.fn(args)`
    // — the single provided impl makes it unambiguous (the derive model's
    // `Hash.derive(input)` rides on this). This is `isTypeName`'s only caller
    // (assocRecvName), so traits qualify only for that routing.
    mut val ti: U64 = 0
    while ti < c.traits.count {
        if c.traits[ti].nameId == qId {
            return true
        }
        ti += 1
    }
    return genericStructIndex(c: inout c, nameStart: start, nameLen: len) < c.structs.count
}

// If `recv` is a bare identifier naming a type (not a local value), return that
// type's name span as an assoc-fn receiver; else signal "not an assoc call" by
// returning len 0. Used by call codegen/type recovery to route `Type.name(args)`.
fn assocRecvName(c: inout Comp, recv: U64) -> Bind {
    match c.exprs[recv] {
        Expr.Ident(val start, val len) => {
            if isSelfRef(c: inout c, start: start, len: len) {
                return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
            }
            if localIndexByName(c: inout c, start: start, len: len) < c.locals.count {
                return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
            }
            if isTypeName(c: inout c, start: start, len: len) {
                return <Bind nameStart=start nameLen=len fieldStart=start fieldLen=len />
            }
            return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
        }
        _ => { return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 /> }
    }
}

// Check call args against a parameter list: arg count matches and every arg
// carries its parameter's label in declaration order (spec: labels required).
fn paramsLabelsOk(c: inout Comp, params: Array[Param], args: Array[Arg]) -> Bool {
    if args.count > params.count {
        return false
    }
    // any params beyond the provided args must have a default (trailing-default
    // omission). Without that, the arity mismatch is an error.
    mut val r: U64 = args.count
    while r < params.count {
        if params[r].hasDefault {
        } else {
            return false
        }
        r += 1
    }
    mut val i: U64 = 0
    while i < args.count {
        val a: Arg = args[i]
        val p: Param = params[i]
        if p.noLabel {
            // label-suppressed param: the argument must be positional (no label).
            if a.hasLabel {
                return false
            }
        } else {
            if a.hasLabel {
                if intern(c: inout c, start: a.labelStart, len: a.labelLen) == p.nameId {
                } else {
                    return false
                }
            } else {
                return false
            }
        }
        i += 1
    }
    return true
}

// Whether an argument's recovered type matches a parameter's declared type head
// (used to discriminate same-label overloads — spec: overload by argument type).
// An untyped integer literal (no suffix) matches any integer-typed parameter.
fn argMatchesParam(c: inout Comp, argExpr: U64, p: Param) -> Bool {
    val ti: TypeInfo = exprType(c: inout c, id: argExpr)
    if p.tyIsArray {
        if ti.kind == 3 {
            return intern(c: inout c, start: ti.nameStart, len: ti.nameLen) == p.tyNameId
        }
        return false
    }
    if ti.kind == 1 {
        return rangeEquals(bytes: c.bytes, start: p.tyStart, len: p.tyLen, kw: "String")
    }
    if ti.kind == 2 {
        return intern(c: inout c, start: ti.nameStart, len: ti.nameLen) == p.tyNameId
    }
    // ti.kind == 0: a scalar / integer. A suffixed/typed value carries its name;
    // an untyped literal (no name) adapts to any integer parameter.
    if ti.nameLen != 0 {
        return intern(c: inout c, start: ti.nameStart, len: ti.nameLen) == p.tyNameId
    }
    return isIntType(c: inout c, start: p.tyStart, len: p.tyLen)
}

// Whether every argument's type matches its parameter's declared type. Provided
// (non-defaulted) args only; trailing defaulted params are not type-checked here.
fn paramsTypesMatch(c: inout Comp, params: Array[Param], args: Array[Arg]) -> Bool {
    mut val i: U64 = 0
    while i < args.count {
        if i < params.count {
            if argMatchesParam(c: inout c, argExpr: args[i].expr, p: params[i]) {
            } else {
                return false
            }
        }
        i += 1
    }
    return true
}

// An argument that is an unsuffixed integer literal carries no type name, so it
// adapts to any integer parameter (argMatchesParam's last clause). Such an
// argument is the only source of "one call matches two overloads": a typed value
// matches exactly one parameter type.
fn argIsUntypedIntLit(c: inout Comp, argExpr: U64) -> Bool {
    val ti: TypeInfo = exprType(c: inout c, id: argExpr)
    if ti.kind == 0 {
        return ti.nameLen == 0
    }
    return false
}

// Two type-matching overloads are genuinely ambiguous for this call iff some
// untyped integer-literal argument maps to differing parameter types between
// them. (Overloads that agree on every provided arg type but differ only via
// defaulted/omitted params are a separate concern, not flagged here.)
fn overloadsAmbiguous(c: inout Comp, fa: Func, fb: Func, args: Array[Arg]) -> Bool {
    mut val i: U64 = 0
    while i < args.count {
        if argIsUntypedIntLit(c: inout c, argExpr: args[i].expr) {
            if i < fa.params.count {
                if i < fb.params.count {
                    if fa.params[i].tyNameId == fb.params[i].tyNameId {
                    } else {
                        return true
                    }
                }
            }
        }
        i += 1
    }
    return false
}

// Loudly reject (exits) when the two type-matching overloads `a`/`b` are
// ambiguous for this call — picking the first silently would invent meaning
// (spec: 補完はする／忖度はしない／曖昧はエラー).
fn checkOverloadAmbiguity(c: inout Comp, a: U64, b: U64, args: Array[Arg]) {
    if b != c.funcs.count {
        if overloadsAmbiguous(c: inout c, fa: c.funcs[a], fb: c.funcs[b], args: args) {
            mut val off: U64 = 0
            if args.count > 0 {
                off = exprOffset(c: inout c, id: args[0].expr)
            }
            compileErrorAt(line: lineOf(c: inout c, offset: off), msg: "ambiguous call: an unsuffixed integer literal matches more than one overload; add a type suffix (e.g. `5I32`)")
        }
    }
}

// Acceptance soundness: spec requires every argument to carry its label, in
// declaration order. Check a call against the callee's params. Calls that don't
// resolve to a user function (I/O builtins, methods) return true here — they're
// handled on their own paths and keep their provisional calling conventions.
fn callLabelsOk(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
    if funcNameExists(c: inout c, nameStart: nameStart, nameLen: nameLen) {
        // a user function by this name exists: some overload's labels must match.
        return findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args) != c.funcs.count
    }
    // not a user function (I/O builtin etc.) — handled on its own path.
    return true
}

// Does some arm cover the variant (variantStart,variantLen)? A wildcard arm
// covers everything.
fn armCovers(c: inout Comp, arms: Array[MatchArm], variantStart: U64, variantLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < arms.count {
        val a: MatchArm = arms[i]
        if a.isWildcard {
            return true
        }
        if spansEqual(c: inout c, aStart: a.variantStart, aLen: a.variantLen, bStart: variantStart, bLen: variantLen) {
            return true
        }
        i += 1
    }
    return false
}

// Acceptance soundness: spec requires match to be exhaustive (Rust-style). A
// match is exhaustive iff it has a `_` wildcard, or every variant of the
// scrutinee's enum is covered by some arm. (This compiler's match is always
// over an enum, and has no `val x` catch-all arm, so those are the only cases.)
fn matchExhaustive(c: inout Comp, arms: Array[MatchArm]) -> Bool {
    mut val enumStart: U64 = 0
    mut val enumLen: U64 = 0
    mut val i: U64 = 0
    while i < arms.count {
        val a: MatchArm = arms[i]
        if a.isWildcard {
            return true
        }
        if enumLen == 0 {
            enumStart = a.enumStart
            enumLen = a.enumLen
        }
        i += 1
    }
    if enumLen == 0 {
        return true
    }
    val qEnum: U64 = intern(c: inout c, start: enumStart, len: enumLen)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.nameId == qEnum {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if armCovers(c: inout c, arms: arms, variantStart: v.nameStart, variantLen: v.nameLen) {
                } else {
                    return false
                }
                vi += 1
            }
            return true
        }
        ei += 1
    }
    return true
}

// Tag index of `Enum.Variant` (the variant's position in its enum declaration).
fn variantIndex(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> U64 {
    val qEnum: U64 = intern(c: inout c, start: enumStart, len: enumLen)
    val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.nameId == qEnum {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if v.nameId == qVar {
                    return vi
                }
                vi += 1
            }
        }
        ei += 1
    }
    return 0
}

// ---- lightweight type recovery (for monomorphization + .bytes dispatch) ----

fn scalarInfo() -> TypeInfo {
    return <TypeInfo kind=0 nameStart=0 nameLen=0 ref=0 />
}

// A source span whose bytes read `kw` (length `kwLen`). The type system recovers
// a named type from a (start,len) span; some values have a known type with no
// source span to point at (a string literal's `String`, `.bytes`'s `U8`). Reuse
// any occurrence of `kw` in the source as a label span (the match is purely the
// bytes; a comment/string occurrence works too). nameLen=0 if `kw` never appears.
// Append `kw`'s bytes to `c.bytes` and record their span in `c.kwCache`, so a
// built-in name with no guaranteed source occurrence has a stable, addressable
// span without scanning (or planting a comment in) the source.
fn addKwSpan(c: inout Comp, kw: String) {
    val start: U64 = c.bytes.count
    val b: Array[U8] = kw.bytes
    mut val i: U64 = 0
    while i < b.count {
        c.bytes.append(b[i])
        i += 1
    }
    c.kwCache.append(<Bind nameStart=start nameLen=b.count fieldStart=start fieldLen=b.count />)
}

// Build the built-in-name span cache once (before any kwSpan use). Covers exactly
// the names kwSpan is asked for. Appended after the lexed source, so token offsets
// are unaffected.
fn buildKwCache(c: inout Comp) {
    addKwSpan(c: inout c, kw: "String")
    addKwSpan(c: inout c, kw: "U8")
    addKwSpan(c: inout c, kw: "U64")
    addKwSpan(c: inout c, kw: "Bool")
    addKwSpan(c: inout c, kw: "Array")
    addKwSpan(c: inout c, kw: "fn")
    addKwSpan(c: inout c, kw: "iterator")
    addKwSpan(c: inout c, kw: "next")
}

// Return a stable source span naming `kw`. O(1) lookup in the prebuilt cache; any
// name not pre-cached falls back to a source scan (a len-0 Bind if absent, which
// callers treat as "no span").
fn kwSpan(c: inout Comp, kw: String, kwLen: U64) -> Bind {
    mut val ci: U64 = 0
    while ci < c.kwCache.count {
        val e: Bind = c.kwCache[ci]
        if rangeEquals(bytes: c.bytes, start: e.nameStart, len: e.nameLen, kw: kw) {
            return e
        }
        ci += 1
    }
    val n: U64 = c.bytes.count
    if n < kwLen {
        return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
    }
    mut val i: U64 = 0
    val last: U64 = n - kwLen
    while i <= last {
        if rangeEquals(bytes: c.bytes, start: i, len: kwLen, kw: kw) {
            return <Bind nameStart=i nameLen=kwLen fieldStart=i fieldLen=kwLen />
        }
        i += 1
    }
    return <Bind nameStart=0 nameLen=0 fieldStart=0 fieldLen=0 />
}

// String literals are monomorphic (always `String`), so `val s = "hi"` infers
// `String`; recover a "String" span to name PlewString (else require annotation).
fn stringTypeSpan(c: inout Comp) -> Bind {
    return kwSpan(c: inout c, kw: "String", kwLen: 6)
}

fn typeInfoOfName(c: inout Comp, start: U64, len: U64, isArray: Bool) -> TypeInfo {
    if isArray {
        return <TypeInfo kind=3 nameStart=start nameLen=len ref=0 />
    }
    if len == 0 {
        return scalarInfo()
    }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "String") {
        return <TypeInfo kind=1 nameStart=start nameLen=len ref=0 />
    }
    if isPrimType(c: inout c, start: start, len: len) {
        // kind=0 (scalar) but carry the type name so the width is recoverable
        // (e.g. for the lossless-`as` check). The C type stays 64-bit for now.
        return <TypeInfo kind=0 nameStart=start nameLen=len ref=0 />
    }
    return <TypeInfo kind=2 nameStart=start nameLen=len ref=0 />
}

fn addLocal(c: inout Comp, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool, owned: Bool) {
    addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: isArray, ty: ty, isInout: isInout, isMut: isMut, owned: owned, cnum: 0)
}

// Like addLocal but with an explicit C-name disambiguator (see Local.cnum).
fn addLocalCn(c: inout Comp, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, isArray: Bool, ty: U64, isInout: Bool, isMut: Bool, owned: Bool, cnum: U64) {
    c.locals.append(<Local nameStart=nameStart nameLen=nameLen nameId=intern(c: inout c, start: nameStart, len: nameLen) tyStart=tyStart tyLen=tyLen tyNameId=intern(c: inout c, start: tyStart, len: tyLen) isArray=isArray ty=ty isInout=isInout isMut=isMut owned=owned moved=false cnum=cnum />)
}

// How many currently-live locals already carry this name (used by `let`
// bindings to pick a fresh C-name suffix so shadowing doesn't collide in C).
fn shadowCount(c: inout Comp, nameStart: U64, nameLen: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val n: U64 = 0
    mut val i: U64 = 0
    while i < c.locals.count {
        val lo: Local = c.locals[i]
        if lo.nameId == qId {
            n += 1
        }
        i += 1
    }
    return n
}

// Emit a local's C name, with its shadowing suffix when it has one. In an async
// fn every binding lives in the heap frame, so a reference reads `__f->name`
// (stage 1-2: the whole async body is flat, so all locals are frame fields).
fn writeLocalCName(c: inout Comp, lo: Local) {
    if c.curAsync {
        write(s: "__f->")
    }
    writeNameCn(c: inout c, start: lo.nameStart, len: lo.nameLen, cnum: lo.cnum)
}

// Emit `<name>` or, when cnum>0, `<name>_s<cnum>` (the shadowing-safe C name).
fn writeNameCn(c: inout Comp, start: U64, len: U64, cnum: U64) {
    writeSpan(c: inout c, start: start, len: len)
    if cnum > 0 {
        write(s: "_s")
        writeU64(n: cnum)
    }
}

// --- scope frames (the ARC drop backbone) ---
//
// Locals live in a flat stack (`c.locals`). A lexical block owns the bindings
// pushed after its entry high-water mark; on exit we (1) drop them — ARC
// release / `deinit`, currently a no-op while everything leaks — and (2) pop
// them so a sibling or enclosing scope cannot resolve a name that has left
// scope. C variable names are emitted verbatim (writeSpan of the source name),
// so popping only tightens name resolution; it never renames anything.

// Record the locals high-water mark to restore at scope exit.
fn scopeMark(c: inout Comp) -> U64 {
    return c.locals.count
}

// Emit the releases for every binding pushed since `mark`, in reverse
// declaration order (construction is forward, destruction is reverse). Only
// owned array locals are released here (buffer-only: arrays-of-heap leak their
// elements until recursive release lands; .bytes views carry rc=0 so the call
// is a no-op). Array `let` bindings are always uniquely owned — genArrayValue
// copies a place and news a literal — so freeing them needs no retain bookkeeping.
fn emitScopeDrops(c: inout Comp, mark: U64, exclIdx: U64) {
    mut val i: U64 = c.locals.count
    while i > mark {
        i -= 1
        if i == exclIdx {
            // excluded for this exit only (a unique value returned on this path:
            // its bits went to the caller, so the callee must not deinit it — but
            // we do not persist the move, so other exit paths still drop it).
        } else {
        val lo: Local = c.locals[i]
        if lo.moved {
            // moved-out: ownership left this binding; the new owner releases it.
        } else {
        if lo.owned {
            if lo.isArray {
                // recursive release: PlewArray_E_release frees heap-owning struct
                // elements before the buffer (E_release = plew_arc_release for
                // scalar elements; rc=0 borrowed views are no-ops).
                write(s: "    ")
                wPA(c: inout c, elemStart: lo.tyStart, elemLen: lo.tyLen)
                write(s: "_release(")
                writeLocalCName(c: inout c, lo: lo)
                write(s: ");\n")
            } else {
                if isBoxedLocalAt(c: inout c, nameStart: lo.nameStart) {
                    // a boxed (captured `mut val`) cell: drop this scope's reference
                    // to the shared ARC cell (a capturing closure holds its own).
                    write(s: "    plew_arc_release(((long long*)")
                    writeLocalCName(c: inout c, lo: lo)
                    write(s: ") - 1);\n")
                } else {
                if isFnType(c: inout c, ref: lo.ty) {
                    // an owned closure: release its env (runs drop = release the
                    // captured heap, then frees the env block) at the last ref.
                    write(s: "    plew_closure_release(")
                    writeLocalCName(c: inout c, lo: lo)
                    write(s: ");\n")
                } else {
                if isRefInst(c: inout c, ref: lo.ty) {
                    // an owned Ref local: release its refcounted box.
                    emitRefRelease(c: inout c, nameStart: lo.nameStart, nameLen: lo.nameLen, refTy: lo.ty, cnum: lo.cnum)
                } else {
                if isGenericInst(c: inout c, ref: lo.ty) {
                    // an owned mono struct/enum local (e.g. `Optional[Node]`,
                    // `Box[Array[I32]]`): release its owned heap if any.
                    mut val miNeeds: Bool = false
                    if isGenericEnumInst(c: inout c, ref: lo.ty) {
                        miNeeds = monoEnumNeedsRelease(c: inout c, instRef: lo.ty)
                    } else {
                        miNeeds = monoStructNeedsRelease(c: inout c, instRef: lo.ty)
                    }
                    if miNeeds {
                        write(s: "    ")
                        emitMangle(c: inout c, ref: lo.ty)
                        write(s: "_release(")
                        writeLocalCName(c: inout c, lo: lo)
                        write(s: ");\n")
                    }
                } else {
                    // a unique type's owned local runs `deinit` first (spec/03:
                    // type body before fields), then field release below. The call
                    // is emitted in a function body (after every proto), so the
                    // synthetic `Type_deinit` is in scope.
                    if structHasDeinit(c: inout c, start: lo.tyStart, len: lo.tyLen) {
                        write(s: "    ")
                        writeSpan(c: inout c, start: lo.tyStart, len: lo.tyLen)
                        write(s: "_deinit(")
                        writeLocalCName(c: inout c, lo: lo)
                        write(s: ");\n")
                    }
                    // an owned struct local that owns heap fields: release them.
                    // Safe now that struct bindings share-on-bind (retain), so the
                    // local genuinely co-owns its fields rather than aliasing
                    // without a refcount. Restricted to concrete (non-generic)
                    // structs, whose `<Name>_release` the driver emits.
                    if structLocalReleasable(c: inout c, start: lo.tyStart, len: lo.tyLen) {
                        write(s: "    ")
                        writeSpan(c: inout c, start: lo.tyStart, len: lo.tyLen)
                        write(s: "_release(")
                        writeLocalCName(c: inout c, lo: lo)
                        write(s: ");\n")
                    } else {
                        // an owned concrete-enum local (e.g. a recursive `List`):
                        // release its boxed payloads.
                        if enumNeedsRelease(c: inout c, start: lo.tyStart, len: lo.tyLen) {
                            write(s: "    ")
                            writeSpan(c: inout c, start: lo.tyStart, len: lo.tyLen)
                            write(s: "_release(")
                            writeLocalCName(c: inout c, lo: lo)
                            write(s: ");\n")
                        }
                    }
                }
                }
                }
                }
            }
        }
        }
        }
    }
}

// Release an owned Ref local: drop the box's refcount (header before the
// pointee); at zero, release the boxed value if it owns heap (an array or a
// heap-owning struct) then free the box.
fn emitRefRelease(c: inout Comp, nameStart: U64, nameLen: U64, refTy: U64, cnum: U64) {
    val rt: TypeRef = c.types[refTy]
    val bti: TypeInfo = typeInfoOfRef(c: inout c, ref: rt.args[0])
    write(s: "    if (")
    writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
    write(s: ") { long long* __rrc = ((long long*)")
    writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
    write(s: ") - 1; if ((--(*__rrc)) == 0) {")
    if bti.kind == 3 {
        write(s: " ")
        wPA(c: inout c, elemStart: bti.nameStart, elemLen: bti.nameLen)
        write(s: "_release(*")
        writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
        write(s: ");")
    } else {
        if bti.kind == 2 {
            // last owner of the box: run the pointee's deinit (spec/03 — the last
            // Ref drop is a deterministic deinit point), then release its fields.
            if structHasDeinit(c: inout c, start: bti.nameStart, len: bti.nameLen) {
                write(s: " ")
                writeSpan(c: inout c, start: bti.nameStart, len: bti.nameLen)
                write(s: "_deinit(*")
                writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
                write(s: ");")
            }
            if structNeedsRelease(c: inout c, start: bti.nameStart, len: bti.nameLen) {
                write(s: " ")
                writeSpan(c: inout c, start: bti.nameStart, len: bti.nameLen)
                write(s: "_release(*")
                writeNameCn(c: inout c, start: nameStart, len: nameLen, cnum: cnum)
                write(s: ");")
            }
        }
    }
    write(s: " free(__rrc); } }\n")
}

// Whether the type named (start,len) declared a `deinit` (spec/03). Checked at
// every owned-local scope drop so the last owner runs `deinit` deterministically.
fn structHasDeinit(c: inout Comp, start: U64, len: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.deinits.count {
        val d: Bind = c.deinits[i]
        if spansEqual(c: inout c, aStart: d.nameStart, aLen: d.nameLen, bStart: start, bLen: len) {
            return true
        }
        i += 1
    }
    return false
}

// Whether an owned struct local of type (start,len) should be released at scope
// exit: a concrete (non-generic) struct that owns heap fields. Generic structs
// are excluded — their release fn is mangled per instantiation, not emitted
// under the bare name — so a generic-struct local leaks (safe) for now.
fn structLocalReleasable(c: inout Comp, start: U64, len: U64) -> Bool {
    val si: U64 = structIndexByName(c: inout c, start: start, len: len)
    if si >= c.structs.count {
        return false
    }
    if c.structs[si].typeParams.count > 0 {
        return false
    }
    return structNeedsRelease(c: inout c, start: start, len: len)
}

// Pop the locals stack back to `mark` (Array has no truncate, so rebuild the
// kept prefix — scopes are small and this is codegen, not a hot path).
fn popLocals(c: inout Comp, mark: U64) {
    mut val kept: Array[Local] = []
    mut val i: U64 = 0
    while i < mark {
        kept.append(c.locals[i])
        i += 1
    }
    c.locals = kept
}

// Leave a scope: drop its bindings, then pop them off the resolution stack.
fn scopeExit(c: inout Comp, mark: U64) {
    emitScopeDrops(c: inout c, mark: mark, exclIdx: c.locals.count)
    popLocals(c: inout c, mark: mark)
}

// Whether the binding named (start,len) — most recent in scope — may be assigned
// to: `mut val` locals and `inout` params. Unknown names default to assignable
// (the C compile catches genuinely undeclared identifiers).
fn localIsMutable(c: inout Comp, start: U64, len: U64) -> Bool {
    if isSelfRef(c: inout c, start: start, len: len) {
        // `self` is assignable only through an `inout fn` receiver.
        return c.curSelfInout
    }
    // inside a closure, a capture is assignable only if it is a boxed (`mut val`)
    // reference capture; a by-value (`val`) capture is immutable.
    if c.curInClosure {
        if isCaptureOf(c: inout c, closureId: c.curClosureId, start: start, len: len) {
            return isBoxedCaptureOf(c: inout c, closureId: c.curClosureId, start: start, len: len)
        }
    }
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if lo.nameId == qId {
            if lo.isMut {
                return true
            }
            return lo.isInout
        }
    }
    return true
}

// Whether `name` refers to an `inout` parameter of the current function (so its
// uses must be dereferenced as `(*name)`).
fn isSelfRef(c: inout Comp, start: U64, len: U64) -> Bool {
    if c.curHasRecv {
        return rangeEquals(bytes: c.bytes, start: start, len: len, kw: "self")
    }
    return false
}

fn isInoutLocal(c: inout Comp, start: U64, len: U64) -> Bool {
    if isSelfRef(c: inout c, start: start, len: len) {
        // `inout fn` receivers are pointers, so a bare `self` is `(*self)`.
        return c.curSelfInout
    }
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if lo.nameId == qId {
            return lo.isInout
        }
    }
    return false
}

// Whether the type named (start,len) is a `unique struct` (spec/03).
fn typeIsUnique(c: inout Comp, start: U64, len: U64) -> Bool {
    val si: U64 = structIndexByName(c: inout c, start: start, len: len)
    if si >= c.structs.count {
        return false
    }
    return c.structs[si].isUnique
}

// Index of the innermost local named (start,len), or c.locals.count if none.
fn localIndexByName(c: inout Comp, start: U64, len: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if lo.nameId == qId {
            return i
        }
    }
    return c.locals.count
}

// Whether `name` refers to a moved-out local (spec/03): using it is an error.
fn localMoved(c: inout Comp, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if lo.nameId == qId {
            return lo.moved
        }
    }
    return false
}

// Mark the local named (start,len) moved-out — the last (innermost) binding with
// that name. Rebuilds c.locals (no struct-array IndexSet in self-host) flipping
// `moved` at that one index. A no-op if the name is not a local (e.g. `self`).
fn markMovedLocal(c: inout Comp, start: U64, len: U64) {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val target: U64 = c.locals.count
    mut val i: U64 = c.locals.count
    while i > 0 {
        i -= 1
        val lo: Local = c.locals[i]
        if lo.nameId == qId {
            target = i
            i = 0
        }
    }
    if target >= c.locals.count {
        return
    }
    mut val rebuilt: Array[Local] = []
    mut val j: U64 = 0
    while j < c.locals.count {
        val lo: Local = c.locals[j]
        if j == target {
            rebuilt.append(<Local nameStart=lo.nameStart nameLen=lo.nameLen nameId=lo.nameId tyStart=lo.tyStart tyLen=lo.tyLen tyNameId=lo.tyNameId isArray=lo.isArray ty=lo.ty isInout=lo.isInout isMut=lo.isMut owned=lo.owned moved=true cnum=lo.cnum />)
        } else {
            rebuilt.append(lo)
        }
        j += 1
    }
    c.locals = rebuilt
}

// If `exprId` is a bare identifier naming a local, mark it moved-out (used when
// lowering `move <ident>`). Non-identifier operands aren't tracked places yet.
fn markMovedExpr(c: inout Comp, exprId: U64) {
    match c.exprs[exprId] {
        Expr.Ident(val start, val len) => { markMovedLocal(c: inout c, start: start, len: len) }
        _ => {}
    }
}

// Type of field `fieldName` declared in struct `structName` (else scalar).
fn fieldType(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    val qStruct: U64 = intern(c: inout c, start: structStart, len: structLen)
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if s.nameId == qStruct {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if f.nameId == qField {
                    // a generic-instantiation field type (`Optional[Node]`) carries its
                    // structured ref, so a match/dispatch on the field recovers the
                    // mangled C name (`Optional_Node`) and substitutes payload types.
                    if f.tyIsArray {
                    } else {
                        if isGenericInst(c: inout c, ref: f.ty) {
                            return <TypeInfo kind=2 nameStart=f.tyStart nameLen=f.tyLen ref=f.ty />
                        }
                    }
                    return typeInfoOfName(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                }
                fi += 1
            }
        }
        si += 1
    }
    return scalarInfo()
}

// Whether a struct field is declared `mut val` (assignable). Unknown struct or
// field defaults to true (don't reject what we can't resolve).
fn fieldDeclaredMut(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> Bool {
    val qStruct: U64 = intern(c: inout c, start: structStart, len: structLen)
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if s.nameId == qStruct {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if f.nameId == qField {
                    return f.isMut
                }
                fi += 1
            }
        }
        si += 1
    }
    return true
}

// Member visibility (spec/05). A field's visibility 0=private / 1=pub(get) / 2=pub,
// or 3 when the struct/field isn't found (e.g. String's special `.bytes` view, or a
// scalar) — then visibility is not enforced.
fn fieldVis(c: inout Comp, structStart: U64, structLen: U64, fieldStart: U64, fieldLen: U64) -> U64 {
    val qStruct: U64 = intern(c: inout c, start: structStart, len: structLen)
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    mut val si: U64 = 0
    while si < c.structs.count {
        val s: StructDef = c.structs[si]
        if s.nameId == qStruct {
            val fs: Array[FieldDef] = s.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                if f.nameId == qField {
                    return f.vis
                }
                fi += 1
            }
        }
        si += 1
    }
    return 3U64
}

// Whether type (recvStart,recvLen) has any method named (nameStart,nameLen),
// regardless of signature. Used to reject method-value expressions `obj.method`
// (spec/07: a method cannot be bound to a value — wrap it in a closure).
fn typeHasMethodNamed(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
    val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.nameId == qName {
                if f.recvId == qRecv {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Are we lowering code inside the type `(ownerStart,ownerLen)`'s own anonymous impl
// (the only place its non-public members are visible — spec/05)? True when the
// current function is a method OR an associated function whose receiver/owner head
// names that type — both are part of the type's impl, so they see its private
// fields (this is what lets derived `eq`/`compare` read private fields). A free
// function has no owner (recvStart 0). Extensions (`#Ext`) aren't implemented, so
// any such context is an anonymous impl.
fn inAnonImplOf(c: inout Comp, ownerStart: U64, ownerLen: U64) -> Bool {
    if c.curHasRecv {
        return spansEqual(c: inout c, aStart: c.curRecvStart, aLen: c.curRecvLen, bStart: ownerStart, bLen: ownerLen)
    }
    if c.curRecvStart != 0 {
        return spansEqual(c: inout c, aStart: c.curRecvStart, aLen: c.curRecvLen, bStart: ownerStart, bLen: ownerLen)
    }
    return false
}

// Reading `base.field` (spec/05): a private field (vis 0) is visible only inside its
// type's anonymous impl. pub(get)/pub are readable anywhere the type is.
fn checkFieldReadVis(c: inout Comp, ownerStart: U64, ownerLen: U64, fieldStart: U64, fieldLen: U64, offset: U64) {
    val v: U64 = fieldVis(c: inout c, structStart: ownerStart, structLen: ownerLen, fieldStart: fieldStart, fieldLen: fieldLen)
    if v == 0U64 {
        if inAnonImplOf(c: inout c, ownerStart: ownerStart, ownerLen: ownerLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "field is private (visible only in its type's anonymous impl)")
        }
    }
}

// Writing `base.field = …` (spec/05): both a private field (vis 0) and a `pub(get)`
// field (vis 1) are writable only inside the type's anonymous impl; only `pub`
// (vis 2) is externally writable.
fn checkFieldWriteVis(c: inout Comp, ownerStart: U64, ownerLen: U64, fieldStart: U64, fieldLen: U64, offset: U64) {
    val v: U64 = fieldVis(c: inout c, structStart: ownerStart, structLen: ownerLen, fieldStart: fieldStart, fieldLen: fieldLen)
    if v == 0U64 {
        if inAnonImplOf(c: inout c, ownerStart: ownerStart, ownerLen: ownerLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "field is private (writable only in its type's anonymous impl)")
        }
    } else {
        if v == 1U64 {
            if inAnonImplOf(c: inout c, ownerStart: ownerStart, ownerLen: ownerLen) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "field is `pub(get)` — readable but writable only in its type's anonymous impl")
            }
        }
    }
}

// Calling `recv.method(…)` (spec/05): a method in a bare `impl` block (Func.isPub
// false) is private — visible only inside the type's anonymous impl. `pub impl`
// methods are callable wherever the type is. `ownerStart/Len` names the receiver
// type head (so generic receivers match by name).
fn checkMethodVis(c: inout Comp, ownerStart: U64, ownerLen: U64, mf: Func, offset: U64) {
    if mf.isPub {
    } else {
        if inAnonImplOf(c: inout c, ownerStart: ownerStart, ownerLen: ownerLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "method is private (callable only in its type's anonymous impl; put it in a `pub impl`)")
        }
    }
}

// Whether an assignment target is a mutable *place* (spec: composite mutability).
// A bare binding must be `mut val`/`inout`; a field access additionally needs the
// field declared `mut val` and its base to be a mutable place; an index follows
// its array binding. Unresolved cases default to mutable (the C compile still
// catches genuinely undeclared names).
fn placeIsMutable(c: inout Comp, id: U64) -> Bool {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Ident(val start, val len) => {
            return localIsMutable(c: inout c, start: start, len: len)
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 2 {
                if fieldDeclaredMut(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen) {
                    return placeIsMutable(c: inout c, id: base)
                }
                return false
            }
            return placeIsMutable(c: inout c, id: base)
        }
        Expr.Index(val base, val index) => {
            return placeIsMutable(c: inout c, id: base)
        }
        Expr.Arrow(val base, val nameStart, val nameLen) => {
            // a Ref's pointee is mutable even through a `val` Ref binding (spec:
            // `->` is not gated by val/mut; sharing is the Ref's purpose).
            return true
        }
        _ => { return true }
    }
}

// Sentinel `exprTyKind` value marking an uncomputed type-cache slot (real kinds
// are 0=scalar/1=String/2=named/3=array).
fn typeUnfilled() -> I64 {
    return 99
}

// Allocate the typed-AST cache (one slot per expression node), all unfilled.
// Called once before emission; expr ids are stable by then.
fn buildExprTyTable(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        c.exprTyKind.append(typeUnfilled())
        c.exprTyStart.append(0)
        c.exprTyLen.append(0)
        c.exprTyRef.append(0)
        c.exprIntCtx.append(0)
        i += 1
    }
}

// The kw name for a recorded int-context code (1..8 -> I8..U64).
fn intCtxKw(code: U64) -> String {
    if code == 1 { return "I8" }
    if code == 2 { return "I16" }
    if code == 3 { return "I32" }
    if code == 4 { return "I64" }
    if code == 5 { return "U8" }
    if code == 6 { return "U16" }
    if code == 7 { return "U32" }
    return "U64"
}

// The TypeInfo for `id`'s recorded int context (scalarInfo if none) — the fallback
// `typeOf` uses for a width-less expression whose type came only from context.
fn exprIntCtxTypeInfo(c: inout Comp, id: U64) -> TypeInfo {
    if id < c.exprIntCtx.count {
        val code: U64 = c.exprIntCtx[id]
        if code != 0 {
            val kw: String = intCtxKw(code: code)
            val b: Bind = kwSpan(c: inout c, kw: kw, kwLen: kw.bytes.count)
            if b.nameLen != 0 {
                return <TypeInfo kind=0 nameStart=b.nameStart nameLen=b.nameLen ref=0 />
            }
        }
    }
    return scalarInfo()
}

// The type of expression `id` — the typed-AST read path codegen uses instead of
// re-deriving with `exprType`. Caching is restricted to a pure free-function
// context: no type params, no receiver-instantiation, no receiver/Self/Item env.
// There a node's type is env-independent AND its body is emitted exactly once, so
// it can be computed once via `exprType` and cached. Method bodies are excluded
// because a provided trait method shares one body AST across conforming types
// (its node types vary with Self); generic bodies vary per instantiation. Those
// re-derive every time.
fn typeOf(c: inout Comp, id: U64) -> TypeInfo {
    mut val t: TypeInfo = scalarInfo()
    if id < c.exprTyKind.count {
        if c.exprTyKind[id] == typeUnfilled() {
            t = exprType(c: inout c, id: id)
            c.exprTyKind[id] = t.kind
            c.exprTyStart[id] = t.nameStart
            c.exprTyLen[id] = t.nameLen
            c.exprTyRef[id] = t.ref
            c.exprTyFilled.append(id)
        } else {
            t = <TypeInfo kind=c.exprTyKind[id] nameStart=c.exprTyStart[id] nameLen=c.exprTyLen[id] ref=c.exprTyRef[id] />
        }
    } else {
        t = exprType(c: inout c, id: id)
    }
    // width-less recovery: a form whose type came only from context (`0-1` in an
    // `I32` binding, `match{...}+1`) is type-less to the structural recovery but the
    // checker recorded its int context — use it so the op routes through the witness.
    // Read fresh (not cached) since exprIntCtx is filled during emission.
    if t.kind == 0 {
        if t.nameLen == 0 {
            val ctx: TypeInfo = exprIntCtxTypeInfo(c: inout c, id: id)
            if ctx.nameLen != 0 {
                return ctx
            }
        }
    }
    return t
}

// Reset the type cache (called at each function/closure body-emission entry). The
// (grounded) types cached during one body emission are only valid for that body's
// env, so they are discarded before the next — a node is re-typed per generic
// instantiation / per conforming type. Resets only the filled slots.
fn clearExprTyCache(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.exprTyFilled.count {
        c.exprTyKind[c.exprTyFilled[i]] = typeUnfilled()
        i += 1
    }
    val empty: Array[U64] = []
    c.exprTyFilled = empty
}

// The result type of an arithmetic/bitwise binary: the operands share a type, so
// return whichever side carries one (a struct/String/array result, a typed scalar,
// else the other operand). Lets a chained `0 - big - 1` recover I32 from `big`
// rather than from the untyped `0`.
fn binResultTypeInfo(c: inout Comp, lhs: U64, rhs: U64) -> TypeInfo {
    val lt: TypeInfo = exprType(c: inout c, id: lhs)
    if lt.kind != 0 {
        return lt
    }
    if lt.nameLen > 0 {
        return lt
    }
    return exprType(c: inout c, id: rhs)
}

// Recover an expression's type. Only the cases plewc.pw exercises on the base
// of a field/index/method are precise; everything else falls back to scalar.
fn exprType(c: inout Comp, id: U64) -> TypeInfo {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int(value: _, offset: _, val isBool, val tyStart, val tyLen, isNeg: _) => {
            // a `true`/`false` literal is `Bool`: recover a "Bool" span so a generic
            // call like `print(true)` infers T = Bool.
            if isBool {
                val b: Bind = kwSpan(c: inout c, kw: "Bool", kwLen: 4)
                if b.nameLen != 0 {
                    return <TypeInfo kind=0 nameStart=b.nameStart nameLen=b.nameLen ref=0 />
                }
            }
            // a suffixed literal (`5U64`) carries its own type; otherwise the
            // type comes from context and is recovered elsewhere.
            if tyLen != 0 {
                return typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false)
            }
            return scalarInfo()
        }
        Expr.Str(val start, val len) => {
            // carry the "String" name span so tyRefOfInfo can recover a String
            // TypeRef — a generic call `print("hi")` then infers T = String (without
            // the name, a string-literal argument left T uninferred -> no instance).
            val ss: Bind = stringTypeSpan(c: inout c)
            return <TypeInfo kind=1 nameStart=ss.nameStart nameLen=ss.nameLen ref=0 />
        }
        Expr.Ident(val start, val len) => {
            if isSelfRef(c: inout c, start: start, len: len) {
                if c.curRecvInstRef != 0 {
                    val rt: TypeRef = c.types[c.curRecvInstRef]
                    // self inside an `impl Array[T]` method types as an array (kind 3,
                    // element name) so the array/raw intrinsics dispatch on it.
                    if rangeEquals(bytes: c.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Array") {
                        if rt.args.count == 1 {
                            val en: Bind = arrayElemNameForRef(c: inout c, elemRef: rt.args[0])
                            return <TypeInfo kind=3 nameStart=en.nameStart nameLen=en.nameLen ref=c.curRecvInstRef />
                        }
                    }
                    return <TypeInfo kind=2 nameStart=rt.nameStart nameLen=rt.nameLen ref=c.curRecvInstRef />
                }
                return typeInfoOfName(c: inout c, start: c.curRecvStart, len: c.curRecvLen, isArray: false)
            }
            // inside a closure body a captured name is not a local; recover its
            // type from the capture entry (so field/index dispatch on it works).
            if c.curInClosure {
                mut val ci: U64 = 0
                while ci < c.captures.count {
                    val ce: CaptureEntry = c.captures[ci]
                    if ce.closureId == c.curClosureId {
                        if spansEqual(c: inout c, aStart: ce.nameStart, aLen: ce.nameLen, bStart: start, bLen: len) {
                            if isRefInst(c: inout c, ref: ce.ty) {
                                val rt2: TypeRef = c.types[ce.ty]
                                return <TypeInfo kind=2 nameStart=rt2.nameStart nameLen=rt2.nameLen ref=ce.ty />
                            }
                            return typeInfoOfName(c: inout c, start: ce.tyStart, len: ce.tyLen, isArray: ce.isArray)
                        }
                    }
                    ci += 1
                }
            }
            val qLocal: U64 = intern(c: inout c, start: start, len: len)
            mut val i: U64 = c.locals.count
            while i > 0 {
                i -= 1
                val lo: Local = c.locals[i]
                if lo.nameId == qLocal {
                    // an array local stays kind 3 (element by name) even though
                    // `Array[E]` is now a genInst struct — all the array-special
                    // codegen (index/for/.count/methods/value-semantics) keys off
                    // kind 3, so it must not be reported as a kind-2 instantiation.
                    if lo.isArray {
                        return typeInfoOfName(c: inout c, start: lo.tyStart, len: lo.tyLen, isArray: true)
                    }
                    if isGenericInst(c: inout c, ref: lo.ty) {
                        val lt: TypeRef = c.types[lo.ty]
                        return <TypeInfo kind=2 nameStart=lt.nameStart nameLen=lt.nameLen ref=lo.ty />
                    }
                    if isRefInst(c: inout c, ref: lo.ty) {
                        val lt2: TypeRef = c.types[lo.ty]
                        return <TypeInfo kind=2 nameStart=lt2.nameStart nameLen=lt2.nameLen ref=lo.ty />
                    }
                    // a RawBuffer[T] local: keep the structured ref so rawLoad can
                    // recover the element type T from its argument.
                    if isRawBufInst(c: inout c, ref: lo.ty) {
                        val lt3: TypeRef = c.types[lo.ty]
                        return <TypeInfo kind=2 nameStart=lt3.nameStart nameLen=lt3.nameLen ref=lo.ty />
                    }
                    // resolve a type-parameter-typed local under the active
                    // monomorphization env (so `x: T` reports as the concrete type
                    // for method dispatch inside a generic instance body).
                    if lo.isArray {
                    } else {
                        mut val k: U64 = 0
                        while k < c.curTypeParams.count {
                            val tp: Bind = c.curTypeParams[k]
                            if lo.tyNameId == tp.nameId {
                                return typeInfoOfRef(c: inout c, ref: c.curTypeArgs[k])
                            }
                            k += 1
                        }
                    }
                    return typeInfoOfName(c: inout c, start: lo.tyStart, len: lo.tyLen, isArray: lo.isArray)
                }
            }
            return scalarInfo()
        }
        Expr.Unary(val op, val operand) => {
            // A struct operand is a trait-dispatched unary (Neg/Not/BitNot); its
            // result is the trait's Output, which for standard operators is Self.
            val ot: TypeInfo = exprType(c: inout c, id: operand)
            if ot.kind == 2 { return ot }
            // `-` / `~` preserve the operand's width; `!` is Bool (width-less).
            if op == opSub() { return ot }
            if op == opBitNot() { return ot }
            return scalarInfo()
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            // Arithmetic (56-60) and bitwise/shift (74-78) take the operands' shared
            // type; comparisons (50-55) and logical (61,62) are Bool. Recover from
            // whichever operand carries a type — `0 - big` (lhs is an untyped literal)
            // is I32 from `big`, so a chained `0 - big - 1` propagates the width
            // instead of reporting it as type-less. Comparisons fall to scalar Bool.
            if op >= 56 {
                if op <= 60 {
                    return binResultTypeInfo(c: inout c, lhs: lhs, rhs: rhs)
                }
            }
            if op >= 74 {
                if op <= 78 {
                    return binResultTypeInfo(c: inout c, lhs: lhs, rhs: rhs)
                }
            }
            return scalarInfo()
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            // raw-memory floor: rawLoad returns the element type of its RawBuffer[T]
            // argument, rawCap returns U64, rawIsUnique returns Bool. rawAlloc's
            // result is always bound through an explicit RawBuffer[T] annotation, so
            // a scalar placeholder suffices here (never the source of the type).
            if isRawIntrinsicName(c: inout c, nameStart: nameStart, nameLen: nameLen) {
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawLoad") {
                    val bt: TypeInfo = exprType(c: inout c, id: args[0].expr)
                    if bt.ref < c.types.count {
                        val rb: TypeRef = c.types[bt.ref]
                        if rb.args.count == 1 {
                            return typeInfoOfRef(c: inout c, ref: rb.args[0])
                        }
                    }
                    return scalarInfo()
                }
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawCap") {
                    val u64: Bind = kwSpan(c: inout c, kw: "U64", kwLen: 3)
                    if u64.nameLen != 0 {
                        return <TypeInfo kind=0 nameStart=u64.nameStart nameLen=u64.nameLen ref=0 />
                    }
                }
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "rawIsUnique") {
                    val bl: Bind = kwSpan(c: inout c, kw: "Bool", kwLen: 4)
                    if bl.nameLen != 0 {
                        return <TypeInfo kind=0 nameStart=bl.nameStart nameLen=bl.nameLen ref=0 />
                    }
                }
                return scalarInfo()
            }
            // array intrinsics: arrayGet returns the element type of its `Array[T]`
            // argument, arrayLen returns U64 (arrayPush/arraySet return ()).
            if isArrayIntrinsicName(c: inout c, nameStart: nameStart, nameLen: nameLen) {
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayGet") {
                    val at: TypeInfo = exprType(c: inout c, id: args[0].expr)
                    return typeInfoOfName(c: inout c, start: at.nameStart, len: at.nameLen, isArray: false)
                }
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "arrayLen") {
                    val u64: Bind = kwSpan(c: inout c, kw: "U64", kwLen: 3)
                    if u64.nameLen != 0 {
                        return <TypeInfo kind=0 nameStart=u64.nameStart nameLen=u64.nameLen ref=0 />
                    }
                }
                return scalarInfo()
            }
            // (I/O builtins are ordinary `extern "plew-intrinsic"` declarations now,
            // so their return type comes from the resolved Func below — no special
            // cases here.)
            // resolve the right overload (by labels + arg types) for its return.
            val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
            if fi < c.funcs.count {
                val f: Func = c.funcs[fi]
                if f.hasRet {
                    // a generic free function returning a bare type parameter:
                    // substitute it with the inferred concrete type argument.
                    if isGenericFreeFn(c: inout c, fi: fi) {
                        if f.retIsArray {
                        } else {
                            val inferred: Array[U64] = inferFnArgs(c: inout c, f: f, args: args)
                            val qRet: U64 = intern(c: inout c, start: f.retStart, len: f.retLen)

                            mut val k: U64 = 0
                            while k < f.typeParams.count {
                                val tp: Bind = f.typeParams[k]
                                if qRet == tp.nameId {
                                    if k < inferred.count {
                                        if inferred[k] != 0 {
                                            return typeInfoOfRef(c: inout c, ref: inferred[k])
                                        }
                                    }
                                }
                                k += 1
                            }
                        }
                    }
                    // an `Array[E]` return stays kind 3 (handled below); only a true
                    // kind-2 instantiation (`Box[I32]`, an enum) reports as a genInst.
                    if f.retIsArray {
                    } else {
                        if isGenericInst(c: inout c, ref: f.retTy) {
                            val rtr: TypeRef = c.types[f.retTy]
                            return <TypeInfo kind=2 nameStart=rtr.nameStart nameLen=rtr.nameLen ref=f.retTy />
                        }
                    }
                    return typeInfoOfName(c: inout c, start: f.retStart, len: f.retLen, isArray: f.retIsArray)
                }
                return scalarInfo()
            }
            // a call to a fn-typed local (a closure value): its result type is the
            // function type's return (args[0] of the `fn` TypeRef). Without this a
            // generic call like `print(closure(x))` can't recover the arg type and
            // misses its instantiation (and `val r = closure(x)` mis-infers r).
            val lvi: U64 = localIndexByName(c: inout c, start: nameStart, len: nameLen)
            if lvi < c.locals.count {
                val lty: U64 = c.locals[lvi].ty
                if isFnType(c: inout c, ref: lty) {
                    val ftr: TypeRef = c.types[lty]
                    if ftr.args.count > 0 {
                        return typeInfoOfRef(c: inout c, ref: ftr.args[0])
                    }
                }
            }
            return scalarInfo()
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            // `String.bytes` is an `Array[U8]` view, so a chained `.count` /
            // index / `val bs = s.bytes` inference sees an array (else `.count`
            // wouldn't lower to `.len`). Recover a "U8" span to name the element.
            if bt.kind == 1 {
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "bytes") {
                    val u8: Bind = kwSpan(c: inout c, kw: "U8", kwLen: 2)
                    if u8.nameLen != 0 {
                        return <TypeInfo kind=3 nameStart=u8.nameStart nameLen=u8.nameLen ref=0 />
                    }
                }
            }
            // `arr.count` is U64 (spec/02). Recover a "U64" span so a generic call
            // like `print(arr.count)` infers T = U64.
            if bt.kind == 3 {
                if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "count") {
                    val u64: Bind = kwSpan(c: inout c, kw: "U64", kwLen: 3)
                    if u64.nameLen != 0 {
                        return <TypeInfo kind=0 nameStart=u64.nameStart nameLen=u64.nameLen ref=0 />
                    }
                }
            }
            // a generic struct instantiation's field type is substituted.
            if isGenericInst(c: inout c, ref: bt.ref) {
                return genericFieldTypeInfo(c: inout c, instRef: bt.ref, fieldStart: nameStart, fieldLen: nameLen)
            }
            if bt.kind == 2 {
                return fieldType(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
            }
            return scalarInfo()
        }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            if isGenericInst(c: inout c, ref: ty) {
                return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen ref=ty />
            }
            return <TypeInfo kind=2 nameStart=typeStart nameLen=typeLen ref=0 />
        }
        Expr.Array(val elems) => { return scalarInfo() }
        Expr.Index(val base, val index) => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 3 {
                // nested array: if the element is itself an `Array[X]`, indexing
                // yields an array (kind 3) whose element is X — not a kind-2 value
                // named by the mangled element name.
                val er: U64 = arrayElemRef(c: inout c, start: bt.nameStart, len: bt.nameLen)
                if er != 0 {
                    val rr: U64 = resolveTy(c: inout c, tyRef: er)
                    if rr < c.types.count {
                        val rt: TypeRef = c.types[rr]
                        if rangeEquals(bytes: c.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Array") {
                            if rt.args.count > 0 {
                                val xn: Bind = arrayElemNameForRef(c: inout c, elemRef: rt.args[0])
                                return <TypeInfo kind=3 nameStart=xn.nameStart nameLen=xn.nameLen ref=0 />
                            }
                        }
                        // a compound element (`Ref[Cell]`, `Box[I32]`): carry its
                        // structured ref so `arr[i]->field` / a generic field access
                        // can recover the pointee/instantiation (typeInfoOfRef would
                        // drop the ref for a non-Array compound). Only for compound
                        // elements — a simple scalar element (`U8`) must stay scalar.
                        if isCompoundType(c: inout c, ref: rr) {
                            return <TypeInfo kind=2 nameStart=rt.nameStart nameLen=rt.nameLen ref=rr />
                        }
                    }
                }
                return typeInfoOfName(c: inout c, start: bt.nameStart, len: bt.nameLen, isArray: false)
            }
            // `dict[k]` yields the Dictionary's value type V (args[1]) — the subscript
            // desugars to `.at(key:) -> V`.
            if isDictionaryType(c: inout c, ti: bt) {
                val dt: TypeRef = c.types[bt.ref]
                if dt.args.count > 1 {
                    return typeInfoOfRef(c: inout c, ref: dt.args[1])
                }
            }
            return scalarInfo()
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            // `Type.name(args)` assoc-fn call: return type from the assoc fn.
            val arn: Bind = assocRecvName(c: inout c, recv: recv)
            if arn.nameLen != 0 {
                val afi: U64 = findAssoc(c: inout c, recvStart: arn.nameStart, recvLen: arn.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if afi == c.funcs.count {
                    return scalarInfo()
                }
                val af: Func = c.funcs[afi]
                if af.hasRet {
                    return typeInfoOfName(c: inout c, start: af.retStart, len: af.retLen, isArray: af.retIsArray)
                }
                return scalarInfo()
            }
            mut val rt: TypeInfo = exprType(c: inout c, id: recv)
            // a String value method's receiver: recover "String" so the method
            // resolves (exprType carries no name span for String).
            if rt.kind == 1 {
                val ss: Bind = stringTypeSpan(c: inout c)
                if ss.nameLen != 0 {
                    rt = <TypeInfo kind=2 nameStart=ss.nameStart nameLen=ss.nameLen ref=0 />
                }
            }
            // wrapping arithmetic on an integer receiver yields the receiver's type
            // (`x.wrappingMul(by: y): U64` when x: U64) — a privileged lowering with
            // no real fn, so its type is recovered here (see Expr.pw codegen).
            if isWrappingMethod(c: inout c, nameStart: nameStart, nameLen: nameLen) {
                if isIntType(c: inout c, start: rt.nameStart, len: rt.nameLen) {
                    return rt
                }
            }
            if rt.kind == 2 {
                val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if mi == c.funcs.count {
                    return scalarInfo()
                }
                val mf: Func = c.funcs[mi]
                if mf.hasRet {
                    // a generic method (`impl[T] Box[T] { fn get() -> T }`) returning
                    // a type parameter: substitute it with the receiver's concrete
                    // instantiation argument (else `box.get()` types as the bare `T`).
                    if isGenericInst(c: inout c, ref: rt.ref) {
                        val gt: TypeRef = c.types[rt.ref]
                        val gsi: U64 = genericStructIndex(c: inout c, nameStart: gt.nameStart, nameLen: gt.nameLen)
                        if gsi < c.structs.count {
                            // ground the return type through the receiver's instantiation
                            // AND the method's own type params (a combinator on a generic
                            // receiver: `filterIter.map(f) -> MapIter[Self, …, B]`). The
                            // env is the receiver's args (first rcount) plus the method-own
                            // args inferred from the call; Self/Item resolve to the receiver
                            // inst and its element (else the chain's loop var types as the
                            // literal `Item`/`B`).
                            setSelfItemEnv(c: inout c, recvStart: gt.nameStart, recvLen: gt.nameLen, recvInstRef: rt.ref)
                            val gSavedP: Array[Bind] = c.curTypeParams
                            val gSavedA: Array[U64] = c.curTypeArgs
                            val rcount: U64 = c.structs[gsi].typeParams.count
                            mut val gfa: Array[U64] = []
                            mut val gri: U64 = 0
                            while gri < rcount {
                                if gri < gt.args.count {
                                    gfa.append(gt.args[gri])
                                }
                                gri += 1
                            }
                            if mf.typeParams.count > rcount {
                                val ginf: Array[U64] = inferFnArgs(c: inout c, f: mf, args: args)
                                mut val goi: U64 = rcount
                                while goi < ginf.count {
                                    gfa.append(ginf[goi])
                                    goi += 1
                                }
                            }
                            c.curTypeParams = mf.typeParams
                            c.curTypeArgs = gfa
                            val gr: U64 = groundTypeRef(c: inout c, ref: mf.retTy)
                            c.curTypeParams = gSavedP
                            c.curTypeArgs = gSavedA
                            clearSelfItemEnv(c: inout c)
                            return typeInfoOfRef(c: inout c, ref: gr)
                        }
                        val gei: U64 = genericEnumIndex(c: inout c, nameStart: gt.nameStart, nameLen: gt.nameLen)
                        if gei < c.enums.count {
                            return substTypeInfo(c: inout c, instRef: rt.ref, params: c.enums[gei].typeParams, tyRef: mf.retTy)
                        }
                    }
                    // a non-generic receiver whose method returns a generic instantiation
                    // (`Counter.next() -> Optional[I64]`): keep the full ref so the caller
                    // (a `match` scrutinee / `for` iterand) recovers the mangled
                    // `Optional_I64`, not the bare head. Ground `Self`/`Item` first so a
                    // provided combinator (`Counter.filter() -> FilterIter[Self,…,Item]`)
                    // yields `FilterIter[Counter,…,I64]`, not the literal template.
                    if isGenericInst(c: inout c, ref: mf.retTy) {
                        setSelfItemEnv(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, recvInstRef: 0)
                        // a generic method (`Counter.map[B]`): bind its method-own type
                        // params from the call (B from the closure arg) so the return
                        // `MapIter[Self,…,B]` grounds to `MapIter[Counter,…,I64]`.
                        val savedTP: Array[Bind] = c.curTypeParams
                        val savedTA: Array[U64] = c.curTypeArgs
                        if mf.typeParams.count > 0 {
                            c.curTypeParams = mf.typeParams
                            c.curTypeArgs = inferFnArgs(c: inout c, f: mf, args: args)
                        }
                        val gr2: U64 = groundTypeRef(c: inout c, ref: mf.retTy)
                        c.curTypeParams = savedTP
                        c.curTypeArgs = savedTA
                        clearSelfItemEnv(c: inout c)
                        return typeInfoOfRef(c: inout c, ref: gr2)
                    }
                    return typeInfoOfName(c: inout c, start: mf.retStart, len: mf.retLen, isArray: mf.retIsArray)
                }
                return scalarInfo()
            }
            if rt.kind == 3 {
                // a user method on `Array[E]` (`impl[T] Array[T] { … }`): resolve via
                // the "Array" receiver, then substitute a return type that is exactly
                // the type parameter T with the array's element type E.
                val arrName: Bind = kwSpan(c: inout c, kw: "Array", kwLen: 5)
                val mi: U64 = findMethod(c: inout c, recvStart: arrName.nameStart, recvLen: arrName.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
                if mi == c.funcs.count {
                    return scalarInfo()
                }
                val mf: Func = c.funcs[mi]
                if mf.hasRet {
                    if mf.typeParams.count >= 1 {
                        if mf.retTy < c.types.count {
                            val rtt: TypeRef = c.types[mf.retTy]
                            if rtt.nameId == mf.typeParams[0].nameId {
                                return typeInfoOfName(c: inout c, start: rt.nameStart, len: rt.nameLen, isArray: false)
                            }
                        }
                    }
                    return typeInfoOfName(c: inout c, start: mf.retStart, len: mf.retLen, isArray: mf.retIsArray)
                }
                return scalarInfo()
            }
            return scalarInfo()
        }
        Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
            return typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false)
        }
        Expr.MatchExpr(val scrut, val arms) => {
            if arms.count > 0 {
                return exprType(c: inout c, id: arms[0].body)
            }
            return scalarInfo()
        }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            val g: U64 = blockGiveExpr(c: inout c, blkId: thenBlk)
            if g < c.exprs.count {
                return exprType(c: inout c, id: g)
            }
            return scalarInfo()
        }
        Expr.Try(val expr) => {
            // result type = the Result's Ok payload T (args[0] of Result[T, E]).
            val rt: TypeInfo = exprType(c: inout c, id: expr)
            if isGenericInst(c: inout c, ref: rt.ref) {
                val inst: TypeRef = c.types[rt.ref]
                if inst.args.count > 0 {
                    return typeInfoOfRef(c: inout c, ref: inst.args[0])
                }
            }
            return scalarInfo()
        }
        Expr.Arrow(val base, val nameStart, val nameLen) => {
            // pointee field type: base is Ref[T]; resolve T then T's field.
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if isRefInst(c: inout c, ref: bt.ref) {
                val inst: TypeRef = c.types[bt.ref]
                val pt: TypeInfo = typeInfoOfRef(c: inout c, ref: inst.args[0])
                if pt.kind == 2 {
                    return fieldType(c: inout c, structStart: pt.nameStart, structLen: pt.nameLen, fieldStart: nameStart, fieldLen: nameLen)
                }
            }
            return scalarInfo()
        }
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
            // a closure literal's type is `fn(params) -> ret`; recover it so a
            // generic call can structurally infer a type parameter from it
            // (`map(f: fn(x:I64)->I64)` -> B = I64).
            return typeInfoOfRef(c: inout c, ref: closureFnTypeRef(c: inout c, params: params, retTy: retTy))
        }
        Expr.Move(val operand, val isBorrow) => {
            // `move`/`borrow` have the operand's type (the value just flows).
            return exprType(c: inout c, id: operand)
        }
        Expr.Await(val operand) => {
            // `await e` (e: Promise[T]) yields T: recover the operand's generic
            // type argument. A value-less Promise[()] (args empty) yields a scalar.
            val ot: TypeInfo = exprType(c: inout c, id: operand)
            if ot.ref != 0 {
                val tr: TypeRef = c.types[ot.ref]
                if tr.args.count > 0 {
                    return typeInfoOfRef(c: inout c, ref: tr.args[0])
                }
            }
            return scalarInfo()
        }
    }
    return scalarInfo()
}

// The value expression of the last `give` in a block (the block's result), or
// `c.exprs.count` (one past the end) if the block has no `give`. A U64 sentinel
// keeps callers off signed indices. Used to infer a value-position `if`'s type.
fn blockGiveExpr(c: inout Comp, blkId: U64) -> U64 {
    val blk: Block = c.blocks[blkId]
    val stmts: Array[U64] = blk.stmts
    mut val i: U64 = 0
    mut val found: U64 = c.exprs.count
    while i < stmts.count {
        val s: Stmt = c.stmts[stmts[i]]
        match s {
            Stmt.Give(val value) => { found = value }
            _ => {}
        }
        i += 1
    }
    return found
}

// The result type of a value-position block (if/match expression): the type of its
// `give` expression. The give may name a local declared earlier in the same block
// (`if c { val x = …; give x }`), so pre-register the block's `let`s before reading
// the give's type, then pop them — genBlock re-declares them when it actually emits.
// Without this peek a give-of-a-block-local resolves to a bogus scalar type.
fn blockGiveType(c: inout Comp, blkId: U64) -> TypeInfo {
    val mark: U64 = scopeMark(c: inout c)
    val blk: Block = c.blocks[blkId]
    val stmts: Array[U64] = blk.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        match c.stmts[stmts[i]] {
            Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
                addLocalCn(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, ty: ty, isInout: false, isMut: mutable, owned: true, cnum: 0)
            }
            _ => {}
        }
        i += 1
    }
    val g: U64 = blockGiveExpr(c: inout c, blkId: blkId)
    mut val rt: TypeInfo = scalarInfo()
    if g < c.exprs.count {
        rt = typeOf(c: inout c, id: g)
    }
    popLocals(c: inout c, mark: mark)
    return rt
}

// Register a match-bound field as an in-scope local with its declared type.
// Register a match-bound field as an in-scope local. The field is found by
// (fieldStart,fieldLen); the local is named (bindStart,bindLen) — equal for
// punning, different for a `field: val name` rename.
fn addBindLocal(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, fieldStart: U64, fieldLen: U64, bindStart: U64, bindLen: U64) {
    addBindLocalCn(c: inout c, enumStart: enumStart, enumLen: enumLen, variantStart: variantStart, variantLen: variantLen, fieldStart: fieldStart, fieldLen: fieldLen, bindStart: bindStart, bindLen: bindLen, cnum: 0)
}

// Like addBindLocal but with an explicit C-name disambiguator (async frame
// fields use a monotonic suffix so repeated match-bind names across arms don't
// collide in the flat frame struct).
fn addBindLocalCn(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, fieldStart: U64, fieldLen: U64, bindStart: U64, bindLen: U64, cnum: U64) {
    val qEnum: U64 = intern(c: inout c, start: enumStart, len: enumLen)
    val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
    val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.nameId == qEnum {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if v.nameId == qVar {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if f.nameId == qField {
                            addLocalCn(c: inout c, nameStart: bindStart, nameLen: bindLen, tyStart: f.tyStart, tyLen: f.tyLen, isArray: f.tyIsArray, ty: f.ty, isInout: false, isMut: false, owned: false, cnum: cnum)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
}

// Emit the C type of a match-bound field (looked up in the enum declaration).
fn genBindType(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64, bindStart: U64, bindLen: U64) {
    val qEnum: U64 = intern(c: inout c, start: enumStart, len: enumLen)
    val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
    val qBind: U64 = intern(c: inout c, start: bindStart, len: bindLen)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        val e: EnumDef = c.enums[ei]
        if e.nameId == qEnum {
            val vars: Array[Variant] = e.variants
            mut val vi: U64 = 0
            while vi < vars.count {
                val v: Variant = vars[vi]
                if v.nameId == qVar {
                    val fs: Array[FieldDef] = v.fields
                    mut val fi: U64 = 0
                    while fi < fs.count {
                        val f: FieldDef = fs[fi]
                        if f.nameId == qBind {
                            genCTypeRef(c: inout c, start: f.tyStart, len: f.tyLen, isArray: f.tyIsArray)
                            return
                        }
                        fi += 1
                    }
                }
                vi += 1
            }
        }
        ei += 1
    }
    write(s: "long long")
}

