// Part of the Plew compiler module (root: _.pw). The compile driver:
// `runFrontend()` runs the emission-independent front-end (load -> check ->
// monomorphize -> typed-AST cache -> acceptance pass) and returns the analyzed
// arena; the root `main` then hands it to `emitLlvm()` (Backend/Llvm). Kept
// separate from emission so the front-end stays reusable and backend-agnostic.

// Build and return the fully-analyzed compiler arena: parse-driven module loading,
// derive synthesis, all soundness/visibility checks, monomorphization discovery,
// and the typed-AST cache. Backend-agnostic — no LLVM emission happens here.
fn runFrontend() -> Comp {
    // gen mode (spec/16): `plewc --gen <file>` synthesizes a derive-runner harness
    // instead of compiling the user program. The entry path then sits at argv[2].
    mut val genMode: Bool = false
    mut val tcLog: Bool = false
    mut val entryArgIdx: I64 = 1
    if argCount() > 1 {
        if argAt(1) == "--gen" {
            genMode = true
            entryArgIdx = 2
        }
        // `plewc --tc-log <file>`: run the new TypeRef-based type checker in
        // log-only mode (print mismatches, reject nothing) for development/triage.
        if argAt(1) == "--tc-log" {
            tcLog = true
            entryArgIdx = 2
        }
    }
    // The compiler arena. The loader below fills `bytes`/`moduleRanges` and lowers
    // every item into it: PARSE-DRIVEN LOADING — each file's source is appended to
    // `c.bytes`, parsed by the shared @Std/Syntax parser, its items lowered, and its
    // `import`/`part` nodes followed to more files. There is no separate directive
    // pre-scan: the parsed tree drives discovery. (`bytes` is built incrementally, so
    // a file's source sits at `fileStart` before its items lower, and re-interned
    // names land in between — harmless: writeSpan emits text, moduleOf uses the
    // per-file ranges. `toks`/`pos` are unused now that all parsing is per-file.)
    mut val c: Comp = <Comp bytes=[] exprs=[] stmts=[] blocks=[] funcs=[] structs=[] enums=[] traits=[] conforms=[] methodAliases=[] defaultExts=[] derives=[] pendingDerives=[] funcBounds=[] curCheckFn=0 curWitnessed=[] curWhereTraits=[] types=[] genInsts=[] fnInsts=[] fnTypes=[] fnThunks=[] captures=[] curClosureId=0 curInClosure=false curCaptureMark=0 arrayElems=[] locals=[] tmp=0 curIsMain=false curRetVoid=false curRetStart=0 curRetLen=0 curRetIsArray=false curRetTy=0 curHasRecv=false curRecvStart=0 curRecvLen=0 curSelfInout=false curSelfMove=false curTypeParams=[] curTypeArgs=[] curRecvInstRef=0 curGiveTmp=0 curLoopMark=0 curBranchBase=0 deinits=[] curAsync=false asyncState=0 curAsyncFn=0 asyncVarSeq=0 moduleRanges=[] exports=[] imports=[] />
    // reserve TypeRef index 0 as the "no type" sentinel so a `ty` field of 0
    // (synthetic locals, untyped positions) never aliases a real parsed type.
    c.types.append(<TypeRef nameStart=0 nameLen=0 args=[] />)
    // reserve Block index 0 as a dummy so a `body` field of 0 is an unambiguous
    // "no body" sentinel (extern fns, trait-requirement signatures). Without this,
    // the first function body lowered (the entry file, which loads before the
    // ambient Prelude) would land at block 0 and be indistinguishable from no body
    // — wrongly skipped by the body-walks that gate on `body != 0`.
    c.blocks.append(<Block stmts=[] />)
    c.genMode = genMode
    c.tcLog = tcLog
    mut val nextModuleId: U64 = 1
    if argCount() > entryArgIdx {
        // Module loader: a recursive, deduplicated worklist over local includes.
        // Each file's `part`/`import` paths resolve relative to that file's own
        // directory; every distinct file is appended once (single-arena / single-C).
        val rootPath: String = argAt(entryArgIdx)
        val entryBytes: Array[U8] = rootPath.bytes
        // Loud-fail on a missing entry file: without this readFileBytes returns an
        // empty string and the compiler silently emits an empty program (exit 0),
        // which hides a typo'd path. (Acceptance soundness: never silently accept.)
        if fileExists(path: entryBytes) {
        } else {
            eprint(text: "plewc: error: cannot open source file: ")
            eprint(text: rootPath)
            eprint(text: "\n")
            exit(code: 1)
        }
        mut val pathBuf: Array[U8] = []
        mut val loaded: Array[Bind] = []
        // `loaded[i].fieldStart` carries each queued file's module id.
        // package src root for `/…` absolute imports (from the Plew.toml walk-up;
        // empty if no manifest is found, in which case `/…` imports are skipped).
        val srcRoot: Array[U8] = findSrcRoot(entry: entryBytes)
        // std library root for `@Std/…`: the `std/` directory next to the plewc
        // binary (argv[0]'s directory), so `@Std/Core` -> `<plewcdir>/std/Core.pw`.
        val stdRoot: Array[U8] = computeStdRoot(arg0: argAt(0).bytes)
        val es: U64 = pathBuf.count
        appendBytes(into: inout pathBuf, from: entryBytes)
        loaded.append(<Bind nameStart=es nameLen=entryBytes.count fieldStart=0 fieldLen=entryBytes.count />)
        // Force-load @Std/Core so its lang-item types (Optional/Result/Ordering),
        // operator traits + witnesses, and Iterator/Index machinery are AMBIENT
        // (spec/15: usable without `import` — `2 + 3`, `Optional`, `for` need none).
        // Its `part Core/Num.pw` + imports are followed by the BFS; a target that also
        // `import @Std/Core`s dedups via pathSeen. A Core free function like `assert`
        // still needs an explicit import — checkUseVisibility gates it as an ordinary
        // cross-module call (only types/operators are ambient, not free functions).
        mut val corePath: Array[U8] = []
        appendBytes(into: inout corePath, from: stdRoot)
        appendBytes(into: inout corePath, from: "Core.pw".bytes)
        if fileExists(path: corePath) {
            val cps: U64 = pathBuf.count
            appendBytes(into: inout pathBuf, from: corePath)
            loaded.append(<Bind nameStart=cps nameLen=corePath.count fieldStart=nextModuleId fieldLen=corePath.count />)
            nextModuleId = nextModuleId + 1
        }
        // gen mode: force-load @Std/Io as its own module so the synthesized harness
        // `main` can call `write` even if the target file doesn't import it.
        if genMode {
            mut val ioPath: Array[U8] = []
            appendBytes(into: inout ioPath, from: stdRoot)
            appendBytes(into: inout ioPath, from: "Io.pw".bytes)
            if fileExists(path: ioPath) {
                val ios: U64 = pathBuf.count
                appendBytes(into: inout pathBuf, from: ioPath)
                loaded.append(<Bind nameStart=ios nameLen=ioPath.count fieldStart=nextModuleId fieldLen=ioPath.count />)
                nextModuleId = nextModuleId + 1
            }
            // force-load @Std/Syntax too: the harness calls `parseItem` and the derive
            // interfaces / built-in derivers (`impl Hash as Derive`) live there. Its
            // `part`s + `import @Std/Core` are followed by the BFS below; a target file
            // that also imports it dedups via pathSeen.
            mut val synPath: Array[U8] = []
            appendBytes(into: inout synPath, from: stdRoot)
            appendBytes(into: inout synPath, from: "Syntax.pw".bytes)
            if fileExists(path: synPath) {
                if pathSeen(buf: pathBuf, loaded: loaded, path: synPath) {
                } else {
                    val sys: U64 = pathBuf.count
                    appendBytes(into: inout pathBuf, from: synPath)
                    loaded.append(<Bind nameStart=sys nameLen=synPath.count fieldStart=nextModuleId fieldLen=synPath.count />)
                    nextModuleId = nextModuleId + 1
                }
            }
        }
        mut val qi: U64 = 0
        while qi < loaded.count {
            val ent: Bind = loaded[qi]
            qi += 1
            val moduleId: U64 = ent.fieldStart
            val path: Array[U8] = extractSpan(buf: pathBuf, start: ent.nameStart, len: ent.nameLen)
            val src: String = readFileBytes(path)
            val sb: Array[U8] = src.bytes
            if c.bytes.count > 0 {
                c.bytes.append(10)
            }
            val fileStart: U64 = c.bytes.count
            c.appendSrc(from: sb)
            c.moduleRanges.append(<Bind nameStart=fileStart nameLen=c.bytes.count - fileStart fieldStart=moduleId fieldLen=0 />)
            // parse the file and lower its items; the returned tree drives discovery.
            val items: Array[TopItemAst] = parseAndLowerFile(c: inout c, fileBytes: sb, fileStart: fileStart)
            val baseLen: U64 = dirPrefixLen(path: path)
            // follow `import`/`part` nodes to child files (in source order); note a
            // `@[...]` directive so the generated sibling can be auto-parted.
            mut val sawDirective: Bool = false
            mut val ii: U64 = 0
            while ii < items.count {
                match items[ii] {
                    TopItemAst.Import(val imp) => {
                        val childPath: Array[U8] = resolveImport(src: c.bytes, pStart: imp.pathSpan.start, pLen: imp.pathSpan.end - imp.pathSpan.start, importer: path, baseLen: baseLen, srcRoot: srcRoot, srcRootLen: srcRoot.count, stdRoot: stdRoot, stdRootLen: stdRoot.count)
                        if childPath.count == 0 {
                        } else {
                            if pathSeen(buf: pathBuf, loaded: loaded, path: childPath) {
                            } else {
                                // a `part` (isImport=false) joins this module; an
                                // `import` (true) starts a fresh module.
                                mut val childModule: U64 = moduleId
                                if imp.isImport {
                                    childModule = nextModuleId
                                    nextModuleId = nextModuleId + 1
                                }
                                val cs: U64 = pathBuf.count
                                appendBytes(into: inout pathBuf, from: childPath)
                                loaded.append(<Bind nameStart=cs nameLen=childPath.count fieldStart=childModule fieldLen=childPath.count />)
                            }
                        }
                    }
                    TopItemAst.Directive(val dir) => { sawDirective = true }
                    _ => {}
                }
                ii += 1
            }
            // auto-part (spec/16): a file annotated with `@[...]` pulls in its
            // generated sibling `<file>.gen.pw` as a part of the same module (when it
            // exists); suppressed in gen mode, which is producing that sibling.
            if genMode {
            } else {
                if sawDirective {
                    val genPath: Array[U8] = genSiblingPath(path: path)
                    if genPath.count == 0 {
                    } else {
                        if fileExists(path: genPath) {
                            if pathSeen(buf: pathBuf, loaded: loaded, path: genPath) {
                            } else {
                                val gs: U64 = pathBuf.count
                                appendBytes(into: inout pathBuf, from: genPath)
                                loaded.append(<Bind nameStart=gs nameLen=genPath.count fieldStart=moduleId fieldLen=genPath.count />)
                            }
                        }
                    }
                }
            }
        }
    } else {
        val s: String = readStdin()
        val fileStart: U64 = c.bytes.count
        c.appendSrc(from: s.bytes)
        c.moduleRanges.append(<Bind nameStart=fileStart nameLen=c.bytes.count - fileStart fieldStart=0 fieldLen=0 />)
        val items: Array[TopItemAst] = parseAndLowerFile(c: inout c, fileBytes: s.bytes, fileStart: fileStart)
    }
    // Auto-load the implicit prelude (the ambient Array methods) as its own module,
    // appended + lowered last. It lives next to the binary at `std/Prelude.pw` and
    // needs no `import` — like the `Array` lang-item type, its methods are always in
    // scope. Skipped if absent (a freshly-seeded compiler still builds).
    mut val prelPath: Array[U8] = []
    appendBytes(into: inout prelPath, from: computeStdRoot(arg0: argAt(0).bytes))
    appendBytes(into: inout prelPath, from: "Prelude.pw".bytes)
    if fileExists(path: prelPath) {
        val prelSrc: String = readFileBytes(prelPath)
        if c.bytes.count > 0 {
            c.bytes.append(10)
        }
        val prelStart: U64 = c.bytes.count
        c.appendSrc(from: prelSrc.bytes)
        c.moduleRanges.append(<Bind nameStart=prelStart nameLen=c.bytes.count - prelStart fieldStart=nextModuleId fieldLen=0 />)
        nextModuleId = nextModuleId + 1
        val items: Array[TopItemAst] = parseAndLowerFile(c: inout c, fileBytes: prelSrc.bytes, fileStart: prelStart)
    }
    // built-in-name span cache (kwSpan): append the lang-item names at known
    // offsets so type recovery can name `String`/`U64`/`Array`/… without scanning
    // the source. Before any analysis (which calls kwSpan via exprType).
    buildKwCache(c: inout c)
    // derive (#5): synthesize `@[Eq]`/`@[Ord]` witnesses before any analysis.
    synthesizeDerives(c: inout c)
    // blanket trait impls (spec/08): `impl[T] T as Show where T: Named` makes
    // every Named type conform to Show; copy the methods onto each qualifying
    // concrete type (before provided methods, so the trait's own provided
    // methods also reach the newly-conforming types).
    instantiateBlanketImpls(c: inout c)
    // trait provided methods (spec/08): copy each `impl Trait { }` provided
    // method onto every conforming type, so they ride normal method resolution.
    instantiateProvidedMethods(c: inout c)
    // defaultExtension collisions (spec/09): a default extension's method must not
    // share a selector with the type's own / provided / another default extension's
    // method (they would both join bare resolution). Loud at the declaration.
    checkDefaultExtCollisions(c: inout c)
    // recursive value types (spec/03): mark fields that close a containment cycle
    // onto their owner; codegen stores them behind a heap pointer so the C type is
    // finite (hidden indirection; value semantics kept by deref-read/repoint-write).
    markBoxedFields(c: inout c)
    // ownership validity (spec/03): a struct owning a unique value must be
    // `unique`; parameter access modes must match copyability. Both exit on error.
    checkFieldContagion(c: inout c)
    checkFieldDefaults(c: inout c)
    checkParamDefaults(c: inout c)
    checkAllParamModes(c: inout c)
    checkArrayElemsNotUnique(c: inout c)
    // match pattern soundness (spec/11): a variant/struct pattern must name real
    // fields (else codegen emits `_m.data.V.<missing>` -> broken C). Loud-reject.
    checkMatchBinds(c: inout c)
    // missing-return (spec/11): a non-`()` function must return/panic/diverge on
    // every path — Plew does not implicitly return the tail expression, so falling
    // off the end would silently yield uninitialized memory.
    checkReturns(c: inout c)
    // trait conformance is explicit and complete (spec/08): every requirement of
    // each `impl Type as Trait` must be witnessed (a body method or a `via` alias).
    checkConformances(c: inout c)
    // existential formation (spec/08): `any P` is supported only over a trait with
    // no type args / associated types in this increment (else loud-reject).
    checkAnyFormation(c: inout c)
    // additional spec-fidelity checks (trait/generics audit): reject a generic vs
    // another same-selector overload, methods on built-in types, and `move fn` on
    // a copyable receiver.
    checkOverloadCollisions(c: inout c)
    checkImplOnBuiltin(c: inout c)
    checkMoveFnReceivers(c: inout c)
    // module visibility (spec/15): a name brought in by `import … with { }` must be
    // part of its module's public surface (`export`). Importing from the wrong
    // module also fails here — that module doesn't get loaded, so the name isn't
    // among the exported (loaded) declarations.
    checkImports(c: inout c)
    checkUseVisibility(c: inout c)
    // gen mode (spec/16): replace the program with the synthesized derive-runner
    // harness `main`. Added after the user-code checks (so its synthetic call to
    // `deriveFromSource`/`write` is exempt from import hygiene) and before
    // instantiation discovery (so its `print`/method instances are emitted).
    if c.genMode {
        synthGenMain(c: inout c)
    }
    // discover concrete generic instantiations to monomorphize.
    collectGenInsts(c: inout c)
    // discover concrete instantiations of generic free functions from call sites
    // (each emitted as a specialized C function `f_<arg-mangle>`).
    collectFnInsts(c: inout c)
    // discover bare function-value references (need a closure-ABI thunk each).
    collectFnThunks(c: inout c)
    // enforce `where T: Trait` bounds (spec/08): each instantiation's concrete
    // type argument must conform to the trait its parameter is bound to.
    checkFnBounds(c: inout c)
    // eager generic type-check (#9): every generic template body is checked once
    // against its `where` bounds — a method/operator on a type parameter must be
    // provided by its bounds (no C++-style "errors only at instantiation").
    checkGenericBodies(c: inout c)
    // unique types cannot be generic type arguments (wrap in Ref[T]); checked
    // after instantiation discovery since it scans the concrete genInsts.
    checkGenericUniqueArgs(c: inout c)
    // typed-AST cache (Phase B): one type slot per expression node, filled lazily
    // by `typeOf` during non-generic emission. Built now — expr ids are stable.
    buildExprTyTable(c: inout c)
    // backend-independent acceptance pass (spec/15): run the per-expr/stmt checks
    // that were historically done inline during emission (rebuilding the local
    // symbol table as it walks), so acceptance soundness does not depend on how
    // emission works. Runs AFTER the typed-AST cache so the operator-witness /
    // visibility checks see recovered expression types.
    verifyProgram(c: inout c)
    return c
}

