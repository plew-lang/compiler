// --- Phase D: literal context typing -------------------------------------
// Spec: integer literals have no default type; their type comes from context
// (annotation / field / param / return / array element / sibling operand). A
// literal that does not fit its context type is rejected, and a constant
// expression that overflows its type is rejected at compile time. checkLit*
// is a pure validation pass (emits compileError; does not change the C output).

// A folded constant integer: non-negative magnitude `value` (U64) plus a `neg`
// sign, mirroring the literal model (Expr.Int is a magnitude; `-` is a Unary).
struct ConstInt {
    pub val isConst: Bool
    pub val neg: Bool
    pub val value: U64
}

fn notConst() -> ConstInt {
    return <ConstInt isConst=false neg=false value=0 />
}

// Build a ConstInt, normalizing -0 to +0.
fn mkConst(neg: Bool, mag: U64) -> ConstInt {
    if mag == 0 { return <ConstInt isConst=true neg=false value=0 /> }
    return <ConstInt isConst=true neg=neg value=mag />
}

// (na,a) + (nb,b) as a signed magnitude, or notConst if the result magnitude
// would exceed the fold domain (2^63-1; keeps every magnitude expressible).
fn addConst(na: Bool, a: U64, nb: Bool, b: U64) -> ConstInt {
    if na == nb {
        if a > 9223372036854775807U64 - b { return notConst() }
        return mkConst(neg: na, mag: a + b)
    }
    if a >= b { return mkConst(neg: na, mag: a - b) }
    return mkConst(neg: nb, mag: b - a)
}

// Fold a constant integer expression (literals, unary `-`, and `+ - *`). Lets us
// catch constant overflow whose individual leaves each fit but whose result does
// not (`val f: U8 = 200 + 100`). Other operators yield non-const (leaf checks
// still apply). The fold works in a signed magnitude bounded by 2^63-1; a leaf
// or intermediate beyond that yields non-const (the per-leaf range check still
// applies), so the fold never needs an unrepresentable bound.
fn foldConst(c: inout Comp, id: U64) -> ConstInt {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int(val value, offset: _, val isBool, tyStart: _, tyLen: _, val isNeg) => {
            if isBool { return notConst() }
            if value > 9223372036854775807U64 { return notConst() }
            return mkConst(neg: isNeg, mag: value)
        }
        Expr.Unary(val op, val operand) => {
            if op == opSub() {
                val o: ConstInt = foldConst(c: inout c, id: operand)
                if o.isConst { return mkConst(neg: !o.neg, mag: o.value) }
            }
            return notConst()
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            val a: ConstInt = foldConst(c: inout c, id: lhs)
            val b: ConstInt = foldConst(c: inout c, id: rhs)
            if a.isConst {
                if b.isConst {
                    if op == opAdd() { return addConst(na: a.neg, a: a.value, nb: b.neg, b: b.value) }
                    if op == opSub() { return addConst(na: a.neg, a: a.value, nb: !b.neg, b: b.value) }
                    if op == opMul() {
                        if a.value == 0 { return mkConst(neg: false, mag: 0) }
                        if b.value > 9223372036854775807U64 / a.value { return notConst() }
                        return mkConst(neg: a.neg != b.neg, mag: a.value * b.value)
                    }
                }
            }
            return notConst()
        }
        _ => { return notConst() }
    }
}

// Whether a recovered TypeInfo is a (width-bearing) integer type.
fn tiIsInt(c: inout Comp, ti: TypeInfo) -> Bool {
    if ti.kind == 0 {
        if ti.nameLen != 0 {
            return isIntType(c: inout c, start: ti.nameStart, len: ti.nameLen)
        }
    }
    return false
}

// Whether a recovered TypeInfo names a float type (F32/F64).
fn tiIsFloat(c: inout Comp, ti: TypeInfo) -> Bool {
    if ti.kind == 0 {
        if ti.nameLen != 0 {
            return isFloatType(c: inout c, start: ti.nameStart, len: ti.nameLen)
        }
    }
    return false
}

// Encode a float context as an exprIntCtx code (9 = F64, 10 = F32) so the backend
// emits an otherwise-untyped integer literal as a double constant in float context.
fn floatCtxCode(bits: U64) -> U64 {
    if bits == 32 { return 10 }
    return 9
}


// Range-check the literals reachable from `id` against an expected integer type
// described as (eKind, eBits, eSgn): eKind 0 = no context type (spec: a literal
// with no type is a compile error), 1 = integer of (eBits, eSgn), 2 = a non-
// integer type (skip int checks). A `true`/`false` (isBool) or a suffixed
// literal (`5U64`) carries its own type and is never context-ambiguous.
fn checkLitLeaf(c: inout Comp, value: U64, neg: Bool, offset: U64, isBool: Bool, tyStart: U64, tyLen: U64, eKind: U64, eBits: U64, eSgn: Bool) {
    if isBool {
        return
    }
    if tyLen != 0 {
        // explicit type suffix: range-check against it (never ambiguous).
        if litFitsType(c: inout c, value: value, neg: neg, dstStart: tyStart, dstLen: tyLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal is out of range for its type")
        }
        return
    }
    if eKind == 1 {
        if litFitsBits(value: value, neg: neg, bits: eBits, sgn: eSgn) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal is out of range for its type")
        }
        return
    }
    if eKind == 0 {
        compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal has no type from context; add a type annotation or a suffix (e.g. `5I32`)")
    }
}

// Encode a known int context (bits, sgn) as a code 1..8 (I8/I16/I32/I64/U8/U16/U32/U64).
fn intCtxCode(bits: U64, sgn: Bool) -> U64 {
    if sgn {
        if bits == 8 { return 1 }
        if bits == 16 { return 2 }
        if bits == 32 { return 3 }
        return 4
    }
    if bits == 8 { return 5 }
    if bits == 16 { return 6 }
    if bits == 32 { return 7 }
    return 8
}

fn checkLitCtx(c: inout Comp, id: U64, eKind: U64, eBits: U64, eSgn: Bool) {
    // record the int context so `typeOf` can recover an otherwise width-less form
    // (`0-1` / `match{...}+1` typed only by its binding) — see exprIntCtx. eKind 1
    // means a definite int context (bits/sgn known); the recursion below propagates
    // the same context to operands, so the whole arith subtree is recorded.
    if eKind == 1 {
        if id < c.exprIntCtx.count {
            c.exprIntCtx[id] = intCtxCode(bits: eBits, sgn: eSgn)
        }
    }
    if eKind == 2 {
        if id < c.exprIntCtx.count {
            c.exprIntCtx[id] = floatCtxCode(bits: eBits)
        }
    }
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, val isNeg) => {
            checkLitLeaf(c: inout c, value: value, neg: isNeg, offset: offset, isBool: isBool, tyStart: tyStart, tyLen: tyLen, eKind: eKind, eBits: eBits, eSgn: eSgn)
        }
        Expr.Unary(val op, val operand) => {
            if op == opSub() {
                // a leading `-` on a literal folds into the literal (`-128:I8` is
                // valid even though `128` alone exceeds I8), so check the magnitude
                // with the negative sign; otherwise recurse with the same type.
                val oe: Expr = c.exprs[operand]
                match oe {
                    Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, isNeg: _) => {
                        checkLitLeaf(c: inout c, value: value, neg: true, offset: offset, isBool: isBool, tyStart: tyStart, tyLen: tyLen, eKind: eKind, eBits: eBits, eSgn: eSgn)
                    }
                    _ => { checkLitCtx(c: inout c, id: operand, eKind: eKind, eBits: eBits, eSgn: eSgn) }
                }
            } else {
                if op == opBitNot() {
                    checkLitCtx(c: inout c, id: operand, eKind: eKind, eBits: eBits, eSgn: eSgn)
                }
            }
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            mut val isArith: Bool = false
            if op >= 56 { if op <= 60 { isArith = true } }
            if op >= 74 { if op <= 78 { isArith = true } }
            if isArith {
                if eKind == 1 {
                    val cf: ConstInt = foldConst(c: inout c, id: id)
                    if cf.isConst {
                        if litFitsBits(value: cf.value, neg: cf.neg, bits: eBits, sgn: eSgn) {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: id)), msg: "constant expression is out of range for its type")
                        }
                    }
                    checkLitCtx(c: inout c, id: lhs, eKind: eKind, eBits: eBits, eSgn: eSgn)
                    checkLitCtx(c: inout c, id: rhs, eKind: eKind, eBits: eBits, eSgn: eSgn)
                } else {
                    if eKind == 2 {
                        // float context flows into both operands (`val x: F64 = 1.5 + 2`).
                        checkLitCtx(c: inout c, id: lhs, eKind: 2, eBits: eBits, eSgn: false)
                        checkLitCtx(c: inout c, id: rhs, eKind: 2, eBits: eBits, eSgn: false)
                    } else {
                        if checkBinTraitRhs(c: inout c, op: op, lhs: lhs, rhs: rhs) {
                            checkLitCtx(c: inout c, id: lhs, eKind: 0, eBits: 0, eSgn: false)
                        } else {
                            checkArithNoCtx(c: inout c, lhs: lhs, rhs: rhs)
                        }
                    }
                }
            } else {
                checkArithNoCtx(c: inout c, lhs: lhs, rhs: rhs)
            }
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            checkCallArgs(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            checkMethodArgs(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
        }
        Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
            // The operand has its own type; a direct-literal operand is range-
            // checked by the cast itself, so only recurse into compound operands.
            val oe: Expr = c.exprs[operand]
            match oe {
                Expr.Int(value: _, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => {}
                _ => { checkLitCtx(c: inout c, id: operand, eKind: 0, eBits: 0, eSgn: false) }
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            checkLitCtx(c: inout c, id: base, eKind: 0, eBits: 0, eSgn: false)
        }
        Expr.Index(val base, val index) => {
            checkLitCtx(c: inout c, id: base, eKind: 0, eBits: 0, eSgn: false)
            checkLitCtx(c: inout c, id: index, eKind: 1, eBits: 64, eSgn: false)
        }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            checkMakeFields(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, ty: ty, fields: fields)
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count {
                checkLitCtx(c: inout c, id: elems[i], eKind: eKind, eBits: eBits, eSgn: eSgn)
                i += 1
            }
        }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            // a value-position `if`'s result is its branches' `give` values, so the
            // surrounding context flows to each give (an else-if chain recurses here
            // via the nested IfExpr give). The condition is self-typed (Bool).
            val tg: U64 = blockGiveExpr(c: inout c, blkId: thenBlk)
            if tg < c.exprs.count {
                checkLitCtx(c: inout c, id: tg, eKind: eKind, eBits: eBits, eSgn: eSgn)
            }
            val eg: U64 = blockGiveExpr(c: inout c, blkId: elseBlk)
            if eg < c.exprs.count {
                checkLitCtx(c: inout c, id: eg, eKind: eKind, eBits: eBits, eSgn: eSgn)
            }
        }
        Expr.MatchExpr(val scrut, val arms) => {
            checkLitCtx(c: inout c, id: scrut, eKind: 0, eBits: 0, eSgn: false)
            mut val i: U64 = 0
            while i < arms.count {
                checkLitCtx(c: inout c, id: arms[i].body, eKind: eKind, eBits: eBits, eSgn: eSgn)
                i += 1
            }
        }
        Expr.OptChain(val base, memberStart: _, memberLen: _) => {
            checkLitCtx(c: inout c, id: base, eKind: 0, eBits: 0, eSgn: false)
        }
        Expr.Try(val expr) => {
            checkLitCtx(c: inout c, id: expr, eKind: 0, eBits: 0, eSgn: false)
        }
        _ => {}
    }
}

struct IntTy {
    pub val known: Bool
    pub val bits: U64
    pub val sgn: Bool
}

// IntTy of a declared type span: known when (start,len) names an integer type.
fn spanIntTy(c: inout Comp, start: U64, len: U64) -> IntTy {
    if isIntType(c: inout c, start: start, len: len) {
        return <IntTy known=true bits=intBits(c: inout c, start: start, len: len) sgn=intSigned(c: inout c, start: start, len: len) />
    }
    return <IntTy known=false bits=0 sgn=false />
}

// For a trait-dispatched binary operator (`a + b` with `impl T as Add[...]`), check
// the rhs literal against the witness's rhs PARAMETER type, so `a + 10` types `10`
// from the conformance's rhs (e.g. `Add[I64]`) instead of failing "no type from
// context". Returns false when lhs has no operator-trait witness (caller falls back
// to the ordinary same-type arithmetic rule).
fn checkBinTraitRhs(c: inout Comp, op: I64, lhs: U64, rhs: U64) -> Bool {
    if hasBinTraitWitness(c: inout c, op: op, lhs: lhs, rhs: rhs) {
        val lt: TypeInfo = binWitnessType(c: inout c, lhs: lhs, rhs: rhs)
        val fi: U64 = findBinTraitWitness(c: inout c, typeStart: lt.nameStart, typeLen: lt.nameLen, name: binTraitMethodName(op: op), rhs: rhs)
        if fi < c.funcs.count {
            val f: Func = c.funcs[fi]
            if f.params.count >= 2 {
                val pit: IntTy = spanIntTy(c: inout c, start: f.params[1].tyStart, len: f.params[1].tyLen)
                if pit.known {
                    checkLitCtx(c: inout c, id: rhs, eKind: 1, eBits: pit.bits, eSgn: pit.sgn)
                } else {
                    checkLitCtx(c: inout c, id: rhs, eKind: 0, eBits: 0, eSgn: false)
                }
                return true
            }
        }
    }
    return false
}

// Recover an expression's integer type as (bits, sgn). Covers what exprType
// reports width-less but is nonetheless integer-typed: `arr.count` (U64) and an
// array element read `arr[i]` (the element's int type) — so a literal sibling in
// `0 ..< arr.count` infers U64 and is not flagged ambiguous.
fn exprIntTy(c: inout Comp, id: U64) -> IntTy {
    val ti: TypeInfo = exprType(c: inout c, id: id)
    if tiIsInt(c: inout c, ti: ti) {
        return <IntTy known=true bits=intBits(c: inout c, start: ti.nameStart, len: ti.nameLen) sgn=intSigned(c: inout c, start: ti.nameStart, len: ti.nameLen) />
    }
    val e: Expr = c.exprs[id]
    match e {
        Expr.Call(val nameStart, val nameLen, val args) => {
            // argCount() is the one integer-returning I/O builtin (I64).
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") {
                return <IntTy known=true bits=64 sgn=true />
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "count") {
                val bt: TypeInfo = exprType(c: inout c, id: base)
                if bt.kind == 3 {
                    return <IntTy known=true bits=64 sgn=false />
                }
            }
        }
        Expr.Index(val base, val index) => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 3 {
                if isIntType(c: inout c, start: bt.nameStart, len: bt.nameLen) {
                    return <IntTy known=true bits=intBits(c: inout c, start: bt.nameStart, len: bt.nameLen) sgn=intSigned(c: inout c, start: bt.nameStart, len: bt.nameLen) />
                }
            }
        }
        _ => {}
    }
    return <IntTy known=false bits=0 sgn=false />
}

// Infer an arithmetic/comparison's literal operand type from a typed sibling
// (Plew: both operands share a type). If neither operand has a known integer
// type, the operands carry no context, so a literal there is ambiguous (error).
fn checkArithNoCtx(c: inout Comp, lhs: U64, rhs: U64) {
    // a float-typed sibling makes the whole arith float (`1.5 + 2`); the untyped
    // literal types as a float there (spec/02,12).
    if exprIsFloat(c: inout c, id: lhs) || exprIsFloat(c: inout c, id: rhs) {
        checkLitCtx(c: inout c, id: lhs, eKind: 2, eBits: 64, eSgn: false)
        checkLitCtx(c: inout c, id: rhs, eKind: 2, eBits: 64, eSgn: false)
        return
    }
    val lt: IntTy = exprIntTy(c: inout c, id: lhs)
    if lt.known {
        checkLitCtx(c: inout c, id: lhs, eKind: 1, eBits: lt.bits, eSgn: lt.sgn)
        checkLitCtx(c: inout c, id: rhs, eKind: 1, eBits: lt.bits, eSgn: lt.sgn)
        return
    }
    val rt: IntTy = exprIntTy(c: inout c, id: rhs)
    if rt.known {
        checkLitCtx(c: inout c, id: lhs, eKind: 1, eBits: rt.bits, eSgn: rt.sgn)
        checkLitCtx(c: inout c, id: rhs, eKind: 1, eBits: rt.bits, eSgn: rt.sgn)
        return
    }
    checkLitCtx(c: inout c, id: lhs, eKind: 0, eBits: 0, eSgn: false)
    checkLitCtx(c: inout c, id: rhs, eKind: 0, eBits: 0, eSgn: false)
}

// checkLitCtx with the expected type given as a recovered TypeInfo.
fn checkLitTi(c: inout Comp, id: U64, ti: TypeInfo) {
    if tiIsInt(c: inout c, ti: ti) {
        checkLitCtx(c: inout c, id: id, eKind: 1, eBits: intBits(c: inout c, start: ti.nameStart, len: ti.nameLen), eSgn: intSigned(c: inout c, start: ti.nameStart, len: ti.nameLen))
        return
    }
    if tiIsFloat(c: inout c, ti: ti) {
        // spec/02,12: a polymorphic int literal in a float context types as that
        // float (`val x: F64 = 5`, `1.5 + 2`) — no implicit conversion, the literal
        // simply IS a float here. Record the float context for the backend.
        mut val fbits: U64 = 64
        if rangeEquals(bytes: c.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F32") { fbits = 32 }
        checkLitCtx(c: inout c, id: id, eKind: 2, eBits: fbits, eSgn: false)
        return
    }
    checkLitCtx(c: inout c, id: id, eKind: 0, eBits: 0, eSgn: false)
}

// checkLitCtx against a written type span (annotation / param / field).
fn checkLitSpan(c: inout Comp, id: U64, tyStart: U64, tyLen: U64, isArray: Bool) {
    if isArray {
        checkLitArray(c: inout c, id: id, elemStart: tyStart, elemLen: tyLen)
        return
    }
    checkLitTi(c: inout c, id: id, ti: typeInfoOfName(c: inout c, start: tyStart, len: tyLen, isArray: false))
}

// Range-check the elements of an array literal against the element type.
fn checkLitArray(c: inout Comp, id: U64, elemStart: U64, elemLen: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count {
                checkLitSpan(c: inout c, id: elems[i], tyStart: elemStart, tyLen: elemLen, isArray: false)
                i += 1
            }
        }
        _ => { checkLitCtx(c: inout c, id: id, eKind: 0, eBits: 0, eSgn: false) }
    }
}

// Check call args against the callee's parameter types. Builtins (not found as a
// Whether a type transitively owns a unique value: it is unique, or it is a
// struct one of whose (non-array) fields is transitively unique. By-value structs
// are acyclic, so this terminates. (Array-of-unique is unsupported in v1, so
// array fields are not followed here.)
fn typeIsTransitivelyUnique(c: inout Comp, start: U64, len: U64) -> Bool {
    if typeIsUnique(c: inout c, start: start, len: len) {
        return true
    }
    val si: U64 = structIndexByName(c: inout c, start: start, len: len)
    if si >= c.structs.count {
        return false
    }
    val s: StructDef = c.structs[si]
    mut val i: U64 = 0
    while i < s.fields.count {
        val f: FieldDef = s.fields[i]
        if fieldIsBoxed(c: inout c, f: f) {
            // a boxed (recursive) field is behind indirection (like an array); its
            // contents don't transmit unique contagion, and skipping it breaks the
            // cycle that would otherwise make this walk diverge.
        } else {
            if f.tyIsArray {
            } else {
                if typeIsTransitivelyUnique(c: inout c, start: f.tyStart, len: f.tyLen) {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Field contagion (spec/03): a struct that owns a unique value (directly or
// transitively) must itself be declared `unique` — the decision is forced rather
// than inferred, so adding a unique field can't silently make a copyable type
// unsound (copies would multi-run deinit).
fn checkFieldContagion(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.structs.count {
        val s: StructDef = c.structs[i]
        if s.isUnique {
        } else {
            mut val j: U64 = 0
            while j < s.fields.count {
                val f: FieldDef = s.fields[j]
                if f.tyIsArray {
                } else {
                    if typeIsTransitivelyUnique(c: inout c, start: f.tyStart, len: f.tyLen) {
                        compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "a struct with a unique field must be declared `unique`")
                    }
                }
                j += 1
            }
        }
        i += 1
    }
}

// Range-check each struct field's default-value literal against the field's
// declared type (spec/05: `val x: T = expr` is memberwise-factory default-arg
// sugar, so the default must fit T exactly as an explicit construction would —
// `val n: I8 = 300` is rejected here, not silently truncated at codegen). Enum
// variant fields take no default, so only struct fields are visited.
fn checkFieldDefaults(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.structs.count {
        val s: StructDef = c.structs[i]
        mut val j: U64 = 0
        while j < s.fields.count {
            val f: FieldDef = s.fields[j]
            if f.hasDefault {
                checkLitSpan(c: inout c, id: f.defaultVal, tyStart: f.tyStart, tyLen: f.tyLen, isArray: f.tyIsArray)
                // checkLitSpan accepts a `true`/`false` (and other category-mismatched
                // values) regardless of the field type, so a default of the wrong type
                // (`val a: I64 = true`) slips through — full type-check against T.
                if f.tyIsArray {
                } else {
                    tcCheckValue(c: inout c, expectedRef: f.ty, valueExpr: f.defaultVal, pos: "field default")
                }
            }
            j += 1
        }
        i += 1
    }
}

// Access-mode validity on parameters (spec/03): a unique-type parameter needs a
// mode (`move`/`borrow`/`inout`); a copyable-type parameter rejects `move` (a
// footgun: disables a value that could just be copied) and `borrow` (redundant
// with by-value). `inout` is valid for both. Array params are containers
// (copyable in v1) and not mode-checked here.
fn checkParamModes(c: inout Comp, params: Array[Param]) {
    mut val i: U64 = 0
    while i < params.count {
        val p: Param = params[i]
        if p.tyIsArray {
        } else {
            if typeIsUnique(c: inout c, start: p.tyStart, len: p.tyLen) {
                val hasMode: Bool = p.isMove || p.isBorrow || p.isInout
                if hasMode {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: p.nameStart), msg: "a unique-type parameter requires a mode (`move`, `borrow`, or `inout`)")
                }
            } else {
                if p.isMove {
                    compileErrorAt(line: lineOf(c: inout c, offset: p.nameStart), msg: "`move` is not allowed on a copyable type; pass by value or use `inout`")
                }
                if p.isBorrow {
                    compileErrorAt(line: lineOf(c: inout c, offset: p.nameStart), msg: "`borrow` is redundant on a copyable type; pass by value")
                }
            }
        }
        i += 1
    }
}

// Reject `Array[unique]` (spec/03): unique values cannot be stored in a generic
// container directly — wrap them in `Ref[T]`. Without this a unique array element
// is silently never deinit'd (CoW shares the buffer; the elements leak). Checks
// every distinct array element type collected during parsing. `Array[Ref[File]]`
// passes (the element head is `Ref`, not the unique type).
fn checkArrayElemsNotUnique(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.arrayElems.count {
        val ae: Bind = c.arrayElems[i]
        if typeIsUnique(c: inout c, start: ae.nameStart, len: ae.nameLen) {
            compileErrorAt(line: lineOf(c: inout c, offset: ae.nameStart), msg: "a unique type cannot be stored in an Array; wrap it in Ref[T]")
        }
        i += 1
    }
}

// Reject a unique type as a generic type argument (spec/03): v1 generics are
// copyable-only, so `Box[File]`/`Optional[File]`/`Result[File, E]` would copy (and
// silently fail to deinit) the unique value. The sanctioned container is `Ref[T]`
// (which itself wraps the unique), so Ref instantiations are exempt. Scans the
// whole TypeRef arena (not just genInsts) so lang-item enums like Optional/Result
// are covered too; generic templates carry type-param args (not unique) and pass.
fn checkGenericUniqueArgs(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.types.count {
        val t: TypeRef = c.types[i]
        if t.args.count == 0 {
        } else {
            if isRefInst(c: inout c, ref: i) {
            } else {
                mut val j: U64 = 0
                while j < t.args.count {
                    val ai: TypeInfo = typeInfoOfRef(c: inout c, ref: t.args[j])
                    if ai.kind == 2 {
                        if typeIsUnique(c: inout c, start: ai.nameStart, len: ai.nameLen) {
                            compileErrorAt(line: lineOf(c: inout c, offset: ai.nameStart), msg: "a unique type cannot be a generic type argument; wrap it in Ref[T]")
                        }
                    }
                    j += 1
                }
            }
        }
        i += 1
    }
}

// Run param-mode validity over every function/method declaration.
fn checkAllParamModes(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        checkParamModes(c: inout c, params: c.funcs[i].params)
        i += 1
    }
}

// A default argument `name: T = expr` (spec/04) is memberwise/default-arg sugar, so
// the default must fit T exactly as an explicit argument would — `fn f(x: I64 =
// true)` is a category error (checkLitSpan accepts a bool literal regardless of T,
// so the full type-check catches it). Skipped for array params (separate machinery).
fn checkParamDefaults(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val ps: Array[Param] = c.funcs[i].params
        mut val j: U64 = 0
        while j < ps.count {
            val p: Param = ps[j]
            if p.hasDefault {
                checkLitSpan(c: inout c, id: p.defaultExpr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                if p.tyIsArray {
                } else {
                    tcCheckValue(c: inout c, expectedRef: p.ty, valueExpr: p.defaultExpr, pos: "default arg")
                }
            }
            j += 1
        }
        i += 1
    }
}

// A bare place (variable/field/element) of a `unique` type in a value position
// is a forbidden copy (spec/03): unique values are move-only. Require `move`
// (consume), `borrow` (read), or `inout` (mutable borrow) at the use site.
// Fresh values (construction / call results) and the `move`/`borrow` prefixes
// (which lower to Expr.Move, not a place) pass. `inoutOk` exempts `inout` args.
fn checkUniquePlaceCopy(c: inout Comp, exprId: U64, inoutOk: Bool) {
    if inoutOk {
        return
    }
    if isPlaceExpr(c: inout c, id: exprId) {
        val ti: TypeInfo = exprType(c: inout c, id: exprId)
        if ti.kind == 2 {
            if typeIsUnique(c: inout c, start: ti.nameStart, len: ti.nameLen) {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: exprId)), msg: "a unique value cannot be copied; use `move`, `borrow`, or `inout`")
            }
        }
    }
}

// Reject any bare unique place among call/method arguments (a non-inout arg that
// is a plain place of unique type). `move`/`borrow` lower to Expr.Move (not a
// place) and `inout` is flagged, so only an unmoded unique place trips this.
fn checkUniqueArgModes(c: inout Comp, args: Array[Arg]) {
    mut val i: U64 = 0
    while i < args.count {
        checkUniquePlaceCopy(c: inout c, exprId: args[i].expr, inoutOk: args[i].isInout)
        i += 1
    }
}

// user function) keep their args lenient at I64 (placeholder I/O shims).
// A generic call must bind each type parameter CONSISTENTLY: two arguments at
// positions both declared as the bare parameter `T` must have the same type (`f[T](a:
// T, b: T)` called `f(a: 1I64, b: 2.0)` would monomorphize T=I64 yet pass an F64 for
// `b`, reinterpreting its bits — a silent miscompile). Nested positions (`Array[T]`)
// are deferred (the bare-`T` cases are the miscompile risk).
fn tcCheckGenericArgConsistency(c: inout Comp, f: Func, args: Array[Arg]) {
    if f.typeParams.count == 0U64 {
        return
    }
    mut val tpi: U64 = 0
    while tpi < f.typeParams.count {
        val tpId: U64 = f.typeParams[tpi].nameId
        mut val firstRef: U64 = 0
        mut val ai: U64 = 0
        while ai < args.count {
            if ai < f.params.count {
                val p: Param = f.params[ai]
                if p.tyLen > 0U64 {
                    if intern(c: inout c, start: p.tyStart, len: p.tyLen) == tpId {
                        val ar: U64 = inferType(c: inout c, id: args[ai].expr)
                        if ar != 0U64 {
                            if firstRef == 0U64 {
                                firstRef = ar
                            } else {
                                if typesCompatible(c: inout c, expected: firstRef, inferred: ar) {
                                } else {
                                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: args[ai].expr)), msg: "inconsistent types for a type parameter: two arguments bound to the same `[T]` have different types")
                                }
                            }
                        }
                    }
                }
            }
            ai += 1U64
        }
        tpi += 1U64
    }
}

// The `inout` keyword at the call site must match the parameter's mode (spec/03,04:
// access is always explicit — `inc(x: inout n)`, never a silent by-reference). An
// `inout` parameter requires `inout` on the argument (else the mutation would happen
// without the marker); a non-`inout` parameter rejects `inout` on the argument.
fn checkArgInoutMode(c: inout Comp, p: Param, arg: Arg) {
    if p.isInout {
        if arg.isInout {
            // `inout` writes through the place, so it must be mutable (spec/03:
            // `inc(x: inout n)` needs `mut val n`, not `val n`).
            if placeIsMutable(c: inout c, id: arg.expr) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: arg.expr)), msg: "an `inout` argument must be a mutable place; declare it `mut val` (spec/03)")
            }
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: arg.expr)), msg: "this parameter is `inout`; pass the argument with `inout` (spec/03)")
        }
    } else {
        if arg.isInout {
            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: arg.expr)), msg: "this parameter is not `inout`; remove `inout` from the argument (spec/03)")
        }
    }
}

fn checkCallArgs(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    checkUniqueArgModes(c: inout c, args: args)
    val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
    if fi == c.funcs.count {
        mut val i: U64 = 0
        while i < args.count {
            checkLitCtx(c: inout c, id: args[i].expr, eKind: 1, eBits: 64, eSgn: true)
            i += 1
        }
        return
    }
    val f: Func = c.funcs[fi]
    tcCheckGenericArgConsistency(c: inout c, f: f, args: args)
    val ps: Array[Param] = f.params
    mut val i: U64 = 0
    while i < args.count {
        if i < ps.count {
            val p: Param = ps[i]
            checkArgInoutMode(c: inout c, p: p, arg: args[i])
            checkLitSpan(c: inout c, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
            checkClosureArgArity(c: inout c, argExpr: args[i].expr, p: p)
            // full type-compatibility (not just literal context): a non-literal VALUE
            // argument whose type disagrees with the parameter (a closure with the wrong
            // return type for a `fn(...)->R` param, etc.) — checkLitSpan only sees
            // literals. tcCheckValue rejects only DEFINITE mismatches (unknown/generic
            // types pass through).
            tcCheckValue(c: inout c, expectedRef: p.ty, valueExpr: args[i].expr, pos: "arg")
        } else {
            checkLitCtx(c: inout c, id: args[i].expr, eKind: 0, eBits: 0, eSgn: false)
        }
        i += 1
    }
}

// A closure-literal argument passed where a function-typed parameter is expected
// must have the same number of parameters (spec/04 — a closure's params match the
// expected type's by label/order/arity exactly). A wrong arity reinterprets the
// call ABI and produces garbage, so reject it. (The fn TypeRef stores args as
// [return, param0, param1, …], so the parameter count is args.count - 1.)
fn checkClosureArgArity(c: inout Comp, argExpr: U64, p: Param) {
    if p.ty == 0U64 {
        return
    }
    if isFnType(c: inout c, ref: p.ty) {
    } else {
        return
    }
    match c.exprs[argExpr] {
        Expr.Closure(val params, val hasRet, retStart: _, retLen: _, retIsArray: _, val retTy, body: _) => {
            val want: U64 = c.types[p.ty].args.count
            if want > 0U64 {
                if params.count == want - 1U64 {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: argExpr)), msg: "closure has the wrong number of parameters for the expected function type")
                }
                // the closure's declared return type must match the expected function
                // type's return (`fn(...)->R` args = [R, param0, …]) — else the caller
                // reads back the wrong-typed result (`fn(x:I64)->F64` where `->I64` is
                // wanted reinterprets the bits). spec/04 (a function type's identity).
                if hasRet {
                    if retTy != 0U64 {
                        val expRet: U64 = c.types[p.ty].args[0]
                        if expRet != 0U64 {
                            if typesCompatible(c: inout c, expected: expRet, inferred: retTy) {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: argExpr)), msg: "closure return type does not match the expected function type")
                            }
                        }
                    }
                }
            }
        }
        _ => {}
    }
}

// Check method-call args against the method's params; array `.append(x)` checks
// `x` against the element type. Other builtins keep args lenient at I64.
fn checkMethodArgs(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    checkUniqueArgModes(c: inout c, args: args)
    checkLitCtx(c: inout c, id: recv, eKind: 0, eBits: 0, eSgn: false)
    val rt: TypeInfo = exprType(c: inout c, id: recv)
    // `dict.insert(key:, value:)` on a Dictionary[K, V] (also how a `[k: v]` literal
    // lowers): the generic-receiver arg grounding is incomplete, so check key->K and
    // value->V directly here (mirrors checkIndexKeyType for subscripts). spec/02.
    if rt.kind == 2 {
        if rt.ref != 0U64 {
            if rt.ref < c.types.count {
                val drt: TypeRef = c.types[rt.ref]
                if rangeEquals(bytes: c.bytes, start: drt.nameStart, len: drt.nameLen, kw: "Dictionary") {
                    if drt.args.count >= 2U64 {
                        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "insert") {
                            if args.count >= 2U64 {
                                tcCheckValue(c: inout c, expectedRef: drt.args[0], valueExpr: args[0].expr, pos: "dict key")
                                tcCheckValue(c: inout c, expectedRef: drt.args[1], valueExpr: args[1].expr, pos: "dict value")
                            }
                        }
                    }
                }
            }
        }
    }
    if rt.kind == 2 {
        val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        if mi != c.funcs.count {
            val mf: Func = c.funcs[mi]
            tcCheckGenericArgConsistency(c: inout c, f: mf, args: args)
            val ps: Array[Param] = mf.params
            val genericRecv: Bool = isGenericInst(c: inout c, ref: rt.ref)
            mut val i: U64 = 0
            while i < args.count {
                if i < ps.count {
                    val p: Param = ps[i]
                    checkArgInoutMode(c: inout c, p: p, arg: args[i])
                    if genericRecv {
                        // a CONCRETE primitive param (`n: I64`) on a generic receiver
                        // needs no grounding — check it directly. (substTypeInfo with the
                        // method's own type params mis-grounds a method-own generic like
                        // `fold[B]`'s `B`, so only primitives are checked this way.)
                        if isPrimType(c: inout c, start: p.tyStart, len: p.tyLen) {
                            checkLitSpan(c: inout c, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                            tcCheckValue(c: inout c, expectedRef: p.ty, valueExpr: args[i].expr, pos: "arg")
                        } else {
                            // resolve the param's type under the receiver's
                            // instantiation so a literal arg gets the concrete context.
                            val pti: TypeInfo = substTypeInfo(c: inout c, instRef: rt.ref, params: mf.typeParams, tyRef: p.ty)
                            checkLitTi(c: inout c, id: args[i].expr, ti: pti)
                            // full type-compatibility against the GROUNDED param type — a
                            // typed value whose type disagrees with the (instantiated)
                            // parameter (`dict[5I64]=v` on `Dictionary[String,_]` would hash
                            // an I64 as a String and crash). checkLitTi only range-checks a
                            // literal against its own suffix.
                            if pti.ref != 0U64 {
                                tcCheckValue(c: inout c, expectedRef: pti.ref, valueExpr: args[i].expr, pos: "arg")
                            }
                        }
                    } else {
                        checkLitSpan(c: inout c, id: args[i].expr, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray)
                        tcCheckValue(c: inout c, expectedRef: p.ty, valueExpr: args[i].expr, pos: "arg")
                    }
                } else {
                    checkLitCtx(c: inout c, id: args[i].expr, eKind: 0, eBits: 0, eSgn: false)
                }
                i += 1
            }
            return
        }
    }
    if rt.kind == 3 {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "append") {
            // if the element type is itself an `Array[X]`, the appended value is
            // an array (e.g. `m.append([1,2,3])`) — check its elements against the
            // inner element X, not the outer (mangled) element name as a scalar.
            mut val innerArr: Bool = false
            mut val innerStart: U64 = 0
            mut val innerLen: U64 = 0
            val er: U64 = arrayElemRef(c: inout c, start: rt.nameStart, len: rt.nameLen)
            if er != 0 {
                val rr: U64 = resolveTy(c: inout c, tyRef: er)
                if rr < c.types.count {
                    val rtp: TypeRef = c.types[rr]
                    if rangeEquals(bytes: c.bytes, start: rtp.nameStart, len: rtp.nameLen, kw: "Array") {
                        if rtp.args.count > 0 {
                            val xn: Bind = arrayElemNameForRef(c: inout c, elemRef: rtp.args[0])
                            innerArr = true
                            innerStart = xn.nameStart
                            innerLen = xn.nameLen
                        }
                    }
                }
            }
            mut val i: U64 = 0
            while i < args.count {
                if innerArr {
                    checkLitArray(c: inout c, id: args[i].expr, elemStart: innerStart, elemLen: innerLen)
                } else {
                    checkLitSpan(c: inout c, id: args[i].expr, tyStart: rt.nameStart, tyLen: rt.nameLen, isArray: false)
                    // a primitive-element array: the appended value's type must match the
                    // element type (`Array[I64].append(true)` — checkLitSpan range-checks a
                    // literal but a `true`/typed value of the wrong type slips through). Only
                    // primitives are checked (their simpleTypeRef is reliable; a struct/
                    // generic element name may be mangled and is left to other checks).
                    if isIntType(c: inout c, start: rt.nameStart, len: rt.nameLen) || isFloatType(c: inout c, start: rt.nameStart, len: rt.nameLen) || rangeEquals(bytes: c.bytes, start: rt.nameStart, len: rt.nameLen, kw: "Bool") || rangeEquals(bytes: c.bytes, start: rt.nameStart, len: rt.nameLen, kw: "String") {
                        tcCheckValue(c: inout c, expectedRef: simpleTypeRef(c: inout c, nameStart: rt.nameStart, nameLen: rt.nameLen), valueExpr: args[i].expr, pos: "append")
                    }
                }
                i += 1
            }
            return
        }
    }
    // an assoc fn call `Type.make(...)`: the recv is a TYPE NAME (not a value), so the
    // instance-method lookups above miss it. Resolve the assoc fn and check its args
    // (the value `S.make(n: true)` would otherwise reinterpret a Bool as I64).
    match c.exprs[recv] {
        Expr.Ident(start: val rStart, len: val rLen) => {
            val ai: U64 = findAssoc(c: inout c, recvStart: rStart, recvLen: rLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if ai < c.funcs.count {
                val aps: Array[Param] = c.funcs[ai].params
                mut val k: U64 = 0
                while k < args.count {
                    if k < aps.count {
                        val ap: Param = aps[k]
                        checkArgInoutMode(c: inout c, p: ap, arg: args[k])
                        checkLitSpan(c: inout c, id: args[k].expr, tyStart: ap.tyStart, tyLen: ap.tyLen, isArray: ap.tyIsArray)
                        tcCheckValue(c: inout c, expectedRef: ap.ty, valueExpr: args[k].expr, pos: "arg")
                    }
                    k += 1
                }
                return
            }
        }
        _ => {}
    }
    mut val i: U64 = 0
    while i < args.count {
        checkLitCtx(c: inout c, id: args[i].expr, eKind: 1, eBits: 64, eSgn: true)
        i += 1
    }
}

// Declared type of a Make field (struct field or enum variant field).
fn makeFieldType(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, fieldStart: U64, fieldLen: U64) -> TypeInfo {
    if isEnum {
        val qType: U64 = intern(c: inout c, start: typeStart, len: typeLen)
        val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
        val qField: U64 = intern(c: inout c, start: fieldStart, len: fieldLen)
        mut val ei: U64 = 0
        while ei < c.enums.count {
            val en: EnumDef = c.enums[ei]
            if en.nameId == qType {
                val vars: Array[Variant] = en.variants
                mut val vi: U64 = 0
                while vi < vars.count {
                    val v: Variant = vars[vi]
                    if v.nameId == qVar {
                        val fs: Array[FieldDef] = v.fields
                        mut val fj: U64 = 0
                        while fj < fs.count {
                            val fd: FieldDef = fs[fj]
                            if fd.nameId == qField {
                                return typeInfoOfName(c: inout c, start: fd.tyStart, len: fd.tyLen, isArray: fd.tyIsArray)
                            }
                            fj += 1
                        }
                    }
                    vi += 1
                }
            }
            ei += 1
        }
        return scalarInfo()
    }
    return fieldType(c: inout c, structStart: typeStart, structLen: typeLen, fieldStart: fieldStart, fieldLen: fieldLen)
}

// Acceptance soundness: a `<Type field=… />` / `<E.V field=… />` field must exist on
// the struct / variant. Otherwise codegen emits a non-existent C member (broken C, or
// — for a bare-literal value — a misleading "literal has no type" since makeFieldType
// falls back to scalarInfo). Only validated when the type IS a known struct/enum
// (Ref / Box / RawBuffer / extern lang-items / type params are special — skip, like
// checkMatchBinds). The field name is re-interned in lowering, so the line is
// approximate.
fn checkMakeFieldExists(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, mf: MakeField) {
    if isEnum {
        if concreteEnumIndex(c: inout c, nStart: typeStart, nLen: typeLen) >= c.enums.count {
            return
        }
    } else {
        val si: U64 = structIndexByName(c: inout c, start: typeStart, len: typeLen)
        if si >= c.structs.count {
            return
        }
        if c.structs[si].isExtern {
            return
        }
    }
    val fd: FieldDef = findFieldDef(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
    if fd.nameLen == 0 {
        // mf.offset is the field name's original source offset (mf.nameStart is
        // re-interned, so it maps to a bogus line); fall back to nameStart if 0.
        mut val off: U64 = mf.offset
        if off == 0 {
            off = mf.nameStart
        }
        compileErrorAt(line: lineOf(c: inout c, offset: off), msg: "no such field on this struct/variant (check the field name)")
    }
}

// Check each provided Make field value against its declared field type.
fn checkMakeFields(c: inout Comp, typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, ty: U64, fields: Array[MakeField]) {
    mut val i: U64 = 0
    while i < fields.count {
        val mf: MakeField = fields[i]
        checkMakeFieldExists(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, mf: mf)
        // a unique field value must be moved/constructed in, not copied from a
        // place (which would double-deinit: the source and the new owner).
        checkUniquePlaceCopy(c: inout c, exprId: mf.value, inoutOk: false)
        mut val ft: TypeInfo = scalarInfo()
        if isRefInst(c: inout c, ref: ty) {
            // `<Ref[T] value=… />`: the `value` field has the pointee type T, so
            // a literal (`value=7`) types from T (else "no type from context").
            val rt: TypeRef = c.types[ty]
            ft = typeInfoOfRef(c: inout c, ref: rt.args[0])
        } else {
            if isGenericEnumInst(c: inout c, ref: ty) {
                ft = genericEnumFieldTypeInfo(c: inout c, instRef: ty, variantStart: variantStart, variantLen: variantLen, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
            } else {
                if isGenericInst(c: inout c, ref: ty) {
                    ft = genericFieldTypeInfo(c: inout c, instRef: ty, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
                } else {
                    ft = makeFieldType(c: inout c, typeStart: typeStart, typeLen: typeLen, variantStart: variantStart, variantLen: variantLen, isEnum: isEnum, fieldStart: mf.nameStart, fieldLen: mf.nameLen)
                }
            }
        }
        if ft.kind == 3 {
            checkLitArray(c: inout c, id: mf.value, elemStart: ft.nameStart, elemLen: ft.nameLen)
        } else {
            checkLitTi(c: inout c, id: mf.value, ti: ft)
        }
        i += 1
    }
}

// Acceptance soundness: a variant/struct match pattern binds fields BY NAME, and
// codegen emits `_m.data.<Variant>.<field>` (or `scrut.<field>` for a struct), so a
// pattern that names a field the variant/struct does not have would produce broken
// C (a clang error). Reject it loudly in Plew instead. (The reported line uses the
// bind's original-source offset, `Bind.offset`, since fieldStart is re-interned.)
fn checkBindsInFields(c: inout Comp, binds: Array[Bind], fields: Array[FieldDef]) {
    mut val i: U64 = 0
    while i < binds.count {
        val bd: Bind = binds[i]
        val qBd: U64 = intern(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
        mut val found: Bool = false
        mut val fj: U64 = 0
        while fj < fields.count {
            if fields[fj].nameId == qBd {
                found = true
            }
            fj += 1
        }
        if found {
        } else {
            // bd.offset is the field name's original source offset (bd.fieldStart is
            // re-interned and maps to a bogus line); fall back to fieldStart if 0.
            mut val off: U64 = bd.offset
            if off == 0 {
                off = bd.fieldStart
            }
            compileErrorAt(line: lineOf(c: inout c, offset: off), msg: "match pattern binds a field that does not exist on this variant/struct (check the field name; payload binds are `Variant(field: val name)` or punning `Variant(val field)`)")
        }
        i += 1
    }
}

// Validate one match arm's pattern field names against the actual variant/struct
// fields. Skips wildcard arms and arms whose enum/struct/variant is not found (a
// separate concern — e.g. a match on a type parameter).
fn checkArmBinds(c: inout Comp, a: MatchArm) {
    if a.isWildcard {
        return
    }
    if a.isStruct {
        val si: U64 = structIndexByName(c: inout c, start: a.enumStart, len: a.enumLen)
        if si < c.structs.count {
            checkBindsInFields(c: inout c, binds: a.binds, fields: c.structs[si].fields)
        }
        return
    }
    val ei: U64 = enumIndexByName(c: inout c, start: a.enumStart, len: a.enumLen)
    if ei >= c.enums.count {
        return
    }
    val variants: Array[Variant] = c.enums[ei].variants
    val qVar: U64 = intern(c: inout c, start: a.variantStart, len: a.variantLen)
    mut val vi: U64 = 0
    while vi < variants.count {
        if variants[vi].nameId == qVar {
            checkBindsInFields(c: inout c, binds: a.binds, fields: variants[vi].fields)
            return
        }
        vi += 1
    }
}

// Validate every match pattern (statement and expression position) names real
// fields. Run before codegen so a bad pattern is a clean Plew error.
fn checkMatchBinds(c: inout Comp) {
    mut val si: U64 = 0
    while si < c.stmts.count {
        match c.stmts[si] {
            Stmt.Match(val scrut, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count {
                    checkArmBinds(c: inout c, a: arms[ai])
                    ai += 1
                }
            }
            _ => {}
        }
        si += 1
    }
    mut val xi: U64 = 0
    while xi < c.exprs.count {
        match c.exprs[xi] {
            Expr.MatchExpr(val scrut, val arms) => {
                mut val ai: U64 = 0
                while ai < arms.count {
                    checkArmBinds(c: inout c, a: arms[ai])
                    ai += 1
                }
            }
            _ => {}
        }
        xi += 1
    }
}

// The concrete type span that the conforming type `(recvStart,recvLen)` binds for
// the associated type named `(nameStart,nameLen)` (spec/08 `type Item = Concrete`),
// or the input name unchanged when it is not an associated type / has no binding.
fn assocBindingSpan(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bind {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.assocBindings.count {
        val ab: AssocBinding = c.assocBindings[i]
        if ab.recvId == qRecv {
            if ab.nameId == qName {
                return <Bind nameStart=ab.tyStart nameLen=ab.tyLen nameId=intern(c: inout c, start: ab.tyStart, len: ab.tyLen) fieldStart=ab.tyStart fieldLen=ab.tyLen />
            }
        }
        i += 1
    }
    return <Bind nameStart=nameStart nameLen=nameLen nameId=qName fieldStart=nameStart fieldLen=nameLen />
}

// The head-name id a requirement-param type resolves to, for the conforming type
// (spec/08,12): `Self` -> the receiver type; a trait type parameter (`Rhs` of
// `Add[Rhs]`) -> the conformance's i-th `traitArgs` binding; an associated type
// (`Item`) -> its `type Item = X` binding; anything else (a concrete type) -> itself.
// So a generic requirement `add(lhs: Self, rhs: Rhs)` matches a witness
// `add(lhs: Money, rhs: Money)` on `impl Money as Add[Money]`.
fn substReqParamHeadId(c: inout Comp, recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64], prStart: U64, prLen: U64) -> U64 {
    if rangeEquals(bytes: c.bytes, start: prStart, len: prLen, kw: "Self") {
        return intern(c: inout c, start: recvStart, len: recvLen)
    }
    val prId: U64 = intern(c: inout c, start: prStart, len: prLen)
    mut val k: U64 = 0
    while k < tps.count {
        if tps[k].nameId == prId {
            if k < targs.count {
                return c.types[targs[k]].nameId
            }
        }
        k += 1
    }
    val sub: Bind = assocBindingSpan(c: inout c, recvStart: recvStart, recvLen: recvLen, nameStart: prStart, nameLen: prLen)
    return sub.nameId
}

// Like paramSelectorEq, but substitutes the requirement side's `Self` / trait type
// parameters / associated types with the conforming type's bindings before comparing
// (so `add(lhs: Self, rhs: Rhs)` with `impl Money as Add[Money]` matches a witness
// `add(lhs: Money, rhs: Money)`). `tps`/`targs` are the trait's type parameters and
// the conformance's bound type arguments (positional).
fn paramSelectorEqSubst(c: inout Comp, w: Array[Param], r: Array[Param], recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64]) -> Bool {
    if w.count != r.count {
        return false
    }
    mut val i: U64 = 0
    while i < w.count {
        val pw: Param = w[i]
        val pr: Param = r[i]
        if pw.nameId == pr.nameId {
        } else {
            return false
        }
        val subId: U64 = substReqParamHeadId(c: inout c, recvStart: recvStart, recvLen: recvLen, tps: tps, targs: targs, prStart: pr.tyStart, prLen: pr.tyLen)
        // the WITNESS side may also write `Self` (`fn eqTo(other: Self)` inside
        // `impl P as MyEq`): substitute its Self -> the conforming type too, so the
        // requirement's substituted Self (=recv) matches it. A concrete witness type
        // (`other: P`) keeps its own head id (pw.tyNameId).
        mut val wId: U64 = pw.tyNameId
        if rangeEquals(bytes: c.bytes, start: pw.tyStart, len: pw.tyLen, kw: "Self") {
            wId = intern(c: inout c, start: recvStart, len: recvLen)
        }
        if wId == subId {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Whether `witnessed` contains a member matching requirement `r`'s selector
// (name + params). Distinguishes overloaded requirements by signature. Requirement
// param types are substituted through the conforming type's Self / trait-type-arg /
// associated-type bindings (`tps`/`targs` = the trait's type params + the conformance's args).
// Whether witness `w`'s return type clashes with requirement `r`'s — judged ONLY
// when the requirement returns a CONCRETE primitive (`size()->U64`): the witness
// must then return the same primitive (`size()->I64` does NOT satisfy it). A Self /
// type-param / associated-type / named / array requirement return is left to the
// existing machinery (conservative — never false-reject a valid conformance).
fn reqReturnMismatch(c: inout Comp, w: Func, r: Func) -> Bool {
    if r.hasRet {
    } else {
        return false
    }
    if r.retIsArray {
        return false
    }
    if isPrimType(c: inout c, start: r.retStart, len: r.retLen) {
    } else {
        return false
    }
    // requirement returns a concrete primitive: the witness must return it exactly.
    if w.hasRet {
    } else {
        return true
    }
    if w.retIsArray {
        return true
    }
    if spansEqual(c: inout c, aStart: r.retStart, aLen: r.retLen, bStart: w.retStart, bLen: w.retLen) {
        return false
    }
    return true
}

fn witnessedHas(c: inout Comp, witnessed: Array[Func], r: Func, recvStart: U64, recvLen: U64, tps: Array[Bind], targs: Array[U64]) -> Bool {
    mut val i: U64 = 0
    while i < witnessed.count {
        val w: Func = witnessed[i]
        if w.nameId == r.nameId {
            if paramSelectorEqSubst(c: inout c, w: w.params, r: r.params, recvStart: recvStart, recvLen: recvLen, tps: tps, targs: targs) {
                if reqReturnMismatch(c: inout c, w: w, r: r) {
                } else {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Conformance completeness (spec/08): every requirement of each `impl Type as
// Trait` must be witnessed in that impl (a body method or a `via` alias). An
// empty or partial conformance is an error (no implicit/silent conformance).
// Are all of trait def `t`'s requirements witnessed by conformance `cf`?
fn confWitnessesAll(c: inout Comp, cf: Conform, t: TraitDef) -> Bool {
    mut val ri: U64 = 0
    while ri < t.reqs.count {
        val r: Func = t.reqs[ri]
        if witnessedHas(c: inout c, witnessed: cf.witnessed, r: r, recvStart: cf.typeStart, recvLen: cf.typeLen, tps: t.typeParams, targs: cf.traitArgs) {
        } else {
            return false
        }
        ri += 1
    }
    return true
}

// Resolve the single trait def a conformance `impl X as P[...]` refers to (spec/08).
// Trait identity is matched by name AND type-param arity (`impl X as Sub` with 0
// args is not a conformance to the operator `Sub[Rhs]` with 1 param), and among
// remaining same-name/arity candidates the one the conformance actually witnesses
// is chosen — STRUCTURAL resolution. This separates a user trait (`Not { flip }`)
// from an ambient operator trait of the same name (`Not { not }`) without needing
// module/visibility info (the impl-site name spans are re-interned, so they carry
// no reliable module). Returns the satisfied def, else the first candidate (to
// drive the incomplete-conformance error), else c.traits.count (unknown trait).
fn resolveTraitDef(c: inout Comp, cf: Conform) -> U64 {
    mut val firstCandidate: U64 = c.traits.count
    mut val ti: U64 = 0
    while ti < c.traits.count {
        val t: TraitDef = c.traits[ti]
        if t.nameId == cf.traitId && t.typeParams.count == cf.traitArgs.count {
            if firstCandidate == c.traits.count {
                firstCandidate = ti
            }
            if confWitnessesAll(c: inout c, cf: cf, t: t) {
                return ti
            }
        }
        ti += 1
    }
    return firstCandidate
}

// Existential formation (spec/08): `any P` requires P's type arguments and
// associated types to all be bound (`any Iterator[Item=I32]`, `any Add[I32,
// Output=I32]`), so the only thing still erased is `Self`. A positional binding
// fills a type parameter in order; a named binding `Name=Type` fills a type
// parameter or associated type by name. An unbound parameter / associated type is a
// loud formation error.
fn checkAnyFormation(c: inout Comp) {
    mut val ti: U64 = 0
    while ti < c.types.count {
        val t: TypeRef = c.types[ti]
        if t.isAny {
            val tri: U64 = findTraitIdxByName(c: inout c, start: t.nameStart, len: t.nameLen)
            if tri < c.traits.count {
                val tr: TraitDef = c.traits[tri]
                // count positional bindings (argLabels entry 0 / absent).
                mut val positional: U64 = 0
                mut val ai: U64 = 0
                while ai < t.args.count {
                    mut val lbl: U64 = 0
                    if ai < t.argLabels.count {
                        lbl = t.argLabels[ai]
                    }
                    if lbl == 0U64 {
                        positional += 1U64
                    }
                    ai += 1
                }
                // each type parameter is bound positionally or by name.
                mut val tpi: U64 = 0
                mut val posNeed: U64 = 0
                while tpi < tr.typeParams.count {
                    if anyHasNamedBinding(c: inout c, t: t, nameId: tr.typeParams[tpi].nameId) {
                    } else {
                        posNeed += 1U64
                    }
                    tpi += 1
                }
                if positional < posNeed {
                    compileErrorAt(line: lineOf(c: inout c, offset: t.nameStart), msg: "`any P` leaves a type parameter unbound — bind all of the trait's type arguments (spec/08)")
                }
                // each associated type must be bound by name.
                mut val asi: U64 = 0
                while asi < tr.assocTypes.count {
                    if anyHasNamedBinding(c: inout c, t: t, nameId: tr.assocTypes[asi].nameId) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: t.nameStart), msg: "`any P` leaves an associated type unbound — bind it as `any P[Item=Type]` (spec/08)")
                    }
                    asi += 1
                }
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: t.nameStart), msg: "`any P` names an unknown trait — `any` exists only over a trait (spec/08)")
            }
        }
        ti += 1
    }
}

// Does existential TypeRef `t` carry a named binding `Name=Type` whose name is the
// interned `nameId`?
fn anyHasNamedBinding(c: inout Comp, t: TypeRef, nameId: U64) -> Bool {
    mut val i: U64 = 0
    while i < t.args.count {
        if i < t.argLabels.count {
            if t.argLabels[i] == nameId && nameId != 0U64 {
                return true
            }
        }
        i += 1
    }
    return false
}

fn checkConformances(c: inout Comp) {
    mut val ci: U64 = 0
    while ci < c.conforms.count {
        val cf: Conform = c.conforms[ci]
        if cf.derived {
            // compiler-synthesized (`@[Eq]`/`@[Ord]`): trivially complete, and its
            // trait is compiler-known — exempt from unknown-trait/completeness.
            ci += 1
        } else {
        // resolve the one trait this conformance refers to (structural — see
        // resolveTraitDef); a conformance to an undeclared/unimported trait is a
        // loud error (spec/08: explicit conformance).
        val ti: U64 = resolveTraitDef(c: inout c, cf: cf)
        if ti < c.traits.count {
            val t: TraitDef = c.traits[ti]
            // re-check reqs on the resolved def: a fully-witnessed def passes; if
            // resolveTraitDef fell back to the first candidate (none satisfied),
            // this reports which requirement is missing.
            mut val ri: U64 = 0
            while ri < t.reqs.count {
                val r: Func = t.reqs[ri]
                if witnessedHas(c: inout c, witnessed: cf.witnessed, r: r, recvStart: cf.typeStart, recvLen: cf.typeLen, tps: t.typeParams, targs: cf.traitArgs) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: cf.typeStart), msg: "incomplete trait conformance: a requirement is not witnessed (define its body or bind it with `via`)")
                }
                ri += 1
            }
            // supertraits (spec/08): conforming to Sub requires conforming to
            // each Super (a constraint, not auto-implemented).
            mut val sti: U64 = 0
            while sti < t.supertraits.count {
                val sup: Bind = t.supertraits[sti]
                if typeConformsTo(c: inout c, typeStart: cf.typeStart, typeLen: cf.typeLen, traitStart: sup.nameStart, traitLen: sup.nameLen) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: cf.typeStart), msg: "supertrait not satisfied: this type must also conform to the trait's supertrait")
                }
                sti += 1
            }
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: cf.traitStart), msg: "conformance to an unknown trait (is it declared / imported?)")
        }
        ci += 1
        }
    }
    checkViaTargets(c: inout c)
}

// Whether type (recvStart,recvLen) has a member named (nameStart,nameLen) — a
// method (hasRecv) or an assoc fn. Used to validate `via` alias targets.
fn typeHasMember(c: inout Comp, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.recvId == qRecv {
                if f.nameId == qName {
                    return true
                }
            }
        } else {
            if f.isAssoc {
                if f.recvId == qRecv {
                    if f.nameId == qName {
                        return true
                    }
                }
            }
        }
        i += 1
    }
    return false
}

// Validate every `via real` alias (spec/08): the real member must exist on the
// type (a loud error otherwise, instead of failing only when the alias is used).
fn checkViaTargets(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.methodAliases.count {
        val al: MethodAlias = c.methodAliases[i]
        if typeHasMember(c: inout c, recvStart: al.recvStart, recvLen: al.recvLen, nameStart: al.realStart, nameLen: al.realLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: al.aliasStart), msg: "`via` target is not a member of this type")
        }
        i += 1
    }
}

// Built-in conformance of primitives/String to Eq/Ord (spec/12: numeric types,
// Bool, String are Eq/Ord without an explicit impl). Lets `where T: Eq`/`: Ord`
// be instantiated with a primitive (the canonical `max`/`min` over numbers).
fn builtinEqOrd(c: inout Comp, typeStart: U64, typeLen: U64, traitStart: U64, traitLen: U64) -> Bool {
    val isEqOrd: Bool = rangeEquals(bytes: c.bytes, start: traitStart, len: traitLen, kw: "Eq") || rangeEquals(bytes: c.bytes, start: traitStart, len: traitLen, kw: "Ord")
    if isEqOrd {
        if isPrimType(c: inout c, start: typeStart, len: typeLen) {
            return true
        }
        return rangeEquals(bytes: c.bytes, start: typeStart, len: typeLen, kw: "String")
    }
    return false
}

// Whether the type named (typeStart,typeLen) conforms to the trait named
// (traitStart,traitLen) — i.e. an `impl Type as Trait` was recorded (spec/08),
// or it is a built-in Eq/Ord conformance of a primitive/String.
fn typeConformsTo(c: inout Comp, typeStart: U64, typeLen: U64, traitStart: U64, traitLen: U64) -> Bool {
    if builtinEqOrd(c: inout c, typeStart: typeStart, typeLen: typeLen, traitStart: traitStart, traitLen: traitLen) {
        return true
    }
    val qType: U64 = intern(c: inout c, start: typeStart, len: typeLen)
    val qTrait: U64 = intern(c: inout c, start: traitStart, len: traitLen)
    mut val i: U64 = 0
    while i < c.conforms.count {
        val cf: Conform = c.conforms[i]
        if cf.typeId == qType {
            if cf.traitId == qTrait {
                return true
            }
        }
        i += 1
    }
    return false
}

// Whether type (typeStart,typeLen) conforms to the trait named `traitName`
// (a literal trait name, e.g. "Eq"/"Ord"). Used to gate operator desugaring on
// an explicit `impl T as Eq`/`as Ord` conformance (spec/12).
fn typeConformsToName(c: inout Comp, typeStart: U64, typeLen: U64, traitName: String) -> Bool {
    val qType: U64 = intern(c: inout c, start: typeStart, len: typeLen)
    mut val i: U64 = 0
    while i < c.conforms.count {
        val cf: Conform = c.conforms[i]
        if cf.typeId == qType {
            if rangeEquals(bytes: c.bytes, start: cf.traitStart, len: cf.traitLen, kw: traitName) {
                return true
            }
        }
        i += 1
    }
    return false
}

// Enforce `where T: Trait` bounds (spec/08) at each instantiation: the concrete
// type argument bound to a constrained type parameter must conform to the
// required trait, else a loud error. Runs after instantiation discovery.
fn checkFnBounds(c: inout Comp) {
    mut val ii: U64 = 0
    while ii < c.fnInsts.count {
        val fin: FnInst = c.fnInsts[ii]
        val f: Func = c.funcs[fin.fnIdx]
        mut val bi: U64 = 0
        while bi < c.funcBounds.count {
            val fb: FuncBound = c.funcBounds[bi]
            if fb.fnIdx == fin.fnIdx {
                mut val pi: U64 = 0
                while pi < f.typeParams.count {
                    val tp: Bind = f.typeParams[pi]
                    if tp.nameId == fb.paramNameId {
                        if pi < fin.args.count {
                            val at: TypeRef = c.types[fin.args[pi]]
                            if typeConformsTo(c: inout c, typeStart: at.nameStart, typeLen: at.nameLen, traitStart: fb.traitStart, traitLen: fb.traitLen) {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: fb.paramStart), msg: "type argument does not conform to the trait required by `where`")
                            }
                        }
                    }
                    pi += 1
                }
            }
            bi += 1
        }
        ii += 1
    }
    checkMethodBounds(c: inout c)
}

// Enforce `where T: Trait` bounds on generic *methods* at instantiation (gap #8,
// the receiver-driven counterpart of checkFnBounds). For each concrete receiver
// instantiation (Box[X]) and each of its methods carrying a `where` bound, the
// type argument bound to the constrained parameter must conform — else a loud
// error (closing the lenient hole where a non-conforming type that happens to
// have the method would slip through).
fn checkMethodBounds(c: inout Comp) {
    mut val gi: U64 = 0
    while gi < c.genInsts.count {
        val instRef: U64 = c.genInsts[gi]
        val inst: TypeRef = c.types[instRef]
        mut val mfi: U64 = 0
        while mfi < c.funcs.count {
            if methodMatchesInst(c: inout c, f: c.funcs[mfi], instRef: instRef) {
                val f: Func = c.funcs[mfi]
                mut val bi: U64 = 0
                while bi < c.funcBounds.count {
                    val fb: FuncBound = c.funcBounds[bi]
                    if fb.fnIdx == mfi {
                        mut val pi: U64 = 0
                        while pi < f.typeParams.count {
                            val tp: Bind = f.typeParams[pi]
                            if tp.nameId == fb.paramNameId {
                                if pi < inst.args.count {
                                    val at: TypeRef = c.types[inst.args[pi]]
                                    if typeConformsTo(c: inout c, typeStart: at.nameStart, typeLen: at.nameLen, traitStart: fb.traitStart, traitLen: fb.traitLen) {
                                    } else {
                                        compileErrorAt(line: lineOf(c: inout c, offset: fb.paramStart), msg: "receiver type argument does not conform to the trait required by the method's `where`")
                                    }
                                }
                            }
                            pi += 1
                        }
                    }
                    bi += 1
                }
            }
            mfi += 1
        }
        gi += 1
    }
}

// ---- #9: eager generic type-checking (check templates, not just instances) ----
//
// A generic function/method body is checked once, abstractly: a type parameter
// `T` is treated as a value whose only members are those its `where T: Trait`
// bounds provide. Calling a method (or `==`/`<`) on a `T`-typed value that no
// bound provides is an error at the *definition*, not deep in an instantiation
// (escaping C++-template ergonomics). Associated types are deferred, so chained
// calls whose receiver type is a type parameter's result degrade to unchecked.

// Whether (start,len) is a type parameter of function `fnIdx`.
fn isTypeParamOf(c: inout Comp, fnIdx: U64, start: U64, len: U64) -> Bool {
    if fnIdx >= c.funcs.count {
        return false
    }
    val tps: Array[Bind] = c.funcs[fnIdx].typeParams
    val qTp: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < tps.count {
        if tps[i].nameId == qTp {
            return true
        }
        i += 1
    }
    return false
}

// Whether a trait (by interned name id) — or, transitively, one of its
// supertraits (spec/08: `trait Sub: Super` means conforming to Sub guarantees
// conforming to Super, so Super's members are callable through a `T: Sub` bound)
// — provides a member named `qName` whose labels match `args`, as a requirement
// (TraitDef.reqs) or a provided method (a fn with recv = the trait). `depth`
// guards against a malformed cyclic inheritance chain.
fn traitProvidesMember(c: inout Comp, traitNameId: U64, qName: U64, args: Array[Arg], depth: U64) -> Bool {
    if depth > 64U64 {
        return false
    }
    mut val ti: U64 = 0
    while ti < c.traits.count {
        val t: TraitDef = c.traits[ti]
        if t.nameId == traitNameId {
            // requirement of this trait
            mut val ri: U64 = 0
            while ri < t.reqs.count {
                val r: Func = t.reqs[ri]
                if r.nameId == qName {
                    if paramsLabelsOk(c: inout c, params: r.params, args: args) {
                        return true
                    }
                }
                ri += 1
            }
            // recurse into supertraits (`trait Sub: Super + ...`)
            mut val sti: U64 = 0
            while sti < t.supertraits.count {
                val sup: Bind = t.supertraits[sti]
                val supId: U64 = intern(c: inout c, start: sup.nameStart, len: sup.nameLen)
                if traitProvidesMember(c: inout c, traitNameId: supId, qName: qName, args: args, depth: depth + 1U64) {
                    return true
                }
                sti += 1
            }
        }
        ti += 1
    }
    // provided method of this trait (a method with recv = the trait)
    mut val gi: U64 = 0
    while gi < c.funcs.count {
        val g: Func = c.funcs[gi]
        if g.hasRecv {
            if g.recvId == traitNameId {
                if g.nameId == qName {
                    if paramsLabelsOk(c: inout c, params: g.params, args: args) {
                        return true
                    }
                }
            }
        }
        gi += 1
    }
    return false
}

// Whether some `where`-bound trait of type parameter (tpStart,tpLen) on function
// `fnIdx` provides a member named (nameStart,nameLen) whose labels match `args`
// — as a requirement (TraitDef.reqs) or a provided method (recv = the trait),
// including members inherited from the bound trait's supertraits.
fn boundProvidesMethod(c: inout Comp, fnIdx: U64, tpStart: U64, tpLen: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) -> Bool {
    val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    val qTp: U64 = intern(c: inout c, start: tpStart, len: tpLen)
    mut val bi: U64 = 0
    while bi < c.funcBounds.count {
        val fb: FuncBound = c.funcBounds[bi]
        if fb.fnIdx == fnIdx {
            if fb.paramNameId == qTp {
                val qTrait: U64 = intern(c: inout c, start: fb.traitStart, len: fb.traitLen)
                if traitProvidesMember(c: inout c, traitNameId: qTrait, qName: qName, args: args, depth: 0U64) {
                    return true
                }
            }
        }
        bi += 1
    }
    return false
}

// Whether type parameter (tpStart,tpLen) on `fnIdx` is bound by a trait named
// `traitName` (for the Eq/Ord operator checks).
fn boundHasTraitNamed(c: inout Comp, fnIdx: U64, tpStart: U64, tpLen: U64, traitName: String) -> Bool {
    val qTp: U64 = intern(c: inout c, start: tpStart, len: tpLen)
    mut val bi: U64 = 0
    while bi < c.funcBounds.count {
        val fb: FuncBound = c.funcBounds[bi]
        if fb.fnIdx == fnIdx {
            if fb.paramNameId == qTp {
                if rangeEquals(bytes: c.bytes, start: fb.traitStart, len: fb.traitLen, kw: traitName) {
                    return true
                }
            }
        }
        bi += 1
    }
    return false
}

fn checkBoundsExpr(c: inout Comp, exprId: U64) {
    match c.exprs[exprId] {
        Expr.Unary(val op, val operand) => { checkBoundsExpr(c: inout c, exprId: operand) }
        Expr.Binary(val op, val lhs, val rhs) => {
            checkBoundsExpr(c: inout c, exprId: lhs)
            checkBoundsExpr(c: inout c, exprId: rhs)
            if op >= 50 {
                if op <= 55 {
                    val lt: TypeInfo = exprType(c: inout c, id: lhs)
                    if lt.kind == 2 {
                        if isTypeParamOf(c: inout c, fnIdx: c.curCheckFn, start: lt.nameStart, len: lt.nameLen) {
                            mut val need: String = "Ord"
                            if op == opEq() { need = "Eq" }
                            if op == opNe() { need = "Eq" }
                            if boundHasTraitNamed(c: inout c, fnIdx: c.curCheckFn, tpStart: lt.nameStart, tpLen: lt.nameLen, traitName: need) {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison on a type parameter needs an Eq/Ord bound (add `where T: Eq` / `: Ord`)")
                            }
                        }
                    }
                }
            }
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            mut val i: U64 = 0
            while i < args.count {
                checkBoundsExpr(c: inout c, exprId: args[i].expr)
                i += 1
            }
        }
        Expr.ExtMethod(val recv, srcStart: _, srcLen: _, nameStart: _, nameLen: _, val args) => {
            checkBoundsExpr(c: inout c, exprId: recv)
            mut val i: U64 = 0
            while i < args.count {
                checkBoundsExpr(c: inout c, exprId: args[i].expr)
                i += 1
            }
        }
        Expr.ExtView(val recv, srcStart: _, srcLen: _, strip: _) => {
            checkBoundsExpr(c: inout c, exprId: recv)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            checkBoundsExpr(c: inout c, exprId: recv)
            mut val i: U64 = 0
            while i < args.count {
                checkBoundsExpr(c: inout c, exprId: args[i].expr)
                i += 1
            }
            val rt: TypeInfo = exprType(c: inout c, id: recv)
            if rt.kind == 2 {
                if isTypeParamOf(c: inout c, fnIdx: c.curCheckFn, start: rt.nameStart, len: rt.nameLen) {
                    if boundProvidesMethod(c: inout c, fnIdx: c.curCheckFn, tpStart: rt.nameStart, tpLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "method not provided by the bounds of this type parameter (add a `where T: Trait` that declares it)")
                    }
                }
            }
        }
        Expr.Field(val base, val nameStart, val nameLen) => { checkBoundsExpr(c: inout c, exprId: base) }
        Expr.Index(val base, val index) => {
            checkBoundsExpr(c: inout c, exprId: base)
            checkBoundsExpr(c: inout c, exprId: index)
        }
        Expr.Make(val typeStart, val typeLen, val variantStart, val variantLen, val isEnum, val ty, val fields) => {
            mut val i: U64 = 0
            while i < fields.count {
                checkBoundsExpr(c: inout c, exprId: fields[i].value)
                i += 1
            }
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count {
                checkBoundsExpr(c: inout c, exprId: elems[i])
                i += 1
            }
        }
        Expr.Cast(val operand, val tyStart, val tyLen, val ty) => { checkBoundsExpr(c: inout c, exprId: operand) }
        Expr.OptChain(val base, memberStart: _, memberLen: _) => { checkBoundsExpr(c: inout c, exprId: base) }
        Expr.Try(val expr) => { checkBoundsExpr(c: inout c, exprId: expr) }
        Expr.Arrow(val base, val nameStart, val nameLen) => { checkBoundsExpr(c: inout c, exprId: base) }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            checkBoundsExpr(c: inout c, exprId: cond)
            checkBoundsBlock(c: inout c, blkId: thenBlk)
            checkBoundsBlock(c: inout c, blkId: elseBlk)
        }
        Expr.MatchExpr(val scrut, val arms) => {
            checkBoundsExpr(c: inout c, exprId: scrut)
            mut val ai: U64 = 0
            while ai < arms.count {
                val a: MatchArm = arms[ai]
                val mark: U64 = scopeMark(c: inout c)
                scanAddArmBinds(c: inout c, a: a, scrutTi: exprType(c: inout c, id: scrut))
                checkBoundsExpr(c: inout c, exprId: a.body)
                popLocals(c: inout c, mark: mark)
                ai += 1
            }
        }
        Expr.Move(val operand, val isBorrow) => { checkBoundsExpr(c: inout c, exprId: operand) }
        _ => {}
    }
}

fn checkBoundsStmt(c: inout Comp, stmtId: U64) {
    match c.stmts[stmtId] {
        Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
            checkBoundsExpr(c: inout c, exprId: init)
            addLocal(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray, ty: ty, isInout: false, isMut: mutable, owned: true)
        }
        Stmt.Assign(val op, val target, val value) => {
            checkBoundsExpr(c: inout c, exprId: target)
            checkBoundsExpr(c: inout c, exprId: value)
        }
        Stmt.ExprStmt(val expr) => { checkBoundsExpr(c: inout c, exprId: expr) }
        Stmt.Return(val value, val hasValue) => {
            if hasValue {
                checkBoundsExpr(c: inout c, exprId: value)
            }
        }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            checkBoundsExpr(c: inout c, exprId: cond)
            checkBoundsBlock(c: inout c, blkId: thenBlk)
            if hasElse {
                checkBoundsBlock(c: inout c, blkId: elseBlk)
            }
        }
        Stmt.While(val cond, val body) => {
            checkBoundsExpr(c: inout c, exprId: cond)
            checkBoundsBlock(c: inout c, blkId: body)
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, val inclusive, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            val forMark: U64 = scopeMark(c: inout c)
            checkBoundsExpr(c: inout c, exprId: iter)
            if isRange {
                checkBoundsExpr(c: inout c, exprId: rangeHi)
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: 0, tyLen: 0, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
            } else {
                val et: TypeInfo = exprType(c: inout c, id: iter)
                if isStruct {
                    addForStructBinds(c: inout c, et: et, binds: binds)
                } else {
                    if et.kind == 3 {
                        addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                    } else {
                        // a general Iterable: the loop var is the iterator's Item type.
                        val elemTi: TypeInfo = iterableItemInfo(c: inout c, et: et)
                        addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: elemTi.nameStart, tyLen: elemTi.nameLen, isArray: elemTi.kind == 3, ty: elemTi.ref, isInout: false, isMut: false, owned: false)
                    }
                }
            }
            checkBoundsBlock(c: inout c, blkId: body)
            popLocals(c: inout c, mark: forMark)
        }
        Stmt.Match(val scrut, val arms) => {
            checkBoundsExpr(c: inout c, exprId: scrut)
            mut val ai: U64 = 0
            while ai < arms.count {
                val a: MatchArm = arms[ai]
                val mark: U64 = scopeMark(c: inout c)
                scanAddArmBinds(c: inout c, a: a, scrutTi: exprType(c: inout c, id: scrut))
                checkBoundsBlock(c: inout c, blkId: a.body)
                popLocals(c: inout c, mark: mark)
                ai += 1
            }
        }
        Stmt.Panic(val msg, val offset) => { checkBoundsExpr(c: inout c, exprId: msg) }
        Stmt.Give(val value) => { checkBoundsExpr(c: inout c, exprId: value) }
        Stmt.Break => {}
        Stmt.Continue => {}
    }
}

fn checkBoundsBlock(c: inout Comp, blkId: U64) {
    val mark: U64 = scopeMark(c: inout c)
    val stmts: Array[U64] = c.blocks[blkId].stmts
    mut val i: U64 = 0
    while i < stmts.count {
        checkBoundsStmt(c: inout c, stmtId: stmts[i])
        i += 1
    }
    popLocals(c: inout c, mark: mark)
}

// Eager type-check every generic template body (#9): a method/operator on a
// type-parameter-typed value must be provided by that parameter's `where`
// bounds. Runs once per template, with no concrete env (so a type-parameter
// local reports as its abstract name). Does not emit C (a validation pass).
fn checkGenericBodies(c: inout Comp) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        // skip extern fns: they have no body (`body == 0` is a sentinel, not a real
        // block). Generic externs like `arrayPush[T]` would otherwise have block 0
        // (some unrelated function's body) walked under their own bound-less type
        // params, mis-flagging method calls inside it.
        if f.typeParams.count > 0 && !f.isExtern {
            val noParams: Array[Bind] = []
            val noArgs: Array[U64] = []
            c.locals = []
            seedGlobalLocals(c: inout c)
            c.curHasRecv = f.hasRecv
            c.curRecvStart = f.recvStart
            c.curRecvLen = f.recvLen
            c.curSelfInout = f.selfInout
            c.curRecvInstRef = 0
            c.curTypeParams = noParams
            c.curTypeArgs = noArgs
            c.curCheckFn = fi
            mut val pi: U64 = 0
            while pi < f.params.count {
                val p: Param = f.params[pi]
                addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: false)
                pi += 1
            }
            checkBoundsBlock(c: inout c, blkId: f.body)
        }
        fi += 1
    }
    c.locals = []
    c.curHasRecv = false
    c.curCheckFn = c.funcs.count
}

// Whether two parameter lists have the same label sequence (arity + labels) —
// the "selector" minus types. Used to detect a generic/concrete overload clash.
fn sameLabels(c: inout Comp, a: Array[Param], b: Array[Param]) -> Bool {
    if a.count != b.count {
        return false
    }
    mut val i: U64 = 0
    while i < a.count {
        if a[i].nameId == b[i].nameId {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Reject a generic and another overload that share the same selector (name +
// labels) — spec/07 forbids a generic-vs-concrete (or generic-vs-generic) clash
// even if it could otherwise resolve. Free functions only (methods overload per
// receiver type). Synthesized members are methods/assoc fns and so skipped.
fn checkOverloadCollisions(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val fi: Func = c.funcs[i]
        if fi.hasRecv {
        } else {
            if fi.isAssoc {
            } else {
                mut val j: U64 = i + 1
                while j < c.funcs.count {
                    val fj: Func = c.funcs[j]
                    if fj.hasRecv {
                    } else {
                        if fj.isAssoc {
                        } else {
                            if fi.nameId == fj.nameId {
                                if sameLabels(c: inout c, a: fi.params, b: fj.params) {
                                    if fi.typeParams.count > 0 {
                                        compileErrorAt(line: lineOf(c: inout c, offset: fj.nameStart), msg: "a generic function shares its selector (name + labels) with another overload; spec forbids generic/concrete overload on the same selector")
                                    } else {
                                        if fj.typeParams.count > 0 {
                                            compileErrorAt(line: lineOf(c: inout c, offset: fj.nameStart), msg: "a generic function shares its selector (name + labels) with another overload; spec forbids generic/concrete overload on the same selector")
                                        }
                                    }
                                }
                            }
                        }
                    }
                    j += 1
                }
            }
        }
        i += 1
    }
}

// Reject defining methods on a built-in type (spec/07: anonymous/inherent impl
// only for a type your module defines; primitives/String are never user-defined,
// so an `impl I32 { }` / `impl String { }` is always illegal). Trait additions to
// built-ins go through `#Ext` (deferred).

// Does the method/assoc named (mStart,mLen) on type (recvStart,recvLen) witness a
// trait the type conforms to? (i.e. the type has an `impl T as Trait` and Trait
// declares a requirement of this name.) Used to allow Core's `impl I32 as Format`
// while still rejecting an inherent `impl I32 { fn foo }` on a primitive.
fn methodWitnessesAConformance(c: inout Comp, recvStart: U64, recvLen: U64, mStart: U64, mLen: U64) -> Bool {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val qM: U64 = intern(c: inout c, start: mStart, len: mLen)
    mut val ci: U64 = 0
    while ci < c.conforms.count {
        val cf: Conform = c.conforms[ci]
        if cf.typeId == qRecv {
            mut val ti: U64 = 0
            while ti < c.traits.count {
                val tr: TraitDef = c.traits[ti]
                if tr.nameId == cf.traitId {
                    mut val ri: U64 = 0
                    while ri < tr.reqs.count {
                        if tr.reqs[ri].nameId == qM {
                            return true
                        }
                        ri += 1
                    }
                }
                ti += 1
            }
        }
        ci += 1
    }
    return false
}

// Whether two methods share a selector (same name + same parameter labels in
// order) — the spec/09 collision criterion (differing param types are overloads).
fn sameSelector(c: inout Comp, a: Func, b: Func) -> Bool {
    if a.nameId != b.nameId {
        return false
    }
    if a.params.count != b.params.count {
        return false
    }
    mut val i: U64 = 0
    while i < a.params.count {
        if a.params[i].noLabel != b.params[i].noLabel {
            return false
        }
        if a.params[i].noLabel {
        } else {
            if a.params[i].nameId != b.params[i].nameId {
                return false
            }
        }
        i += 1
    }
    return true
}

// defaultExtension collisions (spec/09): a method a type put on its bare surface
// via `defaultExtension #Ext` must not share a selector with the type's own /
// provided / another default extension's method (both would join bare resolution
// ambiguously). Reported at the type — loud, not a silent shadow.
fn checkDefaultExtCollisions(c: inout Comp) {
    mut val di: U64 = 0
    while di < c.defaultExts.count {
        val de: DefaultExt = c.defaultExts[di]
        mut val fi: U64 = 0
        while fi < c.funcs.count {
            val f: Func = c.funcs[fi]
            if f.hasRecv {
                if f.recvId == de.typeId {
                    if f.extId == de.extId {
                        // this is a default-ext method on the type; check against
                        // every other bare-callable method on the same type (own,
                        // provided, or another default extension).
                        mut val gi: U64 = 0
                        while gi < c.funcs.count {
                            if gi == fi {
                            } else {
                                val g: Func = c.funcs[gi]
                                if g.hasRecv {
                                    if g.recvId == de.typeId {
                                        mut val gBare: Bool = false
                                        if g.extId == 0U64 {
                                            gBare = true
                                        } else {
                                            if isDefaultExt(c: inout c, typeId: de.typeId, extId: g.extId) {
                                                gBare = true
                                            }
                                        }
                                        if gBare {
                                            if sameSelector(c: inout c, a: f, b: g) {
                                                compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "defaultExtension method collides with another bare-callable method of the same selector on this type (don't make it default, or rename — spec/09)")
                                            }
                                        }
                                    }
                                }
                            }
                            gi += 1
                        }
                    }
                }
            }
            fi += 1
        }
        di += 1
    }
}

fn checkImplOnBuiltin(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        // only primitive *scalars* (I8..U64, Bool) are method-less: their behaviour
        // is trait-only, so an inherent method on one is rejected. `String`/`Array`
        // are owned aggregate lang-items that legitimately carry inherent methods
        // (`isEmpty`, `append`, …) written in Core, so they are not in this group.
        mut val onBuiltin: Bool = false
        if f.hasRecv {
            onBuiltin = isPrimType(c: inout c, start: f.recvStart, len: f.recvLen)
        } else {
            if f.isAssoc {
                onBuiltin = isPrimType(c: inout c, start: f.recvStart, len: f.recvLen)
            }
        }
        // a *trait-conformance* member on a primitive/String is allowed: Core owns
        // the type (`extern { struct I32 }`) and may coherently `impl I32 as Format`
        // (spec/07,09). An *inherent* method on a primitive (`impl I32 { fn foo }`)
        // is still rejected — primitive behaviour is trait-only, and a third party
        // must use `#Ext`. (Full owner-only enforcement of conformances awaits
        // module identity; a non-witnessing inherent method is the case we can tell
        // apart in the flat model, and it covers the impl-on-builtin footgun.)
        if onBuiltin {
            if methodWitnessesAConformance(c: inout c, recvStart: f.recvStart, recvLen: f.recvLen, mStart: f.nameStart, mLen: f.nameLen) {
                onBuiltin = false
            }
        }
        // an extension method (`extension Ext { impl I64 { … } }`) legitimately adds
        // behaviour to a built-in via the `#Ext` view (spec/09) — not bare — so it is
        // exempt from the inherent-method-on-builtin rejection.
        if f.extId != 0U64 {
            onBuiltin = false
        }
        if onBuiltin {
            compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "cannot define methods on a built-in type you do not own (use a trait conformance via core, or an extension `#Ext`)")
        }
        i += 1
    }
}

// Reject `move fn` (consuming self) on a non-unique type (spec/07: a consuming
// receiver is only meaningful for a unique/move-only type; on a copyable type it
// is a footgun, like `move` on a copyable parameter).
fn checkMoveFnReceivers(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.selfMove {
                if typeIsUnique(c: inout c, start: f.recvStart, len: f.recvLen) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "`move fn` (consuming self) is only allowed on a unique type")
                }
            }
        }
        i += 1
    }
}

// Is `(nameStart,nameLen)` the name of an `export`ed declaration (spec/15)? Matched
// by text against the recorded export name spans (across all loaded modules).
fn isExportedName(c: inout Comp, nameStart: U64, nameLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.exports.count {
        val e: Bind = c.exports[i]
        if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: nameStart, bLen: nameLen) {
            return true
        }
        i += 1
    }
    return false
}

// Module visibility (spec/15): every name brought in by `import … with { }` must be
// part of some loaded module's public surface (`export`). A use of a non-exported
// name — or an import from the wrong module (whose own module then isn't loaded, so
// the name is absent from the exported set) — is a compile error.
fn checkImports(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.imports.count {
        val im: Bind = c.imports[i]
        if isExportedName(c: inout c, nameStart: im.nameStart, nameLen: im.nameLen) {
        } else {
            compileErrorAt(line: lineOf(c: inout c, offset: im.nameStart), msg: "imported name is not exported (mark it `export` in its module, or import it from the right module)")
        }
        i += 1
    }
}

// Was the name `(nameStart,nameLen)` imported into module `mod` via `import … with`?
fn isImportedInto(c: inout Comp, mod: U64, nameStart: U64, nameLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.imports.count {
        val im: Bind = c.imports[i]
        if im.fieldStart == mod {
            if spansEqual(c: inout c, aStart: im.nameStart, aLen: im.nameLen, bStart: nameStart, bLen: nameLen) {
                return true
            }
        }
        i += 1
    }
    return false
}

// Use-site module visibility (spec/15): a free-function call whose callee is defined
// in another module is valid only if that name was imported into the using module
// (`import … with { }`) — relying on the flat namespace is not allowed. Same-module
// calls (the whole compiler is one module = its `part` tree) and unresolved names
// (locals/closures/builtins not in c.funcs) are left alone. Types stay ambient, so
// only function calls are gated here; member/method visibility is a separate axis.
fn checkUseVisibility(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        match c.exprs[i] {
            Expr.Call(val nameStart, val nameLen, val args) => {
                val fi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
                if fi < c.funcs.count {
                    val useMod: U64 = moduleOf(c: inout c, offset: nameStart)
                    val defMod: U64 = moduleOf(c: inout c, offset: c.funcs[fi].nameStart)
                    if useMod == defMod {
                    } else {
                        if isImportedInto(c: inout c, mod: useMod, nameStart: nameStart, nameLen: nameLen) {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "use of a function from another module without importing it (add `import … with { … }`)")
                        }
                    }
                } else {
                    // an `@Std` intrinsic the LLVM backend intercepts by raw name
                    // (print / write / exit / …) is NOT ambient (spec/15: only lang
                    // items are): it must be imported. The backend would otherwise
                    // emit it regardless of import (and the front-end leaves an
                    // unresolved call alone), so gate it here. OK if the using module
                    // imported it or defines its own same-named function.
                    if isAmbientInterceptedName(c: inout c, start: nameStart, len: nameLen) {
                        val useMod2: U64 = moduleOf(c: inout c, offset: nameStart)
                        if isImportedInto(c: inout c, mod: useMod2, nameStart: nameStart, nameLen: nameLen) {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "this @Std function is not ambient — import it (e.g. `import @Std/Io with { print }`); only lang items are usable without import (spec/15)")
                        }
                    }
                }
                i += 1
            }
            _ => { i += 1 }
        }
    }
}

// Is (start,len) the name of an `@Std` function the LLVM backend intercepts by raw
// name (so it would emit without an import)? These need a real import gate (spec/15):
// the user-facing I/O / process / async intrinsics. (The RawBuffer/String/FFI floor
// intrinsics are resolved through their loaded `extern` decls, so they fall under
// the ordinary import check above and are not listed here.)
fn isAmbientInterceptedName(c: inout Comp, start: U64, len: U64) -> Bool {
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "print") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "eprint") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "write") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "writeByte") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "readStdin") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "readFile") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "readFileBytes") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "fileExists") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "sleep") { return true }
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "exit") { return true }
    // `assert` is a @Std/Core function (not a lang item): now that Core is ambient
    // (force-loaded), it resolves, but spec keeps it import-required, so gate it here.
    if rangeEquals(bytes: c.bytes, start: start, len: len, kw: "assert") { return true }
    return false
}

// Missing-return check (spec/11, loud-failure principle): Plew does not implicitly
// return a function's tail expression, so a non-`()` function whose body can reach
// the end without `return`/`panic`/divergence would silently return uninitialized
// memory. Reject that loudly. A block "always diverges" if any of its statements
// does (control then never falls through to the block's end); a statement diverges
// if it is `return`/`panic`, an `if`/`else` whose both branches diverge, an
// (exhaustive) `match` whose every arm diverges, or an unconditional infinite loop
// (`while true { … }` with no `break` that exits it).

// Does control fall off the end of this block, or does it always leave via
// return/panic/diverging-control? True = always diverges (never falls through).
fn blockDiverges(c: inout Comp, blkId: U64) -> Bool {
    val blk: Block = c.blocks[blkId]
    val stmts: Array[U64] = blk.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        if stmtDiverges(c: inout c, stmtId: stmts[i]) {
            return true
        }
        i += 1
    }
    return false
}

// Whether a `break` (that exits THIS loop, not a nested one) appears in the block —
// used to tell whether `while true { … }` can fall through. Nested loops shadow
// their own `break`, so recurse into ifs/matches but not into while/for bodies.
fn blockHasLoopBreak(c: inout Comp, blkId: U64) -> Bool {
    val blk: Block = c.blocks[blkId]
    val stmts: Array[U64] = blk.stmts
    mut val i: U64 = 0
    while i < stmts.count {
        if stmtHasLoopBreak(c: inout c, stmtId: stmts[i]) {
            return true
        }
        i += 1
    }
    return false
}

fn stmtHasLoopBreak(c: inout Comp, stmtId: U64) -> Bool {
    match c.stmts[stmtId] {
        Stmt.Break => { return true }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            if blockHasLoopBreak(c: inout c, blkId: thenBlk) {
                return true
            }
            if hasElse {
                return blockHasLoopBreak(c: inout c, blkId: elseBlk)
            }
            return false
        }
        Stmt.Match(val scrut, val arms) => {
            mut val i: U64 = 0
            while i < arms.count {
                if blockHasLoopBreak(c: inout c, blkId: arms[i].body) {
                    return true
                }
                i += 1
            }
            return false
        }
        _ => { return false }
    }
}

fn stmtDiverges(c: inout Comp, stmtId: U64) -> Bool {
    match c.stmts[stmtId] {
        Stmt.Return(val value, val hasValue) => { return true }
        Stmt.Panic(val msg, val offset) => { return true }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            if hasElse {
                if blockDiverges(c: inout c, blkId: thenBlk) {
                    return blockDiverges(c: inout c, blkId: elseBlk)
                }
            }
            return false
        }
        Stmt.Match(val scrut, val arms) => {
            // match is exhaustive (checkMatchBinds / structural exhaustiveness), so
            // it diverges iff every arm's block diverges.
            if arms.count == 0 {
                return false
            }
            mut val i: U64 = 0
            while i < arms.count {
                if blockDiverges(c: inout c, blkId: arms[i].body) {
                } else {
                    return false
                }
                i += 1
            }
            return true
        }
        Stmt.While(val cond, val body) => {
            // an unconditional `while true { … }` with no exiting `break` never falls
            // through (it loops forever or leaves via return/panic inside).
            if condIsLiteralTrue(c: inout c, id: cond) {
                return !blockHasLoopBreak(c: inout c, blkId: body)
            }
            return false
        }
        _ => { return false }
    }
}

// Is the condition expression the literal `true`?
fn condIsLiteralTrue(c: inout Comp, id: U64) -> Bool {
    if id >= c.exprs.count {
        return false
    }
    match c.exprs[id] {
        Expr.Int(val value, val offset, val isBool, val tyStart, val tyLen, isNeg: _) => {
            return isBool && value == 1
        }
        _ => { return false }
    }
}

// Enforce that every non-`()` function returns on all paths (no silent fall-off).
fn checkReturns(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        // exempt: `()`-returning (hasRet false), `main` (returns int), extern (no
        // body), provided/abstract (body 0), and async (state-machine return).
        if f.hasRet {
            if f.isExtern {
            } else {
                if f.isAsync {
                } else {
                    if f.body == 0 {
                    } else {
                        if nameIsMain(c: inout c, f: f) {
                        } else {
                            if blockDiverges(c: inout c, blkId: f.body) {
                            } else {
                                compileErrorAt(line: lineOf(c: inout c, offset: f.nameStart), msg: "this function has a return type but can reach the end of its body without returning a value; add a `return` (or `panic`) on every path (Plew does not implicitly return the last expression)")
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
}
