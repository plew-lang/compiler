// Part of the acceptance verification pass (root: _.pw): argument, field/
// method visibility, binary-operator, and `as`-cast lossless checks.

// verify each call/method argument's expression (the arg-mode checks themselves
// run via checkLitCtx -> checkCallArgs -> checkUniqueArgModes).

pub impl Comp {
    inout fn verifyArgs(args: Array[Arg]) {
        mut val i: U64 = 0
        while i < args.count {
            verifyExpr(c: inout self, id: args[i].expr)
            i += 1
        }
        // overlapping `inout` (spec/03): two or more `inout` arguments of ONE call that
        // name the SAME place are forbidden — last-write-wins would be a silent bug. This
        // is the syntactic case ① (identical place expressions); distinct-provability for
        // subscripts (case ②/③) is a separate lint/runtime concern.
        mut val a: U64 = 0
        while a < args.count {
            if args[a].isInout {
                mut val b: U64 = a + 1U64
                while b < args.count {
                    if args[b].isInout {
                        if self.exprSyntaxEq(a: args[a].expr, b: args[b].expr) {
                            compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: args[b].expr)), msg: "two `inout` arguments refer to the same place in one call; overlapping `inout` is forbidden (last-write-wins would be a silent bug)")
                        }
                    }
                    b += 1U64
                }
            }
            a += 1U64
        }
    }

    inout fn exprSyntaxEq(a: U64, b: U64) -> Bool {
        match self.arena.exprs[a] {
            Expr.Ident(start: val s1, len: val l1) => {
                match self.arena.exprs[b] {
                    Expr.Ident(start: val s2, len: val l2) => { return spansEqual(c: inout self, aStart: s1, aLen: l1, bStart: s2, bLen: l2) }
                    _ => { return false }
                }
            }
            Expr.Int(value: val v1, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg1) => {
                match self.arena.exprs[b] {
                    Expr.Int(value: val v2, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg2) => { return v1 == v2 && neg1 == neg2 }
                    _ => { return false }
                }
            }
            Expr.Field(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[b] {
                    Expr.Field(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            Expr.Arrow(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
                match self.arena.exprs[b] {
                    Expr.Arrow(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout self, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && self.exprSyntaxEq(a: base1, b: base2) }
                    _ => { return false }
                }
            }
            Expr.Index(base: val base1, index: val idx1) => {
                match self.arena.exprs[b] {
                    Expr.Index(base: val base2, index: val idx2) => { return self.exprSyntaxEq(a: base1, b: base2) && self.exprSyntaxEq(a: idx1, b: idx2) }
                    _ => { return false }
                }
            }
            _ => { return false }
        }
    }

    inout fn verifyFieldReadVis(base: U64, nameStart: U64, nameLen: U64) {
        val bt: TypeInfo = typeOf(c: inout self, id: base)
        if bt.kind == 2 {
            if fieldVis(c: inout self, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen) == 3U64 {
                if typeHasMethodNamed(c: inout self, recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: nameStart, nameLen: nameLen) {
                    compileErrorAt(line: lineOf(c: inout self, offset: nameStart), msg: "a method cannot be used as a value; call it, or wrap it in a closure (e.g. `fn() { obj.method() }`)")
                }
            }
            checkFieldReadVis(c: inout self, ownerStart: bt.nameStart, ownerLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
        } else {
            if bt.kind == 3 {
                val arrName: Bind = kwSpan(c: inout self, kw: "Array", kwLen: 5)
                checkFieldReadVis(c: inout self, ownerStart: arrName.nameStart, ownerLen: arrName.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
            }
        }
    }

    inout fn verifyMethodVis(recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
        val rt: TypeInfo = typeOf(c: inout self, id: recv)
        if rt.kind == 2 {
            // resolve the method on the receiver type to get its Func (checkMethodVis
            // inspects the impl block's visibility); skip if unresolved (a separate
            // "no such method" diagnostic covers that).
            val mi: U64 = findMethod(c: inout self, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
            if mi < self.arena.funcs.count {
                checkMethodVis(c: inout self, ownerStart: rt.nameStart, ownerLen: rt.nameLen, mf: self.arena.funcs[mi], offset: nameStart)
                // an `inout fn` method mutates the receiver, so it must be a mutable PLACE
                // — not an rvalue temporary (`<S…/>.bump()` / `mk().bump()` would mutate a
                // value that is immediately discarded — spec/03).
                if self.arena.funcs[mi].selfInout {
                    if !(exprIsPlace(c: inout self, id: recv)) {
                        compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: recv)), msg: "cannot call an `inout fn` method on a temporary value; the receiver must be a place (a variable or field) declared `mut val` (spec/03)")
                    }
                    if !(placeIsMutable(c: inout self, id: recv)) {
                        compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: recv)), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
                    }
                    // overlapping `inout` (spec/03 case ①): an `inout fn` self IS an inout
                    // position, so an `inout` argument naming the same place as the receiver
                    // overlaps — last-write-wins would be a silent bug.
                    mut val k: U64 = 0
                    while k < args.count {
                        if args[k].isInout {
                            if self.exprSyntaxEq(a: recv, b: args[k].expr) {
                                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: args[k].expr)), msg: "the receiver of an `inout fn` and an `inout` argument refer to the same place; overlapping `inout` is forbidden (last-write-wins would be a silent bug)")
                            }
                        }
                        k += 1U64
                    }
                }
            }
        }
        // a mutating built-in array method (`append`) on an immutable / non-place array.
        if rt.kind == 3 {
            if rangeEquals(bytes: self.arena.bytes, start: nameStart, len: nameLen, kw: "append") {
                if !(exprIsPlace(c: inout self, id: recv)) {
                    compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: recv)), msg: "cannot `append` to a temporary array; the receiver must be a place declared `mut val` (spec/03)")
                }
                if !(placeIsMutable(c: inout self, id: recv)) {
                    compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: recv)), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
                }
            }
        }
    }

    inout fn exprIsFloat(id: U64) -> Bool {
        match self.arena.exprs[id] {
            Expr.Float(start: _, len: _, tyStart: _, tyLen: _) => { return true }
            _ => {}
        }
        // a value whose recovered type names a float type — by NAME regardless of kind
        // (F64 is in isPrimType so typeOf gives kind 0 for a local, but kind 2 for a literal).
        val ti: TypeInfo = typeOf(c: inout self, id: id)
        if ti.nameLen > 0U64 {
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F64") {
                return true
            }
            if rangeEquals(bytes: self.arena.bytes, start: ti.nameStart, len: ti.nameLen, kw: "F32") {
                return true
            }
        }
        return false
    }

    inout fn verifyBinaryOp(op: I64, lhs: U64, rhs: U64) {
        // float arithmetic / comparison is accepted directly (the backend emits the IEEE
        // op); `%`/`Rem` is integer-only, so reject it on a float (spec/12).
        if self.exprIsFloat(id: lhs) || self.exprIsFloat(id: rhs) {
            if op == opRem() {
                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: lhs)), msg: "`%` (remainder) is integer-only; not defined for floats (spec/12)")
            }
            return
        }
        if isStringEq(c: inout self, op: op, lhs: lhs) {
            return
        }
        if hasCompareWitness(c: inout self, op: op, lhs: lhs, rhs: rhs) {
            return
        }
        if isEnumEq(c: inout self, op: op, lhs: lhs) {
            self.verifyEnumEqPayload(lhs: lhs, rhs: rhs)
            return
        }
        if compareNeedsTrait(c: inout self, op: op, lhs: lhs, rhs: rhs) {
            compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
            return
        }
        if hasBinTraitWitness(c: inout self, op: op, lhs: lhs, rhs: rhs) {
            return
        }
        if binTraitNeedsTrait(c: inout self, op: op, lhs: lhs, rhs: rhs) {
            compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: lhs)), msg: "arithmetic operator needs Add/Sub/Mul/Div/Rem; not implemented for this type")
        }
    }

    inout fn verifyEnumEqPayload(lhs: U64, rhs: U64) {
        val lt: TypeInfo = typeOf(c: inout self, id: lhs)
        mut val enStart: U64 = 0
        mut val enLen: U64 = 0
        if lt.kind == 2 {
            enStart = lt.nameStart
            enLen = lt.nameLen
        } else {
            val rt: TypeInfo = typeOf(c: inout self, id: rhs)
            enStart = rt.nameStart
            enLen = rt.nameLen
        }
        if !(isAllNullary(c: inout self, start: enStart, len: enLen)) {
            compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: lhs)), msg: "enum == needs structural Eq for payload variants (only all-nullary enums compare by tag)")
        }
    }

    inout fn castOperandIsBool(operand: U64) -> Bool {
        match self.arena.exprs[operand] {
            Expr.Int(value: _, offset: _, val isBool, tyStart: _, tyLen: _, isNeg: _) => {
                if isBool { return true }
            }
            _ => {}
        }
        val st: TypeInfo = typeOf(c: inout self, id: operand)
        if st.nameLen > 0U64 {
            return rangeEquals(bytes: self.arena.bytes, start: st.nameStart, len: st.nameLen, kw: "Bool")
        }
        return false
    }

    inout fn verifyCastLossless(operand: U64, tyStart: U64, tyLen: U64) {
        // Bool is not a numeric type, so `as` (the lossless numeric / newtype-retag
        // conversion, spec/12) can't bridge Bool and a numeric type in either direction
        // (`true as I64`, `1I64 as Bool`) — use match / a comparison instead.
        val targetBool: Bool = rangeEquals(bytes: self.arena.bytes, start: tyStart, len: tyLen, kw: "Bool")
        val targetNum: Bool = isIntType(c: inout self, start: tyStart, len: tyLen) || isFloatType(c: inout self, start: tyStart, len: tyLen)
        if self.castOperandIsBool(operand: operand) {
            if targetNum {
                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: operand)), msg: "`as` cannot cast a Bool to a numeric type (Bool is not numeric; spec/12)")
                return
            }
        } else {
            if targetBool {
                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: operand)), msg: "`as` cannot cast to Bool (Bool is not numeric; spec/12)")
                return
            }
        }
        if isIntType(c: inout self, start: tyStart, len: tyLen) {
            // a float -> int `as` truncates the fractional part = lossy, so it is not a
            // valid `as` conversion (spec/12: `as` is lossless/total only). Use TryFrom.
            if self.exprIsFloat(id: operand) {
                compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: operand)), msg: "`as` cannot convert a float to an integer (it would truncate the fractional part); use a fallible TryFrom conversion (spec/12)")
                return
            }
            match self.arena.exprs[operand] {
                Expr.Int(val value, val offset, isBool: _, tyStart: _, tyLen: _, val isNeg) => {
                    if !(litFitsType(c: inout self, value: value, neg: isNeg, dstStart: tyStart, dstLen: tyLen)) {
                        compileErrorAt(line: lineOf(c: inout self, offset: offset), msg: "integer literal is out of range for the target type of `as`")
                    }
                }
                _ => {
                    val st: TypeInfo = typeOf(c: inout self, id: operand)
                    if isIntType(c: inout self, start: st.nameStart, len: st.nameLen) {
                        if !(losslessInt(c: inout self, srcStart: st.nameStart, srcLen: st.nameLen, dstStart: tyStart, dstLen: tyLen)) {
                            compileErrorAt(line: lineOf(c: inout self, offset: exprOffset(c: inout self, id: operand)), msg: "`as` would lose information (narrowing or signedness change); use a fallible TryFrom conversion")
                        }
                    }
                }
            }
        }
    }
}
