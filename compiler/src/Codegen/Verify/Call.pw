// Part of the acceptance verification pass (root: _.pw): call/method argument
// categories, enum-variant existence, and match-arm enum checks.

// The interned head-name id of a struct/enum type named (start,len), or 0 when it is
// not a known struct/enum (a primitive, a type variable, or an unrecovered name).
// Two same-type generic instances recover to the same head name -> same id, so an
// id comparison never false-rejects them; a 0 result means "don't know" and is
// treated as compatible (conservative — only definite mismatches are rejected).
// `extern(c)` opaque handle types (`type LLVMTypeRef`) also yield 0: they are FFI
// escape-hatch types, all lowered to `void*`, and treated as interchangeable at this
// boundary (the spec's value-semantics / no-conversion rules govern Plew types, not
// opaque C handles — and the compiler's own LLVM bindings rely on this, e.g. using an
// LLVMValueRef null as an LLVMTypeRef "none" sentinel).
fn knownNamedTypeId(c: inout Comp, start: U64, len: U64) -> U64 {
    // an import alias (`with { Real as Alias }`) denotes the same type identity as
    // `Real`: resolve so a value typed via its alias and one via the real name compare
    // equal, and so an enum match arm written with the alias name resolves (spec/15).
    val ar: Bind = aliasReal(c: inout c, start: start, len: len)
    val q: U64 = intern(c: inout c, start: ar.nameStart, len: ar.nameLen)
    val si: U64 = structIndexByName(c: inout c, start: ar.nameStart, len: ar.nameLen)
    if si < c.structs.count {
        if c.structs[si].isCExtern {
            return 0U64
        }
        return q
    }
    mut val ei: U64 = 0
    while ei < c.enums.count {
        if c.enums[ei].nameId == q {
            return q
        }
        ei += 1
    }
    // a `newtype` (spec/10) is a distinct named type: give it its own id so the type
    // checker keeps it apart from its underlying (`val x: I64 = meter` needs `as`).
    mut val ni: U64 = 0
    while ni < c.newtypes.count {
        if c.newtypes[ni].nameId == q {
            return q
        }
        ni += 1
    }
    return 0U64
}

// Category-check a method call's arguments against the method's parameter types
// (`a.add(n: "s")` for `n: I64`). Conservative like the free-function check: the
// receiver must reliably recover to a known struct/enum, and the name must resolve to
// EXACTLY ONE non-generic INHERENT method on it (no overloads, no generic / provided /
// extension candidate, which could change the binding). Args map to params 1:1.
fn checkMethodArgCategories(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val rt: TypeInfo = typeOf(c: inout c, id: recv)
    if rt.kind != 2 {
        return
    }
    val rId: U64 = knownNamedTypeId(c: inout c, start: rt.nameStart, len: rt.nameLen)
    if rId == 0U64 {
        return
    }
    val nq: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val theFi: U64 = c.funcs.count
    mut val count: U64 = 0
    mut val anyOther: Bool = false
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        if f.hasRecv && f.nameId == nq && f.recvId == rId {
            if f.typeParams.count > 0U64 || f.isProvided || f.extId != 0U64 {
                anyOther = true
            } else {
                count += 1U64
                theFi = fi
            }
        }
        fi += 1
    }
    if anyOther || count != 1U64 {
        return
    }
    val cf: Func = c.funcs[theFi]
    if args.count != cf.params.count {
        return
    }
    mut val ai: U64 = 0
    while ai < args.count {
        mut val pIdx: U64 = ai
        if args[ai].hasLabel {
            val lq: U64 = intern(c: inout c, start: args[ai].labelStart, len: args[ai].labelLen)
            mut val pj: U64 = 0
            mut val found: Bool = false
            while pj < cf.params.count {
                if cf.params[pj].nameId == lq {
                    pIdx = pj
                    found = true
                    pj = cf.params.count
                } else {
                    pj += 1
                }
            }
            if !(found) {
                pIdx = cf.params.count
            }
        }
        if pIdx < cf.params.count {
            tcCheckValue(c: inout c, expectedRef: cf.params[pIdx].ty, valueExpr: args[ai].expr, pos: "arg")
        }
        ai += 1
    }
}

// Category-check a free-function call's arguments against the callee's parameter
// types (`f(n: "s")` for `n: I64`). Conservative to dodge overload ambiguity: only
// when the name resolves to EXACTLY ONE non-generic free function (no overloads, no
// generic candidate) and the call passes one argument per parameter. Each argument is
// matched to its parameter by label (or by position when unlabelled), then checked
// with the same reliable-value discipline as bindings.
fn checkCallArgCategories(c: inout Comp, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val q: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val theFi: U64 = c.funcs.count
    mut val count: U64 = 0
    mut val anyGen: Bool = false
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        if f.nameId == q && !f.hasRecv && !f.isExtern {
            if f.typeParams.count > 0U64 {
                anyGen = true
            } else {
                count += 1U64
                theFi = fi
            }
        }
        fi += 1
    }
    if anyGen || count != 1U64 {
        return
    }
    val cf: Func = c.funcs[theFi]
    if args.count != cf.params.count {
        return
    }
    mut val ai: U64 = 0
    while ai < args.count {
        // resolve the parameter this argument fills: by label if given, else position.
        mut val pIdx: U64 = ai
        if args[ai].hasLabel {
            val lq: U64 = intern(c: inout c, start: args[ai].labelStart, len: args[ai].labelLen)
            mut val pj: U64 = 0
            mut val found: Bool = false
            while pj < cf.params.count {
                if cf.params[pj].nameId == lq {
                    pIdx = pj
                    found = true
                    pj = cf.params.count
                } else {
                    pj += 1
                }
            }
            if !(found) {
                pIdx = cf.params.count
            }
        }
        if pIdx < cf.params.count {
            tcCheckValue(c: inout c, expectedRef: cf.params[pIdx].ty, valueExpr: args[ai].expr, pos: "arg")
        }
        ai += 1
    }
}

// Reject match arms that pattern-match variants of a DIFFERENT enum than the
// scrutinee (`match e: E { F.C => … }`): the arms would test tags of an unrelated
// enum. Only fires when the scrutinee reliably recovers to a known enum and an arm
// names a different known enum (a wildcard / struct-destructure / unrecovered arm is
// skipped — conservative, like the other typeOf-based checks).
// Whether enum (enumStart,enumLen) declares a variant named (variantStart,variantLen).
fn variantExists(c: inout Comp, enumStart: U64, enumLen: U64, variantStart: U64, variantLen: U64) -> Bool {
    // resolve an import alias (`with { Real as Alias }`) so a match arm written with the
    // enum's alias name finds the real enum's variants (spec/15).
    val arE: Bind = aliasReal(c: inout c, start: enumStart, len: enumLen)
    val qEnum: U64 = intern(c: inout c, start: arE.nameStart, len: arE.nameLen)
    val qVar: U64 = intern(c: inout c, start: variantStart, len: variantLen)
    mut val ei: U64 = 0
    while ei < c.enums.count {
        if c.enums[ei].nameId == qEnum {
            val vars: Array[Variant] = c.enums[ei].variants
            mut val vi: U64 = 0
            while vi < vars.count {
                if vars[vi].nameId == qVar {
                    return true
                }
                vi += 1
            }
        }
        ei += 1
    }
    return false
}

fn checkMatchArmsEnum(c: inout Comp, scrut: U64, arms: Array[MatchArm]) {
    val st0: TypeInfo = typeOf(c: inout c, id: scrut)
    if st0.kind != 2 {
        return
    }
    val sId: U64 = knownNamedTypeId(c: inout c, start: st0.nameStart, len: st0.nameLen)
    if sId == 0U64 {
        return
    }
    mut val ai: U64 = 0
    while ai < arms.count {
        val a: MatchArm = arms[ai]
        if !(a.isWildcard || a.isStruct || a.enumLen == 0U64) {
            val aId: U64 = knownNamedTypeId(c: inout c, start: a.enumStart, len: a.enumLen)
            if aId != 0U64 && aId != sId {
                compileErrorAt(line: lineOf(c: inout c, offset: a.enumStart), msg: "this match arm pattern is a variant of a different enum than the value being matched")
            } else {
                // the named variant must exist on the enum (`Optional.Other` is not a
                // variant of Optional) — else the arm is unreachable and the match's
                // exhaustiveness count is wrong.
                if a.variantLen > 0U64 {
                    if !(variantExists(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen)) {
                        compileErrorAt(line: lineOf(c: inout c, offset: a.variantStart), msg: "unknown variant: this enum has no such variant")
                    }
                }
            }
        }
        ai += 1
    }
}

