// ---- acceptance verification pass (spec/15 — acceptance soundness) ----
//
// Many per-expression / per-statement acceptance checks (member visibility,
// literal range, unique-copy / unique-arg modes, make-field existence, `as`
// narrowing, assignment mutability, match exhaustiveness) were historically run
// inline during a backend's emission walk. With emission now done by the LLVM
// backend (which doesn't re-run them), this standalone pass is the sole home of
// those checks — without it, spec-invalid code would be silently ACCEPTED.
//
// It runs as a backend-independent traversal of every function body, invoked by
// runFrontend before code generation, so the compiler is acceptance-sound
// independent of how emission works. It reuses the existing check functions
// (checkLitCtx / checkLitSpan / checkUniquePlaceCopy / the visibility +
// matchExhaustive helpers) and adds the traversal plus the two checks (assign
// mutability, `as` narrowing) that had only ever existed inline in emission.

// Verify every non-extern, non-template function body.
fn verifyProgram(c: inout Comp) {
    mut val fi: U64 = 0
    while fi < c.funcs.count {
        val f: Func = c.funcs[fi]
        // acceptance soundness is about the USER's code: verify only entry-module
        // (module 0) bodies. The auto-loaded prelude / std (`@Std/*`) is trusted and
        // validated separately (test suite + self-compile); walking it here falsely
        // rejected a no-import program because a prelude body's operator witness
        // (`Add[U64]` in SipHasher) lives in Core, loaded only on import.
        if f.isExtern || methodInEntryModule(c: inout c, f: f) {
        } else {
            fi += 1
            continue
        }
        if f.isExtern {
        } else {
            if f.typeParams.count > 0U64 {
                // a generic template: its concrete instances are checked during the
                // C emitter's instance emission (with the substitution env); this
                // backend-independent pass covers non-generic bodies (where the
                // reject-test surface lives) without a substitution env.
            } else {
            if methodRecvIsTrait(c: inout c, f: f) {
                // a trait provided-method template — checked per conforming type
                // (its concrete copies are ordinary funcs and get verified).
            } else {
            if f.isAsync {
                // async bodies return the Promise's inner type (`return n` resolves
                // Promise[I64] with I64), so the return-context check needs the
                // unwrapped type; the C emitter handles this inline. Until that is
                // mirrored here, async bodies are checked by the C emitter only.
            } else {
                verifyFunc(c: inout c, f: f)
            }
            }
            }
        }
        fi += 1
    }
}

// Establish the same body context genFunc does — return type (for `return e`
// range checks), receiver/self env (so `self`-based field/method access
// resolves), and the parameter locals — then walk the body building the local
// symbol table so mutability / visibility / unique checks see real bindings.
fn verifyFunc(c: inout Comp, f: Func) {
    if f.hasRet {
        c.curRetVoid = false
        c.curRetStart = f.retStart
        c.curRetLen = f.retLen
        c.curRetIsArray = f.retIsArray
        c.curRetTy = f.retTy
    } else {
        c.curRetVoid = true
        c.curRetStart = 0
        c.curRetLen = 0
        c.curRetIsArray = false
        c.curRetTy = 0
    }
    c.curHasRecv = f.hasRecv
    c.curRecvStart = f.recvStart
    c.curRecvLen = f.recvLen
    c.curSelfInout = f.selfInout
    c.curSelfMove = f.selfMove
    if f.hasRecv {
        setSelfItemEnv(c: inout c, recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: 0)
    } else {
        clearSelfItemEnv(c: inout c)
    }
    c.curBranchBase = 0
    c.locals = []
    seedGlobalLocals(c: inout c)
    mut val pi: U64 = 0
    while pi < f.params.count {
        val p: Param = f.params[pi]
        addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: p.isMove)
        pi += 1
    }
    verifyBlock(c: inout c, blockId: f.body)
}

// Verify a block in its own lexical scope: bindings introduced inside are popped
// on exit (so a sibling/enclosing scope cannot resolve them), mirroring genBlock.
fn verifyBlock(c: inout Comp, blockId: U64) {
    val mark: U64 = scopeMark(c: inout c)
    val b: Block = c.blocks[blockId]
    mut val i: U64 = 0
    while i < b.stmts.count {
        verifyStmt(c: inout c, stmtId: b.stmts[i])
        i += 1
    }
    popLocals(c: inout c, mark: mark)
}

fn verifyStmt(c: inout Comp, stmtId: U64) {
    match c.stmts[stmtId] {
        Stmt.Let(val mutable, val nameStart, val nameLen, val tyStart, val tyLen, val tyIsArray, val ty, val init) => {
            // literal range against the annotation (or context-free if none).
            if tyLen > 0U64 {
                checkLitSpan(c: inout c, id: init, tyStart: tyStart, tyLen: tyLen, isArray: tyIsArray)
            } else {
                checkLitCtx(c: inout c, id: init, eKind: 0, eBits: 0, eSgn: false)
            }
            // a bare unique place on the rhs is a forbidden copy (`val g = f`).
            checkUniquePlaceCopy(c: inout c, exprId: init, inoutOk: false)
            verifyExpr(c: inout c, id: init)
            // register the binding (after the init, so it can't see itself) with its
            // effective type and mutability, so later places resolve / check.
            val le: LetEff = inferLetType(c: inout c, tyStart: tyStart, tyLen: tyLen, tyIsArray: tyIsArray, ty: ty, init: init)
            addLocal(c: inout c, nameStart: nameStart, nameLen: nameLen, tyStart: le.start, tyLen: le.len, isArray: le.arr, ty: le.ty, isInout: false, isMut: mutable, owned: true)
        }
        Stmt.Assign(val op, val target, val value) => {
            verifyAssign(c: inout c, op: op, target: target, value: value)
        }
        Stmt.ExprStmt(val expr) => {
            checkLitCtx(c: inout c, id: expr, eKind: 0, eBits: 0, eSgn: false)
            verifyExpr(c: inout c, id: expr)
        }
        Stmt.Return(val value, val hasValue) => {
            if hasValue {
                checkLitSpan(c: inout c, id: value, tyStart: c.curRetStart, tyLen: c.curRetLen, isArray: c.curRetIsArray)
                verifyExpr(c: inout c, id: value)
            }
        }
        Stmt.If(val cond, val thenBlk, val elseBlk, val hasElse) => {
            checkLitCtx(c: inout c, id: cond, eKind: 0, eBits: 0, eSgn: false)
            verifyExpr(c: inout c, id: cond)
            // locals already in scope are "outside" this branch (a `move` of one
            // inside would be conditional) — mark the boundary for the move guard.
            val savedBB: U64 = c.curBranchBase
            c.curBranchBase = scopeMark(c: inout c)
            verifyBlock(c: inout c, blockId: thenBlk)
            if hasElse {
                verifyBlock(c: inout c, blockId: elseBlk)
            }
            c.curBranchBase = savedBB
        }
        Stmt.While(val cond, val body) => {
            checkLitCtx(c: inout c, id: cond, eKind: 0, eBits: 0, eSgn: false)
            verifyExpr(c: inout c, id: cond)
            val savedBB: U64 = c.curBranchBase
            c.curBranchBase = scopeMark(c: inout c)
            verifyBlock(c: inout c, blockId: body)
            c.curBranchBase = savedBB
        }
        Stmt.For(val varStart, val varLen, val varTyStart, val varTyLen, val isRange, inclusive: _, val iter, val rangeHi, val body, val isStruct, val patStart, val patLen, val binds) => {
            verifyExpr(c: inout c, id: iter)
            if isRange {
                verifyExpr(c: inout c, id: rangeHi)
                // a range bound annotated by the loop var (`for val i: I32 in …`)
                // types both bounds; otherwise each must determine its own type, so a
                // bare literal range (`0..<5`) is ambiguous and rejected.
                if varTyLen != 0U64 {
                    checkLitSpan(c: inout c, id: iter, tyStart: varTyStart, tyLen: varTyLen, isArray: false)
                    checkLitSpan(c: inout c, id: rangeHi, tyStart: varTyStart, tyLen: varTyLen, isArray: false)
                } else {
                    checkArithNoCtx(c: inout c, lhs: iter, rhs: rangeHi)
                }
            }
            // scope the loop binding(s) to the body, mirroring genStmt's For.
            val forMark: U64 = scopeMark(c: inout c)
            val savedForBB: U64 = c.curBranchBase
            c.curBranchBase = forMark
            if isRange {
                // loop var type: the annotation, else the range bound's own type.
                mut val ltS: U64 = varTyStart
                mut val ltL: U64 = varTyLen
                if ltL == 0U64 {
                    val bt2: TypeInfo = typeOf(c: inout c, id: rangeHi)
                    if bt2.kind == 0 {
                        ltS = bt2.nameStart
                        ltL = bt2.nameLen
                    }
                }
                addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: ltS, tyLen: ltL, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
            } else {
                val et: TypeInfo = typeOf(c: inout c, id: iter)
                if et.kind == 3 {
                    if isStruct {
                        // the destructure pattern type must name the element struct.
                        if intern(c: inout c, start: patStart, len: patLen) == intern(c: inout c, start: et.nameStart, len: et.nameLen) {
                        } else {
                            compileErrorAt(line: lineOf(c: inout c, offset: patStart), msg: "for-loop destructure pattern type does not match the element type")
                        }
                        mut val bi: U64 = 0
                        while bi < binds.count {
                            val bd: Bind = binds[bi]
                            val ft: TypeInfo = forBindFieldType(c: inout c, et: et, bd: bd)
                            addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
                            bi += 1
                        }
                    } else {
                        // single binding to the element type (`for val b in bs` -> U8).
                        addLocal(c: inout c, nameStart: varStart, nameLen: varLen, tyStart: et.nameStart, tyLen: et.nameLen, isArray: false, ty: 0, isInout: false, isMut: false, owned: false)
                    }
                }
            }
            verifyBlock(c: inout c, blockId: body)
            c.curBranchBase = savedForBB
            popLocals(c: inout c, mark: forMark)
        }
        Stmt.Match(val scrut, val arms) => {
            verifyExpr(c: inout c, id: scrut)
            if matchExhaustive(c: inout c, arms: arms) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: scrut)), msg: "match must be exhaustive: cover all variants or add a wildcard")
            }
            mut val ai: U64 = 0
            while ai < arms.count {
                val armMark: U64 = scopeMark(c: inout c)
                val savedArmBB: U64 = c.curBranchBase
                c.curBranchBase = armMark
                verifyAddArmBinds(c: inout c, a: arms[ai], scrut: scrut)
                verifyBlock(c: inout c, blockId: arms[ai].body)
                c.curBranchBase = savedArmBB
                popLocals(c: inout c, mark: armMark)
                ai += 1
            }
        }
        Stmt.Panic(val msg, offset: _) => {
            verifyExpr(c: inout c, id: msg)
        }
        Stmt.Give(val value) => {
            // a value-position if/match yielding a unique value isn't supported yet
            // (per-path move/drop handling); mirrors genStmt's Give guard.
            val gvt: TypeInfo = typeOf(c: inout c, id: value)
            if gvt.kind == 2 {
                if typeIsUnique(c: inout c, start: gvt.nameStart, len: gvt.nameLen) {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: value)), msg: "a value-position if/match cannot yield a unique value yet; use a statement form")
                }
            }
            verifyExpr(c: inout c, id: value)
        }
        Stmt.Break => {}
        Stmt.Continue => {}
    }
}

// Assignment target mutability + field-write visibility (spec/03, /05), mirroring
// the inline checks in genStmt's Assign arm; then verify both sides.
fn verifyAssign(c: inout Comp, op: I64, target: U64, value: U64) {
    match c.exprs[target] {
        Expr.Index(val base, val index) => {
            if placeIsMutable(c: inout c, id: base) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: base)), msg: "cannot assign to an element of an immutable binding; declare it with `mut val`")
            }
            verifyExpr(c: inout c, id: base)
            verifyExpr(c: inout c, id: index)
        }
        Expr.Field(base: val fbase, val nameStart, val nameLen) => {
            // the whole place must be mutable (binding + field both `mut val`).
            if placeIsMutable(c: inout c, id: target) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: target)), msg: "cannot assign to an immutable place; the binding and field must be declared `mut val`")
            }
            // field-write visibility on the base's owner type.
            val bt: TypeInfo = typeOf(c: inout c, id: fbase)
            if bt.kind == 2 {
                checkFieldWriteVis(c: inout c, ownerStart: bt.nameStart, ownerLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
            }
            verifyExpr(c: inout c, id: fbase)
        }
        Expr.Ident(val start, val len) => {
            if placeIsMutable(c: inout c, id: target) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: start), msg: "cannot assign to an immutable binding; declare it with `mut val`")
            }
        }
        Expr.Arrow(val base, nameStart: _, nameLen: _) => {
            // a Ref pointee is always mutable through `->`.
            verifyExpr(c: inout c, id: base)
        }
        _ => {}
    }
    checkUniquePlaceCopy(c: inout c, exprId: value, inoutOk: false)
    verifyExpr(c: inout c, id: value)
}

// Recursively verify an expression: member visibility (field read / method call),
// `as` narrowing, nested match exhaustiveness, and descent into sub-expressions.
// The literal-range / call-arg / make-field / unique-arg checks are driven by
// checkLitCtx at the statement level (it walks the same tree), so this walk adds
// only the checks checkLitCtx does not perform.
fn verifyExpr(c: inout Comp, id: U64) {
    match c.exprs[id] {
        Expr.Field(val base, val nameStart, val nameLen) => {
            verifyFieldReadVis(c: inout c, base: base, nameStart: nameStart, nameLen: nameLen)
            verifyExpr(c: inout c, id: base)
        }
        Expr.Method(val recv, val nameStart, val nameLen, val args) => {
            verifyMethodVis(c: inout c, recv: recv, nameStart: nameStart, nameLen: nameLen, args: args)
            verifyExpr(c: inout c, id: recv)
            verifyArgs(c: inout c, args: args)
        }
        Expr.ExtMethod(val recv, srcStart: _, srcLen: _, nameStart: _, nameLen: _, val args) => {
            verifyExpr(c: inout c, id: recv)
            verifyArgs(c: inout c, args: args)
        }
        Expr.ExtView(val recv, srcStart: _, srcLen: _) => {
            verifyExpr(c: inout c, id: recv)
        }
        Expr.Call(nameStart: _, nameLen: _, val args) => {
            verifyArgs(c: inout c, args: args)
        }
        Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: _, ty: _, val fields) => {
            mut val i: U64 = 0
            while i < fields.count {
                verifyExpr(c: inout c, id: fields[i].value)
                i += 1
            }
        }
        Expr.Cast(val operand, val tyStart, val tyLen, ty: _) => {
            verifyCastLossless(c: inout c, operand: operand, tyStart: tyStart, tyLen: tyLen)
            verifyExpr(c: inout c, id: operand)
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            verifyExpr(c: inout c, id: lhs)
            verifyExpr(c: inout c, id: rhs)
            verifyBinaryOp(c: inout c, op: op, lhs: lhs, rhs: rhs)
        }
        Expr.Unary(op: _, val operand) => {
            verifyExpr(c: inout c, id: operand)
        }
        Expr.Index(val base, val index) => {
            verifyExpr(c: inout c, id: base)
            verifyExpr(c: inout c, id: index)
        }
        Expr.Array(val elems) => {
            mut val i: U64 = 0
            while i < elems.count {
                verifyExpr(c: inout c, id: elems[i])
                i += 1
            }
        }
        Expr.Arrow(val base, nameStart: _, nameLen: _) => {
            verifyExpr(c: inout c, id: base)
        }
        Expr.OptChain(val base, memberStart: _, memberLen: _) => {
            verifyExpr(c: inout c, id: base)
        }
        Expr.Try(val expr) => {
            verifyExpr(c: inout c, id: expr)
        }
        Expr.MatchExpr(val scrut, val arms) => {
            verifyExpr(c: inout c, id: scrut)
            if matchExhaustive(c: inout c, arms: arms) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: scrut)), msg: "match must be exhaustive: cover all variants or add a wildcard")
            }
            mut val ai: U64 = 0
            while ai < arms.count {
                val armMark: U64 = scopeMark(c: inout c)
                verifyAddArmBinds(c: inout c, a: arms[ai], scrut: scrut)
                verifyExpr(c: inout c, id: arms[ai].body)
                popLocals(c: inout c, mark: armMark)
                ai += 1
            }
        }
        Expr.IfExpr(val cond, val thenBlk, val elseBlk) => {
            verifyExpr(c: inout c, id: cond)
            verifyBlock(c: inout c, blockId: thenBlk)
            verifyBlock(c: inout c, blockId: elseBlk)
        }
        Expr.Move(val operand, val isBorrow) => {
            // `move`/`borrow` of a place (mirrors genExpr's Move arm). `move` is
            // restricted to a bare local (field/element partial moves aren't tracked
            // yet) that is not `self` and not declared outside the enclosing branch
            // (a conditional move would skip the source's deinit on other paths).
            if isBorrow {
            } else {
                match c.exprs[operand] {
                    Expr.Ident(val start, val len) => {
                        if isSelfRef(c: inout c, start: start, len: len) {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "moving `self` is not yet supported")
                        }
                        if localIndexByName(c: inout c, start: start, len: len) < c.curBranchBase {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "cannot `move` a variable declared outside the enclosing conditional/loop (the move would be conditional); move it unconditionally")
                        }
                    }
                    _ => {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "`move` is only supported from a local variable (field/element moves are not yet supported)")
                    }
                }
            }
            verifyExpr(c: inout c, id: operand)
        }
        _ => {}
    }
}

// Add a match arm's payload binds to the current scope with their field types so
// the arm body resolves them (mirrors the C emitter's per-arm bindings, incl.
// grounding a generic instance's field types under the scrutinee's type args —
// `Box[I32] { val v }` binds v: I32, not the template T). Enum arms resolve via
// the variant; struct-destructure arms (`S { val x }`) via the struct.
fn verifyAddArmBinds(c: inout Comp, a: MatchArm, scrut: U64) {
    if a.isWildcard {
        return
    }
    val st: TypeInfo = typeOf(c: inout c, id: scrut)
    val generic: Bool = isGenericInst(c: inout c, ref: st.ref)
    mut val bi: U64 = 0
    if a.isStruct {
        while bi < a.binds.count {
            val bd: Bind = a.binds[bi]
            mut val ft: TypeInfo = scalarInfo()
            if generic {
                ft = genericFieldTypeInfo(c: inout c, instRef: st.ref, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
            } else {
                ft = fieldType(c: inout c, structStart: a.enumStart, structLen: a.enumLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
            }
            addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
            bi += 1
        }
    } else {
        while bi < a.binds.count {
            val bd: Bind = a.binds[bi]
            if generic {
                val bti: TypeInfo = genericEnumFieldTypeInfo(c: inout c, instRef: st.ref, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
                addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: bti.nameStart, tyLen: bti.nameLen, isArray: bti.kind == 3, ty: 0, isInout: false, isMut: false, owned: false)
            } else {
                addBindLocalCn(c: inout c, enumStart: a.enumStart, enumLen: a.enumLen, variantStart: a.variantStart, variantLen: a.variantLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen, bindStart: bd.nameStart, bindLen: bd.nameLen, cnum: 0)
            }
            bi += 1
        }
    }
}

// verify each call/method argument's expression (the arg-mode checks themselves
// run via checkLitCtx -> checkCallArgs -> checkUniqueArgModes).
fn verifyArgs(c: inout Comp, args: Array[Arg]) {
    mut val i: U64 = 0
    while i < args.count {
        verifyExpr(c: inout c, id: args[i].expr)
        i += 1
    }
    // overlapping `inout` (spec/03): two or more `inout` arguments of ONE call that
    // name the SAME place are forbidden — last-write-wins would be a silent bug. This
    // is the syntactic case ① (identical place expressions); distinct-provability for
    // subscripts (case ②/③) is a separate lint/runtime concern.
    mut val a: U64 = 0
    while a < args.count {
        if args[a].isInout {
            mut val b: U64 = a + 1U64
            while b < args.count {
                if args[b].isInout {
                    if exprSyntaxEq(c: inout c, a: args[a].expr, b: args[b].expr) {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: args[b].expr)), msg: "two `inout` arguments refer to the same place in one call; overlapping `inout` is forbidden (last-write-wins would be a silent bug)")
                    }
                }
                b += 1U64
            }
        }
        a += 1U64
    }
}

// Conservative syntactic equality of two place/value expressions, for the
// overlapping-`inout` check (spec/03 case ①): identical variable, field/arrow chain,
// or subscript with identical base and index. Anything else (calls, etc.) compares
// unequal — the check only fires on definite syntactic identity.
fn exprSyntaxEq(c: inout Comp, a: U64, b: U64) -> Bool {
    match c.exprs[a] {
        Expr.Ident(start: val s1, len: val l1) => {
            match c.exprs[b] {
                Expr.Ident(start: val s2, len: val l2) => { return spansEqual(c: inout c, aStart: s1, aLen: l1, bStart: s2, bLen: l2) }
                _ => { return false }
            }
        }
        Expr.Int(value: val v1, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg1) => {
            match c.exprs[b] {
                Expr.Int(value: val v2, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: val neg2) => { return v1 == v2 && neg1 == neg2 }
                _ => { return false }
            }
        }
        Expr.Field(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
            match c.exprs[b] {
                Expr.Field(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout c, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && exprSyntaxEq(c: inout c, a: base1, b: base2) }
                _ => { return false }
            }
        }
        Expr.Arrow(base: val base1, nameStart: val n1s, nameLen: val n1l) => {
            match c.exprs[b] {
                Expr.Arrow(base: val base2, nameStart: val n2s, nameLen: val n2l) => { return spansEqual(c: inout c, aStart: n1s, aLen: n1l, bStart: n2s, bLen: n2l) && exprSyntaxEq(c: inout c, a: base1, b: base2) }
                _ => { return false }
            }
        }
        Expr.Index(base: val base1, index: val idx1) => {
            match c.exprs[b] {
                Expr.Index(base: val base2, index: val idx2) => { return exprSyntaxEq(c: inout c, a: base1, b: base2) && exprSyntaxEq(c: inout c, a: idx1, b: idx2) }
                _ => { return false }
            }
        }
        _ => { return false }
    }
}

// field-read visibility, mirroring genExpr's Field arm (Expr.pw): a struct base
// checks the field against its owner; an array base against `Array`. Also rejects
// using a method as a value.
fn verifyFieldReadVis(c: inout Comp, base: U64, nameStart: U64, nameLen: U64) {
    val bt: TypeInfo = typeOf(c: inout c, id: base)
    if bt.kind == 2 {
        if fieldVis(c: inout c, structStart: bt.nameStart, structLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen) == 3U64 {
            if typeHasMethodNamed(c: inout c, recvStart: bt.nameStart, recvLen: bt.nameLen, nameStart: nameStart, nameLen: nameLen) {
                compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "a method cannot be used as a value; call it, or wrap it in a closure (e.g. `fn() { obj.method() }`)")
            }
        }
        checkFieldReadVis(c: inout c, ownerStart: bt.nameStart, ownerLen: bt.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
    } else {
        if bt.kind == 3 {
            val arrName: Bind = kwSpan(c: inout c, kw: "Array", kwLen: 5)
            checkFieldReadVis(c: inout c, ownerStart: arrName.nameStart, ownerLen: arrName.nameLen, fieldStart: nameStart, fieldLen: nameLen, offset: nameStart)
        }
    }
}

// method-call visibility, mirroring genExpr's Method arm (Expr.pw).
fn verifyMethodVis(c: inout Comp, recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val rt: TypeInfo = typeOf(c: inout c, id: recv)
    if rt.kind == 2 {
        // resolve the method on the receiver type to get its Func (checkMethodVis
        // inspects the impl block's visibility); skip if unresolved (a separate
        // "no such method" diagnostic covers that).
        val mi: U64 = findMethod(c: inout c, recvStart: rt.nameStart, recvLen: rt.nameLen, nameStart: nameStart, nameLen: nameLen, args: args)
        if mi < c.funcs.count {
            checkMethodVis(c: inout c, ownerStart: rt.nameStart, ownerLen: rt.nameLen, mf: c.funcs[mi], offset: nameStart)
            // an `inout fn` method mutates the receiver, so its place must be mutable.
            if c.funcs[mi].selfInout {
                if placeIsMutable(c: inout c, id: recv) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: recv)), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
                }
                // overlapping `inout` (spec/03 case ①): an `inout fn` self IS an inout
                // position, so an `inout` argument naming the same place as the receiver
                // overlaps — last-write-wins would be a silent bug.
                mut val k: U64 = 0
                while k < args.count {
                    if args[k].isInout {
                        if exprSyntaxEq(c: inout c, a: recv, b: args[k].expr) {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: args[k].expr)), msg: "the receiver of an `inout fn` and an `inout` argument refer to the same place; overlapping `inout` is forbidden (last-write-wins would be a silent bug)")
                        }
                    }
                    k += 1U64
                }
            }
        }
    }
    // a mutating built-in array method (`append`) on an immutable array binding.
    if rt.kind == 3 {
        if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "append") {
            if placeIsMutable(c: inout c, id: recv) {
            } else {
                compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: recv)), msg: "cannot call an `inout fn` method on an immutable binding; declare it with `mut val`")
            }
        }
    }
}

// Binary operator-witness availability, mirroring genExpr's Binary arm exactly:
// String/compare-witness/enum-eq are fine; a struct/array comparison without
// Eq/Ord errors; an arithmetic op resolves a witness or errors. The hasXWitness
// guards run first so a valid op (whose operand type resolves to a witness) is
// accepted — only genuinely unwitnessed ops fall through to the error arms.
fn verifyBinaryOp(c: inout Comp, op: I64, lhs: U64, rhs: U64) {
    if isStringEq(c: inout c, op: op, lhs: lhs) {
        return
    }
    if hasCompareWitness(c: inout c, op: op, lhs: lhs) {
        return
    }
    if isEnumEq(c: inout c, op: op, lhs: lhs) {
        verifyEnumEqPayload(c: inout c, lhs: lhs, rhs: rhs)
        return
    }
    if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
        return
    }
    if hasBinTraitWitness(c: inout c, op: op, lhs: lhs, rhs: rhs) {
        return
    }
    if binTraitNeedsTrait(c: inout c, op: op, lhs: lhs, rhs: rhs) {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "arithmetic operator needs Add/Sub/Mul/Div/Rem; not implemented for this type")
    }
}

// enum `==`/`!=` needs structural Eq for payload variants; only all-nullary enums
// compare by tag (mirrors emitEnumTagCmp's guard).
fn verifyEnumEqPayload(c: inout Comp, lhs: U64, rhs: U64) {
    val lt: TypeInfo = typeOf(c: inout c, id: lhs)
    mut val enStart: U64 = 0
    mut val enLen: U64 = 0
    if lt.kind == 2 {
        enStart = lt.nameStart
        enLen = lt.nameLen
    } else {
        val rt: TypeInfo = typeOf(c: inout c, id: rhs)
        enStart = rt.nameStart
        enLen = rt.nameLen
    }
    if isAllNullary(c: inout c, start: enStart, len: enLen) {
    } else {
        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "enum == needs structural Eq for payload variants (only all-nullary enums compare by tag)")
    }
}

// `as` lossless check, mirroring genExpr's Cast arm (Expr.pw): a narrowing or
// signedness-changing integer `as` must go through a fallible TryFrom.
fn verifyCastLossless(c: inout Comp, operand: U64, tyStart: U64, tyLen: U64) {
    if isIntType(c: inout c, start: tyStart, len: tyLen) {
        match c.exprs[operand] {
            Expr.Int(val value, val offset, isBool: _, tyStart: _, tyLen: _, val isNeg) => {
                if litFitsType(c: inout c, value: value, neg: isNeg, dstStart: tyStart, dstLen: tyLen) {
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: offset), msg: "integer literal is out of range for the target type of `as`")
                }
            }
            _ => {
                val st: TypeInfo = typeOf(c: inout c, id: operand)
                if isIntType(c: inout c, start: st.nameStart, len: st.nameLen) {
                    if losslessInt(c: inout c, srcStart: st.nameStart, srcLen: st.nameLen, dstStart: tyStart, dstLen: tyLen) {
                    } else {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "`as` would lose information (narrowing or signedness change); use a fallible TryFrom conversion")
                    }
                }
            }
        }
    }
}
