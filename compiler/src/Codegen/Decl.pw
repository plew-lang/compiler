fn nameIsMain(c: inout Comp, f: Func) -> Bool {
    if f.hasRecv {
        return false
    }
    return rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: "main")
}

// Whether (start,len) names a declared trait (spec/08). Distinguishes a bare
// `impl Trait { }` provided-method block (receiver = a trait) from an inherent
// `impl Type { }`.
fn isTraitName(c: inout Comp, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.traits.count {
        val t: TraitDef = c.traits[i]
        if t.nameId == qId {
            return true
        }
        i += 1
    }
    return false
}

// Whether a function is a provided-method template: a method whose receiver is a
// trait (from a bare `impl Trait { }`). These are not emitted directly (the
// receiver is not a concrete C type); instantiateProvidedMethods copies them
// onto each conforming type instead.
fn methodRecvIsTrait(c: inout Comp, f: Func) -> Bool {
    if f.hasRecv {
        return isTraitName(c: inout c, start: f.recvStart, len: f.recvLen)
    }
    return false
}

// Instantiate each trait's provided methods onto every conforming type (spec/08:
// a conformance gains the trait's provided methods on its bare surface). For each
// Conform(Type, Trait) and each provided method of Trait (a method with receiver
// = the trait), append a copy with receiver = Type, sharing the same body — so
// codegen emits `Type_p`, whose `self.req()` resolves to Type's witness. Runs
// once after parsing, before instantiation discovery and codegen.
// Whether a method named (nameStart,nameLen) on receiver (recvStart,recvLen)
// exists in c.funcs[lo..hi). Used to detect provided-method shadowing/collision.
fn methodInRange(c: inout Comp, lo: U64, hi: U64, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = lo
    while i < hi {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.recvId == qRecv {
                if f.nameId == qName {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// The type params for a provided method copied onto a conformer named
// (recvStart,recvLen): the conformer's own type params (so the copy is emitted per
// receiver instantiation), followed by the provided method's own params. Empty for
// a non-generic conformer (returns the method's own params unchanged).
fn providedCopyTypeParams(c: inout Comp, recvStart: U64, recvLen: U64, ownParams: Array[Bind]) -> Array[Bind] {
    mut val out: Array[Bind] = []
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    mut val si: U64 = 0
    while si < c.structs.count {
        if c.structs[si].typeParams.count > 0 {
            if c.structs[si].nameId == qRecv {
                mut val k: U64 = 0
                while k < c.structs[si].typeParams.count {
                    out.append(c.structs[si].typeParams[k])
                    k += 1
                }
            }
        }
        si += 1
    }
    mut val oi: U64 = 0
    while oi < ownParams.count {
        out.append(ownParams[oi])
        oi += 1
    }
    return out
}

fn instantiateProvidedMethods(c: inout Comp) {
    val nFuncs: U64 = c.funcs.count
    mut val ci: U64 = 0
    while ci < c.conforms.count {
        val cf: Conform = c.conforms[ci]
        mut val fi: U64 = 0
        while fi < nFuncs {
            val f: Func = c.funcs[fi]
            if f.hasRecv {
                if f.recvId == cf.traitId {
                    // shadowing/collision (spec/08): an inherent method of the same
                    // name on the type wins (skip the provided copy); a provided
                    // method already copied from another trait collides — the bare
                    // call would be ambiguous, so error (use-site `#`-disambiguation
                    // is not yet supported).
                    if methodInRange(c: inout c, lo: 0, hi: nFuncs, recvStart: cf.typeStart, recvLen: cf.typeLen, nameStart: f.nameStart, nameLen: f.nameLen) {
                    } else {
                        if methodInRange(c: inout c, lo: nFuncs, hi: c.funcs.count, recvStart: cf.typeStart, recvLen: cf.typeLen, nameStart: f.nameStart, nameLen: f.nameLen) {
                            compileErrorAt(line: lineOf(c: inout c, offset: cf.typeStart), msg: "two conformed traits provide a method of the same name; the bare call is ambiguous (`#`-disambiguation not yet supported)")
                        } else {
                            // a provided method copied onto a *generic* conformer inherits
                            // the conformer's type params (prepended), so methodMatchesInst
                            // emits it per receiver instantiation (`MapIter[Counter,…]`) like
                            // an inherent method. Onto a non-generic conformer this is a
                            // no-op (the conformer has no params).
                            val copiedTP: Array[Bind] = providedCopyTypeParams(c: inout c, recvStart: cf.typeStart, recvLen: cf.typeLen, ownParams: f.typeParams)
                            c.funcs.append(<Func nameStart=f.nameStart nameLen=f.nameLen nameId=f.nameId recvId=intern(c: inout c, start: cf.typeStart, len: cf.typeLen) typeParams=copiedTP params=f.params hasRet=f.hasRet retStart=f.retStart retLen=f.retLen retIsArray=f.retIsArray retTy=f.retTy body=f.body hasRecv=true recvStart=cf.typeStart recvLen=cf.typeLen selfInout=f.selfInout selfMove=f.selfMove isAssoc=f.isAssoc isAsync=f.isAsync isExtern=f.isExtern isPub=f.isPub isProvided=true />)
                        }
                    }
                }
            }
            fi += 1
        }
        ci += 1
    }
}

// Index of a non-generic struct named (start,len), or c.structs.count if none.
fn structIndexByName(c: inout Comp, start: U64, len: U64) -> U64 {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.structs.count {
        val s: StructDef = c.structs[i]
        if s.typeParams.count == 0 {
            if s.nameId == qId {
                return i
            }
        }
        i += 1
    }
    return c.structs.count
}

// Does a struct need a deep copy for value semantics? True if it has an array
// field (CoW buffer) or a struct field that itself needs copying. (By-value
// structs are acyclic, so the recursion terminates.) Scalars / immutable
// Strings / Ref pointers are correctly shared by a shallow copy.
fn structNeedsCopy(c: inout Comp, start: U64, len: U64) -> Bool {
    val si: U64 = structIndexByName(c: inout c, start: start, len: len)
    if si >= c.structs.count {
        return false
    }
    val s: StructDef = c.structs[si]
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        if fieldNeedsCopy(c: inout c, f: fields[i]) {
            return true
        }
        i += 1
    }
    return false
}

// Does a struct need a `_release` function? Like structNeedsCopy (array or a
// nested struct that needs release), but also true for a `unique` field — whose
// `deinit`/release must run when the owner is destroyed even with no heap. This
// gates release emission; structNeedsCopy still gates the CoW copy/share (which
// unique types never use).
fn structNeedsRelease(c: inout Comp, start: U64, len: U64) -> Bool {
    val si: U64 = structIndexByName(c: inout c, start: start, len: len)
    if si >= c.structs.count {
        return false
    }
    val s: StructDef = c.structs[si]
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        if fieldNeedsRelease(c: inout c, f: fields[i]) {
            return true
        }
        i += 1
    }
    return false
}

// `void <T>_deinit(<T> self);` prototypes for every type with a `deinit`, emitted
// early (before struct release defs) so a parent's `_release` can call a unique
// field's deinit. The synthetic deinit Func re-emits an identical prototype later
// (a redundant C prototype is legal).
fn emitDeinitProtos(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.deinits.count {
        val d: Bind = c.deinits[i]
        write(s: "void ")
        writeSpan(c: inout c, start: d.nameStart, len: d.nameLen)
        write(s: "_deinit(")
        genCTypeRef(c: inout c, start: d.nameStart, len: d.nameLen, isArray: false)
        write(s: " self);\n")
        i += 1
    }
}

// `Name Name_copy(Name s)` prototype.
fn emitStructCopyProto(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: "_copy(")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " s);\n")
}


// `Name Name_share(Name s);` prototype.
fn emitStructShareProto(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: "_share(")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " s);\n")
}


// ── value-semantics ARC for enums & recursive boxes (spec/03) ────────────────
// Mirrors the struct copy/share/release machinery onto enums (concrete + mono)
// and onto boxed (recursive) fields. A boxed field is a refcounted heap cell
// (plew_arc_alloc header): copy/share retain it, release drops the refcount and,
// at zero, recursively releases the pointee and frees the cell.

// Does a value of TypeInfo `ti` (a substituted/recovered type) need a deep copy?
fn typeInfoNeedsCopy(c: inout Comp, ti: TypeInfo) -> Bool {
    if ti.kind == 3 {
        return true
    }
    if ti.kind == 2 {
        if ti.ref != 0 {
            if isGenericInst(c: inout c, ref: ti.ref) {
                if isGenericEnumInst(c: inout c, ref: ti.ref) {
                    return monoEnumNeedsCopy(c: inout c, instRef: ti.ref)
                }
                return monoStructNeedsCopy(c: inout c, instRef: ti.ref)
            }
        }
        if structNeedsCopy(c: inout c, start: ti.nameStart, len: ti.nameLen) {
            return true
        }
        return enumNeedsCopy(c: inout c, start: ti.nameStart, len: ti.nameLen)
    }
    return false
}

fn typeInfoNeedsRelease(c: inout Comp, ti: TypeInfo) -> Bool {
    if ti.kind == 3 {
        return true
    }
    if ti.kind == 2 {
        if ti.ref != 0 {
            if isGenericInst(c: inout c, ref: ti.ref) {
                if isGenericEnumInst(c: inout c, ref: ti.ref) {
                    return monoEnumNeedsRelease(c: inout c, instRef: ti.ref)
                }
                return false
            }
        }
        if structNeedsRelease(c: inout c, start: ti.nameStart, len: ti.nameLen) {
            return true
        }
        return enumNeedsRelease(c: inout c, start: ti.nameStart, len: ti.nameLen)
    }
    return false
}

// Per-(concrete)-field decisions, shared by struct & concrete-enum needs/emit.
fn fieldNeedsCopy(c: inout Comp, f: FieldDef) -> Bool {
    if fieldIsBoxed(c: inout c, f: f) {
        return true
    }
    if f.tyIsArray {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: f.tyStart, len: f.tyLen, kw: "RawBuffer") {
        return true
    }
    if f.ty != 0 {
        if isGenericInst(c: inout c, ref: f.ty) {
            if isGenericEnumInst(c: inout c, ref: f.ty) {
                return monoEnumNeedsCopy(c: inout c, instRef: f.ty)
            }
            return monoStructNeedsCopy(c: inout c, instRef: f.ty)
        }
    }
    if structNeedsCopy(c: inout c, start: f.tyStart, len: f.tyLen) {
        return true
    }
    return enumNeedsCopy(c: inout c, start: f.tyStart, len: f.tyLen)
}

fn fieldNeedsRelease(c: inout Comp, f: FieldDef) -> Bool {
    if fieldIsBoxed(c: inout c, f: f) {
        return true
    }
    if f.tyIsArray {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: f.tyStart, len: f.tyLen, kw: "RawBuffer") {
        return true
    }
    if f.ty != 0 {
        if isGenericInst(c: inout c, ref: f.ty) {
            if isGenericEnumInst(c: inout c, ref: f.ty) {
                return monoEnumNeedsRelease(c: inout c, instRef: f.ty)
            }
            return false
        }
    }
    if typeIsUnique(c: inout c, start: f.tyStart, len: f.tyLen) {
        return true
    }
    if structNeedsRelease(c: inout c, start: f.tyStart, len: f.tyLen) {
        return true
    }
    return enumNeedsRelease(c: inout c, start: f.tyStart, len: f.tyLen)
}

// Does a concrete (non-generic) enum need copy/release? True if any variant field
// does. Generic enums are handled per-instantiation (monoEnumNeeds*).
fn enumNeedsCopy(c: inout Comp, start: U64, len: U64) -> Bool {
    val ei: U64 = concreteEnumIndex(c: inout c, nStart: start, nLen: len)
    if ei >= c.enums.count {
        return false
    }
    val vars: Array[Variant] = c.enums[ei].variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val fs: Array[FieldDef] = vars[vi].fields
        mut val fi: U64 = 0
        while fi < fs.count {
            if fieldNeedsCopy(c: inout c, f: fs[fi]) {
                return true
            }
            fi += 1
        }
        vi += 1
    }
    return false
}

fn enumNeedsRelease(c: inout Comp, start: U64, len: U64) -> Bool {
    val ei: U64 = concreteEnumIndex(c: inout c, nStart: start, nLen: len)
    if ei >= c.enums.count {
        return false
    }
    val vars: Array[Variant] = c.enums[ei].variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val fs: Array[FieldDef] = vars[vi].fields
        mut val fi: U64 = 0
        while fi < fs.count {
            if fieldNeedsRelease(c: inout c, f: fs[fi]) {
                return true
            }
            fi += 1
        }
        vi += 1
    }
    return false
}

// Does a mono enum instantiation need a release? True if any variant field, after
// substitution, needs release.
fn monoEnumNeedsRelease(c: inout Comp, instRef: U64) -> Bool {
    val t: TypeRef = c.types[instRef]
    val ei: U64 = genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if ei >= c.enums.count {
        return false
    }
    val e: EnumDef = c.enums[ei]
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val fs: Array[FieldDef] = vars[vi].fields
        mut val fi: U64 = 0
        while fi < fs.count {
            val ti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: e.typeParams, tyRef: fs[fi].ty)
            if typeInfoNeedsRelease(c: inout c, ti: ti) {
                return true
            }
            fi += 1
        }
        vi += 1
    }
    return false
}

// Does a boxed field's pointee (the cell contents) need release when the cell is
// freed? Drives whether the box-release emits a `<Pointee>_release(*cell)` call.
fn pointeeNeedsRelease(c: inout Comp, f: FieldDef) -> Bool {
    if f.ty != 0 {
        if isGenericInst(c: inout c, ref: f.ty) {
            if isGenericEnumInst(c: inout c, ref: f.ty) {
                return monoEnumNeedsRelease(c: inout c, instRef: f.ty)
            }
            return false
        }
    }
    if structNeedsRelease(c: inout c, start: f.tyStart, len: f.tyLen) {
        return true
    }
    return enumNeedsRelease(c: inout c, start: f.tyStart, len: f.tyLen)
}

// Retain a boxed field's cell (copy/share): bump the cell's refcount. `s` is the
// source value; for an enum field the access goes through `.data.<variant>`.
fn emitBoxedFieldRetain(c: inout Comp, f: FieldDef, isEnum: Bool, vStart: U64, vLen: U64) {
    write(s: " plew_ref_share((void*)s.")
    if isEnum {
        write(s: "data.")
        writeSpan(c: inout c, start: vStart, len: vLen)
        write(s: ".")
    }
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
    write(s: ");")
}

// Release a boxed field's cell: drop its refcount; at zero, recursively release
// the pointee (if it owns heap) and free the cell.
fn emitBoxedFieldRelease(c: inout Comp, f: FieldDef, isEnum: Bool, vStart: U64, vLen: U64) {
    write(s: " { ")
    genCTypeOf(c: inout c, tyRef: f.ty, fallStart: f.tyStart, fallLen: f.tyLen, isArray: false)
    write(s: "* __bp = s.")
    if isEnum {
        write(s: "data.")
        writeSpan(c: inout c, start: vStart, len: vLen)
        write(s: ".")
    }
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
    write(s: "; if (__bp) { long long* __brc = ((long long*)__bp) - 1; if ((--(*__brc)) == 0) {")
    if pointeeNeedsRelease(c: inout c, f: f) {
        write(s: " ")
        if isGenericInst(c: inout c, ref: f.ty) {
            emitMangle(c: inout c, ref: f.ty)
        } else {
            writeSpan(c: inout c, start: f.tyStart, len: f.tyLen)
        }
        write(s: "_release(*__bp);")
    }
    write(s: " free(__brc); } } }")
}

// `void Name_release(Name s);` prototype.
fn emitStructReleaseProto(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    write(s: "void ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: "_release(")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " s);\n")
}


// Write the C access path for a field. A struct field is `obj.field`; an enum
// payload field is `obj.data.<variant>.field`.
fn weAccF(c: inout Comp, obj: String, isEnum: Bool, vStart: U64, vLen: U64, f: FieldDef) {
    write(s: obj)
    if isEnum {
        write(s: ".data.")
        writeSpan(c: inout c, start: vStart, len: vLen)
        write(s: ".")
    } else {
        write(s: ".")
    }
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
}

// Emit the copy(0)/share(1)/release(2) action for ONE field — shared by struct
// and (concrete) enum ARC emitters. The source value is `s`, the (copy) target
// `r`; `isEnum`+variant select the access path. This is the single place the
// field-class cascade (boxed / array / RawBuffer / unique / nested) is encoded.
fn emitFieldAction(c: inout Comp, f: FieldDef, isEnum: Bool, vStart: U64, vLen: U64, mode: U64) {
    if fieldIsBoxed(c: inout c, f: f) {
        if mode == 2 {
            emitBoxedFieldRelease(c: inout c, f: f, isEnum: isEnum, vStart: vStart, vLen: vLen)
        } else {
            emitBoxedFieldRetain(c: inout c, f: f, isEnum: isEnum, vStart: vStart, vLen: vLen)
        }
        return
    }
    if f.tyIsArray {
        if mode == 0 {
            write(s: " ")
            weAccF(c: inout c, obj: "r", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
            write(s: " = ")
            wPA(c: inout c, elemStart: f.tyStart, elemLen: f.tyLen)
            write(s: "_copy(")
            weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
            write(s: ");")
        } else {
            write(s: " ")
            wPA(c: inout c, elemStart: f.tyStart, elemLen: f.tyLen)
            if mode == 1 {
                write(s: "_share(")
            } else {
                write(s: "_release(")
            }
            weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
            write(s: ");")
        }
        return
    }
    if rangeEquals(bytes: c.bytes, start: f.tyStart, len: f.tyLen, kw: "RawBuffer") {
        if mode == 2 {
            write(s: " plew_rawbuf_release((void*)")
        } else {
            write(s: " plew_rawbuf_share((void*)")
        }
        weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
        write(s: ");")
        return
    }
    // a unique field is destroyed in place on release (spec/03: type body before
    // fields): run its deinit, then release its own heap. (Unique types never
    // copy/share, so this is release-only.)
    if mode == 2 {
        if typeIsUnique(c: inout c, start: f.tyStart, len: f.tyLen) {
            if structHasDeinit(c: inout c, start: f.tyStart, len: f.tyLen) {
                write(s: " ")
                writeSpan(c: inout c, start: f.tyStart, len: f.tyLen)
                write(s: "_deinit(")
                weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
                write(s: ");")
            }
            if structNeedsRelease(c: inout c, start: f.tyStart, len: f.tyLen) {
                write(s: " ")
                writeSpan(c: inout c, start: f.tyStart, len: f.tyLen)
                write(s: "_release(")
                weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
                write(s: ");")
            }
            return
        }
    }
    // nominal struct/enum field (concrete or mono instantiation).
    mut val gen: Bool = false
    if f.ty != 0 {
        gen = isGenericInst(c: inout c, ref: f.ty)
    }
    mut val needs: Bool = false
    if mode == 2 {
        needs = fieldNeedsRelease(c: inout c, f: f)
    } else {
        needs = fieldNeedsCopy(c: inout c, f: f)
    }
    if needs {
    } else {
        return
    }
    if mode == 0 {
        write(s: " ")
        weAccF(c: inout c, obj: "r", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
        write(s: " = ")
        if gen {
            emitMangle(c: inout c, ref: f.ty)
        } else {
            writeSpan(c: inout c, start: f.tyStart, len: f.tyLen)
        }
        write(s: "_copy(")
        weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
        write(s: ");")
    } else {
        write(s: " ")
        if gen {
            emitMangle(c: inout c, ref: f.ty)
        } else {
            writeSpan(c: inout c, start: f.tyStart, len: f.tyLen)
        }
        if mode == 1 {
            write(s: "_share(")
        } else {
            write(s: "_release(")
        }
        weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
        write(s: ");")
    }
}

// Whether enum variant `v` has any field needing the op (mode 0/1 copy, 2 release).
fn variantHasAction(c: inout Comp, v: Variant, mode: U64) -> Bool {
    val fs: Array[FieldDef] = v.fields
    mut val i: U64 = 0
    while i < fs.count {
        if mode == 2 {
            if fieldNeedsRelease(c: inout c, f: fs[i]) {
                return true
            }
        } else {
            if fieldNeedsCopy(c: inout c, f: fs[i]) {
                return true
            }
        }
        i += 1
    }
    return false
}

// Concrete enum copy/share/release prototypes + definitions (value-semantics ARC).
fn emitEnumCopyProto(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: "_copy(")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " s);\n")
}
fn emitEnumShareProto(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: "_share(")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " s);\n")
}
fn emitEnumReleaseProto(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    write(s: "void ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: "_release(")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " s);\n")
}

// `E E_copy(E s) { E r = s; if (r.tag==N) { <copy payload> } ... return r; }`
fn emitEnumModeDef(c: inout Comp, ei: U64, mode: U64) {
    val e: EnumDef = c.enums[ei]
    if mode == 2 {
        write(s: "void ")
    } else {
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: " ")
    }
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    if mode == 0 {
        write(s: "_copy(")
    } else {
        if mode == 1 {
            write(s: "_share(")
        } else {
            write(s: "_release(")
        }
    }
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " s) {")
    if mode == 0 {
        write(s: " ")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: " r = s;")
    }
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val v: Variant = vars[vi]
        if variantHasAction(c: inout c, v: v, mode: mode) {
            write(s: " if (s.tag == ")
            writeU64(n: vi)
            write(s: ") {")
            val fs: Array[FieldDef] = v.fields
            mut val fi: U64 = 0
            while fi < fs.count {
                emitFieldAction(c: inout c, f: fs[fi], isEnum: true, vStart: v.nameStart, vLen: v.nameLen, mode: mode)
                fi += 1
            }
            write(s: " }")
        }
        vi += 1
    }
    if mode == 2 {
        write(s: " }\n")
    } else {
        write(s: " return ")
        if mode == 0 {
            write(s: "r")
        } else {
            write(s: "s")
        }
        write(s: "; }\n")
    }
}

// `Name Name_copy(Name s) { Name r = s; <field actions> return r; }` — the flat
// (struct) counterpart of emitEnumModeDef, sharing emitFieldAction. mode 0/1/2 =
// copy/share/release. Replaces the former emitStruct{Copy,Share,Release}Def.
fn emitStructModeDef(c: inout Comp, si: U64, mode: U64) {
    val s: StructDef = c.structs[si]
    if mode == 2 {
        write(s: "void ")
    } else {
        writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
        write(s: " ")
    }
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    if mode == 0 {
        write(s: "_copy(")
    } else {
        if mode == 1 {
            write(s: "_share(")
        } else {
            write(s: "_release(")
        }
    }
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " s) {")
    if mode == 0 {
        write(s: " ")
        writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
        write(s: " r = s;")
    }
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        emitFieldAction(c: inout c, f: fields[i], isEnum: false, vStart: 0, vLen: 0, mode: mode)
        i += 1
    }
    if mode == 2 {
        write(s: " }\n")
    } else {
        write(s: " return ")
        if mode == 0 {
            write(s: "r")
        } else {
            write(s: "s")
        }
        write(s: "; }\n")
    }
}

// Mono struct/enum copy(0)/share(1)/release(2) prototype + definition, unified.
// Replaces the former emitMono{Struct,Enum}Copy* + emitMonoEnumMode*.
fn emitMonoModeProto(c: inout Comp, instRef: U64, mode: U64) {
    if mode == 2 {
        write(s: "void ")
    } else {
        emitMangle(c: inout c, ref: instRef)
        write(s: " ")
    }
    emitMangle(c: inout c, ref: instRef)
    if mode == 0 {
        write(s: "_copy(")
    } else {
        if mode == 1 {
            write(s: "_share(")
        } else {
            write(s: "_release(")
        }
    }
    emitMangle(c: inout c, ref: instRef)
    write(s: " s);\n")
}
fn emitMonoModeDef(c: inout Comp, instRef: U64, isEnum: Bool, mode: U64) {
    val t: TypeRef = c.types[instRef]
    mut val params: Array[Bind] = []
    mut val vars: Array[Variant] = []
    mut val fields: Array[FieldDef] = []
    if isEnum {
        val ei: U64 = genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
        if ei >= c.enums.count {
            return
        }
        params = c.enums[ei].typeParams
        vars = c.enums[ei].variants
    } else {
        val si: U64 = genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
        if si >= c.structs.count {
            return
        }
        params = c.structs[si].typeParams
        fields = c.structs[si].fields
    }
    // env so a type-parameter array element resolves to the concrete element in wPA.
    val savedP: Array[Bind] = c.curTypeParams
    val savedA: Array[U64] = c.curTypeArgs
    c.curTypeParams = params
    c.curTypeArgs = t.args
    if mode == 2 {
        write(s: "void ")
    } else {
        emitMangle(c: inout c, ref: instRef)
        write(s: " ")
    }
    emitMangle(c: inout c, ref: instRef)
    if mode == 0 {
        write(s: "_copy(")
    } else {
        if mode == 1 {
            write(s: "_share(")
        } else {
            write(s: "_release(")
        }
    }
    emitMangle(c: inout c, ref: instRef)
    write(s: " s) {")
    if mode == 0 {
        write(s: " ")
        emitMangle(c: inout c, ref: instRef)
        write(s: " r = s;")
    }
    if isEnum {
        mut val vi: U64 = 0
        while vi < vars.count {
            val v: Variant = vars[vi]
            val fs: Array[FieldDef] = v.fields
            mut val any: Bool = false
            mut val ck: U64 = 0
            while ck < fs.count {
                val cti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: params, tyRef: fs[ck].ty)
                if mode == 2 {
                    if typeInfoNeedsRelease(c: inout c, ti: cti) {
                        any = true
                    }
                } else {
                    if typeInfoNeedsCopy(c: inout c, ti: cti) {
                        any = true
                    }
                }
                ck += 1
            }
            if any {
                write(s: " if (s.tag == ")
                writeU64(n: vi)
                write(s: ") {")
                mut val fi: U64 = 0
                while fi < fs.count {
                    val ti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: params, tyRef: fs[fi].ty)
                    emitMonoFieldAction(c: inout c, ti: ti, isEnum: true, vStart: v.nameStart, vLen: v.nameLen, f: fs[fi], mode: mode)
                    fi += 1
                }
                write(s: " }")
            }
            vi += 1
        }
    } else {
        mut val fi: U64 = 0
        while fi < fields.count {
            val ti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: params, tyRef: fields[fi].ty)
            emitMonoFieldAction(c: inout c, ti: ti, isEnum: false, vStart: 0, vLen: 0, f: fields[fi], mode: mode)
            fi += 1
        }
    }
    if mode == 2 {
        write(s: " }\n")
    } else {
        write(s: " return ")
        if mode == 0 {
            write(s: "r")
        } else {
            write(s: "s")
        }
        write(s: "; }\n")
    }
    c.curTypeParams = savedP
    c.curTypeArgs = savedA
}

// Does a mono struct instantiation need release? Any field (substituted) does.
fn monoStructNeedsRelease(c: inout Comp, instRef: U64) -> Bool {
    val t: TypeRef = c.types[instRef]
    val si: U64 = genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if si >= c.structs.count {
        return false
    }
    val s: StructDef = c.structs[si]
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        val ti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: s.typeParams, tyRef: fields[i].ty)
        if typeInfoNeedsRelease(c: inout c, ti: ti) {
            return true
        }
        i += 1
    }
    return false
}

// One mono (struct or enum) field action, driven by its substituted type `ti`.
// Shared by mono struct + mono enum copy(0)/share(1)/release(2). `isEnum`+variant
// select the access path. Mono fields are never boxed (boxing is concrete-only).
fn emitMonoFieldAction(c: inout Comp, ti: TypeInfo, isEnum: Bool, vStart: U64, vLen: U64, f: FieldDef, mode: U64) {
    mut val needs: Bool = false
    if mode == 2 {
        needs = typeInfoNeedsRelease(c: inout c, ti: ti)
    } else {
        needs = typeInfoNeedsCopy(c: inout c, ti: ti)
    }
    if needs {
    } else {
        return
    }
    if mode == 0 {
        write(s: " ")
        weAccF(c: inout c, obj: "r", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
        write(s: " = ")
        if ti.kind == 3 {
            wPA(c: inout c, elemStart: ti.nameStart, elemLen: ti.nameLen)
        } else {
            emitTypeInfoCName(c: inout c, ti: ti)
        }
        write(s: "_copy(")
        weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
        write(s: ");")
        return
    }
    write(s: " ")
    if ti.kind == 3 {
        wPA(c: inout c, elemStart: ti.nameStart, elemLen: ti.nameLen)
    } else {
        emitTypeInfoCName(c: inout c, ti: ti)
    }
    if mode == 1 {
        write(s: "_share(")
    } else {
        write(s: "_release(")
    }
    weAccF(c: inout c, obj: "s", isEnum: isEnum, vStart: vStart, vLen: vLen, f: f)
    write(s: ");")
}

// Write the C type name for a recovered TypeInfo (mono mangle or concrete span).
fn emitTypeInfoCName(c: inout Comp, ti: TypeInfo) {
    if ti.ref != 0 {
        if isGenericInst(c: inout c, ref: ti.ref) {
            emitMangle(c: inout c, ref: ti.ref)
            return
        }
    }
    writeSpan(c: inout c, start: ti.nameStart, len: ti.nameLen)
}

// Does a monomorphized generic struct instantiation need a deep copy? True if
// any field, after substituting the instantiation's type args, needs copy.
fn monoStructNeedsCopy(c: inout Comp, instRef: U64) -> Bool {
    val t: TypeRef = c.types[instRef]
    val si: U64 = genericStructIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if si >= c.structs.count {
        return false
    }
    val s: StructDef = c.structs[si]
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        val ti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: s.typeParams, tyRef: fields[i].ty)
        if typeInfoNeedsCopy(c: inout c, ti: ti) {
            return true
        }
        i += 1
    }
    return false
}

// Does a mono generic enum instantiation need a deep copy? True if any variant
// field, after substitution, is an array.
fn monoEnumNeedsCopy(c: inout Comp, instRef: U64) -> Bool {
    val t: TypeRef = c.types[instRef]
    val ei: U64 = genericEnumIndex(c: inout c, nameStart: t.nameStart, nameLen: t.nameLen)
    if ei >= c.enums.count {
        return false
    }
    val e: EnumDef = c.enums[ei]
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val fs: Array[FieldDef] = vars[vi].fields
        mut val fi: U64 = 0
        while fi < fs.count {
            val ti: TypeInfo = substTypeInfo(c: inout c, instRef: instRef, params: e.typeParams, tyRef: fs[fi].ty)
            if typeInfoNeedsCopy(c: inout c, ti: ti) {
                return true
            }
            fi += 1
        }
        vi += 1
    }
    return false
}


// Emit a struct *value* for a mutable binding/store: deep-copy when the source
// is a place and the struct needs copying (value semantics), else emit directly.
fn genStructValue(c: inout Comp, exprId: U64, structStart: U64, structLen: U64) {
    if isPlaceExpr(c: inout c, id: exprId) {
        if structNeedsCopy(c: inout c, start: structStart, len: structLen) {
            // CoW: share (retain heap fields) instead of deep-copying.
            writeSpan(c: inout c, start: structStart, len: structLen)
            write(s: "_share(")
            genExpr(c: inout c, id: exprId)
            write(s: ")")
            return
        }
    }
    genExpr(c: inout c, id: exprId)
}

// Unified value-semantics copy for a binding/store/return, given the declared
// type. Arrays and (mono / plain) structs that hold buffers deep-copy from a
// place; everything else (scalars, Strings, Refs, fresh values) emits directly.
fn genCopyValue(c: inout Comp, exprId: U64, tyRef: U64, fallStart: U64, fallLen: U64, isArray: Bool) {
    if isArray {
        genArrayValue(c: inout c, exprId: exprId, elemStart: fallStart, elemLen: fallLen)
        return
    }
    if isRefInst(c: inout c, ref: tyRef) {
        // CoW share for a Ref: binding from a live place retains the box; a fresh
        // Ref (from `<Ref .../>`) transfers its rc=1 and is emitted directly.
        if isPlaceExpr(c: inout c, id: exprId) {
            write(s: "plew_ref_share((void*)(")
            genExpr(c: inout c, id: exprId)
            write(s: "))")
            return
        }
        genExpr(c: inout c, id: exprId)
        return
    }
    if isFnType(c: inout c, ref: tyRef) {
        // a closure value: binding/returning from a live place retains the env
        // (so both references can release it); a fresh closure (literal / call
        // result) transfers its env rc and is emitted directly.
        if isPlaceExpr(c: inout c, id: exprId) {
            write(s: "plew_closure_share(")
            genExpr(c: inout c, id: exprId)
            write(s: ")")
            return
        }
        genExpr(c: inout c, id: exprId)
        return
    }
    if isGenericInst(c: inout c, ref: tyRef) {
        mut val needs: Bool = false
        if isGenericEnumInst(c: inout c, ref: tyRef) {
            needs = monoEnumNeedsCopy(c: inout c, instRef: tyRef)
        } else {
            needs = monoStructNeedsCopy(c: inout c, instRef: tyRef)
        }
        if needs {
            if isPlaceExpr(c: inout c, id: exprId) {
                emitMangle(c: inout c, ref: tyRef)
                write(s: "_copy(")
                genExpr(c: inout c, id: exprId)
                write(s: ")")
                return
            }
        }
        genExpr(c: inout c, id: exprId)
        return
    }
    // a concrete enum that owns heap (recursive boxes / enum-held buffers): retain
    // from a live place so the store owns an independent copy (a fresh value owns
    // its heap already and is emitted directly).
    if isPlaceExpr(c: inout c, id: exprId) {
        if enumNeedsCopy(c: inout c, start: fallStart, len: fallLen) {
            writeSpan(c: inout c, start: fallStart, len: fallLen)
            write(s: "_share(")
            genExpr(c: inout c, id: exprId)
            write(s: ")")
            return
        }
    }
    genStructValue(c: inout c, exprId: exprId, structStart: fallStart, structLen: fallLen)
}

// ---- dependency-ordered emission of concrete nominal bodies ----
//
// A type's C body must appear after every type it holds BY VALUE (a by-value
// field needs the complete type). The old order ("all enums, then all structs in
// source order") only works when no enum holds a struct by value and structs are
// already source-ordered by dependency. emitNominalBodiesTopo lifts both: it emits
// concrete (non-generic, non-extern) struct/enum bodies in a post-order DFS over
// the by-value containment graph, so an enum may hold a struct payload by value
// (e.g. value-tree ASTs) and structs may be defined in any order.
//
// Edges exclude indirection — boxed (recursive), Array, Ref/WeakRef, RawBuffer,
// and monomorphized generic fields are all behind a pointer/emitted elsewhere, so
// they impose no completeness constraint. By-value containment is therefore a DAG
// (mutual by-value recursion is impossible — the compiler boxes one side), so the
// DFS terminates.

// Is field `f` a pointer-like indirection that imposes no by-value dependency?
fn fieldIsIndirect(c: inout Comp, f: FieldDef) -> Bool {
    if fieldIsBoxed(c: inout c, f: f) {
        return true
    }
    if f.tyIsArray {
        return true
    }
    if f.ty != 0 {
        if isGenericInst(c: inout c, ref: f.ty) {
            return true
        }
    }
    if rangeEquals(bytes: c.bytes, start: f.tyStart, len: f.tyLen, kw: "Ref") {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: f.tyStart, len: f.tyLen, kw: "WeakRef") {
        return true
    }
    if rangeEquals(bytes: c.bytes, start: f.tyStart, len: f.tyLen, kw: "RawBuffer") {
        return true
    }
    return false
}

// Recurse into each by-value nominal dependency of the given fields, emitting it
// (and its transitive deps) first.
fn emitFieldDeps(c: inout Comp, fields: Array[FieldDef], doneS: inout Array[Bool], doneE: inout Array[Bool]) {
    mut val k: U64 = 0
    while k < fields.count {
        val f: FieldDef = fields[k]
        if fieldIsIndirect(c: inout c, f: f) {
        } else {
            val si: U64 = structIndexByName(c: inout c, start: f.tyStart, len: f.tyLen)
            if si < c.structs.count {
                val isExtern: Bool = c.structs[si].isExtern
                val tp: U64 = c.structs[si].typeParams.count
                if isExtern {
                } else {
                    if tp > 0 {
                    } else {
                        emitNominalNode(c: inout c, isEnum: false, idx: si, doneS: inout doneS, doneE: inout doneE)
                    }
                }
            } else {
                val ei: U64 = concreteEnumIndex(c: inout c, nStart: f.tyStart, nLen: f.tyLen)
                if ei < c.enums.count {
                    emitNominalNode(c: inout c, isEnum: true, idx: ei, doneS: inout doneS, doneE: inout doneE)
                }
            }
        }
        k += 1
    }
}

// Emit one concrete nominal body after its by-value deps (post-order). `done*`
// guards re-emission (and, harmlessly given the DAG, any back-edge).
fn emitNominalNode(c: inout Comp, isEnum: Bool, idx: U64, doneS: inout Array[Bool], doneE: inout Array[Bool]) {
    if isEnum {
        if idx >= c.enums.count {
            return
        }
        if doneE[idx] {
            return
        }
        doneE[idx] = true
        if c.enums[idx].typeParams.count > 0 {
            return
        }
        val vars: Array[Variant] = c.enums[idx].variants
        mut val vi: U64 = 0
        while vi < vars.count {
            emitFieldDeps(c: inout c, fields: vars[vi].fields, doneS: inout doneS, doneE: inout doneE)
            vi += 1
        }
        genEnumDef(c: inout c, ei: idx)
    } else {
        if idx >= c.structs.count {
            return
        }
        if doneS[idx] {
            return
        }
        doneS[idx] = true
        if c.structs[idx].typeParams.count > 0 || c.structs[idx].isExtern {
            return
        }
        val fields: Array[FieldDef] = c.structs[idx].fields
        emitFieldDeps(c: inout c, fields: fields, doneS: inout doneS, doneE: inout doneE)
        genStructDef(c: inout c, si: idx)
    }
}

// Emit all concrete nominal bodies in dependency order. Roots iterate enums then
// structs (matching the old order when there are no cross edges); the DFS pulls
// each type's by-value deps ahead of it.
fn emitNominalBodiesTopo(c: inout Comp) {
    mut val doneS: Array[Bool] = []
    mut val si0: U64 = 0
    while si0 < c.structs.count {
        doneS.append(false)
        si0 += 1
    }
    mut val doneE: Array[Bool] = []
    mut val ei0: U64 = 0
    while ei0 < c.enums.count {
        doneE.append(false)
        ei0 += 1
    }
    mut val ej: U64 = 0
    while ej < c.enums.count {
        emitNominalNode(c: inout c, isEnum: true, idx: ej, doneS: inout doneS, doneE: inout doneE)
        ej += 1
    }
    mut val sj: U64 = 0
    while sj < c.structs.count {
        emitNominalNode(c: inout c, isEnum: false, idx: sj, doneS: inout doneS, doneE: inout doneE)
        sj += 1
    }
}

// Emit a struct body `struct Name { <ctype> field; ... };`. Forward typedefs
// are emitted separately so structs can reference each other by name; by-value
// struct fields still require their definition to appear earlier (emitted in
// dependency order by emitNominalBodiesTopo).
fn genStructDef(c: inout Comp, si: U64) {
    val s: StructDef = c.structs[si]
    write(s: "struct ")
    writeSpan(c: inout c, start: s.nameStart, len: s.nameLen)
    write(s: " {\n")
    val fields: Array[FieldDef] = s.fields
    mut val i: U64 = 0
    while i < fields.count {
        val f: FieldDef = fields[i]
        write(s: "    ")
        genCTypeOf(c: inout c, tyRef: f.ty, fallStart: f.tyStart, fallLen: f.tyLen, isArray: f.tyIsArray)
        write(s: " ")
        if fieldIsBoxed(c: inout c, f: f) {
            // recursive field: stored behind a heap pointer (spec/03) so the C
            // struct is finite. The pointee type is only forward-declared here.
            write(s: "*")
        }
        writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
        write(s: ";\n")
        i += 1
    }
    write(s: "};\n")
}

// Emit a function's selector-mangled C name: `<name>` then, per parameter,
// `_<label>_<typehead>` (an array type head is prefixed `A`). Two overloads that
// differ in arity, labels, or parameter types thus get distinct C symbols. The
// receiver prefix (for a method) is emitted separately by the caller. Emitted
// identically at the definition, prototype, and every call site, so they agree.
// `main` and intercepted builtins never reach here.
// Do two free functions emit the same C base name (same function name, parameter
// labels, and parameter type heads)? Compares the DECLARED selector — generic
// instances are further disambiguated by their resolved type-arg suffix, so a
// declared-selector clash is the necessary condition for any C-symbol clash.
fn sameFreeFnSelectorDecl(c: inout Comp, a: Func, b: Func) -> Bool {
    if a.nameId == b.nameId {
    } else {
        return false
    }
    if a.params.count == b.params.count {
    } else {
        return false
    }
    mut val i: U64 = 0
    while i < a.params.count {
        val pa: Param = a.params[i]
        val pb: Param = b.params[i]
        if pa.nameId == pb.nameId {
        } else {
            return false
        }
        if pa.tyNameId == pb.tyNameId {
        } else {
            return false
        }
        i += 1
    }
    return true
}

// Whether another free function in a DIFFERENT module shares f's C base name.
// Only then does f need a module discriminator. Most names are unique, so this is
// false for nearly every function — the common-case C output (and the self-host
// fixpoint) is unchanged; only a genuine cross-module clash gets disambiguated.
fn freeFnSelectorCollides(c: inout Comp, f: Func) -> Bool {
    val myMod: U64 = moduleOf(c: inout c, offset: f.nameStart)
    mut val i: U64 = 0
    while i < c.funcs.count {
        val g: Func = c.funcs[i]
        if g.hasRecv {
        } else {
            if g.isAssoc {
            } else {
                if g.isExtern {
                } else {
                    if moduleOf(c: inout c, offset: g.nameStart) == myMod {
                    } else {
                        if sameFreeFnSelectorDecl(c: inout c, a: f, b: g) {
                            return true
                        }
                    }
                }
            }
        }
        i += 1
    }
    return false
}

fn writeFnSelector(c: inout Comp, f: Func) {
    writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
    if f.isCExtern {
        // `extern(c)` foreign fn: the C symbol is the RAW name (no selector mangling,
        // no module discriminator) — it must match the linked library's symbol.
        return
    }
    val params: Array[Param] = f.params
    mut val i: U64 = 0
    while i < params.count {
        val p: Param = params[i]
        write(s: "_")
        writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
        write(s: "_")
        // an array param mangles as `A<elem>`; resolve a type-parameter element
        // (`Array[T]` -> `AI32`) under the active monomorphization env so a generic
        // free function's instance matches the call site. Only for free functions:
        // a generic method's instance is disambiguated by its mangled receiver
        // prefix (`Box_I32_`), so its selector keeps the literal type-param name.
        if p.tyIsArray {
            write(s: "A")
        }
        mut val resolved: Bool = false
        if f.hasRecv {
        } else {
            mut val k: U64 = 0
            while k < c.curTypeParams.count {
                val tp: Bind = c.curTypeParams[k]
                if p.tyNameId == tp.nameId {
                    emitMangle(c: inout c, ref: c.curTypeArgs[k])
                    resolved = true
                    k = c.curTypeParams.count
                } else {
                    k += 1
                }
            }
        }
        if resolved {
        } else {
            writeSpan(c: inout c, start: p.tyStart, len: p.tyLen)
        }
        i += 1
    }
    // Disambiguate a free function whose C base name clashes with a same-named one
    // in another module (`redefinition` otherwise). Derived from f.nameStart, so
    // the definition and every call site (writeFnSelector on the same resolved
    // Func) agree. Methods/assoc fns carry a `Recv_` prefix; `main` and extern
    // intrinsics keep their fixed C names. Gated on an actual clash, so non-clashing
    // names (the norm — including the whole compiler) are emitted unchanged.
    if f.hasRecv {
    } else {
        if f.isAssoc {
        } else {
            if f.isExtern {
            } else {
                if nameIsMain(c: inout c, f: f) {
                } else {
                    if freeFnSelectorCollides(c: inout c, f: f) {
                        write(s: "_m")
                        writeU64(n: moduleOf(c: inout c, offset: f.nameStart))
                    }
                }
            }
        }
    }
}

// Emit a C function signature (no trailing `;` or `{`). `main` is special:
// `int main(void)`. The return type and each parameter type come from the
// declared Plew types via genCType (scalars -> long long, named types echoed).
fn genSignature(c: inout Comp, f: Func) {
    if nameIsMain(c: inout c, f: f) {
        write(s: "int main(int argc, char** argv)")
        return
    }
    if f.hasRet {
        genCTypeOf(c: inout c, tyRef: f.retTy, fallStart: f.retStart, fallLen: f.retLen, isArray: f.retIsArray)
        write(s: " ")
    } else {
        write(s: "void ")
    }
    // method: mangle to `Recv_name` with a leading `self` parameter. For a
    // generic method, the receiver is the mangled instantiation (`Optional_I32`).
    // An assoc fn also takes the `Recv_` prefix (its namespace) but no self.
    if f.hasRecv {
        if c.curRecvInstRef != 0 {
            emitMangle(c: inout c, ref: c.curRecvInstRef)
        } else {
            writeSpan(c: inout c, start: f.recvStart, len: f.recvLen)
        }
        write(s: "_")
    } else {
        if f.isAssoc {
            writeSpan(c: inout c, start: f.recvStart, len: f.recvLen)
            write(s: "_")
        }
    }
    writeFnSelector(c: inout c, f: f)
    // a generic method instance: its method-own type args are encoded by neither the
    // receiver mangle nor the selector, so append them as a suffix (matched at the
    // call site). On a generic receiver the first `rcount` args are the receiver's
    // (already in its mangle); only the method-own tail is appended (empty for a
    // method with no own params, e.g. `filter` on `MapIter`).
    if f.hasRecv {
        if f.typeParams.count > 0 {
            if c.curTypeArgs.count > 0 {
                mut val rcount: U64 = 0
                if c.curRecvInstRef != 0 {
                    rcount = recvParamCount(c: inout c, nameStart: f.recvStart, nameLen: f.recvLen)
                }
                writeMethodInstSuffixFrom(c: inout c, typeArgs: c.curTypeArgs, startIdx: rcount)
            }
        }
    }
    write(s: "(")
    val params: Array[Param] = f.params
    if f.hasRecv {
        if c.curRecvInstRef != 0 {
            emitConcreteCType(c: inout c, ref: c.curRecvInstRef)
        } else {
            genCTypeRef(c: inout c, start: f.recvStart, len: f.recvLen, isArray: false)
        }
        if f.selfInout {
            write(s: "*")
        }
        write(s: " self")
        mut val i: U64 = 0
        while i < params.count {
            write(s: ", ")
            val p: Param = params[i]
            genCTypeOf(c: inout c, tyRef: p.ty, fallStart: p.tyStart, fallLen: p.tyLen, isArray: p.tyIsArray)
            if p.isInout {
                write(s: "*")
            }
            write(s: " ")
            writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
            i += 1
        }
    } else {
        if params.count == 0 {
            write(s: "void")
        } else {
            mut val i: U64 = 0
            while i < params.count {
                if i > 0 {
                    write(s: ", ")
                }
                val p: Param = params[i]
                genCTypeOf(c: inout c, tyRef: p.ty, fallStart: p.tyStart, fallLen: p.tyLen, isArray: p.tyIsArray)
                if p.isInout {
                    write(s: "*")
                }
                write(s: " ")
                writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
                i += 1
            }
        }
    }
    write(s: ")")
}

// Emit self's deinit+release for a `move fn` method (it owns the consumed self).
// The C parameter is literally `self`. Called at every exit (returns + fall-
// through); past a `return` it is unreachable (harmless), like owned params.
fn emitSelfDeinit(c: inout Comp) {
    if c.curSelfMove {
        if structHasDeinit(c: inout c, start: c.curRecvStart, len: c.curRecvLen) {
            write(s: "    ")
            writeSpan(c: inout c, start: c.curRecvStart, len: c.curRecvLen)
            write(s: "_deinit(self);\n")
        }
        if structNeedsRelease(c: inout c, start: c.curRecvStart, len: c.curRecvLen) {
            write(s: "    ")
            writeSpan(c: inout c, start: c.curRecvStart, len: c.curRecvLen)
            write(s: "_release(self);\n")
        }
    }
}

fn genFunc(c: inout Comp, fi: U64) {
    // fresh type cache per body emission (a cached grounded type is only valid for
    // this body's env — Self / type args / instantiation).
    clearExprTyCache(c: inout c)
    val f: Func = c.funcs[fi]
    val isMain: Bool = nameIsMain(c: inout c, f: f)
    c.curIsMain = isMain
    if f.hasRet {
        c.curRetVoid = false
        c.curRetStart = f.retStart
        c.curRetLen = f.retLen
        c.curRetIsArray = f.retIsArray
        c.curRetTy = f.retTy
    } else {
        c.curRetVoid = true
        c.curRetStart = 0
        c.curRetLen = 0
        c.curRetIsArray = false
        c.curRetTy = 0
    }
    // expose the method receiver so a bare `self` in the body resolves (and
    // lowers to `(*self)` for `inout fn`).
    c.curHasRecv = f.hasRecv
    c.curRecvStart = f.recvStart
    c.curRecvLen = f.recvLen
    c.curSelfInout = f.selfInout
    c.curSelfMove = f.selfMove
    // `Self`/`Item`-as-type env for the body (a provided method's `<MapIter[Self,
    // …]>` / `fn(x: Item)`): Self = receiver, Item = its `type Item` binding.
    if f.hasRecv {
        setSelfItemEnv(c: inout c, recvStart: f.recvStart, recvLen: f.recvLen, recvInstRef: c.curRecvInstRef)
    } else {
        clearSelfItemEnv(c: inout c)
    }
    c.curBranchBase = 0
    // fresh local scope for this function: parameters are the initial bindings
    c.locals = []
    val params: Array[Param] = f.params
    mut val pi: U64 = 0
    while pi < params.count {
        val p: Param = params[pi]
        // a `move T` parameter transfers ownership to the callee, so it is owned
        // here and runs deinit/release at this function's scope exit.
        addLocal(c: inout c, nameStart: p.nameStart, nameLen: p.nameLen, tyStart: p.tyStart, tyLen: p.tyLen, isArray: p.tyIsArray, ty: p.ty, isInout: p.isInout, isMut: false, owned: p.isMove)
        pi += 1
    }
    genSignature(c: inout c, f: f)
    write(s: " {\n")
    if isMain {
        write(s: "    plew_argc = argc; plew_argv = argv;\n")
    }
    genBlock(c: inout c, id: f.body)
    // drop owned parameters at function end (a `move T` param is owned and runs
    // deinit/release here). genBlock dropped only the body's block-scope locals;
    // params sit below its mark. For a body that ends in `return` this is
    // unreachable (the return already dropped them); for fall-through it is live.
    emitScopeDrops(c: inout c, mark: 0, exclIdx: c.locals.count)
    // a `move fn` deinits its consumed self at the body's end (fall-through path).
    emitSelfDeinit(c: inout c)
    if isMain {
        write(s: "    return 0;\n")
    }
    write(s: "}\n")
    clearSelfItemEnv(c: inout c)
}

// Emit a lambda-lifted closure: signature `<ret> __closure<id>(<params>)`, then
// `;` (proto) or the body. v1 closures are non-capturing (the body sees its
// params and globals only). The expression `<id>` is the Closure's arena index.
fn genClosure(c: inout Comp, id: U64, proto: Bool) {
    // fresh type cache per closure body (its env differs from the enclosing body).
    clearExprTyCache(c: inout c)
    match c.exprs[id] {
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
            if hasRet {
                c.curRetVoid = false
                c.curRetStart = retStart
                c.curRetLen = retLen
                c.curRetIsArray = retIsArray
                c.curRetTy = retTy
                genCTypeOf(c: inout c, tyRef: retTy, fallStart: retStart, fallLen: retLen, isArray: retIsArray)
            } else {
                c.curRetVoid = true
                c.curRetStart = 0
                c.curRetLen = 0
                c.curRetIsArray = false
                c.curRetTy = 0
                write(s: "void")
            }
            write(s: " __closure")
            writeU64(n: id)
            // uniform closure ABI: the env pointer is always the first C param
            // (NULL for a non-capturing closure), so every function value can be
            // called the same way after a single cast at the call site.
            write(s: "(void* __env")
            if params.count == 0 {
            } else {
                mut val i: U64 = 0
                while i < params.count {
                    write(s: ", ")
                    val p: Param = params[i]
                    genCTypeOf(c: inout c, tyRef: p.ty, fallStart: p.tyStart, fallLen: p.tyLen, isArray: p.tyIsArray)
                    if p.isInout {
                        write(s: "*")
                    }
                    write(s: " ")
                    writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
                    i += 1
                }
            }
            write(s: ")")
            if proto {
                write(s: ";\n")
            } else {
                c.curIsMain = false
                c.curHasRecv = false
                c.curBranchBase = 0
                c.locals = []
                mut val pj: U64 = 0
                while pj < params.count {
                    val p2: Param = params[pj]
                    addLocal(c: inout c, nameStart: p2.nameStart, nameLen: p2.nameLen, tyStart: p2.tyStart, tyLen: p2.tyLen, isArray: p2.tyIsArray, ty: p2.ty, isInout: p2.isInout, isMut: false, owned: p2.isMove)
                    pj += 1
                }
                // mark this closure active so captured identifiers in the body
                // lower to env accesses; the env pointer arrives as `__env`.
                val savedId: U64 = c.curClosureId
                val savedIn: Bool = c.curInClosure
                c.curClosureId = id
                c.curInClosure = true
                write(s: " {\n")
                genBlock(c: inout c, id: body)
                write(s: "}\n")
                c.curClosureId = savedId
                c.curInClosure = savedIn
            }
        }
        _ => {}
    }
}

// Record that free function `fi` is used as a bare value (needs a thunk).
fn addFnThunk(c: inout Comp, fi: U64) {
    mut val i: U64 = 0
    while i < c.fnThunks.count {
        if c.fnThunks[i] == fi {
            return
        }
        i += 1
    }
    c.fnThunks.append(fi)
}

// Pre-pass: every bare identifier that names a (non-generic, non-method) free
// function is a function-as-value use (calls carry the name on Expr.Call, not an
// Ident), so it needs a thunk to reach the uniform closure ABI. Over-approx is
// safe: an unused thunk is harmless (and generated C is compiled with -w).
fn collectFnThunks(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        match c.exprs[i] {
            Expr.Ident(val start, val len) => {
                val fvi: U64 = firstFuncByName(c: inout c, nameStart: start, nameLen: len)
                if fvi < c.funcs.count {
                    val f: Func = c.funcs[fvi]
                    if f.hasRecv {
                    } else {
                        if f.isAssoc {
                        } else {
                            if f.typeParams.count > 0 {
                                // a generic free fn has no bare symbol (it is emitted
                                // per instantiation) — not supported as a value yet.
                            } else {
                                addFnThunk(c: inout c, fi: fvi)
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        i += 1
    }
}

// Emit one function's thunk `<ret> <sel>__thunk(void* __env, params...)` that
// forwards (positionally) to the plain C function, adapting it to the uniform
// closure ABI so a bare function reference becomes a PlewClosure.
fn genThunk(c: inout Comp, fi: U64, proto: Bool) {
    val f: Func = c.funcs[fi]
    if f.hasRet {
        genCTypeOf(c: inout c, tyRef: f.retTy, fallStart: f.retStart, fallLen: f.retLen, isArray: f.retIsArray)
        write(s: " ")
    } else {
        write(s: "void ")
    }
    writeFnSelector(c: inout c, f: f)
    write(s: "__thunk(void* __env")
    val params: Array[Param] = f.params
    mut val i: U64 = 0
    while i < params.count {
        write(s: ", ")
        val p: Param = params[i]
        genCTypeOf(c: inout c, tyRef: p.ty, fallStart: p.tyStart, fallLen: p.tyLen, isArray: p.tyIsArray)
        if p.isInout {
            write(s: "*")
        }
        write(s: " ")
        writeSpan(c: inout c, start: p.nameStart, len: p.nameLen)
        i += 1
    }
    write(s: ")")
    if proto {
        write(s: ";\n")
        return
    }
    write(s: " { (void)__env; ")
    if f.hasRet {
        write(s: "return ")
    }
    writeFnSelector(c: inout c, f: f)
    write(s: "(")
    mut val j: U64 = 0
    while j < params.count {
        if j > 0 {
            write(s: ", ")
        }
        val p2: Param = params[j]
        writeSpan(c: inout c, start: p2.nameStart, len: p2.nameLen)
        j += 1
    }
    write(s: "); }\n")
}

// Emit prototypes (proto=true) or bodies (proto=false) for every function-value
// thunk collected by collectFnThunks.
fn emitThunks(c: inout Comp, proto: Bool) {
    mut val i: U64 = 0
    while i < c.fnThunks.count {
        genThunk(c: inout c, fi: c.fnThunks[i], proto: proto)
        i += 1
    }
}

// Does the closure at arena id capture any enclosing locals?
fn closureHasCaptures(c: inout Comp, id: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        if c.captures[i].closureId == id {
            return true
        }
        i += 1
    }
    return false
}

// Is the local declared at source offset `nameStart` boxed (a `mut val` captured
// by some closure, so it lives in a shared ARC cell)? Matched by exact offset —
// a declaration site is unique — so it does not confuse same-named locals.
fn isBoxedLocalAt(c: inout Comp, nameStart: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        val e: CaptureEntry = c.captures[i]
        if e.boxed {
            if e.nameStart == nameStart {
                return true
            }
        }
        i += 1
    }
    return false
}

// Is (start,len) a boxed (mutable, reference) capture of closure `closureId`?
fn isBoxedCaptureOf(c: inout Comp, closureId: U64, start: U64, len: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        val e: CaptureEntry = c.captures[i]
        if e.closureId == closureId {
            if e.boxed {
                if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Is (start,len) the name of one of closure `closureId`'s captures?
fn isCaptureOf(c: inout Comp, closureId: U64, start: U64, len: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        val e: CaptureEntry = c.captures[i]
        if e.closureId == closureId {
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
                return true
            }
        }
        i += 1
    }
    return false
}

// `typedef struct { <ct> cap; ... } __closure_env<id>;` — the env layout for one
// capturing closure (scalar capture fields). The rc header lives just before the
// block (plew_arc_alloc), so it is not a struct field.
fn emitClosureEnvStruct(c: inout Comp, id: U64) {
    write(s: "typedef struct { ")
    mut val j: U64 = 0
    while j < c.captures.count {
        val e: CaptureEntry = c.captures[j]
        if e.closureId == id {
            genCTypeOf(c: inout c, tyRef: e.ty, fallStart: e.tyStart, fallLen: e.tyLen, isArray: e.isArray)
            // a boxed (mutable) capture stores a pointer to the shared cell.
            if e.boxed {
                write(s: "*")
            }
            write(s: " ")
            writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
            write(s: "; ")
        }
        j += 1
    }
    write(s: "} __closure_env")
    writeU64(n: id)
    write(s: ";\n")
}

// `static void __closure_env<id>_release(void* p)` — the env's drop: release
// every heap-owning capture (boxed mut cell, array, Ref box, heap struct) so the
// closure's last reference reclaims them. Scalars/Strings own no heap. Stored in
// PlewClosure.drop and run by plew_closure_release before the env block is freed.
fn emitClosureEnvDrop(c: inout Comp, id: U64) {
    write(s: "__attribute__((unused)) static void __closure_env")
    writeU64(n: id)
    write(s: "_release(void* __p) {\n    __closure_env")
    writeU64(n: id)
    write(s: "* e = (__closure_env")
    writeU64(n: id)
    write(s: "*)__p; (void)e;\n")
    mut val j: U64 = 0
    while j < c.captures.count {
        val e: CaptureEntry = c.captures[j]
        if e.closureId == id {
            if e.boxed {
                write(s: "    plew_arc_release(((long long*)e->")
                writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
                write(s: ") - 1);\n")
            } else {
                if e.isArray {
                    write(s: "    Array_")
                    writeSpan(c: inout c, start: e.tyStart, len: e.tyLen)
                    write(s: "_release(e->")
                    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
                    write(s: ");\n")
                } else {
                    if rangeEquals(bytes: c.bytes, start: e.tyStart, len: e.tyLen, kw: "Ref") {
                        // drop the Ref box's rc (the pointee's own heap, if any, is
                        // a rare residual leak — acceptable hidden cost for now).
                        write(s: "    plew_arc_release(((long long*)e->")
                        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
                        write(s: ") - 1);\n")
                    } else {
                        if structNeedsRelease(c: inout c, start: e.tyStart, len: e.tyLen) {
                            write(s: "    ")
                            writeSpan(c: inout c, start: e.tyStart, len: e.tyLen)
                            write(s: "_release(e->")
                            writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
                            write(s: ");\n")
                        }
                    }
                }
            }
        }
        j += 1
    }
    write(s: "}\n")
}

// Emit an env-struct typedef + its drop function for every capturing closure.
fn emitClosureEnvs(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        match c.exprs[i] {
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                if closureHasCaptures(c: inout c, id: i) {
                    emitClosureEnvStruct(c: inout c, id: i)
                    emitClosureEnvDrop(c: inout c, id: i)
                }
            }
            _ => {}
        }
        i += 1
    }
}

// Emit prototypes (proto=true) or bodies (proto=false) for every lambda-lifted
// closure literal in the program (one per Expr.Closure arena node).
fn emitClosures(c: inout Comp, proto: Bool) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        match c.exprs[i] {
            Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
                genClosure(c: inout c, id: i, proto: proto)
            }
            _ => {}
        }
        i += 1
    }
}

// Emit an enum as a tagged union: `struct E { long long tag; union { struct
// {...} V; ... } data; };`. Nullary variants get a dummy member so the inner
// struct is never empty.
fn genEnumDef(c: inout Comp, ei: U64) {
    val e: EnumDef = c.enums[ei]
    write(s: "struct ")
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
    write(s: " {\n")
    write(s: "    long long tag;\n")
    write(s: "    union {\n")
    val vars: Array[Variant] = e.variants
    mut val vi: U64 = 0
    while vi < vars.count {
        val v: Variant = vars[vi]
        write(s: "        struct {")
        val fs: Array[FieldDef] = v.fields
        if fs.count == 0 {
            write(s: " char _u; ")
        } else {
            mut val fi: U64 = 0
            while fi < fs.count {
                val f: FieldDef = fs[fi]
                write(s: " ")
                genCTypeOf(c: inout c, tyRef: f.ty, fallStart: f.tyStart, fallLen: f.tyLen, isArray: f.tyIsArray)
                write(s: " ")
                if fieldIsBoxed(c: inout c, f: f) {
                    // recursive payload field: heap pointer (spec/03) so the C
                    // union is finite. Pointee only forward-declared here.
                    write(s: "*")
                }
                writeSpan(c: inout c, start: f.nameStart, len: f.nameLen)
                write(s: ";")
                fi += 1
            }
            write(s: " ")
        }
        write(s: "} ")
        writeSpan(c: inout c, start: v.nameStart, len: v.nameLen)
        write(s: ";\n")
        vi += 1
    }
    write(s: "    } data;\n")
    write(s: "};\n")
}

