fn nameIsMain(c: inout Comp, f: Func) -> Bool {
    if f.hasRecv {
        return false
    }
    return rangeEquals(bytes: c.bytes, start: f.nameStart, len: f.nameLen, kw: "main")
}

// Whether (start,len) names a declared trait (spec/08). Distinguishes a bare
// `impl Trait { }` provided-method block (receiver = a trait) from an inherent
// `impl Type { }`.
fn isTraitName(c: inout Comp, start: U64, len: U64) -> Bool {
    val qId: U64 = intern(c: inout c, start: start, len: len)
    mut val i: U64 = 0
    while i < c.traits.count {
        val t: TraitDef = c.traits[i]
        if t.nameId == qId {
            return true
        }
        i += 1
    }
    return false
}

// Whether a function is a provided-method template: a method whose receiver is a
// trait (from a bare `impl Trait { }`). These are not emitted directly (the
// receiver is not a concrete C type); instantiateProvidedMethods copies them
// onto each conforming type instead.
fn methodRecvIsTrait(c: inout Comp, f: Func) -> Bool {
    if f.hasRecv {
        return isTraitName(c: inout c, start: f.recvStart, len: f.recvLen)
    }
    return false
}

// Instantiate each trait's provided methods onto every conforming type (spec/08:
// a conformance gains the trait's provided methods on its bare surface). For each
// Conform(Type, Trait) and each provided method of Trait (a method with receiver
// = the trait), append a copy with receiver = Type, sharing the same body — so
// codegen emits `Type_p`, whose `self.req()` resolves to Type's witness. Runs
// once after parsing, before instantiation discovery and codegen.
// Whether a method named (nameStart,nameLen) on receiver (recvStart,recvLen)
// exists in c.funcs[lo..hi). Used to detect provided-method shadowing/collision.
fn methodInRange(c: inout Comp, lo: U64, hi: U64, recvStart: U64, recvLen: U64, nameStart: U64, nameLen: U64) -> Bool {
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val qName: U64 = intern(c: inout c, start: nameStart, len: nameLen)
    mut val i: U64 = lo
    while i < hi {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.recvId == qRecv {
                if f.nameId == qName {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// The type params for a provided method copied onto a conformer named
// (recvStart,recvLen): the conformer's own type params (so the copy is emitted per
// receiver instantiation), followed by the provided method's own params. Empty for
// a non-generic conformer (returns the method's own params unchanged).
fn providedCopyTypeParams(c: inout Comp, recvStart: U64, recvLen: U64, ownParams: Array[Bind]) -> Array[Bind] {
    mut val out: Array[Bind] = []
    val qRecv: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    mut val si: U64 = 0
    while si < c.structs.count {
        if c.structs[si].typeParams.count > 0 {
            if c.structs[si].nameId == qRecv {
                mut val k: U64 = 0
                while k < c.structs[si].typeParams.count {
                    out.append(c.structs[si].typeParams[k])
                    k += 1
                }
            }
        }
        si += 1
    }
    mut val oi: U64 = 0
    while oi < ownParams.count {
        out.append(ownParams[oi])
        oi += 1
    }
    return out
}

// Whether a conformance's subject is a type *parameter* of the impl — i.e. a
// blanket impl `impl[T] T as Trait where T: Bound` — rather than a concrete
// type. Detected structurally: some method of the conformance has the subject
// name both as its receiver and as one of its own type params.
fn isBlanketConform(c: inout Comp, cf: Conform) -> Bool {
    mut val i: U64 = 0
    while i < c.funcs.count {
        val f: Func = c.funcs[i]
        if f.hasRecv {
            if f.recvId == cf.typeId {
                mut val tp: U64 = 0
                while tp < f.typeParams.count {
                    if f.typeParams[tp].nameId == cf.typeId {
                        return true
                    }
                    tp += 1
                }
            }
        }
        i += 1
    }
    return false
}

// Whether a conformance of `typeId` to `traitId` is already recorded (avoid
// registering a duplicate blanket-derived Conform).
fn conformExists(c: inout Comp, typeId: U64, traitId: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.conforms.count {
        if c.conforms[i].typeId == typeId {
            if c.conforms[i].traitId == traitId {
                return true
            }
        }
        i += 1
    }
    // a `newtype` inherits the underlying type's trait conformances automatically
    // (spec/10: methods, conformances, operators, factories). So `UserId = String`
    // satisfies `where T: Format` because String does — `print(u)` type-checks and
    // dispatches to String's witness (the newtype shares String's representation).
    mut val ni: U64 = 0
    while ni < c.newtypes.count {
        if c.newtypes[ni].nameId == typeId {
            val underId: U64 = intern(c: inout c, start: c.newtypes[ni].underStart, len: c.newtypes[ni].underLen)
            return conformExists(c: inout c, typeId: underId, traitId: traitId)
        }
        ni += 1
    }
    return false
}

// Number of distinct subject traits `B` such that an inter-trait conformance
// `impl B as A` (A = aTraitId) exists and the concrete type `tId` conforms to `B`.
// Used to detect an ambiguous inter-trait conformance (a type reaching the same
// trait through two different subject traits). Counts only original (non-derived,
// trait-subject) conforms, so it is stable as conferred conforms are appended.
fn subjectPathCount(c: inout Comp, tId: U64, aTraitId: U64) -> U64 {
    mut val count: U64 = 0
    mut val i: U64 = 0
    while i < c.conforms.count {
        val cf: Conform = c.conforms[i]
        if !(cf.derived) && cf.extId == 0U64 {
            if cf.traitId == aTraitId {
                if isTraitName(c: inout c, start: cf.typeStart, len: cf.typeLen) {
                    // cf is `impl B as A`; does tId conform to the subject trait B?
                    if conformExists(c: inout c, typeId: tId, traitId: cf.typeId) {
                        count += 1
                    }
                }
            }
        }
        i += 1
    }
    return count
}

// Inter-trait conformance (spec/08,09): `impl B as A { fn … }` makes every type
// conforming to the subject trait `B` also conform to `A`, witnessing A's
// requirements in B's vocabulary. For each such conform and each concrete type T
// that conforms to B, copy the impl's methods onto T (receiver = T) and record the
// conferred conformance — so they ride the ordinary provided-method emission path.
// Runs before instantiateProvidedMethods so A's own provided methods also reach the
// new types. The headless form `impl[T] T as A where T: B` is rejected (spec/09:
// 頭なし Self の blanket は禁止 — see Verify.checkBlanketHeadless); the legal subject
// is the trait B itself, which anchors the conformance and keeps bare-method
// surfaces enumerable.
fn instantiateTraitSubjectConforms(c: inout Comp) {
    val nConforms: U64 = c.conforms.count
    mut val ci: U64 = 0
    while ci < nConforms {
        val cf: Conform = c.conforms[ci]
        // a trait-subject conform: subject (typeStart,typeLen) names a trait B.
        // Skip extension conforms (`extension Ext { impl B as A }`, extId != 0):
        // those stay view-gated (`value#Ext`), handled by the extension machinery —
        // only an owner-module bare `impl B as A` auto-confers onto the bare surface.
        if cf.extId == 0U64 && isTraitName(c: inout c, start: cf.typeStart, len: cf.typeLen) {
            // candidate concrete types: those conforming to the subject trait B.
            mut val cj: U64 = 0
            while cj < nConforms {
                val cand: Conform = c.conforms[cj]
                if cand.traitId == cf.typeId {
                    if !(isTraitName(c: inout c, start: cand.typeStart, len: cand.typeLen)) {
                        // S reaches A through two different subject traits (P→A and
                        // Q→A, with S: P and S: Q) → ambiguous (spec/09). Until the
                        // `#`-path selector is wired, reject rather than silently pick
                        // one witness (a hidden-meaning bug).
                        if subjectPathCount(c: inout c, tId: cand.typeId, aTraitId: cf.traitId) > 1U64 {
                            compileErrorAt(line: lineOf(c: inout c, offset: cand.typeStart), msg: "ambiguous inter-trait conformance: this type conforms to the target trait through more than one subject trait (`impl B as A`). Selecting a conformance path with `#` is not yet supported (spec/09)")
                        }
                        if !(conformExists(c: inout c, typeId: cand.typeId, traitId: cf.traitId)) {
                            applyBlanketTo(c: inout c, blanket: cf, recvStart: cand.typeStart, recvLen: cand.typeLen)
                        }
                    }
                }
                cj += 1
            }
        }
        ci += 1
    }
}

// Copy every method of blanket conformance `blanket` onto the concrete type
// (recvStart,recvLen), dropping the blanket's subject type param (now bound to
// the concrete receiver), and record the derived conformance.
fn applyBlanketTo(c: inout Comp, blanket: Conform, recvStart: U64, recvLen: U64) {
    val recvId: U64 = intern(c: inout c, start: recvStart, len: recvLen)
    val nFuncs: U64 = c.funcs.count
    mut val fi: U64 = 0
    while fi < nFuncs {
        val f: Func = c.funcs[fi]
        if f.hasRecv {
            if f.recvId == blanket.typeId {
                // skip if the concrete type already has a method of this name
                // (an inherent or already-copied method wins).
                if !(methodInRange(c: inout c, lo: 0, hi: c.funcs.count, recvStart: recvStart, recvLen: recvLen, nameStart: f.nameStart, nameLen: f.nameLen)) {
                    // drop the subject param from the method's type params; the
                    // remaining (method-own) params are kept.
                    mut val copiedTP: Array[Bind] = []
                    mut val tp: U64 = 0
                    while tp < f.typeParams.count {
                        if f.typeParams[tp].nameId != blanket.typeId {
                            copiedTP.append(f.typeParams[tp])
                        }
                        tp += 1
                    }
                    c.funcs.append(<Func nameStart=f.nameStart nameLen=f.nameLen nameId=f.nameId recvId=recvId typeParams=copiedTP params=f.params hasRet=f.hasRet retStart=f.retStart retLen=f.retLen retIsArray=f.retIsArray retTy=f.retTy body=f.body hasRecv=true recvStart=recvStart recvLen=recvLen selfInout=f.selfInout selfMove=f.selfMove isAssoc=f.isAssoc isAsync=f.isAsync isExtern=f.isExtern isPub=f.isPub isProvided=true />)
                }
            }
        }
        fi += 1
    }
    if !(conformExists(c: inout c, typeId: recvId, traitId: blanket.traitId)) {
        c.conforms.append(<Conform typeStart=recvStart typeLen=recvLen typeId=recvId traitStart=blanket.traitStart traitLen=blanket.traitLen traitId=blanket.traitId traitArgs=blanket.traitArgs derived=true witnessed=blanket.witnessed />)
    }
}

fn instantiateProvidedMethods(c: inout Comp) {
    val nFuncs: U64 = c.funcs.count
    mut val ci: U64 = 0
    while ci < c.conforms.count {
        val cf: Conform = c.conforms[ci]
        mut val fi: U64 = 0
        while fi < nFuncs {
            val f: Func = c.funcs[fi]
            if f.hasRecv {
                // match the conformance to the right same-name trait by arity (spec/08:
                // trait names share a flat namespace — a user `trait Sub` vs Core's
                // operator `Sub[Rhs]`). Without the arity gate a provided method on the
                // 0-ary `Sub` would copy onto every type conforming to `Sub[Rhs]`.
                if f.recvId == cf.traitId && f.provTraitArity == cf.traitArgs.count {
                    // shadowing/collision (spec/08): an inherent method of the same
                    // name on the type wins (skip the provided copy). Two conformed
                    // traits providing the same name both copy here, each tagged with
                    // its source trait (srcTraitId) — they coexist; bare `a.foo()` is
                    // then a use-site ambiguity (findMethod), while `a#P.foo()` selects
                    // the source trait (findExtMethod). spec/08,09.
                    if !(methodInRange(c: inout c, lo: 0, hi: nFuncs, recvStart: cf.typeStart, recvLen: cf.typeLen, nameStart: f.nameStart, nameLen: f.nameLen)) {
                        // a provided method copied onto a *generic* conformer inherits
                        // the conformer's type params (prepended), so methodMatchesInst
                        // emits it per receiver instantiation (`MapIter[Counter,…]`) like
                        // an inherent method. Onto a non-generic conformer this is a
                        // no-op (the conformer has no params).
                        val copiedTP: Array[Bind] = providedCopyTypeParams(c: inout c, recvStart: cf.typeStart, recvLen: cf.typeLen, ownParams: f.typeParams)
                        // preserve extId: a trait-subject extension method (spec/09
                        // `extension Ext { impl Trait { … } }`) stays view-gated on the
                        // conformer, reached via `value#Ext.m()` not a bare call.
                        c.funcs.append(<Func nameStart=f.nameStart nameLen=f.nameLen nameId=f.nameId recvId=intern(c: inout c, start: cf.typeStart, len: cf.typeLen) typeParams=copiedTP params=f.params hasRet=f.hasRet retStart=f.retStart retLen=f.retLen retIsArray=f.retIsArray retTy=f.retTy body=f.body hasRecv=true recvStart=cf.typeStart recvLen=cf.typeLen selfInout=f.selfInout selfMove=f.selfMove isAssoc=f.isAssoc isAsync=f.isAsync isExtern=f.isExtern isPub=f.isPub isProvided=true srcTraitId=cf.traitId extId=f.extId />)
                    }
                }
            }
            fi += 1
        }
        ci += 1
    }
}

// Index of a non-generic struct named (start,len), or c.structs.count if none.
fn structIndexByName(c: inout Comp, start: U64, len: U64) -> U64 {
    // a use of an import alias (`with { Real as Alias }`) resolves to the real name.
    val ar: Bind = aliasReal(c: inout c, start: start, len: len)
    val qId: U64 = intern(c: inout c, start: ar.nameStart, len: ar.nameLen)
    mut val i: U64 = 0
    while i < c.structs.count {
        val s: StructDef = c.structs[i]
        if s.typeParams.count == 0 {
            if s.nameId == qId {
                return i
            }
        }
        i += 1
    }
    return c.structs.count
}

// ── value-semantics ARC for enums & recursive boxes (spec/03) ────────────────
// Mirrors the struct copy/share/release machinery onto enums (concrete + mono)
// and onto boxed (recursive) fields. A boxed field is a refcounted heap cell
// (plew_arc_alloc header): copy/share retain it, release drops the refcount and,
// at zero, recursively releases the pointee and frees the cell.

// ---- dependency-ordered emission of concrete nominal bodies ----
//
// A type's C body must appear after every type it holds BY VALUE (a by-value
// field needs the complete type). The old order ("all enums, then all structs in
// source order") only works when no enum holds a struct by value and structs are
// already source-ordered by dependency. emitNominalBodiesTopo lifts both: it emits
// concrete (non-generic, non-extern) struct/enum bodies in a post-order DFS over
// the by-value containment graph, so an enum may hold a struct payload by value
// (e.g. value-tree ASTs) and structs may be defined in any order.
//
// Edges exclude indirection — boxed (recursive), Array, Ref/WeakRef, RawBuffer,
// and monomorphized generic fields are all behind a pointer/emitted elsewhere, so
// they impose no completeness constraint. By-value containment is therefore a DAG
// (mutual by-value recursion is impossible — the compiler boxes one side), so the
// DFS terminates.

// Record that free function `fi` is used as a bare value (needs a thunk).
fn addFnThunk(c: inout Comp, fi: U64) {
    mut val i: U64 = 0
    while i < c.fnThunks.count {
        if c.fnThunks[i] == fi {
            return
        }
        i += 1
    }
    c.fnThunks.append(fi)
}

// Pre-pass: every bare identifier that names a (non-generic, non-method) free
// function is a function-as-value use (calls carry the name on Expr.Call, not an
// Ident), so it needs a thunk to reach the uniform closure ABI. Over-approx is
// safe: an unused thunk is harmless (and generated C is compiled with -w).
fn collectFnThunks(c: inout Comp) {
    mut val i: U64 = 0
    while i < c.exprs.count {
        match c.exprs[i] {
            Expr.Ident(val start, val len) => {
                val fvi: U64 = firstFuncByName(c: inout c, nameStart: start, nameLen: len)
                if fvi < c.funcs.count {
                    val f: Func = c.funcs[fvi]
                    if !(f.hasRecv) {
                        if !(f.isAssoc) {
                            if f.typeParams.count > 0 {
                                // a generic free fn has no bare symbol (it is emitted
                                // per instantiation) — not supported as a value yet.
                            } else {
                                addFnThunk(c: inout c, fi: fvi)
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        i += 1
    }
}

// Is (start,len) a boxed (mutable, reference) capture of closure `closureId`?
fn isBoxedCaptureOf(c: inout Comp, closureId: U64, start: U64, len: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        val e: CaptureEntry = c.captures[i]
        if e.closureId == closureId {
            if e.boxed {
                if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Is (start,len) the name of one of closure `closureId`'s captures?
fn isCaptureOf(c: inout Comp, closureId: U64, start: U64, len: U64) -> Bool {
    mut val i: U64 = 0
    while i < c.captures.count {
        val e: CaptureEntry = c.captures[i]
        if e.closureId == closureId {
            if spansEqual(c: inout c, aStart: e.nameStart, aLen: e.nameLen, bStart: start, bLen: len) {
                return true
            }
        }
        i += 1
    }
    return false
}

