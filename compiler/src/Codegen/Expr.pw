                while ai < args.count {
                    if ai > 0 {
                        write(s: ", ")
                    }
                    val aa: Arg = args[ai]
                    if aa.isInout {
                        write(s: "&(")
                        genExpr(c: inout c, id: aa.expr)
                        write(s: ")")
                    } else {
                        genExpr(c: inout c, id: aa.expr)
                    }
                    ai += 1
                }
