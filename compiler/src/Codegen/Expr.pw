                            if exprType(c: inout c, id: abase).kind == 3 {
                                write(s: "({ ")
                                genCElem(c: inout c, start: bt.nameStart, len: bt.nameLen)
                                write(s: " __ge = ")
                                genArrayGet(c: inout c, base: abase, index: aidx, elemStart: bt.nameStart, elemLen: bt.nameLen)
                                write(s: "; ")
                                if mf.hasRet {
