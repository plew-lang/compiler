// Emit a call through a first-class function value (a PlewClosure local named
// (nameStart,nameLen) of function type `tyRef`, args = [ret, param...]). The
// stored `.fn` has the uniform ABI `ret fn(void* env, params...)`, so we cast
// it to that signature and pass `.env` as the leading argument.
fn emitClosureCall(c: inout Comp, tyRef: U64, nameStart: U64, nameLen: U64, args: Array[Arg]) {
    val t: TypeRef = c.types[tyRef]
    write(s: "((")
    if t.args.count > 0 {
        emitConcreteCType(c: inout c, ref: t.args[0])
    } else {
        write(s: "void")
    }
    write(s: " (*)(void*")
    mut val pi: U64 = 1
    while pi < t.args.count {
        write(s: ", ")
        emitConcreteCType(c: inout c, ref: t.args[pi])
        pi += 1
    }
    write(s: "))(")
    writeSpan(c: inout c, start: nameStart, len: nameLen)
    write(s: ").fn)((")
    writeSpan(c: inout c, start: nameStart, len: nameLen)
    write(s: ").env")
    mut val i: U64 = 0
    while i < args.count {
        write(s: ", ")
        val ar: Arg = args[i]
        if ar.isInout {
            write(s: "&(")
            genExpr(c: inout c, id: ar.expr)
            write(s: ")")
        } else {
            genExpr(c: inout c, id: ar.expr)
        }
        i += 1
    }
    write(s: ")")
}

// Emit the initializer for one capture field `__e->name = <here>`. Heap-owning
// captures are retained (share) so the env keeps the value alive after the
// enclosing scope releases its binding; immutable so a shared alias is correct.
// Strings carry no rc (static/leaked bytes) and scalars are plain — both copy.
fn emitCaptureInit(c: inout Comp, e: CaptureEntry) {
    // a boxed (mutable) capture: the enclosing local is already a pointer to the
    // shared cell; retain it (rc++) and store the pointer so writes are shared.
    if e.boxed {
        write(s: "plew_ref_share(")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: ")")
        return
    }
    if e.isArray {
        write(s: "PlewArray_")
        writeSpan(c: inout c, start: e.tyStart, len: e.tyLen)
        write(s: "_share(")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: ")")
        return
    }
    if rangeEquals(bytes: c.bytes, start: e.tyStart, len: e.tyLen, kw: "Ref") {
        write(s: "plew_ref_share(")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: ")")
        return
    }
    if rangeEquals(bytes: c.bytes, start: e.tyStart, len: e.tyLen, kw: "String") {
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        return
    }
    if isPrimType(c: inout c, start: e.tyStart, len: e.tyLen) {
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        return
    }
    // a plain struct: retain its heap-owning fields if it has any, else bit-copy.
    if structNeedsRelease(c: inout c, start: e.tyStart, len: e.tyLen) {
        writeSpan(c: inout c, start: e.tyStart, len: e.tyLen)
        write(s: "_share(")
        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
        write(s: ")")
        return
    }
    writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
}

// Does a JSX construction's field list provide a value for `name`? (Used to
// decide whether to fill in a declared field default — spec/05.)
fn makeProvides(c: inout Comp, fields: Array[MakeField], nameStart: U64, nameLen: U64) -> Bool {
    mut val i: U64 = 0
    while i < fields.count {
        val mf: MakeField = fields[i]
        if spansEqual(c: inout c, aStart: mf.nameStart, aLen: mf.nameLen, bStart: nameStart, bLen: nameLen) {
            return true
        }
        i += 1
    }
    return false
}

// Value-position struct destructuring match `return match s { S { val x } => x }`:
// a C statement-expression that binds the fields then yields the arm expression.
fn emitStructMatchExpr(c: inout Comp, scrut: U64, arm: MatchArm) {
    val t: U64 = c.tmp
    c.tmp = c.tmp + 1
    val st: TypeInfo = exprType(c: inout c, id: scrut)
    val generic: Bool = isGenericInst(c: inout c, ref: st.ref)
    val mark: U64 = scopeMark(c: inout c)
    write(s: "({ ")
    genCTypeOf(c: inout c, tyRef: st.ref, fallStart: st.nameStart, fallLen: st.nameLen, isArray: false)
    write(s: " _m")
    writeU64(n: t)
    write(s: " = ")
    genExpr(c: inout c, id: scrut)
    write(s: "; ")
    val binds: Array[Bind] = arm.binds
    mut val bi: U64 = 0
    while bi < binds.count {
        val bd: Bind = binds[bi]
        mut val ft: TypeInfo = scalarInfo()
        if generic {
            ft = genericFieldTypeInfo(c: inout c, instRef: st.ref, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
        } else {
            ft = fieldType(c: inout c, structStart: st.nameStart, structLen: st.nameLen, fieldStart: bd.fieldStart, fieldLen: bd.fieldLen)
        }
        genCTypeOf(c: inout c, tyRef: ft.ref, fallStart: ft.nameStart, fallLen: ft.nameLen, isArray: ft.kind == 3)
        write(s: " ")
        writeSpan(c: inout c, start: bd.nameStart, len: bd.nameLen)
        write(s: " = _m")
        writeU64(n: t)
        write(s: ".")
        writeSpan(c: inout c, start: bd.fieldStart, len: bd.fieldLen)
        write(s: "; ")
        addLocal(c: inout c, nameStart: bd.nameStart, nameLen: bd.nameLen, tyStart: ft.nameStart, tyLen: ft.nameLen, isArray: ft.kind == 3, ty: ft.ref, isInout: false, isMut: false, owned: false)
        bi += 1
    }
    genExpr(c: inout c, id: arm.body)
    write(s: "; })")
    popLocals(c: inout c, mark: mark)
}

fn genExpr(c: inout Comp, id: U64) {
    val e: Expr = c.exprs[id]
    match e {
        Expr.Int(val value, offset: _, isBool: _, tyStart: _, tyLen: _) => { writeInt(n: value) }
        Expr.Ident(val start, val len) => {
            // inside a closure body, a captured enclosing variable reads from the
            // env: `((__closure_env<id>*)__env)->name`.
            if c.curInClosure {
                if isCaptureOf(c: inout c, closureId: c.curClosureId, start: start, len: len) {
                    // a boxed (mutable) capture is a pointer to the shared cell:
                    // dereference it so reads/writes hit the shared storage.
                    val boxedCap: Bool = isBoxedCaptureOf(c: inout c, closureId: c.curClosureId, start: start, len: len)
                    if boxedCap {
                        write(s: "(*((__closure_env")
                    } else {
                        write(s: "((__closure_env")
                    }
                    writeU64(n: c.curClosureId)
                    write(s: "*)__env)->")
                    writeSpan(c: inout c, start: start, len: len)
                    if boxedCap {
                        write(s: ")")
                    }
                    return
                }
            }
            if localMoved(c: inout c, start: start, len: len) {
                compileErrorAt(line: lineOf(c: inout c, offset: start), msg: "use of moved value (it was consumed by an earlier `move`)")
            }
            if isInoutLocal(c: inout c, start: start, len: len) {
                write(s: "(*")
                writeSpan(c: inout c, start: start, len: len)
                write(s: ")")
            } else {
                // a bare free-function name used as a value (function pointer) must
                // emit the function's selector-mangled C symbol, not the raw name.
                // Locals shadow functions, so only do this when it isn't a local.
                val lvi: U64 = localIndexByName(c: inout c, start: start, len: len)
                if lvi < c.locals.count {
                    // a boxed (captured `mut val`) local lives in a shared ARC cell:
                    // the C variable is the pointer, so dereference to read/write it.
                    if isBoxedLocalAt(c: inout c, nameStart: c.locals[lvi].nameStart) {
                        write(s: "(*")
                        writeLocalCName(c: inout c, lo: c.locals[lvi])
                        write(s: ")")
                    } else {
                        writeLocalCName(c: inout c, lo: c.locals[lvi])
                    }
                } else {
                    val fvi: U64 = firstFuncByName(c: inout c, nameStart: start, nameLen: len)
                    if fvi < c.funcs.count {
                        // a bare function reference becomes a fat closure whose fn
                        // is the function's thunk (adapts the plain C signature to
                        // the uniform `(void* env, ...)` ABI). env/rc/drop are 0.
                        write(s: "(PlewClosure){(void*)&")
                        writeFnSelector(c: inout c, f: c.funcs[fvi])
                        write(s: "__thunk, 0, 0, 0}")
                    } else {
                        if isSelfRef(c: inout c, start: start, len: len) {
                            // `self` is the method's first C parameter (emitted raw).
                            writeSpan(c: inout c, start: start, len: len)
                        } else {
                            // resolves to no local, parameter, function, or `self`:
                            // reject rather than echo the raw name into invalid C
                            // (e.g. a field used without `self.`, or a typo).
                            compileErrorAt(line: lineOf(c: inout c, offset: start), msg: "unknown identifier")
                        }
                    }
                }
            }
        }
        Expr.Move(val operand, val isBorrow) => {
            // `move`/`borrow` lower to the operand's value (a unique struct is a
            // bit-copy). `move` then marks the source place moved-out so it is
            // neither used again nor double-released; `borrow` leaves it live.
            if isBorrow {
                genExpr(c: inout c, id: operand)
            } else {
                // partial moves (out of a field/element) aren't tracked yet, so
                // the source would not be marked moved -> double-release. Restrict
                // `move` to a bare local until field/element moves are supported.
                match c.exprs[operand] {
                    Expr.Ident(val start, val len) => {
                        // moving `self` onward (out of a `move fn`) isn't tracked yet
                        // (self isn't a tracked local), so it would double-deinit.
                        if isSelfRef(c: inout c, start: start, len: len) {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "moving `self` is not yet supported")
                        }
                        // conditional move guard: a local declared outside the
                        // enclosing branch (index < curBranchBase) would be moved
                        // only on this path, but the moved flag persists across all
                        // paths -> its deinit silently skipped on the others.
                        // Reject until flow analysis tracks per-path move state.
                        if localIndexByName(c: inout c, start: start, len: len) < c.curBranchBase {
                            compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "cannot `move` a variable declared outside the enclosing conditional/loop (the move would be conditional); move it unconditionally")
                        }
                    }
                    _ => {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: operand)), msg: "`move` is only supported from a local variable (field/element moves are not yet supported)")
                    }
                }
                genExpr(c: inout c, id: operand)
                markMovedExpr(c: inout c, exprId: operand)
            }
        }
        Expr.Unary(val op, val operand) => {
            mut val negChecked: Bool = false
            if op == 57 {
                val ot: TypeInfo = exprType(c: inout c, id: operand)
                if ot.kind == 0 {
                    if isIntType(c: inout c, start: ot.nameStart, len: ot.nameLen) {
                        if intSigned(c: inout c, start: ot.nameStart, len: ot.nameLen) {
                            genCheckedNeg(c: inout c, operand: operand, tyStart: ot.nameStart, tyLen: ot.nameLen)
                            negChecked = true
                        }
                    }
                }
            }
            if negChecked {
            } else {
                write(s: unaryOpStr(op: op))
                write(s: "(")
                genExpr(c: inout c, id: operand)
                write(s: ")")
            }
        }
        Expr.Binary(val op, val lhs, val rhs) => {
            if isStringEq(c: inout c, op: op, lhs: lhs) {
                if op == 51 {
                    write(s: "(!PlewString_eq(")
                } else {
                    write(s: "PlewString_eq(")
                }
                genExpr(c: inout c, id: lhs)
                write(s: ", ")
                genExpr(c: inout c, id: rhs)
                if op == 51 {
                    write(s: "))")
                } else {
                    write(s: ")")
                }
            } else {
                if hasCompareWitness(c: inout c, op: op, lhs: lhs) {
                    emitTraitCompare(c: inout c, op: op, lhs: lhs, rhs: rhs)
                } else {
                    if isEnumEq(c: inout c, op: op, lhs: lhs) {
                        emitEnumTagCmp(c: inout c, lhs: lhs, rhs: rhs, op: op, outer: true)
                    } else {
                    if compareNeedsTrait(c: inout c, op: op, lhs: lhs) {
                        compileErrorAt(line: lineOf(c: inout c, offset: exprOffset(c: inout c, id: lhs)), msg: "comparison needs Eq/Ord; not available for a struct or array")
                    } else {
                        if op == 59 {
                            // `/`: zero divisor always panics; signed INT_MIN/-1
                            // overflows. Width-aware when the type is known; else
                            // the generic (zero-checked) plew_div.
                            val dt: TypeInfo = arithIntType(c: inout c, lhs: lhs, rhs: rhs)
                            if dt.nameLen > 0 {
                                genCheckedDiv(c: inout c, lhs: lhs, rhs: rhs, tyStart: dt.nameStart, tyLen: dt.nameLen, isMod: false)
                            } else {
                                write(s: "plew_div(")
                                genExpr(c: inout c, id: lhs)
                                write(s: ", ")
                                genExpr(c: inout c, id: rhs)
                                write(s: ")")
                            }
                        } else {
                            if op == 60 {
                                // `%`: same — divisor must be nonzero.
                                val mt: TypeInfo = arithIntType(c: inout c, lhs: lhs, rhs: rhs)
                                if mt.nameLen > 0 {
                                    genCheckedDiv(c: inout c, lhs: lhs, rhs: rhs, tyStart: mt.nameStart, tyLen: mt.nameLen, isMod: true)
                                } else {
                                    write(s: "plew_mod(")
                                    genExpr(c: inout c, id: lhs)
                                    write(s: ", ")
                                    genExpr(c: inout c, id: rhs)
                                    write(s: ")")
                                }
                            } else {
                                val at: TypeInfo = arithIntType(c: inout c, lhs: lhs, rhs: rhs)
                                if isCheckedArith(op: op) {
                                    if at.nameLen > 0 {
                                        genCheckedArith(c: inout c, op: op, lhs: lhs, rhs: rhs, tyStart: at.nameStart, tyLen: at.nameLen)
                                    } else {
                                        write(s: "(")
                                        genExpr(c: inout c, id: lhs)
                                        write(s: binOpStr(op: op))
                                        genExpr(c: inout c, id: rhs)
                                        write(s: ")")
                                    }
                                } else {
                                    write(s: "(")
                                    genExpr(c: inout c, id: lhs)
                                    write(s: binOpStr(op: op))
                                    genExpr(c: inout c, id: rhs)
                                    write(s: ")")
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
        Expr.Call(val nameStart, val nameLen, val args) => {
            // compileError / compileErrorAt are ordinary module functions (defined
            // above via eprint/exit), so they are NOT special-cased here — calls
            // lower like any other user-function call. (Kept spec-valid: no ambient
            // diagnostic builtin.)
            // I/O builtins -> C runtime.
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "write") {
                if c.impWrite {
                    write(s: "plew_write(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "write is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "writeByte") {
                if c.impWriteByte {
                    write(s: "putchar((int)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "writeByte is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "eprint") {
                if c.impEprint {
                    write(s: "plew_eprint(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "eprint is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "exit") {
                if c.impExit {
                    write(s: "exit((int)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "exit is not ambient; import it from @Std/Process")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readStdin") {
                if c.impReadStdin {
                    write(s: "plew_read_stdin()")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readStdin is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFile") {
                if c.impReadFile {
                    write(s: "plew_read_file(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readFile is not ambient; import it from @Std/Io")
                }
                return
            }
            // readFileBytes(path: Array[U8]) -> String. Bundled under the same
            // `readFile` import (an internal helper for multi-file `part`).
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "readFileBytes") {
                if c.impReadFile {
                    write(s: "plew_read_file_bytes(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "readFile is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "fileExists") {
                if c.impFileExists {
                    write(s: "plew_file_exists(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: ")")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "fileExists is not ambient; import it from @Std/Io")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argCount") {
                if c.impArgCount {
                    write(s: "plew_arg_count()")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argCount is not ambient; import it from @Std/Process")
                }
                return
            }
            if rangeEquals(bytes: c.bytes, start: nameStart, len: nameLen, kw: "argAt") {
                if c.impArgAt {
                    write(s: "plew_arg_at((long long)(")
                    genExpr(c: inout c, id: args[0].expr)
                    write(s: "))")
                } else {
                    compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argAt is not ambient; import it from @Std/Process")
                }
                return
            }
            if callLabelsOk(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args) {
            } else {
                // label missing / wrong / out of order -> undeclared identifier
                // so the C compile fails loudly (spec: labels are required).
                compileErrorAt(line: lineOf(c: inout c, offset: nameStart), msg: "argument labels do not match the function parameters")
                return
            }
            // a local/param of function type shadows any function of the same
            // name (spec: locals shadow): it is a first-class function value, so
            // dispatch through its fat closure (cast `.fn`, pass `.env` first).
            val lvi: U64 = localIndexByName(c: inout c, start: nameStart, len: nameLen)
            if lvi < c.locals.count {
                if isFnType(c: inout c, ref: c.locals[lvi].ty) {
                    emitClosureCall(c: inout c, tyRef: c.locals[lvi].ty, nameStart: nameStart, nameLen: nameLen, args: args)
                    return
                }
            }
            // resolve the (possibly overloaded) callee, then emit its selector-
            // mangled C name so the call reaches the right overload's symbol.
            val cfi: U64 = findFunc(c: inout c, nameStart: nameStart, nameLen: nameLen, args: args)
            if cfi == c.funcs.count {
                writeSpan(c: inout c, start: nameStart, len: nameLen)
            } else {
                // a generic free function call mangles with its inferred concrete
                // type args (`f_x_Counter`) under a temporary env, matching the
                // instance's definition. A non-registered instantiation (the
                // deferred transitive case) falls back to the literal selector.
                if isGenericFreeFn(c: inout c, fi: cfi) {
                    val inferred: Array[U64] = inferFnArgs(c: inout c, f: c.funcs[cfi], args: args)
                    if fnInstExists(c: inout c, fnIdx: cfi, args: inferred) {
                        val savedP: Array[Bind] = c.curTypeParams
                        val savedA: Array[U64] = c.curTypeArgs
                        c.curTypeParams = c.funcs[cfi].typeParams
                        c.curTypeArgs = inferred
                        writeFnSelector(c: inout c, f: c.funcs[cfi])
                        c.curTypeParams = savedP
                        c.curTypeArgs = savedA
                    } else {
                        writeFnSelector(c: inout c, f: c.funcs[cfi])
                    }
                } else {
                    writeFnSelector(c: inout c, f: c.funcs[cfi])
                }
            }
            write(s: "(")
            mut val i: U64 = 0
            while i < args.count {
                if i > 0 {
                    write(s: ", ")
                }
                val ar: Arg = args[i]
                if ar.isInout {
                    write(s: "&(")
                    genExpr(c: inout c, id: ar.expr)
                    write(s: ")")
                } else {
                    // an array-typed parameter receiving an array literal needs the
                    // typed array constructor; a bare genExpr would emit 0 (an
                    // untyped `[...]` has no element-type context here).
                    mut val argIsArr: Bool = false
                    if cfi < c.funcs.count {
                        val cf0: Func = c.funcs[cfi]
                        if i < cf0.params.count {
                            if cf0.params[i].tyIsArray {
                                argIsArr = true
                            }
                        }
                    }
                    if argIsArr {
                        val cf1: Func = c.funcs[cfi]
                        genArrayValue(c: inout c, exprId: ar.expr, elemStart: cf1.params[i].tyStart, elemLen: cf1.params[i].tyLen)
                    } else {
                        genExpr(c: inout c, id: ar.expr)
                    }
                }
                i += 1
            }
            // fill omitted trailing params with their default expressions.
            if cfi == c.funcs.count {
            } else {
                val cf: Func = c.funcs[cfi]
                val cps: Array[Param] = cf.params
                mut val di: U64 = args.count
                while di < cps.count {
                    if di > 0 {
                        write(s: ", ")
                    }
                    // an array-typed default (`xs: Array[T] = []`) needs the typed
                    // array constructor, not a bare genExpr (which would emit 0).
                    if cps[di].tyIsArray {
                        genArrayValue(c: inout c, exprId: cps[di].defaultExpr, elemStart: cps[di].tyStart, elemLen: cps[di].tyLen)
                    } else {
                        genExpr(c: inout c, id: cps[di].defaultExpr)
                    }
                    di += 1
                }
            }
            write(s: ")")
        }
        Expr.Field(val base, val nameStart, val nameLen) => {
            // `Color.Green` (an enum type name `.` a variant) is not a value:
            // enum values are constructed with JSX. Reject it rather than emit
            // the invalid `Color.Green` (acceptance soundness — no silent C error).
            match c.exprs[base] {
                Expr.Ident(start: val bs, len: val bl) => {
                    if localIndexByName(c: inout c, start: bs, len: bl) < c.locals.count {
                    } else {
                        if isEnumName(c: inout c, start: bs, len: bl) {
                            compileErrorAt(line: lineOf(c: inout c, offset: bs), msg: "an enum variant is not a value; construct it with JSX, e.g. `<Color.Green />`")
                        }
                    }
                }
                _ => {}
            }
            val bt: TypeInfo = exprType(c: inout c, id: base)
            if bt.kind == 1 {
                // String.bytes: a borrowed Array[U8] view of the string buffer
                // (rc=0 so ARC never frees it — strings are static/leaked).
                write(s: "({ PlewString __s = ")
                genExpr(c: inout c, id: base)
                write(s: "; (PlewArray_U8){(unsigned char*)__s.data, __s.len, __s.len, 0}; })")
                return
            }
            if bt.kind == 3 {
                // arr.count -> length
                write(s: "(long long)((")
                genExpr(c: inout c, id: base)
                write(s: ").len)")
                return
            }
            genExpr(c: inout c, id: base)
            write(s: ".")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
        }
        Expr.Str(val start, val len) => {
            write(s: "(PlewString){\"")
            writeSpan(c: inout c, start: start + 1, len: len - 2)
            write(s: "\", ")
            writeInt(n: strDecodedLen(c: inout c, start: start, len: len))
            write(s: "}")
        }
        Expr.Index(val base, val index) => {
            val bt: TypeInfo = exprType(c: inout c, id: base)
            write(s: "PlewArray_")
            writeSpan(c: inout c, start: bt.nameStart, len: bt.nameLen)
            write(s: "_get(")
            genExpr(c: inout c, id: base)
            write(s: ", (long long)(")
            genExpr(c: inout c, id: index)
            write(s: "))")
        }
        Expr.Arrow(val base, val nameStart, val nameLen) => {
            // Ref pointee field access: `(base)->field` (Ref[T] is a C T*).
            write(s: "(")
            genExpr(c: inout c, id: base)
            write(s: ")->")
            writeSpan(c: inout c, start: nameStart, len: nameLen)
        }
        Expr.Closure(val params, val hasRet, val retStart, val retLen, val retIsArray, val retTy, val body) => {
            // value = a fat closure. A non-capturing closure has a NULL env; a
            // capturing one allocates an env block (rc-headed) and copies each
            // captured scalar into it. drop=0: scalar envs own no heap, so they
            // need no field release (the env block itself is reclaimed at the
            // last reference / leaked — a hidden cost, never a meaning change).
            if closureHasCaptures(c: inout c, id: id) {
                write(s: "({ __closure_env")
                writeU64(n: id)
                write(s: "* __e = (__closure_env")
                writeU64(n: id)
                write(s: "*)plew_arc_alloc(sizeof(__closure_env")
                writeU64(n: id)
                write(s: ")); ")
