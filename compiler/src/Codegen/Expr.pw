                    write(s: "&(")
                    genExpr(c: inout c, id: recv)
                    write(s: ")")
                } else {
                    genExpr(c: inout c, id: recv)
                }
                mut val i: U64 = 0
                while i < args.count {
                    write(s: ", ")
                    val ar: Arg = args[i]
                    if ar.isInout {
                        write(s: "&(")
                        genExpr(c: inout c, id: ar.expr)
                        write(s: ")")
                    } else {
                        genExpr(c: inout c, id: ar.expr)
