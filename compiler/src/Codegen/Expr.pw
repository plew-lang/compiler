                        writeSpan(c: inout c, start: e.nameStart, len: e.nameLen)
                        write(s: " = ")
                        emitCaptureInit(c: inout c, e: e)
                        write(s: "; ")
                    }
                    ci += 1
                }
                write(s: "(PlewClosure){(void*)&__closure")
                writeU64(n: id)
                write(s: ", (void*)__e, ((long long*)__e) - 1, &__closure_env")
                writeU64(n: id)
                write(s: "_release}; })")
            } else {
                write(s: "(PlewClosure){(void*)&__closure")
                writeU64(n: id)
                write(s: ", 0, 0, 0}")
