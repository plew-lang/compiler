                            val fd: FieldDef = flds[fi]
                            if fd.hasDefault {
                                if makeProvides(c: inout c, fields: fields, nameStart: fd.nameStart, nameLen: fd.nameLen) {
                                } else {
                                    if dEmitted > 0 {
                                        write(s: ", ")
                                    }
                                    write(s: ".")
                                    writeSpan(c: inout c, start: fd.nameStart, len: fd.nameLen)
                                    write(s: " = ")
                                    if fd.tyIsArray {
