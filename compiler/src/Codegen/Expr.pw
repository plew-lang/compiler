                while adi < af.params.count {
                    if adi > 0 {
                        write(s: ", ")
                    }
                    if af.params[adi].tyIsArray {
                        genArrayValue(c: inout c, exprId: af.params[adi].defaultExpr, elemStart: af.params[adi].tyStart, elemLen: af.params[adi].tyLen)
