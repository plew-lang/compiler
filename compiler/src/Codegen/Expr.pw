                // default value that this construction omitted. The default
                // expression is re-evaluated here (each construction site). Works
                // for generic structs too — defaults are self-contained values
                // (they cannot reference other fields or `self`), so a concretely
                // typed default field needs no type substitution.
                mut val dEmitted: U64 = fields.count
                mut val si: U64 = 0
                while si < c.structs.count {
                    val sd: StructDef = c.structs[si]
                    if spansEqual(c: inout c, aStart: sd.nameStart, aLen: sd.nameLen, bStart: typeStart, bLen: typeLen) {
                        val flds: Array[FieldDef] = sd.fields
