// @Manifest — package-manifest (`Plew.toml`) parsing and `@dep` import resolution.
//
// A DAG-bottom leaf (`Ir ← Manifest`): it operates only on byte buffers (the
// manifest's bytes, file paths) plus file existence, so the front-end loader can
// import it alongside @Path. Dependency RESOLUTION lives here: parse the consuming
// package's `[dependencies]`, then turn a non-`@Std` `@<name>` import into the file
// that backs that dependency's lib face (`<dep>/src/_.pw`).
//
// Package model (spec/17): packages are FLAT — `@Acme/Http` names ONE package whose
// name is the literal string `Acme/Http` (the `/` is a name character, not submodule
// navigation), and its public surface is the exports of its `_.pw`. Only `@Std/...`
// is special (resolved against the bundled std dir by @Path) — every other `@name`
// is looked up whole in the dependency table.

import @Std/Io with { fileExists, readFileBytes }
import ./Ir with { appendBytes }

// One declared dependency from `[dependencies]`. `key` is the binding name the
// consumer writes after `@` (it may contain `/`). `kind`: 0 = path, 1 = git.
// `loc` is the path (relative to the package dir) for a path dep, or the git URL
// for a git dep. `version` is the digit-model constraint string ("" if absent).
export struct Dep {
    pub val key: Array[U8]
    pub val kind: U8
    pub val loc: Array[U8]
    pub val version: Array[U8]
}

// A parsed manifest: the package's own `name` and its declared dependencies.
export struct Manifest {
    pub val name: Array[U8]
    pub val deps: Array[Dep]
}

// A small (value, next-index) cursor result for the byte scanners below.
struct Scan {
    pub val text: Array[U8]
    pub val next: U64
}

// The fields an inline-table dependency entry can carry (key is supplied by the
// caller). `kind`: 0 = path, 1 = git.
struct TableVals {
    pub val kind: U8
    pub val loc: Array[U8]
    pub val version: Array[U8]
}

// Whether `a` equals the byte span `src[start .. start+len]`.
export fn spanEqArr(a: Array[U8], src: Array[U8], start: U64, len: U64) -> Bool {
    if a.count != len {
        return false
    }
    mut val i: U64 = 0
    while i < len {
        if a[i] != src[start + i] {
            return false
        }
        i += 1
    }
    return true
}

// Advance over spaces/tabs within [p, to).
fn skipWs(bytes: Array[U8], p: U64, to: U64) -> U64 {
    mut val i: U64 = p
    mut val go: Bool = true
    while go {
        if i < to {
            val c: U8 = bytes[i]
            if c == 32 {
                i += 1
            } else {
                if c == 9 {
                    i += 1
                } else {
                    go = false
                }
            }
        } else {
            go = false
        }
    }
    return i
}

// Read a double-quoted string starting at `p` (bytes[p] == '"'); returns the
// unescaped-as-is contents (no escapes in our manifest subset) and the index just
// past the closing quote. If unterminated, `next` = `to`.
fn readQuoted(bytes: Array[U8], p: U64, to: U64) -> Scan {
    mut val out: Array[U8] = []
    mut val i: U64 = p + 1
    mut val go: Bool = true
    while go {
        if i < to {
            if bytes[i] == 34 {
                go = false
                i += 1
            } else {
                out.append(bytes[i])
                i += 1
            }
        } else {
            go = false
        }
    }
    return <Scan text=out next=i />
}

// Read a bare key/identifier starting at `p`, stopping at whitespace or any of
// `= , } ] \r \n`. Returns the key bytes and the stop index.
fn readBareKey(bytes: Array[U8], p: U64, to: U64) -> Scan {
    mut val out: Array[U8] = []
    mut val i: U64 = p
    mut val go: Bool = true
    while go {
        if i < to {
            val c: U8 = bytes[i]
            if c == 32 {
                go = false
            } else {
                if c == 9 {
                    go = false
                } else {
                    if c == 61 {
                        go = false
                    } else {
                        if c == 44 {
                            go = false
                        } else {
                            if c == 125 {
                                go = false
                            } else {
                                if c == 93 {
                                    go = false
                                } else {
                                    if c == 13 {
                                        go = false
                                    } else {
                                        out.append(c)
                                        i += 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            go = false
        }
    }
    return <Scan text=out next=i />
}

// Read a key at `p` — quoted (`"a/b"`) or bare (`name`) — returning its text.
fn readKey(bytes: Array[U8], p: U64, to: U64) -> Scan {
    if p < to {
        if bytes[p] == 34 {
            return readQuoted(bytes: bytes, p: p, to: to)
        }
    }
    return readBareKey(bytes: bytes, p: p, to: to)
}

// Parse one inline table `{ key = "v", ... }` occupying [p, to) (p just past `{`)
// into the dependency fields. All values are quoted strings in this subset.
fn parseInlineTable(bytes: Array[U8], p: U64, to: U64) -> TableVals {
    mut val kind: U8 = 0
    mut val loc: Array[U8] = []
    mut val version: Array[U8] = []
    mut val i: U64 = p
    mut val go: Bool = true
    while go {
        i = skipWs(bytes: bytes, p: i, to: to)
        // skip separators / closing brace
        if i < to {
            val c: U8 = bytes[i]
            if c == 44 {
                i += 1
            } else {
                if c == 125 {
                    go = false
                } else {
                    val k: Scan = readKey(bytes: bytes, p: i, to: to)
                    i = skipWs(bytes: bytes, p: k.next, to: to)
                    // expect '='
                    if i < to {
                        if bytes[i] == 61 {
                            i += 1
                        }
                    }
                    i = skipWs(bytes: bytes, p: i, to: to)
                    mut val v: Array[U8] = []
                    if i < to {
                        if bytes[i] == 34 {
                            val s: Scan = readQuoted(bytes: bytes, p: i, to: to)
                            v = s.text
                            i = s.next
                        }
                    }
                    if spanEqArr(a: "path".bytes, src: k.text, start: 0, len: k.text.count) {
                        kind = 0
                        loc = v
                    } else {
                        if spanEqArr(a: "git".bytes, src: k.text, start: 0, len: k.text.count) {
                            kind = 1
                            loc = v
                        } else {
                            if spanEqArr(a: "version".bytes, src: k.text, start: 0, len: k.text.count) {
                                version = v
                            }
                        }
                    }
                }
            }
        } else {
            go = false
        }
    }
    return <TableVals kind=kind loc=loc version=version />
}

// Parse a `Plew.toml` byte buffer into a Manifest (name + dependency list). A
// line-oriented subset: blank/`#` lines are skipped, `[section]` headers switch
// context (only `[dependencies]` is read), top-level `name = "..."` sets the name,
// and each `Key = { ... }` under `[dependencies]` becomes a Dep.
export fn parseManifest(bytes: Array[U8]) -> Manifest {
    mut val name: Array[U8] = []
    mut val deps: Array[Dep] = []
    mut val inDeps: Bool = false
    val n: U64 = bytes.count
    mut val i: U64 = 0
    while i < n {
        // find the end of this line
        mut val e: U64 = i
        mut val sg: Bool = true
        while sg {
            if e < n {
                if bytes[e] == 10 {
                    sg = false
                } else {
                    e += 1
                }
            } else {
                sg = false
            }
        }
        // process the line bytes[p .. e]
        mut val p: U64 = skipWs(bytes: bytes, p: i, to: e)
        if p < e {
            val c0: U8 = bytes[p]
            if c0 == 35 {
                // comment — skip
            } else {
                if c0 == 13 {
                    // bare CR — skip
                } else {
                    if c0 == 91 {
                        // section header `[name]`
                        val sk: Scan = readBareKey(bytes: bytes, p: p + 1, to: e)
                        inDeps = spanEqArr(a: "dependencies".bytes, src: sk.text, start: 0, len: sk.text.count)
                    } else {
                        // key = value
                        val k: Scan = readKey(bytes: bytes, p: p, to: e)
                        mut val q: U64 = skipWs(bytes: bytes, p: k.next, to: e)
                        if q < e {
                            if bytes[q] == 61 {
                                q += 1
                            }
                        }
                        q = skipWs(bytes: bytes, p: q, to: e)
                        if q < e {
                            if bytes[q] == 34 {
                                // quoted string value
                                val s: Scan = readQuoted(bytes: bytes, p: q, to: e)
                                if !inDeps {
                                    if spanEqArr(a: "name".bytes, src: k.text, start: 0, len: k.text.count) {
                                        name = s.text
                                    }
                                }
                            } else {
                                if bytes[q] == 123 {
                                    // inline table = a dependency entry
                                    if inDeps {
                                        val tv: TableVals = parseInlineTable(bytes: bytes, p: q + 1, to: e)
                                        deps.append(<Dep key=k.text kind=tv.kind loc=tv.loc version=tv.version />)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = e + 1
    }
    return <Manifest name=name deps=deps />
}

// Read and parse `<pkgDir>Plew.toml` into its dependency list (empty when pkgDir
// is empty or carries no manifest). The loader calls this PER package so each
// file resolves its `@dep` imports against its own manifest.
export fn loadManifestDeps(pkgDir: Array[U8]) -> Array[Dep] {
    mut val deps: Array[Dep] = []
    if pkgDir.count == 0 {
        return deps
    }
    mut val maniPath: Array[U8] = []
    appendBytes(into: inout maniPath, from: pkgDir)
    appendBytes(into: inout maniPath, from: "Plew.toml".bytes)
    if !(fileExists(path: maniPath)) {
        return deps
    }
    val src: String = readFileBytes(path: maniPath)
    val mani: Manifest = parseManifest(bytes: src.bytes)
    return mani.deps
}

// Whether the import path bytes src[pStart .. pStart+pLen] are an external
// package import (`@<name>`) other than `@Std/…` — i.e. one that must be backed
// by a declared dependency. Used to enforce the phantom-dependency rule (spec/17).
export fn isExternalDepImport(src: Array[U8], pStart: U64, pLen: U64) -> Bool {
    if pLen < 2 {
        return false
    }
    if src[pStart] != 64 {
        return false
    }
    // `@Std/…` (or bare `@Std`) is the bundled std, not an external dependency.
    if pLen >= 4 {
        if src[pStart + 1] == 83 {
            if src[pStart + 2] == 116 {
                if src[pStart + 3] == 100 {
                    // followed by end or '/'
                    if pLen == 4 {
                        return false
                    }
                    if src[pStart + 4] == 47 {
                        return false
                    }
                }
            }
        }
    }
    return true
}

// Resolve a non-`@Std` `@<name>` import (path bytes src[pStart .. pStart+pLen],
// leading '@') against the declared dependencies. A PATH dep resolves to
// `<pkgDir><loc>/src/_.pw` (the dep's lib face). Other kinds (git, not fetched
// yet) and undeclared names return empty so the loader leaves them unresolved.
export fn resolveDepImport(src: Array[U8], pStart: U64, pLen: U64, deps: Array[Dep], pkgDir: Array[U8]) -> Array[U8] {
    mut val out: Array[U8] = []
    if pLen < 2 {
        return out
    }
    if src[pStart] != 64 {
        return out
    }
    val nameStart: U64 = pStart + 1
    val nameLen: U64 = pLen - 1
    mut val i: U64 = 0
    while i < deps.count {
        val d: Dep = deps[i]
        if spanEqArr(a: d.key, src: src, start: nameStart, len: nameLen) {
            if d.kind == 0 {
                appendBytes(into: inout out, from: pkgDir)
                appendBytes(into: inout out, from: d.loc)
                appendBytes(into: inout out, from: "/src/_.pw".bytes)
                return out
            }
            return out
        }
        i += 1
    }
    return out
}
