// @Backend — the LLVM emitter of the self-hosted Plew compiler. It consumes the
// front-end's analyzed `Comp` (built by `./Frontend`'s `runFrontend`) and emits
// textual LLVM IR via libLLVM-C; `emitLlvm` is the entry the root `main` calls
// after `runFrontend`, `emitLlvmRuntime` emits the companion C runtime. It `import`s
// the IR data (`./Ir`) and the front-end query/analysis API (`./Frontend`) — a
// one-way dependency (Ir ← Frontend ← Backend), so the module graph is a DAG.

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint, fileExists }
import @Std/Process with { argCount, argAt, exit }
import @Std/Ffi with { cString, stringFromCString, arrayCPtr }
import @Std/Core with { stringFromBytesUnchecked, truncU8 }
import @Std/Syntax with { Kind, Tok, Lexer, lex, kindCode, rangeEquals, P, parseBlockAst, parseExprAst, parseProgramAst, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst, emptyExpr }
import ./Ir with { PType, TypeRef, CaptureEntry, Local, TypeInfo, MakeField, Bind, Arg, MatchArm, PatInfo, Block, Param, FieldDef, StructDef, Variant, TraitDef, DeriveReq, AssocBinding, DefaultExt, Conform, MethodAlias, FuncBound, FnInst, EnumDef, Func, Global, NewtypeDef, Arena, Decls, Modules, MonoWork, TypeCache, Interner, ParseScratch, Cursor, Expr, Stmt, appendBytes }
import ./Frontend with { Comp, intern, spansEqual, assocRecvName, binTraitMethodName, chainResultRef, clearSelfItemEnv, compileErrorAt, compoundBinOp, digitStrU, enumIdxByName, exprOffset, extMethodNameExists, fieldIsBoxed, findAssoc, findAssocByName, findExtMethod, findExtMethodById, findFunc, findMethod, findOrAddTypeRef, findTraitIdxByName, firstFuncByName, groundTypeRef, inferFnArgs, isBinTraitOp, isEnumName, isFloatType, isFnType, isGenericFreeFn, isGenericInst, isIntType, isPrimType, isRefInst, isTraitName, kwSpan, lineOf, methodInEntryModule, moduleOf, nameIsMain, newtypeUnderName, newtypeUnderRef, opAdd, opAnd, opAssign, opBitAnd, opBitNot, opBitOr, opBitXor, opDiv, opEq, opGe, opGt, opLe, opLt, opMul, opNe, opNot, opOr, opRem, opShl, opShr, opSub, paramsLabelsOk, resolvedCallee, resultErrArgRef, runFrontend, setSelfItemEnv, simpleTypeRef, structIndexByName, typeOf, typeRefEq, typeRefFromFactoryIdx, unaryMethodName, unifyTypeParam, variantIndex, viewOnlyMethodExists }

part ./Backend/Llvm
