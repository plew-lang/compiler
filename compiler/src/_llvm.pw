// The LLVM-backend root of the Plew compiler. A SECOND module root alongside
// _.pw (the C backend): it `part`s exactly the same backend-agnostic front-end
// (Ast / Parser / all Codegen analysis / Loader / Driver) and adds the LLVM
// emitter (Backend/Llvm), so its `main` runs `runFrontend()` then `emitLlvm()`
// instead of `emitC()`. Because only this root parts Backend/Llvm, only the
// binary built from it (compiler/plewc-llvm) references libLLVM — compiler/plewc
// (built from _.pw) stays libLLVM-free and keeps its clang-only bootstrap.
//
// Build (on demand, by the C-backend compiler): see build-llvm.sh.
//   compiler/plewc compiler/src/_llvm.pw > plewc-llvm.c
//   clang plewc-llvm.c $(llvm-config --ldflags --libs core) -o compiler/plewc-llvm

import @Std/Io with { print, write, writeByte, readStdin, readFile, readFileBytes, eprint, fileExists }
import @Std/Process with { argCount, argAt, exit }
import @Std/Ffi with { cString, stringFromCString, arrayCPtr }
import @Std/Syntax with { Kind, Tok, Lexer, lex, kindCode, rangeEquals, P, parseBlockAst, parseExprAst, parseProgramAst, ExprAst, StmtAst, BlockAst, PatternAst, MatchArmAst, ArgAst, MakeFieldAst, BindAst, TypeAst, ParamAst, Span, DeclAst, DeclKind, FieldAst, VariantAst, ImplAst, MemberAst, MemberKind, SigAst, TraitAst, ExternAst, ImportAst, DirectiveAst, DeriveReqAst, TopItemAst, emptyExpr }

part ./Ast
part ./Parser/Decl
part ./Codegen/Emit
part ./Codegen/Resolve
part ./Codegen/Ops
part ./Codegen/Check
part ./Codegen/Expr
part ./Codegen/Stmt
part ./Codegen/Decl
part ./Codegen/Mono
part ./Codegen/Array
part ./Codegen/Async
part ./Codegen/Gen
part ./Codegen/Lower
part ./Codegen/Driver
part ./Backend/Llvm
part ./Loader

fn main() {
    // `plewc-llvm --runtime` emits the companion C runtime the generated IR links
    // against (no front-end needed — the runtime is program-independent so far).
    if argCount() > 1 {
        if argAt(1) == "--runtime" {
            emitLlvmRuntime()
            return
        }
    }
    mut val c: Comp = runFrontend()
    emitLlvm(c: inout c)
}
