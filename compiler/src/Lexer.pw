// Part of the Plew compiler module (root: _.pw). Lexer: source bytes ->
// token stream. See _.pw for imports and the driver.

enum Kind {
    Eof
    Newline
    Int
    Str
    Char
    Ident
    KwFn
    KwStruct
    KwEnum
    KwMatch
    KwIf
    KwElse
    KwWhile
    KwFor
    KwBreak
    KwContinue
    KwReturn
    KwGive
    KwVal
    KwMut
    KwIn
    KwAs
    KwInout
    KwTrue
    KwFalse
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Eq
    EqEq
    Ne
    Lt
    Le
    Gt
    Ge
    Plus
    Minus
    Star
    Slash
    Percent
    AmpAmp
    PipePipe
    Bang
    Amp
    Pipe
    Caret
    Shl
    Shr
    Tilde
    Arrow
    FatArrow
    SlashGt
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    DotDotLt
    DotDotEq
    Unknown
}

struct Tok {
    val kind: Kind
    val start: U64
    val len: U64
}

struct Lexer {
    val bytes: Array[U8]
    mut val pos: U64
    mut val toks: Array[Tok]
    mut val depth: I64
}

impl Lexer {
    // The byte `off` positions ahead of the cursor, or 0 past the end.
    fn at(off: U64) -> U8 {
        val i: U64 = self.pos + off
        if i < self.bytes.count {
            return self.bytes[i]
        }
        return 0
    }
    // Push a token and advance the cursor past it.
    inout fn emit(k: Kind, start: U64, len: U64) {
        self.toks.append(<Tok kind=k start=start len=len />)
        self.pos = start + len
    }
    // Was the most recent token a newline?
    fn lastWasNewline() -> Bool {
        val n: U64 = self.toks.count
        if n == 0 {
            return false
        }
        val t: Tok = self.toks[n - 1]
        return match t.kind {
            Kind.Newline => true
            _ => false
        }
    }
    // Can the most recent token end a statement? (decides newline insertion)
    fn lastCanEnd() -> Bool {
        val n: U64 = self.toks.count
        if n == 0 {
            return false
        }
        val t: Tok = self.toks[n - 1]
        return match t.kind {
            Kind.Ident | Kind.Int | Kind.Str | Kind.Char | Kind.RParen | Kind.RBracket | Kind.RBrace | Kind.SlashGt | Kind.KwTrue | Kind.KwFalse | Kind.KwReturn | Kind.KwBreak | Kind.KwContinue => true
            _ => false
        }
    }
}

fn isDigit(b: U8) -> Bool {
    if b >= '0' {
        if b <= '9' {
            return true
        }
    }
    return false
}

fn isAlpha(b: U8) -> Bool {
    if b == '_' {
        return true
    }
    if b >= 'a' {
        if b <= 'z' {
            return true
        }
    }
    if b >= 'A' {
        if b <= 'Z' {
            return true
        }
    }
    return false
}

fn isAlnum(b: U8) -> Bool {
    if isAlpha(b: b) {
        return true
    }
    return isDigit(b: b)
}

fn rangeEquals(bytes: Array[U8], start: U64, len: U64, kw: String) -> Bool {
    val kb: Array[U8] = kw.bytes
    if len != kb.count {
        return false
    }
    mut val j: U64 = 0
    while j < len {
        if bytes[start + j] != kb[j] {
            return false
        }
        j += 1
    }
    return true
}

fn identKind(bytes: Array[U8], start: U64, len: U64) -> Kind {
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "fn") {
        return <Kind.KwFn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "struct") {
        return <Kind.KwStruct />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "enum") {
        return <Kind.KwEnum />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "match") {
        return <Kind.KwMatch />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "if") {
        return <Kind.KwIf />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "else") {
        return <Kind.KwElse />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "while") {
        return <Kind.KwWhile />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "for") {
        return <Kind.KwFor />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "break") {
        return <Kind.KwBreak />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "continue") {
        return <Kind.KwContinue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "return") {
        return <Kind.KwReturn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "give") {
        return <Kind.KwGive />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "val") {
        return <Kind.KwVal />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "mut") {
        return <Kind.KwMut />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "in") {
        return <Kind.KwIn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "as") {
        return <Kind.KwAs />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "inout") {
        return <Kind.KwInout />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "true") {
        return <Kind.KwTrue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "false") {
        return <Kind.KwFalse />
    }
    return <Kind.Ident />
}

fn lex(lx: inout Lexer) {
    while lx.pos < lx.bytes.count {
        val b: U8 = lx.at(off: 0)
        if b == ' ' {
            lx.pos += 1
            continue
        }
        if b == '\t' {
            lx.pos += 1
            continue
        }
        if b == '\r' {
            lx.pos += 1
            continue
        }
        if b == '\n' {
            if lx.depth > 0 {
                lx.pos += 1
            } else {
                if lx.lastCanEnd() {
                    if lx.lastWasNewline() {
                        lx.pos += 1
                    } else {
                        lx.emit(k: <Kind.Newline />, start: lx.pos, len: 1)
                    }
                } else {
                    lx.pos += 1
                }
            }
            continue
        }
        if b == '/' {
            if lx.at(off: 1) == '/' {
                while lx.pos < lx.bytes.count {
                    if lx.at(off: 0) == '\n' {
                        break
                    }
                    lx.pos += 1
                }
                continue
            }
        }
        if isDigit(b: b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count {
                if isDigit(b: lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            lx.emit(k: <Kind.Int />, start: start, len: j - start)
            continue
        }
        if isAlpha(b: b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count {
                if isAlnum(b: lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            val len: U64 = j - start
            val k: Kind = identKind(bytes: lx.bytes, start: start, len: len)
            lx.emit(k: k, start: start, len: len)
            continue
        }
        if b == '"' {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos + 1
            while j < lx.bytes.count {
                // a backslash escapes the next byte (so `\"` does not close)
                if lx.bytes[j] == '\\' {
                    j += 2
                    continue
                }
                if lx.bytes[j] == '"' {
                    j += 1
                    break
                }
                j += 1
            }
            lx.emit(k: <Kind.Str />, start: start, len: j - start)
            continue
        }
        if b == '\'' {
            // character literal `'…'` (one scalar; backslash escapes the next byte)
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos + 1
            while j < lx.bytes.count {
                if lx.bytes[j] == '\\' {
                    j += 2
                    continue
                }
                if lx.bytes[j] == '\'' {
                    j += 1
                    break
                }
                j += 1
            }
            lx.emit(k: <Kind.Char />, start: start, len: j - start)
            continue
        }
        val b2: U8 = lx.at(off: 1)
        if b == '.' {
            if b2 == '.' {
                val b3: U8 = lx.at(off: 2)
                if b3 == '<' {
                    lx.emit(k: <Kind.DotDotLt />, start: lx.pos, len: 3)
                    continue
                }
                if b3 == '=' {
                    lx.emit(k: <Kind.DotDotEq />, start: lx.pos, len: 3)
                    continue
                }
            }
            lx.emit(k: <Kind.Dot />, start: lx.pos, len: 1)
            continue
        }
        if b == '=' {
            if b2 == '=' {
                lx.emit(k: <Kind.EqEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.FatArrow />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Eq />, start: lx.pos, len: 1)
            continue
        }
        if b == '!' {
            if b2 == '=' {
                lx.emit(k: <Kind.Ne />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Bang />, start: lx.pos, len: 1)
            continue
        }
        if b == '<' {
            if b2 == '=' {
                lx.emit(k: <Kind.Le />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '<' {
                lx.emit(k: <Kind.Shl />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Lt />, start: lx.pos, len: 1)
            continue
        }
        if b == '>' {
            if b2 == '=' {
                lx.emit(k: <Kind.Ge />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.Shr />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Gt />, start: lx.pos, len: 1)
            continue
        }
        if b == '+' {
            if b2 == '=' {
                lx.emit(k: <Kind.PlusEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Plus />, start: lx.pos, len: 1)
            continue
        }
        if b == '-' {
            if b2 == '=' {
                lx.emit(k: <Kind.MinusEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.Arrow />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Minus />, start: lx.pos, len: 1)
            continue
        }
        if b == '*' {
            if b2 == '=' {
                lx.emit(k: <Kind.StarEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Star />, start: lx.pos, len: 1)
            continue
        }
        if b == '/' {
            if b2 == '=' {
                lx.emit(k: <Kind.SlashEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.SlashGt />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Slash />, start: lx.pos, len: 1)
            continue
        }
        if b == '%' {
            if b2 == '=' {
                lx.emit(k: <Kind.PercentEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Percent />, start: lx.pos, len: 1)
            continue
        }
        if b == '&' {
            if b2 == '&' {
                lx.emit(k: <Kind.AmpAmp />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Amp />, start: lx.pos, len: 1)
            continue
        }
        if b == '|' {
            if b2 == '|' {
                lx.emit(k: <Kind.PipePipe />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Pipe />, start: lx.pos, len: 1)
            continue
        }
        if b == '^' {
            lx.emit(k: <Kind.Caret />, start: lx.pos, len: 1)
            continue
        }
        if b == '~' {
            lx.emit(k: <Kind.Tilde />, start: lx.pos, len: 1)
            continue
        }
        if b == '(' {
            lx.emit(k: <Kind.LParen />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == ')' {
            lx.emit(k: <Kind.RParen />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == '[' {
            lx.emit(k: <Kind.LBracket />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == ']' {
            lx.emit(k: <Kind.RBracket />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == '{' {
            lx.emit(k: <Kind.LBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == '}' {
            lx.emit(k: <Kind.RBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == ',' {
            lx.emit(k: <Kind.Comma />, start: lx.pos, len: 1)
            continue
        }
        if b == ':' {
            lx.emit(k: <Kind.Colon />, start: lx.pos, len: 1)
            continue
        }
        lx.emit(k: <Kind.Unknown />, start: lx.pos, len: 1)
    }
    lx.toks.append(<Tok kind=<Kind.Eof /> start=lx.pos len=0 />)
}

fn kindCode(k: Kind) -> I64 {
    return match k {
        Kind.Eof => 0
        Kind.Newline => 1
        Kind.Int => 2
        Kind.Str => 3
        Kind.Char => 5
        Kind.Ident => 4
        Kind.KwFn => 10
        Kind.KwStruct => 11
        Kind.KwEnum => 12
        Kind.KwMatch => 13
        Kind.KwIf => 14
        Kind.KwElse => 15
        Kind.KwWhile => 16
        Kind.KwFor => 17
        Kind.KwBreak => 18
        Kind.KwContinue => 19
        Kind.KwReturn => 20
        Kind.KwGive => 21
        Kind.KwVal => 22
        Kind.KwMut => 23
        Kind.KwIn => 24
        Kind.KwAs => 25
        Kind.KwInout => 26
        Kind.KwTrue => 27
        Kind.KwFalse => 28
        Kind.LParen => 40
        Kind.RParen => 41
        Kind.LBracket => 42
        Kind.RBracket => 43
        Kind.LBrace => 44
        Kind.RBrace => 45
        Kind.Comma => 46
        Kind.Colon => 47
        Kind.Dot => 48
        Kind.Eq => 49
        Kind.EqEq => 50
        Kind.Ne => 51
        Kind.Lt => 52
        Kind.Le => 53
        Kind.Gt => 54
        Kind.Ge => 55
        Kind.Plus => 56
        Kind.Minus => 57
        Kind.Star => 58
        Kind.Slash => 59
        Kind.Percent => 60
        Kind.AmpAmp => 61
        Kind.PipePipe => 62
        Kind.Bang => 63
        Kind.Arrow => 64
        Kind.FatArrow => 65
        Kind.SlashGt => 66
        Kind.PlusEq => 67
        Kind.MinusEq => 68
        Kind.StarEq => 69
        Kind.SlashEq => 70
        Kind.PercentEq => 71
        Kind.DotDotLt => 72
        Kind.DotDotEq => 73
        Kind.Amp => 74
        Kind.Pipe => 75
        Kind.Caret => 76
        Kind.Shl => 77
        Kind.Shr => 78
        Kind.Tilde => 79
        Kind.Unknown => 99
    }
}

