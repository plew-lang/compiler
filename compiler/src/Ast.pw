// Part of the Plew compiler module (root: _.pw). AST: arena node types
// (indexed by U64), the Comp state, and cursor helpers.

// ---- AST (arena, indexed by U64) ----
//
// Expressions and statements live in flat arenas (Array[Expr]/Array[Stmt]);
// children are referenced by U64 index. Operators are stored as kindCode (I64)
// to avoid nesting an enum inside an enum payload. Identifier nodes keep the
// source (start, len) span so codegen can echo the name via writeByte.

// A parsed type: for `Array[E]`, (start,len) names the element E and isArray is
// true; otherwise (start,len) names the type itself (scalar / String / named).
struct PType {
    val start: U64
    val len: U64
    val isArray: Bool
    // index into Comp.types of the full structured type (head name + type
    // arguments). The (start,len,isArray) triple above is the legacy "head"
    // view kept for the Array / scalar / named paths; `ref` carries the general
    // `Name[Arg, ...]` shape (nested, multi-arg) for generics. For `Array[E]`
    // the triple still names E with isArray=true, and ref is {Array, [E]}.
    val ref: U64
}

// A structured type reference: a head type name span plus a list of type
// arguments (indices into Comp.types). Non-generic types have an empty args
// list. `Array[E]` is {name="Array", args=[E]}; `Optional[I32]` is
// {name="Optional", args=[I32]}; a bare `I32` is {name="I32", args=[]}.
struct TypeRef {
    val nameStart: U64
    val nameLen: U64
    val args: Array[U64]
}

// A variable binding in scope during codegen (param, let, or match bind), used
// to recover an expression's type for monomorphization and `.bytes` dispatch.
struct Local {
    val nameStart: U64
    val nameLen: U64
    val tyStart: U64
    val tyLen: U64
    val isArray: Bool
    // structured type (Comp.types index); carries generic type arguments that
    // the (tyStart,tyLen,isArray) head view cannot.
    val ty: U64
    val isInout: Bool
    // assignable? `mut val` locals and `inout` params are; plain `val` locals,
    // function params, for-loop vars and match binds are immutable (spec: `val`
    // is immutable, `mut val` is the mutable storage form).
    val isMut: Bool
    // owns its value (a `let` binding) and so releases it at scope exit, vs a
    // borrow (param / for-loop var / match bind) that aliases someone else's
    // storage and must not free it. ARC: only owned heap locals are released.
    val owned: Bool
    // moved-out (spec/03): a `move` binding/arg transferred ownership away, so
    // this local is dead — using it again is an error and it is NOT released at
    // scope exit (the new owner releases). Set during codegen as moves are seen.
    val moved: Bool
}

// The recovered type of an expression. kind: 0 scalar (long long), 1 String,
// 2 named struct/enum, 3 array. For named: (nameStart,len) is the type name;
// for array: the element type name (always backed by a real declaration span).
struct TypeInfo {
    val kind: I64
    val nameStart: U64
    val nameLen: U64
    // Comp.types index of the full structured type when this is a generic
    // instantiation (e.g. `Optional[I32]`), so match/dispatch can recover the
    // mangled C name and substitute type parameters. 0 (sentinel) otherwise.
    val ref: U64
}

// One `field=expr` pair inside a JSX construction `<Type field=expr ... />`.
struct MakeField {
    val nameStart: U64
    val nameLen: U64
    val value: U64
}

// One field binding inside a match pattern `E.V { val a, b: val c }`. `name` is
// the introduced local; `field` is the variant field it reads. For punning
// (`val a`) the two are equal; for rename (`b: val c`) field=b, name=c.
// (Also reused elsewhere as a plain (name) span pair — array element names,
// part directives — where the field span is just set equal to the name.)
struct Bind {
    val nameStart: U64
    val nameLen: U64
    val fieldStart: U64
    val fieldLen: U64
}

// A call argument: the expression plus whether it was passed `inout` (which
// lowers to `&(expr)` at the call site, matching a pointer parameter).
struct Arg {
    val expr: U64
    val isInout: Bool
    // the argument label `name:` (spec: required, in declaration order). Empty
    // when the call site omitted it (then a user-function call is rejected).
    val labelStart: U64
    val labelLen: U64
    val hasLabel: Bool
}

enum Expr {
    // An integer (or Bool) literal. `offset` is the source byte for diagnostics.
    // `isBool` marks `true`/`false` (lowered to 1/0 but typed Bool, never an
    // ambiguous integer). `tyStart`/`tyLen` is an optional type suffix span
    // (`5U64`, `1I32`); tyLen 0 = no suffix, so the type comes from context.
    Int { value: I64, offset: U64, isBool: Bool, tyStart: U64, tyLen: U64 }
    Ident { start: U64, len: U64 }
    Unary { op: I64, operand: U64 }
    Binary { op: I64, lhs: U64, rhs: U64 }
    Call { nameStart: U64, nameLen: U64, args: Array[Arg] }
    Field { base: U64, nameStart: U64, nameLen: U64 }
    Make { typeStart: U64, typeLen: U64, variantStart: U64, variantLen: U64, isEnum: Bool, ty: U64, fields: Array[MakeField] }
    Str { start: U64, len: U64 }
    Array { elems: Array[U64] }
    Index { base: U64, index: U64 }
    Method { recv: U64, nameStart: U64, nameLen: U64, args: Array[Arg] }
    Cast { operand: U64, tyStart: U64, tyLen: U64, ty: U64 }
    // value-position `match scrut { Pat => expr, ... }`: like Stmt.Match but each
    // arm yields an expression (MatchArm.body is an Expr index, not a Block).
    // Lowers to a C statement-expression.
    MatchExpr { scrut: U64, arms: Array[MatchArm] }
    // value-position `if cond { ... give a } else { ... give b }`: each branch is
    // a block ending in `give`. Lowers to a C statement-expression (like
    // MatchExpr). `else` is mandatory in value position (it must always yield).
    IfExpr { cond: U64, thenBlk: U64, elseBlk: U64 }
    // `opt ?? default` (nil-coalescing on Optional): the value inside `Some`,
    // else `default`. Lowers to a C statement-expression reading the Optional's
    // tag. Couples to @Std/Core's Optional shape (Some = tag 0, field `v`).
    Coalesce { opt: U64, deflt: U64 }
    // `try expr` (Result early return): if `expr` is `Err`, return it from the
    // enclosing function (rebuilt as the function's own Result error variant);
    // otherwise the `Ok` value. Couples to @Std/Core's Result shape (Ok = tag 0
    // field `value`, Err = tag 1 field `error`). First cut: error types must
    // match (no `From` conversion yet).
    Try { expr: U64 }
    // `ref->field` — access a field of a `Ref[T]`'s pointee. `Ref[T]` lowers to
    // a C `T*`, so this is C's `ref->field`. `->` is spec's pointee accessor;
    // the bare handle is `.` (rare). Shared mutation is visible at `->`.
    Arrow { base: U64, nameStart: U64, nameLen: U64 }
    // a closure literal `fn(params) -> ret { body }`. Lambda-lifted to a
    // top-level C function named `__closure<exprIndex>`; the expression value is
    // that function's pointer. v1: non-capturing (the body may reference its
    // params and globals, not enclosing locals).
    Closure { params: Array[Param], hasRet: Bool, retStart: U64, retLen: U64, retIsArray: Bool, retTy: U64, body: U64 }
    // `move operand` / `borrow operand` (spec/03): an access-mode prefix on a
    // `unique` value in a binding/argument/return position. Lowers to the
    // operand's value (a unique struct is a bit-copy); `move` additionally marks
    // the operand's place moved-out so the source is dead and not double-released.
    Move { operand: U64, isBorrow: Bool }
}

// One arm of a match: either `_ => block` (wildcard) or `Enum.Variant
// [{ val f ... }] => block`. The pattern names the enum and variant, so codegen
// resolves the tag index and field types without any type inference.
struct MatchArm {
    val isWildcard: Bool
    val enumStart: U64
    val enumLen: U64
    val variantStart: U64
    val variantLen: U64
    val binds: Array[Bind]
    // body is a Block index for Stmt.Match, or an Expr index for Expr.MatchExpr.
    val body: U64
}

// The pattern part of a match arm (everything before `=>`), shared by statement
// and expression match parsing. Mirrors MatchArm minus the body.
struct PatInfo {
    val isWildcard: Bool
    val enumStart: U64
    val enumLen: U64
    val variantStart: U64
    val variantLen: U64
    val binds: Array[Bind]
}

enum Stmt {
    Let { mutable: Bool, nameStart: U64, nameLen: U64, tyStart: U64, tyLen: U64, tyIsArray: Bool, ty: U64, init: U64 }
    Assign { op: I64, target: U64, value: U64 }
    Print { expr: U64, offset: U64 }
    ExprStmt { expr: U64 }
    Return { value: U64, hasValue: Bool }
    If { cond: U64, thenBlk: U64, elseBlk: U64, hasElse: Bool }
    While { cond: U64, body: U64 }
    // `for val name in iter { body }`. isRange: iter is `lo ..(< | =) hi`
    // (inclusive picks <=); otherwise iter is an array, walked by index.
    For { varStart: U64, varLen: U64, isRange: Bool, inclusive: Bool, iter: U64, rangeHi: U64, body: U64 }
    Match { scrut: U64, arms: Array[MatchArm] }
    // `panic <msg>`: a diverging statement (spec: unrecoverable, never returns).
    // msg is a String expression; offset is the `panic` keyword for diagnostics.
    Panic { msg: U64, offset: U64 }
    // `give <expr>`: yields the value of the enclosing block-expression (an
    // `if`/`match` used in value position). Codegen assigns it to the active
    // result temp.
    Give { value: U64 }
    Break
    Continue
}

struct Block {
    val stmts: Array[U64]
}

struct Param {
    val nameStart: U64
    val nameLen: U64
    val tyStart: U64
    val tyLen: U64
    val tyIsArray: Bool
    val ty: U64
    val isInout: Bool
    // access mode for a `unique`-typed parameter (spec/03): `move T` transfers
    // ownership to the callee (it runs deinit at its scope exit), `borrow T` is a
    // non-consuming read (callee never deinits). Copyable types use neither.
    val isMove: Bool
    val isBorrow: Bool
    // label-suppressed `name~: Type` (spec/04): the argument is passed without a
    // label (positional). Default false = labelled (the normal case).
    val noLabel: Bool
    // default argument `name: T = expr` (spec/04): when the call omits this
    // param, `defaultExpr` is emitted in its place. v1 supports omitting trailing
    // defaulted params. `hasDefault` false = required.
    val hasDefault: Bool
    val defaultExpr: U64
}

struct FieldDef {
    val nameStart: U64
    val nameLen: U64
    val tyStart: U64
    val tyLen: U64
    val tyIsArray: Bool
    val ty: U64
    // declared `mut val` (assignable storage) vs `val` (immutable). Always false
    // for enum variant fields (they take no modifier). Used for the composite
    // mutability check on `base.field = x` (spec: both binding and field `mut`).
    val isMut: Bool
}

struct StructDef {
    val nameStart: U64
    val nameLen: U64
    // generic type parameters `[T, U]` (each a name span; reuses Bind). Empty
    // for a non-generic struct. Capability markers (noLocal/allowUnique) are
    // skipped at parse time (v1: allowUnique unimplemented, noLocal a no-op).
    val typeParams: Array[Bind]
    val fields: Array[FieldDef]
    // declared `unique struct` (spec/03): copy-incapable, move-only, may carry a
    // `deinit`. A unique value is never CoW-shared; bindings move ownership and
    // the last owner runs `deinit` at scope exit. Default false = copyable.
    val isUnique: Bool
}

struct Variant {
    val nameStart: U64
    val nameLen: U64
    val fields: Array[FieldDef]
}

// A trait declaration `trait Name { fn req(...) -> T ... }` (spec/08). The body
// holds only *requirements* (no body). For T1 we record each method
// requirement's name (reuses Bind as a (start,len) pair); the parser still
// consumes the full signature but labels/types are recovered later. Field/
// associated-type/factory requirements are not parsed yet (additive).
struct TraitDef {
    val nameStart: U64
    val nameLen: U64
    // requirement signatures (spec/08): each a body-less Func carrying the
    // requirement's name, params (labels + types), return type, and isAssoc.
    // The abstract generic type-checker reads these to resolve `x.req(...)` on a
    // bounded type parameter; the completeness check matches them to witnesses.
    val reqs: Array[Func]
}

// A recorded conformance `impl Type as Trait { ... }` (spec/08: conformance is
// explicit, never implicit). `witnessed` lists the requirement names this impl
// satisfied (via a body method or a `via` alias), so the completeness check can
// verify every requirement of `Trait` is met (incomplete conformance = error).
struct Conform {
    val typeStart: U64
    val typeLen: U64
    val traitStart: U64
    val traitLen: U64
    val witnessed: Array[Bind]
}

// A `via` alias `fn req(...) -> T via real` inside a trait impl (spec/08: the
// requirement name becomes a bare callable that dispatches to the real member).
// findMethod, on missing `alias` for `recv`, retries with `real` — so both
// `x.req()` and `x.real()` resolve to the one real method.
struct MethodAlias {
    val recvStart: U64
    val recvLen: U64
    val aliasStart: U64
    val aliasLen: U64
    val realStart: U64
    val realLen: U64
}

// A trait bound `where T: Trait` on a function (spec/08). `fnIdx` indexes
// c.funcs; (paramStart,paramLen) names the bounded type parameter; (traitStart,
// traitLen) the required trait. `where T: A + B` and `where T: A, U: B` expand to
// one FuncBound per atom. Enforced at instantiation: the concrete type bound to
// the parameter must conform to the trait, else a loud error.
struct FuncBound {
    val fnIdx: U64
    val paramStart: U64
    val paramLen: U64
    val traitStart: U64
    val traitLen: U64
}

// A concrete instantiation of a generic free function (`fn f[T](x: T)` called
// with T = a concrete type). `fnIdx` indexes c.funcs; `args` are the concrete
// type arguments (TypeRef indices) aligned to the function's typeParams.
// Discovered from call sites (only ground/concrete instantiations); each gets a
// specialized C function `f_<arg-mangle...>` emitted under the type-param env.
struct FnInst {
    val fnIdx: U64
    val args: Array[U64]
}

struct EnumDef {
    val nameStart: U64
    val nameLen: U64
    // generic type parameters `[T, U]` (see StructDef.typeParams).
    val typeParams: Array[Bind]
    val variants: Array[Variant]
}

struct Func {
    val nameStart: U64
    val nameLen: U64
    // generic type parameters `fn id[T](...)` (name spans; empty if not
    // generic). For a method, an `impl[T] Type[T]`-introduced parameter also
    // lands here. Consumed by G3 monomorphization.
    val typeParams: Array[Bind]
    val params: Array[Param]
    val hasRet: Bool
    val retStart: U64
    val retLen: U64
    val retIsArray: Bool
    val retTy: U64
    val body: U64
    // method receiver: an `impl Type { ... }` member carries the receiver type
    // (recvStart,recvLen) and whether self is `inout` (`inout fn` vs `fn`). The
    // C function is mangled `Type_name` with an extra leading `self` parameter.
    val hasRecv: Bool
    val recvStart: U64
    val recvLen: U64
    val selfInout: Bool
    // `move fn` (spec/03): the method consumes self (a unique value), so self is
    // owned here — deinit runs at the method's scope exit — and the call site marks
    // the receiver moved. `fn`/`borrow fn` read self by value (not consumed);
    // `inout fn` borrows it mutably. (`borrow fn` is accepted as a synonym of `fn`.)
    val selfMove: Bool
    // `assoc fn` (spec/07,12): an associated (static) function — it lives in a
    // type's namespace but takes no `self`. hasRecv is false (no self parameter),
    // yet recvStart/recvLen still name the owning type, so the C name mangles
    // `Type_name` and a call `Type.name(args)` resolves. Operator requirements
    // (`Eq.eq`, `Ord.compare`, `Add.add`) are assoc fns.
    val isAssoc: Bool
}

struct Comp {
    val bytes: Array[U8]
    val toks: Array[Tok]
    mut val pos: U64
    mut val exprs: Array[Expr]
    mut val stmts: Array[Stmt]
    mut val blocks: Array[Block]
    mut val funcs: Array[Func]
    mut val structs: Array[StructDef]
    mut val enums: Array[EnumDef]
    // trait declarations, recorded conformances, and `via` method aliases
    // (spec/08). `traits`/`conforms` drive the conformance-completeness check;
    // `methodAliases` redirect a requirement name to its real witness method.
    mut val traits: Array[TraitDef]
    mut val conforms: Array[Conform]
    mut val methodAliases: Array[MethodAlias]
    // `where T: Trait` bounds on functions (spec/08), keyed by function index.
    mut val funcBounds: Array[FuncBound]
    // the function index currently being checked by the eager generic
    // type-checker (#9), so method/operator bound checks can look up its type
    // parameters and `where` bounds. c.funcs.count when not checking.
    mut val curCheckFn: U64
    // scratch: requirement names witnessed by the trait impl currently being
    // parsed (body method or `via` alias). Reset at each `impl Type as Trait`
    // entry; folded into the Conform record at the impl's close.
    mut val curWitnessed: Array[Bind]
    // scratch: the trait spans parsed by parseWhereClause, parallel to its
    // returned param spans (a second return value without a tuple type).
    mut val curWhereTraits: Array[Bind]
    // structured type references (TypeRef arena), indexed by the `ty`/`ref`
    // fields above. Built during parsing; consumed by generic monomorphization.
    mut val types: Array[TypeRef]
    // concrete generic instantiations to monomorphize (TypeRef indices, deduped
    // structurally), collected from use sites after parsing. Post-order so a
    // by-value nested instance is defined before the type that contains it.
    mut val genInsts: Array[U64]
    // concrete instantiations of generic free functions (FnInst), discovered
    // from call sites after parsing. Each is emitted as a specialized C function.
    mut val fnInsts: Array[FnInst]
    // distinct function-type TypeRefs (head `fn`), for emitting a C function
    // pointer typedef per signature. Collected with genInsts during scanType.
    mut val fnTypes: Array[U64]
    // distinct Array element type names seen in declarations (for monomorphizing
    // PlewArray_<E> + runtime); each entry reuses Bind as a (start,len) pair.
    mut val arrayElems: Array[Bind]
    // variables in scope during codegen (params / lets / match binds), for type
    // recovery (monomorphization + `.bytes` dispatch).
    mut val locals: Array[Local]
    // fresh-temp counter for match scrutinee bindings (`_m0`, `_m1`, ...)
    mut val tmp: U64
    // set per-function during codegen so `return` lowers correctly
    mut val curIsMain: Bool
    mut val curRetVoid: Bool
    // the current function's return type span (for literal range-checking a
    // `return <expr>` against the declared return type). Valid when !curRetVoid.
    mut val curRetStart: U64
    mut val curRetLen: U64
    mut val curRetIsArray: Bool
    // the current function's structured return type (TypeRef index), so `try`
    // can rebuild the function's Result error variant. 0 outside a function.
    mut val curRetTy: U64
    // set per-function during codegen for the implicit method receiver: whether
    // the current function is a method, and if so its receiver type span and
    // whether self is `inout` (so a bare `self` lowers to `(*self)`).
    mut val curHasRecv: Bool
    mut val curRecvStart: U64
    mut val curRecvLen: U64
    mut val curSelfInout: Bool
    // the current method is a `move fn` (consumes self): self is deinit'd at every
    // exit of the body (set per-function during codegen).
    mut val curSelfMove: Bool
    // generic body substitution env: when emitting a monomorphized generic
    // function/method body, curTypeParams[i] (a type-param name) maps to the
    // concrete TypeRef curTypeArgs[i]. Empty outside a generic instantiation.
    mut val curTypeParams: Array[Bind]
    mut val curTypeArgs: Array[U64]
    // the receiver's concrete instantiation TypeRef when emitting a generic
    // method (so the mangled C name and `self`'s type resolve). 0 otherwise.
    mut val curRecvInstRef: U64
    // result temp id of the innermost value-position block (`if`/`match` expr)
    // currently being lowered, so a `give` statement knows which `__r<n>` to
    // assign — stored as `id + 1` so 0 means "not inside a block-expression" (a
    // bare `give` is then a no-op). The +1 encoding keeps it U64 (no signed
    // sentinel) under the lossless-`as` discipline.
    mut val curGiveTmp: U64
    // locals high-water mark at the current loop body's entry. break/continue
    // release the owned locals pushed since (the iteration's scopes); saved and
    // restored across nested loops. 0 when not inside a loop.
    mut val curLoopMark: U64
    // locals high-water mark at entry to the innermost conditional/loop body. An
    // explicit `move` of a local with a smaller index (declared outside the branch)
    // would be a conditional move — unsound without flow analysis (the persisted
    // moved flag would skip the value's deinit on the not-taken path) — so it is
    // rejected. 0 at function top level (straight-line moves always allowed).
    mut val curBranchBase: U64
    // which I/O builtins the file has imported (acceptance soundness: spec makes
    // these non-ambient, so using one without `import @Std/Io`/`@Std/Process`
    // is a compile error). One flag per builtin, matched to its module.
    mut val impPrint: Bool
    mut val impWrite: Bool
    mut val impWriteByte: Bool
    mut val impReadStdin: Bool
    mut val impReadFile: Bool
    mut val impArgCount: Bool
    mut val impArgAt: Bool
    mut val impEprint: Bool
    mut val impExit: Bool
    mut val impReadFileBytes: Bool
    mut val impFileExists: Bool
    // types that declared a `deinit { ... }` (spec/03). Each entry reuses Bind as
    // a (start,len) pair naming the receiver type. The deinit body itself is a
    // synthetic Func named `deinit` (hasRecv) in c.funcs; this list lets codegen
    // ask "does type T have a deinit?" so scope-exit drops fire it.
    mut val deinits: Array[Bind]
}

// ---- cursor helpers ----
//
// Methods on the parse cursor. All take `inout self` (even read-only ones): the
// Comp struct is large, so a by-value receiver would copy every arena header on
// each call; the cursor is always held by `inout` anyway.

impl Comp {
    // The kind of the token under the cursor.
    inout fn curKind() -> Kind {
        return self.toks[self.pos].kind
    }
    // The token under the cursor.
    inout fn cur() -> Tok {
        return self.toks[self.pos]
    }
    // The kind `off` tokens ahead, or Eof past the end.
    inout fn peekKind(off: U64) -> Kind {
        val i: U64 = self.pos + off
        if i < self.toks.count {
            return self.toks[i].kind
        }
        return <Kind.Eof />
    }
    // Advance the cursor by one token.
    inout fn advance() {
        self.pos = self.pos + 1
    }
    // Skip a run of newline tokens.
    inout fn skipNewlines() {
        while true {
            match self.curKind() {
                Kind.Newline => { self.advance() }
                _ => { break }
            }
        }
    }
    // Does the token under the cursor spell the keyword `kw`?
    inout fn identIs(kw: String) -> Bool {
        val t: Tok = self.toks[self.pos]
        return rangeEquals(bytes: self.bytes, start: t.start, len: t.len, kw: kw)
    }
    // Append an expression node, returning its arena index.
    inout fn pushExpr(e: Expr) -> U64 {
        val id: U64 = self.exprs.count
        self.exprs.append(e)
        return id
    }
    // Append a statement node, returning its arena index.
    inout fn pushStmt(s: Stmt) -> U64 {
        val id: U64 = self.stmts.count
        self.stmts.append(s)
        return id
    }
    // Append a structured type reference, returning its Comp.types index.
    inout fn pushType(t: TypeRef) -> U64 {
        val id: U64 = self.types.count
        self.types.append(t)
        return id
    }
    // Read an Int token's value out of the source bytes via its (start,len) span.
    inout fn tokenValue(t: Tok) -> I64 {
        mut val v: I64 = 0
        mut val j: U64 = 0
        while j < t.len {
            val b: U8 = self.bytes[t.start + j]
            v = v * 10 + (b as I64 - 48)
            j += 1
        }
        return v
    }
}

