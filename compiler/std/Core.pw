// @Std/Core — the Plew core library (pure Plew).
//
// Optional and Result are the canonical "maybe a value" / "value or error"
// types. They are ordinary generic enums; the compiler monomorphizes each
// concrete instantiation (`Optional[I32]`, `Result[I32, String]`, ...) and the
// methods below per instantiation. (Spec makes these ambient; for now a program
// imports them explicitly with `import @Std/Core`.)

// The primitive operator-trait conformances (spec/12, O6) — generated by
// tools/gen-numops.pw over the intrinsic floor; a part of this module so the
// `impl I32 as Add[I32]` etc. are coherent (Core owns the primitive types).
part ./Core/Num

// An optional value: `Some` holds a `T`, `None` holds nothing.
enum Optional[T] {
    Some(v: T)
    None
}

pub impl[T] Optional[T] {
    // Is this `Some`?
    fn isSome() -> Bool {
        match self {
            Optional.Some(val v) => { return true }
            Optional.None => { return false }
        }
    }
    // Is this `None`?
    fn isNone() -> Bool {
        match self {
            Optional.Some(val v) => { return false }
            Optional.None => { return true }
        }
    }
    // The contained value, or `fallback` when `None` (eager — `fallback` is always
    // evaluated). Overloaded by argument type with the lazy form below.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { return fallback }
        }
    }
    // The contained value, or `fallback()` when `None` (lazy — the closure runs only
    // on `None`). The explicit short-circuit form, replacing the removed `??`: the
    // deferred evaluation is visible as a closure `{ … }`, not hidden in an operator.
    fn unwrapOr(fallback: fn() -> T) -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { return fallback() }
        }
    }
    // The contained value; panics when `None`.
    fn unwrap() -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { panic "called unwrap on a None Optional" }
        }
    }
}

// The iteration protocol (spec/02,11). `Iterator` produces values one at a
// time: `next` advances the iterator (mutating self, hence `inout`) and yields
// `Some(v)` until exhausted, then `None` forever. `Iterable` is a type that can
// produce a fresh iterator over its elements; `for x in xs` desugars to
// `it = xs.iterator(); while { match it.next() { Some(v) => …; None => break } }`
// (the compiler keeps a fast path for the built-in Array/Range iterands). The
// associated `Item` is the element type; `Iter` is the concrete iterator type.
export trait Iterator {
    type Item
    inout next() -> Optional[Item]
}

export trait Iterable {
    type Item
    type Iter
    fn iterator() -> Iter
}

// Lazy iterator adapters — the combinator backbone. Each wraps an inner iterator
// (`where I: Iterator`) and is itself an Iterator, so combinators chain and run on
// demand (nothing is evaluated until the outer `next()` pulls). The provided
// `map`/`filter` below construct them; a program imports the protocol and writes
// `for v in xs.map(f).filter(p)` without naming the adapters.

// MapIter applies the mapping closure `f` to each element. `B` is the output
// element type (may differ from the inner Item); `F = fn(x: Item) -> B`.
export struct MapIter[I, F, B] {
    pub mut val inner: I
    pub val f: F
}
pub impl[I, F, B] MapIter[I, F, B] as Iterator where I: Iterator {
    type Item = B
    inout fn next() -> Optional[B] {
        match self.inner.next() {
            Optional.Some(val v) => { return <Optional.Some v=self.f(x: v) /> }
            Optional.None => { return <Optional.None /> }
        }
    }
}

// FilterIter yields only the elements for which the predicate `p` is true. The
// element type passes through unchanged (`E = Item`); `P = fn(x: Item) -> Bool`.
export struct FilterIter[I, P, E] {
    pub mut val inner: I
    pub val p: P
}
pub impl[I, P, E] FilterIter[I, P, E] as Iterator where I: Iterator {
    type Item = E
    inout fn next() -> Optional[E] {
        mut val go: Bool = true
        while go {
            match self.inner.next() {
                Optional.Some(val v) => {
                    if self.p(x: v) {
                        return <Optional.Some v=v />
                    }
                }
                Optional.None => { go = false }
            }
        }
        return <Optional.None />
    }
}

// TakeIter yields at most the first `remaining` elements of the inner iterator, then
// stops. The element type passes through unchanged (`E = Item`).
export struct TakeIter[I, E] {
    pub mut val inner: I
    pub mut val remaining: U64
}
pub impl[I, E] TakeIter[I, E] as Iterator where I: Iterator {
    type Item = E
    inout fn next() -> Optional[E] {
        if self.remaining == 0U64 {
            return <Optional.None />
        }
        self.remaining = self.remaining - 1U64
        return self.inner.next()
    }
}

// SkipIter discards the first `pending` elements on the first pull, then yields the
// rest of the inner iterator unchanged (`E = Item`).
export struct SkipIter[I, E] {
    pub mut val inner: I
    pub mut val pending: U64
}
pub impl[I, E] SkipIter[I, E] as Iterator where I: Iterator {
    type Item = E
    inout fn next() -> Optional[E] {
        mut val go: Bool = true
        while go {
            if self.pending == 0U64 {
                go = false
            } else {
                self.pending = self.pending - 1U64
                match self.inner.next() {
                    Optional.Some(val v) => { }
                    Optional.None => { return <Optional.None /> }
                }
            }
        }
        return self.inner.next()
    }
}

// EnumerateIter pairs each element with its 0-based index, yielding the labelled
// record `(index: U64, value: E)`. `E` is the inner element type.
export struct EnumerateIter[I, E] {
    pub mut val inner: I
    // the running index; defaults to 0 so the inline adapter build (which only fills
    // `inner` + call args) starts the count correctly without an explicit field.
    pub mut val n: U64 = 0U64
}
pub impl[I, E] EnumerateIter[I, E] as Iterator where I: Iterator {
    type Item = (index: U64, value: E)
    inout fn next() -> Optional[(index: U64, value: E)] {
        match self.inner.next() {
            Optional.Some(val v) => {
                val i: U64 = self.n
                self.n = self.n + 1U64
                return <Optional.Some v=(index: i, value: v) />
            }
            Optional.None => { return <Optional.None /> }
        }
    }
}

// Provided Iterator combinators (spec/08: a bare `impl Trait` on the trait's own
// module). Lazy: they only build an adapter; work happens when the result is
// iterated. `map`'s output type `B` is inferred from the closure argument.
pub impl Iterator {
    // Pair each element with its index: `for p in xs.enumerate()` gives records
    // `(index: U64, value: E)`.
    fn enumerate() -> EnumerateIter[Self, Item] {
        return <EnumerateIter[Self, Item] inner=self n=0U64 />
    }
    fn map[B](f: fn(x: Item) -> B) -> MapIter[Self, fn(x: Item) -> B, B] {
        return <MapIter[Self, fn(x: Item) -> B, B] inner=self f=f />
    }
    fn filter(p: fn(x: Item) -> Bool) -> FilterIter[Self, fn(x: Item) -> Bool, Item] {
        return <FilterIter[Self, fn(x: Item) -> Bool, Item] inner=self p=p />
    }
    // Yield at most the first `count` elements (a prefix), then stop.
    fn take(count: U64) -> TakeIter[Self, Item] {
        return <TakeIter[Self, Item] inner=self remaining=count />
    }
    // Skip the first `count` elements, then yield the rest.
    fn skip(count: U64) -> SkipIter[Self, Item] {
        return <SkipIter[Self, Item] inner=self pending=count />
    }
    // Terminal combinators (spec/08): they consume the iterator (drive `next()` to
    // exhaustion) rather than building an adapter. `self` is copied into a mutable
    // local so the protocol's `inout next()` can advance it.
    fn count() -> U64 {
        mut val it = self
        mut val n: U64 = 0U64
        mut val go: Bool = true
        while go {
            match it.next() {
                Optional.Some(val v) => { n = n + 1U64 }
                Optional.None => { go = false }
            }
        }
        return n
    }
    fn fold[B](init: B, combine: fn(acc: B, x: Item) -> B) -> B {
        mut val it = self
        mut val acc: B = init
        mut val go: Bool = true
        while go {
            match it.next() {
                Optional.Some(val v) => { acc = combine(acc: acc, x: v) }
                Optional.None => { go = false }
            }
        }
        return acc
    }
    fn any(p: fn(x: Item) -> Bool) -> Bool {
        mut val it = self
        mut val go: Bool = true
        while go {
            match it.next() {
                Optional.Some(val v) => { if p(x: v) { return true } }
                Optional.None => { go = false }
            }
        }
        return false
    }
    fn all(p: fn(x: Item) -> Bool) -> Bool {
        mut val it = self
        mut val go: Bool = true
        while go {
            match it.next() {
                Optional.Some(val v) => { if p(x: v) { } else { return false } }
                Optional.None => { go = false }
            }
        }
        return true
    }
    // The first element, or `None` for an empty iterator.
    fn first() -> Optional[Item] {
        mut val it = self
        return it.next()
    }
    // Collect every element into an `Array[Item]`, in iteration order.
    fn collect() -> Array[Item] {
        mut val it = self
        mut val out: Array[Item] = []
        mut val go: Bool = true
        while go {
            match it.next() {
                Optional.Some(val v) => { out.append(value: v) }
                Optional.None => { go = false }
            }
        }
        return out
    }
    // Combine the elements left-to-right with no seed, using the first element as the
    // initial accumulator. `None` for an empty iterator (nothing to reduce).
    fn reduce(combine: fn(acc: Item, x: Item) -> Item) -> Optional[Item] {
        mut val it = self
        match it.next() {
            Optional.Some(val v) => {
                mut val acc: Item = v
                mut val go: Bool = true
                while go {
                    match it.next() {
                        Optional.Some(val v) => { acc = combine(acc: acc, x: v) }
                        Optional.None => { go = false }
                    }
                }
                return <Optional.Some v=acc />
            }
            Optional.None => { return <Optional.None /> }
        }
    }
}

// The result of a fallible operation: `Ok` holds a `T`, `Err` holds an `E`.
enum Result[T, E] {
    Ok(value: T)
    Err(error: E)
}

pub impl[T, E] Result[T, E] {
    // Is this `Ok`?
    fn isOk() -> Bool {
        match self {
            Result.Ok(val value) => { return true }
            Result.Err(val error) => { return false }
        }
    }
    // Is this `Err`?
    fn isErr() -> Bool {
        match self {
            Result.Ok(val value) => { return false }
            Result.Err(val error) => { return true }
        }
    }
    // The success value, or `fallback` when `Err`.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Result.Ok(val value) => { return value }
            Result.Err(val error) => { return fallback }
        }
    }
    // The success value; panics when `Err`.
    fn unwrap() -> T {
        match self {
            Result.Ok(val value) => { return value }
            Result.Err(val error) => { panic "called unwrap on an Err Result" }
        }
    }
}

// assert(x > 0) / assert(x > 0, message: "...") panics when the condition is
// false (spec/11: always on, all builds). Returns (). The condition is
// label-suppressed (`cond~:`, positional); the diagnostic message is an
// optional labelled argument with a default.
export fn assert(cond~: Bool, message: String = "assertion failed") {
    if cond {
    } else {
        panic message
    }
}

// --- lang-item primitive type declarations (spec/15 core-library boundary) ---
// Opaque intrinsic types (representation is the compiler's int*_t / PlewString
// mapping); declaring them here makes Core their owner, so Core may coherently
// `impl` traits for them (spec/07,09 type-ownership).
extern "plew-intrinsic" {
    struct I8   struct I16  struct I32  struct I64
    struct U8   struct U16  struct U32  struct U64
    struct F32  struct F64
    struct Bool struct String
}

// Operator traits (spec/12): `a + b` desugars to `T.add(lhs: a, rhs: b)` iff
// `impl T as Add[Rhs]`; the right-operand type is the trait argument `[Rhs]`, so
// a type may add several conformances (`Add[Self]`, `Add[I64]`, …). The primitive
// numeric conformances are generated into ./Core/Num (over the intrinsic floor);
// user types declare their own. `as` desugars binary `+ - * / % & | ^ << >>` and
// prefix `- ! ~` uniformly — primitives are not special-cased (spec/12, O6).
export trait Add[Rhs]    { type Output  assoc fn add(lhs: Self, rhs: Rhs) -> Output }
export trait Sub[Rhs]    { type Output  assoc fn sub(lhs: Self, rhs: Rhs) -> Output }
export trait Mul[Rhs]    { type Output  assoc fn mul(lhs: Self, rhs: Rhs) -> Output }
export trait Div[Rhs]    { type Output  assoc fn div(lhs: Self, rhs: Rhs) -> Output }
export trait Rem[Rhs]    { type Output  assoc fn rem(lhs: Self, rhs: Rhs) -> Output }
export trait BitAnd[Rhs] { type Output  assoc fn bitand(lhs: Self, rhs: Rhs) -> Output }
export trait BitOr[Rhs]  { type Output  assoc fn bitor(lhs: Self, rhs: Rhs) -> Output }
export trait BitXor[Rhs] { type Output  assoc fn bitxor(lhs: Self, rhs: Rhs) -> Output }
export trait Shl[Rhs]    { type Output  assoc fn shl(lhs: Self, rhs: Rhs) -> Output }
export trait Shr[Rhs]    { type Output  assoc fn shr(lhs: Self, rhs: Rhs) -> Output }
export trait Neg    { type Output  assoc fn neg(value: Self) -> Output }
export trait Not    { type Output  assoc fn not(value: Self) -> Output }
export trait BitNot { type Output  assoc fn bitnot(value: Self) -> Output }

// Exponentiation (spec/12): `**` is not adopted; `pow(base: x, exp: n)` is the named
// arithmetic operation, backed by the `Pow[Exp]` trait (same shape as `Add[Rhs]`, with
// multiple conformances per base for different exponent types). The bare call dispatches
// on the base argument's type. The integer conformances take a non-negative `U64`
// exponent (a negative exponent on an integer is not representable) and compute by
// repeated checked multiplication — overflow panics like `*` (spec/02). Float pow
// (`F64 as Pow[F64]`, via a transcendental intrinsic) is additive and not yet provided.
export trait Pow[Exp] { type Output  assoc fn pow(base: Self, exp: Exp) -> Output }

impl I8 as Pow[U64] {
    type Output = I8
    assoc fn pow(base: I8, exp: U64) -> I8 {
        mut val result: I8 = 1I8
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl I16 as Pow[U64] {
    type Output = I16
    assoc fn pow(base: I16, exp: U64) -> I16 {
        mut val result: I16 = 1I16
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl I32 as Pow[U64] {
    type Output = I32
    assoc fn pow(base: I32, exp: U64) -> I32 {
        mut val result: I32 = 1I32
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl I64 as Pow[U64] {
    type Output = I64
    assoc fn pow(base: I64, exp: U64) -> I64 {
        mut val result: I64 = 1I64
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl U8 as Pow[U64] {
    type Output = U8
    assoc fn pow(base: U8, exp: U64) -> U8 {
        mut val result: U8 = 1U8
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl U16 as Pow[U64] {
    type Output = U16
    assoc fn pow(base: U16, exp: U64) -> U16 {
        mut val result: U16 = 1U16
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl U32 as Pow[U64] {
    type Output = U32
    assoc fn pow(base: U32, exp: U64) -> U32 {
        mut val result: U32 = 1U32
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}
impl U64 as Pow[U64] {
    type Output = U64
    assoc fn pow(base: U64, exp: U64) -> U64 {
        mut val result: U64 = 1U64
        mut val i: U64 = 0
        while i < exp { result = result * base  i += 1 }
        return result
    }
}

// Equality and ordering (spec/12): `==`/`!=` desugar to `Eq.eq`, and `< <= > >=`
// to a tag test on `Ord.compare`'s three-way `Ordering`. Same-type relations, so
// no type argument. The primitive conformances are generated into ./Core/Num.
export enum Ordering { Less  Equal  Greater }
export trait Eq { assoc fn eq(lhs: Self, rhs: Self) -> Bool }
export trait Ord: Eq { assoc fn compare(lhs: Self, rhs: Self) -> Ordering }

// Subscript (spec/12): `a[k]` desugars to `a.index(key: k)`, `a[k] = v` to
// `a.indexSet(key: k, value: v)`. Container accessors, so the requirement is a
// method (receiver = the collection), not an assoc fn. Read and write are separate
// traits (a read-only collection implements only Index).
export trait Index[Key]    { type Output  fn index(key: Key) -> Output }
export trait IndexSet[Key] { type Value   inout fn indexSet(key: Key, value: Value) }

// Build a String from a byte array WITHOUT validating UTF-8 — the unchecked floor (the
// bytes must already be valid UTF-8; decimal digits and interned source spans always
// are). The validated public constructor is `<String.convert from=bytes/>`
// (`String as TryFrom[Array[U8]]`, below). Lowered inline to the {ptr,i64} reinterpret.
// Exported so @Std/Syntax's parser and the compiler can turn known-valid byte ranges
// into Strings without paying re-validation; user code should prefer the checked form.
export extern "plew-intrinsic" {
    fn stringFromBytesUnchecked(b~: Array[U8]) -> String
    // a float -> its decimal text (the backend lowers it to snprintf "%g").
    fn floatToString(value~: F64) -> String
    // Truncate a U64 to its low 8 bits as U8 (`as U8` is lossless-only and rejects
    // wider values). Used to assemble UTF-8 bytes from a code point during string
    // literal `\u{...}` decoding, where each computed byte is known to fit in U8.
    fn truncU8(n: U64) -> U8
    // Truncate a (range-checked) integer to a narrower signed width. `as` is
    // lossless-only and rejects narrowing, so the fallible `convert` factories
    // (spec/12 TryFrom) reach for these after proving the value is in range.
    fn truncI8(n: I64) -> I8
    fn truncI16(n: I64) -> I16
    fn truncI32(n: I64) -> I32
    fn truncU16(n: U64) -> U16
    fn truncU32(n: U64) -> U32
    // Is this float a NaN? A direct intrinsic because `==`/`!=` on floats PANIC on a
    // NaN operand (spec/02), so the fallible float->int `convert` (spec/12) must test
    // NaN with this BEFORE any ordered comparison.
    fn isNanF64(f: F64) -> Bool
    // Truncate a float toward zero to I64 (`fptosi`). UB outside [-2^63, 2^63), so the
    // `convert` factory range-checks first and calls this only once the value fits.
    fn f64ToI64(f: F64) -> I64
}

// String methods, written in pure Plew over the exposed `bytes` view (spec/02:
// `String` is an owned lang-item that Core owns, so it carries inherent methods).
pub impl String {
    // Is the string empty (zero bytes)?
    fn isEmpty() -> Bool {
        return self.bytes.count == 0
    }
}

// A decimal digit (0-9) as its ASCII byte. Two width-typed copies: with no
// implicit numeric conversion an I64 digit cannot call a U64 helper (and `48+d`
// would need a forbidden cast), so each spells out the glyph table.
fn digitByteI(d: I64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}
fn digitByteU(d: U64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}

// Textual formatting (spec/02): `{x}` interpolation desugars to x.format(format:).
// The `format` spec string (e.g. ".2") is accepted but ignored for integers for
// now (no precision/padding yet — additive).
export trait Format {
    fn format(format: String) -> String
}

pub impl I64 as Format {
    fn format(format: String) -> String {
        mut val n: I64 = self
        mut val neg: Bool = false
        if n < 0 {
            neg = true
        }
        // collect digits least-significant-first (works in I64: a negative
        // remainder is flipped, avoiding any I64->U64 magnitude conversion).
        mut val digits: Array[U8] = []
        if n == 0 {
            digits.append(48)
        }
        while n != 0 {
            mut val d: I64 = n % 10
            if d < 0 {
                d = 0 - d
            }
            digits.append(digitByteI(d: d))
            n = n / 10
        }
        mut val out: Array[U8] = []
        if neg {
            out.append(45)
        }
        mut val i: U64 = digits.count
        while i > 0 {
            i = i - 1
            out.append(digits[i])
        }
        return stringFromBytesUnchecked(out)
    }
}

pub impl U64 as Format {
    fn format(format: String) -> String {
        mut val n: U64 = self
        mut val digits: Array[U8] = []
        if n == 0 {
            digits.append(48)
        }
        while n != 0 {
            val d: U64 = n % 10
            digits.append(digitByteU(d: d))
            n = n / 10
        }
        mut val out: Array[U8] = []
        mut val i: U64 = digits.count
        while i > 0 {
            i = i - 1
            out.append(digits[i])
        }
        return stringFromBytesUnchecked(out)
    }
}

// The narrower integer types delegate to the 64-bit formatters via a lossless
// widening (`as` allows signed->wider-signed and unsigned->wider-unsigned).
pub impl I8 as Format {
    fn format(format: String) -> String { return (self as I64).format(format: format) }
}
pub impl I16 as Format {
    fn format(format: String) -> String { return (self as I64).format(format: format) }
}
pub impl I32 as Format {
    fn format(format: String) -> String { return (self as I64).format(format: format) }
}
pub impl U8 as Format {
    fn format(format: String) -> String { return (self as U64).format(format: format) }
}
pub impl U16 as Format {
    fn format(format: String) -> String { return (self as U64).format(format: format) }
}
pub impl U32 as Format {
    fn format(format: String) -> String { return (self as U64).format(format: format) }
}
pub impl F64 as Format {
    fn format(format: String) -> String { return floatToString(value: self) }
}
pub impl F32 as Format {
    // F32 is represented as double for now, so widening to F64 is a no-op.
    fn format(format: String) -> String { return floatToString(value: self as F64) }
}
pub impl Bool as Format {
    // Bool prints as 1/0 (matching the integer lowering), not true/false.
    fn format(format: String) -> String {
        if self {
            return "1"
        } else {
            return "0"
        }
    }
}

pub impl String as Format {
    // A string formats as itself (the `format` spec is ignored for now, like the
    // integer impls). Without this conformance `print(s)` for a non-literal String
    // fails the `where T: Format` bound on `print` (spec/02).
    fn format(format: String) -> String {
        return self
    }
}

// String concatenation (spec/02,12): `"a" + "b"` produces a NEW String over the
// joined bytes. Plew's String is a CoW value type with no owned/borrowed split, so
// `String + String -> String` is symmetric (unlike Rust's `String + &str`). The
// builder remains the efficient path for repeated `s = s + …` (avoids O(n²)); this
// is the convenient binary form. Built in pure Plew over the `bytes` view.
pub impl String as Add[String] {
    type Output = String
    assoc fn add(lhs: String, rhs: String) -> String {
        mut val out: Array[U8] = lhs.bytes
        val rb: Array[U8] = rhs.bytes
        mut val i: U64 = 0
        while i < rb.count {
            out.append(value: rb[i])
            i = i + 1U64
        }
        return stringFromBytesUnchecked(out)
    }
}

// The error of a fallible numeric conversion (spec/12 TryFrom): carries the
// out-of-range source value that could not be represented in the narrower target.
export struct RangeError {
    pub val value: I64
}

// Failure-possible conversion (spec/12): `convert` is a fallible factory yielding
// `Result[Self, Error]`. `as` (From) is total; `TryFrom` covers narrowing/parsing
// where some inputs can't be represented. `Error` is an associated type the impl
// picks. Used here for primitive integer narrowing.
export trait TryFrom[Source] {
    type Error
    result[Error] factory convert(from: Source)
}

// Fallible narrowing conversions (spec/12): `<I8.convert from=big/>` yields
// `Result[I8, RangeError]`. `as` is infallible/total only (rejects narrowing), so a
// value that may not fit is a named `convert` factory that range-checks first and
// truncates only once proven in range (`truncI8`).
pub impl I8 as TryFrom[I64] {
    type Error = RangeError
    result[RangeError] factory convert(from: I64) {
        if from < -128I64 {
            return <Result[I8, RangeError].Err error=<RangeError value=from /> />
        }
        if from > 127I64 {
            return <Result[I8, RangeError].Err error=<RangeError value=from /> />
        }
        return <Result[I8, RangeError].Ok value=truncI8(n: from) />
    }
}
pub impl I16 as TryFrom[I64] {
    type Error = RangeError
    result[RangeError] factory convert(from: I64) {
        if from < -32768I64 {
            return <Result[I16, RangeError].Err error=<RangeError value=from /> />
        }
        if from > 32767I64 {
            return <Result[I16, RangeError].Err error=<RangeError value=from /> />
        }
        return <Result[I16, RangeError].Ok value=truncI16(n: from) />
    }
}
pub impl I32 as TryFrom[I64] {
    type Error = RangeError
    result[RangeError] factory convert(from: I64) {
        if from < -2147483648I64 {
            return <Result[I32, RangeError].Err error=<RangeError value=from /> />
        }
        if from > 2147483647I64 {
            return <Result[I32, RangeError].Err error=<RangeError value=from /> />
        }
        return <Result[I32, RangeError].Ok value=truncI32(n: from) />
    }
}
// Unsigned narrowing from U64 (spec/12): no floor check (unsigned), only the upper
// bound. `RangeError.value` is signed; the offending magnitude fits when it overflows
// the narrower type but here it can exceed I64.max only for values above 2^63 — those
// still report (the field wraps via the same two's-complement bits).
pub impl U8 as TryFrom[U64] {
    type Error = RangeError
    result[RangeError] factory convert(from: U64) {
        if from > 255U64 {
            return <Result[U8, RangeError].Err error=<RangeError value=0I64 /> />
        }
        return <Result[U8, RangeError].Ok value=truncU8(n: from) />
    }
}
pub impl U16 as TryFrom[U64] {
    type Error = RangeError
    result[RangeError] factory convert(from: U64) {
        if from > 65535U64 {
            return <Result[U16, RangeError].Err error=<RangeError value=0I64 /> />
        }
        return <Result[U16, RangeError].Ok value=truncU16(n: from) />
    }
}
pub impl U32 as TryFrom[U64] {
    type Error = RangeError
    result[RangeError] factory convert(from: U64) {
        if from > 4294967295U64 {
            return <Result[U32, RangeError].Err error=<RangeError value=0I64 /> />
        }
        return <Result[U32, RangeError].Ok value=truncU32(n: from) />
    }
}

// Fallible float->int conversions (spec/12: `F64->I32` is a TryFrom example). `as`
// rejects float->int (it would truncate the fraction), so the lossy conversion is the
// named `convert`: it TRUNCATES TOWARD ZERO (3.7 -> 3, -3.7 -> -3 — the universal
// convention) and fails ONLY when the result is out of the target's range or the
// input is NaN/±inf. NaN is tested first (float `==`/`<` panic on NaN, spec/02). The
// narrow targets truncate within I64 first (safe `f64ToI64`), then integer-range-check.
pub impl I64 as TryFrom[F64] {
    type Error = RangeError
    result[RangeError] factory convert(from: F64) {
        if isNanF64(f: from) {
            return <Result[I64, RangeError].Err error=<RangeError value=0I64 /> />
        }
        // outside [-2^63, 2^63) (±inf included): not representable in I64.
        if from < -9223372036854775808.0 {
            return <Result[I64, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from >= 9223372036854775808.0 {
            return <Result[I64, RangeError].Err error=<RangeError value=0I64 /> />
        }
        return <Result[I64, RangeError].Ok value=f64ToI64(f: from) />
    }
}
pub impl I32 as TryFrom[F64] {
    type Error = RangeError
    result[RangeError] factory convert(from: F64) {
        if isNanF64(f: from) {
            return <Result[I32, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from < -9223372036854775808.0 {
            return <Result[I32, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from >= 9223372036854775808.0 {
            return <Result[I32, RangeError].Err error=<RangeError value=0I64 /> />
        }
        val n: I64 = f64ToI64(f: from)
        if n < -2147483648I64 {
            return <Result[I32, RangeError].Err error=<RangeError value=n /> />
        }
        if n > 2147483647I64 {
            return <Result[I32, RangeError].Err error=<RangeError value=n /> />
        }
        return <Result[I32, RangeError].Ok value=truncI32(n: n) />
    }
}
pub impl I16 as TryFrom[F64] {
    type Error = RangeError
    result[RangeError] factory convert(from: F64) {
        if isNanF64(f: from) {
            return <Result[I16, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from < -9223372036854775808.0 {
            return <Result[I16, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from >= 9223372036854775808.0 {
            return <Result[I16, RangeError].Err error=<RangeError value=0I64 /> />
        }
        val n: I64 = f64ToI64(f: from)
        if n < -32768I64 {
            return <Result[I16, RangeError].Err error=<RangeError value=n /> />
        }
        if n > 32767I64 {
            return <Result[I16, RangeError].Err error=<RangeError value=n /> />
        }
        return <Result[I16, RangeError].Ok value=truncI16(n: n) />
    }
}
pub impl I8 as TryFrom[F64] {
    type Error = RangeError
    result[RangeError] factory convert(from: F64) {
        if isNanF64(f: from) {
            return <Result[I8, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from < -9223372036854775808.0 {
            return <Result[I8, RangeError].Err error=<RangeError value=0I64 /> />
        }
        if from >= 9223372036854775808.0 {
            return <Result[I8, RangeError].Err error=<RangeError value=0I64 /> />
        }
        val n: I64 = f64ToI64(f: from)
        if n < -128I64 {
            return <Result[I8, RangeError].Err error=<RangeError value=n /> />
        }
        if n > 127I64 {
            return <Result[I8, RangeError].Err error=<RangeError value=n /> />
        }
        return <Result[I8, RangeError].Ok value=truncI8(n: n) />
    }
}

// The error of a failed UTF-8 validation (spec/02: a String is UTF-8-valid by
// construction). `index` is the byte offset of the first ill-formed byte.
export struct Utf8Error {
    pub val index: U64
}

// Whether byte `b` is a UTF-8 continuation byte (0x80..=0xBF).
fn utf8IsCont(b: U8) -> Bool {
    return b >= 0x80U8 && b <= 0xBFU8
}

// The byte offset of the first ill-formed byte in `bytes` under the Unicode
// well-formed-UTF-8 table (rejects overlong forms, surrogates U+D800..U+DFFF, and
// code points > U+10FFFF), or `bytes.count` when the whole sequence is valid.
fn utf8FirstInvalid(bytes: Array[U8]) -> U64 {
    val n: U64 = bytes.count
    mut val i: U64 = 0
    while i < n {
        val b0: U8 = bytes[i]
        if b0 <= 0x7FU8 {
            i = i + 1U64
        } else {
            if b0 >= 0xC2U8 && b0 <= 0xDFU8 {
                // 2-byte sequence.
                if i + 1U64 >= n { return i }
                if utf8IsCont(b: bytes[i + 1U64]) { } else { return i }
                i = i + 2U64
            } else {
                if b0 >= 0xE0U8 && b0 <= 0xEFU8 {
                    // 3-byte sequence; the first continuation's range is tightened for
                    // E0 (no overlong) and ED (no surrogates).
                    if i + 2U64 >= n { return i }
                    val b1: U8 = bytes[i + 1U64]
                    mut val lo1: U8 = 0x80U8
                    mut val hi1: U8 = 0xBFU8
                    if b0 == 0xE0U8 { lo1 = 0xA0U8 }
                    if b0 == 0xEDU8 { hi1 = 0x9FU8 }
                    if b1 >= lo1 && b1 <= hi1 { } else { return i }
                    if utf8IsCont(b: bytes[i + 2U64]) { } else { return i }
                    i = i + 3U64
                } else {
                    if b0 >= 0xF0U8 && b0 <= 0xF4U8 {
                        // 4-byte sequence; the first continuation's range is tightened for
                        // F0 (no overlong) and F4 (cap at U+10FFFF).
                        if i + 3U64 >= n { return i }
                        val b1: U8 = bytes[i + 1U64]
                        mut val lo1: U8 = 0x80U8
                        mut val hi1: U8 = 0xBFU8
                        if b0 == 0xF0U8 { lo1 = 0x90U8 }
                        if b0 == 0xF4U8 { hi1 = 0x8FU8 }
                        if b1 >= lo1 && b1 <= hi1 { } else { return i }
                        if utf8IsCont(b: bytes[i + 2U64]) { } else { return i }
                        if utf8IsCont(b: bytes[i + 3U64]) { } else { return i }
                        i = i + 4U64
                    } else {
                        // a stray continuation byte, an overlong lead (C0/C1), or an
                        // out-of-range lead (F5..FF).
                        return i
                    }
                }
            }
        }
    }
    return n
}

// Validated `Array[U8]` -> `String` (spec/02,12): `<String.convert from=bytes/>` yields
// `Result[String, Utf8Error]`. This is the safe public constructor; the unchecked floor
// `stringFromBytesUnchecked` is the escape hatch for already-known-valid bytes.
pub impl String as TryFrom[Array[U8]] {
    type Error = Utf8Error
    result[Utf8Error] factory convert(from: Array[U8]) {
        val bad: U64 = utf8FirstInvalid(bytes: from)
        if bad == from.count {
            return <Result[String, Utf8Error].Ok value=stringFromBytesUnchecked(from) />
        }
        return <Result[String, Utf8Error].Err error=<Utf8Error index=bad /> />
    }
}

// The error of a failed string-to-number parse (spec/12 TryFrom): carries the input
// that could not be parsed (empty, a non-digit, a lone sign, or out of range).
export struct ParseError {
    pub val input: String
}

// Parse a decimal string to `I64` (spec/12 TryFrom): `<I64.convert from="-42"/>`
// yields `Result[I64, ParseError]`. Accumulates in NEGATIVE space (so `I64.min`, whose
// magnitude exceeds `I64.max`, is representable) and rejects overflow BEFORE it would
// panic — the checked `*`/`-` never see an out-of-range intermediate. An empty string,
// a lone sign, or a non-`0..9` byte is a parse error.
pub impl I64 as TryFrom[String] {
    type Error = ParseError
    result[ParseError] factory convert(from: String) {
        val bs: Array[U8] = from.bytes
        if bs.count == 0U64 {
            return <Result[I64, ParseError].Err error=<ParseError input=from /> />
        }
        mut val i: U64 = 0
        mut val neg: Bool = false
        if bs[0] == 45U8 {
            neg = true
            i = 1U64
        } else {
            if bs[0] == 43U8 {
                i = 1U64
            }
        }
        if i >= bs.count {
            return <Result[I64, ParseError].Err error=<ParseError input=from /> />
        }
        mut val acc: I64 = 0I64
        while i < bs.count {
            val b: U8 = bs[i]
            if b < 48U8 {
                return <Result[I64, ParseError].Err error=<ParseError input=from /> />
            }
            if b > 57U8 {
                return <Result[I64, ParseError].Err error=<ParseError input=from /> />
            }
            val d: I64 = (b - 48U8) as I64
            // acc is <= 0; going more negative as acc*10 - d. Overflow (below I64.min)
            // when acc < (min + d) / 10 — checked before the multiply so `*` never panics.
            if acc < (-9223372036854775808I64 + d) / 10I64 {
                return <Result[I64, ParseError].Err error=<ParseError input=from /> />
            }
            acc = acc * 10I64 - d
            i = i + 1U64
        }
        if neg {
            return <Result[I64, ParseError].Ok value=acc />
        }
        // a positive value is the negation of the accumulator; only I64.min can't be
        // negated (its positive is out of range).
        if acc == -9223372036854775808I64 {
            return <Result[I64, ParseError].Err error=<ParseError input=from /> />
        }
        return <Result[I64, ParseError].Ok value=0I64 - acc />
    }
}
