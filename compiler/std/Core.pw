// @Std/Core — the Plew core library (pure Plew).
//
// Optional and Result are the canonical "maybe a value" / "value or error"
// types. They are ordinary generic enums; the compiler monomorphizes each
// concrete instantiation (`Optional[I32]`, `Result[I32, String]`, ...) and the
// methods below per instantiation. (Spec makes these ambient; for now a program
// imports them explicitly with `import @Std/Core`.)

// An optional value: `Some` holds a `T`, `None` holds nothing.
enum Optional[T] {
    Some { val v: T }
    None
}

impl[T] Optional[T] {
    // Is this `Some`?
    fn isSome() -> Bool {
        match self {
            Optional.Some { val v } => { return true }
            Optional.None => { return false }
        }
    }
    // Is this `None`?
    fn isNone() -> Bool {
        match self {
            Optional.Some { val v } => { return false }
            Optional.None => { return true }
        }
    }
    // The contained value, or `fallback` when `None`.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Optional.Some { val v } => { return v }
            Optional.None => { return fallback }
        }
    }
    // The contained value; panics when `None`.
    fn unwrap() -> T {
        match self {
            Optional.Some { val v } => { return v }
            Optional.None => { panic "called unwrap on a None Optional" }
        }
    }
}

// The result of a fallible operation: `Ok` holds a `T`, `Err` holds an `E`.
enum Result[T, E] {
    Ok { val value: T }
    Err { val error: E }
}

impl[T, E] Result[T, E] {
    // Is this `Ok`?
    fn isOk() -> Bool {
        match self {
            Result.Ok { val value } => { return true }
            Result.Err { val error } => { return false }
        }
    }
    // Is this `Err`?
    fn isErr() -> Bool {
        match self {
            Result.Ok { val value } => { return false }
            Result.Err { val error } => { return true }
        }
    }
    // The success value, or `fallback` when `Err`.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Result.Ok { val value } => { return value }
            Result.Err { val error } => { return fallback }
        }
    }
    // The success value; panics when `Err`.
    fn unwrap() -> T {
        match self {
            Result.Ok { val value } => { return value }
            Result.Err { val error } => { panic "called unwrap on an Err Result" }
        }
    }
}

// assert(cond:) panics when the condition is false (spec/11: always on, all
// builds). Returns (). NOTE: spec writes the condition unlabeled — `assert(x>0)`
// — via label suppression `~:`, which the compiler does not yet support in
// parameter declarations, so the condition takes a `cond:` label for now (see
// autonomous-decisions.md). An optional `message:` arg is future work.
fn assert(cond: Bool) {
    if cond {
    } else {
        panic "assertion failed"
    }
}
