// @Std/Core — the Plew core library (pure Plew).
//
// Optional and Result are the canonical "maybe a value" / "value or error"
// types. They are ordinary generic enums; the compiler monomorphizes each
// concrete instantiation (`Optional[I32]`, `Result[I32, String]`, ...) and the
// methods below per instantiation. (Spec makes these ambient; for now a program
// imports them explicitly with `import @Std/Core`.)

// An optional value: `Some` holds a `T`, `None` holds nothing.
enum Optional[T] {
    Some(v: T)
    None
}

pub impl[T] Optional[T] {
    // Is this `Some`?
    fn isSome() -> Bool {
        match self {
            Optional.Some(val v) => { return true }
            Optional.None => { return false }
        }
    }
    // Is this `None`?
    fn isNone() -> Bool {
        match self {
            Optional.Some(val v) => { return false }
            Optional.None => { return true }
        }
    }
    // The contained value, or `fallback` when `None`.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { return fallback }
        }
    }
    // The contained value; panics when `None`.
    fn unwrap() -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { panic "called unwrap on a None Optional" }
        }
    }
}

// The iteration protocol (spec/02,11). `Iterator` produces values one at a
// time: `next` advances the iterator (mutating self, hence `inout`) and yields
// `Some(v)` until exhausted, then `None` forever. `Iterable` is a type that can
// produce a fresh iterator over its elements; `for x in xs` desugars to
// `it = xs.iterator(); while { match it.next() { Some(v) => …; None => break } }`
// (the compiler keeps a fast path for the built-in Array/Range iterands). The
// associated `Item` is the element type; `Iter` is the concrete iterator type.
export trait Iterator {
    type Item
    inout next() -> Optional[Item]
}

export trait Iterable {
    type Item
    type Iter
    fn iterator() -> Iter
}

// The result of a fallible operation: `Ok` holds a `T`, `Err` holds an `E`.
enum Result[T, E] {
    Ok(value: T)
    Err(error: E)
}

pub impl[T, E] Result[T, E] {
    // Is this `Ok`?
    fn isOk() -> Bool {
        match self {
            Result.Ok(val value) => { return true }
            Result.Err(val error) => { return false }
        }
    }
    // Is this `Err`?
    fn isErr() -> Bool {
        match self {
            Result.Ok(val value) => { return false }
            Result.Err(val error) => { return true }
        }
    }
    // The success value, or `fallback` when `Err`.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Result.Ok(val value) => { return value }
            Result.Err(val error) => { return fallback }
        }
    }
    // The success value; panics when `Err`.
    fn unwrap() -> T {
        match self {
            Result.Ok(val value) => { return value }
            Result.Err(val error) => { panic "called unwrap on an Err Result" }
        }
    }
}

// assert(x > 0) / assert(x > 0, message: "...") panics when the condition is
// false (spec/11: always on, all builds). Returns (). The condition is
// label-suppressed (`cond~:`, positional); the diagnostic message is an
// optional labelled argument with a default.
export fn assert(cond~: Bool, message: String = "assertion failed") {
    if cond {
    } else {
        panic message
    }
}

// --- lang-item primitive type declarations (spec/15 core-library boundary) ---
// Opaque intrinsic types (representation is the compiler's int*_t / PlewString
// mapping); declaring them here makes Core their owner, so Core may coherently
// `impl` traits for them (spec/07,09 type-ownership).
extern "plew-intrinsic" {
    struct I8   struct I16  struct I32  struct I64
    struct U8   struct U16  struct U32  struct U64
    struct Bool struct String
}

// Build a String from a byte array (the bytes must be valid UTF-8; decimal
// digits always are). Runtime-provided: `plew_stringFromBytes`.
extern "plew-intrinsic" {
    fn stringFromBytes(b~: Array[U8]) -> String
}

// String methods, written in pure Plew over the exposed `bytes` view (spec/02:
// `String` is an owned lang-item that Core owns, so it carries inherent methods).
pub impl String {
    // Is the string empty (zero bytes)?
    fn isEmpty() -> Bool {
        return self.bytes.count == 0
    }
}

// A decimal digit (0-9) as its ASCII byte. Two width-typed copies: with no
// implicit numeric conversion an I64 digit cannot call a U64 helper (and `48+d`
// would need a forbidden cast), so each spells out the glyph table.
fn digitByteI(d: I64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}
fn digitByteU(d: U64) -> U8 {
    if d == 0 { return 48 }
    if d == 1 { return 49 }
    if d == 2 { return 50 }
    if d == 3 { return 51 }
    if d == 4 { return 52 }
    if d == 5 { return 53 }
    if d == 6 { return 54 }
    if d == 7 { return 55 }
    if d == 8 { return 56 }
    return 57
}

// Textual formatting (spec/02): `{x}` interpolation desugars to x.format(format:).
// The `format` spec string (e.g. ".2") is accepted but ignored for integers for
// now (no precision/padding yet — additive).
export trait Format {
    fn format(format: String) -> String
}

pub impl I64 as Format {
    fn format(format: String) -> String {
        mut val n: I64 = self
        mut val neg: Bool = false
        if n < 0 {
            neg = true
        }
        // collect digits least-significant-first (works in I64: a negative
        // remainder is flipped, avoiding any I64->U64 magnitude conversion).
        mut val digits: Array[U8] = []
        if n == 0 {
            digits.append(48)
        }
        while n != 0 {
            mut val d: I64 = n % 10
            if d < 0 {
                d = 0 - d
            }
            digits.append(digitByteI(d: d))
            n = n / 10
        }
        mut val out: Array[U8] = []
        if neg {
            out.append(45)
        }
        mut val i: U64 = digits.count
        while i > 0 {
            i = i - 1
            out.append(digits[i])
        }
        return stringFromBytes(out)
    }
}

pub impl U64 as Format {
    fn format(format: String) -> String {
        mut val n: U64 = self
        mut val digits: Array[U8] = []
        if n == 0 {
            digits.append(48)
        }
        while n != 0 {
            val d: U64 = n % 10
            digits.append(digitByteU(d: d))
            n = n / 10
        }
        mut val out: Array[U8] = []
        mut val i: U64 = digits.count
        while i > 0 {
            i = i - 1
            out.append(digits[i])
        }
        return stringFromBytes(out)
    }
}

// The narrower integer types delegate to the 64-bit formatters via a lossless
// widening (`as` allows signed->wider-signed and unsigned->wider-unsigned).
pub impl I8 as Format {
    fn format(format: String) -> String { return (self as I64).format(format: format) }
}
pub impl I16 as Format {
    fn format(format: String) -> String { return (self as I64).format(format: format) }
}
pub impl I32 as Format {
    fn format(format: String) -> String { return (self as I64).format(format: format) }
}
pub impl U8 as Format {
    fn format(format: String) -> String { return (self as U64).format(format: format) }
}
pub impl U16 as Format {
    fn format(format: String) -> String { return (self as U64).format(format: format) }
}
pub impl U32 as Format {
    fn format(format: String) -> String { return (self as U64).format(format: format) }
}
pub impl Bool as Format {
    // Bool prints as 1/0 (matching the integer lowering), not true/false.
    fn format(format: String) -> String {
        if self {
            return "1"
        } else {
            return "0"
        }
    }
}
