// @Std/Prelude — the implicit prelude, auto-loaded into every program (no import,
// like the ambient lang-item types). It carries `Array`'s definition and methods.
// Keeping them here (not in `@Std/Core`) preserves their ambience: `xs.append(v)`
// / `xs.get(i: …)` need no import, just like the `Array` type and `[…]` literals.

// `Array[T]` is a value-semantics (CoW) struct over the `RawBuffer[T]` floor: the
// growable buffer (whose `[cap][rc]` header carries capacity and the CoW
// refcount) plus the live element `count`. This is the type literals `[…]`,
// indexing `[i]`, and `for` lower to; the compiler still special-cases that lang
// syntax and Array's value semantics (deep, count+element-aware), while the C
// struct shape comes from this declaration (spec/02,05). `pub(get)` exposes
// `.count` for reading while keeping it module-writable.
struct Array[T] {
    mut val data: RawBuffer[T]
    pub(get) mut val count: U64
}

// The array intrinsic floor (spec/02): lowered by the compiler to the per-element
// runtime `Array_<E>_<op>` / inline buffer ops. The element type E is recovered
// from the first `Array[T]` argument (the compiler knows these names).
extern "plew-intrinsic" {
    fn arrayPush[T](a: inout Array[T], v: T)
    fn arrayGet[T](a: Array[T], i: U64) -> T
    fn arraySet[T](a: inout Array[T], i: U64, v: T)
    fn arrayLen[T](a: Array[T]) -> U64
    // The per-process dictionary hash seed: a random value chosen once per run (lazily,
    // from the OS), stable thereafter. Keys SipHash so a map's layout is unpredictable
    // across runs (DoS resistance) yet consistent within a run. Internal to the dict
    // lang item (`entropyU64` in @Std/Random is the user-facing entropy source).
    fn __dictSeed() -> U64
}

// Methods on the builtin Array, in pure Plew over the floor above. Monomorphized
// per element type and dispatched by name (emitArrayMethods).
pub impl[T] Array[T] {
    // Append `value` to the end (growing the storage as needed).
    inout fn append(value~: T) {
        arrayPush(a: inout self, v: value)
    }
    // The element at `i` (panics when out of range — same as `xs[i]`).
    fn get(i: U64) -> T {
        return arrayGet(a: self, i: i)
    }
    // Replace the element at `i` (panics when out of range).
    inout fn set(i: U64, value: T) {
        arraySet(a: inout self, i: i, v: value)
    }
}

// --- Hashing (spec/02): `Hash`/`Hasher` are referenced by the `[k:v]` dictionary
// literal's key bound (`K: Hash`), so they live in the ambient prelude like
// `Array`/`Dictionary`. Algorithm = SipHash-1-3 (same as Rust's default), with a
// FIXED key for now — Plew has no RNG yet; switch to a per-map random seed once
// `Random` lands (worklog 🔴 TODO). Until then hashing is deterministic (harmless:
// iteration order is unspecified, and compiler-internal maps want determinism).

// A streaming hasher absorbs U64 words and finalizes to a U64 digest.
trait Hasher {
    inout fn writeU64(n: U64)
    fn finish() -> U64
}

// A type is hashable by feeding its value into a hasher (generic over the hasher
// `H`, so a map picks the algorithm). The `@[Hash]` derive synthesizes this for a
// struct/enum by hashing each field; primitives and `String` are hand-written below.
trait Hash {
    fn hash[H](hasher: inout H) where H: Hasher
}

// Rotate-left for U64 (shifts don't overflow-panic; b is always in 1..63 here).
fn rotlU64(x: U64, b: U64) -> U64 {
    return (x << b) | (x >> (64U64 - b))
}

// SipHash-1-3 state (four 64-bit words). Fixed key k0=k1=0 → the standard init
// constants below. `new()` seeds it; `round()` is one SipRound mixing step.
struct SipHasher {
    mut val v0: U64
    mut val v1: U64
    mut val v2: U64
    mut val v3: U64
}
pub impl SipHasher {
    // Keyed init: the standard SipHash base constants XOR the per-process random key
    // (`k0 = k1 = __dictSeed()`), so the digest stream differs per run. A zero seed
    // (the lazy init never ran) reproduces the unkeyed standard constants — the prior
    // deterministic behavior, a safe fallback.
    assoc fn new() -> SipHasher {
        val k: U64 = __dictSeed()
        return <SipHasher v0=(8317987319222330741U64 ^ k) v1=(7237128888997146477U64 ^ k) v2=(7816392313619706465U64 ^ k) v3=(8387220255154660723U64 ^ k) />
    }
    inout fn round() {
        self.v0 = self.v0.wrappingAdd(by: self.v1)
        self.v1 = rotlU64(x: self.v1, b: 13U64)
        self.v1 = self.v1 ^ self.v0
        self.v0 = rotlU64(x: self.v0, b: 32U64)
        self.v2 = self.v2.wrappingAdd(by: self.v3)
        self.v3 = rotlU64(x: self.v3, b: 16U64)
        self.v3 = self.v3 ^ self.v2
        self.v0 = self.v0.wrappingAdd(by: self.v3)
        self.v3 = rotlU64(x: self.v3, b: 21U64)
        self.v3 = self.v3 ^ self.v0
        self.v2 = self.v2.wrappingAdd(by: self.v1)
        self.v1 = rotlU64(x: self.v1, b: 17U64)
        self.v1 = self.v1 ^ self.v2
        self.v2 = rotlU64(x: self.v2, b: 32U64)
    }
}
pub impl SipHasher as Hasher {
    // SipHash-1-3: 1 compression round per absorbed word.
    inout fn writeU64(n: U64) {
        self.v3 = self.v3 ^ n
        self.round()
        self.v0 = self.v0 ^ n
    }
    // SipHash-1-3: 3 finalization rounds (on a copy — `finish` doesn't consume).
    fn finish() -> U64 {
        mut val s: SipHasher = self
        s.v2 = s.v2 ^ 255U64
        s.round()
        s.round()
        s.round()
        return ((s.v0 ^ s.v1) ^ s.v2) ^ s.v3
    }
}

// Primitive + String conformances (the leaves a derived struct/enum hash bottoms
// out at). Unsigned integers narrower than 64 bits widen losslessly to U64 via `as`,
// so they hash through `writeU64`. Signed integers await a bit-reinterpret (`as` is
// lossless-only, so a negative value can't be retagged to U64) — added when needed.
pub impl U64 as Hash {
    fn hash[H](hasher: inout H) where H: Hasher {
        hasher.writeU64(n: self)
    }
}
pub impl U32 as Hash {
    fn hash[H](hasher: inout H) where H: Hasher {
        hasher.writeU64(n: self as U64)
    }
}
pub impl U16 as Hash {
    fn hash[H](hasher: inout H) where H: Hasher {
        hasher.writeU64(n: self as U64)
    }
}
pub impl U8 as Hash {
    fn hash[H](hasher: inout H) where H: Hasher {
        hasher.writeU64(n: self as U64)
    }
}
// `Bool` Hash awaits Bool primitive method dispatch (the backend dispatches trait
// methods only on integer-primitive / struct / enum receivers so far, not Bool).
pub impl String as Hash {
    fn hash[H](hasher: inout H) where H: Hasher {
        val bs: Array[U8] = self.bytes
        val n: U64 = bs.count
        mut val i: U64 = 0
        mut val word: U64 = 0
        mut val shift: U64 = 0
        while i < n {
            word = word | ((bs[i] as U64) << shift)
            shift = shift + 8U64
            if shift == 64U64 {
                hasher.writeU64(n: word)
                word = 0U64
                shift = 0U64
            }
            i = i + 1
        }
        if shift > 0U64 {
            hasher.writeU64(n: word)
        }
        hasher.writeU64(n: n)
    }
}

// --- Dictionary[K, V] (spec/02): a CoW value-semantics hash map, ambient lang
// item (the `[k: v]` / `[:]` literals lower to it). Built on `Array` (so CoW +
// value semantics come for free via Array's buffer sharing): parallel `keys`/
// `vals`/`hashes` hold the entries densely, and `buckets` is an open-addressing
// index map (slot -> entry index + 1; 0 = empty) for O(1) lookup. Keys need
// `Hash` (to place) and `Eq` (to resolve collisions). Algorithm = linear
// probing, growing at load 0.75. Seed is fixed for now (see worklog RNG TODO).
// `get(key:) -> Optional[V]` is the safe lookup; `getOr`/`contains`/the
// missing-key-panicking `at` (what `dict[k]` lowers to) round out the surface.
struct Dictionary[K, V] {
    mut val keys: Array[K]
    mut val vals: Array[V]
    mut val hashes: Array[U64]
    mut val buckets: Array[U64]
    pub(get) mut val count: U64
}
pub impl[K, V] Dictionary[K, V] {
    // SipHash digest of a key (fixed seed for now — see worklog RNG TODO).
    fn hashOf(key: K) -> U64 where K: Hash {
        mut val h: SipHasher = SipHasher.new()
        key.hash(hasher: inout h)
        return h.finish()
    }
    // Resize the bucket index (double, or 8 from empty) and re-place every entry
    // by its stored hash. Entry order is preserved (dense arrays untouched).
    inout fn grow() where K: Hash {
        mut val newCap: U64 = 8U64
        if self.buckets.count > 0U64 {
            newCap = self.buckets.count * 2U64
        }
        mut val nb: Array[U64] = []
        mut val j: U64 = 0
        while j < newCap {
            nb.append(value: 0U64)
            j = j + 1U64
        }
        mut val i: U64 = 0
        while i < self.keys.count {
            val code: U64 = self.hashes[i]
            mut val slot: U64 = code & (newCap - 1U64)
            while nb[slot] != 0U64 {
                slot = (slot + 1U64) & (newCap - 1U64)
            }
            nb.set(i: slot, value: i + 1U64)
            i = i + 1U64
        }
        self.buckets = nb
    }
    // Insert or update `key -> value`.
    inout fn insert(key: K, value: V) where K: Hash, K: Eq {
        if self.buckets.count == 0U64 {
            self.grow()
        } else {
            if (self.count + 1U64) * 4U64 > self.buckets.count * 3U64 {
                self.grow()
            }
        }
        val code: U64 = self.hashOf(key: key)
        val cap: U64 = self.buckets.count
        mut val slot: U64 = code & (cap - 1U64)
        while true {
            val b: U64 = self.buckets[slot]
            if b == 0U64 {
                self.keys.append(value: key)
                self.vals.append(value: value)
                self.hashes.append(value: code)
                self.buckets.set(i: slot, value: self.keys.count)
                self.count = self.count + 1U64
                return
            }
            val idx: U64 = b - 1U64
            if self.hashes[idx] == code {
                if self.keys[idx] == key {
                    self.vals.set(i: idx, value: value)
                    return
                }
            }
            slot = (slot + 1U64) & (cap - 1U64)
        }
    }
    // Entry index + 1 for `key` (0 = absent).
    fn find(key: K) -> U64 where K: Hash, K: Eq {
        if self.buckets.count == 0U64 {
            return 0U64
        }
        val code: U64 = self.hashOf(key: key)
        val cap: U64 = self.buckets.count
        mut val slot: U64 = code & (cap - 1U64)
        while true {
            val b: U64 = self.buckets[slot]
            if b == 0U64 {
                return 0U64
            }
            val idx: U64 = b - 1U64
            if self.hashes[idx] == code {
                if self.keys[idx] == key {
                    return b
                }
            }
            slot = (slot + 1U64) & (cap - 1U64)
        }
        return 0U64
    }
    // Whether `key` is present.
    fn contains(key: K) -> Bool where K: Hash, K: Eq {
        return self.find(key: key) != 0U64
    }
    // The value for `key` as `Some(v)`, or `None` if absent (spec/02 — the safe,
    // non-panicking lookup; `dict[key]` panics on a missing key, `get` does not).
    fn get(key: K) -> Optional[V] where K: Hash, K: Eq {
        val b: U64 = self.find(key: key)
        if b == 0U64 {
            return <Optional.None />
        }
        return <Optional.Some v=self.vals[b - 1U64] />
    }
    // The value for `key`, or `fallback` if absent (non-panicking lookup).
    fn getOr(key: K, fallback: V) -> V where K: Hash, K: Eq {
        val b: U64 = self.find(key: key)
        if b == 0U64 {
            return fallback
        }
        return self.vals[b - 1U64]
    }
    // The value for `key`; panics if absent (what `dict[key]` lowers to — spec/02).
    fn at(key: K) -> V where K: Hash, K: Eq {
        val b: U64 = self.find(key: key)
        if b == 0U64 {
            panic "dictionary: key not found"
        }
        return self.vals[b - 1U64]
    }
}
