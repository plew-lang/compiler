// @Std/Prelude — the implicit prelude, auto-loaded into every program (no import,
// like the ambient lang-item types). It carries `Array`'s definition and methods.
// Keeping them here (not in `@Std/Core`) preserves their ambience: `xs.append(v)`
// / `xs.get(i: …)` need no import, just like the `Array` type and `[…]` literals.

// `Array[T]` is a value-semantics (CoW) struct over the `RawBuffer[T]` floor: the
// growable buffer (whose `[cap][rc]` header carries capacity and the CoW
// refcount) plus the live element `count`. This is the type literals `[…]`,
// indexing `[i]`, and `for` lower to; the compiler still special-cases that lang
// syntax and Array's value semantics (deep, count+element-aware), while the C
// struct shape comes from this declaration (spec/02,05). `pub(get)` exposes
// `.count` for reading while keeping it module-writable.
struct Array[T] {
    mut val data: RawBuffer[T]
    pub(get) mut val count: U64
}

// The array intrinsic floor (spec/02): lowered by the compiler to the per-element
// runtime `Array_<E>_<op>` / inline buffer ops. The element type E is recovered
// from the first `Array[T]` argument (the compiler knows these names).
extern "plew-intrinsic" {
    fn arrayPush[T](a: inout Array[T], v: T)
    fn arrayGet[T](a: Array[T], i: U64) -> T
    fn arraySet[T](a: inout Array[T], i: U64, v: T)
    fn arrayLen[T](a: Array[T]) -> U64
}

// Methods on the builtin Array, in pure Plew over the floor above. Monomorphized
// per element type and dispatched by name (emitArrayMethods).
impl[T] Array[T] {
    // Append `value` to the end (growing the storage as needed).
    inout fn append(value~: T) {
        arrayPush(a: inout self, v: value)
    }
    // The element at `i` (panics when out of range — same as `xs[i]`).
    fn get(i: U64) -> T {
        return arrayGet(a: self, i: i)
    }
    // Replace the element at `i` (panics when out of range).
    inout fn set(i: U64, value: T) {
        arraySet(a: inout self, i: i, v: value)
    }
}
