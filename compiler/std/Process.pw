// @Std/Process — process arguments and termination (runtime intrinsics; see
// @Std/Io for the boundary mechanism).
extern "plew-intrinsic" {
    // Number of command-line arguments (argv count, including argv[0]).
    fn argCount() -> I64
    // The i-th command-line argument (empty when out of range).
    fn argAt(i~: I64) -> String
    // Terminate the process with the given exit code (does not return).
    fn exit(code: I64)
}
