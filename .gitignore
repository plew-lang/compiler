# bootstrap intermediates (bootstrap.sh emits these; the .seed.ll /
# .seed.runtime.c + src are tracked). bin/plewc itself is tracked.
/plewc0
/plewc.ll
/plewc.runtime.c
/plewc.check.ll
/plewc.check.runtime.c

# the dependency resolver binary (built on demand by `plew`; the source
# resolve/_.pw is tracked).
/plew-resolve

# scratch dir for local experiments (gen-harness builds, self-host checks, etc.)
/tmp/
/asan.ll
/asan.runtime.c
/plewc_asan
/plewc_asan.dSYM/

# Python helper bytecode
/__pycache__/

# Diagnostic compiler snapshots; canonical bin/plewc and bin/std are tracked.
/bin/plewc-*
