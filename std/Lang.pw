// @Std/Lang — THE ambient module (spec/15): its EXPORT SURFACE is the language's
// import-free set — the lang items, in scope EVERYWHERE without an `import`, the way
// `Optional`, `Result`, `[…]` literals, and `2 + 3` always have been. This is the one
// module you can point at for "what is import-free"; everything NOT exported here is
// import-required. Force-loaded first (Driver), so the foundational types resolve for
// Core/Hash/Prelude; its module id is the ambient axis of type visibility.
//
// This module is the ambient MANIFEST: the primitive scalar types are DEFINED in
// @Std/Core (alongside their operator/Format/Eq/Ord/TryFrom witnesses — type-owned
// coherence), and re-exported here so they are ambient. Optional/Result/Array/Dictionary
// are language-core types with no library home, so they are declared (and exported)
// directly here. Either way, what @Std/Lang exports IS the import-free surface.

// The `Dictionary` lang item (below) is built on hashing, which is NOT a language item
// (spec/15): its `K: Hash` bound and `SipHasher` resolve from @Std/Hash. `Array`'s
// storage floor `Buffer` is a non-ambient primitive imported from @Std/Core.
import @Std/Hash with { Hash, Hasher, SipHasher }
import @Std/Core with { Buffer, Index, IndexSet, Iterator, Iterable }

// Re-export the primitive scalar types from @Std/Core (where they are DEFINED, with
// their operator/conversion witnesses — coherent). The re-export makes them ambient:
// `@Std/Lang`'s export surface is the import-free set (spec/15). Their narrowing-TryFrom
// witnesses (`@[IntTryFrom]`) are generated into Core.gen.pw next to their declarations.
export @Std/Core with { I8, I16, I32, I64, U8, U16, U32, U64, F32, F64, Bool, String }

// The synthesized ambient intrinsics (spec/15): types the compiler produces from
// dedicated syntax — `a..<b`/`a...b` (the range types), `async fn … -> Promise[T]`, and
// `spawn` (→ JoinHandle). They have no library home (the compiler supplies both syntax
// and representation), so they are DECLARED opaque here, in the ambient module. Listed
// in spec/15's ambient set, so they belong in @Std/Lang's surface.
extern "plew-intrinsic" {
    struct HalfOpenRange  struct ClosedRange
    struct Promise[T]     struct JoinHandle[T]
}

// An optional value: `Some` holds a `T`, `None` holds nothing.
enum Optional[T] {
    Some(v: T)
    None
}

pub impl[T] Optional[T] {
    // Is this `Some`?
    fn isSome() -> Bool {
        match self {
            Optional.Some(val v) => { return true }
            Optional.None => { return false }
        }
    }
    // Is this `None`?
    fn isNone() -> Bool {
        match self {
            Optional.Some(val v) => { return false }
            Optional.None => { return true }
        }
    }
    // The contained value, or `fallback` when `None` (eager — `fallback` is always
    // evaluated). Overloaded by argument type with the lazy form below.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { return fallback }
        }
    }
    // The contained value, or `fallback()` when `None` (lazy — the closure runs only
    // on `None`). The explicit short-circuit form, replacing the removed `??`: the
    // deferred evaluation is visible as a closure `{ … }`, not hidden in an operator.
    fn unwrapOr(fallback: fn() -> T) -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { return fallback() }
        }
    }
    // The contained value; panics when `None`.
    fn unwrap() -> T {
        match self {
            Optional.Some(val v) => { return v }
            Optional.None => { panic "called unwrap on a None Optional" }
        }
    }
}

// The result of a fallible operation: `Ok` holds a `T`, `Err` holds an `E`.
enum Result[T, E] {
    Ok(value: T)
    Err(error: E)
}

pub impl[T, E] Result[T, E] {
    // Is this `Ok`?
    fn isOk() -> Bool {
        match self {
            Result.Ok(val value) => { return true }
            Result.Err(val error) => { return false }
        }
    }
    // Is this `Err`?
    fn isErr() -> Bool {
        match self {
            Result.Ok(val value) => { return false }
            Result.Err(val error) => { return true }
        }
    }
    // The success value, or `fallback` when `Err`.
    fn unwrapOr(fallback: T) -> T {
        match self {
            Result.Ok(val value) => { return value }
            Result.Err(val error) => { return fallback }
        }
    }
    // The success value; panics when `Err`.
    fn unwrap() -> T {
        match self {
            Result.Ok(val value) => { return value }
            Result.Err(val error) => { panic "called unwrap on an Err Result" }
        }
    }
}

// `Array[T]` is a value-semantics (CoW) struct over the `Buffer[T]` floor (`Buffer`
// is a non-ambient floor primitive imported from @Std/Core above): a single growable
// buffer whose heap header `[cap][count][rc]` carries capacity, the live element count,
// and the CoW refcount. Array holds NO count field of its own (buffer-floor.md §6) —
// `.count()` reads the buffer header (O(1)), so the Array value is a single pointer. This
// is the type literals `[…]`, indexing `[i]`, and `for` lower to; the compiler still
// special-cases that lang syntax and Array's value semantics (deep, count+element-aware).
struct Array[T] {
    mut val data: Buffer[T]
}

// Methods on the builtin Array, in pure Plew over its `data` Buffer floor (Array A:
// Array is an ordinary `struct { data: Buffer[T] }`, so its methods just forward to the
// Buffer floor — the inner `buffer*` intrinsics are lowered by function identity, and the
// dispatch rides the uniform generic-method path, no Array type-name branching).
pub impl[T] Array[T] {
    // An array over an existing buffer (O(1), shares storage via CoW). The memberwise
    // `<Array data=buf />` can't be used from another module (`data` is private), so this
    // is the blessed cross-module wrapper — e.g. `String.bytes()` viewing its `Buffer[U8]`
    // backing as an `Array[U8]`.
    factory overBuffer(buffer: Buffer[T]) {
        return <Array data=buffer />
    }
    // The number of live elements (O(1) — forwards to the buffer floor's count).
    fn count() -> U64 {
        return self.data.count()
    }
    // Append `value` to the end (growing the storage as needed).
    inout fn append(value~: T) {
        self.data.append(value)
    }
    // The element at `i` (panics when out of range — same as `xs[i]`).
    fn get(i: U64) -> T {
        return self.data.get(index: i)
    }
    // Replace the element at `i` (panics when out of range).
    inout fn set(i: U64, value: T) {
        self.data.set(index: i, value)
    }
    // Remove the last element (panics when empty). The storage keeps its capacity;
    // only the live `count` shrinks. Used by Dictionary/Set `remove` to compact the
    // dense entry arrays after a deletion. (The moved-out tail is dropped here.)
    inout fn removeLast() {
        self.data.removeLast()
    }
}
// The subscript witnesses (collections.md E3): `arr[i]` is the `Index` value read and
// `arr[i] = v` the `IndexSet` whole-element write — ordinary collection-trait methods over
// the Buffer floor, so the backend routes `[]` through the uniform witness path with no
// Array type-name branch. (Place-based element mutation `arr[i].field = v` / `inout arr[i]`
// keeps the place model, which addresses the backing directly.)
pub impl[T] Array[T] as Index[U64] {
    type Output = T
    fn index(key: U64) -> T {
        return self.get(i: key)
    }
}
pub impl[T] Array[T] as IndexSet[U64] {
    type Value = T
    inout fn indexSet(key: U64, value: T) {
        self.data.set(index: key, value)
    }
}
// The iteration witnesses (collections.md E3): `for x in arr` desugars to the `Iterable`
// protocol `it = arr.iterator(); while { match it.next() { Some(v) => …; None => break } }`,
// so the backend drives arrays through the same iterator path as any user `Iterable` — no
// Array type-name branch in the for-loop. ArrayIter holds the array (value semantics; the
// CoW buffer is shared, not copied — iteration does not mutate) and a cursor.
struct ArrayIter[T] {
    val arr: Array[T]
    mut val idx: U64
}
pub impl[T] ArrayIter[T] as Iterator {
    type Item = T
    inout fn next() -> Optional[T] {
        if self.idx < self.arr.count() {
            val v: T = self.arr.get(i: self.idx)
            self.idx = self.idx + 1U64
            return <Optional.Some v=v />
        }
        return <Optional.None />
    }
}
pub impl[T] Array[T] as Iterable {
    type Item = T
    type Iter = ArrayIter[T]
    fn iterator() -> ArrayIter[T] {
        return <ArrayIter arr=self idx=0U64 />
    }
}

// --- Dictionary[K, V] (spec/02): a CoW value-semantics hash map, ambient lang
// item (the `[k: v]` / `[:]` literals lower to it). Built on `Array` (so CoW +
// value semantics come for free via Array's buffer sharing): parallel `keys`/
// `vals`/`hashes` hold the entries densely, and `buckets` is an open-addressing
// index map (slot -> entry index + 1; 0 = empty) for O(1) lookup. Keys need
// `Hash` (to place) and `Eq` (to resolve collisions). Algorithm = linear
// probing, growing at load 0.75. Seed is fixed for now (see worklog RNG TODO).
// `get(key:) -> Optional[V]` is the safe lookup; `getOr`/`contains`/the
// missing-key-panicking `at` (what `dict[k]` lowers to) round out the surface.
struct Dictionary[K, V] {
    mut val keys: Buffer[K]
    mut val vals: Buffer[V]
    mut val hashes: Buffer[U64]
    mut val buckets: Buffer[U64]
    pub(get) mut val count: U64
}
pub impl[K, V] Dictionary[K, V] {
    // SipHash digest of a key (fixed seed for now — see worklog RNG TODO).
    fn hashOf(key: K) -> U64 where K: Hash {
        mut val h: SipHasher = SipHasher.new()
        key.hash(hasher: inout h)
        return h.finish()
    }
    // Resize the bucket index (double, or 8 from empty) and re-place every entry
    // by its stored hash. Entry order is preserved (dense arrays untouched).
    inout fn grow() where K: Hash {
        mut val newCap: U64 = 8U64
        if self.buckets.count() > 0U64 {
            newCap = self.buckets.count() * 2U64
        }
        mut val nb: Buffer[U64] = Buffer.new()
        mut val j: U64 = 0
        while j < newCap {
            nb.append(0U64)
            j = j + 1U64
        }
        mut val i: U64 = 0
        while i < self.keys.count() {
            val code: U64 = self.hashes[i]
            mut val slot: U64 = code & (newCap - 1U64)
            while nb[slot] != 0U64 {
                slot = (slot + 1U64) & (newCap - 1U64)
            }
            nb.set(index: slot, i + 1U64)
            i = i + 1U64
        }
        self.buckets = nb
    }
    // Insert or update `key -> value`.
    inout fn insert(key: K, value: V) where K: Hash, K: Eq {
        if self.buckets.count() == 0U64 {
            self.grow()
        } else {
            if (self.count + 1U64) * 4U64 > self.buckets.count() * 3U64 {
                self.grow()
            }
        }
        val code: U64 = self.hashOf(key: key)
        val cap: U64 = self.buckets.count()
        mut val slot: U64 = code & (cap - 1U64)
        while true {
            val b: U64 = self.buckets[slot]
            if b == 0U64 {
                self.keys.append(key)
                self.vals.append(value)
                self.hashes.append(code)
                self.buckets.set(index: slot, self.keys.count())
                self.count = self.count + 1U64
                return
            }
            val idx: U64 = b - 1U64
            if self.hashes[idx] == code {
                if self.keys[idx] == key {
                    self.vals.set(index: idx, value)
                    return
                }
            }
            slot = (slot + 1U64) & (cap - 1U64)
        }
    }
    // Entry index + 1 for `key` (0 = absent).
    fn find(key: K) -> U64 where K: Hash, K: Eq {
        if self.buckets.count() == 0U64 {
            return 0U64
        }
        val code: U64 = self.hashOf(key: key)
        val cap: U64 = self.buckets.count()
        mut val slot: U64 = code & (cap - 1U64)
        while true {
            val b: U64 = self.buckets[slot]
            if b == 0U64 {
                return 0U64
            }
            val idx: U64 = b - 1U64
            if self.hashes[idx] == code {
                if self.keys[idx] == key {
                    return b
                }
            }
            slot = (slot + 1U64) & (cap - 1U64)
        }
        return 0U64
    }
    // Whether `key` is present.
    fn contains(key: K) -> Bool where K: Hash, K: Eq {
        return self.find(key: key) != 0U64
    }
    // The value for `key` as `Some(v)`, or `None` if absent (spec/02 — the safe,
    // non-panicking lookup; `dict[key]` panics on a missing key, `get` does not).
    fn get(key: K) -> Optional[V] where K: Hash, K: Eq {
        val b: U64 = self.find(key: key)
        if b == 0U64 {
            return <Optional.None />
        }
        return <Optional.Some v=self.vals[b - 1U64] />
    }
    // The value for `key`, or `fallback` if absent (non-panicking lookup).
    fn getOr(key: K, fallback: V) -> V where K: Hash, K: Eq {
        val b: U64 = self.find(key: key)
        if b == 0U64 {
            return fallback
        }
        return self.vals[b - 1U64]
    }
    // The value for `key`; panics if absent (what `dict[key]` lowers to — spec/02).
    fn at(key: K) -> V where K: Hash, K: Eq {
        val b: U64 = self.find(key: key)
        if b == 0U64 {
            panic "dictionary: key not found"
        }
        return self.vals[b - 1U64]
    }
    // Remove `key` if present (a no-op when absent — spec/02's removal path; there is no
    // `dict[key] = nil` special case). Two steps keep the structure dense and the probe
    // chains intact: (1) backward-shift the open-addressing index to fill the emptied
    // slot (no tombstones, so lookups never degrade), then (2) swap the last dense entry
    // into the freed position and drop the tail.
    inout fn remove(key: K) where K: Hash, K: Eq {
        if self.buckets.count() == 0U64 {
            return
        }
        val cap: U64 = self.buckets.count()
        val code: U64 = self.hashOf(key: key)
        // locate the slot holding `key` (linear probe from its ideal slot).
        mut val s: U64 = code & (cap - 1U64)
        mut val found: Bool = false
        while !found {
            val b: U64 = self.buckets[s]
            if b == 0U64 {
                return
            }
            val idx: U64 = b - 1U64
            if self.hashes[idx] == code {
                if self.keys[idx] == key {
                    found = true
                }
            }
            if !found {
                s = (s + 1U64) & (cap - 1U64)
            }
        }
        val r: U64 = self.buckets[s] - 1U64
        // (1) backward-shift deletion (Knuth 6.4 Algorithm R): pull each following entry
        // back into the hole when its ideal slot lies at/behind the hole, so every entry
        // stays reachable by probing from its ideal slot.
        mut val i: U64 = s
        mut val doneShift: Bool = false
        while !doneShift {
            self.buckets.set(index: i, 0U64)
            mut val j: U64 = i
            mut val moved: Bool = false
            while !moved {
                j = (j + 1U64) & (cap - 1U64)
                val bj: U64 = self.buckets[j]
                if bj == 0U64 {
                    doneShift = true
                    moved = true
                } else {
                    val ideal: U64 = self.hashes[bj - 1U64] & (cap - 1U64)
                    val di: U64 = (i + cap - ideal) & (cap - 1U64)
                    val dj: U64 = (j + cap - ideal) & (cap - 1U64)
                    if di <= dj {
                        self.buckets.set(index: i, bj)
                        i = j
                        moved = true
                    }
                }
            }
        }
        // (2) compact the dense arrays: move the last entry into freed slot `r` (unless
        // `r` is already the last), repoint its bucket pointer, then drop the tail.
        val lastIdx: U64 = self.count - 1U64
        if r != lastIdx {
            val movedHash: U64 = self.hashes[lastIdx]
            self.keys.set(index: r, self.keys[lastIdx])
            self.vals.set(index: r, self.vals[lastIdx])
            self.hashes.set(index: r, movedHash)
            mut val t: U64 = movedHash & (cap - 1U64)
            while self.buckets[t] != lastIdx + 1U64 {
                t = (t + 1U64) & (cap - 1U64)
            }
            self.buckets.set(index: t, r + 1U64)
        }
        // removeLast moves the retired tail entry OUT; bind it so the caller-owned
        // duplicate (case r != lastIdx: the same entry now also lives at slot r) /
        // the removed entry (case r == lastIdx) is released at scope end.
        val droppedKey: K = self.keys.removeLast()
        val droppedVal: V = self.vals.removeLast()
        val droppedHash: U64 = self.hashes.removeLast()
        self.count = self.count - 1U64
    }
}
