// @Std/Core — the Plew core library (pure Plew).
//
// Optional and Result are the canonical "maybe a value" / "value or error"
// types. They are ordinary generic enums; the compiler monomorphizes each
// concrete instantiation (`Optional[I32]`, `Result[I32, String]`, ...) and the
// methods below per instantiation. (Spec makes these ambient; for now a program
// imports them explicitly with `import @Std/Core`.)

// --- lang-item primitive scalar types (spec/15 core-library boundary) ---
// Opaque intrinsic types (representation is the compiler's int*_t / PlewString mapping):
// the language's built-in scalars. DEFINED here so their operator/Format/Eq/Ord/TryFrom
// witnesses (below + in Core/Num) sit in the same module = type-owned coherence; @Std/Lang
// re-exports them to make them ambient. The integer primitives carry `@[IntTryFrom(sources:
// […])]` listing the sub-64-bit SOURCE types whose narrowing TryFrom into that target is
// fallible (spec/12); the `@[IntTryFrom]` derive (@Plew/Syntax) renders one delegating
// `impl T as TryFrom[S]` per source into Core.gen.pw (auto-parted). (I64 as a TARGET has no
// fallible sub-64-bit source — all widen into it — and the wide/float sources are
// hand-written below, next to where TryFrom lives.)
extern "plew-intrinsic" {
    @[IntTryFrom(sources: ["I16", "I32", "U8", "U16", "U32"])]
    struct I8
    @[IntTryFrom(sources: ["I32", "U16", "U32"])]
    struct I16
    @[IntTryFrom(sources: ["U32"])]
    struct I32
    struct I64
    @[IntTryFrom(sources: ["I8", "I16", "I32", "U16", "U32"])]
    struct U8
    @[IntTryFrom(sources: ["I8", "I16", "I32", "U32"])]
    struct U16
    @[IntTryFrom(sources: ["I8", "I16", "I32"])]
    struct U32
    @[IntTryFrom(sources: ["I8", "I16", "I32"])]
    struct U64
    struct F32  struct F64
    struct Bool
}

// The primitive operator-trait conformances (spec/12, O6) — generated by
// tools/gen-numops.pw over the intrinsic floor; a part of this module. The primitive
// TYPES (above) and the operator traits (`Add`/`Sub`/…) both live in this module, so
// these witnesses (`impl I32 as Add[I32]`) are coherent type-owned impls in the type's
// own module (no orphan). @Std/Lang re-exports the types to make them ambient.
extern "plew-intrinsic" {
    fn i8Add(a: I8, b: I8) -> I8
    fn i8Sub(a: I8, b: I8) -> I8
    fn i8Mul(a: I8, b: I8) -> I8
    fn i8Div(a: I8, b: I8) -> I8
    fn i8Rem(a: I8, b: I8) -> I8
    fn i8BitAnd(a: I8, b: I8) -> I8
    fn i8BitOr(a: I8, b: I8) -> I8
    fn i8BitXor(a: I8, b: I8) -> I8
    fn i8Shl(a: I8, b: I8) -> I8
    fn i8Shr(a: I8, b: I8) -> I8
    fn i8BitNot(a: I8) -> I8
    fn i8Neg(a: I8) -> I8
    fn i8Eq(a: I8, b: I8) -> Bool
    fn i8Lt(a: I8, b: I8) -> Bool
    fn i16Add(a: I16, b: I16) -> I16
    fn i16Sub(a: I16, b: I16) -> I16
    fn i16Mul(a: I16, b: I16) -> I16
    fn i16Div(a: I16, b: I16) -> I16
    fn i16Rem(a: I16, b: I16) -> I16
    fn i16BitAnd(a: I16, b: I16) -> I16
    fn i16BitOr(a: I16, b: I16) -> I16
    fn i16BitXor(a: I16, b: I16) -> I16
    fn i16Shl(a: I16, b: I16) -> I16
    fn i16Shr(a: I16, b: I16) -> I16
    fn i16BitNot(a: I16) -> I16
    fn i16Neg(a: I16) -> I16
    fn i16Eq(a: I16, b: I16) -> Bool
    fn i16Lt(a: I16, b: I16) -> Bool
    fn i32Add(a: I32, b: I32) -> I32
    fn i32Sub(a: I32, b: I32) -> I32
    fn i32Mul(a: I32, b: I32) -> I32
    fn i32Div(a: I32, b: I32) -> I32
    fn i32Rem(a: I32, b: I32) -> I32
    fn i32BitAnd(a: I32, b: I32) -> I32
    fn i32BitOr(a: I32, b: I32) -> I32
    fn i32BitXor(a: I32, b: I32) -> I32
    fn i32Shl(a: I32, b: I32) -> I32
    fn i32Shr(a: I32, b: I32) -> I32
    fn i32BitNot(a: I32) -> I32
    fn i32Neg(a: I32) -> I32
    fn i32Eq(a: I32, b: I32) -> Bool
    fn i32Lt(a: I32, b: I32) -> Bool
    fn i64Add(a: I64, b: I64) -> I64
    fn i64Sub(a: I64, b: I64) -> I64
    fn i64Mul(a: I64, b: I64) -> I64
    fn i64Div(a: I64, b: I64) -> I64
    fn i64Rem(a: I64, b: I64) -> I64
    fn i64BitAnd(a: I64, b: I64) -> I64
    fn i64BitOr(a: I64, b: I64) -> I64
    fn i64BitXor(a: I64, b: I64) -> I64
    fn i64Shl(a: I64, b: I64) -> I64
    fn i64Shr(a: I64, b: I64) -> I64
    fn i64BitNot(a: I64) -> I64
    fn i64Neg(a: I64) -> I64
    fn i64Eq(a: I64, b: I64) -> Bool
    fn i64Lt(a: I64, b: I64) -> Bool
    fn u8Add(a: U8, b: U8) -> U8
    fn u8Sub(a: U8, b: U8) -> U8
    fn u8Mul(a: U8, b: U8) -> U8
    fn u8Div(a: U8, b: U8) -> U8
    fn u8Rem(a: U8, b: U8) -> U8
    fn u8BitAnd(a: U8, b: U8) -> U8
    fn u8BitOr(a: U8, b: U8) -> U8
    fn u8BitXor(a: U8, b: U8) -> U8
    fn u8Shl(a: U8, b: U8) -> U8
    fn u8Shr(a: U8, b: U8) -> U8
    fn u8BitNot(a: U8) -> U8
    fn u8Eq(a: U8, b: U8) -> Bool
    fn u8Lt(a: U8, b: U8) -> Bool
