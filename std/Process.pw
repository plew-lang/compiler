// @Std/Process — process arguments and termination (runtime intrinsics; see
// @Std/Io for the boundary mechanism).
export extern(plewIntrinsic) {
    // Number of command-line arguments (argv count, including argv[0]).
    fn argCount() -> I64
    // The i-th command-line argument (empty when out of range).
    fn argAt(i~: I64) -> String
    // Terminate the process with the given exit code (does not return).
    fn exit(code: I64)
    // Run `sh -c cmd`, returning its captured stdout. The child's exit status is
    // available from `execCode()` until the next `execOut`. Used by the package
    // dependency resolver to drive `git` (spec/17).
    fn execOut(cmd: String) -> String
    // The exit status of the most recent `execOut` (-1 if it could not run).
    fn execCode() -> I64
}
