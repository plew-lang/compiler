// @Std/Io — text and file I/O.
//
// These are runtime intrinsics: body-less declarations bound to the runtime
// symbol `plew_<name>` (spec/15 core-library boundary). The compiler supplies
// the bodies; a call lowers to `plew_<name>(args)`. Plew types cross the boundary
// (the compiler owns `String` ⇄ `PlewString` etc.), so no C-type vocabulary
// appears here — that is `extern "C"` (future, real FFI).
//

import @Std/Core with { Format }

export extern "plew-intrinsic" {
    // Write a string to stdout (no trailing newline).
    fn write(s: String)
    // Write a single byte to stdout.
    fn writeByte(b~: U8)
    // Read all of stdin as a string.
    fn readStdin() -> String
    // Read a file's contents as a string (empty on error).
    fn readFile(path~: String) -> String
    // Read a file named by a byte path as a string (used by the multi-file loader).
    fn readFileBytes(path~: Array[U8]) -> String
    // Write a string to stderr (no trailing newline).
    fn eprint(text: String)
    // Does a file at the given byte path exist?
    fn fileExists(path: Array[U8]) -> Bool
}

// Write a value's textual form (`Format`) to stdout, followed by a newline.
// `print(x)` infers the type of `x`; a bare integer literal needs a suffix
// (`print(42I64)`) since numeric literals have no default type (spec/02).
export fn print[T](value~: T) where T: Format {
    write(s: value.format(format: ""))
    write(s: "\n")
}
