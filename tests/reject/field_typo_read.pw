// A misspelled field on a known struct rejects — and (span pin) the error
// points at the `.typo` token's own source line, not the interned copy of the
// name (which maps to no file). Same for the Ref `->` form.
struct Pt { pub val x: I64 }
fn main() {
    val r = <Pt x=1 />
    val v = r.typo
}
