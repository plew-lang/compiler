// `?.` desugars over the WHOLE `Chain` contract (spec/12): a `chain()` returning an
// `Optional`, plus `fromValue(value:)` and `empty()` factories. A struct that has a
// `chain()` but not the factories does NOT conform — reject at the base rather than
// desugaring and failing deep in the backend with an out-of-source line number.
struct Fake { pub val n: I64 }
pub impl Fake { fn chain() -> Optional[I64] { return <Optional[I64].Some v=self.n /> } }
fn main() {
    val f: Fake = <Fake n=1 />
    val x = f?.n
}
