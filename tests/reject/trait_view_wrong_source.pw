import @Std/Io with { print }

// `#Q.p()` must be rejected: Q does not provide `p` (p is P's requirement). The
// `#P`-view redundancy fallback fires only when the named trait actually owns the
// method AND the receiver conforms to it — selecting a wrong source stays a loud error.
trait P { fn p() -> I64 }
trait Q { fn q() -> I64 }
struct S { val v: I64 }
pub impl S as P { fn p() -> I64 { return self.v } }
pub impl S as Q { fn q() -> I64 { return self.v * 2I64 } }

fn main() {
    val s: S = <S v=10 />
    print(s#Q.p())   // REJECT: Q does not provide p
}
