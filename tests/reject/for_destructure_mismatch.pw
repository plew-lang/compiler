// A for-loop struct-destructure pattern must name the element's struct type;
// using an unrelated struct is rejected (no silent mis-field-binding).
import @Std/Io with { print }
struct A { pub val x: I64 }
pub impl A { factory }
struct B { pub val x: I64 }
fn main() {
    val xs: Array[A] = [<A x=1 />]
    for B { val x } in xs {
        print(x)
    }
}
