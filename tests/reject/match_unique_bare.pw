// A unique storage place is not consumed by bare `match`; use `match move`.
import @Std/Io with { print }

unique struct File { pub val fd: I64 }

unique enum ResultFile {
    Ok(file: File)
    Err(code: I64)
}

fn main() {
    val r: ResultFile = <ResultFile.Ok file=<File fd=7 /> />
    match r {
        ResultFile.Ok(val file) => { print(file.fd) }
        ResultFile.Err(code: _) => { print(0I64) }
    }
}
