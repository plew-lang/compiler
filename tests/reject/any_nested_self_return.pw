// spec/08 (SE-0309): a `-> Self` result IS callable through `any P` (re-erased to the
// existential), but `Self` NESTED in a covariant container (`Optional[Self]`) needs
// per-container repacking that is not yet implemented, so such a member is conservatively
// not callable through `any P` (sound: no un-erased concrete escapes as an existential).
trait Peek { fn peek() -> Optional[Self] }
struct S { pub val a: I64 }
pub impl S as Peek {
    fn peek() -> Optional[Self] { return <Optional[Self].Some v=self /> }
}
fn main() {
    val x: any Peek = <S a=1I64 />
    val r: Optional[any Peek] = x.peek()
}
