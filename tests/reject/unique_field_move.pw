// Partial moves (out of a field/element) aren't tracked yet, so `move h.f` would
// leave `h.f` live and double-release. Reject until field moves are supported.
import @Std/Io with { write }
unique struct File { val fd: I64 }
unique struct Holder { val f: File }
fn main() {
    val h: Holder = <Holder f=<File fd=1 /> />
    val x: File = move h.f
    write(s: "x\n")
}
