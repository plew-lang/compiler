// A conditional move of an outer local is unsound without flow analysis (the
// persisted moved flag would skip the value's deinit on the not-taken path).
import @Std/Io with { write }
unique struct File { val fd: I64 }
fn sink(f: move File) { write(s: "got\n") }
fn main() {
    val cond: Bool = false
    val a: File = <File fd=9 />
    if cond { sink(f: move a) }
    write(s: "end\n")
}
