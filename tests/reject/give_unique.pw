// Yielding a bare unique place would copy it; give requires an explicit move.
import @Std/Io with { write, print }
unique struct File { pub val fd: I64  deinit { print(self.fd) } }
pub impl File { factory }
fn main() {
    val a: File = <File fd=1 />
    val b: File = <File fd=2 />
    val cond: Bool = true
    val c: File = if cond { give a } else { give b }
    write(s: "end\n")
}
