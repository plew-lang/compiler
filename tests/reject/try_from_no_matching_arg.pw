// `try` across differing error types needs an `From[Source]` accepting the SOURCE error
// (spec/13). `MyErr as From[I32]` takes only `I32`, so converting a `String` error has no
// matching overload — reject (accepting it emitted a String-as-i32 type confusion).
import @Std/Core with { From }

struct MyErr { pub val code: I32 }
pub impl MyErr { factory }
pub impl MyErr as From[I32] { factory(from: I32) { return <MyErr code=from /> } }
fn inner() -> Result[I32, String] { return <Result.Err error="boom" /> }
fn outer() -> Result[I32, MyErr] {
    val x: I32 = try inner()
    return <Result.Ok value=x />
}
