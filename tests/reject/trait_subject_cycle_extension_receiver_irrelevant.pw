// Bundle validity is independent of receiver reachability.  S can only use
// E's S -> A portion, but E's B <-> C declaration cycle rejects the bundle.
trait A {}
trait B {}
trait C {}

struct S {}
pub impl S { factory }
pub impl S as A {}

extension E {
    impl S as A {}
    impl B as C {}
    impl C as B {}
}

fn main() {
    val s: S = <S />
    val viewed = s#E
}
