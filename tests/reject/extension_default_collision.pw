import @Std/Io with { print }
// A `defaultExtension` method must not collide with the type's own method of the
// same selector (both would join bare resolution) — spec/09, loud at the type.
struct P {
    val n: I64
    defaultExtension #Ext
}
pub impl P { fn greet() -> I64 { return 1I64 } }
extension Ext { pub impl P { fn greet() -> I64 { return 2I64 } } }
fn main() { val p: P = <P n=4 /> print(p.greet()) }
