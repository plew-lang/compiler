// spec/03: a `MutableRef` shares mutation through a `val` handle, but the MutableRef exception waives only
// the BINDING's mutability — the pointee FIELD's own `val`/`mut val` still applies. A `val`
// (immutable) field must NOT be writable through a `MutableRef`, or value-semantics'
// val-immutability would leak away for any reference-shared type. (`mut val` fields ARE
// writable via `->`, even through a `val` MutableRef binding — that case is exercised by
// tests/run/unique_ref.pw.)
import @Std/Io with { print }
import @Std/Core with { MutableRef }
struct C { pub val n: I32 }   // pub but NOT mut: readable everywhere, never reassignable
fn main() {
    val r: MutableRef[C] = <MutableRef[C] value=<C n=5 /> />
    r->n = 9I32
}
