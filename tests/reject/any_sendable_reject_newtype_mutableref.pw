import @Std/Core with { MutableRef }

trait Numberish {
    fn number() -> I64
}

struct Cell {
    pub val value: I64
}
pub impl Cell { factory }

struct Box {
    pub val cell: MutableRef[Cell]
}
pub impl Box { factory }

impl Box as Numberish {
    fn number() -> I64 { return self.cell->value }
}

newtype WrappedBox = Box

fn main() {
    val value: any sendable Numberish = (<Box cell=<MutableRef value=<Cell value=1 /> /> /> as WrappedBox)
}
