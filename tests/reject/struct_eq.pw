// `==` is trait-backed (Eq). A struct has no Eq here, so comparing two structs
// must be a compile error (not a blind field/bit comparison).
import @Std/Io with { print }

struct Point {
    val x: I64
    val y: I64
}

fn main() {
    val a: Point = <Point x=1 y=2 />
    val b: Point = <Point x=1 y=2 />
    if a == b {
        print(1I64)
    }
}
