// spec/03: `->` is the POINTEE operator and is `Ref`-only. A `WeakRef` has no direct deref
// (its referent may be gone), so a pointee FIELD read through a `WeakRef` must be rejected —
// the referent is reached via `upgrade() -> Optional[Ref[T]]`. (Method form is covered by
// weakref_arrow_deref.pw; this covers the field-access form.)
import @Std/Io with { print }
import @Std/Core with { Ref, WeakRef }
struct C { pub val v: I32 }
fn main() {
    val r: Ref[C] = <Ref[C] value=<C v=7 /> />
    val w: WeakRef[C] = r.weak()
    print(w->v)
}
