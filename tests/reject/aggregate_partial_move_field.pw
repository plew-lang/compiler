// Aggregate partial move is rejected even when the field itself is copyable.
import @Std/Io with { print }

struct Pair {
    pub val left: I64
    pub val right: I64
}
pub impl Pair { factory }

fn main() {
    val p: Pair = <Pair left=1I64 right=2I64 />
    val x: I64 = move p.left
    print(x)
}
