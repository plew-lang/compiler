import @Std/Io with { print }

// The program is rejected at the shared `self.b()` body call: B has distinct
// C/D witnesses, and an outer call cannot select one for that body.  This
// particular use site is bare as well, but `s#C.a()` would be rejected too.
trait C { fn cv() -> I64 }
trait D { fn dv() -> I64 }
trait B { fn b() -> I64 }
trait A { fn a() -> I64 }
struct S { val v: I64 }
pub impl S as C { fn cv() -> I64 { return self.v } }
pub impl S as D { fn dv() -> I64 { return self.v * 100I64 } }
pub impl C as B { fn b() -> I64 { return self.cv() + 1I64 } }
pub impl D as B { fn b() -> I64 { return self.dv() + 2I64 } }
pub impl B as A { fn a() -> I64 { return self.b() + 10I64 } }

fn main() {
    val s: S = <S v=5 />
    print(s.a())   // REJECT: a unreachable bare (b multi-path)
}
