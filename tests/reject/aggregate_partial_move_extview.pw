// Extension views are transparent for aggregate partial move rejection.
import @Std/Io with { print }

struct Pair {
    val left: I64
    val right: I64
}

extension View {
    pub impl Pair {
        fn sum() -> I64 { return self.left + self.right }
    }
}

fn main() {
    val p: Pair = <Pair left=1I64 right=2I64 />
    val x: I64 = move (p#View).left
    print(x)
}
