// The struct destructure statement obeys the same coverage rule as the record
// form: every field bound or discarded — no implicit dropping, no `..`
// (spec/03), so adding a field to the struct breaks stale destructures loudly.
struct Pt { pub val x: I64 pub val y: I64 }
fn main() {
    val p = <Pt x=3 y=4 />
    Pt { val x } = p
}
