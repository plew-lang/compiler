// `Add` keeps Self, Rhs, and Output independent (spec/06,12).  The bound
// authorizes `a + b`, but does not prove that its Output is T, so this return
// type is invalid.  Write `T: Add[T, Output = T]` to make that equality true.
import @Std/Core with { Add }

fn sum[T](a: T, b: T) -> T where T: Add[T] {
    return a + b
}

fn main() { }
