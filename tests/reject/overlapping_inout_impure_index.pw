// Overlapping `inout` (spec/03, Swift-equivalent granularity): two `inout` places into
// the SAME array variable are rejected at the variable granularity — the index
// expressions are never evaluated or compared, so even a CALL index changes nothing.
import @Std/Io with { print }
struct Cell { pub mut val v: I64 }
fn pick() -> U64 { return 0 }
fn touch(a: inout Cell, b: inout I64) { a.v = 1  b = 2 }
fn main() {
    mut val xs: Array[Cell] = [<Cell v=0 />, <Cell v=0 />]
    val i: U64 = 1
    touch(a: inout xs[i], b: inout xs[pick()].v)
    print(xs[0].v)
}
