// Reading an unmarked (private) field from outside the type's anonymous impl is
// a visibility error (spec/05): private members are anonymous-impl-only.
struct Box { val secret: I64 }
pub impl Box {
    factory initial(secret: I64) { return <Box secret=secret /> }
}
fn main() {
    val b = <Box.initial secret=5 />
    val x: I64 = b.secret
}
