// An UN-ANNOTATED array literal of generic-enum elements: the element layout
// must come from the typed-IR store, not a per-form fallback. Three shapes that
// once mis-strided at 8 bytes (a 16-byte Optional overlapping the next element,
// silently corrupting tags/payloads):
//   1. explicit-args constructions  [<Optional[I64].Some ...>, <Optional[I64].None />]
//   2. a String payload (heap pointer in the payload word)
//   3. `?.` chain results placed DIRECTLY as elements (the Chain-desugar
//      MatchExpr has no per-form exprLlvmType arm; its type reads through
//      groundedTypeOf -> ChainSite.stageRef)
import @Std/Io with { print }
import @Std/Core

struct BoxG[T] { pub val value: T }

fn main() {
    val xs = [<Optional[I64].Some v=7I64 />, <Optional[I64].None />]
    for val o in xs {
        match o {
            Optional.Some(val v) => { print(v) }
            Optional.None => { print("n") }
        }
    }
    val ss = [<Optional[String].Some v="alpha" />, <Optional[String].None />]
    for val o in ss {
        match o {
            Optional.Some(v: val s) => { print(s) }
            Optional.None => { print("n") }
        }
    }
    val a: Optional[BoxG[I64]] = <Optional.Some v=<BoxG[I64] value=1 /> />
    val b: Optional[BoxG[I64]] = <Optional[BoxG[I64]].None />
    val cs = [a?.value, b?.value]
    for val o in cs {
        match o {
            Optional.Some(val v) => { print(v) }
            Optional.None => { print("n") }
        }
    }
}
