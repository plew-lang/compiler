import @Std/Io with { print }

// Iterating an array of structs / records binds the loop variable as that struct, so a
// field access / method call on it resolves (previously only the struct-DESTRUCTURE
// for-loop tracked the element type). Primitive elements stay plain scalars.
struct P { pub val x: I64  pub val y: I64 }
pub impl P { factory }
fn main() {
    mut val ps: Array[P] = []
    ps.append(<P x=1 y=2 />)
    ps.append(<P x=3 y=4 />)
    for val p in ps {
        print(p.x + p.y)       // 3, 7
    }
    // record elements too
    val a: (x: I64, y: I64) = (x: 10, y: 20)
    mut val rs: Array[(x: I64, y: I64)] = []
    rs.append(a)
    for val r in rs {
        print(r.x * r.y)       // 200
    }
    // primitive elements unaffected
    mut val ns: Array[I64] = [5, 6]
    for val n in ns {
        print(n)               // 5, 6
    }
}
