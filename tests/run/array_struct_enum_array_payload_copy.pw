// A value stored in Array must preserve an enum payload nested inside a struct.
// This is the carrier shape used by compiler semantic tables: Array[Entry],
// where Entry owns a sum whose selected alternative owns an Array.
import @Std/Io with { print }

enum Selection { Values(items: Array[String]) }

struct Entry {
    pub val selection: Selection
}
pub impl Entry { factory }

fn main() {
    val entry = <Entry selection=<Selection.Values items=["kept"] /> />
    mut val entries: Array[Entry] = []
    entries.append(entry)
    match entries[0U64].selection {
        Selection.Values(val items) => { print(items.count()) }
    }
}
