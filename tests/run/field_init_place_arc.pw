import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}

struct Holder {
    pub val r: MutableRef[Cell]
}

struct Named {
    pub val name: String
}

struct Box[T] {
    pub val v: T
}

struct Carton {
    pub val b: Box[MutableRef[Cell]]
}

fn refField() {
    val r: MutableRef[Cell] = <MutableRef value=<Cell v=9I32 /> />
    val h: Holder = <Holder r=r />
    print("ref-scope-end")
}

fn stringField() {
    mut val s: String = "dyn"
    s += "amic"
    val n: Named = <Named name=s />
    print(n.name)
    print("string-scope-end")
}

fn genericStructField() {
    val b: Box[MutableRef[Cell]] = <Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=8I32 /> /> />
    val ca: Carton = <Carton b=b />
    print("carton-scope-end")
}

fn main() {
    refField()
    stringField()
    genericStructField()
    print("done")
}
