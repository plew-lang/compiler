// A `newtype` inherits the underlying type's trait conformances automatically
// (spec/10), so it satisfies a `where T: Trait` bound whenever the underlying does.
// Covered: the built-in `Format` (so `print(u)` works directly, no explicit unwrap)
// for both a String- and an int-underlying newtype, and a user trait whose String
// witness is dispatched through the newtype (its inherited `self.bytes()` works too).
import @Std/Io with { print }

trait Loud { fn boom() -> U64 }
pub impl String as Loud { fn boom() -> U64 { return self.bytes().count() + 100U64 } }
fn needs[T](x: T) -> U64 where T: Loud { return x.boom() }

newtype UserId = String
newtype Meter = I64

fn main() {
    val u: UserId = "alice" as UserId
    print(u)                 // alice   (inherited String -> Format)
    val m: Meter = 42 as Meter
    print(m)                 // 42      (inherited I64 -> Format)
    val n: UserId = "hi" as UserId
    print(needs(x: n))       // 102     (inherited String -> Loud; self.bytes() = 2, +100)
}
