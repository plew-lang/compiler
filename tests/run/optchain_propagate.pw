// Swift-style optional-chain propagation (spec/12): `a?.b.c` short-circuits the
// WHOLE trailing member chain on an empty base, else projects `b.c` off the
// unwrapped value. Covers a plain multi-hop field chain, a method call in the
// continuation, and short-circuit on None.
import @Std/Io with { print, write }
import @Std/Core
struct C { pub val n: I64 }
pub impl C { fn doubled() -> I64 { return self.n * 2 } }
struct B { pub val c: C }
struct A { pub val b: B }
fn main() {
    val a: A = <A b=<B c=<C n=21 /> /> />
    val some: Optional[A] = <Optional[A].Some v=a />
    val none: Optional[A] = <Optional[A].None />
    val x: Optional[I64] = some?.b.c.n
    print(x.unwrapOr(fallback: 0I64))
    val y: Optional[I64] = some?.b.c.doubled()
    print(y.unwrapOr(fallback: 0I64))
    val z: Optional[I64] = none?.b.c.n
    print(z.unwrapOr(fallback: 99I64))
    write(s: "end\n")
}
