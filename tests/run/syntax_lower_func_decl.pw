import @Plew/Syntax with { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "trait P {}\nfn identity[T](value: T) -> T where T: P { return value }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.predeclareSyntaxTraitItem(item: syntaxFileTopLevel(file: file, index: 0U64))
    c.lowerSyntaxFuncDecl(d: syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 1U64)) />))
    print(c.arena.funcs.count())
    print(c.funcBindCount(binds: c.arena.funcs[0U64].typeParams))
    print(c.funcParamCount(params: c.arena.funcs[0U64].params))
    print(c.decls.funcBounds.count())
}
