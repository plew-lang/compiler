import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

enum Inner {
    Keep(r: MutableRef[Cell])
    Nothing
}

struct Slot {
    pub mut val r: MutableRef[Cell]
}
pub impl Slot { factory }

pub impl Slot {
    factory
}

fn enumLocalReassign() {
    mut val o: Inner = <Inner.Keep r=<MutableRef value=<Cell v=11I32 /> /> />
    o = <Inner.Nothing />
    print("after-reassign")
}

fn nestedPlaceStore() {
    mut val xs: Array[Slot] = [<Slot r=<MutableRef value=<Cell v=12I32 /> /> />]
    val other: MutableRef[Cell] = <MutableRef value=<Cell v=13I32 /> />
    xs[0].r = other
    print("after-nested-store")
}

fn main() {
    enumLocalReassign()
    print("---")
    nestedPlaceStore()
    print("done")
}
