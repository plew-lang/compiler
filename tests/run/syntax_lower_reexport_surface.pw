// SyntaxFile lowering must record the re-exported spelling (the alias when
// present) in the module export surface, without creating a local import.
import @Plew/Syntax with { Lexer, P, ImportId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxImport, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }
import /Ir with { Bind }

fn main() {
    val source = "export @Std/Io with { print as show, eprint }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val imp = syntaxImport(file: file, id: <ImportId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.modules.ranges.append(<Bind nameStart=0U64 nameLen=source.bytes().count() fieldStart=0U64 fieldLen=0U64 />)
    c.syntax = file
    c.lowerSyntaxReExport(imp: imp)

    print(c.modules.exports.count())
    print(c.modules.exports[0].nameLen)
    print(c.modules.exports[1].nameLen)
    print(c.modules.imports.count())
}
