import @Std/Io with { print }

trait Extra {}
pub impl Extra { fn traitMethod() -> I64 { return 11I64 } }

struct Box[T] { pub val value: T }
pub impl[T] Box[T] { factory }
pub impl Box[String] as Extra {}

extension Extra {
    pub impl Box[I64] { fn extensionMethod() -> I64 { return self.value } }
}

fn main() {
    val box: Box[I64] = <Box value=7I64 />
    print(box#Extra.extensionMethod())
}
