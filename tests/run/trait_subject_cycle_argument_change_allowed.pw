import @Std/Io with { print }

// The owner graph returns to A, but the active instances do not: A[I64]
// reaches B, which reaches A[String]. This is not an exact instance cycle.
trait A[Item] {}
trait B {}

impl A[I64] as B {}
impl B as A[String] {}

struct S {}
pub impl S { factory }
pub impl S as A[I64] {}

fn main() {
    val s: S = <S />
    print(1I64)
}
