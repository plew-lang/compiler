import @Plew/Syntax with { Lexer, P, NewtypeId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxNewtype, syntaxType, syntaxTypeArgLabel, syntaxTypeProjectionTraitArgCount, syntaxTypeProjectionTraitArg, syntaxTypeProjectionTraitArgLabel }
import @Std/Io with { print }

fn main() {
    val source = "newtype Projection = T#Trait[U8].Item\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val newtype = syntaxNewtype(file: file, id: <NewtypeId raw=syntaxTopItemPayload(file: file, item: item) />)
    val ty = syntaxType(file: file, id: newtype.ty)
    val arg = syntaxType(file: file, id: syntaxTypeProjectionTraitArg(file: file, ty: ty, index: 0U64))
    val label = syntaxTypeProjectionTraitArgLabel(file: file, ty: ty, index: 0U64)
    print(ty.projectionTrait.end - ty.projectionTrait.start)
    print(syntaxTypeProjectionTraitArgCount(file: file, ty: ty))
    print(arg.name.end - arg.name.start)
    print(label.end - label.start)
    print(ty.projectionAssoc.end - ty.projectionAssoc.start)
}
