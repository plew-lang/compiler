// From conversion via `x as T` ⟺ `<T from=x/>` (spec/12): a total conversion
// expressed as an anonymous `factory(from: Source)`. Numeric `as` is unaffected
// (primitives have no `from` factory).
import @Std/Io with { print }

struct Celsius { pub val c: I64 }
struct Fahrenheit { pub val f: I64 }

pub impl Celsius {
    factory(from: Fahrenheit) {
        return <Celsius c=(from.f - 32) * 5 / 9 />
    }
}

fn main() {
    val f: Fahrenheit = <Fahrenheit f=212 />
    val c: Celsius = f as Celsius
    print(c.c)
    // the `<T from=x/>` JSX form routes the same way.
    val c2: Celsius = <Celsius from=f />
    print(c2.c)
    val small: I32 = 5I32
    val big: I64 = small as I64
    print(big)
}
