import @Std/Io with { write }
import @Std/Core with { Buffer, MutableRef, bufferAppend, bufferSet }

unique struct Cell {
    pub val id: I64
    deinit { write(s: self.id.format(format: "") + "\n") }
}
pub impl Cell { factory }

// The helper itself contains only the inout replacement. Its parameter is a
// copied ARC value, so the Mid store must acquire the Buffer's share before it
// commits and releases the old slot value.
val midBufferSetArcAnchor: I64 = 0I64

fn replaceFirst(buffer: inout Buffer[MutableRef[Cell]], replacement: MutableRef[Cell]) {
    bufferSet(buffer: inout buffer, index: 0U64, value: replacement)
}

fn main() {
    mut val buffer: Buffer[MutableRef[Cell]] = Buffer.new()
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=1I64 /> />)
    val replacement: MutableRef[Cell] = <MutableRef[Cell] value=<Cell id=2I64 /> />
    replaceFirst(buffer: inout buffer, replacement: replacement)
    write(s: "after\n")
}
