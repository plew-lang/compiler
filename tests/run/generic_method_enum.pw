import @Std/Io with { print }

enum Maybe[T] {
    Some(v: T)
    None
}

impl[T] Maybe[T] {
    fn unwrapOr(fallback: T) -> T {
        match self {
            Maybe.Some(val v) => { return v }
            Maybe.None => { return fallback }
        }
    }
    fn isSome() -> I32 {
        match self {
            Maybe.Some(val v) => { return 1 }
            Maybe.None => { return 0 }
        }
    }
}

fn main() {
    val a: Maybe[I32] = <Maybe[I32].Some v=42 />
    val b: Maybe[I32] = <Maybe[I32].None />
    print(a.unwrapOr(fallback: 7))
    print(b.unwrapOr(fallback: 7))
    print(a.isSome())
    print(b.isSome())
}
