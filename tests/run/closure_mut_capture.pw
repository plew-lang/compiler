import @Std/Io with { print }

fn makeCounter() -> fn() -> I32 {
    mut val count: I32 = 0
    return fn() -> I32 {
        count = count + 1
        return count
    }
}

fn main() {
    val c: fn() -> I32 = makeCounter()
    print(c())
    print(c())
    print(c())
    val d: fn() -> I32 = makeCounter()
    print(d())
    print(c())
    // shared mutation visible in the enclosing scope (both alive)
    mut val total: I32 = 0
    val add: fn(x: I32) -> I32 = fn(x: I32) -> I32 {
        total = total + x
        return total
    }
    print(add(x: 5))
    print(add(x: 3))
    print(total)
}
