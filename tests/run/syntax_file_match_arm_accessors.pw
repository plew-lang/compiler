import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxStmtMatchArmCount, syntaxStmtMatchArm, syntaxMatchArm, syntaxPattern, syntaxExpr, DeclId, SyntaxStmtKind, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { match 1U64 { 1U64 => {} } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val matchStmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))
    val arm = syntaxMatchArm(file: file, id: syntaxStmtMatchArm(file: file, stmt: matchStmt, index: 0U64))
    val pattern = syntaxPattern(file: file, id: arm.pat)
    val literal = syntaxExpr(file: file, id: pattern.lit)
    match matchStmt.kind {
        SyntaxStmtKind.Match => { print(1U64) }
        _ => { print(0U64) }
    }
    print(syntaxStmtMatchArmCount(file: file, stmt: matchStmt))
    if pattern.isLiteral { print(1U64) } else { print(0U64) }
    match literal.kind {
        SyntaxExprKind.IntLit => { print(1U64) }
        _ => { print(0U64) }
    }
}
