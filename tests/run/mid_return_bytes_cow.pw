import @Std/Io with { print }
import @Std/Core with { MutableRef }

fn returnedBytes(text: String) -> Array[U8] { return text.bytes() }
fn returnedText(text: String) -> String { return text }

struct Box[T] { pub val value: T }
pub impl[T] Box[T] { factory }
fn boxedBytes(text: String) -> Box[Array[U8]] {
    return <Box[Array[U8]] value=text.bytes() />
}

unique struct Resource {
    pub val number: I32
    deinit { print(self.number) }
}
pub impl Resource { factory }
struct Holder { pub val resource: MutableRef[Resource] }
pub impl Holder { factory }
fn freshHolder() -> Holder {
    return <Holder resource=<MutableRef value=<Resource number=71I32 /> /> />
}
fn forwardedHolder() -> Holder { return freshHolder() }

fn exercise() {
    val text: String = "ab" + "cd"
    mut val bytes: Array[U8] = returnedBytes(text: text)
    val shared: Array[U8] = bytes
    bytes.set(i: 0U64, value: 90U8)
    print(text)
    print(returnedText(text: text))
    print(bytes[0U64])
    print(shared[0U64])
    print(boxedBytes(text: text).value.count())
    val holder: Holder = forwardedHolder()
    print("owned")
}
fn main() {
    exercise()
    print("released")
}
