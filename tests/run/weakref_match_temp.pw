// A `match` whose scrutinee is an OWNED TEMPORARY (a call/construction result, not a place)
// is the temp's only owner, so the match must release it on every exit path — otherwise the
// temp's payload heap leaks. Here `w.upgrade()` is matched directly: the `Optional[Ref[Cell]]`
// temp holds a STRONG owner on the cell. If the match leaked it, the cell's strong would stay
// > 0 and r's drop would never run the pointee `deinit`. Each `deinit` prints its tag, so the
// final marker fires iff the upgrade temp was released exactly once (no leak, no double-free).
// Guards the owned-scrutinee-temp release for BOTH a returning arm and a fall-through arm.
import @Std/Io with { print }
import @Std/Core with { Ref, WeakRef }

unique struct Cell {
    pub mut val v: I32
    deinit { print(self.v) }
}

// returning arm: the matched temp must be dropped on the `return` path (via dropScope).
fn readVia(w: WeakRef[Cell]) -> I32 {
    match w.upgrade() {
        Optional.Some(v: val r) => { return r->v }
        Optional.None => { return 999I32 }
    }
}

fn main() {
    val r: Ref[Cell] = <Ref[Cell] value=<Cell v=5 /> />
    val w: WeakRef[Cell] = r.weak()
    print(readVia(w: w))      // 5 (read through the upgraded temp; temp released on return)

    // fall-through arm: a directly-matched temp with no `return`/`break`, so the match must
    // drop it at its continuation. The Some arm mutates through the upgraded strong handle.
    match w.upgrade() {
        Optional.Some(v: val s) => { s->v = 9I32 }
        Optional.None => { print(999I32) }
    }
    print(100I32)
    // r drops here -> Cell deinit prints 9 (mutated). A leaked upgrade strong would keep the
    // cell's strong > 0 and suppress this final marker.
}
