import @Std/Io with { print }

// defaultExtension (spec/09): a type may declare `defaultExtension #Ext` in its
// body to put an extension's methods on its bare resolution surface, so they are
// callable without the `#Ext` view. The methods still work via `#Ext` too.
struct V {
    val n: I64
    defaultExtension #Ops
}

extension Ops {
    pub impl V {
        fn doubled() -> I64 { return self.n * 2I64 }
        fn scaled(by: I64) -> I64 { return self.n * by }
    }
}

// a non-default extension stays view-only.
extension Hidden {
    pub impl V {
        fn secret() -> I64 { return self.n + 1000I64 }
    }
}

fn main() {
    val v: V = <V n=5 />
    print(v.doubled())          // 10  (bare, via defaultExtension)
    print(v.scaled(by: 4I64))   // 20  (bare, with an argument)
    print(v#Ops.doubled())      // 10  (still reachable through the view)
    print(v#Hidden.secret())    // 1005 (non-default: only through #Hidden)
}
