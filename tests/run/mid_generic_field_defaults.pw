import @Std/Io with { print }

mut val evaluations: U64 = 0U64
fn defaultLabel() -> String {
    evaluations += 1U64
    return "de" + "fault"
}
struct Inner[T] { pub mut val values: Array[T] = [] }
pub impl[T] Inner[T] { factory }
struct Store[T] {
    pub mut val inner: Inner[T] = <Inner />
    pub val label: String = defaultLabel()
}
pub impl[T] Store[T] { factory }

fn main() {
    mut val numbers: Store[I64] = <Store />
    mut val words: Store[String] = <Store />
    numbers.inner.values.append(42I64)
    words.inner.values.append("he" + "ap")
    val empty: Store[I64] = <Store />
    print(numbers.inner.values[0U64])
    print(words.inner.values[0U64])
    print(empty.inner.values.count())
    print(numbers.label)
    print(words.label)
    print(evaluations)
}
