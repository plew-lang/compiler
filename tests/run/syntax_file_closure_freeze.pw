import @Plew/Syntax with { Lexer, P, lex, parseProgramAst, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxExpr, syntaxExprParamCount, DeclId, TopItemAst, StmtAst, ExprAst, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { val f = fn(value: U64) -> U64 { return value } }\n"
    mut val valueLexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout valueLexer)
    mut val valueParser = <P bytes=source.bytes() toks=valueLexer.toks pos=0U64 base=0U64 />
    val items = parseProgramAst(p: inout valueParser)
    match items[0U64] {
        TopItemAst.Decl(d: val d) => {
            match d.body.stmts[0U64] {
                StmtAst.Let(mutable: _, name: _, nameSpan: _, hasTy: _, ty: _, init: val init, span: _) => {
                    match init {
                        ExprAst.Closure(params: _, hasRet: _, ret: _, body: _, span: _) => { print(1U64) }
                        _ => { print(0U64) }
                    }
                }
                _ => { print(0U64) }
            }
        }
        _ => { print(0U64) }
    }
    mut val syntaxLexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout syntaxLexer)
    mut val syntaxParser = <P bytes=source.bytes() toks=syntaxLexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout syntaxParser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))
    val closure = syntaxExpr(file: file, id: stmt.child0)
    match closure.kind {
        SyntaxExprKind.Closure => { print(1U64) }
        _ => { print(0U64) }
    }
    print(syntaxExprParamCount(file: file, expr: closure))
}
