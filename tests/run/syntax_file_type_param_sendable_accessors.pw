import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxDeclTypeParamIsSendable, syntaxTrait, syntaxTraitTypeParamIsSendable, syntaxImpl, syntaxImplParamIsSendable, syntaxImplMember, syntaxMember, syntaxMemberTypeParamIsSendable, syntaxTraitReq, syntaxSig, syntaxSigTypeParamIsSendable, DeclId, TraitId, ImplId }
import @Std/Io with { print }

fn main() {
    val source = "struct Box[sendable T] {}\ntrait Stream[sendable T] { fn next[sendable U]() }\nimpl[sendable T] Box[T] { fn copy[sendable U]() {} }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val trait = syntaxTrait(file: file, id: <TraitId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 1U64)) />)
    val sig = syntaxSig(file: file, id: syntaxTraitReq(file: file, trait: trait, index: 0U64))
    val impl = syntaxImpl(file: file, id: <ImplId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 2U64)) />)
    val member = syntaxMember(file: file, id: syntaxImplMember(file: file, impl: impl, index: 0U64))
    if syntaxDeclTypeParamIsSendable(file: file, decl: decl, index: 0U64) { print(1U64) } else { print(0U64) }
    if syntaxTraitTypeParamIsSendable(file: file, trait: trait, index: 0U64) { print(1U64) } else { print(0U64) }
    if syntaxSigTypeParamIsSendable(file: file, sig: sig, index: 0U64) { print(1U64) } else { print(0U64) }
    if syntaxImplParamIsSendable(file: file, impl: impl, index: 0U64) { print(1U64) } else { print(0U64) }
    if syntaxMemberTypeParamIsSendable(file: file, member: member, index: 0U64) { print(1U64) } else { print(0U64) }
}
