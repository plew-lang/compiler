// SyntaxFile match arms lower directly into the shared MatchArm pool. Scalar
// desugaring is intentionally not exercised here; this protects the typed
// arm/pattern traversal used by the later single-evaluation path.
import @Plew/Syntax with { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxBlock, syntaxBlockStmt, syntaxDecl, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "fn body() { match 1U64 { 1U64 => {} } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val arms = c.lowerSyntaxStmtMatchArms(stmt: stmt, isExpr: false)
    print(arms.len)
    print(c.arena.matchArms.count())
    print(c.arena.blocks.count())
}
