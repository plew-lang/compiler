// Field rename binds `{ field: val name }`, field discard `{ field: _ }`, and a
// cross-name payload or-pattern unified via rename to a common binding.
import @Std/Io with { print }

enum Shape { Circle { radius: I64 } Square { side: I64 } }
enum Pair { P { a: I64, b: I64 } }

fn doubled(s: Shape) -> I64 {
    return match s {
        Shape.Circle(radius: val size) | Shape.Square(side: val size) => size * 2
    }
}

fn firstOnly(p: Pair) -> I64 {
    // discard the second field
    return match p {
        Pair.P(a: val x, b: _) => x
    }
}

fn main() {
    print(doubled(s: <Shape.Circle radius=10 />))
    print(doubled(s: <Shape.Square side=3 />))
    print(firstOnly(p: <Pair.P a=7 b=99 />))
}
