import @Std/Io with { print }

val mainPathAnchor: I64 = 0I64

struct Marker {}
pub impl Marker { factory }

// `self` is not read yet: this slice pins the receiver ABI-to-Mid-local
// binding itself. Field projection gets its own explicit Mid operation.
pub impl Marker {
    fn decide(early: Bool) -> I64 {
        if early {
            return 31I64
        }
        return 32I64
    }
}

fn main() {
    val marker = <Marker />
    print(marker.decide(early: true))
}
