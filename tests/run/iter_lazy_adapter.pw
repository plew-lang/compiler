import @Std/Io with { print }
import @Std/Core with { Iterator, Iterable }

// A lazy iterator adapter, hand-written (the foundation the provided `.map()`
// sugar will build on): MapIter wraps an inner iterator `I` and a mapping
// closure `F: fn(x: In) -> B`, applying it lazily in next(). Exercises closure-
// typed struct fields, an impl-level `where I: Iterator` bound (so `self.inner.
// next()` resolves), and a compound generic return `Optional[B]`.
struct BoxIter[T] {
    pub val items: Array[T]
    pub mut val i: U64
}
pub impl[T] BoxIter[T] as Iterator {
    type Item = T
    inout fn next() -> Optional[T] {
        if self.i >= self.items.count { return <Optional.None /> }
        val v: T = self.items[self.i]
        self.i = self.i + 1
        return <Optional.Some v=v />
    }
}
struct Box[T] {
    pub val items: Array[T]
}
pub impl[T] Box[T] as Iterable {
    type Item = T
    type Iter = BoxIter[T]
    fn iterator() -> BoxIter[T] { return <BoxIter[T] items=self.items i=0U64 /> }
}

struct MapIter[I, F, B] {
    pub mut val inner: I
    pub val f: F
}
pub impl[I, F, B] MapIter[I, F, B] as Iterator where I: Iterator {
    type Item = B
    inout fn next() -> Optional[B] {
        match self.inner.next() {
            Optional.Some(val v) => { return <Optional.Some v=self.f(x: v) /> }
            Optional.None => { return <Optional.None /> }
        }
    }
}

fn main() {
    val b: Box[I64] = <Box[I64] items=[1, 2, 3] />
    mut val m: MapIter[BoxIter[I64], fn(x: I64) -> I64, I64] = <MapIter[BoxIter[I64], fn(x: I64) -> I64, I64] inner=b.iterator() f=fn(x: I64) -> I64 { return x * 10 } />
    mut val go: Bool = true
    while go {
        match m.next() {
            Optional.Some(val v) => { print(v) }
            Optional.None => { go = false }
        }
    }
}
