import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmtCount, syntaxBlockStmt, syntaxStmt, syntaxExpr, DeclId, SyntaxStmtKind, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn answer() -> U64 { val value = 42U64\nreturn value }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    val block = syntaxBlock(file: file, id: decl.body)
    val first = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: block, index: 0U64))
    val second = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: block, index: 1U64))
    val initializer = syntaxExpr(file: file, id: first.child0)
    val result = syntaxExpr(file: file, id: second.child0)
    print(syntaxBlockStmtCount(file: file, block: block))
    match first.kind {
        SyntaxStmtKind.Let => { print(1U64) }
        _ => { print(0U64) }
    }
    match second.kind {
        SyntaxStmtKind.Return => { print(1U64) }
        _ => { print(0U64) }
    }
    match initializer.kind {
        SyntaxExprKind.IntLit => { print(1U64) }
        _ => { print(0U64) }
    }
    match result.kind {
        SyntaxExprKind.Ident => { print(1U64) }
        _ => { print(0U64) }
    }
}
