// extern(c) FFI (spec/15): opaque foreign handle (`type ModuleRef`) + raw C
// pointers (`CPtr[U8]`) + String<->C-string conversion, calling a foreign C
// library — here a self-contained companion stub (ffi_extern_c.c) shaped like
// libLLVM-C (LLVMModuleCreateWithName/.../LLVMDisposeMessage), so the test needs
// no system library. Proves the minimal FFI subset the LLVM backend stands on.
import @Std/Io with { print }

extern(plewIntrinsic) {
    fn cString(text~: String) -> CPtr[U8]
    fn stringFromCString(ptr: CPtr[U8]) -> String
}

extern(c) {
    type ModuleRef
    fn moduleCreate(name: CPtr[U8]) -> ModuleRef
    fn moduleName(m: ModuleRef) -> CPtr[U8]
    fn moduleDispose(m: ModuleRef)
}

fn main() {
    val m: ModuleRef = moduleCreate(name: cString("plew_hello"))
    print(stringFromCString(ptr: moduleName(m: m)))
    moduleDispose(m: m)
}
