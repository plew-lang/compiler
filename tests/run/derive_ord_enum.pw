import @Std/Io with { print }
import @Std/Core with { Ordering }
// @[Ord] on an enum: lexicographic over (variant tag, then payload). It also
// implies Eq (Ord: Eq), so `==` works without a separate @[Eq].
@[Ord]
enum Tier { Low Mid(level: I32) High }
fn cmp(a~: Tier, b~: Tier) -> I32 {
    if a < b { return 0I32 }
    if a > b { return 2I32 }
    return 1I32
}
fn main() {
    print(cmp(<Tier.Low />, <Tier.High />))            // 0 (tag 0 < 2)
    print(cmp(<Tier.High />, <Tier.Low />))            // 2
    print(cmp(<Tier.Mid level=3 />, <Tier.Mid level=7 />)) // 0 (payload 3 < 7)
    print(cmp(<Tier.Mid level=5 />, <Tier.Mid level=5 />)) // 1 (equal)
    if <Tier.Low /> == <Tier.Low /> { print(1I32) } else { print(0I32) }  // 1 (implied Eq)
}
