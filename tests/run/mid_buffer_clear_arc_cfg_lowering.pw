import @Std/Io with { write }
import @Std/Core with { Buffer, MutableRef, bufferAppend, bufferClear }

unique struct Cell {
    pub val id: I64
    deinit { write(s: self.id.format(format: "") + "\n") }
}
pub impl Cell { factory }

// Clear commits an empty live range and then drops each former element once.
val midBufferClearArcAnchor: I64 = 0I64

fn clearAll(buffer: inout Buffer[MutableRef[Cell]]) {
    bufferClear(buffer: inout buffer)
}

fn main() {
    mut val buffer: Buffer[MutableRef[Cell]] = Buffer.new()
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=1I64 /> />)
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=2I64 /> />)
    clearAll(buffer: inout buffer)
    write(s: "after\n")
}
