import @Std/Io with { write }
import @Std/Core with { Buffer, MutableRef, bufferAppend, bufferRemoveLast }

unique struct Cell {
    pub val id: I64
    deinit { write(s: self.id.format(format: "") + "\n") }
}
pub impl Cell { factory }

// Pop transfers the Buffer's sole live-element share into the return result.
val midBufferRemoveLastArcAnchor: I64 = 0I64

fn popOne(buffer: inout Buffer[MutableRef[Cell]]) -> MutableRef[Cell] {
    return bufferRemoveLast(buffer: inout buffer)
}

fn main() {
    mut val buffer: Buffer[MutableRef[Cell]] = Buffer.new()
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=1I64 /> />)
    val popped: MutableRef[Cell] = popOne(buffer: inout buffer)
    write(s: "after\n")
}
