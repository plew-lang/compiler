import @Std/Io with { print }

// Member visibility (spec/05), per-field: `pub(get)` reads publicly but is written
// only inside the type's anonymous impl; `pub` is read+write public; unmarked is
// private (anonymous impl only). A `pub impl` method is part of the anonymous impl,
// so it may read the private field and write the pub(get) one.
struct Counter {
    pub(get) mut val count: U64
    pub mut val tag: U64
    mut val secret: U64
}

pub impl Counter {
    factory start(count: U64, tag: U64, secret: U64) {
        return <Counter count=count tag=tag secret=secret />
    }
    inout fn bump() {
        self.count = self.count + self.secret
    }
    fn revealSecret() -> U64 { return self.secret }
}

fn main() {
    mut val c = <Counter.start count=5U64 tag=7U64 secret=3U64 />
    print(c.count)            // pub(get): read OK
    print(c.tag)              // pub: read OK
    c.tag = 9U64              // pub: write OK
    print(c.tag)
    c.bump()                  // method writes count (pub(get)) + reads secret (private)
    print(c.count)
    print(c.revealSecret())   // private read via method
}
