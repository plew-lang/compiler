// spec/03 pins: (S1) named locals destroy in REVERSE declaration order at scope
// exit (locals can depend on earlier locals — the dependent side dies first);
// (S4) a shadowed `unique` binding is released at the redeclaration commit
// point — the old owner becomes inaccessible before the next statement.
import @Std/Io with { print }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}

fn locals() {
    val a = <Cell v=1 />
    val b = <Cell v=2 />
    val c = <Cell v=3 />
    print(100I32)
}

fn shadowed() {
    val c = <Cell v=1 />
    val c = <Cell v=2 />
    print(200I32)
}

fn main() {
    locals()
    shadowed()
}
