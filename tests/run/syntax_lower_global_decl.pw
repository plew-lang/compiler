import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "val answer: I8 = 42I8\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0U64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.lowerSyntaxTopItem(item: syntaxFileTopLevel(file: file, index: 0U64))
    print(c.arena.globals.count())
}
