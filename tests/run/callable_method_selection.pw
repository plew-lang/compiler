import @Std/Io with { write }
import /Frontend with { Comp }
import /Ir with { ArgRange, Bind, Func, MethodAlias }
fn add(c: inout Comp, receiver: Bind, name: Bind, traitId: U64 = 0U64, extensionId: U64 = 0U64, viewOnly: Bool = false, hasReceiver: Bool = true) -> U64 {
    val index = c.arena.funcs.count()
    c.arena.funcs.append(<Func nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId
        hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64
        hasRecv=hasReceiver recvStart=receiver.nameStart recvLen=receiver.nameLen recvId=receiver.nameId
        selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false
        isProvided=traitId != 0U64 srcTraitId=traitId srcTraitOwner=traitId extId=extensionId viewOnly=viewOnly />)
    c.registerCallable(funcIdx: index)
    return index
}
fn selected(c: inout Comp, receiver: Bind, name: Bind) -> U64 {
    return c.findMethod(recvStart: receiver.nameStart, recvLen: receiver.nameLen, nameStart: name.nameStart, nameLen: name.nameLen, args: <ArgRange start=0U64 len=0U64 />)
}
fn main() {
    mut val c: Comp = <Comp />
    val receiver = c.internBytes(s: "Sample")
    val other = c.internBytes(s: "Other")
    val name = c.internBytes(s: "pick")
    val unrelated = c.internBytes(s: "unrelated")
    val traitName = c.internBytes(s: "Choice")
    val extensionName = c.internBytes(s: "Extra")
    if selected(c: inout c, receiver: receiver, name: name) != c.arena.funcs.count() { panic "missing method" }
    add(c: inout c, receiver: receiver, name: name, extensionId: extensionName.nameId)
    add(c: inout c, receiver: receiver, name: name, viewOnly: true)
    add(c: inout c, receiver: receiver, name: name, hasReceiver: false)
    add(c: inout c, receiver: other, name: name)
    add(c: inout c, receiver: receiver, name: unrelated)
    if selected(c: inout c, receiver: receiver, name: name) != c.arena.funcs.count() { panic "ineligible method selected" }
    val provided = add(c: inout c, receiver: receiver, name: name, traitId: traitName.nameId)
    if selected(c: inout c, receiver: receiver, name: name) != provided { panic "provided method missing" }
    val inherent = add(c: inout c, receiver: receiver, name: name)
    if selected(c: inout c, receiver: receiver, name: name) != inherent { panic "inherent priority changed" }
    val alias = c.internBytes(s: "alias")
    c.decls.methodAliases.append(<MethodAlias recvStart=receiver.nameStart recvLen=receiver.nameLen recvId=receiver.nameId aliasStart=alias.nameStart aliasLen=alias.nameLen aliasId=alias.nameId realStart=name.nameStart realLen=name.nameLen realId=name.nameId />)
    if selected(c: inout c, receiver: receiver, name: alias) != inherent { panic "alias retry changed" }
    write(s: "callable-method-selection-ok\n")
}
