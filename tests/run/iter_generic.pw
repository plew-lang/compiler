import @Std/Io with { print }
import @Std/Core with { Iterator, Iterable }

struct BoxIter[T] {
    pub val items: Array[T]
    pub mut val i: U64
}
pub impl[T] BoxIter[T] as Iterator {
    type Item = T
    inout fn next() -> Optional[T] {
        if self.i >= self.items.count {
            return <Optional.None />
        }
        val v: T = self.items[self.i]
        self.i = self.i + 1
        return <Optional.Some v=v />
    }
}
struct Box[T] {
    pub val items: Array[T]
}
pub impl[T] Box[T] as Iterable {
    type Item = T
    type Iter = BoxIter[T]
    fn iterator() -> BoxIter[T] {
        return <BoxIter[T] items=self.items i=0U64 />
    }
}
fn main() {
    val b: Box[I64] = <Box[I64] items=[5, 6, 7] />
    for val x in b {
        print(x)
    }
}
