struct Box {
    val xs: Array[I64]
}
fn sum(b: Box) -> I64 {
    mut val s: I64 = 0
    mut val i: U64 = 0
    while i < b.xs.count {
        s += b.xs[i]
        i += 1
    }
    return s
}
fn countA(s: String) -> I64 {
    val bs: Array[U8] = s.bytes
    mut val n: I64 = 0
    mut val i: U64 = 0
    while i < bs.count {
        if bs[i] == 97 {
            n += 1
        }
        i += 1
    }
    return n
}
fn main() {
    mut val xs: Array[I64] = []
    xs.append(10)
    xs.append(20)
    xs.append(12)
    val b: Box = <Box xs=xs />
    print(sum(b: b))
    print(countA(s: "banana"))
}
