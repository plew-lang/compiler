// Dictionary[K,V] literals (spec/02): `[k: v, ...]` builds a dictionary, `[:]` is
// the empty one. The K/V types come from the binding/return context (an annotated
// `let`/`return`), like the empty array literal. Construction is move-out (no deep
// copy of the freshly built dictionary), and the result is a normal owned value:
// copying it is a CoW copy, so later mutation of the copy does not touch the source.
import @Std/Io with { print }

fn build() -> Dictionary[U64, U64] {
    return [1U64: 100U64, 2U64: 200U64]
}

fn main() {
    // string keys, with a duplicate key (last write wins -> count stays 2)
    val d: Dictionary[String, U64] = ["alpha": 1U64, "beta": 2U64, "alpha": 10U64]
    print(d.count)
    print(d["alpha"])
    print(d["beta"])
    print(d.getOr(key: "gamma", fallback: 99U64))

    // empty literal
    val e: Dictionary[String, U64] = [:]
    print(e.count)

    // return-position literal + post-construction mutation
    mut val f: Dictionary[U64, U64] = build()
    f[3U64] = 300U64
    print(f.count)
    print(f[1U64])
    print(f[3U64])

    // value semantics: copying then mutating the copy leaves the source untouched
    val g: Dictionary[String, U64] = ["x": 1U64]
    mut val h: Dictionary[String, U64] = g
    h["y"] = 2U64
    print(g.count)
    print(h.count)
}
