import @Std/Io with { print }

// The specialized second edge is reachable only with T == I64, but returns
// A[String]. A pairwise matcher would incorrectly unify the first A[T] with
// that result; a path-local substitution must preserve T == I64 and accept.
trait A[Item] {}
trait B[Item] {}

impl[T] A[T] as B[T] {}
impl B[I64] as A[String] {}

fn main() {
    print(1I64)
}
