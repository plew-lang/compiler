import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxDeclVariant, syntaxVariant, syntaxVariantFieldCount, syntaxVariantField, syntaxField, syntaxType, DeclId }
import @Std/Io with { print }

fn main() {
    val source = "enum Result { Ok(value: U64) }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val variant = syntaxVariant(file: file, id: syntaxDeclVariant(file: file, decl: decl, index: 0U64))
    val field = syntaxField(file: file, id: syntaxVariantField(file: file, variant: variant, index: 0U64))
    print(syntaxVariantFieldCount(file: file, variant: variant))
    print(variant.name.end - variant.name.start)
    print(field.name.end - field.name.start)
    val ty = syntaxType(file: file, id: field.ty)
    print(ty.name.end - ty.name.start)
}
