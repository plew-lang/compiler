import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxTrait, syntaxTraitTypeParamCount, syntaxTraitTypeParamSpan, syntaxTraitSupertraitCount, syntaxTraitSupertraitSpan, syntaxTraitAssocTypeCount, syntaxTraitAssocTypeSpan, syntaxTraitReqCount, syntaxTraitReq, syntaxSig, syntaxSigTypeParamCount, syntaxSigTypeParamSpan, syntaxSigParamCount, syntaxSigParam, syntaxParam, TraitId }
import @Std/Io with { print }

fn main() {
    val source = "trait Stream[T]: Eq { type Item; fn next[U](value~: U) -> Item }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val trait = syntaxTrait(file: file, id: <TraitId raw=syntaxTopItemPayload(file: file, item: item) />)
    val req = syntaxSig(file: file, id: syntaxTraitReq(file: file, trait: trait, index: 0U64))
    print(syntaxTraitTypeParamCount(file: file, trait: trait))
    val typeParam = syntaxTraitTypeParamSpan(file: file, trait: trait, index: 0U64)
    print(typeParam.end - typeParam.start)
    print(syntaxTraitSupertraitCount(file: file, trait: trait))
    val supertrait = syntaxTraitSupertraitSpan(file: file, trait: trait, index: 0U64)
    print(supertrait.end - supertrait.start)
    print(syntaxTraitAssocTypeCount(file: file, trait: trait))
    val assoc = syntaxTraitAssocTypeSpan(file: file, trait: trait, index: 0U64)
    print(assoc.end - assoc.start)
    print(syntaxTraitReqCount(file: file, trait: trait))
    print(req.name.end - req.name.start)
    if req.hasRet { print(1U64) } else { print(0U64) }
    print(syntaxSigTypeParamCount(file: file, sig: req))
    val reqTypeParam = syntaxSigTypeParamSpan(file: file, sig: req, index: 0U64)
    print(reqTypeParam.end - reqTypeParam.start)
    print(syntaxSigParamCount(file: file, sig: req))
    val reqParam = syntaxParam(file: file, id: syntaxSigParam(file: file, sig: req, index: 0U64))
    print(reqParam.name.end - reqParam.name.start)
    if reqParam.noLabel { print(1U64) } else { print(0U64) }
}
