import @Std/Io with { print, write }

struct Sized { pub val n: U64  pub val tag: String }
pub impl Sized { factory }

fn makeSized() -> Sized {
    return <Sized n=3U64 tag="he" + "ap" />
}

fn main() {
    mut val total: U64 = 0
    for i in 0U64 ..< makeSized().n {
        total += i
    }
    print(total)
}
