import @Std/Io with { print }
fn main() {
    mut val z0: Array[I64] = [0]
    mut val z1: Array[I64] = [0]
    mut val outer: Array[Array[I64]] = []
    outer.append(z0)
    outer.append(z1)
    mut val a: Array[I64] = [1, 2, 3]
    outer[0] = a
    a.set(i: 0, value: 99)
    print(outer[0][0])
    mut val b: Array[I64] = [7, 8]
    outer.set(i: 1, value: b)
    b.set(i: 0, value: 88)
    print(outer[1][0])
    mut val cc: Array[I64] = [5, 6]
    mut val lit: Array[Array[I64]] = [cc]
    cc.set(i: 0, value: 77)
    print(lit[0][0])
}
