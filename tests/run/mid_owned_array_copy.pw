import @Std/Io with { write }
trait Named { fn name() -> String }
struct Payload { pub val text: String }
pub impl Payload { factory }
pub impl Payload as Named { fn name() -> String { return self.text } }
fn copyBoundary(payloads: Array[Payload]) -> Array[any Named] { return payloads }
fn exercise() {
    val payloads: Array[Payload] = [<Payload text=("heap" + "\n") />]
    val erased: Array[any Named] = copyBoundary(payloads: payloads)
    write(s: erased[0U64].name())
    write(s: payloads[0U64].text)
}

fn main() {
    exercise()
    exercise()
    exercise()
}
