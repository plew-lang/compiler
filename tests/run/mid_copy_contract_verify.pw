import @Std/Io with { print }
import @Std/Core with { assert }
import /Frontend with { Comp }
import /Ir with { FinalDestruction }
import /Mid with { MidBody, MidBlock, MidTerminator, MidOperand, MidPlace, MidLocalDecl, MidVerifyError, verifyCanonicalMidBody, verifyExecutableCanonicalMidBody }

fn main() {
    mut val compiler: Comp = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internBytes(s: "String")
    val type = compiler.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    val place: MidPlace = <MidPlace local=0U64 typeTerm=type />
    val draft: MidBody = <MidBody locals=[<MidLocalDecl typeTerm=type sourceScope=0U64 isUnique=false isParameter=true />] blocks=[<MidBlock terminator=<MidTerminator.ReturnValue value=<MidOperand.Copy place=place /> /> />] />
    val body = compiler.mid.store(body: draft)
    match verifyCanonicalMidBody(c: inout compiler, canonical: body).error {
        MidVerifyError.None => {}
        _ => { assert(false) }
    }
    match verifyExecutableCanonicalMidBody(c: inout compiler, canonical: body).error {
        MidVerifyError.MissingOwnershipContract => {}
        _ => { assert(false) }
    }
    compiler.enqueueFinalDestruction(typeRef: type)
    match verifyExecutableCanonicalMidBody(c: inout compiler, canonical: body).error {
        MidVerifyError.None => {}
        _ => { assert(false) }
    }
    val identity = compiler.finalDestructionIndex(typeRef: type)
    compiler.arena.finalDestructions[identity - 1U64] = <FinalDestruction typeRef=type />
    match verifyExecutableCanonicalMidBody(c: inout compiler, canonical: body).error {
        MidVerifyError.MissingOwnershipContract => {}
        _ => { assert(false) }
    }
    print("ok")
}
