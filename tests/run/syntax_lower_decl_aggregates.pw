import @Plew/Syntax with { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "struct Box[T] { val value: T deinit {} }\nenum Choice[T] { Some(value: T) None }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.lowerSyntaxStructDecl(d: syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />))
    c.lowerSyntaxEnumDecl(d: syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 1U64)) />))
    print(c.arena.structs.count())
    print(c.arena.structs[0U64].fields.count())
    print(c.arena.structs[0U64].typeParams.count())
    print(c.arena.funcs.count())
    print(c.decls.deinits.count())
    print(c.arena.enums.count())
    print(c.arena.enums[0U64].variants.count())
    print(c.arena.enums[0U64].variants[0U64].fields.count())
}
