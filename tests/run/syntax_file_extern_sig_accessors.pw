import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxExtern, syntaxExternFnCount, syntaxExternFn, syntaxSig, ExternId }
import @Std/Io with { print }

fn main() {
    val source = "extern(plewIntrinsic) { fn raw() -> U64 }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val ext = syntaxExtern(file: file, id: <ExternId raw=syntaxTopItemPayload(file: file, item: item) />)
    val sig = syntaxSig(file: file, id: syntaxExternFn(file: file, ext: ext, index: 0U64))
    print(syntaxExternFnCount(file: file, ext: ext))
    print(sig.name.end - sig.name.start)
    if sig.hasRet { print(1U64) } else { print(0U64) }
}
