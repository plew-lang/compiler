// The compiler-facing SyntaxFile parser records a cast as one direct node with
// its target TypeId.  Keep this separate from the macro materializer fixture:
// it proves the persistent carrier itself never needs ExprAst -> freeze.
import @Plew/Syntax with { DeclId, Lexer, P, SyntaxExprKind, lex, parseProgramSyntaxFile, syntaxBlock, syntaxBlockStmt, syntaxDecl, syntaxExpr, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload, syntaxType }
import @Std/Io with { print }

fn main() {
    val source = "fn main() {\n    val value = 1U8 as U64\n}\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val root = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: root) />)
    val block = syntaxBlock(file: file, id: decl.body)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: block, index: 0U64))
    val expression = syntaxExpr(file: file, id: stmt.child0)
    match expression.kind {
        SyntaxExprKind.Cast => { print(1U64) }
        _ => { print(0U64) }
    }
    val target = syntaxType(file: file, id: expression.type0)
    print(target.name.end - target.name.start)
}
