import @Std/Io with { print }
import @Std/Core with { Buffer }
extern "plew-intrinsic" {
    fn rawAlloc(cap: U64, of: I64) -> Buffer[I64]
    fn rawLoad(b: Buffer[I64], i: U64) -> I64
    fn rawStore(b: Buffer[I64], i: U64, v: I64)
    fn rawCap(b: Buffer[I64]) -> U64
    fn rawIsUnique(b: Buffer[I64]) -> Bool
}
struct VecI {
    pub mut val data: Buffer[I64]
    pub mut val count: U64
}
pub impl VecI {
    inout fn push(value~: I64) {
        val cap: U64 = rawCap(b: self.data)
        mut val grow: Bool = true
        if rawIsUnique(b: self.data) {
            if self.count < cap {
                grow = false
            }
        }
        if grow {
            mut val newCap: U64 = cap * 2U64
            if newCap < 4U64 {
                newCap = 4U64
            }
            mut val nb: Buffer[I64] = rawAlloc(cap: newCap, of: value)
            mut val i: U64 = 0
            while i < self.count {
                rawStore(b: nb, i: i, v: rawLoad(b: self.data, i: i))
                i = i + 1
            }
            self.data = nb
        }
        rawStore(b: self.data, i: self.count, v: value)
        self.count = self.count + 1
    }
    fn at(i: U64) -> I64 {
        return rawLoad(b: self.data, i: i)
    }
}
fn main() {
    mut val v: VecI = <VecI data=rawAlloc(cap: 2U64, of: 0I64) count=0U64 />
    v.push(10I64)
    v.push(20I64)
    v.push(30I64)
    print(v.at(i: 0U64))
    print(v.at(i: 2U64))
    print(v.count)
    val w: VecI = v
    v.push(40I64)
    print(v.count)
    print(w.count)
    print(w.at(i: 0U64))
}
