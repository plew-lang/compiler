// SyntaxFile expression lowering consumes source spans directly.  In particular,
// unary minus must retain the value-AST rule that folds only a bare integer literal.
import @Plew/Syntax with { Lexer, P, StmtId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }
import /Ir with { Expr }

fn main() {
    val source = "val answer = -2I8 + 5I8\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val stmt = syntaxStmt(file: file, id: <StmtId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val root = c.lowerSyntaxExpr(id: stmt.child0)
    print(c.arena.exprs.count())
    match c.arena.exprs[root] {
        Expr.Binary(op: _, lhs: val lhs, rhs: val rhs) => {
            match c.arena.exprs[lhs] {
                Expr.Int(value: val value, offset: _, isBool: _, tyStart: _, tyLen: val len, isNeg: val neg) => {
                    print(value)
                    if neg { print(1U64) } else { print(0U64) }
                    print(len)
                }
                _ => {
                    print(99U64)
                    print(99U64)
                    print(99U64)
                }
            }
            match c.arena.exprs[rhs] {
                Expr.Int(value: val value, offset: _, isBool: _, tyStart: _, tyLen: val len, isNeg: val neg) => {
                    print(value)
                    if neg { print(1U64) } else { print(0U64) }
                    print(len)
                }
                _ => {
                    print(99U64)
                    print(99U64)
                    print(99U64)
                }
            }
        }
        _ => {
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
        }
    }
}
