import @Std/Io with { print }
import @Std/Core with { assert }
import /Frontend with { Comp }
import /Ir with { TypeRef, InstanceEnvironment, Bind, Func }
import /Mid with { MidBody, MidBlock, MidScope, MidLocalDecl, MidPlace, MidOperand, MidBorrowCapability, MidRvalue, MidStatement, MidTerminator, MidInstantiateError, instantiateCanonicalMidBody, verifyCanonicalMidBody }
import /Mid/Verify with { MidVerifyError }

fn check(compiler: inout Comp, sourceType: U64, targetType: U64, valid: Bool, borrowed: Bool = false) {
    val source = <MidPlace local=0U64 typeTerm=sourceType />
    mut val operand: MidOperand = <MidOperand.Copy place=source />
    if borrowed { operand = <MidOperand.Borrow place=source capability=<MidBorrowCapability.Read /> /> }
    val target = <MidPlace local=1U64 typeTerm=targetType />
    val body = compiler.mid.store(body: <MidBody locals=[<MidLocalDecl typeTerm=sourceType sourceScope=0U64 isUnique=false isParameter=true />, <MidLocalDecl typeTerm=targetType sourceScope=0U64 isUnique=false isParameter=false />] scopes=[<MidScope firstLocal=0U64 localCount=2U64 />] blocks=[<MidBlock statements=[<MidStatement.Assign destination=target value=<MidRvalue.ViewBoundary operand=operand targetTerm=targetType /> />] terminator=<MidTerminator.Return /> />] />)
    assert(compiler.mid.isWellFormed(body: body))
    match verifyCanonicalMidBody(c: inout compiler, canonical: body).error {
        MidVerifyError.UninstantiatedCastBoundary => {}
        _ => { panic "unchecked view passed verification" }
    }
    val bodyId = compiler.internBodyInstance(fnIdx: 0U64, environment: <InstanceEnvironment />)
    val result = instantiateCanonicalMidBody(c: inout compiler, body: body, bodyId: bodyId)
    if valid {
        match result.error { MidInstantiateError.None => {} _ => { panic "valid view rejected" } }
        val block = compiler.mid.blocks[compiler.mid.bodies[result.body.body - 1U64].blocks.start]
        val statement = compiler.mid.statements[block.statements.start]
        val value = compiler.mid.rvalues[statement.value - 1U64]
        assert(value.tag == 10U64)
        assert(compiler.typeRefEq(a: value.targetTerm, b: targetType))
    } else {
        match result.error { MidInstantiateError.InvalidCastResolution => {} _ => { panic "view changed underlying type" } }
    }
}

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val first = compiler.internBytes(s: "First")
    val second = compiler.internBytes(s: "Second")
    val container = compiler.internBytes(s: "Container")
    val source = compiler.pushType(t: <TypeRef nameStart=first.nameStart nameLen=first.nameLen args=[] />)
    val viewed = compiler.pushType(t: <TypeRef nameStart=first.nameStart nameLen=first.nameLen args=[] viewExtId=1U64 />)
    val other = compiler.pushType(t: <TypeRef nameStart=second.nameStart nameLen=second.nameLen args=[] />)
    val plainContainer = compiler.pushType(t: <TypeRef nameStart=container.nameStart nameLen=container.nameLen args=[source] />)
    val outerView = compiler.pushType(t: <TypeRef nameStart=container.nameStart nameLen=container.nameLen args=[source] viewExtId=1U64 />)
    val innerView = compiler.pushType(t: <TypeRef nameStart=container.nameStart nameLen=container.nameLen args=[viewed] />)
    check(compiler: inout compiler, sourceType: source, targetType: viewed, valid: true)
    check(compiler: inout compiler, sourceType: viewed, targetType: source, valid: true)
    check(compiler: inout compiler, sourceType: source, targetType: other, valid: false)
    check(compiler: inout compiler, sourceType: plainContainer, targetType: outerView, valid: true)
    check(compiler: inout compiler, sourceType: plainContainer, targetType: innerView, valid: false)
    check(compiler: inout compiler, sourceType: source, targetType: viewed, valid: false, borrowed: true)
    // A closed nominal spelling is independent of another declaration's binder.
    val parameters = compiler.pushFuncBinds(binds: [<Bind nameStart=first.nameStart nameLen=first.nameLen nameId=first.nameId paramId=71U64 fieldStart=0U64 fieldLen=0U64 />])
    compiler.arena.registerFunction(<Func nameStart=0U64 nameLen=0U64 typeParams=parameters hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64 hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    assert(compiler.arena.hasTypeParameterName(nameId: first.nameId))
    check(compiler: inout compiler, sourceType: source, targetType: viewed, valid: true)
    val parameter = compiler.pushType(t: <TypeRef nameStart=first.nameStart nameLen=first.nameLen paramId=71U64 args=[] />)
    val openContainer = compiler.pushType(t: <TypeRef nameStart=container.nameStart nameLen=container.nameLen args=[parameter] />)
    val openExistential = compiler.pushType(t: <TypeRef nameStart=container.nameStart nameLen=container.nameLen args=[parameter] isAny=true />)
    check(compiler: inout compiler, sourceType: parameter, targetType: parameter, valid: false)
    check(compiler: inout compiler, sourceType: openContainer, targetType: openContainer, valid: false)
    check(compiler: inout compiler, sourceType: openExistential, targetType: openExistential, valid: false)
    print("ok")
}
