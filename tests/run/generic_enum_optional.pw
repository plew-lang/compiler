import @Std/Io with { print }

enum Optional[T] {
    Some(v: T)
    None
}

fn main() {
    val a: Optional[I32] = <Optional[I32].Some v=42 />
    val b: Optional[I32] = <Optional[I32].None />
    match a {
        Optional.Some(val v) => { print(v) }
        Optional.None => { print(0I64) }
    }
    match b {
        Optional.Some(val v) => { print(v) }
        Optional.None => { print(99I64) }
    }
}
