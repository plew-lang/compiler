import @Std/Io with { print }

// `Dictionary.get(key:) -> Optional[V]` (spec/02): the safe, non-panicking lookup
// (vs `dict[key]` which panics on a missing key). Returns `Some(v)` / `None`.
fn main() {
    val d: Dictionary[String, I64] = ["a": 1I64, "b": 2I64]
    match d.get(key: "b") {
        Optional.Some(val v) => { print(v) }      // 2
        Optional.None => { print(0I64) }
    }
    match d.get(key: "missing") {
        Optional.Some(val v) => { print(v) }
        Optional.None => { print(0I64) }          // 0
    }
    // bind the Optional, then unwrapOr (Optional is ambient).
    val hit: Optional[I64] = d.get(key: "a")
    print(hit.unwrapOr(fallback: 99I64))          // 1
    val miss: Optional[I64] = d.get(key: "z")
    print(miss.unwrapOr(fallback: 99I64))         // 99
}
