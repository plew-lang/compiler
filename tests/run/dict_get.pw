import @Std/Io with { print }

// `Dictionary.get(key:) -> Optional[V]` (spec/02): the safe, non-panicking lookup
// (vs `dict[key]` which panics on a missing key). Returns `Some(v)` / `None`, and
// chains fluently (`.unwrapOr(...)`) since the call result's instance type is tracked.
fn main() {
    val d: Dictionary[String, I64] = ["a": 1I64, "b": 2I64]
    match d.get(key: "b") {
        Optional.Some(val v) => { print(v) }      // 2
        Optional.None => { print(0I64) }
    }
    match d.get(key: "missing") {
        Optional.Some(val v) => { print(v) }
        Optional.None => { print(0I64) }          // 0
    }
    print(d.get(key: "a").unwrapOr(fallback: 99I64))   // 1
    print(d.get(key: "z").unwrapOr(fallback: 99I64))   // 99
}
