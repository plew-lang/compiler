import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}

struct Holder {
    pub val r: MutableRef[Cell]
}

pub impl Holder {
    factory
}

fn makeHolder() -> Holder {
    val h: Holder = <Holder r=<MutableRef value=<Cell v=21I32 /> /> />
    return h
}

fn main() {
    val h: Holder = makeHolder()
    print("bound")
}
