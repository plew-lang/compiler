import @Std/Io with { print }
import @Std/Core with { Ref }
struct Bag { pub mut val items: Array[I32] }
fn main() {
    val r: Ref[Bag] = <Ref[Bag] value=<Bag items=[1, 2, 3] /> />
    val s: Ref[Bag] = r
    r->items[0] = 99
    print(r->items[0])
    print(s->items[0])
    print(s->items.count())
}
