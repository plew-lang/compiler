// Format trait implemented in pure Plew for the primitive integer types (Core
// owns I64/U64 via `extern struct`, so it may coherently `impl I64 as Format`).
// Integer -> decimal String via the stringFromBytesUnchecked intrinsic + digit logic.
import @Std/Core with { Format }
import @Std/Io with { write }

fn main() {
    write(s: (0I64).format(format: ""))
    write(s: "\n")
    write(s: (42I64).format(format: ""))
    write(s: "\n")
    write(s: (-1234I64).format(format: ""))
    write(s: "\n")
    write(s: (18446744073709551615U64).format(format: ""))
    write(s: "\n")
}
