// Value-position `if` with `give`: each branch is a block that yields a value.
import @Std/Io with { print }

fn classify(n: I64) -> I64 {
    // else-if chain in value position
    val r: I64 = if n < 0 {
        give 0 - 1
    } else if n == 0 {
        give 0
    } else {
        give 1
    }
    return r
}

fn main() {
    val a: I64 = if 3 > 2 {
        val x: I64 = 10
        give x + 5
    } else {
        give 0
    }
    print(a)                 // 15I64
    print(classify(n: 0I64 - 7I64))    // -1I64
    print(classify(n: 0I64))    // 0I64
    print(classify(n: 42I64))   // 1I64
    // nested directly in an expression
    print(1I64 + if true { give 100I64 } else { give 200I64 })   // 101I64
}
