import @Std/Io with { print }

// A user-defined two-parameter generic enum (named to NOT shadow the ambient
// lang-item `Result`).
enum Either[T, E] {
    Ok(value: T)
    Err(error: E)
}

fn classify(n: I32) -> Either[I32, U8] {
    if n > 0 {
        return <Either[I32, U8].Ok value=n />
    }
    return <Either[I32, U8].Err error=2 />
}

fn main() {
    val r: Either[I32, U8] = classify(n: 7)
    val msg: I32 = match r {
        Either.Ok(val value) => value
        Either.Err(val error) => 0 - (error as I32)
    }
    print(msg)
    val r2: Either[I32, U8] = classify(n: 0 - 5)
    match r2 {
        Either.Ok(val value) => { print(value) }
        Either.Err(val error) => { print(error) }
    }
}
