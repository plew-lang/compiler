// The source-level loop test pins observable behaviour. This companion pins
// the Mid producer itself: both exits must first leave the body scope, then
// branch to the selected loop target without an LLVM-side cleanup convention.
import @Std/Io with { write }
import /Frontend with { Comp }
import /Ir with { Block, Expr, Stmt }
import /Mid with { MidBlock, MidBuildError, MidBuildState, MidStatement, MidTerminator, buildMidBlock }

fn built(result: MidBuildError) -> Bool {
    match result {
        MidBuildError.None => { return true }
        _ => { return false }
    }
}

fn hasScopeExit(block: MidBlock, scope: U64) -> Bool {
    if block.statements.count() == 0U64 { return false }
    match block.statements[0U64] {
        MidStatement.ScopeExit(scope: val actual) => { return actual == scope }
        _ => { return false }
    }
}

fn breakBuilderWorks() -> Bool {
    mut val c: Comp = <Comp />
    c.arena.exprs.append(<Expr.Int value=1U64 offset=0U64 isBool=true tyStart=0U64 tyLen=0U64 isNeg=false />)
    c.arena.stmts.append(<Stmt.Break offset=0U64 />)
    c.arena.blockStmtPool.append(0U64)
    c.arena.blocks.append(<Block stmtStart=0U64 stmtLen=1U64 />)
    c.arena.stmts.append(<Stmt.While cond=0U64 body=0U64 />)
    c.arena.blockStmtPool.append(1U64)
    c.arena.blocks.append(<Block stmtStart=1U64 stmtLen=1U64 />)
    mut val state: MidBuildState = <MidBuildState blocks=[<MidBlock />] />
    val result: MidBuildError = buildMidBlock(c: inout c, state: inout state, blockId: 1U64)
    if !built(result: result) || state.blocks.count() != 4U64 { return false }
    if !hasScopeExit(block: state.blocks[2U64], scope: 2U64) { return false }
    match state.blocks[2U64].terminator {
        MidTerminator.Goto(target: val target) => { return target == 3U64 }
        _ => { return false }
    }
}

fn continueBuilderWorks() -> Bool {
    mut val c: Comp = <Comp />
    c.arena.exprs.append(<Expr.Int value=1U64 offset=0U64 isBool=true tyStart=0U64 tyLen=0U64 isNeg=false />)
    c.arena.stmts.append(<Stmt.Continue offset=0U64 />)
    c.arena.blockStmtPool.append(0U64)
    c.arena.blocks.append(<Block stmtStart=0U64 stmtLen=1U64 />)
    c.arena.stmts.append(<Stmt.While cond=0U64 body=0U64 />)
    c.arena.blockStmtPool.append(1U64)
    c.arena.blocks.append(<Block stmtStart=1U64 stmtLen=1U64 />)
    mut val state: MidBuildState = <MidBuildState blocks=[<MidBlock />] />
    val result: MidBuildError = buildMidBlock(c: inout c, state: inout state, blockId: 1U64)
    if !built(result: result) || state.blocks.count() != 4U64 { return false }
    if !hasScopeExit(block: state.blocks[2U64], scope: 2U64) { return false }
    match state.blocks[2U64].terminator {
        MidTerminator.Goto(target: val target) => { return target == 1U64 }
        _ => { return false }
    }
}

fn main() {
    if breakBuilderWorks() && continueBuilderWorks() {
        write(s: "loop-exit-builder\n")
    } else {
        write(s: "wrong-loop-exit-builder\n")
    }
}
