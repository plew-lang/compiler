// discarded removal results are statement temps (spec/03): pop() / removeAt() /
// removeLast() release the removed element at that statement's end; clear()
// releases every remaining element at the call.
import @Std/Io with { print }
import @Std/Core with { Ref }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}

fn popRemoveAt() {
    mut val xs: Array[Ref[Cell]] = []
    xs.append(<Ref[Cell] value=<Cell v=1 /> />)
    xs.append(<Ref[Cell] value=<Cell v=2 /> />)
    xs.append(<Ref[Cell] value=<Cell v=3 /> />)
    xs.pop()
    print(100I32)
    xs.removeAt(index: 0U64)
    print(200I32)
}

fn removeLastClear() {
    mut val xs: Array[Ref[Cell]] = []
    xs.append(<Ref[Cell] value=<Cell v=4 /> />)
    xs.append(<Ref[Cell] value=<Cell v=5 /> />)
    xs.append(<Ref[Cell] value=<Cell v=6 /> />)
    xs.removeLast()
    print(300I32)
    xs.clear()
    print(400I32)
}

fn main() {
    popRemoveAt()
    removeLastClear()
}
