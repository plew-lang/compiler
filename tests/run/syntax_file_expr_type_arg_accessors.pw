import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxExpr, syntaxExprTypeArgCount, syntaxExprTypeArg, syntaxType, DeclId, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { <Pair[U8] left=1U64 /> }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val expr = syntaxExpr(file: file, id: syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64)).child0)
    val arg = syntaxType(file: file, id: syntaxExprTypeArg(file: file, expr: expr, index: 0U64))
    match expr.kind {
        SyntaxExprKind.Make => { print(1U64) }
        _ => { print(0U64) }
    }
    print(syntaxExprTypeArgCount(file: file, expr: expr))
    print(arg.name.end - arg.name.start)
}
