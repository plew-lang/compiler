import @Std/Io with { print }

// The outer Optional payload is itself Optional[T]. Its conversion proof must
// be frozen per physical payload field, not reconstructed from T's argument
// proof in LLVM.
trait Shape { fn area() -> I64 }
struct Sq { pub val side: I64 }
pub impl Sq { factory }
pub impl Sq as Shape { fn area() -> I64 { return self.side * self.side } }

fn make() -> Optional[Optional[Sq]] {
    return <Optional[Optional[Sq]].Some v=<Optional[Sq].Some v=<Sq side=6I64 /> /> />
}

fn total(value: Optional[Optional[any Shape]]) -> I64 {
    match value {
        Optional.Some(v: val inner) => {
            match inner {
                Optional.Some(v: val shape) => { return shape.area() }
                Optional.None => { return 0I64 }
            }
        }
        Optional.None => { return 0I64 }
    }
}

fn main() { print(total(value: make())) }
