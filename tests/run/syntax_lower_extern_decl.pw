import @Plew/Syntax with { ExternId, Lexer, P, lex, parseProgramSyntaxFile, syntaxExtern, syntaxFileTopLevel, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "extern(plewIntrinsic) { fn raw(value: I8) -> I8 struct Buffer[sendable T] }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.lowerSyntaxExtern(ext: syntaxExtern(file: file, id: <ExternId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />))
    print(c.arena.functionCount())
    print(c.arena.structCount())
    print(c.funcParamCount(params: c.arena.functionAt(index: 0U64).params))
    print(c.traitBindCount(binds: c.arena.structAt(index: 0U64).typeParams))
}
