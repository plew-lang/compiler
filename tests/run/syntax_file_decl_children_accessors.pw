import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxDeclTypeParamCount, syntaxDeclTypeParamSpan, syntaxDeclVariantCount, syntaxDeclVariant, syntaxVariant, syntaxDeclParamCount, syntaxDeclParam, syntaxParam, syntaxDeclWhereCount, syntaxDeclWhereParamSpan, syntaxDeclWhereTraitSpan, syntaxDeclWhereType, syntaxDeclWhereTraitType, syntaxType, DeclId }
import @Std/Io with { print }

fn main() {
    val source = "struct Box[T] { val item: T }\nenum Flag { On }\nfn identity[T](value~: T) -> T where T: Eq { return value }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val box = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val flag = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 1U64)) />)
    val identity = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 2U64)) />)
    val variant = syntaxVariant(file: file, id: syntaxDeclVariant(file: file, decl: flag, index: 0U64))
    val param = syntaxParam(file: file, id: syntaxDeclParam(file: file, decl: identity, index: 0U64))
    val whereType = syntaxType(file: file, id: syntaxDeclWhereType(file: file, decl: identity, index: 0U64))
    val whereTraitType = syntaxType(file: file, id: syntaxDeclWhereTraitType(file: file, decl: identity, index: 0U64))
    print(syntaxDeclTypeParamCount(file: file, decl: box))
    val boxParam = syntaxDeclTypeParamSpan(file: file, decl: box, index: 0U64)
    print(boxParam.end - boxParam.start)
    print(syntaxDeclVariantCount(file: file, decl: flag))
    print(variant.name.end - variant.name.start)
    print(syntaxDeclParamCount(file: file, decl: identity))
    print(param.name.end - param.name.start)
    if param.noLabel { print(1U64) } else { print(0U64) }
    print(syntaxDeclWhereCount(file: file, decl: identity))
    val whereParam = syntaxDeclWhereParamSpan(file: file, decl: identity, index: 0U64)
    val whereTrait = syntaxDeclWhereTraitSpan(file: file, decl: identity, index: 0U64)
    print(whereParam.end - whereParam.start)
    print(whereTrait.end - whereTrait.start)
    print(whereType.name.end - whereType.name.start)
    print(whereTraitType.name.end - whereTraitType.name.start)
}
