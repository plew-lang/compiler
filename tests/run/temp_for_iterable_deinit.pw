import @Std/Io with { print, write }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I64
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Box {
    pub val r: MutableRef[Cell]
}
pub impl Box { factory }

fn makeArr() -> Array[Box] {
    mut val xs: Array[Box] = []
    xs.append(<Box r=<MutableRef value=<Cell v=5 /> /> />)
    xs.append(<Box r=<MutableRef value=<Cell v=6 /> /> />)
    return xs
}

fn main() {
    for b in makeArr() {
        val n: I64 = b.r->v
        print(n + 10)
    }
    write(s: "after\n")
}
