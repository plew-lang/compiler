import @Std/Io with { print }
import @Std/Core with { Ord, Eq, Ordering }

// A hand-written `Ord` with REVERSED ordering: `<` must route through this
// `compare` witness (spec/12: ordering is `Ord` sugar), not a structural field
// compare — so a smaller `n` sorts as "greater". Regression for the operator-
// witness single-source work (the witness body is the truth for `<`, `==`, …).
struct Rev { pub val n: I64 }
pub impl Rev { factory }
impl Rev as Eq {
    assoc fn eq(lhs: Rev, rhs: Rev) -> Bool { return lhs.n == rhs.n }
}
impl Rev as Ord {
    assoc fn compare(lhs: Rev, rhs: Rev) -> Ordering {
        if lhs.n > rhs.n { return <Ordering.Less /> }
        if lhs.n == rhs.n { return <Ordering.Equal /> }
        return <Ordering.Greater />
    }
}

fn main() {
    val a = <Rev n=1I64 />
    val b = <Rev n=2I64 />
    if a < b { print(1I64) } else { print(0I64) }   // reversed -> 0
    if a > b { print(1I64) } else { print(0I64) }   // reversed -> 1
    if a <= b { print(1I64) } else { print(0I64) }  // reversed -> 0
    if a == a { print(1I64) } else { print(0I64) }  // 1
}
