import @Std/Core with { Index }
import @Std/Io with { print }
struct Item { pub val value: I64 }
pub impl Item { factory fn get() -> I64 { return self.value } }
struct Shelf { pub val item: Item }
pub impl Shelf { factory }
pub impl Shelf as Index[U64] { type Output = Item fn index(key: U64) -> Item { return self.item } }
fn main() { val shelf = <Shelf item=<Item value=7I64 /> /> print(shelf[0U64].get()) }
