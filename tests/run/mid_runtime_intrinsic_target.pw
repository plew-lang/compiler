import @Std/Io with { write }
import /Ir with { RuntimeIntrinsic, IoIntrinsic, CallTarget }

fn main() {
    val writeTarget: CallTarget = <CallTarget.RuntimeIntrinsic intrinsic=<RuntimeIntrinsic.Io intrinsic=<IoIntrinsic.Write /> /> />
    val eprintTarget: CallTarget = <CallTarget.RuntimeIntrinsic intrinsic=<RuntimeIntrinsic.Io intrinsic=<IoIntrinsic.Eprint /> /> />
    match writeTarget {
        CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
            match intrinsic {
                RuntimeIntrinsic.Io(intrinsic: val io) => {
                    match io {
                        IoIntrinsic.Write => { write(s: "write\n") }
                        _ => { write(s: "wrong-write\n") }
                    }
                }
                _ => { write(s: "wrong-write\n") }
            }
        }
        _ => { write(s: "wrong-write\n") }
    }
    match eprintTarget {
        CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
            match intrinsic {
                RuntimeIntrinsic.Io(intrinsic: val io) => {
                    match io {
                        IoIntrinsic.Eprint => { write(s: "eprint\n") }
                        _ => { write(s: "wrong-eprint\n") }
                    }
                }
                _ => { write(s: "wrong-eprint\n") }
            }
        }
        _ => { write(s: "wrong-eprint\n") }
    }
}
