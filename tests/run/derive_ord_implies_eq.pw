import @Std/Io with { print }
import @Std/Core with { Ordering }
// @[Ord] implies Eq (spec/08 Ord: Eq) and derives can read PRIVATE fields (the
// derive is part of the type's own impl).
@[Ord]
struct P { val x: I32 }
fn main() {
    val a: P = <P x=1 />
    val b: P = <P x=2 />
    if a == a { print(1I32) } else { print(0I32) }  // 1 (implied Eq)
    if a < b { print(1I32) } else { print(0I32) }    // 1 (Ord)
}
