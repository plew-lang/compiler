// ATTACK: record destructure of a call result — does the MutableRef-typed bind's
// pointee deinit ever run?
import @Std/Io with { print, write }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I64
    deinit { print(self.v) }
}

fn makeRec() -> (tag: String, cell: MutableRef[Cell]) {
    return (tag: "re" + "c", cell: <MutableRef value=<Cell v=3 /> />)
}

fn helper() {
    (val tag, val cell) = makeRec()
    print(tag)
    print(cell->v)
    write(s: "helper-exit\n")
    // deinit 3 must fire at helper scope exit
}

fn main() {
    helper()
    write(s: "post\n")
    // named-local control: identical shape without destructure
    val direct: MutableRef[Cell] = <MutableRef value=<Cell v=4 /> />
    print(direct->v)
    write(s: "end\n")
}
