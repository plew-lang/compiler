// A SyntaxFile receiver call must keep the receiver and method spelling as
// source spans while its argument is lowered through the typed ArgId pool.
// This is intentionally distinct from syntax_lower_call_expr: it exercises
// method (rather than free-call) argument-context selection.
import @Plew/Syntax with { Lexer, P, StmtId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }
import /Ir with { Expr }

fn main() {
    val source = "val answer = receiver.method(argument: 1I8)\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val stmt = syntaxStmt(file: file, id: <StmtId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val root = c.lowerSyntaxExpr(id: stmt.child0)
    print(c.arena.exprs.count())
    match c.arena.exprs[root] {
        Expr.Method(recv: val recv, nameStart: _, nameLen: val nameLen, args: val args) => {
            print(recv)
            match c.arena.exprs[recv] {
                Expr.Ident(start: _, len: val recvLen) => { print(recvLen) }
                _ => { print(99U64) }
            }
            print(nameLen)
            print(args.len)
            val arg = c.arena.argPool[args.start]
            print(arg.expr)
            print(arg.labelLen)
            if arg.hasLabel { print(1U64) } else { print(0U64) }
        }
        _ => {
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
            print(99U64)
        }
    }
}
