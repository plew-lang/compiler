import @Std/Io with { print, write }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I64
    deinit { print(self.v) }
}

struct Holder {
    pub val cell: MutableRef[Cell]
}

fn main() {
    val o: Optional[Holder] = <Optional.Some v=<Holder cell=<MutableRef value=<Cell v=55 /> /> /> />
    val r: Optional[MutableRef[Cell]] = o?.cell
    write(s: "bound\n")
    write(s: "end\n")
}
