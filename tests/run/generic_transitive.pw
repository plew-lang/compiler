import @Std/Io with { print }

// Transitive monomorphization with eager bound checking: outer[U] forwards to
// inner[T], and the bound (Getter) propagates so both bodies type-check.
trait Getter { fn get() -> I64 }
struct A { val n: I64 }
pub impl A as Getter { fn get() -> I64 { return self.n } }
struct B { val m: I64 }
pub impl B as Getter { fn get() -> I64 { return self.m * 10I64 } }

fn inner[T](x: T) -> I64 where T: Getter { return x.get() }
fn outer[U](y: U) -> I64 where U: Getter { return inner(x: y) + 1I64 }

fn main() {
    val a: A = <A n=5 />
    val b: B = <B m=3 />
    print(outer(y: a))   // 5 + 1 = 6
    print(outer(y: b))   // 30 + 1 = 31
}
