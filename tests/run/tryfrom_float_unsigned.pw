// Fallible float -> unsigned integer conversion (spec/12 TryFrom). `as` rejects
// float->int, so the lossy conversion is the named `convert`: truncate toward zero,
// fail on NaN/±inf, a NEGATIVE float (never fits unsigned), or above the target max.
// Backed by the `f64ToU64` (`fptoui`) intrinsic; narrow targets bound-check then trunc.
import @Std/Io with { print }
import @Std/Core with { RangeError }

fn main() {
    val a: Result[U8, RangeError] = <U8.convert from=200.7 />
    print(a.unwrapOr(fallback: 0U8))      // 200 (toward zero)
    val b: Result[U8, RangeError] = <U8.convert from=300.0 />
    print(b.isErr())                       // 1 (> 255)
    val c: Result[U8, RangeError] = <U8.convert from=0.0 - 1.0 />
    print(c.isErr())                       // 1 (negative)
    val d: Result[U64, RangeError] = <U64.convert from=42.9 />
    print(d.unwrapOr(fallback: 0U64))     // 42
    val e: Result[U32, RangeError] = <U32.convert from=4000000000.0 />
    print(e.unwrapOr(fallback: 0U32))     // 4000000000
    val f: Result[U64, RangeError] = <U64.convert from=18446744073709551616.0 />
    print(f.isErr())                       // 1 (>= 2^64)
}
