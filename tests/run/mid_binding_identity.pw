import @Std/Io with { write }
import /Frontend with { Comp }
import /Ir with { StructDef, Expr, Stmt, SemanticExprType, identValueCode }
import /Mid with { MidBuildState, MidBuildError, MidOperand, MidRvalue, MidStatement, addMidLocal, midLocalForBinding, midPlaceForRecordedIdent, buildMidLet }

fn main() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val typeName = c.internBytes(s: "File")
    c.arena.registerStruct(<StructDef nameStart=typeName.nameStart nameLen=typeName.nameLen nameId=typeName.nameId typeParams=[] fields=[] isUnique=true isExtern=false />)
    val valueTerm = c.simpleTypeRef(nameStart: typeName.nameStart, nameLen: typeName.nameLen)
    mut val state: MidBuildState = <MidBuildState.initial sourceFunction=0U64 />
    val firstLocal = addMidLocal(state: inout state, declarationTarget: 10U64, typeTerm: valueTerm, isUnique: true, isParameter: false, ownsAtEntry: false)
    val secondLocal = addMidLocal(state: inout state, declarationTarget: 20U64, typeTerm: valueTerm, isUnique: true, isParameter: false, ownsAtEntry: false)
    val outer = midLocalForBinding(state: state, declarationTarget: 10U64)
    val inner = midLocalForBinding(state: state, declarationTarget: 20U64)
    val missing = midLocalForBinding(state: state, declarationTarget: 30U64)
    c.typeCache.identBind.append(identValueCode())
    c.typeCache.identTarget.append(20U64)
    val place = midPlaceForRecordedIdent(c: inout c, state: state, exprId: 0U64, typeTerm: valueTerm)
    c.typeCache.identTarget.set(i: 0U64, value: 30U64)
    val absentPlace = midPlaceForRecordedIdent(c: inout c, state: state, exprId: 0U64, typeTerm: valueTerm)
    // The initializer moves a real unique input, rather than assigning an integer to File.
    c.typeCache.identTarget.set(i: 0U64, value: 60U64)
    c.arena.exprs.append(<Expr.Ident start=60U64 len=4U64 />)
    c.arena.exprs.append(<Expr.Move operand=0U64 isBorrow=false />)
    c.arena.semanticExprTypes.append(<SemanticExprType term=valueTerm />)
    c.arena.semanticExprTypes.append(<SemanticExprType term=valueTerm />)
    c.typeCache.identBind.append(0I64)
    c.typeCache.identTarget.append(0U64)
    c.arena.stmts.append(<Stmt.Let mutable=false nameStart=40U64 nameLen=1U64 tyStart=0U64 tyLen=0U64 tyIsArray=false ty=valueTerm init=1U64 />)
    mut val letState: MidBuildState = <MidBuildState.initial sourceFunction=0U64 />
    val input = addMidLocal(state: inout letState, declarationTarget: 60U64, typeTerm: valueTerm, isUnique: true, isParameter: true, ownsAtEntry: true)
    val letResult = buildMidLet(c: inout c, state: inout letState, stmtId: 0U64)
    mut val hasAssign: Bool = false
    match letState.blocks[0U64].statements[0U64] {
        MidStatement.Assign(destination: val destination, value: val value) => {
            match value {
                MidRvalue.StorageBoundary(stmtId: val statement, targetTerm: val target, operand: val operand) => {
                    match operand {
                        MidOperand.Move(place: val source) => { hasAssign = statement == 0U64 && target == valueTerm && destination.local == 1U64 && source.local == input }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    c.arena.exprs.append(<Expr.Ident start=40U64 len=1U64 />)
    c.arena.exprs.append(<Expr.Move operand=2U64 isBorrow=false />)
    c.arena.semanticExprTypes.append(<SemanticExprType term=valueTerm />)
    c.arena.semanticExprTypes.append(<SemanticExprType term=valueTerm />)
    c.typeCache.identBind.append(identValueCode())
    c.typeCache.identTarget.append(40U64)
    c.arena.stmts.append(<Stmt.Let mutable=false nameStart=50U64 nameLen=1U64 tyStart=0U64 tyLen=0U64 tyIsArray=false ty=valueTerm init=3U64 />)
    val secondStart = letState.blocks[0U64].statements.count()
    val moveResult = buildMidLet(c: inout c, state: inout letState, stmtId: 1U64)
    mut val hasMove: Bool = false
    match letState.blocks[0U64].statements[secondStart] {
        MidStatement.Assign(destination: val destination, value: val value) => {
            match value {
                MidRvalue.StorageBoundary(stmtId: val statement, targetTerm: val target, operand: val operand) => {
                    match operand {
                        MidOperand.Move(place: val moved) => { hasMove = statement == 1U64 && target == valueTerm && destination.local == 2U64 && moved.local == 1U64 }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    mut val letBuilt: Bool = false
    match letResult { MidBuildError.None => { letBuilt = true } _ => {} }
    mut val moveBuilt: Bool = false
    match moveResult { MidBuildError.None => { moveBuilt = true } _ => {} }
    if firstLocal == 0U64 && secondLocal == 1U64 && outer.found && outer.local == 0U64 && inner.found && inner.local == 1U64 && !missing.found && place.found && place.place.local == 1U64 && !absentPlace.found && letBuilt && moveBuilt && input == 0U64 && letState.locals.count() == 3U64 && hasAssign && hasMove {
        write(s: "binding-identity\n")
    } else {
        write(s: "wrong-binding\n")
    }
}
