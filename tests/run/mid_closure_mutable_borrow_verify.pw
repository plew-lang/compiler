import @Std/Io with { print }
import @Std/Core with { assert }
import /Frontend with { Comp }
import /Mid with { MidBody, MidLocalDecl, MidScope, MidBlock, MidPlace, MidStatement, MidTerminator, verifyCanonicalMidBody }
import /Mid/Verify with { MidVerifyError }

// A borrowed mutable cell permits replacing its value, never releasing the
// environment's cell owner or leaving the borrowed place uninitialized.
fn verified(readOnly: Bool, replacement: Bool, releaseCell: Bool) -> MidVerifyError {
    mut val compiler: Comp = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internBytes(s: "I64")
    val type = compiler.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    val captured = <MidPlace local=0U64 typeTerm=type />
    val source = <MidPlace local=1U64 typeTerm=type />
    mut val statements: Array[MidStatement] = []
    if releaseCell { statements.append(<MidStatement.ReleaseCaptureCell place=captured />) }
    else { statements.append(<MidStatement.Drop place=captured />) }
    if replacement { statements.append(<MidStatement.Overwrite destination=captured source=source />) }
    else { statements.append(<MidStatement.Drop place=source />) }
    val body = <MidBody locals=[<MidLocalDecl typeTerm=type sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false isBorrowed=readOnly isInout=!readOnly isCaptureCell=true />, <MidLocalDecl typeTerm=type sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=true />] scopes=[<MidScope firstLocal=0U64 localCount=2U64 />] blocks=[<MidBlock statements=statements terminator=<MidTerminator.Return /> />] entry=0U64 />
    val canonical = compiler.mid.store(body: body)
    return verifyCanonicalMidBody(c: inout compiler, canonical: canonical).error
}

fn main() {
    assert(match verified(readOnly: false, replacement: true, releaseCell: false) { MidVerifyError.None => { give true } _ => { give false } })
    assert(match verified(readOnly: false, replacement: false, releaseCell: false) { MidVerifyError.DropUnavailable => { give true } _ => { give false } })
    assert(match verified(readOnly: false, replacement: true, releaseCell: true) { MidVerifyError.DropUnavailable => { give true } _ => { give false } })
    assert(match verified(readOnly: true, replacement: true, releaseCell: false) { MidVerifyError.DropUnavailable => { give true } _ => { give false } })
    print("ok")
}
