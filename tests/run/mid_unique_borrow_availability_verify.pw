import @Std/Io with { print }
import @Std/Core with { assert }
import /Frontend with { Comp }
import /Mid with { MidBody, MidLocalDecl, MidScope, MidBlock, MidPlace, MidStatement, MidTerminator, MidOperand, MidBorrowCapability, MidCallTarget, MidCallReceiver, verifyCanonicalMidBody }
import /Mid/Verify with { MidVerifyError }

fn accepted(alive: Bool) -> Bool {
    mut val compiler: Comp = <Comp />
    compiler.arena.reserveTypeSentinel()
    // This verifier consumes the frozen ownership declaration, not a nominal
    // layout or LLVM definition. Resource is a unique ownership test term.
    val name = compiler.internBytes(s: "Resource")
    val resource = compiler.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.simpleTypeRef(nameStart: integerName.nameStart, nameLen: integerName.nameLen)
    val storage = <MidPlace local=0U64 typeTerm=resource />
    val result = <MidPlace local=1U64 typeTerm=integer />
    mut val before: Array[MidStatement] = []
    mut val after: Array[MidStatement] = [<MidStatement.Drop place=result />]
    if alive { after.append(<MidStatement.Drop place=storage />) }
    else { before.append(<MidStatement.Drop place=storage />) }
    val body = <MidBody locals=[<MidLocalDecl typeTerm=resource sourceScope=0U64 isUnique=true isParameter=false ownsAtEntry=true />, <MidLocalDecl typeTerm=integer sourceScope=0U64 isUnique=false isParameter=false ownsAtEntry=false />] scopes=[<MidScope firstLocal=0U64 localCount=2U64 />] blocks=[<MidBlock statements=before terminator=<MidTerminator.Call callee=<MidCallTarget.Resolved resolution=0U64 /> receiver=<MidCallReceiver.None /> args=[<MidOperand.Borrow place=storage capability=<MidBorrowCapability.Read /> />] destination=result target=1U64 /> />, <MidBlock statements=after terminator=<MidTerminator.Return /> />] entry=0U64 />
    val canonical = compiler.mid.store(body: body)
    return match verifyCanonicalMidBody(c: compiler, canonical: canonical).error {
        MidVerifyError.None => { give true }
        _ => { give false }
    }
}
fn main() {
    assert(accepted(alive: true))
    assert(!accepted(alive: false))
    print("ok")
}
