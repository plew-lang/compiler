import /Frontend with { Comp }
import /Ir with { Bind, StructDef, EnumDef, TraitDef, NewtypeDef }
import @Std/Io with { write }

fn main() {
    mut val c = <Comp />
    val first = c.kwSpan(kw: "First", kwLen: 5U64)
    val second = c.kwSpan(kw: "Second", kwLen: 6U64)
    val identity = <Bind nameStart=first.nameStart nameLen=1U64 fieldStart=0U64 fieldLen=0U64 />
    if c.declIdentityHasName(identity: identity, start: first.nameStart, len: first.nameLen) { panic "unregistered identity" }
    c.arena.registerNewtype(<NewtypeDef nameStart=second.nameStart nameLen=second.nameLen nameId=second.nameId underStart=0U64 underLen=0U64 underRef=0U64 defOffset=first.nameStart />)
    if !c.declIdentityHasName(identity: identity, start: second.nameStart, len: second.nameLen) { panic "category priority" }
    if c.declIdentityHasName(identity: identity, start: first.nameStart, len: first.nameLen) { panic "must not fall through on name mismatch" }
    c.decls.registerTrait(<TraitDef nameStart=first.nameStart nameLen=first.nameLen nameId=first.nameId   />)
    if !c.declIdentityHasName(identity: identity, start: first.nameStart, len: first.nameLen) { panic "category priority" }
    if c.declIdentityHasName(identity: identity, start: second.nameStart, len: second.nameLen) { panic "must not fall through on name mismatch" }
    c.arena.registerEnum(<EnumDef nameStart=second.nameStart nameLen=second.nameLen nameId=second.nameId typeParams=[] variants=[] defOffset=first.nameStart />)
    if !c.declIdentityHasName(identity: identity, start: second.nameStart, len: second.nameLen) { panic "category priority" }
    if c.declIdentityHasName(identity: identity, start: first.nameStart, len: first.nameLen) { panic "must not fall through on name mismatch" }
    c.arena.registerStruct(<StructDef nameStart=first.nameStart nameLen=first.nameLen nameId=first.nameId typeParams=[] fields=[] isUnique=false isExtern=false defOffset=first.nameStart />)
    if !c.declIdentityHasName(identity: identity, start: first.nameStart, len: first.nameLen) { panic "category priority" }
    if c.declIdentityHasName(identity: identity, start: second.nameStart, len: second.nameLen) { panic "must not fall through on name mismatch" }
    c.arena.registerStruct(<StructDef nameStart=second.nameStart nameLen=second.nameLen nameId=second.nameId typeParams=[] fields=[] isUnique=false isExtern=false defOffset=first.nameStart />)
    if c.declIdentityHasName(identity: identity, start: second.nameStart, len: second.nameLen) { panic "first row must win" }
    write(s: "declaration-identity-precedence-ok\n")
}
