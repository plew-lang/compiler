import @Std/Io with { print }
import @Std/Core with { Iterator }
struct Counter { pub mut val n: I64 }
pub impl Counter as Iterator {
    type Item = I64
    inout fn next() -> Optional[I64] {
        if self.n >= 3 { return <Optional.None /> }
        self.n = self.n + 1
        return <Optional.Some v=self.n />
    }
}
fn main() {
    // *2 then +10 : (1,2,3) -> (2,4,6) -> (12,14,16)
    for val v in <Counter n=0 />.map(f: fn(x: I64) -> I64 { return x * 2 }).map(f: fn(x: I64) -> I64 { return x + 10 }) {
        print(v)
    }
}
