import @Std/Io with { print }

// `any P` as a generic collection element flowing through the generic-method
// machinery (spec/08): appending a CONCRETE conforming value boxes it into the
// existential at the call (genArgValue grounds the `value: T` param — T bound to
// `any P` via the receiver instance — and coerces), appending an existing `any P`
// PLACE copies it by retaining its box, and a Dictionary[K, any P] exercises the
// same insert/read path plus the missing-key-panicking subscript.
trait Shape { fn area() -> I64 }
struct Sq { val s: I64 }
struct Rect { val w: I64  val h: I64 }
pub impl Sq as Shape { fn area() -> I64 { return self.s * self.s } }
pub impl Rect as Shape { fn area() -> I64 { return self.w * self.h } }

fn main() {
    // append a concrete (boxed into any at the call) and an any place (box retained)
    mut val xs: Array[any Shape] = []
    xs.append(<Sq s=4 />)
    val r: any Shape = <Rect w=2 h=5 />
    xs.append(r)
    print(xs[0].area())              // 16
    print(xs[1].area())              // 10

    // Dictionary[K, any P]: insert concrete + any place, read via subscript, reassign
    mut val d: Dictionary[String, any Shape] = [:]
    d["a"] = <Sq s=3 />
    d["b"] = r
    print(d.count)                   // 2
    print(d["a"].area())             // 9
    print(d["b"].area())             // 10
    d["a"] = <Rect w=3 h=3 />
    print(d["a"].area())             // 9
}
