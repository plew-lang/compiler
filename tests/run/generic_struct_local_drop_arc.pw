import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}

struct Box[T] {
    pub val v: T
}

// Swift-guaranteed (+0) arg convention: a by-value heap-carrying arg is a BORROW —
// no retain at the call, no release in the callee. The caller's binding stays the
// sole owner, so the pointee deinit fires deterministically at ITS scope exit.
fn peek(box: Box[MutableRef[Cell]]) {
    print("peek")
}

fn holdLocal() {
    val b: Box[MutableRef[Cell]] = <Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=3I32 /> /> />
    print("local-scope-end")
}

fn passByValue() {
    val b: Box[MutableRef[Cell]] = <Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=4I32 /> /> />
    peek(box: b)
    print("pass-scope-end")
}

fn main() {
    holdLocal()
    passByValue()
    print("done")
}
