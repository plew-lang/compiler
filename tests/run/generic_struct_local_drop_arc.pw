import @Std/Io with { print }
import @Std/Core with { Ref }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}

struct Box[T] {
    pub val v: T
}

// NOTE: a by-value heap-carrying arg is retained by the caller and NOT dropped by the
// callee (deferred release = tolerated leak, never a UAF — see emitDeinitCall). So the
// passByValue case expects NO deinit for 4: the arg-pass retain (+1) is never balanced.
// This pin flips to "4 fires once" when the owned-param drop convention lands.
fn peek(box: Box[Ref[Cell]]) {
    print("peek")
}

fn holdLocal() {
    val b: Box[Ref[Cell]] = <Box[Ref[Cell]] v=<Ref value=<Cell v=3I32 /> /> />
    print("local-scope-end")
}

fn passByValue() {
    val b: Box[Ref[Cell]] = <Box[Ref[Cell]] v=<Ref value=<Cell v=4I32 /> /> />
    peek(box: b)
    print("pass-scope-end")
}

fn main() {
    holdLocal()
    passByValue()
    print("done")
}
