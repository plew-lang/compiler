// `as` is lossless-only: widening integer conversions (and in-range literals)
// are accepted. Narrowing / signedness-changing `as` is a compile error
// (see tests/reject/cast_*), to be done via TryFrom instead.
import @Std/Io with { print }

fn main() {
    val a: U8 = 200
    print(a as U64)        // 200  (unsigned widening)
    val b: I32 = 5
    print(b as I64)        // 5    (signed widening)
    val c: U16 = 1000
    print(c as I32)        // 1000 (unsigned -> strictly wider signed)
    print('A' as U8)       // 65   (literal fits U8)
    val x: I32 = 7
    val y: I32 = 9
    print((x + y) as I64)  // 16   (I32 arithmetic widened to I64 is lossless)
}
