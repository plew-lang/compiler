import @Std/Io with { print }

// Inter-trait conformance (spec/08,09): `impl Named as Show` makes every type
// conforming to the subject trait Named also conform to Show, witnessing Show's
// requirement in Named's vocabulary. The conferred conformance rides the bare
// surface (direct `a.show()`) and satisfies a `where U: Show` bound. The legal
// subject is the trait itself; the headless form `impl[T] T as Show where T: Named`
// is rejected (tests/reject/blanket_headless.pw).
trait Named { fn nm() -> I64 }
trait Show { fn show() -> I64 }

struct A { pub val a: I64 }
pub impl A { factory }
struct B { pub val b: I64 }
pub impl B { factory }
struct Q { pub val q: I64 }
pub impl Q { factory }

pub impl A as Named { fn nm() -> I64 { return self.a } }
pub impl B as Named { fn nm() -> I64 { return self.b * 10I64 } }
// Q deliberately does NOT conform to Named, so it does not get `show`.
pub impl Q { fn raw() -> I64 { return self.q } }

pub impl Named as Show { fn show() -> I64 { return self.nm() + 1I64 } }

// the conferred conformance also satisfies a `where U: Show` bound.
fn doubled[U](x: U) -> I64 where U: Show { return x.show() * 2I64 }

fn main() {
    val a: A = <A a=4 />
    val b: B = <B b=2 />
    val q: Q = <Q q=9 />
    print(a.show())      // 4 + 1 = 5      (Named as Show, conferred on A)
    print(b.show())      // 20 + 1 = 21    (conferred on B)
    print(doubled(x: a)) // (4+1)*2 = 10   (through a where U: Show bound)
    print(q.raw())       // 9              (Q has no `show`, only its own method)
}
