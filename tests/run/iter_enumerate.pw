// `Iterator.enumerate()` (spec/02,08): pairs each element with its 0-based index,
// yielding labelled records `(index: U64, value: E)`. Built on generic-record support
// (the adapter's `next()` returns `Optional[(index:U64,value:E)]`). The binding form
// `for p in it.enumerate()` exposes `p.index` / `p.value`.
import @Std/Io with { print }
import @Std/Core with { Iterator, RangeError }

struct Counter { pub mut val n: I64 }
pub impl Counter { factory }
pub impl Counter as Iterator {
    type Item = I64
    inout fn next() -> Optional[I64] {
        if self.n >= 3 { return <Optional.None /> }
        self.n = self.n + 1
        return <Optional.Some v=self.n * 10 />
    }
}

fn main() {
    for p in <Counter n=0 />.enumerate() {
        print(p.index)
        print(p.value)
    }
    // the index is a U64; `as I64` is rejected (sign change is not lossless, spec/12), so
    // convert it through the fallible `<I64.checked .../>` TryFrom before the signed add.
    mut val sum: I64 = 0
    for p in <Counter n=0 />.enumerate() {
        val idx: Result[I64, RangeError] = <I64.checked source=p.index />
        sum = sum + idx.unwrapOr(fallback: 0I64) + p.value
    }
    print(sum)   // (0+10)+(1+20)+(2+30) = 63
    // the record-destructure form, by FIELD LABEL (records are labelled, not positional).
    for (index: val i, value: val v) in <Counter n=0 />.enumerate() {
        print(i)
        print(v)
    }
}
