// Overlapping-`inout` runtime tier, NEGATIVE cases (spec/03): distinct places must
// proceed untouched by the pre-call check. Covers (1) CoW-shared distinct variables —
// the check compares privatized pointers, so buffer sharing (a hidden cost) never
// panics (a hidden meaning); (2) distinct Ref cells; (3) an `inout r->field` argument
// passing a REAL cell pointer (the write lands through the Ref — the old temp-copy
// fallback silently dropped it).
import @Std/Io with { print }
import @Std/Core with { Ref }

struct Counter { pub mut val n: I32 }

fn bump2(x: inout I64, y: inout I64) { x = x + 1  y = y + 10 }
fn bump2i(x: inout I32, y: inout I32) { x = x + 1I32  y = y + 10I32 }
fn bump(x: inout I32) { x = x + 1I32 }

fn main() {
    // (1) CoW-shared distinct variables: distinct places, both writes land independently.
    mut val a: Array[I64] = [100, 200]
    mut val b: Array[I64] = a
    bump2(x: inout a[0], y: inout b[0])
    print(a[0])      // 101
    print(b[0])      // 110
    print(a[1])      // 200

    // same array, distinct indices: the runtime check passes.
    val i: U64 = 0
    val j: U64 = 1
    bump2(x: inout a[i], y: inout a[j])
    print(a[0])      // 102
    print(a[1])      // 210

    // (2) distinct Ref cells: distinct pointees, no panic.
    val r1: Ref[Counter] = <Ref[Counter] value=<Counter n=5 /> />
    val r2: Ref[Counter] = <Ref[Counter] value=<Counter n=7 /> />
    bump2i(x: inout r1->n, y: inout r2->n)
    print(r1->n)     // 6
    print(r2->n)     // 17

    // (3) `inout r->field`: the callee writes through the shared cell.
    bump(x: inout r1->n)
    print(r1->n)     // 7
}
