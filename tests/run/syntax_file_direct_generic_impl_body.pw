// Generic impl members are the first direct-parser form consumed by the
// compiler's collection floor. Keep the receiver type, labelled call, return
// statement, and lowering boundary together so a future row/slice regression
// cannot hide behind the simple non-generic impl fixture.
import @Plew/Syntax with { Lexer, P, ImplId, MemberKind, SyntaxExprKind, SyntaxStmtKind, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxImpl, syntaxImplMember, syntaxImplMemberCount, syntaxImplParamCount, syntaxType, syntaxTypeArgCount, syntaxMember, syntaxBlock, syntaxBlockStmtCount, syntaxBlockStmt, syntaxStmt, syntaxExpr, syntaxExprArgCount, syntaxExprArg, syntaxArg }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "pub impl[T] Buffer[T] { fn count() -> U64 { return bufferCount(buffer: self) } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val impl = syntaxImpl(file: file, id: <ImplId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    print(syntaxImplParamCount(file: file, impl: impl))
    print(syntaxTypeArgCount(file: file, ty: syntaxType(file: file, id: impl.recvType)))
    print(syntaxImplMemberCount(file: file, impl: impl))
    val member = syntaxMember(file: file, id: syntaxImplMember(file: file, impl: impl, index: 0U64))
    match member.kind { MemberKind.Method => { print(1U64) } _ => { print(0U64) } }
    if member.hasRet { print(1U64) } else { print(0U64) }
    val block = syntaxBlock(file: file, id: member.body)
    print(syntaxBlockStmtCount(file: file, block: block))
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: block, index: 0U64))
    match stmt.kind { SyntaxStmtKind.Return => { print(1U64) } _ => { print(0U64) } }
    val call = syntaxExpr(file: file, id: stmt.child0)
    match call.kind { SyntaxExprKind.Call => { print(1U64) } _ => { print(0U64) } }
    print(syntaxExprArgCount(file: file, expr: call))
    val argument = syntaxArg(file: file, id: syntaxExprArg(file: file, expr: call, index: 0U64))
    print(argument.label.end - argument.label.start)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.lowerSyntaxImpl(im: impl)
    print(c.arena.funcs.count())
}
