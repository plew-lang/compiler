import @Std/Io with { print }
fn twice(n: I32) -> I32 { return n * 2 }
fn apply(f: fn(n: I32) -> I32, x: I32) -> I32 {
    return f(n: x)
}
fn main() {
    val g: fn(n: I32) -> I32 = fn(n: I32) -> I32 { return twice(n: n) }
    print(g(n: 5))
    print(apply(f: fn(n: I32) -> I32 { return twice(n: n) }, x: 21))
}
