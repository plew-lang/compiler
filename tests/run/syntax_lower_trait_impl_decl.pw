import @Plew/Syntax with { Lexer, P, DeclId, ImplId, TraitId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxImpl, syntaxTopItemPayload, syntaxTrait }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "trait Convert { type Output fn convert() -> Output }\nstruct Box { val value: I8 }\nimpl Box as Convert { type Output = I8 fn convert() -> Output { return self.value } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.predeclareSyntaxTraitItem(item: syntaxFileTopLevel(file: file, index: 0U64))
    c.lowerSyntaxTrait(t: syntaxTrait(file: file, id: <TraitId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />))
    c.lowerSyntaxStructDecl(d: syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 1U64)) />))
    c.lowerSyntaxImpl(im: syntaxImpl(file: file, id: <ImplId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 2U64)) />))
    print(c.arena.funcs.count())
    print(c.decls.conforms.count())
    print(c.decls.assocBindings.count())
}
