import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxExpr, syntaxExprParamCount, syntaxExprParam, syntaxParam, DeclId, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { val f = fn(value: U64) -> U64 { return value } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))
    val closure = syntaxExpr(file: file, id: stmt.child0)
    val param = syntaxParam(file: file, id: syntaxExprParam(file: file, expr: closure, index: 0U64))
    match closure.kind {
        SyntaxExprKind.Closure => { print(1U64) }
        _ => { print(0U64) }
    }
    print(syntaxExprParamCount(file: file, expr: closure))
    print(param.name.end - param.name.start)
    if param.noLabel { print(1U64) } else { print(0U64) }
}
