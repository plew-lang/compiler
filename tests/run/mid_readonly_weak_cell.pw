import @Std/Io with { print }
import @Std/Core with { MutableRef, WeakRef }

unique struct Cell {
    pub val tag: I32
    deinit { print(self.tag) }
}
pub impl Cell { factory }

fn orphan() -> WeakRef[Cell] {
    val mutable: MutableRef[Cell] = <MutableRef value=<Cell tag=7I32 /> />
    val readonly = mutable.asRef()
    val observer = readonly.weak()
    match observer.upgrade() {
        Optional.Some(v: val live) => { print(live->tag) }
        Optional.None => { print(999I32) }
    }
    return observer
}

fn main() {
    val observer = orphan()
    print(1I32)
    match observer.upgrade() {
        Optional.Some(v: val live) => { print(999I32) }
        Optional.None => { print(2I32) }
    }
}
