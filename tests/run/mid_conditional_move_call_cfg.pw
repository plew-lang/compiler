import @Std/Io with { write }
import /Frontend with { Comp }
import /Ir with { Arg, ArgRange, Block, CallArgumentSource, CallTemplate, CallTemplateArgument, CallTemplateKind, CallTemplateReceiver, Expr, StaticConformanceProof, Stmt, identValueCode }
import /Mid with { MidBlock, MidBuildError, MidBuildState, MidBody, MidOwnership, MidStatement, MidVerifyError, addMidLocal, analyzeMidOwnership, buildMidIf, elaborateMidDrops, verifyMidBody }

fn main() {
    mut val c: Comp = <Comp />
    // if true { consume(file: move file) } else {}
    c.arena.exprs.append(<Expr.Int value=1U64 offset=0U64 isBool=true tyStart=0U64 tyLen=0U64 isNeg=false />)
    c.arena.exprs.append(<Expr.Ident start=90U64 len=4U64 />)
    c.arena.exprs.append(<Expr.Move operand=1U64 isBorrow=false />)
    c.arena.exprs.append(<Expr.Call nameStart=0U64 nameLen=0U64 args=<ArgRange start=0U64 len=1U64 /> />)
    c.arena.argPool.append(<Arg labelStart=0U64 labelLen=0U64 expr=2U64 isInout=false hasLabel=false />)
    c.typeCache.identBind.append(0I64)
    c.typeCache.identTarget.append(0U64)
    c.typeCache.identBind.append(identValueCode())
    c.typeCache.identTarget.append(90U64)
    val key = c.callTemplateForSourceBody(fnIdx: 0U64, exprId: 3U64).siteKey
    c.appendCallTemplate(template: <CallTemplate siteKey=key kind=<CallTemplateKind.Direct callee=0U64 receiver=<CallTemplateReceiver.None /> args=[<CallTemplateArgument source=<CallArgumentSource.Term exprId=2U64 term=1U64 /> isInout=false labelStart=0U64 labelLen=0U64 hasLabel=false />] calleeTypeArgs=[] proof=<StaticConformanceProof.Missing /> /> />)
    c.arena.stmts.append(<Stmt.ExprStmt expr=3U64 />)
    c.arena.blockStmtPool.append(0U64)
    c.arena.blocks.append(<Block stmtStart=0U64 stmtLen=1U64 />)
    c.arena.blocks.append(<Block stmtStart=1U64 stmtLen=0U64 />)
    c.arena.stmts.append(<Stmt.If cond=0U64 thenBlk=0U64 elseBlk=1U64 hasElse=true />)
    mut val state: MidBuildState = <MidBuildState blocks=[<MidBlock />] sourceFunction=0U64 />
    val file = addMidLocal(state: inout state, declarationTarget: 90U64, typeTerm: 1U64, isUnique: true, isParameter: false, ownsAtEntry: true)
    val result = buildMidIf(c: inout c, state: inout state, stmtId: 1U64)
    val body: MidBody = <MidBody locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 />
    val ownership: MidOwnership = analyzeMidOwnership(body: body)[3U64][0U64]
    val elaborated = elaborateMidDrops(body: body)
    mut val dropped: Bool = false
    match elaborated.blocks[3U64].statements[0U64] {
        MidStatement.ConditionalDrop(place: _, flag: _) => { dropped = true }
        _ => {}
    }
    mut val valid: Bool = false
    match verifyMidBody(body: elaborated).error { MidVerifyError.None => { valid = true } _ => {} }
    mut val built: Bool = false
    match result { MidBuildError.None => { built = true } _ => {} }
    match ownership {
        MidOwnership.MaybeOwned => {
            if file == 0U64 && built && dropped && valid {
                write(s: "conditional-move-call\n")
            } else {
                write(s: "wrong-conditional-move-call\n")
            }
        }
        _ => { write(s: "wrong-ownership\n") }
    }
}
