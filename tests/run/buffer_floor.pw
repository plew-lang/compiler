// The Buffer storage floor (buffer-floor.md): `Buffer[T]` is the blessed safe
// storage primitive Array/Dictionary/Set/String are built on. Unlike Array's
// `{ptr,i64}` value, a Buffer is a single data pointer whose cap/count/rc live
// in the heap header; new/count/append/get are lowered inline to the rawbuf
// header ops. This exercises construction, growth across cap boundaries
// (0 -> 8 -> 16 -> 32), the header count, bounds-checked reads, and scope-drop.
import @Std/Io with { print }
import @Std/Core with { Buffer }

fn main() {
    mut val b: Buffer[I64] = Buffer.new()
    val empty: U64 = b.count
    print(line: "empty=" + empty.format(format: ""))
    mut val i: I64 = 0I64
    while i < 20I64 {
        b.append(i * 10I64)
        i += 1I64
    }
    val n: U64 = b.count
    print(line: "count=" + n.format(format: ""))
    mut val sum: I64 = 0I64
    mut val k: U64 = 0U64
    while k < n {
        val e: I64 = b.get(index: k)
        sum += e
        k += 1U64
    }
    print(line: "sum=" + sum.format(format: ""))
    // set / removeLast / isEmpty / capacity.
    b.set(index: 0U64, 7I64)
    val b0: I64 = b.get(index: 0U64)
    print(line: "b0=" + b0.format(format: ""))
    b.removeLast()
    val n2: U64 = b.count
    print(line: "afterPop=" + n2.format(format: ""))
    val cap: U64 = b.capacity
    val capOk: Bool = cap >= n2
    if capOk { print(line: "cap-ok") }
    val empty2: Bool = b.isEmpty()
    if empty2 { print(line: "BAD") } else { print(line: "nonempty-ok") }
}
