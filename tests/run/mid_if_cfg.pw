import @Std/Io with { write }
import /Frontend with { Comp }
import /Ir with { Block, Expr, SemanticExprType, StructDef, Stmt, Func, InstanceEnvironment, FinalStorageResolution, ValueConversionProof, identValueCode }
import /Mid with { MidInstantiateError, MidBuildError, MidBuildState, MidBody, MidOwnership, MidStatement, MidTerminator, MidVerifyError, addMidLocal, analyzeMidOwnership, buildMidBlock, buildMidIf, elaborateMidDrops, instantiateMidBody, verifyMidBody }

fn main() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val fileName = c.internBytes(s: "File")
    c.arena.registerStruct(<StructDef nameStart=fileName.nameStart nameLen=fileName.nameLen nameId=fileName.nameId typeParams=[] fields=[] isUnique=true isExtern=false />)
    val fileTerm = c.simpleTypeRef(nameStart: fileName.nameStart, nameLen: fileName.nameLen)
    val boolName = c.internBytes(s: "Bool")
    val boolTerm = c.simpleTypeRef(nameStart: boolName.nameStart, nameLen: boolName.nameLen)
    c.arena.semanticExprTypes.append(<SemanticExprType term=boolTerm />)
    c.arena.semanticExprTypes.append(<SemanticExprType term=fileTerm />)
    c.arena.semanticExprTypes.append(<SemanticExprType term=fileTerm />)
    // if true { val transferred = move file } else {}
    c.arena.exprs.append(<Expr.Int value=1U64 offset=0U64 isBool=true tyStart=0U64 tyLen=0U64 isNeg=false />)
    c.arena.exprs.append(<Expr.Ident start=60U64 len=4U64 />)
    c.arena.exprs.append(<Expr.Move operand=1U64 isBorrow=false />)
    c.typeCache.identBind.append(0I64)
    c.typeCache.identTarget.append(0U64)
    c.typeCache.identBind.append(identValueCode())
    c.typeCache.identTarget.append(60U64)
    c.arena.stmts.append(<Stmt.Let mutable=false nameStart=70U64 nameLen=11U64 tyStart=0U64 tyLen=0U64 tyIsArray=false ty=fileTerm init=2U64 />)
    c.arena.blockStmtPool.append(0U64)
    c.arena.blocks.append(<Block stmtStart=0U64 stmtLen=1U64 />)
    c.arena.blocks.append(<Block stmtStart=1U64 stmtLen=0U64 />)
    c.arena.stmts.append(<Stmt.If cond=0U64 thenBlk=0U64 elseBlk=1U64 hasElse=true />)
    mut val state: MidBuildState = <MidBuildState.initial sourceFunction=0U64 />
    val fileLocal = addMidLocal(state: inout state, declarationTarget: 60U64, typeTerm: fileTerm, isUnique: true, isParameter: false, ownsAtEntry: true)
    val result = buildMidIf(c: inout c, state: inout state, stmtId: 1U64)
    val body: MidBody = <MidBody locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 />
    val ownership = analyzeMidOwnership(body: body)
    val joinState: MidOwnership = ownership[3U64][0U64]
    // The builder yields parametric storage boundaries. Publish the concrete
    // frontend fact and instantiate before drop elaboration and verification.
    c.arena.registerFunction(<Func nameStart=0U64 nameLen=0U64 params=c.pushFuncParams(params: [])
        hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64
        hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false
        isAssoc=false isAsync=false isExtern=false />)
    val instance = c.internBodyInstance(fnIdx: 0U64, environment: <InstanceEnvironment />)
    val identity = c.freezeValueConversionProof(proof: <ValueConversionProof.Identity />)
    c.putFinalStorage(fact: <FinalStorageResolution bodyId=instance stmtId=0U64 sourceTypeRef=fileTerm targetTypeRef=fileTerm conversion=identity />)
    val concrete = instantiateMidBody(c: inout c, body: body, bodyId: instance)
    mut val instantiated: Bool = false
    match concrete.error { MidInstantiateError.None => { instantiated = true } _ => {} }
    val elaborated = elaborateMidDrops(body: concrete.body)
    mut val hasConditionalDrop: Bool = false
    match elaborated.blocks[3U64].statements[0U64] {
        MidStatement.ConditionalDrop(place: _, flag: _) => { hasConditionalDrop = true }
        _ => {}
    }
    mut val elaboratedValid: Bool = false
    match verifyMidBody(body: elaborated).error {
        MidVerifyError.None => { elaboratedValid = true }
        _ => {}
    }
    c.arena.stmts.append(<Stmt.Return value=0U64 hasValue=false offset=0U64 />)
    c.arena.blockStmtPool.append(2U64)
    c.arena.blocks.append(<Block stmtStart=1U64 stmtLen=1U64 />)
    mut val returnState: MidBuildState = <MidBuildState.initial sourceFunction=0U64 />
    val returnResult = buildMidBlock(c: inout c, state: inout returnState, blockId: 2U64)
    mut val returned: Bool = false
    match returnResult { MidBuildError.None => { match returnState.blocks[0U64].terminator { MidTerminator.Return => { returned = true } _ => {} } } _ => {} }
    mut val built: Bool = false
    match result { MidBuildError.None => { built = true } _ => {} }
    match joinState {
        MidOwnership.MaybeOwned => {
            if built && instantiated && fileLocal == 0U64 && state.blocks.count() == 4U64 && hasConditionalDrop && elaboratedValid && returned {
                write(s: "if-move-cfg\n")
            } else {
                write(s: "wrong-cfg\n")
            }
        }
        _ => { write(s: "wrong-ownership\n") }
    }
}
