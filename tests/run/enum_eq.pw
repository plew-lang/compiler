enum Kind {
    LParen
    RParen
    Int
}
fn classify(k: Kind) -> I64 {
    if k == <Kind.LParen /> {
        return 1
    }
    if k != <Kind.Int /> {
        return 2
    }
    return 3
}
fn main() {
    print(classify(k: <Kind.LParen />))
    print(classify(k: <Kind.RParen />))
    print(classify(k: <Kind.Int />))
}
