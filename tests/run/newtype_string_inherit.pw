// newtype over a NON-int underlying (spec/10): a `newtype UserId = String` is a
// distinct type that shares String's representation and inherits its members.
// Covered: the `as` re-tag in both directions (wrap `"a" as UserId` / unwrap
// `u as String`), inherited field access (`u.bytes`), and inherited method
// dispatch with a correctly-kinded Bool return (`u.isEmpty()`).
import @Std/Io with { print }

newtype UserId = String

fn main() {
    val u: UserId = "alice" as UserId
    // unwrap re-tag: a UserId value flows back to a String (representation-identical).
    print(u as String)          // alice
    // inherited field: String's `bytes` (Array[U8]) view, O(1).
    print(u.bytes.count)        // 5
    print(u.bytes[0])           // 97  ('a')
    // inherited method, Bool return correctly kinded (not int-defaulted).
    print(u.isEmpty())          // 0  (false)
    val empty: UserId = "" as UserId
    print(empty.isEmpty())      // 1  (true)
    // the re-tag is a pure view: round-tripping preserves the value.
    val back: String = u as String
    val again: UserId = back as UserId
    print(again.bytes.count)    // 5
}
