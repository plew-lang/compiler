import @Std/Io with { print }

// A record-destructuring loop pattern `for (val x, val y) in xs` (spec/02,11) binds each
// element's record fields per iteration. Punned `(val x)` and explicit `(field: val n)`
// both work. Desugars to a fresh element binding plus a field-by-field destructuring.
fn main() {
    val a: (x: I64, y: I64) = (x: 1, y: 2)
    val b: (x: I64, y: I64) = (x: 3, y: 4)
    mut val ps: Array[(x: I64, y: I64)] = []
    ps.append(value: a)
    ps.append(value: b)
    for (val x, val y) in ps {
        print(x + y)        // 3, 7
    }
    // explicit field: name (rename)
    for (x: val px, y: val py) in ps {
        print(px * py)      // 2, 12
    }
}
