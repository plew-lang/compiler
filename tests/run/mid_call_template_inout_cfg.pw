import @Std/Io with { write }
import /Frontend with { Comp }
import /Ir with { Arg, ArgRange, Block, CallArgumentSource, CallTemplate, CallTemplateArgument, CallTemplateKind, CallTemplateReceiver, Expr, StaticConformanceProof, Stmt, identValueCode }
import /Mid with { MidBlock, MidBorrowCapability, MidBuildError, MidBuildState, MidOperand, MidTerminator, addMidLocal, buildMidBlock }

// A CallTemplate carries whether a selected argument is `inout`. Mid must turn
// that semantic ABI fact into an Inout borrow rather than silently retaining a
// Copy operand for a later backend to reinterpret.
fn main() {
    mut val c: Comp = <Comp />
    c.arena.exprs.append(<Expr.Ident start=90U64 len=4U64 />)
    c.arena.exprs.append(<Expr.Call nameStart=0U64 nameLen=0U64 args=<ArgRange start=0U64 len=1U64 /> />)
    c.arena.argPool.append(<Arg labelStart=0U64 labelLen=0U64 expr=0U64 isInout=true hasLabel=false />)
    c.typeCache.identBind.append(identValueCode())
    c.typeCache.identTarget.append(90U64)
    val key = c.callTemplateForSourceBody(fnIdx: 0U64, exprId: 1U64).siteKey
    c.appendCallTemplate(template: <CallTemplate siteKey=key kind=<CallTemplateKind.Direct callee=0U64 receiver=<CallTemplateReceiver.None /> args=[<CallTemplateArgument source=<CallArgumentSource.Term exprId=0U64 term=1U64 /> isInout=true labelStart=0U64 labelLen=0U64 hasLabel=false />] calleeTypeArgs=[] proof=<StaticConformanceProof.Missing /> /> />)
    c.arena.stmts.append(<Stmt.ExprStmt expr=1U64 />)
    c.arena.blockStmtPool.append(0U64)
    c.arena.blocks.append(<Block stmtStart=0U64 stmtLen=1U64 />)
    mut val state: MidBuildState = <MidBuildState blocks=[<MidBlock />] sourceFunction=0U64 />
    addMidLocal(state: inout state, declarationTarget: 90U64, typeTerm: 1U64, isUnique: false, isParameter: false, ownsAtEntry: true)
    val result = buildMidBlock(c: inout c, state: inout state, blockId: 0U64)
    mut val isInoutBorrow: Bool = false
    match state.blocks[0U64].terminator {
        MidTerminator.Call(callee: _, args: val args, destination: _, target: _) => {
            match args[0U64] {
                MidOperand.Borrow(place: val place, capability: val capability) => {
                    match capability { MidBorrowCapability.Inout => { isInoutBorrow = place.local == 0U64 } _ => {} }
                }
                _ => {}
            }
        }
        _ => {}
    }
    match result {
        MidBuildError.None => {
            if isInoutBorrow { write(s: "inout-borrow\n") } else { write(s: "wrong-inout\n") }
        }
        _ => { write(s: "build-error\n") }
    }
}
