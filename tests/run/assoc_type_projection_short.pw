import @Std/Io with { print }

trait Parser {
    type Output
    fn parse() -> Output
}

struct P {}
pub impl P { factory }

pub impl P as Parser {
    type Output = I64
    fn parse() -> I64 { return 41I64 }
}

fn parseOne[T](x: T) -> T.Output where T: Parser {
    return x.parse()
}

fn preserveOutput[T](x: T, out: T.Output) -> T.Output where T: Parser {
    val local: T.Output = out
    return local
}

fn main() {
    val parser: P = <P />
    print(preserveOutput(x: parser, out: parseOne(x: parser)) + 1I64)
}
