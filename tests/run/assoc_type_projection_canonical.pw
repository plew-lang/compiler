import @Std/Io with { print }

trait Parser {
    type Output
    fn parse() -> Output
}

struct P {}
pub impl P { factory }

pub impl P as Parser {
    type Output = I64
    fn parse() -> I64 { return 41I64 }
}

fn parseOne[T](x: T) -> T#Parser.Output where T: Parser {
    return x.parse()
}

fn acceptOutput[T](x: T, out: T#Parser.Output) -> I64 where T: Parser {
    return x.parse() + out
}

fn main() {
    print(parseOne(x: <P />) + 1I64)
}
