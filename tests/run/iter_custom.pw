import @Std/Io with { print }
import @Std/Core with { Iterator, Iterable }

// A countdown from `n` down to 1, exercising the user-defined iterator protocol.
struct CountdownIter {
    pub mut val n: I64
}

pub impl CountdownIter as Iterator {
    type Item = I64
    inout fn next() -> Optional[I64] {
        if self.n <= 0 {
            return <Optional.None />
        }
        val v: I64 = self.n
        self.n = self.n - 1
        return <Optional.Some v=v />
    }
}

struct Countdown {
    pub val start: I64
}

pub impl Countdown as Iterable {
    type Item = I64
    type Iter = CountdownIter
    fn iterator() -> CountdownIter {
        return <CountdownIter n=self.start />
    }
}

fn main() {
    mut val sum: I64 = 0
    for val x in <Countdown start=4 /> {
        print(x)
        sum = sum + x
    }
    print(sum)
}
