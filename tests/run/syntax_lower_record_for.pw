// A record loop pattern lowers through the same element destructuring contract
// as the value-AST path, using the explicit frozen isRecordPattern flag.
import @Plew/Syntax with { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "fn body() {\n    for (val left, val right) in pairs {}\n}\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val root = c.lowerSyntaxBlock(id: decl.body)
    print(c.arena.blocks.count())
    print(c.arena.stmts.count())
    print(c.arena.exprs.count())
    print(c.decls.destructureSites.count())
    print(c.blockStmtCount(blkId: root))
}
