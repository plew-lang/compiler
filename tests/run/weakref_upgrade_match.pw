// gap 2 (spec/03 banner): `w.upgrade()` matched DIRECTLY — no intermediate annotated
// `val o: Optional[MutableRef[Cell]]`. The scrutinee's concrete Optional[MutableRef[Cell]] type must come
// from grounding upgrade()'s `Optional[MutableRef[T]]` return under the WeakMutableRef[Cell] receiver env,
// so the `Some` payload binds as `MutableRef[Cell]` and `r->x` resolves. Before the fix the receiver
// env wasn't set for the opaque WeakMutableRef (setStructEnv/setEnumEnv both miss it), so T stayed
// abstract and `->` was rejected ("`->` only on a MutableRef to a registered struct"). This guards
// the type resolution (read + shared write + dead-weak None) of the directly-matched upgrade.
import @Std/Io with { print }
import @Std/Core with { MutableRef, WeakMutableRef }

struct Node { pub mut val x: I32 }

// upgrade matched directly; the alive branch reads through the upgraded strong handle.
fn peek(w: WeakMutableRef[Node]) -> I32 {
    match w.upgrade() {
        Optional.Some(v: val r) => { return r->x }
        Optional.None => { return 999I32 }
    }
}

// a weak left dangling: the only strong owner drops inside the call, so the returned weak
// observes a dead cell -> upgrade None.
fn danglingWeak() -> WeakMutableRef[Node] {
    val r: MutableRef[Node] = <MutableRef[Node] value=<Node x=1 /> />
    return r.weak()
}

fn main() {
    val r: MutableRef[Node] = <MutableRef[Node] value=<Node x=42 /> />
    val w: WeakMutableRef[Node] = r.weak()
    print(peek(w: w))                 // 42 (alive: Some -> r->x)

    // shared mutation through the upgraded ref, matched directly, then re-read.
    match w.upgrade() {
        Optional.Some(v: val s) => { s->x = 7I32 }
        Optional.None => { print(999I32) }
    }
    print(peek(w: w))                 // 7

    // dead weak -> direct match yields None -> 999.
    val dw: WeakMutableRef[Node] = danglingWeak()
    print(peek(w: dw))                // 999
}
