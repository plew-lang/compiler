// gap 2 (spec/03 banner): `w.upgrade()` matched DIRECTLY — no intermediate annotated
// `val o: Optional[Ref[Cell]]`. The scrutinee's concrete Optional[Ref[Cell]] type must come
// from grounding upgrade()'s `Optional[Ref[T]]` return under the WeakRef[Cell] receiver env,
// so the `Some` payload binds as `Ref[Cell]` and `r->x` resolves. Before the fix the receiver
// env wasn't set for the opaque WeakRef (setStructEnv/setEnumEnv both miss it), so T stayed
// abstract and `->` was rejected ("`->` only on a Ref to a registered struct"). This guards
// the type resolution (read + shared write + dead-weak None) of the directly-matched upgrade.
import @Std/Io with { print }
import @Std/Core with { Ref, WeakRef }

struct Node { pub mut val x: I32 }

// upgrade matched directly; the alive branch reads through the upgraded strong handle.
fn peek(w: WeakRef[Node]) -> I32 {
    match w.upgrade() {
        Optional.Some(v: val r) => { return r->x }
        Optional.None => { return 999I32 }
    }
}

// a weak left dangling: the only strong owner drops inside the call, so the returned weak
// observes a dead cell -> upgrade None.
fn danglingWeak() -> WeakRef[Node] {
    val r: Ref[Node] = <Ref[Node] value=<Node x=1 /> />
    return r.weak()
}

fn main() {
    val r: Ref[Node] = <Ref[Node] value=<Node x=42 /> />
    val w: WeakRef[Node] = r.weak()
    print(peek(w: w))                 // 42 (alive: Some -> r->x)

    // shared mutation through the upgraded ref, matched directly, then re-read.
    match w.upgrade() {
        Optional.Some(v: val s) => { s->x = 7I32 }
        Optional.None => { print(999I32) }
    }
    print(peek(w: w))                 // 7

    // dead weak -> direct match yields None -> 999.
    val dw: WeakRef[Node] = danglingWeak()
    print(peek(w: dw))                // 999
}
