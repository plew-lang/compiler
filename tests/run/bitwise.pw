// Bitwise & shift operators (& | ^ << >> ~) and their precedence.
// Spec order (low->high): | < ^ < & < shift < +-, so `&` binds tighter than `|`
// and `+` tighter than `<<`.
import @Std/Io with { print }

fn main() {
    print(12I64 & 10I64)        // 8I64
    print(12I64 | 10I64)        // 14I64
    print(12I64 ^ 10I64)        // 6I64
    print(1I64 << 4I64)         // 16I64
    print(255I64 >> 4I64)       // 15I64
    print(6I64 & 3I64 | 8I64)      // (6I64&3I64)|8I64 = 10I64
    print(1I64 << 2I64 + 1I64)     // 1I64 << (2I64+1I64) = 8I64
    val x: I64 = 5
    print(~x)             // -6I64
}
