import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Resource {
    pub val value: I64
    deinit { print(self.value) }
}
pub impl Resource { factory }
struct Container[T] { pub val items: Array[T] }
pub impl Container[T] { factory }

fn exercise() {
    val container: Container[MutableRef[Resource]] = <Container items=[<MutableRef value=<Resource value=7I64 /> />] />
    val copy = container
    print("inside")
}
fn main() {
    exercise()
    print("after")
}
