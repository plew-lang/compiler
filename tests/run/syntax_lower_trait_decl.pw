import @Plew/Syntax with { Lexer, P, TraitId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxTrait }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "trait Convert[T] { type Output fn convert(value: T) -> Output }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.lowerSyntaxTrait(t: syntaxTrait(file: file, id: <TraitId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />))
    print(c.decls.traitCount())
    val declaration = c.decls.traitAt(index: 0U64)
    print(declaration.typeParams.len)
    print(declaration.assocTypes.len)
    print(declaration.reqs.len)
}
