import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxExpr, syntaxExprArgCount, syntaxExprArg, syntaxArg, DeclId, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { show(value: 42U64) }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))
    val call = syntaxExpr(file: file, id: stmt.child0)
    val arg = syntaxArg(file: file, id: syntaxExprArg(file: file, expr: call, index: 0U64))
    val value = syntaxExpr(file: file, id: arg.value)
    match call.kind {
        SyntaxExprKind.Call => { print(1U64) }
        _ => { print(0U64) }
    }
    print(syntaxExprArgCount(file: file, expr: call))
    print(arg.label.end - arg.label.start)
    match value.kind {
        SyntaxExprKind.IntLit => { print(1U64) }
        _ => { print(0U64) }
    }
}
