import @Std/Io with { print }

// Overload discrimination must use a variable argument's DECLARED type, read from the
// parametric store (recordParametricTypes fills it with cur.locals populated). Plain
// exprType returns a nameless scalar for a variable at resolution/emission (cur.locals
// unpopulated), which used to let a typed variable adapt to any int param and silently
// select the first-declared overload — a wrong-typed call, at worst a memory-unsafe
// type pun (spec/06 review pin).
fn f(n: I64) -> I64 { return 100I64 }
fn f(n: String) -> I64 { return 200I64 }

struct Ptr { pub val s: String }
pub impl Ptr { factory }
struct Num { pub val n: I64 }
pub impl Num { factory }
fn g(x: Ptr) -> String { return x.s }
fn g(x: Num) -> String { return "num" }

// a typed I32 variable is NOT an untyped integer literal, so it selects the I32
// overload rather than tripping a false "matches more than one overload" ambiguity.
fn h(x: I32) -> I64 { return 32I64 }
fn h(x: I64) -> I64 { return 64I64 }

struct C { pub val v: I64 }
pub impl C { factory }
pub impl C { fn m(x: I64) -> I64 { return 1I64 }  fn m(x: String) -> I64 { return 2I64 } }

fn main() {
    val s: String = "hi"
    print(f(n: s))           // String overload -> 200 (was 100)
    print(f(n: 5))           // untyped literal still adapts to I64 -> 100
    val bad: Num = <Num n=1I64 />
    print(g(x: bad))         // Num overload -> "num" (was a String type-pun SIGSEGV)
    val i: I32 = 7
    print(h(x: i))           // I32 overload -> 32 (was a false ambiguity reject)
    val c: C = <C v=0 />
    print(c.m(x: s))         // method String overload -> 2 (was 1)
}
