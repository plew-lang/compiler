use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Mid/Build only { MidFunctionTemplates }
use ../../../src/Mid/DeclarationAccess only { checkDeclarationLocalAccess, DeclarationAccessError }
use ../../../src/Mid/Verify only { MidVerifyError }
use @Std/Core only { assert }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn classification(result: Result[(), DeclarationAccessError]) -> U64 {
    match result {
        Result.Ok(value: _) => { return 0U64 }
        Result.Err(error: val error) => {
            match error {
                DeclarationAccessError.LocalAccess(body: _, error: val conflict) => {
                    match conflict {
                        MidVerifyError.ConflictingBorrowAccess => { return 1U64 }
                        MidVerifyError.ConflictingReceiverAccess => { return 2U64 }
                        _ => { return 3U64 }
                    }
                }
                DeclarationAccessError.Frontend(diagnostic: val diagnostic) => { print(diagnostic.message) return 3U64 }
                _ => { return 3U64 }
            }
        }
    }
}
fn main() {
    mut val compiler = <Comp />
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.File path=argAt(1I64) />, sources: <SourceAccess stdRoot=argAt(2I64).bytes() />).unwrap()
    assert(compiler.monoWork.bodyCount() == 0U64)
    assert(compiler.arena.finalDestructions.count() == 0U64)
    val identities = compiler.arena.bodyInstanceCount()
    mut val eager = compiler
    val sourceCalls = compiler.callTemplateSnapshot()
    mut val demanded = <MidFunctionTemplates />
    mut val full = <MidFunctionTemplates />
    val result = classification(result: checkDeclarationLocalAccess(c: inout compiler, templates: inout demanded))
    val reference = classification(result: checkDeclarationLocalAccess(c: inout eager, templates: inout full, eager: true))
    assert(result == reference)
    assert(compiler.mid.bodies.count() <= eager.mid.bodies.count())
    mut val index = 0U64
    while index < sourceCalls.count() {
        assert(eager.callTemplateAt(index: index).mayHaveStorageArguments == sourceCalls[index].mayHaveStorageArguments)
        assert(compiler.callTemplateAt(index: index).mayHaveStorageArguments == sourceCalls[index].mayHaveStorageArguments)
        index += 1U64
    }
    assert(compiler.monoWork.bodyCount() == 0U64)
    assert(compiler.arena.finalDestructions.count() == 0U64)
    assert(compiler.arena.bodyInstanceCount() == identities)
    assert(eager.monoWork.bodyCount() == 0U64)
    assert(eager.arena.finalDestructions.count() == 0U64)
    assert(eager.arena.bodyInstanceCount() == identities)
    print(result)
    print(compiler.mid.bodies.count())
    print(eager.mid.bodies.count())
}
