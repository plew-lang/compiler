use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use ../../../src/Ir only { CallTemplate, CallTemplateKind }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Mid/Build only { MidFunctionTemplates }
use ../../../src/Mid/DeclarationAccess only { analyzeDeclarationGlobalAccess, DeclarationAccessError, DeclarationAccessNode, DeclarationAccessObligation }
use ../../../src/Mid/Diagnostics only { reportMidBuildError }
use @Std/Core only { assert }
use @Std/Process only { argAt }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.File path=argAt(1I64) />,
        sources: <SourceAccess stdRoot=argAt(2I64).bytes() />).unwrap()
    val instances = compiler.arena.bodyInstanceCount()
    val bodies = compiler.monoWork.bodyCount()
    val destructions = compiler.arena.finalDestructions.count()
    val structures = compiler.arena.structCount()
    // Semantic identity interning is distinct from executable discovery.
    assert(bodies == 0U64)
    assert(destructions == 0U64)
    mut val templates = <MidFunctionTemplates />
    match analyzeDeclarationGlobalAccess(c: inout compiler, templates: inout templates) {
        Result.Ok(value: val analysis) => {
            if analysis.conflictingNode != 0U64 { print("conflict") }
            else { print("clear") }
            assert(analysis.obligations.count() > 0U64)
            print("pending")
            // Corrupt a reachable selection only after Mid has been frozen.
            // A missing selection must not become an ordinary deferred effect.
            mut val testedSelection = false
            mut val obligation = 0U64
            while obligation < analysis.obligations.count() && !testedSelection {
                match analysis.obligations[obligation] {
                    DeclarationAccessObligation.Call(body: _, terminator: _, template: val template) => {
                        mut val broken = compiler
                        val selected = broken.decls.callTemplates[template]
                        broken.decls.callTemplates.set(i: template, value: <CallTemplate siteKey=selected.siteKey resultTypeRecipe=selected.resultTypeRecipe kind=<CallTemplateKind.Pending /> expectedResultTerm=selected.expectedResultTerm receiverTypeTerm=selected.receiverTypeTerm />)
                        match analyzeDeclarationGlobalAccess(c: inout broken, templates: inout templates) {
                            Result.Err(error: val error) => {
                                match error {
                                    DeclarationAccessError.CallSelection(body: _, terminator: _) => { testedSelection = true }
                                    _ => { panic "wrong missing-selection diagnostic" }
                                }
                            }
                            Result.Ok(value: _) => { panic "unfinished selection was accepted" }
                        }
                    }
                    _ => {}
                }
                obligation += 1U64
            }
            assert(testedSelection)
        }
        Result.Err(error: val failure) => {
            match failure {
                DeclarationAccessError.Build(body: val body, error: val error) => {
                    compiler.traceCodegen = true
                    match body {
                        DeclarationAccessNode.Function(function: val function) => { reportMidBuildError(c: inout compiler, fnIdx: function, error: error) }
                        _ => { print("synthetic body build failed") }
                    }
                }
                DeclarationAccessError.CallSelection(body: _, terminator: _) => { print("missing call selection") }
                DeclarationAccessError.LocalAccess(body: _, error: _) => { print("local access conflict") }
                DeclarationAccessError.Ownership(body: _, verification: _) => { print("ownership rewrite failed") }
                DeclarationAccessError.Frontend(diagnostic: val diagnostic) => { print(diagnostic.message) }
            }
            panic "declaration analysis failed"
        }
    }
    assert(compiler.arena.bodyInstanceCount() == instances)
    assert(compiler.monoWork.bodyCount() == bodies)
    assert(compiler.arena.finalDestructions.count() == destructions)
    assert(compiler.arena.structCount() == structures)
}
