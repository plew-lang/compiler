// Test the production representation leaf without importing Comp or Backend.
use ../../../src/Backend/PhysicalSignature only { LlvmSignatureScope, LlvmLogicalSignature, LlvmLogicalParameter, LlvmParameterRole, LlvmParameterMode, LlvmValueConvention, LlvmLegacyConvention, LlvmGlueOperation, LlvmPhysicalSignature, LlvmValueParameter, LlvmValuePassing, LlvmInputScope, LlvmCallableInputScope, LlvmValueInput, LlvmValueCarrier }
use ../../../src/LlvmHandles only { LLVMContextRef, LLVMModuleRef, LLVMTypeRef, LLVMValueRef }
use @Std/Io only { write }
extern(c) {
    fn plew_test_projected_homes()
    fn plew_test_signature_byref_function(module~: LLVMModuleRef, aggregate~: LLVMTypeRef, alignment~: U64) -> LLVMValueRef
    fn plew_test_signature_function(module~: LLVMModuleRef, aggregate~: LLVMTypeRef) -> LLVMValueRef
    fn plew_test_signature_value(function~: LLVMValueRef, type~: LLVMTypeRef, kind~: U32) -> LLVMValueRef
    fn plew_test_signature_constant(module~: LLVMModuleRef, kind~: U32) -> LLVMValueRef
    fn LLVMTypeOf(value~: LLVMValueRef) -> LLVMTypeRef
    fn LLVMInt32TypeInContext(context~: LLVMContextRef) -> LLVMTypeRef
    fn LLVMPointerTypeInContext(context~: LLVMContextRef, addressSpace~: U32) -> LLVMTypeRef
    fn LLVMContextCreate() -> LLVMContextRef
    fn LLVMContextDispose(context~: LLVMContextRef)
    fn LLVMDisposeModule(module~: LLVMModuleRef)
    fn plew_test_signature_module(context~: LLVMContextRef) -> LLVMModuleRef
    fn plew_test_signature_blank_module(context~: LLVMContextRef) -> LLVMModuleRef
    fn plew_test_signature_type(context~: LLVMContextRef, kind~: U32) -> LLVMTypeRef
    fn plew_test_signature_change_layout(module~: LLVMModuleRef)
    fn LLVMCountParamTypes(type~: LLVMTypeRef) -> U32
}
fn parameter(type: LLVMTypeRef, semantic: U64, role: LlvmParameterRole, mode: LlvmParameterMode, copyable: Bool = false) -> LlvmLogicalParameter {
    return <LlvmLogicalParameter type=type semanticType=semantic copyable=copyable role=role mode=mode />
}
fn body(parameters: Array[LlvmLogicalParameter], result: LLVMTypeRef) -> LlvmLogicalSignature {
    return <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=parameters result=result resultTerm=0U64 />
}
fn closure(parameters: Array[LlvmLogicalParameter], result: LLVMTypeRef, resultTerm: U64 = 0U64) -> LlvmLogicalSignature {
    return <LlvmLogicalSignature convention=<LlvmValueConvention.Closure /> parameters=parameters result=result resultTerm=resultTerm />
}
fn witness(parameters: Array[LlvmLogicalParameter], result: LLVMTypeRef, targetType: U64 = 20U64, traitIndex: U64 = 0U64, slot: U64 = 1U64, resultTerm: U64 = 0U64) -> LlvmLogicalSignature {
    return <LlvmLogicalSignature convention=<LlvmValueConvention.Witness targetType=targetType traitIndex=traitIndex slot=slot /> parameters=parameters result=result resultTerm=resultTerm />
}
fn changedConvention(plan: LlvmPhysicalSignature, convention: LlvmValueConvention) -> LlvmPhysicalSignature {
    return <LlvmPhysicalSignature parameters=plan.parameters logicalSignature=plan.logicalSignature functionType=plan.functionType moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=plan.revision targetTriple=plan.targetTriple dataLayout=plan.dataLayout convention=convention resultTerm=plan.resultTerm resultProtocol=plan.resultProtocol />
}
fn changed(plan: LlvmPhysicalSignature, parameters: Array[LlvmValueParameter], revision: U64 = 1U64) -> LlvmPhysicalSignature {
    return <LlvmPhysicalSignature parameters=parameters logicalSignature=plan.logicalSignature functionType=plan.functionType moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=revision targetTriple=plan.targetTriple dataLayout=plan.dataLayout convention=plan.convention resultTerm=plan.resultTerm resultProtocol=plan.resultProtocol />
}
fn main() {
    plew_test_projected_homes()
    val context = LLVMContextCreate()
    val foreignContext = LLVMContextCreate()
    val blank = plew_test_signature_blank_module(context)
    if LlvmSignatureScope.admitted(module: blank).isOk() { panic "missing target admitted" }
    LLVMDisposeModule(blank)
    val module = plew_test_signature_module(context)
    val otherModule = plew_test_signature_module(context)
    val foreignModule = plew_test_signature_module(foreignContext)
    val scope = LlvmSignatureScope.admitted(module: module).unwrap()
    val otherScope = LlvmSignatureScope.admitted(module: otherModule).unwrap()
    val foreignScope = LlvmSignatureScope.admitted(module: foreignModule).unwrap()
    val voidType = plew_test_signature_type(context, 0U32)
    val scalar = plew_test_signature_type(context, 1U32)
    val empty = plew_test_signature_type(context, 2U32)
    val aggregate = plew_test_signature_type(context, 3U32)
    val pointer = plew_test_signature_type(context, 4U32)
    val incomplete = plew_test_signature_type(context, 5U32)
    val foreignScalar = plew_test_signature_type(foreignContext, 1U32)
    val receiver = parameter(type: aggregate, semantic: 11U64, role: <LlvmParameterRole.Receiver />, mode: <LlvmParameterMode.Borrow />)
    val omitted = parameter(type: empty, semantic: 12U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: <LlvmParameterMode.Move />)
    val direct = parameter(type: scalar, semantic: 13U64, role: <LlvmParameterRole.Ordinary index=1U64 />, mode: <LlvmParameterMode.Borrow />)
    val inoutLane = parameter(type: pointer, semantic: 12U64, role: <LlvmParameterRole.Ordinary index=2U64 />, mode: <LlvmParameterMode.Inout />)
    val signature = body(parameters: [receiver, omitted, direct, inoutLane], result: voidType)
    val plan = scope.plan(signature: signature).unwrap()
    scope.validate(signature: signature, plan: plan).unwrap()
    if plan.parameters.count() != 4U64 || LLVMCountParamTypes(plan.functionType) != 3U32 { panic "physical lane count" }
    if plan.parameters[0].passing.key() != 2U64 || plan.parameters[0].valueAlignment != 8U64 { panic "aggregate byval alignment" }
    if plan.parameters[1].passing.key() != 0U64 || plan.parameters[1].valueAlignment != 0U64 || plan.parameters[1].physicalIndex != 1U64 { panic "empty omission" }
    if plan.parameters[2].passing.key() != 1U64 || plan.parameters[2].physicalIndex != 1U64 { panic "ordinary after omission" }
    if plan.parameters[3].passing.key() != 1U64 || plan.parameters[3].physicalIndex != 2U64 { panic "inout empty semantic value must retain pointer" }
    if plan.resultProtocol.key() != 0U64 { panic "void result" }
    val valueSignature = <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=[] result=aggregate resultTerm=11U64 />
    if scope.plan(signature: valueSignature).unwrap().resultProtocol.key() != 1U64 { panic "unchanged aggregate return" }
    if otherScope.validate(signature: signature, plan: plan).isOk() { panic "foreign module accepted" }
    if foreignScope.validate(signature: signature, plan: plan).isOk() { panic "foreign context accepted" }
    if scope.validate(signature: signature, plan: changed(plan: plan, parameters: plan.parameters, revision: 2U64)).isOk() { panic "foreign revision accepted" }
    // Equal native types must not erase semantic type, role or ownership mode.
    val pointerBorrow = parameter(type: pointer, semantic: 20U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: <LlvmParameterMode.Borrow />)
    val pointerInout = parameter(type: pointer, semantic: 20U64, role: pointerBorrow.role, mode: <LlvmParameterMode.Inout />)
    val pointerSignature = body(parameters: [pointerBorrow], result: voidType)
    val pointerPlan = scope.plan(signature: pointerSignature).unwrap()
    if scope.validate(signature: body(parameters: [pointerInout], result: voidType), plan: pointerPlan).isOk() { panic "equal pointer with inout mode accepted" }
    if scope.plan(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=[] result=voidType resultTerm=11U64 />).isOk() { panic "void result with semantic value accepted" }
    if scope.plan(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=[] result=scalar resultTerm=0U64 />).isOk() { panic "value result without semantic value accepted" }
    if scope.plan(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=[] result=foreignScalar resultTerm=11U64 />).isOk() { panic "foreign result accepted" }
    val plain = parameter(type: aggregate, semantic: 11U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: <LlvmParameterMode.Borrow />)
    val plainSignature = body(parameters: [plain], result: voidType)
    val plainPlan = scope.plan(signature: plainSignature).unwrap()
    val receiverSignature = body(parameters: [receiver], result: voidType)
    if scope.validate(signature: receiverSignature, plan: plainPlan).isOk() { panic "equal type different role accepted" }
    val moved = parameter(type: aggregate, semantic: 11U64, role: plain.role, mode: <LlvmParameterMode.Move />)
    if scope.validate(signature: body(parameters: [moved], result: voidType), plan: plainPlan).isOk() { panic "different ownership accepted" }
    val differentSemantic = parameter(type: aggregate, semantic: 99U64, role: plain.role, mode: plain.mode)
    if scope.validate(signature: body(parameters: [differentSemantic], result: voidType), plan: plainPlan).isOk() { panic "different semantic type accepted" }
    val malformedIndex = parameter(type: aggregate, semantic: 11U64, role: <LlvmParameterRole.Ordinary index=1U64 />, mode: plain.mode)
    if scope.plan(signature: body(parameters: [malformedIndex], result: voidType)).isOk() { panic "nonsequential index accepted" }
    if scope.plan(signature: body(parameters: [plain, receiver], result: voidType)).isOk() { panic "late receiver accepted" }
    val foreign = parameter(type: foreignScalar, semantic: 11U64, role: plain.role, mode: plain.mode)
    if scope.plan(signature: body(parameters: [foreign], result: voidType)).isOk() { panic "foreign native type accepted" }
    val opaque = parameter(type: incomplete, semantic: 11U64, role: plain.role, mode: plain.mode)
    if scope.plan(signature: body(parameters: [opaque], result: voidType)).isOk() { panic "unsized type accepted" }
    val badInout = parameter(type: aggregate, semantic: 11U64, role: plain.role, mode: <LlvmParameterMode.Inout />)
    if scope.plan(signature: body(parameters: [badInout], result: voidType)).isOk() { panic "value represented inout accepted" }
    val lane = plainPlan.parameters[0]
    val badLane = <LlvmValueParameter type=lane.type semanticType=lane.semanticType role=lane.role mode=lane.mode physicalIndex=9U64 passing=lane.passing valueAlignment=lane.valueAlignment />
    if scope.validate(signature: plainSignature, plan: changed(plan: plainPlan, parameters: [badLane])).isOk() { panic "corrupt physical index accepted" }
    val badAlignment = <LlvmValueParameter type=lane.type semanticType=lane.semanticType role=lane.role mode=lane.mode physicalIndex=lane.physicalIndex passing=lane.passing valueAlignment=1U64 />
    if scope.validate(signature: plainSignature, plan: changed(plan: plainPlan, parameters: [badAlignment])).isOk() { panic "corrupt alignment accepted" }
    val badTransport = <LlvmValueParameter type=lane.type semanticType=lane.semanticType role=lane.role mode=lane.mode physicalIndex=lane.physicalIndex passing=<LlvmValuePassing.Direct /> valueAlignment=lane.valueAlignment />
    if scope.validate(signature: plainSignature, plan: changed(plan: plainPlan, parameters: [badTransport])).isOk() { panic "corrupt transport accepted" }
    // Completed copyability selects a deterministic no-copy pointer lane.
    val guaranteed = parameter(type: aggregate, semantic: 11U64, role: plain.role, mode: plain.mode, copyable: true)
    val guaranteedPlan = scope.plan(signature: body(parameters: [guaranteed], result: voidType)).unwrap()
    if guaranteedPlan.parameters[0U64].passing.key() != 3U64 || !guaranteedPlan.parameters[0U64].copyable { panic "copyable Borrow aggregate is not guaranteed indirect" }
    if plainPlan.parameters[0U64].passing.key() != 2U64 { panic "unproved aggregate lost conservative byval" }
    val consumingCopyable = parameter(type: aggregate, semantic: 11U64, role: plain.role, mode: <LlvmParameterMode.Move />, copyable: true)
    if scope.plan(signature: body(parameters: [consumingCopyable], result: voidType)).unwrap().parameters[0U64].passing.key() != 2U64 { panic "consuming lane became guaranteed" }
    if scope.validate(signature: body(parameters: [guaranteed], result: voidType), plan: plainPlan).isOk() { panic "changed copyability/transport accepted" }
    val guaranteedFunction = plew_test_signature_byref_function(module, aggregate, guaranteedPlan.parameters[0U64].valueAlignment)
    val guaranteedHome = plew_test_signature_value(guaranteedFunction, aggregate, 0U32)
    val guaranteedInput = <LlvmValueInput lane=guaranteed index=0U64 carrier=<LlvmValueCarrier.Home address=guaranteedHome /> />
    scope.validateInput(parameter: guaranteedPlan.parameters[0U64], input: guaranteedInput, index: 0U64, function: guaranteedFunction).unwrap()
    val underaligned = plew_test_signature_byref_function(module, aggregate, 1U64)
    val underalignedInput = <LlvmValueInput lane=guaranteed index=0U64 carrier=<LlvmValueCarrier.Home address=plew_test_signature_value(underaligned, aggregate, 0U32) /> />
    if scope.validateInput(parameter: guaranteedPlan.parameters[0U64], input: underalignedInput, index: 0U64, function: underaligned).isOk() { panic "underaligned guaranteed home accepted" }
    val wrongCapability = <LlvmValueInput lane=plain index=0U64 carrier=<LlvmValueCarrier.Home address=guaranteedHome /> />
    if scope.validateInput(parameter: guaranteedPlan.parameters[0U64], input: wrongCapability, index: 0U64, function: guaranteedFunction).isOk() { panic "missing copyability handoff accepted" }
    val legacy = <LlvmLogicalSignature convention=<LlvmValueConvention.Legacy family=<LlvmLegacyConvention.Closure /> /> parameters=[parameter(type: aggregate, semantic: 0U64, role: <LlvmParameterRole.Legacy index=0U64 />, mode: <LlvmParameterMode.Legacy />)] result=voidType resultTerm=0U64 />
    scope.validate(signature: legacy, plan: scope.plan(signature: legacy).unwrap()).unwrap()
    val retired: Array[LlvmLegacyConvention] = [<LlvmLegacyConvention.Witness />, <LlvmLegacyConvention.AsyncEntry />, <LlvmLegacyConvention.AsyncResume />, <LlvmLegacyConvention.EnvironmentDrop />, <LlvmLegacyConvention.ExistentialCopy />, <LlvmLegacyConvention.ExistentialDrop />, <LlvmLegacyConvention.StructRetain />, <LlvmLegacyConvention.StructDrop />, <LlvmLegacyConvention.EnumRetain />, <LlvmLegacyConvention.EnumRelease />]
    for family in retired {
        if scope.plan(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Legacy family=family /> parameters=legacy.parameters result=voidType resultTerm=0U64 />).isOk() { panic "retired legacy family accepted" }
    }

    if scope.plan(signature: <LlvmLogicalSignature convention=legacy.convention parameters=[plain] result=voidType resultTerm=0U64 />).isOk() { panic "legacy claims semantic role" }
    // Completed closure signatures retain an explicit environment, including
    // when there are no ordinary lanes or their native ptr types are equal.
    if (<LlvmValueConvention.Closure />).key() != 12U64 { panic "closure convention key" }
    val environment = parameter(type: pointer, semantic: 0U64, role: <LlvmParameterRole.Environment />, mode: <LlvmParameterMode.Borrow />)
    val zeroClosure = closure(parameters: [environment], result: voidType)
    val zeroClosurePlan = scope.plan(signature: zeroClosure).unwrap()
    scope.validate(signature: zeroClosure, plan: zeroClosurePlan).unwrap()
    if zeroClosurePlan.parameters.count() != 1U64 || LLVMCountParamTypes(zeroClosurePlan.functionType) != 1U32 || zeroClosurePlan.parameters[0].passing.key() != 1U64 { panic "zero-argument closure environment" }
    val closureEmpty = parameter(type: empty, semantic: 12U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: <LlvmParameterMode.Borrow />)
    val closureAggregate = parameter(type: aggregate, semantic: 11U64, role: <LlvmParameterRole.Ordinary index=1U64 />, mode: <LlvmParameterMode.Borrow />)
    val closurePointer = parameter(type: pointer, semantic: 20U64, role: <LlvmParameterRole.Ordinary index=2U64 />, mode: <LlvmParameterMode.Borrow />)
    val closureSignature = closure(parameters: [environment, closureEmpty, closureAggregate, closurePointer], result: aggregate, resultTerm: 11U64)
    val closurePlan = scope.plan(signature: closureSignature).unwrap()
    scope.validate(signature: closureSignature, plan: closurePlan).unwrap()
    if closurePlan.parameters.count() != 4U64 || LLVMCountParamTypes(closurePlan.functionType) != 3U32 || closurePlan.resultProtocol.key() != 1U64 { panic "multi-lane closure mapping" }
    if closurePlan.parameters[1].passing.key() != 0U64 || closurePlan.parameters[2].passing.key() != 2U64 || closurePlan.parameters[2].physicalIndex != 1U64 || closurePlan.parameters[3].physicalIndex != 2U64 { panic "closure omission and byval mapping" }
    if scope.plan(signature: closure(parameters: [], result: voidType)).isOk() { panic "missing closure environment accepted" }
    if scope.plan(signature: closure(parameters: [pointerBorrow], result: voidType)).isOk() { panic "ordinary ptr substituted for environment" }
    if scope.plan(signature: closure(parameters: [pointerBorrow, environment], result: voidType)).isOk() { panic "swapped closure environment accepted" }
    if scope.plan(signature: closure(parameters: [environment, environment], result: voidType)).isOk() { panic "duplicate closure environment accepted" }
    if scope.plan(signature: body(parameters: [environment], result: voidType)).isOk() { panic "environment in body accepted" }
    if scope.plan(signature: closure(parameters: [parameter(type: scalar, semantic: 0U64, role: environment.role, mode: environment.mode)], result: voidType)).isOk() { panic "nonpointer closure environment accepted" }
    if scope.plan(signature: closure(parameters: [parameter(type: pointer, semantic: 20U64, role: environment.role, mode: environment.mode)], result: voidType)).isOk() { panic "semantic closure environment accepted" }
    if scope.plan(signature: closure(parameters: [environment, parameter(type: pointer, semantic: 0U64, role: pointerBorrow.role, mode: pointerBorrow.mode)], result: voidType)).isOk() { panic "closure ordinary ptr lacks semantic term" }
    if scope.plan(signature: closure(parameters: [environment, receiver], result: voidType)).isOk() { panic "closure receiver accepted" }
    if scope.plan(signature: closure(parameters: [environment, malformedIndex], result: voidType)).isOk() { panic "closure ordinary index accepted" }
    if scope.plan(signature: closure(parameters: [environment, legacy.parameters[0]], result: voidType)).isOk() { panic "closure legacy lane accepted" }
    val invalidClosureModes: Array[LlvmParameterMode] = [<LlvmParameterMode.Move />, <LlvmParameterMode.Inout />, <LlvmParameterMode.Legacy />]
    for mode in invalidClosureModes {
        if scope.plan(signature: closure(parameters: [parameter(type: pointer, semantic: 0U64, role: environment.role, mode: mode)], result: voidType)).isOk() { panic "nonborrow environment accepted" }
        if scope.plan(signature: closure(parameters: [environment, parameter(type: pointer, semantic: 20U64, role: pointerBorrow.role, mode: mode)], result: voidType)).isOk() { panic "nonborrow closure ordinary accepted" }
    }
    if scope.plan(signature: closure(parameters: [environment], result: voidType, resultTerm: 11U64)).isOk() { panic "closure void result has semantic term" }
    if scope.plan(signature: closure(parameters: [environment], result: scalar)).isOk() { panic "closure value result lacks semantic term" }
    val closurePtrSignature = closure(parameters: [environment, pointerBorrow], result: voidType)
    val closurePtrPlan = scope.plan(signature: closurePtrSignature).unwrap()
    val changedClosureTerm = parameter(type: pointer, semantic: 99U64, role: pointerBorrow.role, mode: pointerBorrow.mode)
    if scope.validate(signature: closure(parameters: [environment, changedClosureTerm], result: voidType), plan: closurePtrPlan).isOk() { panic "same ptr closure semantic substitution accepted" }
    if scope.validate(signature: closure(parameters: closureSignature.parameters, result: aggregate, resultTerm: 99U64), plan: closurePlan).isOk() { panic "closure semantic result substitution accepted" }
    // Witness payload identity is distinct from its ptr-shaped erased receiver.
    val erasedReceiver = parameter(type: pointer, semantic: 20U64, role: <LlvmParameterRole.ErasedReceiver />, mode: <LlvmParameterMode.Borrow />)
    val glueOperations: Array[LlvmGlueOperation] = [<LlvmGlueOperation.EnvironmentDrop />, <LlvmGlueOperation.ExistentialCopy />, <LlvmGlueOperation.ExistentialDrop />, <LlvmGlueOperation.StructRetain />, <LlvmGlueOperation.StructDrop />, <LlvmGlueOperation.EnumRetain />, <LlvmGlueOperation.EnumRelease />]
    for operation in glueOperations {
        val mode = if operation.borrowsPayload() { give <LlvmParameterMode.Borrow /> } else { give <LlvmParameterMode.Move /> }
        val role = if operation.erased() { give <LlvmParameterRole.GlueStorage /> } else { give <LlvmParameterRole.GlueValue /> }
        val type = if operation.erased() { give pointer } else { give aggregate }
        val semantic = if operation.erased() { give 0U64 } else { give 30U64 }
        val result = if operation.key() == 2U64 { give pointer } else { give voidType }
        val lane = parameter(type: type, semantic: semantic, role: role, mode: mode)
        val signature = <LlvmLogicalSignature convention=<LlvmValueConvention.OwnershipGlue operation=operation /> parameters=[lane] result=result resultTerm=0U64 />
        val plan = scope.plan(signature: signature).unwrap()
        scope.validate(signature: signature, plan: plan).unwrap()
        if !plan.convention.matchesGlue(operation: operation) || plan.parameters[0].passing.key() != if operation.erased() { give 1U64 } else { give 2U64 } { panic "glue operation representation mismatch" }
        mut val malformed = 0U64
        while malformed < 6U64 {
            val badLane = parameter(type: type, semantic: if malformed == 0U64 { give if semantic == 0U64 { give 30U64 } else { give 0U64 } } else { give semantic }, role: if malformed == 1U64 { give <LlvmParameterRole.Ordinary index=0U64 /> } else { give role }, mode: if malformed == 2U64 { give <LlvmParameterMode.Inout /> } else { give mode })
            val bad = <LlvmLogicalSignature convention=signature.convention parameters=if malformed == 3U64 { give [] } else { give [badLane] } result=if malformed == 4U64 { give if operation.key() == 2U64 { give voidType } else { give pointer } } else { give result } resultTerm=if malformed == 5U64 { give 30U64 } else { give 0U64 } />
            if scope.plan(signature: bad).isOk() { panic "malformed ownership glue accepted" }
            malformed += 1U64
        }
        if !operation.erased() {
            val zero = <LlvmLogicalSignature convention=signature.convention parameters=[parameter(type: empty, semantic: 31U64, role: role, mode: mode)] result=voidType resultTerm=0U64 />
            if scope.plan(signature: zero).unwrap().parameters[0].passing.key() != 0U64 { panic "zero-size glue not omitted" }
            if scope.validate(signature: <LlvmLogicalSignature convention=signature.convention parameters=[parameter(type: type, semantic: 31U64, role: role, mode: mode)] result=result resultTerm=0U64 />, plan: plan).isOk() { panic "glue semantic substitution accepted" }
        }
        for other in glueOperations {
            if (operation.key() == other.key()) != plan.convention.matchesGlue(operation: other) { panic "glue operation identity erased" }
            if operation.key() != other.key() && scope.validate(signature: signature, plan: changedConvention(plan: plan, convention: <LlvmValueConvention.OwnershipGlue operation=other />)).isOk() { panic "different glue operation substituted" }
        }
    }
    val asyncEntry = <LlvmLogicalSignature convention=<LlvmValueConvention.AsyncEntry /> parameters=[parameter(type: aggregate, semantic: 40U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: <LlvmParameterMode.Borrow />), parameter(type: empty, semantic: 41U64, role: <LlvmParameterRole.Ordinary index=1U64 />, mode: <LlvmParameterMode.Move />)] result=pointer resultTerm=50U64 />
    val asyncPlan = scope.plan(signature: asyncEntry).unwrap()
    if asyncPlan.parameters[0].passing.key() != 2U64 || asyncPlan.parameters[1].passing.key() != 0U64 || asyncPlan.resultTerm != 50U64 { panic "async entry lost aggregate/omitted/Promise mapping" }
    val frameLane = parameter(type: pointer, semantic: 0U64, role: <LlvmParameterRole.Frame bodyId=60U64 />, mode: <LlvmParameterMode.Move />)
    val asyncResume = <LlvmLogicalSignature convention=<LlvmValueConvention.AsyncResume /> parameters=[frameLane] result=voidType resultTerm=0U64 />
    val resumePlan = scope.plan(signature: asyncResume).unwrap()
    if resumePlan.parameters[0].passing.key() != 1U64 || resumePlan.resultTerm != 0U64 || resumePlan.convention.same(convention: asyncPlan.convention) { panic "async resume conflates entry/Frame/native result" }
    val otherFrame = parameter(type: pointer, semantic: 0U64, role: <LlvmParameterRole.Frame bodyId=61U64 />, mode: <LlvmParameterMode.Move />)
    if scope.validate(signature: <LlvmLogicalSignature convention=asyncResume.convention parameters=[otherFrame] result=voidType resultTerm=0U64 />, plan: resumePlan).isOk() { panic "equal-ptr distinct frame identity accepted" }
    mut val asyncMalformed = 0U64
    while asyncMalformed < 5U64 {
        val lane = parameter(type: aggregate, semantic: if asyncMalformed == 0U64 { give 0U64 } else { give 40U64 }, role: if asyncMalformed == 1U64 { give <LlvmParameterRole.Frame bodyId=60U64 /> } else { give <LlvmParameterRole.Ordinary index=0U64 /> }, mode: if asyncMalformed == 2U64 { give <LlvmParameterMode.Inout /> } else { give <LlvmParameterMode.Borrow /> })
        if scope.plan(signature: <LlvmLogicalSignature convention=asyncEntry.convention parameters=[lane] result=if asyncMalformed == 3U64 { give voidType } else { give pointer } resultTerm=if asyncMalformed == 4U64 { give 0U64 } else { give 50U64 } />).isOk() { panic "malformed async entry accepted" }
        asyncMalformed += 1U64
    }
    asyncMalformed = 0U64
    while asyncMalformed < 7U64 {
        val lane = parameter(type: if asyncMalformed == 0U64 { give scalar } else { give pointer }, semantic: if asyncMalformed == 1U64 { give 40U64 } else { give 0U64 }, role: if asyncMalformed == 2U64 { give <LlvmParameterRole.Frame bodyId=0U64 /> } else { give frameLane.role }, mode: if asyncMalformed == 3U64 { give <LlvmParameterMode.Borrow /> } else { give frameLane.mode })
        if scope.plan(signature: <LlvmLogicalSignature convention=asyncResume.convention parameters=if asyncMalformed == 4U64 { give [] } else { give [lane] } result=if asyncMalformed == 5U64 { give pointer } else { give voidType } resultTerm=if asyncMalformed == 6U64 { give 50U64 } else { give 0U64 } />).isOk() { panic "malformed async Frame/result accepted" }
        asyncMalformed += 1U64
    }
    val status = LLVMInt32TypeInContext(context)
    val argumentCount = parameter(type: status, semantic: 0U64, role: <LlvmParameterRole.ProgramArgumentCount />, mode: <LlvmParameterMode.Borrow />)
    val argumentValues = parameter(type: pointer, semantic: 0U64, role: <LlvmParameterRole.ProgramArgumentValues />, mode: <LlvmParameterMode.Borrow />)
    val program = <LlvmLogicalSignature convention=<LlvmValueConvention.ProgramMain /> parameters=[argumentCount, argumentValues] result=status resultTerm=0U64 />
    val programPlan = scope.plan(signature: program).unwrap()
    scope.validate(signature: program, plan: programPlan).unwrap()
    if programPlan.resultProtocol.key() != 2U64 || programPlan.parameters[0].passing.key() != 1U64 || programPlan.parameters[1].physicalIndex != 1U64 { panic "native program roles/result lost" }
    mut val programMalformed = 0U64
    while programMalformed < 9U64 {
        val count = parameter(type: if programMalformed == 0U64 { give scalar } else { give status }, semantic: if programMalformed == 1U64 { give 40U64 } else { give 0U64 }, role: if programMalformed == 2U64 { give argumentValues.role } else { give argumentCount.role }, mode: if programMalformed == 3U64 { give <LlvmParameterMode.Move /> } else { give argumentCount.mode })
        val values = parameter(type: if programMalformed == 4U64 { give scalar } else if programMalformed == 8U64 { give LLVMPointerTypeInContext(context, 1U32) } else { give pointer }, semantic: 0U64, role: argumentValues.role, mode: argumentValues.mode)
        val bad = <LlvmLogicalSignature convention=program.convention parameters=if programMalformed == 5U64 { give [count] } else { give [count, values] } result=if programMalformed == 6U64 { give scalar } else { give status } resultTerm=if programMalformed == 7U64 { give 40U64 } else { give 0U64 } />
        if scope.plan(signature: bad).isOk() { panic "malformed program native contract accepted" }
        programMalformed += 1U64
    }
    val initializer = <LlvmLogicalSignature convention=<LlvmValueConvention.GlobalInitializer /> parameters=[] result=voidType resultTerm=0U64 />
    val initializerPlan = scope.plan(signature: initializer).unwrap()
    if initializerPlan.parameters.count() != 0U64 || initializerPlan.resultProtocol.key() != 0U64 { panic "initializer native contract lost" }
    if scope.plan(signature: <LlvmLogicalSignature convention=initializer.convention parameters=[argumentCount] result=voidType resultTerm=0U64 />).isOk() || scope.plan(signature: <LlvmLogicalSignature convention=initializer.convention parameters=[] result=status resultTerm=0U64 />).isOk() || scope.plan(signature: <LlvmLogicalSignature convention=initializer.convention parameters=[] result=voidType resultTerm=40U64 />).isOk() { panic "malformed initializer accepted" }
    val witnessSignature = witness(parameters: [erasedReceiver], result: voidType)
    val witnessPlan = scope.plan(signature: witnessSignature).unwrap()
    scope.validate(signature: witnessSignature, plan: witnessPlan).unwrap()
    if witnessPlan.convention.key() != 13U64 || LLVMCountParamTypes(witnessPlan.functionType) != 1U32 || witnessPlan.parameters[0].passing.key() != 1U64 { panic "witness receiver representation" }
    val modes: Array[LlvmParameterMode] = [<LlvmParameterMode.Borrow />, <LlvmParameterMode.Inout />, <LlvmParameterMode.Move />]
    for mode in modes {
        val witnessReceiver = parameter(type: pointer, semantic: 20U64, role: erasedReceiver.role, mode: mode)
        val ordinaryPointer = parameter(type: pointer, semantic: 21U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: mode)
        val witnessModeSignature = witness(parameters: [witnessReceiver, ordinaryPointer, closureAggregate], result: aggregate, resultTerm: 11U64)
        val witnessModePlan = scope.plan(signature: witnessModeSignature).unwrap()
        scope.validate(signature: witnessModeSignature, plan: witnessModePlan).unwrap()
        if witnessModePlan.parameters[0].physicalIndex != 0U64 || witnessModePlan.parameters[1].physicalIndex != 1U64 || witnessModePlan.parameters[2].passing.key() != 2U64 || LLVMCountParamTypes(witnessModePlan.functionType) != 3U32 || witnessModePlan.resultProtocol.key() != 1U64 { panic "witness mode mapping" }
    }
    val witnessOmittedSignature = witness(parameters: [erasedReceiver, closureEmpty, closureAggregate], result: voidType)
    val witnessOmittedPlan = scope.plan(signature: witnessOmittedSignature).unwrap()
    if witnessOmittedPlan.parameters[1].passing.key() != 0U64 || witnessOmittedPlan.parameters[2].passing.key() != 2U64 || witnessOmittedPlan.parameters[2].physicalIndex != 1U64 || LLVMCountParamTypes(witnessOmittedPlan.functionType) != 2U32 { panic "witness omission and byval" }
    scope.validate(signature: witnessOmittedSignature, plan: witnessOmittedPlan).unwrap()
    if scope.plan(signature: witness(parameters: [], result: voidType)).isOk() { panic "missing witness receiver accepted" }
    if scope.plan(signature: witness(parameters: [environment], result: voidType)).isOk() { panic "environment replaces erased receiver" }
    if scope.plan(signature: witness(parameters: [pointerBorrow], result: voidType)).isOk() { panic "ordinary ptr replaces erased receiver" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, erasedReceiver], result: voidType)).isOk() { panic "duplicate witness receiver accepted" }
    if scope.plan(signature: witness(parameters: [pointerBorrow, erasedReceiver], result: voidType)).isOk() { panic "late witness receiver accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, environment], result: voidType)).isOk() { panic "witness environment ordinary accepted" }
    if scope.plan(signature: body(parameters: [erasedReceiver], result: voidType)).isOk() { panic "body erased receiver accepted" }
    if scope.plan(signature: closure(parameters: [erasedReceiver], result: voidType)).isOk() { panic "erased receiver replaces environment" }
    if scope.plan(signature: closure(parameters: [environment, erasedReceiver], result: voidType)).isOk() { panic "closure erased ordinary accepted" }
    if scope.plan(signature: witness(parameters: [parameter(type: scalar, semantic: 20U64, role: erasedReceiver.role, mode: erasedReceiver.mode)], result: voidType)).isOk() { panic "nonpointer erased receiver accepted" }
    if scope.plan(signature: witness(parameters: [parameter(type: pointer, semantic: 21U64, role: erasedReceiver.role, mode: erasedReceiver.mode)], result: voidType)).isOk() { panic "wrong witness target term accepted" }
    if scope.plan(signature: witness(parameters: [parameter(type: pointer, semantic: 0U64, role: erasedReceiver.role, mode: erasedReceiver.mode)], result: voidType, targetType: 0U64)).isOk() { panic "zero witness target accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver], result: voidType, slot: 0U64)).isOk() { panic "zero witness slot accepted" }
    if scope.plan(signature: witness(parameters: [parameter(type: pointer, semantic: 20U64, role: erasedReceiver.role, mode: <LlvmParameterMode.Legacy />)], result: voidType)).isOk() { panic "legacy witness receiver accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, parameter(type: pointer, semantic: 21U64, role: pointerBorrow.role, mode: <LlvmParameterMode.Legacy />)], result: voidType)).isOk() { panic "legacy witness ordinary accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, parameter(type: pointer, semantic: 0U64, role: pointerBorrow.role, mode: pointerBorrow.mode)], result: voidType)).isOk() { panic "zero witness ordinary term accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, badInout], result: voidType)).isOk() { panic "nonpointer witness inout accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, malformedIndex], result: voidType)).isOk() { panic "witness ordinary index accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, receiver], result: voidType)).isOk() { panic "witness ordinary receiver accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver, legacy.parameters[0]], result: voidType)).isOk() { panic "witness legacy role accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver], result: voidType, resultTerm: 20U64)).isOk() { panic "witness void semantic result accepted" }
    if scope.plan(signature: witness(parameters: [erasedReceiver], result: aggregate)).isOk() { panic "witness missing semantic result accepted" }
    if !witnessPlan.convention.matchesWitness(targetType: 20U64, traitIndex: 0U64, slot: 1U64) { panic "matching witness scalars rejected" }
    if witnessPlan.convention.matchesWitness(targetType: 21U64, traitIndex: 0U64, slot: 1U64) { panic "different witness target scalar accepted" }
    if witnessPlan.convention.matchesWitness(targetType: 20U64, traitIndex: 1U64, slot: 1U64) { panic "different witness trait scalar accepted" }
    if witnessPlan.convention.matchesWitness(targetType: 20U64, traitIndex: 0U64, slot: 2U64) { panic "different witness slot scalar accepted" }
    val nonWitnessConventions: Array[LlvmValueConvention] = [<LlvmValueConvention.Body />, <LlvmValueConvention.Closure />, <LlvmValueConvention.Legacy family=<LlvmLegacyConvention.Witness /> />]
    for convention in nonWitnessConventions {
        if convention.matchesWitness(targetType: 20U64, traitIndex: 0U64, slot: 1U64) { panic "non-witness scalar match accepted" }
    }
    val differentWitnessConventions: Array[LlvmValueConvention] = [<LlvmValueConvention.Witness targetType=21U64 traitIndex=0U64 slot=1U64 />, <LlvmValueConvention.Witness targetType=20U64 traitIndex=1U64 slot=1U64 />, <LlvmValueConvention.Witness targetType=20U64 traitIndex=0U64 slot=2U64 />]
    for convention in differentWitnessConventions {
        if witnessPlan.convention.same(convention: convention) { panic "witness identity payload erased" }
        if scope.validate(signature: witnessSignature, plan: changedConvention(plan: witnessPlan, convention: convention)).isOk() { panic "same native witness different payload accepted" }
    }
    if !witnessPlan.convention.same(convention: witnessSignature.convention) || witnessPlan.convention.same(convention: zeroClosure.convention) { panic "witness convention identity" }
    if (<LlvmValueConvention.Legacy family=<LlvmLegacyConvention.Closure /> />).same(convention: <LlvmValueConvention.Legacy family=<LlvmLegacyConvention.Witness /> />) { panic "legacy family identity erased" }
    val callableInputs = <LlvmCallableInputScope moduleIdentity=closurePlan.moduleIdentity contextIdentity=closurePlan.contextIdentity revision=1U64 callableIdentity=17U64 signature=closurePlan.logicalSignature />
    scope.validateCallableInputs(scope: callableInputs, callableIdentity: 17U64, signature: closurePlan.logicalSignature).unwrap()
    if scope.validateCallableInputs(scope: callableInputs, callableIdentity: 18U64, signature: closurePlan.logicalSignature).isOk() { panic "wrong callable identity accepted" }
    if scope.validateCallableInputs(scope: callableInputs, callableIdentity: 17U64, signature: zeroClosurePlan.logicalSignature).isOk() { panic "wrong callable signature accepted" }
    if otherScope.validateCallableInputs(scope: callableInputs, callableIdentity: 17U64, signature: closurePlan.logicalSignature).isOk() { panic "wrong callable module accepted" }
    if foreignScope.validateCallableInputs(scope: callableInputs, callableIdentity: 17U64, signature: closurePlan.logicalSignature).isOk() { panic "wrong callable context accepted" }
    val foreignContextInputs = <LlvmCallableInputScope moduleIdentity=callableInputs.moduleIdentity contextIdentity=foreignScope.contextIdentity revision=1U64 callableIdentity=callableInputs.callableIdentity signature=callableInputs.signature />
    if scope.validateCallableInputs(scope: foreignContextInputs, callableIdentity: 17U64, signature: closurePlan.logicalSignature).isOk() { panic "foreign callable context identity accepted" }
    val staleCallableInputs = <LlvmCallableInputScope moduleIdentity=callableInputs.moduleIdentity contextIdentity=callableInputs.contextIdentity revision=2U64 callableIdentity=callableInputs.callableIdentity signature=callableInputs.signature />
    if scope.validateCallableInputs(scope: staleCallableInputs, callableIdentity: 17U64, signature: closurePlan.logicalSignature).isOk() { panic "wrong callable revision accepted" }
    // Typed call/binding inputs: actual live native values, not metadata only.
    val function = plew_test_signature_function(module, aggregate)
    val otherFunction = plew_test_signature_function(module, aggregate)
    val foreignFunction = plew_test_signature_function(foreignModule, plew_test_signature_type(foreignContext, 3U32))
    val otherModuleFunction = plew_test_signature_function(otherModule, aggregate)
    scope.validateFunction(function: function, signature: plan.functionType).unwrap()
    if scope.validateFunction(function: function, signature: pointerPlan.functionType).isOk() { panic "wrong native entry signature accepted" }
    if scope.validateFunction(function: otherModuleFunction, signature: plan.functionType).isOk() { panic "foreign native entry module accepted" }
    if scope.validateFunction(function: foreignFunction, signature: plan.functionType).isOk() { panic "foreign native entry context accepted" }
    val inputs = <LlvmInputScope moduleIdentity=plan.moduleIdentity contextIdentity=plan.contextIdentity revision=1U64 bodyIdentity=7U64 signature=plan.logicalSignature />
    scope.validateInputs(scope: inputs, bodyIdentity: 7U64, signature: plan.logicalSignature).unwrap()
    if scope.validateInputs(scope: inputs, bodyIdentity: 8U64, signature: plan.logicalSignature).isOk() { panic "wrong input body accepted" }
    if scope.validateInputs(scope: inputs, bodyIdentity: 7U64, signature: pointerPlan.logicalSignature).isOk() { panic "wrong input signature accepted" }
    if otherScope.validateInputs(scope: inputs, bodyIdentity: 7U64, signature: plan.logicalSignature).isOk() { panic "wrong input module accepted" }
    if foreignScope.validateInputs(scope: inputs, bodyIdentity: 7U64, signature: plan.logicalSignature).isOk() { panic "wrong input context accepted" }
    val staleInputs = <LlvmInputScope moduleIdentity=inputs.moduleIdentity contextIdentity=inputs.contextIdentity revision=2U64 bodyIdentity=inputs.bodyIdentity signature=inputs.signature />
    if scope.validateInputs(scope: staleInputs, bodyIdentity: 7U64, signature: plan.logicalSignature).isOk() { panic "wrong input revision accepted" }
    val home = plew_test_signature_value(function, aggregate, 0U32)
    val scalarValue = plew_test_signature_value(function, scalar, 1U32)
    val pointerValue = plew_test_signature_value(function, pointer, 2U32)
    val aggregateValue = plew_test_signature_value(function, aggregate, 3U32)
    val alloca = plew_test_signature_value(function, aggregate, 4U32)
    // An indirect callable is a live value in the caller, not a native function declaration.
    scope.validateValue(value: aggregateValue, type: aggregate, function: function).unwrap()
    scope.validateValue(value: pointerValue, type: pointer, function: function).unwrap()
    if scope.validateValue(value: aggregateValue, type: scalar, function: function).isOk() { panic "callable value represented type mismatch accepted" }
    if scope.validateValue(value: aggregateValue, type: foreignScalar, function: function).isOk() { panic "callable value foreign expected type accepted" }
    if scope.validateValue(value: aggregateValue, type: aggregate, function: scalarValue).isOk() { panic "callable value nonfunction scope accepted" }
    if scope.validateValue(value: pointerValue, type: pointer, function: otherFunction).isOk() { panic "callable value foreign function accepted" }
    if scope.validateValue(value: aggregateValue, type: aggregate, function: otherModuleFunction).isOk() { panic "callable value foreign module accepted" }
    val foreignAggregate = plew_test_signature_type(foreignContext, 3U32)
    if scope.validateValue(value: plew_test_signature_value(foreignFunction, foreignAggregate, 3U32), type: aggregate, function: function).isOk() { panic "callable value foreign context accepted" }
    val receiverInput = <LlvmValueInput lane=receiver index=0U64 carrier=<LlvmValueCarrier.Home address=home /> />
    scope.validateInput(parameter: plan.parameters[0], input: receiverInput, index: 0U64, function: function).unwrap()
    scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=receiver index=0U64 carrier=<LlvmValueCarrier.Home address=alloca /> />, index: 0U64, function: function).unwrap()
    scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=receiver index=0U64 carrier=<LlvmValueCarrier.Value value=aggregateValue /> />, index: 0U64, function: function).unwrap()
    scope.validateInput(parameter: plan.parameters[1], input: <LlvmValueInput lane=omitted index=1U64 carrier=<LlvmValueCarrier.Value value=plew_test_signature_value(function, empty, 3U32) /> />, index: 1U64, function: function).unwrap()
    scope.validateInput(parameter: plan.parameters[2], input: <LlvmValueInput lane=direct index=2U64 carrier=<LlvmValueCarrier.Value value=scalarValue /> />, index: 2U64, function: function).unwrap()
    scope.validateInput(parameter: plan.parameters[3], input: <LlvmValueInput lane=inoutLane index=3U64 carrier=<LlvmValueCarrier.Value value=pointerValue /> />, index: 3U64, function: function).unwrap()
    if scope.validateInput(parameter: plan.parameters[0], input: receiverInput, index: 1U64, function: function).isOk() { panic "wrong input index accepted" }
    if scope.validateInput(parameter: plainPlan.parameters[0], input: receiverInput, index: 0U64, function: function).isOk() { panic "wrong input role accepted" }
    if scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=parameter(type: aggregate, semantic: 99U64, role: receiver.role, mode: receiver.mode) index=0U64 carrier=receiverInput.carrier />, index: 0U64, function: function).isOk() { panic "wrong input semantic type accepted" }
    if scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=parameter(type: aggregate, semantic: 11U64, role: receiver.role, mode: <LlvmParameterMode.Move />) index=0U64 carrier=receiverInput.carrier />, index: 0U64, function: function).isOk() { panic "wrong input mode accepted" }
    if scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=receiver index=0U64 carrier=<LlvmValueCarrier.Value value=scalarValue /> />, index: 0U64, function: function).isOk() { panic "actual native type mismatch accepted" }
    if scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=receiver index=0U64 carrier=<LlvmValueCarrier.Home address=pointerValue /> />, index: 0U64, function: function).isOk() { panic "unqualified opaque pointer home accepted" }
    if scope.validateInput(parameter: plan.parameters[3], input: <LlvmValueInput lane=inoutLane index=3U64 carrier=<LlvmValueCarrier.Home address=home /> />, index: 3U64, function: function).isOk() { panic "inout confused with a home" }
    if scope.validateInput(parameter: plan.parameters[0], input: receiverInput, index: 0U64, function: otherFunction).isOk() { panic "foreign function input accepted" }
    if scope.validateInput(parameter: plan.parameters[0], input: receiverInput, index: 0U64, function: otherModuleFunction).isOk() { panic "foreign module input accepted" }
    if scope.validateInput(parameter: plan.parameters[0], input: <LlvmValueInput lane=receiver index=0U64 carrier=<LlvmValueCarrier.Value value=plew_test_signature_value(foreignFunction, plew_test_signature_type(foreignContext, 3U32), 3U32) /> />, index: 0U64, function: function).isOk() { panic "actual foreign context accepted" }
    mut val constantKind = 0U32
    while constantKind < 3U32 {
        val sameModuleValue = plew_test_signature_constant(module, constantKind)
        val foreignModuleValue = plew_test_signature_constant(otherModule, constantKind)
        scope.validateValue(value: sameModuleValue, type: LLVMTypeOf(sameModuleValue), function: function).unwrap()
        if scope.validateValue(value: foreignModuleValue, type: LLVMTypeOf(sameModuleValue), function: function).isOk() { panic "callable value foreign module constant accepted" }
        val constantLane = parameter(type: LLVMTypeOf(sameModuleValue), semantic: 30U64, role: <LlvmParameterRole.Ordinary index=0U64 />, mode: <LlvmParameterMode.Borrow />)
        val constantPlan = scope.plan(signature: body(parameters: [constantLane], result: voidType)).unwrap()
        scope.validateInput(parameter: constantPlan.parameters[0], input: <LlvmValueInput lane=constantLane index=0U64 carrier=<LlvmValueCarrier.Value value=sameModuleValue /> />, index: 0U64, function: function).unwrap()
        if scope.validateInput(parameter: constantPlan.parameters[0], input: <LlvmValueInput lane=constantLane index=0U64 carrier=<LlvmValueCarrier.Value value=foreignModuleValue /> />, index: 0U64, function: function).isOk() { panic "foreign module constant reference accepted" }
        constantKind += 1U32
    }
    plew_test_signature_change_layout(module)
    val readmitted = LlvmSignatureScope.admitted(module: module).unwrap()
    if readmitted.validate(signature: plainSignature, plan: plainPlan).isOk() { panic "readmitted stale target plan accepted" }
    if scope.plan(signature: signature).isOk() { panic "stale target scope accepted" }
    if scope.validateCallableInputs(scope: callableInputs, callableIdentity: 17U64, signature: closurePlan.logicalSignature).isOk() { panic "stale target callable scope accepted" }
    LLVMDisposeModule(module)
    LLVMDisposeModule(otherModule)
    LLVMDisposeModule(foreignModule)
    LLVMContextDispose(context)
    LLVMContextDispose(foreignContext)
    write(s: "ok\n")
}
