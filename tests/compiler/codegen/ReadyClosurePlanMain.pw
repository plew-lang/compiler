// Appended to an exact Backend.pw snapshot; exercises private production APIs.
// Capture semantics: docs/design/mid-entry-audit.md, Closures and Synthetic Ownership Bodies.
use ./Frontend only { analyzeFrontendDeclarations, FrontendInput }
use ./SourceAccess only { SourceAccess }
use ./Ir only { ClosureSignature, SemanticClosureCapture }
extern(c) {
    fn LLVMGetAllocatedType(value~: LLVMValueRef) -> LLVMTypeRef
    fn LLVMGetNextInstruction(value~: U64) -> U64
    fn LLVMIsAStoreInst(value~: U64) -> U64
    fn LLVMGetOperand(value~: U64, index~: U32) -> LLVMValueRef
    fn LLVMIsAAllocaInst(value~: LLVMValueRef) -> U64
    fn LLVMIsAExtractValueInst(value~: LLVMValueRef) -> U64
    fn LLVMIsAInsertValueInst(value~: LLVMValueRef) -> U64
    fn LLVMGetCalledValue(value~: LLVMValueRef) -> LLVMValueRef
    fn LLVMGetArgOperand(value~: LLVMValueRef, index~: U32) -> LLVMValueRef
}
fn requireClosureOk[T](result: Result[T, CompileDiagnostic], stage: String, mode: U64) -> T {
    match result {
        Result.Ok(value: val value) => { return value }
        Result.Err(error: val error) => {
            eprint(text: "closure-plan mode=")
            eprintU64(n: mode)
            eprint(text: " stage=")
            eprint(text: stage)
            eprint(text: ": ")
            eprint(text: error.message)
            eprint(text: "\n")
            panic "private closure setup or valid-path API failed"
        }
    }
}
fn requireClosureInternal[T](result: Result[T, CompileDiagnostic]) {
    match result {
        Result.Ok(value: _) => { panic "malformed closure local plan accepted" }
        Result.Err(error: val error) => { match error.failureDomain { FailureDomain.Internal => {} _ => { panic "wrong closure local plan failure domain" } } }
    }
}
// Each rejection starts from an otherwise valid live LLVM entry. No malformed
// LLVM is emitted, and fixture/setup failure cannot satisfy a rejection.
fn closurePlanControl(mode: U64) {
    val context = LLVMContextCreate()
    val name = <CString.copied text="ready-closure-controls" />
    val module = LLVMModuleCreateWithNameInContext(name.ptr, context)
    val triple = LLVMGetDefaultTargetTriple()
    val cpu = <CString.copied text="generic" />
    val layout = plew_llvm_native_data_layout(cpu.ptr)
    LLVMSetTarget(module, triple)
    LLVMSetDataLayout(module, layout)
    LLVMDisposeMessage(triple)
    LLVMDisposeMessage(layout)
    val builder = LLVMCreateBuilderInContext(context)
    mut val backend = llvmContext(ctx: context, m: module, builder: builder)
    mut val compiler = <Comp />
    requireClosureOk(result: analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text="fn control() {{}}" path="ready-closure.pw" />, sources: <SourceAccess stdRoot=[] />), stage: "frontend declarations", mode: mode)
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.simpleTypeRef(nameStart: integerName.nameStart, nameLen: integerName.nameLen)
    val unsignedName = compiler.internBytes(s: "U64")
    val unsigned = compiler.simpleTypeRef(nameStart: unsignedName.nameStart, nameLen: unsignedName.nameLen)
    // llvmTypeOfRef requires the frontend's finalized representation contract,
    // including builtin scalars. Declarations-only setup has not published it.
    requireClosureOk(result: compiler.enqueueFinalDestruction(typeRef: integer), stage: "finalize I64 representation", mode: mode)
    requireClosureOk(result: compiler.enqueueFinalDestruction(typeRef: unsigned), stage: "finalize U64 representation", mode: mode)
    val unit = compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true recordFieldLabels=[] recordFieldTerms=[] />)
    val functionName = compiler.internBytes(s: "fn")
    val functionType = compiler.pushType(t: <TypeRef nameStart=functionName.nameStart nameLen=functionName.nameLen args=[unit, integer] />)
    val valueBinding = compiler.internBytes(s: "savedValue").nameStart
    val cellBinding = compiler.internBytes(s: "savedCell").nameStart
    val closureKey = 9223372036854775808U64
    val closureId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=closureKey environment=<InstanceEnvironment /> />)
    val dropId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=closureKey + 1U64 environment=<InstanceEnvironment /> />, origin: <BodyOrigin.ClosureEnvironmentDrop closureBodyId=closureId />)
    compiler.arena.setClosureSignature(bodyId: closureId, parameters: [integer], passings: [<CallArgumentPassing.Borrow />], result: 0U64, closure: <ClosureSignature functionTypeTerm=functionType environmentDropBodyId=dropId captures=[<SemanticClosureCapture bindingTarget=valueBinding typeTerm=integer mode=<SemanticClosureCaptureMode.ValueCopy /> />, <SemanticClosureCapture bindingTarget=cellBinding typeTerm=integer mode=<SemanticClosureCaptureMode.CellBorrow /> />] />)
    compiler.arena.setBodySignature(bodyId: dropId, parameters: [integer, integer], passings: [<CallArgumentPassing.Move />, <CallArgumentPassing.Move />], result: 0U64)
    val drop = mode == 7U64 || mode == 8U64
    val closureTemplate = requireClosureOk(result: backend.closureValueAbi(c: inout compiler, functionType: functionType), stage: "closure template", mode: mode)
    val closureAbi = requireClosureOk(result: backend.closureBodyValueAbi(c: inout compiler, bodyId: closureId, template: closureTemplate), stage: "closure body descriptor", mode: mode)
    val closureFunction = requireClosureOk(result: backend.declarePlannedBodyFunction(name: name.ptr, abiId: closureAbi, bodyId: closureId), stage: "declare closure", mode: mode)
    backend.closures.append(<LlvmClosure bodyId=closureId semanticIndex=0U64 functionTypeTerm=functionType function=closureFunction captures=[<CaptureEntry closureId=0U64 nameStart=valueBinding nameLen=0U64 tyStart=integerName.nameStart tyLen=integerName.nameLen isArray=false ty=integer boxed=false />, <CaptureEntry closureId=0U64 nameStart=cellBinding nameLen=0U64 tyStart=integerName.nameStart tyLen=integerName.nameLen isArray=false ty=integer boxed=true />] />)
    val dropName = <CString.copied text="ready-drop-controls" />
    val dropParameters: Array[LLVMTypeRef] = [backend.ptrty]
    val dropSignature = LLVMFunctionType(backend.voidty, arrayCPtr(dropParameters), 1U64, 0I32)
    val dropFunction = requireClosureOk(result: backend.declareLegacyBodyFunction(name: dropName.ptr, signature: dropSignature, bodyId: dropId, family: <LlvmLegacyConvention.EnvironmentDrop />), stage: "declare environment drop", mode: mode)
    mut val locals: Array[MidLocalDecl] = []
    if !drop {
        locals.append(<MidLocalDecl typeTerm=if mode == 4U64 { give unsigned } else { give integer } sourceScope=0U64 isUnique=false isParameter=true isInout=mode == 5U64 isCaptureCell=mode == 9U64 isBorrowed=mode == 10U64 />)
        locals.append(<MidLocalDecl typeTerm=integer sourceScope=0U64 isUnique=false isParameter=false isBorrowed=true ownsAtEntry=mode == 3U64 sourceNameStart=if mode == 1U64 { give cellBinding } else { give valueBinding } />)
        locals.append(<MidLocalDecl typeTerm=integer sourceScope=0U64 isUnique=false isParameter=false isInout=true isCaptureCell=mode != 2U64 sourceNameStart=cellBinding />)
        if mode == 11U64 { locals.append(<MidLocalDecl typeTerm=integer sourceScope=0U64 isUnique=false isParameter=true />) }
    } else {
        locals.append(<MidLocalDecl typeTerm=integer sourceScope=0U64 isUnique=false isParameter=true ownsAtEntry=mode != 8U64 />)
        locals.append(<MidLocalDecl typeTerm=integer sourceScope=0U64 isUnique=false isParameter=true isCaptureCell=true ownsAtEntry=true />)
    }
    val bodyId = if drop { give dropId } else { give closureId }
    val canonical = compiler.mid.store(body: <MidBody bodyInstance=bodyId sourceFunction=if drop { give closureKey + 1U64 } else { give closureKey } locals=locals blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    if !compiler.mid.isWellFormed(body: canonical) { panic "malformed closure plan test setup" }
    backend.curFn = if drop { give dropFunction } else { give closureFunction }
    backend.curRetVoid = true
    val count = if drop { give 2U64 } else if mode == 6U64 { give 0U64 } else { give 1U64 }
    val admissionResult = backend.prepareBodyLocalPlan(c: inout compiler, canonical: canonical, parameterCount: count)
    if mode != 0U64 && mode != 7U64 {
        requireClosureInternal(result: admissionResult)
    } else {
        val admission = requireClosureOk(result: admissionResult, stage: "valid Ready admission", mode: mode)
        val planId = match admission { LlvmBodyLocalAdmission.Planned(planId: val planId) => { give planId } _ => { panic "closure escaped retained admission" } }
        val plan = backend.bodyLocalPlans[planId - 1U64]
        match plan.entry {
            LlvmBodyLocalEntry.Closure(abiId: _) => { if drop { panic "drop given ordinary closure plan" } }
            LlvmBodyLocalEntry.EnvironmentDrop(abiId: _) => { if !drop { panic "closure given drop plan" } }
            _ => { panic "wrong retained entry" }
        }
        if plan.environmentType.isNone() { panic "environment layout not retained" }
        val captureBase = if drop { give 0U64 } else { give 1U64 }
        mut val index = 0U64
        while index < 2U64 {
            val local = backend.preparedLocals[plan.localStart + captureBase + index]
            match local.binding {
                LlvmLocalBinding.Environment(field: val field, type: val type) => {
                    if field != index + 1U64 || plew_pointer_equal(type, if index == 0U64 { give backend.i64ty } else { give backend.ptrty }) == 0I32 { panic "wrong saved field-to-local mapping" }
                }
                _ => { panic "capture lacks saved environment binding" }
            }
            index += 1U64
        }
        if !drop {
            match backend.preparedLocals[plan.localStart].binding {
                LlvmLocalBinding.Parameter(parameterIndex: val parameterIndex, alias: val alias) => {
                    val abiId = backend.valueAbiFunctions.getOr(key: LLVMIsAFunction(closureFunction), fallback: 0U64)
                    if alias || parameterIndex != backend.valueAbis[abiId - 1U64].parameterStart + 1U64 { panic "ordinary input lost leading environment lane" }
                }
                _ => { panic "ordinary parameter lacks saved lane" }
            }
        }
        val ready = <MidLlvmPrepared.Ready canonical=canonical localAdmission=admission />
        backend.beginFnBody(fv: backend.curFn)
        if !requireClosureOk(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: ready), stage: "valid Ready emission", mode: mode) { panic "valid retained closure failed emission" }
        if backend.nLocals != locals.count() { panic "local count changed" }
        if plew_pointer_equal(LLVMGetAllocatedType(backend.locPtr[captureBase]), backend.i64ty) == 0I32 { panic "value capture allocation lost retained type" }
        if plew_pointer_equal(LLVMGetAllocatedType(backend.locPtr[captureBase + 1U64]), backend.ptrty) == 0I32 { panic "cell capture is not a pointer holder" }
        // Check real emitted stores, not only metadata and allocation. Each
        // capture must be loaded from its saved environment field and stored
        // exactly once into the corresponding distinct local holder.
        index = 0U64
        while index < 2U64 {
            if LLVMIsAAllocaInst(backend.locPtr[captureBase + index]) == 0U64 { panic "capture holder is not an alloca" }
            mut val stores = 0U64
            mut val instruction = LLVMGetFirstInstruction(LLVMGetInsertBlock(backend.b))
            while instruction != 0U64 {
                if LLVMIsAStoreInst(instruction) != 0U64 && LLVMIsAAllocaInst(LLVMGetOperand(instruction, 1U32)) == LLVMIsAAllocaInst(backend.locPtr[captureBase + index]) { stores += 1U64 }
                instruction = LLVMGetNextInstruction(instruction)
            }
            if stores != 1U64 { panic "saved capture binding did not reach actual local store" }
            index += 1U64
        }
        val body = compiler.mid.bodies[canonical.body - 1U64]
        if plew_pointer_equal(requireClosureOk(result: backend.midCanonicalLocalTy(body: body, local: captureBase + 1U64), stage: "later local type read", mode: mode), backend.i64ty) == 0I32 { panic "cell logical type lost after binding" }
        backend.curFn = if drop { give closureFunction } else { give dropFunction }
        requireClosureInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: ready))
    }
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module)
    LLVMContextDispose(context)
}
// Live private call controls complement Ready's existing field/local tests.
// Metadata corruptions start from valid carriers; rejected inputs never reach
// LLVMBuildCall2. These are physical contracts, not source ownership proofs.
fn closureCallControl() {
    val context = LLVMContextCreate()
    val name = <CString.copied text="completed-closure-call-controls" />
    val module = LLVMModuleCreateWithNameInContext(name.ptr, context)
    val triple = LLVMGetDefaultTargetTriple()
    val cpu = <CString.copied text="generic" />
    val layout = plew_llvm_native_data_layout(cpu.ptr)
    LLVMSetTarget(module, triple)
    LLVMSetDataLayout(module, layout)
    LLVMDisposeMessage(triple)
    LLVMDisposeMessage(layout)
    val builder = LLVMCreateBuilderInContext(context)
    mut val backend = llvmContext(ctx: context, m: module, builder: builder)
    mut val compiler = <Comp />
    requireClosureOk(result: analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text="fn control() {{}}" path="closure-call.pw" />, sources: <SourceAccess stdRoot=[] />), stage: "call frontend", mode: 0U64)
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.simpleTypeRef(nameStart: integerName.nameStart, nameLen: integerName.nameLen)
    val unsignedName = compiler.internBytes(s: "U64")
    val unsigned = compiler.simpleTypeRef(nameStart: unsignedName.nameStart, nameLen: unsignedName.nameLen)
    val fieldName = compiler.internBytes(s: "payload")
    val aggregate = compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true recordFieldLabels=[fieldName.nameId] recordFieldTerms=[integer] />)
    requireClosureOk(result: compiler.enqueueFinalDestruction(typeRef: integer), stage: "call I64 representation", mode: 0U64)
    requireClosureOk(result: compiler.enqueueFinalDestruction(typeRef: unsigned), stage: "call U64 representation", mode: 0U64)
    // A semantic record alone is not a registered physical layout. Use the
    // production collection boundary before ownership/representation finalization.
    requireClosureOk(result: compiler.collectRecordedType(ref: aggregate), stage: "collect call record layout", mode: 0U64)
    requireClosureOk(result: compiler.enqueueFinalDestruction(typeRef: aggregate), stage: "call aggregate representation", mode: 0U64)
    requireClosureOk(result: backend.registerFinalLayoutNames(c: inout compiler), stage: "call layout names", mode: 0U64)
    requireClosureOk(result: backend.registerFinalStructBodies(c: inout compiler), stage: "call layout bodies", mode: 0U64)
    val unit = compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true recordFieldLabels=[] recordFieldTerms=[] />)
    val functionName = compiler.internBytes(s: "fn")
    val functionType = compiler.pushType(t: <TypeRef nameStart=functionName.nameStart nameLen=functionName.nameLen args=[unit, integer, aggregate] />)
    val otherFunctionType = compiler.pushType(t: <TypeRef nameStart=functionName.nameStart nameLen=functionName.nameLen args=[unit, unsigned, aggregate] />)
    val template = requireClosureOk(result: backend.closureValueAbi(c: inout compiler, functionType: functionType), stage: "call template", mode: 0U64)
    val plan = backend.valueAbis[template - 1U64]
    val laneCount = backend.valueAbiParameters.count()
    val descriptorCount = backend.valueAbis.count()
    mut val repeat = 0U64
    while repeat < 4U64 {
        if requireClosureOk(result: backend.closureValueAbi(c: inout compiler, functionType: functionType), stage: "cached template", mode: repeat) != template { panic "closure cache changed template" }
        repeat += 1U64
    }
    if backend.valueAbiParameters.count() != laneCount || backend.valueAbis.count() != descriptorCount { panic "cached closure reclassified signature" }
    val otherTemplate = requireClosureOk(result: backend.closureValueAbi(c: inout compiler, functionType: otherFunctionType), stage: "same-native distinct-semantic template", mode: 0U64)
    if otherTemplate == template || plew_pointer_equal(plan.logicalSignature, backend.valueAbis[otherTemplate - 1U64].logicalSignature) == 0I32 { panic "I64/U64 fixture does not isolate semantic identity" }
    val bodyId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=9223372036854775900U64 environment=<InstanceEnvironment /> />)
    val otherBodyId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=9223372036854775901U64 environment=<InstanceEnvironment /> />)
    compiler.arena.setClosureSignature(bodyId: bodyId, parameters: [integer, aggregate], passings: [<CallArgumentPassing.Borrow />, <CallArgumentPassing.Borrow />], result: 0U64, closure: <ClosureSignature functionTypeTerm=functionType captures=[] />)
    compiler.arena.setClosureSignature(bodyId: otherBodyId, parameters: [integer, aggregate], passings: [<CallArgumentPassing.Borrow />, <CallArgumentPassing.Borrow />], result: 0U64, closure: <ClosureSignature functionTypeTerm=functionType captures=[] />)
    val bodyAbi = requireClosureOk(result: backend.closureBodyValueAbi(c: inout compiler, bodyId: bodyId, template: template), stage: "call body clone", mode: 0U64)
    val otherBodyAbi = requireClosureOk(result: backend.closureBodyValueAbi(c: inout compiler, bodyId: otherBodyId, template: template), stage: "second body clone", mode: 0U64)
    if bodyAbi == otherBodyAbi || backend.valueAbis[bodyAbi - 1U64].ownerBody != bodyId || backend.valueAbis[otherBodyAbi - 1U64].ownerBody != otherBodyId || backend.valueAbis[bodyAbi - 1U64].parameterStart != plan.parameterStart || backend.valueAbis[otherBodyAbi - 1U64].parameterStart != plan.parameterStart || backend.valueAbiParameters.count() != laneCount + 3U64 { panic "closure body clone copied lanes or lost body identity" }
    val beforeRejectedDeclarations = backend.valueAbis.count()
    requireClosureInternal(result: backend.closureBodyValueAbi(c: inout compiler, bodyId: 0U64, template: template))
    requireClosureInternal(result: backend.closureBodyValueAbi(c: inout compiler, bodyId: bodyId, template: bodyAbi))
    mut val declarationMode = 0U64
    while declarationMode < 4U64 {
        val malformedBody = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=9223372036854775950U64 + declarationMode environment=<InstanceEnvironment /> />)
        val terms = if declarationMode == 2U64 { give [integer] } else { give [if declarationMode == 0U64 { give unsigned } else { give integer }, aggregate] }
        val passings: Array[CallArgumentPassing] = if declarationMode == 2U64 { give [<CallArgumentPassing.Borrow />] } else { give [if declarationMode == 1U64 { give <CallArgumentPassing.Inout /> } else { give <CallArgumentPassing.Borrow /> }, <CallArgumentPassing.Borrow />] }
        compiler.arena.setClosureSignature(bodyId: malformedBody, parameters: terms, passings: passings, result: if declarationMode == 3U64 { give integer } else { give 0U64 }, closure: <ClosureSignature functionTypeTerm=functionType captures=[] />)
        requireClosureInternal(result: backend.closureBodyValueAbi(c: inout compiler, bodyId: malformedBody, template: template))
        declarationMode += 1U64
    }
    if backend.valueAbis.count() != beforeRejectedDeclarations { panic "rejected declaration appended a descriptor" }
    val target = requireClosureOk(result: backend.declarePlannedBodyFunction(name: name.ptr, abiId: bodyAbi, bodyId: bodyId), stage: "call declaration", mode: 0U64)
    val callerName = <CString.copied text="closure-caller" />
    val callerParameters: Array[LLVMTypeRef] = []
    val callerType = LLVMFunctionType(backend.voidty, arrayCPtr(callerParameters), 0U64, 0I32)
    val caller = LLVMAddFunction(module, callerName.ptr, callerType)
    backend.curFn = caller
    backend.beginFnBody(fv: caller)
    val environment = LLVMBuildAlloca(builder, backend.i64ty, anon())
    mut val closure = LLVMBuildInsertValue(builder, LLVMGetUndef(backend.closureTy), target, 0U64, anon())
    closure = LLVMBuildInsertValue(builder, closure, environment, 1U64, anon())
    val callee = requireClosureOk(result: backend.closureCallee(c: inout compiler, functionType: functionType, closure: closure), stage: "typed fat callee", mode: 0U64)
    val scalarLane = backend.valueAbiParameters[plan.parameterStart + 1U64]
    val aggregateLane = backend.valueAbiParameters[plan.parameterStart + 2U64]
    val scalarValue = LLVMConstInt(backend.i64ty, 7U64, 0I32)
    val scalarInput = <LlvmValueInput lane=<LlvmLogicalParameter type=scalarLane.type semanticType=integer role=<LlvmParameterRole.Ordinary index=0U64 /> mode=<LlvmParameterMode.Borrow /> /> index=1U64 carrier=<LlvmValueCarrier.Value value=scalarValue /> />
    val aggregateValue = LLVMGetUndef(aggregateLane.type)
    val aggregateHome = LLVMBuildAlloca(builder, aggregateLane.type, anon())
    llvmStore(builder, aggregateValue, aggregateHome)
    val aggregateInput = <LlvmValueInput lane=<LlvmLogicalParameter type=aggregateLane.type semanticType=aggregate role=<LlvmParameterRole.Ordinary index=1U64 /> mode=<LlvmParameterMode.Borrow /> /> index=2U64 carrier=<LlvmValueCarrier.Value value=aggregateValue /> />
    val homeInput = <LlvmValueInput lane=aggregateInput.lane index=2U64 carrier=<LlvmValueCarrier.Home address=aggregateHome /> />
    val beforeCalls = backend.valueAbis.count()
    val beforeLanes = backend.valueAbiParameters.count()
    repeat = 0U64
    while repeat < 4U64 {
        val call = requireClosureOk(result: backend.callClosureValueFunction(callee: callee, arguments: [scalarInput, if repeat == 0U64 { give aggregateInput } else { give homeInput }]), stage: "Value/Home closure call", mode: repeat)
        // Both extractvalue instructions must read the exact original fat value.
        val called = LLVMGetCalledValue(call)
        val passedEnvironment = LLVMGetArgOperand(call, 0U32)
        if LLVMIsAExtractValueInst(called) == 0U64 || LLVMIsAExtractValueInst(passedEnvironment) == 0U64 || LLVMIsAExtractValueInst(called) == LLVMIsAExtractValueInst(passedEnvironment) { panic "fat callee/environment extraction missing" }
        if LLVMIsAInsertValueInst(LLVMGetOperand(LLVMIsAExtractValueInst(called), 0U32)) != LLVMIsAInsertValueInst(closure) || LLVMIsAInsertValueInst(LLVMGetOperand(LLVMIsAExtractValueInst(passedEnvironment), 0U32)) != LLVMIsAInsertValueInst(closure) { panic "fat extraction read different closure values" }
        repeat += 1U64
    }
    if backend.valueAbis.count() != beforeCalls || backend.valueAbiParameters.count() != beforeLanes { panic "closure calls append ABI plans" }
    mut val mode = 0U64
    while mode < 5U64 {
        val input = <LlvmValueInput lane=<LlvmLogicalParameter type=scalarLane.type semanticType=if mode == 0U64 { give unsigned } else { give integer } role=if mode == 2U64 { give <LlvmParameterRole.Environment /> } else if mode == 4U64 { give <LlvmParameterRole.Ordinary index=1U64 /> } else { give <LlvmParameterRole.Ordinary index=0U64 /> } mode=if mode == 3U64 { give <LlvmParameterMode.Move /> } else { give <LlvmParameterMode.Borrow /> } /> index=if mode == 1U64 { give 0U64 } else { give 1U64 } carrier=scalarInput.carrier />
        requireClosureInternal(result: backend.callClosureValueFunction(callee: callee, arguments: [input, homeInput]))
        mode += 1U64
    }
    mode = 0U64
    while mode < 6U64 {
        val inputScope = <LlvmCallableInputScope moduleIdentity=callee.inputs.moduleIdentity + if mode == 2U64 { give 1U64 } else { give 0U64 } contextIdentity=callee.inputs.contextIdentity + if mode == 3U64 { give 1U64 } else { give 0U64 } revision=if mode == 4U64 { give 2U64 } else { give 1U64 } callableIdentity=if mode == 0U64 { give otherFunctionType } else { give functionType } signature=if mode == 1U64 { give callerType } else { give callee.inputs.signature } />
        val malformed = <LlvmClosureCallee template=if mode == 5U64 { give bodyAbi } else { give template } inputs=inputScope closure=closure />
        requireClosureInternal(result: backend.callClosureValueFunction(callee: malformed, arguments: [scalarInput, homeInput]))
        mode += 1U64
    }
    requireClosureInternal(result: backend.callClosureValueFunction(callee: <LlvmClosureCallee template=template inputs=callee.inputs closure=scalarValue />, arguments: [scalarInput, homeInput]))
    requireClosureInternal(result: backend.callClosureValueFunction(callee: callee, arguments: [scalarInput]))
    val otherCallerName = <CString.copied text="other-closure-caller" />
    val otherCaller = LLVMAddFunction(module, otherCallerName.ptr, callerType)
    backend.curFn = otherCaller
    backend.beginFnBody(fv: otherCaller)
    val foreignHome = LLVMBuildAlloca(builder, backend.i64ty, anon())
    val foreignValue = llvmLoad(builder, backend.i64ty, foreignHome, anon())
    val foreignInput = <LlvmValueInput lane=scalarInput.lane index=1U64 carrier=<LlvmValueCarrier.Value value=foreignValue /> />
    // Re-enter the original caller without relying on backend.curFn for admission.
    LLVMPositionBuilderAtEnd(builder, LLVMGetEntryBasicBlock(caller))
    requireClosureInternal(result: backend.callClosureValueFunction(callee: callee, arguments: [foreignInput, homeInput]))
    LLVMPositionBuilderAtEnd(builder, LLVMGetEntryBasicBlock(otherCaller))
    requireClosureInternal(result: backend.callClosureValueFunction(callee: callee, arguments: [scalarInput, aggregateInput]))
    LLVMPositionBuilderAtEnd(builder, LLVMGetEntryBasicBlock(caller))
    val rawIndirect = LLVMBuildExtractValue(builder, closure, 0U64, anon())
    requireClosureInternal(result: backend.callLegacyValueFunction(signature: plan.logicalSignature, function: rawIndirect, arguments: [environment, scalarValue, aggregateValue], legacyIndirect: <Optional.Some v=<LlvmLegacyConvention.Closure /> />))
    backend.curFn = target
    requireClosureInternal(result: backend.preparedLegacyParameter(parameterIndex: plan.parameterStart))
    requireClosureInternal(result: backend.preparedLegacyParameter(parameterIndex: plan.parameterStart + 1U64))
    requireClosureInternal(result: backend.legacyValueParameter(function: target, index: 0U64))
    requireClosureInternal(result: backend.legacyValueParameter(function: target, index: 1U64))
    requireClosureInternal(result: backend.callLegacyValueFunction(signature: plan.logicalSignature, function: target, arguments: [environment, scalarValue, aggregateValue]))
    requireClosureInternal(result: backend.closureBodyParameter(function: target, bodyId: otherBodyId, index: 0U64))
    requireClosureInternal(result: backend.closureBodyParameter(function: target, bodyId: bodyId, index: 3U64))
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module)
    LLVMContextDispose(context)
}
fn main() {
    mut val mode = 0U64
    while mode <= 11U64 { closurePlanControl(mode: mode) mode += 1U64 }
    closureCallControl()
    write(s: "ok\n")
}
