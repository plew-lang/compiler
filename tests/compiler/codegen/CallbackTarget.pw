use @Std/Io only { print }
expose fn target(value~: I64) -> I64 { return increment(value) }
expose fn signedTarget(value~: I8) -> I8 { return value + 1I8 }
fn unused() { missing() }
fn main() {}

fn increment(value~: I64) -> I64 { print(value) return value + 1I64 }

expose fn unusedBoundary() -> I64 { missing() return 0I64 }
