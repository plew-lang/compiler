// Appended to an exact Backend.pw source snapshot for private API controls.
// No production declaration is rewritten or exposed for tests.
use ./Frontend only { analyzeFrontendDeclarations, FrontendInput }
use ./SourceAccess only { SourceAccess }
extern(c) { fn LLVMGetAllocatedType(value~: LLVMValueRef) -> LLVMTypeRef }
fn requireInternal[T](result: Result[T, CompileDiagnostic]) {
    match result {
        Result.Ok(value: _) => { panic "malformed private local admission accepted" }
        Result.Err(error: val error) => { match error.failureDomain { FailureDomain.Internal => {} _ => { panic "wrong private local admission failure domain" } } }
    }
}
fn main() {
    val context = LLVMContextCreate()
    val name = <CString.copied text="ready-private-controls" />
    val module = LLVMModuleCreateWithNameInContext(name.ptr, context)
    val otherModule = LLVMModuleCreateWithNameInContext(name.ptr, context)
    val triple = LLVMGetDefaultTargetTriple()
    val cpu = <CString.copied text="generic" />
    val layout = plew_llvm_native_data_layout(cpu.ptr)
    LLVMSetTarget(module, triple)
    LLVMSetDataLayout(module, layout)
    LLVMSetTarget(otherModule, triple)
    LLVMSetDataLayout(otherModule, layout)
    LLVMDisposeMessage(triple)
    LLVMDisposeMessage(layout)
    val builder = LLVMCreateBuilderInContext(context)
    mut val backend = llvmContext(ctx: context, m: module, builder: builder)
    mut val compiler = <Comp />
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text="fn control() {{}} fn main() {{}}" path="ready-private.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val globalOwner = 18446744073709551615U64
    val bodyId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=globalOwner environment=<InstanceEnvironment /> />)
    val canonical = compiler.mid.store(body: <MidBody bodyInstance=bodyId sourceFunction=globalOwner locals=[<MidLocalDecl typeTerm=0U64 sourceScope=0U64 isUnique=false isParameter=false isDropFlag=true />] blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    if !compiler.mid.isWellFormed(body: canonical) { panic "malformed private test setup" }
    val body = compiler.mid.bodies[canonical.body - 1U64]
    val parameters: Array[LLVMTypeRef] = []
    val signature = LLVMFunctionType(backend.voidty, arrayCPtr(parameters), 0U64, 0I32)
    val function = backend.declareProgramValueFunction(c: inout compiler, bodyId: bodyId, main: false).unwrap()
    val globalAbi = backend.programNativeAbi(function: function, bodyId: bodyId, main: false).unwrap()
    if globalAbi == 0U64 || backend.valueAbis[globalAbi - 1U64].parameterCount != 0U64 { panic "initializer descriptor lost" }
    requireInternal(result: backend.programNativeAbi(function: function, bodyId: bodyId, main: true))
    requireInternal(result: backend.programNativeAbi(function: function, bodyId: bodyId + 1U64, main: false))
    requireInternal(result: backend.programValueParameter(function: function, bodyId: bodyId, index: 0U64))
    requireInternal(result: backend.callLegacyValueFunction(signature: signature, function: function, arguments: []))
    val unregistered = LLVMAddFunction(module, name.ptr, signature)
    backend.curFn = unregistered
    requireInternal(result: backend.prepareBodyLocalPlan(c: inout compiler, canonical: canonical, parameterCount: 0U64))
    backend.curFn = function
    val admission = backend.prepareBodyLocalPlan(c: inout compiler, canonical: canonical, parameterCount: 0U64).unwrap()
    val ready = <MidLlvmPrepared.Ready canonical=canonical localAdmission=admission />
    backend.beginFnBody(fv: function)
    if !backend.genLlvmPreparedMidBody(c: inout compiler, prepared: ready).unwrap() { panic "valid private local plan rejected" }
    if backend.nLocals != 1U64 || LLVMGetIntTypeWidth(backend.locTy[0U64]) != 1U32 || plew_pointer_equal(LLVMGetAllocatedType(backend.locPtr[0U64]), backend.locTy[0U64]) == 0I32 { panic "retained local representation did not reach allocation" }
    requireInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: <MidLlvmPrepared.Ready canonical=<MidCanonicalBody body=0U64 /> localAdmission=admission />))
    requireInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: <MidLlvmPrepared.Ready canonical=<MidCanonicalBody body=compiler.mid.bodies.count() + 1U64 /> localAdmission=admission />))
    val controlName = compiler.internBytes(s: "control")
    val control = compiler.arena.firstFunctionNamed(nameId: controlName.nameId)
    if control >= compiler.arena.functionCount() { panic "missing private control declaration" }
    val otherBodyId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=control environment=<InstanceEnvironment /> />)
    compiler.arena.setBodySignature(bodyId: otherBodyId, parameters: [], passings: [], result: 0U64, receiverPassing: <CallReceiverPassing.None />)
    val otherBody = compiler.mid.store(body: <MidBody bodyInstance=otherBodyId sourceFunction=control locals=[<MidLocalDecl typeTerm=0U64 sourceScope=0U64 isUnique=false isParameter=false isDropFlag=true />] blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    requireInternal(result: backend.validateBodyLocalAdmission(canonical: canonical, body: compiler.mid.bodies[otherBody.body - 1U64]))
    val otherCanonical = compiler.mid.store(body: <MidBody bodyInstance=bodyId sourceFunction=globalOwner blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    requireInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: <MidLlvmPrepared.Ready canonical=otherCanonical localAdmission=admission />))
    requireInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: <MidLlvmPrepared.Ready canonical=canonical localAdmission=<LlvmBodyLocalAdmission.Planned planId=backend.bodyLocalPlans.count() + 1U64 /> />))
    val otherFunction = LLVMAddFunction(otherModule, name.ptr, signature)
    backend.curFn = otherFunction
    requireInternal(result: backend.prepareBodyLocalPlan(c: inout compiler, canonical: canonical, parameterCount: 0U64))
    requireInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: ready))
    val wrongParameters = [backend.i32ty, backend.ptrty]
    val wrongFunction = LLVMAddFunction(module, name.ptr, LLVMFunctionType(backend.i32ty, arrayCPtr(wrongParameters), 2U64, 0I32))
    backend.curFn = wrongFunction
    requireInternal(result: backend.prepareBodyLocalPlan(c: inout compiler, canonical: canonical, parameterCount: 0U64))
    requireInternal(result: backend.genLlvmPreparedMidBody(c: inout compiler, prepared: ready))
    backend.curFn = function
    // Exercise the real raw compatibility guards; no malformed LLVM is emitted.
    val abi = backend.saveValueAbi(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=[] result=backend.voidty resultTerm=0U64 />, ownerBody: bodyId)
    val normalAbi = abi.unwrap()
    val normalFunction = backend.declarePlannedBodyFunction(name: name.ptr, abiId: normalAbi, bodyId: bodyId).unwrap()
    requireInternal(result: backend.callLegacyValueFunction(signature: signature, function: normalFunction, arguments: []))
    requireInternal(result: backend.callBodyValueFunction(function: normalFunction, bodyId: bodyId + 1U64, inputs: backend.bodyInputScope(bodyId: bodyId, signature: signature).unwrap(), arguments: []))
    requireInternal(result: backend.legacyValueParameter(function: normalFunction, index: 0U64))
    // A native C entry supplies converted values; only the shared Body consumer
    // may admit them. Equal native types do not establish source correspondence.
    val lane = <LlvmLogicalParameter type=backend.i64ty semanticType=11U64 role=<LlvmParameterRole.Ordinary index=0U64 /> mode=<LlvmParameterMode.Borrow /> />
    val convertedAbi = backend.saveValueAbi(signature: <LlvmLogicalSignature convention=<LlvmValueConvention.Body /> parameters=[lane] result=backend.voidty resultTerm=0U64 />, ownerBody: otherBodyId).unwrap()
    val convertedName = <CString.copied text="converted-private-target" />
    val convertedTarget = backend.declarePlannedBodyFunction(name: convertedName.ptr, abiId: convertedAbi, bodyId: otherBodyId).unwrap()
    val convertedSignature = backend.valueAbis[convertedAbi - 1U64].logicalSignature
    val inputScope = backend.bodyInputScope(bodyId: otherBodyId, signature: convertedSignature).unwrap()
    val entryName = <CString.copied text="native-converted-entry" />
    val entry = LLVMAddFunction(module, entryName.ptr, convertedSignature)
    val foreignEntry = LLVMAddFunction(otherModule, entryName.ptr, convertedSignature)
    backend.curFn = entry
    backend.beginFnBody(fv: entry)
    val input = <LlvmValueInput lane=lane index=0U64 carrier=<LlvmValueCarrier.Value value=LLVMGetParam(entry, 0U64) /> />
    backend.callBodyValueFunction(function: convertedTarget, bodyId: otherBodyId, inputs: inputScope, arguments: [input]).unwrap()
    mut val malformed = 0U64
    while malformed < 4U64 {
        val bad = <LlvmValueInput lane=<LlvmLogicalParameter type=lane.type semanticType=if malformed == 0U64 { give 12U64 } else { give lane.semanticType } role=if malformed == 1U64 { give <LlvmParameterRole.Receiver /> } else { give lane.role } mode=if malformed == 2U64 { give <LlvmParameterMode.Move /> } else { give lane.mode } /> index=if malformed == 3U64 { give 1U64 } else { give 0U64 } carrier=input.carrier />
        requireInternal(result: backend.callBodyValueFunction(function: convertedTarget, bodyId: otherBodyId, inputs: inputScope, arguments: [bad]))
        malformed += 1U64
    }
    requireInternal(result: backend.callBodyValueFunction(function: convertedTarget, bodyId: bodyId, inputs: inputScope, arguments: [input]))
    requireInternal(result: backend.callBodyValueFunction(function: convertedTarget, bodyId: otherBodyId, inputs: backend.bodyInputScope(bodyId: bodyId, signature: convertedSignature).unwrap(), arguments: [input]))
    requireInternal(result: backend.callBodyValueFunction(function: convertedTarget, bodyId: otherBodyId, inputs: inputScope, arguments: [<LlvmValueInput lane=lane index=0U64 carrier=<LlvmValueCarrier.Value value=LLVMGetParam(foreignEntry, 0U64) /> />]))
    requireInternal(result: backend.callLegacyValueFunction(signature: convertedSignature, function: convertedTarget, arguments: [LLVMGetParam(entry, 0U64)]))
    LLVMBuildRetVoid(builder)
    val mainName = compiler.internBytes(s: "main")
    val mainIndex = compiler.arena.firstFunctionNamed(nameId: mainName.nameId)
    val mainBodyId = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=mainIndex environment=<InstanceEnvironment /> />)
    val mainFunction = backend.declareProgramValueFunction(c: inout compiler, bodyId: mainBodyId, main: true).unwrap()
    val count = backend.valueAbis.count()
    if LLVMIsAFunction(backend.declareProgramValueFunction(c: inout compiler, bodyId: mainBodyId, main: true).unwrap()) != LLVMIsAFunction(mainFunction) || backend.valueAbis.count() != count { panic "program publisher rebuilt descriptor/function" }
    if !backend.programValueParameter(function: mainFunction, bodyId: mainBodyId, index: 0U64).unwrap().lane.role.same(role: <LlvmParameterRole.ProgramArgumentCount />) || !backend.programValueParameter(function: mainFunction, bodyId: mainBodyId, index: 1U64).unwrap().lane.role.same(role: <LlvmParameterRole.ProgramArgumentValues />) { panic "native main reader lost roles" }
    requireInternal(result: backend.programValueParameter(function: mainFunction, bodyId: mainBodyId, index: 2U64))
    requireInternal(result: backend.programNativeAbi(function: mainFunction, bodyId: mainBodyId, main: false))
    requireInternal(result: backend.programNativeAbi(function: foreignEntry, bodyId: mainBodyId, main: true))
    val mainCanonical = compiler.mid.store(body: <MidBody bodyInstance=mainBodyId sourceFunction=mainIndex blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    backend.curFn = mainFunction
    backend.curIsMain = true
    backend.curRetVoid = false
    val mainAdmission = backend.prepareBodyLocalPlan(c: inout compiler, canonical: mainCanonical, parameterCount: 0U64).unwrap()
    backend.beginFnBody(fv: mainFunction)
    if !backend.genLlvmPreparedMidBody(c: inout compiler, prepared: <MidLlvmPrepared.Ready canonical=mainCanonical localAdmission=mainAdmission />).unwrap() { panic "program main Ready failed" }
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(otherModule)
    LLVMDisposeModule(module)
    LLVMContextDispose(context)
    write(s: "ok\n")
}
