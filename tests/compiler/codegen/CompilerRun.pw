mut val sentinel = 0I64
use /CompilerExecution only { executeProgram }
use /Frontend only { FrontendInput }
use /SourceAccess only { SourceAccess }
use @Std/Process only { argAt, argCount, exit }
use @Std/Core only { assert }
fn execute() -> I32 {
    val target = argAt(2I64)
    val status = executeProgram(input: <FrontendInput.File path=argAt(2I64) />,
        sources: <SourceAccess stdRoot=argAt(1I64).bytes() />,
        arguments: [argAt(2I64), "example"])
    // The process owner survives main return, including its application argv.
    assert(argCount() == 2I64)
    assert(argAt(0I64) == target)
    assert(argAt(1I64) == "example")
    return status
}
fn whileBorrowed(value: inout I64, action: fn() -> I32) -> I32 {
    val result = action()
    value += 1I64
    return result
}
fn main() {
    // Host and app deliberately declare their first global at byte offset 8.
    // Holding a host borrow across JIT execution must not borrow app storage.
    val status = whileBorrowed(value: inout sentinel, action: fn() -> I32 { return execute() })
    assert(sentinel == 1I64)
    if status != 0I32 { exit(code: 1I64) }
}
