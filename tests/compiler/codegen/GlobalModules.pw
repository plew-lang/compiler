// Native diagnostic harness: emit either the storage owner or a body module
// referencing it. Link both outputs to exercise one shared global identity.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/PreparedProgram only { PreparedProgram }
use ../../../src/Backend only { lowerGlobalStorageLlvm, lowerPreparedLlvm, LlvmLoweringResult, LlvmGlobalStorage, LlvmBodyEmission }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler,
        input: <FrontendInput.File path=argAt(1I64) />,
        sources: <SourceAccess stdRoot=argAt(3I64).bytes() />).unwrap()
    val prepared = PreparedProgram.prepare(c: inout compiler).unwrap()
    if argAt(2I64) == "list" {
        mut val bodyId = 1U64
        while bodyId <= compiler.arena.bodyInstanceCount() {
            match prepared.executable.body(bodyId: bodyId) {
                Optional.Some(v: _) => { print(bodyId) }
                Optional.None => {}
            }
            bodyId += 1U64
        }
        return
    }
    if argAt(2I64) == "storage" {
        match lowerGlobalStorageLlvm(c: inout compiler) {
            LlvmLoweringResult.Success(module: val module) => { module.writeText(c: inout compiler) }
            LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { panic diagnostic.message }
        }
    } else {
        mut val emission = <LlvmBodyEmission.Whole />
        if argAt(2I64) == "requested" {
            mut val bodyId = 0U64
            for byte in argAt(4I64).bytes() { bodyId = bodyId * 10U64 + (byte as U64) - 48U64 }
            emission = <LlvmBodyEmission.Requested bodyId=bodyId />
        }
        match lowerPreparedLlvm(c: inout compiler, prepared: prepared, globalStorage: <LlvmGlobalStorage.Reference />, emission: emission) {
            LlvmLoweringResult.Success(module: val module) => { module.writeText(c: inout compiler) }
            LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { panic diagnostic.message }
        }
    }
}
