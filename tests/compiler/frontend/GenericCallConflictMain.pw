// Appended to an exact Frontend snapshot; no production API is made public.
fn requireGenericConflict(prepared: Bool, unavailableArrayContext: Bool = false) {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text path="GenericConflict.pw" text="fn acceptBoth[T](first: T, second: T) {{}}\nfn main() {{ acceptBoth(first: 5I32, second: 6I64) }}" />, sources: <SourceAccess />).unwrap()
    val mainName = compiler.internBytes(s: "main")
    val function = compiler.arena.firstFunctionNamed(nameId: mainName.nameId)
    val called = compiler.internBytes(s: "acceptBoth")
    mut val expression = compiler.arena.exprs.count()
    mut val arguments = <ArgRange start=0U64 len=0U64 />
    for index in 0U64..<compiler.arena.exprs.count() {
        match compiler.arena.exprs[index] {
            Expr.Call(nameStart: val start, nameLen: val length, args: val args) => {
                if intern(c: inout compiler, start: start, len: length) == called.nameId { expression = index arguments = args }
            }
            _ => {}
        }
    }
    if expression >= compiler.arena.exprs.count() || arguments.len != 2U64 { panic("generic conflict setup lost its authored call") }
    val owner = <SemanticCompletionOwner.Function index=function />
    compiler.cur.checkFn = function
    compiler.cur.recordCallTemplates = true
    compiler.sourceFacts.activate(owner: owner)
    if !prepared {
        for index in 0U64..<arguments.len { compiler.recordExpr(exprId: compiler.argAt(args: arguments, index: index).expr).unwrap() }
    }
    for index in 0U64..<arguments.len {
        if compiler.argumentRequiresResultContext(exprId: compiler.argAt(args: arguments, index: index).expr).unwrap() != prepared { panic("generic conflict setup did not select its inference path") }
    }
    val origin = <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=owner /> returnContext=<SourceExpectedContext.None /> arrayContext=if unavailableArrayContext { give <SourceArrayContextOrigin.Unavailable /> } else { give <SourceArrayContextOrigin.Regular /> } />
    val written = match compiler.arena.exprs[expression] {
        Expr.Call(nameStart: val start, nameLen: val length, args: _) => (start: start, length: length)
        _ => { panic("generic conflict setup lost free syntax") }
    }
    val context = compiler.resolvedFreeFunctionCall(id: expression, nameStart: written.start, nameLen: written.length, args: arguments).unwrap()
    match context { FreeCallLookup.DiagnosticCandidate(function: _) => {} _ => { panic("generic conflict setup lost its diagnostic candidate") } }
    val callee = match context { FreeCallLookup.DiagnosticCandidate(function: val callee) => callee _ => { panic("missing conflict callee") } }
    val declaration = compiler.arena.functionAt(index: callee)
    val beforeRaw = compiler.failedGenericCallConflicts.count()
    match compiler.inferPreparedCallTypeArguments(f: declaration, args: arguments) {
        Result.Err(error: val raw) => { if raw.genericCallConflict().isSome() || compiler.sourceFailureHasOwner(diagnostic: raw) { panic("Raw inference acquired an owned receipt") } }
        Result.Ok(value: _) => { panic("Raw inference accepted conflicting arguments") }
    }
    if compiler.failedGenericCallConflicts.count() != beforeRaw { panic("active cursor granted Raw source authority") }
    for invalid in 0U64..<4U64 {
        val request = if invalid == 0U64 {
            give <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession()+1U64 root=owner />
        } else if invalid == 1U64 {
            give <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=<SemanticCompletionOwner.Function index=callee /> />
        } else { give origin.request }
        val inferenceOrigin = <GenericCallInferenceOrigin.Call request=request expression=if invalid == 2U64 { give expression+1U64 } else { give expression } callee=if invalid == 3U64 { give function } else { give callee } arguments=arguments diagnostic=true />
        match compiler.inferPreparedCallTypeArguments(f: declaration, args: arguments, inferenceOrigin: inferenceOrigin) {
            Result.Err(error: val raw) => { if raw.genericCallConflict().isSome() || compiler.sourceFailureHasOwner(diagnostic: raw) { panic("foreign inference request acquired source ownership") } }
            Result.Ok(value: _) => { panic("foreign request swallowed the original conflict") }
        }
        if compiler.failedGenericCallConflicts.count() != beforeRaw { panic("foreign request published an owned conflict") }
    }
    // Enter the real argument-inference boundary directly: recording the whole
    // expression first would prepare both scalar operands and erase this control.
    val templatesBefore = compiler.callTemplateLocations.count()
    val closuresBefore = compiler.semanticClosures.count()
    val interfacesBefore = compiler.interfaceCalls.count()
    val diagnostic = match compiler.recordFreeCallArgumentContexts(exprId: expression, context: context, args: arguments, origin: origin, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Err(error: val diagnostic) => diagnostic
        Result.Ok(value: _) => { panic("generic conflict was accepted") }
    }
    if diagnostic.message() != "inconsistent types for a type parameter: two arguments bound to the same `[T]` have different types" { panic(diagnostic.message()) }
    if diagnostic.isSourceRejection() { panic("private checker bypassed owning failure interpretation") }
    compiler.sourceFacts.fail(owner: owner, diagnostic: diagnostic)
    if !compiler.sourceFailureHasOwner(diagnostic: diagnostic) {
        if prepared { panic("owned prepared conflict lost its source cause") }
        panic("owned typed-term conflict lost its source cause")
    }
    val refusal = diagnostic.genericCallConflict().unwrap()
    val proof = compiler.failedGenericCallConflicts[refusal.event()]
    if !proof.diagnostic || proof.known.count() != declaration.typeParams.count() || proof.known[0U64] == 0U64 || proof.pattern == 0U64 { panic("lost original conflict bindings or role") }
    for kind in 0U64..<8U64 {
        val changed = <GenericCallConflictRefusal session=if kind == 0U64 { give refusal.session()+1U64 } else { give refusal.session() } owner=if kind == 1U64 { give <DiagnosticOwner.Unknown /> } else { give refusal.owner() } expression=if kind == 2U64 { give refusal.expression()+1U64 } else { give refusal.expression() } callee=if kind == 3U64 { give refusal.callee()+1U64 } else { give refusal.callee() } operand=if kind == 4U64 { give refusal.operand()+1U64 } else { give refusal.operand() } parameter=if kind == 5U64 { give refusal.parameter()+1U64 } else { give refusal.parameter() } event=if kind == 6U64 { give refusal.event()+1U64 } else { give refusal.event() } location=if kind == 7U64 { give <DiagnosticLocation.Unpositioned /> } else { give refusal.location() } />
        if compiler.sourceGenericCallConflictHasOwner(refusal: changed) { panic("foreign conflict metadata acquired source ownership") }
    }
    val internal = <CompileDiagnostic failureDomain=<FailureDomain.Internal /> location=diagnostic.location() message=diagnostic.message() />
    if compiler.sourceFailureHasOwner(diagnostic: internal) { panic("equal-text internal report acquired conflict ownership") }
    mut val changedArguments = compiler
    val original = compiler.argAt(args: arguments, index: 0U64)
    changedArguments.arena.argPool[arguments.start] = <Arg expr=original.expr+1U64 isInout=original.isInout labelStart=original.labelStart labelLen=original.labelLen hasLabel=original.hasLabel />
    if changedArguments.sourceGenericCallConflictHasOwner(refusal: refusal) { panic("changed argument matched old conflict") }
    mut val synthetic = compiler
    synthetic.recordSyntheticCallSite(site: <SyntheticCallSite exprId=expression receiverTerm=0U64 />).unwrap()
    if synthetic.sourceGenericCallConflictHasOwner(refusal: refusal) { panic("synthetic call borrowed authored conflict") }
    compiler.pendingDiagnostics.append(diagnostic)
    if compiler.takeDiagnostics().count() != 1U64 || !compiler.sourceFailureHasOwner(diagnostic: diagnostic) { panic("drain erased retained conflict") }
    if compiler.hasSemanticExprTypeFact(exprId: expression) { panic("failed generic call published a result") }
    if compiler.callTemplateLocations.count() != templatesBefore || compiler.semanticClosures.count() != closuresBefore || compiler.interfaceCalls.count() != interfacesBefore { panic("failed generic call published a successful callable boundary") }
}
fn requireBareFactoryOperation() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text path="BareFactoryConflict.pw" text="struct Holder[T] {{}}\nimpl[T] Holder[T] {{ factory same(first: T, second: T) {{ return <Holder[T] /> }} }}\nfn main() {{ val h = <Holder.same first=5I32 second=6I64 /> }}" />, sources: <SourceAccess />).unwrap()
    val mainName = compiler.internBytes(s: "main")
    val owner = <SemanticCompletionOwner.Function index=compiler.arena.firstFunctionNamed(nameId: mainName.nameId) />
    val factoryName = compiler.internBytes(s: "same")
    mut val expression = compiler.arena.exprs.count()
    for index in 0U64..<compiler.arena.exprs.count() {
        if compiler.authoredNamedFactoryOrigins.contains(key: index) {
            match compiler.arena.exprs[index] {
                Expr.Method(recv: _, nameStart: val start, nameLen: val length, args: val args) => { if args.len == 2U64 && intern(c: inout compiler, start: start, len: length) == factoryName.nameId { expression = index } }
                _ => {}
            }
        }
    }
    if expression >= compiler.arena.exprs.count() { panic("missing authored factory receipt") }
    val args = match compiler.arena.exprs[expression] { Expr.Method(recv: _, nameStart: _, nameLen: _, args: val args) => args _ => { panic("factory normalization lost its method") } }
    if compiler.sourceCallOperation(exprId: expression, args: args).isNone() { panic("bare factory lost its authored operation") }
    compiler.cur.checkFn = compiler.arena.firstFunctionNamed(nameId: mainName.nameId)
    compiler.sourceFacts.activate(owner: owner)
    val origin = <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=owner /> returnContext=<SourceExpectedContext.None /> />
    val frontierCount = compiler.failedArrayContextFrontiers.count()
    val arrayOrigin = compiler.diagnosticArrayContextOrigin(origin: origin, exprId: expression, args: args)
    match arrayOrigin.request {
        SourceRecordOrigin.CheckingRequest(session: val session, root: val root) => { if session != compiler.sourceFactSession() || !semanticCompletionOwnersEqual(recorded: root, prepared: owner) { panic("Array context changed the source request") } }
        _ => { panic("Array context erased the authored source request") }
    }
    match arrayOrigin.arrayContext { SourceArrayContextOrigin.Unavailable => {} _ => { panic("bare factory granted Array context authority") } }
    val returned = arrayOrigin.returning(context: <SourceExpectedContext.None />)
    match returned.arrayContext { SourceArrayContextOrigin.Unavailable => {} _ => { panic("return context reset unavailable Array authority") } }
    val retried = compiler.diagnosticArrayContextOrigin(origin: returned, exprId: expression, args: args)
    match retried.arrayContext { SourceArrayContextOrigin.Unavailable => {} _ => { panic("recursive context retried unavailable Array authority") } }
    if compiler.failedArrayContextFrontiers.count() != frontierCount { panic("bare factory published an Array frontier") }
    val name = compiler.internBytes(s: "I64")
    val unrelated = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] />)
    if compiler.sourceCallOperation(exprId: expression, args: args, factoryReceiver: unrelated).isSome() { panic("unrelated nonzero receiver fell back to bare factory proof") }
    mut val changed = compiler
    val siteIndex = changed.syntheticCallSiteIndex(exprId: expression)
    val site = changed.decls.syntheticCallSites[siteIndex]
    changed.decls.syntheticCallSites[siteIndex] = <SyntheticCallSite exprId=expression kind=<SyntheticCallKind.Factory /> originSerial=site.originSerial+1U64 receiverTerm=site.receiverTerm receiverIsType=site.receiverIsType />
    if changed.sourceCallOperation(exprId: expression, args: args).isSome() { panic("foreign synthetic serial borrowed a factory receipt") }
}

fn main() {
    requireGenericConflict(prepared: false)
    requireGenericConflict(prepared: true)
    requireGenericConflict(prepared: false, unavailableArrayContext: true)
    requireGenericConflict(prepared: true, unavailableArrayContext: true)
    requireBareFactoryOperation()
}
