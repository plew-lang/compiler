// Original-node rigidity when a provided receiver contains a caller binder.
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/ProjectionMembers/RecursiveProvidedExpectedResult.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("provided boundary setup: "+diagnostic.message()) }
    }
    val name = compiler.internBytes(s: "reshape").nameId
    mut val found = false
    for index in 0U64..<compiler.arena.functionCount() {
        val function = compiler.arena.functionAt(index: index)
        if function.nameId == name && function.isProvided {
            val owner = compiler.semanticBodyOwner(fnIdx: index).unwrap()
            val source = compiler.arena.functionAt(index: owner)
            if source.typeParams.count() != 1U64 { panic("provided boundary source has unexpected binders") }
            val binder = compiler.funcBindAt(binds: source.typeParams, index: 0U64)
            val caller = compiler.pushType(t: <TypeRef nameStart=binder.nameStart nameLen=binder.nameLen nameId=binder.nameId paramId=binder.paramId args=[] />)
            val receiver = compiler.rebuildTypeTermChildren(ref: function.recvTy, children: [caller])
            compiler.cur.checkFn = owner
            val environment = compiler.methodReceiverSignatureEnvironment(f: function, semanticReceiver: receiver).unwrap()
            val pattern = compiler.providedExpectedResultPattern(callee: index, receiver: receiver, proof: environment.proof).unwrap()
            val result = compiler.arena.typeAt(index: pattern)
            val scalar = compiler.langTypeRef(name: "Bool", args: [])
            mut val fields: Array[U64] = []
            for position in 0U64..<result.recordFieldLabels.count() {
                val field = result.recordFieldTerms[position]
                if result.recordFieldLabels[position] == compiler.internBytes(s: "transform").nameId {
                    fields.append(compiler.groundTermInEnvironment(ref: field, params: [binder], values: [scalar]))
                } else { fields.append(receiver) }
            }
            val expected = compiler.rebuildRecordTypeTerm(t: result, fieldTerms: fields)
            val arguments = compiler.publishCallTemplateTypeArgs(args: compiler.signatureTypeArguments(f: function, environment: environment))
            val kind = <CallTemplateKind.Direct callee=index receiver=<CallTemplateReceiver.Term term=receiver /> args=<CallTemplateArgumentRange start=0U64 len=0U64 /> calleeTypeArgs=arguments proofId=compiler.freezeStaticConformanceProof(proof: environment.proof) />
            val proposal = compiler.prepareCallTemplateResult(kind: kind, expectedTerm: expected, receiverTerm: receiver, offset: source.nameStart).unwrap()
            if proposal.isNone() { panic("provided receiver replacement was re-inferred as a method binder") }
            val completed = proposal.unwrap()
            if !compiler.typeRefEq(a: completed.arguments[completed.arguments.count() - 1U64], b: scalar) || !compiler.typeRefEq(a: completed.result.resultType, b: expected) { panic("provided completion lost its rigid receiver or inferred method result") }
            found = true
        }
    }
    if !found { panic("provided result boundary was not exercised") }
}
