use ../../../src/Frontend only { Comp, FrontendInput, FrontendOptions, analyzeFrontend }
use ../../../src/FrontendDriver only { runFrontend }
use ../../../src/PreparedProgram only { PreparedProgram, programPreparationDiagnostic }
use ../../../src/CompilerDiagnostics only { reportProgramPreparationError }
use @Std/Io only { print }
use @Std/Process only { argCount, argAt }
use ../../../src/Diag only { emitDiagnostic }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Path only { computeStdRoot }
fn main() {
    mut val compiler: Comp = <Comp />
    val returningGenFailure = argCount() > 1I64 && argAt(1I64) == "--return-gen-failure"
    val returningFailure = returningGenFailure || (argCount() > 1I64 && argAt(1I64) == "--return-failure")
    if returningFailure {
        match analyzeFrontend(c: inout compiler,
            input: <FrontendInput.File path=argAt(2I64) />,
            sources: <SourceAccess stdRoot=computeStdRoot(arg0: argAt(0I64).bytes()) />,
            options: <FrontendOptions genMode=returningGenFailure />) {
            Result.Ok(value: _) => {}
            Result.Err(error: val diagnostic) => {
                emitDiagnostic(diagnostic: diagnostic)
                print("returned")
                return
            }
        }
    } else {
        runFrontend(c: inout compiler)
    }
    match PreparedProgram.prepare(c: inout compiler) {
        Result.Ok(value: _) => { print("prepared") }
        Result.Err(error: val error) => {
            if returningFailure {
                emitDiagnostic(diagnostic: programPreparationDiagnostic(c: inout compiler, error: error))
                print("returned")
            } else {
                reportProgramPreparationError(c: inout compiler, error: error)
            }
        }
    }
}
