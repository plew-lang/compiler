// Focused source-bound preparation and frame-restoration controls.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/ModuleScopeBindings only { ModuleScopeBindings, ScopeBindingKind }
use ../../../src/Diag only { DiagnosticLocation, FailureDomain }
use @Plew/Syntax only { DeclAst, TraitAst, TypeAst, parseItem, TopItemAst, rangeEquals }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn sourceItem(compiler~: Comp, text~: String) -> TopItemAst {
    mut val start = 0U64
    while start + text.bytes().count() <= compiler.arena.bytes.count() {
        if rangeEquals(bytes: compiler.arena.bytes, start: start, len: text.bytes().count(), kw: text) { break }
        start += 1U64
    }
    if start + text.bytes().count() > compiler.arena.bytes.count() { panic("declaration source setup failed") }
    return parseItem(source: text, start: start, end: start + text.bytes().count())
}

fn declaration(compiler~: Comp, text~: String) -> DeclAst {
    match sourceItem(compiler, text) {
        TopItemAst.Decl(d: val result) => { return result }
        _ => { panic("declaration AST setup failed") }
    }
}

fn traitDeclaration(compiler~: Comp, text~: String) -> TraitAst {
    match sourceItem(compiler, text) {
        TopItemAst.Trait(t: val result) => { return result }
        _ => { panic("trait AST setup failed") }
    }
}

fn exerciseRequirementWhere(valueAdapter: Bool) {
    val header = "trait Marker {{}}\n"
    val invalid = "trait Invalid {{ fn ready() fn invalid[T](value:T)\n    where T:Unknown }}"
    val valid = "trait Recovered {{ fn accepted[T](value:T) where T:Marker }}"
    val path = "RequirementWhere.pw"
    mut val compiler = <Comp />
    val rejected = if valueAdapter {
        val source = header + "/* " + invalid + " */\n// " + valid + "\nfn main() {{}}"
        analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path=path />, sources: <SourceAccess stdRoot=[] />).unwrap()
        val trait = traitDeclaration(compiler, invalid)
        compiler.predeclareTrait(t: trait)
        give compiler.lowerTrait(t: trait)
    } else {
        give analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=header + invalid + "\nfn main() {{}}" path=path />, sources: <SourceAccess stdRoot=[] />)
    }
    match rejected {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain { FailureDomain.Source => {} _ => { panic(diagnostic.message) } }
            match diagnostic.location {
                DiagnosticLocation.File(path: val file, line: val line) => {
                    if file != path || line != 3I64 { panic("requirement where rejection lost its source location") }
                }
                _ => { panic("requirement where rejection has no source location") }
            }
            if diagnostic.message != "unknown trait in where clause" { panic(diagnostic.message) }
        }
        Result.Ok(value: _) => { panic("an unresolved requirement bound entered source admission") }
    }
    if compiler.decls.traitCount() != 1U64 || compiler.sourceTypeUses.currentScope() != 0U64 || compiler.cur.typeParams.count() != 0U64 || compiler.lowerAssociatedOwner != 0U64 || compiler.lowerAssociatedArgs.count() != 0U64 {
        panic("a failed requirement published its trait or leaked its lexical frame")
    }
    if valueAdapter {
        val trait = traitDeclaration(compiler, valid)
        compiler.predeclareTrait(t: trait)
        compiler.lowerTrait(t: trait).unwrap()
    } else {
        compiler = <Comp />
        analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=header + valid + "\nfn main() {{}}" path=path />, sources: <SourceAccess stdRoot=[] />).unwrap()
    }
    val declaration = compiler.decls.traitAt(index: 1U64)
    val requirement = compiler.traitReqAt(reqs: declaration.reqs, index: 0U64)
    if requirement.signatureBounds.len != 1U64 || compiler.conformBoundAt(bounds: requirement.signatureBounds, index: 0U64).constraint.key.owner != compiler.decls.traitAt(index: 0U64).nameStart {
        panic("the valid requirement did not retain its canonical where bound")
    }
    print("1")
}

fn valueRequirementCompiler(requirement: String) -> Comp {
    val project = "trait Project[Kind] {{ type Item }}"
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    compiler.internBytes(s: project + "\n" + requirement)
    val schema = traitDeclaration(compiler, project)
    mut val bindings = <ModuleScopeBindings />
    bindings.addDeclaration(moduleId: 0U64, nameId: compiler.internBytes(s: "Project").nameId, kind: <ScopeBindingKind.Trait />, offset: schema.nameSpan.start, isPublic: false).unwrap()
    compiler.moduleScopeBindings = <Optional.Some v=bindings.finish().unwrap() />
    compiler.predeclareTrait(t: schema)
    compiler.lowerTrait(t: schema).unwrap()
    val declaration = traitDeclaration(compiler, requirement)
    compiler.predeclareTrait(t: declaration)
    compiler.lowerTrait(t: declaration).unwrap()
    return compiler
}

fn exerciseRequirementSignatureValue() {
    val inherited = "trait Exact[Kind]: Project[Kind] {{ fn exact(value: Self#Project[Kind].Item) -> Self#Project[Kind].Item }}"
    val associated = "trait Exact[Kind] {{ type Input: Project[Kind] fn exact(value: Input#Project[Kind].Item) -> Input#Project[Kind].Item }}"
    for valid in [inherited, associated] {
        mut val compiler = valueRequirementCompiler(requirement: valid)
        compiler.admitAuthoredFunctionViews().unwrap()
        val token = compiler.sourceTypeUses.requirementScopeAt(index: 0U64)
        val scope = compiler.sourceTypeUses.scopeAt(token: token).unwrap()
        val owner = scope.requirement.unwrap()
        val trait = compiler.decls.traitAt(index: owner.traitIndex)
        val requirement = compiler.traitReqAt(reqs: trait.reqs, index: owner.slot)
        val result = compiler.sourceTypeUses.useAt(index: owner.result - 1U64).unwrap()
        val parameter = compiler.funcParamAt(params: requirement.params, index: 0U64)
        if scope.function.isSome() || result.scope != token || parameter.authoredTypeUse == owner.result || !compiler.typeRefEq(a: result.term, b: requirement.retTy) {
            panic("the raw requirement lost its distinct parameter and result occurrences")
        }
    }
    val invalid = "trait Wrong: Project[Bool] {{ fn wrong(value: Self#Project[I64].Item) }}"
    mut val compiler = valueRequirementCompiler(requirement: invalid)
    match compiler.admitAuthoredFunctionViews() {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain { FailureDomain.Source => {} _ => { panic(diagnostic.message) } }
            if diagnostic.message != "trait view requires a conformance for this receiver and exact trait instance (spec/09)" { panic(diagnostic.message) }
        }
        Result.Ok(value: _) => { panic("the value adapter admitted a foreign trait instance") }
    }
    print("1")
}

fn exerciseWhereAdmission(valueAdapter: Bool) {
    val header = "trait Marker {{}}\n"
    val invalid = "fn invalid[T](value:T) where T:Marker,\n    T:Unknown {{}}"
    val valid = "fn valid[T](value:T) where T:Marker {{}}"
    val path = "WhereAdmission.pw"
    mut val compiler = <Comp />
    val rejected = if valueAdapter {
        val source = header + "/* " + invalid + " */\n// " + valid + "\nfn main() {{}}"
        analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path=path />, sources: <SourceAccess stdRoot=[] />).unwrap()
        give compiler.lowerFuncDecl(d: declaration(compiler, invalid))
    } else {
        give analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=header + invalid + "\nfn main() {{}}" path=path />, sources: <SourceAccess stdRoot=[] />)
    }
    match rejected {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain { FailureDomain.Source => {} _ => { panic(diagnostic.message) } }
            match diagnostic.location {
                DiagnosticLocation.File(path: val file, line: val line) => {
                    if file != path || line != 3I64 { panic("where rejection lost its source location") }
                }
                _ => { panic("where rejection has no source location") }
            }
            if diagnostic.message != "unknown trait in where clause" { panic(diagnostic.message) }
        }
        Result.Ok(value: _) => { panic("an unresolved trait entered source admission") }
    }
    if compiler.decls.funcBounds.count() != 0U64 || compiler.sourceTypeUses.currentScope() != 0U64 || compiler.cur.typeParams.count() != 0U64 {
        panic("where rejection published a bound or leaked its frame")
    }
    if valueAdapter {
        compiler.lowerFuncDecl(d: declaration(compiler, valid)).unwrap()
    } else {
        compiler = <Comp />
        analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=header + valid + "\nfn main() {{}}" path=path />, sources: <SourceAccess stdRoot=[] />).unwrap()
    }
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "valid").nameId)
    val rows = compiler.decls.funcBounds.indices(owner: function)
    if rows.count() != 1U64 { panic("the valid where clause did not publish one premise") }
    val owner = compiler.decls.funcBounds.at(index: rows[0U64]).constraint.key.owner
    val traitIndex = compiler.decls.traitOwnerIndex(offset: owner)
    if traitIndex >= compiler.decls.traitOwnerCount() || compiler.decls.traitOwnerAt(index: traitIndex).nameId != compiler.internBytes(s: "Marker").nameId {
        panic("the published where clause lost its canonical trait owner")
    }
    print("1")
}

fn main() {
    val scenario = argAt(1I64)
    if scenario == "requirementSignatureValue" {
        exerciseRequirementSignatureValue()
        return
    }
    if scenario == "requirementWhereSyntax" || scenario == "requirementWhereValue" {
        exerciseRequirementWhere(valueAdapter: scenario == "requirementWhereValue")
        return
    }
    if scenario == "whereSyntax" || scenario == "whereValue" {
        exerciseWhereAdmission(valueAdapter: scenario == "whereValue")
        return
    }
    val header = "trait Project[Kind] {{ type Item }} trait Other[Kind] {{ type Item }} trait Marker[Kind] {{}} trait Zero {{ type Item }} "
    if scenario == "later" || scenario == "nonmember" {
        val body = if scenario == "later" {
            give "fn inspect[T,U](value:T.Item) where T:Project[U.Item], U:Other[I64] {{}}"
        } else { give "fn inspect[T](value:T.Item) where T:Marker[T.Item], T:Project[I64] {{}}" }
        mut val compiler = <Comp />
        analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=header + body + " fn main() {{}}" path="BoundDependencies.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
        if compiler.lowerProjectionDepth != 0U64 || compiler.sourceTypeUses.currentScope() != 0U64 { panic("successful bound preparation leaked a frame") }
        print("1")
        return
    }
    val bad = "fn bad[T](value:T.Item) where T:Project[T.Item] {{}}"
    val empty = "fn empty[T](value:T.Item) {{}}"
    val good = "fn good[T](value:T.Item) where T:Project[I64] {{}}"
    val legacy = "fn legacy[T](value:T.Item) where T:Zero {{}}"
    mut val compiler = <Comp />
    val source = header + "\n// " + bad + "\n// " + empty + "\n// " + good + "\n// " + legacy + "\nfn main() {{}}"
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path="BoundRecovery.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val goodDeclaration = declaration(compiler, good)
    if scenario == "legacy" {
        val parsed = declaration(compiler, legacy)
        // The value-AST adapter explicitly supports the old name-only rows.
        val raw = <DeclAst kind=parsed.kind name=parsed.name nameSpan=parsed.nameSpan typeParams=parsed.typeParams span=parsed.span isUnique=parsed.isUnique fields=parsed.fields hasDeinit=parsed.hasDeinit deinitBody=parsed.deinitBody variants=parsed.variants params=parsed.params hasRet=parsed.hasRet ret=parsed.ret isAsync=parsed.isAsync whereParams=parsed.whereParams whereTraits=parsed.whereTraits body=parsed.body />
        compiler.lowerFuncDecl(d: raw).unwrap()
        compiler.admitAuthoredFunctionViews().unwrap()
        val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "legacy").nameId)
        val signature = compiler.sourceTypeUses.signatureFor(function: owner).unwrap()
        mut val index = 0U64
        while index < compiler.sourceTypeUses.useCount() {
            val occurrence = compiler.sourceTypeUses.useAt(index: index).unwrap()
            if occurrence.scope == signature.scope && occurrence.site == parsed.nameSpan.start { panic("legacy synthetic subject acquired an authored occurrence") }
            index += 1U64
        }
        print("1")
        return
    }
    match compiler.lowerFuncDecl(d: declaration(compiler, bad)) {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain { FailureDomain.Limit => {} _ => { panic("recursive bound did not report typed Limit") } }
        }
        Result.Ok(value: _) => { panic("recursive bound preparation was accepted") }
    }
    if compiler.lowerProjectionDepth != 0U64 || compiler.sourceTypeUses.currentScope() != 0U64 || compiler.cur.typeParams.count() != 0U64 { panic("failed bound preparation leaked lexical state") }
    match compiler.lowerFuncDecl(d: declaration(compiler, empty)) {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain { FailureDomain.Source => {} _ => { panic("empty bound frame failed in another domain") } }
            if !rangeEquals(bytes: diagnostic.message.bytes(), start: 0U64, len: "associated-type short projection has no unique trait source".bytes().count(), kw: "associated-type short projection has no unique trait source") { panic(diagnostic.message) }
        }
        Result.Ok(value: _) => { panic("empty bound frame borrowed a stale outer premise") }
    }
    if compiler.lowerProjectionDepth != 0U64 || compiler.sourceTypeUses.currentScope() != 0U64 || compiler.cur.typeParams.count() != 0U64 { panic("empty bound frame leaked lexical state") }
    compiler.lowerFuncDecl(d: goodDeclaration).unwrap()
    compiler.admitAuthoredFunctionViews().unwrap()
    if compiler.lowerProjectionDepth != 0U64 || compiler.sourceTypeUses.currentScope() != 0U64 || compiler.cur.typeParams.count() != 0U64 { panic("recovered declaration leaked lexical state") }
    print("1")
}
