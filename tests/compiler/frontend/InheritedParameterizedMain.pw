// Parent arity and argument recipes belong to the retained declaring instance.
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/ProjectionMembers/InheritedParameterized.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("parameterized source rejected: "+diagnostic.message()) }
    }
    val index = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "entry").nameId)
    val function = compiler.arena.functionAt(index: index)
    val parameter = compiler.funcParamAt(params: function.params, index: 0U64)
    val symbolic = compiler.lexicalBodyParameterType(function: index, index: 0U64, ref: parameter.ty, receiver: 0U64).unwrap().unwrap()
    val projection = compiler.arena.typeAt(index: symbolic)
    if projection.assocTraitId != compiler.internBytes(s: "Parent").nameId || projection.assocTraitArgs.count() != 2U64 { panic("declaring instance reused Child arity") }
    val array = compiler.arena.typeAt(index: projection.assocTraitArgs[0U64])
    if array.nameId != compiler.internBytes(s: "Array").nameId || array.args.count() != 1U64 || compiler.arena.typeAt(index: array.args[0U64]).nameId != compiler.internBytes(s: "I64").nameId { panic("saved parent argument lost its nested equation substitution") }
    val leafFunction = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "leaf").nameId)
    val leaf = compiler.funcParamAt(params: compiler.arena.functionAt(index: leafFunction).params, index: 0U64).ty
    val environment = compiler.environmentWithCallableConstraints(fnIdx: index, environment: <InstanceEnvironment params=compiler.copyFuncBinds(binds: function.typeParams) args=[leaf] />, evidence: <CallableConstraintEvidence.Declaration />).unwrap()
    val concrete = match compiler.readAdmittedSignatureRoot(function: index, slot: <SourceSignatureSlot.Parameter index=0U64 />, environment: environment) {
        Result.Ok(value: val term) => term,
        Result.Err(error: val diagnostic) => { panic("parameterized concrete reader rejected: "+diagnostic.message()) },
    }
    val output = compiler.arena.typeAt(index: concrete)
    if output.assocNameId != 0U64 || output.nameId != compiler.internBytes(s: "U32").nameId { panic("concrete reader lost saved parent arity or output") }
}
