import ../../../src/Mid/AmbientEffects with { MidAmbientEffects }
import ../../../src/Mid/Build with { buildParametricMidBody, MidBuildError }
// Invalid semantic state is rejected without exiting the embedding process.
// Each failed Comp is discarded; this does not test recovery inside a request.
import ../../../src/Frontend with { Comp }
import ../../../src/Diag with { CompileDiagnostic }
import ../../../src/Ir with { Bind, Expr, Func, InstanceEnvironment, SyntheticCallSite, TraitDef, TypeRef }
import @Std/Io with { print }

fn expectDiagnostic[T](result: Result[T, CompileDiagnostic]) {
    match result {
        Result.Ok(value: _) => { panic("invalid semantic state was accepted") }
        Result.Err(error: val diagnostic) => { print(diagnostic.message) }
    }
}

fn missingShape() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "I64")
    val term = c.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    expectDiagnostic(result: c.collectedFinalReleaseEffect(typeRef: term, start: 0U64, needs: []))
}

fn duplicateOrigin() {
    mut val c: Comp = <Comp />
    val expression = c.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    val site = <SyntheticCallSite exprId=expression receiverTerm=0U64 />
    c.recordSyntheticCallSite(site: site).unwrap()
    match c.recordSyntheticCallSite(site: site) {
        Result.Ok(value: _) => { panic("duplicate origin was accepted") }
        Result.Err(error: val diagnostic) => { print(diagnostic.message) }
    }
}

fn conflictingSelf() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "Self")
    val trait = c.internBytes(s: "Producer")
    c.decls.registerTrait(<TraitDef nameStart=trait.nameStart nameLen=trait.nameLen nameId=trait.nameId selfParamId=81U64 />)
    val integer = c.internBytes(s: "I64")
    val string = c.internBytes(s: "String")
    val receiver = c.simpleTypeRef(nameStart: integer.nameStart, nameLen: integer.nameLen)
    val other = c.simpleTypeRef(nameStart: string.nameStart, nameLen: string.nameLen)
    val function = <Func nameStart=name.nameStart nameLen=name.nameLen
        typeParams=c.pushFuncBinds(binds: []) params=c.pushFuncParams(params: [])
        hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64
        hasRecv=true recvStart=trait.nameStart recvLen=trait.nameLen
        selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false
        isProvided=true provTraitOwner=trait.nameStart />
    val environment = <InstanceEnvironment
        params=[<Bind nameStart=name.nameStart nameLen=name.nameLen paramId=81U64 fieldStart=0U64 fieldLen=0U64 />]
        args=[other] receiverRef=receiver />
    expectDiagnostic(result: c.withLexicalSelfBinding(f: function, environment: environment))
}

fn missingRecordLayout() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "Record")
    val record = c.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true />)
    expectDiagnostic(result: c.arcClassOfRef(ref: record))
}

fn missingProtocolDependency() {
    mut val c: Comp = <Comp />
    c.pushExpr(e: <Expr.Int value=0U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    c.cur.bodyId = 1U64
    c.appendFinalCallee(exprId: 0U64, callee: 0U64, siteIsStmt: true, slot: 0U64, recvTypeRef: 0U64, resultTypeRef: 100U64).unwrap()
    val key = c.currentCallSiteKey(exprId: 0U64, siteIsStmt: true, slot: 1U64).unwrap()
    expectDiagnostic(result: c.bodyCalleeResultForTemplateDependency(exprId: 0U64, siteKey: key))
}

fn invalidOwnerFunction() -> Func {
    return <Func nameStart=0U64 nameLen=0U64 lexicalOwnerFnId=2U64 isProvided=true
        hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64
        hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false
        isAssoc=false isAsync=false isExtern=false />
}
fn missingLexicalOwner() {
    mut val c: Comp = <Comp />
    expectDiagnostic(result: c.lexicalFunction(f: invalidOwnerFunction()))
}
fn missingMidOwner() {
    mut val c: Comp = <Comp />
    c.arena.registerFunction(invalidOwnerFunction())
    val built = buildParametricMidBody(c: inout c, fnIdx: 0U64)
    match built.error {
        MidBuildError.Frontend(diagnostic: val diagnostic) => { print(diagnostic.message) }
        _ => { panic("Mid did not return the frontend ownership diagnostic") }
    }
}

fn missingFinalDestruction() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "I64")
    val term = c.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    expectDiagnostic(result: c.checkedFinalDestruction(typeRef: term))
}
fn missingAmbientDestruction() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "I64")
    val term = c.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    mut val effects = <MidAmbientEffects bodyCount=0U64 />
    match effects.destruction(c: inout c, owner: 0U64, type: term) {
        Result.Ok(value: _) => { panic("missing destruction was accepted by ambient analysis") }
        Result.Err(error: val diagnostic) => { print(diagnostic.message) }
    }
}

pub fn checkInvariantDiagnostics() {
    missingShape()
    duplicateOrigin()
    conflictingSelf()
    missingRecordLayout()
    missingProtocolDependency()
    missingLexicalOwner()
    missingMidOwner()
    missingFinalDestruction()
    missingAmbientDestruction()
    print("invariant diagnostics returned")
}
