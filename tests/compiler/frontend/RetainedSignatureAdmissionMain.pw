// The native driver calls this hook inside the real admission window, before
// the first signature sweep. Erasing an already-published receipt is not a valid
// Open setup: write-once associated admissions must reject that corruption.
mut val signatureAdmissionObserved: Bool = false
impl Comp {
    inout fn probeEarlySignatureAdmission() -> Result[(), CompileDiagnostic] {
        val function = self.arena.firstFunctionNamed(nameId: self.internBytes(s: "entry").nameId)
        if function >= self.arena.functionCount() || self.authoredSignatureViews.contains(key: function) { return <Result.Ok value=() /> }
        val declaration = self.arena.functionAt(index: function)
        val binder = self.funcBindAt(binds: declaration.typeParams, index: 0U64)
        val symbolic = self.pushType(t: <TypeRef nameStart=binder.nameStart nameLen=binder.nameLen nameId=binder.nameId paramId=binder.paramId args=[] />)
        val environment = <InstanceEnvironment params=self.copyFuncBinds(binds: declaration.typeParams) args=[symbolic] />
        val patterns = try self.callableParameterPatterns(function: function)
        if patterns.count() == 0U64 || self.arena.typeAt(index: patterns[0U64]).assocTraitId != self.internBytes(s: "Parent").nameId { panic("open pattern read did not admit its source signature") }
        val result = try self.readRetainedCallableTypes(function: function, environment: environment, read: <CallableSignatureRead.SourceParameters />)
        if result.isNone() || !self.authoredSignatureViews.contains(key: function) { panic("open admission did not publish its source signature") }
        val parameter = self.arena.typeAt(index: result.unwrap().parameterTypes[0U64])
        if parameter.assocTraitId != self.internBytes(s: "Parent").nameId { panic("early signature construction lost its saved declaring parent") }
        signatureAdmissionObserved = true
        return <Result.Ok value=() />
    }
}
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/ProjectionMembers/Inherited.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("admission setup: "+diagnostic.message()) }
    }
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "entry").nameId)
    val declaration = compiler.arena.functionAt(index: function)
    val leafFunction = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "leaf").nameId)
    val leaf = compiler.funcParamAt(params: compiler.arena.functionAt(index: leafFunction).params, index: 0U64).ty
    val environment = <InstanceEnvironment params=compiler.copyFuncBinds(binds: declaration.typeParams) args=[leaf] />
    if !signatureAdmissionObserved { panic("early source signature construction was not exercised") }
    val completed = match compiler.readRetainedCallableTypes(function: function, environment: environment, read: <CallableSignatureRead.SourceParameters />) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("completed admission: "+diagnostic.message()) }
    }
    if completed.isNone() { panic("completed signature admission lost its registered source") }
    compiler.authoredSignatureViews.remove(key: function)
    compiler.authoredSignatureAdmission = <AuthoredSignatureAdmissionPhase.Complete />
    match compiler.readRetainedCallableTypes(function: function, environment: environment, read: <CallableSignatureRead.SourceResult />) {
        Result.Ok(value: _) => { panic("completed admission accepted a lost receipt") }
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain() { FailureDomain.Internal => {} _ => { panic("lost receipt acquired Source authority") } }
        }
    }
    match compiler.callableParameterPatterns(function: function) {
        Result.Ok(value: _) => { panic("completed pattern read accepted a lost receipt") }
        Result.Err(error: val diagnostic) => { match diagnostic.failureDomain() { FailureDomain.Internal => {} _ => { panic("missing pattern receipt acquired Source authority") } } }
    }
    val held = compiler.diagnosticAt(offset: declaration.nameStart, msg: "retained signature admission sentinel", failureDomain: <FailureDomain.Internal />)
    compiler.authoredSignatureAdmission = <AuthoredSignatureAdmissionPhase.Failed diagnostic=held />
    match compiler.readRetainedCallableTypes(function: function, environment: environment, read: <CallableSignatureRead.SourceResult />) {
        Result.Ok(value: _) => { panic("failed admission produced a result") }
        Result.Err(error: val diagnostic) => { if diagnostic.message() != held.message() { panic("failed admission replaced the original diagnostic") } }
    }
    match compiler.callableParameterPatterns(function: function) {
        Result.Ok(value: _) => { panic("failed admission produced a pattern") }
        Result.Err(error: val diagnostic) => { if diagnostic.message() != held.message() { panic("pattern read replaced the original admission failure") } }
    }
    compiler.authoredSignatureAdmission = <AuthoredSignatureAdmissionPhase.Complete />
    val mainIndex = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "main").nameId)
    val raw = compiler.arena.functionCount()
    compiler.arena.registerFunction(compiler.arena.functionAt(index: mainIndex), registerSurface: false)
    val rawRead = match compiler.readRetainedCallableTypes(function: raw, environment: <InstanceEnvironment />, read: <CallableSignatureRead.SourceResult />) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("Raw admission: "+diagnostic.message()) }
    }
    if rawRead.isSome() || compiler.authoredSignatureViews.contains(key: raw) || compiler.sourceTypeUses.signatureFor(function: raw).isSome() { panic("Raw registration acquired Source signature authority") }
    if compiler.callableParameterPatterns(function: raw).unwrap().count() != 0U64 || compiler.authoredSignatureViews.contains(key: raw) { panic("Raw pattern read acquired Source signature authority") }
}
