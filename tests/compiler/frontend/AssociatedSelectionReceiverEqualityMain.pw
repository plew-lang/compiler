// Independent source equations must be prepared before saving the decision.
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/ProjectionMembers/ReceiverEqualityScope.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("equation-scope admission rejected: "+diagnostic.message()) }
    }
    val index = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "entry").nameId)
    val function = compiler.arena.functionAt(index: index)
    val parameter = compiler.funcParamAt(params: function.params, index: 0U64)
    val saved = compiler.retainedAssociatedSelection(occurrence: parameter.authoredTypeUse, ref: parameter.ty).unwrap().unwrap()
    val binding = compiler.associatedSelectionOccurrences.get(key: parameter.authoredTypeUse).unwrap()
    val draft = compiler.loweredAssociatedSelections[binding.selection-1U64]
    val query = match draft.resolution { LoweredAssociatedResolution.Query(result: val result) => result _ => { panic("expected query draft") } }
    if query.graph.equationContext.count() != query.graph.roots.count()+draft.equationClauses.count() { panic("equation context lost its source-clause mapping") }
    for index in 0U64..<draft.equationClauses.count() {
        val clause = draft.equationClauses[index]
        if clause == 0U64 || clause > compiler.projectionBoundClauses.count() { panic("equation source clause is foreign") }
        val prepared = match compiler.projectionBoundClauses[clause-1U64].state { ProjectionBoundState.Ready(bound: val bound) => bound _ => { panic("equation source is not prepared") } }
        val context = query.graph.equationContext[query.graph.roots.count()+index]
        if context.subject != prepared.subject || !compiler.sameTraitConstraint(a: context.constraint, b: prepared.constraint) { panic("equation source mapping was reconstructed from another premise") }
    }
    match saved.outcome {
        AssociatedMemberOutcome.Unique(candidate: val candidate) => {
            if candidate.instance.positionalArgs.count() != 1U64 || saved.graph.equations.count() == 0U64 { panic("source equation did not justify instance deduplication") }
        }
        _ => { panic("source query was saved before required equations were ready") }
    }
}
