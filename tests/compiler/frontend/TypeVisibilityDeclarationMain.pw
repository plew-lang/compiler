// A later origin enum cannot turn a Raw caller's Comp into an owned declaration.
fn main() {
    // Raw recipe creation may leave holes before private Lower registration.
    mut val sparse = <Comp />
    sparse.recordLowerTypeRecipe(id: 2U64, term: 7U64, occurrence: 0U64, children: [], origin: <SourceTypeRecipeOrigin.ProjectionReceiver />, sourceRecipe: 0U64)
    sparse.recordLowerTypeRecipe(id: 4U64, term: 9U64, occurrence: 0U64, children: [], origin: <SourceTypeRecipeOrigin.ProjectionReceiver />, sourceRecipe: 0U64)
    if sparse.authoredTypeRecipeNode(id: 2U64).unwrap().term != 7U64 || sparse.authoredTypeRecipeNode(id: 4U64).unwrap().term != 9U64 { panic("sparse recipe lookup lost exact identity") }
    for absent in [0U64, 1U64, 3U64, 5U64] { if sparse.authoredTypeRecipeNode(id: absent).isSome() { panic("recipe index lent another ID its receipt") } }
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/fixtures/reject/private_extern_generic_type_not_ambient.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Err(error: _) => {}
        Result.Ok(value: _) => { panic("expected actual missing-import rejection") }
    }
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "takes").nameId)
    val occurrence = compiler.funcParamAt(params: compiler.arena.functionAt(index: function).params, index: 0U64).authoredTypeUse
    val result = compiler.checkSourceTypeUsesForAdmission(occurrences: [occurrence], origin: <FrontendDeclarationOrigin.SourceAdmission />)
    val diagnostic = match result { Result.Err(error: val diagnostic) => diagnostic Result.Ok(value: _) => { panic("missing import became success") } }
    if compiler.sourceFailureHasOwner(diagnostic: diagnostic) { panic("Raw Comp acquired declaration authority from enum") }

    if compiler.beginSourceTypeDeclarationConstruction(origin: <FrontendDeclarationOrigin.SourceAdmission />).isOk() { panic("Raw state reentered a fresh constructor") }
    mut val owned = <Comp />
    val failure = match analyzeFrontendDeclarationsWithOrigin(c: inout owned, input: <FrontendInput.File path="tests/fixtures/reject/private_extern_generic_type_not_ambient.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />, options: <FrontendOptions />, origin: <FrontendDeclarationOrigin.SourceAdmission />) {
        Result.Err(error: val diagnostic) => diagnostic
        Result.Ok(value: _) => { panic("owned invalid declaration accepted") }
    }
    if !owned.sourceFailureHasOwner(diagnostic: failure) || failure.typeVisibility().isNone() { panic("owned constructor lost negative event") }
    if !ownedFrontendFailure(c: owned, diagnostic: failure).isSourceRejection() { panic("owning adapter lost source domain") }
    val refusal = failure.typeVisibility().unwrap()
    val proof = owned.failedTypeVisibility[refusal.event()].evidence.declaration.unwrap()
    val root = owned.authoredTypeDeclarationRoots[proof.root]
    for wrong in 0U64..<4U64 {
        val forged = <TypeVisibilityRefusal session=if wrong == 0U64 { give refusal.session()+1U64 } else { give refusal.session() } occurrence=if wrong == 1U64 { give 0U64 } else { give refusal.occurrence() } event=if wrong == 2U64 { give owned.failedTypeVisibility.count() } else { give refusal.event() } location=if wrong == 3U64 { give <DiagnosticLocation.Unpositioned /> } else { give refusal.location() } />
        if owned.sourceFailureHasOwner(diagnostic: <CompileDiagnostic.typeVisibility refusal=forged />) { panic("forged declaration event acquired Source") }
    }
    val target = owned.arena.firstFunctionNamed(nameId: owned.internBytes(s: "takes").nameId)
    val slot = owned.arena.functionAt(index: target).params.start
    val original = owned.decls.funcParamPool[slot]
    mut val other = 0U64
    while owned.decls.funcParamPool[other].authoredTypeUse == original.authoredTypeUse { other += 1U64 }
    owned.decls.funcParamPool[slot] = owned.decls.funcParamPool[other]
    if owned.sourceFailureHasOwner(diagnostic: failure) { panic("detached declaration parameter retained Source") }
    match owned.checkSourceTypeUsesForAdmission(occurrences: [refusal.occurrence()], origin: <FrontendDeclarationOrigin.SourceAdmission />) {
        Result.Err(error: val rejected) => { if owned.sourceFailureHasOwner(diagnostic: rejected) || rejected.typeVisibility().isSome() { panic("malformed declaration minted a new refusal") } }
        Result.Ok(value: _) => { panic("malformed declaration became success") }
    }
    owned.decls.funcParamPool[slot] = original
    if !owned.sourceFailureHasOwner(diagnostic: failure) { panic("restored declaration lost Source") }
    val node = owned.authoredTypeRecipeNode(id: root.recipe).unwrap()
    if node.count == 0U64 { panic("generic source root lost child recipe") }
    val child = owned.authoredTypeRecipeEdges[node.first]
    owned.authoredTypeRecipeEdges[node.first] = root.recipe
    if owned.sourceFailureHasOwner(diagnostic: failure) { panic("changed recipe edge retained Source") }
    match owned.checkSourceTypeUsesForAdmission(occurrences: [refusal.occurrence()], origin: <FrontendDeclarationOrigin.SourceAdmission />) {
        Result.Err(error: val rejected) => { if owned.sourceFailureHasOwner(diagnostic: rejected) || rejected.typeVisibility().isSome() { panic("malformed declaration minted a new refusal") } }
        Result.Ok(value: _) => { panic("malformed declaration became success") }
    }
    owned.authoredTypeRecipeEdges[node.first] = child
    if !owned.sourceFailureHasOwner(diagnostic: failure) { panic("restored recipe edge lost Source") }
}
