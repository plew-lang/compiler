// Exercise the embedding entry without reading this process's argv or stdin.
use ../../../src/Frontend only { Comp, FrontendInput, FrontendOptions, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/PreparedProgram only { PreparedProgram }
use ../../../src/CompilerDiagnostics only { reportProgramPreparationError }
use ./InvariantDiagnostics only { checkInvariantDiagnostics }
use @Std/Io only { print }

fn checkSource(path: String, asan: Bool) {
    mut val compiler: Comp = <Comp />
    val analysis = analyzeFrontend(c: inout compiler,
        input: <FrontendInput.Text text="fn main() {{}}" path=path />,
        sources: <SourceAccess />, options: <FrontendOptions asan=asan />)
    match analysis {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
    match PreparedProgram.prepare(c: inout compiler) {
        Result.Ok(value: _) => {}
        Result.Err(error: val error) => { reportProgramPreparationError(c: inout compiler, error: error) }
    }
    print(compiler.modules.sourceFilePath(index: 0U64))
    print(compiler.asan == asan)
}

fn main() {
    mut val missing: Comp = <Comp />
    match analyzeFrontend(c: inout missing,
        input: <FrontendInput.File path="/nonexistent/plew-input-test.pw" />,
        sources: <SourceAccess />) {
        Result.Ok(value: _) => { panic("missing input was accepted") }
        Result.Err(error: val diagnostic) => { print(diagnostic.message) }
    }
    checkSource(path: "First.pw", asan: false)
    checkSource(path: "Second.pw", asan: true)
    checkInvariantDiagnostics()
}
