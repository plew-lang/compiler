// An observation cache is not a completed source selection or failed frontier.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { Expr, CachedCallee }
use ../../../src/Diag only { FailureDomain }
use @Std/Io only { print }
fn checkCache(selected: Bool) {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text path="Cache.pw" text="struct Marker {{}}\nimpl Marker {{ fn accept(value: I64) {{}} }}\nfn main() {{ <Marker />.accept(value: 1I64) }}" />, sources: <SourceAccess stdRoot="std/".bytes() />).unwrap()
    val name = compiler.internBytes(s: "main")
    val owner = compiler.arena.firstFunctionNamed(nameId: name.nameId)
    for index in 0U64..<compiler.arena.exprs.count() {
        match compiler.arena.exprs[index] {
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                compiler.typeCache.callee[index] = if selected { give <CachedCallee.Selected callee=compiler.arena.functionCount() + 1U64 /> } else { give <CachedCallee.NoStaticCallee /> }
            }
            _ => {}
        }
    }
    for retry in 0U64..<2U64 {
        match compiler.prepareLexicalBody(fnIdx: owner) {
            Result.Ok(value: _) => { panic("observation cache was reopened as source selection") }
            Result.Err(error: val error) => {
                match error.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("observation cache minted source failure authority") } }
            }
        }
    }
}
fn main() {
    checkCache(selected: false)
    checkCache(selected: true)
    print("member observation caches do not confer source selection authority")
}
