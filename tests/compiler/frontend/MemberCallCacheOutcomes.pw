// An observation cache is not a completed source selection or failed frontier.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { Expr, CachedCallee }
use ../../../src/Diag only { FailureDomain }
use @Std/Io only { print }
fn checkCache(selected: Bool, kind: U64) {
    mut val compiler = <Comp />
    val text = if kind == 0U64 {
        give "struct Marker {{}}\nimpl Marker {{ fn accept(value: I64) -> Bool {{ return true }} }}\nfn main() {{ <Marker />.accept(value: 1I64) }}"
    } else if kind == 1U64 {
        give "struct Marker {{}}\nimpl Marker {{ assoc fn accept(value: I64) -> Bool {{ return true }} }}\nfn main() {{ Marker.accept(value: 1I64) }}"
    } else if kind == 2U64 {
        give "struct Marker {{}}\nextension Extra {{ impl Marker {{ fn accept(value: I64) -> Bool {{ return true }} }} }}\nfn main() {{ <Marker />#Extra.accept(value: 1I64) }}"
    } else {
        give "fn main() {{ [1I64].count() }}"
    }
    val input = if kind == 3U64 { give <FrontendInput.File path="tests/fixtures/run/array_method_observation_context.pw" /> }
    else { give <FrontendInput.Text path="Cache.pw" text=text /> }
    match analyzeFrontendForRequests(c: inout compiler, input: input, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val error) => { panic(error.message()) }
    }
    val name = compiler.internBytes(s: "main")
    val owner = compiler.arena.firstFunctionNamed(nameId: name.nameId)
    val module = compiler.moduleOf(offset: compiler.arena.functionAt(index: owner).defOffset)
    for index in 0U64..<compiler.arena.exprs.count() {
        if compiler.moduleOf(offset: compiler.exprOffset(id: index)) != module { continue }
        match compiler.arena.exprs[index] {
            Expr.Method(recv: val receiver, nameStart: _, nameLen: _, args: _) |
            Expr.ExtMethod(recv: val receiver, source: _, nameStart: _, nameLen: _, args: _) => {
                if kind == 3U64 {
                    // An Array literal has no receiver type before Record.
                    // Prepare the operand only, not the call being probed.
                    compiler.cur.checkFn = owner
                    match compiler.recordExpr(exprId: receiver) {
                        Result.Ok(value: _) => {}
                        Result.Err(error: val error) => { panic(error.message()) }
                    }
                }
                compiler.typeCache.callee[index] = if selected { give <CachedCallee.Selected callee=compiler.arena.functionCount() + 1U64 /> } else { give <CachedCallee.NoStaticCallee /> }
                match compiler.exprType(id: index) {
                    Result.Ok(value: val result) => {
                        if selected {
                            if kind == 3U64 { panic("array result query ignored an out-of-range callee cache") }
                            panic("method result query ignored an out-of-range callee cache")
                        }
                        if result.ref != 0U64 || result.nameLen != 0U64 { panic("observation cache produced a method result") }
                    }
                    Result.Err(error: _) => { if !selected { panic("nonstatic observation failed during type recovery") } }
                }
            }
            _ => {}
        }
    }
    for retry in 0U64..<2U64 {
        match compiler.prepareLexicalBody(fnIdx: owner) {
            Result.Ok(value: _) => { if kind == 0U64 { panic("bare observation cache was reopened as source selection") }
                else if kind == 1U64 { panic("associated observation cache was reopened as source selection") }
                else { panic("view observation cache was reopened as source selection") } }
            Result.Err(error: val error) => {
                match error.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("observation cache minted source failure authority") } }
            }
        }
    }
}
fn checkChainCache() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text path="Chain.pw" text="struct Marker {{}}\nimpl Marker {{ fn accept(value: I64) -> Bool {{ return true }} }}\nfn main() {{ val marker = <Optional.Some v=<Marker /> /> marker?.accept(value: 1I64) }}" />, sources: <SourceAccess stdRoot="std/".bytes() />).unwrap()
    val name = compiler.internBytes(s: "accept")
    val method = compiler.arena.firstFunctionNamed(nameId: name.nameId)
    val receiver = compiler.arena.functionAt(index: method).recvTy
    if receiver == 0U64 { panic("chain fixture has no receiver") }
    val mainName = compiler.internBytes(s: "main")
    val owner = compiler.arena.firstFunctionNamed(nameId: mainName.nameId)
    val module = compiler.moduleOf(offset: compiler.arena.functionAt(index: owner).defOffset)
    mut val seen = false
    for index in 0U64..<compiler.arena.exprs.count() {
        if compiler.moduleOf(offset: compiler.exprOffset(id: index)) != module { continue }
        match compiler.arena.exprs[index] {
            Expr.Method(recv: val base, nameStart: _, nameLen: _, args: _) => {
                match compiler.arena.exprs[base] { Expr.ChainHole => {} _ => { continue } }
                seen = true
                compiler.typeCache.callee[index] = <CachedCallee.NoStaticCallee />
                val result = compiler.exprTypeWithChainHole(id: index, chainHoleRef: receiver).unwrap()
                if result.ref != 0U64 || result.nameLen != 0U64 { panic("chain continuation reopened an observation cache") }
            }
            _ => {}
        }
    }
    if !seen { panic("missing chain continuation") }
}
fn checkIndependentDispatch(abstract: Bool) {
    mut val compiler = <Comp />
    val text = if abstract {
        give "trait Named {{ fn name() -> I64 }}\nfn probe[T](value: T) -> I64 where T: Named {{ return value.name() }}\nfn main() {{}}"
    } else {
        give "struct Holder {{ val action: fn() -> I64 }}\nfn probe() -> I64 {{ return <Holder action=fn() -> I64 {{ return 7I64 }} />.action() }}\nfn main() {{}}"
    }
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text path="Independent.pw" text=text />, sources: <SourceAccess stdRoot="std/".bytes() />).unwrap()
    val name = compiler.internBytes(s: "probe")
    val owner = compiler.arena.firstFunctionNamed(nameId: name.nameId)
    val module = compiler.moduleOf(offset: compiler.arena.functionAt(index: owner).defOffset)
    mut val seen = false
    for index in 0U64..<compiler.arena.exprs.count() {
        if compiler.moduleOf(offset: compiler.exprOffset(id: index)) != module { continue }
        match compiler.arena.exprs[index] {
            Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {
                seen = true
                compiler.typeCache.callee[index] = <CachedCallee.NoStaticCallee />
            }
            _ => {}
        }
    }
    if !seen { panic("missing independent dispatch") }
    compiler.prepareLexicalBody(fnIdx: owner).unwrap()
    if compiler.callTemplateCount() == 0U64 { panic("independent dispatch lost its selected template") }
}

fn main() {
    checkIndependentDispatch(abstract: false)
    checkIndependentDispatch(abstract: true)
    checkChainCache()
    for kind in 0U64..<4U64 {
        checkCache(selected: false, kind: kind)
        checkCache(selected: true, kind: kind)
    }
    print("member observation caches do not confer source selection authority")
}
