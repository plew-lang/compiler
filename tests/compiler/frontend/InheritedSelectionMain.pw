// Append to a frozen Frontend module; exercise actual Source admission.
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/ProjectionMembers/Inherited.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("Source inherited admission rejected: "+diagnostic.message()) }
    }
    val index = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "entry").nameId)
    val function = compiler.arena.functionAt(index: index)
    val parameter = compiler.funcParamAt(params: function.params, index: 0U64)
    val source = compiler.arena.typeAt(index: parameter.ty)
    if source.assocTraitId != compiler.internBytes(s: "Child").nameId { panic("authored term was overwritten during semantic publication") }
    val admitted = compiler.lexicalBodyParameterType(function: index, index: 0U64, ref: parameter.ty, receiver: 0U64).unwrap()
    if admitted.isNone() { panic("admitted abstract projection did not publish its declaring trait") }
    val projection = compiler.arena.typeAt(index: admitted.unwrap())
    val parent = compiler.internBytes(s: "Parent").nameId
    if projection.assocTraitId != parent || projection.assocNameId != compiler.internBytes(s: "Output").nameId { panic("Source projection did not publish its actual declaring trait") }
    val leafFunction = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "leaf").nameId)
    val leaf = compiler.funcParamAt(params: compiler.arena.functionAt(index: leafFunction).params, index: 0U64).ty
    val environment = compiler.environmentWithCallableConstraints(fnIdx: index, environment: <InstanceEnvironment params=compiler.copyFuncBinds(binds: function.typeParams) args=[leaf] />, evidence: <CallableConstraintEvidence.Declaration />).unwrap()
    val concrete = match compiler.readAdmittedSignatureRoot(function: index, slot: <SourceSignatureSlot.Parameter index=0U64 />, environment: environment) {
        Result.Ok(value: val term) => term,
        Result.Err(error: val diagnostic) => { panic("concrete retained reader rejected: "+diagnostic.message()) },
    }
    val output = compiler.arena.typeAt(index: concrete)
    if output.assocNameId != 0U64 || output.nameId != compiler.internBytes(s: "I64").nameId { panic("concrete reader did not use the saved Parent output") }

    val boxedIndex = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "boxed").nameId)
    val boxed = compiler.arena.functionAt(index: boxedIndex)
    val boxedParameter = compiler.funcParamAt(params: boxed.params, index: 0U64)
    val abstractArray = compiler.lexicalBodyParameterType(function: boxedIndex, index: 0U64, ref: boxedParameter.ty, receiver: 0U64).unwrap().unwrap()
    val abstractElement = compiler.arena.typeAt(index: compiler.arena.typeAt(index: abstractArray).args[0U64])
    if abstractElement.assocTraitId != parent { panic("nested constructor did not consume its child's saved declaring instance") }
    val boxedEnvironment = compiler.environmentWithCallableConstraints(fnIdx: boxedIndex, environment: <InstanceEnvironment params=compiler.copyFuncBinds(binds: boxed.typeParams) args=[leaf] />, evidence: <CallableConstraintEvidence.Declaration />).unwrap()
    val concreteArray = compiler.readAdmittedSignatureRoot(function: boxedIndex, slot: <SourceSignatureSlot.Parameter index=0U64 />, environment: boxedEnvironment).unwrap()
    val element = compiler.arena.typeAt(index: compiler.arena.typeAt(index: concreteArray).args[0U64])
    if element.assocNameId != 0U64 || element.nameId != compiler.internBytes(s: "I64").nameId { panic("nested constructor did not consume concrete Parent output") }

    val returningIndex = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "returning").nameId)
    val returning = compiler.arena.functionAt(index: returningIndex)
    val returningParameter = compiler.funcParamAt(params: returning.params, index: 0U64)
    val parameterTerm = compiler.lexicalBodyParameterType(function: returningIndex, index: 0U64, ref: returningParameter.ty, receiver: 0U64).unwrap().unwrap()
    val resultTerm = compiler.semanticBodyReturnContext(fnIdx: returningIndex).unwrap()
    if !compiler.typeRefEq(a: parameterTerm, b: resultTerm) { panic("body result did not consume the same admitted declaring instance as its parameter") }

    for name in ["returningArray", "returningAsync"] {
        val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: name).nameId)
        val declaration = compiler.arena.functionAt(index: owner)
        val parameter = compiler.funcParamAt(params: declaration.params, index: 0U64)
        val term = compiler.lexicalBodyParameterType(function: owner, index: 0U64, ref: parameter.ty, receiver: 0U64).unwrap().unwrap()
        if !compiler.typeRefEq(a: term, b: compiler.semanticBodyReturnContext(fnIdx: owner).unwrap()) { panic("logical result lost a nested admitted projection or unwrapped Promise incorrectly") }
    }

    val producer = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "produce").nameId)
    val producerFunction = compiler.arena.functionAt(index: producer)
    val producerEnvironment = <InstanceEnvironment params=compiler.copyFuncBinds(binds: producerFunction.typeParams) args=[leaf] />
    val selectedResult = match compiler.selectedCallableSourceResult(callee: producer, environment: producerEnvironment) {
        Result.Ok(value: val result) => result.term,
        Result.Err(error: val diagnostic) => { panic("selected free result reader failed: "+diagnostic.message()) }
    }
    if compiler.arena.typeAt(index: selectedResult).nameId != compiler.internBytes(s: "I64").nameId { panic("selected free result reader lost concrete output") }
    val caller = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "caller").nameId)
    val callerOwner = <SemanticCompletionOwner.Function index=caller />
    if !compiler.sourceFacts.begin(owner: callerOwner) { panic("caller source facts were not fresh") }
    match compiler.recordParametricFunctionWithOrigin(fnIdx: caller, recordCallTemplates: true, origin: <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=callerOwner /> returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("free call failed to read its admitted result: "+diagnostic.message()) }
    }
    match compiler.checkSourceTypingObligationsWithOrigin(owner: callerOwner, origin: <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=callerOwner />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("free call source verification lost admitted signature: "+diagnostic.message()) }
    }

    val propagating = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "propagating").nameId)
    val propagationOwner = <SemanticCompletionOwner.Function index=propagating />
    if !compiler.sourceFacts.begin(owner: propagationOwner) { panic("propagation facts were not fresh") }
    match compiler.recordParametricFunctionWithOrigin(fnIdx: propagating, recordCallTemplates: true, origin: <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=propagationOwner /> returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("try failed to consume its admitted logical result: "+diagnostic.message()) }
    }
    if compiler.sourceFacts.activeBuilder.data.tries.count() != 1U64 { panic("propagation case did not record try") }
    val propagation = compiler.sourceFacts.activeBuilder.data.tries[0U64]
    if !compiler.typeRefEq(a: propagation.sourceErrorTerm, b: propagation.targetErrorTerm) { panic("try changed identical admitted associated error types") }
    compiler.checkSourceTypingObligationsWithOrigin(owner: propagationOwner, origin: <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=propagationOwner />).unwrap()

    val methodCaller = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "methodCaller").nameId)
    val methodOwner = <SemanticCompletionOwner.Function index=methodCaller />
    if !compiler.sourceFacts.begin(owner: methodOwner) { panic("method caller facts were not fresh") }
    match compiler.recordParametricFunctionWithOrigin(fnIdx: methodCaller, recordCallTemplates: true, origin: <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=methodOwner /> returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("method call lost admitted signature: "+diagnostic.message()) }
    }
    compiler.checkSourceTypingObligationsWithOrigin(owner: methodOwner, origin: <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=methodOwner />).unwrap()

    val closureCaller = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "closureMethodCaller").nameId)
    val closureOwner = <SemanticCompletionOwner.Function index=closureCaller />
    if !compiler.sourceFacts.begin(owner: closureOwner) { panic("contextual closure caller facts were not fresh") }
    match compiler.recordParametricFunctionWithOrigin(fnIdx: closureCaller, recordCallTemplates: true, origin: <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=closureOwner /> returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("one method environment lost contextual closure inference: "+diagnostic.message()) }
    }
    compiler.checkSourceTypingObligationsWithOrigin(owner: closureOwner, origin: <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=closureOwner />).unwrap()

    val wrongCaller = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "wrongCaller").nameId)
    val wrongOwner = <SemanticCompletionOwner.Function index=wrongCaller />
    if !compiler.sourceFacts.begin(owner: wrongOwner) { panic("negative caller facts were not fresh") }
    match compiler.recordParametricFunctionWithOrigin(fnIdx: wrongCaller, recordCallTemplates: true, origin: <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=wrongOwner /> returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Err(error: val diagnostic) => {
            if diagnostic.message() != "type mismatch: this value's type does not match the type required here (Plew has no implicit conversion — spec/12)" { panic("wrong argument did not reach semantic type mismatch: "+diagnostic.message()) }
        }
        Result.Ok(value: _) => { panic("wrong argument passed admitted parameter checking") }
    }

    val wrongMethodCaller = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "wrongMethodCaller").nameId)
    val wrongMethodOwner = <SemanticCompletionOwner.Function index=wrongMethodCaller />
    if !compiler.sourceFacts.begin(owner: wrongMethodOwner) { panic("negative method caller facts were not fresh") }
    match compiler.recordParametricFunctionWithOrigin(fnIdx: wrongMethodCaller, recordCallTemplates: true, origin: <SourceRecordingScope request=<SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=wrongMethodOwner /> returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Err(error: val diagnostic) => {
            if diagnostic.message() != "type mismatch: this value's type does not match the type required here (Plew has no implicit conversion — spec/12)" { panic("wrong method argument did not reach semantic mismatch: "+diagnostic.message()) }
        }
        Result.Ok(value: _) => { panic("wrong method argument passed admitted parameter checking") }
    }

}
