use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, openFrontend }
use ../../../src/CheckedProgram only { CompilerSession, CompilerSessionResult, ProgramCheckResult, checkCompilerSession }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Diag only { CompileDiagnostic, FailureDomain }
use @Std/Io only { print }

fn input(kind: U64) -> FrontendInput {
    if kind == 0U64 { return <FrontendInput.Text path="caller_argument.pw" text="fn same[T](first: T, second: T) {{}}\nfn callSame[T](value: T) {{ same(first: 5, second: value) }}\nfn main() {{ callSame(value: 6I64) }}\n" /> }
    if kind == 1U64 { return <FrontendInput.Text path="caller_let.pw" text="fn check[T](seed: T) {{ val value: T = 5 }}\nfn main() {{ check(seed: 1I64) }}\n" /> }
    if kind == 2U64 { return <FrontendInput.Text path="caller_float.pw" text="fn check[T](seed: T) {{ val value: T = 1.5 }}\nfn main() {{ check(seed: 1I64) }}\n" /> }
    if kind == 3U64 { return <FrontendInput.Text path="provided_self.pw" text="trait Literal {{}}\nimpl Literal {{ fn bad() {{ val value: Self = 5 }} }}\nfn main() {{}}\n" /> }
    if kind == 4U64 { return <FrontendInput.Text path="provided_float.pw" text="trait Literal {{}}\nimpl Literal {{ fn bad() -> Self {{ return 1.5 }} }}\nfn main() {{}}\n" /> }
    panic("invalid test kind")
}

fn requireOpaque(diagnostic: CompileDiagnostic, owned: Bool = true) {
    if diagnostic.message() != "cannot assign a literal to a type parameter: it is an opaque type with no numeric bound (spec/06)" { panic(diagnostic.message()) }
    if diagnostic.isSourceRejection() != owned { panic("opaque numeric rejection lost its required ownership boundary") }
    if !owned { match diagnostic.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("Raw opaque failure domain changed") } } }
}

fn session(kind: U64) -> CompilerSession {
    match CompilerSession.open(input: input(kind: kind), sources: <SourceAccess />) {
        CompilerSessionResult.Success(session: val session) => { return move session }
        CompilerSessionResult.Failure(diagnostic: val diagnostic) => { panic(diagnostic.message()) }
    }
}

fn main() {
    for kind in 0U64..<5U64 {
        mut val raw = <Comp />
        analyzeFrontendForRequests(c: inout raw, input: input(kind: kind), sources: <SourceAccess />).unwrap()
        val name = raw.internBytes(s: if kind == 0U64 { give "callSame" } else if kind < 3U64 { give "check" } else { give "bad" })
        val function = raw.arena.firstFunctionNamed(nameId: name.nameId)
        for attempt in 0U64..<2U64 {
            match raw.prepareLexicalBody(fnIdx: function) {
                Result.Err(error: val diagnostic) => { requireOpaque(diagnostic: diagnostic, owned: false) raw.pendingDiagnostics.append(diagnostic) }
                Result.Ok(value: _) => { panic("Raw body request accepted opaque numeric value") }
            }
            if raw.takeDiagnostics().count() != 1U64 { panic("drain lost retained opaque rejection") }
        }
        print("raw opaque rejection retained")
        if kind < 3U64 {
            mut val owned = session(kind: kind)
            for attempt in 0U64..<2U64 {
                // Both instances admit the same immutable declarations. The
                // source function ID is obtained before any body is requested.
                match owned.prepareFunction(function: function) {
                    Result.Err(error: val diagnostic) => { requireOpaque(diagnostic: diagnostic) }
                    Result.Ok(value: _) => { panic("failed lazy function request published success") }
                }
            }
            match checkCompilerSession(session: move owned) {
                ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireOpaque(diagnostic: diagnostic) }
                ProgramCheckResult.Success(program: _) => { panic("failed lazy session published a checked program") }
            }
            print("lazy opaque rejection retained")
        }
        match checkCompilerSession(session: session(kind: kind)) {
            ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireOpaque(diagnostic: diagnostic) }
            ProgramCheckResult.Success(program: _) => { panic("whole check accepted opaque numeric value") }
        }
        print("whole opaque rejection retained")
        match openFrontend(input: input(kind: kind), sources: <SourceAccess />) {
            Result.Err(error: val diagnostic) => { requireOpaque(diagnostic: diagnostic) }
            Result.Ok(value: _) => { panic("eager check accepted opaque numeric value") }
        }
        print("eager opaque rejection retained")
    }
}
