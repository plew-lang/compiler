// Manual internal regression for com-zdod. Exercise the production semantic
// selector, publication, equality and traversal; source syntax is a later task.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { TypeRef, ResolvedViewSource, TraitInstanceKey, Bind, PatternBindInput, WitnessBind, WitnessMatch, InstanceEnvironment, PatternTypeInput }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn main() {
    val scenario = argAt(1I64)
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text="trait P[K] {{ type Item }} trait Q[K] {{}} struct S {{}} impl S as P[I64] {{ type Item=Bool }} fn main() {{}}" path="SemanticViews.pw" />, sources: <SourceAccess />).unwrap()
    val traitName = compiler.internBytes(s: "P")
    val owner = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: traitName.nameId))
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
    val booleanName = compiler.internBytes(s: "Bool")
    val boolean = compiler.pushType(t: <TypeRef nameStart=booleanName.nameStart nameLen=booleanName.nameLen args=[] />)
    val integerSource = <ResolvedViewSource surfaceId=traitName.nameId traitInstance=<TraitInstanceKey owner=owner.nameStart positionalArgs=[integer] /> />
    val otherSource = <ResolvedViewSource surfaceId=traitName.nameId traitInstance=<TraitInstanceKey owner=owner.nameStart positionalArgs=[boolean] /> />
    val useSource = <ResolvedViewSource writtenStart=integerName.nameStart writtenLen=integerName.nameLen surfaceId=traitName.nameId traitInstance=<TraitInstanceKey owner=owner.nameStart positionalArgs=[integer] /> />
    if scenario == "differentArguments" {
        print(!compiler.semanticViewSourceEq(a: integerSource, b: otherSource))
        return
    }
    if scenario == "useProvenance" {
        print(compiler.semanticViewSourceEq(a: integerSource, b: useSource))
        return
    }
    val structName = compiler.internBytes(s: "S")
    val declaration = compiler.arena.structAt(index: compiler.arena.firstStructNamed(nameId: structName.nameId))
    val parameterName = compiler.internBytes(s: "T")
    val parameter = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=compiler.nextParamId args=[] />)
    val binding = <Bind nameStart=parameterName.nameStart nameLen=parameterName.nameLen nameId=parameterName.nameId paramId=compiler.nextParamId fieldStart=0U64 fieldLen=0U64 />
    compiler.nextParamId += 1U64
    val arrayName = compiler.internBytes(s: "Array")
    val nested = compiler.pushType(t: <TypeRef nameStart=arrayName.nameStart nameLen=arrayName.nameLen args=[parameter] />)
    val member = compiler.internBytes(s: "Item")
    val projection = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] projectionReceiver=integer assocTraitStart=owner.nameStart assocTraitLen=owner.nameLen assocTraitId=owner.nameId assocTraitArgs=[integer] assocNameId=member.nameId hasAssocTraitDecl=true assocTraitDeclOffset=owner.nameStart />)
    val receiver = compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] hasDecl=true declOffset=declaration.defOffset />)
    val validProjection = compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] projectionReceiver=receiver assocTraitStart=owner.nameStart assocTraitLen=owner.nameLen assocTraitId=owner.nameId assocTraitArgs=[integer] assocNameId=member.nameId hasAssocTraitDecl=true assocTraitDeclOffset=owner.nameStart />)
    val argument = if scenario == "closedness" || scenario == "environment" || scenario == "witness" || scenario == "legacyGrounding" || scenario == "genericBinding" || scenario == "genericBindingControl" || scenario == "occursView" || scenario == "callerOwned" { give parameter } else if scenario == "nestedEnvironment" { give nested } else if scenario == "projectionNormalization" { give validProjection } else if scenario == "projectionPresence" { give projection } else { give integer }
    val source = <ResolvedViewSource surfaceId=traitName.nameId traitInstance=<TraitInstanceKey owner=owner.nameStart positionalArgs=[argument] /> />
    val viewed = compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] hasDecl=true declOffset=declaration.defOffset viewSources=[source] />)
    if scenario == "rigidMatching" || scenario == "rigidMatchingControl" || scenario == "designatedMatchingControl" {
        val identity = if scenario == "rigidMatchingControl" { give binding.paramId } else { give compiler.nextParamId }
        val other = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=identity args=[] />)
        val pattern = compiler.typeRefWithViewSources(ref: receiver, sources: [source.withArguments(arguments: [parameter])])
        val actual = compiler.typeRefWithViewSources(ref: receiver, sources: [source.withArguments(arguments: [other])])
        val scope = if scenario == "designatedMatchingControl" { give [binding] } else { give [] }
        val same = compiler.typeRefListPatternMatches(pattern: <PatternTypeInput.Values values=[pattern] />, patternParams: <PatternBindInput.Values values=scope />, actual: <PatternTypeInput.Values values=[actual] />)
        print(if scenario == "rigidMatching" { give !same } else { give same })
        return
    }
    if scenario == "rigidParamScope" || scenario == "rigidParamScopeControl" {
        val identity = if scenario == "rigidParamScopeControl" { give binding.paramId } else { give compiler.nextParamId }
        val other = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=identity args=[] />)
        val same = compiler.typeRefsAlphaEq(a: parameter, b: other, aParams: [], bParams: [])
        print(if scenario == "rigidParamScopeControl" { give same } else { give !same })
        return
    }
    if scenario == "nominalBinderCollision" {
        // The caller's resolved nominal spelling can equal a callee binder's
        // name. Its established declaration owner makes it rigid.
        val nominal = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen args=[] hasDecl=true declOffset=declaration.defOffset />)
        print(!compiler.typeRefListPatternMatches(pattern: <PatternTypeInput.Values values=[nominal] />, patternParams: <PatternBindInput.Values values=[binding] />, actual: <PatternTypeInput.Values values=[integer] />))
        return
    }
    if scenario == "qualifiedAlphaDifferent" || scenario == "qualifiedAlphaSame" || scenario == "qualifiedAlphaOwnerDistinct" {
        val otherName = compiler.internBytes(s: "U")
        val otherBinding = <Bind nameStart=otherName.nameStart nameLen=otherName.nameLen nameId=otherName.nameId paramId=compiler.nextParamId fieldStart=0U64 fieldLen=0U64 />
        compiler.nextParamId += 1U64
        val otherTraitName = compiler.internBytes(s: "Q")
        val otherTrait = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: otherTraitName.nameId))
        val chosen = if scenario == "qualifiedAlphaOwnerDistinct" { give otherTrait } else { give owner }
        val argument = if scenario == "qualifiedAlphaDifferent" { give boolean } else { give integer }
        val left = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=binding.paramId args=[] viewSources=[integerSource] />)
        val right = compiler.pushType(t: <TypeRef nameStart=otherName.nameStart nameLen=otherName.nameLen paramId=otherBinding.paramId args=[] viewSources=[<ResolvedViewSource surfaceId=chosen.nameId traitInstance=<TraitInstanceKey owner=chosen.nameStart positionalArgs=[argument] /> />] />)
        val same = compiler.typeRefsAlphaEq(a: left, b: right, aParams: [binding], bParams: [otherBinding])
        print(if scenario == "qualifiedAlphaSame" { give same } else { give !same })
        return
    }
    if scenario == "rigidViewMismatch" || scenario == "alphaViewMismatch" || scenario == "completeViewSet" || scenario == "genericBinding" || scenario == "genericBindingControl" {
        val actual = compiler.typeRefWithViewSources(ref: receiver, sources: [otherSource])
        val pattern = if scenario != "genericBinding" && scenario != "genericBindingControl" { give compiler.typeRefWithViewSources(ref: receiver, sources: [integerSource]) } else { give compiler.typeRefWithViewSources(ref: receiver, sources: [source]) }
        if scenario == "completeViewSet" {
            print(!compiler.typeTermViewSourcesEqual(a: pattern, b: actual))
            return
        }
        if scenario == "alphaViewMismatch" {
            print(!compiler.typeRefsAlphaEq(a: pattern, b: actual, aParams: [], bParams: []))
            return
        }
        val patterns = if scenario == "genericBinding" || scenario == "genericBindingControl" { give [pattern, parameter] } else { give [pattern] }
        val actuals = if scenario == "genericBinding" { give [actual, integer] } else if scenario == "genericBindingControl" { give [actual, boolean] } else { give [actual] }
        // P[T] binds T to Bool; the later I64 must conflict with that same T.
        val matches = compiler.typeRefListPatternMatches(pattern: <PatternTypeInput.Values values=patterns />, patternParams: <PatternBindInput.Values values=[binding] />, actual: <PatternTypeInput.Values values=actuals />)
        print(if scenario == "genericBindingControl" { give matches } else { give !matches })
        return
    }
    if scenario == "occursView" {
        // Reject T = S#P[T] through the actual occurs-check path.
        print(compiler.occursInPattern(side: 0U64, binderId: binding.paramId, ref: viewed, refSide: 0U64, aParams: <PatternBindInput.Values values=[binding] />, bParams: <PatternBindInput.Values values=[] />, binds: []))
        return
    }
    if scenario == "duplicateBuilder" {
        val duplicate = compiler.typeRefWithViewSources(ref: receiver, sources: [integerSource, useSource])
        val single = compiler.typeRefWithViewSources(ref: receiver, sources: [integerSource])
        print(compiler.typeRefEq(a: duplicate, b: single) && compiler.typeTermViewSourceCount(ref: duplicate) == 1U64)
        return
    }
    if scenario == "environment" || scenario == "nestedEnvironment" || scenario == "callerOwned" {
        val replacement = if scenario == "callerOwned" { give nested } else { give integer }
        val grounded = compiler.groundTermInEnvironment(ref: viewed, params: [binding], values: [replacement])
        val expected = if scenario == "nestedEnvironment" {
            give compiler.pushType(t: <TypeRef nameStart=arrayName.nameStart nameLen=arrayName.nameLen args=[integer] />)
        } else { give replacement }
        print(compiler.typeRefEq(a: compiler.typeTermRefViewArgumentAt(ref: grounded, index: 0U64), b: expected))
        return
    }
    if scenario == "legacyGrounding" {
        compiler.cur.typeParams = [binding]
        compiler.cur.typeArgs = [integer]
        val grounded = compiler.groundTypeRef(ref: viewed).unwrap()
        print(compiler.typeRefEq(a: compiler.typeTermRefViewArgumentAt(ref: grounded, index: 0U64), b: integer))
        return
    }
    if scenario == "projectionNormalization" {
        val grounded = compiler.closeBodyProjectionTerms(ref: viewed, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64).unwrap()
        print(compiler.typeRefEq(a: compiler.typeTermRefViewArgumentAt(ref: grounded, index: 0U64), b: boolean))
        return
    }
    if scenario == "witness" {
        val witness = <WitnessMatch binds=[<WitnessBind binder=0U64 paramId=binding.paramId term=integer />] />
        val grounded = compiler.groundWitnessTypeTerm(ref: viewed, params: <PatternBindInput.Values values=[binding] />, matchResult: witness).unwrap()
        print(compiler.typeRefEq(a: compiler.typeTermRefViewArgumentAt(ref: grounded, index: 0U64), b: integer))
        return
    }
    if scenario == "children" {
        print(compiler.typeTermRefChildCount(ref: viewed) == 1U64 && compiler.typeTermRefChildRef(ref: viewed, index: 0U64) == integer)
    } else if scenario == "closedness" {
        print(!compiler.arena.typeIsClosed(ref: viewed))
    } else if scenario == "projectionPresence" {
        print(compiler.arena.typeContainsAssociatedProjection(ref: viewed))
    } else if scenario == "topLevelView" {
        print(compiler.arena.typeTermAt(index: viewed).hasTopLevelView())
    } else if scenario == "closedControl" {
        print(compiler.arena.typeIsClosed(ref: viewed) && !compiler.arena.typeContainsAssociatedProjection(ref: viewed))
    } else {
        panic("unknown semantic view scenario")
    }
}
