use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, openFrontend }
use ../../../src/CheckedProgram only { CompilerSession, CompilerSessionResult, ProgramCheckResult, checkCompilerSession }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Diag only { CompileDiagnostic, FailureDomain }
use @Std/Io only { print }

fn input(kind: U64) -> FrontendInput {
    if kind == 0U64 { return <FrontendInput.Text path="typing0.pw" text="fn bad() {{ val values = [] }}\nfn main() {{}}\n" /> }
    if kind == 1U64 { return <FrontendInput.Text path="typing1.pw" text="fn bad() {{ val values = {{ give [] }} }}\nfn main() {{}}\n" /> }
    if kind == 2U64 { return <FrontendInput.Text path="typing2.pw" text="fn bad() {{ val values = [[]] }}\nfn main() {{}}\n" /> }
    if kind == 3U64 { return <FrontendInput.Text path="typing3.pw" text="fn bad() {{ [] }}\nfn main() {{}}\n" /> }
    if kind == 4U64 { return <FrontendInput.Text path="typing4.pw" text="fn bad() {{ val action: fn() = fn() {{ val values = [] }} }}\nfn main() {{}}\n" /> }
    panic("invalid test kind")
}

fn requireTyping(diagnostic: CompileDiagnostic, owned: Bool = true) {
    if diagnostic.message() != "cannot infer this expression's type; add a type annotation or provide an expected type" { panic(diagnostic.message()) }
    if diagnostic.isSourceRejection() != owned { panic("source typing rejection lost its required ownership boundary") }
    if !owned { match diagnostic.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("Raw opaque failure domain changed") } } }
}

fn session(kind: U64) -> CompilerSession {
    match CompilerSession.open(input: input(kind: kind), sources: <SourceAccess />) {
        CompilerSessionResult.Success(session: val session) => { return move session }
        CompilerSessionResult.Failure(diagnostic: val diagnostic) => { panic(diagnostic.message()) }
    }
}

fn globalTypingFailure() {
    val input = <FrontendInput.Text path="globalTyping.pw" text="val values = []\nfn main() {{}}\n" />
    mut val raw = <Comp />
    analyzeFrontendForRequests(c: inout raw, input: input, sources: <SourceAccess />).unwrap()
    if raw.arena.globals.count() != 1U64 { panic("global typing fixture changed") }
    val target = raw.arena.globals[0U64].nameStart
    for attempt in 0U64..<2U64 {
        match raw.prepareGlobalInitializer(target: target) {
            Result.Err(error: val diagnostic) => { requireTyping(diagnostic: diagnostic, owned: false) raw.pendingDiagnostics.append(diagnostic) }
            Result.Ok(value: _) => { panic("raw global typing failure accepted") }
        }
        if raw.takeDiagnostics().count() != 1U64 { panic("global drain lost retained typing failure") }
    }
    match CompilerSession.open(input: input, sources: <SourceAccess />) {
        CompilerSessionResult.Failure(diagnostic: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
        CompilerSessionResult.Success(session: val opened) => {
            match checkCompilerSession(session: move opened) {
                ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
                ProgramCheckResult.Success(program: _) => { panic("whole global typing failure accepted") }
            }
        }
    }
    match openFrontend(input: input, sources: <SourceAccess />) {
        Result.Err(error: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
        Result.Ok(value: _) => { panic("eager global typing failure accepted") }
    }
    print("global typing rejection retained")
}
fn main() {
    for kind in 0U64..<5U64 {
        mut val raw = <Comp />
        analyzeFrontendForRequests(c: inout raw, input: input(kind: kind), sources: <SourceAccess />).unwrap()
        val name = raw.internBytes(s: "bad")
        val function = raw.arena.firstFunctionNamed(nameId: name.nameId)
        for attempt in 0U64..<2U64 {
            match raw.prepareLexicalBody(fnIdx: function) {
                Result.Err(error: val diagnostic) => { requireTyping(diagnostic: diagnostic, owned: false) raw.pendingDiagnostics.append(diagnostic) }
                Result.Ok(value: _) => { panic("Raw body request accepted source typing value") }
            }
            if raw.takeDiagnostics().count() != 1U64 { panic("drain lost retained typing rejection") }
        }
        print("raw typing rejection retained")
        {
            mut val owned = session(kind: kind)
            for attempt in 0U64..<2U64 {
                // Both instances admit the same immutable declarations. The
                // source function ID is obtained before any body is requested.
                match owned.prepareFunction(function: function) {
                    Result.Err(error: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
                    Result.Ok(value: _) => { panic("failed lazy function request published success") }
                }
            }
            match checkCompilerSession(session: move owned) {
                ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
                ProgramCheckResult.Success(program: _) => { panic("failed lazy session published a checked program") }
            }
            print("lazy typing rejection retained")
        }
        match checkCompilerSession(session: session(kind: kind)) {
            ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
            ProgramCheckResult.Success(program: _) => { panic("whole check accepted source typing value") }
        }
        print("whole typing rejection retained")
        match openFrontend(input: input(kind: kind), sources: <SourceAccess />) {
            Result.Err(error: val diagnostic) => { requireTyping(diagnostic: diagnostic) }
            Result.Ok(value: _) => { panic("eager check accepted source typing value") }
        }
        print("eager typing rejection retained")
    }
    globalTypingFailure()
}
