// Append to a frozen Frontend root. Private provenance is never a public API.
fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/fixtures/reject/named_fn_value_return.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />).unwrap()
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "make").nameId)
    val owner = <SemanticCompletionOwner.Function index=function />
    if !compiler.sourceFacts.begin(owner: owner) { panic("body not fresh") }
    val request = <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=owner />
    val diagnostic = match compiler.recordParametricFunctionWithOrigin(fnIdx: function, recordCallTemplates: true, origin: <SourceRecordingScope request=request returnContext=<SourceExpectedContext.None /> />, expectedOrigin: <SourceExpectedContext.None />) {
        Result.Err(error: val diagnostic) => diagnostic
        Result.Ok(value: _) => { panic("declaration became value") }
    }
    val refusal = diagnostic.namedDeclaration().unwrap()
    val proof = compiler.failedNamedDeclarations[refusal.event()]
    if proof.declaration != 0U64 { panic("target0 fixture changed") }
    if !compiler.sourceFailureHasOwner(diagnostic: diagnostic) || diagnostic.isSourceRejection() { panic("refusal lost private authority") }
    if compiler.sourceFacts.expressionOwners.contains(key: refusal.expression()) { panic("failed declaration published successful value fact") }
    for invalid in 0U64..<5U64 {
        val forged = <NamedDeclarationRefusal session=if invalid == 0U64 { give refusal.session()+1U64 } else { give refusal.session() } owner=if invalid == 1U64 { give <DiagnosticOwner.Unknown /> } else { give refusal.owner() } expression=if invalid == 2U64 { give compiler.arena.exprs.count() } else { give refusal.expression() } event=if invalid == 3U64 { give compiler.failedNamedDeclarations.count() } else { give refusal.event() } location=if invalid == 4U64 { give <DiagnosticLocation.Unpositioned /> } else { give refusal.location() } />
        if compiler.sourceFailureHasOwner(diagnostic: <CompileDiagnostic.namedDeclaration refusal=forged />) { panic("forged event acquired authority") }
    }
    val original = compiler.arena.exprs[refusal.expression()]
    val serial = compiler.arena.exprOriginSerial[refusal.expression()]
    val spanStart = compiler.arena.exprSpanStart[refusal.expression()]
    val spanEnd = compiler.arena.exprSpanEnd[refusal.expression()]
    val binding = <IdentBinding code=identFnCode() target=proof.declaration />
    val count = compiler.failedNamedDeclarations.count()
    for invalid in 0U64..<5U64 {
        if invalid == 0U64 { compiler.arena.exprOriginSerial[refusal.expression()] = serial+1U64 }
        if invalid == 1U64 { compiler.arena.exprSpanStart[refusal.expression()] = spanStart+1U64 }
        if invalid == 2U64 { compiler.arena.exprSpanEnd[refusal.expression()] = spanEnd+1U64 }
        if invalid == 3U64 { compiler.arena.exprs[refusal.expression()] = <Expr.Ident start=proof.authored.start+1U64 len=proof.authored.length /> }
        if invalid == 4U64 { compiler.sourceFacts.expressionOwners[refusal.expression()] = <SemanticCompletionOwner.Global target=0U64 /> }
        if compiler.sourceFailureHasOwner(diagnostic: diagnostic) { panic("mutated source retained authority") }
        if compiler.namedDeclarationValueDiagnostic(expression: refusal.expression(), binding: binding, origin: request).namedDeclaration().isSome() { panic("mutated source minted event") }
        compiler.arena.exprs[refusal.expression()] = original
        compiler.arena.exprOriginSerial[refusal.expression()] = serial
        compiler.arena.exprSpanStart[refusal.expression()] = spanStart
        compiler.arena.exprSpanEnd[refusal.expression()] = spanEnd
        compiler.sourceFacts.expressionOwners.remove(key: refusal.expression())
    }
    for invalid in 0U64..<3U64 {
        val origin = if invalid == 0U64 { give <SourceRecordOrigin.Raw /> } else if invalid == 1U64 { give <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession()+1U64 root=owner /> } else { give <SourceRecordOrigin.CheckingRequest session=compiler.sourceFactSession() root=<SemanticCompletionOwner.Global target=0U64 /> /> }
        if compiler.namedDeclarationValueDiagnostic(expression: refusal.expression(), binding: binding, origin: origin).namedDeclaration().isSome() { panic("invalid request minted event") }
    }
    for code in [identValueCode(), identTypeQualCode(), identUndefCode()] {
        if compiler.namedDeclarationValueDiagnostic(expression: refusal.expression(), binding: <IdentBinding code=code target=proof.declaration />, origin: request).namedDeclaration().isSome() { panic("another binding category minted declaration event") }
    }
    compiler.typeCache.identTarget[refusal.expression()] = compiler.arena.functionCount()
    if compiler.namedDeclarationValueDiagnostic(expression: refusal.expression(), binding: binding, origin: request).namedDeclaration().isSome() { panic("different binding cache minted event") }
    compiler.typeCache.identTarget[refusal.expression()] = proof.declaration
    val clone = compiler.pushExpr(e: original)
    compiler.arena.exprSpanStart[clone] = spanStart
    compiler.arena.exprSpanEnd[clone] = spanEnd
    compiler.ensureExprTySlot(exprId: clone)
    compiler.typeCache.identBind[clone] = identFnCode()
    compiler.typeCache.identTarget[clone] = proof.declaration
    if compiler.namedDeclarationValueDiagnostic(expression: clone, binding: binding, origin: request).namedDeclaration().isSome() { panic("synthetic identifier minted source event") }
    for target in [compiler.arena.functionCount(), 18446744073709551615U64] {
        if compiler.namedDeclarationValueDiagnostic(expression: refusal.expression(), binding: <IdentBinding code=identFnCode() target=target />, origin: request).namedDeclaration().isSome() { panic("invalid declaration minted event") }
    }
    if compiler.failedNamedDeclarations.count() != count { panic("invalid requests changed evidence") }
    compiler.finishSourceFacts(owner: owner, result: <Result.Err error=diagnostic />, bodyless: false)
    if !compiler.sourceFailureHasOwner(diagnostic: diagnostic) { panic("builder failure erased nonvalue category") }
    compiler.prepareLexicalBody(fnIdx: 0U64).unwrap()
    if !compiler.sourceFailureHasOwner(diagnostic: diagnostic) { panic("another cursor erased category") }
}
