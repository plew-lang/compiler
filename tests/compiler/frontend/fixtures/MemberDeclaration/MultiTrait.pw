trait Reader[T] { fn read(value: T) -> I64 }
struct Item {}
impl Item as Reader[I64] { fn read(value: I64) -> I64 { return value } }
impl Item as Reader[Bool] { fn read(value: Bool) -> I64 { return 2I64 } }
fn broken(seed: Item) -> fn(value: I64) -> I64 { return seed#Reader[I64].read }
fn main() {}
