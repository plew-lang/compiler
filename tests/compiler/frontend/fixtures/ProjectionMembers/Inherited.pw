trait Parent { type Output }
trait Child: Parent {}
fn entry[T](value: T#Child.Output) where T: Child {}
fn main() {}
struct Leaf {}
impl Leaf as Parent { type Output = I64 }
impl Leaf as Child {}
fn leaf(value: Leaf) {}
fn boxed[T](value: Array[T#Child.Output]) where T: Child {}
fn returning[T](value: T#Child.Output) -> T#Child.Output where T: Child { return value }
fn returningArray[T](value: Array[T#Child.Output]) -> Array[T#Child.Output] where T: Child { return value }
async fn returningAsync[T](value: T#Child.Output) -> Promise[T#Child.Output] where T: Child { return value }
fn produce[T](owner: T, value: T#Child.Output) -> T#Child.Output where T: Child { return value }
fn caller() -> I64 { return produce(owner: <Leaf />, value: 7I64) }
fn wrongCaller() -> I64 { return produce(owner: <Leaf />, value: true) }
fn propagating[T](value: Result[I64, T#Child.Output]) -> Result[I64, T#Child.Output] where T: Child {
    val number = try value
    return <Result.Ok value=number />
}
struct Holder {}
impl Holder {
    fn produceMember[T](owner: T, value: T#Child.Output) -> T#Child.Output where T: Child { return value }
}
fn methodCaller() -> I64 {
    val holder = <Holder />
    return holder.produceMember(owner: <Leaf />, value: 7I64)
}
fn wrongMethodCaller() -> I64 {
    val holder = <Holder />
    return holder.produceMember(owner: <Leaf />, value: true)
}
impl Holder {
    fn apply[T](transform: fn(value: T) -> T, value: T) -> T { return transform(value: value) }
}
fn closureMethodCaller() -> I64 {
    val holder = <Holder />
    return holder.apply(transform: fn(value) { return value }, value: 7I64)
}
