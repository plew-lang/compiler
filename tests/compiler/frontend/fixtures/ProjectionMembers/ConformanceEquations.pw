trait Key { type Item }
trait Parent[A] { type Output }
trait Child[A]: Parent[A] + Parent[I64] {}
trait Product { type Value }
struct Box[T] {}
impl[T] Box[T] as Product where T: Child[T#Key.Item] + Key[Item=I64] {
    type Value = T#Child[T#Key.Item].Output
}
fn main() {}
struct Leaf {}
impl Leaf as Key { type Item = I64 }
impl Leaf as Parent[I64] { type Output = U32 }
impl Leaf as Child[I64] {}
fn boxed(value: Box[Leaf]) {}
