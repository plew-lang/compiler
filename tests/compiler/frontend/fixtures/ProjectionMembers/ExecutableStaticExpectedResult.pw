use @Std/Io only { print }
trait Parent { type Output }
trait Child: Parent {}
struct Leaf {}
impl Leaf as Parent { type Output = I64 }
impl Leaf as Child {}
struct Builder {}
impl Builder {
    assoc fn build[T, U](owner: T, output: T#Child.Output, transform: fn(value: U) -> U) -> (owner: T, output: T#Child.Output, transform: fn(value: U) -> U) where T: Child {
        return (owner: owner, output: output, transform: transform)
    }
}

fn main() {
    val bundle: (owner: Leaf, output: I64, transform: fn(value: Bool) -> Bool) = Builder.build(owner: <Leaf />, output: 7I64, transform: fn(value) { return value })
    val transform = bundle.transform
    if transform(value: true) { print(bundle.output) } else { print(0I64) }
}
