trait Marker {}
struct Wrap[R] {}
impl[R] Wrap[R] as Marker {}
impl Marker {
    fn reshape[U](owner: Self, transform: fn(value: U) -> U) -> (fixed: Self, transform: fn(value: U) -> U) {
        val next = <Wrap[U] />
        val result: (fixed: Wrap[Bool], transform: fn(value: Bool) -> Bool) = next.reshape(owner: next, transform: fn(value: Bool) -> Bool { return value })
        return (fixed: owner, transform: transform)
    }
}
fn main() {}
