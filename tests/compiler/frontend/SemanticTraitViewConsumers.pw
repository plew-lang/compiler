// Manual com-zdod consumers: these invoke existing production compatibility,
// argument recovery and recursive view-cycle entries, not a copied matcher.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { TypeRef, ResolvedViewSource, TraitInstanceKey, Expr, Param, MakeFieldRange, InstanceEnvironment, Conform }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn main() {
    val scenario = argAt(1I64)
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text="trait A[K] {{}} trait B[K] {{}} trait P[K] {{ type Item }} struct S {{}} impl S as P[I64] {{ type Item=I64 }} impl S as P[Bool] {{ type Item=Bool }} extension E {{ impl A[I64] as B[I64] {{}} }} extension F {{ impl B[I64] as A[I64] {{}} }} trait Zero {{}} trait OtherZero {{}} fn identity[T](value: T) -> T {{ return value }} fn main() {{}}" path="ViewConsumers.pw" />, sources: <SourceAccess />).unwrap()
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
    val booleanName = compiler.internBytes(s: "Bool")
    val boolean = compiler.pushType(t: <TypeRef nameStart=booleanName.nameStart nameLen=booleanName.nameLen args=[] />)
    val traitName = compiler.internBytes(s: "P")
    val trait = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: traitName.nameId))
    val expectedSource = <ResolvedViewSource surfaceId=trait.nameId traitInstance=<TraitInstanceKey owner=trait.nameStart positionalArgs=[integer] /> />
    val actualSource = <ResolvedViewSource surfaceId=trait.nameId traitInstance=<TraitInstanceKey owner=trait.nameStart positionalArgs=[boolean] /> />
    val structName = compiler.internBytes(s: "S")
    val declaration = compiler.arena.structAt(index: compiler.arena.firstStructNamed(nameId: structName.nameId))
    val base = compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] hasDecl=true declOffset=declaration.defOffset />)
    val expected = compiler.typeRefWithViewSources(ref: base, sources: [expectedSource])
    val actual = compiler.typeRefWithViewSources(ref: base, sources: [actualSource])
    if scenario == "recordOwner" || scenario == "recordOwnerControl" || scenario == "recordArguments" || scenario == "recordNoArgsOwner" || scenario == "recordExtension" || scenario == "recordExtensionOrderControl" || scenario == "recordBodyKeys" || scenario == "recordFieldControl" {
        val field = compiler.internBytes(s: "field")
        val otherField = compiler.internBytes(s: "otherField")
        val record = compiler.pushType(t: <TypeRef nameStart=structName.nameStart nameLen=structName.nameLen args=[] isRecord=true recordFieldLabels=[field.nameId] recordFieldTerms=[integer] />)
        val otherRecord = compiler.pushType(t: <TypeRef nameStart=structName.nameStart nameLen=structName.nameLen args=[] isRecord=true recordFieldLabels=[otherField.nameId] recordFieldTerms=[integer] />)
        val otherName = compiler.internBytes(s: "A")
        val otherOwner = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: otherName.nameId))
        mut val leftSources = [expectedSource]
        mut val rightSources = [<ResolvedViewSource surfaceId=otherOwner.nameId traitInstance=<TraitInstanceKey owner=otherOwner.nameStart positionalArgs=[integer] /> />]
        if scenario == "recordOwnerControl" || scenario == "recordFieldControl" { rightSources = [expectedSource] }
        if scenario == "recordArguments" { rightSources = [actualSource] }
        if scenario == "recordNoArgsOwner" {
            val zeroName = compiler.internBytes(s: "Zero")
            val otherZeroName = compiler.internBytes(s: "OtherZero")
            val zero = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: zeroName.nameId))
            val otherZero = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: otherZeroName.nameId))
            leftSources = [<ResolvedViewSource surfaceId=zero.nameId traitInstance=<TraitInstanceKey owner=zero.nameStart positionalArgs=[] /> />]
            rightSources = [<ResolvedViewSource surfaceId=otherZero.nameId traitInstance=<TraitInstanceKey owner=otherZero.nameStart positionalArgs=[] /> />]
        }
        if scenario == "recordExtension" || scenario == "recordExtensionOrderControl" {
            val firstExtension = <ResolvedViewSource surfaceId=compiler.moduleScopeBindings.unwrap().extensionId(moduleId: 0U64, nameId: compiler.internBytes(s: "E").nameId).unwrap() />
            val secondExtension = <ResolvedViewSource surfaceId=compiler.moduleScopeBindings.unwrap().extensionId(moduleId: 0U64, nameId: compiler.internBytes(s: "F").nameId).unwrap() />
            leftSources = [firstExtension]
            rightSources = [secondExtension]
            if scenario == "recordExtensionOrderControl" {
                leftSources = [firstExtension, secondExtension]
                rightSources = [secondExtension, firstExtension, firstExtension]
            }
        }
        val left = compiler.typeRefWithViewSources(ref: record, sources: leftSources)
        val right = compiler.typeRefWithViewSources(ref: (if scenario == "recordFieldControl" { give otherRecord } else { give record }), sources: rightSources)
        if scenario == "recordBodyKeys" {
            val name = compiler.internBytes(s: "identity")
            val function = compiler.arena.firstFunctionNamed(nameId: name.nameId)
            val parameters = [compiler.funcBindAt(binds: compiler.arena.functionAt(index: function).typeParams, index: 0U64)]
            val first = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[left] />)
            val second = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[right] />)
            print(first != second)
            return
        }
        val same = compiler.typeRefEq(a: left, b: right)
        print(if scenario == "recordOwnerControl" || scenario == "recordExtensionOrderControl" { give same } else { give !same })
        return
    }
    if scenario == "existentialMirror" || scenario == "existentialControl" || scenario == "existentialArguments" || scenario == "existentialOwner" {
        val item = compiler.internBytes(s: "Item")
        val interface = compiler.pushType(t: <TypeRef nameStart=trait.nameStart nameLen=trait.nameLen args=[integer, integer] argLabels=[0U64, item.nameId] isAny=true hasDecl=true declOffset=trait.nameStart />)
        val canonical = compiler.typeRefWithViewSources(ref: interface, sources: [expectedSource])
        val other = if scenario == "existentialArguments" {
            give compiler.typeRefWithViewSources(ref: interface, sources: [actualSource])
        } else if scenario == "existentialOwner" {
            val name = compiler.internBytes(s: "A")
            val owner = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: name.nameId))
            give compiler.typeRefWithViewSources(ref: interface, sources: [<ResolvedViewSource surfaceId=owner.nameId traitInstance=<TraitInstanceKey owner=owner.nameStart positionalArgs=[integer] /> />])
        } else if scenario == "existentialMirror" {
            give compiler.pushType(t: <TypeRef nameStart=trait.nameStart nameLen=trait.nameLen args=[integer, integer] argLabels=[0U64, item.nameId] isAny=true hasDecl=true declOffset=trait.nameStart viewSources=[expectedSource] />)
        } else { give canonical }
        val same = compiler.existentialTypesCompatible(sourceRef: other, targetRef: canonical)
        print(if scenario == "existentialArguments" || scenario == "existentialOwner" { give !same } else { give same })
        return
    }
    if scenario == "runtimeRawErase" || scenario == "runtimeBuilderEraseControl" || scenario == "runtimeNestedControl" {
        val raw = compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] hasDecl=true declOffset=declaration.defOffset viewSources=[expectedSource] />)
        if scenario == "runtimeNestedControl" {
            val name = compiler.internBytes(s: "Array")
            val outer = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[raw] />)
            val runtime = compiler.runtimeTypeRef(ref: outer)
            print(runtime == outer && compiler.arena.typeAt(index: runtime).args[0U64] == raw)
        } else {
            val runtime = compiler.runtimeTypeRef(ref: if scenario == "runtimeRawErase" { give raw } else { give expected })
            print(compiler.arena.typeViewSourceCount(ref: runtime) == 0U64 && compiler.typeRefEq(a: runtime, b: base))
        }
        return
    }
    if scenario == "bodyInstanceKeys" {
        val name = compiler.internBytes(s: "identity")
        mut val function = compiler.arena.functionCount()
        mut val index = 0U64
        while index < compiler.arena.functionCount() {
            if compiler.arena.functionAt(index: index).nameId == name.nameId { function = index }
            index += 1U64
        }
        if function == compiler.arena.functionCount() { panic("missing key test function") }
        val parameters = [compiler.funcBindAt(binds: compiler.arena.functionAt(index: function).typeParams, index: 0U64)]
        val first = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[expected] />)
        val second = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[actual] />)
        val copy = compiler.typeRefWithViewSources(ref: base, sources: [expectedSource])
        val repeated = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[copy] />)
        print(first != second && first == repeated && compiler.findBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[actual] />) == second)
        return
    }
    if scenario == "compatibilityMirrorControl" {
        val raw = compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] hasDecl=true declOffset=declaration.defOffset viewSources=[expectedSource] />)
        print(compiler.typesCompatible(expected: raw, inferred: expected).unwrap())
        return
    }
    if scenario == "compatibility" {
        print(!compiler.typesCompatible(expected: expected, inferred: actual).unwrap())
        return
    }
    if scenario == "compatibilityControl" {
        print(compiler.typesCompatible(expected: expected, inferred: expected).unwrap())
        return
    }
    if scenario == "argumentStored" || scenario == "argumentExplicit" || scenario == "argumentControl" || scenario == "argumentDuplicateControl" {
        val sourceType = if scenario == "argumentControl" || scenario == "argumentDuplicateControl" { give expected } else { give actual }
        val constructed = compiler.pushExpr(e: <Expr.Make typeStart=declaration.nameStart typeLen=declaration.nameLen variantStart=0U64 variantLen=0U64 isEnum=false ty=if scenario == "argumentExplicit" { give base } else { give sourceType } fields=<MakeFieldRange start=0U64 len=0U64 /> />)
        val expression = if scenario == "argumentExplicit" { give compiler.pushExpr(e: <Expr.ExtView recv=constructed source=actualSource strip=false />) } else { give constructed }
        val parameterType = if scenario == "argumentDuplicateControl" {
            give compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[] hasDecl=true declOffset=declaration.defOffset viewSources=[expectedSource, expectedSource] />)
        } else { give expected }
        val parameter = <Param nameStart=0U64 nameLen=0U64 tyStart=declaration.nameStart tyLen=declaration.nameLen tyNameId=structName.nameId tyIsArray=false ty=parameterType isInout=false isMove=false isBorrow=false noLabel=true hasDefault=false defaultExpr=0U64 />
        val matches = compiler.argMatchesParam(argExpr: expression, p: parameter).unwrap()
        print(if scenario == "argumentControl" || scenario == "argumentDuplicateControl" { give matches } else { give !matches })
        return
    }
    val extension = compiler.moduleScopeBindings.unwrap().extensionId(moduleId: 0U64, nameId: compiler.internBytes(s: "E").nameId).unwrap()
    val reverse = compiler.moduleScopeBindings.unwrap().extensionId(moduleId: 0U64, nameId: compiler.internBytes(s: "F").nameId).unwrap()
    // A deliberately colliding numeric extension tag must not be enabled by
    // a trait view: kind, rather than the integer alone, controls activation.
    if scenario == "traitSourceActivation" {
        val sourceTrait = compiler.decls.traitAt(index: 0U64)
        val targetTrait = compiler.decls.traitAt(index: 1U64)
        compiler.decls.registerConform(<Conform sourceModule=0U64 typeStart=sourceTrait.nameStart typeLen=sourceTrait.nameLen typeId=sourceTrait.nameId subjectTraitOwner=sourceTrait.nameStart typeArity=1U64 subjectArgs=compiler.pushConformTypes(types: [integer]) traitStart=targetTrait.nameStart traitLen=targetTrait.nameLen traitArgs=compiler.pushConformTypes(types: [integer]) derived=false extId=trait.nameId />)
    }
    val selected = if scenario == "traitSourceActivation" {
        give [expectedSource, <ResolvedViewSource surfaceId=reverse />]
    } else if scenario == "genericCycleControl" { give [<ResolvedViewSource surfaceId=extension />] }
    else { give [<ResolvedViewSource surfaceId=extension />, <ResolvedViewSource surfaceId=reverse />] }
    val inner = compiler.typeRefWithViewSources(ref: integer, sources: selected)
    val viewed = if scenario == "traitSourceActivation" { give inner } else {
        give compiler.typeRefWithViewSources(ref: base, sources: [<ResolvedViewSource surfaceId=trait.nameId traitInstance=<TraitInstanceKey owner=trait.nameStart positionalArgs=[inner] /> />])
    }
    match compiler.checkGenericTypeViewCycles(ref: viewed, offset: 0U64) {
        Result.Ok(value: _) => { print(scenario == "genericCycleControl" || scenario == "traitSourceActivation") }
        Result.Err(error: val diagnostic) => { print(scenario == "genericCycleViewArgument" && diagnostic.message == "trait-to-trait conformance cycle") }
    }
}
