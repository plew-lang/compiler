// Actual producers and source-owner cache, without invoking the compiler CLI.
use ../../../src/Diag only { CompileDiagnostic, FailureDomain, emitDiagnostic }
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { SemanticCompletionOwner, Expr, TypeRef, Func }
use ../../../src/DeclarationProgram only { DeclarationProgramError, declarationProgramDiagnostic }
use ../../../src/PreparedProgram only { ProgramPreparationError, programPreparationDiagnostic }
use @Std/Io only { print }

fn sourceFailure() -> CompileDiagnostic {
    mut val compiler: Comp = <Comp />
    val result = analyzeFrontend(c: inout compiler,
        input: <FrontendInput.Text text="fn domainMissingResult() -> I64 {{}}\nfn main() {{}}" path="MissingReturn.pw" />,
        sources: <SourceAccess />)
    val diagnostic = match result {
        Result.Err(error: val diagnostic) => diagnostic
        Result.Ok(value: _) => { panic("missing return was accepted") }
    }
    if !diagnostic.isSourceRejection() { emitDiagnostic(diagnostic: diagnostic) panic("missing return lost its source domain") }
    val name = compiler.internBytes(s: "domainMissingResult")
    mut val target = compiler.arena.functionCount()
    mut val index = 0U64
    while index < compiler.arena.functionCount() {
        if compiler.arena.functionAt(index: index).nameId == name.nameId { target = index }
        index += 1U64
    }
    if target == compiler.arena.functionCount() { panic("source function was not registered") }
    compiler.pendingDiagnostics.append(diagnostic)
    val drained = compiler.takeDiagnostics()
    if drained.count() != 1U64 || !drained[0U64].isSourceRejection() { panic("drain lost failure domain") }
    if compiler.takeDiagnostics().count() != 0U64 { panic("drain did not empty presentation queue") }
    index = 0U64
    while index < 2U64 {
        match compiler.prepareLexicalBody(fnIdx: target) {
            Result.Err(error: val cached) => {
                if !cached.isSourceRejection() || cached.message != diagnostic.message { panic("repeat lost cached failure") }
            }
            Result.Ok(value: _) => { panic("draining presentation recovered failed source owner") }
        }
        index += 1U64
    }
    print("source cache retained")
    return diagnostic
}

fn requireSourceTypeFailure(text: String) {
    mut val compiler: Comp = <Comp />
    match analyzeFrontend(c: inout compiler,
        input: <FrontendInput.Text text=text path="SourceTypeFailure.pw" />,
        sources: <SourceAccess />) {
        Result.Err(error: val diagnostic) => {
            if !diagnostic.isSourceRejection() {
                emitDiagnostic(diagnostic: diagnostic)
                panic("source type failure lost domain")
            }
        }
        Result.Ok(value: _) => { panic("invalid source type was accepted") }
    }
}

fn requireUnknownTypeRemainsUnresolved() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val integerName = compiler.internBytes(s: "I64")
    val unknownName = compiler.internBytes(s: "NoDeclarationOwner")
    val bindingName = compiler.internBytes(s: "value")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
    val unknown = compiler.pushType(t: <TypeRef nameStart=unknownName.nameStart nameLen=unknownName.nameLen args=[] />)
    val floatName = compiler.internBytes(s: "F64")
    val float = compiler.pushType(t: <TypeRef nameStart=floatName.nameStart nameLen=floatName.nameLen args=[] />)
    val functionName = compiler.internBytes(s: "fn")
    val function = compiler.pushType(t: <TypeRef nameStart=functionName.nameStart nameLen=functionName.nameLen args=[integer] />)
    val record = compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true />)
    val knownTypes = [integer, float, function, record]
    for known in knownTypes {
        if !compiler.typeCompatibility(expected: known, inferred: unknown).unwrap().isUnresolved() { panic("unknown inferred nominal was considered incompatible") }
        if !compiler.typeCompatibility(expected: unknown, inferred: known).unwrap().isUnresolved() { panic("unknown expected nominal was considered incompatible") }
    }
    compiler.arena.registerFunction(<Func nameStart=0U64 nameLen=0U64 hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64 hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    compiler.cur.checkFn = 0U64
    val expression = compiler.pushExpr(e: <Expr.Ident start=bindingName.nameStart len=bindingName.nameLen />)
    compiler.addLocalCn(nameStart: bindingName.nameStart, nameLen: bindingName.nameLen, tyStart: unknownName.nameStart, tyLen: unknownName.nameLen, isArray: false, ty: unknown, isInout: false, isMut: false, owned: false, cnum: 0U64)
    compiler.recordExpr(exprId: expression).unwrap()
    for known in knownTypes {
        match compiler.tcCheckValue(expectedRef: known, valueExpr: expression, pos: "raw") {
            Result.Err(error: val diagnostic) => { if diagnostic.isSourceRejection() { panic("unresolved raw type was classified Source") } }
            Result.Ok(value: _) => { panic("unresolved raw type was accepted") }
        }
        match compiler.checkGenericTypeMatch(expectedRef: known, valueExpr: expression) {
            Result.Err(error: val diagnostic) => { if diagnostic.isSourceRejection() { panic("generic unresolved raw type was classified Source") } }
            Result.Ok(value: _) => { panic("generic unresolved raw type was accepted") }
        }
    }
}

fn main() {
    requireUnknownTypeRemainsUnresolved()
    val source = sourceFailure()
    requireSourceTypeFailure(text: "fn main() {{ val value: I64 = true }}")
    requireSourceTypeFailure(text: "fn invalidGeneric[T](value: T) -> I64 {{ return value }}\nfn main() {{}}")
    requireSourceTypeFailure(text: "fn main() {{ val value = 256U8 }}")
    requireSourceTypeFailure(text: "fn main() {{ val value: U8 = 256 }}")
    print("source type failures distinguished")
    mut val syntax: Comp = <Comp />
    match analyzeFrontend(c: inout syntax,
        input: <FrontendInput.Text text="fn main(" path="MalformedSyntax.pw" />,
        sources: <SourceAccess />) {
        Result.Err(error: val diagnostic) => {
            if !diagnostic.isSourceRejection() { panic("parser failure lost source domain") }
        }
        Result.Ok(value: _) => { panic("malformed syntax was accepted") }
    }
    print("parser source distinguished")
    mut val missing: Comp = <Comp />
    match analyzeFrontend(c: inout missing,
        input: <FrontendInput.File path="/nonexistent/plew-failure-domain-input.pw" />,
        sources: <SourceAccess />) {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain {
                FailureDomain.Input => {}
                _ => { panic("missing input lost input domain") }
            }
            if diagnostic.isSourceRejection() { panic("missing input was source rejection") }
        }
        Result.Ok(value: _) => { panic("missing input was accepted") }
    }
    print("input distinguished")
    mut val raw: Comp = <Comp />
    match raw.preparedSemanticFacts(owner: <SemanticCompletionOwner.Function index=0U64 />) {
        Result.Err(error: val diagnostic) => {
            if diagnostic.isSourceRejection() { panic("raw missing owner was source rejection") }
        }
        Result.Ok(value: _) => { panic("raw missing owner was accepted") }
    }
    val forwarded = programPreparationDiagnostic(c: inout raw,
        error: <ProgramPreparationError.Frontend diagnostic=source />)
    if !forwarded.isSourceRejection() { panic("outer preparation lost source domain") }
    val declarationAccess = declarationProgramDiagnostic(c: inout raw,
        error: <DeclarationProgramError.GlobalAccess offset=0U64 />)
    if !declarationAccess.isSourceRejection() { panic("declaration access rejection lost its domain") }
    val access = programPreparationDiagnostic(c: inout raw,
        error: <ProgramPreparationError.GlobalAccess offset=0U64 />)
    if !access.isSourceRejection() { panic("source access rejection lost its domain") }
    print("raw and converted domains retained")
}
