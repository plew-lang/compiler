use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend, analyzeFrontendForRequests }
use ../../../src/Ir only { CallReceiverPassing, ConformanceProofDemand, DeclarationBoundRef, InstanceEnvironment, PatternBindInput, PatternTypeInput, StaticConformanceProof, StaticProofInstantiation }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/SourceTypeAdmissions only { SourceSignatureSlot }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn checkReceiverReplay() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path=argAt(2I64) />, sources: <SourceAccess stdRoot=argAt(3I64).bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "retain").nameId)
    val declaration = compiler.arena.functionAt(index: function)
    val types = compiler.arena.functionAt(index: compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "types").nameId)).params
    val receiver = compiler.funcParamAt(params: types, index: 0U64).ty
    val kind = compiler.funcParamAt(params: types, index: 1U64).ty
    val expected = compiler.funcParamAt(params: types, index: 2U64).ty
    val selected = match compiler.traitPatternProof(demand: <ConformanceProofDemand.Existence />, baseRef: receiver, traitId: 0U64, traitOwner: declaration.recvStart, traitArgs: <PatternTypeInput.Values values=[kind] />, patternParams: <PatternBindInput.Values values=[] />) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("selected: " + diagnostic.message) },
    }
    match selected { StaticConformanceProof.Missing => { panic("receiver replay setup has no concrete witness") } _ => {} }
    val environment = match compiler.bodyInstanceEnvironment(fnIdx: function, args: [], recvInstRef: receiver, selectedProof: selected) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("environment: " + diagnostic.message) },
    }
    val premise = <StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.MethodReceiver index=function /> />
    val bare = match compiler.instantiateConstraintProof(proof: premise, receiverRef: receiver, environment: environment, selfRef: receiver, itemRef: 0U64) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("bare: " + diagnostic.message) },
    }
    match bare {
        StaticProofInstantiation.Deferred => {}
        _ => { panic("receiver replay reconstructed a missing projection equation") }
    }
    val parameter = match compiler.readAdmittedSignatureRoot(function: function, slot: <SourceSignatureSlot.Parameter index=0U64 />, environment: environment) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("parameter: " + diagnostic.message) },
    }
    val returned = match compiler.readAdmittedSignatureRoot(function: function, slot: <SourceSignatureSlot.Result />, environment: environment) {
        Result.Ok(value: val value) => value,
        Result.Err(error: val diagnostic) => { panic("returned: " + diagnostic.message) },
    }
    if !compiler.typeRefEq(a: parameter, b: expected) || !compiler.typeRefEq(a: returned, b: expected) { panic("receiver equations did not reach both signature slots") }
    val body = compiler.internBodyInstance(fnIdx: function, environment: environment)
    match compiler.prepareFinalCallableSignature(bodyId: body) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("body: " + diagnostic.message) }
    }
    val signature = compiler.arena.bodySignature(bodyId: body)
    if !signature.ready || !compiler.typeRefEq(a: signature.resultType, b: expected) { panic("receiver equations did not reach the body signature") }
}


fn checkProvided(compiler: inout Comp) {
    val sum = compiler.internBytes(s: "sum").nameId
    mut val hits = 0U64
    for index in 0U64..<compiler.arena.finalCalleeCount() {
        val call = compiler.arena.finalCalleeAt(index: index)
        if call.callee >= compiler.arena.functionCount() || compiler.arena.functionAt(index: call.callee).nameId != sum { continue }
        hits += 1U64
        if call.calleeBodyId == 0U64 { panic("provided method has no body") }
        val source = compiler.arena.functionLexicalOwner(index: call.callee)
        if source == call.callee { panic("provided control did not select a placement") }
        val instance = compiler.arena.bodyInstanceAt(index: call.calleeBodyId - 1U64)
        val environment = instance.environment
        val parameter = compiler.readAdmittedSignatureRoot(function: source, slot: <SourceSignatureSlot.Parameter index=0U64 />, environment: environment).unwrap()
        val signature = compiler.arena.bodySignature(bodyId: call.calleeBodyId)
        if !signature.ready || !compiler.typeRefEq(a: parameter, b: signature.parameterTypes[0U64]) { panic("placed body did not consume its original signature") }
        val missing = <InstanceEnvironment params=environment.params args=environment.args receiverRef=environment.receiverRef constraints=environment.constraints />
        if compiler.groundedSelectedCalleeParameterTypes(callee: call.callee, environment: missing).isOk() {
            panic("provided placement recovered missing receiver evidence")
        }
        val sourceFunction = compiler.arena.functionAt(index: source)
        val selfParameter = compiler.arena.typeTermAt(index: sourceFunction.recvTy).paramId
        mut val foreignArgs = environment.args
        mut val foundSelf = false
        for index in 0U64..<environment.params.count() {
            if environment.params[index].paramId == selfParameter {
                foreignArgs.set(i: index, value: parameter)
                foundSelf = true
            }
        }
        if !foundSelf || compiler.typeRefEq(a: parameter, b: environment.receiverRef) { panic("the lexical Self control has no foreign type") }
        val foreign = <InstanceEnvironment params=environment.params args=foreignArgs receiverRef=environment.receiverRef proof=environment.proof constraints=environment.constraints />
        if compiler.readAdmittedSignatureRoot(function: source, slot: <SourceSignatureSlot.Result />, environment: foreign).isOk() {
            panic("the original method accepted a foreign lexical Self")
        }
    }
    if hits != 1U64 { panic("the provided control did not select one real call") }
}

fn main() {
    if argAt(1I64) == "receiverReplay" {
        checkReceiverReplay()
        print("ok")
        return
    }
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler, input: <FrontendInput.File path=argAt(1I64) />, sources: <SourceAccess stdRoot=argAt(2I64).bytes() />).unwrap()
    if argAt(3I64) == "provided" {
        checkProvided(compiler: inout compiler)
        print("ok")
        return
    }
    val keep = compiler.internBytes(s: "keep").nameId
    mut val hits = 0U64
    for index in 0U64..<compiler.arena.finalCalleeCount() {
        val call = compiler.arena.finalCalleeAt(index: index)
        if call.callee >= compiler.arena.functionCount() || compiler.arena.functionAt(index: call.callee).nameId != keep { continue }
        hits += 1U64
        if call.calleeBodyId == 0U64 { panic("selected method has no body") }
        val instance = compiler.arena.bodyInstanceAt(index: call.calleeBodyId - 1U64)
        val environment = instance.environment
        if environment.constraints.isNone() { panic("the selected call has no retained impl premises") }
        val parameter = compiler.readAdmittedSignatureRoot(function: call.callee, slot: <SourceSignatureSlot.Parameter index=0U64 />, environment: environment).unwrap()
        val result = compiler.readAdmittedSignatureRoot(function: call.callee, slot: <SourceSignatureSlot.Result />, environment: environment).unwrap()
        val signature = compiler.arena.bodySignature(bodyId: call.calleeBodyId)
        if !signature.ready || signature.parameterTypes.count() != 1U64 || call.parameterTypeRefs.count() != 1U64 { panic("method signature was not published") }
        if !compiler.typeRefEq(a: signature.receiverType, b: environment.receiverRef) { panic("body signature changed the selected receiver") }
        match signature.receiverPassing { CallReceiverPassing.Inout => {} _ => { panic("body signature lost inout receiver passing") } }
        match call.receiverPassing { CallReceiverPassing.Inout => {} _ => { panic("call signature lost inout receiver passing") } }
        if !compiler.typeRefEq(a: signature.parameterTypes[0U64], b: parameter) || !compiler.typeRefEq(a: signature.resultType, b: result) { panic("body signature changed the saved projection") }
        if !compiler.typeRefEq(a: compiler.arena.finalCalleeParameterTypeAt(types: call.parameterTypeRefs, index: 0U64), b: parameter) || !compiler.typeRefEq(a: call.resultTypeRef, b: result) { panic("call signature changed the saved projection") }

        val missing = <InstanceEnvironment params=environment.params args=environment.args receiverRef=environment.receiverRef proof=environment.proof />
        if compiler.groundedSelectedCalleeParameterTypes(callee: call.callee, environment: missing).isOk() || compiler.groundedSelectedCalleeReturn(callee: call.callee, environment: missing).isOk() { panic("selected method recovered missing impl evidence") }
        val invalidBody = compiler.internBodyInstance(fnIdx: call.callee, environment: missing)
        compiler.recordBodyTypeTermResult(bodyId: invalidBody, source: compiler.arena.functionAt(index: call.callee).retTy, result: result)
        if compiler.prepareFinalCallableSignature(bodyId: invalidBody).isOk() || compiler.arena.bodySignature(bodyId: invalidBody).ready { panic("body signature recovered missing impl evidence from a cached result") }
        val snapshot = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "snapshot").nameId)
        val foreignReceiver = <InstanceEnvironment params=environment.params args=environment.args receiverRef=parameter />
        if compiler.readAdmittedSignatureRoot(function: snapshot, slot: <SourceSignatureSlot.Result />, environment: foreignReceiver).isOk() {
            panic("an inherent method accepted a foreign receiver for Self")
        }
    }
    if hits != 1U64 { panic("the inherited projection control did not select one real call") }
    print("ok")
}
