// Selecting destruction dependencies must not make their bodies executable.
use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use @Std/Core only { assert }
use @Std/Process only { argAt }
use @Std/Io only { print }

// Canonical closedness excludes parameters but does not establish nominal arity.
// The arena also retains declaration heads; those have no executable contract.
fn completeArguments(compiler: inout Comp, term: U64) -> Bool {
    val type = compiler.arena.typeAt(index: term)
    val structure = compiler.structIndexForType(ref: term)
    if structure < compiler.arena.structCount() {
        if type.args.count() != compiler.arena.structAt(index: structure).typeParams.count() { return false }
    } else {
        val enumeration = compiler.enumIndexForType(ref: term)
        if enumeration < compiler.arena.enumCount() && type.args.count() != compiler.arena.enumAt(index: enumeration).typeParams.count() { return false }
    }
    mut val index = 0U64
    while index < compiler.typeTermRefChildCount(ref: term) {
        if !completeArguments(compiler: inout compiler, term: compiler.typeTermRefChildRef(ref: term, index: index)) { return false }
        index += 1U64
    }
    return true
}

fn main() {
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler, input: <FrontendInput.File path=argAt(1I64) />,
        sources: <SourceAccess stdRoot=argAt(2I64).bytes() />).unwrap()
    val instances = compiler.arena.bodyInstanceCount()
    val bodies = compiler.monoWork.bodyCount()
    val destructions = compiler.arena.finalDestructions.count()
    val structures = compiler.arena.structCount()
    val types = compiler.arena.typeCount()
    mut val destructors = 0U64
    mut val compared = 0U64
    mut val index = 1U64
    while index < types {
        val contractId = compiler.finalDestructionIndex(typeRef: index)
        val eligible = compiler.arena.typeIsClosed(ref: index) && completeArguments(compiler: inout compiler, term: index)
        // No published final contract may disappear from this comparison.
        if contractId != 0U64 { assert(eligible) }
        if eligible {
            val shape = compiler.closedDestructionShape(typeRef: index).unwrap()
            if shape.destructorDeclaration != 0U64 { destructors += 1U64 }
            if contractId != 0U64 {
                compared += 1U64
                val contract = compiler.arena.finalDestructions[contractId - 1U64]
                assert(compiler.typeRefEq(a: shape.underlying, b: contract.underlying))
                assert(shape.fieldTypes.count() == contract.fieldTypes.count())
                assert(shape.fieldBoxed.count() == contract.fieldBoxed.count())
                assert(shape.variantFieldStarts.count() == contract.variantFieldStarts.count())
                assert(shape.isOpaquePointer == contract.isOpaquePointer)
                mut val field = 0U64
                while field < shape.fieldTypes.count() {
                    assert(compiler.typeRefEq(a: shape.fieldTypes[field], b: contract.fieldTypes[field]))
                    assert(shape.fieldBoxed[field] == contract.fieldBoxed[field])
                    field += 1U64
                }
                field = 0U64
                while field < shape.variantFieldStarts.count() {
                    assert(shape.variantFieldStarts[field] == contract.variantFieldStarts[field])
                    field += 1U64
                }
                if contract.deinitCall.bodyId != 0U64 {
                    assert(shape.destructorDeclaration == compiler.arena.bodyInstanceAt(index: contract.deinitCall.bodyId - 1U64).fnIdx + 1U64)
                } else { assert(shape.destructorDeclaration == 0U64) }
            }
        }
        index += 1U64
    }
    assert(destructors > 0U64 && compared > 0U64)
    assert(compiler.arena.bodyInstanceCount() == instances)
    assert(compiler.monoWork.bodyCount() == bodies)
    assert(compiler.arena.finalDestructions.count() == destructions)
    assert(compiler.arena.structCount() == structures)
    print("destruction-shape:ok")
}
