use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { Bind, Conform, TraitDef, TypeRef, ResolvedViewSource, TraitInstanceKey }
use ../../../src/Diag only { emitDiagnostic }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn appendEdge(compiler: inout Comp, subject: TraitDef, target: TraitDef, argument: U64) {
    val arguments = compiler.pushConformTypes(types: [argument])
    compiler.decls.registerConform(<Conform sourceModule=0U64 typeStart=subject.nameStart typeLen=subject.nameLen typeId=subject.nameId subjectTraitOwner=subject.nameStart typeArity=1U64 subjectArgs=arguments traitStart=target.nameStart traitLen=target.nameLen traitArgs=arguments derived=false />)
}

fn viewArgument(compiler: inout Comp, integerName: Bind, scenario: String, second: Bool) -> U64 {
    if scenario == "viewArgumentSame" || scenario == "viewArgumentDistinct" || scenario == "viewArgumentDuplicate" || scenario == "viewNestedDuplicate" {
        val name = compiler.internBytes(s: "ParameterView")
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: name.nameId))
        val argumentName = if second && scenario == "viewArgumentDistinct" { give compiler.internBytes(s: "Bool") } else { give integerName }
        val argument = compiler.pushType(t: <TypeRef nameStart=argumentName.nameStart nameLen=argumentName.nameLen args=[] />)
        val source = <ResolvedViewSource surfaceId=name.nameId traitInstance=<TraitInstanceKey owner=declaration.nameStart positionalArgs=[argument] /> />
        val sources = if !second && (scenario == "viewArgumentDuplicate" || scenario == "viewNestedDuplicate") { give [source, source] } else { give [source] }
        val viewed = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=sources />)
        if scenario == "viewNestedDuplicate" {
            val boxName = compiler.internBytes(s: "Box")
            val box = compiler.arena.structAt(index: compiler.arena.firstStructNamed(nameId: boxName.nameId))
            return compiler.pushType(t: <TypeRef nameStart=box.nameStart nameLen=box.nameLen args=[viewed] hasDecl=true declOffset=box.defOffset />)
        }
        return viewed
    }
    if scenario == "projectionMirror" {
        val name = compiler.internBytes(s: "FirstView")
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: name.nameId))
        val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
        val member = compiler.internBytes(s: "Item")
        val extension = compiler.internBytes(s: if second { give "F" } else { give "E" })
        return compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] projectionReceiver=integer assocTraitStart=declaration.nameStart assocTraitLen=declaration.nameLen assocTraitId=declaration.nameId assocNameId=member.nameId hasAssocTraitDecl=true assocTraitDeclOffset=declaration.nameStart viewSources=[<ResolvedViewSource surfaceId=extension.nameId />] />)
    }
    if scenario == "viewSameSpellingDistinct" {
        val name = compiler.internBytes(s: "P")
        mut val index = compiler.decls.firstTraitNamed(nameId: name.nameId)
        if second {
            index += 1U64
            while index < compiler.decls.traitCount() && compiler.decls.traitAt(index: index).nameId != name.nameId { index += 1U64 }
        }
        if index >= compiler.decls.traitCount() { panic("missing independent P owner") }
        val declaration = compiler.decls.traitAt(index: index)
        return compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=[<ResolvedViewSource surfaceId=declaration.nameId traitInstance=<TraitInstanceKey owner=declaration.nameStart positionalArgs=[] /> />] />)
    }
    if scenario == "viewSame" || scenario == "viewDistinct" {
        val text = if second && scenario == "viewDistinct" { give "SecondView" } else { give "FirstView" }
        val name = compiler.internBytes(s: text)
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: name.nameId))
        return compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=[<ResolvedViewSource surfaceId=declaration.nameId traitInstance=<TraitInstanceKey owner=declaration.nameStart positionalArgs=[] /> />] />)
    }
    val extension = compiler.internBytes(s: "E")
    if second && scenario == "extensionLegacy" {
        return compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewExtId=extension.nameId viewIds=[extension.nameId] />)
    }
    val other = compiler.internBytes(s: "F")
    val sources = if scenario == "extensionSet" {
        give if second {
            give [<ResolvedViewSource surfaceId=other.nameId />, <ResolvedViewSource surfaceId=extension.nameId />, <ResolvedViewSource surfaceId=other.nameId />]
        } else { give [<ResolvedViewSource surfaceId=extension.nameId />, <ResolvedViewSource surfaceId=other.nameId />] }
    } else if second && scenario == "extensionDistinct" { give [<ResolvedViewSource surfaceId=other.nameId />] }
    else { give [<ResolvedViewSource surfaceId=extension.nameId />] }
    return compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=sources />)
}

fn main() {
    val scenario = argAt(1I64)
    mut val compiler = <Comp />
    if scenario == "viewSameSpellingDistinct" {
        analyzeFrontend(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/TraitCycleViews/Main.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />).unwrap()
    } else {
    analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text="trait A[Item] {{}} trait B[Item] {{}} struct Box[T] {{}} struct Other[T] {{}} trait FirstView {{ type Item }} trait SecondView {{}} trait ParameterView[Kind] {{}} extension E {{ impl A[Bool] as B[Bool] {{}} }} extension F {{ impl A[Bool] as B[Bool] {{}} }} fn main() {{}}" path="CanonicalInput.pw" />, sources: <SourceAccess />).unwrap()
    }
    val subject = compiler.decls.traitAt(index: 0U64)
    val target = compiler.decls.traitAt(index: 1U64)
    val boxName = compiler.internBytes(s: "Box")
    val box = compiler.arena.structAt(index: compiler.arena.firstStructNamed(nameId: boxName.nameId))
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
    val viewScenario = scenario == "viewNestedDuplicate" || scenario == "viewArgumentSame" || scenario == "viewArgumentDistinct" || scenario == "viewArgumentDuplicate" || scenario == "projectionMirror" || scenario == "viewSameSpellingDistinct" || scenario == "viewSame" || scenario == "viewDistinct" || scenario == "extensionLegacy" || scenario == "extensionSet" || scenario == "extensionDistinct"
    val recordScenario = scenario == "recordSame" || scenario == "recordLabelDistinct" || scenario == "recordChildDistinct"
    val field = compiler.internBytes(s: "field")
    val canonical = if viewScenario {
        give viewArgument(compiler: inout compiler, integerName: integerName, scenario: scenario, second: false)
    } else if recordScenario {
        val layout = compiler.internBytes(s: "RecordLayoutOne")
        give compiler.pushType(t: <TypeRef nameStart=layout.nameStart nameLen=layout.nameLen args=[] isRecord=true recordFieldLabels=[field.nameId] recordFieldTerms=[integer] />)
    } else {
        give compiler.pushType(t: <TypeRef nameStart=box.nameStart nameLen=box.nameLen args=[integer] hasDecl=true declOffset=box.defOffset />)
    }
    val other = if scenario == "legacy" {
        give compiler.pushType(t: <TypeRef nameStart=box.nameStart nameLen=box.nameLen args=[integer] />)
    } else if scenario == "same" {
        give canonical
    } else if scenario == "distinct" {
        val name = compiler.internBytes(s: "Other")
        val declaration = compiler.arena.structAt(index: compiler.arena.firstStructNamed(nameId: name.nameId))
        give compiler.pushType(t: <TypeRef nameStart=declaration.nameStart nameLen=declaration.nameLen args=[integer] hasDecl=true declOffset=declaration.defOffset />)
    } else if viewScenario {
        give viewArgument(compiler: inout compiler, integerName: integerName, scenario: scenario, second: true)
    } else if recordScenario {
        val layout = compiler.internBytes(s: "RecordLayoutTwo")
        val label = if scenario == "recordLabelDistinct" { give compiler.internBytes(s: "otherField").nameId } else { give field.nameId }
        val child = if scenario == "recordChildDistinct" {
            val booleanName = compiler.internBytes(s: "Bool")
            give compiler.pushType(t: <TypeRef nameStart=booleanName.nameStart nameLen=booleanName.nameLen args=[] />)
        } else { give integer }
        give compiler.pushType(t: <TypeRef nameStart=layout.nameStart nameLen=layout.nameLen args=[] isRecord=true recordFieldLabels=[label] recordFieldTerms=[child] />)
    } else { panic("unknown test scenario") }
    val distinct = scenario == "viewArgumentDistinct" || scenario == "viewSameSpellingDistinct" || scenario == "viewDistinct" || scenario == "extensionDistinct" || scenario == "distinct" || scenario == "recordLabelDistinct" || scenario == "recordChildDistinct"
    appendEdge(compiler: inout compiler, subject: subject, target: target, argument: canonical)
    appendEdge(compiler: inout compiler, subject: target, target: subject, argument: other)
    match compiler.checkTraitSubjectCycles(activeExtIds: []) {
        Result.Ok(value: _) => {
            if !distinct { panic("same canonical owner did not close the cycle") }
        }
        Result.Err(error: val diagnostic) => {
            if distinct || diagnostic.message != "trait-to-trait conformance cycle" {
                emitDiagnostic(diagnostic: diagnostic)
                panic("wrong canonical identity result")
            }
        }
    }
    if scenario == "viewArgumentDuplicate" || scenario == "viewNestedDuplicate" {
        val original = if scenario == "viewNestedDuplicate" { give compiler.typeTermRefChildRef(ref: canonical, index: 0U64) } else { give canonical }
        if compiler.arena.typeAt(index: original).viewSources.count() != 2U64 { panic("admission rewrote the raw view input") }
    }
    print("canonical graph identity retained")
}
