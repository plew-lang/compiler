use @Plew/Syntax as LexicalProbeSyntax
// Bare lexical associated names must retain their declaring Self root.
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path="tests/compiler/frontend/fixtures/ProjectionMembers/BareLexical.pw" />, sources: <SourceAccess stdRoot="std/".bytes() />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic("lexical setup rejected: "+diagnostic.message()) }
    }
    val child = compiler.internBytes(s: "Child").nameId
    val parent = compiler.internBytes(s: "Parent").nameId
    mut val found = false
    for index in 0U64..<compiler.decls.traitCount() {
        val trait = compiler.decls.traitAt(index: index)
        if trait.nameId != child { continue }
        val requirement = compiler.traitReqAt(reqs: trait.reqs, index: 0U64)
        val parameter = compiler.funcParamAt(params: requirement.params, index: 0U64)
        val saved = compiler.retainedAssociatedSelection(occurrence: parameter.authoredTypeUse, ref: parameter.ty).unwrap()
        if saved.isNone() { panic("bare lexical associated selection was not retained") }
        val selected = saved.unwrap()
        if selected.graph.roots[0U64].constraint.key.owner != trait.nameStart { panic("lexical selection lost original Child Self root") }
        match selected.outcome {
            AssociatedMemberOutcome.Unique(candidate: val candidate) => {
                val owner = compiler.decls.traitIndexByOffset(offset: candidate.instance.owner)
                if compiler.decls.traitAt(index: owner).nameId != parent { panic("lexical selection lost declaring Parent") }
            }
            _ => { panic("lexical associated selection was not unique") }
        }
        val nested = compiler.traitReqAt(reqs: trait.reqs, index: 1U64)
        val nestedParameter = compiler.funcParamAt(params: nested.params, index: 0U64)
        val nestedUse = compiler.sourceTypeUses.useAt(index: nestedParameter.authoredTypeUse-1U64).unwrap()
        val nestedRecipe = compiler.sourceTypeUses.recipeAt(id: nestedUse.recipe).unwrap()
        val receiverRecipe = compiler.sourceTypeUses.recipeAt(id: nestedRecipe.children[0U64]).unwrap()
        val receiverSelection = compiler.retainedAssociatedSelection(occurrence: receiverRecipe.occurrence, ref: receiverRecipe.term).unwrap().unwrap()
        if receiverSelection.graph.roots[0U64].constraint.key.owner != trait.nameStart { panic("nested lexical receiver lost original Child Self root") }
        val occurrence = compiler.sourceTypeUses.useAt(index: parameter.authoredTypeUse-1U64).unwrap()
        val recipe = compiler.sourceTypeUses.recipeAt(id: occurrence.recipe).unwrap()
        val savedScope = compiler.sourceTypeUses.currentScope()
        val savedOwner = compiler.lowerAssociatedOwner
        val savedArguments = compiler.lowerAssociatedArgs
        compiler.sourceTypeUses.selectionProbeScope(scope: occurrence.scope)
        compiler.lowerAssociatedOwner = trait.nameStart
        compiler.lowerAssociatedArgs = []
        match compiler.captureLoweredLexicalSelection(ref: parameter.ty, site: occurrence.site, children: recipe.children, declaration: <Optional.None />) {
            Result.Err(error: val diagnostic) => { if diagnostic.message() != "lexical selection lost its prepared result" { panic("missing lexical handoff changed failure cause") } }
            Result.Ok(value: _) => { panic("lexical capture reconstructed a missing selection") }
        }
        val draft = compiler.retainedLoweredAssociatedSelection(occurrence: parameter.authoredTypeUse, ref: parameter.ty).unwrap().unwrap()
        match draft.representation { AssociatedSelectionRepresentation.Declaring => {} _ => { panic("lexical saved projection lost its declaring representation") } }
        val wrongRepresentation = <PreparedAssociatedMemberSelection site=occurrence.site receiver=draft.receiver member=draft.member session=draft.session scope=draft.scope representationRoot=draft.representationRoot representation=<AssociatedSelectionRepresentation.Root /> equationClauses=draft.equationClauses result=selected />
        match compiler.captureLoweredAssociatedSelection(ref: parameter.ty, site: occurrence.site, children: recipe.children, prepared: <Optional.Some v=wrongRepresentation />) {
            Result.Err(error: val diagnostic) => { if diagnostic.message() != "prepared associated selection changed its representation" { panic("wrong lexical representation lost its refusal cause") } }
            Result.Ok(value: _) => { panic("lexical declaring term was accepted as its source root") }
        }
        compiler.sourceTypeUses.selectionProbeScope(scope: savedScope)
        compiler.lowerAssociatedOwner = savedOwner
        compiler.lowerAssociatedArgs = savedArguments
        // Missing preparation is not a successful absence of a lexical member.
        val completed = compiler.decls.queryProbeTraitEntry(owner: trait.nameStart)
        val header = compiler.traitLexicalHeaders.get(key: trait.nameStart)
        compiler.decls.setQueryProbeTraitEntry(owner: trait.nameStart, entry: 0U64)
        compiler.traitLexicalHeaders.remove(key: trait.nameStart)
        val originalOwner = compiler.lowerAssociatedOwner
        val originalArguments = compiler.lowerAssociatedArgs
        compiler.lowerAssociatedOwner = trait.nameStart
        compiler.lowerAssociatedArgs = []
        val written = compiler.arena.typeAt(index: parameter.ty)
        val unavailable = compiler.lowerLexicalAssociatedType(nameStart: written.assocNameStart, nameLen: written.assocNameLen, paramId: 0U64)
        compiler.lowerAssociatedOwner = originalOwner
        compiler.lowerAssociatedArgs = originalArguments
        compiler.decls.setQueryProbeTraitEntry(owner: trait.nameStart, entry: completed)
        match header { Optional.Some(v: val savedHeader) => { compiler.traitLexicalHeaders[trait.nameStart] = savedHeader } Optional.None => {} }
        match unavailable {
            Result.Err(error: val diagnostic) => { match diagnostic.failureDomain() { FailureDomain.Limit => {} _ => { panic("lexical unavailable namespace lost its preparation failure") } } }
            Result.Ok(value: _) => { panic("lexical unavailable namespace became missing") }
        }
        found = true
    }
    if !found { panic("lexical requirement setup missing") }
    val genericOwner = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: compiler.internBytes(s: "GenericChild").nameId))
    val genericParameter = compiler.funcParamAt(params: compiler.traitReqAt(reqs: genericOwner.reqs, index: 0U64).params, index: 0U64)
    val genericDraft = compiler.retainedLoweredAssociatedSelection(occurrence: genericParameter.authoredTypeUse, ref: genericParameter.ty).unwrap().unwrap()
    if genericDraft.authoredArguments.count() != 1U64 || genericDraft.termArguments.count() != 0U64 { panic("lexical root recipes were replaced by declaring argument recipes") }
    checkValueLexicalNamespace()

}

fn checkValueLexicalNamespace() {
    val source = "trait Parent[A] {{ type Output }}\ntrait Child: Parent[I64] {{ fn item(value: Output) }}\ntrait Local[C]: Parent[Item] {{ type Item fn local(value: Item) }}"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val items = LexicalProbeSyntax.parseProgramAst(p: inout parser)
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    compiler.appendSrc(from: source.bytes())
    mut val bindings = <ModuleScopeBindings />
    for item in items {
        match item {
            TopItemAst.Trait(t: val trait) => { bindings.addDeclaration(moduleId: 0U64, nameId: compiler.internBytes(s: trait.name).nameId, kind: <ScopeBindingKind.Trait />, offset: trait.nameSpan.start, isPublic: false).unwrap() }
            _ => {}
        }
    }
    compiler.moduleScopeBindings = <Optional.Some v=bindings.finish().unwrap() />
    compiler.prepareValueTraitItems(items: items).unwrap()
    for item in items { compiler.lowerTopItem(item: item).unwrap() }
    val local = compiler.decls.traitAt(index: 2U64)
    val localParameter = compiler.funcParamAt(params: compiler.traitReqAt(reqs: local.reqs, index: 0U64).params, index: 0U64)
    val localDraft = compiler.retainedLoweredAssociatedSelection(occurrence: localParameter.authoredTypeUse, ref: localParameter.ty).unwrap().unwrap()
    match localDraft.resolution { LoweredAssociatedResolution.Declaration(binding: val binding) => { if binding.owner != local.nameStart || binding.arguments.count() != 1U64 { panic("Value lexical binder lost its identity") } } _ => { panic("Value lexical binder became a query") } }
    val child = compiler.decls.traitAt(index: 1U64)
    val requirement = compiler.traitReqAt(reqs: child.reqs, index: 0U64)
    val parameter = compiler.funcParamAt(params: requirement.params, index: 0U64)
    val selection = compiler.retainedAssociatedSelection(occurrence: parameter.authoredTypeUse, ref: parameter.ty).unwrap().unwrap()
    match selection.outcome {
        AssociatedMemberOutcome.Unique(candidate: val candidate) => {
            if candidate.instance.owner != compiler.decls.traitAt(index: 0U64).nameStart || candidate.instance.positionalArgs.count() != 1U64 { panic("Value lexical namespace lost its declaring instance") }
        }
        _ => { panic("Value lexical namespace did not select its inherited member") }
    }
}
