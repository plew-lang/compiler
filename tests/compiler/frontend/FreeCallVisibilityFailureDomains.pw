use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, openFrontend }
use ../../../src/CheckedProgram only { CompilerSession, CompilerSessionResult, ProgramCheckResult, checkCompilerSession }
use ../../../src/Backend only { LlvmLoweringResult }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Diag only { CompileDiagnostic, FailureDomain, FreeCallVisibilityRefusal, FreeCallVisibilityKind, DiagnosticOwner, DiagnosticLocation, DiagnosticNote }
use ../../../src/Ir only { Arg, ArgRange, Expr, SyntheticCallSite }
use @Std/Io only { print }
fn requireUnclassified(diagnostic: CompileDiagnostic, message: String) {
    match diagnostic.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("raw refusal domain was lost") } }
    if diagnostic.isSourceRejection() || diagnostic.message() != message { panic(diagnostic.message()) }
}
fn requireSource(diagnostic: CompileDiagnostic, message: String) {
    if !diagnostic.isSourceRejection() || diagnostic.message() != message { panic("free-call visibility source origin was lost") }
}
fn session(input: FrontendInput, stdRoot: String = "std/") -> CompilerSession {
    match CompilerSession.open(input: input, sources: <SourceAccess stdRoot=stdRoot.bytes() />) { CompilerSessionResult.Success(session: val session) => { return move session } CompilerSessionResult.Failure(diagnostic: val diagnostic) => { panic(diagnostic.message()) } }
}
fn run(input: FrontendInput, message: String, functionName: String = "main", lazyRequested: Bool = true, stdRoot: String = "std/", closureOwner: Bool = false, zeroExpression: Bool = false, qualified: Bool = false) {
    mut val raw = <Comp />
    match analyzeFrontendForRequests(c: inout raw, input: input, sources: <SourceAccess stdRoot=stdRoot.bytes() />) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message()) } }
    val name = raw.internBytes(s: functionName)
    val function = raw.arena.firstFunctionNamed(nameId: name.nameId)
    for count in 0U64..<2U64 {
        match raw.prepareLexicalBody(fnIdx: function) {
            Result.Err(error: val diagnostic) => {
                requireUnclassified(diagnostic: diagnostic, message: message)
                val refusal = diagnostic.freeCallVisibility().unwrap()
                if qualified { namespaceRewriteControls(compiler: raw, refusal: refusal) }
                if !raw.sourceFailureHasOwner(diagnostic: diagnostic) { panic("shared observer lost retained cause") }
                if zeroExpression && refusal.expression() != 0U64 { panic("zero-expression fixture changed") }
                if closureOwner { match refusal.owner() { DiagnosticOwner.Closure(expression: _) => {} _ => { panic("closure refusal lost owner kind") } } }
                for domain in [<FailureDomain.Unclassified />, <FailureDomain.Internal />, <FailureDomain.Limit />, <FailureDomain.Source />] {
                    val report = <CompileDiagnostic failureDomain=domain location=refusal.location() message=message notes=[<DiagnosticNote location=refusal.location() message="retained note" />] />
                    if raw.sourceFailureHasOwner(diagnostic: report) { panic("plain report acquired cause evidence") }
                    if report.notes().count() != 1U64 { panic("plain report note lost") }
                }
                mut val observation = <Comp />
                analyzeFrontendForRequests(c: inout observation, input: input, sources: <SourceAccess stdRoot=stdRoot.bytes() />).unwrap()
                match observation.checkExpressionVisibility(exprId: refusal.expression()) {
                    Result.Err(error: val report) => {
                        requireUnclassified(diagnostic: report, message: message)
                        if observation.sourceFailureHasOwner(diagnostic: report) { panic("raw-only observation created evidence") }
                    }
                    Result.Ok(value: _) => { panic("raw-only observation lost diagnostic") }
                }
                if observation.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=observation.sourceFactSession() owner=refusal.owner() expression=refusal.expression() kind=refusal.kind() argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("public cause created private failed event") }
                if raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=refusal.expression() kind=refusal.kind() argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=<DiagnosticLocation.Unpositioned /> />) { panic("forged location accepted") }
                if !raw.sourceFreeCallVisibilityHasOwner(refusal: refusal) { panic("retained binding failure lost provenance") }
                if raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() + 1U64 owner=refusal.owner() expression=refusal.expression() kind=refusal.kind() argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("foreign session accepted") }
                if raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=<DiagnosticOwner.Unknown /> expression=refusal.expression() kind=refusal.kind() argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("unknown owner accepted") }
                if raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=raw.arena.exprs.count() kind=refusal.kind() argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("foreign expression accepted") }
                if raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=refusal.expression() kind=refusal.kind() argumentsStart=refusal.argumentsStart() + 1U64 argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("foreign arguments accepted") }
                if raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=refusal.expression() kind=refusal.kind() argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() + 1U64 location=refusal.location() />) { panic("foreign argument count accepted") }
                if !refusal.kind().same(other: <FreeCallVisibilityKind.UnimportedFunction />) && raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=refusal.expression() kind=<FreeCallVisibilityKind.UnimportedFunction /> argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("foreign kind accepted") }
                if !refusal.kind().same(other: <FreeCallVisibilityKind.NonAmbientStd />) && raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=refusal.expression() kind=<FreeCallVisibilityKind.NonAmbientStd /> argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("foreign kind accepted") }
                if !refusal.kind().same(other: <FreeCallVisibilityKind.PrivateFunction />) && raw.sourceFreeCallVisibilityHasOwner(refusal: <FreeCallVisibilityRefusal session=refusal.session() owner=refusal.owner() expression=refusal.expression() kind=<FreeCallVisibilityKind.PrivateFunction /> argumentsStart=refusal.argumentsStart() argumentsCount=refusal.argumentsCount() location=refusal.location() />) { panic("foreign kind accepted") }
                match raw.checkExpressionVisibility(exprId: refusal.expression()) {
                    Result.Err(error: val observed) => {
                        requireUnclassified(diagnostic: observed, message: message)
                        if observed.freeCallVisibility().isSome() { panic("raw observation emitted owned cause") }
                        if !raw.sourceFreeCallVisibilityHasOwner(refusal: refusal) { panic("raw observation overwrote owned failure") }
                    }
                    Result.Ok(value: _) => { panic("raw visibility accepted denied call") }
                }
                match raw.arena.exprs[refusal.expression()] {
                    Expr.Call(nameStart: val start, nameLen: val length, args: val args) => {
                        mut val changed = raw
                        changed.arena.exprs.set(i: refusal.expression(), value: <Expr.Call nameStart=start + 1U64 nameLen=length args=args />)
                        if changed.sourceFreeCallVisibilityHasOwner(refusal: refusal) { panic("changed call spelling accepted") }
                        mut val ranged = raw
                        ranged.arena.exprs.set(i: refusal.expression(), value: <Expr.Call nameStart=start nameLen=length args=<ArgRange start=args.start + 1U64 len=args.len /> />)
                        if ranged.sourceFreeCallVisibilityHasOwner(refusal: refusal) { panic("changed authored argument range accepted") }
                        mut val synthetic = raw
                        synthetic.recordSyntheticCallSite(site: <SyntheticCallSite exprId=refusal.expression() receiverTerm=0U64 />).unwrap()
                        if synthetic.sourceFreeCallVisibilityHasOwner(refusal: refusal) { panic("synthetic operation inherited source origin") }
                    }
                    _ => { panic("visibility failure lost call identity") }
                }
                if refusal.argumentsCount() != 0U64 {
                    val original = raw.arena.argPool[refusal.argumentsStart()]
                    mut val changed = raw
                    changed.arena.argPool.set(i: refusal.argumentsStart(), value: <Arg expr=original.expr isInout=!original.isInout hasLabel=original.hasLabel labelStart=original.labelStart labelLen=original.labelLen />)
                    if changed.sourceFreeCallVisibilityHasOwner(refusal: refusal) { panic("modified argument reused a failed selection") }
                }
                val internal = <CompileDiagnostic failureDomain=<FailureDomain.Internal /> location=refusal.location() message=message />
                if internal.freeCallVisibility().isSome() || internal.isSourceRejection() { panic("equal text gained source authority") }
                raw.pendingDiagnostics.append(diagnostic)
            }
            Result.Ok(value: _) => { panic("free-call visibility became ready") }
        }
        val drained = raw.takeDiagnostics()
        if drained.count() != 1U64 { panic("drain changed failure count") }
        requireUnclassified(diagnostic: drained[0U64], message: message)
    }
    mut val owned = session(input: input, stdRoot: stdRoot)
    match owned.lowerDeclarations() { LlvmLoweringResult.Success(module: _) => {} LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { panic(diagnostic.message()) } }
    mut val failed = false
    mut val bodyIndex = 0U64
    while true {
        val bodies = owned.registeredBodies()
        if bodyIndex >= bodies.count() { break }
        val body = bodies[bodyIndex]
        bodyIndex += 1U64
        match owned.prepareBodyAccess(bodyId: body) {
            Result.Err(error: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) failed = true }
            Result.Ok(value: _) => {}
        }
    }
    if failed != lazyRequested { panic("owned capture request coverage changed") }
    match checkCompilerSession(session: move owned) { ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) } ProgramCheckResult.Success(program: _) => { panic("failed session became checked") } }
    match checkCompilerSession(session: session(input: input, stdRoot: stdRoot)) { ProgramCheckResult.Failure(diagnostic: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) } ProgramCheckResult.Success(program: _) => { panic("whole check accepted free-call visibility") } }
    match openFrontend(input: input, sources: <SourceAccess stdRoot=stdRoot.bytes() />) { Result.Err(error: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) } Result.Ok(value: _) => { panic("eager source accepted free-call visibility") } }
    print("free-call visibility origin retained")
}
fn globalFailure() {
    val input = <FrontendInput.Text text="val value: () = exit() fn main() {{}}" path="visibility-global.pw" />
    val message = <FreeCallVisibilityKind.NonAmbientStd />.message()
    mut val raw = <Comp />
    analyzeFrontendForRequests(c: inout raw, input: input, sources: <SourceAccess />).unwrap()
    if raw.arena.globals.count() != 1U64 { panic("global fixture changed") }
    val target = raw.arena.globals[0U64].nameStart
    for attempt in 0U64..<2U64 {
        match raw.prepareGlobalInitializer(target: target) {
            Result.Ok(value: _) => { panic("invisible global initializer accepted") }
            Result.Err(error: val diagnostic) => {
                requireUnclassified(diagnostic: diagnostic, message: message)
                val cause = diagnostic.freeCallVisibility().unwrap()
                if !raw.sourceFailureHasOwner(diagnostic: diagnostic) { panic("global failure lost evidence") }
                match cause.owner() { DiagnosticOwner.Global(target: val owner) => { if owner != target { panic("global cause chose wrong initializer") } } _ => { panic("global cause lost owner") } }
            }
        }
    }
    match CompilerSession.open(input: input, sources: <SourceAccess />) {
        CompilerSessionResult.Failure(diagnostic: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) }
        CompilerSessionResult.Success(session: val opened) => {
            mut val owned = move opened
            match owned.lowerDeclarations() { LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) } LlvmLoweringResult.Success(module: _) => { panic("global failure was not requested") } }
        }
    }
    match openFrontend(input: input, sources: <SourceAccess />) { Result.Err(error: val diagnostic) => { requireSource(diagnostic: diagnostic, message: message) } Result.Ok(value: _) => { panic("eager global accepted invisible call") } }
    print("global free-call visibility origin retained")
}
fn namespaceRewriteControls(compiler: Comp, refusal: FreeCallVisibilityRefusal) {
    mut val original = compiler
    val call = original.arena.exprs[refusal.expression()]
    val args = match call { Expr.Call(nameStart: _, nameLen: _, args: val args) => args _ => { panic("qualified call was not normalized") } }
    val start = match call { Expr.Call(nameStart: val start, nameLen: _, args: _) => start _ => { panic("qualified selector missing") } }
    val length = match call { Expr.Call(nameStart: _, nameLen: val length, args: _) => length _ => { panic("qualified selector missing") } }
    val useIndex = original.modules.qualifiedUseIndex(offset: start)
    if useIndex >= original.modules.qualifiedUseCount() { panic("qualified module provenance missing") }
    val module = original.modules.qualifiedUseAt(index: useIndex).targetModule
    mut val receiver: Optional[U64] = <Optional.None />
    for index in 0U64..<original.arena.exprs.count() {
        if original.namespaceExprModule(id: index, names: []) == module { receiver = <Optional.Some v=index /> break }
    }
    val receiverId = receiver.unwrap()
    mut val unregistered = original
    val fresh = unregistered.arena.exprs.count()
    unregistered.arena.exprs.append(<Expr.Method recv=receiverId nameStart=start nameLen=length args=args />)
    mut val names: Array[U64] = []
    unregistered.resolveLexicalModuleExpr(id: fresh, names: inout names)
    match unregistered.arena.exprs[fresh] { Expr.Call(nameStart: _, nameLen: _, args: _) => {} _ => { panic("raw namespace control did not rewrite") } }
    if unregistered.isAuthoredFreeCall(exprId: fresh, start: start, length: length, args: args) { panic("unregistered namespace Method became authored") }
    mut val synthetic = original
    synthetic.arena.exprs.set(i: refusal.expression(), value: <Expr.Method recv=receiverId nameStart=start nameLen=length args=args />)
    synthetic.recordSyntheticCallSite(site: <SyntheticCallSite exprId=refusal.expression() receiverTerm=0U64 />).unwrap()
    synthetic.resolveLexicalModuleExpr(id: refusal.expression(), names: inout names)
    if synthetic.isAuthoredFreeCall(exprId: refusal.expression(), start: start, length: length, args: args) { panic("synthetic namespace Method became authored") }
    mut val shadowed = original
    val shadow = shadowed.arena.exprs.count()
    shadowed.arena.exprs.append(<Expr.Method recv=receiverId nameStart=start nameLen=length args=args />)
    val local = shadowed.internBytes(s: "Lib")
    mut val locals: Array[U64] = [local.nameId]
    shadowed.resolveLexicalModuleExpr(id: shadow, names: inout locals)
    match shadowed.arena.exprs[shadow] { Expr.Method(recv: _, nameStart: _, nameLen: _, args: _) => {} _ => { panic("local namespace shadow was rewritten") } }
}
fn main() {
    run(input: <FrontendInput.File path="tests/fixtures/reject/eprint_not_imported.pw" />, message: <FreeCallVisibilityKind.NonAmbientStd />.message())
    run(input: <FrontendInput.File path="tests/fixtures/reject/assert_not_imported.pw" />, message: <FreeCallVisibilityKind.UnimportedFunction />.message())
    run(input: <FrontendInput.File path="tests/fixtures/partreject/import_overload_private_label/Main.pw" />, message: <FreeCallVisibilityKind.PrivateFunction />.message())
    run(input: <FrontendInput.Text text="fn main() {{ exit() }}" path="visibility-zero.pw" />, message: <FreeCallVisibilityKind.NonAmbientStd />.message(), stdRoot: "", zeroExpression: true)
    run(input: <FrontendInput.Text text="fn main() {{ val callback = fn() {{ exit() }} callback() }}" path="visibility-closure.pw" />, message: <FreeCallVisibilityKind.NonAmbientStd />.message(), closureOwner: true)
    run(input: <FrontendInput.Text text="fn unused() {{ exit() }} fn main() {{}}" path="visibility-unused.pw" />, message: <FreeCallVisibilityKind.NonAmbientStd />.message(), functionName: "unused", lazyRequested: false)
    run(input: <FrontendInput.File path="tests/fixtures/partreject/import_private_qualified/Main.pw" />, message: <FreeCallVisibilityKind.PrivateFunction />.message(), qualified: true)
    globalFailure()
}
