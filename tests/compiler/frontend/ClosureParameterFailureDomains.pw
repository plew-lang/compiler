use ../../../src/Frontend only { FrontendInput, openFrontend }
use ../../../src/CheckedProgram only { CompilerSession, CompilerSessionResult, ProgramCheckResult, checkCompilerSession }
use ../../../src/Backend only { LlvmLoweringResult }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Diag only { CompileDiagnostic, DiagnosticLocation }
fn closureFailure(diagnostic: CompileDiagnostic) {
    if !diagnostic.isSourceRejection() || diagnostic.notes().count() != 1U64 || diagnostic.message() != "duplicate parameter binding name (each parameter in a group must have a distinct name)" { panic("closure group failure lost source origin") }
}
fn sameLocation(actual: DiagnosticLocation, expected: DiagnosticLocation) {
    match actual {
        DiagnosticLocation.File(path: val path, line: val line) => {
            match expected {
                DiagnosticLocation.File(path: val expectedPath, line: val expectedLine) => { if path != expectedPath || line != expectedLine { panic("parameter group location changed in session") } }
                _ => { panic("reference parameter group location lost") }
            }
        }
        _ => { panic("session parameter group location lost") }
    }
}
fn sameClosureFailure(first: CompileDiagnostic, second: CompileDiagnostic) {
    closureFailure(diagnostic: first)
    closureFailure(diagnostic: second)
    sameLocation(actual: first.location(), expected: second.location())
    sameLocation(actual: first.notes()[0U64].location, expected: second.notes()[0U64].location)
    if first.notes()[0U64].message != second.notes()[0U64].message { panic("closure note changed") }
}

fn closureSession(input: FrontendInput) -> CompilerSession {
    match CompilerSession.open(input: input, sources: <SourceAccess stdRoot="std/".bytes() />) {
        CompilerSessionResult.Success(session: val session) => { return move session }
        CompilerSessionResult.Failure(diagnostic: val diagnostic) => { panic(diagnostic.message()) }
    }
}
fn main() {
    val input = <FrontendInput.File path="tests/compiler/frontend/fixtures/ClosureParameterGroups/Main.pw" />
    mut val owned = closureSession(input: input)
    match owned.lowerDeclarations() { LlvmLoweringResult.Success(module: _) => {} LlvmLoweringResult.Failure(diagnostic: val diagnostic) => { panic(diagnostic.message()) } }
    mut val failed = false
    for body in owned.registeredBodies() {
        match owned.prepareBodyAccess(bodyId: body) {
            Result.Err(error: val first) => {
                closureFailure(diagnostic: first)
                failed = true
                match owned.prepareBodyAccess(bodyId: body) { Result.Err(error: val second) => { sameClosureFailure(first: first, second: second) } Result.Ok(value: _) => { panic("retry published refused closure") } }
            }
            Result.Ok(value: _) => {}
        }
    }
    if !failed { panic("session did not check closure") }
    match checkCompilerSession(session: move owned) { ProgramCheckResult.Failure(diagnostic: val diagnostic) => { closureFailure(diagnostic: diagnostic) } ProgramCheckResult.Success(program: _) => { panic("refused session became checked") } }
    match openFrontend(input: input, sources: <SourceAccess stdRoot="std/".bytes() />) { Result.Err(error: val diagnostic) => { closureFailure(diagnostic: diagnostic) } Result.Ok(value: _) => { panic("eager check admitted closure group") } }
}
