use ../../../src/Frontend only { Comp, FrontendInput, analyzeFrontend }
use ../../../src/SourceAccess only { SourceAccess }
use ../../../src/Ir only { Bind, Conform, TypeRef, ResolvedViewSource, TraitInstanceKey }
use ../../../src/Diag only { FailureDomain, emitDiagnostic }
use @Std/Io only { print }
use @Std/Process only { argAt }

fn main() {
    val scenario = argAt(1I64)
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text="trait A[Item] {{}} trait B[Item] {{}} trait Projection {{ type Item }} struct Box[T] {{}} extension E {{ impl A[I64] as B[I64] {{}} }} fn main() {{}}" path="PatternInput.pw" />, sources: <SourceAccess />).unwrap()
    val subject = compiler.decls.traitAt(index: 0U64)
    val target = compiler.decls.traitAt(index: 1U64)
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
    val parameterName = compiler.internBytes(s: "T")
    val identity = compiler.nextParamId
    compiler.nextParamId += 2U64
    val parameter = <Bind nameStart=parameterName.nameStart nameLen=parameterName.nameLen nameId=parameterName.nameId paramId=identity fieldStart=0U64 fieldLen=0U64 />
    mut val parameters: Array[Bind] = [parameter]
    mut val argument = integer
    mut val expected = ""
    if scenario == "viewArity" || scenario == "viewArgumentRef" || scenario == "extensionArguments" || scenario == "viewArgumentBinder" || scenario == "differentViewInstances" {
        val extension = compiler.internBytes(s: "E")
        val selectorArgument = if scenario == "viewArgumentRef" { give 999999U64 } else if scenario == "viewArgumentBinder" {
            give compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=identity + 1U64 args=[] />)
        } else { give integer }
        val arguments: Array[U64] = if scenario == "viewArity" { give [] } else { give [selectorArgument] }
        val source = if scenario == "extensionArguments" {
            give <ResolvedViewSource surfaceId=extension.nameId traitInstance=<TraitInstanceKey owner=0U64 positionalArgs=arguments /> />
        } else { give <ResolvedViewSource surfaceId=subject.nameId traitInstance=<TraitInstanceKey owner=subject.nameStart positionalArgs=arguments /> /> }
        mut val sources = [source]
        if scenario == "differentViewInstances" {
            val booleanName = compiler.internBytes(s: "Bool")
            val boolean = compiler.pushType(t: <TypeRef nameStart=booleanName.nameStart nameLen=booleanName.nameLen args=[] />)
            sources.append(<ResolvedViewSource surfaceId=subject.nameId traitInstance=<TraitInstanceKey owner=subject.nameStart positionalArgs=[boolean] /> />)
        }
        argument = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=sources />)
        expected = if scenario == "viewArity" { give "invalid pattern type input: view trait instance mismatch" } else if scenario == "viewArgumentRef" { give "invalid pattern type input: invalid type term reference" } else if scenario == "viewArgumentBinder" { give "invalid pattern type input: foreign lexical type parameter" } else if scenario == "extensionArguments" { give "invalid pattern type input: extension view arguments" } else { give "invalid pattern type input: multiple trait view selectors" }
    } else if scenario == "viewedBinder" {
        // A structural graph pattern may retain a view-qualified lexical
        // parameter without solving that view's receiver applicability.
        val extension = compiler.internBytes(s: "E")
        argument = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=identity args=[] viewExtId=extension.nameId viewIds=[extension.nameId] />)
    } else if scenario == "invalidViewOwner" || scenario == "viewOwnerNameMismatch" || scenario == "unknownExtension" {
        val name = compiler.internBytes(s: "Projection")
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: name.nameId))
        val owner = if scenario == "invalidViewOwner" { give 999999U64 } else if scenario == "unknownExtension" { give 0U64 } else { give declaration.nameStart }
        val surface = if scenario == "viewOwnerNameMismatch" { give subject.nameId } else if scenario == "unknownExtension" { give compiler.internBytes(s: "MissingExtension").nameId } else { give declaration.nameId }
        argument = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=[<ResolvedViewSource surfaceId=surface traitInstance=<TraitInstanceKey owner=owner positionalArgs=[] /> />] />)
        expected = if scenario == "invalidViewOwner" { give "invalid pattern type input: unresolved view trait owner" } else if scenario == "viewOwnerNameMismatch" { give "invalid pattern type input: inconsistent view trait identity" } else { give "invalid pattern type input: unresolved extension view source" }
    } else if scenario == "multipleTraitViews" || scenario == "duplicateTraitView" {
        val name = compiler.internBytes(s: "Projection")
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: name.nameId))
        val first = <ResolvedViewSource surfaceId=declaration.nameId traitInstance=<TraitInstanceKey owner=declaration.nameStart positionalArgs=[] /> />
        val second = if scenario == "multipleTraitViews" { give <ResolvedViewSource surfaceId=subject.nameId traitInstance=<TraitInstanceKey owner=subject.nameStart positionalArgs=[] /> /> } else { give first }
        argument = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] viewSources=[first, second] />)
        if scenario == "multipleTraitViews" { expected = "invalid pattern type input: multiple trait view selectors" }
    } else if scenario == "parameterArity" {
        argument = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=identity args=[integer] />)
        expected = "invalid pattern type input: constructor argument shape mismatch"
    } else if scenario == "cyclicTypeTerm" {
        val box = compiler.arena.structAt(index: 0U64)
        argument = compiler.pushType(t: <TypeRef nameStart=box.nameStart nameLen=box.nameLen args=[compiler.arena.typeCount()] hasDecl=true declOffset=box.defOffset />)
        expected = "invalid pattern type input: cyclic type term input"
    } else if scenario == "foreignBinder" {
        argument = compiler.pushType(t: <TypeRef nameStart=parameterName.nameStart nameLen=parameterName.nameLen paramId=identity + 1U64 args=[] />)
        expected = "invalid pattern type input: foreign lexical type parameter"
    } else if scenario == "duplicateBinder" {
        parameters.append(parameter)
        expected = "invalid trait-cycle input: duplicate lexical type parameter"
    } else if scenario == "nominalArity" {
        val box = compiler.arena.structAt(index: 0U64)
        argument = compiler.pushType(t: <TypeRef nameStart=box.nameStart nameLen=box.nameLen args=[] hasDecl=true declOffset=box.defOffset />)
        expected = "invalid pattern type input: nominal argument arity mismatch"
    } else if scenario == "nameIdentity" {
        argument = compiler.arena.registerType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen nameId=parameterName.nameId args=[] />, nameCount: compiler.interner.entries.count())
        expected = "invalid pattern type input: inconsistent type name identity"
    } else if scenario == "binderNameIdentity" {
        parameters = [<Bind nameStart=integerName.nameStart nameLen=integerName.nameLen nameId=parameterName.nameId paramId=identity fieldStart=0U64 fieldLen=0U64 />]
        expected = "invalid trait-cycle input: invalid lexical type parameter"
    } else if scenario == "primitiveArity" {
        argument = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[integer] />)
        expected = "invalid pattern type input: constructor argument shape mismatch"
    } else if scenario == "functionArity" {
        val functionName = compiler.internBytes(s: "fn")
        argument = compiler.pushType(t: <TypeRef nameStart=functionName.nameStart nameLen=functionName.nameLen args=[] />)
        expected = "invalid pattern type input: constructor argument shape mismatch"
    } else if scenario == "rawMissingProjectionMember" || scenario == "rawMissingMemberWithSourceSite" || scenario == "rawMissingMemberWithUseList" {
        val traitName = compiler.internBytes(s: "Projection")
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: traitName.nameId))
        val member = compiler.internBytes(s: "NoSuch")
        val site = if scenario != "rawMissingProjectionMember" { give subject.nameStart } else { give 0U64 }
        // A real source coordinate alone is not a Lower-produced type-use receipt.
        argument = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] projectionReceiver=integer assocTraitStart=declaration.nameStart assocTraitLen=declaration.nameLen assocTraitId=declaration.nameId assocNameId=member.nameId hasAssocTraitDecl=true assocTraitDeclOffset=declaration.nameStart siteOffset=site />)
        if scenario == "rawMissingMemberWithUseList" { compiler.loweringTypeUses.append(argument) }
        expected = "invalid pattern type input: unresolved projection member"
    } else if scenario == "recordProjectionInvalidChild" || scenario == "recordProjectionValid" {
        val traitName = compiler.internBytes(s: "Projection")
        val declaration = compiler.decls.traitAt(index: compiler.decls.firstTraitNamed(nameId: traitName.nameId))
        val member = compiler.internBytes(s: "Item")
        val receiver = if scenario == "recordProjectionValid" {
            give compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true />)
        } else { give 999999U64 }
        // Projection rebuilding retains a record receiver's mirror fields.
        // Those fields must never hide the semantic receiver relation.
        argument = compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true projectionReceiver=receiver assocTraitStart=declaration.nameStart assocTraitLen=declaration.nameLen assocTraitId=declaration.nameId assocNameId=member.nameId hasAssocTraitDecl=true assocTraitDeclOffset=declaration.nameStart />)
        if scenario == "recordProjectionInvalidChild" { expected = "invalid pattern type input: invalid type term reference" }
    } else { panic("unknown test scenario") }
    compiler.decls.registerConform(<Conform sourceModule=0U64 typeStart=subject.nameStart typeLen=subject.nameLen typeId=subject.nameId subjectTraitOwner=subject.nameStart typeArity=1U64 subjectArgs=compiler.pushConformTypes(types: [argument]) typeParams=compiler.pushConformBinds(binds: parameters) traitStart=target.nameStart traitLen=target.nameLen traitArgs=compiler.pushConformTypes(types: [integer]) derived=false />)
    match compiler.checkTraitSubjectCycles(activeExtIds: []) {
        Result.Ok(value: _) => {
            if expected != "" { panic("invalid pattern input was admitted") }
        }
        Result.Err(error: val diagnostic) => {
            if expected == "" || diagnostic.message != expected {
                emitDiagnostic(diagnostic: diagnostic)
                panic("wrong pattern input result")
            }
            match diagnostic.failureDomain {
                FailureDomain.Input => {}
                _ => { panic("pattern input did not retain Input domain") }
            }
        }
    }
    print("pattern input contract retained")
}
