import @Std/Io with { write }
import @Plew/Syntax with { Derive, TopItemAst, DeclAst, Src, newSrc }

struct A { }
pub impl A as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                s.put("impl ")
                s.put(d.name)
                s.put(" {\n    assoc fn fromA() -> String { return \"A:")
                s.put(d.name)
                s.put("\" }\n}\n")
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

struct B { }
pub impl B as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                s.put("impl ")
                s.put(d.name)
                s.put(" {\n    assoc fn fromB() -> String { return \"B:")
                s.put(d.name)
                s.put("\" }\n}\n")
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

@[A, Eq, B]
struct Thing {
    pub val v: I64
}

fn main() {
    write(s: Thing.fromA())
    write(s: "\n")
    write(s: Thing.fromB())
    write(s: "\n")
    // Eq (builtin) also applied: equality works
    val p: Thing = <Thing v=5 />
    val q: Thing = <Thing v=5 />
    if p == q { write(s: "eq-ok\n") }
}
