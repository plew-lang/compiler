// `@[Eq]` on a struct, exercised through the real derive pipeline (`plew gen`
// synthesizes `Point.eq` into App.gen.pw). The derived witness makes `==`/`!=`
// work AND registers the conformance, so `Point` satisfies a `where T: Eq`
// bound with no manual impl.
import @Std/Io with { print }

@[Eq]
struct Point { pub val x: I64  pub val y: I64 }

fn same[T](a: T, b: T) -> Bool where T: Eq { return a == b }
fn boolI(b: Bool) -> I64 { if b { return 1I64 } return 0I64 }

fn main() {
    val a: Point = <Point x=1 y=2 />
    val b: Point = <Point x=1 y=2 />
    val c: Point = <Point x=1 y=9 />
    print(boolI(b: a == b))            // 1
    print(boolI(b: a == c))            // 0
    print(boolI(b: a != c))            // 1
    print(boolI(b: same(a: a, b: b)))  // 1  (derived Eq satisfies where T: Eq)
}
