// A user struct with `@[Hash]`/`@[Eq]` derives used as a Dictionary KEY (spec/02,16).
// Exercises the full 2-phase derive flow end to end: `plew gen` generates
// `Pair.hash`/`Pair.eq` into App.gen.pw (auto-parted on the real compile), and the
// dict stores/looks up struct keys. Two backend fixes make this work: gen-mode
// instantiation discovery skips a generic over a to-be-derived type (no premature
// `Pair.hash` demand), and struct `==` on a grounded generic key (`self.keys[idx] ==
// key` in monomorphized `Dictionary[Pair].find`) dispatches the Eq witness instead of
// reinterpreting the struct's `{i64,i64}` as a `{ptr,len}` String.
import @Std/Io with { print }

@[Hash]
@[Eq]
struct Pair {
    pub val a: I64
    pub val b: I64
}

fn main() {
    val d: Dictionary[Pair, I64] = [<Pair a=1 b=2 />: 7I64, <Pair a=3 b=4 />: 9I64]
    print(d[<Pair a=1 b=2 />])           // 7
    print(d[<Pair a=3 b=4 />])           // 9
    print(d.count())                        // 2
    val g: Optional[I64] = d.get(key: <Pair a=5 b=6 />)
    print(g.unwrapOr(fallback: -1I64))    // -1 (absent key)
    val h: Optional[I64] = d.get(key: <Pair a=1 b=2 />)
    print(h.unwrapOr(fallback: -1I64))    // 7 (present)
}
