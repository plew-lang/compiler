// `@[Eq]` on an enum, exercised through the real derive pipeline (`plew gen`
// synthesizes `Shape.eq` into App.gen.pw). Structural equality: tags must agree,
// then payloads compare field-wise — payload variants need no manual impl.
import @Std/Io with { print }

@[Eq]
enum Shape {
    Circle(r: I64)
    Rect(w: I64  h: I64)
    Unit
}

fn boolI(b: Bool) -> I64 { if b { return 1I64 } return 0I64 }

fn main() {
    val a: Shape = <Shape.Circle r=5 />
    val b: Shape = <Shape.Circle r=5 />
    val c: Shape = <Shape.Circle r=9 />
    val d: Shape = <Shape.Rect w=2 h=3 />
    val e: Shape = <Shape.Rect w=2 h=3 />
    val u: Shape = <Shape.Unit />
    print(boolI(b: a == b))   // 1
    print(boolI(b: a == c))   // 0
    print(boolI(b: a == d))   // 0
    print(boolI(b: d == e))   // 1
    print(boolI(b: a == u))   // 0
    print(boolI(b: u == u))   // 1
}
