import @Std/Io with { write }
import @Std/Syntax with { Derive, TopItemAst, DeclAst, Src, newSrc }

trait Show {
    fn show() -> String
}

// A realistic derive: generate `pub impl <T> as Show { fn show() ... }` that lists
// the struct's field names. Generated source is auto-parted into this module.
struct DeriveShow { }

pub impl DeriveShow as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                s.put("pub impl ")
                s.put(d.name)
                s.put(" as Show {\n    fn show() -> String {\n        return \"")
                s.put(d.name)
                s.put(" { ")
                mut val i: U64 = 0
                while i < d.fields.count {
                    s.put(d.fields[i].name)
                    s.put(" ")
                    i += 1
                }
                s.put("}\"\n    }\n}\n")
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

@[DeriveShow]
struct Point {
    pub val x: I64
    pub val y: I64
}

fn main() {
    val p: Point = <Point x=1 y=2 />
    write(s: p.show())
    write(s: "\n")
}
