import @Std/Io with { write }
import @Std/Syntax with { Derive, TopItemAst, DeclAst, Src, newSrc }

// A derive over an enum that lists its variants (using the @Std/Syntax Src builder).
struct VariantNames { }

pub impl VariantNames as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                s.put("fn variantNames() -> String {\n    return \"")
                mut val i: U64 = 0
                while i < d.variants.count {
                    s.put(d.variants[i].name)
                    s.put("(")
                    s.putInt(d.variants[i].fields.count)
                    s.put(")")
                    s.putByte(44)
                    i += 1
                }
                s.put("\"\n}\n")
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

@[VariantNames]
enum Shape {
    Circle(r: I64)
    Rect(w: I64, h: I64)
    Empty
}

fn main() {
    write(s: variantNames())
    write(s: "\n")
}
