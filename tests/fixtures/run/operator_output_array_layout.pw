import @Std/Io with { print }
import @Std/Core with { Sub }

struct Point { pub val x: I64  pub val y: I64  pub val z: I64 }
pub impl Point { factory }
struct Vector { pub val dx: I64  pub val dy: I64 }
pub impl Vector { factory }

impl Point as Sub[Point] {
    type Output = Vector
    assoc fn sub(lhs: Point, rhs: Point) -> Vector {
        return <Vector dx=lhs.x - rhs.x dy=lhs.y - rhs.y />
    }
}

fn main() {
    val a: Point = <Point x=10 y=8 z=1 />
    val b: Point = <Point x=3 y=2 z=2 />
    val values: Array[Vector] = [a - b, a - b]
    print(values[0U64].dx)
    print(values[1U64].dy)
}
