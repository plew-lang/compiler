// Dictionary literals are context-typed. SyntaxFile lowering must validate and
// consume that context before lowering its entry IDs, then use the one shared
// dictionary desugar used by the value-AST route.
import @Plew/Syntax with { Lexer, P, StmtId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload }
import @Std/Io with { print }
import /Frontend with { Comp }
import /Ir with { Expr, TypeRef }

fn main() {
    val source = "val table = [1I8: 2I8]\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val stmt = syntaxStmt(file: file, id: <StmtId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val dictName = c.internBytes(s: "Dictionary")
    val i8Name = c.internBytes(s: "I8")
    val i8 = c.simpleTypeRef(nameStart: i8Name.nameStart, nameLen: i8Name.nameLen)
    val ctx = c.pushType(t: <TypeRef nameStart=dictName.nameStart nameLen=dictName.nameLen args=[i8, i8] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    val root = c.lowerSyntaxExprWithCtx(id: stmt.child0, ctxRef: ctx)
    print(c.arena.exprs.count())
    match c.arena.exprs[root] {
        Expr.IfExpr(cond: _, thenBlk: _, elseBlk: _) => { print(1U64) }
        _ => { print(99U64) }
    }
}
