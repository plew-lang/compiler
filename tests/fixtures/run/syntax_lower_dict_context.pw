// Dictionary source entries survive lowering without an expected type.
use @Plew/Syntax only { Lexer, P, StmtId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload }
use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { Expr }

fn main() {
    val source = "val table = [1I8: 2I8]\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val stmt = syntaxStmt(file: file, id: <StmtId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val root = c.lowerSyntaxExpr(id: stmt.child0).unwrap()
    match c.arena.exprs[root] {
        Expr.Dictionary(val entries) => {
            print(entries.len)
            match c.arena.exprs[c.exprAt(exprs: entries, index: 0U64)] {
                Expr.Int(val value, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => { print(value) }
                _ => { print(99U64) }
            }
            match c.arena.exprs[c.exprAt(exprs: entries, index: 1U64)] {
                Expr.Int(val value, offset: _, isBool: _, tyStart: _, tyLen: _, isNeg: _) => { print(value) }
                _ => { print(99U64) }
            }
        }
        _ => { print(99U64) }
    }
}
