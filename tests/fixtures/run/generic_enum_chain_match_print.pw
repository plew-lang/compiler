import @Std/Io with { print }
import @Std/Core

struct BoxG[T] { pub val value: T }
pub impl BoxG { factory }

fn main() {
    val a: Optional[BoxG[I64]] = <Optional.Some v=<BoxG[I64] value=1 /> />
    val b: Optional[BoxG[I64]] = <Optional[BoxG[I64]].None />
    val values = [a?.value, b?.value]
    for val value in values {
        match value {
            Optional.Some(v: val item) => { print(item) }
            Optional.None => { print(0I64) }
        }
    }
}
