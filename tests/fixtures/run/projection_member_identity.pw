// Structural identity must distinguish members even when a projection is rebuilt with a record receiver.
use /Frontend only { Comp, FrontendInput, analyzeFrontend }
use /SourceAccess only { SourceAccess }
use /Ir only { TypeRef, ProjectionRebuildSource, ResolvedViewSource, TraitInstanceKey, PatternBindInput, UnifyBind }
use @Std/Io only { print }
fn main() {
    mut val compiler = <Comp />
    analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text="trait Projection {{ type First type Second }}\ntrait Other {{ type First }}\ntrait WithArgument[A] {{ type Item }}\nstruct Sample {{}}\nimpl Sample as Projection {{ type First = I64 type Second = Bool }}\nfn inspect[T](first: T#Projection.First, second: T#Projection.Second, firstRecord: (value: T#Projection.First), secondRecord: (value: T#Projection.Second), other: T#Other.First, firstArgument: T#WithArgument[I64].Item, secondArgument: T#WithArgument[Bool].Item) where T: Projection, T: Other, T: WithArgument[I64], T: WithArgument[Bool] {{}}\nfn concrete(first: Sample#Projection.First, second: Sample#Projection.Second) {{}}\nfn main() {{}}\n" path="ValidInput.pw" />, sources: <SourceAccess />).unwrap()
    val name = compiler.internBytes(s: "inspect")
    val function = compiler.arena.functionAt(index: compiler.arena.firstFunctionNamed(nameId: name.nameId))
    val first = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val second = compiler.funcParamAt(params: function.params, index: 1U64).ty
    val firstRecord = compiler.funcParamAt(params: function.params, index: 2U64).ty
    val secondRecord = compiler.funcParamAt(params: function.params, index: 3U64).ty
    print("valid generic projection equal")
    print(compiler.typeRefEq(a: first, b: second))
    print("valid nested record equal")
    print(compiler.typeRefEq(a: firstRecord, b: secondRecord))
    val concreteName = compiler.internBytes(s: "concrete")
    val concrete = compiler.arena.functionAt(index: compiler.arena.firstFunctionNamed(nameId: concreteName.nameId))
    print("valid concrete projection equal")
    print(compiler.typeRefEq(a: compiler.funcParamAt(params: concrete.params, index: 0U64).ty, b: compiler.funcParamAt(params: concrete.params, index: 1U64).ty))
    val term = compiler.arena.typeAt(index: first)
    // Use an actual record term rather than manually stamping isRecord on a projection.
    val receiver = firstRecord
    val rebuiltFirst = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: receiver, traitArgs: [])
    val rebuiltSecond = compiler.rebuildProjectionTerm(source: compiler.arena.typeAt(index: second).projectionRebuildSource(), receiver: receiver, traitArgs: [])
    print("rebuilder record projection equal")
    print(compiler.typeRefEq(a: rebuiltFirst, b: rebuiltSecond))
    val anotherReceiver = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: secondRecord, traitArgs: [])
    val sameMemberAndReceiver = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: receiver, traitArgs: [])
    val other = compiler.funcParamAt(params: function.params, index: 4U64).ty
    val otherOwner = compiler.rebuildProjectionTerm(source: compiler.arena.typeAt(index: other).projectionRebuildSource(), receiver: receiver, traitArgs: [])
    print("rebuilders with the same projection identity compare equal")
    print(compiler.typeRefEq(a: rebuiltFirst, b: sameMemberAndReceiver))
    print("changing the receiver changes projection identity")
    print(!compiler.typeRefEq(a: rebuiltFirst, b: anotherReceiver))
    print("changing the trait owner changes projection identity")
    print(!compiler.typeRefEq(a: rebuiltFirst, b: otherOwner))
    val firstArgument = compiler.arena.typeAt(index: compiler.funcParamAt(params: function.params, index: 5U64).ty)
    val secondArgument = compiler.arena.typeAt(index: compiler.funcParamAt(params: function.params, index: 6U64).ty)
    val projectedFirstArgument = compiler.rebuildProjectionTerm(source: firstArgument.projectionRebuildSource(), receiver: receiver, traitArgs: firstArgument.assocTraitArgs)
    val projectedSecondArgument = compiler.rebuildProjectionTerm(source: secondArgument.projectionRebuildSource(), receiver: receiver, traitArgs: secondArgument.assocTraitArgs)
    print("changing the trait argument changes projection identity")
    print(!compiler.typeRefEq(a: projectedFirstArgument, b: projectedSecondArgument))
    val firstOwner = compiler.rebuildProjectionTerm(source: <ProjectionRebuildSource assocTraitId=term.assocTraitId assocNameId=term.assocNameId hasAssocTraitDecl=true assocTraitDeclOffset=100U64 />, receiver: receiver, traitArgs: [])
    val secondOwner = compiler.rebuildProjectionTerm(source: <ProjectionRebuildSource assocTraitId=term.assocTraitId assocNameId=term.assocNameId hasAssocTraitDecl=true assocTraitDeclOffset=200U64 />, receiver: receiver, traitArgs: [])
    val unresolvedOwner = compiler.rebuildProjectionTerm(source: <ProjectionRebuildSource assocTraitId=term.assocTraitId assocNameId=term.assocNameId />, receiver: receiver, traitArgs: [])
    val aliasedOwner = compiler.rebuildProjectionTerm(source: <ProjectionRebuildSource assocTraitId=compiler.arena.typeAt(index: other).assocTraitId assocNameId=term.assocNameId hasAssocTraitDecl=true assocTraitDeclOffset=100U64 />, receiver: receiver, traitArgs: [])
    print("the same spelling does not merge different canonical owners")
    print(!compiler.typeRefEq(a: firstOwner, b: secondOwner))
    print("an unresolved owner cannot match either canonical owner")
    print(!compiler.typeRefEq(a: firstOwner, b: unresolvedOwner) && !compiler.typeRefEq(a: unresolvedOwner, b: secondOwner))
    print("a different spelling does not split the same canonical owner")
    print(compiler.typeRefEq(a: firstOwner, b: aliasedOwner))
    val record = compiler.arena.typeAt(index: receiver)
    val layout = compiler.internBytes(s: "SeparateLayout")
    val otherLayout = compiler.pushType(t: <TypeRef nameStart=layout.nameStart nameLen=layout.nameLen args=[] isRecord=true recordFieldLabels=record.recordFieldLabels recordFieldTerms=record.recordFieldTerms />)
    print("record identity ignores the layout name")
    print(compiler.typeRefEq(a: receiver, b: otherLayout))
    val otherLayoutProjection = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: otherLayout, traitArgs: [])
    print("projection identity ignores the receiver layout name")
    print(compiler.typeRefEq(a: rebuiltFirst, b: otherLayoutProjection))
    val view = <ResolvedViewSource writtenStart=0U64 surfaceId=123U64 traitInstance=<TraitInstanceKey owner=0U64 positionalArgs=[] /> />
    val viewedProjection = compiler.typeRefWithAddedViewSources(ref: rebuiltFirst, additions: [view])
    print("changing the output view changes projection identity")
    print(!compiler.typeRefEq(a: rebuiltFirst, b: viewedProjection))
    print("declaration equality compares output views")
    print(!compiler.typeRefsAlphaEq(a: rebuiltFirst, b: viewedProjection, aParams: [], bParams: []))
    val noBinders = <PatternBindInput.Values values=[] />
    mut val bindings: Array[UnifyBind] = []
    print("pattern matching compares output views")
    print(!compiler.unifyPatterns(a: rebuiltFirst, aSide: 0U64, b: viewedProjection, bSide: 1U64, aParams: noBinders, bParams: noBinders, binds: inout bindings))
    print("receiver dispatch can ignore the outer output view")
    print(compiler.unifyPatterns(a: rebuiltFirst, aSide: 0U64, b: viewedProjection, bSide: 1U64, aParams: noBinders, bParams: noBinders, binds: inout bindings, ignoreTopView: true))
    val differentFields = compiler.rebuildRecordTypeTerm(t: record, fieldTerms: [second])
    val differentFieldsProjection = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: differentFields, traitArgs: [])
    print("declaration equality follows record fields through the receiver")
    print(compiler.typeRefsAlphaEq(a: rebuiltFirst, b: otherLayoutProjection, aParams: [], bParams: []) && !compiler.typeRefsAlphaEq(a: rebuiltFirst, b: differentFieldsProjection, aParams: [], bParams: []))
    print("pattern matching follows record fields through the receiver")
    print(compiler.unifyPatterns(a: rebuiltFirst, aSide: 0U64, b: otherLayoutProjection, bSide: 1U64, aParams: noBinders, bParams: noBinders, binds: inout bindings) && !compiler.unifyPatterns(a: rebuiltFirst, aSide: 0U64, b: differentFieldsProjection, bSide: 1U64, aParams: noBinders, bParams: noBinders, binds: inout bindings))
    val beforeInvalidRebuilds = compiler.arena.typeCount()
    val missingReceiver = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: 0U64, traitArgs: [])
    val missingMember = compiler.rebuildProjectionTerm(source: record.projectionRebuildSource(), receiver: receiver, traitArgs: [])
    val invalidReceiver = compiler.rebuildProjectionTerm(source: term.projectionRebuildSource(), receiver: beforeInvalidRebuilds, traitArgs: [])
    print("invalid projection components do not publish a term")
    print(missingReceiver == 0U64 && missingMember == 0U64 && invalidReceiver == 0U64 && compiler.arena.typeCount() == beforeInvalidRebuilds)
    val binder = compiler.funcBindAt(binds: function.typeParams, index: 0U64)
    val mappedFirst = compiler.groundTermInEnvironment(ref: first, params: [binder], values: [receiver])
    val mappedSecond = compiler.groundTermInEnvironment(ref: second, params: [binder], values: [receiver])
    print("substitution record projection equal")
    print(compiler.typeRefEq(a: mappedFirst, b: mappedSecond))
    print("the mapped terms retain their projection receiver")
    print(compiler.arena.typeAt(index: mappedFirst).projectionReceiver == receiver && compiler.arena.typeAt(index: mappedSecond).projectionReceiver == receiver)
}
