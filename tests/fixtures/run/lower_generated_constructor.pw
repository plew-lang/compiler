// Macro/value AST construction can carry a name without a source token.
use @Plew/Syntax only { ExprAst, Span }
use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { Expr }

fn main() {
    mut val compiler: Comp = <Comp />
    compiler.arena.reserveTypeSentinel()
    val absent: Span = <Span start=0U64 end=0U64 />
    val generated = <ExprAst.Make typePath=[] typeName="Box" typeNameSpan=absent typeArgs=[] variant="" variantSpan=absent isEnum=false fields=[] span=absent />
    val root = compiler.lowerExpr(e: generated).unwrap()
    match compiler.arena.exprs[root] {
        Expr.Make(val typeStart, val typeLen, variantStart: _, variantLen: _, isEnum: _, val ty, fields: _) => {
            print(typeLen == 3U64 && compiler.arena.bytes[typeStart] == 66U8 && compiler.arena.bytes[typeStart + 1U64] == 111U8 && compiler.arena.bytes[typeStart + 2U64] == 120U8)
            print(ty != 0U64)
        }
        _ => { print(false) print(false) }
    }
}
