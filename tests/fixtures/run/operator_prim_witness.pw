import @Std/Io with { print }

// O6 stage 2: the primitive numeric types carry real operator-trait witnesses
// (Core's `impl I32 as Add[I32]` etc., generated over the intrinsic floor). Call
// them explicitly as associated fns — the operator desugar for primitives is
// wired separately (stage 3). This proves witness -> intrinsic -> plew_* works.
// The operand labels (`lhs`/`rhs`/`value`) are suppressed (`~:`, spec/04 — they had
// fallen to position names), so these explicit calls are positional.
fn main() {
    print(I32.add(2, 3))            // 5
    print(I64.sub(10I64, 4I64))     // 6
    print(U64.mul(6U64, 7U64))      // 42
    print(I32.div(20, 5))           // 4
    print(I32.rem(20, 6))           // 2
    print(U64.bitand(6U64, 3U64))   // 2
    print(U64.bitor(6U64, 1U64))    // 7
    print(U64.shl(3U64, 2U64))      // 12
    print(I64.neg(7I64))            // -7
    print(U8.bitnot(0U8))           // 255
}
