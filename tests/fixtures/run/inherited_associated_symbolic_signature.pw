use @Std/Io only { print }

trait Marker {}
trait Source { type Item: Marker }
trait Select { type Value: Marker }
struct Wrapper[T] {}
impl[T] Wrapper[T] as Select where T: Source { type Value = T#Source.Item }

trait Parent { type Input: Source }
trait Service: Parent {
    fn fetch(value: Wrapper[Self#Parent.Input]#Select.Value) -> Wrapper[Self#Parent.Input]#Select.Value
}

struct Element {}
impl Element { fn number() -> I64 { return 42I64 } }
impl Element as Marker {}
struct Entry {}
impl Entry as Source { type Item = Element }
struct Worker[T] {}
impl[T] Worker[T] as Service where T: Source { fn fetch(value: T#Source.Item) -> T#Source.Item { return value } }
impl[T] Worker[T] as Parent where T: Source { type Input = T }

fn main() {
    val element: Element = <Worker[Entry] />.fetch(value: <Element />)
    print(element.number())
}
