// isolate: pop() and removeAt() with MutableRef elements.
import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

fn main() {
    mut val xs: Array[MutableRef[Cell]] = []
    xs.append(<MutableRef[Cell] value=<Cell v=1 /> />)
    xs.append(<MutableRef[Cell] value=<Cell v=2 /> />)
    xs.append(<MutableRef[Cell] value=<Cell v=3 /> />)
    xs.pop()                 // discarded Optional[MutableRef]: expect deinit 3
    print(100I32)
    xs.removeAt(index: 0U64) // discarded MutableRef: expect deinit 1
    print(200I32)
}
// expected: 3, 100, 1, 200, 2
