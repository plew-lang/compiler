use @Plew/Syntax only { Lexer, P, lex, parseProgramSyntaxFile, parseProgramAst }
use @Std/Io only { print }
fn check(source: String, valid: Bool) {
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val direct = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout direct)
    if direct.hasErr == valid { panic "direct parser disagrees" }
    mut val value = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val items = parseProgramAst(p: inout value)
    if value.hasErr == valid { panic "value parser disagrees" }
}
fn main() {
    check(source: "use ./Library only {{ use, only as useOnly }}\n", valid: true)
    check(source: "pub use ./Library only {{ use, only }}\n", valid: true)
    check(source: "use ./Library as only\n", valid: true)
    check(source: "use ./Library as use only {{ only }}\n", valid: true)
    check(source: "fn use(only: I64) {{}}\nfn only(use: I64) {{}}\n", valid: true)
    check(source: "import ./Library with {{ use }}\n", valid: false)
    check(source: "use ./Library with {{ use }}\n", valid: false)
    check(source: "use ./Library {{ use }}\n", valid: false)
    check(source: "use ./Library only *\n", valid: false)
    print("ok")
}
