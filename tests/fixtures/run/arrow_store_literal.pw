import @Std/Io with { print }
import @Std/Core with { MutableRef }
// Storing a bare integer literal through a MutableRef arrow place (`r->field = 42`) takes
// its type from the pointee field — no suffix needed.
struct Box { pub mut val v: I32 }
pub impl Box { factory }
fn main() {
    mut val r: MutableRef[Box] = <MutableRef[Box] value=<Box v=1 /> />
    r->v = 42
    print(r->v)
    mut val ys: Array[MutableRef[Box]] = []
    ys.append(<MutableRef[Box] value=<Box v=7 /> />)
    ys[0]->v = 99
    print(ys[0]->v)
}
