use @Std/Io only { print }
trait Marker { type Type }
trait Parent[T] { type Item }
trait Middle: Parent[Self#Marker.Type] + Marker[Type=I64] {}
trait Service: Middle + Parent[I64] { fn get() -> Item }
struct Worker {}
impl Worker as Marker { type Type=I64 }
impl Worker as Parent[I64] { type Item=I64 }
impl Worker as Parent[Bool] { type Item=Bool }
impl Worker as Middle {}
impl Worker as Service { fn get() -> I64 { return 42I64 } }
fn main() { print(<Worker />.get()) }
