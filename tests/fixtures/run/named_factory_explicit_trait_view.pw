use @Std/Io only { print }
trait Marker[T] {}
struct Number {}
extension Selection { impl Number as Marker[I64] {} }
struct Box[T] { val n: I64 }
impl[T] Box[T] {
    factory tagged(number: I64) { return <Box[T] n=number /> }
}
fn main() {
    val box = <Box[Number#Selection#Marker[I64]].tagged number=42I64 />
    print(box.n)
}
