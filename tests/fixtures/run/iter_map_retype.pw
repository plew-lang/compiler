import @Std/Io with { print }
import @Std/Core with { Iterator }

// map's output element type B (Bool) differs from the inner Item (I64).
struct Counter { pub mut val n: I64 }
pub impl Counter { factory }
pub impl Counter as Iterator {
    type Item = I64
    inout fn next() -> Optional[I64] {
        if self.n >= 5 { return <Optional.None /> }
        self.n = self.n + 1
        return <Optional.Some v=self.n />
    }
}
fn main() {
    for val v in <Counter n=0 />.map(f: fn(x: I64) -> Bool { return x > 2 }) {
        print(v)
    }
}
