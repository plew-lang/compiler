use @Std/Io only { print }
fn iterable(active: Bool) -> I64 {
    for val n in { give if active { return 7I64 } else { give [1I64] } } { print(n) }
    return 99I64
}
fn captured(active: Bool) -> I64 {
    return match { give if active { return 8I64 } else { give 0I64 } } { val value => 0I64 }
}
fn conditional(active: Bool) -> I64 {
    if val value = { give if active { return 9I64 } else { give 0I64 } } { print(0I64) }
    return 99I64
}
fn loopCondition(active: Bool) -> I64 {
    while val value = { give if active { return 10I64 } else { give 0I64 } } { print(0I64) }
    return 99I64
}
fn chain(flag: Bool, active: Bool) -> I64 {
    if flag && val value = { give if active { return 11I64 } else { give 0I64 } } { print(0I64) }
    else { return 12I64 }
    return 99I64
}
fn loopBreak(active: Bool) -> I64 {
    while true {
        for val n in { give if active { break } else { give [1I64] } } { print(n) }
    }
    return 13I64
}
fn loopContinue(active: Bool) -> I64 {
    mut val count = 0I64
    while count < 2I64 {
        count += 1I64
        for val n in { give if active { continue } else { give [1I64] } } { print(n) }
        print(99I64)
    }
    return count
}
fn main() {
    print(iterable(active: true))
    print(captured(active: true))
    print(conditional(active: true))
    print(loopCondition(active: true))
    print(chain(flag: true, active: true))
    print(chain(flag: false, active: true))
    print(loopBreak(active: true))
    print(loopContinue(active: true))
}
