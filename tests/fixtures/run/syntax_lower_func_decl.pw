use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }

fn main() {
    val source = "trait P {{}}\nfn identity[T](value: T) -> T where T: P {{ return value }}\n"
    mut val compiler: Comp = <Comp />
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path="function-decl.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    print(compiler.arena.functionCount())
    print(compiler.arena.functionAt(index: 0U64).typeParams.count())
    print(compiler.arena.functionAt(index: 0U64).params.count())
    print(compiler.decls.funcBounds.count())
}
