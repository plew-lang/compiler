// Declaration ownership consumes semantic facts, without executable layouts.
// The stricter instantiated/executable verifiers retain their stage contracts.
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /Ir only { StructDef, TypeRef, AccessCandidate, CallSiteKey }
use /Mid/Ir only { MidRange, MidCallTarget, MidCallReceiver, MidScope, MidBody, MidBlock, MidLocalDecl, MidPlace, MidOperand, MidRvalue, MidStatement, MidTerminator }
use /Mid/Build only { MidFunctionTemplates, MidBuildError }
use /Mid/Drop only { elaborateCanonicalMidDrops }
use /Mid/Prepare only { MidParametricBody }
use /Mid/OwnershipAnalysis only { MidOwnershipRequests }
use /Mid/Verify only { verifyDeclarationMidOwnership, verifyCanonicalMidBody, verifyExecutableCanonicalMidBody, MidVerifyError }
use @Std/Io only { print }

fn checkSource() {
    mut val c = <Comp />
    val text = "val global = 1I64 unique struct Resource {} fn take(value: move Resource) {} fn conditional(flag: Bool) { val resource = <Resource /> if flag { take(value: move resource) } } impl Resource { fn inspect() {} } fn shadow() { val resource = <Resource /> resource.inspect() val resource = <Resource /> resource.inspect() } unique enum Outcome { Ready(resource: Resource) Empty } fn consume(value: move Outcome) { match move value { Outcome.Ready(val resource) => {} Outcome.Empty => {} } } fn identity[T](value: T) -> T { val local: T = value return local } fn widen(value: I32) -> I64 { return value as I64 } struct Number {} impl Number { assoc fn value() -> Self { mut val result: Self = <Number /> result = <Number /> return result } } fn main() {}"
    analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text text=text path="ownership.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val instances = c.arena.bodyInstanceCount()
    val destructions = c.arena.finalDestructions.count()
    mut val templates = <MidFunctionTemplates />
    mut val requests = <MidOwnershipRequests />
    val count = c.arena.functionCount()
    mut val index = 0U64
    mut val strictRejections = 0U64
    while index < count {
        val function = c.arena.functionAt(index: index)
        if function.body != 0U64 && !function.isExtern {
            val built = templates.body(c: inout c, function: index)
            match built.error { MidBuildError.None => {} _ => { panic("declaration Mid failed") } }
            val inputCount = c.mid.bodies.count()
            val verified = requests.request(c: inout c, body: <MidParametricBody.input canonical=built.canonical />).unwrap()
            if verified.canonical.body != built.canonical.body || c.mid.bodies.count() != inputCount { panic("declaration verification rewrote its input") }
            val analyzed = verified.canonical
            val bodyCount = c.mid.bodies.count()
            val repeated = requests.request(c: inout c, body: <MidParametricBody.input canonical=built.canonical />).unwrap()
            if repeated.canonical.body != analyzed.body || c.mid.bodies.count() != bodyCount { panic("ownership request changed its snapshot") }
            val destruction = requests.destructionBody(c: inout c, body: verified).unwrap()
            val expandedCount = c.mid.bodies.count()
            val repeatedDestruction = requests.destructionBody(c: inout c, body: verified).unwrap()
            if destruction.body != repeatedDestruction.body || c.mid.bodies.count() != expandedCount { panic("destruction request was recomputed") }
            match verifyCanonicalMidBody(c: inout c, canonical: analyzed).error {
                MidVerifyError.None => {}
                _ => { strictRejections += 1U64 }
            }
        }
        index += 1U64
    }
    val globals = templates.globalInitializer(c: inout c)
    match globals.error { MidBuildError.None => {} _ => { panic("global declaration build failed") } }
    val globalCount = c.mid.bodies.count()
    val sameGlobals = templates.globalInitializer(c: inout c)
    if globals.canonical.body != sameGlobals.canonical.body || c.mid.bodies.count() != globalCount { panic("global initializer was rebuilt") }
    requests.request(c: inout c, body: <MidParametricBody.input canonical=globals.canonical />).unwrap()
    if c.decls.semanticMatches.count() == 0U64 { panic("missing consuming match fixture") }
    val owner = c.decls.semanticMatches[0U64].ownerFnIdx
    val consuming = templates.body(c: inout c, function: owner)
    val checked = elaborateCanonicalMidDrops(arena: inout c.mid, canonical: consuming.canonical)
    c.decls.semanticMatches = []
    c.decls.semanticMatchIndexSlots = []
    match verifyDeclarationMidOwnership(c: inout c, canonical: checked).error {
        MidVerifyError.MoveUnavailable => {}
        _ => { panic("enum transfer admitted without semantic pattern evidence") }
    }
    if strictRejections < 3U64 { panic("instantiated stage admitted declaration boundaries") }
    if c.arena.bodyInstanceCount() != instances || c.arena.finalDestructions.count() != destructions { panic("declaration verification discovered executable instances") }
}

fn checkInvalidOwnership() {
    mut val c = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "Resource")
    c.arena.registerStruct(<StructDef nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId defOffset=100U64 typeParams=[] fields=[] isUnique=true isExtern=false />)
    val term = c.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen hasDecl=true declOffset=100U64 args=[] isRecord=false recordFieldLabels=[] recordFieldTerms=[] />)
    val place = <MidPlace local=0U64 typeTerm=term />
    val local = <MidLocalDecl typeTerm=term sourceScope=0U64 isUnique=true isParameter=true ownsAtEntry=true />
    val invalidCopy = c.mid.store(body: <MidBody locals=[local] blocks=[<MidBlock terminator=<MidTerminator.ReturnValue value=<MidOperand.Copy place=place /> /> />] />)
    match verifyDeclarationMidOwnership(c: inout c, canonical: invalidCopy).error {
        MidVerifyError.UniqueCopy => {}
        _ => { panic("declaration unique copy accepted") }
    }
    val invalidMove = c.mid.store(body: <MidBody locals=[local] blocks=[<MidBlock statements=[<MidStatement.Drop place=place />] terminator=<MidTerminator.ReturnValue value=<MidOperand.Move place=place /> /> />] />)
    match verifyDeclarationMidOwnership(c: inout c, canonical: invalidMove).error {
        MidVerifyError.MoveUnavailable => {}
        _ => { panic("declaration use after drop accepted") }
    }
    // The Access owner and published evaluation homes must remain alive until
    // the parent call, even before getter/setter expansion is available.
    c.decls.registerAccessCandidate(<AccessCandidate readExpr=0U64 writeExpr=1U64 placeExpr=2U64 />, expressionCount: 3U64)
    val keyPlace = <MidPlace local=1U64 typeTerm=term />
    val outputPlace = <MidPlace local=2U64 typeTerm=term />
    val keyLocal = <MidLocalDecl typeTerm=term sourceScope=0U64 isUnique=true isParameter=true ownsAtEntry=true preparedExpr=1U64 />
    val outputLocal = <MidLocalDecl typeTerm=term sourceScope=0U64 isUnique=true isParameter=false />
    val access = <MidOperand.Access candidate=0U64 inputs=<MidRange start=1U64 len=1U64 /> owner=place />
    for variant in [0U64, 1U64, 2U64] {
        mut val prefix: Array[MidStatement] = []
        if variant == 1U64 { prefix.append(<MidStatement.Drop place=place />) }
        if variant == 2U64 { prefix.append(<MidStatement.Drop place=keyPlace />) }
        val call = <MidTerminator.Call callee=<MidCallTarget.Template site=<CallSiteKey /> /> receiver=<MidCallReceiver.None /> args=[access] destination=outputPlace target=1U64 />
        val cleanup = <MidBlock statements=[<MidStatement.Drop place=place />, <MidStatement.Drop place=keyPlace />, <MidStatement.Drop place=outputPlace />] terminator=<MidTerminator.Return /> />
        val body = c.mid.store(body: <MidBody locals=[local, keyLocal, outputLocal] blocks=[<MidBlock statements=prefix terminator=call />, cleanup] />)
        val verification = verifyDeclarationMidOwnership(c: inout c, canonical: body)
        match verification.error {
            MidVerifyError.None => { if variant != 0U64 { panic("access revived a consumed evaluation owner") } }
            MidVerifyError.MoveUnavailable => { if variant == 0U64 { panic("live access evaluation rejected") } }
            _ => { panic("unexpected access ownership result") }
        }
        if variant == 0U64 {
            match verifyCanonicalMidBody(c: inout c, canonical: body).error {
                MidVerifyError.UnelaboratedAccess => {}
                _ => { panic("instantiated verification admitted symbolic access") }
            }
        }
    }
    val scope = <MidScope firstLocal=0U64 localCount=1U64 />
    for marker in [<MidStatement.ScopeExit scope=0U64 />, <MidStatement.EndBinding local=0U64 />] {
        val ended = c.mid.store(body: <MidBody locals=[local] scopes=[scope] blocks=[<MidBlock statements=[marker] terminator=<MidTerminator.Return /> />] />)
        match verifyDeclarationMidOwnership(c: inout c, canonical: ended).error {
            MidVerifyError.None => {}
            _ => { panic("declaration lifetime end rejected") }
        }
        val invalidRead = c.mid.store(body: <MidBody locals=[local] scopes=[scope] blocks=[<MidBlock statements=[marker] terminator=<MidTerminator.ReturnValue value=<MidOperand.Move place=place /> /> />] />)
        match verifyDeclarationMidOwnership(c: inout c, canonical: invalidRead).error {
            MidVerifyError.MoveUnavailable => {}
            _ => { panic("declaration lifetime end did not kill ownership") }
        }
        match verifyCanonicalMidBody(c: inout c, canonical: ended).error {
            MidVerifyError.UnelaboratedScopeExit => {}
            MidVerifyError.UnelaboratedBindingEnd => {}
            _ => { panic("instantiated stage admitted a lifetime marker") }
        }
    }
    val missingEnd = c.mid.store(body: <MidBody locals=[local] scopes=[scope] blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    match verifyDeclarationMidOwnership(c: inout c, canonical: missingEnd).error {
        MidVerifyError.OutstandingOwnership => {}
        _ => { panic("declaration silently discarded a live owner") }
    }
    val replaced = c.mid.store(body: <MidBody locals=[local, keyLocal] blocks=[<MidBlock statements=[<MidStatement.Overwrite destination=place source=keyPlace />, <MidStatement.EndBinding local=0U64 />] terminator=<MidTerminator.Return /> />] />)
    match verifyDeclarationMidOwnership(c: inout c, canonical: replaced).error {
        MidVerifyError.None => {}
        _ => { panic("declaration replacement rejected") }
    }
    match verifyCanonicalMidBody(c: inout c, canonical: replaced).error {
        MidVerifyError.DropUnavailable => {}
        _ => { panic("instantiated replacement admitted missing cleanup") }
    }
    mut val requests = <MidOwnershipRequests />
    match requests.request(c: inout c, body: <MidParametricBody.input canonical=invalidCopy />) {
        Result.Err(error: val failure) => { match failure.error { MidVerifyError.UniqueCopy => {} _ => { panic("wrong cached failure") } } }
        _ => { panic("invalid request accepted") }
    }
    val failedBodyCount = c.mid.bodies.count()
    match requests.request(c: inout c, body: <MidParametricBody.input canonical=invalidCopy />) {
        Result.Err(error: val failure) => { match failure.error { MidVerifyError.UniqueCopy => {} _ => { panic("cached failure changed") } } }
        _ => { panic("failed request became successful") }
    }
    if c.mid.bodies.count() != failedBodyCount { panic("failed ownership request was recomputed") }
    match verifyExecutableCanonicalMidBody(c: inout c, canonical: invalidCopy).error {
        MidVerifyError.MissingOwnershipContract => {}
        _ => { panic("executable contract weakened") }
    }
}

fn main() {
    checkSource()
    checkInvalidOwnership()
    print("ok")
}
