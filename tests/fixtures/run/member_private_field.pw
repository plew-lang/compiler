// Module-scoped visibility permits this use; construction and later access are independent.
import @Std/Io with { print }
struct Box { val secret: I64 }
pub impl Box {
    factory initial(secret: I64) { return <Box secret=secret /> }
}
fn main() {
    val b = <Box.initial secret=5 />
    val x: I64 = b.secret
    print(x)
}
