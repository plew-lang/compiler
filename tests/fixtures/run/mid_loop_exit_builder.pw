// The source-level loop test pins observable behaviour. This companion pins
// the Mid producer itself: both exits must first leave the body scope, then
// branch to the selected loop target without an LLVM-side cleanup convention.
use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Mid only { MidBlock, MidBuildError, MidBuildState, MidStatement, MidTerminator, buildMidBlock }

fn built(result: MidBuildError) -> Bool {
    match result {
        MidBuildError.None => { return true }
        _ => { return false }
    }
}

fn hasScopeExit(block: MidBlock, scope: U64) -> Bool {
    if block.statements.count() == 0U64 { return false }
    match block.statements[0U64] {
        MidStatement.ScopeExit(scope: val actual) => { return actual == scope }
        _ => { return false }
    }
}

fn breakBuilderWorks() -> Bool {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="loop-exit.pw" text="fn probe() {{ while true {{ break }} }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val result = buildMidBlock(c: inout c, state: inout state, blockId: c.arena.functionAt(index: owner).body)
    if !built(result: result) || state.blocks.count() != 4U64 { return false }
    // Scope 0 is the root, 1 the enclosing block, 2 the condition, 3 the loop body.
    if !hasScopeExit(block: state.blocks[2U64], scope: 3U64) { return false }
    match state.blocks[2U64].terminator {
        MidTerminator.Goto(target: val target) => { return target == 3U64 }
        _ => { return false }
    }
}

fn continueBuilderWorks() -> Bool {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="loop-exit.pw" text="fn probe() {{ while true {{ continue }} }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val result = buildMidBlock(c: inout c, state: inout state, blockId: c.arena.functionAt(index: owner).body)
    if !built(result: result) || state.blocks.count() != 4U64 { return false }
    // Scope 0 is the root, 1 the enclosing block, 2 the condition, 3 the loop body.
    if !hasScopeExit(block: state.blocks[2U64], scope: 3U64) { return false }
    match state.blocks[2U64].terminator {
        MidTerminator.Goto(target: val target) => { return target == 1U64 }
        _ => { return false }
    }
}

fn main() {
    if breakBuilderWorks() && continueBuilderWorks() {
        write(s: "loop-exit-builder\n")
    } else {
        write(s: "wrong-loop-exit-builder\n")
    }
}
