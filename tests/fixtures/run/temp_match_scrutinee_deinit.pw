import @Std/Io with { print, write }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I64
    deinit { print(self.v) }
}
pub impl Cell { factory }

fn makeOpt() -> Optional[MutableRef[Cell]] {
    return <Optional.Some v=<MutableRef value=<Cell v=8 /> /> />
}

fn main() {
    match makeOpt() {
        Optional.Some(v: val r) => { write(s: "some\n") }
        Optional.None => { write(s: "none\n") }
    }
    write(s: "after\n")
}
