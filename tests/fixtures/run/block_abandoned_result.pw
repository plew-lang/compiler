use @Std/Io only { print }
use @Std/Core only { Ref }
unique struct Resource {
    val id: I64
    deinit { print(self.id) }
}
fn returned() -> I64 {
    val unused = {
        val inner = <Ref[Resource] value=<Resource id=10I64 /> />
        give <Ref[Resource] value=<Resource id=1I64 /> />
        print("after give")
        return 7I64
    }
    return 0I64
}
fn main() {
    print(returned())
    while true {
        val unused = {
            val inner = <Ref[Resource] value=<Resource id=20I64 /> />
            give <Ref[Resource] value=<Resource id=2I64 /> />
            print("unreachable")
        }
        break
    }
    mut val index = 0I64
    while index < 1I64 {
        index += 1I64
        val unused = {
            val inner = <Ref[Resource] value=<Resource id=30I64 /> />
            give <Ref[Resource] value=<Resource id=3I64 /> />
            continue
        }
    }
    print("end")
}
