use @Std/Io only { print }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /Ir only { ArcClass, CallTemplateKind }
fn main() {
    mut val c = <Comp />
    val source = "async fn task() {{}}\nfn caller() {{ val promise = task() }}\n"
    analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text text=source path="async-result.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val declaration = c.arena.functionAt(index: 0U64)
    val result = c.semanticCallableReturnTerm(function: declaration)
    assert(result != 0U64)
    val promise = c.arena.typeAt(index: result)
    assert(promise.args.count() == 1U64)
    // A generic payload is a resolved semantic type, not the zero sentinel
    // reserved for completed callable result slots. Unit is an empty record.
    val payload = promise.args[0U64]
    assert(payload != 0U64)
    val unit = c.arena.typeAt(index: payload)
    assert(unit.isRecord)
    assert(unit.recordFieldTerms.count() == 0U64)
    assert(c.callableResultIsUnit(ref: payload))
    assert(c.semanticBodyReturnTerm(fnIdx: 0U64) == 0U64)
    match c.arcClassOfRef(ref: result).unwrap() {
        ArcClass.PromiseCell(inst: _) => {}
        _ => { assert(false) }
    }
    mut val found = false
    mut val index = 0U64
    while index < c.callTemplateCount() {
        val template = c.callTemplateAt(index: index)
        match template.kind {
            CallTemplateKind.Direct(callee: val callee, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                if callee == 0U64 {
                    assert(c.typeRefEq(a: c.closedSelectedCallResult(siteKey: template.siteKey).unwrap(), b: result))
                    found = true
                }
            }
            _ => {}
        }
        index += 1U64
    }
    assert(found)
    assert(c.monoWork.bodyCount() == 0U64)
    assert(c.arena.finalDestructions.count() == 0U64)
    print("ok")
}
