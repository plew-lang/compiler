// Fields do not determine phantom generic arguments. A recorded construction
// must satisfy its complete nominal type, including arguments not in fields.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="nominal-probe.pw" text="struct Token[T] {{}} enum Marker[T] {{ Empty }} fn probe(expected: Token[I64], actual: Token[Bool], expectedEnum: Marker[I64], actualEnum: Marker[Bool]) {{ val structure = <Token[Bool] /> val enumeration = <Marker[Bool].Empty /> }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val function = compiler.arena.functionAt(index: owner)
    val expectedStruct = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val actualStruct = compiler.funcParamAt(params: function.params, index: 1U64).ty
    val expectedEnum = compiler.funcParamAt(params: function.params, index: 2U64).ty
    val actualEnum = compiler.funcParamAt(params: function.params, index: 3U64).ty
    mut val structure = compiler.arena.exprs.count()
    mut val enumeration = compiler.arena.exprs.count()
    mut val index = 0U64
    while index < compiler.arena.exprs.count() {
        match compiler.arena.exprs[index] {
            Expr.Make(typeStart: _, typeLen: _, variantStart: _, variantLen: _, isEnum: val isEnum, ty: _, fields: _) => {
                if isEnum { enumeration = index } else { structure = index }
            }
            _ => {}
        }
        index += 1U64
    }
    if structure >= compiler.arena.exprs.count() || enumeration >= compiler.arena.exprs.count() { panic "missing construction probes" }
    compiler.prepareLexicalBody(fnIdx: owner).unwrap()
    compiler.cur.checkFn = owner
    if !compiler.genericCheckMakeFields(expectedRef: expectedStruct, valueExpr: structure).unwrap() { panic "struct probe did not exercise construction field checking" }
    if !compiler.genericCheckMakeFields(expectedRef: expectedEnum, valueExpr: enumeration).unwrap() { panic "enum probe did not exercise construction field checking" }
    if compiler.checkGenericTypeMatch(expectedRef: actualStruct, valueExpr: structure).isErr() { panic "matching phantom struct was rejected" }
    if compiler.checkGenericTypeMatch(expectedRef: actualEnum, valueExpr: enumeration).isErr() { panic "matching phantom enum was rejected" }
    if compiler.checkGenericTypeMatch(expectedRef: expectedStruct, valueExpr: structure).isOk() { panic "struct fields replaced complete nominal compatibility" }
    if compiler.checkGenericTypeMatch(expectedRef: expectedEnum, valueExpr: enumeration).isOk() { panic "enum fields replaced complete nominal compatibility" }
    print("recorded-nominal")
}
