import @Plew/Syntax with { Lexer, P, ImportId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxImport, syntaxImportNameCount, syntaxImportNameSpan, syntaxImportNameAliasSpan }
import @Std/Io with { print }

fn main() {
    val source = "import @Std/Io as Console with { print as show, eprint }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val imp = syntaxImport(file: file, id: <ImportId raw=syntaxTopItemPayload(file: file, item: item) />)
    val first = syntaxImportNameSpan(file: file, imp: imp, index: 0U64)
    val firstAlias = syntaxImportNameAliasSpan(file: file, imp: imp, index: 0U64)
    val second = syntaxImportNameSpan(file: file, imp: imp, index: 1U64)
    val secondAlias = syntaxImportNameAliasSpan(file: file, imp: imp, index: 1U64)
    print(syntaxImportNameCount(file: file, imp: imp))
    print(imp.alias.end - imp.alias.start)
    print(first.end - first.start)
    print(firstAlias.end - firstAlias.start)
    print(second.end - second.start)
    print(secondAlias.end - secondAlias.start)
}
