use @Std/Io only { print }
// Typed first branches select a member/namespace candidate before later context.
struct Selector {}
impl Selector {
    fn invoke(callback: fn(value: I64) -> I64) -> I64 { return callback(value: 42I64) }
    fn invoke(callback: fn(value: String) -> String) -> String { return callback(value: "ok") }
    assoc fn associated(callback: fn(value: I64) -> I64) -> I64 { return callback(value: 42I64) }
    assoc fn associated(callback: fn(value: String) -> String) -> String { return callback(value: "ok") }
}
fn main() {
    val selector = <Selector />
    print(selector.invoke(callback: if true { give fn(value: I64) { return value } } else { give fn(value) { return value } }))
    print(Selector.associated(callback: match true { true => { give fn(value: I64) { return value } } false => { give fn(value) { return value } } }))
}
