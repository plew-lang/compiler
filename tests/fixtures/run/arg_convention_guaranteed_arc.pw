import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Box[T] {
    pub val v: T
}
pub impl Box { factory }

fn peek(box: Box[MutableRef[Cell]]) {
    print("peek")
}

fn makeBox(n: I32) -> Box[MutableRef[Cell]] {
    val b: Box[MutableRef[Cell]] = <Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=n /> /> />
    return b
}

fn keepInto(box: Box[MutableRef[Cell]], sink: inout Array[Box[MutableRef[Cell]]]) {
    sink.append(box)
}

fn placeArg() {
    val b: Box[MutableRef[Cell]] = makeBox(n: 41I32)
    peek(box: b)
    print("place-scope-end")
}

fn tempArg() {
    peek(box: makeBox(n: 42I32))
    print("temp-scope-end")
}

fn escapeArg() {
    mut val sink: Array[Box[MutableRef[Cell]]] = []
    val b: Box[MutableRef[Cell]] = makeBox(n: 43I32)
    keepInto(box: b, sink: inout sink)
    print("escape-scope-end")
}

fn passthru(xs: Array[I64]) -> Array[I64] {
    return xs
}

fn arrayParamReturn() {
    val a: Array[I64] = [1, 2, 3]
    val b: Array[I64] = passthru(xs: a)
    print(b[0])
    print(a[2])
}

fn main() {
    placeArg()
    tempArg()
    escapeArg()
    arrayParamReturn()
    print("done")
}
