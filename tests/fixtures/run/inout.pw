import @Std/Io with { print }

struct Counter {
    pub mut val n: I64
    pub mut val xs: Array[I64]
}
pub impl Counter { factory }
fn bump(c: inout Counter, by: I64) {
    c.n += by
    c.xs.append(c.n)
}
fn main() {
    mut val c: Counter = <Counter n=0 xs=[] />
    bump(c: inout c, by: 5)
    bump(c: inout c, by: 7)
    bump(c: inout c, by: 3)
    print(c.n)
    print(c.xs[0])
    print(c.xs[2])
}
