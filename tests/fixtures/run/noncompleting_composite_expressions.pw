use @Std/Io only { print }
fn make(value: I64) -> Array[I64] { return [value] }
fn range(active: Bool) -> I64 {
    for val n in 0I64..<{ give if active { return 7I64 } else { give 0I64 } } { print(n) }
    return 99I64
}
fn array(active: Bool) -> I64 {
    val values = [{ give if active { return 8I64 } else { give 0I64 } }, 1I64]
    return 99I64
}
fn branch(active: Bool) -> I64 {
    val values = [if active { if true { return 9I64 } else { return 99I64 } } else { give 0I64 }]
    return 99I64
}
fn selected(active: Bool) -> I64 {
    val values = [if active { match true { true => { return 10I64 } false => { return 99I64 } } } else { give 0I64 }]
    return 99I64
}
fn iterable(active: Bool) -> I64 {
    for val n in [1I64, { give if active { return 11I64 } else { give 0I64 } }] { print(n) }
    return 99I64
}
fn call(active: Bool) -> I64 {
    for val n in make(value: { give if active { return 12I64 } else { give 0I64 } }) { print(n) }
    return 99I64
}
fn record(active: Bool) -> I64 {
    val value = (value: { give if active { return 13I64 } else { give 0I64 } })
    return 99I64
}
fn nestedRecordArray(active: Bool) -> I64 {
    val value = [(values: [{ give if active { return 14I64 } else { give 0I64 } }])]
    return 99I64
}
fn main() {
    print(range(active: true))
    print(array(active: true))
    print(branch(active: true))
    print(selected(active: true))
    print(iterable(active: true))
    print(call(active: true))
    print(record(active: true))
    print(nestedRecordArray(active: true))
}
