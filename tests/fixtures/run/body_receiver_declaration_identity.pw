use @Std/Core only { assert }
use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { TypeRef, StructDef, Func, InstanceEnvironment, CallResolution, TraitDef, TraitOwner, ResolvedViewSource }
fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internBytes(s: "Repeated")
    val method = compiler.internBytes(s: "method")
    compiler.modules.registerSourceFile(start: 100U64, length: 10U64, moduleId: 1U64, path: "One.pw")
    compiler.modules.registerSourceFile(start: 200U64, length: 10U64, moduleId: 2U64, path: "Two.pw")
    for offset in [100U64, 200U64] {
        compiler.arena.registerStruct(<StructDef nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId typeParams=[] fields=[] isUnique=false isExtern=false defOffset=offset />)
    }
    val firstOwner = compiler.typeDeclIdentityInModule(mod: 1U64, start: name.nameStart, len: name.nameLen)
    val secondOwner = compiler.typeDeclIdentityInModule(mod: 2U64, start: name.nameStart, len: name.nameLen)
    val first = compiler.declaredTypeRef(nameStart: name.nameStart, nameLen: name.nameLen, args: [], declaration: firstOwner)
    val second = compiler.declaredTypeRef(nameStart: name.nameStart, nameLen: name.nameLen, args: [], declaration: secondOwner)
    compiler.arena.registerFunction(<Func nameStart=method.nameStart nameLen=method.nameLen hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64 hasRecv=true recvStart=name.nameStart recvLen=name.nameLen recvTy=first selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    val implicit = compiler.canonicalBodyReceiverRef(fnIdx: 0U64, recvInstRef: 0U64)
    assert(compiler.arena.typeAt(index: implicit).hasDecl)
    assert(compiler.arena.typeAt(index: implicit).declOffset == firstOwner.nameStart)
    assert(compiler.sameBodyRuntimeRef(a: implicit, b: first))
    assert(!compiler.sameBodyRuntimeRef(a: implicit, b: second))
    val unowned = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] />)
    assert(!compiler.sameBodyRuntimeRef(a: first, b: unowned))
    assert(!compiler.typeTermRefSameHead(a: first, b: unowned))
    val defaultEnvironment = compiler.bodyInstanceEnvironment(fnIdx: 0U64, args: [], recvInstRef: 0U64).unwrap()
    val suppliedEnvironment = compiler.bodyInstanceEnvironment(fnIdx: 0U64, args: [], recvInstRef: first).unwrap()
    val firstKey = compiler.internBodyInstance(fnIdx: 0U64, environment: defaultEnvironment)
    assert(firstKey == compiler.internBodyInstance(fnIdx: 0U64, environment: suppliedEnvironment))
    val otherKey = compiler.internBodyInstance(fnIdx: 0U64, environment: <InstanceEnvironment receiverRef=second />)
    assert(firstKey != otherKey)
    assert(compiler.bodyInstanceEnvironment(fnIdx: 0U64, args: [], recvInstRef: second).isErr())
    assert(compiler.bodyInstanceEnvironment(fnIdx: 0U64, args: [], recvInstRef: unowned).isErr())
    assert(compiler.finalCallBodyEnvironmentMatches(callee: 0U64, receiver: first, arguments: [], bodyId: firstKey))
    assert(!compiler.finalCallBodyEnvironmentMatches(callee: 0U64, receiver: first, arguments: [], bodyId: otherKey))
    assert(!compiler.finalCallBodyEnvironmentMatches(callee: 0U64, receiver: unowned, arguments: [], bodyId: firstKey))
    assert(!compiler.finalCallBodyEnvironmentMatches(callee: 0U64, receiver: 0U64, arguments: [], bodyId: firstKey))
    compiler.arena.setBodySignature(bodyId: firstKey, parameters: [], passings: [], result: 0U64, receiverType: first)
    compiler.arena.setBodySignature(bodyId: otherKey, parameters: [], passings: [], result: 0U64, receiverType: second)
    assert(compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=first calleeBodyId=firstKey />).unwrap())
    assert(!compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=first calleeBodyId=otherKey />).unwrap())
    assert(!compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=unowned calleeBodyId=firstKey />).unwrap())
    assert(!compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=second />).unwrap())
    assert(!compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=unowned />).unwrap())
    compiler.arena.setBodySignature(bodyId: firstKey, parameters: [], passings: [], result: 0U64, receiverType: second)
    assert(!compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=first calleeBodyId=firstKey />).unwrap())
    compiler.arena.setBodySignature(bodyId: firstKey, parameters: [], passings: [], result: 0U64, receiverType: 0U64)
    assert(!compiler.finalStaticCalleeIsComplete(e: <CallResolution bodyId=firstKey exprId=0U64 callee=0U64 recvTypeRef=first calleeBodyId=firstKey />).unwrap())
    checkNestedViews(compiler: inout compiler, element: first)
    print("body-receiver-declaration-identity")
}

fn checkNestedViews(compiler: inout Comp, element: U64) {
    val traitName = compiler.internBytes(s: "Facet")
    val otherStart = compiler.arena.bytes.count()
    for byte in "Facet".bytes() { compiler.arena.bytes.append(byte) }
    compiler.decls.registerTraitOwner(<TraitOwner sourceModule=1U64 nameStart=traitName.nameStart nameLen=traitName.nameLen nameId=traitName.nameId arity=0U64 />)
    compiler.decls.registerTraitOwner(<TraitOwner sourceModule=2U64 nameStart=otherStart nameLen=traitName.nameLen nameId=traitName.nameId arity=0U64 />)
    compiler.decls.registerTrait(<TraitDef nameStart=traitName.nameStart nameLen=traitName.nameLen nameId=traitName.nameId reqs=compiler.pushTraitReqs(reqs: []) />)
    compiler.decls.registerTrait(<TraitDef nameStart=otherStart nameLen=traitName.nameLen nameId=traitName.nameId reqs=compiler.pushTraitReqs(reqs: []) />)
    val first = compiler.typeRefWithViewSources(ref: element, sources: [<ResolvedViewSource surfaceId=traitName.nameId traitOwner=traitName.nameStart />])
    val second = compiler.typeRefWithViewSources(ref: element, sources: [<ResolvedViewSource surfaceId=traitName.nameId traitOwner=otherStart />])
    assert(!compiler.typeRefEq(a: first, b: second))
    assert(compiler.typeRefEq(a: compiler.canonicalBodyReceiverRef(fnIdx: 0U64, recvInstRef: first), b: element))
    val name = compiler.internBytes(s: "Wrapper")
    val binds = compiler.lowerTypeParamNames(names: ["Element"], anchor: name.nameStart).unwrap()
    compiler.arena.registerStruct(<StructDef nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId typeParams=binds fields=[] isUnique=false isExtern=false defOffset=300U64 />)
    compiler.modules.registerSourceFile(start: 300U64, length: 10U64, moduleId: 3U64, path: "Wrapper.pw")
    val owner = compiler.typeDeclIdentityInModule(mod: 3U64, start: name.nameStart, len: name.nameLen)
    val parameter = compiler.pushType(t: <TypeRef nameStart=binds[0U64].nameStart nameLen=binds[0U64].nameLen nameId=binds[0U64].nameId paramId=binds[0U64].paramId args=[] />)
    val pattern = compiler.declaredTypeRef(nameStart: name.nameStart, nameLen: name.nameLen, args: [parameter], declaration: owner)
    val left = compiler.declaredTypeRef(nameStart: name.nameStart, nameLen: name.nameLen, args: [first], declaration: owner)
    val right = compiler.declaredTypeRef(nameStart: name.nameStart, nameLen: name.nameLen, args: [second], declaration: owner)
    val method = compiler.internBytes(s: "nested")
    val function = compiler.arena.functionCount()
    compiler.arena.registerFunction(<Func nameStart=method.nameStart nameLen=method.nameLen typeParams=compiler.pushFuncBinds(binds: binds) hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64 hasRecv=true recvStart=name.nameStart recvLen=name.nameLen recvTy=pattern selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    val firstEnvironment = compiler.bodyInstanceEnvironment(fnIdx: function, args: [first], recvInstRef: left).unwrap()
    val secondEnvironment = compiler.bodyInstanceEnvironment(fnIdx: function, args: [second], recvInstRef: right).unwrap()
    assert(compiler.internBodyInstance(fnIdx: function, environment: firstEnvironment) != compiler.internBodyInstance(fnIdx: function, environment: secondEnvironment))
}
