use @Plew/Syntax only { parseExprFrom, ExprAst }
use @Std/Io only { print }

fn main() {
    val call = parseExprFrom(source: "call(label: 1I32)", start: 0U64)
    match call {
        ExprAst.Call(name: _, val nameSpan, args: _, span: _) => {
            print(nameSpan.start)
            print(nameSpan.end)
        }
        _ => {}
    }
    val extensionCall = parseExprFrom(source: "value#Ext.method()", start: 0U64)
    match extensionCall {
        ExprAst.Method(recv: val receiver, name: _, val nameSpan, args: _, span: _) => {
            match receiver {
                ExprAst.SourceSelection(recv: _, path: _, application: _, strip: _, val sourceSpan, span: _) => {
                    print(sourceSpan.start)
                    print(sourceSpan.end)
                    print(nameSpan.start)
                    print(nameSpan.end)
                }
                _ => {}
            }
        }
        _ => {}
    }
}
