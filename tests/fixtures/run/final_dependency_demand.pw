use /Frontend only { Comp, FrontendInput, FinalBodyRequests, FinalDependencies, FinalizationPublication, analyzeFrontendForRequests, spansEqual }
use /SourceAccess only { SourceAccess }
use @Std/Io only { print }

fn owner(c: inout Comp, name: String) -> U64 {
    val span = c.internBytes(s: name)
    mut val index = 0U64
    while index < c.arena.functionCount() {
        val function = c.arena.functionAt(index: index)
        if spansEqual(c: inout c, aStart: function.nameStart, aLen: function.nameLen, bStart: span.nameStart, bLen: span.nameLen) { return index }
        index += 1U64
    }
    panic "missing declaration"
}

fn main() {
    mut val c = <Comp />
    val source = "unique struct Resource {} impl Resource { deinit { missing() } } fn make() -> Resource { return <Resource /> } fn initial() -> I64 { missing() } val number = initial() fn main() {}"
    analyzeFrontendForRequests(c: inout c, input: <FrontendInput.Text path="dependencies.pw" text=source />, sources: <SourceAccess />).unwrap()
    c.initializeFinalCallables().unwrap()
    mut val requests = <FinalBodyRequests />
    mut val dependencies = <FinalDependencies />
    mut val publication = <FinalizationPublication />
    c.cur.checkFn = 77U64
    c.cur.bodyId = 88U64
    c.inCollection = false
    c.prepareFinalInitializers(state: inout dependencies).unwrap()
    c.closeFinalDependencies(state: inout dependencies).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    if c.cur.checkFn != 77U64 || c.cur.bodyId != 88U64 || c.inCollection { panic "initializer request leaked context" }
    val initialCalls = c.finalCalleeCount()
    val initialBodies = c.monoWork.bodyCount()
    if initialCalls == 0U64 || initialBodies == 0U64 { panic "global initializer did not prepare dependencies" }
    c.prepareFinalInitializers(state: inout dependencies).unwrap()
    c.closeFinalDependencies(state: inout dependencies).unwrap()
    if c.finalCalleeCount() != initialCalls || c.monoWork.bodyCount() != initialBodies { panic "global initializer repeated" }
    val maker = c.enqueueFinalBody(fnIdx: owner(c: inout c, name: "make"), args: [], recvInstRef: 0U64).unwrap()
    c.requestFinalBody(bodyId: maker, requests: inout requests).unwrap()
    c.closeFinalDependencies(state: inout dependencies).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    val term = c.arena.bodySignature(bodyId: maker).resultType
    val destruction = c.finalDestructionIndex(typeRef: term)
    if destruction == 0U64 { panic "result destruction dependency missing" }
    val contract = c.arena.finalDestructions[destruction - 1U64]
    if !contract.ready || !contract.deinitCall.ready || contract.deinitCall.bodyId == 0U64 { panic "destructor ABI was not published" }
    if c.lexicalBodyPreparations.count() != 1U64 { panic "dependency closure requested a callee body" }
    val calls = c.finalCalleeCount()
    val types = c.arena.finalDestructions.count()
    c.closeFinalDependencies(state: inout dependencies).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    if c.finalCalleeCount() != calls || c.arena.finalDestructions.count() != types { panic "dependency closure repeated" }
    match c.requestFinalBody(bodyId: contract.deinitCall.bodyId, requests: inout requests) {
        Result.Ok(value: _) => { panic "invalid destructor body accepted" }
        Result.Err(error: _) => {}
    }
    if c.cur.checkFn != 77U64 || c.cur.bodyId != 88U64 || c.inCollection { panic "dependency request leaked context" }
    print("ok")
}
