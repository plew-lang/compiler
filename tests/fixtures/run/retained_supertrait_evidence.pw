use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { CallTemplateKind, CallableConstraintEvidence, StaticConformanceProof, StaticProofInstantiation, DeclarationBoundRef, SupertraitRef, InstanceEnvironment, ConformanceProofDemand, ConformanceProofResult, PatternBindInput, PatternTypeInput }
use @Std/Io only { print }

fn checkPreferredInheritedPath() {
    mut val compiler = <Comp />
    val source = "trait Base {{}} trait Shared: Base {{}} trait Left: Shared {{}} trait Right: Shared {{}} trait Diamond: Left + Right {{}} fn bind[T](value: T) where T: Diamond {{}}"
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path="preferred-supertraits.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "bind").nameId)
    val declaration = compiler.arena.functionAt(index: function)
    val receiver = compiler.funcParamAt(params: declaration.params, index: 0U64).ty
    val assumptions = compiler.functionBoundAssumptions(fnIdx: function)
    val baseName = compiler.internBytes(s: "Base").nameId
    val leftName = compiler.internBytes(s: "Left").nameId
    val rightName = compiler.internBytes(s: "Right").nameId
    mut val base = 0U64
    mut val left = 0U64
    mut val right = 0U64
    for index in 0U64..<compiler.decls.traitCount() {
        val trait = compiler.decls.traitAt(index: index)
        if trait.nameId == baseName { base = trait.nameStart }
        if trait.nameId == leftName { left = trait.nameStart }
        if trait.nameId == rightName { right = trait.nameStart }
    }
    if base == 0U64 || left == 0U64 || right == 0U64 { panic("missing test trait owner") }
    for owner in [left, right] {
        val result = compiler.queryTraitPatternProof(demand: <ConformanceProofDemand.SourceAdmission />, baseRef: receiver, traitId: baseName, traitOwner: base, traitArgs: <PatternTypeInput.Values values=[] />, patternParams: <PatternBindInput.Values values=[] />, assumptions: assumptions, sourceOwners: [owner]).unwrap()
        mut val retained = false
        match result {
            ConformanceProofResult.Found(proof: val proof) => {
                match proof {
                    StaticConformanceProof.AssumedSupertraitPath(source: _, steps: val steps) => {
                        for step in steps {
                            if compiler.decls.traitAt(index: step.traitIndex).nameStart == owner { retained = true }
                        }
                    }
                    _ => {}
                }
            }
            _ => { panic("diamond did not retain a unique preferred proof") }
        }
        if !retained { panic("converging supertraits discarded the preferred branch") }
    }
}

fn main() {
    checkPreferredInheritedPath()
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text text="trait Parent[A] {{}} trait Child[A]: Parent[A] {{}} struct Box[V] {{}} impl[V] Box[V] as Parent[V] {{}} impl[V] Box[V] as Child[V] where Box[V]: Parent[V] {{}} struct Foreign {{}} impl Foreign as Parent[I64] {{}} impl Foreign as Child[I64] where Foreign: Parent[I64] {{}} fn accept[V](value: V) where V: Parent[I64] {{}} fn forward[V](value: V) where V: Child[I64] {{ accept(value: value) }} fn context(value: Box[I64]) {{}}" path="retained-supertraits.pw" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val forward = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "forward").nameId)
    val context = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "context").nameId)
    val receiver = compiler.funcParamAt(params: compiler.arena.functionAt(index: context).params, index: 0U64).ty
    compiler.prepareLexicalBody(fnIdx: forward).unwrap()
    val substitution = compiler.bodyInstanceEnvironment(fnIdx: forward, args: [receiver], recvInstRef: 0U64).unwrap()
    val environment = compiler.environmentWithCallableConstraints(fnIdx: forward, environment: substitution, evidence: <CallableConstraintEvidence.Declaration />).unwrap()
    val bindings = environment.constraints.unwrap()
    val root = compiler.thawStaticConformanceProof(id: compiler.arena.callableConstraintProofAt(evidence: bindings, index: 0U64))
    val witness = compiler.selectedConstraintWitness(proof: root).unwrap()
    val selectedEnvironment = compiler.selectedConstraintEnvironment(witness: witness).unwrap()
    val declaration = compiler.decls.conformAt(index: witness.conformIdx - 1U64)
    val condition = <StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Conformance index=declaration.bounds.start /> />
    val expected = match compiler.instantiateConstraintProof(proof: condition, receiverRef: receiver, environment: selectedEnvironment, selfRef: receiver, itemRef: 0U64).unwrap() {
        StaticProofInstantiation.Ready(proof: val proof) => { give proof }
        _ => { panic("missing retained conformance condition") }
    }
    if compiler.instantiateConstraintProof(proof: condition, receiverRef: receiver, environment: <InstanceEnvironment params=selectedEnvironment.params args=selectedEnvironment.args receiverRef=selectedEnvironment.receiverRef />, selfRef: receiver, itemRef: 0U64).isOk() { panic("missing witness environment was repaired by search") }
    val foreign = <StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Conformance index=declaration.bounds.start + declaration.bounds.len /> />
    if compiler.instantiateConstraintProof(proof: foreign, receiverRef: receiver, environment: selectedEnvironment, selfRef: receiver, itemRef: 0U64).isOk() { panic("foreign conformance condition was accepted") }
    if compiler.arena.publishConformanceSupertraits(conformance: witness.conformIdx - 1U64, proofs: []) { panic("published supertrait evidence was replaced") }
    mut val found = false
    for template in compiler.callTemplateSnapshot() {
        if template.siteKey.ownerFnIdx == forward {
            match template.kind {
                CallTemplateKind.Direct(callee: _, receiver: _, args: _, calleeTypeArgs: _, proofId: _) => {
                    val index = compiler.callTemplateIndex(siteKey: template.siteKey)
                    val plan = compiler.preparedCallConstraints(index: index).unwrap().constraints()
                    val proof = compiler.thawStaticConformanceProof(id: plan.proofs[0U64])
                    match proof {
                        StaticConformanceProof.AssumedSupertraitPath(source: val source, steps: val steps) => {
                            match compiler.instantiateConstraintProof(proof: proof, receiverRef: receiver, environment: environment, selfRef: 0U64, itemRef: 0U64).unwrap() {
                                StaticProofInstantiation.Ready(proof: val actual) => {
                                    if !compiler.sameStaticConformanceProof(a: actual, b: expected) { panic("supertrait selected another condition witness") }
                                }
                                _ => { panic("missing retained supertrait") }
                            }
                            val invalid = [<SupertraitRef traitIndex=steps[0U64].traitIndex boundIndex=steps[0U64].boundIndex + 1U64 />]
                            if compiler.instantiateSupertraitConstraint(source: source, steps: invalid, receiverRef: receiver, environment: environment, selfRef: 0U64, itemRef: 0U64).isOk() { panic("missing declaration edge was repaired by search") }
                            val foreignSteps = [<SupertraitRef traitIndex=compiler.decls.traitCount() boundIndex=0U64 />]
                            if compiler.instantiateSupertraitConstraint(source: source, steps: foreignSteps, receiverRef: receiver, environment: environment, selfRef: 0U64, itemRef: 0U64).isOk() { panic("foreign trait edge was accepted") }
                            found = true
                        }
                        _ => { panic("source did not retain its inherited bound path") }
                    }
                }
                _ => {}
            }
        }
    }
    if !found { panic("missing inherited call constraint") }
    print("retained-supertrait-evidence")
}
