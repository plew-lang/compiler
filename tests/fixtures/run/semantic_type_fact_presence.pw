// Construction-time queries distinguish missing, pending and value facts;
// callable result producers establish Unit and absence of a normal value.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, spansEqual }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, TypeRef, SemanticExpressionTypeState }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="fact-probe.pw" text="struct Array[T] {{}} fn probe() {{}}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    compiler.cur.checkFn = 0U64
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen nameId=integerName.nameId args=[] />)
    val literal = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    if compiler.hasSemanticExprTypeFact(exprId: literal) { panic "allocation is not a type fact" }
    compiler.recordExpr(exprId: literal).unwrap()
    if !compiler.hasSemanticExprTypeFact(exprId: literal) { panic "recorded unknown was mistaken for missing" }
    match compiler.sourceSemanticExprTypeAt(index: literal).typeState {
        SemanticExpressionTypeState.Pending => {}
        _ => { panic "untyped literal is not pending" }
    }
    if compiler.inferenceArgumentType(exprId: literal).unwrap() != 0U64 { panic "pending literal acquired an inferred type" }
    compiler.recordExpr(exprId: literal, expectedTerm: integer).unwrap()
    if !compiler.typeRefEq(a: compiler.inferenceArgumentType(exprId: literal).unwrap(), b: integer) { panic "explicit refinement was not retained" }
    compiler.recordExpr(exprId: literal).unwrap()
    match compiler.sourceSemanticExprTypeAt(index: literal).typeState {
        SemanticExpressionTypeState.Value => {}
        _ => { panic "context-free rerecord erased a value fact" }
    }
    val typeCount = compiler.arena.typeCount()
    if !compiler.typeRefEq(a: compiler.semanticExprTerm(exprId: literal), b: integer) || compiler.arena.typeCount() != typeCount { panic "reader materialized or changed a type" }
    val elements = compiler.pushExprs(exprs: [])
    val array = compiler.pushExpr(e: <Expr.Array elems=elements />)
    compiler.recordExpr(exprId: array).unwrap()
    if compiler.inferenceArgumentType(exprId: array).unwrap() != 0U64 { panic "untyped array acquired an element type" }
    val arrayType = compiler.arrayRefOfElem(elemRef: integer)
    compiler.recordExpr(exprId: array, expectedTerm: arrayType).unwrap()
    val arrayShape = compiler.sourceSemanticExprTypeAt(index: array).shape
    compiler.recordExpr(exprId: array).unwrap()
    if !compiler.typeRefEq(a: compiler.semanticExprTerm(exprId: array), b: arrayType) || compiler.sourceSemanticExprTypeAt(index: array).shape != arrayShape { panic "context-free rerecord erased an aggregate fact" }

    mut val calls = <Comp />
    analyzeFrontendForRequests(c: inout calls,
        input: <FrontendInput.Text path="result-facts.pw" text="fn unit() {{}} diverge fn stop() {{ panic(\"stop\") }} fn probe() {{ val result = unit() stop() }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val unitName = calls.internBytes(s: "unit")
    val stopName = calls.internBytes(s: "stop")
    mut val unit = calls.arena.exprs.count()
    mut val stopped = calls.arena.exprs.count()
    mut val index = 0U64
    while index < calls.arena.exprs.count() {
        match calls.arena.exprs[index] {
            Expr.Call(val nameStart, val nameLen, args: _) => {
                if spansEqual(c: inout calls, aStart: nameStart, aLen: nameLen, bStart: unitName.nameStart, bLen: unitName.nameLen) { unit = index }
                if spansEqual(c: inout calls, aStart: nameStart, aLen: nameLen, bStart: stopName.nameStart, bLen: stopName.nameLen) { stopped = index }
            }
            _ => {}
        }
        index += 1U64
    }
    if unit >= calls.arena.exprs.count() || stopped >= calls.arena.exprs.count() { panic "missing callable probes" }
    val owner = calls.arena.firstFunctionNamed(nameId: calls.internBytes(s: "probe").nameId)
    calls.prepareLexicalBody(fnIdx: owner).unwrap()
    match calls.sourceSemanticExprTypeAt(index: unit).typeState {
        SemanticExpressionTypeState.Unit => {}
        _ => { panic "selected Unit result became pending" }
    }
    match calls.sourceSemanticExprTypeAt(index: stopped).typeState {
        SemanticExpressionTypeState.NoNormalValue => {}
        _ => { panic "diverging callable acquired a normal value" }
    }
    if calls.inferenceArgumentType(exprId: stopped).unwrap() != 0U64 { panic "diagnostic type became an inference value" }
    print("semantic-type-fact-presence")
}
