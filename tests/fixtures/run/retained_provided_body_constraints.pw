use /Frontend only { Comp, FrontendInput, analyzeFrontend }
use /Ir only { CallableConstraintEvidence, FuncBound, InstanceEnvironment }
use /SourceAccess only { SourceAccess }
use @Std/Io only { print }
fn main() {
    mut val compiler = <Comp />
    match analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text="trait Marker {{ fn value() -> I64 }}\ntrait Root {{ fn root() -> I64 }}\npub impl Root {{\n    fn forward[T](value: T) -> I64 where T: Marker {{ return accept(value: value) }}\n}}\nstruct Item {{}}\npub impl Item {{ factory }}\nimpl Item as Marker {{ fn value() -> I64 {{ return 42I64 }} }}\nimpl Item as Root {{ fn root() -> I64 {{ return 0I64 }} }}\nfn accept[T](value: T) -> I64 where T: Marker {{ return value.value() }}\nfn caller[R, T](receiver: R, value: T) -> I64 where R: Root, T: Marker {{ return receiver.forward(value: value) }}\nfn main() {{\n    val result = caller(receiver: <Item />, value: <Item />)\n}}\n" path="provided-constraints.pw" />, sources: <SourceAccess stdRoot=[] />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
    val name = compiler.internBytes(s: "forward").nameId
    mut val found = false
    mut val index = 0U64
    while index < compiler.arena.bodyInstanceCount() {
        val body = compiler.arena.bodyInstanceAt(index: index)
        if body.fnIdx < compiler.arena.functionCount() && compiler.arena.functionAt(index: body.fnIdx).nameId == name {
            val constraints = body.environment.constraints.unwrap()
            if compiler.arena.callableConstraintCount(evidence: constraints) != 1U64 { panic("provided body lost constraint evidence") }
            val owner = compiler.arena.functionLexicalOwner(index: body.fnIdx)
            val clause = compiler.decls.funcBounds.indices(owner: owner)[0U64]
            val original = compiler.decls.funcBounds.at(index: clause)
            val bound = compiler.arena.callableConstraintBoundAt(evidence: constraints, index: 0U64)
            val proof = compiler.thawStaticConformanceProof(id: compiler.arena.callableConstraintProofAt(evidence: constraints, index: 0U64))
            val environment = <InstanceEnvironment params=body.environment.params args=body.environment.args receiverRef=body.environment.receiverRef proof=body.environment.proof />
            val recorded = <CallableConstraintEvidence.Recorded bounds=[bound] proofs=[proof] />
            compiler.environmentWithCallableConstraints(fnIdx: body.fnIdx, environment: environment, evidence: recorded).unwrap()
            compiler.decls.funcBounds.set(index: clause, value: <FuncBound fnIdx=owner sourceClause=0U64 paramStart=original.paramStart paramLen=original.paramLen paramTy=0U64 paramNameId=original.paramNameId constraint=original.constraint />)
            if compiler.environmentWithCallableConstraints(fnIdx: body.fnIdx, environment: environment, evidence: recorded).isErr() {
                panic "executable admission replaced the provided declaration's retained clause"
            }
            compiler.decls.funcBounds.set(index: clause, value: original)
            found = true
        }
        index += 1U64
    }
    if !found { panic("provided call did not demand its body") }
    print("retained-provided-body-constraints")
}
