use @Std/Io only { print }
trait Source { type Item }
trait Left {}
trait Right {}
impl Left as Source { type Item = I64 }
impl Right as Source { type Item = I64 }
struct Number {}
impl Number as Left {}
impl Number as Right {}
struct Box[Key, Item] { val item: Item }
extension Extra {
    impl[T] Box[T, T#Source.Item] where T: Source { fn nope() -> I64 { return 7I64 } }
    impl Box[Number, I64] { fn answer() -> I64 { return 42I64 } }
}
fn main() {
    val extra = <Box[Number,I64] item=42I64 />#Extra
    print(extra.answer())
}
