import @Std/Io with { print }

// Compound assignment desugars to `target = target OP value` and routes the OP
// through the operator-trait witness like any binary (spec/12) — no built-in
// fast path for primitives. Covers arithmetic, div/rem, and bitwise/shift.
fn main() {
    mut val n: I64 = 10I64
    n += 5I64    // 15
    n -= 3I64    // 12
    n *= 2I64    // 24
    n /= 5I64    // 4
    n %= 3I64    // 1
    print(n)     // 1
    mut val f: U64 = 12U64
    f &= 10U64   // 8
    f |= 1U64    // 9
    f ^= 3U64    // 10
    f <<= 2U64   // 40
    f >>= 1U64   // 20
    print(f)     // 20
}
