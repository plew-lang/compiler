// The final body gate consumes retained evidence even when a fresh lookup
// could prove the same trait. Missing evidence must not be silently repaired.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { CallTemplateKind, CallableConstraintEvidence, StaticConformanceProof, StaticProofInstantiation, DeclarationBoundRef, InstanceEnvironment, SelectedCallConstraints, WitnessMatch, WitnessConditionPlan, SelectedWitnessInstantiation }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text text="trait Q {{}} struct Item {{}} impl Item as Q {{}} struct Box[Value] {{}} impl[Value] Box[Value] as Q where Value: Q {{}} fn boxed(value: Box[Item]) {{}} fn free[Value](value: Value) where Value: Q {{}} extern(c) {{ fn foreign() }} fn probe() {{ free(value: <Item />) }}" path="direct-constraints.pw" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val callee = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "free").nameId)
    compiler.prepareLexicalBody(fnIdx: owner).unwrap()
    mut val found = false
    for template in compiler.decls.callTemplates {
        match template.kind {
            CallTemplateKind.Direct(callee: val function, receiver: _, args: _, calleeTypeArgs: val types, proofId: _) => {
                if function == callee && template.siteKey.ownerFnIdx == owner {
                    val index = compiler.decls.callTemplateIndex(siteKey: template.siteKey)
                    val snapshot = compiler.decls.preparedCallConstraints(index: index).unwrap()
                    val plan = snapshot.constraints()
                    if compiler.decls.recordBuildingCallConstraints(index: index, plan: <SelectedCallConstraints owner=plan.owner bounds=plan.bounds proofs=[] />) {
                        panic("construction writer replaced a prepared call plan")
                    }
                    if compiler.decls.preparedCallConstraints(index: index).unwrap().constraints().proofs.count() != plan.proofs.count() {
                        panic("prepared snapshot changed after a rejected construction write")
                    }
                    val evidence = compiler.instantiateBodyCallConstraints(template: template).unwrap()
                    val arguments = compiler.callTemplateTypeArgs(range: types)
                    val environment = compiler.bodyInstanceEnvironment(fnIdx: callee, args: arguments, recvInstRef: 0U64).unwrap()
                    compiler.checkCallableConstraintEvidence(fnIdx: callee, environment: environment, evidence: evidence).unwrap()
                    match evidence {
                        CallableConstraintEvidence.Recorded(val bounds, val proofs) => {
                            if bounds.count() != 1U64 || proofs.count() != 1U64 { panic("missing concrete call evidence") }
                            val body = compiler.enqueueFinalBody(fnIdx: callee, args: arguments, recvInstRef: 0U64, constraints: evidence).unwrap()
                            val retained = compiler.arena.bodyInstanceAt(index: body - 1U64).environment
                            val bindings = retained.constraints.unwrap()
                            if compiler.arena.callableConstraintCount(evidence: bindings) != 1U64 { panic("callee discarded constraint evidence") }
                            val declared = compiler.arena.callableConstraintSourceAt(evidence: bindings, index: 0U64)
                            val savedContext = compiler.cur
                            compiler.enterBodyInstance(fnIdx: callee, environment: retained)
                            if compiler.cur.bodyId != body { panic("callee context selected another body identity") }
                            val assumed = <StaticConformanceProof.AssumedBound source=declared />
                            match compiler.instantiateConstraintProof(proof: assumed, receiverRef: bounds[0U64].subject, environment: compiler.cur.bodyEnvironment, selfRef: compiler.cur.bodySelfRef, itemRef: compiler.cur.bodyItemRef).unwrap() {
                                StaticProofInstantiation.Ready(proof: val forwarded) => {
                                    if !compiler.sameStaticConformanceProof(a: forwarded, b: proofs[0U64]) { panic("forwarded call selected a different proof") }
                                }
                                _ => { panic("retained call constraint did not instantiate") }
                            }
                            val boxed = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "boxed").nameId)
                            val boxedType = compiler.funcParamAt(params: compiler.arena.functionAt(index: boxed).params, index: 0U64).ty
                            val selected = compiler.viewedTraitConstraintProof(ref: boxedType, constraint: bounds[0U64].constraint).unwrap()
                            val conditional = match selected {
                                StaticConformanceProof.ConcreteWitness(witness: val witness) => { give witness }
                                _ => { panic("missing conditional witness") }
                            }
                            val substitution = <WitnessMatch selfRef=conditional.selfRef conformIdx=conditional.conformIdx binds=conditional.binds />
                            val conditionId = compiler.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=substitution proofs=[compiler.freezeStaticConformanceProof(proof: assumed)] />)
                            val dependent = <WitnessMatch selfRef=substitution.selfRef conformIdx=substitution.conformIdx binds=substitution.binds conditions=conditionId />
                            match compiler.groundSelectedWitness(witness: dependent, receiverRef: boxedType, environment: retained, selfRef: 0U64, itemRef: 0U64).unwrap() {
                                SelectedWitnessInstantiation.Ready(witness: val concrete) => {
                                    val child = compiler.thawStaticConformanceProof(id: compiler.arena.witnessConditionPlanAt(index: concrete.conditions - 1U64).proofs[0U64])
                                    if !compiler.sameStaticConformanceProof(a: child, b: proofs[0U64]) { panic("condition replaced retained presence proof") }
                                }
                                _ => { panic("condition did not consume retained evidence") }
                            }
                            if compiler.groundSelectedWitness(witness: dependent, receiverRef: boxedType, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64).isOk() { panic("condition repaired missing binding by searching") }
                            compiler.cur.bodyEnvironment = <InstanceEnvironment />
                            if compiler.instantiateConstraintProof(proof: assumed, receiverRef: bounds[0U64].subject, environment: compiler.cur.bodyEnvironment, selfRef: compiler.cur.bodySelfRef, itemRef: compiler.cur.bodyItemRef).isOk() { panic("missing binding was repaired by conformance lookup") }
                            compiler.cur = savedContext
                            val broken = <CallableConstraintEvidence.Recorded bounds=bounds proofs=[<StaticConformanceProof.Missing />] />
                            if compiler.enqueueFinalBody(fnIdx: callee, args: arguments, recvInstRef: 0U64, constraints: broken).isOk() {
                                panic("final body gate replaced missing retained proof with a fresh conformance")
                            }
                            val bodyless = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "foreign").nameId)
                            compiler.enqueueFinalBody(fnIdx: bodyless, args: [], recvInstRef: 0U64, constraints: <CallableConstraintEvidence.Recorded bounds=[] proofs=[] />).unwrap()
                            if compiler.enqueueFinalBody(fnIdx: bodyless, args: [], recvInstRef: 0U64, constraints: broken).isOk() {
                                panic("bodyless call skipped retained constraint evidence")
                            }
                        }
                        _ => { panic("direct call used declaration-time reselection") }
                    }
                    found = true
                }
            }
            _ => {}
        }
    }
    if !found { panic("missing direct source call") }
    print("direct-constraint-instantiation")
}
