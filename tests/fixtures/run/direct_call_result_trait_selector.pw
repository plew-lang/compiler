// A direct call publishes the selected return annotation before the local is bound.
use @Std/Io only { print }
trait A {}
trait B {}
pub impl A { fn number() -> I64 { return 11I64 } }
pub impl B { fn number() -> I64 { return 22I64 } }
struct S {}
impl S as A {}
impl S as B {}
fn make() -> S#A { return <S />#A }
fn main() { val v = make() print(v.number()) }
