// Module-scoped visibility permits this use; construction and later access are independent.
import @Std/Io with { print }
struct Box { val secret: I64 }
pub impl Box {
    factory make(secret: I64) { return <Box secret=secret /> }
}
extension View {
    impl Box {
        fn reveal() -> I64 { return self.secret }
    }
}
fn main() {
    val b = <Box.make secret=3 />
    val n = b#View.reveal()
    print(n)
}
