use @Std/Io only { print }
trait Source {}
trait Implicit { assoc fn first() fn read() }
trait Explicit { assoc fn second() -> () fn write() -> () }
impl Source as Implicit { assoc fn first() -> () { print(7I64) return () } fn read() -> () { print(13I64) return () } }
impl Source as Explicit { assoc fn second() { print(11I64) } fn write() { print(17I64) } }
struct S {}
impl S as Source {}
fn invoke[T](value: T) where T: Implicit, T: Explicit {
    T.first()
    T.second()
    value.read()
    value.write()
}
fn main() {
    S.first()
    S.second()
    <S />.read()
    <S />.write()
    invoke(value: <S />)
}
