// capture binding `val x =>` (spec/11): a named wildcard that binds the whole
// scrutinee, on scalar / literal matches (`match` arms have no guards — refine with
// a literal arm + a capture catch-all, or a nested match).
import @Std/Io with { print }

fn classify(n: I64) -> I64 {
    return match n {
        0 => 100
        1 => 200
        val x => x + 1
    }
}

fn bump(n: I64) -> I64 { return n + 1 }

fn main() {
    print(classify(n: 0))
    print(classify(n: 1))
    print(classify(n: 5))
    // non-Ident scrutinee with a pure capture (the wrapper path).
    val r: I64 = match bump(n: 41) { val x => x + 1 }
    print(r)
}
