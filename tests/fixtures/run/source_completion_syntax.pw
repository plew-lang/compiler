// Exercise the shared walker, not just the pure edge-composition functions.
// Use the supported while syntax; this does not claim support for loop expressions.
use @Plew/Syntax only { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxTopItemPayload }
use /Frontend only { Comp }
use /SourceCompletion only { SourceCompletion }
use @Std/Core only { assert }
use @Std/Io only { print }

fn completion(source: String) -> SourceCompletion {
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    assert(!parser.hasErr, message: parser.errMsg)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    mut val compiler = <Comp />
    compiler.appendSrc(from: source.bytes())
    compiler.syntax = file
    val body = compiler.lowerSyntaxBlock(id: decl.body).unwrap()
    return compiler.blockCompletion(blkId: body)
}

fn main() {
    val staticResult = completion(source: "fn body() {{ val value = {{ while true {{}}\n give 1I64 }} }}")
    assert(staticResult.source.normal() && !staticResult.execution.normal(), message: "staticResult")
    val loopReturn = completion(source: "fn body() {{ while true {{ return 0I64 }} }}")
    assert(loopReturn.source.normal() && !loopReturn.execution.normal() && loopReturn.execution.returns(), message: "loopReturn")
    val mixed = completion(source: "fn body() {{ if flag {{ return 0I64 }} else {{ while true {{}} }} }}")
    assert(mixed.source.normal() && !mixed.execution.normal(), message: "mixed")
    val allReturns = completion(source: "fn body() {{ if flag {{ return 0I64 }} else {{ return 1I64 }} }}")
    assert(!allReturns.source.normal() && allReturns.source.returns() && !allReturns.execution.normal(), message: "allReturns")
    val emptyMatch = completion(source: "fn body() {{ match empty {{}} }}")
    assert(!emptyMatch.source.normal() && emptyMatch.source.diverges() && !emptyMatch.execution.normal(), message: "emptyMatch")
    val nested = completion(source: "fn body() {{ while true {{ while true {{ break }} }} }}")
    assert(nested.source.normal() && !nested.execution.normal() && !nested.execution.breaks(), message: "nested")
    val deadReturn = completion(source: "fn body() {{ while true {{}}\n return 0I64 }}")
    assert(!deadReturn.source.normal() && deadReturn.source.returns() && !deadReturn.execution.returns(), message: "deadReturn")
    val closure = completion(source: "fn body() {{ val callback = fn() {{ return }} }}")
    assert(closure.source.normal() && closure.execution.normal() && !closure.source.returns() && !closure.execution.returns(), message: "closure")
    // try preserves Ok continuation and adds only an enclosing-function return.
    val propagated = completion(source: "fn body() {{ val value = try result }}")
    assert(propagated.source.normal() && propagated.source.returns(), message: "try source return")
    assert(propagated.execution.normal() && propagated.execution.returns(), message: "try execution return")
    val nestedTry = completion(source: "fn body() {{ val value = {{ give try result }} }}")
    assert(nestedTry.source.normal() && nestedTry.source.returns() && !nestedTry.source.gives(), message: "nested try source")
    assert(nestedTry.execution.normal() && nestedTry.execution.returns(), message: "nested try execution")
    // An operand that cannot execute must not invent an executable error edge.
    val deadTry = completion(source: "fn body() {{ val value = try {{ while true {{}}\n give result }} }}")
    assert(deadTry.source.normal() && deadTry.source.returns(), message: "dead try source")
    assert(!deadTry.execution.normal() && !deadTry.execution.returns(), message: "dead try execution")
    val closureTry = completion(source: "fn body() {{ val callback = fn() {{ val value = try result }} }}")
    assert(!closureTry.source.returns() && !closureTry.execution.returns(), message: "closure try boundary")
    print("ok")
}
