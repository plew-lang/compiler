use @Std/Io only { print }
trait Leaf { type Kind }
trait Source[Kind] { type Item }
trait Marker[Kind] {}
struct Token {}
struct Number {}
struct Other {}
impl Other as Marker[Number#Source[I64].Item] {}
impl Number as Source[Token#Leaf.Kind] { type Item=I64 }
impl Token as Leaf { type Kind=I64 }
fn useMarker[T](value: T) -> I64 where T: Marker[I64] { return 42I64 }
fn main() { print(useMarker(value: <Other />)) }
