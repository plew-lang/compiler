use @Std/Io only { print }
use @Std/Core only { Buffer, bufferAppend, bufferCount, bufferGet, bufferRemoveAt }

// Removing from the middle transfers that slot while relocating its suffix.
val midBufferRemoveAtAnchor: I64 = 0I64

fn takeMiddle(buffer: inout Buffer[I64]) -> I64 {
    return bufferRemoveAt(buffer: inout buffer, index: 1U64)
}

fn main() {
    mut val buffer: Buffer[I64] = Buffer.new()
    bufferAppend(buffer: inout buffer, value: 10I64)
    bufferAppend(buffer: inout buffer, value: 20I64)
    bufferAppend(buffer: inout buffer, value: 30I64)
    print(<String value=takeMiddle(buffer: inout buffer) />)
    print(<String value=bufferGet(buffer: buffer, index: 1U64) />)
    print(<String value=bufferCount(buffer: buffer) />)
}
