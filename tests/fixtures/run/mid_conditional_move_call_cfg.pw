use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Mid only { MidBuildError, MidBuildState, MidBody, MidOwnership, MidStatement, MidVerifyError, addMidLocal, analyzeCanonicalMidOwnership, buildMidIf, elaborateCanonicalMidDrops, verifyCanonicalMidBody }

fn main() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="conditional-call-cfg.pw" text="unique struct File {{}} fn consume(file: move File) {{}} fn probe(file: move File) {{ if true {{ consume(file: move file) }} else {{}} }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    val function = c.arena.functionAt(index: owner)
    val parameter = c.funcParamAt(params: function.params, index: 0U64)
    val ifStatement = c.blockStmtAt(blkId: function.body, index: 0U64)
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val file = addMidLocal(state: inout state, declarationTarget: parameter.nameStart, typeTerm: parameter.ty, isUnique: true, isParameter: true, ownsAtEntry: true)
    val result = buildMidIf(c: inout c, state: inout state, stmtId: ifStatement)
    val body: MidBody = <MidBody sourceFunction=owner locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 />
    val frozen = c.mid.store(body: body)
    val ownershipStates = analyzeCanonicalMidOwnership(arena: c.mid, canonical: frozen)
    val ownership: MidOwnership = ownershipStates[3U64][0U64]
    val elaborated = elaborateCanonicalMidDrops(arena: inout c.mid, canonical: c.mid.store(body: body))
    mut val dropped: Bool = false
    val node = c.mid.bodies[elaborated.body - 1U64]
    val join = c.mid.blocks[node.blocks.start + 3U64]
    if c.mid.statements[join.statements.start].tag == 4U64 { dropped = true }
    mut val valid: Bool = false
    match verifyCanonicalMidBody(c: inout c, canonical: elaborated).error { MidVerifyError.None => { valid = true } _ => {} }
    mut val built: Bool = false
    match result { MidBuildError.None => { built = true } _ => {} }
    match ownership {
        MidOwnership.MaybeOwned => {
            if file == 0U64 && built && dropped && valid {
                write(s: "conditional-move-call\n")
            } else {
                write(s: "wrong-conditional-move-call\n")
            }
        }
        _ => { write(s: "wrong-ownership\n") }
    }
}
