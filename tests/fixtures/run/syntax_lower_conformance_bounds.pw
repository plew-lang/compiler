import /Frontend with { Comp }
import @Plew/Syntax as Syntax
import @Std/Core with { assert }
import @Std/Io with { print }
fn check(compiler: inout Comp) {
    assert(compiler.decls.conformCount() == 1U64)
    val conformance = compiler.decls.conformAt(index: 0U64)
    assert(conformance.witnessFuncIds.len == 0U64)
    assert(conformance.bounds.len == 1U64)
    val bound = compiler.conformBoundAt(bounds: conformance.bounds, index: 0U64)
    val parameter = compiler.conformBindAt(binds: conformance.typeParams, index: 0U64)
    assert(parameter.paramId != 0U64)
    assert(compiler.arena.typeTerms[bound.subject].paramId == parameter.paramId)
    assert(bound.constraint.key.owner == compiler.decls.traitAt(index: 0U64).nameStart)
    assert(bound.constraint.key.positionalArgs.count() == 1U64)
    assert(!bound.constraint.positionalArgsOpen)
    assert(compiler.arena.typeAt(index: bound.constraint.key.positionalArgs[0U64]).nameId == compiler.internBytes(s: "String").nameId)
    assert(bound.offset != 0U64)
    assert(compiler.monoWork.bodyCount() == 0U64)
}
fn main() {
    val source = "trait Marker[Input] {}\ntrait Container { type Element }\nstruct Box[T] { val value: T }\nimpl[T] Box[T] as Container where T: Marker[String] { type Element = T }\n"
    mut val lexer = <Syntax.Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    Syntax.lex(lx: inout lexer)
    mut val parser = <Syntax.P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = Syntax.parseProgramSyntaxFile(p: inout parser)
    mut val compiler = <Comp />
    compiler.appendSrc(from: source.bytes())
    compiler.syntax = file
    mut val index = 0U64
    while index < 2U64 { compiler.predeclareSyntaxTraitItem(item: Syntax.syntaxFileTopLevel(file: file, index: index)) index += 1U64 }
    index = 0U64
    while index < 2U64 {
        val item = Syntax.syntaxFileTopLevel(file: file, index: index)
        compiler.lowerSyntaxTrait(t: Syntax.syntaxTrait(file: file, id: <Syntax.TraitId raw=Syntax.syntaxTopItemPayload(file: file, item: item) />)).unwrap()
        index += 1U64
    }
    compiler.lowerSyntaxStructDecl(d: Syntax.syntaxDecl(file: file, id: <Syntax.DeclId raw=Syntax.syntaxTopItemPayload(file: file, item: Syntax.syntaxFileTopLevel(file: file, index: 2U64)) />)).unwrap()
    compiler.lowerSyntaxImpl(im: Syntax.syntaxImpl(file: file, id: <Syntax.ImplId raw=Syntax.syntaxTopItemPayload(file: file, item: Syntax.syntaxFileTopLevel(file: file, index: 3U64)) />)).unwrap()
    check(compiler: inout compiler)
    mut val valueParser = <Syntax.P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val values = Syntax.parseProgramAst(p: inout valueParser)
    mut val legacy = <Comp />
    legacy.appendSrc(from: source.bytes())
    for val item in values { legacy.predeclareTraitItem(item: item) }
    for val item in values { legacy.lowerTopItem(item: item).unwrap() }
    check(compiler: inout legacy)
    print("ok")
}
