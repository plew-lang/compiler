// Internal contract test: default evaluation identity, idempotent recording,
// and preservation of previously resolved argument provenance. Public usage
// is covered by default_eval_order.pw and default_eval_order_generic_method.pw.
use @Std/Io only { write }
use /Frontend only { Comp }
use /Ir only { Bind, CallArgumentSource, CallTemplateArgument, CallTemplateKind, ProtocolSelection, CallTemplateReceiver, Expr, Func, Param, CallTemplate, CallSiteKey, SemanticClosure }

fn main() {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val unitTerm: U64 = 0U64
    val integer = c.internBytes(s: "I64")
    val term = c.simpleTypeRef(nameStart: integer.nameStart, nameLen: integer.nameLen)
    val name = c.internTmpName(prefix: "item", n: 0U64)
    val expression = c.pushExpr(e: <Expr.Int value=7U64 offset=0U64 isBool=false tyStart=integer.nameStart tyLen=integer.nameLen isNeg=false />)
    val parameters = c.pushFuncParams(params: [<Param nameStart=name.nameStart nameLen=name.nameLen nameId=name.nameId
        tyStart=integer.nameStart tyLen=integer.nameLen tyIsArray=false ty=term
        isInout=false isMove=false isBorrow=false noLabel=false hasDefault=true defaultExpr=expression />])
    val binder = c.internTmpName(prefix: "T", n: 0U64)
    val typeParameters = c.pushFuncBinds(binds: [<Bind nameStart=binder.nameStart nameLen=binder.nameLen paramId=71U64 fieldStart=0U64 fieldLen=0U64 />])
    c.arena.registerFunction(<Func nameStart=name.nameStart nameLen=name.nameLen typeParams=typeParameters params=parameters
        hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=unitTerm body=0U64
        hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false
        isAssoc=false isAsync=false isExtern=false />)
    c.prepareDefaultArgumentGenerators().unwrap()
    c.cur.checkFn = 0U64
    c.cur.recordCallTemplates = true
    val generator = c.defaultArgumentGenerator(ownerFnIdx: 0U64, parameterIndex: 0U64)
    val first = c.recordDefaultArgumentCall(generator: generator, receiver: <CallTemplateReceiver.Term term=term />,
        calleeTypeArgs: [term], resultTerm: term, existingExpr: c.arena.exprs.count()).unwrap()
    val firstKey = c.templateCallSiteKey(fnIdx: 0U64, exprId: first).unwrap()
    val template = c.callTemplateForSourceBody(fnIdx: 0U64, exprId: first).unwrap()
    match template.kind {
        CallTemplateKind.Direct(callee: val callee, receiver: val receiver, args: val argumentRange, calleeTypeArgs: val typeRange, proofId: _) => {
            val args = c.callTemplateArguments(range: argumentRange)
            val typeArgs = c.callTemplateTypeArgs(range: typeRange)
            if callee == generator && args.count() == 0U64 && typeArgs.count() == 1U64 && typeArgs[0U64] == term { write(s: "ordinary-selected-call\n") }
            match receiver {
                CallTemplateReceiver.Term(term: val receiverTerm) => {
                    if receiverTerm == term { write(s: "receiver-environment\n") }
                }
                _ => {}
            }
        }
        _ => {}
    }
    if c.semanticExprTerm(exprId: first) == term { write(s: "caller-result-term\n") }
    match c.callArgumentSource(exprId: first).unwrap() {
        CallArgumentSource.PriorCallResult(exprId: val exprId, siteKey: val siteKey) => {
            if exprId == first && c.sameCallSiteKey(a: firstKey, b: siteKey) { write(s: "ordinary-result-dependency\n") }
        }
        _ => {}
    }
    val repeated = c.recordDefaultArgumentCall(generator: generator, receiver: <CallTemplateReceiver.Term term=term />,
        calleeTypeArgs: [term], resultTerm: term, existingExpr: first).unwrap()
    if repeated == first && c.decls.callTemplates.count() == 1U64 { write(s: "record-idempotent\n") }
    val second = c.recordDefaultArgumentCall(generator: generator, receiver: <CallTemplateReceiver.Term term=term />,
        calleeTypeArgs: [term], resultTerm: term, existingExpr: c.arena.exprs.count()).unwrap()
    if first != second && !c.sameCallSiteKey(a: firstKey, b: c.templateCallSiteKey(fnIdx: 0U64, exprId: second).unwrap()) { write(s: "distinct-evaluations\n") }
    if c.decls.callableCount() == 0U64 { write(s: "no-source-lookup\n") }
    val empty: Array[CallTemplateArgument] = []
    match c.recordBoundCallArguments(callee: 0U64, args: empty, receiver: <CallTemplateReceiver.None />,
        calleeTypeArgs: [term], parameterTerms: [term]).unwrap() {
        Optional.Some(v: val completed) => {
            if completed.count() == 1U64 && completed[0U64].hasLabel && completed[0U64].labelStart == name.nameStart {
                val defaultExpr = c.callArgumentExprId(source: completed[0U64].source)
                if defaultExpr != expression && c.semanticExprTerm(exprId: defaultExpr) == term { write(s: "bound-default-result\n") }
                val expressionCount = c.arena.exprs.count()
                match c.recordBoundCallArguments(callee: 0U64, args: empty, receiver: <CallTemplateReceiver.None />,
                    calleeTypeArgs: [term], parameterTerms: [term], previous: completed).unwrap() {
                    Optional.Some(v: val repeatedArguments) => {
                        if c.callArgumentExprId(source: repeatedArguments[0U64].source) == defaultExpr && c.arena.exprs.count() == expressionCount { write(s: "completed-record-idempotent\n") }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    // Completion runs after the lexical cursor has gone away. It must retain
    // the recorded local identity, even when source recovery would disagree.
    val explicitArgs: Array[CallTemplateArgument] = [<CallTemplateArgument
        source=<CallArgumentSource.Local exprId=expression declarationTarget=17U64 term=term />
        isInout=true labelStart=name.nameStart labelLen=name.nameLen hasLabel=true />]
    c.cur.locals = []
    val expressionCount = c.arena.exprs.count()
    match c.recordBoundCallArguments(callee: 0U64, args: explicitArgs, receiver: <CallTemplateReceiver.None />,
        calleeTypeArgs: [term], parameterTerms: [term]).unwrap() {
        Optional.Some(v: val completed) => {
            if completed.count() == 1U64 && c.callArgumentExprId(source: completed[0U64].source) == expression && c.arena.exprs.count() == expressionCount { write(s: "bound-explicit-preserved\n") }
            match completed[0U64].source {
                CallArgumentSource.Local(exprId: val exprId, declarationTarget: val declarationTarget, term: val savedTerm) => {
                    if exprId == expression && declarationTarget == 17U64 && savedTerm == term && completed[0U64].isInout { write(s: "frozen-local-preserved\n") }
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Request-local completion includes closure sites and excludes unrelated
    // owners, even when the rows interleave and completion appends new calls.
    val closureKey = c.closureBodyKey(closureId: expression)
    c.putSemanticClosure(closure: <SemanticClosure ownerFnIdx=0U64 exprId=expression bodyKey=closureKey />).unwrap()
    val emptyArguments = c.publishCallTemplateArguments(args: [])
    val selectedTypes = c.publishCallTemplateTypeArgs(args: [term])
    val missingIndex = c.decls.callTemplates.count()
    c.appendCallTemplate(template: <CallTemplate siteKey=<CallSiteKey ownerFnIdx=0U64 originKind=2U64 originSerial=900U64 />
        kind=<CallTemplateKind.Direct callee=0U64 receiver=<CallTemplateReceiver.None /> args=emptyArguments calleeTypeArgs=selectedTypes proofId=0U64 /> />)
    // Two explicit arguments cannot complete a one-parameter call. These
    // deliberately incomplete internal rows do not claim source acceptance.
    val excess = c.publishCallTemplateArguments(args: [explicitArgs[0U64], explicitArgs[0U64]])
    val unrelatedIndex = c.decls.callTemplates.count()
    c.appendCallTemplate(template: <CallTemplate siteKey=<CallSiteKey ownerFnIdx=generator originKind=2U64 originSerial=901U64 />
        kind=<CallTemplateKind.Direct callee=0U64 receiver=<CallTemplateReceiver.None /> args=excess calleeTypeArgs=selectedTypes proofId=0U64 /> />)
    val closureIndex = c.decls.callTemplates.count()
    c.appendCallTemplate(template: <CallTemplate siteKey=<CallSiteKey ownerFnIdx=closureKey originKind=2U64 originSerial=902U64 />
        kind=<CallTemplateKind.Direct callee=0U64 receiver=<CallTemplateReceiver.None /> args=excess calleeTypeArgs=selectedTypes proofId=0U64 /> />)
    if c.completeRecordedBodyDefaultCalls(owner: 0U64).unwrap() != 1U64 { panic("lexical completion lost closure or included another owner") }
    match c.decls.callTemplates[missingIndex].kind {
        CallTemplateKind.Direct(callee: _, receiver: _, args: val arguments, calleeTypeArgs: _, proofId: _) => {
            if arguments.len != 1U64 { panic("requested default was not completed") }
        }
        _ => { panic("requested direct call changed kind") }
    }
    val completedCount = c.decls.callTemplates.count()
    if c.completeRecordedBodyDefaultCalls(owner: 0U64).unwrap() != 1U64 || c.decls.callTemplates.count() != completedCount { panic("lexical completion is not idempotent") }
    if c.completeRecordedDefaultCalls().unwrap() != 2U64 { panic("batch completion lost unrelated failure") }
    c.rebuildCallTemplateIndex(capacity: 128U64)
    if c.completeRecordedBodyDefaultCalls(owner: 0U64).unwrap() != 1U64 { panic("rebuilt request index changed membership") }

    // Incomplete rows are rejected, not silently ignored by bounds checks.
    match c.checkRecordedBodyCallConstraints(owner: 0U64) {
        Result.Ok(value: _) => { panic("incomplete closure call was accepted") }
        Result.Err(error: _) => {}
    }
    // Restore complete selections before independently probing iteration
    // membership. A preceding malformed call must not mask that diagnostic.
    val completeKind = c.decls.callTemplates[missingIndex].kind
    val unrelatedSite = c.decls.callTemplates[unrelatedIndex].siteKey
    val closureSite = c.decls.callTemplates[closureIndex].siteKey
    c.decls.callTemplates.set(i: unrelatedIndex, value: <CallTemplate siteKey=unrelatedSite kind=completeKind />)
    c.decls.callTemplates.set(i: closureIndex, value: <CallTemplate siteKey=closureSite kind=completeKind />)
    c.checkRecordedBodyCallConstraints(owner: 0U64).unwrap()
    c.appendCallTemplate(template: <CallTemplate siteKey=<CallSiteKey ownerFnIdx=generator originKind=3U64 originSerial=1U64 slot=1U64 />
        kind=<CallTemplateKind.Protocol receiver=<CallTemplateReceiver.Term term=term /> selection=<ProtocolSelection.Pending /> resultTerm=0U64 /> />)
    c.checkRecordedBodyCallConstraints(owner: 0U64).unwrap()
    match c.checkRecordedBodyCallConstraints(owner: generator) {
        Result.Ok(value: _) => { panic("requested invalid iteration was not checked") }
        Result.Err(error: _) => {}
    }
    c.appendCallTemplate(template: <CallTemplate siteKey=<CallSiteKey ownerFnIdx=closureKey originKind=3U64 originSerial=1U64 slot=1U64 />
        kind=<CallTemplateKind.Protocol receiver=<CallTemplateReceiver.Term term=term /> selection=<ProtocolSelection.Pending /> resultTerm=0U64 /> />)
    match c.checkRecordedBodyCallConstraints(owner: 0U64) {
        Result.Ok(value: _) => { panic("closure iteration was not checked") }
        Result.Err(error: _) => {}
    }

}
