import @Std/Io with { print }
struct Counter { pub mut val value: I64 }
pub impl Counter { factory }
extension Writable {
    pub impl Counter { inout fn increment() { self.value += 1I64 } }
}
fn main() {
    mut val counter = <Counter value=10I64 />
    counter#Writable.increment()
    print(counter.value)
}
