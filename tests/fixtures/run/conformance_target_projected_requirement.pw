use @Std/Io only { print }
trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
trait Marker[Kind] { fn get() -> Kind }
struct Other {}
impl Other as Marker[Number#Source.Item] { fn get() -> I64 { return 42I64 } }
fn read[T](value: T) -> I64 where T: Marker[I64] { return value.get() }
fn main() { print(read(value: <Other />)) }
