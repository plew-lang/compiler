use @Std/Io only { print }

// Implicit Unit is an ordinary source value even when its ABI has no payload.
// Preserve the result through declarations, blocks, generics and dynamic calls.
fn emit(value: I64) { print(value) }
trait Emit { fn emit() }
struct Message {}
pub impl Message { factory }
pub impl Message as Emit { fn emit() { print(2I64) } }
fn emitGeneric[T](value: T) -> () where T: Emit { return value.emit() }
fn emitErased(value: any Emit) -> () { return value.emit() }
fn identity[T](value: T) -> T { return value }
fn take(value: ()) {}
fn main() {
    val first: () = { give emit(value: 1I64) }
    take(value: first)
    val second = identity(value: emitGeneric(value: <Message />))
    take(value: second)
    val callback: fn() = fn() { print(3I64) }
    val third: () = callback()
    take(value: third)
    val fourth: () = emitErased(value: <Message />)
    take(value: fourth)
}
