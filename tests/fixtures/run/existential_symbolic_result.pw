use /Diag only { FailureDomain }
use /Ir only { ConformanceProofDemand, StaticMemberResolution, StaticConformanceProof, DeclarationBoundRef, CallTemplate, CallTemplateKind, CallTemplateReceiver, CallSiteKey, ConformBound, FuncBound }
use @Std/Io only { print }
use @Std/Process only { argCount, argAt }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /SourceTypeUses only { SourceTypeUses }
use /Ir only { TypeRef }
fn checkRetainedWhereClause() {
    mut val compiler = <Comp />
    val source = "trait Marker {{}} trait Service {{ fn read[T](value: T) where T: Marker }} fn probe[T,U,V](receiver: T, value: U, foreign: V) where T: Service, U: Marker {{}}"
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text=source path="clause-reader.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val declaration = compiler.arena.functionAt(index: owner)
    val receiver = compiler.funcParamAt(params: declaration.params, index: 0U64).ty
    val value = compiler.funcParamAt(params: declaration.params, index: 1U64).ty
    val foreign = compiler.funcParamAt(params: declaration.params, index: 2U64).ty
    val sourceBound = compiler.decls.funcBounds.at(index: 0U64)
    val traitIndex = compiler.decls.traitIndexByOffset(offset: sourceBound.constraint.key.owner)
    val trait = compiler.decls.traitAt(index: traitIndex)
    val resolution = <StaticMemberResolution.Requirement proof=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=0U64 /> /> traitIdx=traitIndex reqIdx=0U64 />
    val arguments = compiler.publishCallTemplateTypeArgs(args: [value])
    val kind = <CallTemplateKind.StaticMethod receiver=<CallTemplateReceiver.Term term=receiver /> args=compiler.publishCallTemplateArguments(args: []) resolution=resolution methodTypeArgs=arguments resultTerm=0U64 />
    val template = <CallTemplate siteKey=<CallSiteKey ownerFnIdx=owner originKind=2U64 originSerial=900U64 /> receiverTypeTerm=receiver kind=kind />
    val bounds = compiler.sourceSelectedCallBounds(template: template).unwrap()
    if bounds.count() != 1U64 || !compiler.typeRefEq(a: bounds[0U64].subject, b: value) { panic("requirement clause setup failed") }
    val index = compiler.traitReqAt(reqs: trait.reqs, index: 0U64).signatureBounds.start
    val original = compiler.decls.conformBoundPool[index]
    compiler.decls.conformBoundPool[index] = <ConformBound subject=foreign constraint=original.constraint offset=original.offset />
    match compiler.sourceSelectedCallBounds(template: template) {
        Result.Ok(value: val after) => {
            if after.count() != 1U64 || !compiler.typeRefEq(a: after[0U64].subject, b: value) { panic("raw where row replaced the retained requirement clause") }
        }
        Result.Err(error: _) => { panic("raw where row replaced the retained requirement clause") }
    }
}

fn checkProvidedWhereClause() {
    mut val compiler = <Comp />
    val source = "trait Marker {{}} trait Provider {{}} pub impl Provider {{ fn supply[T](value: T) where T: Marker {{}} }} fn probe[T,U,V](receiver: T, value: U, foreign: V) where T: Provider, U: Marker {{}}"
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text=source path="provided-clause.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val callee = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "supply").nameId)
    val caller = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val callerParams = compiler.arena.functionAt(index: caller).params
    val value = compiler.funcParamAt(params: callerParams, index: 1U64).ty
    val foreign = compiler.funcParamAt(params: callerParams, index: 2U64).ty
    val callerClause = compiler.decls.funcBounds.indices(owner: caller)[0U64]
    val receiverBound = compiler.decls.funcBounds.at(index: callerClause)
    val traitIndex = compiler.decls.traitIndexByOffset(offset: receiverBound.constraint.key.owner)
    val resolution = <StaticMemberResolution.Provided proof=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=callerClause /> /> traitIdx=traitIndex callee=callee />
    val arguments = compiler.publishCallTemplateTypeArgs(args: [value])
    val kind = <CallTemplateKind.StaticMethod receiver=<CallTemplateReceiver.Term term=receiverBound.paramTy /> args=compiler.publishCallTemplateArguments(args: []) resolution=resolution methodTypeArgs=arguments resultTerm=0U64 />
    val template = <CallTemplate siteKey=<CallSiteKey ownerFnIdx=caller originKind=2U64 originSerial=901U64 /> receiverTypeTerm=receiverBound.paramTy kind=kind />
    val bounds = compiler.sourceSelectedCallBounds(template: template).unwrap()
    if bounds.count() != 1U64 || !compiler.typeRefEq(a: bounds[0U64].subject, b: value) { panic "provided clause setup failed" }
    val index = compiler.decls.funcBounds.indices(owner: callee)[0U64]
    val original = compiler.decls.funcBounds.at(index: index)
    compiler.decls.funcBounds.set(index: index, value: <FuncBound fnIdx=callee sourceClause=original.sourceClause paramStart=original.paramStart paramLen=original.paramLen paramTy=foreign paramNameId=original.paramNameId constraint=original.constraint />)
    val retained = compiler.sourceSelectedCallBounds(template: template).unwrap()
    if retained.count() != 1U64 || !compiler.typeRefEq(a: retained[0U64].subject, b: value) { panic "raw where row replaced the retained provided clause" }
    compiler.decls.funcBounds.set(index: index, value: <FuncBound fnIdx=callee sourceClause=0U64 paramStart=original.paramStart paramLen=original.paramLen paramTy=foreign paramNameId=original.paramNameId constraint=original.constraint />)
    match compiler.sourceSelectedCallBounds(template: template) {
        Result.Ok(value: val after) => {
            if after.count() != 1U64 || !compiler.typeRefEq(a: after[0U64].subject, b: value) { panic "raw clause identity replaced the retained provided clause" }
        }
        Result.Err(error: _) => { panic "raw clause identity replaced the retained provided clause" }
    }
}

fn checkProvidedSignature() {
    mut val compiler = <Comp />
    val source = "trait Provider {{ type Item }} pub impl Provider {{ fn supply(value: Item) -> Item {{ return value }} fn marker() -> Bool {{ return true }} }} fn probe[T](receiver: T) where T: Provider[Item=Bool] {{}}"
    match analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text=source path="provided-reader.pw" />, sources: <SourceAccess stdRoot=[] />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
    val bound = compiler.decls.funcBounds.at(index: 0U64)
    val receiver = bound.paramTy
    val traitIndex = compiler.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
    val callee = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "supply").nameId)
    val resolution = <StaticMemberResolution.Provided proof=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=0U64 /> /> traitIdx=traitIndex callee=callee />
    val args = compiler.pushArgs(args: [])
    val result = match compiler.staticMemberCallResultType(resolution: resolution, receiverTerm: receiver, args: args) {
        Result.Ok(value: val term) => term,
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
    assert(compiler.typeRefEq(a: result, b: bound.constraint.assocPredicates[0U64].value))
    val marker = compiler.internBytes(s: "marker")
    val rank = compiler.staticMemberResolution(fnIdx: bound.fnIdx, receiverRef: receiver, nameStart: marker.nameStart, nameLen: marker.nameLen, args: args).unwrap()
    match rank {
        StaticMemberResolution.Provided(proof: _, traitIdx: _, callee: _) => {}
        _ => { panic "provided candidate setup did not select its method" }
    }
    compiler.sourceTypeUses = <SourceTypeUses />
    if compiler.staticMemberResolution(fnIdx: bound.fnIdx, receiverRef: receiver, nameStart: marker.nameStart, nameLen: marker.nameLen, args: args).isOk() {
        panic "ranked a provided candidate without its source signature"
    }
    match compiler.staticMemberCallResultType(resolution: resolution, receiverTerm: receiver, args: args) {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain {
                FailureDomain.Internal => {}
                _ => { panic "missing provided signature was not an internal error" }
            }
        }
        Result.Ok(value: _) => { panic "read a provided result without its source signature" }
    }
}

fn main() {
    checkProvidedWhereClause()
    checkProvidedSignature()
    checkRetainedWhereClause()
    mut val c = <Comp />
    val source = "struct Value {{}}\ntrait Cursor {{ type Item fn read(value: Item) -> Item fn alternate(value: Bool) -> Bool }}\ntrait Source {{ type Iter fn iterator() -> Self#Source.Iter fn other() -> Bool fn hidden(other: Self) -> Bool }}\nfn test[T](values: any Source[Iter=T]) where T: Cursor[Item=Value] {{}}\n"
    analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text text=source path="cursor.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val bound = c.decls.funcBounds.at(index: 0U64)
    val function = c.arena.functionAt(index: bound.fnIdx)
    val receiver = c.funcParamAt(params: function.params, index: 0U64).ty
    val traitIndex = c.recordAnyTraitIndex(anyRef: receiver)
    // The reader owns an explicit requirement environment. An unrelated
    // ambient substitution must neither change its result nor be overwritten.
    val parameter = c.funcBindAt(binds: function.typeParams, index: 0U64)
    val savedParameters = c.cur.typeParams
    val savedArguments = c.cur.typeArgs
    val savedReceiver = c.cur.selfRef
    c.cur.typeParams = [parameter]
    c.cur.typeArgs = [receiver]
    c.cur.selfRef = receiver
    val cursor = c.anyMemberRetInfo(anyRef: receiver, traitIndex: traitIndex, slot: 0U64).unwrap().ref
    val signature = c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64).unwrap()
    assert(c.typeRefEq(a: cursor, b: signature.resultType))
    assert(c.cur.typeParams.count() == 1U64)
    assert(c.cur.typeParams[0U64].paramId == parameter.paramId)
    assert(c.cur.typeArgs[0U64] == receiver)
    assert(c.cur.selfRef == receiver)
    val original = c.arena.typeAt(index: receiver)
    val incomplete = c.pushType(t: <TypeRef nameStart=original.nameStart nameLen=original.nameLen nameId=original.nameId args=[] isAny=true hasDecl=original.hasDecl declOffset=original.declOffset />)
    match c.anyMemberRetInfo(anyRef: incomplete, traitIndex: traitIndex, slot: 0U64) {
        Result.Err(error: _) => {}
        Result.Ok(value: _) => { panic "accepted incomplete existential result bindings" }
    }
    assert(c.cur.typeParams[0U64].paramId == parameter.paramId)
    assert(c.cur.typeArgs[0U64] == receiver)
    assert(c.cur.selfRef == receiver)
    c.cur.typeParams = savedParameters
    c.cur.typeArgs = savedArguments
    c.cur.selfRef = savedReceiver
    assert(cursor != 0U64)
    assert(c.arena.typeAt(index: cursor).paramId == c.arena.typeAt(index: bound.paramTy).paramId)
    assert(c.typeRefEq(a: cursor, b: bound.paramTy))
    assert(c.viewedTypeConformsTraitConstraint(demand: <ConformanceProofDemand.Existence />, ref: cursor, constraint: bound.constraint, assumptions: c.functionBoundAssumptions(fnIdx: bound.fnIdx)).unwrap())
    assert(c.monoWork.bodyCount() == 0U64)
    val requirements = c.decls.traitAt(index: traitIndex).reqs
    val originalRequirement = c.traitReqAt(reqs: requirements, index: 0U64)
    c.decls.traitReqPool[requirements.start] = c.traitReqAt(reqs: requirements, index: 1U64)
    val retained = c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64).unwrap()
    if !c.typeRefEq(a: retained.resultType, b: cursor) { panic "raw trait row replaced the retained existential signature" }
    c.decls.traitReqPool[requirements.start] = originalRequirement
    val name = c.internBytes(s: "iterator")
    val args = c.pushArgs(args: [])
    assert(c.recordAnyRequirementSlot(anyRef: receiver, nameStart: name.nameStart, nameLen: name.nameLen, args: args).unwrap() == 1U64)
    if argCount() < 2I64 || argAt(1I64) == "hidden" {
        val hidden = c.traitReqAt(reqs: requirements, index: 2U64)
        c.decls.traitReqPool[requirements.start + 2U64] = c.traitReqAt(reqs: requirements, index: 1U64)
        match c.checkExistentialRequirementCall(target: receiver, traitIndex: traitIndex, requirement: 2U64, offset: hidden.nameStart) {
            Result.Err(error: val diagnostic) => {
                assert(diagnostic.message == "this member is not callable through `any P`: `Self` appears in a non-receiver input — two `any P` values need not share a concrete type (spec/08)")
            }
            Result.Ok(value: _) => { panic "raw trait row made the hidden Self input dispatchable" }
        }
        c.decls.traitReqPool[requirements.start + 2U64] = hidden
    }
    val cursorTrait = c.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
    val cursorRequirements = c.decls.traitAt(index: cursorTrait).reqs
    val staticCall = <StaticMemberResolution.Requirement proof=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=0U64 /> /> traitIdx=cursorTrait reqIdx=0U64 />
    val staticResult = c.staticRequirementResultType(resolution: staticCall).unwrap()
    assert(c.typeRefEq(a: staticResult, b: bound.constraint.assocPredicates[0U64].value))
    val staticParameter = c.staticRequirementParamTypeAt(resolution: staticCall, paramIdx: 0U64).unwrap()
    assert(c.typeRefEq(a: staticParameter, b: staticResult))
    val staticDeclaration = c.traitReqAt(reqs: cursorRequirements, index: 0U64)
    c.decls.traitReqPool[cursorRequirements.start] = c.traitReqAt(reqs: cursorRequirements, index: 1U64)
    val staticRetained = c.staticRequirementResultType(resolution: staticCall).unwrap()
    if !c.typeRefEq(a: staticRetained, b: staticResult) { panic "raw trait row replaced the retained static signature" }
    val retainedParameter = c.staticRequirementParamTypeAt(resolution: staticCall, paramIdx: 0U64).unwrap()
    if !c.typeRefEq(a: retainedParameter, b: staticParameter) { panic "raw trait row replaced the retained static parameter" }
    c.decls.traitReqPool[cursorRequirements.start] = staticDeclaration
    c.sourceTypeUses = <SourceTypeUses />
    if argCount() < 2I64 || argAt(1I64) == "rank" {
        if c.recordAnyRequirementSlot(anyRef: receiver, nameStart: name.nameStart, nameLen: name.nameLen, args: args).isOk() {
            panic "ranked a requirement without its source signature"
        }
    }
    match c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64) {
        Result.Err(error: val diagnostic) => {
            assert(diagnostic.message == "selected requirement has no authored signature")
            match diagnostic.failureDomain {
                FailureDomain.Internal => {}
                _ => { panic "missing source requirement was not an internal error" }
            }
        }
        Result.Ok(value: _) => { panic "read an existential signature without its source requirement" }
    }
    print("ok")
}
