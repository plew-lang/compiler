use /Diag only { FailureDomain }
use /Ir only { ConformanceProofDemand }
use @Std/Io only { print }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /SourceTypeUses only { SourceTypeUses }
use /Ir only { TypeRef }
fn main() {
    mut val c = <Comp />
    val source = "struct Value {{}}\ntrait Cursor {{ type Item }}\ntrait Source {{ type Iter fn iterator() -> Iter }}\nfn test[T](values: any Source[Iter=T]) where T: Cursor[Item=Value] {{}}\n"
    analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text text=source path="cursor.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val bound = c.decls.funcBounds.at(index: 0U64)
    val function = c.arena.functionAt(index: bound.fnIdx)
    val receiver = c.funcParamAt(params: function.params, index: 0U64).ty
    val traitIndex = c.recordAnyTraitIndex(anyRef: receiver)
    // The reader owns an explicit requirement environment. An unrelated
    // ambient substitution must neither change its result nor be overwritten.
    val parameter = c.funcBindAt(binds: function.typeParams, index: 0U64)
    val savedParameters = c.cur.typeParams
    val savedArguments = c.cur.typeArgs
    val savedReceiver = c.cur.selfRef
    c.cur.typeParams = [parameter]
    c.cur.typeArgs = [receiver]
    c.cur.selfRef = receiver
    val cursor = c.anyMemberRetInfo(anyRef: receiver, traitIndex: traitIndex, slot: 0U64).unwrap().ref
    val signature = c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64).unwrap()
    assert(c.typeRefEq(a: cursor, b: signature.resultType))
    assert(c.cur.typeParams.count() == 1U64)
    assert(c.cur.typeParams[0U64].paramId == parameter.paramId)
    assert(c.cur.typeArgs[0U64] == receiver)
    assert(c.cur.selfRef == receiver)
    val original = c.arena.typeAt(index: receiver)
    val incomplete = c.pushType(t: <TypeRef nameStart=original.nameStart nameLen=original.nameLen nameId=original.nameId args=[] isAny=true hasDecl=original.hasDecl declOffset=original.declOffset />)
    match c.anyMemberRetInfo(anyRef: incomplete, traitIndex: traitIndex, slot: 0U64) {
        Result.Err(error: _) => {}
        Result.Ok(value: _) => { panic "accepted incomplete existential result bindings" }
    }
    assert(c.cur.typeParams[0U64].paramId == parameter.paramId)
    assert(c.cur.typeArgs[0U64] == receiver)
    assert(c.cur.selfRef == receiver)
    c.cur.typeParams = savedParameters
    c.cur.typeArgs = savedArguments
    c.cur.selfRef = savedReceiver
    assert(cursor != 0U64)
    assert(c.arena.typeAt(index: cursor).paramId == c.arena.typeAt(index: bound.paramTy).paramId)
    assert(c.typeRefEq(a: cursor, b: bound.paramTy))
    assert(c.viewedTypeConformsTraitConstraint(demand: <ConformanceProofDemand.Existence />, ref: cursor, constraint: bound.constraint, assumptions: c.functionBoundAssumptions(fnIdx: bound.fnIdx)).unwrap())
    assert(c.monoWork.bodyCount() == 0U64)
    c.sourceTypeUses = <SourceTypeUses />
    match c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64) {
        Result.Err(error: val diagnostic) => {
            assert(diagnostic.message == "selected requirement has no authored signature")
            match diagnostic.failureDomain {
                FailureDomain.Internal => {}
                _ => { panic "missing source requirement was not an internal error" }
            }
        }
        Result.Ok(value: _) => { panic "read an existential signature without its source requirement" }
    }
    print("ok")
}
