use /Diag only { FailureDomain }
use /Ir only { ConformanceProofDemand, StaticMemberResolution, StaticConformanceProof, DeclarationBoundRef }
use @Std/Io only { print }
use @Std/Process only { argCount, argAt }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /SourceTypeUses only { SourceTypeUses }
use /Ir only { TypeRef }
fn main() {
    mut val c = <Comp />
    val source = "struct Value {{}}\ntrait Cursor {{ type Item fn read(value: Item) -> Item fn alternate(value: Bool) -> Bool }}\ntrait Source {{ type Iter fn iterator() -> Self#Source.Iter fn other() -> Bool fn hidden(other: Self) -> Bool }}\nfn test[T](values: any Source[Iter=T]) where T: Cursor[Item=Value] {{}}\n"
    analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text text=source path="cursor.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val bound = c.decls.funcBounds.at(index: 0U64)
    val function = c.arena.functionAt(index: bound.fnIdx)
    val receiver = c.funcParamAt(params: function.params, index: 0U64).ty
    val traitIndex = c.recordAnyTraitIndex(anyRef: receiver)
    // The reader owns an explicit requirement environment. An unrelated
    // ambient substitution must neither change its result nor be overwritten.
    val parameter = c.funcBindAt(binds: function.typeParams, index: 0U64)
    val savedParameters = c.cur.typeParams
    val savedArguments = c.cur.typeArgs
    val savedReceiver = c.cur.selfRef
    c.cur.typeParams = [parameter]
    c.cur.typeArgs = [receiver]
    c.cur.selfRef = receiver
    val cursor = c.anyMemberRetInfo(anyRef: receiver, traitIndex: traitIndex, slot: 0U64).unwrap().ref
    val signature = c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64).unwrap()
    assert(c.typeRefEq(a: cursor, b: signature.resultType))
    assert(c.cur.typeParams.count() == 1U64)
    assert(c.cur.typeParams[0U64].paramId == parameter.paramId)
    assert(c.cur.typeArgs[0U64] == receiver)
    assert(c.cur.selfRef == receiver)
    val original = c.arena.typeAt(index: receiver)
    val incomplete = c.pushType(t: <TypeRef nameStart=original.nameStart nameLen=original.nameLen nameId=original.nameId args=[] isAny=true hasDecl=original.hasDecl declOffset=original.declOffset />)
    match c.anyMemberRetInfo(anyRef: incomplete, traitIndex: traitIndex, slot: 0U64) {
        Result.Err(error: _) => {}
        Result.Ok(value: _) => { panic "accepted incomplete existential result bindings" }
    }
    assert(c.cur.typeParams[0U64].paramId == parameter.paramId)
    assert(c.cur.typeArgs[0U64] == receiver)
    assert(c.cur.selfRef == receiver)
    c.cur.typeParams = savedParameters
    c.cur.typeArgs = savedArguments
    c.cur.selfRef = savedReceiver
    assert(cursor != 0U64)
    assert(c.arena.typeAt(index: cursor).paramId == c.arena.typeAt(index: bound.paramTy).paramId)
    assert(c.typeRefEq(a: cursor, b: bound.paramTy))
    assert(c.viewedTypeConformsTraitConstraint(demand: <ConformanceProofDemand.Existence />, ref: cursor, constraint: bound.constraint, assumptions: c.functionBoundAssumptions(fnIdx: bound.fnIdx)).unwrap())
    assert(c.monoWork.bodyCount() == 0U64)
    val requirements = c.decls.traitAt(index: traitIndex).reqs
    val originalRequirement = c.traitReqAt(reqs: requirements, index: 0U64)
    c.decls.traitReqPool[requirements.start] = c.traitReqAt(reqs: requirements, index: 1U64)
    val retained = c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64).unwrap()
    if !c.typeRefEq(a: retained.resultType, b: cursor) { panic "raw trait row replaced the retained existential signature" }
    c.decls.traitReqPool[requirements.start] = originalRequirement
    val name = c.internBytes(s: "iterator")
    val args = c.pushArgs(args: [])
    assert(c.recordAnyRequirementSlot(anyRef: receiver, nameStart: name.nameStart, nameLen: name.nameLen, args: args).unwrap() == 1U64)
    if argCount() < 2I64 || argAt(1I64) == "hidden" {
        val hidden = c.traitReqAt(reqs: requirements, index: 2U64)
        c.decls.traitReqPool[requirements.start + 2U64] = c.traitReqAt(reqs: requirements, index: 1U64)
        match c.checkExistentialRequirementCall(target: receiver, traitIndex: traitIndex, requirement: 2U64, offset: hidden.nameStart) {
            Result.Err(error: val diagnostic) => {
                assert(diagnostic.message == "this member is not callable through `any P`: `Self` appears in a non-receiver input — two `any P` values need not share a concrete type (spec/08)")
            }
            Result.Ok(value: _) => { panic "raw trait row made the hidden Self input dispatchable" }
        }
        c.decls.traitReqPool[requirements.start + 2U64] = hidden
    }
    val cursorTrait = c.decls.traitIndexByOffset(offset: bound.constraint.key.owner)
    val cursorRequirements = c.decls.traitAt(index: cursorTrait).reqs
    val staticCall = <StaticMemberResolution.Requirement proof=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=0U64 /> /> traitIdx=cursorTrait reqIdx=0U64 />
    val staticResult = c.staticRequirementResultType(resolution: staticCall).unwrap()
    assert(c.typeRefEq(a: staticResult, b: bound.constraint.assocPredicates[0U64].value))
    val staticParameter = c.staticRequirementParamTypeAt(resolution: staticCall, paramIdx: 0U64).unwrap()
    assert(c.typeRefEq(a: staticParameter, b: staticResult))
    val staticDeclaration = c.traitReqAt(reqs: cursorRequirements, index: 0U64)
    c.decls.traitReqPool[cursorRequirements.start] = c.traitReqAt(reqs: cursorRequirements, index: 1U64)
    val staticRetained = c.staticRequirementResultType(resolution: staticCall).unwrap()
    if !c.typeRefEq(a: staticRetained, b: staticResult) { panic "raw trait row replaced the retained static signature" }
    val retainedParameter = c.staticRequirementParamTypeAt(resolution: staticCall, paramIdx: 0U64).unwrap()
    if !c.typeRefEq(a: retainedParameter, b: staticParameter) { panic "raw trait row replaced the retained static parameter" }
    c.decls.traitReqPool[cursorRequirements.start] = staticDeclaration
    c.sourceTypeUses = <SourceTypeUses />
    if argCount() < 2I64 || argAt(1I64) == "rank" {
        if c.recordAnyRequirementSlot(anyRef: receiver, nameStart: name.nameStart, nameLen: name.nameLen, args: args).isOk() {
            panic "ranked a requirement without its source signature"
        }
    }
    match c.existentialRequirementSignature(target: receiver, traitIndex: traitIndex, slot: 0U64) {
        Result.Err(error: val diagnostic) => {
            assert(diagnostic.message == "selected requirement has no authored signature")
            match diagnostic.failureDomain {
                FailureDomain.Internal => {}
                _ => { panic "missing source requirement was not an internal error" }
            }
        }
        Result.Ok(value: _) => { panic "read an existential signature without its source requirement" }
    }
    print("ok")
}
