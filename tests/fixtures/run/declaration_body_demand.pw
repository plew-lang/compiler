use /Diag only { FailureDomain }
use /Mid/Ir only { MidOperandNode, MidCallReceiverNode }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, spansEqual }
use /SourceAccess only { SourceAccess }
use /DeclarationProgram only { DeclarationBodyRequests, CheckedDeclarationBody }
use /Mid/Build only { MidFunctionTemplates, MidBuildError }
use /Mid/DeclarationAccess only { DeclarationAccessError }
use /Mid/Verify only { MidVerifyError }
use @Std/Io only { print }

fn owner(c: inout Comp, name: String) -> U64 {
    val span = c.internBytes(s: name)
    mut val index = 0U64
    while index < c.arena.functionCount() {
        val function = c.arena.functionAt(index: index)
        if spansEqual(c: inout c, aStart: function.nameStart, aLen: function.nameLen, bStart: span.nameStart, bLen: span.nameLen) { return index }
        index += 1U64
    }
    panic "missing source declaration"
}

fn main() {
    mut val c = <Comp />
    val source = "struct Counter {{ mut val value: I64 }} impl Counter {{ fn read[T](other: inout Counter, token: T) -> I64 {{ other.value = 2I64 return self.value }} }} fn good[T](value: T) -> T {{ return value }} fn closure() -> I64 {{ val get = fn() -> I64 {{ return 1I64 }} return get() }} fn conflict() {{ mut val counter = <Counter value=1I64 /> counter.read(other: inout counter, token: 0I64) }} fn valid() {{ mut val first = <Counter value=1I64 /> mut val second = <Counter value=2I64 /> first.read(other: inout second, token: 0I64) }} fn stillConflict() {{ mut val first = <Counter value=1I64 /> mut val spare = <Counter value=2I64 /> mut val third = <Counter value=3I64 /> first.read(other: inout first, token: 0I64) spare.read(other: inout third, token: 0I64) }} fn broken() {{ missing() }} fn main() {{}}"
    analyzeFrontendForRequests(c: inout c, input: <FrontendInput.Text path="body-demand.pw" text=source />, sources: <SourceAccess stdRoot=[] />).unwrap()
    mut val templates = <MidFunctionTemplates />
    mut val requests = <DeclarationBodyRequests />
    val good = owner(c: inout c, name: "good")
    val conflict = owner(c: inout c, name: "conflict")
    val closure = owner(c: inout c, name: "closure")
    val checked = requests.function(c: inout c, templates: inout templates, function: good).unwrap()
    if c.lexicalBodyPreparationCount() != 1U64 || checked.canonical.body == 0U64 { panic "unrelated body requested" }
    val bodies = c.mid.bodies.count()
    val repeated = requests.function(c: inout c, templates: inout templates, function: good).unwrap()
    if repeated.canonical.body != checked.canonical.body || c.mid.bodies.count() != bodies { panic "request rebuilt its body" }
    requests.function(c: inout c, templates: inout templates, function: closure).unwrap()
    if c.semanticClosureCount() != 1U64 { panic "closure metadata missing" }
    requests.closure(c: inout c, closure: c.semanticClosureAt(index: 0U64)).unwrap()
    mut val iteration = 0U64
    while iteration < 2U64 {
        match requests.function(c: inout c, templates: inout templates, function: conflict) {
            Result.Ok(value: _) => { panic "local access conflict accepted" }
            Result.Err(error: val error) => {
                match error {
                    DeclarationAccessError.LocalAccess(body: _, error: val error, domain: val domain) => {
                        match domain { FailureDomain.Source => {} _ => { panic "expected source access conflict" } }
                        match error { MidVerifyError.ConflictingReceiverAccess => {} _ => { panic "wrong local access diagnostic" } }
                    }
                    _ => { panic "wrong request diagnostic" }
                }
            }
        }
        iteration += 1U64
    }
    // A new request sees the same published template, without a fresh build.
    mut val cached = <DeclarationBodyRequests />
    match cached.function(c: inout c, templates: inout templates, function: conflict) {
        Result.Ok(value: _) => { panic "cached source conflict accepted" }
        Result.Err(error: val error) => {
            match error {
                DeclarationAccessError.LocalAccess(body: _, error: val conflictError, domain: val domain) => {
                    match conflictError { MidVerifyError.ConflictingReceiverAccess => {} _ => { panic "wrong cached conflict" } }
                    match domain { FailureDomain.Source => {} _ => { panic "missing cached source attribution" } }
                }
                _ => { panic "wrong cached failure" }
            }
        }
    }
    if c.lexicalBodyPreparationCount() != 3U64 { panic "request inspected unused callee or broken body" }
    if c.monoWork.bodyCount() != 0U64 || c.arena.finalDestructions.count() != 0U64 { panic "declaration request discovered executable code" }
    mut val foreign = <Comp />
    analyzeFrontendForRequests(c: inout foreign, input: <FrontendInput.Text path="body-demand.pw" text=source />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val foreignConflict = owner(c: inout foreign, name: "conflict")
    expectWrongSession(result: requests.function(c: inout foreign, templates: inout templates, function: foreignConflict))
    mut val foreignTemplates = <MidFunctionTemplates />
    expectWrongSession(result: requests.function(c: inout foreign, templates: inout foreignTemplates, function: foreignConflict))
    mut val foreignRequests = <DeclarationBodyRequests />
    expectWrongSession(result: foreignRequests.function(c: inout foreign, templates: inout templates, function: foreignConflict))
    foreignRequests.function(c: inout c, templates: inout templates, function: good).unwrap()
    checkCachedCallMutation(c: inout c, templates: inout templates, functionName: "valid", keepConflict: false)
    checkCachedCallMutation(c: inout c, templates: inout templates, functionName: "stillConflict", keepConflict: true)
    print("ok")
}

fn checkCachedCallMutation(c: inout Comp, templates: inout MidFunctionTemplates, functionName: String, keepConflict: Bool) {
    val function = owner(c: inout c, name: functionName)
    c.prepareLexicalBody(fnIdx: function).unwrap()
    val built = templates.body(c: inout c, function: function)
    val body = c.mid.bodies[built.canonical.body - 1U64]
    mut val calls: Array[U64] = []
    mut val block = 0U64
    while block < body.blocks.len {
        val row = c.mid.blocks[body.blocks.start + block]
        val term = c.mid.terminators[row.terminator - 1U64]
        if term.tag == 4U64 && term.callReceiver != 0U64 && term.args.len == 2U64 { calls.append(row.terminator) }
        block += 1U64
    }
    val expected = if keepConflict { give 2U64 } else { give 1U64 }
    if calls.count() != expected { panic "missed calls for access mutation" }
    val term = c.mid.terminators[calls[0U64] - 1U64]
    if keepConflict {
        // Move the already-conflicting call to a different live storage root.
        // Its source key and receiver-conflict variant remain unchanged.
        val second = c.mid.terminators[calls[1U64] - 1U64]
        val replacement = c.mid.callReceivers[second.callReceiver - 1U64]
        c.mid.callReceivers[term.callReceiver - 1U64] = <MidCallReceiverNode tag=replacement.tag operand=replacement.operand />
    }
    val receiver = c.mid.callReceivers[term.callReceiver - 1U64]
    val read = c.mid.operands[receiver.operand - 1U64]
    val index = term.args.start
    val write = c.mid.operands[c.mid.callArguments[index] - 1U64]
    if receiver.tag != 2U64 || read.place == 0U64 || write.tag != 4U64 || write.accessPlace != 0U64 { panic "unexpected operand setup" }
    c.mid.operands.append(<MidOperandNode tag=write.tag capability=write.capability place=read.place />)
    c.mid.callArguments[index] = c.mid.operands.count()
    mut val replay = <DeclarationBodyRequests />
    match replay.function(c: inout c, templates: inout templates, function: function) {
        Result.Ok(value: _) => { panic "mutated call was accepted" }
        Result.Err(error: val error) => {
            match error {
                DeclarationAccessError.LocalAccess(body: _, error: val conflict, domain: val domain) => {
                    match conflict { MidVerifyError.ConflictingReceiverAccess => {} _ => { panic "wrong conflict" } }
                    match domain {
                        FailureDomain.Unclassified => {}
                        _ => { panic "unexpected domain" }
                    }
                }
                _ => { panic "wrong failure" }
            }
        }
    }
}

fn expectWrongSession(result: Result[CheckedDeclarationBody, DeclarationAccessError]) {
    match result {
        Result.Ok(value: _) => { panic "wrong-session request succeeded" }
        Result.Err(error: val error) => {
            match error {
                DeclarationAccessError.Build(body: _, error: val failure) => {
                    match failure { MidBuildError.InvalidBlock => {} _ => { panic "wrong session failure" } }
                }
                _ => { panic "wrong-session request returned a different failure" }
            }
        }
    }
}
