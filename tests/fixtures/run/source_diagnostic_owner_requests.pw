// A unary mismatch has no conversion row: diagnostic continuation must retain
// its failure independently, without blocking an unrelated source owner.
use /Frontend only { Comp, FrontendInput, FrontendOptions, analyzeFrontendForRequests, spansEqual }
use /SourceAccess only { SourceAccess }
use /Diag only { CompileDiagnostic }
use @Std/Io only { print }

fn owner(compiler: inout Comp, name: String) -> U64 {
    val span = compiler.internBytes(s: name)
    mut val index = 0U64
    while index < compiler.arena.functionCount() {
        val function = compiler.arena.functionAt(index: index)
        if spansEqual(c: inout compiler, aStart: function.nameStart, aLen: function.nameLen, bStart: span.nameStart, bLen: span.nameLen) { return index }
        index += 1U64
    }
    panic("missing owner")
}
fn expectFailure(result: Result[(), CompileDiagnostic]) {
    match result {
        Result.Err(error: val diagnostic) => {
            if diagnostic.message != "unary `-` (Neg) is for signed integers / floats only (spec/12)" { panic(diagnostic.message) }
        }
        Result.Ok(value: _) => { panic("diagnostic continuation published owner success") }
    }
}
fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="diagnostic-owner.pw" text="fn broken(value: U64) -> U64 {{ return -value }} fn good() -> I64 {{ return 1I64 }} fn main() {{}}" />,
        sources: <SourceAccess stdRoot=[] />, options: <FrontendOptions tcLog=true />).unwrap()
    val broken = owner(compiler: inout compiler, name: "broken")
    val good = owner(compiler: inout compiler, name: "good")
    compiler.cur.checkFn = 70001U64
    compiler.cur.bodyId = 70002U64
    expectFailure(result: compiler.prepareLexicalBody(fnIdx: broken))
    if compiler.decls.declarationConversions.count() != 0U64 { panic("unary failure must not depend on a conversion") }
    compiler.tcLog = false
    expectFailure(result: compiler.prepareLexicalBody(fnIdx: broken))
    if compiler.cur.checkFn != 70001U64 || compiler.cur.bodyId != 70002U64 { panic("diagnostic continuation leaked cursor") }
    compiler.prepareLexicalBody(fnIdx: good).unwrap()
    expectFailure(result: compiler.checkDiagnosticContinuationFailures())
    mut val globals = <Comp />
    analyzeFrontendForRequests(c: inout globals,
        input: <FrontendInput.Text path="global-diagnostic-owner.pw" text="fn value() -> U64 {{ return 1U64 }} val broken: U64 = -value() val good: U64 = 1U64 fn main() {{}}" />,
        sources: <SourceAccess stdRoot=[] />, options: <FrontendOptions tcLog=true />).unwrap()
    val badTarget = globals.arena.globals[0U64].nameStart
    val goodTarget = globals.arena.globals[1U64].nameStart
    expectFailure(result: globals.prepareGlobalInitializer(target: badTarget))
    expectFailure(result: globals.prepareGlobalInitializer(target: badTarget))
    if globals.globalInitializerPrepared(target: badTarget) { panic("failed diagnostic published global readiness") }
    globals.prepareGlobalInitializer(target: goodTarget).unwrap()
    if !globals.globalInitializerPrepared(target: goodTarget) { panic("diagnostic continuation blocked another global owner") }
    expectFailure(result: globals.checkDiagnosticContinuationFailures())
    print("source-diagnostics")
}
