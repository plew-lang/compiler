import @Std/Io with { write }
import @Std/Core with { Buffer, MutableRef, bufferAppend, bufferTruncate }

unique struct Cell {
    pub val id: I64
    deinit { write(s: self.id.format(format: "") + "\n") }
}
pub impl Cell { factory }

// Shrinking releases only the suffix. The following oversized truncate is a
// no-op, so the surviving first element remains owned by Buffer until exit.
val midBufferTruncateArcAnchor: I64 = 0I64

fn shrinkThenKeep(buffer: inout Buffer[MutableRef[Cell]]) {
    bufferTruncate(buffer: inout buffer, count: 1U64)
    bufferTruncate(buffer: inout buffer, count: 9U64)
}

fn main() {
    mut val buffer: Buffer[MutableRef[Cell]] = Buffer.new()
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=1I64 /> />)
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=2I64 /> />)
    bufferAppend(buffer: inout buffer, value: <MutableRef[Cell] value=<Cell id=3I64 /> />)
    shrinkThenKeep(buffer: inout buffer)
    write(s: "after\n")
}
