use @Std/Io only { print }
use @Std/Core only { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Holder {
    pub val r: MutableRef[Cell]
}
pub impl Holder { factory }

pub impl Holder {
    factory
}

fn makeHolder() -> Holder {
    val h: Holder = <Holder r=<MutableRef value=<Cell v=21I32 /> /> />
    return h
}

fn main() {
    val h: Holder = makeHolder()
    print("bound")
}
