use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { TraitConstraint, TraitInstanceKey, ConformanceProofDemand }
use @Std/Core only { assert }
use @Std/Io only { print }
fn main() {
    mut val compiler = <Comp />
    val source = "trait Root {{}} trait Via {{}} trait Base {{ fn base() -> I64 }} trait Target {{ fn shared() -> I64 }} struct S {{}} impl S as Root {{}} impl Root as Via {{}} impl Root as Base {{ fn base() -> I64 {{ return 1I64 }} }} impl Via as Base {{ fn base() -> I64 {{ return 2I64 }} }} impl Base as Target {{ fn shared() -> I64 {{ return 9I64 }} }} fn context(value: S#Via, ambiguous: S#Root) {{}}"
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text path="root-placement.pw" text=source />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val context = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "context").nameId)
    compiler.cur.checkFn = context
    val parameters = compiler.arena.functionAt(index: context).params
    val receiver = compiler.funcParamAt(params: parameters, index: 0U64).ty
    val ambiguous = compiler.funcParamAt(params: parameters, index: 1U64).ty
    val target = compiler.decls.traitAt(index: 3U64)
    val constraint = <TraitConstraint key=<TraitInstanceKey owner=target.nameStart positionalArgs=[] /> assocPredicates=[] />
    val proof = compiler.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: receiver, constraint: constraint).unwrap()
    assert(!compiler.proofIsMissing(proof: proof))
    // Both owners occur in the same selected proof. Mere owner membership
    // cannot distinguish the two concrete copies of the Target witness.
    assert(compiler.proofWitnessForTrait(proof: proof, traitIdx: 0U64).conformIdx != 0U64)
    assert(compiler.proofWitnessForTrait(proof: proof, traitIdx: 1U64).conformIdx != 0U64)
    val selected = compiler.proofConcreteWitness(proof: proof, receiverRef: receiver, traitIdx: 3U64, reqIdx: 0U64).unwrap()
    assert(selected < compiler.arena.functionCount())
    val function = compiler.arena.functionAt(index: selected)
    assert(function.srcTraitOwner == compiler.decls.traitAt(index: 1U64).nameStart)
    assert(function.sourceRootConformIdx != 0U64)
    val birth = compiler.decls.conformAt(index: function.sourceRootConformIdx - 1U64)
    assert(birth.subjectTraitOwner == function.srcTraitOwner && birth.traitStart == compiler.decls.traitAt(index: 2U64).nameStart)
    val declaration = function.sourceWitnessFuncId - 1U64
    assert(compiler.providedCopyForDeclaration(declaration: declaration, receiverRef: receiver, proof: proof, traitIdx: 3U64, offset: 0U64).unwrap() == selected)
    assert(compiler.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: ambiguous, constraint: constraint).isErr())
    // Exact duplicate placement must still fail; normalization must not hide it.
    compiler.arena.registerFunction(function, registerSurface: false)
    assert(compiler.proofConcreteWitness(proof: proof, receiverRef: receiver, traitIdx: 3U64, reqIdx: 0U64).isErr())
    assert(compiler.providedCopyForDeclaration(declaration: declaration, receiverRef: receiver, proof: proof, traitIdx: 3U64, offset: 0U64).isErr())
    print("root-placement-identity")
}
