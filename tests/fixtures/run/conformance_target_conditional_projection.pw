use @Std/Io only { print }
trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
trait Marker[Kind] {}
struct Box[T] {}
impl[T] Box[T] as Marker[T#Source.Item] where T: Source {}
fn useMarker[T](value: T) -> I64 where T: Marker[I64] { return 42I64 }
fn main() { print(useMarker(value: <Box[Number] />)) }
