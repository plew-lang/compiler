use @Std/Io only { print }
trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }
trait Mark {}
impl Number as Mark {}
impl[T, U] Box[T, T#Source.Item] where T: Source, U: Mark { fn code(aux: U) -> T#Source.Item { return self.item } }
fn main() { print(<Box[Number, I64] item=42I64 />.code(aux: <Number />)) }
