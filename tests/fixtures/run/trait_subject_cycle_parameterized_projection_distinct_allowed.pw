use @Std/Io only { print }

trait Projection[Kind] { type Item }
struct Key {}
impl Key as Projection[I64] { type Item = I64 }
impl Key as Projection[String] { type Item = String }
impl Key as Projection[Bool] { type Item = Bool }
trait A[Item] {}
trait B[Item] {}

impl A[Key#Projection[I64].Item] as B[Key#Projection[String].Item] {}
impl B[Key#Projection[Bool].Item] as A[Key#Projection[Bool].Item] {}

fn main() { print(1I64) }
