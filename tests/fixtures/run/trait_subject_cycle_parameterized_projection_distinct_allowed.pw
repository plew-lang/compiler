import @Std/Io with { print }

// Projection trait arguments are part of the type term.  The two B terms here
// are distinct, so these edges do not form a trait-instance cycle.
trait Projection[Kind] { type Item }
trait A[Item] {}
trait B[Item] {}

impl[T] A[T#Projection[I64].Item] as B[T#Projection[String].Item] {}
impl[T] B[T#Projection[Bool].Item] as A[T#Projection[Bool].Item] {}

fn main() {
    print(1I64)
}
