trait Seed { type Output }
trait Source[Kind] { type Item }

struct Key {}
impl Key as Seed { type Output = I64 }

struct Box {}
impl Box as Source[I64] { type Item = Bool }

pub impl Source[Key#Seed.Output] {
    fn retain(value: Item) -> Item { return value }
}

fn types(box: Box, kind: I64, expected: Bool) {}
fn main() {}
