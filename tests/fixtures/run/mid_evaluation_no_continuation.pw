use @Std/Io only { print }

fn conjunction(flag: Bool) -> Bool { return flag && { return true } }
fn disjunction(flag: Bool) -> Bool { return flag || { return false } }
fn identity(value: I64) -> I64 { return value }
fn argumentExit() -> I64 { return identity(value: { return 3I64 }) }
fn aggregateExit() -> I64 {
    val values: Array[I64] = [1I64, { return 4I64 }]
    return 0I64
}
fn change(value: inout I64) { value = 9I64 }
fn inoutIndexExit() -> I64 {
    mut val values = [1I64]
    change(value: inout values[{ return 5I64 }])
    return 0I64
}
fn assignmentIndexExit() -> I64 {
    mut val values = [1I64]
    values[{ return 6I64 }] = 9I64
    return 0I64
}
fn main() {
    print(conjunction(flag: false))
    print(conjunction(flag: true))
    print(disjunction(flag: false))
    print(disjunction(flag: true))
    print(argumentExit())
    print(aggregateExit())
    print(inoutIndexExit())
    print(assignmentIndexExit())
}
