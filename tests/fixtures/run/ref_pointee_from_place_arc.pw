import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Holder {
    pub val r: MutableRef[Cell]
}
pub impl Holder { factory }

pub impl Holder {
    factory
}

fn pointeeFromPlace() {
    val h: Holder = <Holder r=<MutableRef value=<Cell v=31I32 /> /> />
    val shared: MutableRef[Holder] = <MutableRef value=h />
    print("made")
}

fn main() {
    pointeeFromPlace()
    print("done")
}
