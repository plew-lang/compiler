use @Std/Io only { print }
trait Source[T] { type Item }
struct Number {}
impl Number as Source[I64] { type Item = I64 }
trait Parent { type Output fn get() -> Output }
trait Child: Parent[Output=Number#Source[I64].Item] {}
struct Receiver {}
impl Receiver as Parent { type Output=I64 fn get() -> I64 { return 42I64 } }
impl Receiver as Child {}
fn read[T](value: T) -> I64 where T: Child { return value.get() }
fn main() { print(read(value: <Receiver />)) }
