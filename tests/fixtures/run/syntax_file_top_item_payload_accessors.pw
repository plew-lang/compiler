import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxImpl, syntaxExtern, syntaxDirective, syntaxStmt, DeclId, ImplId, ExternId, DirectiveId, StmtId, SyntaxStmtKind }
import @Std/Io with { print }

fn main() {
    val source = "struct First {}\nimpl First {}\nextern(plewIntrinsic) { fn raw() }\n@[Eq]\nval answer = 42U64\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val impl = syntaxImpl(file: file, id: <ImplId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 1U64)) />)
    val ext = syntaxExtern(file: file, id: <ExternId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 2U64)) />)
    val directive = syntaxDirective(file: file, id: <DirectiveId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 3U64)) />)
    val global = syntaxStmt(file: file, id: <StmtId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 4U64)) />)
    print(decl.fields.count)
    print(impl.members.count)
    if ext.abiOk { print(1U64) } else { print(0U64) }
    print(directive.reqs.count)
    match global.kind {
        SyntaxStmtKind.Let => { print(1U64) }
        _ => { print(0U64) }
    }
}
