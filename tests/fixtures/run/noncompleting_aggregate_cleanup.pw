use @Std/Io only { print }
use @Std/Core only { Ref }
unique struct Resource {
    val id: I64
    deinit { print(self.id) }
}
fn record() -> I64 {
    val value = (first: <Ref[Resource] value=<Resource id=1I64 /> />, last: { return 7I64 })
    return 99I64
}
fn array() -> I64 {
    val value = [<Ref[Resource] value=<Resource id=2I64 /> />, { return 8I64 }]
    return 99I64
}
fn iterate() -> I64 {
    mut val count = 0I64
    while count < 2I64 {
        count += 1I64
        for val item in [<Ref[Resource] value=<Resource id=count + 2I64 /> />, { continue }] {
            print(99I64)
        }
        print(99I64)
    }
    return count
}
fn main() {
    print(record())
    print(array())
    print(iterate())
}
