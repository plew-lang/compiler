import /Frontend with { Comp, FrontendInput, FinalizationPublication, analyzeFrontendDeclarations, spansEqual }
import /SourceAccess with { SourceAccess }
import @Std/Io with { print }

fn owner(c: inout Comp, name: String) -> U64 {
    val span = c.internBytes(s: name)
    mut val index = 0U64
    while index < c.arena.functionCount() {
        val function = c.arena.functionAt(index: index)
        if spansEqual(c: inout c, aStart: function.nameStart, aLen: function.nameLen, bStart: span.nameStart, bLen: span.nameLen) { return index }
        index += 1U64
    }
    panic "missing declaration"
}

fn main() {
    mut val c = <Comp />
    val source = "trait Index[K] { type Output fn index(key: K) -> Output } trait IndexSet[K] { type Value inout fn indexSet(key: K, value~: Value) } struct Shelf { mut val value: I64 } impl Shelf as Index[U64] { type Output = I64 fn index(key: U64) -> I64 { return self.value } } impl Shelf as IndexSet[U64] { type Value = I64 inout fn indexSet(key: U64, value~: I64) { self.value = value } } fn take(target: inout I64) { target = 2I64 } fn first() { mut val shelf = <Shelf value=1I64 /> take(target: inout shelf[0U64]) } fn second() { mut val shelf = <Shelf value=3I64 /> take(target: inout shelf[0U64]) } unique struct Resource {} impl Resource { deinit {} } fn main() {}"
    analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text path="publication.pw" text=source />, sources: <SourceAccess />).unwrap()
    c.inCollection = true
    c.initializeFinalCallables().unwrap()
    mut val publication = <FinalizationPublication />
    val first = c.enqueueFinalBody(fnIdx: owner(c: inout c, name: "first"), args: [], recvInstRef: 0U64).unwrap()
    c.scanFinalBodyInstance(bodyId: first).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    val accesses = c.arena.semanticAccesses.count()
    val inputs = c.arena.semanticAccessInputs.count()
    if accesses == 0U64 || inputs == 0U64 { panic "no writeback provenance published" }
    val original = c.arena.semanticAccesses[0U64]
    val calls = c.finalCalleeCount()
    val second = c.enqueueFinalBody(fnIdx: owner(c: inout c, name: "second"), args: [], recvInstRef: 0U64).unwrap()
    c.scanFinalBodyInstance(bodyId: second).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    if c.arena.semanticAccesses.count() != accesses * 2U64 || c.arena.semanticAccessInputs.count() != inputs * 2U64 { panic "publication rebuilt or lost earlier access rows" }
    val preserved = c.arena.semanticAccesses[0U64]
    if preserved.bodyId != first || preserved.readResolution != original.readResolution || preserved.writeResolution != original.writeResolution || preserved.parentResolution != original.parentResolution || preserved.baseInput != original.baseInput || preserved.keyInput != original.keyInput || preserved.accessInput != original.accessInput { panic "published identity changed" }
    if c.arena.semanticAccesses[accesses].bodyId != second || c.arena.semanticAccesses[accesses].parentResolution < calls { panic "new access points at old body" }
    val total = c.finalCalleeCount()
    c.publishFinalCallables(state: inout publication).unwrap()
    if c.finalCalleeCount() != total || c.arena.semanticAccesses.count() != accesses * 2U64 || c.arena.semanticAccessInputs.count() != inputs * 2U64 { panic "empty publication changed tables" }

    // A malformed destructor ABI must not be published, even when ready.
    // The same publisher keeps that diagnostic and does not repeat partial work.
    mut val structure = 0U64
    while structure < c.arena.structCount() {
        val declaration = c.arena.structAt(index: structure)
        if declaration.isUnique {
            val term = c.simpleTypeRef(nameStart: declaration.nameStart, nameLen: declaration.nameLen)
            c.enqueueFinalDestruction(typeRef: term).unwrap()
            val contract = c.arena.finalDestructions[c.finalDestructionIndex(typeRef: term) - 1U64]
            c.arena.setBodySignature(bodyId: contract.deinitCall.bodyId, parameters: [], passings: [], result: term)
            break
        }
        structure += 1U64
    }
    if structure == c.arena.structCount() { panic "missing destructor fixture" }
    mut val message = ""
    mut val repeat = 0U64
    while repeat < 2U64 {
        match c.publishFinalCallables(state: inout publication) {
            Result.Ok(value: _) => { panic "invalid destructor published" }
            Result.Err(error: val diagnostic) => {
                if repeat == 0U64 { message = diagnostic.message }
                else if diagnostic.message != message { panic "publication diagnostic changed" }
            }
        }
        if c.arena.semanticAccesses.count() != accesses * 2U64 { panic "failed publication duplicated rows" }
        repeat += 1U64
    }
    print("ok")
}
