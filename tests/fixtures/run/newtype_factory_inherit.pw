// A `newtype` inherits the underlying struct's factories (spec/10: "newtype は元の型の
// factory も継承"), with `Self` substituted to the newtype. Covered: the default
// memberwise factory (`<Brand code=… />`), a named factory (`<Brand.gray level=… />`),
// and a named FALLIBLE factory returning `Result[Self, E]` (→ Result[Brand, E]). All
// construct directly (no explicit `as`); the result is a Brand.
import @Std/Io with { print }

struct Rgb { pub val code: I32  pub val alpha: I32 }
pub impl Rgb { factory }
pub impl Rgb {
    factory
    factory gray(level: I32) { return <Rgb code=level alpha=255I32 /> }
    result[I32] factory checked(code: I32) {
        if code < 0I32 { return <Result.Err error=1I32 /> }
        return <Result.Ok value=<Rgb code=code alpha=255I32 /> />
    }
}

newtype Brand = Rgb

fn main() {
    // default (memberwise) factory.
    val b: Brand = <Brand code=255 alpha=128 />
    print(b.code)             // 255
    print(b.alpha)            // 128
    // named factory (Self -> Brand).
    val g: Brand = <Brand.gray level=64 />
    print(g.code)             // 64
    // named fallible factory: Result[Self, I32] -> Result[Brand, I32].
    val r: Result[Brand, I32] = <Brand.checked code=50 />
    match r {
        Result.Ok(value: val v) => { print(v.code) }    // 50
        Result.Err(error: val e) => { print(e) }
    }
    // the unwrap re-tag recovers the underlying struct.
    val raw: Rgb = b as Rgb
    print(raw.code)           // 255
}
