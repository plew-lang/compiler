import @Std/Io with { write }

// Keep main on the legacy path: each helper's Mid coverage is independently
// observable, while the program output asserts the language-level short
// circuit contract.
val midShortCircuitAnchor: I64 = 0I64

fn rhs() -> Bool {
    write(s: "rhs\n")
    return true
}

fn andFalse() -> Bool {
    return false && rhs()
}

fn andTrue() -> Bool {
    return true && rhs()
}

fn orTrue() -> Bool {
    return true || rhs()
}

fn orFalse() -> Bool {
    return false || rhs()
}

fn andLoop(limit: U64) -> U64 {
    mut val index: U64 = 0U64
    while index < limit && index < 3U64 { index += 1U64 }
    return index
}

fn orLoop(limit: U64) -> U64 {
    mut val index: U64 = 0U64
    while index < limit || index < 3U64 { index += 1U64 }
    return index
}

fn identity(flag: Bool) -> Bool { return flag }
fn argumentAndFalse() -> Bool { return identity(flag: false && rhs()) }
fn argumentOrTrue() -> Bool { return identity(flag: true || rhs()) }
fn negatedOrTrue() -> Bool { return !(true || rhs()) }
fn negatedAndTrue() -> Bool { return !(true && rhs()) }
fn nestedArgument() -> Bool { return identity(flag: (false && rhs()) || (true && rhs())) }

fn main() {
    if !andFalse() { write(s: "and-false\n") }
    if andTrue() { write(s: "and-true\n") }
    if orTrue() { write(s: "or-true\n") }
    if orFalse() { write(s: "or-false\n") }
    if andLoop(limit: 2U64) == 2U64 { write(s: "and-loop\n") }
    if orLoop(limit: 2U64) == 3U64 { write(s: "or-loop\n") }
    if !argumentAndFalse() { write(s: "argument-and\n") }
    if argumentOrTrue() { write(s: "argument-or\n") }
    if !negatedOrTrue() { write(s: "negated-or\n") }
    if !negatedAndTrue() { write(s: "negated-and\n") }
    if nestedArgument() { write(s: "nested-argument\n") }
}
