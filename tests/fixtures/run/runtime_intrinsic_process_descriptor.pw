// Process operations are a closed runtime ABI descriptor, not a backend lookup
// by the source spelling `argCount`.
import @Std/Io with { write }
import /Ir with { RuntimeIntrinsic, ProcessIntrinsic, CallTarget }

fn main() {
    val target: CallTarget = <CallTarget.RuntimeIntrinsic intrinsic=<RuntimeIntrinsic.Process intrinsic=<ProcessIntrinsic.ArgCount /> /> />
    match target {
        CallTarget.RuntimeIntrinsic(intrinsic: val intrinsic) => {
            match intrinsic {
                RuntimeIntrinsic.Process(intrinsic: val process) => {
                    match process {
                        ProcessIntrinsic.ArgCount => { write(s: "arg-count\n") }
                        _ => { write(s: "wrong\n") }
                    }
                }
                _ => { write(s: "wrong\n") }
            }
        }
        _ => { write(s: "wrong\n") }
    }
}
