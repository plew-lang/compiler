use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations, finalizeFrontendExecutables }
use /SourceAccess only { SourceAccess }
use /Ir only { CallTarget }
use /Mid/Program only { MidExecutableRequests }
use /Mid/Build only { MidFunctionTemplates }
use /Mid/AmbientEffects only { MidAmbientEffects }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text path="snapshot.pw" text="fn main() { helper() } fn helper() {}" />, sources: <SourceAccess />).unwrap()
    finalizeFrontendExecutables(c: inout compiler).unwrap()
    mut val templates = <MidFunctionTemplates />
    mut val requests = <MidExecutableRequests />
    val main = compiler.monoWork.bodyAt(index: 0U64)
    requests.request(c: inout compiler, templates: inout templates, bodyId: main).unwrap()
    val before = compiler.mid.bodies.count()
    val snapshot = requests.snapshot().unwrap()
    val effects = MidAmbientEffects.prepare(c: inout compiler, program: snapshot, ambientBodies: []).unwrap()
    if compiler.mid.bodies.count() != before { panic "effect snapshot prepared missing body" }
    mut val tested = false
    for term in compiler.mid.terminators {
        if term.tag == 4U64 {
            val target = compiler.arena.finalCallees[compiler.mid.callTargets[term.callTarget - 1U64].resolution]
            match target.target {
                CallTarget.Direct => {
                    if target.calleeBodyId != 0U64 {
                        match snapshot.body(bodyId: target.calleeBodyId) {
                            Optional.Some(v: _) => { panic "snapshot contains unrequested callee" }
                            Optional.None => {}
                        }
                        if !effects.callMayAccess(c: compiler, term: term) { panic "unrequested callee considered pure" }
                        // The later body occupies a slot used by a destruction
                        // node in the old snapshot. Its false bit is not purity.
                        mut val older = <MidAmbientEffects bodyCount=target.calleeBodyId - 1U64 />
                        mut val current = <MidAmbientEffects bodyCount=target.calleeBodyId />
                        mut val index = 0U64
                        while index <= target.calleeBodyId {
                            older.affected.append(false)
                            current.affected.append(false)
                            index += 1U64
                        }
                        if !older.callMayAccess(c: compiler, term: term) { panic "later body read destruction effect" }
                        if current.callMayAccess(c: compiler, term: term) { panic "known pure boundary body became unknown" }
                        current.mark(node: target.calleeBodyId)
                        if !current.callMayAccess(c: compiler, term: term) { panic "known effect lost" }
                        tested = true
                    }
                }
                _ => {}
            }
        }
    }
    if !tested { panic "missing direct call" }
    print("ok")
}
