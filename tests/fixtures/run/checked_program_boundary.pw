import /CheckedProgram with { CheckedProgram, ProgramCheckResult, ExecutableCompilationResult, prepareCheckedProgram }
import /Frontend with { FrontendInput, FrontendOptions }
import /SourceAccess with { SourceAccess }
import @Std/Io with { print }

fn checked(source: String) -> ProgramCheckResult {
    return CheckedProgram.check(input: <FrontendInput.Text text=source path="check.pw" />,
        sources: <SourceAccess stdRoot=[] />)
}

fn main() {
    match checked(source: "fn main() {}") {
        ProgramCheckResult.Failure(diagnostic: val diagnostic) => { panic diagnostic.message }
        ProgramCheckResult.Success(program: val program) => {
            match prepareCheckedProgram(checked: move program) {
                ExecutableCompilationResult.Failure(diagnostic: val diagnostic) => { panic diagnostic.message }
                ExecutableCompilationResult.Success(compilation: val compilation) => {
                    if compilation.compiler.monoWork.bodyCount() == 0U64 { panic "no executable prepared" }
                }
            }
        }
    }
    match checked(source: "fn unused[T](value: T) -> I64 { return value } fn main() {}") {
        ProgramCheckResult.Success(program: val program) => { panic "invalid declaration published" }
        ProgramCheckResult.Failure(diagnostic: _) => {}
    }
    match checked(source: "mut val value = 1I64 fn update(target: inout I64) { target = value } fn unused() { update(target: inout value) } fn main() {}") {
        ProgramCheckResult.Success(program: val program) => { panic "invalid access published" }
        ProgramCheckResult.Failure(diagnostic: val diagnostic) => {
            if diagnostic.message != "borrowed global storage overlaps an access in the called body" { panic diagnostic.message }
        }
    }
    match checked(source: "enum Value { Item(value: I64) } fn captured[T](value: T) -> fn() -> T { return fn() -> T { return value } } fn main() { val closure = captured(value: <Value.Item value=1I64 />) }") {
        ProgramCheckResult.Failure(diagnostic: val diagnostic) => { panic diagnostic.message }
        ProgramCheckResult.Success(program: val program) => {
            match prepareCheckedProgram(checked: move program) {
                ExecutableCompilationResult.Success(compilation: val compilation) => { panic "concrete limit accepted" }
                ExecutableCompilationResult.Failure(diagnostic: val diagnostic) => {
                    if diagnostic.message != "v1 rejects closure capture of unique, generic-instantiated, enum, or function-typed values" { panic diagnostic.message }
                }
            }
        }
    }
    match CheckedProgram.check(input: <FrontendInput.Text text="fn main() {}" path="gen.pw" />,
        sources: <SourceAccess stdRoot=[] />, options: <FrontendOptions genMode=true />) {
        ProgramCheckResult.Success(program: val program) => { panic "generator issued whole-target proof" }
        ProgramCheckResult.Failure(diagnostic: _) => {}
    }
    print("ok")
}
