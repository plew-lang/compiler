// Valid source companions for structural condition normalization. Every
// associated projection declares its receiver premise. The internal chain
// control is associated_condition_normalization_chain.pw.
trait Parser { type Output }
trait Mark {}
trait Use { fn use() -> I64 }
trait Convert[Input] {}
trait Other { type Output }
struct Leaf {}
struct Next {}
impl Next as Parser { type Output = Leaf }
struct Source {}
impl Source as Parser { type Output = Next }
impl Leaf as Mark {}
impl Source as Convert[Next] {}
impl Source as Other { type Output = Next }
struct Wrap[T] {}
impl Wrap[Next] as Mark {}
struct Nested[T] { val value: T }
impl[T] Nested[T] as Use where T: Parser, Wrap[T#Parser.Output]: Mark { fn use() -> I64 { return 1I64 } }
struct Arguments[T] { val value: T }
impl[T] Arguments[T] as Use where T: Parser + Convert[T#Parser.Output] { fn use() -> I64 { return 2I64 } }
struct Outputs[T] { val value: T }
impl[T] Outputs[T] as Use where T: Parser + Other[Output = T#Parser.Output] { fn use() -> I64 { return 3I64 } }
fn requireUse[T](value: T, expected: I64) where T: Use {
    if value.use() != expected { panic("wrong conditional implementation") }
}
fn main() {
    requireUse(value: <Nested[Source] value=<Source /> />, expected: 1I64)
    requireUse(value: <Arguments[Source] value=<Source /> />, expected: 2I64)
    requireUse(value: <Outputs[Source] value=<Source /> />, expected: 3I64)
}
