trait Parser { type Output }
trait Mark {}
trait Use { fn use() -> I64 }
trait Convert[Input] {}
trait Other { type Output }
struct Leaf {}
struct Next {}
impl Next as Parser { type Output = Leaf }
struct Source {}
impl Source as Parser { type Output = Next }
impl Leaf as Mark {}
impl Source as Convert[Next] {}
impl Source as Other { type Output = Next }
struct Wrap[T] {}
impl Wrap[Next] as Mark {}
struct Nested[T] { val value: T }
impl[T] Nested[T] as Use where Wrap[T#Parser.Output]: Mark { fn use() -> I64 { return 1I64 } }
struct Arguments[T] { val value: T }
impl[T] Arguments[T] as Use where T: Convert[T#Parser.Output] { fn use() -> I64 { return 2I64 } }
struct Outputs[T] { val value: T }
impl[T] Outputs[T] as Use where T: Other[Output = T#Parser.Output] { fn use() -> I64 { return 3I64 } }
struct Chain[T] { val value: T }
impl[T] Chain[T] as Use where T#Parser.Output#Parser.Output: Mark { fn use() -> I64 { return 4I64 } }
fn requireUse[T](value: T) where T: Use {}
fn main() {
    requireUse(value: <Nested[Source] value=<Source /> />)
    requireUse(value: <Arguments[Source] value=<Source /> />)
    requireUse(value: <Outputs[Source] value=<Source /> />)
    requireUse(value: <Chain[Source] value=<Source /> />)
}
