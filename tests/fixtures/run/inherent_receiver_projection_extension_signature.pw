use @Std/Io only { print }
trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }
extension Extra { pub impl[T] Box[T, T#Source.Item] where T: Source { fn value() -> I64 { return 42I64 } } }
fn inspect[T](x: Box[T, I64]#Extra) -> I64 where T: Source[Item=I64] { return x.value() }
fn main() { print(inspect(x: <Box[Number, I64] item=42I64 />#Extra)) }
