use @Std/Core only { Index }
use @Std/Io only { print }
trait LeftIndex: Index[U64, Output=I64] {}
trait RightIndex: Index[U64, Output=I64] {}
trait DiamondIndex: LeftIndex + RightIndex {}
struct Shelf { pub val item: I64 }
pub impl Shelf { factory }
pub impl Shelf as Index[U64] {
    type Output = I64
    fn index(key: U64) -> I64 { return self.item }
}
pub impl Shelf as LeftIndex {}
pub impl Shelf as RightIndex {}
pub impl Shelf as DiamondIndex {}
fn main() {
    val shelf: any DiamondIndex = <Shelf item=17I64 />
    print(shelf[0U64])
}
