import @Std/Io with { print }
import @Std/Core with { Iterator }

// A method-owned generic parameter can be a non-scalar value.  The final
// CallResolution carries it separately from the generic iterator receiver, so
// `fold` may use String as its accumulator while Item remains I64.
struct Counter { pub mut val n: I64  pub val limit: I64 }
pub impl Counter { factory }
pub impl Counter as Iterator {
    type Item = I64
    inout fn next() -> Optional[I64] {
        if self.n < self.limit {
            val v: I64 = self.n
            self.n = self.n + 1
            return <Optional.Some v=v />
        }
        return <Optional.None />
    }
}

fn main() {
    mut val b: Counter = <Counter n=0 limit=3 />
    val s: String = b.map(f: fn(x: I64) -> I64 { return x }).fold(init: "z", combine: fn(acc: String, x: I64) -> String { return acc })
    print(s)
}
