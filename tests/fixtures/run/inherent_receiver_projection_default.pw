use @Std/Io only { print }
trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }
impl[T] Box[T, T#Source.Item] where T: Source { fn value(extra: I64 = 40I64) -> I64 { return extra + 2I64 } }
fn main() { print(<Box[Number, I64] item=0I64 />.value()) }
