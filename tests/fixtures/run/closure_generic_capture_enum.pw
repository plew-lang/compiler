use @Std/Io only { print }
enum Value { Item(value: I64) }
fn captured[T](value: T) -> fn() -> T {
    return fn() -> T { return value }
}
fn main() {
    val scalar = captured(value: 1I64)
    val enumeration = captured(value: <Value.Item value=2I64 />)
    print(scalar())
    match enumeration() { Value.Item(value: val value) => { print(value) } }
}
