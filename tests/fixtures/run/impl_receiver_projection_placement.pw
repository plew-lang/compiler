use @Std/Io only { print }
trait Source[T] { type Item }
struct Number {}
impl Number as Source[I64] { type Item=I64 }
trait Marker[T] {}
struct Receiver {}
impl Receiver as Marker[I64] {}
trait Show { fn show() -> I64 }
impl Marker[Number#Source[I64].Item] as Show { fn show() -> I64 { return 42I64 } }
fn main() { print(<Receiver />.show()) }
