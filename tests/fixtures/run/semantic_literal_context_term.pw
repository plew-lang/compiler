use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, spansEqual }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, TypeRef, SemanticExpressionTypeState }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="literal-context.pw" text="fn unit() {{}} diverge fn stop() {{ panic(\"stop\") }} fn probe() {{ val result = unit() stop() }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    compiler.cur.checkFn = owner
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen nameId=integerName.nameId args=[] />)
    val literal = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    match compiler.recordExpr(exprId: literal) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    match compiler.sourceSemanticExprTypeAt(index: literal).typeState {
        SemanticExpressionTypeState.Pending => {}
        _ => { panic "untyped literal is not pending" }
    }
    match compiler.recordExpr(exprId: literal, expectedTerm: integer) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    val recorded = compiler.semanticExprTerm(exprId: literal)
    if recorded == 0U64 { panic "context producer did not publish a term" }
    match compiler.sourceSemanticExprTypeAt(index: literal).typeState {
        SemanticExpressionTypeState.Value => {}
        _ => { panic "context producer left the literal pending" }
    }
    val typeCount = compiler.arena.typeCount()
    if compiler.semanticExprTerm(exprId: literal) != recorded { panic "reader changed the term" }
    if compiler.semanticExprTerm(exprId: literal) != recorded || compiler.arena.typeCount() != typeCount { panic "reader materialized a type" }
    match compiler.recordExpr(exprId: literal) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    if compiler.semanticExprTerm(exprId: literal) != recorded { panic "context-free recording erased the checked context" }
    val unsignedName = compiler.internBytes(s: "U8")
    val unsigned = compiler.pushType(t: <TypeRef nameStart=unsignedName.nameStart nameLen=unsignedName.nameLen nameId=unsignedName.nameId args=[] />)
    val explicit = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=unsignedName.nameStart tyLen=unsignedName.nameLen isNeg=false />)
    match compiler.recordExpr(exprId: explicit, expectedTerm: integer) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    if !compiler.typeRefEq(a: compiler.semanticExprTerm(exprId: explicit), b: unsigned) { panic "expected context overwrote an explicit type" }
    if compiler.tcCheckValue(expectedRef: integer, valueExpr: explicit, pos: "literal-context").isOk() { panic "incompatible explicit type matched numeric context" }
    val elements = compiler.pushExprs(exprs: [])
    val array = compiler.pushExpr(e: <Expr.Array elems=elements />)
    compiler.recordExpr(exprId: array).unwrap()
    if compiler.recordExpr(exprId: array, expectedTerm: integer).isOk() { panic "non-array context was accepted for an empty array" }
    if compiler.semanticExprTerm(exprId: array) != 0U64 { panic "numeric context invented an array type" }
    match compiler.sourceSemanticExprTypeAt(index: array).typeState {
        SemanticExpressionTypeState.Pending => {}
        _ => { panic "numeric context resolved an untyped array" }
    }
    match compiler.recordParametricFunction(fnIdx: owner, recordCallTemplates: false) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    compiler.cur.checkFn = owner
    val unitName = compiler.internBytes(s: "unit")
    val stopName = compiler.internBytes(s: "stop")
    mut val unit = compiler.arena.exprs.count()
    mut val stopped = compiler.arena.exprs.count()
    mut val index = 0U64
    while index < compiler.arena.exprs.count() {
        match compiler.arena.exprs[index] {
            Expr.Call(val nameStart, val nameLen, args: _) => {
                if spansEqual(c: inout compiler, aStart: nameStart, aLen: nameLen, bStart: unitName.nameStart, bLen: unitName.nameLen) { unit = index }
                if spansEqual(c: inout compiler, aStart: nameStart, aLen: nameLen, bStart: stopName.nameStart, bLen: stopName.nameLen) { stopped = index }
            }
            _ => {}
        }
        index += 1U64
    }
    if unit >= compiler.arena.exprs.count() || stopped >= compiler.arena.exprs.count() { panic "missing callable context probes" }
    val unitTerm = compiler.semanticExprTerm(exprId: unit)
    match compiler.recordExpr(exprId: unit, expectedTerm: integer) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    if !compiler.recordedExpressionHasUnitResult(exprId: unit) { panic "numeric context erased Unit state" }
    if !compiler.typeRefEq(a: compiler.semanticExprTerm(exprId: unit), b: unitTerm) { panic "numeric context changed Unit type" }
    if compiler.recordExpr(exprId: stopped, expectedTerm: integer).isOk() { panic "diverging expression was accepted as a numeric value" }
    match compiler.sourceSemanticExprTypeAt(index: stopped).typeState {
        SemanticExpressionTypeState.NoNormalValue => {}
        _ => { panic "context erased normal-value absence" }
    }
    print("semantic-literal-context-term")
}
