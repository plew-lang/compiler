use /Frontend only { Comp, FrontendInput, FinalBodyRequests, FinalDependencies, FinalizationPublication, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use @Std/Io only { print }

fn main() {
    mut val c = <Comp />
    val source = "fn main() {{ val erased: any Value = <Box item=1I64 /> }} trait Value {{ fn get() -> I64 }} struct Box {{ val item: I64 }} impl Box as Value {{ fn get() -> I64 {{ missing() }} }}"
    analyzeFrontendForRequests(c: inout c, input: <FrontendInput.Text path="witness.pw" text=source />, sources: <SourceAccess />).unwrap()
    c.initializeFinalCallables().unwrap()
    mut val requests = <FinalBodyRequests />
    mut val dependencies = <FinalDependencies />
    mut val publication = <FinalizationPublication />
    val root = c.enqueueFinalBody(fnIdx: 0U64, args: [], recvInstRef: 0U64).unwrap()
    match c.requestFinalBody(bodyId: root, requests: inout requests) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic diagnostic.message }
    }
    if c.arena.finalExistentials.count() != 1U64 { panic "missing witness resolution" }
    val member = c.arena.finalExistentials[0U64].members[0U64]
    if member.adapterBodyId == 0U64 || member.bodyId == 0U64 || member.callResolution != 0U64 { panic "witness body was prepared with signature" }
    val signature = c.arena.bodySignature(bodyId: member.adapterBodyId)
    if !signature.ready || !c.typeRefEq(a: signature.resultType, b: member.resultType) { panic "witness signature not published" }
    val declarations = c.lexicalBodyPreparations.count()
    c.closeFinalDependencies(state: inout dependencies).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    c.cur.bodyId = 88U64
    c.cur.checkFn = 77U64
    c.inCollection = false
    c.requestFinalBody(bodyId: member.adapterBodyId, requests: inout requests).unwrap()
    val prepared = c.arena.finalExistentials[0U64].members[0U64]
    if prepared.callResolution == 0U64 || c.arena.finalCalleeAt(index: prepared.callResolution - 1U64).calleeBodyId != member.bodyId { panic "witness request lost selected target" }
    if c.lexicalBodyPreparations.count() != declarations { panic "adapter requested target source body" }
    val calls = c.arena.finalCalleeCount()
    c.requestFinalBody(bodyId: member.adapterBodyId, requests: inout requests).unwrap()
    if c.arena.finalCalleeCount() != calls || c.cur.bodyId != 88U64 || c.cur.checkFn != 77U64 || c.inCollection { panic "witness request repeated or leaked context" }
    c.closeFinalDependencies(state: inout dependencies).unwrap()
    c.publishFinalCallables(state: inout publication).unwrap()
    match c.requestFinalBody(bodyId: member.bodyId, requests: inout requests) {
        Result.Ok(value: _) => { panic "invalid source method accepted" }
        Result.Err(error: _) => {}
    }
    print("ok")
}
