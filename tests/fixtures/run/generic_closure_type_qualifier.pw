use @Std/Io only { print }

trait Create { assoc fn create() -> I64 }
struct First {}
struct Second {}
pub impl First as Create { assoc fn create() -> I64 { return 7I64 } }
pub impl Second as Create { assoc fn create() -> I64 { return 19I64 } }

// No value capture carries T. The closure still owns an operation under the
// enclosing instance's lexical generic environment.
fn creator[T](witness: T) -> fn() -> I64 where T: Create {
    return fn() -> I64 { return T.create() }
}

fn main() {
    val first = creator(witness: <First />)
    val second = creator(witness: <Second />)
    print(first())
    print(second())
}
