// Context comes from the visible callable and its whole label sequence.
use @Std/Io only { write }
use @Std/Core only { assert }

struct Value { val number: I64 = 7I64 }
struct Reader {}
impl Reader {
    fn pick(value: Value) -> I64 { return value.number }
}
fn pick(value: Value) -> I64 { return value.number }
fn pick(otherValue: Value) -> I64 { return otherValue.number }
fn other(value: Value) -> I64 { return value.number }
fn unlabeled(value~: Value) -> I64 { return value.number }
fn defaults(first: Value = <Value />, second: Value) -> I64 {
    return first.number + second.number
}
fn main() {
    val reader = <Reader />
    assert(pick(value: <number=11I64 />) == 11I64)
    assert(pick(otherValue: <number=22I64 />) == 22I64)
    assert(other(value: <number=33I64 />) == 33I64)
    assert(reader.pick(value: <number=44I64 />) == 44I64)
    assert(unlabeled(<number=55I64 />) == 55I64)
    assert(defaults(second: </>) == 14I64)
    write(s: "call-argument-name-context-ok\n")
}
