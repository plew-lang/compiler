import @Std/Io with { print }
// `trait Sub: Super` — conforming to Sub also requires Super; both usable.
export trait Super { fn base() -> I64 }
export trait Sub: Super { fn extra() -> I64 }
struct X { pub val n: I64 }
pub impl X { factory }
pub impl X as Super { fn base() -> I64 { return self.n } }
pub impl X as Sub { fn extra() -> I64 { return self.n + 1I64 } }
fn main() {
    val x: X = <X n=5 />
    print(x.base())    // 5
    print(x.extra())   // 6
}
