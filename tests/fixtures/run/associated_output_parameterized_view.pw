use @Std/Io only { print }

trait Mark[K] {
    fn number() -> I64
}

struct Value {}
impl Value as Mark[Bool] {
    fn number() -> I64 { return 42I64 }
}

trait Source[K] {
    type Item: Mark[Bool]
}
pub impl Source[I64] {
    fn read(value: Item#Mark[Bool]) -> I64 { return value.number() }
    fn forward(value: Item#Mark[Bool]) -> Item#Mark[Bool] { return value }
}

struct Provider {}
pub impl Provider { factory }
impl Provider as Source[I64] { type Item = Value }

fn main() {
    val receiver = <Provider />
    val value = <Value />#Mark[Bool]
    print(receiver.read(value: value))
    print(receiver.forward(value: value).number())
}
