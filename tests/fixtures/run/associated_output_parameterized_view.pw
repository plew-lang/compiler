use @Std/Io only { print }

trait Mark[K] {
    fn number() -> I64
}

struct Value {}
impl Value as Mark[Bool] {
    fn number() -> I64 { return 42I64 }
}

trait Source[K] {
    type Item: Mark[Bool]
}
pub impl Source[I64] {
    fn read(value: Item#Mark[Bool]) -> I64 { return value.number() }
}

struct Provider {}
pub impl Provider { factory }
impl Provider as Source[I64] { type Item = Value }

fn main() {
    print(<Provider />.read(value: <Value />#Mark[Bool]))
}
