import @Plew/Syntax with { Lexer, P, ExternId, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxExternHasDeriveDirective }
import @Std/Io with { print }

fn main() {
    val source = "extern(plewIntrinsic) { @[TryFrom] struct I8 }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    print(syntaxExternHasDeriveDirective(file: file, id: <ExternId raw=syntaxTopItemPayload(file: file, item: item) />))
}
