// A lexical scope boundary is not an LLVM-side cleanup convention.  It is a
// Mid CFG marker which drop-elaboration must turn into the explicit root Drop
// required by the ownership verifier.
import @Std/Io with { write }
import /Frontend with { Comp }
import /Mid with { MidPlace, MidStatement, MidTerminator, MidBlock, MidLocalDecl, MidScope, MidBody, elaborateCanonicalMidDrops, verifyCanonicalMidBody, MidVerifyError }

fn main() {
    mut val c: Comp = <Comp />
    val file: MidLocalDecl = <MidLocalDecl typeTerm=1U64 sourceScope=0U64 isUnique=true isParameter=false ownsAtEntry=true />
    val boundary: MidBlock = <MidBlock statements=[<MidStatement.ScopeExit scope=0U64 />] terminator=<MidTerminator.Return /> />
    val body: MidBody = <MidBody locals=[file] scopes=[<MidScope firstLocal=0U64 localCount=1U64 />] blocks=[boundary] entry=0U64 />
    val elaborated = elaborateCanonicalMidDrops(arena: inout c.mid, canonical: c.mid.store(body: body))
    val node = c.mid.bodies[elaborated.body - 1U64]
    val block = c.mid.blocks[node.blocks.start]
    val statement = c.mid.statements[block.statements.start]
    if statement.tag == 3U64 && c.mid.places[statement.destination - 1U64].local == 0U64 { write(s: "scope-drop\n") }
    else { write(s: "missing-scope-drop\n") }
    match verifyCanonicalMidBody(c: inout c, canonical: elaborated).error {
        MidVerifyError.None => { write(s: "valid\n") }
        _ => { write(s: "invalid\n") }
    }
}
