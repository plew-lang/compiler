// Value-position literal matches must preserve the existing single-evaluation
// give-block wrapper; they are not a direct enum MatchExpr.
import @Plew/Syntax with { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxTopItemPayload, syntaxBlock, syntaxBlockStmt, syntaxStmt }
import @Std/Io with { print }
import /Frontend with { Comp }

fn main() {
    val source = "fn body() { val result = match 1I8 { 1I8 => { give 2I8 } _ => { give 3I8 } } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    val block = syntaxBlock(file: file, id: decl.body)
    val letStmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: block, index: 0U64))

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    c.lowerSyntaxExpr(id: letStmt.child0)
    print(c.arena.blocks.count())
    print(c.arena.stmts.count())
    print(c.arena.exprs.count())
}
