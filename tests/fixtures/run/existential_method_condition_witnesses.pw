use @Std/Io only { print }
trait Marker { fn number() -> I64 }
trait Flag { fn flag(number: I64) -> I64 }
struct Value {}
impl Value as Marker { fn number() -> I64 { return 42I64 } }
struct Enabled {}
impl Enabled as Flag { fn flag(number: I64) -> I64 { return number } }
trait Service: Marker { fn get() -> I64 where Self: Marker }
impl Value as Service { fn get() -> I64 where Self: Marker { return self.number() } }
trait Absent {}
trait Unavailable { fn get() -> I64 where Self: Absent }
struct Other {}
impl Other as Unavailable { fn get() -> I64 { return 0I64 } }
trait Items { type Item: Marker fn get(item: Item) -> I64 where Item: Marker }
struct Storage[T] {}
impl[T] Storage[T] as Items where T: Marker {
    type Item = T
    fn get(item: T) -> I64 where T: Marker { return item.number() }
}
trait PairService {
    type Left
    type Right
    fn get(left: Left, right: Right) -> I64 where Left: Marker, Right: Flag
}
struct Pair[L,R] {}
impl[L,R] Pair[L,R] as PairService {
    type Left = L
    type Right = R
    fn get(left: L, right: R) -> I64 where R: Flag, L: Marker { return right.flag(number: left.number()) }
}
fn service(value: any Service) -> I64 { return value.get() }
fn item(value: any Items[Item=Value]) -> I64 { return value.get(item: <Value />) }
fn pair(value: any PairService[Left=Value,Right=Enabled]) -> I64 { return value.get(left: <Value />, right: <Enabled />) }
fn main() {
    val unavailable: any Unavailable = <Other />
    val first = service(value: <Value />)
    val second = item(value: <Storage[Value] />)
    val third = pair(value: <Pair[Value,Enabled] />)
    print(first)
    print(second)
    print(third)
}
