use @Std/Io only { print }
use @Std/Core only { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

enum Inner {
    Keep(r: MutableRef[Cell])
    Nothing
}

enum Outer {
    Hold(inner: Inner)
    Empty
}

fn hold() {
    val o: Outer = <Outer.Hold inner=<Inner.Keep r=<MutableRef value=<Cell v=7I32 /> /> /> />
    print("scope-end")
}

fn main() {
    hold()
    print("done")
}
