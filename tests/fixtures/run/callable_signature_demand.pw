import /Frontend with { Comp, FrontendInput, analyzeFrontendForRequests, spansEqual }
import /SourceAccess with { SourceAccess }
import /Ir with { InstanceEnvironment }
import @Std/Io with { print }

fn owner(c: inout Comp, name: String) -> U64 {
    val span = c.internBytes(s: name)
    mut val index = 0U64
    while index < c.arena.functionCount() {
        val function = c.arena.functionAt(index: index)
        if spansEqual(c: inout c, aStart: function.nameStart, aLen: function.nameLen, bStart: span.nameStart, bLen: span.nameLen) { return index }
        index += 1U64
    }
    panic "missing declaration"
}

fn main() {
    mut val c = <Comp />
    analyzeFrontendForRequests(c: inout c, input: <FrontendInput.Text path="signature.pw" text="struct Item {} fn later[T](value: T) -> T { missing() } fn main() {}" />, sources: <SourceAccess />).unwrap()
    val declaration = owner(c: inout c, name: "later")
    val item = c.arena.structAt(index: 0U64)
    val term = c.simpleTypeRef(nameStart: item.nameStart, nameLen: item.nameLen)
    val environment = c.bodyInstanceEnvironment(fnIdx: declaration, args: [term], recvInstRef: 0U64).unwrap()
    val body = c.internBodyInstance(fnIdx: declaration, environment: environment)
    c.cur.checkFn = 77U64
    c.cur.bodyId = 88U64
    c.cur.selfRef = term
    c.inCollection = false
    c.prepareFinalCallableSignature(bodyId: body).unwrap()
    val signature = c.arena.bodySignature(bodyId: body)
    if !signature.ready || signature.parameterTypes.count() != 1U64 || !c.typeRefEq(a: signature.parameterTypes[0U64], b: term) || !c.typeRefEq(a: signature.resultType, b: term) { panic "signature did not ground its declaration" }
    if c.cur.checkFn != 77U64 || c.cur.bodyId != 88U64 || c.cur.selfRef != term || c.inCollection { panic "signature leaked its context" }
    if c.lexicalBodyPreparations.count() != 0U64 || c.monoWork.bodyCount() != 0U64 || c.arena.finalCallees.count() != 0U64 || c.mid.bodies.count() != 0U64 { panic "signature requested executable body work" }
    val types = c.arena.bodyTypeTermResult(bodyId: body, typeTerm: c.arena.functionAt(index: declaration).retTy)
    if types.bodyId != body || !c.typeRefEq(a: types.resultType, b: term) { panic "signature lost its instance type facts" }
    c.prepareFinalCallableSignature(bodyId: body).unwrap()
    if c.lexicalBodyPreparations.count() != 0U64 { panic "repeat signature requested source body" }
    match c.prepareLexicalBody(fnIdx: declaration) {
        Result.Ok(value: _) => { panic "invalid body was accepted by signature readiness" }
        Result.Err(error: _) => {}
    }
    // Invalid admission also leaves the caller's environment untouched.
    match c.prepareFinalCallableSignature(bodyId: 0U64) {
        Result.Ok(value: _) => { panic "invalid instance accepted" }
        Result.Err(error: _) => {}
    }
    if c.cur.checkFn != 77U64 || c.cur.bodyId != 88U64 || c.inCollection { panic "failed signature leaked its context" }
    print("ok")
}
