use @Std/Io only { print }
fn first[T](typeValue: T, values: Array[T]) -> T { return values[0] }
fn identity[T](typeValue: T, value: T) -> T { return value }
fn main() {
    print(first(typeValue: 0I64, values: [42]))
    print(first(typeValue: 0I64, values: { give [43] }))
    print(first(typeValue: 0I64, values: if true { give [44] } else { give [0] }))
    print(first(typeValue: 0I64, values: match true { true => [45] false => [0] }))
    print(identity(typeValue: 0I64, value: 46))
}
