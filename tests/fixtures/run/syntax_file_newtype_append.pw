import @Plew/Syntax with { Lexer, P, SyntaxFile, lex, parseProgramSyntaxInto }
import @Std/Io with { print }

fn main() {
    val source = "newtype Bytes = Array[U8]\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    mut val file = <SyntaxFile />
    val roots = parseProgramSyntaxInto(p: inout parser, file: inout file)
    print(roots.count)
}
