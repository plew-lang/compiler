use @Std/Core only { assert }
use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Diag only { CompileDiagnostic }
use /Ir only { InstanceEnvironment, ValueConversionProof, TypeRef, StructDef, Bind, Expr }

fn main() {
    mut val compiler = <Comp />
    val source = "use @Std/Lang only {{ Optional as Maybe }} struct Optional[T] {{}} struct Item {{ pub val count: I64 }} pub impl Item {{ factory }} struct Box[T] {{ pub val item: T }} pub impl[T] Box[T] {{ factory }} fn direct(value: Maybe[Box[Item]]) -> Maybe[Item] {{ return value?.item }} fn block(value: Maybe[Box[Item]]) -> Maybe[Item] {{ return {{ give value?.item }} }} fn branch(value: Maybe[Box[Item]], flag: Bool) -> Maybe[Item] {{ return if flag {{ give value?.item }} else {{ give <Maybe[Item].None /> }} }} fn generic[T](value: Maybe[Box[T]]) -> Maybe[T] {{ return value?.item }} fn nested(value: Maybe[Box[Box[Item]]]) -> Maybe[Box[Item]] {{ return value?.item }} fn unrelated() {{}}"
    requireSuccess(result: analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path="chain-source-types.pw" />, sources: <SourceAccess />))
    val unrelated = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "unrelated").nameId)
    requireSuccess(result: compiler.prepareLexicalBody(fnIdx: unrelated))
    val foreign = compiler.internBodyInstance(fnIdx: unrelated, environment: <InstanceEnvironment />)
    for name in ["direct", "block", "branch", "generic", "nested"] {
        val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: name).nameId)
        requireSuccess(result: compiler.prepareLexicalBody(fnIdx: function))
        val body = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment />)
        val result = compiler.preparedFunctionBodySignature(fnIdx: function).unwrap().resultTerm
        mut val found = 0U64
        for site in compiler.decls.chainSites {
            match compiler.preparedBodyExpression(bodyId: body, exprId: site.exprId) {
                Result.Err(error: _) => {}
                Result.Ok(value: val expression) => {
                    assert(expression.term != 0U64)
                    assert(compiler.arena.typeAt(index: expression.term).hasDecl)
                    assert(compiler.typeRefEq(a: expression.term, b: result))
                    assert(compiler.typeRefEq(a: expression.term, b: site.stageRef))
                    assert(compiler.preparedBodyExpression(bodyId: foreign, exprId: site.exprId).isErr())
                    if name == "direct" { checkStageInputs(compiler: inout compiler, result: expression.term) }
                    found += 1U64
                }
            }
        }
        assert(found == 1U64)
        for conversion in compiler.decls.declarationConversions {
            if conversion.site.ownerFnIdx == function {
                match compiler.thawValueConversionProof(id: conversion.proof) {
                    ValueConversionProof.Missing => { panic("chain conversion lost its source type") }
                    _ => {}
                }
            }
        }
    }
    print("chain-source-type-identity")
}

fn requireSuccess(result: Result[(), CompileDiagnostic]) {
    match result {
        Result.Ok(value: _) => {}
        Result.Err(error: val error) => { print(error.message) panic("chain source preparation failed") }
    }
}

fn checkStageInputs(compiler: inout Comp, result: U64) {
    val shape = compiler.arena.typeAt(index: result)
    val hole = compiler.pushExpr(e: <Expr.ChainHole />)
    assert(compiler.typeRefEq(a: compiler.chainStageResultRef(baseRef: result, cont: hole).unwrap(), b: result))
    assert(compiler.chainStageResultRef(baseRef: 0U64, cont: hole).unwrap() == 0U64)
    val unowned = compiler.pushType(t: <TypeRef nameStart=shape.nameStart nameLen=shape.nameLen args=shape.args />)
    val missing = compiler.chainStageResultRef(baseRef: unowned, cont: hole)
    assert(missing.isErr() || missing.unwrap() == 0U64)
    val foreignOwner = compiler.typeDeclIdentityInModule(mod: 0U64, start: shape.nameStart, len: shape.nameLen)
    val foreignCarrier = compiler.declaredTypeRef(nameStart: shape.nameStart, nameLen: shape.nameLen, args: shape.args, declaration: foreignOwner)
    assert(foreignCarrier != 0U64 && !compiler.typeRefEq(a: foreignCarrier, b: result))
    val foreignStage = compiler.chainStageResultRef(baseRef: foreignCarrier, cont: hole)
    assert(foreignStage.isErr() || foreignStage.unwrap() == 0U64)
    val child = compiler.arena.typeAt(index: shape.args[0U64])
    val offset = compiler.arena.bytes.count() + 20U64
    compiler.modules.registerSourceFile(start: offset, length: 1U64, moduleId: 777U64, path: "ForeignItem.pw")
    compiler.arena.registerStruct(<StructDef nameStart=child.nameStart nameLen=child.nameLen nameId=child.nameId typeParams=[] fields=[] isUnique=false isExtern=false defOffset=offset />)
    val otherChild = compiler.declaredTypeRef(nameStart: child.nameStart, nameLen: child.nameLen, args: [], declaration: <Bind nameStart=offset nameLen=1U64 fieldStart=0U64 fieldLen=0U64 />)
    val other = compiler.rebuildTypeTerm(t: shape, args: [otherChild], assocTraitArgs: shape.assocTraitArgs)
    val otherStage = compiler.chainStageResultRef(baseRef: other, cont: hole).unwrap()
    assert(!compiler.typeRefEq(a: otherStage, b: result))
    match compiler.callArgumentConversion(sourceRef: otherStage, targetRef: result).unwrap() {
        ValueConversionProof.Missing => {}
        _ => { panic("chain conversion merged foreign nominal children") }
    }
}
