use @Std/Core only { assert }
use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess, SourceResource }
use /Diag only { CompileDiagnostic }
use /Ir only { InstanceEnvironment, ValueConversionProof, TypeRef, StructDef, Bind, Expr }

fn main() {
    mut val compiler = <Comp />
    val source = "struct Item {{ pub val count: I64 }} pub impl Item {{ factory }} struct Box[T] {{ pub val item: T }} pub impl[T] Box[T] {{ factory }} fn direct(value: Optional[Box[Item]]) -> Optional[Item] {{ return value?.item }} fn block(value: Optional[Box[Item]]) -> Optional[Item] {{ return {{ give value?.item }} }} fn branch(value: Optional[Box[Item]], flag: Bool) -> Optional[Item] {{ return if flag {{ give value?.item }} else {{ give <Optional[Item].None /> }} }} fn generic[T](value: Optional[Box[T]]) -> Optional[T] {{ return value?.item }} fn nested(value: Optional[Box[Box[Item]]]) -> Optional[Box[Item]] {{ return value?.item }} fn unrelated() {{}}"
    val path = "plew:std/ChainProbe.pw"
    val sources = <SourceAccess stdRoot="std/".bytes() resources=[<SourceResource path=path.bytes() text=source />] />
    requireSuccess(result: analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.File path=path />, sources: sources), context: "analysis")
    val unrelated = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "unrelated").nameId)
    requireSuccess(result: compiler.prepareLexicalBody(fnIdx: unrelated), context: "unrelated")
    val foreign = compiler.internBodyInstance(fnIdx: unrelated, environment: <InstanceEnvironment />)
    for name in ["direct", "block", "branch", "generic", "nested"] {
        val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: name).nameId)
        requireSuccess(result: compiler.prepareLexicalBody(fnIdx: function), context: name)
        val body = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment />)
        val result = compiler.preparedFunctionBodySignature(fnIdx: function).unwrap().resultTerm
        mut val found = 0U64
        for site in compiler.decls.chainSites {
            match compiler.preparedBodyExpression(bodyId: body, exprId: site.exprId) {
                Result.Err(error: _) => {}
                Result.Ok(value: val expression) => {
                    if expression.term == 0U64 { panic("chain expression has no saved term") }
                    if !compiler.arena.typeAt(index: expression.term).hasDecl { panic("chain expression lost its owner") }
                    if !compiler.typeRefEq(a: expression.term, b: result) { panic("chain expression differs from its return type") }
                    if !compiler.typeRefEq(a: expression.term, b: site.stageRef) { panic("chain expression differs from its stage") }
                    match compiler.callArgumentConversion(sourceRef: expression.term, targetRef: result).unwrap() {
                        ValueConversionProof.Identity => {}
                        _ => { panic("matching chain endpoints lost identity conversion") }
                    }
                    assert(compiler.preparedBodyExpression(bodyId: foreign, exprId: site.exprId).isErr())
                    if name == "direct" { checkStageInputs(compiler: inout compiler, result: expression.term) }
                    found += 1U64
                }
            }
        }
        if found != 1U64 { panic("chain source has an unexpected site count") }
        for conversion in compiler.decls.declarationConversions {
            if conversion.site.ownerFnIdx == function {
                match compiler.thawValueConversionProof(id: conversion.proof) {
                    ValueConversionProof.Missing => { panic("chain conversion lost its source type") }
                    _ => {}
                }
            }
        }
    }
    print("chain-source-type-identity")
}

fn requireSuccess(result: Result[(), CompileDiagnostic], context: String) {
    match result {
        Result.Ok(value: _) => {}
        Result.Err(error: val error) => { print(context) print(error.message) panic("chain source preparation failed") }
    }
}

fn checkStageInputs(compiler: inout Comp, result: U64) {
    val shape = compiler.arena.typeAt(index: result)
    val hole = compiler.pushExpr(e: <Expr.ChainHole />)
    if !compiler.typeRefEq(a: compiler.chainStageResultRef(baseRef: result, cont: hole).unwrap(), b: result) { panic("chain stage changed an identity continuation") }
    val alias = compiler.internBytes(s: "Maybe")
    val aliased = compiler.pushType(t: <TypeRef nameStart=alias.nameStart nameLen=alias.nameLen args=shape.args hasDecl=true declOffset=shape.declOffset />)
    if !compiler.typeRefEq(a: compiler.chainStageResultRef(baseRef: aliased, cont: hole).unwrap(), b: result) { panic("chain stage lost an aliased owner") }
    assert(compiler.chainStageResultRef(baseRef: 0U64, cont: hole).unwrap() == 0U64)
    val unowned = compiler.pushType(t: <TypeRef nameStart=shape.nameStart nameLen=shape.nameLen args=shape.args />)
    val missing = compiler.chainStageResultRef(baseRef: unowned, cont: hole)
    if !(missing.isErr() || missing.unwrap() == 0U64) { panic("chain stage accepted a missing nominal owner") }
    val carrierName = compiler.internBytes(s: "Optional")
    val carrierOffset = carrierName.nameStart
    compiler.modules.registerSourceFile(start: carrierOffset, length: carrierName.nameLen, moduleId: 778U64, path: "ForeignOptional.pw")
    val parameters = compiler.lowerTypeParamNames(names: ["Element"], anchor: carrierOffset).unwrap()
    compiler.arena.registerStruct(<StructDef nameStart=carrierName.nameStart nameLen=carrierName.nameLen nameId=carrierName.nameId typeParams=parameters fields=[] isUnique=false isExtern=false defOffset=carrierOffset />)
    val foreignOwner = <Bind nameStart=carrierOffset nameLen=1U64 fieldStart=0U64 fieldLen=0U64 />
    val foreignCarrier = compiler.declaredTypeRef(nameStart: shape.nameStart, nameLen: shape.nameLen, args: shape.args, declaration: foreignOwner)
    assert(foreignCarrier != 0U64 && !compiler.typeRefEq(a: foreignCarrier, b: result))
    val foreignStage = compiler.chainStageResultRef(baseRef: foreignCarrier, cont: hole)
    if !(foreignStage.isErr() || foreignStage.unwrap() == 0U64) { panic("chain stage accepted a foreign carrier") }
    val child = compiler.arena.typeAt(index: shape.args[0U64])
    val childName = compiler.internBytes(s: "Item")
    val offset = childName.nameStart
    compiler.modules.registerSourceFile(start: offset, length: childName.nameLen, moduleId: 777U64, path: "ForeignItem.pw")
    compiler.arena.registerStruct(<StructDef nameStart=childName.nameStart nameLen=childName.nameLen nameId=childName.nameId typeParams=[] fields=[] isUnique=false isExtern=false defOffset=offset />)
    val otherChild = compiler.declaredTypeRef(nameStart: child.nameStart, nameLen: child.nameLen, args: [], declaration: <Bind nameStart=offset nameLen=1U64 fieldStart=0U64 fieldLen=0U64 />)
    val other = compiler.rebuildTypeTerm(t: shape, args: [otherChild], assocTraitArgs: shape.assocTraitArgs)
    val otherStage = compiler.chainStageResultRef(baseRef: other, cont: hole).unwrap()
    assert(!compiler.typeRefEq(a: otherStage, b: result))
    match compiler.callArgumentConversion(sourceRef: otherStage, targetRef: result).unwrap() {
        ValueConversionProof.Missing => {}
        _ => { panic("chain conversion merged foreign nominal children") }
    }
}
