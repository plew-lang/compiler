use @Std/Io only { print }
trait Source {}
trait Target { assoc fn value() -> I64 }
impl Source as Target {
    assoc fn value(count: I64 = 5I64) -> I64 { return count }
}
struct S {}
impl S as Source {}
fn invoke[T](value: T) -> I64 where T: Target { return T.value() }
fn main() {
    print(S.value())
    print(invoke(value: <S />))
}
