use @Std/Io only { print }

trait Parent {
    type Key
    type Value
}
trait Final { type Item }
trait Other { type Item }
trait Bridge: Other[Item=Self#Final.Item] + Final {}
trait First: Parent[Key=Self#Other.Item] + Other {}
trait Second: Parent[Value=Bool] {}
trait Service: Bridge + Second + First + Final[Item=I64] {}
trait Ready { fn read() -> I64 }

struct Worker {}
impl Worker as Parent {
    type Key = I64
    type Value = Bool
}
impl Worker as Final { type Item=I64 }
impl Worker as Other { type Item=I64 }
impl Worker as Bridge {}
impl Worker as First {}
impl Worker as Second {}
impl Worker as Service {}

struct Box[T] {}
pub impl[T] Box[T] { factory }
impl[T] Box[T] as Ready where T: Parent[Key=I64, Value=Bool] {
    fn read() -> I64 { return 42I64 }
}

fn consume[T](value: T) -> I64 where T: Ready { return value.read() }
fn forwarding[T](value: T) -> I64 where T: Service { return consume(value: <Box[T] />) }
fn main() { print(forwarding(value: <Worker />)) }
