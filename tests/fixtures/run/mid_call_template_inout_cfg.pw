use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Mid only { MidBuildError, MidBuildState, MidTerminator, addMidLocal, buildMidBlock }

// A CallTemplate carries whether a selected argument is `inout`. Mid must turn
// that semantic ABI fact into an Inout borrow rather than silently retaining a
// Copy operand for a later backend to reinterpret.
fn main() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="inout-call-cfg.pw" text="fn sink(value: inout I64) {{}} fn probe(value: inout I64) {{ sink(value: inout value) }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    val function = c.arena.functionAt(index: owner)
    val parameter = c.funcParamAt(params: function.params, index: 0U64)
    val valueTerm = parameter.ty
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    addMidLocal(state: inout state, declarationTarget: parameter.nameStart, typeTerm: valueTerm, isUnique: false, isParameter: true, ownsAtEntry: false, isInout: true)
    val result = buildMidBlock(c: inout c, state: inout state, blockId: function.body)
    mut val isInoutBorrow: Bool = false
    match state.blocks[0U64].terminator {
        MidTerminator.NormalizedCall(callee: _, receiver: _, args: val args, destination: _, target: val target) => {
            if args.count() == 1U64 {
                val argument = args[0U64]
                isInoutBorrow = argument.tag == 4U64 && argument.capability == 2U64 && argument.rootTag == 1U64 && argument.local == 0U64 && argument.typeTerm == valueTerm && argument.projections.len == 0U64 && target == 1U64
            }
        }
        _ => {}
    }
    match result {
        MidBuildError.None => {
            if isInoutBorrow { write(s: "inout-borrow\n") } else { write(s: "wrong-inout\n") }
        }
        _ => { write(s: "build-error\n") }
    }
}
