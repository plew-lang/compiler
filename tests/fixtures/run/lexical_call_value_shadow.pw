use @Std/Io only { print as emit }
fn apply(print: fn(value: I64) -> I64) -> I64 {
    return print(value: 40I64)
}
fn choose() -> I64 { return 11I64 }
fn main() {
    emit(choose())
    val choose: fn() -> I64 = fn() -> I64 { return 42I64 }
    emit(choose())
    emit(apply(print: fn(value: I64) -> I64 { return value + 2I64 }))
    {
        val choose: fn() -> I64 = fn() -> I64 { return 43I64 }
        emit(choose())
    }
    emit(choose())
}
