use @Std/Io only { print }
fn subject(active: Bool) -> I64 {
    val unused: I64 = match { give if active { return 7I64 } else { give 0I64 } } { _ => 1I64 }
    return unused
}
fn casted(active: Bool) -> I64 {
    val unused = { give if active { return 8I64 } else { give 0I64 } } as I64
    return unused
}
fn main() {
    print(subject(active: true))
    print(casted(active: true))
}
