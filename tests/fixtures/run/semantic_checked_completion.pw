// Internal handoff: the final reader requires a completed owner and consumes
// its recorded flow, rather than recomputing from source syntax.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests, finalizeFrontendExecutables, spansEqual }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, Stmt, TypeInfo, CallSiteKey, CallTemplate, CallTemplateKind }
use @Std/Io only { print }

fn owner(compiler: inout Comp, name: String) -> U64 {
    val span = compiler.internBytes(s: name)
    mut val index = 0U64
    while index < compiler.arena.functionCount() {
        val declaration = compiler.arena.functionAt(index: index)
        if spansEqual(c: inout compiler, aStart: declaration.nameStart, aLen: declaration.nameLen, bStart: span.nameStart, bLen: span.nameLen) { return index }
        index += 1U64
    }
    panic "missing completion owner"
}

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="completion.pw" text="fn sample(flag: Bool) -> I64 {{ val value = if flag {{ give 1I64 }} else {{ return 2I64 }} return value }} fn stopped() -> I64 {{ return 9I64 }} fn loopValue() -> I64 {{ val value = {{ while true {{}} give 1I64 }} return value }} fn main() {{}}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val source = owner(compiler: inout compiler, name: "sample")
    val body = compiler.arena.functionAt(index: source).body
    val expression = match compiler.arena.stmts[compiler.blockStmtAt(blkId: body, index: 0U64)] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init) => init
        _ => { panic "missing completion expression" }
    }
    match compiler.checkedSemanticExprCompletion(exprId: expression) {
        Result.Ok(value: _) => { panic "unrequested owner supplied checked flow" }
        Result.Err(error: _) => {}
    }
    val statement = compiler.blockStmtAt(blkId: body, index: 0U64)
    match compiler.checkedSemanticStmtCompletion(stmtId: statement) {
        Result.Ok(value: _) => { panic "unrequested owner supplied statement flow" }
        Result.Err(error: _) => {}
    }
    compiler.prepareLexicalBody(fnIdx: source).unwrap()
    val preparedOwner = compiler.checkedSemanticStmtCompletionOwner(stmtId: statement).unwrap()
    if !compiler.semanticStmtCompletionInOwner(stmtId: statement, owner: preparedOwner).unwrap().source.normal() { panic "prepared reader lost statement flow" }
    val statementFlow = compiler.checkedSemanticStmtCompletion(stmtId: statement).unwrap()
    if !statementFlow.source.normal() || !statementFlow.source.returns() { panic "statement completion was not retained" }
    val originalStatement = compiler.arena.stmts[statement]
    compiler.arena.stmts.set(i: statement, value: <Stmt.Break offset=0U64 />)
    if compiler.stmtCompletion(stmtId: statement).source.normal() { panic "fixture did not change statement composition" }
    if !compiler.checkedSemanticStmtCompletion(stmtId: statement).unwrap().source.normal() { panic "checked statement reader reopened syntax" }
    compiler.arena.stmts.set(i: statement, value: originalStatement)
    val flow = compiler.checkedSemanticExprCompletion(exprId: expression).unwrap()
    if !flow.source.normal() || !flow.execution.normal() || !flow.source.returns() { panic "mixed completion was not retained" }
    compiler.recordSemanticExprInfo(exprId: expression, ti: <TypeInfo kind=0 nameStart=0U64 nameLen=0U64 ref=0U64 />)
    if !compiler.checkedSemanticExprCompletion(exprId: expression).unwrap().source.returns() { panic "type update erased completion" }
    val original = compiler.arena.exprs[expression]
    val stopped = owner(compiler: inout compiler, name: "stopped")
    compiler.prepareLexicalBody(fnIdx: stopped).unwrap()
    val otherStatement = compiler.blockStmtAt(blkId: compiler.arena.functionAt(index: stopped).body, index: 0U64)
    val otherOwner = compiler.checkedSemanticStmtCompletionOwner(stmtId: otherStatement).unwrap()
    match compiler.semanticStmtCompletionInOwner(stmtId: statement, owner: otherOwner) {
        Result.Ok(value: _) => { panic "prepared reader accepted another owner" }
        Result.Err(error: _) => {}
    }
    compiler.arena.exprs.set(i: expression, value: <Expr.Block body=compiler.arena.functionAt(index: stopped).body offset=0U64 />)
    if compiler.exprCompletion(exprId: expression).source.normal() { panic "fixture did not change source composition" }
    if !compiler.checkedSemanticExprCompletion(exprId: expression).unwrap().source.normal() { panic "checked reader reopened the AST" }
    compiler.arena.exprs.set(i: expression, value: original)
    val looping = owner(compiler: inout compiler, name: "loopValue")
    val loopBody = compiler.arena.functionAt(index: looping).body
    val loopExpression = match compiler.arena.stmts[compiler.blockStmtAt(blkId: loopBody, index: 0U64)] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init) => init
        _ => { panic "missing loop expression" }
    }
    compiler.prepareLexicalBody(fnIdx: looping).unwrap()
    val loopFlow = compiler.checkedSemanticExprCompletion(exprId: loopExpression).unwrap()
    if !loopFlow.source.normal() || loopFlow.execution.normal() { panic "source and execution completion were conflated" }
    // Exercise failed readiness through its actual producer, not an injected cache.
    mut val failed = <Comp />
    analyzeFrontendForRequests(c: inout failed,
        input: <FrontendInput.Text path="failed-completion.pw" text="fn rejected() {{ val retained = 0I64 val unresolved = [] }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val failedOwner = owner(compiler: inout failed, name: "rejected")
    val failedStatement = failed.blockStmtAt(blkId: failed.arena.functionAt(index: failedOwner).body, index: 0U64)
    val failure = match failed.prepareLexicalBody(fnIdx: failedOwner) {
        Result.Err(error: val diagnostic) => diagnostic
        Result.Ok(value: _) => { panic "invalid owner was prepared" }
    }
    match failed.prepareLexicalBody(fnIdx: failedOwner) {
        Result.Err(error: val diagnostic) => { if diagnostic.message != failure.message { panic "completed request was overwritten" } }
        Result.Ok(value: _) => { panic "retry replaced failed owner readiness" }
    }
    match failed.checkedSemanticStmtCompletion(stmtId: failedStatement) {
        Result.Err(error: val diagnostic) => { if diagnostic.message != failure.message { panic "statement reader lost owner diagnostic" } }
        Result.Ok(value: _) => { panic "failed owner supplied statement flow" }
    }
    mut val globals = <Comp />
    analyzeFrontendForRequests(c: inout globals,
        input: <FrontendInput.Text path="global-completion.pw" text="val value: I64 = if true {{ give 1I64 }} else {{ give 2I64 }} fn main() {{}}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val global = globals.arena.globals[0U64]
    val initializer = match globals.arena.stmts[global.letStmt] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init) => init
        _ => { panic "missing global expression" }
    }
    match globals.checkedSemanticExprCompletion(exprId: initializer) {
        Result.Ok(value: _) => { panic "global flow bypassed preparation" }
        Result.Err(error: _) => {}
    }
    globals.prepareGlobalInitializer(target: global.nameStart).unwrap()
    if !globals.checkedSemanticExprCompletion(exprId: initializer).unwrap().source.normal() { panic "global completion missing" }
    val count = globals.callTemplateCount()
    val globalCall = <CallTemplate siteKey=<CallSiteKey ownerFnIdx=18446744073709551615U64 originSerial=999U64 /> kind=<CallTemplateKind.Pending /> />
    if globals.appendCallTemplate(template: globalCall) { panic "unowned global call was added" }
    globals.cur.globalInitializerTarget = <Optional.Some v=global.nameStart />
    if globals.appendCallTemplate(template: globalCall) { panic "prepared global accepted a new call" }
    if globals.callTemplateCount() != count { panic "refused global append changed membership" }
    // Whole-build finalization must demand individual initializer readiness,
    // including source blocks introduced before concrete bodies exist.
    mut val whole = <Comp />
    analyzeFrontendForRequests(c: inout whole,
        input: <FrontendInput.Text path="whole-global.pw" text="val value: I64 = if true {{ give 1I64 }} else {{ give 2I64 }} fn main() {{}}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val target = whole.arena.globals[0U64].nameStart
    if whole.globalInitializerPrepared(target: target) { panic "admission published initializer readiness" }
    finalizeFrontendExecutables(c: inout whole).unwrap()
    if !whole.globalInitializerPrepared(target: target) { panic "whole build bypassed initializer preparation" }
    print("checked-completion")
}
