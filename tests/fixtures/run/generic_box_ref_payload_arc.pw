import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Box[T] {
    pub val v: T
}
pub impl Box { factory }

struct Outer {
    pub val b: Box[MutableRef[Cell]]
}
pub impl Outer { factory }

enum Wrap {
    Hold(b: Box[MutableRef[Cell]])
    Empty
}

fn holdStruct() {
    val o: Outer = <Outer b=<Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=1I32 /> /> /> />
    print("struct-scope-end")
}

fn holdEnum() {
    val w: Wrap = <Wrap.Hold b=<Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=2I32 /> /> /> />
    print("enum-scope-end")
}

fn main() {
    holdStruct()
    holdEnum()
    print("done")
}
