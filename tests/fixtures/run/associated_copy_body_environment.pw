use @Std/Core only { assert }
use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { TraitConstraint, TraitInstanceKey, ConformanceProofDemand }

fn main() {
    mut val compiler = <Comp />
    val source = "trait Source {{}} trait Target {{ assoc fn value() -> I64 }} impl Source as Target {{ assoc fn value() -> I64 {{ return 7I64 }} }} struct B {{}} struct A {{}} impl B as Source {{}} impl A as Source {{}} fn context(first: A, second: B) {{}}"
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="associated-copy.pw" text=source />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val context = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "context").nameId)
    val parameters = compiler.arena.functionAt(index: context).params
    val target = 1U64
    val constraint = <TraitConstraint key=<TraitInstanceKey owner=compiler.decls.traitAt(index: target).nameStart positionalArgs=[] /> assocPredicates=[] />
    mut val keys: Array[U64] = []
    mut val index = 0U64
    while index < parameters.count() {
        val receiver = compiler.funcParamAt(params: parameters, index: index).ty
        val proof = compiler.viewedTraitConstraintProof(demand: <ConformanceProofDemand.SourceAdmission />, ref: receiver, constraint: constraint).unwrap()
        val selected = compiler.proofConcreteWitness(proof: proof, receiverRef: receiver, traitIdx: target, reqIdx: 0U64).unwrap()
        assert(selected < compiler.arena.functionCount())
        val function = compiler.arena.functionAt(index: selected)
        assert(function.isProvided && function.isAssoc && !function.hasRecv)
        val environment = compiler.bodyInstanceEnvironment(fnIdx: selected, args: [], recvInstRef: receiver, selectedProof: proof).unwrap()
        assert(compiler.bodyReceiverMatchesDeclaration(function: function, environment: environment))
        val body = compiler.internBodyInstance(fnIdx: selected, environment: environment)
        for previous in keys { assert(previous != body) }
        keys.append(body)
        val foreign = compiler.funcParamAt(params: parameters, index: 1U64 - index).ty
        assert(compiler.proofConcreteWitness(proof: proof, receiverRef: foreign, traitIdx: target, reqIdx: 0U64).unwrap() == compiler.arena.functionCount())
        index += 1U64
    }
    assert(keys.count() == 2U64)
    print("associated-copy-body-environment")
}
