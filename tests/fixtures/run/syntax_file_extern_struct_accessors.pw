import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxExtern, syntaxExternStructCount, syntaxExternStructNameSpan, syntaxExternStructSpan, syntaxExternStructTypeParamCount, syntaxExternStructTypeParamSpan, syntaxExternStructTypeParamIsSendable, syntaxExternStructDirective, syntaxDirective, syntaxDirectiveReqCount, syntaxDirectiveReq, syntaxDeriveReq, ExternId }
import @Std/Io with { print }

fn main() {
    val source = "extern(plewIntrinsic) { @[Eq] struct Buffer[sendable T] }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val ext = syntaxExtern(file: file, id: <ExternId raw=syntaxTopItemPayload(file: file, item: item) />)
    val name = syntaxExternStructNameSpan(file: file, ext: ext, index: 0U64)
    val structSpan = syntaxExternStructSpan(file: file, ext: ext, index: 0U64)
    val typeParam = syntaxExternStructTypeParamSpan(file: file, ext: ext, structIndex: 0U64, index: 0U64)
    val directive = syntaxDirective(file: file, id: syntaxExternStructDirective(file: file, ext: ext, index: 0U64))
    val req = syntaxDeriveReq(file: file, id: syntaxDirectiveReq(file: file, directive: directive, index: 0U64))
    print(syntaxExternStructCount(file: file, ext: ext))
    print(name.end - name.start)
    print(structSpan.end - structSpan.start)
    print(syntaxExternStructTypeParamCount(file: file, ext: ext, index: 0U64))
    print(typeParam.end - typeParam.start)
    if syntaxExternStructTypeParamIsSendable(file: file, ext: ext, structIndex: 0U64, index: 0U64) { print(1U64) } else { print(0U64) }
    print(syntaxDirectiveReqCount(file: file, directive: directive))
    print(req.name.end - req.name.start)
}
