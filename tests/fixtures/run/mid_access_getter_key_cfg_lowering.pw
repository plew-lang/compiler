import @Std/Io with { print }
import @Std/Core with { Index, IndexSet }

// The outer indexed mutation has two independently selected getter inputs:
// its receiver is `rows[order[0]]`, while its key is a separate getter result
// `order[0]`.  Mid must freeze and materialize both recipes without reopening
// the source expression tree; only the receiver path participates in reverse
// writeback.
struct Counter { pub mut val n: I32 }
pub impl Counter { factory }
pub impl Counter {
    inout fn takeAndReset() -> I32 {
        val old: I32 = self.n
        self.n = 0I32
        return old
    }
}

fn resetOrdered(rows: inout Array[Array[Counter]], order: Array[U64]) -> I32 {
    return rows[order[0U64]][0U64].takeAndReset()
}

// A materialized getter key may own ARC storage, not just a scalar index.
struct KeyedCounter { pub mut val value: Counter }
pub impl KeyedCounter { factory }
pub impl KeyedCounter as Index[String] {
    type Output = Counter
    fn index(key: String) -> Counter { return self.value }
}
pub impl KeyedCounter as IndexSet[String] {
    type Value = Counter
    inout fn indexSet(key: String, value~: Counter) { self.value = value }
}
fn resetNamed(table: inout KeyedCounter, names: Array[String]) -> I32 {
    return table[names[0U64]].takeAndReset()
}

// Multiple expanded calls, a branch and a back edge must share the same
// body-relative layout, including stable homes for the materialized keys.
fn resetLoop(rows: inout Array[Array[Counter]], order: Array[U64]) -> I32 {
    mut val total: I32 = 0I32
    mut val index: U64 = 0U64
    while index < 2U64 {
        total += rows[order[0U64]][index].takeAndReset()
        if index == 0U64 {
            total += rows[order[0U64]][1U64].takeAndReset()
        }
        index += 1U64
    }
    return total
}

fn main() {
    mut val rows: Array[Array[Counter]] = []
    rows.append([<Counter n=7I32 />])
    print(resetOrdered(rows: inout rows, order: [0U64]))
    print(rows[0U64][0U64].n)
    mut val table = <KeyedCounter value=<Counter n=13I32 /> />
    print(resetNamed(table: inout table, names: ["named"]))
    print(table.value.n)
    mut val loopRows: Array[Array[Counter]] = [[<Counter n=2I32 />, <Counter n=3I32 />]]
    print(resetLoop(rows: inout loopRows, order: [0U64]))
    print(loopRows[0U64][0U64].n)
    print(loopRows[0U64][1U64].n)
}
