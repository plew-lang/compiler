use @Std/Io only { write }
use /Frontend only { Comp }
use /Ir only { TypeRef, InstanceEnvironment, SemanticTypeRecipe, EnumDef, Variant, FieldDef, CallSiteKey }
use /Mid only { MidBody, MidBlock, MidTerminator, MidLocalDecl, MidScope, MidOperand, MidPlace, MidInstantiateError, instantiateCanonicalMidBody }

fn carrier(compiler: inout Comp, name: String) -> U64 {
    val declaration = compiler.internBytes(s: name)
    val parameters = compiler.lowerTypeParamNames(names: ["T"], anchor: declaration.nameStart).unwrap()
    val parameter = parameters[0U64]
    val term = compiler.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen nameId=parameter.nameId paramId=parameter.paramId args=[] />)
    val payload = compiler.internBytes(s: "v")
    val some = compiler.internBytes(s: "Some")
    val none = compiler.internBytes(s: "None")
    val field = <FieldDef nameStart=payload.nameStart nameLen=payload.nameLen nameId=payload.nameId tyStart=parameter.nameStart tyLen=parameter.nameLen tyNameId=parameter.nameId tyIsArray=false ty=term isMut=false hasDefault=false defaultVal=0U64 />
    compiler.arena.registerEnum(<EnumDef nameStart=declaration.nameStart nameLen=declaration.nameLen nameId=declaration.nameId typeParams=parameters variants=[<Variant nameStart=some.nameStart nameLen=some.nameLen nameId=some.nameId fields=[field] />, <Variant nameStart=none.nameStart nameLen=none.nameLen nameId=none.nameId fields=[] />] defOffset=declaration.nameStart />)
    return declaration.nameStart
}

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    // Register nominal carriers through the same binder/declaration APIs as
    // lowering, while keeping this a Mid-only recipe/instance test.
    val optionalOwner = carrier(compiler: inout compiler, name: "Optional")
    val otherOwner = carrier(compiler: inout compiler, name: "Other")
    val noCallee = compiler.arena.functionCount()
    compiler.cur.bodyFnIdx = noCallee
    val firstName = compiler.internBytes(s: "First")
    val secondName = compiler.internBytes(s: "Second")
    val optionalName = compiler.internBytes(s: "Optional")
    val firstType = compiler.pushType(t: <TypeRef nameStart=firstName.nameStart nameLen=firstName.nameLen args=[] />)
    val secondType = compiler.pushType(t: <TypeRef nameStart=secondName.nameStart nameLen=secondName.nameLen args=[] />)
    val firstOptional = compiler.pushType(t: <TypeRef nameStart=optionalName.nameStart nameLen=optionalName.nameLen hasDecl=true declOffset=optionalOwner args=[firstType] />)
    val secondOptional = compiler.pushType(t: <TypeRef nameStart=optionalName.nameStart nameLen=optionalName.nameLen hasDecl=true declOffset=optionalOwner args=[secondType] />)
    val firstBody = compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment receiverRef=firstType />)
    val secondBody = compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment receiverRef=secondType />)
    compiler.cur.bodyId = firstBody
    val site = compiler.currentCallSiteKey(exprId: 0U64, siteIsStmt: true, slot: 2U64).unwrap()
    compiler.appendFinalCallee(exprId: 0U64, callee: noCallee, siteIsStmt: true, slot: 2U64, recvTypeRef: firstType, resultTypeRef: firstOptional).unwrap()
    compiler.cur.bodyId = secondBody
    compiler.appendFinalCallee(exprId: 0U64, callee: noCallee, siteIsStmt: true, slot: 2U64, recvTypeRef: secondType, resultTypeRef: secondOptional).unwrap()
    // A duplicate statement-owned call has no source expression to inspect.
    // Reject it through its retained site without dereferencing exprId zero.
    match compiler.appendFinalCallee(exprId: 0U64, callee: noCallee, siteIsStmt: true, slot: 2U64, recvTypeRef: secondType, resultTypeRef: secondOptional, generatedSite: site) {
        Result.Err(error: val error) => { if error.message != "final call occurrence is already published" { panic(error.message) } }
        Result.Ok(value: _) => { panic "duplicate call occurrence accepted" }
    }
    // Navigation is deliberately unrelated to the stored semantic call site.
    compiler.arena.semanticTypeRecipes.append(<SemanticTypeRecipe kind=2U64 exprId=999U64 siteIsStmt=true callSite=site />)
    compiler.arena.semanticTypeRecipes.append(<SemanticTypeRecipe kind=4U64 input=1U64 payloadOwner=optionalOwner />)
    // Frontend closes each dependency before Mid consumes the body facts.
    if compiler.groundSemanticTypeRecipeForBody(recipeId: 2U64, bodyId: firstBody, selfRef: firstType, itemRef: 0U64).unwrap() != firstType { panic "first recipe producer failed" }
    if compiler.groundSemanticTypeRecipeForBody(recipeId: 2U64, bodyId: secondBody, selfRef: secondType, itemRef: 0U64).unwrap() != secondType { panic "second recipe producer failed" }
    val source = compiler.mid.store(body: <MidBody locals=[<MidLocalDecl typeTerm=0U64 typeRecipe=2U64 sourceScope=0U64 isUnique=false isParameter=true />] scopes=[<MidScope firstLocal=0U64 localCount=1U64 />] blocks=[<MidBlock terminator=<MidTerminator.ReturnValue value=<MidOperand.Copy place=<MidPlace local=0U64 projections=[] typeTerm=0U64 typeRecipe=2U64 /> /> /> />] />)
    val sourceLocal = compiler.mid.bodies[source.body - 1U64].locals.start
    // Cursor points at the other instance during each instantiation.
    val first = instantiateCanonicalMidBody(c: inout compiler, body: source, bodyId: firstBody)
    match first.error { MidInstantiateError.None => {} _ => { panic "first instance failed" } }
    compiler.cur.bodyId = firstBody
    val second = instantiateCanonicalMidBody(c: inout compiler, body: source, bodyId: secondBody)
    match second.error { MidInstantiateError.None => {} _ => { panic "second instance failed" } }
    val block = compiler.mid.blocks[compiler.mid.bodies[first.body.body - 1U64].blocks.start]
    val terminator = compiler.mid.terminators[block.terminator - 1U64]
    val operand = compiler.mid.operands[terminator.value - 1U64]
    if compiler.mid.places[operand.place - 1U64].typeTerm != firstType || compiler.mid.places[operand.place - 1U64].typeRecipe != 0U64 { panic "place recipe not grounded" }
    val firstLocal = compiler.mid.bodies[first.body.body - 1U64].locals.start
    val secondLocal = compiler.mid.bodies[second.body.body - 1U64].locals.start
    if compiler.mid.locals[firstLocal].typeTerm != firstType || compiler.mid.locals[secondLocal].typeTerm != secondType { panic "instance result identity lost" }
    if compiler.mid.locals[firstLocal].typeRecipe != 0U64 || compiler.mid.locals[secondLocal].typeRecipe != 0U64 { panic "ground result retained recipe" }
    if compiler.mid.locals[sourceLocal].typeTerm != 0U64 || compiler.mid.locals[sourceLocal].typeRecipe != 2U64 { panic "source recipe mutated" }
    val missingBody = compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment />)
    // Even an available call dependency cannot replace an unpublished result.
    compiler.cur.bodyId = missingBody
    compiler.appendFinalCallee(exprId: 0U64, callee: noCallee, siteIsStmt: true, slot: 2U64, recvTypeRef: firstType, resultTypeRef: firstOptional).unwrap()
    val missing = instantiateCanonicalMidBody(c: inout compiler, body: source, bodyId: missingBody)
    match missing.error { MidInstantiateError.InvalidLocalResultType => {} _ => { panic "missing dependency accepted" } }
    // A same-spelled, same-arity result from another nominal carrier cannot
    // satisfy the selected payload recipe.
    val wrongOptional = compiler.pushType(t: <TypeRef nameStart=optionalName.nameStart nameLen=optionalName.nameLen hasDecl=true declOffset=otherOwner args=[firstType] />)
    val wrongBody = compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment receiverRef=wrongOptional />)
    if wrongBody == compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment receiverRef=firstOptional />) { panic "body key merged nominal carrier declarations" }
    compiler.cur.bodyId = wrongBody
    compiler.appendFinalCallee(exprId: 0U64, callee: noCallee, siteIsStmt: true, slot: 2U64, recvTypeRef: firstType, resultTypeRef: wrongOptional, generatedSite: site).unwrap()
    if compiler.groundSemanticTypeRecipeForBody(recipeId: 2U64, bodyId: wrongBody, selfRef: firstType, itemRef: 0U64).unwrap() != 0U64 { panic "wrong nominal carrier supplied payload" }
    val wrong = instantiateCanonicalMidBody(c: inout compiler, body: source, bodyId: wrongBody)
    match wrong.error { MidInstantiateError.InvalidLocalResultType => {} _ => { panic "wrong nominal carrier accepted" } }
    // A selected no-payload call is known Unit, not a missing result.
    val unitBody = compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment receiverRef=firstOptional />)
    compiler.cur.bodyId = unitBody
    compiler.appendFinalCallee(exprId: 0U64, callee: noCallee, siteIsStmt: true, slot: 2U64, recvTypeRef: firstType, resultTypeRef: 0U64, generatedSite: site).unwrap()
    if compiler.groundSemanticTypeRecipeForBody(recipeId: 1U64, bodyId: unitBody, selfRef: firstType, itemRef: 0U64).unwrap() != 0U64 { panic "Unit producer invented a value" }
    val unitSource = compiler.mid.store(body: <MidBody locals=[<MidLocalDecl typeTerm=0U64 typeRecipe=1U64 sourceScope=0U64 isUnique=false isParameter=false />] scopes=[<MidScope firstLocal=0U64 localCount=1U64 />] blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    val unit = instantiateCanonicalMidBody(c: inout compiler, body: unitSource, bodyId: unitBody)
    match unit.error { MidInstantiateError.None => {} _ => { panic "known Unit rejected" } }
    // A forged zero cannot replace the selected call's non-Unit result.
    compiler.arena.setBodyTypeRecipeResult(bodyId: missingBody, recipeId: 1U64, resultType: 0U64)
    val forged = instantiateCanonicalMidBody(c: inout compiler, body: unitSource, bodyId: missingBody)
    match forged.error { MidInstantiateError.InvalidLocalResultType => {} _ => { panic "non-Unit call accepted as Unit" } }
    val absentBody = compiler.internBodyInstance(fnIdx: noCallee, environment: <InstanceEnvironment receiverRef=secondOptional />)
    val absent = instantiateCanonicalMidBody(c: inout compiler, body: unitSource, bodyId: absentBody)
    match absent.error { MidInstantiateError.InvalidLocalResultType => {} _ => { panic "absent result accepted as Unit" } }
    // The same navigation anchor cannot replace a wrong semantic slot/owner.
    // The global owner is a maximum-value sentinel, not an incrementable index.
    val foreignOwner = if site.ownerFnIdx == 0U64 { give 1U64 } else { give 0U64 }
    val wrongSites = [
        <CallSiteKey ownerFnIdx=site.ownerFnIdx originKind=site.originKind originStart=site.originStart originEnd=site.originEnd originSerial=site.originSerial slot=site.slot + 1U64 />,
        <CallSiteKey ownerFnIdx=foreignOwner originKind=site.originKind originStart=site.originStart originEnd=site.originEnd originSerial=site.originSerial slot=site.slot />,
    ]
    for wrongSite in wrongSites {
        val recipe = compiler.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 exprId=999U64 siteIsStmt=true callSite=wrongSite />)
        if compiler.groundSemanticTypeRecipeForBody(recipeId: recipe, bodyId: firstBody, selfRef: firstType, itemRef: 0U64).unwrap() != 0U64 { panic "wrong semantic site borrowed a result" }
        val wrongSource = compiler.mid.store(body: <MidBody locals=[<MidLocalDecl typeTerm=0U64 typeRecipe=recipe sourceScope=0U64 isUnique=false isParameter=false />] scopes=[<MidScope firstLocal=0U64 localCount=1U64 />] blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
        val invalid = instantiateCanonicalMidBody(c: inout compiler, body: wrongSource, bodyId: firstBody)
        match invalid.error { MidInstantiateError.InvalidLocalResultType => {} _ => { panic "missing call site accepted as Unit" } }
    }
    checkTermRecipes(compiler: inout compiler, firstType: firstType, secondType: secondType, function: noCallee)
    write(s: "mid-type-recipe-instances-ok\n")
}

fn checkTermRecipes(compiler: inout Comp, firstType: U64, secondType: U64, function: U64) {
    val name = compiler.internBytes(s: "Parameter")
    val parameters = compiler.lowerTypeParamNames(names: ["Parameter"], anchor: name.nameStart).unwrap()
    val parameter = parameters[0U64]
    val term = compiler.pushType(t: <TypeRef nameStart=parameter.nameStart nameLen=parameter.nameLen nameId=parameter.nameId paramId=parameter.paramId args=[] />)
    val firstBody = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[firstType] />)
    val secondBody = compiler.internBodyInstance(fnIdx: function, environment: <InstanceEnvironment params=parameters args=[secondType] />)
    val recipe = compiler.semanticTypeRecipeTerm(term: term)
    if compiler.groundSemanticTypeRecipeForBody(recipeId: recipe, bodyId: firstBody, selfRef: 0U64, itemRef: 0U64).unwrap() != firstType { panic "Term recipe lost its first binding" }
    if compiler.groundSemanticTypeRecipeForBody(recipeId: recipe, bodyId: secondBody, selfRef: 0U64, itemRef: 0U64).unwrap() != secondType { panic "Term recipe lost its second binding" }
    val source = compiler.mid.store(body: <MidBody locals=[<MidLocalDecl typeTerm=0U64 typeRecipe=recipe sourceScope=0U64 isUnique=false isParameter=true />] scopes=[<MidScope firstLocal=0U64 localCount=1U64 />] blocks=[<MidBlock terminator=<MidTerminator.Return /> />] />)
    val bodies = [firstBody, secondBody]
    val types = [firstType, secondType]
    mut val index = 0U64
    while index < bodies.count() {
        compiler.cur.bodyId = bodies[1U64 - index]
        val instantiated = instantiateCanonicalMidBody(c: inout compiler, body: source, bodyId: bodies[index])
        match instantiated.error { MidInstantiateError.None => {} _ => { panic "Term recipe instance failed" } }
        val local = compiler.mid.bodies[instantiated.body.body - 1U64].locals.start
        if compiler.mid.locals[local].typeTerm != types[index] || compiler.mid.locals[local].typeRecipe != 0U64 { panic "Term recipe consumed another instance" }
        index += 1U64
    }
}
