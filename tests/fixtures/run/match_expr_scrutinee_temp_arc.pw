import @Std/Io with { print, write }
import @Std/Core with { MutableRef }

unique struct Cell {
    pub val v: I64
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Holder {
    pub val cell: MutableRef[Cell]
    pub val other: MutableRef[Cell]
}
pub impl Holder { factory }

fn makeOpt() -> Optional[Holder] {
    return <Optional.Some v=<Holder cell=<MutableRef value=<Cell v=77 /> /> other=<MutableRef value=<Cell v=88 /> /> /> />
}

fn main() {
    val r: Optional[MutableRef[Cell]] = match makeOpt() {
        Optional.Some(v: val h) => { give <Optional.Some v=h.cell /> }
        Optional.None => { give <Optional.None /> }
    }
    write(s: "bound\n")
    write(s: "end\n")
}
