use @Std/Io only { write }
use @Std/Core only { assert }
use /Frontend only { Comp }
use /Ir only { DeclarationBoundRef, ValueConversionProof, EnumPayloadConversion, StaticConformanceProof }

fn describe(proof: ValueConversionProof) {
    match proof {
        ValueConversionProof.ExistentialRetag(sourceRef: val source, targetRef: val target) => {
            if source == 71U64 && target == 72U64 { write(s: "retag\n") }
            else { write(s: "bad-retag\n") }
        }
        ValueConversionProof.Identity => { write(s: "identity\n") }
        ValueConversionProof.Missing => { write(s: "missing\n") }
        ValueConversionProof.ExistentialBox(sourceRef: val source, targetRef: val target, traitIdx: val traitIndex, proof: _) => {
            if source == 11U64 && target == 12U64 && traitIndex == 13U64 { write(s: "box\n") }
            else { write(s: "bad-box\n") }
        }
        ValueConversionProof.ArrayRepack(sourceRef: _, targetRef: _, element: val element) => {
            write(s: "array\n")
            describe(proof: element)
        }
        ValueConversionProof.EnumRepack(sourceRef: _, targetRef: _, enumIdx: _, argumentProofs: _, payloads: val payloads) => {
            write(s: "enum\n")
            for payload in payloads { describe(proof: payload.conversion) }
        }
    }
}

fn main() {
    mut val compiler: Comp = <Comp />
    val leaf: ValueConversionProof = <ValueConversionProof.ExistentialBox sourceRef=11U64 targetRef=12U64 traitIdx=13U64 proof=<StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=7U64 /> /> />
    val inner: ValueConversionProof = <ValueConversionProof.EnumRepack sourceRef=21U64 targetRef=22U64 enumIdx=23U64 argumentProofs=[leaf] payloads=[<EnumPayloadConversion sourceRef=31U64 targetRef=31U64 conversion=<ValueConversionProof.Identity /> />] />
    val tree: ValueConversionProof = <ValueConversionProof.EnumRepack sourceRef=41U64 targetRef=42U64 enumIdx=43U64 argumentProofs=[inner, leaf] payloads=[
        <EnumPayloadConversion sourceRef=21U64 targetRef=22U64 conversion=inner />,
        <EnumPayloadConversion sourceRef=51U64 targetRef=52U64 conversion=<ValueConversionProof.ArrayRepack sourceRef=51U64 targetRef=52U64 element=leaf /> />,
        <EnumPayloadConversion sourceRef=61U64 targetRef=62U64 conversion=<ValueConversionProof.Missing /> />,
        <EnumPayloadConversion sourceRef=71U64 targetRef=72U64 conversion=<ValueConversionProof.ExistentialRetag sourceRef=71U64 targetRef=72U64 /> />
    ] />
    // Nonempty pools, nested payload ranges, siblings, and stable older IDs.
    val prefix: U64 = compiler.freezeValueConversionProof(proof: <ValueConversionProof.Identity />)
    val first: U64 = compiler.freezeValueConversionProof(proof: tree)
    val second: U64 = compiler.freezeValueConversionProof(proof: tree)
    assert(compiler.sameValueConversionProof(a: tree, b: compiler.thawValueConversionProof(id: first)))
    assert(compiler.sameValueConversionProof(a: tree, b: compiler.thawValueConversionProof(id: second)))
    describe(proof: compiler.thawValueConversionProof(id: prefix))
    describe(proof: compiler.thawValueConversionProof(id: first))
    describe(proof: compiler.thawValueConversionProof(id: second))
}
