// Conditional conformance admission must retain the selected child evidence.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, DeclarationConversion, ValueConversionProof, StaticConformanceProof, WitnessMatch, WitnessBind, WitnessConditionPlan, InstanceEnvironment, StaticProofInstantiation }
use @Std/Io only { print }
use @Std/Core only { assert }
fn check(text: String, compatible: Bool, targetIndex: Bool = false, proofSubjectIndex: U64 = 0U64, rewrite: Bool = false, missingChild: Bool = false, message: String = "existential box evidence does not match its target trait instance") {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text text=text path="box-proof.pw" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.functionAt(index: 0U64)
    val source = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val yes = compiler.funcParamAt(params: function.params, index: 1U64).ty
    val no = compiler.funcParamAt(params: function.params, index: 2U64).ty
    val proofSubject = compiler.funcParamAt(params: function.params, index: proofSubjectIndex).ty
    val selected = compiler.callArgumentConversion(sourceRef: proofSubject, targetRef: yes, assumptions: compiler.functionBoundAssumptions(fnIdx: 0U64)).unwrap()
    mut val evidence = match selected {
        ValueConversionProof.ExistentialBox(sourceRef: _, targetRef: _, traitIdx: _, proof: val proof) => { give proof }
        _ => { panic("missing real conformance") }
    }
    val repeated = compiler.callArgumentConversion(sourceRef: proofSubject, targetRef: yes, assumptions: compiler.functionBoundAssumptions(fnIdx: 0U64)).unwrap()
    assert(compiler.sameValueConversionProof(a: selected, b: repeated))
    if missingChild {
        match evidence {
            StaticConformanceProof.ConcreteWitness(witness: val witness) => {
                val plan = compiler.arena.witnessConditionPlanAt(index: witness.conditions - 1U64)
                val conditionId = compiler.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=plan.witness proofs=[compiler.freezeStaticConformanceProof(proof: <StaticConformanceProof.Missing />)] />)
                evidence = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch selfRef=witness.selfRef conformIdx=witness.conformIdx binds=witness.binds conditions=conditionId /> />
            }
            _ => { panic("not concrete") }
        }
    }
    val replacement = compiler.funcParamAt(params: function.params, index: 4U64).ty
    val tampered = match evidence {
        StaticConformanceProof.ConcreteWitness(witness: val witness) => {
            give if rewrite { give <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=witness.conformIdx binds=[<WitnessBind binder=witness.binds[0U64].binder paramId=witness.binds[0U64].paramId term=replacement />] selfRef=source conditions=witness.conditions /> /> }
            else { give evidence }
        }
        _ => { panic("not concrete") }
    }
    val sourceParameter = compiler.funcParamAt(params: function.params, index: 0U64)
    val expression = compiler.pushExpr(e: <Expr.Ident start=sourceParameter.nameStart len=sourceParameter.nameLen />)
    compiler.cur.checkFn = 0U64
    compiler.addLocalCn(nameStart: sourceParameter.nameStart, nameLen: sourceParameter.nameLen, tyStart: sourceParameter.tyStart, tyLen: sourceParameter.tyLen, isArray: sourceParameter.tyIsArray, ty: source, isInout: false, isMut: false, owned: false, cnum: 0U64)
    compiler.recordExpr(exprId: expression).unwrap()
    compiler.cur.recordCallTemplates = true
    compiler.recordDeclarationConversion(exprId: expression, target: no).unwrap()
    val original = compiler.decls.declarationConversions[0U64]
    val proof = compiler.freezeValueConversionProof(proof: <ValueConversionProof.ExistentialBox sourceRef=source targetRef=no traitIdx=compiler.recordAnyTraitIndex(anyRef: (if targetIndex { give no } else { give yes })) proof=tampered />)
    compiler.decls.declarationConversions[0U64] = <DeclarationConversion site=original.site source=source target=no proof=proof />
    match compiler.prepareLexicalBody(fnIdx: 0U64) {
        Result.Ok(value: _) => { if !compatible { panic("owner accepted invalid box evidence") } }
        Result.Err(error: val diagnostic) => { if compatible || diagnostic.message != message { panic(diagnostic.message) } }
    }
    match compiler.checkRecordedMemberObligations() {
        Result.Ok(value: _) => { if !compatible { panic("whole target accepted invalid box evidence") } }
        Result.Err(error: val diagnostic) => { if compatible || diagnostic.message != message { panic(diagnostic.message) } }
    }
}
// A closed parent must not hide a condition whose positional argument is still symbolic.
fn checkDeferredChild() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text text="trait P {{}} trait Q[V] {{}} struct A {{}} impl A as Q[I64] {{}} struct Wrap[T] {{}} impl[T] Wrap[T] as P where T: Q[I64] {{}} fn probe(source: Wrap[A], target: any P) {{}} fn unresolved[U]() where A: Q[U] {{}}" path="condition-closure.pw" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.functionAt(index: 0U64)
    val source = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val target = compiler.funcParamAt(params: function.params, index: 1U64).ty
    val selected = compiler.callArgumentConversion(sourceRef: source, targetRef: target).unwrap()
    mut val evidence = match selected {
        ValueConversionProof.ExistentialBox(sourceRef: _, targetRef: _, traitIdx: _, proof: val proof) => { give proof }
        _ => { panic("missing conditional proof") }
    }
    match compiler.instantiateStaticMemberProof(proof: evidence, receiverRef: source, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64).unwrap() {
        StaticProofInstantiation.Ready(proof: _) => {}
        _ => { panic("closed condition was not ready") }
    }
    val bound = compiler.functionBoundAssumptions(fnIdx: 1U64)[0U64]
    match evidence {
        StaticConformanceProof.ConcreteWitness(witness: val witness) => {
            val plan = compiler.arena.witnessConditionPlanAt(index: witness.conditions - 1U64)
            val conditionId = compiler.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=plan.witness proofs=[compiler.freezeStaticConformanceProof(proof: <StaticConformanceProof.AssumedBound source=bound />)] />)
                evidence = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch selfRef=witness.selfRef conformIdx=witness.conformIdx binds=witness.binds conditions=conditionId /> />
        }
        _ => { panic("not a direct witness") }
    }
    match compiler.instantiateStaticMemberProof(proof: evidence, receiverRef: source, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64).unwrap() {
        StaticProofInstantiation.Deferred => {}
        _ => { panic("closed parent hid deferred child evidence") }
    }
}
fn main() {
    checkDeferredChild()
    check(text: "trait P {{}} trait Q {{}} struct A {{}} struct B {{}} impl A as Q {{}} struct Wrap[T] {{}} impl[T] Wrap[T] as P where T: Q {{}} fn probe(source: Wrap[A], yes: any P, no: any P, proofSubject: Wrap[A], replacement: B) {{}}", compatible: true)
    check(text: "trait P {{}} trait Q {{}} struct A {{}} struct B {{}} impl A as Q {{}} struct Wrap[T] {{}} impl[T] Wrap[T] as P where T: Q {{}} fn probe(source: Wrap[B], yes: any P, no: any P, proofSubject: Wrap[A], replacement: B) {{}}", compatible: false, proofSubjectIndex: 3U64, rewrite: true, message: "selected conformance evidence does not satisfy its declaration conditions")
    check(text: "trait P {{}} trait Q {{}} struct B {{}} struct Wrap[T] {{}} impl[T] Wrap[T] as P where T: Q {{}} fn probe[T](source: Wrap[T], yes: any P, no: any P, proofSubject: Wrap[T], replacement: B) where T: Q {{}}", compatible: true)
    check(text: "trait P {{}} trait Q {{}} trait Required {{}} struct A {{}} impl A as Required {{}} struct B {{}} struct Source[T] {{}} impl[T] Source[T] as Q where T: Required {{}} struct Wrap[T] {{}} impl[T] Wrap[T] as P where T: Q {{}} fn probe(source: Wrap[Source[A]], yes: any P, no: any P, proofSubject: Wrap[Source[A]], replacement: B) {{}}", compatible: true)
    check(text: "trait P {{}} trait Q {{}} struct A {{}} struct B {{}} impl A as Q {{}} struct Wrap[T] {{}} impl[T] Wrap[T] as P where T: Q {{}} fn probe(source: Wrap[A], yes: any P, no: any P, proofSubject: Wrap[A], replacement: B) {{}}", compatible: false, missingChild: true, message: "selected conformance evidence does not satisfy its declaration conditions")
    print("conditional-witness-owner-evidence")
}
