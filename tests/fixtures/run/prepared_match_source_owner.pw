use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { MatchSource, InstanceEnvironment, Stmt }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="patterns.pw" text="enum Outcome {{ Ready(value: I64) Empty }} fn probe(value: Outcome) {{ match value {{ Outcome.Ready(val value) => {{}} Outcome.Empty => {{}} }} }} fn unrelated() {{}} val first = match <Outcome.Empty /> {{ Outcome.Ready(val value) => {{ give value }} Outcome.Empty => {{ give 1I64 }} }} val second: I64 = 2I64 val callback = fn(value: Outcome) -> I64 {{ match value {{ Outcome.Ready(val value) => {{ return value }} Outcome.Empty => {{ return 1I64 }} }} }}" />,
        sources: <SourceAccess />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val other = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "unrelated").nameId)
    val statement = compiler.blockStmtAt(blkId: compiler.arena.functionAt(index: owner).body, index: 0U64)
    val key = <MatchSource.Statement stmtId=statement />
    val body = compiler.internBodyInstance(fnIdx: owner, environment: <InstanceEnvironment />)
    match compiler.preparedBodyMatch(bodyId: body, matchSource: key) {
        Result.Err(error: _) => {}
        _ => { panic("unprepared match admitted") }
    }
    compiler.prepareLexicalBody(fnIdx: owner).unwrap()
    compiler.prepareLexicalBody(fnIdx: other).unwrap()
    val facts = compiler.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    val pattern = facts.pattern(ownerFnIdx: owner, matchSource: key).unwrap()
    if pattern.arms.count() != 2U64 { panic("match arms lost") }
    if compiler.preparedBodyMatch(bodyId: body, matchSource: key).unwrap().unwrap().scrutineeTerm != pattern.scrutineeTerm { panic("concrete consumer lost source match") }
    val foreign = compiler.preparedFunctionSemanticFacts(fnIdx: other).unwrap()
    match foreign.pattern(ownerFnIdx: owner, matchSource: key) {
        Optional.None => {}
        _ => { panic("foreign match admitted") }
    }
    match facts.pattern(ownerFnIdx: owner, matchSource: <MatchSource.Statement stmtId=18446744073709551615U64 />) {
        Optional.None => {}
        _ => { panic("missing match admitted") }
    }
    match compiler.recordStmt(stmtId: statement) {
        Result.Err(error: _) => {}
        _ => { panic("completed match recorded again") }
    }
    val global = compiler.arena.globals[0U64]
    val otherGlobal = compiler.arena.globals[1U64]
    compiler.prepareGlobalInitializer(target: global.nameStart).unwrap()
    compiler.prepareGlobalInitializer(target: otherGlobal.nameStart).unwrap()
    val initializer = match compiler.arena.stmts[global.letStmt] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val expression) => expression
        _ => { panic("missing global initializer") }
    }
    val globalKey = <MatchSource.Expression exprId=initializer />
    val globalBody = compiler.internBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
    if !compiler.preparedBodyMatch(bodyId: globalBody, matchSource: globalKey, globalInitializerTarget: <Optional.Some v=global.nameStart />).unwrap().isSome() { panic("global match missing") }
    if compiler.preparedBodyMatch(bodyId: globalBody, matchSource: globalKey, globalInitializerTarget: <Optional.Some v=otherGlobal.nameStart />).unwrap().isSome() { panic("foreign global match admitted") }
    if !compiler.preparedDeclarationMatch(sourceFunction: 18446744073709551615U64, matchSource: globalKey).unwrap().isSome() { panic("composite global declaration match missing") }
    val callback = compiler.arena.globals[2U64]
    compiler.prepareGlobalInitializer(target: callback.nameStart).unwrap()
    val closure = compiler.preparedSemanticClosureAt(index: 0U64).unwrap()
    val closureStatement = compiler.blockStmtAt(blkId: closure.bodyBlock, index: 0U64)
    val closureKey = <MatchSource.Statement stmtId=closureStatement />
    val closureBody = compiler.internBodyInstance(fnIdx: closure.bodyKey, environment: <InstanceEnvironment />)
    if !compiler.preparedBodyMatch(bodyId: closureBody, matchSource: closureKey).unwrap().isSome() { panic("global closure match missing") }
    if !compiler.preparedDeclarationMatch(sourceFunction: closure.bodyKey, matchSource: closureKey).unwrap().isSome() { panic("global closure declaration match missing") }
    print("ok")
}
