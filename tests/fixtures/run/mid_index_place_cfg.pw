// An Array index is a first-class Mid place, not an invitation for LLVM to
// reopen the source AST.  Its index is the already-evaluated local identity,
// which makes the evaluation order of `items[index]` explicit in the CFG.
use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Mid only { MidBuildError, MidBuildState, MidOperand, MidProjection, MidRvalue, MidStatement, addMidLocal, buildMidLet }

fn main() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="index-cfg.pw" text="trait Index[Key] {{ type Output fn index(key: Key) -> Output }} struct Array[T] {{}} impl[T] Array[T] as Index[U64] {{ type Output = T fn index(key: U64) -> T {{ panic(\"unused\") }} }} fn probe(items: Array[I64], index: U64) {{ val selected: I64 = items[index] }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    // Supply the isolated language/core declarations with their actual module identity.
    val module = c.moduleOf(offset: c.arena.structAt(index: 0U64).defOffset)
    c.modules.langModule = module
    c.modules.coreModule = module
    c.buildKwCache()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    val function = c.arena.functionAt(index: owner)
    val itemsParameter = c.funcParamAt(params: function.params, index: 0U64)
    val indexParameter = c.funcParamAt(params: function.params, index: 1U64)
    val arrayTerm = itemsParameter.ty
    val indexTerm = indexParameter.ty
    val integerTerm = c.arena.typeAt(index: arrayTerm).args[0U64]
    val bindingStatement = c.blockStmtAt(blkId: function.body, index: 0U64)
    match c.prepareLexicalBody(fnIdx: owner) { Result.Ok(value: _) => {} Result.Err(error: val diagnostic) => { panic(diagnostic.message) } }
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val items = addMidLocal(state: inout state, declarationTarget: itemsParameter.nameStart, typeTerm: arrayTerm, isUnique: false, isParameter: true, ownsAtEntry: true)
    val index = addMidLocal(state: inout state, declarationTarget: indexParameter.nameStart, typeTerm: indexTerm, isUnique: false, isParameter: true, ownsAtEntry: true)
    val result = buildMidLet(c: inout c, state: inout state, stmtId: bindingStatement)

    mut val correctPlace: Bool = false
    mut val statementIndex = 0U64
    while statementIndex < state.blocks[0U64].statements.count() {
        match state.blocks[0U64].statements[statementIndex] {
            MidStatement.Assign(destination: val destination, value: val value) => {
                match value {
                    MidRvalue.StorageBoundary(stmtId: val statement, targetTerm: val target, operand: val operand) => {
                        match operand {
                            MidOperand.Copy(place: val place) => {
                                if statement == bindingStatement && c.typeRefEq(a: target, b: integerTerm) && destination.local == 2U64 && place.local == items && c.typeRefEq(a: place.typeTerm, b: integerTerm) && place.projections.count() == 1U64 {
                                    match place.projections[0U64] {
                                        MidProjection.Index(indexLocal: val indexLocal, typeTerm: val typeTerm) => {
                                            correctPlace = indexLocal == index && c.typeRefEq(a: typeTerm, b: integerTerm)
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        statementIndex += 1U64
    }
    match result {
        MidBuildError.None => {
            if correctPlace { write(s: "index-place\n") } else { write(s: "wrong-place\n") }
        }
        _ => { write(s: "build-error\n") }
    }
}
