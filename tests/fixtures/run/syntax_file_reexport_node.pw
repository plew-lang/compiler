import @Plew/Syntax with { Lexer, P, ImportId, SyntaxTopItemKind, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxImport, syntaxImportNameCount, syntaxTopItemKind, syntaxTopItemPayload }
import @Std/Io with { print }

fn main() {
    // A re-export at byte offset zero exercises the explicit start-presence
    // contract in the direct parser; offset zero is a valid source location,
    // not an omitted start argument.
    val source = "export ./Child with { Foo as Bar }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    match syntaxTopItemKind(file: file, item: item) {
        SyntaxTopItemKind.ReExport => { print(1U64) }
        _ => { print(0U64) }
    }
    val imp = syntaxImport(file: file, id: <ImportId raw=syntaxTopItemPayload(file: file, item: item) />)
    print(imp.isImport)
    print(imp.path.end - imp.path.start)
    print(syntaxImportNameCount(file: file, imp: imp))
}
