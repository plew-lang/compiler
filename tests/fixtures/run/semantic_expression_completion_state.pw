use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { Expr, Stmt, SemanticExpressionTypeState }

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val integerName = compiler.internBytes(s: "I64")
    val integer = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=integerName.nameStart tyLen=integerName.nameLen isNeg=false />)
    val condition = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=true tyStart=0U64 tyLen=0U64 isNeg=false />)
    val returning = compiler.pushBlock(stmts: [compiler.pushStmt(s: <Stmt.Return value=0U64 hasValue=false offset=0U64 />)])
    val yielding = compiler.pushBlock(stmts: [compiler.pushStmt(s: <Stmt.Give value=integer />)])
    val block = compiler.pushExpr(e: <Expr.Block body=returning offset=0U64 />)
    compiler.recordExpr(exprId: block, needsValue: false).unwrap()
    match compiler.arena.semanticExprTypes[block].typeState {
        SemanticExpressionTypeState.NoNormalValue => {}
        _ => { panic "returning block has a normal value" }
    }
    val mixed = compiler.pushExpr(e: <Expr.IfExpr cond=condition thenBlk=returning elseBlk=yielding />)
    compiler.recordExpr(exprId: mixed).unwrap()
    match compiler.arena.semanticExprTypes[mixed].typeState {
        SemanticExpressionTypeState.Value => {}
        _ => { panic "one divergent branch erased the normal result" }
    }
    val reversed = compiler.pushExpr(e: <Expr.IfExpr cond=condition thenBlk=yielding elseBlk=returning />)
    compiler.recordExpr(exprId: reversed).unwrap()
    if !compiler.typeRefEq(a: compiler.semanticExprTerm(exprId: mixed), b: compiler.semanticExprTerm(exprId: reversed)) { panic "branch order changed the result" }
    val allReturning = compiler.pushExpr(e: <Expr.IfExpr cond=condition thenBlk=returning elseBlk=returning />)
    compiler.recordExpr(exprId: allReturning, needsValue: false).unwrap()
    match compiler.arena.semanticExprTypes[allReturning].typeState {
        SemanticExpressionTypeState.NoNormalValue => {}
        _ => { panic "all divergent branches have a normal value" }
    }
    val loopBody = compiler.pushBlock(stmts: [])
    val looping = compiler.pushStmt(s: <Stmt.While cond=condition body=loopBody />)
    val afterLoop = compiler.pushBlock(stmts: [looping, compiler.pushStmt(s: <Stmt.Give value=integer />)])
    val loopingBlock = compiler.pushExpr(e: <Expr.Block body=afterLoop offset=0U64 />)
    compiler.recordExpr(exprId: loopingBlock).unwrap()
    match compiler.arena.semanticExprTypes[loopingBlock].typeState {
        SemanticExpressionTypeState.Value => {}
        _ => { panic "execution non-continuation became source divergence" }
    }
    print("semantic-expression-completion-state")
}
