use @Std/Core only { assert }
use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { TypeRef }

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internBytes(s: "Nominal")
    val plain = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=true declOffset=100U64 />)
    val duplicate = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=true declOffset=100U64 viewIds=[7U64, 7U64] />)
    val single = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=true declOffset=100U64 viewIds=[7U64] />)
    val other = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=true declOffset=101U64 />)
    assert(compiler.typesCompatible(expected: plain, inferred: plain).unwrap())
    assert(compiler.typesCompatible(expected: duplicate, inferred: single).unwrap())
    assert(compiler.typesCompatible(expected: single, inferred: duplicate).unwrap())
    assert(!compiler.typesCompatible(expected: plain, inferred: single).unwrap())
    assert(!compiler.typesCompatible(expected: plain, inferred: other).unwrap())
    val record = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=[1U64, 2U64] recordFieldTerms=[plain, single] />)
    val recordEquivalent = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=[1U64, 2U64] recordFieldTerms=[plain, duplicate] />)
    val recordDifferent = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=[1U64, 3U64] recordFieldTerms=[plain, single] />)
    val malformed = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] isRecord=true recordFieldLabels=[1U64] recordFieldTerms=[plain, single] />)
    assert(compiler.typesCompatible(expected: record, inferred: recordEquivalent).unwrap())
    assert(!compiler.typesCompatible(expected: record, inferred: recordDifferent).unwrap())
    assert(!compiler.typesCompatible(expected: record, inferred: malformed).unwrap())
    // Missing terms are not a proof, even when both sides are missing.
    assert(compiler.typeCompatibility(expected: 0U64, inferred: plain).unwrap().isUnresolved())
    assert(compiler.typeCompatibility(expected: 0U64, inferred: 0U64).unwrap().isUnresolved())
    assert(!compiler.typesCompatible(expected: 0U64, inferred: plain).unwrap())
    assert(compiler.typeCompatibility(expected: 999999U64, inferred: plain).unwrap().isUnresolved())
    val parameter = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] paramId=1U64 />)
    val otherParameter = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] paramId=2U64 />)
    assert(compiler.typesCompatible(expected: parameter, inferred: parameter).unwrap())
    assert(!compiler.typesCompatible(expected: parameter, inferred: otherParameter).unwrap())
    val applied = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[plain] hasDecl=true declOffset=100U64 />)
    assert(!compiler.typesCompatible(expected: plain, inferred: applied).unwrap())
    val fnName = compiler.internBytes(s: "fn")
    val unitFn = compiler.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=[0U64] argLabels=[0U64] />)
    assert(compiler.typesCompatible(expected: unitFn, inferred: unitFn).unwrap())
    val valueFn = compiler.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=[plain] argLabels=[0U64] />)
    val unitMismatch = compiler.typeCompatibility(expected: unitFn, inferred: valueFn).unwrap()
    assert(!unitMismatch.isCompatible())
    assert(!unitMismatch.isUnresolved())
    val reverseUnitMismatch = compiler.typeCompatibility(expected: valueFn, inferred: unitFn).unwrap()
    assert(!reverseUnitMismatch.isCompatible())
    assert(!reverseUnitMismatch.isUnresolved())
    val unknownFn = compiler.pushType(t: <TypeRef nameStart=fnName.nameStart nameLen=fnName.nameLen args=[0U64, 0U64] argLabels=[0U64, 0U64] />)
    assert(compiler.typeCompatibility(expected: unknownFn, inferred: unknownFn).unwrap().isUnresolved())
    print("ok")
}
