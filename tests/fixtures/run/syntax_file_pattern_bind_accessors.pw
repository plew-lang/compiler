import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxStmtMatchArm, syntaxMatchArm, syntaxPattern, syntaxPatternBindCount, syntaxPatternBind, syntaxBind, DeclId }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { match value { Pair { val left } => {} } }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))
    val arm = syntaxMatchArm(file: file, id: syntaxStmtMatchArm(file: file, stmt: stmt, index: 0U64))
    val pattern = syntaxPattern(file: file, id: arm.pat)
    val bind = syntaxBind(file: file, id: syntaxPatternBind(file: file, pattern: pattern, index: 0U64))
    if pattern.isStruct { print(1U64) } else { print(0U64) }
    print(syntaxPatternBindCount(file: file, pattern: pattern))
    print(bind.field.end - bind.field.start)
    print(bind.name.end - bind.name.start)
}
