import @Std/Core with { assert }
import @Std/Io with { print }
import /Frontend with { Comp, FrontendInput, analyzeFrontendDeclarations }
import /SourceAccess with { SourceAccess }
fn main() {
    val cases = [
        "trait Parser { type Output }\nfn bad[T](value: T#Parser.Missing) where T: Parser {}\n",
        "trait Parser { type Output }\nfn bad[T](value: Array[T#Parser.Missing]) where T: Parser {}\n",
        "trait Parser { type Output }\nfn bad[T](value: T) -> T#Parser.Missing where T: Parser { panic(\"unused\") }\n"
    ]
    for val source in cases {
        mut val c = <Comp />
        match analyzeFrontendDeclarations(c: inout c, input: <FrontendInput.Text text=source path="projection.pw" />, sources: <SourceAccess stdRoot=[] />) {
            Result.Ok(value: _) => { assert(false) }
            Result.Err(error: val diagnostic) => { assert(diagnostic.message == "associated-type projection names an associated type that is not bound by the selected conformance (spec/08)") }
        }
        assert(c.monoWork.bodyCount() == 0U64)
    }
    mut val valid = <Comp />
    analyzeFrontendDeclarations(c: inout valid, input: <FrontendInput.Text text="trait Parser { type Output }\nfn valid[T](value: T#Parser.Output) where T: Parser {}\n" path="valid.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    assert(valid.monoWork.bodyCount() == 0U64)
    print("ok")
}
