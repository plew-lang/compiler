use @Std/Io only { print }

struct Pair[First, Second] { val first: First val second: Second }
impl[First, Second] Pair[First, Second] { factory }
impl[A, B] Pair[B, A] {
    assoc fn made(first: B, second: A) -> Self {
        return <Pair[B, A] first=first second=second />
    }
    assoc fn marked[Marker](first: B, second: A, marker: Marker) -> Self {
        return <Pair[B, A] first=first second=second />
    }
}
struct Envelope[T] { val value: T }
impl[T] Envelope[T] { factory }
impl[T] Envelope[Array[T]] {
    assoc fn made(value: Array[T]) -> Self { return <Envelope[Array[T]] value=value /> }
}
fn main() {
    val direct: Pair[U8, I16] = Pair.made(first: 250, second: -300)
    val block: Pair[U8, I16] = { give Pair.made(first: 249, second: -301) }
    val branch: Pair[U8, I16] = if true {
        give Pair.made(first: 248, second: -302)
    } else {
        give Pair.made(first: 247, second: -303)
    }
    val marked: Pair[U8, I16] = Pair.marked(first: 246, second: -304, marker: true)
    val nested: Envelope[Array[U8]] = Envelope.made(value: [245])
    print(direct.first)
    print(direct.second)
    print(block.first)
    print(block.second)
    print(branch.first)
    print(branch.second)
    print(marked.first)
    print(marked.second)
    print(nested.value[0U64])
}
