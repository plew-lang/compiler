use @Std/Io only { print }
struct Counter { val n: I64 }
impl Counter { fn get() -> I64 { return 0I64 } }
extension Read { impl Counter { fn get() -> I64 { return self.n } } }
extension Other { impl Counter { fn get() -> I64 { return 99I64 } } }
struct Slot[T, U] { val item: T val other: U }
impl[T, U] Slot[T, U] { fn read() -> T { return self.item } }
fn take[T, U](value: Slot[T, U]) -> T { return value.item }
fn useBoth(value: Slot[Counter#Read, Counter#Other]) {
    print(take(value: value).get())
    print(value.read().get())
}
trait Selection { type Output }
struct Choice {}
impl Choice as Selection { type Output = Slot[Counter#Read, Counter#Other] }
struct Holder {
    val pair: Slot[Counter#Other, Counter#Read]
}
fn makePair() -> Slot[Counter#Read, Counter#Other] {
    return <Slot[Counter#Read, Counter#Other] item=<Counter n=42I64 />#Read other=<Counter n=8I64 />#Other />
}
newtype Wrapped = Slot[Counter#Read, Counter#Other]
trait PairSource {
    fn pair() -> Slot[Counter#Other, Counter#Read]
}
pub impl PairSource {
    fn providedPair() -> Slot[Counter#Read, Counter#Other] { return makePair() }
}
struct PairMaker {}
impl PairMaker as PairSource {
    fn pair() -> Slot[Counter#Other, Counter#Read] {
        return <Slot[Counter#Other, Counter#Read] item=<Counter n=8I64 />#Other other=<Counter n=42I64 />#Read />
    }
}
fn useSource[T](source: T) where T: PairSource {
    val pair = source.pair()
    print(take(value: pair).get())
    print(take(value: source.providedPair()).get())
}
fn main() {
    useSource(source: <PairMaker />)
    val inferred = <Slot item=<Counter n=42I64 />#Read other=<Counter n=8I64 />#Other />
    val holder = <Holder pair=<Slot[Counter#Other, Counter#Read] item=<Counter n=8I64 />#Other other=<Counter n=42I64 />#Read /> />
    print(take(value: holder.pair).get())
    val returned = makePair()
    print(take(value: returned).get())
    val alias = inferred
    val inferredReverse = <Slot other=<Counter n=42I64 />#Read item=<Counter n=8I64 />#Other />
    print(take(value: inferredReverse).get())
    val wrapped = <Wrapped item=<Counter n=42I64 />#Read other=<Counter n=8I64 />#Other />
    print(take(value: wrapped as Slot[Counter#Read, Counter#Other]).get())
    val projected: Choice#Selection.Output = inferred
    print(inferred.read().get())
    print(take(value: alias).get())
    print(take(value: projected).get())
    print(take(value: <Slot[Counter#Other, Counter#Read] item=<Counter n=8I64 />#Other other=<Counter n=42I64 />#Read />).get())
}
