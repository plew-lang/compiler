use @Std/Core only { Format, FormatOptions, TextOutput, Infallible }
use @Std/Io only { print }
struct Options { val prefix: String }
impl Options as FormatOptions {
    factory() {
        print("default options")
        return <Options prefix="default:" />
    }
}
struct Item { val name: String }
impl Item {
    fn format[Output](output: inout Output, options: Bool) -> String where Output: TextOutput {
        return "inherent"
    }
}
impl Item as Format {
    type Options = Options
    fn format[Output](output: inout Output, options: Options) -> Result[(), Output.Error] where Output: TextOutput {
        try output.write(options.prefix)
        return output.write(self.name)
    }
}
struct Fragments { mut val values: Array[String] }
impl Fragments as TextOutput {
    type Error = Infallible
    inout fn write(text~: String) -> Result[(), Infallible] {
        self.values.append(text)
        return <Result.Ok value=() />
    }
}
fn emit[T, Output](value: T, output: inout Output, options: T.Options) -> Result[(), Output.Error] where T: Format, Output: TextOutput {
    return value.format(output: inout output, options: options)
}
fn main() {
    val item = <Item name="item" />
    print(<String value=item />)
    print(<String value=item />)
    print(<String value=item options=<Options prefix="custom:" /> />)
    mut val fragments = <Fragments values=[] />
    emit(value: item, output: inout fragments, options: <Options prefix="kept:" />).value()
    print(fragments.values.count())
    for val text in fragments.values { print(text) }
}
