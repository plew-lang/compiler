use @Std/Core only { Index }
use @Std/Io only { print }
struct Shelf { pub val item: I64 }
pub impl Shelf { factory }
pub impl Shelf as Index[U64] {
    type Output = I64
    fn index(key: U64) -> I64 { return self.item }
}
fn main() {
    val shelf: any Index[U64, Output=I64] = <Shelf item=11I64 />
    print(shelf[0U64])
}
