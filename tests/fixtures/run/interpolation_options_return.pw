use @Std/Io only { print }
fn block(active: Bool) -> String { return "prefix{1I64: if active { return "block" } else { give </> }}" }
fn branch(flag: Bool, active: Bool) -> String { return "prefix{1I64: if active { if flag { return "then" } else { return "else" } } else { give </> }}" }
fn arm(flag: Bool, active: Bool) -> String { return "prefix{1I64: if active { match flag { true => { return "true" } false => { return "false" } } } else { give </> }}" }
fn main() {
    print(block(active: true))
    print(branch(flag: true, active: true))
    print(branch(flag: false, active: true))
    print(arm(flag: true, active: true))
    print(arm(flag: false, active: true))
}
