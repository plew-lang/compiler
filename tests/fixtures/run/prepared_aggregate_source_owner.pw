use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { InstanceEnvironment, Stmt }

fn expression(statement: Stmt) -> U64 {
    match statement {
        Stmt.Return(value: val value, hasValue: _, offset: _) => { return value }
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val value) => { return value }
        _ => { panic("missing aggregate expression") }
    }
}

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="aggregates.pw" text="struct Item {{ val value: I64 }} fn probe() -> Item {{ return <Item value=1I64 /> }} fn unrelated() {{}} val first = <Item value=2I64 /> val second = <Item value=3I64 /> val callback = fn() -> Item {{ return <Item value=4I64 /> }} fn record() -> (item: I64) {{ return (item: 5I64) }}" />,
        sources: <SourceAccess />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val other = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "unrelated").nameId)
    val statement = compiler.blockStmtAt(blkId: compiler.arena.functionAt(index: owner).body, index: 0U64)
    val value = expression(statement: compiler.arena.stmts[statement])
    val body = compiler.internBodyInstance(fnIdx: owner, environment: <InstanceEnvironment />)
    match compiler.preparedBodyAggregate(bodyId: body, exprId: value) {
        Result.Err(error: _) => {}
        _ => { panic("unprepared aggregate admitted") }
    }
    compiler.prepareLexicalBody(fnIdx: owner).unwrap()
    compiler.prepareLexicalBody(fnIdx: other).unwrap()
    val facts = compiler.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    val aggregate = facts.aggregate(ownerFnIdx: owner, exprId: value).unwrap()
    if aggregate.elements.count() != 1U64 || aggregate.resultTerm == 0U64 { panic("aggregate layout lost") }
    if compiler.preparedBodyAggregate(bodyId: body, exprId: value).unwrap().unwrap().elements[0U64].fieldIndex != aggregate.elements[0U64].fieldIndex { panic("final reader lost field identity") }
    if compiler.preparedFunctionSemanticFacts(fnIdx: other).unwrap().aggregate(ownerFnIdx: owner, exprId: value).isSome() { panic("foreign aggregate admitted") }
    if facts.aggregate(ownerFnIdx: owner, exprId: 18446744073709551615U64).isSome() { panic("missing aggregate admitted") }
    match compiler.recordStmt(stmtId: statement) {
        Result.Err(error: _) => {}
        _ => { panic("completed aggregate recorded again") }
    }
    val global = compiler.arena.globals[0U64]
    val otherGlobal = compiler.arena.globals[1U64]
    compiler.prepareGlobalInitializer(target: global.nameStart).unwrap()
    compiler.prepareGlobalInitializer(target: otherGlobal.nameStart).unwrap()
    val globalValue = expression(statement: compiler.arena.stmts[global.letStmt])
    val globalBody = compiler.internBodyInstance(fnIdx: 18446744073709551615U64, environment: <InstanceEnvironment />)
    if !compiler.preparedBodyAggregate(bodyId: globalBody, exprId: globalValue, globalInitializerTarget: <Optional.Some v=global.nameStart />).unwrap().isSome() { panic("global aggregate missing") }
    if compiler.preparedBodyAggregate(bodyId: globalBody, exprId: globalValue, globalInitializerTarget: <Optional.Some v=otherGlobal.nameStart />).unwrap().isSome() { panic("foreign global aggregate admitted") }
    val callback = compiler.arena.globals[2U64]
    compiler.prepareGlobalInitializer(target: callback.nameStart).unwrap()
    val closure = compiler.preparedSemanticClosureAt(index: 0U64).unwrap()
    val closureStatement = compiler.blockStmtAt(blkId: closure.bodyBlock, index: 0U64)
    val closureValue = expression(statement: compiler.arena.stmts[closureStatement])
    val closureBody = compiler.internBodyInstance(fnIdx: closure.bodyKey, environment: <InstanceEnvironment />)
    if !compiler.preparedBodyAggregate(bodyId: closureBody, exprId: closureValue).unwrap().isSome() { panic("global closure aggregate missing") }
    val record = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "record").nameId)
    compiler.prepareLexicalBody(fnIdx: record).unwrap()
    val recordStatement = compiler.blockStmtAt(blkId: compiler.arena.functionAt(index: record).body, index: 0U64)
    if compiler.preparedFunctionSemanticFacts(fnIdx: record).unwrap().aggregate(ownerFnIdx: record, exprId: expression(statement: compiler.arena.stmts[recordStatement])).unwrap().elements.count() != 1U64 { panic("record aggregate missing") }
    if facts.aggregate(ownerFnIdx: owner, exprId: value).unwrap().resultTerm != aggregate.resultTerm { panic("published aggregate changed") }
    print("ok")
}
