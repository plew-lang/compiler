use /Frontend only { Comp, FrontendInput, openFrontend, openFrontendForRequests, analyzeFrontendDeclarations, analyzeFrontendForRequests, spansEqual }
use /SourceAccess only { SourceAccess }
use /Diag only { CompileDiagnostic, FailureDomain }
use @Std/Io only { print }

fn main() {
    val input = <FrontendInput.Text path="witness-result.pw" text="struct First {{}} struct Second {{}} trait Make {{ fn make() -> First }} struct Owner {{}} impl Owner as Make {{ fn make() -> Second {{ return <Second /> }} }} fn main() {{}}" />
    val sources = <SourceAccess stdRoot=[] />
    requireFailure(result: openFrontend(input: input, sources: sources), source: true)
    requireFailure(result: openFrontendForRequests(input: input, sources: sources), source: true)
    mut val raw = <Comp />
    requireFailure(result: analyzeFrontendForRequests(c: inout raw, input: input, sources: sources), source: false)
    mut val rawDeclarations = <Comp />
    requireFailure(result: analyzeFrontendDeclarations(c: inout rawDeclarations, input: input, sources: sources), source: false)

    mut val compiler = checked(openFrontendForRequests(
        input: <FrontendInput.Text path="raw-witness-result.pw" text="struct First {{}} struct Second {{}} trait Make {{ fn make() -> First }} struct Owner {{}} impl Owner as Make {{ fn make() -> First {{ return <First /> }} }} struct Other {{}} impl Other {{ fn make() -> Second {{ return <Second /> }} }} fn main() {{}}" />,
        sources: sources))
    if compiler.decls.conformCount() != 1U64 { panic("unexpected source conformance") }
    val conformance = compiler.decls.conformAt(index: 0U64)
    val traitIndex = compiler.resolveTraitDef(cf: conformance)
    // Successful owned admission already published the constraint evidence.
    // Probe only the raw mismatch; do not republish a successful admission.
    val other = compiler.internBytes(s: "Other")
    val make = compiler.internBytes(s: "make")
    mut val wrong = compiler.arena.functionCount()
    for index in 0U64..<compiler.arena.functionCount() {
        val function = compiler.arena.functionAt(index: index)
        if spansEqual(c: inout compiler, aStart: function.nameStart, aLen: function.nameLen, bStart: make.nameStart, bLen: make.nameLen) &&
           spansEqual(c: inout compiler, aStart: function.recvStart, aLen: function.recvLen, bStart: other.nameStart, bLen: other.nameLen) { wrong = index }
    }
    if wrong == compiler.arena.functionCount() || conformance.witnessFuncIds.len != 1U64 { panic("missing raw witness mutation target") }
    compiler.decls.conformFuncIdPool[conformance.witnessFuncIds.start] = wrong
    requireFailure(result: compiler.checkConformanceMethodBounds(conformIndex: 0U64, traitIndex: traitIndex), source: false)
    requireFailure(result: compiler.checkConformances(), source: false)
    print("ok")
}

fn requireFailure[T](result: Result[T, CompileDiagnostic], source: Bool) {
    match result {
        Result.Ok(value: _) => { panic("wrong witness return accepted") }
        Result.Err(error: val diagnostic) => {
            if diagnostic.message != "implementation return type does not match the trait requirement" { panic(diagnostic.message) }
            if source {
                match diagnostic.failureDomain { FailureDomain.Source => {} _ => { panic("source witness result lost its origin") } }
            } else {
                match diagnostic.failureDomain { FailureDomain.Unclassified => {} _ => { panic("raw witness result became source") } }
            }
        }
    }
}

fn checked[T](result~: Result[T, CompileDiagnostic]) -> T {
    match result {
        Result.Ok(value: val value) => { return value }
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
}
