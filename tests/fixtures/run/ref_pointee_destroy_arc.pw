use @Std/Io only { print }
use @Std/Core only { MutableRef }

unique struct Cell {
    pub val v: I32
    deinit { print(self.v) }
}
pub impl Cell { factory }

struct Box[T] {
    pub val v: T
}
pub impl Box { factory }

enum Inner {
    Keep(r: MutableRef[Cell])
    Nothing
}

fn genericPointee() {
    val r: MutableRef[Box[MutableRef[Cell]]] = <MutableRef value=<Box[MutableRef[Cell]] v=<MutableRef value=<Cell v=5I32 /> /> /> />
    print("generic-pointee-end")
}

fn enumPointee() {
    val r: MutableRef[Inner] = <MutableRef value=<Inner.Keep r=<MutableRef value=<Cell v=6I32 /> /> /> />
    print("enum-pointee-end")
}

fn main() {
    genericPointee()
    enumPointee()
    print("done")
}
