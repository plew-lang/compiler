// Mutated executable IR must be rejected, independently of the producer.
import @Std/Io with { print }
import @Std/Core with { assert }
import /Frontend with { Comp }
import /Ir with { CallResolution }
import /Mid with { MidBody, MidBlock, MidStatement, MidTerminator, MidPlace, MidLocalDecl, MidOperand, MidRvalue, MidConstant, MidCallTarget, MidCallReceiver, MidVerifyError, verifyExecutableCanonicalMidBody }
fn check(mode: U64) {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "String")
    val t = c.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    c.enqueueFinalDestruction(typeRef: t).unwrap()
    val p = <MidPlace local=0U64 typeTerm=t />
    val q = <MidPlace local=1U64 typeTerm=t />
    mut val statements: Array[MidStatement] = []
    if mode == 1U64 {
        statements.append(<MidStatement.Drop place=p />)
        statements.append(<MidStatement.Assign destination=q value=<MidRvalue.Use operand=<MidOperand.Copy place=p /> /> />)
        statements.append(<MidStatement.Drop place=q />)
    }
    if mode == 3U64 { statements.append(<MidStatement.Drop place=p />) }
    if mode == 2U64 {
        statements.append(<MidStatement.Assign destination=p value=<MidRvalue.Use operand=<MidOperand.Copy place=p /> /> />)
        statements.append(<MidStatement.Drop place=p />)
    }
    mut val blocks = [<MidBlock statements=statements terminator=<MidTerminator.Return /> />]
    if mode == 4U64 { blocks = [<MidBlock terminator=<MidTerminator.Unreachable /> />] }
    if mode == 5U64 {
        // Supply a typed call so the test isolates live-owner initialization.
        c.arena.finalCallees.append(<CallResolution bodyId=0U64 exprId=0U64 callee=0U64 resultTypeRef=t />)
        blocks = [<MidBlock terminator=<MidTerminator.Call callee=<MidCallTarget.Resolved resolution=0U64 /> receiver=<MidCallReceiver.None /> args=[] destination=p target=1U64 /> />,
            <MidBlock statements=[<MidStatement.Drop place=p />] terminator=<MidTerminator.Return /> />]
    }
    val body = c.mid.store(body: <MidBody locals=[<MidLocalDecl typeTerm=t sourceScope=0U64 isUnique=false isParameter=true ownsAtEntry=true />, <MidLocalDecl typeTerm=t sourceScope=0U64 isUnique=false isParameter=false />] blocks=blocks />)
    match verifyExecutableCanonicalMidBody(c: inout c, canonical: body).error {
        MidVerifyError.None => { assert(mode == 3U64 || mode == 4U64) print("accepted") }
        MidVerifyError.OutstandingOwnership => { assert(mode == 0U64) print("rejected") }
        MidVerifyError.MoveUnavailable => { assert(mode == 1U64) print("rejected") }
        MidVerifyError.LiveInitialization => { assert(mode == 2U64 || mode == 5U64) print("rejected") }
        _ => { assert(false) }
    }
}
fn flagCase(correct: Bool, clearConsumed: Bool = true) {
    mut val c: Comp = <Comp />
    c.arena.reserveTypeSentinel()
    val name = c.internBytes(s: "String")
    val t = c.simpleTypeRef(nameStart: name.nameStart, nameLen: name.nameLen)
    c.enqueueFinalDestruction(typeRef: t).unwrap()
    val p = <MidPlace local=0U64 typeTerm=t />
    val owner = <MidLocalDecl typeTerm=t sourceScope=0U64 isUnique=false isParameter=true ownsAtEntry=true />
    val flag = <MidLocalDecl typeTerm=0U64 sourceScope=0U64 isUnique=false isParameter=false isDropFlag=true />
    val clear = <MidStatement.SetDropFlag local=1U64 isSet=correct />
    val condition = <MidOperand.Constant value=<MidConstant.Integer value=0U64 isNegative=false isBool=true typeTerm=0U64 /> />
    val entry = <MidBlock statements=[clear] terminator=<MidTerminator.Switch discriminant=condition values=[1I64] targets=[1U64] otherwise=2U64 /> />
    val moved = <MidBlock statements=[<MidStatement.Drop place=p />, <MidStatement.SetDropFlag local=1U64 isSet=!clearConsumed />] terminator=<MidTerminator.Goto target=3U64 /> />
    val kept = <MidBlock terminator=<MidTerminator.Goto target=3U64 /> />
    val join = <MidBlock statements=[<MidStatement.ConditionalDrop place=p flag=1U64 />] terminator=<MidTerminator.Return /> />
    val body = c.mid.store(body: <MidBody locals=[owner, flag] blocks=[entry, moved, kept, join] />)
    match verifyExecutableCanonicalMidBody(c: inout c, canonical: body).error {
        MidVerifyError.None => { assert(correct && clearConsumed) print("flag-case-accepted") }
        MidVerifyError.InvalidDropFlag => { assert(!correct || !clearConsumed) print("flag-case-rejected") }
        _ => { assert(false) }
    }
}
fn main() { check(mode: 0U64) check(mode: 1U64) check(mode: 2U64) flagCase(correct: false) check(mode: 3U64) flagCase(correct: true) check(mode: 4U64) check(mode: 5U64) flagCase(correct: true, clearConsumed: false) }
