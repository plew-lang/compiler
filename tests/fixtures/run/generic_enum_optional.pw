import @Std/Io with { print }

// A user-defined generic enum (named to NOT shadow the ambient lang-item `Optional`,
// which is now auto-loaded and not redefinable).
enum Maybe[T] {
    Some(v: T)
    None
}

fn main() {
    val a: Maybe[I32] = <Maybe[I32].Some v=42 />
    val b: Maybe[I32] = <Maybe[I32].None />
    match a {
        Maybe.Some(val v) => { print(v) }
        Maybe.None => { print(0I64) }
    }
    match b {
        Maybe.Some(val v) => { print(v) }
        Maybe.None => { print(99I64) }
    }
}
