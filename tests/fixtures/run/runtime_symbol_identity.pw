use @Std/Io only { readFileBytes, write }
use @Std/Set only { Set }
fn main() {
    val text = readFileBytes("tests/fixtures/run/runtime_symbol_identity.data".bytes())
    mut val values: Set[U64] = Set.new()
    values.insert(7U64)
    if text != "loaded\n" || !values.contains(7U64) { panic "runtime symbols aliased" }
    write(s: "runtime-symbol-identity-ok\n")
}
