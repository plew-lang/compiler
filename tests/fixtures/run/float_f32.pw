import @Std/Io with { print }

// F32 (spec/02): a 32-bit float type. Represented as double for now (observably the
// same on the float floor), so it shares the F64 arithmetic / print / Format path.
fn main() {
    val x: F32 = 1.5
    val y: F32 = 2.5
    print(x)          // 1.5
    print(x + y)      // 4
    print(x * 2.0)    // 3
    print(3.14e0)     // 3.14
}
