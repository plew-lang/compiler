use @Std/Core only { Format, FormatOptions, TextOutput, MutableRef }
use @Std/Io only { print }
struct Options { val marker: Bool }
impl Options as FormatOptions { factory() { return <Options marker=false /> } }
struct Item { mut val value: I64 }
struct Holder { mut val item: Item }
impl Item as Format {
    type Options = Options
    fn format[Output](output: inout Output, options: Options) -> Result[(), Output.Error] where Output: TextOutput {
        return self.value.format(output: inout output, options: </>)
    }
}
fn mutate(item: inout Item) -> Options {
    print("options")
    item.value = 2I64
    return <Options marker=false />
}
fn replace(items: inout Array[Item]) -> Options {
    print("replace")
    items[0U64] = <Item value=3I64 />
    return <Options marker=false />
}
fn snapshot(item: Item) -> Item { print("receiver")
    return item }
fn failure() -> Result[Options, Bool] { print("failure")
    return <Result.Err error=true /> }
fn later() -> I64 { print("unexpected later")
    return 9I64 }
fn failing(item: Item) -> Result[String, Bool] {
    return <Result.Ok value="prefix{item: try failure()}{later()}" />
}
fn main() {
    mut val item = <Item value=1I64 />
    print("{item: mutate(item: inout item)}")
    item.value = 1I64
    print("{snapshot(item: item): mutate(item: inout item)}")
    mut val items: Array[Item] = [<Item value=1I64 />]
    print("{items[0U64]: replace(items: inout items)}")
    val shared = <MutableRef[Holder] value=<Holder item=<Item value=1I64 /> /> />
    print("{shared->item: mutate(item: inout shared->item)}")
    match failing(item: item) {
        Result.Ok(value: _) => { print("unexpected success") }
        Result.Err(error: _) => { print("error") }
    }
}
