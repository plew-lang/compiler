use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /Ir only { StaticConformanceProof, WitnessBind, WitnessConditionPlan, WitnessMatch, ValueConversionProof }
use /SourceAccess only { SourceAccess }
use @Std/Core only { assert }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    val source = "trait Parent {{ type Item }}\ntrait Marker {{}}\nimpl I64 as Marker {{}}\nstruct Box[T] {{}}\nimpl[T] Box[T] as Parent where T: Marker {{ type Item = T }}\nfn example(value: Box[I64], other: Bool, target: any Parent[Item=I64]) {{}}\n"
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path="binding-substitution.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val binding = compiler.decls.assocBindings[0U64]
    val declaration = compiler.arena.functionAt(index: compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "example").nameId))
    val receiver = compiler.funcParamAt(params: declaration.params, index: 0U64).ty
    val expected = compiler.arena.typeAt(index: receiver).args[0U64]
    val foreign = compiler.funcParamAt(params: declaration.params, index: 1U64).ty
    val parameter = compiler.conformBindAt(binds: binding.typeParams, index: 0U64)
    val target = compiler.funcParamAt(params: declaration.params, index: 2U64).ty
    val conversion = compiler.callArgumentConversion(sourceRef: receiver, targetRef: target, assumptions: []).unwrap()
    val witness = match conversion {
        ValueConversionProof.ExistentialBox(sourceRef: _, targetRef: _, traitIdx: _, proof: val proof) => {
            give match proof {
                StaticConformanceProof.ConcreteWitness(witness: val witness) => witness,
                _ => { panic("expected the direct conditional witness") },
            }
        }
        _ => { panic("expected a selected existential conversion") }
    }
    assert(witness.conditions != 0U64)
    val valid = <StaticConformanceProof.ConcreteWitness witness=witness />
    val wrong = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=witness.conformIdx selfRef=receiver binds=[<WitnessBind binder=0U64 paramId=parameter.paramId term=foreign />] conditions=witness.conditions /> />
    val missing = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=witness.conformIdx selfRef=receiver conditions=witness.conditions /> />
    val noPlan = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=witness.conformIdx selfRef=receiver binds=witness.binds /> />
    val plan = compiler.arena.witnessConditionPlanAt(index: witness.conditions - 1U64)
    val missingChild = compiler.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=plan.witness proofs=[0U64] normalizations=plan.normalizations />)
    val noChild = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=witness.conformIdx selfRef=receiver binds=witness.binds conditions=missingChild /> />
    val surplus = [<WitnessBind binder=99U64 paramId=parameter.paramId term=foreign />, witness.binds[0U64]]
    val surplusPlan = compiler.arena.publishWitnessConditionPlan(plan: <WitnessConditionPlan witness=<WitnessMatch conformIdx=witness.conformIdx selfRef=receiver binds=surplus /> proofs=plan.proofs normalizations=plan.normalizations />)
    val extra = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=witness.conformIdx selfRef=receiver binds=surplus conditions=surplusPlan /> />
    assert(compiler.associatedOutputInProof(proof: valid, traitOwner: binding.traitOwner, assocId: binding.nameId).unwrap() == expected)
    if !compiler.associatedOutputInProof(proof: noPlan, traitOwner: binding.traitOwner, assocId: binding.nameId).isErr() { panic("accepted a missing witness condition plan") }
    if !compiler.associatedOutputInProof(proof: noChild, traitOwner: binding.traitOwner, assocId: binding.nameId).isErr() { panic("accepted a missing witness condition child") }
    if !compiler.associatedOutputInProof(proof: extra, traitOwner: binding.traitOwner, assocId: binding.nameId).isErr() { panic("accepted an extra witness binder") }
    assert(compiler.associatedOutputInProof(proof: wrong, traitOwner: binding.traitOwner, assocId: binding.nameId).isErr())
    assert(compiler.associatedOutputInProof(proof: missing, traitOwner: binding.traitOwner, assocId: binding.nameId).isErr())
    assert(compiler.associatedOutputInProof(proof: valid, traitOwner: binding.traitOwner, assocId: binding.nameId).unwrap() == expected)
    print("associated-binding-witness-substitution")
}
