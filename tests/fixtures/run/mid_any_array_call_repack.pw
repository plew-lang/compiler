import @Std/Io with { print }

// The CallResolution boundary, not just assignment lowering, must repack a
// concrete array before a function receives Array[any Shape].
trait Shape { fn area() -> I64 }
struct Sq { pub val side: I64 }
pub impl Sq { factory }
pub impl Sq as Shape { fn area() -> I64 { return self.side * self.side } }

fn total(shapes: Array[any Shape]) -> I64 {
    return shapes[0U64].area() + shapes[1U64].area()
}

fn main() {
    val squares: Array[Sq] = [<Sq side=2I64 />, <Sq side=3I64 />]
    print(total(shapes: squares))
}
