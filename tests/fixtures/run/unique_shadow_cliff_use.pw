use @Std/Io only { print }
unique struct File {
    val fd: I64
    deinit { print(self.fd + 100I64) }
}
impl File { factory }
fn main() {
    val f = <File fd=1I64 />
    {
        val f = <File fd=2I64 />
        print(f.fd)
    }
    print(f.fd)
    borrowedOwner()
}

fn showBorrowed(file: borrow File, other: I64) {
    print(file.fd)
    print(other)
}

fn borrowedOwner() {
    val f = <File fd=3I64 />
    showBorrowed(file: borrow f, other: {
        val f = <File fd=4I64 />
        give f.fd
    })
}
