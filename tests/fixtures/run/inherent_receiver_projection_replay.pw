use @Std/Io only { print }

trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }

impl[T] Box[T, T#Source.Item] where T: Source {
    fn value() -> T#Source.Item { return self.item }
}

fn read[T](box: Box[T, T#Source.Item]) -> T#Source.Item where T: Source {
    return box.value()
}

fn main() { print(read(box: <Box[Number, I64] item=42I64 />)) }
