use @Std/Io only { print }
trait Project { type Item }
trait Marker[T] { fn number() -> I64 }
struct Projector {}
struct Number {}
impl Projector as Project { type Item = I64 }
impl Number as Marker[I64] { fn number() -> I64 { return 42I64 } }
val fromBlock: I64 = {
    val number: Number#Marker[Projector#Project.Item] = <Number />#Marker[Projector#Project.Item]
    give number.number()
}
fn main() { print(fromBlock) }
