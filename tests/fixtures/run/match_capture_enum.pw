// capture binding `val rest =>` in an enum-dispatch match (spec/11): binds the whole
// scrutinee, alongside variant arms, in BOTH statement and value position.
import @Std/Io with { print, write }

enum Color { Red Green Blue }

fn rank(c: Color) -> I64 {
    return match c {
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
    }
}

// statement position
fn describe(c: Color) {
    match c {
        Color.Red => { write(s: "red\n") }
        val rest => { print(rank(c: rest)) }
    }
}

// value position (give-block wrapper desugar)
fn label(c: Color) -> String {
    return match c {
        Color.Red => "is-red"
        val rest => { val r: I64 = rank(c: rest)  give name(n: r) }
    }
}

fn name(n: I64) -> String {
    return match n {
        2 => "two"
        3 => "three"
        _ => "other"
    }
}

fn main() {
    describe(c: <Color.Red />)
    describe(c: <Color.Green />)
    write(s: label(c: <Color.Red />))
    write(s: "\n")
    write(s: label(c: <Color.Blue />))
    write(s: "\n")
}
