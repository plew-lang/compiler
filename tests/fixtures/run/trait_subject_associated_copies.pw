use @Std/Io only { print }

trait Source {}
trait Report { assoc fn value() -> I64 }
pub impl Source as Report {
    assoc fn value() -> I64 { return 7I64 }
}
struct B {}
struct A {}
struct Left {}
struct Right {}
struct Box[T] {}
impl B as Source {}
impl A as Source {}
impl[T] Box[T] as Source {}
newtype WrappedA = A

fn requested[T](value: T) -> I64 where T: Report { return T.value() }

fn main() {
    print(A.value())
    print(B.value())
    print(requested(value: <A />))
    print(requested(value: <B />))
    print(requested(value: <Box[Left] />))
    print(requested(value: <Box[Right] />))
    print(WrappedA.value())
    print(requested(value: <A /> as WrappedA))
}
