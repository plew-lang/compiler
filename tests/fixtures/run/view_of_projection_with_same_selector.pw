use @Std/Io only { print }
trait P { fn number() -> I64 }
trait Q { type Item fn value() -> Item }
struct Owner {}
struct Payload {}
impl Owner as Q {
    type Item = Payload
    fn value() -> Payload { return <Payload /> }
}
impl Owner as P { fn number() -> I64 { return 0I64 } }
impl Payload as P { fn number() -> I64 { return 42I64 } }
fn invoke[T](value: T#P#Q.Item, owner: T) where T: P + Q, T#P#Q.Item: P {
    val viewed = value#P
    print(viewed.number())
}
fn main() { invoke(value: <Payload />, owner: <Owner />) }
