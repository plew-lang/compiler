use /Frontend only { Comp, FrontendInput, analyzeFrontend }
use /CheckedProgram only { CompilerSession, CompilerSessionResult }
use /SourceAccess only { SourceAccess }
use /Diag only { emitDiagnostic }
use /Ir only { TraitBound, StaticConformanceProof, DeclarationBoundRef, ValueConversionProof }
use @Std/Io only { print }
fn main() {
    val program = "trait Marker {{ fn number() -> I64 }}\ntrait Flag {{ fn flag(number: I64) -> I64 }}\nstruct Value {{}}\nimpl Value as Marker {{ fn number() -> I64 {{ return 42I64 }} }}\nstruct Enabled {{}}\nimpl Enabled as Flag {{ fn flag(number: I64) -> I64 {{ return number }} }}\ntrait Service: Marker {{ fn get() -> I64 where Self: Marker }}\nimpl Value as Service {{ fn get() -> I64 where Self: Marker {{ return self.number() }} }}\nnewtype Wrapped = Value\nnewtype Outer = Wrapped\ntrait Absent {{}}\ntrait Unavailable {{ fn get() -> I64 where Self: Absent }}\nstruct Other {{}}\nimpl Other as Unavailable {{ fn get() -> I64 {{ return 0I64 }} }}\ntrait Items {{ type Item: Marker fn get(item: Item) -> I64 where Item: Marker }}\nstruct Storage[T] {{}}\nimpl[T] Storage[T] as Items where T: Marker {{\n    type Item = T\n    fn get(item: T) -> I64 where T: Marker {{ return item.number() }}\n}}\ntrait PairService {{\n    type Left\n    type Right\n    fn get(left: Left, right: Right) -> I64 where Left: Marker, Right: Flag\n}}\nstruct Pair[L,R] {{}}\nimpl[L,R] Pair[L,R] as PairService {{\n    type Left = L\n    type Right = R\n    fn get(left: L, right: R) -> I64 where R: Flag, L: Marker {{ return right.flag(number: left.number()) }}\n}}\nfn service(value: any Service) -> I64 {{ return value.get() }}\nfn item(value: any Items[Item=Value]) -> I64 {{ return value.get(item: <Value />) }}\nfn pair(value: any PairService[Left=Value,Right=Enabled]) -> I64 {{ return value.get(left: <Value />, right: <Enabled />) }}\nfn main() {{\n    val unavailable: any Unavailable = <Other />\n    val first = service(value: <Value />)\n    val wrapped = <Value /> as Wrapped\n    val secondWrapper = wrapped as Outer\n    val inherited = service(value: wrapped)\n    val nestedInherited = service(value: secondWrapper)\n    val second = item(value: <Storage[Value] />)\n    val third = pair(value: <Pair[Value,Enabled] />)\n}}\n"
    mut val compiler = <Comp />
    match analyzeFrontend(c: inout compiler, input: <FrontendInput.Text text=program path="boxing-conditions.pw" />, sources: <SourceAccess />) {
        Result.Ok(value: _) => {}
        Result.Err(error: val error) => { emitDiagnostic(diagnostic: error) panic(error.message) }
    }
    val unavailable = compiler.internBytes(s: "Unavailable").nameId
    mut val inactive = 0U64
    mut val active = 0U64
    for resolution in compiler.arena.finalExistentials {
        val declaration = compiler.decls.traitAt(index: resolution.traitIdx)
        compiler.finalizeConversionDependencies(conversion: <ValueConversionProof.ExistentialBox sourceRef=resolution.sourceRef targetRef=resolution.targetRef traitIdx=resolution.traitIdx proof=resolution.proof />).unwrap()
        if compiler.finalizeConversionDependencies(conversion: <ValueConversionProof.ExistentialBox sourceRef=resolution.sourceRef targetRef=resolution.targetRef traitIdx=resolution.traitIdx proof=<StaticConformanceProof.Missing /> />).isOk() { panic("cached boxing repaired missing conformance evidence") }
        if compiler.finalizeConversionDependencies(conversion: <ValueConversionProof.ExistentialBox sourceRef=resolution.sourceRef targetRef=resolution.targetRef traitIdx=compiler.decls.traitCount() proof=resolution.proof />).isOk() { panic("cached boxing accepted a foreign interface") }
        for member in resolution.members {
            if declaration.nameId == unavailable {
                if member.bodyId != 0U64 || member.adapterBodyId != 0U64 { panic("unavailable member requested an executable body") }
                inactive += 1U64
            } else {
                if member.bodyId == 0U64 || member.adapterBodyId == 0U64 { panic("promised member lost its executable body") }
                val body = compiler.arena.bodyInstanceAt(index: member.bodyId - 1U64)
                val constraints = body.environment.constraints.unwrap()
                if compiler.arena.callableConstraintCount(evidence: constraints) == 0U64 { panic("promised member lost its implementation condition bindings") }
                mut val implementationBody = body
                while implementationBody.adapterTargetBodyId != 0U64 {
                    implementationBody = compiler.arena.bodyInstanceAt(index: implementationBody.adapterTargetBodyId - 1U64)
                    val retained = implementationBody.environment.constraints.unwrap()
                    if compiler.arena.callableConstraintCount(evidence: retained) == 0U64 { panic("newtype target lost admitted conditions") }
                    for index in 0U64..<compiler.arena.callableConstraintCount(evidence: retained) {
                        val bound = compiler.groundCallableBound(bound: compiler.declarationBound(source: compiler.arena.callableConstraintSourceAt(evidence: retained, index: index)), environment: implementationBody.environment, selfRef: implementationBody.environment.receiverRef, itemRef: 0U64).unwrap()
                        val proof = compiler.thawStaticConformanceProof(id: compiler.arena.callableConstraintProofAt(evidence: retained, index: index))
                        if !compiler.selectedCallConstraintMatches(expected: bound, proof: proof).unwrap() { panic("newtype target changed its condition declaration") }
                    }
                }
                // The declaration-normalized public clauses below describe
                // the original receiver. Inherited tables are checked through
                // their actual retained target bindings above instead.
                if body.adapterTargetBodyId != 0U64 { active += 1U64 continue }
                val function = compiler.arena.functionAt(index: body.fnIdx)
                val implementation = if function.sourceWitnessFuncId != 0U64 { give function.sourceWitnessFuncId - 1U64 } else { give body.fnIdx }
                mut val planIndex = 0U64
                while planIndex < compiler.arena.conformanceMethodEvidenceCount() && compiler.arena.conformanceMethodEvidenceAt(index: planIndex).implementation != implementation { planIndex += 1U64 }
                if planIndex >= compiler.arena.conformanceMethodEvidenceCount() { panic("boxing has no retained requirement derivation") }
                val plan = compiler.arena.conformanceMethodEvidenceAt(index: planIndex)
                if compiler.instantiateRequirementCallConstraints(fnIdx: body.fnIdx, environment: body.environment, planIndex: planIndex, bounds: [], proofs: []).isOk() { panic("boxing repaired missing public evidence") }
                if compiler.instantiateRequirementCallConstraints(fnIdx: body.fnIdx, environment: body.environment, planIndex: compiler.arena.conformanceMethodEvidenceCount(), bounds: [], proofs: []).isOk() { panic("boxing repaired a missing implementation derivation") }
                mut val bounds: Array[TraitBound] = []
                mut val proofs: Array[StaticConformanceProof] = []
                for source in plan.requirements {
                    val bound = compiler.groundCallableBound(bound: compiler.declarationBound(source: <DeclarationBoundRef.Requirement index=source />), environment: body.environment, selfRef: body.environment.receiverRef, itemRef: 0U64).unwrap()
                    mut val found = false
                    mut val index = 0U64
                    while index < compiler.arena.callableConstraintCount(evidence: constraints) && !found {
                        val proof = compiler.thawStaticConformanceProof(id: compiler.arena.callableConstraintProofAt(evidence: constraints, index: index))
                        if compiler.selectedCallConstraintMatches(expected: bound, proof: proof).unwrap() {
                            bounds.append(bound)
                            proofs.append(proof)
                            found = true
                        }
                        index += 1U64
                    }
                    if !found { panic("body evidence did not retain the exercised public condition") }
                }
                compiler.instantiateRequirementCallConstraints(fnIdx: body.fnIdx, environment: body.environment, planIndex: planIndex, bounds: bounds, proofs: proofs).unwrap()
                mut val foreign = 0U64
                while foreign < compiler.arena.conformanceMethodEvidenceCount() && compiler.arena.conformanceMethodEvidenceAt(index: foreign).implementation == implementation { foreign += 1U64 }
                if foreign >= compiler.arena.conformanceMethodEvidenceCount() { panic("foreign boxing derivation control was not exercised") }
                if compiler.instantiateRequirementCallConstraints(fnIdx: body.fnIdx, environment: body.environment, planIndex: foreign, bounds: bounds, proofs: proofs).isOk() { panic("boxing accepted another implementation's derivation") }
                if proofs.count() == 2U64 {
                    val swapped = [proofs[1U64], proofs[0U64]]
                    if compiler.instantiateRequirementCallConstraints(fnIdx: body.fnIdx, environment: body.environment, planIndex: planIndex, bounds: bounds, proofs: swapped).isOk() { panic("boxing accepted replaced public clauses") }
                }
                active += 1U64
            }
        }
    }
    if inactive != 1U64 || active != 5U64 { panic("boxing condition controls did not cover each member") }
    val main = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "main").nameId)
    match CompilerSession.open(input: <FrontendInput.Text text=program path="boxing-conditions-mid.pw" />, sources: <SourceAccess />) {
        CompilerSessionResult.Failure(diagnostic: val diagnostic) => { emitDiagnostic(diagnostic: diagnostic) panic(diagnostic.message) }
        CompilerSessionResult.Success(session: val opened) => {
            mut val session = move opened
            session.prepareFunction(function: main).unwrap()
            mut val index = 0U64
            while index < session.registeredBodies().count() {
                session.prepareMidBody(bodyId: session.registeredBodies()[index]).unwrap()
                index += 1U64
            }
        }
    }
    print("interface-boxing-conditions")
}
