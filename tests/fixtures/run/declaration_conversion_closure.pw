use @Std/Core only { assert }
use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, DeclarationConversion, ValueConversionProof, StaticConformanceProof, InstanceEnvironment }

// Internal contract: incomplete conversion evidence must survive recording
// and prevent declaration completion, even without an executable request.
fn checkFailure(known: Bool) {
    mut val compiler = <Comp />
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text="trait P {{}}\nstruct Value {{}}\nfn probe(value: Value, target: any P) {{}}\n" path="conversion.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.functionAt(index: 0U64)
    val source = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val target = compiler.funcParamAt(params: function.params, index: 1U64).ty
    val expression = compiler.pushExpr(e: <Expr.Int value=0U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    if known { compiler.recordSemanticExprTerm(exprId: expression, term: source) }
    compiler.cur.checkFn = 0U64
    compiler.cur.recordCallTemplates = true
    compiler.recordDeclarationConversion(exprId: expression, target: target).unwrap()
    assert(compiler.decls.declarationConversions.count() == 1U64)
    match compiler.checkRecordedMemberObligations() {
        Result.Err(error: val diagnostic) => {
            if known { assert(diagnostic.message == "source value does not satisfy the required conversion") }
            else { assert(diagnostic.message == "source conversion requires a resolved value type") }
        }
        Result.Ok(value: _) => { panic "declaration accepted incomplete conversion evidence" }
    }
    if known {
        // Even an empty trait requires actual conformance evidence. A zero
        // member count must not turn Ready(Missing) into a successful closure.
        val site = compiler.decls.declarationConversions[0U64].site
        val conversion = <ValueConversionProof.ExistentialBox sourceRef=source targetRef=target traitIdx=compiler.recordAnyTraitIndex(anyRef: target) proof=<StaticConformanceProof.Missing /> />
        val proof = compiler.freezeValueConversionProof(proof: conversion)
        compiler.decls.declarationConversions[0U64] = <DeclarationConversion site=site source=source target=target proof=proof />
        match compiler.checkRecordedMemberObligations() {
            Result.Err(error: val diagnostic) => { assert(diagnostic.message == "declaration obligation has no conformance evidence") }
            Result.Ok(value: _) => { panic "empty trait hid missing conformance evidence" }
        }
        match compiler.instantiateValueConversion(conversion: conversion, environment: <InstanceEnvironment />, selfRef: 0U64, itemRef: 0U64) {
            Result.Err(error: val diagnostic) => { assert(diagnostic.message == "conversion has no concrete conformance evidence") }
            Result.Ok(value: _) => { panic "executable conversion accepted missing evidence" }
        }
    }
}
fn main() {
    checkFailure(known: true)
    checkFailure(known: false)
    print("ok")
}
