use @Std/Io only { print }
trait Source { type Item }
struct Number {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }
impl[T] Box[T, T#Source.Item] where T: Source { assoc fn code(box: Self) -> I64 { return 42I64 } }
fn main() { print(Box.code(box: <Box[Number, I64] item=0I64 />)) }
