use @Plew/Syntax only { parseItem, TopItemAst }
use @Std/Io only { print }

fn main() {
    val item = parseItem(source: "fn use(value: Box[Item=Leaf]#View#Trait[Assoc=Arg].Output) {{}}", start: 0U64, end: 61U64)
    match item {
        TopItemAst.Decl(val d) => {
            val ty = d.params[0U64].ty
            print(ty.nameSpan.start)
            print(ty.nameSpan.end)
            print(ty.argLabelSpans[0U64].start)
            print(ty.argLabelSpans[0U64].end)
            print(ty.viewNameSpans[0U64].start)
            print(ty.viewNameSpans[0U64].end)
            val projection = ty.viewSources[1U64]
            print(projection.path[0U64].nameSpan.start)
            print(projection.path[0U64].nameSpan.end)
            print(projection.path[0U64].argLabelSpans[0U64].start)
            print(projection.path[0U64].argLabelSpans[0U64].end)
            print(projection.path[1U64].nameSpan.start)
            print(projection.path[1U64].nameSpan.end)
        }
        _ => {}
    }
}
