import @Std/Io with { print }
import @Std/Core with { MutableRef }

unique struct Holder {
    pub mut val values: Array[I64]
    deinit { print(self.values[0]) }
}
pub impl Holder { factory }
fn replace(reference: inout MutableRef[Holder], item: inout I64) {
    reference = <MutableRef[Holder] value=<Holder values=[3] /> />
    item = 99
    print("call")
}
fn main() {
    mut val reference: MutableRef[Holder] = <MutableRef[Holder] value=<Holder values=[1] /> />
    // Rebinding removes the last source owner. The reservation must keep the
    // old cell alive through IndexSet writeback; its deinit must observe 99.
    replace(reference: inout reference, item: inout reference->values[0])
    print(reference->values[0])
}
