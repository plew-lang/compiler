use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, Stmt }
use /Mid only { prepareMidSourceState, MidBuildState, MidBuildError, MidOperand, MidRvalue, MidStatement, addMidLocal, midLocalForBinding, midPlaceForRecordedIdent, buildMidLet, buildParametricMidBody }

fn verifyStorageEmissionOrder() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="binding-order.pw" text="fn produce() -> I64 {{ return 1I64 }} fn probe(flag: Bool) {{ if flag {{ val branch = produce() }} val after = 2I64 }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val built = buildParametricMidBody(c: inout c, fnIdx: owner)
    if built.canonical.body == 0U64 { panic("missing canonical body") }
    val body = c.mid.bodies[built.canonical.body - 1U64]
    mut val blockOrder: Array[U64] = []
    for index in 0U64..<body.blocks.len {
        val block = c.mid.blocks[body.blocks.start + index]
        for statementIndex in 0U64..<block.statements.len {
            val statement = c.mid.statements[block.statements.start + statementIndex]
            if statement.value == 0U64 { continue }
            val value = c.mid.rvalues[statement.value - 1U64]
            if value.tag == 20U64 { blockOrder.append(block.statements.start + statementIndex) }
        }
    }
    if blockOrder.count() != 2U64 || body.storageOrder.len != 2U64 { panic("missing local storage order") }
    if c.mid.storageStatements[body.storageOrder.start] != blockOrder[1U64] ||
        c.mid.storageStatements[body.storageOrder.start + 1U64] != blockOrder[0U64] {
        panic("local storage order follows block layout instead of initialization")
    }
}

fn main() {
    verifyStorageEmissionOrder()
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="binding-cfg.pw" text="unique struct File {{}} fn probe(file: move File) {{ val first = move file val second = move first }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    val function = c.arena.functionAt(index: owner)
    val parameter = c.funcParamAt(params: function.params, index: 0U64)
    val valueTerm = parameter.ty
    val firstBinding = c.blockStmtAt(blkId: function.body, index: 0U64)
    val secondBinding = c.blockStmtAt(blkId: function.body, index: 1U64)
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    val firstTarget = match c.arena.stmts[firstBinding] { Stmt.Let(mutable: _, nameStart: val start, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: _, annotationOccurrence: _) => start _ => { panic("missing first binding") } }
    mut val state: MidBuildState = (prepareMidSourceState(c: inout c, sourceFunction: owner, facts: facts)).unwrap()
    val firstLocal = addMidLocal(state: inout state, declarationTarget: parameter.nameStart, typeTerm: valueTerm, isUnique: true, isParameter: false, ownsAtEntry: false)
    val secondLocal = addMidLocal(state: inout state, declarationTarget: firstTarget, typeTerm: valueTerm, isUnique: true, isParameter: false, ownsAtEntry: false)
    val outer = midLocalForBinding(state: state, declarationTarget: parameter.nameStart)
    val inner = midLocalForBinding(state: state, declarationTarget: firstTarget)
    val missing = midLocalForBinding(state: state, declarationTarget: 30U64)
    // Use a real recorded identifier. Mid cannot acquire semantic authority
    // from a fabricated AST node or a mutable TypeCache row.
    val initializer = match c.arena.stmts[firstBinding] { Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init, annotationOccurrence: _) => init _ => { panic("missing initializer") } }
    val bindingProbe = match c.arena.exprs[initializer] { Expr.Move(operand: val operand, isBorrow: _) => operand _ => { panic("missing move") } }
    val place = midPlaceForRecordedIdent(c: inout c, state: state, exprId: bindingProbe, typeTerm: valueTerm)
    val absentState = (prepareMidSourceState(c: inout c, sourceFunction: owner, facts: facts)).unwrap()
    val absentPlace = midPlaceForRecordedIdent(c: inout c, state: absentState, exprId: bindingProbe, typeTerm: valueTerm)
    mut val letState = (prepareMidSourceState(c: inout c, sourceFunction: owner, facts: facts)).unwrap()
    val input = addMidLocal(state: inout letState, declarationTarget: parameter.nameStart, typeTerm: valueTerm, isUnique: true, isParameter: true, ownsAtEntry: true)
    val letResult = buildMidLet(c: inout c, state: inout letState, stmtId: firstBinding)
    mut val hasAssign: Bool = false
    match letState.blocks[0U64].statements[0U64] {
        MidStatement.Assign(destination: val destination, value: val value) => {
            match value {
                MidRvalue.StorageBoundary(stmtId: val statement, exprId: _, targetTerm: val target, operand: val operand) => {
                    match operand {
                        MidOperand.Move(place: val source) => { hasAssign = statement == firstBinding && target == valueTerm && destination.local == 1U64 && source.local == input }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    val secondStart = letState.blocks[0U64].statements.count()
    val moveResult = buildMidLet(c: inout c, state: inout letState, stmtId: secondBinding)
    mut val hasMove: Bool = false
    match letState.blocks[0U64].statements[secondStart] {
        MidStatement.Assign(destination: val destination, value: val value) => {
            match value {
                MidRvalue.StorageBoundary(stmtId: val statement, exprId: _, targetTerm: val target, operand: val operand) => {
                    match operand {
                        MidOperand.Move(place: val moved) => { hasMove = statement == secondBinding && target == valueTerm && destination.local == 2U64 && moved.local == 1U64 }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    mut val letBuilt: Bool = false
    match letResult { MidBuildError.None => { letBuilt = true } _ => {} }
    mut val moveBuilt: Bool = false
    match moveResult { MidBuildError.None => { moveBuilt = true } _ => {} }
    val secondInitializer = match c.arena.stmts[secondBinding] {
        Stmt.Let(mutable: _, nameStart: _, nameLen: _, tyStart: _, tyLen: _, tyIsArray: _, ty: _, init: val init, annotationOccurrence: _) => init
        _ => { panic("missing second initializer") }
    }
    val built = buildParametricMidBody(c: inout c, fnIdx: owner)
    if built.canonical.body == 0U64 { panic("missing canonical body") }
    val body = c.mid.bodies[built.canonical.body - 1U64]
    mut val firstRecorded = false
    mut val secondRecorded = false
    for blockIndex in 0U64..<body.blocks.len {
        val block = c.mid.blocks[body.blocks.start + blockIndex]
        for statementIndex in 0U64..<block.statements.len {
            val statement = c.mid.statements[block.statements.start + statementIndex]
            if statement.value != 0U64 {
                val value = c.mid.rvalues[statement.value - 1U64]
                if value.tag == 20U64 {
                    if value.sourceStmt == firstBinding && value.exprId == initializer { firstRecorded = true }
                    if value.sourceStmt == secondBinding && value.exprId == secondInitializer { secondRecorded = true }
                }
            }
        }
    }
    if !firstRecorded || !secondRecorded { panic("canonical storage lost its initializer identity") }
    if firstLocal == 0U64 && secondLocal == 1U64 && outer.found && outer.local == 0U64 && inner.found && inner.local == 1U64 && !missing.found && place.found && place.place.local == 0U64 && !absentPlace.found && letBuilt && moveBuilt && input == 0U64 && letState.locals.count() == 3U64 && hasAssign && hasMove && letState.locals[1U64].isUnique && letState.locals[2U64].isUnique {
        write(s: "binding-identity\n")
    } else {
        write(s: "wrong-binding\n")
    }
}
