use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, identValueCode }
use /Mid only { MidBuildState, MidBuildError, MidOperand, MidRvalue, MidStatement, addMidLocal, midLocalForBinding, midPlaceForRecordedIdent, buildMidLet }

fn main() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="binding-cfg.pw" text="unique struct File {{}} fn probe(file: move File) {{ val first = move file val second = move first }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    val function = c.arena.functionAt(index: owner)
    val parameter = c.funcParamAt(params: function.params, index: 0U64)
    val valueTerm = parameter.ty
    val firstBinding = c.blockStmtAt(blkId: function.body, index: 0U64)
    val secondBinding = c.blockStmtAt(blkId: function.body, index: 1U64)
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state: MidBuildState = <MidBuildState.initial sourceFunction=0U64 />
    val firstLocal = addMidLocal(state: inout state, declarationTarget: 10U64, typeTerm: valueTerm, isUnique: true, isParameter: false, ownsAtEntry: false)
    val secondLocal = addMidLocal(state: inout state, declarationTarget: 20U64, typeTerm: valueTerm, isUnique: true, isParameter: false, ownsAtEntry: false)
    val outer = midLocalForBinding(state: state, declarationTarget: 10U64)
    val inner = midLocalForBinding(state: state, declarationTarget: 20U64)
    val missing = midLocalForBinding(state: state, declarationTarget: 30U64)
    // Pure Mid binding lookup has explicit local identities and type input.
    // Its navigation probe does not forge a source semantic result.
    val bindingProbe = c.pushExpr(e: <Expr.Ident start=parameter.nameStart len=parameter.nameLen />)
    while c.typeCache.identBind.count() <= bindingProbe { c.typeCache.identBind.append(identValueCode()) }
    while c.typeCache.identTarget.count() <= bindingProbe { c.typeCache.identTarget.append(20U64) }
    val place = midPlaceForRecordedIdent(c: inout c, state: state, exprId: bindingProbe, typeTerm: valueTerm)
    c.typeCache.identTarget.set(i: bindingProbe, value: 30U64)
    val absentPlace = midPlaceForRecordedIdent(c: inout c, state: state, exprId: bindingProbe, typeTerm: valueTerm)
    mut val letState = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val input = addMidLocal(state: inout letState, declarationTarget: parameter.nameStart, typeTerm: valueTerm, isUnique: true, isParameter: true, ownsAtEntry: true)
    val letResult = buildMidLet(c: inout c, state: inout letState, stmtId: firstBinding)
    mut val hasAssign: Bool = false
    match letState.blocks[0U64].statements[0U64] {
        MidStatement.Assign(destination: val destination, value: val value) => {
            match value {
                MidRvalue.StorageBoundary(stmtId: val statement, targetTerm: val target, operand: val operand) => {
                    match operand {
                        MidOperand.Move(place: val source) => { hasAssign = statement == firstBinding && target == valueTerm && destination.local == 1U64 && source.local == input }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    val secondStart = letState.blocks[0U64].statements.count()
    val moveResult = buildMidLet(c: inout c, state: inout letState, stmtId: secondBinding)
    mut val hasMove: Bool = false
    match letState.blocks[0U64].statements[secondStart] {
        MidStatement.Assign(destination: val destination, value: val value) => {
            match value {
                MidRvalue.StorageBoundary(stmtId: val statement, targetTerm: val target, operand: val operand) => {
                    match operand {
                        MidOperand.Move(place: val moved) => { hasMove = statement == secondBinding && target == valueTerm && destination.local == 2U64 && moved.local == 1U64 }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    mut val letBuilt: Bool = false
    match letResult { MidBuildError.None => { letBuilt = true } _ => {} }
    mut val moveBuilt: Bool = false
    match moveResult { MidBuildError.None => { moveBuilt = true } _ => {} }
    if firstLocal == 0U64 && secondLocal == 1U64 && outer.found && outer.local == 0U64 && inner.found && inner.local == 1U64 && !missing.found && place.found && place.place.local == 1U64 && !absentPlace.found && letBuilt && moveBuilt && input == 0U64 && letState.locals.count() == 3U64 && hasAssign && hasMove && letState.locals[1U64].isUnique && letState.locals[2U64].isUnique {
        write(s: "binding-identity\n")
    } else {
        write(s: "wrong-binding\n")
    }
}
