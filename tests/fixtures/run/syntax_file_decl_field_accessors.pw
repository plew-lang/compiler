import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxDeclFieldCount, syntaxDeclField, syntaxField, syntaxType, DeclId }
import @Std/Io with { print }

fn main() {
    val source = "struct Pair { mut val left: Array[U8] }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    val field = syntaxField(file: file, id: syntaxDeclField(file: file, decl: decl, index: 0U64))
    val ty = syntaxType(file: file, id: field.ty)
    print(syntaxDeclFieldCount(file: file, decl: decl))
    print(field.name.end - field.name.start)
    if field.isMut { print(1U64) } else { print(0U64) }
    print(ty.name.end - ty.name.start)
}
