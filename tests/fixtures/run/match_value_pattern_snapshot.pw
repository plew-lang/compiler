use @Std/Io only { print }
use @Std/Core only { Eq }
enum E { A B }
mut val subject: E = <E.A />
mut val calls = 0I64
impl E as Eq {
    assoc fn eq(lhs~: Self, rhs~: Self) -> Bool {
        calls += 1I64
        subject = <E.B />
        return false
    }
}
fn main() {
    val expected = <E.B />
    print(match subject { expected => 0I64 E.A => 7I64 E.B => 9I64 })
    print(calls)
}
