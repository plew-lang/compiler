import /Frontend with { Comp, intern }
import /Ir with { InternedSpan }
import @Std/Io with { write }
fn main() {
    mut val compiler = <Comp />
    compiler.arena.bytes = "aiai".bytes()
    val first = intern(c: inout compiler, start: 0U64, len: 1U64)
    val second = intern(c: inout compiler, start: 1U64, len: 1U64)
    if first == second || first == 0U64 || second == 0U64 { panic "distinct names" }
    // These spellings share the initial bucket. Force equal cached hashes to
    // test that a hash match still requires content equality.
    val original = compiler.interner.entries[first - 1U64]
    compiler.interner.entries[first - 1U64] = <InternedSpan start=original.start len=original.len hash=compiler.interner.entries[second - 1U64].hash />
    if intern(c: inout compiler, start: 3U64, len: 1U64) != second { panic "hash is not identity" }
    compiler.interner.entries[first - 1U64] = original
    val text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".bytes()
    val start = compiler.arena.bytes.count()
    for val byte in text { compiler.arena.bytes.append(byte) }
    for val byte in text { compiler.arena.bytes.append(byte) }
    mut val ids: Array[U64] = []
    mut val index = 0U64
    while index < text.count() {
        ids.append(intern(c: inout compiler, start: start + index, len: 1U64))
        index += 1U64
    }
    index = 0U64
    while index < text.count() {
        if intern(c: inout compiler, start: start + text.count() + index, len: 1U64) != ids[index] { panic "growth changed identity" }
        index += 1U64
    }
    val count = compiler.interner.entries.count()
    mut val fork = compiler
    val extra = fork.arena.bytes.count()
    for val byte in "different".bytes() { fork.arena.bytes.append(byte) }
    if intern(c: inout fork, start: extra, len: 9U64) != count + 1U64 { panic "fork insertion" }
    if compiler.interner.entries.count() != count || fork.interner.entries.count() != count + 1U64 { panic "copy isolation" }
    if intern(c: inout compiler, start: 2U64, len: 1U64) != first { panic "source changed" }
    if intern(c: inout fork, start: 2U64, len: 1U64) != first { panic "fork identity" }
    write(s: "interner-cache-ok\n")
}
