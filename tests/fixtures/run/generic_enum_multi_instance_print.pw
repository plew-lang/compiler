import @Std/Io with { print }
import @Std/Core

fn main() {
    val ints = [<Optional[I64].Some v=7I64 />, <Optional[I64].None />]
    for val value in ints {
        match value {
            Optional.Some(v: val item) => { print(item) }
            Optional.None => { print(0I64) }
        }
    }
    val texts = [<Optional[String].Some v="alpha" />, <Optional[String].None />]
    for val value in texts {
        match value {
            Optional.Some(v: val item) => { print(item) }
            Optional.None => { print("n") }
        }
    }
}
