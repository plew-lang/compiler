use @Plew/Syntax only { Lexer, P, TraitId, TopItemAst, lex, parseItem, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxTrait, syntaxTraitReq, syntaxSig }
use @Std/Io only { print }

fn main() {
    val source = "trait Actions {{ move fn take() borrow fn read() inout fn change() async fn wait() async move fn finish() }}"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val declaration = syntaxTrait(file: file, id: <TraitId raw=syntaxTopItemPayload(file: file, item: item) />)
    mut val index = 0U64
    while index < 5U64 {
        val signature = syntaxSig(file: file, id: syntaxTraitReq(file: file, trait: declaration, index: index))
        print(signature.selfMove)
        print(signature.selfInout)
        print(signature.isAsync)
        index += 1U64
    }
    match parseItem(source: source, start: 0U64, end: source.bytes().count()) {
        TopItemAst.Trait(t: val declaration) => {
            for val signature in declaration.reqs {
                print(signature.selfMove)
                print(signature.selfInout)
                print(signature.isAsync)
            }
        }
        _ => { print("unexpected declaration") }
    }
}
