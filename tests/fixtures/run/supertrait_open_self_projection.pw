use @Std/Io only { print }
trait Source { type Item }
trait Parent[T] { fn read() -> T }
trait Child: Parent[Self#Source.Item] + Source {}
struct Receiver {}
impl Receiver as Source { type Item=I64 }
impl Receiver as Parent[I64] { fn read() -> I64 { return 42I64 } }
impl Receiver as Child {}
fn readChild[T](value: T) -> T#Source.Item where T: Child { return value.read() }
fn main() { print(readChild(value: <Receiver />)) }
