import @Std/Core with { assert }
import @Std/Io with { print }

struct Counter {
    pub val value: I64
}

pub impl Counter {
    factory

    inout fn read() -> I64 {
        return self.value
    }
}

fn invoke(counter: inout Counter) -> I64 {
    return counter.read()
}

fn main() {
    mut val counter = <Counter value=1I64 />
    assert(invoke(counter: inout counter) == 1I64)
    print("ok")
}
