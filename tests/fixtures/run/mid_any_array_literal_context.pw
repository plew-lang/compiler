import @Std/Io with { print }

// The call's selected Array[any Shape] parameter is the literal's result
// context.  Mid must therefore build the array with the frontend-selected
// element conversion; it must not infer Array[Sq] and let LLVM rediscover an
// existential conversion.
trait Shape { fn area() -> I64 }

struct Sq { pub val side: I64 }
pub impl Sq { factory }
pub impl Sq as Shape { fn area() -> I64 { return self.side * self.side } }

fn total(shapes: Array[any Shape]) -> I64 {
    return shapes[0U64].area() + shapes[1U64].area()
}

fn main() {
    print(total(shapes: [<Sq side=2I64 />, <Sq side=3I64 />]))
}
