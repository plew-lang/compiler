use @Std/Io only { print }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { CallArgumentPassing, Expr, FinalAwaitResolution, InstanceEnvironment }
use /Mid only { planCanonicalMidAsyncFrame, buildParametricMidBody, MidBuildError, MidInstantiateError, MidVerifyError, MidRange, MidBlockNode, MidStatementNode, MidAccessError, elaborateCanonicalMidAccesses, instantiateCanonicalMidBody, elaborateCanonicalMidDrops, verifyCanonicalMidBody }

fn main() {
    mut val compiler: Comp = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="await-cfg.pw" text="struct Promise[T] {{}} async fn probe(value: Promise[I64]) {{ await value }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val sourceOwner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val function = compiler.arena.functionAt(index: sourceOwner)
    val promise = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val integer = compiler.arena.typeAt(index: promise).args[0U64]
    mut val awaitExpression = compiler.arena.exprs.count()
    mut val operandExpression = compiler.arena.exprs.count()
    mut val expressionIndex = 0U64
    while expressionIndex < compiler.arena.exprs.count() {
        match compiler.arena.exprs[expressionIndex] {
            Expr.Await(val operand) => { awaitExpression = expressionIndex operandExpression = operand }
            _ => {}
        }
        expressionIndex += 1U64
    }
    assert(awaitExpression < compiler.arena.exprs.count())
    compiler.prepareLexicalBody(fnIdx: sourceOwner).unwrap()
    val built = buildParametricMidBody(c: inout compiler, fnIdx: sourceOwner)
    match built.error { MidBuildError.None => {} _ => { assert(false) } }
    val node = compiler.mid.bodies[built.canonical.body - 1U64]
    assert(node.blocks.len == 2U64)
    val suspend = compiler.mid.terminators[compiler.mid.blocks[node.blocks.start].terminator - 1U64]
    assert(suspend.tag == 10U64)
    assert(suspend.resume == 1U64)
    assert(suspend.exprId == awaitExpression)
    val borrowed = compiler.mid.operands[suspend.value - 1U64]
    assert(borrowed.tag == 3U64)
    assert(compiler.mid.places[borrowed.place - 1U64].local != 0U64)
    val bodyId = compiler.internBodyInstance(fnIdx: sourceOwner, environment: <InstanceEnvironment />)
    compiler.arena.setBodySignature(bodyId: bodyId, parameters: [promise], passings: [<CallArgumentPassing.Borrow />], result: 0U64)
    // A correctly typed-looking local is not a substitute for the frozen fact.
    val missing = instantiateCanonicalMidBody(c: inout compiler, body: built.canonical, bodyId: bodyId)
    match missing.error { MidInstantiateError.MissingFinalResolution => {} _ => { assert(false) } }
    compiler.putFinalAwait(fact: <FinalAwaitResolution bodyId=bodyId exprId=awaitExpression operandExprId=operandExpression promiseTypeRef=promise resultTypeRef=integer />)
    val grounded = instantiateCanonicalMidBody(c: inout compiler, body: built.canonical, bodyId: bodyId)
    match grounded.error { MidInstantiateError.None => {} _ => { assert(false) } }
    val access = elaborateCanonicalMidAccesses(c: inout compiler, canonical: grounded.body)
    match access.error { MidAccessError.None => {} _ => { assert(false) } }
    val dropped = elaborateCanonicalMidDrops(arena: inout compiler.mid, canonical: access.body)
    val checked = verifyCanonicalMidBody(c: inout compiler, canonical: dropped)
    match checked.error { MidVerifyError.None => {} _ => { assert(false) } }
    val frame = planCanonicalMidAsyncFrame(c: compiler, canonical: dropped)
    assert(frame.valid)
    assert(frame.storedLocals[0U64])
    assert(frame.storedLocals[1U64])
    assert(!frame.storedLocals[2U64])
    // A Read borrow of a copyable Promise must not revive an owner that was
    // dropped before suspension. Keep the rest of the verified body unchanged.
    val finalBody = compiler.mid.bodies[dropped.body - 1U64]
    val original = compiler.mid.blocks[finalBody.blocks.start]
    val waiting = compiler.mid.terminators[original.terminator - 1U64]
    val owner = compiler.mid.operands[waiting.value - 1U64].place
    val start: U64 = compiler.mid.statements.count()
    mut val index: U64 = 0U64
    while index < original.statements.len {
        compiler.mid.statements.append(compiler.mid.statements[original.statements.start + index])
        index += 1U64
    }
    compiler.mid.statements.append(<MidStatementNode tag=3U64 destination=owner />)
    compiler.mid.blocks.set(i: finalBody.blocks.start, value: <MidBlockNode statements=<MidRange start=start len=original.statements.len + 1U64 /> terminator=original.terminator />)
    val consumed = verifyCanonicalMidBody(c: inout compiler, canonical: dropped)
    match consumed.error { MidVerifyError.MoveUnavailable => {} _ => { assert(false) } }
    compiler.mid.blocks.set(i: finalBody.blocks.start, value: original)
    // Wrong completion type must not silently change the destination's type.
    compiler.putFinalAwait(fact: <FinalAwaitResolution bodyId=bodyId exprId=awaitExpression operandExprId=operandExpression promiseTypeRef=promise resultTypeRef=promise />)
    val wrong = instantiateCanonicalMidBody(c: inout compiler, body: built.canonical, bodyId: bodyId)
    match wrong.error { MidInstantiateError.InvalidFinalResolution => {} _ => { assert(false) } }
    print("ok")
}
