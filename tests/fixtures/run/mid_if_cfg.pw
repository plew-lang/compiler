use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Stmt, InstanceEnvironment, FinalStorageResolution, ValueConversionProof }
use /Mid only { MidInstantiateError, MidBuildError, MidBuildState, MidBody, MidOwnership, MidStatement, MidTerminator, MidVerifyError, addMidLocal, analyzeCanonicalMidOwnership, buildMidBlock, buildMidIf, elaborateCanonicalMidDrops, instantiateCanonicalMidBody, verifyCanonicalMidBody }

fn main() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="if-cfg.pw" text="unique struct File {{}} fn probe(file: move File) {{ if true {{ val transferred = move file }} else {{}} }} fn returning() {{ return }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "probe").nameId)
    val function = c.arena.functionAt(index: owner)
    val parameter = c.funcParamAt(params: function.params, index: 0U64)
    val fileTerm = parameter.ty
    val ifStatement = c.blockStmtAt(blkId: function.body, index: 0U64)
    val bindingStatement = match c.arena.stmts[ifStatement] {
        Stmt.If(cond: _, thenBlk: val thenBlock, elseBlk: _, hasElse: _) => { give c.blockStmtAt(blkId: thenBlock, index: 0U64) }
        _ => { panic "missing if probe" }
    }
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val fileLocal = addMidLocal(state: inout state, declarationTarget: parameter.nameStart, typeTerm: fileTerm, isUnique: true, isParameter: true, ownsAtEntry: true)
    val result = buildMidIf(c: inout c, state: inout state, stmtId: ifStatement)
    val body: MidBody = <MidBody locals=state.locals scopes=state.scopes blocks=state.blocks entry=0U64 />
    val frozen = c.mid.store(body: body)
    val ownership = analyzeCanonicalMidOwnership(arena: c.mid, canonical: frozen)
    val joinState: MidOwnership = ownership[3U64][0U64]
    // The builder yields parametric storage boundaries. Publish the concrete
    // frontend fact and instantiate before drop elaboration and verification.
    val instance = c.internBodyInstance(fnIdx: owner, environment: <InstanceEnvironment />)
    val identity = c.freezeValueConversionProof(proof: <ValueConversionProof.Identity />)
    c.putFinalStorage(fact: <FinalStorageResolution bodyId=instance stmtId=bindingStatement sourceTypeRef=fileTerm targetTypeRef=fileTerm conversion=identity />)
    val concrete = instantiateCanonicalMidBody(c: inout c, body: c.mid.store(body: body), bodyId: instance)
    mut val instantiated: Bool = false
    match concrete.error { MidInstantiateError.None => { instantiated = true } _ => {} }
    val elaborated = elaborateCanonicalMidDrops(arena: inout c.mid, canonical: concrete.body)
    mut val hasConditionalDrop: Bool = false
    val node = c.mid.bodies[elaborated.body - 1U64]
    val join = c.mid.blocks[node.blocks.start + 3U64]
    if c.mid.statements[join.statements.start].tag == 4U64 { hasConditionalDrop = true }
    mut val elaboratedValid: Bool = false
    match verifyCanonicalMidBody(c: inout c, canonical: elaborated).error {
        MidVerifyError.None => { elaboratedValid = true }
        _ => {}
    }
    val returnOwner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "returning").nameId)
    c.prepareLexicalBody(fnIdx: returnOwner).unwrap()
    val returnFacts = c.preparedFunctionSemanticFacts(fnIdx: returnOwner).unwrap()
    mut val returnState = <MidBuildState.initial sourceFunction=returnOwner sourceFacts=<Optional.Some v=returnFacts /> />
    val returnResult = buildMidBlock(c: inout c, state: inout returnState, blockId: c.arena.functionAt(index: returnOwner).body)
    mut val returned: Bool = false
    match returnResult { MidBuildError.None => { match returnState.blocks[0U64].terminator { MidTerminator.Return => { returned = true } _ => {} } } _ => {} }
    mut val built: Bool = false
    match result { MidBuildError.None => { built = true } _ => {} }
    match joinState {
        MidOwnership.MaybeOwned => {
            if built && instantiated && fileLocal == 0U64 && state.blocks.count() == 4U64 && hasConditionalDrop && elaboratedValid && returned {
                write(s: "if-move-cfg\n")
            } else {
                write(s: "wrong-cfg\n")
            }
        }
        _ => { write(s: "wrong-ownership\n") }
    }
}
