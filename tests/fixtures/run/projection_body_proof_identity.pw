use @Std/Io only { print }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendDeclarations }
use /SourceAccess only { SourceAccess }
use /Ir only { InstanceEnvironment, PatternTypeInput }
fn main() {
    mut val compiler = <Comp />
    val source = "trait P[T] {{ type Item }}\nstruct First {{}}\nstruct Second {{}}\nimpl First as P[I64] {{ type Item=I64 }}\nimpl Second as P[I64] {{ type Item=Bool }}\nimpl First as P[Bool] {{ type Item=Bool }}\nfn probe(first: First, second: Second, projection: Second#P[I64].Item, flag: Bool, otherInstance: First#P[Bool].Item, sameInstance: First#P[I64].Item, integer: I64) {{}}\n"
    analyzeFrontendDeclarations(c: inout compiler, input: <FrontendInput.Text text=source path="proof.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.functionAt(index: 0U64)
    val first = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val projection = compiler.funcParamAt(params: function.params, index: 2U64).ty
    val expected = compiler.funcParamAt(params: function.params, index: 3U64).ty
    val term = compiler.arena.typeAt(index: projection)
    val trait = compiler.decls.traitAt(index: 0U64)
    val proof = compiler.concreteConformanceProof(baseRef: first, traitId: trait.nameId, traitOwner: trait.nameStart, traitArgs: <PatternTypeInput.Values values=term.assocTraitArgs />).unwrap()
    val result = compiler.closeBodyProjectionTerms(ref: projection, environment: <InstanceEnvironment receiverRef=first proof=proof />, selfRef: first, itemRef: 0U64).unwrap()
    assert(compiler.typeRefEq(a: result, b: expected))
    val otherInstance = compiler.funcParamAt(params: function.params, index: 4U64).ty
    val otherResult = compiler.closeBodyProjectionTerms(ref: otherInstance, environment: <InstanceEnvironment receiverRef=first proof=proof />, selfRef: first, itemRef: 0U64).unwrap()
    assert(compiler.typeRefEq(a: otherResult, b: expected))
    val sameInstance = compiler.funcParamAt(params: function.params, index: 5U64).ty
    val integer = compiler.funcParamAt(params: function.params, index: 6U64).ty
    val sameResult = compiler.closeBodyProjectionTerms(ref: sameInstance, environment: <InstanceEnvironment receiverRef=first proof=proof />, selfRef: first, itemRef: 0U64).unwrap()
    assert(compiler.typeRefEq(a: sameResult, b: integer))
    print("ok")
}
