// Corrupted frozen retag evidence must not publish owner success; guarantee
// erasure remains valid in both local admission and whole-target closure.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, DeclarationConversion, ValueConversionProof }
use @Std/Io only { print }
fn check(text: String, compatible: Bool, identity: Bool = false, mismatched: Bool = false) {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text text=text path="retag-proof.pw" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.functionAt(index: 0U64)
    val source = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val target = compiler.funcParamAt(params: function.params, index: 1U64).ty
    val sourceParameter = compiler.funcParamAt(params: function.params, index: 0U64)
    val expression = compiler.pushExpr(e: <Expr.Ident start=sourceParameter.nameStart len=sourceParameter.nameLen />)
    compiler.cur.checkFn = 0U64
    compiler.addLocalCn(nameStart: sourceParameter.nameStart, nameLen: sourceParameter.nameLen, tyStart: sourceParameter.tyStart, tyLen: sourceParameter.tyLen, isArray: sourceParameter.tyIsArray, ty: source, isInout: false, isMut: false, owned: false, cnum: 0U64)
    compiler.recordExpr(exprId: expression).unwrap()
    compiler.cur.recordCallTemplates = true
    compiler.recordDeclarationConversion(exprId: expression, target: target).unwrap()
    val original = compiler.decls.declarationConversions[0U64]
    val conversion = if identity { give <ValueConversionProof.Identity /> }
        else if mismatched { give <ValueConversionProof.ExistentialRetag sourceRef=target targetRef=source /> }
        else { give <ValueConversionProof.ExistentialRetag sourceRef=source targetRef=target /> }
    val proof = compiler.freezeValueConversionProof(proof: conversion)
    val message = if identity { give "identity conversion changes the source value type" }
        else if mismatched { give "conversion proof does not match its recorded source and target types" }
        else { give "existential retag changes its dynamic interface or strengthens a guarantee" }
    compiler.decls.declarationConversions[0U64] = <DeclarationConversion site=original.site source=source target=target proof=proof />
    match compiler.prepareLexicalBody(fnIdx: 0U64) {
        Result.Ok(value: _) => { if !compatible { panic("owner accepted invalid retag") } }
        Result.Err(error: val diagnostic) => {
            if compatible || diagnostic.message != message { panic(diagnostic.message) }
        }
    }
    match compiler.checkRecordedMemberObligations() {
        Result.Ok(value: _) => { if !compatible { panic("whole target accepted invalid retag") } }
        Result.Err(error: val diagnostic) => {
            if compatible || diagnostic.message != message { panic(diagnostic.message) }
        }
    }
}
fn main() {
    check(text: "trait P {{}} fn probe(source: any P, target: any sendable P) {{}}", compatible: false)
    check(text: "trait P {{}} trait Q {{}} fn probe(source: any P, target: any Q) {{}}", compatible: false)
    check(text: "trait P {{}} fn probe(source: any sendable P, target: any P) {{}}", compatible: true)
    check(text: "trait P {{}} fn probe(source: any P, target: any sendable P) {{}}", compatible: false, identity: true)
    check(text: "trait P {{}} fn probe(source: any P, target: any sendable P) {{}}", compatible: false, mismatched: true)
    print("retag-owner-evidence")
}
