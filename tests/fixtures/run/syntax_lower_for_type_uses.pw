// Rebuilding a loop body must preserve its declaration type obligations.
use @Plew/Syntax only { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxTopItemPayload }
use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { Stmt }

fn inspect(source: String) {
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    mut val compiler: Comp = <Comp />
    compiler.appendSrc(from: source.bytes())
    compiler.syntax = file
    val root = compiler.lowerSyntaxBlock(id: decl.body).unwrap()
    match compiler.arena.stmts[compiler.blockStmtAt(blkId: root, index: 0U64)] {
        Stmt.For(varStart: _, varLen: _, varTyStart: _, varTyLen: _, varTy: _, iter: _, val body, isStruct: _, patStart: _, patLen: _, binds: _) => {
            match compiler.blockTypeUses.get(key: body) {
                Optional.Some(v: val uses) => { print(uses.count() > 0U64) }
                Optional.None => { print(false) }
            }
        }
        _ => { print(false) }
    }
}

fn main() {
    inspect(source: "fn body() {{ for Row {{ val number }} in rows {{ val values: Array[I64] = [] }} }}")
    inspect(source: "fn body() {{ for val item: I64 in items {{ val values: Array[I64] = [] }} }}")
}
