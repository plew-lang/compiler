// An empty array still has its recorded element type. Child checking cannot
// establish compatibility with a different complete array type.
use /Frontend only { Comp }
use /Ir only { Expr, TypeRef, Func }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val integerName = compiler.internBytes(s: "I64")
    val booleanName = compiler.internBytes(s: "Bool")
    val arrayName = compiler.internBytes(s: "Array")
    val integer = compiler.pushType(t: <TypeRef nameStart=integerName.nameStart nameLen=integerName.nameLen args=[] />)
    val boolean = compiler.pushType(t: <TypeRef nameStart=booleanName.nameStart nameLen=booleanName.nameLen args=[] />)
    val expected = compiler.pushType(t: <TypeRef nameStart=arrayName.nameStart nameLen=arrayName.nameLen args=[integer] hasDecl=true declOffset=arrayName.nameStart />)
    val actual = compiler.pushType(t: <TypeRef nameStart=arrayName.nameStart nameLen=arrayName.nameLen args=[boolean] hasDecl=true declOffset=arrayName.nameStart />)
    compiler.arena.registerFunction(<Func nameStart=0U64 nameLen=0U64 hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64 hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    compiler.cur.checkFn = 0U64
    val elements = compiler.pushExprs(exprs: [])
    val expression = compiler.pushExpr(e: <Expr.Array elems=elements />)
    compiler.recordSemanticExprTerm(exprId: expression, term: actual)
    match compiler.tcCheckValue(expectedRef: actual, valueExpr: expression, pos: "array-probe") {
        Result.Ok(value: _) => {}
        Result.Err(val error) => { print(error.message) panic "value check rejected matching recorded array" }
    }
    if compiler.tcCheckValue(expectedRef: expected, valueExpr: expression, pos: "array-probe").isOk() { panic "value check ignored recorded array type" }
    if compiler.checkGenericTypeMatch(expectedRef: actual, valueExpr: expression).isErr() { panic "generic check rejected matching recorded array" }
    if compiler.checkGenericTypeMatch(expectedRef: expected, valueExpr: expression).isOk() { panic "empty array children were treated as whole-type compatibility" }
    if !compiler.typeRefEq(a: compiler.inferType(id: expression).unwrap(), b: actual) { panic "recorded array type was lost" }
    val recovered = compiler.exprType(id: expression).unwrap()
    if !compiler.typeRefEq(a: compiler.typedIrRefOfInfo(ti: recovered), b: actual) { panic "legacy reader reopened empty array syntax" }
    print("recorded-array")
}
