// Dictionary[K,V] (ambient lang item, spec/02) via its methods and the subscript
// sugar: `dict[k]` desugars to `.at(key:)` (returns the value, panics if absent)
// and `dict[k] = v` to `.insert(key:, value:)` (insert or update). Construction is
// the empty `[:]` literal (its private internal fields are not externally
// constructible — spec/05). String keys exercise the transitive
// `key.hash[SipHasher]` instantiation.
import @Std/Io with { print }

fn main() {
    mut val d: Dictionary[String, U64] = [:]
    d["alpha"] = 1U64
    d["beta"] = 2U64
    d["alpha"] = 10U64
    print(d.count())
    print(d["alpha"])
    print(d["beta"])
    print(d.getOr(key: "gamma", fallback: 99U64))
    print(d.contains(key: "beta"))
    print(d.contains(key: "gamma"))
}
