// A free-call visibility cause is an owned value, not a reference into a compiler.
use /Diag only { CompileDiagnostic, FreeCallVisibilityRefusal, FreeCallVisibilityKind, DiagnosticLocation, DiagnosticOwner, FailureDomain }
use @Std/Io only { print }
fn diagnostic() -> CompileDiagnostic {
    val path = "field" + ".pw"
    return <CompileDiagnostic.freeCallVisibility refusal=<FreeCallVisibilityRefusal session=7U64 owner=<DiagnosticOwner.Function index=3U64 /> kind=<FreeCallVisibilityKind.PrivateFunction /> argumentsStart=13U64 argumentsCount=1U64 expression=11U64 location=<DiagnosticLocation.File path=path line=19I64 /> /> />
}
fn location() -> DiagnosticLocation { return diagnostic().location() }
fn main() {
    mut val cache: Dictionary[U64, Result[(), CompileDiagnostic]] = [:]
    cache[0U64] = <Result.Err error=diagnostic() />
    val retained = cache[0U64]
    cache = [:]
    match retained {
        Result.Ok(value: _) => { panic("semantic failure became success") }
        Result.Err(error: val failure) => {
            if failure.isSourceRejection() || failure.notes().count() != 0U64 || failure.useAfterMove().isSome() { panic("field cause confused with another diagnostic") }
            match failure.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("raw cause changed domain") } }
            val cause = failure.freeCallVisibility().unwrap()
            if cause.session() != 7U64 || cause.expression() != 11U64 || !cause.kind().same(other: <FreeCallVisibilityKind.PrivateFunction />) || cause.argumentsStart() != 13U64 || cause.argumentsCount() != 1U64 { panic("cause context changed") }
            if failure.message() != <FreeCallVisibilityKind.PrivateFunction />.message() { panic("derived message changed") }
        }
    }
    match location() {
        DiagnosticLocation.File(path: val path, line: val line) => { if path != "field.pw" || line != 19I64 { panic("location died with its cause") } }
        _ => { panic("location changed") }
    }
    print("ok")
}
