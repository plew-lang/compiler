use @Std/Io only { print }

// Covariant container erasure through a generic ENUM (spec/08, SE-0309): assigning an
// `Optional[Concrete]` to an `Optional[any P]` tag-dispatches and boxes the Some-payload
// into the existential (None stays None). The heap-carrying payload is retained so the
// erased value co-owns it — the source Optional stays an independent, still-usable value.
trait Named { fn label() -> String }
struct Person { pub val name: String }
pub impl Person { factory }
pub impl Person as Named { fn label() -> String { return self.name } }
fn describe(o: Optional[any Named]) {
    match o {
        Optional.Some(v: val x) => { print(x.label()) }
        Optional.None => { print("none") }
    }
}
fn person() -> Optional[Person] {
    return <Optional[Person].Some v=<Person name="Ada" /> />
}
struct Group { pub val labels: Array[String] }
pub impl Group { factory }
pub impl Group as Named { fn label() -> String { return self.labels[0U64] } }

fn some[T](value: T) -> Optional[T] {
    return <Optional[T].Some v=value />
}

fn describeErased[T](value: T) where T: Named {
    val erased: Optional[any Named] = some(value: value)
    describe(o: erased)
}

fn main() {
    mut val value: Optional[any Named] = person()
    describe(o: value)
    val none: Optional[Person] = <Optional[Person].None />
    value = none
    describe(o: value)
    value = person()
    describe(o: value)
    describeErased(value: <Person name="Grace" />)
    describeErased(value: <Group labels=["team"] />)
    describeErased(value: <Person name="Lin" />)
}
