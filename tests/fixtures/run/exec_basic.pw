// @Std/Process execOut/execCode: run a shell command, capture stdout + exit code.
use @Std/Io only { print, write }
use @Std/Process only { execOut, execCode }

fn main() {
    write(s: execOut(cmd: "printf 'ab'; printf 'cd'"))
    write(s: "\n")
    print(execCode())          // 0
    val r: String = execOut(cmd: "exit 5")
    print(execCode())          // 5
}
