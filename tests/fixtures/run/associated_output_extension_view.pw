use @Std/Io only { print }

trait Mark[K] {}

extension Extra {
    pub impl Mark[Bool] {
        fn number() -> I64 { return 42I64 }
    }
}

struct Value {}
impl Value as Mark[Bool] {}

trait Source[K] {
    type Item: Mark[Bool]
}
pub impl Source[I64] {
    fn read(value: Item#Extra) -> I64 { return value.number() }
    fn forward(value: Item#Extra) -> Item#Extra { return value }
}

struct Provider {}
pub impl Provider { factory }
impl Provider as Source[I64] { type Item = Value }

fn main() {
    val provider = <Provider />
    val value = <Value />#Extra
    print(provider.read(value: value))
    print(provider.forward(value: value).number())
}
