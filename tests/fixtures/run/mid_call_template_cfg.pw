use @Std/Io only { write }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Stmt }
use /Mid only { MidBuildError, MidBuildState, MidCallTarget, MidOperand, MidTerminator, addMidLocal, buildMidBlock }

fn main() {
    mut val c: Comp = <Comp />
    analyzeFrontendForRequests(c: inout c,
        input: <FrontendInput.Text path="call-cfg.pw" text="unique struct File {{}} fn number() -> I64 {{ return 1I64 }} fn consume(file: move File) {{}} fn plain() {{ number() }} fn moving(file: move File) {{ consume(file: move file) }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val owner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "plain").nameId)
    val function = c.arena.functionAt(index: owner)
    val callExpression = match c.arena.stmts[c.blockStmtAt(blkId: function.body, index: 0U64)] {
        Stmt.ExprStmt(expr: val expression) => expression
        _ => { panic "missing ordinary call" }
    }
    c.prepareLexicalBody(fnIdx: owner).unwrap()
    val key = c.callTemplateForSourceBody(fnIdx: owner, exprId: callExpression).unwrap().siteKey
    val facts = c.preparedFunctionSemanticFacts(fnIdx: owner).unwrap()
    mut val state = <MidBuildState.initial sourceFunction=owner sourceFacts=<Optional.Some v=facts /> />
    val result = buildMidBlock(c: inout c, state: inout state, blockId: function.body)
    mut val built: Bool = false
    match result { MidBuildError.None => { built = true } _ => {} }
    match state.blocks[0U64].terminator {
        MidTerminator.Call(callee: val callee, receiver: _, args: val args, destination: _, target: val target) => {
            match callee {
                MidCallTarget.Template(site: val site) => {
                    if built && args.count() == 0U64 && target == 1U64 && site.ownerFnIdx == key.ownerFnIdx && site.originKind == key.originKind {
                        write(s: "template-call\n")
                    } else {
                        write(s: "wrong-call\n")
                    }
                }
                _ => { write(s: "resolved-too-early\n") }
            }
        }
        _ => { write(s: "missing-call\n") }
    }
    // A distinct owner records a move call. No successful template is mutated.
    val moveOwner = c.arena.firstFunctionNamed(nameId: c.internBytes(s: "moving").nameId)
    val moveFunction = c.arena.functionAt(index: moveOwner)
    val parameter = c.funcParamAt(params: moveFunction.params, index: 0U64)
    c.prepareLexicalBody(fnIdx: moveOwner).unwrap()
    val moveFacts = c.preparedFunctionSemanticFacts(fnIdx: moveOwner).unwrap()
    mut val moveState = <MidBuildState.initial sourceFunction=moveOwner sourceFacts=<Optional.Some v=moveFacts /> />
    val file = addMidLocal(state: inout moveState, declarationTarget: parameter.nameStart, typeTerm: parameter.ty, isUnique: true, isParameter: true, ownsAtEntry: true)
    val moveResult = buildMidBlock(c: inout c, state: inout moveState, blockId: moveFunction.body)
    // No intervening evaluation: the call consumes the source at this point.
    mut val moved: Bool = false
    match moveState.blocks[0U64].terminator {
        MidTerminator.Call(callee: _, receiver: _, args: val args, destination: _, target: _) => {
            match args[0U64] { MidOperand.Move(place: val place) => { moved = place.local == file } _ => {} }
        }
        _ => {}
    }
    mut val moveBuilt: Bool = false
    match moveResult { MidBuildError.None => { moveBuilt = true } _ => {} }
    if file == 0U64 && moveBuilt && moved {
        write(s: "template-move\n")
    } else {
        write(s: "wrong-template-move\n")
    }
}
