use @Std/Core only { Index }
use @Std/Io only { print }
trait TaggedIndex: Index[U64, Output=I64] {}
struct Shelf { pub val item: I64 }
pub impl Shelf { factory }
pub impl Shelf as Index[U64] { type Output = I64 fn index(key: U64) -> I64 { return self.item } }
pub impl Shelf as TaggedIndex {}
fn erase[T](value: T) -> any TaggedIndex where T: TaggedIndex { return value }
fn main() { val shelf: any TaggedIndex = erase(value: <Shelf item=53I64 />) print(shelf[0U64]) }
