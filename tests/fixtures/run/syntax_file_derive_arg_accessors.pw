import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDirective, syntaxDirectiveReq, syntaxDeriveReq, syntaxDeriveReqArgCount, syntaxDeriveReqArg, syntaxMakeField, syntaxExpr, DirectiveId }
import @Std/Io with { print }

fn main() {
    val source = "@[IntTryFrom(sources: [\"I8\"])]\nstruct Count {}\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val directive = syntaxDirective(file: file, id: <DirectiveId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val req = syntaxDeriveReq(file: file, id: syntaxDirectiveReq(file: file, directive: directive, index: 0U64))
    val arg = syntaxMakeField(file: file, id: syntaxDeriveReqArg(file: file, req: req, index: 0U64))
    val value = syntaxExpr(file: file, id: arg.value)
    print(syntaxDeriveReqArgCount(file: file, req: req))
    print(arg.name.end - arg.name.start)
    print(value.elems.count)
}
