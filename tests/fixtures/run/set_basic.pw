import @Std/Io with { print }
import @Std/Set with { Set }

// Set[E] (spec/02): a CoW hash set built on the Dictionary floor (keys only).
// No literal — constructed via Set.from / Set.new. Membership, dedup, removal.
fn main() {
    mut val s: Set[I64] = Set.from(source: [1I64, 2I64, 2I64, 3I64, 3I64, 3I64])
    print(s.count())                  // 3 — duplicates collapse
    print(s.contains(4I64))         // 0
    print(s.contains(2I64))         // 1
    s.insert(4I64)
    s.insert(2I64)                  // already present — no-op
    print(s.count())                  // 4
    print(s.contains(4I64))         // 1
    s.remove(4I64)
    s.remove(99I64)                 // absent — no-op
    print(s.count())                  // 3
    print(s.contains(4I64))         // 0
    print(s.contains(1I64))         // 1

    mut val e: Set[String] = Set.new()
    e.insert("x")
    e.insert("y")
    e.insert("x")                   // dup
    print(e.count())                  // 2
    print(e.contains("y"))          // 1
    e.remove("y")
    print(e.contains("y"))          // 0
    print(e.count())                  // 1
}
