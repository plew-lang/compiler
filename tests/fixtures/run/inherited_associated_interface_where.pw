use @Std/Io only { print }

trait Marker {}
trait Source { type Item: Marker }
trait Select { type Value: Marker }
struct Wrapper[T] {}
impl[T] Wrapper[T] as Select where T: Source { type Value = T#Source.Item }

trait Parent { type Input: Source }
trait Service: Parent {
    fn fetch() -> I64 where Wrapper[Self#Parent.Input]#Select.Value: Marker
}

struct Element {}
impl Element as Marker {}
struct Entry {}
impl Entry as Source { type Item = Element }
struct Worker {}
impl Worker as Parent { type Input = Entry }
impl Worker as Service { fn fetch() -> I64 { return 42I64 } }

fn main() {
    val erased: any Service = <Worker />
    print(erased.fetch())
}
