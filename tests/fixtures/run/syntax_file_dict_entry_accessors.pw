import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, syntaxFileTopLevel, syntaxTopItemPayload, syntaxDecl, syntaxBlock, syntaxBlockStmt, syntaxStmt, syntaxExpr, syntaxExprDictEntryCount, syntaxExprDictKey, syntaxExprDictValue, DeclId, SyntaxExprKind }
import @Std/Io with { print }

fn main() {
    val source = "fn main() { val values = [1U64: 2U64] }\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: syntaxFileTopLevel(file: file, index: 0U64)) />)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: syntaxBlock(file: file, id: decl.body), index: 0U64))
    val dict = syntaxExpr(file: file, id: stmt.child0)
    val key = syntaxExpr(file: file, id: syntaxExprDictKey(file: file, expr: dict, index: 0U64))
    val value = syntaxExpr(file: file, id: syntaxExprDictValue(file: file, expr: dict, index: 0U64))
    match dict.kind {
        SyntaxExprKind.DictLit => { print(1U64) }
        _ => { print(0U64) }
    }
    print(syntaxExprDictEntryCount(file: file, expr: dict))
    match key.kind {
        SyntaxExprKind.IntLit => { print(1U64) }
        _ => { print(0U64) }
    }
    match value.kind {
        SyntaxExprKind.IntLit => { print(1U64) }
        _ => { print(0U64) }
    }
}
