use @Plew/Syntax only { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxTopItemPayload, syntaxBlock, syntaxBlockStmt, syntaxStmt, SyntaxStmtKind, syntaxConditionClause, parseExprFrom, parseBlockFrom, ExprAst, StmtAst }
use @Std/Io only { print }
fn main() {
    val source = "fn body() {{ if (item: val value) = (item: 2I64) && false {{}} else {{}} }}"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    val body = syntaxBlock(file: file, id: decl.body)
    val branch = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: body, index: 0U64))
    print(match branch.kind { SyntaxStmtKind.IfChain => true _ => false })
    print(branch.conditions.count)
    print(syntaxConditionClause(file: file, conditions: branch.conditions, index: 0U64).isBinding)
    print(syntaxConditionClause(file: file, conditions: branch.conditions, index: 1U64).isBinding)
    match parseExprFrom(source: "if (item: val value) = (item: 2I64) && false {{ give value }} else {{ give 9I64 }}", start: 0U64) {
        ExprAst.IfChain(val conditions, thenBlk: _, elseBlk: _, span: _) => {
            print(conditions.count())
            print(conditions[0U64].isBinding)
            print(conditions[1U64].isBinding)
        }
        _ => { print(0U64) }
    }
    val block = parseBlockFrom(source: "{{ if (item: val value) = (item: 2I64) && false {{}} else {{}} }}", start: 0U64)
    match block.stmts[0U64] {
        StmtAst.IfChain(val conditions, thenBlk: _, elseBlk: _, span: _) => { print(conditions.count()) }
        _ => { print(0U64) }
    }
}
