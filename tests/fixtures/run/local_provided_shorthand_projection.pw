use @Std/Io only { print }
trait Project[T] { type Item fn item() -> Item }
pub impl[T] Project[T] {
    fn repeat() -> Item {
        val item: Item = self.item()
        return item
    }
}
struct Number {}
impl Number as Project[I64] {
    type Item = I64
    fn item() -> I64 { return 42I64 }
}
fn main() { print(<Number />.repeat()) }
