// Module-scoped visibility permits this use; construction and later access are independent.
import @Std/Io with { print }
import @Std/Core with { MutableRef }
struct C { mut val n: I32 }
pub impl C {
    factory initial(n: I32) { return <C n=n /> }
}
fn main() {
    val r: MutableRef[C] = <MutableRef[C] value=<C.initial n=5 /> />
    r->n = 9I32
    print(r->n)
}
