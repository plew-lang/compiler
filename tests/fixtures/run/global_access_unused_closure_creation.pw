use @Std/Io only { print }
mut val value = 7I64
unique struct Observer {
    pub val unused: I64
    deinit { print(value) }
}
pub impl Observer { factory }
fn update(destination: inout I64) {
    val action = fn() { print(value) }
    destination += 1I64
}
fn unused[T]() {
    update(destination: inout value)
    print(value)
}

fn main() {}
