// The first source construction closes permitted integer-literal context and
// operator selection. Later verification must not be needed to repair Pending.
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess, SourceResource }
use /Ir only { CallTemplate, CallTemplateKind, OperatorSelection }
use @Std/Io only { print }

fn comparison(value: I64) -> Bool { return 0 < value }

fn main() {
    mut val compiler = <Comp />
    val resources = [
        <SourceResource path="plew:std/Lang.pw".bytes() text="pub use ./Core only {{ I64 }}" />,
        <SourceResource path="plew:std/Core.pw".bytes() text="pub extern(plewIntrinsic) {{ struct I64 }} pub trait Sub[Rhs] {{ type Output assoc fn sub(lhs~: Self, rhs~: Rhs) -> Output }} pub impl I64 as Sub[I64] {{ type Output = I64 assoc fn sub(lhs~: I64, rhs~: I64) -> I64 {{ return lhs }} }}" />,
        <SourceResource path="plew:std/OperatorProbe.pw".bytes() text="fn probe(value: I64) -> I64 {{ return 0 - value }}" />,
    ]
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.File path="plew:std/OperatorProbe.pw" />,
        sources: <SourceAccess stdRoot="plew:std/".bytes() resources=resources />).unwrap()
    val owner = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    compiler.recordParametricFunction(fnIdx: owner, recordCallTemplates: true).unwrap()
    mut val found = false
    for operation in compiler.callTemplateSnapshot() {
        match operation.kind {
            CallTemplateKind.Operator(op: _, operands: val operands, resolution: val selection, resultTerm: val result) => {
                match selection {
                    OperatorSelection.Pending => { panic("operator selection waited for verification") }
                    _ => {}
                }
                if operands.len != 2U64 || result == 0U64 { panic("incomplete operator signature") }
                val receiver = compiler.callTemplateOperandAt(index: operands.start)
                if !compiler.typeRefEq(a: compiler.sourceCallArgumentType(source: receiver), b: compiler.arena.functionAt(index: owner).retTy) { panic("receiver did not retain its literal context") }
                found = true
            }
            _ => {}
        }
    }
    if !found { panic("missing operator") }
    compiler.cur.recordCallTemplates = false
    compiler.verifyFunctionDeclaration(fnIdx: owner).unwrap()
    for operation in compiler.callTemplateSnapshot() {
        match operation.kind {
            CallTemplateKind.Operator(op: _, operands: _, resolution: _, resultTerm: _) => {
                val index = compiler.callTemplateIndex(siteKey: operation.siteKey)
                if !compiler.replaceBuildingCallTemplate(index: index, template: <CallTemplate siteKey=operation.siteKey kind=<CallTemplateKind.Pending /> />) { panic("missing operator builder") }
                match compiler.verifyFunctionDeclaration(fnIdx: owner) {
                    Result.Err(error: _) => {}
                    Result.Ok(value: _) => { panic("operator validation reconstructed missing selection") }
                }
                break
            }
            _ => {}
        }
    }
    // The real Std Ord witness returns Ordering; the source expression and
    // emitted result still retain their Bool projection.
    if !comparison(value: 1I64) { panic("comparison lost its source result projection") }
    print("ok")
}
