use @Std/Io only { print }
trait Relation[Target] { fn code(value: Target) -> I64 }
trait Service { fn get() -> I64 where Self: Relation[Self] }
struct Value {}
impl Value as Relation[Value] { fn code(value: Value) -> I64 { return 42I64 } }
impl Value as Service { fn get() -> I64 where Self: Relation[Self] { return self.code(value: self) } }
fn main() { val value = <Value /> print(value.get()) }
