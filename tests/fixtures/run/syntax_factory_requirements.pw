// Anonymous and named factory requirements preserve the same selector in
// the direct SyntaxFile parser and the macro value parser.
import @Plew/Syntax with { Lexer, P, lex, parseProgramSyntaxFile, parseTraitDecl, syntaxFileTopLevel, syntaxTopItemPayload, syntaxTrait, syntaxTraitReqCount, syntaxTraitReq, syntaxSig, syntaxSigParamCount, syntaxSigParam, syntaxParam, TraitId }
import @Std/Io with { print }

fn main() {
    val source = "trait Convert[Source] { factory(from: Source) factory checked(source: Source) }"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val trait = syntaxTrait(file: file, id: <TraitId raw=syntaxTopItemPayload(file: file, item: item) />)
    print(syntaxTraitReqCount(file: file, trait: trait))
    val anonymous = syntaxSig(file: file, id: syntaxTraitReq(file: file, trait: trait, index: 0U64))
    val parameter = syntaxParam(file: file, id: syntaxSigParam(file: file, sig: anonymous, index: 0U64))
    print(anonymous.name.start == parameter.name.start)
    print(anonymous.name.end == parameter.name.end)
    print(syntaxSigParamCount(file: file, sig: anonymous))
    val named = syntaxSig(file: file, id: syntaxTraitReq(file: file, trait: trait, index: 1U64))
    print(named.name.end - named.name.start)
    print(syntaxSigParamCount(file: file, sig: named))
    mut val valueParser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val value = parseTraitDecl(p: inout valueParser)
    print(value.reqs.count())
    print(value.reqs[0U64].name)
    print(value.reqs[0U64].params.count())
    print(value.reqs[1U64].name)
    print(value.reqs[1U64].params.count())
}
