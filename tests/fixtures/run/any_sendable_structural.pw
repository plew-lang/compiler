import @Std/Io with { print }

trait Numberish {
    fn number() -> I64
}

struct Count {
    pub val value: I64
}
pub impl Count { factory }

impl Count as Numberish {
    fn number() -> I64 { return self.value }
}

fn main() {
    val value: any sendable Numberish = <Count value=7 />
    print(value.number())
}
