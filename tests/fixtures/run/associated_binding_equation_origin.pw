use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /Diag only { FailureDomain }
use /Ir only { AssocBinding, DeclarationBoundRef, StaticConformanceProof, WitnessMatch }
use /SourceAccess only { SourceAccess }
use @Std/Core only { assert }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    val source = "trait Parent[A] {{ type Item }}\nstruct Worker {{}}\nimpl Worker as Parent[I64] {{ type Item = Bool }}\nimpl Worker as Parent[Bool] {{ type Item = Bool }}\nfn probe[T](value: T) where T: Parent[I64] {{}}\n"
    analyzeFrontendForRequests(c: inout compiler, input: <FrontendInput.Text text=source path="equation-origin.pw" />, sources: <SourceAccess stdRoot=[] />).unwrap()
    val first = compiler.decls.assocBindings[0U64]
    val second = compiler.decls.assocBindings[1U64]
    assert(compiler.typeRefEq(a: first.ty, b: second.ty))
    val proof = <StaticConformanceProof.ConcreteWitness witness=<WitnessMatch conformIdx=1U64 selfRef=first.subjectTy /> />
    assert(compiler.associatedOutputTermInProof(proof: proof, traitOwner: first.traitOwner, assocId: first.nameId).unwrap() == first.ty)
    compiler.decls.assocBindings[0U64] = <AssocBinding recvStart=first.recvStart recvLen=first.recvLen recvId=first.recvId nameStart=first.nameStart nameLen=first.nameLen nameId=first.nameId traitId=first.traitId traitOwner=first.traitOwner implOffset=first.implOffset subjectTy=first.subjectTy subjectArgs=first.subjectArgs typeParams=first.typeParams traitArgs=first.traitArgs tyStart=first.tyStart tyLen=first.tyLen tyIsArray=first.tyIsArray ty=first.ty authoredTypeSite=first.authoredTypeSite authoredTypeUse=second.authoredTypeUse />
    assert(compiler.associatedOutputTermInProof(proof: proof, traitOwner: first.traitOwner, assocId: first.nameId).isErr())
    compiler.decls.assocBindings[0U64] = first
    assert(compiler.associatedOutputTermInProof(proof: proof, traitOwner: first.traitOwner, assocId: first.nameId).unwrap() == first.ty)
    val function = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val assumptions = compiler.decls.funcBounds.indices(owner: function)
    assert(assumptions.count() == 1U64)
    val abstract = <StaticConformanceProof.AssumedBound source=<DeclarationBoundRef.Function index=assumptions[0U64] /> />
    assert(compiler.associatedOutputInProof(proof: abstract, traitOwner: first.traitOwner, assocId: first.nameId).unwrap() == 0U64)
    val malformed = <StaticConformanceProof.TraitPath edges=[] terminalConformIdx=1U64 />
    match compiler.associatedOutputInProof(proof: malformed, traitOwner: first.traitOwner, assocId: first.nameId) {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain {
                FailureDomain.Internal => {}
                _ => { panic("malformed concrete path is not an internal evidence failure") }
            }
        }
        Result.Ok(value: _) => { panic("accepted a malformed concrete path") }
    }
    assert(compiler.associatedOutputInProof(proof: proof, traitOwner: first.traitOwner, assocId: 0U64).unwrap() == 0U64)
    compiler.decls.assocBindings[0U64] = <AssocBinding recvStart=first.recvStart recvLen=first.recvLen recvId=first.recvId nameStart=first.nameStart nameLen=first.nameLen nameId=0U64 traitId=first.traitId traitOwner=first.traitOwner implOffset=first.implOffset subjectTy=first.subjectTy subjectArgs=first.subjectArgs typeParams=first.typeParams traitArgs=first.traitArgs tyStart=first.tyStart tyLen=first.tyLen tyIsArray=first.tyIsArray ty=first.ty authoredTypeSite=first.authoredTypeSite authoredTypeUse=first.authoredTypeUse />
    match compiler.associatedOutputInProof(proof: proof, traitOwner: first.traitOwner, assocId: first.nameId) {
        Result.Err(error: val diagnostic) => {
            match diagnostic.failureDomain {
                FailureDomain.Internal => {}
                _ => { panic("missing concrete binding is not an internal evidence failure") }
            }
        }
        Result.Ok(value: _) => { panic("accepted a missing concrete associated binding") }
    }
    compiler.decls.assocBindings[0U64] = first
    assert(compiler.typeRefEq(a: compiler.associatedOutputInProof(proof: proof, traitOwner: first.traitOwner, assocId: first.nameId).unwrap(), b: first.ty))
    print("associated-binding-equation-origin")
}
