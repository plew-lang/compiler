use @Std/Io only { print }
trait Project { type Item }
struct Source {}
struct Other {}
struct Number { val value: I64 }
impl Source as Project { type Item = Other#Project.Item }
impl Other as Project { type Item = Number }
impl Number {
    factory named(value: I64) { return <Number value=value /> }
}
newtype Wrapped = Source#Project.Item
fn main() {
    val number: Wrapped = <Wrapped.named value=42I64 />
    print(number.value)
}
