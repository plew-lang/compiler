// extern(c) FFI (spec/15): opaque foreign handle (`type ModuleRef`) + raw C
// pointers (`CPtr[U8]`) + String<->C-string conversion via @Std/Ffi, calling a
// foreign C library — here a self-contained companion stub (ffi_extern_c.c)
// shaped like libLLVM-C, so the test needs no system library. Proves the minimal
// FFI subset the LLVM backend stands on.
//
// extern(c) functions take NO argument labels (C has none): every parameter is
// written label-suppressed `name~:` (explicit, spec/15) and called positionally.
import @Std/Io with { print }
import @Std/Ffi with { CString, stringFromCString }

extern(c) {
    type ModuleRef
    fn moduleCreate(name~: CPtr[U8]) -> ModuleRef
    fn moduleName(m~: ModuleRef) -> CPtr[U8]
    fn moduleDispose(m~: ModuleRef)
}

fn main() {
    // spec/15 point 3: the owned Plew->C string — `.ptr` is valid while `cname`
    // lives; its deinit frees the buffer at scope exit (no manual free, no leak).
    val cname: CString = <CString.copied text="plew_hello" />
    val m: ModuleRef = moduleCreate(cname.ptr)
    print(stringFromCString(moduleName(m)))
    moduleDispose(m)
}
