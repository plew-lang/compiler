use @Std/Io only { print }
trait Marker { type Type }
trait Parent { type Item }
trait Middle: Parent + Marker { fn get() -> Item }
struct Worker {}
impl Worker as Parent { type Item = Worker#Marker.Type }
impl Worker as Marker { type Type = I64 }
impl Worker as Middle { fn get() -> I64 { return 42I64 } }
fn main() { print(<Worker />.get()) }
