// `append(x)` is a value copy: the source binding remains an owner after the
// call, so an enum payload containing Array[TypeAst] must be retained for the
// destination.  This is distinct from appending a freshly-constructed value.
import @Plew/Syntax with { Span, TopItemAst, TypeAst }
import @Std/Io with { print }

fn main() {
    val span = <Span start=0U64 end=5U64 />
    val byte = <TypeAst name="U8" args=[] span=span />
    val array = <TypeAst name="Array" args=[byte] span=span />
    val item = <TopItemAst.NewType name="Bytes" nameSpan=span ty=array isPub=false span=span />
    mut val items: Array[TopItemAst] = []
    items.append(item)
    match items[0U64] {
        TopItemAst.NewType(name: _, nameSpan: _, ty: val ty, isPub: _, span: _) => {
            print(ty.args.count())
        }
        _ => { print(0U64) }
    }
}
