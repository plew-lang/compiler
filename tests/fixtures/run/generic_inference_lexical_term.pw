// Declaration inference must preserve a caller-owned symbolic argument even
// when a concrete body environment is present on the compatibility cursor.
use @Std/Io only { print }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { Expr, InstanceEnvironment, TypeRef }

fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="lexical-term.pw" text="fn probe[Parameter](value: Parameter) -> Parameter {{ return value }}" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val function = compiler.arena.functionAt(index: 0U64)
    val binder = compiler.funcBindAt(binds: function.typeParams, index: 0U64)
    val parameter = compiler.funcParamAt(params: function.params, index: 0U64).ty
    mut val expression = compiler.arena.exprs.count()
    mut val index = 0U64
    while index < compiler.arena.exprs.count() {
        match compiler.arena.exprs[index] {
            Expr.Ident(start: _, len: _) => { expression = index }
            _ => {}
        }
        index += 1U64
    }
    if expression >= compiler.arena.exprs.count() { panic "missing parameter expression" }
    compiler.prepareLexicalBody(fnIdx: 0U64).unwrap()
    val concreteName = compiler.internBytes(s: "I64")
    val concrete = compiler.pushType(t: <TypeRef nameStart=concreteName.nameStart nameLen=concreteName.nameLen nameId=concreteName.nameId args=[] />)
    compiler.cur.checkFn = 0U64
    compiler.cur.bodyId = 1U64
    compiler.cur.bodyEnvironment = <InstanceEnvironment params=[binder] args=[concrete] />
    if compiler.inferenceArgumentType(exprId: expression).unwrap() != parameter {
        panic "declaration inference captured a concrete body substitution"
    }
    // An allocated body does not seal every contextual source expression.
    val literal = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=concreteName.nameStart tyLen=concreteName.nameLen isNeg=false />)
    if !compiler.typeRefEq(a: compiler.inferenceArgumentType(exprId: literal).unwrap(), b: concrete) {
        panic "pending explicit literal lost its declaration type"
    }
    print("generic-inference-lexical-term")
}
