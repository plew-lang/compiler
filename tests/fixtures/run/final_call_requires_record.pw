// Finalization must not recover a missing lexical selection from AST names or
// the older callee cache, even before a body is marked closed.
use @Std/Io only { print }
use /Frontend only { Comp }
use /Ir only { BodyInstance, InstanceEnvironment, CallSiteKey, SemanticTypeRecipe, CachedCallee, CallTemplate, CallTemplateKind, CallTemplateReceiver, Expr, Func }

fn rejected(compiler: inout Comp, expression: U64) {
    val template = compiler.callTemplateForCurrentBody(exprId: expression).unwrap()
    match compiler.resolveBodyCallee(exprId: expression, template: template) {
        Result.Err(error: val diagnostic) => {
            if diagnostic.message() != "internal error: written call CallTemplate was not recorded" { panic diagnostic.message() }
        }
        Result.Ok(value: _) => { panic "final call reselected without a lexical record" }
    }
    if compiler.arena.finalCalleeCount() != 0U64 { panic "failed selection published a final call" }
}

fn rejectRecipe(compiler: inout Comp, recipe: U64, body: U64, message: String) {
    match compiler.groundSemanticTypeRecipeForBody(recipeId: recipe, bodyId: body, selfRef: 0U64, itemRef: 0U64, requireProducer: true) {
        Result.Err(error: val diagnostic) => {
            if diagnostic.message() != message { panic diagnostic.message() }
        }
        Result.Ok(value: _) => { panic "invalid checked recipe produced a result" }
    }
}

fn rejectDependency(compiler: inout Comp, expression: U64, site: CallSiteKey, message: String) {
    match compiler.prepareCheckedResultCall(expression: expression, site: site) {
        Result.Err(error: val diagnostic) => {
            if diagnostic.message() != message { panic diagnostic.message() }
        }
        Result.Ok(value: _) => { panic "invalid checked dependency was accepted" }
    }
    if compiler.arena.finalCalleeCount() != 0U64 { panic "invalid dependency published a final call" }
}

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internTmpName(prefix: "call", n: 0U64)
    compiler.arena.registerFunction(<Func nameStart=name.nameStart nameLen=name.nameLen
        typeParams=compiler.pushFuncBinds(binds: []) params=compiler.pushFuncParams(params: [])
        hasRet=false retStart=0U64 retLen=0U64 retIsArray=false retTy=0U64 body=0U64
        hasRecv=false recvStart=0U64 recvLen=0U64 selfInout=false selfMove=false isAssoc=false isAsync=false isExtern=false />)
    compiler.cur.bodyFnIdx = 0U64
    val expression = compiler.pushExpr(e: <Expr.Call nameStart=name.nameStart nameLen=name.nameLen args=compiler.pushArgs(args: []) />)
    while compiler.typeCache.callee.count() <= expression { compiler.typeCache.callee.append(<CachedCallee.Selected callee=0U64 />) }
    rejected(compiler: inout compiler, expression: expression)
    val site = compiler.templateCallSiteKey(fnIdx: 0U64, exprId: expression).unwrap()
    rejectDependency(compiler: inout compiler, expression: expression, site: site, message: "checked result dependency has no selected call")
    val body = compiler.arena.registerBodyInstance(<BodyInstance fnIdx=0U64 environment=<InstanceEnvironment /> />)
    val missing = compiler.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=2U64 callSite=site />)
    rejectRecipe(compiler: inout compiler, recipe: missing, body: body, message: "local initializer depends on an unprepared call result")
    val invalidPayload = compiler.pushSemanticTypeRecipe(recipe: <SemanticTypeRecipe kind=4U64 input=0U64 />)
    rejectRecipe(compiler: inout compiler, recipe: invalidPayload, body: body, message: "local initializer has an invalid type recipe or body")
    compiler.appendCallTemplate(template: <CallTemplate siteKey=site kind=<CallTemplateKind.Pending /> />, resultExpression: <Optional.Some v=expression />)
    rejectDependency(compiler: inout compiler, expression: expression + 1U64, site: site, message: "checked result dependency has a foreign call occurrence")
    rejected(compiler: inout compiler, expression: expression)
    val arguments = compiler.publishCallTemplateArguments(args: [])
    val types = compiler.publishCallTemplateTypeArgs(args: [])
    compiler.replaceBuildingCallTemplate(index: 0U64, template: <CallTemplate siteKey=site kind=<CallTemplateKind.Direct callee=compiler.arena.functionCount() receiver=<CallTemplateReceiver.None /> args=arguments calleeTypeArgs=types proofId=0U64 /> />)
    rejected(compiler: inout compiler, expression: expression)
    print("final-call-requires-record")
}
