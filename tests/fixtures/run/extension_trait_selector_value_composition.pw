use @Std/Io only { print }
trait Match {}
trait Left {}
trait Right {}
impl Left as Match {}
impl Right as Match {}
struct Number { val digit: I64 }
impl Number as Left {}
impl Number as Right {}
extension Extra {
    impl Match { fn fromMatch() -> I64 { return 42I64 } }
}
fn main() {
    val extra = <Number digit=42I64 />#Left#Extra
    val reversed = <Number digit=43I64 />#Extra#Left
    print(extra.digit)
    print(reversed.digit)
}
