// The arena includes the unconditional predicate for the terminal wildcard.
// Literal match lowering must retain the value-AST single-evaluation if-chain
// form instead of exposing a scalar pattern to enum-match codegen.
use @Plew/Syntax only { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxDecl, syntaxFileTopLevel, syntaxTopItemPayload }
use @Std/Io only { print }
use /Frontend only { Comp }

fn main() {
    val source = "fn body() {{ match value {{ 1I8 => {{}} _ => {{}} }} }}\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)

    mut val c: Comp = <Comp />
    c.appendSrc(from: source.bytes())
    c.syntax = file
    val root = c.lowerSyntaxBlock(id: decl.body).unwrap()
    print(c.arena.blocks.count())
    print(c.arena.stmts.count())
    print(c.arena.exprs.count())
    print(c.blockStmtCount(blkId: root))
}
