use @Std/Io only { print }
trait First { fn read() -> I64 }
trait Second {}
trait Service { fn fetch[T,U](first: T, second: U) -> I64 where T: First, U: Second }
struct Item {}
impl Item as First { fn read() -> I64 { return 42I64 } }
impl Item as Second {}
struct Worker {}
impl Worker as Service { fn fetch[T,U](first: T, second: U) -> I64 where U: Second, T: First { return first.read() } }
fn caller[R,T,U](receiver: R, first: T, second: U) -> I64 where R: Service, T: First, U: Second { return receiver.fetch(first: first, second: second) }
fn main() {
    val result = caller(receiver: <Worker />, first: <Item />, second: <Item />)
    if result != 42I64 { panic("requirement call returned wrong value") }
    print("retained-requirement-call-constraints")
}
