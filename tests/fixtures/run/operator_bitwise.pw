use @Std/Io only { print }
use @Std/Core only { BitAnd, BitOr, Shl }

// O3: bitwise/shift operators desugar to operator-trait witnesses (spec/12).

struct Flags { pub val bits: U64 }
pub impl Flags { factory }

impl Flags as BitAnd[Flags] {
    type Output = Flags
    assoc fn bitand(lhs~: Flags, rhs~: Flags) -> Flags { return <Flags bits=(lhs.bits & rhs.bits) /> }
}
impl Flags as BitOr[Flags] {
    type Output = Flags
    assoc fn bitor(lhs~: Flags, rhs~: Flags) -> Flags { return <Flags bits=(lhs.bits | rhs.bits) /> }
}
impl Flags as Shl[U64] {
    type Output = Flags
    assoc fn shl(lhs~: Flags, rhs~: U64) -> Flags { return <Flags bits=(lhs.bits << rhs) /> }
}

fn main() {
    val a: Flags = <Flags bits=6 />   // 110
    val b: Flags = <Flags bits=3 />   // 011
    print((a & b).bits)               // 2  (010)
    print((a | b).bits)               // 7  (111)
    print((a << 2U64).bits)           // 24 (11000)
}
