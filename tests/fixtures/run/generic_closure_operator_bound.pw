use @Std/Core only { Sub }
use @Std/Io only { print }

fn subtractor[T](value: T) -> fn() -> T where T: Sub[T, Output=T] {
    return fn() -> T { return value - value }
}

fn main() {
    val signed = subtractor(value: 7I64)
    val unsigned = subtractor(value: 9U32)
    print(signed())
    print(unsigned())
}
