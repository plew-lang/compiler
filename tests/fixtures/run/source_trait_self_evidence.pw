use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Ir only { StaticConformanceProof }
use @Std/Io only { print }
use @Std/Core only { assert }
fn main() {
    mut val compiler = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text text="trait P {{}} trait Q {{}} fn probe[T](source: T, target: any P, foreign: any Q) where T: P {{}}" path="trait-self.pw" />,
        sources: <SourceAccess stdRoot=[] />).unwrap()
    val functionIndex = compiler.arena.firstFunctionNamed(nameId: compiler.internBytes(s: "probe").nameId)
    val function = compiler.arena.functionAt(index: functionIndex)
    val receiver = compiler.funcParamAt(params: function.params, index: 0U64).ty
    val target = compiler.funcParamAt(params: function.params, index: 2U64).ty
    val traitIndex = compiler.recordAnyTraitIndex(anyRef: target)
    val synthetic = compiler.existentialSelfTerm(traitIndex: traitIndex).unwrap()
    val planningProof = <StaticConformanceProof.TraitSelf traitIdx=traitIndex receiverRef=synthetic traitArgs=[] />
    match compiler.checkStaticProofEvidence(proof: planningProof, offset: 0U64) {
        Result.Ok(value: _) => {}
        Result.Err(error: val diagnostic) => { panic(diagnostic.message) }
    }
    val forged = <StaticConformanceProof.TraitSelf traitIdx=traitIndex receiverRef=receiver traitArgs=[] />
    match compiler.checkDeclarationCallProof(proof: forged, scope: compiler.declarationTypeScope(owner: functionIndex).unwrap(), offset: 0U64) {
        Result.Ok(value: _) => { panic("unjustified generic trait Self accepted") }
        Result.Err(error: val diagnostic) => { assert(diagnostic.message == "selected trait Self evidence does not match its interface Self") }
    }
    val wrongInterface = compiler.recordAnyTraitIndex(anyRef: compiler.funcParamAt(params: function.params, index: 1U64).ty)
    val wrongSelf = compiler.existentialSelfTerm(traitIndex: wrongInterface).unwrap()
    for proof in [
        <StaticConformanceProof.TraitSelf traitIdx=traitIndex receiverRef=wrongSelf traitArgs=[] />,
        <StaticConformanceProof.TraitSelf traitIdx=traitIndex receiverRef=synthetic traitArgs=[receiver] />
    ] {
        match compiler.checkStaticProofEvidence(proof: proof, offset: 0U64) {
            Result.Ok(value: _) => { panic("malformed interface Self accepted") }
            Result.Err(error: val diagnostic) => { assert(diagnostic.message == "selected trait Self evidence does not match its interface Self") }
        }
    }
    print("trait-self-evidence")
}
