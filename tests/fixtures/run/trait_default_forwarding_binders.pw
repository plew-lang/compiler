use @Std/Io only { print }
trait Source {}
trait Target {
    fn result[Element]() -> Optional[Element]
    assoc fn associated[Element]() -> Optional[Element]
}
impl Source as Target {
    fn result[Element](count: I64 = 5I64) -> Optional[Element] { return <Optional.None /> }
    assoc fn associated[Element](count: I64 = 5I64) -> Optional[Element] { return <Optional.None /> }
}
struct S {}
impl S as Source {}
fn instance[T](value: T) -> Optional[I64] where T: Target { return value.result() }
fn associated[T](value: T) -> Optional[String] where T: Target { return T.associated() }
fn main() {
    val value = <S />
    val first: Optional[I64] = value.result()
    val second: Optional[String] = S.associated()
    print(first.isNone())
    print(second.isNone())
    print(instance(value: value).isNone())
    print(associated(value: value).isNone())
}
