import @Std/Io with { print }

// `(x as T).method()` where the cast target is a (newtype-over-)struct: the cast
// result must dispatch on T's struct, like a plain receiver (regression — once
// rejected as "method call only on a registered struct value").
struct Plain { pub val n: I64 }
pub impl Plain { factory }
pub impl Plain { fn show() -> I64 { return self.n } }
newtype Wrapped = Plain

fn main() {
    val w: Wrapped = <Wrapped n=7 />
    print((w as Plain).show())
}
