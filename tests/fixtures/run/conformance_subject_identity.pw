import @Std/Io with { print }
import /Frontend with { Comp }
import /Ir with { Conform, TypeRef, PatternTypeInput, PatternBindInput }

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internBytes(s: "Item")
    val trait = compiler.internBytes(s: "Readable")
    val first = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=true declOffset=100U64 />)
    val second = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] hasDecl=true declOffset=200U64 />)
    compiler.decls.registerConform(<Conform subjectTraitOwner=0U64 sourceModule=0U64 typeStart=name.nameStart typeLen=name.nameLen typeId=name.nameId subjectTy=first traitStart=trait.nameStart traitLen=trait.nameLen traitId=trait.nameId derived=false />)
    print(compiler.conformExists(typeRef: first, traitOwner: trait.nameStart))
    print(compiler.conformExists(typeRef: second, traitOwner: trait.nameStart))
    print(compiler.conformExistsTraitInstance(typeRef: first, traitOwner: trait.nameStart, traitArgs: <PatternTypeInput.Values values=[] />, patternParams: <PatternBindInput.Values values=[] />))
    print(compiler.conformExistsTraitInstance(typeRef: second, traitOwner: trait.nameStart, traitArgs: <PatternTypeInput.Values values=[] />, patternParams: <PatternBindInput.Values values=[] />))
    // A second declaration with the same spelling cannot borrow this witness.
    val otherTrait = compiler.arena.bytes.count()
    compiler.arena.bytes.append('R')
    compiler.arena.bytes.append('e')
    compiler.arena.bytes.append('a')
    compiler.arena.bytes.append('d')
    compiler.arena.bytes.append('a')
    compiler.arena.bytes.append('b')
    compiler.arena.bytes.append('l')
    compiler.arena.bytes.append('e')
    print(compiler.conformExists(typeRef: first, traitOwner: otherTrait))
    print(compiler.conformExistsTraitInstance(typeRef: first, traitOwner: otherTrait, traitArgs: <PatternTypeInput.Values values=[] />, patternParams: <PatternBindInput.Values values=[] />))
}
