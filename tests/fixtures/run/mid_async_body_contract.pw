use @Std/Io only { print }
use @Std/Core only { assert }
use /Frontend only { Comp, FrontendInput, analyzeFrontendForRequests }
use /SourceAccess only { SourceAccess }
use /Mid only { buildParametricMidBody, MidBuildError }

// A prepared source owner does not remove Mid's missing-terminator check.
// Both async logical and sync public value results need a return terminator.
fn missingReturnRejected(source: String) {
    mut val compiler: Comp = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="missing-return.pw" text=source />,
        sources: <SourceAccess />).unwrap()
    match compiler.prepareLexicalBody(fnIdx: 0U64) {
        Result.Err(error: _) => {
            match buildParametricMidBody(c: inout compiler, fnIdx: 0U64).error {
                MidBuildError.Frontend(diagnostic: _) => {}
                _ => { panic("failed owner admitted to Mid") }
            }
        }
        Result.Ok(value: _) => {
            match buildParametricMidBody(c: inout compiler, fnIdx: 0U64).error {
                MidBuildError.MissingTerminator => {}
                _ => { panic("missing return accepted by Mid") }
            }
        }
    }
}

fn main() {
    mut val compiler: Comp = <Comp />
    analyzeFrontendForRequests(c: inout compiler,
        input: <FrontendInput.Text path="async-contract.pw" text="struct Promise[T] {{}} async fn asynchronous(value: I64) -> Promise[I64] {{ return value }} fn synchronous(value: Promise[I64]) -> Promise[I64] {{ return value }} async fn completion(value: I64) {{}}" />,
        sources: <SourceAccess />).unwrap()
    // Mid must not turn declaration metadata into proof of a checked body.
    match buildParametricMidBody(c: inout compiler, fnIdx: 0U64).error {
        MidBuildError.Frontend(diagnostic: _) => {}
        _ => { assert(false) }
    }
    match compiler.preparedFunctionBodySignature(fnIdx: 0U64) {
        Result.Err(error: _) => {}
        Result.Ok(value: _) => { panic("unprepared signature published") }
    }
    compiler.prepareLexicalBody(fnIdx: 0U64).unwrap()
    val firstSnapshot = compiler.preparedFunctionBodySignature(fnIdx: 0U64).unwrap()
    compiler.prepareLexicalBody(fnIdx: 1U64).unwrap()
    compiler.prepareLexicalBody(fnIdx: 2U64).unwrap()
    assert(firstSnapshot.isAsync)
    assert(firstSnapshot.hasReturnValue)
    assert(!firstSnapshot.hasReceiver)
    assert(firstSnapshot.parameters.count() == 1U64)
    assert(compiler.typeRefEq(a: firstSnapshot.parameters[0U64].typeTerm, b: firstSnapshot.resultTerm))
    mut val copiedParameters = firstSnapshot.parameters
    copiedParameters.set(i: 0U64, value: compiler.preparedFunctionBodySignature(fnIdx: 1U64).unwrap().parameters[0U64])
    assert(compiler.typeRefEq(a: compiler.preparedFunctionBodySignature(fnIdx: 0U64).unwrap().parameters[0U64].typeTerm, b: firstSnapshot.resultTerm))
    val integer = compiler.preparedFunctionBodySignature(fnIdx: 0U64).unwrap().resultTerm
    val promise = compiler.preparedFunctionBodySignature(fnIdx: 1U64).unwrap().resultTerm
    assert(compiler.typeRefEq(a: compiler.arena.functionAt(index: 0U64).retTy, b: promise))
    val asynchronous = buildParametricMidBody(c: inout compiler, fnIdx: 0U64)
    match asynchronous.error { MidBuildError.None => {} _ => { assert(false) } }
    assert(asynchronous.body.locals[0U64].ownsAtEntry)
    assert(asynchronous.body.locals[1U64].isReturnPlace)
    assert(compiler.typeRefEq(a: asynchronous.body.locals[1U64].typeTerm, b: integer))
    val synchronous = buildParametricMidBody(c: inout compiler, fnIdx: 1U64)
    match synchronous.error { MidBuildError.None => {} _ => { assert(false) } }
    assert(!synchronous.body.locals[0U64].ownsAtEntry)
    assert(compiler.typeRefEq(a: synchronous.body.locals[1U64].typeTerm, b: promise))
    val completion = buildParametricMidBody(c: inout compiler, fnIdx: 2U64)
    match completion.error { MidBuildError.None => {} _ => { assert(false) } }
    assert(completion.body.locals.count() == 1U64)
    assert(completion.body.locals[0U64].ownsAtEntry)
    missingReturnRejected(source: "struct Promise[T] {{}} async fn probe(value: I64) -> Promise[I64] {{}}")
    missingReturnRejected(source: "struct Promise[T] {{}} fn probe(value: I64) -> Promise[I64] {{}}")
    print("ok")
}
