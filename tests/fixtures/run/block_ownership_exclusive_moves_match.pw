use @Std/Io only { print }
unique struct Resource { val id: I64
 deinit { print(self.id) } }
fn consume(x: move Resource) { print(90I64) }
fn test(flag: Bool) {
 val r = <Resource id=1I64 />
 val result = match flag { true => { consume(x: move r)
 give 7I64 } false => { consume(x: move r)
 give 8I64 } }
 print(result)
}
fn main() { test(flag: true)
 test(flag: false) }
