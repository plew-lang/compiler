// Generic numeric dispatch over floats (spec/06,12): a `where T: Add/Eq/Ord`
// function instantiated at F64 routes `+`, `==`, `<` through the SAME operator
// witnesses (`impl F64 as Add/Eq/Ord` in std/Core/Num.pw) that concrete float ops
// use — the witness body over the intrinsic floor is the single source of truth, so
// there is no separate primitive open-coding path for generics (spec/12, O6).
import @Std/Io with { print }
import @Std/Core with { Add, Eq, Ord }

fn sum[T](a: T, b: T) -> T where T: Add[T, Output = T] {
    return a + b
}

fn same[T](a: T, b: T) -> Bool where T: Eq {
    return a == b
}

fn smaller[T](a: T, b: T) -> Bool where T: Ord {
    return a < b
}

fn main() {
    // generic Add at F64 — dispatches to `impl F64 as Add`.
    print(sum(a: 1.5, b: 2.5))                                       // 4
    // the same generic function at I64 — dispatches to `impl I64 as Add`.
    print(sum(a: 3I64, b: 4I64))                                     // 7
    // generic Eq at F64.
    if same(a: 2.5, b: 2.5) { print(1I64) } else { print(0I64) }    // 1
    if same(a: 2.5, b: 3.5) { print(1I64) } else { print(0I64) }    // 0
    // generic Ord at F64 (routes through `impl F64 as Ord`.compare).
    if smaller(a: 1.5, b: 2.5) { print(1I64) } else { print(0I64) } // 1
    if smaller(a: 5.0, b: 2.5) { print(1I64) } else { print(0I64) } // 0
}
