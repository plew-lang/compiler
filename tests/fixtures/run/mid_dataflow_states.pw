import /Mid/DataflowState with { MidOwnershipStates, MidAccessibilityStates }
import /Mid/Ir with { MidOwnership, MidAccessibility }
import @Std/Io with { write }

fn ownershipCode(state: MidOwnership) -> U64 {
    match state {
        MidOwnership.Owned => { return 1U64 }
        MidOwnership.Consumed => { return 2U64 }
        MidOwnership.MaybeOwned => { return 3U64 }
    }
}
fn available(state: MidAccessibility) -> Bool {
    match state {
        MidAccessibility.Available => { return true }
        MidAccessibility.Unavailable => { return false }
    }
}
fn main() {
    val sizes = [0U64, 1U64, 31U64, 32U64, 33U64, 63U64, 64U64, 65U64, 129U64]
    val ownership = [<MidOwnership.Owned />, <MidOwnership.Consumed />, <MidOwnership.MaybeOwned />]
    val accessibility = [<MidAccessibility.Available />, <MidAccessibility.Unavailable />]
    for count in sizes {
        // Exhaustive lattice pairs, including word boundaries and empty domains.
        for left in ownership {
            for right in ownership {
                mut val states = <MidOwnershipStates.filled count=count state=left />
                val incoming = <MidOwnershipStates.filled count=count state=right />
                val before = states
                val expected = if ownershipCode(state: left) == ownershipCode(state: right) { give ownershipCode(state: left) } else { give 3U64 }
                val changed = states.join(incoming: incoming)
                if changed != (count != 0U64 && expected != ownershipCode(state: left)) { panic "ownership join change" }
                if states.join(incoming: incoming) { panic "ownership join not idempotent" }
                if states.count() != count { panic "ownership domain length" }
                mut val index = 0U64
                while index < count {
                    if ownershipCode(state: states[index]) != expected { panic "ownership join value" }
                    if ownershipCode(state: before[index]) != ownershipCode(state: left) { panic "ownership snapshot changed" }
                    if ownershipCode(state: incoming[index]) != ownershipCode(state: right) { panic "ownership input changed" }
                    index += 1U64
                }
            }
        }
        for left in accessibility {
            for right in accessibility {
                mut val states = <MidAccessibilityStates.filled count=count state=left />
                val incoming = <MidAccessibilityStates.filled count=count state=right />
                val before = states
                val expected = available(state: left) && available(state: right)
                if states.join(incoming: incoming) != (count != 0U64 && expected != available(state: left)) { panic "accessibility join change" }
                if states.join(incoming: incoming) { panic "accessibility join not idempotent" }
                if states.count() != count { panic "accessibility domain length" }
                mut val index = 0U64
                while index < count {
                    if available(state: states[index]) != expected { panic "accessibility join value" }
                    if available(state: before[index]) != available(state: left) { panic "accessibility snapshot changed" }
                    index += 1U64
                }
            }
        }
        // Per-local writes must preserve neighbouring slots and copied states.
        mut val states = <MidOwnershipStates.filled count=count state=<MidOwnership.Consumed /> />
        mut val access = <MidAccessibilityStates.filled count=count state=<MidAccessibility.Unavailable /> />
        val original = states
        val originalAccess = access
        mut val index = 0U64
        while index < count {
            states.set(index: index, state: ownership[index % 3U64])
            access.set(index: index, state: accessibility[index % 2U64])
            index += 1U64
        }
        val snapshot = states
        val accessSnapshot = access
        index = 0U64
        while index < count {
            states.set(index: index, state: <MidOwnership.MaybeOwned />)
            access.set(index: index, state: <MidAccessibility.Available />)
            index += 1U64
        }
        index = 0U64
        while index < count {
            if ownershipCode(state: original[index]) != 2U64 || available(state: originalAccess[index]) { panic "initial snapshot changed" }
            if ownershipCode(state: snapshot[index]) != ownershipCode(state: ownership[index % 3U64]) { panic "adjacent ownership slot changed" }
            if available(state: accessSnapshot[index]) != available(state: accessibility[index % 2U64]) { panic "adjacent accessibility slot changed" }
            if ownershipCode(state: states[index]) != 3U64 || !available(state: access[index]) { panic "state update lost" }
            index += 1U64
        }
    }
    write(s: "dataflow-states-ok\n")
}
