use /Frontend only { Comp }
use /Ir only { Expr, TypeRef }
use @Std/Io only { print }

fn main() {
    mut val compiler = <Comp />
    compiler.arena.reserveTypeSentinel()
    val name = compiler.internBytes(s: "I64")
    val integer = compiler.pushType(t: <TypeRef nameStart=name.nameStart nameLen=name.nameLen args=[] />)
    val unit = compiler.pushType(t: <TypeRef nameStart=0U64 nameLen=0U64 args=[] isRecord=true recordFieldLabels=[] recordFieldTerms=[] />)
    val expression = compiler.pushExpr(e: <Expr.Int value=1U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    if compiler.recordedExpressionHasUnitResult(exprId: expression) { panic "unrecorded result was Unit" }
    compiler.recordKnownExpressionResult(exprId: expression, resultTerm: 0U64).unwrap()
    if !compiler.recordedExpressionHasUnitResult(exprId: expression) { panic "known Unit result was lost" }
    compiler.tcCheckValue(expectedRef: unit, valueExpr: expression, pos: "unit-probe").unwrap()
    if compiler.tcCheckValue(expectedRef: integer, valueExpr: expression, pos: "unit-probe").isOk() { panic "Unit matched an integer" }
    val valueExpression = compiler.pushExpr(e: <Expr.Int value=2U64 offset=0U64 isBool=false tyStart=0U64 tyLen=0U64 isNeg=false />)
    compiler.recordSemanticExprTerm(exprId: valueExpression, term: integer)
    if compiler.recordedExpressionHasUnitResult(exprId: valueExpression) { panic "value result was Unit" }
    print("recorded-unit")
}
