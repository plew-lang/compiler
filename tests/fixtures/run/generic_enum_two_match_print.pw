import @Std/Io with { print }
import @Std/Core

fn main() {
    val first: Optional[I64] = <Optional[I64].Some v=7I64 />
    match first {
        Optional.Some(v: val item) => { print(item) }
        Optional.None => { print(0I64) }
    }
    val second: Optional[String] = <Optional[String].Some v="alpha" />
    match second {
        Optional.Some(v: val item) => { print(item) }
        Optional.None => { print("n") }
    }
}
