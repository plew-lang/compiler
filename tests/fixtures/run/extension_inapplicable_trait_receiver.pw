use @Std/Io only { print }
trait Match {}
trait Left {}
trait Right {}
impl Left as Match {}
impl Right as Match {}
struct Number {}
impl Number as Left {}
impl Number as Right {}
extension Extra {
    impl Match { fn fromMatch() -> I64 { return 0I64 } }
    impl Number { fn answer() -> I64 { return 42I64 } }
}
fn main() {
    val extra = <Number />#Extra
    print(extra.answer())
}
