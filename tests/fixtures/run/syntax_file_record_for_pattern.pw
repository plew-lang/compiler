// A SyntaxFile must retain the semantic kind of a record loop pattern. Its
// source-only synthetic marker is not available to compiler consumers after
// freezing, so the node view carries an explicit flag.
import @Plew/Syntax with { Lexer, P, DeclId, lex, parseProgramSyntaxFile, syntaxBlock, syntaxBlockStmt, syntaxDecl, syntaxFileTopLevel, syntaxStmt, syntaxTopItemPayload }
import @Std/Io with { print }

fn main() {
    val source = "fn body() {\n    for (val left, val right) in pairs {}\n}\n"
    mut val lexer = <Lexer bytes=source.bytes() pos=0U64 toks=[] depth=0I64 />
    lex(lx: inout lexer)
    mut val parser = <P bytes=source.bytes() toks=lexer.toks pos=0U64 base=0U64 />
    val file = parseProgramSyntaxFile(p: inout parser)
    val item = syntaxFileTopLevel(file: file, index: 0U64)
    val decl = syntaxDecl(file: file, id: <DeclId raw=syntaxTopItemPayload(file: file, item: item) />)
    val block = syntaxBlock(file: file, id: decl.body)
    val stmt = syntaxStmt(file: file, id: syntaxBlockStmt(file: file, block: block, index: 0U64))
    if stmt.isRecordPattern { print(1U64) } else { print(0U64) }
}
