use @Std/Io only { print }

trait Source { type Item }
trait DefaultValue {}
struct Number {}
struct Other {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }

impl[T] Box[T, T#Source.Item] where T: Source {
    fn value() -> I64 { return 42I64 }
}

impl DefaultValue {
    fn value() -> I64 { return 7I64 }
}
impl Box[Number, I64] as DefaultValue {}
impl Box[Number, Bool] as DefaultValue {}
impl Box[Other, I64] as DefaultValue {}

fn main() {
    print(<Box[Number, I64] item=42I64 />.value())
    print(<Box[Number, Bool] item=true />.value())
    print(<Box[Other, I64] item=42I64 />.value())
}
