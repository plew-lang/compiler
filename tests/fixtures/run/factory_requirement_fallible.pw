use @Std/Io only { print }
trait Maybe { optional factory(value: I64) }
trait Checked { type Error result[Error] factory checked(value: I64) }
struct Item { val raw: I64 }
impl Item as Maybe { optional factory(value: I64) { return <Optional.Some v=<Item raw=value /> /> } }
impl Item as Checked { type Error = String result[String] factory checked(value: I64) { return <Result.Ok value=<Item raw=value /> /> } }
fn maybe[T](value: I64) -> Optional[T] where T: Maybe { return <T value=value /> }
fn checked[T](value: I64) -> Result[T, String] where T: Checked[Error = String] { return <T.checked value=value /> }
fn main() {
    val optional: Optional[Item] = maybe(value: 7I64)
    match optional { Optional.Some(v: val instance) => { print(instance.raw) } Optional.None => { panic "missing" } }
    val result: Result[Item, String] = checked(value: 9I64)
    match result { Result.Ok(value: val instance) => { print(instance.raw) } Result.Err(error: _) => { panic "failed" } }
}
