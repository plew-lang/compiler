import @Std/Io with { print }
import @Std/Core with { Buffer, bufferAppend, bufferCount }

// Keep main on the legacy path. `appendOnce` directly consumes the bundled
// Buffer ABI so the `mid:` expectation proves both the resolved descriptor and
// its explicit inout Buffer place reached Mid LLVM lowering.
val midBufferAppendAnchor: I64 = 0I64

fn appendOnce(buffer: inout Buffer[I64]) {
    bufferAppend(buffer: inout buffer, value: 42I64)
}

fn main() {
    mut val buffer: Buffer[I64] = Buffer.new()
    appendOnce(buffer: inout buffer)
    print(bufferCount(buffer: buffer).format(format: ""))
}
