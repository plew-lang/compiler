// Semantic causes retain one owned context through Result/cache copies.
use /Diag only { CompileDiagnostic, UseAfterMoveRefusal, DiagnosticOwner, DiagnosticLocation, DiagnosticSeverity, FailureDomain }
use @Std/Io only { print }

fn failure() -> CompileDiagnostic {
    val path = "owned" + ".pw"
    return <CompileDiagnostic.useAfterMove refusal=<UseAfterMoveRefusal session=7U64 owner=<DiagnosticOwner.Closure expression=11U64 /> binding=13U64 expression=17U64 location=<DiagnosticLocation.File path=path line=19I64 /> /> />
}

fn location() -> DiagnosticLocation { return failure().location() }

fn main() {
    mut val cached: Dictionary[U64, Result[(), CompileDiagnostic]] = [:]
    cached[0U64] = <Result.Err error=failure() />
    val retained = cached[0U64]
    cached = [:]
    match retained {
        Result.Ok(value: _) => { panic("semantic failure became success") }
        Result.Err(error: val diagnostic) => {
            if diagnostic.isSourceRejection() || diagnostic.notes().count() != 0U64 { panic("raw cause gained source authority or notes") }
            match diagnostic.failureDomain() { FailureDomain.Unclassified => {} _ => { panic("raw cause lost domain") } }
            match diagnostic.severity() { DiagnosticSeverity.Error => {} _ => { panic("raw cause lost severity") } }
            match diagnostic.useAfterMove() {
                Optional.Some(v: val refusal) => {
                    if refusal.session() != 7U64 || refusal.binding() != 13U64 || refusal.expression() != 17U64 { panic("cached scalar context changed") }
                    match refusal.owner() { DiagnosticOwner.Closure(expression: val expression) => { if expression != 11U64 { panic("owner changed") } } _ => { panic("owner variant changed") } }
                }
                _ => { panic("semantic failure flattened") }
            }
            if diagnostic.message() != "use of a value after it was moved (`move` transfers ownership away — the variable is dead; bind a fresh value to use it again) (spec/03)" { panic("derived message changed") }
        }
    }
    match location() {
        DiagnosticLocation.File(path: val path, line: val line) => { if path != "owned.pw" || line != 19I64 { panic("context died with cause") } }
        _ => { panic("location changed") }
    }
    print("ok")
}
