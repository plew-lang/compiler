use @Std/Io only { print }
trait Required { fn value() -> I64 }
trait Source { type Item: Required
    fn item() -> Item
}
struct Leaf {}
pub impl Leaf { factory }
impl Leaf as Required { fn value() -> I64 { return 42I64 } }
struct Input {}
pub impl Input { factory }
impl Input as Source {
    type Item = Leaf
    fn item() -> Leaf { return <Leaf /> }
}
fn accept[T](value: T) -> I64 where T: Required { return value.value() }
fn forward[T](source: T) -> I64 where T: Source { return accept(value: source.item()) }
fn main() {
    if forward(source: <Input />) != 42I64 { panic("lost associated constraint") }
    print("retained-associated-constraint")
}
