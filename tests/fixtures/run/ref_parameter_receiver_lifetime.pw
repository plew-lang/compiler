// Diagnostic: a by-value Ref parameter must survive rebinding its caller's owner.
import @Std/Io with { print }
import @Std/Core with { MutableRef, assert }
unique struct Cell {
    pub val value: I64
    deinit { print(self.value) }
}
pub impl Cell {
    factory
    fn inspect(extra: I64) -> I64 { return self.value + extra }
}
mut val current: MutableRef[Cell] = <MutableRef value=<Cell value=11I64 /> />
fn replaceCurrent() -> I64 {
    current = <MutableRef value=<Cell value=22I64 /> />
    return 1I64
}
fn read(reference: MutableRef[Cell]) -> I64 {
    val first = reference->inspect(extra: replaceCurrent())
    return first + reference->value
}
struct Holder { pub mut val reference: MutableRef[Cell] }
pub impl Holder { factory }
fn readAfter(reference: MutableRef[Cell], action: fn() -> I64) -> I64 {
    action()
    return reference->value
}
fn readScalarAfter(value: I64, action: fn() -> I64) -> I64 {
    action()
    return value
}
fn captureCase() {
    mut val captured: I64 = 31I64
    val replace = fn() -> I64 { captured = 32I64 return 0I64 }
    val original = readScalarAfter(value: captured, action: replace)
    assert(original == 31I64)
    assert(captured == 32I64)
    print(original)
    print(captured)
}
fn fieldCase() {
    val holder = <MutableRef value=<Holder reference=<MutableRef value=<Cell value=41I64 /> /> /> />
    val replace = fn() -> I64 { holder->reference = <MutableRef value=<Cell value=42I64 /> /> return 0I64 }
    assert(readAfter(reference: holder->reference, action: replace) == 41I64)
    assert(holder->reference->value == 42I64)
}
fn main() {
    print(read(reference: current))
    print(current->value)
    captureCase()
    fieldCase()
}
