use @Std/Io only { print }
trait Source { type Item }
trait Marker {}
struct Number {}
impl Number as Source { type Item = I64 }
struct Box[Key, Item] { val item: Item }
impl[T] Box[T, T#Source.Item] where T: Source, T: Marker {
    fn value() -> I64 { return 42I64 }
}
trait Fallback {}
impl Fallback { fn value() -> I64 { return 7I64 } }
impl Box[Number, I64] as Fallback {}
fn main() { print(<Box[Number, I64] item=42I64 />.value()) }
