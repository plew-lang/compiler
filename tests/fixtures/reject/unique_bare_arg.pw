// Passing a unique value by argument requires a mode (`move`/`borrow`/`inout`);
// a bare place is a forbidden copy.
use @Std/Io only { write }
unique struct File { pub val fd: I64 }
pub impl File { factory }
fn use(f: borrow File) { write(s: "x\n") }
fn main() {
    val a: File = <File fd=1 />
    use(f: a)
}
