// A no-op wrapper around a field must not hide aggregate partial move.
import @Std/Io with { print }

struct Pair {
    pub val left: I64
    pub val right: I64
}
pub impl Pair { factory }

fn main() {
    val p: Pair = <Pair left=1I64 right=2I64 />
    val x: I64 = move (p.left as I64)
    print(x)
}
