use @Std/Io only { print }
trait Projection { type Left type Right }
trait Project[L, R] {}
struct Number {}
impl Number as Projection { type Left = Bool type Right = I64 }
impl Number as Project[Bool, I64] {}
fn main() {
    val n = <Number />
    val view = n#Project[Number#Projection.Right, Number#Projection.Left]
    print(42I64)
}
