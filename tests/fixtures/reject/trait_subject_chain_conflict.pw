// A caller-side conformance-path view selects only the outer call.  It must
// not alter the meaning of a shared `impl B as A` witness body.  Here `b` has
// two C/D witnesses, so the bare `self.b()` in `a` is ambiguous at its own
// source location even when the caller writes `s#C.a()`.
trait C { fn cv() -> I64 }
trait D { fn dv() -> I64 }
trait B { fn b() -> I64 }
trait A { fn a() -> I64 }

struct S { pub val value: I64 }
pub impl S { factory }
pub impl S as C { fn cv() -> I64 { return self.value } }
pub impl S as D { fn dv() -> I64 { return self.value * 100I64 } }
pub impl C as B { fn b() -> I64 { return self.cv() + 1I64 } }
pub impl D as B { fn b() -> I64 { return self.dv() + 2I64 } }
pub impl B as A { fn a() -> I64 { return self.b() + 10I64 } }

fn main() {
    val s: S = <S value=5I64 />
    s#C.a()
}
