// Write counterpart of arrow_private_field_read: `r->n = v` on a private pointee field must
// be rejected (spec/05). `->` write visibility follows the pointee type, like `c.n = v`.
import @Std/Io with { print }
import @Std/Core with { MutableRef }
struct C { mut val n: I32 }
pub impl C {
    factory initial(n: I32) { return <C n=n /> }
}
fn main() {
    val r: MutableRef[C] = <MutableRef[C] value=<C.initial n=5 /> />
    r->n = 9I32
}
