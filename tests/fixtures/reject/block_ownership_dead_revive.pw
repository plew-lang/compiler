use @Std/Io only { print }
unique struct Resource { val id: I64
 deinit { print(self.id) } }
fn consume(x: move Resource) { print(90I64) }
fn main() {
 mut val r = <Resource id=1I64 />
 consume(x: move r)
 val value = { if false { while true {}
 r = <Resource id=2I64 /> }
 give 7I64 }
 print(value)
 consume(x: move r)
}
