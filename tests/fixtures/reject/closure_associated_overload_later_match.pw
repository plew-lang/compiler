// Receiver/proof adapters must preserve the common first-branch frontier.
struct Selector {}
impl Selector {
    assoc fn invoke(callback: fn(value: I64) -> I64) -> I64 { return callback(value: 42I64) }
    assoc fn invoke(callback: fn(value: String) -> String) -> String { return callback(value: "ok") }
}
fn main() {
    Selector.invoke(callback: match true { true => { give fn(value) { return value } } false => { give fn(value: I64) { return value } } })
}
