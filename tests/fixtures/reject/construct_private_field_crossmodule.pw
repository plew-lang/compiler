// Construction field gate (spec/05): a non-`pub` field cannot be set when
// constructing from another module. `Dictionary`'s internal fields (`keys`/…)
// are private and live in the prelude module, so naming them in an explicit
// `<Dictionary …/>` here is an encapsulation violation (use the `[:]` literal).
import @Std/Io with { print }

fn main() {
    mut val d: Dictionary[String, U64] = <Dictionary[String, U64] keys=[] vals=[] hashes=[] buckets=[] entryCount=0 />
    print(d.count())
}
