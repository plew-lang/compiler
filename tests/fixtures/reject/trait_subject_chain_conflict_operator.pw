use @Std/Core only { Add }
// Operator calls must propagate source-body obligations through the selected
// generic witness, even when check does not materialize executable bodies.
trait C { fn cv() -> I64 }
trait D { fn dv() -> I64 }
trait B { fn b() -> I64 }
trait A { fn a() -> I64 }

struct S { pub val value: I64 }
pub impl S { factory }
pub impl S as C { fn cv() -> I64 { return self.value } }
pub impl S as D { fn dv() -> I64 { return self.value * 100I64 } }
pub impl C as B { fn b() -> I64 { return self.cv() + 1I64 } }
pub impl D as B { fn b() -> I64 { return self.dv() + 2I64 } }
pub impl B as A { fn a() -> I64 { return self.b() + 10I64 } }

struct Wrapped[T] { pub val value: T }
pub impl[T] Wrapped[T] { factory }
pub impl[T] Wrapped[T] as Add[I64] where T: A {
    type Output = I64
    assoc fn add(lhs~: Wrapped[T], rhs~: I64) -> I64 { return lhs.value.a() + rhs }
}
fn main() {
    val value = <S value=5I64 />
    val wrapped = <Wrapped value=value#C />
    val answer = wrapped + 1I64
}
