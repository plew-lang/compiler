use @Std/Io only { print }
trait Kind { type Item }
trait Reader[T] { fn read() -> T }
trait Source: Kind { type Output: Reader[Self#Kind.Item] }
struct Value {}
impl Value as Reader[Bool] { fn read() -> Bool { return true } }
struct Owner {}
impl Owner as Kind { type Item=I64 }
impl Owner as Source { type Output=Value }
fn get[T](owner: T, item: T#Source.Output) -> T#Kind.Item where T: Source { return item.read() }
fn main() { print(get(owner: <Owner />, item: <Value />)) }
