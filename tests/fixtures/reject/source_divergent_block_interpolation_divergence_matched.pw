use @Std/Io only { print }
use @Std/Core only { Ref }
unique struct Resource {
    val id: I64
    deinit { print(self.id) }
}
fn tick() -> I64 { print("unexpected")
    return 0I64
}
fn matched(flag: Bool) -> String {
    return "prefix{match flag { true => { return "true" } false => { return "false" } }}{tick()}"
}

fn main() { matched(flag: true) }
