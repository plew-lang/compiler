use @Std/Io only { print }

trait Project { type Item }
trait Marker[T] { fn number() -> I64 }
struct Projector {}
struct Number {}
impl Projector as Project { type Item = Bool }
impl Number as Marker[I64] { fn number() -> I64 { return 42I64 } }
newtype Viewed = Number#Marker[I64]

fn read[T](owner: T, value: Viewed) -> I64 where T: Project[Item=Bool] {
    val unwrapped = value as Number#Marker[T#Project.Item]
    return unwrapped.number()
}
fn main() {
    print(read(owner: <Projector />, value: (<Number />#Marker[I64]) as Viewed))
}
