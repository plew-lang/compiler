import @Std/Io with { print }
// Two conformed traits both provide `foo()`; the bare call is ambiguous.
trait P {} pub impl P { fn foo() -> I64 { return 1I64 } }
trait Q {} pub impl Q { fn foo() -> I64 { return 2I64 } }
struct A { pub val x: I64 }
pub impl A { factory }
impl A as P {}
impl A as Q {}
fn main() {
    val a: A = <A x=0 />
    print(a.foo())
}
