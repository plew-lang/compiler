// spec/11: a `guard` else block must diverge (return / break / continue / panic) — it
// runs on failure and the rest-of-block continues only on success, so falling through
// the else would defeat the early-exit guarantee. Here the else just prints and falls
// through, which is rejected.
import @Std/Io with { print }

fn f(n: I64) -> I64 {
    guard n > 0 {
        print(n)
    }
    return n
}

fn main() {
    print(f(n: 5))
}
