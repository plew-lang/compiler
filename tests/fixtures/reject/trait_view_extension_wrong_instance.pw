use @Std/Io only { print }
trait Marker[T] {}
struct Number {}
extension Selection { impl Number as Marker[Bool] {} }
fn read[T](value: T) -> I64 where T: Marker[I64] { return 42I64 }
fn main() {
    val value: Number#Selection#Marker[I64] = <Number />#Marker[I64]#Selection
    print(read(value: value))
}
