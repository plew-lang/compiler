// An `inout fn` method mutates its receiver, so calling it on a plain `val`
// binding must be rejected (the binding is immutable).
import @Std/Io with { print }

struct Counter {
    pub mut val n: I64
}
pub impl Counter { factory }

pub impl Counter {
    inout fn bump(by: I64) {
        self.n += by
    }
}

fn main() {
    val c: Counter = <Counter n=10 />
    c.bump(by: 7)
    print(c.n)
}
