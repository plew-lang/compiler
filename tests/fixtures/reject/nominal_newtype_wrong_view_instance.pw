use @Std/Io only { print }
trait Project { type Item }
trait Marker[T] { fn number() -> I64 }
struct Projector {}
struct Number {}
impl Projector as Project { type Item = Bool }
impl Number as Marker[I64] { fn number() -> I64 { return 42I64 } }
newtype Box = Number#Marker[Projector#Project.Item]
fn main() {}
