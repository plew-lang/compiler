use @Std/Io only { print }
trait Project { type Item }
trait Marker[T] { fn number() -> I64 }
struct Projector {}
struct Number {}
impl Projector as Project { type Item = Bool }
impl Number as Marker[I64] { fn number() -> I64 { return 42I64 } }
fn make[T](owner: T, number: I64 = {
    val viewed = <Number />#Marker[T#Project.Item]
    give viewed.number()
}) -> I64 where T: Project[Item=Bool] { return number }
fn main() { print(make(owner: <Projector />)) }
