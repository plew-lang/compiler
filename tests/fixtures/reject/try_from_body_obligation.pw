// An implicit From call must check its selected body even in check mode.
use @Std/Core only { From }
trait C { fn cv() -> I64 }
trait D { fn dv() -> I64 }
trait B { fn b() -> I64 }
trait A { fn a() -> I64 }

struct S { pub val value: I64 }
pub impl S { factory }
pub impl S as C { fn cv() -> I64 { return self.value } }
pub impl S as D { fn dv() -> I64 { return self.value * 100I64 } }
pub impl C as B { fn b() -> I64 { return self.cv() + 1I64 } }
pub impl D as B { fn b() -> I64 { return self.dv() + 2I64 } }
pub impl B as A { fn a() -> I64 { return self.b() + 10I64 } }

struct Error[T] { val code: I64 }
impl[T] Error[T] as From[T] where T: A {
    factory(from: T) { return <Error[T] code=from.a() /> }
}
fn source[T](value: T) -> Result[I64, T] { return <Result.Err error=value /> }
fn converted[T](value: T) -> Result[I64, Error[T]] where T: A {
    val answer = try source(value: value)
    return <Result.Ok value=answer />
}
fn main() {
    val value = <S value=5I64 />
    val answer = converted(value: value#C)
}
