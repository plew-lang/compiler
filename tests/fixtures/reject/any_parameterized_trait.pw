import @Std/Io with { print }

// spec/08: forming `any P` requires all of P's type arguments to be bound (the only
// thing still erased is `Self`). `any Conv[I64]` would be valid; the bare `any Conv`
// here leaves the type parameter T unbound and is rejected at formation.
trait Conv[T] { fn to() -> I64 }
struct C { val v: I64 }
pub impl C as Conv[I64] { fn to() -> I64 { return self.v } }

fn main() {
    val x: any Conv = <C v=7 />   // ERROR: unbound type argument T
    print(x.to())
}
