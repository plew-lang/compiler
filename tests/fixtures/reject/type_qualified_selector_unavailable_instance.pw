use @Std/Io only { print }
trait Source[T] { type Item }
struct Number {}
impl Number as Source[I64] { type Item=I64 }
trait Make[T] { assoc fn value() -> I64 }
struct Receiver {}
impl Receiver as Make[Bool] { assoc fn value() -> I64 { return 42I64 } }
fn main() { print(Receiver#Make[Number#Source[I64].Item].value()) }
