// Extension views are transparent for aggregate partial move rejection.
import @Std/Io with { print }

struct Pair {
    pub val left: I64
    pub val right: I64
}
pub impl Pair { factory }

extension View {
    pub impl Pair {
        fn sum() -> I64 { return 0I64 }
    }
}

fn main() {
    val p: Pair = <Pair left=1I64 right=2I64 />
    val x: I64 = move (p#View).left
    print(x)
}
