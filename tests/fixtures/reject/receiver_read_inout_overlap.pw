// Read self and inout cannot access the same local during one call.
struct Counter { pub mut val value: I64 }
pub impl Counter {
    factory
    fn read(other: inout Counter) -> I64 {
        other.value = 2I64
        return self.value
    }
}
fn main() {
    mut val counter = <Counter value=1I64 />
    counter.read(other: inout counter)
}
