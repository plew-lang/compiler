use @Std/Io only { print }

enum Choice { First Second }

struct Box { pub val value: I64 }

pub impl Box { factory }

fn passthrough(value: I64) -> I64 { return value }

// A value-position match still has a result type when every arm leaves the
// enclosing function. Mid must leave its join unreachable rather than create
// an uninitialized result path.
fn throughCall(input: Choice) -> I64 {
    return passthrough(value: match input {
        Choice.First => { return 7I64 }
        Choice.Second => { return 9I64 }
    })
}

// The same rule applies to a frozen aggregate element: the aggregate is not
// constructed if its value-match element never reaches its write point.

fn main() { throughCall(input: <Choice.First />) }
