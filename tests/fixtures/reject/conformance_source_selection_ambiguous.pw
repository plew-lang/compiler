trait Source[T] { type Item }
struct Value {}
extension First { pub impl Value as Source[I64] { type Item = I64 } }
extension Second { pub impl Value as Source[I64] { type Item = Bool } }
fn constrained[T](value: T) where T: Source[I64, Item=I64] {}
fn main() { constrained(value: <Value />#First#Second) }
