// The selected extension witness has Item=String, so its conformance cannot
// satisfy a where constraint requiring Item=I64.
trait Iter {
    type Item
}

struct Words {}
pub impl Words { factory }

extension E {
    pub impl Words as Iter {
        type Item = String
    }
}

fn requireI64[T](value: T) where T: Iter[Item=I64] {}

fn main() {
    requireI64(value: <Words />#E)
}
