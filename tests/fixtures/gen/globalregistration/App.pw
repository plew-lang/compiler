// Generation excludes an unreferenced registration initializer, even with side effects.
// Application-only helpers may depend on output that does not exist during gen.
// Macro helpers in the same file must still be compiled and executed.
import @Plew/Syntax with { Derive, TopItemAst }
import @Std/Io with { write }

mut val marker: I64 = 0I64
val registration: I64 = initializeMarker()

fn initializeMarker() -> I64 { marker = 1I64 return 0I64 }

fn generatedImplementation() -> String {
    if marker == 0I64 { return "impl Widget { assoc fn widgetTag() -> String { return \"unregistered\\n\" } }\n" }
    return "impl Widget { assoc fn widgetTag() -> String { return \"tagged!\\n\" } }\n"
}

struct Tag { }
pub impl Tag as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        return generatedImplementation()
    }
}

@[Tag]
struct Widget { }

// Deliberately not reachable from either entry point. It still belongs to the
// application and must pass ordinary checking after generation.
fn applicationOnly() -> String {
    return Widget.widgetTag()
}

fn main() {
    write(s: Widget.widgetTag())
}
