// gen test (spec/16 M0): a user-defined macro `Greet` generates an `impl` on the
// annotated type into App.gen.pw (part = impl only), which the normal build
// auto-parts; `main` calls the generated assoc fn.
import @Plew/Syntax with { Derive, TopItemAst, Src, newSrc }
import @Std/Io with { write }

struct Greet { }
pub impl Greet as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                s.put("impl ")
                s.put(d.name)
                s.put(" {\n    assoc fn widgetTag() -> String {\n        return \"tagged!\\n\"\n    }\n}\n")
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

@[Greet]
struct Widget { }

fn main() {
    write(s: Widget.widgetTag())
}
