// A `where T: BP` bound must name B.P's declaration identity, not merely the
// same-spelling, same-arity A.P. S conforms only to A.P, so this call is
// invalid even though A.P has no requirements.
use ./A only { P as AP }
use ./B only { P as BP }

struct S {}
pub impl S { factory }
pub impl S as AP {}

fn needB[T](value: T) where T: BP {}

fn main() {
    val s: S = <S />
    needB(value: s)
}
