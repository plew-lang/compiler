// Main imports Gl's exported `touchGl` but reads Gl's NON-exported global `secret`
// directly. The front-end must reject: a private top-level global in another module
// is not reachable from here (the (name, module) visibility rule, spec/15).
use @Std/Io only { print }
use ./Gl only { touchGl }

fn main() {
    print(value: secret)
}
