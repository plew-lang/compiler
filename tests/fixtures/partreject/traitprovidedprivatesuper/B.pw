import ./A with { Super }
pub import ./A with { Super }

pub trait Sub: Super {
}

pub fn useSub[T](value: T) -> I64 where T: Sub {
    return value.privateSuper()
}

struct Box {
    pub val n: I64
}

pub impl Box {
    factory
}

impl Box as Super {
    fn base() -> I64 {
        return self.n
    }
}

impl Box as Sub {
}

fn main() {
    val b = <Box n=4I64 />
    val x: I64 = useSub(value: b)
}
