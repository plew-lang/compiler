import /Frontend with { Comp, intern }
import /Ir with { InternedSpan }
fn main() {
    mut val compiler = <Comp />
    compiler.arena.bytes = "a".bytes()
    val identity = intern(c: inout compiler, start: 0U64, len: 1U64)
    compiler.interner.entries[identity - 1U64] = <InternedSpan start=2U64 len=0U64 hash=0U64 />
    val result = intern(c: inout compiler, start: 0U64, len: 1U64)
    if result == identity { panic "invalid span accepted" }
}
