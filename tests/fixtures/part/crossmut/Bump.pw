// Cross-module shared-mutable state — module B: takes module A's struct by
// `inout` and mutates it in place (pub field, and a nested child field).
import ./State with { Counter, Box }
pub import ./State with { Counter, Box }

pub fn bump(counter: inout Counter) {
    counter.n += 1
}

pub fn bumpNested(box: inout Box) {
    box.inner.n += 1
}
