import @Std/Io with { print, write }
import ./Defaults with { choose, chooseGlobal }

val secret: String = "caller-global"

fn message() -> String {
    write(s: "caller\n")
    return "explicit" + "-value"
}

fn exercise() {
    print(choose())
    print(choose())
    print(choose(value: message()))
    print(chooseGlobal())
    print(chooseGlobal(value: secret))
}

fn main() { exercise() }
