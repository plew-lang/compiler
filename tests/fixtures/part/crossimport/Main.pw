// Cross-file `use ./Name` (separate files folded into the build by the
// module loader), including a diamond: both Main and Helper use Util, which
// must be included exactly once (dedup).
use @Std/Io only { print }
use ./Helper only { addOne }
use ./Util only { triple }

fn main() {
    print(addOne(n: 41I64))      // 42
    print(triple(n: 7I64))       // 21
}
