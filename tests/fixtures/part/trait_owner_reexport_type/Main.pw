// A type-level projection must retain the declaration selected through B's
// re-export, rather than re-resolving the spelling against C.Convert.
import ./B with { Convert }
import ./C
import @Std/Io with { print }

struct Parser {}
pub impl Parser { factory }
pub impl Parser as Convert[String] {
    type Output = I64
}

fn main() {
    val value: Parser#Convert[String].Output = 10I64
    print(value)
}
