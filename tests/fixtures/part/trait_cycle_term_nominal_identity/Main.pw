// The two Token declarations share spelling and arity but are distinct nominal
// types.  These rewrites do not compose, so this must not be an exact cycle.
use ./A only { Token as AToken }
use ./B only { Token as BToken }

trait P[Item] {}
trait Q[Item] {}

impl P[AToken] as Q[BToken] {}
impl Q[AToken] as P[BToken] {}

fn main() {}
