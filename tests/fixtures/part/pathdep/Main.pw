// A path dependency: `@Acme/Greet` resolves (via [dependencies] in Plew.toml) to
// the greet/ package's lib face (src/_.pw). The package name may contain `/` as a
// literal char — packages are flat, so the whole `@Acme/Greet` names one package.
use @Std/Io only { print }
use @Acme/Greet only { hello, greetCount }

fn main() {
    print(hello())          // 7
    print(greetCount())     // 3
}
