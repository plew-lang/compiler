import ./Alpha
import ./Beta
import @Std/Io with { print }
fn main() {
    val first: any Alpha.Read = <Alpha.Item />
    val second: any Beta.Read = <Beta.Item />
    val number: I64 = first.value()
    val text: String = second.value()
    print(number)
    print(text)
    print(second.padding())
}
