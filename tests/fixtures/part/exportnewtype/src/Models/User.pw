// `export newtype` (spec/10,15): a newtype is part of a module's public surface.
// `newtype` is a contextual keyword, so the shared parser must recognise it after
// `export` (it lands in the Ident arm, not a `Kind.Kw…` arm).
export newtype UserId = String

// a factory over the underlying (the inherited `as` re-tag wraps the String).
export fn makeUser(name~: String) -> UserId { return name as UserId }
