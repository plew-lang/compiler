use ./Alpha
use ./Beta
use @Std/Io only { print }
fn alpha(value: Alpha.Choice) -> I64 { match value { Alpha.Choice.Some(value: val item) => { return item } } }
fn beta(value: Beta.Choice) -> String { match value { Beta.Choice.Some(text: val item) => { return item } } }
fn main() { print(alpha(value: <Alpha.Choice.Some value=41I64 />)) print(beta(value: <Beta.Choice.Some text="ok" />)) }
