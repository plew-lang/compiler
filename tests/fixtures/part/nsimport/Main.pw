// namespace import (spec/15): `use /Lib` (no `only`) binds `Lib` as a namespace,
// so `Lib.twice(...)` resolves to `twice` exported from /Lib. Published visibility is
// enforced exactly as for `use … only { }`.
use @Std/Io only { print, write }
use /Lib

fn main() {
    print(Lib.twice(21I64))
    write(s: Lib.greeting())
    write(s: "\n")
}
