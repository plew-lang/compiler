// namespace import (spec/15): `import /Lib` (no `with`) binds `Lib` as a namespace,
// so `Lib.twice(...)` resolves to `twice` exported from /Lib. Export visibility is
// enforced exactly as for `import … with { }`.
import @Std/Io with { print, write }
import /Lib

fn main() {
    print(Lib.twice(21I64))
    write(s: Lib.greeting())
    write(s: "\n")
}
