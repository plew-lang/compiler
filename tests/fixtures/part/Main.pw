// Multi-file module: Main.pw stitches in Helper.pw via `part`. Helper holds an
// `impl` on `N` (declared here) — spec/15: a part contains only impl blocks, and
// the shared module scope lets that impl see the root's type.
import @Std/Io with { print }

part ./Helper

struct N {
    pub val v: I64
}
pub impl N { factory }

fn main() {
    print((<N v=7 />).triple())
    print((<N v=5 />).square())
}
