import ./First
import ./Second
import @Std/Io with { print }
fn main() {
    val first = <First.Handler run=fn() -> I64 { return 11I64 } />
    val second = <Second.Handler run=fn() -> String { return "ok" } />
    val number: I64 = first.run()
    val text: String = second.run()
    print(number)
    print(text)
}
