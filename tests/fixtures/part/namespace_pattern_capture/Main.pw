import ./Models
import @Std/Io with { print }
fn read(value: Models.Choice) -> I64 { match value { Models.Choice.Some(value: val item) => { return item } val other => { return 0I64 } } return 0I64 }
fn main() { print(read(value: <Models.Choice.Some value=41I64 />)) print(read(value: <Models.Choice.None />)) }
