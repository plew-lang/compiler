// `use /Models` resolves the directory module `src/Models/_.pw` (spec/15): a
// directory is imported through its `_` root module, with no `src/Models.pw` present.
use @Std/Io only { print }
use /Models only { User, label }

fn main() {
    val u: User = <User id=7I64 />
    print(u.id)        // 7
    print(label())     // dir
}
