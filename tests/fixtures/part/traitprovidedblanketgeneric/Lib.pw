pub trait Source[T] { fn read() -> T }
pub trait Forward[T] { fn forward() -> T }
pub impl[T] Source[T] {
    fn retained() -> T { return self.read() }
}
pub impl[T] Source[T] as Forward[T] {
    fn forward() -> T { return self.retained() }
}
pub struct Box[T] { pub val value: T }
pub impl[T] Box[T] { factory }
pub impl[T] Box[T] as Source[T] {
    fn read() -> T { return self.value }
}

pub trait ItemSource { type Item }
pub struct ProjectionOwner {}
pub impl ProjectionOwner { factory }
pub impl ProjectionOwner as ItemSource { type Item = I64 }
pub fn projected[Owner, Value](owner: Owner, value: Value) -> Owner#ItemSource.Item where Owner: ItemSource, Value: Source[Owner#ItemSource.Item] {
    return value.retained()
}
