#!/bin/sh
# plew — the Plew CLI. Compile a .pw file to a native binary, run it, or run the
# derive-macro generator — all from a single relocatable binary: `plewc` resolves
# @Std from the compiler binary's own directory (std), not from the
# source, so the source location is irrelevant. Compiled programs and the gen
# harness link only libc (libLLVM is the compiler's concern, not the program's),
# so no llvm-config flags are needed and the tool works from any path.
#
#   plew <file.pw> [-o <out>]        compile to a binary (default: ./<basename>)
#   plew build <file.pw> [-o <out>]  same as above (explicit verb)
#   plew run <file.pw> [args...]     compile to a temp binary and run it
#   plew gen <file.pw> [<file.pw>…]  run @[…] derive macros -> <file>.gen.pw (spec/16)
#
# Override the C compiler with $CC (default: clang).

set -e

# Resolve this script's real directory even when invoked via a PATH symlink,
# so we always find the sibling plewc (whose dir holds std/).
self=$0
while [ -h "$self" ]; do
    link=$(readlink "$self")
    case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ROOT=$(cd "$(dirname "$self")" && pwd)
PLEWC="$ROOT/plewc"
CC=${CC:-clang}

[ -x "$PLEWC" ] || { echo "plew: $PLEWC not found — run ./bootstrap.sh first" >&2; exit 1; }

usage() {
    echo "usage: plew <file.pw> [-o <out>]   |   plew build <file.pw> [-o <out>]" >&2
    echo "       plew run <file.pw> [args...] |   plew gen <file.pw> [<file.pw>…]" >&2
    echo "       plew resolve [dir|file]      (resolve deps -> Plew.lock)" >&2
    exit 1
}

# Subcommand dispatch. A leading verb (build/run/gen/resolve) selects the mode; a
# bare first argument that is a .pw file defaults to build (back-compat).
mode=build
case "$1" in
    run)     mode=run;     shift ;;
    build)   mode=build;   shift ;;
    gen)     mode=gen;     shift ;;
    resolve) mode=resolve; shift ;;
esac

tmp="${TMPDIR:-/tmp}/plew-$$"
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

# ── dependency resolution (spec/17). The resolver is a SEPARATE Plew binary
# (resolve/_.pw); build it on demand (libc only) next to plewc. ──
RESOLVER="$ROOT/plew-resolve"
RESOLVER_SRC="$ROOT/resolve/_.pw"
ensure_resolver() {
    if [ ! -x "$RESOLVER" ] || [ "$RESOLVER_SRC" -nt "$RESOLVER" ]; then
        "$PLEWC" "$RESOLVER_SRC" > "$tmp/resolve.ll"
        "$PLEWC" --runtime > "$tmp/rrt.c"
        "$CC" -w "$tmp/resolve.ll" "$tmp/rrt.c" -o "$RESOLVER"
    fi
}
# Walk up from a path's directory to the nearest ancestor holding Plew.toml.
find_pkg_dir() {
    d=$(cd "$(dirname "$1")" 2>/dev/null && pwd) || return 1
    while :; do
        [ -f "$d/Plew.toml" ] && { printf '%s\n' "$d"; return 0; }
        [ "$d" = "/" ] && return 1
        d=$(dirname "$d")
    done
}
# Resolve the package dir $1's dependencies -> $1/Plew.lock (atomic via a temp).
do_resolve() {
    ensure_resolver
    if ( cd "$1" && "$RESOLVER" ) > "$tmp/lock.out"; then
        mv "$tmp/lock.out" "$1/Plew.lock"
    else
        echo "plew: dependency resolution failed" >&2
        exit 1
    fi
}

# ── resolve: (re)resolve dependencies for a package, writing Plew.lock. ──
if [ "$mode" = resolve ]; then
    target=${1:-.}
    if [ -f "$target" ]; then pkg=$(find_pkg_dir "$target"); else pkg=$(cd "$target" 2>/dev/null && pwd); fi
    [ -n "$pkg" ] && [ -f "$pkg/Plew.toml" ] || { echo "plew resolve: no Plew.toml found from $target" >&2; exit 1; }
    do_resolve "$pkg"
    echo "plew: resolved -> $pkg/Plew.lock" >&2
    exit 0
fi

[ -n "$1" ] || usage

# ── gen: run derive macros (spec/16). Version-agnostic String→String step —
# `plewc --gen` emits the harness IR, clang builds it (libc only), running it
# prints the generated source to <file>.gen.pw (committed; the normal build
# auto-parts it whenever a file carries `@[…]`). ──
if [ "$mode" = gen ]; then
    "$PLEWC" --runtime > "$tmp/runtime.c"
    for pw in "$@"; do
        case "$pw" in
            *.gen.pw) echo "plew gen: skipping generated file $pw" >&2; continue ;;
            *.pw) ;;
            *) echo "plew gen: not a .pw file: $pw" >&2; exit 1 ;;
        esac
        [ -f "$pw" ] || { echo "plew gen: no such file: $pw" >&2; exit 1; }
        out="${pw%.pw}.gen.pw"
        "$PLEWC" --gen "$pw" > "$tmp/harness.ll"
        "$CC" -w "$tmp/harness.ll" "$tmp/runtime.c" -o "$tmp/harness"
        "$tmp/harness" > "$out"
        echo "plew gen: $pw -> $out"
    done
    exit 0
fi

# ── build / run: compile a single .pw to a native binary (libc only). ──
src=$1; shift
case "$src" in *.pw) ;; *) echo "plew: not a .pw file: $src" >&2; exit 1 ;; esac
[ -f "$src" ] || { echo "plew: no such file: $src" >&2; exit 1; }

# Auto-resolve once when the package declares git dependencies but has no lock
# (spec/17: the lock is required to back git `@dep` imports). Announced on stderr —
# fetching is a visible step, not hidden. Re-resolution is explicit (`plew resolve`).
pkg=$(find_pkg_dir "$src" 2>/dev/null || true)
if [ -n "$pkg" ] && [ ! -f "$pkg/Plew.lock" ] && grep -q 'git[[:space:]]*=' "$pkg/Plew.toml" 2>/dev/null; then
    echo "plew: resolving dependencies (no Plew.lock)..." >&2
    do_resolve "$pkg"
fi

out=""
if [ "$mode" = build ]; then
    if [ "$1" = "-o" ]; then out=$2; shift 2; fi
    [ -n "$out" ] || out=$(basename "${src%.pw}")
fi

"$PLEWC" "$src" > "$tmp/out.ll"
"$PLEWC" --runtime > "$tmp/rt.c"

if [ "$mode" = run ]; then
    bin="$tmp/a.out"
    "$CC" -w "$tmp/out.ll" "$tmp/rt.c" -o "$bin"
    "$bin" "$@"
else
    "$CC" -w "$tmp/out.ll" "$tmp/rt.c" -o "$out"
    echo "plew: $src -> $out"
fi
