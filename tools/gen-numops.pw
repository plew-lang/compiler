// gen-numops — emit the primitive operator-trait witnesses (spec/12, O6).
//
// One-shot generator (run by hand, output committed): prints an `impl <Prim> as
// <OpTrait>` for every primitive numeric type and operator, each body delegating to
// its intrinsic (`i32Add` etc., which lower in genNumIntrinsic). The output IS
// `std/Core/Num.pw` verbatim — a `part ./Core/Num` of @Std/Core, so it holds ONLY
// impl blocks. The matching `extern "plew-intrinsic"` floor these bodies call
// (`i8Add`, `u64WrapAdd`, …) is hand-maintained in std/Core.pw (the module root — a
// part cannot declare externs); adding an op means editing BOTH this generator and
// that floor.
//
// Why a standalone generator rather than the `@[...]` derive pipeline: any
// derive macro depends on @Std/Syntax, which depends on @Std/Core — so deriving
// for the primitives (which Core owns, the floor everything imports) would form
// an import cycle through Core. The `@[...]` dogfood fits user types above Core,
// not the primitive floor itself. This generator keeps the bootstrap-critical
// core free of gen-pipeline coupling while still avoiding ~400 hand-written lines.
//
//   plewc tools/gen-numops.pw > /tmp/gen.ll && plewc --runtime > /tmp/rt.c \
//     && clang -w /tmp/gen.ll /tmp/rt.c $(llvm-config --ldflags --libs core) \
//        -o /tmp/gen && /tmp/gen > std/Core/Num.pw

import @Std/Io with { write }

// impl <ty> as <trn>[<ty>] { type Output = <ty>  assoc fn <meth>(lhs,rhs) { return <pfx><suf>(a:lhs, b:rhs) } }
fn implBin(ty: String, trn: String, meth: String, pfx: String, suf: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as ")
    write(s: trn)
    write(s: "[")
    write(s: ty)
    write(s: "] {\n    type Output = ")
    write(s: ty)
    write(s: "\n    assoc fn ")
    write(s: meth)
    write(s: "(lhs~: ")
    write(s: ty)
    write(s: ", rhs~: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: " { return ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: lhs, b: rhs) }\n}\n")
}

// impl <ty> as <trn> { type Output = <ty>  assoc fn <meth>(value) { return <pfx><suf>(a: value) } }
fn implUn(ty: String, trn: String, meth: String, pfx: String, suf: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as ")
    write(s: trn)
    write(s: " {\n    type Output = ")
    write(s: ty)
    write(s: "\n    assoc fn ")
    write(s: meth)
    write(s: "(value~: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: " { return ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: value) }\n}\n")
}

// impl <ty> as Eq { assoc fn eq(lhs,rhs) -> Bool { return <pfx>Eq(a:lhs, b:rhs) } }
fn implEq(ty: String, pfx: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as Eq {\n    assoc fn eq(lhs~: ")
    write(s: ty)
    write(s: ", rhs~: ")
    write(s: ty)
    write(s: ") -> Bool { return ")
    write(s: pfx)
    write(s: "Eq(a: lhs, b: rhs) }\n}\n")
}

// impl <ty> as Ord { assoc fn compare(lhs,rhs) -> Ordering { Lt? Less : Eq? Equal : Greater } }
fn implOrd(ty: String, pfx: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as Ord {\n    assoc fn compare(lhs~: ")
    write(s: ty)
    write(s: ", rhs~: ")
    write(s: ty)
    write(s: ") -> Ordering {\n        if ")
    write(s: pfx)
    write(s: "Lt(a: lhs, b: rhs) { return <Ordering.Less /> }\n        if ")
    write(s: pfx)
    write(s: "Eq(a: lhs, b: rhs) { return <Ordering.Equal /> }\n        return <Ordering.Greater />\n    }\n}\n")
}

// `    assoc fn <meth>(lhs~,rhs~) -> ty { return <pfx><suf>(a: lhs, b: rhs) }`
fn implWrapBin(ty: String, pfx: String, meth: String, suf: String) {
    write(s: "    assoc fn ")
    write(s: meth)
    write(s: "(lhs~: ")
    write(s: ty)
    write(s: ", rhs~: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: " { return ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: lhs, b: rhs) }\n")
}

// Wrapping arithmetic (spec/02): the `wrapping*` two's-complement ops as the
// `FixedWidthInteger` trait witnesses on each integer type (there is no operator, so
// they are named, not desugared). Primitives are trait-only — behavior on a type Core
// owns is expressed as a conformance, not an inherent impl (spec/09) — so wrapping is a
// conformance to the integer classification trait, mirroring `Add`. Both operands are
// equal peers whose labels fall to the position names `lhs`/`rhs`, so they are suppressed
// (spec/04 label guidance); the unary `wrappingNeg` takes the empty-name `value`. Bodies
// bottom out in the `<pfx>Wrap*` intrinsic floor (declared in Core.pw, lowered
// raw/unchecked by genNumIntrinsic).
fn implWrap(ty: String, pfx: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as FixedWidthInteger {\n")
    implWrapBin(ty: ty, pfx: pfx, meth: "wrappingAdd", suf: "WrapAdd")
    implWrapBin(ty: ty, pfx: pfx, meth: "wrappingSub", suf: "WrapSub")
    implWrapBin(ty: ty, pfx: pfx, meth: "wrappingMul", suf: "WrapMul")
    // wrappingNeg is defined for unsigned too (2^n - x), unlike checked Neg (signed only).
    write(s: "    assoc fn wrappingNeg(value~: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: " { return ")
    write(s: pfx)
    write(s: "WrapNeg(a: value) }\n}\n")
}

fn main() {
    val tys: Array[String] = ["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64"]
    val pfx: Array[String] = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]
    val signed: Array[Bool] = [true, true, true, true, false, false, false, false]
    val traits: Array[String] = ["Add", "Sub", "Mul", "Div", "Rem", "BitAnd", "BitOr", "BitXor", "Shl", "Shr"]
    val meths: Array[String] = ["add", "sub", "mul", "div", "rem", "bitand", "bitor", "bitxor", "shl", "shr"]

    write(s: "// Generated by tools/gen-numops.pw — do not edit by hand.\n")
    write(s: "// Operator-trait witnesses for the primitive numeric types over the numeric\n")
    write(s: "// intrinsic floor (iXAdd -> genNumIntrinsic; spec/12, O6). A `part ./Core/Num`\n")
    write(s: "// of @Std/Core so Core — the owner of the primitive types — stays coherent. The\n")
    write(s: "// `extern` floor these bodies call is declared in std/Core.pw (the module root).\n\n")

    val ftys: Array[String] = ["F32", "F64"]
    val fpfx: Array[String] = ["f32", "f64"]
    val ftraits: Array[String] = ["Add", "Sub", "Mul", "Div"]

    // conformances
    mut val ti: U64 = 0
    while ti < tys.count() {
        mut val oi: U64 = 0
        while oi < traits.count() {
            implBin(ty: tys[ti], trn: traits[oi], meth: meths[oi], pfx: pfx[ti], suf: traits[oi])
            oi += 1
        }
        implUn(ty: tys[ti], trn: "BitNot", meth: "bitnot", pfx: pfx[ti], suf: "BitNot")
        if signed[ti] {
            implUn(ty: tys[ti], trn: "Neg", meth: "neg", pfx: pfx[ti], suf: "Neg")
        }
        implEq(ty: tys[ti], pfx: pfx[ti])
        implOrd(ty: tys[ti], pfx: pfx[ti])
        implWrap(ty: tys[ti], pfx: pfx[ti])
        ti += 1
    }
    // float conformances (Add/Sub/Mul/Div/Neg/Eq/Ord).
    mut val fi: U64 = 0
    while fi < ftys.count() {
        mut val foi: U64 = 0
        while foi < ftraits.count() {
            implBin(ty: ftys[fi], trn: ftraits[foi], meth: meths[foi], pfx: fpfx[fi], suf: ftraits[foi])
            foi += 1
        }
        implUn(ty: ftys[fi], trn: "Neg", meth: "neg", pfx: fpfx[fi], suf: "Neg")
        implEq(ty: ftys[fi], pfx: fpfx[fi])
        implOrd(ty: ftys[fi], pfx: fpfx[fi])
        fi += 1
    }
    implUn(ty: "Bool", trn: "Not", meth: "not", pfx: "bool", suf: "Not")
    implEq(ty: "Bool", pfx: "bool")
}
