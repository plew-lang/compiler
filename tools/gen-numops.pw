// gen-numops — emit the primitive operator-trait witnesses (spec/12, O6).
//
// One-shot generator (run by hand, output committed): prints the intrinsic
// `extern` floor declarations plus an `impl <Prim> as <OpTrait>` for every
// primitive numeric type and operator, each body delegating to its intrinsic
// (`i32Add` etc., which lower to the `plew_i32Add` runtime in the C preamble).
//
// Why a standalone generator rather than the `@[...]` derive pipeline: any
// derive macro depends on @Std/Syntax, which depends on @Std/Core — so deriving
// for the primitives (which Core owns, the floor everything imports) would form
// an import cycle through Core. The `@[...]` dogfood fits user types above Core,
// not the primitive floor itself. This generator keeps the bootstrap-critical
// core free of gen-pipeline coupling while still avoiding ~400 hand-written lines.
//
//   compiler/plewc tools/gen-numops.pw | clang -x c - -o /tmp/gen \
//     && /tmp/gen > compiler/std/Core/Num.pw

import @Std/Io with { write }

// `    fn <pfx><suf>(a: <ty>, b: <ty>) -> <ty>`
fn externBin(pfx: String, suf: String, ty: String) {
    write(s: "    fn ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: ")
    write(s: ty)
    write(s: ", b: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: "\n")
}

// `    fn <pfx><suf>(a: <ty>) -> <ty>`
fn externUn(pfx: String, suf: String, ty: String) {
    write(s: "    fn ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: "\n")
}

// impl <ty> as <trn>[<ty>] { type Output = <ty>  assoc fn <meth>(lhs,rhs) { return <pfx><suf>(a:lhs, b:rhs) } }
fn implBin(ty: String, trn: String, meth: String, pfx: String, suf: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as ")
    write(s: trn)
    write(s: "[")
    write(s: ty)
    write(s: "] {\n    type Output = ")
    write(s: ty)
    write(s: "\n    assoc fn ")
    write(s: meth)
    write(s: "(lhs: ")
    write(s: ty)
    write(s: ", rhs: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: " { return ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: lhs, b: rhs) }\n}\n")
}

// impl <ty> as <trn> { type Output = <ty>  assoc fn <meth>(value) { return <pfx><suf>(a: value) } }
fn implUn(ty: String, trn: String, meth: String, pfx: String, suf: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as ")
    write(s: trn)
    write(s: " {\n    type Output = ")
    write(s: ty)
    write(s: "\n    assoc fn ")
    write(s: meth)
    write(s: "(value: ")
    write(s: ty)
    write(s: ") -> ")
    write(s: ty)
    write(s: " { return ")
    write(s: pfx)
    write(s: suf)
    write(s: "(a: value) }\n}\n")
}

// impl <ty> as Eq { assoc fn eq(lhs,rhs) -> Bool { return <pfx>Eq(a:lhs, b:rhs) } }
fn implEq(ty: String, pfx: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as Eq {\n    assoc fn eq(lhs: ")
    write(s: ty)
    write(s: ", rhs: ")
    write(s: ty)
    write(s: ") -> Bool { return ")
    write(s: pfx)
    write(s: "Eq(a: lhs, b: rhs) }\n}\n")
}

// impl <ty> as Ord { assoc fn compare(lhs,rhs) -> Ordering { Lt? Less : Eq? Equal : Greater } }
fn implOrd(ty: String, pfx: String) {
    write(s: "impl ")
    write(s: ty)
    write(s: " as Ord {\n    assoc fn compare(lhs: ")
    write(s: ty)
    write(s: ", rhs: ")
    write(s: ty)
    write(s: ") -> Ordering {\n        if ")
    write(s: pfx)
    write(s: "Lt(a: lhs, b: rhs) { return <Ordering.Less /> }\n        if ")
    write(s: pfx)
    write(s: "Eq(a: lhs, b: rhs) { return <Ordering.Equal /> }\n        return <Ordering.Greater />\n    }\n}\n")
}

fn main() {
    val tys: Array[String] = ["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64"]
    val pfx: Array[String] = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]
    val signed: Array[Bool] = [true, true, true, true, false, false, false, false]
    val traits: Array[String] = ["Add", "Sub", "Mul", "Div", "Rem", "BitAnd", "BitOr", "BitXor", "Shl", "Shr"]
    val meths: Array[String] = ["add", "sub", "mul", "div", "rem", "bitand", "bitor", "bitxor", "shl", "shr"]

    write(s: "// Generated by tools/gen-numops.pw — do not edit by hand.\n")
    write(s: "// Operator-trait witnesses for the primitive numeric types over the numeric\n")
    write(s: "// intrinsic floor (iXAdd -> plew_iXAdd in the C preamble; spec/12, O6). A part\n")
    write(s: "// of @Std/Core so Core — the owner of the primitive types — stays coherent.\n\n")

    // intrinsic floor declarations
    write(s: "extern \"plew-intrinsic\" {\n")
    mut val ti: U64 = 0
    while ti < tys.count() {
        mut val oi: U64 = 0
        while oi < traits.count() {
            externBin(pfx: pfx[ti], suf: traits[oi], ty: tys[ti])
            oi += 1
        }
        externUn(pfx: pfx[ti], suf: "BitNot", ty: tys[ti])
        if signed[ti] {
            externUn(pfx: pfx[ti], suf: "Neg", ty: tys[ti])
        }
        // comparison floor: Eq backs `==`, Lt backs Ord.compare. Both return Bool.
        write(s: "    fn ")
        write(s: pfx[ti])
        write(s: "Eq(a: ")
        write(s: tys[ti])
        write(s: ", b: ")
        write(s: tys[ti])
        write(s: ") -> Bool\n")
        write(s: "    fn ")
        write(s: pfx[ti])
        write(s: "Lt(a: ")
        write(s: tys[ti])
        write(s: ", b: ")
        write(s: tys[ti])
        write(s: ") -> Bool\n")
        ti += 1
    }
    // float floor: Add/Sub/Mul/Div (no Rem — float `%` is a compile error, spec/12),
    // Neg (floats are signed), Eq/Lt (NaN-panicking ordered compares, spec/02). F32/F64
    // both lower to `double` for now.
    val ftys: Array[String] = ["F32", "F64"]
    val fpfx: Array[String] = ["f32", "f64"]
    val ftraits: Array[String] = ["Add", "Sub", "Mul", "Div"]
    mut val fi: U64 = 0
    while fi < ftys.count() {
        mut val foi: U64 = 0
        while foi < ftraits.count() {
            externBin(pfx: fpfx[fi], suf: ftraits[foi], ty: ftys[fi])
            foi += 1
        }
        externUn(pfx: fpfx[fi], suf: "Neg", ty: ftys[fi])
        write(s: "    fn ")
        write(s: fpfx[fi])
        write(s: "Eq(a: ")
        write(s: ftys[fi])
        write(s: ", b: ")
        write(s: ftys[fi])
        write(s: ") -> Bool\n")
        write(s: "    fn ")
        write(s: fpfx[fi])
        write(s: "Lt(a: ")
        write(s: ftys[fi])
        write(s: ", b: ")
        write(s: ftys[fi])
        write(s: ") -> Bool\n")
        fi += 1
    }
    write(s: "    fn boolNot(a: Bool) -> Bool\n")
    write(s: "    fn boolEq(a: Bool, b: Bool) -> Bool\n")
    write(s: "}\n\n")

    // conformances
    ti = 0
    while ti < tys.count() {
        mut val oi: U64 = 0
        while oi < traits.count() {
            implBin(ty: tys[ti], trn: traits[oi], meth: meths[oi], pfx: pfx[ti], suf: traits[oi])
            oi += 1
        }
        implUn(ty: tys[ti], trn: "BitNot", meth: "bitnot", pfx: pfx[ti], suf: "BitNot")
        if signed[ti] {
            implUn(ty: tys[ti], trn: "Neg", meth: "neg", pfx: pfx[ti], suf: "Neg")
        }
        implEq(ty: tys[ti], pfx: pfx[ti])
        implOrd(ty: tys[ti], pfx: pfx[ti])
        ti += 1
    }
    // float conformances (Add/Sub/Mul/Div/Neg/Eq/Ord).
    fi = 0
    while fi < ftys.count() {
        mut val foi: U64 = 0
        while foi < ftraits.count() {
            implBin(ty: ftys[fi], trn: ftraits[foi], meth: meths[foi], pfx: fpfx[fi], suf: ftraits[foi])
            foi += 1
        }
        implUn(ty: ftys[fi], trn: "Neg", meth: "neg", pfx: fpfx[fi], suf: "Neg")
        implEq(ty: ftys[fi], pfx: fpfx[fi])
        implOrd(ty: ftys[fi], pfx: fpfx[fi])
        fi += 1
    }
    implUn(ty: "Bool", trn: "Not", meth: "not", pfx: "bool", suf: "Not")
    implEq(ty: "Bool", pfx: "bool")
}
